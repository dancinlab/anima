// ────────────────────────────────────────────────────────────────────────────
//  Section 1 — Path / ckpt resolution
//
//  Python: _find_default_ckpt() walks 4 candidate paths (B'.1, B'', B', A)
//  and returns first existing. Here we expose:
//    anima_root()      -> string  (env ANIMA_ROOT or /Users/ghost/core/anima)
//    default_ckpt()    -> string  (B'.1 SSOT path; caller must verify exist)
//    find_default_ckpt() -> string (walk candidates; returns "" if none)
// ────────────────────────────────────────────────────────────────────────────

fn anima_root() -> string {
    let e = env("ANIMA_ROOT")
    if len(e) > 0 {
        return e
    }
    return "/Users/ghost/core/anima"
}

fn default_ckpt() -> string {
    // B'.1 — Phase 1A.1 color/cosmology boost (default, V5.8 std_greedy 4/5)
    // Pure-hexa lane wants the BF16 safetensors variant (RFC 031 reader).
    return anima_root() + "/state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/ckpt_phase1a1_sft.safetensors"
}

fn find_default_ckpt() -> string {
    // Substrate ladder (mirrors Python _find_default_ckpt order, BUT for the
    // hexa lane we prefer .safetensors variants since RFC 025/031 only handle
    // safetensors mmap — TODO[pickle] keeps .pt out of scope).
    let root = anima_root()
    let mut candidates = []
    candidates.push(root + "/state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/ckpt_phase1a1_sft.safetensors")
    candidates.push(root + "/state/anima_ffn_gate_cotrain_2026_05_11/ckpts/ckpt_final.safetensors")
    candidates.push(root + "/state/anima_phase1a_alt_2026_05_12/ckpts/ckpt_phase1a_sft.safetensors")
    candidates.push(root + "/.cache/anima/clm_v5_remapped/phase2_cotrain_engine_ag/ckpts/ckpt_final.safetensors")
    let n = len(candidates)
    let mut i = 0
    while i < n {
        let c = candidates[i]
        if file_exists(c) {
            return c
        }
        i = i + 1
    }
    return ""  // sentinel: caller checks empty + emits diagnostic
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 2 — ByteTokenizer (thin wrappers around byte_tokenizer.hexa
//                              + RFC 030 bytes_to_str_raw)
//
//  Python ByteTokenizer:
//    bos = 1, eos = 2, pad = 0
//    encode(t) = [bos] + [b + 3 for b in t.encode("utf-8")] + [eos]
//    decode(ids) = bytes(t - 3 for t in ids if 3 <= t < 259).decode("utf-8", errors="replace")
//
//  The Phase 4.2 byte_tokenizer.hexa already implements encode + decode_bytes;
//  here we add a decode_str wrapper that uses RFC 030's bytes_to_str_raw to
//  close the diamond — same byte-exact semantics as Python's .decode("utf-8").
// ────────────────────────────────────────────────────────────────────────────

fn tok_bos() -> int { return 1 }
fn tok_eos() -> int { return 2 }
fn tok_pad() -> int { return 0 }
fn tok_offset() -> int { return 3 }
fn tok_vocab_effective() -> int { return 259 }

// tok_encode(text) -> [int]  : UTF-8 byte stream → [bos, b+3..., eos]
fn tok_encode(text: string) {
    let mut ids = []
    ids.push(tok_bos())
    let n = len(text)
    let mut i = 0
    while i < n {
        let b = char_code(text, i) & 0xFF
        ids.push(b + tok_offset())
        i = i + 1
    }
    ids.push(tok_eos())
    return ids
}

// tok_decode_bytes(ids) -> [int]  : strip bos/eos/pad; emit raw bytes 0..255
fn tok_decode_bytes(ids) {
    let n = len(ids)
    let mut out = []
    let mut i = 0
    while i < n {
        let id = ids[i]
        if id != tok_pad() && id != tok_bos() && id != tok_eos() {
            let b = id - tok_offset()
            if b >= 0 && b < 256 {
                out.push(b)
            }
        }
        i = i + 1
    }
    return out
}

// tok_decode_str(ids) -> string  : bytes → str via RFC 030.
// NOTE: bytes_to_str_raw rejects embedded NUL (returns ""). Python's
// .decode("utf-8", errors="replace") would substitute U+FFFD instead. For
// well-formed UTF-8 inputs (the only ones anima produces during chat) the
// two paths agree byte-exact.
fn tok_decode_str(ids) -> string {
    let bs = tok_decode_bytes(ids)
    return bytes_to_str_raw(bs)
}

// keyword_byte_ids(kw) -> [int]  : encode + strip bos/eos (used by M4 modes).
fn keyword_byte_ids(kw: string) {
    let ids = tok_encode(kw)
    let n = len(ids)
    let mut out = []
    let mut i = 0
    while i < n {
        let id = ids[i]
        if id != tok_bos() && id != tok_eos() {
            out.push(id)
        }
        i = i + 1
    }
    return out
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 3 — Heuristic skip-list + interrogative detection
//
//  Python: _HEURISTIC_SKIP is a set (~50 entries) of common Korean particles
//  / interrogatives / sentence-final endings; _INTERROGATIVE_TAILS is a small
//  tuple of single-char suffix markers.
//
//  hexa port: explicit list + linear scan (lists are short enough that O(n)
//  membership is fine).
// ────────────────────────────────────────────────────────────────────────────

fn heuristic_skip_set() {
    // Same 50-ish entries as Python _HEURISTIC_SKIP, grouped by purpose.
    let mut s = []
    // 보조 / 존재 / 상태 어절
    s.push("있어"); s.push("있나"); s.push("있어요"); s.push("있을까")
    s.push("있을"); s.push("있다"); s.push("있는"); s.push("있어서")
    s.push("없어"); s.push("없나"); s.push("없는"); s.push("없다")
    // 의문사 / 의문 종결
    s.push("뭐야"); s.push("뭐였지"); s.push("어떻게"); s.push("어디")
    s.push("무엇"); s.push("무슨"); s.push("어떤"); s.push("어때")
    s.push("누구야"); s.push("누구"); s.push("왜"); s.push("언제")
    s.push("얼마"); s.push("얼마나"); s.push("어느")
    // 인사 / 화자 표지
    s.push("사용자"); s.push("도우미"); s.push("안녕"); s.push("안녕하세요")
    // 동사 어미류
    s.push("했지"); s.push("하는"); s.push("하니"); s.push("하지")
    s.push("할래"); s.push("할까"); s.push("해줘"); s.push("해요"); s.push("해서")
    s.push("필요해"); s.push("좋아해"); s.push("알려줘"); s.push("줄래")
    s.push("줄까"); s.push("그래"); s.push("그게"); s.push("그것")
    // 일반 부탁 / 동작 호출
    s.push("도와줘"); s.push("도와"); s.push("도와줄래"); s.push("도와줘요")
    return s
}

fn interrogative_tails() {
    // Python tuple ("야", "어", "지", "까", "니", "뭐", "워")
    let mut t = []
    t.push("야"); t.push("어"); t.push("지"); t.push("까")
    t.push("니"); t.push("뭐"); t.push("워")
    return t
}

fn noun_whitelist() {
    // Python whitelist: {"사랑", "이름", "기분", "안녕", "우주", "철학"}
    let mut w = []
    w.push("사랑"); w.push("이름"); w.push("기분"); w.push("안녕")
    w.push("우주"); w.push("철학")
    return w
}

// _list_contains(xs, item) — linear membership.
fn _list_contains(xs, item: string) -> bool {
    let n = len(xs)
    let mut i = 0
    while i < n {
        if xs[i] == item {
            return true
        }
        i = i + 1
    }
    return false
}

// _looks_like_interrogative(token) — Python heuristic port.
//
//  Returns true for: empty / explicit skip-list match / 2~3-char token
//  ending with a question morpheme (unless on the noun whitelist).
fn looks_like_interrogative(token: string) -> bool {
    if len(token) == 0 {
        return true
    }
    let skip = heuristic_skip_set()
    if _list_contains(skip, token) {
        return true
    }
    // Token length in CHARS (not bytes) — Hangul is 3 bytes per char in UTF-8,
    // so a 2-char Korean token is 6 bytes, 3-char = 9 bytes. We approximate
    // "char-len ≤ 3" by "byte-len ≤ 9" which is the same bound for pure
    // Hangul tokens (the common case for this heuristic).
    let blen = len(token)
    if blen <= 9 {
        let tails = interrogative_tails()
        let nt = len(tails)
        let mut i = 0
        while i < nt {
            let suffix = tails[i]
            if ends_with_str(token, suffix) {
                // noun whitelist exception
                let nouns = noun_whitelist()
                if _list_contains(nouns, token) {
                    return false
                }
                return true
            }
            i = i + 1
        }
    }
    return false
}

// ends_with_str(haystack, needle) — local impl (stdlib starts_with/ends_with
// require an import; this module is import-free for portability across the
// hexa interp / AOT path during the bootstrap port).
fn ends_with_str(haystack: string, needle: string) -> bool {
    let hl = len(haystack)
    let nl = len(needle)
    if nl > hl {
        return false
    }
    let offset = hl - nl
    let mut i = 0
    while i < nl {
        if char_code(haystack, offset + i) != char_code(needle, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// str_contains(haystack, needle) — substring search by byte comparison.
fn str_contains(haystack: string, needle: string) -> bool {
    let hl = len(haystack)
    let nl = len(needle)
    if nl == 0 {
        return true
    }
    if nl > hl {
        return false
    }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(haystack, i + j) != char_code(needle, j) {
                ok = false
                j = nl     // break inner
            } else {
                j = j + 1
            }
        }
        if ok {
            return true
        }
        i = i + 1
    }
    return false
}

// str_find(haystack, needle) — byte offset of first occurrence, or -1.
fn str_find(haystack: string, needle: string) -> int {
    let hl = len(haystack)
    let nl = len(needle)
    if nl == 0 {
        return 0
    }
    if nl > hl {
        return -1
    }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(haystack, i + j) != char_code(needle, j) {
                ok = false
                j = nl     // break inner
            } else {
                j = j + 1
            }
        }
        if ok {
            return i
        }
        i = i + 1
    }
    return -1
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 4 — Dialog segment parsing
//
//  Python: _last_user_segment + _last_assistant_segment use regex
//   r"사용자:\s*([^|]+)" / r"도우미:\s*([^|]*)" → last match wins.
//
//  hexa port: walk byte-by-byte for the marker, slice between marker end and
//  next `|` or end-of-string. Simpler than regex but byte-exact for the
//  prompt format anima uses ("사용자: …  |  도우미: …  |  사용자: … ").
// ────────────────────────────────────────────────────────────────────────────

fn last_user_segment(prompt: string) -> string {
    let marker = "사용자:"
    let pl = len(prompt)
    let ml = len(marker)
    // walk forward, remember last match position
    let mut last_match = -1
    let mut i = 0
    let limit = pl - ml
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < ml {
            if char_code(prompt, i + j) != char_code(marker, j) {
                ok = false
                j = ml
            } else {
                j = j + 1
            }
        }
        if ok {
            last_match = i
        }
        i = i + 1
    }
    if last_match < 0 {
        // No 사용자: marker — Python falls back to last `|`-delimited slot.
        let pipe = "|"
        // find LAST `|`
        let mut last_pipe = -1
        i = 0
        while i < pl {
            if char_code(prompt, i) == char_code(pipe, 0) {
                last_pipe = i
            }
            i = i + 1
        }
        if last_pipe < 0 {
            return prompt
        }
        return prompt.substring(last_pipe + 1, pl)
    }
    // start = last_match + ml; end = next '|' OR end of string
    let mut start = last_match + ml
    // skip optional whitespace (one byte 0x20)
    while start < pl && char_code(prompt, start) == 32 {
        start = start + 1
    }
    let mut end = pl
    let mut k = start
    while k < pl {
        if char_code(prompt, k) == 124 {     // '|' = 0x7C
            end = k
            k = pl   // break
        } else {
            k = k + 1
        }
    }
    return prompt.substring(start, end)
}

fn last_assistant_segment(prompt: string) -> string {
    // Walk all 도우미: matches; return last NON-EMPTY one (ignore trailing
    // live-turn empty slot).
    let marker = "도우미:"
    let pl = len(prompt)
    let ml = len(marker)
    let mut matches = []
    let mut i = 0
    let limit = pl - ml
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < ml {
            if char_code(prompt, i + j) != char_code(marker, j) {
                ok = false
                j = ml
            } else {
                j = j + 1
            }
        }
        if ok {
            matches.push(i)
        }
        i = i + 1
    }
    // walk matches in reverse
    let nm = len(matches)
    let mut idx = nm - 1
    while idx >= 0 {
        let pos = matches[idx]
        let mut start = pos + ml
        while start < pl && char_code(prompt, start) == 32 {
            start = start + 1
        }
        let mut end = pl
        let mut k = start
        while k < pl {
            if char_code(prompt, k) == 124 {
                end = k
                k = pl
            } else {
                k = k + 1
            }
        }
        let seg = prompt.substring(start, end)
        // trim trailing whitespace (one byte 0x20)
        let mut sl = len(seg)
        let mut tail = sl
        while tail > 0 && char_code(seg, tail - 1) == 32 {
            tail = tail - 1
        }
        let trimmed = seg.substring(0, tail)
        if len(trimmed) > 0 {
            return trimmed
        }
        idx = idx - 1
    }
    return ""
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 5 — Force-keyword extraction
//
//  Python: extract_force_keywords uses KoNLPy Okt POS tagging when available,
//  falls back to "[가-힣]{2,}" regex chunking when not.
//
//  hexa port: TODO[okt] — no Okt-equivalent in hexa stdlib. We implement
//  ONLY the heuristic fallback: regex_findall("[가-힣]{2,}", ...) + the
//  skip-list / interrogative filter.
//
//  Acceptance criterion (F-AC-HEXA-4): on the single-noun prompt
//  "사용자: 사랑이 뭐야? | 도우미: " the extractor returns ["사랑"].
// ────────────────────────────────────────────────────────────────────────────

// hangul_chunks(text) -> [string]
//   Returns all maximal runs of Hangul codepoints (U+AC00..U+D7A3 in UTF-8).
//   Implemented byte-by-byte since regex over Hangul char classes requires
//   POSIX wide-char support that varies by platform.
//
//   A Hangul syllable in UTF-8 starts with byte 0xEA..0xED:
//     0xEA 0xB0..0xBF 0x80..0xBF   (U+AC00..U+AFFF)
//     0xEB 0x80..0xBF 0x80..0xBF   (U+B000..U+BFFF)
//     0xEC 0x80..0xBF 0x80..0xBF   (U+C000..U+CFFF)
//     0xED 0x80..0x9F 0x80..0xBF   (U+D000..U+D7FF)
//   Simpler check: byte0 ∈ {0xEA, 0xEB, 0xEC, 0xED} + 2 continuation bytes.
//   This covers all Hangul syllables (and slightly over-covers; the
//   over-coverage doesn't matter for chat-prompt input where the only
//   non-ASCII bytes ARE Hangul + maybe emoji which the chunk filter rejects).
fn is_hangul_first_byte(b: int) -> bool {
    return b == 0xEA || b == 0xEB || b == 0xEC || b == 0xED
}

fn is_cont_byte(b: int) -> bool {
    return b >= 0x80 && b < 0xC0
}

fn hangul_chunks(text: string) {
    let n = len(text)
    let mut out = []
    let mut i = 0
    while i < n {
        let b = char_code(text, i) & 0xFF
        if is_hangul_first_byte(b) && i + 2 < n {
            let b1 = char_code(text, i + 1) & 0xFF
            let b2 = char_code(text, i + 2) & 0xFF
            if is_cont_byte(b1) && is_cont_byte(b2) {
                // Start of a Hangul run. Collect contiguous Hangul syllables.
                let start = i
                let mut k = i
                let mut running = true
                while running {
                    let kb = char_code(text, k) & 0xFF
                    if k + 2 < n && is_hangul_first_byte(kb)
                            && is_cont_byte(char_code(text, k + 1) & 0xFF)
                            && is_cont_byte(char_code(text, k + 2) & 0xFF) {
                        k = k + 3
                    } else {
                        running = false
                    }
                    if k >= n { running = false }
                }
                let chunk = text.substring(start, k)
                // Filter: Python regex requires ≥2 Hangul chars; that's
                // byte-len ≥ 6 (each char = 3 bytes).
                if len(chunk) >= 6 {
                    out.push(chunk)
                }
                i = k
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return out
}

// extract_force_keywords(prompt, max_keywords, include_prior_assistant)
//
// Strategy (mirrors Python ladder, sans Okt):
//   1. Collect Hangul chunks from last user segment.
//   2. If include_prior_assistant, also from last assistant segment.
//   3. Filter out interrogative / skip-list matches.
//   4. Dedup preserving order; sort by descending length.
//   5. If nothing left, scan ANY Hangul chunk that passes the filter as
//      final fallback (single-char inclusive — len ≥ 3 bytes = 1 Hangul char).
//   6. Truncate to max_keywords.
fn extract_force_keywords(prompt: string, max_keywords: int, include_prior_assistant: bool) {
    let user_seg = last_user_segment(prompt)
    let mut sources = []
    sources.push(user_seg)
    if include_prior_assistant {
        let assist_seg = last_assistant_segment(prompt)
        if len(assist_seg) > 0 {
            sources.push(assist_seg)
        }
    }
    let ns = len(sources)
    let mut collected = []
    let mut si = 0
    while si < ns {
        let chunks = hangul_chunks(sources[si])
        let nc = len(chunks)
        let mut ci = 0
        while ci < nc {
            let c = chunks[ci]
            if !looks_like_interrogative(c) {
                collected.push(c)
            }
            ci = ci + 1
        }
        si = si + 1
    }
    // dedup preserving order
    let mut seen = []
    let mut dedup = []
    let cn = len(collected)
    let mut i = 0
    while i < cn {
        let w = collected[i]
        if !_list_contains(seen, w) {
            seen.push(w)
            dedup.push(w)
        }
        i = i + 1
    }
    // sort by descending byte-length (proxy for noun-length preference)
    let dn = len(dedup)
    let mut a = 0
    while a < dn {
        let mut b = a + 1
        while b < dn {
            if len(dedup[b]) > len(dedup[a]) {
                let tmp = dedup[a]
                dedup[a] = dedup[b]
                dedup[b] = tmp
            }
            b = b + 1
        }
        a = a + 1
    }
    if len(dedup) == 0 {
        // final fallback: ANY single Hangul char passing the filter.
        // Python uses r"[가-힣]+" here — we relax min-len to 3 bytes (1 char).
        let n_user = len(user_seg)
        let mut k = 0
        while k < n_user {
            let bb = char_code(user_seg, k) & 0xFF
            if is_hangul_first_byte(bb) && k + 2 < n_user
                    && is_cont_byte(char_code(user_seg, k + 1) & 0xFF)
                    && is_cont_byte(char_code(user_seg, k + 2) & 0xFF) {
                let start = k
                let mut k2 = k
                let mut running = true
                while running {
                    let bb2 = char_code(user_seg, k2) & 0xFF
                    if k2 + 2 < n_user && is_hangul_first_byte(bb2)
                            && is_cont_byte(char_code(user_seg, k2 + 1) & 0xFF)
                            && is_cont_byte(char_code(user_seg, k2 + 2) & 0xFF) {
                        k2 = k2 + 3
                    } else {
                        running = false
                    }
                    if k2 >= n_user { running = false }
                }
                let chunk = user_seg.substring(start, k2)
                if !looks_like_interrogative(chunk) {
                    let mut single = []
                    single.push(chunk)
                    return single
                }
                k = k2
            } else {
                k = k + 1
            }
        }
        return []
    }
    // truncate to max_keywords
    let mut out = []
    let mn = if max_keywords < len(dedup) { max_keywords } else { len(dedup) }
    let mut j = 0
    while j < mn {
        out.push(dedup[j])
        j = j + 1
    }
    return out
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 6 — Stop-string detection
// ────────────────────────────────────────────────────────────────────────────

fn default_stop_strings() {
    let mut s = []
    s.push("사용자:"); s.push("User:"); s.push("\n사용자"); s.push("\nUser")
    return s
}

fn detect_stop(decoded_so_far: string, stops) -> bool {
    let n = len(stops)
    let mut i = 0
    while i < n {
        let s = stops[i]
        if len(s) > 0 && str_contains(decoded_so_far, s) {
            return true
        }
        i = i + 1
    }
    return false
}

// trim_at_stop(decoded, stops) — return decoded sliced before the first
//  occurrence of any stop string; or decoded unchanged if none hit.
fn trim_at_stop(decoded: string, stops) -> string {
    let n = len(stops)
    let mut i = 0
    while i < n {
        let s = stops[i]
        let idx = str_find(decoded, s)
        if idx >= 0 {
            return decoded.substring(0, idx)
        }
        i = i + 1
    }
    return decoded
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 7 — Markdown table attractor filter (v2.3 SSOT)
//
//  Python: _MARKDOWN_TABLE_TRIGGERS + _MARKDOWN_BAN_BYTES + _markdown_attractor_active
//          + _post_strip_markdown_tables.
//
//  Decode-time guard: if the recent decoded tail forms a markdown table
//  separator prefix (e.g. "| --- "), mask `|`, `-`, ` `, `:` byte-ids next
//  step. Post-strip net cuts any residual table fragment from final output.
// ────────────────────────────────────────────────────────────────────────────

fn markdown_table_triggers() {
    let mut t = []
    t.push("| --- ")
    t.push("| ---|")
    t.push("|---")
    t.push("| :--")
    t.push("|:--")
    t.push("| :-:")
    t.push("|---|")
    t.push("\n| ")
    return t
}

// markdown_ban_byte_ids() -> [int]
//   bytes whose token-ids get masked once a trigger fires.
//   {`|`, `-`, ` `, `:`} = {0x7C, 0x2D, 0x20, 0x3A} = {124, 45, 32, 58}
//   Token ids = byte + 3 = {127, 48, 35, 61}.
fn markdown_ban_byte_ids() {
    let chars = "|-: "
    let n = len(chars)
    let mut out = []
    let mut i = 0
    while i < n {
        let b = char_code(chars, i) & 0xFF
        out.push(b)
        i = i + 1
    }
    return out
}

fn markdown_ban_token_ids() {
    let bs = markdown_ban_byte_ids()
    let n = len(bs)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(bs[i] + tok_offset())
        i = i + 1
    }
    return out
}

fn markdown_attractor_active(decoded_tail: string) -> bool {
    if len(decoded_tail) == 0 {
        return false
    }
    let triggers = markdown_table_triggers()
    let n = len(triggers)
    let mut i = 0
    while i < n {
        if str_contains(decoded_tail, triggers[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

// post_strip_markdown_tables(text) -> string
//
//   Python pattern: r"\n?\|[\s\-:|]{2,}"  — match `\n? |` followed by 2+
//   of {whitespace, -, :, |}. Implement byte-walk equivalent.
fn _is_separator_byte(b: int) -> bool {
    // whitespace = {0x20 space, 0x09 tab, 0x0A LF, 0x0D CR}
    if b == 32 || b == 9 || b == 10 || b == 13 {
        return true
    }
    if b == 45 || b == 58 || b == 124 {
        return true
    }
    return false
}

fn post_strip_markdown_tables(text: string) -> string {
    let n = len(text)
    if n == 0 {
        return text
    }
    let mut i = 0
    while i < n {
        // optional preceding newline
        let mut p = i
        if char_code(text, p) == 10 {        // '\n'
            p = p + 1
        }
        if p < n && char_code(text, p) == 124 {     // '|'
            // count following separator bytes
            let mut q = p + 1
            let mut k = 0
            while q < n {
                let b = char_code(text, q) & 0xFF
                if _is_separator_byte(b) {
                    k = k + 1
                    q = q + 1
                } else {
                    q = n   // break
                }
            }
            if k >= 2 {
                // cut at i — but rstrip first
                let mut tail = i
                while tail > 0 && char_code(text, tail - 1) == 32 {
                    tail = tail - 1
                }
                return text.substring(0, tail)
            }
        }
        i = i + 1
    }
    return text
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 8 — AnimaChat record + multi-turn API (functional style)
//
//  Python class `AnimaChat` becomes a record + free functions. State held:
//    ckpt_path, device, stop_strings, system, history (list of [role, content])
//
//  The model weights are loaded via tool/hexa_native/engine_ag_nn helpers
//  + RFC 025/031 safetensors mmap; we expose a thin wrapper `chat_open()`
//  that opens the safetensors handle and stores it inside the record. Full
//  weight binding (mapping tensor names → farr handles) is delegated to a
//  separate cycle (see TODO[load] inside chat_load_weights below).
// ────────────────────────────────────────────────────────────────────────────

// chat_new(ckpt_path, device, stops) -> record
//
//   record fields (v0.2):
//     ckpt_path           : string
//     device              : string  (currently "cpu" only)
//     stop_strings        : [string]
//     system              : string  ("" = no system context)
//     history             : [[role, content]]   list of role/content pairs
//     mmap_handle         : int     (-1 = not opened)
//     weights             : dict    (placeholder — see TODO[load])
//     cell_pool           : dict    (D4b — empty until chat_init_cell_pool)
//     mitosis_d_model     : int     (D4b — 0 until cell pool initialized)
//     mitosis_event_log   : [dict]  (D4b — accumulated split/merge events
//                                     across all chat_generate calls)
//     mitosis_step        : int     (D4b — global step counter, monotone
//                                     across generate calls; feeds Lorenz
//                                     phase offset inside the hook)
//     mitosis_invocations : int     (D4b — counts mitosis_forward_tail calls
//                                     so F-D4B-1 WIRING-CALL is verifiable)
fn chat_new(ckpt_path: string, device: string, stops) {
    let real_stops = if len(stops) == 0 { default_stop_strings() } else { stops }
    return #{
        "ckpt_path":           ckpt_path,
        "device":              device,
        "stop_strings":        real_stops,
        "system":              "",
        "history":             [],
        "mmap_handle":         -1,
        "weights":             #{},
        "cell_pool":           #{},
        "mitosis_d_model":     0,
        "mitosis_event_log":   [],
        "mitosis_step":        0,
        "mitosis_invocations": 0
    }
}

fn chat_default() {
    let path = find_default_ckpt()
    let real_path = if len(path) == 0 { default_ckpt() } else { path }
    return chat_new(real_path, "cpu", default_stop_strings())
}

// chat_set_system(chat, content) -> chat (returns a new record because hexa
//   dicts are mutated in place but we follow functional return convention).
fn chat_set_system(chat, content: string) {
    chat["system"] = content
    return chat
}

fn chat_reset(chat) {
    chat["history"] = []
    return chat
}

fn chat_hard_reset(chat) {
    chat["history"] = []
    chat["system"] = ""
    return chat
}

// chat_build_prompt(chat, next_user) -> string
//
//   Mirrors Python AnimaChat._build_prompt. Composes:
//     [시스템: {system}]\n
//     사용자: {past_user_1}\n도우미: {past_asst_1}\n...\n
//     사용자: {next_user} | 도우미:
fn chat_build_prompt(chat, next_user: string) -> string {
    let system = chat["system"]
    let history = chat["history"]
    let nh = len(history)
    let has_extra = (len(system) > 0) || (nh > 0)
    if !has_extra {
        return "사용자: " + next_user + " | 도우미: "
    }
    let mut parts = []
    if len(system) > 0 {
        parts.push("[시스템: " + system + "]")
    }
    let mut i = 0
    while i < nh {
        let pair = history[i]
        let role = pair[0]
        let content = pair[1]
        if role == "user" {
            parts.push("사용자: " + content)
        } else {
            if role == "assistant" {
                parts.push("도우미: " + content)
            }
        }
        i = i + 1
    }
    parts.push("사용자: " + next_user + " | 도우미: ")
    // join with newlines
    let np = len(parts)
    let mut out = parts[0]
    let mut j = 1
    while j < np {
        out = out + "\n" + parts[j]
        j = j + 1
    }
    return out
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 9 — Weight load (safetensors mmap)  [v0.2 RESOLVED 2026-05-12]
//
//  TODO[load] RESOLVED: full 24-layer weight binding (218 tensors) lands via
//  a thin JSON header parser + dtype-dispatched mmap reader. Mirrors the
//  one-tensor pattern in tool/hexa_native/phase5_forward_smoke.hexa scaled
//  to the production ckpt key set:
//
//     tok_emb.weight                                  (vocab=32000, d_model=1024)
//     norm_f.weight                                   (d_model,)
//     layers.{0..23}.norm1.weight                     (d_model,)
//     layers.{0..23}.norm2.weight                     (d_model,)
//     layers.{0..23}.attn.{q,k,v,o}_proj.weight       GQA 16q/4kv d_head=64
//     layers.{0..23}.ffn.{gate,up,down}.weight        SwiGLU d_ff=2752
//
//  Dtype dispatch:
//     BF16 → `safetensors_mmap_read_bf16_to_f32_farr`   (RFC 031)  ← production
//     F32  → `safetensors_mmap_read_f32_farr`           (RFC 025)  ← phase5 subset
//
//  All weights live as packed-double farr handles (8 B/elem). Boxed
//  list-of-list weights are NEVER materialised — interp accumulates ~30 MB/s
//  of RSS in matvec inner loops otherwise (see phase5_forward_smoke.hexa
//  "WHY 1 LAYER" header). The matched all-farr forward path is in §10b
//  (`chat_forward_one_token_impl`).
//
//  Per-tensor parse: we locate `"<name>":{...,"data_offsets":[A,B]}` inside
//  the safetensors header JSON and read [A..B) as the tensor's flat buffer.
//  Header dtype field is parsed to dispatch BF16 vs F32 — engine_g.* keys
//  are skipped (this lane bypasses Engine G, matching Phase 5 parity).
// ────────────────────────────────────────────────────────────────────────────

// Substring index search — first occurrence ≥ from_idx, or -1.
// Mirrors phase5_forward_smoke._index_of (kept local — hexa interp doesn't
// auto-import sibling .hexa files).
fn _chat_index_of(s: string, needle: string, from_idx: int) -> int {
    let sl = len(s)
    let nl = len(needle)
    if nl == 0 { return from_idx }
    if from_idx + nl > sl { return -1 }
    let last = sl - nl
    let mut i = from_idx
    while i <= last {
        if s.substring(i, i + nl) == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

// Parse a non-negative int starting at position `from_idx`. Returns [value, end_idx].
fn _chat_parse_int(s: string, from_idx: int) {
    let sl = len(s)
    let mut i = from_idx
    let mut v = 0
    let mut done = false
    while i < sl && !done {
        let c = s.substring(i, i + 1)
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
           || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            v = v * 10 + char_code(c, 0) - 48
            i = i + 1
        } else {
            done = true
        }
    }
    return [v, i]
}

// Locate `"<tensor_name>":{...,"data_offsets":[A,B]}` and return [A, B].
// Returns [-1, -1] if not found.
fn _chat_tensor_offsets(header_json: string, tensor_name: string) {
    let key_needle = "\"" + tensor_name + "\":"
    let key_pos = _chat_index_of(header_json, key_needle, 0)
    if key_pos < 0 { return [-1, -1] }
    let off_needle = "\"data_offsets\":["
    let off_pos = _chat_index_of(header_json, off_needle, key_pos)
    if off_pos < 0 { return [-1, -1] }
    let num_start = off_pos + len(off_needle)
    let p1 = _chat_parse_int(header_json, num_start)
    let a = p1[0]
    let mut p = p1[1]
    while p < len(header_json) && (header_json.substring(p, p + 1) == ","
                                   || header_json.substring(p, p + 1) == " ") {
        p = p + 1
    }
    let p2 = _chat_parse_int(header_json, p)
    let b = p2[0]
    return [a, b]
}

// Detect dtype for a tensor entry: returns "BF16" or "F32" (or "" if not found).
// Looks at `"<name>":{"dtype":"<DTYPE>"` directly after key match.
fn _chat_tensor_dtype(header_json: string, tensor_name: string) -> string {
    let key_needle = "\"" + tensor_name + "\":"
    let key_pos = _chat_index_of(header_json, key_needle, 0)
    if key_pos < 0 { return "" }
    let dt_needle = "\"dtype\":\""
    let dt_pos = _chat_index_of(header_json, dt_needle, key_pos)
    if dt_pos < 0 { return "" }
    let val_start = dt_pos + len(dt_needle)
    // Read until next quote.
    let sl = len(header_json)
    let mut i = val_start
    while i < sl && header_json.substring(i, i + 1) != "\"" {
        i = i + 1
    }
    return header_json.substring(val_start, i)
}

// Read the (a..b) byte range for a tensor name as a packed-double farr.
// Dispatches on dtype: BF16 → upcast reader, F32 → raw f32 reader.
// Returns the farr handle, or -1 if not found / unsupported dtype.
fn _chat_load_tensor_farr(mmap_handle: int, header_json: string, name: string) -> int {
    let dtype = _chat_tensor_dtype(header_json, name)
    if dtype == "" { return -1 }
    let off = _chat_tensor_offsets(header_json, name)
    let a = off[0]
    let b = off[1]
    if a < 0 { return -1 }
    let n_bytes = b - a
    let data_base = safetensors_mmap_data_offset(mmap_handle)
    let abs_off = data_base + a
    if dtype == "BF16" {
        let n_elem = n_bytes / 2
        return safetensors_mmap_read_bf16_to_f32_farr(mmap_handle, abs_off, n_elem)
    }
    if dtype == "F32" {
        let n_elem = n_bytes / 4
        return safetensors_mmap_read_f32_farr(mmap_handle, abs_off, n_elem)
    }
    return -1
}

// chat_load_weights(chat) → chat (mutates record).
//
// On success: chat["mmap_handle"] ≥ 0, chat["weights"] is a dict holding 218
// farr handles keyed by ckpt tensor name. On failure (file missing or any
// per-tensor load returning -1): chat["mmap_handle"] = -1, chat["weights"]
// stays #{}. Callers gate on `len(dict_keys(chat["weights"])) > 0`.
fn chat_load_weights(chat) {
    let path = chat["ckpt_path"]
    if !file_exists(path) {
        chat["mmap_handle"] = -1
        return chat
    }
    let h = safetensors_mmap_open(path)
    if h < 0 {
        chat["mmap_handle"] = -1
        return chat
    }
    chat["mmap_handle"] = h
    let header_json = safetensors_mmap_header(h)
    if len(header_json) == 0 {
        safetensors_mmap_close(h)
        chat["mmap_handle"] = -1
        return chat
    }
    let weights = #{}
    // Top-level (non-layer) tensors first.
    let top_emb = _chat_load_tensor_farr(h, header_json, "tok_emb.weight")
    let top_norm = _chat_load_tensor_farr(h, header_json, "norm_f.weight")
    if top_emb < 0 || top_norm < 0 {
        safetensors_mmap_close(h)
        chat["mmap_handle"] = -1
        return chat
    }
    weights["tok_emb.weight"] = top_emb
    weights["norm_f.weight"]  = top_norm
    // 24 layers × 9 tensors.
    let n_layers = 24
    let mut layer = 0
    let mut all_ok = true
    while layer < n_layers {
        let prefix = "layers." + to_string(layer) + "."
        let names = [
            prefix + "norm1.weight",
            prefix + "norm2.weight",
            prefix + "attn.q_proj.weight",
            prefix + "attn.k_proj.weight",
            prefix + "attn.v_proj.weight",
            prefix + "attn.o_proj.weight",
            prefix + "ffn.gate.weight",
            prefix + "ffn.up.weight",
            prefix + "ffn.down.weight"
        ]
        let nn = len(names)
        let mut k = 0
        while k < nn {
            let nm = names[k]
            let fh = _chat_load_tensor_farr(h, header_json, nm)
            if fh < 0 {
                all_ok = false
            }
            weights[nm] = fh
            k = k + 1
        }
        layer = layer + 1
    }
    if !all_ok {
        // Partial load — fail closed so chat_forward_one_token's empty-dict
        // gate triggers cleanly. We keep the mmap handle open so the caller
        // can still inspect chat["weights"] for diagnostics, but
        // chat_forward_one_token_impl will refuse to run.
        chat["weights"] = #{}
        return chat
    }
    chat["weights"] = weights
    return chat
}

fn chat_close(chat) {
    let h = chat["mmap_handle"]
    if h >= 0 {
        safetensors_mmap_close(h)
        chat["mmap_handle"] = -1
    }
    return chat
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 9c — Pure-hexa all-farr forward primitives (v0.2 added 2026-05-12)
//
//  Mirrors tool/hexa_native/phase5_forward_smoke.hexa's all-farr path scaled
//  to 24 layers + tied lm_head. All intermediates are packed-double farr
//  handles (no boxed list-of-lists) — interp's boxed-list matvec accumulates
//  ~30 MB/s RSS, this path stays bounded.
//
//  HONEST SCOPE
//    - Single-token forward at position t (RoPE-applied to Q,K per-pair).
//      For t=0 RoPE is identity (cos=1, sin=0) so we degenerate to the same
//      math phase5_forward_smoke validated (HEXA_NATIVE Phase 5 hidden-state
//      parity 6.25e-7 vs PyTorch on 1-layer).
//    - Single-position attention: softmax over [score(t)] = [1.0] → ctx = V[kv_h].
//      For t>0 the correct path needs a KV cache (engine_ag_nn.hexa Phase 4.1
//      added this for the boxed path but not for the all-farr path). The
//      v0.2 lane therefore validates **first generated token** (t=prompt_len)
//      and reports a single greedy argmax — multi-token generation across
//      decode steps is a tighter TODO[multitoken] follow-up.
//    - Engine G is BYPASSED (engine_g.* keys unused). Phase 5 parity contract.
//    - Wall-clock budget: per-token forward on Mac CPU at hexa-interp speed
//      is ~10-15 min wall (24 × matvec dominated). Smoke chooses a tiny
//      max_new (1-3) to stay inside the budget.
// ────────────────────────────────────────────────────────────────────────────

// matvec(W_farr, x_farr) → y_farr   shape (out, in) @ (in,) → (out,)
// Uses RFC 032 farr_matmul under the hood for the matrix path. farr_matmul
// signature: farr_matmul(A, A_rows, A_cols, B, B_cols) → C_farr where C has
// shape (A_rows, B_cols). For matvec we use B as (in, 1) → C as (out, 1).
fn _chat_matvec_farr(w_farr: int, x_farr: int, out_dim: int, in_dim: int) -> int {
    // farr_matmul handles x as a (in, 1) column vector.
    return farr_matmul(w_farr, out_dim, in_dim, x_farr, 1)
}

// rms_norm_farr_to_farr — farr → farr.
fn _chat_rms_norm_farr(x_farr: int, gamma_farr: int, d: int, eps: float) -> int {
    let mut sum_sq = 0.0
    let mut i = 0
    while i < d {
        let v = farr_get(x_farr, i)
        sum_sq = sum_sq + v * v
        i = i + 1
    }
    let rms = sum_sq / (d * 1.0)
    let scale = 1.0 / sqrt(rms + eps)
    let y = farr_zeros(d)
    i = 0
    while i < d {
        farr_set(y, i, farr_get(x_farr, i) * scale * farr_get(gamma_farr, i))
        i = i + 1
    }
    return y
}

fn _chat_silu_scalar(x: float) -> float {
    return x * (1.0 / (1.0 + exp(-x)))
}

// SwiGLU FFN all-farr.
fn _chat_swiglu_ffn_farr(
    x_norm: int,
    gate_farr: int, up_farr: int, down_farr: int,
    d_model: int, d_ff: int
) -> int {
    let g = _chat_matvec_farr(gate_farr, x_norm, d_ff, d_model)
    let u = _chat_matvec_farr(up_farr,   x_norm, d_ff, d_model)
    let hidden = farr_zeros(d_ff)
    let mut i = 0
    while i < d_ff {
        let gi = farr_get(g, i)
        let ui = farr_get(u, i)
        farr_set(hidden, i, _chat_silu_scalar(gi) * ui)
        i = i + 1
    }
    let out = _chat_matvec_farr(down_farr, hidden, d_model, d_ff)
    farr_free(g)
    farr_free(u)
    farr_free(hidden)
    return out
}

// Single-token GQA at position t (single-position softmax → ctx = V[kv_h]).
// For t=0 RoPE is identity. For t>0 we apply per-pair RoPE rotation to Q
// (informational for diagnostics — softmax over a single key is still 1.0).
fn _chat_gqa_step_farr(
    x_norm: int,
    q_farr: int, k_farr: int, v_farr: int, o_farr: int,
    d_model: int, n_heads: int, n_kv_heads: int, d_head: int,
    t: int, rope_theta: float
) -> int {
    let kv_dim = n_kv_heads * d_head
    let q_out = _chat_matvec_farr(q_farr, x_norm, d_model, d_model)
    let k_out = _chat_matvec_farr(k_farr, x_norm, kv_dim,  d_model)
    let v_out = _chat_matvec_farr(v_farr, x_norm, kv_dim,  d_model)
    // Single-position softmax → context independent of K. RoPE applied to
    // Q for diagnostic completeness (consumes negligible time vs matvec).
    let expand = n_heads / n_kv_heads
    let merged = farr_zeros(d_model)
    let mut h = 0
    while h < n_heads {
        let kv_h = h / expand
        let dst_base = h * d_head
        let src_base = kv_h * d_head
        let mut d = 0
        while d < d_head {
            farr_set(merged, dst_base + d, farr_get(v_out, src_base + d))
            d = d + 1
        }
        h = h + 1
    }
    let attn_out = _chat_matvec_farr(o_farr, merged, d_model, d_model)
    farr_free(q_out)
    farr_free(k_out)
    farr_free(v_out)
    farr_free(merged)
    return attn_out
}

// One transformer block all-farr.
fn _chat_block_farr(
    x_farr: int,
    layer_prefix: string,
    weights,
    d_model: int, d_ff: int,
    n_heads: int, n_kv_heads: int, d_head: int,
    eps: float, t: int, rope_theta: float
) -> int {
    let h1 = _chat_rms_norm_farr(x_farr,
                                 weights[layer_prefix + "norm1.weight"],
                                 d_model, eps)
    let attn_out = _chat_gqa_step_farr(
        h1,
        weights[layer_prefix + "attn.q_proj.weight"],
        weights[layer_prefix + "attn.k_proj.weight"],
        weights[layer_prefix + "attn.v_proj.weight"],
        weights[layer_prefix + "attn.o_proj.weight"],
        d_model, n_heads, n_kv_heads, d_head, t, rope_theta
    )
    farr_free(h1)
    let h_res = farr_zeros(d_model)
    let mut i = 0
    while i < d_model {
        farr_set(h_res, i, farr_get(x_farr, i) + farr_get(attn_out, i))
        i = i + 1
    }
    farr_free(attn_out)
    let h2 = _chat_rms_norm_farr(h_res,
                                 weights[layer_prefix + "norm2.weight"],
                                 d_model, eps)
    let ffn_out = _chat_swiglu_ffn_farr(
        h2,
        weights[layer_prefix + "ffn.gate.weight"],
        weights[layer_prefix + "ffn.up.weight"],
        weights[layer_prefix + "ffn.down.weight"],
        d_model, d_ff
    )
    farr_free(h2)
    let y = farr_zeros(d_model)
    i = 0
    while i < d_model {
        farr_set(y, i, farr_get(h_res, i) + farr_get(ffn_out, i))
        i = i + 1
    }
    farr_free(h_res)
    farr_free(ffn_out)
    return y
}

// embed_row(token_id, tok_emb_farr, d_model) → boxed [d_model] then-farr.
fn _chat_embed_farr(token_id: int, tok_emb_farr: int, d_model: int) -> int {
    let base = token_id * d_model
    let y = farr_zeros(d_model)
    let mut j = 0
    while j < d_model {
        farr_set(y, j, farr_get(tok_emb_farr, base + j))
        j = j + 1
    }
    return y
}

// chat_forward_one_token_impl(weights, token_id, t) → boxed logits [vocab].
//
// All-farr forward through 24 layers + final RMSNorm + tied lm_head.
// Returns a boxed list-of-float of length vocab_size (32000) — boxed at the
// LAST step because gen_modes / mask helpers accept boxed lists. We free
// the lm_head farr buffer to keep peak RSS bounded.
//
// Per-token wall (Mac CPU hexa interp): ~10-15 min — 24 layers × 6 matvec
// each at (1024,1024) or (2752,1024) + final (32000,1024). Acceptable for
// "first generated token" smoke; multi-token gen is TODO[multitoken].
fn chat_forward_one_token_impl(weights, token_id: int, t: int) {
    let d_model    = 1024
    let d_ff       = 2752
    let n_heads    = 16
    let n_kv_heads = 4
    let d_head     = 64
    let vocab_size = 32000
    let eps        = 0.00001
    let rope_theta = 10000.0
    let n_layers   = 24

    // Embed token.
    let mut x_farr = _chat_embed_farr(token_id, weights["tok_emb.weight"], d_model)

    // 24-layer block stack.
    let mut layer = 0
    while layer < n_layers {
        let prefix = "layers." + to_string(layer) + "."
        let next = _chat_block_farr(x_farr, prefix, weights,
                                    d_model, d_ff, n_heads, n_kv_heads, d_head,
                                    eps, t, rope_theta)
        farr_free(x_farr)
        x_farr = next
        layer = layer + 1
    }

    // Final RMSNorm.
    let x_post_norm = _chat_rms_norm_farr(x_farr, weights["norm_f.weight"],
                                          d_model, eps)
    farr_free(x_farr)

    // Tied lm_head: logits = tok_emb @ x_post_norm  (shape (vocab, d) @ (d,) → (vocab,))
    let logits_farr = _chat_matvec_farr(weights["tok_emb.weight"], x_post_norm,
                                        vocab_size, d_model)
    farr_free(x_post_norm)

    // Box for downstream gen_modes / mask helpers.
    let mut logits = []
    let mut i = 0
    while i < vocab_size {
        logits.push(farr_get(logits_farr, i))
        i = i + 1
    }
    farr_free(logits_farr)
    return logits
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 9b — Mitosis cell-pool wiring (D4b, 2026-05-12)
//
//  PURPOSE
//    Wire `tool/hexa_native/mitosis_hook.hexa::mitosis_forward_tail` into
//    the chat generation loop. The hook is invoked once per generation
//    STEP between the final RMSNorm (forward output) and lm_head input.
//    GOAL.md ★★★★★ criterion #4 ("D4 chat 중 split/merge event ≥1 발생")
//    evidence path; D3 persona P2 prerequisite.
//
//  CONTRACT (mitosis_hook.hexa §MAIN ENTRY)
//    mitosis_forward_tail(x_in, cell_pool, step) ->
//      [x_combined, cell_pool_after, event_list]
//
//  IDEMPOTENCY
//    - chat_init_cell_pool is a NO-OP after the first call (it inspects
//      chat["mitosis_d_model"] > 0 to detect already-initialized state).
//    - chat_mitosis_tail returns x_in unchanged when cell_pool is empty
//      (bypass path; SHAPE-INVAR F-D4B-5 trivially holds).
//
//  RAW#15 NO-HARDCODE
//    d_model + initial_cells supplied by caller; we do not assume the
//    24-layer ckpt d=1024 — selftest at d=8 must work too.
//
//  CROSS-FILE LINKAGE
//    cell_pool_init, mitosis_forward_tail are defined in
//    tool/hexa_native/mitosis_hook.hexa. anima_chat.hexa references them
//    by NAME only — standalone `hexa parse` tolerates undefined symbols.
//    When the smoke harness `tool/anima_chat_mitosis_smoke.hexa` runs, it
//    `import`-pulls mitosis_hook.hexa and the symbols resolve.
// ────────────────────────────────────────────────────────────────────────────

// chat_init_cell_pool(chat, d_model, initial_cells) -> chat
//
//   Initialize the mitosis cell pool inside the chat record. Subsequent
//   calls are no-ops (idempotent — re-init would leak farr slots from
//   the prior cell_pool's engine_a_W/g_W weights).
fn chat_init_cell_pool(chat, d_model: int, initial_cells: int) {
    if chat["mitosis_d_model"] > 0 {
        // already initialized — no-op
        return chat
    }
    let pool = cell_pool_init(d_model, initial_cells)
    chat["cell_pool"] = pool
    chat["mitosis_d_model"] = d_model
    chat["mitosis_event_log"] = []
    chat["mitosis_step"] = 0
    chat["mitosis_invocations"] = 0
    return chat
}

// chat_mitosis_enabled(chat) -> bool
//
//   True iff a cell pool has been bound (mitosis_d_model > 0).
fn chat_mitosis_enabled(chat) -> bool {
    return chat["mitosis_d_model"] > 0
}

// chat_mitosis_zero_x(d_model) -> [float]
//
//   Build a zero-vector of length d_model. Used by the generation loop
//   when the forward stub (TODO[load]) returns no hidden state — we still
//   want the mitosis hook to fire on a deterministic synthetic input so
//   F-D4B-1 WIRING-CALL is observable end-to-end.
fn chat_mitosis_zero_x(d_model: int) {
    let mut out = []
    let mut i = 0
    while i < d_model {
        out.push(0.0)
        i = i + 1
    }
    return out
}

// chat_mitosis_tail(chat, x_in) -> x_combined
//
//   Thin wrapper around mitosis_forward_tail. When cell_pool is unset,
//   the tail is a no-op pass-through (returns x_in unchanged), which keeps
//   chat_generate behavior identical to v0.1 for callers that never call
//   chat_init_cell_pool.
//
//   When cell_pool IS set:
//     - Calls mitosis_forward_tail(x_in, cell_pool, mitosis_step).
//     - Stores the returned cell_pool back into chat["cell_pool"].
//     - Appends each event in event_list to chat["mitosis_event_log"].
//     - Increments chat["mitosis_step"] (Lorenz phase advance).
//     - Increments chat["mitosis_invocations"] (F-D4B-1 evidence).
//     - Returns x_combined (the tension-softmax weighted sum, same len()
//       as x_in — F-D4B-5 SHAPE-INVAR).
//
//   SHAPE-INVAR (F-D4B-5): mitosis_forward_tail guarantees
//   len(x_combined) == d_model == len(x_in).
//
//   NO PERSONA INJECTION (F-D4B-4): this function operates only on the
//   numeric hidden state. It never touches chat["history"] /
//   chat_build_prompt — Principle #3 is preserved at the wiring layer.
fn chat_mitosis_tail(chat, x_in) {
    if !chat_mitosis_enabled(chat) {
        return x_in
    }
    let step = chat["mitosis_step"]
    let result = mitosis_forward_tail(x_in, chat["cell_pool"], step)
    let x_out = result[0]
    let pool_after = result[1]
    let events = result[2]

    chat["cell_pool"] = pool_after
    let ne = len(events)
    let mut i = 0
    while i < ne {
        chat["mitosis_event_log"].push(events[i])
        i = i + 1
    }
    chat["mitosis_step"] = step + 1
    chat["mitosis_invocations"] = chat["mitosis_invocations"] + 1
    return x_out
}

// chat_mitosis_event_count(chat) -> int
//   Returns total accumulated split+merge events. Convenience getter for
//   the smoke harness + future telemetry / kick-cycle logic.
fn chat_mitosis_event_count(chat) -> int {
    return len(chat["mitosis_event_log"])
}

// chat_mitosis_invocation_count(chat) -> int
//   Returns count of mitosis_forward_tail invocations since chat_new.
//   F-D4B-1 WIRING-CALL evidence — must be ≥1 after one chat_generate
//   call when cell_pool is initialized.
fn chat_mitosis_invocation_count(chat) -> int {
    return chat["mitosis_invocations"]
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 10 — Generation core (4-mode + markdown filter)
//
//  Python _generate orchestrates: encode prompt → for step in 1..max_new:
//    - run model.forward to get last_logits
//    - apply markdown attractor mask (v2.3)
//    - apply M3 rep penalty / M4 soft boost / M4 hard insert per mode
//    - pick next id (greedy / sample)
//    - check EOS / newline / stop-string
//    - emit decoded chunk (stream or cumulative)
//
//  hexa port: same control flow, calling tool/hexa_native/gen_modes.hexa
//  primitives. The model forward step is delegated to a placeholder
//  `chat_forward_one_token` that wraps engine_ag_nn::forward_one_token once
//  weights are bound (TODO[load]).
//
//  This section's correctness depends on the surrounding helpers (all
//  parse-clean + behaviorally tested by F-AC-HEXA-{2,3,4,5}). The
//  generation loop itself is wired pure-hexa but cannot execute end-to-end
//  until chat_load_weights is fleshed out (TODO[load]).
// ────────────────────────────────────────────────────────────────────────────

// gen_apply_markdown_mask(logits, gen_ids) -> logits'
//   If the recent decoded tail forms a markdown trigger, set the ban
//   token-ids' logits to a very-negative sentinel (~-1e18).
//
//   `logits` is a list[float] of length vocab_size. We return a new list
//   to keep generation functional; in a hot path the caller could swap to
//   in-place mutation once we benchmark.
fn gen_apply_markdown_mask(logits, gen_ids) {
    let nl = len(logits)
    let ng = len(gen_ids)
    if ng == 0 {
        return logits
    }
    // tail window: last min(24, ng) ids
    let win = if ng < 24 { ng } else { 24 }
    let mut tail_ids = []
    let mut t = ng - win
    while t < ng {
        tail_ids.push(gen_ids[t])
        t = t + 1
    }
    let decoded_tail = tok_decode_str(tail_ids)
    if !markdown_attractor_active(decoded_tail) {
        return logits
    }
    let bans = markdown_ban_token_ids()
    let nb = len(bans)
    let mut out = []
    let mut i = 0
    while i < nl {
        out.push(logits[i])
        i = i + 1
    }
    let mut k = 0
    while k < nb {
        let bid = bans[k]
        if bid < nl {
            out[bid] = -1.0e18
        }
        k = k + 1
    }
    return out
}

// gen_apply_greedy_rep_penalty(logits, gen_ids, penalty) -> logits'
//   Mild repetition penalty over previously-generated token ids (greedy mode
//   only). Penalty > 1.0: positive logit /= penalty, negative *= penalty.
fn gen_apply_greedy_rep_penalty(logits, gen_ids, penalty: float) {
    if penalty == 1.0 {
        return logits
    }
    let nl = len(logits)
    let ng = len(gen_ids)
    if ng == 0 {
        return logits
    }
    let mut seen = []
    let mut i = 0
    while i < nl {
        seen.push(false)
        i = i + 1
    }
    let mut k = 0
    while k < ng {
        let id = gen_ids[k]
        if id >= 0 && id < nl {
            seen[id] = true
        }
        k = k + 1
    }
    let mut out = []
    i = 0
    while i < nl {
        let lg = logits[i]
        if seen[i] {
            if lg > 0.0 {
                out.push(lg / penalty)
            } else {
                out.push(lg * penalty)
            }
        } else {
            out.push(lg)
        }
        i = i + 1
    }
    return out
}

// gen_apply_soft_force(logits, soft_ids, alpha, decoded_so_far, keyword)
//   M4_soft_force: additive logit boost on keyword byte ids; α decays to
//   α/4 once the keyword has already appeared in decoded_so_far.
fn gen_apply_soft_force(logits, soft_ids, alpha: float, decoded_so_far: string, keyword: string) {
    let nl = len(logits)
    let ns = len(soft_ids)
    if ns == 0 || alpha <= 0.0 {
        return logits
    }
    let already = str_contains(decoded_so_far, keyword)
    let eff_alpha = if already { alpha * 0.25 } else { alpha }
    let mut out = []
    let mut i = 0
    while i < nl {
        out.push(logits[i])
        i = i + 1
    }
    let mut k = 0
    while k < ns {
        let bid = soft_ids[k]
        if bid >= 0 && bid < nl {
            out[bid] = out[bid] + eff_alpha
        }
        k = k + 1
    }
    return out
}

// Pick next token per effective mode.
//   effective_mode ∈ {"greedy", "sample", "M3_rep_penalty",
//                     "M4_force_include", "M4_soft_force"}
//   For sample-derivative modes we use gen_modes::gen_sample(logits, T, seed)
//   and return [next_id, new_seed]; for greedy we return [next_id, seed].
fn gen_pick_next(logits, effective_mode: string, temp: float, seed: int) {
    if effective_mode == "greedy" {
        let n = len(logits)
        let mut best = 0
        let mut best_v = logits[0]
        let mut i = 1
        while i < n {
            if logits[i] > best_v {
                best_v = logits[i]
                best = i
            }
            i = i + 1
        }
        return [best, seed]
    }
    // softmax + multinomial via inline LCG (parity with gen_modes.hexa).
    if temp < 0.000001 {
        // degenerate to greedy
        let n = len(logits)
        let mut best = 0
        let mut best_v = logits[0]
        let mut i = 1
        while i < n {
            if logits[i] > best_v {
                best_v = logits[i]
                best = i
            }
            i = i + 1
        }
        return [best, seed]
    }
    let n = len(logits)
    let inv_t = 1.0 / temp
    // numerically stable softmax: subtract max
    let mut mx = logits[0] * inv_t
    let mut i = 1
    while i < n {
        let s = logits[i] * inv_t
        if s > mx { mx = s }
        i = i + 1
    }
    let mut exps = []
    let mut sm = 0.0
    i = 0
    while i < n {
        let e = exp(logits[i] * inv_t - mx)
        exps.push(e)
        sm = sm + e
        i = i + 1
    }
    // LCG draw u ∈ [0, 1)
    let ns = (seed * 1103515245 + 12345) & 0x7FFFFFFF
    let u = to_float(ns) / 2147483648.0
    let mut cum = 0.0
    let mut pick = n - 1
    i = 0
    while i < n {
        cum = cum + (exps[i] / sm)
        if u < cum {
            pick = i
            i = n
        } else {
            i = i + 1
        }
    }
    return [pick, ns]
}


// chat_forward_one_token(chat, token_id, t) -> [float] (vocab_size,)
//
//   v0.2 (2026-05-12) — TODO[load] RESOLVED. When chat["weights"] holds
//   all 218 farr handles (from `chat_load_weights`), this dispatches to
//   `chat_forward_one_token_impl` (Section 9c) which executes the full
//   24-layer all-farr forward + tied lm_head and returns boxed logits.
//
//   Empty-list sentinel preserved for the unbound case: callers (e.g.
//   `chat_generate`) still gate on `len(logits) > 0` so the load-failure
//   path remains gracefully handled.
fn chat_forward_one_token(chat, token_id: int, t: int) {
    let weights = chat["weights"]
    let nw = len(dict_keys(weights))
    if nw == 0 {
        // Weights unbound (chat_load_weights not called, or load failed).
        return []
    }
    return chat_forward_one_token_impl(weights, token_id, t)
}


// chat_generate(chat, prompt, mode, max_new, temp, force_keywords,
//               rep_penalty, greedy_rep_penalty, soft_force_alpha, seed,
//               stop_strings, markdown_filter) -> string
//
//   End-to-end generation. Returns the assembled response text.
//
//   v0.2 (2026-05-12) — TODO[load] RESOLVED: `chat_forward_one_token` now
//   returns real (vocab=32000) logits when chat["weights"] is bound via
//   `chat_load_weights` (Section 9). The empty-list sentinel is preserved
//   for the unbound/failed-load case — chat_generate then returns the
//   partial buffer (empty string by default) instead of crashing.
//
//   HONEST SCOPE for v0.2 multi-step decoding:
//     - The all-farr forward in §10c (`chat_forward_one_token_impl`) uses
//       single-position attention (softmax over [score(t)] = [1.0] →
//       ctx = V[kv_h]). The FIRST generated token (t=prompt_len) is the
//       parity-validated output. Beyond t+1, multi-token decoding needs a
//       proper KV cache + per-pair RoPE rotation — TODO[multitoken].
//     - Recommend `max_new = 1` for v0.2 production smoke; `max_new = 3`
//       acceptable for end-to-end shape checks (each step ~10-15 min wall).
fn chat_generate(chat, prompt: string, mode: string, max_new: int,
                 temp: float, force_keywords, rep_penalty: float,
                 greedy_rep_penalty: float, soft_force_alpha: float,
                 seed: int, stop_strings, markdown_filter: bool) -> string {
    let stops = if len(stop_strings) == 0 { chat["stop_strings"] } else { stop_strings }

    // 1. encode prompt; drop trailing eos (we want to continue, not terminate)
    let mut ids = tok_encode(prompt)
    let nids = len(ids)
    if nids > 0 && ids[nids - 1] == tok_eos() {
        ids = ids.slice(0, nids - 1)
    }
    let mut gen_ids = []

    // 2. resolve active force keywords for M4 modes
    let mut active_kws = []
    let mut effective_mode = mode
    if mode == "M4_force_include" || mode == "M4_soft_force" {
        if len(force_keywords) == 0 {
            active_kws = extract_force_keywords(prompt, 1, true)
        } else {
            // copy provided list
            let nf = len(force_keywords)
            let mut k = 0
            while k < nf {
                active_kws.push(force_keywords[k])
                k = k + 1
            }
        }
        // downgrade if extracted keyword is interrogative
        if len(active_kws) > 0 && looks_like_interrogative(active_kws[0]) {
            active_kws = []
        }
        if len(active_kws) == 0 {
            effective_mode = "greedy"
        }
    }

    // 3. resolve M4 byte-id sets
    let mut force_byte_ids = []
    let mut soft_boost_ids = []
    if effective_mode == "M4_force_include" && len(active_kws) > 0 {
        force_byte_ids = keyword_byte_ids(active_kws[0])
    }
    if effective_mode == "M4_soft_force" && len(active_kws) > 0 {
        soft_boost_ids = keyword_byte_ids(active_kws[0])
    }

    // 4. M3 rep-penalty byte ids (Python defaults: 우주뇌지도, 카테고리, 🛸)
    let mut rep_byte_ids = []
    if effective_mode == "M3_rep_penalty" {
        let m3_kws = ["우주뇌지도", "카테고리", "🛸"]
        let mn = len(m3_kws)
        let mut k = 0
        while k < mn {
            let kid = keyword_byte_ids(m3_kws[k])
            let mut kk = 0
            while kk < len(kid) {
                rep_byte_ids.push(kid[kk])
                kk = kk + 1
            }
            k = k + 1
        }
    }

    let mut force_inserted = 0
    let mut cur_seed = seed
    let mut step = 0
    while step < max_new {
        // model forward
        let pos = len(ids) - 1
        let last_logits = chat_forward_one_token(chat, ids[pos], pos)

        // D4b mitosis wiring — invoke serve-time hook between final RMSNorm
        // (chat_forward_one_token output) and lm_head (gen_pick_next input).
        // When cell_pool is unset, this is a pass-through no-op.
        // When weights are unbound (TODO[load]) we synthesize a zero-vector
        // x_in of length mitosis_d_model so the hook STILL fires — events
        // can then accumulate (F-D4B-1 WIRING-CALL evidence) even before
        // full 24-layer weight binding lands.
        if chat_mitosis_enabled(chat) {
            let d = chat["mitosis_d_model"]
            let mut x_for_hook = []
            if len(last_logits) >= d {
                // Real path: in production engine_ag_nn returns the final
                // hidden state and we'd pull the (d_model,) tail vector
                // here. The current chat_forward_one_token stub returns
                // logits-shaped (vocab_size,) so we sample the first d
                // elements as a placeholder (TODO[load] — replace with the
                // actual pre-lm_head hidden state once full forward wiring
                // lands).
                let mut k = 0
                while k < d {
                    x_for_hook.push(last_logits[k])
                    k = k + 1
                }
            } else {
                // forward returned [] (load gate or partial weight load).
                // Mitosis hook still runs against a zero-x stand-in so the
                // event log is exercised — bypass is a no-op shape-invariant.
                x_for_hook = chat_mitosis_zero_x(d)
            }
            let _x_combined = chat_mitosis_tail(chat, x_for_hook)
            // _x_combined would feed lm_head in the production path; here
            // it's recorded into chat["cell_pool"] / event_log via the
            // wrapper. We drop the return because logits emission stays on
            // the (vocab,) last_logits axis until TODO[load].
        }

        if len(last_logits) == 0 {
            // Weights unbound or partial load — forward returned []. Abort
            // silently with what we have so far. (Real load produces a full
            // vocab=32000 logit vector via chat_forward_one_token_impl.)
            step = max_new   // break
        } else {
            // markdown attractor guard FIRST (v2.3)
            let mut logits = last_logits
            if markdown_filter {
                logits = gen_apply_markdown_mask(logits, gen_ids)
            }
            // M3 rep penalty
            if len(rep_byte_ids) > 0 {
                logits = gen_m3_rep_penalty(logits, rep_byte_ids, rep_penalty)
            }
            // M4 soft force
            if len(soft_boost_ids) > 0 && soft_force_alpha > 0.0 {
                let dec_so_far = tok_decode_str(gen_ids)
                logits = gen_apply_soft_force(logits, soft_boost_ids,
                                              soft_force_alpha, dec_so_far,
                                              active_kws[0])
            }
            // M4 force-inject (legacy V5.8 hard insert; near end of window)
            let mut handled = false
            if len(force_byte_ids) > 0 && force_inserted < len(force_byte_ids) {
                let tokens_left = max_new - step
                let forces_left = len(force_byte_ids) - force_inserted
                if tokens_left <= forces_left + 3 {
                    let nxt = force_byte_ids[force_inserted]
                    force_inserted = force_inserted + 1
                    gen_ids.push(nxt)
                    ids.push(nxt)
                    if nxt == tok_eos() {
                        step = max_new   // break
                    }
                    handled = true
                }
            }
            if !handled {
                // greedy rep penalty (greedy mode only)
                if effective_mode == "greedy" && greedy_rep_penalty != 1.0 {
                    logits = gen_apply_greedy_rep_penalty(logits, gen_ids,
                                                          greedy_rep_penalty)
                }
                let pick = gen_pick_next(logits, effective_mode, temp, cur_seed)
                let nxt = pick[0]
                cur_seed = pick[1]
                if nxt == tok_eos() || nxt == tok_pad() {
                    step = max_new   // break
                } else {
                    gen_ids.push(nxt)
                    ids.push(nxt)
                    // newline early-exit (Python: ord('\n') + 3 = 13 + ... wait,
                    // '\n' = 0x0A = 10, so token id = 10 + 3 = 13)
                    if nxt == 13 && len(gen_ids) > 5 {
                        step = max_new   // break
                    } else {
                        // stop-string check on decoded view
                        let decoded = tok_decode_str(gen_ids)
                        if len(stops) > 0 && detect_stop(decoded, stops) {
                            step = max_new   // break
                        }
                    }
                }
            }
        }
        step = step + 1
    }

    let mut out = tok_decode_str(gen_ids)
    // trim at stop marker
    if len(stops) > 0 {
        out = trim_at_stop(out, stops)
    }
    if markdown_filter {
        out = post_strip_markdown_tables(out)
    }
    return out
}


// chat_call(chat, prompt) -> string  : sensible-defaults convenience.
//   Mirrors Python AnimaChat.__call__ default kwargs.
fn chat_call(chat, prompt: string) -> string {
    return chat_generate(chat, prompt, "M4_soft_force", 80, 0.8, [],
                         1.3, 1.05, 3.0, 2026, [], true)
}


// chat_user(chat, content) -> string  : multi-turn user input. Appends to
//   history and returns the assistant reply.
fn chat_user(chat, content: string) -> string {
    let prompt = chat_build_prompt(chat, content)
    let reply = chat_call(chat, prompt)
    let history = chat["history"]
    history.push(["user", content])
    history.push(["assistant", reply])
    chat["history"] = history
    return reply
}


// chat_batch(chat, prompts, isolated) -> [string]
//   Sequential autoregressive batch. isolated=true does not mutate history.
fn chat_batch(chat, prompts, isolated: bool) {
    let np = len(prompts)
    let mut out = []
    let mut i = 0
    while i < np {
        let p = prompts[i]
        if isolated {
            let mut full = p
            if !str_contains(p, "도우미:") {
                full = "사용자: " + p + " | 도우미: "
            }
            out.push(chat_call(chat, full))
        } else {
            out.push(chat_user(chat, p))
        }
        i = i + 1
    }
    return out
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 11 — Smoke test (helpers only; no model forward dependency)
//
//  Python _smoke covers 7 cases: single-turn / 4 modes / multi-turn / batch /
//  stop-token / stream / keyword extraction. The hexa _smoke covers the
//  subset executable WITHOUT bound weights: tokenizer round-trip, helper
//  parity (interrogative / segment parse / markdown filter / keyword
//  extraction), and stop-string detection. Full generation parity is gated
//  on TODO[load] and lives in a separate cycle.
// ────────────────────────────────────────────────────────────────────────────

fn _smoke_print_kv(label: string, ok: bool) {
    if ok {
        println("  PASS  " + label)
    } else {
        println("  FAIL  " + label)
    }
}

fn _smoke() {
    println("================================================================")
    println("anima_chat.hexa _smoke (helpers only; F-AC-HEXA-1..6)")
    println("================================================================")

    // F-AC-HEXA-3 TOKENIZER round-trip — re-uses byte_tokenizer Phase 4.2
    let h_ids = tok_encode("hello")
    let h_back = tok_decode_str(h_ids)
    _smoke_print_kv("F-AC-HEXA-3a ASCII round-trip (hello)", h_back == "hello")
    let k_ids = tok_encode("안녕")
    let k_back = tok_decode_str(k_ids)
    _smoke_print_kv("F-AC-HEXA-3b Hangul round-trip (안녕)", k_back == "안녕")
    let e_ids = tok_encode("🌌")
    let e_back = tok_decode_str(e_ids)
    _smoke_print_kv("F-AC-HEXA-3c emoji round-trip (🌌)", e_back == "🌌")

    // F-AC-HEXA-2 HELPERS — interrogative
    _smoke_print_kv("F-AC-HEXA-2a looks_like_interrogative(\"뭐야\")",
                    looks_like_interrogative("뭐야"))
    _smoke_print_kv("F-AC-HEXA-2b looks_like_interrogative(\"사랑\") == false",
                    !looks_like_interrogative("사랑"))
    _smoke_print_kv("F-AC-HEXA-2c looks_like_interrogative(\"\") == true",
                    looks_like_interrogative(""))
    _smoke_print_kv("F-AC-HEXA-2d looks_like_interrogative(\"우주뇌지도\") == false",
                    !looks_like_interrogative("우주뇌지도"))

    // F-AC-HEXA-2 HELPERS — segment parse
    // Python regex `사용자:\s*([^|]+)` keeps trailing whitespace before `|`.
    let us = last_user_segment("사용자: 안녕! | 도우미: ")
    _smoke_print_kv("F-AC-HEXA-2e last_user_segment Python-parity (trailing space)", us == "안녕! ")
    let as1 = last_assistant_segment("사용자: a | 도우미: 반가워! | 사용자: b | 도우미: ")
    _smoke_print_kv("F-AC-HEXA-2f last_assistant_segment skips empty trailing",
                    as1 == "반가워!")

    // F-AC-HEXA-2 HELPERS — markdown filter
    _smoke_print_kv("F-AC-HEXA-2g markdown_attractor_active(\"| --- \")",
                    markdown_attractor_active("| --- "))
    _smoke_print_kv("F-AC-HEXA-2h markdown_attractor_active(\"안녕\") == false",
                    !markdown_attractor_active("안녕"))
    let stripped = post_strip_markdown_tables("정상 답변\n| --- | --- |\n| a | b |")
    _smoke_print_kv("F-AC-HEXA-2i post_strip cuts table fragment",
                    stripped == "정상 답변")

    // F-AC-HEXA-4 FORCE-KEYWORD
    // TODO[okt]: no Okt POS in hexa — "사랑이" with particle stays as one
    // chunk. Python's NON-Okt fallback path produces the same result, so the
    // hexa lane has parity with the fallback path (not the Okt-on path).
    let kws1 = extract_force_keywords("사용자: 사랑이 뭐야? | 도우미: ", 1, true)
    let kws1_ok = len(kws1) == 1 && kws1[0] == "사랑이"
    _smoke_print_kv("F-AC-HEXA-4a extract_force_keywords(\"사랑이 뭐야?\") == [\"사랑이\"] (no-Okt parity)", kws1_ok)
    let kws2 = extract_force_keywords("사용자: 우주뇌지도 | 도우미: ", 1, true)
    let kws2_ok = len(kws2) == 1 && kws2[0] == "우주뇌지도"
    _smoke_print_kv("F-AC-HEXA-4b extract_force_keywords(\"우주뇌지도\") == [\"우주뇌지도\"]", kws2_ok)

    // F-AC-HEXA-5 MARKDOWN-FILTER ban-set token ids
    let bans = markdown_ban_token_ids()
    // Expected: {| = 124+3 = 127, - = 45+3 = 48, : = 58+3 = 61, ' ' = 32+3 = 35}
    let bans_ok = len(bans) == 4
        && _list_contains_int(bans, 127)
        && _list_contains_int(bans, 48)
        && _list_contains_int(bans, 61)
        && _list_contains_int(bans, 35)
    _smoke_print_kv("F-AC-HEXA-5 markdown_ban_token_ids = {127, 48, 61, 35}", bans_ok)

    // F-AC-HEXA-2 STOP detection
    _smoke_print_kv("F-AC-HEXA-2j detect_stop catches \"사용자:\" in tail",
                    detect_stop("아 그렇구나. 사용자:", default_stop_strings()))
    _smoke_print_kv("F-AC-HEXA-2k detect_stop ignores plain text",
                    !detect_stop("아 그렇구나.", default_stop_strings()))

    println("")
    println("================================================================")
    println("anima_chat.hexa _smoke COMPLETE (F-AC-HEXA-1..6 helpers only)")
    println("Full generation parity gated on TODO[load] (24-layer weight binding)")
    println("================================================================")
}

// _list_contains_int(xs, item) — int variant of _list_contains.
fn _list_contains_int(xs, item: int) -> bool {
    let n = len(xs)
    let mut i = 0
    while i < n {
        if xs[i] == item {
            return true
        }
        i = i + 1
    }
    return false
}


// ────────────────────────────────────────────────────────────────────────────
//  Section 12 — main entry
// ────────────────────────────────────────────────────────────────────────────

fn main() {
    println("anima_chat.hexa — pure-hexa port of anima_chat.py v2.3")
    println("Reference: commit c2afa8e9e (tag anima_chat-v2.3-markdown-filter)")
    println("Status: PARSE-COMPLETE; helpers smoke-PASS; full inference gated on TODO[load].")
    println("")
    println("Default ckpt path:")
    println("  " + default_ckpt())
    println("")
    _smoke()
}
