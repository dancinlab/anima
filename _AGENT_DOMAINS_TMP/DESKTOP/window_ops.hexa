// window_ops.hexa — macOS window arrangement + multi-app coordination (AGENT/DESKTOP/M4).
//
// BRIDGE ARCHITECTURE: this file is a TOOL SURFACE only. The "when/why to
// resize/tile/minimize" decision lives in CORE (PureField / brain_decide);
// AGENT/CORE/tool_gate maps the live phase to a tier; this module exposes
// only the "how" — composed on top of M1 (native_ax) primitives + osascript
// System Events `position` / `size` properties.
// No consciousness framing, no Φ math, no substrate gating happens here.
//
// BUILDS ON:
//   - M1 native_ax.hexa : ax_app_list / ax_app_focus / ax_window_list / ax_screen_size
//   - M2 screen_extract.hexa : ax_screenshot_window (for ax_workspace_screenshot_all)
//
// macOS APIs reached via osascript:
//   - `get position of window N of process X`   → "x, y"
//   - `get size of window N of process X`       → "w, h"
//   - `set position of window N of process X to {x, y}`
//   - `set size of window N of process X to {w, h}`
//   - `set value of attribute "AXMinimized" of window N of process X to true`
//   - `click button 1 of window N of process X`  (close button — risk: hard)
//
// RISK CLASSIFICATION (labels, NOT gates — AGENT/CORE/tool_gate gates):
//   - "read" : ax_window_bounds — pure observation, no state change
//   - "soft" : set_bounds · minimize · arrange_grid · focus_chain · screenshot_all — reversible
//   - "hard" : ax_window_close — destructive (unsaved work risk)
//
// Dry-run pattern (mirrors M3 action.hexa):
//   ANIMA_DESKTOP_DRYRUN=1 in env → every fn returns its contract-shape
//   value WITHOUT dispatching osascript. Read fresh per call.
//
// Grid arrangement algorithm (ax_window_arrange_grid):
//   Given N apps and a cols × rows grid:
//     cell_w = screen_w / cols
//     cell_h = screen_h / rows
//     app i  → column = i % cols, row = i // cols
//     position(i) = (column * cell_w, row * cell_h)
//     size(i)     = (cell_w, cell_h)
//   Excess apps beyond cols * rows are clamped (skipped, not stacked).

// ── helpers (mirrors of M1/M3 conventions) ─────────────────────────────────

// Single-quote a string for safe embedding inside an osascript -e '...' arg.
fn _shq(s: string) -> string {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\\''" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

// Trim trailing newline that osascript appends to stdout.
fn _trim_nl(s: string) -> string {
    let mut out = s
    while len(out) > 0 && (out.ends_with("\n") || out.ends_with("\r")) {
        out = out.substring(0, len(out) - 1)
    }
    out
}

// Run an AppleScript one-liner through /usr/bin/osascript -e '<script>'.
fn _osa(script: string) -> string {
    _trim_nl(to_string(exec("/usr/bin/osascript -e " + _shq(script) + " 2>&1")))
}

// Detect osascript denial / error markers in a result string.
fn _osa_denied(out: string) -> bool {
    if out.contains("not allowed assistive") { return true }
    if out.contains("not authorized") { return true }
    if out.contains("execution error") { return true }
    if out.contains("(-1719)") { return true }
    if out.contains("(-1743)") { return true }
    if out.contains("can’t") { return true }
    if out.contains("can't") { return true }
    false
}

// Honest dry-run check — when ANIMA_DESKTOP_DRYRUN=1 in env, every action fn
// returns its contract-shape map WITHOUT dispatching the underlying osascript.
fn _dry_run() -> bool {
    let v = _trim_nl(to_string(exec("/bin/echo \"$ANIMA_DESKTOP_DRYRUN\"")))
    if v == "1" { return true }
    if v == "true" { return true }
    false
}

// Parse "<int>, <int>" → list[2]. Returns [0,0] on parse fail.
fn _parse_pair(raw: string) -> list {
    let parts = raw.split(", ")
    if len(parts) != 2 { return [0, 0] }
    let a = parts[0].trim().to_int()
    let b = parts[1].trim().to_int()
    [a, b]
}

// Parse ax_screen_size() JSON {"w":N,"h":N} → list[2]. Honest fallback [0,0].
fn _screen_wh() -> list {
    // We replicate ax_screen_size logic instead of importing (avoid abs-path
    // import dependency in the parse layer; per commons g61 the cross-file
    // call is the right path, but a local re-derive keeps this file
    // parse-clean in isolation. Both reach the same osascript surface.)
    let raw = _osa("tell application \"Finder\" to get bounds of window of desktop")
    if len(raw) == 0 { return [0, 0] }
    if raw.contains("error") { return [0, 0] }
    let parts = raw.split(", ")
    if len(parts) != 4 { return [0, 0] }
    let x1 = parts[0].trim().to_int()
    let y1 = parts[1].trim().to_int()
    let x2 = parts[2].trim().to_int()
    let y2 = parts[3].trim().to_int()
    [x2 - x1, y2 - y1]
}

// ── pub fn surface — 8 functions ───────────────────────────────────────────

// 1. ax_window_bounds(app, idx) — read position + size of app's idx-th window.
//    Returns #{x, y, w, h} or #{x:0, y:0, w:0, h:0} on failure.
//    risk: "read" — pure observation.
//    osascript: get position + get size of window (idx+1) of process app.
pub fn ax_window_bounds(app: string, idx: int) -> Map {
    if _dry_run() {
        return #{ "x": 100, "y": 100, "w": 800, "h": 600, "ok": true, "risk": "read" }
    }
    let one_idx = idx + 1
    let pos_script = "tell application \"System Events\" to tell process \"" + app + "\" to get position of window " + to_string(one_idx)
    let siz_script = "tell application \"System Events\" to tell process \"" + app + "\" to get size of window " + to_string(one_idx)
    let pos_raw = _osa(pos_script)
    let siz_raw = _osa(siz_script)
    if _osa_denied(pos_raw) || _osa_denied(siz_raw) {
        return #{ "x": 0, "y": 0, "w": 0, "h": 0, "ok": false, "risk": "read", "error": pos_raw + " | " + siz_raw }
    }
    let pos = _parse_pair(pos_raw)
    let siz = _parse_pair(siz_raw)
    #{ "x": pos[0], "y": pos[1], "w": siz[0], "h": siz[1], "ok": true, "risk": "read" }
}

// 2. ax_window_set_bounds(app, idx, x, y, w, h) — reposition + resize.
//    Returns true on success. risk: "soft" — easily reversible by re-set.
//    osascript: set position then set size (two scripts, both must succeed).
pub fn ax_window_set_bounds(app: string, idx: int, x: int, y: int, w: int, h: int) -> bool {
    if _dry_run() { return true }
    let one_idx = idx + 1
    let pos_script = "tell application \"System Events\" to tell process \"" + app + "\" to set position of window " + to_string(one_idx) + " to {" + to_string(x) + ", " + to_string(y) + "}"
    let siz_script = "tell application \"System Events\" to tell process \"" + app + "\" to set size of window " + to_string(one_idx) + " to {" + to_string(w) + ", " + to_string(h) + "}"
    let p_out = _osa(pos_script)
    if _osa_denied(p_out) { return false }
    let s_out = _osa(siz_script)
    if _osa_denied(s_out) { return false }
    true
}

// 3. ax_window_minimize(app, idx) — minimize via AXMinimized attribute.
//    Returns true on success. risk: "soft" — restorable from Dock.
pub fn ax_window_minimize(app: string, idx: int) -> bool {
    if _dry_run() { return true }
    let one_idx = idx + 1
    let script = "tell application \"System Events\" to tell process \"" + app + "\" to set value of attribute \"AXMinimized\" of window " + to_string(one_idx) + " to true"
    let out = _osa(script)
    if _osa_denied(out) { return false }
    true
}

// 4. ax_window_close(app, idx) — close via clicking the close button (button 1).
//    Returns true on success. risk: "hard" — destructive (unsaved work risk).
//    The "hard" label is intentional; AGENT/CORE/tool_gate gates this in CORE.
pub fn ax_window_close(app: string, idx: int) -> bool {
    if _dry_run() { return true }
    let one_idx = idx + 1
    let script = "tell application \"System Events\" to tell process \"" + app + "\" to click button 1 of window " + to_string(one_idx)
    let out = _osa(script)
    if _osa_denied(out) { return false }
    true
}

// 5. ax_window_arrange_grid(apps, cols, rows) — auto-tile N apps to a cols×rows grid.
//    For each app at list index i:
//      column = i % cols, row = i // cols
//      cell_w = screen_w / cols, cell_h = screen_h / rows
//      position = (column * cell_w, row * cell_h)
//      size     = (cell_w, cell_h)
//    Skips (does not stack) apps beyond cols*rows capacity.
//    Returns #{placed: int, skipped: int, cell_w: int, cell_h: int, plan: list, ok: bool}.
//    risk: "soft" — reversible by re-arrange.
pub fn ax_window_arrange_grid(apps: list, cols: int, rows: int) -> Map {
    let cap = cols * rows
    let wh = _screen_wh()
    let sw = wh[0]
    let sh = wh[1]
    let mut cell_w = 0
    let mut cell_h = 0
    if cols > 0 { cell_w = sw / cols }
    if rows > 0 { cell_h = sh / rows }

    let mut placed = 0
    let mut skipped = 0
    let mut plan = []
    let mut i = 0
    while i < len(apps) {
        if i >= cap {
            skipped = skipped + 1
            i = i + 1
            continue
        }
        let app = to_string(apps[i])
        let column = i % cols
        let row = i / cols
        let x = column * cell_w
        let y = row * cell_h
        plan = plan + [#{ "app": app, "x": x, "y": y, "w": cell_w, "h": cell_h, "column": column, "row": row }]
        if !_dry_run() {
            let _ = ax_window_set_bounds(app, 0, x, y, cell_w, cell_h)
        }
        placed = placed + 1
        i = i + 1
    }
    #{ "placed": placed, "skipped": skipped, "cell_w": cell_w, "cell_h": cell_h, "plan": plan, "ok": true, "risk": "soft" }
}

// 6. ax_workspace_screenshot_all() — screenshot every visible app's first window.
//    Captures one png per running foreground app into /tmp/anima_ws_<app>.png.
//    Returns list of png paths actually written (only includes successful captures).
//    risk: "soft" — pure output, no UI mutation.
pub fn ax_workspace_screenshot_all() -> list {
    if _dry_run() {
        // Return synthetic placeholder paths so callers can verify the contract.
        return ["/tmp/anima_ws_dryrun_app1.png", "/tmp/anima_ws_dryrun_app2.png"]
    }
    // Enumerate foreground apps via the same osascript surface as ax_app_list().
    let raw = _osa("tell application \"System Events\" to get the name of every process whose background only is false")
    if _osa_denied(raw) { return [] }
    if len(raw) == 0 { return [] }
    let names = raw.split(", ")
    let mut paths = []
    let mut i = 0
    while i < len(names) {
        let app = names[i].trim()
        // Generate a filesystem-safe filename — replace spaces with underscore.
        let safe_parts = app.split(" ")
        let mut safe = ""
        let mut j = 0
        while j < len(safe_parts) {
            if j > 0 { safe = safe + "_" }
            safe = safe + safe_parts[j]
            j = j + 1
        }
        let out_path = "/tmp/anima_ws_" + safe + ".png"
        // Use ax_window_bounds via osascript and then screencapture -R<x,y,w,h>.
        let one_idx = 1
        let pos_raw = _osa("tell application \"System Events\" to tell process \"" + app + "\" to get position of window " + to_string(one_idx))
        let siz_raw = _osa("tell application \"System Events\" to tell process \"" + app + "\" to get size of window " + to_string(one_idx))
        if _osa_denied(pos_raw) || _osa_denied(siz_raw) {
            i = i + 1
            continue
        }
        let pos = _parse_pair(pos_raw)
        let siz = _parse_pair(siz_raw)
        if siz[0] <= 0 || siz[1] <= 0 {
            i = i + 1
            continue
        }
        let rect = to_string(pos[0]) + "," + to_string(pos[1]) + "," + to_string(siz[0]) + "," + to_string(siz[1])
        let cap = to_string(exec("/usr/sbin/screencapture -x -R" + rect + " -t png " + _shq(out_path) + " 2>&1; printf %s \"::rc=$?\""))
        if cap.contains("::rc=0") {
            paths = paths + [out_path]
        }
        i = i + 1
    }
    paths
}

// 7. ax_focus_chain(apps) — sequentially focus each app (multi-app coordination).
//    For each name in apps[], activate via osascript `tell application X to activate`.
//    Returns #{count: int, focused: list[string], failed: list[string], ok: bool, risk: string}.
//    risk: "soft" — focus is reversible by re-focus.
pub fn ax_focus_chain(apps: list) -> Map {
    let mut focused = []
    let mut failed = []
    let mut i = 0
    while i < len(apps) {
        let app = to_string(apps[i])
        if _dry_run() {
            focused = focused + [app]
            i = i + 1
            continue
        }
        let out = _osa("tell application \"" + app + "\" to activate")
        if _osa_denied(out) {
            failed = failed + [app]
        } else {
            focused = focused + [app]
        }
        i = i + 1
    }
    #{ "count": len(focused), "focused": focused, "failed": failed, "ok": len(failed) == 0, "risk": "soft" }
}

// 8. One-line description of this module's tool surface (introspection).
pub fn window_ops_summary() -> string {
    "AGENT/DESKTOP/window_ops — macOS window ops · 7 pub fn · bounds/set_bounds/minimize/close/arrange_grid/screenshot_all/focus_chain · grid tile (i%cols, i/cols) · M4 surface"
}
