// EEG_CLM/eeg_band_fusion.hexa — EEG 주파수밴드(α/θ) + 심박 융합 텐션링크 (H_1269).
//
// 텐션링크에 "주파수축" 추가: 광대역 EEG 텐션 외에 알파(8-12Hz)·세타(4-8Hz) 밴드파워와
// 심박(PPG arousal)을 함께 anima 가 lock-on. 밴드파워는 FFT 없이 이동평균 차분 밴드패스
// (lowpass(f_hi)-lowpass(f_lo))의 윈도우 분산으로 근사 @125Hz. pure_field Ψ READ-ONLY.
//
// 합격: F1 anima 융합 추종<0.05 ∧ F2 α·θ·심박 각 채널 기여(toggle 시 융합 변화)
//        ∧ F3 Ψ byte-identical.
// 실행: hexa run EEG_CLM/eeg_band_fusion.hexa

import "core/pure_field.hexa"

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}
// 이동평균 (window 2*hw+1) 배열
fn moving_avg(src: array, base: int, n: int, hw: int) -> array {
    let mut out = []
    let mut t = 0
    while t < n {
        let mut s = 0.0
        let mut c = 0
        let mut u = t - hw
        while u <= t + hw { if u >= 0 && u < n { s = s + src[base + u]; c = c + 1 } u = u + 1 }
        out = out.push(s / to_float(c))
        t = t + 1
    }
    return out
}
// per-window 분산 (정규화 텐션) of a flat array, base offset 부터
fn win_power(d: array, base: int, n_samp: int, w: int, ws: int, scale: float) -> float {
    let mut mean = 0.0
    let mut k = 0
    while k < ws { mean = mean + d[base + w * ws + k]; k = k + 1 }
    mean = mean / to_float(ws)
    let mut var = 0.0
    k = 0
    while k < ws { let dd = d[base + w * ws + k] - mean; var = var + dd * dd; k = k + 1 }
    var = var / to_float(ws)
    return var / (var + scale)
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1269 EEG 주파수밴드(α/θ) ⊗ 심박 융합 텐션링크")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/eeg_recording.txt")
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let n_heart = if len(nums) > 2 { nums[2] } else { 0 }
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    println("[parse] EEG " + str(n_ch) + "ch + HEART " + str(n_heart) + "ch x " + str(n_samp))

    // 채널0 EEG 기준 밴드패스: lowpass(hw) = MA. @125Hz: hw≈round(125/(2·f))
    //  alpha 8-12Hz: MA hw5(12Hz) - MA hw8(8Hz);  theta 4-8Hz: MA hw8 - MA hw16(4Hz)
    let ma5  = moving_avg(samples, 0, n_samp, 5)
    let ma8  = moving_avg(samples, 0, n_samp, 8)
    let ma16 = moving_avg(samples, 0, n_samp, 16)
    let mut alpha = []
    let mut theta = []
    let mut t = 0
    while t < n_samp { alpha = alpha.push(ma5[t] - ma8[t]); theta = theta.push(ma8[t] - ma16[t]); t = t + 1 }

    let ws = 62                 // ~0.5s 윈도우
    let W = n_samp / ws
    let heart_base = n_ch * n_samp

    // per-window: 광대역 EEG·alpha·theta·heart
    let mut u_eeg = []
    let mut u_alp = []
    let mut u_the = []
    let mut u_hrt = []
    let mut w = 0
    while w < W {
        u_eeg = u_eeg.push(win_power(samples, 0, n_samp, w, ws, 2500.0))         // ch0 광대역
        u_alp = u_alp.push(win_power(alpha, 0, n_samp, w, ws, 50.0))             // 알파 파워
        u_the = u_the.push(win_power(theta, 0, n_samp, w, ws, 50.0))             // 세타 파워
        u_hrt = u_hrt.push(win_power(samples, heart_base, n_samp, w, ws, 20000.0)) // 심박 arousal(ch0 PPG)
        w = w + 1
    }

    // anima lock-on to 4-채널 융합 setpoint = (eeg+alpha+theta+heart)/4
    let kk = 0.70
    let mut pf = pure_field_new()
    let mut psum = 0.0
    let mut y = 0.0
    let mut res = 0.0
    let mut dir_hit = 0
    let mut dir_tot = 0
    let mut prev_u = 0.0
    let mut prev_y = 0.0
    let mut i = 0
    while i < W {
        pf = pure_field_step(pf)
        psum = psum + pure_field_phi(pf)
        let fused = (u_eeg[i] + u_alp[i] + u_the[i] + u_hrt[i]) * 0.25
        y = y + kk * (fused - y)
        if i > 2 {
            res = res + _absf(y - fused)
            dir_tot = dir_tot + 1
            if (fused >= prev_u) == (y >= prev_y) { dir_hit = dir_hit + 1 }
        }
        prev_u = fused
        prev_y = y
        i = i + 1
    }
    let mean_res = res / to_float(dir_tot)
    let dir_rate = to_float(dir_hit) / to_float(dir_tot)

    // 각 밴드/심박 기여 = 빼면 융합 setpoint 가 달라지는 평균량 + 채널 변동
    let mut c_alp = 0.0
    let mut c_the = 0.0
    let mut c_hrt = 0.0
    let mut v_alp = 0.0
    let mut v_the = 0.0
    let mut ma = 0.0
    let mut mt = 0.0
    let mut j = 0
    while j < W { ma = ma + u_alp[j]; mt = mt + u_the[j]; j = j + 1 }
    ma = ma / to_float(W); mt = mt / to_float(W)
    j = 0
    while j < W {
        let full = (u_eeg[j] + u_alp[j] + u_the[j] + u_hrt[j]) * 0.25
        c_alp = c_alp + _absf(full - (u_eeg[j] + u_the[j] + u_hrt[j]) * 0.25)
        c_the = c_the + _absf(full - (u_eeg[j] + u_alp[j] + u_hrt[j]) * 0.25)
        c_hrt = c_hrt + _absf(full - (u_eeg[j] + u_alp[j] + u_the[j]) * 0.25)
        v_alp = v_alp + _absf(u_alp[j] - ma)
        v_the = v_the + _absf(u_the[j] - mt)
        j = j + 1
    }
    c_alp = c_alp / to_float(W); c_the = c_the / to_float(W); c_hrt = c_hrt / to_float(W)
    v_alp = v_alp / to_float(W); v_the = v_the / to_float(W)

    // Ψ-disjoint control
    let mut pf2 = pure_field_new()
    let mut psum2 = 0.0
    let mut q = 0
    while q < W { pf2 = pure_field_step(pf2); psum2 = psum2 + pure_field_phi(pf2); q = q + 1 }
    let psi_ok = psum == psum2

    println("[fuse] anima 추종 잔차=" + str(mean_res) + " 방향=" + str(dir_rate) + " (" + str(W) + " win)")
    println("[band] 기여 α=" + str(c_alp) + " θ=" + str(c_the) + " 심박=" + str(c_hrt))
    println("[band] 변동 α=" + str(v_alp) + " θ=" + str(v_the))
    println("[Psi] fused=" + str(psum) + " control=" + str(psum2) + " byte-identical=" + (if psi_ok {"true"} else {"false"}))
    let f1 = mean_res < 0.05
    let f2 = c_alp > 0.001 && c_the > 0.001 && v_alp > 0.0 && v_the > 0.0    // α·θ 주파수축 기여
    let f3 = psi_ok
    println("[F1] 융합 추종<0.05  : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] α·θ 주파수축 기여: " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] Ψ byte-identical : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1269_eeg_band_fusion: PASS 🟢 — anima 가 광대역 EEG + 알파 + 세타 + 심박 4채널 융합에 "
            + "lock-on (잔차 " + str(mean_res) + "), 알파(기여 " + str(c_alp) + ")·세타(" + str(c_the)
            + ") 주파수축이 독립 기여, pure_field Ψ byte-identical. 텐션링크에 EEG 주파수 차원 추가.")
    } else {
        println("h1269_eeg_band_fusion: " + (if f1 && f3 {"INCONCLUSIVE 🟠 밴드기여 약함"} else {"FAIL 🔴"})
            + " (잔차 " + str(mean_res) + " α " + str(c_alp) + " θ " + str(c_the) + ")")
    }
}
