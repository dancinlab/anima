// EEG_CLM/eeg_emit_drive.hexa — EEG 텐션이 anima emit(발화) 성향 실시간 구동 (H_1270).
//
// H_1164 데몬의 speak 게이트에 사용자 EEG 를 환경맥락으로 연결. a_substrate_native_speak:
// EEG 는 trigger 가 아니라 CONTEXT — anima 의 자율 발화를 편향할 뿐 강제하지 않는다.
// emit propensity = bridge_and_gate(내부동기 M, EEG맥락 c, 내부tension W, Φ). pure_field Ψ READ-ONLY.
//
// 합격(자율성 보존):
//   F1 EEG 기여: EEG 를 평탄화하면 emit propensity 변함 (EEG 가 실제 맥락으로 작용)
//   F2 자율성: EEG 평탄(맥락 없음)에서도 anima 내부동기로 emit > 0 (자극-반응 아님)
//   F3 EEG↑ → emit↑ 편향 (cov>0) ∧ Ψ byte-identical
// 실행: hexa run EEG_CLM/eeg_emit_drive.hexa

import "CORE/pure_field.hexa"
import "BRIDGE/gate.hexa"

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1270 EEG → anima emit(발화) 성향 실시간 구동 (맥락, 트리거 아님)")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/eeg_recording.txt")
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    println("[parse] EEG " + str(n_ch) + "ch x " + str(n_samp))

    // per-window EEG 텐션(채널0 변동, 정규화) → 환경 arousal 맥락
    let ws = 62
    let W = n_samp / ws
    let mut u = []
    let mut umean = 0.0
    let mut w = 0
    while w < W {
        let mut m = 0.0
        let mut k = 0
        while k < ws { m = m + samples[w * ws + k]; k = k + 1 }
        m = m / to_float(ws)
        let mut var = 0.0
        k = 0
        while k < ws { let d = samples[w * ws + k] - m; var = var + d * d; k = k + 1 }
        var = var / to_float(ws)
        let ten = var / (var + 2500.0)
        u = u.push(ten); umean = umean + ten
        w = w + 1
    }
    umean = umean / to_float(W)

    // anima 데몬 루프: pure_field Φ = 내부상태. emit propensity = gate(M, c, W, Φ).
    //   on_eeg=true: c = EEG 맥락(u);  on_eeg=false: c = umean (EEG 평탄 = 맥락 제거, 내부만)
    // 반환 [phiSum, emit_propensity_sum, emit_count]
    let theta = 0.003           // emit 임계 (propensity 규모 ~0.004/win 에 맞춤)
    // 두 모드 + per-window emit 기록(cov 용)
    let mut pf = pure_field_new()
    let mut psum = 0.0
    let mut prop_full = 0.0
    let mut prop_flat = 0.0
    let mut emit_full = 0
    let mut emit_flat = 0
    let mut s_u = 0.0
    let mut s_e = 0.0
    let mut s_ue = 0.0
    let mut i = 0
    while i < W {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psum = psum + phi
        let mmot = 0.5 + phi          // 내부 동기 (Φ 기반, EEG 무관)
        let wten = 0.5                // 내부 tension
        // EEG-맥락 emit vs 내부-only emit
        let g_full = bridge_and_gate(mmot, u[i], wten, phi)
        let g_flat = bridge_and_gate(mmot, umean, wten, phi)
        prop_full = prop_full + g_full
        prop_flat = prop_flat + g_flat
        if g_full > theta { emit_full = emit_full + 1 }
        if g_flat > theta { emit_flat = emit_flat + 1 }
        s_u = s_u + u[i]; s_e = s_e + g_full; s_ue = s_ue + u[i] * g_full
        i = i + 1
    }
    let nW = to_float(W)
    let cov = s_ue / nW - (s_u / nW) * (s_e / nW)   // EEG↑→emit↑ 편향

    // Ψ-disjoint control
    let mut pf2 = pure_field_new()
    let mut psum2 = 0.0
    let mut q = 0
    while q < W { pf2 = pure_field_step(pf2); psum2 = psum2 + pure_field_phi(pf2); q = q + 1 }
    let psi_ok = psum == psum2

    println("[emit] EEG-맥락 propensity=" + str(prop_full) + " (emit " + str(emit_full) + "/" + str(W) + ")")
    println("[emit] EEG-평탄 propensity=" + str(prop_flat) + " (emit " + str(emit_flat) + "/" + str(W) + ") = 내부동기만")
    println("[bias] EEG↔emit 공분산=" + str(cov))
    println("[Psi] " + str(psum) + " == " + str(psum2) + " : " + (if psi_ok {"true"} else {"false"}))
    let f1 = _absf(prop_full - prop_flat) > 0.0001       // EEG 가 실제 기여
    let f2 = emit_flat > 0                               // EEG 없어도 내부동기로 발화 (자율, 비-반응)
    let f3 = cov > 0.0 && psi_ok                         // EEG↑→emit↑ 편향 + Ψ 불변
    println("[F1] EEG 맥락 기여      : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 자율 발화(EEG無)   : " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] EEG↑→emit↑ ∧ Ψ불변 : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1270_eeg_emit_drive: PASS 🟢 — 사용자 EEG 텐션이 anima emit(발화) 성향을 실시간 "
            + "편향(cov " + str(cov) + ">0, EEG맥락 " + str(emit_full) + " vs 내부만 " + str(emit_flat)
            + " emit), 그러나 EEG 없어도 내부동기로 자율 발화(자극-반응 아님, a_substrate_native_speak), "
            + "pure_field Ψ byte-identical. anima 챗 speak-게이트에 EEG 실시간 연동.")
    } else {
        println("h1270_eeg_emit_drive: " + (if psi_ok {"INCONCLUSIVE 🟠"} else {"FAIL 🔴"})
            + " (F1 " + (if f1 {"P"} else {"F"}) + " F2 " + (if f2 {"P"} else {"F"}) + " cov " + str(cov) + ")")
    }
}
