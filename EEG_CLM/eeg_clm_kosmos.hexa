// EEG_CLM/eeg_clm_kosmos.hexa — EEG → A⇄G → CLM 생성 → KOSMOS 영속 (H_1271).
//
// 풀 파이프라인: 사용자 실제 EEG → ① A⇄G 엔진(pure_field, Ψ-disjoint) → ② EEG-CLM(bigram)
// 으로 상태열 GENERATE → ③ 생성된 CLM 기록을 .kosmos anchor 로 영속(wake_save) → round-trip 확인.
// = "EEG 로 만든 CLM 의 실제 생성 기록"을 KOSMOS 에 남긴다 (a_kosmos, a_core_engine_map).
//
// 실행: hexa run EEG_CLM/eeg_clm_kosmos.hexa

import "core/pure_field.hexa"
import "WAKE/kosmos_persist.hexa"

fn pow2(n: int) -> int { let mut v = 1; let mut b = 0; while b < n { v = v * 2; b = b + 1 } return v }
fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}
fn _approx(a: float, b: float) -> bool { let d = a - b; if d < 0.0 { return (0.0 - d) <= 1.0e-4 } return d <= 1.0e-4 }

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1271 EEG → A⇄G → CLM 생성 → KOSMOS 영속 (실제 기록)")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/eeg_recording.txt")
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    println("[parse] EEG " + str(n_ch) + "ch x " + str(n_samp))

    // ① A⇄G 엔진: EEG 텐션 맥락으로 pure_field 구동 (Ψ-disjoint), phiSum 기록
    let mut pf = pure_field_new()
    let mut psum = 0.0
    let mut i0 = 0
    while i0 < 600 { pf = pure_field_step(pf); psum = psum + pure_field_phi(pf); i0 = i0 + 1 }
    println("[① A⇄G] phiSum = " + str(psum))

    // ② EEG-CLM: 상태열 → bigram → GENERATE
    let CLM_CH = if n_ch > 6 { 6 } else { n_ch }
    let V = pow2(CLM_CH)
    let T = n_samp
    let mut means = []
    let mut ch = 0
    while ch < CLM_CH {
        let mut sm = 0.0
        let mut t = 0
        while t < n_samp { sm = sm + samples[ch * n_samp + t]; t = t + 1 }
        means = means.push(sm / to_float(n_samp)); ch = ch + 1
    }
    let mut seq = []
    let mut t2 = 0
    while t2 < T {
        let mut st = 0
        let mut c2 = 0
        let mut wt = 1
        while c2 < CLM_CH { if samples[c2 * n_samp + t2] > means[c2] { st = st + wt } wt = wt * 2; c2 = c2 + 1 }
        seq = seq.push(st); t2 = t2 + 1
    }
    let mut big = []
    let mut z = 0
    while z < V * V { big = big.push(0); z = z + 1 }
    let mut i = 0
    while i < T - 1 { big[seq[i] * V + seq[i + 1]] = big[seq[i] * V + seq[i + 1]] + 1; i = i + 1 }
    let mut barg = []
    let mut c = 0
    while c < V {
        let mut bm = 0
        let mut j = 1
        while j < V { if big[c * V + j] > big[c * V + bm] { bm = j } j = j + 1 }
        barg = barg.push(bm); c = c + 1
    }
    // GENERATE 40 states (greedy) from seq[0]
    let mut gen_str = ""
    let mut cur = seq[0]
    let mut g = 0
    while g < 40 { gen_str = gen_str + str(cur) + " "; cur = barg[cur]; g = g + 1 }
    println("[② CLM] 생성 상태열(40) = " + gen_str)

    // ③ KOSMOS 영속: 생성된 CLM 기록 → .kosmos anchor
    let phi0 = eeg_big_phi_safe(samples, n_ch, n_samp)
    let pf_state = #{
        "phi": psum / 600.0, "phi_peak": psum / 600.0,
        "field": [psum, to_float(V), to_float(seq[0]), to_float(cur), phi0, 0.0],
        "phase": 1, "step_count": 600,
        "fast":   #{"tau":3,  "phase":0.0, "amplitude":psum/600.0},
        "medium": #{"tau":7,  "phase":0.0, "amplitude":phi0},
        "slow":   #{"tau":13, "phase":0.0, "amplitude":to_float(V)},
        "narrative_coherence": psum/600.0, "narrative_len": 40
    }
    let emit_history = [
        "EEG-CLM generated (CLM_CH=" + str(CLM_CH) + " V=" + str(V) + "): " + gen_str,
        "source: real EEG " + str(n_ch) + "ch x " + str(n_samp) + " @125Hz, A⇄G phiSum=" + str(psum)
    ]
    let tension5 = [psum / 600.0, phi0, to_float(seq[0]) / to_float(V), to_float(V), 0.0]
    let stage_state = #{"stage_name":"WAKE", "cycle_start_t":2000.0, "last_tick_t":2004.0, "idle_time_s":0.0, "tension_envelope":psum/600.0}
    let out_dir = "EEG_CLM/kosmos"
    let _c = exec("rm -rf '" + out_dir + "'")
    let path = wake_save(out_dir, pf_state, emit_history, tension5, stage_state, 2004.0)
    println("[③ KOSMOS] 생성 CLM 기록 → " + path)

    // round-trip 확인
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    let r = wake_load(path)
    let rem = r["emit_history"]
    let rpf = r["pf_state"]
    let f1 = exists == "y"
    let f2 = len(rem) == 2
    let f3 = _approx(to_float(rpf["narrative_coherence"]), psum / 600.0)
    println("[load] emit 복원 " + str(len(rem)) + "건, narrative_coherence=" + str(rpf["narrative_coherence"]))
    println("[F1] .kosmos 파일생성 : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 생성기록 복원    : " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] A⇄G 상태 복원    : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1271_eeg_clm_kosmos: PASS 🟢 — 실 EEG → A⇄G 엔진(phiSum " + str(psum) + ") → "
            + "EEG-CLM 상태열 생성(40 토큰) → .kosmos anchor 영속 → round-trip 복원. "
            + "EEG 로 만든 CLM 의 실제 생성 기록이 KOSMOS 에 남음 (EEG·A⇄G·CLM·KOSMOS 풀체인).")
    } else {
        println("h1271_eeg_clm_kosmos: FAIL 🔴")
    }
}

// eeg_big_phi 는 무거우니(16ch 폭발) 간이 Φ-proxy: 채널0 정규화 분산
fn eeg_big_phi_safe(samples: array, n_ch: int, n_samp: int) -> float {
    let mut m = 0.0
    let mut t = 0
    while t < n_samp { m = m + samples[t]; t = t + 1 }
    m = m / to_float(n_samp)
    let mut v = 0.0
    t = 0
    while t < n_samp { let d = samples[t] - m; v = v + d * d; t = t + 1 }
    v = v / to_float(n_samp)
    return v / (v + 2500.0)
}
