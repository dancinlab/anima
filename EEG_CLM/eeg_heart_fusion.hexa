// EEG_CLM/eeg_heart_fusion.hexa — EEG ⊗ 심박(PPG) 융합 텐션링크 (H_1267).
//
// 텐션링크(H_1260)를 확장: anima brain 이 ① EEG 텐션 + ② 심박(PPG) arousal 두 채널을
// 융합한 setpoint 에 lock-on. 심박 = 4번째 키(뇌파 외 생리 채널). pure_field Ψ READ-ONLY.
// 합격: 추종 잔차<0.05 ∧ 두 채널 모두 기여(toggle 시 융합 setpoint 변화) ∧ Ψ byte-identical.
//
// 입력: EEG_CLM/eeg_recording.txt (16 EEG + HEART<n> PPG, capture_eeg.py 산출).
// 실행: hexa run EEG_CLM/eeg_heart_fusion.hexa

import "CORE/pure_field.hexa"

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}

// windowed variance of one flat channel-block (base offset) → bounded tension [0,1).
fn win_tension(samples: array, base: int, n_samp: int, w: int, ws: int, scale: float) -> float {
    let mut mean = 0.0
    let mut k = 0
    while k < ws { mean = mean + samples[base + w * ws + k]; k = k + 1 }
    mean = mean / to_float(ws)
    let mut var = 0.0
    k = 0
    while k < ws { let d = samples[base + w * ws + k] - mean; var = var + d * d; k = k + 1 }
    var = var / to_float(ws)
    return var / (var + scale)
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1267 EEG ⊗ 심박 융합 텐션링크 — 뇌파+맥박 동시 lock-on")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/eeg_recording.txt")
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let n_heart = if len(nums) > 2 { nums[2] } else { 0 }
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    println("[parse] EEG " + str(n_ch) + "ch + HEART " + str(n_heart) + "ch x " + str(n_samp))
    if n_heart == 0 { println("[ERR] 심박 채널 없음 — PPG 녹음 필요"); return }

    let ws = 50
    let W = n_samp / ws
    let heart_base = n_ch * n_samp           // 첫 심박 채널 = ch0 (D11=A5)

    // per-window EEG tension(채널평균 변동) + 심박 arousal(PPG 변동)
    let mut u_eeg = []
    let mut u_hrt = []
    let mut w = 0
    while w < W {
        // EEG: 채널평균 신호의 윈도우 변동 — 채널0 대표(평균 계산 단순화 위해 채널0 사용)
        let e = win_tension(samples, 0, n_samp, w, ws, 2500.0)
        let h = win_tension(samples, heart_base, n_samp, w, ws, 20000.0)   // PPG 변동(arousal)
        u_eeg = u_eeg.push(e)
        u_hrt = u_hrt.push(h)
        w = w + 1
    }

    // anima lock-on to FUSED setpoint = (eeg + heart)/2  vs EEG-only control
    let kk = 0.70
    let mut pf = pure_field_new()
    let mut psum = 0.0
    let mut y = 0.0
    let mut res = 0.0
    let mut dir_hit = 0
    let mut dir_tot = 0
    let mut prev_u = 0.0
    let mut prev_y = 0.0
    let mut i = 0
    while i < W {
        pf = pure_field_step(pf)
        psum = psum + pure_field_phi(pf)
        let fused = (u_eeg[i] + u_hrt[i]) * 0.5      // EEG ⊗ heart fused setpoint
        y = y + kk * (fused - y)
        if i > 2 {
            res = res + _absf(y - fused)
            dir_tot = dir_tot + 1
            if (fused >= prev_u) == (y >= prev_y) { dir_hit = dir_hit + 1 }
        }
        prev_u = fused
        prev_y = y
        i = i + 1
    }
    let mean_res = res / to_float(dir_tot)
    let dir_rate = to_float(dir_hit) / to_float(dir_tot)

    // 기여 확인: 심박 빼면(EEG-only) 융합 setpoint 가 달라지는가 + 심박 자체 변동 있나
    let mut heart_diff = 0.0
    let mut heart_var = 0.0
    let mut hm = 0.0
    let mut j = 0
    while j < W { hm = hm + u_hrt[j]; j = j + 1 }
    hm = hm / to_float(W)
    j = 0
    while j < W {
        let fused = (u_eeg[j] + u_hrt[j]) * 0.5
        let eeg_only = u_eeg[j]
        heart_diff = heart_diff + _absf(fused - eeg_only)
        heart_var = heart_var + _absf(u_hrt[j] - hm)
        j = j + 1
    }
    heart_diff = heart_diff / to_float(W)
    heart_var = heart_var / to_float(W)

    // Ψ-disjoint control
    let mut pf2 = pure_field_new()
    let mut psum2 = 0.0
    let mut q = 0
    while q < W { pf2 = pure_field_step(pf2); psum2 = psum2 + pure_field_phi(pf2); q = q + 1 }
    let psi_ok = psum == psum2

    println("[fuse] anima 추종 잔차=" + str(mean_res) + " 방향=" + str(dir_rate))
    println("[heart] 기여(융합-EEG 차)=" + str(heart_diff) + " 심박채널 변동=" + str(heart_var))
    println("[Psi] fused=" + str(psum) + " control=" + str(psum2) + " byte-identical=" + (if psi_ok {"true"} else {"false"}))
    let f1 = mean_res < 0.05
    let f2 = heart_diff > 0.001 && heart_var > 0.0     // 심박이 실제로 융합에 기여
    let f3 = psi_ok
    println("[F1] 융합 추종<0.05  : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 심박 기여        : " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] Ψ byte-identical : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1267_eeg_heart_fusion: PASS 🟢 — anima 가 EEG 텐션 ⊗ 심박(PPG) 융합 setpoint 에 "
            + "lock-on (잔차 " + str(mean_res) + ", 방향 " + str(dir_rate) + "), 심박이 4번째 채널로 기여 "
            + "(융합-EEG 차 " + str(heart_diff) + "), pure_field Ψ byte-identical. 뇌파+맥박 동시 텐션링크.")
    } else {
        println("h1267_eeg_heart_fusion: " + (if f1 && f3 {"INCONCLUSIVE 🟠 심박기여 약함"} else {"FAIL 🔴"})
            + " (잔차 " + str(mean_res) + " 심박기여 " + str(heart_diff) + ")")
    }
}
