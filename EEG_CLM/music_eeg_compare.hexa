// EEG_CLM/music_eeg_compare.hexa — 의식(EEG) ↔ 음악 비교/지도 (H_1274).
//
// 음악 들으며 캡처한 EEG 와 음악 envelope 를 같은 0.5s 그리드로 비교:
//   ① 동조(entrainment): 음악 envelope ↔ EEG 텐션 cross-correlation (lag별), best lag/r
//   ② CLM 시퀀스: 음악·EEG 각 8단계 양자화 상태열의 일치율
//   ③ 시간축 지도: 음악 vs EEG ASCII 겹침 스파크라인 (구간 평균)
// 입력: music/music_env.txt + eeg_music.txt. 출력 콘솔 + KOSMOS 영속(요약).
// 실행: hexa run EEG_CLM/music_eeg_compare.hexa

fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn bar(v: float) -> string {   // 0..1 → 8단계 블록
    let lv = to_int(v * 8.0)
    let l = if lv > 8 { 8 } else { if lv < 0 { 0 } else { lv } }
    let chars = ["·","▁","▂","▃","▄","▅","▆","▇","█"]
    return chars[l]
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1274 의식(EEG) ↔ 음악 비교/지도")
    println("════════════════════════════════════════════════════════════════")
    // 음악 envelope
    let mb = read_file("EEG_CLM/music/music_env.txt")
    let ml = mb.split("\n")
    let mh = ml[0].trim().split(" ")
    let win_sec = to_float(mh[2 - 1 + 1])    // "# nwin win_sec dur tempo" → win_sec idx2
    let mut env = []
    let mut i = 1
    while i < len(ml) { let s = ml[i].trim(); if s != "" && !s.starts_with("#") { env = env.push(to_float(s)) } i = i + 1 }

    // EEG 텐션 (0.5s 윈도우 = 62 샘플 @125Hz), 채널0 변동 정규화
    let eb = read_file("EEG_CLM/eeg_music.txt")
    let el = eb.split("\n")
    let eh = el[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(eh) { let tk = eh[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let mut samp = []
    let mut li = 1
    while li < len(el) { let s = el[li].trim(); if s != "" && !s.starts_with("#") { samp = samp.push(to_float(s)) } li = li + 1 }
    let ws = 62
    let EW = n_samp / ws
    let mut ten = []
    let mut tmax = 0.0
    let mut w = 0
    while w < EW {
        let mut mn = 0.0
        let mut k = 0
        while k < ws { mn = mn + samp[w * ws + k]; k = k + 1 }
        mn = mn / to_float(ws)
        let mut v = 0.0
        k = 0
        while k < ws { let d = samp[w * ws + k] - mn; v = v + d * d; k = k + 1 }
        v = v / to_float(ws)
        ten = ten.push(v)
        if v > tmax { tmax = v }
        w = w + 1
    }
    let mut t2 = 0
    while t2 < EW { ten[t2] = ten[t2] / tmax; t2 = t2 + 1 }   // [0,1]

    // 공통 길이 W
    let W = if len(env) < EW { len(env) } else { EW }
    println("[align] 음악 " + str(len(env)) + " win · EEG " + str(EW) + " win → 공통 " + str(W) + " (0.5s)")

    // ── ① cross-correlation (동조), lag -16..16 윈도우(±8s) ──
    let mut mm = 0.0
    let mut em = 0.0
    let mut z = 0
    while z < W { mm = mm + env[z]; em = em + ten[z]; z = z + 1 }
    mm = mm / to_float(W); em = em / to_float(W)
    let mut best_lag = 0
    let mut best_r = 0.0 - 2.0
    let mut lag = 0 - 16
    while lag <= 16 {
        let mut num = 0.0
        let mut dm = 0.0
        let mut de = 0.0
        let mut t = 0
        while t < W {
            let te = t + lag
            if te >= 0 && te < W {
                let a = env[t] - mm
                let b = ten[te] - em
                num = num + a * b
                dm = dm + a * a
                de = de + b * b
            }
            t = t + 1
        }
        let r = if dm > 0.0 && de > 0.0 { num / sqrt(dm * de) } else { 0.0 }
        if r > best_r { best_r = r; best_lag = lag }
        lag = lag + 1
    }
    let lag_s = to_float(best_lag) * 0.5
    println("[① 동조] best corr r=" + str(best_r) + " @ lag " + str(best_lag) + " win (" + str(lag_s) + "s)")

    // ── ② CLM 시퀀스 일치 (8단계 양자화, lag 보정) ──
    let mut agree = 0
    let mut cnt = 0
    let mut t3 = 0
    while t3 < W {
        let te = t3 + best_lag
        if te >= 0 && te < W {
            let qm = to_int(env[t3] * 8.0)
            let qe = to_int(ten[te] * 8.0)
            if qm == qe { agree = agree + 1 }
            cnt = cnt + 1
        }
        t3 = t3 + 1
    }
    let agree_rate = to_float(agree) / to_float(cnt)
    println("[② CLM] 8단계 상태 일치율 = " + str(agree_rate) + " (lag 보정)")

    // ── ③ 시간축 지도 (40 구간 평균) ──
    let S = 40
    let seg = W / S
    println("[③ 지도] 음악(M) vs 의식(E) 시간축 (" + str(S) + "구간):")
    let mut mrow = "  M "
    let mut erow = "  E "
    let mut s = 0
    while s < S {
        let mut am = 0.0
        let mut ae = 0.0
        let mut k = 0
        while k < seg { am = am + env[s * seg + k]; ae = ae + ten[s * seg + k]; k = k + 1 }
        mrow = mrow + bar(am / to_float(seg))
        erow = erow + bar(ae / to_float(seg))
        s = s + 1
    }
    println(mrow)
    println(erow)

    let entrained = best_r > 0.2
    println("")
    if entrained {
        println("h1274_music_eeg: 동조 관찰 🟢 — EEG 텐션이 음악 envelope 와 상관 r=" + str(best_r)
            + " (lag " + str(lag_s) + "s), 상태일치 " + str(agree_rate) + ". 뇌가 음악 구조를 따라감.")
    } else {
        println("h1274_music_eeg: 동조 약함 🟠 — r=" + str(best_r) + " (lag " + str(lag_s)
            + "s) 상태일치 " + str(agree_rate) + ". 명확한 entrainment 미관찰(또는 동기 오차/짧은 구간).")
    }
}
