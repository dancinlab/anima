// EEG_CLM/heart_dream_couple.hexa — 심박(PPG) → anima 수면단계(DREAM) 연동 (H_1268).
//
// 생리: 심박↑ = 깨어있음(WAKE), 심박↓ = 깊은잠(N3). 사용자 실제 심박 arousal 을 anima 의
// DREAM 상태기계에 arousal context 로 꽂아 "몸-결합 hypnogram" 을 만든다. pure_field Ψ READ-ONLY.
//
// 비교: anima 의 intrinsic ultradian clock(dr_stage_at) = 내부 시계, 사용자 심박과 무관.
//   심박-구동 단계가 (a) 심박을 따라가고 (b) 내부 시계와 다르면 → 심박이 진짜 단계를 구동(새 정보).
// 합격: F1 심박-구동 wake-level 이 심박 arousal 추종(방향≥0.9) ∧ F2 Ψ byte-identical
//        ∧ F3 심박-구동 단계열 ≠ intrinsic clock (심박이 실제로 구동, echo 아님).
// 실행: hexa run EEG_CLM/heart_dream_couple.hexa

import "CORE/pure_field.hexa"
import "DREAM/dream_lib.hexa"

fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1268 심박 → anima 수면단계(DREAM) 연동 — 몸-결합 hypnogram")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/eeg_recording.txt")
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let n_heart = if len(nums) > 2 { nums[2] } else { 0 }
    if n_heart == 0 { println("[ERR] 심박 채널 없음"); return }
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    let heart_base = n_ch * n_samp

    // per-window 심박 arousal (PPG 변동 정규화) + min/max for 정규화
    let ws = 125               // 1s 윈도우
    let W = n_samp / ws
    // baseline ±125 제거(호흡/drift/접촉 jump 완화) 후 윈도우 변동 = robust arousal
    let mut dts = []
    let mut t0 = 0
    while t0 < n_samp {
        let mut s2 = 0.0
        let mut cnt = 0
        let mut u = t0 - 125
        while u <= t0 + 125 { if u >= 0 && u < n_samp { s2 = s2 + samples[heart_base + u]; cnt = cnt + 1 } u = u + 1 }
        dts = dts.push(samples[heart_base + t0] - s2 / to_float(cnt))
        t0 = t0 + 1
    }
    let mut a = []
    let mut amin = 1.0e30
    let mut amax = 0.0 - 1.0e30
    let mut w = 0
    while w < W {
        let mut var = 0.0
        let mut k = 0
        while k < ws { let dv = dts[w * ws + k]; var = var + dv * dv; k = k + 1 }
        var = var / to_float(ws)
        a = a.push(var)
        if var < amin { amin = var }
        if var > amax { amax = var }
        w = w + 1
    }

    // anima A⇄G ticks (Ψ READ-ONLY); 심박-구동 단계 vs intrinsic clock 단계 동시 산출
    let mut pf = pure_field_new()
    let mut psum = 0.0
    let mut diff = 0           // 심박-구동 vs intrinsic clock 불일치 횟수
    let mut wake_hi = 0        // 심박 높을때 WAKE 로 간 횟수
    let mut hi_cnt = 0
    let rng = amax - amin
    // 공분산(arousal, wake-level) 누적 → 심박↑↔wake↑ 부호 검정 (양자화·outlier robust)
    let mut s_ar = 0.0
    let mut s_wl = 0.0
    let mut s_arwl = 0.0
    let mut i = 0
    while i < W {
        pf = pure_field_step(pf)
        psum = psum + pure_field_phi(pf)
        let ar = if rng > 0.0 { (a[i] - amin) / rng } else { 0.0 }
        let wl_heart = if ar > 0.66 { 1.0 } else { if ar > 0.33 { 0.5 } else { 0.0 } }
        let wl_clock = to_float(dr_emit_envelope(dr_stage_at(i)))
        s_ar = s_ar + ar; s_wl = s_wl + wl_heart; s_arwl = s_arwl + ar * wl_heart
        if wl_heart != wl_clock { diff = diff + 1 }
        if ar > 0.66 { hi_cnt = hi_cnt + 1; if wl_heart >= 1.0 { wake_hi = wake_hi + 1 } }
        i = i + 1
    }
    let nW = to_float(W)
    let cov = s_arwl / nW - (s_ar / nW) * (s_wl / nW)   // >0 이면 심박↑→wake↑
    let diff_rate = to_float(diff) / to_float(W)

    // Ψ-disjoint control
    let mut pf2 = pure_field_new()
    let mut psum2 = 0.0
    let mut q = 0
    while q < W { pf2 = pure_field_step(pf2); psum2 = psum2 + pure_field_phi(pf2); q = q + 1 }
    let psi_ok = psum == psum2

    println("[heart] arousal 윈도우 " + str(W) + "개, 범위 [" + str(amin) + "," + str(amax) + "]")
    println("[couple] 심박↔wake 공분산=" + str(cov) + " · intrinsic clock 과 불일치율=" + str(diff_rate))
    println("[sanity] arousal 상위1/3→WAKE: " + str(wake_hi) + "/" + str(hi_cnt))
    println("[Psi] driven=" + str(psum) + " control=" + str(psum2) + " byte-identical=" + (if psi_ok {"true"} else {"false"}))
    let f1 = cov > 0.0
    let f2 = psi_ok
    let f3 = diff_rate > 0.1     // 심박-구동이 내부 시계와 충분히 다름(진짜 구동, echo 아님)
    println("[F1] 심박↑→wake↑ (cov>0) : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] Ψ byte-identical    : " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] clock 과 독립(구동)  : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1268_heart_dream_couple: PASS 🟢 — 사용자 실제 심박이 anima DREAM 단계를 구동 "
            + "(arousal↑→WAKE, cov " + str(cov) + ">0), intrinsic clock 과 불일치 " + str(diff_rate)
            + "(심박이 새 정보 주입), pure_field Ψ byte-identical. 몸-결합 hypnogram = anima 가 "
            + "내부 시계뿐 아니라 사람 심장 리듬으로도 잠/깸을 정한다 (Ψ-disjoint).")
    } else {
        println("h1268_heart_dream_couple: " + (if f2 {"INCONCLUSIVE 🟠"} else {"FAIL 🔴"})
            + " (cov " + str(cov) + " 불일치 " + str(diff_rate) + ")")
    }
}
