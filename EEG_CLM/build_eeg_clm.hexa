// EEG_CLM/build_eeg_clm.hexa — EEG 녹음 → next-state CLM 자동 구축 (턴키).
//
// 입력: 채널-major flat 텍스트 녹음 (capture_eeg.py 산출).
//   1행 헤더: "# n_ch n_samp"
//   이후 각 행: float 1개 (s[ch*n_samp + t] 순서, 채널-major).
// 처리: 채널 자기평균 이진화 → 시스템상태열(알파벳 2^n_ch) → bigram next-state CLM
//        (H_1252 구축 + H_1253 생성). acc(vs unigram/uniform) + 생성분포 L1 보고.
// 산출: EEG_CLM/eeg_clm.model (bigram argmax 전이표) write_file 영속.
//
// 실행: hexa run EEG_CLM/build_eeg_clm.hexa [녹음경로]   (기본 EEG_CLM/eeg_recording.txt)

fn pow2(n: int) -> int { let mut v = 1; let mut b = 0; while b < n { v = v * 2; b = b + 1 } return v }

fn is_int(s: string) -> bool {
    let n = byte_len(s)
    if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}

fn main() {
    // args() 는 런타임 내부 인자를 포함하므로 .txt 로 끝나는 인자만 채택, 없으면 기본 녹음.
    let a = args()
    let mut path = "EEG_CLM/eeg_recording.txt"
    let mut ai = 0
    while ai < len(a) { if a[ai].trim().starts_with("EEG_CLM/") || a[ai].trim().substring(byte_len(a[ai].trim()) - 4, byte_len(a[ai].trim())) == ".txt" { path = a[ai].trim() } ai = ai + 1 }
    println("════════════════════════════════════════════════════════════════")
    println("  EEG → CLM 빌더 — 녹음: " + path)
    println("════════════════════════════════════════════════════════════════")

    // ── parse recording ──────────────────────────────────────────────────
    let body = read_file(path)
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    // 헤더 토큰에서 정수 2개 추출 (# n_ch n_samp 또는 #n_ch n_samp 모두 허용)
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) {
        let tk = hdr[hi].replace("#", "").trim()
        if is_int(tk) { nums = nums.push(to_int(tk)) }
        hi = hi + 1
    }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let mut samples = []
    let mut li = 1
    while li < len(lines) {
        let ln = lines[li].trim()
        if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }
        li = li + 1
    }
    println("[parse] n_ch=" + str(n_ch) + " n_samp=" + str(n_samp) + " samples=" + str(len(samples)))
    // CLM 상태 알파벳 = 2^CLM_CH; 16채널이면 2^16 폭발 → clean 부분집합(처음 CLM_CH 채널)으로 제한.
    let CLM_CH = if n_ch > 6 { 6 } else { n_ch }
    if n_ch > CLM_CH { println("[cap] n_ch=" + str(n_ch) + " > " + str(CLM_CH) + " → CLM 은 처음 " + str(CLM_CH) + " EEG 채널만 사용 (2^" + str(CLM_CH) + " 상태; 16ch 전체 상태공간은 폭발)") }
    let V = pow2(CLM_CH)
    let T = n_samp
    if len(samples) < n_ch * n_samp {
        println("[ERR] 샘플 수 부족 (" + str(len(samples)) + " < " + str(n_ch * n_samp) + ")")
        return
    }

    // ── channel means → per-timestep system state (알파벳 V=2^n_ch) ────────
    let mut means = []
    let mut ch = 0
    while ch < n_ch {
        let mut sm = 0.0
        let mut t = 0
        while t < n_samp { sm = sm + samples[ch * n_samp + t]; t = t + 1 }
        means = means.push(sm / to_float(n_samp))
        ch = ch + 1
    }
    let mut seq = []
    let mut t2 = 0
    while t2 < T {
        let mut state = 0
        let mut c2 = 0
        let mut w = 1
        while c2 < CLM_CH {
            if samples[c2 * n_samp + t2] > means[c2] { state = state + w }
            w = w * 2
            c2 = c2 + 1
        }
        seq = seq.push(state)
        t2 = t2 + 1
    }

    // ── train bigram + unigram ────────────────────────────────────────────
    let mut uni = []
    let mut z = 0
    while z < V { uni = uni.push(0); z = z + 1 }
    let mut big = []
    z = 0
    while z < V * V { big = big.push(0); z = z + 1 }
    let mut i = 0
    while i < T { uni[seq[i]] = uni[seq[i]] + 1; i = i + 1 }
    i = 0
    while i < T - 1 { big[seq[i] * V + seq[i + 1]] = big[seq[i] * V + seq[i + 1]] + 1; i = i + 1 }
    let mut umax = 0
    let mut k = 1
    while k < V { if uni[k] > uni[umax] { umax = k }; k = k + 1 }
    let mut barg = []
    let mut c = 0
    while c < V {
        let mut bm = 0
        let mut j = 1
        while j < V { if big[c * V + j] > big[c * V + bm] { bm = j }; j = j + 1 }
        barg = barg.push(bm)
        c = c + 1
    }

    // ── accuracy (in-sample p7) ───────────────────────────────────────────
    let mut uni_hit = 0
    let mut big_hit = 0
    i = 0
    while i < T - 1 {
        if umax == seq[i + 1] { uni_hit = uni_hit + 1 }
        if barg[seq[i]] == seq[i + 1] { big_hit = big_hit + 1 }
        i = i + 1
    }
    let n = T - 1
    let ua = to_float(uni_hit) / to_float(n)
    let ba = to_float(big_hit) / to_float(n)
    let uniform = 1.0 / to_float(V)
    println("[CLM] next-state acc: bigram=" + str(ba) + " unigram=" + str(ua) + " uniform=" + str(uniform))

    // ── generate (greedy) + distribution match ────────────────────────────
    let mut gen = [seq[0]]
    let mut cur = seq[0]
    let mut g = 0
    while g < T - 1 { cur = barg[cur]; gen = gen.push(cur); g = g + 1 }
    let mut ru = []
    let mut gu = []
    z = 0
    while z < V { ru = ru.push(0.0); gu = gu.push(0.0); z = z + 1 }
    i = 0
    while i < T { ru[seq[i]] = ru[seq[i]] + 1.0; gu[gen[i]] = gu[gen[i]] + 1.0; i = i + 1 }
    let mut l1 = 0.0
    k = 0
    while k < V { let d = ru[k] / to_float(T) - gu[k] / to_float(T); l1 = l1 + (if d < 0.0 { 0.0 - d } else { d }); k = k + 1 }
    println("[gen] 생성분포 L1(실데이터 대비) = " + str(l1))

    // ── persist CLM transition table ──────────────────────────────────────
    let mut model = "# EEG-CLM bigram next-state model\n# n_ch=" + str(n_ch) + " V=" + str(V)
        + " acc_bigram=" + str(ba) + " acc_unigram=" + str(ua) + "\n# state -> argmax_next\n"
    c = 0
    while c < V { model = model + str(c) + " " + str(barg[c]) + "\n"; c = c + 1 }
    let _w = write_file("EEG_CLM/eeg_clm.model", model)
    println("[save] CLM 전이표 → EEG_CLM/eeg_clm.model (" + str(V) + " states)")

    let ok = ba > ua && ba > uniform
    println("")
    if ok {
        println("✅ EEG→CLM 구축 완료 — bigram " + str(ba) + " > unigram " + str(ua)
            + " > uniform " + str(uniform) + ". 학습가능한 시간구조 확인, 모델 저장됨.")
    } else {
        println("⚠ EEG→CLM 구축됨 — 단, bigram(" + str(ba) + ")이 baseline 초과 못함 "
            + "(시간구조 약함 — 더 긴 녹음/채널 선택 재검토).")
    }
}
