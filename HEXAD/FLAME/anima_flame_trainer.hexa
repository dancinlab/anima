// @raw117_exempt
// ════════════════════════════════════════════════════════════════════════
// HEXAD/FLAME/anima_flame_trainer.hexa — anima §71 flame Path-A trainer
//
// anima downstream-consumer trainer cloned + adjusted from
//   ~/core/hexa-lang/stdlib/flame/flame_d768_12L_corpus_test.hexa
// per AGENTS.tape @D g_train_flame_not_pytorch (d=2026-05-19):
//   anima training substrate = hexa-lang flame (PyTorch/Python 0-dep).
//
// JUDGED PATH = A (device-resident hand-fused d768·12L decoder).
//
// anima canonical ConsciousDecoderV2 config (verified §16/§59-FIRE/§62 —
//   state/carving_dataregime_s16_2026_05_18/train_carving_s16.py
//   --d-model 768 · --n-layer 12 · --n-head 12 · --n-kv-head 4 ·
//   vocab_size=256; HEXAD/CHAT (ready/models/conscious_decoder.py)
//   ConsciousDecoderV2 RoPE+SwiGLU+RMSNorm+GQA+PureFieldFFN):
//     d=768 · nh=12 · nkv=4 · h=3072 · V=256 · n_layer=12
//   → BYTE-IDENTICAL to flame Path-A flame_d768_12L_corpus_test.hexa
//     config (T=1024 d=768 nh=12 nkv=4 h=3072 V=256 n_layer=12).
//   This is the A/B confirmation: anima's base d768·12L decoder maps
//   DIRECTLY onto flame Path A (no arch flex needed for the vanilla
//   transformer core). Physics overlays = separate gap assessment
//   (see state/anima_flame_trainer_s71_2026_05_19/DESIGN_FINDINGS.md).
//
// from-scratch (g_clm_from_scratch): nn_decoder_init seed=42 RANDOM
//   weight init, base_ckpt = NONE (no ckpt inherit / fine-tune).
//
// CORPUS (state honestly): training/corpus_consciousness_v1.jsonl
//   (151,943 bytes — the SAME byte-level V=256 corpus the flame Path-A
//   reference flame_d768_12L_corpus_test.hexa already targets, and the
//   flame_d32_corpus_test.hexa $0 oracle uses. A §16-class 600MB corpus
//   was NOT used: the $0 instrument-first verify only needs the small
//   corpus to prove the trainer compiles + converges; the §16-class
//   data-regime corpus is a SEPARATE later GPU-fire concern, g3.)
//
// TWO MODES (one config toggle, Path A canonical config unchanged):
//   MODE_CANON (cfg_canon=1): d768·12L T=1024 — BUILD-ONLY on M-Mac
//     (~10GB resident, see flame_d768_12L_corpus_test.hexa header).
//     This is the GPU-dispatch target; F-S71-BUILD = compiles clean.
//   MODE_VERIFY (cfg_canon=0): d=32·3L T=16 over the SAME anima
//     corpus — the flame_d32_corpus_test.hexa $0 small-scale
//     convergence pattern (gn2 collapse ≥1e6× + 8/8 byte-memorization).
//     This is the cheap oracle that instrument-first gates the future
//     cost-bearing d768·12L GPU fire (g_train_flame_not_pytorch
//     build_discipline + fire_gate_note). Runs $0 local.
//
// Falsifiers:
//   F-S71-BUILD          : compiles cleanly (HEXA_MAC_BUILD_OK / build)
//   F-S71-VERIFY-INIT    : MODE_VERIFY init gn2 ≈ 7.97116 (anima oracle)
//   F-S71-VERIFY-COLLAPSE: MODE_VERIFY gn2 collapse ≥ 1e6× (from-scratch
//                          flame trainer actually learns)
//   F-S71-VERIFY-FIT     : MODE_VERIFY acc 8/8 (full small-corpus
//                          memorization — the flame_d32 $0 bar)
//
// anima NEVER edits flame/hexa-lang source (g_train_flame_not_pytorch
//   upstream_downstream_invariant) — flame consumed as stdlib only.
//
// CROSS-LINK:
//   AGENTS.tape @D g_train_flame_not_pytorch / g_clm_from_scratch / g3
//   ~/core/hexa-lang/stdlib/flame/flame_d768_12L_corpus_test.hexa (Path A)
//   ~/core/hexa-lang/stdlib/flame/flame_d32_corpus_test.hexa ($0 oracle)
//   state/anima_flame_trainer_s71_2026_05_19/DESIGN_FINDINGS.md
// ════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/decoder_lib"
use "stdlib/flame/decoder_block_lib"
use "stdlib/flame/nn_lib"
use "stdlib/flame/train_lib"

fn _c_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

println("=== anima §71 flame Path-A trainer (downstream consumer of stdlib/flame) ===")

// ── config toggle: 0 = MODE_VERIFY ($0 local) · 1 = MODE_CANON (GPU) ──
// Set to 0 for the $0 instrument-first convergence verify. The CANON
// branch keeps the anima-canonical d768·12L config BYTE-IDENTICAL to
// flame Path-A flame_d768_12L_corpus_test.hexa for the future GPU fire.
let cfg_canon = 0

// anima canonical d768·12L (§16/§59-FIRE/§62 == flame Path A)
let T_canon = 1024
let d_canon = 768
let nh_canon = 12
let nkv_canon = 4
let h_canon = 3072
let nl_canon = 12
let nsamp_canon = 4
let stride_canon = 4096
let nsteps_canon = 20

// $0 verify config (flame_d32_corpus_test.hexa pattern, SAME corpus)
let T_verify = 16
let d_verify = 32
let nh_verify = 4
let nkv_verify = 2
let h_verify = 64
let nl_verify = 3
let nsamp_verify = 8
let stride_verify = 512
let nsteps_verify = 80

let T = if cfg_canon == 1 { T_canon } else { T_verify }
let d = if cfg_canon == 1 { d_canon } else { d_verify }
let nh = if cfg_canon == 1 { nh_canon } else { nh_verify }
let nkv = if cfg_canon == 1 { nkv_canon } else { nkv_verify }
let h = if cfg_canon == 1 { h_canon } else { h_verify }
let V = 256          // byte-level vocab (anima ConsciousDecoderV2 vocab_size=256)
let n_layer = if cfg_canon == 1 { nl_canon } else { nl_verify }
let nsamp = if cfg_canon == 1 { nsamp_canon } else { nsamp_verify }
let stride = if cfg_canon == 1 { stride_canon } else { stride_verify }
let n_steps = if cfg_canon == 1 { nsteps_canon } else { nsteps_verify }
let hd = d / nh

// from-scratch (g_clm_from_scratch): seed-fixed RANDOM init, base_ckpt=NONE
let seed_init = 42

// SAME byte-level corpus the flame Path-A d768 reference + d32 oracle use.
let path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
let bytes_arr = read_file_bytes(path)
let n_bytes = len(bytes_arr)
print("  mode: ")
if cfg_canon == 1 { println("MODE_CANON (d768·12L — GPU dispatch target, BUILD ONLY on M-Mac)") }
else { println("MODE_VERIFY (d=32·3L $0 local convergence oracle, SAME anima corpus)") }
print("  corpus: "); print(path); println("")
print("  size: "); print(n_bytes); println(" bytes (V=256 byte-level vocab, from-scratch base_ckpt=NONE)")
print("  config: T="); print(T); print(" d="); print(d); print(" nh="); print(nh)
print(" nkv="); print(nkv); print(" h="); print(h); print(" V="); print(V)
print(" n_layer="); print(n_layer); print(" seed="); print(seed_init); println("")
print("  nsamp="); print(nsamp); print(" stride="); print(stride); print(" n_steps="); print(n_steps)
println("")

// extract nsamp windows of T ids + 1 target each (flame Path-A pattern)
let IDS = t_zeros(nsamp * T)
let YS = t_zeros(nsamp)
let mut s = 0
while s < nsamp {
    let off = s * stride
    if off + T < n_bytes {
        let mut p = 0
        while p < T {
            t_set(IDS, s * T + p, to_float(bytes_arr[off + p]))
            p = p + 1
        }
        t_set(YS, s, to_float(bytes_arr[off + T]))
    }
    s = s + 1
}

// allocate model + optimizer (flame Path-A device-resident layout)
let m_size = m_total(d, nh, nkv, h, V, n_layer)
print("  model size: "); print(m_size); println(" doubles")
let M = t_zeros(m_size)
nn_decoder_init(M, seed_init, T, d, nh, nkv, h, V, n_layer)
let Mm = t_zeros(m_size)
let Mv = t_zeros(m_size)
let Mg = t_zeros(m_size)
let Mg_acc = t_zeros(m_size)
let mc_size = mc_total(T, d, nh, nkv, h, V, n_layer)
let Mc = t_zeros(mc_size)
let cos_tab = t_zeros(T * hd); let sin_tab = t_zeros(T * hd)
nn_rope_build_tables(T, hd, cos_tab, sin_tab)

let lr = 0.03
let b1 = 0.9
let b2 = 0.999
let eps_a = 0.00000001
let wd = 0.01

fn _window_ids(IDS: int, s: int, T: int, ids_out: int) {
    let mut p = 0
    while p < T {
        let _ = farr_set(ids_out, p, farr_get(IDS, s * T + p))
        p = p + 1
    }
}

// initial gn2 epoch
let ids_scratch = t_zeros(T)
let mut gn2_init_epoch = 0.0
let mut s_init = 0
while s_init < nsamp {
    _window_ids(IDS, s_init, T, ids_scratch)
    let target_t = to_int(t_get(YS, s_init))
    nn_decoder_fwd(ids_scratch, M, Mc, cos_tab, sin_tab,
                   T, d, nh, nkv, h, V, n_layer)
    let g = nn_decoder_gn2(Mc, target_t, T, d, nh, nkv, h, V, n_layer)
    gn2_init_epoch = gn2_init_epoch + g
    s_init = s_init + 1
}
print("  init epoch gn2: "); print(gn2_init_epoch)
if cfg_canon == 0 { println("  (anima d32 oracle reference: 7.97116)") } else { println("") }

// grad-accumulate-then-step loop (flame Path-A pattern; MODE_VERIFY
// uses opt_adamw_step like flame_d32, MODE_CANON uses the corrected
// nn_decoder_adamw_step signature like flame_d768_12L)
let mut step = 1
let mut gn2_last = gn2_init_epoch
while step <= n_steps {
    let mut z = 0
    while z < m_size {
        let _ = farr_set(Mg_acc, z, 0.0)
        z = z + 1
    }
    let mut gn2_step_epoch = 0.0
    let mut s_e = 0
    while s_e < nsamp {
        _window_ids(IDS, s_e, T, ids_scratch)
        let tt = to_int(t_get(YS, s_e))
        nn_decoder_fwd(ids_scratch, M, Mc, cos_tab, sin_tab,
                       T, d, nh, nkv, h, V, n_layer)
        let g = nn_decoder_gn2(Mc, tt, T, d, nh, nkv, h, V, n_layer)
        gn2_step_epoch = gn2_step_epoch + g
        let mut z2 = 0
        while z2 < m_size {
            let _ = farr_set(Mg, z2, 0.0)
            z2 = z2 + 1
        }
        nn_decoder_grad(ids_scratch, tt, M, Mc, Mg, cos_tab, sin_tab,
                        T, d, nh, nkv, h, V, n_layer)
        let mut a = 0
        while a < m_size {
            let cur = farr_get(Mg_acc, a)
            let _ = farr_set(Mg_acc, a, cur + farr_get(Mg, a))
            a = a + 1
        }
        s_e = s_e + 1
    }
    if cfg_canon == 1 {
        nn_decoder_adamw_step(M, Mg_acc, Mm, Mv, m_size, lr, b1, b2, eps_a, wd, step)
    } else {
        opt_adamw_step(M, Mg_acc, Mm, Mv, m_size, lr, b1, b2, eps_a, wd, step)
    }
    gn2_last = gn2_step_epoch
    if step == 1 {
        print("  step 1 (pre-update) gn2: "); println(gn2_step_epoch)
    }
    if step == 10 {
        print("  step 10 gn2: "); println(gn2_step_epoch)
    }
    if step == n_steps {
        print("  step "); print(step); print(" gn2: "); println(gn2_step_epoch)
    }
    step = step + 1
}

// final epoch gn2 + acc
let mut gn2_final_epoch = 0.0
let mut acc = 0
let mut s_f = 0
while s_f < nsamp {
    _window_ids(IDS, s_f, T, ids_scratch)
    let tt = to_int(t_get(YS, s_f))
    nn_decoder_fwd(ids_scratch, M, Mc, cos_tab, sin_tab,
                   T, d, nh, nkv, h, V, n_layer)
    let g = nn_decoder_gn2(Mc, tt, T, d, nh, nkv, h, V, n_layer)
    gn2_final_epoch = gn2_final_epoch + g
    let pred = nn_decoder_predict(Mc, T, d, nh, nkv, h, V, n_layer)
    if pred == tt { acc = acc + 1 }
    s_f = s_f + 1
}
print("  final: epoch gn2 = "); print(gn2_final_epoch)
print("  / acc = "); print(acc); print("/"); print(nsamp); println("")

let mut pass = 0
let total = if cfg_canon == 1 { 1 } else { 4 }

// F-S71-BUILD (always — reaching here = compiled + ≥1 fwd/grad/adamw OK)
println("PASS  F-S71-BUILD  anima flame trainer compiles + V=256 byte-vocab graceful + ≥1 fwd/grad/adamw cycle clean")
pass = pass + 1

if cfg_canon == 0 {
    // F-S71-VERIFY-INIT
    let init_dev = _c_abs(gn2_init_epoch - 7.97116)
    if init_dev < 0.05 {
        print("PASS  F-S71-VERIFY-INIT      |Δ| = "); print(init_dev)
        println(" < 0.05 vs anima d32 oracle 7.97116 (from-scratch flame init algorithm-byte-eq)")
        pass = pass + 1
    } else {
        print("FAIL  F-S71-VERIFY-INIT      |Δ| = "); print(init_dev)
        print(" ; actual = "); print(gn2_init_epoch); println("")
    }
    // F-S71-VERIFY-COLLAPSE
    let collapse = if gn2_final_epoch > 0.0 { gn2_init_epoch / gn2_final_epoch } else { 1.0 }
    if collapse > 1000000.0 {
        print("PASS  F-S71-VERIFY-COLLAPSE  gn2 collapse = "); print(collapse)
        println("× (≥1e6× — flame from-scratch trainer actually learns; anima oracle ~2.13e7×)")
        pass = pass + 1
    } else {
        print("FAIL  F-S71-VERIFY-COLLAPSE  only "); print(collapse); println("× collapse")
    }
    // F-S71-VERIFY-FIT
    if acc == nsamp {
        print("PASS  F-S71-VERIFY-FIT       acc "); print(acc); print("/"); print(nsamp)
        println(" — full small-corpus memorization (flame_d32 $0 bar; anima oracle 8/8)")
        pass = pass + 1
    } else {
        print("FAIL  F-S71-VERIFY-FIT       acc "); print(acc); print("/"); print(nsamp); println(" < full")
    }
} else {
    println("NOTE  MODE_CANON: run-time falsifiers defer to cost-bearing d768·12L GPU")
    println("      dispatch (separate gated step, instrument-first per")
    println("      g_train_flame_not_pytorch fire_gate_note). M-Mac CPU memory")
    println("      ceiling (~10GB resident) forbids local d768·12L execution.")
}

let _ = t_free(IDS); let _ = t_free(YS); let _ = t_free(M); let _ = t_free(Mm); let _ = t_free(Mv)
let _ = t_free(Mg); let _ = t_free(Mg_acc); let _ = t_free(Mc)
let _ = t_free(cos_tab); let _ = t_free(sin_tab); let _ = t_free(ids_scratch)

println("")
print("=== anima §71 flame trainer: "); print(pass); print("/"); print(total); println(" PASS ===")
if pass == total {
    if cfg_canon == 0 {
        println("PASS — anima flame Path-A trainer (downstream consumer) reproduces the flame_d32 $0 convergence oracle over anima's OWN corpus (from-scratch, gn2 collapse + full memorization). Instrument-first gate for the future d768·12L GPU fire SATISFIED. Capability claim 0 — this is substrate-migration verification, NOT GOAL emergence.")
    } else {
        println("PASS — anima flame Path-A canonical d768·12L config compiles (GPU dispatch ready). Run-time = separate gated cost-bearing fire.")
    }
} else {
    println("FAIL — named blockers above")
}
