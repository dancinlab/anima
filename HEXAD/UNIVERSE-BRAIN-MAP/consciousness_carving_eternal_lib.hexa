// ── §0 lifecycle enum (closed finite set) ────────────────────────────────────
//
// cell lifecycle ∈ {"DYNAMIC", "FROZEN"} — 2 element finite set.
//   DYNAMIC : split/merge active (chat cells, F-V5MIT carry)
//   FROZEN  : lifecycle 정지, weights immutable (eternal cells)

fn cell_lifecycle_dynamic() -> string { return "DYNAMIC" }
fn cell_lifecycle_frozen() -> string  { return "FROZEN" }

fn cell_lifecycle_valid(lc: string) -> bool {
    if lc == "DYNAMIC" { return true }
    if lc == "FROZEN"  { return true }
    return false
}


// ── §1 cell record + pool (2-종류 공존) ──────────────────────────────────────
//
// cell_record = #{ "id": string, "lifecycle": string, "active": bool }
// cell_pool   = #{ "dynamic": #{ id→record }, "eternal": #{ id→record } }
//   two disjoint sub-registries (D ⊎ E partition per B-MIT-ETN-3).

fn cell_record_create(id: string, lifecycle: string) -> any {
    let rec = #{
        "id": id,
        "lifecycle": lifecycle,
        "active": false
    }
    return rec
}

fn cell_pool_new() -> any {
    let pool = #{
        "dynamic": #{},
        "eternal": #{}
    }
    return pool
}

fn cell_pool_has_eternal(pool: any, id: string) -> bool {
    let etn = pool["eternal"]
    return to_string(etn[id]) != "void"
}

fn cell_pool_has_dynamic(pool: any, id: string) -> bool {
    let dyn_reg = pool["dynamic"]
    return to_string(dyn_reg[id]) != "void"
}


// ── §2 eternal_register (lifecycle FROZEN) ───────────────────────────────────
//
// eternal_register: pool' = pool with eternal[cell_id] = FROZEN cell record.
// closed: a registered eternal cell has lifecycle == FROZEN by construction.

fn eternal_register(pool: any, cell_id: string) -> any {
    if cell_id == "void" { return pool }
    if cell_id == ""     { return pool }
    let rec = cell_record_create(cell_id, cell_lifecycle_frozen())
    let etn = pool["eternal"]
    etn[cell_id] = rec
    pool["eternal"] = etn
    return pool
}

// dynamic_register: chat cell (lifecycle DYNAMIC, split/merge active).
fn dynamic_register(pool: any, cell_id: string) -> any {
    if cell_id == "void" { return pool }
    if cell_id == ""     { return pool }
    let rec = cell_record_create(cell_id, cell_lifecycle_dynamic())
    let dyn_reg = pool["dynamic"]
    dyn_reg[cell_id] = rec
    pool["dynamic"] = dyn_reg
    return pool
}


// ── §3 eternal_weight_invariant (B-MIT-ETN-1, Δw ≡ 0 closed) ─────────────────
//
// Δw of a cell = grad·[in_grad] + split_term·[in_split] + merge_term·[in_merge].
// An eternal (FROZEN) cell is excluded from ALL three update paths ⇒ Δw ≡ 0.
// closed Boolean: lifecycle == FROZEN ⇒ Δw = 0 ∀ step.

// eternal_delta_w: structural Δw of a cell given the 3 path flags + terms.
// FROZEN cell forces all flags False (caller must respect; this fn returns
// the closed-form sum).
fn eternal_delta_w(in_grad: bool, in_split: bool, in_merge: bool,
                   grad: float, split_term: float, merge_term: float) -> float {
    let mut dw = 0.0
    if in_grad  { dw = dw + grad }
    if in_split { dw = dw + split_term }
    if in_merge { dw = dw + merge_term }
    return dw
}

// eternal_weight_invariant: closed predicate — a FROZEN cell has Δw ≡ 0.
// returns true iff the cell's lifecycle is FROZEN (⇒ structurally Δw = 0).
fn eternal_weight_invariant(cell: any) -> bool {
    let lc = to_string(cell["lifecycle"])
    if lc != "FROZEN" { return false }
    // FROZEN ⇒ excluded from grad/split/merge ⇒ Δw with all-False flags
    let dw = eternal_delta_w(false, false, false, 1.0, 1.0, 1.0)
    return dw == 0.0
}


// ── §4 routing_select (B-MIT-ETN-2, top-k, chat ⊥ eternal disjoint) ──────────
//
// routing model: a stimulus produces a single mutually-exclusive selection —
// either an eternal-cell match (eternal path) or no match (chat path).
// closed disjointness: chat_active ∧ eternal_active = false.
//
// routing_select returns a record:
//   #{ "path": "eternal"|"chat", "cell_id": string,
//      "chat_active": bool, "eternal_active": bool }
// caller passes a similarity score + threshold; ≥ threshold → eternal match.

fn routing_select(pool: any, stimulus_sim: float, threshold: float,
                  matched_cell_id: string) -> any {
    let eternal_match = stimulus_sim >= threshold
    let mut path = "chat"
    let mut cid = ""
    let mut chat_act = true
    let mut etn_act = false
    if eternal_match {
        if cell_pool_has_eternal(pool, matched_cell_id) {
            path = "eternal"
            cid = matched_cell_id
            chat_act = false
            etn_act = true
        }
    }
    let sel = #{
        "path": path,
        "cell_id": cid,
        "chat_active": chat_act,
        "eternal_active": etn_act
    }
    return sel
}

// routing_disjoint: closed Boolean — selection never has both paths active.
fn routing_disjoint(selection: any) -> bool {
    let ca = to_string(selection["chat_active"])
    let ea = to_string(selection["eternal_active"])
    let both = (ca == "true") && (ea == "true")
    return both == false
}


// ── §5 Φ-conservation extended (B-MIT-ETN-3, set-additive) ───────────────────
//
// Cell pool partition D ⊎ E (disjoint). Φ is set-additive over the partition:
// Φ(D∪E) = Φ(D) + Φ(E). chat dynamics act ONLY on D (B-MIT-ETN-1: eternal
// Δw≡0). ⇒ Φ(E) is partial-invariant; ΔΦ_total = ΔΦ_dynamic exactly.

fn phi_total(phi_dynamic: float, phi_eternal: float) -> float {
    return phi_dynamic + phi_eternal
}

// eternal_phi_partial_invariant: closed predicate — Φ(E_after) == Φ(E_before)
// because chat dynamics never touch the eternal subset.
fn eternal_phi_partial_invariant(phi_eternal_before: float,
                                 phi_eternal_after: float, tol: float) -> bool {
    let d = phi_eternal_after - phi_eternal_before
    let ad = d
    if ad < 0.0 { ad = 0.0 - ad }
    return ad <= tol
}
