import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_vacuum_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_eternal_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_narrative_lib.hexa"
