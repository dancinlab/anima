fn _approx_eq(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}


// ── F-CARVE-1 VACUUM (α path — VACUUM-LANDSCAPE) ─────────────────────────────
fn _f_carve_1() -> bool {
    let tol = 1e-6

    // multi-vacuum landscape: register 2 vacuum points + chat default.
    let mut ls = vacuum_landscape_new()
    let v_chat = vacuum_record_create("eternal_000", [0.50, 0.50], 0.10)
    let v_mand = vacuum_record_create("eternal_077", [0.71, 0.62], 0.18)
    ls = vacuum_register(ls, v_chat)
    ls = vacuum_register(ls, v_mand)
    let a1_registered = vacuum_landscape_has(ls, "eternal_000")
                     && vacuum_landscape_has(ls, "eternal_077")

    // vacuum_nearest: a Ψ point near 🛸77 → nearest = eternal_077.
    let near = vacuum_nearest(ls, [0.70, 0.63], ["eternal_000", "eternal_077"])
    let a2_nearest = to_string(near["id"]) == "eternal_077"

    // basin_contains: query inside 🛸77 basin (radius 0.18) → true.
    let a3_in_basin = basin_contains([0.70, 0.63], v_mand, 0.18)
    // query far from 🛸77 → not in basin.
    let a3b_out_basin = (basin_contains([0.10, 0.10], v_mand, 0.18) == false)

    // tension flow: at the vacuum (deviation 0) ΔW = 0 (fixed point).
    let dw_fix = tension_flow_step([0.71, 0.62], v_mand, vac_t_const())
    let a4_fixed_point = _approx_eq(dw_fix[0], 0.0, tol)
                      && _approx_eq(dw_fix[1], 0.0, tol)
    // off-vacuum: flow is restoring → moves psi closer to vacuum.
    let psi_off = [0.90, 0.80]
    let dw_off = tension_flow_step(psi_off, v_mand, vac_t_const())
    let psi_new = vacuum_apply_flow(psi_off, dw_off)
    let d_before = vac_dist(psi_off, v_mand["psi"])
    let d_after = vac_dist(psi_new, v_mand["psi"])
    let a5_restoring = d_after < d_before

    // B-VAC-1 Hessian sign: a>0 ⇒ stable vacuum.
    let a6_hessian = vac_is_stable_vacuum(1.5)
                  && (vac_is_stable_vacuum(0.0 - 1.0) == false)
    // B-VAC-2 KL basin separation: μ₁≠μ₂ ⇒ KL > 0.
    let a7_kl = vac_basins_separated(1.0, 0.0, 1.0)
             && (vac_basins_separated(0.0, 0.0, 1.0) == false)
    // B-VAC-3 measure conservation: identical mass before/after → conserved.
    let a8_measure = vac_measure_conserved([0.25, 0.25, 0.25, 0.25],
                                           [0.40, 0.10, 0.30, 0.20], tol)

    let pass = a1_registered && a2_nearest && a3_in_basin && a3b_out_basin
            && a4_fixed_point && a5_restoring && a6_hessian && a7_kl && a8_measure
    print("  F-CARVE-1 VACUUM (α: landscape+flow+basin+Hessian/KL/Lindblad): "
          + to_string(pass))
    return pass
}


// ── F-CARVE-2 ETERNAL (β path — MITOSIS-ETERNAL-CELL) ────────────────────────
fn _f_carve_2() -> bool {
    // cell pool with 2-종류 cell.
    let mut pool = cell_pool_new()
    pool = eternal_register(pool, "eternal_077")
    pool = eternal_register(pool, "eternal_091")
    pool = dynamic_register(pool, "chat_1")
    let b1_pool = cell_pool_has_eternal(pool, "eternal_077")
               && cell_pool_has_eternal(pool, "eternal_091")
               && cell_pool_has_dynamic(pool, "chat_1")

    // B-MIT-ETN-1: eternal cell lifecycle FROZEN ⇒ Δw ≡ 0.
    let etn = pool["eternal"]
    let etn_cell = etn["eternal_077"]
    let b2_weight_inv = eternal_weight_invariant(etn_cell)
    // a DYNAMIC cell does NOT satisfy the eternal invariant (discriminating).
    let dyn_cell = cell_record_create("chat_1", cell_lifecycle_dynamic())
    let b2b_dynamic = (eternal_weight_invariant(dyn_cell) == false)

    // B-MIT-ETN-2: routing — high similarity → eternal path.
    let sel_etn = routing_select(pool, 0.92, 0.6, "eternal_077")
    let b3_eternal_route = to_string(sel_etn["path"]) == "eternal"
    // low similarity → chat path.
    let sel_chat = routing_select(pool, 0.10, 0.6, "eternal_077")
    let b3b_chat_route = to_string(sel_chat["path"]) == "chat"
    // routing always disjoint (chat ⊥ eternal).
    let b4_disjoint = routing_disjoint(sel_etn) && routing_disjoint(sel_chat)

    // B-MIT-ETN-3: Φ partial-invariance — eternal Φ untouched by chat dyn.
    let phi_t0 = phi_total(3.0, 5.0)     // Φ(D)=3 + Φ(E)=5 = 8
    let phi_t1 = phi_total(4.0, 5.0)     // Φ(D)=4 + Φ(E)=5 = 9 (E unchanged)
    let b5_phi_inv = eternal_phi_partial_invariant(5.0, 5.0, 1e-9)
                  && (phi_t1 - phi_t0 == 1.0)   // ΔΦ_total == ΔΦ_dynamic

    let pass = b1_pool && b2_weight_inv && b2b_dynamic && b3_eternal_route
            && b3b_chat_route && b4_disjoint && b5_phi_inv
    print("  F-CARVE-2 ETERNAL (β: pool+Δw≡0+routing-disjoint+Φ-invariant): "
          + to_string(pass))
    return pass
}


// ── F-CARVE-3 NARRATIVE (γ path — NARRATIVE-RESONANCE) ───────────────────────
fn _f_carve_3() -> bool {
    // B-NAR-1: A∘G composition — codomain(G)=domain(A)=INNER ⇒ well-defined.
    let g = narr_engine_g()
    let a = narr_engine_a()
    let comp = narrative_compose(g, a)
    let c1_well_defined = narrative_loop_well_defined(comp)
    let c1b_type = to_string(comp["domain"]) == "STIMULUS"
                && to_string(comp["codomain"]) == "VOICE"
    // mis-typed counter-witness: G' codomain VOICE ≠ domain(A) INNER.
    let bad_g = narr_engine_fn("bad_g", narr_type_stimulus(), narr_type_voice())
    let bad_comp = narrative_compose(bad_g, a)
    let c1c_discriminates = (narrative_loop_well_defined(bad_comp) == false)

    // B-NAR-2: bounded Kolmogorov K — a short template within τ_K.
    let tmpl = "🛸k 매핑은 cat × emo 행렬에서 derive"
    let c2_bounded = narrative_bounded_k(tmpl)

    // B-NAR-3: greedy decode deterministic — same query ⇒ identical narrative.
    let n1 = narrative_regenerate("만다라 Tier", "[anima 우주뇌지도] ")
    let n2 = narrative_regenerate("만다라 Tier", "[anima 우주뇌지도] ")
    let c3_consistent = narrative_consistency(n1, n2)
    let c3b_sim = _approx_eq(narrative_similarity(n1, n2), 1.0, 1e-9)
    // a DIFFERENT query → different narrative (similarity 0).
    let n3 = narrative_regenerate("열반 Tier", "[anima 우주뇌지도] ")
    let c3c_distinct = _approx_eq(narrative_similarity(n1, n3), 0.0, 1e-9)

    let pass = c1_well_defined && c1b_type && c1c_discriminates && c2_bounded
            && c3_consistent && c3b_sim && c3c_distinct
    print("  F-CARVE-3 NARRATIVE (γ: A∘G composition+bounded-K+greedy-consist): "
          + to_string(pass))
    return pass
}


// ── F-CARVE-4 WEAVE (α+β hybrid — VACUUM-CELL-WEAVE) ─────────────────────────
fn _f_carve_4() -> bool {
    // woven anchor: eternal cell 077 with its own vacuum.
    let woven = weave_anchor("eternal_077", [0.71, 0.62], 0.18)
    let d1_valid = weave_anchor_valid(woven)
    // malformed woven anchor (empty cell_id) → invalid.
    let bad_woven = weave_anchor("", [0.71, 0.62], 0.18)
    let d1b_invalid = (weave_anchor_valid(bad_woven) == false)

    // weave_register: registers into BOTH cell pool + vacuum landscape.
    let pool0 = cell_pool_new()
    let ls0 = vacuum_landscape_new()
    let st = weave_register(pool0, ls0, woven)
    let pool1 = st["pool"]
    let ls1 = st["landscape"]
    let d2_both = cell_pool_has_eternal(pool1, "eternal_077")
               && vacuum_landscape_has(ls1, "eternal_077")

    // weave_route: stimulus near 🛸77 with high similarity → eternal route.
    let stim = #{
        "psi": [0.70, 0.63],
        "sim": 0.92,
        "threshold": 0.6,
        "matched_cell_id": "eternal_077"
    }
    let route = weave_route(pool1, ls1, stim, ["eternal_077"])
    let d3_eternal = to_string(route["path"]) == "eternal"
    let d3b_disjoint = weave_route_disjoint(route)

    // stimulus far from 🛸77 → chat route (α basin miss even if β matches).
    let stim_far = #{
        "psi": [0.10, 0.10],
        "sim": 0.92,
        "threshold": 0.6,
        "matched_cell_id": "eternal_077"
    }
    let route_far = weave_route(pool1, ls1, stim_far, ["eternal_077"])
    let d4_chat = to_string(route_far["path"]) == "chat"

    // B-CARVE-MULTIMODAL: cross-modal carving transfer-form — d_m<r ∧ d_n<r
    // ⇒ pairwise modality distance < 2r (triangle inequality well-formed).
    let d5_well_formed = cross_modal_well_formed(0.05, 0.07, 0.18)
    // a modality outside the basin (d_m ≥ r) → not well-formed.
    let d5b_violation = (cross_modal_well_formed(0.20, 0.05, 0.18) == false)
    // modality_in_basin: encoded Ψ inside the woven basin.
    let d6_in_basin = modality_in_basin([0.70, 0.63], woven)

    let pass = d1_valid && d1b_invalid && d2_both && d3_eternal && d3b_disjoint
            && d4_chat && d5_well_formed && d5b_violation && d6_in_basin
    print("  F-CARVE-4 WEAVE (α+β: woven-anchor+weave-route+cross-modal-bound): "
          + to_string(pass))
    return pass
}


// ── F-CARVE-5 KOSMOS-PARSE (`.kosmos` parser on 5 anchor files) ──────────────
fn _f_carve_5() -> bool {
    let anchors_dir = "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors/"

    // load knuth_077_mandala — the spec's worked example.
    let mand = kosmos_load(anchors_dir + "knuth_077_mandala.kosmos")
    let e1_ok = kosmos_anchor_valid(mand)
    let e1b_id = to_string(mand["id"]) == "knuth_077_mandala"
    let e1c_tier = to_int(mand["knuth_tier"]) == 77
    let e1d_cat = to_string(mand["category"]) == "예술"
    let e1e_cell = to_string(mand["cell_id"]) == "eternal_077"
    // vacuum_psi parsed as 2-pair [0.71, 0.62].
    let vpsi = mand["vacuum_psi"]
    let e1f_psi = len(vpsi) == 2
               && _approx_eq(vpsi[0], 0.71, 1e-6)
               && _approx_eq(vpsi[1], 0.62, 1e-6)
    let e1g_radius = _approx_eq(to_float(mand["basin_radius"]), 0.18, 1e-6)

    // payload lookup: text payload = inline form; image = pending.
    let p_text = kosmos_payload(mand, "text")
    let e2_text_inline = to_string(p_text["form"]) == "inline"
                      && to_string(p_text["value"]) != ""
    let p_img = kosmos_payload(mand, "image")
    let e2b_image_pending = to_string(p_img["form"]) == "pending"
    let p_tension = kosmos_payload(mand, "tension")
    let e2c_tension_pending = to_string(p_tension["form"]) == "pending"
    // payload count: 5 (text/image/audio/video/tension).
    let e2d_count = to_int(mand["payload_count"]) == 5

    // load the other 4 anchor files — all must parse valid.
    let zero = kosmos_load(anchors_dir + "knuth_000_zero.kosmos")
    let day = kosmos_load(anchors_dir + "knuth_051_day.kosmos")
    let nirv = kosmos_load(anchors_dir + "knuth_091_nirvana.kosmos")
    let bang = kosmos_load(anchors_dir + "knuth_100_big_bang.kosmos")
    let e3_all_valid = kosmos_anchor_valid(zero)
                    && kosmos_anchor_valid(day)
                    && kosmos_anchor_valid(nirv)
                    && kosmos_anchor_valid(bang)
    // tier ordinals: 🛸0 / 🛸51 / 🛸91 / 🛸100.
    let e3b_tiers = to_int(zero["knuth_tier"]) == 0
                 && to_int(day["knuth_tier"]) == 51
                 && to_int(nirv["knuth_tier"]) == 91
                 && to_int(bang["knuth_tier"]) == 100
    // 🛸0 zero baseline vacuum = anima default (½,½).
    let zpsi = zero["vacuum_psi"]
    let e3c_zero_psi = len(zpsi) == 2
                    && _approx_eq(zpsi[0], 0.50, 1e-6)
                    && _approx_eq(zpsi[1], 0.50, 1e-6)

    let pass = e1_ok && e1b_id && e1c_tier && e1d_cat && e1e_cell && e1f_psi
            && e1g_radius && e2_text_inline && e2b_image_pending
            && e2c_tension_pending && e2d_count && e3_all_valid && e3b_tiers
            && e3c_zero_psi
    print("  F-CARVE-5 KOSMOS-PARSE (.kosmos parser on 5 anchor files): "
          + to_string(pass))
    return pass
}


fn _selftest() {
    print("--- F-CARVE-1..5 compiled-native witness (Phase UBM-E4) ---")
    let f1 = _f_carve_1()
    let f2 = _f_carve_2()
    let f3 = _f_carve_3()
    let f4 = _f_carve_4()
    let f5 = _f_carve_5()
    let all_ok = f1 && f2 && f3 && f4 && f5
    print("=== F-CARVE-1..5 compiled-native selftest: " + to_string(all_ok)
          + " (5/5) ===")
    print("    canonical 🔵 sympy : state/verify_consciousness_carving_2026_05_17/")
    print("                          blue_falsifier.py (B-VAC/B-MIT-ETN/B-NAR/")
    print("                          B-CARVE-MULTIMODAL, 10/10 🔵)")
    print("    B-CARVE-NOTE       : 4-path SGD outcome + measured vacuum_psi")
    print("                          empirical (B-D-NOTE family, NOT counted 🔵)")
}


fn main() {
    print("HEXAD/UNIVERSE-BRAIN-MAP — consciousness_carving_smoke (Phase UBM-E4)")
    print("  CONSCIOUSNESS-CARVING 4-path (α/β/γ/α+β) + .kosmos parser witness")
    _selftest()
}
