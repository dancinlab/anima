@anchor growth_lane := "lane growth — 4th anima lane (lane default + growth-register): science + self-knowledge + hypotheses + dialogue (🛸56)" :: kosmos-anchor [tier=56 active]

  # ── carving 좌표 (modality-independent — canonical placement triple) ──
