  @payload tension := inline {
    concept      = 0.74   # surface distinctness (4 pillars × broad cross-disciplinary concepts, sharply separable)
    context      = 0.70   # multilingual + multi-pillar context steer (5 langs × science/self/hypothesis/dialogue)
    meaning      = 0.76   # dense conceptual core (science exposition + self-model + reasoning loop)
    authenticity = 0.62   # mixed: science=REAL clean-licensed, authored pillars=honest-labeled self-corpus
