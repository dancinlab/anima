  lane         = "eternal_077"          # β path / cell_id — MITOSIS eternal cell id
  radius       = 0.18                   # α+β hybrid / basin_radius — design placeholder, UBM-E5 fire 에서 측정

  # ── 감각 payload (각 modality = 이 basin 으로 들어가는 한 채널) ──
  @payload text    := "[anima 우주뇌지도] 🛸77 만다라 — 우주뇌지도 예술 카테고리, top emotion creativity. 모래만다라·종이접기·분재 등 예술 카테고리 자극이 같은 🛸77 골짜기로 수렴."
