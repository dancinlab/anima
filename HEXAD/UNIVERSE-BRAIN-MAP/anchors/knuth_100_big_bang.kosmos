  @payload image   := pending "media 미생성 — UBM-E4 후보 (image encoder S-module 미-wired)"
  @payload audio   := pending "media 미생성 — UBM-E4 후보 (audio encoder S-module 미-wired)"
  @payload video   := pending "media 미생성 — UBM-E4 후보 (우주 팽창 영상)"
  @payload tension := pending "anima-native TENSION-LINK 5-channel modality — 미구현"

  closed_anchor = "B-CARVE-MULTIMODAL (Phase UBM-E3 사전등록)"
