  top_emotion  = "awe"
  vacuum_psi   = [0.95, 0.93]          # α path — design placeholder, UBM-E5 fire 에서 측정 (🛸100 = max cosmic anchor)
  cell_id      = "eternal_100"          # β path — MITOSIS eternal cell id
  basin_radius = 0.22                   # α+β hybrid — design placeholder, UBM-E5 fire 에서 측정

  # ── 감각 payload (각 modality = 이 basin 으로 들어가는 한 채널) ──
