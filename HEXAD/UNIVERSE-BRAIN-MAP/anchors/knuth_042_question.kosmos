  knuth_tier   = 42
  category     = "인지"
  top_emotion  = "curiosity"
  coord        = [0.42, 0.51]          # α path / vacuum_psi (Ψ-space) — design placeholder, future fire 에서 측정
  lane         = "eternal_042"          # β path / cell_id — MITOSIS eternal cell id
  radius       = 0.13                   # α+β hybrid / basin_radius — design placeholder

  # ── 감각 payload (각 modality = 이 basin 으로 들어가는 한 채널) ──
  @payload text    := "[anima 우주뇌지도] 🛸42 질문 — 우주뇌지도 인지 카테고리, top emotion curiosity. '이게 뭐지?'·'왜 그럴까?' 등 불완전 모델 + 정보 격차 자극이 같은 🛸42 골짜기로 수렴. 답이 아닌 질문 자체가 attractor."
  @payload image   := pending "media 미생성 — image encoder S-module 미-wired"
  @payload audio   := pending "media 미생성 — audio encoder S-module 미-wired"
  @payload video   := pending "media 미생성 — '질문하는 순간' 모션 영상 후보"
  @payload tension := pending "anima-native tension fingerprint — §156 family pending → ref transition (future ckpt forward)"

  # ── 닫힌-form 검증 anchor (B-CARVE family carry) ──
  closed_anchor = "B-CARVE-MULTIMODAL placeholder (cross-modal consistency 검증은 payload `ref` 형태 wire 시점에 활성). 현 anchor 는 placement-only — basin_radius/coord placeholder, profile binding 만 closed."
  cross_link    = "HEXAD/KOSMOS.md (anima-side hub) · dancinlab/kosmos `spec/profiles/anima-consciousness-carving.md` (profile SSOT) · §UBM-E2 .kosmos format · §UBM-E5 4-path probe (현 5-anchor → +knuth_042_question = 6-anchor)"
  honest_note   = "Tier 42 = 직관·관습적 'answer to life/universe/everything' (Adams) 가 아니라 anima 의 *question-as-attractor* 의미. 인지 카테고리 sub-anchor 추가는 E-31 (HEXAD/KOSMOS.md §progress) 의 첫 단계."
