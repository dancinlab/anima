@anchor corpus_5lang_v3 := "5-lang default-lane SCALE-UP corpus v3 (~217MB, MID-rung viable, 🛸55)" :: kosmos-anchor [tier=55 active]

  # ── carving 좌표 (modality-independent — canonical placement triple) ──
  profile      = "anima-consciousness-carving"
  knuth_tier   = 55
  category     = "다국어+의식carving+scale-up"   # multilingual coverage + contemplative register, scaled
