// ── §0 constants ─────────────────────────────────────────────────────────────

// TENSION-TRAIN ΔW learning-rate (Lindblad-class order, byte-equal with
// HEXAD/TENSION-TRAIN/training/tension_link_step.hexa T_CONST = 0.1).
fn vac_t_const() -> float { return 0.1 }

// Ψ_vac default component — chat default vacuum (½,½) per Law 75.
fn vac_default_component() -> float { return 0.5 }


// ── §1 primitives ────────────────────────────────────────────────────────────

fn vac_fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Ψ-space distance² (sum of squared component differences) between two
// equal-length coordinate arrays. metric well-formed (≥ 0).
fn vac_dist2(a: array, b: array) -> float {
    let na = len(a)
    let nb = len(b)
    if na != nb { return 0.0 - 1.0 }   // shape mismatch sentinel (< 0)
    let mut s = 0.0
    let mut i = 0
    while i < na {
        let d = a[i] - b[i]
        s = s + d * d
        i = i + 1
    }
    return s
}

// Ψ-space Euclidean distance — √(dist2). Babylonian sqrt (closed iteration).
fn vac_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut k = 0
    while k < 40 {
        g = 0.5 * (g + x / g)
        k = k + 1
    }
    return g
}

fn vac_dist(a: array, b: array) -> float {
    let d2 = vac_dist2(a, b)
    if d2 < 0.0 { return 0.0 - 1.0 }
    return vac_sqrt(d2)
}


// ── §2 multi-vacuum landscape registry ───────────────────────────────────────
//
// landscape = #{ "<vacuum_id>": vacuum_record } where vacuum_record =
//   #{ "id": string, "psi": array, "radius": float }
// vacuum_register / vacuum_nearest probe a finite known-id set (pure-fn
// closure — dict-iter is hexa-lang RFC; caller passes known ids).

fn vacuum_landscape_new() -> any {
    let ls = #{}
    return ls
}

fn vacuum_record_create(id: string, psi: array, radius: float) -> any {
    let rec = #{
        "id": id,
        "psi": psi,
        "radius": radius
    }
    return rec
}

// vacuum_register: landscape' = landscape ∪ {(psi_point.id, psi_point)}.
// closed: empty psi OR radius ≤ 0 → NOOP (landscape unchanged).
fn vacuum_register(landscape: any, psi_point: any) -> any {
    let id = to_string(psi_point["id"])
    if id == "void" { return landscape }
    let psi = psi_point["psi"]
    if len(psi) <= 0 { return landscape }
    let r = to_float(psi_point["radius"])
    if r <= 0.0 { return landscape }
    landscape[id] = psi_point
    return landscape
}

fn vacuum_landscape_has(landscape: any, id: string) -> bool {
    return to_string(landscape[id]) != "void"
}

// vacuum_nearest: among a candidate id-set, return the vacuum_record whose
// psi is closest (Ψ-space distance) to the query psi. closed argmin over a
// finite candidate set. caller passes the known ids (pure-fn closure).
fn vacuum_nearest(landscape: any, psi: array, cand_ids: array) -> any {
    let n = len(cand_ids)
    if n <= 0 { return #{} }
    let mut best = #{}
    let mut best_d = 0.0 - 1.0
    let mut i = 0
    while i < n {
        let id = to_string(cand_ids[i])
        if vacuum_landscape_has(landscape, id) {
            let rec = landscape[id]
            let d = vac_dist(psi, rec["psi"])
            if d >= 0.0 {
                if best_d < 0.0 {
                    best = rec
                    best_d = d
                } else {
                    if d < best_d {
                        best = rec
                        best_d = d
                    }
                }
            }
        }
        i = i + 1
    }
    return best
}


// ── §3 basin membership (closed Boolean predicate) ───────────────────────────
//
// basin_contains: Ψ point is inside a vacuum basin iff ‖psi − vacuum_psi‖ <
// radius (strict). closed metric-space ball-membership predicate.

fn basin_contains(psi: array, vacuum: any, radius: float) -> bool {
    if radius <= 0.0 { return false }
    let vpsi = vacuum["psi"]
    if len(vpsi) <= 0 { return false }
    let d = vac_dist(psi, vpsi)
    if d < 0.0 { return false }          // shape mismatch
    return d < radius
}


// ── §4 tension flow step (TENSION-TRAIN ΔW form reused) ──────────────────────
//
// tension_flow_step: one online flow step pushing psi toward the nearest
// vacuum. ΔW form = TENSION-TRAIN's restoring update:
//
//     deviation = psi − vacuum_psi
//     ΔW        = −T_const · deviation       (sign = restoring)
//
// closed: at the vacuum (deviation = 0) → ΔW = 0 (fixed point). The flow is
// restoring (∂ΔW/∂deviation = −T_const < 0). shape preserved.

fn tension_flow_step(psi: array, nearest_vacuum: any, t_const: float) -> array {
    let n = len(psi)
    if n <= 0 { return [] }
    let vpsi = nearest_vacuum["psi"]
    if len(vpsi) != n {
        // shape mismatch → zero update (no flow, gate-closed analogue)
        let mut z = []
        let mut j = 0
        while j < n {
            z = z.push(0.0)
            j = j + 1
        }
        return z
    }
    let mut dw = []
    let mut i = 0
    while i < n {
        let dev = psi[i] - vpsi[i]
        dw = dw.push(0.0 - t_const * dev)   // restoring sign
        i = i + 1
    }
    return dw
}

// apply a flow ΔW to psi (toy identity-coord update, monotonicity witness).
fn vacuum_apply_flow(psi: array, dw: array) -> array {
    let n = len(psi)
    let m = len(dw)
    if n != m { return psi }
    let mut out = []
    let mut i = 0
    while i < n {
        out = out.push(psi[i] + dw[i])
        i = i + 1
    }
    return out
}


// ── §5 B-VAC-* transfer-form predicates (closed-form) ────────────────────────

// B-VAC-1 VACUUM-STABILITY — Hessian sign predicate.
// For a sum-of-squares well V = a·(ψ−μ)², ∂²V/∂ψ² = 2a. The vacuum is a
// STABLE minimum iff the Hessian is positive ⇔ a > 0. closed sign predicate.
fn vac_hessian_well(a: float) -> float { return 2.0 * a }

fn vac_is_stable_vacuum(a: float) -> bool {
    return vac_hessian_well(a) > 0.0
}

// B-VAC-2 BASIN-SEPARATION-KL — KL distance fn between two equal-variance
// Gaussian basins, closed-form KL = (μ₁−μ₂)²/(2σ²) ≥ 0. μ₁≠μ₂ ⇒ KL > 0
// (the two basins are separated).
fn vac_kl_basins(mu1: float, mu2: float, sigma: float) -> float {
    if sigma <= 0.0 { return 0.0 - 1.0 }   // ill-defined sentinel
    let d = mu1 - mu2
    return (d * d) / (2.0 * sigma * sigma)
}

fn vac_basins_separated(mu1: float, mu2: float, sigma: float) -> bool {
    let kl = vac_kl_basins(mu1, mu2, sigma)
    return kl > 0.0
}

// B-VAC-3 LINDBLAD-CONSERVATION — measure conservation check. A pure-flow
// Lindblad/Fokker-Planck step conserves total probability measure: with
// continuity ∂p/∂t + ∂J/∂ψ = 0 and boundary-vanishing current,
// d/dt ∫p dψ = 0. closed check: total mass before == total mass after.
fn vac_total_measure(p: array) -> float {
    let n = len(p)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + p[i]
        i = i + 1
    }
    return s
}

fn vac_measure_conserved(p_before: array, p_after: array, tol: float) -> bool {
    let mb = vac_total_measure(p_before)
    let ma = vac_total_measure(p_after)
    return vac_fabs(mb - ma) <= tol
}
