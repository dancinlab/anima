// HEXAD/LIFE/lib/phi_helper.hexa — shared Φ helper module for the LIFE lane.
//
//   PURPOSE
//     The LIFE lane has 28+ hypotheses (H_007 / H_204 / H_211 / H_223 / …)
//     that all reach for the SAME IIT-Φ primitive (`phi_spatial`, RFC 036)
//     under the SAME config defaults (N=16, dim=12, warm=8, n_bins=4) and
//     re-implement the SAME thin call shape inline. That duplication has two
//     costs the cycle-12 gap report flagged:
//
//       F6 (duplicated-helper)     — every H copies the phi_spatial call +
//                                     config block; drift between copies is
//                                     unguarded.
//       F7 (heuristic-promotion)   — the config defaults (16/12/8/4) are an
//                                     UNJUSTIFIED HEURISTIC carried from
//                                     H_007 with no single documented home.
//
//     This module is that single home. It is INFRA, not a new hypothesis:
//       - one config SSOT block, each value annotated with its provenance;
//       - phi_default() — the canonical N/dim/n_bins call (thin wrapper);
//       - phi_with()    — explicit-param override for sweeps;
//       - phi_determinism_check() — re-run byte-identical harness (raw#9).
//
//   Φ PRIMITIVE
//     phi_spatial is imported READ-ONLY via HEXAD/C/c_lib.hexa
//     (c_measure_phi → RFC 036 phi_spatial, the byte-equal native-C replica
//     of anima's phi_rs documented algorithm; Φ ≥ 0 by construction).
//
//   IMPORT-SAFE
//     This file has NO top-level call and NO `fn main()`. Importing it runs
//     nothing (hexa import semantics: top-level calls fire on import; pure
//     `fn` defs do not). Callers import + invoke phi_default/phi_with.
//
//   HONEST CARVE-OUT (raw#9/10)
//     This module DOCUMENTS the heuristic config; it does not RE-VALIDATE it
//     (that is infra_phi_n_bins_2026_05_23's n_bins sweep + each H's own
//     falsifiers). phi_spatial itself is a 🟢 NUMERICAL proxy — the true
//     phi_rs Rust FFI link is a NAMED BLOCKER (RFC 036 §"FFI shim").
//
//   COMPLIANCE  raw#11 snake_case · raw#9 honest impl · English code (prefs).
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/C/c_lib.hexa"


// ── config SSOT ─────────────────────────────────────────────────────────────
// The four LIFE-lane Φ-substrate defaults, each with its provenance. These are
// the SINGLE documented home for the 16/12/8/4 heuristic (F7). They originate
// in H_007 (CA→Φ edge-of-chaos smoke) and were carried verbatim by every
// downstream phi_spatial H. n_bins is delegated to c_lib (== phi_rs default 4).

// lattice length / number of IIT "cells" fed to phi_spatial.
//   provenance: H_007 _N() — periodic 1D elementary-CA lattice length.
//   small enough for $0 mac-local determinism, large enough for non-trivial Φ.
fn life_phi_n() -> int { return 16 }

// per-cell state-vector dimension (recorded temporal-trajectory length).
//   provenance: H_007 _DIM() — steps recorded per site after warmup.
fn life_phi_dim() -> int { return 12 }

// warmup steps discarded before recording (transient burn-in).
//   provenance: H_007 _WARM() — CA settling before the Φ window.
//   NOTE: closure-axis H (e.g. H_204) intentionally override warm=0 to keep
//   the living-transient window; phi_default uses the H_007 default warm=8.
fn life_phi_warm() -> int { return 8 }

// histogram bin count for the phi_spatial mutual-information estimator.
//   provenance: c_phi_n_bins_default() == 4 == phi_rs / RFC 036 binning.
//   robustness verified by state/infra_phi_n_bins_2026_05_23 (rank-invariant
//   across n_bins ∈ {2,4,8,16}).
fn life_phi_nbins() -> int { return c_phi_n_bins_default() }


// ── phi_default — canonical thin wrapper ──────────────────────────────────────
// Measure spatial IIT Φ of a flat (life_phi_n × life_phi_dim) farr `state`
// using the LIFE-lane defaults. This is the single call shape the 28+ H should
// converge on, replacing inline `phi_spatial(s, 16, 12, 4)` copies (F6).
//
// CONTRACT: phi_default(s) is byte-equal to
//           phi_with(s, life_phi_n(), life_phi_dim(), life_phi_nbins()).
fn phi_default(state: int) -> float {
    return phi_with(state, life_phi_n(), life_phi_dim(), life_phi_nbins())
}


// ── phi_with — explicit-param override ────────────────────────────────────────
// Measure spatial IIT Φ of a flat (n × dim) farr `state` with caller-chosen
// n / dim / n_bins. Used by sweeps (e.g. infra_phi_n_bins n_bins sweep, or any
// H that varies lattice size). Delegates to c_measure_phi → RFC 036 phi_spatial.
fn phi_with(state: int, n: int, dim: int, n_bins: int) -> float {
    return c_measure_phi(state, n, dim, n_bins)
}


// ── phi_determinism_check — re-run byte-identical harness (raw#9) ──────────────
// Given a pre-built flat `state` farr (n × dim), measure Φ twice with the
// LIFE-lane defaults and assert byte-identical results. Returns a record so the
// caller can both branch (`ok`) and report the two values verbatim. Pure: does
// NOT free `state` (the caller owns it).
fn phi_determinism_check(state: int, n: int, dim: int, n_bins: int) {
    let phi_a = phi_with(state, n, dim, n_bins)
    let phi_b = phi_with(state, n, dim, n_bins)
    return #{
        "phi_a": phi_a,
        "phi_b": phi_b,
        "byte_equal": phi_a == phi_b,
        "ok": phi_a == phi_b && phi_a >= 0.0
    }
}
