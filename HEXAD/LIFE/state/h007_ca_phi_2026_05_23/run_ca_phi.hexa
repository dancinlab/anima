// HEXAD/LIFE/state/h007_ca_phi_2026_05_23/run_ca_phi.hexa
// H_007 — cellular automaton consciousness · CA → IIT Φ smoke (raw#12).
//
//   Question: do generic CA dynamics give rise to integrated information
//   Φ > 0, and does Wolfram Class IV (edge-of-chaos / Langton λ) yield
//   HIGHER Φ than ordered (Class I/II) or chaotic (Class III) rules?
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - 1D elementary CA, length-N periodic lattice, evolved T steps.
//     - 3 rule CLASSES, each a representative elementary rule:
//         ordered  = rule 250 (Class II, simple periodic fill)
//         chaotic  = rule 30  (Class III, pseudo-random)
//         class_iv = rule 110 (Class IV, Turing-universal complex)
//     - Each lattice site i = one IIT "cell"; its `dim`-dim state vector =
//       its recorded temporal trajectory (binary 0/1) over `dim` steps
//       after a `warm` warmup. The (N × dim) flat farr is fed to RFC 036
//       `phi_spatial` (= phi_rs compute_phi_inner spatial slice) → Φ ≥ 0.
//     - Fixed deterministic initial conditions (REP_SEEDS), Φ averaged
//       over reps for a stable per-class ranking.
//
//   Verdict (pre-registered): PASS iff Φ(Class-IV) > Φ(ordered) AND
//   Φ(Class-IV) > Φ(chaotic) AND all Φ ≥ 0; else FAIL (documented).
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → RFC 036 phi_spatial, byte-equal phi_rs replica).
//   Distinct from H_157 (Law 76 panpsychism META-CA fixed-point
//   Ψ(1/2,1/2) softmax-mixture proxy) — this H_007 is GENERIC CA dynamics,
//   NOT the universal-attractor / panpsychism claim.
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a8db35aa6caeacbba/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────
fn _N() -> int    { return 16 }   // lattice length (periodic)
fn _DIM() -> int  { return 12 }   // recorded temporal-trajectory length / cell
fn _WARM() -> int { return 8 }    // warmup steps before recording
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a8db35aa6caeacbba/HEXAD/LIFE/state/h007_ca_phi_2026_05_23"
}

// ── small int helpers (kept tiny — hexa big-int multiply is fragile) ──────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r          // pattern index 0..7
    return (rule / _pow2(idx)) % 2        // extract bit idx of rule
}

// deterministic initial row for a given rep: site i set iff (i + rep) % 3 != 0.
// (fixed, overflow-free, gives every rule the SAME non-trivial substrate.)
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record each site's trajectory of
// `dim` steps (after `warm` warmup) into states[ site*dim + t ]. returns farr.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        // compute next row (periodic boundary)
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// mean Φ for a rule over the fixed rep-seed set.
fn _mean_phi(rule: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let nbins = c_phi_n_bins_default()
    // fixed deterministic reps (init offsets); count = 5.
    let reps = 5
    let mut sum = 0.0
    let mut rep = 0
    while rep < reps {
        let s = _run_ca(rule, n, dim, warm, rep)
        let phi = c_measure_phi(s, n, dim, nbins)
        sum = sum + phi
        let _ = farr_free(s)
        rep = rep + 1
    }
    return sum / 5.0
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_007 — cellular automaton consciousness · CA → IIT Φ smoke (raw#12)")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + " reps=5  (deterministic, $0 mac local)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.)")
    println("")

    // representative elementary rule per Wolfram class.
    let rule_ord = 250   // Class II — ordered, simple periodic fill
    let rule_cha = 30    // Class III — chaotic / pseudo-random
    let rule_iv  = 110   // Class IV — complex, Turing-universal (edge-of-chaos)

    let phi_ord = _mean_phi(rule_ord)
    let phi_cha = _mean_phi(rule_cha)
    let phi_iv  = _mean_phi(rule_iv)

    println("  Φ(rule 250  ordered  Class-II ) = " + to_string(phi_ord))
    println("  Φ(rule 30   chaotic  Class-III) = " + to_string(phi_cha))
    println("  Φ(rule 110  Class-IV complex  ) = " + to_string(phi_iv))
    println("")

    // ── falsifiers (pre-registered, measurable) ──────────────────────────
    let f1 = phi_iv >= 0.0 && phi_ord >= 0.0 && phi_cha >= 0.0   // F1 NONNEG
    let f2 = phi_iv > phi_ord                                    // F2 IV>ORD
    let f3 = phi_iv > phi_cha                                    // F3 IV>CHA
    let f4 = phi_iv > 0.0                                        // F4 IV>0
    // F5 SEPARATION: Class-IV margin over the LARGER of the other two > 1e-6
    let other_max = if phi_ord > phi_cha { phi_ord } else { phi_cha }
    let margin = phi_iv - other_max
    let f5 = margin > 0.000001

    println("  F1 NONNEG  (all Φ>=0)            : " + _bool_str(f1))
    println("  F2 IV>ORD  (Φiv>Φord)            : " + _bool_str(f2) + "  (Δ=" + to_string(phi_iv - phi_ord) + ")")
    println("  F3 IV>CHA  (Φiv>Φcha)            : " + _bool_str(f3) + "  (Δ=" + to_string(phi_iv - phi_cha) + ")")
    println("  F4 IV>0    (Φiv>0)               : " + _bool_str(f4))
    println("  F5 SEPARATION (margin>1e-6)      : " + _bool_str(f5) + "  (margin=" + to_string(margin) + ")")

    let pass = f1 && f2 && f3 && f4 && f5
    let verdict = _verdict(pass)
    println("")
    println("  VERDICT_RULE: PASS iff Φ(IV) > Φ(ord) AND Φ(IV) > Φ(cha) AND all Φ>=0")
    println("  VERDICT     : " + verdict)

    // ── write result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_007\",\n"
    j = j + "  \"slug\": \"cellular-automaton-consciousness\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"reps\": 5, \"n_bins\": " + to_string(c_phi_n_bins_default()) + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"rules\": { \"ordered\": 250, \"chaotic\": 30, \"class_iv\": 110 },\n"
    j = j + "  \"wolfram_class\": { \"250\": \"II\", \"30\": \"III\", \"110\": \"IV\" },\n"
    j = j + "  \"phi_mean\": {\n"
    j = j + "    \"ordered_rule250\": " + to_string(phi_ord) + ",\n"
    j = j + "    \"chaotic_rule30\": " + to_string(phi_cha) + ",\n"
    j = j + "    \"class_iv_rule110\": " + to_string(phi_iv) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_NONNEG\": { \"metric\": \"all Φ>=0\", \"verdict\": \"" + _verdict(f1) + "\" },\n"
    j = j + "    \"F2_IV_GT_ORD\": { \"metric\": \"Φ(IV)-Φ(ord)\", \"delta\": " + to_string(phi_iv - phi_ord) + ", \"verdict\": \"" + _verdict(f2) + "\" },\n"
    j = j + "    \"F3_IV_GT_CHA\": { \"metric\": \"Φ(IV)-Φ(cha)\", \"delta\": " + to_string(phi_iv - phi_cha) + ", \"verdict\": \"" + _verdict(f3) + "\" },\n"
    j = j + "    \"F4_IV_POS\": { \"metric\": \"Φ(IV)>0\", \"value\": " + to_string(phi_iv) + ", \"verdict\": \"" + _verdict(f4) + "\" },\n"
    j = j + "    \"F5_SEPARATION\": { \"metric\": \"Φ(IV)-max(Φ_ord,Φ_cha)\", \"margin\": " + to_string(margin) + ", \"floor\": 0.000001, \"verdict\": \"" + _verdict(f5) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"PASS iff Φ(IV)>Φ(ord) AND Φ(IV)>Φ(cha) AND all Φ>=0; else FAIL\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_007 CA→Φ smoke complete: " + verdict + " ===")
}
