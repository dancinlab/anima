          + ", \"verdict\": \"" + _verdict(c2) + "\" },\n"
    j = j + "    \"C3_ACORR_RANK\":        { \"ac_184\": " + to_string(ac_184)
          + ", \"ac_60\": " + to_string(ac_60)
