          + ", \"any_distinct\": " + _bool_str(p_distinct_any) + " }\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_RULE184_OSCILLATING\":  \"" + _verdict(!f1) + "\",\n"
    j = j + "    \"F2_XOR_MONOTONE\":         \"" + _verdict(!f2) + "\",\n"
    j = j + "    \"F3_ACORR_INVERSION\":      \"" + _verdict(!f3) + "\",\n"
