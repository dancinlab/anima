          + ", \"184>60\": " + _bool_str(c3_60)
          + ", \"184>102\": " + _bool_str(c3_102)
          + ", \"verdict\": \"" + _verdict(c3) + "\" },\n"
    j = j + "    \"C4_BYTE_IDENT\":        { \"verdict\": \"" + _verdict(c4) + "\" },\n"
    j = j + "    \"C_PEAK_DISTINCT\":      { \"peak_184\": " + to_string(peak_184)
          + ", \"peak_60\": " + to_string(peak_60)
