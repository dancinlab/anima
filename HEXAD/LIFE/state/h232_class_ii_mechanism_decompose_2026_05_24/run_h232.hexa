// HEXAD/LIFE/state/h232_class_ii_mechanism_decompose_2026_05_24/run_h232.hexa
// H_232 — Class-II family Φ-peak mechanism decompose (H_225 follow-up · raw#12).
//
//   Question (H_225 follow-up): H_225 의 broad FALSIFIED 안에서 C3 STRONG PASS:
//   rule 184=1.198 · rule 60/102=1.683 모두 rule 110=0.556 능가. 그러나 rule
//   60/102 가 rule 184 보다 40% 더 높음. "TASEP shift" 한 가지 mechanism 으로
//   설명 불가. 본 cycle 의 hypothesis:
//
//     - rule 184 의 high-Φ = TASEP-shift (information conservation via 1D traffic)
//     - rule 60/102 의 더-high-Φ = XOR-additive (information cancellation+recomb.)
//   서로 *다른* mechanism — substrate-level distinguishing signature 찾기.
//
//   Predictions:
//     H232.1 rule 184 의 Φ trajectory 가 monotone non-decreasing (TASEP cons.)
//     H232.2 rule 60/102 의 Φ trajectory 가 oscillating (XOR period 정합)
//     H232.3 rule 184 autocorr lag-1 > rule 60/102 lag-1 (shift persistence)
//     H232.4 3 rule Φ peak 시점 다름 (mechanism 분리 evidence)
//     H232.5 re-run byte-identical (raw#12)
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none) — H_225 와
//   동일 substrate (N=16, dim=12, warm=8, periodic boundary, RFC 036
//   phi_spatial) 위 trajectory-shape 측정. 3 rules: 184 (TASEP) · 60/102
//   (XOR-shift). 20-step trajectory 각 step 에서 Φ(t) 측정 → monotone-fit R²
//   (least-squares linear regression on (t, Φ_t)) + autocorrelation lag-1 +
//   oscillation strength (signed-diff sign-change density via FFT-equivalent
//   measure).
//
//   Verdict:
//     SUPPORTED  iff C1 (rule 184 monotone R² ≥ 0.7) ∧ C2 (rule 60/102 oscillating)
//     PARTIAL    iff C1 ∨ C2 (단독)
//     FALSIFIED  otherwise.
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa.
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a1ce056ddf916a3f5/HEXAD/C/c_lib.hexa"

// ── config (deterministic, identical to H_225 / H_007 / H_211) ─────────
fn _N() -> int          { return 16 }   // lattice length (periodic)
fn _DIM() -> int        { return 12 }   // recorded trajectory dim / cell
fn _WARM() -> int       { return 8 }    // warmup steps before recording
fn _TRAJ_LEN() -> int   { return 20 }   // 20-step Φ trajectory
fn _REPS() -> int       { return 5 }    // deterministic init offsets
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a1ce056ddf916a3f5/HEXAD/LIFE/state/h232_class_ii_mechanism_decompose_2026_05_24"
}

// monotone-fit R² floor (C1)
fn _R2_FLOOR() -> float { return 0.7 }
// oscillation sign-change density floor (C2) — 50% 이상 sign-change → oscillating
fn _OSC_FLOOR() -> float { return 0.3 }

// ── small int helpers ───────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row for a given rep: site i on iff (i+rep)%3 != 0
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// run CA for one rep, returning the dim-step trajectory after warmup as
// an (n × dim) flat farr (same packing as _run_ca in H_225).
fn _run_ca_states(row: int, rule: int, n: int, dim: int) -> int {
    let states = farr_zeros(n * dim)
    let mut t = 0
    while t < dim {
        // record current row at column t
        let mut s = 0
        while s < n {
            let _ = farr_set(states, s * dim + t, farr_get(row, s))
            s = s + 1
        }
        // step CA
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        t = t + 1
    }
    return states
}

// warmup helper: evolve row in-place for `warm` steps
fn _warmup(row: int, rule: int, n: int, warm: int) -> int {
    let mut step = 0
    while step < warm {
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    return 1
}

// Φ trajectory for one rule averaged over reps:
//   per step t ∈ [0, _TRAJ_LEN()), compute Φ on the trajectory of length
//   `_DIM()` starting from the warmed-up state advanced by `t` steps.
// returns a farr of length _TRAJ_LEN().
fn _phi_trajectory(rule: int) -> int {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let nbins = c_phi_n_bins_default()
    let reps = _REPS()
    let tlen = _TRAJ_LEN()

    let traj = farr_zeros(tlen)
    let mut t = 0
    while t < tlen {
        let mut sum_phi = 0.0
        let mut rep = 0
        while rep < reps {
            // (re-)build the warmed-up + t-step-advanced row deterministically
            let row = farr_zeros(n)
            let _ = _init_row(row, n, rep)
            let _ = _warmup(row, rule, n, warm)
            // additional t-step advance (so t=0 measures right after warmup)
            let _ = _warmup(row, rule, n, t)
            // collect dim-step trajectory starting here
            let s = _run_ca_states(row, rule, n, dim)
            let phi = c_measure_phi(s, n, dim, nbins)
            sum_phi = sum_phi + phi
            let _ = farr_free(s)
            let _ = farr_free(row)
            rep = rep + 1
        }
        let _ = farr_set(traj, t, sum_phi / 5.0)
        t = t + 1
    }
    return traj
}

// ── trajectory metrics ──────────────────────────────────────────────────

// mean of farr length n
fn _mean(h: int, n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + farr_get(h, i); i = i + 1 }
    return s / (1.0 * n)
}

// variance of farr length n (population)
fn _var(h: int, n: int) -> float {
    let m = _mean(h, n)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = farr_get(h, i) - m
        s = s + d * d
        i = i + 1
    }
    return s / (1.0 * n)
}

// linear-regression R² of (t, y_t):  y_t = a*t + b, R² = 1 - SS_res/SS_tot.
//   t goes 0..n-1 deterministically.
fn _r2_linear_fit(y: int, n: int) -> float {
    // mean of t and y
    let mut sum_t = 0.0
    let mut sum_y = 0.0
    let mut i = 0
    while i < n {
        sum_t = sum_t + (1.0 * i)
        sum_y = sum_y + farr_get(y, i)
        i = i + 1
    }
    let mt = sum_t / (1.0 * n)
    let my = sum_y / (1.0 * n)

    // slope a = cov(t,y) / var(t); intercept b = my - a*mt
    let mut cov = 0.0
    let mut vt = 0.0
    i = 0
    while i < n {
        let dt = (1.0 * i) - mt
        let dy = farr_get(y, i) - my
        cov = cov + dt * dy
        vt  = vt  + dt * dt
        i = i + 1
    }
    if vt <= 0.0 { return 0.0 }
    let a = cov / vt
    let b = my - a * mt

    // SS_res, SS_tot
    let mut ss_res = 0.0
    let mut ss_tot = 0.0
    i = 0
    while i < n {
        let yi = farr_get(y, i)
        let pr = a * (1.0 * i) + b
        let r  = yi - pr
        ss_res = ss_res + r * r
        let dt = yi - my
        ss_tot = ss_tot + dt * dt
        i = i + 1
    }
    if ss_tot <= 0.0 { return 1.0 }      // degenerate constant series ⇒ perfect "fit"
    return 1.0 - (ss_res / ss_tot)
}

// monotone non-decreasing fraction: count(diff_i >= 0) / (n - 1)
fn _monotone_nondec_frac(y: int, n: int) -> float {
    if n < 2 { return 1.0 }
    let mut nd = 0
    let mut i = 1
    while i < n {
        if farr_get(y, i) >= farr_get(y, i - 1) { nd = nd + 1 }
        i = i + 1
    }
    return (1.0 * nd) / (1.0 * (n - 1))
}

// sign-change density of first differences — proxy for oscillation strength
// (Wiener-Khinchin spectral peak at non-zero freq corresponds to high
//  sign-change density of Δy_t).
fn _sign_change_density(y: int, n: int) -> float {
    if n < 3 { return 0.0 }
    // compute diffs
    let d = farr_zeros(n - 1)
    let mut i = 1
    while i < n {
        let _ = farr_set(d, i - 1, farr_get(y, i) - farr_get(y, i - 1))
        i = i + 1
    }
    // count sign changes (strict; zero-diffs treated as continuation)
    let mut sc = 0
    let mut last_sign = 0   // -1, 0, +1
    let mut j = 0
    while j < n - 1 {
        let v = farr_get(d, j)
        let mut sg = 0
        if v > 0.000001  { sg = 1 }
        if v < -0.000001 { sg = -1 }
        if sg != 0 {
            if last_sign != 0 {
                if sg != last_sign { sc = sc + 1 }
            }
            last_sign = sg
        }
        j = j + 1
    }
    let _ = farr_free(d)
    return (1.0 * sc) / (1.0 * (n - 2))
}

// autocorrelation at lag 1: corr(y_{t}, y_{t-1}) / Var(y)
fn _autocorr_lag1(y: int, n: int) -> float {
    if n < 2 { return 0.0 }
    let m = _mean(y, n)
    let mut num = 0.0
    let mut den = 0.0
    let mut i = 0
    while i < n {
        let d = farr_get(y, i) - m
        den = den + d * d
        if i >= 1 {
            num = num + (farr_get(y, i) - m) * (farr_get(y, i - 1) - m)
        }
        i = i + 1
    }
    if den <= 0.0 { return 1.0 }      // constant series ⇒ trivially "fully correlated"
    return num / den
}

// index of maximum element (peak time)
fn _argmax(h: int, n: int) -> int {
    if n <= 0 { return -1 }
    let mut best_i = 0
    let mut best_v = farr_get(h, 0)
    let mut i = 1
    while i < n {
        let v = farr_get(h, i)
        if v > best_v { best_v = v; best_i = i }
        i = i + 1
    }
    return best_i
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_232 — Class-II Φ-peak mechanism decompose · TASEP vs XOR (raw#12)")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + " traj_len=" + to_string(_TRAJ_LEN())
            + " reps=" + to_string(_REPS()) + "  (deterministic, $0 mac local)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.)")
    println("")

    let rule_184 = 184          // Class-II — TASEP traffic shift
    let rule_60  = 60           // Class-II — XOR-shift L (Sierpinski)
    let rule_102 = 102          // Class-II — XOR-shift R (Sierpinski mirror)

    let traj_184 = _phi_trajectory(rule_184)
    let traj_60  = _phi_trajectory(rule_60)
    let traj_102 = _phi_trajectory(rule_102)

    let tlen = _TRAJ_LEN()

    // ── per-rule trajectory printouts ─────────────────────────────────────
    println("  rule 184 (TASEP shift) Φ trajectory:")
    let mut t = 0
    while t < tlen {
        println("    t=" + to_string(t) + "  Φ=" + to_string(farr_get(traj_184, t)))
        t = t + 1
    }
    println("")
    println("  rule 60  (XOR-shift L) Φ trajectory:")
    t = 0
    while t < tlen {
        println("    t=" + to_string(t) + "  Φ=" + to_string(farr_get(traj_60, t)))
        t = t + 1
    }
    println("")
    println("  rule 102 (XOR-shift R) Φ trajectory:")
    t = 0
    while t < tlen {
        println("    t=" + to_string(t) + "  Φ=" + to_string(farr_get(traj_102, t)))
        t = t + 1
    }
    println("")

    // ── metrics ───────────────────────────────────────────────────────────
    let r2_184 = _r2_linear_fit(traj_184, tlen)
    let r2_60  = _r2_linear_fit(traj_60,  tlen)
    let r2_102 = _r2_linear_fit(traj_102, tlen)

    let mono_184 = _monotone_nondec_frac(traj_184, tlen)
    let mono_60  = _monotone_nondec_frac(traj_60,  tlen)
    let mono_102 = _monotone_nondec_frac(traj_102, tlen)

    let osc_184 = _sign_change_density(traj_184, tlen)
    let osc_60  = _sign_change_density(traj_60,  tlen)
    let osc_102 = _sign_change_density(traj_102, tlen)

    let ac_184 = _autocorr_lag1(traj_184, tlen)
    let ac_60  = _autocorr_lag1(traj_60,  tlen)
    let ac_102 = _autocorr_lag1(traj_102, tlen)

    let peak_184 = _argmax(traj_184, tlen)
    let peak_60  = _argmax(traj_60,  tlen)
    let peak_102 = _argmax(traj_102, tlen)

    println("  rule signature summary (rule · R²_lin · monotone_frac · sign_chg_dens · autocorr_lag1 · peak_t):")
    println("    184  R²=" + to_string(r2_184)
            + "  mono_nd=" + to_string(mono_184)
            + "  sign_chg=" + to_string(osc_184)
            + "  acorr1=" + to_string(ac_184)
            + "  peak_t=" + to_string(peak_184))
    println("    60   R²=" + to_string(r2_60)
            + "  mono_nd=" + to_string(mono_60)
            + "  sign_chg=" + to_string(osc_60)
            + "  acorr1=" + to_string(ac_60)
            + "  peak_t=" + to_string(peak_60))
    println("    102  R²=" + to_string(r2_102)
            + "  mono_nd=" + to_string(mono_102)
            + "  sign_chg=" + to_string(osc_102)
            + "  acorr1=" + to_string(ac_102)
            + "  peak_t=" + to_string(peak_102))
    println("")

    // ── criteria ──────────────────────────────────────────────────────────
    // C1: rule 184 monotone (R² >= 0.7 on increasing fit AND slope effectively ≥ 0 via mono_nd >= 0.7)
    let c1 = r2_184 >= _R2_FLOOR() && mono_184 >= 0.7
    println("  C1 RULE184_MONOTONE (R² >= " + to_string(_R2_FLOOR())
            + " ∧ mono_nd >= 0.7): " + _bool_str(c1)
            + "  (R²=" + to_string(r2_184) + " · mono_nd=" + to_string(mono_184) + ")")

    // C2: rule 60/102 oscillating (sign_change_density >= OSC_FLOOR for both)
    let c2_60 = osc_60 >= _OSC_FLOOR()
    let c2_102 = osc_102 >= _OSC_FLOOR()
    let c2 = c2_60 && c2_102
    println("  C2 XOR_OSCILLATING (sign_chg >= " + to_string(_OSC_FLOOR())
            + ", both): " + _bool_str(c2)
            + "  (60 osc=" + to_string(osc_60) + " in=" + _bool_str(c2_60)
            + " · 102 osc=" + to_string(osc_102) + " in=" + _bool_str(c2_102) + ")")

    // C3: autocorr lag-1 ranking: 184 > 60 AND 184 > 102
    let c3_60  = ac_184 > ac_60
    let c3_102 = ac_184 > ac_102
    let c3 = c3_60 && c3_102
    println("  C3 ACORR_RANK (ac_184 > ac_60 ∧ ac_184 > ac_102): " + _bool_str(c3)
            + "  (184>60=" + _bool_str(c3_60) + " · 184>102=" + _bool_str(c3_102) + ")")

    // C4: byte-identical contract (deterministic re-run = checked externally
    //   via diff(run1, run2) on the JSON ledger and stdout; smoke marks
    //   deterministic = true and the contract is structural).
    let c4 = true

    // C5 (informational): peak-time mechanism separation — 3 rule peak_t set 의 unique 개수 ≥ 2
    let p_distinct_184_60  = peak_184 != peak_60
    let p_distinct_184_102 = peak_184 != peak_102
    let p_distinct_any = p_distinct_184_60 || p_distinct_184_102
    println("  C-PEAK_DISTINCT (peak_t differs across rules): " + _bool_str(p_distinct_any)
            + "  (184=" + to_string(peak_184) + " · 60=" + to_string(peak_60)
            + " · 102=" + to_string(peak_102) + ")")

    // ── F1-F5 falsifiers (pre-registered) ─────────────────────────────────
    let f1 = osc_184 >= _OSC_FLOOR()                     // rule 184 oscillating (against H232.1)
    let f2 = mono_60 >= 0.9 && mono_102 >= 0.9           // rule 60/102 monotone (against H232.2)
    let f3 = ac_184 < ac_60 && ac_184 < ac_102           // autocorr ranking inversion
    let f4 = false                                       // byte-diff (external diff)
    // F5: Φ NaN — proxy via "non-finite": any Φ < 0 OR Φ > 1e6 (phi_spatial NaN-policy)
    let mut f5 = false
    t = 0
    while t < tlen {
        let v184 = farr_get(traj_184, t)
        let v60  = farr_get(traj_60,  t)
        let v102 = farr_get(traj_102, t)
        if v184 < 0.0 || v184 > 1000000.0 { f5 = true }
        if v60  < 0.0 || v60  > 1000000.0 { f5 = true }
        if v102 < 0.0 || v102 > 1000000.0 { f5 = true }
        t = t + 1
    }

    println("")
    println("  F1 RULE184_OSCILLATING (osc_184 >= OSC_FLOOR): " + _bool_str(f1))
    println("  F2 XOR_MONOTONE        (mono_60∧mono_102 >= 0.9): " + _bool_str(f2))
    println("  F3 ACORR_INVERSION     (ac_184 < both XOR)     : " + _bool_str(f3))
    println("  F4 BYTE_IDENT_CONTRACT (det re-run)            : " + _bool_str(!f4))
    println("  F5 PHI_NONFINITE       (Φ < 0 ∨ Φ > 1e6)        : " + _bool_str(f5))

    // ── compound verdict ──────────────────────────────────────────────────
    //   SUPPORTED  iff C1 ∧ C2 (TASEP monotone + XOR oscillating — both signatures present)
    //   PARTIAL    iff C1 ⊕ C2 (only one signature; mechanism distinction partial)
    //   FALSIFIED  otherwise.
    let supported = c1 && c2
    let partial   = (c1 || c2) && !(c1 && c2)
    let mut verdict = "FALSIFIED"
    if supported { verdict = "SUPPORTED" }
    else { if partial { verdict = "PARTIAL" } }
    println("")
    println("  VERDICT_RULE: SUPPORTED iff C1∧C2 · PARTIAL iff C1⊕C2 · else FALSIFIED")
    println("  VERDICT     : " + verdict)

    // ── write result.json ─────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_232\",\n"
    j = j + "  \"slug\": \"class-ii-mechanism-decompose\",\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"traj_len\": " + to_string(_TRAJ_LEN())
          + ", \"reps\": " + to_string(_REPS())
          + ", \"n_bins\": " + to_string(c_phi_n_bins_default()) + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"rules\": { \"class_ii_tasep\": 184, \"class_ii_xor_l\": 60, \"class_ii_xor_r\": 102 },\n"
    j = j + "  \"mechanism\": { \"184\": \"TASEP shift (information conservation)\", \"60\": \"XOR-additive L (Sierpinski)\", \"102\": \"XOR-additive R (Sierpinski mirror)\" },\n"

    // trajectory dumps
    j = j + "  \"phi_trajectory\": {\n"
    j = j + "    \"rule184\": ["
    t = 0
    while t < tlen {
        if t > 0 { j = j + ", " }
        j = j + to_string(farr_get(traj_184, t))
        t = t + 1
    }
    j = j + "],\n"
    j = j + "    \"rule60\":  ["
    t = 0
    while t < tlen {
        if t > 0 { j = j + ", " }
        j = j + to_string(farr_get(traj_60, t))
        t = t + 1
    }
    j = j + "],\n"
    j = j + "    \"rule102\": ["
    t = 0
    while t < tlen {
        if t > 0 { j = j + ", " }
        j = j + to_string(farr_get(traj_102, t))
        t = t + 1
    }
    j = j + "]\n"
    j = j + "  },\n"

    j = j + "  \"metrics\": {\n"
