    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_RULE184_MONOTONE\":  { \"r2_floor\": " + to_string(_R2_FLOOR())
          + ", \"r2\": " + to_string(r2_184)
          + ", \"mono_nd\": " + to_string(mono_184)
          + ", \"verdict\": \"" + _verdict(c1) + "\" },\n"
    j = j + "    \"C2_XOR_OSCILLATING\":   { \"osc_floor\": " + to_string(_OSC_FLOOR())
          + ", \"60_osc\": " + to_string(osc_60)
