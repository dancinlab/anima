    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1∧C2; PARTIAL iff C1⊕C2; else FALSIFIED\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
