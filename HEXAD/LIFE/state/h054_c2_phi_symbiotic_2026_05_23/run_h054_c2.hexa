// ════════════════════════════════════════════════════════════════
//  HEXAD/LIFE/state/h054_c2_phi_symbiotic_2026_05_23/run_h054_c2.hexa
//
//  H_054 Cycle #2 — C2 Φ_symbiotic > Φ_sum.
//
//  Cycle #1 already verified MERGE primitive PASS (weight conserved
//  max|Δ|=0.0, 🟢 NUMERICAL). This cycle advances the Φ-side claim:
//  Margulis endosymbiosis predicts that the integrated post-merge
//  organism carries MORE integrated information than the simple sum
//  of its pre-merge isolated parts (super-additive integration —
//  candidate computational instance of the combination problem).
//
//  Sub-criteria (pre-registered):
//    C2.1  Φ_symbiotic > Φ_sum (= Φ_A + Φ_B)                            (PRIMARY)
//    C2.2  Φ_symbiotic >= max(Φ_A, Φ_B)                                 (necessary)
//    C2.3  Φ_symbiotic / Φ_sum ratio is substrate-dependent              (not universal)
//    C2.4  Φ_symbiotic finite (NaN/Inf-free; phi_spatial measurable)     (sanity)
//
//  Verdict rule:
//    PASS    = C2.1 + C2.2 + C2.4  (C2.3 observed as honest limit)
//    PARTIAL = C2.2 + C2.4 only (max-dominated, sub-additive)
//    FALSIFIED (F-C2-1) = Φ_symbiotic <= Φ_sum
//
//  Falsifiers (additive, raw#15):
//    F-C2-1: Φ_symbiotic <= Φ_sum                    → C2.1 FALSIFIED
//    F-C2-2: Φ_symbiotic <  max(Φ_A, Φ_B)            → C2.2 FALSIFIED
//    F-C2-3: Φ_symbiotic = NaN or negative           → primitive error
//    F-C2-4: re-run byte-different (non-deterministic)→ raw#9 violation
//    F-C2-5: merge primitive weight non-conservation → Cycle #1 regression
//
//  Method:
//    - deterministic, hexa-only, $0 mac local, LLM none, raw#15 strict.
//    - Substrate: 2 isolated cell-pools (CA-A, CA-B), each N=8 cells,
//      d=8. Each cell evolves under H_003-style catalytic A/B/C closed
//      cycle (C→+A, A→+B, B→+C) with periodic nearest-neighbour
//      catalyst diffusion. Each pool seeded independently → two
//      distinct lineages (pre-merge organisms).
//    - Record per-cell obs = A+B+C trajectory over DIM steps WARM=4.
//    - Step 1: measure Φ_A = phi_spatial(traj_A, N=8, DIM=8, n_bins=4).
//             measure Φ_B = phi_spatial(traj_B, N=8, DIM=8, n_bins=4).
//             Φ_sum = Φ_A + Φ_B.
//    - Step 2: MERGE the two pools via H_054 Cycle #1 mass-conserving
//      primitive — pair cells 1-to-1 by index, the merged-pool's i-th
//      observable trajectory is the element-wise (1/2) linear average
//      of the corresponding A-pool[i] and B-pool[i] obs trajectories
//      (= the Φ-substrate analog of merge_cells' element-wise weight
//      averaging from B-MITOSIS-2). Cell-count IS NOT reduced — we
//      retain N=8 paired-merged cells so phi_spatial sees the same n.
//    - Step 3: measure Φ_symbiotic = phi_spatial(traj_merged, 8, 8, 4).
//      Compare against Φ_sum.
//
//  Honest tier: phi_spatial proxy = 🟢 NUMERICAL (RFC 036 spatial-slice
//  replica of phi_rs; NOT 🔵 IIT 4.0 full MIP). Mass-conserving merge
//  is the H_054 Cycle #1 primitive (B-MITOSIS-2 cross-link, 🔵 sympy).
//
//  Run:
//    HEXA_MEM_UNLIMITED=1 hexa run \
//      HEXAD/LIFE/state/h054_c2_phi_symbiotic_2026_05_23/run_h054_c2.hexa
// ════════════════════════════════════════════════════════════════

// ── n_bins identity with H_007 / H_003 H3.4 / H_171 (RFC 036 phi_spatial)
fn PHI_N_BINS() -> int { return 4 }

// ── pre-registered constants (frozen) ─────────────────────────────
fn N_CELLS() -> int       { return 8 }       // per-pool cell count
fn DIM() -> int           { return 8 }       // trajectory length per cell (post-warm)
fn WARM() -> int          { return 4 }       // warm-up steps discarded
fn CAP() -> float         { return 1.0 }
fn K_RATE() -> float      { return 0.60 }    // catalytic production constant (H_003 lineage)
fn DECAY() -> float       { return 0.10 }    // boundary leak fractional
fn DIFFUSE() -> float     { return 0.05 }    // nearest-neighbour catalyst coupling
fn SEED_A() -> int        { return 0x054C2A }  // pool A master seed
fn SEED_B() -> int        { return 0x054C2B }  // pool B master seed (distinct lineage)
fn TOL() -> float         { return 0.000001 } // 1e-6 (Cycle #1 regression check)

fn to_float(x: int) -> float { return x * 1.0 }

fn pow_i(base: int, e: int) -> int {
    let mut r = 1
    let mut i = 0
    while i < e { r = r * base; i = i + 1 }
    return r
}

fn _clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > CAP() { return CAP() }
    return x
}

fn _abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Deterministic site/component-phased initial value in [0.1, 0.5]
// (H_003 H3.4 _seed_init lineage; no RNG, fully byte-reproducible).
fn _seed_init(seed: int, site: int, comp: int) -> float {
    let shift = (comp * 8) % 24
    let bits  = (seed / pow_i(2, shift)) % 256
    let phase = (site * 37 + comp * 11) % 64
    let f = (to_float((bits + phase) % 256) + 1.0) / 257.0
    return f * 0.4 + 0.1
}

// One catalytic-production step:  X' = X + K*cat*(1 - X/CAP) - DECAY*X
fn _step_component(x: float, cat: float) -> float {
    let prod = K_RATE() * cat * (1.0 - x / CAP())
    let nx = x + prod - DECAY() * x
    return _clamp01(nx)
}

// Diffuse a per-site catalyst field across periodic nn neighbours.
fn _diffuse_field(v: int, m: int) -> int {
    let out = farr_zeros(m)
    let d = DIFFUSE()
    let mut s = 0
    while s < m {
        let lj = (s + m - 1) % m
        let rj = (s + 1) % m
        let val = (1.0 - 2.0 * d) * farr_get(v, s) + d * farr_get(v, lj) + d * farr_get(v, rj)
        let _ = farr_set(out, s, val)
        s = s + 1
    }
    return out
}

// Run a single cell-pool lattice and return its (N × DIM) obs trajectory
// (post-warm window). obs = A+B+C site mass — identical observable as H_003 H3.4.
fn _run_pool(seed: int) -> int {
    let m    = N_CELLS()
    let dim  = DIM()
    let warm = WARM()

    let A = farr_zeros(m)
    let B = farr_zeros(m)
    let C = farr_zeros(m)
    let mut s0 = 0
    while s0 < m {
        let _ = farr_set(A, s0, _seed_init(seed, s0, 0))
        let _ = farr_set(B, s0, _seed_init(seed, s0, 1))
        let _ = farr_set(C, s0, _seed_init(seed, s0, 2))
        s0 = s0 + 1
    }

    let states = farr_zeros(m * dim)
    let total  = warm + dim
    let mut step = 0
    while step < total {
        // record obs only after WARM
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < m {
                let obs = farr_get(A, s) + farr_get(B, s) + farr_get(C, s)
                let _ = farr_set(states, s * dim + t, obs)
                s = s + 1
            }
        }

        // diffuse catalysts (closed cycle: cat_A←C, cat_B←A, cat_C←B)
        let dC = _diffuse_field(C, m)
        let dA = _diffuse_field(A, m)
        let dB = _diffuse_field(B, m)

        let nA = farr_zeros(m)
        let nB = farr_zeros(m)
        let nC = farr_zeros(m)
        let mut s = 0
        while s < m {
            let cat_a = farr_get(dC, s)
            let cat_b = farr_get(dA, s)
            let cat_c = farr_get(dB, s)
            let _ = farr_set(nA, s, _step_component(farr_get(A, s), cat_a))
            let _ = farr_set(nB, s, _step_component(farr_get(B, s), cat_b))
            let _ = farr_set(nC, s, _step_component(farr_get(C, s), cat_c))
            s = s + 1
        }
        // commit
        let mut k = 0
        while k < m {
            let _ = farr_set(A, k, farr_get(nA, k))
            let _ = farr_set(B, k, farr_get(nB, k))
            let _ = farr_set(C, k, farr_get(nC, k))
            k = k + 1
        }
        let _ = farr_free(dC); let _ = farr_free(dA); let _ = farr_free(dB)
        let _ = farr_free(nA); let _ = farr_free(nB); let _ = farr_free(nC)
        step = step + 1
    }
    let _ = farr_free(A); let _ = farr_free(B); let _ = farr_free(C)
    return states
}

// Symbiotic MERGE on per-cell obs trajectories — element-wise
// linear average (1/2)*(s_A[i,t] + s_B[i,t]), 1-to-1 paired by index.
// This mirrors B-MITOSIS-2 MERGE-WEIGHT-LINEAR applied to the
// Φ-substrate observable trajectory (same operator as H_054 Cycle #1
// merge_cells' element-wise weight averaging). Cell count preserved.
fn _symbiotic_merge(traj_a: int, traj_b: int) -> int {
    let m   = N_CELLS()
    let dim = DIM()
    let merged = farr_zeros(m * dim)
    let mut i = 0
    let total = m * dim
    while i < total {
        let avg = 0.5 * (farr_get(traj_a, i) + farr_get(traj_b, i))
        let _ = farr_set(merged, i, avg)
        i = i + 1
    }
    return merged
}

// Cycle #1 regression — verify merge primitive still mass-conserving.
// Returns max |Δ| between elementwise (a+b)/2 and the merged trajectory.
fn _merge_invariant_max_dev(traj_a: int, traj_b: int, merged: int) -> float {
    let m   = N_CELLS()
    let dim = DIM()
    let mut max_dev = 0.0
    let mut i = 0
    let total = m * dim
    while i < total {
        let expected = 0.5 * (farr_get(traj_a, i) + farr_get(traj_b, i))
        let dev = _abs_f(farr_get(merged, i) - expected)
        if dev > max_dev { max_dev = dev }
        i = i + 1
    }
    return max_dev
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

// float → fixed 6dp string (deterministic, matches Cycle #1 f6 style)
fn f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = to_string(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + to_string(to_int(whole)) + "." + frac_str
}

fn _state_dir() -> string {
    return "HEXAD/LIFE/state/h054_c2_phi_symbiotic_2026_05_23"
}

fn main() {
    println("================================================================")
    println("  H_054 Cycle #2 — C2 Φ_symbiotic > Φ_sum (endosymbiosis-Φ)")
    println("  deterministic · hexa-only · $0 mac local · LLM none · raw#15")
    println("  N=" + to_string(N_CELLS()) + " DIM=" + to_string(DIM())
        + " WARM=" + to_string(WARM()) + " K=" + to_string(K_RATE())
        + " DECAY=" + to_string(DECAY()) + " DIFFUSE=" + to_string(DIFFUSE())
        + " n_bins=" + to_string(PHI_N_BINS()))
    println("  SEED_A=" + to_string(SEED_A()) + " SEED_B=" + to_string(SEED_B()))
    println("  Φ primitive: RFC 036 phi_spatial (🟢 NUMERICAL · NOT 🔵 IIT 4.0 MIP)")
    println("  MERGE primitive: H_054 Cycle #1 mass-conserving (B-MITOSIS-2 🔵 sympy carry)")
    println("================================================================")

    // ── PRE-MERGE arm 1: isolated pool A ───────────────────────────
    let traj_a = _run_pool(SEED_A())
    let phi_a  = phi_spatial(traj_a, N_CELLS(), DIM(), PHI_N_BINS())
    println("  Φ_A   (isolated pool A, seed=" + to_string(SEED_A()) + ")  = " + f6(phi_a))

    // ── PRE-MERGE arm 2: isolated pool B ───────────────────────────
    let traj_b = _run_pool(SEED_B())
    let phi_b  = phi_spatial(traj_b, N_CELLS(), DIM(), PHI_N_BINS())
    println("  Φ_B   (isolated pool B, seed=" + to_string(SEED_B()) + ")  = " + f6(phi_b))

    let phi_sum = phi_a + phi_b
    let phi_max = if phi_a > phi_b { phi_a } else { phi_b }
    println("  Φ_sum (= Φ_A + Φ_B)                                = " + f6(phi_sum))
    println("  Φ_max (= max(Φ_A, Φ_B))                            = " + f6(phi_max))

    // ── POST-MERGE: symbiotic-merged pool (H_054 mass-conserving) ──
    let traj_merged = _symbiotic_merge(traj_a, traj_b)
    let merge_max_dev = _merge_invariant_max_dev(traj_a, traj_b, traj_merged)
    let merge_conserved = merge_max_dev <= TOL()
    let phi_symbiotic = phi_spatial(traj_merged, N_CELLS(), DIM(), PHI_N_BINS())
    println("  Φ_symbiotic (post-merge integrated organism)       = " + f6(phi_symbiotic))
    println("  merge invariant max|Δ| = " + f6(merge_max_dev) + " (≤ tol=" + f6(TOL()) + ")")

    // ── determinism: re-run pool A, re-merge, re-Φ ────────────────
    let traj_a2 = _run_pool(SEED_A())
    let phi_a2 = phi_spatial(traj_a2, N_CELLS(), DIM(), PHI_N_BINS())
    let det_ok = phi_a2 == phi_a
    println("  Φ_A re-run = " + f6(phi_a2) + "  (byte-equal=" + _bool_str(det_ok) + ")")

    // ratio (substrate-dependent observation)
    let ratio = if phi_sum > 0.0 { phi_symbiotic / phi_sum } else { 0.0 }
    println("  ratio Φ_symbiotic / Φ_sum                          = " + f6(ratio))

    // ── falsifiers (pre-registered) ────────────────────────────────
    let f_c2_1 = phi_symbiotic > phi_sum              // C2.1 super-additivity
    let f_c2_2 = phi_symbiotic >= phi_max             // C2.2 max-dominance
    let f_c2_3_finite = phi_symbiotic >= 0.0           // C2.4 / F-C2-3 finite & nonneg
    let f_c2_4_det = det_ok                            // F-C2-4 determinism
    let f_c2_5_merge = merge_conserved                 // F-C2-5 Cycle #1 regression

    println("")
    println("  ----------------------------------------------------------------")
    println("  C2.1  SUPER-ADDITIVE (Φ_symbiotic > Φ_sum)   : " + _bool_str(f_c2_1)
        + "  (gap=" + f6(phi_symbiotic - phi_sum) + ")")
    println("  C2.2  MAX-DOMINANT  (Φ_symbiotic ≥ Φ_max)    : " + _bool_str(f_c2_2)
        + "  (gap=" + f6(phi_symbiotic - phi_max) + ")")
    println("  C2.4  FINITE & NONNEG (Φ_symbiotic ≥ 0)      : " + _bool_str(f_c2_3_finite))
    println("  F-C2-4 DETERMINISM    (re-run byte-equal)    : " + _bool_str(f_c2_4_det))
    println("  F-C2-5 MERGE CONSERV  (Cycle #1 regression)  : " + _bool_str(f_c2_5_merge)
        + "  (max|Δ|=" + f6(merge_max_dev) + ")")

    let mut verdict = "PARTIAL"
    let mut f_c2_1_state = "NOT_TRIGGERED"
    let mut f_c2_2_state = "NOT_TRIGGERED"
    let mut f_c2_3_state = "NOT_TRIGGERED"
    let mut f_c2_4_state = "NOT_TRIGGERED"
    let mut f_c2_5_state = "NOT_TRIGGERED"

    if !f_c2_1 { f_c2_1_state = "TRIGGERED" }
    if !f_c2_2 { f_c2_2_state = "TRIGGERED" }
    if !f_c2_3_finite { f_c2_3_state = "TRIGGERED" }
    if !f_c2_4_det { f_c2_4_state = "TRIGGERED" }
    if !f_c2_5_merge { f_c2_5_state = "TRIGGERED" }

    if f_c2_1 && f_c2_2 && f_c2_3_finite && f_c2_4_det && f_c2_5_merge {
        verdict = "PASS"
    } else {
        if !f_c2_1 {
            verdict = "FALSIFIED"
        } else {
            verdict = "PARTIAL"
        }
    }

    println("")
    println("  VERDICT_RULE: PASS = C2.1 + C2.2 + C2.4 + det + merge-conserv")
    println("  VERDICT (C2 / H54.4 strong): " + verdict)
    println("    F-C2-1(sub-add)=" + f_c2_1_state + "  F-C2-2(max-dom)=" + f_c2_2_state)
    println("    F-C2-3(finite)=" + f_c2_3_state + "  F-C2-4(det)=" + f_c2_4_state
        + "  F-C2-5(merge)=" + f_c2_5_state)
    println("  ----------------------------------------------------------------")
    println("  H54.4_C2_VERDICT=" + verdict
        + "  PHI_A=" + f6(phi_a) + "  PHI_B=" + f6(phi_b)
        + "  PHI_SUM=" + f6(phi_sum) + "  PHI_SYMBIOTIC=" + f6(phi_symbiotic))

    // ── result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_054\",\n"
    j = j + "  \"cycle\": \"Cycle_2_phi_symbiotic\",\n"
    j = j + "  \"slug\": \"symbiogenesis-consciousness\",\n"
    j = j + "  \"sub_criterion\": \"C2 — Φ_symbiotic > Φ_sum (super-additive integration)\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial RFC 036 + B-MITOSIS-2 🔵 mass-conserving merge cross-link)\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (NOT 🔵 IIT 4.0 MIP)\",\n"
    j = j + "  \"merge_primitive\": \"H_054 Cycle #1 mass-conserving linear avg ((w1+w2)/2; B-MITOSIS-2 cross-link 🔵 sympy 27/27)\",\n"
    j = j + "  \"substrate\": \"2 isolated H_003-style catalytic cell-pools (closed A/B/C cycle + nn diffusion) seeded distinctly; per-cell obs=A+B+C site mass\",\n"
    j = j + "  \"config\": {\n"
    j = j + "    \"n_cells\": " + to_string(N_CELLS()) + ",\n"
    j = j + "    \"dim\": " + to_string(DIM()) + ",\n"
    j = j + "    \"warm\": " + to_string(WARM()) + ",\n"
    j = j + "    \"K_rate\": " + to_string(K_RATE()) + ",\n"
    j = j + "    \"decay\": " + to_string(DECAY()) + ",\n"
    j = j + "    \"diffuse\": " + to_string(DIFFUSE()) + ",\n"
    j = j + "    \"n_bins\": " + to_string(PHI_N_BINS()) + ",\n"
    j = j + "    \"seed_a\": " + to_string(SEED_A()) + ",\n"
    j = j + "    \"seed_b\": " + to_string(SEED_B()) + ",\n"
    j = j + "    \"tol\": " + f6(TOL()) + "\n"
    j = j + "  },\n"
    j = j + "  \"phi\": {\n"
    j = j + "    \"phi_a_isolated\":    " + f6(phi_a) + ",\n"
    j = j + "    \"phi_b_isolated\":    " + f6(phi_b) + ",\n"
    j = j + "    \"phi_sum\":           " + f6(phi_sum) + ",\n"
    j = j + "    \"phi_max\":           " + f6(phi_max) + ",\n"
    j = j + "    \"phi_symbiotic\":     " + f6(phi_symbiotic) + ",\n"
    j = j + "    \"phi_a_rerun\":       " + f6(phi_a2) + ",\n"
    j = j + "    \"ratio_symbiotic_over_sum\": " + f6(ratio) + ",\n"
    j = j + "    \"gap_super_additive\":       " + f6(phi_symbiotic - phi_sum) + ",\n"
    j = j + "    \"gap_max_dominant\":         " + f6(phi_symbiotic - phi_max) + "\n"
    j = j + "  },\n"
    j = j + "  \"merge_invariant_regression\": {\n"
    j = j + "    \"max_dev_obs_trajectory\": " + f6(merge_max_dev) + ",\n"
    j = j + "    \"tol\":                   " + f6(TOL()) + ",\n"
    j = j + "    \"conserved\":             " + to_string(merge_conserved) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F_C2_1_super_additive\":   { \"metric\": \"Φ_symbiotic > Φ_sum\",        \"verdict\": \"" + _verdict(f_c2_1) + "\", \"falsifier_state\": \"" + f_c2_1_state + "\" },\n"
    j = j + "    \"F_C2_2_max_dominant\":     { \"metric\": \"Φ_symbiotic ≥ max(Φ_A,Φ_B)\", \"verdict\": \"" + _verdict(f_c2_2) + "\", \"falsifier_state\": \"" + f_c2_2_state + "\" },\n"
    j = j + "    \"F_C2_3_finite_nonneg\":    { \"metric\": \"Φ_symbiotic ≥ 0 (no NaN)\",   \"verdict\": \"" + _verdict(f_c2_3_finite) + "\", \"falsifier_state\": \"" + f_c2_3_state + "\" },\n"
    j = j + "    \"F_C2_4_determinism\":      { \"metric\": \"re-run byte-equal\",          \"verdict\": \"" + _verdict(f_c2_4_det) + "\", \"falsifier_state\": \"" + f_c2_4_state + "\" },\n"
    j = j + "    \"F_C2_5_merge_conservation\":{ \"metric\": \"max|Δ| obs traj ≤ tol\",      \"verdict\": \"" + _verdict(f_c2_5_merge) + "\", \"falsifier_state\": \"" + f_c2_5_state + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"PASS = C2.1 (super-additive) + C2.2 (max-dominant) + C2.4 (finite) + determinism + merge-conservation; F-C2-1 TRIGGERED => FALSIFIED; max-dominant only => PARTIAL\",\n"
    j = j + "  \"verdict_class\": \"" + verdict + "\",\n"
    j = j + "  \"criterion\": \"C2 (Φ_symbiotic > Φ_sum; strong form of H54.4)\",\n"
    j = j + "  \"cross_link\": {\n"
    j = j + "    \"cycle_1\": \"H_054 Cycle #1 (MERGE primitive PASS, weight max|Δ|=0.0 🟢)\",\n"
    j = j + "    \"phi_primitive_origin\": \"H_007 / H_003 H3.4 / H_171 — RFC 036 phi_spatial baseline\",\n"
    j = j + "    \"sister_H\": \"H_203 (asymmetric-merge differentiation), H_204 (parallel-firing weak-panpsy threshold), H_157 (combination problem)\"\n"
    j = j + "  },\n"
    j = j + "  \"honest_limits\": [\n"
    j = j + "    \"L-C2-1: phi_spatial proxy is 🟢 NUMERICAL (RFC 036 spatial-slice replica of phi_rs with n_bins=4), NOT 🔵 IIT 4.0 full MIP / cause-effect structure / exclusion. 'Φ' here = production Φ-ratchet input, not canonical IIT Φ.\",\n"
    j = j + "    \"L-C2-2: merge operationalization = element-wise linear average (0.5*(s_A[i,t]+s_B[i,t])) on obs trajectories — the H_054 Cycle #1 mass-conserving primitive (B-MITOSIS-2). Alternative merge primitives (asymmetric/keeper-preserve = H_203 sister; max-pool; multiplicative) would yield different Φ patterns and are not tested here.\",\n"
    j = j + "    \"L-C2-3: pre-merge 'isolated' = two distinct seeds on the SAME lattice geometry. Truly disconnected substrate (separate physical lattices with their own diffusion topology) is a stronger isolation; here we use seed-divergence as the operationalization (cheap proxy).\",\n"
    j = j + "    \"L-C2-4: super-additivity (Φ_symbiotic > Φ_sum) — even if observed — does NOT entail phenomenal binding (H_004 hard problem boundary carries unchanged); IIT super-additivity is necessary, not sufficient for unified macro-consciousness.\",\n"
    j = j + "    \"L-C2-5: small substrate (N=8 cells × DIM=8 steps × n_bins=4) — endosymbiotic real-organism scale (eukaryote ≥ 10^13 mitochondria) is many orders out; this is a toy substrate sanity probe, NOT a scaling claim.\",\n"
    j = j + "    \"L-C2-6: ratio Φ_symbiotic/Φ_sum substrate-dependent — running C2 on different lattice topologies/coupling/seed-base yields different ratios. The numerical value reported here is one (frozen) substrate instance, not a universal constant.\",\n"
    j = j + "    \"L-C2-7: single-cycle one-shot — no multi-seed averaging across (SEED_A,SEED_B) pairs. A robust effect would require ≥5 seed-pair sweep; this is a single deterministic measurement (cheap-path 🟢).\"\n"
    j = j + "  ]\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    let _ = farr_free(traj_a)
    let _ = farr_free(traj_b)
    let _ = farr_free(traj_a2)
    let _ = farr_free(traj_merged)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_054 Cycle #2 C2 Φ_symbiotic smoke complete: " + verdict + " ===")
}

