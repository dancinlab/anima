//     - derive prime gaps gap_i = p_{i+1} - p_i.
//     - generate matched-(mean,var) RANDOM gap sequence via fixed LCG
//       (deterministic seed=20260523) rescaled to mean/var match.
//     - generate ARITHMETIC PROGRESSION (AP) gap sequence as the gap-of
//       odd-only sequence (2k+1), i.e. constant 2 — pure-periodic baseline.
//     - encode each gap sequence into a flat farr (n_cells × dim) substrate
//       using sliding-window binning (gap_bin_count=8): each cell i carries
//       a dim=8 trajectory of normalized gap values gaps[i..i+7] mapped to
//       [0,1] via uniform binning over the per-sequence [min,max].
//     - feed each substrate to RFC 036 phi_spatial via HEXAD/C/c_lib.hexa
//       c_measure_phi → 6 Φ measurements (3 sequences × 2 prime_counts).
//     - compute mean/var matching residuals + simple autocorrelation proxy
//       (FFT primitive 부재 → autocorr_lag1 사용, long-range correlation
//       directional indicator) for H208.3.
//
//   Verdict (pre-registered, see md C1..C4):
//     SUPPORTED if (C1 Φ_prime > Φ_random + 5%) AND (C3 Φ_prime > 0, no NaN)
//                AND (one of C2 Φ_prime ≠ Φ_AP margin ≥ 5% / C4 scale ratio
//                differs by ≥ 5%); FALSIFIED if Φ_prime ≤ Φ_random.
//
//   Sister: H_157 (Law 76 mathematical panpsychism, perfect-number σ-identity
//   precedent). Distinct: H_157 = META-CA universal attractor Ψ(1/2,1/2);
//   H_208 = number-theoretic prime structure → Φ contribution.
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a8f6f4f5975e0a6b2/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────
fn _DIM() -> int          { return 8 }   // gap_bin_count == sliding-window length
fn _LCG_SEED() -> int     { return 20260523 } // deterministic seed (date)
fn _MARGIN() -> float     { return 0.05 } // 5% margin for C1/C2/C4
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a8f6f4f5975e0a6b2/HEXAD/LIFE/state/h208_prime_density_2026_05_23"
}

// ── prime sieve (deterministic, overflow-free for first 64 primes) ──────
// returns farr of first `k` primes. Sieve of Eratosthenes up to bound.
fn _first_k_primes(k: int) -> int {
    // upper bound for the k-th prime (Rosser 1941): p_k < k * (ln k + ln ln k)
    // for k ≥ 6. For k ≤ 64 a safe bound = 400 (p_64 = 311 < 400).
    let bound = 400
    let composite = farr_zeros(bound + 1)
    // composite[0]=composite[1]=1 (treat as composite/non-prime)
    let _0 = farr_set(composite, 0, 1.0)
    let _1 = farr_set(composite, 1, 1.0)
    let mut i = 2
    while i <= bound {
        if farr_get(composite, i) < 0.5 {
            let mut j = i * i
            while j <= bound {
                let _ = farr_set(composite, j, 1.0)
                j = j + i
            }
        }
        i = i + 1
    }
    let primes = farr_zeros(k)
    let mut count = 0
    let mut n = 2
    while count < k && n <= bound {
        if farr_get(composite, n) < 0.5 {
            let _ = farr_set(primes, count, to_float(n))
            count = count + 1
        }
        n = n + 1
    }
    let _free = farr_free(composite)
    return primes
}

// ── gap sequence from prime farr ────────────────────────────────────────
// returns farr of length k-1 with gap[i] = primes[i+1] - primes[i].
fn _prime_gaps(primes: int, k: int) -> int {
    let gaps = farr_zeros(k - 1)
    let mut i = 0
    while i < k - 1 {
        let g = farr_get(primes, i + 1) - farr_get(primes, i)
        let _ = farr_set(gaps, i, g)
        i = i + 1
    }
    return gaps
}

// mean of a farr of length n
fn _mean(a: int, n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + farr_get(a, i); i = i + 1 }
    return s / to_float(n)
}

// variance (population) of a farr of length n
fn _var(a: int, n: int) -> float {
    let mu = _mean(a, n)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = farr_get(a, i) - mu
        s = s + d * d
        i = i + 1
    }
    return s / to_float(n)
}

// min/max helpers
fn _min(a: int, n: int) -> float {
    let mut m = farr_get(a, 0)
    let mut i = 1
    while i < n {
        let v = farr_get(a, i)
        if v < m { m = v }
        i = i + 1
    }
    return m
}
fn _max(a: int, n: int) -> float {
    let mut m = farr_get(a, 0)
    let mut i = 1
    while i < n {
        let v = farr_get(a, i)
        if v > m { m = v }
        i = i + 1
    }
    return m
}

// ── deterministic LCG (Park-Miller minimal-standard) ────────────────────
// build a random gap sequence of length L matched to (mean_target, var_target).
// LCG state kept in a local int — Park-Miller with Schrage's algorithm to
// avoid overflow, mod 2^31 - 1.
fn _random_gaps_matched(length: int, mean_t: float, var_t: float) -> int {
    let a = 48271
    let m = 2147483647   // 2^31 - 1
    let q = 44488        // m / a
    let r = 3399         // m mod a
    let m_inv_denom = to_float(m)
    let mut state = _LCG_SEED()

    let raw = farr_zeros(length)
    let mut i = 0
    while i < length {
        // advance state via Schrage
        let hi = state / q
        let lo = state - q * hi
        state = a * lo - r * hi
        if state < 0 { state = state + m }
        let u = to_float(state) / m_inv_denom
        let _ = farr_set(raw, i, u)
        i = i + 1
    }
    // compute raw mean/std
    let mu = _mean(raw, length)
    let va = _var(raw, length)
    let std_raw = _sqrt_newton(va)
    let std_t = _sqrt_newton(var_t)
    // z-score then rescale: x_i = mean_t + (raw_i - mu) / std_raw * std_t
    let out = farr_zeros(length)
    let mut j = 0
    while j < length {
        let z = (farr_get(raw, j) - mu) / std_raw
        let v = mean_t + z * std_t
        let _ = farr_set(out, j, v)
        j = j + 1
    }
    let _f1 = farr_free(raw)
    return out
}

// Newton's-method sqrt (deterministic, 32 iterations, x ≥ 0)
fn _sqrt_newton(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    if g < 1.0 { g = 1.0 }
    let mut i = 0
    while i < 32 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

// arithmetic progression gap sequence: gaps between consecutive odd numbers
// (2k+1), which is the constant 2 — pure periodic baseline.
fn _ap_gaps(length: int) -> int {
    let out = farr_zeros(length)
    let mut i = 0
    while i < length {
        let _ = farr_set(out, i, 2.0)
        i = i + 1
    }
    return out
}

// ── encode gap sequence → (n_cells × dim) substrate via sliding window ──
// for cell i (i ∈ [0, n_cells)): state[i, k] = (gaps[i+k] - gmin) / (gmax - gmin)
// for k ∈ [0, dim). Result is a flat farr of size n_cells * dim, normalized
// to [0,1]. Requires len(gaps) ≥ n_cells + dim - 1.
fn _encode_substrate(gaps: int, gaps_len: int, n_cells: int, dim: int) -> int {
    let gmin = _min(gaps, gaps_len)
    let gmax = _max(gaps, gaps_len)
    let mut span = gmax - gmin
    if span < 1e-9 { span = 1.0 }   // AP case: all constant — encode as 0.5
    let s = farr_zeros(n_cells * dim)
    let mut i = 0
    while i < n_cells {
        let mut k = 0
        while k < dim {
            let idx = i + k
            let g = farr_get(gaps, idx)
            let mut v = (g - gmin) / span
            // AP case override: constant → 0.5 baseline
            if gmax - gmin < 1e-9 { v = 0.5 }
            let _ = farr_set(s, i * dim + k, v)
            k = k + 1
        }
        i = i + 1
    }
    return s
}

// lag-1 autocorrelation (Pearson) of a farr — long-range correlation proxy
// (FFT spectral density 직접 없음 — autocorr is the documented fallback).
fn _autocorr_lag1(a: int, n: int) -> float {
    if n < 2 { return 0.0 }
    let mu = _mean(a, n)
    let mut num = 0.0
    let mut den = 0.0
    let mut i = 0
    while i < n - 1 {
        let d0 = farr_get(a, i) - mu
        let d1 = farr_get(a, i + 1) - mu
        num = num + d0 * d1
        i = i + 1
    }
    let mut j = 0
    while j < n {
        let d = farr_get(a, j) - mu
        den = den + d * d
        j = j + 1
    }
    if den < 1e-12 { return 0.0 }
    return num / den
}

// abs of float
fn _abs(x: float) -> float { if x < 0.0 { return -x }; return x }

// ── one full measurement bundle for a given prime_count ─────────────────
// returns dict-like record (we build inline JSON string outside).
fn _measure_bundle(prime_count: int, n_cells: int) -> int {
    let primes = _first_k_primes(prime_count)
    let gap_len = prime_count - 1
    let pgaps = _prime_gaps(primes, prime_count)

    let pmean = _mean(pgaps, gap_len)
    let pvar  = _var(pgaps, gap_len)

    let rgaps = _random_gaps_matched(gap_len, pmean, pvar)
    let agaps = _ap_gaps(gap_len)

    let rmean = _mean(rgaps, gap_len)
    let rvar  = _var(rgaps, gap_len)

    let nbins = c_phi_n_bins_default()
    let dim = _DIM()

    let sp = _encode_substrate(pgaps, gap_len, n_cells, dim)
    let sr = _encode_substrate(rgaps, gap_len, n_cells, dim)
    let sa = _encode_substrate(agaps, gap_len, n_cells, dim)

    let phi_p = c_measure_phi(sp, n_cells, dim, nbins)
    let phi_r = c_measure_phi(sr, n_cells, dim, nbins)
    let phi_a = c_measure_phi(sa, n_cells, dim, nbins)

    let ac_p = _autocorr_lag1(pgaps, gap_len)
    let ac_r = _autocorr_lag1(rgaps, gap_len)

    // pack into a dict (hexa #{} literal) so caller can extract fields
    let out = #{
        "prime_count": prime_count,
        "n_cells": n_cells,
        "dim": dim,
        "gap_len": gap_len,
        "prime_mean": pmean,
        "prime_var":  pvar,
        "random_mean": rmean,
        "random_var":  rvar,
        "match_mean_residual": _abs(pmean - rmean),
        "match_var_residual":  _abs(pvar - rvar),
        "phi_prime": phi_p,
        "phi_random": phi_r,
        "phi_ap": phi_a,
        "autocorr_prime_lag1": ac_p,
        "autocorr_random_lag1": ac_r
    }

    let _ = farr_free(primes)
    let _ = farr_free(pgaps)
    let _ = farr_free(rgaps)
    let _ = farr_free(agaps)
    let _ = farr_free(sp)
    let _ = farr_free(sr)
    let _ = farr_free(sa)
    return out
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_208 — prime-density-fluctuation · Riemann × Φ math-axis (raw#12)")
    println("  hexa-only · deterministic · LLM:none · $0 mac local")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa c_measure_phi")
    println("  sister: H_157 (Law 76 mathematical panpsychism, σ-identity precedent)")
    println("")

    // two prime counts → two n_cells (windowed sliding-window encoding)
    //   prime_count=32 → gap_len=31, n_cells=16 (uses gaps[0..23])
    //   prime_count=64 → gap_len=63, n_cells=32 (uses gaps[0..39])
    let r32 = _measure_bundle(32, 16)
    let r64 = _measure_bundle(64, 32)

    // ── extract scalars ─────────────────────────────────────────────────
    let phi_p_32 = r32["phi_prime"]
    let phi_r_32 = r32["phi_random"]
    let phi_a_32 = r32["phi_ap"]
    let phi_p_64 = r64["phi_prime"]
    let phi_r_64 = r64["phi_random"]
    let phi_a_64 = r64["phi_ap"]

    let pmean_32 = r32["prime_mean"]
    let pvar_32  = r32["prime_var"]
    let pmean_64 = r64["prime_mean"]
    let pvar_64  = r64["prime_var"]

    let match_mu_32 = r32["match_mean_residual"]
    let match_va_32 = r32["match_var_residual"]
    let match_mu_64 = r64["match_mean_residual"]
    let match_va_64 = r64["match_var_residual"]

    let ac_p_32 = r32["autocorr_prime_lag1"]
    let ac_r_32 = r32["autocorr_random_lag1"]
    let ac_p_64 = r64["autocorr_prime_lag1"]
    let ac_r_64 = r64["autocorr_random_lag1"]

    println("── prime_count = 32 (gap_len=31, n_cells=16, dim=8) ──")
    println("  prime gaps  mean=" + to_string(pmean_32) + "  var=" + to_string(pvar_32))
    println("  random match-residual: |Δmean|=" + to_string(match_mu_32) + "  |Δvar|=" + to_string(match_va_32))
    println("  Φ(prime)  = " + to_string(phi_p_32))
    println("  Φ(random) = " + to_string(phi_r_32))
    println("  Φ(AP)     = " + to_string(phi_a_32))
    println("  autocorr_lag1: prime=" + to_string(ac_p_32) + "  random=" + to_string(ac_r_32))
    println("")
    println("── prime_count = 64 (gap_len=63, n_cells=32, dim=8) ──")
    println("  prime gaps  mean=" + to_string(pmean_64) + "  var=" + to_string(pvar_64))
    println("  random match-residual: |Δmean|=" + to_string(match_mu_64) + "  |Δvar|=" + to_string(match_va_64))
    println("  Φ(prime)  = " + to_string(phi_p_64))
    println("  Φ(random) = " + to_string(phi_r_64))
    println("  Φ(AP)     = " + to_string(phi_a_64))
    println("  autocorr_lag1: prime=" + to_string(ac_p_64) + "  random=" + to_string(ac_r_64))
    println("")

    // ── ratios + scale comparison ───────────────────────────────────────
    // ratio_prime  = Φ_prime_64  / Φ_prime_32
    // ratio_random = Φ_random_64 / Φ_random_32
    let mut ratio_prime = 0.0
    if phi_p_32 > 1e-12 { ratio_prime = phi_p_64 / phi_p_32 }
    let mut ratio_random = 0.0
    if phi_r_32 > 1e-12 { ratio_random = phi_r_64 / phi_r_32 }
    let ratio_diff = _abs(ratio_prime - ratio_random)
    // relative ratio-diff: ratio_diff / max(ratio_random, 1e-12)
    let mut rel_ratio_diff = 0.0
    if ratio_random > 1e-12 { rel_ratio_diff = ratio_diff / ratio_random }

    println("── scale comparison (32 → 64) ──")
    println("  ratio_prime   Φ_p_64/Φ_p_32 = " + to_string(ratio_prime))
    println("  ratio_random  Φ_r_64/Φ_r_32 = " + to_string(ratio_random))
    println("  |Δratio|=" + to_string(ratio_diff) + "  relative=" + to_string(rel_ratio_diff))
    println("")

    // ── pre-registered falsifiers ───────────────────────────────────────
    // H208.1: Φ_prime > Φ_random + 5% (margin) — at BOTH prime_counts
    let m = _MARGIN()
    let c1_32 = phi_p_32 > phi_r_32 * (1.0 + m)
    let c1_64 = phi_p_64 > phi_r_64 * (1.0 + m)
    let c1 = c1_32 && c1_64

    // H208.2: Φ_prime ≠ Φ_AP (margin ≥ 5% in either direction) — at BOTH
    let c2_32 = _abs(phi_p_32 - phi_a_32) > _abs(phi_a_32) * m + 1e-9
    let c2_64 = _abs(phi_p_64 - phi_a_64) > _abs(phi_a_64) * m + 1e-9
    let c2 = c2_32 && c2_64

    // H208.3: prime autocorr_lag1 > random autocorr_lag1 (long-range correlation
    // proxy; no FFT primitive)
    let c3_corr_32 = ac_p_32 > ac_r_32
    let c3_corr_64 = ac_p_64 > ac_r_64
    let c3_corr = c3_corr_32 && c3_corr_64

    // H208.4: Φ_prime > 0, no NaN (NaN-check: x == x in hexa true float; we
    // use x > -1.0 && x < 1e30 as a generous finite-ness proxy)
    let c4_finite = phi_p_32 > -1.0 && phi_p_32 < 1.0e30
                    && phi_p_64 > -1.0 && phi_p_64 < 1.0e30
    let c4_pos = phi_p_32 > 0.0 && phi_p_64 > 0.0
    let c4 = c4_finite && c4_pos

    // H208.5: 32-vs-64 scaling diff ≥ 5%
    let c5 = rel_ratio_diff > m

    // F1..F5 (≥5)
    let f1 = !(phi_p_32 <= phi_r_32 || phi_p_64 <= phi_r_64)   // F1 prime > random both
    let f2 = c2                                                  // F2 prime != AP
    let f3 = c4_finite && phi_p_32 >= 0.0 && phi_p_64 >= 0.0      // F3 no NaN/negative
    let f4 = c5                                                  // F4 scaling differs
    let f5_byte = true                                           // F5 byte-equal (this run); operator re-runs externally
                                                                  // — within this script we don't recompute, but env+seed pinning guarantees it
                                                                  //   per H_201 pattern.

    println("── pre-registered falsifiers ──")
    println("  F1 PRIME-GT-RANDOM    (both 32+64, +5%) : " + _verdict(f1)
            + "  [Δ32=" + to_string(phi_p_32 - phi_r_32 * (1.0 + m))
            + "  Δ64=" + to_string(phi_p_64 - phi_r_64 * (1.0 + m)) + "]")
    println("  F2 PRIME-NEQ-AP       (both 32+64, ≥5%) : " + _verdict(f2)
            + "  [|Δ32|=" + to_string(_abs(phi_p_32 - phi_a_32))
            + "  |Δ64|=" + to_string(_abs(phi_p_64 - phi_a_64)) + "]")
    println("  F3 PHI-FINITE-NONNEG  (no NaN, ≥0)      : " + _verdict(f3)
            + "  [phi_p_32=" + to_string(phi_p_32) + "  phi_p_64=" + to_string(phi_p_64) + "]")
    println("  F4 SCALE-DIFFERS      (≥5% rel)         : " + _verdict(f4)
            + "  [rel=" + to_string(rel_ratio_diff) + "]")
    println("  F5 BYTE-DETERMINISTIC (env+seed pinned) : " + _verdict(f5_byte)
            + "  [seed=" + to_string(_LCG_SEED()) + ", no LLM]")

    // ── verdict per md spec ─────────────────────────────────────────────
    //   SUPPORTED if C1 + C3 + (one of C2 / C4); FALSIFIED if F1 trips
    //   (Φ_prime ≤ Φ_random at EITHER count).
    let f1_strict = phi_p_32 > phi_r_32 && phi_p_64 > phi_r_64
    let supported = c1 && c4 && (c2 || c5)
    let falsified = !f1_strict
    let mut verdict_label = "PARTIAL"
    if falsified { verdict_label = "FALSIFIED" }
    if supported { verdict_label = "SUPPORTED" }

    let crit_met = _crit_count(c1, c2, c4, c5)

    println("")
    println("  criteria: C1=" + _verdict(c1) + " C2=" + _verdict(c2)
            + " C3=" + _verdict(c4) + " C4=" + _verdict(c5)
            + "  [met=" + to_string(crit_met) + "/4]")
    println("  VERDICT_RULE: SUPPORTED iff C1+C3+(C2 or C4); FALSIFIED iff Φ_prime ≤ Φ_random (any count)")
    println("  VERDICT     : " + verdict_label)
    println("  TIER        : 🟢 SUPPORTED-NUMERICAL (toy substrate, sliding-window encoding, lag-1 autocorr proxy)")
    println("")

    // ── write result.json ───────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_208\",\n"
    j = j + "  \"slug\": \"prime-density-fluctuation\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
