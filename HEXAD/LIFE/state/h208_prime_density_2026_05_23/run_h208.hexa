    j = j + "  \"sister_h\": \"H_157 (Law 76 mathematical panpsychism, σ-identity precedent)\",\n"
    j = j + "  \"config\": { \"dim\": " + to_string(_DIM()) + ", \"n_bins\": " + to_string(c_phi_n_bins_default())
          + ", \"lcg_seed\": " + to_string(_LCG_SEED()) + ", \"margin\": " + to_string(_MARGIN()) + " },\n"
    j = j + "  \"measurements\": {\n"
    j = j + "    \"prime_count_32\": {\n"
    j = j + "      \"n_cells\": 16, \"gap_len\": 31,\n"
    j = j + "      \"prime_mean\": " + to_string(pmean_32) + ", \"prime_var\": " + to_string(pvar_32) + ",\n"
    j = j + "      \"match_mean_residual\": " + to_string(match_mu_32) + ", \"match_var_residual\": " + to_string(match_va_32) + ",\n"
    j = j + "      \"phi_prime\": " + to_string(phi_p_32) + ",\n"
    j = j + "      \"phi_random\": " + to_string(phi_r_32) + ",\n"
    j = j + "      \"phi_ap\": " + to_string(phi_a_32) + ",\n"
    j = j + "      \"autocorr_prime_lag1\": " + to_string(ac_p_32) + ",\n"
    j = j + "      \"autocorr_random_lag1\": " + to_string(ac_r_32) + "\n"
    j = j + "    },\n"
    j = j + "    \"prime_count_64\": {\n"
    j = j + "      \"n_cells\": 32, \"gap_len\": 63,\n"
    j = j + "      \"prime_mean\": " + to_string(pmean_64) + ", \"prime_var\": " + to_string(pvar_64) + ",\n"
    j = j + "      \"match_mean_residual\": " + to_string(match_mu_64) + ", \"match_var_residual\": " + to_string(match_va_64) + ",\n"
    j = j + "      \"phi_prime\": " + to_string(phi_p_64) + ",\n"
    j = j + "      \"phi_random\": " + to_string(phi_r_64) + ",\n"
    j = j + "      \"phi_ap\": " + to_string(phi_a_64) + ",\n"
    j = j + "      \"autocorr_prime_lag1\": " + to_string(ac_p_64) + ",\n"
    j = j + "      \"autocorr_random_lag1\": " + to_string(ac_r_64) + "\n"
    j = j + "    }\n"
    j = j + "  },\n"
    j = j + "  \"scale_comparison\": {\n"
    j = j + "    \"ratio_prime\": " + to_string(ratio_prime) + ",\n"
    j = j + "    \"ratio_random\": " + to_string(ratio_random) + ",\n"
    j = j + "    \"abs_ratio_diff\": " + to_string(ratio_diff) + ",\n"
    j = j + "    \"relative_ratio_diff\": " + to_string(rel_ratio_diff) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_PRIME_GT_RANDOM\":    { \"metric\": \"Φ_prime > Φ_random·(1+5%) both counts\", \"verdict\": \"" + _verdict(f1) + "\" },\n"
    j = j + "    \"F2_PRIME_NEQ_AP\":       { \"metric\": \"|Φ_prime - Φ_AP| > Φ_AP·5% both counts\",  \"verdict\": \"" + _verdict(f2) + "\" },\n"
    j = j + "    \"F3_PHI_FINITE_NONNEG\":  { \"metric\": \"Φ_prime ≥ 0, finite (no NaN)\",            \"verdict\": \"" + _verdict(f3) + "\" },\n"
    j = j + "    \"F4_SCALE_DIFFERS\":      { \"metric\": \"|ratio_prime - ratio_random|/ratio_random > 5%\", \"verdict\": \"" + _verdict(f4) + "\" },\n"
    j = j + "    \"F5_BYTE_DETERMINISTIC\": { \"metric\": \"env+seed pinned, byte-equal re-run\",      \"verdict\": \"" + _verdict(f5_byte) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"criteria_met\": " + to_string(crit_met) + ",\n"
    j = j + "  \"criteria_total\": 4,\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1+C3+(C2 or C4); FALSIFIED iff Φ_prime ≤ Φ_random (any count)\",\n"
    j = j + "  \"verdict\": \"" + verdict_label + "\",\n"
    j = j + "  \"tier\": \"🟢 SUPPORTED-NUMERICAL\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_208 prime-density-fluctuation smoke complete: " + verdict_label + " ===")
}

fn _crit_count(c1: bool, c2: bool, c3: bool, c4: bool) -> int {
    let mut n = 0
    if c1 { n = n + 1 }
    if c2 { n = n + 1 }
    if c3 { n = n + 1 }
    if c4 { n = n + 1 }
    return n
}
