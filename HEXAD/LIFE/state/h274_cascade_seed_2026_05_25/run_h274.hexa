// ════════════════════════════════════════════════════════════════════════════
//  run_h274.hexa — H_274 quorum-cascade seed-dependence mechanism
//                  (life · H_262/H_272 depth · raw#12 · deterministic · LLM none)
//
//  CORE QUESTION
//    H_272 re-measured the cycle#14 H_262 (quorum-sensing) coop cascade over 10
//    seeds {0..9} with a PER-SEED ADAPTIVE base_gain. The adaptive calibration
//    removed the OVER-drive half of the fragility (control settled below majority
//    on every seed), but the UNDER-drive half remained: the coop cascade SUCCEEDS
//    on 5/10 seeds (0,1,2,4,6) and STALLS on 5/10 (3,5,7,8,9). H_272 L3 concluded
//    that cascade success depends on the seed-specific *structure* (shape) of the
//    substrate tension distribution, not just its absolute level (which the
//    adaptive base_gain already normalizes out via control-target calibration).
//
//    H_274 asks: WHICH seed-property (statistic of the initial tension
//    distribution) PREDICTS whether the coop cascade succeeds? I.e., can we
//    identify a mechanistically-interpretable predictor that separates the
//    success seeds from the fail seeds?
//
//  WHY THE INITIAL TENSION DISTRIBUTION IS THE RIGHT PREDICTOR
//    The quorum dynamics are
//      a_i(t+1) = a_i(t) + (base + tcoef·tension_i) + boost − leak·a_i(t)
//    with boost = (Q_prev > q_thr) ? coupling : 0. The per-cell intrinsic drive
//    is base + tcoef·tension_i. The adaptive base_gain is calibrated so the
//    NO-COUPLING control's max q_final lands in [0.20, 0.45] (below majority).
//    Given that fixed control level, whether the COUPLING boost can push partial
//    quorum past q_thr=0.3 and then CASCADE to full ON depends on HOW MANY cells
//    are near the ON-latch threshold early — i.e., on the SHAPE of the tension
//    distribution (its spread / upper-tail mass), not its mean (the mean is
//    pinned by the control-target calibration). H_274 measures candidate shape
//    statistics of the cascade pool's INITIAL per-cell tensions and tests which
//    one separates the success vs fail groups.
//
//  PREDICTOR CANDIDATES (measured on the coop cascade pool's INITIAL tensions,
//                         i.e. _cell_tension on the freshly-init pool, the same
//                         stream-position pool the cascade actually evolves)
//    mean · var · std · max · min · range(max-min) · topk_mass(mean of top-4) ·
//    n_above(count of cells with tension > calibration-window midpoint proxy).
//    For each predictor we report the success-group mean and the fail-group mean
//    and a normalized separation (Cohen-d-style: |Δmean| / pooled_std).
//
//  METHOD (one process per seed; RFC 033 gauss stream is process-global)
//    Identical to H_272: a bash driver runs THIS script once per seed
//    s ∈ {0..9} in mode "seed" with __HEXA_FARR_GAUSS_SEED__=s. Each seed run
//    REPLICATES the exact H_272 sweep sequence (adaptive base calibration →
//    control sweep → coop sweep) so the stream position at the coop cascade is
//    byte-identical to H_272, and instruments the coop cascade pool to capture
//    its initial tension distribution + the cascade outcome. A final "agg" run
//    reads the 10 snapshots + det_xproc.txt and computes which predictor
//    separates success from fail.
//
//  PRE-REGISTERED CRITERIA (H_274)
//    C1 : >= 1 initial-tension statistic separates the cascade success vs fail
//         groups (success-group mean differs from fail-group mean with
//         normalized separation |d| >= 0.8 = "large effect", AND the groups are
//         monotone-orderable by a single threshold = perfect rank-separation).
//    C2 : the separating predictor is mechanistically interpretable — the
//         direction matches the cascade mechanism (more upper-tail tension mass /
//         spread → more cells near the ON-latch → cascade succeeds). I.e. the
//         success group must have the HIGHER value for an upper-tail / spread
//         predictor (max, range, topk_mass, std, var, n_above), NOT for a
//         pure-floor predictor (min) in the wrong direction.
//    C3 : same-seed cross-process determinism (driver det_xproc.txt all PASS).
//    verdict_rule:
//      SUPPORTED  = C1 ∧ C2 (a mechanistically-interpretable seed-property
//                   predicts cascade success → seed-dependence MECHANISM mapped)
//      PARTIAL    = C1 ∧ ¬C2 (a statistic separates the groups but its direction
//                   is not mechanistically interpretable — predictive but opaque)
//      FALSIFIED  = ¬C1 (no distribution statistic separates the groups → cascade
//                   is chaotic / unpredictable from the initial distribution)
//
//  $0 mac local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "HEXAD/LIFE/state/h274_cascade_seed_2026_05_25"
}
fn _snap_dir() -> string {
    return _state_dir() + "/snapshots"
}
fn _n_seeds() -> int { return 10 }   // seeds 0..9

// ── H_261 (embryogenesis-gradient) params — carried VERBATIM from run_h272.
//    The H_261 leg is replicated ONLY to advance the process-global gauss stream
//    to the SAME position H_272 reached before its H_262 leg, so the coop cascade
//    here evolves on the byte-identical pool H_272 measured (5/10 = the EXACT
//    cascade outcomes H_272 recorded). H_274 does NOT score H_261. ──
fn _h261_d() -> int       { return 8 }
fn _h261_n() -> int       { return 12 }
fn _h261_steps() -> int   { return 20 }
fn _s_flat() -> float     { return 0.0 }
fn _s_steep() -> float    { return 4.0 }

// ── H_262 (quorum-sensing) params — carried VERBATIM from run_h272/run_h262 ──
fn _h262_d() -> int       { return 8 }
fn _h262_n() -> int       { return 16 }
fn _max_steps() -> int    { return 40 }
fn _leak()  -> float      { return 0.05 }
fn _tcoef() -> float      { return 0.11 }
fn _up_thr() -> float     { return 1.0 }
fn _dn_thr() -> float     { return 0.4 }
fn _coupling() -> float   { return 0.20 }
// per-seed adaptive base_gain target window (carried VERBATIM from H_272).
fn _q_lo() -> float       { return 0.20 }
fn _q_hi() -> float       { return 0.45 }
fn _base_lo() -> float    { return 0.0 }
fn _base_hi() -> float    { return 0.05 }
fn _cal_iters() -> int    { return 28 }

// ── H_274 predictor params (pre-registered) ─────────────────────────────────
fn _topk() -> int         { return 4 }    // upper-tail mass = mean of top-4
fn _large_d() -> float    { return 0.8 }  // C1 large-effect separation threshold
// n_above threshold proxy = upper-tail boundary on the substrate tension scale
// (substrate tensions empirically sit in ~[0.18, 0.40]; 0.33 is the upper third).
fn _above_thr() -> float  { return 0.33 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _zero_vec(n: int) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(0.0)
        i = i + 1
    }
    return a
}

fn _sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut r = x
    let mut k = 0
    while k < 40 {
        if r <= 0.0 { r = 1.0e-12 }
        r = 0.5 * (r + x / r)
        k = k + 1
    }
    return r
}

fn _vec_mean_scalar(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _bool_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + _bool_str(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _mean(xs) -> float {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / to_float(n)
}
fn _std(xs) -> float {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let m = _mean(xs)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = xs[i] - m
        s = s + d * d
        i = i + 1
    }
    let v = s / to_float(n)
    return _sqrt_f(v)
}
fn _var(xs) -> float {
    let s = _std(xs)
    return s * s
}
fn _min(xs) -> float {
    let mut m = xs[0]
    let mut i = 1
    while i < len(xs) {
        if xs[i] < m { m = xs[i] }
        i = i + 1
    }
    return m
}
fn _max(xs) -> float {
    let mut m = xs[0]
    let mut i = 1
    while i < len(xs) {
        if xs[i] > m { m = xs[i] }
        i = i + 1
    }
    return m
}

// mean of the top-k largest values (upper-tail mass). selection sort copy.
fn _topk_mass(xs, k: int) -> float {
    let n = len(xs)
    let mut tmp = []
    let mut i = 0
    while i < n {
        tmp.push(xs[i])
        i = i + 1
    }
    // partial selection sort: bubble the k largest to the front.
    let kk = if k < n { k } else { n }
    let mut a = 0
    while a < kk {
        let mut best = a
        let mut b = a + 1
        while b < n {
            if tmp[b] > tmp[best] { best = b }
            b = b + 1
        }
        let t = tmp[a]
        tmp[a] = tmp[best]
        tmp[best] = t
        a = a + 1
    }
    let mut s = 0.0
    let mut c = 0
    while c < kk {
        s = s + tmp[c]
        c = c + 1
    }
    if kk == 0 { return 0.0 }
    return s / to_float(kk)
}

// count of values strictly above a threshold.
fn _n_above(xs, thr: float) -> float {
    let n = len(xs)
    let mut c = 0
    let mut i = 0
    while i < n {
        if xs[i] > thr { c = c + 1 }
        i = i + 1
    }
    return to_float(c)
}


// ── per-cell substrate tension (carried VERBATIM from run_h262/run_h272) ─────
fn _cell_tension(cell) -> float {
    let h = cell["hidden"]
    let n = len(h)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let v = h[i]
        if v < 0.0 { s = s - v } else { s = s + v }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}


// L2 norm of list[float] (for H_261 leg state extraction).
fn _vec_l2(v) -> float {
    let n = len(v)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + (v[i] * v[i])
        i = i + 1
    }
    return _sqrt_f(s)
}


// ════════════════════════════════════════════════════════════════════════════
//  H_261 leg — gradient injection + one steepness condition (carried VERBATIM
//              from run_h272, replicated ONLY to advance the gauss stream to the
//              same position H_272 reached before its H_262 leg; NOT scored).
// ════════════════════════════════════════════════════════════════════════════

fn _inject_gradient(pool, steepness: float, n_fixed: int) {
    let cs = pool["cells"]
    let n = len(cs)
    let denom = if n_fixed > 1 { to_float(n_fixed - 1) } else { 1.0 }
    let mut i = 0
    while i < n {
        if i < n_fixed {
            let p_i = to_float(i) / denom
            let drive = steepness * p_i
            let h = cs[i]["hidden"]
            let d = len(h)
            let mut new_h = []
            let mut q = 0
            while q < d {
                new_h.push(h[q] + drive)
                q = q + 1
            }
            pool["cells"][i]["hidden"] = new_h
        }
        i = i + 1
    }
    return pool
}

// run one (steepness) H_261 condition (VERBATIM from run_h272._h261_condition).
// return value is discarded; the call exists for stream-position fidelity.
fn _h261_condition(steepness: float) {
    let d = _h261_d()
    let n = _h261_n()
    let mut pool = cell_pool_init(d, n)
    let zero_x = _zero_vec(d)

    let mut step = 0
    while step < _h261_steps() {
        pool = _inject_gradient(pool, steepness, n)
        let res = mitosis_forward_tail(zero_x, pool, step)
        pool = res[1]
        step = step + 1
    }

    let cs = pool["cells"]
    let n_have = len(cs)
    let mut states = []
    let mut i = 0
    while i < n {
        let mut sc = 0.0
        if i < n_have { sc = _vec_l2(cs[i]["hidden"]) }
        states.push(sc)
        i = i + 1
    }
    return #{ "n_have": n_have }
}


// ════════════════════════════════════════════════════════════════════════════
//  H_262 quorum dynamics — carried VERBATIM from run_h272 (_h262_up), but the
//  coop cascade variant ALSO returns the pool's INITIAL per-cell tension list
//  (captured on the freshly-init pool before any boost). This is the substrate
//  property H_274 correlates with cascade success.
// ════════════════════════════════════════════════════════════════════════════

// plain ramp-up (control or coop) — returns { switched, q_final, max_jump }.
// VERBATIM dynamics of run_h272._h262_up.
fn _h262_up(q_thr: float, coupling: float, base: float) {
    let d = _h262_d()
    let n = _h262_n()
    let mut pool = cell_pool_init(d, n)

    let mut act    = _zero_vec(n)
    let mut state  = _zero_vec(n)
    let mut q_prev = 0.0

    let leak  = _leak()
    let tcoef = _tcoef()
    let up    = _up_thr()
    let dn    = _dn_thr()

    let mut switch_step = -1
    let mut max_jump    = 0.0
    let x = _zero_vec(d)

    let mut step = 0
    while step < _max_steps() {
        let res = mitosis_forward_tail(x, pool, step)
        pool = res[1]

        let mut boost = 0.0
        if q_prev > q_thr { boost = coupling }

        let cells = pool["cells"]
        let n_cells = len(cells)
        let mut i = 0
        while i < n {
            let mut tens = 0.0
            if i < n_cells { tens = _cell_tension(cells[i]) }
            let intrinsic = base + tcoef * tens
            let a_new = act[i] + intrinsic + boost - leak * act[i]
            act[i] = a_new
            if a_new > up {
                state[i] = 1.0
            } else {
                if a_new < dn { state[i] = 0.0 }
            }
            i = i + 1
        }

        let q_now = _vec_mean_scalar(state)
        let jump = q_now - q_prev
        let abs_jump = if jump < 0.0 { 0.0 - jump } else { jump }
        if abs_jump > max_jump { max_jump = abs_jump }
        if switch_step < 0 {
            if q_now >= 0.5 { switch_step = step }
        }
        q_prev = q_now
        step = step + 1
    }
    let switched = switch_step >= 0
    return #{
        "switched":    switched,
        "switch_step": switch_step,
        "q_final":     q_prev,
        "max_jump":    max_jump
    }
}

// COOP cascade variant — IDENTICAL dynamics to _h262_up, but also captures the
// freshly-init pool's INITIAL per-cell tension list (the predictor source).
fn _h262_up_capture(q_thr: float, coupling: float, base: float) {
    let d = _h262_d()
    let n = _h262_n()
    let mut pool = cell_pool_init(d, n)

    // ── H_274 capture: initial per-cell substrate tension distribution ──
    let cs0 = pool["cells"]
    let mut init_tens = []
    let mut ci = 0
    while ci < len(cs0) {
        init_tens.push(_cell_tension(cs0[ci]))
        ci = ci + 1
    }

    let mut act    = _zero_vec(n)
    let mut state  = _zero_vec(n)
    let mut q_prev = 0.0

    let leak  = _leak()
    let tcoef = _tcoef()
    let up    = _up_thr()
    let dn    = _dn_thr()

    let mut switch_step = -1
    let mut max_jump    = 0.0
    let x = _zero_vec(d)

    let mut step = 0
    while step < _max_steps() {
        let res = mitosis_forward_tail(x, pool, step)
        pool = res[1]

        let mut boost = 0.0
        if q_prev > q_thr { boost = coupling }

        let cells = pool["cells"]
        let n_cells = len(cells)
        let mut i = 0
        while i < n {
            let mut tens = 0.0
            if i < n_cells { tens = _cell_tension(cells[i]) }
            let intrinsic = base + tcoef * tens
            let a_new = act[i] + intrinsic + boost - leak * act[i]
            act[i] = a_new
            if a_new > up {
                state[i] = 1.0
            } else {
                if a_new < dn { state[i] = 0.0 }
            }
            i = i + 1
        }

        let q_now = _vec_mean_scalar(state)
        let jump = q_now - q_prev
        let abs_jump = if jump < 0.0 { 0.0 - jump } else { jump }
        if abs_jump > max_jump { max_jump = abs_jump }
        if switch_step < 0 {
            if q_now >= 0.5 { switch_step = step }
        }
        q_prev = q_now
        step = step + 1
    }
    let switched = switch_step >= 0
    return #{
        "switched":    switched,
        "switch_step": switch_step,
        "q_final":     q_prev,
        "max_jump":    max_jump,
        "init_tens":   init_tens
    }
}

// PER-SEED ADAPTIVE calibration (VERBATIM from run_h272) — bisection-search
// base_gain so the NO-COUPLING control max q_final lands in [Q_LO, Q_HI].
fn _control_maxq(base: float) -> float {
    let r30 = _h262_up(0.3, 0.0, base)
    let r50 = _h262_up(0.5, 0.0, base)
    let r70 = _h262_up(0.7, 0.0, base)
    let mut m = r30["q_final"]
    if r50["q_final"] > m { m = r50["q_final"] }
    if r70["q_final"] > m { m = r70["q_final"] }
    return m
}

fn _calibrate_base() -> float {
    let target = 0.5 * (_q_lo() + _q_hi())
    let mut lo = _base_lo()
    let mut hi = _base_hi()
    let mut k = 0
    while k < _cal_iters() {
        let mid = 0.5 * (lo + hi)
        let q = _control_maxq(mid)
        if q < target {
            lo = mid
        } else {
            hi = mid
        }
        k = k + 1
    }
    return 0.5 * (lo + hi)
}


// ════════════════════════════════════════════════════════════════════════════
//  MODE: seed — replicate the H_272 H_262 sweep sequence for one seed, capture
//               the coop cascade pool's INITIAL tension distribution + outcome.
// ════════════════════════════════════════════════════════════════════════════

fn _run_seed(seed: int) {
    println("---- H_274 seed " + to_string(seed) + " (gauss-seed env) ----")

    // ── replicate H_272's per-seed sequence EXACTLY so the stream position at
    //    the coop cascade matches H_272: H_261 leg (flat → steep) → calibration
    //    → control sweep → coop sweep. The H_261 leg is NOT scored; it only
    //    advances the process-global gauss stream to H_272's position so the
    //    cascade outcomes here are byte-identical to H_272's (the depth target). ──
    let _h261_flat  = _h261_condition(_s_flat())
    let _h261_steep = _h261_condition(_s_steep())
    let base_cal = _calibrate_base()
    // control sweep (advances stream identically to H_272).
    let cc30 = _h262_up(0.3, 0.0, base_cal)
    let cc50 = _h262_up(0.5, 0.0, base_cal)
    let cc70 = _h262_up(0.7, 0.0, base_cal)
    // coop sweep — q_thr=0.3 is the cascade-relevant condition; CAPTURE its
    // initial tension distribution (it is the first coop run, matching H_272
    // co30 stream position).
    let co30 = _h262_up_capture(0.3, _coupling(), base_cal)
    let co50 = _h262_up(0.5, _coupling(), base_cal)
    let co70 = _h262_up(0.7, _coupling(), base_cal)

    let any_ctrl_switch = cc30["switched"] || cc50["switched"] || cc70["switched"]
    let any_coop_switch = co30["switched"] || co50["switched"] || co70["switched"]

    // cascade_success bool = the H_272 quorum-gate (coop switches, control
    // doesn't). This is the EXACT outcome H_272 records as h262.gate/pass.
    let cascade_success = any_coop_switch && (!any_ctrl_switch)

    let mut coop_maxq = co30["q_final"]
    if co50["q_final"] > coop_maxq { coop_maxq = co50["q_final"] }
    if co70["q_final"] > coop_maxq { coop_maxq = co70["q_final"] }
    let mut ctrl_maxq = cc30["q_final"]
    if cc50["q_final"] > ctrl_maxq { ctrl_maxq = cc50["q_final"] }
    if cc70["q_final"] > ctrl_maxq { ctrl_maxq = cc70["q_final"] }

    // ── initial tension distribution statistics (the predictor candidates) ──
    let it = co30["init_tens"]
    let t_mean  = _mean(it)
    let t_var   = _var(it)
    let t_std   = _std(it)
    let t_max   = _max(it)
    let t_min   = _min(it)
    let t_range = t_max - t_min
    let t_topk  = _topk_mass(it, _topk())
    let t_nabove = _n_above(it, _above_thr())

    println("  base_cal=" + to_string(base_cal)
            + " ctrl_maxq=" + to_string(ctrl_maxq)
            + " coop_maxq=" + to_string(coop_maxq)
            + " cascade_success=" + _bool_str(cascade_success))
    println("  init-tension stats: mean=" + to_string(t_mean)
            + " std=" + to_string(t_std)
            + " max=" + to_string(t_max)
            + " range=" + to_string(t_range)
            + " topk=" + to_string(t_topk)
            + " n_above=" + to_string(t_nabove))

    // ── snapshot json ──
    let mut j = "{\n"
    j = j + "  \"seed\": " + to_string(seed) + ",\n"
    j = j + "  \"base_calibrated\": " + to_string(base_cal) + ",\n"
    j = j + "  \"ctrl_maxq\": " + to_string(ctrl_maxq) + ",\n"
    j = j + "  \"coop_maxq\": " + to_string(coop_maxq) + ",\n"
    j = j + "  \"any_ctrl_switch\": " + _bool_str(any_ctrl_switch) + ",\n"
    j = j + "  \"any_coop_switch\": " + _bool_str(any_coop_switch) + ",\n"
    j = j + "  \"cascade_success\": " + _bool_str(cascade_success) + ",\n"
    j = j + "  \"init_tension\": " + _float_arr_json(it) + ",\n"
    j = j + "  \"stats\": {\n"
    j = j + "    \"mean\":    " + to_string(t_mean) + ",\n"
    j = j + "    \"var\":     " + to_string(t_var) + ",\n"
    j = j + "    \"std\":     " + to_string(t_std) + ",\n"
    j = j + "    \"max\":     " + to_string(t_max) + ",\n"
    j = j + "    \"min\":     " + to_string(t_min) + ",\n"
    j = j + "    \"range\":   " + to_string(t_range) + ",\n"
    j = j + "    \"topk_mass\": " + to_string(t_topk) + ",\n"
    j = j + "    \"n_above\": " + to_string(t_nabove) + "\n"
    j = j + "  }\n"
    j = j + "}\n"

    write_file(_snap_dir() + "/seed" + to_string(seed) + ".json", j)
    println("  snapshot -> " + _snap_dir() + "/seed" + to_string(seed) + ".json")
}


// ════════════════════════════════════════════════════════════════════════════
//  MODE: agg — read 10 seed snapshots + det_xproc.txt, find which predictor
//              separates the cascade success vs fail groups.
// ════════════════════════════════════════════════════════════════════════════

fn _load_seed(seed: int) {
    let raw = read_file(_snap_dir() + "/seed" + to_string(seed) + ".json")
    return json_parse(raw)
}

// C3 determinism — read driver-written det_xproc.txt; each line
// "seed<s> PASS <sha_a> <sha_b>". Require >= 1 line and all contain PASS.
fn _c3_all_pass() -> bool {
    let raw = read_file(_state_dir() + "/det_xproc.txt")
    if len(raw) == 0 { return false }
    let lines = split(raw, "\n")
    let mut found = 0
    let mut all_pass = true
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i]
        if contains(ln, "seed") {
            found = found + 1
            if !contains(ln, "PASS") { all_pass = false }
        }
        i = i + 1
    }
    return all_pass && (found >= 1)
}

// group-separation analysis for one predictor: split values by success bool,
// compute group means, normalized separation (|Δmean| / pooled_std), and
// perfect-rank-separation (every success value strictly orderable vs every fail
// value by a single threshold = max(low_group) < min(high_group)).
// returns #{ succ_mean, fail_mean, delta, pooled_std, d, rank_sep, higher_succ }.
fn _analyze_predictor(vals, succ) {
    let n = len(vals)
    let mut s_succ = []
    let mut s_fail = []
    let mut i = 0
    while i < n {
        if succ[i] { s_succ.push(vals[i]) } else { s_fail.push(vals[i]) }
        i = i + 1
    }
    let m_succ = _mean(s_succ)
    let m_fail = _mean(s_fail)
    let delta = m_succ - m_fail
    let sd_succ = _std(s_succ)
    let sd_fail = _std(s_fail)
    // pooled std (root-mean of the two group variances).
    let pooled = _sqrt_f(0.5 * (sd_succ * sd_succ + sd_fail * sd_fail))
    let mut d = 0.0
    if pooled > 1.0e-12 { d = _abs(delta) / pooled }

    // perfect rank-separation: groups don't overlap.
    let higher_succ = m_succ > m_fail
    let mut rank_sep = false
    if len(s_succ) > 0 {
        if len(s_fail) > 0 {
            if higher_succ {
                rank_sep = _min(s_succ) > _max(s_fail)
            } else {
                rank_sep = _max(s_succ) < _min(s_fail)
            }
        }
    }
    return #{
        "succ_mean":   m_succ,
        "fail_mean":   m_fail,
        "delta":       delta,
        "pooled_std":  pooled,
        "d":           d,
        "rank_sep":    rank_sep,
        "higher_succ": higher_succ
    }
}

// is this predictor an UPPER-TAIL / SPREAD predictor (mechanistically expected
// to be HIGHER in the success group)? mean/max/range/topk/std/var/n_above = yes.
// min = a floor predictor — for the cascade mechanism the success group is NOT
// expected to be distinguished by a higher floor, so min higher-in-success is
// NOT mechanistically clean (it would just track overall level).
fn _is_uppertail(name: string) -> bool {
    if name == "min" { return false }
    return true
}

fn _run_agg() {
    let ns = _n_seeds()
    println("================================================================")
    println("H_274 quorum-cascade seed-dependence — which initial-tension")
    println("       statistic predicts coop cascade success?")
    println("  base: H_262 quorum-gate · H_272 adaptive base_gain (verbatim)")
    println("  predictor source: coop cascade pool INITIAL per-cell tensions")
    println("  seeds: 0..9 (one process per seed)")
    println("================================================================")

    let mut succ = []
    let mut coopq = []
    let mut v_mean = []
    let mut v_var  = []
    let mut v_std  = []
    let mut v_max  = []
    let mut v_min  = []
    let mut v_range = []
    let mut v_topk = []
    let mut v_nabove = []

    let mut s = 0
    while s < ns {
        let d = _load_seed(s)
        succ.push(d["cascade_success"])
        coopq.push(d["coop_maxq"])
        let st = d["stats"]
        v_mean.push(st["mean"])
        v_var.push(st["var"])
        v_std.push(st["std"])
        v_max.push(st["max"])
        v_min.push(st["min"])
        v_range.push(st["range"])
        v_topk.push(st["topk_mass"])
        v_nabove.push(st["n_above"])
        s = s + 1
    }

    let mut n_succ = 0
    let mut i = 0
    while i < ns {
        if succ[i] { n_succ = n_succ + 1 }
        i = i + 1
    }
    let n_fail = ns - n_succ

    // predictor analysis.
    let names = ["mean", "var", "std", "max", "min", "range", "topk_mass", "n_above"]
    let cols  = [v_mean, v_var, v_std, v_max, v_min, v_range, v_topk, v_nabove]

    // find the BEST separating predictor (highest |d|; tie → rank_sep first).
    let mut best_idx = -1
    let mut best_d = -1.0
    let mut analyses = []
    let mut p = 0
    while p < len(names) {
        let a = _analyze_predictor(cols[p], succ)
        analyses.push(a)
        // ranking: rank_sep predictors dominate; among them, highest d.
        let score = if a["rank_sep"] { 100.0 + a["d"] } else { a["d"] }
        if score > best_d {
            best_d = score
            best_idx = p
        }
        p = p + 1
    }

    let best_name = names[best_idx]
    let best = analyses[best_idx]

    // C1: >= 1 predictor with large effect (|d| >= 0.8) AND perfect rank-sep.
    // C2: that predictor is mechanistically interpretable (upper-tail/spread,
    //     HIGHER in the success group).
    let c1 = (best["d"] >= _large_d()) && best["rank_sep"]
    let c2 = c1 && _is_uppertail(best_name) && best["higher_succ"]
    let c3 = _c3_all_pass()

    // falsifiers (>=5 measurable).
    // F1 SEPARATES : best predictor large-effect AND rank-separating.
    // F2 INTERPRET : best predictor is upper-tail/spread + higher-in-success.
    // F3 NONTRIVIAL: groups non-degenerate (>=1 success AND >=1 fail seed).
    // F4 GROUNDTRUTH: coop_maxq matches H_272 (success seeds reach 1.0, fail < 0.5).
    // F5 DETERMINISM: same-seed cross-process byte-equal.
    let f1 = c1
    let f2 = c2
    let f3 = (n_succ >= 1) && (n_fail >= 1)
    // F4: every success seed coop_maxq == 1.0 (full ON) AND every fail < 0.5.
    let mut f4 = true
    i = 0
    while i < ns {
        if succ[i] {
            if coopq[i] < 0.999 { f4 = false }
        } else {
            if coopq[i] >= 0.5 { f4 = false }
        }
        i = i + 1
    }
    let f5 = c3

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }

    let verdict = if c1 && c2 {
        "SUPPORTED"
    } else {
        if c1 { "PARTIAL" } else { "FALSIFIED" }
    }

    // ── print ──
    println("cascade success: " + to_string(n_succ) + "/10  fail: "
            + to_string(n_fail) + "/10")
    println("  per-seed success: " + _bool_arr_json(succ))
    println("")
    println("predictor    succ-mean    fail-mean    |d|        rank-sep  higher-succ")
    println("---------    ---------    ---------    ---        --------  -----------")
    p = 0
    while p < len(names) {
        let a = analyses[p]
        println("  " + names[p]
                + "   sm=" + to_string(a["succ_mean"])
                + "  fm=" + to_string(a["fail_mean"])
                + "  d=" + to_string(a["d"])
                + "  rsep=" + _bool_str(a["rank_sep"])
                + "  hi-succ=" + _bool_str(a["higher_succ"]))
        p = p + 1
    }
    println("")
    println("BEST predictor: " + best_name
            + "  (|d|=" + to_string(best["d"])
            + ", rank-sep=" + _bool_str(best["rank_sep"])
            + ", higher-in-success=" + _bool_str(best["higher_succ"]) + ")")
    println("  success-group mean=" + to_string(best["succ_mean"])
            + "  fail-group mean=" + to_string(best["fail_mean"])
            + "  Δ=" + to_string(best["delta"]))
    println("")
    println("C1 SEPARATES   (best |d|>=0.8 AND rank-sep)      : " + _bool_str(c1))
    println("C2 INTERPRET   (upper-tail/spread, higher-succ)  : " + _bool_str(c2))
    println("C3 DETERMINISM (same-seed cross-process)         : " + _bool_str(c3))
    println("")
    println("F1 SEPARATES    " + v1)
    println("F2 INTERPRET    " + v2)
    println("F3 NONTRIVIAL   " + v3)
    println("F4 GROUNDTRUTH  " + v4)
    println("F5 DETERMINISM  " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/3 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ──
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_274\",\n"
    j = j + "  \"slug\": \"quorum-cascade-seed-dependence\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"quorum-cascade seed-dependence mechanism — which initial-tension statistic predicts coop cascade success? (H_262/H_272 depth)\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"method\": \"one process per seed (gauss-seed env), 10 seeds 0..9; replicate H_272 H_262 adaptive-base sweep, capture coop cascade pool initial tension distribution + cascade outcome; per-predictor success-vs-fail group separation\",\n"
    j = j + "  \"n_seeds\": " + to_string(ns) + ",\n"
    j = j + "  \"n_success\": " + to_string(n_succ) + ",\n"
    j = j + "  \"n_fail\": " + to_string(n_fail) + ",\n"
    j = j + "  \"per_seed_success\": " + _bool_arr_json(succ) + ",\n"
    j = j + "  \"coop_maxq\": " + _float_arr_json(coopq) + ",\n"
    j = j + "  \"predictors\": {\n"
    p = 0
    while p < len(names) {
        let a = analyses[p]
        j = j + "    \"" + names[p] + "\": { \"succ_mean\": " + to_string(a["succ_mean"])
              + ", \"fail_mean\": " + to_string(a["fail_mean"])
              + ", \"delta\": " + to_string(a["delta"])
              + ", \"pooled_std\": " + to_string(a["pooled_std"])
              + ", \"d\": " + to_string(a["d"])
              + ", \"rank_sep\": " + _bool_str(a["rank_sep"])
              + ", \"higher_succ\": " + _bool_str(a["higher_succ"])
              + ", \"values\": " + _float_arr_json(cols[p]) + " }"
        if p < len(names) - 1 { j = j + "," }
        j = j + "\n"
        p = p + 1
    }
    j = j + "  },\n"
    j = j + "  \"best_predictor\": {\n"
    j = j + "    \"name\": \"" + best_name + "\",\n"
    j = j + "    \"d\": " + to_string(best["d"]) + ",\n"
    j = j + "    \"rank_sep\": " + _bool_str(best["rank_sep"]) + ",\n"
    j = j + "    \"higher_succ\": " + _bool_str(best["higher_succ"]) + ",\n"
    j = j + "    \"succ_mean\": " + to_string(best["succ_mean"]) + ",\n"
    j = j + "    \"fail_mean\": " + to_string(best["fail_mean"]) + ",\n"
    j = j + "    \"delta\": " + to_string(best["delta"]) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_separates\":  " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_interpret\":  " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_determinism\": " + _bool_str(c3) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_SEPARATES\":   { \"metric\": \"best predictor |d|>=0.8 AND rank-sep\", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_INTERPRET\":   { \"metric\": \"best predictor upper-tail/spread, higher-in-success\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_NONTRIVIAL\":  { \"metric\": \">=1 success AND >=1 fail seed\", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_GROUNDTRUTH\": { \"metric\": \"success coop_maxq==1.0 AND fail<0.5 (matches H_272)\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_DETERMINISM\": { \"metric\": \"same-seed cross-process byte-equal\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_262\": \"quorum-sensing (cascade origin)\", \"H_272\": \"seed-robust recalibration (5/10 cascade, under-drive residual diagnosis)\", \"H_269\": \"multiseed-robustness\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


// ── dispatch on HEXA_H274_MODE env (seed=<n> | agg) ──────────────────────────

fn _run_h274() {
    let mode = env("HEXA_H274_MODE")
    if mode == "agg" {
        _run_agg()
        return 0
    }
    let seed_s = env("HEXA_H274_SEED")
    let mut seed = 0
    if len(seed_s) > 0 { seed = to_int(seed_s) }
    _run_seed(seed)
}


_run_h274()
