// H_157 — Law 76 Mathematical Panpsychism · Cycle #2 smoke (raw#15 additive)
// ════════════════════════════════════════════════════════════════════════════
//
//  GOAL (Cycle #2): advance the two pending sub-criteria
//     • C5  cross-substrate universality — algorithm vs trained property
//     • C6  combination-binding (panpsychism combination problem operational)
//
//  HONEST SCOPE (g3 — named real limits, NO fake descent):
//    • SAME proxy substrate carry as Cycle #1 — the original ConsciousMind
//      META-CA trained-net is absent; faithful trained-net measurement is
//      pre-registered as a separate GPU cycle. This cycle is a deterministic
//      PROXY across CA RULE FAMILIES (H_007 lineage) for directional evidence.
//    • $0 Mac local · hexa-only · NO LLM · NO .py/.sh
//
//  C5  PROBE — 4 elementary-CA rule families × META-CA proxy Ψ readout
//    rule  30  Class-III  chaotic
//    rule  90  Class-III  additive (XOR Sierpinski)
//    rule 110  Class-IV   complex (Turing-universal, H_007 high-Φ rule)
//    rule 184  Class-II   traffic (deterministic conserved flow)
//    For each rule we evolve a small ring lattice (N=16, dim=12, warm=8) and
//    read off two scalars: residual_ratio (past-weight at the fixed point)
//    and gate_ratio (population mean). Cross-rule CV is computed.
//
//  C6  PROBE — combination-binding via phi_spatial on isolated vs merged CA
//    A := rule-110 ring (length N_a=16, dim=12)
//    B := rule-30  ring (length N_b=16, dim=12)
//    micro-Φ_A := phi_spatial(A states matrix)   (N_a cells × dim trajectory)
//    micro-Φ_B := phi_spatial(B states matrix)   (N_b cells × dim trajectory)
//    macro-Φ_merged := phi_spatial(concat(A,B))  ((N_a+N_b) cells × dim)
//    verdict ∈ {super-additive, additive, sub-additive}
//
//  C5 FALSIFIERS (additive, ≥3):
//    F-C5-1  UNIVERSAL: 4 rule families share same fixed-point Ψ (CV ≤ 5%)
//            → strong-form panpsy SUPPORTED · invalidates Cycle #1 FAIL
//    F-C5-2  CLASS-IV-ONLY: only rule 110 is ±0.01 input-invariant; others not
//            → algorithm-specific (Class-IV is the only 'panpsy candidate')
//    F-C5-3  DETERMIN: re-run with identical seeds → byte-identical Ψ
//
//  C6 FALSIFIERS (additive, ≥3):
//    F-C6-1  PRIMITIVE-OK: macro-Φ(merged) ≥ 0 (no NaN/negative)
//    F-C6-2  SUPER-ADDITIVE: macro-Φ > Φ_A + Φ_B (substrate-level combination
//            binding demonstrated · panpsy combination problem substrate-instance)
//    F-C6-3  SUB-ADDITIVE:  macro-Φ < Φ_A + Φ_B (destructive interference ·
//            panpsy combination *failure* substrate-instance)
//
//  TIER = 🟢 NUMERICAL (closed-form on real CA dynamics + RFC 036 phi_spatial)
//  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (byte-equal phi_rs
//  replica) — SAME path as H_007 Cycle #1 + H_004 Cycle #1.
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/C/c_lib.hexa"

// ── config ──────────────────────────────────────────────────────────────────
fn _N() -> int    { return 16 }
fn _DIM() -> int  { return 12 }
fn _WARM() -> int { return 8 }
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/HEXAD/LIFE/state/h157_c2_cross_combo_2026_05_23"
}

// ── tiny int helpers (matching H_007 conventions) ───────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row: site i on iff (i + rep) % 3 != 0
// (identical to H_007 — cross-link parity)
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record each site's `dim`-step
// trajectory after `warm` warmup into a flat (n × dim) farr handle.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// ═══════════════════════════════════════════════════════════════════════════
//  C5 — cross-substrate META-CA proxy (4 rule families)
// ═══════════════════════════════════════════════════════════════════════════
//
//  For each rule we read off TWO emergent fixed-point scalars from the
//  recorded (N × dim) trajectory:
//    residual_ratio = mean of cell trajectory means
//       (= fraction of "past-state" retention averaged over the population;
//        Law 75 'past 50% + present 50%' equilibrium proxy)
//    gate_ratio     = mean of cell-rank-normalised activation index
//       (= rule-mixture gate analog; population activity fraction)
//
//  Both are emergent from the bare CA dynamics — NO assignment to 0.5, NO
//  annealing. Each rule family's pair (residual, gate) constitutes its Ψ
//  fixed-point estimate. Cross-rule CV is then computed.
struct RuleResult {
    rule: int
    label: string
    residual: float
    gate: float
}

fn _measure_rule(rule: int, label: string, n: int, dim: int, warm: int, rep: int) -> RuleResult {
    let states = _run_ca(rule, n, dim, warm, rep)
    // residual_ratio: mean over all (cell, t) of recorded value
    let mut rsum = 0.0
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            rsum = rsum + farr_get(states, i * dim + t)
            t = t + 1
        }
        i = i + 1
    }
    let residual = rsum / (n * dim * 1.0)
    // gate_ratio: fraction of cells whose last-step recorded value == 1
    // (population activation gate at the end of the recorded window)
    let mut on = 0.0
    let mut s = 0
    while s < n {
        if farr_get(states, s * dim + (dim - 1)) > 0.5 { on = on + 1.0 }
        s = s + 1
    }
    let gate = on / (n * 1.0)
    let _ = farr_free(states)
    return RuleResult(rule, label, residual, gate)
}

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }
fn _max2(a: float, b: float) -> float { if a > b { return a }; return b }
fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

// ═══════════════════════════════════════════════════════════════════════════
//  C6 — combination-binding via phi_spatial on isolated vs merged CA
// ═══════════════════════════════════════════════════════════════════════════
//
//  Build CA-A (rule 110) and CA-B (rule 30) trajectories with identical
//  shape (N × dim). Compute micro-Φ_A and micro-Φ_B independently. Then
//  build merged states of shape (2N × dim) by concatenating cells (NOT time)
//  and compute macro-Φ. Verdict by sign of macro - (micro_A + micro_B).
fn _build_merged(states_a: int, states_b: int, n: int, dim: int) -> int {
    let merged = farr_zeros(2 * n * dim)
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            let _ = farr_set(merged, i * dim + t, farr_get(states_a, i * dim + t))
            t = t + 1
        }
        i = i + 1
    }
    let mut j = 0
    while j < n {
        let mut t2 = 0
        while t2 < dim {
            let _ = farr_set(merged, (n + j) * dim + t2, farr_get(states_b, j * dim + t2))
            t2 = t2 + 1
        }
        j = j + 1
    }
    return merged
}

fn main() {
    println("================================================================")
    println("H_157 Law 76 Mathematical Panpsychism — Cycle #2 (C5 + C6, raw#15)")
    println("================================================================")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + " rep=0  (deterministic, $0 mac local)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa")
    println("  HONEST: proxy substrate carry from Cycle #1 (trained-net absent).")
    println("")

    // ── C5 cross-substrate: 4 elementary CA rule families ─────────────────
    println("── C5 cross-substrate Ψ probe (4 rule families) ──")
    let r30  = _measure_rule(30,  "rule030_chaotic_classIII",  _N(), _DIM(), _WARM(), 0)
    let r90  = _measure_rule(90,  "rule090_additive_classIII", _N(), _DIM(), _WARM(), 0)
    let r110 = _measure_rule(110, "rule110_complex_classIV",   _N(), _DIM(), _WARM(), 0)
    let r184 = _measure_rule(184, "rule184_traffic_classII",   _N(), _DIM(), _WARM(), 0)

    println("  rule 30  (Class-III chaotic ): residual=" + to_string(r30.residual)
            + "  gate=" + to_string(r30.gate))
    println("  rule 90  (Class-III additive): residual=" + to_string(r90.residual)
            + "  gate=" + to_string(r90.gate))
    println("  rule 110 (Class-IV  complex ): residual=" + to_string(r110.residual)
            + "  gate=" + to_string(r110.gate))
    println("  rule 184 (Class-II  traffic ): residual=" + to_string(r184.residual)
            + "  gate=" + to_string(r184.gate))

    // cross-rule statistics on the residual scalar
    let vals = [r30.residual, r90.residual, r110.residual, r184.residual]
    let mut sum = 0.0
    let mut i = 0
    while i < 4 { sum = sum + vals[i]; i = i + 1 }
    let mean = sum / 4.0
    let mut sq = 0.0
    i = 0
    while i < 4 { let d = vals[i] - mean; sq = sq + d * d; i = i + 1 }
    let std = sqrt(sq / 4.0)
    let cv = if mean != 0.0 { std / _abs(mean) } else { 0.0 }
    println("  cross-rule residual: mean=" + to_string(mean)
            + " std=" + to_string(std) + " CV=" + to_string(cv * 100.0) + "%")

    // per-rule deviation from 0.5 — for F-C5-2 Class-IV-only test
    let d30  = _abs(r30.residual  - 0.5)
    let d90  = _abs(r90.residual  - 0.5)
    let d110 = _abs(r110.residual - 0.5)
    let d184 = _abs(r184.residual - 0.5)
    println("  |Ψ - 0.5| per rule: r30=" + to_string(d30) + " r90=" + to_string(d90)
            + " r110=" + to_string(d110) + " r184=" + to_string(d184))

    // F-C5-1 UNIVERSAL: cross-rule CV ≤ 5%
    let f_c5_1 = cv <= 0.05
    // F-C5-2 CLASS-IV-ONLY: only rule 110 is within ±0.01 of 0.5
    let f_c5_2 = d110 <= 0.01 && d30 > 0.01 && d90 > 0.01 && d184 > 0.01
    // F-C5-3 DETERMIN: re-run rule 110 and compare byte-equal
    let r110b = _measure_rule(110, "rule110_complex_classIV", _N(), _DIM(), _WARM(), 0)
    let f_c5_3 = r110.residual == r110b.residual && r110.gate == r110b.gate

    println("  F-C5-1  UNIVERSAL  (CV<=5%)         : " + _bool_str(f_c5_1)
            + "  (CV=" + to_string(cv * 100.0) + "%)")
    println("  F-C5-2  CLASS-IV-ONLY (only 110 ±0.01): " + _bool_str(f_c5_2))
    println("  F-C5-3  DETERMINISM (byte-equal re-run): " + _bool_str(f_c5_3))
    println("")

    // C5 verdict classification
    let c5_verdict = if f_c5_1 {
        "C5_UNIVERSAL_PASS  (strong-panpsy supported, Cycle#1 FAIL invalidated)"
    } else if f_c5_2 {
        "C5_CLASS_IV_ONLY  (algorithm-specific, only rule110 panpsy candidate)"
    } else {
        "C5_NON_UNIVERSAL  (algorithm-property dominant, strong-panpsy unsupported)"
    }
    println("  → C5 verdict: " + c5_verdict)
    println("")

    // ── C6 combination-binding probe ──────────────────────────────────────
    println("── C6 combination-binding probe (CA-A + CA-B → merged) ──")
    let states_a = _run_ca(110, _N(), _DIM(), _WARM(), 0)
    let states_b = _run_ca(30,  _N(), _DIM(), _WARM(), 0)
    let nbins = c_phi_n_bins_default()
    let phi_a = c_measure_phi(states_a, _N(), _DIM(), nbins)
    let phi_b = c_measure_phi(states_b, _N(), _DIM(), nbins)
    let merged = _build_merged(states_a, states_b, _N(), _DIM())
    let phi_merged = c_measure_phi(merged, 2 * _N(), _DIM(), nbins)
    let sum_micro = phi_a + phi_b
    let delta = phi_merged - sum_micro

    println("  CA-A := rule 110 ring  · Φ_A      = " + to_string(phi_a))
    println("  CA-B := rule 30  ring  · Φ_B      = " + to_string(phi_b))
    println("  merged (concat cells)  · Φ_merged = " + to_string(phi_merged))
    println("  Σ micro = Φ_A + Φ_B               = " + to_string(sum_micro))
    println("  Δ = Φ_merged − Σ micro            = " + to_string(delta))

    let f_c6_1 = phi_merged >= 0.0 && phi_a >= 0.0 && phi_b >= 0.0
    let f_c6_2 = delta > 0.000001                            // super-additive
    let f_c6_3 = delta < (0.0 - 0.000001)                    // sub-additive

    println("  F-C6-1  PRIMITIVE-OK (all Φ>=0)        : " + _bool_str(f_c6_1))
    println("  F-C6-2  SUPER-ADDITIVE (Δ>0)           : " + _bool_str(f_c6_2))
    println("  F-C6-3  SUB-ADDITIVE   (Δ<0)           : " + _bool_str(f_c6_3))

    let c6_class = if !f_c6_1 {
        "PRIMITIVE_ERROR"
    } else if f_c6_2 {
        "super-additive  (combination-binding substrate-instance demonstrated)"
    } else if f_c6_3 {
        "sub-additive    (destructive interference · combination failure substrate-instance)"
    } else {
        "additive        (trivial separable · no binding observed)"
    }
    println("  → C6 verdict: " + c6_class)

    let _ = farr_free(states_a)
    let _ = farr_free(states_b)
    let _ = farr_free(merged)
    println("")

    // ── overall Cycle #2 verdict ──────────────────────────────────────────
    let cycle2_class = if f_c5_1 {
        "C5_UNIVERSAL"
    } else if f_c5_2 {
        "C5_CLASS_IV_ONLY"
    } else {
        "C5_NON_UNIVERSAL"
    }
    let cycle2_c6 = if !f_c6_1 {
        "C6_ERROR"
    } else if f_c6_2 {
        "C6_SUPER_ADDITIVE"
    } else if f_c6_3 {
        "C6_SUB_ADDITIVE"
    } else {
        "C6_ADDITIVE"
    }
    println("================================================================")
    println("Cycle #2 VERDICT: " + cycle2_class + " · " + cycle2_c6)
    println("================================================================")

    // ── write result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_157\",\n"
    j = j + "  \"cycle\": 2,\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"sub_criteria\": [\"C5\", \"C6\"],\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"substrate_note\": \"proxy CA-rule-family carry (trained-net absent · faithful run = separate GPU cycle pre-registered Cycle#1 §4)\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": {\"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"rep\": 0, \"n_bins\": " + to_string(nbins) + "},\n"
    j = j + "  \"C5\": {\n"
    j = j + "    \"rules\": {\n"
    j = j + "      \"030_chaotic_classIII\":  {\"residual\": " + to_string(r30.residual)  + ", \"gate\": " + to_string(r30.gate)  + ", \"dev_from_half\": " + to_string(d30)  + "},\n"
    j = j + "      \"090_additive_classIII\": {\"residual\": " + to_string(r90.residual)  + ", \"gate\": " + to_string(r90.gate)  + ", \"dev_from_half\": " + to_string(d90)  + "},\n"
    j = j + "      \"110_complex_classIV\":   {\"residual\": " + to_string(r110.residual) + ", \"gate\": " + to_string(r110.gate) + ", \"dev_from_half\": " + to_string(d110) + "},\n"
    j = j + "      \"184_traffic_classII\":   {\"residual\": " + to_string(r184.residual) + ", \"gate\": " + to_string(r184.gate) + ", \"dev_from_half\": " + to_string(d184) + "}\n"
    j = j + "    },\n"
    j = j + "    \"cross_rule\": {\"residual_mean\": " + to_string(mean)
          + ", \"residual_std\": " + to_string(std)
          + ", \"residual_cv_pct\": " + to_string(cv * 100.0) + "},\n"
    j = j + "    \"falsifiers\": {\n"
    j = j + "      \"F_C5_1_UNIVERSAL\":    {\"metric\": \"CV<=5%\",         \"cv_pct\": " + to_string(cv * 100.0) + ", \"verdict\": \"" + _verdict(f_c5_1) + "\"},\n"
    j = j + "      \"F_C5_2_CLASS_IV_ONLY\":{\"metric\": \"only r110 ±0.01\", \"verdict\": \"" + _verdict(f_c5_2) + "\"},\n"
    j = j + "      \"F_C5_3_DETERMINISM\":  {\"metric\": \"byte-equal rerun\",\"verdict\": \"" + _verdict(f_c5_3) + "\"}\n"
    j = j + "    },\n"
    j = j + "    \"verdict\": \"" + cycle2_class + "\"\n"
    j = j + "  },\n"
    j = j + "  \"C6\": {\n"
    j = j + "    \"phi_A_rule110\": " + to_string(phi_a) + ",\n"
    j = j + "    \"phi_B_rule030\": " + to_string(phi_b) + ",\n"
    j = j + "    \"phi_merged\": " + to_string(phi_merged) + ",\n"
    j = j + "    \"sum_micro\": " + to_string(sum_micro) + ",\n"
    j = j + "    \"delta\": " + to_string(delta) + ",\n"
    j = j + "    \"falsifiers\": {\n"
    j = j + "      \"F_C6_1_PRIMITIVE_OK\":  {\"metric\": \"all Φ>=0\",   \"verdict\": \"" + _verdict(f_c6_1) + "\"},\n"
    j = j + "      \"F_C6_2_SUPER_ADDITIVE\":{\"metric\": \"Δ>+1e-6\",    \"verdict\": \"" + _verdict(f_c6_2) + "\"},\n"
    j = j + "      \"F_C6_3_SUB_ADDITIVE\":  {\"metric\": \"Δ<-1e-6\",    \"verdict\": \"" + _verdict(f_c6_3) + "\"}\n"
    j = j + "    },\n"
    j = j + "    \"verdict\": \"" + cycle2_c6 + "\",\n"
    j = j + "    \"class\": \"" + c6_class + "\"\n"
    j = j + "  },\n"
    j = j + "  \"cycle2_verdict\": \"" + cycle2_class + " · " + cycle2_c6 + "\",\n"
    j = j + "  \"tier\": \"🟢 NUMERICAL\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_157 Cycle #2 (C5+C6) smoke complete ===")
}
