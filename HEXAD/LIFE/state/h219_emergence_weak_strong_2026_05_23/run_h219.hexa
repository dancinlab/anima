    j = j + "    \"F2_NO_STRONG\":   { \"metric\": \"B and C both predictability_index >= 0.9\", \"verdict\": \"" + _verdict(c2 || (idx_b < 0.9 && idx_c < 0.9)) + "\" },\n"
