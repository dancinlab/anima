    j = j + "      \"predictability_index\": " + to_string(idx_a) + ",\n"
    j = j + "      \"phi_sanity\": " + to_string(phi_a) + ",\n"
    j = j + "      \"strong_emergence_flag\": " + _bool_str(flag_a) + "\n"
    j = j + "    },\n"
