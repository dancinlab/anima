    j = j + "    \"C2_BC_index_below_half\":{ \"metric\": \"min(idx_b,idx_c) < 0.5\", \"idx_b\": " + to_string(idx_b) + ", \"idx_c\": " + to_string(idx_c) + ", \"verdict\": \"" + _verdict(c2) + "\" },\n"
