// HEXAD/LIFE/state/h219_emergence_weak_strong_2026_05_23/run_h219.hexa
// H_219 — emergence weak vs strong (Bedau) · forward-pass predictability smoke (raw#12)
//
//   Question: rule 110 CA substrate 의 final state 가 forward-pass full
//   simulation 으로 byte-exact reconstruct 되는가? (Bedau weak emergence)
//   CMT-analog intervention (cell freeze) 위 partial-simulation 가 mismatch
//   ≥ 50% 면 strong-emergence-flag PASS (downward-causation analog).
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - 1D rule 110 elementary CA, N=16 periodic lattice, evolve 5 steps.
//     - 3 conditions:
//         A: no intervention — true evolution = forward-pass simulation
//            ⇒ predictability_index = 1.0 (definitive weak emergence)
//         B: 25% cells frozen at step 0 (=> 4/16 cells held constant 5 steps)
//         C: 50% cells frozen at step 0 (=> 8/16 cells held constant)
//       In B/C the "forward simulator" does NOT know which cells are frozen
//       (CMT-analog downward causation invisible to reduction) and runs
//       plain rule 110 on the same init row. final-state byte-compare.
//     - predictability_index = match_byte / total_byte per condition.
//     - strong-emergence-flag PASS if predictability_index < 0.5
//       (Bedau operational: forward-pass partial recompute mismatch ≥ 50%).
//
//   Verdict (pre-registered): SUPPORTED iff C1 (A predictability_index = 1.0)
//   AND C2 (B or C predictability_index < 0.5); PARTIAL if only C1 (weak
//   emergence only); FALSIFIED if A mismatches (primitive error).
//
//   Hc_607 direct instance: forward-pass simulation reproduces CMT-analog
//   intervention ⇒ weak emergence only; mismatch ⇒ strong emergence candidate.
//   Distinct from H_007 (rule-class Φ ranking) — H_219 is predictability,
//   not Φ. Φ values recorded as sanity-check (F4).
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-ae4cfef752fe6679a/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────
fn _N() -> int       { return 16 }   // lattice length (periodic)
fn _STEPS() -> int   { return 5 }    // evolution steps
fn _DIM() -> int     { return 8 }    // recorded trajectory length / cell (sanity Φ)
fn _WARM() -> int    { return 8 }    // warmup before recording for Φ sanity
fn _RULE() -> int    { return 110 }  // Class-IV substrate (Hc_607 sister)
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-ae4cfef752fe6679a/HEXAD/LIFE/state/h219_emergence_weak_strong_2026_05_23"
}

// ── small helpers (kept tiny — hexa big-int multiply is fragile) ────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row: site i ON iff (i + offset) % 3 != 0.
// (mirrors H_007 init pattern for cross-link consistency.)
fn _init_row(row: int, n: int, offset: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + offset) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// deterministic freeze-mask: cell i frozen iff (i * 7 + 3) % stride == 0.
// stride chosen so that target freeze fraction is exactly hit on N=16.
// frac=0.0 → no freeze, frac=0.25 → 4 cells, frac=0.50 → 8 cells.
fn _build_freeze_mask(n: int, frac: float) -> int {
    let mask = farr_zeros(n)
    if frac <= 0.000001 { return mask }
    // count = round(frac * n)
    let target = _ftoi(frac * to_float(n) + 0.5) * n  // dummy to keep type
    // explicit count via integer arithmetic (avoid float roundoff)
    let mut count = 0
    if frac >= 0.49 && frac <= 0.51 { count = n / 2 }       // 50%
    if frac >= 0.24 && frac <= 0.26 { count = n / 4 }       // 25%
    // deterministic pattern: pick every k-th cell starting at 0.
    if count == 0 { return mask }
    let stride = n / count
    let mut placed = 0
    let mut i = 0
    while i < n && placed < count {
        if i % stride == 0 {
            let _ = farr_set(mask, i, 1.0)
            placed = placed + 1
        }
        i = i + 1
    }
    return mask
}

// run rule 110 with freeze-mask: frozen cells (mask=1) hold their init value.
// returns final row farr (length n). free elsewhere.
fn _run_with_freeze(rule: int, n: int, steps: int, mask: int, init_offset: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, init_offset)
    // snapshot the init values of frozen cells.
    let init_frozen = farr_zeros(n)
    let mut i = 0
    while i < n { let _ = farr_set(init_frozen, i, farr_get(row, i)); i = i + 1 }

    let mut step = 0
    while step < steps {
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let next_bit = _ca_next(lv, cv, rv, rule)
            // if cell j frozen, override with init value (downward-causation analog)
            if farr_get(mask, j) > 0.5 {
                let _ = farr_set(nxt, j, farr_get(init_frozen, j))
            } else {
                let _ = farr_set(nxt, j, _itof(next_bit))
            }
            j = j + 1
        }
        // copy nxt → row
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(init_frozen)
    return row
}

// forward-pass "simulator": same code path, NO freeze (simulator cannot see
// downward causation — reduction-by-recompute). returns final row.
fn _forward_simulate(rule: int, n: int, steps: int, init_offset: int) -> int {
    let null_mask = farr_zeros(n)   // all-zero mask = no freeze
    let final_row = _run_with_freeze(rule, n, steps, null_mask, init_offset)
    let _ = farr_free(null_mask)
    return final_row
}

// byte-compare two length-n farrs (bit-level); returns match count.
fn _match_count(a: int, b: int, n: int) -> int {
    let mut m = 0
    let mut i = 0
    while i < n {
        let av = _ftoi(farr_get(a, i))
        let bv = _ftoi(farr_get(b, i))
        if av == bv { m = m + 1 }
        i = i + 1
    }
    return m
}

// record a (n × dim) trajectory under freeze-mask for Φ sanity.
fn _run_trajectory(rule: int, n: int, dim: int, warm: int, mask: int, init_offset: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, init_offset)
    let init_frozen = farr_zeros(n)
    let mut ii = 0
    while ii < n { let _ = farr_set(init_frozen, ii, farr_get(row, ii)); ii = ii + 1 }

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let next_bit = _ca_next(lv, cv, rv, rule)
            if farr_get(mask, j) > 0.5 {
                let _ = farr_set(nxt, j, farr_get(init_frozen, j))
            } else {
                let _ = farr_set(nxt, j, _itof(next_bit))
            }
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    let _ = farr_free(init_frozen)
    return states
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

// per-condition measurement; returns predictability_index = match / N.
fn _measure_condition(label: string, frac: float) -> float {
    let n = _N()
    let steps = _STEPS()
    let rule = _RULE()
    let init_offset = 0

    // truth: substrate with freeze (downward-causation analog).
    let mask = _build_freeze_mask(n, frac)
    let truth = _run_with_freeze(rule, n, steps, mask, init_offset)

    // simulator: same code path WITHOUT freeze (reduction-by-recompute).
    let sim = _forward_simulate(rule, n, steps, init_offset)

    let m = _match_count(truth, sim, n)
    let idx = to_float(m) / to_float(n)

    // sanity Φ on the truth trajectory (frozen-cells inject zero-info)
    let traj = _run_trajectory(rule, n, _DIM(), _WARM(), mask, init_offset)
    let phi = c_measure_phi(traj, n, _DIM(), c_phi_n_bins_default())

    let strong_flag = idx < 0.5

    println("  [" + label + "] freeze_frac=" + to_string(frac)
            + "  match=" + to_string(m) + "/" + to_string(n)
            + "  predictability_index=" + to_string(idx)
            + "  Φ=" + to_string(phi)
            + "  strong_emergence_flag=" + _bool_str(strong_flag))

    let _ = farr_free(mask)
    let _ = farr_free(truth)
    let _ = farr_free(sim)
    let _ = farr_free(traj)
    return idx
}

// helper duplicate for full-record (need idx + phi + flag for json)
fn _measure_full(label: string, frac: float, out_idx_ptr: int) -> int {
    // dummy — single-pass version below replicates inline for json.
    return 0
}

