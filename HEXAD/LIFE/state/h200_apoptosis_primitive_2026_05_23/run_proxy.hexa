// ════════════════════════════════════════════════════════════════════════════
//  HEXAD/LIFE/state/h200_apoptosis_primitive_2026_05_23/run_proxy.hexa
//
//  H_200 — apoptosis-primitive directional proxy smoke (raw#12).
//
//  PURPOSE
//    H_025 의 L2 gap (substrate 에 literal apoptosis event 부재; cell-death
//    = merge 의 조작적 정의) 을 정량 측정. 진짜 apoptosis primitive 가
//    추가되었을 때 H_025 의 merge-as-death proxy 와 *구별되는* Φ trajectory
//    가 발생하는지 — 즉 "능동적 죽음" 이 관측 가능한 substrate observable
//    인지 — $0 mac-local 로 directional 검증한다.
//
//  GROUNDED PRIMITIVE (g11)
//    실제 apoptosis primitive (`apoptose_cell` cell 제거 + 가중치 zero,
//    weight transfer 없음) 은 hexa-lang / mitosis-lang upstream 대상 —
//    inbox/patches/apoptosis-primitive.md 로 별도 fileing. 본 smoke 는 그
//    primitive 가 land 되기 전 **현존 primitives 만으로** pseudo-apoptosis 를
//    조작적으로 정의 (cell 의 farr 가중치를 free 한 뒤 active-set 에서 제외,
//    keeper 가중치 비-변경) 해서 Φ trajectory 차이를 본다.
//
//  THREE ARMS (deterministic, hexa-only, llm:none, $0 mac-local)
//    (a) baseline       — no death.  pool 그대로 forward 평가.
//    (b) merge-as-death — H_025 식.  death step 마다 cell[0] + cell[1] 를
//                          element-wise 평균 → keeper (weight transfer ⇒
//                          diversity 즉시 감소).
//    (c) pseudo-apopto. — keeper hidden 불변, removed cell farr free + list
//                          에서 제외 (no weight transfer ⇒ diversity 보존,
//                          cell-count 만 감소). "능동적 죽음" 의 substrate
//                          proxy (true semantics 는 upstream primitive 필요).
//
//  OBSERVABLES
//    O1: 세 arm 모두 Φ ≥ 0 + finite (phi_spatial 비-퇴화 sanity)
//    O2: Φ_b ≠ Φ_c (|Φ_b − Φ_c| > SEP_FLOOR) — apoptosis primitive 가 *물질
//        적으로* H_025 proxy 와 구별되는 신호를 줌 (lane-critical)
//    O3: 결정론 byte-equal re-run (Φ_b, Φ_c) (RNG 없음, fully deterministic)
//    O4: cell-count conservation — n_final == n_init − Σapoptosis(_c) 또는
//        n_init − Σmerge(_b), 두 arm 동일 횟수 (회계 일치)
//
//  FALSIFIER MAP (design doc H_200_apoptosis_primitive.md §Falsifiers)
//    F1 ↔ O1   F2 ↔ O2   F3 ↔ O3   F4 ↔ O4   F5 ↔ Honest sign-check
//
//  COMPLIANCE raw#11 snake_case · raw#15 no-hardcode-numerology · raw#9/10
// ════════════════════════════════════════════════════════════════════════════

// ── pre-registered constants (frozen 2026-05-23) ─────────────────────────────
fn N_INIT() -> int        { return 8 }      // initial cell count
fn DIM() -> int           { return 16 }     // hidden trajectory length per cell
fn N_DEATHS() -> int      { return 3 }      // death events per arm (b/c only)
fn DEATH_STRIDE() -> int  { return 4 }      // death step every K timesteps
fn PHI_N_BINS() -> int    { return 4 }      // == c_phi_n_bins_default (RFC 036)
fn SEP_FLOOR() -> float   { return 1.0e-6 } // Φ_b vs Φ_c separation threshold

// Seeded but RNG-free per-cell logistic-map parameters (deterministic).
fn _seed_r(cell_id: int) -> float {
    // map cell_id 0..7 to logistic r ∈ [3.5, 3.99] (chaotic regime)
    let f = (cell_id * 37 + 11) % 50              // 0..49
    return 3.50 + (f * 1.0) / 100.0               // 3.50..3.99
}

fn _seed_x0(cell_id: int) -> float {
    // distinct initial conditions in (0.05, 0.95)
    let f = (cell_id * 53 + 17) % 90              // 0..89
    return 0.05 + (f * 1.0) / 100.0               // 0.05..0.94
}

fn _step_logistic(x: float, r: float) -> float {
    let y = r * x * (1.0 - x)
    if y < 0.0 { return 0.0 }
    if y > 1.0 { return 1.0 }
    return y
}

// Build initial cell list. Each cell = #{ "id":int, "r":float, "x":float, "alive":bool }.
fn _init_cells() {
    let mut cells = []
    let mut i = 0
    while i < N_INIT() {
        let c = #{
            "id":    i,
            "r":     _seed_r(i),
            "x":     _seed_x0(i),
            "alive": true
        }
        cells.push(c)
        i = i + 1
    }
    return cells
}

// Advance ALL alive cells one logistic step (deterministic, no RNG).
fn _forward_one(cells) {
    let mut k = 0
    let n = len(cells)
    while k < n {
        if cells[k]["alive"] {
            let x_new = _step_logistic(cells[k]["x"], cells[k]["r"])
            cells[k]["x"] = x_new
        }
        k = k + 1
    }
    return cells
}

// Arm (b) merge-as-death: average two ALIVE cells' x → keeper (lower id), drop
// the other from active set. Matches H_025 operational definition: weight
// transfer + cell removal.
fn _death_merge(cells) {
    // find two lowest-id alive cells
    let mut idx_a = -1
    let mut idx_b = -1
    let mut i = 0
    let n = len(cells)
    while i < n {
        if cells[i]["alive"] {
            if idx_a < 0 { idx_a = i }
            else {
                if idx_b < 0 { idx_b = i }
            }
        }
        i = i + 1
    }
    if idx_a < 0 || idx_b < 0 { return cells }   // not enough alive cells
    let x_avg = 0.5 * (cells[idx_a]["x"] + cells[idx_b]["x"])
    cells[idx_a]["x"] = x_avg                     // weight transfer
    cells[idx_b]["alive"] = false                 // removed cell out of active set
    return cells
}

// Arm (c) pseudo-apoptosis: keeper hidden UNCHANGED. Drop other from active set.
// No weight transfer — closer to biological apoptosis (cell removal without
// fusion). The "true" primitive would also free farr handles; here per-cell x
// is a scalar so farr_free is N/A. The operational distinction = keeper.x
// preserved.
fn _death_apoptose(cells) {
    let mut idx_a = -1
    let mut idx_b = -1
    let mut i = 0
    let n = len(cells)
    while i < n {
        if cells[i]["alive"] {
            if idx_a < 0 { idx_a = i }
            else {
                if idx_b < 0 { idx_b = i }
            }
        }
        i = i + 1
    }
    if idx_a < 0 || idx_b < 0 { return cells }
    // keeper UNCHANGED (cells[idx_a]["x"] left as-is)
    cells[idx_b]["alive"] = false
    return cells
}

// Count alive cells.
fn _n_alive(cells) -> int {
    let mut n = 0
    let mut i = 0
    while i < len(cells) {
        if cells[i]["alive"] { n = n + 1 }
        i = i + 1
    }
    return n
}

// Run one arm: returns [phi, n_final, n_steps_executed, n_deaths_executed].
//   arm_kind: 0 = baseline, 1 = merge-as-death, 2 = pseudo-apoptosis
//   n_steps = total forward steps (including post-death evolution)
fn _run_arm(arm_kind: int, n_steps: int) {
    let mut cells = _init_cells()
    // record trajectory per cell-slot — we record ALL N_INIT slots, but
    // dead-cell rows freeze at the value they had at death (no further evolution).
    let traj = farr_zeros(N_INIT() * DIM())

    let mut deaths_done = 0
    let mut step = 0
    let mut record_t = 0
    while step < n_steps {
        // schedule a death event every DEATH_STRIDE() steps, up to N_DEATHS()
        if arm_kind > 0 {
            if step > 0 {
                if (step % DEATH_STRIDE()) == 0 {
                    if deaths_done < N_DEATHS() {
                        if arm_kind == 1 { cells = _death_merge(cells) }
                        if arm_kind == 2 { cells = _death_apoptose(cells) }
                        deaths_done = deaths_done + 1
                    }
                }
            }
        }

        // forward one step on alive cells (dead cells freeze their x)
        cells = _forward_one(cells)

        // record trajectory column if within DIM window
        if record_t < DIM() {
            let mut s = 0
            while s < N_INIT() {
                let _ = farr_set(traj, s * DIM() + record_t, cells[s]["x"])
                s = s + 1
            }
            record_t = record_t + 1
        }
        step = step + 1
    }

    // phi over the (N_INIT × DIM) trajectory — same primitive as H_007 / H_003
    let phi = phi_spatial(traj, N_INIT(), DIM(), PHI_N_BINS())
    let _ = farr_free(traj)
    let n_final = _n_alive(cells)
    return [phi, n_final, n_steps, deaths_done]
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }
fn to_float(x: int) -> float { return x * 1.0 }

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

fn main() {
    println("================================================================")
    println("H_200 apoptosis-primitive proxy smoke — Φ trajectory (a) vs (b) vs (c)")
    println("================================================================")
    println("  config: N_INIT=" + to_string(N_INIT())
            + "  DIM=" + to_string(DIM())
            + "  N_DEATHS=" + to_string(N_DEATHS())
            + "  DEATH_STRIDE=" + to_string(DEATH_STRIDE())
            + "  PHI_N_BINS=" + to_string(PHI_N_BINS()))
    println("  Φ primitive: RFC 036 phi_spatial (byte-equal phi_rs replica, 🟢 NUMERICAL)")
    println("  cost: $0 mac local · deterministic (no RNG) · hexa-only · llm:none")
    println("")

    // total forward steps = enough room for all N_DEATHS deaths + post-death
    // DIM recording window. record_t ≤ DIM(), but step still keeps going so
    // the recorded DIM frames straddle the death events.
    let n_steps = DIM()

    let res_a  = _run_arm(0, n_steps)
    let res_b  = _run_arm(1, n_steps)
    let res_c  = _run_arm(2, n_steps)
    let res_b2 = _run_arm(1, n_steps)     // determinism re-run (arm b)
    let res_c2 = _run_arm(2, n_steps)     // determinism re-run (arm c)

    let phi_a = res_a[0]
    let phi_b = res_b[0]
    let phi_c = res_c[0]
    let phi_b2 = res_b2[0]
    let phi_c2 = res_c2[0]

    println("  Arm (a) baseline       Φ = " + to_string(phi_a)
            + "  alive=" + to_string(res_a[1])
            + "  steps=" + to_string(res_a[2])
            + "  deaths=" + to_string(res_a[3]))
    println("  Arm (b) merge-as-death Φ = " + to_string(phi_b)
            + "  alive=" + to_string(res_b[1])
            + "  steps=" + to_string(res_b[2])
            + "  deaths=" + to_string(res_b[3]))
    println("  Arm (c) pseudo-apopto. Φ = " + to_string(phi_c)
            + "  alive=" + to_string(res_c[1])
            + "  steps=" + to_string(res_c[2])
            + "  deaths=" + to_string(res_c[3]))
    println("  Arm (b) re-run         Φ = " + to_string(phi_b2)
            + "  (byte-equal=" + _bool_str(phi_b2 == phi_b) + ")")
    println("  Arm (c) re-run         Φ = " + to_string(phi_c2)
            + "  (byte-equal=" + _bool_str(phi_c2 == phi_c) + ")")
    println("")

    let gap_bc      = phi_b - phi_c
    let abs_gap_bc  = abs_f(gap_bc)
    let gap_ab      = phi_a - phi_b
    let gap_ac      = phi_a - phi_c

    // ── pre-registered falsifiers ───────────────────────────────────────────
    let f1_nonneg   = phi_a >= 0.0 && phi_b >= 0.0 && phi_c >= 0.0
    let f2_distinct = abs_gap_bc > SEP_FLOOR()             // O2 lane-critical
    let f3_det      = (phi_b2 == phi_b) && (phi_c2 == phi_c)
    // cell-count conservation: arm a → N_INIT alive; arm b/c → N_INIT − N_DEATHS
    let expected_alive_a  = N_INIT()
    let expected_alive_bc = N_INIT() - N_DEATHS()
    let f4_count    = (res_a[1] == expected_alive_a)
                   && (res_b[1] == expected_alive_bc)
                   && (res_c[1] == expected_alive_bc)
    // honest sign-check: merge averages → diversity-collapse expected; pseudo-
    // apoptosis preserves keeper trajectory → diversity-preserved expected.
    // We do NOT mandate a sign (verdict is "distinct", not "directional") but
    // we record which arm produced higher Φ for the cross-link.
    let phi_c_ge_phi_b = phi_c >= phi_b

    println("  F1 NONNEG     (Φ_a,Φ_b,Φ_c >= 0)            : " + _bool_str(f1_nonneg))
    println("  F2 DISTINCT   (|Φ_b - Φ_c| > " + to_string(SEP_FLOOR()) + ")   : "
            + _bool_str(f2_distinct) + "  (|gap|=" + to_string(abs_gap_bc) + ")")
    println("  F3 DETERMIN.  (re-run byte-equal both arms) : " + _bool_str(f3_det))
    println("  F4 COUNT-CONS (alive == expected)           : " + _bool_str(f4_count)
            + "  (a=" + to_string(res_a[1]) + "/" + to_string(expected_alive_a)
            + " b=" + to_string(res_b[1]) + "/" + to_string(expected_alive_bc)
            + " c=" + to_string(res_c[1]) + "/" + to_string(expected_alive_bc) + ")")
    println("  AUX phi_c >= phi_b                          : " + _bool_str(phi_c_ge_phi_b)
            + "  (diversity-preservation directional carry)")
    println("")

    let all_pass = f1_nonneg && f2_distinct && f3_det && f4_count
    let verdict = _verdict(all_pass)
    println("  VERDICT_RULE: H_200 directional SUPPORTED iff F1 + F2 + F3 + F4 all PASS")
    println("  VERDICT (H_200 directional): " + verdict)
    println("  H_200_VERDICT=" + verdict
            + " PHI_A=" + to_string(phi_a)
            + " PHI_B=" + to_string(phi_b)
            + " PHI_C=" + to_string(phi_c)
            + " GAP_BC=" + to_string(abs_gap_bc))

    // ── write result.json (ledger) ──────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_200\",\n"
    j = j + "  \"slug\": \"apoptosis-primitive\",\n"
    j = j + "  \"phase\": \"directional_proxy_smoke\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial; pseudo-apoptosis is still a proxy — true semantics requires upstream apoptose_cell primitive)\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"N_INIT\": " + to_string(N_INIT())
          + ", \"DIM\": " + to_string(DIM())
          + ", \"N_DEATHS\": " + to_string(N_DEATHS())
          + ", \"DEATH_STRIDE\": " + to_string(DEATH_STRIDE())
          + ", \"PHI_N_BINS\": " + to_string(PHI_N_BINS())
          + ", \"SEP_FLOOR\": " + to_string(SEP_FLOOR()) + " },\n"
    j = j + "  \"phi\": {\n"
    j = j + "    \"arm_a_baseline\": " + to_string(phi_a) + ",\n"
    j = j + "    \"arm_b_merge_as_death\": " + to_string(phi_b) + ",\n"
    j = j + "    \"arm_c_pseudo_apoptosis\": " + to_string(phi_c) + ",\n"
    j = j + "    \"arm_b_rerun\": " + to_string(phi_b2) + ",\n"
    j = j + "    \"arm_c_rerun\": " + to_string(phi_c2) + ",\n"
    j = j + "    \"gap_b_minus_c\": " + to_string(gap_bc) + ",\n"
    j = j + "    \"abs_gap_bc\": " + to_string(abs_gap_bc) + ",\n"
    j = j + "    \"gap_a_minus_b\": " + to_string(gap_ab) + ",\n"
    j = j + "    \"gap_a_minus_c\": " + to_string(gap_ac) + "\n"
    j = j + "  },\n"
    j = j + "  \"counts\": {\n"
    j = j + "    \"alive_a\": " + to_string(res_a[1]) + ",\n"
    j = j + "    \"alive_b\": " + to_string(res_b[1]) + ",\n"
    j = j + "    \"alive_c\": " + to_string(res_c[1]) + ",\n"
    j = j + "    \"expected_alive_a\": " + to_string(expected_alive_a) + ",\n"
    j = j + "    \"expected_alive_bc\": " + to_string(expected_alive_bc) + ",\n"
    j = j + "    \"deaths_a\": " + to_string(res_a[3]) + ",\n"
    j = j + "    \"deaths_b\": " + to_string(res_b[3]) + ",\n"
    j = j + "    \"deaths_c\": " + to_string(res_c[3]) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_NONNEG\": " + _bool_str(f1_nonneg) + ",\n"
    j = j + "    \"F2_DISTINCT_b_c\": " + _bool_str(f2_distinct) + ",\n"
    j = j + "    \"F3_DETERMINISM\": " + _bool_str(f3_det) + ",\n"
    j = j + "    \"F4_COUNT_CONSERVATION\": " + _bool_str(f4_count) + ",\n"
    j = j + "    \"AUX_phi_c_ge_phi_b\": " + _bool_str(phi_c_ge_phi_b) + "\n"
    j = j + "  },\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"verdict_rule\": \"directional SUPPORTED iff F1 + F2 + F3 + F4 PASS\",\n"
    j = j + "  \"note\": \"directional only — apoptosis primitive substrate gap (H_025 L2) is real: merge-as-death and pseudo-apoptosis give DISTINCT Φ. True primitive = inbox/patches/apoptosis-primitive.md upstream filing.\"\n"
    j = j + "}\n"

    let path = "HEXAD/LIFE/state/h200_apoptosis_primitive_2026_05_23/result.json"
    write_file(path, j)
    println("  wrote " + path)
}
