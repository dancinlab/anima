// test_ces.hexa — unit tests for the IIT 4.0 CES kernel (faithfulness checks).
import "/Users/ghost/core/anima/.claude/worktrees/agent-a88b67ef21cd30f19/HEXAD/LIFE/state/h280_iit4_ces_2026_05_26/lib_ces.hexa"

fn _f(x: float) -> string { return str(x) }

fn main() {
    println("=== H_280 CES kernel unit tests ===")

    // T1: ID(p,q) = max_x p log2(p/q). p=[1,0], q=[0.5,0.5] -> 1*log2(2)=1.0
    let p = farr_zeros(2)
    let _ = farr_set(p, 0, 1.0)
    let _ = farr_set(p, 1, 0.0)
    let q = farr_zeros(2)
    let _ = farr_set(q, 0, 0.5)
    let _ = farr_set(q, 1, 0.5)
    let id1 = ces_id(p, q, 2)
    println("T1 ID([1,0],[.5,.5]) = " + _f(id1) + "  (expect 1.0)")

    // T2: ID(p,p) = 0  (identical distributions)
    let id2 = ces_id(p, p, 2)
    println("T2 ID(p,p) = " + _f(id2) + "  (expect 0.0)")

    // T3: effect repertoire normalizes to 1 over its purview.
    //   n=3 INTEGRATED (majority), mechanism = unit 0 ON, effect purview = all.
    let m_mask = 1            // {unit 0}
    let m_state = 1           // unit 0 = ON
    let z_all = 7             // {0,1,2}
    let er = ces_effect_repertoire(m_mask, m_state, z_all, 3, 2, 0.0)
    let mut sum_e = 0.0
    let mut i = 0
    while i < 8 { sum_e = sum_e + farr_get(er, i); i = i + 1 }
    println("T3 effect rep sum = " + _f(sum_e) + "  (expect ~1.0)")
    let _ = farr_free(er)

    // T4: cause repertoire normalizes to 1.
    let cr = ces_cause_repertoire(m_mask, m_state, z_all, 3, 2, 0.0)
    let mut sum_c = 0.0
    let mut j = 0
    while j < 8 { sum_c = sum_c + farr_get(cr, j); j = j + 1 }
    println("T4 cause rep sum = " + _f(sum_c) + "  (expect ~1.0)")
    let _ = farr_free(cr)

    // T5: DISCONNECTED substrate (rule 0): a single unit copies itself.
    //   effect repertoire of {0=ON} over purview {1} should be ~uniform
    //   (unit 1 independent of unit 0) -> effect φ over {1} = 0.
    let phi_e_disc = ces_phi_mech_purview(1, 1, 2, 1, 3, 0, 0.0)  // M={0}, Z={1}, effect
    println("T5 disconnected effect-φ(M{0},Z{1}) = " + _f(phi_e_disc) + "  (expect ~0)")

    // T6: full distinction for unit 0 in INTEGRATED net (state all-ON = 7).
    let d_int = ces_distinction(1, 1, 3, 2, 0.0)
    println("T6 integrated distinction M{0}: phi_c=" + _f(d_int["phi_cause"])
        + " phi_e=" + _f(d_int["phi_effect"]) + " phi_d=" + _f(d_int["phi_d"])
        + " is_dist=" + str(d_int["is_distinction"]))

    // T7: same distinction in DISCONNECTED net -> phi_d should be ~0
    //   (a self-copy unit is still self-predictive, so cause/effect over {0}
    //    itself can be > 0; over multi-unit purviews the cut is free. The
    //    DIRECTION test at system level is what matters — here just print.)
    let d_disc = ces_distinction(1, 1, 3, 0, 0.0)
    println("T7 disconnected distinction M{0}: phi_c=" + _f(d_disc["phi_cause"])
        + " phi_e=" + _f(d_disc["phi_effect"]) + " phi_d=" + _f(d_disc["phi_d"]))

    let _ = farr_free(p)
    let _ = farr_free(q)
    println("=== tests done ===")
}
