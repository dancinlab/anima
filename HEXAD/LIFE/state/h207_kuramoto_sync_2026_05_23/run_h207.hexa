// HEXAD/LIFE/state/h207_kuramoto_sync_2026_05_23/run_h207.hexa
// H_207 — Kuramoto coupled-oscillator edge-of-sync Φ peak (raw#12).
//
//   Question: do N=16 Kuramoto coupled oscillators with deterministic
//   natural-frequency spread exhibit an inverse-U Φ(K) pattern over the
//   coupling sweep K ∈ {0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 5.0}?
//
//   Prediction: Φ peaks at K ≈ K_c (edge-of-sync, partial sync) —
//   Kuramoto coupling-axis analog of H_007 Wolfram class-axis
//   edge-of-chaos Φ peak. K << K_c (incoherent) → low Φ. K >> K_c
//   (hyper-sync) → low Φ (over-lock integration loss, H_204 inverse-U
//   sister).
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - N=16 oscillators, θ_i(0) deterministic init (uniform spread on
//       [0, 2π), offset by i).
//     - ω_i deterministic — 5 Gaussian-quantile frequencies cycled
//       (z-quantiles {-1.28, -0.52, 0.0, 0.52, 1.28} scaled by ω_std=1.0,
//       centered ω_0=0.0).
//     - K sweep: 7 values.
//     - Euler integration dθ_i/dt = ω_i + (K/N) Σ_j sin(θ_j - θ_i),
//       dt=0.05, 100 steps.
//     - Encode final state to CA-like via per-osc bin(cos θ, sin θ) →
//       bin pair on n_bins=4 per axis; flat state vector length 2N
//       (cos-axis bin sequence then sin-axis bin sequence).
//     - Measure Φ = c_measure_phi(state, 2N, 1, 4) per K.
//     - Measure order parameter r(K) = |Σ exp(iθ_j)| / N = sqrt(C^2+S^2)/N.
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → RFC 036 phi_spatial, byte-equal phi_rs replica).
//
//   Sister H_007 (physics class-axis edge-of-chaos Φ peak) — H_207 is
//   the dynamical / coupling-axis sister: same inverse-U Φ pattern on
//   a CONTINUOUS coupling parameter instead of a 4-class CA rule axis.
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a0cce6780d01b85a8/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────
fn _N() -> int      { return 16 }      // # oscillators
fn _STEPS() -> int  { return 100 }     // Euler integration steps
fn _WARM() -> int   { return 60 }      // warmup steps before recording trajectory
fn _DIM() -> int    { return 12 }      // recorded temporal-trajectory length / osc
fn _NBINS() -> int  { return 4 }       // bin count per cos θ axis
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a0cce6780d01b85a8/HEXAD/LIFE/state/h207_kuramoto_sync_2026_05_23"
}

fn _dt() -> float       { return 0.05 }
fn _omega_std() -> float { return 1.0 }
fn _two_pi() -> float    { return 6.283185307179586 }

// ── small helpers ───────────────────────────────────────────────────────
fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// 5 deterministic z-quantiles of N(0,1) (cycled to N=16 → 3·3 + 3·3 + 4·3 = 16
// via i % 5). centered, mean ≈ 0.
fn _omega_i(i: int) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    return z * _omega_std()
}

// natural-freq distribution peak density g(ω_0) of std-normal at 0 = 1/sqrt(2π).
// K_c (mean-field, Kuramoto 1975) = 2 / (π · g(ω_0)) for ω_std=1
//                                   = 2 / (π · 1/sqrt(2π))
//                                   = 2 · sqrt(2π) / π
//                                   = 2 · sqrt(2/π)
//                                   ≈ 1.5957691216057308
// (scales linearly with ω_std for our 5-quantile discretised distribution.)
fn _Kc_estimate() -> float {
    let pi = 3.141592653589793
    let two_over_pi = 2.0 / pi
    return 2.0 * sqrt(two_over_pi) * _omega_std()
}

// deterministic initial phase: uniform spread on [0, 2π) by index.
fn _theta0(i: int, n: int) -> float {
    return _two_pi() * (i * 1.0) / (n * 1.0)
}

// run Kuramoto for given K, record per-osc trajectory of `dim` cos θ_i
// snapshots after `warm` steps. returns flat (N × dim) trajectory farr —
// states[ i * dim + t ] = cos θ_i at recorded step t.
// final θ vector populated into theta_out (caller pre-allocates).
fn _run_kuramoto_traj(K: float, theta_out: int) -> int {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let steps = _STEPS()
    let dt = _dt()
    let n_record = steps - warm        // # recorded steps == dim by construction

    let theta = farr_zeros(n)
    let mut i = 0
    while i < n { farr_set(theta, i, _theta0(i, n)); i = i + 1 }

    let states = farr_zeros(n * dim)

    let mut s = 0
    while s < steps {
        if s >= warm {
            let t = s - warm
            if t < dim {
                let mut k = 0
                while k < n {
                    farr_set(states, k * dim + t, cos(farr_get(theta, k)))
                    k = k + 1
                }
            }
        }
        let next = farr_zeros(n)
        let mut a = 0
        while a < n {
            let theta_a = farr_get(theta, a)
            let mut coupling_sum = 0.0
            let mut b = 0
            while b < n {
                let theta_b = farr_get(theta, b)
                coupling_sum = coupling_sum + sin(theta_b - theta_a)
                b = b + 1
            }
            let omega_a = _omega_i(a)
            let dtheta = omega_a + (K / (n * 1.0)) * coupling_sum
            farr_set(next, a, theta_a + dt * dtheta)
            a = a + 1
        }
        let mut k = 0
        while k < n { farr_set(theta, k, farr_get(next, k)); k = k + 1 }
        farr_free(next)
        s = s + 1
    }
    // copy final θ into caller's buffer
    let mut m = 0
    while m < n { farr_set(theta_out, m, farr_get(theta, m)); m = m + 1 }
    farr_free(theta)
    return states
}

// order parameter r = | Σ exp(i θ_j) | / N.
fn _order_param(theta: int) -> float {
    let n = _N()
    let mut C = 0.0
    let mut S = 0.0
    let mut i = 0
    while i < n {
        let t = farr_get(theta, i)
        C = C + cos(t)
        S = S + sin(t)
        i = i + 1
    }
    return sqrt(C * C + S * S) / (n * 1.0)
}

// per-K (Φ, r) measurement.
//   Φ = phi_spatial(traj, N, dim=12, n_bins=4) over cos θ trajectories
//     (each oscillator = 1 IIT cell, its dim-step cos θ trajectory =
//      state vector; phi_spatial bins continuous values into 4 bins).
//   r = |Σ exp(i θ_j)| / N on the FINAL θ vector (steady-state coherence).
fn _measure_phi_r(K: float) -> int {
    let n = _N()
    let dim = _DIM()
    let theta_final = farr_zeros(n)
    let traj = _run_kuramoto_traj(K, theta_final)
    let r = _order_param(theta_final)
    let phi = c_measure_phi(traj, n, dim, _NBINS())
    farr_free(traj)
    farr_free(theta_final)
    let out = farr_zeros(2)
    farr_set(out, 0, phi)
    farr_set(out, 1, r)
    return out
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_207 — Kuramoto coupled-oscillator edge-of-sync Φ peak (raw#12)")
    println("  N=" + to_string(_N()) + " steps=" + to_string(_STEPS())
            + " warm=" + to_string(_WARM()) + " dim=" + to_string(_DIM())
            + " dt=" + to_string(_dt())
            + " nbins=" + to_string(_NBINS()) + "  (deterministic, $0 mac local)")
    println("  ω_i: 5 Gaussian-quantile (z={-1.28,-0.52,0,0.52,1.28}) cycled by i%5, std=" + to_string(_omega_std()))
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.)")
    let Kc = _Kc_estimate()
    println("  K_c estimate (mean-field, 2/(π·g(ω_0))) = " + to_string(Kc))
    println("")

    // ── K sweep (7 values) ────────────────────────────────────────────────
    let n_sweep = 7
    let Ks = farr_zeros(n_sweep)
    farr_set(Ks, 0, 0.0)
    farr_set(Ks, 1, 0.5)
    farr_set(Ks, 2, 1.0)
    farr_set(Ks, 3, 1.5)
    farr_set(Ks, 4, 2.0)
    farr_set(Ks, 5, 3.0)
    farr_set(Ks, 6, 5.0)

    let phis = farr_zeros(n_sweep)
    let rs   = farr_zeros(n_sweep)
    let mut k_i = 0
    while k_i < n_sweep {
        let K = farr_get(Ks, k_i)
        let pr = _measure_phi_r(K)
        let phi = farr_get(pr, 0)
        let r   = farr_get(pr, 1)
        farr_set(phis, k_i, phi)
        farr_set(rs,   k_i, r)
        farr_free(pr)
        println("  K=" + to_string(K) + "   Φ=" + to_string(phi) + "   r=" + to_string(r))
        k_i = k_i + 1
    }
    println("")

    // ── find Φ peak K* ────────────────────────────────────────────────────
    let mut phi_peak_idx = 0
    let mut phi_peak_val = farr_get(phis, 0)
    let mut i = 1
    while i < n_sweep {
        let v = farr_get(phis, i)
        if v > phi_peak_val {
            phi_peak_val = v
            phi_peak_idx = i
        }
        i = i + 1
    }
    let K_star = farr_get(Ks, phi_peak_idx)
    let phi_K0 = farr_get(phis, 0)
    let phi_K5 = farr_get(phis, n_sweep - 1)   // K=5.0

    // ── dr/dK (forward diff, peak idx in [0, n_sweep-2]) ──────────────────
    // peak of dr/dK over forward differences.
    let mut drdk_peak_idx = 0
    let mut drdk_peak_val = 0.0
    let mut j = 0
    while j < n_sweep - 1 {
        let dK = farr_get(Ks, j + 1) - farr_get(Ks, j)
        let dr = farr_get(rs, j + 1) - farr_get(rs, j)
        let slope = dr / dK
        if j == 0 { drdk_peak_val = slope; drdk_peak_idx = 0 }
        if slope > drdk_peak_val {
            drdk_peak_val = slope
            drdk_peak_idx = j
        }
        j = j + 1
    }
    // dr/dK forward diff at index j represents slope between Ks[j] and Ks[j+1];
    // the "K at peak slope" is treated as the midpoint sweep-index (closer of the two).
    // for C3 we compare against phi_peak_idx with ±1 sweep-step tolerance.

    // ── criteria ──────────────────────────────────────────────────────────
    // C1 (H207.1): single peak in interior — peak idx ∈ {1..n_sweep-2}
    //              AND strictly greater than both K=0 and K=5.0.
    let c1_interior  = phi_peak_idx >= 1 && phi_peak_idx <= n_sweep - 2
    let c1_above_k0  = phi_peak_val > phi_K0
    let c1_above_k5  = phi_peak_val > phi_K5
    let c1 = c1_interior && c1_above_k0 && c1_above_k5

    // C2 (H207.2): Φ(K*) / Φ(K=0) >= 1.2.
    // (Note: phi_K0 may be ≈0 with incoherent state — use absolute floor.)
    let ratio_floor = 0.000001
    let ratio = if phi_K0 > ratio_floor { phi_peak_val / phi_K0 } else { phi_peak_val / ratio_floor }
    let c2 = ratio >= 1.2

    // C3 (H207.3): dr/dK peak idx within ±1 sweep-step of phi_peak_idx.
    // (slope index j corresponds to "between Ks[j] and Ks[j+1]" — compare to
    //  phi_peak_idx with idx ∈ {phi_peak_idx-1, phi_peak_idx}).
    let mut c3 = false
    if drdk_peak_idx == phi_peak_idx - 1 { c3 = true }
    if drdk_peak_idx == phi_peak_idx     { c3 = true }
    if drdk_peak_idx == phi_peak_idx + 1 { c3 = true }

    // C4 (H207.4): Φ(K=5.0) < Φ(K*) with margin >= 10% of Φ(K*).
    let margin = phi_peak_val - phi_K5
    let margin_floor = 0.1 * phi_peak_val
    let c4 = margin >= margin_floor && phi_peak_val > 0.0

    let n_pass = (if c1 { 1 } else { 0 })
               + (if c2 { 1 } else { 0 })
               + (if c3 { 1 } else { 0 })
               + (if c4 { 1 } else { 0 })

    // verdict_rule: SUPPORTED if C1+C2+C4 PASS (3 of 4 named); FALSIFIED if Φ monotone.
    let supported = c1 && c2 && c4
    let monotone_no_peak = !c1_interior
    let verdict = if supported { "SUPPORTED" } else { if monotone_no_peak { "FALSIFIED" } else { "PARTIAL" } }

    println("  K* (Φ peak)       = " + to_string(K_star) + "  (idx=" + to_string(phi_peak_idx) + ")")
    println("  Φ(K*)             = " + to_string(phi_peak_val))
    println("  Φ(K=0)            = " + to_string(phi_K0))
    println("  Φ(K=5.0)          = " + to_string(phi_K5))
    println("  dr/dK peak idx    = " + to_string(drdk_peak_idx) + "  (between K=" + to_string(farr_get(Ks, drdk_peak_idx)) + " and K=" + to_string(farr_get(Ks, drdk_peak_idx + 1)) + ")")
    println("  Φ(K*)/Φ(K=0) ratio= " + to_string(ratio))
    println("  Φ peak − Φ(K=5.0) = " + to_string(margin) + "  (floor 10%·Φ(K*) = " + to_string(margin_floor) + ")")
    println("")
    println("  C1 H207.1 single peak (interior + > K=0 + > K=5.0) : " + _bool_str(c1))
    println("  C2 H207.2 Φ(K*) >= 1.2·Φ(K=0)                       : " + _bool_str(c2))
    println("  C3 H207.3 dr/dK peak within ±1 sweep-step of Φ peak  : " + _bool_str(c3))
    println("  C4 H207.4 Φ(K=5.0) < Φ(K*) margin >= 10%            : " + _bool_str(c4))
    println("")
    println("  VERDICT_RULE: SUPPORTED if C1+C2+C4 PASS; FALSIFIED if Φ(K) monotone no peak")
    println("  VERDICT     : " + verdict + "  (criteria_met=" + to_string(n_pass) + "/4)")

    // ── write result.json ────────────────────────────────────────────────
    let mut o = "{\n"
    o = o + "  \"id\": \"H_207\",\n"
    o = o + "  \"slug\": \"kuramoto-synchronization\",\n"
    o = o + "  \"date\": \"2026-05-23\",\n"
    o = o + "  \"deterministic\": true,\n"
    o = o + "  \"hexa_only\": true,\n"
    o = o + "  \"llm\": \"none\",\n"
    o = o + "  \"cost\": \"$0 mac local\",\n"
    o = o + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    o = o + "  \"config\": { \"N\": " + to_string(_N()) + ", \"steps\": " + to_string(_STEPS())
          + ", \"warm\": " + to_string(_WARM()) + ", \"dim\": " + to_string(_DIM())
          + ", \"dt\": " + to_string(_dt()) + ", \"omega_std\": " + to_string(_omega_std())
          + ", \"n_bins\": " + to_string(_NBINS())
          + ", \"omega_quantiles_z\": [-1.28, -0.52, 0.0, 0.52, 1.28] },\n"
    o = o + "  \"Kc_estimate\": " + to_string(Kc) + ",\n"
    o = o + "  \"K_sweep\": [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 5.0],\n"
    o = o + "  \"phi_per_K\": [\n"
    let mut p = 0
    while p < n_sweep {
        o = o + "    " + to_string(farr_get(phis, p))
        if p < n_sweep - 1 { o = o + "," }
        o = o + "\n"
        p = p + 1
    }
    o = o + "  ],\n"
    o = o + "  \"r_per_K\": [\n"
    let mut q = 0
    while q < n_sweep {
        o = o + "    " + to_string(farr_get(rs, q))
        if q < n_sweep - 1 { o = o + "," }
        o = o + "\n"
        q = q + 1
    }
    o = o + "  ],\n"
    o = o + "  \"K_star\": " + to_string(K_star) + ",\n"
    o = o + "  \"K_star_idx\": " + to_string(phi_peak_idx) + ",\n"
    o = o + "  \"phi_star\": " + to_string(phi_peak_val) + ",\n"
    o = o + "  \"phi_K0\": " + to_string(phi_K0) + ",\n"
    o = o + "  \"phi_K5\": " + to_string(phi_K5) + ",\n"
    o = o + "  \"drdk_peak_idx\": " + to_string(drdk_peak_idx) + ",\n"
    o = o + "  \"drdk_peak_value\": " + to_string(drdk_peak_val) + ",\n"
    o = o + "  \"ratio_phi_star_over_phi_K0\": " + to_string(ratio) + ",\n"
    o = o + "  \"phi_star_minus_phi_K5_margin\": " + to_string(margin) + ",\n"
    o = o + "  \"criteria\": {\n"
    o = o + "    \"C1_H207_1_single_peak\":          { \"verdict\": \"" + _verdict(c1) + "\" },\n"
    o = o + "    \"C2_H207_2_ratio_1p2_over_K0\":    { \"value\": " + to_string(ratio) + ", \"floor\": 1.2, \"verdict\": \"" + _verdict(c2) + "\" },\n"
    o = o + "    \"C3_H207_3_drdk_peak_coincide\":   { \"phi_peak_idx\": " + to_string(phi_peak_idx) + ", \"drdk_peak_idx\": " + to_string(drdk_peak_idx) + ", \"verdict\": \"" + _verdict(c3) + "\" },\n"
    o = o + "    \"C4_H207_4_overlock_loss\":        { \"margin\": " + to_string(margin) + ", \"floor_10pct\": " + to_string(margin_floor) + ", \"verdict\": \"" + _verdict(c4) + "\" }\n"
    o = o + "  },\n"
    o = o + "  \"verdict_rule\": \"SUPPORTED iff C1+C2+C4 PASS (3 of 4 named); FALSIFIED iff Φ(K) monotone no peak\",\n"
    o = o + "  \"criteria_met\": " + to_string(n_pass) + ",\n"
    o = o + "  \"verdict\": \"" + verdict + "\"\n"
    o = o + "}\n"
    write_file(_state_dir() + "/result.json", o)

    farr_free(Ks)
    farr_free(phis)
    farr_free(rs)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_207 Kuramoto → Φ sweep complete: " + verdict + " ===")
}
