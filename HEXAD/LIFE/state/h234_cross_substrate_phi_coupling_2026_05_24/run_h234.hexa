// HEXAD/LIFE/state/h234_cross_substrate_phi_coupling_2026_05_24/run_h234.hexa
// H_234 — cross-substrate Φ-coupling-density meta-instance.
//
//   Hypothesis: H_204 (closure-strength k ↔ Φ, Spearman ρ=1.0), H_223 (pain
//   intensity ↔ ΔΦ, Pearson r=0.9994), H_211 (Shannon entropy ↔ Φ, Pearson
//   r=0.933) 의 3 high-correlation finding 의 underlying = single substrate-
//   level invariant. 동일 substrate (rule 110 N=16, H_232 cliff-collapse 회피)
//   위 3 axis 를 동시 sweep (3 level each = 27 cell + baseline) 한 후 composite
//   intensity 위 Φ 의 linear fit R² ≥ 0.6 이면 unified Φ-coupling-density
//   invariant supported.
//
//   AXES:
//     axis-A: closure-strength k (H_204 carry — cross-cell coupling factor)
//             k ∈ {0.0, 0.3, 0.6}
//     axis-B: entropy proxy h via initial-state offset modulation (H_211 carry)
//             h ∈ {0, 1, 2} (offset levels)
//     axis-C: pain-perturbation intensity c (H_223 carry — multi-cell burst)
//             c ∈ {0.0, 0.5, 1.0}
//
//   COMPOSITE: composite[i,j,l] = (k_i / k_max + h_j / h_max + c_l / c_max) / 3
//                                 (simple normalize-and-sum, L3 carry)
//
//   PREDICTIONS (raw#12 frozen):
//     H234.1: Φ monotone across ≥ 2 axis (marginal sweep, holding other 2 axis @ 0)
//     H234.2: 모든 3 marginal Pearson r ≥ 0.5
//     H234.3: composite intensity 위 Φ linear R² ≥ 0.6
//     H234.4: interaction (cross-term magnitude) < main-effect sum (additive dominant)
//     H234.5: re-run byte-identical
//
//   VERDICT_RULE: SUPPORTED iff H234.1 (C1) ∧ H234.2 (C2) PASS.
//                 PARTIAL = 1/2. FALSIFIED = 0/2.
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → RFC 036 phi_spatial, byte-equal phi_rs replica).
//   Cross-link: H_204 (closure-axis), H_211 (entropy-axis), H_223 (pain-axis),
//               H_232 (cliff-collapse avoidance — rule 110 stays > 0 at t≤12).
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-ab28f3ed80755a8c0/HEXAD/C/c_lib.hexa"

// ── config (deterministic, frozen) ──────────────────────────────────────
fn _N() -> int    { return 16 }   // lattice length (periodic)
fn _DIM() -> int  { return 12 }   // recorded temporal-trajectory length / cell (H_232 cliff-window 회피)
fn _WARM() -> int { return 8 }    // warmup steps before recording
fn _RULE() -> int { return 110 }  // Class-IV (edge-of-chaos)
fn _PERTURB_CELL() -> int { return 0 }   // cell-0 (deterministic; 'pain locus')
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-ab28f3ed80755a8c0/HEXAD/LIFE/state/h234_cross_substrate_phi_coupling_2026_05_24"
}

// ── axis level helpers ──────────────────────────────────────────────────
fn _N_LEV() -> int { return 3 }

fn _k_at(i: int) -> float {
    if i == 0 { return 0.0 }
    if i == 1 { return 0.3 }
    return 0.6
}
fn _h_at(j: int) -> int {
    return j   // offset levels: 0, 1, 2
}
fn _c_at(l: int) -> float {
    if l == 0 { return 0.0 }
    if l == 1 { return 0.5 }
    return 1.0
}
fn _k_max() -> float { return 0.6 }
fn _h_max() -> float { return 2.0 }
fn _c_max() -> float { return 1.0 }

// ── small helpers ───────────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }
fn _max2(a: float, b: float) -> float { if a > b { return a }; return b }

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row: site i set iff (i + offset) % 3 != 0.
fn _init_row(row: int, n: int, offset: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + offset) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA with initial offset h.
// records each site's trajectory of `dim` steps (after `warm`) into
// states[ site*dim + t ]. returns farr.
fn _run_ca(rule: int, n: int, dim: int, warm: int, h_offset: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, h_offset)

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut p = 0
        while p < n { let _ = farr_set(row, p, farr_get(nxt, p)); p = p + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// apply closure-coupling k to recorded trajectory states (axis-A).
// k=0 → identity. k>0 → mix each cell's trajectory with periodic-neighbor
// trajectories: states'[s,t] = (1-k)*states[s,t] + (k/2)*(states[(s-1)%n,t] + states[(s+1)%n,t]).
// 동일 (states_in == states_out) ref OK — copy first.
fn _apply_closure(states: int, n: int, dim: int, k_closure: float) -> int {
    if k_closure <= 0.0 { return 1 }
    let total = n * dim
    let tmp = farr_zeros(total)
    let mut i = 0
    while i < total { let _ = farr_set(tmp, i, farr_get(states, i)); i = i + 1 }
    let half = k_closure / 2.0
    let one_m = 1.0 - k_closure
    let mut s = 0
    while s < n {
        let lj = (s + n - 1) % n
        let rj = (s + 1) % n
        let mut t = 0
        while t < dim {
            let v = one_m * farr_get(tmp, s * dim + t)
                  + half  * (farr_get(tmp, lj * dim + t) + farr_get(tmp, rj * dim + t))
            let _ = farr_set(states, s * dim + t, v)
            t = t + 1
        }
        s = s + 1
    }
    let _ = farr_free(tmp)
    return 1
}

// apply pain perturbation (axis-C, H_223 multi-cell graded burst, identical
// shape). intensity c ∈ {0.0, 0.5, 1.0} → k_cells ∈ {1, 4, 8}.
fn _apply_pain(states: int, n: int, dim: int, cell: int, intensity: float) -> int {
    if intensity <= 0.0 { return 1 }
    let half_n = n / 2
    let mut k = (intensity * (half_n * 1.0)) as int + 1
    if k > n { k = n }
    if k < 1 { k = 1 }
    let mut c = 0
    while c < k {
        let c_off = (cell + c) % n
        let phase_mul = (c + 1) * 1.0 * 0.6
        let mut t = 0
        while t < dim {
            let base = farr_get(states, c_off * dim + t)
            let pain = sin((t * 1.0) * phase_mul + intensity)
            let new_val = base + intensity * pain
            let _ = farr_set(states, c_off * dim + t, new_val)
            t = t + 1
        }
        c = c + 1
    }
    return 1
}

// measure Φ for a specific (i, j, l) axis cell: rule 110 N=16 evolved with
// offset h, then closure-mix at k, then pain-burst at c.
fn _measure_phi_ijl(rule: int, n: int, dim: int, warm: int, nbins: int,
                    cell: int, i_k: int, j_h: int, l_c: int) -> float {
    let h_off = _h_at(j_h)
    let states = _run_ca(rule, n, dim, warm, h_off)
    let _ = _apply_closure(states, n, dim, _k_at(i_k))
    let _ = _apply_pain(states, n, dim, cell, _c_at(l_c))
    let phi = c_measure_phi(states, n, dim, nbins)
    let _ = farr_free(states)
    return phi
}

// Pearson r over (x_i, y_i), i = 0..n-1.
fn _pearson_r(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + farr_get(xs, i)
        sy = sy + farr_get(ys, i)
        i = i + 1
    }
    let mx = sx / (n * 1.0)
    let my = sy / (n * 1.0)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom = sqrt(dx2 * dy2)
    if denom <= 0.0 { return 0.0 }
    return num / denom
}

// linear-fit R² over (x_i, y_i), i = 0..n-1. R² := r².
fn _r_squared(xs: int, ys: int, n: int) -> float {
    let r = _pearson_r(xs, ys, n)
    return r * r
}

// monotone non-decreasing check on (xs in already-sorted order, ys) — strict.
fn _is_monotone(ys: int, n: int) -> bool {
    let mut m = 1
    let mut ok = true
    while m < n {
        let prev = farr_get(ys, m - 1)
        let cur  = farr_get(ys, m)
        if cur + 0.000000001 < prev { ok = false }
        m = m + 1
    }
    return ok
}

fn main() {
    println("H_234 — cross-substrate Φ-coupling-density meta-instance (raw#12)")
    println("  substrate: rule " + to_string(_RULE())
            + " N=" + to_string(_N())
            + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM())
            + " (H_232 cliff-collapse 회피)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.)")
    println("  3 axis × 3 levels = 27 cell + baseline (deterministic, $0 mac local)")
    println("    axis-A closure k ∈ {0.0, 0.3, 0.6}")
    println("    axis-B entropy h ∈ {0, 1, 2}   (offset levels)")
    println("    axis-C pain    c ∈ {0.0, 0.5, 1.0}")
    println("")

    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let rule = _RULE()
    let nbins = c_phi_n_bins_default()
    let cell = _PERTURB_CELL()
    let nlev = _N_LEV()

    // ── 27-cell sweep ───────────────────────────────────────────────────
    // store Φ in flat farr [27], same order as (i*9 + j*3 + l).
    let n_cells = nlev * nlev * nlev
    let phis = farr_zeros(n_cells)
    let composites = farr_zeros(n_cells)
    let baseline_phi = _measure_phi_ijl(rule, n, dim, warm, nbins, cell, 0, 0, 0)

    println("  Φ_baseline (k=0, h=0, c=0)         = " + to_string(baseline_phi))
    println("")
    println("  27-cell VERBATIM (i,j,l) → (k,h,c) → composite → Φ:")
    let mut i = 0
    while i < nlev {
        let mut j = 0
        while j < nlev {
            let mut l = 0
            while l < nlev {
                let phi_ijl = _measure_phi_ijl(rule, n, dim, warm, nbins, cell, i, j, l)
                let idx = i * nlev * nlev + j * nlev + l
                let _ = farr_set(phis, idx, phi_ijl)
                let composite = (_k_at(i) / _k_max()
                               + (_h_at(j) * 1.0) / _h_max()
                               + _c_at(l) / _c_max()) / 3.0
                let _ = farr_set(composites, idx, composite)

                println("    idx=" + to_string(idx)
                        + "  (i=" + to_string(i) + ",j=" + to_string(j) + ",l=" + to_string(l) + ")"
                        + "  k=" + to_string(_k_at(i))
                        + " h=" + to_string(_h_at(j))
                        + " c=" + to_string(_c_at(l))
                        + "  comp=" + to_string(composite)
                        + "  Φ=" + to_string(phi_ijl))
                l = l + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    println("")

    // ── marginal sweep (3 axis, holding other 2 axis @ 0) ───────────────
    // axis-A marginal: (i, 0, 0) for i ∈ {0,1,2}
    let xs_a = farr_zeros(nlev)
    let ys_a = farr_zeros(nlev)
    let mut ai = 0
    while ai < nlev {
        let _ = farr_set(xs_a, ai, _k_at(ai))
        let _ = farr_set(ys_a, ai, farr_get(phis, ai * nlev * nlev + 0 + 0))
        ai = ai + 1
    }

    // axis-B marginal: (0, j, 0) for j ∈ {0,1,2}
    let xs_b = farr_zeros(nlev)
    let ys_b = farr_zeros(nlev)
    let mut bj = 0
    while bj < nlev {
        let _ = farr_set(xs_b, bj, _h_at(bj) * 1.0)
        let _ = farr_set(ys_b, bj, farr_get(phis, 0 + bj * nlev + 0))
        bj = bj + 1
    }

    // axis-C marginal: (0, 0, l) for l ∈ {0,1,2}
    let xs_c = farr_zeros(nlev)
    let ys_c = farr_zeros(nlev)
    let mut cl = 0
    while cl < nlev {
        let _ = farr_set(xs_c, cl, _c_at(cl))
        let _ = farr_set(ys_c, cl, farr_get(phis, 0 + 0 + cl))
        cl = cl + 1
    }

    let r_a = _pearson_r(xs_a, ys_a, nlev)
    let r_b = _pearson_r(xs_b, ys_b, nlev)
    let r_c = _pearson_r(xs_c, ys_c, nlev)

    let mono_a = _is_monotone(ys_a, nlev)
    let mono_b = _is_monotone(ys_b, nlev)
    let mono_c = _is_monotone(ys_c, nlev)
    let mut mono_count = 0
    if mono_a { mono_count = mono_count + 1 }
    if mono_b { mono_count = mono_count + 1 }
    if mono_c { mono_count = mono_count + 1 }

    println("  marginal sweeps (holding other 2 axis @ 0):")
    println("    axis-A closure: Φ = [" + to_string(farr_get(ys_a, 0))
            + ", " + to_string(farr_get(ys_a, 1))
            + ", " + to_string(farr_get(ys_a, 2)) + "]"
            + "  r=" + to_string(r_a) + "  monotone=" + _bool_str(mono_a))
    println("    axis-B entropy: Φ = [" + to_string(farr_get(ys_b, 0))
            + ", " + to_string(farr_get(ys_b, 1))
            + ", " + to_string(farr_get(ys_b, 2)) + "]"
            + "  r=" + to_string(r_b) + "  monotone=" + _bool_str(mono_b))
    println("    axis-C pain   : Φ = [" + to_string(farr_get(ys_c, 0))
            + ", " + to_string(farr_get(ys_c, 1))
            + ", " + to_string(farr_get(ys_c, 2)) + "]"
            + "  r=" + to_string(r_c) + "  monotone=" + _bool_str(mono_c))
    println("")

    // ── composite linear fit R² over all 27 cells ───────────────────────
    let composite_r2 = _r_squared(composites, phis, n_cells)
    let composite_r  = _pearson_r(composites, phis, n_cells)
    println("  composite intensity (27 cells) Pearson r = " + to_string(composite_r))
    println("  composite linear fit R²                  = " + to_string(composite_r2))
    println("")

    // ── interaction vs main-effect (H234.4) ─────────────────────────────
    // main-effect sum = |Φ(2,0,0) - Φ(0,0,0)| + |Φ(0,2,0) - Φ(0,0,0)| + |Φ(0,0,2) - Φ(0,0,0)|
    // cross-term magnitude = |Φ(2,2,2) - Φ(0,0,0) - main-effect sum|   (deviation from additivity)
    let phi_000 = farr_get(phis, 0)
    let phi_200 = farr_get(phis, 2 * nlev * nlev + 0 + 0)
    let phi_020 = farr_get(phis, 0 + 2 * nlev + 0)
    let phi_002 = farr_get(phis, 0 + 0 + 2)
    let phi_222 = farr_get(phis, 2 * nlev * nlev + 2 * nlev + 2)
    let main_a = _abs(phi_200 - phi_000)
    let main_b = _abs(phi_020 - phi_000)
    let main_c = _abs(phi_002 - phi_000)
    let main_sum = main_a + main_b + main_c
    let additive_pred = phi_000 + (phi_200 - phi_000) + (phi_020 - phi_000) + (phi_002 - phi_000)
    let cross_term = _abs(phi_222 - additive_pred)
    let additive_dominant = cross_term < main_sum
    println("  interaction analysis:")
    println("    Φ(0,0,0) = " + to_string(phi_000))
    println("    Φ(2,0,0) = " + to_string(phi_200) + "  main-A = " + to_string(main_a))
    println("    Φ(0,2,0) = " + to_string(phi_020) + "  main-B = " + to_string(main_b))
    println("    Φ(0,0,2) = " + to_string(phi_002) + "  main-C = " + to_string(main_c))
    println("    Φ(2,2,2) = " + to_string(phi_222) + "  additive_pred = " + to_string(additive_pred))
    println("    cross_term = |Φ(2,2,2) - additive_pred| = " + to_string(cross_term))
    println("    main_sum  = " + to_string(main_sum))
    println("    additive_dominant (H234.4)              = " + _bool_str(additive_dominant))
    println("")

    // ── determinism re-run (one cell repeat) ────────────────────────────
    let phi_222_re = _measure_phi_ijl(rule, n, dim, warm, nbins, cell, 2, 2, 2)
    let det_ok = phi_222_re == phi_222
    println("  Φ(2,2,2) re-run = " + to_string(phi_222_re)
            + "  (byte-equal=" + _bool_str(det_ok) + ")")
    println("")

    // ── criteria & verdict ──────────────────────────────────────────────
    let c1_mono = mono_count >= 2
    let c2_marg = (r_a >= 0.5) && (r_b >= 0.5) && (r_c >= 0.5)
    let c3_comp = composite_r2 >= 0.6
    let c4_byte = det_ok
    let c5_addi = additive_dominant
    let mut np = 0
    if c1_mono { np = np + 1 }
    if c2_marg { np = np + 1 }
    if c3_comp { np = np + 1 }
    if c4_byte { np = np + 1 }
    if c5_addi { np = np + 1 }

    println("  C1 monotone ≥ 2 axis        : " + _verdict(c1_mono)
            + "  (mono_count=" + to_string(mono_count) + "/3)")
    println("  C2 all marginal r ≥ 0.5     : " + _verdict(c2_marg)
            + "  (r_a=" + to_string(r_a)
            + " r_b=" + to_string(r_b)
            + " r_c=" + to_string(r_c) + ")")
    println("  C3 composite R² ≥ 0.6       : " + _verdict(c3_comp)
            + "  (R²=" + to_string(composite_r2) + ")")
    println("  C4 byte-identical re-run    : " + _verdict(c4_byte))
    println("  C5 additive dominant (H234.4): " + _verdict(c5_addi))

    // F5: any Φ NaN check (in practice phi_spatial returns ≥ 0; we test for
    // non-negative across all 27 cells as proxy for "no NaN/Inf shenanigans").
    let mut f5_bad = false
    let mut p = 0
    while p < n_cells {
        let v = farr_get(phis, p)
        if v < 0.0 { f5_bad = true }
        p = p + 1
    }
    println("  F5 all Φ ≥ 0 (no NaN/neg)   : " + _verdict(!f5_bad))

    let supported = c1_mono && c2_marg
    let verdict_str = if supported { "SUPPORTED" } else { if c1_mono || c2_marg { "PARTIAL" } else { "FALSIFIED" } }

    println("")
    println("  VERDICT_RULE: SUPPORTED iff C1 (≥2 monotone axis) AND C2 (all marginal r≥0.5)")
    println("  VERDICT     : " + verdict_str)
    println("    criteria_met = " + to_string(np) + "/5")

    // ── write result.json ───────────────────────────────────────────────
    let mut s = "{\n"
    s = s + "  \"id\": \"H_234\",\n"
    s = s + "  \"slug\": \"cross-substrate-phi-coupling-density\",\n"
    s = s + "  \"cycle\": \"Cycle_10_LIFE_H_234_NEW\",\n"
    s = s + "  \"date\": \"2026-05-24\",\n"
    s = s + "  \"deterministic\": true,\n"
    s = s + "  \"hexa_only\": true,\n"
    s = s + "  \"llm\": \"none\",\n"
    s = s + "  \"cost\": \"$0 mac local\",\n"
    s = s + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    s = s + "  \"config\": { \"N\": " + to_string(_N())
          + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM())
          + ", \"rule\": " + to_string(_RULE())
          + ", \"perturb_cell\": " + to_string(_PERTURB_CELL())
          + ", \"n_bins\": " + to_string(nbins)
          + ", \"boundary\": \"periodic\" },\n"
    s = s + "  \"axes\": {\n"
    s = s + "    \"A_closure_k\": [0.0, 0.3, 0.6],\n"
    s = s + "    \"B_entropy_h\": [0, 1, 2],\n"
    s = s + "    \"C_pain_c\":    [0.0, 0.5, 1.0]\n"
    s = s + "  },\n"
    s = s + "  \"baseline_phi\": " + to_string(baseline_phi) + ",\n"

    // 27 phis array
    s = s + "  \"phi_27\": ["
    let mut q = 0
    while q < n_cells {
        s = s + to_string(farr_get(phis, q))
        if q < n_cells - 1 { s = s + ", " }
        q = q + 1
    }
    s = s + "],\n"

    // 27 composites array
    s = s + "  \"composite_27\": ["
    let mut q2 = 0
    while q2 < n_cells {
        s = s + to_string(farr_get(composites, q2))
        if q2 < n_cells - 1 { s = s + ", " }
        q2 = q2 + 1
    }
    s = s + "],\n"

    s = s + "  \"marginal\": {\n"
    s = s + "    \"axis_A_closure\": {\n"
    s = s + "      \"x\": [" + to_string(farr_get(xs_a, 0)) + ", " + to_string(farr_get(xs_a, 1)) + ", " + to_string(farr_get(xs_a, 2)) + "],\n"
    s = s + "      \"phi\": [" + to_string(farr_get(ys_a, 0)) + ", " + to_string(farr_get(ys_a, 1)) + ", " + to_string(farr_get(ys_a, 2)) + "],\n"
    s = s + "      \"pearson_r\": " + to_string(r_a) + ",\n"
    s = s + "      \"monotone\": " + _bool_str(mono_a) + "\n"
    s = s + "    },\n"
    s = s + "    \"axis_B_entropy\": {\n"
    s = s + "      \"x\": [" + to_string(farr_get(xs_b, 0)) + ", " + to_string(farr_get(xs_b, 1)) + ", " + to_string(farr_get(xs_b, 2)) + "],\n"
    s = s + "      \"phi\": [" + to_string(farr_get(ys_b, 0)) + ", " + to_string(farr_get(ys_b, 1)) + ", " + to_string(farr_get(ys_b, 2)) + "],\n"
    s = s + "      \"pearson_r\": " + to_string(r_b) + ",\n"
    s = s + "      \"monotone\": " + _bool_str(mono_b) + "\n"
    s = s + "    },\n"
    s = s + "    \"axis_C_pain\": {\n"
    s = s + "      \"x\": [" + to_string(farr_get(xs_c, 0)) + ", " + to_string(farr_get(xs_c, 1)) + ", " + to_string(farr_get(xs_c, 2)) + "],\n"
    s = s + "      \"phi\": [" + to_string(farr_get(ys_c, 0)) + ", " + to_string(farr_get(ys_c, 1)) + ", " + to_string(farr_get(ys_c, 2)) + "],\n"
    s = s + "      \"pearson_r\": " + to_string(r_c) + ",\n"
    s = s + "      \"monotone\": " + _bool_str(mono_c) + "\n"
    s = s + "    }\n"
    s = s + "  },\n"
    s = s + "  \"composite_pearson_r\": " + to_string(composite_r) + ",\n"
    s = s + "  \"composite_r_squared\": " + to_string(composite_r2) + ",\n"
    s = s + "  \"interaction\": {\n"
    s = s + "    \"phi_000\": " + to_string(phi_000) + ",\n"
    s = s + "    \"phi_200\": " + to_string(phi_200) + ",\n"
    s = s + "    \"phi_020\": " + to_string(phi_020) + ",\n"
    s = s + "    \"phi_002\": " + to_string(phi_002) + ",\n"
    s = s + "    \"phi_222\": " + to_string(phi_222) + ",\n"
    s = s + "    \"main_effect_sum\": " + to_string(main_sum) + ",\n"
    s = s + "    \"cross_term\": " + to_string(cross_term) + ",\n"
    s = s + "    \"additive_dominant\": " + _bool_str(additive_dominant) + "\n"
    s = s + "  },\n"
    s = s + "  \"determinism_recheck\": {\n"
    s = s + "    \"phi_222\":    " + to_string(phi_222) + ",\n"
    s = s + "    \"phi_222_re\": " + to_string(phi_222_re) + ",\n"
    s = s + "    \"byte_equal\": " + _bool_str(det_ok) + "\n"
    s = s + "  },\n"
    s = s + "  \"criteria\": {\n"
    s = s + "    \"C1_mono_ge_2_axis\":        " + _bool_str(c1_mono) + ",\n"
    s = s + "    \"C2_all_marginal_r_ge_0_5\": " + _bool_str(c2_marg) + ",\n"
    s = s + "    \"C3_composite_r2_ge_0_6\":   " + _bool_str(c3_comp) + ",\n"
    s = s + "    \"C4_byte_identical\":        " + _bool_str(c4_byte) + ",\n"
    s = s + "    \"C5_additive_dominant\":     " + _bool_str(c5_addi) + "\n"
    s = s + "  },\n"
    s = s + "  \"criteria_met\": " + to_string(np) + ",\n"
    s = s + "  \"falsifiers\": {\n"
    s = s + "    \"F1_NO_MONOTONE_AXIS\":    { \"verdict\": \"" + _verdict(mono_count >= 1) + "\", \"mono_count\": " + to_string(mono_count) + " },\n"
    s = s + "    \"F2_MARGINAL_R_LT_0_3\":   { \"verdict\": \"" + _verdict(r_a >= 0.3 && r_b >= 0.3 && r_c >= 0.3) + "\" },\n"
    s = s + "    \"F3_COMPOSITE_R2_LT_0_3\": { \"verdict\": \"" + _verdict(composite_r2 >= 0.3) + "\" },\n"
    s = s + "    \"F4_BYTE_DIFF\":           { \"verdict\": \"" + _verdict(c4_byte) + "\" },\n"
    s = s + "    \"F5_PHI_NAN_OR_NEG\":      { \"verdict\": \"" + _verdict(!f5_bad) + "\" }\n"
    s = s + "  },\n"
    s = s + "  \"verdict_rule\": \"SUPPORTED iff C1 (≥2 monotone axis) AND C2 (all marginal r≥0.5); PARTIAL = 1/2; FALSIFIED = 0/2\",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"
    write_file(_state_dir() + "/result.json", s)

    let _ = farr_free(phis)
    let _ = farr_free(composites)
    let _ = farr_free(xs_a); let _ = farr_free(ys_a)
    let _ = farr_free(xs_b); let _ = farr_free(ys_b)
    let _ = farr_free(xs_c); let _ = farr_free(ys_c)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_234 cross-substrate Φ-coupling-density smoke complete: " + verdict_str + " ===")
}
