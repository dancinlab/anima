// ════════════════════════════════════════════════════════════════════════════
//  run_h259.hexa — H_259 aging-senescence (life-extended axis · raw#12)
//
//  CORE QUESTION
//    If each cell carries an age-cumulative weight decay
//        w *= (1 - d)^age      (age = steps since birth)
//    so its engine weights shrink as it gets older, does the natural
//    death-rate (death = decayed weight-norm "health" falling below a
//    death threshold) rise MONOTONICALLY with cell age — i.e. trace a
//    Gompertz-like senescence curve?
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model=8, initial_cells=8)
//    real mitosis engine_a_W / engine_g_W weights are the decaying material;
//    each cell's "health" = mean(||engine_a_W||, ||engine_g_W||) read live
//    from the farr handles AFTER decay is applied in place.
//    seed via __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) — deterministic.
//
//  AGING MODEL (per step, per cell)
//    1. age[cell] += 1
//    2. apply multiplicative decay to BOTH engine weight farrs:
//         w[k] *= (1 - d)      (compounded each step ⇒ effective (1-d)^age)
//    3. health = 0.5 * (||engine_a_W|| + ||engine_g_W||) / sqrt(weight_n)
//       (root-mean-square magnitude, scale-free in d_model)
//    4. death if health < death_threshold → record (age_at_death) in age-bin
//    5. replace a dead cell with a fresh young cell (age 0) — constant
//       population N so death-rate per age-bin is well-defined (a renewal
//       process; classic actuarial life-table set-up).
//
//  SWEEP  decay rate d ∈ {low=0.02, mid=0.06, high=0.12}
//  STEPS  T = 400 (long enough for many renewal cycles per d)
//  AGE-BINS  width=5, bins 0..MAX_AGE_BIN (capped); per bin:
//     n_at_risk  = cell-steps spent at that age (denominator)
//     n_deaths   = deaths that occurred at that age (numerator)
//     death_rate = n_deaths / n_at_risk
//
//  MEASURE
//    * per d : age-binned death_rate[] + survival curve S(age)
//    * monotone(death_rate vs age) — Gompertz-like rise
//    * curve left-shift with higher d — median lifespan(d) monotone ↓
//
//  CRITERIA (pre-registered — verdict_rule)
//    C1 (senescence)  : death_rate monotone NON-DECREASING in age
//                       (counted over populated bins; ≥ 80% adjacent steps
//                        non-decreasing AND last_bin_rate > first_bin_rate)
//    C2 (decay-dose)  : higher d ⇒ curve left-shift, i.e. median lifespan
//                       monotone strictly DECREASING: L(low) > L(mid) > L(high)
//    C3 (determinism) : re-run all numeric outputs byte-equal
//    SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = ¬C1
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "HEXAD/LIFE/state/h259_aging_senescence_2026_05_25"
}
fn _d_model() -> int   { return 8 }
fn _pool_n() -> int    { return 8 }
fn _seed() -> int      { return 42 }
fn _steps() -> int     { return 400 }
fn _bin_width() -> int { return 5 }
fn _max_age_bin() -> int { return 24 }   // 25 bins (ages 0..124 via width 5)
// death_threshold — health (RMS weight magnitude) below this ⇒ death.
// init RMS ≈ init_sigma = 1/sqrt(8) ≈ 0.3536; decay shrinks it toward 0.
fn _death_threshold() -> float { return 0.15 }
fn _d_low() -> float   { return 0.02 }
fn _d_mid() -> float   { return 0.06 }
fn _d_high() -> float  { return 0.12 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

// RMS magnitude of a farr handle of length n.
fn _farr_rms(h: int, n: int) -> float {
    if n <= 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let v = farr_get(h, i)
        s = s + v * v
        i = i + 1
    }
    return _sqrt_safe(s / to_float(n))
}

// Multiply every element of a farr handle in place by factor f.
fn _farr_scale_inplace(h: int, n: int, f: float) {
    let mut i = 0
    while i < n {
        let _ = farr_set(h, i, farr_get(h, i) * f)
        i = i + 1
    }
    return 0
}

fn _int_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}


// ── deterministic init-weight buffer ─────────────────────────────────────────
// The hexa gaussian RNG (RFC 033) is a process-local stream with no reseed
// builtin, so two in-process calls that draw fresh gaussian weights diverge.
// To make BOTH (a) the experiment and (b) the in-process determinism check
// fully reproducible, we draw a FIXED bank of gaussian weight vectors ONCE
// at the head of the program (deterministic given __HEXA_FARR_GAUSS_SEED__),
// then every cell init + respawn pulls from this bank cyclically. After the
// bank is built, the rest of the run consumes NO further RNG → byte-equal.
//
// bank entry = list[float] of length weight_n, drawn N(0, init_sigma^2).
fn _build_weight_bank(bank_size: int) {
    let d = _d_model()
    let weight_n = d * d
    let init_sigma = 1.0 / _sqrt_safe(d * 1.0)
    let mut bank = []
    let mut b = 0
    while b < bank_size {
        let h = farr_zeros(weight_n)
        let _ = farr_add_gaussian_noise(h, init_sigma)
        // snapshot to list[float] (RNG-free thereafter).
        let mut v = []
        let mut k = 0
        while k < weight_n {
            v.push(farr_get(h, k))
            k = k + 1
        }
        let _ = farr_free(h)
        bank.push(v)
        b = b + 1
    }
    return bank
}

// Copy a bank entry (list[float]) into a fresh farr handle.
fn _bank_to_farr(bank, idx: int, weight_n: int) {
    let v = bank[idx % len(bank)]
    let h = farr_zeros(weight_n)
    let mut k = 0
    while k < weight_n {
        let _ = farr_set(h, k, v[k])
        k = k + 1
    }
    return h
}

// Overwrite a farr handle in place from a bank entry.
fn _bank_into_farr_inplace(h: int, bank, idx: int, weight_n: int) {
    let v = bank[idx % len(bank)]
    let mut k = 0
    while k < weight_n {
        let _ = farr_set(h, k, v[k])
        k = k + 1
    }
    return 0
}


// ── run one decay-rate condition; returns dict ───────────────────────────────
//
// Renewal life-table protocol:
//   * init pool of N cells, all age 0, weights from the deterministic bank.
//   * each step, for each cell:
//       age += 1
//       scale both engine weight farrs by (1 - d)         (compounded decay)
//       health = 0.5*(rms(aw) + rms(gw))
//       if health < death_threshold:
//           record death at age (into age-bin) ; respawn fresh cell (age 0,
//           weights pulled from the deterministic bank — RNG-free)
//       else:
//           credit "at risk" cell-step to age's bin
//   * after T steps, compute per-bin death_rate = deaths / (deaths + at_risk)
//     (hazard: of the cell-steps that *entered* a bin's age, fraction that
//      died there). survival S(age) = Π (1 - hazard) over earlier bins.
//   * median lifespan = smallest age where S(age) ≤ 0.5 (linear-free, bin grain).
//
// `bank` = deterministic gaussian weight bank (built once). Because evolution
// after init consumes NO RNG, calling this fn twice with the same bank yields
// byte-equal output → the in-process C3 determinism check is exact.
//
// Returns dict with arrays keyed by age-bin index.
fn _run_condition(d_rate: float, bank) {
    let d = _d_model()
    let n = _pool_n()
    let weight_n = d * d
    let nb = _max_age_bin() + 1
    let bw = _bin_width()

    // Fresh pool — reuse cell_pool_init for the dict skeleton, then OVERWRITE
    // each cell's engine weights from the deterministic bank (RNG consumed by
    // cell_pool_init is fixed and identical across calls, but we overwrite
    // anyway so the bank is the single source of truth).
    let mut pool = cell_pool_init(d, n)
    let mut bank_cursor = 0
    let mut ic = 0
    while ic < n {
        let _ = _bank_into_farr_inplace(pool["cells"][ic]["engine_a_W"], bank, bank_cursor, weight_n)
        bank_cursor = bank_cursor + 1
        let _ = _bank_into_farr_inplace(pool["cells"][ic]["engine_g_W"], bank, bank_cursor, weight_n)
        bank_cursor = bank_cursor + 1
        ic = ic + 1
    }

    // Per-cell age tracker (parallel to pool["cells"], fixed length n;
    // respawn keeps index slot, resets age to 0).
    let mut ages = []
    let mut i = 0
    while i < n {
        ages.push(0)
        i = i + 1
    }

    // Age-bin accumulators.
    let mut deaths_per_bin = []
    let mut atrisk_per_bin = []
    let mut bi = 0
    while bi < nb {
        deaths_per_bin.push(0)
        atrisk_per_bin.push(0)
        bi = bi + 1
    }

    let thr = _death_threshold()
    let surv_f = 1.0 - d_rate

    let mut step = 0
    while step < _steps() {
        let mut c = 0
        while c < n {
            // age the cell.
            let new_age = ages[c] + 1
            ages[c] = new_age

            // apply compounded multiplicative decay to both engine weights.
            let aw = pool["cells"][c]["engine_a_W"]
            let gw = pool["cells"][c]["engine_g_W"]
            let _ = _farr_scale_inplace(aw, weight_n, surv_f)
            let _ = _farr_scale_inplace(gw, weight_n, surv_f)

            // health = mean RMS magnitude of the two weight farrs.
            let rms_a = _farr_rms(aw, weight_n)
            let rms_g = _farr_rms(gw, weight_n)
            let health = 0.5 * (rms_a + rms_g)

            // bin index for this cell's CURRENT age (the age it is being
            // evaluated AT). cap at last bin.
            let mut bidx = new_age / bw
            if bidx > nb - 1 { bidx = nb - 1 }

            if health < thr {
                // DEATH at this age.
                deaths_per_bin[bidx] = deaths_per_bin[bidx] + 1
                // respawn: fresh weights pulled from the deterministic bank
                // (RNG-free → byte-equal across re-run). cursor walks the bank
                // cyclically so successive respawns vary but reproducibly.
                let _ = _bank_into_farr_inplace(aw, bank, bank_cursor, weight_n)
                bank_cursor = bank_cursor + 1
                let _ = _bank_into_farr_inplace(gw, bank, bank_cursor, weight_n)
                bank_cursor = bank_cursor + 1
                ages[c] = 0
            } else {
                // survived this age → at-risk credit.
                atrisk_per_bin[bidx] = atrisk_per_bin[bidx] + 1
            }
            c = c + 1
        }
        step = step + 1
    }

    // ── per-bin hazard (death_rate) = deaths / (deaths + at_risk) ─────────────
    let mut death_rate = []
    let mut populated = []   // 1 if this bin saw any cell-step, else 0
    bi = 0
    while bi < nb {
        let dd = deaths_per_bin[bi]
        let ar = atrisk_per_bin[bi]
        let tot = dd + ar
        if tot > 0 {
            death_rate.push(to_float(dd) / to_float(tot))
            populated.push(1)
        } else {
            death_rate.push(0.0)
            populated.push(0)
        }
        bi = bi + 1
    }

    // ── survival curve S(age_bin) = Π_{k <= bi} (1 - hazard_k) ───────────────
    // over POPULATED bins only (skip empties so they don't 0-out the product).
    let mut survival = []
    let mut s_acc = 1.0
    bi = 0
    while bi < nb {
        if populated[bi] == 1 {
            s_acc = s_acc * (1.0 - death_rate[bi])
        }
        survival.push(s_acc)
        bi = bi + 1
    }

    // ── median lifespan = first bin where survival <= 0.5 (age = bidx*bw) ─────
    // if never crosses (all survive), median = last populated age (right-cens.).
    let mut median_bin = -1
    bi = 0
    while bi < nb {
        if median_bin < 0 {
            if populated[bi] == 1 {
                if survival[bi] <= 0.5 {
                    median_bin = bi
                }
            }
        }
        bi = bi + 1
    }
    // last populated bin (for censoring fallback).
    let mut last_pop = 0
    bi = 0
    while bi < nb {
        if populated[bi] == 1 { last_pop = bi }
        bi = bi + 1
    }
    if median_bin < 0 { median_bin = last_pop }   // right-censored fallback
    let median_age = median_bin * bw

    // ── C1 monotone check over populated bins ────────────────────────────────
    // count adjacent (populated-to-next-populated) steps that are
    // non-decreasing vs total adjacent steps; also first vs last populated.
    let mut mono_ok = 0
    let mut mono_tot = 0
    let mut prev_idx = -1
    let mut first_pop_rate = -1.0
    let mut last_pop_rate = -1.0
    bi = 0
    while bi < nb {
        if populated[bi] == 1 {
            if first_pop_rate < 0.0 { first_pop_rate = death_rate[bi] }
            last_pop_rate = death_rate[bi]
            if prev_idx >= 0 {
                mono_tot = mono_tot + 1
                if death_rate[bi] >= death_rate[prev_idx] {
                    mono_ok = mono_ok + 1
                }
            }
            prev_idx = bi
        }
        bi = bi + 1
    }
    let mono_frac = if mono_tot > 0 { to_float(mono_ok) / to_float(mono_tot) } else { 0.0 }
    let rise_ok = last_pop_rate > first_pop_rate
    let c1_mono = (mono_frac >= 0.80) && rise_ok

    let mut total_deaths = 0
    bi = 0
    while bi < nb {
        total_deaths = total_deaths + deaths_per_bin[bi]
        bi = bi + 1
    }

    return #{
        "d_rate":         d_rate,
        "death_rate":     death_rate,
        "survival":       survival,
        "deaths_per_bin": deaths_per_bin,
        "atrisk_per_bin": atrisk_per_bin,
        "populated":      populated,
        "median_bin":     median_bin,
        "median_age":     median_age,
        "mono_frac":      mono_frac,
        "rise_ok":        rise_ok,
        "c1_mono":        c1_mono,
        "first_pop_rate": first_pop_rate,
        "last_pop_rate":  last_pop_rate,
        "total_deaths":   total_deaths,
        "n_bins":         nb
    }
}


// ── pretty-print a condition's age-binned table ──────────────────────────────
fn _print_condition(name: string, r) {
    println("")
    println("── d=" + name + " (decay " + to_string(r["d_rate"])
            + ")  total_deaths=" + to_string(r["total_deaths"])
            + "  median_age=" + to_string(r["median_age"]) + " ──")
    println("  age   deaths  at_risk  death_rate  survival")
    println("  ----  ------  -------  ----------  --------")
    let nb = r["n_bins"]
    let bw = _bin_width()
    let dr = r["death_rate"]
    let sv = r["survival"]
    let dpb = r["deaths_per_bin"]
    let apb = r["atrisk_per_bin"]
    let pop = r["populated"]
    let mut bi = 0
    while bi < nb {
        if pop[bi] == 1 {
            println("  " + to_string(bi * bw)
                    + "    " + to_string(dpb[bi])
                    + "       " + to_string(apb[bi])
                    + "      " + to_string(dr[bi])
                    + "    " + to_string(sv[bi]))
        }
        bi = bi + 1
    }
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h259() {
    println("================================================================")
    println("H_259 aging-senescence — age-cumulative weight decay → death-rate")
    println("                          curve (Gompertz-like senescence test)")
    println("  d_model=" + to_string(_d_model())
            + " pool_N=" + to_string(_pool_n())
            + " steps=" + to_string(_steps())
            + " seed=" + to_string(_seed()))
    println("  death_threshold=" + to_string(_death_threshold())
            + "  bin_width=" + to_string(_bin_width()))
    println("  decay rates: low=" + to_string(_d_low())
            + " mid=" + to_string(_d_mid())
            + " high=" + to_string(_d_high()))
    println("================================================================")

    // Build the deterministic gaussian weight bank ONCE (the only RNG consumed
    // in the whole program). 256 entries cover N=8 init (16 draws) + up to
    // ~480 respawns cyclically; the cursor wraps so respawns stay reproducible.
    let bank = _build_weight_bank(256)

    // F-DET determinism — paired call on the LOW condition. Evolution after
    // init consumes NO RNG (weights come from `bank`), so two calls with the
    // same bank are byte-equal by construction → exact in-process C3 check.
    let _det_a = _run_condition(_d_low(), bank)
    let _det_b = _run_condition(_d_low(), bank)
    let det_eq = (_det_a["total_deaths"] == _det_b["total_deaths"])
                 && (_det_a["median_age"] == _det_b["median_age"])
                 && (_det_a["last_pop_rate"] == _det_b["last_pop_rate"])
                 && (_det_a["first_pop_rate"] == _det_b["first_pop_rate"])
                 && (_det_a["mono_frac"] == _det_b["mono_frac"])

    // 3 decay-rate conditions (same bank → fully reproducible).
    let r_low  = _run_condition(_d_low(), bank)
    let r_mid  = _run_condition(_d_mid(), bank)
    let r_high = _run_condition(_d_high(), bank)

    _print_condition("low",  r_low)
    _print_condition("mid",  r_mid)
    _print_condition("high", r_high)

    // ── derived metrics ──
    let med_low  = r_low["median_age"]
    let med_mid  = r_mid["median_age"]
    let med_high = r_high["median_age"]

    // C1: senescence — death_rate monotone non-decreasing AND rising, in ALL 3.
    let c1 = r_low["c1_mono"] && r_mid["c1_mono"] && r_high["c1_mono"]

    // C2: decay-dose — median lifespan strictly decreasing L(low)>L(mid)>L(high).
    let c2 = (med_low > med_mid) && (med_mid > med_high)

    // C3: determinism — re-run numeric byte-equal.
    let c3 = det_eq

    let v1 = if c1 { "PASS" } else { "FAIL" }
    let v2 = if c2 { "PASS" } else { "FAIL" }
    let v3 = if c3 { "PASS" } else { "FAIL" }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }

    // verdict_rule: SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = ¬C1.
    let verdict = if c1 {
        if c2 { "SUPPORTED" } else { "PARTIAL" }
    } else {
        "FALSIFIED"
    }

    // ── extra falsifiers (≥5 measurable) ─────────────────────────────────────
    // F4 BOUNDS: all death_rate ∈ [0,1] and all survival ∈ [0,1] across conds.
    fn _arr_in_unit(arr) -> bool {
        let mut i = 0
        while i < len(arr) {
            if arr[i] < 0.0 { return false }
            if arr[i] > 1.0 { return false }
            i = i + 1
        }
        return true
    }
    let f4_bounds = _arr_in_unit(r_low["death_rate"]) && _arr_in_unit(r_low["survival"])
                 && _arr_in_unit(r_mid["death_rate"]) && _arr_in_unit(r_mid["survival"])
                 && _arr_in_unit(r_high["death_rate"]) && _arr_in_unit(r_high["survival"])
    // F5 NONTRIVIAL: each condition had at least one death (process is alive).
    let f5_nontrivial = (r_low["total_deaths"] > 0)
                     && (r_mid["total_deaths"] > 0)
                     && (r_high["total_deaths"] > 0)

    let v4 = if f4_bounds { "PASS" } else { "FAIL" }
    let v5 = if f5_nontrivial { "PASS" } else { "FAIL" }

    let mut n_f = 0
    if c1 { n_f = n_f + 1 }          // F1 = C1 senescence
    if c2 { n_f = n_f + 1 }          // F2 = C2 decay-dose
    if c3 { n_f = n_f + 1 }          // F3 = C3 determinism
    if f4_bounds { n_f = n_f + 1 }   // F4 bounds
    if f5_nontrivial { n_f = n_f + 1 } // F5 nontrivial

    println("")
    println("derived:")
    println("  median_age(low)  = " + to_string(med_low)
            + "  (mono_frac=" + to_string(r_low["mono_frac"])
            + " rise=" + _bool_str(r_low["rise_ok"]) + ")")
    println("  median_age(mid)  = " + to_string(med_mid)
            + "  (mono_frac=" + to_string(r_mid["mono_frac"])
            + " rise=" + _bool_str(r_mid["rise_ok"]) + ")")
    println("  median_age(high) = " + to_string(med_high)
            + "  (mono_frac=" + to_string(r_high["mono_frac"])
            + " rise=" + _bool_str(r_high["rise_ok"]) + ")")
    println("  left-shift L(low)>L(mid)>L(high) = "
            + _bool_str((med_low > med_mid) && (med_mid > med_high)))

    println("")
    println("C1 senescence (death_rate monotone↑ all 3) : " + _bool_str(c1))
    println("C2 decay-dose (median L(low)>L(mid)>L(high)): " + _bool_str(c2))
    println("C3 determinism (re-run byte-equal)         : " + _bool_str(c3))
    println("")
    println("F1 SENESCENCE   (C1)                        " + v1)
    println("F2 DECAY-DOSE   (C2)                        " + v2)
    println("F3 DETERMINISM  (C3)                        " + v3)
    println("F4 BOUNDS       (rates/surv in [0,1])       " + v4)
    println("F5 NONTRIVIAL   (deaths>0 all conds)        " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/3 criteria, "
            + to_string(n_f) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_259\",\n"
    j = j + "  \"slug\": \"aging-senescence\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"aging-senescence — age-cumulative weight decay → Gompertz-like death-rate curve\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"pool_N\": " + to_string(_pool_n())
          + ", \"steps\": " + to_string(_steps())
          + ", \"death_threshold\": " + to_string(_death_threshold())
          + ", \"bin_width\": " + to_string(_bin_width())
          + ", \"d_low\": " + to_string(_d_low())
          + ", \"d_mid\": " + to_string(_d_mid())
          + ", \"d_high\": " + to_string(_d_high()) + "},\n"

    j = j + "  \"sweep\": {\n"

    j = j + "    \"low\":  { \"d_rate\": " + to_string(r_low["d_rate"])
          + ", \"total_deaths\": " + to_string(r_low["total_deaths"])
          + ", \"median_age\": " + to_string(r_low["median_age"])
          + ", \"mono_frac\": " + to_string(r_low["mono_frac"])
          + ", \"first_pop_rate\": " + to_string(r_low["first_pop_rate"])
          + ", \"last_pop_rate\": " + to_string(r_low["last_pop_rate"])
          + ", \"c1_mono\": " + _bool_str(r_low["c1_mono"])
          + ", \"death_rate\": " + _float_arr_json(r_low["death_rate"])
          + ", \"survival\": " + _float_arr_json(r_low["survival"])
          + ", \"deaths_per_bin\": " + _int_arr_json(r_low["deaths_per_bin"])
          + ", \"atrisk_per_bin\": " + _int_arr_json(r_low["atrisk_per_bin"]) + " },\n"

    j = j + "    \"mid\":  { \"d_rate\": " + to_string(r_mid["d_rate"])
          + ", \"total_deaths\": " + to_string(r_mid["total_deaths"])
          + ", \"median_age\": " + to_string(r_mid["median_age"])
          + ", \"mono_frac\": " + to_string(r_mid["mono_frac"])
          + ", \"first_pop_rate\": " + to_string(r_mid["first_pop_rate"])
          + ", \"last_pop_rate\": " + to_string(r_mid["last_pop_rate"])
          + ", \"c1_mono\": " + _bool_str(r_mid["c1_mono"])
          + ", \"death_rate\": " + _float_arr_json(r_mid["death_rate"])
          + ", \"survival\": " + _float_arr_json(r_mid["survival"])
          + ", \"deaths_per_bin\": " + _int_arr_json(r_mid["deaths_per_bin"])
          + ", \"atrisk_per_bin\": " + _int_arr_json(r_mid["atrisk_per_bin"]) + " },\n"

    j = j + "    \"high\": { \"d_rate\": " + to_string(r_high["d_rate"])
          + ", \"total_deaths\": " + to_string(r_high["total_deaths"])
          + ", \"median_age\": " + to_string(r_high["median_age"])
          + ", \"mono_frac\": " + to_string(r_high["mono_frac"])
          + ", \"first_pop_rate\": " + to_string(r_high["first_pop_rate"])
          + ", \"last_pop_rate\": " + to_string(r_high["last_pop_rate"])
          + ", \"c1_mono\": " + _bool_str(r_high["c1_mono"])
          + ", \"death_rate\": " + _float_arr_json(r_high["death_rate"])
          + ", \"survival\": " + _float_arr_json(r_high["survival"])
          + ", \"deaths_per_bin\": " + _int_arr_json(r_high["deaths_per_bin"])
          + ", \"atrisk_per_bin\": " + _int_arr_json(r_high["atrisk_per_bin"]) + " }\n"

    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"median_age_low\":  " + to_string(med_low) + ",\n"
    j = j + "    \"median_age_mid\":  " + to_string(med_mid) + ",\n"
    j = j + "    \"median_age_high\": " + to_string(med_high) + ",\n"
    j = j + "    \"left_shift_monotone\": " + _bool_str((med_low > med_mid) && (med_mid > med_high)) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_senescence\":  " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_decay_dose\":  " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_determinism\": " + _bool_str(c3) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_SENESCENCE\":  { \"metric\": \"death_rate monotone↑ all 3 conds\", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_DECAY_DOSE\":  { \"metric\": \"median L(low)>L(mid)>L(high)\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_DETERMINISM\": { \"metric\": \"re-run byte-equal\", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_BOUNDS\":      { \"metric\": \"rates/survival in [0,1]\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_NONTRIVIAL\":  { \"metric\": \"deaths>0 all conds\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_f) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_220\": \"infant-mirror developmental-age sister\", \"H_053\": \"cambrian life axis\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h259()
