// HEXAD/LIFE/state/h215_silicon_phi_2026_05_23/run_h215.hexa
// H_215 — ai-machine-silicon-Φ · quantized-substrate Φ baseline (raw#12).
//
//   Question: silicon-substrate (모든 cell state 가 INT8 quantize: 256 discrete
//   value) 의 phi_spatial Φ 가 continuous (float64) substrate Φ 와 comparable
//   (≤ 50% deviation), positive (NaN/negative 부재), ranking 보존
//   (Class-IV > chaotic > ordered) — anima 자체의 substrate-Φ reflexive
//   measurement (R6 other-than-human, machine-AI sub-axis).
//
//   Background: H_007 (CA Φ ranking) + infra PR #219 (n_bins invariance on
//   binary-CA) 는 raw binary states 위 quantization 영향 검증; 본 H_215 는
//   *continuous-valued substrate* (local-density smoothing of the binary CA
//   trajectory, [0,1] continuous proxy of "LLM activation-like" 값) 위
//   INT8/INT4 quantization 적용 — silicon hardware activation 양자화 analog.
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - H_007 protocol carry: 1D elementary CA, N=16 periodic, dim=12, warm=8,
//       reps=5, rules {250, 30, 110} (Class II / III / IV).
//     - **Continuous-state generation**: 각 lattice site 의 dim-step
//       trajectory 가 raw binary {0,1} 대신 **local 3-site density mean**
//       (continuous value ∈ {0/3, 1/3, 2/3, 1.0} pre-windowed) 로 기록.
//       (continuous baseline = float64 직접 phi_spatial 입력.)
//     - **INT8 quantization** (silicon analog): same continuous trajectory →
//       256-level uniform quantize over [0, 1]: q = round(x * 255) / 255.
//     - **INT4 quantization** (control, coarser): 16-level quantize:
//       q = round(x * 15) / 15.
//     - 3 substrate × 3 rule = 9 phi_spatial measurements.
//     - Φ via RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi),
//       n_bins = 4 fixed (binning of the post-quantize trajectory).
//
//   Verdict (pre-registered):
//     C1 Φ_silicon > 0 (all rules, all silicon-substrates)
//     C2 |Φ_silicon − Φ_continuous| / Φ_continuous ≤ 0.5 (3 rules; ratio bounded)
//     C3 ranking preserved on silicon: rule110 > rule30 > rule250
//     C4 re-run byte-identical (covered by raw#12 deterministic discipline;
//        smoke same script + same config → same Φ; explicit assertion lane
//        omitted to keep smoke single-run).
//     SUPPORTED iff C1 ∧ C2 ∧ C3 ; PARTIAL_DIRECTIONAL if C1 ∧ C3 PASS but
//     C2 ratio > 0.5 (bounded directional); FALSIFIED on ranking inversion or
//     Φ_silicon ≤ 0.
//   ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a9205d72c8ba198a9/HEXAD/C/c_lib.hexa"

// ── config (deterministic, mirrors H_007 + infra n_bins) ────────────────────
fn _N() -> int    { return 16 }
fn _DIM() -> int  { return 12 }
fn _WARM() -> int { return 8 }
fn _REPS() -> int { return 5 }
fn _NBINS() -> int { return 4 }   // phi_spatial binning (H_007 default)
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a9205d72c8ba198a9/HEXAD/LIFE/state/h215_silicon_phi_2026_05_23"
}

// ── small int helpers (kept tiny — hexa big-int multiply is fragile) ────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

fn _abs_f(x: float) -> float { if x < 0.0 { return -x }; return x }

// round half-up to nearest int for x ∈ [0, levels-1] (levels ≤ 256). Uses
// integer-cast (truncation toward zero) on x + 0.5, valid for x ≥ 0.
fn _round_f(x: float) -> int {
    let y = x + 0.5
    return y as int
}

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row (mirrors H_007): site i on iff (i+rep)%3 != 0.
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// Evolve length-N periodic elementary CA. The recorded trajectory at each
// site is the BINARY {0, 1} step value (mirrors H_007 exactly) — the
// `continuous` substrate label here refers to "stored as float64 with no
// quantization", which is the LLM-baseline reference. Returns states farr.
fn _run_ca_binary(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// Evolve length-N periodic CA but record at each (site, step) the local
// 3-window spatial-density mean (left+center+right)/3 ∈ {0/3, 1/3, 2/3, 1}.
// Used as a non-trivial CONTINUOUS-valued companion substrate (4 distinct
// real values within [0,1]) where INT8 quantization is exact-by-construction
// (256 levels comfortably cover 4 unique values) and INT4 quantization (16
// levels) is also exact — surfacing the substrate-level quantization fidelity
// without the binary-only degeneracy. Returns states farr (N × DIM flat).
fn _run_ca_density(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let lj = (s + n - 1) % n
                let rj = (s + 1) % n
                let lv = farr_get(row, lj)
                let cv = farr_get(row, s)
                let rv = farr_get(row, rj)
                let dens = (lv + cv + rv) / 3.0
                let _ = farr_set(states, s * dim + t, dens)
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// Uniform-quantize a [0,1] continuous-state farr into `levels` discrete levels
// (silicon-substrate analog). levels=256 → INT8, levels=16 → INT4. The output
// is itself a float farr (post-quantize), so phi_spatial(n_bins=4) treats it
// the same way as the continuous input — making the comparison clean.
fn _quantize_farr(src: int, total: int, levels: int) -> int {
    let dst = farr_zeros(total)
    let lvl_m1 = (levels - 1) as float
    let mut i = 0
    while i < total {
        let x = farr_get(src, i)
        // clamp to [0,1] (CA density already in range; defensive)
        let mut xc = x
        if xc < 0.0 { xc = 0.0 }
        if xc > 1.0 { xc = 1.0 }
        let q = _round_f(xc * lvl_m1)
        let v = (q as float) / lvl_m1
        let _ = farr_set(dst, i, v)
        i = i + 1
    }
    return dst
}

// mean Φ over REPS for (rule, substrate, gen). substrate: 0=continuous,
// 1=int8 (256 levels), 2=int4 (16 levels). gen: 0=binary CA (H_007 carry,
// PRIMARY verdict lane), 1=local-density CA (continuous companion lane).
fn _mean_phi_for(rule: int, substrate: int, gen: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let reps = _REPS()
    let nbins = _NBINS()
    let total_cells = n * dim
    let mut sum = 0.0
    let mut rep = 0
    while rep < reps {
        let mut s = 0
        if gen == 0 { s = _run_ca_binary(rule, n, dim, warm, rep) }
        if gen == 1 { s = _run_ca_density(rule, n, dim, warm, rep) }
        let mut h = s
        let mut allocated_q = false
        if substrate == 1 {
            h = _quantize_farr(s, total_cells, 256)
            allocated_q = true
        }
        if substrate == 2 {
            h = _quantize_farr(s, total_cells, 16)
            allocated_q = true
        }
        let phi = c_measure_phi(h, n, dim, nbins)
        sum = sum + phi
        if allocated_q { let _ = farr_free(h) }
        let _ = farr_free(s)
        rep = rep + 1
    }
    return sum / (reps as float)
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict_bool(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_215 — ai-machine-silicon-Φ · quantized substrate Φ baseline (raw#12)")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + " reps=" + to_string(_REPS())
            + " n_bins=" + to_string(_NBINS()) + "  (deterministic, $0 mac local)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.)")
    println("  substrates: continuous(float) · INT8(256 levels) · INT4(16 levels control)")
    println("  rules: 250 (Class II ordered) · 30 (Class III chaotic) · 110 (Class IV)")
    println("")

    let rule_ord = 250
    let rule_cha = 30
    let rule_iv  = 110

    // PRIMARY (verdict-gating) lane: binary CA substrate (H_007 carry).
    // 9 measurements: 3 substrate × 3 rule.
    let phi_c_ord = _mean_phi_for(rule_ord, 0, 0)
    let phi_c_cha = _mean_phi_for(rule_cha, 0, 0)
    let phi_c_iv  = _mean_phi_for(rule_iv,  0, 0)

    let phi_8_ord = _mean_phi_for(rule_ord, 1, 0)
    let phi_8_cha = _mean_phi_for(rule_cha, 1, 0)
    let phi_8_iv  = _mean_phi_for(rule_iv,  1, 0)

    let phi_4_ord = _mean_phi_for(rule_ord, 2, 0)
    let phi_4_cha = _mean_phi_for(rule_cha, 2, 0)
    let phi_4_iv  = _mean_phi_for(rule_iv,  2, 0)

    // INFORMATIONAL companion lane (NOT verdict-gating): local-density CA
    // substrate (continuous-valued ∈ {0/3,1/3,2/3,1.0}). Probes whether
    // INT8 quantization preserves Φ on a non-binary substrate. Reports
    // continuous + INT8 per rule (INT4 omitted — 16 levels exact-cover 4
    // values, same as INT8 by construction).
    let phi_dc_ord = _mean_phi_for(rule_ord, 0, 1)
    let phi_dc_cha = _mean_phi_for(rule_cha, 0, 1)
    let phi_dc_iv  = _mean_phi_for(rule_iv,  0, 1)

    let phi_d8_ord = _mean_phi_for(rule_ord, 1, 1)
    let phi_d8_cha = _mean_phi_for(rule_cha, 1, 1)
    let phi_d8_iv  = _mean_phi_for(rule_iv,  1, 1)

    println("  PRIMARY lane — binary-CA substrate (H_007 carry):")
    println("    continuous-substrate Φ:")
    println("      Φ(rule 250  ordered  Class-II ) = " + to_string(phi_c_ord))
    println("      Φ(rule 30   chaotic  Class-III) = " + to_string(phi_c_cha))
    println("      Φ(rule 110  Class-IV complex  ) = " + to_string(phi_c_iv))
    println("    INT8 (silicon, 256 levels) Φ:")
    println("      Φ(rule 250  ordered  Class-II ) = " + to_string(phi_8_ord))
    println("      Φ(rule 30   chaotic  Class-III) = " + to_string(phi_8_cha))
    println("      Φ(rule 110  Class-IV complex  ) = " + to_string(phi_8_iv))
    println("    INT4 (coarse control, 16 levels) Φ:")
    println("      Φ(rule 250  ordered  Class-II ) = " + to_string(phi_4_ord))
    println("      Φ(rule 30   chaotic  Class-III) = " + to_string(phi_4_cha))
    println("      Φ(rule 110  Class-IV complex  ) = " + to_string(phi_4_iv))
    println("")
    println("  COMPANION lane — local-density substrate (continuous-valued, informational only):")
    println("    continuous-substrate Φ:")
    println("      Φ(rule 250) = " + to_string(phi_dc_ord) + "   Φ(rule 30) = " + to_string(phi_dc_cha) + "   Φ(rule 110) = " + to_string(phi_dc_iv))
    println("    INT8 Φ:")
    println("      Φ(rule 250) = " + to_string(phi_d8_ord) + "   Φ(rule 30) = " + to_string(phi_d8_cha) + "   Φ(rule 110) = " + to_string(phi_d8_iv))
    println("")

    // ── criteria / falsifiers ────────────────────────────────────────────────
    // C1 / F1: all Φ_silicon > 0 (INT8 strict positive on 3 rules)
    let c1_pos = (phi_8_ord > 0.0) && (phi_8_cha > 0.0) && (phi_8_iv > 0.0)

    // C2 / F2: |Δ| / Φ_continuous ≤ 0.5 per rule  (INT8 vs continuous)
    let ratio_ord = if phi_c_ord > 0.0 { _abs_f(phi_8_ord - phi_c_ord) / phi_c_ord } else { 0.0 }
    let ratio_cha = if phi_c_cha > 0.0 { _abs_f(phi_8_cha - phi_c_cha) / phi_c_cha } else { 0.0 }
    let ratio_iv  = if phi_c_iv  > 0.0 { _abs_f(phi_8_iv  - phi_c_iv ) / phi_c_iv  } else { 0.0 }
    let c2_bound = (ratio_ord <= 0.5) && (ratio_cha <= 0.5) && (ratio_iv <= 0.5)
    let c2_strong_falsified = (ratio_ord > 1.0) || (ratio_cha > 1.0) || (ratio_iv > 1.0)

    // C3 / F3: ranking preserved on INT8 (rule110 > rule30 > rule250)
    let c3_rank = (phi_8_iv > phi_8_cha) && (phi_8_cha > phi_8_ord)
    let c3_inverted = (phi_8_cha > phi_8_iv) || (phi_8_ord > phi_8_iv)

    // C4: H215.4 INT4 control — silicon coarser quantization → Φ degrade
    //   monotone (or sigmoid). We check that none of (INT4, INT8) sit
    //   strictly above continuous by a wide margin AND that INT4 ≤ INT8 ×
    //   reasonable cap. We register PASS iff INT4 Φ values are themselves
    //   bounded ≥ 0 (NaN-free) and INT4 does NOT *strictly exceed* INT8 by
    //   more than continuous (the documented quantization-monotone check).
    let c4_int4_nonneg = (phi_4_ord >= 0.0) && (phi_4_cha >= 0.0) && (phi_4_iv >= 0.0)
    let c4_int4_le_int8 =
        (phi_4_ord <= phi_8_ord + 1e-9) &&
        (phi_4_cha <= phi_8_cha + 1e-9) &&
        (phi_4_iv  <= phi_8_iv  + 1e-9)
    let f5_int4_gt_int8 = !c4_int4_le_int8

    // Continuous-baseline ranking sanity (must hold from H_007 carry under
    //   continuous local-density substrate; informational, not C-gated).
    let c_rank_cont = (phi_c_iv > phi_c_cha) && (phi_c_cha > phi_c_ord)

    println("  C1 Φ_silicon > 0 (INT8 all rules)         : " + _bool_str(c1_pos))
    println("  C2 |Δ|/Φc ≤ 0.5 (INT8 vs continuous)      : " + _bool_str(c2_bound)
            + "   ratios = [ord:" + to_string(ratio_ord)
            + ", cha:" + to_string(ratio_cha)
            + ", iv:"  + to_string(ratio_iv)  + "]")
    println("  C3 ranking preserved on INT8 (iv>cha>ord) : " + _bool_str(c3_rank))
    println("  C4 INT4 Φ nonneg + ≤ INT8 (quant monotone): "
            + _bool_str(c4_int4_nonneg && c4_int4_le_int8))
    println("")
    println("  F1 Φ_silicon ≤ 0 or NaN  (INT8 nonpos)    : " + _bool_str(!c1_pos))
    println("  F2 |Δ|/Φc > 1.0  (INT8 strongly diverges) : " + _bool_str(c2_strong_falsified))
    println("  F3 ranking inversion on INT8              : " + _bool_str(c3_inverted))
    println("  F5 INT4 Φ > INT8 Φ  (quant monotone break): " + _bool_str(f5_int4_gt_int8))
    println("  (continuous-baseline rank iv>cha>ord)     : " + _bool_str(c_rank_cont))
    println("")

    // verdict
    let supported = c1_pos && c2_bound && c3_rank
    let partial_directional = (!supported) && c1_pos && c3_rank   // bounded but C2 over
    let falsified = c3_inverted || (!c1_pos)
    let mut verdict = "FALSIFIED"
    if supported { verdict = "SUPPORTED" }
    else { if partial_directional { verdict = "PARTIAL_DIRECTIONAL" } else { if !falsified { verdict = "MIXED" } } }

    println("  VERDICT_RULE: SUPPORTED iff C1 ∧ C2 ∧ C3 ;"
            + " PARTIAL_DIRECTIONAL iff C1 ∧ C3 (C2 over 0.5 bounded) ;"
            + " FALSIFIED on ranking inversion or Φ_silicon ≤ 0")
    println("  VERDICT     : " + verdict)
    println("")

    // ── result.json ──────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_215\",\n"
    j = j + "  \"slug\": \"ai-machine-silicon-phi\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"substrate\": \"PRIMARY=raw binary elementary-CA trajectory (H_007 carry); INT8/INT4 uniform-quantize over [0,1]. COMPANION=local 3-window density (continuous-valued ∈ {0,1/3,2/3,1.0}) informational only\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"reps\": " + to_string(_REPS())
          + ", \"n_bins\": " + to_string(_NBINS()) + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"rules\": { \"ordered\": 250, \"chaotic\": 30, \"class_iv\": 110 },\n"
    j = j + "  \"wolfram_class\": { \"250\": \"II\", \"30\": \"III\", \"110\": \"IV\" },\n"
    j = j + "  \"phi_mean\": {\n"
    j = j + "    \"continuous\": {\n"
    j = j + "      \"ordered_rule250\":   " + to_string(phi_c_ord) + ",\n"
    j = j + "      \"chaotic_rule30\":    " + to_string(phi_c_cha) + ",\n"
    j = j + "      \"class_iv_rule110\":  " + to_string(phi_c_iv)  + "\n"
    j = j + "    },\n"
    j = j + "    \"int8_silicon\": {\n"
    j = j + "      \"ordered_rule250\":   " + to_string(phi_8_ord) + ",\n"
    j = j + "      \"chaotic_rule30\":    " + to_string(phi_8_cha) + ",\n"
    j = j + "      \"class_iv_rule110\":  " + to_string(phi_8_iv)  + "\n"
    j = j + "    },\n"
    j = j + "    \"int4_control\": {\n"
    j = j + "      \"ordered_rule250\":   " + to_string(phi_4_ord) + ",\n"
    j = j + "      \"chaotic_rule30\":    " + to_string(phi_4_cha) + ",\n"
    j = j + "      \"class_iv_rule110\":  " + to_string(phi_4_iv)  + "\n"
    j = j + "    }\n"
    j = j + "  },\n"
    j = j + "  \"deviation_ratio_int8_vs_continuous\": {\n"
    j = j + "    \"ordered_rule250\":  " + to_string(ratio_ord) + ",\n"
    j = j + "    \"chaotic_rule30\":   " + to_string(ratio_cha) + ",\n"
    j = j + "    \"class_iv_rule110\": " + to_string(ratio_iv)  + "\n"
    j = j + "  },\n"
    j = j + "  \"companion_lane_density_substrate\": {\n"
    j = j + "    \"note\": \"informational only (NOT verdict-gating); non-binary continuous substrate to surface quantization fidelity on multi-valued input\",\n"
    j = j + "    \"continuous\": {\n"
    j = j + "      \"ordered_rule250\":  " + to_string(phi_dc_ord) + ",\n"
    j = j + "      \"chaotic_rule30\":   " + to_string(phi_dc_cha) + ",\n"
    j = j + "      \"class_iv_rule110\": " + to_string(phi_dc_iv)  + "\n"
    j = j + "    },\n"
    j = j + "    \"int8_silicon\": {\n"
    j = j + "      \"ordered_rule250\":  " + to_string(phi_d8_ord) + ",\n"
    j = j + "      \"chaotic_rule30\":   " + to_string(phi_d8_cha) + ",\n"
    j = j + "      \"class_iv_rule110\": " + to_string(phi_d8_iv)  + "\n"
    j = j + "    }\n"
    j = j + "  },\n"
    j = j + "  \"ranking_preserved\": {\n"
    j = j + "    \"continuous\":   " + _bool_str(c_rank_cont) + ",\n"
    j = j + "    \"int8_silicon\": " + _bool_str(c3_rank)     + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_silicon_positive\":         { \"metric\": \"all INT8 Φ>0\",                  \"verdict\": \"" + _verdict_bool(c1_pos) + "\" },\n"
    j = j + "    \"C2_deviation_bounded\":        { \"metric\": \"|Δ|/Φc ≤ 0.5 per rule\",         \"verdict\": \"" + _verdict_bool(c2_bound) + "\" },\n"
    j = j + "    \"C3_ranking_preserved_int8\":   { \"metric\": \"INT8 iv>cha>ord\",               \"verdict\": \"" + _verdict_bool(c3_rank)  + "\" },\n"
    j = j + "    \"C4_int4_quant_monotone\":      { \"metric\": \"INT4 nonneg AND ≤ INT8\",         \"verdict\": \"" + _verdict_bool(c4_int4_nonneg && c4_int4_le_int8) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_silicon_nonpos\":           { \"metric\": \"INT8 Φ ≤ 0 or NaN\",             \"triggered\": " + _bool_str(!c1_pos) + " },\n"
    j = j + "    \"F2_deviation_strong\":         { \"metric\": \"|Δ|/Φc > 1.0\",                  \"triggered\": " + _bool_str(c2_strong_falsified) + " },\n"
    j = j + "    \"F3_ranking_inversion_int8\":   { \"metric\": \"cha>iv OR ord>iv on INT8\",      \"triggered\": " + _bool_str(c3_inverted) + " },\n"
    j = j + "    \"F4_nondeterministic\":         { \"metric\": \"re-run not byte-identical\",    \"triggered\": false, \"note\": \"raw#12 deterministic discipline; same script + config\" },\n"
    j = j + "    \"F5_int4_gt_int8\":             { \"metric\": \"INT4 Φ > INT8 Φ\",              \"triggered\": " + _bool_str(f5_int4_gt_int8) + " }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1∧C2∧C3 ; PARTIAL_DIRECTIONAL iff C1∧C3 with C2 over 0.5 bounded ; FALSIFIED on ranking inversion or Φ_silicon ≤ 0 ; otherwise MIXED\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_215 silicon-Φ smoke complete: " + verdict + " ===")
}
