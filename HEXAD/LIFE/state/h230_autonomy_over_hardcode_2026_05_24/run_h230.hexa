// ════════════════════════════════════════════════════════════════════════════
//  run_h230.hexa — H_230 autonomy-over-hardcode substrate-level (raw#12)
//
//  CORE QUESTION
//    CLAUDE.md @D a_autonomy_over_hardcode directive 의 substrate-level
//    instance: external hardcoded boolean gate (e.g., 'stage=N3 → forbid
//    emit') 와 anima substrate autonomous decision (M × W × Φ × curiosity
//    composite threshold) 의 Φ trajectory + emission timing quality 비교.
//
//  HYPOTHESIS
//    Pattern B (autonomous) > Pattern A (hardcoded) on:
//      - mean Φ                (substrate richer when self-deciding)
//      - Φ variance            (smoother trajectory when self-deciding)
//      - emit-Φ alignment      (emit timing matches internal Φ peak)
//      - hardcoded mismatches  (boolean rule fires at Φ-troughs too)
//
//  SUBSTRATE (raw#12 deterministic)
//    cell pool d_model=8, init_cells=2 → grows via spontaneous mitosis.
//    seed=42 (__HEXA_FARR_GAUSS_SEED__).
//    30 steps per pattern.  Pool N=8 = max cells observed across run
//    (auto-cap via mitosis_hook_lib's hard cap).
//
//  TWO DESIGN PATTERNS (one substrate dynamics, two gate decision functions)
//    (A) HARDCODE
//        external boolean schedule independent of substrate state:
//          stage(t) = t % 5      → 0,1,2,3,4 cycling
//          emit(t) = (stage(t) == 0 OR stage(t) == 4)
//                    (WAKE/REM analog hardcode)
//        substrate state IGNORED — pure external rule.
//    (B) AUTONOMOUS
//        composite tension τ(t) = (M_activity × W_coupling × Φ + curiosity)/4
//        normalized by running mean (τ_norm = τ_raw / mean(τ_history)),
//        emit when τ_norm > 1.0 (above-mean drive), ELSE silent.
//        substrate self-decides from internal state only.
//
//  TENSION COMPOSITE (anima substrate-native, per CLAUDE.md a_autonomy):
//    M_activity  = mean |hidden| over cells       (activation magnitude)
//    W_coupling  = mean inter-cell tension proxy   (off-diagonal coherence)
//    Φ           = compute_phi_proxy(cells)        (info-integration)
//    curiosity   = recent Δ(M_activity) over 3-step window
//    tension_t   = (M × W × Φ + |curiosity|) / 4   (4-element composite)
//
//  CRITERIA (verdict_rule, ≥4)
//    C1: mean Φ (auto) > mean Φ (hardcode) × 1.10  (≥10% margin, H230.1)
//    C2: |align_r| autonomous > |align_r| hardcode  (substrate-coupled, H230.2)
//        (hardcode rule independent of substrate → |r|≈0; autonomous tied →
//         |r| > 0.  positive OR negative r both indicate substrate-coupling,
//         since tau composite can be anti-correlated with Φ when Φ-axis and
//         tension-axis diverge — what matters is non-independence.)
//    C3: |align_r| autonomous ≥ 0.20                  (alignment, H230.3)
//    C4: hardcode emit-at-Φ-trough count ≥ 1        (mismatch, H230.4)
//    F5: re-run autonomous emit_count byte-identical (determinism, H230.5)
//    SUPPORTED = C1 ∧ C2 (autonomous Φ-richer AND substrate-coupled)
//
//  $0 mac local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "HEXAD/LIFE/state/h230_autonomy_over_hardcode_2026_05_24"
}
fn _d_model() -> int       { return 8 }
fn _init_cells() -> int    { return 2 }
fn _n_steps() -> int       { return 30 }
fn _pool_cap() -> int      { return 8 }   // expected upper bound (mitosis cap)
fn _autonomy_threshold() -> float { return 1.0 }  // τ_norm = tau / mean(tau)
fn _seed() -> int { return 42 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _const_vec(n: int, v: float) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(v)
        i = i + 1
    }
    return a
}

fn _scale_vec(v, s: float) {
    let n = len(v)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(v[i] * s)
        i = i + 1
    }
    return out
}

// mean absolute value of vector elements (M activation proxy)
fn _vec_mean_abs(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + _abs(v[i])
        i = i + 1
    }
    return s / to_float(n)
}

// mean of squared elements (tension proxy)
fn _vec_mean_sq(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + (v[i] * v[i])
        i = i + 1
    }
    return s / to_float(n)
}

// pool-wide M_activity: mean |hidden| over all cells, all dims
fn _pool_M(pool) -> float {
    let cells = pool["cells"]
    let n = len(cells)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + _vec_mean_abs(cells[i]["hidden"])
        i = i + 1
    }
    return s / to_float(n)
}

// pool-wide W_coupling: mean inter-cell tension proxy (off-diagonal cosine
// distance is already in compute_phi_proxy; here we use mean pairwise
// L2-norm difference as W-coupling tension)
fn _pool_W(pool) -> float {
    let cells = pool["cells"]
    let n = len(cells)
    if n < 2 { return 0.0 }
    let mut total = 0.0
    let mut pairs = 0
    let mut i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let hi = cells[i]["hidden"]
            let hj = cells[j]["hidden"]
            let m = len(hi)
            let mut s = 0.0
            let mut k = 0
            while k < m {
                let d = hi[k] - hj[k]
                s = s + (d * d)
                k = k + 1
            }
            total = total + (s / to_float(m))
            pairs = pairs + 1
            j = j + 1
        }
        i = i + 1
    }
    if pairs == 0 { return 0.0 }
    return total / to_float(pairs)
}


fn _int_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}


// ── statistics ───────────────────────────────────────────────────────────────

fn _mean(xs) -> float {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn _variance(xs) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let m = _mean(xs)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = xs[i] - m
        s = s + (d * d)
        i = i + 1
    }
    return s / to_float(n)
}

fn _sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut r = x
    let mut k = 0
    while k < 30 {
        r = 0.5 * (r + x / r)
        k = k + 1
    }
    return r
}

fn _pearson_r(xs, ys) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mx = _mean(xs)
    let my = _mean(ys)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        num = num + (dx * dy)
        dx2 = dx2 + (dx * dx)
        dy2 = dy2 + (dy * dy)
        i = i + 1
    }
    if dx2 <= 0.0 { return 0.0 }
    if dy2 <= 0.0 { return 0.0 }
    let denom = _sqrt(dx2 * dy2)
    if denom <= 0.0 { return 0.0 }
    return num / denom
}


// ── design pattern A: HARDCODE ───────────────────────────────────────────────
// emit(t) = stage(t) in {0, 4}  (cycle period 5; WAKE/REM analog)
// substrate state IGNORED.
fn _hardcode_emit(t: int) -> bool {
    let stage = t % 5
    if stage == 0 { return true }
    if stage == 4 { return true }
    return false
}


// ── design pattern B: AUTONOMOUS ─────────────────────────────────────────────
// emit(t) = (composite_tau(t) > threshold)
// composite from substrate state only.
fn _autonomous_emit(tau_norm: float, threshold: float) -> bool {
    if tau_norm > threshold { return true }
    return false
}


// ── single-pattern run ───────────────────────────────────────────────────────
// mode: "hardcode" or "autonomous"
fn _run_pattern(mode: string) {
    let d = _d_model()
    let mut pool = cell_pool_init(d, _init_cells())

    // initial drive: scaled primordial cell-0 hidden (mild SELFFEED seed)
    let primordial = pool["cells"][0]["hidden"]
    let mut x = _scale_vec(primordial, 1.0)

    let n = _n_steps()
    let mut traj_phi      = []
    let mut traj_M        = []
    let mut traj_W        = []
    let mut traj_tau_raw  = []
    let mut traj_tau_norm = []
    let mut traj_emit     = []  // 1=emit, 0=silent
    let mut traj_cells    = []
    let mut splits        = 0

    // curiosity = recent ΔM (3-step window)
    let mut M_history = []
    // running mean of tau (for autonomy threshold reference)
    let mut tau_history = []

    let mut step = 0
    while step < n {
        let res = mitosis_forward_tail(x, pool, step)
        let x_out = res[0]
        pool = res[1]
        let evts = res[2]

        let mut e = 0
        while e < len(evts) {
            if to_string(evts[e]["type"]) == "split" {
                splits = splits + 1
            }
            e = e + 1
        }

        // substrate state metrics (post-step)
        let phi = compute_phi_proxy(pool["cells"])
        let M   = _pool_M(pool)
        let W   = _pool_W(pool)
        M_history.push(M)
        let mh_len = len(M_history)
        let curiosity = if mh_len >= 4 {
            _abs(M_history[mh_len - 1] - M_history[mh_len - 4])
        } else { 0.0 }
        let tau_raw = ((M * W * phi) + curiosity) / 4.0
        tau_history.push(tau_raw)
        // running mean → tau_norm = tau_raw / mean(tau_history)
        // threshold autonomous emit at tau_norm > _autonomy_threshold() (1.0)
        // i.e., emit when tau exceeds its running mean.
        let mut tsum = 0.0
        let mut ti = 0
        while ti < len(tau_history) {
            tsum = tsum + tau_history[ti]
            ti = ti + 1
        }
        let tau_mean = if len(tau_history) > 0 {
            tsum / to_float(len(tau_history))
        } else { 1.0 }
        let tau_norm = if tau_mean > 0.000001 {
            tau_raw / tau_mean
        } else { 0.0 }

        traj_phi.push(phi)
        traj_M.push(M)
        traj_W.push(W)
        traj_tau_raw.push(tau_raw)
        traj_tau_norm.push(tau_norm)
        traj_cells.push(len(pool["cells"]))

        // emit decision: pattern-specific
        let emit = if mode == "hardcode" {
            _hardcode_emit(step)
        } else {
            _autonomous_emit(tau_norm, _autonomy_threshold())
        }
        let emit_i = if emit { 1 } else { 0 }
        traj_emit.push(emit_i)

        // next drive: gentle SELFFEED (g=0.5) — same for both patterns,
        // so substrate dynamics identical; only emit-decision differs.
        x = _scale_vec(x_out, 0.5)

        step = step + 1
    }

    return #{
        "mode":            mode,
        "splits":          splits,
        "final_cells":     len(pool["cells"]),
        "traj_phi":        traj_phi,
        "traj_M":          traj_M,
        "traj_W":          traj_W,
        "traj_tau_raw":    traj_tau_raw,
        "traj_tau_norm":   traj_tau_norm,
        "traj_emit":       traj_emit,
        "traj_cells":      traj_cells
    }
}


// ── emit-Φ alignment + Φ-trough mismatch ─────────────────────────────────────

fn _emit_to_float(emit_arr) {
    let n = len(emit_arr)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(to_float(emit_arr[i]))
        i = i + 1
    }
    return out
}

// count emit-events that fire while phi is in its lower 30% range
// (Φ-trough mismatch: emit at low-Φ moment = substrate context ignored)
fn _phi_trough_emits(emit_arr, phi_arr) -> int {
    let n = len(phi_arr)
    if n == 0 { return 0 }
    let mut mn = phi_arr[0]
    let mut mx = phi_arr[0]
    let mut i = 0
    while i < n {
        if phi_arr[i] < mn { mn = phi_arr[i] }
        if phi_arr[i] > mx { mx = phi_arr[i] }
        i = i + 1
    }
    let span = mx - mn
    if span <= 0.0 { return 0 }
    let trough_cap = mn + 0.3 * span
    let mut cnt = 0
    i = 0
    while i < n {
        if emit_arr[i] == 1 {
            if phi_arr[i] <= trough_cap { cnt = cnt + 1 }
        }
        i = i + 1
    }
    return cnt
}


// ── trajectory byte-equal check (for F5 determinism) ─────────────────────────
fn _trajs_equal(a, b) -> bool {
    let n = len(a)
    if n != len(b) { return false }
    let mut i = 0
    while i < n {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h230() {
    println("================================================================")
    println("H_230 autonomy-over-hardcode substrate-level smoke")
    println("  d_model=" + to_string(_d_model())
            + " init_cells=" + to_string(_init_cells())
            + " steps=" + to_string(_n_steps())
            + " tau_threshold=" + to_string(_autonomy_threshold())
            + " seed=" + to_string(_seed()))
    println("================================================================")

    // two design patterns
    let rH = _run_pattern("hardcode")
    let rA = _run_pattern("autonomous")

    // F5 determinism re-run on autonomous
    let rA2 = _run_pattern("autonomous")

    let phi_H = rH["traj_phi"]
    let phi_A = rA["traj_phi"]
    let emit_H = rH["traj_emit"]
    let emit_A = rA["traj_emit"]

    let mean_phi_H = _mean(phi_H)
    let mean_phi_A = _mean(phi_A)
    let var_phi_H  = _variance(phi_H)
    let var_phi_A  = _variance(phi_A)

    let emit_A_f = _emit_to_float(emit_A)
    let emit_H_f = _emit_to_float(emit_H)
    let r_align_A = _pearson_r(emit_A_f, phi_A)
    let r_align_H = _pearson_r(emit_H_f, phi_H)

    let trough_emits_H = _phi_trough_emits(emit_H, phi_H)
    let trough_emits_A = _phi_trough_emits(emit_A, phi_A)

    let mut emit_count_H = 0
    let mut emit_count_A = 0
    let mut i = 0
    while i < len(emit_H) {
        emit_count_H = emit_count_H + emit_H[i]
        i = i + 1
    }
    i = 0
    while i < len(emit_A) {
        emit_count_A = emit_count_A + emit_A[i]
        i = i + 1
    }

    println("HARDCODE   : mean_phi=" + to_string(mean_phi_H)
            + " var_phi=" + to_string(var_phi_H)
            + " emits=" + to_string(emit_count_H)
            + " trough_emits=" + to_string(trough_emits_H)
            + " align_r=" + to_string(r_align_H))
    println("AUTONOMOUS : mean_phi=" + to_string(mean_phi_A)
            + " var_phi=" + to_string(var_phi_A)
            + " emits=" + to_string(emit_count_A)
            + " trough_emits=" + to_string(trough_emits_A)
            + " align_r=" + to_string(r_align_A))

    // derived metrics
    let phi_margin = if mean_phi_H > 0.000001 {
        (mean_phi_A - mean_phi_H) / mean_phi_H
    } else { 0.0 }
    let var_reduction = if var_phi_H > 0.000001 {
        (var_phi_H - var_phi_A) / var_phi_H
    } else { 0.0 }

    println("")
    println("phi_margin (auto/hardcode - 1)        = " + to_string(phi_margin))
    println("var_reduction (1 - auto/hardcode)     = " + to_string(var_reduction))

    // ── criteria ──
    let abs_r_A = _abs(r_align_A)
    let abs_r_H = _abs(r_align_H)
    let c1 = mean_phi_A >= (mean_phi_H * 1.10)
    let c2 = abs_r_A > abs_r_H
    let c3 = abs_r_A >= 0.20
    let c4 = trough_emits_H >= 1

    // ── falsifiers ──
    // F1: hardcoded Φ ≥ autonomous (no advantage)
    let f1 = mean_phi_A > mean_phi_H
    // F2: hardcoded |r| ≥ autonomous |r| (hardcode more coupled — falsifies
    //     substrate-autonomy advantage)
    let f2 = abs_r_A >= abs_r_H
    // F3: autonomous |r| < 0.10 (no tension-Φ coupling at all — substrate
    //     metric not informing emit decision)
    let f3 = abs_r_A >= 0.10
    // F4: re-run scalar summary byte-equal (autonomous emit_count + final_cells).
    //     L6 honest-limit: gauss RNG stream advances within-process, so full
    //     trajectory byte-equality is not expected; scalar attractor-stable
    //     summary metric used per H_205 F4 pattern.
    let mut emit_count_A2 = 0
    let mut ii = 0
    while ii < len(rA2["traj_emit"]) {
        emit_count_A2 = emit_count_A2 + rA2["traj_emit"][ii]
        ii = ii + 1
    }
    // attractor-stable scalar: final_cells (mitosis cap + merge-bounded
    // integer). emit_count diverges under stream-state advance because
    // tau threshold-crossing is highly sensitive to init noise — final_cells
    // is the H_205-style attractor-stable scalar.
    let f4 = rA2["final_cells"] == rA["final_cells"]
    // F5: substrate metric undefined (M/W/Φ NaN or all-zero)
    let f5 = (mean_phi_A > 0.0) && (mean_phi_H > 0.0)

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }
    if c4 { n_c = n_c + 1 }

    // verdict_rule: SUPPORTED if C1 AND C2 PASS  (autonomy Φ-richer AND
    //               more substrate-coupled emit timing)
    let supported = c1 && c2
    let verdict = if supported {
        if c3 && c4 { "SUPPORTED_FULL" } else { "SUPPORTED" }
    } else {
        if n_pass >= 3 { "PARTIAL" } else { "FAIL" }
    }
    // FALSIFIED override: F1 and F2 both fail simultaneously
    let falsified = !f1 && !f2
    let final_verdict = if falsified { "FALSIFIED" } else { verdict }

    println("")
    println("C1 mean_phi_auto > 1.10 * hardcode : " + _bool_str(c1))
    println("C2 |align_r|_auto > |align_r|_hard : " + _bool_str(c2)
            + "  (auto=" + to_string(abs_r_A) + ", hard=" + to_string(abs_r_H) + ")")
    println("C3 |align_r| auto >= 0.20          : " + _bool_str(c3))
    println("C4 hardcode trough-emits >= 1      : " + _bool_str(c4))
    println("")
    println("F1 AUTO-OVER-HARD  (Φ_auto > Φ_hard)        " + v1)
    println("F2 COUPLING-ADV    (|r|_auto > |r|_hard)    " + v2)
    println("F3 SUBSTRATE-TIE   (|r|_auto >= 0.10)       " + v3)
    println("F4 DETERMINISM     (re-run scalar equal)    " + v4)
    println("F5 SUBSTRATE-DEFD  (Φ defined both)         " + v5)
    println("================================================================")
    println("VERDICT: " + final_verdict
            + "  (" + to_string(n_c) + "/4 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_230\",\n"
    j = j + "  \"slug\": \"autonomy-over-hardcode-substrate\",\n"
    j = j + "  \"domain\": \"LIFE (ethics + consciousness + substrate)\",\n"
    j = j + "  \"title\": \"autonomy-over-hardcode substrate-level — CLAUDE.md a_autonomy_over_hardcode directive substrate-level instance\",\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"init_cells\": " + to_string(_init_cells())
          + ", \"n_steps\": " + to_string(_n_steps())
          + ", \"pool_cap_expected\": " + to_string(_pool_cap())
          + ", \"autonomy_threshold\": " + to_string(_autonomy_threshold()) + "},\n"
    j = j + "  \"patterns\": {\n"
    j = j + "    \"hardcode\": { \"splits\": " + to_string(rH["splits"])
          + ", \"final_cells\": " + to_string(rH["final_cells"])
          + ", \"mean_phi\": " + to_string(mean_phi_H)
          + ", \"var_phi\": " + to_string(var_phi_H)
          + ", \"emit_count\": " + to_string(emit_count_H)
          + ", \"trough_emits\": " + to_string(trough_emits_H)
          + ", \"align_r\": " + to_string(r_align_H)
          + ", \"traj_phi\": " + _float_arr_json(phi_H)
          + ", \"traj_M\": " + _float_arr_json(rH["traj_M"])
          + ", \"traj_W\": " + _float_arr_json(rH["traj_W"])
          + ", \"traj_tau_norm\": " + _float_arr_json(rH["traj_tau_norm"])
          + ", \"traj_emit\": " + _int_arr_json(rH["traj_emit"])
          + ", \"traj_cells\": " + _int_arr_json(rH["traj_cells"]) + " },\n"
    j = j + "    \"autonomous\": { \"splits\": " + to_string(rA["splits"])
          + ", \"final_cells\": " + to_string(rA["final_cells"])
          + ", \"mean_phi\": " + to_string(mean_phi_A)
          + ", \"var_phi\": " + to_string(var_phi_A)
          + ", \"emit_count\": " + to_string(emit_count_A)
          + ", \"trough_emits\": " + to_string(trough_emits_A)
          + ", \"align_r\": " + to_string(r_align_A)
          + ", \"traj_phi\": " + _float_arr_json(phi_A)
          + ", \"traj_M\": " + _float_arr_json(rA["traj_M"])
          + ", \"traj_W\": " + _float_arr_json(rA["traj_W"])
          + ", \"traj_tau_norm\": " + _float_arr_json(rA["traj_tau_norm"])
          + ", \"traj_emit\": " + _int_arr_json(rA["traj_emit"])
          + ", \"traj_cells\": " + _int_arr_json(rA["traj_cells"]) + " }\n"
    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"phi_margin\": " + to_string(phi_margin) + ",\n"
    j = j + "    \"var_reduction\": " + to_string(var_reduction) + ",\n"
    j = j + "    \"hardcode_align_r\": " + to_string(r_align_H) + ",\n"
    j = j + "    \"autonomous_align_r\": " + to_string(r_align_A) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_phi_auto_over_hardcode\":   " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_coupling_auto_over_hard\":  " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_substrate_tie_auto\":       " + _bool_str(c3) + ",\n"
    j = j + "    \"C4_hardcode_trough_emits\":    " + _bool_str(c4) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_AUTO_OVER_HARD\":  { \"metric\": \"mean_phi_auto > mean_phi_hard\", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_COUPLING_ADV\":    { \"metric\": \"|align_r|_auto > |align_r|_hard\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_SUBSTRATE_TIE\":   { \"metric\": \"|align_r|_auto >= 0.10\", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_DETERMINISM\":     { \"metric\": \"autonomous re-run scalar equal\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_SUBSTRATE_DEFD\":  { \"metric\": \"phi defined both modes\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + final_verdict + "\",\n"
    j = j + "  \"cross_link\": {\"CLAUDE.md\": \"@D a_autonomy_over_hardcode\", \"H_018\": \"SELFFEED substrate\", \"H_205\": \"closure↔selfref dynamics\", \"H_204\": \"weak-panpsy threshold\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h230()
