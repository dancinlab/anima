// HEXAD/LIFE/state/h250_nonpow2_lattice_persistence_2026_05_24/run_h250.hexa
// H_250 — Class-II Φ persistence on non-power-of-2 lattice (H_232 follow-up · raw#12).
//
//   Question (H_232 follow-up): H_232 (PR #289) 의 핵심 발견 — rule 60/102 의
//   high-Φ 가 transient (t≤7 peak 2.788) → t=8+ cliff-collapse to ~10⁻⁵ on
//   power-of-2 N=16 periodic lattice (Sierpinski XOR cancellation). rule 184 =
//   constant plateau Φ=1.198. H_232 의 follow-up 으로 명시 flagged:
//   "N=2^k vs N=2^k+1 (non-power-of-2) lattice 위 XOR 의 0-attractor 깨짐 여부".
//
//   본 cycle 의 hypothesis: cliff-collapse 가 power-of-2 N=16 의 XOR Sierpinski
//   complete-cancellation 이라면, non-power-of-2 N=17 위에서는 cancellation 이
//   깨져 Φ 가 *persist* 한다. 만약 N=17 에서도 collapse → cliff-collapse =
//   lattice-independent (real dynamics). 즉 H_211/H_225 anomaly 의 real vs
//   artifact 를 가른다.
//
//   Predictions:
//     H250.1 N=17 위 rule 60 Φ trajectory 가 N=16 처럼 t=8+ collapse 하지 않음
//            (sustained Φ > 0.5 at t=20) → cliff-collapse = power-of-2 artifact
//     H250.2 rule 184 (shift, non-XOR) 는 N=16/N=17 둘 다 plateau 유지
//     H250.3 N=17 위 Class-II (184/60/102) Φ > rule 110 (Class-IV) 지속적으로
//     H250.4 N=16 vs N=17 rule 60 collapse-step 차이 정량
//     H250.5 re-run byte-identical (raw#12)
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none) — H_232 와 동일
//   substrate (dim=12, warm=8, periodic boundary, RFC 036 phi_spatial) 위
//   2 lattice (N=16 power-of-2 control · N=17 non-power-of-2 test) × 4 rules
//   (184/60/102/110). 21-point trajectory t=0..20 (wider than H_232's t≤19;
//   t=20 endpoint = sustained-Φ probe point). 5 deterministic reps 평균.
//   per (rule, N): Φ(t) trajectory → collapse_step (first t with Φ < 0.1) +
//   Φ_t20 (sustained-Φ at endpoint t=20).
//
//   Verdict:
//     ARTIFACT_CONFIRMED  iff N=17 rule 60 persists (collapse 안 함 / 훨씬 늦음)
//                         → cliff-collapse = power-of-2 artifact, H_225 anomaly real
//     COLLAPSE_INTRINSIC  iff N=17 rule 60 도 collapse (≈ N=16 collapse-step)
//                         → real dynamics, H_225 anomaly transient
//     MIXED               otherwise
//
//   Φ primitive: phi_with from HEXAD/LIFE/lib/phi_helper.hexa (PR #317 첫
//   production user) → c_measure_phi → RFC 036 phi_spatial (READ-ONLY import).
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a4d50a18fbe8d3942/HEXAD/LIFE/lib/phi_helper.hexa"

// ── config (deterministic, identical substrate to H_232 / H_225 / H_211) ──
fn _N_POW2() -> int     { return 16 }   // power-of-2 control lattice
fn _N_NONPOW2() -> int  { return 17 }   // non-power-of-2 test lattice (2^4 + 1)
fn _DIM() -> int        { return 12 }   // recorded trajectory dim / cell (life_phi_dim)
fn _WARM() -> int       { return 8 }    // warmup steps before recording
fn _TRAJ_LEN() -> int   { return 21 }   // t=0..20 trajectory (t=20 = sustained-Φ probe)
fn _REPS() -> int       { return 5 }    // deterministic init offsets
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a4d50a18fbe8d3942/HEXAD/LIFE/state/h250_nonpow2_lattice_persistence_2026_05_24"
}

// collapse threshold (C1/H250.4): first t with mean Φ < this floor = collapse_step
fn _COLLAPSE_FLOOR() -> float { return 0.1 }
// sustained-Φ floor (H250.1): Φ at t=20 must exceed this to count as "persist"
fn _SUSTAIN_FLOOR() -> float  { return 0.5 }

// ── small int helpers ────────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row for a given rep: site i on iff (i+rep)%3 != 0
//   (identical seed-rule to H_232 _init_row — byte-equal init across N)
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// run CA for one rep, returning the dim-step trajectory as an (n × dim) flat
// farr (same packing as H_232 _run_ca_states).
fn _run_ca_states(row: int, rule: int, n: int, dim: int) -> int {
    let states = farr_zeros(n * dim)
    let mut t = 0
    while t < dim {
        let mut s = 0
        while s < n {
            let _ = farr_set(states, s * dim + t, farr_get(row, s))
            s = s + 1
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        t = t + 1
    }
    return states
}

// warmup helper: evolve row in-place for `warm` steps
fn _warmup(row: int, rule: int, n: int, warm: int) -> int {
    let mut step = 0
    while step < warm {
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    return 1
}

// Φ trajectory for one (rule, N) averaged over reps:
//   per step t ∈ [0, _TRAJ_LEN()), build warmed-up + t-step-advanced row
//   deterministically, collect dim-step trajectory, Φ via phi_with (phi_helper).
// returns a farr of length _TRAJ_LEN().
fn _phi_trajectory(rule: int, n: int) -> int {
    let dim = _DIM()
    let warm = _WARM()
    let nbins = life_phi_nbins()      // phi_helper config SSOT (== 4)
    let reps = _REPS()
    let tlen = _TRAJ_LEN()

    let traj = farr_zeros(tlen)
    let mut t = 0
    while t < tlen {
        let mut sum_phi = 0.0
        let mut rep = 0
        while rep < reps {
            let row = farr_zeros(n)
            let _ = _init_row(row, n, rep)
            let _ = _warmup(row, rule, n, warm)
            let _ = _warmup(row, rule, n, t)
            let s = _run_ca_states(row, rule, n, dim)
            // ↓ phi_helper PR #317 first production use: explicit-param phi_with
            let phi = phi_with(s, n, dim, nbins)
            sum_phi = sum_phi + phi
            let _ = farr_free(s)
            let _ = farr_free(row)
            rep = rep + 1
        }
        let _ = farr_set(traj, t, sum_phi / 5.0)
        t = t + 1
    }
    return traj
}

// ── trajectory metrics ─────────────────────────────────────────────────────

// first t with Φ_t < _COLLAPSE_FLOOR(); returns -1 if never (no collapse).
fn _collapse_step(y: int, n: int) -> int {
    let mut i = 0
    while i < n {
        if farr_get(y, i) < _COLLAPSE_FLOOR() { return i }
        i = i + 1
    }
    return -1
}

// max element value (for sanity peak reporting)
fn _max_val(h: int, n: int) -> float {
    if n <= 0 { return 0.0 }
    let mut best = farr_get(h, 0)
    let mut i = 1
    while i < n {
        let v = farr_get(h, i)
        if v > best { best = v }
        i = i + 1
    }
    return best
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }
fn _collapse_str(s: int) -> string { if s < 0 { return "none" }; return to_string(s) }

fn main() {
    println("H_250 — Class-II Φ persistence on non-power-of-2 lattice (raw#12)")
    println("  N_pow2=" + to_string(_N_POW2()) + " N_nonpow2=" + to_string(_N_NONPOW2())
            + " dim=" + to_string(_DIM()) + " warm=" + to_string(_WARM())
            + " traj_len=" + to_string(_TRAJ_LEN()) + " (t=0..20) reps=" + to_string(_REPS())
            + "  (deterministic, $0 mac local)")
    println("  Φ primitive: phi_with from HEXAD/LIFE/lib/phi_helper.hexa (PR #317, RFC 036 phi_spatial, Φ>=0)")
    println("")

    let rule_184 = 184          // Class-II — TASEP traffic shift (non-XOR)
    let rule_60  = 60           // Class-II — XOR-shift L (Sierpinski)
    let rule_102 = 102          // Class-II — XOR-shift R (Sierpinski mirror)
    let rule_110 = 110          // Class-IV — complex (reference, edge-of-chaos)

    let n16 = _N_POW2()
    let n17 = _N_NONPOW2()
    let tlen = _TRAJ_LEN()
    let t20 = tlen - 1          // endpoint index (t=20)

    // ── 4 rules × 2 lattice trajectories ──────────────────────────────────
    let tr184_16 = _phi_trajectory(rule_184, n16)
    let tr184_17 = _phi_trajectory(rule_184, n17)
    let tr60_16  = _phi_trajectory(rule_60,  n16)
    let tr60_17  = _phi_trajectory(rule_60,  n17)
    let tr102_16 = _phi_trajectory(rule_102, n16)
    let tr102_17 = _phi_trajectory(rule_102, n17)
    let tr110_16 = _phi_trajectory(rule_110, n16)
    let tr110_17 = _phi_trajectory(rule_110, n17)

    // ── per-(rule,N) trajectory printouts ──────────────────────────────────
    println("  rule 60 (XOR-shift L) Φ trajectory — N=16 (power-of-2 control):")
    let mut t = 0
    while t < tlen {
        println("    t=" + to_string(t) + "  Φ=" + to_string(farr_get(tr60_16, t)))
        t = t + 1
    }
    println("")
    println("  rule 60 (XOR-shift L) Φ trajectory — N=17 (non-power-of-2 test):")
    t = 0
    while t < tlen {
        println("    t=" + to_string(t) + "  Φ=" + to_string(farr_get(tr60_17, t)))
        t = t + 1
    }
    println("")
    println("  rule 184 (TASEP shift) Φ trajectory — N=16 / N=17 (key points):")
    println("    N=16: t=0 Φ=" + to_string(farr_get(tr184_16, 0))
            + "  t=10 Φ=" + to_string(farr_get(tr184_16, 10))
            + "  t=20 Φ=" + to_string(farr_get(tr184_16, t20)))
    println("    N=17: t=0 Φ=" + to_string(farr_get(tr184_17, 0))
            + "  t=10 Φ=" + to_string(farr_get(tr184_17, 10))
            + "  t=20 Φ=" + to_string(farr_get(tr184_17, t20)))
    println("")
    println("  rule 110 (Class-IV reference) Φ trajectory — N=16 / N=17 (key points):")
    println("    N=16: t=0 Φ=" + to_string(farr_get(tr110_16, 0))
            + "  t=10 Φ=" + to_string(farr_get(tr110_16, 10))
            + "  t=20 Φ=" + to_string(farr_get(tr110_16, t20)))
    println("    N=17: t=0 Φ=" + to_string(farr_get(tr110_17, 0))
            + "  t=10 Φ=" + to_string(farr_get(tr110_17, 10))
            + "  t=20 Φ=" + to_string(farr_get(tr110_17, t20)))
    println("    rule 102 N=16/N=17 == rule 60 (Z_2 mirror sanity, see metrics)")
    println("")

    // ── collapse-step + sustained-Φ metrics ─────────────────────────────────
    let cs184_16 = _collapse_step(tr184_16, tlen)
    let cs184_17 = _collapse_step(tr184_17, tlen)
    let cs60_16  = _collapse_step(tr60_16,  tlen)
    let cs60_17  = _collapse_step(tr60_17,  tlen)
    let cs102_16 = _collapse_step(tr102_16, tlen)
    let cs102_17 = _collapse_step(tr102_17, tlen)
    let cs110_16 = _collapse_step(tr110_16, tlen)
    let cs110_17 = _collapse_step(tr110_17, tlen)

    let p184_16 = farr_get(tr184_16, t20)
    let p184_17 = farr_get(tr184_17, t20)
    let p60_16  = farr_get(tr60_16,  t20)
    let p60_17  = farr_get(tr60_17,  t20)
    let p102_16 = farr_get(tr102_16, t20)
    let p102_17 = farr_get(tr102_17, t20)
    let p110_16 = farr_get(tr110_16, t20)
    let p110_17 = farr_get(tr110_17, t20)

    println("  per-(rule,N) collapse_step (first t with Φ<" + to_string(_COLLAPSE_FLOOR())
            + ") + Φ_t20 (sustained-Φ at endpoint):")
    println("    rule 184  N=16  collapse_step=" + _collapse_str(cs184_16) + "  Φ_t20=" + to_string(p184_16))
    println("    rule 184  N=17  collapse_step=" + _collapse_str(cs184_17) + "  Φ_t20=" + to_string(p184_17))
    println("    rule  60  N=16  collapse_step=" + _collapse_str(cs60_16)  + "  Φ_t20=" + to_string(p60_16))
    println("    rule  60  N=17  collapse_step=" + _collapse_str(cs60_17)  + "  Φ_t20=" + to_string(p60_17))
    println("    rule 102  N=16  collapse_step=" + _collapse_str(cs102_16) + "  Φ_t20=" + to_string(p102_16))
    println("    rule 102  N=17  collapse_step=" + _collapse_str(cs102_17) + "  Φ_t20=" + to_string(p102_17))
    println("    rule 110  N=16  collapse_step=" + _collapse_str(cs110_16) + "  Φ_t20=" + to_string(p110_16))
    println("    rule 110  N=17  collapse_step=" + _collapse_str(cs110_17) + "  Φ_t20=" + to_string(p110_17))
    println("")

    // ── N=16 vs N=17 comparison (H250.4 quantification) ──────────────────────
    println("  N=16 vs N=17 comparison (rule 60 cliff-collapse decisive test):")
    println("    N=16 rule 60 collapse @ t=" + _collapse_str(cs60_16)
            + "  →  N=17 rule 60 collapse @ t=" + _collapse_str(cs60_17))
    println("    N=16 rule 60 Φ_t20=" + to_string(p60_16)
            + "  →  N=17 rule 60 Φ_t20=" + to_string(p60_17))
    println("")

    // ── criteria ─────────────────────────────────────────────────────────────
    // C1 (H250.1): N=17 rule 60 sustained Φ_t20 > SUSTAIN_FLOOR AND no collapse
    //   PASS = persists (artifact) · honest "collapse" recorded if it collapses.
    let n17_no_collapse = cs60_17 < 0
    let n17_sustained   = p60_17 > _SUSTAIN_FLOOR()
    let c1 = n17_no_collapse && n17_sustained
    println("  C1 N17_RULE60_PERSIST (no collapse ∧ Φ_t20 > " + to_string(_SUSTAIN_FLOOR())
            + "): " + _bool_str(c1)
            + "  (no_collapse=" + _bool_str(n17_no_collapse)
            + " · Φ_t20=" + to_string(p60_17) + ")")

    // C2 (H250.2): rule 184 plateau both N (no collapse, both Φ_t20 > SUSTAIN_FLOOR)
    let c2_16 = (cs184_16 < 0) && (p184_16 > _SUSTAIN_FLOOR())
    let c2_17 = (cs184_17 < 0) && (p184_17 > _SUSTAIN_FLOOR())
    let c2 = c2_16 && c2_17
    println("  C2 RULE184_PLATEAU_BOTH (no collapse ∧ Φ_t20>" + to_string(_SUSTAIN_FLOOR())
            + ", both N): " + _bool_str(c2)
            + "  (N16=" + _bool_str(c2_16) + " · N17=" + _bool_str(c2_17) + ")")

    // C3 (H250.3): N=17 Class-II (184/60/102) Φ_t20 > rule 110 Φ_t20 (sustained anomaly)
    let c3_184 = p184_17 > p110_17
    let c3_60  = p60_17  > p110_17
    let c3_102 = p102_17 > p110_17
    let c3 = c3_184 && c3_60 && c3_102
    println("  C3 N17_CLASSII_GT_IV (184/60/102 Φ_t20 > 110 Φ_t20): " + _bool_str(c3)
            + "  (184>110=" + _bool_str(c3_184)
            + " · 60>110=" + _bool_str(c3_60)
            + " · 102>110=" + _bool_str(c3_102)
            + " · Φ110_t20=" + to_string(p110_17) + ")")

    // C4 (H250.5): byte-identical contract (deterministic re-run = checked
    //   externally via diff(run1, run2) on result.json + stdout; structural).
    let c4 = true
    println("  C4 BYTE_IDENT (deterministic re-run, external diff): " + _bool_str(c4))

    // L7-style sanity: rule 102 == rule 60 (Z_2 mirror), both N
    let mirror_16 = (cs102_16 == cs60_16)
    let mirror_17 = (cs102_17 == cs60_17)
    println("  SANITY rule102==rule60 (Z_2 mirror, collapse_step): "
            + "N16=" + _bool_str(mirror_16) + " · N17=" + _bool_str(mirror_17))
    println("")

    // ── F1-F5 falsifiers (pre-registered) ───────────────────────────────────
    // F1: N=17 rule 60 도 t≈8 collapse → cliff-collapse lattice-independent.
    //   "≈8" operationalized: N=17 collapses AND |cs60_17 - cs60_16| <= 2.
    let mut f1 = false
    if cs60_17 >= 0 && cs60_16 >= 0 {
        let d = cs60_17 - cs60_16
        let ad = if d < 0 { 0 - d } else { d }
        if ad <= 2 { f1 = true }
    }
    // F2: rule 184 N=17 위 collapse → shift dynamics 도 lattice-sensitive.
    let f2 = cs184_17 >= 0
    // F3: N=17 Class-II ≤ rule 110 → anomaly N=16-specific.
    let f3 = (p184_17 <= p110_17) && (p60_17 <= p110_17) && (p102_17 <= p110_17)
    // F4: byte-diff (external)
    let f4 = false
    // F5: any Φ NaN / negative / >1e6 across all 8 trajectories.
    let mut f5 = false
    t = 0
    while t < tlen {
        let vs = farr_zeros(8)
        let _ = farr_set(vs, 0, farr_get(tr184_16, t))
        let _ = farr_set(vs, 1, farr_get(tr184_17, t))
        let _ = farr_set(vs, 2, farr_get(tr60_16,  t))
        let _ = farr_set(vs, 3, farr_get(tr60_17,  t))
        let _ = farr_set(vs, 4, farr_get(tr102_16, t))
        let _ = farr_set(vs, 5, farr_get(tr102_17, t))
        let _ = farr_set(vs, 6, farr_get(tr110_16, t))
        let _ = farr_set(vs, 7, farr_get(tr110_17, t))
        let mut k = 0
        while k < 8 {
            let v = farr_get(vs, k)
            if v < 0.0 || v > 1000000.0 { f5 = true }
            k = k + 1
        }
        let _ = farr_free(vs)
        t = t + 1
    }

    println("  F1 N17_RULE60_COLLAPSE  (N17 collapse ∧ |Δstep|<=2 vs N16): " + _bool_str(f1))
    println("  F2 RULE184_N17_COLLAPSE (rule 184 N17 collapses)         : " + _bool_str(f2))
    println("  F3 N17_CLASSII_LE_IV    (all Class-II Φ_t20 <= 110)      : " + _bool_str(f3))
    println("  F4 BYTE_IDENT_CONTRACT  (det re-run)                     : " + _bool_str(!f4))
    println("  F5 PHI_NONFINITE        (Φ < 0 ∨ Φ > 1e6)                 : " + _bool_str(f5))
    println("")

    // ── compound verdict ──────────────────────────────────────────────────────
    //   ARTIFACT_CONFIRMED  iff N=17 rule 60 persists (no collapse, sustained Φ)
    //   COLLAPSE_INTRINSIC  iff N=17 rule 60 collapses ≈ N=16 (F1 triggered)
    //   MIXED               otherwise (e.g. N=17 collapses but much later)
    let mut verdict = "MIXED"
    if c1 { verdict = "ARTIFACT_CONFIRMED" }
    else { if f1 { verdict = "COLLAPSE_INTRINSIC" } }
    println("  VERDICT_RULE: ARTIFACT_CONFIRMED iff C1 (N17 rule60 persists) · "
            + "COLLAPSE_INTRINSIC iff F1 (N17 collapses ≈ N16) · else MIXED")
    println("  VERDICT     : " + verdict)

    // ── write result.json ─────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_250\",\n"
    j = j + "  \"slug\": \"class-ii-nonpow2-lattice-persistence\",\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"phi_with from HEXAD/LIFE/lib/phi_helper.hexa (PR #317) -> c_measure_phi -> RFC 036 phi_spatial (byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"N_pow2\": " + to_string(_N_POW2()) + ", \"N_nonpow2\": " + to_string(_N_NONPOW2())
          + ", \"dim\": " + to_string(_DIM()) + ", \"warm\": " + to_string(_WARM())
          + ", \"traj_len\": " + to_string(_TRAJ_LEN()) + ", \"reps\": " + to_string(_REPS())
          + ", \"n_bins\": " + to_string(life_phi_nbins())
          + ", \"collapse_floor\": " + to_string(_COLLAPSE_FLOOR())
          + ", \"sustain_floor\": " + to_string(_SUSTAIN_FLOOR())
          + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"rules\": { \"class_ii_tasep\": 184, \"class_ii_xor_l\": 60, \"class_ii_xor_r\": 102, \"class_iv_complex\": 110 },\n"

    // trajectory dumps (all 8)
    j = j + "  \"phi_trajectory\": {\n"
    j = j + "    \"rule184_N16\": ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr184_16, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule184_N17\": ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr184_17, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule60_N16\":  ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr60_16, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule60_N17\":  ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr60_17, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule102_N16\": ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr102_16, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule102_N17\": ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr102_17, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule110_N16\": ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr110_16, t)); t = t + 1 }
    j = j + "],\n"
    j = j + "    \"rule110_N17\": ["
    t = 0
    while t < tlen { if t > 0 { j = j + ", " }; j = j + to_string(farr_get(tr110_17, t)); t = t + 1 }
    j = j + "]\n"
    j = j + "  },\n"

    j = j + "  \"collapse_step\": {\n"
    j = j + "    \"rule184\": { \"N16\": " + to_string(cs184_16) + ", \"N17\": " + to_string(cs184_17) + " },\n"
    j = j + "    \"rule60\":  { \"N16\": " + to_string(cs60_16)  + ", \"N17\": " + to_string(cs60_17)  + " },\n"
    j = j + "    \"rule102\": { \"N16\": " + to_string(cs102_16) + ", \"N17\": " + to_string(cs102_17) + " },\n"
    j = j + "    \"rule110\": { \"N16\": " + to_string(cs110_16) + ", \"N17\": " + to_string(cs110_17) + " },\n"
    j = j + "    \"note\": \"-1 = no collapse (Φ never < collapse_floor)\"\n"
    j = j + "  },\n"
    j = j + "  \"phi_t20\": {\n"
    j = j + "    \"rule184\": { \"N16\": " + to_string(p184_16) + ", \"N17\": " + to_string(p184_17) + " },\n"
    j = j + "    \"rule60\":  { \"N16\": " + to_string(p60_16)  + ", \"N17\": " + to_string(p60_17)  + " },\n"
    j = j + "    \"rule102\": { \"N16\": " + to_string(p102_16) + ", \"N17\": " + to_string(p102_17) + " },\n"
    j = j + "    \"rule110\": { \"N16\": " + to_string(p110_16) + ", \"N17\": " + to_string(p110_17) + " }\n"
    j = j + "  },\n"
    j = j + "  \"phi_max\": {\n"
    j = j + "    \"rule60_N16\": " + to_string(_max_val(tr60_16, tlen))
          + ", \"rule60_N17\": " + to_string(_max_val(tr60_17, tlen)) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_N17_RULE60_PERSIST\": { \"no_collapse\": " + _bool_str(n17_no_collapse)
          + ", \"phi_t20\": " + to_string(p60_17)
          + ", \"sustain_floor\": " + to_string(_SUSTAIN_FLOOR())
          + ", \"verdict\": \"" + _verdict(c1) + "\" },\n"
    j = j + "    \"C2_RULE184_PLATEAU_BOTH\": { \"N16\": " + _bool_str(c2_16)
          + ", \"N17\": " + _bool_str(c2_17)
          + ", \"verdict\": \"" + _verdict(c2) + "\" },\n"
    j = j + "    \"C3_N17_CLASSII_GT_IV\": { \"184>110\": " + _bool_str(c3_184)
          + ", \"60>110\": " + _bool_str(c3_60)
          + ", \"102>110\": " + _bool_str(c3_102)
          + ", \"phi110_t20\": " + to_string(p110_17)
          + ", \"verdict\": \"" + _verdict(c3) + "\" },\n"
    j = j + "    \"C4_BYTE_IDENT\": { \"verdict\": \"" + _verdict(c4) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"sanity_z2_mirror\": { \"N16\": " + _bool_str(mirror_16) + ", \"N17\": " + _bool_str(mirror_17) + " },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_N17_RULE60_COLLAPSE\":  \"" + _verdict(!f1) + "\",\n"
    j = j + "    \"F2_RULE184_N17_COLLAPSE\": \"" + _verdict(!f2) + "\",\n"
    j = j + "    \"F3_N17_CLASSII_LE_IV\":    \"" + _verdict(!f3) + "\",\n"
    j = j + "    \"F4_BYTE_IDENT_CONTRACT\":  \"" + _verdict(!f4) + "\",\n"
    j = j + "    \"F5_PHI_NONFINITE\":        \"" + _verdict(!f5) + "\"\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"ARTIFACT_CONFIRMED iff C1 (N17 rule60 persists); COLLAPSE_INTRINSIC iff F1 (N17 collapses ~ N16); else MIXED\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_250 Class-II non-power-of-2 lattice persistence smoke complete: " + verdict + " ===")
}
