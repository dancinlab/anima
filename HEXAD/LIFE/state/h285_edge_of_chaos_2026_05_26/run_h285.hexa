// HEXAD/LIFE/state/h285_edge_of_chaos_2026_05_26/run_h285.hexa
//
//   H_285 — faithful IIT4 big-Φ at edge-of-chaos (Wolfram-class ladder).
//
//   H_204 (inverse-U Φ at edge-of-chaos, H_268 flagged LZ-fragile) + H_007
//   (λ-sweep Φ class) were measured with the PROXY phi_spatial. Here we re-measure
//   the SAME question with faithful CAUSAL IIT 4.0 big-Φ via the ECA→TPM bridge:
//     does faithful big-Φ PEAK at edge-of-chaos (Wolfram class IV), above the
//     ordered (class I) and chaotic (class III) classes?
//
//   Integration scalar = big-Φ (NOT Σφ_d — xval #572 showed Σφ_d non-monotone).
//   Φ is state-dependent (FAITHFUL_REMEASURE §4) ⇒ we report MEAN big-Φ over ALL
//   2^n=16 states per rule (not single-state), to avoid single-state fragility.
//
//   Wolfram-class ladder (n=4 ring):
//     ordered  (I)   : rule 0   (→0 homogeneous)  · rule 204 (identity, reducible)
//     edge     (IV)  : rule 110 (LIFE complex)    · rule 54  (LIFE complex)
//     chaotic  (III) : rule 30  (chaotic)         · rule 90  (XOR l,r)
//
//   reuse HEXAD/IIT4/lib (g61, no reinvention) · big-Φ NOT Σφ_d · deterministic
//   · hexa-only · $0 mac local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_eca.hexa"  // main-repo abs (M6 관례); 워크트리 재실행 시 워크트리 경로로 임시패치 필요

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.0001 }
    return d < 0.0001
}

// mean faithful big-Φ over all 2^n=16 states (state-averaged, n=4 fixed)
fn mean_phi(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let mut s = 0.0
    let mut st = 0
    while st < 16 {
        let r = big_phi(tpm, n, st)
        s = s + r[0]
        st = st + 1
    }
    return s / 16.0
}

// max faithful big-Φ over all 16 states
fn max_phi(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let mut m = 0.0
    let mut st = 0
    while st < 16 {
        let r = big_phi(tpm, n, st)
        if r[0] > m { m = r[0] }
        st = st + 1
    }
    return m
}

fn phi_at(rule: int, n: int, st: int) -> float {
    let r = big_phi(eca_tpm(rule, n), n, st)
    return r[0]
}

fn main() {
    let n = 4
    println("================================================================")
    println("  H_285 faithful IIT4 big-Φ @ edge-of-chaos (n=4 ring · mean over 16 states)")
    println("  integration scalar = big-Φ (NOT Σφ_d) · reuse HEXAD/IIT4/lib")
    println("================================================================")

    let o0   = mean_phi(0,   n)
    let o204 = mean_phi(204, n)
    let e110 = mean_phi(110, n)
    let e54  = mean_phi(54,  n)
    let c30  = mean_phi(30,  n)
    let c90  = mean_phi(90,  n)

    println("  [mean big-Φ over 16 states]")
    println("  ordered (I)  : rule0=" + str(o0) + "  rule204=" + str(o204))
    println("  edge   (IV)  : rule110=" + str(e110) + "  rule54=" + str(e54))
    println("  chaotic (III): rule30=" + str(c30) + "  rule90=" + str(c90))

    let m110 = max_phi(110, n)
    let m54  = max_phi(54,  n)
    let m30  = max_phi(30,  n)
    let m90  = max_phi(90,  n)
    println("  [max big-Φ over 16 states] rule110=" + str(m110) + " rule54=" + str(m54) + " rule30=" + str(m30) + " rule90=" + str(m90))

    let ordered_mean = (o0 + o204) / 2.0
    let edge_mean    = (e110 + e54) / 2.0
    let chaotic_mean = (c30 + c90) / 2.0
    println("  CLASS-MEAN: ordered=" + str(ordered_mean) + " edge=" + str(edge_mean) + " chaotic=" + str(chaotic_mean))

    // M6 anchors at state 1010 (=10)
    let a204 = phi_at(204, n, 10)
    let a110 = phi_at(110, n, 10)
    println("  [state 1010 anchors] rule204=" + str(a204) + " rule110=" + str(a110))

    // ── pre-registered falsifiers ──────────────────────────────────────
    check("F285.3a rule204 big-Φ=0 @1010 (M6 anchor, reducible)", approx(a204, 0.0))
    check("F285.3b rule110 big-Φ≈7.5475 @1010 (M6 anchor)", approx(a110, 7.5475))
    check("F285.3c big-Φ >= 0 (bound, all classes)", o0 >= 0.0 && e110 >= 0.0 && c30 >= 0.0)
    check("F285.1 edge-mean > ordered-mean", edge_mean > ordered_mean)
    check("F285.2 edge-mean > chaotic-mean (inverse-U peak @ class IV)", edge_mean > chaotic_mean)

    println("  ----------------------------------------------------------------")
    println("  PASS=" + str(PASS) + " FAIL=" + str(FAIL))
}
