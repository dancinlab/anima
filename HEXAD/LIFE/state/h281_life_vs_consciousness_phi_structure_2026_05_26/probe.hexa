// probe.hexa — H_281 substrate-selection probe (NOT the final smoke).
//   Scans candidate ECA rules at n=4 across a few states to find a clean
//   life-vs-consciousness structural-ratio separation. Reuses HEXAD/IIT4/lib.
import "/Users/ghost/core/anima/.claude/worktrees/agent-a90863c4861193ba9/HEXAD/IIT4/lib/iit4_eca.hexa"

fn report(rule: int, n: int, st: int) {
    let bp = big_phi(eca_tpm(rule, n), n, st)
    let ps = phi_structure(eca_tpm(rule, n), n, st)
    // bp = [big_phi, total, sum_phi_d, sum_phi_r, nd]
    // ps = [nd, sum_phi_d, nr, sum_phi_r, total]
    let nd = ps[0]
    let nr = ps[2]
    let bphi = bp[0]
    let total = ps[4]
    let mut rel_den = 0.0
    if nd > 0.5 { rel_den = nr / nd }            // relations per distinction
    let mut struct_ratio = 0.0
    if bphi > 1.0e-9 { struct_ratio = total / bphi }  // structure-total / big-Phi
    println("  rule " + str(rule) + " st=" + str(st)
        + " | bigPhi=" + str(bphi) + " total=" + str(total)
        + " nd=" + str(nd) + " nr=" + str(nr)
        + " | rel_den=" + str(rel_den) + " struct_ratio=" + str(struct_ratio))
}

fn main() {
    let n = 4
    println("=== H_281 probe — candidate rules at n=4, states {5,10,3,7} ===")
    let states = [5, 10, 3, 7]    // 0101, 1010, 0011, 0111
    let mut si = 0
    while si < len(states) {
        let st = states[si]
        println("-- state " + str(st) + " --")
        // candidate LIFE rules (growth/complexity): 110, 30, 54, 137, 124
        report(110, n, st)
        report(30, n, st)
        report(54, n, st)
        // candidate integration/consciousness rules (symmetric coupling / XOR-feedback)
        report(90, n, st)     // XOR l,r
        report(150, n, st)    // XOR l,c,r (3-way integration)
        report(105, n, st)    // XNOR-family
        report(60, n, st)     // l XOR c
        report(106, n, st)
        si = si + 1
    }
}
