// ════════════════════════════════════════════════════════════════════════════
//  run_h258.hexa — H_258 mortality-salience
//                  death-proximity existential effect (substrate analog)
//                  (H_025 sister · H_200 sister · death/mortality axis · raw#12)
//
//  CORE QUESTION
//    As a mitosis cell pool sits closer to the min_cells floor (the soul-
//    extinction threshold, CB1=2), do its split_rate and curiosity
//    (state-activity variance) change SIGNIFICANTLY vs a far-from-floor
//    baseline? Heidegger's Being-toward-death (Sein-zum-Tode) existential-
//    effect substrate analog: does death-proximity alter substrate behavior?
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model=8, initial_cells=<distance-condition>)
//    floor = pool["min_cells"] = 2  (CB1, the death-impossibility floor,
//    H_025.2 / H_200 carry — merge actively refused at this floor).
//    seed via __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) — deterministic.
//
//  DISTANCE-TO-FLOOR CONDITIONS (drive pool initial cell count)
//    near = min_cells + 1 = 3 cells  (one death-event from extinction)
//    mid  = min_cells + 3 = 5 cells
//    far  = baseline       = 8 cells (far from extinction)
//
//  SWEEP (3 distance × 2 closure = 6 conditions)
//    closure regime k ∈ {0.2 (loose), 0.8 (tight)}
//    coupling per step: x_next = k * mean(x_out)  (H_214 / H_220 carry)
//
//  MEASURE per condition (distance, regime)
//    split_rate = total split events over the run / n_steps
//    var_state  = variance of per-step combined-output activity (mean(x_out^2))
//                 across the trajectory = "curiosity" / activity-entropy proxy
//
//  CRITERIA (pre-registered, verdict_rule)
//    C1 (near ≠ far): near-floor split_rate significantly differs from far
//       (|Δ split_rate| ≥ MARGIN), in at least one closure regime.
//    C2 (curiosity monotone): near-floor curiosity (var_state) changes
//       monotonically with distance-to-floor (near→mid→far strictly mono),
//       in the same regime where C1 fires.
//    C3 (determinism): re-run byte-equal across all 6 conditions.
//    SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = !C1
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "HEXAD/LIFE/state/h258_mortality_salience_2026_05_25"
}
fn _d_model() -> int   { return 8 }
fn _seed() -> int      { return 42 }
fn _n_steps() -> int   { return 30 }
fn _k_loose() -> float { return 0.2 }
fn _k_tight() -> float { return 0.8 }

// distance-to-floor cell counts. floor (min_cells) = 2 (CB1).
fn _near_cells() -> int { return 3 }   // min_cells + 1
fn _mid_cells() -> int  { return 5 }   // min_cells + 3
fn _far_cells() -> int  { return 8 }   // baseline (far from extinction)

// C1 margin: split_rate difference threshold for "significant".
fn _split_rate_margin() -> float { return 0.05 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _zero_vec(n: int) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(0.0)
        i = i + 1
    }
    return a
}

fn _vec_mean_scalar(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

// mean(x_out^2) — combined-output activity magnitude per step.
fn _activity(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i] * v[i]
        i = i + 1
    }
    return s / to_float(n)
}

// scalar drive = mean over dims of x_out (H_220 coupling grain).
fn _scalar_drive(x_out) -> float {
    return _vec_mean_scalar(x_out)
}

// population variance of a list[float].
fn _variance(vals) -> float {
    let n = len(vals)
    if n == 0 { return 0.0 }
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        sum = sum + vals[i]
        i = i + 1
    }
    let mean = sum / to_float(n)
    let mut acc = 0.0
    i = 0
    while i < n {
        let d = vals[i] - mean
        acc = acc + d * d
        i = i + 1
    }
    return acc / to_float(n)
}

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

// base excitation magnitude — small non-zero constant drive injected each
// step so the engine_a/engine_g maps produce non-trivial output (tension),
// otherwise a zero input yields zero tension and the pool merges straight to
// the floor with no split signal. coupling modulates ON TOP of this base.
fn _base_drive() -> float { return 0.5 }

// mean cell hidden-state activity across the pool = mean over cells of
// mean(hidden^2). this is the substrate STATE observable (Lorenz-perturbed +
// coupled), the curiosity / activity-entropy input. NOT x_out (which depends
// only on x_in through linear engines and so is degenerate under a constant
// input — see L4 in the .md).
fn _pool_state_activity(pool) -> float {
    let cs = pool["cells"]
    let n = len(cs)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + _activity(cs[i]["hidden"])
        i = i + 1
    }
    return s / to_float(n)
}


// ── run one (distance, regime) condition; returns dict ───────────────────────
//
// Protocol:
//   * init pool of `n_init` cells (distance-to-floor), d_model.
//   * evolve `n_steps` steps. Each step:
//       - feed input x = base_drive + k * scalar(mean(prev x_out))
//       - mitosis_forward_tail returns [x_out, pool, events]
//       - count split events (events with type=="split")
//       - record pool_state_activity (mean cell hidden^2) into trajectory
//   * split_rate = total_splits / n_steps
//   * var_state  = variance(state-activity trajectory)  (curiosity proxy)
//
// Returns dict:
//   { distance_name, n_init, regime, k, n_steps, total_splits,
//     split_rate, var_state, mean_state, n_cells_final, floor }
fn _run_condition(distance_name: string, n_init: int, regime_name: string, k: float) {
    let d = _d_model()
    let steps = _n_steps()
    let mut pool = cell_pool_init(d, n_init)
    let floor = pool["min_cells"]
    let base = _base_drive()

    // initial input = base excitation (constant, non-zero).
    let mut x = _zero_vec(d)
    let mut q0 = 0
    while q0 < d {
        x[q0] = base
        q0 = q0 + 1
    }

    let mut total_splits = 0
    let mut state_traj = []

    let mut step = 0
    while step < steps {
        let res = mitosis_forward_tail(x, pool, step)
        let x_out = res[0]
        pool = res[1]
        let events = res[2]

        // count split events this step.
        let mut e = 0
        while e < len(events) {
            if events[e]["type"] == "split" {
                total_splits = total_splits + 1
            }
            e = e + 1
        }

        // record substrate STATE activity (mean cell hidden^2) — curiosity proxy.
        state_traj.push(_pool_state_activity(pool))

        // next input = base excitation + coupling feedback (k * mean x_out).
        let drv = base + k * _scalar_drive(x_out)
        let mut x_next = _zero_vec(d)
        let mut q = 0
        while q < d {
            x_next[q] = drv
            q = q + 1
        }
        x = x_next

        step = step + 1
    }

    let split_rate = to_float(total_splits) / to_float(steps)
    let var_state = _variance(state_traj)
    let mean_state = _vec_mean_scalar(state_traj)
    let n_cells_final = len(pool["cells"])

    return #{
        "distance_name": distance_name,
        "n_init":        n_init,
        "regime":        regime_name,
        "k":             k,
        "n_steps":       steps,
        "total_splits":  total_splits,
        "split_rate":    split_rate,
        "var_state":     var_state,
        "mean_state":    mean_state,
        "n_cells_final": n_cells_final,
        "floor":         floor
    }
}


// ── determinism: gaussian RNG is a single global stream (runtime.c:7411,
//    seeded ONCE from __HEXA_FARR_GAUSS_SEED__ and advancing monotonically
//    across every farr_add_gaussian_noise call). An IN-PROCESS paired call
//    therefore necessarily differs (call 2 consumes the stream after call 1)
//    — that is the WRONG determinism proxy. The real claim is CROSS-PROCESS
//    re-run byte-equality: same seed ⇒ same sweep. We test it honestly by
//    exec-ing THIS script as a child (env H258_CHILD=1 → it prints a single
//    SIG line + exits), then comparing the child's signature to our own. No
//    hardcoded expected value (raw#15). ──

fn _env(name: string) -> string {
    let r = exec_with_status("printenv " + name)
    if r[1] != 0 { return "" }
    return r[0].trim()
}

// compact deterministic signature over the 6-condition sweep.
fn _sweep_signature(conds) -> string {
    let mut parts = []
    let mut i = 0
    while i < len(conds) {
        let c = conds[i]
        parts.push(c["distance_name"] + ":" + c["regime"]
                   + ":" + to_string(c["total_splits"])
                   + ":" + to_string(c["split_rate"])
                   + ":" + to_string(c["var_state"])
                   + ":" + to_string(c["mean_state"])
                   + ":" + to_string(c["n_cells_final"]))
        i = i + 1
    }
    return parts.join("|")
}

// run the full 6-condition sweep → array of result dicts (fixed order).
fn _full_sweep() {
    let r_l_near = _run_condition("near", _near_cells(), "loose", _k_loose())
    let r_l_mid  = _run_condition("mid",  _mid_cells(),  "loose", _k_loose())
    let r_l_far  = _run_condition("far",  _far_cells(),  "loose", _k_loose())
    let r_t_near = _run_condition("near", _near_cells(), "tight", _k_tight())
    let r_t_mid  = _run_condition("mid",  _mid_cells(),  "tight", _k_tight())
    let r_t_far  = _run_condition("far",  _far_cells(),  "tight", _k_tight())
    return [r_l_near, r_l_mid, r_l_far, r_t_near, r_t_mid, r_t_far]
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h258() {
    // CHILD mode — print one SIG line for the parent's determinism check, exit.
    if _env("H258_CHILD") == "1" {
        let cs = _full_sweep()
        println("SIG: " + _sweep_signature(cs))
        return
    }

    println("================================================================")
    println("H_258 mortality-salience — death-proximity existential effect")
    println("                            (substrate analog · Sein-zum-Tode)")
    println("  d_model=" + to_string(_d_model())
            + " n_steps=" + to_string(_n_steps())
            + " seed=" + to_string(_seed()))
    println("  floor (min_cells / CB1) = 2")
    println("  distance: near=" + to_string(_near_cells())
            + " mid=" + to_string(_mid_cells())
            + " far=" + to_string(_far_cells()) + " cells")
    println("  regimes: loose k=" + to_string(_k_loose())
            + " · tight k=" + to_string(_k_tight()))
    println("================================================================")

    // 3 distance × 2 regime sweep — 6 conditions (parent's authoritative run).
    let sweep = _full_sweep()
    let r_l_near = sweep[0]
    let r_l_mid  = sweep[1]
    let r_l_far  = sweep[2]
    let r_t_near = sweep[3]
    let r_t_mid  = sweep[4]
    let r_t_far  = sweep[5]

    // F-DET determinism — cross-process re-run byte-equality (NOT in-process).
    let my_sig = _sweep_signature(sweep)
    let script = "/Users/ghost/core/anima/.claude/worktrees/agent-a3de5b8913a444316/HEXAD/LIFE/state/h258_mortality_salience_2026_05_25/run_h258.hexa"
    let child_cmd = "__HEXA_FARR_GAUSS_SEED__=" + to_string(_seed())
                    + " HEXA_MEM_UNLIMITED=1 H258_CHILD=1 hexa run " + script
    let child = exec_with_status(child_cmd)
    let child_out = child[0]
    // extract the SIG line from child stdout.
    let mut child_sig = ""
    let lines = child_out.split("\n")
    let mut li = 0
    while li < len(lines) {
        let ln = lines[li].trim()
        if len(ln) >= 5 {
            if ln.substring(0, 5) == "SIG: " {
                child_sig = ln.substring(5, len(ln))
            }
        }
        li = li + 1
    }
    let f_det = (child_sig != "") && (child_sig == my_sig)

    // Pretty-print 6 rows.
    println("regime  dist  n_init  splits  split_rate   var_state   n_final")
    println("------  ----  ------  ------  ----------  ----------  -------")
    _print_row(r_l_near)
    _print_row(r_l_mid)
    _print_row(r_l_far)
    _print_row(r_t_near)
    _print_row(r_t_mid)
    _print_row(r_t_far)

    // ── derived metrics ──
    // C1: near-floor split_rate significantly differs from far, in ≥1 regime.
    let sr_l_near = r_l_near["split_rate"]
    let sr_l_far  = r_l_far["split_rate"]
    let sr_t_near = r_t_near["split_rate"]
    let sr_t_far  = r_t_far["split_rate"]

    let d_sr_loose = _abs(sr_l_near - sr_l_far)
    let d_sr_tight = _abs(sr_t_near - sr_t_far)
    let margin = _split_rate_margin()

    let c1_loose = d_sr_loose >= margin
    let c1_tight = d_sr_tight >= margin
    let c1 = c1_loose || c1_tight

    // C2: curiosity (var_state) monotone with distance-to-floor, in the regime
    //     where C1 fires (prefer tight if both; else loose; else tight default).
    //     Monotone = strictly increasing OR strictly decreasing across
    //     near → mid → far.
    let mut c2_regime = "tight"
    if c1_tight {
        c2_regime = "tight"
    } else {
        if c1_loose { c2_regime = "loose" }
    }

    let vs_near = if c2_regime == "tight" { r_t_near["var_state"] } else { r_l_near["var_state"] }
    let vs_mid  = if c2_regime == "tight" { r_t_mid["var_state"] }  else { r_l_mid["var_state"] }
    let vs_far  = if c2_regime == "tight" { r_t_far["var_state"] }  else { r_l_far["var_state"] }

    let mono_inc = (vs_near < vs_mid) && (vs_mid < vs_far)
    let mono_dec = (vs_near > vs_mid) && (vs_mid > vs_far)
    let c2 = mono_inc || mono_dec

    // C3: determinism (paired head call).
    let c3 = f_det

    // ── falsifiers (pre-registered ≥5) ──
    // F1 NEAR-DIFFERS: C1.
    let f1 = c1
    // F2 CURIOSITY-MONO: C2.
    let f2 = c2
    // F3 DETERMINISM: C3.
    let f3 = c3
    // F4 BOUNDS: all split_rate ∈ [0, n_cells] band → ≥ 0 ; var_state ≥ 0.
    fn _nonneg(x: float) -> bool { return x >= 0.0 }
    let f4 = _nonneg(r_l_near["split_rate"]) && _nonneg(r_l_mid["split_rate"])
          && _nonneg(r_l_far["split_rate"])  && _nonneg(r_t_near["split_rate"])
          && _nonneg(r_t_mid["split_rate"])  && _nonneg(r_t_far["split_rate"])
          && _nonneg(r_l_near["var_state"])  && _nonneg(r_t_far["var_state"])
    // F5 FLOOR-RESPECTED: every condition stays ≥ floor cells (death floor
    //    never breached — H_025.2 / H_200 carry).
    let floor = r_l_near["floor"]
    fn _ge(a: int, b: int) -> bool { return a >= b }
    let f5 = _ge(r_l_near["n_cells_final"], floor) && _ge(r_l_mid["n_cells_final"], floor)
          && _ge(r_l_far["n_cells_final"], floor)  && _ge(r_t_near["n_cells_final"], floor)
          && _ge(r_t_mid["n_cells_final"], floor)  && _ge(r_t_far["n_cells_final"], floor)

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }

    // verdict_rule: SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = !C1.
    let verdict = if c1 && c2 {
        "SUPPORTED"
    } else {
        if c1 {
            "PARTIAL"
        } else {
            "FALSIFIED"
        }
    }

    println("")
    println("derived:")
    println("  split_rate near (loose) = " + to_string(sr_l_near)
            + "  far (loose) = " + to_string(sr_l_far)
            + "  |Δ| = " + to_string(d_sr_loose))
    println("  split_rate near (tight) = " + to_string(sr_t_near)
            + "  far (tight) = " + to_string(sr_t_far)
            + "  |Δ| = " + to_string(d_sr_tight))
    println("  C2 regime = " + c2_regime
            + "  var_state near=" + to_string(vs_near)
            + " mid=" + to_string(vs_mid)
            + " far=" + to_string(vs_far))
    println("  mono_inc=" + _bool_str(mono_inc)
            + " mono_dec=" + _bool_str(mono_dec))

    println("")
    println("C1 near-floor split_rate != far (|Δ|>=" + to_string(margin) + ") : " + _bool_str(c1))
    println("C2 curiosity (var_state) monotone w/ distance        : " + _bool_str(c2))
    println("C3 re-run byte-equal (determinism)                   : " + _bool_str(c3))
    println("")
    println("F1 NEAR-DIFFERS    (near split_rate != far)          " + v1)
    println("F2 CURIOSITY-MONO  (var_state monotone)              " + v2)
    println("F3 DETERMINISM     (re-run byte-equal)               " + v3)
    println("F4 BOUNDS          (split_rate, var_state >= 0)      " + v4)
    println("F5 FLOOR-RESPECTED (n_final >= floor everywhere)     " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/3 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_258\",\n"
    j = j + "  \"slug\": \"mortality-salience\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"mortality-salience — death-proximity existential effect (substrate analog · H_025 + H_200 sister)\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"n_steps\": " + to_string(_n_steps())
          + ", \"floor_min_cells\": 2"
          + ", \"near_cells\": " + to_string(_near_cells())
          + ", \"mid_cells\": " + to_string(_mid_cells())
          + ", \"far_cells\": " + to_string(_far_cells())
          + ", \"k_loose\": " + to_string(_k_loose())
          + ", \"k_tight\": " + to_string(_k_tight())
          + ", \"split_rate_margin\": " + to_string(_split_rate_margin()) + "},\n"
    j = j + "  \"sweep\": {\n"
    j = j + "    \"loose_near\": " + _cond_json(r_l_near) + ",\n"
    j = j + "    \"loose_mid\":  " + _cond_json(r_l_mid)  + ",\n"
    j = j + "    \"loose_far\":  " + _cond_json(r_l_far)  + ",\n"
    j = j + "    \"tight_near\": " + _cond_json(r_t_near) + ",\n"
    j = j + "    \"tight_mid\":  " + _cond_json(r_t_mid)  + ",\n"
    j = j + "    \"tight_far\":  " + _cond_json(r_t_far)  + "\n"
    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"split_rate_delta_loose\": " + to_string(d_sr_loose) + ",\n"
    j = j + "    \"split_rate_delta_tight\": " + to_string(d_sr_tight) + ",\n"
    j = j + "    \"c2_regime\": \"" + c2_regime + "\",\n"
    j = j + "    \"var_state_near\": " + to_string(vs_near) + ",\n"
    j = j + "    \"var_state_mid\":  " + to_string(vs_mid) + ",\n"
    j = j + "    \"var_state_far\":  " + to_string(vs_far) + ",\n"
    j = j + "    \"mono_inc\": " + _bool_str(mono_inc) + ",\n"
    j = j + "    \"mono_dec\": " + _bool_str(mono_dec) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_near_differs\":      " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_curiosity_monotone\":" + _bool_str(c2) + ",\n"
    j = j + "    \"C3_determinism\":       " + _bool_str(c3) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_NEAR_DIFFERS\":    { \"metric\": \"|split_rate_near - far| >= margin (any regime)\", \"value\": " + to_string(d_sr_tight) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_CURIOSITY_MONO\":  { \"metric\": \"var_state monotone near->mid->far\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_DETERMINISM\":     { \"metric\": \"re-run byte-equal\", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_BOUNDS\":          { \"metric\": \"split_rate, var_state >= 0\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_FLOOR_RESPECTED\": { \"metric\": \"n_final >= floor everywhere\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_025\": \"dasein-finite-consciousness\", \"H_200\": \"apoptosis-primitive\", \"H_214\": \"self-i-emergence\", \"H_220\": \"infant-mirror\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


fn _print_row(r) {
    println(r["regime"]
            + "   " + r["distance_name"]
            + "    " + to_string(r["n_init"])
            + "       " + to_string(r["total_splits"])
            + "       " + to_string(r["split_rate"])
            + "    " + to_string(r["var_state"])
            + "    " + to_string(r["n_cells_final"]))
}


fn _cond_json(r) -> string {
    return "{ \"distance\": \"" + r["distance_name"] + "\""
         + ", \"regime\": \"" + r["regime"] + "\""
         + ", \"k\": " + to_string(r["k"])
         + ", \"n_init\": " + to_string(r["n_init"])
         + ", \"n_steps\": " + to_string(r["n_steps"])
         + ", \"total_splits\": " + to_string(r["total_splits"])
         + ", \"split_rate\": " + to_string(r["split_rate"])
         + ", \"var_state\": " + to_string(r["var_state"])
         + ", \"mean_state\": " + to_string(r["mean_state"])
         + ", \"n_cells_final\": " + to_string(r["n_cells_final"])
         + ", \"floor\": " + to_string(r["floor"]) + " }"
}


_run_h258()
