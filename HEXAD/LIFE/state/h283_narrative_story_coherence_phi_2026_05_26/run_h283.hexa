// ════════════════════════════════════════════════════════════════════════════
//  run_h283.hexa — H_283 narrative-story-coherence-Φ
//                  coherent (causally-ordered) narrative substrate Φ
//                  > scrambled-order narrative substrate Φ
//                  (AXES R4 self/identity promote · H_213 temporal-binding sister)
//
//  CORE QUESTION
//    한 mitosis cell pool 을 evolve 하며 매 step 의 mean-hidden snapshot 을
//    하나의 '서사 사건(event)' 으로 본다. event 들을 시간순(causal arc) 으로
//    배열한 '응집(coherent) 서사' 와, 그 event 들을 deterministic 하게 뒤섞은
//    '해체(scrambled) 서사' 의 sequential-binding Φ 를 비교한다.
//    가설: 응집 서사 Φ > 해체 서사 Φ — 의식의 형식으로서 '이야기' 가
//    integrated information 을 더 많이 떠받친다 (IIT temporal-binding analog).
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model=8, initial_cells=8); seed via
//    __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) — deterministic.
//    evolve n_events=10 steps; 매 step mean-hidden snapshot = 1 event vector.
//
//  SEQUENTIAL-BINDING Φ (order-SENSITIVE, MIP-along-chain)
//    event 시퀀스 e_0..e_{T-1} 에서
//      whole_int = Σ_{0<=i<j<T} (1 - cos(e_i, e_j))           (전체 통합)
//      각 chain-cut c (0<c<T) 에서 A=e_0..e_{c-1}, B=e_c..e_{T-1}:
//        cross(c) = Σ_{i in A, j in B} (1 - cos(e_i, e_j))     (cross-cut 통합)
//      MIP = argmin_c cross(c)   (가장 약한 시간적 연결 = minimum-info-partition)
//      Φ_seq = cross(MIP) / min(|A|,|B|) * log(T+1)
//    coherent: event 자연 시간순.  scrambled: deterministic 역-interleave 순열.
//    Φ 는 *순서에 민감* (chain-cut 가 순서 따라 다른 A|B 를 만듦).
//
//  SWEEP (3 길이 × coherent vs scrambled)
//    T ∈ {6, 8, 10}  — 서사 길이 sweep (binding window scaling)
//
//  CONTROL (null — 순서가 Φ 에 무관하다는 귀무)
//    Δ_T = Φ_coherent(T) - Φ_scrambled(T)
//    coherent 가 모든 T 에서 우위면 순서 효과 robust.
//
//  CRITERIA (verdict_rule)
//    C1: T=8 coherent Φ > scrambled Φ + 0.02 margin (서사 응집 → Φ)
//    C2: coherent 가 3 길이 전부에서 scrambled 이상 (순서 효과 robust)
//    C3: Δ_T 가 길이↑ 에서 비-감소 추세 (T6<=T8<=T10 binding-window 강화)
//    C4: in-process recompute byte-equal (pure-fn 결정론); cross-process
//        result.json byte-equality 는 runner 가 확인 (RFC 033 single-stream).
//    SUPPORTED_FULL = C1∧C2∧C3∧C4 ; SUPPORTED = C1∧C2 ;
//    PARTIAL = C1 only ; FALSIFIED = !C1 (coherent Φ <= scrambled Φ at T=8)
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "HEXAD/LIFE/state/h283_narrative_story_coherence_phi_2026_05_26"
}
fn _d_model() -> int  { return 8 }
fn _pool_n() -> int   { return 8 }
fn _n_events() -> int { return 10 }
fn _seed() -> int     { return 42 }
fn _c1_margin() -> float { return 0.02 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _zero_vec(n: int) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(0.0)
        i = i + 1
    }
    return a
}

fn _vec_mean_scalar(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

// mean-hidden snapshot of the current pool = one 'narrative event' vector.
fn _pool_mean_hidden(cells, d: int) {
    let mut acc = _zero_vec(d)
    let n = len(cells)
    if n == 0 { return acc }
    let mut i = 0
    while i < n {
        let h = cells[i]["hidden"]
        let mut q = 0
        while q < d {
            if q < len(h) { acc[q] = acc[q] + h[q] }
            q = q + 1
        }
        i = i + 1
    }
    let mut q2 = 0
    while q2 < d {
        acc[q2] = acc[q2] / to_float(n)
        q2 = q2 + 1
    }
    return acc
}


// ── evolve pool, capture a mean-hidden snapshot at each step ──────────────────
// returns list of event vectors (length n_events), natural (causal) order.
fn _evolve_events(n_events: int) {
    let d = _d_model()
    let n = _pool_n()
    let mut pool = cell_pool_init(d, n)
    let mut x = _zero_vec(d)

    let mut events = []
    let mut step = 0
    while step < n_events {
        let res = mitosis_forward_tail(x, pool, step)
        let x_out = res[0]
        pool = res[1]
        // snapshot the pool's mean hidden = this step's narrative event.
        events.push(_pool_mean_hidden(pool["cells"], d))
        // shared scalar drive (k=0.5 mid-coupling, H_214/H_279 carry grain).
        let drv = 0.5 * _vec_mean_scalar(x_out)
        let mut x_next = _zero_vec(d)
        let mut q = 0
        while q < d {
            x_next[q] = drv
            q = q + 1
        }
        x = x_next
        step = step + 1
    }
    return events
}


// ── take first T events ──────────────────────────────────────────────────────
fn _take(events, t: int) {
    let mut out = []
    let mut i = 0
    while i < t {
        if i < len(events) { out.push(events[i]) }
        i = i + 1
    }
    return out
}


// ── deterministic scramble: reverse-interleave permutation ───────────────────
// out[2k] = in[k], out[2k+1] = in[T-1-k] — maximally disrupts temporal adjacency
// while being a deterministic bijection (no RNG).
fn _scramble(events) {
    let t = len(events)
    let mut out = []
    let mut k = 0
    let half = (t + 1) / 2
    while k < half {
        out.push(events[k])
        let mirror = t - 1 - k
        if mirror > k { out.push(events[mirror]) }
        k = k + 1
    }
    return out
}


// ── sequential-binding Φ (order-SENSITIVE, MIP-along-chain) ───────────────────
// cross(c) over chain-cut c uses ONLY the i<c / j>=c split → order matters.
fn _seq_phi(events) -> float {
    let t = len(events)
    if t < 2 { return 0.0 }

    // find MIP chain-cut minimizing cross-partition integration.
    let mut best_cross = 1.0e30
    let mut best_min   = 1
    let mut c = 1
    while c < t {
        // A = events[0..c-1], B = events[c..t-1].
        let mut cross = 0.0
        let mut i = 0
        while i < c {
            let mut j = c
            while j < t {
                let cs = _mit_cosine(events[i], events[j])
                cross = cross + (1.0 - cs)
                j = j + 1
            }
            i = i + 1
        }
        let size_a = c
        let size_b = t - c
        let sm = if size_a < size_b { size_a } else { size_b }
        if cross < best_cross {
            best_cross = cross
            best_min   = sm
        }
        c = c + 1
    }
    if best_min < 1 { best_min = 1 }
    let phi = (best_cross / to_float(best_min)) * _mit_log_safe(to_float(t) + 1.0)
    if !_mit_isfinite(phi) { return 0.0 }
    if phi < 0.0 { return 0.0 }
    return phi
}


// ── one length condition: returns dict ───────────────────────────────────────
fn _run_condition(events, t: int) {
    let coh = _take(events, t)
    let scr = _scramble(coh)
    let phi_coh = _seq_phi(coh)
    let phi_scr = _seq_phi(scr)
    let delta   = phi_coh - phi_scr
    return #{
        "t":        t,
        "phi_coh":  phi_coh,
        "phi_scr":  phi_scr,
        "delta":    delta
    }
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h283() {
    println("================================================================")
    println("H_283 narrative-story-coherence-Φ — coherent vs scrambled seq Φ")
    println("  d_model=" + to_string(_d_model())
            + " pool_N=" + to_string(_pool_n())
            + " n_events=" + to_string(_n_events())
            + " seed=" + to_string(_seed()))
    println("  event = step mean-hidden snapshot · Φ = MIP-along-chain (order-sens)")
    println("  T sweep: 6 / 8 / 10")
    println("================================================================")

    let events = _evolve_events(_n_events())

    let r_t6  = _run_condition(events, 6)
    let r_t8  = _run_condition(events, 8)
    let r_t10 = _run_condition(events, 10)

    // F4 determinism — pure-function recompute on the SAME event list.
    let _det_b = _run_condition(events, 8)
    let f4_eq = (r_t8["delta"] == _det_b["delta"])
                && (r_t8["phi_coh"] == _det_b["phi_coh"])
                && (r_t8["phi_scr"] == _det_b["phi_scr"])

    println("  T    phi_coherent   phi_scrambled   delta")
    println("  ---  ------------   -------------   -------")
    println("  6    " + to_string(r_t6["phi_coh"])
            + "   " + to_string(r_t6["phi_scr"])
            + "   " + to_string(r_t6["delta"]))
    println("  8    " + to_string(r_t8["phi_coh"])
            + "   " + to_string(r_t8["phi_scr"])
            + "   " + to_string(r_t8["delta"]))
    println("  10   " + to_string(r_t10["phi_coh"])
            + "   " + to_string(r_t10["phi_scr"])
            + "   " + to_string(r_t10["delta"]))

    // ── criteria ──
    // C1: T=8 coherent Φ > scrambled Φ + margin.
    let c1 = (r_t8["phi_coh"] - r_t8["phi_scr"]) >= _c1_margin()
    // C2: coherent >= scrambled at all 3 lengths (order effect robust).
    let c2 = (r_t6["delta"] >= 0.0) && (r_t8["delta"] >= 0.0) && (r_t10["delta"] >= 0.0)
    // C3: Δ non-decreasing as window grows (binding-window strengthening).
    let c3 = (r_t6["delta"] <= r_t8["delta"]) && (r_t8["delta"] <= r_t10["delta"])
    // C4: determinism.
    let c4 = f4_eq

    // F1..F5.
    // F1 COHERENCE-Φ: T=8 coherent > scrambled (no margin — strict signal).
    let f1 = r_t8["phi_coh"] > r_t8["phi_scr"]
    // F2 ROBUST: coherent >= scrambled at all lengths.
    let f2 = c2
    // F3 WINDOW: Δ_T10 >= Δ_T6 (window scaling).
    let f3 = r_t10["delta"] >= r_t6["delta"]
    // F4 DETERMINISM.
    let f4 = f4_eq
    // F5 BOUNDS: all phi finite + >= 0.
    fn _ok(x: float) -> bool { return (x >= 0.0) && (x < 1.0e30) }
    let f5 = _ok(r_t6["phi_coh"]) && _ok(r_t6["phi_scr"])
          && _ok(r_t8["phi_coh"]) && _ok(r_t8["phi_scr"])
          && _ok(r_t10["phi_coh"]) && _ok(r_t10["phi_scr"])

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }
    if c4 { n_c = n_c + 1 }

    let supported_full = c1 && c2 && c3 && c4
    let supported = c1 && c2
    let partial = c1
    let verdict = if supported_full {
        "SUPPORTED_FULL"
    } else {
        if supported {
            "SUPPORTED"
        } else {
            if partial {
                "PARTIAL"
            } else {
                if n_pass <= 1 { "FAIL" } else { "PARTIAL" }
            }
        }
    }
    let final_verdict = if !f1 { "FALSIFIED" } else { verdict }

    println("")
    println("derived:")
    println("  Δ_T6  = " + to_string(r_t6["delta"]))
    println("  Δ_T8  = " + to_string(r_t8["delta"]))
    println("  Δ_T10 = " + to_string(r_t10["delta"]))
    println("")
    println("C1 T=8 coherent - scrambled >= 0.02   : " + _bool_str(c1))
    println("C2 coherent >= scrambled all T        : " + _bool_str(c2))
    println("C3 Δ_T6 <= Δ_T8 <= Δ_T10 monotone     : " + _bool_str(c3))
    println("C4 re-run Δ byte-equal                : " + _bool_str(c4))
    println("")
    println("F1 COHERENCE-Φ  (coherent > scrambled)    " + v1)
    println("F2 ROBUST       (coh >= scr all T)        " + v2)
    println("F3 WINDOW       (Δ_T10 >= Δ_T6)           " + v3)
    println("F4 DETERMINISM  (re-run byte-equal)       " + v4)
    println("F5 BOUNDS       (all phi finite >= 0)     " + v5)
    println("================================================================")
    println("VERDICT: " + final_verdict
            + "  (" + to_string(n_c) + "/4 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ──────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_283\",\n"
    j = j + "  \"slug\": \"narrative-story-coherence-phi\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"narrative-story-coherence-Φ — coherent (causal-order) narrative substrate Φ > scrambled-order narrative substrate Φ (AXES R4 promote · H_213 temporal-binding sister)\",\n"
    j = j + "  \"date\": \"2026-05-26\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"pool_N\": " + to_string(_pool_n())
          + ", \"n_events\": " + to_string(_n_events())
          + ", \"c1_margin\": " + to_string(_c1_margin()) + "},\n"
    j = j + "  \"sweep\": {\n"

    j = j + "    \"t6\": { \"t\": 6, \"phi_coh\": " + to_string(r_t6["phi_coh"])
          + ", \"phi_scr\": " + to_string(r_t6["phi_scr"])
          + ", \"delta\": " + to_string(r_t6["delta"]) + " },\n"
    j = j + "    \"t8\": { \"t\": 8, \"phi_coh\": " + to_string(r_t8["phi_coh"])
          + ", \"phi_scr\": " + to_string(r_t8["phi_scr"])
          + ", \"delta\": " + to_string(r_t8["delta"]) + " },\n"
    j = j + "    \"t10\": { \"t\": 10, \"phi_coh\": " + to_string(r_t10["phi_coh"])
          + ", \"phi_scr\": " + to_string(r_t10["phi_scr"])
          + ", \"delta\": " + to_string(r_t10["delta"]) + " }\n"

    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"delta_t6\": " + to_string(r_t6["delta"]) + ",\n"
    j = j + "    \"delta_t8\": " + to_string(r_t8["delta"]) + ",\n"
    j = j + "    \"delta_t10\": " + to_string(r_t10["delta"]) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_coherence_phi\":  " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_robust\":         " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_window\":         " + _bool_str(c3) + ",\n"
    j = j + "    \"C4_determinism\":    " + _bool_str(c4) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_COHERENCE_PHI\": { \"metric\": \"T=8 coherent > scrambled\", \"value\": " + to_string(r_t8["delta"]) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_ROBUST\":        { \"metric\": \"coherent >= scrambled all T\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_WINDOW\":        { \"metric\": \"Δ_T10 >= Δ_T6\", \"value\": " + to_string(r_t10["delta"] - r_t6["delta"]) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_DETERMINISM\":   { \"metric\": \"re-run Δ byte-equal\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_BOUNDS\":        { \"metric\": \"all phi finite >= 0\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + final_verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_213\": \"temporal-binding\", \"H_278\": \"MIP-Phi\", \"H_205\": \"self-ref-closure\", \"axes\": \"R4 self/identity\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h283()
