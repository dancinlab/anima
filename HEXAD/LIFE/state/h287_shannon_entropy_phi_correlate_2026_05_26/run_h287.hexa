// HEXAD/LIFE/state/h287_shannon_entropy_phi_correlate_2026_05_26/run_h287.hexa
//
//   H_287 — Does faithful IIT 4.0 big-Φ REDUCE to Shannon entropy?
//   (AXES.md R5 promote-candidate rank-2 `shannon-entropy-Φ-correlate`)
//
//   QUESTION
//     IIT's central claim is that integrated information Φ is NOT the same thing
//     as Shannon information (entropy). A pile of N independent random bits has
//     MAXIMAL entropy yet ZERO integration. This smoke tests that claim on the
//     LIFE lane's own substrate family (elementary CA rings) under the FAITHFUL
//     causal IIT 4.0 engine — the seed-hypothesis is the REDUCTIVE one (they
//     co-vary), so a low correlation is a CLOSED-NEGATIVE confirming IIT.
//
//   SEED-HYPOTHESIS H1 (reductive — the thing being TESTED, may be falsified)
//     Across a panel of ECA substrates, faithful state-averaged big-Φ co-varies
//     with Shannon output-entropy: Pearson r(H_out, Φ_mean) >= 0.5.
//
//   METHOD (reuse HEXAD/IIT4/lib — g61 / reuse-existing-libs · NO reinvention)
//     • eca_tpm(rule,n)    — ECA→state-by-node TPM        (iit4_eca.hexa)
//     • big_phi(tpm,n,st)  — faithful big-Φ, returns      (iit4_bigphi via stdlib)
//                            [big_phi, total, sum_phi_d, sum_phi_r, nd]
//     • iit4_pow2 / log    — 2^k (iit4_tpm) · natural-log builtin (→ log2 = log/log2)
//     PER-RULE METRICS (n=4 periodic ring, all 2^n=16 states):
//       H_out   = Shannon entropy (bits) of the OUTPUT-STATE distribution under a
//                 UNIFORM input ensemble: o(s)=Σ_i next_bit_i(s)·2^i, then
//                 H = -Σ_o p(o) log2 p(o).  Bijection ⇒ H=4 (info-preserving);
//                 constant map ⇒ H=0 (info-destroying).  Range [0, n].
//       Φ_mean  = mean over all 2^n states of big_phi(tpm,n,st)[0]  (integration).
//     CORRELATE: Pearson r over the 10-rule panel.
//
//   RULE PANEL (spans the entropy × Φ plane)
//     0,255   constants            (H=0, Φ=0)          — info-destroying, null
//     204     identity             (H=4, Φ=0)  ◀ KEY   — MAX info, ZERO integration
//     51      complement (NOT)     (H=4, Φ=0)          — MAX info, reducible
//     150,105 XOR / XNOR feedback                       — integrating (consciousness)
//     90,60   linear XOR pairs                          — partial feedback
//     110,30  universal / chaotic                       — life-themed dynamics
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26, BEFORE measuring r / Φ_mean)
//     F287.1 DISSOCIATION-WITNESS (decisive) — a MAX-entropy ZERO-integration
//            substrate exists: identity rule 204 has H_out >= 3.99 bits AND
//            Φ_mean < 1e-9; AND at the SAME near-max entropy an integrating rule
//            (best of 150/105/90/60) has Φ_mean > 0.5. ⇒ Φ is NOT a monotone
//            function of entropy.
//     F287.2 r-VERDICT — measured Pearson r(H_out, Φ_mean) over the 10 rules.
//            H1 SUPPORTED iff r >= 0.5 ; FALSIFIED iff r < 0.5 (Φ ⊥ entropy,
//            IIT distinction holds). r reported verbatim — measurement decides.
//     F287.3 ANCHORS — constants 0/255: H_out=0 AND Φ_mean=0 ; identity 204 &
//            complement 51: H_out=4.0 exactly (entropy-preserving bijections).
//     F287.4 BOUND — 0 <= H_out <= 4 and Φ_mean >= 0 for every rule.
//     F287.5 DETERMINISM — rule 204 (H_out, Φ_mean) re-run bit-identical.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope: n=4 small ring · output-image entropy is ONE Shannon measure
//     (not the only one — transfer entropy / steady-state would differ) ·
//     Φ_mean averages a state-dependent quantity (FAITHFUL_REMEASURE §4).
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-life-fg/HEXAD/IIT4/lib/iit4_eca.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// log2(x) via natural-log builtin (same idiom as iit4_distinction.hexa).
fn log2(x: float) -> float { return log(x) / log(2.0) }

// Newton sqrt (avoid any libm-sqrt drift — self-contained, deterministic).
fn nsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// Shannon entropy (bits) of the output-state distribution under uniform input.
fn image_entropy(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut counts = []
    let mut k = 0
    while k < full { counts = counts.push(0); k = k + 1 }
    let mut s = 0
    while s < full {
        let mut o = 0
        let mut i = 0
        while i < n {
            if tpm[s * n + i] > 0.5 { o = o + iit4_pow2(i) }   // next bit i → 2^i
            i = i + 1
        }
        counts[o] = counts[o] + 1
        s = s + 1
    }
    let mut h = 0.0
    let ftot = to_float(full)
    let mut j = 0
    while j < full {
        if counts[j] > 0 {
            let p = to_float(counts[j]) / ftot
            h = h - p * log2(p)
        }
        j = j + 1
    }
    return h
}

// state-averaged big-Φ over all 2^n states.
fn phi_mean(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut acc = 0.0
    let mut st = 0
    while st < full {
        let bp = big_phi(tpm, n, st)
        acc = acc + bp[0]
        st = st + 1
    }
    return acc / to_float(full)
}

// Pearson correlation over the first m elements of xs, ys.
fn pearson(xs: array, ys: array, m: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < m { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(m)
    let my = sy / to_float(m)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    i = 0
    while i < m {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        i = i + 1
    }
    if (vx < 0.000000000001) || (vy < 0.000000000001) { return 0.0 }
    return cov / nsqrt(vx * vy)
}

fn main() {
    let n = 4
    println("================================================================")
    println("  H_287 — Does faithful IIT4 big-Phi REDUCE to Shannon entropy?")
    println("  (n=" + str(n) + " ring · H_out=output-image entropy bits · Phi_mean=state-avg big-Phi)")
    println("================================================================")

    // rule panel
    let rules = [0, 255, 204, 51, 150, 105, 90, 60, 110, 30]
    let m = 10

    let mut hs = []
    let mut ps = []
    let mut idx = 0
    while idx < m {
        let r = rules[idx]
        let h = image_entropy(r, n)
        let p = phi_mean(r, n)
        hs = hs.push(h)
        ps = ps.push(p)
        println("  rule " + str(r) + " : H_out=" + str(h) + " bits   Phi_mean=" + str(p))
        idx = idx + 1
    }

    // ── F287.2 r-VERDICT ────────────────────────────────────────────────
    let r = pearson(hs, ps, m)
    println("  --")
    println("  F287.2: Pearson r(H_out, Phi_mean) over " + str(m) + " rules = " + str(r))
    let h1_supported = r >= 0.5
    if h1_supported {
        println("          => H1 SUPPORTED (r >= 0.5): Phi co-varies with entropy")
    } else {
        println("          => H1 FALSIFIED (r < 0.5): Phi does NOT reduce to Shannon entropy")
    }

    // ── F287.1 DISSOCIATION-WITNESS ─────────────────────────────────────
    // identity 204 = index 2 ; integrating candidates = 150,105,90,60 (idx 4..7).
    let h_204 = hs[2]
    let p_204 = ps[2]
    let mut best_int_phi = ps[4]
    let mut best_int_idx = 4
    let mut t = 5
    while t < 8 {
        if ps[t] > best_int_phi { best_int_phi = ps[t]; best_int_idx = t }
        t = t + 1
    }
    println("  F287.1: identity rule 204  H_out=" + str(h_204) + " Phi_mean=" + str(p_204))
    println("          best integrating rule=" + str(rules[best_int_idx]) + " H_out=" + str(hs[best_int_idx]) + " Phi_mean=" + str(best_int_phi))
    check("F287.1a WITNESS: identity 204 H_out >= 3.99 (near-max entropy)", h_204 >= 3.99)
    check("F287.1b WITNESS: identity 204 Phi_mean < 1e-9 (zero integration)", p_204 < 0.000000001)
    check("F287.1c WITNESS: an integrating rule has Phi_mean > 0.5 at high entropy", best_int_phi > 0.5)

    // ── F287.3 ANCHORS ──────────────────────────────────────────────────
    check("F287.3a ANCHOR: rule 0 (constant) H_out = 0", approx(hs[0], 0.0))
    check("F287.3b ANCHOR: rule 0 (constant) Phi_mean = 0", approx(ps[0], 0.0))
    check("F287.3c ANCHOR: rule 255 (constant) H_out = 0", approx(hs[1], 0.0))
    check("F287.3d ANCHOR: rule 255 (constant) Phi_mean = 0", approx(ps[1], 0.0))
    check("F287.3e ANCHOR: rule 204 (identity) H_out = 4.0 (bijection)", approx(h_204, 4.0))
    check("F287.3f ANCHOR: rule 51 (complement) H_out = 4.0 (bijection)", approx(hs[3], 4.0))

    // ── F287.4 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < m {
        if !((hs[b] >= 0.0 - 0.000001) && (hs[b] <= 4.0 + 0.000001)) { bound_ok = false }
        if !(ps[b] >= 0.0 - 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F287.4 BOUND: 0 <= H_out <= 4 and Phi_mean >= 0 for all rules", bound_ok)

    // ── F287.5 DETERMINISM ──────────────────────────────────────────────
    let h_204b = image_entropy(204, n)
    let p_204b = phi_mean(204, n)
    check("F287.5 DETERMINISM: rule 204 (H_out, Phi_mean) re-run identical", approx(h_204, h_204b) && approx(p_204, p_204b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if h1_supported {
        println("  VERDICT: H1 SUPPORTED — Phi co-varies with Shannon entropy (r>=0.5)")
    } else {
        println("  VERDICT: H1 FALSIFIED (CLOSED-NEGATIVE) — faithful big-Phi does NOT")
        println("           reduce to Shannon entropy. The identity substrate (max info,")
        println("           zero integration) is the decisive witness: information is")
        println("           necessary but NOT sufficient for integration. IIT distinction holds.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_287 had FALSIFIER FAILURES (distinct from H1 verdict)") }
}
