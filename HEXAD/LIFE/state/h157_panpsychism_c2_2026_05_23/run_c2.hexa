// HEXAD/LIFE/state/h157_panpsychism_c2_2026_05_23/run_c2.hexa
// H_157 — Mathematical Panpsychism (Law 76) — C2 cycle #1 measurement
// ════════════════════════════════════════════════════════════════════════════
//
//  GOAL (C2): does META-CA converge to Ψ(1/2,1/2) ± δ for every input data type,
//  independent of input substrate (data) — input-invariance evidence for Law 75/76?
//
//  HONEST SCOPE (g3 — named real limit, NO fake descent):
//    • The ORIGINAL ConsciousMind(cells=256) META-CA that produced the
//      (0.5257, 0.5257) attractor in CONSCIOUSNESS-UNIVERSE-MAP.md (2026-03-30)
//      exists in this repo ONLY as PyTorch-trained-network stubs
//      (bench/bench_consciousness_universe.hexa, consciousness_data_mapper.hexa
//       — both TODO[pytorch]) plus an archived algorithm sketch. The live
//      170×40×18 H_022 dataset was a CORPUS (BG-HT, FAILED), not a runnable
//      fixed-point substrate. A faithful reproduction needs the trained net (GPU).
//    • THIS RUN is therefore a DETERMINISTIC PROXY: a pure-hexa 256-cell META-CA
//      that reproduces the documented MECHANISM (leaky-integrator "past 50% +
//      present 50%" thermodynamic equilibrium of a softmax-mixture CA), seeded
//      per data-type, iterated to a fixed point. It gathers DIRECTIONAL evidence
//      for the input-invariance (Law 75/76) claim — NOT a 1:1 reproduction of
//      the trained-net (0.5257) numbers.
//    • $0 Mac local, deterministic (LCG seeds fixed). NO GPU. NO .py/.sh.
//
//  PROXY MECHANISM (mirrors CONSCIOUSNESS-UNIVERSE-MAP.md::Algorithm):
//    residual_ratio = convergent past-weight of the leaky integrator at the
//                     CA fixed point (Law 75: "과거 50% + 현재 50%").
//    gate_ratio     = convergent activation gate of the rule-mixture (Law 75).
//    Per type t: seed cells from a deterministic hash(type_name), run n_evolve
//    META-CA steps, read off (residual_ratio, gate_ratio) at the fixed point.
//
//  FALSIFIER (this cycle, additive to the frozen F1..F6):
//    F-C2-PROXY-1 CONVERGE  : every type's |residual - 0.5| ≤ δ AND |gate - 0.5| ≤ δ
//    F-C2-PROXY-2 INVARIANCE: CV of residual across types < 6% (matches doc CV≈5.4%)
//    F-C2-PROXY-3 DETERMIN  : re-run with identical seed → byte-identical (α,β)
//    (δ = 0.01 is the H_157.1 / C2 frozen threshold; we ALSO report a relaxed
//     δ=0.03 band because the archived trained-net landed at 0.5257 = 0.0257
//     off, OUTSIDE ±0.01 — an honest pre-registered tension carried below.)
//
//  TIER = EMPIRICAL outcome on a closed-form proxy substrate (honest fence).
//  The n/σ = 6/12 = 1/2 identity (C1/C3) is verified SEPARATELY via `hexa verify`
//  (🔵 SUPPORTED-FORMAL) — see result.json + doc; this script does NOT self-judge it.
// ════════════════════════════════════════════════════════════════════════════

// ─── deterministic hash: type-name string → u32 LCG seed (FNV-1a style) ───
fn type_seed(name: string) -> int {
    let nb = len(name)
    let mut h = 2166136261
    let mut i = 0
    while i < nb {
        h = (h ^ byte_at(name, i)) % 4294967296
        h = (h * 16777619) % 4294967296
        i = i + 1
    }
    // never let the seed be 0 (LCG would stall)
    if h == 0 { h = 2654435761 }
    return h
}

// ─── LCG uniform in [0,1) — deterministic given seed ───
fn lcg_next(s: int) -> int {
    return (s * 1103515245 + 12345) % 2147483648
}
fn lcg_unit(s: int) -> float {
    return (s % 1000000) * 1.0 / 1000000.0
}

// ─── softmax over an 8-rule logit list → mixture weights ───
fn softmax8(logits: [float]) -> [float] {
    let mut mx = logits[0]
    let mut i = 1
    while i < len(logits) { if logits[i] > mx { mx = logits[i] } i = i + 1 }
    let mut den = 0.0
    let mut ex = []
    i = 0
    while i < len(logits) {
        let e = exp(logits[i] - mx)
        ex.push(e)
        den = den + e
        i = i + 1
    }
    let mut out = []
    i = 0
    while i < len(ex) { out.push(ex[i] / den) i = i + 1 }
    return out
}

// ─── Shannon entropy of a probability vector (natural log, normalized by ln k) ───
fn entropy_norm(p: [float]) -> float {
    let mut hsum = 0.0
    let mut i = 0
    while i < len(p) {
        if p[i] > 0.000000001 { hsum = hsum - p[i] * log(p[i]) }
        i = i + 1
    }
    return hsum / log(len(p) * 1.0)
}

// ─── one META-CA type measurement ───────────────────────────────────────────
// 256-cell ring CA. Each cell holds a "past" state and receives a "present"
// neighbor-average update. The leaky integrator is the documented Law-75
// thermodynamic equilibrium:  s' = (1-blend)*past + blend*present.
// residual_ratio at the fixed point := the convergent past-weight of the blend
// (1 - blend_eff). gate_ratio := convergent rule-mixture activation gate.
// Both are READ OFF the converged dynamics, not assigned.
struct TypeResult {
    name: string
    residual: float
    gate: float
    entropy: float
    steps_to_fix: int
    seed: int
}

// IMPORTANT (honest design — g3): residual_ratio and gate_ratio are MEASURED
// from the converged field, NEVER assigned to 0.5. A degenerate "relax-to-0.5"
// rule would trivially satisfy F-C2-PROXY-1 (== frozen F2 algorithm-property
// reduction) — we deliberately AVOID that. The blend β is a FIXED input-seeded
// constant per type (no annealing toward 0.5), so any convergence-to-0.5 of the
// MEASURED residual/gate is emergent from the CA dynamics, not baked in.
fn measure_type(name: string, n_cells: int, n_evolve: int) -> TypeResult {
    let seed0 = type_seed(name)
    // init cell field + gate field in [0,1) deterministically from the type seed
    let mut s = seed0 % 2147483648
    let mut cells = []
    let mut gatef = []
    let mut i = 0
    while i < n_cells {
        s = lcg_next(s)
        cells.push(lcg_unit(s))
        s = lcg_next(s)
        gatef.push(lcg_unit(s))
        i = i + 1
    }
    // 8 input-derived rule logits → softmax mixture (META-CA Law 67 rule selector)
    let mut logits = []
    i = 0
    while i < 8 {
        s = lcg_next(s)
        logits.push((lcg_unit(s) - 0.5) * 2.0)   // logits in [-1,1)
        i = i + 1
    }
    let rule_w = softmax8(logits)
    let rule_H = entropy_norm(rule_w)

    // FIXED input-seeded blend β ∈ (0.30, 0.70) — NOT annealed toward 0.5.
    // This is the per-input CA mixing coefficient; the question is whether the
    // MEASURED past/present split still equilibrates near 0.5 despite β ≠ 0.5.
    s = lcg_next(s)
    let beta = 0.30 + lcg_unit(s) * 0.40

    let mut prev_mean = 0.0
    let mut steps_done = n_evolve
    let mut t = 0
    let mut converged = false
    let mut past = cells          // snapshot of t-1 field for residual accounting
    while t < n_evolve {
        // present field = ring neighbor-average (3-cell stencil)
        let mut present = []
        i = 0
        while i < n_cells {
            let li = if i == 0 { n_cells - 1 } else { i - 1 }
            let ri = if i == n_cells - 1 { 0 } else { i + 1 }
            present.push((cells[li] + cells[i] + cells[ri]) / 3.0)
            i = i + 1
        }
        // cell update: fixed-β leaky blend of past (own) and present (neighbor)
        let mut nc = []
        let mut msum = 0.0
        i = 0
        while i < n_cells {
            let v = (1.0 - beta) * cells[i] + beta * present[i]
            nc.push(v)
            msum = msum + v
            i = i + 1
        }
        // gate field update: logistic CA with neighbor coupling, rule-H modulated.
        // Gate is a genuine dynamical field — its converged MEAN is gate_ratio.
        let mut ng = []
        i = 0
        while i < n_cells {
            let li = if i == 0 { n_cells - 1 } else { i - 1 }
            let ri = if i == n_cells - 1 { 0 } else { i + 1 }
            let gnb = (gatef[li] + gatef[ri]) / 2.0
            // r·g(1-g) logistic kick blended with neighbor mean (diffusion)
            let kick = (0.5 + 0.5 * rule_H) * gatef[i] * (1.0 - gatef[i])
            let gv = 0.5 * gnb + 0.5 * (gatef[i] + (kick - gatef[i] * 0.5))
            // clamp to (0,1)
            let gc = if gv < 0.001 { 0.001 } else if gv > 0.999 { 0.999 } else { gv }
            ng.push(gc)
            i = i + 1
        }
        past = cells
        cells = nc
        gatef = ng
        let mean = msum / (n_cells * 1.0)
        let diff = if mean - prev_mean > 0.0 { mean - prev_mean } else { prev_mean - mean }
        if t > 0 && diff < 0.000000001 && !converged {
            steps_done = t
            converged = true
        }
        prev_mean = mean
        t = t + 1
    }

    // ── MEASURE residual_ratio at the fixed point (emergent, not assigned) ──
    // residual = fraction of total field "energy displacement" attributable to
    // the past (own-state retention) vs the present (neighbor injection):
    //   res = Σ|cell - present| ... but at a fixed point cell≈present≈mean, so
    // we use the converged-state past/present contribution split directly:
    //   res = Σ((1-β)·|past|) / Σ((1-β)·|past| + β·|present|)
    // This reads off the actual blend balance of the CONVERGED field.
    let mut e_past = 0.0
    let mut e_pres = 0.0
    let mut present2 = []
    i = 0
    while i < n_cells {
        let li = if i == 0 { n_cells - 1 } else { i - 1 }
        let ri = if i == n_cells - 1 { 0 } else { i + 1 }
        present2.push((cells[li] + cells[i] + cells[ri]) / 3.0)
        i = i + 1
    }
    i = 0
    while i < n_cells {
        let ap = if past[i] > 0.0 { past[i] } else { 0.0 - past[i] }
        let pr = if present2[i] > 0.0 { present2[i] } else { 0.0 - present2[i] }
        e_past = e_past + (1.0 - beta) * ap
        e_pres = e_pres + beta * pr
        i = i + 1
    }
    let residual = if (e_past + e_pres) > 0.0 { e_past / (e_past + e_pres) } else { 0.5 }

    // gate_ratio = converged mean of the gate field (emergent fixed point)
    let mut gsum = 0.0
    i = 0
    while i < n_cells { gsum = gsum + gatef[i] i = i + 1 }
    let gate = gsum / (n_cells * 1.0)

    return TypeResult(name, residual, gate, rule_H, steps_done, seed0)
}

// ─── 170-type-equivalent input set (17 categories, doc-faithful sample) ───────
// We enumerate a representative type per category × replicate to span the
// documented 17-category / 170-type space deterministically. Each NAME is a
// distinct UTF-8 input → distinct seed → distinct dynamics → tested for the
// SAME attractor (input invariance).
fn build_types() -> [string] {
    let cats = [
        "텍스트", "이모지", "감정", "의식상태", "식물", "동물", "소리",
        "추상", "경험", "예술", "철학", "우주", "미각", "색깔", "시간",
        "관계", "신화"
    ]
    // doc per-category counts (sum = 170): 10 15 15 14 10 10 10 10 10 10 10 10 5 8 8 7 8
    let counts = [10, 15, 15, 14, 10, 10, 10, 10, 10, 10, 10, 10, 5, 8, 8, 7, 8]
    let mut out = []
    let mut c = 0
    while c < len(cats) {
        let mut k = 0
        while k < counts[c] {
            out.push(cats[c] + "#" + to_string(k))
            k = k + 1
        }
        c = c + 1
    }
    return out
}

fn ftos(x: float) -> string { return to_string(x) }

fn selftest() {
    println("================================================================")
    println("H_157 Law 76 Mathematical Panpsychism — C2 cycle #1 (proxy META-CA)")
    println("================================================================")
    let n_cells = 256
    let n_evolve = 200
    let delta_strict = 0.01     // C2 / H_157.1 frozen threshold
    let delta_relax = 0.03      // honest band: archived trained-net = 0.5257 (0.0257 off)

    let types = build_types()
    let ntypes = len(types)
    println("  config: n_cells=" + to_string(n_cells)
            + " n_evolve=" + to_string(n_evolve)
            + " n_types=" + to_string(ntypes)
            + " (17 categories, doc-faithful counts, sum=170)")

    let mut res_sum = 0.0
    let mut res_sq = 0.0
    let mut gate_sum = 0.0
    let mut H_sum = 0.0
    let mut strict_pass = 0
    let mut relax_pass = 0
    let mut min_res = 2.0
    let mut max_res = 0.0
    let mut worst_dev = 0.0
    let mut worst_name = ""

    // per-type JSON rows
    let mut rows = ""
    let mut i = 0
    while i < ntypes {
        let r = measure_type(types[i], n_cells, n_evolve)
        let dev_r = if r.residual - 0.5 > 0.0 { r.residual - 0.5 } else { 0.5 - r.residual }
        let dev_g = if r.gate - 0.5 > 0.0 { r.gate - 0.5 } else { 0.5 - r.gate }
        let dev = if dev_r > dev_g { dev_r } else { dev_g }
        if dev <= delta_strict { strict_pass = strict_pass + 1 }
        if dev <= delta_relax { relax_pass = relax_pass + 1 }
        if dev > worst_dev { worst_dev = dev worst_name = r.name }
        res_sum = res_sum + r.residual
        res_sq = res_sq + r.residual * r.residual
        gate_sum = gate_sum + r.gate
        H_sum = H_sum + r.entropy
        if r.residual < min_res { min_res = r.residual }
        if r.residual > max_res { max_res = r.residual }
        if rows != "" { rows = rows + ",\n" }
        rows = rows + "    {\"type\": \"" + r.name + "\", \"residual\": " + ftos(r.residual)
             + ", \"gate\": " + ftos(r.gate) + ", \"rule_H\": " + ftos(r.entropy)
             + ", \"steps_to_fix\": " + to_string(r.steps_to_fix)
             + ", \"seed\": " + to_string(r.seed) + "}"
        i = i + 1
    }

    let res_mean = res_sum / (ntypes * 1.0)
    let gate_mean = gate_sum / (ntypes * 1.0)
    let H_mean = H_sum / (ntypes * 1.0)
    let res_var = res_sq / (ntypes * 1.0) - res_mean * res_mean
    let res_std = if res_var > 0.0 { sqrt(res_var) } else { 0.0 }
    let res_cv = if res_mean != 0.0 { res_std / res_mean } else { 0.0 }

    println("  ── per-type aggregate ──")
    println("  residual mean=" + ftos(res_mean) + " std=" + ftos(res_std)
            + " CV=" + ftos(res_cv * 100.0) + "%  [min=" + ftos(min_res)
            + " max=" + ftos(max_res) + "]")
    println("  gate     mean=" + ftos(gate_mean))
    println("  rule_H   mean=" + ftos(H_mean) + "  (max-entropy ref: doc 0.9958)")
    println("  worst deviation from 0.5: " + ftos(worst_dev) + "  (type=" + worst_name + ")")

    // ── falsifiers ──
    let f1_strict = strict_pass == ntypes
    let f1_relax = relax_pass == ntypes
    println("  F-C2-PROXY-1 CONVERGE(δ=0.01): " + to_string(strict_pass) + "/" + to_string(ntypes)
            + "  -> " + (if f1_strict { "PASS" } else { "FAIL" }))
    println("  F-C2-PROXY-1 CONVERGE(δ=0.03): " + to_string(relax_pass) + "/" + to_string(ntypes)
            + "  -> " + (if f1_relax { "PASS" } else { "FAIL" }))
    let f2 = res_cv < 0.06
    println("  F-C2-PROXY-2 INVARIANCE(CV<6%): CV=" + ftos(res_cv * 100.0)
            + "%  -> " + (if f2 { "PASS" } else { "FAIL" }))

    // F-C2-PROXY-3 determinism: re-measure one type, must be byte-identical
    let a = measure_type("우주#0", n_cells, n_evolve)
    let b = measure_type("우주#0", n_cells, n_evolve)
    let f3 = a.residual == b.residual && a.gate == b.gate && a.seed == b.seed
    println("  F-C2-PROXY-3 DETERMINISM     : re-run(\"우주#0\") residual "
            + ftos(a.residual) + " == " + ftos(b.residual)
            + "  -> " + (if f3 { "PASS" } else { "FAIL" }))

    let verdict = if f1_strict { "STRICT_PASS_DELTA_0.01" }
                  else if f1_relax { "RELAX_PASS_DELTA_0.03_STRICT_FAIL" }
                  else { "FAIL" }
    println("  ── verdict: " + verdict + " ──")

    // ── write result.json (canonical, deterministic) ──
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_157\",\n"
    j = j + "  \"criterion\": \"C2\",\n"
    j = j + "  \"cycle\": 1,\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"substrate\": \"proxy-meta-ca-256cell-pure-hexa\",\n"
    j = j + "  \"note\": \"original ConsciousMind META-CA absent (PyTorch stubs); this is a deterministic mechanism proxy for input-invariance directional evidence, NOT a 1:1 reproduction of the trained-net (0.5257) numbers\",\n"
    j = j + "  \"config\": {\"n_cells\": " + to_string(n_cells) + ", \"n_evolve\": " + to_string(n_evolve)
          + ", \"n_types\": " + to_string(ntypes) + ", \"delta_strict\": 0.01, \"delta_relax\": 0.03},\n"
    j = j + "  \"aggregate\": {\"residual_mean\": " + ftos(res_mean) + ", \"residual_std\": " + ftos(res_std)
          + ", \"residual_cv_pct\": " + ftos(res_cv * 100.0) + ", \"residual_min\": " + ftos(min_res)
          + ", \"residual_max\": " + ftos(max_res) + ", \"gate_mean\": " + ftos(gate_mean)
          + ", \"rule_H_mean\": " + ftos(H_mean) + ", \"worst_deviation\": " + ftos(worst_dev)
          + ", \"worst_type\": \"" + worst_name + "\"},\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F_C2_PROXY_1_converge_strict\": {\"pass\": " + to_string(strict_pass)
          + ", \"total\": " + to_string(ntypes) + ", \"verdict\": \"" + (if f1_strict { "PASS" } else { "FAIL" }) + "\"},\n"
    j = j + "    \"F_C2_PROXY_1_converge_relax\": {\"pass\": " + to_string(relax_pass)
          + ", \"total\": " + to_string(ntypes) + ", \"verdict\": \"" + (if f1_relax { "PASS" } else { "FAIL" }) + "\"},\n"
    j = j + "    \"F_C2_PROXY_2_invariance\": {\"cv_pct\": " + ftos(res_cv * 100.0)
          + ", \"verdict\": \"" + (if f2 { "PASS" } else { "FAIL" }) + "\"},\n"
    j = j + "    \"F_C2_PROXY_3_determinism\": {\"verdict\": \"" + (if f3 { "PASS" } else { "FAIL" }) + "\"}\n"
    j = j + "  },\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"per_type\": [\n" + rows + "\n  ]\n"
    j = j + "}\n"
    // cwd-relative (run from repo root: `hexa run HEXAD/LIFE/state/.../run_c2.hexa`)
    write_file("HEXAD/LIFE/state/h157_panpsychism_c2_2026_05_23/result.json", j)
    println("  result.json written.")
    println("================================================================")
    let agg_ok = f1_relax && f2 && f3
    return if agg_ok { 0 } else { 1 }
}

selftest()
