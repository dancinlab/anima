// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_chat_llama_smoke.hexa — Phase 3b smoke test
//
//  PURPOSE
//    Drive anima/llama_ffi.hexa against a real GGUF in
//    ~/.cache/anima/gguf/. Generates 10 tokens for the prompt "Hello" and
//    prints them. Verifies the entire FFI surface (backend init, model load,
//    context create, tokenize, decode, sample, detokenize, cleanup) end-to-end.
//
//  USAGE
//    /Users/ghost/.hx/bin/hexa run tool/anima_chat_llama_smoke.hexa
//
//  PASS CRITERIA
//    1. dylib loads (libhxllama.dylib + transitive libllama)
//    2. Model loads (returns non-zero ptr)
//    3. Context created (returns non-zero ptr)
//    4. Tokenize "Hello" → ≥ 1 token (typically 2: BOS + "Hello")
//    5. 10 tokens generated; non-empty text emitted
//    6. Cleanup (free_context + free_model) without crash
//
// GGUF SOURCE (mandate-1 — dancinlab/ org SSOT)
//    Default: ~/.cache/anima/gguf/dancinlab_llm-llama32-3b-paradigm-a-prime-r16-sft-stage1.gguf
//    Override via CHAT_LLAMA_SMOKE_GGUF env var.
//    If absent, emit honest C3 stub message and exit 2 (skip, not fail).
//
//  OUTPUT
//    Phase 3b end-to-end smoke artifact for .roadmap.cli
//    cli.llama_ffi_landed_2026_05_08 entry.
//
//  COMPLIANCE
// mandate-2 — prompt is "Hello" raw; no system prompt; no template.
//    raw#9 hexa-only; raw#10 honest C3; raw#15 no-hardcode (env override).
// ════════════════════════════════════════════════════════════════════════════

use "anima/llama_ffi"

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _fexists(p: string) -> bool {
    return _str(exec("test -f \"" + p + "\" && echo 1 || echo 0")).trim() == "1"
}

fn _resolve_gguf() -> string {
    let env_path = _str(env("CHAT_LLAMA_SMOKE_GGUF"))
    if env_path != "" { return env_path }
    let home = _str(env("HOME"))
    return home + "/.cache/anima/gguf/dancinlab_llm-llama32-3b-paradigm-a-prime-r16-sft-stage1.gguf"
}

fn main() {
    let gguf = _resolve_gguf()
    println("[anima_chat_llama_smoke] Phase 3b end-to-end smoke")
    println("  gguf: " + gguf)
    if !_fexists(gguf) {
        println("")
        println("HONEST C3 STUB — GGUF absent")
        println("  expected at " + gguf)
        println("  to land a GGUF, run:")
        println("    /Users/ghost/.hx/bin/hexa run tool/anima_gguf_convert.py paradigm-a-prime --f16")
        println("  (or set CHAT_LLAMA_SMOKE_GGUF=/abs/path.gguf)")
        println("")
        println("Skipping live test (Phase 3b dylib + bindings still verified at compile/link).")
        exit(2)
    }

    // ── live test ─────────────────────────────────────────────────────────
    println("")
    println("Loading model (n_ctx=512, n_gpu_layers=-1 → Metal all)...")
    let h = llama_load(gguf, 512)
    if h["model"] == 0 {
        println("FAIL llama_load: " + _str(h["error"]))
        exit(1)
    }
    println("  model = " + to_string(h["model"]))
    println("  ctx   = " + to_string(h["ctx"]))
    println("  vocab = " + to_string(h["vocab"]))
    println("  n_vocab = " + to_string(hxllama_n_vocab(h["vocab"])))
    println("  n_ctx   = " + to_string(hxllama_n_ctx(h["ctx"])))

    println("")
    println("Generating 10 tokens for prompt 'Hello' (greedy, temp=0.0)...")
    let text = llama_generate(h, "Hello", 10, 0.0, 0.9, 0)
    println("  raw output: " + text)

    println("")
    println("Cleanup...")
    llama_free(h)
    hxllama_backend_free()

    if text == "" {
        println("FAIL: empty generation")
        exit(1)
    }
    println("PASS Phase 3b smoke (libhxllama + llama_ffi.hexa end-to-end)")
}

