// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_chat_split_merge_smoke.hexa — F-D4-LIVE-1..3
//
//  PURPOSE
//    GOAL.md ★★★★★ criterion #4 ("D4 mitosis live": 실 chat 중 split/merge
//    event ≥1 발생 evidence). Run chat_generate with the mitosis cell
//    pool active on a synthetic small-shape substrate and observe:
//      1. mitosis_forward_tail fires per generated token (prefill + decode).
//      2. At least ONE split event lands in chat["mitosis_event_log"]
//         within 30-40 forwards.
//      3. Cell pool state mutates (cells count differs from initial OR
//         next_id advances — both indicate split/merge fired).
//
//    This is the **executable evidence** that closes GOAL.md cond #4
//    from 🔶 PARTIAL → ☑ ACHIEVED. The mitosis_hook selftest already
//    demonstrated split_seen=true after 60 direct forward_tail calls
//    (`tool/hexa_native/mitosis_hook.hexa`); this smoke proves the
//    SAME mechanism fires *inside* the chat library generation loop.
//
//  RUN
//    /Users/ghost/core/hexa-lang/hexa parse \
//        anima/tool/anima_chat_split_merge_smoke.hexa
//    HEXA_MEM_UNLIMITED=1 \
//        /Users/ghost/core/hexa-lang/build/hexa_interp.real run \
//        anima/tool/anima_chat_split_merge_smoke.hexa
//
//  EXPECTED OUTPUT (tail)
//    F-D4-LIVE SMOKE PASS  (N/N)
//    + cell timeline + event log dump for the audit doc.
//
//  SYNTHETIC SHAPE (same as multitoken smoke)
//    d_model = 8, d_ff = 16, n_heads = 2, n_kv_heads = 1, d_head = 4,
//    vocab_size = 16, n_layers = 2, cap_len = 64.
//
//    The mitosis cell pool is sized to MATCH d_model=8 so the hook input
//    vector has the correct shape. initial_cells=2; split threshold +
//    patience = pool defaults (cell_pool_init in mitosis_hook.hexa).
//
//  FALSIFIERS (raw-117 ≥3)
//    F-D4-LIVE-1 SPLIT-EVENT       : chat_generate(max_new=40) yields ≥1
//                                     mitosis event of type "split" in
//                                     chat["mitosis_event_log"].
//    F-D4-LIVE-2 STATE-MUTATION    : len(chat["cell_pool"]["cells"]) at end
//                                     of run differs from initial_cells OR
//                                     next_id > initial_cells (split
//                                     advanced the counter).
//    F-D4-LIVE-3 INVOCATION-MATCH  : mitosis_invocations == prompt_n +
//                                     decode_steps_actually_run (one hook
//                                     fire per forward call).
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (synthetic dims listed) ·
//    raw#9/10 honest scope (synthetic substrate vs 24L production note) ·
//    raw-117 ≥3 falsifiers
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/chat_lib.hexa"


let mut g_pass = 0
let mut g_total = 0
let mut g_first_fail = ""

fn live_check(label: string, ok: bool) {
    g_total = g_total + 1
    if ok {
        g_pass = g_pass + 1
        println("  PASS  " + label)
    } else {
        if len(g_first_fail) == 0 { g_first_fail = label }
        println("  FAIL  " + label)
    }
}


// Synthetic dims (identical to multitoken smoke for cross-validation).
fn _sm_dims() {
    let d = #{}
    d["d_model"]    = 8
    d["d_ff"]       = 16
    d["n_heads"]    = 2
    d["n_kv_heads"] = 1
    d["d_head"]     = 4
    d["vocab_size"] = 16
    d["n_layers"]   = 2
    d["eps"]        = 0.00001
    d["rope_theta"] = 10000.0
    return d
}


fn _sm_make_farr(n: int, seed: float) -> int {
    let h = farr_zeros(n)
    let mut i = 0
    while i < n {
        let angle = seed + (i * 1.0) * 0.137
        farr_set(h, i, sin(angle) * 0.1)
        i = i + 1
    }
    return h
}


fn _sm_build_synth_weights(dims) {
    let d_model    = dims["d_model"]
    let d_ff       = dims["d_ff"]
    let n_kv_heads = dims["n_kv_heads"]
    let d_head     = dims["d_head"]
    let vocab_size = dims["vocab_size"]
    let n_layers   = dims["n_layers"]
    let kv_dim     = n_kv_heads * d_head
    let weights = #{}
    weights["tok_emb.weight"] = _sm_make_farr(vocab_size * d_model, 0.31)
    let nf_gamma = farr_zeros(d_model)
    let mut gi = 0
    while gi < d_model {
        farr_set(nf_gamma, gi, 1.0)
        gi = gi + 1
    }
    weights["norm_f.weight"] = nf_gamma
    let mut li = 0
    while li < n_layers {
        let prefix = "layers." + to_string(li) + "."
        let n1 = farr_zeros(d_model)
        let n2 = farr_zeros(d_model)
        let mut ni = 0
        while ni < d_model {
            farr_set(n1, ni, 1.0)
            farr_set(n2, ni, 1.0)
            ni = ni + 1
        }
        weights[prefix + "norm1.weight"] = n1
        weights[prefix + "norm2.weight"] = n2
        let seed_base = (li * 1.0) * 1.7 + 0.5
        weights[prefix + "attn.q_proj.weight"] = _sm_make_farr(d_model * d_model, seed_base + 0.1)
        weights[prefix + "attn.k_proj.weight"] = _sm_make_farr(kv_dim  * d_model, seed_base + 0.2)
        weights[prefix + "attn.v_proj.weight"] = _sm_make_farr(kv_dim  * d_model, seed_base + 0.3)
        weights[prefix + "attn.o_proj.weight"] = _sm_make_farr(d_model * d_model, seed_base + 0.4)
        weights[prefix + "ffn.gate.weight"]    = _sm_make_farr(d_ff    * d_model, seed_base + 0.5)
        weights[prefix + "ffn.up.weight"]      = _sm_make_farr(d_ff    * d_model, seed_base + 0.6)
        weights[prefix + "ffn.down.weight"]    = _sm_make_farr(d_model * d_ff,    seed_base + 0.7)
        li = li + 1
    }
    return weights
}


// ── F-D4-LIVE-1..3 driver ──────────────────────────────────────────────────
fn _live_run() {
    println("")
    println("── F-D4-LIVE chat_generate w/ cell_pool active ─────────────────")
    let dims = _sm_dims()
    let chat = chat_new("/dev/null", "cpu", [])
    chat["weights"] = _sm_build_synth_weights(dims)
    chat_init_kv_cache_with_dims(chat, dims, 64)
    let initial_cells = 2
    chat_init_cell_pool(chat, dims["d_model"], initial_cells)

    // Sanity pre-conditions.
    let pre_invoc = chat_mitosis_invocation_count(chat)
    let pre_events = chat_mitosis_event_count(chat)
    let pre_cells  = len(chat["cell_pool"]["cells"])
    println("  pre-run: invocations=" + to_string(pre_invoc)
            + " events=" + to_string(pre_events)
            + " cells=" + to_string(pre_cells)
            + " next_id=" + to_string(chat["cell_pool"]["next_id"]))

    // Drive a chat_generate. Use greedy + max_new=40 — combined with prefill
    // (≤ 12 byte tokens for the prompt below) we expect 50+ hook fires,
    // which mitosis_hook selftest demonstrated is enough for ≥1 split event
    // on 2-cell d=8 substrate.
    let prompt = "안녕? 너는 누구야?"
    println("  prompt: " + prompt)
    let resp = chat_generate(chat, prompt, "greedy", 40, 0.0, [],
                             1.0, 1.0, 0.0, 2026, [], false)
    println("  response (synthetic, may be empty): \"" + resp + "\"  (len="
            + to_string(len(resp)) + ")")

    let post_invoc = chat_mitosis_invocation_count(chat)
    let post_events = chat_mitosis_event_count(chat)
    let post_cells  = len(chat["cell_pool"]["cells"])
    let post_nextid = chat["cell_pool"]["next_id"]
    println("  post-run: invocations=" + to_string(post_invoc)
            + " events=" + to_string(post_events)
            + " cells=" + to_string(post_cells)
            + " next_id=" + to_string(post_nextid))

    // Dump the event log timeline (audit doc evidence).
    let event_log = chat["mitosis_event_log"]
    let n_events = len(event_log)
    println("")
    println("  Event log (n=" + to_string(n_events) + "):")
    let mut ei = 0
    let mut n_split = 0
    let mut n_merge = 0
    while ei < n_events {
        let ev = event_log[ei]
        let etype = ev["type"]
        let estep = ev["step"]
        if etype == "split" { n_split = n_split + 1 }
        if etype == "merge" { n_merge = n_merge + 1 }
        println("    [" + to_string(ei) + "] step=" + to_string(estep)
                + " type=" + etype)
        ei = ei + 1
    }
    println("  split events: " + to_string(n_split)
            + "  merge events: " + to_string(n_merge))

    // F-D4-LIVE-1 SPLIT-EVENT
    live_check("F-D4-LIVE-1 ≥1 split event in event_log",
               n_split >= 1)

    // F-D4-LIVE-2 STATE-MUTATION — either cell count changed or next_id
    // advanced past initial_cells (split assigns new cell IDs from next_id).
    let cells_changed = post_cells != initial_cells
    let nextid_advanced = post_nextid > initial_cells
    live_check("F-D4-LIVE-2 cell pool state mutated (cells changed OR next_id advanced)",
               cells_changed || nextid_advanced)

    // F-D4-LIVE-3 INVOCATION-MATCH — invocations == prefill_n + decode_steps.
    // We can't know decode_steps a priori (early EOS may break early); just
    // verify invocations is at least prefill_n and ≤ prefill_n + max_new.
    let prefill_n = chat_kv_cache_len(chat) - 0   // cur_len = prefill_n + decode_steps
    println("  prefill_n + decode_steps (cur_len) = " + to_string(chat_kv_cache_len(chat)))
    // We expect invocations to match cur_len (one hook fire per forward).
    live_check("F-D4-LIVE-3 mitosis_invocations == kv_cache cur_len",
               post_invoc == chat_kv_cache_len(chat))
}


// ── main ───────────────────────────────────────────────────────────────────
fn main() {
    println("================================================================")
    println("anima_chat.hexa v0.3 — F-D4-LIVE-1..3 smoke")
    println("(GOAL.md cond #4 evidence — live split/merge in chat_generate)")
    println("================================================================")

    _live_run()

    println("")
    println("----------------------------------------------------------------")
    println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed")
    if g_pass == g_total && g_total > 0 {
        println("F-D4-LIVE SMOKE PASS  (" + to_string(g_pass) + "/" + to_string(g_total) + ")")
    } else {
        println("F-D4-LIVE SMOKE FAIL  first_fail=" + g_first_fail)
    }
    println("================================================================")
}
