// ════════════════════════════════════════════════════════════════════════════
//  channel_mux_lib.hexa — anima multi-channel registry skeleton (Phase C1)
//
//  Mira Murati Interaction Model 패러다임 (request-response 폐기) 위에서
//  anima 의 emission 을 ≥3 channel kind (text_cli / tension_link / voice)
//  로 multiplex. 본 lib 는 **text-only simulation** — 실 audio/UDP/HTTP I/O
//  는 future RFC (channel adapter 별 dispatch는 caller side 에서 처리).
//
//  Pure-fn registry: dict-of-record over channel_name → channel_record.
//  All operations closed-form 검증 가능 (set membership + record completeness
//  + Boolean predicate). B-CHANNEL-MUX-1..6 sympy battery (blue_falsifier).
//
//  Reference: ready/anima/modules/agent/channels/channel_manager.py (PyTorch)
//  Mapping:
//    Python ChannelManager.register/unregister/list/broadcast
//      ↔ hexa channel_mux_register/unregister/list_active/broadcast
//
//  Closed anchors:
//    - registry  | set-membership closure (dict key ∈ {registered})
//    - kind      | finite enum ⊆ {"text_cli", "tension_link", "voice"}
//    - active    | Boolean predicate (record.active == true)
//    - broadcast | iter-over-active deterministic order
//
//  HARD CONSTRAINTS:
//    - pure-hexa hexa-cpu only (NO GPU, NO PyTorch import)
//    - text-only simulation (실 I/O = future RFC)
//    - NO main / NO _selftest (compiled-first lib, smoke is separate file)
//    - hexa-lang syntax: dict literal `#{}`, missing key → `void` (NOT null)
//
//  SSOT: HEXAD/CHAT/PLAN.md Phase C1 · HEXAD/CHAT/SPONTANEOUS.tape
//        @N tension_link_integration + @N anima_voice_integration
// ════════════════════════════════════════════════════════════════════════════


// ── §1 channel kind enum (closed finite set, ≥3) ─────────────────────────────

// kind ∈ {"text_cli", "tension_link", "voice"} — 3 element finite set.
// Future RFC 가 더 추가 가능 (telegram / discord / slack 등 channel_manager.py
// 패턴), 본 lib 의 closed-form 검증은 정확히 3 kind 기준.

fn channel_kind_text_cli() -> string     { return "text_cli" }
fn channel_kind_tension_link() -> string { return "tension_link" }
fn channel_kind_voice() -> string        { return "voice" }

fn channel_kind_count() -> int { return 3 }

// is_valid_kind: closed Boolean predicate — kind ∈ enum
fn channel_kind_valid(kind: string) -> bool {
    if kind == "text_cli"     { return true }
    if kind == "tension_link" { return true }
    if kind == "voice"        { return true }
    return false
}


// ── §2 channel record constructor (5-field closed schema) ────────────────────

// channel_record = #{
//   "name":    string,    // unique registry key (e.g. "cli-stdin")
//   "kind":    string,    // ∈ enum §1
//   "send_fn": string,    // fn ref name (string-token, placeholder until
//                          //              hexa-lang fn-ref decl lands; per
//                          //              SPONTANEOUS.tape future-rfc audio)
//   "recv_fn": string,    // fn ref name (same)
//   "active":  bool       // running status
// }

fn channel_record_create(name: string, kind: string,
                         send_fn: string, recv_fn: string) -> any {
    let rec = #{
        "name": name,
        "kind": kind,
        "send_fn": send_fn,
        "recv_fn": recv_fn,
        "active": false
    }
    return rec
}

// completeness: 5 required keys all present (Boolean predicate)
fn channel_record_complete(rec: any) -> bool {
    let has_name    = to_string(rec["name"])    != "void"
    let has_kind    = to_string(rec["kind"])    != "void"
    let has_send_fn = to_string(rec["send_fn"]) != "void"
    let has_recv_fn = to_string(rec["recv_fn"]) != "void"
    let has_active  = to_string(rec["active"])  != "void"
    return has_name && has_kind && has_send_fn && has_recv_fn && has_active
}


// ── §3 registry constructor (empty-dict, closed identity) ────────────────────

// registry = #{} of channel_name → channel_record
fn channel_mux_new() -> any {
    let reg = #{}
    return reg
}

// size = count of registered channel keys
// (compiled-native dict-count: caller passes pre-known names — pure-fn
//  closure on dict iteration is hexa-lang RFC; here we expose name lookup)
fn channel_mux_has(registry: any, name: string) -> bool {
    return to_string(registry[name]) != "void"
}


// ── §4 register / unregister (closed set ops) ────────────────────────────────

// register: registry' = registry ∪ {(name, record)}
//   closed: if record kind invalid OR incomplete, registry unchanged (NOOP)
fn channel_mux_register(registry: any, rec: any) -> any {
    if channel_record_complete(rec) == false { return registry }
    let kind = to_string(rec["kind"])
    if channel_kind_valid(kind) == false { return registry }
    let name = to_string(rec["name"])
    registry[name] = rec
    return registry
}

// unregister: registry' = registry ∖ {name}
//   closed: if name ∉ registry, return registry unchanged
fn channel_mux_unregister(registry: any, name: string) -> any {
    if channel_mux_has(registry, name) == false { return registry }
    // hexa-lang: dict key delete via assign void marker (per memory:
    //   feedback_hexa_lang_syntax_gotchas — missing key → void)
    registry[name] = "void"
    return registry
}


// ── §5 activate / deactivate (Boolean predicate flip, closed) ────────────────

fn channel_mux_activate(registry: any, name: string) -> any {
    if channel_mux_has(registry, name) == false { return registry }
    let rec = registry[name]
    rec["active"] = true
    registry[name] = rec
    return registry
}

fn channel_mux_deactivate(registry: any, name: string) -> any {
    if channel_mux_has(registry, name) == false { return registry }
    let rec = registry[name]
    rec["active"] = false
    registry[name] = rec
    return registry
}

// is_active: closed predicate (record exists AND .active == true)
fn channel_mux_is_active(registry: any, name: string) -> bool {
    if channel_mux_has(registry, name) == false { return false }
    let rec = registry[name]
    let act = to_string(rec["active"])
    return act == "true"
}


// ── §6 list_active count + distinct-kinds count (closed cardinality) ─────────
//
// list_active 가 dict-iter 를 요구 (hexa-lang RFC pending) — 본 lib 는 finite
// fixed-set 3 (text_cli / tension_link / voice) 를 가정하고 known-name probe
// 패턴 사용 (smoke 가 known names 로 호출). pure-fn closure 유지.

fn channel_mux_active_count_3kinds(registry: any,
                                    name_cli: string,
                                    name_tl: string,
                                    name_voice: string) -> int {
    let mut c = 0
    if channel_mux_is_active(registry, name_cli)   { c = c + 1 }
    if channel_mux_is_active(registry, name_tl)    { c = c + 1 }
    if channel_mux_is_active(registry, name_voice) { c = c + 1 }
    return c
}

// distinct kinds count among active channels (≤ 3)
fn channel_mux_distinct_kinds_count(registry: any,
                                     name_cli: string,
                                     name_tl: string,
                                     name_voice: string) -> int {
    let mut k = 0
    if channel_mux_is_active(registry, name_cli)   { k = k + 1 }
    if channel_mux_is_active(registry, name_tl)    { k = k + 1 }
    if channel_mux_is_active(registry, name_voice) { k = k + 1 }
    return k
}


// ── §7 broadcast (closed: pure-fn — text-only simulation) ────────────────────
//
// broadcast(registry, text) — text 를 모든 active channel 에 simulated emit.
// 실 I/O 없음: channel record 의 send_fn 이름 + text 를 묶은 dispatch_log
// list 만 반환 (caller가 적절히 dispatch). 본 fn 의 closure = 모든 active
// channel 에 정확히 1번씩 dispatch entry append (set-cover invariant).

fn broadcast_entry_create(channel_name: string, send_fn: string, text: string) -> any {
    let entry = #{
        "channel": channel_name,
        "send_fn": send_fn,
        "text": text
    }
    return entry
}

// broadcast count = number of dispatch entries (== active_count above).
// caller 가 active_count_3kinds 와 비교해서 set-cover invariant 검증 가능
// (B-CHANNEL-MUX-5 BROADCAST-CLOSURE).

fn broadcast_simulate_count(registry: any,
                             name_cli: string,
                             name_tl: string,
                             name_voice: string) -> int {
    // identical to active_count_3kinds — closed iteration invariant
    return channel_mux_active_count_3kinds(registry, name_cli, name_tl, name_voice)
}


// ── §8 watch mode predicate (Phase C `anima watch`, future Phase C4) ────────
//
// F-INTERACT-5: anima `watch` mode (user input 0 시 자연발화만 expressed).
// 본 fn = closed Boolean predicate: registry 에 active channel ≥1 AND user
// stimulus 부재 (silence flag). Caller가 silence_seconds 와 합쳐 사용.

fn watch_mode_active(registry: any, user_silence: bool,
                     name_cli: string, name_tl: string, name_voice: string) -> bool {
    if user_silence == false { return false }
    let n_active = channel_mux_active_count_3kinds(registry, name_cli, name_tl, name_voice)
    return n_active >= 1
}
