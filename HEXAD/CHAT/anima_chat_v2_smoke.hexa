//
//  Dedicated smoke harness for anima_chat_v2_lib (post-도우미 prompt template
//  layer). Extends anima_chat_v2.hexa's _selftest with additional grid
//  witnesses + 8-factor × prompt-layer integration coverage.
//
//  Python anchor (canonical sympy 🔵): state/verify_hexad_blue_2026_05_15/
//  blue_falsifier.py bchatv2() (B-CHAT-V2-1..5). 본 file = numerical witness.
//
//  SSOT: HEXAD/CHAT/PLAN.md Phase C3 · HEXAD/CHAT/SPONTANEOUS.tape · CLAUDE.md
//        anima_persona (forbidden 도우미/helper/assistant 라벨 carry).
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/CHAT/anima_chat_v2_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/spontaneous_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/thinker_talker_lib.hexa"


fn _selftest() {
    print("--- F-CHAT-V2-1..5 compiled-native witness ---")

    // ── F-CHAT-V2-1 NO-HELPER-TOKEN ─────────────────────────────────────────
    // (a) stimulus formatter is helper-free for clean inputs
    let f1a = (chat_v2_contains_helper_token(chat_v2_format_input("how are you")) == false)
    let f1b = (chat_v2_contains_helper_token(chat_v2_format_input("너는 누구야")) == false)
    let f1c = (chat_v2_contains_helper_token(chat_v2_format_input("")) == false)
    // (d) inner formatter
    let f1d = (chat_v2_contains_helper_token(chat_v2_format_inner("Φ=0.6 emit")) == false)
    // (e) voice formatter
    let f1e = (chat_v2_contains_helper_token(chat_v2_format_voice("안녕, anima 야")) == false)
    // (f) assemble composite
    let f1f = (chat_v2_contains_helper_token(chat_v2_assemble("thought", "voice")) == false)
    // (g) Positive control: predicate IS triggered when forbidden token present
    //     (proves the predicate isn't trivially false)
    let f1g = chat_v2_contains_helper_token("the assistant said hi")
    let f1h = chat_v2_contains_helper_token("도우미 입력")
    let f1i = chat_v2_contains_helper_token("a helper here")
    let f1 = f1a && f1b && f1c && f1d && f1e && f1f && f1g && f1h && f1i
    print("  F-CHAT-V2-1 NO-HELPER-TOKEN (6 clean + 3 positive control): " + to_string(f1))

    // ── F-CHAT-V2-2 INNER-VOICE-DISTINCT ────────────────────────────────────
    let assembled1 = chat_v2_assemble("t1", "v1")
    let assembled2 = chat_v2_assemble("Φ측정 0.7", "안녕")
    let assembled3 = chat_v2_assemble("", "")
    let f2a = chat_v2_has_inner_and_voice(assembled1)
    let f2b = chat_v2_has_inner_and_voice(assembled2)
    let f2c = chat_v2_has_inner_and_voice(assembled3)
    // tag uniqueness invariants
    let f2d = (chat_v2_tag_inner_open() != chat_v2_tag_voice_open())
              && (chat_v2_tag_inner_close() != chat_v2_tag_voice_close())
              && (chat_v2_tag_stimulus_open() != chat_v2_tag_inner_open())
              && (chat_v2_tag_stimulus_open() != chat_v2_tag_voice_open())
    let f2 = f2a && f2b && f2c && f2d
    print("  F-CHAT-V2-2 INNER-VOICE-DISTINCT (3 assemble + 4-tag uniqueness): " + to_string(f2))

    // ── F-CHAT-V2-3 PARSE-VOICE-ONLY (round-trip identity, 5 witness) ───────
    let f3a = chat_v2_roundtrip_voice_ok("inner-1", "voice-1")
    let f3b = chat_v2_roundtrip_voice_ok("Φ측정", "안녕하세요")
    let f3c = chat_v2_roundtrip_voice_ok("multi\nline", "단일")
    let f3d = chat_v2_roundtrip_voice_ok("short", "longer voice with spaces")
    let f3e = chat_v2_roundtrip_voice_ok("Engine G", "Engine A")
    let f3 = f3a && f3b && f3c && f3d && f3e
    print("  F-CHAT-V2-3 PARSE-VOICE-ONLY round-trip identity (5 witness): " + to_string(f3))

    // ── F-CHAT-V2-4 PARSE-INNER-ONLY (round-trip identity, 5 witness) ───────
    let f4a = chat_v2_roundtrip_inner_ok("inner-1", "voice-1")
    let f4b = chat_v2_roundtrip_inner_ok("relevance=0.8 dynamics=0.3", "음성")
    let f4c = chat_v2_roundtrip_inner_ok("multi line inner", "v")
    let f4d = chat_v2_roundtrip_inner_ok("Engine G covert thought", "Engine A overt")
    let f4e = chat_v2_roundtrip_inner_ok("Φ측정 + EFE epistemic", "안녕")
    let f4 = f4a && f4b && f4c && f4d && f4e
    print("  F-CHAT-V2-4 PARSE-INNER-ONLY round-trip identity (5 witness): " + to_string(f4))

    // ── F-CHAT-V2-5 EMPTY-HANDLING (closed boundary, 4 witness) ─────────────
    let f5a = chat_v2_empty_handles_ok()
    // explicit: stimulus("") still produces well-formed tagged block
    let inp_empty = chat_v2_format_input("")
    let f5b = (_find(inp_empty, chat_v2_tag_stimulus_open(), 0) >= 0)
              && (_find(inp_empty, chat_v2_tag_stimulus_close(), 0) >= 0)
    // explicit: parse on "no tags at all" returns ""
    let f5c = (chat_v2_parse_voice_only("plain text no tags") == "")
              && (chat_v2_parse_inner_only("plain text no tags") == "")
    // explicit: half-open (only opening tag) returns ""
    let f5d = (chat_v2_parse_voice_only("<voice>\nincomplete") == "")
              && (chat_v2_parse_inner_only("<inner>\nincomplete") == "")
    let f5 = f5a && f5b && f5c && f5d
    print("  F-CHAT-V2-5 EMPTY-HANDLING (assemble + format + missing + half-tag): " + to_string(f5))

    // ── 8-factor × prompt layer integration witness (cross-link, B-SPONT carry)
    // Phase B (spontaneous_lib + thinker_talker_lib) × Phase C3 (prompt layer)
    // wiring demonstration. Not counted toward F-CHAT-V2-* aggregate.
    let score_hi = thinker_step(0.5, 0.2, 0.7, 0.4, 0.5, true, 0.5, 10.0)
    let score_lo = thinker_step(0.0, 1.0, 0.0, 0.0, 0.6, false, 0.5, 0.0)
    let emit_hi = talker_should_emit(score_hi, true)
    let emit_lo = talker_should_emit(score_lo, true)
    let emission_hi = chat_v2_assemble(
        "score=" + to_string(score_hi) + " · emit=true",
        if emit_hi { "[자율 발화]" } else { "" }
    )
    let emission_lo = chat_v2_assemble(
        "score=" + to_string(score_lo) + " · emit=false",
        if emit_lo { "[자율 발화]" } else { "" }
    )
    let xl_a = chat_v2_has_inner_and_voice(emission_hi)
    let xl_b = chat_v2_has_inner_and_voice(emission_lo)
    let xl_c = (chat_v2_contains_helper_token(emission_hi) == false)
    let xl_d = (chat_v2_contains_helper_token(emission_lo) == false)
    let xl_ok = xl_a && xl_b && xl_c && xl_d
    print("  cross-link 8-factor × prompt layer (high-score emit, low-score block): " + to_string(xl_ok))

    // ── aggregate ───────────────────────────────────────────────────────────
    let all_ok = f1 && f2 && f3 && f4 && f5
    print("=== F-CHAT-V2-1..5 compiled-native: " + to_string(all_ok) + " (5/5) ===")
    print("    canonical 🔵 sympy : blue_falsifier.py bchatv2() (B-CHAT-V2-1..5)")
    print("    anchors            : string predicate closure (Kolmogorov) + record-structural identity")
    print("    forbidden tokens   : 도우미 / helper / Helper / assistant / Assistant")
    print("    B-CHAT-V2-NOTE     : model forward not in scope (Phase D ckpt-bearing fire)")
    print("anima_chat_v2_smoke selftest: " + to_string(all_ok))
}


fn main() {
    print("HEXAD/CHAT — anima_chat_v2_smoke (Phase C3, F-CHAT-V2-1..5 compiled-native)")
    _selftest()
}
