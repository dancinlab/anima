// spike_apply_smoke.hexa — F-SPIKE-APPLY-1..4 witness for spontaneous_lib.hexa
// §10 apply_spike_features. Spec: HEXAD/SPONTANEOUS/SPIKE_FACTOR_MAP.md §3+§4.
// Exit 0 on all PASS · prints "X/4 PASS" summary line.

import "/Users/ghost/core/anima/HEXAD/CHAT/spontaneous_lib.hexa"


fn _eq(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn _f(d: dict, k: string) -> float {
    if !d.has_key(k) { return -999.0 }
    return to_float(to_string(d[k]))
}

fn _base() -> dict {
    return #{
        "relevance":   0.5, "info_gap":    0.5, "curiosity":   0.5, "pain":     0.3,
        "coherence":   0.5, "originality": 0.2, "balance":     0.7, "dynamics": 0.4,
    }
}

// Check passthrough factors equal base (used by F1/F2/F3 to assert non-target factors).
fn _passthrough_ok(out: dict, base: dict, keys: list, tol: float) -> bool {
    let mut i = 0
    while i < len(keys) {
        if !_eq(_f(out, to_string(keys[i])), _f(base, to_string(keys[i])), tol) { return false }
        i = i + 1
    }
    return true
}


fn _selftest() -> int {
    let tol = 1e-9
    let mut pass = 0
    let mut fail = 0
    print("--- F-SPIKE-APPLY-1..4 compiled-native witness ---")

    // ── F-SPIKE-APPLY-1 — empty features → factors unchanged (clamp only). ──
    let b = _base()
    let o1 = apply_spike_features(b, #{})
    let all_keys = ["relevance","info_gap","curiosity","pain","coherence","originality","balance","dynamics"]
    if _passthrough_ok(o1, b, all_keys, tol) { pass = pass + 1   print("  F-SPIKE-APPLY-1 empty features → unchanged: PASS") }
    else                                     { fail = fail + 1   print("  F-SPIKE-APPLY-1 empty features → unchanged: FAIL") }

    // ── F-SPIKE-APPLY-2 — spike_rate_hz=20 + R3 modulator (×0.5). ───────────
    // cur  = 0.5 + 0.10*0.5 = 0.55 ;  orig = 0.2 + 0.05*0.5 = 0.225
    let o2 = apply_spike_features(_base(), #{ "spike_rate_hz": 20.0, "regime": "R3_tonic_zero_input" })
    let mut ok2 = true
    if !_eq(_f(o2, "curiosity"),   0.55,  tol) { ok2 = false   print("    FAIL cur=" + to_string(_f(o2, "curiosity"))) }
    if !_eq(_f(o2, "originality"), 0.225, tol) { ok2 = false   print("    FAIL orig=" + to_string(_f(o2, "originality"))) }
    if !_passthrough_ok(o2, b, ["relevance","info_gap","pain","coherence","balance","dynamics"], tol) { ok2 = false }
    // Clamp sanity: every output ∈ [0,1].
    let k2 = o2.keys()
    let mut i = 0
    while i < len(k2) {
        let v = _f(o2, to_string(k2[i]))
        if v < 0.0 { ok2 = false }   if v > 1.0 { ok2 = false }
        i = i + 1
    }
    if ok2 { pass = pass + 1   print("  F-SPIKE-APPLY-2 spike_rate>12 + R3 (×0.5): PASS") }
    else   { fail = fail + 1   print("  F-SPIKE-APPLY-2 spike_rate>12 + R3 (×0.5): FAIL") }

    // ── F-SPIKE-APPLY-3 — regime_change=true + R2 modulator (×1.2). ─────────
    // pain = 0.3 + 0.15*1.2 = 0.48 ;  orig = 0.2 + 0.10*1.2 = 0.32
    let o3 = apply_spike_features(_base(), #{ "regime_change": true, "regime": "R2_bursting" })
    let mut ok3 = true
    if !_eq(_f(o3, "pain"),        0.48, tol) { ok3 = false   print("    FAIL pain=" + to_string(_f(o3, "pain"))) }
    if !_eq(_f(o3, "originality"), 0.32, tol) { ok3 = false   print("    FAIL orig=" + to_string(_f(o3, "originality"))) }
    if !_passthrough_ok(o3, b, ["relevance","info_gap","curiosity","coherence","balance","dynamics"], tol) { ok3 = false }
    if ok3 { pass = pass + 1   print("  F-SPIKE-APPLY-3 regime_change=true + R2 (×1.2): PASS") }
    else   { fail = fail + 1   print("  F-SPIKE-APPLY-3 regime_change=true + R2 (×1.2): FAIL") }

    // ── F-SPIKE-APPLY-4 — substrate-only invariance: relevance + balance. ───
    // Mix several active features so non-substrate factors move; assert
    // relevance + balance are byte-equal to input (§2 substrate-only row).
    let mix = #{
        "spike_rate_hz": 20.0, "isi_cv": 2.0, "mean_spike_ids_count": 12.0,
        "regime_change": true, "regime": "R1_oscillatory",
    }
    let o4 = apply_spike_features(b, mix)
    let mut ok4 = true
    if !_eq(_f(o4, "relevance"), _f(b, "relevance"), 0.0) { ok4 = false   print("    FAIL relevance drift") }
    if !_eq(_f(o4, "balance"),   _f(b, "balance"),   0.0) { ok4 = false   print("    FAIL balance drift") }
    // sanity: at least one non-substrate factor MUST move (else features are no-op).
    let moved = (!_eq(_f(o4, "curiosity"),   _f(b, "curiosity"),   tol))
             || (!_eq(_f(o4, "originality"), _f(b, "originality"), tol))
             || (!_eq(_f(o4, "coherence"),   _f(b, "coherence"),   tol))
             || (!_eq(_f(o4, "info_gap"),    _f(b, "info_gap"),    tol))
             || (!_eq(_f(o4, "pain"),        _f(b, "pain"),        tol))
    if !moved { ok4 = false   print("    FAIL no non-substrate factor moved") }
    if ok4 { pass = pass + 1   print("  F-SPIKE-APPLY-4 substrate-only invariance (rel/bal byte-eq): PASS") }
    else   { fail = fail + 1   print("  F-SPIKE-APPLY-4 substrate-only invariance (rel/bal byte-eq): FAIL") }

    let total = pass + fail
    print("=== F-SPIKE-APPLY-1..4 selftest: " + to_string(pass) + "/" + to_string(total) + " PASS ===")
    if fail == 0 { return 0 }
    return 1
}


fn main() {
    print("HEXAD/CHAT — spike_apply_smoke (F-SPIKE-APPLY-1..4)")
    let rc = _selftest()
    if rc != 0 { exit(1) }
}
