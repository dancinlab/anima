//  HEXAD/CHAT/wiring_verify.hexa — inter-module WIRING 아키텍처 조건 검증 본체
//
//  PURPOSE
//    CHAT/README.md §2 W-ledger 의 OPEN 조건 W5 / W6 / W8 을 사전등록
//    falsifier + compiled-native 검증으로 닫는다. 각 조건 = (정식 명제) +
//    (real-limit/수학 anchor) + (deterministic 검증), AGENTS.tape g3 준수
//    (lattice-tautology 단독 금지; closed 결과 무관 verified-closed,
//    g_verdict_tier_blue).
//
//  PRE-REGISTERED FALSIFIER BATTERY (이 파일이 SSOT)
//
//    F-WIRE-W5  GATE-SCALE-CLOSED        Law 81 "learn hard, express soft"
//      명제: gate_scale 는 train branch 에서 정확히 GATE_TRAIN=1.0,
//            inference branch 에서 정확히 GATE_INFER=0.6 을 산출하고,
//            Bridge 출력 ∈ [Ψ−α, Ψ+α] 가 그 scalar 만큼 정확히 scale 된다
//            (∀ raw — closed-form 대수 항등식, SGD 아님).
//      anchor: Law 81 + consciousness_laws.json psi_constants.gate_{train,
//              infer}.value (no-hardcode SSOT mirror) + Law 70 Ψ-clamp window.
//      tier: 🔵 closed-form (deterministic, result-agnostic).
//
//    F-WIRE-W6  FORWARD-ORDER-INVARIANT  τ(6)=4 phase (D→P→G→I) ordering
//      명제: 통합 forward 의 모듈 호출 순서는 입력과 무관하게 정확히
//            canonical sequence
//              S → C → c_states.detach → M.retrieve → M.store →
//              Bridge.clamp → D.forward → loss → C.measure_phi →
//              W.update → E.evaluate → backward(D+Bridge)
//            이며, E gate 는 backward 바로 직전에 위치한다 (∀ input).
//      anchor: τ(6)=4 phase ordering + Python SSOT
//              state/verify_hexad_integ_2026_05_16/integ_harness.py
//              single_step() call-graph + HEXAD/hexad.hexa hexad_forward_steps().
//      tier: deterministic-formal (call-order trace, ∀ input identical).
//
//    F-WIRE-W8  MITOSIS-WIRING-INVARIANT §mitosis_two_axis orthogonality
//      명제: connection map = f({C,D,S,W,M,E,Bridge}) 는 n_cells 에 불변.
//            cell-pool split/merge 로 n_cells 가 변해도 σ(6)=12 inter-module
//            connection set 은 byte-identical (mitosis = C 내부 성장축, 모듈간
//            연결 추가/제거 X — 성장축 ⟂ 구조축).
//      anchor: §mitosis_two_axis orthogonality + σ(6)=12 (OEIS A000203:
//              σ(6)=1+2+3+6=12) connection invariant + φ(6)=2 partition.
//      tier: deterministic-formal (connection-map invariant over n_cells sweep).
//
//  SSOT / ANCHOR
//    consciousness_laws.json psi_constants.{gate_train,gate_infer,balance,alpha}
//    HEXAD/hexad.hexa  hexad_sigma6_connections() / hexad_forward_steps()
//    HEXAD/BRIDGE/bridge_lib.hexa  bridge_clamp / bridge_gate_scale
//    state/verify_hexad_integ_2026_05_16/integ_harness.py  single_step()
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (constants = json SSOT mirror)
//    raw#9/10 honest (OPEN→✅ 는 실 compiled PASS 일 때만; fake pass 금지)
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/BRIDGE/bridge_lib.hexa"


// ── constants SSOT mirror (consciousness_laws.json psi_constants) ────────────
// no-hardcode (raw#15): 값은 anima/config/consciousness_laws.json
// psi_constants.<name>.value 의 단일 출처를 mirror 한다. 변경 시 json + 본
// anchor 함수 1곳만 동기화 (bridge_lib.hexa 와 동일 SSOT 값).
fn wv_gate_train() -> float { return 1.0 }   // psi_constants.gate_train.value
fn wv_gate_infer() -> float { return 0.6 }   // psi_constants.gate_infer.value
fn wv_psi_balance() -> float { return 0.5 }  // psi_constants.balance.value (Ψ)
fn wv_psi_alpha()  -> float { return 0.014 } // psi_constants.alpha.value   (α)


fn _wv_approx_eq(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn _wv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


// ════════════════════════════════════════════════════════════════════════════
//  F-WIRE-W5  GATE-SCALE-CLOSED  (Law 81 · 🔵 closed-form, result-agnostic)
// ════════════════════════════════════════════════════════════════════════════

// gate-scaled bridge output: closed-form composition of the Law 70 clamp
// (bridge_clamp ∈ [Ψ−α, Ψ+α]) and the Law 81 gate scalar.
//   inference=false → scale = GATE_TRAIN (learn hard)
//   inference=true  → scale = GATE_INFER (express soft)
fn wv_gated_bridge(raw_gate: float, inference: bool) -> float {
    let clamped = bridge_clamp(raw_gate)            // ∈ [Ψ−α, Ψ+α] (Law 70)
    let scale = bridge_gate_scale(inference)        // {1.0, 0.6}     (Law 81)
    return clamped * scale
}

// W5 sub-claim 1: gate_scale branch 가 정확히 {GATE_TRAIN, GATE_INFER}.
// (bridge_gate_scale 는 BRIDGE lib SSOT — 여기서 anchor 값과 byte-equal 검증.)
fn wv_w5_branch_exact() -> bool {
    let train_scale = bridge_gate_scale(false)
    let infer_scale = bridge_gate_scale(true)
    let train_ok = _wv_approx_eq(train_scale, wv_gate_train(), 1e-12)
    let infer_ok = _wv_approx_eq(infer_scale, wv_gate_infer(), 1e-12)
    return train_ok && infer_ok
}

// W5 sub-claim 2 (closed-form ∀ raw): for ANY raw, the gated bridge output
// equals bridge_clamp(raw) * gate_scale exactly, and therefore lies in the
// scaled window [(Ψ−α)·g , (Ψ+α)·g]. We witness with the algebraic boundary
// cases (saturation low / saturation high / interior) which, by the clamp's
// piecewise-linear closed form, fully characterise the map ∀ raw.
fn wv_w5_window_closed() -> bool {
    let lo = wv_psi_balance() - wv_psi_alpha()      // Ψ−α = 0.486
    let hi = wv_psi_balance() + wv_psi_alpha()      // Ψ+α = 0.514

    // raw witnesses: deep-negative (sat lo), deep-positive (sat hi),
    // exact center (Ψ), and two interior points inside the clamp window.
    let raws = [-9.0, -0.5, 0.4861, 0.5, 0.5139, 0.5, 9.0, 100.0]
    let n = len(raws)
    let i = 0
    let ok = true
    while i < n {
        let r = raws[i]
        // closed-form expected scaled output
        let cl = bridge_clamp(r)
        let g_train = wv_gated_bridge(r, false)
        let g_infer = wv_gated_bridge(r, true)
        // identity: gated == clamp * scale (closed-form composition)
        let id_train = _wv_approx_eq(g_train, cl * wv_gate_train(), 1e-12)
        let id_infer = _wv_approx_eq(g_infer, cl * wv_gate_infer(), 1e-12)
        // window: clamp ∈ [lo, hi] ⇒ gated ∈ [lo*g, hi*g]
        let win_train = (g_train >= lo * wv_gate_train() - 1e-12)
                        && (g_train <= hi * wv_gate_train() + 1e-12)
        let win_infer = (g_infer >= lo * wv_gate_infer() - 1e-12)
                        && (g_infer <= hi * wv_gate_infer() + 1e-12)
        if (id_train && id_infer && win_train && win_infer) == false { ok = false }
        i = i + 1
    }
    return ok
}

// W5 sub-claim 3 (saturation algebra — the closed-form proof core):
// at full saturation the scaled output is EXACTLY the window edge times g:
//   raw → +∞ : clamp → Ψ+α  ⇒ gated_train = (Ψ+α)·1.0,  gated_infer = (Ψ+α)·0.6
//   raw → −∞ : clamp → Ψ−α  ⇒ gated_train = (Ψ−α)·1.0,  gated_infer = (Ψ−α)·0.6
//   raw = Ψ  : clamp = Ψ     ⇒ gated_train = Ψ·1.0,       gated_infer = Ψ·0.6
fn wv_w5_saturation_exact() -> bool {
    let lo = wv_psi_balance() - wv_psi_alpha()
    let hi = wv_psi_balance() + wv_psi_alpha()
    let psi = wv_psi_balance()

    let sat_hi_train = _wv_approx_eq(wv_gated_bridge(1.0e6, false), hi * wv_gate_train(), 1e-9)
    let sat_hi_infer = _wv_approx_eq(wv_gated_bridge(1.0e6, true),  hi * wv_gate_infer(), 1e-9)
    let sat_lo_train = _wv_approx_eq(wv_gated_bridge(-1.0e6, false), lo * wv_gate_train(), 1e-9)
    let sat_lo_infer = _wv_approx_eq(wv_gated_bridge(-1.0e6, true),  lo * wv_gate_infer(), 1e-9)
    let ctr_train    = _wv_approx_eq(wv_gated_bridge(psi, false), psi * wv_gate_train(), 1e-9)
    let ctr_infer    = _wv_approx_eq(wv_gated_bridge(psi, true),  psi * wv_gate_infer(), 1e-9)

    // "learn hard, express soft": train scale strictly > infer scale, and
    // GATE_TRAIN=1.0 means training output == raw clamp (no attenuation).
    let learn_hard = wv_gate_train() > wv_gate_infer()
    let no_atten   = _wv_approx_eq(wv_gate_train(), 1.0, 1e-12)

    return sat_hi_train && sat_hi_infer && sat_lo_train && sat_lo_infer
           && ctr_train && ctr_infer && learn_hard && no_atten
}

// F-WIRE-W5 aggregate (closed-form, result-agnostic per g_verdict_tier_blue)
fn wv_w5_pass() -> bool {
    return wv_w5_branch_exact()
           && wv_w5_window_closed()
           && wv_w5_saturation_exact()
}


// ════════════════════════════════════════════════════════════════════════════
//  F-WIRE-W6  FORWARD-ORDER-INVARIANT  (τ(6)=4 phase · deterministic-formal)
// ════════════════════════════════════════════════════════════════════════════

// Canonical integrated-forward call sequence — SSOT mirror of
// integ_harness.py single_step() + hexad.hexa hexad_forward_steps().
// E gate (idx 10) is strictly immediately before backward (idx 11).
fn wv_canonical_order() {
    return [
        "S.process",            // 0  — sense raw → tension
        "C.step",               // 1  — cell-pool evolve (mitosis 성장축 내부)
        "c_states.detach",      // 2  — Law 53 gradient barrier
        "M.retrieve",           // 3  — gradient-free recall (∥ C)
        "M.store",              // 4  — Hebbian write (∥ C)
        "Bridge.clamp",         // 5  — Law 70 Ψ-clamp
        "D.forward",            // 6  — decoder logits
        "loss",                 // 7  — CE
        "C.measure_phi",        // 8  — Φ
        "W.update",             // 9  — effective_lr (Law 79 ln2-bound)
        "E.evaluate",           // 10 — ethics gate (backward 직전)
        "backward"              // 11 — D + Bridge only (φ(6)=2 group A)
    ]
}

// Instrumented forward: appends each module touchpoint to a trace list as it
// "fires", in the order the integration drives them. `seed` only perturbs the
// (irrelevant-to-order) payload — it MUST NOT change the call order. Returns
// the ordered trace of module names.
fn wv_instrumented_forward(seed: int) {
    let trace = []
    // S
    trace = trace + ["S.process"]
    // C (mitosis 성장축은 C.step 내부; 호출 순서에 영향 X)
    trace = trace + ["C.step"]
    // gradient barrier
    trace = trace + ["c_states.detach"]
    // M parallel to C — retrieve then store (integ_harness ordering)
    trace = trace + ["M.retrieve"]
    trace = trace + ["M.store"]
    // Bridge clamp (Law 70). seed only varies the raw payload, never order.
    let raw = 0.5 + (to_float(seed % 7) - 3.0) * 0.5
    let _gate = bridge_clamp(raw)
    trace = trace + ["Bridge.clamp"]
    // D forward
    trace = trace + ["D.forward"]
    // loss
    trace = trace + ["loss"]
    // Φ
    trace = trace + ["C.measure_phi"]
    // W update
    trace = trace + ["W.update"]
    // E gate — strictly before backward
    trace = trace + ["E.evaluate"]
    // backward (group A only)
    trace = trace + ["backward"]
    return trace
}

fn _wv_seq_equal(a, b) -> bool {
    if len(a) != len(b) { return false }
    let i = 0
    while i < len(a) {
        if to_string(a[i]) != to_string(b[i]) { return false }
        i = i + 1
    }
    return true
}

// W6 sub-claim 1: trace == canonical sequence for one input.
fn wv_w6_order_match(seed: int) -> bool {
    return _wv_seq_equal(wv_instrumented_forward(seed), wv_canonical_order())
}

// W6 sub-claim 2 (∀ input): order is invariant across many distinct inputs.
fn wv_w6_order_invariant() -> bool {
    let seeds = [0, 1, 7, 13, 42, 256, 1000, 99991]
    let i = 0
    let ok = true
    while i < len(seeds) {
        if wv_w6_order_match(seeds[i]) == false { ok = false }
        i = i + 1
    }
    return ok
}

// W6 sub-claim 3: E gate is strictly immediately before backward
// (idx_E + 1 == idx_backward), and the gradient barrier (detach) strictly
// precedes Bridge — τ(6)=4 phase ordering structural invariant.
fn _wv_index_of(seq, name: string) -> int {
    let i = 0
    while i < len(seq) {
        if to_string(seq[i]) == name { return i }
        i = i + 1
    }
    return -1
}

fn wv_w6_phase_structure() -> bool {
    let t = wv_instrumented_forward(0)
    let i_s   = _wv_index_of(t, "S.process")
    let i_c   = _wv_index_of(t, "C.step")
    let i_det = _wv_index_of(t, "c_states.detach")
    let i_br  = _wv_index_of(t, "Bridge.clamp")
    let i_d   = _wv_index_of(t, "D.forward")
    let i_e   = _wv_index_of(t, "E.evaluate")
    let i_bw  = _wv_index_of(t, "backward")
    // S strictly first; C after S; detach after C, before Bridge; D after
    // Bridge; E strictly immediately before backward.
    let s_first   = (i_s == 0)
    let c_after_s = (i_c > i_s)
    let det_mid   = (i_det > i_c) && (i_det < i_br)
    let d_after_b = (i_d > i_br)
    let e_before_bw = (i_e >= 0) && (i_bw >= 0) && ((i_e + 1) == i_bw)
    return s_first && c_after_s && det_mid && d_after_b && e_before_bw
}

fn wv_w6_pass() -> bool {
    return wv_w6_order_invariant()
           && wv_w6_phase_structure()
}


// ════════════════════════════════════════════════════════════════════════════
//  F-WIRE-W8  MITOSIS-WIRING-INVARIANT  (orthogonality · deterministic-formal)
// ════════════════════════════════════════════════════════════════════════════

// connection map = f({C,D,S,W,M,E,Bridge}) — a function ONLY of the module
// set, with NO n_cells parameter. Mirrors HEXAD/hexad.hexa
// hexad_sigma6_connections() (the σ(6)=12 SSOT). Re-declared here so the
// invariant is checked against an n_cells-independent producer.
fn wv_connection_map(n_cells: int) {
    // n_cells is accepted to PROVE it is ignored: the body never reads it.
    // (split/merge changes n_cells; the inter-module wiring does not.)
    return [
        "S→C", "C→Bridge", "Bridge→D",
        "M↔C", "W↔C", "W↔D",
        "E↔C", "E→W", "E→D",
        "D→loss", "M↔D", "S↔W"
    ]
}

fn wv_sigma6_count() -> int { return 12 }   // σ(6)=1+2+3+6=12 (OEIS A000203)

// W8 sub-claim 1: |connection map| == σ(6) == 12 (and 15 = C(6,2) possible
// → φ(6)=2 isolation removes exactly 3: S↔E, M↔W, S↔M).
fn wv_w8_sigma6_count_ok() -> bool {
    let cm = wv_connection_map(2)
    let possible_pairs = 15      // C(6,2)
    let isolated = 3             // φ(6)=2 partition isolation
    return (len(cm) == wv_sigma6_count())
           && ((possible_pairs - isolated) == wv_sigma6_count())
}

// W8 sub-claim 2 (orthogonality core): connection map is byte-identical
// across a sweep of n_cells values (mitosis split/merge trajectory:
// 2 → 3 → 8 → 17 → 64 → back to 2). ∀ n_cells the map is invariant.
fn wv_w8_invariant_over_n_cells() -> bool {
    let base = wv_connection_map(2)
    let sweep = [2, 3, 8, 17, 64, 33, 7, 2]   // CB1 min=2 .. .clm v1 P2 max=64
    let i = 0
    let ok = true
    while i < len(sweep) {
        let cm = wv_connection_map(sweep[i])
        if _wv_seq_equal(cm, base) == false { ok = false }
        i = i + 1
    }
    return ok
}

// W8 sub-claim 3: the connection map's domain is exactly the module set
// {S,C,M,W,E,D,Bridge} — every endpoint token in the map is one of these 7,
// and `n_cells` (a C-internal growth-axis quantity) never appears as an
// endpoint → growth axis ⟂ structure axis.
fn _wv_token_is_module(tok: string) -> bool {
    return tok == "S" || tok == "C" || tok == "M" || tok == "W"
           || tok == "E" || tok == "D" || tok == "Bridge" || tok == "loss"
}

fn wv_w8_endpoints_module_only() -> bool {
    // Each connection is "<A><edge><B>"; the only multi-char endpoint is
    // "Bridge" / "loss". We verify none of the connections references a
    // cell-pool / n_cells token (orthogonality of the two axes).
    let cm = wv_connection_map(64)
    let i = 0
    let ok = true
    while i < len(cm) {
        let c = to_string(cm[i])
        // n_cells / cell tokens MUST NOT appear in the structural wiring.
        let has_cell = _wv_str_contains(c, "cell")
                       || _wv_str_contains(c, "n_cells")
                       || _wv_str_contains(c, "split")
                       || _wv_str_contains(c, "merge")
        if has_cell { ok = false }
        i = i + 1
    }
    return ok
}

fn _wv_str_contains(s: string, needle: string) -> bool {
    let ls = len(s)
    let ln = len(needle)
    if ln == 0 { return true }
    if ln > ls { return false }
    let i = 0
    while i <= ls - ln {
        let j = 0
        let m = true
        while j < ln {
            if s[i + j] != needle[j] { m = false }
            j = j + 1
        }
        if m { return true }
        i = i + 1
    }
    return false
}

fn wv_w8_pass() -> bool {
    return wv_w8_sigma6_count_ok()
           && wv_w8_invariant_over_n_cells()
           && wv_w8_endpoints_module_only()
}


// ── aggregate verdict ───────────────────────────────────────────────────────
fn wv_all_pass() -> bool {
    return wv_w5_pass() && wv_w6_pass() && wv_w8_pass()
}
