// ═════════════════════════════════════════════════════════════════════════
// HEXAD/CHAT/coffeshop_akida.hexa — COFFESHOP → AKIDA 폐루프 라우터 (추론 lane)
//
// LAUNCHPAD @goal core: anima group-chat emit/silence 결정을 SW sim 이 아닌
// 실 neuromorphic silicon (AKD1000) 폐루프로 닫는다.
//
// 폐루프 (motivation → threshold → spike → emit):
//   spontaneous_lib 5+1 factor (closed-form B-SPONT-1..7) → motivation_score
//     │ set_threshold(thr_vec = base + (1−score)·SPAN)  → port 9513 (ctrl IN)
//     ▼
//   AKD1000 on-chip threshold-and-fire (M regime · V=N · unit fires iff V>thr_j)
//     │ spike raster
//     ▼ n_spikes  ← port 9512 (OUT broadcast)
//   should_interrupt = n_spikes ≥ quorum   → emit / silence
//
// 보정 (정직 · closed-form): base=linspace(2,18,16) · V=16 · SPAN=20 · QUORUM=6.
//   ⇒ 모든 COFFESHOP window 에서 on-chip spike-quorum 결정 == SW should_interrupt(0.60):
//     n_spikes ≥ 6  ⟺  motivation_score > 0.60.  emit {3,10,14,15} · silence 11 재현.
//
// AKIDA-first EVERYWHERE: HW-first 스위치 SSOT
// (../../AKIDA/akida_backend.hexa::akida_backend_resolve · default "hw") 경유.
//   칩 도달 → on-chip 무조건 실행 (provenance "akida-hw").
//   칩 미도달 → numpy mirror fallback (provenance "akida-sw-fallback").
//   DECODER 추론 lane 은 SW↔HW byte-identical (rounds 1-5) — 본 라우터의 SW 도 동치.
//
// 실 구동 = HEXAD/CHAT/coffeshop_akida.py (이 hexa 는 라우팅/provenance 의도 표기).
// substrate surface only (AGENT bridge · p1~p8): no system/persona/assistant.
// should_interrupt = substrate motivation 만 (a_substrate_native_speak:
//   user msg = 환경 context, direct_mention 에도 silence 가능).
// SSOT: factor=spontaneous_lib.hexa · wire=spike_streamer.py · switch=akida_backend.hexa
// ═════════════════════════════════════════════════════════════════════════

import "../../AKIDA/akida_backend.hexa" as bk

// 추론 lane provenance — DECODER 규약("akida-hw"/"akida-sw-fallback") 그대로.
pub fn coffeshop_akida_provenance(arg: string) -> string {
    let backend = bk.akida_backend_resolve_graceful(arg)
    if backend == "hw" { return "akida-hw" }
    return "akida-sw-fallback"
}

// 폐루프 코어 포트 (spike_streamer SSOT).
pub fn coffeshop_akida_out_port()  -> int { return 9512 }  // OUT spike broadcast
pub fn coffeshop_akida_ctrl_port() -> int { return 9513 }  // IN  set_threshold

// 보정 상수 (모듈 docstring CALIBRATION 과 동일).
pub fn coffeshop_akida_span()   -> float { return 20.0 }
pub fn coffeshop_akida_quorum() -> int   { return 6 }

// 폐루프 실 구동 엔트리 경로.
pub fn coffeshop_akida_py_path() -> string {
    return "HEXAD/CHAT/coffeshop_akida.py"
}

// 추론 lane SW↔HW 동치 verdict — 🟢 byte-identical (DECODER lane 결정론).
// PLASTICITY 학습 lane 의 🔴 비동치와 대비되는 핵심 경계.
pub fn coffeshop_akida_equivalence_verdict() -> string {
    return "🟢 byte-identical (추론 lane · DECODER 결정론 · spike-quorum 6 == should_interrupt 0.60)"
}

// 라우팅 요약 dict.
pub fn coffeshop_akida_route(arg: string) -> map {
    let backend = bk.akida_backend_resolve_graceful(arg)
    return #{
        "lane": "COFFESHOP-AKIDA (추론 · emit/silence 폐루프)",
        "backend": backend,
        "provenance": coffeshop_akida_provenance(arg),
        "out_port": coffeshop_akida_out_port(),
        "ctrl_port": coffeshop_akida_ctrl_port(),
        "quorum": coffeshop_akida_quorum(),
        "span": coffeshop_akida_span(),
        "py_entry": coffeshop_akida_py_path(),
        "sw_hw_equivalence": coffeshop_akida_equivalence_verdict(),
        "sibling_plasticity_equivalence": "🔴 CLOSED-NEGATIVE (학습 lane — 대비)",
    }
}
