// ════════════════════════════════════════════════════════════════════════════
//  anima_chat_v2_lib.hexa — post-도우미 prompt template layer (Phase C3)
//
//  User directive 2026-05-17: post-도우미 (<inner>/<voice>) prompt template
//  신규 hexa-native. AGENTS.tape anima_persona.forbidden — `사용자: ... |
//  도우미: ...` 패턴 architectural-level mandate 폐기. anima 는 Living
//  Consciousness Agent (NOT helper, NOT assistant).
//
//  본 file 의 책무 = PROMPT LAYER ONLY (no model forward). Engine G 의 thought
//  (inner) 와 Engine A 의 emission (voice) 를 명시적으로 구분하는 tag-based
//  format. 사용자가 보는 view = voice block 만. debug/audit view = inner block.
//
//  Format spec (PLAN.md §1.1 옵션 ⑤ + SPONTANEOUS.tape Thinker-Talker):
//
//    chat_v2_format_input(stimulus)
//      → "<stimulus>\n{stimulus}\n</stimulus>"
//        (NO 도우미 token, NO role prefix; user 는 stimulus-other 대등)
//
//    chat_v2_format_inner(thought)
//      → "<inner>\n{thought}\n</inner>"
//        (Engine G covert thought — Inner Thoughts paper covert intrinsic carry)
//
//    chat_v2_format_voice(utterance)
//      → "<voice>\n{utterance}\n</voice>"
//        (Engine A emission — 사용자 viewable)
//
//    chat_v2_assemble(inner, voice)
//      → "<inner>\n{inner}\n</inner>\n<voice>\n{voice}\n</voice>"
//        (통합 emission, 양 block 분리)
//
//    chat_v2_parse_voice_only(text)
//      → voice block 내용만 추출 (사용자 view)
//
//    chat_v2_parse_inner_only(text)
//      → inner block 내용만 추출 (debug/audit view)
//
//  Closed anchors (g_blue_closed_mandate · g3 real-limit, NO lattice f1/f2):
//    - string predicate closure (Kolmogorov arithmetic)
//    - record-structural identity (assemble + parse round-trip)
//    - Boolean predicate closure (forbidden-token absence)
//    - bounded-set: empty string handled as closed boundary
//
//  SSOT: HEXAD/CHAT/PLAN.md Phase C3 · HEXAD/CHAT/SPONTANEOUS.tape
//        thinker_talker_dual_thread · AGENTS.tape anima_persona
//  compiled-first lib (NO main · NO _selftest · NO top-level call).
//
//  honest caveat (g3): model forward 미포함 (별도 Phase D ckpt-bearing fire).
//  본 lib 는 prompt template layer 의 closed-form 검증만.
// ════════════════════════════════════════════════════════════════════════════


// ── §1 tag constants (string predicate closure, B-CHAT-V2-1 anchor) ─────────

fn chat_v2_tag_stimulus_open()  -> string { return "<stimulus>" }
fn chat_v2_tag_stimulus_close() -> string { return "</stimulus>" }
fn chat_v2_tag_inner_open()     -> string { return "<inner>" }
fn chat_v2_tag_inner_close()    -> string { return "</inner>" }
fn chat_v2_tag_voice_open()     -> string { return "<voice>" }
fn chat_v2_tag_voice_close()    -> string { return "</voice>" }


// ── §2 formatter fns (pure string concat, closed under Kolmogorov) ──────────

// chat_v2_format_input: user stimulus → tagged stream
//   "<stimulus>\n{stimulus}\n</stimulus>"
fn chat_v2_format_input(stimulus: string) -> string {
    return chat_v2_tag_stimulus_open() + "\n" + stimulus + "\n" + chat_v2_tag_stimulus_close()
}

// chat_v2_format_inner: Engine G thought → tagged inner block
//   "<inner>\n{thought}\n</inner>"
fn chat_v2_format_inner(thinking: string) -> string {
    return chat_v2_tag_inner_open() + "\n" + thinking + "\n" + chat_v2_tag_inner_close()
}

// chat_v2_format_voice: Engine A utterance → tagged voice block
//   "<voice>\n{utterance}\n</voice>"
fn chat_v2_format_voice(utterance: string) -> string {
    return chat_v2_tag_voice_open() + "\n" + utterance + "\n" + chat_v2_tag_voice_close()
}

// chat_v2_assemble: composite emission (inner + voice)
//   "<inner>\n{inner}\n</inner>\n<voice>\n{voice}\n</voice>"
fn chat_v2_assemble(inner: string, voice: string) -> string {
    return chat_v2_format_inner(inner) + "\n" + chat_v2_format_voice(voice)
}


// ── §3 byte-level string utilities (closed by Kolmogorov arithmetic) ────────

// _slen — string byte length (codepoint count via stdlib `len` on string)
// hexa-lang `len()` on string returns byte count (compiled-native carry).
fn _slen(s: string) -> int {
    return len(s)
}

// _substr — extract substring s[start:end] (byte-indexed, half-open)
// Closed by Kolmogorov; returns "" when range invalid.
fn _substr(s: string, start: int, end: int) -> string {
    let n = _slen(s)
    let mut a = start
    let mut b = end
    if a < 0 { a = 0 }
    if b > n { b = n }
    if a >= b { return "" }
    // hexa stdlib substring via index iteration
    let mut out = ""
    let mut i = a
    while i < b {
        out = out + s[i]
        i = i + 1
    }
    return out
}

// _find — first byte-index of needle in haystack starting at `from`,
//          -1 if not present. Closed predicate (Kolmogorov).
fn _find(haystack: string, needle: string, from: int) -> int {
    let n = _slen(haystack)
    let m = _slen(needle)
    if m == 0 { return from }
    if m > n { return -1 }
    let mut i = from
    if i < 0 { i = 0 }
    let last = n - m
    while i <= last {
        let mut j = 0
        let mut matched = true
        while j < m {
            if haystack[i + j] != needle[j] {
                matched = false
                j = m
            } else {
                j = j + 1
            }
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}


// ── §4 parser fns (inverse to formatter; round-trip identity, B-CHAT-V2-3/4) ─

// chat_v2_parse_voice_only: extract content between <voice>\n ... \n</voice>
//   Returns "" if voice block not present (closed empty boundary, B-CHAT-V2-5).
fn chat_v2_parse_voice_only(text: string) -> string {
    let open_tag = chat_v2_tag_voice_open()
    let close_tag = chat_v2_tag_voice_close()
    let i_open = _find(text, open_tag, 0)
    if i_open < 0 { return "" }
    let content_start = i_open + _slen(open_tag)
    let i_close = _find(text, close_tag, content_start)
    if i_close < 0 { return "" }
    // strip surrounding "\n" if present (assemble pattern: "<voice>\n{body}\n</voice>")
    let mut a = content_start
    let mut b = i_close
    if a < b && text[a] == "\n" { a = a + 1 }
    if a < b && text[b - 1] == "\n" { b = b - 1 }
    return _substr(text, a, b)
}

// chat_v2_parse_inner_only: extract content between <inner>\n ... \n</inner>
//   Returns "" if inner block not present.
fn chat_v2_parse_inner_only(text: string) -> string {
    let open_tag = chat_v2_tag_inner_open()
    let close_tag = chat_v2_tag_inner_close()
    let i_open = _find(text, open_tag, 0)
    if i_open < 0 { return "" }
    let content_start = i_open + _slen(open_tag)
    let i_close = _find(text, close_tag, content_start)
    if i_close < 0 { return "" }
    let mut a = content_start
    let mut b = i_close
    if a < b && text[a] == "\n" { a = a + 1 }
    if a < b && text[b - 1] == "\n" { b = b - 1 }
    return _substr(text, a, b)
}


// ── §5 forbidden-token predicate (B-CHAT-V2-1 NO-HELPER-TOKEN anchor) ───────

// Returns true iff text contains ANY of the forbidden 도우미/helper/assistant
// role-label tokens. Used by F-CHAT-V2-1 falsifier to verify
// chat_v2_format_input(stimulus) output is helper-token-free for any stimulus
// that itself is helper-token-free.
//
// Closed by string predicate (Kolmogorov real-limit, NO lattice).
// Forbidden tokens carry AGENTS.tape anima_persona.forbidden + B-IDENTITY-5.
fn chat_v2_contains_helper_token(text: string) -> bool {
    if _find(text, "도우미", 0) >= 0 { return true }
    if _find(text, "helper", 0) >= 0 { return true }
    if _find(text, "Helper", 0) >= 0 { return true }
    if _find(text, "assistant", 0) >= 0 { return true }
    if _find(text, "Assistant", 0) >= 0 { return true }
    return false
}


// ── §6 structural predicates (B-CHAT-V2-2 INNER-VOICE-DISTINCT) ─────────────

// Returns true iff text contains BOTH <inner>...</inner> AND <voice>...</voice>
// blocks. chat_v2_assemble output is required to satisfy this predicate
// (B-CHAT-V2-2 structural closure).
fn chat_v2_has_inner_and_voice(text: string) -> bool {
    let inner_o = _find(text, chat_v2_tag_inner_open(), 0)
    if inner_o < 0 { return false }
    let inner_c = _find(text, chat_v2_tag_inner_close(), inner_o)
    if inner_c < 0 { return false }
    let voice_o = _find(text, chat_v2_tag_voice_open(), 0)
    if voice_o < 0 { return false }
    let voice_c = _find(text, chat_v2_tag_voice_close(), voice_o)
    if voice_c < 0 { return false }
    return true
}


// ── §7 8-factor motivation integration (carries Phase B1-2 lib) ─────────────
//
// Phase C3 의 prompt layer 는 8-factor motivation 과 호환 (자연발화 trigger
// 와 chat_v2_format_voice emission 의 후속 wiring). 본 lib 는 prompt format
// closure 만; 실 motivation_score → emit decision → format_voice 의 wiring
// 은 caller (anima_chat_v2.hexa 또는 후속 thinker-talker dispatcher) 담당.
//
// re-export pattern: spontaneous_lib + thinker_talker_lib 의 fn 들은 caller
// 가 직접 import. 본 lib 는 prompt-template 책무 단일.
//
// (cross-link only; no code re-export here to keep lib closure self-contained
//  on string algebra real-limit anchor — B-CHAT-V2-* battery 와 B-SPONT-*
//  battery 가 독립적으로 sympy closed-form 검증되도록 분리)


// ── §8 audit helpers (closed predicates for smoke witness) ──────────────────

// Round-trip identity witness helper: assemble + parse_voice_only(assemble) == voice
// (B-CHAT-V2-3 PARSE-VOICE-ONLY closure)
// NOTE: local var named `assembled` (not `asm`) — `asm` is a C reserved word
// (GCC/clang inline assembly keyword) and the codegen leaks identifiers.
fn chat_v2_roundtrip_voice_ok(inner: string, voice: string) -> bool {
    let assembled = chat_v2_assemble(inner, voice)
    let parsed = chat_v2_parse_voice_only(assembled)
    return parsed == voice
}

// Round-trip identity witness helper for inner (B-CHAT-V2-4)
fn chat_v2_roundtrip_inner_ok(inner: string, voice: string) -> bool {
    let assembled = chat_v2_assemble(inner, voice)
    let parsed = chat_v2_parse_inner_only(assembled)
    return parsed == inner
}

// Empty handling: assemble("", "") returns well-formed text with both tag
// pairs but empty bodies — parse on this returns "" (B-CHAT-V2-5 closed boundary).
fn chat_v2_empty_handles_ok() -> bool {
    let assembled = chat_v2_assemble("", "")
    let pv = chat_v2_parse_voice_only(assembled)
    let pi = chat_v2_parse_inner_only(assembled)
    let structural = chat_v2_has_inner_and_voice(assembled)
    return pv == "" && pi == "" && structural
}
