// ════════════════════════════════════════════════════════════════════════
// HEXAD/CHAT/server/substrate_akida.hexa — WRAPPER doc-stub
//
//   substrate_akida.py is the SubstrateAKIDA(Substrate ABC) plugin for the
//   BrainChip AKD1000 neuromorphic-silicon path. __init__ probes
//   `import akida` + `akida.devices()`:
//     • HW path  → wraps spontaneous_emission.py on-chip threshold-and-fire
//                   (FullyConnected weights_bits=4 act_bits=1).  provenance="akida-hw"
//     • SW path  → akida_sw_lif numpy LIF fallback (seed=187).  provenance="akida-sw-fallback"
//
//   It hard-depends on akida (MetaTF SDK) / numpy / torch and subclasses the
//   Python Substrate ABC (substrate_base.py) — a pure-hexa reimplementation
//   is infeasible (akida SDK is Python-only). The .py is KEPT as the runnable
//   plugin, imported by anima_participant.py build_substrate("akida"), never
//   run standalone — this .hexa is the hexa-native WRAPPER marker.
// ════════════════════════════════════════════════════════════════════════

fn main() {
    println("substrate_akida.py — SubstrateAKIDA (AKD1000 HW + numpy-LIF SW fallback).")
    println("Imported by anima_participant.py build_substrate('akida'); not standalone.")
}
