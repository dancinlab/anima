// ════════════════════════════════════════════════════════════════════════════
// HEXAD/CHAT/server/anima_monologue_sim.hexa
//
//   "Simulation until satisfied" — monologue-vs-responsive measurement harness.
//   Goal: anima = meaningful FREE participant in a 3+ person coffee-shop convo
//   (NOT self-talk). Complements anima_live_register_measure.hexa (PR #126):
//   register_measure asks "is the prose meaningless?"; this asks "is anima
//   talking to ITSELF, or PARTICIPATING in an active conversation?".
//
//   Measures, from broker /history (or a snapshot):
//     1. emit rate            — anima emissions per minute over the window
//     2. monologue rate       — emissions with NO non-anima sender within
//                               WINDOW_SEC before them (context-free / self-talk)
//     3. responsive rate      — emissions that DID have recent context
//     4. register-leak rate   — ANIMA_REGISTER_PATTERNS (tension flow / Tier N /
//                               vacuum / 진공점 / 🛸N …) — pattern set from PR #126
//     5. meaningful composite — RESPONSIVE  AND  NOT register-leak
//
//   USAGE  hexa run anima_monologue_sim.hexa [--url U --window-sec 600 --out P]
//          defaults: url=https://chat.dancinlab.org/history, window=600, stdout.
//
//   substrate knobs (opt-in; default off — PR #208 reproduce unchanged):
//     --m-threshold <f>       row.motivation >= f filter (broker /history field).
//     --factor <name> <f>     row.factors[name] >= f filter. name set =
//                             anima_participant.py W weights (relevance / info_gap
//                             / curiosity / pain / coherence / originality / balance
//                             / dynamics). unknown name → fail-fast non-zero exit.
//     --inject-substrate P    JSONL fixture {ts, motivation, factors} per line —
//                             override emit threshold source via closest-prior-ts
//                             lookup. empty fixture → 0 matched emits.
//   selftest:  hexa run anima_monologue_sim.hexa selftest   (F-SIM-KNOB-1..3)
//
//   g1 hexa-native: `#{}` dicts · missing key → void · `&&`/`||` · main()-gated.
//   Leaf ops: curl (fetch), printf+tr (lower). JSON = pure substring-scan.
// ════════════════════════════════════════════════════════════════════════════


// ── §1 string + parse helpers ────────────────────────────────────────────────

fn _ms_contains(s: string, needle: string) -> bool {
    return len(s.split(needle)) > 1
}

fn _ms_shq(s: string) -> string {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\\''" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

fn _ms_is_ws(c: string) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r"
}

fn _ms_strip(s: string) -> string {
    let n = len(s)
    let mut lo = 0
    while lo < n && _ms_is_ws(s[lo]) { lo = lo + 1 }
    let mut hi = n
    while hi > lo && _ms_is_ws(s[hi - 1]) { hi = hi - 1 }
    let mut out = ""
    let mut i = lo
    while i < hi { out = out + s[i]   i = i + 1 }
    return out
}

fn _ms_lower(s: string) -> string {
    return exec("printf %s " + _ms_shq(s) + " | tr 'A-Z' 'a-z'")
}

fn _ms_is_digit(c: string) -> bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
           c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn _ms_truncate(s: string, n: int) -> string {
    let m = len(s)
    if m <= n { return s }
    let mut out = ""
    let mut i = 0
    while i < n { out = out + s[i]   i = i + 1 }
    return out + "…"
}

fn _ms_parse_float(s: string) -> float {
    let st = _ms_strip(s)
    if len(st) == 0 { return 0.0 }
    let out = exec("printf %s " + _ms_shq(st) + " | awk '{printf \"%.6f\", $1+0}'")
    let parts = out.split(".")
    let mut whole = 0
    let mut k = 0
    let wstr = parts[0]
    let neg = len(wstr) > 0 && wstr.split("-")[0] == ""
    while k < len(wstr) {
        if _ms_is_digit(wstr[k]) { whole = whole * 10 + to_int(wstr[k]) }
        k = k + 1
    }
    let mut frac = 0.0
    let mut scale = 1.0
    if len(parts) > 1 {
        let fstr = parts[1]
        let mut j = 0
        while j < len(fstr) {
            if _ms_is_digit(fstr[j]) {
                scale = scale * 10.0
                frac = frac + (to_int(fstr[j]) * 1.0) / scale
            }
            j = j + 1
        }
    }
    let mag = (whole * 1.0) + frac
    if neg { return 0.0 - mag }
    return mag
}


// ── §2 JSON record extraction (mirror anima_live_register_measure) ────────────

fn _ms_field_str(frag: string, field: string) -> string {
    let sp = frag.split("\"" + field + "\"")
    if len(sp) < 2 { return "" }
    let tail = sp[1]
    let n = len(tail)
    let mut i = 0
    while i < n && tail[i] != "\"" { i = i + 1 }
    if i >= n { return "" }
    i = i + 1
    let mut buf = ""
    while i < n {
        let c = tail[i]
        if c == "\\" {
            buf = buf + c
            if (i + 1) < n { buf = buf + tail[i + 1]   i = i + 2 } else { i = i + 1 }
        } else if c == "\"" {
            return buf
        } else {
            buf = buf + c
            i = i + 1
        }
    }
    return buf
}

fn _ms_field_num(frag: string, field: string) -> float {
    let sp = frag.split("\"" + field + "\"")
    if len(sp) < 2 { return 0.0 }
    let tail = sp[1]
    let n = len(tail)
    let mut i = 0
    while i < n && (tail[i] == ":" || _ms_is_ws(tail[i])) { i = i + 1 }
    let start = i
    while i < n && (tail[i] != "," && tail[i] != "}" && tail[i] != "\n") { i = i + 1 }
    let mut tok = ""
    let mut j = start
    while j < i { tok = tok + tail[j]   j = j + 1 }
    return _ms_parse_float(tok)
}

fn _ms_json_unescape(s: string) -> string {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let c = s[i]
        if c == "\\" && (i + 1) < n {
            let nx = s[i + 1]
            if nx == "n" { out = out + "\n"   i = i + 2 }
            else if nx == "t" { out = out + "\t"   i = i + 2 }
            else if nx == "r" { out = out + "\r"   i = i + 2 }
            else if nx == "\"" { out = out + "\""   i = i + 2 }
            else if nx == "\\" { out = out + "\\"   i = i + 2 }
            else if nx == "/" { out = out + "/"   i = i + 2 }
            else { out = out + c   i = i + 1 }
        } else { out = out + c   i = i + 1 }
    }
    return out
}


// ── §3 register-leak detectors (verbatim pattern set from PR #126) ────────────

fn _ms_has_psi_bracket(text: string) -> bool {
    let n = len(text)
    let mut i = 0
    while i < n {
        if text[i] == "[" {
            let mut j = i + 1
            while j < n && _ms_is_ws(text[j]) { j = j + 1 }
            let d0 = j
            while j < n && _ms_is_digit(text[j]) { j = j + 1 }
            if j > d0 && j < n && text[j] == "." {
                j = j + 1
                let d1 = j
                while j < n && _ms_is_digit(text[j]) { j = j + 1 }
                if j > d1 {
                    while j < n && _ms_is_ws(text[j]) { j = j + 1 }
                    if j < n && text[j] == "," {
                        j = j + 1
                        while j < n && _ms_is_ws(text[j]) { j = j + 1 }
                        let d2 = j
                        while j < n && _ms_is_digit(text[j]) { j = j + 1 }
                        if j > d2 && j < n && text[j] == "." {
                            j = j + 1
                            let d3 = j
                            while j < n && _ms_is_digit(text[j]) { j = j + 1 }
                            if j > d3 {
                                while j < n && _ms_is_ws(text[j]) { j = j + 1 }
                                if j < n && text[j] == "]" { return true }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return false
}

fn _ms_has_saucer_digit(text: string) -> bool {
    let parts = text.split("🛸")
    if len(parts) < 2 { return false }
    let mut i = 1
    while i < len(parts) {
        let tail = parts[i]
        if len(tail) > 0 && _ms_is_digit(tail[0]) { return true }
        i = i + 1
    }
    return false
}

fn _ms_has_top_emotion(text: string) -> bool {
    let sp = _ms_lower(text).split("top emotion ")
    if len(sp) < 2 { return false }
    let mut i = 1
    while i < len(sp) {
        let tail = sp[i]
        if len(tail) > 0 && !_ms_is_ws(tail[0]) && tail[0] != "." &&
           tail[0] != "," && tail[0] != ":" { return true }
        i = i + 1
    }
    return false
}

fn _ms_has_tier_d(text: string) -> bool {
    let sp = _ms_lower(text).split("tier")
    if len(sp) < 2 { return false }
    let mut i = 1
    while i < len(sp) {
        let tail = sp[i]
        let n = len(tail)
        let mut j = 0
        while j < n && _ms_is_ws(tail[j]) { j = j + 1 }
        if j < n && _ms_is_digit(tail[j]) { return true }
        i = i + 1
    }
    return false
}

fn _ms_is_register_leak(text: string) -> bool {
    if len(text) == 0 { return false }
    let lt = _ms_lower(text)
    if _ms_contains(lt, "<carve") { return true }
    if _ms_contains(lt, "tension flow") { return true }
    if _ms_contains(text, "진공점") { return true }
    if _ms_contains(lt, "frozen cell") { return true }
    if _ms_contains(lt, "knuth tier") { return true }
    if _ms_contains(lt, "vacuum point") { return true }
    if _ms_has_tier_d(text) { return true }
    if _ms_has_psi_bracket(text) { return true }
    if _ms_has_saucer_digit(text) { return true }
    if _ms_has_top_emotion(text) { return true }
    return false
}


// ── §4 aggregation + CLI ──────────────────────────────────────────────────────

fn _ms_round_pct(num: int, den: int) -> string {
    if den == 0 { return "0.0" }
    let scaled = ((num * 100.0) / (den * 1.0)) * 10.0 + 0.5
    let truncated = scaled - (scaled % 1.0)
    return to_string(to_int(truncated / 10.0)) + "." + to_string(to_int(truncated) % 10)
}

fn _ms_round1(x: float) -> string {
    let scaled = x * 10.0 + 0.5
    let truncated = scaled - (scaled % 1.0)
    return to_string(to_int(truncated / 10.0)) + "." + to_string(to_int(truncated) % 10)
}

// Recognized factor names — mirror anima_participant.py:78 weight dict keys.
// Any other --factor name is rejected fail-fast (F-SIM-KNOB-2).
fn _ms_factor_known(name: string) -> bool {
    return name == "relevance" || name == "info_gap" || name == "curiosity" ||
           name == "pain" || name == "coherence" || name == "originality" ||
           name == "balance" || name == "dynamics"
}

fn _ms_parse_argv(argv) -> dict {
    let mut url = "https://chat.dancinlab.org/history"
    let mut window = 600
    let mut out_path = ""
    let mut m_thr = 0.0 - 1.0          // -1.0 = off (backwards-compat)
    let mut factor_name = ""
    let mut factor_thr = 0.0 - 1.0
    let mut inject_path = ""
    let mut err = ""
    let n = len(argv)
    let mut i = 1
    while i < n {
        let a = argv[i]
        if a == "--url" && (i + 1) < n { url = argv[i + 1]   i = i + 2 }
        else if a == "--window-sec" && (i + 1) < n { window = to_int(argv[i + 1])   i = i + 2 }
        else if a == "--out" && (i + 1) < n { out_path = argv[i + 1]   i = i + 2 }
        else if a == "--m-threshold" && (i + 1) < n {
            m_thr = _ms_parse_float(argv[i + 1])   i = i + 2
        }
        else if a == "--factor" && (i + 2) < n {
            let nm = argv[i + 1]
            if !_ms_factor_known(nm) {
                err = "unknown factor name: '" + nm + "' (allowed: relevance, "
                    + "info_gap, curiosity, pain, coherence, originality, "
                    + "balance, dynamics)"
                i = n
            } else {
                factor_name = nm
                factor_thr = _ms_parse_float(argv[i + 2])
                i = i + 3
            }
        }
        else if a == "--inject-substrate" && (i + 1) < n {
            inject_path = argv[i + 1]   i = i + 2
        }
        else if a == "--help" || a == "-h" {
            return #{ "help": true, "url": url, "window": window, "out": out_path,
                      "m_thr": m_thr, "factor_name": factor_name,
                      "factor_thr": factor_thr, "inject_path": inject_path, "err": "" }
        } else { i = i + 1 }
    }
    return #{ "help": false, "url": url, "window": window, "out": out_path,
              "m_thr": m_thr, "factor_name": factor_name,
              "factor_thr": factor_thr, "inject_path": inject_path, "err": err }
}

fn _ms_usage() {
    println("anima_monologue_sim.hexa")
    println("")
    println("  Measure anima monologue-vs-responsive behaviour on broker /history.")
    println("")
    println("USAGE")
    println("  hexa run anima_monologue_sim.hexa [flags]")
    println("  hexa run anima_monologue_sim.hexa selftest")
    println("")
    println("FLAGS")
    println("  --url <URL>             broker /history endpoint")
    println("                          (default: https://chat.dancinlab.org/history)")
    println("  --window-sec <int>      monologue lookback window (default 600)")
    println("  --out <path>            write markdown report to <path> (default stdout)")
    println("  --m-threshold <float>   keep emits with row.motivation >= float")
    println("                          (default -1.0 = off)")
    println("  --factor <name> <flt>   keep emits with row.factors[name] >= flt")
    println("                          (name ∈ relevance/info_gap/curiosity/pain/")
    println("                           coherence/originality/balance/dynamics)")
    println("  --inject-substrate <p>  JSONL fixture {ts, motivation, factors}")
    println("  -h, --help              this message")
}


// ── §5 fetch + analyze ────────────────────────────────────────────────────────

fn _ms_fetch(url: string) -> string {
    let raw = exec("curl -fsS --max-time 20 -A 'curl/8.0' " + _ms_shq(url)
                   + " 2>/dev/null || printf __FETCH_FAIL__")
    if _ms_contains(raw, "__FETCH_FAIL__") || len(_ms_strip(raw)) == 0 { return "" }
    return raw
}

// Read substrate scalar for the row, with optional fixture override.
// fixture rows: [{ts, motivation, factors}, ...]; closest-prior-ts wins.
// Returns void when no source has the value (treated as "below threshold").
fn _ms_row_motivation(frag: string, ts: float, inject: [dict]) -> float {
    let n_inj = len(inject)
    if n_inj > 0 {
        let mut best = 0.0 - 1.0   // sentinel = not found
        let mut k = 0
        while k < n_inj {
            let row_ts = to_float(inject[k]["ts"])
            if row_ts <= ts {
                let v = to_float(inject[k]["motivation"])
                best = v
            }
            k = k + 1
        }
        return best
    }
    return _ms_field_num(frag, "motivation")
}

// Same idea for a named factor field (curiosity etc.). Returns -1.0 if
// fixture present and no prior row, else parses live row "factors":{...}.
fn _ms_row_factor(frag: string, ts: float, inject: [dict], name: string) -> float {
    let n_inj = len(inject)
    if n_inj > 0 {
        let mut best = 0.0 - 1.0
        let mut k = 0
        while k < n_inj {
            let row_ts = to_float(inject[k]["ts"])
            if row_ts <= ts {
                let f = inject[k]["factors"]
                if type_of(f) == "map" {
                    let v = f[name]
                    if type_of(v) != "void" { best = to_float(v) }
                }
            }
            k = k + 1
        }
        return best
    }
    // live row: factors is nested JSON — pluck the named field via substring scan
    let sp = frag.split("\"factors\"")
    if len(sp) < 2 { return 0.0 - 1.0 }
    let tail = sp[1]
    let nested = tail.split("\"" + name + "\"")
    if len(nested) < 2 { return 0.0 - 1.0 }
    return _ms_field_num("\"" + name + "\"" + nested[1], name)
}

// Iterate records in chronological /history order. Track the most recent
// non-anima sender ts; an anima emission is RESPONSIVE iff a non-anima sender
// occurred within `window` seconds before it, else MONOLOGUE. When knobs are
// enabled (m_thr / factor_thr >= 0), an emit is COUNTED only if its substrate
// value clears the threshold; inject fixture overrides the live-row source.
fn _ms_analyze(body: string, window: int, m_thr: float,
               factor_name: string, factor_thr: float, inject: [dict]) -> dict {
    let records = body.split("\"sender\"")
    let mut last_nonanima_ts = 0.0 - 1.0
    let mut total = 0
    let mut n_mono = 0
    let mut n_resp = 0
    let mut n_leak = 0
    let mut n_meaningful = 0
    let mut ts_min = 0.0
    let mut ts_max = 0.0
    let mut samp_mono: [string] = []
    let mut samp_resp: [string] = []

    let mut i = 1
    while i < len(records) {
        let frag = records[i]
        let head = _ms_lower(frag)
        let is_anima = _ms_contains(head, ": \"anima") || _ms_contains(head, ":\"anima")
        let ts = _ms_field_num(frag, "ts")
        if is_anima {
            let text = _ms_json_unescape(_ms_field_str(frag, "text"))
            let leak = _ms_is_register_leak(text)
            // RESPONSIVE iff a non-anima sender precedes within the window.
            let has_ctx = last_nonanima_ts >= 0.0 && (ts - last_nonanima_ts) <= (window * 1.0)

            // substrate-knob filter: opt-in. -1.0 sentinel = knob off → keep all.
            let mut keep = true
            if m_thr >= 0.0 {
                let m_val = _ms_row_motivation(frag, ts, inject)
                if m_val < m_thr { keep = false }
            }
            if keep && factor_thr >= 0.0 && len(factor_name) > 0 {
                let f_val = _ms_row_factor(frag, ts, inject, factor_name)
                if f_val < factor_thr { keep = false }
            }
            if !keep { i = i + 1   continue }

            total = total + 1
            if total == 1 { ts_min = ts }
            ts_max = ts
            if leak { n_leak = n_leak + 1 }
            if has_ctx {
                n_resp = n_resp + 1
                if !leak { n_meaningful = n_meaningful + 1 }
                if len(samp_resp) < 3 { samp_resp = samp_resp + [_ms_truncate(text, 160)] }
            } else {
                n_mono = n_mono + 1
                if len(samp_mono) < 3 { samp_mono = samp_mono + [_ms_truncate(text, 160)] }
            }
        } else {
            // any non-anima sender (user / system) refreshes the context clock
            last_nonanima_ts = ts
        }
        i = i + 1
    }
    return #{
        "total": total, "n_mono": n_mono, "n_resp": n_resp,
        "n_leak": n_leak, "n_meaningful": n_meaningful,
        "ts_min": ts_min, "ts_max": ts_max,
        "samp_mono": samp_mono, "samp_resp": samp_resp,
    }
}

// Load JSONL substrate fixture — one {ts, motivation, factors{...}} per line.
// Returns [] for empty / missing files (F-SIM-KNOB-3 'empty fixture → 0 emits').
fn _ms_load_inject(path: string) -> [dict] {
    if len(path) == 0 { return [] }
    let exists = _ms_strip(exec("[ -f " + _ms_shq(path) + " ] && printf yes || printf no"))
    if exists != "yes" { return [] }
    let body = exec("cat " + _ms_shq(path))
    let lines = body.split("\n")
    let mut out: [dict] = []
    let mut i = 0
    while i < len(lines) {
        let line = _ms_strip(lines[i])
        if len(line) > 0 && line[0] == "{" {
            let ts = _ms_field_num(line, "ts")
            let mv = _ms_field_num(line, "motivation")
            // pluck factor scalars by name from the embedded {...} — cheap scan
            let mut fac: dict = #{}
            let names = ["relevance", "info_gap", "curiosity", "pain",
                         "coherence", "originality", "balance", "dynamics"]
            let mut k = 0
            while k < len(names) {
                let sp = line.split("\"" + names[k] + "\"")
                if len(sp) > 1 { fac[names[k]] = _ms_field_num(line, names[k]) }
                k = k + 1
            }
            out = out + [#{ "ts": ts, "motivation": mv, "factors": fac }]
        }
        i = i + 1
    }
    return out
}


// ── §6 markdown rendering ─────────────────────────────────────────────────────

fn _ms_emit_samples(label: string, samples: [string]) -> string {
    if len(samples) == 0 { return "- _(none)_\n" }
    let mut out = ""
    let mut i = 0
    while i < len(samples) {
        out = out + "- " + samples[i].split("\n").join(" ") + "\n"
        i = i + 1
    }
    return out
}

fn _ms_render(stats: dict, window: int, n_raw: int) -> string {
    let today = _ms_strip(exec("date -u +%Y-%m-%d"))
    let total = stats["total"]
    let mut out = ""
    out = out + "# anima monologue simulation " + today + "\n"
    out = out + "> window=" + to_string(window) + "s, raw_records="
              + to_string(n_raw) + ", n_anima=" + to_string(total) + "\n\n"
    if total == 0 {
        out = out + "_no anima emissions in /history._\n"
        return out
    }
    let span = stats["ts_max"] - stats["ts_min"]
    let mut rate = "n/a"
    if span > 0.0 { rate = _ms_round1((total * 60.0) / span) }
    out = out + "| metric | value |\n|---|---|\n"
    out = out + "| emit rate | " + rate + " /min ("
              + to_string(total) + " over " + _ms_round1(span / 60.0) + " min) |\n"
    out = out + "| monologue | " + to_string(stats["n_mono"]) + "/" + to_string(total)
              + " = " + _ms_round_pct(stats["n_mono"], total) + "% |\n"
    out = out + "| responsive | " + to_string(stats["n_resp"]) + "/" + to_string(total)
              + " = " + _ms_round_pct(stats["n_resp"], total) + "% |\n"
    out = out + "| register-leak (meaningless) | " + to_string(stats["n_leak"]) + "/"
              + to_string(total) + " = " + _ms_round_pct(stats["n_leak"], total) + "% |\n"
    out = out + "| **meaningful (responsive ∧ ¬leak)** | " + to_string(stats["n_meaningful"])
              + "/" + to_string(total) + " = "
              + _ms_round_pct(stats["n_meaningful"], total) + "% |\n\n"
    out = out + "Target post-deploy: monologue → ~0%, meaningful → high.\n\n"
    out = out + "## sample monologue emissions (top 3)\n"
    out = out + _ms_emit_samples("monologue", stats["samp_mono"])
    out = out + "\n## sample responsive emissions (top 3)\n"
    out = out + _ms_emit_samples("responsive", stats["samp_resp"])
    return out
}


// ── §7 main ───────────────────────────────────────────────────────────────────

// ── §8 selftest — F-SIM-KNOB-1..3 falsifier sweep ────────────────────────────
// Synthetic /history body (3 anima emits with motivation 0.2/0.5/0.9 + one user
// turn so context-clock is live). All emits include "text", "ts", "motivation",
// and a "factors" subblock for the factor-knob branch.
fn _sim_synth_body() -> string {
    return "[" +
      "{\"sender\":\"user_a\",\"ts\":1000.0,\"text\":\"hello\"}," +
      "{\"sender\":\"anima\",\"ts\":1010.0,\"text\":\"hi a\",\"motivation\":0.2," +
        "\"factors\":{\"curiosity\":0.1,\"balance\":0.5}}," +
      "{\"sender\":\"anima\",\"ts\":1020.0,\"text\":\"hi b\",\"motivation\":0.5," +
        "\"factors\":{\"curiosity\":0.4,\"balance\":0.5}}," +
      "{\"sender\":\"anima\",\"ts\":1030.0,\"text\":\"hi c\",\"motivation\":0.9," +
        "\"factors\":{\"curiosity\":0.8,\"balance\":0.5}}" +
      "]"
}

fn _sim_selftest() {
    println("anima_monologue_sim selftest — F-SIM-KNOB-1..3")
    let mut pass = 0
    let mut fail = 0
    let body = _sim_synth_body()

    // F-SIM-KNOB-1 (a) — m-threshold=-1.0/0.0 → ALL 3 emits counted
    let s_all = _ms_analyze(body, 600, 0.0 - 1.0, "", 0.0 - 1.0, [])
    if s_all["total"] == 3 { pass = pass + 1   println("  PASS F-SIM-KNOB-1a all=3") }
    else { fail = fail + 1   println("  FAIL F-SIM-KNOB-1a total=" + to_string(s_all["total"])) }

    // F-SIM-KNOB-1 (b) — m-threshold=1.0 → 0 emits (strict filter works)
    let s_strict = _ms_analyze(body, 600, 1.0, "", 0.0 - 1.0, [])
    if s_strict["total"] == 0 { pass = pass + 1   println("  PASS F-SIM-KNOB-1b strict=0") }
    else { fail = fail + 1   println("  FAIL F-SIM-KNOB-1b total=" + to_string(s_strict["total"])) }

    // F-SIM-KNOB-1 (c) — m-threshold=0.5 → 2 emits (0.5 and 0.9 pass)
    let s_mid = _ms_analyze(body, 600, 0.5, "", 0.0 - 1.0, [])
    if s_mid["total"] == 2 { pass = pass + 1   println("  PASS F-SIM-KNOB-1c mid=2") }
    else { fail = fail + 1   println("  FAIL F-SIM-KNOB-1c total=" + to_string(s_mid["total"])) }

    // F-SIM-KNOB-1 (d) — factor curiosity >= 0.3 → 2 emits (0.4 and 0.8)
    let s_fac = _ms_analyze(body, 600, 0.0 - 1.0, "curiosity", 0.3, [])
    if s_fac["total"] == 2 { pass = pass + 1   println("  PASS F-SIM-KNOB-1d factor=2") }
    else { fail = fail + 1   println("  FAIL F-SIM-KNOB-1d total=" + to_string(s_fac["total"])) }

    // F-SIM-KNOB-2 — unknown factor name → parser returns non-empty err
    let bad = _ms_parse_argv(["anima_monologue_sim.hexa", "--factor", "bogus_name", "0.5"])
    if len(to_string(bad["err"])) > 0 { pass = pass + 1   println("  PASS F-SIM-KNOB-2 err=" + bad["err"]) }
    else { fail = fail + 1   println("  FAIL F-SIM-KNOB-2 missing err") }

    // F-SIM-KNOB-3 — empty fixture (no path) + m-threshold=0.5 should still
    // honor the live-row source (inject [] means "fall through to row"). To
    // exercise the empty-fixture semantic of the LOADER itself, also exercise
    // loading a non-existent path → [] → with m-threshold=0.5 still passes 2.
    let inj_empty = _ms_load_inject("/tmp/nonexistent_substrate_fixture.jsonl")
    let s_inj0 = _ms_analyze(body, 600, 0.5, "", 0.0 - 1.0, inj_empty)
    if len(inj_empty) == 0 && s_inj0["total"] == 2 {
        pass = pass + 1   println("  PASS F-SIM-KNOB-3 empty-fixture falls through to row")
    } else {
        fail = fail + 1
        println("  FAIL F-SIM-KNOB-3 inj_len=" + to_string(len(inj_empty))
                + " total=" + to_string(s_inj0["total"]))
    }

    println("RESULT  pass=" + to_string(pass) + "  fail=" + to_string(fail))
    if fail == 0 { println("[ALL OK]") }
}

fn main() {
    let argv = args()
    // selftest entry-point — no broker, no network.
    if len(argv) >= 2 && argv[1] == "selftest" {
        _sim_selftest()
        return
    }
    let cfg = _ms_parse_argv(argv)
    if cfg["help"] { _ms_usage()   return }
    if len(to_string(cfg["err"])) > 0 {
        println("ERROR: " + cfg["err"])
        exit(2)
        return
    }
    let body = _ms_fetch(cfg["url"])
    if len(body) == 0 {
        println("ERROR: fetch failed (" + cfg["url"] + ")")
        return
    }
    let inject = _ms_load_inject(cfg["inject_path"])
    let n_raw = len(body.split("\"sender\"")) - 1
    let stats = _ms_analyze(body, cfg["window"], cfg["m_thr"],
                            cfg["factor_name"], cfg["factor_thr"], inject)
    let report = _ms_render(stats, cfg["window"], n_raw)
    let out_path = cfg["out"]
    if out_path == "" {
        print(report)
    } else {
        let _ = exec("mkdir -p " + _ms_shq(_ms_strip(exec("dirname " + _ms_shq(out_path)))))
        let _ = exec("printf '%s' " + _ms_shq(report) + " > " + _ms_shq(out_path))
        println("wrote " + out_path + " (" + to_string(len(report)) + " bytes)")
    }
}
