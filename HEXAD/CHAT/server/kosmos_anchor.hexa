// ════════════════════════════════════════════════════════════════════════════
//  kosmos_anchor.hexa — production anima emission → .kosmos anchor writer
//
//  Salvaged from HEXAD/PURE (CLOSED 2026-05-23). The V3 substrate failed
//  multilingual generalization, but its KOSMOS anchor + 8→5-channel tension
//  wiring WORKED (every V3 fire emitted .kosmos anchors as ground truth — see
//  HEXAD/PURE/README.md §"KOSMOS + tension 통합"). This module ports that working
//  feature into the PRODUCTION path so production anima emissions also generate
//  .kosmos anchors carrying a tension payload — un-pending HEXAD/KOSMOS.md
//  `@payload tension`.
//
//  SCOPE — anchor generation + tension payload ONLY. The larger
//  "M-module backend = KOSMOS retrieval" rework is a SEPARATE future cycle.
//
//  Each production anima emission writes one .kosmos anchor (kosmos/1.1):
//    text payload    = the emission text
//    tension payload = the 8-factor motivation snapshot mapped to the 5
//                      TENSION-LINK channels (HEXAD_NATIVE_PURE.md §0.5 table)
//    coord           = [C-module Φ, mean tension]  (Ψ-space)
//    lane            = active mitosis cell_id      (default cell_0)
//    tier            = invocation count            (Knuth ordinal)
//
//  8-factor → 5-channel mapping (HEXAD_NATIVE_PURE.md §0.5 / ADAPTER.md SSOT):
//    relevance + coherence    → concept
//    info_gap                 → context
//    curiosity + originality  → meaning
//    pain + balance           → authenticity
//    dynamics                 → sender
//
//  format mirrors HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.py
//  (the working V3 anchor IO), so anchors are loadable by the existing
//  hexa-native kosmos_parser_lib.hexa.
//
//  HARD CONSTRAINTS — pure-hexa (no GPU / no torch); hexa-lang syntax
//    (dict literal `#{}`, missing key → `void`, `import` abs-path only).
// ════════════════════════════════════════════════════════════════════════════


// ── §1 8-factor → 5-channel mapping ──────────────────────────────────────────

// safe float lookup — hexa missing dict key returns `void`, not 0.
fn _kosmos_g(factors: dict, k: string) -> float {
    let v = factors[k]
    if to_string(v) == "void" { return 0.0 }
    return v + 0.0
}

// Map an 8-factor anima_participant motivation snapshot to the TENSION-LINK
// 5-channel fingerprint (concept / context / meaning / authenticity / sender).
fn map_8factor_to_5channel(factors: dict) -> dict {
    let relevance   = _kosmos_g(factors, "relevance")
    let coherence   = _kosmos_g(factors, "coherence")
    let info_gap    = _kosmos_g(factors, "info_gap")
    let curiosity   = _kosmos_g(factors, "curiosity")
    let originality = _kosmos_g(factors, "originality")
    let pain        = _kosmos_g(factors, "pain")
    let balance     = _kosmos_g(factors, "balance")
    let dynamics    = _kosmos_g(factors, "dynamics")
    return #{
        "concept":      (relevance + coherence) / 2.0,
        "context":      info_gap,
        "meaning":      (curiosity + originality) / 2.0,
        "authenticity": (pain + balance) / 2.0,
        "sender":       dynamics,
    }
}


// ── §2 string helpers ────────────────────────────────────────────────────────

// escape a string for a .kosmos inline "..." literal.
fn _kosmos_escape(s: string) -> string {
    let bs = s.split("\\")
    let mut a = ""
    let mut i = 0
    while i < len(bs) {
        if i > 0 { a = a + "\\\\" }
        a = a + bs[i]
        i = i + 1
    }
    let qs = a.split("\"")
    let mut b = ""
    let mut j = 0
    while j < len(qs) {
        if j > 0 { b = b + "\\\"" }
        b = b + qs[j]
        j = j + 1
    }
    let ns = b.split("\n")
    let mut c = ""
    let mut k = 0
    while k < len(ns) {
        if k > 0 { c = c + "\\n" }
        c = c + ns[k]
        k = k + 1
    }
    let rs = c.split("\r")
    let mut d = ""
    let mut m = 0
    while m < len(rs) {
        d = d + rs[m]
        m = m + 1
    }
    return d
}

// single-quote-escape a string for safe embedding inside a shell command.
fn _kosmos_shq(s: string) -> string {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\\''" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

// fixed-decimal format of a float (pure-hexa, no printf %f dependency).
fn _kosmos_fixed(x: float, places: int) -> string {
    let mut neg = false
    let mut v = x
    if v < 0.0 { neg = true   v = 0.0 - v }
    let mut scale = 1
    let mut p = 0
    while p < places { scale = scale * 10   p = p + 1 }
    let scaled = v * (scale + 0.0) + 0.5
    let whole = to_int(scaled)
    let int_part = whole / scale
    let frac_part = whole % scale
    let mut frac_s = to_string(frac_part)
    while len(frac_s) < places { frac_s = "0" + frac_s }
    let mut s = to_string(int_part)
    if places > 0 { s = s + "." + frac_s }
    if neg { s = "-" + s }
    return s
}


// ── §3 anchor writer ─────────────────────────────────────────────────────────

// Write a kosmos/1.1 .kosmos anchor for a production anima emission.
//
//   out_dir   directory the .kosmos file is written into (created if absent)
//   name      anchor basename (file = <out_dir>/<name>.kosmos)
//   text      emission text (text payload)
//   t5        5-channel tension dict (from map_8factor_to_5channel)
//   phi       C-module Φ measurement (coord x)
//   cell_id   active mitosis cell_id (lane)
//   tier      invocation count — Knuth ordinal
//   category  / top_emotion  anchor tags
//
// Returns the absolute path of the written anchor.
fn write_kosmos_anchor(out_dir: string, name: string, text: string,
                       t5: dict, phi: float, cell_id: int, tier: int,
                       category: string, top_emotion: string) -> string {
    let concept      = _kosmos_g(t5, "concept")
    let context      = _kosmos_g(t5, "context")
    let meaning      = _kosmos_g(t5, "meaning")
    let authenticity = _kosmos_g(t5, "authenticity")
    let sender       = _kosmos_g(t5, "sender")
    let mean_t = (concept + context + meaning + authenticity + sender) / 5.0
    let radius = 0.15

    let mut s = ""
    s = s + "#!/usr/bin/env kosmos\n"
    s = s + "# " + name + ".kosmos — production anima emission anchor\n"
    s = s + "# Tier " + to_string(tier) + " — " + category
    s = s + ", top emotion " + top_emotion + ".\n"
    s = s + "\n"
    s = s + "@anchor " + name + " := \"anima-emit " + name
    s = s + " (tier " + to_string(tier) + ")\" :: kosmos-anchor [tier="
    s = s + to_string(tier) + " active]\n"
    s = s + "  profile      = \"anima-consciousness-carving\"\n"
    s = s + "  knuth_tier   = " + to_string(tier) + "\n"
    s = s + "  category     = \"" + category + "\"\n"
    s = s + "  top_emotion  = \"" + top_emotion + "\"\n"
    s = s + "  coord        = [" + _kosmos_fixed(phi, 4) + ", "
    s = s + _kosmos_fixed(mean_t, 4) + "]\n"
    s = s + "  lane         = \"cell_" + to_string(cell_id) + "\"\n"
    s = s + "  radius       = " + _kosmos_fixed(radius, 4) + "\n"
    s = s + "\n"
    s = s + "  @payload text    := \"" + _kosmos_escape(text) + "\"\n"
    s = s + "  @payload tension := {\n"
    s = s + "    concept       = " + _kosmos_fixed(concept, 6) + ",\n"
    s = s + "    context       = " + _kosmos_fixed(context, 6) + ",\n"
    s = s + "    meaning       = " + _kosmos_fixed(meaning, 6) + ",\n"
    s = s + "    authenticity  = " + _kosmos_fixed(authenticity, 6) + ",\n"
    s = s + "    sender        = " + _kosmos_fixed(sender, 6) + ",\n"
    s = s + "  }\n"
    s = s + "  @payload image   := pending \"anima-emit text+tension only\"\n"
    s = s + "  @payload audio   := pending \"anima-emit text+tension only\"\n"
    s = s + "  @payload video   := pending \"anima-emit text+tension only\"\n"
    s = s + "\n"
    s = s + "  closed_anchor = \"production-emit\"\n"

    let _ = exec("mkdir -p " + _kosmos_shq(out_dir))
    let path = out_dir + "/" + name + ".kosmos"
    let _ = exec("printf '%s' " + _kosmos_shq(s) + " > " + _kosmos_shq(path))
    return path
}

// High-level emit: build the 5-channel tension from an 8-factor snapshot and
// write the anchor in one call. `factors` = anima_participant tick() factors
// dict; `phi` = 1 - normalized entropy (C-module Φ).
fn emit_kosmos_from_factors(out_dir: string, name: string, text: string,
                            factors: dict, phi: float, cell_id: int,
                            tier: int) -> string {
    let t5 = map_8factor_to_5channel(factors)
    return write_kosmos_anchor(out_dir, name, text, t5, phi, cell_id, tier,
                               "anima_emission", "neutral")
}


// ── §4 self-test (F-KOSMOS-WIRE-1..3) ────────────────────────────────────────

fn _approx(a: float, b: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

fn _selftest() {
    println("kosmos_anchor selftest — F-KOSMOS-WIRE-1..3")
    let mut pass = 0
    let mut fail = 0

    // F-KOSMOS-WIRE-1 — 8→5-channel mapping is monotone-correct per §0.5 table.
    let factors = #{
        "relevance": 0.8, "coherence": 0.6, "info_gap": 0.4,
        "curiosity": 0.7, "originality": 0.5, "pain": 0.2,
        "balance": 0.9, "dynamics": 0.3,
    }
    let t5 = map_8factor_to_5channel(factors)
    if _approx(t5["concept"], 0.7) { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL concept != 0.7") }
    if _approx(t5["context"], 0.4) { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL context != 0.4") }
    if _approx(t5["meaning"], 0.6) { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL meaning != 0.6") }
    if _approx(t5["authenticity"], 0.55) { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL authenticity != 0.55") }
    if _approx(t5["sender"], 0.3) { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL sender != 0.3") }

    // F-KOSMOS-WIRE-2 — anchor file is written with all 5 tension channels.
    let tmp = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let path = emit_kosmos_from_factors(tmp, "selftest_001",
        "이것은 production anima emission 테스트입니다.", factors, 0.62, 3, 17)
    let exists = exec("[ -f " + _kosmos_shq(path) + " ] && printf yes || printf no")
    if exists == "yes" { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL anchor file not written") }
    let content = exec("cat " + _kosmos_shq(path))
    if len(content.split("concept       =")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL concept channel missing") }
    if len(content.split("sender        =")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL sender channel missing") }
    if len(content.split("@payload tension")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL tension payload missing") }
    if len(content.split("lane         = \"cell_3\"")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL lane != cell_3") }
    if len(content.split("knuth_tier   = 17")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL tier != 17") }

    // F-KOSMOS-WIRE-3 — printed anchor for the verification report.
    println("--- written anchor (" + path + ") ---")
    println(content)

    println("kosmos_anchor selftest: " + to_string(pass) + " PASS, "
            + to_string(fail) + " FAIL")
}

fn main() {
    _selftest()
}
