// ════════════════════════════════════════════════════════════════════════════
//  kosmos_emitter.hexa — production KOSMOS anchor emitter daemon
//
//  Activates HEXAD/CHAT/server/kosmos_anchor.hexa (PR #116) on LIVE production
//  anima emissions WITHOUT touching any .py. The production participant
//  `anima_participant.py` is torch/transformers/peft-bound and FROZEN — the
//  hexa-native guard forbids ALL .py edits. So this daemon is a separate,
//  read-only side-process: it observes anima's emissions via the broker and
//  writes one .kosmos anchor per emission.
//
//  THE SEAM
//    anima_participant.py emits, on each self-tick decided-emit, a broker WS
//    msg `{"type":"msg","text":...,"lang":...,"motivation":...,"factors":{8}}`.
//    The broker (broker.py `/ws/anima` handler) tags it `kind:"anima"`,
//    assigns a unique `id`, and appends it to STATE.history (last 50 turns,
//    served at `GET /history` as `{"history":[...]}`).
//
//    The proper hexa-native streaming seam would be a WS client subscribed to
//    `/ws` — but stdlib/websocket.hexa's STREAMING client (ws_connect/ws_recv)
//    is websocat-only, and websocat is not installed on the deploy host (only
//    the python3 one-shot fallback exists, which cannot hold a stream open).
//    So this daemon uses the AUTHORIZED fallback seam: poll `GET /history`,
//    filter `kind == "anima"`, dedup by the broker-assigned `id` (a seen-set),
//    and emit a .kosmos anchor for each NEW anima message. History replay is
//    handled for free — the seen-set is seeded from the FIRST poll so anchors
//    are written ONLY for emissions observed AFTER daemon start (live-only).
//
//  8-factor → 5-channel tension mapping + anchor write = kosmos_anchor.hexa.
//  This file is JUST the live-wiring loop.
//
//  USAGE   hexa run kosmos_emitter.hexa  [once]
//    once  — single poll cycle then exit (smoke / cron mode).
//    (no arg) — daemon loop: poll every KOSMOS_POLL_SEC, forever.
//
//  ENV
//    ANIMA_BROKER_URL  — same var anima_participant.py reads. Its default is
//                        a WS url `ws://127.0.0.1:8000/ws/anima`; this daemon
//                        needs the HTTP origin, so it strips `ws[s]://` →
//                        `http[s]://` and the `/ws*` path → `/history`.
//                        Override directly with KOSMOS_HISTORY_URL.
//    KOSMOS_HISTORY_URL — explicit `GET /history` url (overrides derivation).
//    KOSMOS_ANCHOR_DIR  — anchor output dir. Default
//                        HEXAD/UNIVERSE-BRAIN-MAP/anchors (KOSMOS.md SSOT).
//    KOSMOS_POLL_SEC    — daemon poll interval seconds (default 5).
//
//  HARD CONSTRAINTS — pure-hexa (no torch / no .py edit); hexa-lang syntax
//    (dict literal `#{}`, missing key → `void`, `import` abs-path only).
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/CHAT/server/kosmos_anchor.hexa"
use "stdlib/net/http_client"


// ── §1 config derivation ─────────────────────────────────────────────────────

// _ke_env — env var with a fallback default.
fn _ke_env(name: string, fallback: string) -> string {
    let v = env(name)
    if to_string(v) == "void" { return fallback }
    if len(to_string(v)) == 0 { return fallback }
    return to_string(v)
}

// _ke_replace_prefix — if `s` starts with `from`, swap that prefix for `to`.
fn _ke_replace_prefix(s: string, from: string, to: string) -> string {
    if len(s) < len(from) { return s }
    if s.substring(0, len(from)) == from {
        return to + s.substring(len(from), len(s))
    }
    return s
}

// derive_history_url — turn the participant's ANIMA_BROKER_URL (a ws:// url
// pointing at /ws/anima) into the broker's `GET /history` HTTP endpoint.
//   ws://127.0.0.1:8000/ws/anima  →  http://127.0.0.1:8000/history
//   wss://host/ws/anima           →  https://host/history
// KOSMOS_HISTORY_URL overrides the whole derivation.
fn derive_history_url() -> string {
    let explicit = _ke_env("KOSMOS_HISTORY_URL", "")
    if len(explicit) > 0 { return explicit }

    // same default as anima_participant.py BROKER_URL.
    let broker = _ke_env("ANIMA_BROKER_URL", "ws://127.0.0.1:8000/ws/anima")
    // scheme: ws → http, wss → https.
    let mut u = _ke_replace_prefix(broker, "wss://", "https://")
    u = _ke_replace_prefix(u, "ws://", "http://")
    // path: take origin (scheme://host:port) and append /history. The broker
    // path is always `/ws...`, so split on the first `/` after the scheme.
    let scheme_end = u.index_of("://")
    if scheme_end < 0 { return u }
    let after = scheme_end + 3
    let rest = u.substring(after, len(u))
    let slash = rest.index_of("/")
    let mut origin = u
    if slash >= 0 {
        origin = u.substring(0, after + slash)
    }
    return origin + "/history"
}


// ── §2 history poll + anima-message extraction ───────────────────────────────

// _ke_str — safe string field read (missing dict key → "" not void-text).
fn _ke_str(d: dict, k: string) -> string {
    let v = d[k]
    if to_string(v) == "void" { return "" }
    return to_string(v)
}

// poll_anima_messages — GET /history, parse JSON, return the list of
// `kind == "anima"` message dicts (in broker order, oldest first). Empty list
// on any error (offline broker / bad JSON / no anima yet).
fn poll_anima_messages(history_url: string) -> list {
    let body = http_get(history_url, 10)
    if len(body) == 0 { return [] }
    let parsed = json_parse(body)
    if type_of(parsed) != "map" { return [] }
    let hist = parsed["history"]
    // hexa type_of: array literal → "array" (NOT "list") — cycle 13 sweep
    if type_of(hist) != "array" { return [] }
    let mut out = []
    let mut i = 0
    while i < len(hist) {
        let m = hist[i]
        if type_of(m) == "map" {
            if _ke_str(m, "kind") == "anima" {
                out = out + [m]
            }
        }
        i = i + 1
    }
    return out
}


// ── §3 emitter state + one-poll-cycle ────────────────────────────────────────

// new_emitter_state — fresh daemon state.
//   seen        — dict of broker message-id → true (dedup set).
//   tier        — running emission counter (Knuth ordinal), starts 0.
//   seeded      — false until the first poll has seeded `seen` with the
//                 pre-existing history (so replay does NOT emit anchors).
fn new_emitter_state() -> dict {
    return #{ "seen": #{}, "tier": 0, "seeded": false }
}

// emit_for_message — emit one .kosmos anchor for a single anima message dict.
// `factors["relevance"]` is the Φ proxy (factor_relevance(phi)=clamp01(phi),
// per anima_participant.py). cell_id defaults to 0 (no mitosis lane info on
// the wire). tier = the running emission counter. Returns the anchor path.
fn emit_for_message(state: dict, anchor_dir: string, msg: dict) -> string {
    let text = _ke_str(msg, "text")
    let mid  = _ke_str(msg, "id")
    let factors_v = msg["factors"]
    let mut factors = #{}
    if type_of(factors_v) == "map" { factors = factors_v }
    // Φ proxy — factors["relevance"] is clamp01(phi). map_8factor's safe
    // lookup handles a missing key as 0.0.
    let phi = _kosmos_g(factors, "relevance")
    let tier = state["tier"] + 1
    state["tier"] = tier
    // anchor basename — broker id keeps it unique + sortable enough.
    let name = "anima_emit_" + mid
    let cell_id = 0
    return emit_kosmos_from_factors(anchor_dir, name, text, factors, phi,
                                    cell_id, tier)
}

// poll_cycle — one poll: fetch /history, emit anchors for NEW anima messages.
// On the FIRST cycle, only seeds the seen-set (no anchors — replayed history
// is not a live emission). Returns the count of anchors written this cycle.
fn poll_cycle(state: dict, history_url: string, anchor_dir: string) -> int {
    let msgs = poll_anima_messages(history_url)
    let mut written = 0
    let mut i = 0
    while i < len(msgs) {
        let m = msgs[i]
        let mid = _ke_str(m, "id")
        if len(mid) > 0 {
            let seen = state["seen"]
            if !seen.has_key(mid) {
                // new message id.
                if state["seeded"] {
                    let path = emit_for_message(state, anchor_dir, m)
                    println("[kosmos_emitter] anchor written: " + path)
                    written = written + 1
                }
                seen[mid] = true
            }
        }
        i = i + 1
    }
    if !state["seeded"] {
        state["seeded"] = true
        println("[kosmos_emitter] seeded — "
                + to_string(len(msgs)) + " history msg(s), live-only from now")
    }
    return written
}


// ── §4 daemon loop ───────────────────────────────────────────────────────────

// run_daemon — poll forever, sleeping KOSMOS_POLL_SEC between cycles.
fn run_daemon() {
    let history_url = derive_history_url()
    let anchor_dir  = _ke_env("KOSMOS_ANCHOR_DIR",
        "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors")
    let poll_s = to_int(_ke_env("KOSMOS_POLL_SEC", "5"))
    let poll_sec = if poll_s > 0 { poll_s } else { 5 }
    println("[kosmos_emitter] daemon start")
    println("  history url = " + history_url)
    println("  anchor dir  = " + anchor_dir)
    println("  poll        = " + to_string(poll_sec) + "s")

    let state = new_emitter_state()
    while true {
        let n = poll_cycle(state, history_url, anchor_dir)
        if n > 0 {
            println("[kosmos_emitter] cycle: " + to_string(n) + " anchor(s)")
        }
        let _ = exec("sleep " + to_string(poll_sec))
    }
}

// run_once — single poll cycle (smoke / cron mode). Because the first cycle
// only seeds, `once` mode never writes an anchor against a live broker — it
// is for connectivity verification + the offline self-test path.
fn run_once() {
    let history_url = derive_history_url()
    let anchor_dir  = _ke_env("KOSMOS_ANCHOR_DIR",
        "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors")
    println("[kosmos_emitter] single poll cycle")
    println("  history url = " + history_url)
    let state = new_emitter_state()
    let n = poll_cycle(state, history_url, anchor_dir)
    println("[kosmos_emitter] once done — " + to_string(n) + " anchor(s)")
}


// ── §5 self-test (F-KOSMOS-EMIT-1..4) ────────────────────────────────────────
//
// Offline test — no live broker. Feeds a synthetic broker /history payload
// through the same poll → emit path and confirms a .kosmos anchor is written.
//
// NOTE the fn is named `_emitter_selftest` (not `_selftest`) — the imported
// kosmos_anchor.hexa also defines `_selftest`; a same-name collision would
// resolve to the wrong module's body. Same reason `main` below is the only
// `main` that does the dispatch.

fn _emitter_selftest() {
    println("kosmos_emitter selftest — F-KOSMOS-EMIT-1..4")
    let mut pass = 0
    let mut fail = 0

    // F-KOSMOS-EMIT-1 — broker WS url → /history HTTP url derivation.
    let d1 = _ke_replace_prefix("ws://127.0.0.1:8000/ws/anima", "ws://", "http://")
    if d1 == "http://127.0.0.1:8000/ws/anima" { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL scheme swap: " + d1) }

    // F-KOSMOS-EMIT-2 — derive_history_url strips /ws* path → /history.
    // (env-independent: exercise the path logic via a fixed input.)
    let probe = "http://127.0.0.1:8000/ws/anima"
    let se = probe.index_of("://") + 3
    let rest = probe.substring(se, len(probe))
    let sl = rest.index_of("/")
    let origin = probe.substring(0, se + sl)
    if origin + "/history" == "http://127.0.0.1:8000/history" { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL path → /history: " + origin) }

    // F-KOSMOS-EMIT-3 — synthetic /history poll writes a .kosmos anchor for a
    // live (post-seed) anima message, and dedups by broker id.
    let tmp = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let state = new_emitter_state()
    // seed cycle — pretend the broker already had this one anima msg; seeding
    // it must NOT write an anchor.
    let seed_msg = #{
        "id": "seed01", "kind": "anima", "text": "이전 발화 (history replay).",
        "factors": #{ "relevance": 0.5, "coherence": 0.5, "info_gap": 0.3,
                      "curiosity": 0.4, "originality": 0.4, "pain": 0.1,
                      "balance": 0.6, "dynamics": 0.2 },
    }
    // direct seed: mark seen without emit (mirrors first poll_cycle seeding).
    let seen0 = state["seen"]
    seen0["seed01"] = true
    state["seeded"] = true
    // now a NEW live anima msg arrives — must emit.
    let live_msg = #{
        "id": "live99", "kind": "anima",
        "text": "이것은 production anima emission 입니다.",
        "factors": #{ "relevance": 0.82, "coherence": 0.61, "info_gap": 0.44,
                      "curiosity": 0.73, "originality": 0.52, "pain": 0.22,
                      "balance": 0.9, "dynamics": 0.31 },
    }
    let path = emit_for_message(state, tmp, live_msg)
    let exists = exec("[ -f " + _kosmos_shq(path) + " ] && printf yes || printf no")
    if exists == "yes" { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL anchor not written for live msg") }
    let content = exec("cat " + _kosmos_shq(path))
    if len(content.split("@payload tension")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL tension payload missing") }
    // tier = running emission counter — first live emit ⇒ tier 1.
    if len(content.split("knuth_tier   = 1")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL tier != 1 (running counter)") }
    // Φ proxy = factors.relevance = 0.82 → coord x = 0.8200.
    if len(content.split("coord        = [0.8200,")) == 2 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL phi proxy != relevance 0.82") }

    // F-KOSMOS-EMIT-4 — poll_cycle dedups: same id twice → second cycle writes 0.
    let synth_dir = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let st2 = new_emitter_state()
    // first cycle SEEDS (no write), second cycle with the SAME msg also writes
    // 0 because the id is now in the seen-set.
    let one = [ #{ "id": "x1", "kind": "anima", "text": "t",
                   "factors": #{ "relevance": 0.5 } } ]
    // emulate poll_cycle's per-msg logic against `one` twice.
    let mut w1 = 0
    let mut j = 0
    while j < len(one) {
        let m = one[j]
        let mid = _ke_str(m, "id")
        let seenset = st2["seen"]
        if !seenset.has_key(mid) {
            if st2["seeded"] {
                let _p = emit_for_message(st2, synth_dir, m)
                w1 = w1 + 1
            }
            let sx = st2["seen"]
            sx[mid] = true
        }
        j = j + 1
    }
    st2["seeded"] = true
    // second pass — id already seen ⇒ 0 writes.
    let mut w2 = 0
    let mut k = 0
    while k < len(one) {
        let m = one[k]
        let mid = _ke_str(m, "id")
        let seenset = st2["seen"]
        if !seenset.has_key(mid) { w2 = w2 + 1 }
        k = k + 1
    }
    if w1 == 0 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL seed cycle wrote an anchor") }
    if w2 == 0 { pass = pass + 1 }
    else { fail = fail + 1   println("  FAIL dedup failed — second cycle re-emit") }

    println("--- written anchor (" + path + ") ---")
    println(content)
    println("kosmos_emitter selftest: " + to_string(pass) + " PASS, "
            + to_string(fail) + " FAIL")
}


// ── §6 entry ─────────────────────────────────────────────────────────────────

fn main() {
    let cli = args()
    let mut mode = "selftest"
    if len(cli) > 1 {
        if cli[1] == "daemon" { mode = "daemon" }
        if cli[1] == "once"   { mode = "once" }
    }
    if mode == "daemon" {
        run_daemon()
        return
    }
    if mode == "once" {
        run_once()
        return
    }
    // default — offline self-test (no live broker required).
    _emitter_selftest()
}
