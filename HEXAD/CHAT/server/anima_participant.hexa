// ════════════════════════════════════════════════════════════════════════
// HEXAD/CHAT/server/anima_participant.hexa — WRAPPER entry-point
//
//   anima_participant.py is FIRST-PACK Phase 5: anima as a substrate-native
//   chat participant (8-factor Thinker-Talker + hot-swap router + substrate
//   plugin). It hard-depends on torch / transformers / peft (LLM forward,
//   entropy_of_next) AND the websockets event-loop client — no hexa-native
//   equivalent exists. The .py is KEPT; this thin .hexa documents purpose
//   and dispatches it via exec().
//
//   anima joins the broker as a peer; emission is governed by anima's OWN
//   self-tick + 8-factor motivation (project.tape @D a_substrate_native_
//   speak — NEVER triggered by user messages). The 8-factor motivation math
//   itself is already hexa-native in HEXAD/CHAT/spontaneous_lib.hexa § 2-3
//   (factor fns + weights, SSOT) — anima_participant.py mirrors those for
//   the torch-bound serving lane.
//
//   USAGE  hexa run anima_participant.hexa [--threshold F] [--substrate K]
//   env    ANIMA_BASE / ANIMA_ADAPTER / ANIMA_BROKER_URL / ANIMA_DEVICE /
//          ANIMA_TICK / ANIMA_THRESHOLD — forwarded unchanged.
// ════════════════════════════════════════════════════════════════════════

fn _shq(s: string) -> string {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\\''" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

fn main() {
    let here = "/Users/ghost/core/anima/HEXAD/CHAT/server"
    let py = here + "/anima_participant.py"
    let exists = exec("[ -f '" + py + "' ] && printf yes || printf no")
    if exists != "yes" {
        println("anima_participant.py not found at: " + py)
        return
    }
    let cli = args()
    let mut fwd = ""
    let mut i = 1
    while i < len(cli) {
        fwd = fwd + " " + _shq(cli[i])
        i = i + 1
    }
    println("[anima_participant] dispatch → python3 anima_participant.py" + fwd)
    print(exec("cd '" + here + "' && python3 anima_participant.py" + fwd))
}
