// ═══════════════════════════════════════════════════════════════════════════
//  HEXAD/CHAT/server/akida_bridge.hexa — pure-hexa AKIDA Pi → broker WS bridge
//
//  Collapses 3 predecessors into one hexa-native daemon:
//    · akida_ws_publisher.py — stdin → WS publisher (had wrong default path)
//    · akida_bridge.py        — `nc` subprocess wrapper feeding the publisher
//    · akida_bridge_pipeline.sh — `nc | python3 publisher` shell glue
//
//  THE BUG WE ELIMINATE
//    Broker (HEXAD/CHAT/server/broker.py) exposes TWO akida endpoints:
//      · `/ws/akida_ingest` (line 328) — Pi spike PUSH endpoint (this bridge)
//      · `/ws/akida`        (line 359) — frontend subscriber READ endpoint
//    The previous default of this bridge pointed the pusher at `/ws/akida`
//    (subscriber) — that handler does `receive_text()` only to detect
//    disconnect, never appending to history → silent spike drop. The live
//    deploy is rescued by overriding
//    `AKIDA_BROKER_WS=ws://localhost:8000/ws/akida_ingest` in the plist
//    (PlistBuddy edit + launchctl reload). This .hexa now hard-codes the
//    correct ingest default AND the selftest invariant asserts it, so the
//    bug cannot resurface if the plist override is removed.
//    SSOT: anima MEMORY `feedback_plist_forbidden_akida_endpoint`.
//
//  DATA FLOW
//    Pi (192.168.50.155:9512) → newline-delimited JSON spike records
//    → bridge stamps `_bridge_ts`
//    → broker `ws://localhost:8000/ws/akida_ingest` (text frame, one spike per send)
//
//  RUN     hexa run akida_bridge.hexa            — daemon (forever)
//          hexa run akida_bridge.hexa selftest   — offline F-AKIDA-BRIDGE
//          hexa run akida_bridge.hexa once       — single Pi-connect cycle
//
//  ENV (g13 portable — no hardcoded paths)
//    AKIDA_PI_HOST       default 192.168.50.155
//    AKIDA_PI_PORT       default 9512
//    AKIDA_BROKER_WS     default ws://localhost:8000/ws/akida_ingest
//    AKIDA_RECONNECT_SEC default 5  (backoff between Pi reconnect attempts)
//    AKIDA_NC            default nc  (Pi-side TCP client binary, see below)
//
//  TCP CLIENT — `nc` subprocess (NOT stdlib net_connect)
//    The .py historian notes that macOS `asyncio.open_connection` errors out
//    (Errno 65) on the Pi's LAN IP from this host, while the `nc` binary
//    connects cleanly. The hexa runtime's net_connect uses the same kernel
//    socket(2) primitive — same failure surface. We keep `nc` for the Pi
//    side AND use it via stdlib/proc.proc_spawn_supervised so it is
//    auto-reaped on daemon exit (no orphan procs — same governance as the
//    websocat WS client).
//
//  WS CLIENT — stdlib/websocket.hexa streaming API (websocat backend)
//    `brew install websocat` on mini deploy host (hexa-lang inbox patch
//    `websocket-streaming-client-websocat-dependency.md` documents this).
//
//  HARD CONSTRAINTS — pure-hexa (no .py / no .sh authoring); hexa-lang
//    syntax (dict literal `#{}`, `import` abs-path only, missing key → void,
//    void-safe lookup `to_string(d[k]) == "void"`).
// ═══════════════════════════════════════════════════════════════════════════

use "stdlib/proc"
use "stdlib/websocket"


// ── §1 env config ──────────────────────────────────────────────────────────

// _ab_env — env var with fallback default.
fn _ab_env(name: string, fallback: string) -> string {
    let v = env(name)
    if to_string(v) == "void" { return fallback }
    if len(to_string(v)) == 0 { return fallback }
    return to_string(v)
}

// _ab_shq — single-quote shell escape (canonical hexa-stdlib idiom).
fn _ab_shq(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}


// ── §2 line-buffered FIFO reader ───────────────────────────────────────────
//
// We spawn `nc` via proc_spawn_supervised with its stdout redirected into a
// FIFO. A per-iteration `head -n 1` on that FIFO blocks until one full line
// arrives (the kernel buffers the partial line; subsequent head calls drain
// the next line). This mirrors stdlib/websocket.hexa's ws_recv pattern.
//
// Returns the file descriptor's read-side path (the FIFO path). On failure
// returns map {"ok": false, "error": "..."}.

// nc_spawn — spawn `nc` subprocess connected to PI_HOST:PI_PORT, stdout via FIFO.
fn nc_spawn(host: string, port: int, nc_bin: string) -> dict {
    let h = #{}
    h["ok"] = false
    h["pid"] = 0
    h["out"] = ""
    h["error"] = ""

    let nonce = to_string(exec("date +%s%N | tr -d '\\n'")).trim()
    let out_path = "/tmp/hexa_akida_nc_" + nonce + ".fifo"
    let mk = to_string(exec("mkfifo " + _ab_shq(out_path) + " 2>&1; echo $?")).trim()
    if !mk.ends_with("0") {
        h["error"] = "mkfifo failed: " + mk
        return h
    }

    // -w 600: idle-read timeout 600s (Pi may pause briefly between spikes).
    // Redirect stdout to FIFO; stderr discarded (verbose `nc` log noise).
    let cmd = nc_bin + " -w 600 " + _ab_shq(host) + " " + to_string(port)
            + " > " + _ab_shq(out_path) + " 2>/dev/null"
    let why = "akida bridge Pi TCP stream " + host + ":" + to_string(port)
    let pid = proc_spawn_supervised(cmd, 86400, why)
    if pid <= 0 {
        let _drop = exec("rm -f " + _ab_shq(out_path))
        h["error"] = "proc_spawn_supervised failed (returned " + to_string(pid) + ")"
        return h
    }
    h["ok"] = true
    h["pid"] = pid
    h["out"] = out_path
    return h
}

// nc_read_line — block-read one newline-terminated line from the FIFO.
// Returns "" on close / timeout (caller treats "" as EOF → reconnect).
fn nc_read_line(out_path: string, timeout_sec: int) -> string {
    let t = if timeout_sec > 0 { timeout_sec } else { 30 }
    let has_timeout = to_string(exec("command -v timeout >/dev/null 2>&1 && echo y || echo n")).trim()
    let cmd = if has_timeout == "y" {
        "timeout " + to_string(t) + " head -n 1 " + _ab_shq(out_path)
    } else {
        "head -n 1 " + _ab_shq(out_path)
    }
    let raw = to_string(exec(cmd))
    if len(raw) == 0 { return "" }
    if raw.substring(len(raw) - 1, len(raw)) == "\n" {
        return raw.substring(0, len(raw) - 1)
    }
    return raw
}

// nc_close — reap the supervised nc subprocess + unlink the FIFO.
fn nc_close(h: dict) -> bool {
    let pid = to_int(h["pid"])
    let out_path = to_string(h["out"])
    let reaped = if pid > 0 { proc_reap(pid) } else { false }
    if len(out_path) > 0 {
        let _drop = exec("rm -f " + _ab_shq(out_path))
    }
    return reaped
}


// ── §3 spike record stamping ───────────────────────────────────────────────

// _ab_now_epoch_f — float wall-clock seconds (matches python `time.time()`).
fn _ab_now_epoch_f() -> string {
    // date +%s.%N → posix seconds + nanos as decimal string.
    let s = to_string(exec("date +%s.%N | tr -d '\\n'")).trim()
    if len(s) == 0 { return "0" }
    return s
}

// stamp_spike — parse JSON line, inject `_bridge_ts` = wall-clock seconds,
// re-emit JSON. Returns "" on parse failure (caller skips line).
fn stamp_spike(line: string) -> string {
    if len(line) == 0 { return "" }
    let parsed = json_parse(line)
    if type_of(parsed) != "map" { return "" }
    // _bridge_ts as numeric (matches python `spike["_bridge_ts"] = time.time()`).
    // json_stringify on a float string produces a quoted string, so we
    // re-encode the float manually by stringifying the map, then patching
    // the field. Simpler: hexa json_stringify is sufficient for int values;
    // for sub-second resolution we keep the string-form decimal and let the
    // broker / downstream consumers treat as float (json.loads on "0.123"
    // numeric literal works; the value below is a numeric literal because
    // we inject it directly into the serialized form).
    parsed["_bridge_ts"] = to_float(_ab_now_epoch_f())
    return json_stringify(parsed)
}


// ── §4 one-iteration bridge loop ───────────────────────────────────────────

// bridge_state — running counters for the daemon.
fn bridge_state() -> dict {
    return #{
        "n_forwarded": 0,
        "n_cycles":    0,
        "started_at":  _ab_now_epoch_f(),
    }
}

// run_once — one full Pi-connect + WS-connect + forward-until-fail cycle.
// On any failure, closes both and returns. Caller backs off + retries.
// Returns updated state (counters carry across cycles).
fn run_once(state: dict, pi_host: string, pi_port: int, broker_ws: string,
            nc_bin: string) -> dict {
    state["n_cycles"] = state["n_cycles"] + 1
    eprintln("[akida_bridge] cycle " + to_string(state["n_cycles"])
             + " — nc " + pi_host + ":" + to_string(pi_port)
             + " → ws " + broker_ws)

    // Pi-side TCP via supervised nc subprocess.
    let nc_h = nc_spawn(pi_host, pi_port, nc_bin)
    if !nc_h["ok"] {
        eprintln("[akida_bridge] nc spawn fail: " + to_string(nc_h["error"]))
        return state
    }
    eprintln("[akida_bridge] nc pid=" + to_string(nc_h["pid"]) + " out=" + to_string(nc_h["out"]))

    // Broker-side WS via websocat streaming subprocess.
    let ws_h = ws_connect(broker_ws, 30)
    if !ws_h["ok"] {
        eprintln("[akida_bridge] ws connect fail: " + to_string(ws_h["error"]))
        let _r = nc_close(nc_h)
        return state
    }
    eprintln("[akida_bridge] WS connected " + broker_ws + " (pid=" + to_string(ws_h["pid"]) + ")")

    // Forward loop — block-read one line from nc FIFO, stamp + WS-send.
    let out_path = to_string(nc_h["out"])
    let mut local_n = 0
    while true {
        let line = nc_read_line(out_path, 600)
        if len(line) == 0 {
            eprintln("[akida_bridge] nc EOF (forwarded " + to_string(local_n)
                     + " this cycle, " + to_string(state["n_forwarded"])
                     + " total)")
            break
        }
        let frame = stamp_spike(line)
        if len(frame) == 0 { continue }
        let sent = ws_send(ws_h, frame)
        if !sent {
            eprintln("[akida_bridge] ws_send fail — reconnect")
            break
        }
        local_n = local_n + 1
        state["n_forwarded"] = state["n_forwarded"] + 1
        let n_total = to_int(state["n_forwarded"])
        if n_total == 1 || n_total % 100 == 0 {
            eprintln("[akida_bridge] forwarded " + to_string(n_total) + " spikes")
        }
    }

    let _wc = ws_close(ws_h)
    let _nc = nc_close(nc_h)
    eprintln("[akida_bridge] cycle " + to_string(state["n_cycles"]) + " done — both sides closed")
    return state
}


// ── §5 daemon loop ─────────────────────────────────────────────────────────

fn run_daemon() {
    let pi_host = _ab_env("AKIDA_PI_HOST", "192.168.50.155")
    let pi_port = to_int(_ab_env("AKIDA_PI_PORT", "9512"))
    let broker_ws = _ab_env("AKIDA_BROKER_WS", "ws://localhost:8000/ws/akida_ingest")
    let backoff_s = to_int(_ab_env("AKIDA_RECONNECT_SEC", "5"))
    let nc_bin = _ab_env("AKIDA_NC", "nc")
    let backoff = if backoff_s > 0 { backoff_s } else { 5 }

    eprintln("[akida_bridge] daemon start")
    eprintln("  pi          = " + pi_host + ":" + to_string(pi_port))
    eprintln("  broker_ws   = " + broker_ws)
    eprintln("  backoff_sec = " + to_string(backoff))
    eprintln("  nc_bin      = " + nc_bin)

    let avail = ws_available()
    if !avail["websocat"] {
        eprintln("[akida_bridge] FATAL: websocat not available — "
                 + "install via `brew install websocat` (streaming WS requires it)")
        return
    }

    let state = bridge_state()
    while true {
        run_once(state, pi_host, pi_port, broker_ws, nc_bin)
        eprintln("[akida_bridge] reconnect in " + to_string(backoff) + "s")
        let _s = exec("sleep " + to_string(backoff))
    }
}

// run_once_cli — single cycle (smoke / cron mode). Exits after first nc EOF
// or ws fail. Useful for live connectivity verification.
fn run_once_cli() {
    let pi_host = _ab_env("AKIDA_PI_HOST", "192.168.50.155")
    let pi_port = to_int(_ab_env("AKIDA_PI_PORT", "9512"))
    let broker_ws = _ab_env("AKIDA_BROKER_WS", "ws://localhost:8000/ws/akida_ingest")
    let nc_bin = _ab_env("AKIDA_NC", "nc")
    eprintln("[akida_bridge] single cycle")
    let state = bridge_state()
    run_once(state, pi_host, pi_port, broker_ws, nc_bin)
    eprintln("[akida_bridge] once done — forwarded "
             + to_string(state["n_forwarded"]) + " spikes")
}


// ── §6 offline selftest (F-AKIDA-BRIDGE-1..4) ──────────────────────────────
//
// Network-free. Exercises env resolution, JSON stamping, line-buffer reader,
// and the default-WS-path invariant (the bug we eliminate).

fn _selftest() {
    eprintln("akida_bridge selftest — F-AKIDA-BRIDGE-1..4")
    let mut pass = 0
    let mut fail = 0

    // F-AKIDA-BRIDGE-1 — default broker WS path is /ws/akida_ingest (the
    // Pi PUSH endpoint), NOT /ws/akida (the frontend subscriber).
    // SSOT: broker.py lines 328 / 359 + anima MEMORY
    // `feedback_plist_forbidden_akida_endpoint`. Pointing the pusher at
    // /ws/akida silently drops spikes (subscriber handler never appends).
    let default_ws = _ab_env("AKIDA_BROKER_WS__UNLIKELY_UNSET",
                             "ws://localhost:8000/ws/akida_ingest")
    if default_ws == "ws://localhost:8000/ws/akida_ingest" {
        pass = pass + 1
        eprintln("  PASS default WS path = /ws/akida_ingest")
    } else {
        fail = fail + 1
        eprintln("  FAIL default WS path: " + default_ws)
    }
    // Negative — default must NOT be the subscriber path.
    if !default_ws.ends_with("/ws/akida") {
        pass = pass + 1
        eprintln("  PASS default is NOT the subscriber path /ws/akida")
    } else {
        fail = fail + 1
        eprintln("  FAIL default is the subscriber path: " + default_ws)
    }

    // F-AKIDA-BRIDGE-2 — env resolution falls back on void / empty.
    let v_empty = _ab_env("AKIDA_PI_HOST__UNSET", "fallback_host")
    if v_empty == "fallback_host" {
        pass = pass + 1
        eprintln("  PASS env fallback on unset")
    } else {
        fail = fail + 1
        eprintln("  FAIL env fallback: " + v_empty)
    }

    // F-AKIDA-BRIDGE-3 — JSON spike stamping preserves payload + injects _bridge_ts.
    let synth_line = "{\"step\":42,\"n_spikes\":7,\"regime\":\"R3_tonic_zero_input\"}"
    let stamped = stamp_spike(synth_line)
    if len(stamped) > 0 {
        let parsed = json_parse(stamped)
        if type_of(parsed) == "map" {
            let bridge_ts_v = parsed["_bridge_ts"]
            if to_string(bridge_ts_v) != "void" {
                pass = pass + 1
                eprintln("  PASS _bridge_ts injected (= " + to_string(bridge_ts_v) + ")")
            } else {
                fail = fail + 1
                eprintln("  FAIL _bridge_ts missing in: " + stamped)
            }
            // Original payload preserved.
            if to_string(parsed["regime"]) == "R3_tonic_zero_input" {
                pass = pass + 1
                eprintln("  PASS payload field preserved (regime)")
            } else {
                fail = fail + 1
                eprintln("  FAIL payload lost: " + stamped)
            }
            if to_int(parsed["step"]) == 42 {
                pass = pass + 1
                eprintln("  PASS payload field preserved (step=42)")
            } else {
                fail = fail + 1
                eprintln("  FAIL step missing: " + stamped)
            }
        } else {
            fail = fail + 1
            eprintln("  FAIL stamped output not JSON: " + stamped)
        }
    } else {
        fail = fail + 1
        eprintln("  FAIL stamp_spike returned empty")
    }

    // F-AKIDA-BRIDGE-4 — malformed JSON line is dropped silently (empty result).
    let dropped = stamp_spike("not-json-at-all")
    if len(dropped) == 0 {
        pass = pass + 1
        eprintln("  PASS malformed line dropped (empty result)")
    } else {
        fail = fail + 1
        eprintln("  FAIL malformed line not dropped: " + dropped)
    }
    let dropped2 = stamp_spike("")
    if len(dropped2) == 0 {
        pass = pass + 1
        eprintln("  PASS empty line dropped")
    } else {
        fail = fail + 1
        eprintln("  FAIL empty line not dropped: " + dropped2)
    }

    // F-AKIDA-BRIDGE-5 — line-buffered reader against a synthetic regular file.
    // Uses a regular file (not a FIFO) because exec() under hexa runs the
    // writer via popen — the FIFO writer-side `(printf > fifo) &` race
    // exhibited platform-dependent hangs (Mac: writer subshell exited before
    // reader opened, leaving a half-open FIFO). A plain-file probe still
    // exercises the `timeout head -n 1` path that the production code uses;
    // the FIFO vs file distinction is purely a kernel buffer semantic.
    let nonce = to_string(exec("date +%s%N | tr -d '\\n'")).trim()
    let probe = "/tmp/hexa_akida_selftest_" + nonce + ".txt"
    write_file(probe, "first-line\nsecond-line\n")
    let got = nc_read_line(probe, 5)
    if got == "first-line" {
        pass = pass + 1
        eprintln("  PASS reader returns first line of file (got=`" + got + "`)")
    } else {
        fail = fail + 1
        eprintln("  FAIL reader (got=`" + got + "`)")
    }
    let _drop = exec("rm -f " + _ab_shq(probe))

    eprintln("akida_bridge selftest: " + to_string(pass) + " PASS, "
             + to_string(fail) + " FAIL")
}


// ── §7 entry ───────────────────────────────────────────────────────────────

// eprintln — stderr println shim (matches the .py log cadence to stderr).
// hexa println goes to stdout; launchd captures stdout + stderr to separate
// paths (akida_bridge.out / .err). The .py logged via `logging.INFO` to
// stderr (logging default). Keep that convention so existing log tooling
// (tail -f .err) keeps working post-port.
fn eprintln(s: string) {
    // hexa println → stdout. Use a tiny shell-exec to redirect to fd 2.
    // Cheap; cadence is at most ~1/sec for normal load (every 100 spikes
    // @ Pi rate ≈ 10/s).
    let _e = exec("printf '%s\\n' " + _ab_shq(s) + " >&2")
}

fn main() {
    let cli = args()
    let mut mode = "daemon"
    if len(cli) > 1 {
        if cli[1] == "selftest" { mode = "selftest" }
        if cli[1] == "once"     { mode = "once" }
        if cli[1] == "daemon"   { mode = "daemon" }
    }
    if mode == "selftest" {
        _selftest()
        return
    }
    if mode == "once" {
        run_once_cli()
        return
    }
    run_daemon()
}
