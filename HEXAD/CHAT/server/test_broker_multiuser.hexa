// ════════════════════════════════════════════════════════════════════════
// HEXAD/CHAT/server/test_broker_multiuser.hexa — WRAPPER entry-point
//
//   test_broker_multiuser.py is the FIRST-PACK Phase 3 falsifier: it opens
//   2 concurrent user WebSocket clients against a running broker and
//   asserts broadcast + participant push + history sync (each client must
//   see both messages → PHASE3_BROADCAST_PASS).
//
//   It hard-depends on the `websockets` async client library + a live
//   broker process — a pure-hexa reimplementation is infeasible. The .py is
//   KEPT and this thin .hexa documents purpose and dispatches it via
//   exec(). Requires broker.py already listening on ws://127.0.0.1:8000.
//
//   USAGE  hexa run test_broker_multiuser.hexa
//   exit   the underlying python exits 0 on PASS, 1 on FAIL.
// ════════════════════════════════════════════════════════════════════════

fn main() {
    let here = "/Users/ghost/core/anima/HEXAD/CHAT/server"
    let py = here + "/test_broker_multiuser.py"
    let exists = exec("[ -f '" + py + "' ] && printf yes || printf no")
    if exists != "yes" {
        println("test_broker_multiuser.py not found at: " + py)
        return
    }
    println("[test_broker_multiuser] dispatch → python3 test_broker_multiuser.py")
    println("  (requires a running broker at ws://127.0.0.1:8000)")
    print(exec("cd '" + here + "' && python3 test_broker_multiuser.py"))
}
