// ════════════════════════════════════════════════════════════════════════════
//  mini_sshd_diag.hexa — channel-reject diagnosis tool
//
//  Round 6 #2 finding (ZHFL/RUFL deploy, 2026-05-22):
//    mini sshd accepts publickey auth but rejects every session channel with
//    `request failed on channel 0` — exec / scp / sftp all blocked. This
//    persists through round 9 and blocks deploy of:
//      · p3+p5 enforcement   (PR #148, drop self_monologue + register guard)
//      · ZHFL/RUFL router    (PR #132, adapter rsync + reload)
//      · 3B router           (PR #119, post-reboot)
//      · any future production swap
//
//  Read-only diagnostic. NEVER modifies mini config — user runs the fix
//  manually after reading the report.
//
//  Run on the mini terminal (local console after sshd diag):
//      hexa run HEXAD/CHAT/server/mini_sshd_diag.hexa
//
//  Suspected causes covered (per round 6 finding):
//    1. ~/.ssh/rc with `user-rc` option → script failure forces channel close
//    2. /etc/ssh/sshd_config ForceCommand / Match / Subsystem misconfig
//    3. PAM session limit (MaxSessions 0 etc.)
//    4. macOS sshd security policy (SIP, TCC, LaunchDaemon disabled)
//    5. AllowGroups / AllowUsers narrowed
//
//  HARD CONSTRAINTS — pure-hexa, hexa-lang syntax (dict `#{}`, missing key
//  → `void`, `import` abs-path only). exec() is the canonical leaf shell op.
// ════════════════════════════════════════════════════════════════════════════


// ── §1 shell helpers (canonical hexa idiom) ──────────────────────────────────

// single-quote a string for safe shell embedding.
fn _shq(s: string) -> string {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\\''" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

// run a shell command read-only and return stdout (stderr swallowed).
fn _sh(cmd: string) -> string {
    return to_string(exec(cmd + " 2>/dev/null || true"))
}

// run with sudo prepended (for log show / etc.). Read-only.
fn _sudo(cmd: string) -> string {
    return to_string(exec("sudo -n " + cmd + " 2>/dev/null || true"))
}

fn _exists(path: string) -> bool {
    let s = _sh("[ -e " + _shq(path) + " ] && printf yes || printf no")
    return s == "yes"
}

fn _readable(path: string) -> bool {
    let s = _sh("[ -r " + _shq(path) + " ] && printf yes || printf no")
    return s == "yes"
}


// ── §2 section printers ──────────────────────────────────────────────────────

fn _hdr(t: string) {
    println("")
    println("## " + t)
    println("")
}

fn _kv(k: string, v: string) {
    println("- **" + k + "**: " + v)
}

fn _block(label: string, body: string) {
    println("")
    println("### " + label)
    println("```")
    if len(body) == 0 {
        println("(empty)")
    } else {
        println(body)
    }
    println("```")
}


// ── §3 §A ~/.ssh/rc audit (cause #1) ─────────────────────────────────────────

fn check_ssh_rc() -> dict {
    _hdr("A. `~/.ssh/rc` audit  (cause #1 — user-rc script failure → channel close)")
    let home = _sh("printf %s \"$HOME\"")
    let path = home + "/.ssh/rc"
    let exists = _exists(path)
    _kv("path", path)
    _kv("exists", to_string(exists))
    if !exists {
        _kv("verdict", "CLEAN — no user-rc script, not the cause")
        return #{ "hit": false, "label": "ssh_rc" }
    }
    let perms = _sh("ls -l " + _shq(path) + " | awk '{print $1,$3,$4,$5}'")
    _kv("perms", perms)
    let content = _sh("cat " + _shq(path))
    _block("content", content)
    _kv("verdict", "PRESENT — if script exits non-zero, sshd closes the session channel. Try `mv ~/.ssh/rc ~/.ssh/rc.disabled` and retry.")
    return #{ "hit": true, "label": "ssh_rc" }
}


// ── §4 §B /etc/ssh/sshd_config audit (cause #2, #3, #5) ──────────────────────

fn check_sshd_config() -> dict {
    _hdr("B. `/etc/ssh/sshd_config` audit  (causes #2 ForceCommand · #3 MaxSessions · #5 Allow*)")
    let cfg = "/etc/ssh/sshd_config"
    if !_exists(cfg) {
        _kv("exists", "NO — unexpected on macOS, skipping")
        return #{ "hit": false, "label": "sshd_config" }
    }
    _kv("path", cfg)
    // Pull every relevant directive (active + commented + Match blocks).
    let grep = "grep -nEi '^[[:space:]]*(Match|ForceCommand|Subsystem|MaxSessions|MaxStartups|AllowGroups|AllowUsers|DenyGroups|DenyUsers|PermitTTY|PermitOpen|ChrootDirectory|AuthorizedKeysCommand|PrintMotd|Banner)' "
    let lines = _sh(grep + _shq(cfg))
    _block("relevant directives", lines)
    // Heuristic detection.
    let mut hit = false
    let lower = _sh("printf %s " + _shq(lines) + " | tr 'A-Z' 'a-z'")
    if len(lower.split("forcecommand")) > 1 {
        _kv("flag", "ForceCommand PRESENT — if it points at a missing/non-exec script, every session channel will fail. Inspect target and run it manually.")
        hit = true
    }
    if len(lower.split("maxsessions 0")) > 1 || len(lower.split("maxsessions\t0")) > 1 {
        _kv("flag", "MaxSessions 0 — every session channel rejected by design.")
        hit = true
    }
    if len(lower.split("allowgroups")) > 1 || len(lower.split("allowusers")) > 1 {
        _kv("flag", "Allow* present — confirm current user/group is included.")
        hit = true
    }
    if len(lower.split("match ")) > 1 {
        _kv("flag", "Match block(s) present — verify they do not apply to this user with restrictive PermitTTY no / ForceCommand internal-sftp.")
        hit = true
    }
    if !hit {
        _kv("verdict", "CLEAN — no obvious ForceCommand / MaxSessions 0 / Allow* narrowing / Match block")
    }
    return #{ "hit": hit, "label": "sshd_config" }
}


// ── §5 §C authorized_keys options audit (cause #1 redux) ─────────────────────

fn check_authorized_keys() -> dict {
    _hdr("C. `~/.ssh/authorized_keys` options audit  (cause #1 — per-key restrictions)")
    let home = _sh("printf %s \"$HOME\"")
    let path = home + "/.ssh/authorized_keys"
    if !_exists(path) {
        _kv("exists", "NO — no authorized_keys file")
        return #{ "hit": false, "label": "authorized_keys" }
    }
    _kv("path", path)
    // Show only the option prefixes (everything before `ssh-`/`ecdsa-`/`sk-`).
    let opts = _sh("awk '{for(i=1;i<=NF;i++){if($i ~ /^(ssh-|ecdsa-|sk-)/) break; printf \"%s \", $i} print \"\"}' " + _shq(path))
    _block("key option prefixes", opts)
    let lower = _sh("printf %s " + _shq(opts) + " | tr 'A-Z' 'a-z'")
    let mut hit = false
    if len(lower.split("command=")) > 1 {
        _kv("flag", "command=... PRESENT — pins every session to a fixed exec. If that command is missing/broken, channels are rejected.")
        hit = true
    }
    if len(lower.split("no-pty")) > 1 {
        _kv("flag", "no-pty present — TTY allocation will fail (relevant for interactive ssh, not scp).")
        hit = true
    }
    if len(lower.split("restrict")) > 1 {
        _kv("flag", "restrict present — disables port-forwarding/agent/pty/x11/user-rc; usually safe but combine with command=... blocks scp/sftp.")
        hit = true
    }
    if !hit { _kv("verdict", "CLEAN — no command=/no-pty/restrict options") }
    return #{ "hit": hit, "label": "authorized_keys" }
}


// ── §6 §D sshd log audit (cause #2 / #3 — runtime evidence) ──────────────────

fn check_sshd_log() -> dict {
    _hdr("D. sshd runtime log  (last 1h via `log show`)")
    let raw = _sudo("log show --predicate 'process == \"sshd\"' --last 1h --style compact")
    // last 100 lines, since this can be voluminous.
    let tail = _sh("printf %s " + _shq(raw) + " | tail -100")
    _block("sshd log tail (100 lines)", tail)
    let lower = _sh("printf %s " + _shq(raw) + " | tr 'A-Z' 'a-z'")
    let mut hit = false
    if len(lower.split("session opened")) > 1 && len(lower.split("session closed")) > 1 {
        _kv("flag", "session opened/closed pairs observed — channel layer reached.")
    }
    if len(lower.split("subsystem request")) > 1 {
        _kv("flag", "subsystem request entries — check for `subsystem request for sftp failed`.")
        hit = true
    }
    if len(lower.split("forcecommand")) > 1 {
        _kv("flag", "ForceCommand referenced in log — confirms #2.")
        hit = true
    }
    if len(lower.split("permission denied")) > 1 {
        _kv("flag", "Permission denied lines — TCC / file-perm block possible.")
        hit = true
    }
    if len(lower.split("operation not permitted")) > 1 {
        _kv("flag", "Operation not permitted — likely macOS TCC / SIP block (cause #4).")
        hit = true
    }
    if !hit && len(raw) == 0 {
        _kv("verdict", "EMPTY — sudo log access denied or sshd produced no log in the window. Re-run on console with sudo, or `sudo log stream --predicate 'process==\"sshd\"'` while reproducing the failure.")
    }
    return #{ "hit": hit, "label": "sshd_log" }
}


// ── §7 §E LaunchDaemon audit (cause #4) ──────────────────────────────────────

fn check_launchd() -> dict {
    _hdr("E. sshd LaunchDaemon  (cause #4 — macOS service / TCC)")
    let st = _sudo("launchctl print system | grep -iE 'ssh|openssh'")
    _block("launchctl print system | grep ssh", st)
    let lower = _sh("printf %s " + _shq(st) + " | tr 'A-Z' 'a-z'")
    let mut hit = false
    if len(lower.split("disabled => true")) > 1 {
        _kv("flag", "ssh service disabled — `sudo systemsetup -setremotelogin on`")
        hit = true
    }
    if len(lower.split("state = not running")) > 1 {
        _kv("flag", "ssh state not running — service crash loop possible.")
        hit = true
    }
    let remote = _sh("systemsetup -getremotelogin 2>/dev/null || true")
    _kv("Remote Login", remote)
    if !hit { _kv("verdict", "CLEAN — LaunchDaemon appears nominal (or sudo denied — re-run on console).") }
    return #{ "hit": hit, "label": "launchd" }
}


// ── §8 §F user / group membership (cause #5 cross-check) ─────────────────────

fn check_identity() {
    _hdr("F. user / group identity  (cause #5 — Allow*/Deny* membership)")
    _kv("whoami", _sh("whoami"))
    _kv("id", _sh("id"))
    _kv("groups", _sh("groups"))
    _kv("hostname", _sh("hostname"))
    _kv("uname", _sh("uname -a"))
}


// ── §9 §G final summary ──────────────────────────────────────────────────────

fn _summary_line(d: dict) -> string {
    let lbl = to_string(d["label"])
    let hit = to_string(d["hit"]) == "true"
    if hit { return "- [HIT] " + lbl + " — see section above" }
    return "- [clean] " + lbl
}

fn print_summary(rs: [dict]) {
    _hdr("G. Diagnosis summary")
    let mut i = 0
    while i < len(rs) {
        println(_summary_line(rs[i]))
        i = i + 1
    }
    println("")
    println("### Recommended next steps")
    println("")
    println("1. If §A hit  → `mv ~/.ssh/rc ~/.ssh/rc.disabled` and retry `ssh mini -- echo ok` from another host.")
    println("2. If §B/C hit → comment out the offending directive in `/etc/ssh/sshd_config` (or strip `command=`/`restrict` from `authorized_keys`), then `sudo launchctl kickstart -k system/com.openssh.sshd` (or `sudo systemsetup -setremotelogin off; sudo systemsetup -setremotelogin on`).")
    println("3. If §D shows `Operation not permitted` → grant `sshd-keygen-wrapper` + `sshd` Full Disk Access in System Settings → Privacy & Security → Full Disk Access (cause #4).")
    println("4. If §E shows disabled / not running → `sudo systemsetup -setremotelogin on` and verify with `sudo launchctl print system/com.openssh.sshd`.")
    println("5. If §F shows user NOT in Allow* set → add user/group to AllowUsers/AllowGroups in `/etc/ssh/sshd_config` and kickstart sshd.")
    println("")
    println("After the fix, validate with `ssh mini -- echo ok` from a remote host. Once a session channel succeeds, the round-6/9 deploy ops resume (PR #148 enforcement → PR #132 router rsync → PR #119 3B reload).")
}


// ── §10 entry ────────────────────────────────────────────────────────────────

fn main() {
    println("# mini sshd channel-reject diagnosis")
    println("")
    println("_generated by `HEXAD/CHAT/server/mini_sshd_diag.hexa` — read-only._")
    let mut rs = []
    rs = rs + [check_ssh_rc()]
    rs = rs + [check_sshd_config()]
    rs = rs + [check_authorized_keys()]
    rs = rs + [check_sshd_log()]
    rs = rs + [check_launchd()]
    check_identity()
    print_summary(rs)
}
