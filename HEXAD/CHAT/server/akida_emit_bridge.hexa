"""akida_emit_bridge.hexa — R1 wiring: make the on-chip AKD1000 spike co-gate the CLM emit.

R0 closed the loop (motivation → set_threshold → on-chip threshold-and-fire → spike
telemetry on /ws/akida). R1 makes those spikes *carry words*: the emit decision in
`anima_participant.AnimaState.tick(threshold, hw_gate=...)` is co-gated by a hardware-spike
edge derived here, so anima generates+pushes text only when BOTH the substrate motivation
crosses its (dream-modulated) threshold AND the chip actually fired.

Substrate-native (a_substrate_native_speak): the chip's fire IS the substrate emitting on
silicon — not a stimulus-response trigger. H_904 ★ 🟢 confirmed on-chip learning is HW≠SW
on this very device; this bridge gates EMIT (inference) on the chip's spike, which is
byte-identical HW==SW (H_877) — so the gate is deterministic + safe to mirror in SW.

The bridge holds NO model and makes NO generation decision; it only converts the raw spike
stream into a boolean `hw_gate` over a sliding window (edge-triggered, matching the
integrated_loop_vp21 `hw_edge` pattern).

Wiring (see CLM/R1_EMIT_WIRING.md):
    bridge = AkidaEmitBridge()
    # in the /ws/akida ingest path:   bridge.feed(akida_msg)
    # in the ticker, per tick:        decision = state.tick(thr, hw_gate=bridge.hw_gate())

Default-safe: with no spikes fed (no hardware attached), hw_gate() returns `gate_when_idle`
(default True) so the software-only loop behaves exactly as before R1 — the hardware
co-gate only *narrows* emission once spikes flow.
"""
from __future__ import annotations

import time
from collections import deque
from typing import Any

# Edge thresholds — mirror integrated_loop_vp21_akida.py (hw_edge >=40 spikes / 1.0s window).
WINDOW_S: float = 1.0          # sliding window width (seconds)
SPIKE_EDGE_N: int = 40         # >= this many spikes in-window -> hardware says "fire"
GATE_HOLD_S: float = 0.6       # once an edge fires, hold the gate open this long
STALE_AFTER_S: float = 5.0     # no spike telemetry for this long -> treat hardware as absent


class AkidaEmitBridge:
    """Converts the raw /ws/akida spike stream into a boolean emit co-gate.

    Stateless w.r.t. the model; pure spike->bool. Safe for the single-writer (ingest) +
    single-reader (ticker) pattern used by the broker.
    """

    def __init__(
        self,
        window_s: float = WINDOW_S,
        spike_edge_n: int = SPIKE_EDGE_N,
        gate_hold_s: float = GATE_HOLD_S,
        stale_after_s: float = STALE_AFTER_S,
        gate_when_idle: bool = True,
    ) -> None:
        self.window_s = window_s
        self.spike_edge_n = spike_edge_n
        self.gate_hold_s = gate_hold_s
        self.stale_after_s = stale_after_s
        # gate_when_idle: what hw_gate() returns before ANY spike telemetry arrives
        # (or after it goes stale). True = software-only behaviour (R0 parity).
        self.gate_when_idle = gate_when_idle
        self._events: deque[tuple[float, int]] = deque()  # (monotonic_ts, n_spikes)
        self._last_feed_ts: float | None = None
        self._edge_until: float = 0.0

    def feed(self, akida_msg: dict[str, Any], now: float | None = None) -> None:
        """Ingest one /ws/akida telemetry message.

        Expected shape (broker fan-out): {"n_spikes": int, "step": int, "thr": [..], ...}.
        Only `n_spikes` is consumed; other fields are ignored.
        """
        now = time.monotonic() if now is None else now
        n = int(akida_msg.get("n_spikes", 0) or 0)
        self._events.append((now, n))
        self._last_feed_ts = now
        self._prune(now)
        if self._window_count(now) >= self.spike_edge_n:
            self._edge_until = now + self.gate_hold_s

    def hw_gate(self, now: float | None = None) -> bool:
        """True iff the hardware currently licenses an emit (edge held), else False.

        Returns `gate_when_idle` when no (or stale) telemetry — so a software-only
        deployment is unaffected until real spikes flow.
        """
        now = time.monotonic() if now is None else now
        if self._last_feed_ts is None or (now - self._last_feed_ts) > self.stale_after_s:
            return self.gate_when_idle
        self._prune(now)
        return now <= self._edge_until

    def state(self, now: float | None = None) -> dict[str, Any]:
        """Diagnostic snapshot (for /ws/akida telemetry or logs)."""
        now = time.monotonic() if now is None else now
        stale = self._last_feed_ts is None or (now - self._last_feed_ts) > self.stale_after_s
        return {
            "hw_gate": self.hw_gate(now),
            "window_spikes": self._window_count(now),
            "edge_active": now <= self._edge_until,
            "stale": stale,
            "gate_when_idle": self.gate_when_idle,
        }

    # --- internals ---
    def _prune(self, now: float) -> None:
        cutoff = now - self.window_s
        while self._events and self._events[0][0] < cutoff:
            self._events.popleft()

    def _window_count(self, now: float) -> int:
        self._prune(now)
        return sum(n for _, n in self._events)
