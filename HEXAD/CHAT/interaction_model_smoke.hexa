// ════════════════════════════════════════════════════════════════════════════
//  interaction_model_smoke.hexa — F-CHANNEL-MUX 5/5 + F-INTERACT 1..5 witness
//
//  Phase C1 (channel-mux skeleton) + Phase C2 (Interaction Model 패턴) 의
//  compiled-native witness. PLAN.md §3 Phase C falsifier 사전등록:
//
//    F-CHANNEL-MUX-1  register / unregister
//    F-CHANNEL-MUX-2  active count
//    F-CHANNEL-MUX-3  distinct kinds (≥3)
//    F-CHANNEL-MUX-4  broadcast set-cover invariant
//    F-CHANNEL-MUX-5  watch mode predicate
//
//    F-INTERACT-1     200ms micro-turn + 400ms latency target (sympy lift)
//    F-INTERACT-2     barge-in (user mid-emission → interrupt)
//    F-INTERACT-3     backchanneling (low confidence → marker)
//    F-INTERACT-4     channel-mux integration (≥3 kind)
//    F-INTERACT-5     anima watch mode (user_silence + ≥1 active channel)
//
//  Canonical 🔵 sympy: blue_falsifier.py bchannel_mux() + binteract().
//
//  SSOT: HEXAD/CHAT/PLAN.md Phase C1/C2 + falsifier 사전등록
//        HEXAD/CHAT/SPONTANEOUS.tape §8 @X x_murati_interaction_model
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/CHAT/channel_mux_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/interaction_model_lib.hexa"


fn _selftest() {
    print("--- F-CHANNEL-MUX-1..5 + F-INTERACT-1..5 compiled-native witness ---")

    // ── §1 channel-mux setup (3 known channel names) ──────────────────────
    let mut reg = channel_mux_new()
    let rec_cli   = channel_record_create("cli-stdin",  channel_kind_text_cli(),
                                          "send_stdout", "recv_stdin")
    let rec_tl    = channel_record_create("tl-udp",     channel_kind_tension_link(),
                                          "send_udp",    "recv_udp")
    let rec_voice = channel_record_create("voice-rvq",  channel_kind_voice(),
                                          "send_pcm",    "recv_pcm")

    // ── F-CHANNEL-MUX-1 register / unregister ────────────────────────────
    reg = channel_mux_register(reg, rec_cli)
    let f_mux1a_has_cli = channel_mux_has(reg, "cli-stdin")
    reg = channel_mux_register(reg, rec_tl)
    reg = channel_mux_register(reg, rec_voice)
    let f_mux1b_has_all = channel_mux_has(reg, "cli-stdin")
                       && channel_mux_has(reg, "tl-udp")
                       && channel_mux_has(reg, "voice-rvq")
    // unregister cli, others remain
    reg = channel_mux_unregister(reg, "cli-stdin")
    let f_mux1c_after_unreg = (channel_mux_has(reg, "cli-stdin") == false)
                           && channel_mux_has(reg, "tl-udp")
                           && channel_mux_has(reg, "voice-rvq")
    // re-register cli for downstream tests
    reg = channel_mux_register(reg, rec_cli)
    let f_mux1_pass = f_mux1a_has_cli && f_mux1b_has_all && f_mux1c_after_unreg
    print("  F-CHANNEL-MUX-1 register/unregister (3 add + 1 remove + re-add): " + to_string(f_mux1_pass))

    // ── F-CHANNEL-MUX-2 active count (0 → 2 → 3) ─────────────────────────
    let c_initial = channel_mux_active_count_3kinds(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux2a_zero = (c_initial == 0)
    reg = channel_mux_activate(reg, "cli-stdin")
    reg = channel_mux_activate(reg, "tl-udp")
    let c_mid = channel_mux_active_count_3kinds(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux2b_two = (c_mid == 2)
    reg = channel_mux_activate(reg, "voice-rvq")
    let c_full = channel_mux_active_count_3kinds(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux2c_three = (c_full == 3)
    let f_mux2_pass = f_mux2a_zero && f_mux2b_two && f_mux2c_three
    print("  F-CHANNEL-MUX-2 active count (0 → 2 → 3 monotone): " + to_string(f_mux2_pass))

    // ── F-CHANNEL-MUX-3 distinct kinds ≥ 3 ───────────────────────────────
    let k_count = channel_mux_distinct_kinds_count(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux3a_ge3 = (k_count >= 3)
    let f_mux3b_kind_count_const = (channel_kind_count() == 3)
    let f_mux3c_kinds_valid =
        channel_kind_valid("text_cli")
        && channel_kind_valid("tension_link")
        && channel_kind_valid("voice")
        && (channel_kind_valid("bogus") == false)
    let f_mux3_pass = f_mux3a_ge3 && f_mux3b_kind_count_const && f_mux3c_kinds_valid
    print("  F-CHANNEL-MUX-3 distinct kinds ≥3 + enum closed: " + to_string(f_mux3_pass))

    // ── F-CHANNEL-MUX-4 broadcast set-cover invariant ─────────────────────
    // broadcast_simulate_count == active_count (one dispatch per active ch)
    let bcast_n = broadcast_simulate_count(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux4a_setcover = (bcast_n == c_full)
    // deactivate voice → broadcast count drops by 1
    reg = channel_mux_deactivate(reg, "voice-rvq")
    let bcast_after_deact = broadcast_simulate_count(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux4b_dec = (bcast_after_deact == 2)
    let f_mux4_pass = f_mux4a_setcover && f_mux4b_dec
    print("  F-CHANNEL-MUX-4 broadcast set-cover invariant + deactivation: " + to_string(f_mux4_pass))

    // ── F-CHANNEL-MUX-5 watch mode predicate ─────────────────────────────
    // user_silence=true + ≥1 active → watch ON
    let w_on  = watch_mode_active(reg, true,  "cli-stdin", "tl-udp", "voice-rvq")
    let w_off_no_silence = watch_mode_active(reg, false, "cli-stdin", "tl-udp", "voice-rvq")
    let f_mux5_pass = w_on && (w_off_no_silence == false)
    print("  F-CHANNEL-MUX-5 watch mode (silence+active vs no-silence): " + to_string(f_mux5_pass))

    // re-activate voice for downstream
    reg = channel_mux_activate(reg, "voice-rvq")

    // ── F-INTERACT-1 200ms micro-turn + 400ms latency target ─────────────
    let mt = micro_turn_duration_ms()
    let lat = emission_latency_target_ms()
    let twin = turns_per_emission_window()
    let f_int1a_mt200 = (mt == 200)
    let f_int1b_lat400 = (lat == 400)
    let f_int1c_window2 = (twin == 2)
    // turn-taking floor witnesses
    let f_int1d_boundary = turn_taking_floor_ok(400)         // 400 → true (inclusive)
    let f_int1e_below    = (turn_taking_floor_ok(399) == false)
    let f_int1f_above    = turn_taking_floor_ok(401)
    let f_int1_pass = f_int1a_mt200 && f_int1b_lat400 && f_int1c_window2
                   && f_int1d_boundary && f_int1e_below && f_int1f_above
    print("  F-INTERACT-1 micro_turn=200ms · latency=400ms · floor inclusive: " + to_string(f_int1_pass))

    // ── F-INTERACT-2 barge-in (user mid-emission → interrupt) ────────────
    let bi_t1 = barge_in_detected(true, true)              // both true → barge
    let bi_t2 = (barge_in_detected(true, false) == false)  // not emitting → no barge
    let bi_t3 = (barge_in_detected(false, true) == false)  // no input → no barge
    let bi_t4 = (barge_in_detected(false, false) == false) // neither → no barge
    let bi_with_safety = barge_in_should_interrupt(true, true, true)
    let bi_safety_off  = (barge_in_should_interrupt(true, true, false) == false)
    let f_int2_pass = bi_t1 && bi_t2 && bi_t3 && bi_t4 && bi_with_safety && bi_safety_off
    print("  F-INTERACT-2 barge_in (4 truth-table + safety override): " + to_string(f_int2_pass))

    // ── F-INTERACT-3 backchanneling (low confidence → marker) ────────────
    let lo_thr = backchannel_default_low_threshold()       // 0.3
    let bc_low_emit  = backchannel_should_emit(0.1, lo_thr)     // 0.1 < 0.3 → true
    let bc_high_no   = (backchannel_should_emit(0.7, lo_thr) == false)
    let bc_boundary  = (backchannel_should_emit(0.3, lo_thr) == false) // strict <
    let bc_n_markers = (backchannel_marker_count() == 3)
    let bc_m0_nonempty = to_string(backchannel_marker(0)) != ""
    let bc_m1_nonempty = to_string(backchannel_marker(1)) != ""
    let bc_m2_nonempty = to_string(backchannel_marker(2)) != ""
    let f_int3_pass = bc_low_emit && bc_high_no && bc_boundary
                   && bc_n_markers && bc_m0_nonempty && bc_m1_nonempty && bc_m2_nonempty
    print("  F-INTERACT-3 backchannel (low<0.3 emit + ≥3 markers): " + to_string(f_int3_pass))

    // ── F-INTERACT-4 channel-mux ≥3 kind integration ─────────────────────
    // 3 kinds 모두 active 검증 (re-using §C1 registry)
    let k_again = channel_mux_distinct_kinds_count(reg, "cli-stdin", "tl-udp", "voice-rvq")
    let f_int4a = (k_again >= 3)
    // simultaneous predicate composes
    let f_int4b = simultaneous_active(true, true)
    let f_int4c = (simultaneous_active(true, false) == false)
    let f_int4d = (simultaneous_active(false, true) == false)
    let f_int4_pass = f_int4a && f_int4b && f_int4c && f_int4d
    print("  F-INTERACT-4 channel-mux ≥3 + simultaneous thinker-talker AND: " + to_string(f_int4_pass))

    // ── F-INTERACT-5 anima watch mode ────────────────────────────────────
    // user_silence + ≥1 active channel + motivation > imThreshold
    let wm_motiv_on  = watch_motivation_ok(0.5, 0.3)            // 0.5 > 0.3
    let wm_motiv_off = (watch_motivation_ok(0.2, 0.3) == false) // 0.2 < 0.3
    let wm_silence_on = watch_mode_active(reg, true, "cli-stdin", "tl-udp", "voice-rvq")
    // decision composite: barge=false, backchannel=false, full_emit_ok=true → 3
    let d_full = interaction_step_decision(false, false, true)
    let d_bc   = interaction_step_decision(false, true,  false)
    let d_int  = interaction_step_decision(true,  false, true)
    let d_idle = interaction_step_decision(false, false, false)
    let f_int5a = (d_full == 3) && (d_bc == 2) && (d_int == 4) && (d_idle == 1)
    let f_int5b = to_string(interaction_step_label(3)) == "full_emit"
               && to_string(interaction_step_label(4)) == "interrupt"
               && to_string(interaction_step_label(2)) == "backchannel"
               && to_string(interaction_step_label(1)) == "continue_thinking"
    let f_int5_pass = wm_motiv_on && wm_motiv_off && wm_silence_on && f_int5a && f_int5b
    print("  F-INTERACT-5 anima watch mode (motivation+silence+decision 4-way): " + to_string(f_int5_pass))

    let all_pass = f_mux1_pass && f_mux2_pass && f_mux3_pass && f_mux4_pass && f_mux5_pass
                && f_int1_pass && f_int2_pass && f_int3_pass && f_int4_pass && f_int5_pass
    // PASS_MARKER 패턴 매치 (build_verify.sh expects "selftest: true" or "7/7 cross-file")
    print("=== F-CHANNEL-MUX-1..5 + F-INTERACT-1..5 compiled-native selftest: " + to_string(all_pass) + " (10/10) ===")
    print("    canonical 🔵 sympy : blue_falsifier.py bchannel_mux() + binteract()")
    print("    Murati spec carry  : 200ms micro-turn + 400ms latency target (text-only sim)")
    print("    B-CHANNEL-MUX-NOTE : real I/O dispatch (UDP/audio) = future RFC (audio-native)")
}


fn main() {
    print("HEXAD/CHAT — interaction_model_smoke (Phase C1+C2, F-CHANNEL-MUX + F-INTERACT compiled-native)")
    _selftest()
}
