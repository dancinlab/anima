import "/Users/ghost/core/anima/HEXAD/CHAT/spontaneous_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/thinker_talker_lib.hexa"


fn _approx_eq(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}


fn _selftest() {
    let tol = 1e-6

    print("--- F-SPONT-1..7 compiled-native witness ---")

    // ── F-SPONT-1 trigger mechanism (motivation_score gate + 3 trigger 종) ─
    // unit input: Φ=0.5, retrieve_sim=0.2 (gap=0.8), curiosity=0.7,
    //              tension=0.4, gate=0.5 (interior, coh=1.0), split=true,
    //              ratchet=0.5 → balance=(0.5>0.25)=true, silence=10s (dyn=0.33)
    let score_high = thinker_step(0.5, 0.2, 0.7, 0.4, 0.5, true, 0.5, 10.0)
    let f1a_emit = talker_should_emit(score_high, true)
    // low motivation: Φ=0.0, sim=1.0 (gap=0), cur=0.0, pain=0, coh=0
    //                  (gate=0.6 far from 0.5±0.014), orig=false, bal=false,
    //                  dyn=0 (silence 0s)
    let score_low = thinker_step(0.0, 1.0, 0.0, 0.0, 0.6, false, 0.5, 0.0)
    let f1b_no_emit = (talker_should_emit(score_low, true) == false)
    // safety off → emit blocked even with high score
    let f1c_safety_block = (talker_should_emit(score_high, false) == false)
    let f1_pass = f1a_emit && f1b_no_emit && f1c_safety_block
    print("  F-SPONT-1 trigger mechanism (high→emit, low→block, safety-off→block): " + to_string(f1_pass))

    // ── F-SPONT-2 seed strategy rotation (≥3 weighted) ───────────────────
    let f2a_count = spont_seed_strategy_count() >= 3
    let f2b_distinct_names =
        to_string(spont_seed_strategy_name(0)) == "m_retrieve_seed"
        && to_string(spont_seed_strategy_name(1)) == "w_curiosity_peak_seed"
        && to_string(spont_seed_strategy_name(2)) == "random_explore_seed"
        && to_string(spont_seed_strategy_name(3)) == "self_monologue_seed"
    let sum_w = spont_seed_strategy_weight(0) + spont_seed_strategy_weight(1)
              + spont_seed_strategy_weight(2) + spont_seed_strategy_weight(3)
    let f2c_weight_sum_unity = _approx_eq(sum_w, 1.0, tol)
    let f2_pass = f2a_count && f2b_distinct_names && f2c_weight_sum_unity
    print("  F-SPONT-2 seed strategy rotation (4≥3 + distinct + Σw=1): " + to_string(f2_pass))

    // ── F-SPONT-3 rejection sampler (gibberish auto-filter) ──────────────
    let f3a_empty_rejected = should_reject_emit("")
    let f3b_normal_accepted = (should_reject_emit("안녕, 나는 anima 야") == false)
    let f3_pass = f3a_empty_rejected && f3b_normal_accepted
    print("  F-SPONT-3 rejection sampler (empty→reject, normal→accept): " + to_string(f3_pass))

    // ── F-SPONT-4 audit log entry (canonical string repr) ────────────────
    let entry_accept = audit_entry_accepted(0.42, 0, true)
    let entry_reject = audit_entry_accepted(0.10, 2, false)
    // entry should contain ACCEPT/REJECT + score + strategy name
    let f4a = to_string(entry_accept) != "" && to_string(entry_reject) != ""
    let f4_pass = f4a
    print("  F-SPONT-4 audit log entry (string canon): " + to_string(f4_pass))

    // ── F-SPONT-5 safety controls 6/6 (kill / rate / phi-ratchet / content
    //                                    + composite + interval) ──────────
    let f5a_kill_default_on = safety_kill_switch_on(false)            // env_off=false → ON
    let f5b_kill_disabled  = (safety_kill_switch_on(true) == false)  // env_off=true → OFF
    let f5c_rate_30s_ok    = safety_rate_limit_ok(30.0)
    let f5d_rate_5s_block  = (safety_rate_limit_ok(5.0) == false)
    let f5e_phi_ratchet_ok = safety_phi_ratchet_ok(0.6, 0.5)          // 0.6 > 0.25 ✓
    let f5f_phi_ratchet_block = (safety_phi_ratchet_ok(0.1, 0.5) == false)  // 0.1 < 0.25
    let f5g_combined_all_true  = safety_combined(true, true, true, true)
    let f5h_combined_any_false = (safety_combined(true, false, true, true) == false)
    let f5_pass = f5a_kill_default_on && f5b_kill_disabled
               && f5c_rate_30s_ok && f5d_rate_5s_block
               && f5e_phi_ratchet_ok && f5f_phi_ratchet_block
               && f5g_combined_all_true && f5h_combined_any_false
    print("  F-SPONT-5 safety controls (kill/rate/phi-ratchet/combined 8 check): " + to_string(f5_pass))

    // ── F-SPONT-6 self-aware meta-emission flag (L1) ─────────────────────
    let f6a_off_default = (spont_meta_tag_enabled(false) == false)
    let f6b_on_explicit = spont_meta_tag_enabled(true)
    let f6c_prefix_nonempty = to_string(spont_meta_prefix()) != ""
    // assemble emission with meta tag
    let emit_with_meta = assemble_emission(true, 0, "test")
    let emit_no_meta = assemble_emission(false, 0, "test")
    let f6d_meta_distinct = to_string(emit_with_meta) != to_string(emit_no_meta)
    let f6_pass = f6a_off_default && f6b_on_explicit && f6c_prefix_nonempty && f6d_meta_distinct
    print("  F-SPONT-6 meta-emission L1 flag (off-default, on-explicit, distinct): " + to_string(f6_pass))

    // ── F-SPONT-7 ≥30s interval constraint (transfer-form 🔵; outcome
    //              empirical NOTE) ───────────────────────────────────────
    let f7a_30s_boundary = safety_rate_limit_ok(30.0)
    let f7b_29s_blocked  = (safety_rate_limit_ok(29.999) == false)
    let f7c_31s_ok       = safety_rate_limit_ok(31.0)
    // 5-emission scenario simulation: each separated by 30+ sec → all pass
    let f7d_emit_1 = safety_rate_limit_ok(30.0)
    let f7d_emit_2 = safety_rate_limit_ok(31.5)
    let f7d_emit_3 = safety_rate_limit_ok(60.0)
    let f7d_emit_4 = safety_rate_limit_ok(90.0)
    let f7d_emit_5 = safety_rate_limit_ok(150.0)
    let f7d_5emit_chain = f7d_emit_1 && f7d_emit_2 && f7d_emit_3
                        && f7d_emit_4 && f7d_emit_5
    let f7_pass = f7a_30s_boundary && f7b_29s_blocked && f7c_31s_ok && f7d_5emit_chain
    print("  F-SPONT-7 ≥30s interval + 5-chain (transfer-form 🔵; outcome NOTE): " + to_string(f7_pass))

    let all_ok = f1_pass && f2_pass && f3_pass && f4_pass && f5_pass && f6_pass && f7_pass
    // PASS_MARKER 패턴 매치 (build_verify.sh expects "selftest: true" or "7/7 cross-file")
    print("=== F-SPONT-1..7 compiled-native selftest: " + to_string(all_ok) + " (7/7) ===")
    print("    canonical 🔵 sympy : blue_falsifier.py bspont() (B-SPONT-1..7)")
    print("    pass_strict carry  : PASS_STRICT_SPONTANEOUS_CHAT.md (2026-05-12)")
    print("    B-SPONT-NOTE       : emission coherence outcome empirical")
    print("                          (B-D-NOTE pattern, NOT counted 🔵)")
}


fn main() {
    print("HEXAD/CHAT — spontaneous_smoke (Phase B3, F-SPONT-1..7 compiled-native)")
    _selftest()
}
