// ════════════════════════════════════════════════════════════════════════════
//  spont_tension_bridge_lib.hexa — SPONTANEOUS ↔ TENSION-TRAIN bridge (Phase TT-C)
//
//  HEXAD/CHAT/SPONTANEOUS.tape (8-factor motivation × HEXAD × Thinker-Talker
//  dual-thread) ↔ HEXAD/TENSION-TRAIN/training/tension_link_step.hexa
//  (ΔW = −T_const · tension · gate) 의 closed-form interface.
//
//  Mapping (pure-fn, sympy-verifiable):
//    motivation_to_tension(score) = 2·(score − 0.5)   // [0,1] → [-1,+1] = Ψ_t − Ψ_vac axis
//    motivation_to_delta_w(score, t_const, gate) = if gate then −t_const · tension else 0
//    should_learn_step(motivation, threshold)     = motivation > threshold (Boolean)
//
//  Symmetry (architectural, per SPONTANEOUS.tape §tension_train_integration):
//    talker_should_emit  (motivation → EMISSION decision)   ⊥
//    should_learn_step   (motivation → LEARNING decision)   — emit ≠ learn
//
//  Closed anchors (B-TT-SPONT-1..5 sympy battery, blue_falsifier.py):
//    linear map closure  + restoring sign sympy ∂  + Boolean clamp +
//    monotone predicate  + composition law (motivation→tension→ΔW)
//
//  SSOT:
//    HEXAD/CHAT/SPONTANEOUS.tape § tension_train_integration
//    HEXAD/TENSION-TRAIN/TENSION-TRAIN.tape @D spont_integration
//    HEXAD/TENSION-TRAIN/PLAN.md Phase TT-C
//
//  compiled-first lib (NO main · NO _selftest · NO top-level call).
// ════════════════════════════════════════════════════════════════════════════


// ── §1 motivation_to_tension — affine map [0, 1] → [−1, +1] ──────────────────
//
// Rationale: motivation_score ∈ [0, 1] (B-SPONT-3 SCORE-BOUNDED closed).
// tension axis = Ψ_t − Ψ_vac, where Ψ_vac = 0.5 (Law 75 vacuum attractor,
// tension_link_step.hexa VAC_COMPONENT). Affine lift: tension = 2·(s − 0.5)
// places s=0.5 at vacuum (0.0 tension), s=1.0 at +1 (maximal push above), and
// s=0.0 at −1 (maximal push below). Closed-form sympy linear: ∂tension/∂s = 2.
fn motivation_to_tension(score: float) -> float {
    return 2.0 * (score - 0.5)
}


// ── §2 motivation_to_delta_w — composition with restoring sign + gate clamp ──
//
// ΔW = −T_const · tension · gate  (mirrors tension_link_step.hexa spine).
// gate=false → ΔW = 0 (Boolean clamp, B-SPONT-FACTOR-6 originality pattern +
// n6_gate AN14 closure). Sign convention: ΔW opposes tension (restoring toward
// Ψ_vac = 0.5) ⇒ sign(ΔW) · sign(tension) ≤ 0 ∀ t_const > 0, gate = true.
// sympy ∂(ΔW)/∂(tension) = −t_const < 0 (B-TT-2 mirror).
fn motivation_to_delta_w(score: float, t_const: float, gate: bool) -> float {
    if gate == false { return 0.0 }
    let tension = motivation_to_tension(score)
    return 0.0 - t_const * tension
}


// ── §3 should_learn_step — learning trigger (Boolean, ⊥ to emit) ─────────────
//
// Closed predicate: motivation > threshold. Identical structure to
// should_emit (B-SPONT-4 THRESHOLD-MONOTONE) but ORTHOGONAL decision:
//   should_emit       = motivation > im_threshold       (TALKER  emit?)
//   should_learn_step = motivation > learn_threshold    (THINKER learn?)
// thresholds 분리 → emit ≠ learn (architectural ⊥). default 0.3 = anima_alive
// PROACTIVE_THRESHOLD, but caller-supplied (B-TT-SPONT-4 monotone in motivation).
fn should_learn_step(motivation: float, threshold: float) -> bool {
    return motivation > threshold
}


// ── §4 default learning threshold ────────────────────────────────────────────
//
// Same numeric anchor as spont_im_threshold (anima_alive PROACTIVE_THRESHOLD=0.3),
// but conceptually independent — caller may override. Closed numeric constant.
fn spont_tension_default_learn_threshold() -> float {
    return 0.3
}


// ── §5 default T_const (mirrors tension_link_step.hexa T_CONST) ──────────────
//
// Lindblad-rate-class scalar. B-TT-3 T-CONST-SCALAR-POSITIVE closed (0.1 > 0).
fn spont_tension_default_t_const() -> float {
    return 0.1
}
