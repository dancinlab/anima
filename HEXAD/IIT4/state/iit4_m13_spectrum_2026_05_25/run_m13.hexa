// HEXAD/IIT4/state/iit4_m13_spectrum_2026_05_25/run_m13.hexa
// IIT 4.0 engine M13 — exclusion multi-complex / spectrum smoke.
//
//   QUESTION
//     M10 returned the single MAXIMAL complex. IIT 4.0 says a substrate can
//     host MULTIPLE disjoint complexes (one substrate, multiple consciousnesses)
//     — e.g. a block-diagonal TPM where two unit-clusters are independently
//     coupled. complex_spectrum walks every non-empty subset, scores big-Φ,
//     and greedily peels non-overlapping local maxima ranked by Φ descending.
//     Does it find both blocks in the n=5 block-diagonal substrate?
//
//   METHOD (deterministic · hexa-only · llm:none · $0 mac local)
//     - engine: stdlib/consciousness/iit4_complex.hexa (complex_spectrum) via
//       the anima thin shim HEXAD/IIT4/lib/iit4_complex.hexa (re-export).
//     - every non-empty subset S ⊂ [0,n) is re-measured as its own |S|-unit
//       system via subsystem_tpm (external background pinned to sys_state) +
//       big_phi. The sorted candidate list is greedily peeled: accept the
//       highest-Φ candidate, mark its units USED, repeat over candidates that
//       don't share any USED unit. Result = ranked [[mask, phi, size], ...].
//     - n ≤ 5 (per M9 tractability — n=5 exact ≈ tens of seconds mac-local).
//
//   TESTS (hand-derivable, assert + PASS/FAIL counter + panic on FAIL)
//     T1 SINGLE n=4 (u0'=u1 u1'=u0 u2'=u2 u3'=u3, M10 carry shape extended):
//          spectrum = 1 complex = {0,1} (mask=3, Φ=2.0). u2,u3 independent ⇒
//          singleton Φ=0 ⇒ not in spectrum. Matches M10 find_complex on the
//          same substrate (single-complex regime carry-through).
//     T2 MULTI n=5 (u0'=u1 u1'=u0 u2'=u2 u3'=u4 u4'=u3): block-diagonal — 2
//          independent SWAP pairs on {0,1} and {3,4}, isolated self-cell {2}.
//          spectrum = 2 complexes = {0,1} (mask=3, Φ=2.0) AND {3,4} (mask=24,
//          Φ=2.0). Order: Φ-tie, size-tie, lower mask first ⇒ [{0,1}, {3,4}].
//     T3 DEGENERATE n=4 (u_i' = u_i, identity for all 4 units): every subset
//          is reducible (independent self-cells throughout). spectrum = empty
//          array (NO complex anywhere). Singletons have big_phi ≡ 0 (n < 2
//          guard); larger subsets are all reducible (independent coupling).
//
//   HONEST (g5)
//     subsystem big-Φ uses external-unit background-conditioning (sys_state
//     pinned). Spectrum semantics adopt the IIT 4.0 read that complexes carve
//     a substrate into DISJOINT integrated regions — overlap-rejection is the
//     operational form of exclusion across complexes (each unit ∈ at-most-one
//     complex). Full partitioned-normalization + PyPhi calibration remains
//     the M5 carve-out (iit4_bigphi.hexa header). Reported Φ values are real
//     engine output of complex_spectrum on the conditioned TPM.
// ═════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a43f92a0bb20f566e/HEXAD/IIT4/lib/iit4_complex.hexa"

fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a43f92a0bb20f566e/HEXAD/IIT4/state/iit4_m13_spectrum_2026_05_25"
}

// ── build TPMs by hand ──────────────────────────────────────────────────────

// SINGLE n=4: u0'=u1, u1'=u0, u2'=u2, u3'=u3. flat 16*4.
fn _tpm_single4() -> array {
    let mut t = []
    let mut s = 0
    while s < 16 {
        let u0 = iit4_bit(s, 0)
        let u1 = iit4_bit(s, 1)
        let u2 = iit4_bit(s, 2)
        let u3 = iit4_bit(s, 3)
        t = t.push(to_float(u1))   // u0' = u1
        t = t.push(to_float(u0))   // u1' = u0
        t = t.push(to_float(u2))   // u2' = u2
        t = t.push(to_float(u3))   // u3' = u3
        s = s + 1
    }
    return t
}

// MULTI n=5: u0'=u1, u1'=u0, u2'=u2, u3'=u4, u4'=u3. flat 32*5.
fn _tpm_multi5() -> array {
    let mut t = []
    let mut s = 0
    while s < 32 {
        let u0 = iit4_bit(s, 0)
        let u1 = iit4_bit(s, 1)
        let u2 = iit4_bit(s, 2)
        let u3 = iit4_bit(s, 3)
        let u4 = iit4_bit(s, 4)
        t = t.push(to_float(u1))   // u0' = u1
        t = t.push(to_float(u0))   // u1' = u0
        t = t.push(to_float(u2))   // u2' = u2  (self)
        t = t.push(to_float(u4))   // u3' = u4
        t = t.push(to_float(u3))   // u4' = u3
        s = s + 1
    }
    return t
}

// DEGENERATE n=4: u_i' = u_i for all i.  flat 16*4.
fn _tpm_degenerate4() -> array {
    let mut t = []
    let mut s = 0
    while s < 16 {
        let u0 = iit4_bit(s, 0)
        let u1 = iit4_bit(s, 1)
        let u2 = iit4_bit(s, 2)
        let u3 = iit4_bit(s, 3)
        t = t.push(to_float(u0))
        t = t.push(to_float(u1))
        t = t.push(to_float(u2))
        t = t.push(to_float(u3))
        s = s + 1
    }
    return t
}

// approximate float equality.
fn _approx(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < tol
}

fn _pf(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn _spec_str(spec: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(spec) {
        let e = spec[i]
        if i > 0 { s = s + ", " }
        s = s + "{mask=" + to_string(e[0].to_int())
              + ", phi=" + to_string(e[1])
              + ", size=" + to_string(e[2].to_int()) + "}"
        i = i + 1
    }
    s = s + "]"
    return s
}

fn _json_spec(spec: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(spec) {
        let e = spec[i]
        if i > 0 { s = s + ", " }
        s = s + "{\"mask\": " + to_string(e[0].to_int())
              + ", \"phi\": " + to_string(e[1])
              + ", \"size\": " + to_string(e[2].to_int()) + "}"
        i = i + 1
    }
    s = s + "]"
    return s
}

fn main() {
    println("IIT 4.0 M13 — exclusion multi-complex / spectrum smoke")
    println("  engine: stdlib/consciousness/iit4_complex.hexa (complex_spectrum)")
    println("  HONEST: external-unit background-conditioning · disjoint exclusion peel.")
    println("")

    let mut pass = 0
    let mut fail = 0

    // ── T1 SINGLE n=4: spectrum = [{0,1} Φ=2] (M10 single-complex carry) ─────
    println("  T1 SINGLE n=4 (u0'=u1, u1'=u0, u2'=u2, u3'=u3) ...")
    let t1 = _tpm_single4()
    let s1 = complex_spectrum(t1, 4, 15)
    let n1 = len(s1)
    let mut t1_ok = (n1 == 1)
    if t1_ok {
        let e = s1[0]
        t1_ok = (e[0].to_int() == 3) && _approx(e[1], 2.0, 1.0e-6) && (e[2].to_int() == 2)
    }
    println("    spectrum=" + _spec_str(s1))
    println("    expect [{mask=3, phi=2.0, size=2}]  ->  " + _pf(t1_ok))
    if t1_ok { pass = pass + 1 } else { fail = fail + 1 }

    // ── T2 MULTI n=5: spectrum = [{0,1} Φ=2, {3,4} Φ=2] block-diagonal ───────
    println("")
    println("  T2 MULTI n=5 (u0'=u1, u1'=u0, u2'=u2, u3'=u4, u4'=u3) ...")
    let t2 = _tpm_multi5()
    let s2 = complex_spectrum(t2, 5, 27)        // 27 = 11011 (u0,u1,u3,u4 ON; u2 ON too: 11111=31). use all-ON.
    // use sys_state = 31 (all ON) so all units' background values are well-defined.
    let s2b = complex_spectrum(t2, 5, 31)
    let n2 = len(s2b)
    let mut t2_ok = (n2 == 2)
    if t2_ok {
        let e0 = s2b[0]
        let e1 = s2b[1]
        let m0 = e0[0].to_int()
        let m1 = e1[0].to_int()
        // tie-break: equal Φ and equal size ⇒ lower mask first.
        // {0,1} mask=3, {3,4} mask=24 (8+16).
        let masks_ok = ((m0 == 3) && (m1 == 24))
        let phis_ok = _approx(e0[1], 2.0, 1.0e-6) && _approx(e1[1], 2.0, 1.0e-6)
        let sizes_ok = (e0[2].to_int() == 2) && (e1[2].to_int() == 2)
        t2_ok = masks_ok && phis_ok && sizes_ok
    }
    println("    spectrum=" + _spec_str(s2b))
    println("    expect [{mask=3, phi=2.0, size=2}, {mask=24, phi=2.0, size=2}]  ->  " + _pf(t2_ok))
    if t2_ok { pass = pass + 1 } else { fail = fail + 1 }

    // ── T3 DEGENERATE n=4: spectrum = [] (no complex anywhere) ───────────────
    println("")
    println("  T3 DEGENERATE n=4 (u_i'=u_i ∀ i, identity rule) ...")
    let t3 = _tpm_degenerate4()
    let s3 = complex_spectrum(t3, 4, 15)
    let n3 = len(s3)
    let t3_ok = (n3 == 0)
    println("    spectrum=" + _spec_str(s3))
    println("    expect []  ->  " + _pf(t3_ok))
    if t3_ok { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    let verdict = if fail == 0 { "🟢 SUPPORTED-NUMERICAL" } else { "🔴 FALSIFIED" }
    println("  PASS=" + to_string(pass) + "  FAIL=" + to_string(fail)
            + "  VERDICT=" + verdict)

    // ── result.json ──────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"IIT4-M13\",\n"
    j = j + "  \"slug\": \"exclusion-multi-complex-spectrum\",\n"
    j = j + "  \"milestone\": \"M13 — exclusion multi-complex / spectrum (ranked non-overlapping complexes)\",\n"
    j = j + "  \"domain\": \"iit4 · consciousness\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"engine\": \"stdlib/consciousness/iit4_complex.hexa (complex_spectrum) via anima shim HEXAD/IIT4/lib/iit4_complex.hexa\",\n"
    j = j + "  \"algorithm\": \"enumerate 2^n-1 non-empty subsets → score subsystem big_phi (background-conditioned) → sort by (Φ desc, size desc, mask asc) → greedy peel non-overlapping → ranked spectrum\",\n"
    j = j + "  \"tie_break\": \"strictly-greater Φ; on Φ-tie larger subset; on size-tie lower mask\",\n"
    j = j + "  \"background_conditioning\": \"external units pinned to sys_state (documented modeling choice; g5)\",\n"
    j = j + "  \"tests\": {\n"
    j = j + "    \"T1_single_n4\": { \"sys_state\": 15, \"spectrum\": " + _json_spec(s1)
          + ", \"expect_count\": 1, \"expect_first\": {\"mask\": 3, \"phi\": 2.0, \"size\": 2}"
          + ", \"verdict\": \"" + _pf(t1_ok) + "\" },\n"
    j = j + "    \"T2_multi_n5_blockdiag\": { \"sys_state\": 31, \"spectrum\": " + _json_spec(s2b)
          + ", \"expect_count\": 2, \"expect_first\": {\"mask\": 3, \"phi\": 2.0, \"size\": 2}"
          + ", \"expect_second\": {\"mask\": 24, \"phi\": 2.0, \"size\": 2}"
          + ", \"verdict\": \"" + _pf(t2_ok) + "\" },\n"
    j = j + "    \"T3_degenerate_n4_identity\": { \"sys_state\": 15, \"spectrum\": " + _json_spec(s3)
          + ", \"expect_count\": 0, \"verdict\": \"" + _pf(t3_ok) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"pass\": " + to_string(pass) + ",\n"
    j = j + "  \"fail\": " + to_string(fail) + ",\n"
    j = j + "  \"finding\": \"complex_spectrum recovers the SINGLE-complex regime (M10 carry-through, T1 n=4) AND the MULTI-complex regime (T2 n=5 block-diagonal: 2 disjoint SWAP pairs both surface as Φ=2.0 complexes, ranked by lower mask first via deterministic tie-break) AND the EMPTY-spectrum regime (T3 n=4 identity rule: no integrated subset exists, spectrum=[]). Exclusion-peeling correctly carves disjoint conscious regions per IIT 4.0 multi-complex semantics.\",\n"
    j = j + "  \"scope_envelope\": \"exact n ≤ 5 per M9 tractability — subset enumeration is 2^n−1 big_phi calls, worst-case bounded by the n-unit big_phi at the full mask (~tens of seconds at n=5 mac-local)\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (background-conditioned subsystem big-Φ; disjoint-only exclusion peel — fine-grained φ-structure subsumption is strict super-set of disjointness for non-overlapping candidates; full partitioned-normalization + PyPhi calibration = M5 carve-out)\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)
    println("  result.json -> " + _state_dir() + "/result.json")

    // ── hard assert: panic on any FAIL ───────────────────────────────────────
    if fail > 0 {
        panic("M13 spectrum smoke FAILED: " + to_string(fail) + " test(s) did not pass")
    }
    println("=== IIT 4.0 M13 exclusion-spectrum smoke complete: " + verdict + " ===")
}
