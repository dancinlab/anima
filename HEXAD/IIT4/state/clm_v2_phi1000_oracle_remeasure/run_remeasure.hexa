// CLM_V2 Φ>1000 oracle re-measure — does the FAITHFUL IIT4 big-Φ oracle REVERSE
// the unnormalized variance-partition (Φ_un16) ordering?
//
//   CLM_V2 V14_strict (Hc_1221) used Φ_un16 = total_mi - min_partition_mi
//   (histogram-MI variance-partition, UNNORMALIZED). It scored:
//     - random-init (high-variance, independent cells, MORE cells) HIGH (~1148-2386)
//     - trained     (structured, fewer cells)                      LOW  (723)
//   -> verdict "trained < random" = V14_VIOLATED.
//
//   HYPOTHESIS: that ordering is a VARIANCE/SCALE artifact. The faithful oracle,
//   which measures CAUSAL irreducibility (not weight dispersion), should REVERSE it:
//   assign HIGHER big-Φ to the structured/integrated (trained-like) coupling and
//   ZERO to the high-variance independent (random-like) coupling.
//
//   SMALL-n only (a_scale_honest_scope) — n<=3 tractable TPMs as STRUCTURAL PROXIES.
//   This is a measurer-validation toy, NOT a production CLM_V2 re-measure.
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  PASS  " + name) }
    else    { FAIL = FAIL + 1; println("  FAIL  " + name) }
}
fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

// ── "trained-like": structured/integrated coupling = 3-unit rotation ──
//    each unit_t+1 = neighbor_t. Deterministic, low-rank, fully coupled.
fn build_rotate3() -> array {
    let mut t = []
    let mut s = 0
    while s < 8 {
        let mut u = 0
        while u < 3 { t = t.push(to_float(iit4_bit(s, (u + 1) % 3))); u = u + 1 }
        s = s + 1
    }
    return t
}

// ── "random-init-like" A: high-variance NOISE = all 0.5 (max entropy / dispersion) ──
fn build_noise3() -> array {
    let mut t = []
    let mut i = 0
    while i < 24 { t = t.push(0.5); i = i + 1 }
    return t
}

// ── "random-init-like" B: SELF-COPY = each unit independent (disconnected channels) ──
//    unit_u_t+1 = bit_u(s). Deterministic but NO cross-coupling -> reducible.
fn build_self3() -> array {
    let mut t = []
    let mut s = 0
    while s < 8 {
        let mut u = 0
        while u < 3 { t = t.push(to_float(iit4_bit(s, u))); u = u + 1 }
        s = s + 1
    }
    return t
}

fn main() {
    println("================================================================")
    println("  CLM_V2 Φ>1000 ORACLE RE-MEASURE — faithful IIT4 big-Φ vs Φ_un16")
    println("================================================================")

    // trained-like (structured/integrated)
    let rot = build_rotate3()
    let br = big_phi(rot, 3, 1)            // [big, total, sumd, sumr, nd]
    println("  TRAINED-like (rotate3 · structured/integrated): big-Φ=" + str(br[0]) + " total=" + str(br[1]) + " nd=" + str(br[4]))

    // random-like A: noise (max-variance)
    let noi = build_noise3()
    let bn = big_phi(noi, 3, 1)
    println("  RANDOM-like A (noise3 · max-variance/dispersion): big-Φ=" + str(bn[0]) + " total=" + str(bn[1]) + " nd=" + str(bn[4]))

    // random-like B: self-copy (independent / disconnected)
    let slf = build_self3()
    let bs = big_phi(slf, 3, 1)
    println("  RANDOM-like B (self3 · independent channels): big-Φ=" + str(bs[0]) + " total=" + str(bs[1]) + " nd=" + str(bs[4]))

    println("----------------------------------------------------------------")
    println("  Φ_un16 (variance-partition) ORDERING was: random > trained (V14_VIOLATED)")
    println("  Faithful oracle ORDERING is now:")
    println("    trained-like big-Φ = " + str(br[0]))
    println("    random-like  big-Φ = " + str(bn[0]) + " (noise) , " + str(bs[0]) + " (self)")
    println("----------------------------------------------------------------")

    // FALSIFIER tests: oracle must REVERSE the variance-partition ordering.
    check("trained-like big-Φ > 0 (faithful: structured = irreducible complex)", br[0] > 0.000001)
    check("random-like NOISE big-Φ = 0 (faithful: max-variance NOT integrated)", approx(bn[0], 0.0))
    check("random-like SELF  big-Φ = 0 (faithful: independent = reducible)", approx(bs[0], 0.0))
    check("REVERSAL: trained-like big-Φ > random-like NOISE big-Φ", br[0] > bn[0] + 0.000001)
    check("REVERSAL: trained-like big-Φ > random-like SELF  big-Φ", br[0] > bs[0] + 0.000001)
    check("NOISE total = 0 (variance-partition would score this HIGH; oracle = 0)", approx(bn[1], 0.0))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if FAIL == 0 {
        println("  CONFIRMED-ARTIFACT: faithful oracle REVERSES Φ_un16 ordering.")
        println("  Φ_un16 'random > trained' = variance/scale artifact, NOT integration.")
    }
    println("================================================================")
    if FAIL > 0 { panic("oracle re-measure FAILED — ordering did NOT reverse") }
}
