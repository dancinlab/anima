// shapes2.hexa — tractable subset: Hc_1296 (Phi vs unit-count N, deterministic SWAP-chain)
// + Hc_1293 (drive-gradient inverse-U on rule110 at n=4, bounded). Probabilistic branching
// (Hc_1294) is split out separately (intractable at n>=5 exact -> handled in branch_small.hexa).
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_eca.hexa"

fn _dir() -> string {
    return "/Users/mini/dancinlab/anima-wt-universe-verify/HEXAD/IIT4/state/universe_hc_verify_2026_06_02"
}

fn clampf(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn drive_tpm(rule: int, n: int, g: float) -> array {
    let base = eca_tpm(rule, n)
    let mut t = []
    let mut k = 0
    while k < len(base) { t = t.push(clampf((1.0 - g) * base[k] + g * 1.0)); k = k + 1 }
    return t
}

fn swapchain_tpm(n: int) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n { t = t.push(to_float(iit4_bit(s, (i + 1) % n))); i = i + 1 }
        s = s + 1
    }
    return t
}

fn fj(a: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(a) { if i > 0 { s = s + ", " }; s = s + to_string(a[i]); i = i + 1 }
    return s + "]"
}

fn argmax(a: array) -> int {
    let mut mi = 0
    let mut mv = a[0]
    let mut i = 1
    while i < len(a) { if a[i] > mv { mv = a[i]; mi = i }; i = i + 1 }
    return mi
}

fn range_of(a: array) -> float {
    let mut lo = a[0]
    let mut hi = a[0]
    let mut i = 1
    while i < len(a) { if a[i] < lo { lo = a[i] }; if a[i] > hi { hi = a[i] }; i = i + 1 }
    return hi - lo
}

fn main() {
    // ── Hc_1293 drive sweep on rule110 at n=4 ───────────────────────────────
    let n = 4
    let gs = [0.0, 0.15, 0.3, 0.45, 0.6, 0.75, 0.9]
    let mut phi_g = []
    let mut csv = "g,phi\n"
    let mut i = 0
    while i < len(gs) {
        let bp = big_phi(drive_tpm(110, n, gs[i]), n, iit4_pow2(n) - 1)
        phi_g = phi_g.push(bp[0])
        csv = csv + to_string(gs[i]) + "," + to_string(bp[0]) + "\n"
        write_file(_dir() + "/shapes2_1293.csv", csv)
        i = i + 1
    }
    let am_g = argmax(phi_g)
    let interior_g = (am_g > 0) && (am_g < len(gs) - 1)
    let rg_g = range_of(phi_g)
    let hc1293 = if interior_g && rg_g > 0.2 { "SUPPORTED-inverse-U" } else { "FALSIFIED-no-interior-peak" }

    // ── Hc_1296 unit-count N sweep, SWAP-chain N=2..7 ───────────────────────
    let mut phi_N = []
    let mut nn = 2
    while nn <= 7 {
        let bp = big_phi(swapchain_tpm(nn), nn, iit4_pow2(nn) - 1)
        phi_N = phi_N.push(bp[0])
        write_file(_dir() + "/shapes2_1296.csv", "uptoN," + to_string(nn) + "\n")
        nn = nn + 1
    }
    let rg_N = range_of(phi_N)
    let mut max_step = 0.0
    let mut all_pos = true
    i = 1
    while i < len(phi_N) {
        let mut d = phi_N[i] - phi_N[i-1]
        if d < 0.0 { d = 0.0 - d }
        if d > max_step { max_step = d }
        if phi_N[i] <= 1.0e-9 { all_pos = false }
        i = i + 1
    }
    if phi_N[0] <= 1.0e-9 { all_pos = false }
    let step_frac = if rg_N > 0.0 { max_step / rg_N } else { 0.0 }
    let hc1296 = if all_pos && step_frac < 0.3 { "SUPPORTED-panpsychist-continuous" } else { if step_frac >= 0.5 { "SUPPORTED-emergentist-threshold" } else { "PARTIAL-intermediate" } }

    let mut out = "{\n"
    out = out + "  \"id\": \"UNIVERSE-Hc1293-1296-shapes2\",\n"
    out = out + "  \"deterministic\": true, \"hexa_only\": true, \"llm\": \"none\",\n"
    out = out + "  \"hc1293_n\": 4, \"hc1293_g\": [0.0,0.15,0.3,0.45,0.6,0.75,0.9],\n"
    out = out + "  \"hc1293_phi_g\": " + fj(phi_g) + ", \"hc1293_argmax_idx\": " + to_string(am_g)
              + ", \"hc1293_range\": " + to_string(rg_g) + ", \"hc1293_verdict\": \"" + hc1293 + "\",\n"
    out = out + "  \"hc1296_N\": [2,3,4,5,6,7], \"hc1296_phi_N\": " + fj(phi_N)
              + ", \"hc1296_max_step_frac\": " + to_string(step_frac)
              + ", \"hc1296_all_positive\": " + (if all_pos { "true" } else { "false" })
              + ", \"hc1296_verdict\": \"" + hc1296 + "\"\n"
    out = out + "}\n"
    write_file(_dir() + "/shapes2.json", out)
    println("Hc_1293 drive Phi(g)=" + fj(phi_g) + " argmax=" + to_string(am_g) + " range=" + to_string(rg_g) + " -> " + hc1293)
    println("Hc_1296 Phi(N)=" + fj(phi_N) + " max_step_frac=" + to_string(step_frac) + " allpos=" + (if all_pos {"Y"} else {"N"}) + " -> " + hc1296)
    println("=== shapes2 done ===")
}
