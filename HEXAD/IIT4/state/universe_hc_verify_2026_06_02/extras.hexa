// extras.hexa — Hc_1287 (self-similarity residual), Hc_1291 (statistical complexity Cmu),
// Hc_1295 (criticality necessary-not-sufficient witness), Hc_1297 (substrate-independence RBN).
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/info/lz_complexity.hexa"

fn _dir() -> string {
    return "/Users/mini/dancinlab/anima-wt-universe-verify/HEXAD/IIT4/state/universe_hc_verify_2026_06_02"
}

fn eca_step(rule: int, n: int, s: int) -> int {
    let mut ns = 0
    let mut i = 0
    while i < n {
        let l = iit4_bit(s, (i - 1 + n) % n)
        let c = iit4_bit(s, i)
        let r = iit4_bit(s, (i + 1) % n)
        if iit4_bit(rule, 4 * l + 2 * c + r) == 1 { ns = ns + iit4_pow2(i) }
        i = i + 1
    }
    return ns
}

fn sqrt_a(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut k = 0
    while k < 40 { g = 0.5 * (g + x / g); k = k + 1 }
    return g
}

fn pearson(xs: array, ys: array) -> float {
    let nn = len(xs)
    if nn < 2 { return 0.0 }
    let mut mx = 0.0
    let mut my = 0.0
    let mut i = 0
    while i < nn { mx = mx + xs[i]; my = my + ys[i]; i = i + 1 }
    mx = mx / to_float(nn); my = my / to_float(nn)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    i = 0
    while i < nn {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy; sxx = sxx + dx * dx; syy = syy + dy * dy
        i = i + 1
    }
    if sxx <= 0.0 || syy <= 0.0 { return 0.0 }
    return sxy / sqrt_a(sxx * syy)
}

fn fj(a: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(a) { if i > 0 { s = s + ", " }; s = s + to_string(a[i]); i = i + 1 }
    return s + "]"
}

fn maxf(a: array) -> float {
    let mut m = a[0]
    let mut i = 1
    while i < len(a) { if a[i] > m { m = a[i] }; i = i + 1 }
    return m
}

// ── self-similarity: translational/period structure of spacetime diagram. ────
// proxy = fraction of (row, shift) pairs where row equals a horizontally-shifted
// copy of an earlier row (self-affinity). Higher for Sierpinski/periodic patterns.
fn self_similarity(rule: int, n: int, t: int) -> float {
    // build spacetime rows from seed = single-cell ON (centre) — standard fractal seed.
    let seed = iit4_pow2(n / 2)
    let mut rows = []
    let mut s = seed
    let mut k = 0
    while k <= t { rows = rows.push(s); s = eca_step(rule, n, s); k = k + 1 }
    let nr = len(rows)
    // count matches under any cyclic shift between row r and row r+1 (scale step).
    let mut matches = 0
    let mut total = 0
    let mut r = 0
    while r < nr - 1 {
        let a = rows[r]
        let b = rows[r + 1]
        // best cyclic-shift overlap of b vs a
        let mut sh = 0
        let mut best = 0
        while sh < n {
            // rotate b by sh, count agreeing bits with a
            let mut agree = 0
            let mut i = 0
            while i < n {
                let bb = iit4_bit(b, (i + sh) % n)
                if bb == iit4_bit(a, i) { agree = agree + 1 }
                i = i + 1
            }
            if agree > best { best = agree }
            sh = sh + 1
        }
        matches = matches + best
        total = total + n
        r = r + 1
    }
    if total == 0 { return 0.0 }
    return to_float(matches) / to_float(total)
}

// ── ensemble LZ (emergence) ──────────────────────────────────────────────────
fn ensemble_lz(rule: int, n: int, t: int) -> float {
    let full = iit4_pow2(n)
    let mut seq = []
    let mut s0 = 0
    while s0 < full {
        let mut s = s0
        let mut k = 0
        while k <= t {
            let mut i = 0
            while i < n { seq = seq.push(iit4_bit(s, i)); i = i + 1 }
            s = eca_step(rule, n, s)
            k = k + 1
        }
        s0 = s0 + 1
    }
    return lz_complexity(seq)
}

// ── statistical complexity Cmu proxy: number of DISTINCT length-L future
// continuations observed, normalized — distinct causal futures = memory.
// (CSSR-lite: distinct length-2 successor blocks following each length-2 history.)
fn cmu_proxy(rule: int, n: int, t: int) -> float {
    let full = iit4_pow2(n)
    // collect symbol stream = Hamming weight per step, pooled over inits.
    let mut dict = #{}
    let mut cnt = 0
    let mut s0 = 0
    while s0 < full {
        let mut s = s0
        // build weight stream
        let mut w = []
        let mut k = 0
        while k <= t {
            let mut pc = 0
            let mut i = 0
            while i < n { pc = pc + iit4_bit(s, i); i = i + 1 }
            w = w.push(pc)
            s = eca_step(rule, n, s)
            k = k + 1
        }
        // map history(len2)->future(len1) distinct pairs
        let wl = len(w)
        let mut j = 0
        while j + 2 < wl {
            let key = to_string(w[j]) + "_" + to_string(w[j+1]) + "_" + to_string(w[j+2])
            if !has_key(dict, key) { dict[key] = 1; cnt = cnt + 1 }
            j = j + 1
        }
        s0 = s0 + 1
    }
    // normalize by max possible distinct (n+1)^3
    let maxd = (n + 1) * (n + 1) * (n + 1)
    return to_float(cnt) / to_float(maxd)
}

// ── random Boolean network step: each cell i = AND/OR of two random inputs by a
// per-cell rule (deterministic, seeded by cell index). For substrate-independence
// we just need a DIFFERENT substrate family with computable big_phi.
fn rbn_tpm(n: int, fseed: int) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            // two inputs: i and (i+fseed)%n; boolean function selected by (i+fseed)%4
            let a = iit4_bit(s, i)
            let b = iit4_bit(s, (i + 1 + fseed) % n)
            let f = (i + fseed) % 4
            let mut o = 0
            if f == 0 { if a == 1 && b == 1 { o = 1 } }      // AND
            if f == 1 { if a == 1 || b == 1 { o = 1 } }      // OR
            if f == 2 { if a != b { o = 1 } }                // XOR
            if f == 3 { if a == b { o = 1 } }                // XNOR
            t = t.push(to_float(o))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn rbn_step(n: int, fseed: int, s: int) -> int {
    let mut ns = 0
    let mut i = 0
    while i < n {
        let a = iit4_bit(s, i)
        let b = iit4_bit(s, (i + 1 + fseed) % n)
        let f = (i + fseed) % 4
        let mut o = 0
        if f == 0 { if a == 1 && b == 1 { o = 1 } }
        if f == 1 { if a == 1 || b == 1 { o = 1 } }
        if f == 2 { if a != b { o = 1 } }
        if f == 3 { if a == b { o = 1 } }
        if o == 1 { ns = ns + iit4_pow2(i) }
        i = i + 1
    }
    return ns
}

fn rbn_lz(n: int, fseed: int, t: int) -> float {
    let full = iit4_pow2(n)
    let mut seq = []
    let mut s0 = 0
    while s0 < full {
        let mut s = s0
        let mut k = 0
        while k <= t {
            let mut i = 0
            while i < n { seq = seq.push(iit4_bit(s, i)); i = i + 1 }
            s = rbn_step(n, fseed, s)
            k = k + 1
        }
        s0 = s0 + 1
    }
    return lz_complexity(seq)
}

fn main() {
    let n = 4
    let allon = iit4_pow2(n) - 1
    let t = 20
    let rules = [0, 30, 51, 60, 90, 105, 110, 150, 204, 255]
    let nr = len(rules)

    let mut bphi = []
    let mut lz = []
    let mut selfsim = []
    let mut cmu = []
    let mut ri = 0
    while ri < nr {
        let rule = rules[ri]
        bphi = bphi.push(big_phi(eca_tpm(rule, n), n, allon)[0])
        lz = lz.push(ensemble_lz(rule, n, t))
        selfsim = selfsim.push(self_similarity(rule, n, t))
        cmu = cmu.push(cmu_proxy(rule, n, t))
        ri = ri + 1
    }

    // normalize phi and lz for residual
    let phimax = maxf(bphi)
    let lzmax = maxf(lz)
    let mut residual = []
    let mut i = 0
    while i < nr {
        let pn = if phimax > 0.0 { bphi[i] / phimax } else { 0.0 }
        let ln = if lzmax > 0.0 { lz[i] / lzmax } else { 0.0 }
        residual = residual.push(ln - pn)
        i = i + 1
    }

    // ── Hc_1287: r(self_similarity, residual) >= 0.5 ? rule90 (index 4) max both? ──
    let r_ss_res = pearson(selfsim, residual)
    // rule90 is index 4 in panel
    let ss90 = selfsim[4]
    let res90 = residual[4]
    let ss_is_max = (ss90 >= maxf(selfsim) - 1.0e-9)
    let res_is_max = (res90 >= maxf(residual) - 1.0e-9)
    let hc1287 = if r_ss_res >= 0.5 { "SUPPORTED-residual-predicted" } else { "FALSIFIED-residual-unstructured" }

    // ── Hc_1291: r(Cmu, phi) >= r(LZ, phi) - 0.1 AND rule90 Cmu low? ──────────
    let r_cmu_phi = pearson(cmu, bphi)
    let r_lz_phi = pearson(lz, bphi)
    let cmu90 = cmu[4]
    // median-ish reference: compare cmu90 to mean of integrative rules 60/110/30
    let cmu_integ = (cmu[1] + cmu[3] + cmu[6]) / 3.0   // rule30,60,110
    let hc1291 = if r_cmu_phi >= r_lz_phi - 0.1 { "SUPPORTED-Cmu-ties-or-beats-LZ" } else { "FALSIFIED-Cmu-worse" }

    // ── Hc_1295: criticality necessary-not-sufficient — witness = rule with
    // high self-similarity/structure (avalanche-like) yet big_phi=0. rule90 is the
    // canonical: self-similar Sierpinski, Phi=0. Does such a witness exist? ──────
    let mut witness_exists = false
    let mut witness_rule = -1
    i = 0
    while i < nr {
        if selfsim[i] > 0.5 && bphi[i] < 1.0e-9 { witness_exists = true; witness_rule = rules[i] }
        i = i + 1
    }
    let hc1295 = if witness_exists { "FALSIFIED-H1-criticality-NOT-sufficient" } else { "SUPPORTED-H1-criticality-implies-phi" }

    // ── Hc_1297: substrate-independence — match phi across ECA and RBN, compare LZ.
    // build RBN panel (4 fseeds), measure (phi, lz). For each ECA rule find nearest-phi
    // RBN; |dLZ| for matched pairs vs unmatched (random) pairs.
    let mut rbn_phi = []
    let mut rbn_lz_a = []
    let mut fs = 0
    while fs < 4 {
        rbn_phi = rbn_phi.push(big_phi(rbn_tpm(n, fs), n, allon)[0])
        rbn_lz_a = rbn_lz_a.push(rbn_lz(n, fs, t))
        fs = fs + 1
    }
    // matched: for each ECA rule, nearest-phi RBN -> |dLZ|. unmatched: ECA i vs RBN i%4.
    let mut sum_matched = 0.0
    let mut sum_unmatched = 0.0
    let mut cnt_m = 0
    i = 0
    while i < nr {
        // nearest phi RBN
        let mut bj = 0
        let mut bd = 1.0e308
        let mut j = 0
        while j < 4 {
            let mut d = rbn_phi[j] - bphi[i]
            if d < 0.0 { d = 0.0 - d }
            if d < bd { bd = d; bj = j }
            j = j + 1
        }
        // only count if phi reasonably matched (tolerance 0.15*phimax)
        if bd < 0.15 * phimax + 0.5 {
            let mut dl = rbn_lz_a[bj] - lz[i]
            if dl < 0.0 { dl = 0.0 - dl }
            sum_matched = sum_matched + dl
            cnt_m = cnt_m + 1
        }
        // unmatched random pairing
        let ui = i % 4
        let mut du = rbn_lz_a[ui] - lz[i]
        if du < 0.0 { du = 0.0 - du }
        sum_unmatched = sum_unmatched + du
        i = i + 1
    }
    let mean_matched = if cnt_m > 0 { sum_matched / to_float(cnt_m) } else { 0.0 }
    let mean_unmatched = sum_unmatched / to_float(nr)
    let hc1297 = if mean_matched < mean_unmatched { "SUPPORTED-substrate-independent" } else { "FALSIFIED-link-substrate-dependent" }

    let mut out = "{\n"
    out = out + "  \"id\": \"UNIVERSE-Hc1287-1291-1295-1297-extras\", \"n\": 4,\n"
    out = out + "  \"deterministic\": true, \"hexa_only\": true, \"llm\": \"none\",\n"
    out = out + "  \"rules\": [0,30,51,60,90,105,110,150,204,255],\n"
    out = out + "  \"bigphi\": " + fj(bphi) + ", \"lz\": " + fj(lz) + ",\n"
    out = out + "  \"self_similarity\": " + fj(selfsim) + ", \"residual\": " + fj(residual) + ",\n"
    out = out + "  \"cmu\": " + fj(cmu) + ",\n"
    out = out + "  \"hc1287_r_selfsim_residual\": " + to_string(r_ss_res)
              + ", \"hc1287_rule90_ss_max\": " + (if ss_is_max { "true" } else { "false" })
              + ", \"hc1287_rule90_res_max\": " + (if res_is_max { "true" } else { "false" })
              + ", \"hc1287_verdict\": \"" + hc1287 + "\",\n"
    out = out + "  \"hc1291_r_cmu_phi\": " + to_string(r_cmu_phi) + ", \"hc1291_r_lz_phi\": " + to_string(r_lz_phi)
              + ", \"hc1291_cmu_rule90\": " + to_string(cmu90) + ", \"hc1291_cmu_integ_mean\": " + to_string(cmu_integ)
              + ", \"hc1291_verdict\": \"" + hc1291 + "\",\n"
    out = out + "  \"hc1295_witness_exists\": " + (if witness_exists { "true" } else { "false" })
              + ", \"hc1295_witness_rule\": " + to_string(witness_rule)
              + ", \"hc1295_verdict\": \"" + hc1295 + "\",\n"
    out = out + "  \"hc1297_rbn_phi\": " + fj(rbn_phi) + ", \"hc1297_rbn_lz\": " + fj(rbn_lz_a)
              + ", \"hc1297_mean_matched_dLZ\": " + to_string(mean_matched)
              + ", \"hc1297_mean_unmatched_dLZ\": " + to_string(mean_unmatched)
              + ", \"hc1297_verdict\": \"" + hc1297 + "\"\n"
    out = out + "}\n"
    write_file(_dir() + "/extras.json", out)

    println("self_sim    = " + fj(selfsim))
    println("residual    = " + fj(residual))
    println("cmu         = " + fj(cmu))
    println("Hc_1287 r(selfsim,residual)=" + to_string(r_ss_res) + " rule90 ss_max=" + (if ss_is_max {"Y"} else {"N"}) + " res_max=" + (if res_is_max {"Y"} else {"N"}) + " -> " + hc1287)
    println("Hc_1291 r(cmu,phi)=" + to_string(r_cmu_phi) + " r(lz,phi)=" + to_string(r_lz_phi) + " cmu90=" + to_string(cmu90) + " -> " + hc1291)
    println("Hc_1295 witness(ss>0.5 & phi=0)? rule=" + to_string(witness_rule) + " -> " + hc1295)
    println("Hc_1297 matched_dLZ=" + to_string(mean_matched) + " unmatched_dLZ=" + to_string(mean_unmatched) + " -> " + hc1297)
    println("=== extras done ===")
}
