// HEXAD/IIT4/state/iit4_m10_exclusion_2026_05_25/run_m10.hexa
// IIT 4.0 engine M10 — exclusion postulate (maximal complex search) smoke.
//
//   QUESTION
//     IIT 4.0 의 배제(exclusion) 공준: 의식적 실체 = 최대 콤플렉스
//     (maximal complex) — 모든 후보 부분계 S 중 big-Φ 가 최대인 단 하나의 S.
//     겹치는 더 낮은-Φ 후보는 배제된다. find_complex 가 이를 올바르게 찾는가?
//
//   METHOD (deterministic · hexa-only · llm:none · $0 mac local)
//     - 엔진: HEXAD/IIT4/lib/iit4_complex.hexa (subsystem_tpm + find_complex).
//     - 각 후보 부분계 S 는 외부 단위를 sys_state 값으로 고정한 배경
//       조건화(background-conditioning) 후 자기 자신의 |S|-단위 system 으로
//       big_phi 재측정. argmax = 콤플렉스.
//     - TPM 은 손으로 도출 가능한 작은 회로로 직접 구성(flat state-by-node).
//
//   TESTS (hand-derivable, assert + PASS/FAIL counter + panic on FAIL)
//     T1 COPY/SWAP n=2   (u0'=u1, u1'=u0): 콤플렉스 = 전체 {0,1}, mask=3, Φ=2.0.
//     T2 EMBEDDED CORE n=3 (u0'=u1, u1'=u0, u2'=u2 독립 자기-세포):
//          콤플렉스 = {0,1} (mask=3, Φ=2.0), 단위 2 배제. 전체 {0,1,2}(mask=7)
//          이 아님 — 결정적 배제 테스트.
//     T3 ALL-NOISE n=2   (모든 next-ON = 0.5): 콤플렉스 없음 (max Φ = 0).
//
//   HONEST (g5)
//     subsystem big-Φ = 외부 단위 배경-조건화(sys_state 고정) 의 인과
//     주변화 해석 — IIT 4.0 의 "배경을 현재 상태로 고정" 관례, 문서화된
//     모델링 선택. 분할 정규화의 완전 재유도 + PyPhi 보정은 M5 carve-out
//     (iit4_bigphi.hexa 참고). 보고된 Φ 는 엔진 실측값.
// ═════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_complex.hexa"

fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-ae0daba288ec76fe6/HEXAD/IIT4/state/iit4_m10_exclusion_2026_05_25"
}

// ── build TPMs by hand ──────────────────────────────────────────────────────

// COPY/SWAP n=2: u0'=u1, u1'=u0.  tpm[s*2+0]=val(u1 in s), tpm[s*2+1]=val(u0 in s).
fn _tpm_copyswap2() -> array {
    let mut t = []
    let mut s = 0
    while s < 4 {
        let u0 = iit4_bit(s, 0)
        let u1 = iit4_bit(s, 1)
        t = t.push(to_float(u1))   // u0' = u1
        t = t.push(to_float(u0))   // u1' = u0
        s = s + 1
    }
    return t
}

// EMBEDDED CORE n=3: u0'=u1, u1'=u0, u2'=u2 (independent self-cell).
// flat length 8*3.  tpm[s*3+0]=u1, tpm[s*3+1]=u0, tpm[s*3+2]=u2.
fn _tpm_embedded3() -> array {
    let mut t = []
    let mut s = 0
    while s < 8 {
        let u0 = iit4_bit(s, 0)
        let u1 = iit4_bit(s, 1)
        let u2 = iit4_bit(s, 2)
        t = t.push(to_float(u1))   // u0' = u1
        t = t.push(to_float(u0))   // u1' = u0
        t = t.push(to_float(u2))   // u2' = u2 (independent)
        s = s + 1
    }
    return t
}

// ALL-NOISE n=2: every next-ON probability = 0.5 (no causal structure).
fn _tpm_noise2() -> array {
    let mut t = []
    let mut s = 0
    while s < 4 {
        t = t.push(0.5)
        t = t.push(0.5)
        s = s + 1
    }
    return t
}

// approximate float equality.
fn _approx(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < tol
}

fn _pf(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("IIT 4.0 M10 — exclusion postulate (maximal complex search) smoke")
    println("  engine: HEXAD/IIT4/lib/iit4_complex.hexa (subsystem_tpm + find_complex)")
    println("  HONEST: subsystem big-Φ uses external-unit background-conditioning (sys_state-fixed).")
    println("")

    let mut pass = 0
    let mut fail = 0

    // ── T1 COPY/SWAP n=2 : whole {0,1}, mask=3, Φ=2.0 ────────────────────────
    let t1 = _tpm_copyswap2()
    let c1 = find_complex(t1, 2, 3)              // sys_state = 3 (both ON)
    let m1 = c1[0].to_int()
    let phi1 = c1[1]
    let sz1 = c1[2].to_int()
    let t1_ok = (m1 == 3) && _approx(phi1, 2.0, 1.0e-6) && (sz1 == 2)
    println("  T1 COPY/SWAP n=2   : complex mask=" + to_string(m1)
            + " (expect 3) Φ=" + to_string(phi1) + " (expect 2.0) size=" + to_string(sz1)
            + "  -> " + _pf(t1_ok))
    if t1_ok { pass = pass + 1 } else { fail = fail + 1 }

    // ── T2 EMBEDDED CORE n=3 : complex {0,1} mask=3, EXCLUDE unit 2 ───────────
    let t2 = _tpm_embedded3()
    // whole-system big-Φ for context (expected 0 — independent self-cell makes it reducible).
    let whole2 = big_phi(t2, 3, 7)
    let c2 = find_complex(t2, 3, 7)              // sys_state = 7 (all ON)
    let m2 = c2[0].to_int()
    let phi2 = c2[1]
    let sz2 = c2[2].to_int()
    let t2_ok = (m2 == 3) && _approx(phi2, 2.0, 1.0e-6) && (sz2 == 2)
    println("  T2 EMBEDDED CORE n=3 : whole {0,1,2} big_phi=" + to_string(whole2[0]) + " (reducible)")
    println("                        complex mask=" + to_string(m2)
            + " (expect 3 = {0,1}, NOT 7) Φ=" + to_string(phi2)
            + " (expect 2.0) size=" + to_string(sz2) + "  -> " + _pf(t2_ok))
    if t2_ok { pass = pass + 1 } else { fail = fail + 1 }

    // ── T3 ALL-NOISE n=2 : no complex (max Φ = 0) ────────────────────────────
    let t3 = _tpm_noise2()
    let c3 = find_complex(t3, 2, 3)
    let m3 = c3[0].to_int()
    let phi3 = c3[1]
    let sz3 = c3[2].to_int()
    let t3_ok = (m3 == 0) && _approx(phi3, 0.0, 1.0e-6) && (sz3 == 0)
    println("  T3 ALL-NOISE n=2   : complex mask=" + to_string(m3)
            + " (expect 0 = no complex) Φ=" + to_string(phi3) + " (expect 0.0) size="
            + to_string(sz3) + "  -> " + _pf(t3_ok))
    if t3_ok { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    let verdict = if fail == 0 { "🟢 SUPPORTED-NUMERICAL" } else { "🔴 FALSIFIED" }
    println("  PASS=" + to_string(pass) + "  FAIL=" + to_string(fail)
            + "  VERDICT=" + verdict)

    // ── result.json ──────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"IIT4-M10\",\n"
    j = j + "  \"slug\": \"exclusion-postulate-maximal-complex\",\n"
    j = j + "  \"milestone\": \"M10 — exclusion postulate (maximal complex search)\",\n"
    j = j + "  \"domain\": \"iit4 · consciousness\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"engine\": \"HEXAD/IIT4/lib/iit4_complex.hexa (subsystem_tpm + find_complex)\",\n"
    j = j + "  \"tie_break\": \"strictly-greater Φ; on Φ-tie prefer larger subset, then lower mask\",\n"
    j = j + "  \"background_conditioning\": \"external units pinned to sys_state values (documented modeling choice; g5)\",\n"
    j = j + "  \"tests\": {\n"
    j = j + "    \"T1_copyswap_n2\": { \"sys_state\": 3, \"complex_mask\": " + to_string(m1)
          + ", \"complex_phi\": " + to_string(phi1) + ", \"complex_size\": " + to_string(sz1)
          + ", \"expect_mask\": 3, \"expect_phi\": 2.0, \"verdict\": \"" + _pf(t1_ok) + "\" },\n"
    j = j + "    \"T2_embedded_core_n3\": { \"sys_state\": 7, \"whole_big_phi\": " + to_string(whole2[0])
          + ", \"complex_mask\": " + to_string(m2) + ", \"complex_phi\": " + to_string(phi2)
          + ", \"complex_size\": " + to_string(sz2)
          + ", \"expect_mask\": 3, \"expect_excludes_unit\": 2, \"expect_phi\": 2.0, \"verdict\": \"" + _pf(t2_ok) + "\" },\n"
    j = j + "    \"T3_all_noise_n2\": { \"sys_state\": 3, \"complex_mask\": " + to_string(m3)
          + ", \"complex_phi\": " + to_string(phi3) + ", \"complex_size\": " + to_string(sz3)
          + ", \"expect_no_complex\": true, \"verdict\": \"" + _pf(t3_ok) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"pass\": " + to_string(pass) + ",\n"
    j = j + "  \"fail\": " + to_string(fail) + ",\n"
    j = j + "  \"embedded_core_finding\": \"find_complex returns mask=3 ({0,1}, Φ=2.0) excluding self-cell {2}; whole {0,1,2} is reducible (big-Φ=0) so the exclusion postulate carves the integrated pair as the conscious entity\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (background-conditioned subsystem big-Φ; full partitioned-normalization + PyPhi calibration = M5 carve-out)\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)
    println("  result.json -> " + _state_dir() + "/result.json")

    // ── hard assert: panic on any FAIL ───────────────────────────────────────
    if fail > 0 {
        panic("M10 exclusion smoke FAILED: " + to_string(fail) + " test(s) did not pass")
    }
    println("=== IIT 4.0 M10 exclusion-postulate smoke complete: " + verdict + " ===")
}
