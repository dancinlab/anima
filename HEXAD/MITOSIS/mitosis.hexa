    let mp_ok = mitosis_merge_patience_default() == 15
    print("  split threshold == 0.3       : " + to_string(st_ok))
    print("  merge threshold == 0.01      : " + to_string(mt_ok))
    print("  split patience == 5          : " + to_string(sp_ok))
    print("  merge patience == 15         : " + to_string(mp_ok))

