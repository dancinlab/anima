// HEXAD/MITOSIS/mitosis.hexa — entrypoint (compiled-first): import mitosis_lib + selftest + main
import "/Users/ghost/core/anima/HEXAD/MITOSIS/mitosis_lib.hexa"

// ── selftest: invariant checks (NOT a functional run; honest scaffold) ──────
fn _selftest() {
    let tol = 1e-12

    // ConsciousnessEngine default thresholds
    let st_ok = _mit_approx_eq(mitosis_split_threshold_default(), 0.3, tol)
    let mt_ok = _mit_approx_eq(mitosis_merge_threshold_default(), 0.01, tol)
    let sp_ok = mitosis_split_patience_default() == 5
    let mp_ok = mitosis_merge_patience_default() == 15
    print("  split threshold == 0.3       : " + to_string(st_ok))
    print("  merge threshold == 0.01      : " + to_string(mt_ok))
    print("  split patience == 5          : " + to_string(sp_ok))
    print("  merge patience == 15         : " + to_string(mp_ok))

    // CB1 + P2 spec
    let cb1_ok = mitosis_min_cells() == 2
    let max_ok = mitosis_max_cells_default() == 64
    print("  CB1 min_cells == 2           : " + to_string(cb1_ok))
    print("  P2 max_cells == 64           : " + to_string(max_ok))

    // 2축 직교 declaration
    let axis_ok = to_string(mitosis_axis_kind()) == "growth"
                   && to_string(mitosis_orthogonal_to()) == "HEXAD-6"
    print("  axis declaration (growth ⊥ HEXAD-6) : " + to_string(axis_ok))

    let all_ok = st_ok && mt_ok && sp_ok && mp_ok && cb1_ok && max_ok && axis_ok
    print("=== HEXAD/MITOSIS scaffold check: " + to_string(all_ok) + " ===")
    print("    실 mitosis 동역학    : tool/hexa_native/mitosis_hook.hexa (FULL IMPL D4a)")
    print("    real-fire evidence   : state/clm_v1_fire_2026_05_15/ (.clm v1 P2 8/8🔵)")
}


fn main() {
    print("HEXAD/MITOSIS — 성장축 (growth axis) hexa-native entry [SCAFFOLD]")
    print("⊥ HEXAD-6 구조축 (orthogonality 는 §mitosis_two_axis 안에서 보존)")
    print("Functional impl delegated → tool/hexa_native/mitosis_hook.hexa")
    _selftest()
}
