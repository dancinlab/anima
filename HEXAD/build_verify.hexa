// HEXAD/build_verify.hexa — COMPILED-native verification gate (hexa-native).
//
//   hexa-native port of build_verify.sh (user directive 2026-05-16 ".sh
//   bash 도 hexa 포팅"; PLAN.md §7 #5). '코드는 hexa-native' + '인터프리터
//   폐기중' 일관. Control flow / module lists / counting / verdict = pure
//   hexa; leaf build+run+grep = exec() (subprocess spawn 은 build gate 의
//   본질 — bash 도 hexa build/timeout/grep 로 shell-out 했다).
//
//   USAGE  hexa build HEXAD/build_verify.hexa -o _hexa_build/build_verify
//          ./_hexa_build/build_verify         # exit 0 = all gated PASS
//   HEXA_BOOT env (≥0fccac5c bootstrapped hexa) → CHAT targets 도 gate.
//
//   build_verify.sh 와 동일 verdict (17/17 entrypoint + 13/13 lib, 6 CHAT
//   skip-with-warning on stale toolchain). 전환기 동안 .sh 와 병존 —
//   canonical gate 는 .hexa 검증 완료 시 전환.
// ════════════════════════════════════════════════════════════════════════

fn _contains(s: string, needle: string) -> bool {
    return len(s.split(needle)) > 1
}

// read an env var via the shell ("" if unset).
fn _env(name: string) -> string {
    return exec("printf %s \"${" + name + ":-}\"")
}

// build a single lib (compile only). returns true on clean build.
fn _check_lib(hexa: string, pre: string, lib: string, bin: string) -> bool {
    let cmd = pre + "HEXA_MAC_BUILD_OK=1 " + hexa + " build " + lib
            + " -o " + bin + " >/tmp/bv_lib.log 2>&1 && echo __BV_OK__ || echo __BV_FAIL__"
    return _contains(exec(cmd), "__BV_OK__")
}

// build + run an entrypoint, assert PASS_MARKER. returns true on PASS.
fn _check_ep(hexa: string, pre: string, f: string, bin: string, marker: string) -> bool {
    let cmd = pre + "HEXA_MAC_BUILD_OK=1 " + hexa + " build " + f
            + " -o " + bin + " >/tmp/bv_bld.log 2>&1 && [ -x " + bin
            + " ] && timeout 60 " + bin + " </dev/null >/tmp/bv_run.log 2>&1 && grep -qE \""
            + marker + "\" /tmp/bv_run.log && echo __BV_OK__ || echo __BV_FAIL__"
    return _contains(exec(cmd), "__BV_OK__")
}

// build-clean check only (anima_chat REPL entrypoint — no PASS_MARKER).
fn _check_build(hexa: string, pre: string, f: string, bin: string) -> bool {
    let cmd = pre + "HEXA_MAC_BUILD_OK=1 " + hexa + " build " + f
            + " -o " + bin + " >/tmp/bv_bld.log 2>&1 && [ -x " + bin
            + " ] && echo __BV_OK__ || echo __BV_FAIL__"
    return _contains(exec(cmd), "__BV_OK__")
}

// probe system hexa for the ≥0fccac5c nested-index-assign codegen.
fn _probe_toolchain(hexa: string) -> bool {
    let probe = "/Users/ghost/core/anima/HEXAD/_probe_nested_index.hexa"
    let cmd = "HEXA_MAC_BUILD_OK=1 " + hexa + " build " + probe
            + " -o /tmp/bv_probe >/tmp/bv_probe.log 2>&1 && [ -x /tmp/bv_probe ]"
            + " && ! grep -q 'expression is not assignable' /tmp/bv_probe.log"
            + " && echo __BV_OK__ || echo __BV_FAIL__"
    return _contains(exec(cmd), "__BV_OK__")
}

fn main() {
    let root  = "/Users/ghost/core/anima"
    let bdir  = root + "/_hexa_build"
    let _mk   = exec("mkdir -p " + bdir)
    let hexa  = "hexa"
    let marker = "selftest: true|7/7 cross-file|spec invariants: true|scaffold check: true"

    // ── toolchain selection (CHAT two-tier) ──
    let boot = _env("HEXA_BOOT")
    let mut chat_hexa = hexa
    let mut chat_ok = false
    let mut chat_pre = ""
    if len(boot) > 0 {
        chat_hexa = boot
        chat_ok = true
        let hi = _env("HEXA_INTERP")
        let hl = _env("HEXA_LANG")
        if len(hi) > 0 { chat_pre = chat_pre + "HEXA_INTERP=" + hi + " " }
        if len(hl) > 0 { chat_pre = chat_pre + "HEXA_LANG=" + hl + " " }
        println("[toolchain] CHAT targets → HEXA_BOOT=" + boot + " (caller-asserted ≥0fccac5c)")
    } else {
        if _probe_toolchain(hexa) {
            chat_ok = true
            println("[toolchain] system hexa carries nested-index-assign codegen (≥0fccac5c) — CHAT ENABLED")
        } else {
            println("[toolchain] system hexa is STALE (pre-0fccac5c) — CHAT targets SKIPPED-WITH-WARNING")
        }
    }

    // ── module lists (mirror build_verify.sh) ──
    let entrypoints = [
        root + "/HEXAD/S/s.hexa", root + "/HEXAD/M/m.hexa", root + "/HEXAD/W/w.hexa",
        root + "/HEXAD/E/e.hexa", root + "/HEXAD/BRIDGE/bridge.hexa",
        root + "/HEXAD/E/e_gate_smoke.hexa",
        root + "/HEXAD/BRIDGE/bridge_forward_smoke.hexa",
        root + "/HEXAD/C/c.hexa", root + "/HEXAD/C/c_phi_smoke.hexa",
        root + "/HEXAD/D/safetensors_wire_smoke.hexa",
        root + "/HEXAD/D/corpus_loader_smoke.hexa",
        root + "/HEXAD/D/d_train_smoke.hexa", root + "/HEXAD/D/d_train2_smoke.hexa",
        root + "/HEXAD/D/d_train3_smoke.hexa", root + "/HEXAD/D/d_train4_smoke.hexa",
        root + "/HEXAD/D/d_train5_smoke.hexa", root + "/HEXAD/MITOSIS/mitosis.hexa",
        root + "/HEXAD/hexad.hexa", root + "/HEXAD/CHAT/wiring_verify.hexa"
    ]
    let libs = [
        root + "/HEXAD/S/s_lib.hexa", root + "/HEXAD/M/m_lib.hexa", root + "/HEXAD/W/w_lib.hexa",
        root + "/HEXAD/E/e_lib.hexa", root + "/HEXAD/BRIDGE/bridge_lib.hexa",
        root + "/HEXAD/C/c_lib.hexa", root + "/HEXAD/D/corpus_loader_lib.hexa",
        root + "/HEXAD/D/d_train_lib.hexa",
        root + "/HEXAD/D/d_train2_lib.hexa", root + "/HEXAD/D/d_train3_lib.hexa",
        root + "/HEXAD/D/d_train4_lib.hexa", root + "/HEXAD/D/d_train5_lib.hexa",
        root + "/HEXAD/MITOSIS/mitosis_lib.hexa", root + "/HEXAD/CHAT/wiring_verify_lib.hexa"
    ]
    let chat_libs = [ root + "/HEXAD/D/d_lib.hexa", root + "/HEXAD/CHAT/chat_lib.hexa" ]
    let chat_eps  = [ root + "/HEXAD/D/d.hexa", root + "/HEXAD/integ_test.hexa",
                      root + "/HEXAD/CHAT/anima_chat.hexa", root + "/HEXAD/integ_train_smoke.hexa" ]

    println("=== HEXAD compiled-native verification (hexa build, interp deprecating) ===")
    let mut ep_pass = 0
    let mut ep_total = 0
    let mut lib_ok = 0
    let mut lib_total = 0
    let mut failed = ""
    let mut chat_skipped = 0

    // ── entrypoints (always-gated) ──
    let mut i = 0
    while i < len(entrypoints) {
        let f = entrypoints[i]
        let bin = bdir + "/bv_ep_" + to_string(i)
        if _check_ep(hexa, "", f, bin, marker) {
            println("  PASS  " + f)
            ep_pass = ep_pass + 1
        } else {
            println("  FAIL  " + f)
            failed = failed + " " + f
        }
        ep_total = ep_total + 1
        i = i + 1
    }
    // ── libs (always-gated) ──
    i = 0
    while i < len(libs) {
        let lib = libs[i]
        let bin = bdir + "/bv_lib_" + to_string(i)
        if _check_lib(hexa, "", lib, bin) {
            lib_ok = lib_ok + 1
        } else {
            println("  FAIL  lib build " + lib)
            failed = failed + " " + lib
        }
        lib_total = lib_total + 1
        i = i + 1
    }

    // ── CHAT targets (bootstrapped-toolchain-gated) ──
    if chat_ok {
        i = 0
        while i < len(chat_libs) {
            let lib = chat_libs[i]
            let bin = bdir + "/bv_clib_" + to_string(i)
            if _check_lib(chat_hexa, chat_pre, lib, bin) {
                println("  PASS  " + lib + " (lib · bootstrapped toolchain)")
                lib_ok = lib_ok + 1
            } else {
                println("  FAIL  lib build " + lib + " (bootstrapped)")
                failed = failed + " " + lib
            }
            lib_total = lib_total + 1
            i = i + 1
        }
        i = 0
        while i < len(chat_eps) {
            let f = chat_eps[i]
            let bin = bdir + "/bv_cep_" + to_string(i)
            // anima_chat.hexa = REPL entrypoint (no PASS_MARKER) → build-clean only
            let mut ok = false
            if _contains(f, "anima_chat.hexa") {
                ok = _check_build(chat_hexa, chat_pre, f, bin)
            } else {
                ok = _check_ep(chat_hexa, chat_pre, f, bin, marker)
            }
            if ok {
                println("  PASS  " + f + " (entrypoint · bootstrapped toolchain)")
                ep_pass = ep_pass + 1
            } else {
                println("  FAIL  " + f + " (bootstrapped toolchain)")
                failed = failed + " " + f
            }
            ep_total = ep_total + 1
            i = i + 1
        }
    } else {
        i = 0
        while i < len(chat_libs) {
            println("  SKIP  " + chat_libs[i] + " (stale toolchain — set HEXA_BOOT)")
            chat_skipped = chat_skipped + 1
            i = i + 1
        }
        i = 0
        while i < len(chat_eps) {
            println("  SKIP  " + chat_eps[i] + " (stale toolchain — set HEXA_BOOT)")
            chat_skipped = chat_skipped + 1
            i = i + 1
        }
    }

    // ── summary + exit ──
    println("=== compiled: entrypoint " + to_string(ep_pass) + "/" + to_string(ep_total)
            + " PASS · lib " + to_string(lib_ok) + "/" + to_string(lib_total) + " build OK ===")
    if chat_skipped > 0 {
        println("=== NOTE: " + to_string(chat_skipped) + " CHAT target(s) SKIPPED (stale toolchain — NOT in denominator) ===")
    }
    if ep_pass == ep_total && lib_ok == lib_total {
        if chat_skipped > 0 {
            println("ALL GATED MODULES COMPILED-NATIVE PASS (CHAT skipped — stale toolchain, honest).")
        } else {
            println("ALL COMPILED-NATIVE PASS — interp-deprecation safe.")
        }
        exit(0)
    }
    println("FAILED:" + failed)
    exit(1)
}
