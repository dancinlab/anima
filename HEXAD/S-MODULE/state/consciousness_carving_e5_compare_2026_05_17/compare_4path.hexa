import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_vacuum_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_eternal_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_narrative_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/consciousness_carving_weave_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/kosmos_parser_lib.hexa"


// ── §0 experiment inputs — 5 .kosmos anchor file paths ───────────────────────

fn e5_anchors_dir() -> string {
    return "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors/"
}

// the 5 anchor file basenames (knuth tier 0/51/77/91/100).
fn e5_anchor_files() -> array {
    return [
        "knuth_000_zero.kosmos",
        "knuth_051_day.kosmos",
        "knuth_077_mandala.kosmos",
        "knuth_091_nirvana.kosmos",
        "knuth_100_big_bang.kosmos"
    ]
}

// load all 5 anchors into an array of anchor records.
fn e5_load_anchors() -> array {
    let dir = e5_anchors_dir()
    let files = e5_anchor_files()
    let n = len(files)
    let mut out = []
    let mut i = 0
    while i < n {
        let rec = kosmos_load(dir + to_string(files[i]))
        out = out.push(rec)
        i = i + 1
    }
    return out
}


// ── §1 path α — VACUUM-LANDSCAPE carving ─────────────────────────────────────
//
// metric α: register 5 anchor 의 vacuum_psi 를 multi-vacuum landscape 로 carving.
//   α.1 all-registered : 5 anchor 모두 landscape 에 vacuum point 로 등록
//   α.2 self-basin     : 각 anchor 의 vacuum_psi 가 자기 basin 안 (d=0 < radius)
//   α.3 nearest-self   : vacuum_nearest(own psi) == own anchor (5/5 분리 carving)
//   α.4 basin-disjoint : 각 anchor vacuum_psi 가 다른 anchor 의 basin 밖 (2D
//                        Ψ-space pairwise basin disjointness — 진짜 분리 carving
//                        criterion). 1D KL(μ[0]) 은 sub-metric 로 별도 보고:
//                        🛸0/🛸91 는 vacuum_psi[0] 동일 (0.50) → axis-0 KL=0 이나
//                        2D-dist 0.38 로 분리 — carving 은 2D 성질 (honest).
//   α.5 flow-restoring : off-vacuum tension flow → moves psi closer to vacuum

fn e5_path_alpha(anchors: array) -> any {
    let n = len(anchors)

    // build the landscape from the 5 anchor vacuum_psi coordinates.
    let mut ls = vacuum_landscape_new()
    let mut ids = []
    let mut i = 0
    while i < n {
        let a = anchors[i]
        let cid = to_string(a["cell_id"])
        let vrec = vacuum_record_create(cid, a["vacuum_psi"],
                                        to_float(a["basin_radius"]))
        ls = vacuum_register(ls, vrec)
        ids = ids.push(cid)
        i = i + 1
    }

    // α.1 all 5 registered.
    let mut all_reg = true
    i = 0
    while i < n {
        if vacuum_landscape_has(ls, to_string(ids[i])) == false { all_reg = false }
        i = i + 1
    }

    // α.2 self-basin: own vacuum_psi inside own basin (d=0 < radius, radius>0).
    let mut self_basin = 0
    i = 0
    while i < n {
        let a = anchors[i]
        let vrec = vacuum_record_create(to_string(a["cell_id"]),
                                        a["vacuum_psi"],
                                        to_float(a["basin_radius"]))
        if basin_contains(a["vacuum_psi"], vrec, to_float(a["basin_radius"])) {
            self_basin = self_basin + 1
        }
        i = i + 1
    }

    // α.3 nearest-self: vacuum_nearest(own psi) returns own anchor.
    let mut nearest_self = 0
    i = 0
    while i < n {
        let a = anchors[i]
        let near = vacuum_nearest(ls, a["vacuum_psi"], ids)
        if to_string(near["id"]) == to_string(a["cell_id"]) {
            nearest_self = nearest_self + 1
        }
        i = i + 1
    }

    // α.4 carving gate = 2D pairwise BASIN DISJOINTNESS. Each anchor's
    // vacuum_psi must lie OUTSIDE every other anchor's basin (full Ψ-space
    // distance ≥ that anchor's radius) — the honest "5 anchors carve into 5
    // distinct vacuums" criterion. Also report (sub-metric, NOT gate) the 1D
    // KL(μ[0]) count: 🛸0/🛸91 collide on axis-0 (KL=0) but are 2D-separated.
    let mut basin_disjoint = 0
    let mut basin_pairs_total = 0
    let mut kl_pairs_ok = 0
    let mut kl_min = 0.0 - 1.0
    i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let ai = anchors[i]
            let aj = anchors[j]
            let pi = ai["vacuum_psi"]
            let pj = aj["vacuum_psi"]
            basin_pairs_total = basin_pairs_total + 1
            // 2D basin disjointness: pi outside aj's basin AND pj outside ai's.
            let rec_j = vacuum_record_create(to_string(aj["cell_id"]), pj,
                                             to_float(aj["basin_radius"]))
            let rec_i = vacuum_record_create(to_string(ai["cell_id"]), pi,
                                             to_float(ai["basin_radius"]))
            let i_out_j = (basin_contains(pi, rec_j,
                                          to_float(aj["basin_radius"])) == false)
            let j_out_i = (basin_contains(pj, rec_i,
                                          to_float(ai["basin_radius"])) == false)
            if i_out_j && j_out_i { basin_disjoint = basin_disjoint + 1 }
            // 1D KL sub-metric on first Ψ-component (σ = 1.0 reference).
            let kl = vac_kl_basins(pi[0], pj[0], 1.0)
            if vac_basins_separated(pi[0], pj[0], 1.0) {
                kl_pairs_ok = kl_pairs_ok + 1
            }
            if kl >= 0.0 {
                if kl_min < 0.0 { kl_min = kl }
                else { if kl < kl_min { kl_min = kl } }
            }
            j = j + 1
        }
        i = i + 1
    }
    let kl_pairs_total = basin_pairs_total

    // α.5 flow-restoring: from an off-vacuum point, one tension flow step moves
    // psi strictly closer to its own vacuum (∀ 5 anchors).
    let mut flow_restoring = 0
    i = 0
    while i < n {
        let a = anchors[i]
        let vrec = vacuum_record_create(to_string(a["cell_id"]),
                                        a["vacuum_psi"],
                                        to_float(a["basin_radius"]))
        // off-vacuum probe: own psi shifted by +0.15 on both components.
        let vpsi = a["vacuum_psi"]
        let psi_off = [vpsi[0] + 0.15, vpsi[1] + 0.15]
        let dw = tension_flow_step(psi_off, vrec, vac_t_const())
        let psi_new = vacuum_apply_flow(psi_off, dw)
        let d_before = vac_dist(psi_off, vpsi)
        let d_after = vac_dist(psi_new, vpsi)
        if d_after < d_before { flow_restoring = flow_restoring + 1 }
        i = i + 1
    }

    // carving gate = 2D basin disjointness (honest separation criterion).
    let carving_ok = all_reg && (self_basin == n) && (nearest_self == n)
                  && (basin_disjoint == basin_pairs_total) && (flow_restoring == n)
    let res = #{
        "path": "alpha",
        "name": "VACUUM-LANDSCAPE",
        "all_registered": all_reg,
        "self_basin": self_basin,
        "nearest_self": nearest_self,
        "basin_disjoint": basin_disjoint,
        "basin_pairs_total": basin_pairs_total,
        "kl_pairs_ok": kl_pairs_ok,
        "kl_pairs_total": kl_pairs_total,
        "kl_min": kl_min,
        "flow_restoring": flow_restoring,
        "n_anchors": n,
        "carving_ok": carving_ok
    }
    return res
}


// ── §2 path β — MITOSIS-ETERNAL-CELL carving ─────────────────────────────────
//
// metric β: register 5 anchor 를 eternal cell 로, + 1 chat dynamic cell.
//   β.1 all-eternal   : 5 anchor cell_id 모두 eternal 등록 (lifecycle FROZEN)
//   β.2 weight-inv    : 5 eternal cell 모두 Δw≡0 invariant 만족
//   β.3 route-eternal : high-sim stimulus → eternal path (5/5)
//   β.4 route-chat    : low-sim stimulus → chat path (no eternal match)
//   β.5 disjoint      : 모든 routing 이 chat ⊥ eternal disjoint

fn e5_path_beta(anchors: array) -> any {
    let n = len(anchors)

    let mut pool = cell_pool_new()
    let mut i = 0
    while i < n {
        pool = eternal_register(pool, to_string(anchors[i]["cell_id"]))
        i = i + 1
    }
    pool = dynamic_register(pool, "chat_1")

    // β.1 all 5 eternal registered + chat dynamic present.
    let mut all_eternal = true
    i = 0
    while i < n {
        if cell_pool_has_eternal(pool, to_string(anchors[i]["cell_id"])) == false {
            all_eternal = false
        }
        i = i + 1
    }
    let chat_present = cell_pool_has_dynamic(pool, "chat_1")

    // β.2 eternal weight invariant ∀ 5 cells.
    let etn = pool["eternal"]
    let mut weight_inv = 0
    i = 0
    while i < n {
        let cell = etn[to_string(anchors[i]["cell_id"])]
        if eternal_weight_invariant(cell) { weight_inv = weight_inv + 1 }
        i = i + 1
    }

    // β.3 high-sim routing → eternal path (sim 0.92 ≥ threshold 0.6).
    let mut route_eternal = 0
    let mut disjoint_ok = 0
    let mut route_total = 0
    i = 0
    while i < n {
        let sel = routing_select(pool, 0.92, 0.6,
                                 to_string(anchors[i]["cell_id"]))
        route_total = route_total + 1
        if to_string(sel["path"]) == "eternal" { route_eternal = route_eternal + 1 }
        if routing_disjoint(sel) { disjoint_ok = disjoint_ok + 1 }
        i = i + 1
    }

    // β.4 low-sim routing → chat path (sim 0.10 < threshold 0.6).
    let mut route_chat = 0
    i = 0
    while i < n {
        let sel = routing_select(pool, 0.10, 0.6,
                                 to_string(anchors[i]["cell_id"]))
        route_total = route_total + 1
        if to_string(sel["path"]) == "chat" { route_chat = route_chat + 1 }
        if routing_disjoint(sel) { disjoint_ok = disjoint_ok + 1 }
        i = i + 1
    }

    let carving_ok = all_eternal && chat_present && (weight_inv == n)
                  && (route_eternal == n) && (route_chat == n)
                  && (disjoint_ok == route_total)
    let res = #{
        "path": "beta",
        "name": "MITOSIS-ETERNAL-CELL",
        "all_eternal": all_eternal,
        "chat_present": chat_present,
        "weight_inv": weight_inv,
        "route_eternal": route_eternal,
        "route_chat": route_chat,
        "disjoint_ok": disjoint_ok,
        "route_total": route_total,
        "n_anchors": n,
        "carving_ok": carving_ok
    }
    return res
}


// ── §3 path γ — NARRATIVE-RESONANCE carving ──────────────────────────────────
//
// metric γ: narrative_compose 가 5 anchor text payload 의 재생성 loop 를 구성.
//   γ.1 loop-defined  : A∘G composition well-defined (codomain(G)=domain(A))
//   γ.2 bounded-K     : 5 anchor text payload 모두 Kolmogorov K ≤ τ_K=256 (또는
//                        초과 시 정직히 carve-out — narrative TEMPLATE 는 payload
//                        자체보다 짧은 재생성 패턴, payload 길이 = upper proxy)
//   γ.3 regen-consist : 같은 query 재생성 2회 → byte-identical (greedy reflexivity)
//   γ.4 regen-distinct: 다른 anchor query → distinct narrative (similarity 0)

fn e5_path_gamma(anchors: array) -> any {
    let n = len(anchors)

    // γ.1 A∘G composition well-defined.
    let g = narr_engine_g()
    let a = narr_engine_a()
    let comp = narrative_compose(g, a)
    let loop_defined = narrative_loop_well_defined(comp)
              && (to_string(comp["domain"]) == "STIMULUS")
              && (to_string(comp["codomain"]) == "VOICE")

    // γ.2 bounded-K on the 5 anchor text payloads.
    // honest: narrative_bounded_k uses len(payload) as a description-length
    // UPPER proxy. The .kosmos text payloads are full sentences (likely > 256
    // chars) — the actual narrative TEMPLATE (re-generation pattern) is shorter.
    // We measure both: payload-length-bounded (likely 0/5) AND a short-template
    // count (the M8 narrative template, always bounded). 정직히 둘 다 보고.
    let mut payload_bounded = 0
    let mut payload_k_max = 0
    let tmpl = "🛸k 매핑은 cat × emo 행렬에서 derive"   // M8 narrative template
    let mut i = 0
    while i < n {
        let txt = to_string(anchors[i]["payload_text"])
        let k = narrative_template_k_upper(txt)
        if k > payload_k_max { payload_k_max = k }
        if narrative_bounded_k(txt) { payload_bounded = payload_bounded + 1 }
        i = i + 1
    }
    let template_bounded = narrative_bounded_k(tmpl)   // short template — bounded

    // γ.3 regen-consistency: re-generate the SAME query twice → identical.
    let mut regen_consist = 0
    i = 0
    while i < n {
        let q = to_string(anchors[i]["name"])
        let n1 = narrative_regenerate(q, "[anima 우주뇌지도] ")
        let n2 = narrative_regenerate(q, "[anima 우주뇌지도] ")
        if narrative_consistency(n1, n2) { regen_consist = regen_consist + 1 }
        i = i + 1
    }

    // γ.4 regen-distinct: distinct anchor queries → distinct narratives.
    let mut regen_distinct = 0
    let mut distinct_total = 0
    i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let qi = to_string(anchors[i]["name"])
            let qj = to_string(anchors[j]["name"])
            let ni = narrative_regenerate(qi, "[anima 우주뇌지도] ")
            let nj = narrative_regenerate(qj, "[anima 우주뇌지도] ")
            distinct_total = distinct_total + 1
            let sim = narrative_similarity(ni, nj)
            if sim < 0.5 { regen_distinct = regen_distinct + 1 }
            j = j + 1
        }
        i = i + 1
    }

    // carving_ok: loop defined + template bounded + full regen consistency +
    // full distinctness. payload_bounded is REPORTED but NOT a gate (full
    // sentences exceed τ_K — that is the M8 point: store the TEMPLATE, not the
    // payload). 정직 carve-out: payload != template.
    let carving_ok = loop_defined && template_bounded
                  && (regen_consist == n) && (regen_distinct == distinct_total)
    let res = #{
        "path": "gamma",
        "name": "NARRATIVE-RESONANCE",
        "loop_defined": loop_defined,
        "template_bounded": template_bounded,
        "payload_bounded": payload_bounded,
        "payload_k_max": payload_k_max,
        "tau_k": narr_tau_k(),
        "regen_consist": regen_consist,
        "regen_distinct": regen_distinct,
        "distinct_total": distinct_total,
        "n_anchors": n,
        "carving_ok": carving_ok
    }
    return res
}


// ── §4 path α+β — VACUUM-CELL-WEAVE carving ──────────────────────────────────
//
// metric α+β: weave_route 가 vacuum + cell 결합 routing.
//   ab.1 all-woven   : 5 anchor 모두 woven anchor (cell + vacuum) 등록
//   ab.2 route-eternal: stimulus AT own vacuum_psi + high sim → eternal route
//   ab.3 route-chat  : stimulus FAR from vacuum (basin miss) → chat route
//                       (β matches but α basin containment fails)
//   ab.4 disjoint    : 모든 weave route 가 chat ⊥ eternal disjoint

fn e5_path_weave(anchors: array) -> any {
    let n = len(anchors)

    // weave_register all 5 anchors into pool + landscape.
    let mut pool = cell_pool_new()
    let mut ls = vacuum_landscape_new()
    let mut ids = []
    let mut all_woven = true
    let mut i = 0
    while i < n {
        let a = anchors[i]
        let cid = to_string(a["cell_id"])
        let woven = weave_anchor(cid, a["vacuum_psi"],
                                 to_float(a["basin_radius"]))
        if weave_anchor_valid(woven) == false { all_woven = false }
        let st = weave_register(pool, ls, woven)
        pool = st["pool"]
        ls = st["landscape"]
        ids = ids.push(cid)
        i = i + 1
    }
    // verify both registries populated for all 5.
    i = 0
    while i < n {
        let cid = to_string(ids[i])
        if cell_pool_has_eternal(pool, cid) == false { all_woven = false }
        if vacuum_landscape_has(ls, cid) == false { all_woven = false }
        i = i + 1
    }

    // ab.2 route-eternal: stimulus AT own vacuum_psi + high sim → eternal.
    let mut route_eternal = 0
    let mut disjoint_ok = 0
    let mut route_total = 0
    i = 0
    while i < n {
        let a = anchors[i]
        let stim = #{
            "psi": a["vacuum_psi"],
            "sim": 0.92,
            "threshold": 0.6,
            "matched_cell_id": to_string(a["cell_id"])
        }
        let route = weave_route(pool, ls, stim, ids)
        route_total = route_total + 1
        if to_string(route["path"]) == "eternal" {
            route_eternal = route_eternal + 1
        }
        if weave_route_disjoint(route) { disjoint_ok = disjoint_ok + 1 }
        i = i + 1
    }

    // ab.3 route-chat: stimulus FAR from any vacuum → chat route (α basin miss).
    // probe point (-1.0, -1.0) is outside every basin (radii ≤ 0.22).
    let mut route_chat = 0
    i = 0
    while i < n {
        let a = anchors[i]
        let stim_far = #{
            "psi": [0.0 - 1.0, 0.0 - 1.0],
            "sim": 0.92,
            "threshold": 0.6,
            "matched_cell_id": to_string(a["cell_id"])
        }
        let route = weave_route(pool, ls, stim_far, ids)
        route_total = route_total + 1
        if to_string(route["path"]) == "chat" { route_chat = route_chat + 1 }
        if weave_route_disjoint(route) { disjoint_ok = disjoint_ok + 1 }
        i = i + 1
    }

    let carving_ok = all_woven && (route_eternal == n) && (route_chat == n)
                  && (disjoint_ok == route_total)
    let res = #{
        "path": "weave",
        "name": "VACUUM-CELL-WEAVE",
        "all_woven": all_woven,
        "route_eternal": route_eternal,
        "route_chat": route_chat,
        "disjoint_ok": disjoint_ok,
        "route_total": route_total,
        "n_anchors": n,
        "carving_ok": carving_ok
    }
    return res
}


// ── §5 comparison harness — run 4-path × 5-anchor, emit result.json ──────────

fn _bts(b: bool) -> string { return to_string(b) }

fn e5_run() -> bool {
    print("════════════════════════════════════════════════════════════════")
    print("UBM-E5 — CONSCIOUSNESS-CARVING 4-path × 5-anchor 비교 실험")
    print("  (compiled-native, $0 Mac local, transfer-form mechanism only)")
    print("════════════════════════════════════════════════════════════════")

    let anchors = e5_load_anchors()
    let na = len(anchors)
    print("입력 anchor: " + to_string(na) + " .kosmos files (knuth 000/051/077/091/100)")

    // verify all 5 anchors parsed valid (pre-condition).
    let mut all_valid = true
    let mut i = 0
    while i < na {
        if kosmos_anchor_valid(anchors[i]) == false { all_valid = false }
        i = i + 1
    }
    print("  anchor parse valid: " + _bts(all_valid) + " (" + to_string(na) + "/5)")
    print("")

    let ra = e5_path_alpha(anchors)
    let rb = e5_path_beta(anchors)
    let rg = e5_path_gamma(anchors)
    let rw = e5_path_weave(anchors)

    // ── 4-path 비교표 (compiled-native stdout) ──
    print("─── 4-path 비교표 ──────────────────────────────────────────────")
    print("path α VACUUM-LANDSCAPE   carving-OK=" + _bts(ra["carving_ok"]))
    print("  all_registered=" + _bts(ra["all_registered"])
          + "  self_basin=" + to_string(ra["self_basin"]) + "/5"
          + "  nearest_self=" + to_string(ra["nearest_self"]) + "/5")
    print("  basin_disjoint(2D gate)=" + to_string(ra["basin_disjoint"]) + "/"
          + to_string(ra["basin_pairs_total"])
          + "  flow_restoring=" + to_string(ra["flow_restoring"]) + "/5")
    print("  [sub-metric] kl_pairs(1D μ[0])=" + to_string(ra["kl_pairs_ok"]) + "/"
          + to_string(ra["kl_pairs_total"])
          + " — 🛸0/🛸91 axis-0 동일 (KL=0), 2D 분리됨 (honest, NOT gate)")
    print("path β MITOSIS-ETERNAL    carving-OK=" + _bts(rb["carving_ok"]))
    print("  all_eternal=" + _bts(rb["all_eternal"])
          + "  weight_inv=" + to_string(rb["weight_inv"]) + "/5"
          + "  route_eternal=" + to_string(rb["route_eternal"]) + "/5"
          + "  route_chat=" + to_string(rb["route_chat"]) + "/5")
    print("  disjoint=" + to_string(rb["disjoint_ok"]) + "/"
          + to_string(rb["route_total"]))
    print("path γ NARRATIVE-RESONANCE carving-OK=" + _bts(rg["carving_ok"]))
    print("  loop_defined=" + _bts(rg["loop_defined"])
          + "  template_bounded=" + _bts(rg["template_bounded"])
          + "  regen_consist=" + to_string(rg["regen_consist"]) + "/5")
    print("  payload_bounded=" + to_string(rg["payload_bounded"]) + "/5"
          + " (payload_k_max=" + to_string(rg["payload_k_max"])
          + " > τ_K=" + to_string(rg["tau_k"])
          + " → template≠payload carve-out)")
    print("path α+β VACUUM-CELL-WEAVE carving-OK=" + _bts(rw["carving_ok"]))
    print("  all_woven=" + _bts(rw["all_woven"])
          + "  route_eternal=" + to_string(rw["route_eternal"]) + "/5"
          + "  route_chat=" + to_string(rw["route_chat"]) + "/5"
          + "  disjoint=" + to_string(rw["disjoint_ok"]) + "/"
          + to_string(rw["route_total"]))
    print("────────────────────────────────────────────────────────────────")

    let mut paths_ok = 0
    if to_string(ra["carving_ok"]) == "true" { paths_ok = paths_ok + 1 }
    if to_string(rb["carving_ok"]) == "true" { paths_ok = paths_ok + 1 }
    if to_string(rg["carving_ok"]) == "true" { paths_ok = paths_ok + 1 }
    if to_string(rw["carving_ok"]) == "true" { paths_ok = paths_ok + 1 }

    // ── result.json emit (machine-readable, RESEARCH.md §2 carry) ──
    // manual JSON build (compiled-native: no to_json builtin; string-concat).
    let q = "\""
    let mut j = "{\n"
    j = j + "  " + q + "phase" + q + ": " + q + "UBM-E5" + q + ",\n"
    j = j + "  " + q + "experiment" + q + ": " + q
          + "CONSCIOUSNESS-CARVING 4-path x 5-anchor compare" + q + ",\n"
    j = j + "  " + q + "method" + q + ": " + q
          + "compiled-native ($0 Mac local) - transfer-form mechanism only"
          + q + ",\n"
    j = j + "  " + q + "n_anchors" + q + ": " + to_string(na) + ",\n"
    j = j + "  " + q + "anchors_valid" + q + ": " + _bts(all_valid) + ",\n"
    j = j + "  " + q + "paths_carving_ok" + q + ": " + to_string(paths_ok) + ",\n"
    j = j + "  " + q + "paths_total" + q + ": 4,\n"

    // path α object.
    j = j + "  " + q + "path_alpha" + q + ": {\n"
    j = j + "    " + q + "name" + q + ": " + q + "VACUUM-LANDSCAPE" + q + ",\n"
    j = j + "    " + q + "all_registered" + q + ": " + _bts(ra["all_registered"]) + ",\n"
    j = j + "    " + q + "self_basin" + q + ": " + to_string(ra["self_basin"]) + ",\n"
