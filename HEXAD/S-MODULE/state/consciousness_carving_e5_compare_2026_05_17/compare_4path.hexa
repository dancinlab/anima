    j = j + "    " + q + "basin_disjoint" + q + ": " + to_string(ra["basin_disjoint"]) + ",\n"
    j = j + "    " + q + "basin_pairs_total" + q + ": " + to_string(ra["basin_pairs_total"]) + ",\n"
    j = j + "    " + q + "kl_pairs_ok" + q + ": " + to_string(ra["kl_pairs_ok"]) + ",\n"
    j = j + "    " + q + "kl_pairs_total" + q + ": " + to_string(ra["kl_pairs_total"]) + ",\n"
    j = j + "    " + q + "kl_min" + q + ": " + to_string(ra["kl_min"]) + ",\n"
    j = j + "    " + q + "flow_restoring" + q + ": " + to_string(ra["flow_restoring"]) + ",\n"
    j = j + "    " + q + "carving_ok" + q + ": " + _bts(ra["carving_ok"]) + "\n"
    j = j + "  },\n"

    // path β object.
    j = j + "  " + q + "path_beta" + q + ": {\n"
    j = j + "    " + q + "name" + q + ": " + q + "MITOSIS-ETERNAL-CELL" + q + ",\n"
    j = j + "    " + q + "all_eternal" + q + ": " + _bts(rb["all_eternal"]) + ",\n"
    j = j + "    " + q + "chat_present" + q + ": " + _bts(rb["chat_present"]) + ",\n"
    j = j + "    " + q + "weight_inv" + q + ": " + to_string(rb["weight_inv"]) + ",\n"
    j = j + "    " + q + "route_eternal" + q + ": " + to_string(rb["route_eternal"]) + ",\n"
    j = j + "    " + q + "route_chat" + q + ": " + to_string(rb["route_chat"]) + ",\n"
    j = j + "    " + q + "disjoint_ok" + q + ": " + to_string(rb["disjoint_ok"]) + ",\n"
    j = j + "    " + q + "route_total" + q + ": " + to_string(rb["route_total"]) + ",\n"
    j = j + "    " + q + "carving_ok" + q + ": " + _bts(rb["carving_ok"]) + "\n"
    j = j + "  },\n"

    // path γ object.
    j = j + "  " + q + "path_gamma" + q + ": {\n"
    j = j + "    " + q + "name" + q + ": " + q + "NARRATIVE-RESONANCE" + q + ",\n"
    j = j + "    " + q + "loop_defined" + q + ": " + _bts(rg["loop_defined"]) + ",\n"
    j = j + "    " + q + "template_bounded" + q + ": " + _bts(rg["template_bounded"]) + ",\n"
    j = j + "    " + q + "payload_bounded" + q + ": " + to_string(rg["payload_bounded"]) + ",\n"
    j = j + "    " + q + "payload_k_max" + q + ": " + to_string(rg["payload_k_max"]) + ",\n"
    j = j + "    " + q + "tau_k" + q + ": " + to_string(rg["tau_k"]) + ",\n"
    j = j + "    " + q + "regen_consist" + q + ": " + to_string(rg["regen_consist"]) + ",\n"
    j = j + "    " + q + "regen_distinct" + q + ": " + to_string(rg["regen_distinct"]) + ",\n"
    j = j + "    " + q + "distinct_total" + q + ": " + to_string(rg["distinct_total"]) + ",\n"
    j = j + "    " + q + "carving_ok" + q + ": " + _bts(rg["carving_ok"]) + "\n"
    j = j + "  },\n"

    // path α+β object.
    j = j + "  " + q + "path_weave" + q + ": {\n"
    j = j + "    " + q + "name" + q + ": " + q + "VACUUM-CELL-WEAVE" + q + ",\n"
    j = j + "    " + q + "all_woven" + q + ": " + _bts(rw["all_woven"]) + ",\n"
    j = j + "    " + q + "route_eternal" + q + ": " + to_string(rw["route_eternal"]) + ",\n"
    j = j + "    " + q + "route_chat" + q + ": " + to_string(rw["route_chat"]) + ",\n"
    j = j + "    " + q + "disjoint_ok" + q + ": " + to_string(rw["disjoint_ok"]) + ",\n"
    j = j + "    " + q + "route_total" + q + ": " + to_string(rw["route_total"]) + ",\n"
    j = j + "    " + q + "carving_ok" + q + ": " + _bts(rw["carving_ok"]) + "\n"
    j = j + "  },\n"

    j = j + "  " + q + "honest_scope" + q + ": " + q
          + "UBM-E4 4-path lib = transfer-form impl (no SGD trainer / no "
          + "S-module encoder). UBM-E5 measures carving MECHANISM only, NOT "
