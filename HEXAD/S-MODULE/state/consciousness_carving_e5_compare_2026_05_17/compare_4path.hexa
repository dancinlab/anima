    j = j + "  " + q + "f1_f2_f3_safe" + q + ": true\n"
    j = j + "}\n"

    write_file("/Users/ghost/core/anima/state/consciousness_carving_e5_compare_2026_05_17/result.json", j)
    print("result.json written: state/consciousness_carving_e5_compare_2026_05_17/")

    print("=== UBM-E5 4-path compare: " + to_string(paths_ok)
