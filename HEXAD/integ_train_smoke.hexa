// HEXAD/integ_train_smoke.hexa — entrypoint (import 6 libs + selftest + top-level call)
// ════════════════════════════════════════════════════════════════════════════
//  PHASE 6 — 6-module + Bridge single-hexa-process FORWARD + TRAIN cycle.
//
//  hexa-native equivalent of state/verify_hexad_integ_2026_05_16/integ_
//  harness.py (Python, PR #77 fire-gate=true). $0 Mac compiled-native
//  de-risk verify BEFORE the autonomous real-scale GPU fire
//  (AGENTS.tape g_fire_autonomous — 게이트 없음, dimension-generic lib so
//  real d=768 = ubu/GPU autonomous cycle).
//
//  Per-step integrated cycle (σ(6)=12 wiring, φ(6)=2 group split):
//    S  s_perception(Δ col-mean)  →  C/mitosis cell_pool forward_tail
//    →  M store + retrieve  →  W lr_mult  →  E safety gate  →  Bridge
//    Ψ-clamp (G→A)  →  D head dt2_forward + B-D-4 closed grad + AdamW.
//
//  GRADIENT BARRIER (φ(6)=2): ONLY the D head W_d is in the optimizer
//  (Engine A / CE-trained). C/S/W/M/E + Bridge are gradient-free reads
//  (Engine G) — structurally enforced (only W_d → dt2_adamw_step).
//
//  F-INTEG-FULL-1 SINGLE-FORWARD-WIRED   : all 6+Bridge fire every step
//  F-INTEG-FULL-2 GRADIENT-BARRIER-CLEAN : only W_d mutates; G-side const
//  F-INTEG-FULL-3 SCRATCH-INIT-SEED-FIXED: dt2_init_W seed reproduces
//                                          (g_clm_from_scratch, base_ckpt=NONE)
//  F-INTEG-FULL-4 MITOSIS-WIRING-LIVE    : n_cells ≥ 2, trajectory recorded
//  F-INTEG-FULL-5 CE-DESCENT             : gn2 collapses (EMPIRICAL,
//                                          B-D-NOTE — SGD OUTCOME, NOT 🔵)
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/S/s_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/M/m_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/W/w_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/E/e_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/BRIDGE/bridge_lib.hexa"
import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/D/d_train2_lib.hexa"


fn p6_abs(x: float) -> float { return if x < 0.0 { 0.0 - x } else { x } }

fn selftest() {
    println("================================================================")
    println("integ_train_smoke — Phase 6 6-module+Bridge forward+train (F-INTEG-FULL)")
    println("================================================================")

    let dim = 4                    // c_dim == D-head input dim
    let V = 4                      // byte-class toy vocab
    let nsamp = 4

    // ── F-INTEG-FULL-3 SCRATCH-INIT-SEED-FIXED (g_clm_from_scratch) ────────
    let mut Wd = dt2_init_W(42, dim, V, 0.2)       // D head, RANDOM seed-fixed
    let Wd_re = dt2_init_W(42, dim, V, 0.2)        // re-init same seed
    let seed_ok = (Wd[0] == Wd_re[0]) && (Wd[dim*V-1] == Wd_re[dim*V-1])
    let mut mD = dt2_zeros(dim * V)
    let mut vD = dt2_zeros(dim * V)

    // C/mitosis cell pool — initial_cells=2 (no ckpt load)
    let mut pool = cell_pool_init(dim, 2)
    let n_cells_0 = len(pool["cells"])

    // bridge G-side invariants (must stay constant — barrier witness)
    let psi0 = psi_balance()
    let cpl0 = psi_coupling()

    let mut fired_all = true
    let mut mito_live = true
    let mut min_cells = n_cells_0
    let mut gn2_0 = 0.0
    let mut gn2_1 = 0.0
    let steps = 60

    let mut st = 0
    while st < steps {
        let mut ep_gn2 = 0.0
        let mut s = 0
        while s < nsamp {
            // sample: class s → hot dim s (linearly separable byte toy)
            let mut raw = []
            let mut j = 0
            while j < dim {
                raw.push(if j == s { 1.0 } else { 0.05 } + to_float((st+j) % 3) / 60.0)
                j = j + 1
            }

            // ── S : perception = column-mean delta (2 synthetic cell rows) ──
            let sb = [0.10, 0.20, 0.30, 0.40, 0.15, 0.25, 0.35, 0.45]
            let mut sa = []
            j = 0
            while j < 8 { sa.push(sb[j] + raw[j % dim] * 0.1); j = j + 1 }
            let tension = s_perception(sb, sa, 2, dim)
            let fired_s = (len(tension) == dim)

            // ── C / mitosis : cell_pool forward_tail (live dynamics) ────────
            let mres = mitosis_forward_tail(raw, pool, st)
            let x_out = mres[0]
            pool = mres[1]
            let nc = len(pool["cells"])
            let fired_c = (nc >= 2)
            if nc < min_cells { min_cells = nc }
            if nc < 2 { mito_live = false }

            // phi readout (tiny-scale proxy = mean|x_out|; wiring, not real Φ)
            let mut phi = 0.0
            j = 0
            while j < len(x_out) { phi = phi + p6_abs(x_out[j]); j = j + 1 }
            phi = phi / to_float(len(x_out))

            // ── M : store (Hebbian no-op) + retrieve_topk ───────────────────
            // m_store = explicit no-op (C-side Hebbian LTP/LTD is the real
            // store) → returns 0. m_retrieve_topk(query, states, n, dim,
            // top_k) returns the top_k SELECTED state-indices (len == top_k),
            // NOT a dim-vector — fired ⟺ store no-op'd and retrieve returned
            // the requested top_k indices.
            let topk = 1
            let m_w = m_store(s, x_out)
            let retr = m_retrieve_topk(x_out, sa, 2, dim, topk)
            let fired_m = (m_w == 0) && (len(retr) == topk)

            // ── W : pain/curiosity → lr modulation ──────────────────────────
            let lrm = w_lr_mult(phi, nc)
            let fired_w = (lrm >= psi0)

            // ── E : Φ-ratchet safety gate ───────────────────────────────────
            let allowed = e_safety_allowed(phi, 0.5)
            let fired_e = (allowed == true) || (allowed == false)

            // ── Bridge : Ψ-clamp G→A coupling (gate observed, NOT signal-
            //   destroying). Mirrors the Python SSOT harness contract
            //   (integ_harness.py:185-194): Bridge emits a clamped GATE
            //   observed alongside D for the Law-70 ±ψ_coupling invariant —
            //   it modulates the class-bearing input, it does NOT replace
            //   it. (Earlier draft clamped the whole input to ≈ψ_balance,
            //   annihilating class separability → CE could not descend.)
            //   gate ∈ [ψ_bal−ψ_cpl, ψ_bal+ψ_cpl]; centered coupling δ =
            //   gate−ψ_bal ∈ [−0.014, +0.014] is added to the raw signal.
            let mut x = []
            let mut bridge_gate_min = 1.0
            let mut bridge_gate_max = 0.0
            j = 0
            while j < dim {
                let gate = bridge_clamp(raw[j])           // Ψ-clamped gate (G→A)
                if gate < bridge_gate_min { bridge_gate_min = gate }
                if gate > bridge_gate_max { bridge_gate_max = gate }
                let coupling = gate - psi0                 // δ ∈ [−ψ_cpl, ψ_cpl]
                x.push(raw[j] + coupling)                  // gate modulates, not replaces
                j = j + 1
            }
            // Law-70 invariant witness: gate stayed inside ψ_bal ± ψ_coupling.
            let fired_b = (len(x) == dim)
                          && (bridge_gate_min >= psi0 - cpl0 - 0.000001)
                          && (bridge_gate_max <= psi0 + cpl0 + 0.000001)

            // ── D : head forward + B-D-4 closed grad + AdamW (Group A only) ─
            let gW = dt2_bd4_grad(Wd, x, s, dim, V)
            ep_gn2 = ep_gn2 + dt2_gn2(Wd, x, s, dim, V)
            let lr = 0.05 * (lrm / psi0)            // W-modulated lr
            let upd = dt2_adamw_step(Wd, mD, vD, gW, lr, 0.9, 0.999,
                                     0.00000001, 0.01, st + 1)
            Wd = upd[0]; mD = upd[1]; vD = upd[2]
            let fired_d = (len(Wd) == dim * V)

            if !(fired_s && fired_c && fired_m && fired_w && fired_e
                 && fired_b && fired_d) { fired_all = false }
            s = s + 1
        }
        if st == 0 { gn2_0 = ep_gn2 }
        gn2_1 = ep_gn2
        st = st + 1
    }

    // ── Training-trace barrier (honest evidence + codegen liveness) ───────
    //   Emits the genuine loop-carried training state to stderr. Required
    //   for two reasons: (1) it is the honest gn2-trajectory / fired-all
    //   evidence trace for the artifact (real numbers, no fabrication);
    //   (2) it is an explicit observable side-effect of the training loop
    //   — without a post-loop observer the self-hosted codegen elides the
    //   loop's accumulated map/state mutations (a hexa-lang codegen DCE bug
    //   on side-effect-free loop tails; anima-side observability barrier
    //   chosen over a 7k-LoC self-host codegen patch with byte-identical
    //   regression risk — same doctrine as build_verify.sh:58-67).
    eprintln("[p6-trace] steps=" + to_string(steps)
             + " fired_all=" + to_string(fired_all)
             + " mito_live=" + to_string(mito_live)
             + " min_cells=" + to_string(min_cells)
             + " gn2_0=" + to_string(gn2_0)
             + " gn2_1=" + to_string(gn2_1))

    // ── F-INTEG-FULL-2 GRADIENT-BARRIER-CLEAN : G-side invariants const ───
    let barrier_ok = (psi_balance() == psi0) && (psi_coupling() == cpl0)
                     && (pool["d_model"] == dim)

    let f1 = fired_all
    let f2 = barrier_ok
    let f3 = seed_ok
    let f4 = mito_live && (min_cells >= 2)
    let f5 = (gn2_1 * 3.0) < gn2_0           // CE/gn2 descent (EMPIRICAL)

    println("  F-INTEG-FULL-1 SINGLE-FORWARD-WIRED  : " + to_string(f1))
    println("  F-INTEG-FULL-2 GRADIENT-BARRIER-CLEAN: " + to_string(f2)
            + "  (Ψ/coupling/d_model const, only W_d mutated)")
    println("  F-INTEG-FULL-3 SCRATCH-INIT-SEED-FIXED: " + to_string(f3))
    println("  F-INTEG-FULL-4 MITOSIS-WIRING-LIVE   : " + to_string(f4)
            + "  (min n_cells=" + to_string(min_cells) + " ≥ 2)")
    println("  F-INTEG-FULL-5 CE-DESCENT            : " + to_string(f5)
            + "  (gn2 " + to_string(gn2_0) + " → " + to_string(gn2_1) + ")")

    let np = (if f1 {1} else {0}) + (if f2 {1} else {0}) + (if f3 {1} else {0})
             + (if f4 {1} else {0}) + (if f5 {1} else {0})
    let ok = (np == 5)
    println("----------------------------------------------------------------")
    println("  F-INTEG-FULL " + to_string(np) + "/5  (TIER=EMPIRICAL — B-D-NOTE:")
    println("  CE-descent = SGD OUTCOME, NOT 🔵; trainability=B-D-4 🔵 별개)")
    println("  fire-gate (real-scale GPU = autonomous, g_fire_autonomous): "
            + to_string(ok))
    println("  selftest: " + (if ok { "true" } else { "false" }))
    println("================================================================")
    return if ok { 0 } else { 1 }
}

selftest()
