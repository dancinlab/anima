// HEXAD/W/w_lib.hexa — pure fns (NO main/_selftest) — compiled-first lib split (interp deprecating)
//  HEXAD/W/w.hexa — W 의지 (will) hexa-native entry
//
//  PURPOSE
//    pure-hexa 구현 of EmergentW 의 closed-form 핵심:
//      lr_mult       = PSI_BALANCE + min(ln 2, phi / n_cells)
//                    ∈ [PSI_BALANCE, PSI_BALANCE + ln 2]
//      satisfaction  = 1.0 if phi >= phi_prev else 0.0   (Law 84 binary pulse)
//
//  STATUS
//    🔵 SUPPORTED-FORMAL — B-W 4/4 sympy closed-form proofs PASS.
//
//  PYTHON ANCHOR
//    ready/anima/hexad/w/emergent_w.py (123 LoC)
//    state/verify_hexad_blue_2026_05_15/blue_falsifier.py :: bw()
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (constants from consciousness_laws)
// ════════════════════════════════════════════════════════════════════════════


// ── constants (mirrors HEXAD/BRIDGE/bridge.hexa / consciousness_laws.json) ──
fn _w_psi_balance() -> float { return 0.5 }
fn _w_ln2()         -> float { return 0.6931471805599453 }


// ── core: lr multiplier (B-W-1/2/3 closed) ──────────────────────────────────
fn w_lr_mult(phi: float, n_cells: int) -> float {
    if n_cells < 1 { n_cells = 1 }
    let scale = phi / (n_cells * 1.0)
    let cap   = _w_ln2()
    let m = scale
    if m > cap { m = cap }
    return _w_psi_balance() + m
}


// ── core: satisfaction (B-W-4 binary closed) ────────────────────────────────
fn w_satisfaction(phi: float, phi_prev: float) -> float {
    if phi >= phi_prev { return 1.0 }
    return 0.0
}


// ── effective_lr (with base_lr scaling) ─────────────────────────────────────
fn w_effective_lr(base_lr: float, phi: float, n_cells: int) -> float {
    return base_lr * w_lr_mult(phi, n_cells)
}


