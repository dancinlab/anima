// ════════════════════════════════════════════════════════════════════════════
//  HEXAD/W/w.hexa — W 의지 (will) hexa-native entry
//
//  PURPOSE
//    pure-hexa 구현 of EmergentW 의 closed-form 핵심:
//      lr_mult       = PSI_BALANCE + min(ln 2, phi / n_cells)
//                    ∈ [PSI_BALANCE, PSI_BALANCE + ln 2]
//      satisfaction  = 1.0 if phi >= phi_prev else 0.0   (Law 84 binary pulse)
//
//  STATUS
//    🔵 SUPPORTED-FORMAL — B-W 4/4 sympy closed-form proofs PASS.
//
//  PYTHON ANCHOR
//    ready/anima/hexad/w/emergent_w.py (123 LoC)
//    state/verify_hexad_blue_2026_05_15/blue_falsifier.py :: bw()
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (constants from consciousness_laws)
// ════════════════════════════════════════════════════════════════════════════


// ── constants (mirrors HEXAD/BRIDGE/bridge.hexa / consciousness_laws.json) ──
fn _w_psi_balance() -> float { return 0.5 }
fn _w_ln2()         -> float { return 0.6931471805599453 }


// ── core: lr multiplier (B-W-1/2/3 closed) ──────────────────────────────────
fn w_lr_mult(phi: float, n_cells: int) -> float {
    if n_cells < 1 { n_cells = 1 }
    let scale = phi / (n_cells * 1.0)
    let cap   = _w_ln2()
    let m = scale
    if m > cap { m = cap }
    return _w_psi_balance() + m
}


// ── core: satisfaction (B-W-4 binary closed) ────────────────────────────────
fn w_satisfaction(phi: float, phi_prev: float) -> float {
    if phi >= phi_prev { return 1.0 }
    return 0.0
}


// ── effective_lr (with base_lr scaling) ─────────────────────────────────────
fn w_effective_lr(base_lr: float, phi: float, n_cells: int) -> float {
    return base_lr * w_lr_mult(phi, n_cells)
}


// ── helpers for selftest ────────────────────────────────────────────────────
fn _approx_eq(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}


// ── selftest: B-W-{1,2,3,4} hexa-native witnesses ───────────────────────────
fn _selftest() {
    let tol = 1e-9
    let psi = _w_psi_balance()
    let ln2 = _w_ln2()

    // B-W-1 LR-RANGE-CLOSED — lr_mult ∈ [Ψ, Ψ + ln 2] ∀ phi ≥ 0, n ≥ 1
    let phis = [0.0, 0.1, 0.5, 1.0, 2.0, 5.0, 100.0]
    let ncs  = [1, 2, 4, 8, 32]
    let in_range = true
    let pi = 0
    while pi < len(phis) {
        let ni = 0
        while ni < len(ncs) {
            let m = w_lr_mult(phis[pi], ncs[ni])
            if (m < psi - tol) || (m > psi + ln2 + tol) { in_range = false }
            ni = ni + 1
        }
        pi = pi + 1
    }
    print("  B-W-1 LR-RANGE-CLOSED        : " + to_string(in_range))

    // B-W-2 LR-MONOTONE-CLOSED — non-decreasing in phi (fixed n)
    let mono = true
    let n_fix = 4
    let last = 0.0 - 1.0
    let pj = 0
    while pj < len(phis) {
        let v = w_lr_mult(phis[pj], n_fix)
        if v < last - tol { mono = false }
        last = v
        pj = pj + 1
    }
    print("  B-W-2 LR-MONOTONE-CLOSED     : " + to_string(mono))

    // B-W-3 LR-SUP-ATTAINED — saturated at phi/n_cells ≥ ln 2 → m == ln 2
    // Witness: phi = 100, n = 1 → phi/n = 100 ≥ ln 2 → cap = ln 2 → lr = Ψ + ln 2
    let sup = w_lr_mult(100.0, 1)
    let sup_ok = _approx_eq(sup, psi + ln2, 1e-12)
    // also test Min(L, kL) = L for k > 1: with L = ln 2 (cap), kL > L → min = L
    let kL_test = w_lr_mult(5.0 * ln2, 1)  // phi/n = 5 · ln 2 > ln 2 → min = ln 2
    let kL_ok = _approx_eq(kL_test, psi + ln2, 1e-12)
    print("  B-W-3 LR-SUP-ATTAINED        : " + to_string(sup_ok && kL_ok))

    // B-W-4 SATISFACTION-BINARY-CLOSED — output ∈ {0, 1} ∀ inputs
    let s1 = w_satisfaction(0.0, 0.0)   // ≥ → 1
    let s2 = w_satisfaction(0.5, 0.4)   // ≥ → 1
    let s3 = w_satisfaction(0.3, 0.4)   // <  → 0
    let s4 = w_satisfaction(-1.0, 0.0)  // <  → 0
    let bin_ok = _approx_eq(s1, 1.0, tol) && _approx_eq(s2, 1.0, tol)
                  && _approx_eq(s3, 0.0, tol) && _approx_eq(s4, 0.0, tol)
    print("  B-W-4 SATISFACTION-BINARY    : " + to_string(bin_ok))

    let all_ok = in_range && mono && sup_ok && kL_ok && bin_ok
    print("=== HEXAD/W selftest: " + to_string(all_ok) + " ===")
}


fn main() {
    print("HEXAD/W — 의지 (will) hexa-native entry")
    print("lr_mult = Ψ_balance + min(ln 2, Φ/n_cells)  ·  satisfaction binary")
    print("B-W 4/4 🔵 SUPPORTED-FORMAL anchor (sympy closed-form)")
    _selftest()
}
