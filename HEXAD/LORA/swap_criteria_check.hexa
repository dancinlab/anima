// HEXAD/LORA/swap_criteria_check.hexa — VP21M 5-criteria swap-readiness automation
//
// Purpose:
//   Automated measurement of the 5 SWAP/NO_SWAP criteria used per VP21M
//   Wave-13~16 (and forward). Replaces manual reading of result.json +
//   v5-baseline comparison with a single hexa-native check.
//
// 5 criteria (per Wave-15 / Wave-16 doc convention — README + WAVES_MATRIX):
//   1. VERDICT ∈ {VP21M_WORKS, WORKS}            — basic fitness (no REGISTER_REGRESS / FAIL)
//   2. n_strong ≥ 4                              — multilingual generalization floor (5 langs)
//   3. ja n_score ≥ 13                           — weakest-lang threshold
//   4. register_hits_continuous_total ≤ 50       — register-leak density ceiling
//   5. eval1 tag-leak ≤ 1 / 20                   — template-memorization ceiling
//
// Verbs:
//   check   <result.json> [eval1.json]           — single-adapter 5-criteria check
//   compare <wave_a_dir> <wave_b_dir>            — side-by-side (e.g. v5 prod vs v_new)
//   selftest                                     — F-SWAP-CHK-1..5 (synthetic) — 5/5 PASS
//
// Result.json key contract (state/p21m_v12_qwen_wave_2026_05_23/result.json):
//   d["verdict"]                          str   "VP21M_WORKS" / "REGISTER_REGRESS" / "FAIL"
//   d["n_strong"]                         int   0..5
//   d["per_lang_verdicts"]                array of {lang, verdict, n_score, ...}
//   d["register_hits_continuous_total"]   int   continuous register-hit sum across 20 outputs
//
// Eval1.json key contract (state/.../vp21m_eval1.json):
//   d["anima_greedy"]   array of {name, prompt, text, class, n_register_hits_continuous}
//   d["anima_sample"]   array (same shape)        — used for tag-leak union (denominator 20)
//   tag-leak = count of items whose text contains "<carve>" or "eternal_<digits>" / "Tier "
//   pattern (template-memorization markers per Wave-15/16 retention convention).

// ─── small helpers ────────────────────────────────────────────────────────

fn _str(x) {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _int(x, fallback: int) -> int {
    let t = type_of(x)
    if t == "int" { return x }
    if t == "float" { return int(x) }
    if t == "str" || t == "string" {
        let s = x.trim()
        if s == "" { return fallback }
        return int(s)
    }
    return fallback
}

fn is_map(v) -> bool {
    return type_of(v) == "map"
}

fn is_array(v) -> bool {
    return type_of(v) == "array"
}

fn fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn dexists(p: string) -> bool {
    return _str(exec("test -d " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn load_json_file(path: string) {
    if !fexists(path) { return #{} }
    let raw = read_file(path)
    return json_parse(raw)
}

// ─── criterion 1: VERDICT ∈ {VP21M_WORKS, WORKS} ──────────────────────────

fn check_verdict(result) -> bool {
    if !is_map(result) { return false }
    let v = _str(result["verdict"])
    if v == "VP21M_WORKS" { return true }
    if v == "WORKS"       { return true }
    return false
}

// ─── criterion 2: n_strong ≥ 4 ────────────────────────────────────────────

fn check_nstrong(result) -> bool {
    if !is_map(result) { return false }
    let n = _int(result["n_strong"], 0)
    return n >= 4
}

// ─── criterion 3: ja n_score ≥ 13 ─────────────────────────────────────────

fn get_lang_score(result, lang: string) -> int {
    if !is_map(result) { return 0 - 1 }
    let plv = result["per_lang_verdicts"]
    if !is_array(plv) { return 0 - 1 }
    let n = len(plv)
    let mut i = 0
    while i < n {
        let row = plv[i]
        if is_map(row) {
            if _str(row["lang"]) == lang {
                return _int(row["n_score"], 0 - 1)
            }
        }
        i = i + 1
    }
    return 0 - 1
}

fn check_ja_score(result) -> bool {
    let s = get_lang_score(result, "ja")
    if s < 0 { return false }
    return s >= 13
}

// ─── criterion 4: register_hits_continuous_total ≤ 50 ─────────────────────

fn check_continuous(result) -> bool {
    if !is_map(result) { return false }
    let v = result["register_hits_continuous_total"]
    let t = type_of(v)
    if t != "int" && t != "float" && t != "str" && t != "string" { return false }
    let n = _int(v, -1)
    if n < 0 { return false }
    return n <= 50
}

// ─── criterion 5: eval1 tag-leak ≤ 1 / 20 ─────────────────────────────────
//
// tag-leak markers (per Wave-15/16 retention convention):
//   - "<carve>"      — XML scaffold tag (corpus_v4 strip target)
//   - "eternal_"     — eternal-cell N-suffix pattern (corpus_v9/v10 cap target)
//   - "Tier "        — Tier-NNN domain header
// Counted per output across (anima_greedy ∪ anima_sample) — denominator 20.

fn text_has_tag_leak(text: string) -> bool {
    if text.index_of("<carve>")  >= 0 { return true }
    if text.index_of("</carve>") >= 0 { return true }
    if text.index_of("eternal_") >= 0 { return true }
    if text.index_of("Tier ")    >= 0 { return true }
    return false
}

fn count_tag_leak_in_array(arr) -> int {
    if !is_array(arr) { return 0 }
    let n = len(arr)
    let mut hits = 0
    let mut i = 0
    while i < n {
        let row = arr[i]
        if is_map(row) {
            let txt = _str(row["text"])
            if text_has_tag_leak(txt) { hits = hits + 1 }
        }
        i = i + 1
    }
    return hits
}

// returns dict #{hits, denom, pass}
fn measure_tag_leak(eval1) {
    let mut hits = 0
    let mut denom = 0
    if is_map(eval1) {
        let g = eval1["anima_greedy"]
        let s = eval1["anima_sample"]
        if is_array(g) {
            hits = hits + count_tag_leak_in_array(g)
            denom = denom + len(g)
        }
        if is_array(s) {
            hits = hits + count_tag_leak_in_array(s)
            denom = denom + len(s)
        }
    }
    let mut pass = false
    if denom > 0 { if hits <= 1 { pass = true } }
    return #{
        "hits":  hits,
        "denom": denom,
        "pass":  pass
    }
}

fn check_tag_leak(eval1) -> bool {
    let m = measure_tag_leak(eval1)
    return m["pass"]
}

// ─── master decision ──────────────────────────────────────────────────────

fn swap_decision(result, eval1) {
    let c1 = check_verdict(result)
    let c2 = check_nstrong(result)
    let c3 = check_ja_score(result)
    let c4 = check_continuous(result)
    let c5 = check_tag_leak(eval1)

    let mut total = 0
    if c1 { total = total + 1 }
    if c2 { total = total + 1 }
    if c3 { total = total + 1 }
    if c4 { total = total + 1 }
    if c5 { total = total + 1 }

    let mut decision = "NO_SWAP"
    if total == 5 { decision = "SWAP" }

    let ja_s = get_lang_score(result, "ja")
    let cont = _int(result["register_hits_continuous_total"], -1)
    let tagm = measure_tag_leak(eval1)

    let mut reasoning = []
    if c1 { reasoning = reasoning.push("[1] VERDICT PASS — " + _str(result["verdict"])) }
    else  { reasoning = reasoning.push("[1] VERDICT FAIL — " + _str(result["verdict"])) }
    if c2 { reasoning = reasoning.push("[2] n_strong PASS — " + to_string(_int(result["n_strong"],0)) + " ≥ 4") }
    else  { reasoning = reasoning.push("[2] n_strong FAIL — " + to_string(_int(result["n_strong"],0)) + " < 4") }
    if c3 { reasoning = reasoning.push("[3] ja_score PASS — " + to_string(ja_s) + " ≥ 13") }
    else  { reasoning = reasoning.push("[3] ja_score FAIL — " + to_string(ja_s) + " < 13") }
    if c4 { reasoning = reasoning.push("[4] continuous PASS — " + to_string(cont) + " ≤ 50") }
    else  { reasoning = reasoning.push("[4] continuous FAIL — " + to_string(cont) + " > 50") }
    if c5 { reasoning = reasoning.push("[5] tag_leak PASS — " + to_string(tagm["hits"]) + "/" + to_string(tagm["denom"]) + " ≤ 1") }
    else  { reasoning = reasoning.push("[5] tag_leak FAIL — " + to_string(tagm["hits"]) + "/" + to_string(tagm["denom"]) + " > 1") }

    return #{
        "criterion_results": #{
            "1_verdict":    c1,
            "2_nstrong":    c2,
            "3_ja_score":   c3,
            "4_continuous": c4,
            "5_tag_leak":   c5
        },
        "total_pass":     total,
        "swap_decision":  decision,
        "reasoning":      reasoning
    }
}

// ─── verb: check ──────────────────────────────────────────────────────────

fn verb_check(result_path: string, eval1_path: string) {
    if !fexists(result_path) {
        println("swap_criteria_check: ERROR — result.json not found: " + result_path)
        exit(2)
    }
    let result = load_json_file(result_path)
    let mut eval1 = #{}
    if eval1_path != "" {
        if !fexists(eval1_path) {
            println("swap_criteria_check: WARN — eval1.json not found, criterion #5 will FAIL: " + eval1_path)
        } else {
            eval1 = load_json_file(eval1_path)
        }
    }
    let dec = swap_decision(result, eval1)
    println("──────────────────────────────────────────────────────────────────")
    println("VP21M 5-criteria swap-readiness check")
    println("  result.json: " + result_path)
    if eval1_path != "" { println("  eval1.json:  " + eval1_path) }
    println("──────────────────────────────────────────────────────────────────")
    let reasons = dec["reasoning"]
    let n = len(reasons)
    let mut i = 0
    while i < n {
        println("  " + _str(reasons[i]))
        i = i + 1
    }
    println("──────────────────────────────────────────────────────────────────")
    println("  total_pass:    " + to_string(dec["total_pass"]) + " / 5")
    println("  decision:      " + _str(dec["swap_decision"]))
    println("──────────────────────────────────────────────────────────────────")
    if _str(dec["swap_decision"]) == "SWAP" { exit(0) }
    exit(1)
}

// ─── verb: compare ────────────────────────────────────────────────────────

fn _label_for_dir(d: string) -> string {
    let s = d.split("/")
    let n = len(s)
    if n == 0 { return d }
    let tail = _str(s[n - 1])
    if tail == "" {
        if n >= 2 { return _str(s[n - 2]) }
        return d
    }
    return tail
}

fn _bool_mark(b: bool) -> string {
    if b { return "PASS" }
    return "FAIL"
}

fn verb_compare(dir_a: string, dir_b: string) {
    if !dexists(dir_a) {
        println("swap_criteria_check: ERROR — dir not found: " + dir_a)
        exit(2)
    }
    if !dexists(dir_b) {
        println("swap_criteria_check: ERROR — dir not found: " + dir_b)
        exit(2)
    }
    let ra = load_json_file(dir_a + "/result.json")
    let rb = load_json_file(dir_b + "/result.json")
    let ea = load_json_file(dir_a + "/vp21m_eval1.json")
    let eb = load_json_file(dir_b + "/vp21m_eval1.json")
    let da = swap_decision(ra, ea)
    let db = swap_decision(rb, eb)

    let la = _label_for_dir(dir_a)
    let lb = _label_for_dir(dir_b)
    println("──────────────────────────────────────────────────────────────────")
    println("VP21M 5-criteria side-by-side: " + la + "  vs  " + lb)
    println("──────────────────────────────────────────────────────────────────")
    let cra = da["criterion_results"]
    let crb = db["criterion_results"]
    println("  [1] VERDICT     " + _bool_mark(cra["1_verdict"])    + "   |   " + _bool_mark(crb["1_verdict"]))
    println("  [2] n_strong    " + _bool_mark(cra["2_nstrong"])    + "   |   " + _bool_mark(crb["2_nstrong"]))
    println("  [3] ja_score    " + _bool_mark(cra["3_ja_score"])   + "   |   " + _bool_mark(crb["3_ja_score"]))
    println("  [4] continuous  " + _bool_mark(cra["4_continuous"]) + "   |   " + _bool_mark(crb["4_continuous"]))
    println("  [5] tag_leak    " + _bool_mark(cra["5_tag_leak"])   + "   |   " + _bool_mark(crb["5_tag_leak"]))
    println("──────────────────────────────────────────────────────────────────")
    println("  total_pass:     " + to_string(da["total_pass"]) + "/5     |   " + to_string(db["total_pass"]) + "/5")
    println("  decision:       " + _str(da["swap_decision"])  + "     |   " + _str(db["swap_decision"]))
    println("──────────────────────────────────────────────────────────────────")
    exit(0)
}

// ─── selftest: F-SWAP-CHK-1..5 ────────────────────────────────────────────
//
// Each falsifier asserts one criterion's bool logic on synthetic data.
// F-SWAP-CHK-1 — VERDICT: WORKS → true; FAIL → false
// F-SWAP-CHK-2 — n_strong: 4 → true; 3 → false; 5 → true
// F-SWAP-CHK-3 — ja n_score: ja=13 → true; ja=12 → false; missing → false
// F-SWAP-CHK-4 — continuous: 50 → true; 51 → false; missing → false
// F-SWAP-CHK-5 — tag-leak: 0/20 → true; 1/20 → true; 2/20 → false

fn _assert(cond: bool, label: string) -> bool {
    if cond {
        println("    OK  " + label)
        return true
    }
    println("    XX  " + label)
    return false
}

fn verb_selftest() {
    println("──────────────────────────────────────────────────────────────────")
    println("F-SWAP-CHK-1..5 selftest (synthetic data)")
    println("──────────────────────────────────────────────────────────────────")
    let mut pass = 0

    // F-SWAP-CHK-1 — VERDICT
    println("  F-SWAP-CHK-1 VERDICT")
    let r1a = #{"verdict": "VP21M_WORKS"}
    let r1b = #{"verdict": "FAIL"}
    let r1c = #{"verdict": "REGISTER_REGRESS"}
    let r1d = #{"verdict": "WORKS"}
    let mut ok1 = true
    if !_assert(check_verdict(r1a) == true,  "VP21M_WORKS → true")        { ok1 = false }
    if !_assert(check_verdict(r1b) == false, "FAIL → false")              { ok1 = false }
    if !_assert(check_verdict(r1c) == false, "REGISTER_REGRESS → false")  { ok1 = false }
    if !_assert(check_verdict(r1d) == true,  "WORKS → true")              { ok1 = false }
    if ok1 { pass = pass + 1; println("  F-SWAP-CHK-1 PASS") }
    else   { println("  F-SWAP-CHK-1 FAIL") }

    // F-SWAP-CHK-2 — n_strong
    println("  F-SWAP-CHK-2 n_strong")
    let r2a = #{"n_strong": 4}
    let r2b = #{"n_strong": 3}
    let r2c = #{"n_strong": 5}
    let r2d = #{"n_strong": 0}
    let mut ok2 = true
    if !_assert(check_nstrong(r2a) == true,  "4 → true")  { ok2 = false }
    if !_assert(check_nstrong(r2b) == false, "3 → false") { ok2 = false }
    if !_assert(check_nstrong(r2c) == true,  "5 → true")  { ok2 = false }
    if !_assert(check_nstrong(r2d) == false, "0 → false") { ok2 = false }
    if ok2 { pass = pass + 1; println("  F-SWAP-CHK-2 PASS") }
    else   { println("  F-SWAP-CHK-2 FAIL") }

    // F-SWAP-CHK-3 — ja n_score
    println("  F-SWAP-CHK-3 ja_score")
    let plv_a = [
        #{"lang": "en", "n_score": 19},
        #{"lang": "ja", "n_score": 13}
    ]
    let plv_b = [
        #{"lang": "en", "n_score": 19},
        #{"lang": "ja", "n_score": 12}
    ]
    let plv_c = [
        #{"lang": "en", "n_score": 19}
    ]
    let r3a = #{"per_lang_verdicts": plv_a}
    let r3b = #{"per_lang_verdicts": plv_b}
    let r3c = #{"per_lang_verdicts": plv_c}
    let mut ok3 = true
    if !_assert(check_ja_score(r3a) == true,  "ja=13 → true")    { ok3 = false }
    if !_assert(check_ja_score(r3b) == false, "ja=12 → false")   { ok3 = false }
    if !_assert(check_ja_score(r3c) == false, "missing → false") { ok3 = false }
    if ok3 { pass = pass + 1; println("  F-SWAP-CHK-3 PASS") }
    else   { println("  F-SWAP-CHK-3 FAIL") }

    // F-SWAP-CHK-4 — continuous
    println("  F-SWAP-CHK-4 continuous")
    let r4a = #{"register_hits_continuous_total": 50}
    let r4b = #{"register_hits_continuous_total": 51}
    let r4c = #{"register_hits_continuous_total": 0}
    let r4d = #{"register_hits_continuous_total": 91}
    let mut ok4 = true
    if !_assert(check_continuous(r4a) == true,  "50 → true")  { ok4 = false }
    if !_assert(check_continuous(r4b) == false, "51 → false") { ok4 = false }
    if !_assert(check_continuous(r4c) == true,  "0  → true")  { ok4 = false }
    if !_assert(check_continuous(r4d) == false, "91 → false") { ok4 = false }
    if ok4 { pass = pass + 1; println("  F-SWAP-CHK-4 PASS") }
    else   { println("  F-SWAP-CHK-4 FAIL") }

    // F-SWAP-CHK-5 — tag-leak (3 synthetic eval1 dicts)
    // Note: hexa `arr = arr.push(x)` mutates the underlying reference, so each
    //       scenario builds its arrays from scratch (no aliasing) to keep
    //       fixtures independent.
    println("  F-SWAP-CHK-5 tag_leak")

    // Scenario A — 0 leak / 20 (10 clean + 10 clean) → PASS
    let mut a_greedy = []
    let mut a_sample = []
    let mut ai5 = 0
    while ai5 < 10 {
        a_greedy = a_greedy.push(#{"text": "clean factual sentence."})
        a_sample = a_sample.push(#{"text": "another clean sentence."})
        ai5 = ai5 + 1
    }
    let e5a = #{
        "anima_greedy": a_greedy,
        "anima_sample": a_sample
    }

    // Scenario B — 1 leak / 20 (9 clean + 1 leak + 10 clean) → PASS
    let mut b_greedy = []
    let mut b_sample = []
    let mut bi5 = 0
    while bi5 < 9 {
        b_greedy = b_greedy.push(#{"text": "clean."})
        bi5 = bi5 + 1
    }
    b_greedy = b_greedy.push(#{"text": "eternal_080 sample text"})
    let mut bj5 = 0
    while bj5 < 10 {
        b_sample = b_sample.push(#{"text": "clean."})
        bj5 = bj5 + 1
    }
    let e5b = #{
        "anima_greedy": b_greedy,
        "anima_sample": b_sample
    }

    // Scenario C — 2 leak / 20 (9 clean + 1 leak + 9 clean + 1 leak) → FAIL
    let mut c_greedy = []
    let mut c_sample = []
    let mut ci5 = 0
    while ci5 < 9 {
        c_greedy = c_greedy.push(#{"text": "clean."})
        ci5 = ci5 + 1
    }
    c_greedy = c_greedy.push(#{"text": "Tier 124 reference here"})
    let mut cj5 = 0
    while cj5 < 9 {
        c_sample = c_sample.push(#{"text": "clean."})
        cj5 = cj5 + 1
    }
    c_sample = c_sample.push(#{"text": "<carve>scaffold</carve>"})
    let e5c = #{
        "anima_greedy": c_greedy,
        "anima_sample": c_sample
    }

    let mut ok5 = true
    if !_assert(check_tag_leak(e5a) == true,  "0/20 → true")  { ok5 = false }
    if !_assert(check_tag_leak(e5b) == true,  "1/20 → true")  { ok5 = false }
    if !_assert(check_tag_leak(e5c) == false, "2/20 → false") { ok5 = false }
    if ok5 { pass = pass + 1; println("  F-SWAP-CHK-5 PASS") }
    else   { println("  F-SWAP-CHK-5 FAIL") }

    println("──────────────────────────────────────────────────────────────────")
    println("F-SWAP-CHK-1..5 " + to_string(pass) + "/5 PASS")
    println("──────────────────────────────────────────────────────────────────")
    if pass == 5 { exit(0) }
    exit(1)
}

// ─── usage ────────────────────────────────────────────────────────────────

fn print_usage() {
    println("usage:")
    println("  hexa run HEXAD/LORA/swap_criteria_check.hexa -- selftest")
    println("  hexa run HEXAD/LORA/swap_criteria_check.hexa -- check <result.json> [eval1.json]")
    println("  hexa run HEXAD/LORA/swap_criteria_check.hexa -- compare <dir_a> <dir_b>")
}

// ─── main ─────────────────────────────────────────────────────────────────

fn main() {
    // args()[0] = hexa interp binary path; user args start at [1]
    let raw = args()
    let mut argv = []
    let mut ai = 1
    while ai < len(raw) {
        argv = argv.push(raw[ai])
        ai = ai + 1
    }
    let n = len(argv)
    if n < 1 {
        print_usage()
        exit(2)
    }
    let verb = _str(argv[0])
    if verb == "selftest" {
        verb_selftest()
        return
    }
    if verb == "check" {
        if n < 2 {
            print_usage()
            exit(2)
        }
        let rpath = _str(argv[1])
        let mut epath = ""
        if n >= 3 { epath = _str(argv[2]) }
        verb_check(rpath, epath)
        return
    }
    if verb == "compare" {
        if n < 3 {
            print_usage()
            exit(2)
        }
        verb_compare(_str(argv[1]), _str(argv[2]))
        return
    }
    print_usage()
    exit(2)
}
