// ════════════════════════════════════════════════════════════════════════════
//  HEXAD/hexad_forward_smoke.hexa — runnable proof of the REAL σ6 cross-module
//  single-process forward (HEXAD/hexad_forward.hexa).
//
//  Proves deterministically ($0 · CPU · no GPU · no LLM · no ckpt):
//    (a) the cross-module forward RUNS as ONE call over all six modules and is
//        DETERMINISTIC (same input → byte-identical output across two runs).
//    (b) it EMITS a real N=6 module-activation vector (the OMEGA w5 `module_act`
//        source) — length == hexad_fwd_n_modules() == 6.
//    (c) the φ(6)=2 PARTITION is respected: a perturbation injected into the
//        group-A DETACHED copy (the C→Bridge.detach barrier) changes the GROUP-A
//        activations {M,E,Bridge} but leaves the GROUP-G activations {S,C,W}
//        BYTE-INVARIANT — the two gradient paths are DISTINCT (Law 53 barrier).
//    (d) the D node is the honest RECEIVED signal (post-detach Law-70 gate), and
//        the D byte forward stays the labelled ckpt-gated stub (no phantom wiring).
//
//  usage:  hexa run HEXAD/hexad_forward_smoke.hexa
// ════════════════════════════════════════════════════════════════════════════

import "HEXAD/hexad_forward.hexa"

fn _ab(label: string, want: bool, got: bool) -> bool {
    let ws = if want { "true" } else { "false" }
    let gs = if got  { "true" } else { "false" }
    if want == got { println("PASS  " + label + " want=" + ws + " got=" + gs); return true }
    println("FAIL  " + label + " want=" + ws + " got=" + gs)
    return false
}

fn _veq(a: [float], b: [float]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0

    // ── fixture: a small C cell pool (n_cells=2, dim=2), t-1 and t states ────
    let before = [0.10, 0.20, 0.30, 0.40]   // 2 cells × 2 dim, row-major
    let after  = [0.90, 0.10, 0.20, 0.80]   // evolved pool at t
    let phi_prev = 0.30
    let ratchet  = 0.60

    // ── (a) RUNS as ONE call + DETERMINISTIC ─────────────────────────────────
    let r1 = hexad_forward(before, after, 2, 2, phi_prev, ratchet, 0.0)
    let r2 = hexad_forward(before, after, 2, 2, phi_prev, ratchet, 0.0)
    let v1 = hexad_forward_vec(r1)
    let v2 = hexad_forward_vec(r2)
    if _ab("a_runs_real", true, r1["real"]) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _ab("a_deterministic_vec_byte_eq", true, _veq(v1, v2)) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _ab("a_deterministic_d_input_eq", true, hexad_forward_d_input(r1) == hexad_forward_d_input(r2)) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // ── (b) EMITS a real N=6 vector ──────────────────────────────────────────
    if _ab("b_vec_len_is_6", true, len(v1) == 6) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _ab("b_n_modules_is_6", true, r1["n_modules"] == 6) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _ab("b_order_len_is_6", true, len(r1["order"]) == 6) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    println("INFO  module_act = " + to_string(v1) + "  order=" + to_string(r1["order"]))
    println("INFO  phi=" + to_string(r1["phi"]) + " lr_mult=" + to_string(r1["lr_mult"])
            + " satisfaction=" + to_string(r1["satisfaction"]) + " gate_allowed=" + to_string(r1["gate_allowed"]))

    // ── (c) φ(6)=2 PARTITION — detach barrier: group-A moves, group-G frozen ──
    // Inject a perturbation into the group-A DETACHED copy only.
    let rp = hexad_forward(before, after, 2, 2, phi_prev, ratchet, 0.5)
    let g_base = r1["group_g"]     // {S, C, W}
    let g_pert = rp["group_g"]
    let a_base = r1["group_a"]     // {M, E, Bridge}
    let a_pert = rp["group_a"]
    // group G is BYTE-INVARIANT to the group-A detach perturbation (barrier holds).
    if _ab("c_groupG_invariant_under_detach_perturb", true, _veq(g_base, g_pert)) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    // group A DOES change (the two paths are genuinely distinct, not aliased).
    if _ab("c_groupA_changes_under_detach_perturb", true, !_veq(a_base, a_pert)) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    // partition cardinality: |G|=3 {S,C,W}, |A|=3 {M,E,Bridge} → φ(6)=2 groups.
    if _ab("c_groupG_card_3", true, len(g_base) == 3) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _ab("c_groupA_card_3", true, len(a_base) == 3) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    println("INFO  group_G {S,C,W} base=" + to_string(g_base) + "  perturbed=" + to_string(g_pert) + " (INVARIANT — Law 53 detach barrier)")
    println("INFO  group_A {M,E,Bridge} base=" + to_string(a_base) + "  perturbed=" + to_string(a_pert) + " (MOVES — group A reads the detached copy)")

    // ── (d) D node = honest received signal; byte forward = labelled ckpt stub ─
    if _ab("d_d_input_is_bridge_gate", true, hexad_forward_d_input(r1) == r1["bridge_act"]) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _ab("d_d_forward_labelled_stub", true, len(to_string(r1["d_forward"])) > 0) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    println("INFO  D node: d_input=" + to_string(r1["d_input"]) + " (post-detach Law-70 gate) · d_forward=" + to_string(r1["d_forward"]))
    println("INFO  graph: " + to_string(r1["graph"]))

    println("--- hexad_forward smoke summary: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
