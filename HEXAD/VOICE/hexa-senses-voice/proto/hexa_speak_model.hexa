fn hsm_audio_token_predictor_forward(intent_seq) {
    // PHASE B TODO: embed_proj + DECODER_LAYERS=3 stack + per-stage RVQ heads
    return intent_seq
}


fn hsm_rvq_decoder_decode(tokens) {
    // PHASE B TODO: codebook lookup × 8 stages + concat + W_syn → frames →
    //               hanning window overlap-add → tanh clip
    return tokens
}


fn hsm_generate(intent_embed, emotion, prosody, voice_id, duration_s: float) {
    let ctx = hsm_intent_conditioner_forward(intent_embed, emotion, prosody, voice_id)
    let predicted = hsm_audio_token_predictor_forward(ctx)
    let audio = hsm_rvq_decoder_decode(predicted)
    return audio
}


// ═══════════════════════════════════════════════════════════════════════════
//  Phase A selftest — config arithmetic identity + helper correctness
// ═══════════════════════════════════════════════════════════════════════════

fn hsm_assert_eq(label: string, a: int, b: int) {
    if a != b {
        println("    FAIL:", label, "expected", b, "got", a)
        return false
    }
    return true
}


fn selftest() {
    println("════════════════════════════════════════════════════════════════")
    println("  hexa_speak_model Phase A — 43 EXACT n=6 params + helpers")
    println("════════════════════════════════════════════════════════════════")

    let mut ok = true

    if !hsm_assert_eq("SAMPLE_RATE",        hsm_SAMPLE_RATE(),       24000) { ok = false }
    if !hsm_assert_eq("SAMPLES_PER_FRAME",  hsm_SAMPLES_PER_FRAME(), 480)   { ok = false }
    if !hsm_assert_eq("FPS",                hsm_FPS(),               50)    { ok = false }
    if !hsm_assert_eq("RVQ_STAGES",         hsm_RVQ_STAGES(),        8)     { ok = false }
    if !hsm_assert_eq("CODEBOOK_ENTRIES",   hsm_CODEBOOK_ENTRIES(),  1024)  { ok = false }
    if !hsm_assert_eq("HIDDEN",             hsm_HIDDEN(),            768)   { ok = false }
    if !hsm_assert_eq("HEADS",              hsm_HEADS(),             12)    { ok = false }
    if !hsm_assert_eq("HEAD_DIM",           hsm_HEAD_DIM(),          64)    { ok = false }
    if !hsm_assert_eq("EMBED_DIM",          hsm_EMBED_DIM(),         384)   { ok = false }
    if !hsm_assert_eq("VOICE_ID_DIM",       hsm_VOICE_ID_DIM(),      192)   { ok = false }
    if !hsm_assert_eq("CONTEXT_FRAMES",     hsm_CONTEXT_FRAMES(),    500)   { ok = false }
    if !hsm_assert_eq("RING_BUFFER_MS",     hsm_RING_BUFFER_MS(),    240)   { ok = false }
    if !hsm_assert_eq("TURN_TAKING_MS",     hsm_TURN_TAKING_MS(),    1500)  { ok = false }

    let s_phi = hsm_SIGMA() * hsm_PHI()
    let n_tau = hsm_N() * hsm_TAU()
    if !hsm_assert_eq("σ·φ = J₂ = 24",    s_phi, hsm_J2()) { ok = false }
    if !hsm_assert_eq("n·τ = J₂ = 24",    n_tau, hsm_J2()) { ok = false }

    let sm = hsm_softmax([1.0, 2.0, 3.0])
    let mut sm_sum = 0.0
    let mut i = 0
    while i < 3 { sm_sum = sm_sum + sm[i] i = i + 1 }
    let mut sm_err = sm_sum - 1.0
    if sm_err < 0.0 { sm_err = 0.0 - sm_err }
    if sm_err > 1.0e-9 {
        println("    FAIL: softmax sum != 1, got", sm_sum)
        ok = false
    }

    let ln = hsm_layer_norm([0.0, 1.0, 2.0, 3.0, 4.0])
    let mut ln_sum = 0.0
    let mut j = 0
    while j < 5 { ln_sum = ln_sum + ln[j] j = j + 1 }
    let mut ln_err = ln_sum
    if ln_err < 0.0 { ln_err = 0.0 - ln_err }
    if ln_err > 1.0e-4 {
        println("    FAIL: layer_norm mean != 0, got", ln_sum)
        ok = false
    }

    let win = hsm_hanning(5)
    if win[0] != 0.0 {
        println("    FAIL: hanning[0] != 0, got", win[0])
        ok = false
    }
    if win[4] != 0.0 {
        println("    FAIL: hanning[N-1] != 0, got", win[4])
        ok = false
    }

    if ok {
        println("  ✅ Phase A 43 EXACT params + helpers (softmax/layer_norm/hanning/silu) PASS")
    }
    return ok
}


fn main() {
    let ok = selftest()
    if !ok {
        println("Phase A selftest FAILED — see above")
    }
}
