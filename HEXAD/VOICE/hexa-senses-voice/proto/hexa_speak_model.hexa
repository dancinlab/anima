// 2026-05-25 phase3 sweep: hsm_hanning delegates to stdlib symmetric Hann.
import "stdlib/signal/core_window.hexa"


// ═══════════════════════════════════════════════════════════════════════════
//  n=6 Constants (frozen, all closed-form)
// ═══════════════════════════════════════════════════════════════════════════
fn hsm_PHI()    { return 2 }
fn hsm_TAU()    { return 4 }
fn hsm_SIGMA()  { return 12 }
fn hsm_SOPFR()  { return 5 }
fn hsm_MU()     { return 1 }
fn hsm_J2()     { return 24 }
fn hsm_N()      { return 6 }
fn hsm_S_PHI()  { return hsm_SIGMA() - hsm_PHI() }
fn hsm_S_TAU()  { return hsm_SIGMA() - hsm_TAU() }
fn hsm_S_SOP()  { return hsm_SIGMA() - hsm_SOPFR() }
fn hsm_N_PHI()  { return hsm_N() / hsm_PHI() }


// ═══════════════════════════════════════════════════════════════════════════
//  Architecture Parameters (43 EXACT values from n=6 lattice)
// ═══════════════════════════════════════════════════════════════════════════
fn hsm_SAMPLE_RATE()       { return hsm_J2() * 1000 }
fn hsm_BITRATE()           { return hsm_N() }
fn hsm_CHANNELS()          { return hsm_MU() }
fn hsm_BIT_DEPTH()         { return hsm_J2() }
fn hsm_HOP_MS()            { return hsm_S_PHI() * hsm_PHI() }
fn hsm_SAMPLES_PER_FRAME() { return hsm_J2() * hsm_S_PHI() * hsm_PHI() }
fn hsm_FPS()               { return hsm_SOPFR() * hsm_S_PHI() }
fn hsm_RVQ_STAGES()        { return hsm_S_TAU() }
fn hsm_CODEBOOK_ENTRIES()  { return 1024 }
fn hsm_BITS_PER_FRAME()    { return hsm_S_TAU() * hsm_S_PHI() }
fn hsm_TOKENS_PER_SEC()    { return hsm_S_TAU() * hsm_SOPFR() * hsm_S_PHI() }
fn hsm_DECODER_LAYERS()    { return hsm_N_PHI() }
fn hsm_HEADS()             { return hsm_SIGMA() }
fn hsm_HIDDEN()            { return hsm_N_PHI() * 256 }
fn hsm_HEAD_DIM()          { return 64 }
fn hsm_FFN_EXP()           { return hsm_TAU() }
fn hsm_EMBED_DIM()         { return hsm_N_PHI() * 128 }
fn hsm_PROJ_DIM()          { return 512 }
fn hsm_CONTEXT_S()         { return hsm_S_PHI() }
fn hsm_CONTEXT_FRAMES()    { return hsm_S_PHI() * hsm_S_PHI() * hsm_SOPFR() }
fn hsm_EMOTIONS()          { return hsm_N() }
fn hsm_PROSODY_DIMS()      { return hsm_TAU() }
fn hsm_VOICE_ID_DIM()      { return hsm_SIGMA() * (hsm_SIGMA() + hsm_TAU()) }
fn hsm_STYLES()            { return hsm_S_TAU() }
fn hsm_PITCH_RANGE()       { return hsm_S_PHI() }
fn hsm_FIRST_PACKET_MS()   { return hsm_S_PHI() * hsm_S_PHI() }
fn hsm_CHUNK_FRAMES()      { return hsm_SIGMA() }
fn hsm_LOOKAHEAD()         { return hsm_TAU() }
fn hsm_RING_BUFFER_MS()    { return hsm_SIGMA() * (hsm_J2() - hsm_TAU()) }
fn hsm_PLC_GAP_MS()        { return hsm_SIGMA() * hsm_SOPFR() }
fn hsm_CROSSFADE_MS()      { return hsm_N() }
fn hsm_MAX_GEN_S()         { return hsm_SOPFR() * hsm_N() }
fn hsm_SELF_WER_PCT()      { return hsm_N_PHI() }
fn hsm_DROPOUT()           { return 1.0 / hsm_S_PHI() }
fn hsm_WARMUP()            { return 2048 }
fn hsm_BATCH()             { return 32 }
fn hsm_MAX_SPEAKERS()      { return hsm_PHI() }
fn hsm_VAD_STATES()        { return hsm_TAU() }
fn hsm_VAD_LOOKBACK()      { return hsm_SOPFR() }
fn hsm_TURN_TAKING_MS()    {
    return hsm_S_PHI() * hsm_S_PHI() * (hsm_SIGMA() + hsm_N_PHI())
}


// ═══════════════════════════════════════════════════════════════════════════
//  Helpers (numpy 원본 parity)
// ═══════════════════════════════════════════════════════════════════════════

fn hsm_softmax(x) {
    let n = len(x)
    let mut mx = x[0]
    let mut i = 1
    while i < n {
        if x[i] > mx { mx = x[i] }
        i = i + 1
    }
    let mut sm = 0.0
    let mut e = []
    let mut j = 0
    while j < n {
        let v = exp(x[j] - mx)
        e.push(v)
        sm = sm + v
        j = j + 1
    }
    let mut out = []
    let mut k = 0
    while k < n {
        out.push(e[k] / sm)
        k = k + 1
    }
    return out
}


fn hsm_layer_norm(x) {
    let n = len(x)
    let eps = 1.0e-5
    let mut m = 0.0
    let mut i = 0
    while i < n { m = m + x[i] i = i + 1 }
    m = m / n
    let mut var = 0.0
    let mut j = 0
    while j < n {
        let d = x[j] - m
        var = var + d * d
        j = j + 1
    }
    var = var / n
    let s = sqrt(var)
    let mut out = []
    let mut k = 0
    while k < n { out.push((x[k] - m) / (s + eps)) k = k + 1 }
    return out
}


fn hsm_hanning(n_samples: int) {
    // Symmetric Hann window via stdlib/signal/core_window (libm cos).
    // Previously: inline `0.5*(1-cos(2*pi*i/(N-1)))` — semantically identical
    // for libm-`cos`, now centralized through the stdlib SSOT.
    let mut w = []
    let mut i = 0
    while i < n_samples {
        w.push(hann_window(i, n_samples))
        i = i + 1
    }
    return w
}


fn hsm_silu(x) {
    let n = len(x)
    let mut out = []
    let mut i = 0
    while i < n {
        let s = 1.0 / (1.0 + exp(0.0 - x[i]))
        out.push(x[i] * s)
        i = i + 1
    }
    return out
}


