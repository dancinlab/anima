// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_voice_smoke.hexa — VOICE Phase 1 combined impl + F-VOICE-1..5
//
//  PURPOSE
//    VOICE.tape Phase 1 formulaic-only first-cycle:
//      • intent_proj.apply (1024d hidden → 18d i_vec, n=6 closed-form)
//      • voice_emit (silence-gated formulaic synth)
//      • F-VOICE-1..5 falsifier selftest
//
//    Single-file impl (Phase 1) — hexa-lang import w/ alias 가 본 cycle 에서
//    parse-OK but runtime-undefined. modular split (intent_proj.hexa +
//    voice_bridge.hexa) 는 hexa-lang module resolver 작동 후 Phase 2 에서.
//    canonical synth (hexa-senses/voice/proto/*) 자체도 stub — Phase 2 가 그
//    full port.
//
//  USAGE
//    RESOURCE_LOCAL_HEXA=1 hexa run tool/anima_voice_smoke.hexa
//
//  FALSIFIERS (per VOICE.tape §3.1)
//    F-VOICE-1 PROJ-DETERMINISTIC    intent_proj.apply bit-identical on repeat
//    F-VOICE-2 SYNTH-ROUNDTRIP       PCM byte-identical on repeat (loud input)
//    F-VOICE-3 PARALLEL-EMERGE       intent_v + pcm computed w/o lm_head call
//    F-VOICE-4 SILENCE-DETERMINISTIC silence path byte-identical, |amp| < 1e-3
//    F-VOICE-5 NO-LEARNED-DEPENDENCY ip_all_weights_frozen() == true
// ════════════════════════════════════════════════════════════════════════════


// ── n=6 lattice closed-form constants ────────────────────────────────────────
fn ip_sigma_6()  { return 12 }
fn ip_tau_6()    { return 4 }
fn ip_phi_6()    { return 2 }
fn ip_d_model()  { return 1024 }
fn ip_d_intent() { return ip_sigma_6() + ip_tau_6() + ip_phi_6() }

// VOICE.tape §2.3 silence threshold = GZ_WIDTH = ln(4/3).
fn ip_silence_threshold() { return log(4.0 / 3.0) }


// ── intent_proj.apply equivalent ─────────────────────────────────────────────
//
//   i_vec[0..11]  = hidden[0..11]   (σ=12 timbre slots)
//   i_vec[12..15] = hidden[12..15]  (τ=4 prosody dims)
//   i_vec[16]     = silence_gate    (mean(|hidden[16..]|))
//   i_vec[17]     = sender_id       (sign(sum(hidden[16..])))
//
fn ip_apply(hidden) {
    let prefix_n = ip_sigma_6() + ip_tau_6()
    let mut out = []
    let mut i = 0
    while i < prefix_n {
        out.push(hidden[i])
        i = i + 1
    }

    let mut tail_sum = 0.0
    let mut tail_abs_sum = 0.0
    let mut tail_len = 0
    let mut j = prefix_n
    while j < ip_d_model() {
        let v = hidden[j]
        tail_sum = tail_sum + v
        if v < 0.0 {
            tail_abs_sum = tail_abs_sum - v
        }
        if v >= 0.0 {
            tail_abs_sum = tail_abs_sum + v
        }
        tail_len = tail_len + 1
        j = j + 1
    }

    let mut silence_gate = 0.0
    if tail_len > 0 {
        silence_gate = tail_abs_sum / tail_len
    }
    out.push(silence_gate)

    let mut sender_id = 1.0
    if tail_sum < 0.0 {
        sender_id = -1.0
    }
    out.push(sender_id)

    return out
}


fn ip_all_weights_frozen() { return true }


// ── PCM frame constants ──────────────────────────────────────────────────────
fn vb_sample_rate_hz()    { return 24000 }
fn vb_samples_per_frame() { return 320 }


// ── Silence-pattern generator (deterministic, formulaic) ─────────────────────
fn formulaic_silent_timbre(i_vec, n_frames: int) {
    let mut pcm = []
    let pi = 3.14159265358979
    let samples_per_frame = vb_samples_per_frame()
    let sigma = ip_sigma_6()

    let total_samples = n_frames * samples_per_frame
    let mut s = 0
    while s < total_samples {
        let mut acc = 0.0
        let mut k = 0
        while k < sigma {
            let phase = 2.0 * pi * (k + 1) * s / samples_per_frame
            acc = acc + i_vec[k] * sin(phase)
            k = k + 1
        }
        let sample = 1e-4 * acc / sigma
        pcm.push(sample)
        s = s + 1
    }
    return pcm
}


// ── Synth stub (Phase 1 deterministic placeholder) ───────────────────────────
fn formulaic_synth_stub(i_vec, n_frames: int) {
    let mut pcm = []
    let pi = 3.14159265358979
    let samples_per_frame = vb_samples_per_frame()
    let sample_rate = vb_sample_rate_hz()
    let sigma = ip_sigma_6()

    let mut timbre_sum = 0.0
    let mut k = 0
    while k < sigma {
        timbre_sum = timbre_sum + i_vec[k]
        k = k + 1
    }
    let timbre_phase = 2.0 * pi * timbre_sum / sigma
    let prosody_freq = 100.0 + 50.0 * i_vec[sigma]

    let total_samples = n_frames * samples_per_frame
    let mut s = 0
    while s < total_samples {
        let phase = 2.0 * pi * prosody_freq * s / sample_rate + timbre_phase
        let sample = 0.1 * sin(phase)
        pcm.push(sample)
        s = s + 1
    }
    return pcm
}


// ── Main bridge function (voice_bridge.voice_emit equivalent) ────────────────
fn voice_emit(hidden, n_frames: int) {
    let i_vec = ip_apply(hidden)

    let gate = i_vec[ip_sigma_6() + ip_tau_6()]
    let mut abs_gate = gate
    if abs_gate < 0.0 { abs_gate = 0.0 - gate }

    let threshold = ip_silence_threshold()
    let is_silent = abs_gate < threshold

    let mut pcm = []
    let mut path_label = "synth_stub"
    if is_silent {
        pcm = formulaic_silent_timbre(i_vec, n_frames)
        path_label = "silent"
    }
    if !is_silent {
        pcm = formulaic_synth_stub(i_vec, n_frames)
        path_label = "synth_stub"
    }

    return #{
        "intent_v":     i_vec,
        "silence_gate": gate,
        "is_silent":    is_silent,
        "pcm":          pcm,
        "synth_path":   path_label,
        "all_frozen":   ip_all_weights_frozen(),
    }
}


// ── Test hidden state generator ──────────────────────────────────────────────
fn make_hidden(mode: string) {
    let mut h = []
    let d = 1024
    let mut i = 0
    while i < d {
        if mode == "silent" {
            h.push(0.0)
        }
        if mode == "loud" {
            let m = i - (i / 11) * 11
            let v = m - 5
            h.push(v / 5.0)
        }
        i = i + 1
    }
    return h
}


// ── F-VOICE-1: PROJ-DETERMINISTIC ────────────────────────────────────────────
fn f_voice_1() {
    println("  F-VOICE-1 (PROJ-DETERMINISTIC) ...")
    let h = make_hidden("loud")
    let a = ip_apply(h)
    let b = ip_apply(h)
    if len(a) != len(b) {
        println("    FAIL: length mismatch")
        return false
    }
    if len(a) != ip_d_intent() {
        println("    FAIL: expected d_intent =", ip_d_intent(), "got", len(a))
        return false
    }
    let mut i = 0
    while i < len(a) {
        if a[i] != b[i] {
            println("    FAIL: mismatch at index", i)
            return false
        }
        i = i + 1
    }
    println("    PASS")
    return true
}


// ── F-VOICE-2: SYNTH-ROUNDTRIP byte-identical ────────────────────────────────
fn f_voice_2() {
    println("  F-VOICE-2 (SYNTH-ROUNDTRIP byte-identical) ...")
    let h = make_hidden("loud")
    let r1 = voice_emit(h, 3)
    let r2 = voice_emit(h, 3)
    let p1 = r1["pcm"]
    let p2 = r2["pcm"]
    if len(p1) != len(p2) {
        println("    FAIL: length mismatch")
        return false
    }
    if len(p1) != 960 {
        println("    FAIL: expected 960 samples, got", len(p1))
        return false
    }
    let mut i = 0
    while i < len(p1) {
        if p1[i] != p2[i] {
            println("    FAIL: PCM mismatch at sample", i)
            return false
        }
        i = i + 1
    }
    if r1["synth_path"] != "synth_stub" {
        println("    FAIL: expected synth_stub path, got", r1["synth_path"])
        return false
    }
    println("    PASS")
    return true
}


// ── F-VOICE-3: PARALLEL-EMERGE ───────────────────────────────────────────────
fn f_voice_3() {
    println("  F-VOICE-3 (PARALLEL-EMERGE) ...")
    let h = make_hidden("loud")
    let i_vec = ip_apply(h)
    if len(i_vec) != ip_d_intent() {
        println("    FAIL: intent_v shape wrong")
        return false
    }
    let r = voice_emit(h, 1)
    let pcm = r["pcm"]
    if len(pcm) != 320 {
        println("    FAIL: voice_emit failed w/o lm_head context")
        return false
    }
    println("    PASS (intent_v + pcm 생성이 lm_head 없이 완료)")
    return true
}


// ── F-VOICE-4: SILENCE-DETERMINISTIC ─────────────────────────────────────────
fn f_voice_4() {
    println("  F-VOICE-4 (SILENCE-DETERMINISTIC byte-identical) ...")
    let h_silent = make_hidden("silent")
    let r1 = voice_emit(h_silent, 2)
    let r2 = voice_emit(h_silent, 2)

    if r1["is_silent"] != true {
        println("    FAIL: silent input not detected as silent")
        return false
    }
    if r1["synth_path"] != "silent" {
        println("    FAIL: expected silent path, got", r1["synth_path"])
        return false
    }

    let p1 = r1["pcm"]
    let p2 = r2["pcm"]
    if len(p1) != len(p2) {
        println("    FAIL: silent pcm length mismatch")
        return false
    }
    let mut i = 0
    while i < len(p1) {
        if p1[i] != p2[i] {
            println("    FAIL: silent pcm mismatch at", i)
            return false
        }
        i = i + 1
    }
    let mut max_abs = 0.0
    let mut j = 0
    while j < len(p1) {
        let v = p1[j]
        let mut av = v
        if av < 0.0 { av = 0.0 - v }
        if av > max_abs { max_abs = av }
        j = j + 1
    }
    if max_abs > 1e-3 {
        println("    FAIL: silent pcm amplitude too high", max_abs)
        return false
    }
    println("    PASS (silent path, max |pcm| =", max_abs, ")")
    return true
}


// ── F-VOICE-5: NO-LEARNED-DEPENDENCY ─────────────────────────────────────────
fn f_voice_5() {
    println("  F-VOICE-5 (NO-LEARNED-DEPENDENCY) ...")
    let h = make_hidden("loud")
    let r = voice_emit(h, 1)
    if r["all_frozen"] != true {
        println("    FAIL: all_weights_frozen() returned false")
        return false
    }
    if !ip_all_weights_frozen() {
        println("    FAIL: ip_all_weights_frozen() returned false")
        return false
    }
    println("    PASS (no learnable weight, no external pretrained)")
    return true
}


// ════════════════════════════════════════════════════════════════════════════
//  WAV writer (Phase 2 CoreAudio path) — RIFF/WAVE 16-bit signed PCM mono LE
// ════════════════════════════════════════════════════════════════════════════

fn int32_le(v: int) {
    let b0 = v % 256
    let b1 = (v / 256) % 256
    let b2 = (v / 65536) % 256
    let b3 = (v / 16777216) % 256
    return [b0, b1, b2, b3]
}

fn int16_le(v: int) {
    let b0 = v % 256
    let b1 = (v / 256) % 256
    return [b0, b1]
}

fn float_to_int16_le(s: float) {
    let mut v = s
    if v > 1.0  { v = 1.0 }
    if v < -1.0 { v = -1.0 }
    let mut i = int(v * 32767.0)
    if i < 0 { i = 65536 + i }
    return int16_le(i)
}

// Build 44-byte RIFF/WAVE header for mono 16-bit signed PCM @ sample_rate Hz.
fn wav_header(num_samples: int, sample_rate: int) {
    let bits_per_sample = 16
    let num_channels = 1
    let byte_rate = sample_rate * num_channels * bits_per_sample / 8
    let block_align = num_channels * bits_per_sample / 8
    let data_size = num_samples * num_channels * bits_per_sample / 8
    let chunk_size = 36 + data_size

    let mut hdr = []
    // "RIFF"
    hdr.push(82) hdr.push(73) hdr.push(70) hdr.push(70)
    // chunk_size (LE uint32)
    let cs = int32_le(chunk_size)
    let mut i = 0
    while i < 4 { hdr.push(cs[i]) i = i + 1 }
    // "WAVE"
    hdr.push(87) hdr.push(65) hdr.push(86) hdr.push(69)
    // "fmt "
    hdr.push(102) hdr.push(109) hdr.push(116) hdr.push(32)
    // subchunk1_size = 16
    let sc1 = int32_le(16)
    let mut j = 0
    while j < 4 { hdr.push(sc1[j]) j = j + 1 }
    // audio_format = 1 (PCM)
    let af = int16_le(1)
    hdr.push(af[0]) hdr.push(af[1])
    // num_channels
    let nc = int16_le(num_channels)
    hdr.push(nc[0]) hdr.push(nc[1])
    // sample_rate
    let sr = int32_le(sample_rate)
    let mut k = 0
    while k < 4 { hdr.push(sr[k]) k = k + 1 }
    // byte_rate
    let br = int32_le(byte_rate)
    let mut m = 0
    while m < 4 { hdr.push(br[m]) m = m + 1 }
    // block_align
    let ba = int16_le(block_align)
    hdr.push(ba[0]) hdr.push(ba[1])
    // bits_per_sample
    let bp = int16_le(bits_per_sample)
    hdr.push(bp[0]) hdr.push(bp[1])
    // "data"
    hdr.push(100) hdr.push(97) hdr.push(116) hdr.push(97)
    // data_size
    let ds = int32_le(data_size)
    let mut n = 0
    while n < 4 { hdr.push(ds[n]) n = n + 1 }

    return hdr
}

// Write PCM (list[float] in [-1, 1]) as 24kHz mono 16-bit WAV to path.
fn wav_write(pcm, sample_rate: int, path: string) {
    let hdr = wav_header(len(pcm), sample_rate)
    let mut bytes = []
    let mut h = 0
    while h < len(hdr) {
        bytes.push(hdr[h])
        h = h + 1
    }
    let mut s = 0
    while s < len(pcm) {
        let pair = float_to_int16_le(pcm[s])
        bytes.push(pair[0])
        bytes.push(pair[1])
        s = s + 1
    }
    write_bytes(path, bytes)
    return len(bytes)
}


// ── Main ─────────────────────────────────────────────────────────────────────
fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  VOICE Phase 1 F-VOICE-1..5 smoke (formulaic-only, 옵션 (a))")
    println("════════════════════════════════════════════════════════════════")

    let f1 = f_voice_1()
    let f2 = f_voice_2()
    let f3 = f_voice_3()
    let f4 = f_voice_4()
    let f5 = f_voice_5()

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    println("────────────────────────────────────────────────────────────────")
    println("  VERDICT:", n_pass, "/ 5 PASS")
    println("────────────────────────────────────────────────────────────────")
    if n_pass == 5 {
        println("  ✅ F-VOICE-1..5 5/5 PASS — VOICE Phase 1 formulaic-only LANDED")
    }
    if n_pass != 5 {
        println("  ❌ failed:", 5 - n_pass, "falsifier(s)")
    }

    // ── Phase 2 CoreAudio path — emit demo WAV files ─────────────────────────
    println("")
    println("════════════════════════════════════════════════════════════════")
    println("  Phase 2 CoreAudio path: emit demo WAV files")
    println("════════════════════════════════════════════════════════════════")

    let h_loud = make_hidden("loud")
    let r_loud = voice_emit(h_loud, 75)   // 1 second @ 75 Hz frame rate
    let n_loud = wav_write(r_loud["pcm"], vb_sample_rate_hz(), "/tmp/anima_voice_demo_loud.wav")
    println("  wrote /tmp/anima_voice_demo_loud.wav  (", n_loud, "bytes, synth_path =", r_loud["synth_path"], ")")

    let h_silent = make_hidden("silent")
    let r_silent = voice_emit(h_silent, 75)
    let n_silent = wav_write(r_silent["pcm"], vb_sample_rate_hz(), "/tmp/anima_voice_demo_silent.wav")
    println("  wrote /tmp/anima_voice_demo_silent.wav (", n_silent, "bytes, synth_path =", r_silent["synth_path"], ")")
    println("")
    println("  Playback:")
    println("    afplay /tmp/anima_voice_demo_loud.wav   # synth_stub path")
    println("    afplay /tmp/anima_voice_demo_silent.wav # silent_timbre path")
    println("  or: bash tool/anima_voice_play.sh")
}
