use "stdlib/flame/tensor_lib"
use "stdlib/flame/spiking_lib"

// ── engine constants (byte-equal to lego_engine.py) ─────────────────────
pub fn lego_v_th() -> float { return 1.0 }
pub fn lego_v_rest() -> float { return 0.0 }
pub fn lego_v_reset() -> float { return 0.0 }
pub fn lego_tau_m() -> float { return 20.0 }
pub fn lego_tau_stdp() -> float { return 20.0 }
pub fn lego_refrac() -> int { return 2 }
pub fn lego_refr_floor() -> int { return 0 - 1 }
pub fn lego_a_plus() -> float { return 0.012 }
pub fn lego_a_minus() -> float { return 0.0126 }
pub fn lego_w_max() -> float { return 0.5 }

// ── LIF leaky-integrate step (membrane update) ──────────────────────────
// For each unit i that is NOT refractory (refr[i] <= 0):
//   v[i] += (-(v[i] - v_rest) / tau_m) + ext[i] + bias[i]
// `ext` already includes the recurrent W @ s_prev term (caller computes).
// Returns a NEW v tensor (does not mutate input v).
pub fn lego_membrane_step(v: int, ext: int, bias: int, refr: int) -> int {
    let n = t_len(v)
    let out = t_zeros(n)
    let v_rest = lego_v_rest()
    let tau_m = lego_tau_m()
    let mut i = 0
    while i < n {
        let vi = t_get(v, i)
        if t_get(refr, i) <= 0.0 {
            let dv = (0.0 - (vi - v_rest)) / tau_m + t_get(ext, i) + t_get(bias, i)
            t_set(out, i, vi + dv)
        } else {
            t_set(out, i, vi)
        }
        i = i + 1
    }
    return out
}

// ── reset-after-spike ───────────────────────────────────────────────────
// v[i] := v_reset where spike[i] != 0.  Returns a NEW v tensor.
pub fn lego_reset_spiked(v: int, spike: int) -> int {
    let n = t_len(v)
    let out = t_zeros(n)
    let v_reset = lego_v_reset()
    let mut i = 0
    while i < n {
        if t_get(spike, i) != 0.0 {
            t_set(out, i, v_reset)
        } else {
            t_set(out, i, t_get(v, i))
        }
        i = i + 1
    }
    return out
}

// ── STDP eligibility-trace decay + spike kick ───────────────────────────
// tr := tr * exp(-1/tau_stdp) + spike   (one step of the exponential trace)
// Returns a NEW trace tensor.
pub fn lego_trace_step(tr: int, spike: int) -> int {
    let n = t_len(tr)
    let out = t_zeros(n)
    // exp(-1/20) = exp(-0.05) ≈ 0.951229424500714
    let decay = 0.951229424500714
    let mut i = 0
    while i < n {
        t_set(out, i, t_get(tr, i) * decay + t_get(spike, i))
        i = i + 1
    }
    return out
}

// ── spike-rate vector (NEURO.tape mech_neural_coding) ───────────────────
// Mean spike rate over a window for a sub-population [idx_lo, idx_hi).
// raster is a flattened (window × N) tensor row-major; window = number of
// rows, N = stride. Returns a NEW (idx_hi - idx_lo) tensor.
pub fn lego_spike_rate_vec(raster: int, window: int, N: int,
                           idx_lo: int, idx_hi: int) -> int {
    let k = idx_hi - idx_lo
    let out = t_zeros(k)
    let win_f = to_float(window)
    let mut j = 0
    while j < k {
        let unit = idx_lo + j
        let mut acc = 0.0
        let mut w = 0
        while w < window {
            acc = acc + t_get(raster, w * N + unit)
            w = w + 1
        }
        t_set(out, j, acc / win_f)
        j = j + 1
    }
    return out
}

// ── Ψ-C1 carrier (§112 META_FP(Π_½) instance, carrier = spike-corr) ─────
// Ψ-C1 = (1 + cos(r_a, r_g)) / 2 ∈ [0, 1].  cos=0 ⇒ Ψ=½ fixed point.
// Returns the Ψ-C1 scalar.
pub fn lego_psi_c1(r_a: int, r_g: int, len_a: int, len_g: int) -> float {
    let mut dot = 0.0
    let mut na2 = 0.0
    let mut ng2 = 0.0
    let mut i = 0
    while i < len_a {
        let a = t_get(r_a, i)
        dot = dot + a * t_get(r_g, i)
        na2 = na2 + a * a
        i = i + 1
    }
    let mut j = 0
    while j < len_g {
        let g = t_get(r_g, j)
        ng2 = ng2 + g * g
        j = j + 1
    }
    let na = sqrt(na2)
    let ng = sqrt(ng2)
    let mut c = 0.0
    if na < 1e-12 { c = 0.0 } else {
        if ng < 1e-12 { c = 0.0 } else {
            c = dot / (na * ng)
        }
    }
    if c > 1.0 { c = 1.0 }
    if c < (0.0 - 1.0) { c = 0.0 - 1.0 }
    return (1.0 + c) / 2.0
}
