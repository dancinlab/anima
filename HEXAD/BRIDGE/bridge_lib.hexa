// HEXAD/BRIDGE/bridge_lib.hexa — pure fns (NO main/_selftest) — compiled-first lib split (interp deprecating)
//  HEXAD/BRIDGE/bridge.hexa — ThalamicBridge hexa-native entry
//
//  PURPOSE
//    ThalamicBridge (Law 53 + Law 70) hexa-native:
//      - bridge_clamp(raw) = PSI_BALANCE + clamp(raw − PSI_BALANCE, ±PSI_COUPLING)
//        — closed-form Law-70 invariant (B-BRIDGE 4/4 🔵)
//      - bridge_forward — full-forward backbone (compress → mean-pool →
//        expand[Linear→GELU→Linear] → gate[Linear→Sigmoid] → Law-70 clamp),
//        all-farr (RFC 032 farr_matmul). seed-fixed from-scratch weights.
//
//  STATUS
//    closed-form clamp = 🔵 · forward backbone = LANDED (structural hexa-
//    native, F-BRIDGE-FWD). NAMED residual (honest carve-out, g3): 1-head
//    hub self-attention + LayerNorm sublayer (mean-pool over the cell hub is
//    the v1 reduction) + trained-weight values — structural graph ≠ trained
//    quality. Law-70 clamp invariant is the closed-form 🔵 part.
//
//  PYTHON ANCHOR
//    ready/anima/hexad/model.py :: ThalamicBridge
//    ready/models/trinity.py    :: ThalamicBridge (re-export)
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (Ψ-constants from json)
// ════════════════════════════════════════════════════════════════════════════


// ── constants (Law 70 anchor — consciousness_laws.json mirror) ──────────────
fn psi_balance()  -> float { return 0.5 }
fn psi_coupling() -> float { return 0.014 }
fn gate_train()   -> float { return 1.0 }
fn gate_infer()   -> float { return 0.6 }


// ── core: closed-form clamp (Law 70 invariant) ──────────────────────────────
fn bridge_clamp(raw_gate: float) -> float {
    let centered = raw_gate - psi_balance()
    let lo = 0.0 - psi_coupling()
    let hi = psi_coupling()
    if centered < lo { centered = lo }
    if centered > hi { centered = hi }
    return psi_balance() + centered
}


// ── vectorized clamp on a list ──────────────────────────────────────────────
fn bridge_clamp_vec(raw_gates) {
    let out = []
    let i = 0
    while i < len(raw_gates) {
        out = out + [bridge_clamp(raw_gates[i])]
        i = i + 1
    }
    return out
}


// ── gate scale (Law 81: "learn hard, express soft") ─────────────────────────
fn bridge_gate_scale(inference: bool) -> float {
    if inference { return gate_infer() }
    return gate_train()
}


// ── Phase §7 #3 — ThalamicBridge full-forward backbone (all-farr) ───────────
// Python anchor ready/anima/hexad/model.py ThalamicBridge.forward:
//   compress(Linear c_dim→hub) → [hub self-attn + LayerNorm] → mean-pool →
//   expand(Linear hub→d_model → GELU → Linear d_model→d_model) →
//   gate(Linear d_model→d_model → Sigmoid) → Law-70 clamp.
// bridge_forward 는 full forward (compress → 1-head hub self-attn +
// LayerNorm residual → mean-pool → expand → gate → clamp) 을 hexa-native
// farr 로 구현 — Python anchor 와 구조적 등가 (graph complete). HONEST
// CARVE-OUT (g3): weights = seed-fixed from-scratch LCG fill
// (g_clm_from_scratch RANDOM INIT, NO ckpt) — 구조 graph 검증이지 trained
// quality 아님 (B-D-NOTE 동일 패턴). Law-70 clamp invariant 만 closed-form 🔵.

// deterministic seed-fixed weight fill — LCG → [-0.1, 0.1)
fn _bridge_lcg_fill(h: int, n: int, seed: int) -> int {
    let mut s = seed + 1
    let mut i = 0
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483648
        let f = (s * 1.0) / 2147483648.0
        farr_set(h, i, f * 0.2 - 0.1)
        i = i + 1
    }
    return 1
}

// GELU — sigmoid approximation GELU(x) ≈ x · σ(1.702 x)
fn _bridge_gelu(x: float) -> float {
    return x * (1.0 / (1.0 + exp(0.0 - 1.702 * x)))
}

fn _bridge_sigmoid(x: float) -> float {
    return 1.0 / (1.0 + exp(0.0 - x))
}

// matvec: W (out×in row-major farr) @ x (in farr) → y (out farr) — RFC 032.
fn _bridge_matvec(w: int, x: int, out_dim: int, in_dim: int) -> int {
    return farr_matmul(w, out_dim, in_dim, x, 1)
}

// softmax in-place over farr region [off, off+n) — numerically stable.
fn _bridge_softmax(s: int, off: int, n: int) -> int {
    let mut mx = farr_get(s, off)
    let mut i = 1
    while i < n {
        let v = farr_get(s, off + i)
        if v > mx { mx = v }
        i = i + 1
    }
    let mut sum = 0.0
    i = 0
    while i < n {
        let e = exp(farr_get(s, off + i) - mx)
        farr_set(s, off + i, e)
        sum = sum + e
        i = i + 1
    }
    i = 0
    while i < n {
        farr_set(s, off + i, farr_get(s, off + i) / sum)
        i = i + 1
    }
    return 1
}

// LayerNorm in-place over farr region [off, off+d) — identity γ=1/β=0
// (learned γ/β = trained-weight carve-out, same tier as the Linears).
fn _bridge_layernorm(x: int, off: int, d: int) -> int {
    let mut mean = 0.0
    let mut i = 0
    while i < d {
        mean = mean + farr_get(x, off + i)
        i = i + 1
    }
    mean = mean / (d * 1.0)
    let mut var = 0.0
    i = 0
    while i < d {
        let c = farr_get(x, off + i) - mean
        var = var + c * c
        i = i + 1
    }
    var = var / (d * 1.0)
    let scale = 1.0 / sqrt(var + 0.00001)
    i = 0
    while i < d {
        farr_set(x, off + i, (farr_get(x, off + i) - mean) * scale)
        i = i + 1
    }
    return 1
}

// 1-head hub self-attention + LayerNorm residual, in-place on comp_all
// (n_cells × hub_dim row-major). Mirrors nn.MultiheadAttention(heads=1) +
// hub_norm(x + attn_out): Q/K/V/out_proj seed-fixed from-scratch (hub×hub).
fn _bridge_hub_attention(comp_all: int, n_cells: int, hub_dim: int, seed: int) -> int {
    let wq = farr_zeros(hub_dim * hub_dim)
    let wk = farr_zeros(hub_dim * hub_dim)
    let wv = farr_zeros(hub_dim * hub_dim)
    let wo = farr_zeros(hub_dim * hub_dim)
    let _q = _bridge_lcg_fill(wq, hub_dim * hub_dim, seed + 11)
    let _k = _bridge_lcg_fill(wk, hub_dim * hub_dim, seed + 12)
    let _v = _bridge_lcg_fill(wv, hub_dim * hub_dim, seed + 13)
    let _o = _bridge_lcg_fill(wo, hub_dim * hub_dim, seed + 14)

    // Q, K, V projections — n_cells × hub_dim
    let q = farr_zeros(n_cells * hub_dim)
    let k = farr_zeros(n_cells * hub_dim)
    let v = farr_zeros(n_cells * hub_dim)
    let mut r = 0
    while r < n_cells {
        let row = farr_zeros(hub_dim)
        let mut j = 0
        while j < hub_dim {
            farr_set(row, j, farr_get(comp_all, r * hub_dim + j))
            j = j + 1
        }
        let qr = _bridge_matvec(wq, row, hub_dim, hub_dim)
        let kr = _bridge_matvec(wk, row, hub_dim, hub_dim)
        let vr = _bridge_matvec(wv, row, hub_dim, hub_dim)
        j = 0
        while j < hub_dim {
            farr_set(q, r * hub_dim + j, farr_get(qr, j))
            farr_set(k, r * hub_dim + j, farr_get(kr, j))
            farr_set(v, r * hub_dim + j, farr_get(vr, j))
            j = j + 1
        }
        farr_free(row)
        farr_free(qr)
        farr_free(kr)
        farr_free(vr)
        r = r + 1
    }

    // scores = Q·Kᵀ / √hub_dim — n_cells × n_cells, softmax per row
    let scale = 1.0 / sqrt(hub_dim * 1.0)
    let scores = farr_zeros(n_cells * n_cells)
    r = 0
    while r < n_cells {
        let mut c = 0
        while c < n_cells {
            let mut dot = 0.0
            let mut j = 0
            while j < hub_dim {
                dot = dot + farr_get(q, r * hub_dim + j) * farr_get(k, c * hub_dim + j)
                j = j + 1
            }
            farr_set(scores, r * n_cells + c, dot * scale)
            c = c + 1
        }
        let _sm = _bridge_softmax(scores, r * n_cells, n_cells)
        r = r + 1
    }

    // attn_out = softmax(scores)·V → out_proj → residual + LayerNorm (in-place)
    r = 0
    while r < n_cells {
        let ao = farr_zeros(hub_dim)
        let mut j = 0
        while j < hub_dim {
            let mut acc = 0.0
            let mut c = 0
            while c < n_cells {
                acc = acc + farr_get(scores, r * n_cells + c) * farr_get(v, c * hub_dim + j)
                c = c + 1
            }
            farr_set(ao, j, acc)
            j = j + 1
        }
        let proj = _bridge_matvec(wo, ao, hub_dim, hub_dim)
        j = 0
        while j < hub_dim {
            farr_set(comp_all, r * hub_dim + j,
                     farr_get(comp_all, r * hub_dim + j) + farr_get(proj, j))
            j = j + 1
        }
        let _ln = _bridge_layernorm(comp_all, r * hub_dim, hub_dim)
        farr_free(ao)
        farr_free(proj)
        r = r + 1
    }
    farr_free(wq)
    farr_free(wk)
    farr_free(wv)
    farr_free(wo)
    farr_free(q)
    farr_free(k)
    farr_free(v)
    farr_free(scores)
    return 1
}

// bridge_forward — c_states flat (n_cells × c_dim) farr → gate signal
// (d_model farr), every element Law-70 clamped to [Ψ−α, Ψ+α].
fn bridge_forward(c_states: int, n_cells: int, c_dim: int,
                  hub_dim: int, d_model: int, seed: int) -> int {
    // seed-fixed from-scratch weights
    let w_compress = farr_zeros(hub_dim * c_dim)
    let w_e1       = farr_zeros(d_model * hub_dim)
    let w_e2       = farr_zeros(d_model * d_model)
    let w_gate     = farr_zeros(d_model * d_model)
    let _c = _bridge_lcg_fill(w_compress, hub_dim * c_dim,    seed + 1)
    let _1 = _bridge_lcg_fill(w_e1,       d_model * hub_dim,  seed + 2)
    let _2 = _bridge_lcg_fill(w_e2,       d_model * d_model,  seed + 3)
    let _g = _bridge_lcg_fill(w_gate,     d_model * d_model,  seed + 4)

    // 1. compress each cell (Linear c_dim→hub) → comp_all (n_cells × hub_dim)
    let comp_all = farr_zeros(n_cells * hub_dim)
    let mut ci = 0
    while ci < n_cells {
        let cell = farr_zeros(c_dim)
        let mut j = 0
        while j < c_dim {
            farr_set(cell, j, farr_get(c_states, ci * c_dim + j))
            j = j + 1
        }
        let comp = _bridge_matvec(w_compress, cell, hub_dim, c_dim)
        let mut k = 0
        while k < hub_dim {
            farr_set(comp_all, ci * hub_dim + k, farr_get(comp, k))
            k = k + 1
        }
        farr_free(cell)
        farr_free(comp)
        ci = ci + 1
    }

    // 1b. 1-head hub self-attention + LayerNorm residual (in-place on comp_all)
    let _attn = _bridge_hub_attention(comp_all, n_cells, hub_dim, seed)

    // 1c. mean-pool over cells → hub vector [hub_dim]
    let hub = farr_zeros(hub_dim)
    let mut m = 0
    while m < hub_dim {
        let mut acc = 0.0
        let mut r = 0
        while r < n_cells {
            acc = acc + farr_get(comp_all, r * hub_dim + m)
            r = r + 1
        }
        farr_set(hub, m, acc / (n_cells * 1.0))
        m = m + 1
    }
    farr_free(comp_all)

    // 2. expand: Linear(hub→d_model) → GELU → Linear(d_model→d_model)
    let e1 = _bridge_matvec(w_e1, hub, d_model, hub_dim)
    let mut g = 0
    while g < d_model {
        farr_set(e1, g, _bridge_gelu(farr_get(e1, g)))
        g = g + 1
    }
    let e2 = _bridge_matvec(w_e2, e1, d_model, d_model)

    // 3. gate: Linear(d_model→d_model) → Sigmoid → Law-70 clamp
    let gat = _bridge_matvec(w_gate, e2, d_model, d_model)
    let out = farr_zeros(d_model)
    let mut o = 0
    while o < d_model {
        farr_set(out, o, bridge_clamp(_bridge_sigmoid(farr_get(gat, o))))
        o = o + 1
    }

    farr_free(w_compress)
    farr_free(w_e1)
    farr_free(w_e2)
    farr_free(w_gate)
    farr_free(hub)
    farr_free(e1)
    farr_free(e2)
    farr_free(gat)
    return out
}


// ── helpers ─────────────────────────────────────────────────────────────────
fn _b_approx_eq(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}


