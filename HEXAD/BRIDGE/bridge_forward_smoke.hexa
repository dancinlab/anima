// HEXAD/BRIDGE/bridge_forward_smoke.hexa — PLAN.md §7 #3 falsifier F-BRIDGE-FWD.
//
//   bridge_forward = ThalamicBridge full-forward backbone, hexa-native all-farr
//   (compress → mean-pool → expand[Linear→GELU→Linear] → gate[Linear→Sigmoid]
//   → Law-70 clamp). Closes bridge_lib.hexa:8 TODO[pytorch] for the forward
//   GRAPH (structural). Python anchor ready/anima/hexad/model.py ThalamicBridge.
//
//   F-BRIDGE-FWD (4 sub-checks):
//     FWD-1 BUILD       — native binary builds + bridge_lib import OK.
//     FWD-2 SHAPE       — bridge_forward output farr length == d_model.
//     FWD-3 LAW70-CLAMP — every output element ∈ [Ψ−α, Ψ+α] = [0.486, 0.514]
//                         (Law-70 invariant preserved end-to-end through the
//                         whole forward, not just bridge_clamp in isolation).
//     FWD-4 DETERMINISM — same seed/input → byte-identical output.
//
//   HONEST CARVE-OUT (AGENTS.tape g3 — no over-claim): the full forward
//   GRAPH (compress → 1-head hub self-attn + LayerNorm residual → mean-pool
//   → expand → gate → Law-70 clamp) is structurally complete vs the Python
//   anchor; weights = seed-fixed from-scratch LCG fill (g_clm_from_scratch
//   RANDOM INIT, NO ckpt) — verifies the GRAPH, NOT trained quality (only
//   trained-weight carve-out remains, same tier as B-D). Law-70 clamp
//   invariant is the closed-form 🔵 part.
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/BRIDGE/bridge_lib.hexa"

fn _selftest() {
    // ── F-BRIDGE-FWD-1 BUILD (binary built + bridge_lib import resolved) ──
    let build_ok = psi_balance() == 0.5
    println("  F-BRIDGE-FWD-1 BUILD          : " + to_string(build_ok))

    // test input: 4-cell pool, c_dim=16 → hub_dim=8 → d_model=32
    let n_cells = 4
    let c_dim   = 16
    let hub_dim = 8
    let d_model = 32
    let cs = farr_zeros(n_cells * c_dim)
    let mut i = 0
    while i < n_cells * c_dim {
        farr_set(cs, i, (i * 1.0) / 100.0 - 0.3)
        i = i + 1
    }

    let out = bridge_forward(cs, n_cells, c_dim, hub_dim, d_model, 42)

    // ── F-BRIDGE-FWD-2 SHAPE ──
    let shape_ok = farr_len(out) == d_model
    println("  F-BRIDGE-FWD-2 SHAPE         : " + to_string(shape_ok) + "  (len=" + to_string(farr_len(out)) + " == d_model=" + to_string(d_model) + ")")

    // ── F-BRIDGE-FWD-3 LAW70-CLAMP (every elem ∈ [Ψ−α, Ψ+α]) ──
    let lo = psi_balance() - psi_coupling()
    let hi = psi_balance() + psi_coupling()
    let mut clamp_ok = true
    let mut o = 0
    while o < d_model {
        let v = farr_get(out, o)
        if v < lo { clamp_ok = false }
        if v > hi { clamp_ok = false }
        o = o + 1
    }
    println("  F-BRIDGE-FWD-3 LAW70-CLAMP   : " + to_string(clamp_ok) + "  (all ∈ [" + to_string(lo) + ", " + to_string(hi) + "])")

    // ── F-BRIDGE-FWD-4 DETERMINISM ──
    let out2 = bridge_forward(cs, n_cells, c_dim, hub_dim, d_model, 42)
    let mut det_ok = true
    let mut p = 0
    while p < d_model {
        if farr_get(out2, p) != farr_get(out, p) { det_ok = false }
        p = p + 1
    }
    println("  F-BRIDGE-FWD-4 DETERMINISM   : " + to_string(det_ok))

    farr_free(cs)
    farr_free(out)
    farr_free(out2)

    let all_ok = build_ok && shape_ok && clamp_ok && det_ok
    println("  F-BRIDGE-FWD AGGREGATE 4/4   : " + to_string(all_ok))
    println("=== HEXAD/BRIDGE bridge_forward_smoke selftest: " + to_string(all_ok) + " ===")
    println("    honest: full forward graph complete (compress→attn+LN→pool→expand→gate→clamp); seed-fixed from-scratch weights — structural ≠ trained quality")
}

fn main() {
    println("HEXAD/BRIDGE — full-forward backbone falsifier (F-BRIDGE-FWD)")
    _selftest()
}
