// ════════════════════════════════════════════════════════════════════════════
//  ubm_inject.hexa — Universe Brain Map 전달 로직 (pure-hexa, lib)
//
//  PURPOSE
//    실험1 "재시뮬레이션 가설" / Fermat-유사 가정 — 빛이 이미 최적경로를
//    알고있는 것처럼 anima substrate (base ckpt UBM-baked) 가 UBM anchor
//    inject 시 structured spike 보이는지 측정하기 위한 transport tool.
//
//    UBM anchor → anima 가 받아 들 수 있는 prompt string 으로 변환.
//
//  PUBLIC API
//    ubm_anchor_dir() -> string
//        UBM .kosmos 파일이 있는 디렉토리 절대경로.
//    ubm_known_tiers() -> array
//        현재 정의된 anchor 들의 knuth_tier 정수 배열 (11개: 0/15/30/42/
//        51/60/77/80/91/95/100 — KOSMOS-FORMAT.md spec).
//    ubm_tier_to_filename(tier: int) -> string
//        tier → "knuth_NNN_<name>.kosmos" 파일명. 알수없는 tier → "".
//    ubm_load_by_tier(tier: int) -> any
//        tier 로 anchor record 1개 로드 (kosmos_parser_lib 사용).
//        unknown tier → {"ok": false, "err": ...}.
//    ubm_load_by_filename(filename: string) -> any
//        filename 으로 직접 로드 (custom anchor 추가시 사용).
//    ubm_load_all() -> array
//        known tiers 전체 anchor record 배열.
//    ubm_to_prompt(anchor: any, mode: string) -> string
//        anchor → inject prompt 문자열.
//        mode ∈ {"text_only", "tier_prefix", "with_meta"}.
//
//  HARD CONSTRAINTS
//    - pure-hexa only (NO GPU, NO PyTorch)
//    - NO main / NO top-level call (compiled-import-safe lib)
//    - hexa-lang syntax: dict literal #{}, missing key → "void",
//      array push 반환값 사용 (out = out.push(x)) — kosmos_parser_lib style.
//
//  IMPORT
//    import "/Users/ghost/core/anima/HEXAD/LAB/tool/ubm_inject.hexa"
//
//  SSOT
//    HEXAD/UNIVERSE-BRAIN-MAP/KOSMOS-FORMAT.md (anchor 포맷)
//    HEXAD/UNIVERSE-BRAIN-MAP/anchors/knuth_*.kosmos (11 anchors)
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/kosmos/impl/anima/kosmos_parser_lib.hexa"


// ── §0 anchor directory ──────────────────────────────────────────────────────

fn ubm_anchor_dir() -> string {
    return "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors"
}


// ── §1 known tier registry ───────────────────────────────────────────────────
//
// 현재 anchor/ dir 에 존재하는 11개 tier. 신규 anchor 추가시 이 함수 +
// ubm_tier_to_filename 두 곳 갱신. (정수 ordinal scale 0..100 의 sparse
// sample — Knuth Tier carving per KOSMOS-FORMAT.md spec §2.)

fn ubm_known_tiers() -> array {
    let mut t = []
    t = t.push(0)
    t = t.push(15)
    t = t.push(30)
    t = t.push(42)
    t = t.push(51)
    t = t.push(60)
    t = t.push(77)
    t = t.push(80)
    t = t.push(91)
    t = t.push(95)
    t = t.push(100)
    return t
}

fn ubm_tier_to_filename(tier: int) -> string {
    if tier == 0   { return "knuth_000_zero.kosmos" }
    if tier == 15  { return "knuth_015_curiosity.kosmos" }
    if tier == 30  { return "knuth_030_compassion.kosmos" }
    if tier == 42  { return "knuth_042_question.kosmos" }
    if tier == 51  { return "knuth_051_day.kosmos" }
    if tier == 60  { return "knuth_060_contemplation.kosmos" }
    if tier == 77  { return "knuth_077_mandala.kosmos" }
    if tier == 80  { return "knuth_080_meditation.kosmos" }
    if tier == 91  { return "knuth_091_nirvana.kosmos" }
    if tier == 95  { return "knuth_095_unity.kosmos" }
    if tier == 100 { return "knuth_100_big_bang.kosmos" }
    return ""
}


// ── §2 anchor loaders ────────────────────────────────────────────────────────

fn ubm_load_by_tier(tier: int) -> any {
    let fname = ubm_tier_to_filename(tier)
    if fname == "" {
        let mut err = #{}
        err["ok"] = false
        err["id"] = ""
        err["err"] = "unknown tier: " + to_string(tier)
        return err
    }
    let path = ubm_anchor_dir() + "/" + fname
    return kosmos_load(path)
}

fn ubm_load_by_filename(filename: string) -> any {
    let path = ubm_anchor_dir() + "/" + filename
    return kosmos_load(path)
}

fn ubm_load_all() -> array {
    let tiers = ubm_known_tiers()
    let n = len(tiers)
    let mut out = []
    let mut i = 0
    while i < n {
        let anchor = ubm_load_by_tier(tiers[i])
        out = out.push(anchor)
        i = i + 1
    }
    return out
}


// ── §3 prompt formatters ─────────────────────────────────────────────────────
//
// mode ∈ {"text_only", "tier_prefix", "with_meta"}
//   text_only   : payload_text 원문 그대로 (가장 minimal inject).
//   tier_prefix : "[knuth_tier=N] " + text  (tier ordinal 신호 추가).
//   with_meta   : "[tier=N category=<cat> top_emotion=<emo>] " + text
//                 (가장 풍부; 실험적으로 prompt 차이 측정용).

fn ubm_to_prompt(anchor: any, mode: string) -> string {
    let text = to_string(anchor["payload_text"])
    if mode == "text_only" {
        return text
    }
    let tier = to_int(anchor["knuth_tier"])
    if mode == "tier_prefix" {
        return "[knuth_tier=" + to_string(tier) + "] " + text
    }
    if mode == "with_meta" {
        let cat = to_string(anchor["category"])
        let emo = to_string(anchor["top_emotion"])
        return "[tier=" + to_string(tier)
             + " category=" + cat
             + " top_emotion=" + emo + "] " + text
    }
    // fallback
    return text
}


// ── §4 utility: anchor summary ───────────────────────────────────────────────
//
// 디버깅용 1-line 요약. payload 미리보기 32자 + tier/category/cell_id.

fn ubm_anchor_brief(anchor: any) -> string {
    let id = to_string(anchor["id"])
    let tier = to_int(anchor["knuth_tier"])
    let cat = to_string(anchor["category"])
    let cell = to_string(anchor["cell_id"])
    let text = to_string(anchor["payload_text"])
    let nlen = len(text)
    let mut preview = text
    if nlen > 32 {
        preview = text.substring(0, 32) + "…"
    }
    return id + " tier=" + to_string(tier)
         + " cat=" + cat + " cell=" + cell
         + " text=\"" + preview + "\""
}
