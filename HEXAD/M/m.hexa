// HEXAD/M/m.hexa — entrypoint (compiled-first): import m_lib + selftest + main
// @version v1.0.0 🔵 SUPPORTED-FORMAL — F-M 5/5 + B-M 3/3 · see HEXAD/VERSIONS.md
import "/Users/ghost/core/anima/HEXAD/M/m_lib.hexa"

// ── helpers for selftest ────────────────────────────────────────────────────
fn _m_approx_eq(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}


// ── selftest: B-M-{1,2,3} hexa-native witnesses ─────────────────────────────
fn _selftest() {
    // B-M-1 STORE-NOOP-STRUCTURAL — return 0 (sentinel) ∀ inputs
    let r1 = m_store([1.0, 2.0], [3.0, 4.0])
    let r2 = m_store([], [])
    let noop_ok = (r1 == 0) && (r2 == 0)
    print("  B-M-1 STORE-NOOP-STRUCTURAL  : " + to_string(noop_ok))

    // B-M-2 RETRIEVE-DETERMINISTIC — same inputs → same top-k indices ∀ runs
    // 3 cells in 2-D; query == cell-0, expect indices start with 0.
    let states = [1.0, 0.0,   0.0, 1.0,   1.0, 1.0]
    let query  = [1.0, 0.0]
    let idx_a = m_retrieve_topk(query, states, 3, 2, 2)
    let idx_b = m_retrieve_topk(query, states, 3, 2, 2)
    let det_ok = (idx_a[0] == 0) && (idx_b[0] == 0)
                  && (idx_a[1] == idx_b[1]) && (idx_a[0] == idx_b[0])
    print("  B-M-2 RETRIEVE-DETERMINISTIC : " + to_string(det_ok))

    // B-M-3 NULL-CONSTANT — m_retrieve_null(dim) → zeros(dim)
    let z = m_retrieve_null(4)
    let zero_ok = (len(z) == 4)
                   && _m_approx_eq(z[0], 0.0, 1e-9)
                   && _m_approx_eq(z[1], 0.0, 1e-9)
                   && _m_approx_eq(z[2], 0.0, 1e-9)
                   && _m_approx_eq(z[3], 0.0, 1e-9)
    print("  B-M-3 NULL-CONSTANT          : " + to_string(zero_ok))

    let all_ok = noop_ok && det_ok && zero_ok
    print("=== HEXAD/M selftest: " + to_string(all_ok) + " ===")
}


fn main() {
    print("HEXAD/M — 기억 (memory) hexa-native entry")
    print("store = Hebbian no-op · retrieve = cosine top-k · null = zeros")
    print("B-M 3/3 🔵 SUPPORTED-FORMAL anchor (sympy closed-form)")
    _selftest()
}
