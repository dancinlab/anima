// HEXAD/D/corpus_loader_lib.hexa — pure fns (NO main/_selftest) — real-corpus
// byte-level loader. §7 #1 실-규모 언어 fire 의 선결조건.
//
//   d_train5 (FULL n_layer ConsciousDecoderV2-equiv 트레이너) 의 입력을
//   synthetic separable byte-toy → **실 corpus** 로 교체하는 로더. byte-level
//   tokenize (vocab 256, lossless) — Python torch / 외부 tokenizer 의존 0.
//   바이트 추출은 `od` shell-out (RFC 001 exec) — hexa string-byte API 우회.
//
//   API
//     corpus_load_bytes(path)      -> [int]   byte tokens 0..255 (lossless)
//     corpus_n_windows(toks, T)    -> int     # of (T-input + 1-target) windows
//     corpus_window(toks, idx, T)  -> [int]   T+1 tokens [idx .. idx+T]
//
//   §8 / g_blue_closed_mandate — corpus↔trainer 연결고리 수학 검증:
//     lossless    : len(corpus_load_bytes) == file_size  (exact, closed)
//     byte-alphabet: ∀ token ∈ [0, 256)  (Shannon 8-bit alphabet bound, closed)
// ════════════════════════════════════════════════════════════════════════════

// byte-level token load — `od -An -v -tu1` = unsigned-decimal bytes, no
// address column, no dedup (-v) → exact lossless byte stream.
fn corpus_load_bytes(path: string) -> [int] {
    let raw = exec("od -An -v -tu1 " + path + " | tr -s ' \\n' ' '")
    let parts = raw.split(" ")
    let mut toks = []
    let mut i = 0
    while i < len(parts) {
        if len(parts[i]) > 0 {
            toks.push(parse_int(parts[i]))
        }
        i = i + 1
    }
    return toks
}

// number of length-T training windows (each = T input tokens + 1 next-token
// target ⟹ a window spans T+1 tokens; n-T windows over an n-token stream).
fn corpus_n_windows(toks, t_len: int) -> int {
    let n = len(toks)
    if n < t_len + 1 { return 0 }
    return n - t_len
}

// extract the (T+1)-token window at idx: [idx .. idx+T] inclusive.
fn corpus_window(toks, idx: int, t_len: int) -> [int] {
    let mut w = []
    let mut i = 0
    while i <= t_len {
        w.push(toks[idx + i])
        i = i + 1
    }
    return w
}
