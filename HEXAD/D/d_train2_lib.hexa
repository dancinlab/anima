// HEXAD/D/d_train2_lib.hexa — pure fns (NO main / NO _selftest) — compiled-first lib-split
// ════════════════════════════════════════════════════════════════════════════
//  PHASE 5 (1) — real-d_model K-class LM-HEAD from-scratch trainer.
//
//  SCALE-UP of the verified Phase 5 mechanism (d_train_lib.hexa): the toy
//  was a 2-class 4-weight head whose grad was demonstrated via the RFC 034
//  scalar Wengert tape. That scalar tape is O(ops²) and structurally
//  infeasible at d_model=768 · 12L (PLAN.md 2026-05-16 design analysis).
//
//  KEY HONEST INSIGHT: for a LINEAR LM-head `logits[k] = Σ_j W[k][j]·x[j]`,
//  the CE gradient is CLOSED with NO tape:
//      dL/dW[k][j] = (softmax(logits) − onehot(t))[k] · x[j]
//  i.e. an OUTER PRODUCT of the B-D-4 closed logit-Jacobian (softmax−onehot,
//  already 🔵 in blue_falsifier — reused, NOT re-proven) with the input x.
//  This generalises the verified toy to ARBITRARY (d_model, vocab) with O(V·d)
//  cost per step — the genuine real-d_model scale-up. The RFC 034 scalar tape
//  stays in d_train_lib.hexa as the GRAD-EXACT anchor (untouched here).
//
//  Reuses d_train_lib.hexa numerics (dt_exp range-reduced, dt_ln atanh,
//  dt_lcg_next) — pure lib import, DRY, no re-derivation.
//
//  FALSIFIER  F-D-PORT-2 (same as Phase 5, real-d_model scope):
//    N AdamW steps ⟹ gn2 = Σ‖softmax−onehot‖² collapses + argmax acc.
//    HONEST TIER: **EMPIRICAL** (B-D-NOTE — SGD convergence OUTCOME, NOT
//    closed-form, NOT 🔵). Trainability PROPERTY = B-D-4 🔵 (separate, blue
//    falsifier). The closed grad CORRECTNESS is gradcheckable (F-D-PORT-2b
//    finite-difference vs analytic) — that verifies the property impl, it
//    does NOT upgrade the OUTCOME tier.
//
//  COMPLIANCE  raw#11 snake_case · raw#9/10 honest tier (empirical ≠ 🔵) ·
//              g_clm_from_scratch (init = RANDOM seed-fixed, base_ckpt = NONE)
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/D/d_train_lib.hexa"


// ── K-class softmax (numerically stable: max-shift + range-reduced dt_exp) ──
fn dt2_softmax(logits) {
    let n = len(logits)
    let mut m = logits[0]
    let mut i = 1
    while i < n {
        if logits[i] > m { m = logits[i] }
        i = i + 1
    }
    let mut es = []
    let mut s = 0.0
    i = 0
    while i < n {
        let e = dt_exp(logits[i] - m)
        es.push(e)
        s = s + e
        i = i + 1
    }
    let mut p = []
    i = 0
    while i < n {
        p.push(es[i] / s)
        i = i + 1
    }
    return p
}


// ── linear LM-head forward : W flat row-major [V·d], x [d] → logits [V] ─────
//   logits[k] = Σ_j W[k*d + j] · x[j]
fn dt2_forward(W, x, d: int, V: int) {
    let mut logits = []
    let mut k = 0
    while k < V {
        let base = k * d
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + W[base + j] * x[j]
            j = j + 1
        }
        logits.push(acc)
        k = k + 1
    }
    return logits
}


// ── B-D-4 CLOSED gradient (NO tape) : dL/dW[k*d+j] = (p−onehot)[k]·x[j] ─────
//   p = softmax(forward(W,x)) ; the (softmax − onehot) factor is the B-D-4
//   closed CE logit-Jacobian (🔵 in blue_falsifier — reused, not re-proven).
//   Outer product with x ⟹ exact dW, O(V·d), no autograd graph.
fn dt2_bd4_grad(W, x, t: int, d: int, V: int) {
    let logits = dt2_forward(W, x, d, V)
    let p = dt2_softmax(logits)
    let mut gW = []
    let mut k = 0
    while k < V {
        let dk = p[k] - (if k == t { 1.0 } else { 0.0 })   // B-D-4 closed
        let mut j = 0
        while j < d {
            gW.push(dk * x[j])
            j = j + 1
        }
        k = k + 1
    }
    return gW
}


// ── robust trainability signal : gn2 = ‖softmax − onehot‖²  (→0 ⟺ learned)
fn dt2_gn2(W, x, t: int, d: int, V: int) -> float {
    let p = dt2_softmax(dt2_forward(W, x, d, V))
    let mut acc = 0.0
    let mut k = 0
    while k < V {
        let dk = p[k] - (if k == t { 1.0 } else { 0.0 })
        acc = acc + dk * dk
        k = k + 1
    }
    return acc
}


// ── CE value (for F-D-PORT-2b finite-difference gradcheck only) ────────────
fn dt2_ce(W, x, t: int, d: int, V: int) -> float {
    let p = dt2_softmax(dt2_forward(W, x, d, V))
    let pt = p[t]
    let ptc = if pt < 0.000001 { 0.000001 } else { pt }
    return 0.0 - dt_ln(ptc)
}


// ── argmax prediction (robust: softmax = range-reduced exp ratio) ──────────
fn dt2_predict(W, x, d: int, V: int) -> int {
    let logits = dt2_forward(W, x, d, V)
    let mut bi = 0
    let mut bv = logits[0]
    let mut k = 1
    while k < V {
        if logits[k] > bv { bv = logits[k]; bi = k }
        k = k + 1
    }
    return bi
}


// ── AdamW (decoupled weight decay) — one step over flat param array ────────
//   returns [W', m', v'] ; step_t = 1-based for bias correction.
//   update: m=β1 m+(1−β1)g ; v=β2 v+(1−β2)g² ;
//           mhat=m/(1−β1^t) ; vhat=v/(1−β2^t) ;
//           W = W − lr·wd·W − lr·mhat/(√vhat+eps)   (decoupled wd)
fn dt2_adamw_step(W, m, v, gW, lr: float, b1: float, b2: float,
                  eps: float, wd: float, step_t: int) {
    let n = len(W)
    // bias-correction denominators (β^t via repeated mul — step_t small)
    let mut b1t = 1.0
    let mut b2t = 1.0
    let mut e = 0
    while e < step_t {
        b1t = b1t * b1
        b2t = b2t * b2
        e = e + 1
    }
    let c1 = 1.0 - b1t
    let c2 = 1.0 - b2t
    let mut Wn = []
    let mut mn = []
    let mut vn = []
    let mut i = 0
    while i < n {
        let g = gW[i]
        let mi = b1 * m[i] + (1.0 - b1) * g
        let vi = b2 * v[i] + (1.0 - b2) * g * g
        let mhat = mi / c1
        let vhat = vi / c2
        let denom = dt_sqrt(vhat) + eps
        let wi = W[i] - lr * wd * W[i] - lr * mhat / denom
        mn.push(mi)
        vn.push(vi)
        Wn.push(wi)
        i = i + 1
    }
    return [Wn, mn, vn]
}

// √ via Newton (vhat ≥ 0; 8 iters from x seed — adequate for Adam denom)
fn dt_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = if x > 1.0 { x } else { 1.0 }
    let mut i = 0
    while i < 24 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}


// ── dataset-epoch reducers (top-level; compiled codegen rejects nested
//    FnDecl ⟹ explicit XS/YS/d/V params, no closure) ───────────────────────
//   XS : list of x-vectors (each len d) · YS : list of int targets ∈ [0,V)
fn dt2_epoch_gn2(W, XS, YS, d: int, V: int) -> float {
    let mut acc = 0.0
    let mut s = 0
    while s < len(YS) {
        acc = acc + dt2_gn2(W, XS[s], YS[s], d, V)
        s = s + 1
    }
    return acc
}
fn dt2_epoch_acc(W, XS, YS, d: int, V: int) -> int {
    let mut c = 0
    let mut s = 0
    while s < len(YS) {
        if dt2_predict(W, XS[s], d, V) == YS[s] { c = c + 1 }
        s = s + 1
    }
    return c
}
// summed B-D-4 closed grad over the epoch (full-batch GD step driver)
fn dt2_epoch_grad(W, XS, YS, d: int, V: int) {
    let n = len(W)
    let mut g = []
    let mut i = 0
    while i < n { g.push(0.0); i = i + 1 }
    let mut s = 0
    while s < len(YS) {
        let gs = dt2_bd4_grad(W, XS[s], YS[s], d, V)
        i = 0
        while i < n { g[i] = g[i] + gs[i]; i = i + 1 }
        s = s + 1
    }
    return g
}


// ── from-scratch RANDOM seed-fixed init (g_clm_from_scratch, base_ckpt=NONE)
//   LCG (d_train_lib dt_lcg_next) → W[V·d] in ≈[-scale/2, scale/2].
fn dt2_init_W(seed: int, d: int, V: int, scale: float) {
    let n = V * d
    let mut W = []
    let mut s = seed
    let mut i = 0
    while i < n {
        s = dt_lcg_next(s)
        W.push(((to_float(s % 1000) / 1000.0) - 0.5) * scale)
        i = i + 1
    }
    return W
}
fn dt2_zeros(n: int) {
    let mut z = []
    let mut i = 0
    while i < n { z.push(0.0); i = i + 1 }
    return z
}
