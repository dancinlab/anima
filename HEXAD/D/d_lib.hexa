// ── canonical invariants ────────────────────────────────────────────────────
fn d_vocab()             -> int { return 256 }      // byte-level
fn d_n_layer_default()   -> int { return 24 }       // Phase 1A.1 ckpt
fn d_n_layer_base()      -> int { return 12 }       // .clm v1 P2 base
fn d_d_model_default()   -> int { return 768 }
fn d_n_head_default()    -> int { return 8 }
fn d_ffn_dim_default()   -> int { return 3072 }
fn d_block_size_default() -> int { return 256 }


// ── API surface (cross-link skeleton; real forward = anima_chat.hexa) ───────
fn d_arch_components() {
    return ["RMSNorm", "RoPE", "SwiGLU", "MoE-optional"]
}

// ── Phase 1 — D inference wrapper CONTRACT (PLAN.md Phase 1) ────────────────
// d_forward delegates to the VERIFIED 24L forward in anima_chat.hexa:
//   chat_forward_one_token(chat, token_id) -> logits   (Section 9c all-farr
//   24-layer GQA block + tied lm_head; Section 9d adds KV cache + per-step
//   RoPE rotation). 21/21 byte-parity PASS on real Phase 1A.1 24L ckpt
//   (570 MB BF16, sha e5f7555…) — anima_chat.hexa F-D1-LOAD/MULTITOKEN/
//   V58PARITY/V58MULTI 21/21 (memory anchor, PR-tier evidence).
//
// Contract (the wrapper SIGNATURE Phase 1 commits to):
//   d_forward(chat, token_id)          -> logits        (single-token)
//   d_forward_multi(chat, prompt_ids)  -> logits_seq    (KV-cache decode)
// where `chat` carries the loaded ckpt handle (anima_chat.hexa AnimaChat
// record). vocab = 256 byte-level for HEXAD-D scope (anima_chat uses 32000
// SP — d_forward_contract() documents the byte vs SP boundary).
fn d_forward_contract() {
    return #{
        "single":   "chat_forward_one_token(chat, token_id) -> logits",
        "multi":    "chat_kv_cache_init + per-step chat_forward_one_token (Section 9d)",
        "verified": "anima_chat.hexa 21/21 byte-parity (real 24L 570MB ckpt)",
        "vocab":    "HEXAD-D byte=256 · anima_chat SP=32000 (boundary doc)",
        "functional_wire": "anima_chat.hexa lib-split (chat_lib.hexa, NO main) → import — anima-side sub-task, RFC-independent (compiled-first lib-split pattern, PR #89)"
    }
}

// F-D-PORT-1 (사전등록): 24L byte-parity 회귀 = anima_chat.hexa 21/21 anchor
//   CARRY (full re-run = 별도 heavy cycle: 570MB ckpt + compiled 24L build,
//   memory project_anima_chat_hexa_24l_v58_parity). 본 wrapper 는 CONTRACT
//   + 사전등록; functional delegation 은 anima_chat lib-split 후 import.
fn d_fdport1_anchor() -> string {
    return "anima_chat.hexa F-D1-{LOAD,MULTITOKEN,V58PARITY,V58MULTI} 21/21 PASS (real 24L ckpt) — PLAN Phase 1 byte-parity anchor"
}

// TODO[pytorch] CE loss + AdamW training — Phase 5, hexa-lang RFC 034 BLOCKED


// ── helpers ─────────────────────────────────────────────────────────────────
fn _d_has(name: string, items) -> bool {
    let i = 0
    while i < len(items) {
        if to_string(items[i]) == name { return true }
        i = i + 1
    }
    return false
}


