// HEXAD/D/corpus_loader_smoke.hexa — PLAN.md §7 #1 falsifier F-CORPUS.
//
//   real-corpus byte-level loader (corpus_loader_lib.hexa) 검증 — §7 #1
//   실-규모 언어 fire 의 선결조건. d_train5 입력을 synthetic toy → 실 corpus.
//
//   F-CORPUS (5 sub-checks):
//     CORPUS-1 LOAD       — corpus_load_bytes 가 non-empty token 반환.
//     CORPUS-2 LOSSLESS   — len(toks) == file_size(path)  (§8 math anchor:
//                           로더가 lossless — exact closed invariant).
//     CORPUS-3 BYTE-RANGE — ∀ token ∈ [0, 256)  (§8 math anchor: Shannon
//                           8-bit byte alphabet bound, closed ∀ token).
//     CORPUS-4 WINDOW     — corpus_n_windows == n−T ∧ corpus_window len T+1.
//     CORPUS-5 DETERMINISM— re-load byte-identical (head·tail·len).
//
//   §8 / g_blue_closed_mandate: corpus↔trainer 연결고리 = LOSSLESS (CORPUS-2,
//   token count == file byte count exact) + BYTE-ALPHABET (CORPUS-3, ∀ token
//   ∈ [0,256) Shannon bound) — 둘 다 closed-form 수학 invariant, structural
//   아님. fire 입력 경로의 정보-보존을 closed 검증.
// ════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/D/corpus_loader_lib.hexa"

fn _selftest() {
    let path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"

    // ── F-CORPUS-1 LOAD ──
    let toks = corpus_load_bytes(path)
    let n = len(toks)
    let load_ok = n > 0
    println("  F-CORPUS-1 LOAD              : " + to_string(load_ok) + "  (tokens=" + to_string(n) + ")")

    // ── F-CORPUS-2 LOSSLESS (§8: token count == file byte size, exact) ──
    let fsz = file_size(path)
    let lossless_ok = n == fsz
    println("  F-CORPUS-2 LOSSLESS          : " + to_string(lossless_ok) + "  (n=" + to_string(n) + " == file_size=" + to_string(fsz) + ")")

    // ── F-CORPUS-3 BYTE-RANGE (§8: ∀ token ∈ [0,256) Shannon 8-bit) ──
    let mut range_ok = true
    let mut i = 0
    while i < n {
        let b = toks[i]
        if b < 0 { range_ok = false }
        if b > 255 { range_ok = false }
        i = i + 1
    }
    println("  F-CORPUS-3 BYTE-RANGE [0,256): " + to_string(range_ok))

    // ── F-CORPUS-4 WINDOW ──
    let t_len = 64
    let nw = corpus_n_windows(toks, t_len)
    let w = corpus_window(toks, 0, t_len)
    let win_ok = nw == n - t_len && len(w) == t_len + 1 && w[0] == toks[0]
    println("  F-CORPUS-4 WINDOW (T=64)     : " + to_string(win_ok) + "  (n_windows=" + to_string(nw) + ")")

    // ── F-CORPUS-5 DETERMINISM ──
    let toks2 = corpus_load_bytes(path)
    let det_ok = len(toks2) == n && toks2[0] == toks[0] && toks2[n - 1] == toks[n - 1]
    println("  F-CORPUS-5 DETERMINISM       : " + to_string(det_ok))

    let all_ok = load_ok && lossless_ok && range_ok && win_ok && det_ok
    println("  F-CORPUS AGGREGATE 5/5       : " + to_string(all_ok))
    println("=== HEXAD/D corpus_loader_smoke selftest: " + to_string(all_ok) + " ===")
    println("    real-corpus byte loader (Python 의존 0); §8 LOSSLESS + BYTE-ALPHABET closed PASS")
}

fn main() {
    println("HEXAD/D — §7 #1 real-corpus loader falsifier (F-CORPUS)")
    _selftest()
}
