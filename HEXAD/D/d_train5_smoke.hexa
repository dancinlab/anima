// HEXAD/D/d_train5_smoke.hexa — entrypoint (import lib + selftest + top-level call)
// ════════════════════════════════════════════════════════════════════════════
//  PHASE 5 (1) T2 — FULL n_layer ConsciousDecoderV2-equivalent pure-hexa
//                    from-scratch trainer SMOKE.
//
//  TINY config (d=8, n_layer=2, nh=2, nkv=1, hd=4, h=16, T=4, V=4)
//  compiled-native Mac verify of the FULL composed analytic reverse:
//    embed → n_layer×[ RMSNorm→GQA(RoPE)→resid → RMSNorm→SwiGLU→resid ]
//          → final RMSNorm → tied LM-head → CE.
//  Lib dimension-generic ⟹ identical code at real d=768·12L on ubu/GPU.
//
//  F-D-PORT-5  : N AdamW over the FULL composed n_layer chain ⟹ gn2
//                = Σ‖softmax−onehot‖² collapses + last-token acc → N.
//                TIER = EMPIRICAL (B-D-NOTE; SGD OUTCOME, NOT 🔵 — g3).
//  F-D-PORT-5b : analytic grad of layer-0 Wg (the DEEPEST-from-loss weight,
//                furthest reverse-path link) vs central finite-diff of CE
//                — proves the FULL composed reverse exact. Verifies IMPL
//                (PROPERTY; g3 no tier lift).
//
//  from-scratch : ALL weights RANDOM seed-fixed LCG, base_ckpt = NONE
//                 (AGENTS.tape g_clm_from_scratch).
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/D/d_train5_lib.hexa"


// deterministic separable byte-seq toy : class c → token pattern whose
// last-position embedding-routed signal must be CE-separable through the
// full composed stack. ids ∈ [0,V) ; target = c.
fn d5_make_dataset(T: int, V: int, reps: int) {
    let mut IDS = []
    let mut YS = []
    let mut c = 0
    while c < V {
        let mut r = 0
        while r < reps {
            let mut ids = []
            let mut p = 0
            while p < T {
                // class-correlated token sequence (last token = c, rest jitter)
                let tk = if p == T - 1 { c } else { (c + r + p) % V }
                ids.push(tk)
                p = p + 1
            }
            IDS.push(ids)
            YS.push(c)
            r = r + 1
        }
        c = c + 1
    }
    return [IDS, YS]
}

// clone block-l's Wg with [idx] += delta  (gradcheck helper, no closure)
fn d5_bump_block_wg(M, l: int, idx: int, delta: float, n_layer: int) {
    let mut nb = []
    let mut bl = 0
    while bl < n_layer {
        let src = M["blocks"][bl]
        if bl == l {
            let wsrc = src["Wg"]
            let mut a = []
            let mut i = 0
            while i < len(wsrc) {
                a.push(if i == idx { wsrc[i] + delta } else { wsrc[i] })
                i = i + 1
            }
            nb.push(#{
                "g1": src["g1"], "Wq": src["Wq"], "Wk": src["Wk"],
                "Wv": src["Wv"], "Wo": src["Wo"], "g2": src["g2"],
                "Wg": a, "Wu": src["Wu"], "Wd": src["Wd"],
            })
        } else {
            nb.push(src)
        }
        bl = bl + 1
    }
    return #{ "tok_emb": M["tok_emb"], "blocks": nb, "gF": M["gF"] }
}

fn d5_epoch_gn2(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                h: int, V: int, n_layer: int) -> float {
    let mut acc = 0.0
    let mut s = 0
    while s < len(YS) {
        acc = acc + d5_gn2(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                           h, V, n_layer)
        s = s + 1
    }
    return acc
}
fn d5_epoch_acc(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                h: int, V: int, n_layer: int) -> int {
    let mut cc = 0
    let mut s = 0
    while s < len(YS) {
        if d5_predict(IDS[s], M, cos, sin, T, d, nh, nkv, h, V, n_layer)
           == YS[s] { cc = cc + 1 }
        s = s + 1
    }
    return cc
}

// AdamW state for one block (9 param arrays)
fn d5_zero_block_opt(d: int, nh: int, nkv: int, h: int) {
    let hd = d / nh
    let kvd = nkv * hd
    return #{
        "g1": dt2_zeros(d), "Wq": dt2_zeros(d*d), "Wk": dt2_zeros(kvd*d),
        "Wv": dt2_zeros(kvd*d), "Wo": dt2_zeros(d*d), "g2": dt2_zeros(d),
        "Wg": dt2_zeros(h*d), "Wu": dt2_zeros(h*d), "Wd": dt2_zeros(d*h),
    }
}

fn selftest() {
    println("================================================================")
    println("d_train5_smoke — Phase 5 (1) T2 full n_layer decoder (F-D-PORT-5)")
    println("================================================================")

    let d = 8
    let nh = 2
    let nkv = 1
    let h = 16
    let V = 4
    let T = 4
    let n_layer = 2
    let reps = 2                              // N = V*reps = 8
    let hd = d / nh
    let kvd = nkv * hd

    let ds = d5_make_dataset(T, V, reps)
    let IDS = ds[0]
    let YS = ds[1]
    let nsamp = len(YS)
    let rt = d5_rope_tables(T, hd)
    let cos = rt[0]
    let sin = rt[1]

    // from-scratch RANDOM seed-fixed (g_clm_from_scratch, base_ckpt=NONE)
    let mut M = d5_init(42, d, nh, nkv, h, V, n_layer)

    let gn0 = d5_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ac0 = d5_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    println("  init : gn2=" + to_string(gn0) + "  acc=" + to_string(ac0)
            + "/" + to_string(nsamp))

    // ── F-D-PORT-5b GRAD-EXACT : layer-0 Wg (deepest-from-loss weight) ──
    //   analytic (full composed reverse) vs central finite-difference of CE.
    let wi = 5
    let eps = 0.0005
    let gA = d5_grad(IDS[0], M, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let gA_wg = gA["dblocks"][0]["dWg"][wi]
    let Mp = d5_bump_block_wg(M, 0, wi, eps, n_layer)
    let Mm = d5_bump_block_wg(M, 0, wi, 0.0 - eps, n_layer)
    let cep = d5_ce(IDS[0], Mp, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let cem = d5_ce(IDS[0], Mm, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let gF = (cep - cem) / (2.0 * eps)
    let ge = if gA_wg - gF > 0.0 { gA_wg - gF } else { gF - gA_wg }
    let gx = ge < 0.01
    println("  GRAD-EXACT(L0.Wg[" + to_string(wi) + "]): analytic="
            + to_string(gA_wg) + " fd=" + to_string(gF) + " |Δ|="
            + to_string(ge) + "  -> " + (if gx { "PASS" } else { "FAIL" }))

    // ── from-scratch AdamW over the FULL composed n_layer chain ──────────
    let steps = 200
    // optimizer state : tok_emb + per-block(9) + gF
    let mut m_te = dt2_zeros(V*d); let mut v_te = dt2_zeros(V*d)
    let mut m_gF = dt2_zeros(d);   let mut v_gF = dt2_zeros(d)
    let mut mB = []
    let mut vB = []
    let mut bi = 0
    while bi < n_layer {
        mB.push(d5_zero_block_opt(d, nh, nkv, h))
        vB.push(d5_zero_block_opt(d, nh, nkv, h))
        bi = bi + 1
    }
    let lr = 0.03
    let b1 = 0.9
    let b2 = 0.999
    let epsa = 0.00000001
    let wd = 0.01

    let mut st = 1
    while st <= steps {
        // accumulate grads over the epoch
        let mut gte = dt2_zeros(V*d)
        let mut ggF = dt2_zeros(d)
        let mut gB = []
        bi = 0
        while bi < n_layer { gB.push(d5_zero_block_opt(d, nh, nkv, h)); bi = bi + 1 }
        let mut s = 0
        while s < nsamp {
            let G = d5_grad(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                            h, V, n_layer)
            let a = G["dtok_emb"]
            let mut q = 0
            while q < V*d { gte[q] = gte[q] + a[q]; q = q + 1 }
            let agF = G["dgF"]
            q = 0
            while q < d { ggF[q] = ggF[q] + agF[q]; q = q + 1 }
            bi = 0
            while bi < n_layer {
                let gb = G["dblocks"][bi]
                let cur = gB[bi]
                let mut ng1 = []
                q = 0
                while q < d { ng1.push(cur["g1"][q] + gb["dg1"][q]); q = q + 1 }
                let mut ng2 = []
                q = 0
                while q < d { ng2.push(cur["g2"][q] + gb["dg2"][q]); q = q + 1 }
                let mut nWq = []
                q = 0
                while q < d*d { nWq.push(cur["Wq"][q] + gb["dWq"][q]); q = q + 1 }
                let mut nWo = []
                q = 0
                while q < d*d { nWo.push(cur["Wo"][q] + gb["dWo"][q]); q = q + 1 }
                let mut nWk = []
                q = 0
                while q < kvd*d { nWk.push(cur["Wk"][q] + gb["dWk"][q]); q = q + 1 }
                let mut nWv = []
                q = 0
                while q < kvd*d { nWv.push(cur["Wv"][q] + gb["dWv"][q]); q = q + 1 }
                let mut nWg = []
                q = 0
                while q < h*d { nWg.push(cur["Wg"][q] + gb["dWg"][q]); q = q + 1 }
                let mut nWu = []
                q = 0
                while q < h*d { nWu.push(cur["Wu"][q] + gb["dWu"][q]); q = q + 1 }
                let mut nWd = []
                q = 0
                while q < d*h { nWd.push(cur["Wd"][q] + gb["dWd"][q]); q = q + 1 }
                gB[bi] = #{ "g1": ng1, "Wq": nWq, "Wk": nWk, "Wv": nWv,
                            "Wo": nWo, "g2": ng2, "Wg": nWg, "Wu": nWu,
                            "Wd": nWd }
                bi = bi + 1
            }
            s = s + 1
        }
        // AdamW updates
        let ute = dt2_adamw_step(M["tok_emb"], m_te, v_te, gte, lr, b1, b2, epsa, wd, st)
        let ugF = dt2_adamw_step(M["gF"], m_gF, v_gF, ggF, lr, b1, b2, epsa, wd, st)
        m_te = ute[1]; v_te = ute[2]
        m_gF = ugF[1]; v_gF = ugF[2]
        let mut newblocks = []
        bi = 0
        while bi < n_layer {
            let Bp = M["blocks"][bi]
            let gb = gB[bi]
            let mo = mB[bi]
            let vo = vB[bi]
            let ug1 = dt2_adamw_step(Bp["g1"], mo["g1"], vo["g1"], gb["g1"], lr, b1, b2, epsa, wd, st)
            let uWq = dt2_adamw_step(Bp["Wq"], mo["Wq"], vo["Wq"], gb["Wq"], lr, b1, b2, epsa, wd, st)
            let uWk = dt2_adamw_step(Bp["Wk"], mo["Wk"], vo["Wk"], gb["Wk"], lr, b1, b2, epsa, wd, st)
            let uWv = dt2_adamw_step(Bp["Wv"], mo["Wv"], vo["Wv"], gb["Wv"], lr, b1, b2, epsa, wd, st)
            let uWo = dt2_adamw_step(Bp["Wo"], mo["Wo"], vo["Wo"], gb["Wo"], lr, b1, b2, epsa, wd, st)
            let ug2 = dt2_adamw_step(Bp["g2"], mo["g2"], vo["g2"], gb["g2"], lr, b1, b2, epsa, wd, st)
            let uWg = dt2_adamw_step(Bp["Wg"], mo["Wg"], vo["Wg"], gb["Wg"], lr, b1, b2, epsa, wd, st)
            let uWu = dt2_adamw_step(Bp["Wu"], mo["Wu"], vo["Wu"], gb["Wu"], lr, b1, b2, epsa, wd, st)
            let uWd = dt2_adamw_step(Bp["Wd"], mo["Wd"], vo["Wd"], gb["Wd"], lr, b1, b2, epsa, wd, st)
            newblocks.push(#{ "g1": ug1[0], "Wq": uWq[0], "Wk": uWk[0],
                "Wv": uWv[0], "Wo": uWo[0], "g2": ug2[0], "Wg": uWg[0],
                "Wu": uWu[0], "Wd": uWd[0] })
            mB[bi] = #{ "g1": ug1[1], "Wq": uWq[1], "Wk": uWk[1], "Wv": uWv[1],
                "Wo": uWo[1], "g2": ug2[1], "Wg": uWg[1], "Wu": uWu[1],
                "Wd": uWd[1] }
            vB[bi] = #{ "g1": ug1[2], "Wq": uWq[2], "Wk": uWk[2], "Wv": uWv[2],
                "Wo": uWo[2], "g2": ug2[2], "Wg": uWg[2], "Wu": uWu[2],
                "Wd": uWd[2] }
            bi = bi + 1
        }
        M = #{ "tok_emb": ute[0], "blocks": newblocks, "gF": ugF[0] }
        st = st + 1
    }

    let gn1 = d5_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ac1 = d5_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    println("  final: gn2=" + to_string(gn1) + "  acc=" + to_string(ac1)
            + "/" + to_string(nsamp) + "  (after " + to_string(steps)
            + " AdamW steps, full composed " + to_string(n_layer)
            + "-layer chain)")

    let collapsed = (gn1 * 5.0) < gn0
    let accfull = ac1 == nsamp
    let port5 = collapsed && accfull
    println("  F-D-PORT-5 : gn2-collapse(>=5x)=" + to_string(collapsed)
            + " acc-full=" + to_string(accfull) + "  -> "
            + (if port5 { "PASS (EMPIRICAL)" } else { "FAIL" }))

    let ok = gx && port5
    println("----------------------------------------------------------------")
    println("  proves: FULL n_layer composed reverse exact (embed scatter-add")
    println("          + RoPE inverse-rotation + GQA group bookkeeping +")
    println("          multi-layer residual chaining + tied LM-head)")
    println("  scope : decoder LM CORE (RMSNorm+GQA+RoPE+SwiGLU+resid+tied")
    println("          +embed) — PureField/Cross-attn/MoE = consciousness")
    println("          pathway (integ harness nn.Module; not CE-trainer core)")
    println("  TIER = EMPIRICAL (B-D-NOTE: SGD OUTCOME, NOT 🔵; head grad")
    println("         = B-D-4 closed 🔵 reused, composition = no new math)")
    println("  selftest: " + (if ok { "true" } else { "false" }))
    println("================================================================")
    return if ok { 0 } else { 1 }
}

selftest()
