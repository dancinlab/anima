import "/Users/ghost/core/anima/HEXAD/D/d_lib.hexa"

// ── selftest: invariant checks ──────────────────────────────────────────────
fn _selftest() {
    // B-D-3 anchor: RMSNorm + RoPE + SwiGLU structural presence (we mirror
    // the architectural claim here as a scaffold invariant; actual structural
    // verification on weights is in blue_falsifier.py bd() against the real
    // conscious_decoder.py source.)
    let comps = d_arch_components()
    let rms_ok    = _d_has("RMSNorm", comps)
    let rope_ok   = _d_has("RoPE",    comps)
    let swiglu_ok = _d_has("SwiGLU",  comps)
    print("  arch RMSNorm                 : " + to_string(rms_ok))
    print("  arch RoPE                    : " + to_string(rope_ok))
    print("  arch SwiGLU                  : " + to_string(swiglu_ok))

    // byte-level vocab invariant
    let vocab_ok = d_vocab() == 256
    print("  vocab == 256 (byte-level)    : " + to_string(vocab_ok))

    // canonical scale invariants (P2 base)
    let scale_ok = d_n_layer_base() == 12 && d_d_model_default() == 768
    print("  P2 base 12L d_model=768      : " + to_string(scale_ok))

    let all_ok = rms_ok && rope_ok && swiglu_ok && vocab_ok && scale_ok
    print("=== HEXAD/D scaffold check: " + to_string(all_ok) + " ===")
    print("    real 24L forward      : hexa run anima_chat.hexa  (21/21 PASS)")
    print("    multitoken KV cache   : Section 9d, F-D1-V58MULTI 15/15 PASS")
    print("    training (CE backprop): TODO[pytorch] separate cycle")
}


fn main() {
    print("HEXAD/D — 언어 (decoder) hexa-native entry [SCAFFOLD]")
    print("Engine A / CE-trained / RMSNorm+RoPE+SwiGLU / byte-level vocab=256")
    print("Inference delegated → anima_chat.hexa (24L real-ckpt byte-parity)")
    print("D 🔵 SUPPORTED-FORMAL 4/4 (PR #76 honest decomposition)")
    _selftest()
}
