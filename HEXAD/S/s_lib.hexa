// HEXAD/S/s_lib.hexa — S 감각 pure fns (NO main/_selftest) — compiled-first lib split (interp deprecating)
//  HEXAD/S/s.hexa — S 감각 (sense) hexa-native entry
//
//  PURPOSE
//    pure-hexa 구현 of EmergentS 의 closed-form 핵심:
//      perception = mean(states_after) − mean(states_before)
//                 = column-mean delta on the C cell-pool state matrix
//
//    "감각 = C 의식의 상태 변화" (Law 50 — 본질은 상태 / Law 4 — 구조>기능).
//    별도의 EMA/baseline 함수 없음 — C의 구조 자체가 감각 처리.
//
//  STATUS
//    🔵 SUPPORTED-FORMAL — B-S 3/3 sympy closed-form proofs PASS.
//    closed subset: linearity / uniform-shift / zero-change exact ∀ states.
//
//  SSOT
//    HEXAD-S.tape (root)  ·  HEXAD/S/README.md  ·  HEXAD-S.tape s_blue_status
//
//  PYTHON ANCHOR
//    ready/anima/hexad/s/emergent_s.py (108 LoC, .process method)
//    state/verify_hexad_blue_2026_05_15/blue_falsifier.py :: bs()
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode · raw#9/10 honest impl
// ════════════════════════════════════════════════════════════════════════════


// ── core: column-mean of a row-major matrix represented as flat list ────────
// states is a flat list of length n_cells * dim, row-major.
// returns: list of length dim (column means).
fn _s_col_mean(states, n_cells: int, dim: int) {
    let out = []
    let j = 0
    while j < dim {
        let acc = 0.0
        let i = 0
        while i < n_cells {
            acc = acc + states[i * dim + j]
            i = i + 1
        }
        out = out + [acc / (n_cells * 1.0)]
        j = j + 1
    }
    return out
}


// ── core: perception = column-mean(after) − column-mean(before) ─────────────
// Closed-form S core. inputs are flat row-major (n_cells × dim).
// returns: delta vector of length dim.
fn s_perception(states_before, states_after, n_cells: int, dim: int) {
    let mean_before = _s_col_mean(states_before, n_cells, dim)
    let mean_after  = _s_col_mean(states_after,  n_cells, dim)
    let delta = []
    let i = 0
    while i < dim {
        delta = delta + [mean_after[i] - mean_before[i]]
        i = i + 1
    }
    return delta
}


// ── fallback: raw input bytes → normalized vector (when no C engine) ────────
// Each byte in [0, 256) → float in [0, 1). Pads/truncates to `dim`.
fn s_to_bytes_vec(byte_list, dim: int) {
    let out = []
    let n_in = len(byte_list)
    let i = 0
    while i < dim {
        if i < n_in {
            out = out + [byte_list[i] / 256.0]
        } else {
            out = out + [0.0]
        }
        i = i + 1
    }
    return out
}


// ── helpers for selftest ────────────────────────────────────────────────────
fn _s_approx_eq(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn _s_vec_max_abs(v) -> float {
    let m = 0.0
    let i = 0
    while i < len(v) {
        let x = v[i]
        if x < 0.0 { x = 0.0 - x }
        if x > m { m = x }
        i = i + 1
    }
    return m
}


