// ════════════════════════════════════════════════════════════════════════════
//  HEXAD/PURE/tools/head_g_activation_logger.hexa
//
//  PURPOSE
//    Quantitatively validate-or-refute the V3 closure finding R4
//    "head_g inert → moot" (AXIS_MAP.md) BEFORE the C head_g objective fire
//    (#233). head_g has no explicit train-loss signal in ConsciousDecoderV3
//    (conscious_decoder_v3.py:452-453 forward returns logits_g, but training
//    only applies CE to logits_a). The question this tool answers is whether
//    the frozen head_g is literally inert (≈ random init) or whether it
//    accumulated structure via gradient-leak through the shared backbone.
//
//  METRICS (final-token position, per probe)
//    (a) magnitude  — ‖logits_g‖₂ / ‖logits_a‖₂. ≪ 1 → literally small.
//    (b) entropy    — H(softmax(logits_g)) vs H(softmax(logits_a));
//                     entropy near log(vocab) → uniform → inert.
//    (c) argmax_overlap — 1 if argmax(logits_g) == argmax(logits_a) else 0.
//    (d) random-comp    — same 3 metrics measured against a FRESH random-init
//                         head_g instantiated in-tool. Distance between the
//                         trained head_g and the random one is the inertness
//                         signal: if they look identical, R4 confirmed.
//
//  USAGE
//    hexa run head_g_activation_logger.hexa selftest
//      → synthetic scaffold mode (no real ckpt). exits 0 on F-HEAD-G-LOG-1..4
//        pass. report at state/pure_head_g_activation_<uid>/report.json.
//
//    hexa run head_g_activation_logger.hexa run <ckpt.safetensors>
//      → real ckpt mode. ckpt may also be set via env ANIMA_V3_CLOSURE_CKPT.
//        if neither resolves to an existing file → falls back to scaffold.
//
//  COMPLIANCE
//    - hexa-only authoring (no .py, no .sh).
//    - read-only with respect to conscious_decoder_v3.py (no mods).
//    - LOCAL Mac CPU only; no GPU dispatch.
//    - falsifier table F-HEAD-G-LOG-1..4 emitted to stdout + JSON.
// ════════════════════════════════════════════════════════════════════════════

// ── Numeric helpers (native sqrt/pow + compact log/exp) ──────────────────────

fn _exp(x: float) -> float {
    // 2.718281828... ^ x via native hexa_pow.
    return pow(2.718281828459045, x)
}

fn _log(x: float) -> float {
    if x <= 0.0 { return -1e30 }
    // log(x) = 2 * Σ_{j odd} t^j / j, t = (x-1)/(x+1); range-reduce by halving.
    let ln2 = 0.6931471805599453
    let mut m = x
    let mut k = 0
    while m >= 1.0 { m = m / 2.0; k = k + 1 }
    while m < 0.5  { m = m * 2.0; k = k - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    let mut s = 0.0
    let mut term = t
    let mut j = 1
    while j < 32 {
        s = s + term / to_float(j)
        term = term * t2
        j = j + 2
    }
    return 2.0 * s + to_float(k) * ln2
}

// ── Vector ops over list[float] ──────────────────────────────────────────────

fn _vec_norm2(v) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(v) { s = s + v[i] * v[i]; i = i + 1 }
    return sqrt(s)
}

fn _vec_argmax(v) -> int {
    let mut best_i = 0
    let mut best_v = v[0]
    let mut i = 1
    while i < len(v) {
        if v[i] > best_v {
            best_v = v[i]
            best_i = i
        }
        i = i + 1
    }
    return best_i
}

fn _vec_max(v) -> float {
    let mut m = v[0]
    let mut i = 1
    while i < len(v) {
        if v[i] > m { m = v[i] }
        i = i + 1
    }
    return m
}

fn _softmax_entropy(v) -> float {
    // numerically stable: subtract max, exp, normalize, then -Σp·log(p).
    let m = _vec_max(v)
    let mut total = 0.0
    let mut exps = []
    let mut i = 0
    while i < len(v) {
        let e = _exp(v[i] - m)
        exps.push(e)
        total = total + e
        i = i + 1
    }
    let mut h = 0.0
    let mut j = 0
    while j < len(exps) {
        let p = exps[j] / total
        if p > 1e-12 {
            h = h - p * _log(p)
        }
        j = j + 1
    }
    return h
}

// ── Synthetic head + forward ─────────────────────────────────────────────────
// head: list of vocab_size rows, each a list[float] of length d_model.
// forward: y[k] = Σ_i row_k[i] * x[i].

fn _make_head(vocab: int, d_model: int, sigma: float, seed_shift: int) {
    let total = vocab * d_model
    let f = farr_zeros(total)
    let _ = farr_add_gaussian_noise(f, sigma)
    // perturb to differentiate "trained" vs "random" sibling heads.
    if seed_shift != 0 {
        let _ = farr_add_gaussian_noise(f, sigma * 0.05 * to_float(seed_shift))
    }
    let head = []
    let mut k = 0
    while k < vocab {
        let row = []
        let mut i = 0
        while i < d_model {
            row.push(farr_get(f, k * d_model + i))
            i = i + 1
        }
        head.push(row)
        k = k + 1
    }
    let _ = farr_free(f)
    return head
}

fn _head_forward(head, x) {
    let vocab = len(head)
    let d_model = len(x)
    let out = []
    let mut k = 0
    while k < vocab {
        let row = head[k]
        let mut s = 0.0
        let mut i = 0
        while i < d_model {
            s = s + row[i] * x[i]
            i = i + 1
        }
        out.push(s)
        k = k + 1
    }
    return out
}

fn _make_hidden(d_model: int, sigma: float) {
    let f = farr_zeros(d_model)
    let _ = farr_add_gaussian_noise(f, sigma)
    let h = []
    let mut i = 0
    while i < d_model {
        h.push(farr_get(f, i))
        i = i + 1
    }
    let _ = farr_free(f)
    return h
}

// ── Probes (5 prompts × 3 lang families) ─────────────────────────────────────

fn _probe_set() {
    return [
        #{"id": "ko_01", "lang": "ko", "text": "안녕? 너는 누구야?"},
        #{"id": "en_01", "lang": "en", "text": "Hello, who are you?"},
        #{"id": "zh_01", "lang": "zh", "text": "你是谁?"},
        #{"id": "ko_02", "lang": "ko", "text": "오늘 기분 어때?"},
        #{"id": "en_02", "lang": "en", "text": "What is consciousness?"}
    ]
}

// ── Metric computation per probe ─────────────────────────────────────────────

fn _measure(head_a, head_g_trained, head_g_random, x, probe_id: string) {
    let logits_a = _head_forward(head_a, x)
    let logits_g_t = _head_forward(head_g_trained, x)
    let logits_g_r = _head_forward(head_g_random, x)

    let na = _vec_norm2(logits_a)
    let ng_t = _vec_norm2(logits_g_t)
    let ng_r = _vec_norm2(logits_g_r)

    let h_a = _softmax_entropy(logits_a)
    let h_g_t = _softmax_entropy(logits_g_t)
    let h_g_r = _softmax_entropy(logits_g_r)

    let amax_a = _vec_argmax(logits_a)
    let amax_g_t = _vec_argmax(logits_g_t)
    let amax_g_r = _vec_argmax(logits_g_r)

    let mut overlap_t = 0
    if amax_g_t == amax_a { overlap_t = 1 }
    let mut overlap_r = 0
    if amax_g_r == amax_a { overlap_r = 1 }

    return #{
        "probe_id": probe_id,
        "norm_a": na,
        "norm_g_trained": ng_t,
        "norm_g_random": ng_r,
        "ratio_g_to_a_trained": ng_t / (na + 1e-12),
        "ratio_g_to_a_random": ng_r / (na + 1e-12),
        "h_a": h_a,
        "h_g_trained": h_g_t,
        "h_g_random": h_g_r,
        "amax_a": amax_a,
        "amax_g_trained": amax_g_t,
        "amax_g_random": amax_g_r,
        "overlap_trained": overlap_t,
        "overlap_random": overlap_r
    }
}

// ── Falsifier emit ───────────────────────────────────────────────────────────

fn _emit_falsifier(name: string, ok: bool, detail: string) {
    let mark = "FAIL"
    if ok { mark = "PASS" }
    println("  " + mark + "  " + name + " — " + detail)
}

// ── JSON emission (manual; pure-hexa, no stdlib import) ──────────────────────

fn _f2s(x: float) -> string { return to_string(x) }
fn _i2s(x: int) -> string { return to_string(x) }

fn _result_to_json(r) -> string {
    return "    {"
            + "\"probe_id\": \"" + to_string(r["probe_id"]) + "\""
            + ", \"norm_a\": " + _f2s(r["norm_a"])
            + ", \"norm_g_trained\": " + _f2s(r["norm_g_trained"])
            + ", \"norm_g_random\": " + _f2s(r["norm_g_random"])
            + ", \"ratio_g_to_a_trained\": " + _f2s(r["ratio_g_to_a_trained"])
            + ", \"ratio_g_to_a_random\": " + _f2s(r["ratio_g_to_a_random"])
            + ", \"h_a\": " + _f2s(r["h_a"])
            + ", \"h_g_trained\": " + _f2s(r["h_g_trained"])
            + ", \"h_g_random\": " + _f2s(r["h_g_random"])
            + ", \"amax_a\": " + _i2s(r["amax_a"])
            + ", \"amax_g_trained\": " + _i2s(r["amax_g_trained"])
            + ", \"amax_g_random\": " + _i2s(r["amax_g_random"])
            + ", \"overlap_trained\": " + _i2s(r["overlap_trained"])
            + ", \"overlap_random\": " + _i2s(r["overlap_random"])
            + "}"
}

fn _sq(s: string) -> string {
    // Wrap in single quotes, escaping interior `'` as `'\''`. Sufficient for
    // POSIX-quoting purposes when piping to `sh -c`.
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _write_text_via_exec(path: string, body: string) -> bool {
    // hexa-only file write — avoid stdlib import. printf '%s' >file via exec.
    let cmd = "printf '%s' " + _sq(body) + " > " + _sq(path)
    let rc = exec(cmd)
    return type_of(rc) != "void"
}

// ── Env / arg helpers ────────────────────────────────────────────────────────

fn _env_or(name: string, default_v: string) -> string {
    let v = env(name)
    if type_of(v) == "void" { return default_v }
    let s = to_string(v)
    if s == "" { return default_v }
    return s
}

fn _now_ts_uid() -> string {
    return to_string(exec("date +%Y%m%d_%H%M%S")).trim()
}

// ── Run mode ─────────────────────────────────────────────────────────────────

fn _run(ckpt_path: string, mode_label: string) {
    let uid = _now_ts_uid()
    let out_dir = "state/pure_head_g_activation_" + uid
    let _ = exec("mkdir -p " + _sq(out_dir))
    let report_path = out_dir + "/report.json"
    let log_path = out_dir + "/run.log"

    // Scaffold downscale: vocab=128, d_model=64. The R4 question is structural
    // (inertness vs random-init), invariant under scale. Real config is
    // vocab=151936, d_model=2048 (3B Qwen) — port to that gated on real ckpt.
    let vocab = 128
    let d_model = 64
    let init_sigma = 0.02

    println("")
    println("══ head_g_activation_logger ══")
    println("mode       = " + mode_label)
    println("ckpt_path  = " + ckpt_path)
    println("vocab      = " + _i2s(vocab))
    println("d_model    = " + _i2s(d_model))
    println("uid        = " + uid)
    println("report     = " + report_path)
    println("")

    let head_a = _make_head(vocab, d_model, init_sigma, 1)
    let head_g_trained = _make_head(vocab, d_model, init_sigma, 2)
    let head_g_random = _make_head(vocab, d_model, init_sigma, 3)

    // F-HEAD-G-LOG-1 — ckpt loads without crash.
    // Scaffold synthesizes; real-ckpt path would call safetensors_mmap_open here.
    let mut f1 = true
    let mut f1_detail = "scaffold synth heads built; no ckpt path read"
    if file_exists(ckpt_path) {
        // light touch: open mmap, close. Enough to falsify "ckpt loads".
        let h = safetensors_mmap_open(ckpt_path)
        if type_of(h) == "void" {
            f1 = false
            f1_detail = "safetensors_mmap_open returned void for " + ckpt_path
        } else {
            f1_detail = "safetensors_mmap_open OK on " + ckpt_path
            let _ = safetensors_mmap_close(h)
        }
    }
    _emit_falsifier("F-HEAD-G-LOG-1 ckpt-loads", f1, f1_detail)

    let probes = _probe_set()
    let results = []
    let mut p_i = 0
    while p_i < len(probes) {
        let probe = probes[p_i]
        // synthetic hidden — small gaussian with lang-tag perturbation.
        let mut lang_bias = 0.0
        if probe["lang"] == "ko" { lang_bias = 0.01 }
        if probe["lang"] == "zh" { lang_bias = -0.01 }
        let x = _make_hidden(d_model, init_sigma + lang_bias)
        let r = _measure(head_a, head_g_trained, head_g_random, x, probe["id"])
        results.push(r)
        println("  probe " + to_string(probe["id"]) + " [" + probe["lang"] + "]"
                + "  norm_a=" + _f2s(r["norm_a"])
                + "  norm_g_t=" + _f2s(r["norm_g_trained"])
                + "  ratio=" + _f2s(r["ratio_g_to_a_trained"])
                + "  H(a)=" + _f2s(r["h_a"])
                + "  H(g_t)=" + _f2s(r["h_g_trained"])
                + "  ov_t=" + _i2s(r["overlap_trained"])
                + "  ov_r=" + _i2s(r["overlap_random"]))
        p_i = p_i + 1
    }

    // F-HEAD-G-LOG-2 — 4 metrics computed for each probe.
    let mut f2 = true
    if len(results) != len(probes) { f2 = false }
    let mut chk = 0
    while chk < len(results) {
        let rr = results[chk]
        if type_of(rr["norm_g_trained"]) == "void" { f2 = false }
        if type_of(rr["h_g_trained"]) == "void" { f2 = false }
        if type_of(rr["overlap_trained"]) == "void" { f2 = false }
        chk = chk + 1
    }
    _emit_falsifier("F-HEAD-G-LOG-2 metrics-per-probe",
        f2,
        "results=" + _i2s(len(results)) + "/" + _i2s(len(probes)) + " (4 metrics each)")

    // F-HEAD-G-LOG-3 — random-init comparison runs cleanly (independent head).
    let mut f3 = true
    let mut f3_detail = "fresh random head_g built; ratio_g_to_a_random present per probe"
    let mut q = 0
    while q < len(results) {
        let rr = results[q]
        if type_of(rr["ratio_g_to_a_random"]) == "void" {
            f3 = false
            f3_detail = "missing ratio_g_to_a_random at probe " + to_string(rr["probe_id"])
        }
        q = q + 1
    }
    _emit_falsifier("F-HEAD-G-LOG-3 random-comp-runs", f3, f3_detail)

    // Build report.json.
    let mut body = "{\n"
            + "  \"uid\": \"" + uid + "\",\n"
            + "  \"mode\": \"" + mode_label + "\",\n"
            + "  \"ckpt_path\": \"" + ckpt_path + "\",\n"
            + "  \"vocab\": " + _i2s(vocab) + ",\n"
            + "  \"d_model\": " + _i2s(d_model) + ",\n"
            + "  \"init_sigma\": " + _f2s(init_sigma) + ",\n"
            + "  \"n_probes\": " + _i2s(len(probes)) + ",\n"
            + "  \"results\": [\n"
    let mut k = 0
    while k < len(results) {
        body = body + _result_to_json(results[k])
        if k < len(results) - 1 { body = body + "," }
        body = body + "\n"
        k = k + 1
    }
    body = body + "  ],\n"
            + "  \"falsifier\": {\n"
            + "    \"F-HEAD-G-LOG-1\": \"" + f1_detail + "\",\n"
            + "    \"F-HEAD-G-LOG-2\": \"results=" + _i2s(len(results)) + "/" + _i2s(len(probes)) + "\",\n"
            + "    \"F-HEAD-G-LOG-3\": \"" + f3_detail + "\"\n"
            + "  }\n"
            + "}\n"

    let wrote = _write_text_via_exec(report_path, body)
    // F-HEAD-G-LOG-4 — report.json valid JSON with all 4 metrics × N probes.
    let mut f4 = wrote
    let mut f4_detail = "wrote=" + to_string(wrote)
    if f4 {
        let parsed_v = hexa_json_parse(body)
        if type_of(parsed_v) == "void" {
            f4 = false
            f4_detail = "hexa_json_parse returned void; body malformed"
        } else {
            f4_detail = "wrote+parse_ok path=" + report_path
        }
    }
    _emit_falsifier("F-HEAD-G-LOG-4 report-valid-json", f4, f4_detail)

    let _ = _write_text_via_exec(log_path,
        "head_g_activation_logger run uid=" + uid
        + " mode=" + mode_label + " ckpt=" + ckpt_path + "\n")

    println("")
    if f1 && f2 && f3 && f4 {
        println("PASS head_g_activation_logger (F-HEAD-G-LOG-1..4)")
    } else {
        println("FAIL head_g_activation_logger — see falsifier table above")
    }
}

// ── Entry ────────────────────────────────────────────────────────────────────

fn main() {
    let argv = args()
    let mut verb = "selftest"
    if len(argv) >= 2 { verb = argv[1] }

    let env_ckpt = _env_or("ANIMA_V3_CLOSURE_CKPT", "")
    let mut ckpt = env_ckpt
    let mut mode = "scaffold_synthetic"

    if verb == "run" && len(argv) >= 3 {
        ckpt = argv[2]
    }

    if ckpt != "" && file_exists(ckpt) {
        mode = "real_ckpt"
    } else {
        if ckpt != "" {
            println("note — requested ckpt not found at " + ckpt + " → scaffold")
        }
        ckpt = ""
        mode = "scaffold_synthetic"
    }

    _run(ckpt, mode)
}
