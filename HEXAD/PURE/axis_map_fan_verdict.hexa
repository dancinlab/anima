// ════════════════════════════════════════════════════════════════════════════
//  HEXAD/PURE/axis_map_fan_verdict.hexa
//
//  AXIS_MAP-FAN 7-axis verdict CONTROL-PLANE — re-usable poll + verdict driver.
//
//  ── HONEST FRAMING (read first) ─────────────────────────────────────────────
//  This .hexa is the AXIS_MAP-FAN orchestrator's CONTROL-PLANE — NOT the
//  model forward. It does NOT run the 3B ConsciousDecoderV3 train: that needs
//  GPU + torch and is `train_p21h_v3.py`'s job on a runpod pod (dispatched via
//  dispatch_p21h_v3_runpod.sh). This driver's four jobs are:
//
//      1. emit the 7-axis env-var config matrix         (verb: axes)
//      2. render the 7 dispatch commands (PR #204 ✓)   (verb: dispatch-cmds)
//      3. parse init_CE per axis + cluster-classify    (verb: verdict <dir>)
//      4. selftest the driver itself                   (verb: selftest)
//
//  No GPU is touched here. No model weight is loaded. The substrate-forward,
//  the actual init_CE measurement, happens on the pod. This file is the
//  control-plane that *describes* the AXIS_MAP-FAN experiment and
//  *interprets* its outputs. Designed for re-use on every AXIS_MAP re-fire.
//
//  ── 7-axis matrix (AXIS_MAP.md · AXIS_MAP_RESULTS{,_UPDATE_5_7}.md) ──────────
//  axis | env-var (PR #204 separate-token form)         | noise_sigma | n_kv_head | init_path        | extra
//  -----+------------------------------------------------+-------------+-----------+------------------+----------------
//   A   | P21H_CURRICULUM_PHASE_STEPS=1000               | 0.1         | 4         | qwen-warm        | wiki-only curriculum 1000 step
//   B   | P21H_DISTILL_KD=1                              | 0.1         | 4         | qwen-warm        | vP21M LoRA teacher KD aux
//   C   | P21H_HEAD_G_OBJECTIVE=anima_register_ce        | 0.1         | 4         | qwen-warm        | head_g 별도 objective
//   C2  | P21H_HEAD_G_ENABLE=0                           | 0.1         | 4         | qwen-warm        | head_g 완전 disable (natural-experiment)
//   D   | P21H_FREEZE_EMBED=1                            | 0.1         | 4         | qwen-warm        | token_embed + lm_head freeze
//   E   | P21H_LANG_BALANCED=1                           | 0.1         | 4         | qwen-warm        | per-lang token-balanced sampler
//   F   | P21H_CONTRASTIVE_INFONCE=1                     | 0.1         | 4         | qwen-warm        | InfoNCE lang-contrastive aux
//
//  ── Observed cluster baselines (PR #206 + PR #224, 5/7+2 abort) ──────────────
//      cluster X — { A }              init_CE 14.7927      (curriculum, n=1)
//      cluster Y — { B, F, E2 }       init_CE 14.1780      (aux-loss, byte-equal)
//      cluster Z — { C, C2, D }       init_CE 14.4564      (baseline, byte-equal)
//      → 3-cluster natural-experiment fingerprint of the AXIS_MAP-FAN fire.
//
//  ── H_255 verdict thresholds (artifact hypothesis) ──────────────────────────
//  Hypothesis: 14+ init_CE floor is a MEASUREMENT-WINDOW artifact (5000-step
//  PROBE_STEPS averaging vs first-step capture); a PROBE_STEPS=100 short-window
//  re-fire should drop to ~12.x band if H_255.2 holds.
//
//      H_255.1 (artifact-FALSIFIED)    every axis re-fire byte-equal to its prior
//                                      cluster band (|Δ| ≤ 0.1 nats vs baseline —
//                                      X/Y/Z centers are 0.28-0.34 apart, so 0.1
//                                      keeps the 3 cluster bands disjoint)
//                                      → measurement-window NOT the cause; 14+ real
//      H_255.2 (artifact-CONFIRMED)    every axis re-fire collapses into 12.x band
//                                      (|init_CE - 12.0| ≤ 1.0 across all 7) →
//                                      AXIS_MAP-FAN 14+ floor was PROBE_STEPS
//                                      averaging artifact; reframe R8 saga
//      H_255 PARTIAL                   mixed — some axes stay 14+, others drop to
//                                      12.x → axis-dependent artifact behaviour
//
//  ── PR #204 ANTI-CONCAT (caller contract — same rule as R8c) ────────────────
//  Each env var is a DISTINCT `VAR=val` token after `env` — NEVER concatenated:
//      env P21H_STEPS=100 P21H_NOISE_SIGMA=0.1 ... bash dispatch... <variant>
//  Concat ("P21H_STEPS=100 P21H_NOISE_SIGMA=0.1 ..." as ONE quoted blob) binds
//  the entire string as ONE env-var and argparse rejects the run (broke 4/7
//  AXIS_MAP-FAN axes 2026-05-23 — PR #204 postmortem). axis_dispatch_cmd
//  renders the ✓ form.
//
//  ── VERBS ───────────────────────────────────────────────────────────────────
//      axes                   print the 7-axis config matrix
//      dispatch-cmds          print the 7 dispatch commands (PR #204 ✓ form)
//      verdict <result-dir>   parse <dir>/<axis>/result.json → cluster classify
//                             + H_255 verdict (byte-equal 12.x or 14+?)
//      selftest               F-AXIS-MAP-1..5 (5/5 PASS required)
//
//  hexa-only · control-plane · LLM=none · CPU-local · $0 (no fire here)
//  (p1 NO SYSTEM PROMPT + feedback_hexa_only_authoring directive)
// ════════════════════════════════════════════════════════════════════════════

let DISPATCH       = "dispatch_p21h_v3_runpod.sh"
let PROBE_STEPS    = 100                 // short re-probe window (NOT 5000 prod)
let BASELINE_NOISE = 0.1
let BASELINE_KV    = 4
let BASELINE_INIT  = "qwen-warm"         // ConsciousDecoderV3 default warm-init from Qwen 1.5B

// observed cluster floors (AXIS_MAP_RESULTS_UPDATE_5_7_2026_05_23.md § cluster)
let CLUSTER_X_CE   = 14.7927             // axis A (curriculum) only
let CLUSTER_Y_CE   = 14.1780             // axes B / F / E2 (aux-loss byte-equal)
let CLUSTER_Z_CE   = 14.4564             // axes C / C2 / D (baseline byte-equal)
let CLUSTER_BAND   = 0.1                 // |Δ| nats — byte-equal tolerance band (X/Y/Z centers
                                         // are 0.28-0.34 apart in prior fire; 0.1 keeps them disjoint)
let ARTIFACT_FLOOR = 12.0                // H_255.2 expected 12.x band center
let ARTIFACT_BAND  = 1.0                 // |Δ| nats — 12.x band tolerance

// ─── helpers ─────────────────────────────────────────────────────────────────

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn fexists(path: string) -> bool {
    // stat -f (BSD/macOS) then stat -c (GNU/Linux); stderr muted so a
    // platform-mismatch probe stays silent (one of the two always applies).
    let probe = _str(exec("stat -f %N " + path + " 2>/dev/null")).trim()
    if probe != "" { return true }
    let probe2 = _str(exec("stat -c %n " + path + " 2>/dev/null")).trim()
    return probe2 != ""
}

fn read_safe(path: string) -> string {
    if !fexists(path) { return "" }
    return _str(read_file(path))
}

fn absf(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn fmt4(x: f64) -> string {
    return to_string(x)
}

fn pad_right(s: string, n: int) -> string {
    let pad = "                                                  "
    return (s + pad).substring(0, n)
}

// ─── 1. 7-axis config matrix ─────────────────────────────────────────────────

fn axis_matrix() -> list {
    let mut out = []
    out = push(out, #{
        "id":          "A",
        "variant":     "vP21H_axis_A",
        "env_key":     "P21H_CURRICULUM_PHASE_STEPS",
        "env_val":     "1000",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "X",
        "expected_init_ce": CLUSTER_X_CE,
        "note":        "curriculum wiki-only 1000 step (cluster X · n=1)"
    })
    out = push(out, #{
        "id":          "B",
        "variant":     "vP21H_axis_B",
        "env_key":     "P21H_DISTILL_KD",
        "env_val":     "1",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "Y",
        "expected_init_ce": CLUSTER_Y_CE,
        "note":        "vP21M LoRA teacher KD aux (cluster Y · byte-equal F)"
    })
    out = push(out, #{
        "id":          "C",
        "variant":     "vP21H_axis_C",
        "env_key":     "P21H_HEAD_G_OBJECTIVE",
        "env_val":     "anima_register_ce",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "Z",
        "expected_init_ce": CLUSTER_Z_CE,
        "note":        "head_g objective swap (cluster Z · byte-equal C2/D)"
    })
    out = push(out, #{
        "id":          "C2",
        "variant":     "vP21H_axis_C2",
        "env_key":     "P21H_HEAD_G_ENABLE",
        "env_val":     "0",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "Z",
        "expected_init_ce": CLUSTER_Z_CE,
        "note":        "head_g disable (cluster Z · natural-experiment R8c)"
    })
    out = push(out, #{
        "id":          "D",
        "variant":     "vP21H_axis_D",
        "env_key":     "P21H_FREEZE_EMBED",
        "env_val":     "1",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "Z",
        "expected_init_ce": CLUSTER_Z_CE,
        "note":        "embed + lm_head freeze (cluster Z · byte-equal C/C2)"
    })
    out = push(out, #{
        "id":          "E",
        "variant":     "vP21H_axis_E",
        "env_key":     "P21H_LANG_BALANCED",
        "env_val":     "1",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "Y",
        "expected_init_ce": CLUSTER_Y_CE,
        "note":        "lang-balanced sampler (E2 cluster Y after leak-fix retry)"
    })
    out = push(out, #{
        "id":          "F",
        "variant":     "vP21H_axis_F",
        "env_key":     "P21H_CONTRASTIVE_INFONCE",
        "env_val":     "1",
        "noise_sigma": BASELINE_NOISE,
        "n_kv_head":   BASELINE_KV,
        "init_path":   BASELINE_INIT,
        "expected_cluster": "Y",
        "expected_init_ce": CLUSTER_Y_CE,
        "note":        "InfoNCE lang-contrastive aux (cluster Y · byte-equal B)"
    })
    return out
}

// ─── 2. dispatch command renderer (PR #204 ✓ separate-env-var form) ──────────

fn axis_dispatch_cmd(ax: map) -> string {
    let sigma = to_string(ax["noise_sigma"])
    let kv    = to_string(ax["n_kv_head"])
    let var   = _str(ax["variant"])
    let init  = _str(ax["init_path"])
    let ekey  = _str(ax["env_key"])
    let eval_ = _str(ax["env_val"])
    // PR #204 anti-concat: every var is its own `KEY=val` token.
    let envp  = "env"
        + " P21H_STEPS=" + str(PROBE_STEPS)
        + " P21H_NOISE_SIGMA=" + sigma
        + " P21H_N_KV_HEAD=" + kv
        + " PROBE_NOISE_SIGMA=" + sigma
        + " PROBE_N_KV_HEAD=" + kv
        + " " + ekey + "=" + eval_
        + " SAVE_POD=1"
    return envp + " bash " + DISPATCH + " " + var + " " + init + " 1337"
}

// ─── 3. init_CE parse from a result.json (init_log.L_ce) ─────────────────────
//
//  result.json shape (dispatch § pull verifier): {"init_log": {"L_ce": <f64>}, ...}
//  Returns -1.0 on absent file / absent key (caller treats as MISSING).

fn axis_parse_init_ce(result_json_path: string) -> f64 {
    let raw = read_safe(result_json_path)
    if raw == "" { return -1.0 }
    let d = json_parse(raw)
    if type_of(d) != "map" { return -1.0 }
    if !d.contains_key("init_log") { return -1.0 }
    let il = d["init_log"]
    if type_of(il) != "map" { return -1.0 }
    if !il.contains_key("L_ce") { return -1.0 }
    return to_float(il["L_ce"])
}

// ─── 4. cluster classification — X / Y / Z / 12.x / OTHER / MISSING ──────────

fn classify_cluster(ce: f64) -> string {
    if ce < 0.0 { return "MISSING" }
    if absf(ce - CLUSTER_X_CE)   <= CLUSTER_BAND  { return "X" }
    if absf(ce - CLUSTER_Y_CE)   <= CLUSTER_BAND  { return "Y" }
    if absf(ce - CLUSTER_Z_CE)   <= CLUSTER_BAND  { return "Z" }
    if absf(ce - ARTIFACT_FLOOR) <= ARTIFACT_BAND { return "12.x" }
    return "OTHER"
}

// ─── 5. H_255 verdict — aggregate over 7-axis init_CE map ────────────────────
//
//  axis_results: map { "A": ce, "B": ce, ..., "F": ce } (any -1.0 = MISSING).
//  Returns a map with cluster counts + H_255 verdict (PASS / FALSIFIED / PARTIAL).

fn axis_verdict(axis_results: map) -> map {
    let axes = axis_matrix()
    let mut v = #{}
    let mut count_x = 0
    let mut count_y = 0
    let mut count_z = 0
    let mut count_12x = 0
    let mut count_other = 0
    let mut count_missing = 0
    let mut count_reproduced = 0    // axis CE in its expected_cluster band
    let mut count_drift = 0          // axis CE in a different prior cluster
    let mut count_artifact = 0       // axis CE in 12.x band (H_255.2 signal)

    let mut per_axis = []
    let mut i = 0
    while i < len(axes) {
        let ax = axes[i]
        let id = _str(ax["id"])
        let ce = to_float(axis_results[id])
        let cl = classify_cluster(ce)
        let exp = _str(ax["expected_cluster"])
        let reproduced = (cl == exp && ce >= 0.0)
        let artifact   = (cl == "12.x")
        let drift      = (ce >= 0.0 && !reproduced && !artifact)

        per_axis = push(per_axis, #{
            "id":         id,
            "ce":         ce,
            "cluster":    cl,
            "expected":   exp,
            "reproduced": reproduced,
            "artifact":   artifact,
            "drift":      drift
        })

        if cl == "X"       { count_x = count_x + 1 }
        if cl == "Y"       { count_y = count_y + 1 }
        if cl == "Z"       { count_z = count_z + 1 }
        if cl == "12.x"    { count_12x = count_12x + 1 }
        if cl == "OTHER"   { count_other = count_other + 1 }
        if cl == "MISSING" { count_missing = count_missing + 1 }
        if reproduced      { count_reproduced = count_reproduced + 1 }
        if artifact        { count_artifact = count_artifact + 1 }
        if drift           { count_drift = count_drift + 1 }
        i = i + 1
    }

    v["per_axis"]        = per_axis
    v["count_X"]         = count_x
    v["count_Y"]         = count_y
    v["count_Z"]         = count_z
    v["count_12x"]       = count_12x
    v["count_OTHER"]     = count_other
    v["count_MISSING"]   = count_missing
    v["count_reproduced"] = count_reproduced
    v["count_drift"]     = count_drift
    v["count_artifact"]  = count_artifact

    // H_255 decision tree:
    //   - any MISSING → DEFERRED (incomplete fire)
    //   - all 7 in expected cluster band (14+) → H_255.1 FALSIFIED (artifact gone)
    //   - all 7 in 12.x band → H_255.2 PASS (artifact confirmed)
    //   - mixed → H_255 PARTIAL (axis-dependent)
    let total = len(axes)
    let mut verdict = "DEFERRED — incomplete (n_MISSING=" + str(count_missing) + " / " + str(total) + ")"
    if count_missing == 0 {
        if count_reproduced == total {
            verdict = "H_255.1 FALSIFIED — all 7 axes byte-equal to prior cluster (14+ floor real, artifact gone)"
        } else if count_artifact == total {
            verdict = "H_255.2 PASS — all 7 axes collapsed to 12.x band (artifact confirmed; reframe R8 saga)"
        } else if count_artifact > 0 && count_reproduced > 0 {
            verdict = "H_255 PARTIAL — mixed (n_reproduced=" + str(count_reproduced)
                + " · n_artifact=" + str(count_artifact)
                + " · n_drift=" + str(count_drift) + "; axis-dependent behaviour)"
        } else if count_artifact > 0 {
            verdict = "H_255 PARTIAL (artifact-leaning) — n_artifact=" + str(count_artifact)
                + " / " + str(total) + " axes in 12.x; n_drift=" + str(count_drift)
        } else {
            verdict = "H_255 INCONCLUSIVE — n_drift=" + str(count_drift)
                + " axes drifted between cluster bands (neither 14+ reproduction nor 12.x artifact)"
        }
    }
    v["verdict"] = verdict
    return v
}

// ─── rendering ───────────────────────────────────────────────────────────────

fn print_axes() {
    let axes = axis_matrix()
    println("=== AXIS_MAP-FAN 7-axis config matrix (PR #206 + PR #224) ===")
    println("  id  | env-var                                       | sigma | kv | init      | cluster (expected init_CE)")
    println("  ----+-----------------------------------------------+-------+----+-----------+----------------------------")
    let mut i = 0
    while i < len(axes) {
        let ax = axes[i]
        let id    = pad_right(_str(ax["id"]), 4)
        let envt  = _str(ax["env_key"]) + "=" + _str(ax["env_val"])
        let envp  = pad_right(envt, 46)
        let sigma = pad_right(to_string(ax["noise_sigma"]), 6)
        let kv    = pad_right(to_string(ax["n_kv_head"]), 3)
        let init  = pad_right(_str(ax["init_path"]), 10)
        let cl    = _str(ax["expected_cluster"])
        let ece   = to_string(ax["expected_init_ce"])
        println("  " + id + "| " + envp + "| " + sigma + "| " + kv + "| " + init + "| " + cl + " (" + ece + ")")
        i = i + 1
    }
    println("")
    println("  Cluster baselines (AXIS_MAP_RESULTS_UPDATE_5_7_2026_05_23.md):")
    println("    X (n=1)  init_CE = " + to_string(CLUSTER_X_CE) + " — { A }")
    println("    Y (n=3)  init_CE = " + to_string(CLUSTER_Y_CE) + " — { B, F, E2 } byte-equal")
    println("    Z (n=3)  init_CE = " + to_string(CLUSTER_Z_CE) + " — { C, C2, D } byte-equal")
}

fn print_dispatch_cmds() {
    let axes = axis_matrix()
    println("=== AXIS_MAP-FAN dispatch commands (PR #204 ✓ separate-env-var form) ===")
    println("# control-plane only — actual fire = GPU pods (train_p21h_v3.py); ~$6 / 7 pods, user-gated.")
    let mut i = 0
    while i < len(axes) {
        let ax = axes[i]
        println("# axis " + _str(ax["id"]) + " — " + _str(ax["note"]))
        println(axis_dispatch_cmd(ax))
        i = i + 1
    }
}

fn fmt_ce(x: f64) -> string {
    if x < 0.0 { return "MISSING" }
    return fmt4(x)
}

fn print_verdict(result_dir: string) {
    let axes = axis_matrix()
    let mut ces = #{}
    let mut i = 0
    while i < len(axes) {
        let ax = axes[i]
        let id = _str(ax["id"])
        let var = _str(ax["variant"])
        let path = result_dir + "/" + var + "/result.json"
        let alt  = result_dir + "/" + id + "/result.json"
        let mut ce = axis_parse_init_ce(path)
        if ce < 0.0 { ce = axis_parse_init_ce(alt) }
        ces[id] = ce
        i = i + 1
    }
    let v = axis_verdict(ces)
    println("=== AXIS_MAP-FAN verdict (result-dir: " + result_dir + ") ===")
    println("  axis | init_CE (nats) | cluster | expected | reproduced?")
    println("  -----+----------------+---------+----------+------------")
    let per = v["per_axis"]
    if type_of(per) != "array" {
        println("  (per_axis missing — verdict map malformed)")
        return
    }
    let mut j = 0
    while j < len(per) {
        let row = per[j]
        let id  = pad_right(_str(row["id"]), 5)
        let ce  = pad_right(fmt_ce(to_float(row["ce"])), 15)
        let cl  = pad_right(_str(row["cluster"]), 8)
        let exp = pad_right(_str(row["expected"]), 9)
        let rep = to_string(row["reproduced"])
        println("  " + id + "| " + ce + "| " + cl + "| " + exp + "| " + rep)
        j = j + 1
    }
    println("")
    println("  cluster counts — X=" + to_string(v["count_X"])
        + " · Y=" + to_string(v["count_Y"])
        + " · Z=" + to_string(v["count_Z"])
        + " · 12.x=" + to_string(v["count_12x"])
        + " · OTHER=" + to_string(v["count_OTHER"])
        + " · MISSING=" + to_string(v["count_MISSING"]))
    println("  n_reproduced=" + to_string(v["count_reproduced"])
        + " · n_artifact=" + to_string(v["count_artifact"])
        + " · n_drift=" + to_string(v["count_drift"]))
    println("")
    println("  VERDICT: " + _str(v["verdict"]))
}

// ─── selftest — F-AXIS-MAP-1..5 ──────────────────────────────────────────────

fn write_tmp(path: string, body: string) {
    write_file(path, body)
}

fn run_selftest() -> int {
    let mut pass = 0
    let mut fail = 0

    // F-AXIS-MAP-1: axis count == 7 and ids match {A,B,C,C2,D,E,F}.
    let axes = axis_matrix()
    let mut ids_ok = false
    if len(axes) == 7 {
        let want = ["A","B","C","C2","D","E","F"]
        let mut all_match = true
        let mut k = 0
        while k < 7 {
            if _str(axes[k]["id"]) != _str(want[k]) { all_match = false }
            k = k + 1
        }
        ids_ok = all_match
    }
    if ids_ok {
        println("F-AXIS-MAP-1 AXIS-COUNT PASS (7 axes: A·B·C·C2·D·E·F)")
        pass = pass + 1
    } else {
        println("F-AXIS-MAP-1 AXIS-COUNT FAIL (got " + str(len(axes)) + " axes / id mismatch)")
        fail = fail + 1
    }

    // F-AXIS-MAP-2: expected_cluster mapping matches prior measurement
    //   (A→X, B/F/E→Y, C/C2/D→Z) per AXIS_MAP_RESULTS_UPDATE_5_7.
    let mut cluster_ok = true
    let want_cluster = #{
        "A": "X",
        "B": "Y",
        "C": "Z",
        "C2": "Z",
        "D": "Z",
        "E": "Y",
        "F": "Y"
    }
    let mut i = 0
    while i < len(axes) {
        let ax = axes[i]
        let id = _str(ax["id"])
        let got = _str(ax["expected_cluster"])
        let exp = _str(want_cluster[id])
        if got != exp { cluster_ok = false }
        i = i + 1
    }
    if cluster_ok {
        println("F-AXIS-MAP-2 CLUSTER-MAP PASS (A→X · B/F/E→Y · C/C2/D→Z byte-equal baseline)")
        pass = pass + 1
    } else {
        println("F-AXIS-MAP-2 CLUSTER-MAP FAIL (cluster assignment diverges from prior fire)")
        fail = fail + 1
    }

    // F-AXIS-MAP-3: dispatch cmds use SEPARATE env vars (PR #204 anti-concat).
    //   ✓ form: `env` prefix, then EACH var is its own ` KEY=` token,
    //     no quoted concat blob; axis env-key follows kv separator.
    let cmd = axis_dispatch_cmd(axes[2])  // axis C — P21H_HEAD_G_OBJECTIVE=anima_register_ce
    let has_env_prefix = cmd.index_of("env ") == 0
    let has_steps      = cmd.index_of(" P21H_STEPS=") >= 0
    let has_sigma_sep  = cmd.index_of(" P21H_NOISE_SIGMA=") >= 0
    let has_kv_sep     = cmd.index_of(" P21H_N_KV_HEAD=") >= 0
    let has_axis_env   = cmd.index_of(" P21H_HEAD_G_OBJECTIVE=anima_register_ce") >= 0
    // separation proof: kv token ends with a space before the axis-env token.
    let sep_proof      = cmd.index_of("=4 PROBE_NOISE_SIGMA=") >= 0
    let no_quote_blob  = cmd.index_of("\"P21H") < 0
    let bash_invoke    = cmd.index_of(" bash " + DISPATCH + " ") >= 0
    let init_token     = cmd.index_of(" qwen-warm ") >= 0
    if has_env_prefix && has_steps && has_sigma_sep && has_kv_sep && has_axis_env && sep_proof && no_quote_blob && bash_invoke && init_token {
        println("F-AXIS-MAP-3 ANTI-CONCAT PASS (separate env-var tokens, PR #204 ✓ form)")
        pass = pass + 1
    } else {
        println("F-AXIS-MAP-3 ANTI-CONCAT FAIL (env=" + to_string(has_env_prefix)
            + " steps=" + to_string(has_steps) + " sigma=" + to_string(has_sigma_sep)
            + " kv=" + to_string(has_kv_sep) + " axis_env=" + to_string(has_axis_env)
            + " sep=" + to_string(sep_proof) + " noquote=" + to_string(no_quote_blob)
            + " bash=" + to_string(bash_invoke) + " init=" + to_string(init_token) + ")")
        fail = fail + 1
    }

    // F-AXIS-MAP-4: parse a SYNTHETIC result.json → init_log.L_ce.
    let tmp = "/tmp/axis_map_fan_selftest_result.json"
    write_tmp(tmp, "{\"init_variant\":\"qwen-warm\",\"init_log\":{\"L_ce\":14.4564,\"step\":1},\"verdict\":\"probe\"}")
    let parsed = axis_parse_init_ce(tmp)
    let parse_ok = absf(parsed - 14.4564) < 0.0005
    let missing  = axis_parse_init_ce("/tmp/axis_map_fan_nonexistent_xyz.json")
    let missing_ok = missing < 0.0
    // classify_cluster must label 14.4564 as cluster Z.
    let cl_z = classify_cluster(14.4564) == "Z"
    let cl_y = classify_cluster(14.1780) == "Y"
    let cl_x = classify_cluster(14.7927) == "X"
    let cl_artifact = classify_cluster(12.10) == "12.x"
    let cl_missing  = classify_cluster(-1.0) == "MISSING"
    let cl_other    = classify_cluster(8.0)  == "OTHER"
    let cluster_classify_ok = cl_z && cl_y && cl_x && cl_artifact && cl_missing && cl_other
    if parse_ok && missing_ok && cluster_classify_ok {
        println("F-AXIS-MAP-4 PARSE+CLASSIFY PASS (init_CE=" + fmt4(parsed)
            + " · MISSING→-1.0 · cluster X/Y/Z/12.x/OTHER/MISSING all correct)")
        pass = pass + 1
    } else {
        println("F-AXIS-MAP-4 PARSE+CLASSIFY FAIL (parsed=" + fmt4(parsed)
            + " missing=" + fmt4(missing)
            + " cluster_ok=" + to_string(cluster_classify_ok) + ")")
        fail = fail + 1
    }

    // F-AXIS-MAP-5: H_255 verdict logic on synthetic 4 scenarios:
    //   A) all 7 axes reproduce prior cluster band → H_255.1 FALSIFIED
    //   B) all 7 axes collapse to 12.x → H_255.2 PASS
    //   C) mixed (3 reproduced + 4 artifact) → PARTIAL
    //   D) 1 axis MISSING → DEFERRED
    let mut ra = #{}
    ra["A"]  = 14.79
    ra["B"]  = 14.18
    ra["C"]  = 14.46
    ra["C2"] = 14.46
    ra["D"]  = 14.46
    ra["E"]  = 14.18
    ra["F"]  = 14.18
    let va = axis_verdict(ra)
    let case_a_ok = to_int(va["count_reproduced"]) == 7
        && _str(va["verdict"]).index_of("H_255.1 FALSIFIED") == 0

    let mut rb = #{}
    rb["A"]  = 12.10
    rb["B"]  = 12.20
    rb["C"]  = 11.90
    rb["C2"] = 12.05
    rb["D"]  = 11.95
    rb["E"]  = 12.30
    rb["F"]  = 12.00
    let vb = axis_verdict(rb)
    let case_b_ok = to_int(vb["count_artifact"]) == 7
        && _str(vb["verdict"]).index_of("H_255.2 PASS") == 0

    let mut rc = #{}
    rc["A"]  = 14.79   // X reproduced
    rc["B"]  = 14.18   // Y reproduced
    rc["C"]  = 14.46   // Z reproduced
    rc["C2"] = 12.10   // 12.x artifact
    rc["D"]  = 12.05   // 12.x artifact
    rc["E"]  = 12.20   // 12.x artifact
    rc["F"]  = 11.95   // 12.x artifact
    let vc = axis_verdict(rc)
    let case_c_ok = to_int(vc["count_reproduced"]) == 3
        && to_int(vc["count_artifact"]) == 4
        && _str(vc["verdict"]).index_of("H_255 PARTIAL") == 0

    let mut rd = #{}
    rd["A"]  = 14.79
    rd["B"]  = 14.18
    rd["C"]  = 14.46
    rd["C2"] = 14.46
    rd["D"]  = 14.46
    rd["E"]  = 14.18
    rd["F"]  = -1.0    // MISSING
    let vd = axis_verdict(rd)
    let case_d_ok = to_int(vd["count_MISSING"]) == 1
        && _str(vd["verdict"]).index_of("DEFERRED") == 0

    if case_a_ok && case_b_ok && case_c_ok && case_d_ok {
        println("F-AXIS-MAP-5 VERDICT-LOGIC PASS (H_255.1 · H_255.2 · PARTIAL · DEFERRED)")
        pass = pass + 1
    } else {
        println("F-AXIS-MAP-5 VERDICT-LOGIC FAIL (A=" + to_string(case_a_ok)
            + " B=" + to_string(case_b_ok)
            + " C=" + to_string(case_c_ok)
            + " D=" + to_string(case_d_ok) + ")")
        fail = fail + 1
    }

    println("")
    if fail == 0 {
        println("F-AXIS-MAP-1..5 5/5 PASS")
        return 0
    }
    println("F-AXIS-MAP-1..5 " + str(pass) + "/5 PASS (" + str(fail) + " FAIL)")
    return 1
}

// ─── usage + dispatch ────────────────────────────────────────────────────────

fn print_usage() {
    println("usage: hexa run axis_map_fan_verdict.hexa <verb>")
    println("  axes                   print the 7-axis config matrix")
    println("  dispatch-cmds          print the 7 dispatch commands (PR #204 ✓ form)")
    println("  verdict <result-dir>   parse + render the init_CE + H_255 verdict")
    println("  selftest               F-AXIS-MAP-1..5")
    println("")
    println("  CONTROL-PLANE only — the actual fire runs on GPU pods")
    println("  (train_p21h_v3.py via " + DISPATCH + "); this driver never loads the model.")
}

fn pick_subcmd(argv: array) -> string {
    let n = len(argv)
    let mut i = 0
    while i < n {
        let t = _str(argv[i])
        if t == "selftest" { return "selftest" }
        if t == "axes" { return "axes" }
        if t == "dispatch-cmds" { return "dispatch-cmds" }
        if t == "verdict" { return "verdict" }
        if t == "help" || t == "--help" || t == "-h" { return "help" }
        i = i + 1
    }
    return "selftest"
}

fn arg_after(argv: array, key: string) -> string {
    let n = len(argv)
    let mut i = 0
    while i < n {
        if _str(argv[i]) == key && i + 1 < n { return _str(argv[i + 1]) }
        i = i + 1
    }
    return ""
}

fn main() {
    let argv = args()
    let sub = pick_subcmd(argv)
    if sub == "help" { print_usage(); exit(0) }
    if sub == "axes" { print_axes(); exit(0) }
    if sub == "dispatch-cmds" { print_dispatch_cmds(); exit(0) }
    if sub == "verdict" {
        let dir = arg_after(argv, "verdict")
        if dir == "" { print_usage(); exit(2) }
        print_verdict(dir)
        exit(0)
    }
    let code = run_selftest()
    exit(code)
}
