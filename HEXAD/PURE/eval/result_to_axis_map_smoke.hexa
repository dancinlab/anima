// PURE result_to_axis_map smoke — F-WIRING-1..4 on synthetic fixtures.
// No real Track 1 dep — writes synthetic blobs to /tmp.
// Usage: hexa run HEXAD/PURE/eval/result_to_axis_map_smoke.hexa  (4/4 PASS expected)

import "./result_to_axis_map.hexa"

fn _per_lang(en: str, ko: str, zh: str, ru: str, ja: str) -> list {
    return [
        #{"lang": "en", "verdict": en, "n_score": 16, "n_generalize": 18, "n_lang_coherent": 16},
        #{"lang": "ko", "verdict": ko, "n_score": 14, "n_generalize": 15, "n_lang_coherent": 14},
        #{"lang": "zh", "verdict": zh, "n_score": 12, "n_generalize": 13, "n_lang_coherent": 12},
        #{"lang": "ru", "verdict": ru, "n_score": 13, "n_generalize": 14, "n_lang_coherent": 13},
        #{"lang": "ja", "verdict": ja, "n_score": 12, "n_generalize": 13, "n_lang_coherent": 12}
    ]
}

fn _result(pl: list, agg: str) -> dict {
    return #{
        "verdict": agg, "per_lang_verdicts": pl,
        "n_anima_register_hits_total": 7, "register_regress": false,
        "init_log_ce": 14.4564, "final_log_ce": 2.0990, "train_wall_s": 5222.0
    }
}

fn main() {
    println("[result_to_axis_map_smoke] START")
    let mut n_pass = 0
    let mut n_fail = 0

    // F-WIRING-1: 5/5 STRONG → closure=PASS
    println("--- F-WIRING-1 5/5 STRONG → closure=PASS")
    let p1 = "/tmp/__pure_wiring_smoke_1.json"
    write_file(p1, json_stringify(_result(_per_lang("STRONG", "STRONG", "STRONG", "STRONG", "STRONG"), "HEXAD_V3_WORKS")))
    let r1 = parse_result_json(p1)
    let j1 = judge_closure(r1, "PARTIAL", 4)
    println("  row: " + format_axis_map_row("E2", r1, j1))
    if j1["closure"] == "PASS" && j1["n_pass"] == 5 {
        println("  PASS closure=PASS n_pass=5"); n_pass = n_pass + 1
    } else {
        println("  FAIL closure=" + j1["closure"] + " n_pass=" + to_string(j1["n_pass"])); n_fail = n_fail + 1
    }

    // F-WIRING-2: 3/5 PARTIAL + 2 WEAK → closure=FAIL (criterion <4/5)
    println("--- F-WIRING-2 3/5 PARTIAL + 2 WEAK → closure=FAIL")
    let p2 = "/tmp/__pure_wiring_smoke_2.json"
    write_file(p2, json_stringify(_result(_per_lang("PARTIAL", "PARTIAL", "PARTIAL", "WEAK", "WEAK"), "PARTIAL")))
    let r2 = parse_result_json(p2)
    let j2 = judge_closure(r2, "PARTIAL", 4)
    println("  row: " + format_axis_map_row("E3", r2, j2))
    if j2["closure"] == "FAIL" && j2["n_pass"] == 3 {
        println("  PASS closure=FAIL n_pass=3 < 4"); n_pass = n_pass + 1
    } else {
        println("  FAIL closure=" + j2["closure"] + " n_pass=" + to_string(j2["n_pass"])); n_fail = n_fail + 1
    }

    // F-WIRING-3: missing file → parse_result_json exit(2) contract (precondition file_exists=false)
    println("--- F-WIRING-3 missing result.json → file_exists()=false")
    let fake = "/tmp/__pure_wiring_missing_xxxxxx.json"
    if !file_exists(fake) {
        println("  PASS file_exists() reports false (parse_result_json would exit 2)"); n_pass = n_pass + 1
    } else {
        println("  FAIL fake file unexpectedly exists at " + fake); n_fail = n_fail + 1
    }

    // F-WIRING-4: nested CE schema (real Track-1 shape) — init_log.L_ce + final_log.L_ce render (not "—")
    println("--- F-WIRING-4 nested init_log.L_ce + final_log.L_ce → row contains 14.18 + 0.98")
    let p4 = "/tmp/__pure_wiring_smoke_4.json"
    let nested = #{
        "verdict": "HEXAD_V3_WORKS",
        "per_lang_verdicts": _per_lang("STRONG", "STRONG", "STRONG", "STRONG", "STRONG"),
        "n_anima_register_hits_total": 4, "register_regress": false,
        "init_log": #{"step": 1, "L_ce": 14.18, "L_total": 14.18},
        "final_log": #{"step": 5000, "L_ce": 0.98, "L_total": 0.98},
        "train_wall_s": 2105.83
    }
    write_file(p4, json_stringify(nested))
    let r4 = parse_result_json(p4)
    let j4 = judge_closure(r4, "PARTIAL", 4)
    let row4 = format_axis_map_row("E2", r4, j4)
    println("  row: " + row4)
    // Targeted check: init CE 14.18 + final CE 0.98 rendered (substring presence).
    // PR-#287 wiring adds two trailing corpus_quality columns (M3 TTR, M5 hangul) that
    // render '—' when absent — the prior `!contains "| — | — |"` guard was retired
    // because absence-of-corpus_quality is now expected back-compat behavior.
    if contains(row4, "14.18") && contains(row4, "0.98") && contains(row4, "| 2105.83 |") {
        println("  PASS nested CE rendered (14.18 + 0.98) + wall 2105.83 anchor"); n_pass = n_pass + 1
    } else {
        println("  FAIL nested CE not rendered — row: " + row4); n_fail = n_fail + 1
    }

    // F-WIRING-5: corpus_quality block embedded (PR #287 wiring) — M3 TTR + M5 hangul render
    // as numerics from the corpus_quality block instead of "—". Back-compat tested by F-WIRING-1..4
    // (none of those carry corpus_quality, so their M3/M5 columns are dashes — already passing).
    println("--- F-WIRING-5 corpus_quality block → M3 TTR + M5 hangul rendered numeric (PR #287)")
    let p5 = "/tmp/__pure_wiring_smoke_5.json"
    let with_cq = #{
        "verdict": "HEXAD_V3_WORKS",
        "per_lang_verdicts": _per_lang("STRONG", "STRONG", "STRONG", "STRONG", "STRONG"),
        "n_anima_register_hits_total": 4, "register_regress": false,
        "init_log": #{"step": 1, "L_ce": 14.18, "L_total": 14.18},
        "final_log": #{"step": 5000, "L_ce": 0.98, "L_total": 0.98},
        "train_wall_s": 2105.83,
        "corpus_quality": #{
            "path": "/tmp/syn_corpus.jsonl", "n_bytes": 12345, "n_lines": 42, "sample_bytes": 1000000,
            "m1_entropy": 5.1234, "m2_bigram_mi": 3.7654,
            "m3_ttr": 0.61234, "m4_avg_line": 78.5,
            "m5_hangul": 0.04321, "m6_kl_uniform": 2.8765
        }
    }
    write_file(p5, json_stringify(with_cq))
    let r5 = parse_result_json(p5)
    let j5 = judge_closure(r5, "PARTIAL", 4)
    let row5 = format_axis_map_row("E2-cq", r5, j5)
    println("  row: " + row5)
    // Trailing `| 0.61234 | 0.04321 |` proves both columns render via _corpus_cell lookup.
    if contains(row5, "| 0.61234 | 0.04321 |") {
        println("  PASS M3=0.61234 + M5=0.04321 rendered from corpus_quality block")
        n_pass = n_pass + 1
    } else {
        println("  FAIL M3+M5 not rendered — row: " + row5)
        n_fail = n_fail + 1
    }

    // F-WIRING-6: back-compat — a result.json WITHOUT corpus_quality still renders fine,
    // M3+M5 trail as "—". This is what FRESHly-emitted closure-fire result.json looks like
    // BEFORE the operator passes `--corpus <path>` on next emit (gradual rollout).
    println("--- F-WIRING-6 back-compat: result.json WITHOUT corpus_quality → M3 + M5 as '—'")
    let row1_trail_ok = contains(row4, "| 2105.83 | — | — |")
    if row1_trail_ok {
        println("  PASS legacy F-WIRING-4 row trails as '| 2105.83 | — | — |' (back-compat)")
        n_pass = n_pass + 1
    } else {
        println("  FAIL legacy row missing trailing '— —' columns — row: " + row4)
        n_fail = n_fail + 1
    }

    println("[result_to_axis_map_smoke] END: " + to_string(n_pass) + "/6 PASS, " + to_string(n_fail) + " FAIL")
    if n_fail > 0 { exit(1) }
}
