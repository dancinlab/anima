// PURE corpus quality probe — 6-metric scorer wrapping anima-engines/P22.
//
// Mirror of `anima-engines/corpus_quality_engine.hexa` (CLM-P22-1, P22 of
// the 165-engine set). The engine is a closed self-test on a fixed synthetic
// panel; this wrapper exposes the same 6 candidate metrics as callable
// functions over arbitrary corpus paths so closure-fire launchers can
// quantify Track 1 E2 vs E3 wiki_frac quality gap from the corpus side.
//
// HONEST C3 — re-implements the 6 metrics minimally in modern PURE idiom
// (`str` / `&&` / `ord(ch[0])` / `read_file`) instead of `import`-ing the
// engine. Engine uses an older convention (`string` / `[float]`) AND
// auto-invokes `test()` at EOF; importing would print 6 panel self-test
// lines per call. Same metric math, modern call surface.
//
// CLI:
//   hexa run HEXAD/PURE/eval/corpus_quality_probe.hexa selftest
//   hexa run HEXAD/PURE/eval/corpus_quality_probe.hexa score <path> [--sample-bytes N] [--out json]
//   hexa run HEXAD/PURE/eval/corpus_quality_probe.hexa compare <a> <b> [--sample-bytes N] [--out json]
//
// Philosophy: p7 NO PERPLEXITY VERDICT (observe bytes only) · Law 2 observe-never-inject.

fn _log2(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut y = x
    let mut e = 0.0
    while y > 2.0 { y = y / 2.0  e = e + 1.0 }
    while y < 0.5 { y = y * 2.0  e = e - 1.0 }
    let u = y - 1.0
    let u2 = u * u
    let ln_y = u - u2 * 0.5 + u2 * u / 3.0 - u2 * u2 * 0.25 + u2 * u2 * u * 0.2
    return e + ln_y / 0.6931471805599453
}

fn _read_sample(path: str, sample_bytes: int) -> str {
    if !file_exists(path) {
        println("[corpus_quality_probe] ERROR file not found: " + path)
        exit(2)
    }
    let raw = read_file(path)
    if sample_bytes <= 0 { return raw }
    if len(raw) <= sample_bytes { return raw }
    return raw.substring(0, sample_bytes)
}

// Byte histogram → parallel [keys, counts] lists.
fn _byte_hist(text: str) -> list {
    let n = len(text)
    let mut ks: list = []
    let mut cs: list = []
    let mut i = 0
    while i < n {
        let b = ord(text[i])
        let mut f = -1
        let mut j = 0
        let m = len(ks)
        while j < m { if ks[j] == b { f = j }  j = j + 1 }
        if f == -1 { ks = ks + [b]  cs = cs + [1] } else { cs[f] = cs[f] + 1 }
        i = i + 1
    }
    return [ks, cs]
}

// M1 BYTE_ENTROPY — Shannon over byte freq.
fn metric_byte_entropy(text: str) -> float {
    let n = len(text)
    if n < 2 { return 0.0 }
    let hc = _byte_hist(text)
    let cs = hc[1]
    let total = (n + 0.0)
    let mut h = 0.0
    let mut k = 0
    let nk = len(cs)
    while k < nk { let p = (cs[k] + 0.0) / total  if p > 0.0 { h = h - p * _log2(p) }  k = k + 1 }
    return h
}

// M2 BIGRAM_MI — mutual info between consecutive bytes, capped @ 512.
fn metric_bigram_mi(text: str) -> float {
    let n = len(text)
    if n < 4 { return 0.0 }
    let cap = if n < 512 { n } else { 512 }
    let mut bg: list = []
    let mut bc: list = []
    let mut ug: list = []
    let mut uc: list = []
    let mut i = 0
    while i < cap - 1 {
        let x = ord(text[i])
        let y = ord(text[i + 1])
        let key = x * 256 + y
        let mut f1 = -1
        let mut j = 0
        let mb = len(bg)
        while j < mb { if bg[j] == key { f1 = j }  j = j + 1 }
        if f1 == -1 { bg = bg + [key]  bc = bc + [1] } else { bc[f1] = bc[f1] + 1 }
        let mut f2 = -1
        let mut k = 0
        let mu = len(ug)
        while k < mu { if ug[k] == x { f2 = k }  k = k + 1 }
        if f2 == -1 { ug = ug + [x]  uc = uc + [1] } else { uc[f2] = uc[f2] + 1 }
        i = i + 1
    }
    let tb = (cap - 1 + 0.0)
    let mut mi = 0.0
    let mut m = 0
    let nbg = len(bg)
    while m < nbg {
        let key = bg[m]
        let xp = key / 256
        let yp = key % 256
        let p_xy = (bc[m] + 0.0) / tb
        let mut px = 0.0
        let mut py = 0.0
        let mut q = 0
        let mq = len(ug)
        while q < mq {
            if ug[q] == xp { px = (uc[q] + 0.0) / tb }
            if ug[q] == yp { py = (uc[q] + 0.0) / tb }
            q = q + 1
        }
        if p_xy > 0.0 && px > 0.0 && py > 0.0 {
            let r = p_xy / (px * py)
            if r > 0.0 { mi = mi + p_xy * _log2(r) }
        }
        m = m + 1
    }
    return mi
}

// M3 TOKEN_DIVERSITY — TTR over whitespace tokens.
fn metric_token_diversity(text: str) -> float {
    let toks = text.split(" ")
    let n = len(toks)
    if n == 0 { return 0.0 }
    let mut uniq: list = []
    let mut i = 0
    while i < n {
        let t = toks[i]
        if t != "" {
            let mut found = false
            let mut j = 0
            let mu = len(uniq)
            while j < mu { if uniq[j] == t { found = true }  j = j + 1 }
            if !found { uniq = uniq + [t] }
        }
        i = i + 1
    }
    return (len(uniq) + 0.0) / (n + 0.0)
}

// M4 AVG_LINE_LENGTH — mean non-empty line length (bytes).
fn metric_avg_line_length(text: str) -> float {
    let lines = text.split("\n")
    let n = len(lines)
    let mut tot = 0
    let mut ct = 0
    let mut i = 0
    while i < n { if lines[i] != "" { tot = tot + len(lines[i])  ct = ct + 1 }  i = i + 1 }
    if ct == 0 { return 0.0 }
    return (tot + 0.0) / (ct + 0.0)
}

// M5 HANGUL_COVERAGE — distinct Hangul syllable triplets / 2350 (KS X 1001).
fn metric_hangul_coverage(text: str) -> float {
    let n = len(text)
    let mut seen: list = []
    let mut i = 0
    while i + 2 < n {
        let b0 = ord(text[i])
        if b0 >= 234 && b0 <= 237 {
            let b1 = ord(text[i + 1])
            let b2 = ord(text[i + 2])
            if b1 >= 128 && b1 <= 191 && b2 >= 128 && b2 <= 191 {
                let tri = b0 * 65536 + b1 * 256 + b2
                let mut found = false
                let mut j = 0
                let ms = len(seen)
                while j < ms { if seen[j] == tri { found = true }  j = j + 1 }
                if !found { seen = seen + [tri] }
            }
        }
        i = i + 1
    }
    return (len(seen) + 0.0) / 2350.0
}

// M6 KL_TO_UNIFORM — KL(P_byte || U_256); higher = more skewed.
fn metric_kl_to_uniform(text: str) -> float {
    let n = len(text)
    if n < 2 { return 0.0 }
    let hc = _byte_hist(text)
    let cs = hc[1]
    let total = (n + 0.0)
    let q = 1.0 / 256.0
    let mut kl = 0.0
    let mut k = 0
    let nk = len(cs)
    while k < nk { let p = (cs[k] + 0.0) / total  if p > 0.0 { kl = kl + p * _log2(p / q) }  k = k + 1 }
    return kl
}

fn score_corpus_jsonl(path: str, sample_bytes: int) -> dict {
    let raw = _read_sample(path, sample_bytes)
    let lines = raw.split("\n")
    let mut nl = 0
    let mut i = 0
    let nn = len(lines)
    while i < nn { if lines[i] != "" { nl = nl + 1 }  i = i + 1 }
    return #{
        "path": path, "n_bytes": len(raw), "n_lines": nl, "sample_bytes": sample_bytes,
        "m1_entropy": metric_byte_entropy(raw), "m2_bigram_mi": metric_bigram_mi(raw),
        "m3_ttr": metric_token_diversity(raw), "m4_avg_line": metric_avg_line_length(raw),
        "m5_hangul": metric_hangul_coverage(raw), "m6_kl_uniform": metric_kl_to_uniform(raw)
    }
}

fn compare_corpora(path_a: str, path_b: str, sample_bytes: int) -> dict {
    let a = score_corpus_jsonl(path_a, sample_bytes)
    let b = score_corpus_jsonl(path_b, sample_bytes)
    return #{ "a": a, "b": b, "diff": #{
        "m1_entropy":    b["m1_entropy"]    - a["m1_entropy"],
        "m2_bigram_mi":  b["m2_bigram_mi"]  - a["m2_bigram_mi"],
        "m3_ttr":        b["m3_ttr"]        - a["m3_ttr"],
        "m4_avg_line":   b["m4_avg_line"]   - a["m4_avg_line"],
        "m5_hangul":     b["m5_hangul"]     - a["m5_hangul"],
        "m6_kl_uniform": b["m6_kl_uniform"] - a["m6_kl_uniform"]
    }}
}

// _cqp_arg_kv / _cqp_argv_user / _cqp_usage — namespaced (`_cqp_*`) so this
// file can be `import`-ed by multilingual_probe.hexa (PR #240) without the
// generic `_arg_kv` / `_argv_user` / `_usage` defs shadowing the caller's
// same-named helpers. Imported defs override caller defs on name collision;
// the namespaced names keep the import side-effect-free.
fn _cqp_arg_kv(argv: list, key: str, dv: str) -> str {
    let n = len(argv)
    let mut i = 0
    while i < n { if argv[i] == key && (i + 1) < n { return argv[i + 1] }  i = i + 1 }
    return dv
}

fn _cqp_argv_user() -> list {
    let a = args()
    let n = len(a)
    if n <= 1 { return [] }
    let mut out = []
    let mut i = 1
    while i < n { out = out + [a[i]]  i = i + 1 }
    return out
}

fn _print_score(s: dict) {
    println("[corpus_quality_probe] " + s["path"] + " · n_bytes=" + to_string(s["n_bytes"]) + " n_lines=" + to_string(s["n_lines"]))
    println("  M1 BYTE_ENTROPY    = " + to_string(s["m1_entropy"]))
    println("  M2 BIGRAM_MI       = " + to_string(s["m2_bigram_mi"]))
    println("  M3 TOKEN_DIVERSITY = " + to_string(s["m3_ttr"]))
    println("  M4 AVG_LINE_LENGTH = " + to_string(s["m4_avg_line"]))
    println("  M5 HANGUL_COVERAGE = " + to_string(s["m5_hangul"]))
    println("  M6 KL_TO_UNIFORM   = " + to_string(s["m6_kl_uniform"]))
}

fn _selftest() -> int {
    println("[corpus_quality_probe] selftest START")
    let raw = "the quick brown fox jumps over\n안녕하세요 반갑습니다\naaaa aaaa aaaa\n"
    let h = metric_byte_entropy(raw)
    let mi = metric_bigram_mi(raw)
    let ttr = metric_token_diversity(raw)
    let avg = metric_avg_line_length(raw)
    let hg = metric_hangul_coverage(raw)
    let kl = metric_kl_to_uniform(raw)
    let mut ok = true
    if !(h > 0.0 && h < 8.1) { ok = false  println("  FAIL M1 range: " + to_string(h)) }
    if !(mi >= 0.0 && mi < 16.0) { ok = false  println("  FAIL M2 range: " + to_string(mi)) }
    if !(ttr > 0.0 && ttr <= 1.0) { ok = false  println("  FAIL M3 range: " + to_string(ttr)) }
    if !(avg > 0.0) { ok = false  println("  FAIL M4 non-positive: " + to_string(avg)) }
    if !(hg > 0.0) { ok = false  println("  FAIL M5 zero on hangul input: " + to_string(hg)) }
    if !(kl >= 0.0) { ok = false  println("  FAIL M6 negative: " + to_string(kl)) }
    if ok { println("  PASS 6/6 metrics in range on synthetic mix-line corpus")  return 0 }
    return 1
}

fn _cqp_usage() {
    println("USAGE:")
    println("  hexa run HEXAD/PURE/eval/corpus_quality_probe.hexa selftest")
    println("  hexa run HEXAD/PURE/eval/corpus_quality_probe.hexa score <path> [--sample-bytes N] [--out json]")
    println("  hexa run HEXAD/PURE/eval/corpus_quality_probe.hexa compare <a> <b> [--sample-bytes N] [--out json]")
}

fn main() {
    let argv = _cqp_argv_user()
    let n = len(argv)
    if n == 0 { _cqp_usage()  return }
    let mode = argv[0]
    if mode == "selftest" { let rc = _selftest()  if rc != 0 { exit(rc) }  return }
    if mode == "score" {
        if n < 2 { println("[corpus_quality_probe] ERROR score requires <path>")  exit(2) }
        let s = score_corpus_jsonl(argv[1], to_int(_cqp_arg_kv(argv, "--sample-bytes", "1000000")))
        _print_score(s)
        let out = _cqp_arg_kv(argv, "--out", "")
        if out != "" { write_file(out, json_stringify(s))  println("[corpus_quality_probe] wrote " + out) }
        return
    }
    if mode == "compare" {
        if n < 3 { println("[corpus_quality_probe] ERROR compare requires <a> <b>")  exit(2) }
        let c = compare_corpora(argv[1], argv[2], to_int(_cqp_arg_kv(argv, "--sample-bytes", "1000000")))
        _print_score(c["a"])
        _print_score(c["b"])
        let d = c["diff"]
        println("[corpus_quality_probe] diff (b - a):")
        println("  ΔM1=" + to_string(d["m1_entropy"]) + "  ΔM2=" + to_string(d["m2_bigram_mi"]) + "  ΔM3=" + to_string(d["m3_ttr"]))
        println("  ΔM4=" + to_string(d["m4_avg_line"]) + "  ΔM5=" + to_string(d["m5_hangul"]) + "  ΔM6=" + to_string(d["m6_kl_uniform"]))
        let out = _cqp_arg_kv(argv, "--out", "")
        if out != "" { write_file(out, json_stringify(c))  println("[corpus_quality_probe] wrote " + out) }
        return
    }
    _cqp_usage()
    exit(2)
}
