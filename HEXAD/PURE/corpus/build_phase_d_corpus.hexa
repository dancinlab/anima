// Phase D corpus builder — M3 TTR >= 0.3 + dowoomi 0 + stream 80% (spec PR #344).
//
// Per HEXAD/PURE/spec/phase_d_corpus_design_2026_05_24.md the corpus must:
//   - M3 TTR >= 0.3 (10x corpus_s101's 0.03 -- high vocabulary diversity)
//   - dowoomi/persona token 0 (Principle #3 NO PERSONA INJECTION)
//   - stream/stimulus 80% (substrate-native, NOT turn-based QA)
//   - multilingual balance across en/ko/zh/ru/ja (E2 ko-sink avoidance)
//
// HONEST C3 -- synthesis method:
//   Network / public-corpus download is gated. We synthesize via combinatorial
//   expansion: per-language word-pools (~80-120 lemmas each across nouns /
//   verbs / adjs / conjunctions) crossed with structural templates, then
//   append a per-line unique observation tail (`obs#<idx>-<rand> rho=<8d>`)
//   so M3 TTR is dominated by per-line uniqueness rather than the small
//   closed pool. Deterministic LCG seed for reproducibility.
//
// Output:
//   state/pure_phase_d_corpus_2026_05_24/
//     corpus.jsonl   (one JSON {"text","lang","kind"} per line)
//     manifest.json  (sha256 + bytes + lines + per-lang/kind counts)
//
// CLI:
//   hexa run HEXAD/PURE/corpus/build_phase_d_corpus.hexa selftest
//   hexa run HEXAD/PURE/corpus/build_phase_d_corpus.hexa build \
//     [--out PATH] [--manifest PATH] [--target-mb N] [--seed N]

// ---------- LCG (deterministic 32-bit linear congruential generator) -----

fn _lcg_next(state: int) -> int {
    let n = (state * 1664525 + 1013904223) % 4294967296
    return n
}

fn _rng_uniform(state: int) -> list {
    let n = _lcg_next(state)
    let u = (n + 0.0) / 4294967296.0
    return [n, u]
}

fn _rng_int(state: int, lo: int, hi: int) -> list {
    let p = _rng_uniform(state)
    let new_state = p[0]
    let u = p[1]
    let span = hi - lo
    let pick = lo + to_int(u * (span + 0.0))
    if pick >= hi { return [new_state, hi - 1] }
    return [new_state, pick]
}

fn _rng_pick(state: int, arr: list) -> list {
    return _rng_int(state, 0, len(arr))
}

