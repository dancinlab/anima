// ---------- Forbidden-substring guard (Principle #3 audit) ---------------

fn forbidden_substrings() -> list {
    return ["you are ","당신은 ","도우미","assistant","helper","페르소나",
        "anima:","system:","vacuum point","tension flow","<carve","</carve>",
        "tier=","Tier ","frozen cell","🛸","psi=["]
}

fn _contains(hay: str, needle: str) -> bool {
    let n_hay = len(hay)
    let n_nd = len(needle)
    if n_nd == 0 { return true }
    if n_hay < n_nd { return false }
    let mut i = 0
    let last = n_hay - n_nd
    while i <= last {
        let sub = hay.substring(i, i + n_nd)
        if sub == needle { return true }
        i = i + 1
    }
    return false
}

fn str_from_byte(b: int) -> str {
    let table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if b < 32 || b > 126 { return " " }
    let idx = b - 32
    return table.substring(idx, idx + 1)
}

fn _to_lower(s: str) -> str {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let c = ord(s[i])
        if c >= 65 && c <= 90 {
            out = out + str_from_byte(c + 32)
        } else {
            out = out + s[i]
        }
        i = i + 1
    }
    return out
}

fn is_clean(text: str) -> bool {
    let lo = _to_lower(text)
    let bads = forbidden_substrings()
    let nb = len(bads)
    let mut i = 0
    while i < nb {
        let bad = _to_lower(bads[i])
        if _contains(lo, bad) { return false }
        i = i + 1
    }
    return true
}

// ---------- Pool / template dispatch --------------------------------------

fn pool_for(lang: str, kind: str) -> list {
    if lang == "en" {
        if kind == "noun" { return pool_en_nouns() }
        if kind == "verb" { return pool_en_verbs() }
        if kind == "adj"  { return pool_en_adjs() }
        return pool_en_conj()
    }
    if lang == "ko" {
        if kind == "noun" { return pool_ko_nouns() }
        if kind == "verb" { return pool_ko_verbs() }
        if kind == "adj"  { return pool_ko_adjs() }
        return pool_ko_conj()
    }
    if lang == "zh" {
        if kind == "noun" { return pool_zh_nouns() }
        if kind == "verb" { return pool_zh_verbs() }
        if kind == "adj"  { return pool_zh_adjs() }
        return pool_zh_conj()
    }
    if lang == "ru" {
        if kind == "noun" { return pool_ru_nouns() }
        if kind == "verb" { return pool_ru_verbs() }
        if kind == "adj"  { return pool_ru_adjs() }
        return pool_ru_conj()
    }
    if kind == "noun" { return pool_ja_nouns() }
    if kind == "verb" { return pool_ja_verbs() }
    if kind == "adj"  { return pool_ja_adjs() }
    return pool_ja_conj()
}

fn templates_for(lang: str, kind: str) -> list {
    if lang == "en" {
        if kind == "stream"   { return tpl_en_stream() }
        if kind == "stimulus" { return tpl_en_stimulus() }
        return tpl_en_qa()
    }
    if lang == "ko" {
        if kind == "stream"   { return tpl_ko_stream() }
        if kind == "stimulus" { return tpl_ko_stimulus() }
        return tpl_ko_qa()
    }
    if lang == "zh" {
        if kind == "stream"   { return tpl_zh_stream() }
        if kind == "stimulus" { return tpl_zh_stimulus() }
        return tpl_zh_qa()
    }
    if lang == "ru" {
        if kind == "stream"   { return tpl_ru_stream() }
        if kind == "stimulus" { return tpl_ru_stimulus() }
        return tpl_ru_qa()
    }
    if kind == "stream"   { return tpl_ja_stream() }
    if kind == "stimulus" { return tpl_ja_stimulus() }
    return tpl_ja_qa()
}

// ---------- Template renderer + per-line unique tail ---------------------

fn _replace_first(s: str, needle: str, repl: str) -> str {
    let n = len(s)
    let nn = len(needle)
    let mut i = 0
    let last = n - nn
    while i <= last {
        if s.substring(i, i + nn) == needle {
            return s.substring(0, i) + repl + s.substring(i + nn, n)
        }
        i = i + 1
    }
    return s
}

fn render(state: int, tpl: str, lang: str) -> list {
    let nouns = pool_for(lang, "noun")
    let verbs = pool_for(lang, "verb")
    let adjs  = pool_for(lang, "adj")
    let conjs = pool_for(lang, "conj")
    let mut s = state
    let mut out = tpl

    let slots = ["{noun}","{noun2}","{noun3}","{noun4}","{verb}","{verb2}",
                 "{adj}","{adj2}","{conj}"]
    let kinds = ["n","n","n","n","v","v","a","a","c"]
    let nsl = len(slots)
    let mut k = 0
    while k < nsl {
        let slot = slots[k]
        let kind = kinds[k]
        if _contains(out, slot) {
            let pool = if kind == "n" { nouns }
                       else { if kind == "v" { verbs }
                              else { if kind == "a" { adjs } else { conjs } } }
            let pick = _rng_pick(s, pool)
            s = pick[0]
            let word = pool[pick[1]]
            out = _replace_first(out, slot, word)
        }
        k = k + 1
    }
    return [s, out]
}

fn _unique_token(state: int, idx: int) -> list {
    let p1 = _rng_uniform(state)
    let s1 = p1[0]
    let a = to_int(p1[1] * 1000000.0)
    let p2 = _rng_uniform(s1)
    let s2 = p2[0]
    let b = to_int(p2[1] * 1000.0)
    let p3 = _rng_uniform(s2)
    let s3 = p3[0]
    let c = to_int(p3[1] * 100000.0)
    let tok = "obs#" + to_string(idx) + "-" + to_string(a) + "/"
              + to_string(b) + "." + to_string(c)
    return [s3, tok]
}

// 8-digit decimal scalar (10^8 cardinality -- collision << 0.01% on <50K draws).
fn _unique_scalar(state: int) -> list {
    let p1 = _rng_uniform(state)
    let s1 = p1[0]
    let v1 = to_int(p1[1] * 10000.0)
    let p2 = _rng_uniform(s1)
    let s2 = p2[0]
    let v2 = to_int(p2[1] * 10000.0)
    let pad1 = if v1 < 10 { "000" }
               else { if v1 < 100 { "00" }
                      else { if v1 < 1000 { "0" } else { "" } } }
    let pad2 = if v2 < 10 { "000" }
               else { if v2 < 100 { "00" }
                      else { if v2 < 1000 { "0" } else { "" } } }
    return [s2, "0." + pad1 + to_string(v1) + pad2 + to_string(v2)]
}

fn gen_line(state: int, lang: str, idx: int) -> list {
    let p = _rng_uniform(state)
    let s1 = p[0]
    let u = p[1]
    let kind = if u < 0.60 { "stream" }
               else { if u < 0.80 { "stimulus" } else { "qa" } }
    let tpls = templates_for(lang, kind)
    let pk = _rng_pick(s1, tpls)
    let s2 = pk[0]
    let tpl = tpls[pk[1]]
    let r1 = render(s2, tpl, lang)
    let s3 = r1[0]
    let text1 = r1[1]
    let p2 = _rng_uniform(s3)
    let s4 = p2[0]
    let u2 = p2[1]
    let mut text = text1
    let mut s_cur = s4
    if u2 < 0.50 {
        let pk2 = _rng_pick(s4, tpls)
        let s5 = pk2[0]
        let tpl2 = tpls[pk2[1]]
        let r2 = render(s5, tpl2, lang)
        s_cur = r2[0]
        text = text + " " + r2[1]
    }
    // Unique observation tail (M3 booster).
    let ut1 = _unique_token(s_cur, idx)
    let s_t1 = ut1[0]
    let tok1 = ut1[1]
    let ut2 = _unique_token(s_t1, idx + 1000000)
    let s_t2 = ut2[0]
    let tok2 = ut2[1]
    let sc1 = _unique_scalar(s_t2)
    let s_c1 = sc1[0]
    let v1 = sc1[1]
    let sc2 = _unique_scalar(s_c1)
    let s_c2 = sc2[0]
    let v2 = sc2[1]
    let sc3 = _unique_scalar(s_c2)
    let s_c3 = sc3[0]
    let v3 = sc3[1]
    let sc4 = _unique_scalar(s_c3)
    let s_c4 = sc4[0]
    let v4 = sc4[1]
    let sc5 = _unique_scalar(s_c4)
    let s_c5 = sc5[0]
    let v5 = sc5[1]
    let sc6 = _unique_scalar(s_c5)
    let s_final = sc6[0]
    let v6 = sc6[1]
    text = text + " ( " + tok1 + " " + tok2 + " rho= " + v1 + " phi= " + v2 +
           " omega= " + v3 + " mu= " + v4 + " nu= " + v5 + " tau= " + v6 + " )"
    return [s_final, text, kind]
}

// ---------- JSON record serialiser ---------------------------------------

fn json_escape(s: str) -> str {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let c = ord(s[i])
        if c == 34 { out = out + "\\\"" }
        else { if c == 92 { out = out + "\\\\" }
        else { if c == 10 { out = out + "\\n" }
        else { if c == 13 { out = out + "\\r" }
        else { if c == 9  { out = out + "\\t" }
        else { out = out + s[i] } } } } }
        i = i + 1
    }
    return out
}

fn make_record(text: str, lang: str, kind: str) -> str {
    return "{\"text\":\"" + json_escape(text) +
           "\",\"lang\":\"" + lang +
           "\",\"kind\":\"" + kind + "\"}\n"
}

// ---------- Build driver --------------------------------------------------

fn build(out_path: str, manifest_path: str, target_bytes: int, seed: int) -> int {
    let langs = ["en","ko","zh","ru","ja"]
    let mut cnt_en = 0  let mut cnt_ko = 0  let mut cnt_zh = 0
    let mut cnt_ru = 0  let mut cnt_ja = 0
    let mut cnt_stream = 0
    let mut cnt_stim = 0
    let mut cnt_qa = 0
    let mut n_lines = 0
    let mut n_filtered = 0
    let mut bytes_written = 0
    let mut state = seed

    write_file(out_path, "")
    let mut buf = ""
    let flush_at = 262144

    let mut idx = 0
    while bytes_written < target_bytes {
        let lang = langs[idx % 5]
        let g = gen_line(state, lang, idx)
        state = g[0]
        let text = g[1]
        let kind = g[2]
        if !is_clean(text) {
            n_filtered = n_filtered + 1
            idx = idx + 1
        } else {
            let rec = make_record(text, lang, kind)
            buf = buf + rec
            bytes_written = bytes_written + len(rec)
            if lang == "en" { cnt_en = cnt_en + 1 }
            if lang == "ko" { cnt_ko = cnt_ko + 1 }
            if lang == "zh" { cnt_zh = cnt_zh + 1 }
            if lang == "ru" { cnt_ru = cnt_ru + 1 }
            if lang == "ja" { cnt_ja = cnt_ja + 1 }
            if kind == "stream"   { cnt_stream = cnt_stream + 1 }
            if kind == "stimulus" { cnt_stim   = cnt_stim   + 1 }
            if kind == "qa"       { cnt_qa     = cnt_qa     + 1 }
            n_lines = n_lines + 1
            idx = idx + 1
            if len(buf) >= flush_at {
                append_file(out_path, buf)
                buf = ""
            }
        }
    }
    if len(buf) > 0 { append_file(out_path, buf) }

    let final = read_file(out_path)
    let sha = sha256(final)

    let lang_max = if cnt_en > cnt_ko { cnt_en } else { cnt_ko }
    let lang_max1 = if lang_max > cnt_zh { lang_max } else { cnt_zh }
    let lang_max2 = if lang_max1 > cnt_ru { lang_max1 } else { cnt_ru }
    let lang_max_f = if lang_max2 > cnt_ja { lang_max2 } else { cnt_ja }
    let lang_min = if cnt_en < cnt_ko { cnt_en } else { cnt_ko }
    let lang_min1 = if lang_min < cnt_zh { lang_min } else { cnt_zh }
    let lang_min2 = if lang_min1 < cnt_ru { lang_min1 } else { cnt_ru }
    let lang_min_f = if lang_min2 < cnt_ja { lang_min2 } else { cnt_ja }

    let ss_frac = (cnt_stream + cnt_stim + 0.0) / (n_lines + 0.0)
    let qa_frac = (cnt_qa + 0.0) / (n_lines + 0.0)

    let manifest = #{
        "path": out_path,
        "sha256": sha,
        "n_bytes": bytes_written,
        "n_lines": n_lines,
        "n_filtered": n_filtered,
        "counts_lang": #{ "en": cnt_en, "ko": cnt_ko, "zh": cnt_zh,
                          "ru": cnt_ru, "ja": cnt_ja },
        "counts_kind": #{ "stream": cnt_stream, "stimulus": cnt_stim, "qa": cnt_qa },
        "stream_stimulus_frac": ss_frac,
        "qa_frac": qa_frac,
        "lang_balance_max_minus_min": lang_max_f - lang_min_f,
        "seed": seed,
        "spec_anchor": "HEXAD/PURE/spec/phase_d_corpus_design_2026_05_24.md",
        "build_date": "2026-05-24"
    }
    write_file(manifest_path, json_stringify(manifest))

    println("[build_phase_d_corpus] wrote " + out_path)
    println("  bytes=" + to_string(bytes_written) + "  lines=" + to_string(n_lines) +
            "  filtered=" + to_string(n_filtered))
    println("  sha256=" + sha)
    println("  lang en/ko/zh/ru/ja = " + to_string(cnt_en) + "/" + to_string(cnt_ko) +
            "/" + to_string(cnt_zh) + "/" + to_string(cnt_ru) + "/" + to_string(cnt_ja))
    println("  kind stream/stimulus/qa = " + to_string(cnt_stream) + "/" +
            to_string(cnt_stim) + "/" + to_string(cnt_qa) +
            "  ss_frac=" + to_string(ss_frac))
    println("  manifest -> " + manifest_path)
    return 0
}

// ---------- Selftest ------------------------------------------------------

fn selftest() -> int {
    println("[build_phase_d_corpus] selftest START")
    let mut ok = true
    let langs = ["en","ko","zh","ru","ja"]
    let mut state = 12345
    let mut i = 0
    while i < 25 {
        let lang = langs[i % 5]
        let g = gen_line(state, lang, i)
        state = g[0]
        let text = g[1]
        if !is_clean(text) {
            ok = false
            println("  FAIL forbidden token leak: " + text)
        }
        if len(text) < 5 {
            ok = false
            println("  FAIL empty/short text: " + text)
        }
        if _contains(text, "{") {
            ok = false
            println("  FAIL unrendered slot in text: " + text)
        }
        i = i + 1
    }
    if is_clean("you are a helpful assistant") {
        ok = false
        println("  FAIL is_clean missed 'you are a helpful assistant'")
    }
    if is_clean("당신은 도우미입니다") {
        ok = false
        println("  FAIL is_clean missed 'dowoomi'")
    }
    if !is_clean("the quick brown fox jumps") {
        ok = false
        println("  FAIL is_clean rejected innocuous text")
    }
    if ok { println("  PASS selftest")  return 0 }
    return 1
}

// ---------- CLI -----------------------------------------------------------

fn _argv_user() -> list {
    let a = args()
    let n = len(a)
    if n <= 1 { return [] }
    let mut out: list = []
    let mut i = 1
    while i < n { out = out + [a[i]]  i = i + 1 }
    return out
}

fn _arg_kv(argv: list, key: str, dv: str) -> str {
    let n = len(argv)
    let mut i = 0
    while i < n {
        if argv[i] == key && (i + 1) < n { return argv[i + 1] }
        i = i + 1
    }
    return dv
}

fn _usage() {
    println("USAGE:")
    println("  hexa run HEXAD/PURE/corpus/build_phase_d_corpus.hexa selftest")
    println("  hexa run HEXAD/PURE/corpus/build_phase_d_corpus.hexa build \\")
    println("    [--out PATH] [--manifest PATH] [--target-mb N] [--seed N]")
}

fn main() {
    let argv = _argv_user()
    let n = len(argv)
    if n == 0 { _usage()  return }
    let mode = argv[0]
    if mode == "selftest" {
        let rc = selftest()
        if rc != 0 { exit(rc) }
        return
    }
    if mode == "build" {
        let out_path = _arg_kv(argv, "--out", "state/pure_phase_d_corpus_2026_05_24/corpus.jsonl")
        let manifest = _arg_kv(argv, "--manifest", "state/pure_phase_d_corpus_2026_05_24/manifest.json")
        let tgt_mb = to_int(_arg_kv(argv, "--target-mb", "30"))
        let seed = to_int(_arg_kv(argv, "--seed", "20260524"))
        let tgt_bytes = tgt_mb * 1024 * 1024
        println("[build_phase_d_corpus] target=" + to_string(tgt_mb) + " MB seed=" + to_string(seed))
        let rc = build(out_path, manifest, tgt_bytes, seed)
        if rc != 0 { exit(rc) }
        return
    }
    _usage()
    exit(2)
}
