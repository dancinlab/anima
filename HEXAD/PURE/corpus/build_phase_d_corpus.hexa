    return [
        "{adj} {noun} 이 {adj2} {noun2} 위로 {verb}; 공기에서는 {noun3} 의 냄새가 난다.",
        "{noun} 바깥으로 {adj} {noun2} 이 {verb} {conj} {noun3} 은 {adj2} {noun4} 속으로 가라앉는다.",
        "{noun} 의 빛이 {noun2} 에 닿고, {adj} {noun3} 이 희미하게 {verb} 소리가 들린다.",
        "{adj} {noun} 하나가 {noun2} 옆을 지나며, 한때 {noun3} 이 {verb2} 던 자리에서 {verb}.",
        "{adj} {noun} 안에서 {noun2} 와 {noun3} 이 함께 {verb} {conj} {noun4} 는 {adj2} 상태로 남는다.",
        "{noun} 에 대한 기록: {noun2} 가 지난 뒤 {verb}, {noun3} 이 시작된 곳은 {adj}."
    ]
}

