// ---------- Template tables (per lang × kind) ----------------------------

fn tpl_en_stream() -> list {
    return [
        "The {adj} {noun} {verb} across the {adj2} {noun2}; the air tastes of {noun3}.",
        "Outside the {noun}, a {adj} {noun2} {verb} {conj} the {noun3} settles into the {adj2} {noun4}.",
        "Light from the {noun} touches the {noun2}; one hears the {adj} {noun3} {verb} faintly.",
        "A {adj} {noun} drifts past the {noun2}, {verb} where the {noun3} once {verb2}.",
        "Within the {adj} {noun}, the {noun2} and the {noun3} {verb} together {conj} the {noun4} stays {adj2}.",
        "Notes on the {noun}: it {verb} after the {noun2}, {adj} where the {noun3} began."
    ]
}

fn tpl_en_stimulus() -> list {
    return [
        "Morning over the {noun}: a {adj} {noun2} {verb}, then a {noun3} {verb2}.",
        "Field report -- {noun} sighted near the {noun2}, {adj} and {adj2}.",
        "Catalogue entry: the {noun} that {verb} at dusk has a {adj} {noun2}.",
        "Sketch of the {noun}: {adj} contours, a {noun2} for scale, the {noun3} behind."
    ]
}

fn tpl_en_qa() -> list {
    return [
        "Q: where does the {noun} {verb}? A: it {verb2} along the {adj} {noun2}.",
        "Question -- what does a {noun} use a {noun2} for? Answer -- to {verb} the {noun3}.",
        "Asked: which {noun} {verb} first? Replied: the {adj} {noun2}, near the {noun3}."
    ]
}

