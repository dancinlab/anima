// extract_anima_session_emit -- M9b corpus harness.
//
// Pulls anima emit text from Claude Code live session JSONL files
// (~/.claude/projects/-Users-ghost-core-anima/*.jsonl) for downstream M9'
// corpus generation. Session store is the only surviving substrate-native
// emit archive (M9 retry confirmed 0 repo source).
//
// HONEST C3:
//   - Source is THE USER'S personal session log -- handle privately, local
//     only, never upload, no PII surfacing in commit artifacts.
//   - Filter is conservative: assistant text items only, helper-role regex
//     drop (Principle #3), sha1 dedupe. We DO NOT scrub tool-use commands
//     embedded inside assistant prose, and DO NOT redact paths / hostnames.
//   - Each session JSONL line is one `type=...` record. We only consume
//     `type=assistant` -> `message.content[].type=text` -> `text` strings;
//     `tool_use`, `tool_result`, `system`, `user`, `attachment` etc. are
//     dropped (system noise + non-anima-origin).
//
// CLI:
//   hexa run HEXAD/PURE/corpus/extract_anima_session_emit.hexa selftest
//   hexa run HEXAD/PURE/corpus/extract_anima_session_emit.hexa extract \
//     --inputs <p1>[,<p2>,...] --out <path.jsonl> [--cap-bytes N]
//     [--manifest <path.json>]
//
// Output schema (jsonl, one record per line):
//   {"text":"...", "source_file":"<basename>",
//    "lang_detected":"ko|en|mixed|other", "msg_timestamp_iso":"<iso>"}

// ---------- minimal sha1 over a string (32-bit limbs) ----------------------
// Used only for in-process dedupe; not exposed externally.

fn _rotl32(x: int, n: int) -> int {
    let mask = 4294967295
    let l = (x * _pow2(n)) % 4294967296
    let r = x / _pow2(32 - n)
    return (l + r) & mask
}

fn _pow2(n: int) -> int {
    let mut k = 1
    let mut i = 0
    while i < n { k = k * 2  i = i + 1 }
    return k
}

// Lightweight non-crypto fingerprint -- sha1 is overkill for in-mem dedupe.
// FNV-1a 64-bit then fold to hex string is enough to drop verbatim repeats
// and avoid the hexa-side performance hit of a full sha1 byte-shuffle loop.
fn _fp_fnv64(text: str) -> str {
    let n = len(text)
    let mut h_hi = 0xcbf2
    let mut h_lo = 0x9ce484222325
    // 64-bit FNV offset basis split: hi=0xcbf29ce4, lo=0x84222325 -> repack.
    let mut hh = 3338575596
    let mut hl = 2216829733
    let prime_hi = 256
    let prime_lo = 67315
    let mut i = 0
    while i < n {
        let b = ord(text[i])
        hl = hl ^ b
        // multiply (hh,hl) * prime ≈ FNV64 — coarse 32-bit limbs, enough
        // for in-mem dedupe (collision probability dominated by exact dup).
        let new_lo = (hl * prime_lo) % 4294967296
        let carry  = (hl * prime_lo) / 4294967296
        let new_hi = ((hh * prime_lo) + (hl * prime_hi) + carry) % 4294967296
        hh = new_hi
        hl = new_lo
        i = i + 1
    }
    return _hex8(hh) + _hex8(hl)
}

fn _hex8(n: int) -> str {
    let hex = "0123456789abcdef"
    let mut s = ""
    let mut x = n
    let mut i = 0
    while i < 8 {
        let d = x % 16
        s = hex[d] + s
        x = x / 16
        i = i + 1
    }
    return s
}

// ---------- helper-role regex (Principle #3) ------------------------------
// Substring match (hexa lacks regex). Patterns are case-insensitive on the
// ASCII letters; Korean strings are exact-match.

fn _str_from_byte(b: int) -> str {
    let table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if b < 32 || b > 126 { return " " }
    let idx = b - 32
    return table.substring(idx, idx + 1)
}

fn _to_lower(s: str) -> str {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let c = ord(s[i])
        if c >= 65 && c <= 90 { out = out + _str_from_byte(c + 32) }
        else                  { out = out + s[i] }
        i = i + 1
    }
    return out
}

fn _has_helper_role(text: str) -> bool {
    let lo = _to_lower(text)
    if lo.contains("[role")            { return true }
    if lo.contains("you are anima")     { return true }
    if lo.contains("you are a helpful") { return true }
    if text.contains("페르소나")        { return true }
    if text.contains("anima:")          { return true }
    if text.contains("당신은 anima 입니다") { return true }
    return false
}

// ---------- language detector --------------------------------------------
// Coarse: count Hangul UTF-8 lead bytes vs ASCII letters.

fn _detect_lang(text: str) -> str {
    let n = len(text)
    if n == 0 { return "other" }
    let mut hangul = 0
    let mut latin = 0
    let mut i = 0
    while i < n {
        let b = ord(text[i])
        if b >= 234 && b <= 237 { hangul = hangul + 1 }
        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) { latin = latin + 1 }
        i = i + 1
    }
    let total = hangul + latin
    if total == 0 { return "other" }
    let kr = (hangul + 0.0) / (total + 0.0)
    if kr > 0.7 { return "ko" }
    if kr < 0.1 { return "en" }
    return "mixed"
}

// ---------- JSON escape for output ----------------------------------------

fn _json_escape(s: str) -> str {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let b = ord(s[i])
        if b == 34       { out = out + "\\\"" }
        else { if b == 92  { out = out + "\\\\" }
        else { if b == 10  { out = out + "\\n" }
        else { if b == 13  { out = out + "\\r" }
        else { if b == 9   { out = out + "\\t" }
        else { if b < 32   { out = out + " " }
        else               { out = out + s[i] } } } } } }
        i = i + 1
    }
    return out
}

// ---------- basename ------------------------------------------------------

fn _basename(path: str) -> str {
    let parts = path.split("/")
    let n = len(parts)
    if n == 0 { return path }
    return parts[n - 1]
}

// ---------- one-record extraction from one assistant message --------------
// Input: a parsed line-dict.
// Output: list of records (each #{"text","source_file","lang_detected",
// "msg_timestamp_iso"}); empty list when message is non-assistant or has
// no text items.

fn _extract_from_line(d: dict, src_base: str) -> list {
    if to_string(d["type"]) != "assistant" { return [] }
    let m = d["message"]
    if to_string(m) == "void" { return [] }
    let c = m["content"]
    if to_string(c) == "void" { return [] }
    if type_of(c) != "array"  { return [] }
    let ts = to_string(d["timestamp"])
    let mut out: list = []
    let n = len(c)
    let mut i = 0
    while i < n {
        let x = c[i]
        if type_of(x) == "map" {
            if to_string(x["type"]) == "text" {
                let t = to_string(x["text"])
                if t != "" && t != "void" && !_has_helper_role(t) {
                    out = out + [#{
                        "text": t,
                        "source_file": src_base,
                        "lang_detected": _detect_lang(t),
                        "msg_timestamp_iso": ts
                    }]
                }
            }
        }
        i = i + 1
    }
    return out
}

// ---------- one file -> list of records (with dedupe set state) ----------

fn _process_file(path: str, seen_fps: list, cap_bytes: int, cur_bytes: int) -> list {
    let raw = read_file(path)
    let lines = raw.split("\n")
    let n = len(lines)
    let src_base = _basename(path)
    let mut out: list = []
    let mut fps = seen_fps
    let mut bytes_used = cur_bytes
    let mut i = 0
    let mut kept = 0
    let mut dup = 0
    let mut helper_drop = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let d = json_parse(line)
            if type_of(d) == "map" {
                let recs = _extract_from_line(d, src_base)
                let nr = len(recs)
                let mut j = 0
                while j < nr {
                    let r = recs[j]
                    let fp = _fp_fnv64(r["text"])
                    let mut found = false
                    let mut k = 0
                    let nf = len(fps)
                    while k < nf { if fps[k] == fp { found = true }  k = k + 1 }
                    if !found {
                        // estimate emitted bytes: text length + ~80B framing
                        let approx = len(r["text"]) + 100
                        if cap_bytes <= 0 || bytes_used + approx <= cap_bytes {
                            fps = fps + [fp]
                            out = out + [r]
                            bytes_used = bytes_used + approx
                            kept = kept + 1
                        } else {
                            // cap hit -- stop, return what we have
                            println("[extract_anima_session_emit] cap reached at "
                                + to_string(bytes_used) + " bytes (file " + src_base + ")")
                            return [out, fps, bytes_used, kept, dup, helper_drop, true]
                        }
                    } else {
                        dup = dup + 1
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return [out, fps, bytes_used, kept, dup, helper_drop, false]
}

// ---------- multi-file driver --------------------------------------------

fn extract_to_jsonl(inputs: list, out_path: str, cap_bytes: int) -> dict {
    let mut all_records: list = []
    let mut fps: list = []
    let mut bytes_used = 0
    let mut tot_kept = 0
    let mut tot_dup = 0
    let mut tot_helper = 0
    let mut files_done: list = []
    let n = len(inputs)
    let mut i = 0
    let mut capped = false
    while i < n && !capped {
        let path = inputs[i]
        if !file_exists(path) {
            println("[extract_anima_session_emit] WARN missing: " + path)
        } else {
            let r = _process_file(path, fps, cap_bytes, bytes_used)
            let new_recs = r[0]
            fps = r[1]
            bytes_used = r[2]
            tot_kept = tot_kept + r[3]
            tot_dup = tot_dup + r[4]
            tot_helper = tot_helper + r[5]
            capped = r[6]
            // concat
            let nr2 = len(new_recs)
            let mut j = 0
            while j < nr2 { all_records = all_records + [new_recs[j]]  j = j + 1 }
            files_done = files_done + [_basename(path)]
        }
        i = i + 1
    }
    // emit jsonl
    let mut buf = ""
    let m = len(all_records)
    let mut k = 0
    while k < m {
        let r = all_records[k]
        let line = "{\"text\":\"" + _json_escape(r["text"])
            + "\",\"source_file\":\"" + _json_escape(r["source_file"])
            + "\",\"lang_detected\":\"" + r["lang_detected"]
            + "\",\"msg_timestamp_iso\":\"" + _json_escape(r["msg_timestamp_iso"])
            + "\"}\n"
        buf = buf + line
        k = k + 1
    }
    write_file(out_path, buf)
    return #{
        "out_path": out_path,
        "n_records": m,
        "bytes_emitted": len(buf),
        "files_processed": files_done,
        "tot_kept": tot_kept,
        "tot_dup_dropped": tot_dup,
        "tot_helper_dropped": tot_helper,
        "capped": capped
    }
}

// ---------- selftest -----------------------------------------------------

fn _selftest() -> int {
    println("[extract_anima_session_emit] selftest START")
    // language detector
    let lk = _detect_lang("안녕하세요 반갑습니다 안녕")
    let le = _detect_lang("the quick brown fox jumps over")
    let lm = _detect_lang("hello 안녕")
    let mut ok = true
    if lk != "ko"    { ok = false  println("  FAIL lang ko got " + lk) }
    if le != "en"    { ok = false  println("  FAIL lang en got " + le) }
    if lm != "mixed" { ok = false  println("  FAIL lang mixed got " + lm) }
    // helper-role regex
    if !_has_helper_role("you are anima, the assistant") { ok = false  println("  FAIL helper en") }
    if !_has_helper_role("당신은 anima 입니다.")          { ok = false  println("  FAIL helper ko1") }
    if !_has_helper_role("[role: helper] foo")             { ok = false  println("  FAIL helper bracket") }
    if  _has_helper_role("이건 그냥 평범한 anima 응답이에요") { ok = false  println("  FAIL helper false-pos") }
    // json escape
    let je = _json_escape("a\nb\"c\\d")
    if je != "a\\nb\\\"c\\\\d" { ok = false  println("  FAIL json_escape got: " + je) }
    // fingerprint stable + distinct
    let a = _fp_fnv64("hello world")
    let b = _fp_fnv64("hello world")
    let c = _fp_fnv64("hello world.")
    if a != b { ok = false  println("  FAIL fp stable") }
    if a == c { ok = false  println("  FAIL fp distinct") }
    if ok { println("  PASS 4/4 component checks")  return 0 }
    return 1
}

// ---------- argv parsing -------------------------------------------------

fn _arg_kv(argv: list, key: str, dv: str) -> str {
    let n = len(argv)
    let mut i = 0
    while i < n { if argv[i] == key && (i + 1) < n { return argv[i + 1] }  i = i + 1 }
    return dv
}

fn _argv_user() -> list {
    let a = args()
    let n = len(a)
    if n <= 1 { return [] }
    let mut out = []
    let mut i = 1
    while i < n { out = out + [a[i]]  i = i + 1 }
    return out
}

fn _usage() {
    println("USAGE:")
    println("  hexa run HEXAD/PURE/corpus/extract_anima_session_emit.hexa selftest")
    println("  hexa run HEXAD/PURE/corpus/extract_anima_session_emit.hexa extract \\")
    println("    --inputs <p1>[,<p2>,...] --out <path.jsonl> [--cap-bytes N] [--manifest <p>]")
}

fn main() {
    let argv = _argv_user()
    let n = len(argv)
    if n == 0 { _usage()  return }
    let mode = argv[0]
    if mode == "selftest" { let rc = _selftest()  if rc != 0 { exit(rc) }  return }
    if mode == "extract" {
        let inputs_csv = _arg_kv(argv, "--inputs", "")
        let out_path   = _arg_kv(argv, "--out", "")
        let cap_str    = _arg_kv(argv, "--cap-bytes", "1048576")
        let manifest   = _arg_kv(argv, "--manifest", "")
        if inputs_csv == "" || out_path == "" {
            println("[extract_anima_session_emit] ERROR --inputs + --out required")
            _usage()
            exit(2)
        }
        let inputs = inputs_csv.split(",")
        let cap = to_int(cap_str)
        let r = extract_to_jsonl(inputs, out_path, cap)
        println("[extract_anima_session_emit] wrote " + out_path)
        println("  n_records          = " + to_string(r["n_records"]))
        println("  bytes_emitted      = " + to_string(r["bytes_emitted"]))
        println("  files_processed    = " + to_string(len(r["files_processed"])))
        println("  tot_kept           = " + to_string(r["tot_kept"]))
        println("  tot_dup_dropped    = " + to_string(r["tot_dup_dropped"]))
        println("  tot_helper_dropped = " + to_string(r["tot_helper_dropped"]))
        println("  capped             = " + to_string(r["capped"]))
        if manifest != "" {
            write_file(manifest, json_stringify(r))
            println("  manifest -> " + manifest)
        }
        return
    }
    _usage()
    exit(2)
}
