// 1. arg + env contract (matches ENV_CONTRACT.md PR #265) ------------------

fn _env_or(key: str, fallback: str) -> str {
    let v = exec("printenv " + key + " 2>/dev/null").trim()
    if v == "" { return fallback }
    return v
}

fn _lr_default_for_init(init_variant: str) -> str {
    if init_variant == "random" { return "3e-4" }
    if init_variant == "qwen"   { return "5e-5" }
    if init_variant == "vp21m"  { return "1e-4" }
    return "3e-4"
}

fn parse_argv(args: list) -> dict {
    let n = len(args)
    let mut variant = "P21H_alpha"
    let mut init_variant = "random"
    let mut seed = "1337"
    if n >= 1 { variant = args[0] }
    if n >= 2 { init_variant = args[1] }
    if n >= 3 { seed = args[2] }
    return #{
        "variant": variant,
        "init_variant": init_variant,
        "seed": seed,
    }
}

fn build_env(init_variant: str) -> dict {
    // ENV_CONTRACT.md §1 — keep keys aligned with the bash source.
    return #{
        "P21H_STEPS":                _env_or("P21H_STEPS", "2000"),
        "P21H_BSZ":                  _env_or("P21H_BSZ", "2"),
        "P21H_BLOCK":                _env_or("P21H_BLOCK", "512"),
        "P21H_LR":                   _env_or("P21H_LR", _lr_default_for_init(init_variant)),
        "P21H_WARMUP":               _env_or("P21H_WARMUP", "100"),
        "P21H_WIKI_FRAC":            _env_or("P21H_WIKI_FRAC", "0.3"),
        "P21H_CORPUS_MB":            _env_or("P21H_CORPUS_MB", "72"),
        "P21H_NOISE_SIGMA":          _env_or("P21H_NOISE_SIGMA", "0.1"),
        "P21H_LAMBDA_MITOSIS":       _env_or("P21H_LAMBDA_MITOSIS", "0.05"),
        "P21H_MITOSIS_MAX":          _env_or("P21H_MITOSIS_MAX", "128"),
        "P21H_CKPT_EVERY":           _env_or("P21H_CKPT_EVERY", "500"),
        "P21H_TEACHER_CKPT_SHA256":  _env_or("P21H_TEACHER_CKPT_SHA256", ""),
        "WATCHDOG_SEC":              _env_or("WATCHDOG_SEC", "5400"),
        "SAVE_POD":                  _env_or("SAVE_POD", "1"),
    }
}

