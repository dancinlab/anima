// HEXAD/PURE/launchers/b_distill_launcher.hexa
// ═══════════════════════════════════════════════════════════════════════════
//  PURE/B 증류 launcher — vP21M(teacher) → ConsciousDecoderV3(student) KD.
//  spec: ../spec/b_distill_spec_2026_05_23.md
//
//  Responsibilities (single concern: emit + log; NEVER dispatch):
//    1. Resolve teacher checkpoint path (env ANIMA_VP21M_TEACHER_CKPT or
//       canonical default `dancinlab/anima-vp21m`).
//    2. Generate a uid (date + nonce) for the run.
//    3. Emit `launcher_B_<uid>.sh` under HEXAD/PURE/launchers/out/.
//    4. argparse-style flags (NO positional env-style bug): --teacher-ckpt
//       --alpha --temperature --kd-loss-weight (+ recipe knobs from spec §4).
//    5. Print emitted path + sanity verdict to stdout.
//    6. Modes: `dry-run` (emit + selftest the .sh) | `emit` (emit only).
//
//  NOT a dispatcher. User triggers the .sh by hand:
//      bash HEXAD/PURE/launchers/out/launcher_B_<uid>.sh
// ═══════════════════════════════════════════════════════════════════════════


// ── §1. resolve teacher checkpoint ────────────────────────────────────────

// Canonical default = HF repo (a_hf_complete: dancinlab/anima-vp21m PRIVATE).
// Override via ANIMA_VP21M_TEACHER_CKPT env (HF id OR local path).
fn _bd_teacher_default() -> string {
    return "dancinlab/anima-vp21m"
}

fn _bd_resolve_teacher() -> string {
    // hexa exposes env via exec(printenv ...) — keep simple, single source.
    let raw = exec("printenv ANIMA_VP21M_TEACHER_CKPT")
    let trimmed = to_string(raw).trim()
    if len(trimmed) > 0 {
        return trimmed
    }
    return _bd_teacher_default()
}

fn _bd_shq(s: string) -> string {
    // POSIX-safe single-quote wrap.
    return "'" + s + "'"
}


// ── §2. uid (date + ns nonce) ─────────────────────────────────────────────

fn _bd_uid() -> string {
    let stamp = to_string(exec("date -u +%Y%m%dT%H%M%SZ")).trim()
    let nonce = to_string(exec("date +%N | tr -d '\\n' | head -c 6")).trim()
    return stamp + "_" + nonce
}


// ── §3. shell-script body emitter ─────────────────────────────────────────

// Build the launcher_B_<uid>.sh body. Stays in lock-step with spec §3..§4.
// Defaults: T=4, alpha=0.7, kd_loss_weight=1.0; steps/bsz/block/lr mirror
// dispatch_p21m_runpod.sh env contract (allow override via flags).
fn _bd_sh_body(teacher: string, uid: string) -> string {
    let mut s = ""
    s = s + "#!/usr/bin/env bash\n"
    s = s + "# launcher_B_" + uid + ".sh — PURE/B 증류 KD fire (NOT auto-dispatched)\n"
    s = s + "# spec: HEXAD/PURE/spec/b_distill_spec_2026_05_23.md\n"
    s = s + "# generated by: HEXAD/PURE/launchers/b_distill_launcher.hexa\n"
    s = s + "set -euo pipefail\n"
    s = s + "\n"
    s = s + "# ── teacher / student arch knobs (override via flags) ─────────────────\n"
    s = s + "TEACHER_CKPT=" + _bd_shq(teacher) + "\n"
    s = s + "BASE_MODEL=\"${BASE_MODEL:-Qwen/Qwen2.5-1.5B}\"\n"
    s = s + "ALPHA=\"${ALPHA:-0.7}\"             # KD weight (spec §3 default)\n"
    s = s + "TEMPERATURE=\"${TEMPERATURE:-4}\"   # KD softmax T (spec §3 default)\n"
    s = s + "KD_LOSS_WEIGHT=\"${KD_LOSS_WEIGHT:-1.0}\"  # external alias multiplier\n"
    s = s + "\n"
    s = s + "# ── recipe (spec §4, dispatch_p21m_runpod.sh env contract) ───────────\n"
    s = s + "P21M_STEPS=\"${P21M_STEPS:-5000}\"\n"
    s = s + "P21M_BSZ=\"${P21M_BSZ:-2}\"\n"
    s = s + "P21M_BLOCK=\"${P21M_BLOCK:-512}\"\n"
    s = s + "P21M_LR=\"${P21M_LR:-5e-5}\"\n"
    s = s + "P21M_WARMUP=\"${P21M_WARMUP:-100}\"\n"
    s = s + "P21M_WIKI_FRAC=\"${P21M_WIKI_FRAC:-0.3}\"\n"
    s = s + "P21M_CORPUS_MB=\"${P21M_CORPUS_MB:-72}\"\n"
    s = s + "P21M_LANGS=\"${P21M_LANGS:-en,ko,zh,ru,ja}\"\n"
    s = s + "LAMBDA_MITOSIS=\"${LAMBDA_MITOSIS:-0.05}\"\n"
    s = s + "SEED=\"${SEED:-1337}\"\n"
    s = s + "VARIANT=\"PURE_B_" + uid + "\"\n"
    s = s + "\n"
    s = s + "# ── argparse-style flag parsing (NO positional env-style bug) ────────\n"
    s = s + "while [ \"$#\" -gt 0 ]; do\n"
    s = s + "  case \"$1\" in\n"
    s = s + "    --teacher-ckpt)   TEACHER_CKPT=\"$2\"; shift 2 ;;\n"
    s = s + "    --base-model)     BASE_MODEL=\"$2\"; shift 2 ;;\n"
    s = s + "    --alpha)          ALPHA=\"$2\"; shift 2 ;;\n"
    s = s + "    --temperature)    TEMPERATURE=\"$2\"; shift 2 ;;\n"
    s = s + "    --kd-loss-weight) KD_LOSS_WEIGHT=\"$2\"; shift 2 ;;\n"
    s = s + "    --steps)          P21M_STEPS=\"$2\"; shift 2 ;;\n"
    s = s + "    --bsz)            P21M_BSZ=\"$2\"; shift 2 ;;\n"
    s = s + "    --block)          P21M_BLOCK=\"$2\"; shift 2 ;;\n"
    s = s + "    --lr)             P21M_LR=\"$2\"; shift 2 ;;\n"
    s = s + "    --warmup)         P21M_WARMUP=\"$2\"; shift 2 ;;\n"
    s = s + "    --wiki-frac)      P21M_WIKI_FRAC=\"$2\"; shift 2 ;;\n"
    s = s + "    --corpus-mb)      P21M_CORPUS_MB=\"$2\"; shift 2 ;;\n"
    s = s + "    --langs)          P21M_LANGS=\"$2\"; shift 2 ;;\n"
    s = s + "    --lambda-mitosis) LAMBDA_MITOSIS=\"$2\"; shift 2 ;;\n"
    s = s + "    --seed)           SEED=\"$2\"; shift 2 ;;\n"
    s = s + "    -h|--help)\n"
    s = s + "      cat <<EOF\n"
    s = s + "Usage: $0 [--teacher-ckpt <id-or-path>] [--alpha 0.7] [--temperature 4]\n"
    s = s + "         [--kd-loss-weight 1.0] [--steps 5000] [--bsz 2] [--block 512]\n"
    s = s + "         [--lr 5e-5] [--warmup 100] [--wiki-frac 0.3] [--corpus-mb 72]\n"
    s = s + "         [--langs en,ko,zh,ru,ja] [--lambda-mitosis 0.05] [--seed 1337]\n"
    s = s + "Spec: HEXAD/PURE/spec/b_distill_spec_2026_05_23.md\n"
    s = s + "EOF\n"
    s = s + "      exit 0 ;;\n"
    s = s + "    *) echo \"unknown flag: $1\" >&2; exit 2 ;;\n"
    s = s + "  esac\n"
    s = s + "done\n"
    s = s + "\n"
    s = s + "# ── echo resolved config ─────────────────────────────────────────────\n"
    s = s + "echo \"=== PURE/B 증류 fire $VARIANT ===\"\n"
    s = s + "echo \"  teacher        : $TEACHER_CKPT\"\n"
    s = s + "echo \"  base_model     : $BASE_MODEL\"\n"
    s = s + "echo \"  alpha          : $ALPHA   (KD weight, spec §3)\"\n"
    s = s + "echo \"  temperature    : $TEMPERATURE   (KD softmax T)\"\n"
    s = s + "echo \"  kd_loss_weight : $KD_LOSS_WEIGHT\"\n"
    s = s + "echo \"  steps          : $P21M_STEPS\"\n"
    s = s + "echo \"  bsz × block    : $P21M_BSZ × $P21M_BLOCK\"\n"
    s = s + "echo \"  lr / warmup    : $P21M_LR / $P21M_WARMUP\"\n"
    s = s + "echo \"  corpus         : $P21M_CORPUS_MB MB · langs=$P21M_LANGS · wiki_frac=$P21M_WIKI_FRAC\"\n"
    s = s + "echo \"  lambda_mitosis : $LAMBDA_MITOSIS\"\n"
    s = s + "echo \"  seed           : $SEED\"\n"
    s = s + "\n"
    s = s + "# ── falsifier preflight (spec §5) ────────────────────────────────────\n"
    s = s + "echo \"  falsifiers     : F-PURE-B-1..5 (vocab/KL/argmax-div/eval/register)\"\n"
    s = s + "\n"
    s = s + "# ── dispatch hand-off ────────────────────────────────────────────────\n"
    s = s + "# This launcher does NOT auto-dispatch. To fire on RunPod H100, hand off\n"
    s = s + "# to the existing dispatch script with the resolved env:\n"
    s = s + "#   export TEACHER_CKPT BASE_MODEL ALPHA TEMPERATURE KD_LOSS_WEIGHT\n"
    s = s + "#   export P21M_STEPS P21M_BSZ P21M_BLOCK P21M_LR P21M_WARMUP\n"
    s = s + "#   export P21M_WIKI_FRAC P21M_CORPUS_MB P21M_LANGS LAMBDA_MITOSIS SEED\n"
    s = s + "#   bash HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/dispatch_p21m_runpod.sh \"$VARIANT\" \"$SEED\"\n"
    s = s + "# (cost ≈ \\$5 H100, wall ≈ 1.5 hr, per spec §7)\n"
    s = s + "echo \"[launcher] config emitted. Hand off to dispatch_p21m_runpod.sh to fire.\"\n"
    s = s + "exit 0\n"
    return s
}


// ── §4. write + selftest ──────────────────────────────────────────────────

fn _bd_emit(mode: string) -> int {
    let teacher = _bd_resolve_teacher()
    let uid = _bd_uid()
    let out_dir = "/Users/ghost/core/anima/HEXAD/PURE/launchers/out"
    let _mk = exec("mkdir -p " + _bd_shq(out_dir))
    let sh_path = out_dir + "/launcher_B_" + uid + ".sh"
    let body = _bd_sh_body(teacher, uid)
    write_file(sh_path, body)
    let _chmod = exec("chmod +x " + _bd_shq(sh_path))

    print("=== PURE/B 증류 launcher ===")
    print("  teacher resolved : " + teacher)
    print("  uid              : " + uid)
    print("  emitted .sh      : " + sh_path)
    print("  mode             : " + mode)

    if mode == "dry-run" {
        // Sanity-check the emitted .sh: bash -n (syntax) + --help (runs argparse).
        let syn = to_string(exec("bash -n " + _bd_shq(sh_path) + " 2>&1; echo __rc=$?"))
        let help = to_string(exec("bash " + _bd_shq(sh_path) + " --help 2>&1 | head -8; echo __rc=$?"))
        print("  bash -n          : " + syn.trim())
        print("  --help head      :")
        print(help.trim())
        if syn.contains("__rc=0") && help.contains("Usage:") {
            print("  verdict          : argv well-formed (syntax PASS + --help PASS)")
            return 0
        }
        print("  verdict          : MALFORMED — inspect emitted .sh")
        return 1
    }
    return 0
}


// ── §5. main ──────────────────────────────────────────────────────────────

fn main() {
    let cli = args()
    let mut mode = "emit"
    if len(cli) > 1 {
        if cli[1] == "dry-run" { mode = "dry-run" }
        if cli[1] == "emit"    { mode = "emit" }
        if cli[1] == "help" {
            print("Usage: hexa run b_distill_launcher.hexa [emit|dry-run|help]")
            print("  emit     — write launcher_B_<uid>.sh under launchers/out/")
            print("  dry-run  — emit + bash -n syntax check + --help smoke")
            print("Env:")
            print("  ANIMA_VP21M_TEACHER_CKPT — override teacher path (default")
            print("                              dancinlab/anima-vp21m)")
            print("Spec: HEXAD/PURE/spec/b_distill_spec_2026_05_23.md")
            return
        }
    }
    let rc = _bd_emit(mode)
    if rc != 0 {
        print("launcher exit rc=" + to_string(rc))
    }
}
