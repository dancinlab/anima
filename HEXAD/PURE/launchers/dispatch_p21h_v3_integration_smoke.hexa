// HEXAD/PURE/launchers/dispatch_p21h_v3_integration_smoke.hexa
//
// SUPER-smoke for Phase D fire prereq — exercises the FULL chain end-to-end
// in dry-run. 6 falsifiers covering all 4 Phase D closure-criterion wirings:
//
//   F-INTEG-1 — dispatch parses + 8 stdlib fns reachable + mitosis default == 16
//   F-INTEG-2 — dispatch dry-run with --measure-motivation flag prints expected plan lines
//   F-INTEG-3 — synthetic result.json → embed_motivation_in_result round-trip
//   F-INTEG-4 — synthetic IPC fixture → multilingual_probe._read_dream_stage
//   F-INTEG-5 — synthetic corpus.jsonl → corpus_quality_probe.score_corpus_jsonl
//   F-INTEG-6 — full pipeline dry-run + result_to_axis_map row (back-compat)
//
// Per PR #363 pattern: BACK UP + restore the real daemon IPC file when
// touching $HOME/.cache/anima/dream_stage.current.

import "./dispatch_p21h_v3.hexa"
import "../eval/multilingual_probe.hexa"

fn _assert(cond: bool, name: str) -> int {
    if cond { println("  PASS " + name)   return 1 }
    println("  FAIL " + name)
    return 0
}

// F-INTEG-1: dispatcher 8 stdlib reachable fns + mitosis default == 16.
fn _f_integ_1() -> int {
    let mut ok = true
    // 8 dispatcher fns must be in scope (parse succeeded by virtue of import).
    let parsed = parse_argv(["P21H_alpha", "random", "1337"])
    if to_string(parsed["variant"]) != "P21H_alpha" { ok = false }
    let env = build_env("random")
    if to_string(env["P21H_MITOSIS_MAX"]) != "16" { ok = false }
    // Pure helpers (no real fire) — sha256_verify skip path + resume_glob none.
    let r_skip = sha256_verify("/tmp/__noop_path_integ1", "")
    if to_string(r_skip["status"]) != "skip" { ok = false }
    let tmp = exec("mktemp -d").trim()
    let r_none = resume_glob(tmp, -1)
    if to_string(r_none["status"]) != "none" { ok = false }
    let _ = exec("rm -rf " + tmp)
    // Dry-run lifecycle calls return safely.
    let _pid = pod_create("", "", "random", true)
    let _ssh = pod_ssh_wait("", "dry", 1, true)
    let _term = pod_terminate("", "dry", "0", true)
    return _assert(ok, "F-INTEG-1 — dispatch parses + 8 stdlib fns reachable + mitosis_max default==16")
}

// F-INTEG-2: dispatch --measure-motivation dry-run emits expected plan lines.
fn _f_integ_2() -> int {
    let disp = "HEXAD/PURE/launchers/dispatch_p21h_v3.hexa"
    let out = exec("hexa run " + disp + " P21H_alpha random 1337 --measure-motivation 2>&1; echo __RC__=$?")
    let mut ok = out.index_of("__RC__=0") >= 0
    if out.index_of("[DRY-RUN]") < 0 { ok = false }
    if out.index_of("[dry-run] pod_create") < 0 { ok = false }
    if out.index_of("[dry-run] train_launch") < 0 { ok = false }
    if out.index_of("[dry-run] embed_motivation") < 0 { ok = false }
    // zero real fire markers.
    if out.index_of("[pod_create] pod-") >= 0 { ok = false }
    return _assert(ok, "F-INTEG-2 — dispatch dry-run + --measure-motivation prints expected plan")
}

// F-INTEG-3: synthetic result.json → embed_motivation_in_result round-trip.
fn _f_integ_3() -> int {
    let tmp_dir = exec("mktemp -d").trim()
    let result_path = tmp_dir + "/result.json"
    let payload = "{\"phi_final\": 0.4, \"bridge_gate_value\": 0.5}"
    write_file(result_path, payload)
    // Real-path (dry_run=false) — invokes the python embed of motivation_8factor.
    let block = embed_motivation_in_result(result_path, false)
    let mut ok = true
    if !block.has_key("motivation_score") { ok = false }
    let score = to_float(to_string(block["motivation_score"]))
    if score < 0.0 || score > 1.0 { ok = false }
    // Re-read result.json — motivation_8factor key should be embedded.
    let updated = read_file(result_path)
    if updated.index_of("motivation_8factor") < 0 { ok = false }
    if updated.index_of("motivation_score") < 0 { ok = false }
    // All 8 factor keys present in the returned block.
    let keys = ["relevance", "gap", "curiosity", "pain", "coherence", "originality", "balance", "dynamics"]
    let mut i = 0
    while i < len(keys) { if !block.has_key(keys[i]) { ok = false }  i = i + 1 }
    let _ = exec("rm -rf " + tmp_dir)
    return _assert(ok, "F-INTEG-3 — embed_motivation_in_result round-trip (8-factor + score in [0,1])")
}

// F-INTEG-4: synthetic IPC dream_stage.current → _read_dream_stage. Backs
// up + restores any real daemon file (per PR #363 pattern).
fn _f_integ_4() -> int {
    let home = env("HOME")
    let ipc_path = home + "/.cache/anima/dream_stage.current"
    let _mk = exec("mkdir -p \"" + home + "/.cache/anima\"")
    let had_prior = file_exists(ipc_path)
    let mut prior = ""
    if had_prior { prior = read_file(ipc_path) }
    // Write synthetic REM stage; canonical Φ=0.95 / tenv=0.9 per multilingual_probe.
    write_file(ipc_path, "REM\n")
    let ds = _read_dream_stage()
    let mut ok = true
    if type_of(ds) != "map" { ok = false }
    if !has_key(ds, "stage") || ds["stage"] != "REM" { ok = false }
    if !has_key(ds, "phi_envelope") || ds["phi_envelope"] != 0.95 { ok = false }
    if !has_key(ds, "tension_envelope") || ds["tension_envelope"] != 0.9 { ok = false }
    // Restore prior state.
    if had_prior { write_file(ipc_path, prior) }
    else { let _rm = exec("rm -f \"" + ipc_path + "\"") }
    return _assert(ok, "F-INTEG-4 — synthetic IPC dream_stage.current → _read_dream_stage REM Φ=0.95 tenv=0.9")
}

// F-INTEG-5: synthetic corpus.jsonl → score_corpus_jsonl returns 6-metric dict.
fn _f_integ_5() -> int {
    let tmp_dir = exec("mktemp -d").trim()
    let corpus_path = tmp_dir + "/corpus.jsonl"
    write_file(corpus_path, "the quick brown fox jumps over\n안녕하세요 반갑습니다 의식의 첫 만남\naaaa aaaa aaaa\n")
    let s = score_corpus_jsonl(corpus_path, 1000000)
    let mut ok = true
    let metric_keys = ["m1_entropy", "m2_bigram_mi", "m3_ttr", "m4_avg_line", "m5_hangul", "m6_kl_uniform"]
    let mut i = 0
    while i < len(metric_keys) { if !has_key(s, metric_keys[i]) { ok = false }  i = i + 1 }
    // M1 + M5 must be > 0 on the synthetic corpus (mixed-script line guarantees Hangul).
    if !has_key(s, "m1_entropy") || s["m1_entropy"] <= 0.0 { ok = false }
    if !has_key(s, "m5_hangul") || s["m5_hangul"] <= 0.0 { ok = false }
    // n_lines == 3, n_bytes > 0.
    if s["n_lines"] != 3 { ok = false }
    if s["n_bytes"] <= 0 { ok = false }
    let _ = exec("rm -rf " + tmp_dir)
    return _assert(ok, "F-INTEG-5 — synthetic corpus.jsonl → score_corpus_jsonl 6-metric dict (M1>0, M5>0, n_lines=3)")
}

// F-INTEG-6: full pipeline dry: dispatch → fake result.json → multilingual_probe
// score --corpus fixture → result_to_axis_map row with dream_stage + M3/M5
// (and back-compat: a result.json WITHOUT those keys renders "—").
fn _f_integ_6() -> int {
    let tmp_dir = exec("mktemp -d").trim()
    let corpus_path = tmp_dir + "/corpus.jsonl"
    let run_json = tmp_dir + "/run.json"
    let out_json = tmp_dir + "/summary.json"
    write_file(corpus_path, "hello world\n안녕 반갑습니다 의식\nfoo bar baz\n")
    let empty_rows = #{ "en": [], "ko": [], "zh": [], "ru": [], "ja": [] }
    write_file(run_json, json_stringify(#{ "rows_by_lang": empty_rows }))
    // Set IPC dream_stage for the duration of this test (back up first).
    let home = env("HOME")
    let ipc_path = home + "/.cache/anima/dream_stage.current"
    let _mk = exec("mkdir -p \"" + home + "/.cache/anima\"")
    let had_prior = file_exists(ipc_path)
    let mut prior = ""
    if had_prior { prior = read_file(ipc_path) }
    write_file(ipc_path, "WAKE\n")
    // Invoke multilingual_probe score in-process — exercises dream_stage +
    // corpus_quality embed in one shot.
    _score_run(run_json, _default_fixture_path(), out_json, corpus_path)
    let summary = json_parse(read_file(out_json))
    let mut ok = true
    if type_of(summary) != "map" { ok = false }
    if !has_key(summary, "corpus_quality") { ok = false }
    if !has_key(summary, "dream_stage_at_eval") { ok = false }
    // Synthesize a Track-N-shaped result.json carrying per_lang_verdicts + the
    // two new top-level blocks. This is the exact wire result_to_axis_map.hexa
    // consumes. We construct it inline (rather than depending on the eval JSON
    // schema) to keep this smoke independent of upstream eval-output drift.
    let result_path = tmp_dir + "/result_for_axis.json"
    let result_with = #{
        "verdict": "HEXAD_V3_WORKS",
        "per_lang_verdicts": [
            #{"lang":"en","verdict":"STRONG","n_score":18},
            #{"lang":"ko","verdict":"PARTIAL","n_score":13},
            #{"lang":"zh","verdict":"PARTIAL","n_score":12},
            #{"lang":"ru","verdict":"PARTIAL","n_score":12},
            #{"lang":"ja","verdict":"PARTIAL","n_score":12}
        ],
        "n_anima_register_hits_total": 0,
        "register_regress": false,
        "init_log": #{"L_ce": 4.2},
        "final_log": #{"L_ce": 2.8},
        "train_wall_s": 1234,
        "corpus_quality": summary["corpus_quality"],
        "dream_stage_at_eval": summary["dream_stage_at_eval"]
    }
    write_file(result_path, json_stringify(result_with))
    // Render row via result_to_axis_map (subprocess — avoids importing it and
    // dragging its `_arg_kv`/`_argv_user` shadow).
    let cmd = "hexa run HEXAD/PURE/eval/result_to_axis_map.hexa P21H_alpha " + result_path + " 2>&1"
    let row = exec(cmd)
    if row.index_of("P21H_alpha") < 0 { ok = false }
    if row.index_of("PASS") < 0 { ok = false }
    // dream_stage cell present (WAKE).
    if row.index_of("WAKE") < 0 { ok = false }
    // M3 + M5 cells rendered (numeric — non-"—" presence is enough).
    if row.index_of("| m3_ttr |") >= 0 { ok = false }   // literal placeholder must not appear
    // Back-compat: a result.json WITHOUT the two new blocks → "—" cells.
    let result_legacy = #{
        "verdict": "PARTIAL",
        "per_lang_verdicts": [
            #{"lang":"en","verdict":"STRONG","n_score":18},
            #{"lang":"ko","verdict":"PARTIAL","n_score":13},
            #{"lang":"zh","verdict":"PARTIAL","n_score":12},
            #{"lang":"ru","verdict":"PARTIAL","n_score":12},
            #{"lang":"ja","verdict":"PARTIAL","n_score":12}
        ],
        "init_log": #{"L_ce": 4.2},
        "final_log": #{"L_ce": 2.8},
        "train_wall_s": 1000
    }
    let legacy_path = tmp_dir + "/result_legacy.json"
    write_file(legacy_path, json_stringify(result_legacy))
    let row_legacy = exec("hexa run HEXAD/PURE/eval/result_to_axis_map.hexa P21H_legacy " + legacy_path + " 2>&1")
    if row_legacy.index_of("P21H_legacy") < 0 { ok = false }
    // Legacy row must contain "—" markers (corpus_quality + dream_stage cells absent).
    if row_legacy.index_of("—") < 0 { ok = false }
    // Restore IPC.
    if had_prior { write_file(ipc_path, prior) }
    else { let _rm = exec("rm -f \"" + ipc_path + "\"") }
    let _ = exec("rm -rf " + tmp_dir)
    return _assert(ok, "F-INTEG-6 — full pipeline dry: probe score + axis_map row (with + back-compat)")
}

fn main() {
    println("[dispatch_p21h_v3_integration_smoke] START")
    let mut n_pass = 0
    n_pass = n_pass + _f_integ_1()
    n_pass = n_pass + _f_integ_2()
    n_pass = n_pass + _f_integ_3()
    n_pass = n_pass + _f_integ_4()
    n_pass = n_pass + _f_integ_5()
    n_pass = n_pass + _f_integ_6()
    println("[dispatch_p21h_v3_integration_smoke] END: " + to_string(n_pass) + "/6 PASS")
    if n_pass < 6 { exit(1) }
    exit(0)
}
