// PURE Track 1 corpus reburn launcher
//
// Emits two runpod-dispatched train scripts (launcher_E2_<uid>.sh +
// launcher_E3_<uid>.sh) into a workspace dir under state/pure_track1_<date>/.
// Does NOT dispatch any pod — emit only. Caller runs the emitted .sh.
//
// Usage:
//   hexa run HEXAD/PURE/launchers/track1_corpus_reburn_launcher.hexa dry-run
//   hexa run HEXAD/PURE/launchers/track1_corpus_reburn_launcher.hexa emit [--uid <tag>]
//
// Anchored against:
//   - spec: HEXAD/PURE/spec/track1_corpus_reburn_spec_2026_05_23.md
//   - dispatch precedent: HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/dispatch_p21h_v3_runpod.sh
//   - train script: HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/train_p21h_v3.py
//
// IMPORTANT (cycle-1 P21H bug lesson):
//   Use argparse --key value ONLY. Do NOT mix env-style positional args
//   (KEY=V KEY=V python3 ...) — closure fires used argparse exclusively.

// -------------------------------------------------------------------
// Helpers
// -------------------------------------------------------------------

fn _t1_is_ws(c: str) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r"
}

fn _t1_strip_ws(s: str) -> str {
    let n = len(s)
    let mut lo = 0
    while lo < n && _t1_is_ws(s[lo]) { lo = lo + 1 }
    let mut hi = n
    while hi > lo && _t1_is_ws(s[hi - 1]) { hi = hi - 1 }
    let mut out = ""
    let mut i = lo
    while i < hi { out = out + s[i]   i = i + 1 }
    return out
}

// -------------------------------------------------------------------
// Constants — closure A fire hyperparams (§ 4 of spec)
// -------------------------------------------------------------------

fn _t1_constants() -> dict {
    return #{
        "base_model": "Qwen/Qwen2.5-1.5B",
        "init_variant": "qwen",
        "steps": 5000,
        "bsz": 2,
        "block": 512,
        "lr": "5e-5",
        "warmup": 100,
        "noise_sigma": "0.1",
        "lambda_mitosis": "0.05",
        "mitosis_max": 128,
        "ckpt_every": 500,
        "ckpt_osc_threshold": "0.0",
        "ckpt_osc_window": 20,
        "early_stop_patience": 0,
        "target_corpus_mb": 72,
        "seed": 1337,
        "wiki_target_mb_per_lang": 10,
        "langs": "en,ko,zh,ru,ja",
        "dispatch_sh": "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/dispatch_p21h_v3_runpod.sh"
    }
}

fn _t1_variants() -> list {
    // E3 = anima 0% (wiki_frac=1.0). E2 = anima 50% (wiki_frac=0.5).
    return [
        #{ "tag": "E3", "wiki_frac": "1.0", "rationale": "pure multilingual prior (anima 0%)" },
        #{ "tag": "E2", "wiki_frac": "0.5", "rationale": "balanced 50/50 mix" }
    ]
}

// -------------------------------------------------------------------
// argv parsing
// -------------------------------------------------------------------

fn _t1_parse_argv(argv) -> dict {
    let mode = "dry-run"
    let uid = ""
    let n = len(argv)
    let mut i = 0
    while i < n {
        let a = argv[i]
        if a == "emit" { mode = "emit"   i = i + 1 }
        else if a == "dry-run" { mode = "dry-run"   i = i + 1 }
        else if a == "--uid" && (i + 1) < n { uid = argv[i + 1]   i = i + 2 }
        else if a == "-h" || a == "--help" { mode = "help"   i = i + 1 }
        else { i = i + 1 }
    }
    if uid == "" {
        // default uid = today's date YYYY_MM_DD via shell `date`
        uid = _t1_strip_ws(exec("date -u +%Y_%m_%d"))
    }
    return #{ "mode": mode, "uid": uid }
}

fn _t1_usage() {
    println("USAGE: hexa run track1_corpus_reburn_launcher.hexa <dry-run|emit> [--uid <tag>]")
    println("")
    println("  dry-run  — print what would be emitted, no files written (DEFAULT)")
    println("  emit     — write 2 .sh files into state/pure_track1_<uid>/")
    println("  --uid    — override workspace tag (default = YYYY_MM_DD UTC)")
}

// -------------------------------------------------------------------
// .sh body generation
// -------------------------------------------------------------------

fn _t1_render_sh(tag: str, wiki_frac: str, rationale: str, uid: str, K: dict) -> str {
    // Build a bash script that wraps `bash <dispatch_sh> <VARIANT> <INIT> <SEED>`
    // with all Track 1 hyperparams as env exports (the dispatch_sh reads them
    // as ${P21H_KEY:-default}).
    //
    // NOTE: the dispatch script ITSELF uses argparse-style `--key value`
    // when calling python (line 221-232 of dispatch_p21h_v3_runpod.sh).
    // The env exports here only configure dispatch_sh's defaults, not python's
    // argv. This is the closure A fire pattern — apples-to-apples.
    let variant = "P21H_" + tag + "_" + uid
    let lines = []
    lines = lines + ["#!/usr/bin/env bash"]
    lines = lines + ["# PURE Track 1 — variant " + tag + " (" + rationale + ")"]
    lines = lines + ["# Auto-emitted by track1_corpus_reburn_launcher.hexa @ " + uid]
    lines = lines + ["# DO NOT EDIT — re-emit from .hexa launcher."]
    lines = lines + [""]
    lines = lines + ["set -uo pipefail"]
    lines = lines + [""]
    lines = lines + ["# Track 1 hyperparams (closure A fire byte-identical, except --wiki-frac)"]
    lines = lines + ["export P21H_STEPS=" + to_string(K["steps"])]
    lines = lines + ["export P21H_BSZ=" + to_string(K["bsz"])]
    lines = lines + ["export P21H_BLOCK=" + to_string(K["block"])]
    lines = lines + ["export P21H_WARMUP=" + to_string(K["warmup"])]
    lines = lines + ["export P21H_LR=" + K["lr"]]
    lines = lines + ["export P21H_WIKI_FRAC=" + wiki_frac + "  # ← variant axis"]
    lines = lines + ["export P21H_CORPUS_MB=" + to_string(K["target_corpus_mb"])]
    lines = lines + ["export P21H_WIKI_TARGET_MB_PER_LANG=" + to_string(K["wiki_target_mb_per_lang"])]
    lines = lines + ["export P21H_LANGS=" + K["langs"]]
    lines = lines + ["export P21H_NOISE_SIGMA=" + K["noise_sigma"]]
    lines = lines + ["export P21H_LAMBDA_MITOSIS=" + K["lambda_mitosis"]]
    lines = lines + ["export P21H_MITOSIS_MAX=" + to_string(K["mitosis_max"])]
    lines = lines + ["export P21H_CKPT_EVERY=" + to_string(K["ckpt_every"])]
    lines = lines + ["export P21H_CKPT_OSC_THRESHOLD=" + K["ckpt_osc_threshold"]]
    lines = lines + ["export P21H_CKPT_OSC_WINDOW=" + to_string(K["ckpt_osc_window"])]
    lines = lines + ["export P21H_EARLY_STOP_PATIENCE=" + to_string(K["early_stop_patience"])]
    lines = lines + ["export P21H_BASE_MODEL=" + K["base_model"]]
    lines = lines + [""]
    lines = lines + ["# Watchdog: 5000 step × ~1.5s/step ≈ 7500s + eval + corpus build → 10800s (3 hr)"]
    lines = lines + ["export WATCHDOG_SEC=10800"]
    lines = lines + [""]
    lines = lines + ["# Variant tag · init · seed → positional argv of dispatch_p21h_v3_runpod.sh"]
    lines = lines + ["VARIANT=\"" + variant + "\""]
    lines = lines + ["INIT=\"" + K["init_variant"] + "\""]
    lines = lines + ["SEED=" + to_string(K["seed"])]
    lines = lines + [""]
    lines = lines + ["cd /Users/ghost/core/anima"]
    lines = lines + ["bash " + K["dispatch_sh"] + " \"$VARIANT\" \"$INIT\" \"$SEED\""]
    lines = lines + [""]
    let mut body = ""
    let mut j = 0
    let nl = len(lines)
    while j < nl {
        body = body + lines[j] + "\n"
        j = j + 1
    }
    return body
}

// -------------------------------------------------------------------
// Workspace + emit
// -------------------------------------------------------------------

fn _t1_workspace(uid: str) -> str {
    return "state/pure_track1_" + uid
}

fn _t1_emit(cfg: dict) {
    let uid = cfg["uid"]
    let mode = cfg["mode"]
    let K = _t1_constants()
    let vs = _t1_variants()
    let wdir = _t1_workspace(uid)

    if mode == "emit" {
        let _ = exec("mkdir -p " + wdir)
    }

    let mut i = 0
    let n = len(vs)
    while i < n {
        let v = vs[i]
        let tag = v["tag"]
        let wf = v["wiki_frac"]
        let rationale = v["rationale"]
        let body = _t1_render_sh(tag, wf, rationale, uid, K)
        let path = wdir + "/launcher_" + tag + "_" + uid + ".sh"

        if mode == "dry-run" {
            println("=== [dry-run] would emit: " + path)
            println("    variant=" + tag + "  wiki_frac=" + wf + "  (" + rationale + ")")
            println("    bytes=" + to_string(len(body)))
        } else {
            write_file(path, body)
            let _ = exec("chmod +x " + path)
            println("[emit] " + path + "  (" + to_string(len(body)) + " bytes)")
        }
        i = i + 1
    }

    // README-style manifest in the workspace
    let manifest_lines = []
    let manifest_lines2 = manifest_lines + ["# PURE Track 1 workspace " + uid]
    let manifest_lines3 = manifest_lines2 + [""]
    let manifest_lines4 = manifest_lines3 + ["Generated by: HEXAD/PURE/launchers/track1_corpus_reburn_launcher.hexa"]
    let manifest_lines5 = manifest_lines4 + ["Spec: HEXAD/PURE/spec/track1_corpus_reburn_spec_2026_05_23.md"]
    let manifest_lines6 = manifest_lines5 + [""]
    let manifest_lines7 = manifest_lines6 + ["## variants"]
    let manifest_lines8 = manifest_lines7 + [""]
    let manifest_lines9 = manifest_lines8 + ["- E3: anima 0% (wiki_frac=1.0) — pure multilingual prior"]
    let manifest_lines10 = manifest_lines9 + ["- E2: anima 50% (wiki_frac=0.5) — balanced mix"]
    let manifest_lines11 = manifest_lines10 + [""]
    let manifest_lines12 = manifest_lines11 + ["## fire (caller-driven; @D a_wall_first → parallel):"]
    let manifest_lines13 = manifest_lines12 + [""]
    let manifest_lines14 = manifest_lines13 + ["    nohup bash launcher_E3_" + uid + ".sh > E3.log 2>&1 &"]
    let manifest_lines15 = manifest_lines14 + ["    nohup bash launcher_E2_" + uid + ".sh > E2.log 2>&1 &"]
    let manifest_lines16 = manifest_lines15 + [""]
    let manifest_lines17 = manifest_lines16 + ["Expected wall: ~2 hr (parallel) · cost ~$6 (2 × H100 × 2hr)"]
    let manifest_lines18 = manifest_lines17 + [""]
    let mlines = manifest_lines18
    let mut mbody = ""
    let mut k = 0
    let mn = len(mlines)
    while k < mn {
        mbody = mbody + mlines[k] + "\n"
        k = k + 1
    }
    let mpath = wdir + "/README.md"
    if mode == "dry-run" {
        println("=== [dry-run] would emit manifest: " + mpath + "  (" + to_string(len(mbody)) + " bytes)")
    } else {
        write_file(mpath, mbody)
        println("[emit] " + mpath + "  (" + to_string(len(mbody)) + " bytes)")
    }
}

// -------------------------------------------------------------------
// main — args() → parse → emit
// -------------------------------------------------------------------

fn main() {
    let cfg = _t1_parse_argv(args())
    if cfg["mode"] == "help" {
        _t1_usage()
        return
    }
    println("[track1-launcher] mode=" + cfg["mode"] + "  uid=" + cfg["uid"])
    _t1_emit(cfg)
    println("[track1-launcher] done.")
    if cfg["mode"] == "dry-run" {
        println("[track1-launcher] re-run with `emit` to actually write the .sh files.")
    }
}
