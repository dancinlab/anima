// dispatch_s126.hexa — §125 PCN-C4 RunPod GPU dispatch, hexa-native.
//
// Full hexa-native port of the original dispatch_s126_runpod.sh. The
// shell-string class — the L145 `/* */` glob-explosion bug — is now
// unrepresentable: every remote command is a structured argv list via
// stdlib/cloud, every RunPod GraphQL call goes through stdlib/cloud/runpod
// (which itself sits on stdlib/http + stdlib/alloc/json_object), and every
// file transfer goes through cloud_copy_to / cloud_copy_from. The only
// shell-out left is `secret` (read api key) and `sleep`.
//
// Run:  hexa run dispatch_s126.hexa        (pipe through tee for a log file)
// Requires stdlib/cloud + stdlib/cloud/runpod in the hexa-lang checkout
// (landed on main: PR #81 cycle-A, PR #84 B-1 copy, PR #86 B-2 runpod).

use "stdlib/cloud/cloud"
use "stdlib/cloud/runpod"

// ── helpers ──────────────────────────────────────────────────────────

fn _log(msg: str) {
    println(msg)
}

// _sleep — block N seconds. Shells out (the `sleep` builtin is bind-listed
// but not codegen-wired for compiled hexa); N is our own int — safe.
fn _sleep(secs: int) {
    exec("sleep " + to_string(secs))
}

// _teardown — terminate the pod unless save==1.
fn _teardown(api_key: str, pod_id: str, save: int) {
    if len(pod_id) == 0 {
        return
    }
    if save == 1 {
        _log("[teardown] save=1 — pod " + pod_id + " RETAINED for manual recovery")
        return
    }
    _log("[teardown] terminating pod " + pod_id)
    runpod_terminate(api_key, pod_id)
}

// _fail — write a failure marker, tear the pod down, and exit non-zero.
fn _fail(api_key: str, pod_id: str, marker_path: str, marker_text: str, msg: str) {
    _log("FATAL: " + msg)
    write_file(marker_path, marker_text + " " + utc_iso_now() + "\n")
    _teardown(api_key, pod_id, 0)
    exit(1)
}

// ── main ─────────────────────────────────────────────────────────────

fn main() {
    let s126_dir   = "/Users/ghost/core/anima/state/pcn_fire_s126_2026_05_20"
    let s16_dir    = "/Users/ghost/core/anima/state/carving_dataregime_s16_2026_05_18"
    let build_dir  = "/Users/ghost/core/anima/state/corpus_s101_build_s102_2026_05_19"
    let anchor_dir = "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors"
    let podid_file = s126_dir + "/s126_pod_id.txt"
    let fail_marker = s126_dir + "/S126_FAILURE.txt"
    let expect_corpus_sha = "39d581da209615468c1c41e07aa8662ef1074bc5be49a666f8f861753dd5810e"
    let ssh_tries = 90
    let image = "runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04"
    let gpus = ["NVIDIA A100-SXM4-80GB", "NVIDIA A100 80GB PCIe", "NVIDIA H100 80GB HBM3", "NVIDIA H100 NVL", "NVIDIA H100 PCIe"]
    let pcn_steps = 3000
    let pcn_bsz = 32
    let pcn_lr = "3e-4"

    _log("=== §125 PCN-C4 dispatch (hexa) start " + utc_iso_now() + " ===")

    let rk = exec("secret get runpod.api_key 2>/dev/null").trim()
    if len(rk) == 0 {
        _log("FATAL no runpod key (secret get runpod.api_key empty)")
        exit(1)
    }
    let pubkey = read_file(env_var("HOME") + "/.ssh/id_ed25519.pub").trim()
    if len(pubkey) == 0 {
        _log("FATAL no ~/.ssh/id_ed25519.pub")
        exit(1)
    }

    // --- pod create: GPU cascade -------------------------------------
    _log("[create] runpod_create_cascade across " + to_string(len(gpus)) + " GPU types")
    let pod = runpod_create_cascade(rk, gpus, image, pubkey, "s126-noncrossff")
    if pod.ok != 1 {
        _log("FATAL " + pod.message)
        exit(1)
    }
    _log("[create] " + pod.message + " — pod " + pod.pod_id)
    write_file(podid_file, pod.pod_id + "\n")

    // --- SSH-readiness wait (port query + actual echo handshake) ----
    _log("[ssh-wait] runpod_wait_ssh (up to ~" + to_string(ssh_tries * 10) + "s)")
    let p = runpod_wait_ssh(rk, pod.pod_id, ssh_tries, 10)
    if p.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "SSH_NEVER_READY pod=" + pod.pod_id, p.message)
    }
    _log("[ssh-ready] " + p.ip + ":" + p.port)

    let host = "root@" + p.ip
    let opts = runpod_pod_opts(p.port)

    // --- stage: mirror the repo layout, upload inputs ----------------
    let s126r = "/workspace/s126r"
    let build_rel = "state/corpus_s101_build_s102_2026_05_19"
    let s16_rel = "state/carving_dataregime_s16_2026_05_18"
    let anchor_rel = "HEXAD/UNIVERSE-BRAIN-MAP/anchors"
    let mk = cloud_run_opts(host, opts, ["mkdir", "-p", s126r + "/" + build_rel, s126r + "/" + s16_rel, s126r + "/" + anchor_rel, s126r + "/out_main"])
    if mk.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "MKDIR_FAILED", "remote mkdir failed: " + mk.message)
    }
    _log("[stage] uploading inputs (cloud_copy_to)")
    let u1 = cloud_copy_to_opts(host, opts, build_dir + "/build_corpus_s101.py", s126r + "/" + build_rel + "/build_corpus_s101.py")
    let u2 = cloud_copy_to_opts(host, opts, s16_dir + "/corpus_carving_s16_generator.py", s126r + "/" + s16_rel + "/corpus_carving_s16_generator.py")
    let u3 = cloud_copy_to_opts(host, opts, s16_dir + "/conscious_decoder.py", s126r + "/conscious_decoder.py")
    let u4 = cloud_copy_to_opts(host, opts, s126_dir + "/train_pcn_s126.py", s126r + "/train_pcn_s126.py")
    let u5 = cloud_copy_to_opts(host, opts, s126_dir + "/eval_pcn_s126.py", s126r + "/eval_pcn_s126.py")
    if u1.ok != 1 || u2.ok != 1 || u3.ok != 1 || u4.ok != 1 || u5.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "UPLOAD_FAILED", "one or more scp uploads failed")
    }
    // anchor knuth_*.kosmos — read by build_corpus_s101.py via
    // sorted(KOSMOS_DIR.glob("*.kosmos")). Without these the corpus body
    // differs from the §107 design baseline and the sha guard refuses to
    // train. Iterate `ls ... 2>/dev/null` output, split on newline.
    _log("[stage] uploading anchor kosmos files")
    let kosmos_ls = exec("ls " + anchor_dir + "/knuth_*.kosmos 2>/dev/null").trim()
    let kosmos_files = kosmos_ls.split("\n")
    let mut ki = 0
    let mut kosmos_ok = 1
    while ki < len(kosmos_files) {
        let lp = kosmos_files[ki]
        if len(lp) > 0 {
            let bn = lp.substring(len(anchor_dir) + 1, len(lp))
            let r = cloud_copy_to_opts(host, opts, lp, s126r + "/" + anchor_rel + "/" + bn)
            if r.ok != 1 {
                kosmos_ok = 0
            }
        }
        ki = ki + 1
    }
    if kosmos_ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "KOSMOS_UPLOAD_FAILED", "one or more kosmos uploads failed")
    }

    // --- pod-side deterministic corpus build + sha ASSERT ------------
    let corpus_pod = s126r + "/" + build_rel + "/corpus_s101.jsonl"
    _log("[build] pod-side deterministic CORPUS_S101 build (seed 1337)")
    let bld = cloud_run_opts(host, opts, ["python3", s126r + "/" + build_rel + "/build_corpus_s101.py", "--out-dir", s126r + "/" + build_rel, "--s1-n", "777000", "--seed", "1337"])
    if bld.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "CORPUS_BUILD_FAILED", "corpus build failed: " + bld.message)
    }
    let sha_r = cloud_run_opts(host, opts, ["sha256sum", corpus_pod])
    let got_sha = sha_r.stdout_.trim().substring(0, 64)
    _log("[build] corpus sha = " + got_sha + "  (expect " + expect_corpus_sha + ")")
    if got_sha != expect_corpus_sha {
        _fail(rk, pod.pod_id, fail_marker, "CORPUS_SHA_MISMATCH got=" + got_sha, "CORPUS_S101 sha mismatch — refuse to train")
    }
    _log("[build] CORPUS_S101 sha VERIFIED == §107 design corpus byte-identical")

    // --- train (FF, per-layer local objective; nohup, detached) ------
    _log("[train] §125 NONCE-FF d768·12L·283M from-scratch seed 1337, " + to_string(pcn_steps) + " steps")
    let train_argv = ["python3", "-u", s126r + "/train_pcn_s126.py", "--mode", "main", "--corpus", corpus_pod, "--out-dir", s126r + "/out_main", "--steps", to_string(pcn_steps), "--seed", "1337", "--lr", pcn_lr, "--bsz", to_string(pcn_bsz), "--d-model", "768", "--n-layer", "12", "--n-head", "12", "--n-kv-head", "4"]
    let tr = cloud_nohup_opts(host, opts, train_argv, s126r + "/train.log")
    if tr.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "TRAIN_LAUNCH_FAILED", "train launch failed: " + tr.message)
    }
    _log("[train] launched — remote pid " + to_string(tr.pid))

    // --- poll: DONE (ckpt) | ALIVE | DEAD; bounded, fail-fast --------
    // Each probe is two structured-argv calls — no `sh -c`. `test -f`
    // exit 0 = ckpt exists; `pgrep` exit 0 = trainer alive, 1 = gone; a
    // negative exit_code = ssh could not verify the pod (a strike).
    let ckpt = s126r + "/out_main/ckpt_pcn_s126.pt"
    // 10 strikes (vs the original .sh's 3): the §125 PCN-FF training warmup
    // intermittently saturates the pod's sshd in the first few minutes, and
    // 3 consecutive misses (3 min) over-strikes a recoverable connection.
    // ssh keepalive on the cloud_run side (ServerAliveInterval=15 in
    // runpod_pod_opts) keeps actually-live ssh from being mistaken for dead.
    let max_strikes = 10
    let mut strikes = 0
    let mut done = 0
    let mut pi2 = 0
    while pi2 < 180 {
        let mut state = "miss"
        let ck = cloud_run_opts(host, opts, ["test", "-f", ckpt])
        if ck.exit_code == 0 {
            state = "done"
        } else if ck.exit_code >= 0 {
            let pg = cloud_run_opts(host, opts, ["pgrep", "-f", "train_pcn_s126.py"])
            if pg.exit_code == 0 {
                state = "alive"
            } else if pg.exit_code > 0 {
                state = "dead"
            }
        }
        if state == "done" {
            _log("[train] done iter " + to_string(pi2))
            done = 1
            pi2 = 180
        } else if state == "alive" {
            strikes = 0
            _sleep(60)
            pi2 = pi2 + 1
        } else if state == "dead" {
            let tl = cloud_run_opts(host, opts, ["tail", "-60", s126r + "/train.log"])
            _log(tl.stdout_)
            _fail(rk, pod.pod_id, fail_marker, "TRAIN_CRASHED", "trainer died before producing ckpt (iter " + to_string(pi2) + ")")
        } else {
            strikes = strikes + 1
            _log("[train] probe miss " + to_string(strikes) + "/" + to_string(max_strikes) + " (iter " + to_string(pi2) + " — ssh could not verify pod)")
            if strikes >= max_strikes {
                _fail(rk, pod.pod_id, fail_marker, "POD_UNVERIFIABLE", "pod unverifiable for " + to_string(max_strikes) + " consecutive probes")
            }
            _sleep(60)
            pi2 = pi2 + 1
        }
    }
    if done == 0 {
        _fail(rk, pod.pod_id, fail_marker, "TRAIN_NO_CKPT", "ckpt never produced within poll budget")
    }

    // --- eval (§125 §96-Q2 verdict bucket) ---------------------------
    _log("[eval] §125 §96-Q2 verdict eval")
    let result_pod = s126r + "/result.json"
    let ev = cloud_run_opts(host, opts, ["python3", "-u", s126r + "/eval_pcn_s126.py", "--ckpt", ckpt, "--corpus", corpus_pod, "--out", result_pod, "--n-eval", "2000", "--max-len", "128", "--seed", "1337"])
    if ev.ok != 1 {
        let el = cloud_run_opts(host, opts, ["tail", "-30", s126r + "/eval.log"])
        _log(el.stdout_)
        _fail(rk, pod.pod_id, fail_marker, "EVAL_FAILED", "eval failed: " + ev.message)
    }

    // --- pull results (5-retry) --------------------------------------
    let mut pulled = 0
    let mut k = 0
    while k < 5 {
        let a = cloud_copy_from_opts(host, opts, result_pod, s126_dir + "/result.json")
        let b = cloud_copy_from_opts(host, opts, ckpt, s126_dir + "/ckpt_s126.pt")
        let c = cloud_copy_from_opts(host, opts, s126r + "/train.log", s126_dir + "/s126_train.log")
        let d = cloud_copy_from_opts(host, opts, s126r + "/eval.log", s126_dir + "/s126_eval.log")
        if a.ok == 1 && b.ok == 1 && c.ok == 1 && d.ok == 1 {
            _log("[pull] success try " + to_string(k + 1))
            pulled = 1
            k = 5
        } else {
            _log("[pull] retry " + to_string(k + 1) + " failed; sleep 60")
            _sleep(60)
            k = k + 1
        }
    }
    if pulled == 1 {
        _log("[pull] result.json present locally — pod will terminate")
        _teardown(rk, pod.pod_id, 0)
        _log("=== §125 NONCE-FF pipeline complete " + utc_iso_now() + " ===")
        exit(0)
    }
    write_file(fail_marker, "PULL_FAILED pod=" + pod.pod_id + " ssh=" + p.ip + ":" + p.port + " " + utc_iso_now() + "\n")
    _log("[pull] FAILED 5x — pod " + pod.pod_id + " RETAINED for manual recovery")
    _teardown(rk, pod.pod_id, 1)
    exit(1)
}
