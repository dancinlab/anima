import "/Users/ghost/core/anima/HEXAD/CHAT/spontaneous_lib.hexa"

fn _approx_eq(a: float, b: float, eps: float) -> bool {
    let diff = a - b
    if diff < 0.0 { return (0.0 - diff) <= eps }
    return diff <= eps
}

fn main() {
    print("=== F-S169 RATE-LIMIT-GOVERNANCE-SPLIT falsifier ===")
    print("")

    // F-S169-1 PRODUCTION-UNCHANGED: production variant returns 30.0 verbatim
    let prod = spont_min_emit_interval_production()
    let f1_pass = _approx_eq(prod, 30.0, 1e-9)
    print("F-S169-1 PRODUCTION-UNCHANGED:")
    print("  spont_min_emit_interval_production() = " + to_string(prod)
          + "  expect 30.0  pass=" + to_string(f1_pass))

    // F-S169-1b backward-compat alias: spont_min_emit_interval() = production
    let alias = spont_min_emit_interval()
    let f1b_pass = _approx_eq(alias, prod, 1e-9)
    print("F-S169-1b ALIAS-BACKWARD-COMPAT:")
    print("  spont_min_emit_interval() = " + to_string(alias)
          + "  expect == production " + to_string(prod)
          + "  pass=" + to_string(f1b_pass))

    // F-S169-2 MEASUREMENT-CLOSED-FORM: spont_min_emit_interval_measurement(n,dt) = n*dt/3.0
    let meas_20_01 = spont_min_emit_interval_measurement(20, 0.1)
    let meas_expected = 2.0 / 3.0
    let f2_pass = _approx_eq(meas_20_01, meas_expected, 1e-9)
    print("F-S169-2 MEASUREMENT-CLOSED-FORM:")
    print("  spont_min_emit_interval_measurement(20, 0.1) = " + to_string(meas_20_01)
          + "  expect 20*0.1/3 = " + to_string(meas_expected)
          + "  pass=" + to_string(f2_pass))

    // F-S169-2b multiple (n, dt) points
    let meas_40_01 = spont_min_emit_interval_measurement(40, 0.1)
    let meas_40_01_expect = 4.0 / 3.0
    let f2b_pass = _approx_eq(meas_40_01, meas_40_01_expect, 1e-9)
    let meas_100_005 = spont_min_emit_interval_measurement(100, 0.05)
    let meas_100_005_expect = 5.0 / 3.0
    let f2c_pass = _approx_eq(meas_100_005, meas_100_005_expect, 1e-9)
    print("F-S169-2b MEASUREMENT-MULTI-POINT:")
    print("  meas(40, 0.1) = " + to_string(meas_40_01) + "  expect " + to_string(meas_40_01_expect)
          + "  pass=" + to_string(f2b_pass))
    print("  meas(100, 0.05) = " + to_string(meas_100_005) + "  expect " + to_string(meas_100_005_expect)
          + "  pass=" + to_string(f2c_pass))

    // F-S169-3 CEILING-ACHIEVED: at meas value, ceiling = 1 + floor(T_total/meas) ≥ 4
    // For (20, 0.1): T_total=2.0, meas=0.6667, ceiling = 1 + floor(2.0/0.6667) = 1 + 3 = 4
    let t_total = 2.0
    let extra_raw = t_total / meas_20_01
    let mut floor_extra = 0
    let mut acc = 0.0
    while (acc + 1.0) <= extra_raw {
        acc = acc + 1.0
        floor_extra = floor_extra + 1
    }
    let ceiling_n = 1 + floor_extra
    let f3_pass = ceiling_n >= 4
    print("F-S169-3 CEILING-ACHIEVED:")
    print("  T_total = " + to_string(t_total) + "  meas = " + to_string(meas_20_01))
    print("  ceiling = 1 + floor(" + to_string(t_total) + "/" + to_string(meas_20_01)
          + ") = " + to_string(ceiling_n) + "  expect >= 4  pass=" + to_string(f3_pass))

    // F-S169-4 CONTEXT-DISJOINT: production ≠ measurement (provably distinct in this regime)
    // For (20, 0.1): production=30.0, measurement=0.6667 — clearly distinct
    let f4_pass = !_approx_eq(prod, meas_20_01, 0.01)
    print("F-S169-4 CONTEXT-DISJOINT:")
    print("  |production " + to_string(prod) + " - measurement " + to_string(meas_20_01)
          + "| > 0.01  pass=" + to_string(f4_pass))

    // F-S169-5 SAFETY-INVARIANT: production variant is independent of (n, dt)
    // (sanity: prod-fn takes no args, always returns 30.0 — there is no caller
    // path that could accidentally weaken it by passing measurement params)
    let prod2 = spont_min_emit_interval_production()
    let f5_pass = _approx_eq(prod, prod2, 1e-12)
    print("F-S169-5 SAFETY-INVARIANT (deterministic-zero-arg):")
    print("  prod call 1 = " + to_string(prod) + "  prod call 2 = " + to_string(prod2)
          + "  bit-identical pass=" + to_string(f5_pass))

    print("")
    let all_pass = f1_pass && f1b_pass && f2_pass && f2b_pass && f2c_pass
                   && f3_pass && f4_pass && f5_pass
    print("=== AGGREGATE: " + to_string(all_pass) + " ===")
    if all_pass {
        print("F-S169-1..5 ALL PASS — §169 split LANDED safely.")
        print("Production 30s preserved, measurement closed-form correct,")
        print("ceiling K=4 achieved, contexts disjoint, safety invariant.")
    } else {
        print("FAIL — see individual results above.")
    }
}

