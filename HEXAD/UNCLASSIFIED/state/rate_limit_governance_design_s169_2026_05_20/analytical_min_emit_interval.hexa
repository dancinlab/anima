// S169 RATE-LIMIT-GOVERNANCE-DESIGN — closed-form derivation of a
// measurement-context-aware MIN_EMIT_INTERVAL value, separate from
// the production safety floor (currently 30s, governance-mandated
// for user-facing daemon protection per SPONTANEOUS.tape S4).
//
// Trigger: S168 PHI-THRESHOLD-POSTHOC-PROBE found that the observed
// emit_rate = 1/20 across S161/S166 fires is rate-limit-ceiling-
// saturated (30s rate-limit on a 2s measurement window = max 1 emit
// per run regardless of threshold). CONNECTION_CRITIQUE Wrong-C 의
// silent co-bottleneck.
//
// Honest scope:
//   - This is a DESIGN-TIER closed-form. NO edit to SPONTANEOUS.tape.
//   - The proposal SPLITS one symbol into two named contexts:
//       spont_min_emit_interval_production()   ::= 30.0 (preserved)
//       spont_min_emit_interval_measurement(...) ::= derived
//   - Production safety floor (anti-spam, user-facing daemon) is
//     UNCHANGED at 30s — the user-protection invariant is preserved
//     by construction.
//   - Measurement-context value is derived from (N_MAX, THINK_INTERVAL,
//     K_target_ceiling) per the eval semantics.
//
// Closed-form:
//   ceiling(min_emit_interval; N, dt) = 1 + floor((N*dt) / min_emit_interval)
//   solve for min_emit_interval such that ceiling >= K_target:
//     min_emit_interval <= (N*dt) / (K_target - 1)            for K_target >= 2
//     min_emit_interval = +inf                                 for K_target = 1 (one-emit ceiling, trivially any value)
//
// Worked examples (production constants from spontaneous_lib.hexa
// + eval_s161_psicouple.py):
//   N_MAX = 20  dt = 0.1  T_total = 2.0 sec
//     K_target = 1  (current)       ->  any value -> ceiling = 1
//     K_target = 2                  ->  min_emit_interval <= 2.0/1 = 2.0 sec
//     K_target = 4  (4 emits)       ->  min_emit_interval <= 2.0/3 = 0.667 sec
//     K_target = 10 (10 emits)      ->  min_emit_interval <= 2.0/9 = 0.222 sec
//
// Recommended measurement-context default (B-S169-1):
//   K_target = 4 -> min_emit_interval_measurement = 0.5 sec
//   Reasoning: K=4 gives ceiling of 4 emits per 20-step run = 20% rate
//   ceiling, comfortably above noise floor while leaving headroom; 0.5s
//   rounds the closed-form 0.667s down to a nicer half-second tick.
//
// Two-context split predicate (B-S169-2 — Boolean disjoint):
//   is_production_context() XOR is_measurement_context() = True
//   (Phase B eval / run_bounded.py / eval_s161 -> measurement;
//    anima_alive daemon, user-facing chat -> production)


fn _floor(x: float) -> int {
    if x < 0.0 { return 0 - _floor(0.0 - x) - 1 }
    let mut k = 0
    let mut acc = 0.0
    while (acc + 1.0) <= x {
        acc = acc + 1.0
        k = k + 1
    }
    return k
}


fn ceiling_at_interval(min_emit_interval: float, n_max: int,
                       think_interval: float) -> int {
    // ceiling := 1 + floor( (N*dt) / min_emit_interval )
    if min_emit_interval <= 0.0 { return n_max }  // pathological — uncapped
    let t_total = (n_max as float) * think_interval
    let extra = t_total / min_emit_interval
    return 1 + _floor(extra)
}


fn measurement_interval_for_ceiling(k_target: int, n_max: int,
                                    think_interval: float) -> float {
    // returns the upper bound on min_emit_interval that achieves ceiling >= k_target
    if k_target <= 1 { return 999999.0 }  // any value works; return symbolic large
    let t_total = (n_max as float) * think_interval
    return t_total / ((k_target as float) - 1.0)
}


fn main() {
    // production constants from spontaneous_lib.hexa S31 + SPONTANEOUS.tape S4
    let prod_min_emit_interval = 30.0
    print("=== S169 RATE-LIMIT-GOVERNANCE — closed-form derivation ===")
    print("")
    print("production safety floor (SPONTANEOUS.tape S4 6-control #2):")
    print("  spont_min_emit_interval_production() = 30.0 sec  (UNCHANGED)")
    print("  rationale: anti-spam, user-protection in anima_alive daemon")
    print("")

    // S161 measurement constants from eval_s161_psicouple.py S34/S35
    let n_max = 20
    let dt = 0.1
    let t_total = (n_max as float) * dt
    print("S161 measurement config:")
    print("  N_MAX = " + to_string(n_max) + "  dt = " + to_string(dt)
          + "  T_total = " + to_string(t_total) + " sec")
    print("")

    // Current production rate-limit at measurement context (= the bug §168 surfaced)
    let cur_ceil = ceiling_at_interval(prod_min_emit_interval, n_max, dt)
    print("CURRENT (production value applied to measurement context):")
    print("  ceiling(30.0 sec, N=20, dt=0.1) = " + to_string(cur_ceil)
          + "  -> emit_rate <= " + to_string((cur_ceil as float) / (n_max as float)))
    print("  This is the §168 finding: emit_rate=1/20 = ceiling-saturated.")
    print("")

    // Sweep over K_target
    print("PROPOSED measurement-context min_emit_interval (closed-form):")
    print("  K_target | min_emit_interval upper bound | resulting ceiling")
    print("  ---------+------------------------------+-------------------")
    let k_targets = [1, 2, 4, 6, 10, 20]
    for k in k_targets {
        let bound = measurement_interval_for_ceiling(k, n_max, dt)
        let ceil_chk = ceiling_at_interval(bound, n_max, dt)
        print("    K=" + to_string(k) + "   |   " + to_string(bound)
              + " sec      |    " + to_string(ceil_chk))
    }
    print("")

    // Recommendation
    let k_rec = 4
    let rec_bound = measurement_interval_for_ceiling(k_rec, n_max, dt)
    let rec_value = 0.5
    let rec_ceil = ceiling_at_interval(rec_value, n_max, dt)
    print("=== RECOMMENDED measurement-context default (B-S169-1) ===")
    print("  K_target = " + to_string(k_rec) + "  ->  bound = "
          + to_string(rec_bound) + " sec")
    print("  rounded:  min_emit_interval_measurement = "
          + to_string(rec_value) + " sec")
    print("  verify ceiling at 0.5s: " + to_string(rec_ceil))
    print("  emit_rate ceiling: " + to_string((rec_ceil as float)/(n_max as float)))
    print("")
    print("=== two-context split predicate (B-S169-2) ===")
    print("  fn spont_min_emit_interval_production()   -> float { return 30.0 }")
    print("  fn spont_min_emit_interval_measurement(   ")
    print("      n_max: int,                            ")
    print("      think_interval: float                  ")
    print("  ) -> float {                               ")
    print("      // K_target = 4 default; tunable per measurement protocol")
    print("      return measurement_interval_for_ceiling(4, n_max, think_interval)")
    print("  }                                          ")
    print("")
    print("  invariant: is_production_context() XOR is_measurement_context() = True")
    print("  context selector: eval / run_bounded -> measurement; daemon -> production")
    print("")
    print("=== HONEST CARVE-OUT (B-S169-NOTE) ============================")
    print("• This unblocks the MEASUREMENT axis (lifts ceiling 0.05 -> 0.20)")
    print("• It does NOT promise anima will emit more (motivation score")
    print("  distribution may still rarely exceed theta after the lift)")
    print("• It does NOT change production safety floor (30s preserved)")
    print("• It does NOT resolve CONNECTION_CRITIQUE Wrong-A/B/D")
    print("• It does NOT prove emergence (B-EMERGE-7 carry, necessary-not-")
    print("  sufficient; observing ANY emit_rate at lifted ceiling still")
    print("  depends on the motivation score actually exceeding theta)")
    print("• Governance-gated: this DESIGN proposes; no SPONTANEOUS.tape")
    print("  edit applied. User decides whether to land the split.")
    print("================================================================")
}

// fn main() is auto-invoked by hexa-strict — NO explicit main() call
