fn _t_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ─── cosine LR schedule with warmup (mirror train_p21h_v3.py lr_schedule) ─
pub fn v3_lr_schedule(step: int, total_steps: int, warmup: int,
                      peak_lr: float, min_lr: float) -> float {
    if step < warmup {
        return peak_lr * to_float(step + 1) / to_float(warmup)
    }
    let denom = if total_steps - warmup > 1 { total_steps - warmup } else { 1 }
    let mut progress = to_float(step - warmup) / to_float(denom)
    if progress < 0.0 { progress = 0.0 }
    if progress > 1.0 { progress = 1.0 }
    // cos_factor = 0.5·(1 + cos(π·progress)) — flame_math d5_cos
    let pi = 3.141592653589793
    let cos_factor = 0.5 * (1.0 + d5_cos(pi * progress))
    return min_lr + (peak_lr - min_lr) * cos_factor
}

// ─── grad-norm clip over packed Mg (mirror clip_grad_norm_ max_norm=1) ──
// total_norm = sqrt(Σ g²) ; if > max_norm scale all grads by max_norm/total.
pub fn v3_clip_grad_norm(Mg: int, n: int, max_norm: float) -> float {
    let mut sq = 0.0
    let mut i = 0
    while i < n {
        let g = farr_get(Mg, i)
        sq = sq + g * g
        i = i + 1
    }
    let total_norm = dt_sqrt(sq)
    if total_norm > max_norm && total_norm > 0.0 {
        let scale = max_norm / total_norm
        let mut j = 0
        while j < n {
            let _ = farr_set(Mg, j, farr_get(Mg, j) * scale)
            j = j + 1
        }
    }
    return total_norm
}

// ════════════════════════════════════════════════════════════════════════
// AXIS-MAP V3 double-bind breakthrough axes (M1 — actual training logic).
//
// Prior state: train_p21h_v3.py:666-672 was an argparse + print() STUB — the
// axis flags were read back to stdout but NEVER reached the train loop (the
// H_257 "silent-bypass" bug: corpus-axis ⊥ register, but the axes were inert
// so no Δ vs baseline could ever appear). M0 completed the V3 backward
// (v3_purefield_bwd / v3_head_g_bwd / v3_tension_proj_bwd, gradcheck PASS rel
// 5e-10). These helpers wire the 4 axes ONTO that backward so each flag
// produces a DIFFERENT training dynamic (the M2 gate proves DIFFERENT, not
// byte-equal — the inverse of the prior axis-B == axis-F init_CE 14.1780 bug).
//
// NO new flame API — pure leaf arithmetic over the packed grad/M buffers.
// ════════════════════════════════════════════════════════════════════════

// ─── AXIS D: freeze embed / tied-lm_head ────────────────────────────────
// The tok_emb slot [0 .. V·d) IS the input embedding AND (tied) the head_a
// LM head. freeze=1 zeroes that slot's grad in the accumulator BEFORE AdamW
// so the embedding/lm_head receive NO update (weight-decay also masked by the
// zero grad — opt_adamw_step's decoupled wd still acts, so we additionally
// pin those params by skipping them; here we mask grad only, matching torch
// `param.requires_grad_(False)` which leaves wd off since the optimizer never
// sees a frozen param. For byte-faithful freeze we zero the grad slice — the
// AdamW m/v for that slice stay 0, so the update term = 0).
// Returns the grad-norm of the embed slice (the falsifier readout — must be
// 0.0 when freeze applied, > 0.0 when not).
pub fn axis_d_freeze_embed(Mg_acc: int, freeze: int, V: int, d: int) -> float {
    let n_emb = V * d                       // tok_emb slot = [0 .. V·d)
    // measure the embed-slice grad-norm BEFORE masking (the falsifier value)
    let mut sq = 0.0
    let mut i = 0
    while i < n_emb {
        let g = farr_get(Mg_acc, i)
        sq = sq + g * g
        i = i + 1
    }
    let pre_norm = dt_sqrt(sq)
    if freeze == 1 {
        let mut j = 0
        while j < n_emb {
            let _ = farr_set(Mg_acc, j, 0.0)
            j = j + 1
        }
    }
    return pre_norm
}

// grad-norm of a packed slot [off .. off+n) — falsifier readout helper.
pub fn axis_slot_grad_norm(Mg: int, off: int, n: int) -> float {
    let mut sq = 0.0
    let mut i = 0
    while i < n {
        let g = farr_get(Mg, off + i)
        sq = sq + g * g
        i = i + 1
    }
    return dt_sqrt(sq)
}

// ─── AXIS A: curriculum corpus mix ──────────────────────────────────────
// step-scheduled blend of two corpora (early = wiki-only, late = anima
// introduced). The mix is a per-step anima fraction in [0,1]:
//   step < phase_steps        → anima_frac = 0.0   (wiki-only warmup)
//   phase_steps ≤ step < 2·ph → anima_frac ramps 0→1 (linear introduction)
//   step ≥ 2·phase_steps      → anima_frac = 1.0   (anima-dominant)
// phase_steps == 0 disables (anima_frac fixed at the baseline 0.5 blend).
// Returns the anima fraction for this step (the falsifier readout — the value
// MUST change across the phase boundary).
pub fn axis_a_anima_frac(step: int, phase_steps: int) -> float {
    if phase_steps <= 0 {
        return 0.5            // off → fixed 50/50 baseline blend
    }
    if step < phase_steps {
        return 0.0            // phase-0: wiki-only
    }
    if step < 2 * phase_steps {
        // phase-1: linear ramp anima 0 → 1 over [phase, 2·phase)
        let num = to_float(step - phase_steps)
        let den = to_float(phase_steps)
        return num / den
    }
    return 1.0               // phase-2: anima-dominant
}

// pick which corpus a given window draws from, given the per-step anima
// fraction. Deterministic interleave: window index s gets anima if its
// fractional position < anima_frac (low-discrepancy, no RNG so the mix is
// reproducible + the falsifier byte-stable).
//   anima_count = round(anima_frac · nsamp)  → first anima_count windows anima.
// returns 1 if window s should use the anima corpus, else 0 (wiki).
pub fn axis_a_window_is_anima(s: int, nsamp: int, anima_frac: float) -> int {
    // anima_count = floor(anima_frac · nsamp + 0.5)
    let ac_f = anima_frac * to_float(nsamp) + 0.5
    let anima_count = to_int(ac_f)
    if s < anima_count { return 1 }
    return 0
}

// ─── AXIS C: head_g objective (anima-register dual-head) ─────────────────
// AXIS-MAP head_g_objective: head_a = pure-multilingual (tied-tok_emb CE on
// the wiki target), head_g = anima-register objective (CE on the anima
// target). When the objective is OFF the head_g CE is computed but its grad
// is NOT applied (head_g stays "inert" — the R4 "head_g moot" baseline).
// When ON, v3_headg_grad's dl (the logits_g CE grad) flows into the head_g
// slot AND a register-weight λ_g scales the head_g CE in L_total — the
// anima-register objective ESCAPES the inert state.
//
// This helper computes the head_g objective scale: 0.0 when off (grad zeroed
// downstream), λ_g when on. The TARGET for head_g is the anima-register
// target (axis-A's anima window target), distinct from head_a's wiki target —
// that DUAL-TARGET split is what makes head_g carry a register objective the
// pure-multilingual head_a does not. Returns λ_g (the falsifier: head_g loss
// term > 0 ⟺ objective ON ⟺ escape from "head_g moot").
pub fn axis_c_headg_lambda(head_g_obj_on: int, lambda_g: float) -> float {
    if head_g_obj_on == 1 { return lambda_g }
    return 0.0
}

// zero the head_g slot grad (used when axis-C objective is OFF → keeps head_g
// inert / moot, the R4 baseline that axis-C must beat).
pub fn axis_c_zero_headg_grad(Mg_acc: int, hg_off: int, V: int, d: int) {
    let n_hg = V * d
    let mut i = 0
    while i < n_hg {
        let _ = farr_set(Mg_acc, hg_off + i, 0.0)
        i = i + 1
    }
}

// ─── AXIS B: knowledge distillation (teacher → student KD loss) ──────────
// KD objective: soft-target CE between the student's logits and a teacher's
// soft logits at temperature τ. The KD grad on the student's last-position
// logits is:
//   p_s[k] = softmax(student_logits / τ)[k]
//   q_t[k] = softmax(teacher_logits / τ)[k]
//   L_kd   = τ² · Σ_k q_t[k] · (ln q_t[k] − ln p_s[k])     (KL(q_t‖p_s)·τ²)
//   dL_kd/d(student_logits[k]) = τ · (p_s[k] − q_t[k])
// The τ² scale (Hinton 2015) keeps the KD grad magnitude comparable to the
// hard-CE grad. This helper computes L_kd AND accumulates dL_kd into the
// student-logits grad buffer dl_kd_out [V] (caller routes it through the
// head's backward — for the tied head_a that is the lm_head bwd; here we
// route the KD grad through the SAME head_g backward path as a register-KD
// term, so the teacher signal reaches the packed grad).
//
// teacher_logits [V] : the teacher's last-position logits for this window.
//   HONEST TODO #B1: a real teacher ckpt load (HF AutoModel / flame_load_pt)
//   is out of smoke-tier scope. The DUMMY teacher = the student's OWN logits
//   perturbed by a fixed offset (so q_t ≠ p_s → L_kd ≠ 0, the falsifier). A
//   production fire supplies real teacher_logits via flame_load_pt.hexa +
//   v3_forward_logits on the teacher M. The KD MATH below is production-ready;
//   only the teacher_logits SOURCE is the dummy.
// Returns L_kd (the falsifier: KD loss term ≠ 0 ⟺ teacher signal in grad).
pub fn axis_b_kd_loss(student_logits: int, teacher_logits: int,
                      dl_kd_out: int, temperature: float, V: int) -> float {
    let tau = if temperature > 0.0 { temperature } else { 1.0 }
    // student softmax at τ — stable max over τ-scaled logits
    let mut mxs = farr_get(student_logits, 0) / tau
    let mut i0 = 1
    while i0 < V {
        let zs = farr_get(student_logits, i0) / tau
        if zs > mxs { mxs = zs }
        i0 = i0 + 1
    }
    let ps = farr_zeros(V)
    let mut ts = 0.0
    let mut i1 = 0
    while i1 < V {
        let e = dt_exp(farr_get(student_logits, i1) / tau - mxs)
        let _ = farr_set(ps, i1, e)
        ts = ts + e
        i1 = i1 + 1
    }
    // teacher softmax at τ
    let mut mxt = farr_get(teacher_logits, 0) / tau
    let mut i2 = 1
    while i2 < V {
        let zt = farr_get(teacher_logits, i2) / tau
        if zt > mxt { mxt = zt }
        i2 = i2 + 1
    }
    let qt = farr_zeros(V)
    let mut tt = 0.0
    let mut i3 = 0
    while i3 < V {
        let e = dt_exp(farr_get(teacher_logits, i3) / tau - mxt)
        let _ = farr_set(qt, i3, e)
        tt = tt + e
        i3 = i3 + 1
    }
    // L_kd = τ²·Σ q·(ln q − ln p) ; grad = τ·(p − q)
    let mut l_kd = 0.0
    let mut k = 0
    while k < V {
        let p_k = farr_get(ps, k) / ts
        let q_k = farr_get(qt, k) / tt
        let ln_q = dt_ln(q_k + 0.0000000001)
        let ln_p = dt_ln(p_k + 0.0000000001)
        l_kd = l_kd + q_k * (ln_q - ln_p)
        // dL_kd/d(student_logit[k]) = τ·(p_k − q_k)
        let _ = farr_set(dl_kd_out, k, tau * (p_k - q_k))
        k = k + 1
    }
    let _ = farr_free(ps)
    let _ = farr_free(qt)
    return tau * tau * l_kd
}

