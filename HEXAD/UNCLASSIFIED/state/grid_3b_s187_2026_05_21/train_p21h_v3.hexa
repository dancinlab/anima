// extract nsamp windows of T ids + 1 target
let IDS = t_zeros(nsamp * T)
let YS = t_zeros(nsamp)
let mut s = 0
while s < nsamp {
    let off = s * stride
    if off + T < n_bytes {
        let mut p = 0
        while p < T {
            t_set(IDS, s * T + p, to_float(bytes_arr[off + p]))
            p = p + 1
        }
        t_set(YS, s, to_float(bytes_arr[off + T]))
    }
    s = s + 1
}

// ── model + mitosis pool ──
// V3 packed M (V2 spine + head_g/tension_proj/purefield/cross slots).
let m_size = v3_m_total(d, nh, nkv, h, V, n_layer, cdim)
print("  V3 model size: "); print(m_size); print(" doubles (");
print(v3_count_params(d, nh, nkv, h, V, n_layer, cdim)); println(" params)")
let M = t_zeros(m_size)
v3_init(M, seed, T, d, nh, nkv, h, V, n_layer, cdim)

// AdamW moments + grad packs. M0 UPDATE: sized to the FULL V3 m_size (not
// just the V2 spine) so the V3-extension params (head_g) receive AdamW
// updates from v3_headg_grad. The V2-spine closed-vjp (nn_decoder_grad)
// writes only spine offsets; the V3-extension backward (v3_head_g_bwd via
// v3_headg_grad) writes the head_g slot — both accumulate into the same
// full-size Mg_acc, and AdamW runs over the full m_size.
let spine_size = m_total(d, nh, nkv, h, V, n_layer)
let Mm = t_zeros(m_size)
let Mv = t_zeros(m_size)
let Mg = t_zeros(m_size)
let Mg_acc = t_zeros(m_size)
let d_zT_scratch = t_zeros(d)   // M0: head_g bwd's zT-grad sink
let mc_size = mc_total(T, d, nh, nkv, h, V, n_layer)
let Mc = t_zeros(mc_size)
let cos_tab = t_zeros(T * hd)
let sin_tab = t_zeros(T * hd)
nn_rope_build_tables(T, hd, cos_tab, sin_tab)

// mitosis cell pool (d_model cells)
let mut pool = cell_pool_init(d, 2, seed, 128)
print("  mitosis pool init: cells="); print(len(pool["cells"])); println("")

// V3-forward output buffers (logits_a, logits_g, per-layer tension, zT)
let logits_a = t_zeros(V)
let logits_g = t_zeros(V)
let tension_pl = t_zeros(n_layer)
let zT_buf = t_zeros(d)          // M0: final-RMSNorm last-token state

// ids scratch (per window)
let ids_scratch = t_zeros(T)
fn _window_ids(IDS: int, s: int, T: int, ids_out: int) {
    let mut p = 0
    while p < T {
        let _ = farr_set(ids_out, p, farr_get(IDS, s * T + p))
        p = p + 1
    }
}

// ── sanity: one V3 full forward (smoke check the composition wires) ──
println("  --- V3 forward sanity (window 0) ---")
_window_ids(IDS, 0, T, ids_scratch)
v3_forward_logits(ids_scratch, M, logits_a, logits_g, tension_pl, zT_buf,
                  cos_tab, sin_tab, T, d, nh, nkv, h, V, n_layer, cdim,
                  gate_strength, 1, noise_sigma, seed + 99)
