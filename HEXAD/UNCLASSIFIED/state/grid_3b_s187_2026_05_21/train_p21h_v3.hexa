// ─── AXIS-MAP flags (M1 wired + M3 dispatch-controllable via env-vars) ──
// The H_257 bug was that train_p21h_v3.py declared these as argparse flags the
// AXIS_MAP-FAN dispatcher set as ENV-VARS the .py never read (→ every axis ran
// the same default → axis B == axis F init_CE byte-equal). Here the hexa driver
// ACTUALLY READS the P21H_* env-vars: M3 fans 4 pods, each pod exports a
// different axis config, and the readouts differ (H_257 fix verified by setting
// P21H_FREEZE_EMBED=0 → embed_post > 0). Defaults = the smoke config so a bare
// local run still exercises every axis for the falsifier gate.
fn _env_int(name: string, dflt: int) -> int {
    let v = exec("printf %s \"${" + name + ":-}\"").trim()
    if len(v) == 0 { return dflt }
    return to_int(v.parse_float())
}
fn _env_float(name: string, dflt: float) -> float {
    let v = exec("printf %s \"${" + name + ":-}\"").trim()
    if len(v) == 0 { return dflt }
    return v.parse_float()
}
let freeze_embed = _env_int("P21H_FREEZE_EMBED", 1)              // axis D
let curriculum_phase_steps = _env_int("P21H_CURRICULUM_PHASE_STEPS", 2) // axis A
let head_g_objective_on = _env_int("P21H_HEAD_G_OBJECTIVE", 1)  // axis C on/off
let lambda_g = _env_float("P21H_LAMBDA_G", 0.3)                 // axis C weight
let distill_on = _env_int("P21H_DISTILL_ON", 1)                 // axis B on/off
let kd_temperature = _env_float("P21H_KD_TEMPERATURE", 2.0)     // axis B τ
let lambda_kd = _env_float("P21H_LAMBDA_KD", 0.5)              // axis B weight

