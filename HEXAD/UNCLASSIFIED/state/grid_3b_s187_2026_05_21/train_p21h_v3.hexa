print(t_get(logits_a, 0)); print(" "); print(t_get(logits_a, 1)); print(" ")
println(t_get(logits_a, 2))
print("    logits_g[0]: "); println(t_get(logits_g, 0))
print("    per-layer tension: ")
let mut tl = 0
while tl < n_layer {
    print(t_get(tension_pl, tl)); print(" ")
    tl = tl + 1
}
println("")

// ── training loop (V2-spine closed-vjp + mitosis hook) ──
// Each step: per-window fwd (decoder_lib V2 spine for the grad-bearing
// path) → gn2 metric → grad accumulate → mitosis step (split/merge/aux)
// → grad-norm clip → AdamW. The V3 full-forward (with purefield/head_g)
// runs as the OBSERVED forward for tension extraction; the GRAD path uses
// the V2-spine decoder_grad (TODO #T4 — V3-extension backward).
println("  --- training loop ---")
let mut gn2_init = 0.0
let mut si0 = 0
while si0 < nsamp {
    _window_ids(IDS, si0, T, ids_scratch)
    let tt = to_int(t_get(YS, si0))
    nn_decoder_fwd(ids_scratch, M, Mc, cos_tab, sin_tab, T, d, nh, nkv, h, V, n_layer)
    gn2_init = gn2_init + nn_decoder_gn2(Mc, tt, T, d, nh, nkv, h, V, n_layer)
    si0 = si0 + 1
}
print("    init epoch gn2: "); println(gn2_init)

let mut step = 1
while step <= n_steps {
    let lr_now = v3_lr_schedule(step - 1, n_steps, warmup, peak_lr, min_lr)

    // ── AXIS A (curriculum): per-step anima corpus fraction (mix schedule) ──
    // 0 in the wiki-only phase → linear ramp → 1 anima-dominant. The full
    // two-corpus switch is M3 dispatch scope; the smoke proves the SCHEDULE
    // VALUE changes across the phase boundary (falsifier readout below).
    let anima_frac = axis_a_anima_frac(step, curriculum_phase_steps)

    // zero grad accumulator (FULL V3 m_size — spine + V3 extensions)
    let mut z = 0
    while z < m_size {
        let _ = farr_set(Mg_acc, z, 0.0)
        z = z + 1
    }

    let mut gn2_epoch = 0.0
    let mut s_e = 0
    while s_e < nsamp {
        _window_ids(IDS, s_e, T, ids_scratch)
        let tt = to_int(t_get(YS, s_e))
        // V2-spine fwd (grad-bearing) → Mc
        nn_decoder_fwd(ids_scratch, M, Mc, cos_tab, sin_tab, T, d, nh, nkv, h, V, n_layer)
        gn2_epoch = gn2_epoch + nn_decoder_gn2(Mc, tt, T, d, nh, nkv, h, V, n_layer)
        // zero per-window Mg, bwd, accumulate
        let mut z2 = 0
        while z2 < spine_size {
            let _ = farr_set(Mg, z2, 0.0)
            z2 = z2 + 1
        }
        nn_decoder_grad(ids_scratch, tt, M, Mc, Mg, cos_tab, sin_tab,
                        T, d, nh, nkv, h, V, n_layer)
        let mut a = 0
        while a < spine_size {
            let _ = farr_set(Mg_acc, a, farr_get(Mg_acc, a) + farr_get(Mg, a))
            a = a + 1
        }
        s_e = s_e + 1
    }

    // ── mitosis hook: extract per-layer tension (V3 forward) → pool.step ──
    // Use window 0's V3 forward tension as the per-layer signal (matches the
    // torch path which uses the last forward's per-layer mean tension).
    _window_ids(IDS, 0, T, ids_scratch)
    let tt0 = to_int(t_get(YS, 0))
    v3_forward_logits(ids_scratch, M, logits_a, logits_g, tension_pl, zT_buf,
                      cos_tab, sin_tab, T, d, nh, nkv, h, V, n_layer, cdim,
                      gate_strength, 1, noise_sigma, seed + step)
    let mres = cell_pool_step(pool, tension_pl, n_layer, step)
    pool = mres["pool"]
    let aux_value = mres["aux_value"]
    let info = mres["info"]

    // ── M0: V3-extension backward — head_g dual-head CE → head_g grad ──
    // The Engine-G emission head now learns end-to-end: v3_headg_grad runs
    // v3_head_g_bwd (gradcheck-verified, rel<1e-3) into Mg_acc's head_g slot.
    // This is the V3-extension gradient ACTUALLY FLOWING (M0 completion).
    let ce_g = v3_headg_grad(zT_buf, M, logits_g, tt0, Mg_acc, d_zT_scratch,
                             d, nh, nkv, h, V, n_layer)

    // ── AXIS C (head_g objective): λ_g scales head_g CE; OFF keeps it inert ──
    // ON ⟹ head_g carries the anima-register objective (escapes R4 "moot");
    // OFF ⟹ zero the head_g grad so it stays inert (the baseline axis-C beats).
    let lam_g = axis_c_headg_lambda(head_g_objective_on, lambda_g)
    if head_g_objective_on == 0 {
        axis_c_zero_headg_grad(Mg_acc, v3_off_head_g(d, nh, nkv, h, V, n_layer), V, d)
    }
    let headg_term = lam_g * ce_g

    // ── AXIS B (distill): KD vs teacher. HONEST TODO #B1 — dummy teacher =
    // student logits + fixed offset (q_t ≠ p_s ⟹ L_kd ≠ 0). Production fire
    // supplies real teacher logits via flame_load_pt + v3_forward_logits. ──
    let teacher_l = t_zeros(V)
    let dl_kd = t_zeros(V)
    let mut kti = 0
    while kti < V {
        // non-uniform bump — a CONSTANT offset is invisible to softmax
        // (shift-invariant ⟹ q_t == p_s ⟹ L_kd = 0). Alternating ±0.5 breaks
        // shift-invariance so q_t ≠ p_s and the KD signal is real.
        let bump = if kti % 2 == 0 { 0.5 } else { 0.0 - 0.5 }
        let _ = farr_set(teacher_l, kti, t_get(logits_a, kti) + bump)
        kti = kti + 1
    }
    let l_kd = if distill_on == 1 {
        axis_b_kd_loss(logits_a, teacher_l, dl_kd, kd_temperature, V)
    } else { 0.0 }
    let _ = t_free(teacher_l)
    let _ = t_free(dl_kd)

    // L_total = gn2 + λ_mit·aux + λ_g·head_g_CE + λ_kd·KD (4 axes composed)
    let l_total = gn2_epoch + lambda_mitosis * aux_value + headg_term + lambda_kd * l_kd

    // ── AXIS D (freeze embed): mask tok_emb/tied-lm_head grad BEFORE AdamW.
    // pre = embed grad-norm before masking; post must be 0.0 when freeze on. ──
    let embed_pre = axis_d_freeze_embed(Mg_acc, freeze_embed, V, d)
    let embed_post = axis_slot_grad_norm(Mg_acc, 0, V * d)

    // grad-norm clip (max_norm=1.0) over the FULL accumulated grads
    let gnorm = v3_clip_grad_norm(Mg_acc, m_size, 1.0)

    // AdamW step over the FULL V3 M (spine + head_g) — LR-scheduled
    nn_decoder_adamw_step(M, Mg_acc, Mm, Mv, m_size, lr_now, b1, b2, eps_a, wd, step)

    print("    step "); print(step); print(" lr="); print(lr_now)
    print(" gn2="); print(gn2_epoch); print(" ce_g="); print(ce_g)
    print(" L_total="); print(l_total)
    print(" pool="); print(info["pool_size"]); print(" splits="); print(info["split_total"])
    print(" phi="); print(info["phi"]); print(" gnorm="); print(gnorm)
    print(" aux="); print(aux_value); println("")
    // axis readouts (proves each axis is ACTIVE, not a print-stub)
    print("      [axis] A.anima_frac="); print(anima_frac)
    print(" C.lam_g="); print(lam_g); print(" C.headg_term="); print(headg_term)
    print(" B.L_kd="); print(l_kd)
    print(" D.embed_pre="); print(embed_pre); print(" D.embed_post="); print(embed_post)
    println("")

    // ── M1 AXIS FALSIFIERS + M2 DIFFERENT-gate (last step) ──
    if step == n_steps {
        println("  --- M1 axis falsifiers ---")
        // D: freeze masks embed grad → post-norm 0 while pre-norm captured
        let d_pass = if freeze_embed == 1 { embed_post == 0.0 } else { embed_post > 0.0 }
        if d_pass { print("PASS  F-AXIS-D-FREEZE  embed grad pre="); print(embed_pre)
            print(" post="); print(embed_post); println(" (freeze masks grad)") }
        else { println("FAIL  F-AXIS-D-FREEZE") }
        // A: anima_frac DIFFERS across the curriculum phase boundary
        let a_lo = axis_a_anima_frac(1, curriculum_phase_steps)
        let a_hi = axis_a_anima_frac(2 * curriculum_phase_steps, curriculum_phase_steps)
        if a_lo != a_hi { print("PASS  F-AXIS-A-CURRICULUM  anima_frac step1="); print(a_lo)
            print(" → step"); print(2 * curriculum_phase_steps); print("="); print(a_hi)
            println(" (schedule changes)") }
        else { println("FAIL  F-AXIS-A-CURRICULUM") }
        // C: head_g objective term > 0 (escape inert / R4 "moot")
        if headg_term > 0.0 { print("PASS  F-AXIS-C-HEADG  λ_g·CE_g="); print(headg_term)
            println(" > 0 (head_g objective ACTIVE, not inert)") }
        else { println("FAIL  F-AXIS-C-HEADG") }
        // B: KD loss > 0 (teacher signal present in grad path)
        if l_kd > 0.0 { print("PASS  F-AXIS-B-DISTILL  L_kd="); print(l_kd)
            println(" > 0 (teacher signal present)") }
        else { println("FAIL  F-AXIS-B-DISTILL") }
        // M2 gate: two axes produce DIFFERENT readouts (¬ silent-bypass).
        // (the old bug: axis B == axis F init_CE byte-equal. here A.lo≠A.hi AND
        //  D.pre≠D.post → axes measurably change training, not no-ops.)
        let m2 = (a_lo != a_hi) && (embed_pre != embed_post)
        if m2 { println("PASS  F-AXIS-M2-DIFFERENT  axes change training (not silent-bypass)") }
        else { println("FAIL  F-AXIS-M2-DIFFERENT") }
    }

    step = step + 1
}

// ── final epoch gn2 + acc ──
let mut gn2_final = 0.0
let mut acc = 0
let mut s_f = 0
while s_f < nsamp {
    _window_ids(IDS, s_f, T, ids_scratch)
    let tt = to_int(t_get(YS, s_f))
    nn_decoder_fwd(ids_scratch, M, Mc, cos_tab, sin_tab, T, d, nh, nkv, h, V, n_layer)
    gn2_final = gn2_final + nn_decoder_gn2(Mc, tt, T, d, nh, nkv, h, V, n_layer)
    let pred = nn_decoder_predict(Mc, T, d, nh, nkv, h, V, n_layer)
    if pred == tt { acc = acc + 1 }
    s_f = s_f + 1
}
print("  final: epoch gn2 = "); print(gn2_final)
print(" / acc = "); print(acc); print("/"); println(nsamp)

let summ = cell_pool_summary(pool)
print("  mitosis summary: final_cells="); print(summ["final_cells"])
print(" splits="); print(summ["splits"]); print(" merges="); print(summ["merges"])
print(" phi_final="); println(summ["phi_final"])

// ── falsifier: smoke-tier structure verify ──
// F-V3PORT-SMOKE-DESCENT : init gn2 > final gn2 (the V2-spine learns)
let descends = gn2_init > gn2_final
if descends {
    print("PASS  F-V3PORT-SMOKE-DESCENT  init gn2 "); print(gn2_init)
    print(" > final gn2 "); print(gn2_final); println(" (V2-spine descent confirmed)")
} else {
    print("NOTE  F-V3PORT-SMOKE-DESCENT  init "); print(gn2_init)
    print(" vs final "); print(gn2_final)
    println(" — 5-step smoke may not descend (production = --steps 2000)")
}

// teardown
cell_pool_free(pool)
let _ = t_free(IDS); let _ = t_free(YS); let _ = t_free(M)
let _ = t_free(Mm); let _ = t_free(Mv); let _ = t_free(Mg); let _ = t_free(Mg_acc)
let _ = t_free(Mc); let _ = t_free(cos_tab); let _ = t_free(sin_tab)
let _ = t_free(ids_scratch); let _ = t_free(logits_a); let _ = t_free(logits_g)
let _ = t_free(tension_pl); let _ = t_free(zT_buf); let _ = t_free(d_zT_scratch)

println("=== train_p21h_v3 (flame port) smoke tier DONE — V2 spine + mitosis + V3-extension head_g backward WIRED (gradient flows); purefield/tension_proj residual-stream wiring + Qwen-BPE + multilang-eval = follow-up (M1) ===")
