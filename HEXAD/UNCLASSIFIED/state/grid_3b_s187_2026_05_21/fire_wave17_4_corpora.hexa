// HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/fire_wave17_4_corpora.hexa
//
// 0. version + spec ref — v0.1 (dry-run + fire mode + selftest)
//   Spec      : PR #225 (Wave-17 U-shape spec, LORA-only, 4-point sweep)
//   Sanity    : PR #337 (corpus prune 사전검증, GO analytical)
//   Caller WG : PR #204 (env-var separation anti-concat, env $K=v $K=v form)
//   Dispatch  : dispatch_p21m_runpod.sh (HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/)
//
//   Helper that GENERATES the 4 fire commands for the Wave-17 eternal-cap
//   U-shape sweep (corpus_v13/v14/v15/v16 @ eternal_keep ∈ {0.10,0.20,0.40,0.50}).
//
//   Modes —
//     cells          : print 4 variant×keep cell configs (no exec)
//     dispatch-cmds  : print 4 rendered bash commands (dry-run, no exec)
//     fire-all       : actual nohup parallel dispatch (4 pods, REQUIRES explicit verb)
//     selftest       : F-WAVE17-FIRE-1..4 (4/4 PASS) — pure logic, no exec
//
//   SAFETY — selftest + cells + dispatch-cmds are zero-fire. Only `fire-all`
//   verb triggers actual GPU dispatch (per a_fire_autonomous: dispatched in
//   parallel, $1.50 envelope per PR #225).

// 1. constants -------------------------------------------------------------

fn wave17_keeps() -> list {
    return ["0.10", "0.20", "0.40", "0.50"]
}

fn wave17_variants() -> list {
    return ["P21M_v13", "P21M_v14", "P21M_v15", "P21M_v16"]
}

fn wave17_seed() -> str {
    return "1337"
}

fn wave17_dispatch_script() -> str {
    return "dispatch_p21m_runpod.sh"
}

// 2. env-var assembly (PR #204 caller pattern) -----------------------------
//
// Anti-concat: each env-var is a SEPARATE key=value pair in the env() prefix,
// NOT a single concat string. The renderer emits one ordered list of
// {key, value} pairs, then assembles the bash form `env K1=V1 K2=V2 ...`.
// This matches the ✓ CORRECT form in PR #204 (line 11 of the body).

fn build_env_for(keep: str) -> list {
    // ordered list of {"k": ..., "v": ...} preserves the canonical form.
    return [
        #{"k": "STRIP_CARVE",    "v": "1"},
        #{"k": "TOKEN_FREQ_CAP", "v": "1"},
        #{"k": "ETERNAL_KEEP",   "v": keep},
        #{"k": "SAVE_POD",       "v": "1"},
    ]
}

fn render_env_prefix(env_pairs: list) -> str {
    // env K1=V1 K2=V2 K3=V3 K4=V4 — single space separators, no concat.
    let mut acc = "env"
    let mut i = 0
    while i < len(env_pairs) {
        let pair = env_pairs[i]
        acc = acc + " " + to_string(pair["k"]) + "=" + to_string(pair["v"])
        i = i + 1
    }
    return acc
}

fn render_dispatch_cmd(variant: str, env_pairs: list, seed: str) -> str {
    // env STRIP_CARVE=1 ... bash dispatch_p21m_runpod.sh <variant> <seed>
    let env_prefix = render_env_prefix(env_pairs)
    return env_prefix + " bash " + wave17_dispatch_script() + " " + variant + " " + seed
}

fn render_nohup_cmd(variant: str, env_pairs: list, seed: str, log_dir: str) -> str {
    // nohup <cmd> > <log_dir>/fire_<variant>.log 2>&1 &
    let cmd = render_dispatch_cmd(variant, env_pairs, seed)
    let log_path = log_dir + "/fire_" + variant + ".log"
    return "nohup " + cmd + " > " + log_path + " 2>&1 &"
}

// 3. per-cell config -------------------------------------------------------

fn wave17_cell(idx: int) -> dict {
    let keeps = wave17_keeps()
    let variants = wave17_variants()
    if idx < 0 || idx >= len(variants) {
        return #{"ok": "0", "reason": "idx out of range", "variant": "", "keep": ""}
    }
    return #{
        "ok":      "1",
        "idx":     to_string(idx),
        "variant": variants[idx],
        "keep":    keeps[idx],
        "seed":    wave17_seed(),
    }
}

fn print_cells() {
    println("[fire_wave17_4_corpora] 4-cell config:")
    let n = len(wave17_variants())
    let mut i = 0
    while i < n {
        let c = wave17_cell(i)
        println("  cell " + to_string(i) + ": variant=" + to_string(c["variant"])
                + " eternal_keep=" + to_string(c["keep"])
                + " seed=" + to_string(c["seed"]))
        i = i + 1
    }
}

// 4. per-cell fire driver --------------------------------------------------
//
// mode ∈ {"dry-run", "fire"}; "dry-run" prints the command, "fire" actually
// executes nohup … & (background). The PID is captured by the shell via $!
// and tee'd into the per-variant pod_id sidecar log line.

fn fire_one(idx: int, mode: str, log_dir: str) -> dict {
    let c = wave17_cell(idx)
    if to_string(c["ok"]) != "1" {
        return #{"ok": "0", "reason": to_string(c["reason"]), "pid": ""}
    }
    let variant = to_string(c["variant"])
    let keep = to_string(c["keep"])
    let seed = to_string(c["seed"])
    let env_pairs = build_env_for(keep)
    if mode == "dry-run" {
        let plan = render_nohup_cmd(variant, env_pairs, seed, log_dir)
        println("[dry-run] " + plan)
        return #{"ok": "1", "variant": variant, "keep": keep, "pid": "", "mode": "dry-run"}
    }
    if mode == "fire" {
        let cmd = render_nohup_cmd(variant, env_pairs, seed, log_dir)
        // capture PID via "$!"; the kicker emits "PID <variant>=<n>" line for log mapping.
        let full = cmd + " echo \"PID " + variant + "=$!\""
        let pid_line = exec(full).trim()
        println("[fire] " + variant + " keep=" + keep + " — " + pid_line)
        return #{"ok": "1", "variant": variant, "keep": keep, "pid": pid_line, "mode": "fire"}
    }
    return #{"ok": "0", "reason": "unknown mode: " + mode, "pid": ""}
}

fn fire_all(mode: str, log_dir: str) -> int {
    // Per a_wall_first: parallel dispatch. nohup … & itself is the parallel
    // primitive — each fire_one returns immediately, the next launches without
    // waiting. fire_one in "fire" mode is non-blocking by construction.
    println("[fire_wave17_4_corpora] fire_all mode=" + mode + " log_dir=" + log_dir)
    let n = len(wave17_variants())
    if mode == "fire" {
        let _ = exec("mkdir -p " + log_dir)
    }
    let mut i = 0
    let mut n_ok = 0
    while i < n {
        let r = fire_one(i, mode, log_dir)
        if to_string(r["ok"]) == "1" { n_ok = n_ok + 1 }
        i = i + 1
    }
    println("[fire_wave17_4_corpora] " + to_string(n_ok) + "/" + to_string(n) + " cells dispatched (mode=" + mode + ")")
    return n_ok
}

// 5. selftest — F-WAVE17-FIRE-1..4 -----------------------------------------

fn _assert(cond: bool, name: str) -> int {
    if cond { println("  PASS " + name)   return 1 }
    println("  FAIL " + name)
    return 0
}

fn _f_wave17_cells() -> int {
    // F-WAVE17-FIRE-1 — 4 cells correctly enumerated with expected variant tags.
    let n = len(wave17_variants())
    let mut ok = n == 4
    let exp_v = ["P21M_v13", "P21M_v14", "P21M_v15", "P21M_v16"]
    let mut i = 0
    while i < n {
        let c = wave17_cell(i)
        if to_string(c["variant"]) != exp_v[i] { ok = false }
        if to_string(c["seed"]) != "1337" { ok = false }
        i = i + 1
    }
    // Out-of-range guard.
    let bad = wave17_cell(99)
    if to_string(bad["ok"]) != "0" { ok = false }
    return _assert(ok, "F-WAVE17-FIRE-1 — 4 cells correct (variants P21M_v13..v16, seed 1337, range guard)")
}

fn _f_wave17_envsep() -> int {
    // F-WAVE17-FIRE-2 — env-var separation per PR #204 (anti-concat).
    // Rendered prefix must contain 4 SEPARATE `K=V` pairs joined by single
    // spaces, NOT a single quoted concat string.
    let pairs = build_env_for("0.10")
    let prefix = render_env_prefix(pairs)
    let mut ok = true
    // Must start with "env ".
    if !prefix.starts_with("env ") { ok = false }
    // Must contain each of the 4 expected keys as `<key>=`.
    if prefix.index_of("STRIP_CARVE=1") < 0 { ok = false }
    if prefix.index_of("TOKEN_FREQ_CAP=1") < 0 { ok = false }
    if prefix.index_of("ETERNAL_KEEP=0.10") < 0 { ok = false }
    if prefix.index_of("SAVE_POD=1") < 0 { ok = false }
    // Must NOT contain a quoted concat blob (the PR #204 anti-pattern):
    // i.e. no double-quotes, no `KEY1=V1 KEY2=V2` collapsed inside a quote.
    if prefix.index_of("\"") >= 0 { ok = false }
    // Pair count == 4 (one space per pair between `env` and tail).
    let parts = prefix.split(" ")
    if len(parts) != 5 { ok = false }  // "env" + 4 K=V pairs
    return _assert(ok, "F-WAVE17-FIRE-2 — env-var separation 4 separate pairs, no concat (PR #204)")
}

fn _f_wave17_keeps() -> int {
    // F-WAVE17-FIRE-3 — eternal_keep values match Wave-17 spec exactly:
    // [0.10, 0.20, 0.40, 0.50] in order, paired with v13/v14/v15/v16.
    let keeps = wave17_keeps()
    let exp_k = ["0.10", "0.20", "0.40", "0.50"]
    let variants = wave17_variants()
    let exp_v = ["P21M_v13", "P21M_v14", "P21M_v15", "P21M_v16"]
    let mut ok = len(keeps) == 4 && len(variants) == 4
    let mut i = 0
    while i < 4 {
        if keeps[i] != exp_k[i] { ok = false }
        if variants[i] != exp_v[i] { ok = false }
        // each cell's env must embed the matching keep
        let pairs = build_env_for(keeps[i])
        let prefix = render_env_prefix(pairs)
        if prefix.index_of("ETERNAL_KEEP=" + exp_k[i]) < 0 { ok = false }
        i = i + 1
    }
    return _assert(ok, "F-WAVE17-FIRE-3 — 4 eternal_keep values match PR #225 spec [0.10, 0.20, 0.40, 0.50]")
}

fn _f_wave17_render() -> int {
    // F-WAVE17-FIRE-4 — all 4 dispatch commands renderable, contain the
    // dispatch script + variant + seed + env prefix. No actual exec.
    let n = len(wave17_variants())
    let mut ok = n == 4
    let mut i = 0
    while i < n {
        let c = wave17_cell(i)
        let variant = to_string(c["variant"])
        let keep = to_string(c["keep"])
        let seed = to_string(c["seed"])
        let env_pairs = build_env_for(keep)
        let cmd = render_dispatch_cmd(variant, env_pairs, seed)
        if cmd.index_of("env ") < 0 { ok = false }
        if cmd.index_of("bash dispatch_p21m_runpod.sh") < 0 { ok = false }
        if cmd.index_of(variant) < 0 { ok = false }
        if cmd.index_of(" " + seed) < 0 { ok = false }
        if cmd.index_of("ETERNAL_KEEP=" + keep) < 0 { ok = false }
        // nohup wrapper too.
        let nohup_cmd = render_nohup_cmd(variant, env_pairs, seed, "/tmp/wave17_log")
        if !nohup_cmd.starts_with("nohup ") { ok = false }
        if !nohup_cmd.ends_with("&") { ok = false }
        if nohup_cmd.index_of("/tmp/wave17_log/fire_" + variant + ".log") < 0 { ok = false }
        i = i + 1
    }
    return _assert(ok, "F-WAVE17-FIRE-4 — 4 dispatch + nohup commands renderable (no exec)")
}

fn selftest() -> int {
    println("[fire_wave17_4_corpora] selftest START")
    let mut n_pass = 0
    n_pass = n_pass + _f_wave17_cells()
    n_pass = n_pass + _f_wave17_envsep()
    n_pass = n_pass + _f_wave17_keeps()
    n_pass = n_pass + _f_wave17_render()
    println("[fire_wave17_4_corpora] selftest END: F-WAVE17-FIRE-1..4 " + to_string(n_pass) + "/4 PASS")
    return n_pass
}

// 6. main — verb dispatch --------------------------------------------------

fn _print_usage() {
    println("usage: hexa run fire_wave17_4_corpora.hexa <verb>")
    println("  verbs:")
    println("    cells          — print 4-cell config (no exec)")
    println("    dispatch-cmds  — print 4 rendered bash commands (dry-run, no exec)")
    println("    fire-all       — ACTUAL 4-pod parallel dispatch via nohup (gates GPU cost)")
    println("    selftest       — F-WAVE17-FIRE-1..4 (4/4 PASS, no exec)")
}

fn main() {
    let argv = args()
    let n = len(argv)
    if n < 2 {
        _print_usage()
        return
    }
    let verb = argv[1]
    if verb == "selftest" {
        let p = selftest()
        if p < 4 { exit(1) }
        exit(0)
    }
    if verb == "cells" {
        print_cells()
        return
    }
    if verb == "dispatch-cmds" {
        println("[fire_wave17_4_corpora] dispatch-cmds (dry-run, no exec):")
        let _ = fire_all("dry-run", "/tmp/wave17_log")
        return
    }
    if verb == "fire-all" {
        println("[fire_wave17_4_corpora] fire-all — 4-pod parallel GPU dispatch (PR #225 + #337)")
        println("    est cost: $1.50 (4× A100 SXM 80GB ~10-15 min/pod parallel)")
        let log_dir = exec("pwd").trim() + "/wave17_fire_logs"
        let _ = fire_all("fire", log_dir)
        return
    }
    println("unknown verb: " + verb)
    _print_usage()
    exit(2)
}
