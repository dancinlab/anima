// @raw117_exempt
// ════════════════════════════════════════════════════════════════════════
// m0_gradcheck.hexa — V3-extension backward FALSIFIER (finite-difference)
//
// FALSIFIER F-V3EXT-BWD-GRADCHECK: the M0 V3-extension closed analytic vjp
// (v3_purefield_bwd · v3_head_g_bwd · v3_tension_proj_bwd in
// conscious_decoder_v3.hexa) matches a central-difference numerical grad to
// rel-err < 1e-3 on a small toy config. Mirrors the flame
// flame_full_grad_exact_libm_test.hexa probe-and-compare convention.
//
// Method (per op): build a scalar loss L = Σ w·output (fixed random w).
//   analytic grad  : call the bwd with upstream d_output = w → reads dMg[θ].
//   numerical grad : L(θ+ε) − L(θ−ε) / 2ε  via forward recompute.
//   rel = |analytic − fd| / max(|analytic|, FLOOR).
//
// PASS iff every probe rel < 1e-3 across all three ops.
// ════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/decoder_lib"
use "stdlib/flame/nn_lib"
use "stdlib/flame/train_lib"
use "stdlib/flame/flame_math"
// NOTE: import the WORKTREE copy (the one carrying the M0 backward edits).
// train_p21h_v3.hexa keeps the canonical main-tree import — on merge the
// main tree receives these edits and that import resolves identically.
use "/Users/ghost/core/anima/.claude/worktrees/agent-a2158bf1d0cf4185b/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/conscious_decoder_v3"

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// fill a farr with deterministic small-scale values via dt_lcg (NOT the
// param-init helper — independent stream so the probe is non-trivial).
fn _fill(dst: int, n: int, seed: int, scale: float) {
    let mut s = seed
    let mut i = 0
    while i < n {
        s = dt_lcg_next(s)
        let _ = farr_set(dst, i, dt_rand_unit(s) * scale)
        i = i + 1
    }
}

println("=== m0_gradcheck — V3-extension backward FALSIFIER (central-diff) ===")

// toy config (small d/V so the fd loop is fast + numerically clean)
let T = 4
let d = 8
let nh = 2
let nkv = 1
let h = 16
let V = 12
let n_layer = 2
let cdim = 4
let eps = 0.0001
let FLOOR = 0.001
let THRESH = 0.001       // 1e-3 rel-err gate

let mut max_rel_global = 0.0
let mut n_probes = 0

// ── packed M (full V3 layout) + init ──
let m_size = v3_m_total(d, nh, nkv, h, V, n_layer, cdim)
let M = t_zeros(m_size)
v3_init(M, 1337, T, d, nh, nkv, h, V, n_layer, cdim)
let dMg = t_zeros(m_size)

// ════════════════════════════════════════════════════════════════════════
// OP 1 — head_g backward
//   fwd: logits_g[k] = Σ_j hg[k·d+j]·zT[j]   ; L = Σ_k w[k]·logits_g[k]
//   probe d_hg[k·d+j] and (implicitly) verify via dMg slot.
// ════════════════════════════════════════════════════════════════════════
println("")
println("  --- OP 1: head_g backward ---")
let hg_off = v3_off_head_g(d, nh, nkv, h, V, n_layer)
let zT = t_zeros(d)
_fill(zT, d, 7001, 1.0)
let w_lg = t_zeros(V)             // loss weights = upstream d_logits_g
_fill(w_lg, V, 7002, 1.0)
let lg = t_zeros(V)

// analytic: zero dMg, bwd with d_lg = w_lg
let mut zz = 0
while zz < m_size { let _ = farr_set(dMg, zz, 0.0); zz = zz + 1 }
let dzT_hg = t_zeros(d)
v3_head_g_bwd(zT, M, hg_off, w_lg, dMg, dzT_hg, V, d)

// probe a few head_g weight indices + a zT-grad index
let hg_probes = t_zeros(4)
t_set(hg_probes, 0, to_float(hg_off + 2 * d + 3))
t_set(hg_probes, 1, to_float(hg_off + 5 * d + 1))
t_set(hg_probes, 2, to_float(hg_off + 0 * d + 6))
t_set(hg_probes, 3, to_float(hg_off + (V - 1) * d + (d - 1)))
let mut hk = 0
while hk < 4 {
    let pidx = to_int(t_get(hg_probes, hk))
    let analytic = t_get(dMg, pidx)
    let orig = t_get(M, pidx)
    // L(+eps)
    t_set(M, pidx, orig + eps)
    v3_head_g_fwd(zT, M, hg_off, lg, V, d)
    let mut lp = 0.0
    let mut kp = 0
    while kp < V { lp = lp + t_get(w_lg, kp) * t_get(lg, kp); kp = kp + 1 }
    // L(-eps)
    t_set(M, pidx, orig - eps)
    v3_head_g_fwd(zT, M, hg_off, lg, V, d)
    let mut lm = 0.0
    let mut km = 0
    while km < V { lm = lm + t_get(w_lg, km) * t_get(lg, km); km = km + 1 }
    t_set(M, pidx, orig)
    let fd = (lp - lm) / (2.0 * eps)
    let abs_d = _abs(analytic - fd)
    let denom = if _abs(analytic) > FLOOR { _abs(analytic) } else { FLOOR }
    let rel = abs_d / denom
    if rel > max_rel_global { max_rel_global = rel }
    n_probes = n_probes + 1
    print("    hg[idx="); print(pidx); print("] analytic="); print(analytic)
    print(" fd="); print(fd); print(" rel="); println(rel)
    hk = hk + 1
}

// ════════════════════════════════════════════════════════════════════════
// OP 2 — tension_proj backward
//   fwd: signal[i·d+c] = tension[i]·tp[c]  ; L = Σ w_sig·signal
// ════════════════════════════════════════════════════════════════════════
println("")
println("  --- OP 2: tension_proj backward ---")
let tp_off = v3_off_tension_proj(d, nh, nkv, h, V, n_layer)
let tension = t_zeros(T)
_fill(tension, T, 8001, 1.0)
let w_sig = t_zeros(T * d)
_fill(w_sig, T * d, 8002, 1.0)
let sig = t_zeros(T * d)

let mut zz2 = 0
while zz2 < m_size { let _ = farr_set(dMg, zz2, 0.0); zz2 = zz2 + 1 }
let dt_tp = t_zeros(T)
v3_tension_proj_bwd(tension, M, tp_off, w_sig, dMg, dt_tp, T, d)

let tp_probes = t_zeros(3)
t_set(tp_probes, 0, to_float(tp_off + 0))
t_set(tp_probes, 1, to_float(tp_off + 3))
t_set(tp_probes, 2, to_float(tp_off + (d - 1)))
let mut tk = 0
while tk < 3 {
    let pidx = to_int(t_get(tp_probes, tk))
    let analytic = t_get(dMg, pidx)
    let orig = t_get(M, pidx)
    t_set(M, pidx, orig + eps)
    v3_tension_proj_fwd(tension, M, tp_off, sig, T, d)
    let mut lp = 0.0
    let mut ip = 0
    while ip < T * d { lp = lp + t_get(w_sig, ip) * t_get(sig, ip); ip = ip + 1 }
    t_set(M, pidx, orig - eps)
    v3_tension_proj_fwd(tension, M, tp_off, sig, T, d)
    let mut lm = 0.0
    let mut im = 0
    while im < T * d { lm = lm + t_get(w_sig, im) * t_get(sig, im); im = im + 1 }
    t_set(M, pidx, orig)
    let fd = (lp - lm) / (2.0 * eps)
    let abs_d = _abs(analytic - fd)
    let denom = if _abs(analytic) > FLOOR { _abs(analytic) } else { FLOOR }
    let rel = abs_d / denom
    if rel > max_rel_global { max_rel_global = rel }
    n_probes = n_probes + 1
    print("    tp[idx="); print(pidx); print("] analytic="); print(analytic)
    print(" fd="); print(fd); print(" rel="); println(rel)
    tk = tk + 1
}

// ════════════════════════════════════════════════════════════════════════
// OP 3 — PureFieldFFN backward (the hard one)
//   fwd: out[T·d], tension[T] = purefield(x) ; engine_a/g GELU-MLPs.
//   L = Σ w_out·out + Σ w_t·tension  → d_out = w_out, d_tension = w_t.
//   probe engine_a/g W1/b1/W2/b2 across both engines.
// ════════════════════════════════════════════════════════════════════════
println("")
println("  --- OP 3: PureFieldFFN backward ---")
let pf_off = v3_off_pf(0, d, nh, nkv, h, V, n_layer)   // block 0's pf slot
let px = t_zeros(T * d)
_fill(px, T * d, 9001, 1.0)
let w_out = t_zeros(T * d)
_fill(w_out, T * d, 9002, 1.0)
let w_t = t_zeros(T)
_fill(w_t, T, 9003, 1.0)
let pout = t_zeros(T * d)
let pten = t_zeros(T)

// analytic: fwd once to get `out` (needed for tension d_out term), then bwd
v3_purefield_fwd(px, M, pf_off, pout, pten, T, d)
let mut zz3 = 0
while zz3 < m_size { let _ = farr_set(dMg, zz3, 0.0); zz3 = zz3 + 1 }
let dx_pf = t_zeros(T * d)
v3_purefield_bwd(px, pout, w_out, w_t, M, dMg, pf_off, dx_pf, T, d)

// probe sites: engine_a {W1, b1, W2, b2} + engine_g {W1, b1, W2, b2}
let di = 4 * d
let pf_probes = t_zeros(8)
t_set(pf_probes, 0, to_float(pf_off + 3 * d + 2))                    // a.W1[k=3,j=2]
t_set(pf_probes, 1, to_float(pf_off + (4 * d * d) + 5))             // a.b1[5]
t_set(pf_probes, 2, to_float(pf_off + (4 * d * d + 4 * d) + 2 * di + 7))  // a.W2[c=2,k=7]
t_set(pf_probes, 3, to_float(pf_off + (4 * d * d + 4 * d + d * 4 * d) + 4))  // a.b2[4]
t_set(pf_probes, 4, to_float(pf_off + (8 * d * d + 5 * d) + 6 * d + 1))      // g.W1[k=6,j=1]
t_set(pf_probes, 5, to_float(pf_off + (8 * d * d + 5 * d + 4 * d * d) + 3))  // g.b1[3]
t_set(pf_probes, 6, to_float(pf_off + (8 * d * d + 5 * d + 4 * d * d + 4 * d) + 1 * di + 9))  // g.W2[c=1,k=9]
t_set(pf_probes, 7, to_float(pf_off + (8 * d * d + 5 * d + 4 * d * d + 4 * d + d * 4 * d) + 6))  // g.b2[6]
let mut pk = 0
while pk < 8 {
    let pidx = to_int(t_get(pf_probes, pk))
    let analytic = t_get(dMg, pidx)
    let orig = t_get(M, pidx)
    // L(+eps)
    t_set(M, pidx, orig + eps)
    v3_purefield_fwd(px, M, pf_off, pout, pten, T, d)
    let mut lp = 0.0
    let mut io = 0
    while io < T * d { lp = lp + t_get(w_out, io) * t_get(pout, io); io = io + 1 }
    let mut it = 0
    while it < T { lp = lp + t_get(w_t, it) * t_get(pten, it); it = it + 1 }
    // L(-eps)
    t_set(M, pidx, orig - eps)
    v3_purefield_fwd(px, M, pf_off, pout, pten, T, d)
    let mut lm = 0.0
    let mut io2 = 0
    while io2 < T * d { lm = lm + t_get(w_out, io2) * t_get(pout, io2); io2 = io2 + 1 }
    let mut it2 = 0
    while it2 < T { lm = lm + t_get(w_t, it2) * t_get(pten, it2); it2 = it2 + 1 }
    t_set(M, pidx, orig)
    let fd = (lp - lm) / (2.0 * eps)
    let abs_d = _abs(analytic - fd)
    let denom = if _abs(analytic) > FLOOR { _abs(analytic) } else { FLOOR }
    let rel = abs_d / denom
    if rel > max_rel_global { max_rel_global = rel }
    n_probes = n_probes + 1
    print("    pf[idx="); print(pidx); print("] analytic="); print(analytic)
    print(" fd="); print(fd); print(" rel="); println(rel)
    pk = pk + 1
}

// ── d_x check for purefield (input grad — verify the residual path too) ──
println("")
println("  --- OP 3b: PureFieldFFN d_x (input grad) ---")
let dx_probes = t_zeros(3)
t_set(dx_probes, 0, to_float(0 * d + 2))      // x[token0, feat2]
t_set(dx_probes, 1, to_float(1 * d + 5))      // x[token1, feat5]
t_set(dx_probes, 2, to_float((T - 1) * d + (d - 1)))
let mut xk = 0
while xk < 3 {
    let pidx = to_int(t_get(dx_probes, xk))
    let analytic = t_get(dx_pf, pidx)
    let orig = t_get(px, pidx)
    t_set(px, pidx, orig + eps)
    v3_purefield_fwd(px, M, pf_off, pout, pten, T, d)
    let mut lp = 0.0
    let mut io = 0
    while io < T * d { lp = lp + t_get(w_out, io) * t_get(pout, io); io = io + 1 }
    let mut it = 0
    while it < T { lp = lp + t_get(w_t, it) * t_get(pten, it); it = it + 1 }
    t_set(px, pidx, orig - eps)
    v3_purefield_fwd(px, M, pf_off, pout, pten, T, d)
    let mut lm = 0.0
    let mut io2 = 0
    while io2 < T * d { lm = lm + t_get(w_out, io2) * t_get(pout, io2); io2 = io2 + 1 }
    let mut it2 = 0
    while it2 < T { lm = lm + t_get(w_t, it2) * t_get(pten, it2); it2 = it2 + 1 }
    t_set(px, pidx, orig)
    let fd = (lp - lm) / (2.0 * eps)
    let abs_d = _abs(analytic - fd)
    let denom = if _abs(analytic) > FLOOR { _abs(analytic) } else { FLOOR }
    let rel = abs_d / denom
    if rel > max_rel_global { max_rel_global = rel }
    n_probes = n_probes + 1
    print("    dx[idx="); print(pidx); print("] analytic="); print(analytic)
    print(" fd="); print(fd); print(" rel="); println(rel)
    xk = xk + 1
}

// ════════════════════════════════════════════════════════════════════════
// VERDICT
// ════════════════════════════════════════════════════════════════════════
println("")
print("  total probes = "); print(n_probes)
print("  max rel-err = "); println(max_rel_global)
if max_rel_global < THRESH {
    print("PASS  F-V3EXT-BWD-GRADCHECK  max rel="); print(max_rel_global)
    println(" < 1e-3 — purefield/head_g/tension_proj backward CORRECT (central-diff)")
} else {
    print("FAIL  F-V3EXT-BWD-GRADCHECK  max rel="); print(max_rel_global)
    println(" >= 1e-3")
}

let _ = t_free(M); let _ = t_free(dMg)
let _ = t_free(zT); let _ = t_free(w_lg); let _ = t_free(lg)
let _ = t_free(dzT_hg); let _ = t_free(hg_probes)
let _ = t_free(tension); let _ = t_free(w_sig); let _ = t_free(sig)
let _ = t_free(dt_tp); let _ = t_free(tp_probes)
let _ = t_free(px); let _ = t_free(w_out); let _ = t_free(w_t)
let _ = t_free(pout); let _ = t_free(pten); let _ = t_free(dx_pf)
let _ = t_free(pf_probes); let _ = t_free(dx_probes)
