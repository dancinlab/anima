// ════════════════════════════════════════════════════════════════════════════
//  HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/probe_r8c_diagnostic.hexa
//
//  R8c diagnostic probe — CONTROL-PLANE driver (PR #250 구현).
//
//  ── HONEST FRAMING (read first) ─────────────────────────────────────────────
//  This .hexa is the probe's CONTROL-PLANE / ORCHESTRATOR — NOT the model forward.
//  It does NOT run the 3B ConsciousDecoderV3 model: that needs GPU + torch, which
//  is `train_p21h_v3.py`'s job on a runpod pod (dispatched via
//  dispatch_p21h_v3_runpod.sh). This driver's four jobs are:
//
//      1. generate the 4-cell env-var configs   (cells / r8c_cells)
//      2. render the 4 dispatch commands         (dispatch-cmds / r8c_dispatch_cmd)
//      3. parse init_CE from each result.json    (verdict / r8c_parse_init_ce)
//      4. apply the 3 falsifiers + render table   (verdict / r8c_verdict)
//
//  No GPU is touched here. No model weight is loaded. The substrate-forward,
//  the actual init_CE measurement, happens on the pod. This file is the
//  control-plane that *describes* the experiment and *interprets* its outputs.
//
//  ── PROTOCOL (PR #250 · AXIS_R8C_PROBE_UPDATE_3_CELL_2026_05_23.md) ──────────
//  init_CE catastrophic floor (~14.46 nats, cluster Z) cause-isolation via a
//  4-cell ablation (3 测 cells + 1 baseline). cell-1 (head_g zero) was DROPPED:
//  the 2026-05-23 4-axis redispatch (C/C2/D) measured init_CE byte-equal 14.4564
//  nats → head_g enable/disable/objective-swap = ZERO contribution → natural
//  experiment FALSIFIED F-R8C-HEAD-G before any fire.
//
//      cell      | noise_sigma | n_kv_head | tests
//      ----------+-------------+-----------+----------------------------------
//      baseline  | 0.1         | 4         | axis-A reproduction (~14.46 nats)
//      cell-2    | 0           | 4         | F-R8C-NOISE   (noise hypothesis)
//      cell-3    | 0.1         | 2         | F-R8C-KV-HEAD (kv mismatch hypo)
//      cell-4    | 0           | 2         | F-R8C-COMPOUND (both fixes)
//
//  ── FALSIFIERS (PR #250 § Updated falsifier) ────────────────────────────────
//      F-R8C-NOISE     cell-2 init_CE delta from baseline ≥ 1 nat → noise dominant
//      F-R8C-KV-HEAD   cell-3 init_CE delta from baseline ≥ 1 nat → kv-head dominant
//      F-R8C-COMPOUND  cell-4 init_CE < baseline − 2 nats        → both contribute
//
//  ── DISPATCH ENV-VAR INTERFACE (PR #204 ANTI-CONCAT) ────────────────────────
//  dispatch_p21h_v3_runpod.sh reads P21H_NOISE_SIGMA (env) and forwards
//  --noise-sigma; n_kv_head is the train arg --n-kv-head (default 4). The R8c
//  probe additionally exposes PROBE_NOISE_SIGMA / PROBE_N_KV_HEAD per the PR #250
//  recommendation, and renders n_kv_head as a P21H_N_KV_HEAD env override + short
//  PROBE_STEPS=100 (NOT the 5000 prod run).
//
//  *** PR #204 CALLER WARNING ***  each env var is a SEPARATE assignment:
//      env P21H_STEPS=100 P21H_NOISE_SIGMA=0 ... bash dispatch... <variant> ...
//  NEVER concat into one quoted string ("P21H_STEPS=100 P21H_NOISE_SIGMA=0 ...")
//  — the shell binds that as ONE env-var and argparse rejects the run (broke
//  4/7 AXIS_MAP-FAN axes 2026-05-23). r8c_dispatch_cmd renders the ✓ form.
//
//  ── VERBS ───────────────────────────────────────────────────────────────────
//      cells                  print the 4-cell config matrix
//      dispatch-cmds          print the 4 dispatch commands (PR #204 ✓ form)
//      verdict <result-dir>   parse <dir>/<cell>/result.json → init_CE table+verdict
//      selftest               F-R8C-DRIVER-1..5 (5/5 PASS required)
//
//  hexa-only · control-plane · LLM=none · CPU-local · $0 (no fire here)
//  (p1 NO SYSTEM PROMPT + feedback_hexa_only_authoring directive)
// ════════════════════════════════════════════════════════════════════════════

let DISPATCH       = "dispatch_p21h_v3_runpod.sh"
let PROBE_STEPS    = 100                 // short probe (NOT 5000 prod)
let BASELINE_NOISE = 0.1
let BASELINE_KV    = 4
let BASELINE_CE    = 14.46               // cluster Z (axis-A reproduction target)
let NOISE_DELTA    = 1.0                 // F-R8C-NOISE / F-R8C-KV-HEAD threshold (nats)
let COMPOUND_DELTA = 2.0                 // F-R8C-COMPOUND threshold (nats)

// ─── helpers ─────────────────────────────────────────────────────────────────

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn fexists(path: string) -> bool {
    // stat -f (BSD/macOS) then stat -c (GNU/Linux); stderr muted so a
    // platform-mismatch probe stays silent (one of the two always applies).
    let probe = _str(exec("stat -f %N " + path + " 2>/dev/null")).trim()
    if probe != "" { return true }
    let probe2 = _str(exec("stat -c %n " + path + " 2>/dev/null")).trim()
    return probe2 != ""
}

fn read_safe(path: string) -> string {
    if !fexists(path) { return "" }
    return _str(read_file(path))
}

// numeric absolute value (no fabs dependency on cell-result deltas).
fn absf(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// float → string (interp path has no 2-arg format_float_fixed builtin;
// to_string is the canonical float renderer — mirrors cpgd_wrapper.hexa).
fn fmt4(x: f64) -> string {
    return to_string(x)
}

// ─── 1. cell configs (4: baseline + cell-2 + cell-3 + cell-4) ────────────────

fn r8c_cells() -> list {
    let mut out = []
    out = push(out, #{
        "name":                  "baseline",
        "variant":               "P21H_r8c_baseline",
        "noise_sigma":           BASELINE_NOISE,
        "n_kv_head":             BASELINE_KV,
        "expected_init_ce_note": "axis-A reproduction ~14.46 nats (cluster Z); F-R8C-BASELINE ±0.1"
    })
    out = push(out, #{
        "name":                  "cell-2",
        "variant":               "P21H_r8c_cell2_nonoise",
        "noise_sigma":           0.0,
        "n_kv_head":             4,
        "expected_init_ce_note": "no-noise; F-R8C-NOISE: delta >= 1 nat from baseline -> noise dominant"
    })
    out = push(out, #{
        "name":                  "cell-3",
        "variant":               "P21H_r8c_cell3_kvmatch",
        "noise_sigma":           0.1,
        "n_kv_head":             2,
        "expected_init_ce_note": "kv-head match (Qwen base 2); F-R8C-KV-HEAD: delta >= 1 nat -> kv dominant"
    })
    out = push(out, #{
        "name":                  "cell-4",
        "variant":               "P21H_r8c_cell4_compound",
        "noise_sigma":           0.0,
        "n_kv_head":             2,
        "expected_init_ce_note": "compound (noise=0 + kv=2, head_g 제외); F-R8C-COMPOUND: < baseline-2 nats -> both"
    })
    return out
}

// ─── 2. dispatch command renderer (PR #204 ✓ separate-env-var form) ──────────
//
//  Each env var is a DISTINCT `VAR=val` token after `env` — NOT concatenated.
//  init variant fixed to `random` (R8c warm-init bug isolation is on the
//  from-scratch path; per PR #250 baseline = axis-A random reproduction).

fn r8c_dispatch_cmd(cell: map) -> string {
    let sigma = to_string(cell["noise_sigma"])
    let kv    = to_string(cell["n_kv_head"])
    let var   = _str(cell["variant"])
    // PR #204 anti-concat: every var is its own `KEY=val` token.
    let envp  = "env"
        + " P21H_STEPS=" + str(PROBE_STEPS)
        + " P21H_NOISE_SIGMA=" + sigma
        + " P21H_N_KV_HEAD=" + kv
        + " PROBE_NOISE_SIGMA=" + sigma
        + " PROBE_N_KV_HEAD=" + kv
        + " SAVE_POD=1"
    return envp + " bash " + DISPATCH + " " + var + " random 1337"
}

// ─── 3. init_CE parse from a result.json (init_log.L_ce) ─────────────────────
//
//  result.json shape (dispatch § pull verifier): {"init_log": {"L_ce": <f64>}, ...}
//  Returns -1.0 on absent file / absent key (caller treats as MISSING).

fn r8c_parse_init_ce(result_json_path: string) -> f64 {
    let raw = read_safe(result_json_path)
    if raw == "" { return -1.0 }
    let d = json_parse(raw)
    if type_of(d) != "map" { return -1.0 }
    if !d.contains_key("init_log") { return -1.0 }
    let il = d["init_log"]
    if type_of(il) != "map" { return -1.0 }
    if !il.contains_key("L_ce") { return -1.0 }
    return to_float(il["L_ce"])
}

// ─── 4. verdict — apply the 3 falsifiers over cell init_CE map ───────────────
//
//  cell_results: map { "baseline": ce, "cell-2": ce, "cell-3": ce, "cell-4": ce }
//  (any -1.0 = MISSING). Returns a map with per-falsifier flags + a verdict.

fn r8c_verdict(cell_results: map) -> map {
    let mut v = #{}
    let base = to_float(cell_results["baseline"])
    v["baseline_ce"] = base

    // F-R8C-BASELINE gate: must reproduce axis-A ~14.46 ±0.1; else env-drift.
    let base_ok = base >= 0.0 && absf(base - BASELINE_CE) <= 0.1
    v["baseline_reproduced"] = base_ok

    let c2 = to_float(cell_results["cell-2"])
    let c3 = to_float(cell_results["cell-3"])
    let c4 = to_float(cell_results["cell-4"])
    v["cell2_ce"] = c2
    v["cell3_ce"] = c3
    v["cell4_ce"] = c4

    // F-R8C-NOISE: cell-2 delta from baseline >= 1 nat → noise dominant.
    let d2 = base - c2
    let f_noise = base >= 0.0 && c2 >= 0.0 && d2 >= NOISE_DELTA
    v["cell2_delta"] = d2
    v["F_R8C_NOISE"] = f_noise

    // F-R8C-KV-HEAD: cell-3 delta from baseline >= 1 nat → kv-head dominant.
    let d3 = base - c3
    let f_kv = base >= 0.0 && c3 >= 0.0 && d3 >= NOISE_DELTA
    v["cell3_delta"] = d3
    v["F_R8C_KV_HEAD"] = f_kv

    // F-R8C-COMPOUND: cell-4 < baseline − 2 nats → both contribute.
    let d4 = base - c4
    let f_compound = base >= 0.0 && c4 >= 0.0 && c4 < (base - COMPOUND_DELTA)
    v["cell4_delta"] = d4
    v["F_R8C_COMPOUND"] = f_compound

    // verdict text (decision tree per PR #250 § Updated decision tree).
    let mut verdict = "INCONCLUSIVE — no cell crossed 1 nat (R8c frame FALSIFIED → R8b first-move)"
    if !base_ok {
        verdict = "DEFERRED — F-R8C-BASELINE FAIL (env-drift; pin Qwen+corpus sha256+torch, re-run)"
    } else if f_compound && !f_noise && !f_kv {
        verdict = "COMPOUND — cell-4 only crossed (noise + kv both partial; R8a applies BOTH patches)"
    } else if f_noise && f_kv {
        verdict = "DUAL — noise AND kv-head both dominant (R8a applies BOTH patches)"
    } else if f_noise {
        verdict = "NOISE-DOMINANT — R8a fix noise_sigma=0 default"
    } else if f_kv {
        verdict = "KV-HEAD-DOMINANT — R8a fix V3 n_kv_head=2 default for Qwen base"
    }
    v["verdict"] = verdict
    return v
}

// ─── rendering ───────────────────────────────────────────────────────────────

fn print_cells() {
    let cells = r8c_cells()
    println("=== R8c 4-cell ablation matrix (PR #250) ===")
    println("  cell      | noise_sigma | n_kv_head | note")
    println("  ----------+-------------+-----------+------------------------------")
    let mut i = 0
    while i < len(cells) {
        let c = cells[i]
        let nm = _str(c["name"])
        let pad = "          "
        let nmp = (nm + pad).substring(0, 10)
        println("  " + nmp + "| " + (to_string(c["noise_sigma"]) + "           ").substring(0, 12)
            + "| " + (to_string(c["n_kv_head"]) + "         ").substring(0, 10)
            + "| " + _str(c["expected_init_ce_note"]))
        i = i + 1
    }
    println("  (cell-1 head_g zero DROPPED — natural-experiment FALSIFIED, byte-equal 14.4564)")
}

fn print_dispatch_cmds() {
    let cells = r8c_cells()
    println("=== R8c dispatch commands (PR #204 ✓ separate-env-var form) ===")
    println("# control-plane only — actual fire = GPU pod (train_p21h_v3.py); $0.25, user-gated.")
    let mut i = 0
    while i < len(cells) {
        let c = cells[i]
        println("# " + _str(c["name"]))
        println(r8c_dispatch_cmd(c))
        i = i + 1
    }
}

fn fmt_ce(x: f64) -> string {
    if x < 0.0 { return "MISSING" }
    return fmt4(x)
}

fn print_verdict(result_dir: string) {
    let cells = r8c_cells()
    let mut ces = #{}
    let mut i = 0
    while i < len(cells) {
        let c = cells[i]
        let nm = _str(c["name"])
        let var = _str(c["variant"])
        let path = result_dir + "/" + var + "/result.json"
        let alt  = result_dir + "/" + nm + "/result.json"
        let mut ce = r8c_parse_init_ce(path)
        if ce < 0.0 { ce = r8c_parse_init_ce(alt) }
        ces[nm] = ce
        i = i + 1
    }
    let v = r8c_verdict(ces)
    println("=== R8c verdict (result-dir: " + result_dir + ") ===")
    println("  cell      | init_CE (nats) | delta from baseline")
    println("  ----------+----------------+--------------------")
    println("  baseline  | " + (fmt_ce(to_float(v["baseline_ce"])) + "          ").substring(0, 15) + "| —")
    println("  cell-2    | " + (fmt_ce(to_float(v["cell2_ce"])) + "          ").substring(0, 15)
        + "| " + fmt4(to_float(v["cell2_delta"])))
    println("  cell-3    | " + (fmt_ce(to_float(v["cell3_ce"])) + "          ").substring(0, 15)
        + "| " + fmt4(to_float(v["cell3_delta"])))
    println("  cell-4    | " + (fmt_ce(to_float(v["cell4_ce"])) + "          ").substring(0, 15)
        + "| " + fmt4(to_float(v["cell4_delta"])))
    println("  F-R8C-BASELINE reproduced : " + to_string(v["baseline_reproduced"]))
    println("  F-R8C-NOISE    (cell-2)   : " + to_string(v["F_R8C_NOISE"]))
    println("  F-R8C-KV-HEAD  (cell-3)   : " + to_string(v["F_R8C_KV_HEAD"]))
    println("  F-R8C-COMPOUND (cell-4)   : " + to_string(v["F_R8C_COMPOUND"]))
    println("  VERDICT: " + _str(v["verdict"]))
}

// ─── selftest — F-R8C-DRIVER-1..5 ────────────────────────────────────────────

fn write_tmp(path: string, body: string) {
    write_file(path, body)
}

fn run_selftest() -> int {
    let mut pass = 0
    let mut fail = 0

    // F-R8C-DRIVER-1: cell count == 4 (baseline + 3 测 cells; cell-1 dropped).
    let cells = r8c_cells()
    if len(cells) == 4 {
        println("F-R8C-DRIVER-1 CELL-COUNT PASS (4 cells: baseline+cell2+cell3+cell4)")
        pass = pass + 1
    } else {
        println("F-R8C-DRIVER-1 CELL-COUNT FAIL (got " + str(len(cells)) + ", want 4)")
        fail = fail + 1
    }

    // F-R8C-DRIVER-2: matrix values match PR #250 (baseline 0.1/4, c2 0/4, c3 0.1/2, c4 0/2).
    let b = cells[0]
    let c2c = cells[1]
    let c3c = cells[2]
    let c4c = cells[3]
    let matrix_ok =
        to_float(b["noise_sigma"]) == 0.1 && to_float(b["n_kv_head"]) == 4.0 &&
        to_float(c2c["noise_sigma"]) == 0.0 && to_float(c2c["n_kv_head"]) == 4.0 &&
        to_float(c3c["noise_sigma"]) == 0.1 && to_float(c3c["n_kv_head"]) == 2.0 &&
        to_float(c4c["noise_sigma"]) == 0.0 && to_float(c4c["n_kv_head"]) == 2.0
    if matrix_ok {
        println("F-R8C-DRIVER-2 MATRIX PASS (baseline 0.1/4 · c2 0/4 · c3 0.1/2 · c4 0/2)")
        pass = pass + 1
    } else {
        println("F-R8C-DRIVER-2 MATRIX FAIL (cell ablation values diverge from PR #250)")
        fail = fail + 1
    }

    // F-R8C-DRIVER-3: dispatch cmds use SEPARATE env vars (PR #204 anti-concat).
    //   ✓ form: `env` prefix, then EACH var is its own ` KEY=` token (space-
    //     delimited), no quoted concat blob. Proven by every key appearing as
    //     a distinct ` KEY=` substring AND the kv-head token following the
    //     sigma token (separation, not a single fused string).
    //   ✗ concat form would be "P21H_STEPS=100 P21H_NOISE_SIGMA=0.0 ..." as ONE
    //     quoted token (no leading `env ` + a single quoted blob).
    let cmd = r8c_dispatch_cmd(cells[1])  // cell-2 (sigma 0.0, kv 4)
    let has_env_prefix = cmd.index_of("env ") == 0
    let has_steps      = cmd.index_of(" P21H_STEPS=") >= 0
    let has_sigma_sep  = cmd.index_of(" P21H_NOISE_SIGMA=") >= 0
    let has_kv_sep     = cmd.index_of(" P21H_N_KV_HEAD=") >= 0
    // separation proof: sigma token ends with a space before the kv token.
    let sep_proof      = cmd.index_of("=0.0 P21H_N_KV_HEAD=") >= 0
    let no_quote_blob  = cmd.index_of("\"P21H") < 0
    let bash_invoke    = cmd.index_of(" bash " + DISPATCH + " ") >= 0
    if has_env_prefix && has_steps && has_sigma_sep && has_kv_sep && sep_proof && no_quote_blob && bash_invoke {
        println("F-R8C-DRIVER-3 ANTI-CONCAT PASS (separate env-var tokens, PR #204 ✓ form)")
        pass = pass + 1
    } else {
        println("F-R8C-DRIVER-3 ANTI-CONCAT FAIL (env=" + to_string(has_env_prefix)
            + " steps=" + to_string(has_steps) + " sigma=" + to_string(has_sigma_sep)
            + " kv=" + to_string(has_kv_sep) + " sep=" + to_string(sep_proof)
            + " noquote=" + to_string(no_quote_blob) + " bash=" + to_string(bash_invoke) + ")")
        fail = fail + 1
    }

    // F-R8C-DRIVER-4: parse a SYNTHETIC result.json → init_log.L_ce.
    let tmp = "/tmp/r8c_probe_selftest_result.json"
    write_tmp(tmp, "{\"init_variant\":\"random\",\"init_log\":{\"L_ce\":14.4564,\"step\":1},\"verdict\":\"probe\"}")
    let parsed = r8c_parse_init_ce(tmp)
    let parse_ok = absf(parsed - 14.4564) < 0.0005
    // and a MISSING file → -1.0
    let missing = r8c_parse_init_ce("/tmp/r8c_probe_nonexistent_xyz.json")
    let missing_ok = missing < 0.0
    if parse_ok && missing_ok {
        println("F-R8C-DRIVER-4 PARSE PASS (init_CE=" + fmt4(parsed)
            + " from synthetic result.json · MISSING→-1.0)")
        pass = pass + 1
    } else {
        println("F-R8C-DRIVER-4 PARSE FAIL (parsed=" + fmt4(parsed)
            + " missing=" + fmt4(missing) + ")")
        fail = fail + 1
    }

    // F-R8C-DRIVER-5: verdict logic correct on SYNTHETIC deltas.
    //   case A: noise-dominant — cell-2 drops 2 nats, others flat.
    let mut ra = #{}
    ra["baseline"] = 14.46
    ra["cell-2"]   = 12.20   // delta 2.26 ≥ 1 → F-R8C-NOISE TRUE
    ra["cell-3"]   = 14.40   // delta 0.06 < 1 → FALSE
    ra["cell-4"]   = 12.10   // base-2 = 12.46; 12.10 < 12.46 → COMPOUND TRUE
    let va = r8c_verdict(ra)
    let case_a_ok =
        to_bool(va["baseline_reproduced"]) == true &&
        to_bool(va["F_R8C_NOISE"]) == true &&
        to_bool(va["F_R8C_KV_HEAD"]) == false &&
        to_bool(va["F_R8C_COMPOUND"]) == true
    //   case B: nothing crosses → INCONCLUSIVE; baseline drift → DEFERRED.
    let mut rb = #{}
    rb["baseline"] = 14.46
    rb["cell-2"]   = 14.40   // delta 0.06 < 1
    rb["cell-3"]   = 14.42   // delta 0.04 < 1
    rb["cell-4"]   = 14.30   // 14.30 > 12.46 → no compound
    let vb = r8c_verdict(rb)
    let case_b_ok =
        to_bool(vb["F_R8C_NOISE"]) == false &&
        to_bool(vb["F_R8C_KV_HEAD"]) == false &&
        to_bool(vb["F_R8C_COMPOUND"]) == false &&
        _str(vb["verdict"]).index_of("INCONCLUSIVE") == 0
    let mut rc = #{}
    rc["baseline"] = 13.00   // |13.00-14.46| = 1.46 > 0.1 → drift
    rc["cell-2"]   = 12.00
    rc["cell-3"]   = 12.00
    rc["cell-4"]   = 11.00
    let vc = r8c_verdict(rc)
    let case_c_ok =
        to_bool(vc["baseline_reproduced"]) == false &&
        _str(vc["verdict"]).index_of("DEFERRED") == 0
    if case_a_ok && case_b_ok && case_c_ok {
        println("F-R8C-DRIVER-5 VERDICT-LOGIC PASS (noise-dom · inconclusive · baseline-drift)")
        pass = pass + 1
    } else {
        println("F-R8C-DRIVER-5 VERDICT-LOGIC FAIL (A=" + to_string(case_a_ok)
            + " B=" + to_string(case_b_ok) + " C=" + to_string(case_c_ok) + ")")
        fail = fail + 1
    }

    println("")
    if fail == 0 {
        println("F-R8C-DRIVER-1..5 5/5 PASS")
        return 0
    }
    println("F-R8C-DRIVER-1..5 " + str(pass) + "/5 PASS (" + str(fail) + " FAIL)")
    return 1
}

// ─── usage + dispatch ────────────────────────────────────────────────────────

fn print_usage() {
    println("usage: hexa run probe_r8c_diagnostic.hexa <verb>")
    println("  cells                  print the 4-cell config matrix")
    println("  dispatch-cmds          print the 4 dispatch commands (PR #204 ✓ form)")
    println("  verdict <result-dir>   parse + render the init_CE verdict table")
    println("  selftest               F-R8C-DRIVER-1..5")
    println("")
    println("  CONTROL-PLANE only — the actual probe fire runs on a GPU pod")
    println("  (train_p21h_v3.py via " + DISPATCH + "); this driver never loads the model.")
}

fn pick_subcmd(argv: array) -> string {
    let n = len(argv)
    let mut i = 0
    while i < n {
        let t = _str(argv[i])
        if t == "selftest" { return "selftest" }
        if t == "cells" { return "cells" }
        if t == "dispatch-cmds" { return "dispatch-cmds" }
        if t == "verdict" { return "verdict" }
        if t == "help" || t == "--help" || t == "-h" { return "help" }
        i = i + 1
    }
    return "selftest"
}

fn arg_after(argv: array, key: string) -> string {
    let n = len(argv)
    let mut i = 0
    while i < n {
        if _str(argv[i]) == key && i + 1 < n { return _str(argv[i + 1]) }
        i = i + 1
    }
    return ""
}

fn main() {
    let argv = args()
    let sub = pick_subcmd(argv)
    if sub == "help" { print_usage(); exit(0) }
    if sub == "cells" { print_cells(); exit(0) }
    if sub == "dispatch-cmds" { print_dispatch_cmds(); exit(0) }
    if sub == "verdict" {
        let dir = arg_after(argv, "verdict")
        if dir == "" { print_usage(); exit(2) }
        print_verdict(dir)
        exit(0)
    }
    let code = run_selftest()
    exit(code)
}
