// S168 analytical closed-form threshold sweep on §161-FIRE motivation
// score distribution (mean, std, n) — derives the STRUCTURAL finding
// that the rate-limit / N_MAX_STEPS / THINK_INTERVAL_TEST_SEC triple
// DOMINATES the IM_THRESHOLD knob in the §161 measurement config.
//
// Inputs (all from §161-FIRE result.json — NO ckpt forward):
//   - axis2_motivation_score_dist: mean=0.4534, std=0.0376, n=20
//   - IM_THRESHOLD                = 0.30  (Wrong-C diagnosed)
//   - THINK_INTERVAL_TEST_SEC     = 0.1
//   - MIN_EMIT_INTERVAL           = 30.0
//   - N_MAX_STEPS_DEFAULT         = 20
//
// Method: Gaussian assumption on per-step motivation_score
//   (honest approximation; §161 reports only μ and σ, not full trace),
//   combined with the deterministic rate-limit semantics from
//   eval_s161_psicouple.py emit predicate (safety_extended ∧ score > θ
//   AND rate_ok requires sec_since >= MIN_EMIT_INTERVAL).
//
// Closed-form finding (B-S168-ANALYTIC-1..4, see verdict block below):
//   max_emits_per_run = 1 + floor(T_total / MIN_EMIT_INTERVAL)
//                     = 1 + floor(2.0 / 30.0) = 1 + 0 = 1
//   So emit_rate ≤ 1/20 = 0.05 ∀ θ where ∃ step with score>θ.
//   The observed 1/20 in §161 result.json IS the rate-limit ceiling,
//   NOT an indicator that θ=0.30 is the right value.
//
// Output: per-θ {p_at_least_one_emit, emit_rate_at_ceiling} table
//   plus the structural verdict above.

// === Gaussian CDF via Winitzki erf approximation =======================
// erf(x) ≈ sign(x) * sqrt( 1 - exp( -x² * (4/π + a*x²) / (1 + a*x²) ) )
// where a = 8(π-3) / (3π(4-π)) ≈ 0.140012
// max abs err ≈ 3.5e-5 over ℝ (acceptable for threshold-sweep granularity)

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _sign(x: float) -> float {
    if x < 0.0 { return -1.0 }
    if x > 0.0 { return  1.0 }
    return 0.0
}

fn _pi() -> float { return 3.141592653589793 }

fn _exp_neg(x: float) -> float {
    // x is expected non-negative (we call as exp(-something_nonneg))
    // Use Taylor at small x, then halving for larger via exp(-x) = (exp(-x/2))²
    if x < 0.0 { return 1.0 / _exp_neg(0.0 - x) }
    if x < 0.01 {
        let x2 = x * x
        let x3 = x2 * x
        let x4 = x3 * x
        return 1.0 - x + x2/2.0 - x3/6.0 + x4/24.0
    }
    if x > 1.0 {
        let half = _exp_neg(x / 2.0)
        return half * half
    }
    // x in [0.01, 1.0] — 8-term Taylor centered at 0
    let mut acc = 1.0
    let mut term = 1.0
    let mut k = 1
    while k <= 12 {
        term = term * (0.0 - x) / (k as float)
        acc = acc + term
        k = k + 1
    }
    return acc
}

fn _sqrt(x: float) -> float {
    // Newton's method, ~6 iters from x0 = max(x, 1)
    if x <= 0.0 { return 0.0 }
    let mut g = if x < 1.0 { 1.0 } else { x }
    let mut i = 0
    while i < 12 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

fn erf_winitzki(x: float) -> float {
    let a = 0.140012
    let xx = x * x
    let num = xx * (4.0 / _pi() + a * xx)
    let den = 1.0 + a * xx
    let inside = num / den
    let one_minus = 1.0 - _exp_neg(inside)
    return _sign(x) * _sqrt(one_minus)
}

fn gaussian_cdf(z: float) -> float {
    return 0.5 * (1.0 + erf_winitzki(z / _sqrt(2.0)))
}

fn p_score_above(theta: float, mu: float, sigma: float) -> float {
    let z = (theta - mu) / sigma
    return 1.0 - gaussian_cdf(z)
}

// === Rate-limit ceiling (deterministic from eval semantics) ============
fn rate_limit_ceiling(n_steps: int, think_interval: float,
                     min_emit_interval: float) -> int {
    let t_total = (n_steps as float) * think_interval
    let extra = t_total / min_emit_interval
    // 1 (initial) + floor(extra)
    let mut floor_extra = 0
    let mut acc = 0.0
    while (acc + 1.0) <= extra {
        acc = acc + 1.0
        floor_extra = floor_extra + 1
    }
    return 1 + floor_extra
}

// === Run probability over N steps ======================================
// P(at least one emit at θ) = 1 - (1 - P(score>θ))^N
fn p_at_least_one_above(theta: float, mu: float, sigma: float,
                        n_steps: int) -> float {
    let p_one = p_score_above(theta, mu, sigma)
    let mut p_none = 1.0
    let mut i = 0
    while i < n_steps {
        p_none = p_none * (1.0 - p_one)
        i = i + 1
    }
    return 1.0 - p_none
}

// === Sweep ============================================================
fn main() {
    // §161 measured constants (from result.json — observation, not derive)
    let mu     = 0.4534
    let sigma  = 0.0376
    let n      = 20

    // §24 Phase B / eval_s161_psicouple.py constants (source-byte-equal)
    let think_interval     = 0.1
    let min_emit_interval  = 30.0

    let ceil = rate_limit_ceiling(n, think_interval, min_emit_interval)
    let observed_emit       = 1
    let observed_emit_rate  = (observed_emit as float) / (n as float)
    let ceil_rate           = (ceil as float) / (n as float)

    print("=== S168 analytical threshold sweep — §161-FIRE motivation ===")
    print("μ=0.4534  σ=0.0376  n=20")
    print("THINK_INTERVAL_TEST_SEC=0.1  MIN_EMIT_INTERVAL=30.0  N_MAX_STEPS=20")
    print("---")
    print("rate-limit ceiling (closed-form):")
    print("  T_total = 20 × 0.1 = 2.0 sec  ≪  MIN_EMIT_INTERVAL=30s")
    print("  max_emits_per_run = 1 + floor(2.0/30.0) = " + to_string(ceil))
    print("  ⇒ emit_rate ≤ " + to_string(ceil_rate) + "  (regardless of θ in this regime)")
    print("---")
    print("observed (§161 result.json): emit=" + to_string(observed_emit)
          + " / n=" + to_string(n) + " = " + to_string(observed_emit_rate)
          + "  ⟸ EXACTLY at rate-limit ceiling")
    print("---")
    print("per-θ Gaussian-approx P(at-least-one-step score>θ):")
    print("  (capped by rate-limit ceiling = " + to_string(ceil_rate) + ")")
    print("")
    print("    θ    | P(score>θ)/step | P(≥1 emit over N=20) | capped_rate")
    print("  -------+----------------+----------------------+------------")

    let thresholds = [0.0, 0.10, 0.20, 0.25, 0.30, 0.35, 0.40, 0.45,
                      0.50, 0.55, 0.60, 0.65, 0.70]
    for theta in thresholds {
        let p_one = p_score_above(theta, mu, sigma)
        let p_any = p_at_least_one_above(theta, mu, sigma, n)
        let capped = if p_any < ceil_rate { p_any * ceil_rate / (p_any + 1e-12) } else { ceil_rate }
        // honest capped formula: min(p_any * ceil_rate, ceil_rate)
        // (no min builtin reliable; use if)
        let final_capped = if p_any < ceil_rate { p_any } else { ceil_rate }
        print("  θ=" + to_string(theta) + " | " + to_string(p_one)
              + " | " + to_string(p_any) + " | " + to_string(final_capped))
    }
    print("")
    print("=== STRUCTURAL FINDING (B-S168-ANALYTIC) ============================")
    print("• rate-limit ceiling = 1/20 = 0.05 ∀ θ in current §161 config")
    print("• observed §161 emit_rate 0.05 = SATURATED at this ceiling")
    print("• CONNECTION_CRITIQUE Wrong-C 'imThreshold=0.30 hardcoded' is")
    print("  correct that the threshold is unprincipled, BUT in this regime")
    print("  the dominant bottleneck is the (N_MAX × THINK_INTERVAL) /")
    print("  MIN_EMIT_INTERVAL ratio, NOT the threshold value.")
    print("• Lowering θ → 0 still hits rate-limit ceiling 0.05.")
    print("• Raising θ → 0.60+ → P(any) drops below ceiling — threshold")
    print("  becomes binding only for θ > ~μ+2σ ≈ 0.53.")
    print("• Honest fix path (TWO independent levers needed):")
    print("   (1) lower MIN_EMIT_INTERVAL (currently 30s) — but this is")
    print("       a §4 safety control (6-control SSOT, governance-gated)")
    print("   (2) extend N_MAX × THINK_INTERVAL (= wall time) so the")
    print("       rate-limit ceiling > 1; OR")
    print("   (3) anchor θ to anima-physics (per §167-A FP-RECONNECT)")
    print("       rather than to a scalar 0.30 — orthogonal to (1)/(2)")
    print("=====================================================================")
    print("verdict: ANALYTICAL-RATE-LIMIT-CEILING-DOMINATES-THRESHOLD")
    print("honest carve-out: Gaussian assumption on motivation_score; the")
    print("  true distribution may be non-Gaussian (8-factor sum of clamped")
    print("  components is bounded ⇒ slight tail compression). The")
    print("  rate-limit derivation is EXACT — Gaussian only affects the")
    print("  P(any) column, NOT the ceiling row. Per-step motivation_trace")
    print("  forward measurement deferred to upstream patch")
    print("  `pt-ckpt-cross-substrate-residual-readout.md` land.")
}

