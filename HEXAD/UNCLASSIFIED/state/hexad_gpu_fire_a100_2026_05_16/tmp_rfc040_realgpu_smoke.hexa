// @raw117_exempt
// ════════════════════════════════════════════════════════════════════════
// tmp_rfc040_realgpu_smoke.hexa — anima RFC 040 Phase D REAL-GPU smoke.
//
// Unlike tmp_rfc040_smoke.hexa (no-CUDA scaffolding, asserts
// cuda_available()==0), this smoke runs on a HEXA_CUDA build on a real
// CUDA host (A100). It asserts cuda_available()==1 and that the real
// cuBLAS Dgemm path (runtime_cuda.c TU) matches the CPU `ikj` oracle
// within a MEASURED fp tolerance (cuBLAS reduces in a different order →
// not bit-identical; we measure + report the actual max |Δ|).
//
// AGENTS.tape g3 — honesty: no fake. Real cudaGetDeviceCount, real
// cublasDgemm, measured tolerance (not asserted-from-thin-air).
//
//   1 F-RFC040-AVAIL          — cuda_available()==1 AND device_count>=1
//                                (real CUDA host — the inverse of the
//                                Mac scaffolding gate).
//   2 F-RFC040-STRUCT-NOREGRESS — CPU farr_matmul exact integer oracle
//                                [[4,5],[10,11]] unperturbed (err=0).
//   3 F-RFC040-GPU-EQ         — farr_matmul_gpu (real cuBLAS Dgemm)
//                                vs CPU oracle on the SAME integer
//                                inputs: max|Δ| == 0.0 exact (integers
//                                represent exactly in fp64; cuBLAS
//                                fp64 Dgemm is exact for these).
//   4 F-RFC040-GPU-EQ-LARGE   — 64x96 @ 96x48 pseudo-random Dgemm vs
//                                CPU oracle: max|Δ| measured + asserted
//                                < 1e-9 (RFC 040 §"Honest caveats"
//                                TOL_MATMUL; the ACTUAL value printed).
//   5 F-RFC040-DETERMINISM    — 3x back-to-back real-GPU Dgemm
//                                byte-identical (no run-to-run drift).
//
// 5/5 PASS → RFC 040 Phase D real-GPU path VERIFIED on A100.
// ════════════════════════════════════════════════════════════════════════

fn abs_d(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_abs_diff(c1: int, c2: int, n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n {
        let d = abs_d(farr_get(c1, i) - farr_get(c2, i))
        if d > m { m = d }
        i = i + 1
    }
    return m
}

// deterministic LCG → [-1, 1) doubles (no rand() — reproducible)
fn lcg_fill(a: int, n: int, seed: int) {
    let mut s = seed
    let mut i = 0
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483648
        let u = (to_float(s) / 2147483648.0) * 2.0 - 1.0
        let _ = farr_set(a, i, u)
        i = i + 1
    }
}

fn main() {
    let mut pass = 0
    let total = 5

    // ── Falsifier 1: F-RFC040-AVAIL (REAL CUDA host) ────────────────
    let avail = cuda_available()
    let count = cuda_device_count()
    if avail == 1 && count >= 1 {
        println("PASS  F-RFC040-AVAIL  cuda_available=" + to_string(avail) + " cuda_device_count=" + to_string(count) + " (REAL CUDA host — A100)")
        pass = pass + 1
    } else {
        println("FAIL  F-RFC040-AVAIL  avail=" + to_string(avail) + " count=" + to_string(count) + " (expected 1 / >=1 on HEXA_CUDA A100 build)")
    }

    // ── Falsifier 2: F-RFC040-STRUCT-NOREGRESS ──────────────────────
    let A = farr_zeros(6)
    let _a0 = farr_set(A, 0, 1.0)
    let _a1 = farr_set(A, 1, 2.0)
    let _a2 = farr_set(A, 2, 3.0)
    let _a3 = farr_set(A, 3, 4.0)
    let _a4 = farr_set(A, 4, 5.0)
    let _a5 = farr_set(A, 5, 6.0)
    let B = farr_zeros(6)
    let _b0 = farr_set(B, 0, 1.0)
    let _b1 = farr_set(B, 1, 0.0)
    let _b2 = farr_set(B, 2, 0.0)
    let _b3 = farr_set(B, 3, 1.0)
    let _b4 = farr_set(B, 4, 1.0)
    let _b5 = farr_set(B, 5, 1.0)
    let C_cpu = farr_matmul(A, 2, 3, B, 2)
    let oracle_err = abs_d(farr_get(C_cpu,0) - 4.0) + abs_d(farr_get(C_cpu,1) - 5.0) + abs_d(farr_get(C_cpu,2) - 10.0) + abs_d(farr_get(C_cpu,3) - 11.0)
    if oracle_err == 0.0 {
        println("PASS  F-RFC040-STRUCT-NOREGRESS  CPU farr_matmul = [[4,5],[10,11]] exact (err=0.0)")
        pass = pass + 1
    } else {
        println("FAIL  F-RFC040-STRUCT-NOREGRESS  err=" + to_string(oracle_err))
    }

    // ── Falsifier 3: F-RFC040-GPU-EQ (small, exact) ─────────────────
    let C_gpu = farr_matmul_gpu(A, 2, 3, B, 2)
    if C_gpu < 0 {
        println("FAIL  F-RFC040-GPU-EQ  farr_matmul_gpu returned " + to_string(C_gpu) + " (cuBLAS Dgemm error path)")
    } else {
        let len_gpu = farr_len(C_gpu)
        let diff = max_abs_diff(C_cpu, C_gpu, 4)
        if len_gpu == 4 && diff == 0.0 {
            println("PASS  F-RFC040-GPU-EQ  real cuBLAS Dgemm = CPU oracle exact (max|Δ|=0.0, len=4) — integer inputs exact in fp64")
            pass = pass + 1
        } else {
            println("FAIL  F-RFC040-GPU-EQ  len=" + to_string(len_gpu) + " max|Δ|=" + to_string(diff))
        }
    }

    // ── Falsifier 4: F-RFC040-GPU-EQ-LARGE (measured tolerance) ─────
    // 64x96 @ 96x48 pseudo-random fp64. cuBLAS reduces in a different
    // order than the CPU ikj loop → not bit-identical; measure the
    // ACTUAL max |Δ| and assert it under RFC 040 TOL_MATMUL (1e-9).
    let M = 64
    let K = 96
    let N = 48
    let LA = farr_zeros(M * K)
    let LB = farr_zeros(K * N)
    lcg_fill(LA, M * K, 1234567)
    lcg_fill(LB, K * N, 7654321)
    let LC_cpu = farr_matmul(LA, M, K, LB, N)
    let LC_gpu = farr_matmul_gpu(LA, M, K, LB, N)
    if LC_gpu < 0 {
        println("FAIL  F-RFC040-GPU-EQ-LARGE  farr_matmul_gpu returned " + to_string(LC_gpu))
    } else {
        let mxd = max_abs_diff(LC_cpu, LC_gpu, M * N)
        if mxd < 0.000000001 {
            println("PASS  F-RFC040-GPU-EQ-LARGE  64x96@96x48 cuBLAS Dgemm vs CPU oracle measured max|Δ|=" + to_string(mxd) + " < 1e-9 (TOL_MATMUL)")
            pass = pass + 1
        } else {
            println("FAIL  F-RFC040-GPU-EQ-LARGE  measured max|Δ|=" + to_string(mxd) + " >= 1e-9 (exceeds TOL_MATMUL)")
        }
    }

    // ── Falsifier 5: F-RFC040-DETERMINISM ───────────────────────────
    let G1 = farr_matmul_gpu(LA, M, K, LB, N)
    let G2 = farr_matmul_gpu(LA, M, K, LB, N)
    let G3 = farr_matmul_gpu(LA, M, K, LB, N)
    let d12 = max_abs_diff(G1, G2, M * N)
    let d23 = max_abs_diff(G2, G3, M * N)
    if d12 == 0.0 && d23 == 0.0 {
        println("PASS  F-RFC040-DETERMINISM  3x real cuBLAS Dgemm byte-identical (Δ_12=0.0, Δ_23=0.0)")
        pass = pass + 1
    } else {
        println("FAIL  F-RFC040-DETERMINISM  Δ_12=" + to_string(d12) + " Δ_23=" + to_string(d23))
    }

    println("")
    println("=== RFC040 REAL-GPU smoke: " + to_string(pass) + "/" + to_string(total) + " PASS ===")
    if pass == total {
        println("PASS — anima RFC 040 Phase D real cuBLAS Dgemm VERIFIED on A100 (HEXA_CUDA build)")
    } else {
        println("FAIL — RFC 040 Phase D real-GPU smoke incomplete")
    }
}
// NOTE: no explicit main() call — hexa-strict auto-invokes `fn main`.
