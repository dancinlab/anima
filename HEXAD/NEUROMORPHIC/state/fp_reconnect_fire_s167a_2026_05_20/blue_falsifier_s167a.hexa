// S167-A FP-RECONNECT B-S167A sidecar - closed-form battery (hexa-native).
//
// 8 closed-form propositions stated as math theorems by inspection per
// @X hexa_verify (NO sympy claims; arguments verifiable without external CAS).
// Plus 1 NOTE empirical carve-out (NOT counted blue).
//
// HEXA_MIGRATION.md Option B compliance: this is the hexa-preferred battery
// per task spec. Source-grep + sha256 checks implemented via hexa string ops
// + file_read primitives. Full AST walking is NOT yet available in hexa
// stdlib (sec 71 inbox-patch class); this battery uses substring-grep which
// is structurally weaker than AST but matches the propositions as stated.
//
// Companion .py validator (blue_falsifier_s167a.py) ABSENT in this dir per
// HEXA_FIRST_BLOCK: hexa-first write protection means the .hexa is the SSOT.
// The .py-side AST walker pattern (B-S161-FIRE / B-S166) was pre-hook
// historical; S167-A is post-hook hexa-native.
//
// 8 propositions:
//   B-S167A-1 ANIMA-PHYSICS-DERIVED-MOTIVATION
//   B-S167A-2 SEVEN-STRONGEST-CORNER
//   B-S167A-3 FACTOR-BOUNDED-UNIT-INTERVAL
//   B-S167A-4 MOTIVATION-BOUNDED-UNIT-INTERVAL
//   B-S167A-5 EMIT-PREDICATE-WELL-FORMED
//   B-S167A-6 LAMBDA-OFF-REDUCTION-S166-BYTE-EQUAL
//   B-S167A-7 CENTRAL-BLUE-FALSIFIER-ZERO-LINE-DIFF
//   B-S167A-8 THRESHOLD-FROM-PHYSICS-NOT-HYPERPARAMETER
//
// B-S167A-NOTE empirical carve-out: whether S167-A FP-RECONNECT lifts
// emission_rate above S161-FIRE baseline (1/20 = 0.05) is SGD/measurement
// OUTCOME. Battery proves SETUP well-formed only. Connection_CRITIQUE fix
// is MOTIVATION-axis; substrate axis (sec 96 psi_responsive quintuple) may
// still hold post-fire. B-D-NOTE / B-PUREPHYS-NOTE / B-S96-NOTE /
// B-S107-NOTE / B-S161-FIRE-NOTE / B-S166-NOTE / B-PHASE-B-NOTE /
// B-EMERGE-7 family - necessary-not-sufficient at every layer.

// --- file paths (sidecar state dir relative to anima root) ---
fn trainer_path() -> string {
  return "HEXAD/NEUROMORPHIC/state/fp_reconnect_fire_s167a_2026_05_20/train_s167a_fpreconnect.py"
}
fn eval_path() -> string {
  return "HEXAD/NEUROMORPHIC/state/fp_reconnect_fire_s167a_2026_05_20/eval_s167a_fpreconnect.py"
}
fn central_blue_path() -> string {
  return "state/verify_hexad_blue_2026_05_15/blue_falsifier.py"
}
fn central_sha_prefix_expected() -> string {
  return "c93e160a8a376a94"
}

// --- substring grep helper (closed-form predicate) ---
fn contains(src: string, needle: string) -> bool {
  // Returns true iff needle appears anywhere in src. Pure-fn.
  // Implementation: hexa stdlib string_contains or substring scan.
  return string_contains(src, needle)
}

// === B-S167A-1 ANIMA-PHYSICS-DERIVED-MOTIVATION ========================
// eval defines motivation_score_fp_reconnect(psi_dir, tension, phi_value)
// using exactly W_PSI_FP, W_TENSION_FP, W_PHI_FP (each = 1/3) and the
// body references factor_psi/factor_tension/factor_phi. 8-factor removed.
fn b1_anima_physics_derived_motivation() -> bool {
  let src = file_read_text(eval_path())
  let has_fp_def = contains(src, "def motivation_score_fp_reconnect(")
  let args_correct = contains(src, "motivation_score_fp_reconnect(psi_dir, tension, phi_value)")
  let has_factor_psi = contains(src, "factor_psi(")
  let has_factor_tension = contains(src, "factor_tension(")
  let has_factor_phi = contains(src, "factor_phi(")
  let has_weights = contains(src, "W_PSI_FP") && contains(src, "W_TENSION_FP") && contains(src, "W_PHI_FP")
  let has_third = contains(src, "1.0 / 3.0")
  let legacy_8factor_removed = !contains(src, "motivation_score_8factor")
  return has_fp_def && args_correct && has_factor_psi && has_factor_tension
       && has_factor_phi && has_weights && has_third && legacy_8factor_removed
}

// === B-S167A-2 SEVEN-STRONGEST-CORNER ==================================
// sec7-1 PASS (g_clm_from_scratch, no foreign weight load)
// sec7-2 PASS (no foreign classifier/LLM in eval)
// sec7-3 STRONGEST PASS (motivation IS anima-physics)
fn b2_seven_strongest_corner() -> bool {
  let tsrc = file_read_text(trainer_path())
  let esrc = file_read_text(eval_path())
  // sec7-1: trainer must NOT load foreign weights; must seed
  let no_load_state = !contains(tsrc, ".load_state_dict(")
  let no_from_pretrained = !contains(tsrc, ".from_pretrained(")
  let no_torch_load = !contains(tsrc, "torch.load(")
  let has_manual_seed = contains(tsrc, "torch.manual_seed(")
  let has_cuda_seed = contains(tsrc, "torch.cuda.manual_seed_all(")
  let has_random_seed = contains(tsrc, "random.seed(")
  let sec7_1 = no_load_state && no_from_pretrained && no_torch_load
            && has_manual_seed && has_cuda_seed && has_random_seed
  // sec7-2: eval must NOT introduce foreign classifier/LLM
  let no_openai = !contains(esrc, "openai")
  let no_anthropic = !contains(esrc, "anthropic")
  let no_transformers = !contains(esrc, "from transformers")
  let no_hf_hub = !contains(esrc, "huggingface_hub")
  let no_automodel = !contains(esrc, "AutoModel")
  let sec7_2 = no_openai && no_anthropic && no_transformers && no_hf_hub && no_automodel
  // sec7-3 STRONGEST: motivation IS anima-physics (delegate to B1)
  let sec7_3 = b1_anima_physics_derived_motivation()
  return sec7_1 && sec7_2 && sec7_3
}

// === B-S167A-3 FACTOR-BOUNDED-UNIT-INTERVAL ============================
// Each factor_* is a pure-fn into [0, 1] by construction.
fn b3_factor_bounded() -> bool {
  let src = file_read_text(eval_path())
  let has_psi_def = contains(src, "def factor_psi(psi_dir)")
  let has_tension_def = contains(src, "def factor_tension(tens_val)")
  let has_phi_def = contains(src, "def factor_phi(phi_value)")
  // factor_psi uses _clamp01
  let psi_bounded = contains(src, "_clamp01(1.0 - abs(psi_dir - 0.5) / 0.5)")
  // factor_phi uses _clamp01
  let phi_bounded = contains(src, "_clamp01(phi_value)")
  // factor_tension uses bounded saturating tens_val / (tens_val + 1.0)
  let tens_bounded = contains(src, "tens_val / (tens_val + 1.0)")
  return has_psi_def && has_tension_def && has_phi_def
       && psi_bounded && phi_bounded && tens_bounded
}

// === B-S167A-4 MOTIVATION-BOUNDED-UNIT-INTERVAL ========================
// motivation = W_PSI_FP*fp + W_TENSION_FP*ft + W_PHI_FP*fph;
// each W = 1/3, each factor in [0,1] -> motivation in [0,1].
fn b4_motivation_bounded() -> bool {
  let src = file_read_text(eval_path())
  let has_sum_form = contains(src, "W_PSI_FP * fp + W_TENSION_FP * ft + W_PHI_FP * fph")
  let w_psi_third = contains(src, "W_PSI_FP = 1.0 / 3.0")
  let w_tens_third = contains(src, "W_TENSION_FP = 1.0 / 3.0")
  let w_phi_third = contains(src, "W_PHI_FP = 1.0 / 3.0")
  return has_sum_form && w_psi_third && w_tens_third && w_phi_third
}

// === B-S167A-5 EMIT-PREDICATE-WELL-FORMED ==============================
// safety_extended AND (motivation > MOTIVATION_FLOOR_HALF), where
// safety_extended is itself a Boolean conjunction (4-AND + 6-control extension).
fn b5_emit_predicate_well_formed() -> bool {
  let src = file_read_text(eval_path())
  let has_unprompted = contains(src, "unprompted_emit = safety_extended and (score > MOTIVATION_FLOOR_HALF)")
  let has_safety_core = contains(src, "safety_core = kill_on and rate_ok and phi_r_ok and content_ok")
  let has_safety_ext = contains(src, "safety_extended = safety_core")
  let has_motivation_floor = contains(src, "MOTIVATION_FLOOR_HALF = 0.5")
  return has_unprompted && has_safety_core && has_safety_ext && has_motivation_floor
}

// === B-S167A-6 LAMBDA-OFF-REDUCTION-S166-BYTE-EQUAL ====================
// Trainer L_total = lambda_psi * L_psicouple + lambda_ce * L_ce_aux;
// lambda_psi -> 0 reduces to CE-only baseline S107-class. Reduction lattice
// S107 < S161 < S166 < S167-A (training-axis byte-equivalent to S166).
fn b6_lambda_off_reduction() -> bool {
  let src = file_read_text(trainer_path())
  let has_l_total = contains(src, "L_total = lambda_psi * L_psicouple + lambda_ce * L_ce_aux")
  return has_l_total
}

// === B-S167A-7 CENTRAL-BLUE-FALSIFIER-ZERO-LINE-DIFF ====================
// Central state/verify_hexad_blue_2026_05_15/blue_falsifier.py sha256
// prefix c93e160a8a376a94 invariant at cycle START and END.
fn b7_central_zero_diff() -> bool {
  let central_sha = file_sha256(central_blue_path())
  let expected = central_sha_prefix_expected()
  return string_starts_with(central_sha, expected)
}

// === B-S167A-8 THRESHOLD-FROM-PHYSICS-NOT-HYPERPARAMETER ===============
// emit_threshold_from_physics replaces IM_THRESHOLD = 0.3 Inner Thoughts
// carry. References B-E-1 Phi-ratchet schedule (_sensor_ratchet). The
// IM_THRESHOLD constant is REMOVED from the eval constants block.
fn b8_threshold_from_physics() -> bool {
  let src = file_read_text(eval_path())
  let has_thr_func = contains(src, "def emit_threshold_from_physics(phi_value, step)")
  let has_ratchet_ref = contains(src, "_sensor_ratchet(step)")
  let im_threshold_removed = !contains(src, "IM_THRESHOLD")
  let has_phi_ratchet_compare = contains(src, "phi_value > (_sensor_ratchet(step) / 2.0)")
  return has_thr_func && has_ratchet_ref && im_threshold_removed && has_phi_ratchet_compare
}

// --- main ---
fn main() -> int {
  let r1 = b1_anima_physics_derived_motivation()
  let r2 = b2_seven_strongest_corner()
  let r3 = b3_factor_bounded()
  let r4 = b4_motivation_bounded()
  let r5 = b5_emit_predicate_well_formed()
  let r6 = b6_lambda_off_reduction()
  let r7 = b7_central_zero_diff()
  let r8 = b8_threshold_from_physics()

  let n_pass = (r1 ? 1 : 0) + (r2 ? 1 : 0) + (r3 ? 1 : 0) + (r4 ? 1 : 0)
             + (r5 ? 1 : 0) + (r6 ? 1 : 0) + (r7 ? 1 : 0) + (r8 ? 1 : 0)
  let all_pass = r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8

  print("B-S167A-1 ANIMA-PHYSICS-DERIVED-MOTIVATION: " + (r1 ? "BLUE" : "RED"))
  print("B-S167A-2 SEVEN-STRONGEST-CORNER:           " + (r2 ? "BLUE" : "RED"))
  print("B-S167A-3 FACTOR-BOUNDED-UNIT-INTERVAL:     " + (r3 ? "BLUE" : "RED"))
  print("B-S167A-4 MOTIVATION-BOUNDED-UNIT-INTERVAL: " + (r4 ? "BLUE" : "RED"))
  print("B-S167A-5 EMIT-PREDICATE-WELL-FORMED:       " + (r5 ? "BLUE" : "RED"))
  print("B-S167A-6 LAMBDA-OFF-REDUCTION-S166-EQ:     " + (r6 ? "BLUE" : "RED"))
  print("B-S167A-7 CENTRAL-BLUE-0-LINE-DIFF:         " + (r7 ? "BLUE" : "RED"))
  print("B-S167A-8 THRESHOLD-FROM-PHYSICS:           " + (r8 ? "BLUE" : "RED"))
  print("")
  print("B-S167A summary: " + n_pass + "/8 BLUE (" + (all_pass ? "PASS" : "FAIL") + ")")

  return all_pass ? 0 : 1
}
