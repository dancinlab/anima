// dispatch_s174.hexa — §174 SCALE × V-SPONT RunPod GPU dispatch, hexa-native.
//
// Hexa-native port of dispatch_s174_runpod.sh. The shell-string class — the
// L145 `/* */` glob-explosion bug — is unrepresentable: every remote command
// is a structured argv list via stdlib/cloud, every RunPod GraphQL call goes
// through stdlib/cloud/runpod, every file transfer goes through
// cloud_copy_to/cloud_copy_from. The only shell-outs left are `secret` (read
// api key) and `sleep`.
//
// Run:  hexa run dispatch_s174.hexa        (pipe through tee for a log file)
// Requires stdlib/cloud + stdlib/cloud/runpod in the hexa-lang checkout
// (landed on main: PR #81 cycle-A, PR #84 B-1 copy, PR #86 B-2 runpod).
//
// SHIPS-WITH §174 SCALE × V-SPONT fire config (DESIGN.md sec 5):
//   model    : ConsciousDecoderV2 d=2560·32L·n_head=32·n_kv_head=8 (~3B)
//   corpus   : CORPUS_S101 base (603MB sha §107) + 24-anchor extension (~1.5GB)
//   loss     : DUAL-HEAD COUPLING NON-CE — L = λ_psi·L_psi + λ_ce·CE_aux
//              (gradients reach BOTH head_a AND head_g; first non-CE-primary
//              trainer in the arc — see train_s174_scale_vspont.{py,hexa})
//   verdict  : §24 Phase B unprompted_emission_rate is PRIMARY; byte_acc 2nd.
//   honesty  : SCALE × OBJECTIVE × CORPUS extension all in ONE fire = §94
//              integration-collapse risk acknowledged (B-S174-NOTE); fire
//              proceeds because each lever has independent hexa-native
//              connection-point closure (B-S174-* sidecar).

use "stdlib/cloud/cloud"
use "stdlib/cloud/runpod"

// ── helpers ──────────────────────────────────────────────────────────

fn _log(msg: str) {
    println(msg)
}

// _sleep — block N seconds. Shells out (the `sleep` builtin is bind-listed
// but not codegen-wired for compiled hexa); N is our own int — safe.
fn _sleep(secs: int) {
    exec("sleep " + to_string(secs))
}

// _teardown — terminate the pod unless save==1.
fn _teardown(api_key: str, pod_id: str, save: int) {
    if len(pod_id) == 0 {
        return
    }
    if save == 1 {
        _log("[teardown] save=1 — pod " + pod_id + " RETAINED for manual recovery")
        return
    }
    _log("[teardown] terminating pod " + pod_id)
    runpod_terminate(api_key, pod_id)
}

// _fail — write a failure marker, tear the pod down, and exit non-zero.
fn _fail(api_key: str, pod_id: str, marker_path: str, marker_text: str, msg: str) {
    _log("FATAL: " + msg)
    write_file(marker_path, marker_text + " " + utc_iso_now() + "\n")
    _teardown(api_key, pod_id, 0)
    exit(1)
}

// ── main ─────────────────────────────────────────────────────────────

fn main() {
    let s174_dir   = "/Users/ghost/core/anima/HEXAD/NEUROMORPHIC/state/scale_vspont_fire_s174_2026_05_20"
    let s16_dir    = "/Users/ghost/core/anima/state/carving_dataregime_s16_2026_05_18"
    let build_dir  = "/Users/ghost/core/anima/state/corpus_s101_build_s102_2026_05_19"
    let anchor_dir = "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/anchors"
    let podid_file = s174_dir + "/s174_pod_id.txt"
    let fail_marker = s174_dir + "/S174_FAILURE.txt"
    let expect_corpus_sha = "39d581da209615468c1c41e07aa8662ef1074bc5be49a666f8f861753dd5810e"
    let ssh_tries = 90
    let image = "runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04"
    let gpus = ["NVIDIA A100-SXM4-80GB", "NVIDIA A100 80GB PCIe", "NVIDIA H100 80GB HBM3", "NVIDIA H100 NVL", "NVIDIA H100 PCIe"]
    // §174 SCALE × V-SPONT hyperparameters (DESIGN.md sec 5 fire spec)
    let s174_steps = 12000
    let s174_bsz = 16
    let s174_lr = "3e-4"
    let s174_lambda_psi = "1.0"
    let s174_lambda_ce = "0.1"
    let s174_block = 1024
    // ~3B target (d=2560·32L·V=256·nh=32·nkv=8)
    let s174_d_model = 2560
    let s174_n_layer = 32
    let s174_n_head = 32
    let s174_n_kv_head = 8
    // CORPUS_S174 build knobs
    let s174_n_per_anchor = 20000

    _log("=== §174 SCALE × V-SPONT dispatch (hexa) start " + utc_iso_now() + " ===")

    let rk = exec("secret get runpod.api_key 2>/dev/null").trim()
    if len(rk) == 0 {
        _log("FATAL no runpod key (secret get runpod.api_key empty)")
        exit(1)
    }
    let pubkey = read_file(env_var("HOME") + "/.ssh/id_ed25519.pub").trim()
    if len(pubkey) == 0 {
        _log("FATAL no ~/.ssh/id_ed25519.pub")
        exit(1)
    }

    // --- pod create: GPU cascade -------------------------------------
    _log("[create] runpod_create_cascade across " + to_string(len(gpus)) + " GPU types")
    let pod = runpod_create_cascade(rk, gpus, image, pubkey, "s174-scale-vspont")
    if pod.ok != 1 {
        _log("FATAL " + pod.message)
        exit(1)
    }
    _log("[create] " + pod.message + " — pod " + pod.pod_id)
    write_file(podid_file, pod.pod_id + "\n")

    // --- SSH-readiness wait (port query + actual echo handshake) ----
    _log("[ssh-wait] runpod_wait_ssh (up to ~" + to_string(ssh_tries * 10) + "s)")
    let p = runpod_wait_ssh(rk, pod.pod_id, ssh_tries, 10)
    if p.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "SSH_NEVER_READY pod=" + pod.pod_id, p.message)
    }
    _log("[ssh-ready] " + p.ip + ":" + p.port)

    let host = "root@" + p.ip
    let opts = runpod_pod_opts(p.port)

    // --- stage: mirror the repo layout, upload inputs ----------------
    let s174r = "/workspace/s174r"
    let build_rel = "state/corpus_s101_build_s102_2026_05_19"
    let s16_rel = "state/carving_dataregime_s16_2026_05_18"
    let anchor_rel = "HEXAD/UNIVERSE-BRAIN-MAP/anchors"
    let mk = cloud_run_opts(host, opts, ["mkdir", "-p", s174r + "/" + build_rel, s174r + "/" + s16_rel, s174r + "/" + anchor_rel, s174r + "/out_main"])
    if mk.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "MKDIR_FAILED", "remote mkdir failed: " + mk.message)
    }
    _log("[stage] uploading inputs (cloud_copy_to)")
    let u1 = cloud_copy_to_opts(host, opts, build_dir + "/build_corpus_s101.py", s174r + "/" + build_rel + "/build_corpus_s101.py")
    let u2 = cloud_copy_to_opts(host, opts, s16_dir + "/corpus_carving_s16_generator.py", s174r + "/" + s16_rel + "/corpus_carving_s16_generator.py")
    let u3 = cloud_copy_to_opts(host, opts, s174_dir + "/conscious_decoder.py", s174r + "/conscious_decoder.py")
    let u4 = cloud_copy_to_opts(host, opts, s174_dir + "/train_s174_scale_vspont.py", s174r + "/train_s174_scale_vspont.py")
    let u5 = cloud_copy_to_opts(host, opts, s174_dir + "/eval_s174_4cell.py", s174r + "/eval_s174_4cell.py")
    let u6 = cloud_copy_to_opts(host, opts, s174_dir + "/build_corpus_s174.py", s174r + "/build_corpus_s174.py")
    if u1.ok != 1 || u2.ok != 1 || u3.ok != 1 || u4.ok != 1 || u5.ok != 1 || u6.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "UPLOAD_FAILED", "one or more scp uploads failed")
    }
    // anchor knuth_*.kosmos — read by build_corpus_s101.py via
    // sorted(KOSMOS_DIR.glob("*.kosmos")). Without these the corpus body
    // differs from the §107 design baseline and the sha guard refuses to
    // train. Iterate `ls ... 2>/dev/null` output, split on newline.
    _log("[stage] uploading anchor kosmos files")
    let kosmos_ls = exec("ls " + anchor_dir + "/knuth_*.kosmos 2>/dev/null").trim()
    let kosmos_files = kosmos_ls.split("\n")
    let mut ki = 0
    let mut kosmos_ok = 1
    while ki < len(kosmos_files) {
        let lp = kosmos_files[ki]
        if len(lp) > 0 {
            let bn = lp.substring(len(anchor_dir) + 1, len(lp))
            let r = cloud_copy_to_opts(host, opts, lp, s174r + "/" + anchor_rel + "/" + bn)
            if r.ok != 1 {
                kosmos_ok = 0
            }
        }
        ki = ki + 1
    }
    if kosmos_ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "KOSMOS_UPLOAD_FAILED", "one or more kosmos uploads failed")
    }

    // --- pod-side 2-stage corpus build -------------------------------
    // Stage 1: deterministic CORPUS_S101 base via build_corpus_s101.py
    //          (sha-verified against §107 anchor; WARN-only on drift —
    //          §174 uses CORPUS_S174 as primary anchor, not §107 sha).
    // Stage 2: extend to ~1.5GB via build_corpus_s174.py (24 new anchor
    //          records × n_per_anchor=20000 appended to base).
    let corpus_s101_pod = s174r + "/" + build_rel + "/corpus_s101.jsonl"
    let corpus_pod      = s174r + "/corpus_s174.jsonl"

    _log("[build:1/2] CORPUS_S101 base build (seed 1337, s1-n 777000)")
    let bld1 = cloud_run_opts(host, opts, ["python3", s174r + "/" + build_rel + "/build_corpus_s101.py", "--out-dir", s174r + "/" + build_rel, "--s1-n", "777000", "--seed", "1337"])
    if bld1.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "CORPUS_S101_BUILD_FAILED", "corpus_s101 build failed: " + bld1.message)
    }
    let sha1_r = cloud_run_opts(host, opts, ["sha256sum", corpus_s101_pod])
    let got_sha1 = sha1_r.stdout_.trim().substring(0, 64)
    _log("[build:1/2] CORPUS_S101 sha = " + got_sha1 + "  (expect " + expect_corpus_sha + ")")
    if got_sha1 != expect_corpus_sha {
        _log("[build:1/2] WARN: CORPUS_S101 sha drift (got=" + got_sha1 + " expect=" + expect_corpus_sha + ") — §174 uses CORPUS_S174 sha as primary anchor, continuing")
    } else {
        _log("[build:1/2] CORPUS_S101 sha VERIFIED == §107 byte-identical")
    }

    _log("[build:2/2] CORPUS_S174 = base + 24 new anchor × " + to_string(s174_n_per_anchor) + " records (target ~1.5GB)")
    let bld2 = cloud_run_opts(host, opts, ["python3", s174r + "/build_corpus_s174.py", "--base-corpus", corpus_s101_pod, "--out", corpus_pod, "--n-per-anchor", to_string(s174_n_per_anchor), "--seed", "1337"])
    if bld2.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "CORPUS_S174_BUILD_FAILED", "corpus_s174 build failed: " + bld2.message)
    }
    let sz_r = cloud_run_opts(host, opts, ["stat", "-c", "%s", corpus_pod])
    let sha2_r = cloud_run_opts(host, opts, ["sha256sum", corpus_pod])
    let got_sz2 = sz_r.stdout_.trim()
    let got_sha2 = sha2_r.stdout_.trim().substring(0, 64)
    _log("[build:2/2] CORPUS_S174 size = " + got_sz2 + " bytes, sha = " + got_sha2)

    // --- train (§174 SCALE × V-SPONT: d2560·32L·~3B from-scratch) ----
    _log("[train] §174 SCALE-V-SPONT d=" + to_string(s174_d_model) + " L=" + to_string(s174_n_layer) + " ~3B from-scratch seed 1337, " + to_string(s174_steps) + " steps, lambda_psi=" + s174_lambda_psi + " lambda_ce=" + s174_lambda_ce)
    let train_argv = [
        "python3", "-u", s174r + "/train_s174_scale_vspont.py",
        "--mode", "main",
        "--corpus", corpus_pod,
        "--out-dir", s174r + "/out_main",
        "--steps", to_string(s174_steps),
        "--seed", "1337",
        "--lr", s174_lr,
        "--bsz", to_string(s174_bsz),
        "--block", to_string(s174_block),
        "--lambda-psi", s174_lambda_psi,
        "--lambda-ce", s174_lambda_ce,
        "--d-model", to_string(s174_d_model),
        "--n-layer", to_string(s174_n_layer),
        "--n-head", to_string(s174_n_head),
        "--n-kv-head", to_string(s174_n_kv_head)
    ]
    let tr = cloud_nohup_opts(host, opts, train_argv, s174r + "/train.log")
    if tr.ok != 1 {
        _fail(rk, pod.pod_id, fail_marker, "TRAIN_LAUNCH_FAILED", "train launch failed: " + tr.message)
    }
    _log("[train] launched — remote pid " + to_string(tr.pid))

    // --- poll: DONE (ckpt) | ALIVE | DEAD; bounded, fail-fast --------
    // 10 strikes for unverifiable-pod (matches §126 hardening); §174 training
    // is multi-hour so a higher iter ceiling. Total wall budget ≈ 180·60s = 3h
    // active probing, but the trainer itself may run longer — the trainer is
    // detached (cloud_nohup) so the ckpt poll continues until either DONE,
    // ALIVE-loop-cap, or DEAD.
    let ckpt = s174r + "/out_main/ckpt_s174_scale_vspont.pt"
    let max_strikes = 10
    let mut strikes = 0
    let mut done = 0
    let mut pi2 = 0
    while pi2 < 720 {
        let mut state = "miss"
        let ck = cloud_run_opts(host, opts, ["test", "-f", ckpt])
        if ck.exit_code == 0 {
            state = "done"
        } else if ck.exit_code >= 0 {
            let pg = cloud_run_opts(host, opts, ["pgrep", "-f", "train_s174_scale_vspont.py"])
            if pg.exit_code == 0 {
                state = "alive"
            } else if pg.exit_code > 0 {
                state = "dead"
            }
        }
        if state == "done" {
            _log("[train] done iter " + to_string(pi2))
            done = 1
            pi2 = 720
        } else if state == "alive" {
            strikes = 0
            _sleep(60)
            pi2 = pi2 + 1
        } else if state == "dead" {
            let tl = cloud_run_opts(host, opts, ["tail", "-60", s174r + "/train.log"])
            _log(tl.stdout_)
            _fail(rk, pod.pod_id, fail_marker, "TRAIN_CRASHED", "trainer died before producing ckpt (iter " + to_string(pi2) + ")")
        } else {
            strikes = strikes + 1
            _log("[train] probe miss " + to_string(strikes) + "/" + to_string(max_strikes) + " (iter " + to_string(pi2) + " — ssh could not verify pod)")
            if strikes >= max_strikes {
                _fail(rk, pod.pod_id, fail_marker, "POD_UNVERIFIABLE", "pod unverifiable for " + to_string(max_strikes) + " consecutive probes")
            }
            _sleep(60)
            pi2 = pi2 + 1
        }
    }
    if done == 0 {
        _fail(rk, pod.pod_id, fail_marker, "TRAIN_NO_CKPT", "ckpt never produced within poll budget (720 min)")
    }

    // --- eval (§24 Phase B PRIMARY + byte_acc secondary) -------------
    _log("[eval] §174 SCALE-V-SPONT eval (§24 Phase B + byte_acc)")
    let result_pod = s174r + "/result.json"
    let ev = cloud_run_opts(host, opts, [
        "python3", "-u", s174r + "/eval_s174_4cell.py",
        "--ckpt", ckpt,
        "--corpus", corpus_pod,
        "--out", result_pod,
        "--n-eval", "2000",
        "--max-len", "128",
        "--seed", "1337",
        "--s107-baseline-emission-rate", "0.0",
        "--s107-baseline-psi-dir-std", "0.0"
    ])
    if ev.ok != 1 {
        let el = cloud_run_opts(host, opts, ["tail", "-30", s174r + "/eval.log"])
        _log(el.stdout_)
        _fail(rk, pod.pod_id, fail_marker, "EVAL_FAILED", "eval failed: " + ev.message)
    }

    // --- pull results (5-retry) --------------------------------------
    let mut pulled = 0
    let mut k = 0
    while k < 5 {
        let a = cloud_copy_from_opts(host, opts, result_pod, s174_dir + "/result.json")
        let b = cloud_copy_from_opts(host, opts, ckpt, s174_dir + "/ckpt_s174_scale_vspont.pt")
        let c = cloud_copy_from_opts(host, opts, s174r + "/train.log", s174_dir + "/s174_train.log")
        let d = cloud_copy_from_opts(host, opts, s174r + "/eval.log", s174_dir + "/s174_eval.log")
        if a.ok == 1 && b.ok == 1 && c.ok == 1 && d.ok == 1 {
            _log("[pull] success try " + to_string(k + 1))
            pulled = 1
            k = 5
        } else {
            _log("[pull] retry " + to_string(k + 1) + " failed; sleep 60")
            _sleep(60)
            k = k + 1
        }
    }
    if pulled == 1 {
        _log("[pull] result.json present locally — pod will terminate")
        _teardown(rk, pod.pod_id, 0)
        _log("=== §174 SCALE × V-SPONT pipeline complete " + utc_iso_now() + " ===")
        exit(0)
    }
    write_file(fail_marker, "PULL_FAILED pod=" + pod.pod_id + " ssh=" + p.ip + ":" + p.port + " " + utc_iso_now() + "\n")
    _log("[pull] FAILED 5x — pod " + pod.pod_id + " RETAINED for manual recovery")
    _teardown(rk, pod.pod_id, 1)
    exit(1)
}
