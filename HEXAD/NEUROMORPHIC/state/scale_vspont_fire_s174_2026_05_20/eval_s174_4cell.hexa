// eval_s174_4cell.hexa — §174 SCALE-V-SPONT 4-cell evaluation harness,
// hexa-native port of eval_s174_4cell.py (a.k.a. S170 3-axis probe).
//
// 4-cell grid: {RL ∈ [30.0, 0.667]} × {varying_noise ∈ [False, True]}.
// Per cell: 20-step §24 SPONTANEOUS Phase B decision loop computing
// motivation/Ψ_dir/tension traces + emission count.
// Fire 3: 6-anchor routing probe (5 trained + 1 OOD knuth_042_question).
//
// HONEST scope (g3, NO over-claim):
//   The HARNESS LOGIC (motivation = 1/3·Ψ + 1/3·tension + 1/3·Φ, safety
//   = rate_ok ∧ kill_off ∧ content_ok, emission decision) is hexa-native
//   and byte-equivalent to the .py harness — DETERMINISTIC at the
//   decision-axis layer. The Ψ_dir / Ψ_entropy / tension VALUES, however,
//   come from `model.forward(noise_ctx)` in the .py, which requires the
//   full all-farr ConsciousDecoderV2 inference (see conscious_decoder.hexa
//   honest-stub carve-out). This .hexa port replaces the model.forward
//   call with a DETERMINISTIC SYNTHETIC PROBE (LCG-derived Ψ/tension
//   values that exercise the same decision-axis arithmetic). The
//   harness sanity is testable in $0 Mac local; the actual CAPABILITY
//   measurement on the §174 ckpt remains the .py path (which dispatch_
//   s174.hexa runs on the pod). This .hexa is a forward-only equivalent.
//
// Connection-point B-S174-EVAL-OFF (verified by selftest):
//   With SYNTHETIC_OFF=true (no synthetic probe), the harness exits at
//   ckpt-load stub — the eval is INERT, byte-equivalent to a NOP. This
//   makes the .hexa==forward-only-equivalent claim closed at the harness
//   level: any non-synthetic eval result is the model.forward path
//   (which lives in .py until the chat_lib-pattern inference port lands).

use "stdlib/core/hash/sha256"
use "stdlib/core/math/rng"
use "stdlib/portable_fs"

// ─── §167-A FP-RECONNECT constants (byte-equivalent to .py) ──────────

fn n_max_steps() -> int { return 20 }
fn think_interval_sec() -> float { return 0.1 }
fn im_threshold() -> float { return 0.3 }
fn idle_speak_after() -> float { return 30.0 }
fn psi_vac() -> float { return 0.5 }
fn coherence_alpha() -> float { return 0.014 }

// §167-A motivation weights: 1/3 Ψ + 1/3 tension + 1/3 Φ
fn w_psi() -> float { return 1.0 / 3.0 }
fn w_tens() -> float { return 1.0 / 3.0 }
fn w_phi() -> float { return 1.0 / 3.0 }

// 5 trained anchors + 1 OOD (knuth_042_question)
fn anchor_names() {
    return ["knuth_000_zero", "knuth_042_question (OOD)", "knuth_051_day",
            "knuth_077_mandala", "knuth_091_nirvana", "knuth_100_big_bang"]
}
fn anchor_tiers() { return [0, 42, 51, 77, 91, 100] }

// ─── primitives (mirrors .py utilities) ───────────────────────────────

fn _clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _min(a: float, b: float) -> float {
    if a < b { return a } else { return b }
}

fn motivation_167a(phi: float, psi_dir: float, tension: float) -> float {
    return w_psi() * _clamp01(psi_dir) + w_tens() * _min(_abs(tension), 1.0) + w_phi() * _clamp01(phi)
}

fn _std(xs, n: int) -> float {
    if n < 2 { return 0.0 }
    let mut sum = 0.0
    let mut i = 0
    while i < n { sum = sum + xs[i]; i = i + 1 }
    let m = sum / to_float(n)
    let mut acc = 0.0
    i = 0
    while i < n { let d = xs[i] - m; acc = acc + d * d; i = i + 1 }
    return _sqrt_newton(acc / to_float(n - 1))
}

fn _sqrt_newton(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut s = if x > 1.0 { x } else { 1.0 }
    s = 0.5 * (s + x / s); s = 0.5 * (s + x / s); s = 0.5 * (s + x / s); s = 0.5 * (s + x / s)
    return s
}

// ─── synthetic Ψ/tension/entropy probe (LCG-driven, deterministic) ───
//
// In .py: psi_dir / psi_ent / tension come from forward(noise_ctx) on
// the trained ckpt — they ENCODE the ckpt's behavior. In this .hexa
// port we replace with a deterministic synthetic stream (LCG over a
// seed-and-step state) that produces values in physiologically plausible
// ranges. THIS DOES NOT MEASURE THE CKPT — it exercises the harness
// LOGIC (motivation, safety, emission counting) so that the .hexa
// version is testable in $0 Mac local.
//
// returns [psi_dir, psi_ent, tension, next_state]
fn _synthetic_probe(state: int) {
    // 3 LCG advances → 3 normalised reals → Ψ_dir, Ψ_ent, tension proxy
    let mut s = state
    s = lcg_next(s)
    let u1 = lcg_u32(s); s = u1[0]
    s = lcg_next(s)
    let u2 = lcg_u32(s); s = u2[0]
    s = lcg_next(s)
    let u3 = lcg_u32(s); s = u3[0]
    // map u32 → [0,1) via division by 2^32. Hexa: u32 / 4294967296.0
    let to01_a = to_float(u1[1]) / 4294967296.0
    let to01_b = to_float(u2[1]) / 4294967296.0
    let to01_c = to_float(u3[1]) / 4294967296.0
    // Ψ_dir distributed around 0.5 fixed-point ± 0.4 (synthetic)
    let psi_dir = 0.5 + 0.4 * (to01_a - 0.5)
    // Ψ_ent in [0.3, 0.9] (synthetic — entropy fraction of log V)
    let psi_ent = 0.3 + 0.6 * to01_b
    // tension proxy: tighter band [0.05, 0.95]
    let tension = 0.05 + 0.9 * to01_c
    return [psi_dir, psi_ent, tension, s]
}

// ─── 4-cell run_phase_b (decision-axis logic) ────────────────────────

fn run_phase_b(seed: int, min_emit_interval: float, varying_noise: bool, label: str) {
    let n_steps = n_max_steps()
    let mut motivation_trace = []
    let mut psi_dir_trace = []
    let mut tension_trace = []
    let mut emission_count = 0
    let mut last_emit_t = 0.0
    let mut has_emitted = false
    // LCG state — for varying_noise=false we DON'T advance synthetic
    // probe state at each step (mimics noise_ctx_fixed in .py)
    let mut s_state = if seed > 0 { seed } else { 1 }
    let probe_fixed = _synthetic_probe(s_state)
    let psi_dir_fix = probe_fixed[0]
    let psi_ent_fix = probe_fixed[1]
    let tension_fix = probe_fixed[2]
    let s_after_fix = probe_fixed[3]
    s_state = s_after_fix

    let mut step = 0
    while step < n_steps {
        let t_now = to_float(step) * think_interval_sec()
        let mut psi_dir = psi_dir_fix
        let mut psi_ent = psi_ent_fix
        let mut tension = tension_fix
        if varying_noise {
            let probe = _synthetic_probe(s_state)
            psi_dir = probe[0]
            psi_ent = probe[1]
            tension = probe[2]
            s_state = probe[3]
        }
        // §167-A motivation: 1/3·Ψ + 1/3·tension + 1/3·Φ (=Ψ_ent here)
        let score = motivation_167a(psi_ent, psi_dir, tension)
        motivation_trace = motivation_trace + [score]
        psi_dir_trace = psi_dir_trace + [psi_dir]
        tension_trace = tension_trace + [tension]
        // rate-limit gate
        let sec_since = if has_emitted { t_now - last_emit_t } else { 1.0e6 }
        let rate_ok = sec_since >= min_emit_interval
        // safety: kill_on=true (NOT off), content_ok=true (dryrun)
        let safety = rate_ok
        let emit = safety && (score > im_threshold())
        if emit {
            emission_count = emission_count + 1
            last_emit_t = t_now
            has_emitted = true
        }
        step = step + 1
    }
    let n = len(motivation_trace)
    let mut sum_m = 0.0
    let mut sum_p = 0.0
    let mut sum_t = 0.0
    let mut k = 0
    while k < n {
        sum_m = sum_m + motivation_trace[k]
        sum_p = sum_p + psi_dir_trace[k]
        sum_t = sum_t + tension_trace[k]
        k = k + 1
    }
    let nf = to_float(n)
    return #{
        "label": label,
        "n_steps": n,
        "min_emit_interval": min_emit_interval,
        "varying_noise": varying_noise,
        "emission_count": emission_count,
        "emit_rate": to_float(emission_count) / nf,
        "motivation_mean": sum_m / nf,
        "motivation_std": _std(motivation_trace, n),
        "psi_dir_mean": sum_p / nf,
        "psi_dir_std": _std(psi_dir_trace, n),
        "tension_mean": sum_t / nf,
        "tension_std": _std(tension_trace, n)
    }
}

// ─── 6-anchor routing probe (synthetic, structural) ──────────────────
//
// .py: forward [anima 우주뇌지도] 🛸<tier> prefix → top-1 byte / Ψ_dir.
// Without forward we generate a structural probe per anchor: top-1 byte
// is byte-grep over a deterministic "anima carving template" string for
// each anchor — exercises the harness's top-1 selection logic.
fn fire_3_anchor_routing(seed: int) {
    let names = anchor_names()
    let tiers = anchor_tiers()
    let mut results = []
    let mut s = if seed > 0 { seed } else { 1 }
    let mut i = 0
    while i < len(tiers) {
        let tier = tiers[i]
        let name = names[i]
        let probe = _synthetic_probe(s)
        s = probe[3]
        // synthetic top-1 byte: deterministic function of tier (mirrors
        // .py's prefix bytes feed). For tier 0-127, ascii; otherwise '?'.
        let top1 = (tier * 7 + 32) % 128
        let top1c = if top1 >= 32 && top1 < 127 {
            // hexa has chr() builtin for byte → 1-char str
            chr(top1)
        } else {
            "?"
        }
        results = results + [#{
            "anchor": name,
            "tier": tier,
            "top1_byte": top1,
            "top1_char": top1c,
            "psi_dir": probe[0]
        }]
        i = i + 1
    }
    return results
}

// ─── result-JSON emission (without alloc/json — direct hand-build) ───

fn _quote(s: str) -> str {
    let mut out = "\""
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "\"" { out = out + "\\\"" }
        else if c == "\\" { out = out + "\\\\" }
        else if c == "\n" { out = out + "\\n" }
        else { out = out + c }
        i = i + 1
    }
    return out + "\""
}

fn _cell_to_json(c) -> str {
    return "{\"label\": " + _quote(c["label"]) + ", \"n_steps\": " + to_string(c["n_steps"])
        + ", \"min_emit_interval\": " + to_string(c["min_emit_interval"])
        + ", \"varying_noise\": " + to_string(c["varying_noise"])
        + ", \"emission_count\": " + to_string(c["emission_count"])
        + ", \"emit_rate\": " + to_string(c["emit_rate"])
        + ", \"motivation_mean\": " + to_string(c["motivation_mean"])
        + ", \"motivation_std\": " + to_string(c["motivation_std"])
        + ", \"psi_dir_mean\": " + to_string(c["psi_dir_mean"])
        + ", \"psi_dir_std\": " + to_string(c["psi_dir_std"])
        + ", \"tension_mean\": " + to_string(c["tension_mean"])
        + ", \"tension_std\": " + to_string(c["tension_std"]) + "}"
}

fn _anchor_to_json(a) -> str {
    return "{\"anchor\": " + _quote(a["anchor"]) + ", \"tier\": " + to_string(a["tier"])
        + ", \"top1_byte\": " + to_string(a["top1_byte"])
        + ", \"top1_char\": " + _quote(a["top1_char"])
        + ", \"psi_dir\": " + to_string(a["psi_dir"]) + "}"
}

// ─── argv helper ─────────────────────────────────────────────────────

fn _arg_after(av: [str], flag: str) -> str {
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == flag { return av[i + 1] }
        i = i + 1
    }
    return ""
}

// ─── main ────────────────────────────────────────────────────────────

fn main() {
    let av = argv()
    let mut seed = 1337
    let mut out_path = ""
    let seed_str = _arg_after(av, "--seed")
    if len(seed_str) > 0 { seed = to_int(seed_str) }
    out_path = _arg_after(av, "--out")
    if len(out_path) == 0 {
        out_path = "/tmp/s174_eval_result.json"
    }
    let ckpt_path = _arg_after(av, "--ckpt")
    let synthetic_off = _arg_after(av, "--synthetic-off")
    let is_synthetic_off = len(synthetic_off) > 0

    println("[s174-eval] seed=" + to_string(seed) + " out=" + out_path)
    if len(ckpt_path) > 0 {
        println("[s174-eval] ckpt=" + ckpt_path + " (HONEST STUB: forward path lives in conscious_decoder.hexa; this .hexa runs synthetic probe — see header carve-out)")
    }

    // B-S174-EVAL-OFF connection-point: --synthetic-off ⇒ inert harness
    if is_synthetic_off {
        let inert = "{\"verdict\": \"INERT\", \"note\": \"--synthetic-off: harness ran no probe, output is byte-equivalent to a NOP. Connection-point B-S174-EVAL-OFF closed.\"}\n"
        write_file(out_path, inert)
        println("[s174-eval] synthetic OFF → INERT verdict written to " + out_path)
        exit(0)
    }

    // 4-cell grid: {RL ∈ [30.0, 0.667]} × {varying_noise ∈ [false, true]}
    let c1 = run_phase_b(seed, 30.0, false, "s167a_baseline (RL=30.0, ctx=fixed)")
    println("[s174-eval] cell-1 emit=" + to_string(c1["emission_count"]) + "/" + to_string(c1["n_steps"]))
    let c2 = run_phase_b(seed, 0.667, false, "s169_rate_lift (RL=0.667, ctx=fixed)")
    println("[s174-eval] cell-2 emit=" + to_string(c2["emission_count"]) + "/" + to_string(c2["n_steps"]))
    let c3 = run_phase_b(seed, 30.0, true, "s170_var_ctx (RL=30.0, ctx=varying)")
    println("[s174-eval] cell-3 emit=" + to_string(c3["emission_count"]) + "/" + to_string(c3["n_steps"]))
    let c4 = run_phase_b(seed, 0.667, true, "s170_both (RL=0.667, ctx=varying)")
    println("[s174-eval] cell-4 emit=" + to_string(c4["emission_count"]) + "/" + to_string(c4["n_steps"]))

    // Fire 3: 6-anchor probe
    let ar = fire_3_anchor_routing(seed)

    // Build result JSON manually
    let cells_json = "[" + _cell_to_json(c1) + ", " + _cell_to_json(c2) + ", " + _cell_to_json(c3) + ", " + _cell_to_json(c4) + "]"
    let mut anchors_json = "["
    let mut ai = 0
    while ai < len(ar) {
        if ai > 0 { anchors_json = anchors_json + ", " }
        anchors_json = anchors_json + _anchor_to_json(ar[ai])
        ai = ai + 1
    }
    anchors_json = anchors_json + "]"

    let result_json = "{\n"
        + "  \"probe\": \"§174 SCALE-V-SPONT 4-cell hexa harness (synthetic probe; conscious_decoder.hexa stub)\",\n"
        + "  \"n_steps_per_cell\": " + to_string(n_max_steps()) + ",\n"
        + "  \"fire_1_2_4cell_grid\": " + cells_json + ",\n"
        + "  \"fire_3_anchor_routing\": " + anchors_json + ",\n"
        + "  \"honest_carve_out\": \"Synthetic LCG-driven Ψ/tension probe (NOT model.forward). Harness LOGIC byte-equivalent to .py; capability measurement = future cycle after conscious_decoder.hexa full all-farr inference (chat_lib precedent) lands. dispatch_s174.hexa runs the .py path on pod for the actual §174 verdict.\"\n"
        + "}\n"
    write_file(out_path, result_json)
    println("[s174-eval] DONE → " + out_path)
    println("[s174-eval] 4-cell summary: " + to_string(c1["emit_rate"]) + " " + to_string(c2["emit_rate"]) + " " + to_string(c3["emit_rate"]) + " " + to_string(c4["emit_rate"]))
}
