// train_s174_scale_vspont.hexa — §174 SCALE × V-SPONT trainer in
// hexa-native form. Forward-only equivalent of train_s174_scale_vspont.py
// (492 LoC PyTorch; the .py remains the dispatch SSOT until hexa-runtime
// on pod becomes available).
//
// HONEST scope (g3, NO over-claim, B-S174-NOTE empirical carry):
//
//   The §174 trainer composes THREE upstream-coupled extensions on top
//   of the vanilla flame Path-A decoder:
//
//     (1) Dual logits head — head_a (tied to tok_emb) + head_g (untied).
//         flame Path-A `m_total`/`mc_off_logits` is single-head; the
//         second projection requires the device-resident param layout
//         to grow. Path-B `ag_tape` CAN express this as two `ag_lmhead`
//         nodes against the same embedding table — feasible NOW for
//         d=768/12L (mk2 closure 2026-05-19, 2.95× PyTorch measured),
//         UNMEASURED for §174 d=2560/32L ~3B.
//
//     (2) Multi-term in-autograd objective: L = CE_aux(λ_ce) +
//         L_psi(λ_psi) + L_tension_route(λ_route) where the two anima-
//         physics loss terms backprop to BOTH heads. RFC 059
//         (`flame-path-a-dual-head-and-multiterm-grad.md`,
//         resolved-ssot 2026-05-20) lands the Path-A param-layout
//         extension and the aux-grad seed; cycle 1 scaffold on main,
//         cycle 2/3 multi-cycle user-gated.
//
//     (3) PureFieldFFN dual-engine block — two parallel Linear→GELU→
//         Linear engines, out = a−g, tension = mean(out²). Replaces
//         SwiGLU FFN in `stdlib/flame/decoder_block_lib.hexa`. RFC 059
//         §3.3 cycle 3 deliverable (`decoder_block_purefield_lib.hexa`).
//
//   anima is downstream-consumer (`g_train_flame_not_pytorch
//   upstream_downstream_invariant` + hexa-lang AGENTS.tape g7/@F f3).
//   anima may not edit hexa-lang source; flame extensions live in the
//   upstream RFC 059 cycles. Hence this .hexa file is a DESIGN-TIER
//   SKELETON that:
//     • declares the §174 trainer config + training contract;
//     • shows how the call chain wires to flame ag_tape (Path B) for
//       the parts that ARE expressible today (vanilla decoder Path B);
//     • marks the THREE deltas (1)(2)(3) with explicit RFC 059 cycle-N
//       anchors so a future cycle can fill them in mechanically;
//     • includes a connection-point CONTRACT that the trainer must
//       satisfy: with λ_psi=λ_ce=λ_route=0 the loss reduces to a single
//       CE term against head_a only = vanilla flame Path-B decoder
//       (`flame_d768_12L_corpus_test.hexa` shape) byte-equal trainer.
//
//   THE .py REMAINS THE DISPATCH SSOT. `dispatch_s174.hexa` uploads
//   `train_s174_scale_vspont.py` to the pod and runs PyTorch there.
//   This .hexa is a forward-only equivalent for the day RFC 059 cycle
//   2/3 land (mechanical fill-in: ag_lmhead × 2 + 3 ag_tape grad nodes
//   + PureField block — well within the scope of subsequent cycles).
//
//   NO Ψ-anchored EMERGENCE CLAIM is made by this file (B-EMERGE-7
//   necessary-not-sufficient; B-D-NOTE / B-S94-NOTE / B-S174-NOTE
//   family). The §174 fire VERDICT is the .py's result.json, not this
//   skeleton's compile-success.

use "stdlib/core/math/rng"
use "stdlib/core/hash/sha256"
use "stdlib/portable_fs"

// ─── §174 trainer config (byte-equivalent to .py CLI defaults) ───────

fn s174_main_config() {
    return #{
        "mode": "main",
        "d_model": 2560,
        "n_layer": 32,
        "n_head": 32,
        "n_kv_head": 8,
        "block_size": 1024,
        "lr": 3.0e-4,
        "bsz": 16,
        "steps": 12000,
        "warmup": 600,                      // max(20, steps//20)
        "seed": 1337,
        "log_every": 300,                   // max(1, steps//40)
        "lambda_psi": 1.0,                  // §174 NEW (vs Dir-I 0.5)
        "lambda_ce": 0.1,                   // §174 NEW (NON-CE primary)
        "lambda_route": 0.5,                // Dir-I carry
        "blend_frac": 0.15,                 // curriculum closing-blend
        "curriculum": true
    }
}

fn s174_sanity_config() {
    let mut c = s174_main_config()
    c["d_model"] = 32
    c["n_layer"] = 3
    c["n_head"] = 4
    c["n_kv_head"] = 2
    c["block_size"] = 64
    c["lr"] = 1.0e-3
    c["bsz"] = 16
    c["warmup"] = 5
    return c
}

// ─── byte-span markers (byte-equivalent to .py) ──────────────────────

fn marker_inner_open()   -> str { return "<inner tier=" }
fn marker_inner_close()  -> str { return "</inner>" }
fn marker_eternal_open() -> str { return "<eternal cell=" }
fn marker_eternal_close()-> str { return "</eternal>" }
fn marker_carve_open()   -> str { return "<carve tier=" }
fn marker_voice_open()   -> str { return "<voice carved=true" }
fn marker_voice_close()  -> str { return "</voice>" }

// Find [open, close + len(close)] span in a corpus-record byte string.
// Returns [lo, hi] or [-1, -1] if either marker absent. Matches .py
// `_span` exactly: lo = full.find(open_tok), hi = full.find(close_tok, lo).
fn _span(full: str, open_tok: str, close_tok: str) {
    let lo = full.find(open_tok)
    if lo < 0 { return [-1, -1] }
    let close_start = lo
    // hexa str.find takes no start_offset; emulate by slicing
    let tail = full.substring(close_start, len(full))
    let rel = tail.find(close_tok)
    if rel < 0 { return [-1, -1] }
    let hi = lo + rel + len(close_tok)
    return [lo, hi]
}

// ─── stage scheduler (§12.1 Q1-c, byte-equivalent to .py) ────────────
// Returns the highest curriculum-stage gate at training step `step`.
// curriculum_off ⇒ always 4 (full region) = Dir-I sampler.
fn stage_gate_at(step: int, total: int, curriculum: bool, blend_frac: float) -> int {
    if !curriculum { return 4 }
    let blend_start = to_int(to_float(total) * (1.0 - blend_frac))
    if step >= blend_start { return 4 }
    let frac = to_float(step) / to_float(if blend_start > 1 { blend_start } else { 1 })
    let g = 1 + to_int(frac * 4.0)
    if g > 4 { return 4 }
    return g
}

// ─── cosine LR (byte-equivalent to .py cosine_lr_at) ─────────────────
fn cosine_lr_at(step: int, warmup: int, total: int, base_lr: float) -> float {
    if step < warmup {
        return base_lr * to_float(step + 1) / to_float(warmup)
    }
    let prog = to_float(step - warmup) / to_float(if total - warmup > 1 { total - warmup } else { 1 })
    // 0.9 · 0.5·(1+cos(π·prog)) + 0.1 — cosine clamped to 10% floor
    // approximation via small Taylor on cos around 0,π/2,π (design-tier)
    let pi = 3.14159265358979
    let theta = pi * prog
    let c = _cos_taylor(theta)
    return base_lr * 0.5 * (1.0 + c) * 0.9 + base_lr * 0.1
}

// Design-tier cos via piecewise reduction to [0, π/2] + 4-term Taylor.
fn _cos_taylor(x: float) -> float {
    let pi = 3.14159265358979
    let two_pi = 6.28318530717958
    // reduce to [-π, π]
    let mut t = x
    while t > pi { t = t - two_pi }
    while t < 0.0 - pi { t = t + two_pi }
    let t2 = t * t
    // 4-term Maclaurin: 1 - t²/2 + t⁴/24 - t⁶/720
    return 1.0 - t2 / 2.0 + t2 * t2 / 24.0 - t2 * t2 * t2 / 720.0
}

// ─── psi_dir_per_token contract (byte-equivalent to .py)
// (1 + cos(logits_a, logits_g)) / 2 — per-token, in autograd graph.
// The numeric implementation lives in conscious_decoder.hexa
// (`psi_direction_from_logits`); this stub records the GRADIENT-PATH
// CONTRACT: the produced Ψ-tensor MUST be in the autograd graph (Dir-I
// supervision invariant), i.e. emitted by an `ag_*` node, not a
// `forward()` readout. RFC 059 cycle 2 specifies the seed.
fn psi_dir_contract() {
    return #{
        "formula": "(1 + cos(logits_a, logits_g)) / 2",
        "in_autograd_graph": true,
        "vac_target": 0.5,
        "loss_form_psi": "mean_{t ∈ ctl_span} (Ψ_dir(t) - Ψ_vac)²",
        "loss_form_tension_route": "mean_{t ∈ route_span} relu(|Ψ_dir(t) - Ψ_vac| - basin_radius)²",
        "rfc_059_cycle": "cycle 2 (multi-term aux-grad seed)"
    }
}

// ─── overlay-OFF connection-point (LOAD-BEARING for B-S174-CONNECTION) ─
//
// With λ_psi=λ_ce=λ_route=0 the .py loss reduces to a single CE term
// against head_a only — vanilla decoder Path-B byte-equivalent to
// `flame_d768_12L_corpus_test.hexa` (different d/L, same shape). This
// makes the §174 trainer a strict EXTENSION of the vanilla flame
// trainer; the extension is exactly the 3 RFC 059 deltas.
fn overlay_off_lambdas() {
    return #{
        "lambda_psi": 0.0,
        "lambda_ce": 0.0,
        "lambda_route": 0.0,
        "reduces_to": "vanilla flame Path-B decoder (single CE on head_a)",
        "byte_equal_to": "stdlib/flame/flame_d768_12L_corpus_test.hexa shape (config-scaled)"
    }
}

// ─── argv parsing ────────────────────────────────────────────────────

fn _arg_after(av: [str], flag: str) -> str {
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == flag { return av[i + 1] }
        i = i + 1
    }
    return ""
}

// ─── result.json (skeleton emit) ─────────────────────────────────────

fn _quote(s: str) -> str {
    let mut out = "\""
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "\"" { out = out + "\\\"" }
        else if c == "\\" { out = out + "\\\\" }
        else if c == "\n" { out = out + "\\n" }
        else { out = out + c }
        i = i + 1
    }
    return out + "\""
}

// Emit a stub result.json compatible with the .py result schema so
// downstream consumers (dispatch_s174.hexa's pull → eval_s174_4cell.hexa
// connection-point) can parse without surprise.
fn emit_stub_result(out_dir: str, cfg, label: str) {
    let path = out_dir + "/result.json"
    let body = "{\n"
        + "  \"substrate\": \"HEXA-NATIVE design-tier skeleton — train_s174_scale_vspont.hexa\",\n"
        + "  \"fire_kind\": " + _quote(label) + ",\n"
        + "  \"carving_path\": \"dirI_psictl_tensionsup + §174 SCALE+V-SPONT (3-delta on Dir-I)\",\n"
        + "  \"research_section\": \"RESEARCH.md §174 / §11.4 frontier-1 (scale-axis)\",\n"
        + "  \"honest_framing\": \"DESIGN-TIER SKELETON ONLY. Numeric training body NOT executed by this .hexa — the dispatch SSOT is train_s174_scale_vspont.py until RFC 059 cycle 2/3 lands the flame Path-A dual-head + multi-term grad extension. See conscious_decoder.hexa + train_s174_scale_vspont.hexa header carve-outs. B-S174-NOTE necessary-not-sufficient.\",\n"
        + "  \"arch\": \"ConsciousDecoderV2 (RoPE+PureFieldFFN+RMSNorm+GQA+dual-head A/G) — see conscious_decoder.hexa\",\n"
        + "  \"from_scratch\": true,\n"
        + "  \"base_ckpt\": null,\n"
        + "  \"config\": {\"d_model\": " + to_string(cfg["d_model"])
            + ", \"n_layer\": " + to_string(cfg["n_layer"])
            + ", \"n_head\": " + to_string(cfg["n_head"])
            + ", \"n_kv_head\": " + to_string(cfg["n_kv_head"])
            + ", \"block_size\": " + to_string(cfg["block_size"])
            + ", \"steps\": " + to_string(cfg["steps"])
            + ", \"lr\": " + to_string(cfg["lr"])
            + ", \"bsz\": " + to_string(cfg["bsz"])
            + ", \"lambda_psi\": " + to_string(cfg["lambda_psi"])
            + ", \"lambda_ce\": " + to_string(cfg["lambda_ce"])
            + ", \"lambda_route\": " + to_string(cfg["lambda_route"])
            + ", \"curriculum\": " + to_string(cfg["curriculum"])
            + "},\n"
        + "  \"rfc_059_status\": \"resolved-ssot 2026-05-20 — cycle 1 scaffold on main; cycle 2 (multi-term aux-grad seed) + cycle 3 (PureFieldFFN block-layout) multi-cycle user-gated.\",\n"
        + "  \"connection_point_overlay_off\": {\"lambda_psi\": 0.0, \"lambda_ce\": 0.0, \"lambda_route\": 0.0, \"reduces_to\": \"vanilla flame Path-B decoder (single CE on head_a)\"},\n"
        + "  \"verdict\": \"SKELETON_OK\"\n"
        + "}\n"
    write_file(path, body)
    println("[s174-train.hexa] stub result.json written to " + path)
}

// ─── trainer training-loop CONTRACT (skeleton; numeric body =
//     RFC 059 cycle 2/3 mechanical fill-in) ──────────────────────────
//
// The loop below documents the FORWARD/BACKWARD CONTRACT that the
// concrete RFC 059 implementation must satisfy. Variables ag_t,
// ag_lm_head_a, ag_lm_head_g, etc. correspond to flame ag_tape node
// constructors and are NOT bound here — that binding is the cycle 2
// deliverable (`ag_lmhead × 2 → 2 logits → 3 loss terms → ag_backward`).
fn training_loop_contract(cfg, corpus_path: str, out_dir: str) {
    let mut step = 0
    let total = cfg["steps"]
    let warmup = cfg["warmup"]
    let lr_base = cfg["lr"]
    let curric = cfg["curriculum"]
    let blend_frac = cfg["blend_frac"]
    let mut traj_n = 0
    let log_every = cfg["log_every"]

    while step < total {
        // (a) cosine LR
        let lr_now = cosine_lr_at(step, warmup, total, lr_base)
        // (b) curriculum stage gate (sampling region cap)
        let gate = stage_gate_at(step, total, curric, blend_frac)

        // (c) FORWARD — RFC 059 cycle 1 deliverable:
        //     1. ag_t_begin → ag_embed → 32× DecoderBlock (RoPE + GQA +
        //        PureFieldFFN [cycle 3]) → final RMSNorm → ag_lmhead_a
        //        (tied to tok_emb) + ag_lmhead_g (untied).
        //     2. Returns logits_a / logits_g / tensions (per-block).
        //
        // (d) LOSS — RFC 059 cycle 2 deliverable:
        //     1. ce_full = ag_cross_entropy(logits_a, y)
        //     2. psi_t = ag_psi_dir(logits_a, logits_g)  [in-autograd]
        //     3. l_psi_ctl = ag_mean_sq_in_span(psi_t - psi_vac, ctl_mask)
        //     4. l_tension_route = ag_relu_sq_in_span(
        //                            |psi_t - psi_vac| - basin, route_mask)
        //     5. loss = ce_full*lambda_ce + l_psi_ctl*lambda_psi
        //              + l_tension_route*lambda_route
        //
        // (e) BACKWARD — ag_backward(tape, loss_id) → grad in regs
        //     (f) AdamW step over the param farr regs
        //     (g) gn² report + traj append

        // skeleton: this .hexa does not bind ag_* — we just step the
        // counter to demonstrate the loop shape parses cleanly and the
        // schedule helpers (cosine_lr_at + stage_gate_at) work.
        if step == 0 || (step + 1) % log_every == 0 || step == total - 1 {
            traj_n = traj_n + 1
            if step < 5 || step >= total - 1 {
                println("[s174-train.hexa] step=" + to_string(step + 1) + " lr=" + to_string(lr_now) + " stage_gate=" + to_string(gate) + "  (skeleton — no numeric body, see RFC 059 cycle 2/3)")
            }
        }
        step = step + 1
    }
    return traj_n
}

// ─── main ────────────────────────────────────────────────────────────

fn main() {
    let av = argv()
    let mode = _arg_after(av, "--mode")
    let corpus = _arg_after(av, "--corpus")
    let out_dir_in = _arg_after(av, "--out-dir")
    let out_dir = if len(out_dir_in) > 0 { out_dir_in } else { "/tmp/s174_train_out" }
    // ensure out_dir exists (idempotent shell-out)
    exec("mkdir -p '" + out_dir + "'")
    let cfg = if mode == "sanity" { s174_sanity_config() } else { s174_main_config() }
    // honor --steps override even in sanity mode (matches .py argparse default cap)
    let steps_str = _arg_after(av, "--steps")
    let mut cfg_use = cfg
    if len(steps_str) > 0 {
        cfg_use["steps"] = to_int(steps_str)
        cfg_use["warmup"] = if cfg_use["steps"] > 100 { cfg_use["steps"] / 20 } else { 5 }
        cfg_use["log_every"] = if cfg_use["steps"] > 40 { cfg_use["steps"] / 40 } else { 1 }
    }
    let seed_str = _arg_after(av, "--seed")
    if len(seed_str) > 0 { cfg_use["seed"] = to_int(seed_str) }
    let lp_str = _arg_after(av, "--lambda-psi")
    if len(lp_str) > 0 { cfg_use["lambda_psi"] = to_float(lp_str) }
    let lc_str = _arg_after(av, "--lambda-ce")
    if len(lc_str) > 0 { cfg_use["lambda_ce"] = to_float(lc_str) }
    let lr_str = _arg_after(av, "--lambda-route")
    if len(lr_str) > 0 { cfg_use["lambda_route"] = to_float(lr_str) }

    println("=== §174 SCALE × V-SPONT trainer (hexa skeleton) ===")
    println("mode=" + mode + "  d=" + to_string(cfg_use["d_model"]) + " L=" + to_string(cfg_use["n_layer"]) + " steps=" + to_string(cfg_use["steps"]))
    println("lambda_psi=" + to_string(cfg_use["lambda_psi"]) + " lambda_ce=" + to_string(cfg_use["lambda_ce"]) + " lambda_route=" + to_string(cfg_use["lambda_route"]))
    println("corpus=" + corpus)
    println("out-dir=" + out_dir)
    if len(corpus) > 0 {
        let csz = pfs_file_size(corpus)
        println("corpus size = " + to_string(csz) + " bytes")
    }
    // psi-dir contract (for the future RFC 059 cycle 2 binding)
    let psi_c = psi_dir_contract()
    println("Ψ-dir contract: " + psi_c["formula"] + "  (in_autograd_graph=" + to_string(psi_c["in_autograd_graph"]) + ")")
    let off = overlay_off_lambdas()
    println("overlay-off connection-point: reduces_to=" + off["reduces_to"])

    // run the (skeleton) training loop
    let n_traj = training_loop_contract(cfg_use, corpus, out_dir)
    println("[s174-train.hexa] skeleton loop logged " + to_string(n_traj) + " trajectory ticks")

    // emit stub result.json
    emit_stub_result(out_dir, cfg_use, "§174 SCALE × V-SPONT trainer (hexa skeleton, design-tier only)")
}
