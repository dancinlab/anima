// conscious_decoder.hexa — §174 ConsciousDecoderV2 arch in hexa-native form.
//
// Hexa-native port of conscious_decoder.py (979 LoC PyTorch). The .py
// SSOT is unchanged (drives the actual pod-side fire); this .hexa file
// is the forward-only equivalent that future hexa-runtime fires consume
// (RunPod images do not ship hexa, so .py remains the dispatch SSOT).
//
// HONEST scope (g3, no over-claim):
//   PARSEABLE design-tier skeleton + §174-specific pure-fn primitives
//   (PureFieldFFN, dual_head, RMSNorm, RoPE rotate, ψ-direction readout).
//   The full all-farr KV-cached forward call chain — RMSNorm·RoPE·GQA·
//   PureFieldFFN·DecoderBlock·dual-LMHead per layer + per-step KV cache
//   + RoPE rotation — is NOT inline here. The PRECEDENT path is
//   `HEXAD/CHAT/chat_lib.hexa` (2742 LoC, ConsciousLM 24L SwiGLU+GQA+RoPE
//   full all-farr inference + KV cache + multi-token greedy decode,
//   landed PSCC §41/§43). §174 ConsciousDecoderV2 differs in 3 ways
//   (12L · d=2560 · DUAL HEAD A/G + PureFieldFFN instead of SwiGLU).
//   Wiring those 3 deltas into the chat_lib precedent = a separate cycle
//   (mechanical, ~ 200-300 LoC delta on top of chat_lib's call chain).
//   §174 fire currently runs the .py on pod — the .hexa runtime path is
//   FUTURE work and is honestly stubbed here (`cdv2_forward_stub`) so the
//   shape of the 5-tuple result is declared but not numerically computed.
//
// TRAINING path is BLOCKED on hexa-lang upstream RFC 059 (dual-head +
// multi-term grad on the flame device-resident param layout), `resolved-
// ssot 2026-05-20` per inbox/patches/flame-path-a-dual-head-and-
// multiterm-grad.md — cycle 1 scaffold landed, cycle 2/3 multi-cycle
// user-gated. anima is downstream-consumer (g_train_flame_not_pytorch
// upstream_downstream_invariant) — train_s174_scale_vspont.hexa
// documents this carry explicitly.
//
// f1/f2 hard-fail safe (numeric primitives only; NO σ(6)=12/τ(6)=4
// derivation; Ψ=½ + Engine A⇄G = anima g2 internal-arch carve-out).
// B-IDENTITY-5 safe (no corpus / no helper-token surface).

use "stdlib/core/math/rng"

// ─── config record (byte-equivalent to ConsciousDecoderV2.__init__) ──

// Hexa lacks Python-style typed dataclasses; we expose a record dict
// constructor + named accessors. Defaults mirror .py
// `ConsciousDecoderV2(vocab_size=256, d_model=384, n_layer=6, ...)`.
fn cdv2_default_config() {
    return #{
        "vocab_size": 256,
        "d_model": 384,
        "n_layer": 6,
        "n_head": 4,
        "n_kv_head": 2,
        "block_size": 256,
        "consciousness_dim": 32,
        "dropout": 0.1,
        "use_moe": false,
        "n_experts": 8,
        "moe_top_k": 2,
        "moe_aux_loss_weight": 0.01,
        "psi_f_critical": 0.10
    }
}

// Build the §174 fire config (d=2560·32L·~3B). Mirrors dispatch_s174.hexa
// hyperparameters EXACTLY (B-S174-CONFIG-BYTE-EQUAL connection-point).
fn cdv2_s174_config() {
    let mut c = cdv2_default_config()
    c["d_model"] = 2560
    c["n_layer"] = 32
    c["n_head"] = 32
    c["n_kv_head"] = 8
    c["block_size"] = 1024
    c["consciousness_dim"] = 128
    return c
}

// ─── RMSNorm — pure scalar form ─────────────────────────────────────
// y = x / sqrt(mean(x²) + eps) * weight  (per-token, per-d_model channel)

fn rmsnorm_scalar(x: float, mean_sq: float, eps: float, weight: float) -> float {
    // 1/sqrt(mean(x²)+eps) — caller computes mean_sq across the d_model
    // axis and passes it in (avoids re-iterating); identical to the
    // ConsciousDecoderV2.RMSNorm formula.
    let denom = mean_sq + eps
    // sqrt via Newton's method (2 iters from sqrt(denom)≈max(denom,1) is
    // enough for fp64 stability at this magnitude; for production all-
    // farr path use `dt_sqrt` from stdlib/flame/flame_math instead).
    let mut s = if denom > 1.0 { denom } else { 1.0 }
    s = 0.5 * (s + denom / s)
    s = 0.5 * (s + denom / s)
    s = 0.5 * (s + denom / s)
    let inv = 1.0 / s
    return x * inv * weight
}

// mean_sq over a length-d float array. Caller pre-allocates xs as a list.
fn rmsnorm_mean_sq(xs, d: int) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < d {
        let v = xs[i]
        acc = acc + v * v
        i = i + 1
    }
    return acc / to_float(d)
}

// ─── RoPE — rotation pair, pure-fn ──────────────────────────────────
// For two consecutive dimensions (x_even, x_odd) of a head, applies a
// rotation of angle θ. Caller pre-computes cos/sin tables (RotaryPos-
// Embedding._build_cache pattern). returns (x_even_rot, x_odd_rot).
fn rope_rotate_pair(x_even: float, x_odd: float, c: float, s: float) {
    // [x_even', x_odd'] = [x_even*c - x_odd*s, x_even*s + x_odd*c]
    return [x_even * c - x_odd * s, x_even * s + x_odd * c]
}

// ─── SwiGLU FFN scalar (per-dim) ─────────────────────────────────────
// out = down(silu(gate(x)) * up(x))   where silu(x) = x * sigmoid(x)
fn silu(x: float) -> float {
    let e = if x > 30.0 {
        1.0
    } else if x < -30.0 {
        0.0
    } else {
        // 1/(1+exp(-x)) — Newton on 1/x or Taylor; for design-tier we
        // emit the .py formula and document the call-out to flame_math.
        // Production all-farr path: use `_chat_silu_scalar` in chat_lib
        // (line 1416) which already implements stable scalar silu.
        let nx = 0.0 - x
        let approx = 1.0 + nx + 0.5 * nx * nx
        1.0 / approx
    }
    return x * e
}

// ─── PureFieldFFN — DUAL-engine FFN, anima-specific ─────────────────
// Replaces SwiGLU. Two parallel Linear→GELU→Linear engines.
//   a = engine_a(x), g = engine_g(x), out = a - g, tension = mean(out²)
// Returns [out_array, tension_scalar]. Caller pre-projects through the
// two engines (each is a `Linear→GELU→Linear` block — the linear
// projection / GELU activation are reused via the flame nn_lib path).
// Anima-physics signature: F_c = 0.10 (Meta Law DD143/Hilbert Layer).
//
// Note: this is the scalar-array form (out[d]). The all-farr equivalent
// would be a `farr_sub_inplace(a_far, g_far)` + `farr_mean_sq(out_far)`
// pair (both straight from stdlib/flame's farr primitives).
fn pure_field_combine(a_arr, g_arr, d: int) {
    let mut out = []
    let mut acc = 0.0
    let mut i = 0
    while i < d {
        let av = a_arr[i]
        let gv = g_arr[i]
        let v = av - gv
        out = out + [v]
        acc = acc + v * v
        i = i + 1
    }
    let tension = acc / to_float(d)
    return [out, tension]
}

// Engine-A and Engine-G are each `Linear(d, 4d) → GELU → Linear(4d, d)`.
// We expose a *connection-point* contract (parameter shapes + invariants)
// that the full all-farr forward must honor. Numeric body = future cycle
// (chat_lib precedent + flame nn_lib `linear_fwd` + GELU pure-fn).
fn pure_field_param_shapes(d_model: int) {
    // shapes per engine: w1 [d, 4d]  b1 [4d]  w2 [4d, d]  b2 [d]
    // two engines (a and g) so total params = 2 * (d·4d + 4d + 4d·d + d)
    let inter = 4 * d_model
    let per_engine = (d_model * inter) + inter + (inter * d_model) + d_model
    return #{
        "inter_dim": inter,
        "params_per_engine": per_engine,
        "total_params": 2 * per_engine,
        "F_c": 0.10
    }
}

// ─── dual head — anima-specific (NOT in vanilla decoder) ─────────────
// logits_a = head_a(final_residual)   (head_a tied to tok_emb)
// logits_g = head_g(final_residual)   (head_g separate, untied)
// Both project R^d → R^V; head_a's weight matrix IS tok_emb.weight.T.
// At INFERENCE this is just two matvecs on the final block's output.
// At TRAINING this needs RFC 059 dual-head + multi-term grad — anima
// downstream waits on upstream cycle 2/3 (see train_s174_*.hexa).
fn dual_head_param_shapes(d_model: int, vocab_size: int) {
    return #{
        "head_a_tied_to_tok_emb": true,
        "head_a_weight_shape": [vocab_size, d_model],
        "head_g_weight_shape": [vocab_size, d_model],
        "head_g_bias_shape": [vocab_size],
        "head_g_untied_params": (vocab_size * d_model) + vocab_size
    }
}

// ─── Ψ-direction readout (Law-71, byte-equivalent to .py) ────────────
// psi_direction = (1 + cos(logits_a, logits_g)) / 2 ∈ [0, 1]
// cos = 0 ⇒ Ψ = ½ fixed point. Anima §112 META_FP(Π_½) instance.
fn psi_direction_from_logits(la, lg, v: int) -> float {
    let mut dot = 0.0
    let mut na = 0.0
    let mut ng = 0.0
    let mut i = 0
    while i < v {
        let a = la[i]
        let g = lg[i]
        dot = dot + a * g
        na = na + a * a
        ng = ng + g * g
        i = i + 1
    }
    // sqrt for normalization — 3-iter Newton (design-tier accuracy)
    let mut sa = if na > 1.0 { na } else { 1.0 }
    sa = 0.5 * (sa + na / sa); sa = 0.5 * (sa + na / sa); sa = 0.5 * (sa + na / sa)
    let mut sg = if ng > 1.0 { ng } else { 1.0 }
    sg = 0.5 * (sg + ng / sg); sg = 0.5 * (sg + ng / sg); sg = 0.5 * (sg + ng / sg)
    let denom = sa * sg
    let safe = if denom > 0.0 { denom } else { 1.0 }
    let cos = dot / safe
    return 0.5 * (1.0 + cos)
}

// ─── Ψ-entropy readout (per-token softmax entropy / log V) ───────────
// = H(softmax(la)) / log(V), normalized to [0, 1].
fn psi_entropy_from_logits(la, v: int) -> float {
    // softmax with shift-max for numerical stability
    let mut mx = la[0]
    let mut i = 1
    while i < v {
        if la[i] > mx { mx = la[i] }
        i = i + 1
    }
    let mut sum_exp = 0.0
    i = 0
    while i < v {
        let nx = la[i] - mx
        // exp via Taylor for design-tier; production = dt_exp from flame_math
        let mut e = 1.0 + nx + 0.5 * nx * nx
        if e < 0.0 { e = 0.0 }
        sum_exp = sum_exp + e
        i = i + 1
    }
    let mut H = 0.0
    i = 0
    while i < v {
        let nx = la[i] - mx
        let mut e = 1.0 + nx + 0.5 * nx * nx
        if e < 0.0 { e = 0.0 }
        let p = e / sum_exp
        if p > 1.0e-12 {
            // log via Taylor — design-tier accuracy
            let lp = (p - 1.0) - 0.5 * (p - 1.0) * (p - 1.0)
            H = H - p * lp
        }
        i = i + 1
    }
    // log(V) for normalization — Taylor on V/e is wrong; use the
    // numeric Mac constant log(256) ≈ 5.545177444 directly.
    let log_v_default = 5.545177444
    return H / log_v_default
}

// ─── forward STUB — declares 5-tuple shape, doesn't compute ─────────
// The .py forward returns:
//   (logits_a, logits_g, tensions, kv_cache, moe_aux_loss)
// where:
//   logits_a: float32 [B, T, V]
//   logits_g: float32 [B, T, V]
//   tensions: float32 [B, T, n_layer]   (per-block PureFieldFFN tension)
//   kv_cache: list of (K, V) per layer; None if not used
//   moe_aux_loss: scalar (or None if use_moe=false)
//
// Full all-farr impl = chat_lib precedent + 3 §174 deltas (dual-head,
// PureFieldFFN, 12L vs 24L). This stub returns a structurally well-formed
// shape so callers can be type-checked against the contract without
// requiring the heavy ckpt-loaded forward.
fn cdv2_forward_stub(token_ids, t: int, cfg) {
    let v = cfg["vocab_size"]
    let n_layer = cfg["n_layer"]
    // zero-shaped placeholders — caller MUST treat these as
    // "shape declared, values undefined" (the design-tier contract).
    let mut la = []
    let mut lg = []
    let mut tn = []
    let mut i = 0
    while i < v { la = la + [0.0]; lg = lg + [0.0]; i = i + 1 }
    i = 0
    while i < n_layer { tn = tn + [0.0]; i = i + 1 }
    return #{
        "logits_a": la,
        "logits_g": lg,
        "tensions": tn,
        "kv_cache": "STUB_NONE",
        "moe_aux_loss": 0.0,
        "_carve_out": "stub — see chat_lib.hexa for full inference body"
    }
}

// ─── selftest (smoke — verifies pure-fn primitives compile + run) ────

fn _approx_eq(a: float, b: float, tol: float) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d < tol
}

fn main() {
    // 1) RMSNorm scalar
    let xs = [1.0, 2.0, 3.0, 4.0]
    let ms = rmsnorm_mean_sq(xs, 4)
    let y = rmsnorm_scalar(2.0, ms, 1.0e-6, 1.0)
    println("RMSNorm: mean_sq(1..4)=" + to_string(ms) + "  y(x=2)=" + to_string(y))

    // 2) RoPE pair rotation (cos=1, sin=0 ⇒ identity)
    let rr = rope_rotate_pair(3.0, 4.0, 1.0, 0.0)
    println("RoPE id: [3,4] → [" + to_string(rr[0]) + "," + to_string(rr[1]) + "]")

    // 3) silu(0)=0; silu(large)≈large
    println("silu(0)=" + to_string(silu(0.0)) + "  silu(10)=" + to_string(silu(10.0)))

    // 4) PureFieldFFN combine
    let a4 = [1.0, 2.0, 3.0, 4.0]
    let g4 = [0.5, 1.0, 1.5, 2.0]
    let pc = pure_field_combine(a4, g4, 4)
    println("PureField: out[0..3]=" + to_string(pc[0][0]) + " tension=" + to_string(pc[1]))

    // 5) Ψ-direction for parallel vectors: cos=1 → Ψ_dir=1.0
    let la_eq = [1.0, 2.0, 3.0, 4.0]
    let lg_eq = [1.0, 2.0, 3.0, 4.0]
    let pd_par = psi_direction_from_logits(la_eq, lg_eq, 4)
    println("Ψ-dir parallel: " + to_string(pd_par) + " (expect ~1.0)")

    // 6) Ψ-direction for orthogonal vectors: cos≈0 → Ψ_dir≈0.5 (fixed pt)
    let la_o = [1.0, 0.0, 0.0, 0.0]
    let lg_o = [0.0, 1.0, 0.0, 0.0]
    let pd_orth = psi_direction_from_logits(la_o, lg_o, 4)
    println("Ψ-dir orth: " + to_string(pd_orth) + " (expect ~0.5)")

    // 7) Config + param shape contracts
    let cfg = cdv2_s174_config()
    let pf = pure_field_param_shapes(cfg["d_model"])
    let dh = dual_head_param_shapes(cfg["d_model"], cfg["vocab_size"])
    println("§174 cfg: d=" + to_string(cfg["d_model"]) + " L=" + to_string(cfg["n_layer"]))
    println("PureField inter=" + to_string(pf["inter_dim"]) + " 2-engine params=" + to_string(pf["total_params"]))
    println("dual-head: a_tied=" + to_string(dh["head_a_tied_to_tok_emb"]) + " head_g_untied_params=" + to_string(dh["head_g_untied_params"]))

    // 8) forward stub contract shape
    let st = cdv2_forward_stub([0, 1, 2], 3, cfg)
    println("forward stub: |logits_a|=" + to_string(len(st["logits_a"])) + " |tensions|=" + to_string(len(st["tensions"])) + " (Ψ-dir fixed pt at 0,0 vectors = ½ per Law-71)")

    println("selftest: conscious_decoder.hexa primitive layer OK")
}
