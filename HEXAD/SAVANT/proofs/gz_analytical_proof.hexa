// ════════════════════════════════════════════════════════════════════════
// HEXAD/SAVANT/proofs/gz_analytical_proof.hexa — WRAPPER entry-point
//
//   gz_analytical_proof.py constructs the Golden Zone analytical proof
//   chain (7 steps): whether a system obeying G*I = D*P necessarily
//   converges to I in [1/2 - ln(4/3), 1/2] with optimum 1/e. Each claim is
//   numerically verified and tagged PROVEN / INTERPRETIVE.
//
//   It hard-depends on scipy (scipy.optimize.minimize_scalar / minimize for
//   the I^I and I*ln(I) minimizations, the lambda-sweep, and the alternative-
//   cost-function table) plus numpy and fractions.Fraction for exact divisor
//   arithmetic. The bounded-scalar optimizer is the load-bearing primitive —
//   hexa-lang has no scipy.optimize equivalent, so a faithful pure-hexa port
//   is infeasible.
//
//   The .py is KEPT as the proof-chain SSOT; this thin .hexa documents
//   purpose and dispatches it via exec().
//
//   USAGE  hexa run gz_analytical_proof.hexa   # prints the full proof chain
// ════════════════════════════════════════════════════════════════════════

fn main() {
    let here = "/Users/ghost/core/anima/HEXAD/SAVANT/proofs"
    let py = here + "/gz_analytical_proof.py"
    let exists = exec("[ -f '" + py + "' ] && printf yes || printf no")
    if exists != "yes" {
        println("gz_analytical_proof.py not found at: " + py)
        return
    }
    println("[gz_analytical_proof] dispatch → python3 gz_analytical_proof.py")
    print(exec("cd '" + here + "' && python3 gz_analytical_proof.py"))
}
