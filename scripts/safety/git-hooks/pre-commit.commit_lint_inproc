#!/bin/sh
# hive safety gate — pre-commit shim (commit_lint in-process backend)
#
# Sibling to scripts/safety/git-hooks/pre-commit (staged-scan.sh delegation).
# Land 2026-05-02 by BG-CL — opt-in only; existing pre-commit is preserved.
#
# To enable in this clone:
#   ln -sf pre-commit.commit_lint_inproc \
#          .git/hooks/pre-commit
# (or update core.hooksPath dispatcher to prefer this filename)
#
# Behaviour:
#   - PASS: exit 0 (commit proceeds)
#   - FAIL: exit 1 (commit aborted; reasons printed to stderr)
#   - Hexa runtime missing: exit 1 with diagnostic
#
# Bypass:
#   HIVE_<MODULE>_DISABLE='<reason>'   per-module skip (audited inside module)
#   HIVE_COMMIT_LINT_MODE=warn         all-modules → warn (advisory; exit 0)
#   HIVE_SAFETY_ALLOW='<reason>'       legacy bypass (still honored by
#                                       scripts/safety/staged-scan.sh, which
#                                       is preserved for back-compat)
exec "$HOME/.hx/bin/hexa" run \
    "$(git rev-parse --show-toplevel)/hive/core/commit_lint/commit_lint_main.hexa" \
    staged
