  @> CLAUDE.md

@D g_hf_naming := "HF naming — dancinlab/hexad (model) + dancinlab/hexad-corpus (dataset) BOTH LANDED canonical + cycle 5 DD155 hybrid LR LANDED (HEXAD pivot, 2026-05-17)" :: governance [required d=2026-05-17 active]
