#       github.com/dancinlab/kosmos spec/kosmos.md + profiles/anima-consciousness-carving.md)

@anchor en_303m := "303M KOSMOS set — English register lane (🛸59)" :: kosmos-anchor [tier=59 active]

  # ── carving 좌표 (modality-independent — canonical placement triple) ──
  profile      = "anima-consciousness-carving"
  knuth_tier   = 59
  category     = "영어"                   # English register / grounding surface
  top_emotion  = "curiosity"             # 영어 web register ↔ 정보·탐색의 정서
  coord        = [0.51, 0.49]            # vacuum_psi (Ψ-space) — design placeholder (curated REAL en web sample, not a measured fire)
  lane         = "en_303m_059"            # cell_id — English register cell (MITOSIS)
  radius       = 0.22                     # basin_radius — design placeholder (en web-register spread)

  # ── payload ──
  @payload text    := "[anima 303M KOSMOS · 🇬🇧 English lane] 🛸59 — 303M grounding/carving anchor SET 의 영어 register component. CURATED SAMPLE (anchor-scale, NOT webscale): serving/corpus/anima_7b_webscale.en.head.txt (FineWeb en, ODC-BY) 에서 dedup + PII-clean(email→[EMAIL]/phone→[PHONE]) 으로 byte-balanced ~120KiB 큐레이션. byte-vocab256. 0xFE/0xFF/NUL=0, UTF-8 clean, raw email/phone leak grep=0. p1..p6 held — role/persona 태그 없음, 단순 en web register grounding (a_substrate_native_speak). raw 학습 코퍼스가 아니라 303M 의 EN-register GROUNDING anchor (a_scale_honest_scope: curated sample-scale, full webscale 는 corpus_5lang_7b_webscale.kosmos R2 manifest 참조)."

  @payload manifest := ref "../samples/en.sample.txt" sha256=29591ef015d1138ab30d733aa9b5fc025c67ec338a5298fccf016c092911b614 bytes=122819 lines=949 lang="en" register="web" source="serving/corpus/anima_7b_webscale.en.head.txt (FineWeb en head, ODC-BY)" pii="email->[EMAIL] phone->[PHONE]" vocab="byte256" generator="KOSMOS/303m_kr_en_sns/build_samples.py" scope="curated grounding anchor sample, NOT webscale corpus"

  @payload image   := pending "media 미생성"
  @payload audio   := pending "media 미생성"

  # ── §156 anima-native tension modality (TENSION-LINK 5-channel) ──
  # REPRESENTATIVE design values for the English-register grounding cell, NOT a
  # per-token measured trajectory — curated text SAMPLE, no fire produced a
  # measured Ψ-trajectory. Honest representative-anchor scope. 5 channels.
  @payload tension := inline {
    concept      = 0.56   # English web-register distinctness (ground vocab/topic spread)
    context      = 0.60   # en-language surface context steer
    meaning      = 0.63   # factual/everyday semantic core (web register)
    authenticity = 0.80   # REAL FineWeb en web text (ODC-BY) — high (not authored)
    sender       = 0.40   # non-addressed web prose (neutral sender)
  }

  closed_anchor = "303M English-register grounding anchor (curated sample + manifest pointer)"
  cross_link    = "HEXAD/KOSMOS.md (anima hub) · kr_303m.kosmos / sns_303m.kosmos (sibling lanes of this set) · corpus_5lang_7b_webscale.kosmos (full en webscale, R2 manifest) · dancinlab/kosmos profile SSOT"
