// ── Stdlib-compat helpers (H_1387) ──
// The legacy Python-port called builtins the CURRENT hexa toolchain does not bind by name
// (contains_item · hash · slice · sort_by · lowercase · insert_at). These pure-hexa helpers
// restore the EXACT semantics the port relied on — no behavior change, just local definitions
// so the executor module COMPILES (build, not only parse). Used only by the planner/scheduler
// helpers; the H_1386 routing path does not depend on them.

// contains_item — array membership (returns true iff `item` is an element of `arr`).
fn contains_item(arr: array, item: string) -> bool {
    for x in arr {
        if x == item { return true }
    }
    false
}

// hash — a small deterministic FNV-1a-style string hash (32-bit-ish, non-negative). Used only to
// mint a TaskScheduler task id; any stable hash preserves the original intent.
fn hash(s: string) -> int {
    let n = byte_len(s)
    let mut h = 2166136261
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        h = (h ^ b) * 16777619
        h = h % 2147483647
        i = i + 1
    }
    if h < 0 { h = -h }
    h
}

// slice — array sub-range [start, end) with clamped bounds (the array form of the missing builtin).
fn slice(arr: array, start: int, end: int) -> array {
    let mut lo = start
    let mut hi = end
    if lo < 0 { lo = 0 }
    if hi > len(arr) { hi = len(arr) }
    let mut out = []
    let mut i = lo
    while i < hi {
        append(out, arr[i])
        i = i + 1
    }
    out
}

// sort_by — sort an array of maps by a numeric `key` field. dir == "desc" sorts descending, else
// ascending. Stable selection sort (small N — the ranked-tool list), in place, returns the array.
fn sort_by(arr: array, key: string, dir: string) -> array {
    let desc = dir == "desc"
    let n = len(arr)
    let mut i = 0
    while i < n {
        let mut sel = i
        let mut j = i + 1
        while j < n {
            let better = if desc { arr[j][key] > arr[sel][key] } else { arr[j][key] < arr[sel][key] }
            if better { sel = j }
            j = j + 1
        }
        if sel != i {
            let tmp = arr[i]
            arr[i] = arr[sel]
            arr[sel] = tmp
        }
        i = i + 1
    }
    arr
}

// _lower1 — lowercase one ASCII byte (A-Z -> a-z); other bytes pass through.
fn _lower1(b: int) -> int { if b >= 65 && b <= 90 { return b + 32 } return b }

// lowercase — ASCII lowercase via the proven ord/chr byte-loop idiom (CORE/g6_ideation.hexa); the
// `to_lower` builtin is not resolvable once CORE is imported, so we lower byte-by-byte.
fn lowercase(s: string) -> string {
    let n = byte_len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + chr(_lower1(ord(substring(s, i, i + 1))))
        i = i + 1
    }
    out
}

// insert_at — insert `item` into `arr` at index `idx`, shifting the tail right. Returns the array.
fn insert_at(arr: array, idx: int, item: string) -> array {
    let mut out = []
    let mut i = 0
    while i < len(arr) {
        if i == idx { append(out, item) }
        append(out, arr[i])
        i = i + 1
    }
    if idx >= len(arr) { append(out, item) }
    // mutate the input in place to preserve the original (mutating) call-site contract.
    let mut k = 0
    while k < len(out) {
        if k < len(arr) { arr[k] = out[k] } else { append(arr, out[k]) }
        k = k + 1
    }
    arr
}

