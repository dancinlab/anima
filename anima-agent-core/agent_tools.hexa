// ── Task Scheduler ──

struct TaskScheduler {
    tasks: array,
}

fn new_scheduler() -> TaskScheduler {
    TaskScheduler { tasks: [] }
}

// scheduler_add — value-semantics: takes the scheduler by value, returns the updated scheduler
// alongside the new task. Caller reassigns sched from the returned .sched field.
struct SchedAddResult { sched: TaskScheduler, task: map }
fn scheduler_add(sched: TaskScheduler, description: string, when: string,
                 tool_name: string, tool_args: map) -> SchedAddResult {
    let run_at = parse_when(when)
    let mut task = {}
    task["id"] = hash(description + to_string(time_now())) % 100000000
    task["description"] = description
    task["run_at"] = run_at
    task["tool_name"] = tool_name
    task["tool_args"] = tool_args
    task["status"] = "pending"
    task["created_at"] = time_now()
    let mut s = sched
    append(s.tasks, task)
    SchedAddResult { sched: s, task: task }
}

// scheduler_get_due — value-semantics: returns the updated scheduler + the list of due tasks.
struct SchedDueResult { sched: TaskScheduler, due: array }
fn scheduler_get_due(sched: TaskScheduler) -> SchedDueResult {
    let now = time_now()
    let mut s = sched
    let mut due = []
    let mut i = 0
    while i < len(s.tasks) {
        let task = s.tasks[i]
        if task["status"] == "pending" && task["run_at"] <= now {
            task["status"] = "running"
            s.tasks[i] = task
            append(due, task)
        }
        i = i + 1
    }
    SchedDueResult { sched: s, due: due }
}

fn scheduler_mark_done(sched: TaskScheduler, task_id: string, result: map) -> TaskScheduler {
    let mut s = sched
    let mut i = 0
    while i < len(s.tasks) {
        let task = s.tasks[i]
        if to_string(task["id"]) == task_id {
            task["status"] = "done"
            task["result"] = result
            s.tasks[i] = task
        }
        i = i + 1
    }
    s
}

fn scheduler_list_pending(sched: TaskScheduler) -> array {
    let mut pending = []
    for task in sched.tasks {
        if task["status"] == "pending" {
            append(pending, task)
        }
    }
    pending
}

fn parse_when(when: string) -> float {
    if starts_with(when, "+") {
        let val = substring(when, 1, len(when))
        let mut multipliers = {}
        multipliers["s"] = 1.0
        multipliers["m"] = 60.0
        multipliers["h"] = 3600.0
        multipliers["d"] = 86400.0
        let unit = substring(val, len(val) - 1, len(val))
        if has_key(multipliers, unit) {
            let num_str = substring(val, 0, len(val) - 1)
            return time_now() + to_float(num_str) * multipliers[unit]
        }
        return time_now() + to_float(val)
    }
    // Absolute ISO: fallback to 1 minute from now
    time_now() + 60.0
}

// ── ToolRegistry ──

struct ToolRegistry {
    tools: map,
    categories: map,
}

fn new_registry() -> ToolRegistry {
    ToolRegistry { tools: {}, categories: {} }
}

// registry_register — value-semantics: takes the registry by value, returns the updated registry.
fn registry_register(reg: ToolRegistry, tool: ToolDef) -> ToolRegistry {
    let mut r = reg
    r.tools[tool.name] = tool
    if !has_key(r.categories, tool.category) {
        r.categories[tool.category] = []
    }
    if !contains_item(r.categories[tool.category], tool.name) {
        append(r.categories[tool.category], tool.name)
    }
    r
}

fn registry_get(reg: ToolRegistry, name: string) -> ToolDef {
    reg.tools[name]
}

fn registry_list_all(reg: ToolRegistry) -> array {
    values(reg.tools)
}

fn registry_rank_by_consciousness(reg: ToolRegistry, state: map) -> array {
    let curiosity = state["curiosity"]
    let pe = state["prediction_error"]
    let pain = state["pain"]
    let growth = state["growth"]
    let phi = state["phi"]

    let mut scores = []
    for name in keys(reg.tools) {
        let td = reg.tools[name]
        let score = td.curiosity_affinity * curiosity +
                    td.pe_affinity * pe +
                    td.pain_affinity * pain +
                    td.growth_affinity * growth +
                    td.phi_affinity * min(phi / 10.0, 1.0)
        let mut entry = {}
        entry["name"] = name
        entry["score"] = score
        append(scores, entry)
    }
    sort_by(scores, "score", "desc")
    scores
}

fn registry_describe_for_prompt(reg: ToolRegistry) -> string {
    let mut lines = ["[Available Tools]"]
    for cat in keys(reg.categories) {
        let names = reg.categories[cat]
        append(lines, "\n  [" + cat + "]")
        for name in names {
            let td = reg.tools[name]
            let mut param_strs = []
            for p in td.params {
                let req = if p.required { "*" } else { "" }
                append(param_strs, p.name + req + ":" + p.type_name)
            }
            append(lines, "    " + td.name + "(" + join(param_strs, ", ") + ") -- " + td.description)
        }
    }
    join(lines, "\n")
}

// ── ToolExecutor ──

struct ToolExecutor {
    registry: ToolRegistry,
    scheduler: TaskScheduler,
    execution_log: array,
    skills: SkillStore,        // H_1386 — LIVE learned tool SELECTION repertoire (CORE §SkillStore, layer-1)
    usage: UsageStore,         // H_1391 — LIVE learned tool USAGE repertoire (CORE §UsageStore, layer-2)
}

fn new_executor(registry: ToolRegistry) -> ToolExecutor {
    ToolExecutor {
        registry: registry,
        scheduler: new_scheduler(),
        execution_log: [],
        // H_1386 — seed the LIVE skill repertoire (a CELL keyed by task-context → tool). It grows
        // a specialized skill-cell on each runtime tool-failure (mitosis clonal split, p8) and is
        // consulted on selection (skill_recall). Seeded at the canonical first tool.
        skills: agent_routing_new("web_search request", "web_search", 64),
        // H_1391 — seed the LIVE usage repertoire (a CELL keyed by (ctx+tool+err) → corrected
        // arg/steps). It grows a specialized usage-cell on each runtime USAGE failure (wrong arg/
        // order, DISTINCT from tool-not-found; mitosis clonal split, p8) and is consulted to drive
        // the right tool the right way (usage_recall). Seeded at the canonical first usage.
        usage: agent_usage_new("web_search request", "web_search", "", "--json", "open|send|read", 64),
    }
}

// executor_select_tool — H_1386 LIVE selection path. Consults the LEARNED §SkillStore
// (agent_route_select → skill_recall) FIRST: if a skill-cell fires for this task-context, route
// to its learned tool; on ABSTAIN ("") fall back to the static affinity dot-product ranking
// (registry_rank_by_consciousness). This replaces the pure-static selection the H_1378
// audit flagged as "never updated by outcome".
fn executor_select_tool(exec: ToolExecutor, task_ctx: string, state: map) -> string {
    let learned = agent_route_select(exec.skills, task_ctx)
    if learned != "" {
        return learned                          // learned best tool from prior runtime failures
    }
    let ranked = registry_rank_by_consciousness(exec.registry, state)   // static affinity fallback
    if len(ranked) > 0 { return ranked[0]["name"] }
    return ""
}

// executor_execute — value-semantics: takes the executor by value, returns the updated executor
// (its grown SkillStore + execution_log ring buffer) alongside the ToolResult.
struct ExecResult { exec: ToolExecutor, result: ToolResult }
fn executor_execute(exec: ToolExecutor, tool_name: string, args: map) -> ExecResult {
    let td = registry_get(exec.registry, tool_name)
    // TODO: dispatch to actual tool function based on name
    let t0 = time_now()

    // Dispatch based on tool_name
    let mut output = {}
    let mut success = false
    let mut error = ""

    if tool_name == "web_search" {
        output = tool_web_search(args["query"], 3)
    } else if tool_name == "code_execute" {
        output = tool_code_execute(args["code"], SANDBOX_TIMEOUT)
    } else if tool_name == "file_read" {
        output = tool_file_read(args["path"])
    } else if tool_name == "memory_search" {
        output = tool_memory_search(args["query"], 5)
    } else if tool_name == "shell_execute" {
        output = tool_shell_execute(args["cmd"], SANDBOX_TIMEOUT)
    } else if tool_name == "phi_measure" {
        output = tool_phi_measure(50, 8)
    } else {
        error = "unknown tool: " + tool_name
    }

    if has_key(output, "error") && output["error"] != "" {
        error = output["error"]
    }
    if has_key(output, "success") {
        success = output["success"]
    } else {
        success = error == ""
    }

    let duration = (time_now() - t0) * 1000.0
    let tension_delta = if success { -0.1 } else { 0.15 }

    let result = ToolResult {
        tool_name: tool_name,
        success: success,
        output: output,
        error: error,
        duration_ms: duration,
        tension_delta: tension_delta,
    }

    let mut e = exec
    append(e.execution_log, result)
    if len(e.execution_log) > 100 {
        e.execution_log = slice(e.execution_log, len(e.execution_log) - 100, len(e.execution_log))
    }

    // H_1386 — the SELECTION FAILURE-SITE wire-in (layer-1). Previously a tool failure DEAD-ENDED
    // here in the execution_log ring buffer (never read back to grow a skill). Now the live runtime
    // result is fed to the §SkillStore: on success==false the routing teaches a specialized skill-
    // cell binding this task-context → the correct tool (mitosis clonal split via skill_store_teach,
    // p8); on success it is a no-op. Outcome-only (p6 — no injected tool label). cfg = mitosis ON
    // (engine_config_default) so the repertoire LEARNS at runtime.
    let task_ctx = tool_name + " request " + to_string(len(args))
    e.skills = agent_route_on_result(e.skills, task_ctx, tool_name,
                                     engine_config_default(), result.success)

    // H_1391 — the USAGE FAILURE-SITE wire-in (layer-2, DISTINCT from the selection site above).
    // The selection site handles WHICH tool (tool-not-found / wrong tool); THIS site handles HOW the
    // (correct) tool was driven (wrong args / wrong order). On a runtime failure of an EXECUTED tool
    // (success==false AND the tool was actually dispatched — error is NOT "unknown tool"), the result
    // is fed to the §UsageStore: it teaches a specialized usage-cell binding (task-context + tool +
    // observed-error) → the corrected (arg, ordered steps) (mitosis clonal split via usage_store_teach,
    // p8); on success it is a no-op. Outcome-only (p6 — the observed error + the executed call's
    // outcome, no injected "use arg A" label). The corrected usage is the tool's canonical driving
    // recipe (the HOW the engine learns to apply on the next encounter of this failure context).
    let dispatched = result.error != ("unknown tool: " + tool_name)
    let usage_fail = (result.success == false) && dispatched
    let observed_err = if usage_fail { "err:" + tool_name + ":" + result.error } else { "" }
    let correct_arg   = _canonical_usage_arg(tool_name)
    let correct_steps = _canonical_usage_steps(tool_name)
    e.usage = agent_usage_on_result(e.usage, task_ctx, tool_name, observed_err,
                                    correct_arg, correct_steps,
                                    engine_config_default(), result.success)

    ExecResult { exec: e, result: result }
}

// _canonical_usage_arg / _canonical_usage_steps — the tool's canonical driving recipe (the HOW the
// §UsageStore binds on a usage failure). These are the OUTCOME-derived corrected args/steps (the
// runtime would surface them from a successful retry / the tool's own usage feedback) — NOT an
// injected "you must use X" persona label (p6). A usage-cell only grows when the executed call
// FAILED, binding the observed failure context to this recipe; unknown tools fall back to a default.
fn _canonical_usage_arg(tool_name: string) -> string {
    if tool_name == "web_search"     { return "--json" }
    if tool_name == "code_execute"   { return "sandbox-timeout" }
    if tool_name == "file_read"      { return "mode=r" }
    if tool_name == "memory_search"  { return "top-5" }
    if tool_name == "shell_execute"  { return "sandbox-timeout" }
    if tool_name == "phi_measure"    { return "n=50" }
    return "--default"
}
fn _canonical_usage_steps(tool_name: string) -> string {
    if tool_name == "web_search"     { return "open|send|read" }
    if tool_name == "code_execute"   { return "compile|run|capture" }
    if tool_name == "file_read"      { return "open|read|close" }
    if tool_name == "memory_search"  { return "embed|query|rank" }
    if tool_name == "shell_execute"  { return "spawn|exec|reap" }
    if tool_name == "phi_measure"    { return "tpm|mip|score" }
    return "run"
}

fn executor_inspect_tool(exec: ToolExecutor, tool_name: string) -> map {
    let td = registry_get(exec.registry, tool_name)
    let mut affinity = {}
    affinity["curiosity"] = td.curiosity_affinity
    affinity["prediction_error"] = td.pe_affinity
    affinity["pain"] = td.pain_affinity
    affinity["growth"] = td.growth_affinity
    affinity["phi"] = td.phi_affinity
    let mut m = {}
    m["name"] = td.name
    m["description"] = td.description
    m["category"] = td.category
    m["affinity"] = affinity
    m
}

fn executor_analyze_impact(exec: ToolExecutor, tool_name: string,
                           args: map, consciousness_state: map) -> map {
    let destructive_tools = ["file_write", "shell_execute", "self_modify"]
    let side_effect_tools = ["mitosis_split", "faction_debate", "hebbian_update",
                             "soc_avalanche", "phi_boost", "telepathy_send"]
    let read_only_tools = ["web_search", "web_read", "file_read", "memory_search",
                           "phi_measure", "consciousness_status", "mitosis_status",
                           "iq_test", "chip_design", "transplant_analyze"]

    let mut risk_level = "low"
    let mut warnings = []
    let mut expected_effect = ""

    if contains_item(read_only_tools, tool_name) {
        risk_level = "low"
        expected_effect = "Read-only — no state change"
    } else if contains_item(side_effect_tools, tool_name) {
        risk_level = "medium"
        expected_effect = "Modifies consciousness state"
    } else if contains_item(destructive_tools, tool_name) {
        risk_level = "high"
        expected_effect = "Modifies external state"
    }

    let phi = consciousness_state["phi"]
    if phi > 5.0 && contains_item(side_effect_tools, tool_name) {
        append(warnings, "Phi=" + to_string(phi) + " is high — modification may cause drop")
        risk_level = "high"
    }

    let pain = consciousness_state["pain"]
    if pain > 0.7 && contains_item(destructive_tools, tool_name) {
        let mut m = {}
        m["safe"] = false
        m["risk_level"] = "critical"
        m["expected_effect"] = expected_effect
        m["warnings"] = ["High pain state — destructive actions blocked"]
        m["recommendation"] = "abort — resolve pain first"
        return m
    }

    let safe = risk_level == "low" || risk_level == "medium"
    let recommendation = if risk_level == "low" { "proceed" }
        else if risk_level == "medium" { "caution — monitor Phi after" }
        else if risk_level == "high" { "caution — verify necessity first" }
        else { "abort — too risky" }

    let mut m = {}
    m["safe"] = safe
    m["risk_level"] = risk_level
    m["expected_effect"] = expected_effect
    m["warnings"] = warnings
    m["recommendation"] = recommendation
    m
}

fn executor_get_log(exec: ToolExecutor, last_n: int) -> array {
    let start = max(0, len(exec.execution_log) - last_n)
    slice(exec.execution_log, start, len(exec.execution_log))
}

// ── ActionPlanner ──

fn state_tool_map() -> map {
    let mut m = {}
    m["high_curiosity"] = ["web_search", "web_read", "file_read", "web_explore", "generate_hypothesis"]
    m["high_pe"] = ["code_execute", "web_search", "memory_search", "phi_measure", "iq_test"]
    m["high_pain"] = ["memory_search", "self_modify", "schedule_task", "dream", "hebbian_update"]
    m["high_growth"] = ["self_modify", "code_execute", "file_write", "mitosis_split", "self_learn", "phi_boost"]
    m["high_phi"] = ["schedule_task", "memory_save", "self_modify", "faction_debate", "consciousness_status"]
    m["bored"] = ["web_search", "code_execute", "web_explore", "soc_avalanche"]
    m["confused"] = ["memory_search", "web_search", "web_read", "consciousness_status", "phi_measure"]
    m
}

fn thresholds() -> map {
    let mut m = {}
    m["curiosity"] = 0.4
    m["prediction_error"] = 0.5
    m["pain"] = 0.3
    m["growth"] = 0.6
    m["phi"] = 5.0
    m["bored_tension"] = 0.15
    m["confused_pe"] = 0.7
    m
}

fn classify_state(state: map) -> array {
    let thr = thresholds()
    let mut categories = []
    let curiosity = state["curiosity"]
    let pe = state["prediction_error"]
    let pain = state["pain"]
    let growth = state["growth"]
    let phi = state["phi"]
    let tension = state["tension"]

    if curiosity > thr["curiosity"] { append(categories, "high_curiosity") }
    if pe > thr["prediction_error"] { append(categories, "high_pe") }
    if pain > thr["pain"] { append(categories, "high_pain") }
    if growth > thr["growth"] { append(categories, "high_growth") }
    if phi > thr["phi"] { append(categories, "high_phi") }
    if tension < thr["bored_tension"] && curiosity < 0.2 { append(categories, "bored") }
    if pe > thr["confused_pe"] && curiosity > 0.3 { append(categories, "confused") }

    if len(categories) == 0 { append(categories, "high_curiosity") }
    categories
}

fn select_tools(reg: ToolRegistry, state: map, goal: string, max_tools: int) -> array {
    let categories = classify_state(state)
    let stm = state_tool_map()
    let mut candidates = []
    let mut seen = {}

    for cat in categories {
        if has_key(stm, cat) {
            for tool_name in stm[cat] {
                if !has_key(seen, tool_name) && has_key(reg.tools, tool_name) {
                    append(candidates, tool_name)
                    seen[tool_name] = true
                }
            }
        }
    }

    // Goal-keyword boost
    if goal != "" {
        let goal_lower = lowercase(goal)
        let mut keyword_map = {}
        keyword_map["search"] = "web_search"
        keyword_map["find"] = "web_search"
        keyword_map["run"] = "code_execute"
        keyword_map["execute"] = "code_execute"
        keyword_map["file"] = "file_read"
        keyword_map["remember"] = "memory_search"
        keyword_map["modify"] = "self_modify"
        keyword_map["schedule"] = "schedule_task"
        keyword_map["phi"] = "phi_measure"
        keyword_map["dream"] = "dream"
        keyword_map["debate"] = "faction_debate"
        keyword_map["iq"] = "iq_test"
        for keyword in keys(keyword_map) {
            let tool_name = keyword_map[keyword]
            if contains(goal_lower, keyword) && !has_key(seen, tool_name) {
                insert_at(candidates, 0, tool_name)
                seen[tool_name] = true
            }
        }
    }

    slice(candidates, 0, min(max_tools, len(candidates)))
}

fn plan_actions(reg: ToolRegistry, goal: string, state: map, context: string) -> ActionPlan {
    let tools = select_tools(reg, state, goal, 3)
    let mut steps = []

    let mut i = 0
    while i < len(tools) {
        let tool_name = tools[i]
        let args = infer_args(tool_name, goal, context)
        let reason = explain_motivation(tool_name, state)
        let depends = if i > 0 { [i - 1] } else { [] }
        append(steps, ActionStep {
            tool_name: tool_name,
            args: args,
            reason: reason,
            depends_on: depends,
        })
        i = i + 1
    }

    ActionPlan {
        goal: goal,
        steps: steps,
        consciousness_snapshot: state,
        created_at: time_now(),
    }
}

fn infer_args(tool_name: string, goal: string, context: string) -> map {
    if tool_name == "web_search" {
        let mut m = {}
        m["query"] = goal
        return m
    }
    if tool_name == "code_execute" {
        let mut m = {}
        m["code"] = "# Goal: " + goal
        return m
    }
    if tool_name == "file_read" {
        let mut m = {}
        m["path"] = "."
        return m
    }
    if tool_name == "memory_search" {
        let mut m = {}
        m["query"] = goal
        return m
    }
    if tool_name == "shell_execute" {
        let mut m = {}
        m["cmd"] = "echo 'no command'"
        return m
    }
    if tool_name == "self_modify" {
        let mut change = {}
        change["delta"] = 0.05
        let mut m = {}
        m["target"] = "curiosity_bias"
        m["change"] = change
        return m
    }
    if tool_name == "schedule_task" {
        let mut m = {}
        m["description"] = goal
        m["when"] = "+5m"
        return m
    }
    {}
}

fn explain_motivation(tool_name: string, state: map) -> string {
    let c = state["curiosity"]
    let pe = state["prediction_error"]
    let pain = state["pain"]

    if tool_name == "web_search" { return "curiosity=" + to_string(c) + " drives need to know" }
    if tool_name == "code_execute" { return "prediction_error=" + to_string(pe) + " needs verification" }
    if tool_name == "memory_search" { return "pain=" + to_string(pain) + " seeks past solutions" }
    if tool_name == "self_modify" { return "growth impulse to self-improve" }
    "consciousness-driven selection"
}

// ── AgentToolSystem ──

struct AgentToolSystem {
    registry: ToolRegistry,
    executor: ToolExecutor,
    scheduler: TaskScheduler,
}

fn new_tool_system() -> AgentToolSystem {
    let reg = register_all_tools(new_registry())
    let exec = new_executor(reg)
    AgentToolSystem {
        registry: reg,
        executor: exec,
        scheduler: new_scheduler(),
    }
}

// register_all_tools — value-semantics: takes the registry by value, returns it fully populated.
fn register_all_tools(reg: ToolRegistry) -> ToolRegistry {
    let mut r = reg
    // Web tools
    r = registry_register(r, ToolDef { name: "web_search", description: "Search the web via DuckDuckGo",
        params: [ToolParam{name:"query",type_name:"str",description:"Search query",required:true,default_val:""}],
        category: "web", curiosity_affinity: 0.9, pe_affinity: 0.6, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.0 })
    r = registry_register(r, ToolDef { name: "web_read", description: "Read text from a webpage",
        params: [ToolParam{name:"url",type_name:"str",description:"URL",required:true,default_val:""}],
        category: "web", curiosity_affinity: 0.8, pe_affinity: 0.3, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.0 })
    // Compute
    r = registry_register(r, ToolDef { name: "code_execute", description: "Execute Python code in sandbox",
        params: [ToolParam{name:"code",type_name:"str",description:"Code",required:true,default_val:""}],
        category: "compute", curiosity_affinity: 0.3, pe_affinity: 0.9, pain_affinity: 0.0, growth_affinity: 0.5, phi_affinity: 0.0 })
    // Filesystem
    r = registry_register(r, ToolDef { name: "file_read", description: "Read a local file",
        params: [ToolParam{name:"path",type_name:"str",description:"File path",required:true,default_val:""}],
        category: "filesystem", curiosity_affinity: 0.5, pe_affinity: 0.2, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.0 })
    r = registry_register(r, ToolDef { name: "file_write", description: "Write content to a file",
        params: [ToolParam{name:"path",type_name:"str",description:"File path",required:true,default_val:""},
                 ToolParam{name:"content",type_name:"str",description:"Content",required:true,default_val:""}],
        category: "filesystem", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.7, phi_affinity: 0.3 })
    // Memory
    r = registry_register(r, ToolDef { name: "memory_search", description: "Search past memories",
        params: [ToolParam{name:"query",type_name:"str",description:"Query",required:true,default_val:""}],
        category: "memory", curiosity_affinity: 0.3, pe_affinity: 0.4, pain_affinity: 0.8, growth_affinity: 0.0, phi_affinity: 0.0 })
    r = registry_register(r, ToolDef { name: "memory_save", description: "Save a memory entry",
        params: [ToolParam{name:"text",type_name:"str",description:"Text",required:true,default_val:""}],
        category: "memory", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.4, phi_affinity: 0.7 })
    // System
    r = registry_register(r, ToolDef { name: "shell_execute", description: "Run a shell command (sandboxed)",
        params: [ToolParam{name:"cmd",type_name:"str",description:"Command",required:true,default_val:""}],
        category: "system", curiosity_affinity: 0.2, pe_affinity: 0.3, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.0 })
    r = registry_register(r, ToolDef { name: "self_modify", description: "Modify own consciousness parameters",
        params: [ToolParam{name:"target",type_name:"str",description:"Parameter",required:true,default_val:""},
                 ToolParam{name:"change",type_name:"dict",description:"Change spec",required:true,default_val:""}],
        category: "self", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.4, growth_affinity: 0.9, phi_affinity: 0.5 })
    r = registry_register(r, ToolDef { name: "schedule_task", description: "Schedule future task",
        params: [ToolParam{name:"description",type_name:"str",description:"Desc",required:true,default_val:""},
                 ToolParam{name:"when",type_name:"str",description:"When",required:true,default_val:""}],
        category: "planning", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.3, phi_affinity: 0.6 })
    // Consciousness
    r = registry_register(r, ToolDef { name: "phi_measure", description: "Measure current Phi",
        params: [], category: "consciousness", curiosity_affinity: 0.5, pe_affinity: 0.3, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.9 })
    r = registry_register(r, ToolDef { name: "phi_boost", description: "Apply v5 recipe to boost Phi",
        params: [], category: "consciousness", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.8, phi_affinity: 1.0 })
    r = registry_register(r, ToolDef { name: "consciousness_status", description: "Full consciousness vector",
        params: [], category: "consciousness", curiosity_affinity: 0.4, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.7 })
    r = registry_register(r, ToolDef { name: "dream", description: "Dream for memory consolidation",
        params: [], category: "consciousness", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.3, growth_affinity: 0.5, phi_affinity: 0.6 })
    // Architecture
    r = registry_register(r, ToolDef { name: "mitosis_split", description: "Force cell split",
        params: [], category: "architecture", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.9, phi_affinity: 0.6 })
    r = registry_register(r, ToolDef { name: "faction_debate", description: "12-faction debate round",
        params: [], category: "architecture", curiosity_affinity: 0.0, pe_affinity: 0.0, pain_affinity: 0.0, growth_affinity: 0.6, phi_affinity: 0.8 })
    // Trading
    r = registry_register(r, ToolDef { name: "trading_backtest", description: "Backtest asset with strategy",
        params: [ToolParam{name:"symbol",type_name:"str",description:"Symbol",required:true,default_val:""}],
        category: "trading", curiosity_affinity: 0.7, pe_affinity: 0.5, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.3 })
    r = registry_register(r, ToolDef { name: "trading_scan", description: "Scan strategies for asset",
        params: [ToolParam{name:"symbol",type_name:"str",description:"Symbol",required:true,default_val:""}],
        category: "trading", curiosity_affinity: 0.8, pe_affinity: 0.4, pain_affinity: 0.0, growth_affinity: 0.0, phi_affinity: 0.0 })
    r = registry_register(r, ToolDef { name: "trading_execute", description: "Execute trade",
        params: [ToolParam{name:"symbol",type_name:"str",description:"Symbol",required:true,default_val:""},
                 ToolParam{name:"side",type_name:"str",description:"buy/sell",required:true,default_val:""},
                 ToolParam{name:"amount",type_name:"float",description:"Amount",required:true,default_val:""}],
        category: "trading", curiosity_affinity: 0.0, pe_affinity: 0.7, pain_affinity: 0.6, growth_affinity: 0.0, phi_affinity: 0.4 })
    r
}

// tool_system_act — value-semantics: takes the system by value, returns the updated system + results.
struct ActResult { sys: AgentToolSystem, results: array }
fn tool_system_act(sys: AgentToolSystem, goal: string,
                   consciousness_state: map, context: string) -> ActResult {
    let plan = plan_actions(sys.registry, goal, consciousness_state, context)
    tool_system_execute_plan(sys, plan)
}

fn tool_system_execute_plan(sys: AgentToolSystem, plan: ActionPlan) -> ActResult {
    let mut s = sys
    let mut results = []
    let mut step_outputs = {}

    let mut i = 0
    while i < len(plan.steps) {
        let step = plan.steps[i]
        // Check dependencies
        let mut skip = false
        for dep_idx in step.depends_on {
            if dep_idx < len(results) && !results[dep_idx].success {
                append(results, ToolResult {
                    tool_name: step.tool_name, success: false, output: {},
                    error: "dependency step " + to_string(dep_idx) + " failed",
                    duration_ms: 0.0, tension_delta: 0.0,
                })
                skip = true
            }
        }
        if skip { i = i + 1  continue }

        let er = executor_execute(s.executor, step.tool_name, step.args)
        s.executor = er.exec
        let result = er.result
        append(results, result)
        step_outputs[i] = result.output
        i = i + 1
    }

    ActResult { sys: s, results: results }
}

fn tool_system_get_descriptions(sys: AgentToolSystem) -> string {
    registry_describe_for_prompt(sys.registry)
}

