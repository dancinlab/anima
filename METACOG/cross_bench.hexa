// ════════════════════════════════════════════════════════════════════════
// METACOG/cross_bench.hexa — cross-bench verdict template inject (M4 2026-05-28)
//
// 정체: F-PERSONA-4 (#1130 basin_kurtosis) + F-M4B-FIRE-3 (#1133 router 분화)
//      + 미래 falsifier 에 metacog 5-tier verdict template 을 적용하는 PURE
//      injection surface.
//
// per METACOG.md M4 — `METACOG/cross_bench.hexa` · F-PERSONA-4 + F-M4B-FIRE-3
// + 미래 falsifier 에 template 적용.
//
// 4 pub primitives (PURE):
//   1) cb_apply_verdict_template(fid, raw_result)  — 5-tier auto 분류
//   2) cb_fpersona4_inject(basin_kurtosis, thresh) — F-PERSONA-4 측정자
//   3) cb_fm4b_fire3_inject(router_topA, topB)     — F-M4B-FIRE-3 router 분화
//   4) cb_history_table(injections)                — markdown table 렌더
//
// 5-tier verdict (metacog_lib 와 동일 taxonomy):
//   1 ROBUST          — actual >> threshold (clear pass)
//   2 SMALL-N         — actual ~ threshold but suspect (n too low)
//   3 INVERSE         — actual < threshold but trend reversed
//   4 AMBIGUOUS       — actual ~ threshold, no clear signal
//   5 ALL-FAIL        — actual << threshold (clear fail)
//
// Naming: `cb_` prefix (cross bench) — g61 collision-free.
//
// p7 NO PPL VERDICT: template = categorical 5-tier (perplexity 미사용).
// ════════════════════════════════════════════════════════════════════════

use "METACOG/metacog_lib"

// ─── helper: classify ratio actual/threshold to 5-tier code ──────────────
//
// ratio = actual / threshold.
//   ratio >= 2.0          → 1 ROBUST     (clear pass, 2× over)
//   1.0 <= ratio < 2.0    → 2 SMALL-N    (pass but suspect)
//   0.5 <= ratio < 1.0    → 4 AMBIGUOUS  (near-threshold, sub-bar)
//   0.1 <= ratio < 0.5    → 3 INVERSE    (clear fail with some signal)
//   ratio < 0.1           → 5 ALL-FAIL   (clear fail)

fn _ratio_to_code(actual: float, threshold: float) -> int {
    if threshold <= 0.0 {
        if actual > 0.0 { return 1 }
        return 5
    }
    let r = actual / threshold
    if r >= 2.0 { return 1 }
    if r >= 1.0 { return 2 }
    if r >= 0.5 { return 4 }
    if r >= 0.1 { return 3 }
    return 5
}

// ─── 1. generic verdict template inject ──────────────────────────────────
pub fn cb_apply_verdict_template(falsifier_id: string, raw_result: dict) -> dict {
    let actual_v = raw_result["actual"]
    let threshold_v = raw_result["threshold"]
    let mut actual = 0.0
    let mut threshold = 0.0
    if type_of(actual_v) == "float" { actual = actual_v }
    if type_of(actual_v) == "int" { actual = float(actual_v) }
    if type_of(threshold_v) == "float" { threshold = threshold_v }
    if type_of(threshold_v) == "int" { threshold = float(threshold_v) }
    let code = _ratio_to_code(actual, threshold)
    let label = mc_verdict_label(code)
    let tier = mc_verdict_tier(code)
    return #{
        "falsifier_id": falsifier_id,
        "actual": actual,
        "threshold": threshold,
        "verdict_code": code,
        "label": label,
        "tier": tier,
    }
}

// ─── 2. F-PERSONA-4 inject ───────────────────────────────────────────────
//
// F-PERSONA-4 (PR #1130 retrospective): basin_kurtosis 가 category-prompt
// substrate invariance 측정자. threshold 미달 → SMALL-N or ALL-FAIL.
pub fn cb_fpersona4_inject(basin_kurtosis: float, threshold: float) -> dict {
    let raw = #{
        "actual": basin_kurtosis,
        "threshold": threshold,
    }
    return cb_apply_verdict_template("F-PERSONA-4", raw)
}

// ─── 3. F-M4B-FIRE-3 inject ──────────────────────────────────────────────
//
// F-M4B-FIRE-3 (PR #1133): router top-A / top-B 분화 측정.
// 분화도 = |topA - topB| / max(topA, topB). 0 = monopoly (FAIL), 1 = full split.
pub fn cb_fm4b_fire3_inject(router_topA: int, router_topB: int) -> dict {
    let a = float(router_topA)
    let b = float(router_topB)
    let mut max_ab = a
    if b > max_ab { max_ab = b }
    let mut diff = a - b
    if diff < 0.0 { diff = 0.0 - diff }
    let mut differentiation = 0.0
    if max_ab > 0.0 { differentiation = diff / max_ab }
    // for router 분화: higher 분화도 = winner-take-all (BAD), lower = healthy split (GOOD).
    // we invert so that ratio threshold semantics match (low differentiation = high tier).
    let invariance = 1.0 - differentiation
    let raw = #{
        "actual": invariance,
        "threshold": 0.5,
    }
    return cb_apply_verdict_template("F-M4B-FIRE-3", raw)
}

// ─── 4. history table render (markdown) ──────────────────────────────────
//
// injections: list of dict (cb_apply_verdict_template 출력) → markdown table.
pub fn cb_history_table(injections: list) -> string {
    let mut out = "| falsifier_id | actual | threshold | code | label | tier |\n"
    out = out + "|---|---|---|---|---|---|\n"
    let mut i = 0
    let mut len = injections.len()
    while i < len {
        let r = injections[i]
        let fid = r["falsifier_id"]
        let a = r["actual"]
        let t = r["threshold"]
        let c = r["verdict_code"]
        let lbl = r["label"]
        let tr = r["tier"]
        out = out + "| " + str(fid) + " | " + str(a) + " | " + str(t) + " | " + str(c) + " | " + str(lbl) + " | " + str(tr) + " |\n"
        i = i + 1
    }
    return out
}
