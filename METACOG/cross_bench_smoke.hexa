// ════════════════════════════════════════════════════════════════════════
// METACOG/cross_bench_smoke.hexa — cross-bench inject invariants (M4 2026-05-28)
//
// 정체: cross_bench.hexa PURE wrapper 의 5 invariant — 5-tier auto 분류
//      + F-PERSONA-4 / F-M4B-FIRE-3 inject 닫음.
//
// Invariants (5):
//   I1: apply_verdict_template (actual=10, thresh=1)  → code 1 ROBUST
//   I2: apply_verdict_template (actual=0.5, thresh=1) → code 4 AMBIGUOUS
//   I3: apply_verdict_template (actual=0.05, thresh=1)→ code 5 ALL-FAIL
//   I4: cb_fpersona4_inject(0.001, 0.1) label == "ALL-FAIL"  (PR #1130 mirror)
//   I5: cb_fm4b_fire3_inject(50, 50) tier == "GREEN" (healthy split → ROBUST)
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/METACOG/cross_bench"

fn main() {
    println("=== METACOG/cross_bench_smoke ===")

    // I1: ROBUST classification
    let r1 = cb_apply_verdict_template("FAKE-ROBUST", #{ "actual": 10.0, "threshold": 1.0 })
    let c1 = r1["verdict_code"]
    let i1 = c1 == 1
    println("I1 ROBUST code=" + str(c1) + " expected=1  " + (if i1 { "PASS" } else { "FAIL" }))

    // I2: AMBIGUOUS classification (0.5/1 = 0.5 = threshold for AMBIG band)
    let r2 = cb_apply_verdict_template("FAKE-AMBIG", #{ "actual": 0.5, "threshold": 1.0 })
    let c2 = r2["verdict_code"]
    let i2 = c2 == 4
    println("I2 AMBIG code=" + str(c2) + " expected=4  " + (if i2 { "PASS" } else { "FAIL" }))

    // I3: ALL-FAIL classification
    let r3 = cb_apply_verdict_template("FAKE-FAIL", #{ "actual": 0.05, "threshold": 1.0 })
    let c3 = r3["verdict_code"]
    let i3 = c3 == 5
    println("I3 ALL-FAIL code=" + str(c3) + " expected=5  " + (if i3 { "PASS" } else { "FAIL" }))

    // I4: F-PERSONA-4 historical mirror — basin_kurtosis 0.001 << threshold 0.1 → ALL-FAIL
    let r4 = cb_fpersona4_inject(0.001, 0.1)
    let lbl4 = r4["label"]
    let i4 = lbl4 == "ALL-FAIL"
    println("I4 F-PERSONA-4 label=" + lbl4 + " expected=ALL-FAIL  " + (if i4 { "PASS" } else { "FAIL" }))

    // I5: F-M4B-FIRE-3 healthy split topA=topB=50 → diff=0 → invariance=1.0 → ROBUST
    let r5 = cb_fm4b_fire3_inject(50, 50)
    let tier5 = r5["tier"]
    let i5 = tier5 == "GREEN"
    println("I5 F-M4B-FIRE-3 tier=" + tier5 + " expected=GREEN  " + (if i5 { "PASS" } else { "FAIL" }))

    // Bonus: history table render — count rows
    let tbl = cb_history_table([r1, r2, r3, r4, r5])
    println("--- history table preview (first 200 chars) ---")
    println(tbl)

    let all_pass = i1 && i2 && i3 && i4 && i5
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (5/5)" } else { "INVARIANT FAILURE" })
}
