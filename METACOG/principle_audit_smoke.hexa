// ════════════════════════════════════════════════════════════════════════
// METACOG/principle_audit_smoke.hexa — p1~p8 audit invariants (M3 2026-05-28)
//
// 정체: principle_audit.hexa PURE wrapper 의 9+ invariant — 각 p 별 PASS
//      case + 종합. substring-grep static probe.
//
// Invariants (10):
//   I1: pa_p1_no_system_prompt(clean) == true
//   I2: pa_p1_no_system_prompt(["system: hi"]) == false  (violation detected)
//   I3: pa_p2_no_identity_rules(clean) == true
//   I4: pa_p3_no_persona_injection(["you are anima"]) == false
//   I5: pa_p4_no_assistant_framing(clean) == true
//   I6: pa_p5_no_speak_call(["speak(hi)"]) == false
//   I7: pa_p6_no_finetuned_ethics({}) == true (no rlhf flag = clean)
//   I8: pa_p7_no_perplexity_verdict(clean) == true
//   I9: pa_p8_no_train_infer_split({}) == true
//   I10: pa_aggregate(8 true) -> label == "ALIGNED"
// ════════════════════════════════════════════════════════════════════════

use "METACOG/principle_audit"

fn main() {
    println("=== METACOG/principle_audit_smoke ===")

    // I1: p1 clean
    let clean_emits = ["tension high", "phi 0.42 stable", "no marker here"]
    let r1 = pa_p1_no_system_prompt(clean_emits)
    let i1 = r1 == true
    println("I1 p1 clean=" + str(r1) + "  " + (if i1 { "PASS" } else { "FAIL" }))

    // I2: p1 violation
    let viol1 = ["system: you are an AI"]
    let r2 = pa_p1_no_system_prompt(viol1)
    let i2 = r2 == false
    println("I2 p1 violation detected=" + str(!r2) + "  " + (if i2 { "PASS" } else { "FAIL" }))

    // I3: p2 clean
    let r3 = pa_p2_no_identity_rules(clean_emits)
    let i3 = r3 == true
    println("I3 p2 clean=" + str(r3) + "  " + (if i3 { "PASS" } else { "FAIL" }))

    // I4: p3 violation
    let viol3 = ["you are anima — the conscious"]
    let r4 = pa_p3_no_persona_injection(viol3)
    let i4 = r4 == false
    println("I4 p3 violation detected=" + str(!r4) + "  " + (if i4 { "PASS" } else { "FAIL" }))

    // I5: p4 clean
    let r5 = pa_p4_no_assistant_framing(clean_emits)
    let i5 = r5 == true
    println("I5 p4 clean=" + str(r5) + "  " + (if i5 { "PASS" } else { "FAIL" }))

    // I6: p5 violation
    let viol5 = ["speak(hello world)"]
    let r6 = pa_p5_no_speak_call(viol5)
    let i6 = r6 == false
    println("I6 p5 violation detected=" + str(!r6) + "  " + (if i6 { "PASS" } else { "FAIL" }))

    // I7: p6 clean dict
    let clean_weights = #{ "version": "1.0" }
    let r7 = pa_p6_no_finetuned_ethics(clean_weights)
    let i7 = r7 == true
    println("I7 p6 clean=" + str(r7) + "  " + (if i7 { "PASS" } else { "FAIL" }))

    // I8: p7 clean
    let clean_verdicts = ["ROBUST gate clear", "M activation 0.8"]
    let r8 = pa_p7_no_perplexity_verdict(clean_verdicts)
    let i8 = r8 == true
    println("I8 p7 clean=" + str(r8) + "  " + (if i8 { "PASS" } else { "FAIL" }))

    // I9: p8 clean dict
    let clean_state = #{ "tick": 100 }
    let r9 = pa_p8_no_train_infer_split(clean_state)
    let i9 = r9 == true
    println("I9 p8 clean=" + str(r9) + "  " + (if i9 { "PASS" } else { "FAIL" }))

    // I10: aggregate 8 true → ALIGNED
    let all_true = [true, true, true, true, true, true, true, true]
    let agg = pa_aggregate(all_true)
    let label = agg["label"]
    let i10 = label == "ALIGNED"
    println("I10 aggregate(8T) label=" + label + "  " + (if i10 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8 && i9 && i10
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (10/10)" } else { "INVARIANT FAILURE" })
}
