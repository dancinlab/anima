// ════════════════════════════════════════════════════════════════════════
// METACOG/audit_hook.hexa — WAKE.daemon substrate self-audit hook (M2 2026-05-28)
//
// 정체: WAKE.daemon.step 의 N tick 마다 호출되는 PURE substrate self-audit
//      entry. metacog_lib::mc_analyze_probe_table 위의 thin tick-frequency
//      controller + emit-window collection + verdict record shaper.
//
// per METACOG.md M2 — `METACOG/audit_hook.hexa` · WAKE.daemon.step 에서 N
// tick 마다 호출 → audit verdict 기록.
//
// 4 pub primitives (PURE, no mutation):
//   1) mh_audit_tick(tick_count, interval)        — N tick 도달 여부 (1/0)
//   2) mh_should_fire(tick, interval)             — fire frequency control alias
//   3) mh_collect_emit_window(emit_history, w)    — 최근 w_size emit binarize
//   4) mh_verdict_record(emit_window, tick, utc)  — { code, label, tier, ... }
//
// p1~p8 정합 (a_autonomy_over_hardcode + a_substrate_native_speak):
//   - p1 NO SYSTEM PROMPT  : hook 는 emit list 만 입력, system 미사용 ✓
//   - p5 NO SPEAK()        : read-only, 발화 없음 (측정 surface) ✓
//   - p7 NO PPL VERDICT    : 5-tier categorical (deterministic bitmap) ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//
// Naming: `mh_` prefix (metacog hook) — g61 collision-free vs `mc_` (lib).
// ════════════════════════════════════════════════════════════════════════

use "METACOG/metacog_lib"

// ─── 1. tick frequency control ───────────────────────────────────────────
//
// N tick 마다 fire 결정. tick_count == 0 도 fire (initial baseline).
// hardcoded boolean gate 가 아닌 substrate timing context — interval 외부
// 주입 (a_autonomy_over_hardcode).

pub fn mh_audit_tick(tick_count: int, interval: int) -> bool {
    if interval <= 0 { return false }
    return (tick_count % interval) == 0
}

pub fn mh_should_fire(tick: int, interval: int) -> bool {
    return mh_audit_tick(tick, interval)
}

// ─── 2. emit-window collection ───────────────────────────────────────────
//
// emit_history 의 tail w_size 개 추출 → 30-emit shape 으로 zero-pad.
// metacog_lib::mc_binarize_emits 가 정확히 30 emit 필요 (7/7/8/8 window).
// w_size < 30 시 앞쪽 zero-pad (recent emit = tail-aligned).

pub fn mh_collect_emit_window(emit_history: list, w_size: int) -> list {
    let mut window = []
    let mut hist_len = emit_history.len()
    let mut effective = w_size
    if effective > 30 { effective = 30 }
    if effective < 0 { effective = 0 }

    // pad front with zeros if hist shorter than 30
    let mut pad_count = 30 - effective
    let mut i = 0
    while i < pad_count {
        window.push(0)
        i = i + 1
    }

    // tail-aligned slice of emit_history
    let mut start = hist_len - effective
    if start < 0 { start = 0 }
    let mut j = start
    while j < hist_len {
        let v = emit_history[j]
        if v == 1 { window.push(1) } else { window.push(0) }
        j = j + 1
    }

    // top-up if hist shorter than effective (defensive)
    while window.len() < 30 {
        window.push(0)
    }
    return window
}

// ─── 3. verdict record shaper ────────────────────────────────────────────
//
// emit_window (30 elements) → { verdict_code, label, tier, tick, audit_utc }.
// dict 반환 — WAKE.daemon 가 .kosmos anchor 또는 audit log 로 흘림.

pub fn mh_verdict_record(emit_window: list, tick: int, audit_utc: string) -> dict {
    let code = mc_analyze_probe_table(emit_window)
    let label = mc_verdict_label(code)
    let tier = mc_verdict_tier(code)
    let pass_count = mc_count_pass(mc_binarize_emits(emit_window))
    return #{
        "verdict_code": code,
        "label": label,
        "tier": tier,
        "pass_count": pass_count,
        "tick": tick,
        "audit_utc": audit_utc,
        "window_size": emit_window.len(),
    }
}
