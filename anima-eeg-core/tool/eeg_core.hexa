    eprintln("  artifact {detect-all|meta|clean|env-emi|blink|motion|emg|ecg|")
    eprintln("            ref-drift|aging}")
    eprintln("                                         landed: 9 AI artifact modules")
    eprintln("")
    eprintln("  integrate {claude-cli|claude-cli-long|wearable|mobile|cardiac|eye-tracker}")
    eprintln("                                         legacy wrappers")
    eprintln("")
    eprintln("  integration {clm-eeg-p1|clm-eeg-p3|berger|artifact-pipeline|")
    eprintln("               rsn|cyborg-token|multi-subject}")
    eprintln("                                         landed: Phase 6 _integrations/ 7 modules")
    eprintln("")
    eprintln("  ml {anomaly|token-cyborg}              legacy clm-eeg wrappers")
    eprintln("")
    eprintln("  analyze {rsn|behavioral|daily-life-verify}")
    eprintln("                                         legacy wrappers")
    eprintln("")
    eprintln("flags after the verb+noun are forwarded verbatim to the backend.")
    eprintln("")
    eprintln("examples:")
    eprintln("  hexa run anima-eeg-core/tool/eeg_core.hexa list")
    eprintln("  hexa run anima-eeg-core/tool/eeg_core.hexa selftest")
    eprintln("  hexa run anima-eeg-core/tool/eeg_core.hexa gate-all --selftest-mode awake")
    eprintln("  hexa run anima-eeg-core/tool/eeg_core.hexa gate-all --input recordings/sessions/X.npy")
    eprintln("  hexa run anima-eeg-core/tool/eeg_core.hexa hardware health --selftest")
}

// ─── list output: enumerate verb/noun → backend table ───────────────────
fn _print_list() {
    println("── eeg_core dispatch table (verb noun → backend status:path) ──")
    println("schema: " + SCHEMA)
    println("")
    let pairs = [
        ["gate-all", ""],
        ["gate-berger", ""],
        ["gate-rms", ""],
        ["gate-pe", ""],
        ["gate-hjorth", ""],
        ["metric", "lz76"],
        ["metric", "pe"],
        ["metric", "hjorth"],
        ["metric", "gamma_theta"],
        ["metric", "alpha-coherence"],
        ["metric", "alpha-phase-plv"],
        ["metric", "dmn-coherence"],
        ["metric", "frontal-asymmetry"],
        ["metric", "spectral-entropy"],
        ["metric", "change-points"],
        ["metric", "berger"],
        ["metric", "all"],
        ["pipeline", "standard"],
        ["pipeline", "daily-life"],
        ["pipeline", "feedback"],
        ["record", "resting"],
        ["record", "daily-life"],
        ["record", "sleep"],
        ["record", "long"],
        ["record", "longitudinal"],
        ["record", "pre-post"],
        ["paradigm", "resting"],
        ["paradigm", "daily-life"],
        ["paradigm", "visual-p300"],
        ["paradigm", "auditory-p300"],
        ["hw", "health"],
        ["hw", "impedance"],
        ["hw", "adjust"],
        ["hw", "headplot"],
        ["hw", "record"],
        ["hardware", "health"],
        ["hardware", "impedance"],
        ["hardware", "impedance_validate"],
        ["hardware", "adjust"],
        ["hardware", "rich"],
        ["hardware", "headplot"],
        ["hardware", "record"],
        ["hardware", "full"],
        ["hardware", "ftdi-fix"],
        ["hardware", "brainflow-sanity"],
        ["artifact", "detect-all"],
        ["artifact", "meta"],
        ["artifact", "clean"],
        ["artifact", "env-emi"],
        ["artifact", "environmental-emi"],
        ["artifact", "blink"],
        ["artifact", "motion"],
        ["artifact", "emg"],
        ["artifact", "ecg"],
        ["artifact", "ref-drift"],
        ["artifact", "aging"],
        ["integrate", "claude-cli"],
        ["integrate", "claude-cli-long"],
        ["integrate", "wearable"],
        ["integrate", "mobile"],
        ["integrate", "cardiac"],
        ["integrate", "eye-tracker"],
        ["integration", "clm-eeg-p1"],
        ["integration", "clm-eeg-p3"],
        ["integration", "berger"],
        ["integration", "artifact-pipeline"],
        ["integration", "rsn"],
        ["integration", "cyborg-token"],
        ["integration", "multi-subject"],
        ["ml", "anomaly"],
        ["ml", "token-cyborg"],
        ["analyze", "rsn"],
        ["analyze", "behavioral"],
        ["analyze", "daily-life-verify"]
    ]
    let mut landed = 0
    let mut legacy = 0
    let mut pending = 0
    let mut i = 0
    while i < len(pairs) {
        let p = pairs[i]
        let verb = p[0]
        let noun = p[1]
        let backend = _resolve_backend(verb, noun)
        let mut status = "pending"
        let mut path = backend
        if backend.starts_with("legacy:") { status = "legacy"; path = backend.substring(7, len(backend)) }
        else { if backend.starts_with("pending:") { status = "pending"; path = backend.substring(8, len(backend)) }
        else { if backend != "" { status = "landed"; path = backend } } }
        if status == "landed" { landed = landed + 1 }
        if status == "legacy" { legacy = legacy + 1 }
        if status == "pending" { pending = pending + 1 }
        let mut row = "  " + verb
        if noun != "" { row = row + " " + noun }
        while len(row) < 36 { row = row + " " }
        row = row + "[" + status + "] " + path
        println(row)
        i = i + 1
    }
    println("")
    println("summary: landed=" + str(landed) + " legacy=" + str(legacy) + " pending=" + str(pending) + " total=" + str(len(pairs)))
    println("──")
}

// ─── selftest: dispatcher integrity ─────────────────────────────────────
//
// raw#10 honest C3: full pipeline selftest is a Phase-3 task (each metric
// module needs to land first). This selftest verifies dispatcher routing:
//   1. list table renders without crash
//   2. resolve_backend returns non-empty for all known pairs
//   3. landed gates' selftest modes are reachable (calls gate-all --selftest)
fn _run_selftest() -> int {
    println("── eeg_core dispatcher selftest ──")
    println("schema: " + SCHEMA)
    let mut pass = 0
    let mut fail = 0
    let mut details = []

    // T1: routing — every known pair resolves to non-empty backend
    let known_pairs = [
        ["gate-all", ""],
        ["gate-berger", ""],
        ["metric", "lz76"],
        ["pipeline", "daily-life"],
        ["record", "resting"],
        ["hardware", "health"],
        ["artifact", "detect-all"],
        ["artifact", "clean"],
        ["artifact", "blink"],
        ["artifact", "motion"],
        ["integrate", "claude-cli"],
        ["ml", "anomaly"]
    ]
    let mut t1_ok = 1
    let mut i = 0
    while i < len(known_pairs) {
        let p = known_pairs[i]
        let b = _resolve_backend(p[0], p[1])
        if b == "" { t1_ok = 0; details.push("T1: routing miss " + p[0] + "/" + p[1]) }
        i = i + 1
    }
    if t1_ok == 1 { pass = pass + 1; details.push("T1: routing-coverage PASS (" + str(len(known_pairs)) + " pairs)") }
    else { fail = fail + 1 }

    // T2: gate composite selftest (landed module — calls real backend)
    let comp = CORE_ROOT + "/_gates/composite_gate.hexa"
    let exists_check = exec("test -f " + comp + " && echo 1 || echo 0").trim()
    if exists_check == "1" {
        pass = pass + 1
        details.push("T2: composite_gate.hexa present")
    } else {
        fail = fail + 1
        details.push("T2: composite_gate.hexa MISSING at " + comp)
    }

    // T3: legacy backend visibility (eeg_setup.hexa for backward compat)
    let setup = "anima-eeg/eeg_setup.hexa"
    let setup_check = exec("test -f " + setup + " && echo 1 || echo 0").trim()
    if setup_check == "1" {
        pass = pass + 1
        details.push("T3: legacy eeg_setup.hexa present (backward compat)")
    } else {
        fail = fail + 1
        details.push("T3: legacy eeg_setup.hexa MISSING")
    }

    // T4: bin/anima top-level dispatcher integration
    let bin_anima = "bin/anima"
    let ba_check = exec("test -f " + bin_anima + " && echo 1 || echo 0").trim()
    if ba_check == "1" {
        pass = pass + 1
        details.push("T4: bin/anima top-level present")
    } else {
        fail = fail + 1
        details.push("T4: bin/anima MISSING")
    }

    println("")
    println("── selftest details ──")
    let mut k = 0
    while k < len(details) {
        println("  " + details[k])
        k = k + 1
    }
    println("")
    println("pass: " + str(pass) + "  fail: " + str(fail))
    if fail == 0 {
        println("verdict: DISPATCHER_SELFTEST_PASS ✓")
        return 0
    }
    println("verdict: DISPATCHER_SELFTEST_FAIL ✗")
    return 1
}

// ─── pending-stub honest emit ────────────────────────────────────────────
fn _emit_pending(verb: string, noun: string, kind: string) -> int {
    println("── eeg_core honest C3 (raw#10) ──")
    println("schema: " + SCHEMA)
    println("verb: " + verb)
    println("noun: " + noun)
    println("status: NOT_YET_LANDED")
    println("kind: " + kind)
    println("verdict: PENDING_MIGRATION")
    eprintln("reason: not-yet-landed: " + kind + " requires module migration")
    eprintln("fix: track in design/eeg_core_dispatcher_design_2026_04_28.md migration table")
    return 4
}

// ─── main ───────────────────────────────────────────────────────────────
fn main() {
    let av = _flags_only_argv()

    if len(av) == 0 {
        _emit_trailer(
            "missing-verb",
            "no verb provided",
            "1) hexa run anima-eeg-core/tool/eeg_core.hexa list  2) --help"
        )
        _print_usage()
        exit(2)
    }

    let verb = av[0]

    if verb == "--help" || verb == "-h" || verb == "help" {
        _print_usage()
        exit(0)
    }

    if verb == "list" {
        _print_list()
        exit(0)
    }

    if verb == "selftest" {
        let rc = _run_selftest()
        exit(rc)
    }

    // verbs without a noun: gate-all, gate-berger, gate-rms, gate-pe, gate-hjorth
    let noun_verbs_solo = ["gate-all", "gate", "gate-berger", "gate-rms", "gate-pe", "gate-hjorth"]
    let mut is_solo = false
    let mut s = 0
    while s < len(noun_verbs_solo) {
        if noun_verbs_solo[s] == verb { is_solo = true }
        s = s + 1
    }

    let mut noun = ""
    let mut fwd_start = 1
    if !is_solo {
        if len(av) < 2 {
            _emit_trailer(
                "missing-noun",
                "verb '" + verb + "' requires a noun",
                "1) hexa run anima-eeg-core/tool/eeg_core.hexa list  2) --help"
            )
            _print_usage()
            exit(2)
        }
        noun = av[1]
        fwd_start = 2
    }

    let backend = _resolve_backend(verb, noun)
    if backend == "" {
        _emit_trailer(
            "unknown-subcommand",
            "no route for verb='" + verb + "' noun='" + noun + "'",
            "1) hexa run anima-eeg-core/tool/eeg_core.hexa list  2) --help"
        )
        _print_usage()
        exit(2)
    }

    // pending stub → emit honest NOT_YET_LANDED
    if backend.starts_with("pending:") {
        let kind = backend.substring(8, len(backend))
        let rc = _emit_pending(verb, noun, kind)
        exit(rc)
    }

    // landed or legacy — strip prefix and forward
    let mut backend_path = backend
    if backend.starts_with("legacy:") {
        backend_path = backend.substring(7, len(backend))
    }

    let mut fwd = []
    let mut k = fwd_start
    while k < len(av) { fwd.push(av[k]); k = k + 1 }

    let rc = _run_backend(backend_path, fwd)

    println("──")
    println("schema: " + SCHEMA)
    println("verb: " + verb)
    if noun != "" { println("noun: " + noun) }
    println("backend: " + backend_path)
    println("exit_code: " + str(rc))
    if rc == 0 {
        println("verdict: BACKEND_PASS ✓")
    } else {
        println("verdict: BACKEND_FAIL ✗ rc=" + str(rc))
    }
    exit(rc)
}
