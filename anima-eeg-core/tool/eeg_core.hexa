// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/eeg_core.hexa — UNIFIED EEG dispatcher (super-set of
//                                       eeg_setup.hexa + clm-eeg + paradigms)
//
//  raw#9 hexa-only · raw#10 honest C3 · raw#12 frozen · raw#37 transient
//  raw#65 idempotent · raw#82 darwin-native · raw#91 honest · own5
//
//  PURPOSE
//    Single canonical entry point (anima/bin/eeg) for ALL anima-eeg tooling.
//    Dispatches to:
//      _gates/      4 validity gates (berger, rms, pe, hjorth)
//      _metrics/    metric kernels (lz76, gamma_theta, ...)
//      _paradigms/  recording paradigms (resting, daily-life, sleep, ...)
//      _hw/         hardware helpers (board, impedance, electrode adjust)
//      _integrations/ claude-cli, wearable
//      _ml/         autoencoder, token cyborg
//      _artifact/   environmental EMI / artifact detectors
//      pipeline     gate→metric→audit composite recipes
//
//    raw#10 honest C3: this is a DISPATCHER. Many subcommands wrap legacy
//    tools (anima-eeg/, anima-clm-eeg/) until module migration lands. Each
//    subcommand records its backend below — if backend == "":pending, the
//    subcommand emits a NOT_YET_LANDED honest verdict instead of pretending.
//
//  USAGE
//    hexa run anima-eeg-core/tool/eeg_core.hexa <verb> [<noun>] [flags]
//
//    eeg_core list                                 ─ enumerate all subcommands
//    eeg_core selftest                             ─ run integration test
//    eeg_core --help                               ─ this help
//
//    eeg_core gate --gate <names> --input <npy>    ─ run subset of gates
//    eeg_core gate-all --input <npy>               ─ all 4 gates composite
//    eeg_core gate-all --selftest-mode <kind>      ─ selftest preset
//
//    eeg_core metric <name> --input <npy>          ─ single metric
//    eeg_core metric all --input <npy>             ─ all metrics
//
//    eeg_core pipeline standard --input <npy>     ─ gate + metrics + audit
//    eeg_core pipeline daily-life --input <npy>   ─ DLE recipe
//
//    eeg_core record resting --duration 60        ─ paradigm record
//    eeg_core record daily-life --duration 300
//    eeg_core record sleep --duration 28800
//
//    eeg_core hardware health [--selftest]        ─ board_health_check
//    eeg_core hardware impedance [--check]        ─ impedance_check
//    eeg_core hardware adjust                     ─ electrode_adjustment_helper
//
//    eeg_core artifact detect-all --input <npy>   ─ 7-detector composite verdict
//    eeg_core artifact clean --input <npy>        ─ meta + suppressor cleaning chain
//    eeg_core artifact {env-emi|blink|motion|emg|ecg|ref-drift|aging} --input <npy>
//                                                 ─ individual detectors
//
//    eeg_core integrate claude-cli --cli-jsonl P  ─ claude-cli correlation
//    eeg_core integrate wearable --source apple --in <xml>
//
//    eeg_core ml anomaly --input <npy>            ─ autoencoder
//    eeg_core ml token-cyborg --input <npy>       ─ tokenizer
//
//  @resolver-bypass(reason="darwin-native: backends require host USB + .venv-eeg.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA = "anima-eeg-core/eeg_core/1"
let CORE_ROOT = "anima-eeg-core/tool/modules"

// ─── raw#82-style stderr trailer ─────────────────────────────────────────
fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

// ─── streaming exec — forwards backend stdout line-by-line ──────────────
//
// raw#10 honest: hexa runtime exposes 3 exec APIs:
//   exec(cmd) -> string         — captures stdout, no rc
//   exec_with_status(cmd) -> [stdout, rc]  — capture + rc
//   exec_stream(cmd, cb) -> int — line-by-line cb (interp may not have it)
//
// We prefer exec_with_status for portability — buffers backend output and
// emits at end. Future enhancement: try exec_stream first, fall back on
// undefined-function. For now the simpler form unblocks all routes.
fn _run_backend(backend_path: string, fwd: array) -> int {
    let mut cmd = _hexa_bin() + " run " + backend_path
    let mut i = 0
    while i < len(fwd) {
        cmd = cmd + " " + _sh_quote(fwd[i])
        i = i + 1
    }
    eprintln("[eeg_core] cmd=" + cmd)
    let r = exec_with_status(cmd)
    let out = to_string(r[0])
    let rc  = to_int(r[1])
    print(out)
    return rc
}

// ─── argv normalizer ─────────────────────────────────────────────────────
//
// raw#10 honest: argv() forms vary by hexa launch path:
//   1. `hexa.real run X.hexa <args>` → av starts with binary path, then "run",
//      then path/X.hexa, then user args.
//   2. AOT `./X.hexa/exe <args>` → av starts with "/...exe", then user args.
//   3. Direct hexa run via shell wrapper → may interleave.
// We strip leading prefix tokens until we hit a non-path, non-keyword token.
fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        // path-like
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        // hexa runtime keywords that may appear in argv before user verb
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a == "build" { is_prefix = true } }
        // hexa.real / hexa binary path itself (any path containing "hexa")
        if !is_prefix {
            if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true }
        }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

// ─── subcommand routing — explicit table (raw#10 honest mapping) ────────
//
// Each route entry is "verb[/noun] => backend_path|legacy:tool_path|pending".
// The dispatcher resolves verb+noun and forwards remaining args verbatim.
//
// Status legend:
//   landed   : module under anima-eeg-core/tool/modules/ — call directly
//   legacy   : wraps anima-eeg/ or anima-clm-eeg/ tool — same behaviour, shimmed
//   pending  : module migration not yet complete — emit NOT_YET_LANDED
//
// Migration plan: legacy → landed module-by-module in subsequent cycles.

fn _resolve_backend(verb: string, noun: string) -> string {
    // ── gates (Phase 2 LANDED) ───────────────────────────────────────────
    if verb == "gate-all" { return CORE_ROOT + "/_gates/composite_gate.hexa" }
    if verb == "gate" {
        // single-gate mode resolved by --gate flag at call site → composite
        // already supports per-gate selftest; for now route to composite.
        return CORE_ROOT + "/_gates/composite_gate.hexa"
    }
    if verb == "gate-berger"  { return CORE_ROOT + "/_gates/berger_alpha.hexa" }
    if verb == "gate-rms"     { return CORE_ROOT + "/_gates/rms_band.hexa" }
    if verb == "gate-pe"      { return CORE_ROOT + "/_gates/pe_saturation.hexa" }
    if verb == "gate-hjorth"  { return CORE_ROOT + "/_gates/hjorth_band.hexa" }

    // ── metrics (Phase 3 LANDED — _metrics/ wrappers; raw#18 self-host) ─
    //   batch 1 (2026-04-28): lz76 / pe / hjorth / gamma_theta — WRAP frozen legacy
    //   batch 2 (2026-04-29): alpha_coherence / alpha_phase_plv / dmn_coherence
    //                         / frontal_asymmetry — PORT shared scipy helper.
    //                         raw#10 honest C3: batch 2 spec'd as 6, landed 4.
    //   batch 3 (2026-04-29): spectral_entropy + change_points — PORT shared
    //                         scipy helper (P1 follow-up to batch 2 closure).
    if verb == "metric" {
        if noun == "lz76"               { return CORE_ROOT + "/_metrics/lz76.hexa" }
        if noun == "pe"                 { return CORE_ROOT + "/_metrics/permutation_entropy.hexa" }
        if noun == "hjorth"             { return CORE_ROOT + "/_metrics/hjorth.hexa" }
        if noun == "gamma_theta"        { return CORE_ROOT + "/_metrics/gamma_theta.hexa" }
        if noun == "gamma-theta"        { return CORE_ROOT + "/_metrics/gamma_theta.hexa" }
        if noun == "alpha_coherence"    { return CORE_ROOT + "/_metrics/alpha_coherence.hexa" }
        if noun == "alpha-coherence"    { return CORE_ROOT + "/_metrics/alpha_coherence.hexa" }
        if noun == "alpha_phase_plv"    { return CORE_ROOT + "/_metrics/alpha_phase_plv.hexa" }
        if noun == "alpha-phase-plv"    { return CORE_ROOT + "/_metrics/alpha_phase_plv.hexa" }
        if noun == "alpha-plv"          { return CORE_ROOT + "/_metrics/alpha_phase_plv.hexa" }
        if noun == "dmn_coherence"      { return CORE_ROOT + "/_metrics/dmn_coherence.hexa" }
        if noun == "dmn-coherence"      { return CORE_ROOT + "/_metrics/dmn_coherence.hexa" }
        if noun == "frontal_asymmetry"  { return CORE_ROOT + "/_metrics/frontal_asymmetry.hexa" }
        if noun == "frontal-asymmetry"  { return CORE_ROOT + "/_metrics/frontal_asymmetry.hexa" }
        if noun == "spectral_entropy"   { return CORE_ROOT + "/_metrics/spectral_entropy.hexa" }
        if noun == "spectral-entropy"   { return CORE_ROOT + "/_metrics/spectral_entropy.hexa" }
        if noun == "spec-entropy"       { return CORE_ROOT + "/_metrics/spectral_entropy.hexa" }
        if noun == "change_points"      { return CORE_ROOT + "/_metrics/change_points.hexa" }
        if noun == "change-points"      { return CORE_ROOT + "/_metrics/change_points.hexa" }
        if noun == "cp"                 { return CORE_ROOT + "/_metrics/change_points.hexa" }
        if noun == "berger"             { return "legacy:anima-clm-eeg/tool/clm_eeg_berger_sanity.hexa" }
        if noun == "all"                { return "pending:metric_all_dispatcher" }
    }

    // ── pipelines (Phase 4 PENDING — composite recipes) ─────────────────
    if verb == "pipeline" {
        if noun == "standard"   { return "pending:pipeline_standard" }
        if noun == "daily-life" { return "legacy:anima-eeg/tool/eeg_daily_life_verifier.hexa" }
        if noun == "feedback"   { return "legacy:anima-eeg/tool/eeg_feedback_loop.hexa" }
    }

    // ── recording paradigms (Phase 4 batch 1 LANDED for resting/daily-life) ─
    if verb == "record" {
        if noun == "resting"    { return CORE_ROOT + "/_paradigms/resting_baseline.hexa" }
        if noun == "daily-life" { return CORE_ROOT + "/_paradigms/daily_life.hexa" }
        if noun == "sleep"      { return "legacy:anima-eeg/tool/sleep_tracker.hexa" }
        if noun == "long"       { return "legacy:anima-eeg/tool/long_duration_recorder.hexa" }
        if noun == "longitudinal" { return "legacy:anima-eeg/tool/longitudinal_session_recorder.hexa" }
        if noun == "pre-post"   { return "legacy:anima-eeg/tool/pre_post_task_recorder.hexa" }
    }

    // ── paradigm verb namespace (Phase 4 batch 1 LANDED — P300 family) ──
    //   visual-p300 / auditory-p300 are stimulus-presentation paradigms,
    //   distinct from passive-record paradigms (resting / daily-life). They
    //   warrant their own verb namespace per design/anima_eeg_core_module_api.md.
    if verb == "paradigm" {
        if noun == "resting"          { return CORE_ROOT + "/_paradigms/resting_baseline.hexa" }
        if noun == "resting-baseline" { return CORE_ROOT + "/_paradigms/resting_baseline.hexa" }
        if noun == "daily-life"       { return CORE_ROOT + "/_paradigms/daily_life.hexa" }
        if noun == "visual-p300"      { return CORE_ROOT + "/_paradigms/visual_p300.hexa" }
        if noun == "auditory-p300"    { return CORE_ROOT + "/_paradigms/auditory_p300.hexa" }
    }

    // ── hardware helpers (Phase 5 LANDED for 5 core ops, legacy for rest) ─
    //   board-health / impedance / adjust / headplot / record are the
    //   _hw/ Phase 5 module wrappers; they expose kv-block + raw#71
    //   falsifier triad to the dispatcher. The `hw <op>` namespace is the
    //   canonical short alias; `hardware <op>` is preserved for backward
    //   compat. raw#42: hardware verbs always run on Mac local USB.
    if verb == "hardware" || verb == "hw" {
        if noun == "health"             { return CORE_ROOT + "/_hw/board_health.hexa" }
        if noun == "board-health"       { return CORE_ROOT + "/_hw/board_health.hexa" }
        if noun == "board_health"       { return CORE_ROOT + "/_hw/board_health.hexa" }
        if noun == "impedance"          { return CORE_ROOT + "/_hw/impedance.hexa" }
        if noun == "adjust"             { return CORE_ROOT + "/_hw/adjustment.hexa" }
        if noun == "adjustment"         { return CORE_ROOT + "/_hw/adjustment.hexa" }
        if noun == "headplot"           { return CORE_ROOT + "/_hw/headplot.hexa" }
        if noun == "record"             { return CORE_ROOT + "/_hw/recorder.hexa" }
        if noun == "recorder"           { return CORE_ROOT + "/_hw/recorder.hexa" }
        // legacy fallthroughs (not yet Phase 5 wrapped)
        if noun == "impedance_validate" { return "legacy:anima-eeg/impedance_real_hardware_validation.hexa" }
        if noun == "rich"               { return "legacy:anima-eeg/electrode_helper_rich.hexa" }
        if noun == "full"               { return "legacy:anima-eeg/full_helmet_view.hexa" }
        if noun == "ftdi-fix"           { return "legacy:anima-eeg/eeg_ftdi_latency_fix.hexa" }
        if noun == "brainflow-sanity"   { return "legacy:anima-eeg/eeg_brainflow_sanity.hexa" }
    }

    // ── artifact detection (Phase artifact agent LANDED — 9 modules) ────
    //   detect-all  → meta classifier composite verdict (7 detectors voted)
    //   clean       → ai_cleaning_pipeline (meta → suppressors → re-meta)
    //   per-detector individual modules: env-emi, blink, motion, emg, ecg,
    //   ref-drift, aging, meta (alias of detect-all)
    if verb == "artifact" {
        if noun == "detect-all"          { return CORE_ROOT + "/_artifact/artifact_meta_classifier.hexa" }
        if noun == "meta"                { return CORE_ROOT + "/_artifact/artifact_meta_classifier.hexa" }
        if noun == "clean"               { return CORE_ROOT + "/_artifact/ai_cleaning_pipeline.hexa" }
        if noun == "env-emi"             { return CORE_ROOT + "/_artifact/environmental_emi_classifier.hexa" }
        if noun == "environmental-emi"   { return CORE_ROOT + "/_artifact/environmental_emi_classifier.hexa" }
        if noun == "blink"               { return CORE_ROOT + "/_artifact/eye_blink_detector.hexa" }
        if noun == "motion"              { return CORE_ROOT + "/_artifact/motion_artifact_detector.hexa" }
        if noun == "emg"                 { return CORE_ROOT + "/_artifact/emg_muscle_detector.hexa" }
        if noun == "ecg"                 { return CORE_ROOT + "/_artifact/ecg_heart_artifact_detector.hexa" }
        if noun == "ref-drift"           { return CORE_ROOT + "/_artifact/reference_drift_detector.hexa" }
        if noun == "aging"               { return CORE_ROOT + "/_artifact/electrode_aging_classifier.hexa" }
    }

    // ── integrations (legacy clm-eeg / anima-eeg wrappers) ──────────────
    if verb == "integrate" {
        if noun == "claude-cli"      { return "legacy:anima-clm-eeg/tool/eeg_claude_cli_correlator.hexa" }
        if noun == "claude-cli-long" { return "legacy:anima-clm-eeg/tool/eeg_claude_cli_longitudinal_correlator.hexa" }
        if noun == "wearable"        { return "legacy:anima-eeg/tool/wearable_health_integrator.hexa" }
        if noun == "mobile"          { return "legacy:anima-eeg/tool/mobile_eeg_integrator.hexa" }
        if noun == "cardiac"         { return "legacy:anima-eeg/tool/cardiac_eeg_integrator.hexa" }
        if noun == "eye-tracker"     { return "legacy:anima-eeg/tool/eye_tracker_webcam.hexa" }
    }

    // ── integration verb namespace (Phase 6 LANDED — _integrations/ batch1) ─
    //   Cross-module integrations where multiple metrics + a paradigm combine
    //   into a higher-level verdict. 7 modules: clm_eeg_p1/p3, berger_validate,
    //   artifact_pipeline, rsn_validate, cyborg_token_emit, multi_subject_
    //   aggregate. raw#10 honest C3: live mode is NOT_YET_LANDED for all 7
    //   pending real-EEG ingest / .venv-eeg / D+1 hardware arrival.
    if verb == "integration" {
        if noun == "clm-eeg-p1"        { return CORE_ROOT + "/_integrations/clm_eeg_p1.hexa" }
        if noun == "clm_eeg_p1"        { return CORE_ROOT + "/_integrations/clm_eeg_p1.hexa" }
        if noun == "p1"                { return CORE_ROOT + "/_integrations/clm_eeg_p1.hexa" }
        if noun == "clm-eeg-p3"        { return CORE_ROOT + "/_integrations/clm_eeg_p3.hexa" }
        if noun == "clm_eeg_p3"        { return CORE_ROOT + "/_integrations/clm_eeg_p3.hexa" }
        if noun == "p3"                { return CORE_ROOT + "/_integrations/clm_eeg_p3.hexa" }
        if noun == "berger"            { return CORE_ROOT + "/_integrations/berger_validate.hexa" }
        if noun == "berger-validate"   { return CORE_ROOT + "/_integrations/berger_validate.hexa" }
        if noun == "artifact-pipeline" { return CORE_ROOT + "/_integrations/artifact_pipeline.hexa" }
        if noun == "artifact_pipeline" { return CORE_ROOT + "/_integrations/artifact_pipeline.hexa" }
        if noun == "rsn"               { return CORE_ROOT + "/_integrations/rsn_validate.hexa" }
        if noun == "rsn-validate"      { return CORE_ROOT + "/_integrations/rsn_validate.hexa" }
        if noun == "cyborg-token"      { return CORE_ROOT + "/_integrations/cyborg_token_emit.hexa" }
        if noun == "cyborg_token_emit" { return CORE_ROOT + "/_integrations/cyborg_token_emit.hexa" }
        if noun == "multi-subject"     { return CORE_ROOT + "/_integrations/multi_subject_aggregate.hexa" }
        if noun == "multi_subject_aggregate" { return CORE_ROOT + "/_integrations/multi_subject_aggregate.hexa" }
        if noun == "cohort"            { return CORE_ROOT + "/_integrations/multi_subject_aggregate.hexa" }
    }

    // ── ML modules (legacy clm-eeg) ──────────────────────────────────────
    if verb == "ml" {
        if noun == "anomaly"      { return "legacy:anima-clm-eeg/tool/eeg_anomaly_autoencoder.hexa" }
        if noun == "token-cyborg" { return "legacy:anima-clm-eeg/tool/eeg_to_token_cyborg.hexa" }
    }

    // ── analyze / network / behaviour (legacy) ──────────────────────────
    if verb == "analyze" {
        if noun == "rsn"             { return "legacy:anima-eeg/tool/resting_state_network_analyzer.hexa" }
        if noun == "behavioral"      { return "legacy:anima-eeg/tool/behavioral_correlates_logger.hexa" }
        if noun == "daily-life-verify" { return "legacy:anima-eeg/tool/eeg_daily_life_verifier.hexa" }
    }

    return ""
}

// ─── help text ──────────────────────────────────────────────────────────
fn _print_usage() {
    eprintln("usage: hexa run anima-eeg-core/tool/eeg_core.hexa <verb> [noun] [flags]")
    eprintln("")
    eprintln("verbs and nouns (raw#10 honest C3 status):")
    eprintln("")
    eprintln("  list                                   enumerate all subcommands")
    eprintln("  selftest                               run integration test")
    eprintln("")
    eprintln("  gate-all       [--input <npy>]         landed: 4-gate composite")
    eprintln("  gate-{berger,rms,pe,hjorth}            landed: single gate")
    eprintln("")
    eprintln("  metric <name>  --input <npy>           landed batch 1: lz76|pe|hjorth|gamma_theta")
    eprintln("                                         landed batch 2: alpha-coherence|alpha-plv|")
    eprintln("                                                         dmn-coherence|frontal-asymmetry")
    eprintln("                                         landed batch 3: spectral-entropy|change-points")
    eprintln("                                         legacy: berger     pending: all")
    eprintln("")
    eprintln("  pipeline standard   --input <npy>      pending")
    eprintln("  pipeline daily-life --input <npy>      legacy")
    eprintln("  pipeline feedback   --input <npy>      legacy")
    eprintln("")
    eprintln("  record {resting|daily-life|sleep|long|longitudinal|pre-post}")
    eprintln("                                         resting/daily-life landed; rest legacy")
    eprintln("")
    eprintln("  paradigm {resting|resting-baseline|daily-life|visual-p300|auditory-p300}")
    eprintln("                                         landed: 4 paradigms (selftest+live-NYL)")
    eprintln("")
    eprintln("  hw|hardware {health|impedance|adjust|headplot|record}")
    eprintln("                                         landed: Phase 5 _hw/ 5 modules")
    eprintln("  hw|hardware {impedance_validate|rich|full|ftdi-fix|brainflow-sanity}")
    eprintln("                                         legacy anima-eeg/ wrappers")
