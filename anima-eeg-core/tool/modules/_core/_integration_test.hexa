// anima-eeg-core/tool/modules/_core/_integration_test.hexa
// raw#9 hexa-only · raw#65 idempotent
//
// PURPOSE
//   Phase 1 integration test — exercises all 5 _core modules in a mini pipeline:
//     1. npy_loader     → load synthetic .npy + emit sha256
//     2. filter_pipeline → notch+bandpass to a new .npy
//     3. (re-load filtered)
//     4. falsifier_runner → eval metrics against bound specs
//     5. jsonl_audit     → emit audit row
//     6. chflags_lock    → lock the audit ledger (briefly)
//
//   raw#37 transient: writes are under /tmp.
//
// CLI
//   hexa run _integration_test.hexa
//   hexa run _integration_test.hexa --selftest    (alias)

let TMP_DIR     = "/tmp/anima_eeg_core_phase1_integration"
let RAW_NPY     = "/tmp/anima_eeg_core_phase1_integration/raw.npy"
let FLT_NPY     = "/tmp/anima_eeg_core_phase1_integration/filtered.npy"
let LEDGER_PATH = "/tmp/anima_eeg_core_phase1_integration/integration_audit.jsonl"
let HELPER_PATH = "/tmp/anima_eeg_core_phase1_integration_synth.py"
let VENV_PYTHON = ".venv-eeg/bin/python"

// ─── inline copies of module APIs (Phase 1 module loading workaround) ──
// raw#10 honest: hexa-strict has no `import` for sibling .hexa modules in this
// codebase pattern, so each driver re-declares thin call-shims that shell out
// to the module .hexa via `hexa run`. This mirrors the repo-wide pattern of
// invoking modules as scripts.

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _hexa_run(rel_script: string, argstr: string) -> array {
    let cmd = "/Users/ghost/core/hexa-lang/hexa.real run anima-eeg-core/tool/modules/_core/" + rel_script + " " + argstr
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ─── synthesize raw .npy (writes 16ch raw with 60Hz mains contamination) ──

fn _write_synth_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("import numpy as np, os, sys\n")
    parts.push("out = sys.argv[1]\n")
    parts.push("os.makedirs(os.path.dirname(out), exist_ok=True)\n")
    parts.push("n_ch = 16; fs = 125.0; cols = int(fs*4)\n")
    parts.push("rng = np.random.default_rng(20260428)\n")
    parts.push("t = np.arange(cols)/fs\n")
    parts.push("# 32-row layout (BrainFlow Cyton-Daisy); rows 1..16 = EEG\n")
    parts.push("data = np.zeros((32, cols), dtype=np.float32)\n")
    parts.push("for k in range(n_ch):\n")
    parts.push("    data[k+1] = (np.sin(2*np.pi*10*t) + 0.8*np.sin(2*np.pi*60*t) + 0.3*rng.standard_normal(cols))\n")
    parts.push("np.save(out, data)\n")
    parts.push("# meta sidecar\n")
    parts.push("import json\n")
    parts.push("meta = {'schema':'anima-eeg/eeg_recorder/1','task':'integration_synth',\n")
    parts.push("        'session_ts':'20260428T000000Z','sample_rate':fs,\n")
    parts.push("        'eeg_indices':list(range(1,17)),'rows':32,'cols':cols,\n")
    parts.push("        'tier':'DEGRADED'}\n")
    parts.push("with open(out + '.meta.json','w') as f: json.dump(meta, f)\n")
    parts.push("print('synth_ok=true')\n")
    write_file(HELPER_PATH, parts.join(""))
}

fn _synth_raw() -> bool {
    _write_synth_helper()
    let cmd = VENV_PYTHON + " " + HELPER_PATH + " " + _sh_quote(RAW_NPY)
    let r = exec_with_status(cmd)
    return r[1] == 0
}

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn main() {
    println("== Phase 1 _core/ integration mini-pipeline ==")
    let mut pass = 0
    let mut fail = 0

    // setup
    exec("mkdir -p " + TMP_DIR)
    exec("rm -f " + LEDGER_PATH)

    // step 0: synthesize raw.npy
    let synth_ok = _synth_raw()
    let s0 = assert_true(synth_ok, "synth raw.npy generated")
    if s0 { pass = pass + 1 } else { fail = fail + 1; exit(1) }

    // step 1: npy_loader → emit sha256 + n_channels
    println("[step 1] npy_loader --load")
    let load_r = _hexa_run("npy_loader.hexa", "--load " + _sh_quote(RAW_NPY))
    println(load_r[0])
    let s1 = assert_true(load_r[1] == 0, "npy_loader rc=0")
    if s1 { pass = pass + 1 } else { fail = fail + 1 }
    let sha_in    = _kv_lookup(load_r[0], "sha256")
    let n_ch_in   = _kv_lookup(load_r[0], "n_channels")
    let n_smp_in  = _kv_lookup(load_r[0], "n_samples")
    let s1b = assert_true(n_ch_in == "16", "16 EEG channels extracted (got " + n_ch_in + ")")
    if s1b { pass = pass + 1 } else { fail = fail + 1 }
    let s1c = assert_true(sha_in.len() == 64, "sha256 emitted")
    if s1c { pass = pass + 1 } else { fail = fail + 1 }

    // step 2: filter_pipeline --apply
    // NOTE: filter must operate on already-extracted EEG (16-row), so write
    // an intermediate via the same helper synth path. For mini-pipeline we
    // re-use raw.npy directly (32-row). filter_pipeline operates row-wise on
    // whatever shape it receives, so 32-row in → 32-row out (with notch+bp on
    // all rows). Honest scope: full-pipeline EEG-extract+filter chaining is
    // a Phase 2 cycle — here we just verify modules wire together.
    println("[step 2] filter_pipeline --apply")
    let mut farg = "--apply --in " + _sh_quote(RAW_NPY) + " --out " + _sh_quote(FLT_NPY)
    farg = farg + " --fs 125 --notch 60 --lo 0.5 --hi 50"
    let flt_r = _hexa_run("filter_pipeline.hexa", farg)
    println(flt_r[0])
    let s2 = assert_true(flt_r[1] == 0, "filter_pipeline rc=0")
    if s2 { pass = pass + 1 } else { fail = fail + 1 }
    let sha_out  = _kv_lookup(flt_r[0], "sha256_out")
    let rms_in   = _kv_lookup(flt_r[0], "rms_before")
    let rms_out  = _kv_lookup(flt_r[0], "rms_after")
    let s2b = assert_true(sha_in != sha_out, "filtered sha256 differs from raw")
    if s2b { pass = pass + 1 } else { fail = fail + 1 }

    // step 3: falsifier_runner over collected metrics
    println("[step 3] falsifier_runner --eval")
    let metrics = "n_channels=" + n_ch_in + ",n_samples=" + n_smp_in + ",rms_after=" + rms_out
    let specs = "id=F01,metric=n_channels,direction=lt,threshold=16|id=F02,metric=n_samples,direction=lt,threshold=125|id=F03,metric=rms_after,direction=gt,threshold=10.0"
    let fr_r = _hexa_run("falsifier_runner.hexa", "--eval --metrics " + _sh_quote(metrics) + " --specs " + _sh_quote(specs))
    println(fr_r[0])
    let s3 = assert_true(fr_r[1] == 0, "falsifier_runner rc=0 (no falsifiers fired)")
    if s3 { pass = pass + 1 } else { fail = fail + 1 }
    let verdict = _kv_lookup(fr_r[0], "verdict")
    let s3b = assert_true(verdict == "PASS", "falsifier verdict=PASS")
    if s3b { pass = pass + 1 } else { fail = fail + 1 }

    // step 4: jsonl_audit emit
    println("[step 4] jsonl_audit --emit")
    let row = "ts=0,tool=_core/integration,mode=mini_pipeline,input=raw.npy,sha256=" + sha_in + ",n_channels=" + n_ch_in + ",rms_before=" + rms_in + ",rms_after=" + rms_out + ",verdict=" + verdict
    let ja_r = _hexa_run("jsonl_audit.hexa", "--emit --ledger " + _sh_quote(LEDGER_PATH) + " --row " + _sh_quote(row))
    println(ja_r[0])
    let s4 = assert_true(ja_r[1] == 0, "jsonl_audit emit rc=0")
    if s4 { pass = pass + 1 } else { fail = fail + 1 }

    // count
    let cnt_r = _hexa_run("jsonl_audit.hexa", "--count --ledger " + _sh_quote(LEDGER_PATH))
    println(cnt_r[0])
    let cnt = _kv_lookup(cnt_r[0], "rows")
    let s4b = assert_true(cnt == "1", "ledger has 1 row (got " + cnt + ")")
    if s4b { pass = pass + 1 } else { fail = fail + 1 }

    // step 5: chflags_lock — lock then unlock the audit ledger
    println("[step 5] chflags_lock --lock then --unlock")
    let lock_r = _hexa_run("chflags_lock.hexa", "--lock " + _sh_quote(LEDGER_PATH))
    println(lock_r[0])
    let s5 = assert_true(lock_r[1] == 0, "lock rc=0")
    if s5 { pass = pass + 1 } else { fail = fail + 1 }
    // verify uchg
    let stat_r = _hexa_run("chflags_lock.hexa", "--status " + _sh_quote(LEDGER_PATH))
    println(stat_r[0])
    let is_uchg = _kv_lookup(stat_r[0], "is_uchg")
    let s5b = assert_true(is_uchg == "true", "ledger is_uchg=true after lock")
    if s5b { pass = pass + 1 } else { fail = fail + 1 }
    // unlock for cleanup
    let unl_r = _hexa_run("chflags_lock.hexa", "--unlock " + _sh_quote(LEDGER_PATH))
    let s5c = assert_true(unl_r[1] == 0, "unlock rc=0")
    if s5c { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Integration Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL")
    if fail != 0 {
        println("integration=fail")
        exit(1)
    }
    println("integration=ok")
    println("schema=anima-eeg-core/_core/_integration_test/1")
    println("modules_exercised=npy_loader,filter_pipeline,jsonl_audit,falsifier_runner,chflags_lock")
    println("verdict=PASS")
    exit(0)
}
