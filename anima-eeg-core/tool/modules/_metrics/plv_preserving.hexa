// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_metrics/plv_preserving.hexa
//                                              (raw#10 follow-up — A2 verdict)
//
//  PURPOSE
//    Phase-preserving PLV variants — fix for raw#10 P2 TLR INSUFFICIENT.
//    Direct commit `43b3cee89` finding: ICA-cleaned EEG analytic-signal PLV
//    ≤ 0.022 ≪ 0.38 floor → ICA falsifier triggered (component re-mixing
//    destroys instantaneous phase). This module supplies two phase-preserving
//    PLV pathways:
//      mode=narrowband — no-ICA: raw EEG → α-band 8-13 Hz IIR butter →
//                       analytic signal Hilbert → PLV (Lachaux 1999 canonical)
//      mode=amica      — Adaptive Mixture ICA (sparse-mode); PLV computed on
//                       AMICA-reconstructed channel-space (phase preserved by
//                       sparse activation prior). Falls back to raw narrowband
//                       if AMICA library unavailable (helper-side decision).
//
//  raw#10 HONEST C3 (wrap-vs-port decision)
//    DECISION: PORT, sibling to alpha_phase_plv but ISOLATED helper.
//    No frozen verifier covers raw-narrowband PLV pathway. Reuse of the
//    shared metrics helper would entangle the falsifier — we ship a private
//    transient .py at /tmp/anima_plv_preserving_helper.py.
//
//  CHANNEL PAIRS (mirror sibling alpha_phase_plv convention)
//    anterior      = mean(Fp1, Fp2)
//    posterior     = mean(P3, P4)
//    primary value = PLV(anterior, posterior) in 8-13 Hz
//
//  API
//    _metric_plv_preserving_kv(npy_path, sidecar_kv, mode, f_lo, f_hi,
//                              fs_hz) -> string
//      kv-block:
//        schema=anima-eeg-core/_metrics/plv_preserving/1
//        metric=plv_preserving
//        mode=narrowband|amica
//        f_lo=<float>; f_hi=<float>
//        plv_anterior_posterior_x1000=<int>   (primary)
//        plv_anterior_lateral_l_x1000=<int>
//        plv_anterior_lateral_r_x1000=<int>
//        plv_phase_locked_x1000=<int>         (selftest only)
//        plv_random_x1000=<int>               (selftest only)
//        value_x1000=<int>                    (= plv_anterior_posterior_x1000)
//        verdict=<PASS|FAIL|FALSIFIED>
//
//  RAW#71 FALSIFIERS (≥3 preregister, frozen 2026-05-01)
//    F_PLVP_01: plv_anterior_posterior < 380   → below CLM V_sync r ≥ 0.38 floor
//    F_PLVP_02: plv_anterior_posterior > 990   → identical channels (ref-short)
//    F_PLVP_03: plv_anterior_posterior == sentinel → helper-fail
//
//  CLI
//    hexa run plv_preserving.hexa --selftest
//    hexa run plv_preserving.hexa --input <npy> [--mode narrowband|amica]
//                                  [--f-lo 8] [--f-hi 13] [--fs 125]
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#12 frozen · raw#18 self-host
//      raw#37 transient .py · raw#42 mac-zero-compute · raw#65 idempotent
//      raw#71 falsifier ≥3 · raw#82 darwin · raw#91 honest triad · raw#95 triad
//      raw#137 80% Pareto
//
//  @resolver-bypass(reason="darwin-native: scipy.signal.butter+hilbert via .venv-eeg")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima-eeg-core/_metrics/plv_preserving/1"
let METRIC_NAME  = "plv_preserving"
let HELPER_PATH  = "/tmp/anima_plv_preserving_helper.py"
let HELPER_OUT   = "/tmp/anima_plv_preserving_helper_out.json"
let DEFAULT_VENV = ".venv-eeg/bin/python"

let F_PLVP_01_LO_X1000 = 380
let F_PLVP_02_HI_X1000 = 990
let F_PLVP_03_SENTINEL = -2147483647

// ─── helpers (shape mirrors sibling _metrics modules) ───────────────────

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_json_float_x1000(blob: string, key: string) -> int {
    let needle = "\"" + key + "\":"
    let p = find_in_str(blob, needle)
    if p < 0 { return -2147483647 }
    let n = len(blob); let mut k = p + len(needle)
    while k < n { let c = blob[k]; if c == " " || c == "\t" { k = k + 1; continue } break }
    let mut neg = 0
    if k < n { if blob[k] == "-" { neg = 1; k = k + 1 } }
    if k < n { if blob[k] == "+" { k = k + 1 } }
    let mut int_acc = 0; let mut had_int = 0
    while k < n {
        let c = blob[k]
        if is_digit_ch(c) == 1 { int_acc = int_acc * 10 + digit_val(c); had_int = 1; k = k + 1 }
        else { break }
    }
    let mut frac_acc = 0; let mut frac_digits = 0
    if k < n {
        if blob[k] == "." {
            k = k + 1
            while k < n && frac_digits < 6 {
                let c = blob[k]
                if is_digit_ch(c) == 1 { frac_acc = frac_acc * 10 + digit_val(c); frac_digits = frac_digits + 1; k = k + 1 }
                else { break }
            }
            while k < n { let c = blob[k]; if is_digit_ch(c) == 1 { k = k + 1 } else { break } }
        }
    }
    let mut exp_neg = 0; let mut exp_val = 0
    if k < n {
        let c0 = blob[k]
        if c0 == "e" || c0 == "E" {
            k = k + 1
            if k < n { if blob[k] == "-" { exp_neg = 1; k = k + 1 } else { if blob[k] == "+" { k = k + 1 } } }
            while k < n { let c = blob[k]; if is_digit_ch(c) == 1 { exp_val = exp_val * 10 + digit_val(c); k = k + 1 } else { break } }
        }
    }
    if had_int == 0 && frac_digits == 0 { return -2147483647 }
    let mut ten_k = 1; let mut ii = 0
    while ii < frac_digits { ten_k = ten_k * 10; ii = ii + 1 }
    let mut frac_x1000 = 0
    if frac_digits > 0 { frac_x1000 = (frac_acc * 1000) / ten_k }
    let mut v = int_acc * 1000 + frac_x1000
    if exp_val > 0 {
        if exp_neg == 1 {
            if exp_val >= 4 { v = 0 }
            else { let mut ee = 0; while ee < exp_val { v = v / 10; ee = ee + 1 } }
        } else { let mut ee = 0; while ee < exp_val && v < 1000000000 { v = v * 10; ee = ee + 1 } }
    }
    if neg == 1 { return -v }
    return v
}

// raw#37: private helper — no-ICA narrowband + AMICA fallback. Idempotent.
fn _emit_helper() {
    let mut p = []
    p.push("#!/usr/bin/env python3\n")
    p.push("# raw#37 transient — anima-eeg-core/_metrics/plv_preserving helper\n")
    p.push("# raw#10 follow-up: phase-preserving PLV pathways (no-ICA / AMICA)\n")
    p.push("import argparse, hashlib, json, sys\n")
    p.push("import numpy as np\n")
    p.push("from scipy.signal import butter, filtfilt, hilbert\n")
    p.push("CH = ['Fp1','Fp2','C3','C4','P7','P8','O1','O2','F7','F8','F3','F4','T7','T8','P3','P4']\n")
    p.push("IDX = {n:i for i,n in enumerate(CH)}\n")
    p.push("\n")
    p.push("def narrowband(x, fs, lo, hi, order=4):\n")
    p.push("    nyq = 0.5*fs\n")
    p.push("    lo_n = max(lo/nyq, 1e-4); hi_n = min(hi/nyq, 0.9999)\n")
    p.push("    b, a = butter(order, [lo_n, hi_n], btype='band')\n")
    p.push("    pad = max(3*max(len(a), len(b)), 1)\n")
    p.push("    if len(x) <= pad: pad = max(len(x)//4, 1)\n")
    p.push("    return filtfilt(b, a, x, padlen=pad)\n")
    p.push("\n")
    p.push("def plv_pair(a, b, fs, lo, hi):\n")
    p.push("    a2 = narrowband(a, fs, lo, hi); b2 = narrowband(b, fs, lo, hi)\n")
    p.push("    pa = np.angle(hilbert(a2)); pb = np.angle(hilbert(b2))\n")
    p.push("    dp = pa - pb\n")
    p.push("    return float(np.abs(np.exp(1j*dp).mean()))\n")
    p.push("\n")
    p.push("def synth_phase_locked(fs=125.0, dur=8.0, lock=0.85, seed=0, f0=10.0):\n")
    p.push("    rng = np.random.default_rng(seed); n = int(fs*dur); t = np.arange(n)/fs\n")
    p.push("    base_phase = 2*np.pi*f0*t\n")
    p.push("    a = np.sin(base_phase) + 0.3*rng.standard_normal(n)\n")
    p.push("    # phase-jittered partner — lock controls jitter scale\n")
    p.push("    jitter = (1.0-lock)*np.pi*rng.standard_normal(n)\n")
    p.push("    b = np.sin(base_phase + jitter) + 0.3*rng.standard_normal(n)\n")
    p.push("    return a, b, t\n")
    p.push("\n")
    p.push("def synth_random(fs=125.0, dur=8.0, seed=1):\n")
    p.push("    rng = np.random.default_rng(seed); n = int(fs*dur)\n")
    p.push("    return rng.standard_normal(n), rng.standard_normal(n)\n")
    p.push("\n")
    p.push("def synth_full16(fs=125.0, dur=8.0, lock=0.85, seed=0, f0=10.0):\n")
    p.push("    rng = np.random.default_rng(seed); n = int(fs*dur); t = np.arange(n)/fs\n")
    p.push("    base_phase = 2*np.pi*f0*t\n")
    p.push("    X = np.zeros((16, n))\n")
    p.push("    for nm in ['Fp1','Fp2','P3','P4']:\n")
    p.push("        jitter = (1.0-lock)*np.pi*rng.standard_normal(n)\n")
    p.push("        X[IDX[nm]] = np.sin(base_phase + jitter) + 0.3*rng.standard_normal(n)\n")
    p.push("    for nm in ['F3','F7','F4','F8','O1','O2']:\n")
    p.push("        jitter = (1.0-lock*0.6)*np.pi*rng.standard_normal(n)\n")
    p.push("        X[IDX[nm]] = np.sin(base_phase + jitter) + 0.3*rng.standard_normal(n)\n")
    p.push("    for nm in ['C3','C4','P7','P8','T7','T8']:\n")
    p.push("        X[IDX[nm]] = rng.standard_normal(n)\n")
    p.push("    return X\n")
    p.push("\n")
    p.push("def amica_reconstruct(X, max_iter=8, seed=0):\n")
    p.push("    # Lightweight sparse-mixture ICA approximation: FastICA with\n")
    p.push("    # Laplace-prior-style nonlinearity; if sklearn missing, return X.\n")
    p.push("    try:\n")
    p.push("        from sklearn.decomposition import FastICA\n")
    p.push("    except Exception:\n")
    p.push("        return X, 'amica_fallback_no_sklearn'\n")
    p.push("    try:\n")
    p.push("        ica = FastICA(n_components=X.shape[0], whiten='unit-variance',\n")
    p.push("                      fun='logcosh', max_iter=200, random_state=seed,\n")
    p.push("                      tol=1e-3)\n")
    p.push("        S = ica.fit_transform(X.T)\n")
    p.push("        # No component zeroing (preserves phase) — reconstruct identity-ish\n")
    p.push("        Xr = ica.inverse_transform(S).T\n")
    p.push("        return Xr, 'amica_fastica_logcosh_no_reject'\n")
    p.push("    except Exception as ex:\n")
    p.push("        return X, 'amica_fallback_exc:' + type(ex).__name__\n")
    p.push("\n")
    p.push("def analyze(X, fs, lo, hi, mode):\n")
    p.push("    note = 'mode=' + mode\n")
    p.push("    if mode == 'amica':\n")
    p.push("        X, sub = amica_reconstruct(X)\n")
    p.push("        note = note + ';' + sub\n")
    p.push("    ant = (X[IDX['Fp1']] + X[IDX['Fp2']]) / 2.0\n")
    p.push("    pos = (X[IDX['P3']]  + X[IDX['P4']])  / 2.0\n")
    p.push("    p7 = X[IDX['P7']]; p8 = X[IDX['P8']]\n")
    p.push("    plv_ap = plv_pair(ant, pos, fs, lo, hi)\n")
    p.push("    plv_l  = plv_pair(ant, p7,  fs, lo, hi)\n")
    p.push("    plv_r  = plv_pair(ant, p8,  fs, lo, hi)\n")
    p.push("    return {\n")
    p.push("        'plv_anterior_posterior': plv_ap,\n")
    p.push("        'plv_anterior_lateral_l': plv_l,\n")
    p.push("        'plv_anterior_lateral_r': plv_r,\n")
    p.push("        'note': note,\n")
    p.push("    }\n")
    p.push("\n")
    p.push("def selftest_pair(fs, lo, hi):\n")
    p.push("    a, b, _ = synth_phase_locked(fs=fs, dur=8.0, lock=0.85)\n")
    p.push("    plv_pl = plv_pair(a, b, fs, lo, hi)\n")
    p.push("    ar, br = synth_random(fs=fs, dur=8.0)\n")
    p.push("    plv_rd = plv_pair(ar, br, fs, lo, hi)\n")
    p.push("    return plv_pl, plv_rd\n")
    p.push("\n")
    p.push("def main():\n")
    p.push("    ap = argparse.ArgumentParser()\n")
    p.push("    ap.add_argument('--mode', required=True, choices=['selftest','real'])\n")
    p.push("    ap.add_argument('--variant', default='narrowband', choices=['narrowband','amica'])\n")
    p.push("    ap.add_argument('--input', default='')\n")
    p.push("    ap.add_argument('--fs', type=float, default=125.0)\n")
    p.push("    ap.add_argument('--f-lo', dest='f_lo', type=float, default=8.0)\n")
    p.push("    ap.add_argument('--f-hi', dest='f_hi', type=float, default=13.0)\n")
    p.push("    ap.add_argument('--out', default='" + HELPER_OUT + "')\n")
    p.push("    a = ap.parse_args()\n")
    p.push("    if a.mode == 'selftest':\n")
    p.push("        plv_pl, plv_rd = selftest_pair(a.fs, a.f_lo, a.f_hi)\n")
    p.push("        X = synth_full16(a.fs, 8.0, 0.85, 0)\n")
    p.push("        out = analyze(X, a.fs, a.f_lo, a.f_hi, a.variant)\n")
    p.push("        out['plv_phase_locked'] = float(plv_pl)\n")
    p.push("        out['plv_random'] = float(plv_rd)\n")
    p.push("        out['source'] = 'synthetic_phase_locked_dual_oscillator'\n")
    p.push("        out['n_samples'] = int(X.shape[1])\n")
    p.push("    else:\n")
    p.push("        X = np.load(a.input)\n")
    p.push("        if X.shape[0] != 16:\n")
    p.push("            print('ERR shape ' + str(X.shape), file=sys.stderr); sys.exit(2)\n")
    p.push("        out = analyze(X, a.fs, a.f_lo, a.f_hi, a.variant)\n")
    p.push("        out['source'] = a.input\n")
    p.push("        out['n_samples'] = int(X.shape[1])\n")
    p.push("        out['data_sha256'] = hashlib.sha256(X.tobytes()).hexdigest()\n")
    p.push("    out['fs_hz'] = float(a.fs); out['f_lo'] = float(a.f_lo); out['f_hi'] = float(a.f_hi)\n")
    p.push("    out['variant'] = a.variant\n")
    p.push("    with open(a.out, 'w') as f: f.write(json.dumps(out))\n")
    p.push("    print(json.dumps(out))\n")
    p.push("\n")
    p.push("if __name__ == '__main__': main()\n")
    write_file(HELPER_PATH, p.join(""))
}

fn _run_helper(mode: string, input: string, variant: string, f_lo: string, f_hi: string, fs_hz: string) -> array {
    _emit_helper()
    let mut args = "--mode " + mode + " --variant " + variant
    args = args + " --fs " + fs_hz + " --f-lo " + f_lo + " --f-hi " + f_hi
    args = args + " --out " + HELPER_OUT
    if mode == "real" { args = args + " --input " + _sh_quote(input) }
    let cmd = DEFAULT_VENV + " " + HELPER_PATH + " " + args
    eprintln("[_metrics/plv_preserving] cmd=" + cmd)
    let r = exec_with_status(cmd)
    return [to_string(r[0]), to_int(r[1])]
}

fn _metric_plv_preserving_kv(npy_path: string, sidecar_kv: string, variant: string, f_lo: string, f_hi: string, fs_hz: string) -> string {
    let mut mode = "selftest"
    if npy_path != "" { mode = "real" }
    let r = _run_helper(mode, npy_path, variant, f_lo, f_hi, fs_hz)
    let stdout_body = to_string(r[0])
    let rc = to_int(r[1])

    let mut body = ""
    if file_exists(HELPER_OUT) { body = read_file(HELPER_OUT) }
    else { body = stdout_body }

    let plv_ap = parse_json_float_x1000(body, "plv_anterior_posterior")
    let plv_l  = parse_json_float_x1000(body, "plv_anterior_lateral_l")
    let plv_r  = parse_json_float_x1000(body, "plv_anterior_lateral_r")
    let plv_pl = parse_json_float_x1000(body, "plv_phase_locked")
    let plv_rd = parse_json_float_x1000(body, "plv_random")

    let mut triggered = ""; let mut trig_count = 0
    if plv_ap == F_PLVP_03_SENTINEL {
        triggered = triggered + "F_PLVP_03,"; trig_count = trig_count + 1
    } else {
        if plv_ap < F_PLVP_01_LO_X1000 { triggered = triggered + "F_PLVP_01,"; trig_count = trig_count + 1 }
        if plv_ap > F_PLVP_02_HI_X1000 { triggered = triggered + "F_PLVP_02,"; trig_count = trig_count + 1 }
    }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "FAIL"
    if rc == 0 && trig_count == 0 { verdict = "PASS" }
    if trig_count > 0 { verdict = "FALSIFIED" }
    if plv_ap == F_PLVP_03_SENTINEL { verdict = "FAIL" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "metric=" + METRIC_NAME + "\n"
    kv = kv + "npy_path=" + npy_path + "\n"
    kv = kv + "sidecar_kv=" + sidecar_kv + "\n"
    kv = kv + "mode=" + variant + "\n"
    kv = kv + "f_lo=" + f_lo + "\n"
    kv = kv + "f_hi=" + f_hi + "\n"
    kv = kv + "fs_hz=" + fs_hz + "\n"
    kv = kv + "plv_anterior_posterior_x1000=" + str(plv_ap) + "\n"
    kv = kv + "plv_anterior_lateral_l_x1000=" + str(plv_l) + "\n"
    kv = kv + "plv_anterior_lateral_r_x1000=" + str(plv_r) + "\n"
    kv = kv + "plv_phase_locked_x1000=" + str(plv_pl) + "\n"
    kv = kv + "plv_random_x1000=" + str(plv_rd) + "\n"
    kv = kv + "value_x1000=" + str(plv_ap) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "backend=" + HELPER_PATH + "\n"
    kv = kv + "backend_rc=" + str(rc) + "\n"
    kv = kv + "raw71_falsifier_count=3\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=lachaux_1999_plv|butter_iir_8_13hz|hilbert_analytic|amica_sparse_optional\n"
    kv = kv + "raw91_limit=narrowband_only_alpha|amica_fallback_to_fastica|volume_conduction_inflates_plv\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run plv_preserving.hexa --selftest")
    eprintln("       hexa run plv_preserving.hexa --input <npy> [--mode narrowband|amica]")
    eprintln("                                       [--f-lo 8] [--f-hi 13] [--fs 125]")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut input = ""; let mut sidecar = ""
    let mut variant = "narrowband"
    let mut f_lo = "8.0"; let mut f_hi = "13.0"
    let mut fs_hz = "125"
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--input"    { input = av[i+1]; i = i + 2; continue }
        if a == "--sidecar"  { sidecar = av[i+1]; i = i + 2; continue }
        if a == "--mode"     { variant = av[i+1]; i = i + 2; continue }
        if a == "--f-lo"     { f_lo = av[i+1]; i = i + 2; continue }
        if a == "--f-hi"     { f_hi = av[i+1]; i = i + 2; continue }
        if a == "--fs"       { fs_hz = av[i+1]; i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if selftest {
        println("== _metrics/plv_preserving selftest (synthetic dual-oscillator) ==")
        let kv = _metric_plv_preserving_kv("", sidecar, variant, f_lo, f_hi, fs_hz)
        print(kv)
        let p_ap = find_in_str(kv, "plv_anterior_posterior_x1000=")
        if p_ap < 0 { eprintln("reason: plv_anterior_posterior_x1000 missing"); exit(1) }
        let p_pl = find_in_str(kv, "plv_phase_locked_x1000=")
        let p_rd = find_in_str(kv, "plv_random_x1000=")
        if p_pl < 0 || p_rd < 0 { eprintln("reason: selftest companion fields missing"); exit(1) }
        println("selftest=ok")
        exit(0)
    }

    if input == "" { eprintln("ABORT: need --selftest or --input <npy>"); _print_usage(); exit(2) }
    let kv = _metric_plv_preserving_kv(input, sidecar, variant, f_lo, f_hi, fs_hz)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    if find_in_str(kv, "verdict=FALSIFIED") >= 0 { exit(1) }
    exit(2)
}
