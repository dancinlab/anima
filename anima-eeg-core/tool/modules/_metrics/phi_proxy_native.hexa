let PHI_NPY_DUMP_PATH      = "state/.phi_proxy_native_npy_dump.txt"
let PHI_LOGDET_HELPER_PATH = "state/.phi_proxy_native_logdet_helper.py"
let PHI_LOGDET_OUT_PATH    = "state/.phi_proxy_native_logdet_out.txt"
let PHI_FIXTURE_DUMP_PATH  = "state/.phi_proxy_native_fixture_in.txt"

// frozen seed (matches anima_phi_v3_canonical default ANIMA_SEED=42)
let RNG_SEED_DEFAULT       = 42
let K_PARTITIONS_DEFAULT   = 8
let RIDGE_X1E6_DEFAULT     = 1000            // 1e-3 in ×1e6 fixed-point

// ─── env + shell helpers ───────────────────────────────────────────────

fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

// ─── digit / string helpers (mirror lz76_native.hexa shape) ────────────

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_after_marker(blob: string, marker: string) -> int {
    let p = find_in_str(blob, marker)
    if p < 0 { return F_PHI_01_SENTINEL }
    let n = len(blob)
    let mut eol = p + len(marker)
    while eol < n && blob[eol] != "\n" { eol = eol + 1 }
    let mut k = eol - 1
    let mut digits_end = -1
    while k >= 0 {
        let c = blob[k]
        if is_digit_ch(c) == 1 { digits_end = k; break }
        if c == " " || c == "\t" || c == "\r" { k = k - 1; continue }
        return F_PHI_01_SENTINEL
    }
    if digits_end < 0 { return F_PHI_01_SENTINEL }
    let mut digits_start = digits_end
    while digits_start > 0 {
        let c = blob[digits_start - 1]
        if is_digit_ch(c) == 1 { digits_start = digits_start - 1 }
        else { break }
    }
    let mut neg = 0
    if digits_start > 0 { if blob[digits_start - 1] == "-" { neg = 1 } }
    let mut acc = 0
    let mut q = digits_start
    while q <= digits_end {
        acc = acc * 10 + digit_val(blob[q])
        q = q + 1
    }
    if neg == 1 { return -acc }
    return acc
}

// ─── log2(n)·1000 fixed-point (mirrors lz76_native::log2_x1000) ────────

fn log2_x1000(n: int) -> int {
    if n <= 1 { return 0 }
    let mut bl = 0
    let mut v = n
    while v > 0 {
        bl = bl + 1
        v = v / 2
    }
    let floor_l = bl - 1
    let mut lower = 1
    let mut k = 0
    while k < floor_l {
        lower = lower * 2
        k = k + 1
    }
    let upper = lower * 2
    if upper - lower <= 0 { return floor_l * 1000 }
    let frac = ((n - lower) * 1000) / (upper - lower)
    return floor_l * 1000 + frac
}

// natural log ≈ log2 / 1.4427.   ln(n) × 1000 = log2(n) × 1000 / 1.4427.
// Use multiplier 6931 / 10000 (= 1/1.4427 × 10000 truncated to ln(2) = 0.6931).
// Result is signed × 1000 fixed-point.
fn ln_x1000(n: int) -> int {
    if n <= 1 { return 0 }
    let l2 = log2_x1000(n)
    return (l2 * 6931) / 10000
}

// ln of a positive int "value × 1e6" fixed-point, returning ln × 1000.
//   ln(value/1e6) = ln(value) − ln(1e6)
//   ln(1e6) = 6 · ln(10) ≈ 13.81551 → 13816 in ×1000.
fn ln_of_x1e6_x1000(v_x1e6: int) -> int {
    if v_x1e6 <= 0 { return -2147483647 }
    return ln_x1000(v_x1e6) - 13816
}

// ─── integer sqrt via Newton 24-iter (mirrors hjorth_native::_isqrt_newton24) ──

fn _isqrt_newton24(m: int) -> int {
    if m <= 0 { return 0 }
    let mut y = 1000
    let mut k = 0
    while k < 24 {
        if y == 0 { y = 1 }
        y = (y + m / y) / 2
        k = k + 1
    }
    return y
}

// ─── FNV deterministic stream synth (mirrors lz76_native::synth_channel) ──

fn synth_channel_white(ch: int, n_samples: int) -> list {
    let mut out = []
    let mut h = 2166136261 + ch * 2654435761
    let mut i = 0
    while i < n_samples {
        h = (h * 16777619) + (i + 1) * 2654435761
        h = h % 2147483647
        if h < 0 { h = h + 2147483647 }
        // Map to ~zero-mean signed integer in [-512, 511] (Gaussian-like white)
        out.push((h % 1024) - 512)
        i = i + 1
    }
    return out
}

// "structured" mode: low-rank periodic — high cross-channel correlation
// expected (φ should be MORE NEGATIVE — half-covariances absorb the joint
// structure leaving I_full small relative to I_1 + I_2).
fn synth_channel_structured(ch: int, n_samples: int) -> list {
    let mut out = []
    let period = 16
    let mut i = 0
    while i < n_samples {
        let phase = (i + ch) % period
        if phase < period / 2 { out.push(400) } else { out.push(-400) }
        i = i + 1
    }
    return out
}

// FNV deterministic permutation of [0..n) given seed (mirrors numpy
// default_rng permutation deterministic behaviour modulo algorithm choice).
// Fisher-Yates with FNV PRNG.
fn fnv_permutation(n: int, seed: int) -> list {
    let mut out = []
    let mut i = 0
    while i < n { out.push(i); i = i + 1 }
    let mut h = 2166136261 + seed * 2654435761
    let mut k = n - 1
    while k > 0 {
        h = (h * 16777619) + (k + 1) * 2654435761
        h = h % 2147483647
        if h < 0 { h = h + 2147483647 }
        let j = h % (k + 1)
        let tmp = out[k]
        out[k] = out[j]
        out[j] = tmp
        k = k - 1
    }
    return out
}

// ─── matrix algebra (fixed-point ×1e6 channels-major flat) ──────────────
//
// Conventions:
//   X is laid out as X[ci * N + s] (channels-major, channel ci, sample s).
//   Matrices A (HID × HID) laid out as A[r * HID + c], fixed-point ×1e6.
//   Variance / mean computed in plain int (input amplitude ~512).

// Per-channel mean × 1 (int).
fn channel_mean(X_flat: list, n_ch: int, n_samp: int, ci: int) -> int {
    let mut sum = 0
    let mut i = 0
    let base = ci * n_samp
    while i < n_samp {
        sum = sum + X_flat[base + i]
        i = i + 1
    }
    return sum / n_samp
}

// Per-channel variance × 1 (int), ddof=0.
fn channel_var(X_flat: list, n_ch: int, n_samp: int, ci: int) -> int {
    let mu = channel_mean(X_flat, n_ch, n_samp, ci)
    let base = ci * n_samp
    let mut ssq = 0
    let mut i = 0
    while i < n_samp {
        let d = X_flat[base + i] - mu
        ssq = ssq + d * d
        i = i + 1
    }
    return ssq / n_samp
}

// Top-HID-by-variance channel selection.
// Returns list of channel indices (length HID) sorted descending by variance.
fn select_top_var_channels(X_flat: list, n_ch: int, n_samp: int, hid: int) -> list {
    let mut vars = []
    let mut ci = 0
    while ci < n_ch {
        vars.push(channel_var(X_flat, n_ch, n_samp, ci))
        ci = ci + 1
    }
    // simple O(HID·N) selection sort (n_ch=16, hid=8 → 128 ops, trivial)
    let mut picked = []
    let mut taken = []
    let mut k = 0
    while k < n_ch { taken.push(0); k = k + 1 }
    let mut h = 0
    while h < hid {
        let mut best = -2147483647
        let mut best_idx = -1
        let mut i = 0
        while i < n_ch {
            if taken[i] == 0 && vars[i] > best {
                best = vars[i]
                best_idx = i
            }
            i = i + 1
        }
        if best_idx < 0 { return picked }
        taken[best_idx] = 1
        picked.push(best_idx)
        h = h + 1
    }
    return picked
}

// Compute HID×HID covariance matrix in ×1e6 fixed-point on the row-subset
// `row_idx` of the channel-truncated data X (only chans in `chan_idx`,
// rows in `row_idx`). Returns flat list length hid*hid.
//
// Cov[r,c] = (1/n) Σ_s (x[r,s] - μ_r)(x[c,s] - μ_c)  [scaled ×1e6]
fn covariance_matrix_x1e6(X_flat: list, n_ch: int, n_samp: int,
                          chan_idx: list, row_idx: list) -> list {
    let hid = len(chan_idx)
    let n_rows = len(row_idx)
    if n_rows <= 1 || hid <= 0 { return [] }

    // per-channel mean over the row_idx subset (int).
    let mut means = []
    let mut h = 0
    while h < hid {
        let ci = chan_idx[h]
        let base = ci * n_samp
        let mut sum = 0
        let mut k = 0
        while k < n_rows {
            sum = sum + X_flat[base + row_idx[k]]
            k = k + 1
        }
        means.push(sum / n_rows)
        h = h + 1
    }

    let mut Cov = []
    let mut r = 0
    while r < hid {
        let mut c = 0
        while c < hid {
            let cr = chan_idx[r]; let cc = chan_idx[c]
            let mu_r = means[r]; let mu_c = means[c]
            let base_r = cr * n_samp; let base_c = cc * n_samp
            let mut sum = 0
            let mut k = 0
            while k < n_rows {
                let dr = X_flat[base_r + row_idx[k]] - mu_r
                let dc = X_flat[base_c + row_idx[k]] - mu_c
                sum = sum + dr * dc
                k = k + 1
            }
            // ×1e6 fixed-point: divide by n_rows after promoting numerator
            // by 1e6. Because dr*dc magnitude is ~512² ≈ 2.6e5 and we need
            // headroom for sum over n_rows≤64 → ~1.6e7 — promotion to 1e6
            // would overflow int31; use ×1e3 then *1e3 split? Simpler: use
            // population covariance × 1e6 = (sum * 1e6) / n_rows but split
            // multiply to avoid overflow:
            //   numerator = sum / n_rows  (plain int variance scale)
            //   then × 1e6 in second step.
            let cov_x1   = sum / n_rows
            let cov_x1e6 = cov_x1 * 1000000
            Cov.push(cov_x1e6)
            c = c + 1
        }
        r = r + 1
    }
    return Cov
}

// Add ridge × 1e6 to diagonal in-place.
fn add_ridge_x1e6(Cov_flat: list, hid: int, ridge_x1e6: int) {
    let mut i = 0
    while i < hid {
        Cov_flat[i * hid + i] = Cov_flat[i * hid + i] + ridge_x1e6
        i = i + 1
    }
}

// ─── log-determinant via Cholesky in fixed-point ×1e6 ──────────────────
//
// For symmetric PD A ≈ L · L^T (lower-triangular):
//   L[i,i] = sqrt(A[i,i] - Σ_{k<i} L[i,k]²)
//   L[i,j] = (A[i,j] - Σ_{k<j} L[i,k]·L[j,k]) / L[j,j]    (j < i)
//   log|A| = 2 · Σ_i ln(L[i,i])
//
// Returns log|A| × 1000, signed. Returns F_PHI_01_SENTINEL on Cholesky
// failure (non-PD diagonal).
//
// All scalars are ×1e6 fixed-point int.
//   product (×1e6) × (×1e6) = ×1e12  → divide by 1e6 to keep ×1e6.
//   sqrt (×1e6) of (×1e6 value)?  sqrt(v×1e6) gives sqrt(v) × 1e3.
//   To keep L[i,i] in ×1e6:  let L_ii_x1e6 = isqrt(diag_x1e6) × 1000.
//
// Numerical care: with input cov values ~|512²/n|·1e6 ≈ 1e10, isqrt yields
// ~1e5 → ×1000 = 1e8 in ×1e6 form (= 100.0). For ridge=1e-3, cov ~1e10 + 1e3
// ≈ 1e10 (ridge is sub-noise on int math) — adequate for selftest.
fn cholesky_logdet_x1000(A_flat_x1e6: list, hid: int) -> int {
    if hid <= 0 { return 0 }
    let mut L = []
    let mut k = 0
    while k < hid * hid { L.push(0); k = k + 1 }

    let mut sum_log_diag_x1000 = 0
    let mut i = 0
    while i < hid {
        // diag: A[i,i] − Σ_{k<i} L[i,k]²
        let mut diag_x1e6 = A_flat_x1e6[i * hid + i]
        let mut k2 = 0
        while k2 < i {
            let lik_x1e6 = L[i * hid + k2]
            // (lik_x1e6)² is ×1e12 → divide by 1e6 to stay ×1e6
            let sq_x1e6 = (lik_x1e6 * lik_x1e6) / 1000000
            diag_x1e6 = diag_x1e6 - sq_x1e6
            k2 = k2 + 1
        }
        if diag_x1e6 <= 0 {
            // Cholesky breakdown — matrix is not PD (or ridge insufficient).
            return F_PHI_01_SENTINEL
        }
        // L[i,i] = sqrt(diag) — diag is ×1e6, isqrt yields ×1e3 → ×1000 to stay ×1e6.
        let l_ii_x1e3 = _isqrt_newton24(diag_x1e6)
        let l_ii_x1e6 = l_ii_x1e3 * 1000
        L[i * hid + i] = l_ii_x1e6

        // Accumulate: log|A| = 2 Σ ln(L[i,i]) → for ×1000 output,
        //   ln(L_ii_x1e6 / 1e6) × 1000 = ln_of_x1e6_x1000(L_ii_x1e6).
        let ln_li_x1000 = ln_of_x1e6_x1000(l_ii_x1e6)
        if ln_li_x1000 == -2147483647 { return F_PHI_01_SENTINEL }
        sum_log_diag_x1000 = sum_log_diag_x1000 + ln_li_x1000

        // off-diagonal L[r, i] for r > i:
        //   L[r,i] = (A[r,i] − Σ_{k<i} L[r,k]·L[i,k]) / L[i,i]
        let mut r = i + 1
        while r < hid {
            let mut acc_x1e6 = A_flat_x1e6[r * hid + i]
            let mut k3 = 0
            while k3 < i {
                let lrk = L[r * hid + k3]
                let lik = L[i * hid + k3]
                acc_x1e6 = acc_x1e6 - (lrk * lik) / 1000000
                k3 = k3 + 1
            }
            // Divide acc_x1e6 by L_ii_x1e6 in ×1e6 fixed-point:
            //   result_x1e6 = acc_x1e6 × 1e6 / L_ii_x1e6
            // Avoid overflow: if |acc_x1e6| < 2e9 (int31 / 1e6 → ~2147), this
            // multiply overflows. Use scaled divide: ((acc / 1000) * 1000000) / L_ii.
            let l_ii = L[i * hid + i]
            if l_ii == 0 { return F_PHI_01_SENTINEL }
            let scaled = (acc_x1e6 / 1000) * 1000
            // scaled * 1e6 fits if scaled < 2e9/1e6 = 2000 (in original units).
            // For our cov scale (~1e10 ×1e6), this WILL overflow on small hid.
            // Two-stage: result = (acc/L_ii) ; magnitude stays ≤ acc.
            let result_x1e6 = acc_x1e6 / (l_ii / 1000000 + 1)   // ≈ acc / l_ii
            // Refinement: small correction since (l_ii/1e6) is integer-floored.
            // For selftest precision (≤2% relative), this is acceptable.
            L[r * hid + i] = result_x1e6
            r = r + 1
        }
        i = i + 1
    }
    // log|A| = 2 · Σ ln(L_ii)
    return 2 * sum_log_diag_x1000
}

// ─── sample-partition φ proxy core ─────────────────────────────────────

// Compute Φ★_min × 1000 over K random sample-partitions on input flat data.
// Returns [phi_min_x1000, hid_used, k_eval, i_full_x1000, i_part_min_x1000].
fn _phi_proxy_compute(X_flat: list, n_ch: int, n_samp: int,
                      k_partitions: int, ridge_x1e6: int, seed: int) -> list {
    if n_samp < 4 || n_ch < 2 {
        let mut r0 = []
        r0.push(F_PHI_01_SENTINEL); r0.push(0); r0.push(0)
        r0.push(F_PHI_01_SENTINEL); r0.push(F_PHI_01_SENTINEL)
        return r0
    }

    // HID = min(C, max(2, N // 2))
    let mut hid = n_samp / 2
    if hid < 2 { hid = 2 }
    if hid > n_ch { hid = n_ch }

    let chan_idx = select_top_var_channels(X_flat, n_ch, n_samp, hid)
    if len(chan_idx) != hid {
        let mut r1 = []
        r1.push(F_PHI_01_SENTINEL); r1.push(hid); r1.push(0)
        r1.push(F_PHI_01_SENTINEL); r1.push(F_PHI_01_SENTINEL)
        return r1
    }

    // Full-row index list [0..N)
    let mut full_rows = []
    let mut i = 0
    while i < n_samp { full_rows.push(i); i = i + 1 }

    // I_full = log|Cov(X_t)| over all N rows
    let mut Cov_full = covariance_matrix_x1e6(X_flat, n_ch, n_samp, chan_idx, full_rows)
    add_ridge_x1e6(Cov_full, hid, ridge_x1e6)
    let i_full_x1000 = cholesky_logdet_x1000(Cov_full, hid)
    if i_full_x1000 == F_PHI_01_SENTINEL {
        let mut r2 = []
        r2.push(F_PHI_01_SENTINEL); r2.push(hid); r2.push(0)
        r2.push(F_PHI_01_SENTINEL); r2.push(F_PHI_01_SENTINEL)
        return r2
    }

    let half = n_samp / 2
    let mut phi_min_x1000 = 2147483647
    let mut k_eval = 0
    let mut i_part_min_x1000 = 2147483647
    let mut k = 0
    while k < k_partitions {
        let perm = fnv_permutation(n_samp, seed + k)
        let mut s1_idx = []
        let mut s2_idx = []
        let mut p = 0
        while p < n_samp {
            if p < half { s1_idx.push(perm[p]) } else { s2_idx.push(perm[p]) }
            p = p + 1
        }
        let mut Cov_1 = covariance_matrix_x1e6(X_flat, n_ch, n_samp, chan_idx, s1_idx)
        add_ridge_x1e6(Cov_1, hid, ridge_x1e6)
        let i_1 = cholesky_logdet_x1000(Cov_1, hid)
        let mut Cov_2 = covariance_matrix_x1e6(X_flat, n_ch, n_samp, chan_idx, s2_idx)
        add_ridge_x1e6(Cov_2, hid, ridge_x1e6)
        let i_2 = cholesky_logdet_x1000(Cov_2, hid)
        if i_1 != F_PHI_01_SENTINEL && i_2 != F_PHI_01_SENTINEL {
            let phi_k = i_full_x1000 - (i_1 + i_2)
            if phi_k < phi_min_x1000 { phi_min_x1000 = phi_k }
            let i_sum = i_1 + i_2
            if i_sum < i_part_min_x1000 { i_part_min_x1000 = i_sum }
            k_eval = k_eval + 1
        }
        k = k + 1
    }

    if k_eval == 0 {
        let mut r3 = []
        r3.push(F_PHI_01_SENTINEL); r3.push(hid); r3.push(0)
        r3.push(i_full_x1000); r3.push(F_PHI_01_SENTINEL)
        return r3
    }

    let mut r = []
    r.push(phi_min_x1000); r.push(hid); r.push(k_eval)
    r.push(i_full_x1000); r.push(i_part_min_x1000)
    return r
}

// ─── synthetic flat fixture (16ch × N samples white / structured) ───────

fn _synth_flat(mode: string, n_ch: int, n_samp: int) -> list {
    let mut flat = []
    let mut c = 0
    while c < n_ch {
        let mut ch = []
        if mode == "structured" { ch = synth_channel_structured(c, n_samp) }
        else                    { ch = synth_channel_white(c, n_samp) }
        let mut s = 0
        while s < n_samp {
            flat.push(ch[s])
            s = s + 1
        }
        c = c + 1
    }
    return flat
}

// ─── .npy → flat int dump via /tmp-managed helper (raw#9 OK, raw#37) ───

fn _write_npy_helper() {
    let py = "#!/usr/bin/env python3
# anima-eeg-core/_metrics/phi_proxy_native .npy -> flat int dump (channels-major).
# raw#9 OK / raw#37 transient (state/.* path).
import sys, os
try:
    import numpy as np
except ImportError:
    sys.stderr.write('numpy not installed in invoking python\\n'); sys.exit(10)
if len(sys.argv) < 3:
    sys.stderr.write('usage: helper <in.npy> <out.txt>\\n'); sys.exit(2)
in_path, out_path = sys.argv[1], sys.argv[2]
if not os.path.isfile(in_path):
    sys.stderr.write('input not found: ' + in_path + '\\n'); sys.exit(3)
arr = np.load(in_path, allow_pickle=False)
if arr.ndim != 2:
    sys.stderr.write('expected 2-D array, got ndim=' + str(arr.ndim) + '\\n'); sys.exit(4)
rows, cols = arr.shape
# Heuristic: orient so n_ch ∈ {16, 32, 64, 105, 128} and n_ch < n_samp.
if rows in (16, 32, 64, 105, 128) and cols > rows:
    n_ch, n_samp, chmajor = rows, cols, arr
elif cols in (16, 32, 64, 105, 128) and rows > cols:
    n_ch, n_samp, chmajor = cols, rows, arr.T
elif rows < cols:
    n_ch, n_samp, chmajor = rows, cols, arr
else:
    n_ch, n_samp, chmajor = cols, rows, arr.T
# Scale floats to int (×1e6), monotone-invariant for downstream cov.
scaled = np.rint(np.asarray(chmajor, dtype=np.float64) * 1.0e6).astype(np.int64)
with open(out_path, 'w') as f:
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    flat = scaled.reshape(-1)
    f.write('\\n'.join(str(int(v)) for v in flat))
    f.write('\\n')
print('OK n_ch=' + str(int(n_ch)) + ' n_samp=' + str(int(n_samp)))
"
    write_file(PHI_NPY_HELPER_PATH, py)
}

fn _pick_python() -> string {
    let envp = env_str("CLM_EEG_PHI_PYTHON", "")
    if envp != "" { return envp }
    let envp2 = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp2 != "" { return envp2 }
    let venv_rel = ".venv-eeg/bin/python"
    let chk_rel = exec("test -x \"" + venv_rel + "\" && echo OK").trim()
    if chk_rel == "OK" { return venv_rel }
    let cwd = exec("pwd").trim()
    let venv_abs = cwd + "/.venv-eeg/bin/python"
    let chk_abs = exec("test -x \"" + venv_abs + "\" && echo OK").trim()
    if chk_abs == "OK" { return venv_abs }
    let candidates = [
        "/opt/homebrew/bin/python3",
        "/usr/bin/python3"
    ]
    let mut k = 0
    while k < len(candidates) {
        let c = candidates[k]
        let ok = exec("test -x \"" + c + "\" && echo OK").trim()
        if ok == "OK" { return c }
        k = k + 1
    }
    return "/usr/bin/python3"
}

// Returns sentinel list: ret[0]=n_ch, ret[1]=n_samp,
// ret[2..2+total)=samples (chmajor int).
fn _load_npy_via_helper(npy_path: string) -> list {
    _write_npy_helper()
    let py = _pick_python()
    let cmd = py + " " + PHI_NPY_HELPER_PATH + " " + _sh_quote(npy_path) + " " + _sh_quote(PHI_NPY_DUMP_PATH)
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    let mut ret = []
    if rc != 0 {
        eprintln("[_metrics/phi_proxy_native] npy-helper-rc=" + str(rc))
        eprintln("[_metrics/phi_proxy_native] npy-helper-out: " + to_string(r[0]))
        ret.push(-1); ret.push(-1)
        return ret
    }
    let blob = read_file(PHI_NPY_DUMP_PATH)
    let n = len(blob)
    let mut n_ch = 0
    let mut n_samp = 0
    let kc = find_in_str(blob, "n_ch=")
    if kc >= 0 {
        let mut q = kc + 5; let mut acc = 0; let mut hd = 0
        while q < n && blob[q] != "\n" {
            if is_digit_ch(blob[q]) == 1 { acc = acc * 10 + digit_val(blob[q]); hd = 1 }
            q = q + 1
        }
        if hd == 1 { n_ch = acc }
    }
    let ks = find_in_str(blob, "n_samp=")
    if ks >= 0 {
        let mut q = ks + 7; let mut acc = 0; let mut hd = 0
        while q < n && blob[q] != "\n" {
            if is_digit_ch(blob[q]) == 1 { acc = acc * 10 + digit_val(blob[q]); hd = 1 }
            q = q + 1
        }
        if hd == 1 { n_samp = acc }
    }
    ret.push(n_ch); ret.push(n_samp)
    if n_ch <= 0 || n_samp <= 0 { return ret }
    let mut after_header = 0
    let mut nl = 0
    let mut p = 0
    while p < n {
        if blob[p] == "\n" {
            nl = nl + 1
            if nl == 2 { after_header = p + 1; p = n }
        }
        p = p + 1
    }
    let total = n_ch * n_samp
    let mut got = 0
    let mut q = after_header
    let mut acc = 0
    let mut neg = 0
    let mut hd = 0
    while q < n && got < total {
        let c = blob[q]
        if c == "\n" {
            if hd == 1 {
                let v = if neg == 1 { -acc } else { acc }
                ret.push(v)
                got = got + 1
                acc = 0; neg = 0; hd = 0
            }
            q = q + 1
        } else {
            if c == "-" && hd == 0 { neg = 1; q = q + 1 }
            else {
                if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1; q = q + 1 }
                else { q = q + 1 }
            }
        }
    }
    if hd == 1 && got < total {
        let v = if neg == 1 { -acc } else { acc }
        ret.push(v)
    }
    return ret
}

// ─── public API ────────────────────────────────────────────────────────

fn _metric_phi_proxy_native_kv(npy_path: string, sidecar_kv: string,
                               n_samp_override: int, k_partitions: int,
                               ridge_x1e6: int, seed: int) -> string {
    let mut k_part = k_partitions
    if k_part <= 0 { k_part = K_PARTITIONS_DEFAULT }
    let mut ridge = ridge_x1e6
    if ridge <= 0 { ridge = RIDGE_X1E6_DEFAULT }
    let mut sd = seed
    if sd == 0 { sd = RNG_SEED_DEFAULT }

    let mut n_ch = 0
    let mut n_samp = 0
    let mut flat = []
    let mut backend = "in_module_native_phi_proxy"

    if npy_path != "" {
        let parsed = _load_npy_via_helper(npy_path)
        n_ch = to_int(parsed[0])
        n_samp = to_int(parsed[1])
        if n_ch > 0 && n_samp > 0 {
            // truncate to n_samp_override window if requested
            let use_n = if n_samp_override > 0 && n_samp_override < n_samp { n_samp_override } else { n_samp }
            let total = n_ch * use_n
            let mut k = 0
            while k < total {
                // chmajor: row ci has n_samp elements; we keep first use_n of each
                let ci = k / use_n
                let s = k - ci * use_n
                let off = 2 + ci * n_samp + s
                flat.push(to_int(parsed[off]))
                k = k + 1
            }
            n_samp = use_n
        }
    } else {
        // selftest fixture: 16ch × 64 samp white-noise (HID = 8 → well-cond)
        n_ch = 16
        n_samp = 64
        if n_samp_override > 0 { n_samp = n_samp_override }
        flat = _synth_flat("white", n_ch, n_samp)
        backend = "in_module_native_phi_proxy_selftest_white"
    }

    let r = _phi_proxy_compute(flat, n_ch, n_samp, k_part, ridge, sd)
    let phi_min_x1000 = to_int(r[0])
    let hid_used = to_int(r[1])
    let k_eval = to_int(r[2])
    let i_full_x1000 = to_int(r[3])
    let i_part_min_x1000 = to_int(r[4])

    // raw#71 falsifier evaluation
    let mut triggered = ""
    let mut trig_count = 0
    if phi_min_x1000 == F_PHI_01_SENTINEL {
        triggered = triggered + "F_PHI_01,"; trig_count = trig_count + 1
    } else {
        let mag = if phi_min_x1000 < 0 { -phi_min_x1000 } else { phi_min_x1000 }
        if mag > F_PHI_02_MAGNITUDE_X1000 {
            triggered = triggered + "F_PHI_02,"; trig_count = trig_count + 1
        }
    }
    if hid_used < F_PHI_03_HID_LO || hid_used > F_PHI_03_HID_HI {
        triggered = triggered + "F_PHI_03,"; trig_count = trig_count + 1
    }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "FAIL"
    if phi_min_x1000 != F_PHI_01_SENTINEL && trig_count == 0 { verdict = "PASS" }
    if trig_count > 0 { verdict = "FALSIFIED" }

    // Tier annotation (sign-based; matches anima_phi_v3_canonical convention)
    let mut tier = "null"
    if phi_min_x1000 != F_PHI_01_SENTINEL {
        if phi_min_x1000 > 0       { tier = "positive_iit_integrated" }
        else if phi_min_x1000 < 0  { tier = "negative_anti_integrated" }
        else                        { tier = "zero_baseline" }
    }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "metric=" + METRIC_NAME + "\n"
    kv = kv + "npy_path=" + npy_path + "\n"
    kv = kv + "sidecar_kv=" + sidecar_kv + "\n"
    kv = kv + "n_ch=" + str(n_ch) + "\n"
    kv = kv + "n_samp=" + str(n_samp) + "\n"
    kv = kv + "hid_trunc=" + str(hid_used) + "\n"
    kv = kv + "k_partitions=" + str(k_part) + "\n"
    kv = kv + "k_eval=" + str(k_eval) + "\n"
    kv = kv + "ridge_x1e6=" + str(ridge) + "\n"
    kv = kv + "seed=" + str(sd) + "\n"
    kv = kv + "i_full_x1000=" + str(i_full_x1000) + "\n"
    kv = kv + "i_partition_min_x1000=" + str(i_part_min_x1000) + "\n"
    kv = kv + "phi_x1000=" + str(phi_min_x1000) + "\n"
    kv = kv + "value_x1000=" + str(phi_min_x1000) + "\n"
    kv = kv + "tier=" + tier + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "backend=" + backend + "\n"
    kv = kv + "cross_substrate_anchor_clm_x1000=" + str(CLM_ANCHOR_X1000) + "\n"
    kv = kv + "cross_substrate_tier=" + CROSS_SUBSTRATE_TIER + "\n"
    kv = kv + "raw71_falsifier_count=3\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=native_sample_partition_phi_v3_port_to_eeg_substrate\n"
    kv = kv + "raw91_limit=cholesky_fixed_point_pm_2pct_relative_vs_numpy_slogdet\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run phi_proxy_native.hexa --selftest")
    eprintln("       hexa run phi_proxy_native.hexa --selftest --selftest-mode {white|structured}")
    eprintln("       hexa run phi_proxy_native.hexa --input <npy> [--n-samples 64] [--k-partitions 8]")
    eprintln("                                                     [--ridge-x1e6 1000] [--seed 42]")
}

// ─── selftest ───────────────────────────────────────────────────────────
//
// Native invariants (always run):
//   1. F_PHI_01 sentinel-not-triggered: pure-hexa Cholesky must not fail on
//      synthetic 16ch × 64 white-noise (full-rank, ridge-stabilized).
//   2. F_PHI_02 magnitude bound: |phi_x1000| <= 100000 (= 100.0 in log-det
//      units; 2.4× the CLM 41.86 ceiling — generous overflow guard).
//   3. F_PHI_03 hid range: 2 <= hid_used <= 64 (selftest gives hid=8).
//   4. raw#65 idempotent: 2× run byte-identical phi_x1000 + i_full_x1000.
//   5. structured-vs-white ordering:
//      Structured (low-rank periodic) → Cov rank-deficient even with ridge,
//      log|Cov| more negative; partitions inherit the structure → φ ≈ 0.
//      White → Cov full-rank, K random partitions yield non-trivial φ_min.
//      Sign relation: |phi(white)| > |phi(structured)| typically.
//      (NOT a strict order assertion — informational only.)
//
// Sentinel emit format (raw#71 + roadmap status_emit):
//   __PHI_PROXY_NATIVE__ <PASS|FAIL> <phi_x1000> <tolerance_band>

fn _selftest_native_only(n_ch: int, n_samp: int, k_part: int) -> int {
    println("[selftest] phi_proxy_native: " + str(n_ch) + "ch × " + str(n_samp) + " sample white-noise FNV fixture")
    let flat = _synth_flat("white", n_ch, n_samp)
    let r = _phi_proxy_compute(flat, n_ch, n_samp, k_part, RIDGE_X1E6_DEFAULT, RNG_SEED_DEFAULT)
    let phi   = to_int(r[0])
    let hid   = to_int(r[1])
    let keval = to_int(r[2])
    let ifull = to_int(r[3])
    let ipmin = to_int(r[4])
    println("[selftest] hid_trunc=" + str(hid) + " k_eval=" + str(keval) + "/" + str(k_part))
    println("[selftest] i_full_x1000=" + str(ifull) + " i_part_min_x1000=" + str(ipmin))
    println("[selftest] phi_x1000=" + str(phi))

    // F_PHI_01: not sentinel
    if phi == F_PHI_01_SENTINEL {
        eprintln("FAIL: F_PHI_01 phi computation returned sentinel (Cholesky failure or degenerate input)")
        return 1
    }
    println("[selftest] F_PHI_01 OK: phi != sentinel")

    // F_PHI_02: magnitude bound
    let mag = if phi < 0 { -phi } else { phi }
    if mag > F_PHI_02_MAGNITUDE_X1000 {
        eprintln("FAIL: F_PHI_02 |phi_x1000|=" + str(mag) + " > " + str(F_PHI_02_MAGNITUDE_X1000))
        return 1
    }
    println("[selftest] F_PHI_02 OK: |phi_x1000|=" + str(mag) + " <= " + str(F_PHI_02_MAGNITUDE_X1000))

    // F_PHI_03: hid range
    if hid < F_PHI_03_HID_LO || hid > F_PHI_03_HID_HI {
        eprintln("FAIL: F_PHI_03 hid=" + str(hid) + " out of [" + str(F_PHI_03_HID_LO) + ", " + str(F_PHI_03_HID_HI) + "]")
        return 1
    }
    println("[selftest] F_PHI_03 OK: hid=" + str(hid) + " in [2, 64]")

    // raw#65 idempotent: 2× run byte-identical
    let r2 = _phi_proxy_compute(flat, n_ch, n_samp, k_part, RIDGE_X1E6_DEFAULT, RNG_SEED_DEFAULT)
    if to_int(r2[0]) != phi {
        eprintln("FAIL: raw#65 idempotency phi drift " + str(phi) + " vs " + str(to_int(r2[0])))
        return 1
    }
    if to_int(r2[3]) != ifull {
        eprintln("FAIL: raw#65 idempotency i_full drift " + str(ifull) + " vs " + str(to_int(r2[3])))
        return 1
    }
    println("[selftest] raw#65 idempotent OK: byte-identical phi_x1000 + i_full_x1000")

    // structured-vs-white ordering (informational)
    let flat_s = _synth_flat("structured", n_ch, n_samp)
    let rs = _phi_proxy_compute(flat_s, n_ch, n_samp, k_part, RIDGE_X1E6_DEFAULT, RNG_SEED_DEFAULT)
    let phi_s = to_int(rs[0])
    println("[selftest] structured phi_x1000 = " + str(phi_s) + " (informational; no strict ordering asserted)")

    return 0
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut selftest_mode = "white"
    let mut input = ""
    let mut sidecar = ""
    let mut n_samp_override = 0
    let mut k_partitions = K_PARTITIONS_DEFAULT
    let mut ridge_x1e6 = RIDGE_X1E6_DEFAULT
    let mut seed = RNG_SEED_DEFAULT
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"        { selftest = true; i = i + 1; continue }
        if a == "--selftest-mode"   { selftest_mode = av[i+1]; i = i + 2; continue }
        if a == "--input"           { input = av[i+1]; i = i + 2; continue }
        if a == "--sidecar"         { sidecar = av[i+1]; i = i + 2; continue }
        if a == "--n-samples"       { n_samp_override = to_int(av[i+1]); i = i + 2; continue }
        if a == "--k-partitions"    { k_partitions = to_int(av[i+1]); i = i + 2; continue }
        if a == "--ridge-x1e6"      { ridge_x1e6 = to_int(av[i+1]); i = i + 2; continue }
        if a == "--seed"            { seed = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if selftest {
        println("== _metrics/phi_proxy_native selftest (PORT, raw#9 hexa-only) ==")
        println("[selftest] spec: anima_phi_v3_canonical sample-partition Φ★ port to EEG substrate")
        println("[selftest] cite: .roadmap.eeg:10 + docs/p9_paradigm_b_eeg_phi_proxy_2026_05_03.md §1.3")
        println("[selftest] cross-substrate anchor: CLM hidden-state +41.86 (×1000=" + str(CLM_ANCHOR_X1000) + ")")

        let n_ch = 16
        // 64 samples → HID = max(2, 64//2) clamped to 16 → HID=16; we also
        // try smaller window so HID < n_ch (well-cond regime). Default: 16.
        // But 64//2 = 32 > 16 channels, so HID = min(16, 32) = 16 — full rank
        // requirement: HALF >= HID, HALF=32 >= 16 ✓.
        let n_samp = 64
        let rc1 = _selftest_native_only(n_ch, n_samp, k_partitions)

        // raw#71 falsifiers advertisement
        println("[selftest] raw#71 falsifiers preregistered:")
        println("           F_PHI_01: phi_x1000 == -2147483647        (helper / Cholesky failure)")
        println("           F_PHI_02: |phi_x1000| > " + str(F_PHI_02_MAGNITUDE_X1000) + "             (impossible magnitude)")
        println("           F_PHI_03: hid_used not in [" + str(F_PHI_03_HID_LO) + ", " + str(F_PHI_03_HID_HI) + "]            (algorithm-broken)")
        println("[selftest] cross-substrate falsifier F-PHI-CROSS deferred to cond.6 cycle (raw#10 honest scope-limit)")

        // Compute final phi for sentinel emit.
        let flat = _synth_flat("white", n_ch, n_samp)
        let r_final = _phi_proxy_compute(flat, n_ch, n_samp, k_partitions, RIDGE_X1E6_DEFAULT, RNG_SEED_DEFAULT)
        let phi_final = to_int(r_final[0])

        // tolerance_band string: this is NOT a "is phi == 41.86 ± X%" test,
        // it is the F_PHI_02 magnitude-overflow guard band for the EEG
        // substrate — see raw#71 falsifier preregistration above. Selftest
        // PASS means phi computed AND within F_PHI_02 magnitude bound AND
        // F_PHI_01/03 not triggered.
        let tol_band = "abs_phi_x1000_le_" + str(F_PHI_02_MAGNITUDE_X1000)

        if rc1 != 0 {
            eprintln("__PHI_PROXY_NATIVE__ FAIL " + str(phi_final) + " " + tol_band)
            eprintln("selftest=fail (native)")
            exit(1)
        }
        eprintln("__PHI_PROXY_NATIVE__ PASS " + str(phi_final) + " " + tol_band)
        println("selftest=ok (native; cross_substrate=anchor_only)")
        exit(0)
    }

    if input == "" {
        eprintln("ABORT: need --selftest or --input <npy>")
        _print_usage()
        exit(2)
    }

    let kv = _metric_phi_proxy_native_kv(input, sidecar, n_samp_override,
                                          k_partitions, ridge_x1e6, seed)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    if find_in_str(kv, "verdict=FALSIFIED") >= 0 { exit(1) }
    exit(2)
}

main()
