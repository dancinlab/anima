// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_integrations/cyborg_token_emit.hexa
//                                                  (Phase 6 — _integrations #6)
//
//  PURPOSE
//    EEG → token stream cyborg path — composes daily-life paradigm with
//    artifact_pipeline + segmenter + tokenizer alphabet (16 symbols). Returns
//    a token string (deterministic) and a round-trip-loss verdict.
//
//  raw#10 HONEST C3 (wrap-vs-port decision)
//    DECISION: PORT (selftest), WRAP-DESIGN-REFERENCE (live).
//    Legacy backend: anima-clm-eeg/tool/eeg_to_token_cyborg.hexa (730 LoC,
//    frozen). Selftest mirrors state/cyborg_eeg_audit/2026-04-28_tokens.jsonl
//    "synthetic_fnv_structured" line: 200 tokens, round_trip_loss_permille=38
//    (well under threshold 250). Live requires real EEG segmenter +
//    .venv-eeg numpy → NOT_YET_LANDED.
//
//  RAW#71 FALSIFIERS (5 preregistered, frozen 2026-04-29)
//    F_CT_01: round_trip_loss_permille > 250            → LOSSY_TOKENIZE
//    F_CT_02: alphabet_size != 16                       → ALPHABET_DRIFT
//    F_CT_03: token_string_len < n_segments * 4         → TRUNCATED_STREAM
//    F_CT_04: n_segments < 50                           → SEGMENT_DEFICIT
//    F_CT_05: token_string contains non-hex char        → INVALID_TOKEN_CHAR
//
//  CLI
//    hexa run cyborg_token_emit.hexa --selftest
//    hexa run cyborg_token_emit.hexa --live   (→ NOT_YET_LANDED honest C3)
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#12 sentinel · raw#42 host-deleg
//      raw#65 idempotent · raw#71 5 falsifiers · raw#82 darwin · raw#91 honest
//
//  @resolver-bypass(reason="darwin-native: live requires real EEG segmenter.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA      = "anima-eeg-core/_integrations/cyborg_token_emit/1"
let MODULE_NAME = "cyborg_token_emit"
let LEGACY_PATH = "anima-clm-eeg/tool/eeg_to_token_cyborg.hexa"

let ROUND_TRIP_LOSS_MAX_PERMILLE = 250
let ALPHABET_SIZE_TARGET         = 16
let SEGMENT_MIN                  = 50

let SENTINEL = -2147483647
let LCG_A = 1103515245
let LCG_C = 12345
let LCG_M = 2147483648

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) { return ln.substring(prefix.len(), ln.len()) }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

fn _lcg_next(state: int) -> int {
    let mut s = state * LCG_A + LCG_C
    if s < 0 { s = -s }
    s = s - (s / LCG_M) * LCG_M
    return s
}

// hex digit char from int 0..15
fn _hex_char(n: int) -> string {
    if n == 0  { return "0" }
    if n == 1  { return "1" }
    if n == 2  { return "2" }
    if n == 3  { return "3" }
    if n == 4  { return "4" }
    if n == 5  { return "5" }
    if n == 6  { return "6" }
    if n == 7  { return "7" }
    if n == 8  { return "8" }
    if n == 9  { return "9" }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    return "f"
}

// is hex char (0-9 a-f)
fn _is_hex(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" { return 1 }
    if c == "4" || c == "5" || c == "6" || c == "7" { return 1 }
    if c == "8" || c == "9" || c == "a" || c == "b" { return 1 }
    if c == "c" || c == "d" || c == "e" || c == "f" { return 1 }
    return 0
}

// ─── public API ────────────────────────────────────────────────────────

fn _integration_cyborg_token_emit_kv(args_kv: string) -> string {
    let seed         = _to_int_or(_kv_get(args_kv, "seed"),       20260428)
    let n_segments   = _to_int_or(_kv_get(args_kv, "n_segments"),  50)
    let alphabet     = _to_int_or(_kv_get(args_kv, "alphabet"),    ALPHABET_SIZE_TARGET)
    let inj_lossy    = _to_int_or(_kv_get(args_kv, "inject_lossy"), 0)
    let inj_alpha    = _to_int_or(_kv_get(args_kv, "inject_alphabet_drift"), 0)
    let inj_short    = _to_int_or(_kv_get(args_kv, "inject_short_segments"),  0)
    let inj_invalid  = _to_int_or(_kv_get(args_kv, "inject_invalid_char"),    0)

    let mut effective_segments = n_segments
    if inj_short == 1 { effective_segments = 30 }
    let mut effective_alphabet = alphabet
    if inj_alpha == 1 { effective_alphabet = 8 }

    // generate token stream — 4 hex chars per segment (so total len = 4*n_seg)
    let mut token_string = ""
    let mut state = seed
    let mut k = 0
    while k < effective_segments {
        let mut q = 0
        while q < 4 {
            state = _lcg_next(state)
            let mut h = state - (state / effective_alphabet) * effective_alphabet
            if h < 0 { h = -h }
            // map to 0..15 (in case alphabet < 16, modulo retains validity)
            token_string = token_string + _hex_char(h - (h / 16) * 16)
            q = q + 1
        }
        k = k + 1
    }
    if inj_invalid == 1 { token_string = token_string + "Z" }
    let token_len = len(token_string)

    // simulated round-trip-loss permille (mirror legacy structured fixture)
    let mut round_trip_loss = 38
    if inj_lossy == 1 { round_trip_loss = 376 }

    // raw#71 falsifiers
    let mut triggered = ""
    let mut trig_count = 0
    if round_trip_loss > ROUND_TRIP_LOSS_MAX_PERMILLE { triggered = triggered + "F_CT_01,"; trig_count = trig_count + 1 }
    if effective_alphabet != ALPHABET_SIZE_TARGET     { triggered = triggered + "F_CT_02,"; trig_count = trig_count + 1 }
    if token_len < effective_segments * 4             { triggered = triggered + "F_CT_03,"; trig_count = trig_count + 1 }
    if effective_segments < SEGMENT_MIN               { triggered = triggered + "F_CT_04,"; trig_count = trig_count + 1 }
    // F5: scan for non-hex char
    let mut non_hex = 0
    let mut p = 0
    while p < token_len {
        if _is_hex(token_string[p]) == 0 { non_hex = 1 }
        p = p + 1
    }
    if non_hex == 1 { triggered = triggered + "F_CT_05,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "PASS"
    if trig_count > 0 { verdict = "FALSIFIED" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "metric=eeg_to_token_cyborg\n"
    kv = kv + "paradigm=daily_life\n"
    kv = kv + "seed=" + str(seed) + "\n"
    kv = kv + "n_segments=" + str(effective_segments) + "\n"
    kv = kv + "alphabet_size=" + str(effective_alphabet) + "\n"
    kv = kv + "token_string_len=" + str(token_len) + "\n"
    kv = kv + "round_trip_loss_permille=" + str(round_trip_loss) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(round_trip_loss) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_status=ported_in_module_synth_lcg_seed_token_stream\n"
    kv = kv + "raw71_falsifier_count=5\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=token_string_+round_trip_loss_+alphabet_+segment_count\n"
    kv = kv + "raw91_limit=no_real_eeg_segmenter_no_numpy_synth_fnv_only\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run cyborg_token_emit.hexa --selftest")
    eprintln("       hexa run cyborg_token_emit.hexa --live   (→ NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut live = false
    let mut seed = 20260428
    let mut n_seg = 50
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"     { selftest = true; i = i + 1; continue }
        if a == "--live"         { live = true; i = i + 1; continue }
        if a == "--seed"         { seed = to_int(av[i+1]); i = i + 2; continue }
        if a == "--n-segments"   { n_seg = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --live")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        println("── _integrations/cyborg_token_emit LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_real_eeg_segmenter_+token_emit")
        println("verdict=PENDING_MIGRATION")
        println("backend=" + LEGACY_PATH)
        eprintln("reason: not-yet-landed: live requires real EEG segmenter + .venv-eeg numpy")
        eprintln("fix: run legacy directly: hexa run " + LEGACY_PATH + " --run --input <npy> (post-arrival)")
        exit(4)
    }

    println("== _integrations/cyborg_token_emit selftest (synth seed=" + str(seed) + " segs=" + str(n_seg) + ") ==")
    let args_kv = "seed=" + str(seed) + ",n_segments=" + str(n_seg)
    let kv = _integration_cyborg_token_emit_kv(args_kv)
    print(kv)

    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: nominal selftest verdict not PASS — falsifier triggered")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
