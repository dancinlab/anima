// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_integrations/berger_validate.hexa
//                                                  (Phase 6 — _integrations #3)
//
//  PURPOSE
//    Berger α-block PSD verifier — composes resting-baseline paradigm with
//    eyes-closed condition and applies the Berger 1929 / Welch 1967 alpha
//    dominance triad on O1/O2 channels:
//      C1.  α-band-power(O1,O2) > β-band-power(O1,O2)            (alpha-dominance)
//      C2.  α-band-power(O1,O2) > δ-band-power(O1,O2)            (alpha > delta floor)
//      C3.  peak frequency in 8.0–13.0 Hz on O1 AND O2           (parietal lock)
//
//  raw#10 HONEST C3 (wrap-vs-port decision)
//    DECISION: PORT (selftest), WRAP-DESIGN-REFERENCE (live).
//    Legacy backend: anima-clm-eeg/tool/clm_eeg_berger_sanity.hexa (646 LoC,
//    frozen 2026-04-28, scipy.welch). Selftest mirrors legacy synthetic_alpha
//    fixture from state/clm_eeg_berger_audit/2026-04-28_berger.jsonl. Live
//    mode requires .venv-eeg + scipy + real resting EEG → NOT_YET_LANDED.
//
//  RAW#71 FALSIFIERS (5 preregistered, frozen 2026-04-29)
//    F_BG_01: O1 α ≤ β                          → ALPHA_NOT_DOMINANT_O1
//    F_BG_02: O2 α ≤ β                          → ALPHA_NOT_DOMINANT_O2
//    F_BG_03: O1 α ≤ δ                          → DELTA_FLOOR_BREACH_O1
//    F_BG_04: O1 peak outside 8-13 Hz           → PEAK_OUT_OF_BAND_O1
//    F_BG_05: O2 peak outside 8-13 Hz           → PEAK_OUT_OF_BAND_O2
//
//  CLI
//    hexa run berger_validate.hexa --selftest
//    hexa run berger_validate.hexa --live   (→ NOT_YET_LANDED honest C3)
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#12 sentinel · raw#42 host-deleg
//      raw#65 idempotent · raw#71 5 falsifiers · raw#82 darwin · raw#91 honest
//
//  @resolver-bypass(reason="darwin-native: live requires scipy.welch + .venv-eeg
//                   + real eyes-closed resting recording.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA      = "anima-eeg-core/_integrations/berger_validate/1"
let MODULE_NAME = "berger_validate"
let LEGACY_PATH = "anima-clm-eeg/tool/clm_eeg_berger_sanity.hexa"

// peak-frequency band (Hz × 10): 80..130
let ALPHA_PEAK_LO_HZ_X10 = 80
let ALPHA_PEAK_HI_HZ_X10 = 130

let SENTINEL = -2147483647

let LCG_A = 1103515245
let LCG_C = 12345
let LCG_M = 2147483648

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) { return ln.substring(prefix.len(), ln.len()) }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

fn _lcg_next(state: int) -> int {
    let mut s = state * LCG_A + LCG_C
    if s < 0 { s = -s }
    s = s - (s / LCG_M) * LCG_M
    return s
}

// ─── public API ────────────────────────────────────────────────────────
//
// Selftest synth-fixture mirrors state/clm_eeg_berger_audit/2026-04-28_berger.jsonl
// nominal "synthetic_alpha" line:
//   o1_alpha_x1e6=28506449  o1_beta_x1e6=272562  o1_delta_x1e6=53175  o1_peak_hz_x10=100
//   o2_alpha_x1e6=28635497  o2_beta_x1e6=260332  o2_delta_x1e6=46523  o2_peak_hz_x10=100

fn _integration_berger_validate_kv(args_kv: string) -> string {
    let seed       = _to_int_or(_kv_get(args_kv, "seed"),       20260428)
    let inj_no_a1  = _to_int_or(_kv_get(args_kv, "inject_no_alpha_o1"), 0)
    let inj_no_a2  = _to_int_or(_kv_get(args_kv, "inject_no_alpha_o2"), 0)
    let inj_delta  = _to_int_or(_kv_get(args_kv, "inject_delta_floor"), 0)
    let inj_peak1  = _to_int_or(_kv_get(args_kv, "inject_peak_oob_o1"), 0)
    let inj_peak2  = _to_int_or(_kv_get(args_kv, "inject_peak_oob_o2"), 0)

    // synth-fixture nominal (mirror legacy "synthetic_alpha")
    let mut o1_alpha = 28506449
    let mut o1_beta  =   272562
    let mut o1_delta =    53175
    let mut o1_peak  = 100        // 10.0 Hz × 10
    let mut o2_alpha = 28635497
    let mut o2_beta  =   260332
    let mut o2_delta =    46523
    let mut o2_peak  = 100

    if inj_no_a1 == 1 { o1_alpha = 100000 }            // < beta → F1
    if inj_no_a2 == 1 { o2_alpha = 100000 }            // < beta → F2
    if inj_delta == 1 { o1_delta = 99999999 }          // > alpha → F3
    if inj_peak1 == 1 { o1_peak = 30 }                 // 3 Hz, < 8 → F4
    if inj_peak2 == 1 { o2_peak = 200 }                // 20 Hz, > 13 → F5

    // criteria
    let o1_c1 = if o1_alpha > o1_beta  { 1 } else { 0 }
    let o2_c1 = if o2_alpha > o2_beta  { 1 } else { 0 }
    let o1_c2 = if o1_alpha > o1_delta { 1 } else { 0 }
    let o2_c2 = if o2_alpha > o2_delta { 1 } else { 0 }
    let o1_c3 = if o1_peak >= ALPHA_PEAK_LO_HZ_X10 && o1_peak <= ALPHA_PEAK_HI_HZ_X10 { 1 } else { 0 }
    let o2_c3 = if o2_peak >= ALPHA_PEAK_LO_HZ_X10 && o2_peak <= ALPHA_PEAK_HI_HZ_X10 { 1 } else { 0 }

    // raw#71 falsifiers
    let mut triggered = ""
    let mut trig_count = 0
    if o1_c1 == 0  { triggered = triggered + "F_BG_01,"; trig_count = trig_count + 1 }
    if o2_c1 == 0  { triggered = triggered + "F_BG_02,"; trig_count = trig_count + 1 }
    if o1_c2 == 0  { triggered = triggered + "F_BG_03,"; trig_count = trig_count + 1 }
    if o1_c3 == 0  { triggered = triggered + "F_BG_04,"; trig_count = trig_count + 1 }
    if o2_c3 == 0  { triggered = triggered + "F_BG_05,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    // verdict policy: PASS = all 6 criteria pass (3 on O1, 3 on O2)
    let all_pass = o1_c1 + o2_c1 + o1_c2 + o2_c2 + o1_c3 + o2_c3
    let mut verdict = "FAIL"
    if all_pass == 6 { verdict = "PASS" }
    else { if trig_count > 0 { verdict = "FALSIFIED" } }

    // value_x1000 — average alpha (×1e6) → ×1000 by /1000 (alpha mean / 1k)
    let alpha_mean_x1e6 = (o1_alpha + o2_alpha) / 2
    let value_x1000 = alpha_mean_x1e6 / 1000

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "metric=berger_alpha_dominance\n"
    kv = kv + "paradigm=resting_baseline\n"
    kv = kv + "condition=eyes_closed\n"
    kv = kv + "seed=" + str(seed) + "\n"
    kv = kv + "o1_alpha_x1e6=" + str(o1_alpha) + "\n"
    kv = kv + "o1_beta_x1e6=" + str(o1_beta) + "\n"
    kv = kv + "o1_delta_x1e6=" + str(o1_delta) + "\n"
    kv = kv + "o1_peak_hz_x10=" + str(o1_peak) + "\n"
    kv = kv + "o2_alpha_x1e6=" + str(o2_alpha) + "\n"
    kv = kv + "o2_beta_x1e6=" + str(o2_beta) + "\n"
    kv = kv + "o2_delta_x1e6=" + str(o2_delta) + "\n"
    kv = kv + "o2_peak_hz_x10=" + str(o2_peak) + "\n"
    kv = kv + "o1_c1_alpha_gt_beta=" + str(o1_c1) + "\n"
    kv = kv + "o1_c2_alpha_gt_delta=" + str(o1_c2) + "\n"
    kv = kv + "o1_c3_peak_in_band=" + str(o1_c3) + "\n"
    kv = kv + "o2_c1_alpha_gt_beta=" + str(o2_c1) + "\n"
    kv = kv + "o2_c2_alpha_gt_delta=" + str(o2_c2) + "\n"
    kv = kv + "o2_c3_peak_in_band=" + str(o2_c3) + "\n"
    kv = kv + "criteria_passed=" + str(all_pass) + "\n"
    kv = kv + "criteria_total=6\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(value_x1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_status=ported_in_module_synth_mirror_legacy_synthetic_alpha\n"
    kv = kv + "raw71_falsifier_count=5\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=O1_O2_alpha_+beta_+delta_+peak_band_8_13Hz\n"
    kv = kv + "raw91_limit=no_scipy_welch_no_real_eeg_synth_fixture_only\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run berger_validate.hexa --selftest")
    eprintln("       hexa run berger_validate.hexa --live   (→ NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut live = false
    let mut seed = 20260428
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--live"     { live = true; i = i + 1; continue }
        if a == "--seed"     { seed = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --live")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        println("── _integrations/berger_validate LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_real_eeg_+scipy_welch_+eyes_closed_resting")
        println("verdict=PENDING_MIGRATION")
        println("backend=" + LEGACY_PATH)
        eprintln("reason: not-yet-landed: live requires real eyes-closed EEG + scipy.welch + .venv-eeg")
        eprintln("fix: run legacy directly: hexa run " + LEGACY_PATH + " --run --input <npy>")
        exit(4)
    }

    println("== _integrations/berger_validate selftest (synth seed=" + str(seed) + ") ==")
    let args_kv = "seed=" + str(seed)
    let kv = _integration_berger_validate_kv(args_kv)
    print(kv)

    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: nominal selftest verdict not PASS — falsifier triggered")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
