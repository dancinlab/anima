// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_integrations/clm_eeg_p3.hexa
//                                                  (Phase 6 — _integrations #2)
//
//  PURPOSE
//    Mk.XII CLM EEG P3 pre-register — gamma(30-50Hz)/theta(4-8Hz) band-power
//    ratio == 3.0 (own 3 = TECS-L H-CX-1 sigma/tau identity). Composes
//    resting-baseline paradigm with gamma_theta metric for awake EEG verdict.
//
//  raw#10 HONEST C3 (wrap-vs-port decision)
//    DECISION: PORT (selftest), WRAP-DESIGN-REFERENCE (live).
//    Legacy backend: anima-clm-eeg/tool/clm_eeg_gamma_theta_ratio.hexa (718
//    LoC, frozen 2026-04-28). Selftest mirrors the frozen criteria block from
//    state/clm_eeg_p3_gamma_theta_pre_register.json (this file's SSOT). Live
//    mode requires scipy.welch + .venv-eeg + real resting EEG → NOT_YET_LANDED.
//
//  PRE-REGISTERED CRITERIA (frozen — state/clm_eeg_p3_gamma_theta_pre_register.json)
//    C1.  loose:  ratio_x1000 ∈ [1500, 4500]
//         strict: ratio_x1000 ∈ [2500, 3500]
//    C2.  std/mean (heterogeneity) ≤ 500 (×1000) i.e. CV ≤ 0.5
//    C3.  occipital_ratio > grand_mean_ratio (regional dominance)
//    Verdict P3.PASS = (C1.loose AND C2 AND C3)
//
//  RAW#71 FALSIFIERS (5 preregistered — mirror of legacy SSOT, frozen 2026-04-28)
//    F_P3_01: ratio outside loose band                  → RATIO_OUT_OF_BAND
//    F_P3_02: std/mean > C2                             → HETEROGENEITY_HIGH
//    F_P3_03: occipital ≤ grand_mean (no dominance)     → REGIONAL_REVERSED
//    F_P3_04: theta peak outside 4-8Hz on > 8 channels  → THETA_PEAK_DRIFT
//    F_P3_05: gamma peak ≥ 49Hz on > 8 channels         → NYQUIST_LEAK
//
//  CLI
//    hexa run clm_eeg_p3.hexa --selftest
//    hexa run clm_eeg_p3.hexa --live   (→ NOT_YET_LANDED honest C3)
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#12 sentinel · raw#42 host-deleg
//      raw#65 idempotent · raw#71 5 falsifiers · raw#82 darwin · raw#91 honest
//
//  @resolver-bypass(reason="darwin-native: live requires scipy.welch + .venv-eeg.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA      = "anima-eeg-core/_integrations/clm_eeg_p3/1"
let MODULE_NAME = "clm_eeg_p3"
let LEGACY_PATH = "anima-clm-eeg/tool/clm_eeg_gamma_theta_ratio.hexa"

// frozen criteria (mirror of state/clm_eeg_p3_gamma_theta_pre_register.json)
let C1_LOOSE_LO  = 1500
let C1_LOOSE_HI  = 4500
let C1_STRICT_LO = 2500
let C1_STRICT_HI = 3500
let C2_CV_MAX    = 500     // std/mean × 1000 ≤ 0.5
let F4_THETA_PEAK_OUTSIDE_MAX = 8
let F5_GAMMA_PEAK_GE_49HZ_MAX = 8

// raw#12 sentinel
let SENTINEL = -2147483647

// LCG (deterministic, mirror legacy seed=20260428)
let LCG_A = 1103515245
let LCG_C = 12345
let LCG_M = 2147483648

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) { return ln.substring(prefix.len(), ln.len()) }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

fn _abs(x: int) -> int { if x < 0 { return -x } return x }

fn _lcg_next(state: int) -> int {
    let mut s = state * LCG_A + LCG_C
    if s < 0 { s = -s }
    s = s - (s / LCG_M) * LCG_M
    return s
}

// ─── public API ────────────────────────────────────────────────────────
//
// Selftest synthesizes per-channel ratio_x1000 mirroring the frozen
// state/clm_eeg_p3_gamma_theta_pre_register.json fixture: nominal grand-mean
// ~2973, occipital ~3728, frontal ~2865 (i.e. C1.loose=1, C2.cv≤0.5, C3=1).

fn _integration_clm_eeg_p3_kv(args_kv: string) -> string {
    let n_channels = _to_int_or(_kv_get(args_kv, "n_channels"), 16)
    let seed       = _to_int_or(_kv_get(args_kv, "seed"),       20260428)
    let inj_oob    = _to_int_or(_kv_get(args_kv, "inject_out_of_band"), 0)
    let inj_het    = _to_int_or(_kv_get(args_kv, "inject_heterogeneity"), 0)
    let inj_rev    = _to_int_or(_kv_get(args_kv, "inject_regional_reverse"), 0)
    let inj_theta  = _to_int_or(_kv_get(args_kv, "inject_theta_drift"), 0)
    let inj_gamma  = _to_int_or(_kv_get(args_kv, "inject_gamma_leak"), 0)

    // synthesise per-channel ratio_x1000 mirroring the frozen P3 fixture
    // channels: 0..5 frontal, 6..7 occipital (O1/O2), 8..15 other
    let mut ratios = []
    let mut state = seed
    let mut c = 0
    while c < n_channels {
        state = _lcg_next(state)
        // jitter ±10
        let mut jitter = state - (state / 21) * 21 - 10
        if c == 6 || c == 7 {
            // occipital — higher
            ratios.push(3728 + jitter)
        } else {
            ratios.push(2865 + jitter)
        }
        c = c + 1
    }
    if inj_oob == 1 {
        // force out-of-band by clamping all to 800 (< C1_LOOSE_LO)
        let mut k = 0
        while k < n_channels { ratios[k] = 800; k = k + 1 }
    }
    if inj_het == 1 {
        // huge variance — alternate 100 and 9000
        let mut k = 0
        while k < n_channels {
            if k - (k / 2) * 2 == 0 { ratios[k] = 100 } else { ratios[k] = 9000 }
            k = k + 1
        }
    }
    if inj_rev == 1 {
        // occipital lower than frontal
        ratios[6] = 1500
        ratios[7] = 1500
    }

    // grand mean
    let mut sum = 0
    let mut k = 0
    while k < n_channels { sum = sum + ratios[k]; k = k + 1 }
    let grand_mean = if n_channels > 0 { sum / n_channels } else { SENTINEL }

    // std (integer approx)
    let mut sq = 0
    k = 0
    while k < n_channels { let d = ratios[k] - grand_mean; sq = sq + d * d; k = k + 1 }
    let var_v = if n_channels > 0 { sq / n_channels } else { 0 }
    // integer sqrt (Newton)
    let mut sd = 0
    if var_v > 0 {
        let mut x = var_v
        let mut y = (x + 1) / 2
        while y < x { x = y; y = (x + var_v / x) / 2 }
        sd = x
    }
    let cv_x1000 = if grand_mean > 0 { (sd * 1000) / grand_mean } else { SENTINEL }

    // occipital mean
    let occ_mean = if n_channels >= 8 { (ratios[6] + ratios[7]) / 2 } else { SENTINEL }

    // theta-peak outside band count (synth: 0 nominally, F4_THETA_PEAK_OUTSIDE_MAX+1 if injected)
    let theta_oob = if inj_theta == 1 { F4_THETA_PEAK_OUTSIDE_MAX + 1 } else { 0 }
    let gamma_leak = if inj_gamma == 1 { F5_GAMMA_PEAK_GE_49HZ_MAX + 1 } else { 0 }

    // criteria
    let c1_loose = if grand_mean >= C1_LOOSE_LO && grand_mean <= C1_LOOSE_HI { 1 } else { 0 }
    let c1_strict = if grand_mean >= C1_STRICT_LO && grand_mean <= C1_STRICT_HI { 1 } else { 0 }
    let c2_pass = if cv_x1000 != SENTINEL && cv_x1000 <= C2_CV_MAX { 1 } else { 0 }
    let c3_pass = if occ_mean != SENTINEL && occ_mean > grand_mean { 1 } else { 0 }

    // raw#71 falsifiers
    let mut triggered = ""
    let mut trig_count = 0
    if c1_loose == 0                 { triggered = triggered + "F_P3_01,"; trig_count = trig_count + 1 }
    if c2_pass == 0                  { triggered = triggered + "F_P3_02,"; trig_count = trig_count + 1 }
    if c3_pass == 0                  { triggered = triggered + "F_P3_03,"; trig_count = trig_count + 1 }
    if theta_oob > F4_THETA_PEAK_OUTSIDE_MAX { triggered = triggered + "F_P3_04,"; trig_count = trig_count + 1 }
    if gamma_leak > F5_GAMMA_PEAK_GE_49HZ_MAX { triggered = triggered + "F_P3_05,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "PASS"
    if trig_count > 0 { verdict = "FALSIFIED" }
    if grand_mean == SENTINEL || cv_x1000 == SENTINEL { verdict = "FAIL" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "metric=gamma_theta_ratio\n"
    kv = kv + "paradigm=resting_baseline\n"
    kv = kv + "n_channels=" + str(n_channels) + "\n"
    kv = kv + "seed=" + str(seed) + "\n"
    kv = kv + "grand_mean_ratio_x1000=" + str(grand_mean) + "\n"
    kv = kv + "occipital_ratio_x1000=" + str(occ_mean) + "\n"
    kv = kv + "std_x1000=" + str(sd) + "\n"
    kv = kv + "cv_x1000=" + str(cv_x1000) + "\n"
    kv = kv + "theta_peak_outside_count=" + str(theta_oob) + "\n"
    kv = kv + "gamma_peak_ge_49hz_count=" + str(gamma_leak) + "\n"
    kv = kv + "C1_loose_pass=" + str(c1_loose) + "\n"
    kv = kv + "C1_strict_pass=" + str(c1_strict) + "\n"
    kv = kv + "C2_pass=" + str(c2_pass) + "\n"
    kv = kv + "C3_pass=" + str(c3_pass) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(grand_mean) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_status=ported_in_module_synth_mirror_legacy_fixture\n"
    kv = kv + "raw71_falsifier_count=5\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=ratio_C1_loose_strict_+CV_+occipital_dominance_+theta_gamma_band_purity\n"
    kv = kv + "raw91_limit=no_scipy_welch_no_real_eeg_synth_only\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run clm_eeg_p3.hexa --selftest")
    eprintln("       hexa run clm_eeg_p3.hexa --live   (→ NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut live = false
    let mut seed = 20260428
    let mut n_channels = 16
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"    { selftest = true; i = i + 1; continue }
        if a == "--live"        { live = true; i = i + 1; continue }
        if a == "--seed"        { seed = to_int(av[i+1]); i = i + 2; continue }
        if a == "--n-channels"  { n_channels = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --live")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        println("── _integrations/clm_eeg_p3 LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_real_eeg_+scipy_welch_psd")
        println("verdict=PENDING_MIGRATION")
        println("backend=" + LEGACY_PATH)
        eprintln("reason: not-yet-landed: live requires real resting EEG + scipy.welch + .venv-eeg")
        eprintln("fix: run legacy directly: hexa run " + LEGACY_PATH + " --run --input <npy> (post-arrival)")
        exit(4)
    }

    println("== _integrations/clm_eeg_p3 selftest (synth seed=" + str(seed) + ") ==")
    let args_kv = "seed=" + str(seed) + ",n_channels=" + str(n_channels)
    let kv = _integration_clm_eeg_p3_kv(args_kv)
    print(kv)

    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: nominal selftest verdict not PASS — falsifier triggered or sentinel")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
