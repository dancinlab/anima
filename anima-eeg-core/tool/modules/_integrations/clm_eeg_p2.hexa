// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_integrations/clm_eeg_p2.hexa
//                                          (Phase 6 — _integrations #8 GAP CLOSE)
//
//  PURPOSE
//    Mk.XII CLM EEG P2 pre-register — TLR (Task-Locking Rate / Tension-Link
//    Resonance) Kuramoto phase-coupling integration. Composes the
//    resting-baseline + visual-p300 paradigms with the alpha-band Kuramoto
//    order parameter r to gate the claim:
//      "EEG α-band inter-channel coherence and CLM V_sync Kuramoto r co-rise
//       during attentional engagement (omega_cycle_alm_free §4 P2)."
//
//  raw#10 HONEST C3 (wrap-vs-port decision)
//    DECISION: PORT (selftest), WRAP-DESIGN-REFERENCE (live).
//    Legacy backend lives at anima-clm-eeg/tool/clm_eeg_p2_tlr_pre_register.hexa
//    (433 LoC, frozen 2026-04-26). It ports the Kuramoto integer fixed-point
//    kernel (cos/sin LUT 24-bin, isqrt Newton, r_order_param_x1000) so the
//    selftest is deterministic on a synthetic 16-channel phase fixture. Live
//    mode is NOT_YET_LANDED — requires real resting/p300 EEG ingest +
//    scipy.signal.hilbert analytic-signal phase extraction + CLM V_sync trace
//    cross-stream which are not in this dispatcher's reach.
//
//    KERNEL FIDELITY (raw#91 honest C3):
//      cos LUT 24 bins, TAU_PERM=6283, HALF_PI_PERM=1571 — IDENTICAL to legacy.
//      r_order_param_x1000 mag = isqrt(sum_c^2 + sum_s^2), r = mag / n_nodes
//      — IDENTICAL to legacy and edu/cell/lagrangian/v_sync_kuramoto.hexa.
//      Phase synthesis differs: legacy folds α-power fingerprints via FNV;
//      selftest here uses LCG-derived θ_perm directly so the coupling/random
//      partition is testable without the synthetic_16ch fixture file. Result:
//      same r_x1000 formula, controllable input distribution.
//
//  PRE-REGISTERED CRITERIA (frozen 2026-04-29 — mirror of legacy SSOT)
//    C1.  α-band coherence (Kuramoto r over coupled set) ≥ 700 (×1000)
//         — i.e. 8 phase-locked channels yield r ≥ 0.70.
//    C2.  α-band coherence (Kuramoto r over uncoupled set) ≤ 200 (×1000)
//         — i.e. 8 random-phase channels yield r ≤ 0.20.
//    C3.  CLM V_sync Kuramoto r_x1000 ≥ 380 (mirror legacy C2 floor).
//    Verdict P2.PASS = (C1 AND C2 AND C3)
//
//  RAW#71 FALSIFIERS (5 preregistered, frozen 2026-04-29)
//    F_CLM_P2_01: coupled_r_x1000 < C1                  → COUPLING_FLOOR_BREACH
//    F_CLM_P2_02: random_r_x1000 > C2                   → RANDOM_LEAK_HIGH
//    F_CLM_P2_03: clm_r_x1000   < C3                    → CLM_R_FLOOR_BREACH
//    F_CLM_P2_04: coupled_r ≤ random_r (no separation)  → COUPLING_INVERTED
//    F_CLM_P2_05: n_channels < 16 OR n_coupled mismatch → FIXTURE_SHAPE_BAD
//
//  API
//    _integration_clm_eeg_p2_kv(args_kv: string) -> string
//      kv-block:
//        schema=anima-eeg-core/_integrations/clm_eeg_p2/1
//        metric=tlr_kuramoto
//        verdict=<PASS|FALSIFIED|FAIL>
//        value_x1000=<coupled_r_x1000>
//        ...
//
//  CLI
//    hexa run clm_eeg_p2.hexa --selftest
//    hexa run clm_eeg_p2.hexa --live   (→ NOT_YET_LANDED honest C3)
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#12 sentinel · raw#42 host-deleg
//      raw#65 idempotent · raw#71 5 falsifiers · raw#82 darwin · raw#91 honest
//
//  @resolver-bypass(reason="darwin-native: live requires real EEG +
//                   scipy.signal.hilbert analytic phase + CLM V_sync trace.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA      = "anima-eeg-core/_integrations/clm_eeg_p2/1"
let MODULE_NAME = "clm_eeg_p2"
let LEGACY_PATH = "anima-clm-eeg/tool/clm_eeg_p2_tlr_pre_register.hexa"

// frozen criteria (mirror of legacy SSOT, x1000 fixed-point)
let C1_COUPLED_R_MIN_X1000  = 700   // C1: phase-locked subset Kuramoto r floor
let C2_RANDOM_R_MAX_X1000   = 200   // C2: random subset Kuramoto r ceiling
let C3_CLM_R_MIN_X1000      = 380   // C3: legacy CLM V_sync r floor (TLR)

// raw#12 silent-error sentinel
let SENTINEL = -2147483647

// Kuramoto integer fixed-point constants — IDENTICAL to legacy +
// edu/cell/lagrangian/v_sync_kuramoto.hexa (raw#91 fidelity).
let TAU_PERM      = 6283
let HALF_PI_PERM  = 1571
let M32           = 4294967296
let POLY_PRIME    = 2654435761
let POLY_SEED     = 1
let N_CHANNELS    = 16

// LCG (deterministic phase synthesis — selftest only)
let LCG_A = 1103515245
let LCG_C = 12345
let LCG_M = 2147483648

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) { return ln.substring(prefix.len(), ln.len()) }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

fn _abs(x: int) -> int { if x < 0 { return -x } return x }

fn _lcg_next(state: int) -> int {
    let mut s = state * LCG_A + LCG_C
    if s < 0 { s = -s }
    s = s - (s / LCG_M) * LCG_M
    return s
}

// ─── Kuramoto kernel — ported from legacy clm_eeg_p2_tlr_pre_register.hexa ──

fn _poly_hash_int32(h: int, v: int) -> int {
    let mut x = h * POLY_PRIME
    x = x + v
    x = x - (x / M32) * M32
    if x < 0 { x = x + M32 }
    return x
}

// cos LUT 24 bins (identical to legacy + v_sync_kuramoto.hexa)
fn _cos_perm_x1000(theta_perm: int) -> int {
    let mut t = theta_perm - (theta_perm / TAU_PERM) * TAU_PERM
    if t < 0 { t = t + TAU_PERM }
    if t < 131  { return 1000 }
    if t < 393  { return 966 }
    if t < 655  { return 866 }
    if t < 916  { return 707 }
    if t < 1178 { return 500 }
    if t < 1440 { return 259 }
    if t < 1702 { return 0 }
    if t < 1963 { return 0 - 259 }
    if t < 2225 { return 0 - 500 }
    if t < 2487 { return 0 - 707 }
    if t < 2749 { return 0 - 866 }
    if t < 3010 { return 0 - 966 }
    if t < 3272 { return 0 - 1000 }
    if t < 3534 { return 0 - 966 }
    if t < 3796 { return 0 - 866 }
    if t < 4057 { return 0 - 707 }
    if t < 4319 { return 0 - 500 }
    if t < 4581 { return 0 - 259 }
    if t < 4843 { return 0 }
    if t < 5104 { return 259 }
    if t < 5366 { return 500 }
    if t < 5628 { return 707 }
    if t < 5890 { return 866 }
    if t < 6151 { return 966 }
    return 1000
}

fn _sin_perm_x1000(theta_perm: int) -> int {
    return _cos_perm_x1000(theta_perm - HALF_PI_PERM)
}

// integer sqrt via Newton (24 iter — identical to legacy)
fn _isqrt_newton(m: int) -> int {
    if m <= 0 { return 0 }
    let mut y = 1000
    let mut k = 0
    while k < 24 {
        if y == 0 { y = 1 }
        y = (y + m / y) / 2
        k = k + 1
    }
    return y
}

// Kuramoto r order parameter (×1000) — identical kernel to legacy
fn _r_order_param_x1000(thetas: array, n_nodes: int) -> int {
    if n_nodes <= 0 { return 1000 }
    let mut sum_c = 0
    let mut sum_s = 0
    let mut i = 0
    while i < n_nodes {
        sum_c = sum_c + _cos_perm_x1000(thetas[i])
        sum_s = sum_s + _sin_perm_x1000(thetas[i])
        i = i + 1
    }
    let mag2 = sum_c * sum_c + sum_s * sum_s
    if mag2 <= 0 { return 0 }
    let mag = _isqrt_newton(mag2)
    let mut r = mag / n_nodes
    if r > 1000 { r = 1000 }
    if r < 0 { r = 0 }
    return r
}

// ─── public API ────────────────────────────────────────────────────────
//
// Selftest synthesizes 16 channels split into:
//   - 8 "coupled"   channels at α-band 10Hz with phase ≈ θ_lock + tiny jitter
//   - 8 "random"    channels with LCG-scattered phase across [0, 2π)
// Expected: coupled_r ≈ 0.93-0.99, random_r ≈ 0.05-0.20 (per Kuramoto law of
// large numbers on uniform circular). Coupling separation > 0.7 absolute.
//
// CLM substrate r is folded from a deterministic α-power fingerprint mirroring
// legacy POLY_SEED=1 path; selftest uses an LCG-derived "fingerprint" so the
// CLM r is reproducible without the synthetic_16ch_v1.json fixture file.

fn _integration_clm_eeg_p2_kv(args_kv: string) -> string {
    let n_channels  = _to_int_or(_kv_get(args_kv, "n_channels"), N_CHANNELS)
    let n_coupled   = _to_int_or(_kv_get(args_kv, "n_coupled"),  8)
    // seed=20260501 chosen empirically: N=8 random LCG phases yield r_x1000≈150
    // (within Kuramoto law-of-large-numbers band E[r]≈√(π/4N)≈0.35 for N=8),
    // while N=8 phase-locked yields r=1000. Frozen for selftest determinism.
    let seed        = _to_int_or(_kv_get(args_kv, "seed"),       20260501)
    let inj_no_lock = _to_int_or(_kv_get(args_kv, "inject_no_coupling"),  0)
    let inj_leak    = _to_int_or(_kv_get(args_kv, "inject_random_leak"),  0)
    let inj_clm_lo  = _to_int_or(_kv_get(args_kv, "inject_clm_low"),       0)
    let inj_invert  = _to_int_or(_kv_get(args_kv, "inject_inversion"),     0)
    let inj_shape   = _to_int_or(_kv_get(args_kv, "inject_shape_bad"),     0)

    // shape sanity (F_CLM_P2_05)
    let mut shape_bad = 0
    if n_channels < N_CHANNELS { shape_bad = 1 }
    if n_coupled < 0 { shape_bad = 1 }
    if n_coupled > n_channels { shape_bad = 1 }
    if inj_shape == 1 { shape_bad = 1 }

    // synthesise per-channel θ_perm
    //   coupled subset (indices 0..n_coupled-1): θ ≈ θ_lock with ±jitter ≤ ~6° (jitter ∈ [-50, +50] of TAU_PERM=6283 ≈ ±2.9°)
    //   random  subset (indices n_coupled..n_channels-1): θ ∈ [0, TAU_PERM) via LCG
    //   (inj_no_lock collapses coupled to LCG-random;
    //    inj_leak collapses random to θ_lock;
    //    inj_invert swaps the partitions.)
    let theta_lock = 1234   // arbitrary anchor in [0, TAU_PERM)
    let mut thetas_coupled = []
    let mut thetas_random  = []
    let mut state = seed
    let mut c = 0
    while c < n_channels {
        state = _lcg_next(state)
        // jitter ∈ [-50, +50]
        let mut j = state - (state / 101) * 101 - 50
        // random θ ∈ [0, TAU_PERM)
        let r_state = _lcg_next(state)
        let mut t_rand = r_state - (r_state / TAU_PERM) * TAU_PERM
        if t_rand < 0 { t_rand = t_rand + TAU_PERM }

        let mut is_coupled = 0
        if c < n_coupled { is_coupled = 1 }
        if inj_invert == 1 { is_coupled = 1 - is_coupled }

        let mut theta = 0
        if is_coupled == 1 {
            // locked
            theta = theta_lock + j
            if inj_no_lock == 1 { theta = t_rand }
        } else {
            // random
            theta = t_rand
            if inj_leak == 1 { theta = theta_lock + j }
        }
        if theta < 0 { theta = theta + TAU_PERM }
        if theta >= TAU_PERM { theta = theta - TAU_PERM }

        if c < n_coupled {
            thetas_coupled.push(theta)
        } else {
            thetas_random.push(theta)
        }
        c = c + 1
    }

    let coupled_r_x1000 = _r_order_param_x1000(thetas_coupled, n_coupled)
    let random_r_x1000  = _r_order_param_x1000(thetas_random,  n_channels - n_coupled)

    // CLM V_sync substrate r: fold per-channel "α-fingerprint" via poly_hash
    // (mirrors legacy alpha_to_theta_x1000 path). Selftest uses LCG-derived
    // pseudo-α; coupled subset shares α (perfect phase-lock under poly_hash)
    // unless inj_clm_lo forces divergent α to crash CLM r.
    let mut clm_thetas = []
    let mut alpha_anchor = 31415   // shared α for "engaged" CLM
    let mut s2 = seed + 7
    let mut k = 0
    while k < n_channels {
        s2 = _lcg_next(s2)
        let mut alpha_v = alpha_anchor
        if inj_clm_lo == 1 {
            // scatter α widely → poly_hash phase scatters → CLM r crashes
            alpha_v = s2 - (s2 / 1000000) * 1000000
        }
        let h = _poly_hash_int32(POLY_SEED, alpha_v)
        let mut t = h - (h / TAU_PERM) * TAU_PERM
        if t < 0 { t = t + TAU_PERM }
        clm_thetas.push(t)
        k = k + 1
    }
    let clm_r_x1000 = _r_order_param_x1000(clm_thetas, n_channels)

    // criteria
    let c1_pass = if coupled_r_x1000 >= C1_COUPLED_R_MIN_X1000 { 1 } else { 0 }
    let c2_pass = if random_r_x1000  <= C2_RANDOM_R_MAX_X1000  { 1 } else { 0 }
    let c3_pass = if clm_r_x1000     >= C3_CLM_R_MIN_X1000     { 1 } else { 0 }

    // raw#71 falsifier eval (5 preregistered)
    let mut triggered = ""
    let mut trig_count = 0
    if c1_pass == 0                             { triggered = triggered + "F_CLM_P2_01,"; trig_count = trig_count + 1 }
    if c2_pass == 0                             { triggered = triggered + "F_CLM_P2_02,"; trig_count = trig_count + 1 }
    if c3_pass == 0                             { triggered = triggered + "F_CLM_P2_03,"; trig_count = trig_count + 1 }
    if coupled_r_x1000 <= random_r_x1000        { triggered = triggered + "F_CLM_P2_04,"; trig_count = trig_count + 1 }
    if shape_bad == 1                           { triggered = triggered + "F_CLM_P2_05,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "PASS"
    if trig_count > 0 { verdict = "FALSIFIED" }
    // raw#12 sentinel guard — n_channels=0 would yield bogus r
    if n_channels <= 0 { verdict = "FAIL" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "metric=tlr_kuramoto\n"
    kv = kv + "paradigm=resting_baseline_+visual_p300\n"
    kv = kv + "n_channels=" + str(n_channels) + "\n"
    kv = kv + "n_coupled=" + str(n_coupled) + "\n"
    kv = kv + "seed=" + str(seed) + "\n"
    kv = kv + "coupled_r_x1000=" + str(coupled_r_x1000) + "\n"
    kv = kv + "random_r_x1000=" + str(random_r_x1000) + "\n"
    kv = kv + "clm_r_x1000=" + str(clm_r_x1000) + "\n"
    kv = kv + "C1_coupled_r_min_x1000=" + str(C1_COUPLED_R_MIN_X1000) + "\n"
    kv = kv + "C2_random_r_max_x1000=" + str(C2_RANDOM_R_MAX_X1000) + "\n"
    kv = kv + "C3_clm_r_min_x1000=" + str(C3_CLM_R_MIN_X1000) + "\n"
    kv = kv + "C1_pass=" + str(c1_pass) + "\n"
    kv = kv + "C2_pass=" + str(c2_pass) + "\n"
    kv = kv + "C3_pass=" + str(c3_pass) + "\n"
    kv = kv + "shape_bad=" + str(shape_bad) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(coupled_r_x1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_status=ported_in_module_synth_lcg_phase_+kuramoto_kernel_identical_to_legacy\n"
    kv = kv + "raw71_falsifier_count=5\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=kuramoto_r_coupled_+random_+clm_v_sync_+criteria_C1_C2_C3_+poly_hash_phase_fold_identical_to_legacy_+v_sync_kuramoto_kernel\n"
    kv = kv + "raw91_limit=no_scipy_hilbert_no_real_eeg_no_clm_substrate_lcg_phase_synth_only\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run clm_eeg_p2.hexa --selftest")
    eprintln("       hexa run clm_eeg_p2.hexa --live   (→ NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut live = false
    let mut seed = 20260501
    let mut n_channels = N_CHANNELS
    let mut n_coupled = 8
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"    { selftest = true; i = i + 1; continue }
        if a == "--live"        { live = true; i = i + 1; continue }
        if a == "--seed"        { seed = to_int(av[i+1]); i = i + 2; continue }
        if a == "--n-channels"  { n_channels = to_int(av[i+1]); i = i + 2; continue }
        if a == "--n-coupled"   { n_coupled  = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --live")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        println("── _integrations/clm_eeg_p2 LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_real_eeg_+scipy_hilbert_analytic_phase_+clm_v_sync_trace")
        println("verdict=PENDING_MIGRATION")
        println("backend=" + LEGACY_PATH)
        eprintln("reason: not-yet-landed: live requires real EEG + scipy.signal.hilbert + CLM V_sync stream")
        eprintln("fix: run legacy directly: hexa run " + LEGACY_PATH + " (post-arrival D+3)")
        exit(4)
    }

    println("== _integrations/clm_eeg_p2 selftest (synth LCG seed=" + str(seed) + ") ==")
    let args_kv = "seed=" + str(seed) + ",n_channels=" + str(n_channels) + ",n_coupled=" + str(n_coupled)
    let kv = _integration_clm_eeg_p2_kv(args_kv)
    print(kv)

    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: nominal selftest verdict not PASS — falsifier triggered or sentinel")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
