// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_integrations/_integration_test.hexa
//                                                  (Phase 6)
//
//  PURPOSE
//    Phase 6 _integrations integration test — runs all 7 _integrations/ modules
//    in selftest mode and verifies kv-block contract:
//      clm_eeg_p1 | clm_eeg_p3 | berger_validate | artifact_pipeline |
//      rsn_validate | cyborg_token_emit | multi_subject_aggregate
//
//    raw#42 mac-zero-compute compliance: integration test uses each module's
//    SELFTEST mode (synthetic LCG fixtures). For real-data verification, run
//    `bin/eeg integration <name> --live` on host (NOT_YET_LANDED until D+1
//    hardware arrival or .venv-eeg backend resolution).
//
//  RAW raw#9 hexa-only · raw#42 mac-zero-compute · raw#65 idempotent
//      raw#71 falsifier ≥3 (5 per module) · raw#77 audit-jsonl emit
//      raw#91 honest triad · raw#137 80% Pareto
//
//  CLI
//    hexa run _integration_test.hexa
//    hexa run _integration_test.hexa --selftest    (alias)
//    hexa run _integration_test.hexa --audit-jsonl <path>
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA              = "anima-eeg-core/_integrations/integration_test/1"
let INTEGRATIONS_ROOT   = "anima-eeg-core/tool/modules/_integrations"
let AUDIT_DEFAULT       = "state/anima_eeg_core_phase6_integrations_audit.jsonl"

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _now_iso() -> string {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn _run_integration_selftest(module_name: string) -> array {
    let path = INTEGRATIONS_ROOT + "/" + module_name + ".hexa"
    let cmd = _hexa_bin() + " run " + path + " --selftest"
    eprintln("[integration] " + cmd)
    let r = exec_with_status(cmd)
    return [to_string(r[0]), to_int(r[1])]
}

fn _audit_emit(audit_path: string, module_name: string, rc: int, verdict: string,
                value_x1000: string, triggered: string, schema: string) {
    let ts = _now_iso()
    let mut row = "{"
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"module\":\"" + module_name + "\","
    row = row + "\"module_schema\":\"" + schema + "\","
    row = row + "\"verdict\":\"" + verdict + "\","
    row = row + "\"value_x1000\":\"" + value_x1000 + "\","
    row = row + "\"backend_rc\":" + str(rc) + ","
    row = row + "\"raw71_triggered\":\"" + triggered + "\""
    row = row + "}"
    exec("mkdir -p " + _sh_quote("state"))
    let cmd = "printf '%s\\n' " + _sh_quote(row) + " >> " + _sh_quote(audit_path)
    exec(cmd)
}

fn main() {
    let av = argv()
    let mut audit_path = AUDIT_DEFAULT
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--audit-jsonl" { audit_path = av[i+1]; i = i + 2; continue }
        i = i + 1
    }

    println("══════════════════════════════════════════════════════════════")
    println("  anima-eeg-core Phase 6 _integrations integration test")
    println("  schema: " + SCHEMA)
    println("  audit:  " + audit_path)
    println("  raw#42 mac-zero-compute: SELFTEST mode (no real ingest)")
    println("══════════════════════════════════════════════════════════════")

    let modules = [
        "clm_eeg_p1",
        "clm_eeg_p3",
        "berger_validate",
        "artifact_pipeline",
        "rsn_validate",
        "cyborg_token_emit",
        "multi_subject_aggregate"
    ]
    let mut pass_count = 0
    let mut fail_count = 0
    let mut total = 0
    let mut summary = ""
    let mut k = 0
    while k < len(modules) {
        let m = modules[k]
        total = total + 1
        println("")
        println("── [" + str(k + 1) + "/" + str(len(modules)) + "] " + m + " ──")
        let r = _run_integration_selftest(m)
        let out = to_string(r[0])
        let rc  = to_int(r[1])
        let v   = _kv_lookup(out, "verdict")
        let val = _kv_lookup(out, "value_x1000")
        let trig = _kv_lookup(out, "raw71_triggered_ids")
        let schema = _kv_lookup(out, "schema")
        let module_kv = _kv_lookup(out, "module")
        let metric = _kv_lookup(out, "metric")
        let f_count = _kv_lookup(out, "raw71_falsifier_count")

        // raw#12 silent-error-ban: kv contract checks
        let mut module_pass = 1
        let mut errs = ""
        if schema == ""        { module_pass = 0; errs = errs + "missing-schema;" }
        if v == ""             { module_pass = 0; errs = errs + "missing-verdict;" }
        if val == ""           { module_pass = 0; errs = errs + "missing-value_x1000;" }
        if module_kv == ""     { module_pass = 0; errs = errs + "missing-module;" }
        if metric == ""        { module_pass = 0; errs = errs + "missing-metric;" }
        if f_count == ""       { module_pass = 0; errs = errs + "missing-raw71_falsifier_count;" }
        if rc != 0             { module_pass = 0; errs = errs + "selftest-rc=" + str(rc) + ";" }
        if v != "PASS"         { module_pass = 0; errs = errs + "verdict=" + v + ";" }

        if module_pass == 1 {
            println("  schema:    " + schema)
            println("  module:    " + module_kv)
            println("  metric:    " + metric)
            println("  verdict:   " + v + " (value_x1000=" + val + " falsifiers=" + f_count + " triggered=" + trig + ")")
            println("  contract:  PASS")
            pass_count = pass_count + 1
            summary = summary + m + "=" + v + ":PASS,"
        } else {
            println("  contract:  FAIL  errs=" + errs)
            fail_count = fail_count + 1
            summary = summary + m + "=FAIL_CONTRACT,"
        }

        _audit_emit(audit_path, m, rc, v, val, trig, schema)
        k = k + 1
    }

    let nT = len(summary)
    if nT > 0 { summary = summary.substring(0, nT - 1) }

    println("")
    println("══════════════════════════════════════════════════════════════")
    println("Phase 6 _integrations integration summary")
    println("  total:   " + str(total))
    println("  pass:    " + str(pass_count))
    println("  fail:    " + str(fail_count))
    println("  details: " + summary)
    println("  audit:   " + audit_path)
    println("══════════════════════════════════════════════════════════════")

    if fail_count == 0 {
        println("verdict: PHASE6_INTEGRATIONS_INTEGRATION_PASS ✓")
        exit(0)
    }
    println("verdict: PHASE6_INTEGRATIONS_INTEGRATION_FAIL ✗")
    exit(1)
}
