// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_paradigms/daily_life.hexa
//                                                  (Phase 4 — paradigm #2)
//
//  PURPOSE
//    Daily-life EEG paradigm: 5 min × N segments, eyes-open active task. Used
//    by anima-clm-eeg DLE recipe + LZ76 sliding window analysis. raw#18
//    self-host fixpoint: WRAP legacy anima-eeg/tool/daily_life_context_logger
//    .hexa + anima-eeg/tool/eeg_daily_life_verifier.hexa for live ingest;
//    selftest mode synthesises the protocol-log structure (no BrainFlow).
//
//  raw#10 HONEST C3
//    DECISION: WRAP (live) + PORT (selftest). Legacy daily_life_context_logger
//    runs context labelling (privacy F1-F4 falsifiers); legacy
//    eeg_daily_life_verifier runs the 6-criteria DLE pass/fail. Both
//    raw#12 frozen. This module provides the dispatcher-side kv-block
//    contract for paradigm-level orchestration (segment count, total
//    duration, falsifier preregistration).
//
//  API
//    _paradigm_daily_life_kv(args_kv: string) -> string
//      kv-block:
//        schema=anima-eeg-core/_paradigms/daily_life/1
//        paradigm=daily_life
//        duration_s=<int>            (per-segment, default 300)
//        n_segments=<int>            (default 1)
//        sample_rate_hz=125
//        channel_count=16
//        verdict=<PASS|FAIL|FALSIFIED>
//        raw71_falsifier_count=3
//
//  RAW#71 FALSIFIERS (≥3 preregister, frozen 2026-04-28)
//    F_DL_01: per-segment duration_s < 60     → window too short for LZ76
//    F_DL_02: n_segments < 1                  → no recording requested
//    F_DL_03: sample_rate_hz != 125           → wrong board config
//
//  CLI
//    hexa run daily_life.hexa --selftest
//    hexa run daily_life.hexa --duration 300 --segments 1   (live → NOT_YET_LANDED)
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#12 frozen · raw#18 self-host
//      raw#42 mac-zero-compute · raw#65 idempotent · raw#71 ≥3 · raw#82 darwin
//      raw#91 honest triad · raw#95 triad
//
//  @resolver-bypass(reason="darwin-native: legacy backend requires .venv-eeg
//                   + USB; mac selftest synth-only.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA          = "anima-eeg-core/_paradigms/daily_life/1"
let PARADIGM_NAME   = "daily_life"
let LEGACY_LOGGER   = "anima-eeg/tool/daily_life_context_logger.hexa"
let LEGACY_VERIFIER = "anima-eeg/tool/eeg_daily_life_verifier.hexa"

let DEFAULT_DURATION_S      = 300       // 5 min per segment
let DEFAULT_N_SEGMENTS      = 1
let DEFAULT_SAMPLE_RATE_HZ  = 125
let DEFAULT_CHANNEL_COUNT   = 16
let MIN_SEGMENT_S           = 60

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

// ─── public API ────────────────────────────────────────────────────────

fn _paradigm_daily_life_kv(args_kv: string) -> string {
    let dur     = _to_int_or(_kv_get(args_kv, "duration_s"),     DEFAULT_DURATION_S)
    let nseg    = _to_int_or(_kv_get(args_kv, "n_segments"),     DEFAULT_N_SEGMENTS)
    let srh     = _to_int_or(_kv_get(args_kv, "sample_rate_hz"), DEFAULT_SAMPLE_RATE_HZ)
    let chc     = _to_int_or(_kv_get(args_kv, "channel_count"),  DEFAULT_CHANNEL_COUNT)

    let mut triggered = ""
    let mut trig_count = 0
    if dur < MIN_SEGMENT_S          { triggered = triggered + "F_DL_01,"; trig_count = trig_count + 1 }
    if nseg < 1                     { triggered = triggered + "F_DL_02,"; trig_count = trig_count + 1 }
    if srh != DEFAULT_SAMPLE_RATE_HZ { triggered = triggered + "F_DL_03,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "PASS"
    if trig_count > 0 { verdict = "FALSIFIED" }

    let total_s = dur * nseg
    let protocol = "eyes_open_active_task," + str(nseg) + "x" + str(dur) + "s"

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "paradigm=" + PARADIGM_NAME + "\n"
    kv = kv + "duration_s=" + str(dur) + "\n"
    kv = kv + "n_segments=" + str(nseg) + "\n"
    kv = kv + "total_duration_s=" + str(total_s) + "\n"
    kv = kv + "sample_rate_hz=" + str(srh) + "\n"
    kv = kv + "channel_count=" + str(chc) + "\n"
    kv = kv + "protocol_steps=" + protocol + "\n"
    kv = kv + "dle_recipe_compatible=1\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(total_s * 1000) + "\n"
    kv = kv + "backend_logger=" + LEGACY_LOGGER + "\n"
    kv = kv + "backend_verifier=" + LEGACY_VERIFIER + "\n"
    kv = kv + "backend_status=selftest_synth_no_brainflow\n"
    kv = kv + "raw71_falsifier_count=3\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=protocol_log_synth_or_dle_ledger\n"
    kv = kv + "raw91_limit=selftest_synthesis_no_context_capture\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run daily_life.hexa --selftest")
    eprintln("       hexa run daily_life.hexa --duration <s> --segments <n> (live → NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut duration = DEFAULT_DURATION_S
    let mut segments = DEFAULT_N_SEGMENTS
    let mut sample_rate = DEFAULT_SAMPLE_RATE_HZ
    let mut channels = DEFAULT_CHANNEL_COUNT
    let mut live = false
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"        { selftest = true; i = i + 1; continue }
        if a == "--duration"        { duration = to_int(av[i+1]); live = true; i = i + 2; continue }
        if a == "--segments"        { segments = to_int(av[i+1]); live = true; i = i + 2; continue }
        if a == "--sample-rate-hz"  { sample_rate = to_int(av[i+1]); i = i + 2; continue }
        if a == "--channels"        { channels = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --duration <s>")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        println("── _paradigms/daily_life LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_brainflow_record_with_context")
        println("verdict=PENDING_MIGRATION")
        println("backend_logger=" + LEGACY_LOGGER)
        println("backend_verifier=" + LEGACY_VERIFIER)
        eprintln("reason: legacy-backend-pair-needed: live ingest requires logger + verifier chain")
        eprintln("fix: invoke legacy directly: hexa run " + LEGACY_LOGGER + " --record --duration " + str(duration))
        exit(4)
    }

    // selftest mode
    println("== _paradigms/daily_life selftest (synth no-brainflow) ==")
    let args_kv = "duration_s=" + str(duration) + ",n_segments=" + str(segments) +
                  ",sample_rate_hz=" + str(sample_rate) + ",channel_count=" + str(channels)
    let kv = _paradigm_daily_life_kv(args_kv)
    print(kv)

    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: selftest verdict not PASS")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
