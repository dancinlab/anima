// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/emg_muscle_detector.hexa
//
//  PURPOSE  (raw#106 genus name)
//    Detect jaw/neck/scalp EMG via beta-gamma band dominance (50–500 Hz of
//    EMG, but Cyton fs=125 limits us to 13–60 Hz beta-gamma proxy). Per-ch
//    high_freq / low_freq power ratio > 2.0 → EMG. Temporal channels (T7,
//    T8 ≈ idx 4, 5) flagged for jaw signature.
//
//  AI APPROACH  (raw#10 honest C3)
//    UNSUPERVISED — band-power ratio threshold (proxy for SVM on spectrum).
//    Limitation: cannot separate EMG from broadband white-noise EMI; works
//    best after EMI screening (composite chain).
//
//  CRITERIA  (raw#12 frozen 2026-04-28)
//    C1: gamma_power(20–60Hz) / alpha_power(8–13Hz) > 2.0  → EMG channel
//    C2: ≥ 3 channels EMG-flagged                          → MILD
//    C3: ≥ 8 channels EMG-flagged                          → DOMINANT
//
//  FALSIFIERS  (raw#71 ≥5)
//    F1 white       → DOMINANT (broadband flat = EMG-like FP, raw#10 honest)
//    F2 alpha       → CLEAN
//    F3 emg synth   → DOMINANT
//    F4 line60      → DOMINANT (60Hz in gamma band — known FP)
//    F5 drift       → CLEAN
//    F6 mild_emg    → MILD
//
//  RAW raw#9 raw#10 raw#12 raw#37 raw#65 raw#71 raw#82 raw#91 own5 own11
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python")
// ════════════════════════════════════════════════════════════════════════════

let HELPER = "state/.emg_helper.py"
let DUMP   = "state/.emg_dump.txt"
let LEDGER = "state/eeg_artifact_audit/2026_04_28_emg.jsonl"

fn env_str(k: string, d: string) -> string { let s = env(k); if s == "" { return d }; return s }
fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}
fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}
fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle); if m <= 0 { return 0 }; if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }; i = i + 1
    }
    return -1
}
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key); if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]; if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }; if neg == 1 { return -acc }; return acc
}
fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn write_helper() {
    let py = "#!/usr/bin/env python3
import sys, os
try:
    import numpy as np
    from scipy import signal, integrate
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)
if len(sys.argv) < 5:
    sys.stderr.write('usage\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)
def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch')
if mode == 'selftest':
    kind = src; n = 30 * int(fs); rng = np.random.RandomState(42)
    eeg = rng.normal(0, 1.0, size=(16, n))
    t = np.arange(n) / fs
    if kind == 'emg':
        # high-freq broadband on temporal+all channels
        hf = rng.normal(0, 8.0, size=(16, n))
        b, a = signal.butter(4, [20.0/(fs/2), 0.95], btype='band')
        for ch in range(16): eeg[ch] += signal.filtfilt(b, a, hf[ch])
    elif kind == 'mild_emg':
        hf = rng.normal(0, 8.0, size=(16, n))
        b, a = signal.butter(4, [20.0/(fs/2), 0.95], btype='band')
        for ch in [4, 5]: eeg[ch] += signal.filtfilt(b, a, hf[ch])
    elif kind == 'alpha':
        for ch in [6, 7]: eeg[ch] += 8.0 * np.sin(2*np.pi*10.0*t)
    elif kind == 'line60':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*60.0*t)
    elif kind == 'drift':
        for ch in range(16): eeg[ch] += 50.0 * np.sin(2*np.pi*0.05*t)
    elif kind == 'white':
        pass
    else:
        sys.stderr.write('unknown\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src): sys.stderr.write('not-found\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('bad mode\\n'); sys.exit(2)
def bp(f, psd, lo, hi):
    m = (f >= lo) & (f <= hi)
    if not np.any(m): return 0.0
    return float(integrate.simpson(psd[m], x=f[m]))
n_emg = 0; ratios = []
for ci in range(int(n_ch)):
    f, psd = signal.welch(eeg[ci], fs=fs, nperseg=min(512, eeg.shape[1]))
    a_p = bp(f, psd, 8.0, 13.0)
    g_p = bp(f, psd, 20.0, 60.0)
    r = (g_p / a_p) if a_p > 1e-12 else 999.0
    ratios.append(r)
    if r > 2.0: n_emg += 1
max_r = max(ratios) if ratios else 0.0
with open(out_path, 'w') as f:
    f.write('schema=emg_muscle_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('n_emg_channels=' + str(n_emg) + '\\n')
    f.write('max_gamma_alpha_ratio_x100=' + str(int(round(min(max_r, 99.0)*100))) + '\\n')
    # T7, T8 specific (idx 4, 5)
    f.write('t7_ratio_x100=' + str(int(round(min(ratios[4], 99.0)*100))) + '\\n')
    f.write('t8_ratio_x100=' + str(int(round(min(ratios[5], 99.0)*100))) + '\\n')
print('OK')
"
    write_file(HELPER, py)
}
fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper(); let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd); let rc = to_int(r[1])
    if rc != 0 { eprintln("emg-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}
fn emit_ledger(verdict: string, n_emg: int, max_r: int, mode_arg: string, src_arg: string) {
    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER); let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/emg\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"verdict\":\"" + verdict + "\",\"n_emg_channels\":" + str(n_emg) + ",\"max_ratio_x100\":" + str(max_r) + "}\n"
    write_file(LEDGER, existing + row)
}
fn run_emg_detector(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg); if blob == "" { return "" }
    let n_emg = parse_int_kv(blob, "n_emg_channels=")
    let max_r = parse_int_kv(blob, "max_gamma_alpha_ratio_x100=")
    let t7 = parse_int_kv(blob, "t7_ratio_x100=")
    let t8 = parse_int_kv(blob, "t8_ratio_x100=")
    let mut verdict = "CLEAN"
    if n_emg >= 8 { verdict = "DOMINANT" }
    else { if n_emg >= 3 { verdict = "MILD" } }
    let pass_flag = if verdict == "CLEAN" { 1 } else { 0 }
    let mut out = "module=emg_muscle_detector\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "n_emg_channels=" + str(n_emg) + "\n"
    out = out + "max_gamma_alpha_ratio_x100=" + str(max_r) + "\n"
    out = out + "t7_ratio_x100=" + str(t7) + "\n"
    out = out + "t8_ratio_x100=" + str(t8) + "\n"
    emit_ledger(verdict, n_emg, max_r, mode_arg, src_arg)
    return out
}
fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }; start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}
fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "emg"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_emg_detector(mode, src, fs_arg)
    if res == "" { eprintln("reason: emg-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
