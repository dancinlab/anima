// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/eye_blink_detector.hexa
//
//  PURPOSE  (raw#106 genus name)
//    Detect eye-blink artifacts as 200–1000 µV spikes on frontal Fp1/Fp2
//    channels (idx 0,1) using MAD (median absolute deviation) thresholding,
//    then count blink events and compute pollution fraction. Emits per-ch
//    blink count, blink_rate_per_min, verdict ∈ {CLEAN, MILD, DOMINANT}.
//
//  AI APPROACH  (raw#10 honest C3)
//    UNSUPERVISED — MAD-based outlier detection (proxy for 1-D CNN). False
//    positive ≤5% under high-amp alpha collision; manual review for borderline.
//    Future: CNN on Fp1/Fp2 windows once labelled blinks accumulate.
//
//  CRITERIA  (raw#12 frozen 2026-04-28)
//    C1: |x_frontal| > 6 × MAD(x_frontal)        → spike candidate
//    C2: spike ≥ 50 events / 60 s                → DOMINANT
//    C3: 10 ≤ events < 50                        → MILD
//
//  FALSIFIERS  (raw#71 ≥5)
//    F1 white          → CLEAN expected
//    F2 alpha 10 Hz    → CLEAN expected
//    F3 blink synth    → DOMINANT expected
//    F4 line60         → CLEAN (no spikes)
//    F5 drift 0.05 Hz  → CLEAN (slow, not spikes)
//    F6 mild_blink     → MILD expected
//
//  RAW raw#9 raw#10 raw#12 raw#37 raw#65 raw#71 raw#73 raw#82 raw#91 own5 own11
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python")
// ════════════════════════════════════════════════════════════════════════════

let HELPER = "state/.eye_blink_helper.py"
let DUMP   = "state/.eye_blink_dump.txt"
let LEDGER = "state/eeg_artifact_audit/2026_04_28_blink.jsonl"

fn env_str(k: string, d: string) -> string { let s = env(k); if s == "" { return d }; return s }
fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}
fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }; if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }; i = i + 1
    }
    return -1
}
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key); if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]; if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}
fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn write_helper() {
    let py = "#!/usr/bin/env python3
# eye_blink_detector helper — auto-generated (raw#9/raw#37 transient)
import sys, os
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 5:
    sys.stderr.write('usage: helper <mode> <src> <fs> <out>\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch from ' + str(a.shape))

if mode == 'selftest':
    kind = src; n = 60 * int(fs); rng = np.random.RandomState(42)
    eeg = rng.normal(0, 5.0, size=(16, n))
    t = np.arange(n) / fs
    if kind == 'blink':
        # inject 60 blinks (1 per s) on Fp1/Fp2 (ch 0,1) ~ 300 µV spike
        for sec in range(60):
            i0 = int(sec*fs); w = int(0.2*fs)
            for ch in [0, 1]:
                eeg[ch, i0:i0+w] += 300.0 * np.hanning(w)
    elif kind == 'mild_blink':
        for sec in range(0, 60, 3):  # 20 blinks
            i0 = int(sec*fs); w = int(0.2*fs)
            for ch in [0, 1]: eeg[ch, i0:i0+w] += 300.0 * np.hanning(w)
    elif kind == 'alpha':
        for ch in [6, 7]: eeg[ch] += 8.0 * np.sin(2*np.pi*10.0*t)
    elif kind == 'line60':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*60.0*t)
    elif kind == 'drift':
        for ch in range(16): eeg[ch] += 50.0 * np.sin(2*np.pi*0.05*t)
    elif kind == 'white':
        pass
    else:
        sys.stderr.write('unknown kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src): sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('bad mode\\n'); sys.exit(2)

def count_spikes(x, k=6.0, refractory_samples=10):
    med = np.median(x); mad = np.median(np.abs(x - med)) + 1e-9
    thr = k * 1.4826 * mad
    over = np.abs(x - med) > thr
    # refractory: collapse runs separated by < refractory
    n_events = 0; last = -10**9
    idxs = np.where(over)[0]
    for ix in idxs:
        if ix - last >= refractory_samples:
            n_events += 1; last = ix
    return n_events, float(thr), float(med + 0.0)

duration_s = float(n_samp) / fs
total_blinks = 0
ch_blink_counts = []
for ci in [0, 1]:  # Fp1, Fp2
    if ci >= n_ch: ch_blink_counts.append(0); continue
    n_ev, thr, med = count_spikes(eeg[ci, :])
    ch_blink_counts.append(n_ev)
# union estimate: max(Fp1, Fp2) since blinks are bilateral
max_blinks = max(ch_blink_counts) if ch_blink_counts else 0
rate_per_min = (max_blinks / duration_s) * 60.0 if duration_s > 0 else 0.0

with open(out_path, 'w') as f:
    f.write('schema=eye_blink_detector_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('duration_s_x10=' + str(int(round(duration_s*10))) + '\\n')
    f.write('fp1_blinks=' + str(int(ch_blink_counts[0])) + '\\n')
    f.write('fp2_blinks=' + str(int(ch_blink_counts[1])) + '\\n')
    f.write('max_blinks=' + str(int(max_blinks)) + '\\n')
    f.write('blink_rate_per_min_x10=' + str(int(round(rate_per_min*10))) + '\\n')
print('OK')
"
    write_file(HELPER, py)
}

fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd); let rc = to_int(r[1])
    if rc != 0 { eprintln("blink-helper-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}

fn emit_ledger(verdict: string, blinks: int, rate_x10: int, mode_arg: string, src_arg: string) {
    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER); let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/blink\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"verdict\":\"" + verdict + "\",\"max_blinks\":" + str(blinks) + ",\"rate_per_min_x10\":" + str(rate_x10) + "}\n"
    write_file(LEDGER, existing + row)
}

fn run_blink_detector(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg)
    if blob == "" { return "" }
    let max_b = parse_int_kv(blob, "max_blinks=")
    let rate_x10 = parse_int_kv(blob, "blink_rate_per_min_x10=")
    let mut verdict = "CLEAN"
    if max_b >= 50 { verdict = "DOMINANT" }
    else { if max_b >= 10 { verdict = "MILD" } }
    let pass_flag = if verdict == "CLEAN" { 1 } else { 0 }
    let mut out = "module=eye_blink_detector\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "max_blinks=" + str(max_b) + "\n"
    out = out + "blink_rate_per_min_x10=" + str(rate_x10) + "\n"
    out = out + "fp1_blinks=" + str(parse_int_kv(blob, "fp1_blinks=")) + "\n"
    out = out + "fp2_blinks=" + str(parse_int_kv(blob, "fp2_blinks=")) + "\n"
    emit_ledger(verdict, max_b, rate_x10, mode_arg, src_arg)
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "blink"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_blink_detector(mode, src, fs_arg)
    if res == "" { eprintln("reason: blink-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
