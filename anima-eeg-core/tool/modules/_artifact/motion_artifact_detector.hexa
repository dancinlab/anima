// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/motion_artifact_detector.hexa
//
//  PURPOSE  (raw#106 genus name)
//    Detect head/scalp motion via (a) sudden per-channel amplitude jumps
//    > 5 SD and (b) synchronous global cross-channel spikes (motion =
//    multi-channel coherent artifact, distinct from focal blink/EMG).
//    Outputs motion_intervals count, max_global_jump, verdict.
//
//  AI APPROACH  (raw#10 honest C3)
//    UNSUPERVISED — variance change-point + cross-channel mean abs.
//    Limitation: cannot distinguish motion from synchronous EMI burst;
//    EMI must be screened first (composite chain).
//
//  CRITERIA  (raw#12 frozen 2026-04-28)
//    C1: per-ch amplitude > 5 × SD                  → spike
//    C2: ≥ 8 of 16 channels co-spike in 0.1 s       → motion epoch
//    C3: motion_epochs ≥ 5 over recording           → DOMINANT
//
//  FALSIFIERS  (raw#71 ≥5)
//    F1 white         → CLEAN
//    F2 alpha         → CLEAN
//    F3 motion synth  → DOMINANT
//    F4 line60        → CLEAN (not amplitude jump)
//    F5 blink         → MILD/CLEAN (focal Fp1/Fp2 only, not global)
//    F6 mild_motion   → MILD
//
//  RAW raw#9 raw#10 raw#12 raw#37 raw#65 raw#71 raw#82 raw#91 own5 own11
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python")
// ════════════════════════════════════════════════════════════════════════════

let HELPER = "state/.motion_helper.py"
let DUMP   = "state/.motion_dump.txt"
let LEDGER = "state/eeg_artifact_audit/2026_04_28_motion.jsonl"

fn env_str(k: string, d: string) -> string { let s = env(k); if s == "" { return d }; return s }
fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}
fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}
fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }; if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }; i = i + 1
    }
    return -1
}
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key); if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]; if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }; if neg == 1 { return -acc }; return acc
}
fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn write_helper() {
    let py = "#!/usr/bin/env python3
import sys, os
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)
if len(sys.argv) < 5:
    sys.stderr.write('usage\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch')

if mode == 'selftest':
    kind = src; n = 60 * int(fs); rng = np.random.RandomState(42)
    eeg = rng.normal(0, 5.0, size=(16, n))
    t = np.arange(n) / fs
    if kind == 'motion':
        # 10 motion epochs ~0.1s long, all channels co-spike
        for k in range(10):
            i0 = int((k*5 + 1)*fs); w = int(0.1*fs)
            for ch in range(16): eeg[ch, i0:i0+w] += 200.0 * np.sign(rng.randn()) * np.hanning(w)
    elif kind == 'mild_motion':
        for k in range(3):
            i0 = int((k*15 + 5)*fs); w = int(0.1*fs)
            for ch in range(16): eeg[ch, i0:i0+w] += 200.0 * np.sign(rng.randn()) * np.hanning(w)
    elif kind == 'blink':
        for sec in range(60):
            i0 = int(sec*fs); w = int(0.2*fs)
            for ch in [0, 1]: eeg[ch, i0:i0+w] += 300.0 * np.hanning(w)
    elif kind == 'alpha':
        for ch in [6, 7]: eeg[ch] += 8.0 * np.sin(2*np.pi*10.0*t)
    elif kind == 'line60':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*60.0*t)
    elif kind == 'white':
        pass
    else:
        sys.stderr.write('unknown\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src): sys.stderr.write('not-found\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('bad mode\\n'); sys.exit(2)

# per-ch z-score, find spikes > 5σ
sds = np.std(eeg, axis=1, keepdims=True) + 1e-9
mus = np.mean(eeg, axis=1, keepdims=True)
z = np.abs(eeg - mus) / sds
spikes = z > 5.0  # (16, n)
# bin into 0.1s windows; count channels co-spiking
win = max(1, int(0.1 * fs))
nb = n_samp // win
co_count = np.zeros(nb, dtype=np.int32)
for b in range(nb):
    seg = spikes[:, b*win:(b+1)*win]
    co_count[b] = int(np.sum(np.any(seg, axis=1)))
motion_epochs = int(np.sum(co_count >= 8))
max_co = int(np.max(co_count)) if nb > 0 else 0

with open(out_path, 'w') as f:
    f.write('schema=motion_artifact_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('motion_epochs=' + str(motion_epochs) + '\\n')
    f.write('max_coactive_channels=' + str(max_co) + '\\n')
print('OK')
"
    write_file(HELPER, py)
}
fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd); let rc = to_int(r[1])
    if rc != 0 { eprintln("motion-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}
fn emit_ledger(verdict: string, epochs: int, max_co: int, mode_arg: string, src_arg: string) {
    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER); let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/motion\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"verdict\":\"" + verdict + "\",\"motion_epochs\":" + str(epochs) + ",\"max_coactive\":" + str(max_co) + "}\n"
    write_file(LEDGER, existing + row)
}
fn run_motion_detector(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg); if blob == "" { return "" }
    let ep = parse_int_kv(blob, "motion_epochs=")
    let mc = parse_int_kv(blob, "max_coactive_channels=")
    let mut verdict = "CLEAN"
    if ep >= 5 { verdict = "DOMINANT" }
    else { if ep >= 1 { verdict = "MILD" } }
    let pass_flag = if verdict == "CLEAN" { 1 } else { 0 }
    let mut out = "module=motion_artifact_detector\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "motion_epochs=" + str(ep) + "\n"
    out = out + "max_coactive_channels=" + str(mc) + "\n"
    emit_ledger(verdict, ep, mc, mode_arg, src_arg)
    return out
}
fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }; start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}
fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "motion"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_motion_detector(mode, src, fs_arg)
    if res == "" { eprintln("reason: motion-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
