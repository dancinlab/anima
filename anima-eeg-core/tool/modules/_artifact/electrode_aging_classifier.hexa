// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/electrode_aging_classifier.hexa
//
//  PURPOSE  (raw#106 genus name)
//    Classify per-channel electrode aging via current-session noise floor
//    proxy. Baseline noise floor (1–4 Hz delta in eyes-closed resting)
//    deviating > N σ from cohort mean indicates electrode degradation.
//    Long-term: longitudinal regression across multiple sessions (TODO once
//    ≥3 sessions available).
//
//  AI APPROACH  (raw#10 honest C3)
//    UNSUPERVISED single-session — z-score per-ch noise floor against
//    cross-channel median. Limitation: cannot distinguish aging from poor
//    paste application this session; longitudinal data needed.
//
//  CRITERIA  (raw#12 frozen 2026-04-28)
//    C1: per-ch broadband RMS > 3 σ above ch-median        → suspect
//    C2: ≥ 2 channels suspect                              → MILD
//    C3: ≥ 5 channels suspect                              → DOMINANT
//
//  FALSIFIERS  (raw#71 ≥5)
//    F1 white         → CLEAN (uniform)
//    F2 alpha         → MILD (occipital channels elevated)
//    F3 aging synth   → DOMINANT (5 channels boosted)
//    F4 line60        → CLEAN (uniform 60Hz)
//    F5 motion        → CLEAN (transient, RMS uniform)
//    F6 mild_aging    → MILD
//
//  RAW raw#9 raw#10 raw#12 raw#37 raw#65 raw#71 raw#82 raw#91 own5 own11
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python")
// ════════════════════════════════════════════════════════════════════════════

let HELPER = "state/.aging_helper.py"
let DUMP   = "state/.aging_dump.txt"
let LEDGER = "state/eeg_artifact_audit/2026_04_28_aging.jsonl"

fn env_str(k: string, d: string) -> string { let s = env(k); if s == "" { return d }; return s }
fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}
fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}
fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle); if m <= 0 { return 0 }; if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }; i = i + 1
    }
    return -1
}
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key); if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]; if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }; if neg == 1 { return -acc }; return acc
}
fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn write_helper() {
    let py = "#!/usr/bin/env python3
import sys, os
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)
if len(sys.argv) < 5:
    sys.stderr.write('usage\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)
def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch')
if mode == 'selftest':
    kind = src; n = 30 * int(fs); rng = np.random.RandomState(42)
    eeg = rng.normal(0, 5.0, size=(16, n))
    t = np.arange(n) / fs
    if kind == 'aging':
        # 5 channels with elevated noise floor (electrode aging)
        for ch in [2, 5, 8, 11, 14]:
            eeg[ch] += rng.normal(0, 25.0, size=n)
    elif kind == 'mild_aging':
        for ch in [2, 5]: eeg[ch] += rng.normal(0, 25.0, size=n)
    elif kind == 'alpha':
        for ch in [6, 7]: eeg[ch] += 8.0 * np.sin(2*np.pi*10.0*t)
    elif kind == 'line60':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*60.0*t)
    elif kind == 'motion':
        for k in range(10):
            i0 = int((k*5+1)*fs); w = int(0.1*fs)
            for ch in range(16): eeg[ch, i0:i0+w] += 200.0 * np.sign(rng.randn()) * np.hanning(w)
    elif kind == 'white':
        pass
    else:
        sys.stderr.write('unknown\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src): sys.stderr.write('not-found\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('bad mode\\n'); sys.exit(2)

# per-ch broadband RMS
rms = np.sqrt(np.mean(eeg*eeg, axis=1))
med = float(np.median(rms))
mad = float(np.median(np.abs(rms - med))) + 1e-9
sigma = 1.4826 * mad
suspect = []
for ci in range(int(n_ch)):
    z = (rms[ci] - med) / sigma if sigma > 1e-9 else 0.0
    if z > 3.0: suspect.append(ci)

with open(out_path, 'w') as f:
    f.write('schema=electrode_aging_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('n_suspect=' + str(len(suspect)) + '\\n')
    f.write('median_rms_x100=' + str(int(round(med*100))) + '\\n')
    f.write('mad_rms_x100=' + str(int(round(mad*100))) + '\\n')
    f.write('suspect_channels=' + ','.join(str(s) for s in suspect) + '\\n')
print('OK')
"
    write_file(HELPER, py)
}
fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper(); let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd); let rc = to_int(r[1])
    if rc != 0 { eprintln("aging-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}
fn emit_ledger(verdict: string, n_susp: int, med: int, mode_arg: string, src_arg: string) {
    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER); let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/aging\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"verdict\":\"" + verdict + "\",\"n_suspect\":" + str(n_susp) + ",\"median_rms_x100\":" + str(med) + "}\n"
    write_file(LEDGER, existing + row)
}
fn run_aging_classifier(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg); if blob == "" { return "" }
    let n_susp = parse_int_kv(blob, "n_suspect=")
    let med = parse_int_kv(blob, "median_rms_x100=")
    let mut verdict = "CLEAN"
    if n_susp >= 5 { verdict = "DOMINANT" }
    else { if n_susp >= 2 { verdict = "MILD" } }
    let pass_flag = if verdict == "CLEAN" { 1 } else { 0 }
    let mut out = "module=electrode_aging_classifier\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "n_suspect=" + str(n_susp) + "\n"
    out = out + "median_rms_x100=" + str(med) + "\n"
    emit_ledger(verdict, n_susp, med, mode_arg, src_arg)
    return out
}
fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }; start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}
fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "aging"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_aging_classifier(mode, src, fs_arg)
    if res == "" { eprintln("reason: aging-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
