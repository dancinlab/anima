// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_gates/rms_band.hexa  (Phase 2 — gate #2)
//
//  PURPOSE
//    Per-channel RMS amplitude band gate. Normal awake EEG sits in the
//    5–100 µV envelope (Niedermeyer-style textbook range). Battery dying /
//    broadband noise blows RMS far above; saline-dry electrodes yield
//    very low RMS. This gate is orthogonal to spectral-shape (Berger) gate.
//
//  API     run_rms_band_gate(npy_path) → key=value dump
//          fields: pass, median_rms_x10, in_band_ratio_x100, per-ch RMS
//
//  CRITERIA (raw#12 frozen 2026-04-28)
//    C1: median(rms_per_ch) ∈ [5, 100] µV
//    C2: in_band_ratio > 0.5  (≥9 of 16 channels in band)
//
//  RAW raw#9 hexa-only · raw#10 honest · raw#12 frozen · raw#37 transient
//      raw#65 gate · raw#82 venv-eeg · raw#91 honest · own5
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host")
// ════════════════════════════════════════════════════════════════════════════

let RMS_LO_UV_X10 = 50      // 5.0 µV
let RMS_HI_UV_X10 = 1000    // 100 µV
let IN_BAND_MIN_X100 = 50   // 0.50

let HELPER = "state/.rms_band_gate_helper.py"
let DUMP   = "state/.rms_band_gate_dump.txt"

fn env_str(k: string, d: string) -> string {
    let s = env(k)
    if s == "" { return d }
    return s
}

fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn write_helper() {
    let py = "#!/usr/bin/env python3
# rms_band_gate helper. raw#9 transient .py; raw#37 re-written each call.
import sys, os
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 4:
    sys.stderr.write('usage: helper <mode> <input_or_kind> <out>\\n'); sys.exit(2)
mode, src, out_path = sys.argv[1], sys.argv[2], sys.argv[3]

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch from ' + str(a.shape))

if mode == 'selftest':
    kind = src
    n = 60 * 125
    rng = np.random.RandomState(13)
    eeg = np.zeros((16, n), dtype=np.float64)
    if kind == 'awake':
        # ~20 µV broadband — typical awake amplitude
        for ch in range(16):
            eeg[ch, :] = 20.0 * rng.normal(0, 1, n)
    elif kind == 'flatline':
        pass  # zero -> RMS 0
    elif kind == 'broadband_huge':
        # battery dying / saturated — RMS thousands µV
        for ch in range(16):
            eeg[ch, :] = 5000.0 * rng.normal(0, 1, n)
    elif kind == 'tiny':
        for ch in range(16):
            eeg[ch, :] = 0.5 * rng.normal(0, 1, n)
    else:
        sys.stderr.write('unknown kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('unknown mode\\n'); sys.exit(2)

rms_per_ch = []
for ch in range(n_ch):
    x = np.asarray(eeg[ch, :], dtype=np.float64)
    rms_per_ch.append(float(np.sqrt(np.mean(x * x))))
rms_per_ch = np.array(rms_per_ch)
median_rms = float(np.median(rms_per_ch))
LO, HI = 5.0, 100.0
in_band = int(np.sum((rms_per_ch >= LO) & (rms_per_ch <= HI)))
in_band_ratio = float(in_band) / float(n_ch)

with open(out_path, 'w') as f:
    f.write('schema=rms_band_gate_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('median_rms_x10=' + str(int(round(median_rms * 10))) + '\\n')
    f.write('in_band_count=' + str(int(in_band)) + '\\n')
    f.write('in_band_ratio_x100=' + str(int(round(in_band_ratio * 100))) + '\\n')
    for ch in range(n_ch):
        f.write('rms_ch' + str(ch) + '_x10=' + str(int(round(rms_per_ch[ch] * 10))) + '\\n')
print('OK median=' + ('%.2f' % median_rms))
"
    write_file(HELPER, py)
}

fn run_helper(mode_arg: string, src_arg: string) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" \"" + DUMP + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 { eprintln("rms-band-gate-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}

fn run_rms_band_gate(mode_arg: string, src_arg: string) -> string {
    let blob = run_helper(mode_arg, src_arg)
    if blob == "" { return "" }
    let med = parse_int_kv(blob, "median_rms_x10=")
    let ibr = parse_int_kv(blob, "in_band_ratio_x100=")
    let ibc = parse_int_kv(blob, "in_band_count=")
    let c1 = if med >= RMS_LO_UV_X10 && med <= RMS_HI_UV_X10 { 1 } else { 0 }
    let c2 = if ibr > IN_BAND_MIN_X100 { 1 } else { 0 }
    let pass_flag = if c1 == 1 && c2 == 1 { 1 } else { 0 }
    let verdict = if pass_flag == 1 { "PASS" } else { "FAIL" }
    let mut out = "gate=rms_band\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "median_rms_x10=" + str(med) + "\n"
    out = out + "in_band_ratio_x100=" + str(ibr) + "\n"
    out = out + "in_band_count=" + str(ibc) + "\n"
    out = out + "c1_median_in_band=" + str(c1) + "\n"
    out = out + "c2_in_band_ratio_pass=" + str(c2) + "\n"
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "awake"; let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        i = i + 1
    }
    let res = run_rms_band_gate(mode, src)
    if res == "" { eprintln("reason: rms-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
