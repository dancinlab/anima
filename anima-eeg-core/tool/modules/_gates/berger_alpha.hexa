// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_gates/berger_alpha.hexa  (Phase 2 — gate #1)
//
//  PURPOSE  (raw#106 genus name)
//    Berger 1929 occipital alpha gate.  Eyes-closed resting EEG must show
//    8–13 Hz alpha rhythm dominating delta/theta/beta on O1 (ch idx 6) and
//    O2 (ch idx 7).  This is gate #1 of the 4-gate validity protocol — if
//    Berger fails, all downstream EEG metrics are uninterpretable (raw#10).
//
//  API     run_berger_gate(npy_path, fs, occipital_chans=[6,7])
//          → key=value dump + JSON cert containing:
//              pass (bool), peak_freq_x10 per ch, alpha_beta_ratio_x1000,
//              alpha_delta_ratio_x1000, verdict ∈ {PASS,PARTIAL,FAIL}
//
//  CRITERIA  (raw#12 frozen 2026-04-28)
//    C1: alpha_power > beta_power           (per occipital ch)
//    C2: alpha_power > 0.30 × delta_power   (per occipital ch)
//    C3: peak_freq ∈ [7,14] Hz              (per occipital ch)
//
//  RAW  raw#9 hexa-only (.py /tmp-only) · raw#10 honest · raw#12 frozen
//       raw#37 transient helper · raw#65 gate · raw#82 venv-eeg ·
//       raw#91 honest classification · own5 (genus-name; 3 falsifiers F1
//       white/F2 line50/F3 alpha; counter-example DC drift)
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host")
// ════════════════════════════════════════════════════════════════════════════

let DELTA_FACTOR_PERMILLE = 300
let PEAK_HZ_LO_X10        = 70
let PEAK_HZ_HI_X10        = 140

let HELPER = "state/.berger_alpha_gate_helper.py"
let DUMP   = "state/.berger_alpha_gate_dump.txt"

fn env_str(k: string, d: string) -> string {
    let s = env(k)
    if s == "" { return d }
    return s
}

fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key)
    let mut acc = 0
    let mut neg = 0
    let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn write_helper() {
    let py = "#!/usr/bin/env python3
# berger_alpha_gate helper — auto-generated by anima-eeg-core/tool/modules/_gates/berger_alpha.hexa
# raw#9 OK transient .py helper; raw#37 re-written each call.
import sys, os
try:
    import numpy as np
    from scipy import signal, integrate
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 5:
    sys.stderr.write('usage: helper <mode> <input_or_kind> <fs> <out.txt>\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)
nperseg = 512

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch from ' + str(a.shape))

if mode == 'selftest':
    kind = src
    n = 60 * int(fs)
    rng = np.random.RandomState(42)
    eeg = np.zeros((16, n), dtype=np.float64)
    t = np.arange(n) / fs
    for ch in range(16):
        eeg[ch, :] = rng.normal(0, 1.0, size=n)
    if kind == 'alpha' or kind == 'awake':
        for ch in [6, 7]: eeg[ch, :] += 8.0 * np.sin(2 * np.pi * 10.0 * t)
    elif kind == 'line50':
        for ch in [6, 7]: eeg[ch, :] += 8.0 * np.sin(2 * np.pi * 50.0 * t)
    elif kind == 'drift':
        for ch in [6, 7]: eeg[ch, :] += 50.0 * np.sin(2 * np.pi * 0.05 * t)
    elif kind == 'white':
        pass
    else:
        sys.stderr.write('unknown kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('unknown mode\\n'); sys.exit(2)

def welch_band(x):
    f, psd = signal.welch(x, fs=fs, nperseg=min(nperseg, len(x)))
    def bp(lo, hi):
        m = (f >= lo) & (f <= hi)
        return float(integrate.simpson(psd[m], x=f[m])) if np.any(m) else 0.0
    delta = bp(1.0, 4.0); theta = bp(4.0, 8.0)
    alpha = bp(8.0, 13.0); beta = bp(13.0, 30.0)
    m = (f >= 1.0) & (f <= 40.0)
    peak = float(f[m][int(np.argmax(psd[m]))]) if np.any(m) else 0.0
    return delta, theta, alpha, beta, peak

with open(out_path, 'w') as f:
    f.write('schema=berger_alpha_gate_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    for lbl, ci in [('o1', 6), ('o2', 7)]:
        if ci >= n_ch: sys.stderr.write('ch-oob: ' + lbl + '\\n'); sys.exit(5)
        d, t_, a, b, pk = welch_band(eeg[ci, :])
        f.write(lbl + '_delta_x1e6=' + str(int(round(d*1e6))) + '\\n')
        f.write(lbl + '_alpha_x1e6=' + str(int(round(a*1e6))) + '\\n')
        f.write(lbl + '_beta_x1e6='  + str(int(round(b*1e6))) + '\\n')
        f.write(lbl + '_peak_hz_x10=' + str(int(round(pk*10))) + '\\n')
        # ratios x1000
        ab = (a / b) if b > 0 else 0.0
        ad = (a / d) if d > 0 else 0.0
        f.write(lbl + '_alpha_beta_ratio_x1000=' + str(int(round(ab*1000))) + '\\n')
        f.write(lbl + '_alpha_delta_ratio_x1000=' + str(int(round(ad*1000))) + '\\n')
print('OK')
"
    write_file(HELPER, py)
}

fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 {
        eprintln("berger-alpha-gate-rc=" + str(rc) + " out=" + to_string(r[0]))
        return ""
    }
    return read_file(DUMP)
}

// ─── public gate API ─────────────────────────────────────────────────────
// run_berger_gate: returns key=value dump string. Caller parses pass / peak /
// ratio fields. Empty string on helper failure.
fn run_berger_gate(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg)
    if blob == "" { return "" }
    let o1_a = parse_int_kv(blob, "o1_alpha_x1e6=")
    let o1_b = parse_int_kv(blob, "o1_beta_x1e6=")
    let o1_d = parse_int_kv(blob, "o1_delta_x1e6=")
    let o1_pk = parse_int_kv(blob, "o1_peak_hz_x10=")
    let o2_a = parse_int_kv(blob, "o2_alpha_x1e6=")
    let o2_b = parse_int_kv(blob, "o2_beta_x1e6=")
    let o2_d = parse_int_kv(blob, "o2_delta_x1e6=")
    let o2_pk = parse_int_kv(blob, "o2_peak_hz_x10=")
    let o1_c1 = if o1_a > o1_b { 1 } else { 0 }
    let o1_c2 = if o1_a * 1000 > o1_d * DELTA_FACTOR_PERMILLE { 1 } else { 0 }
    let o1_c3 = if o1_pk >= PEAK_HZ_LO_X10 && o1_pk <= PEAK_HZ_HI_X10 { 1 } else { 0 }
    let o2_c1 = if o2_a > o2_b { 1 } else { 0 }
    let o2_c2 = if o2_a * 1000 > o2_d * DELTA_FACTOR_PERMILLE { 1 } else { 0 }
    let o2_c3 = if o2_pk >= PEAK_HZ_LO_X10 && o2_pk <= PEAK_HZ_HI_X10 { 1 } else { 0 }
    let o1_full = if o1_c1 == 1 && o1_c2 == 1 && o1_c3 == 1 { 1 } else { 0 }
    let o2_full = if o2_c1 == 1 && o2_c2 == 1 && o2_c3 == 1 { 1 } else { 0 }
    let mut verdict = "FAIL"
    if o1_full == 1 && o2_full == 1 { verdict = "PASS" }
    else { if o1_c3 == 1 || o2_c3 == 1 { verdict = "PARTIAL" } }
    let pass_flag = if verdict == "PASS" { 1 } else { 0 }
    let mut out = "gate=berger_alpha\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "o1_peak_hz_x10=" + str(o1_pk) + "\n"
    out = out + "o2_peak_hz_x10=" + str(o2_pk) + "\n"
    out = out + "o1_c1c2c3=" + str(o1_c1) + str(o1_c2) + str(o1_c3) + "\n"
    out = out + "o2_c1c2c3=" + str(o2_c1) + str(o2_c2) + str(o2_c3) + "\n"
    out = out + "o1_alpha_beta_ratio_x1000=" + str(parse_int_kv(blob, "o1_alpha_beta_ratio_x1000=")) + "\n"
    out = out + "o1_alpha_delta_ratio_x1000=" + str(parse_int_kv(blob, "o1_alpha_delta_ratio_x1000=")) + "\n"
    out = out + "o2_alpha_beta_ratio_x1000=" + str(parse_int_kv(blob, "o2_alpha_beta_ratio_x1000=")) + "\n"
    out = out + "o2_alpha_delta_ratio_x1000=" + str(parse_int_kv(blob, "o2_alpha_delta_ratio_x1000=")) + "\n"
    return out
}

fn flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"
    let mut src = "alpha"
    let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_berger_gate(mode, src, fs_arg)
    if res == "" { eprintln("reason: berger-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
