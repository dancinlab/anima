// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_gates/composite_gate.hexa  (Phase 2 — composite)
//
//  PURPOSE
//    Run all 4 validity gates (berger_alpha, rms_band, pe_saturation,
//    hjorth_band) on a single .npy input or selftest preset and emit a
//    composite verdict. all_pass = berger ∧ rms ∧ pe ∧ hjorth (raw#10
//    honest: 1+ FAIL → downstream metrics meaningless).
//
//  API     run_all_gates(npy_path, fs)
//          → key=value text + JSON cert
//
//  RAW raw#9 hexa-only · raw#10 honest · raw#65 gate · raw#82 venv-eeg ·
//      raw#91 honest · own5
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host")
// ════════════════════════════════════════════════════════════════════════════

let GATE_DIR = "anima-eeg-core/tool/modules/_gates"

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

// Invoke a gate via $HEXA_LANG/hexa.real, capture stdout (which is the
// key=value gate result blob).
fn invoke_gate(gate_name: string, mode_arg: string, src_arg: string) -> string {
    let hexa_lang = env("HEXA_LANG")
    let mut hexa_bin = "/Users/ghost/core/hexa-lang/hexa.real"
    if hexa_lang != "" { hexa_bin = hexa_lang + "/hexa.real" }
    let path = GATE_DIR + "/" + gate_name + ".hexa"
    let mut flag = "--selftest-mode"
    if mode_arg == "real" { flag = "--input" }
    let cmd = hexa_bin + " run " + path + " -- " + flag + " \"" + src_arg + "\""
    let r = exec_with_status(cmd)
    return to_string(r[0])
}

fn pass_of(blob: string) -> int {
    let p = parse_int_kv(blob, "pass=")
    if p == 1 { return 1 }
    return 0
}

fn run_all_gates(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let b_blob = invoke_gate("berger_alpha", mode_arg, src_arg)
    let r_blob = invoke_gate("rms_band", mode_arg, src_arg)
    let p_blob = invoke_gate("pe_saturation", mode_arg, src_arg)
    let h_blob = invoke_gate("hjorth_band", mode_arg, src_arg)
    let bp = pass_of(b_blob)
    let rp = pass_of(r_blob)
    let pp = pass_of(p_blob)
    let hp = pass_of(h_blob)
    let all_pass = if bp == 1 && rp == 1 && pp == 1 && hp == 1 { 1 } else { 0 }
    let mut out = "composite=eeg_validity_4gate\n"
    out = out + "ts=" + now_iso() + "\n"
    out = out + "mode=" + mode_arg + "\n"
    out = out + "input=" + src_arg + "\n"
    out = out + "berger_pass=" + str(bp) + "\n"
    out = out + "rms_pass=" + str(rp) + "\n"
    out = out + "pe_pass=" + str(pp) + "\n"
    out = out + "hjorth_pass=" + str(hp) + "\n"
    out = out + "all_pass=" + str(all_pass) + "\n"
    out = out + "── per-gate detail ──\n"
    out = out + "[berger_alpha]\n" + b_blob + "\n"
    out = out + "[rms_band]\n" + r_blob + "\n"
    out = out + "[pe_saturation]\n" + p_blob + "\n"
    out = out + "[hjorth_band]\n" + h_blob + "\n"
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "awake"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_all_gates(mode, src, fs_arg)
    print(res)
    let ap = parse_int_kv(res, "all_pass=")
    if ap == 1 { exit(0) }
    exit(1)
}
