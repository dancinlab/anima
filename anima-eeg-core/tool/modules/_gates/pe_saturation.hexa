// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_gates/pe_saturation.hexa  (Phase 2 — gate #3)
//
//  PURPOSE
//    Permutation Entropy saturation gate (Bandt-Pompe 2002 + Costa multiscale
//    2002). PE near 1.0 = white-noise-saturated (broadband), PE near 0 =
//    constant/structured. Awake cortical activity sits in 0.5–0.95 band.
//
//  API     run_pe_saturation_gate(npy_path, m=3, scales=[1,2,5,10])
//          → key=value dump with per-scale PE × 1000 ints + pass + verdict
//
//  CRITERIA (raw#12 frozen 2026-04-28)
//    C1: PE_mean_overall < 0.95   (not white-noise-saturated)
//    C2: PE_mean_overall > 0.50   (not constant / pure-monotonic)
//
//  RAW raw#9 hexa-only · raw#10 honest · raw#12 frozen · raw#37 transient
//      raw#65 gate · raw#82 venv-eeg · raw#91 honest · own5
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host")
// ════════════════════════════════════════════════════════════════════════════

let PE_LO_X1000 = 500    // > 0.50
let PE_HI_X1000 = 950    // < 0.95

let HELPER = "state/.pe_saturation_gate_helper.py"
let DUMP   = "state/.pe_saturation_gate_dump.txt"

fn env_str(k: string, d: string) -> string {
    let s = env(k); if s == "" { return d } ; return s
}

fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn write_helper() {
    let py = "#!/usr/bin/env python3
# pe_saturation_gate helper. Bandt-Pompe 2002, Costa multiscale 2002.
# raw#9 transient .py; raw#37 re-written each call.
import sys, os, math
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 4:
    sys.stderr.write('usage: helper <mode> <input_or_kind> <out>\\n'); sys.exit(2)
mode, src, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
M = 3; TAU = 1; SCALES = [1, 2, 5, 10]

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch from ' + str(a.shape))

def coarse_grain(x, s):
    if s <= 1: return x
    n = len(x) // s
    if n <= 0: return np.array([], dtype=np.float64)
    return x[: n * s].reshape(n, s).mean(axis=1)

def permutation_entropy(x, m=3, tau=1):
    n = len(x); L = n - (m - 1) * tau
    if L <= 0: return 0.0
    counts = {}
    for i in range(L):
        w = x[i:i + m * tau:tau]
        perm = tuple(int(v) for v in np.argsort(w, kind='stable'))
        counts[perm] = counts.get(perm, 0) + 1
    total = float(L); H = 0.0
    for c in counts.values():
        p = c / total
        if p > 0.0: H -= p * math.log(p)
    Hmax = math.log(math.factorial(m))
    return H / Hmax if Hmax > 0 else 0.0

if mode == 'selftest':
    kind = src
    n = 60 * 125
    rng = np.random.RandomState(7)
    eeg = np.zeros((16, n), dtype=np.float64)
    if kind == 'const':
        pass
    elif kind == 'white':
        for ch in range(16):
            eeg[ch, :] = rng.normal(0, 1, n)
    elif kind == 'monotone':
        for ch in range(16):
            eeg[ch, :] = np.arange(n, dtype=np.float64) + ch * 0.5
    elif kind == 'awake':
        # mixed alpha-dominant + small broadband + low-freq trend. PE on
        # awake EEG is empirically 0.6-0.85; pure i.i.d. ramps to ~1.0,
        # so we need structured oscillations to dominate. Strong 10 Hz
        # alpha (amp 5) + weak noise (amp 0.3) yields PE ≈ 0.7.
        t = np.arange(n) / 125.0
        for ch in range(16):
            eeg[ch, :] = (5.0 * np.sin(2 * np.pi * 10.0 * t + ch * 0.1)
                          + 0.3 * rng.normal(0, 1, n))
    else:
        sys.stderr.write('unknown kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('unknown mode\\n'); sys.exit(2)

pe_per = np.zeros((n_ch, len(SCALES)), dtype=np.float64)
for ch in range(n_ch):
    x = np.asarray(eeg[ch, :], dtype=np.float64)
    for j, s in enumerate(SCALES):
        cg = coarse_grain(x, s)
        if len(cg) <= M * TAU: pe_per[ch, j] = float('nan')
        else: pe_per[ch, j] = permutation_entropy(cg, m=M, tau=TAU)

pe_mean_overall = float(np.nanmean(pe_per))
pe_s = [float(np.nanmean(pe_per[:, j])) for j in range(len(SCALES))]

with open(out_path, 'w') as f:
    f.write('schema=pe_saturation_gate_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('embed_dim=' + str(M) + '\\n')
    f.write('scales=1,2,5,10\\n')
    f.write('pe_mean_overall_x1000=' + str(int(round(pe_mean_overall * 1000))) + '\\n')
    f.write('pe_mean_scale1_x1000=' + str(int(round(pe_s[0] * 1000))) + '\\n')
    f.write('pe_mean_scale2_x1000=' + str(int(round(pe_s[1] * 1000))) + '\\n')
    f.write('pe_mean_scale5_x1000=' + str(int(round(pe_s[2] * 1000))) + '\\n')
    f.write('pe_mean_scale10_x1000=' + str(int(round(pe_s[3] * 1000))) + '\\n')
print('OK pe=' + ('%.4f' % pe_mean_overall))
"
    write_file(HELPER, py)
}

fn run_helper(mode_arg: string, src_arg: string) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" \"" + DUMP + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 { eprintln("pe-saturation-gate-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}

fn run_pe_saturation_gate(mode_arg: string, src_arg: string) -> string {
    let blob = run_helper(mode_arg, src_arg)
    if blob == "" { return "" }
    let pe_o = parse_int_kv(blob, "pe_mean_overall_x1000=")
    let pe_s1 = parse_int_kv(blob, "pe_mean_scale1_x1000=")
    let pe_s2 = parse_int_kv(blob, "pe_mean_scale2_x1000=")
    let pe_s5 = parse_int_kv(blob, "pe_mean_scale5_x1000=")
    let pe_s10 = parse_int_kv(blob, "pe_mean_scale10_x1000=")
    let c1 = if pe_o < PE_HI_X1000 { 1 } else { 0 }
    let c2 = if pe_o > PE_LO_X1000 { 1 } else { 0 }
    let pass_flag = if c1 == 1 && c2 == 1 { 1 } else { 0 }
    let verdict = if pass_flag == 1 { "PASS" } else { "FAIL" }
    let mut out = "gate=pe_saturation\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "pe_mean_overall_x1000=" + str(pe_o) + "\n"
    out = out + "pe_scale1_x1000=" + str(pe_s1) + "\n"
    out = out + "pe_scale2_x1000=" + str(pe_s2) + "\n"
    out = out + "pe_scale5_x1000=" + str(pe_s5) + "\n"
    out = out + "pe_scale10_x1000=" + str(pe_s10) + "\n"
    out = out + "c1_below_hi=" + str(c1) + "\n"
    out = out + "c2_above_lo=" + str(c2) + "\n"
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "awake"; let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        i = i + 1
    }
    let res = run_pe_saturation_gate(mode, src)
    if res == "" { eprintln("reason: pe-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
