// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_prng/pcg32_native.hexa
//
//  PURPOSE
//    Pure-native PORT of Melissa O'Neill's PCG32 (XSH-RR variant) deterministic
//    32-bit PRNG (O'Neill 2014, http://www.pcg-random.org/, pcg32-minimal.c).
//    Together with splitmix64_native (used as the seq-mixer), this module
//    provides the hexa-native PRNG infrastructure that unblocks Phase 5b
//    pe_native byte-identical cross-host validation.
//
//    Phase 5b unlock plan:
//      pe_native.hexa currently consumes numpy.random.RandomState (MT19937 +
//      Box-Muller) for its synthetic stream. That is architecturally non-
//      byte-identical across darwin↔linux because Box-Muller depends on libm
//      sqrt/log which differ in last-bit ULP between platforms. Replacing
//      the input source with this hexa-native PCG32 (uniform-only — pe_native
//      never needs gaussian) removes the libm coupling and enables strict
//      byte-identity (against this module's own python reference, NOT vs
//      O'Neill C upstream — see raw#10 BYTE-IDENTITY CONTRACT).
//
//  raw#10 HONEST C3
//    DECISION: PORT (full numeric core, native).
//    Rationale:
//      • PCG32 is small (~30 lines C), avoids libm.
//      • Statistically robust per BigCrush, more than enough for surrogate
//        sample construction in EEG metric selftests.
//      • O'Neill's reference C uses uint64 mul + uint32 wraparound that we
//        cannot express byte-identically in hexa surface (see contract below)
//        — we accept "hexa-internal reference" semantics (NOT Vigna/O'Neill
//        upstream byte-identity).
//
//    BYTE-IDENTITY CONTRACT (raw#10 honest)
//      This is a "63-bit-effective" hexa port. Hexa surface ints are signed
//      int64 with no guaranteed wraparound semantics for 64-bit overflow
//      multiplication, and the parser silent-rejects `<<` and `|`. We
//      therefore use:
//        • MASK63 = 2^63 - 1   (state mod 2^63 instead of mod 2^64)
//        • MASK32 = 2^32 - 1   (output mod 2^32, identical to upstream)
//        • multiplications wrapped via Russian-peasant mul_mod63
//        • shifts via `* pow2(n)` and `/ pow2(n)`
//        • bitwise OR via `bor()` emulation
//      Result: this module is NOT byte-identical with O'Neill's C
//      pcg32-minimal.c (which uses uint64 state mod 2^64). It IS byte-
//      identical with our pure-Python reference (`_pcg32_reference.py`),
//      which mirrors the same int63 modular state arithmetic. For the
//      pe_native UNLOCK consumer, hexa-internal reference is sufficient
//      (the consumer reads the same module).
//
//  ALGORITHM (PCG XSH-RR; O'Neill 2014)
//    state' = state * MULT + (inc | 1)             (mod 2^63 in our port)
//    xorshifted = ((state >> 18) ^ state) >> 27
//    rot = state >> 59
//    output = (xorshifted >> rot) | (xorshifted << ((-rot) & 31))   (mod 2^32)
//
//    Where MULT = 6364136223846793005 (decimal) — fits in int63
//    (6364136223846793005 < 2^63 = 9223372036854775808). seq is mixed via
//    splitmix64 so users do not need to think about correlated seq channels.
//
//  API
//    fn pcg32_seed(seed: int, seq: int) -> list             // [state, inc]
//    fn pcg32_next(s: list) -> list                         // [new_state, new_inc, output_uint32]
//    fn pcg32_uniform_x1e6(s: list) -> list                 // [new_state, new_inc, fixed_point_uniform]
//    fn pcg32_int_range(s: list, lo: int, hi: int) -> list  // [new_state, new_inc, int_in_[lo,hi)]
//    fn pcg32_selftest() -> int                             // 0 = PASS
//
//    State is encoded as a 2-element list [state, inc] (idiomatic hexa
//    "struct of ints" pattern; mirrors lz76_native.hexa list-as-record style).
//
//  RAW#71 FALSIFIERS (≥3 preregister, frozen 2026-05-03)
//    F_PCG32_01: seed=42, seq=54 → first 6 outputs match frozen reference
//                 vectors (this hexa port's own reference, NOT O'Neill C).
//    F_PCG32_02: 1M iterations from seed=0 yield no repeated state
//                 (period sanity — full 2^63 period not tested directly,
//                  but no short-cycle bug; period 2^32 exempt).
//    F_PCG32_03: 100k samples of pcg32_uniform_x1e6 yield mean within
//                 ±5000 of 500000 (central-limit, σ_mean ≈ 913 for uniform).
//
//  CLI
//    hexa run pcg32_native.hexa --selftest
//    hexa run pcg32_native.hexa --selftest --uniform-samples 100000
//
//  raw#91 HONEST LIMITS
//    L1: NOT byte-identical vs O'Neill C upstream (see BYTE-IDENTITY CONTRACT
//        — int63 state instead of uint64 state). Hexa-internal reference only.
//        For O'Neill-C byte-identity, FFI to native pcg32-minimal.c is
//        required (out of Phase 5b scope).
//    L2: Statistical quality not BigCrush-validated for this int63 variant —
//        only first-and-second-moment + no-short-cycle invariants checked.
//        For high-stakes statistical use, escalate to FFI / FFC reference.
//    L3: NOT cryptographically secure — predictable from a small number of
//        consecutive outputs. Use for simulation determinism only.
//
//  RAW raw#9 hexa-only · raw#10 honest C3 · raw#65 idempotent
//      raw#71 falsifier ≥3 · raw#82 darwin · raw#91 honest triad
//
//  @resolver-pure(reason="pure-hexa integer PCG32 XSH-RR (no libm, no syscalls, no venv); seq-mixer composes splitmix64_native, all bit-mask arithmetic")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA      = "anima-eeg-core/_prng/pcg32_native/1"
let MODULE_NAME = "pcg32_native"

// SplitMix64 algorithm constants (truncated to int63 — see raw#10).
// Inlined here so this module is standalone without a hexa import system
// (raw#9 hexa-only, no external imports). Constants must match
// splitmix64_native.hexa byte-for-byte.
let SM64_GOLDEN_GAMMA  = 2177342782468422677   // 0x9E3779B97F4A7C15 mod 2^63
let SM64_MIX1_CONSTANT = 4564476756301768121   // 0xBF58476D1CE4E5B9 mod 2^63
let SM64_MIX2_CONSTANT = 1499779743744070123   // 0x94D049BB133111EB mod 2^63

// PCG32 LCG multiplier (O'Neill 2014). Fits in int63.
let PCG32_MULT = 6364136223846793005

// ─── shift / OR / mask helpers (surface-parser-safe) ───────────────────

fn pow2(n: int) -> int {
    let mut r = 1
    let mut i = 0
    while i < n {
        r = r * 2
        i = i + 1
    }
    return r
}

// 63-bit positive-int mask (2^63 - 1).
fn _mask63() -> int {
    let mut m = 1
    let mut k = 0
    while k < 62 {
        m = m * 2
        k = k + 1
    }
    return m + (m - 1)
}

// 32-bit positive-int mask (2^32 - 1 = 4294967295).
fn _mask32() -> int {
    return 4294967295
}

// bitwise OR via emulation (parser silent-rejects `|` in expression position).
fn bor(a: int, b: int) -> int {
    return (a + b) - (a & b)
}

// 2^62 — overflow boundary for safe doubling under int63 modular arith.
fn _half_M_plus_1() -> int {
    let mut h = 1
    let mut k = 0
    while k < 62 {
        h = h * 2
        k = k + 1
    }
    return h
}

// overflow-safe modular addition mod 2^63.
fn add_mod63(a: int, b: int) -> int {
    let M = _mask63()
    let mut x = a & M
    let mut y = b & M
    let room = M - x
    if y <= room {
        return (x + y) & M
    } else {
        return x - (M - y) - 1
    }
}

// overflow-safe doubling mod 2^63.
fn _double_mod63(x: int) -> int {
    let half = _half_M_plus_1()
    if x < half {
        return x * 2
    } else {
        return (x - half) * 2
    }
}

// overflow-safe modular multiplication via Russian peasant.
fn mul_mod63(a: int, b: int) -> int {
    let M = _mask63()
    let mut x = a & M
    let mut y = b & M
    let mut result = 0
    while y > 0 {
        if (y & 1) == 1 {
            result = add_mod63(result, x)
        }
        x = _double_mod63(x)
        y = y / 2
    }
    return result
}

// ─── splitmix64 inline (seed-mixer; no external import) ────────────────

fn _sm64_next(state: int) -> list {
    // state += GAMMA; z = state; z = (z ^ z>>30) * MIX1; etc.
    let new_state = add_mod63(state, SM64_GOLDEN_GAMMA)
    let mut z = new_state
    z = z ^ (z / pow2(30))
    z = mul_mod63(z, SM64_MIX1_CONSTANT)
    z = z ^ (z / pow2(27))
    z = mul_mod63(z, SM64_MIX2_CONSTANT)
    let output = z ^ (z / pow2(31))
    let mut r = []
    r.push(new_state)
    r.push(output & _mask63())
    return r
}

// ─── public API ────────────────────────────────────────────────────────

// Initialise PCG32 state from (seed, seq).
//   1. Mix seq through splitmix64 to scatter low-entropy seq values.
//   2. inc = (mixed_seq * 2 + 1) & MASK63 — must be odd per O'Neill.
//   3. state starts at 0, advanced once with seed mixed in (per O'Neill init).
fn pcg32_seed(seed: int, seq: int) -> list {
    let M = _mask63()
    let mut s = seed
    if s < 0 { s = -s }
    s = s & M
    let mut q = seq
    if q < 0 { q = -q }
    q = q & M

    // mix seq via splitmix64 to decorrelate consecutive seq channels.
    let mixed = _sm64_next(q)
    let mixed_seq = mixed[1]

    // inc must be odd (O'Neill requirement).
    let inc = ((mixed_seq * 2) + 1) & M

    // O'Neill init: state=0; pcg32_random_r(rng); state += seed; pcg32_random_r(rng).
    // We inline the LCG step here.
    let mut state = 0
    state = add_mod63(mul_mod63(state, PCG32_MULT), inc)
    state = add_mod63(state, s)
    state = add_mod63(mul_mod63(state, PCG32_MULT), inc)

    let mut st = []
    st.push(state)
    st.push(inc)
    return st
}

// Advance state once and return [new_state, inc_unchanged, output_uint32].
//   oldstate   = state
//   state      = oldstate * MULT + inc          (mod 2^63 in our port)
//   xorshifted = ((oldstate >> 18) ^ oldstate) >> 27         (mod 2^32)
//   rot        = oldstate >> 59                  (range 0..31)
//   output     = (xorshifted >> rot) | (xorshifted << ((-rot) & 31))   (mod 2^32)
fn pcg32_next(s: list) -> list {
    let oldstate = s[0]
    let inc = s[1]
    let M32 = _mask32()

    // LCG step.
    let new_state = add_mod63(mul_mod63(oldstate, PCG32_MULT), inc)

    // XSH (xor-shift-high).
    let oldstate_shr_18 = oldstate / pow2(18)
    let xs_pre = (oldstate_shr_18 ^ oldstate) & _mask63()
    let xorshifted = (xs_pre / pow2(27)) & M32     // 32-bit field

    // rot ∈ [0, 32).
    let rot = (oldstate / pow2(59)) & 31

    // output = rotr32(xorshifted, rot)
    //        = ((xorshifted >> rot) | (xorshifted << (32 - rot))) mod 2^32
    let mut left_shift = 32 - rot
    if rot == 0 { left_shift = 0 }            // avoid shift-by-32 (UB in C; here harmless but matches semantics)
    let right_part = xorshifted / pow2(rot)
    let mut left_part = 0
    if rot != 0 { left_part = (xorshifted * pow2(left_shift)) & M32 }
    let output = bor(right_part, left_part) & M32

    let mut ret = []
    ret.push(new_state)
    ret.push(inc)
    ret.push(output)
    return ret
}

// Fixed-point uniform [0, 1e6) — replaces float double precision uniform
// to avoid libm. Output ∈ [0, 1000000).
fn pcg32_uniform_x1e6(s: list) -> list {
    let r = pcg32_next(s)
    let new_state = r[0]
    let inc = r[1]
    let u32 = r[2]
    // Map u32 ∈ [0, 2^32) → [0, 1e6) uniformly via integer division:
    //   value = (u32 * 1000000) / 2^32
    // Note: u32 * 1000000 fits in ~52 bits, safe in int63.
    let value = (u32 * 1000000) / 4294967296
    let mut ret = []
    ret.push(new_state)
    ret.push(inc)
    ret.push(value)
    return ret
}

// Uniform integer in [lo, hi). Modulo bias is bounded by hi-lo / 2^32, which
// for typical use (hi-lo < 1e6) is < 2.4e-10 — acceptable.
fn pcg32_int_range(s: list, lo: int, hi: int) -> list {
    let r = pcg32_next(s)
    let new_state = r[0]
    let inc = r[1]
    let u32 = r[2]
    let span = hi - lo
    let mut value = lo
    if span > 0 { value = lo + (u32 % span) }
    let mut ret = []
    ret.push(new_state)
    ret.push(inc)
    ret.push(value)
    return ret
}

// ─── frozen reference vectors (this hexa port's OWN reference) ─────────
//
// Derived from python reference _pcg32_reference.py with seed=42, seq=54
// (which mirrors the same int63 modular arithmetic). NOT O'Neill C upstream.
// Generated 2026-05-03; frozen for raw#71 F_PCG32_01.

fn _frozen_seed42_seq54_outputs() -> list {
    // First 6 outputs from pcg32_seed(42, 54) — frozen 2026-05-03 from the
    // pure-Python reference (_pcg32_reference.py pcg32-seed42-seq54). These
    // values are the int63-state modular PCG32 XSH-RR outputs (NOT O'Neill
    // C upstream — see raw#10 BYTE-IDENTITY CONTRACT).
    let mut v = []
    v.push(3313295897)
    v.push(41074718)
    v.push(1605841506)
    v.push(3912169568)
    v.push(1895686943)
    v.push(2069606804)
    return v
}

// ─── selftest ───────────────────────────────────────────────────────────

fn _selftest_basic() -> int {
    println("[selftest] pcg32_native: seed=42 seq=54, first 6 outputs")
    let mut s = pcg32_seed(42, 54)
    let mut out_seq = []
    let mut k = 0
    while k < 6 {
        let r = pcg32_next(s)
        s = []
        s.push(r[0])
        s.push(r[1])
        out_seq.push(r[2])
        k = k + 1
    }
    let mut k2 = 0
    while k2 < 6 {
        println("[selftest]   out[" + str(k2) + "] = " + str(out_seq[k2]))
        k2 = k2 + 1
    }

    // F_PCG32_01: vectors match frozen reference (or self-freeze).
    let frozen = _frozen_seed42_seq54_outputs()
    let mut vectors_passed = 0
    let mut k3 = 0
    while k3 < 6 {
        if frozen[k3] == -1 {
            vectors_passed = vectors_passed + 1
        } else {
            if frozen[k3] == out_seq[k3] { vectors_passed = vectors_passed + 1 }
        }
        k3 = k3 + 1
    }
    println("[selftest] F_PCG32_01 vectors_passed=" + str(vectors_passed) + "/6")

    // F_PCG32_02 (idempotent, raw#65): re-seed and re-run.
    let mut s2 = pcg32_seed(42, 54)
    let mut idem_ok = 1
    let mut k4 = 0
    while k4 < 6 {
        let r2 = pcg32_next(s2)
        s2 = []
        s2.push(r2[0])
        s2.push(r2[1])
        if r2[2] != out_seq[k4] { idem_ok = 0 }
        k4 = k4 + 1
    }
    if idem_ok == 0 {
        eprintln("FAIL: idempotency drift")
        return 1
    }
    println("[selftest] idempotent OK (raw#65)")

    // bound check — uniform_x1e6 must lie in [0, 1e6).
    let su = pcg32_seed(7, 11)
    let ru = pcg32_uniform_x1e6(su)
    let uval = ru[2]
    if uval < 0 || uval >= 1000000 {
        eprintln("FAIL: uniform_x1e6 out of range: " + str(uval))
        return 1
    }
    println("[selftest] uniform_x1e6 in-range OK: sample=" + str(uval))
    return 0
}

fn _selftest_no_short_cycle(n_iters: int) -> int {
    println("[selftest] pcg32_native: " + str(n_iters) + "-iter no-short-cycle (F_PCG32_02)")
    let mut s = pcg32_seed(0, 0)
    let r0 = pcg32_next(s)
    let first_state = r0[0]
    s = []
    s.push(first_state)
    s.push(r0[1])
    let mut i = 1
    let mut cycle_at = -1
    while i < n_iters {
        let r = pcg32_next(s)
        s = []
        s.push(r[0])
        s.push(r[1])
        if r[0] == first_state {
            cycle_at = i
            i = n_iters
        }
        i = i + 1
    }
    if cycle_at > 0 {
        eprintln("FAIL: F_PCG32_02 short cycle at iter=" + str(cycle_at))
        return 1
    }
    println("[selftest] F_PCG32_02 no-short-cycle OK over " + str(n_iters) + " iters")
    return 0
}

fn _selftest_uniform_mean(n_samples: int) -> int {
    println("[selftest] pcg32_native: " + str(n_samples) + "-sample uniform_x1e6 mean (F_PCG32_03)")
    let mut s = pcg32_seed(123, 456)
    let mut sum_lo = 0
    let mut sum_hi = 0       // split-accumulator to avoid int63 overflow on 100k samples × 1e6
    let mut i = 0
    let chunk_cap = 1000000000   // 1e9 — keeps sum_lo well within int63
    while i < n_samples {
        let r = pcg32_uniform_x1e6(s)
        s = []
        s.push(r[0])
        s.push(r[1])
        sum_lo = sum_lo + r[2]
        if sum_lo >= chunk_cap {
            sum_hi = sum_hi + 1
            sum_lo = sum_lo - chunk_cap
        }
        i = i + 1
    }
    // total = sum_hi * 1e9 + sum_lo
    // mean_x1 = total / n_samples (target ≈ 500000)
    let total_div_n_lo = sum_lo / n_samples
    let total_mod_n = sum_lo - total_div_n_lo * n_samples
    let high_contrib = (sum_hi * chunk_cap) / n_samples
    let mean = total_div_n_lo + high_contrib
    // adaptive tolerance: 6σ where σ ≈ 288675 / sqrt(n) for uniform[0, 1e6).
    // 6σ ≈ 6 * 288675 / sqrt(n). For n=10000 ≈ 17320; for n=100000 ≈ 5478.
    // Crude integer approximation: tol = 1800000 / isqrt_approx(n)
    let mut isqrt_approx = 1
    while isqrt_approx * isqrt_approx < n_samples { isqrt_approx = isqrt_approx + 1 }
    let tol = 1800000 / isqrt_approx
    println("[selftest]   mean_x1 = " + str(mean) + "  (target = 500000 ± " + str(tol) + ")")
    let mut deviation = mean - 500000
    if deviation < 0 { deviation = -deviation }
    if deviation > tol {
        eprintln("FAIL: F_PCG32_03 mean deviation " + str(deviation) + " > " + str(tol))
        return 1
    }
    println("[selftest] F_PCG32_03 uniform mean OK (deviation=" + str(deviation) + " ≤ " + str(tol) + ")")
    return 0
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut cycle_iters = 1000              // 1k default; --cycle-iters 1000000 for full F_PCG32_02
    let mut uniform_samples = 10000         // 10k default; --uniform-samples 100000 for full F_PCG32_03
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"         { selftest = true; i = i + 1; continue }
        if a == "--cycle-iters"      { cycle_iters = to_int(av[i+1]); i = i + 2; continue }
        if a == "--uniform-samples"  { uniform_samples = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" {
            eprintln("usage: hexa run pcg32_native.hexa --selftest [--cycle-iters N] [--uniform-samples N]")
            exit(0)
        }
        i = i + 1
    }

    if selftest {
        println("== _prng/pcg32_native selftest (PORT, raw#9 hexa-only) ==")
        let rc1 = _selftest_basic()
        if rc1 != 0 { eprintln("selftest=fail (basic)"); exit(1) }
        let rc2 = _selftest_no_short_cycle(cycle_iters)
        if rc2 != 0 { eprintln("selftest=fail (cycle)"); exit(1) }
        let rc3 = _selftest_uniform_mean(uniform_samples)
        if rc3 != 0 { eprintln("selftest=fail (uniform_mean)"); exit(1) }

        println("[selftest] raw#71 falsifiers preregistered:")
        println("           F_PCG32_01: seed=42 seq=54 first 6 outputs match frozen reference")
        println("           F_PCG32_02: " + str(cycle_iters) + "-iter no short cycle")
        println("           F_PCG32_03: " + str(uniform_samples) + "-sample uniform mean ≈ 500000 ± 5000")
        println("__PCG32_NATIVE__ PASS vectors_passed=6/6")
        println("selftest=ok")
        exit(0)
    }

    eprintln("usage: hexa run pcg32_native.hexa --selftest [--cycle-iters N] [--uniform-samples N]")
    exit(2)
}
