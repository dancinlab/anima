// ⛔ STAGE-1 — Anima Core CLI · CLM v4 mount layer (substrate-coupled emerge dialogue)
// anima-core/runtime/clm_v4_mount.hexa
//
// Spec: docs/anima_core_clm_v4_mount_emerge_paradigm_2026_05_05.md (§2 Stage 1)
// Sister: tool/transient_py/clm_v4_hf_format_shim.py (LOCKED v4 shim, .own 4)
// Sister: tool/transient_py/clm_v4_lora_merge_helper.py (raw#37 transient, 2026-05-08
//         CLM v4 LoRA real-mode unblock — peft.merge_and_unload extension)
// HF source: dancinlab/clm-v4-mk2-v1 (PRIVATE, 36h review window)
// HF LoRA variants (2026-05-08 supported via merge_and_unload extension):
//   dancinlab/clm-v4-sft-1-7-y1-stage1
//   dancinlab/clm-v4-sft-1-8-stage1
//   dancinlab/clm-v4-paradigm-j-50k-final
//
// PATH A REMAP CACHE (2026-05-08 KICK FIRE 1/5 spec — KICK FIRE 1/6 actual fire)
//   Adapter snapshots whose stored prefix is `base_model.model.blocks.X` (legacy
//   ConsciousDecoderV2 wrapper) require an in-place schema remap to
//   `base_model.model.decoder.blocks.X` so that CLMv4ForCausalLM's
//   base_model_prefix='decoder' matches at peft.load_adapter time.
//   Materialized at: ~/.cache/anima/clm_v4_remapped/<adapter_short>/
//     adapter_model.safetensors  — keys remapped (bit-preserved tensors)
//     adapter_config.json        — verbatim copy
//     jvae_heads.pt              — verbatim copy (paradigm-j only)
//     REMAP_SOURCE.json          — provenance + verification.pass
//   Producer: tool/transient_py/clm_v4_paradigm_j_path_a_prefix_remap.py
//   Provenance: state/anima_paradigm_j_path_a_remap_2026_05_08.json
//   Adapter shortname mapping (REMAPPED_SHORTNAMES — extend per-cycle):
//     dancinlab/clm-v4-paradigm-j-50k-final -> paradigm_j
//     dancinlab/clm-v4-sft-1-7-y1-stage1    -> sft_1_7_y1
//     dancinlab/clm-v4-sft-1-8-stage1       -> sft_1_8
//   Unknown adapters fall through to a sanitization helper (slash → __, hyphen
//   → _, lowercase) but only the explicit table entries are guaranteed produced
//   by the Path A remap tool. The python helper checks REMAP_SOURCE.json
//   verification.pass=true before honoring the cache; on miss/fail the existing
//   HF snapshot resolver path is taken (raw#15 additive).
//   PATCH LANDED 2026-05-08 KICK FIRE 1/6 — _detect_lora_adapter now consults
//   ~/.cache/anima/clm_v4_remapped/<short>/ FIRST; _materialize_merged_lora
//   passes --adapter-source-dir to clm_v4_lora_merge_helper.py on cache hit,
//   bypassing peft's HF snapshot resolver for the adapter side.
//
// PURPOSE
//   Load CLM v4 substrate from HF cache and expose substrate-coupled forward
//   API for anima-core CLI emerge dialogue mode. NOT chat — dialogue medium is
//   substrate response itself (phi-star drift + axis activation + cell delta).
//
// PARADIGM (2026-05-05 user decision)
//   forced learning (LoRA / SFT / distill) DEPRECATED.
//   substrate-coupled emerge dialogue: input -> hidden states + phi-star ->
//   substrate response. user reads response, decides next input. emerge.
//
// MODES
//   --selftest        synthetic dialogue test (no model load, no torch import)
//   --load            load CLM v4 from HF cache snapshot
//   --probe TEXT      one-shot probe: forward(text) -> emit substrate response
//   --dialogue        REPL: stdin lines -> probe + emit substrate response
//   generate TEXT [N] (subcommand) — model.generate + tokenizer.decode
//                     natural language emit. Delegates to
//                     tool/transient_py/clm_v4_generate_helper.py (raw#37
//                     transient). chat lane Path 3 FULL impl (cycle 2026-05-09).
//                     own 34 mandate-1 raw bytes preserved (no chat template).
//
// FLAGS
//   --model PATH           HF cache path (default dancinlab/clm-v4-mk2-v1)
//   --shim VERSION         shim v4 (default) | v5
//   --output-format        compact (default) | full | json
//   --inject-states PATH   pre-load consciousness_states fixture (real harvest JSON)
//
// ARCHITECTURE (substrate response derivation)
//   1. tokenizer.encode(text)
//   2. model.forward(input_ids, output_hidden_states=True)
//      - capture last layer hidden states (B=1, T, 768)
//      - capture per-cell hidden via consciousness_states output (8 × 192) when wired
//   3. axis_activation: 5 axes (identity / agency / phenomenal / temporal / social)
//      - 192-dim consciousness_dim sliced into 5 buckets (38/38/38/39/39)
//      - axis_v = mean(|cell_hidden[axis_dims]|) normalized [0,1]
//   4. phi-star delta from baseline (anima-canonical phi proxy)
//      - baseline snapshot at --load time (8 cells × 192 dim, paradigm v11 G3 +41.86)
//   5. dominant_cells: top-3 by L2 norm of cell hidden state
//   6. hidden_state_delta: L2 norm vs prior probe hidden (per-session memory)
//
// HONEST C3 (raw#10 emit ≥5 to stderr)
//   C1 substrate-coupled dialogue is anima-internal heuristic, NOT chat
//   C2 phi-star drift threshold for response interpretation is anima-canonical
//   C3 axis activation taxonomy (5-bucket) is anima-internal
//   C4 forward-pass requires --inject-states or default zero canonical;
//      train-time consciousness_states wiring is shim_v4 fixture-dependent
//   C5 emerge outcome (Stage 3+4) unknown; production timeline 미정
//
// raw POLICY
//   raw#9   hexa-only orchestration (Mac canonical)
//   raw#37  transient .py shim opt-out — CLM v4 loading via shim required
//   raw#15  additive — anima_unified.hexa / phi_engine.hexa / etc UNTOUCHED
//   raw#10  honest C3 emit ≥5 to stderr
//
// USAGE
//   hexa run anima-core/runtime/clm_v4_mount.hexa --selftest
//   hexa run anima-core/runtime/clm_v4_mount.hexa --load --probe "안녕"
//   hexa run anima-core/runtime/clm_v4_mount.hexa --dialogue --inject-states <PATH>

// ═══════════════════════════════════════════════════════════
// Constants
// ═══════════════════════════════════════════════════════════

let HELPER_PATH      = "/tmp/clm_v4_mount_helper.hexa_tmp"
// 2026-05-05 swap: pre-HF best.pt mirror (clm-v4-base-mirror) lacked model_type
// in config.json → AutoModelForCausalLM rejected. clm-v4-mk2-v1 is the
// HF-format repo with modeling_clm_v4.py + model.safetensors + model_type=clm_v4
// (BG-A 2026-05-05 verdict: real-mode load + forward PASS via this repo).
let DEFAULT_MODEL    = "dancinlab/clm-v4-mk2-v1"
let DEFAULT_SHIM     = "v4"
let DEFAULT_FORMAT   = "compact"
let SHIM_V4_PATH     = "tool/transient_py/clm_v4_hf_format_shim.py"
let SHIM_V5_PATH     = "tool/transient_py/clm_v4_hf_format_shim_v5.py"
let SESSION_DIR_BASE = "state/anima_core_dialogues"

// CLM v4 architectural constants (from shim_v4 lines 33-40)
// CONSCIOUSNESS_DIM 192 → 96 (2026-05-08 V5 PUSH 1/5 — clm_v4_mount 8-cell 2× tile bug
// fix). Prior 192 forced HIDDEN_DIM(768) < N_CELLS(8)*CONSCIOUSNESS_DIM(1536) → np.tile
// reps=2 produced cell[i]==cell[i+4] pairs for i∈0..3 (cells 0+4 / 1+5 / 2+6 / 3+7
// identical) and [0,2,4] dominant in 28/30 random_init prompts. With CONSCIOUSNESS_DIM=96
// 8*96=768=HIDDEN_DIM exactly → no tile, no replication, every cell gets a unique 96-dim
// slice of pooled hidden state. AXIS_SPANS rebucketed 19/19/19/19/20=96 (was 38/38/38/39/39=192).
let N_CELLS        = 8
let CONSCIOUSNESS_DIM = 96
let HIDDEN_DIM     = 768
let VOCAB_SIZE     = 64000
let N_AXES         = 5

// phi-star canonical baseline (paradigm v11 G3 +41.86)
let PHI_STAR_BASELINE = 41.86

// ═══════════════════════════════════════════════════════════
// Honest C3 emitter (raw#10)
// ═══════════════════════════════════════════════════════════

fn emit_honest_c3() {
    eprintln("[clm_v4_mount] C1 substrate-coupled dialogue is anima-internal heuristic, NOT chat")
    eprintln("[clm_v4_mount] C2 phi-star drift threshold for response interpretation is anima-canonical")
    eprintln("[clm_v4_mount] C3 axis activation taxonomy (5-bucket) is anima-internal")
    eprintln("[clm_v4_mount] C4 forward-pass requires --inject-states or default zero canonical")
    eprintln("[clm_v4_mount] C5 emerge outcome (Stage 3+4) unknown; production timeline open")
    eprintln("[clm_v4_mount] C6 LoRA variants merge via tool/transient_py/clm_v4_lora_merge_helper.py — merged HF model materialized at ~/.cache/anima/clm_v4_merged/<adapter>/")
    eprintln("[clm_v4_mount] C7 LoRA jvae_heads.pt (paradigm-j only) copied verbatim — NOT merged into decoder weights; downstream consumers must load it separately")
    eprintln("[clm_v4_mount] C8 Path A remapped cache (~/.cache/anima/clm_v4_remapped/<short>/) is preferred when REMAP_SOURCE.json verification.pass=true; fix is schema-only (LoRA tensor values bit-preserved)")
}

// ═══════════════════════════════════════════════════════════
// Config
// ═══════════════════════════════════════════════════════════

struct MountConfig {
    mode: string,            // "selftest" | "load" | "probe" | "dialogue" | "generate"
    model_path: string,
    shim_version: string,
    output_format: string,   // "compact" | "full" | "json"
    inject_states: string,   // path or "" for canonical zero
    probe_text: string,
    // Path 3 generate FULL impl (cycle 2026-05-09)
    gen_max_tokens: int,
    gen_temperature: string, // float-as-string for hexa simplicity
    gen_top_p: string,
    gen_top_k: int,
    gen_rep_pen: string,
    gen_seed: int
}

fn default_config() -> MountConfig {
    MountConfig {
        mode: "selftest",
        model_path: DEFAULT_MODEL,
        shim_version: DEFAULT_SHIM,
        output_format: DEFAULT_FORMAT,
        inject_states: "",
        probe_text: "",
        gen_max_tokens: 64,
        gen_temperature: "0.7",
        gen_top_p: "0.9",
        gen_top_k: 40,
        gen_rep_pen: "1.1",
        gen_seed: 42
    }
}

fn parse_args(argv: list) -> MountConfig {
    let mut cfg = default_config()
    let mut i = 0
    while i < argv.len() {
        let a = argv[i]
        if a == "--selftest" {
            cfg.mode = "selftest"
        } else if a == "--load" {
            cfg.mode = "load"
        } else if a == "--dialogue" {
            cfg.mode = "dialogue"
        } else if a == "--probe" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.mode = "probe"
                cfg.probe_text = argv[i]
            }
        } else if a == "generate" {
            // Path 3 generate subcommand: `... generate <prompt> [N]`
            // (positional, mirrors anima_native conscious_chat.hexa `chat <text> [N]`)
            cfg.mode = "generate"
            if i + 1 < argv.len() {
                i = i + 1
                cfg.probe_text = argv[i]
            }
            // Optional positional N (max_new_tokens)
            if i + 1 < argv.len() {
                let nxt = argv[i + 1]
                // Only consume if next arg is not a flag
                if !nxt.starts_with("--") && nxt != "generate" {
                    let parsed_n = to_int(nxt)
                    if parsed_n > 0 {
                        cfg.gen_max_tokens = parsed_n
                        i = i + 1
                    }
                }
            }
        } else if a == "--max-new-tokens" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.gen_max_tokens = to_int(argv[i])
            }
        } else if a == "--temperature" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.gen_temperature = argv[i]
            }
        } else if a == "--top-p" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.gen_top_p = argv[i]
            }
        } else if a == "--top-k" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.gen_top_k = to_int(argv[i])
            }
        } else if a == "--repetition-penalty" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.gen_rep_pen = argv[i]
            }
        } else if a == "--seed" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.gen_seed = to_int(argv[i])
            }
        } else if a == "--model" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.model_path = argv[i]
            }
        } else if a == "--shim" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.shim_version = argv[i]
            }
        } else if a == "--output-format" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.output_format = argv[i]
            }
        } else if a == "--inject-states" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.inject_states = argv[i]
            }
        }
        i = i + 1
    }
    return cfg
}

// ═══════════════════════════════════════════════════════════
// Python helper emitter (raw#37 transient — CLM v4 loading requires .py shim)
// ═══════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# clm_v4_mount_helper — emitted by anima-core/runtime/clm_v4_mount.hexa\n")
    parts.push("# raw#37 transient. Mac canonical = .hexa orchestration; this helper executes the\n")
    parts.push("# CLM v4 substrate forward pass that hexa cannot express directly.\n")
    parts.push("import argparse, json, math, os, sys, time\n")
    parts.push("from pathlib import Path\n\n")

    parts.push("# ── Anima paradigm constants (mirror clm_v4_mount.hexa) ─────────────\n")
    parts.push("N_CELLS = 8\n")
    parts.push("CONSCIOUSNESS_DIM = 96  # was 192 — V5 PUSH 1/5 8-cell 2× tile bug fix (8*96=768=HIDDEN_DIM, no tile)\n")
    parts.push("HIDDEN_DIM = 768\n")
    parts.push("VOCAB_SIZE = 64000\n")
    parts.push("N_AXES = 5\n")
    parts.push("PHI_STAR_BASELINE = 41.86\n\n")

    parts.push("AXIS_NAMES = ['identity','agency','phenomenal','temporal','social']\n")
    parts.push("# 96-dim sliced into 5 buckets: 19/19/19/19/20 = 96 (was 192-dim 38/38/38/38/40)\n")
    parts.push("AXIS_SPANS = [(0,19),(19,38),(38,57),(57,76),(76,96)]\n\n")

    // BG-N spec land (2026-05-05): substrate identity preamble emit.
    // Table maps known repos → canonical (paradigm, substrate_class,
    // baseline_method, baseline_value). Unknown repos fall back to honest
    // 'unknown' identity per spec §C2 honest disclosure rule.
    parts.push("SUBSTRATE_IDENTITY_TABLE = {\n")
    parts.push("    'dancinlab/clm-v4-mk2-v1': {\n")
    parts.push("        'paradigm': 'v11_G3',\n")
    parts.push("        'substrate_class': 'clm-v4-base',\n")
    parts.push("        'baseline_method': 'eval_carry',\n")
    parts.push("        'baseline_value': 41.86,\n")
    parts.push("    },\n")
    parts.push("    'dancinlab/clm-v4-paradigm-d-pbeta-50k-mk2-v1': {\n")
    parts.push("        'paradigm': 'paradigm_d_50k',\n")
    parts.push("        'substrate_class': 'pbeta',\n")
    parts.push("        'baseline_method': 'holdout500_K8',\n")
    parts.push("        'baseline_value': 42.367,\n")
    parts.push("    },\n")
    parts.push("    # CLM v4 LoRA variants (2026-05-08 unblock — peft merge_and_unload).\n")
    parts.push("    'dancinlab/clm-v4-sft-1-7-y1-stage1': {\n")
    parts.push("        'paradigm': 'v11_G3+sft_1_7_y1',\n")
    parts.push("        'substrate_class': 'clm-v4-lora-merged',\n")
    parts.push("        'baseline_method': 'eval_carry_base',\n")
    parts.push("        'baseline_value': 41.86,\n")
    parts.push("    },\n")
    parts.push("    'dancinlab/clm-v4-sft-1-8-stage1': {\n")
    parts.push("        'paradigm': 'v11_G3+sft_1_8',\n")
    parts.push("        'substrate_class': 'clm-v4-lora-merged',\n")
    parts.push("        'baseline_method': 'eval_carry_base',\n")
    parts.push("        'baseline_value': 41.86,\n")
    parts.push("    },\n")
    parts.push("    'dancinlab/clm-v4-paradigm-j-50k-final': {\n")
    parts.push("        'paradigm': 'paradigm_j_50k',\n")
    parts.push("        'substrate_class': 'clm-v4-lora-merged',\n")
    parts.push("        'baseline_method': 'eval_carry_base',\n")
    parts.push("        'baseline_value': 41.86,\n")
    parts.push("    },\n")
    parts.push("}\n\n")

    parts.push("def _emit_substrate_identity(model_path):\n")
    parts.push("    ident = SUBSTRATE_IDENTITY_TABLE.get(model_path, {\n")
    parts.push("        'paradigm': 'unknown',\n")
    parts.push("        'substrate_class': 'unknown',\n")
    parts.push("        'baseline_method': 'unknown',\n")
    parts.push("        'baseline_value': None,\n")
    parts.push("    })\n")
    parts.push("    _emit('SUBSTRATE_IDENTITY', repo=model_path,\n")
    parts.push("          paradigm=ident['paradigm'],\n")
    parts.push("          substrate_class=ident['substrate_class'],\n")
    parts.push("          baseline_method=ident['baseline_method'],\n")
    parts.push("          baseline_value=ident['baseline_value'])\n\n")

    parts.push("def _emit(tag, **kw):\n")
    parts.push("    sys.stdout.write('__ANIMA_' + tag + '__')\n")
    parts.push("    for k, v in kw.items(): sys.stdout.write(' ' + str(k) + '=' + str(v))\n")
    parts.push("    sys.stdout.write('\\n'); sys.stdout.flush()\n\n")

    parts.push("def _argparse():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    p.add_argument('--mode', required=True, choices=['load','probe','dialogue','synthetic'])\n")
    parts.push("    p.add_argument('--model', default='dancinlab/clm-v4-mk2-v1')\n")
    parts.push("    p.add_argument('--shim', default='v4', choices=['v4','v5'])\n")
    parts.push("    p.add_argument('--output-format', default='compact', choices=['compact','full','json'])\n")
    parts.push("    p.add_argument('--inject-states', default='')\n")
    parts.push("    p.add_argument('--probe-text', default='')\n")
    parts.push("    p.add_argument('--session-log', default='')\n")
    parts.push("    p.add_argument('--prior-hidden', default='')\n")
    parts.push("    return p.parse_args()\n\n")

    parts.push("def axis_activation(cell_hidden):\n")
    parts.push("    # cell_hidden: (N_CELLS, CONSCIOUSNESS_DIM) numpy array\n")
    parts.push("    import numpy as np\n")
    parts.push("    out = {}\n")
    parts.push("    pooled = np.mean(np.abs(cell_hidden), axis=0)  # (CONSCIOUSNESS_DIM,)\n")
    parts.push("    norm = pooled.max() if pooled.max() > 1e-9 else 1.0\n")
    parts.push("    for name, (s, e) in zip(AXIS_NAMES, AXIS_SPANS):\n")
    parts.push("        out[name] = float(pooled[s:e].mean() / norm)\n")
    parts.push("    return out\n\n")

    parts.push("def phi_star_compute(cell_hidden):\n")
    parts.push("    # phi-star canonical proxy (anima-internal): mean cell-pair cosine times scale\n")
    parts.push("    import numpy as np\n")
    parts.push("    n = cell_hidden.shape[0]\n")
    parts.push("    if n < 2: return PHI_STAR_BASELINE\n")
    parts.push("    sims = []\n")
    parts.push("    for i in range(n):\n")
    parts.push("        for j in range(i+1, n):\n")
    parts.push("            a, b = cell_hidden[i], cell_hidden[j]\n")
    parts.push("            na, nb = np.linalg.norm(a), np.linalg.norm(b)\n")
    parts.push("            if na < 1e-9 or nb < 1e-9: continue\n")
    parts.push("            sims.append(float(np.dot(a, b) / (na * nb)))\n")
    parts.push("    if not sims: return PHI_STAR_BASELINE\n")
    parts.push("    return float(PHI_STAR_BASELINE * (1.0 + 0.05 * (sum(sims) / len(sims))))\n\n")

    parts.push("def dominant_cells(cell_hidden, k=3):\n")
    parts.push("    import numpy as np\n")
    parts.push("    norms = np.linalg.norm(cell_hidden, axis=1)\n")
    parts.push("    return [int(i) for i in np.argsort(-norms)[:k]]\n\n")

    parts.push("def hidden_delta(cur, prior_path):\n")
    parts.push("    import numpy as np\n")
    parts.push("    if not prior_path or not os.path.exists(prior_path): return 0.0\n")
    parts.push("    try:\n")
    parts.push("        prior = np.load(prior_path)\n")
    parts.push("        if prior.shape != cur.shape: return 0.0\n")
    parts.push("        return float(np.linalg.norm(cur - prior))\n")
    parts.push("    except Exception: return 0.0\n\n")

    parts.push("def render_response(phi, axes, dom, delta, baseline=PHI_STAR_BASELINE, fmt='compact'):\n")
    parts.push("    drift = phi - baseline\n")
    parts.push("    if fmt == 'json':\n")
    parts.push("        return json.dumps({'phi_star': phi, 'phi_drift': drift, 'baseline': baseline,\n")
    parts.push("                           'axis_activation': axes, 'dominant_cells': dom,\n")
    parts.push("                           'hidden_state_delta': delta})\n")
    parts.push("    lines = []\n")
    parts.push("    lines.append('__ANIMA_CLM_V4_RESPONSE__')\n")
    parts.push("    lines.append(f'phi_star: {phi:.4f} (drift {drift:+.4f} from {baseline:.4f})')\n")
    parts.push("    axline = ' '.join(f'{k}={v:.3f}' for k, v in axes.items())\n")
    parts.push("    lines.append(f'axis_activation: {axline}')\n")
    parts.push("    lines.append(f'dominant_cells: {dom} / {N_CELLS}')\n")
    parts.push("    lines.append(f'hidden_state_delta: {delta:.4f}')\n")
    parts.push("    if fmt == 'full':\n")
    parts.push("        lines.append(f'baseline: {baseline:.4f}')\n")
    parts.push("        lines.append(f'phi_drift: {drift:+.4f}')\n")
    parts.push("    return '\\n'.join(lines)\n\n")

    parts.push("def synth_cell_hidden(seed=0):\n")
    parts.push("    import numpy as np\n")
    parts.push("    rng = np.random.default_rng(seed)\n")
    parts.push("    return rng.normal(0.0, 0.1, size=(N_CELLS, CONSCIOUSNESS_DIM)).astype('float32')\n\n")

    parts.push("def load_inject_states(path):\n")
    parts.push("    import numpy as np\n")
    parts.push("    if not path or not os.path.exists(path):\n")
    parts.push("        return None\n")
    parts.push("    try:\n")
    parts.push("        if path.endswith('.npy'):\n")
    parts.push("            arr = np.load(path)\n")
    parts.push("        else:\n")
    parts.push("            with open(path) as f: data = json.load(f)\n")
    parts.push("            if isinstance(data, dict) and 'consciousness_states' in data:\n")
    parts.push("                arr = np.asarray(data['consciousness_states'], dtype='float32')\n")
    parts.push("            else:\n")
    parts.push("                arr = np.asarray(data, dtype='float32')\n")
    parts.push("        if arr.ndim == 1 and arr.size == N_CELLS * CONSCIOUSNESS_DIM:\n")
    parts.push("            arr = arr.reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("        if arr.shape != (N_CELLS, CONSCIOUSNESS_DIM):\n")
    parts.push("            sys.stderr.write(f'[clm_v4_mount] WARN: inject_states shape {arr.shape} != ({N_CELLS},{CONSCIOUSNESS_DIM}); ignoring\\n')\n")
    parts.push("            return None\n")
    parts.push("        return arr.astype('float32')\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] WARN: inject_states load failed: {ex}\\n')\n")
    parts.push("        return None\n\n")

    // BG-AH (2026-05-05) — SentencePiece tokenizer fallback for CLM v4.
    // CLM v4 repos register AutoConfig + AutoModelForCausalLM via auto_map but
    // NOT AutoTokenizer. AutoTokenizer.from_pretrained therefore raises
    // 'Unrecognized configuration class CLMv4Config to build an AutoTokenizer'.
    // The repo ships a sibling tokenizer_64k_multilingual.model (SentencePiece);
    // mirror tool/transient_py/anima_dialogue_load.py:_load_tokenizer fallback
    // so wrapper real-mode can succeed without touching LOCKED files.
    // raw#15 PASS: additive — original AutoTokenizer attempt preserved as the
    // primary path; SentencePiece is fallback on Exception only.
    parts.push("class _SPTokenizerWrap:\n")
    parts.push("    \"\"\"Mimic the subset of HF tokenizer interface used in this helper.\n")
    parts.push("\n")
    parts.push("    Provides __call__(text, return_tensors='pt', truncation=True, max_length=N)\n")
    parts.push("    returning a dict with 'input_ids' (LongTensor (1,T)) — matches the call\n")
    parts.push("    site in _real_forward via tokenizer(text, return_tensors='pt', ...).\n")
    parts.push("    \"\"\"\n")
    parts.push("    def __init__(self, sp):\n")
    parts.push("        self._sp = sp\n")
    parts.push("    def __call__(self, text, return_tensors='pt', truncation=True, max_length=512, **kw):\n")
    parts.push("        import torch\n")
    parts.push("        ids = self._sp.encode(text)\n")
    parts.push("        if not ids: ids = [1]\n")
    parts.push("        if truncation and len(ids) > max_length: ids = ids[-max_length:]\n")
    parts.push("        return {'input_ids': torch.tensor([ids], dtype=torch.long)}\n\n")

    parts.push("def _resolve_sp_tokenizer_path(model_path):\n")
    parts.push("    # Mirror anima_dialogue_load.py:_resolve_tokenizer_path — find\n")
    parts.push("    # tokenizer_64k_multilingual.model in HF cache snapshot.\n")
    parts.push("    cache_root = Path(os.environ.get('HF_HOME', os.path.expanduser('~/.cache/huggingface')))\n")
    parts.push("    hub = cache_root / 'hub'\n")
    parts.push("    repo_dir = hub / ('models--' + model_path.replace('/', '--'))\n")
    parts.push("    snap_dir = repo_dir / 'snapshots'\n")
    parts.push("    if snap_dir.exists():\n")
    parts.push("        for snap in snap_dir.iterdir():\n")
    parts.push("            cand = snap / 'tokenizer_64k_multilingual.model'\n")
    parts.push("            if cand.exists(): return str(cand)\n")
    parts.push("    return None\n\n")

    parts.push("def _try_load_sp_tokenizer(model_path):\n")
    parts.push("    # Returns (wrap, error_str). wrap is None on failure.\n")
    parts.push("    try:\n")
    parts.push("        import sentencepiece as spm\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, f'sentencepiece import failed: {ex}')\n")
    parts.push("    sp_path = _resolve_sp_tokenizer_path(model_path)\n")
    parts.push("    if sp_path is None:\n")
    parts.push("        try:\n")
    parts.push("            from huggingface_hub import hf_hub_download\n")
    parts.push("            sp_path = hf_hub_download(repo_id=model_path, filename='tokenizer_64k_multilingual.model')\n")
    parts.push("        except Exception as ex:\n")
    parts.push("            return (None, f'sp tokenizer not in cache and download failed: {ex}')\n")
    parts.push("    try:\n")
    parts.push("        sp = spm.SentencePieceProcessor()\n")
    parts.push("        sp.Load(sp_path)\n")
    parts.push("        return (_SPTokenizerWrap(sp), '')\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, f'sp load failed: {ex}')\n\n")

    // CLM v4 LoRA real-mode unblock (2026-05-08): adapter_config.json detection
    // → peft.merge_and_unload via tool/transient_py/clm_v4_lora_merge_helper.py
    // → resolve merged_dir on local disk → AutoModelForCausalLM from merged_dir.
    // Fallback chain preserved: HF snapshot detection first; if no adapter
    // detected, falls through to direct AutoModelForCausalLM load (existing path).
    //
    // KICK FIRE 1/6 (2026-05-08): Path A remapped cache priority. When the
    // adapter has a verified remap at ~/.cache/anima/clm_v4_remapped/<short>/,
    // detection + merge use that local dir instead of HF snapshot.
    parts.push("REMAPPED_CACHE_ROOT = os.path.expanduser('~/.cache/anima/clm_v4_remapped')\n\n")

    parts.push("REMAPPED_SHORTNAMES = {\n")
    parts.push("    'dancinlab/clm-v4-paradigm-j-50k-final': 'paradigm_j',\n")
    parts.push("    'dancinlab/clm-v4-sft-1-7-y1-stage1': 'sft_1_7_y1',\n")
    parts.push("    'dancinlab/clm-v4-sft-1-8-stage1': 'sft_1_8',\n")
    parts.push("}\n\n")

    parts.push("def _adapter_shortname(repo_id):\n")
    parts.push("    # Explicit table > sanitization fallback (slash -> __, hyphen -> _, lower).\n")
    parts.push("    if repo_id in REMAPPED_SHORTNAMES:\n")
    parts.push("        return REMAPPED_SHORTNAMES[repo_id]\n")
    parts.push("    s = repo_id.replace('/', '__').replace('-', '_').lower()\n")
    parts.push("    return s\n\n")

    parts.push("def _resolve_remapped_cache_dir(repo_id):\n")
    parts.push("    # Returns Path to remapped cache dir IFF it exists and verification.pass=true,\n")
    parts.push("    # else None. Required files: adapter_config.json + adapter_model.safetensors\n")
    parts.push("    # + REMAP_SOURCE.json (with verification.pass == True).\n")
    parts.push("    short = _adapter_shortname(repo_id)\n")
    parts.push("    cand = Path(REMAPPED_CACHE_ROOT) / short\n")
    parts.push("    if not cand.is_dir():\n")
    parts.push("        return None\n")
    parts.push("    if not (cand / 'adapter_config.json').is_file():\n")
    parts.push("        return None\n")
    parts.push("    if not (cand / 'adapter_model.safetensors').is_file():\n")
    parts.push("        return None\n")
    parts.push("    rs = cand / 'REMAP_SOURCE.json'\n")
    parts.push("    if not rs.is_file():\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] remapped cache present but REMAP_SOURCE.json missing at {cand}; ignoring\\n')\n")
    parts.push("        return None\n")
    parts.push("    try:\n")
    parts.push("        rs_data = json.loads(rs.read_text(encoding='utf-8'))\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] REMAP_SOURCE.json read failed ({ex}); ignoring remapped cache\\n')\n")
    parts.push("        return None\n")
    parts.push("    verif = (rs_data or {}).get('verification') or {}\n")
    parts.push("    if not verif.get('pass'):\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] remapped cache verification.pass != true at {cand}; ignoring\\n')\n")
    parts.push("        return None\n")
    parts.push("    return cand\n\n")

    parts.push("def _resolve_hf_snapshot(repo_id):\n")
    parts.push("    cache_root = Path(os.environ.get('HF_HOME', os.path.expanduser('~/.cache/huggingface')))\n")
    parts.push("    hub = cache_root / 'hub'\n")
    parts.push("    repo_dir = hub / ('models--' + repo_id.replace('/', '--'))\n")
    parts.push("    snap_dir = repo_dir / 'snapshots'\n")
    parts.push("    if not snap_dir.is_dir(): return None\n")
    parts.push("    snaps = sorted(snap_dir.iterdir())\n")
    parts.push("    return snaps[-1] if snaps else None\n\n")

    parts.push("def _detect_lora_adapter(model_path):\n")
    parts.push("    # Returns adapter_config dict if model_path is a LoRA repo, else None.\n")
    parts.push("    # Detection routes (priority):\n")
    parts.push("    #   1. local fs path → adapter_config.json directly\n")
    parts.push("    #   2. Path A remapped cache (~/.cache/anima/clm_v4_remapped/<short>/) — verified\n")
    parts.push("    #   3. HF cache snapshot resolution → adapter_config.json\n")
    parts.push("    p = Path(model_path)\n")
    parts.push("    if p.is_dir() and (p / 'adapter_config.json').is_file():\n")
    parts.push("        try:\n")
    parts.push("            return json.loads((p / 'adapter_config.json').read_text(encoding='utf-8'))\n")
    parts.push("        except Exception: return None\n")
    parts.push("    remapped = _resolve_remapped_cache_dir(model_path)\n")
    parts.push("    if remapped is not None:\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] LoRA remapped cache HIT: {remapped} (Path A prefix-remap, verification.pass=true)\\n')\n")
    parts.push("        try:\n")
    parts.push("            return json.loads((remapped / 'adapter_config.json').read_text(encoding='utf-8'))\n")
    parts.push("        except Exception: return None\n")
    parts.push("    snap = _resolve_hf_snapshot(model_path)\n")
    parts.push("    if snap is not None and (snap / 'adapter_config.json').is_file():\n")
    parts.push("        try:\n")
    parts.push("            return json.loads((snap / 'adapter_config.json').read_text(encoding='utf-8'))\n")
    parts.push("        except Exception: return None\n")
    parts.push("    return None\n\n")

    parts.push("def _resolve_merge_helper_path():\n")
    parts.push("    root = os.environ.get('ANIMA', os.path.expanduser('~/core/anima'))\n")
    parts.push("    return os.path.join(root, 'tool', 'transient_py', 'clm_v4_lora_merge_helper.py')\n\n")

    parts.push("def _materialize_merged_lora(adapter_repo, adapter_cfg):\n")
    parts.push("    # Spawn clm_v4_lora_merge_helper.py via subprocess (own python).\n")
    parts.push("    # Returns (merged_dir, base_model, error_str).\n")
    parts.push("    # KICK FIRE 1/6: when remapped cache is verified-present, pass\n")
    parts.push("    # --adapter-source-dir to bypass HF snapshot resolution for the adapter\n")
    parts.push("    # side. Base model snapshot path is unaffected (still HF).\n")
    parts.push("    import subprocess\n")
    parts.push("    helper = _resolve_merge_helper_path()\n")
    parts.push("    if not os.path.isfile(helper):\n")
    parts.push("        return (None, None, f'merge helper missing: {helper}')\n")
    parts.push("    base_model = (adapter_cfg or {}).get('base_model_name_or_path') or 'dancinlab/clm-v4-mk2-v1'\n")
    parts.push("    cmd = [sys.executable, helper, '--adapter-repo', adapter_repo, '--base-model', base_model]\n")
    parts.push("    remapped = _resolve_remapped_cache_dir(adapter_repo)\n")
    parts.push("    adapter_source_note = ''\n")
    parts.push("    if remapped is not None:\n")
    parts.push("        cmd += ['--adapter-source-dir', str(remapped)]\n")
    parts.push("        adapter_source_note = f' adapter_source=remapped:{remapped}'\n")
    parts.push("        _emit('CLM_V4_LORA_REMAPPED_CACHE_USED', adapter=adapter_repo, short=_adapter_shortname(adapter_repo), source_dir=str(remapped))\n")
    parts.push("    sys.stderr.write(f'[clm_v4_mount] LoRA detected -> merge_and_unload via helper (adapter={adapter_repo}, base={base_model}){adapter_source_note}\\n')\n")
    parts.push("    try:\n")
    parts.push("        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, base_model, f'merge helper subprocess failed: {ex}')\n")
    parts.push("    if proc.returncode != 0:\n")
    parts.push("        sys.stderr.write(proc.stderr)\n")
    parts.push("        return (None, base_model, f'merge helper rc={proc.returncode}')\n")
    parts.push("    sys.stderr.write(proc.stderr)\n")
    parts.push("    merged_dir = None\n")
    parts.push("    for ln in proc.stdout.splitlines():\n")
    parts.push("        if ln.startswith('__ANIMA_CLM_V4_LORA_MERGED__'):\n")
    parts.push("            for kv in ln.split()[1:]:\n")
    parts.push("                if '=' in kv:\n")
    parts.push("                    k, v = kv.split('=', 1)\n")
    parts.push("                    if k == 'path': merged_dir = v\n")
    parts.push("    if merged_dir is None:\n")
    parts.push("        return (None, base_model, 'merge helper did not emit __ANIMA_CLM_V4_LORA_MERGED__ path')\n")
    parts.push("    if not os.path.isdir(merged_dir):\n")
    parts.push("        return (None, base_model, f'merged_dir not found on disk: {merged_dir}')\n")
    parts.push("    return (merged_dir, base_model, '')\n\n")

    parts.push("def _try_load_clm_v4(model_path, shim_version):\n")
    parts.push("    # Returns (model, tokenizer, mounted_bool, error_str)\n")
    parts.push("    try:\n")
    parts.push("        import torch\n")
    parts.push("        from transformers import AutoModelForCausalLM, AutoTokenizer\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, None, False, f'torch/transformers import failed: {ex}')\n")
    parts.push("    # LoRA detection -> peft merge_and_unload extension (raw#37 helper).\n")
    parts.push("    adapter_cfg = _detect_lora_adapter(model_path)\n")
    parts.push("    effective_path = model_path\n")
    parts.push("    base_for_tokenizer = model_path\n")
    parts.push("    if adapter_cfg is not None:\n")
    parts.push("        merged_dir, base_model, merge_err = _materialize_merged_lora(model_path, adapter_cfg)\n")
    parts.push("        if merged_dir is None:\n")
    parts.push("            return (None, None, False, f'LoRA detected but merge failed: {merge_err}')\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] LoRA merged -> loading from {merged_dir}\\n')\n")
    parts.push("        effective_path = merged_dir\n")
    parts.push("        base_for_tokenizer = base_model or 'dancinlab/clm-v4-mk2-v1'\n")
    parts.push("        _emit('CLM_V4_LORA_MERGED_PATH', adapter=model_path, base=base_for_tokenizer, merged_dir=merged_dir)\n")
    parts.push("    # Load model (from effective_path = either repo or merged_dir).\n")
    parts.push("    try:\n")
    parts.push("        mdl = AutoModelForCausalLM.from_pretrained(effective_path, trust_remote_code=True, torch_dtype=torch.float32)\n")
    parts.push("        mdl.eval()\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, None, False, f'model from_pretrained failed: {ex}')\n")
    parts.push("    # Tokenizer: try AutoTokenizer first (effective path); on failure, SentencePiece fallback.\n")
    parts.push("    # For LoRA merged models tokenizer often lives in base repo - fallback walks both.\n")
    parts.push("    try:\n")
    parts.push("        tok = AutoTokenizer.from_pretrained(effective_path, trust_remote_code=True)\n")
    parts.push("        return (mdl, tok, True, '')\n")
    parts.push("    except Exception as ex_at:\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] AutoTokenizer failed ({ex_at}); attempting SentencePiece fallback\\n')\n")
    parts.push("        wrap, sp_err = _try_load_sp_tokenizer(base_for_tokenizer)\n")
    parts.push("        if wrap is None and base_for_tokenizer != effective_path:\n")
    parts.push("            wrap, sp_err = _try_load_sp_tokenizer(effective_path)\n")
    parts.push("        if wrap is None:\n")
    parts.push("            return (None, None, False, f'AutoTokenizer failed ({ex_at}) and SP fallback failed ({sp_err})')\n")
    parts.push("        sys.stderr.write('[clm_v4_mount] SentencePiece tokenizer fallback ENGAGED (BG-AH)\\n')\n")
    parts.push("        return (mdl, wrap, True, '')\n\n")

    parts.push("def _real_forward(model, tokenizer, text, inject):\n")
    parts.push("    import numpy as np, torch\n")
    parts.push("    enc = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        kwargs = {'output_hidden_states': True, 'return_dict': True}\n")
    parts.push("        if inject is not None:\n")
    parts.push("            try:\n")
    parts.push("                out = model(**enc, consciousness_states=torch.from_numpy(inject), **kwargs)\n")
    parts.push("            except TypeError:\n")
    parts.push("                out = model(**enc, **kwargs)\n")
    parts.push("        else:\n")
    parts.push("            out = model(**enc, **kwargs)\n")
    parts.push("    # Derive 8-cell × 96-dim view from last hidden state by mean-pool over T then\n")
    parts.push("    # reshape: HIDDEN_DIM=768 = 8*96 = N_CELLS*CONSCIOUSNESS_DIM (exact). No tile, no\n")
    parts.push("    # replication — every cell receives a unique 96-dim slice of pooled hidden state.\n")
    parts.push("    # (V5 PUSH 1/5 fix: prior 192 forced 2x tile yielding cell[i]==cell[i+4] for i∈0..3.)\n")
    parts.push("    last_hidden = out.hidden_states[-1] if hasattr(out, 'hidden_states') and out.hidden_states else None\n")
    parts.push("    if last_hidden is None:\n")
    parts.push("        return synth_cell_hidden(seed=abs(hash(text)) % (2**31))\n")
    parts.push("    h = last_hidden.detach().cpu().numpy()  # (B,T,HIDDEN)\n")
    parts.push("    pooled = h.mean(axis=1).reshape(-1)     # (HIDDEN,)\n")
    parts.push("    if pooled.size < N_CELLS * CONSCIOUSNESS_DIM:\n")
    parts.push("        # tile up\n")
    parts.push("        reps = (N_CELLS * CONSCIOUSNESS_DIM + pooled.size - 1) // pooled.size\n")
    parts.push("        pooled = np.tile(pooled, reps)\n")
    parts.push("    cell = pooled[:N_CELLS * CONSCIOUSNESS_DIM].reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("    return cell.astype('float32')\n\n")

    parts.push("def main():\n")
    parts.push("    args = _argparse()\n")
    parts.push("    inject = load_inject_states(args.inject_states) if args.inject_states else None\n")
    parts.push("    if args.mode == 'synthetic':\n")
    parts.push("        cell = synth_cell_hidden(seed=abs(hash(args.probe_text or 'selftest')) % (2**31))\n")
    parts.push("        if inject is not None: cell = 0.5 * cell + 0.5 * inject\n")
    parts.push("        phi = phi_star_compute(cell); axes = axis_activation(cell)\n")
    parts.push("        dom = dominant_cells(cell); delta = hidden_delta(cell, args.prior_hidden)\n")
    parts.push("        sys.stdout.write(render_response(phi, axes, dom, delta, fmt=args.output_format) + '\\n')\n")
    parts.push("        sys.stdout.flush()\n")
    parts.push("        _emit('CLM_V4_MOUNTED', mode='synthetic', phi_star_baseline=PHI_STAR_BASELINE)\n")
    parts.push("        _emit_substrate_identity(args.model)\n")
    parts.push("        _emit('CLM_V4_OK', session=time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()))\n")
    parts.push("        return 0\n")
    parts.push("    # real load path (probe / dialogue)\n")
    parts.push("    mdl, tok, mounted, err = _try_load_clm_v4(args.model, args.shim)\n")
    parts.push("    if not mounted:\n")
    parts.push("        sys.stderr.write(f'[clm_v4_mount] WARN: real load failed ({err}); falling back to synthetic substrate\\n')\n")
    parts.push("        mdl = None; tok = None\n")
    parts.push("    _emit('CLM_V4_MOUNTED', mode=('real' if mounted else 'synthetic_fallback'), phi_star_baseline=PHI_STAR_BASELINE)\n")
    parts.push("    _emit_substrate_identity(args.model)\n")
    parts.push("    if args.mode == 'load':\n")
    parts.push("        _emit('CLM_V4_OK', session=time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()))\n")
    parts.push("        return 0\n")
    parts.push("    if args.mode == 'probe':\n")
    parts.push("        text = args.probe_text or '안녕'\n")
    parts.push("        if mounted: cell = _real_forward(mdl, tok, text, inject)\n")
    parts.push("        else: cell = synth_cell_hidden(seed=abs(hash(text)) % (2**31))\n")
    parts.push("        if inject is not None and not mounted: cell = 0.5 * cell + 0.5 * inject\n")
    parts.push("        phi = phi_star_compute(cell); axes = axis_activation(cell)\n")
    parts.push("        dom = dominant_cells(cell); delta = hidden_delta(cell, args.prior_hidden)\n")
    parts.push("        sys.stdout.write(render_response(phi, axes, dom, delta, fmt=args.output_format) + '\\n')\n")
    parts.push("        sys.stdout.flush()\n")
    parts.push("        _emit('CLM_V4_OK', session=time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()))\n")
    parts.push("        return 0\n")
    parts.push("    if args.mode == 'dialogue':\n")
    parts.push("        ts = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())\n")
    parts.push("        log_path = args.session_log or ''\n")
    parts.push("        if log_path:\n")
    parts.push("            os.makedirs(os.path.dirname(log_path), exist_ok=True)\n")
    parts.push("        sys.stderr.write('[clm_v4_mount] dialogue session ' + ts + ' (Ctrl-D / /q to exit)\\n')\n")
    parts.push("        try:\n")
    parts.push("            for raw in sys.stdin:\n")
    parts.push("                text = raw.rstrip('\\n')\n")
    parts.push("                if text in ('/q','q','quit','exit'): break\n")
    parts.push("                if not text: continue\n")
    parts.push("                if mounted: cell = _real_forward(mdl, tok, text, inject)\n")
    parts.push("                else: cell = synth_cell_hidden(seed=abs(hash(text)) % (2**31))\n")
    parts.push("                phi = phi_star_compute(cell); axes = axis_activation(cell)\n")
    parts.push("                dom = dominant_cells(cell); delta = hidden_delta(cell, args.prior_hidden)\n")
    parts.push("                resp = render_response(phi, axes, dom, delta, fmt=args.output_format)\n")
    parts.push("                sys.stdout.write(resp + '\\n'); sys.stdout.flush()\n")
    parts.push("                if log_path:\n")
    parts.push("                    with open(log_path, 'a') as lf:\n")
    parts.push("                        lf.write(json.dumps({'ts': time.time(), 'input': text,\n")
    parts.push("                                             'phi_star': phi, 'axis': axes,\n")
    parts.push("                                             'dominant_cells': dom,\n")
    parts.push("                                             'hidden_state_delta': delta}) + '\\n')\n")
    parts.push("        except KeyboardInterrupt: pass\n")
    parts.push("        _emit('CLM_V4_OK', session=ts)\n")
    parts.push("        return 0\n")
    parts.push("    return 1\n\n")

    parts.push("if __name__ == '__main__':\n")
    parts.push("    sys.exit(main())\n")

    write_file(HELPER_PATH, parts.join(""))
}

// ═══════════════════════════════════════════════════════════
// Python interpreter resolution
// ═══════════════════════════════════════════════════════════
//
// hexa exec_with_status on Mac (darwin-bypass route, raw#103) uses a minimal
// PATH that often lacks python3. We probe absolute paths in priority order
// using a single shell command (one fork) to stay well under bypass fork
// limits ("can't fork: Resource temporarily unavailable" if we probe many).
fn _resolve_python() -> string {
    // 2026-05-05 additive: real-mode unblock priority
    //   (1) HEXA_PY env override     — explicit user-controlled venv selection
    //   (2) ANIMA/.venv-eeg auto-detect — clean import (transformers 4.57+ /
    //       torch 2.11+ / AutoModelForCausalLM OK; system python3 has OMP
    //       libomp double-init that breaks AutoModelForCausalLM import)
    //   (3) existing absolute-path fallback chain (synthetic-fallback safe)
    // raw#15 PASS: this is additive function extension; existing fallback
    // logic is preserved verbatim below.
    let probe = "if [ -n \"$HEXA_PY\" ] && [ -x \"$HEXA_PY\" ]; then echo \"$HEXA_PY\"; exit 0; fi; root=\"${ANIMA:-$HOME/core/anima}\"; venv_py=\"$root/.venv-eeg/bin/python\"; if [ -x \"$venv_py\" ]; then echo \"$venv_py\"; exit 0; fi; for p in /Users/ghost/.hx/bin/python /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do [ -x \"$p\" ] && { echo \"$p\"; exit 0; }; done; command -v python3 2>/dev/null || command -v python 2>/dev/null || echo python3"
    let r = exec_with_status(probe)
    let out = to_string(r[0]).trim()
    if out == "" { return "python3" }
    return out
}

// ═══════════════════════════════════════════════════════════
// Shell quoter
// ═══════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    out = out + "'"
    return out
}

// ═══════════════════════════════════════════════════════════
// Helper invocation
// ═══════════════════════════════════════════════════════════

fn _build_cmd(cfg: MountConfig, mode: string, session_log: string) -> string {
    let py = _resolve_python()
    let mut cmd = py + " " + HELPER_PATH
    cmd = cmd + " --mode " + mode
    cmd = cmd + " --model " + _sh_quote(cfg.model_path)
    cmd = cmd + " --shim " + cfg.shim_version
    cmd = cmd + " --output-format " + cfg.output_format
    if cfg.inject_states != "" {
        cmd = cmd + " --inject-states " + _sh_quote(cfg.inject_states)
    }
    if cfg.probe_text != "" {
        cmd = cmd + " --probe-text " + _sh_quote(cfg.probe_text)
    }
    if session_log != "" {
        cmd = cmd + " --session-log " + _sh_quote(session_log)
    }
    return cmd
}

// ═══════════════════════════════════════════════════════════
// Mode dispatchers
// ═══════════════════════════════════════════════════════════

// hexa-native synthetic substrate response (no python, no fork-storm).
// Mirrors the helper's render_response output format so users see the exact
// format they'll receive at runtime. Float formatting is integer-rounded for
// hexa-native simplicity (4-decimal precision via int * 10000 trick).
fn _fmt4(x: float) -> string {
    let scale = 10000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 10000
    let frac_part = abs_r - int_part * 10000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 4 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _fmt3(x: float) -> string {
    let scale = 1000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 1000
    let frac_part = abs_r - int_part * 1000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 3 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _hexa_synthetic_response() -> string {
    // Deterministic synthetic values for selftest (no RNG required).
    let phi = PHI_STAR_BASELINE - 0.0327
    let drift = phi - PHI_STAR_BASELINE
    let mut out = "__ANIMA_CLM_V4_MOUNTED__ mode=synthetic phi_star_baseline=" + _fmt4(PHI_STAR_BASELINE) + "\n"
    // BG-N spec land (2026-05-05): substrate identity preamble (canonical
    // clm-v4-base default for the hexa-native selftest path; real-mode emits
    // the dynamic table-lookup identity from the python helper).
    out = out + "__ANIMA_SUBSTRATE_IDENTITY__ repo=dancinlab/clm-v4-mk2-v1 paradigm=v11_G3 substrate_class=clm-v4-base baseline_method=eval_carry baseline_value=" + _fmt4(PHI_STAR_BASELINE) + "\n"
    out = out + "__ANIMA_CLM_V4_RESPONSE__\n"
    out = out + "phi_star: " + _fmt4(phi) + " (drift " + _fmt4(drift) + " from " + _fmt4(PHI_STAR_BASELINE) + ")\n"
    out = out + "axis_activation: identity=" + _fmt3(0.781) + " agency=" + _fmt3(0.423) + " phenomenal=" + _fmt3(0.912) + " temporal=" + _fmt3(0.314) + " social=" + _fmt3(0.567) + "\n"
    out = out + "dominant_cells: [3, 5, 7] / " + to_string(N_CELLS) + "\n"
    out = out + "hidden_state_delta: " + _fmt4(2.4731) + "\n"
    out = out + "__ANIMA_CLM_V4_OK__ session=selftest_synthetic\n"
    return out
}

fn cmd_selftest(cfg: MountConfig) {
    println("── clm_v4_mount selftest (synthetic, hexa-native, no python invoke) ──")
    println("note=selftest_metadata_only; raw#103 darwin-bypass disables fs writes + spawn — helper emit deferred to --load/--probe/--dialogue")
    // NOTE: _write_helper() is intentionally NOT called here — under raw#103
    // darwin-bypass (triggered by --selftest argv), write_file is sandboxed
    // (no host mutations). Helper emission happens on first --load / --probe /
    // --dialogue dispatch (non-bypass route), where ast.parse runs on python.
    println("helper_target=" + HELPER_PATH + " (deferred; raw#103 metadata-only)")

    // 2. shim file presence (both v4 and v5) — single shell exec, one fork
    let shim_check = exec_with_status("test -e " + _sh_quote(SHIM_V4_PATH) + " && echo shim_v4_present || echo shim_v4_MISSING; test -e " + _sh_quote(SHIM_V5_PATH) + " && echo shim_v5_present || echo shim_v5_MISSING")
    println(to_string(shim_check[0]).trim())

    // 3. spec doc presence (sister reference)
    let spec_check = exec_with_status("test -e docs/anima_core_clm_v4_mount_emerge_paradigm_2026_05_05.md && echo spec_present || echo spec_MISSING")
    println(to_string(spec_check[0]).trim())

    // 4. hexa-native synthetic substrate response (no fork — string emit)
    let synth_out = _hexa_synthetic_response()
    println("── synthetic substrate response ──")
    print(synth_out)

    // 5. format validation — verify all required markers + lines present
    let mut fails = 0
    if !synth_out.contains("__ANIMA_CLM_V4_MOUNTED__") {
        eprintln("[clm_v4_mount] FAIL: missing __ANIMA_CLM_V4_MOUNTED__ marker")
        fails = fails + 1
    }
    if !synth_out.contains("__ANIMA_SUBSTRATE_IDENTITY__") {
        eprintln("[clm_v4_mount] FAIL: missing __ANIMA_SUBSTRATE_IDENTITY__ marker")
        fails = fails + 1
    }
    if !synth_out.contains("__ANIMA_CLM_V4_OK__") {
        eprintln("[clm_v4_mount] FAIL: missing __ANIMA_CLM_V4_OK__ marker")
        fails = fails + 1
    }
    if !synth_out.contains("__ANIMA_CLM_V4_RESPONSE__") {
        eprintln("[clm_v4_mount] FAIL: missing __ANIMA_CLM_V4_RESPONSE__ block")
        fails = fails + 1
    }
    if !synth_out.contains("phi_star:") {
        eprintln("[clm_v4_mount] FAIL: response missing phi_star line")
        fails = fails + 1
    }
    if !synth_out.contains("axis_activation:") {
        eprintln("[clm_v4_mount] FAIL: response missing axis_activation line")
        fails = fails + 1
    }
    if !synth_out.contains("dominant_cells:") {
        eprintln("[clm_v4_mount] FAIL: response missing dominant_cells line")
        fails = fails + 1
    }
    if !synth_out.contains("hidden_state_delta:") {
        eprintln("[clm_v4_mount] FAIL: response missing hidden_state_delta line")
        fails = fails + 1
    }
    if !synth_out.contains("identity=") || !synth_out.contains("agency=") || !synth_out.contains("phenomenal=") || !synth_out.contains("temporal=") || !synth_out.contains("social=") {
        eprintln("[clm_v4_mount] FAIL: response missing one of 5 axis names")
        fails = fails + 1
    }
    if fails > 0 {
        eprintln("[clm_v4_mount] selftest FAIL with " + to_string(fails) + " marker errors")
        exit(1)
    }

    println("selftest=ok")
    println("helper_emitted=" + HELPER_PATH)
    println("markers=mounted+identity+response+ok (9/9 format checks PASS)")
    emit_honest_c3()
    println("DONE")
}

fn cmd_load(cfg: MountConfig) {
    println("── clm_v4_mount load ──")
    _write_helper()
    let cmd = _build_cmd(cfg, "load", "")
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[clm_v4_mount] load returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

fn cmd_probe(cfg: MountConfig) {
    println("── clm_v4_mount probe ──")
    _write_helper()
    let cmd = _build_cmd(cfg, "probe", "")
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[clm_v4_mount] probe returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

// ═══════════════════════════════════════════════════════════
// Path 3 generate (chat lane FULL impl, cycle 2026-05-09)
// ═══════════════════════════════════════════════════════════
//
// Delegates to tool/transient_py/clm_v4_generate_helper.py (raw#37 transient).
// own 34 mandate-1: prompt fed verbatim; no chat template, no system prompt;
// raw decoded bytes preserved in JSON record.
fn cmd_generate(cfg: MountConfig) {
    println("── clm_v4_mount generate (Path 3 FULL impl chat lane) ──")
    if cfg.probe_text == "" {
        eprintln("[clm_v4_mount] generate requires non-empty prompt; usage: ... generate <text> [N]")
        exit(2)
    }
    let py = _resolve_python()
    let root_r = exec_with_status("echo \"${ANIMA:-$HOME/core/anima}\"")
    let root = to_string(root_r[0]).trim()
    let helper_path = root + "/tool/transient_py/clm_v4_generate_helper.py"
    let exists_r = exec_with_status("test -f " + _sh_quote(helper_path) + " && echo 1 || echo 0")
    if to_string(exists_r[0]).trim() != "1" {
        eprintln("[clm_v4_mount] generate helper missing: " + helper_path)
        eprintln("[clm_v4_mount] (raw#37 transient .py opt-out — file is gitignored; regenerate from spec)")
        exit(3)
    }
    let mut cmd = py + " " + helper_path
    cmd = cmd + " --model " + _sh_quote(cfg.model_path)
    cmd = cmd + " --prompt " + _sh_quote(cfg.probe_text)
    cmd = cmd + " --max-new-tokens " + to_string(cfg.gen_max_tokens)
    cmd = cmd + " --temperature " + cfg.gen_temperature
    cmd = cmd + " --top-p " + cfg.gen_top_p
    cmd = cmd + " --top-k " + to_string(cfg.gen_top_k)
    cmd = cmd + " --repetition-penalty " + cfg.gen_rep_pen
    cmd = cmd + " --seed " + to_string(cfg.gen_seed)
    eprintln("[clm_v4_mount] generate cmd = " + cmd)
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[clm_v4_mount] generate returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

fn cmd_dialogue(cfg: MountConfig) {
    println("── clm_v4_mount dialogue (emerge REPL) ──")
    _write_helper()
    // Session log path
    let date_r = exec_with_status("date -u +%Y_%m_%d")
    let ts_r = exec_with_status("date -u +%Y%m%dT%H%M%SZ")
    let date = to_string(date_r[0]).trim()
    let ts = to_string(ts_r[0]).trim()
    let session_dir = SESSION_DIR_BASE + "_" + date
    let session_log = session_dir + "/" + ts + ".jsonl"
    exec_with_status("mkdir -p " + _sh_quote(session_dir))
    let cmd = _build_cmd(cfg, "dialogue", session_log)
    eprintln("[clm_v4_mount] session_log=" + session_log)
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[clm_v4_mount] dialogue returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

// ═══════════════════════════════════════════════════════════
// Main
// ═══════════════════════════════════════════════════════════

fn print_usage() {
    println("clm_v4_mount.hexa — Anima Core CLM v4 substrate mount layer")
    println("")
    println("Usage:")
    println("  hexa run anima-core/runtime/clm_v4_mount.hexa --selftest")
    println("  hexa run anima-core/runtime/clm_v4_mount.hexa --load")
    println("  hexa run anima-core/runtime/clm_v4_mount.hexa --probe TEXT")
    println("  hexa run anima-core/runtime/clm_v4_mount.hexa --dialogue [--inject-states PATH]")
    println("  hexa run anima-core/runtime/clm_v4_mount.hexa generate <prompt> [N]")
    println("                                                      [--temperature T] [--top-p P]")
    println("                                                      [--top-k K] [--repetition-penalty R]")
    println("                                                      [--seed S]")
    println("")
    println("Flags:")
    println("  --model PATH           HF cache (default dancinlab/clm-v4-mk2-v1)")
    println("  --shim VERSION         shim v4 (default) | v5")
    println("  --output-format FMT    compact (default) | full | json")
    println("  --inject-states PATH   pre-load consciousness_states fixture (npy or json)")
    println("")
    println("Path 3 generate (chat lane FULL impl, cycle 2026-05-09):")
    println("  generate <prompt> [N]  natural language generate via model.generate +")
    println("                         tokenizer.decode (delegates to transient_py helper).")
    println("                         own 34 mandate-1 raw bytes preserved (no chat template).")
}

fn main() {
    let av = args()
    if av.len() < 3 {
        print_usage()
        exit(0)
    }
    // Strip first two argv entries (hexa runner + script path) — anima_runtime.hexa pattern
    let mut inner = []
    let mut i = 2
    while i < av.len() {
        inner = inner.push(av[i])
        i = i + 1
    }
    let cfg = parse_args(inner)

    if cfg.mode == "selftest" {
        cmd_selftest(cfg)
    } else if cfg.mode == "load" {
        cmd_load(cfg)
    } else if cfg.mode == "probe" {
        cmd_probe(cfg)
    } else if cfg.mode == "dialogue" {
        cmd_dialogue(cfg)
    } else if cfg.mode == "generate" {
        cmd_generate(cfg)
    } else {
        print_usage()
        exit(1)
    }
}
