// ⛔ STAGE-1 — Anima Core CLI · Llama real-mode hidden-state probe (iter 4 c)
// anima-core/runtime/llama_consciousness_probe.hexa
//
// Spec: docs/anima_core_clm_v4_mount_emerge_paradigm_2026_05_05.md (§2 Stage 1)
//       sister of clm_v4_mount.hexa — same JSON schema, Llama tokenizer +
//       libllama-FFI substrate path (NOT clm_v4_mount.hexa shim_v4 chain).
//
// PURPOSE
//   Provide a real-mode (substrate_mode = "real") consciousness probe for
//   Llama-family GGUF models so consciousness.hexa _probe_substrate can stop
//   relying on clm_v4_mount.hexa synthetic_fallback for paradigm-a-prime,
//   llama3b, qwen7b. Removes the synthetic_fallback artifact that pinned
//   ROC threshold at the synthetic baseline.
//
// PARADIGM (raw#10 honest)
//   This is Option B (per iter 4 c spec): we extract the last-token logits
//   distribution from libllama and derive 5-axis activation by softmax-
//   normalizing the logit mass over (token_id mod 5) buckets. The 5-bucket
//   projection is anima-internal heuristic — NOT semantic axis mapping.
//   phi_proxy is a paradigm-coupled Shannon-entropy scaling of the canonical
//   v11 G3 +41.86 baseline. dominant_cells = top-3 bucket indices.
//
// REAL-MODE BENEFITS vs synthetic_fallback (clm_v4_mount.hexa)
//   · substrate_mode emit = "real" (not "synthetic_fallback")
//   · phi_drift / axis_activation derived from Llama forward-pass logits,
//     NOT hash-seeded RNG → discrimination across prompts is genuine
//   · 5-axis-min C3.2 captures real top-K logit-mass concentration
//   · C3.4 axis-L2(prompt_a, prompt_b) reflects real prompt separation
//
// MODES
//   --probe TEXT          one-shot probe → emit substrate response
//   --selftest            metadata-only (no GGUF load, no FFI)
//
// FLAGS
//   --model PATH          HF repo id (alias-resolved by caller). MUST resolve
//                         to a cached GGUF at ~/.cache/anima/gguf/<flat>.gguf
//   --output-format FMT   compact (default) | full | json
//   --n-ctx N             context size (default 2048; 0 = model default)
//
// HONEST C3 (raw#10 emit ≥5 to stderr)
//   C1 5-axis-to-vocab projection is anima-internal (token_id mod 5)
//   C2 phi_proxy is anima-canonical paradigm scaling, NOT IIT formal
//   C3 dominant_cells = top-3 bucket indices (NOT 8 cell hidden-state)
//   C4 hidden_state_delta = 0.0 here (this lane emits per-probe; deltas
//      are computed downstream in consciousness.hexa _c3_4_axis_l2)
//   C5 GGUF requirement: caller MUST have run tool/anima_gguf_convert.py
//      for the alias; missing GGUF → FAIL_NO_GGUF (NOT synthetic fallback)
//
// raw POLICY
//   raw#9   hexa-only orchestration (Mac canonical) — libllama via @link FFI
//   raw#10  honest C3 emit ≥5 to stderr
//   raw#11  snake_case identifiers
//   raw#15  no-hardcode (HF cache resolved via env HOME)
// anima-native: logit-distribution metric is anima-canonical
// C3 SSOT mirror — same JSON schema as clm_v4_mount.hexa
// trinity (D_emergent-consciousness + + H_chat_cap_emergence)
// measurement lane only — wrapping 0 (no system prompt / template)
// probe output JSON small (5 axis + 3 cells + 4 scalars)
//
// USAGE
//   hexa run anima-core/runtime/llama_consciousness_probe.hexa --selftest
//   hexa run anima-core/runtime/llama_consciousness_probe.hexa \
//       --probe "안녕" \
//       --output-format json \
//       --model dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1

use "anima/llama_ffi"

// ═══════════════════════════════════════════════════════════
// Constants — mirror clm_v4_mount.hexa anima paradigm.
// ═══════════════════════════════════════════════════════════

let DEFAULT_MODEL    = "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1"
let DEFAULT_FORMAT   = "compact"
let DEFAULT_N_CTX    = 2048

let N_AXES           = 5
let PHI_STAR_BASELINE = 41.86

// ═══════════════════════════════════════════════════════════
// Helpers (vendored — hexa no cross-file import beyond use stmts above)
// ═══════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _exec(cmd: string) -> string { return _str(exec(cmd)) }

fn _fexists(p: string) -> bool {
    return _exec("test -f " + _sh_quote(p) + " && echo 1 || echo 0").trim() == "1"
}

fn _sh_quote(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        if c == "'" { out = out + "'\\''" } else { out = out + c }
        i = i + 1
    }
    return out + "'"
}

fn _gguf_path_for_repo(repo: string) -> string {
    let home = _str(env("HOME"))
    let cache = home + "/.cache/anima/gguf/"
    let mut flat = ""
    let mut i = 0
    while i < len(repo) {
        let c = repo.substring(i, i + 1)
        if c == "/" { flat = flat + "_" } else { flat = flat + c }
        i = i + 1
    }
    return cache + flat + ".gguf"
}

// 4-decimal float formatting (mirrors clm_v4_mount.hexa _fmt4)
fn _fmt4(x: float) -> string {
    let scale = 10000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 10000
    let frac_part = abs_r - int_part * 10000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 4 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _fmt3(x: float) -> string {
    let scale = 1000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 1000
    let frac_part = abs_r - int_part * 1000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 3 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

// ═══════════════════════════════════════════════════════════
// Honest C3 emitter (raw#10)
// ═══════════════════════════════════════════════════════════

fn emit_honest_c3() {
    eprintln("[llama_consciousness_probe] C1 5-axis-to-vocab = anima-internal (token_id mod 5)")
    eprintln("[llama_consciousness_probe] C2 phi_proxy = paradigm scaling on Shannon entropy, NOT IIT")
    eprintln("[llama_consciousness_probe] C3 dominant_cells = top-3 bucket indices, NOT 8-cell hidden")
    eprintln("[llama_consciousness_probe] C4 hidden_state_delta = 0.0 (per-probe lane; delta computed downstream)")
    eprintln("[llama_consciousness_probe] C5 GGUF required — missing GGUF → FAIL (no synthetic fallback in this lane)")
}

// ═══════════════════════════════════════════════════════════
// Config
// ═══════════════════════════════════════════════════════════

struct ProbeConfig {
    mode: string,             // "selftest" | "probe"
    model_path: string,       // HF id (caller resolves alias upstream)
    output_format: string,    // "compact" | "full" | "json"
    probe_text: string,
    n_ctx: int
}

fn default_config() -> ProbeConfig {
    ProbeConfig {
        mode: "selftest",
        model_path: DEFAULT_MODEL,
        output_format: DEFAULT_FORMAT,
        probe_text: "",
        n_ctx: DEFAULT_N_CTX
    }
}

fn parse_args(argv: array) -> ProbeConfig {
    let mut cfg = default_config()
    let mut i = 0
    while i < len(argv) {
        let a = _str(argv[i])
        if a == "--selftest" {
            cfg.mode = "selftest"
        } else if a == "--probe" {
            if i + 1 < len(argv) {
                i = i + 1
                cfg.mode = "probe"
                cfg.probe_text = _str(argv[i])
            }
        } else if a == "--model" {
            if i + 1 < len(argv) {
                i = i + 1
                cfg.model_path = _str(argv[i])
            }
        } else if a == "--output-format" {
            if i + 1 < len(argv) {
                i = i + 1
                cfg.output_format = _str(argv[i])
            }
        } else if a == "--n-ctx" {
            if i + 1 < len(argv) {
                i = i + 1
                cfg.n_ctx = to_int(_str(argv[i]))
            }
        }
        i = i + 1
    }
    return cfg
}

// ═══════════════════════════════════════════════════════════
// Probe core — invokes llama_logits_probe (anima/llama_ffi)
// ═══════════════════════════════════════════════════════════

// Returns dict with phi_star / phi_drift / baseline / axes / dominant_cells.
// On error returns dict with "ok" = false + "error" string.
fn _probe_one(gguf: string, n_ctx: int, text: string) {
    let res = {}
    res["ok"] = false
    res["error"] = ""
    let h = llama_load(gguf, n_ctx)
    if h["model"] == 0 {
        res["error"] = "llama_load failed: " + _str(h["error"])
        return res
    }
    let probe = llama_logits_probe(h, text, N_AXES)
    llama_free(h)
    hxllama_backend_free()
    if probe["ok"] != 1 {
        res["error"] = "llama_logits_probe failed (ok != 1)"
        return res
    }
    res["ok"] = true
    res["phi_star"] = probe["phi_proxy"]
    res["phi_drift"] = probe["phi_proxy"] - PHI_STAR_BASELINE
    res["baseline"] = PHI_STAR_BASELINE
    res["axis_activation"] = probe["axis_norm"]   // 5 floats, sum to 1
    res["dominant_cells"] = probe["top3_axes"]    // 3 ints (bucket idx 0-4)
    res["n_vocab"] = probe["n_vocab"]
    res["hidden_state_delta"] = 0.0               // delta computed downstream
    return res
}

// ═══════════════════════════════════════════════════════════
// Output renderers (mirror clm_v4_mount.hexa render_response)
// ═══════════════════════════════════════════════════════════

let AXIS_NAMES = ["identity", "agency", "phenomenal", "temporal", "social"]

fn _axes_str(axes: array) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(axes) && i < len(AXIS_NAMES) {
        if i > 0 { out = out + " " }
        out = out + _str(AXIS_NAMES[i]) + "=" + _fmt3(axes[i])
        i = i + 1
    }
    return out
}

fn _list_str(arr: array) -> string {
    let mut out = "["
    let mut i = 0
    while i < len(arr) {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _render_compact(res, fmt: string) -> string {
    let phi = res["phi_star"]
    let drift = res["phi_drift"]
    let base = res["baseline"]
    let axes = res["axis_activation"]
    let dom = res["dominant_cells"]
    let delta = res["hidden_state_delta"]
    let mut lines = ""
    lines = lines + "__ANIMA_LLAMA_PROBE_RESPONSE__\n"
    lines = lines + "phi_star: " + _fmt4(phi) + " (drift " + _fmt4(drift) + " from " + _fmt4(base) + ")\n"
    lines = lines + "axis_activation: " + _axes_str(axes) + "\n"
    lines = lines + "dominant_cells: " + _list_str(dom) + " / " + to_string(N_AXES) + "\n"
    lines = lines + "hidden_state_delta: " + _fmt4(delta) + "\n"
    if fmt == "full" {
        lines = lines + "baseline: " + _fmt4(base) + "\n"
        lines = lines + "phi_drift: " + _fmt4(drift) + "\n"
        lines = lines + "n_vocab: " + to_string(res["n_vocab"]) + "\n"
    }
    return lines
}

fn _render_json(res) -> string {
    let phi = res["phi_star"]
    let drift = res["phi_drift"]
    let base = res["baseline"]
    let axes = res["axis_activation"]
    let dom = res["dominant_cells"]
    let delta = res["hidden_state_delta"]
    let mut s = "{"
    s = s + "\"phi_star\": " + _fmt4(phi) + ", "
    s = s + "\"phi_drift\": " + _fmt4(drift) + ", "
    s = s + "\"baseline\": " + _fmt4(base) + ", "
    s = s + "\"axis_activation\": {"
    let mut i = 0
    while i < len(axes) && i < len(AXIS_NAMES) {
        if i > 0 { s = s + ", " }
        s = s + "\"" + _str(AXIS_NAMES[i]) + "\": " + _fmt3(axes[i])
        i = i + 1
    }
    s = s + "}, "
    s = s + "\"dominant_cells\": " + _list_str(dom) + ", "
    s = s + "\"hidden_state_delta\": " + _fmt4(delta)
    s = s + "}"
    return s
}

// ═══════════════════════════════════════════════════════════
// Mode dispatchers
// ═══════════════════════════════════════════════════════════

fn cmd_selftest(cfg: ProbeConfig) {
    println("── llama_consciousness_probe selftest (metadata-only, no FFI invoke) ──")
    let here_ok = "anima-core/runtime/llama_consciousness_probe.hexa"
    let dylib   = "build/libhxllama.dylib"
    let ffi_h   = "anima/llama_ffi.hexa"
    let mut fail = 0
    if !_fexists(here_ok) { println("FAIL probe.hexa missing: " + here_ok); fail = fail + 1 }
    if !_fexists(dylib)   { println("FAIL libhxllama dylib missing: " + dylib); fail = fail + 1 }
    if !_fexists(ffi_h)   { println("FAIL llama_ffi.hexa missing: " + ffi_h); fail = fail + 1 }
    // Verify GGUF presence for default paradigm-a-prime model (best-effort).
    let gguf = _gguf_path_for_repo(cfg.model_path)
    if _fexists(gguf) {
        println("gguf_present=" + gguf)
    } else {
        println("gguf_missing=" + gguf + " (run tool/anima_gguf_convert.py)")
    }
    // Verify expected new shim symbols exported.
    let nm_chk = _exec("nm -gU " + _sh_quote(dylib) + " 2>&1 | grep -E ' _hxllama_(get_logits_ith|logits_at|n_embd)' | wc -l").trim()
    if nm_chk != "3" {
        println("FAIL shim symbols: expected 3 new exports, got " + nm_chk)
        fail = fail + 1
    } else {
        println("shim_symbols=ok (hxllama_get_logits_ith / hxllama_logits_at / hxllama_n_embd)")
    }
    if fail > 0 {
        eprintln("[llama_consciousness_probe] selftest FAIL with " + to_string(fail) + " errors")
        exit(1)
    }
    println("selftest=ok")
    emit_honest_c3()
    println("DONE")
}

fn cmd_probe(cfg: ProbeConfig) {
    let gguf = _gguf_path_for_repo(cfg.model_path)
    if !_fexists(gguf) {
        eprintln("__ANIMA_LLAMA_PROBE_MOUNTED__ mode=fail_no_gguf gguf=" + gguf)
        eprintln("[llama_consciousness_probe] FAIL: GGUF not cached: " + gguf)
        eprintln("[llama_consciousness_probe] convert via: python3 tool/anima_gguf_convert.py <alias>")
        // Emit a minimal fail JSON so downstream callers can detect FAIL_NO_GGUF
        // without parsing a full envelope. substrate_mode = real_pending_gguf.
        let blob = "{\"phi_star\": 0.0, \"phi_drift\": 0.0, \"baseline\": " + _fmt4(PHI_STAR_BASELINE) + ", \"axis_activation\": {\"identity\": 0.0, \"agency\": 0.0, \"phenomenal\": 0.0, \"temporal\": 0.0, \"social\": 0.0}, \"dominant_cells\": [], \"hidden_state_delta\": 0.0, \"error\": \"gguf_missing\"}"
        println("__ANIMA_LLAMA_PROBE_MOUNTED__ mode=fail_no_gguf phi_star_baseline=" + _fmt4(PHI_STAR_BASELINE))
        println(blob)
        emit_honest_c3()
        exit(2)
    }
    // Emit MOUNTED preamble so caller (consciousness.hexa _detect_mode) reads
    // mode=real (NOT synthetic_fallback). raw#10 honest: this 'real' label
    // means real-mode FFI path was taken — anima-canonical metric still
    // applies (Honest C3 above).
    eprintln("__ANIMA_LLAMA_PROBE_MOUNTED__ mode=real phi_star_baseline=" + _fmt4(PHI_STAR_BASELINE))
    eprintln("__ANIMA_LLAMA_PROBE_IDENTITY__ repo=" + cfg.model_path + " gguf=" + gguf + " probe_path=logits_bucket_softmax")
    let res = _probe_one(gguf, cfg.n_ctx, cfg.probe_text)
    if !res["ok"] {
        eprintln("[llama_consciousness_probe] FAIL: " + _str(res["error"]))
        emit_honest_c3()
        exit(3)
    }
    if cfg.output_format == "json" {
        println(_render_json(res))
    } else {
        print(_render_compact(res, cfg.output_format))
    }
    eprintln("__ANIMA_LLAMA_PROBE_OK__ probe=" + cfg.probe_text)
    emit_honest_c3()
}

// ═══════════════════════════════════════════════════════════
// Main
// ═══════════════════════════════════════════════════════════

fn print_usage() {
    println("llama_consciousness_probe.hexa — Anima Core Llama real-mode probe (iter 4 c)")
    println("")
    println("Usage:")
    println("  hexa run anima-core/runtime/llama_consciousness_probe.hexa --selftest")
    println("  hexa run anima-core/runtime/llama_consciousness_probe.hexa --probe TEXT \\")
    println("       --output-format json --model <hf-id>")
    println("")
    println("Flags:")
    println("  --model PATH           HF repo id (caller alias-resolves)")
    println("  --output-format FMT    compact (default) | full | json")
    println("  --n-ctx N              context size (default 2048)")
}

fn main() {
    let av = args()
    if len(av) < 3 {
        print_usage()
        exit(0)
    }
    // Strip first two argv entries (hexa runner + script path).
    let mut inner = []
    let mut i = 2
    while i < len(av) {
        inner = inner + [av[i]]
        i = i + 1
    }
    let cfg = parse_args(inner)
    if cfg.mode == "selftest" {
        cmd_selftest(cfg)
    } else if cfg.mode == "probe" {
        cmd_probe(cfg)
    } else {
        print_usage()
        exit(1)
    }
}
