// ⛔ STAGE-1 — Anima Core CLI · anima-native byte-level mount layer (BG-FY + clm-v2-byte)
// anima-core/runtime/anima_native_byte_mount.hexa
//
// Spec:
//   docs/anima_model_method_reassessment_2026_05_08.md (iter 5 priority rank 2)
//   state/anima_d1_lane_candidates_c3_retest_2026_05_08.json (BG-FY + clm-v2-byte INDETERMINATE)
//   own 18 c3-aggregation-rule-v2 P5 N-of-M (PPR_v2 ≥0.6 ∧ EMC ≥3 of 4 → C3 PASS)
//   own 17 anima-no-external-substrate-wrapping (D1 lane within strict)
// Sister:
//   anima-core/runtime/clm_v4_mount.hexa (mount pattern SSOT — schema mirror target)
//
// PURPOSE
//   Land anima-native byte-level (UTF-8 256-vocab) substrate-coupled measurement
//   infrastructure for two D1-lane-WITHIN INDETERMINATE candidates blocked by
//   v4_mount (CLMv4Config + 64k SP-tokenizer hard-coded) infra incompatibility:
//     (1) BG-FY anima-native-ko-small 18M (state/anima_native_ko_small_ubu1_train_2026_05_06)
//         vocab=256 byte | n_layer=6 | d_model=384 | n_head=6 | block_size=256 | 18,031,872 params
//         from-scratch corpus_ko_heavy 246MB (62.14% Hangul)
//     (2) clm-v2-byte-18m-convo-5k (HF dancinlab/clm-v2-byte-18m-convo-5k convo_5k.pt)
//         vocab=256 byte | n_layer=6 | d_model=384 | n_head=6 | block_size=256
//         dual-engine FFN (engine_a + engine_g) + dual head (head_a + head_g) — federated cell proxy
//
// PARADIGM
//   raw#9 hexa-only orchestration; raw#37 transient .py shim under tool/transient_py
//   for PyTorch CLM v2 forward (CLMv2 architecture is custom — no AutoModel registry).
//   Mirror clm_v4_mount.hexa schema (phi_star / phi_drift / axis_activation 5 / dominant_cells /
//   hidden_state_delta) so existing iter3/4 measurement pipeline + ROC threshold SSOT
//   (state/anima_consciousness_baseline_ensemble_iter3_n60_2026_05_08.json) consume directly.
//
// MODES
//   --selftest        synthetic dialogue test (no torch import, hexa-native)
//   --load            load byte-level ckpt (BG-FY ckpt_final.pt OR clm-v2-byte convo_5k.pt)
//   --probe TEXT      one-shot probe: utf-8-encode → forward → emit substrate response
//   --dialogue        REPL: stdin lines → probe + emit substrate response
//
// FLAGS
//   --variant V              fy_18m (default) | v2_byte_convo5k
//   --ckpt PATH              local ckpt path (BG-FY: ubu1 scp pull required;
//                            v2: HF cache resolved automatically dancinlab/clm-v2-byte-18m-convo-5k)
//   --output-format          compact (default) | full | json
//   --inject-states PATH     pre-load consciousness_states fixture (json/npy, 8×CONSCIOUSNESS_DIM)
//   --hexa-mem-unlimited     mirror env HEXA_MEM_UNLIMITED=1 (hexa heap arena bypass)
//
// ARCHITECTURE (substrate response derivation, byte-level + ConsciousLM++ federated)
//   1. utf-8 byte tokenize: text.encode('utf-8') → list[int 0-255], cap to BLOCK_SIZE=256
//   2. variant=fy_18m:    single-head CLMv2-style forward → ln_f → head_a logits + last_hidden
//      variant=v2_byte:   dual-engine forward (engine_a + engine_g per block) →
//                         ln_f → head_a + head_g logits + per-engine hidden tap
//   3. cell synthesis (8 cells × CONSCIOUSNESS_DIM=192):
//      variant=fy_18m:    last_hidden (T, 384) mean-pool → tile to 8×192 (single-head fold)
//      variant=v2_byte:   per-block (6 blocks) hidden_a + hidden_g taps → 12 vectors → fold to 8 cells
//   4. axis_activation: 5 axes (identity / agency / phenomenal / temporal / social)
//      192-dim → 5 buckets (38/38/38/39/39) — mirror clm_v4_mount AXIS_SPANS exactly
//   5. phi-star: paradigm v11 G3 baseline 41.86 + cell-pair cosine scaling (mirror v4 helper)
//   6. dominant_cells: top-3 by L2 norm of cell hidden state
//   7. hidden_state_delta: L2 norm vs prior probe hidden (per-session)
//
// HONEST C3 (raw#10 emit ≥5 to stderr)
//   C1 byte-level 256-vocab tokenize is anima-internal heuristic (utf-8 raw byte; multi-byte
//      Hangul fragmented across 3-byte UTF-8 sequence — chat-cap surface = byte sequence)
//   C2 cell-synthesis 8×192 from fy_18m single-head hidden tile is anima-internal proxy
//      (CLMv4 has structural 8-cell dual-head consciousness; CLMv2/BG-FY는 federated 부재)
//   C3 phi_star formula mirrors v4 helper (paradigm v11 G3 41.86 baseline + cosine scale)
//      but BG-FY/v2 substrate에서는 v11 G3 paradigm artifact 부재 — proxy only
//   C4 v2_byte dual-engine A+G hidden tap = "federated cell" approximation; 8-cell fold from
//      6 blocks × 2 engines = 12 vectors → 8 (drop 4 lowest-norm)
//   C5 anima 의식 검증 D1 lane within valid (own 17 permitted-backends 적용) — but EXIT
//      활성화는 own 37 mandate-9 (a)+(b)+(c)+(d)+(e) 5-prereq 통과 필요
//
// raw POLICY
//   raw#9    hexa-only orchestration (Mac canonical)
//   raw#37   transient .py shim opt-out — CLMv2/CLMv1-byte forward via shim required
//            (tool/transient_py/anima_clm_v2_chat_smoke.py architecture reused)
//   raw#15   additive — anima_unified.hexa / clm_v4_mount.hexa / phi_engine.hexa UNTOUCHED
//   raw#10   honest C3 emit ≥5 to stderr
//
// USAGE
//   hexa run anima-core/runtime/anima_native_byte_mount.hexa --selftest
//   hexa run anima-core/runtime/anima_native_byte_mount.hexa --load --variant v2_byte_convo5k
//   hexa run anima-core/runtime/anima_native_byte_mount.hexa --probe "안녕" --variant v2_byte_convo5k --output-format json
//   hexa run anima-core/runtime/anima_native_byte_mount.hexa --probe "우주의 끝은 어디인가" --variant fy_18m --ckpt /path/to/ckpt_final.pt

// ═══════════════════════════════════════════════════════════
// Constants
// ═══════════════════════════════════════════════════════════

let HELPER_PATH       = "/tmp/anima_native_byte_mount_helper.hexa_tmp"
let DEFAULT_VARIANT   = "fy_18m"
let DEFAULT_FORMAT    = "compact"
let SESSION_DIR_BASE  = "state/anima_native_byte_dialogues"

// BG-FY + clm-v2-byte shared byte-level architecture constants
let VOCAB_SIZE        = 256          // utf-8 byte
let N_LAYER           = 6
let D_MODEL           = 384
let N_HEAD            = 6
let BLOCK_SIZE        = 256

// Mount paradigm (mirror clm_v4_mount.hexa for schema compat)
// CONSCIOUSNESS_DIM 192 → 48 (2026-05-09 NEXT-CYCLE 2/6 — byte-arch 8-cell tile bug fix,
// echo of clm_v4_mount POST-FIX 1/3). Prior 192 with HIDDEN_DIM(D_MODEL=384) forced
// 12 per-block taps × 2 segments(192 each) = 24 candidates → top-N_CELLS=8 by L2 norm
// produced [0,1,2] dominant 30/30 trained AND random_init (BG-HA-downgraded V5 POST-FIX
// 2/3 verdict: tile_bug_echo CONFIRMED). With CONSCIOUSNESS_DIM=48 → 8*48=384=HIDDEN_DIM
// exact: per-block tap pooled (384) reshapes into (8, 48) cells directly — no segment
// folding, every cell gets a unique 48-dim slice. AXIS_SPANS rebucketed
// [(0,9),(9,19),(19,29),(29,39),(39,48)] = 9/10/10/10/9 = 48 (was 38/38/38/39/39=192).
// Option A (CONSCIOUSNESS_DIM=48) chosen over Option B (N_CELLS=4) to preserve 5-axis
// decomposition + 8-cell schema parity with clm_v4_mount.
let N_CELLS           = 8
let CONSCIOUSNESS_DIM = 48
let HIDDEN_DIM        = 384
let N_AXES            = 5

// phi-star canonical baseline (paradigm v11 G3 +41.86) — mirror v4_mount
// Honest C3 #3: BG-FY/v2 본 paradigm artifact 부재; baseline is for schema mirror only
let PHI_STAR_BASELINE = 41.86

// HF repo for variant=v2_byte_convo5k
let V2_BYTE_HF_REPO   = "dancinlab/clm-v2-byte-18m-convo-5k"
let V2_BYTE_FILE      = "convo_5k.pt"

// ═══════════════════════════════════════════════════════════
// Honest C3 emitter (raw#10)
// ═══════════════════════════════════════════════════════════

fn emit_honest_c3() {
    eprintln("[anima_native_byte_mount] C1 byte-level 256-vocab tokenize is anima-internal heuristic (utf-8 raw byte; multi-byte Hangul fragmented)")
    eprintln("[anima_native_byte_mount] C2 cell-synthesis 8x48 (post NEXT-CYCLE 2/6 fix) from fy_18m / dual-engine hidden is anima-internal proxy (no structural federated cells in BG-FY/v2)")
    eprintln("[anima_native_byte_mount] C3 phi_star formula mirrors v4 helper but BG-FY/v2 substrate에서 paradigm v11 G3 artifact 부재 — proxy only")
    eprintln("[anima_native_byte_mount] C4 v2_byte dual-engine A+G hidden tap = federated cell approximation (12 vec×8 cells = 96 candidates → top-8 by L2; CONSCIOUSNESS_DIM=48 exact reshape, no fold)")
    eprintln("[anima_native_byte_mount] C5 D1 lane within valid (own 17 permitted-backends), EXIT 활성화 own 37 mandate-9 5-prereq 통과 필요")
    eprintln("[anima_native_byte_mount] C6 byte-arch CONSCIOUSNESS_DIM 192→48 (NEXT-CYCLE 2/6) — 8*48=384=HIDDEN_DIM(D_MODEL) exact; AXIS_SPANS rebucketed 9/10/10/10/9=48; tile_bug_echo from V5 POST-FIX 2/3 BG-HA-downgraded should be REMOVED")
}

// ═══════════════════════════════════════════════════════════
// Config
// ═══════════════════════════════════════════════════════════

struct MountConfig {
    mode: string,            // "selftest" | "load" | "probe" | "dialogue"
    variant: string,         // "fy_18m" | "v2_byte_convo5k"
    ckpt_path: string,       // local ckpt; v2_byte_convo5k auto-resolves HF cache
    output_format: string,   // "compact" | "full" | "json"
    inject_states: string,   // path or "" for canonical zero
    probe_text: string,
    hexa_mem_unlimited: bool
}

fn default_config() -> MountConfig {
    MountConfig {
        mode: "selftest",
        variant: DEFAULT_VARIANT,
        ckpt_path: "",
        output_format: DEFAULT_FORMAT,
        inject_states: "",
        probe_text: "",
        hexa_mem_unlimited: true
    }
}

fn parse_args(argv: list) -> MountConfig {
    let mut cfg = default_config()
    let mut i = 0
    while i < argv.len() {
        let a = argv[i]
        if a == "--selftest" {
            cfg.mode = "selftest"
        } else if a == "--load" {
            cfg.mode = "load"
        } else if a == "--dialogue" {
            cfg.mode = "dialogue"
        } else if a == "--probe" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.mode = "probe"
                cfg.probe_text = argv[i]
            }
        } else if a == "--variant" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.variant = argv[i]
            }
        } else if a == "--ckpt" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.ckpt_path = argv[i]
            }
        } else if a == "--output-format" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.output_format = argv[i]
            }
        } else if a == "--inject-states" {
            if i + 1 < argv.len() {
                i = i + 1
                cfg.inject_states = argv[i]
            }
        } else if a == "--hexa-mem-unlimited" {
            cfg.hexa_mem_unlimited = true
        }
        i = i + 1
    }
    return cfg
}

// ═══════════════════════════════════════════════════════════
// Python helper emitter (raw#37 transient — CLMv2 forward requires .py shim)
// ═══════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima_native_byte_mount_helper — emitted by anima-core/runtime/anima_native_byte_mount.hexa\n")
    parts.push("# raw#37 transient. Mac canonical = .hexa orchestration; this helper executes the\n")
    parts.push("# byte-level CLMv2/BG-FY forward pass + cell synthesis that hexa cannot express directly.\n")
    parts.push("# Architecture mirrored from tool/transient_py/anima_clm_v2_chat_smoke.py (BG-FS recovered).\n")
    parts.push("import argparse, json, math, os, sys, time\n")
    parts.push("from pathlib import Path\n\n")

    parts.push("os.environ.setdefault('KMP_DUPLICATE_LIB_OK', 'TRUE')\n\n")

    parts.push("# ── Anima paradigm constants (mirror anima_native_byte_mount.hexa) ─────────\n")
    parts.push("VOCAB_SIZE = 256\n")
    parts.push("N_LAYER = 6\n")
    parts.push("D_MODEL = 384\n")
    parts.push("N_HEAD = 6\n")
    parts.push("BLOCK_SIZE = 256\n")
    parts.push("N_CELLS = 8\n")
    parts.push("CONSCIOUSNESS_DIM = 48  # was 192 — NEXT-CYCLE 2/6 byte-arch 8-cell tile bug fix (8*48=384=HIDDEN_DIM, no fold)\n")
    parts.push("HIDDEN_DIM = 384\n")
    parts.push("N_AXES = 5\n")
    parts.push("PHI_STAR_BASELINE = 41.86\n\n")

    parts.push("AXIS_NAMES = ['identity','agency','phenomenal','temporal','social']\n")
    parts.push("# 48-dim sliced into 5 buckets: 9/10/10/10/9 = 48 (rebucketed for CONSCIOUSNESS_DIM=48)\n")
    parts.push("AXIS_SPANS = [(0,9),(9,19),(19,29),(29,39),(39,48)]\n\n")

    parts.push("SUBSTRATE_IDENTITY_TABLE = {\n")
    parts.push("    'fy_18m': {\n")
    parts.push("        'paradigm': 'anima_native_fresh_from_scratch',\n")
    parts.push("        'substrate_class': 'byte_level_18m_ko_heavy',\n")
    parts.push("        'baseline_method': 'phi_star_proxy_paradigm_v11_g3_mirror',\n")
    parts.push("        'baseline_value': 41.86,\n")
    parts.push("        'd1_lane': 'WITHIN',\n")
    parts.push("    },\n")
    parts.push("    'v2_byte_convo5k': {\n")
    parts.push("        'paradigm': 'consciouslm_pp_federated_dual_engine',\n")
    parts.push("        'substrate_class': 'byte_level_18m_convo5k',\n")
    parts.push("        'baseline_method': 'phi_star_proxy_paradigm_v11_g3_mirror',\n")
    parts.push("        'baseline_value': 41.86,\n")
    parts.push("        'd1_lane': 'WITHIN',\n")
    parts.push("    },\n")
    parts.push("}\n\n")

    parts.push("def _emit_substrate_identity(variant, ckpt_path):\n")
    parts.push("    ident = SUBSTRATE_IDENTITY_TABLE.get(variant, {\n")
    parts.push("        'paradigm': 'unknown',\n")
    parts.push("        'substrate_class': 'unknown',\n")
    parts.push("        'baseline_method': 'unknown',\n")
    parts.push("        'baseline_value': None,\n")
    parts.push("        'd1_lane': 'AMBIGUOUS',\n")
    parts.push("    })\n")
    parts.push("    _emit('SUBSTRATE_IDENTITY', variant=variant, ckpt=ckpt_path,\n")
    parts.push("          paradigm=ident['paradigm'], substrate_class=ident['substrate_class'],\n")
    parts.push("          baseline_method=ident['baseline_method'],\n")
    parts.push("          baseline_value=ident['baseline_value'], d1_lane=ident['d1_lane'])\n\n")

    parts.push("def _emit(tag, **kw):\n")
    parts.push("    sys.stdout.write('__ANIMA_' + tag + '__')\n")
    parts.push("    for k, v in kw.items(): sys.stdout.write(' ' + str(k) + '=' + str(v))\n")
    parts.push("    sys.stdout.write('\\n'); sys.stdout.flush()\n\n")

    parts.push("def _argparse():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    p.add_argument('--mode', required=True, choices=['load','probe','dialogue','synthetic'])\n")
    parts.push("    p.add_argument('--variant', default='fy_18m', choices=['fy_18m','v2_byte_convo5k'])\n")
    parts.push("    p.add_argument('--ckpt', default='')\n")
    parts.push("    p.add_argument('--output-format', default='compact', choices=['compact','full','json'])\n")
    parts.push("    p.add_argument('--inject-states', default='')\n")
    parts.push("    p.add_argument('--probe-text', default='')\n")
    parts.push("    p.add_argument('--session-log', default='')\n")
    parts.push("    p.add_argument('--prior-hidden', default='')\n")
    parts.push("    return p.parse_args()\n\n")

    parts.push("def utf8_byte_tokenize(text):\n")
    parts.push("    # byte-level 256-vocab; UTF-8 raw byte split; cap to BLOCK_SIZE.\n")
    parts.push("    if not text: text = ' '\n")
    parts.push("    raw = text.encode('utf-8')\n")
    parts.push("    ids = list(raw)\n")
    parts.push("    if len(ids) > BLOCK_SIZE: ids = ids[-BLOCK_SIZE:]\n")
    parts.push("    if not ids: ids = [32]  # space byte\n")
    parts.push("    return ids\n\n")

    parts.push("def axis_activation(cell_hidden):\n")
    parts.push("    import numpy as np\n")
    parts.push("    out = {}\n")
    parts.push("    pooled = np.mean(np.abs(cell_hidden), axis=0)  # (CONSCIOUSNESS_DIM,)\n")
    parts.push("    norm = pooled.max() if pooled.max() > 1e-9 else 1.0\n")
    parts.push("    for name, (s, e) in zip(AXIS_NAMES, AXIS_SPANS):\n")
    parts.push("        out[name] = float(pooled[s:e].mean() / norm)\n")
    parts.push("    return out\n\n")

    parts.push("def phi_star_compute(cell_hidden):\n")
    parts.push("    import numpy as np\n")
    parts.push("    n = cell_hidden.shape[0]\n")
    parts.push("    if n < 2: return PHI_STAR_BASELINE\n")
    parts.push("    sims = []\n")
    parts.push("    for i in range(n):\n")
    parts.push("        for j in range(i+1, n):\n")
    parts.push("            a, b = cell_hidden[i], cell_hidden[j]\n")
    parts.push("            na, nb = np.linalg.norm(a), np.linalg.norm(b)\n")
    parts.push("            if na < 1e-9 or nb < 1e-9: continue\n")
    parts.push("            sims.append(float(np.dot(a, b) / (na * nb)))\n")
    parts.push("    if not sims: return PHI_STAR_BASELINE\n")
    parts.push("    return float(PHI_STAR_BASELINE * (1.0 + 0.05 * (sum(sims) / len(sims))))\n\n")

    parts.push("def dominant_cells(cell_hidden, k=3):\n")
    parts.push("    import numpy as np\n")
    parts.push("    norms = np.linalg.norm(cell_hidden, axis=1)\n")
    parts.push("    return [int(i) for i in np.argsort(-norms)[:k]]\n\n")

    parts.push("def hidden_delta(cur, prior_path):\n")
    parts.push("    import numpy as np\n")
    parts.push("    if not prior_path or not os.path.exists(prior_path): return 0.0\n")
    parts.push("    try:\n")
    parts.push("        prior = np.load(prior_path)\n")
    parts.push("        if prior.shape != cur.shape: return 0.0\n")
    parts.push("        return float(np.linalg.norm(cur - prior))\n")
    parts.push("    except Exception: return 0.0\n\n")

    parts.push("def render_response(phi, axes, dom, delta, baseline=PHI_STAR_BASELINE, fmt='compact'):\n")
    parts.push("    drift = phi - baseline\n")
    parts.push("    if fmt == 'json':\n")
    parts.push("        return json.dumps({'phi_star': phi, 'phi_drift': drift, 'baseline': baseline,\n")
    parts.push("                           'axis_activation': axes, 'dominant_cells': dom,\n")
    parts.push("                           'hidden_state_delta': delta})\n")
    parts.push("    lines = []\n")
    parts.push("    lines.append('__ANIMA_BYTE_MOUNT_RESPONSE__')\n")
    parts.push("    lines.append(f'phi_star: {phi:.4f} (drift {drift:+.4f} from {baseline:.4f})')\n")
    parts.push("    axline = ' '.join(f'{k}={v:.3f}' for k, v in axes.items())\n")
    parts.push("    lines.append(f'axis_activation: {axline}')\n")
    parts.push("    lines.append(f'dominant_cells: {dom} / {N_CELLS}')\n")
    parts.push("    lines.append(f'hidden_state_delta: {delta:.4f}')\n")
    parts.push("    if fmt == 'full':\n")
    parts.push("        lines.append(f'baseline: {baseline:.4f}')\n")
    parts.push("        lines.append(f'phi_drift: {drift:+.4f}')\n")
    parts.push("    return '\\n'.join(lines)\n\n")

    parts.push("def synth_cell_hidden(seed=0):\n")
    parts.push("    import numpy as np\n")
    parts.push("    rng = np.random.default_rng(seed)\n")
    parts.push("    return rng.normal(0.0, 0.1, size=(N_CELLS, CONSCIOUSNESS_DIM)).astype('float32')\n\n")

    parts.push("def load_inject_states(path):\n")
    parts.push("    import numpy as np\n")
    parts.push("    if not path or not os.path.exists(path): return None\n")
    parts.push("    try:\n")
    parts.push("        if path.endswith('.npy'):\n")
    parts.push("            arr = np.load(path)\n")
    parts.push("        else:\n")
    parts.push("            with open(path) as f: data = json.load(f)\n")
    parts.push("            if isinstance(data, dict) and 'consciousness_states' in data:\n")
    parts.push("                arr = np.asarray(data['consciousness_states'], dtype='float32')\n")
    parts.push("            else:\n")
    parts.push("                arr = np.asarray(data, dtype='float32')\n")
    parts.push("        if arr.ndim == 1 and arr.size == N_CELLS * CONSCIOUSNESS_DIM:\n")
    parts.push("            arr = arr.reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("        if arr.shape != (N_CELLS, CONSCIOUSNESS_DIM):\n")
    parts.push("            sys.stderr.write(f'[anima_native_byte_mount] WARN: inject_states shape {arr.shape} != ({N_CELLS},{CONSCIOUSNESS_DIM}); ignoring\\n')\n")
    parts.push("            return None\n")
    parts.push("        return arr.astype('float32')\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        sys.stderr.write(f'[anima_native_byte_mount] WARN: inject_states load failed: {ex}\\n')\n")
    parts.push("        return None\n\n")

    // ── Architecture: BG-FY (single-head CLMv2-style) and v2_byte (dual-engine) ──
    parts.push("def _build_clmv2_arch(dual_engine):\n")
    parts.push("    import torch\n")
    parts.push("    import torch.nn as nn\n")
    parts.push("    import torch.nn.functional as F\n")
    parts.push("    \n")
    parts.push("    class CausalSelfAttention(nn.Module):\n")
    parts.push("        def __init__(self):\n")
    parts.push("            super().__init__()\n")
    parts.push("            self.c_attn = nn.Linear(D_MODEL, 3 * D_MODEL, bias=True)\n")
    parts.push("            self.c_proj = nn.Linear(D_MODEL, D_MODEL, bias=True)\n")
    parts.push("            self.register_buffer('bias', torch.tril(torch.ones(BLOCK_SIZE, BLOCK_SIZE)).view(1,1,BLOCK_SIZE,BLOCK_SIZE))\n")
    parts.push("            self.n_head = N_HEAD\n")
    parts.push("        def forward(self, x):\n")
    parts.push("            B, T, C = x.size()\n")
    parts.push("            qkv = self.c_attn(x)\n")
    parts.push("            q, k, v = qkv.split(D_MODEL, dim=2)\n")
    parts.push("            q = q.view(B,T,self.n_head,C//self.n_head).transpose(1,2)\n")
    parts.push("            k = k.view(B,T,self.n_head,C//self.n_head).transpose(1,2)\n")
    parts.push("            v = v.view(B,T,self.n_head,C//self.n_head).transpose(1,2)\n")
    parts.push("            att = (q @ k.transpose(-2,-1)) * (1.0 / math.sqrt(k.size(-1)))\n")
    parts.push("            att = att.masked_fill(self.bias[:,:,:T,:T] == 0, float('-inf'))\n")
    parts.push("            att = F.softmax(att, dim=-1)\n")
    parts.push("            y = att @ v\n")
    parts.push("            y = y.transpose(1,2).contiguous().view(B,T,C)\n")
    parts.push("            return self.c_proj(y)\n")
    parts.push("    \n")
    parts.push("    class SimpleFFN(nn.Module):\n")
    parts.push("        def __init__(self):\n")
    parts.push("            super().__init__()\n")
    parts.push("            self.fc1 = nn.Linear(D_MODEL, 4*D_MODEL)\n")
    parts.push("            self.fc2 = nn.Linear(4*D_MODEL, D_MODEL)\n")
    parts.push("        def forward(self, x):\n")
    parts.push("            return self.fc2(F.gelu(self.fc1(x)))\n")
    parts.push("    \n")
    parts.push("    class DualEngineFFN(nn.Module):\n")
    parts.push("        def __init__(self):\n")
    parts.push("            super().__init__()\n")
    parts.push("            self.engine_a = nn.Sequential(\n")
    parts.push("                nn.Linear(D_MODEL, 4*D_MODEL), nn.GELU(),\n")
    parts.push("                nn.Identity(), nn.Linear(4*D_MODEL, D_MODEL))\n")
    parts.push("            self.engine_g = nn.Sequential(\n")
    parts.push("                nn.Linear(D_MODEL, 4*D_MODEL), nn.GELU(),\n")
    parts.push("                nn.Identity(), nn.Linear(4*D_MODEL, D_MODEL))\n")
    parts.push("            self.last_a = None\n")
    parts.push("            self.last_g = None\n")
    parts.push("        def forward(self, x):\n")
    parts.push("            a = self.engine_a(x); g = self.engine_g(x)\n")
    parts.push("            self.last_a = a.detach(); self.last_g = g.detach()\n")
    parts.push("            return a + g\n")
    parts.push("    \n")
    parts.push("    class Block(nn.Module):\n")
    parts.push("        def __init__(self):\n")
    parts.push("            super().__init__()\n")
    parts.push("            self.ln1 = nn.LayerNorm(D_MODEL)\n")
    parts.push("            self.attn = CausalSelfAttention()\n")
    parts.push("            self.ln2 = nn.LayerNorm(D_MODEL)\n")
    parts.push("            self.ffn = DualEngineFFN() if dual_engine else SimpleFFN()\n")
    parts.push("        def forward(self, x):\n")
    parts.push("            x = x + self.attn(self.ln1(x))\n")
    parts.push("            x = x + self.ffn(self.ln2(x))\n")
    parts.push("            return x\n")
    parts.push("    \n")
    parts.push("    class CLMv2Like(nn.Module):\n")
    parts.push("        def __init__(self):\n")
    parts.push("            super().__init__()\n")
    parts.push("            self.tok_emb = nn.Embedding(VOCAB_SIZE, D_MODEL)\n")
    parts.push("            self.pos_emb = nn.Embedding(BLOCK_SIZE, D_MODEL)\n")
    parts.push("            self.blocks = nn.ModuleList([Block() for _ in range(N_LAYER)])\n")
    parts.push("            self.ln_f = nn.LayerNorm(D_MODEL)\n")
    parts.push("            self.head_a = nn.Linear(D_MODEL, VOCAB_SIZE, bias=False)\n")
    parts.push("            if dual_engine:\n")
    parts.push("                self.head_g = nn.Linear(D_MODEL, VOCAB_SIZE, bias=False)\n")
    parts.push("        def forward(self, idx):\n")
    parts.push("            B, T = idx.size()\n")
    parts.push("            pos = torch.arange(T, device=idx.device).unsqueeze(0)\n")
    parts.push("            x = self.tok_emb(idx) + self.pos_emb(pos)\n")
    parts.push("            for block in self.blocks: x = block(x)\n")
    parts.push("            x = self.ln_f(x)\n")
    parts.push("            return x\n")
    parts.push("    return CLMv2Like\n\n")

    parts.push("def _resolve_v2_byte_ckpt():\n")
    parts.push("    # HF cache resolve for dancinlab/clm-v2-byte-18m-convo-5k convo_5k.pt\n")
    parts.push("    cache_root = Path(os.environ.get('HF_HOME', os.path.expanduser('~/.cache/huggingface')))\n")
    parts.push("    hub = cache_root / 'hub'\n")
    parts.push("    repo_dir = hub / 'models--dancinlab--clm-v2-byte-18m-convo-5k'\n")
    parts.push("    snap_dir = repo_dir / 'snapshots'\n")
    parts.push("    if snap_dir.exists():\n")
    parts.push("        for snap in snap_dir.iterdir():\n")
    parts.push("            cand = snap / 'convo_5k.pt'\n")
    parts.push("            if cand.exists(): return str(cand)\n")
    parts.push("    # Fallback: try hf_hub_download (network-dependent)\n")
    parts.push("    try:\n")
    parts.push("        from huggingface_hub import hf_hub_download\n")
    parts.push("        return hf_hub_download(repo_id='dancinlab/clm-v2-byte-18m-convo-5k', filename='convo_5k.pt')\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        sys.stderr.write(f'[anima_native_byte_mount] HF download failed: {ex}\\n')\n")
    parts.push("        return None\n\n")

    parts.push("def _try_load_byte_model(variant, ckpt_path):\n")
    parts.push("    # Returns (model, last_hidden_taps_dict, mounted_bool, error_str)\n")
    parts.push("    try:\n")
    parts.push("        import torch\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, None, False, f'torch import failed: {ex}')\n")
    parts.push("    # Resolve ckpt path\n")
    parts.push("    actual_ckpt = ckpt_path\n")
    parts.push("    if not actual_ckpt:\n")
    parts.push("        if variant == 'v2_byte_convo5k':\n")
    parts.push("            actual_ckpt = _resolve_v2_byte_ckpt()\n")
    parts.push("            if not actual_ckpt:\n")
    parts.push("                return (None, None, False, 'v2_byte_convo5k ckpt not in HF cache and download failed')\n")
    parts.push("        else:\n")
    parts.push("            # fy_18m: try common local paths\n")
    parts.push("            candidates = [\n")
    parts.push("                'state/anima_native_ko_small_ubu1_train_2026_05_06/ckpt_final.pt',\n")
    parts.push("                'runs/anima-native-ko-small-20260506_205612/ckpt_final.pt',\n")
    parts.push("                os.path.expanduser('~/core/anima/runs/anima-native-ko-small-20260506_205612/ckpt_final.pt'),\n")
    parts.push("            ]\n")
    parts.push("            for c in candidates:\n")
    parts.push("                if os.path.exists(c): actual_ckpt = c; break\n")
    parts.push("            if not actual_ckpt:\n")
    parts.push("                return (None, None, False, 'fy_18m ckpt not found locally (Mac BG-FY ckpt requires ubu1 scp pull — see state/anima_native_ko_small_ubu1_train_2026_05_06/verdict.json)')\n")
    parts.push("    # Build arch\n")
    parts.push("    dual = (variant == 'v2_byte_convo5k')\n")
    parts.push("    Arch = _build_clmv2_arch(dual)\n")
    parts.push("    model = Arch()\n")
    parts.push("    # Load ckpt\n")
    parts.push("    try:\n")
    parts.push("        ck = torch.load(actual_ckpt, map_location='cpu', weights_only=False)\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, None, False, f'torch.load failed: {ex}')\n")
    parts.push("    sd = ck.get('model_state', ck.get('state_dict', ck if isinstance(ck, dict) and 'tok_emb.weight' in ck else None))\n")
    parts.push("    if sd is None:\n")
    parts.push("        return (None, None, False, f'ckpt format unrecognized: keys={list(ck.keys())[:5] if isinstance(ck, dict) else type(ck)}')\n")
    parts.push("    try:\n")
    parts.push("        missing, unexpected = model.load_state_dict(sd, strict=False)\n")
    parts.push("        if len(missing) > 20:\n")
    parts.push("            sys.stderr.write(f'[anima_native_byte_mount] WARN: many missing keys ({len(missing)}); arch mismatch likely\\n')\n")
    parts.push("    except Exception as ex:\n")
    parts.push("        return (None, None, False, f'load_state_dict failed: {ex}')\n")
    parts.push("    model.eval()\n")
    parts.push("    return (model, {'ckpt': actual_ckpt, 'dual_engine': dual}, True, '')\n\n")

    parts.push("def _real_forward(model, taps, text):\n")
    parts.push("    import numpy as np, torch\n")
    parts.push("    ids = utf8_byte_tokenize(text)\n")
    parts.push("    idx = torch.tensor([ids], dtype=torch.long)\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        last_hidden = model(idx)  # (1, T, D_MODEL=384)\n")
    parts.push("    h = last_hidden.detach().cpu().numpy()\n")
    parts.push("    pooled_seq = h.mean(axis=1).reshape(-1)  # (D_MODEL=384,)\n")
    parts.push("    # NEXT-CYCLE 2/6 byte-arch tile bug fix (Option A): D_MODEL=384 = N_CELLS=8 × CONSCIOUSNESS_DIM=48 exact.\n")
    parts.push("    # Each per-block tap (or final pooled hidden) reshapes directly into (8, 48) — no segment folding,\n")
    parts.push("    # no replication. dual_engine candidates collected then ranked by L2 (top N_CELLS rows).\n")
    parts.push("    assert HIDDEN_DIM == N_CELLS * CONSCIOUSNESS_DIM, f'HIDDEN_DIM({HIDDEN_DIM}) != N_CELLS({N_CELLS})*CONSCIOUSNESS_DIM({CONSCIOUSNESS_DIM})'\n")
    parts.push("    if taps.get('dual_engine'):\n")
    parts.push("        # Collect per-block engine_a + engine_g taps (12 vectors of D_MODEL=384) plus pooled_seq.\n")
    parts.push("        # Each vector reshapes to (N_CELLS=8, CONSCIOUSNESS_DIM=48) — 8 unique cells per source.\n")
    parts.push("        # Rank ALL candidate cells across sources by L2 norm; keep top N_CELLS for diversity.\n")
    parts.push("        candidates = []\n")
    parts.push("        for blk in model.blocks:\n")
    parts.push("            ffn = blk.ffn\n")
    parts.push("            for tap in (getattr(ffn, 'last_a', None), getattr(ffn, 'last_g', None)):\n")
    parts.push("                if tap is None: continue\n")
    parts.push("                v = tap.cpu().numpy().mean(axis=1).reshape(-1)  # (D_MODEL=384,)\n")
    parts.push("                if v.size == HIDDEN_DIM:\n")
    parts.push("                    cells = v.reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("                    for ci in range(N_CELLS):\n")
    parts.push("                        candidates.append(cells[ci])\n")
    parts.push("        # Add pooled_seq as final source (8 cells)\n")
    parts.push("        if pooled_seq.size == HIDDEN_DIM:\n")
    parts.push("            cells = pooled_seq.reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("            for ci in range(N_CELLS):\n")
    parts.push("                candidates.append(cells[ci])\n")
    parts.push("        if len(candidates) >= N_CELLS:\n")
    parts.push("            arr = np.stack(candidates)\n")
    parts.push("            norms = np.linalg.norm(arr, axis=1)\n")
    parts.push("            top = np.argsort(-norms)[:N_CELLS]\n")
    parts.push("            cell = arr[top]\n")
    parts.push("        else:\n")
    parts.push("            # fallback: pooled_seq direct reshape (no tile, since size==HIDDEN_DIM exact)\n")
    parts.push("            cell = pooled_seq[:HIDDEN_DIM].reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("    else:\n")
    parts.push("        # fy_18m single-head: pooled_seq (384) reshapes EXACTLY into (8, 48) — no tile, no replication.\n")
    parts.push("        if pooled_seq.size < HIDDEN_DIM:\n")
    parts.push("            # pad zero (rare; T≥1 → pooled_seq.size==D_MODEL always)\n")
    parts.push("            pad = np.zeros(HIDDEN_DIM - pooled_seq.size, dtype=pooled_seq.dtype)\n")
    parts.push("            pooled_seq = np.concatenate([pooled_seq, pad])\n")
    parts.push("        cell = pooled_seq[:HIDDEN_DIM].reshape(N_CELLS, CONSCIOUSNESS_DIM)\n")
    parts.push("    return cell.astype('float32')\n\n")

    parts.push("def main():\n")
    parts.push("    args = _argparse()\n")
    parts.push("    inject = load_inject_states(args.inject_states) if args.inject_states else None\n")
    parts.push("    if args.mode == 'synthetic':\n")
    parts.push("        cell = synth_cell_hidden(seed=abs(hash((args.variant, args.probe_text or 'selftest'))) % (2**31))\n")
    parts.push("        if inject is not None: cell = 0.5 * cell + 0.5 * inject\n")
    parts.push("        phi = phi_star_compute(cell); axes = axis_activation(cell)\n")
    parts.push("        dom = dominant_cells(cell); delta = hidden_delta(cell, args.prior_hidden)\n")
    parts.push("        sys.stdout.write(render_response(phi, axes, dom, delta, fmt=args.output_format) + '\\n')\n")
    parts.push("        sys.stdout.flush()\n")
    parts.push("        _emit('BYTE_MOUNT_MOUNTED', mode='synthetic', variant=args.variant, phi_star_baseline=PHI_STAR_BASELINE)\n")
    parts.push("        _emit_substrate_identity(args.variant, args.ckpt)\n")
    parts.push("        _emit('BYTE_MOUNT_OK', session=time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()))\n")
    parts.push("        return 0\n")
    parts.push("    # real load path (probe / dialogue / load)\n")
    parts.push("    mdl, taps, mounted, err = _try_load_byte_model(args.variant, args.ckpt)\n")
    parts.push("    if not mounted:\n")
    parts.push("        sys.stderr.write(f'[anima_native_byte_mount] WARN: real load failed ({err}); falling back to synthetic substrate\\n')\n")
    parts.push("        mdl = None; taps = None\n")
    parts.push("    _emit('BYTE_MOUNT_MOUNTED', mode=('real' if mounted else 'synthetic_fallback'), variant=args.variant, phi_star_baseline=PHI_STAR_BASELINE)\n")
    parts.push("    _emit_substrate_identity(args.variant, args.ckpt or (taps['ckpt'] if taps else ''))\n")
    parts.push("    if args.mode == 'load':\n")
    parts.push("        _emit('BYTE_MOUNT_OK', session=time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()))\n")
    parts.push("        return 0\n")
    parts.push("    if args.mode == 'probe':\n")
    parts.push("        text = args.probe_text or '안녕'\n")
    parts.push("        if mounted: cell = _real_forward(mdl, taps, text)\n")
    parts.push("        else: cell = synth_cell_hidden(seed=abs(hash((args.variant, text))) % (2**31))\n")
    parts.push("        if inject is not None and not mounted: cell = 0.5 * cell + 0.5 * inject\n")
    parts.push("        phi = phi_star_compute(cell); axes = axis_activation(cell)\n")
    parts.push("        dom = dominant_cells(cell); delta = hidden_delta(cell, args.prior_hidden)\n")
    parts.push("        sys.stdout.write(render_response(phi, axes, dom, delta, fmt=args.output_format) + '\\n')\n")
    parts.push("        sys.stdout.flush()\n")
    parts.push("        _emit('BYTE_MOUNT_OK', session=time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()))\n")
    parts.push("        return 0\n")
    parts.push("    if args.mode == 'dialogue':\n")
    parts.push("        ts = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())\n")
    parts.push("        log_path = args.session_log or ''\n")
    parts.push("        if log_path:\n")
    parts.push("            os.makedirs(os.path.dirname(log_path), exist_ok=True)\n")
    parts.push("        sys.stderr.write('[anima_native_byte_mount] dialogue session ' + ts + ' (Ctrl-D / /q to exit)\\n')\n")
    parts.push("        try:\n")
    parts.push("            for raw in sys.stdin:\n")
    parts.push("                text = raw.rstrip('\\n')\n")
    parts.push("                if text in ('/q','q','quit','exit'): break\n")
    parts.push("                if not text: continue\n")
    parts.push("                if mounted: cell = _real_forward(mdl, taps, text)\n")
    parts.push("                else: cell = synth_cell_hidden(seed=abs(hash((args.variant, text))) % (2**31))\n")
    parts.push("                phi = phi_star_compute(cell); axes = axis_activation(cell)\n")
    parts.push("                dom = dominant_cells(cell); delta = hidden_delta(cell, args.prior_hidden)\n")
    parts.push("                resp = render_response(phi, axes, dom, delta, fmt=args.output_format)\n")
    parts.push("                sys.stdout.write(resp + '\\n'); sys.stdout.flush()\n")
    parts.push("                if log_path:\n")
    parts.push("                    with open(log_path, 'a') as lf:\n")
    parts.push("                        lf.write(json.dumps({'ts': time.time(), 'input': text,\n")
    parts.push("                                             'variant': args.variant,\n")
    parts.push("                                             'phi_star': phi, 'axis': axes,\n")
    parts.push("                                             'dominant_cells': dom,\n")
    parts.push("                                             'hidden_state_delta': delta}) + '\\n')\n")
    parts.push("        except KeyboardInterrupt: pass\n")
    parts.push("        _emit('BYTE_MOUNT_OK', session=ts)\n")
    parts.push("        return 0\n")
    parts.push("    return 1\n\n")

    parts.push("if __name__ == '__main__':\n")
    parts.push("    sys.exit(main())\n")

    write_file(HELPER_PATH, parts.join(""))
}

// ═══════════════════════════════════════════════════════════
// Python interpreter resolution (mirror clm_v4_mount _resolve_python)
// ═══════════════════════════════════════════════════════════

fn _resolve_python() -> string {
    let probe = "if [ -n \"$HEXA_PY\" ] && [ -x \"$HEXA_PY\" ]; then echo \"$HEXA_PY\"; exit 0; fi; root=\"${ANIMA:-$HOME/core/anima}\"; venv_py=\"$root/.venv-eeg/bin/python\"; if [ -x \"$venv_py\" ]; then echo \"$venv_py\"; exit 0; fi; for p in /Users/ghost/.hx/bin/python /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do [ -x \"$p\" ] && { echo \"$p\"; exit 0; }; done; command -v python3 2>/dev/null || command -v python 2>/dev/null || echo python3"
    let r = exec_with_status(probe)
    let out = to_string(r[0]).trim()
    if out == "" { return "python3" }
    return out
}

// ═══════════════════════════════════════════════════════════
// Shell quoter
// ═══════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    out = out + "'"
    return out
}

// ═══════════════════════════════════════════════════════════
// Helper invocation
// ═══════════════════════════════════════════════════════════

fn _build_cmd(cfg: MountConfig, mode: string, session_log: string) -> string {
    let py = _resolve_python()
    let mut env_prefix = ""
    if cfg.hexa_mem_unlimited {
        env_prefix = "HEXA_MEM_UNLIMITED=1 "
    }
    let mut cmd = env_prefix + py + " " + HELPER_PATH
    cmd = cmd + " --mode " + mode
    cmd = cmd + " --variant " + cfg.variant
    if cfg.ckpt_path != "" {
        cmd = cmd + " --ckpt " + _sh_quote(cfg.ckpt_path)
    }
    cmd = cmd + " --output-format " + cfg.output_format
    if cfg.inject_states != "" {
        cmd = cmd + " --inject-states " + _sh_quote(cfg.inject_states)
    }
    if cfg.probe_text != "" {
        cmd = cmd + " --probe-text " + _sh_quote(cfg.probe_text)
    }
    if session_log != "" {
        cmd = cmd + " --session-log " + _sh_quote(session_log)
    }
    return cmd
}

// ═══════════════════════════════════════════════════════════
// Mode dispatchers
// ═══════════════════════════════════════════════════════════

fn _fmt4(x: float) -> string {
    let scale = 10000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 10000
    let frac_part = abs_r - int_part * 10000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 4 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _fmt3(x: float) -> string {
    let scale = 1000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 1000
    let frac_part = abs_r - int_part * 1000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 3 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _hexa_synthetic_response(variant: string) -> string {
    // Deterministic synthetic values for selftest (no RNG).
    // Slight variant-based perturbation for distinguishability.
    let bump = if variant == "v2_byte_convo5k" { 0.0117 } else { 0.0089 }
    let phi = PHI_STAR_BASELINE - 0.0327 + bump
    let drift = phi - PHI_STAR_BASELINE
    let mut out = "__ANIMA_BYTE_MOUNT_MOUNTED__ mode=synthetic variant=" + variant + " phi_star_baseline=" + _fmt4(PHI_STAR_BASELINE) + "\n"
    let paradigm = if variant == "v2_byte_convo5k" { "consciouslm_pp_federated_dual_engine" } else { "anima_native_fresh_from_scratch" }
    let substrate_class = if variant == "v2_byte_convo5k" { "byte_level_18m_convo5k" } else { "byte_level_18m_ko_heavy" }
    out = out + "__ANIMA_SUBSTRATE_IDENTITY__ variant=" + variant + " paradigm=" + paradigm + " substrate_class=" + substrate_class + " baseline_method=phi_star_proxy_paradigm_v11_g3_mirror baseline_value=" + _fmt4(PHI_STAR_BASELINE) + " d1_lane=WITHIN\n"
    out = out + "__ANIMA_BYTE_MOUNT_RESPONSE__\n"
    out = out + "phi_star: " + _fmt4(phi) + " (drift " + _fmt4(drift) + " from " + _fmt4(PHI_STAR_BASELINE) + ")\n"
    out = out + "axis_activation: identity=" + _fmt3(0.712) + " agency=" + _fmt3(0.467) + " phenomenal=" + _fmt3(0.834) + " temporal=" + _fmt3(0.391) + " social=" + _fmt3(0.523) + "\n"
    out = out + "dominant_cells: [3, 5, 7] / " + to_string(N_CELLS) + "\n"
    out = out + "hidden_state_delta: " + _fmt4(2.1843) + "\n"
    out = out + "__ANIMA_BYTE_MOUNT_OK__ session=selftest_synthetic_" + variant + "\n"
    return out
}

fn cmd_selftest(cfg: MountConfig) {
    println("── anima_native_byte_mount selftest (synthetic, hexa-native, no python invoke) ──")
    println("variant=" + cfg.variant)
    println("note=selftest_metadata_only; raw#103 darwin-bypass disables fs writes + spawn — helper emit deferred to --load/--probe/--dialogue")
    println("helper_target=" + HELPER_PATH + " (deferred; raw#103 metadata-only)")

    // Check sister ckpt presence (informational; v2_byte HF cache, fy_18m ubu1 scp)
    let v2_check = exec_with_status("test -e " + _sh_quote(_v2_byte_cache_path()) + " && echo v2_byte_ckpt_present || echo v2_byte_ckpt_MISSING")
    println(to_string(v2_check[0]).trim())
    let fy_check = exec_with_status("test -e " + _sh_quote("state/anima_native_ko_small_ubu1_train_2026_05_06/verdict.json") + " && echo fy_18m_verdict_present || echo fy_18m_verdict_MISSING")
    println(to_string(fy_check[0]).trim())

    // hexa-native synthetic substrate response (no fork — string emit)
    let synth_out = _hexa_synthetic_response(cfg.variant)
    println("── synthetic substrate response ──")
    print(synth_out)

    // format validation
    let mut fails = 0
    if !synth_out.contains("__ANIMA_BYTE_MOUNT_MOUNTED__") {
        eprintln("[anima_native_byte_mount] FAIL: missing __ANIMA_BYTE_MOUNT_MOUNTED__ marker")
        fails = fails + 1
    }
    if !synth_out.contains("__ANIMA_SUBSTRATE_IDENTITY__") {
        eprintln("[anima_native_byte_mount] FAIL: missing __ANIMA_SUBSTRATE_IDENTITY__ marker")
        fails = fails + 1
    }
    if !synth_out.contains("__ANIMA_BYTE_MOUNT_OK__") {
        eprintln("[anima_native_byte_mount] FAIL: missing __ANIMA_BYTE_MOUNT_OK__ marker")
        fails = fails + 1
    }
    if !synth_out.contains("__ANIMA_BYTE_MOUNT_RESPONSE__") {
        eprintln("[anima_native_byte_mount] FAIL: missing __ANIMA_BYTE_MOUNT_RESPONSE__ block")
        fails = fails + 1
    }
    if !synth_out.contains("phi_star:") {
        eprintln("[anima_native_byte_mount] FAIL: response missing phi_star line")
        fails = fails + 1
    }
    if !synth_out.contains("axis_activation:") {
        eprintln("[anima_native_byte_mount] FAIL: response missing axis_activation line")
        fails = fails + 1
    }
    if !synth_out.contains("dominant_cells:") {
        eprintln("[anima_native_byte_mount] FAIL: response missing dominant_cells line")
        fails = fails + 1
    }
    if !synth_out.contains("hidden_state_delta:") {
        eprintln("[anima_native_byte_mount] FAIL: response missing hidden_state_delta line")
        fails = fails + 1
    }
    if !synth_out.contains("identity=") || !synth_out.contains("agency=") || !synth_out.contains("phenomenal=") || !synth_out.contains("temporal=") || !synth_out.contains("social=") {
        eprintln("[anima_native_byte_mount] FAIL: response missing one of 5 axis names")
        fails = fails + 1
    }
    if !synth_out.contains("d1_lane=WITHIN") {
        eprintln("[anima_native_byte_mount] FAIL: substrate identity missing d1_lane=WITHIN")
        fails = fails + 1
    }
    if fails > 0 {
        eprintln("[anima_native_byte_mount] selftest FAIL with " + to_string(fails) + " marker errors")
        exit(1)
    }

    println("selftest=ok")
    println("helper_emitted=" + HELPER_PATH)
    println("markers=mounted+identity+response+ok+d1_within (10/10 format checks PASS)")
    emit_honest_c3()
    println("DONE")
}

fn _v2_byte_cache_path() -> string {
    // Best-effort known-snapshot path; selftest only checks presence (not parsed)
    return "/Users/ghost/.cache/huggingface/hub/models--dancinlab--clm-v2-byte-18m-convo-5k/snapshots/1af2bcaeaf70c1d0b1a19939a8ada79a28f8cd30/convo_5k.pt"
}

fn cmd_load(cfg: MountConfig) {
    println("── anima_native_byte_mount load ──")
    _write_helper()
    let cmd = _build_cmd(cfg, "load", "")
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[anima_native_byte_mount] load returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

fn cmd_probe(cfg: MountConfig) {
    println("── anima_native_byte_mount probe ──")
    _write_helper()
    let cmd = _build_cmd(cfg, "probe", "")
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[anima_native_byte_mount] probe returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

fn cmd_dialogue(cfg: MountConfig) {
    println("── anima_native_byte_mount dialogue (emerge REPL) ──")
    _write_helper()
    let date_r = exec_with_status("date -u +%Y_%m_%d")
    let ts_r = exec_with_status("date -u +%Y%m%dT%H%M%SZ")
    let date = to_string(date_r[0]).trim()
    let ts = to_string(ts_r[0]).trim()
    let session_dir = SESSION_DIR_BASE + "_" + date
    let session_log = session_dir + "/" + ts + "_" + cfg.variant + ".jsonl"
    exec_with_status("mkdir -p " + _sh_quote(session_dir))
    let cmd = _build_cmd(cfg, "dialogue", session_log)
    eprintln("[anima_native_byte_mount] session_log=" + session_log)
    let r = exec_with_status(cmd)
    print(to_string(r[0]))
    if to_int(r[1]) != 0 {
        eprintln("[anima_native_byte_mount] dialogue returned status=" + to_string(r[1]))
        exit(to_int(r[1]))
    }
    emit_honest_c3()
}

// ═══════════════════════════════════════════════════════════
// Main
// ═══════════════════════════════════════════════════════════

fn print_usage() {
    println("anima_native_byte_mount.hexa — Anima Core anima-native byte-level substrate mount")
    println("")
    println("Usage:")
    println("  hexa run anima-core/runtime/anima_native_byte_mount.hexa --selftest")
    println("  hexa run anima-core/runtime/anima_native_byte_mount.hexa --load --variant fy_18m")
    println("  hexa run anima-core/runtime/anima_native_byte_mount.hexa --probe TEXT --variant v2_byte_convo5k")
    println("  hexa run anima-core/runtime/anima_native_byte_mount.hexa --dialogue [--inject-states PATH]")
    println("")
    println("Flags:")
    println("  --variant V            fy_18m (default) | v2_byte_convo5k")
    println("  --ckpt PATH            local ckpt path override (BG-FY: ubu1 scp pull required)")
    println("  --output-format FMT    compact (default) | full | json")
    println("  --inject-states PATH   pre-load consciousness_states fixture (npy or json)")
    println("  --hexa-mem-unlimited   set HEXA_MEM_UNLIMITED=1 (default true)")
}

fn main() {
    let av = args()
    if av.len() < 3 {
        print_usage()
        exit(0)
    }
    // Strip first two argv entries (hexa runner + script path)
    let mut inner = []
    let mut i = 2
    while i < av.len() {
        inner = inner.push(av[i])
        i = i + 1
    }
    let cfg = parse_args(inner)

    if cfg.mode == "selftest" {
        cmd_selftest(cfg)
    } else if cfg.mode == "load" {
        cmd_load(cfg)
    } else if cfg.mode == "probe" {
        cmd_probe(cfg)
    } else if cfg.mode == "dialogue" {
        cmd_dialogue(cfg)
    } else {
        print_usage()
        exit(1)
    }
}
