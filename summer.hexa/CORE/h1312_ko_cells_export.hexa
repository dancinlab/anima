// h1312_ko_cells_export.hexa — SERIALIZE the H_1306 grown Korean cells to a small
// committed artifact (CORE/ko_cells.kohead) so the live decode can CONSULT them at
// the generator L3 slot (a_verified_must_wire follow-on for H_1306).
//
// This is NOT a new learning rung. It re-runs the EXACT H_1306 engine-native grow
// (CORE/engine_cli.hexa VAdaptField Voronoi + engine_mitosis_tick, gradient-free p8)
// on the SAME R2 Korean corpus slice (/tmp/h1306_*, sha256 in h1306_manifest.json),
// then writes the grown field's PROTOTYPE CENTERS + each cell's LEARNED argmax
// next-byte (the per-cell next-byte MLE head's top byte, add-1 Laplace) so the
// generator can map a Korean context → nearest Korean cell → its learned next byte.
//
// ARTIFACT FORMAT (CORE/ko_cells.kohead, deterministic ASCII):
//   line 1:   <n_cells> <dim>
//   line i+1: <c0> <c1> <c2> <top_byte>     (cell i: dim-vector center + argmax byte)
//
// The 3-D context feature (identical to H_1306 / H_1297, mechanical byte fn, NO
// labels, p1·p2·p3): [last/255, 2nd-last/255, utf8_cont_depth/3]. The consult side
// (generator.hexa::ko_cells_*) recomputes the SAME feature from live decode bytes
// and only fires when the context is Korean-like (utf8_cont_depth > 0) — so English
// / ASCII context is INERT (byte-identical, no regression).
//
// Ψ-disjoint: reads VAdaptField ownership + grows a cell population; pure_field is
// never touched (a_core_engine_map). $0 CPU, no GPU, no secrets at run.

import "CORE/engine_cli.hexa"

fn _V() -> int             { return 256 }
fn _FEAT_DIM() -> int      { return 3 }
fn _GROW_MAX() -> int      { return 40 }
fn _SPLIT_THRESH_CE() -> float { return 0.05 }
fn _MIN_OWNED() -> int     { return 8 }
fn _LAPLACE() -> float     { return 1.0 }

fn _load_feats(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_ints(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [to_int(lines[i].trim())]  i = i + 1 }
    return out
}
fn _load_floats_line(path: string) -> [float] {
    let txt = read_file(path)
    let cols = txt.trim().split(" ")
    let mut out = []
    let mut i = 0
    while i < len(cols) { out = out + [to_float(cols[i].trim())]  i = i + 1 }
    return out
}

fn _assign_all(af: VAdaptField, X: [[float]]) -> [int] {
    let mut owner = []
    let mut i = 0
    while i < len(X) { owner = owner + [vadapt_field_nearest_idx(af, X[i])]  i = i + 1 }
    return owner
}
fn _head_counts(Y: [int], owner: [int], k: int, ntr: int, V: int, laplace: float) -> [float] {
    let mut counts = []
    let mut v = 0
    while v < V { counts = counts + [laplace]  v = v + 1 }
    let mut total = laplace * to_float(V)
    let mut i = 0
    while i < ntr {
        if owner[i] == k { counts[Y[i]] = counts[Y[i]] + 1.0  total = total + 1.0 }
        i = i + 1
    }
    let mut p = []
    let mut w = 0
    while w < V { p = p + [counts[w] / total]  w = w + 1 }
    return p
}
fn _owned_ce(Y: [int], owner: [int], k: int, ntr: int, p: [float]) -> float {
    let mut s = 0.0  let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k { s = s - ln(p[Y[i]] + 0.000000000001)  n = n + 1 }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}
fn _owned_count(owner: [int], k: int, ntr: int) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr { if owner[i] == k { n = n + 1 }  i = i + 1 }
    return n
}
fn _hi_var_axis(X: [[float]], owner: [int], k: int, ntr: int, dim: int) -> int {
    let mut sum = []  let mut sq = []  let mut d = 0
    while d < dim { sum = sum + [0.0]  sq = sq + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let mut a = 0
            while a < dim { sum[a] = sum[a] + X[i][a]  sq[a] = sq[a] + X[i][a] * X[i][a]  a = a + 1 }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0 }
    let fn2 = to_float(n)
    let mut best = 0  let mut bestv = -1.0  let mut a2 = 0
    while a2 < dim {
        let mean = sum[a2] / fn2
        let var = sq[a2] / fn2 - mean * mean
        if var > bestv { bestv = var  best = a2 }
        a2 = a2 + 1
    }
    return best
}
fn _owned_median(X: [[float]], owner: [int], k: int, ntr: int, ax: int) -> float {
    let mut vals = []  let mut i = 0
    while i < ntr { if owner[i] == k { vals = vals + [X[i][ax]] }  i = i + 1 }
    let n = len(vals)
    if n == 0 { return 0.0 }
    let mut a = 1
    while a < n {
        let key = vals[a]  let mut b = a - 1
        while b >= 0 && vals[b] > key { vals[b + 1] = vals[b]  b = b - 1 }
        vals[b + 1] = key  a = a + 1
    }
    if n % 2 == 1 { return vals[n / 2] }
    return (vals[n / 2 - 1] + vals[n / 2]) / 2.0
}
fn _half_centroid(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool, dim: int) -> [float] {
    let mut acc = []  let mut d = 0
    while d < dim { acc = acc + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take {
                let mut a = 0
                while a < dim { acc[a] = acc[a] + X[i][a]  a = a + 1 }
                n = n + 1
            }
        }
        i = i + 1
    }
    if n == 0 { return acc }
    let mut out = []  let mut a2 = 0
    while a2 < dim { out = out + [acc[a2] / to_float(n)]  a2 = a2 + 1 }
    return out
}
fn _half_count(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take { n = n + 1 }
        }
        i = i + 1
    }
    return n
}
fn _field_from(centers: [[float]], max_cells: int) -> VAdaptField {
    return VAdaptField { protos: centers, n_cells: len(centers), max_cells: max_cells, dim: len(centers[0]) }
}

// GROW on the first `ntr` KO train points (error-TARGETED mitosis) — BYTE-IDENTICAL
// to h1306_ko_mitosis_engine_probe.hexa::_grow_on.
fn _grow_on(centers0: [[float]], af0: VAdaptField, Xtr: [[float]], Ytr: [int], ntr: int,
            dim: int, V: int, cfg: EngineConfig) -> [[float]] {
    let mut centers = centers0
    let mut af = af0
    while len(centers) < _GROW_MAX() {
        let owner = _assign_all(af, Xtr)
        let nc = len(centers)
        let mut local_ce = []  let mut owned_n = []  let mut k = 0
        while k < nc {
            let cnt = _owned_count(owner, k, ntr)
            owned_n = owned_n + [cnt]
            if cnt > 0 {
                let p = _head_counts(Ytr, owner, k, ntr, V, _LAPLACE())
                local_ce = local_ce + [_owned_ce(Ytr, owner, k, ntr, p)]
            } else { local_ce = local_ce + [-1.0] }
            k = k + 1
        }
        let mut elig = []  let mut k2 = 0
        while k2 < nc {
            if owned_n[k2] >= _MIN_OWNED() && local_ce[k2] > _SPLIT_THRESH_CE() { elig = elig + [k2] }
            k2 = k2 + 1
        }
        if len(elig) == 0 { break }
        let mut pick = elig[0]
        let mut bestce = local_ce[elig[0]]
        let mut ei = 1
        while ei < len(elig) {
            if local_ce[elig[ei]] > bestce { bestce = local_ce[elig[ei]]  pick = elig[ei] }
            ei = ei + 1
        }
        let grown = engine_mitosis_tick(len(centers), cfg)
        if grown <= len(centers) { break }
        let ax = _hi_var_axis(Xtr, owner, pick, ntr, dim)
        let med = _owned_median(Xtr, owner, pick, ntr, ax)
        let nlo = _half_count(Xtr, owner, pick, ntr, ax, med, true)
        let nhi = _half_count(Xtr, owner, pick, ntr, ax, med, false)
        if nlo == 0 || nhi == 0 { break }
        let c_lo = _half_centroid(Xtr, owner, pick, ntr, ax, med, true, dim)
        let c_hi = _half_centroid(Xtr, owner, pick, ntr, ax, med, false, dim)
        let mut new_centers = []  let mut ci = 0
        while ci < len(centers) {
            if ci != pick { new_centers = new_centers + [centers[ci]] }
            ci = ci + 1
        }
        new_centers = new_centers + [c_lo, c_hi]
        centers = new_centers
        af = _field_from(centers, _GROW_MAX())
    }
    return centers
}

// per-cell argmax next-byte (the cell's learned top byte over OWNED train points).
fn _cell_top_byte(Ytr: [int], owner: [int], k: int, ntr: int, V: int) -> int {
    let p = _head_counts(Ytr, owner, k, ntr, V, _LAPLACE())
    let mut bi = 0  let mut bv = p[0]  let mut v = 1
    while v < V { if p[v] > bv { bv = p[v]  bi = v }  v = v + 1 }
    return bi
}

fn main() {
    println("=== H_1312 — EXPORT the H_1306 grown Korean cells (engine-native) -> CORE/ko_cells.kohead ===")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let dim = _FEAT_DIM()
    let V = _V()
    let Xtr = _load_feats("/tmp/h1306_ko_train.feats", dim)
    let Ytr = _load_ints("/tmp/h1306_ko_train.next")
    let chunks = _load_floats_line("/tmp/h1306_chunks.txt")
    if len(Xtr) == 0 || len(chunks) == 0 {
        println("ERROR: missing /tmp/h1306_* — run UNIVERSE/h1306_fetch_corpus.sh then h1306_ko_corpus_export.py first.")
        exit(1)
    }
    let nb1 = to_int(chunks[0])
    let nb2 = to_int(chunks[1])
    let nb3 = to_int(chunks[2])
    // REPRODUCE the H_1306 incremental grow EXACTLY (seed 2-cell -> chunk1 -> +2 -> +3).
    let mut centers = [[0.3, 0.5, 0.0], [0.7, 0.5, 0.5]]
    let af_seed = _field_from(centers, _GROW_MAX())
    let c1 = _grow_on(centers, af_seed, Xtr, Ytr, nb1, dim, V, cfg)
    let af1 = _field_from(c1, _GROW_MAX())
    let c2 = _grow_on(c1, af1, Xtr, Ytr, nb2, dim, V, cfg)
    let af2 = _field_from(c2, _GROW_MAX())
    let c3 = _grow_on(c2, af2, Xtr, Ytr, nb3, dim, V, cfg)
    let af3 = _field_from(c3, _GROW_MAX())
    // heads built over the FULL KO train (nb3), same as the H_1306 pt3 scoring.
    let owner = _assign_all(af3, Xtr)
    let nc = len(c3)
    println("grown Korean cells: " + to_string(nc) + " (seed 2 -> mitosis added " + to_string(nc - 2) + ")")
    // serialize: line1 = n_cells dim ; then per cell: c0 c1 c2 top_byte
    let mut s = to_string(nc) + " " + to_string(dim) + "\n"
    let mut k = 0
    while k < nc {
        let tb = _cell_top_byte(Ytr, owner, k, nb3, V)
        let mut line = ""
        let mut a = 0
        while a < dim { line = line + to_string(c3[k][a]) + " "  a = a + 1 }
        line = line + to_string(tb)
        s = s + line + "\n"
        println("  cell " + to_string(k) + ": center=[" + to_string(c3[k][0]) + "," + to_string(c3[k][1]) + "," + to_string(c3[k][2]) + "] top_byte=" + to_string(tb))
        k = k + 1
    }
    write_file("CORE/ko_cells.kohead", s)
    println("wrote CORE/ko_cells.kohead (" + to_string(nc) + " cells, dim=" + to_string(dim) + ")")
    println("[done]")
}
