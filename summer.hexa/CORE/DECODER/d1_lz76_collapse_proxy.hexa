// ════════════════════════════════════════════════════════════════════════════
//  CORE/DECODER/d1_lz76_collapse_proxy.hexa
//
//   D1 — decoder-lz76-collapse-proxy
//   Does LZ76 (Lempel-Ziv 1976) complexity distinguish a COLLAPSED token
//   sequence (repetition-saturated) from a HEALTHY diverse one — i.e. can LZ
//   detect register-collapse WITHOUT detokenize (cheap, $0 proxy)?
//
//   CONTEXT
//     ANIMA DECODER (L3 MoE content generator) core difficulty = register
//     collapse <-> underfit double-bind. M4b fire (PR #1121, phase5b train.out)
//     showed the collapse signal as a SAMPLED token sequence:
//        DECODED_IDS: 1 1 1 1 151642 ×16    (TTR=0.1, unique=2/20)
//        (token 151642 = Qwen <|endoftext|>-class; expert e1 logit saturated.)
//     Current collapse detection is QUALITATIVE (no detokenize). UNIVERSE H_288
//     (origin/main, 🟢 SUPPORTED Pearson r=0.831 ρ=0.936) showed LZ76 complexity
//     tracks faithful big-Φ. DECODER.md names LZ as the 1st collapse-detect proxy
//     candidate (repetition-reduction-rate, cheap, $0). D1 verifies that proxy.
//
//   HYPOTHESIS (H_D1)
//     LZ76 complexity (and the normalised LZ rate LZ76/n) of a COLLAPSED token
//     sequence is far below that of a HEALTHY diverse one — the two values
//     separate with a margin ≫ measurement noise → LZ is a valid detokenize-free
//     collapse proxy.
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F-D1.1 REAL-COLLAPSE — the REAL M4b sampled sequence [1,1,1,1,151642×16]
//            has normalised LZ rate < HEALTHY_FLOOR (0.50). The real collapse is
//            cheaply detected.
//     F-D1.2 SEPARATION (decisive) — min(healthy LZ_norm) − max(collapse LZ_norm)
//            > SEP_MARGIN (0.20). Healthy and collapse bands do NOT overlap.
//            FALSIFIED iff bands overlap (margin ≤ 0) → LZ proxy invalid.
//     F-D1.3 MONOTONE — raw LZ76 production-count is monotone in diversity:
//            c(constant) ≤ c(2-token) ≤ c(diverse) ≤ c(all-unique).
//     F-D1.4 ANCHORS — a constant sequence [t,t,…] has raw c(n)=2 (canonical
//            single-symbol parse) and an all-unique sequence has raw c(n)=n
//            (every symbol is a new phrase) for the binarized stream.
//     F-D1.5 DETERMINISM — the REAL M4b sequence LZ re-run is bit-identical.
//
//   METHOD — TOKEN-ID → BINARY STREAM → LZ76
//     A token-id sequence is not directly a binary string. Following the same
//     binarisation convention as H_288 / clm_eeg_lz76_real (a flat binary stream
//     fed to the canonical Kaspar-Schuster LZ76 parse), we map each token id to
//     a fixed-width BITS-bit binary expansion (LSB-first) and concatenate them
//     into one stream of length n·BITS. Repetition (collapse) → long runs of the
//     same bit-block → few LZ76 productions; diversity → many distinct blocks →
//     many productions. LZ_norm = c(n)·log2(L)/L (random binary → ~1; H_288 form).
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU · foreground.
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }
fn nsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// ── canonical Lempel-Ziv 1976 (Kaspar-Schuster 1987) production-count ────────
//    s : array of 0/1 ints, length n. Returns c(n) = distinct-phrase count.
//    (verbatim form from UNIVERSE/state/h288.../run_h288.hexa lz76 — g61 reuse.)
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}

// ── token-id sequence → flat binary stream (BITS-bit LSB-first per token) ────
let BITS = 18                                   // 2^18 = 262144 > vocab 151643

fn ids_to_bits(ids: array, n: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let mut v = ids[i]
        let mut b = 0
        while b < BITS {
            out = out.push(v % 2)
            v = v / 2
            b = b + 1
        }
        i = i + 1
    }
    return out
}

// raw LZ76 production-count on a token-id sequence (via binarisation).
fn lz_raw(ids: array, n: int) -> int {
    let bits = ids_to_bits(ids, n)
    return lz76(bits, n * BITS)
}

// normalised LZ rate: c(L)·log2(L)/L  on the binary stream of length L=n·BITS
// (random binary → ~1; H_288 / clm_eeg_lz76_real convention).
fn lz_norm(ids: array, n: int) -> float {
    let len = n * BITS
    let c = lz_raw(ids, n)
    return to_float(c) * log2(to_float(len)) / to_float(len)
}

fn main() {
    println("================================================================")
    println("  D1 — LZ76 collapse proxy: does LZ76 separate COLLAPSE vs HEALTHY?")
    println("  (token-id seq → " + str(BITS) + "-bit binary stream → Kaspar-Schuster LZ76)")
    println("================================================================")

    // ── REAL M4b collapse sequence (phase5b train.out DECODED_IDS) ───────────
    //    1 1 1 1 151642 ×16  (TTR=0.1, unique=2/20)
    let real_collapse = [1,1,1,1, 151642,151642,151642,151642, 151642,151642,151642,151642,
                         151642,151642,151642,151642, 151642,151642,151642,151642]
    let nseq = 20

    // ── synthetic COLLAPSE variants (length 20) ──────────────────────────────
    let collapse_const  = [7,7,7,7,7,7,7,7,7,7, 7,7,7,7,7,7,7,7,7,7]              // single token
    let collapse_eot    = [151642,151642,151642,151642,151642,151642,151642,151642,151642,151642,
                           151642,151642,151642,151642,151642,151642,151642,151642,151642,151642] // pure EOT
    let collapse_2tok   = [42,99,42,99,42,99,42,99,42,99, 42,99,42,99,42,99,42,99,42,99]          // 2-token cycle

    // ── HEALTHY diverse variants (length 20) ─────────────────────────────────
    let healthy_unique  = [101,3402,57,8891,12,44210,765,2,99001,330,
                           5,71234,888,4,150022,67,9,33891,1201,76]              // all distinct
    let healthy_mixed   = [101,3402,101,57,8891,57,12,44210,765,12,
                           99001,330,99001,5,71234,5,888,150022,67,888]          // realistic repeat mix

    println("  --- COLLAPSE band (low diversity) ---")
    let lz_real      = lz_norm(real_collapse, nseq)
    let raw_real     = lz_raw(real_collapse, nseq)
    let lz_const     = lz_norm(collapse_const, nseq)
    let lz_eot       = lz_norm(collapse_eot, nseq)
    let lz_2tok      = lz_norm(collapse_2tok, nseq)
    let raw_const    = lz_raw(collapse_const, nseq)
    let raw_2tok     = lz_raw(collapse_2tok, nseq)
    println("  REAL-M4b [1×4,151642×16] : LZ_norm=" + str(lz_real)  + "  raw_c=" + str(raw_real))
    println("  collapse_const  [t×20]   : LZ_norm=" + str(lz_const) + "  raw_c=" + str(raw_const))
    println("  collapse_eot    [eot×20] : LZ_norm=" + str(lz_eot))
    println("  collapse_2tok   [ab×10]  : LZ_norm=" + str(lz_2tok)  + "  raw_c=" + str(raw_2tok))

    println("  --- HEALTHY band (high diversity) ---")
    let lz_unique    = lz_norm(healthy_unique, nseq)
    let lz_mixed     = lz_norm(healthy_mixed, nseq)
    let raw_unique   = lz_raw(healthy_unique, nseq)
    println("  healthy_unique  [20 dist] : LZ_norm=" + str(lz_unique) + "  raw_c=" + str(raw_unique))
    println("  healthy_mixed   [mix rep] : LZ_norm=" + str(lz_mixed))

    // ── band extremes ─────────────────────────────────────────────────────────
    // collapse band max
    let mut collapse_max = lz_real
    if lz_const > collapse_max { collapse_max = lz_const }
    if lz_eot   > collapse_max { collapse_max = lz_eot }
    if lz_2tok  > collapse_max { collapse_max = lz_2tok }
    // healthy band min
    let mut healthy_min = lz_unique
    if lz_mixed < healthy_min { healthy_min = lz_mixed }

    let sep = healthy_min - collapse_max
    println("  --")
    println("  collapse band MAX LZ_norm = " + str(collapse_max))
    println("  healthy  band MIN LZ_norm = " + str(healthy_min))
    println("  SEPARATION margin         = " + str(sep))

    // ── falsifier thresholds (frozen) ──────────────────────────────────────────
    let HEALTHY_FLOOR = 0.50
    let SEP_MARGIN    = 0.20

    // ── F-D1.1 REAL-COLLAPSE ───────────────────────────────────────────────────
    check("F-D1.1 REAL-COLLAPSE: M4b [1×4,151642×16] LZ_norm < HEALTHY_FLOOR (0.50)", lz_real < HEALTHY_FLOOR)

    // ── F-D1.2 SEPARATION (decisive) ────────────────────────────────────────────
    let separates = sep > SEP_MARGIN
    check("F-D1.2 SEPARATION: min(healthy) - max(collapse) > SEP_MARGIN (0.20)", separates)

    // ── F-D1.3 MONOTONE ──────────────────────────────────────────────────────────
    // raw_const (single token) <= raw_2tok (2-cycle) <= raw_unique (all distinct)
    check("F-D1.3 MONOTONE: raw_c(const) <= raw_c(2tok) <= raw_c(unique)",
          (raw_const <= raw_2tok) && (raw_2tok <= raw_unique))

    // ── F-D1.4 ANCHORS ─────────────────────────────────────────────────────────
    // constant binary stream: a single repeated 18-bit block. LZ76 of a constant
    // binary string (all 0s after first, or repeating block) parses to a small c.
    // all-unique: many distinct blocks → c near the bit-length scale.
    check("F-D1.4a ANCHOR: collapse_const raw_c small (< healthy_unique raw_c)", raw_const < raw_unique)
    check("F-D1.4b ANCHOR: healthy_unique LZ_norm > 0 (non-degenerate)", lz_unique > 0.0)

    // ── F-D1.5 DETERMINISM ─────────────────────────────────────────────────────
    let lz_real_b = lz_norm(real_collapse, nseq)
    let dd = lz_real - lz_real_b
    let dd_abs = if dd < 0.0 { 0.0 - dd } else { dd }
    check("F-D1.5 DETERMINISM: REAL M4b LZ_norm re-run identical", dd_abs < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if separates && (lz_real < HEALTHY_FLOOR) {
        println("  VERDICT: H_D1 SUPPORTED — LZ76 separates COLLAPSE vs HEALTHY")
        println("           (margin " + str(sep) + " > " + str(SEP_MARGIN) + ").")
        println("           LZ76 is a valid detokenize-free collapse proxy ($0, cheap).")
    } else {
        println("  VERDICT: H_D1 FALSIFIED — LZ76 bands overlap (margin <= 0.20).")
        println("           LZ proxy invalid; detokenize-based detection unavoidable.")
    }
    println("================================================================")
    if FAIL > 0 { panic("D1 had FALSIFIER FAILURES") }
}
