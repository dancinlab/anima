// CORE/DECODER/v3_moe_arch_smoke.hexa — Phase 4-gpu-2 MoE mm()-port gradcheck
//
// Verifies the mm()-ported v3_moe_fwd/v3_moe_bwd (expert gemv → cuBLAS⇄CPU)
// still match finite-difference on Mac (CPU oracle path). Small d=4 V=4 E=2.
// Loss L = 0.5·Σ logits²  → d_logits = logits.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "CORE/DECODER/flame_mm"
use "CORE/DECODER/v3_moe_arch"

fn loss_sq(logits, V) -> float {
    let mut acc = 0.0
    let mut k = 0
    while k < V { let v = farr_get(logits, k) ; acc = acc + 0.5 * v * v ; k = k + 1 }
    return acc
}

fn main() {
    println("=== v3_moe_arch_smoke: Phase 4-gpu-2 MoE mm()-port gradcheck ===")
    print("  cuda_available = "); println(cuda_available())
    let d = 4
    let V = 4
    let E = 2
    let router_off = 0
    let experts_off = E * d
    let m_size = E * d + E * V * d
    let M = t_zeros(m_size)
    // router init (distinct per expert so softmax non-trivial)
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.10 * to_float(j + 1))
        let _ = farr_set(M, router_off + 1 * d + j, 0.10 * to_float(4 - j))
        j = j + 1
    }
    // experts init
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj,
                                  0.05 * to_float(e + 1) * to_float(k + 1) + 0.01 * to_float(jj + 1))
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    // input zT
    let zT = t_zeros(d)
    let mut zi = 0
    while zi < d { let _ = farr_set(zT, zi, 0.2 * to_float(zi + 1) - 0.3) ; zi = zi + 1 }

    let logits = t_zeros(V)
    let gate = t_zeros(E)
    let top = v3_moe_fwd(zT, M, router_off, experts_off, logits, gate, V, d, E)
    let L_base = loss_sq(logits, V)
    print("  fwd: top="); print(top); print(" gate_sum=")
    println(farr_get(gate, 0) + farr_get(gate, 1))
    print("  L_base="); println(L_base)

    // analytic bwd: d_logits = logits
    let dMg = t_zeros(m_size)
    let d_zT = t_zeros(d)
    let d_logits = t_zeros(V)
    let mut k2 = 0
    while k2 < V { let _ = farr_set(d_logits, k2, farr_get(logits, k2)) ; k2 = k2 + 1 }
    v3_moe_bwd(zT, M, router_off, experts_off, gate, top, d_logits, dMg, d_zT, V, d, E)

    let h = 1.0e-6
    let tol = 1.0e-5
    let mut pass = 1
    let exp_base = experts_off + top * V * d

    // finite-diff: expert[top, k, j] (the mm()-ported grad)
    let mut max_dexp_err = 0.0
    let mut fk = 0
    while fk < V {
        let mut fj = 0
        while fj < d {
            let off = exp_base + fk * d + fj
            let orig = farr_get(M, off)
            let _ = farr_set(M, off, orig + h)
            let lp = t_zeros(V)
            let gp = t_zeros(E)
            let _t = v3_moe_fwd(zT, M, router_off, experts_off, lp, gp, V, d, E)
            let Lp = loss_sq(lp, V)
            let _ = farr_set(M, off, orig - h)
            let _t2 = v3_moe_fwd(zT, M, router_off, experts_off, lp, gp, V, d, E)
            let Lm = loss_sq(lp, V)
            let _ = farr_set(M, off, orig)
            let fd = (Lp - Lm) / (2.0 * h)
            let an = farr_get(dMg, off)
            let mut err = fd - an
            if err < 0.0 { err = 0.0 - err }
            if err > max_dexp_err { max_dexp_err = err }
            fj = fj + 1
        }
        fk = fk + 1
    }
    print("  expert grad gradcheck max|Δ| = "); println(max_dexp_err)
    if max_dexp_err > tol { pass = 0 }

    // finite-diff: d_zT[j] (mm()-ported d_zT from expert + router-softmax loop)
    let mut max_dz_err = 0.0
    let mut fz = 0
    while fz < d {
        let orig = farr_get(zT, fz)
        let _ = farr_set(zT, fz, orig + h)
        let lp = t_zeros(V)
        let gp = t_zeros(E)
        let _t = v3_moe_fwd(zT, M, router_off, experts_off, lp, gp, V, d, E)
        let Lp = loss_sq(lp, V)
        let _ = farr_set(zT, fz, orig - h)
        let _t2 = v3_moe_fwd(zT, M, router_off, experts_off, lp, gp, V, d, E)
        let Lm = loss_sq(lp, V)
        let _ = farr_set(zT, fz, orig)
        let fd = (Lp - Lm) / (2.0 * h)
        let an = farr_get(d_zT, fz)
        let mut err = fd - an
        if err < 0.0 { err = 0.0 - err }
        if err > max_dz_err { max_dz_err = err }
        fz = fz + 1
    }
    print("  d_zT gradcheck max|Δ| = "); println(max_dz_err)
    if max_dz_err > tol { pass = 0 }

    println("")
    if pass == 1 {
        println("V3_MOE_ARCH_SMOKE Phase 4-gpu-2: PASS (mm()-port fwd/bwd == finite-diff < 1e-5)")
    } else {
        println("V3_MOE_ARCH_SMOKE Phase 4-gpu-2: FAIL")
    }
}
