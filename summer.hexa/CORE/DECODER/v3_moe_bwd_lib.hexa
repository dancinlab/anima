// CORE/DECODER/v3_moe_bwd_lib.hexa — M4b-fire-scale Phase 4-bwd analytic backward
//
// Analytic backward pass for the pilot decoder stack (Phase 4 forward path
// LANDED in PRs #1073..#1079). Built incrementally — each Phase 4-bwd-N
// sub-PR adds one pub fn here. Smoke / gradcheck per fn lives at
// CORE/DECODER/v3_moe_bwd_lib_smoke.hexa.
//
// Inventory (Phase 4-bwd-1..5):
//   ☑ ln_f_bwd            (this PR · Phase 4-bwd-1)
//   ☐ mlp_block_bwd       (Phase 4-bwd-2)
//   ☐ self_attn_bwd       (Phase 4-bwd-3)
//   ☐ layer_block_bwd     (Phase 4-bwd-4 — combines attn + mlp + residual)
//   ☐ tok_emb_bwd         (Phase 4-bwd-5 — scatter-add over token ids)
//
// Existing analytic bwd primitives live in CORE/DECODER/v3_moe_arch.hexa
// (`v3_moe_bwd` — MoE router/expert bwd). This file complements those with
// the pre-MoE stack (ln_f + layer blocks + tok_emb) so end-to-end gradient
// flow reaches every parameter group, not just MoE+last-layer-Wo.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "CORE/DECODER/flame_mm"

// ───────────────────────────────────────────────────────────────────────────
// Phase 4-bwd-1: ln_f RMSNorm backward
// ───────────────────────────────────────────────────────────────────────────
//
// Forward:
//   ms = (1/d) · Σ_j x[j]²
//   rms_inv = 1 / sqrt(ms + eps)
//   y[i] = x[i] · rms_inv · γ[i]
//
// Backward (analytic vjp · derived in design doc):
//   Given d_y[i]:
//     ∂L/∂γ[i] = d_y[i] · x[i] · rms_inv                  (accumulate to dMg)
//     ∂L/∂x[j] = γ[j]·d_y[j]·rms_inv
//                - x[j] · rms_inv³ / d · Σ_i (d_y[i]·γ[i]·x[i])
//
// Args:
//   d_y       (T_d)       gradient of L wrt y  (length d)
//   x         (T_d)        forward input          (length d, kept for vjp)
//   gamma_off (int)       offset into M of γ[0..d]
//   M         (T_msize)   packed param buffer (γ slice read here)
//   d         (int)       dim
//   rms_inv   (float)     1 / sqrt(ms + eps)     (cached from forward)
//   dMg       (T_msize)   packed grad buffer     (γ grad accumulated in-place)
//   d_x_out   (T_d)       OUTPUT gradient wrt x  (overwritten)
pub fn ln_f_bwd(d_y, x, gamma_off, M, d, rms_inv, dMg, d_x_out) {
    // accumulate dγ[i] += d_y[i] · x[i] · rms_inv
    let mut i = 0
    while i < d {
        let dg = farr_get(d_y, i) * farr_get(x, i) * rms_inv
        let _ = farr_set(dMg, gamma_off + i, farr_get(dMg, gamma_off + i) + dg)
        i = i + 1
    }
    // Σ_i d_y[i]·γ[i]·x[i]   (scalar)
    let mut sum_dy_g_x = 0.0
    let mut k = 0
    while k < d {
        sum_dy_g_x = sum_dy_g_x + farr_get(d_y, k) * farr_get(M, gamma_off + k) * farr_get(x, k)
        k = k + 1
    }
    // d_x[j] = γ[j]·d_y[j]·rms_inv - x[j]·sum·rms_inv³/d
    let rms_inv3_over_d = rms_inv * rms_inv * rms_inv / to_float(d)
    let mut j = 0
    while j < d {
        let term1 = farr_get(M, gamma_off + j) * farr_get(d_y, j) * rms_inv
        let term2 = farr_get(x, j) * sum_dy_g_x * rms_inv3_over_d
        let _ = farr_set(d_x_out, j, term1 - term2)
        j = j + 1
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Phase 4-bwd-2: MLP block (W_up · ReLU · W_down) backward
// ───────────────────────────────────────────────────────────────────────────
//
// Forward (per-token):
//   h_pre[k] = Σ_j W_up[k, j] · x[j]                 (k in 0..h)
//   h_act[k] = max(0, h_pre[k])                      (ReLU)
//   y[i]    = Σ_k W_down[i, k] · h_act[k]            (i in 0..d)
//
// Backward (analytic vjp):
//   Given d_y[i]:
//     dW_down[i, k]  = d_y[i] · h_act[k]              (rank-1 outer)
//     d_h_act[k]    = Σ_i d_y[i] · W_down[i, k]      (vjp through W_down)
//     d_h_pre[k]    = d_h_act[k] · 1[h_act[k] > 0]   (ReLU bwd — h_act > 0 ⇔ not zeroed)
//     dW_up[k, j]    = d_h_pre[k] · x[j]              (rank-1 outer)
//     d_x[j]        = Σ_k d_h_pre[k] · W_up[k, j]    (vjp through W_up)
//
// Note: h_act suffices for ReLU bwd (no separate h_pre buffer needed —
// the zero mask is recoverable from h_act since h_act = max(0, h_pre)).
//
// Args:
//   d_y        (T_d)        gradient wrt y         (length d)
//   x          (T_d)        forward input          (length d)
//   h_act      (T_h)        forward activations    (length h)  (post-ReLU)
//   wup_off    (int)        offset into M of W_up   (k·d + j layout, h·d slots)
//   wdown_off  (int)        offset into M of W_down (i·h + k layout, d·h slots)
//   M          (T_msize)    packed param buffer
//   d          (int)        out dim
//   h          (int)        hidden dim
//   dMg        (T_msize)    packed grad buffer (dW_up + dW_down accumulated +=)
//   d_x_out    (T_d)        OUTPUT gradient wrt x  (overwritten)
pub fn mlp_block_bwd(d_y, x, h_act, wup_off, wdown_off, M, d, h, dMg, d_x_out) {
    // dW_down[i, k] += d_y[i] · h_act[k]   (outer product)
    let mut i = 0
    while i < d {
        let dyi = farr_get(d_y, i)
        let mut k = 0
        while k < h {
            let prev = farr_get(dMg, wdown_off + i * h + k)
            let _ = farr_set(dMg, wdown_off + i * h + k, prev + dyi * farr_get(h_act, k))
            k = k + 1
        }
        i = i + 1
    }
    // d_h_pre[k] = (Σ_i d_y[i] · W_down[i, k]) · 1[h_act[k] > 0]
    let d_h_pre = t_zeros(h)
    let mut k2 = 0
    while k2 < h {
        let mut acc = 0.0
        let mut i2 = 0
        while i2 < d {
            acc = acc + farr_get(d_y, i2) * farr_get(M, wdown_off + i2 * h + k2)
            i2 = i2 + 1
        }
        // ReLU bwd: pass through only if h_act[k] > 0
        if farr_get(h_act, k2) > 0.0 {
            let _ = farr_set(d_h_pre, k2, acc)
        }
        k2 = k2 + 1
    }
    // dW_up[k, j] += d_h_pre[k] · x[j]
    let mut k3 = 0
    while k3 < h {
        let dhk = farr_get(d_h_pre, k3)
        if dhk != 0.0 {
            let mut j = 0
            while j < d {
                let prev = farr_get(dMg, wup_off + k3 * d + j)
                let _ = farr_set(dMg, wup_off + k3 * d + j, prev + dhk * farr_get(x, j))
                j = j + 1
            }
        }
        k3 = k3 + 1
    }
    // d_x[j] = Σ_k d_h_pre[k] · W_up[k, j]
    let mut j2 = 0
    while j2 < d {
        let mut acc = 0.0
        let mut k4 = 0
        while k4 < h {
            acc = acc + farr_get(d_h_pre, k4) * farr_get(M, wup_off + k4 * d + j2)
            k4 = k4 + 1
        }
        let _ = farr_set(d_x_out, j2, acc)
        j2 = j2 + 1
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Phase 4-gpu-4b: MLP block backward — BATCHED (mm() over all T tokens)
// ───────────────────────────────────────────────────────────────────────────
//
// Batched counterpart of mlp_block_bwd (per-token). layer_block_bwd calls THIS
// once per layer instead of mlp_block_bwd T times — avoids per-token weight
// re-extraction (the per-token path would mm_extract Wup/Wdown T× per layer)
// and turns the dominant fire-scale MLP backward into real matrix-matrix gemms.
//
// Forward (per token, batched here over T):  h_pre = x @ Wupᵀ ; h_act = ReLU ;
//   y = h_act @ Wdownᵀ   (Wup stored [h×d], Wdown stored [d×h])
// Backward (given d_y_seq [T×d]):
//   dW_down += d_y_seqᵀ @ h_act_seq : [d×T]@[T×h]=[d×h]          (accumulate)
//   d_h_act  = d_y_seq @ Wdown      : [T×d]@[d×h]=[T×h]          (Wdown [d×h])
//   d_h_pre  = d_h_act ⊙ 1[h_act>0] (ReLU mask, elementwise)
//   dW_up   += d_h_pre_seqᵀ @ x_seq : [h×T]@[T×d]=[h×d]          (accumulate)
//   d_x_seq  = d_h_pre_seq @ Wup    : [T×h]@[h×d]=[T×d]          (Wup [h×d])
//
// Args:
//   d_y_seq    (T·d)  gradient wrt MLP output (per token)
//   x_seq      (T·d)  forward MLP input (= zT_mid per token)
//   h_act_seq  (T·h)  forward post-ReLU activations
//   wup_off/wdown_off · M/dMg · T,d,h
//   d_x_seq_out (T·d) OUTPUT gradient wrt MLP input (overwritten)
pub fn mlp_block_bwd_batched(d_y_seq, x_seq, h_act_seq, wup_off, wdown_off,
                             M, T, d, h, dMg, d_x_seq_out) {
    // dW_down += d_y_seqᵀ @ h_act_seq : [d×T]@[T×h]=[d×h]
    let dy_T = mm_transpose(d_y_seq, T, d)               // [d×T]
    let dWdown_r = mm(dy_T, d, T, h_act_seq, h)          // [d×h]
    mm_scatter_add(dMg, wdown_off, dWdown_r, d * h)
    let _ = farr_free(dy_T)
    let _ = farr_free(dWdown_r)
    // d_h_act = d_y_seq @ Wdown : [T×d]@[d×h]=[T×h]  (Wdown stored [d×h])
    let wdown_mat = mm_extract(M, wdown_off, d, h)
    let d_h_act = mm(d_y_seq, T, d, wdown_mat, h)        // [T×h]
    let _ = farr_free(wdown_mat)
    // d_h_pre = d_h_act ⊙ 1[h_act > 0]  (ReLU mask)
    let d_h_pre = t_zeros(T * h)
    let mut hi = 0
    while hi < T * h {
        if farr_get(h_act_seq, hi) > 0.0 {
            let _ = farr_set(d_h_pre, hi, farr_get(d_h_act, hi))
        }
        hi = hi + 1
    }
    let _ = farr_free(d_h_act)
    // dW_up += d_h_preᵀ @ x_seq : [h×T]@[T×d]=[h×d]
    let dhp_T = mm_transpose(d_h_pre, T, h)              // [h×T]
    let dWup_r = mm(dhp_T, h, T, x_seq, d)               // [h×d]
    mm_scatter_add(dMg, wup_off, dWup_r, h * d)
    let _ = farr_free(dhp_T)
    let _ = farr_free(dWup_r)
    // d_x_seq = d_h_pre @ Wup : [T×h]@[h×d]=[T×d]  (Wup stored [h×d])
    let wup_mat = mm_extract(M, wup_off, h, d)
    let dx_r = mm(d_h_pre, T, h, wup_mat, d)             // [T×d]
    let mut xi = 0
    while xi < T * d { let _ = farr_set(d_x_seq_out, xi, farr_get(dx_r, xi)) ; xi = xi + 1 }
    let _ = farr_free(wup_mat)
    let _ = farr_free(d_h_pre)
    let _ = farr_free(dx_r)
}

// ───────────────────────────────────────────────────────────────────────────
// Phase 4-bwd-3: self-attention backward (Q/K/V/Wo · causal-softmax)
// ───────────────────────────────────────────────────────────────────────────
//
// Forward (scaled-dot-product, causal):
//   Q[t, j] = Σ_jj zT_seq[t, jj] · Wq[jj, j]
//   K[t, j] = Σ_jj zT_seq[t, jj] · Wk[jj, j]
//   V[t, j] = Σ_jj zT_seq[t, jj] · Wv[jj, j]
//   scores[t1, t2] = (Σ_j Q[t1, j]·K[t2, j]) · attn_scale   (causal: t2 ≤ t1)
//   probs[t1, :]   = softmax(scores[t1, :])                  (-inf on causal-masked)
//   attn_out[t1, j] = Σ_t2 probs[t1, t2] · V[t2, j]
//   y[t1, j]       = Σ_jj attn_out[t1, jj] · Wo[jj, j]
//
// Backward (analytic vjp, chain rule):
//   dWo[i, j]       += Σ_t1 attn_out[t1, i] · d_y[t1, j]
//   d_attn_out[t,i]  = Σ_j d_y[t, j] · Wo[i, j]
//
//   d_probs[t1, t2]  = Σ_j d_attn_out[t1, j] · V[t2, j]
//   d_V[t2, j]      += Σ_t1 probs[t1, t2] · d_attn_out[t1, j]
//
//   softmax jvp (row-wise):
//   d_scores[t1, t2] = probs[t1, t2] · (d_probs[t1, t2]
//                       - Σ_k probs[t1, k] · d_probs[t1, k])
//   (causal: probs=0 for t2 > t1 ⇒ d_scores=0 there automatically)
//   d_scores_scaled  = d_scores · attn_scale
//
//   d_Q[t1, j]      += Σ_t2 d_scores_scaled[t1, t2] · K[t2, j]
//   d_K[t2, j]      += Σ_t1 d_scores_scaled[t1, t2] · Q[t1, j]
//
//   dWq[i, j]       += Σ_t1 zT_seq[t1, i] · d_Q[t1, j]
//   dWk[i, j]       += Σ_t2 zT_seq[t2, i] · d_K[t2, j]
//   dWv[i, j]       += Σ_t2 zT_seq[t2, i] · d_V[t2, j]
//
//   d_zT_out[t, i]   = Σ_j (d_Q[t,j]·Wq[i,j] + d_K[t,j]·Wk[i,j] + d_V[t,j]·Wv[i,j])
//
// Args (all buffers, T·d / T·T sized):
//   d_y         (T·d)  gradient wrt y (post-Wo output)
//   zT_seq      (T·d)  forward input (pre-attention)
//   Q_buf, K_buf, V_buf  (T·d each) forward projections (cached from fwd)
//   attn_out    (T·d)  forward attention output (pre-Wo, cached from fwd)
//   probs       (T·T)  forward softmax probs (cached from fwd · causal-zeroed)
//   wq/wk/wv/wo_off    offsets into M
//   M / dMg     packed param + grad buffers
//   T, d        seq length + hidden dim
//   attn_scale  1 / sqrt(d) (cached from fwd)
//   d_zT_out    (T·d)  OUTPUT gradient wrt zT_seq (overwritten)
pub fn self_attn_bwd(d_y, zT_seq, Q_buf, K_buf, V_buf, attn_out, probs,
                      wq_off, wk_off, wv_off, wo_off,
                      M, T, d, attn_scale,
                      dMg, d_zT_out) {
    // Phase 4-gpu-4a: self_attn_bwd matmul 사이트 → flame_mm.mm() (batched [T×d],
    // cuBLAS Dgemm on GPU / CPU oracle on Mac). softmax-jvp 만 elementwise loop 유지.
    // weight 는 packed M 에서 mm_extract, 전치는 mm_transpose (NN-only API).

    // 1) dWo += attn_outᵀ @ d_y : [d×T]@[T×d]=[d×d]  (accumulate)
    let attn_out_T = mm_transpose(attn_out, T, d)        // [d×T]
    let dWo_r = mm(attn_out_T, d, T, d_y, d)             // [d×d]
    mm_scatter_add(dMg, wo_off, dWo_r, d * d)
    let _ = farr_free(attn_out_T)
    let _ = farr_free(dWo_r)
    // 2) d_attn_out = d_y @ Woᵀ : [T×d]@[d×d]=[T×d]   (Woᵀ[j,i]=Wo[i,j])
    let wo_mat = mm_extract(M, wo_off, d, d)
    let wo_T = mm_transpose(wo_mat, d, d)
    let d_attn_out = mm(d_y, T, d, wo_T, d)              // [T×d]
    let _ = farr_free(wo_mat)
    let _ = farr_free(wo_T)
    // 3) d_probs = d_attn_out @ Vᵀ : [T×d]@[d×T]=[T×T]
    let v_T = mm_transpose(V_buf, T, d)                  // [d×T]
    let d_probs = mm(d_attn_out, T, d, v_T, T)           // [T×T]
    let _ = farr_free(v_T)
    // 4) d_V = probsᵀ @ d_attn_out : [T×T]@[T×d]=[T×d]
    let probs_T = mm_transpose(probs, T, T)              // [T×T]
    let d_V = mm(probs_T, T, T, d_attn_out, d)           // [T×d]
    let _ = farr_free(probs_T)
    let _ = farr_free(d_attn_out)
    // 5) softmax jvp (row-wise): d_scores[t1,t2] = probs·(d_probs - Σ_k probs·d_probs)·scale
    let d_scores = t_zeros(T * T)
    let mut ts1 = 0
    while ts1 < T {
        let mut row_dot = 0.0
        let mut k = 0
        while k < T {
            row_dot = row_dot + farr_get(probs, ts1 * T + k) * farr_get(d_probs, ts1 * T + k)
            k = k + 1
        }
        let mut ts2 = 0
        while ts2 < T {
            let p = farr_get(probs, ts1 * T + ts2)
            let dp = farr_get(d_probs, ts1 * T + ts2)
            let _ = farr_set(d_scores, ts1 * T + ts2, p * (dp - row_dot) * attn_scale)
            ts2 = ts2 + 1
        }
        ts1 = ts1 + 1
    }
    let _ = farr_free(d_probs)
    // 6) d_Q = d_scores @ K : [T×T]@[T×d]=[T×d]
    let d_Q = mm(d_scores, T, T, K_buf, d)
    // 7) d_K = d_scoresᵀ @ Q : [T×T]@[T×d]=[T×d]
    let ds_T = mm_transpose(d_scores, T, T)
    let d_K = mm(ds_T, T, T, Q_buf, d)
    let _ = farr_free(ds_T)
    let _ = farr_free(d_scores)
    // 8) dWq/dWk/dWv += zT_seqᵀ @ d_Q/d_K/d_V : [d×T]@[T×d]=[d×d]  (accumulate)
    let zT_T = mm_transpose(zT_seq, T, d)                // [d×T]
    let dWq_r = mm(zT_T, d, T, d_Q, d)
    let dWk_r = mm(zT_T, d, T, d_K, d)
    let dWv_r = mm(zT_T, d, T, d_V, d)
    mm_scatter_add(dMg, wq_off, dWq_r, d * d)
    mm_scatter_add(dMg, wk_off, dWk_r, d * d)
    mm_scatter_add(dMg, wv_off, dWv_r, d * d)
    let _ = farr_free(zT_T)
    let _ = farr_free(dWq_r)
    let _ = farr_free(dWk_r)
    let _ = farr_free(dWv_r)
    // 9) d_zT_out = d_Q@Wqᵀ + d_K@Wkᵀ + d_V@Wvᵀ : each [T×d]@[d×d]=[T×d]
    let wq_mat = mm_extract(M, wq_off, d, d)
    let wk_mat = mm_extract(M, wk_off, d, d)
    let wv_mat = mm_extract(M, wv_off, d, d)
    let wq_T = mm_transpose(wq_mat, d, d)
    let wk_T = mm_transpose(wk_mat, d, d)
    let wv_T = mm_transpose(wv_mat, d, d)
    let dz_q = mm(d_Q, T, d, wq_T, d)
    let dz_k = mm(d_K, T, d, wk_T, d)
    let dz_v = mm(d_V, T, d, wv_T, d)
    let mut zsum_i = 0
    while zsum_i < T * d {
        let _ = farr_set(d_zT_out, zsum_i,
                          farr_get(dz_q, zsum_i) + farr_get(dz_k, zsum_i) + farr_get(dz_v, zsum_i))
        zsum_i = zsum_i + 1
    }
    let _ = farr_free(wq_mat)
    let _ = farr_free(wk_mat)
    let _ = farr_free(wv_mat)
    let _ = farr_free(wq_T)
    let _ = farr_free(wk_T)
    let _ = farr_free(wv_T)
    let _ = farr_free(dz_q)
    let _ = farr_free(dz_k)
    let _ = farr_free(dz_v)
    let _ = farr_free(d_Q)
    let _ = farr_free(d_K)
    let _ = farr_free(d_V)
}

// ───────────────────────────────────────────────────────────────────────────
// Phase 4-bwd-4: layer block backward (attn + residual + MLP + residual)
// ───────────────────────────────────────────────────────────────────────────
//
// Forward (one decoder block, Phase 4c train_v3_moe_pilot.hexa):
//   residual = zT_in
//   attn_y   = self_attn(zT_in) · Wo
//   zT_mid   = attn_y + residual                       (residual 1)
//   residual = zT_mid
//   mlp_y[t] = MLP(zT_mid[t])                           (per-token)
//   zT_out   = mlp_y + residual                         (residual 2)
//
// Backward (reverse order, residual = gradient bypass identity):
//   given d_zT_out:
//   residual 2 bwd:  d_mlp_y = d_zT_out · d_residual_mid = d_zT_out (bypass)
//   MLP bwd (per t): d_mlp_y[t] → d_zT_mid_from_mlp[t]  (mlp_block_bwd)
//   d_zT_mid = d_zT_mid_from_mlp + d_zT_out             (residual 2 skip add)
//   residual 1 bwd:  d_attn_y = d_zT_mid · d_residual_in = d_zT_mid (bypass)
//   attn bwd:        d_attn_y → d_zT_in_from_attn       (self_attn_bwd)
//   d_zT_in = d_zT_in_from_attn + d_zT_mid              (residual 1 skip add)
//
// Args:
//   d_block_out  (T·d)  gradient wrt block output (zT_out)
//   zT_in        (T·d)  forward block input (pre-attn) — for attn bwd
//   zT_mid       (T·d)  forward after attn+residual1 (pre-MLP) — for MLP bwd x
//   Q/K/V/attn_out/probs   forward attention caches
//   h_act_seq    (T·h)  forward per-token MLP activations (post-ReLU)
//   *_off        offsets into M for the 6 weight matrices
//   M / dMg      packed param + grad buffers
//   T, d, h      dims · attn_scale = 1/sqrt(d)
//   d_zT_in_grad (T·d)  OUTPUT gradient wrt block input (overwritten)
pub fn layer_block_bwd(d_block_out, zT_in, zT_mid,
                        Q_buf, K_buf, V_buf, attn_out, probs, h_act_seq,
                        wq_off, wk_off, wv_off, wo_off, wup_off, wdown_off,
                        M, T, d, h, attn_scale,
                        dMg, d_zT_in_grad) {
    // ── residual 2 + MLP bwd (Phase 4-gpu-4b: BATCHED single call, was per-token loop) ──
    // d_y_seq = d_block_out, x_seq = zT_mid, h_act_seq cached. → d_x_seq.
    let d_x_seq = t_zeros(T * d)
    mlp_block_bwd_batched(d_block_out, zT_mid, h_act_seq, wup_off, wdown_off,
                          M, T, d, h, dMg, d_x_seq)
    // residual 2: d_zT_mid[t] = d_x_seq[t] + d_block_out[t]  (skip-connection add)
    let d_zT_mid = t_zeros(T * d)
    let mut rz = 0
    while rz < T * d {
        let _ = farr_set(d_zT_mid, rz, farr_get(d_x_seq, rz) + farr_get(d_block_out, rz))
        rz = rz + 1
    }
    let _ = farr_free(d_x_seq)
    // ── residual 1 + attention bwd ──
    // d_attn_y = d_zT_mid (since zT_mid = attn_y + zT_in)
    let d_zT_in_from_attn = t_zeros(T * d)
    self_attn_bwd(d_zT_mid, zT_in, Q_buf, K_buf, V_buf, attn_out, probs,
                  wq_off, wk_off, wv_off, wo_off,
                  M, T, d, attn_scale, dMg, d_zT_in_from_attn)
    // residual 1: d_zT_in[t] = d_zT_in_from_attn[t] + d_zT_mid[t]  (skip-connection add)
    let mut z = 0
    while z < T * d {
        let _ = farr_set(d_zT_in_grad, z, farr_get(d_zT_in_from_attn, z) + farr_get(d_zT_mid, z))
        z = z + 1
    }
    // mm-leak fix: free the two per-call scratch buffers (were leaking every step).
    let _ = farr_free(d_zT_mid)
    let _ = farr_free(d_zT_in_from_attn)
}

// ───────────────────────────────────────────────────────────────────────────
// Phase 4-bwd-5: tok_emb backward (scatter-add over token ids)
// ───────────────────────────────────────────────────────────────────────────
//
// Forward:  zT_seq[t, j] = tok_emb[ids[t], j] = M[tok_emb_off + ids[t]·d + j]
// Backward: d_tok_emb[ids[t], j] += d_zT_seq[t, j]
//   (scatter-add — when two positions share a token id, both gradients land
//    on the same embedding row, hence accumulation not assignment)
//
// Args:
//   d_zT_seq    (T·d)  gradient wrt the embedded sequence
//   ids         (T)    token ids used in forward lookup (int array)
//   tok_emb_off (int)  offset into M of tok_emb[0,0]
//   T, d        seq length + dim
//   dMg         packed grad buffer (tok_emb rows accumulated +=)
pub fn tok_emb_bwd(d_zT_seq, ids, tok_emb_off, T, d, dMg) {
    let mut t = 0
    while t < T {
        let id = ids[t]
        let mut j = 0
        while j < d {
            let off = tok_emb_off + id * d + j
            let _ = farr_set(dMg, off, farr_get(dMg, off) + farr_get(d_zT_seq, t * d + j))
            j = j + 1
        }
        t = t + 1
    }
}
