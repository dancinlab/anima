// CORE/DECODER/train_v3_moe.hexa — M4b-fire-scale Phase 2b smoke driver
//
// Minimal MoE smoke: alloc packed M with router + experts slot, init weights,
// run one v3_moe_fwd + v3_moe_bwd, print verdict. Self-contained (no fire
// artifact import) — exercises CORE/DECODER/v3_moe_arch.hexa's packed-M
// fwd+bwd against a small (d=4, V=4, E=2) MoE-only layout.
//
// Phase 2b scope = SMOKE wiring only (parse + 1-step fwd/bwd works), NOT
// full training loop. Phase 3 (3B scale + memory budget) extends this with
// real flame decoder spine, AdamW step, multi-step loop, and the corpus
// path (P21H_BPE_ON wiring per design Phase 1).
//
// Layout: M = [router(E·d) | experts(E·V·d)]   (V3 spine excluded for smoke)
//   router_off  = 0
//   experts_off = E·d

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "stdlib/flame/flame_bpe_corpus_lib"
use "CORE/DECODER/v3_moe_arch"

// Phase 1 (BPE corpus wiring): when bpe_assert_on=1, load real Qwen tokenizer
// + corpus and verify in-vocab + round-trip guard PASS. Default 0 keeps the
// smoke side-effect-free (no external Qwen file deps). flame-P2b ③ FULL
// RESOLVED so this verification is meaningful (encode+decode round-trip PASS).
let bpe_assert_on = 0

fn _bpe_corpus_assert() {
    let merges_path = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/merges.txt"
    let vocab_path  = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/vocab.json"
    let corpus_path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
    let r = flame_bpe_corpus_load(merges_path, vocab_path, corpus_path)
    let V_bpe = r["vocab_size"]
    let n = r["n_toks"]
    let ids = r["ids"]
    print("  bpe: vocab_size="); print(V_bpe); print(" n_toks="); println(n)
    let ok_in_vocab = flame_bpe_ids_in_vocab(ids, V_bpe)
    print("  bpe: all ids in [0,V) = "); println(ok_in_vocab)
    let sample = "consciousness emerges from cells"
    let rt_ok = flame_bpe_roundtrip(r["tok"], sample)
    print("  bpe: round-trip '"); print(sample); print("' = "); println(rt_ok)
    if V_bpe > 150000 && ok_in_vocab && rt_ok {
        println("  BPE_CORPUS_ASSERT: PASS (Phase 1)")
    } else {
        println("  BPE_CORPUS_ASSERT: FAIL")
    }
}

fn main() {
    println("=== train_v3_moe smoke (MoE Phase 2b · packed-M fwd+bwd 1-step) ===")
    if bpe_assert_on == 1 { _bpe_corpus_assert() }

    let d = 4
    let V = 4
    let E = 2
    let h = 8   // Phase 3b-3 MLP hidden dim
    // Phase 3b-4 layout:
    //   M = [tok_emb(V·d) | attn_Wo(d·d) | mlp_Wup(h·d) | mlp_Wdown(d·h)
    //        | ln_f_gamma(d) | router(E·d) | experts(E·V·d)]
    let tok_emb_off = 0
    let attn_wo_off = V * d
    let mlp_wup_off = V * d + d * d
    let mlp_wdown_off = V * d + d * d + h * d
    let ln_f_off = V * d + d * d + 2 * h * d
    let router_off = V * d + d * d + 2 * h * d + d
    let experts_off = V * d + d * d + 2 * h * d + d + E * d
    let m_size = V * d + d * d + 2 * h * d + d + v3_moe_total_size(V, d, E)
    print("  config: d="); print(d); print(" V="); print(V); print(" E="); print(E)
    print(" m_size="); print(m_size)
    print(" (tok_emb_off="); print(tok_emb_off)
    print(" router_off="); print(router_off)
    print(" experts_off="); print(experts_off); println(")")

    // alloc packed buffers (model + grad), zT, logits, gate_norm, d_zT
    let M = t_zeros(m_size)
    let dMg = t_zeros(m_size)
    let zT = t_zeros(d)
    let logits_g = t_zeros(V)
    let gate_norm = t_zeros(E)
    let d_zT = t_zeros(d)
    let d_logits = t_zeros(V)

    // ── Phase 3b-1 tok_emb init (deterministic) ──
    // tok_emb[k, j] = 0.1·k + 0.01·j  → each token has distinct embed vector
    let mut kk0 = 0
    while kk0 < V {
        let mut jj0 = 0
        while jj0 < d {
            let v = 0.1 * to_float(kk0 + 1) + 0.01 * to_float(jj0 + 1)
            let _ = farr_set(M, tok_emb_off + kk0 * d + jj0, v)
            jj0 = jj0 + 1
        }
        kk0 = kk0 + 1
    }

    // deterministic init — router gate differs across experts so softmax non-trivial
    // router[e=0,:] = [0.10, 0.20, 0.30, 0.40]   → low gate
    // router[e=1,:] = [0.40, 0.30, 0.20, 0.10]   → high gate (different sign)
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.10 * to_float(j + 1))
        let _ = farr_set(M, router_off + 1 * d + j, 0.10 * to_float(4 - j))
        j = j + 1
    }
    // experts[e,k,j] = small unique value (no symmetry between experts)
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let v = 0.01 * to_float(e + 1) * to_float(k + 1) + 0.001 * to_float(jj + 1)
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj, v)
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    // ── Phase 3b-2 attn_Wo init: identity + small perturbation (T=1 smoke) ──
    let mut wi = 0
    while wi < d {
        let mut wj = 0
        while wj < d {
            let mut val = 0.0
            if wi == wj { val = 1.0 }
            val = val + 0.01 * to_float(wi + wj)
            let _ = farr_set(M, attn_wo_off + wi * d + wj, val)
            wj = wj + 1
        }
        wi = wi + 1
    }
    // ── Phase 3b-3 MLP weights init (W_up · W_down) ──
    let mut ui = 0
    while ui < h {
        let mut uj = 0
        while uj < d {
            let _ = farr_set(M, mlp_wup_off + ui * d + uj, 0.05 * to_float(ui + uj + 1))
            uj = uj + 1
        }
        ui = ui + 1
    }
    let mut di = 0
    while di < d {
        let mut dk = 0
        while dk < h {
            let mut val = 0.0
            if dk % d == di { val = 0.1 * to_float(dk + 1) }
            let _ = farr_set(M, mlp_wdown_off + di * h + dk, val)
            dk = dk + 1
        }
        di = di + 1
    }
    // ── Phase 3b-4 ln_f γ init = 1.0 (identity) ──
    let mut gi = 0
    while gi < d {
        let _ = farr_set(M, ln_f_off + gi, 1.0)
        gi = gi + 1
    }

    // ── Phase 3b-6 multi-step training loop ──
    // Persistent AdamW state (m, v) across steps. Bias-correction uses real t.
    // Synthetic round-robin token IDs (smoke V=4); real Qwen BPE corpus IDs feed
    // gates via bpe_assert_on=1 (vocab-size mismatch deferred to Phase 4 pilot).
    let beta1 = 0.9
    let beta2 = 0.95
    let lr = 1.0e-3
    let wd = 0.1
    let adam_eps = 1.0e-8
    let rmsnorm_eps = 1.0e-6
    let m_buf = t_zeros(m_size)
    let v_buf = t_zeros(m_size)
    // synthetic ID stream — round-robin so each step picks a different token
    let ids_arr = [2, 0, 1, 3, 2]
    let n_steps = 5
    // scratch buffers reused across steps (alloc once)
    let zT_scratch = t_zeros(d)
    let mlp_hact = t_zeros(h)
    let mlp_out = t_zeros(d)
    // snapshots BEFORE training for verdict probes
    let m_baseline_wo_00 = farr_get(M, attn_wo_off + 0 * d + 0)
    let mut prev_g00 = 0.0
    let mut final_top_idx = -1
    let mut final_gate_sum = 0.0
    let mut final_zT0 = 0.0
    let mut final_dw_top_00 = 0.0

    println("  ── multi-step loop start ──")
    let mut step = 1
    while step <= n_steps {
        // zero d_logits, dMg, d_zT (carry-clean each step)
        let mut zi = 0
        while zi < V { let _ = farr_set(d_logits, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < m_size { let _ = farr_set(dMg, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < d { let _ = farr_set(d_zT, zi, 0.0) ; zi = zi + 1 }

        // pick token id (round-robin over ids_arr)
        let token_id = ids_arr[(step - 1) % 5]
        // tok_emb lookup → zT
        let mut j2 = 0
        while j2 < d {
            let _ = farr_set(zT, j2, farr_get(M, tok_emb_off + token_id * d + j2))
            j2 = j2 + 1
        }
        // attn(Wo) · zT  (T=1 smoke: identity-ish projection)
        let mut ai = 0
        while ai < d {
            let mut acc = 0.0
            let mut aj = 0
            while aj < d {
                acc = acc + farr_get(M, attn_wo_off + ai * d + aj) * farr_get(zT, aj)
                aj = aj + 1
            }
            let _ = farr_set(zT_scratch, ai, acc)
            ai = ai + 1
        }
        ai = 0
        while ai < d { let _ = farr_set(zT, ai, farr_get(zT_scratch, ai)) ; ai = ai + 1 }
        // MLP forward
        let mut hk = 0
        while hk < h {
            let mut acc = 0.0
            let mut hj = 0
            while hj < d {
                acc = acc + farr_get(M, mlp_wup_off + hk * d + hj) * farr_get(zT, hj)
                hj = hj + 1
            }
            if acc < 0.0 { acc = 0.0 }
            let _ = farr_set(mlp_hact, hk, acc)
            hk = hk + 1
        }
        let mut mi = 0
        while mi < d {
            let mut acc = 0.0
            let mut mk = 0
            while mk < h {
                acc = acc + farr_get(M, mlp_wdown_off + mi * h + mk) * farr_get(mlp_hact, mk)
                mk = mk + 1
            }
            let _ = farr_set(mlp_out, mi, acc)
            mi = mi + 1
        }
        mi = 0
        while mi < d { let _ = farr_set(zT, mi, farr_get(mlp_out, mi)) ; mi = mi + 1 }
        // ln_f (RMSNorm)
        let mut ms = 0.0
        let mut mi2 = 0
        while mi2 < d {
            let xv = farr_get(zT, mi2) ; ms = ms + xv * xv ; mi2 = mi2 + 1
        }
        ms = ms / to_float(d)
        let rms_inv = 1.0 / sqrt(ms + rmsnorm_eps)
        let mut ni = 0
        while ni < d {
            let xv = farr_get(zT, ni)
            let gv = farr_get(M, ln_f_off + ni)
            let _ = farr_set(zT, ni, xv * rms_inv * gv)
            ni = ni + 1
        }
        // MoE forward
        let top_idx = v3_moe_fwd(zT, M, router_off, experts_off,
                                  logits_g, gate_norm, V, d, E)
        // synthetic CE-like grad: target = next token in ids_arr (round-robin)
        let target = ids_arr[step % 5]
        // d_logits = softmax(logits) - one_hot(target) — for smoke we approximate
        // by placing +1 at target's negative (encourages target) and reading back
        // logit at target slot to track "loss-like" magnitude.
        let _ = farr_set(d_logits, target, 1.0)
        // MoE backward
        v3_moe_bwd(zT, M, router_off, experts_off, gate_norm, top_idx, d_logits,
                   dMg, d_zT, V, d, E)
        // AdamW step with real t-bias-correction
        let bc1 = 1.0 - pow(beta1, to_float(step))
        let bc2 = 1.0 - pow(beta2, to_float(step))
        let mut pi = 0
        while pi < m_size {
            let g = farr_get(dMg, pi)
            let m_prev = farr_get(m_buf, pi)
            let v_prev = farr_get(v_buf, pi)
            let m_new = beta1 * m_prev + (1.0 - beta1) * g
            let v_new = beta2 * v_prev + (1.0 - beta2) * g * g
            let _ = farr_set(m_buf, pi, m_new)
            let _ = farr_set(v_buf, pi, v_new)
            let m_hat = m_new / bc1
            let v_hat = v_new / bc2
            let theta = farr_get(M, pi)
            let upd = lr * (m_hat / (sqrt(v_hat) + adam_eps) + wd * theta)
            let _ = farr_set(M, pi, theta - upd)
            pi = pi + 1
        }
        // per-step stat: target-slot logit (proxy loss probe), grad magnitude
        let logit_target = farr_get(logits_g, target)
        let g00 = farr_get(dMg, attn_wo_off + 0 * d + 0)
        print("  step=") ; print(step)
        print(" tok=") ; print(token_id)
        print(" tgt=") ; print(target)
        print(" top=") ; print(top_idx)
        print(" logit[tgt]=") ; print(logit_target)
        print(" dWo[0,0]=") ; print(g00)
        print(" Wo[0,0]=") ; print(farr_get(M, attn_wo_off + 0 * d + 0))
        println("")
        // capture final-step probes
        if step == n_steps {
            final_top_idx = top_idx
            final_gate_sum = farr_get(gate_norm, 0) + farr_get(gate_norm, 1)
            final_zT0 = farr_get(zT, 0)
            final_dw_top_00 = farr_get(dMg, experts_off + top_idx * V * d + 0 * d + 0)
        }
        prev_g00 = g00
        step = step + 1
    }
    println("  ── multi-step loop end ──")
    let m_final_wo_00 = farr_get(M, attn_wo_off + 0 * d + 0)
    let mut wo_delta = m_final_wo_00 - m_baseline_wo_00
    if wo_delta < 0.0 { wo_delta = 0.0 - wo_delta }
    print("  Wo[0,0] baseline="); print(m_baseline_wo_00)
    print(" final="); print(m_final_wo_00)
    print(" |Δ|="); println(wo_delta)

    // ── verdict ──
    let ln_f_g0 = farr_get(M, ln_f_off + 0)
    let mut pass = 1
    if final_gate_sum < 0.999 || final_gate_sum > 1.001 { pass = 0 } // softmax sum=1 at final step
    if final_top_idx < 0 || final_top_idx >= E { pass = 0 }          // valid top
    if final_dw_top_00 == 0.0 { pass = 0 }                           // winner got grad final step
    if final_zT0 == 0.0 { pass = 0 }                                 // tok_emb path live
    if ln_f_g0 == 0.0 { pass = 0 }                                   // γ non-zero post-train
    if wo_delta < 1.0e-6 { pass = 0 }                                // multi-step training moved params
    if pass == 1 {
        println("TRAIN_V3_MOE SMOKE: PASS (multi-step · tok_emb + Wo + MLP + ln_f + MoE fwd/bwd + AdamW · n_steps=5)")
    } else {
        println("TRAIN_V3_MOE SMOKE: FAIL")
    }
}
