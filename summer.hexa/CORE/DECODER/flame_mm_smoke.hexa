// CORE/DECODER/flame_mm_smoke.hexa — Phase 4-gpu-1 matmul dispatch verify
//
// Verifies mm() (CPU oracle path on Mac) == hand-written scalar triple-loop
// matmul, + mm_transpose + mm_extract correctness. Run on Mac local (CPU).
// The cuBLAS path (farr_matmul_gpu) is verified by hexa-lang RFC-040 GPU
// falsifiers on the fire pod (out of scope for this CPU smoke).

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "CORE/DECODER/flame_mm"

// reference scalar matmul A[M×K] @ B[K×N] → C[M×N] (the pattern we are replacing)
fn scalar_mm(A, M, K, B, N) -> int {
    let C = t_zeros(M * N)
    let mut i = 0
    while i < M {
        let mut j = 0
        while j < N {
            let mut acc = 0.0
            let mut k = 0
            while k < K {
                acc = acc + farr_get(A, i * K + k) * farr_get(B, k * N + j)
                k = k + 1
            }
            let _ = farr_set(C, i * N + j, acc)
            j = j + 1
        }
        i = i + 1
    }
    return C
}

fn max_abs_diff(c1, c2, n) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n {
        let mut d = farr_get(c1, i) - farr_get(c2, i)
        if d < 0.0 { d = 0.0 - d }
        if d > m { m = d }
        i = i + 1
    }
    return m
}

fn fill_lcg(h, n, seed0) {
    let mut state = seed0
    let mut i = 0
    while i < n {
        state = (state * 1103515245 + 12345) % 2147483647
        let _ = farr_set(h, i, (to_float(state) / 2147483647.0) * 2.0 - 1.0)
        i = i + 1
    }
}

fn main() {
    println("=== flame_mm_smoke: Phase 4-gpu-1 matmul dispatch verify ===")
    print("  cuda_available = "); println(cuda_available())
    let tol = 1.0e-12
    let mut pass = 1

    // ── mm == scalar (small exact) — A[2×3] @ B[3×2] ──
    let A = t_zeros(6)
    let _ = farr_set(A,0,1.0); let _ = farr_set(A,1,2.0); let _ = farr_set(A,2,3.0)
    let _ = farr_set(A,3,4.0); let _ = farr_set(A,4,5.0); let _ = farr_set(A,5,6.0)
    let B = t_zeros(6)
    let _ = farr_set(B,0,1.0); let _ = farr_set(B,1,0.0); let _ = farr_set(B,2,0.0)
    let _ = farr_set(B,3,1.0); let _ = farr_set(B,4,1.0); let _ = farr_set(B,5,1.0)
    let C_mm = mm(A, 2, 3, B, 2)
    let C_sc = scalar_mm(A, 2, 3, B, 2)
    let d_small = max_abs_diff(C_mm, C_sc, 4)
    print("  small mm vs scalar max|Δ| = "); println(d_small)
    if d_small > tol { pass = 0 }
    // also exact known value [[4,5],[10,11]]
    let exact = farr_get(C_mm,0) + farr_get(C_mm,1) + farr_get(C_mm,2) + farr_get(C_mm,3)
    if exact < 29.999 || exact > 30.001 { pass = 0 }   // 4+5+10+11 = 30

    // ── mm == scalar (random 13×17 @ 17×11) ──
    let M = 13
    let K = 17
    let N = 11
    let RA = t_zeros(M * K)
    let RB = t_zeros(K * N)
    fill_lcg(RA, M * K, 7)
    fill_lcg(RB, K * N, 99)
    let RC_mm = mm(RA, M, K, RB, N)
    let RC_sc = scalar_mm(RA, M, K, RB, N)
    let d_rand = max_abs_diff(RC_mm, RC_sc, M * N)
    print("  random mm vs scalar max|Δ| = "); println(d_rand)
    if d_rand > tol { pass = 0 }

    // ── mm_transpose: (A^T)[c×r], check At[c·rows+r] == A[r·cols+c] ──
    // A is 2×3; At should be 3×2
    let At = mm_transpose(A, 2, 3)
    // A[0×3+1] = A[1] = 2.0 → At[1×2+0] = At[2] should be 2.0
    let t_ok0 = farr_get(At, 2)            // A[0,1]=2 → At[1,0]
    let t_ok1 = farr_get(At, 1)            // A[1,0]... A[1*3+0]=A[3]=4 → At[0,1]=At[1]
    print("  transpose At[2]="); print(t_ok0); print(" (exp 2.0)  At[1]="); print(t_ok1); println(" (exp 4.0)")
    if t_ok0 < 1.999 || t_ok0 > 2.001 { pass = 0 }
    if t_ok1 < 3.999 || t_ok1 > 4.001 { pass = 0 }
    // transpose-then-matmul identity: (A^T)^T == A via two transposes
    let Att = mm_transpose(At, 3, 2)
    let d_tt = max_abs_diff(Att, A, 6)
    print("  (Aᵀ)ᵀ vs A max|Δ| = "); println(d_tt)
    if d_tt > tol { pass = 0 }

    // ── mm_extract: pull a 2×3 sub-block from a packed buffer at offset 4 ──
    let P = t_zeros(10)
    let mut pi = 0
    while pi < 10 { let _ = farr_set(P, pi, to_float(pi) * 0.5) ; pi = pi + 1 }
    let sub = mm_extract(P, 4, 2, 3)   // P[4..10] = [2.0, 2.5, 3.0, 3.5, 4.0, 4.5]
    let e_ok = farr_get(sub, 0) + farr_get(sub, 5)   // 2.0 + 4.5 = 6.5
    print("  extract sub[0]+sub[5]="); print(e_ok); println(" (exp 6.5)")
    if e_ok < 6.499 || e_ok > 6.501 { pass = 0 }

    // ── mm_scatter_add: accumulate sub back into P at offset 4 (+=) ──
    mm_scatter_add(P, 4, sub, 6)   // P[4] becomes 2.0 + 2.0 = 4.0
    let s_ok = farr_get(P, 4)
    print("  scatter_add P[4]="); print(s_ok); println(" (exp 4.0)")
    if s_ok < 3.999 || s_ok > 4.001 { pass = 0 }

    println("")
    if pass == 1 {
        println("FLAME_MM_SMOKE Phase 4-gpu-1: PASS (mm==scalar < 1e-12 · transpose · extract · scatter_add)")
    } else {
        println("FLAME_MM_SMOKE Phase 4-gpu-1: FAIL")
    }
}
