// CORE/DECODER/flame_mm.hexa — M4b Phase 4-gpu matmul dispatch foundation
//
// The M4b pilot (train_v3_moe_pilot.hexa + v3_moe_arch + v3_moe_bwd_lib) was
// authored with hand-written scalar triple-loop matmuls (plain farr). On an
// H100 that path leaves the GPU idle AND is computationally infeasible at
// pilot scale (d=2048·n_layer=12·T=512 ≈ 10^14 scalar ops on CPU).
//
// This module wires hexa-lang's RFC-040 device-farr + cuBLAS Dgemm path so the
// fire actually uses the GPU, while keeping a CPU oracle (farr_matmul) for Mac
// gradcheck. Replacing the triple loops with `mm(...)` is Phase 4-gpu-2..4.
//
// RFC-040 primitives (hexa-lang origin/main, builtin):
//   farr_matmul(A, M, K, B, N)      → C[M×N]  CPU oracle (always available)
//   farr_matmul_gpu(A, M, K, B, N)  → C[M×N]  cuBLAS Dgemm (<0 on error)
//   cuda_available()                → 1 on a CUDA host, else 0
//   All NN form: A[M×K] @ B[K×N] = C[M×N], row-major. NO transpose variant
//   (farr_matmul_nt absent) → transposes are explicit (mm_transpose).
//
// Honest verify note: the GPU (farr_matmul_gpu) path can ONLY be exercised on a
// CUDA host. On Mac, mm() dispatches to the CPU oracle, so all local gradchecks
// validate the SHAPES + math; the cuBLAS body is verified by hexa-lang's own
// RFC-040 GPU falsifiers (cuBLAS == CPU oracle, max|Δ| < 1e-9) on the fire pod.

// mm(A, M, K, B, N) → C[M×N] handle. cuBLAS Dgemm on a CUDA host, else CPU oracle.
//   A[M×K] @ B[K×N], row-major. Returns a NEW farr (int handle).
pub fn mm(A, M, K, B, N) -> int {
    if cuda_available() == 1 {
        return farr_matmul_gpu(A, M, K, B, N)
    }
    return farr_matmul(A, M, K, B, N)
}

// mm_transpose(A, rows, cols) → At[cols×rows] handle.
//   Explicit transpose for the Q·Kᵀ + backward Wᵀ cases (no _nt matmul variant).
pub fn mm_transpose(A, rows, cols) -> int {
    let at = farr_zeros(rows * cols)
    let mut r = 0
    while r < rows {
        let mut c = 0
        while c < cols {
            let _ = farr_set(at, c * rows + r, farr_get(A, r * cols + c))
            c = c + 1
        }
        r = r + 1
    }
    return at
}

// mm_extract(P, off, rows, cols) → standalone (rows×cols) handle.
//   Copies a row-major sub-block of a PACKED buffer P (offset `off`) into a
//   fresh index-0 farr, because farr_matmul takes index-0 handles (no offset).
//   Extraction is O(rows·cols) ≪ the matmul O(rows·cols·N) it feeds.
//
//   M5-ADOPT (anima 2026-05-29, hexa-lang #2031): the per-element scalar
//   `farr_get`/`farr_set` loop is replaced by a single `farr_copy_slice_gpu`
//   memcpy/D2D (HEXA_CUDA = device-to-device, else host memcpy). Public API
//   + byte-eq semantics preserved (same `n`-double `farr_zeros` output, same
//   source bytes — memcpy semantics → ULP=0). The `farr_zeros` alloc remains;
//   for fully 0-alloc hot loops, callers can hoist `dst` and use upstream
//   `stdlib/flame/mm_extract_lib.mm_extract_inplace(dst, P, off, rows, cols)`
//   directly (#2031 PR1, byte-eq verified by mm_extract_lib_test PR2 #2033).
pub fn mm_extract(P, off, rows, cols) -> int {
    let n = rows * cols
    let out = farr_zeros(n)
    let _ = farr_copy_slice_gpu(P, off, out, 0, n)
    return out
}

// mm_scatter_add(P, off, src, n) → accumulate src[0..n] into packed P at off (+=).
//   For writing matmul results back into a packed grad buffer (dMg) with
//   accumulation (multiple contributions land on the same weight region).
pub fn mm_scatter_add(P, off, src, n) {
    let mut i = 0
    while i < n {
        let _ = farr_set(P, off + i, farr_get(P, off + i) + farr_get(src, i))
        i = i + 1
    }
}

// ─── Offset-aware fused gemv (mm_extract elimination — anima #1317 follow-up) ──
//
// mm_packed_gemv(P, off, rows, cols, u) → out[rows] handle.
//
//   out[i] = Σ_j P[off + i·cols + j] · u[j]    (i ∈ [0,rows), j ∈ [0,cols))
//
//   Reads a [rows×cols] row-major sub-block directly from packed buffer P
//   (offset `off`) and multiplies by vector u[cols] — IN ONE PASS, no
//   intermediate copy. Direct replacement for the
//
//       let A = mm_extract(P, off, rows, cols)   // 9.7M-double host copy
//       let y = mm(A, rows, cols, u, 1)          // gemv
//       let _ = farr_free(A)
//
//   pattern (v3_moe_arch.hexa lines 101-108 fwd, 143/162 bwd). Eliminates the
//   per-token rows·cols-double alloc+copy+free (V=151643·d=64 = 9.7M doubles
//   = 77.6 MB at production scale; ~310 MB per 4-token step). The fused loop
//   is also strictly less work than copy+gemv (no rows·cols write-then-read).
//
//   CPU-only path (no cuBLAS dispatch). The cuBLAS Dgemm wraps farr_matmul
//   which requires index-0 handles — there is no farr_matmul_offset variant
//   in the hexa-lang RFC-040 surface (verified 2026-05-29: runtime.h has no
//   *_offset / view / slice API). For the production fire that needs cuBLAS,
//   the existing mm()-extract path remains available — but the dominant cost
//   per anima #1317 was the host-side copy, NOT the gemv compute itself.
pub fn mm_packed_gemv(P, off, rows, cols, u) -> int {
    let out = farr_zeros(rows)
    let mut i = 0
    while i < rows {
        let mut acc = 0.0
        let base = off + i * cols
        let mut j = 0
        while j < cols {
            acc = acc + farr_get(P, base + j) * farr_get(u, j)
            j = j + 1
        }
        let _ = farr_set(out, i, acc)
        i = i + 1
    }
    return out
}

// mm_packed_gemv_t(P, off, rows, cols, v) → out[cols] handle.
//
//   out[j] = Σ_i P[off + i·cols + j] · v[i]    (i ∈ [0,rows), j ∈ [0,cols))
//
//   The transposed counterpart: A^T·v where A = P[off..off+rows·cols] is a
//   [rows×cols] row-major sub-block, v is [rows]. Direct replacement for
//
//       let A = mm_extract(P, off, rows, cols)   // 9.7M-double host copy
//       let At = mm_transpose(A, rows, cols)     // SECOND 9.7M-double copy
//       let y = mm(At, cols, rows, v, 1)         // gemv
//       let _ = farr_free(A); let _ = farr_free(At)
//
//   pattern (v3_moe_arch.hexa lines 143/154/155 bwd, expertᵀ·dl_scaled). Saves
//   TWO rows·cols allocations + the explicit transpose loop, single pass.
pub fn mm_packed_gemv_t(P, off, rows, cols, v) -> int {
    let out = farr_zeros(cols)
    let mut i = 0
    while i < rows {
        let vi = farr_get(v, i)
        let base = off + i * cols
        let mut j = 0
        while j < cols {
            let prev = farr_get(out, j)
            let _ = farr_set(out, j, prev + farr_get(P, base + j) * vi)
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// mm_packed_outer_add(P, off, u, v, rows, cols) → accumulate outer(u, v) into P at off.
//
//   P[off + i·cols + j] += u[i] · v[j]    (i ∈ [0,rows), j ∈ [0,cols))
//
//   Direct replacement for the rank-1 outer-product accumulation
//
//       let d_expert = mm(u, rows, 1, v, cols)        // alloc rows·cols
//       mm_scatter_add(P, off, d_expert, rows·cols)   // read+write+free
//       let _ = farr_free(d_expert)
//
//   pattern (v3_moe_arch.hexa lines 151-152 bwd, dl_scaled outer zT). Saves
//   the rows·cols intermediate alloc + the read-then-write of the scatter_add.
//   Single pass over the packed region.
pub fn mm_packed_outer_add(P, off, u, v, rows, cols) {
    let mut i = 0
    while i < rows {
        let ui = farr_get(u, i)
        let base = off + i * cols
        let mut j = 0
        while j < cols {
            let prev = farr_get(P, base + j)
            let _ = farr_set(P, base + j, prev + ui * farr_get(v, j))
            j = j + 1
        }
        i = i + 1
    }
}
