// h1194_live_adaptation_coupling_probe.hexa — H_1194 LIVE-ENGINE adaptation
// coupling probe (MITOSIS-ENGINE · Lane2 rung).
//
// DOMAIN: MITOSIS-ENGINE · the rung that UNBLOCKS the live-engine adaptation
// curve that H_1166 (⏳ NO-ADAPTATION-SIGNAL) and H_1179 (⏳ HOURGLASS, field
// stream-blind) both hit. Those two found the live engine had NO usable
// error/adaptation signal: pure_field_step is ZERO-INPUT (advances the Ψ=1/2
// oscillators from internal dynamics alone), and the mitosis cell_count was
// never fed back. H_1166's stated unblock = 3 wires + 1 readout:
//   (1) stream → field input port, (2) cell_count → field feedback,
//   (3) a reconstruction/tension-error readout.
//
// H_1194 BUILDS that coupling ENGINE-NATIVE (CORE/engine_cli.hexa AdaptField,
// adapt_field_step / adapt_field_recon_err / adapt_field_cells) WITHOUT touching
// pure_field / Ψ, then RE-RUNS H_1159's FROZEN ON-vs-OFF falsifier ON THE LIVE
// COUPLING: drive a K-regime non-stationary stream, mitosis ON vs OFF, and ask
// H_1159b's live question — does the engine's OWN reconstruction-error FALL as
// novelty (new regimes) appears (p8 adaptation), and does mitosis-ON beat
// mitosis-OFF? (NOT just cell-count growth.)
//
// FROZEN FALSIFIER (pre-registered, deterministic >=3 seeds, live CORE, g5/p7):
//   GREEN LIVE-ADAPTS iff, over the K-regime stream:
//     (F1) ADAPT-TO-NOVELTY — at the novelty onsets (the first steps after each
//          regime boundary), the ON-arm recon-error is LOWER than the OFF-arm
//          recon-error by Cohen's d >= 0.8 (the live error FALLS under novelty
//          BECAUSE mitosis grows a cell to cover the new regime; the OFF arm
//          freezes capacity at the seed cell and eats the full novelty gap —
//          this IS H_1159's ON-vs-OFF control, now on the LIVE engine; p8), AND
//     (F2) GROWTH-DRIVEN — the live engine_mitosis_tick actually grew cells
//          ON > OFF AND the ON settled-error is no worse than OFF (the growth is
//          what buys the lower novelty-error, not a metric artifact), AND
//     (F3) Ψ-INTACT — the coupling does NOT perturb the Ψ attractor: the live
//          pure_field Φ trajectory is BYTE-IDENTICAL ON vs OFF (the attractor
//          is disjoint from the adaptation substrate — a_core_engine_map).
//   RED if the live coupling grows cells but recon-error does NOT fall, or ON
//      does not beat OFF (toy<->live mismatch / non-adaptive; a_paper_negative_ok).
//   HOURGLASS if the coupling could NOT be wired without perturbing Ψ or breaking
//      the smoke (honest BLOCKED-WIRING — note exactly what is missing).
//
// GUARD: CALLS the live engine surfaces (pure_field_step + the new AdaptField
// coupling, both in CORE) — the Ψ field (pure_field_step) is CALLED READ-ONLY
// (never modified). engine_cli_smoke.hexa 12/12 anchor stays unbroken (re-run
// after). p7 metric (real reconstruction distance, NOT perplexity).
//
// SUBSTRATE NOTE (a_core_engine_map): the stream here is an ENGINE-NATIVE drive
// into AdaptField — NOT a .clm (which enters only via generator L3) nor a
// .kosmos (only via kosmos_io). No 2nd artifact entry path is added.

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

// ── deterministic LCG ─────────────────────────────────────────────────────────
fn _lcg(state: int) -> int {
    let next = (state * 1103515245 + 12345) % 2147483648
    if next < 0 { return next + 2147483648 }
    return next
}
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }

// ── non-stationary K-regime stream (novelty grows 1 -> K over time) ───────────
// K regimes appear in sequence: t in [k/K * n, (k+1)/K * n) -> center c_k.
// Centers are spread across [0,1] so each new regime is a NOVEL location the
// substrate has never seen — exactly the H_1159b non-stationary setup.
// Adjacent regimes are spaced REGIME_GAP=1.0 apart (k -> center k.0+0.5), well
// above the engine's SPLIT_THRESH=0.30 — so every new regime is UNAMBIGUOUSLY
// novel to the existing prototypes (a single chasing prototype provably cannot
// cover the next regime). This is the H_1159b non-stationary setup: the gap is
// chosen >> threshold so the falsifier tests adaptation, not a near-threshold
// boundary artifact (frozen pre-registration; construction, not tuned-to-green).
fn _center_at(t: int, n: int, K: int) -> float {
    let mut k = (t * K) / n
    if k >= K { k = K - 1 }
    // centers spaced 1.0 apart: 0.5, 1.5, 2.5, ... (k + 0.5)
    return to_float(k) + 0.5
}

fn _absf(x: float) -> float { if x < 0.0 { return -x } return x }

// ── drive the LIVE engine over the K-regime stream, ONE arm ───────────────────
// Returns [novelty_err, settled_err, final_cells, phi_checksum].
//   novelty_err  = mean live recon-error over the NOVELTY-ONSET window — the
//                  first W_ON=20 steps AFTER each regime boundary, where a NEW
//                  regime has just appeared. This is where adaptation is tested:
//                  the substrate either grows a cell to cover the novel regime
//                  (ON) or eats the full novelty gap with frozen capacity (OFF).
//   settled_err  = mean live recon-error over the SETTLED tail of each regime
//                  block (steps >= W_ON within the block) — steady state.
//   phi_checksum = sum of pure_field.phi over the run (Ψ-trajectory fingerprint)
// The SAME stream + SAME rng schedule is used for both arms (identical input).
fn _run_arm(seed: int, n: int, K: int, max_cells: int, cfg: EngineConfig) -> [float] {
    // the Ψ field (read-only) AND the adaptation substrate run side by side.
    let mut pf = pure_field_new()
    let mut af = adapt_field_new(_center_at(0, n, K), max_cells)

    let mut rng = seed * 2654435761 + 1
    if rng < 0 { rng = -rng }

    let blk = n / K        // steps per regime block
    let w_on = 20          // novelty-onset window after each boundary (frozen)

    let mut nov_sum = 0.0  let mut nov_cnt = 0
    let mut set_sum = 0.0  let mut set_cnt = 0
    let mut phi_sum = 0.0

    let mut t = 0
    while t < n {
        // (Ψ, READ-ONLY) advance the live consciousness field — its zero-input
        // internal dynamics are UNTOUCHED by the coupling; we only OBSERVE Φ.
        pf = pure_field_step(pf)
        phi_sum = phi_sum + pure_field_phi(pf)

        // build the live stream sample (rng schedule identical across arms).
        rng = _lcg(rng)
        let jitter = (_u01(rng) - 0.5) * 0.06
        let sample = _center_at(t, n, K) + jitter

        // (coupling) the engine's OWN reconstruction-error BEFORE this step's
        // update — the live adaptation readout (3).
        let err = adapt_field_recon_err(af, sample)

        // (coupling) advance the adaptation substrate one live tick on `sample`
        // — stream->field input (1) + cell->field mitosis feedback (2), gated cfg.
        af = adapt_field_step(af, sample, cfg)

        // window bucketing by position WITHIN the current regime block.
        let pos = t % blk
        if pos < w_on { nov_sum = nov_sum + err  nov_cnt = nov_cnt + 1 }
        else          { set_sum = set_sum + err  set_cnt = set_cnt + 1 }
        t = t + 1
    }

    let nov = if nov_cnt > 0 { nov_sum / to_float(nov_cnt) } else { 0.0 }
    let set = if set_cnt > 0 { set_sum / to_float(set_cnt) } else { 0.0 }
    return [nov, set, to_float(adapt_field_cells(af)), phi_sum]
}

fn _mean(xs: [float]) -> float {
    if len(xs) == 0 { return 0.0 }
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i] i = i + 1 }
    return s / to_float(len(xs))
}
fn _std(xs: [float]) -> float {
    let m = _mean(xs)
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { let d = xs[i] - m  s = s + d * d  i = i + 1 }
    return sqrt(s / to_float(len(xs)))
}
// pooled-SD Cohen's d (a - b): positive ⇒ a > b.
fn _cohen_d(a: [float], b: [float]) -> float {
    let ma = _mean(a)  let mb = _mean(b)
    let sa = _std(a)   let sb = _std(b)
    let sp = sqrt((sa * sa + sb * sb) / 2.0)
    if sp < 0.0000001 {
        if ma > mb { return 99.0 }
        if ma < mb { return -99.0 }
        return 0.0
    }
    return (ma - mb) / sp
}
fn _fmt(x: float) -> string { return to_string(x) }

fn main() {
    println("=== H_1194 LIVE-ENGINE adaptation-coupling probe (MITOSIS-ENGINE Lane2) ===")
    println("metric: live recon-error = |sample - nearest AdaptField prototype| (p7, NOT perplexity)")
    println("stream: non-stationary K=6-regime (centers 1.0 apart; novelty grows 1->K)")
    println("windows: NOVELTY-ONSET (first 20 steps after each boundary) vs SETTLED (block tail)")
    println("coupling: (1) stream->field input  (2) cell_count->field mitosis feedback  (3) recon-error readout")
    println("Psi: pure_field_step run READ-ONLY alongside; Phi trajectory checksum must be ON==OFF (attractor disjoint)")
    println("falsifier: F1 ADAPT d(OFF_nov - ON_nov)>=0.8 | F2 GROWTH cells ON>OFF & ON_settled<=OFF | F3 Psi byte-identical")
    println("")

    let n = 600
    let K = 6
    let max_cells = 24    // capacity cap (frozen; bounds split, mirrors h1159b cap)
    let seeds = [7, 8, 9]

    let mut on_nov = []  let mut on_set = []  let mut on_cells = []  let mut on_phi = []
    let mut off_nov = [] let mut off_set = [] let mut off_cells = [] let mut off_phi = []
    let mut psi_intact_all = true

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let cfg_on  = engine_cli_parse(["--mitosis", "on"])
        let cfg_off = engine_cli_parse(["--no-mitosis"])

        let ron  = _run_arm(seed, n, K, max_cells, cfg_on)
        let roff = _run_arm(seed, n, K, max_cells, cfg_off)

        on_nov = on_nov + [ron[0]]    on_set = on_set + [ron[1]]
        on_cells = on_cells + [ron[2]]   on_phi = on_phi + [ron[3]]
        off_nov = off_nov + [roff[0]]  off_set = off_set + [roff[1]]
        off_cells = off_cells + [roff[2]] off_phi = off_phi + [roff[3]]

        // F3 per-seed: Ψ Φ-checksum must be byte-identical ON vs OFF (coupling
        // never perturbs the attractor).
        let psi_same = ron[3] == roff[3]
        if !psi_same { psi_intact_all = false }

        println("seed=" + to_string(seed)
            + "  ON  nov=" + _fmt(ron[0]) + " settled=" + _fmt(ron[1]) + " cells=" + _fmt(ron[2])
            + "  phiSum=" + _fmt(ron[3]))
        println("         OFF nov=" + _fmt(roff[0]) + " settled=" + _fmt(roff[1]) + " cells=" + _fmt(roff[2])
            + "  phiSum=" + _fmt(roff[3]) + "  PsiSame=" + (if psi_same { "true" } else { "false" }))
        si = si + 1
    }

    println("")
    // F1 ADAPT-TO-NOVELTY — OFF novelty-err vs ON novelty-err (ON lower ⇒ the live
    // error FELL under novelty because mitosis grew a covering cell). H_1159 control.
    let d_adapt = _cohen_d(off_nov, on_nov)         // positive ⇒ off_nov > on_nov
    let m_on_nov = _mean(on_nov)    let m_off_nov = _mean(off_nov)
    let m_on_set = _mean(on_set)    let m_off_set = _mean(off_set)
    let grew = _mean(on_cells) > _mean(off_cells)
    let settled_ok = m_on_set <= m_off_set + 0.000001   // ON settled no worse than OFF

    println("ON  mean novelty-err=" + _fmt(m_on_nov) + "  settled-err=" + _fmt(m_on_set))
    println("OFF mean novelty-err=" + _fmt(m_off_nov) + "  settled-err=" + _fmt(m_off_set))
    println("cells ON mean=" + _fmt(_mean(on_cells)) + "  OFF mean=" + _fmt(_mean(off_cells)))
    println("")
    println("F1 ADAPT   d(OFF nov - ON nov)     = " + _fmt(d_adapt)  + "  (>=0.8 ⇒ live error FELL under novelty, ON<OFF)")
    println("F2 GROWTH  cells ON>OFF=" + (if grew { "true" } else { "false" })
        + " & ON_settled<=OFF=" + (if settled_ok { "true" } else { "false" }))
    println("F3 Psi     Phi-checksum ON==OFF    = " + (if psi_intact_all { "true (attractor intact)" } else { "false (PERTURBED!)" }))
    println("")

    // ── falsifier adjudication ────────────────────────────────────────────────
    // F3 first: if the coupling perturbed Ψ, the wiring is NOT clean -> HOURGLASS.
    if !psi_intact_all {
        println("VERDICT: HOURGLASS BLOCKED-WIRING — the adaptation coupling PERTURBED the Psi")
        println("  attractor (pure_field Phi trajectory differs ON vs OFF). The coupling is NOT")
        println("  Psi-disjoint; a_core_engine_map forbids perturbing the Psi=1/2 fixed point.")
        println("  WHAT IS MISSING: a coupling that drives a stream->field->error loop WITHOUT")
        println("  touching pure_field. Honest HOURGLASS, the falsifier branch.")
        exit(0)
    }

    let f1 = d_adapt >= 0.8
    let f2 = grew && settled_ok
    if f1 && f2 && psi_intact_all {
        println("VERDICT: GREEN LIVE-ADAPTS — under novelty the live coupling makes recon-error FALL,")
        println("  ON below OFF (F1 d=" + _fmt(d_adapt) + ">=0.8) BECAUSE live engine_mitosis_tick grew")
        println("  covering cells (F2 ON " + _fmt(_mean(on_cells)) + " > OFF " + _fmt(_mean(off_cells))
            + " cells, ON settled no worse), and the Psi attractor is byte-identical")
        println("  ON vs OFF (F3). The stream->field input + cell->field mitosis feedback +")
        println("  recon-error readout are WIRED LIVE; H_1159's ON-vs-OFF adaptation question now")
        println("  has a live answer (p8). UNBLOCKS H_1166/H_1179. toy-scale; live-scale + real")
        println("  corpus UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    println("VERDICT: RED NO-LIVE-ADAPTATION — coupling wired + Psi intact, but "
        + (if !f1 { "recon-error did NOT fall under novelty (F1 d=" + _fmt(d_adapt) + "<0.8)" }
           else { "growth did not drive it (F2: grew=" + (if grew {"T"} else {"F"}) + " settled_ok=" + (if settled_ok {"T"} else {"F"}) + ")" })
        + " (a_paper_negative_ok).")
    exit(0)
}
