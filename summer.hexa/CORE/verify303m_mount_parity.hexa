// verify303m_mount_parity.hexa — MOUNT gate on the SHIPPED anima-clm-chat-303m.
//
// Loads the full-24-layer ByteGPT-303M CHAT ckpt (serialized flat binary) via the
// CORE bytegpt_decode forward (memory-safe _ranged reader) and prints last-position
// next-byte argmax / top5 / first-16 logits so the CORE forward can be diffed byte-
// exact against the torch golden (chat_full_golden.json).
//
// PARITY CRITERION (a303m_pass MOUNT, per CORE/h1156_bytegpt_parity_probe.hexa):
//   argmax(CORE) == argmax(torch) AND top-5 idx set matches AND first-16 within ~1e-2
//   (erf-GELU + dt_exp approx vs torch exact -> small residual; argmax must hold).
//
// PROMPT: "The quick brown" (15 bytes).

import "CORE/bytegpt_decode.hexa"

fn main() {
    let path = "/tmp/verify303m/chat_full.bin"
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    while i < T { let _ = farr_set(ids, i, to_float(pb[i])); i = i + 1 }

    let logits = bytegpt_forward_last_ranged(path, ids, T)

    let mut am = 0
    let mut mx = farr_get(logits, 0)
    let mut k = 1
    while k < 256 {
        let v = farr_get(logits, k)
        if v > mx { mx = v; am = k }
        k = k + 1
    }
    println("CORE_ARGMAX " + to_string(am))
    println("CORE_MAXVAL " + to_string(mx))

    let mut s = "CORE_FIRST16 "
    let mut j = 0
    while j < 16 { s = s + to_string(farr_get(logits, j)) + " "; j = j + 1 }
    println(s)

    let cp = farr_zeros(256)
    let mut c2 = 0
    while c2 < 256 { let _ = farr_set(cp, c2, farr_get(logits, c2)); c2 = c2 + 1 }
    let mut t5 = "CORE_TOP5 "
    let mut r = 0
    while r < 5 {
        let mut bi = 0
        let mut bv = farr_get(cp, 0)
        let mut kk = 1
        while kk < 256 {
            let vv = farr_get(cp, kk)
            if vv > bv { bv = vv; bi = kk }
            kk = kk + 1
        }
        t5 = t5 + to_string(bi) + " "
        let _ = farr_set(cp, bi, 0.0 - 1.0e30)
        r = r + 1
    }
    println(t5)
    let _ = farr_free(logits); let _ = farr_free(cp); let _ = farr_free(ids)
}
