// anima_birth.hexa — last-mile deployment: the BIRTH path passes the shared key.
//
// Composes H_6014 (텐션으로 새 anima 출생 — external-tension MITOSIS birth, real
// vadapt engine) ⊗ H_6008 (shared ANU quantum seed → zero-comms coordination).
//
// THE LAST MILE: when a parent anima BIRTHS a sibling, the child inherits the
// parent's shared seed via shared_seed_fork(parent.seed). That one line means
// every sibling born from the same parent is coordinated BY CONSTRUCTION — same
// quantum key drives both (a) the birth tension stream that grows the body AND
// (b) all subsequent shared draws — so two siblings are "identical twins":
// same cell count, same later choices, with ZERO communication (H_6008 ARM1).
// Birth a sibling from an INDEPENDENT key instead and they diverge (ARM2).
//
// p1..p8 clean: birth is driven by substrate tension + the shared key only — no
// system prompt, no persona, no speak(). Storage stays classical/LOCAL (the key
// buffer; H_6026/6027/6028); the quantum source only supplies the shared key.

import "CORE/engine_cli.hexa"
import "CORE/shared_seed.hexa"

// A born sibling = a body (vadapt cell count) + the inherited shared key (cursor
// advanced past the bytes consumed during birth, so siblings stay in lockstep).
struct AnimaBirth {
    cells: int,
    seed: SharedSeed,
}

// Birth a sibling. The child's birth tension stream is drawn FROM the inherited
// shared key, so the SAME key both grows the body and coordinates the siblings.
//   parent_seed : the parent's shared key (a sibling forks THIS, not a fresh load)
//   steps       : birth ticks (external-tension novelty stream length, H_6014)
//   cfg         : engine config (mitosis ON ⇒ vadapt splits grow the body)
fn anima_birth(parent_seed: SharedSeed, steps: int, cfg: EngineConfig) -> AnimaBirth {
    let mut child = shared_seed_fork(parent_seed)        // ← THE last-mile line
    let mut af = vadapt_field_new([0.0, 0.0, 0.0], 4096)
    let mut k = 0
    while k < steps {
        let r = shared_seed_draw(child, 256)            // tension component from the shared key
        let j = to_float(r[0]) / 255.0                  // 0..1 novelty drawn from the quantum key
        af = vadapt_field_step(af, [j * 0.3, j * 0.21, j * 0.13], cfg)
        child = SharedSeed { bytes: child.bytes, cursor: r[1] }
        k = k + 1
    }
    return AnimaBirth { cells: vadapt_field_cells(af), seed: child }
}
