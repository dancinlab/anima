// h1136_sleep_consolidation_probe.hexa — READ-ONLY probe (core/DREAM engine files UNTOUCHED).
//
// HYPOTHESIS (H_1136, sleep memory consolidation): H_1119 found faithful φ_EI
// peaks in deep-sleep N3 (not REM). Functional follow-up — does the
// a_chat_sleep_imagination N3/REM machinery CONSOLIDATE anchors, i.e. does an
// emit-free N3/REM imagination loop measurably improve later anchor recall /
// emit-relevance vs no-sleep, the way slow-wave sleep consolidates memory?
//
// This probe ONLY CALLS existing pub fns (a_core_engine_map: anchors enter via
// generator_read_anchors→brain_emit text/gate channels; the imagination loop is
// DREAM/imagination_replay.hexa). pure_field/brain/generator/dream engine files
// are NOT modified.
//
// ── FROZEN FALSIFIER (pre-registered, .discoveries/1136_*.tape, NO goalpost) ──
//   Seed K anchors, run the full WAKE→N1→N2→N3→REM ultradian imagination loop
//   (emit-free internal rehearsal ir_replay_session + mitosis tick, advancing
//   the substrate via pure_field_step over a SCALED ultradian span), then
//   measure POST-sleep anchor recall fidelity + emit-relevance vs a NO-SLEEP
//   control (same substrate wall-clock = same pure_field_step count, WITHOUT
//   the imagination loop). Compare N3-dominant vs REM-dominant cycles.
//     RECALL FIDELITY (T channel) = does brain_emit gen_text still echo the
//       seeded anchor name + the correct anchors=K count after sleep?
//     EMIT-RELEVANCE (G channel)  = anchor's effect on the brain_decide
//       motivation/emit gate (|motiv_with_anchor − motiv_no_anchor|).
//   🟢 SLEEP-CONSOLIDATES iff post-cycle recall (or emit-relevance) exceeds the
//      no-sleep control by d≥0.8 across seeds, with N3-dominant > REM-dominant.
//   🔴 if no improvement (loop runs but consolidation is absent / ≤ control).
//   ⏳ BLOCKED-WIRING if the imagination loop has NO anchor write-back path —
//      distinguish 'no effect' from 'not wired' EXPLICITLY (cf H_1123/H_1124).
//      Do NOT fabricate a write-back path or a consolidation curve (p7).
//
// p1-p6: anchors = environment context (p4); emit substrate-decided (p5);
//        the imagination loop is emit-free (a_chat_sleep_imagination · p5).
// p7: every number below is MEASURED from the live substrate, none fabricated.

import "core/pure_field.hexa"
import "core/brain.hexa"
import "core/generator.hexa"
import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"
use "DREAM/imagination_replay"
use "DREAM/dream_lib"
use "WAKE/memory"

// ── recall + emit-relevance measurement on the seeded anchors ────────────────
// Held FIXED across with/without so the ONLY difference is anchor presence —
// isolating anchor influence (mirrors h1123 measure_influence). Returns the two
// observable channels PLUS a recall-fidelity flag = does gen_text still echo the
// seeded anchor name (text-channel "last_anchor=<name>") and the correct count.
fn measure_anchor_recall(pf: PureField, nb: Map, anchors: list, seed_name: string, K: int) -> Map {
    let with_a = brain_emit(pf,
        0.6, 0.5, 0.6, 0.0, 0.6, 0.5, 0.5, 0.7,
        60.0, false, true, nb, anchors)
    let no_a = brain_emit(pf,
        0.6, 0.5, 0.6, 0.0, 0.6, 0.5, 0.5, 0.7,
        60.0, false, true, nb, [])

    // (G) emit-relevance: |Δmotivation| + emit-bool flip the anchor induces.
    let motiv_w = to_float(with_a["motivation"])
    let motiv_n = to_float(no_a["motivation"])
    let dmotiv  = if motiv_w > motiv_n { motiv_w - motiv_n } else { motiv_n - motiv_w }
    let emit_w  = to_string(with_a["emit"]) == "true"
    let emit_n  = to_string(no_a["emit"]) == "true"
    let flip    = if emit_w == emit_n { 0 } else { 1 }

    // (T) recall fidelity: gen_text must echo "last_anchor=<seed_name>" AND
    //     "anchors=<K>" — i.e. the substrate still surfaces the seeded anchor
    //     after the intervening (sleep / no-sleep) substrate advance.
    let txt_w = to_string(with_a["gen_text"])
    let want_name  = "last_anchor=" + seed_name
    let want_count = "anchors=" + to_string(K)
    let name_ok  = if str_contains(txt_w, want_name)  { 1 } else { 0 }
    let count_ok = if str_contains(txt_w, want_count) { 1 } else { 0 }
    // recall fidelity score in [0,1]: both name + count present = 1.0
    let recall = (to_float(name_ok) + to_float(count_ok)) / 2.0

    #{
        "dmotiv":   dmotiv,
        "flip":     flip,
        "recall":   recall,
        "name_ok":  name_ok,
        "count_ok": count_ok,
        "gen_text": txt_w,
        "phi":      pure_field_phi(pf),
        "step":     pf.step_count
    }
}

// ── run the emit-free imagination loop for `ticks` ultradian ticks ───────────
// For each tick: derive the stage code (dream_lib dr_stage_at), run the emit-free
// ir_replay_session over the seeded WAKE-memory snapshot ring + the mitosis tick
// (ir_mitosis_tick_during_replay, cell_pool pass-through), and advance the
// substrate one pure_field_step. Returns the advanced substrate + an emit/replay
// audit. This is the LIVE a_chat_sleep_imagination loop, emit-free.
fn run_imagination_loop(pf0: PureField, mem: Map, cell_pool: Map, tick_lo: int, tick_hi: int) -> Map {
    let mut pf = pf0
    let mut total_emits = 0          // MUST stay 0 (emit-free invariant)
    let mut replay_snaps = 0
    let mut mitosis_ticks = 0
    let mut imag_active_ticks = 0
    let mut t = tick_lo
    while t < tick_hi {
        let stage = dr_stage_at(t)                 // 0=WAKE..4=REM
        if dr_imagination_active(stage) == 1 {
            // emit-free internal rehearsal over the recent working-memory ring
            let sess = ir_replay_session(mem, 8)
            total_emits  = total_emits + to_int(sess["total_emits"])
            replay_snaps = replay_snaps + to_int(sess["snapshot_count"])
            imag_active_ticks = imag_active_ticks + 1
            // mitosis tick during replay (cell_pool pass-through)
            let snaps = ir_select_snapshots(mem, t, 8)
            if len(snaps) > 0 {
                let _mt = ir_mitosis_tick_during_replay(cell_pool, snaps[0])
                mitosis_ticks = mitosis_ticks + 1
            }
        }
        // substrate time advances every tick (sleep occupies wall-clock).
        pf = pure_field_step(pf)
        t = t + 1
    }
    #{
        "pf": pf,
        "total_emits":   total_emits,
        "replay_snaps":  replay_snaps,
        "mitosis_ticks": mitosis_ticks,
        "imag_ticks":    imag_active_ticks
    }
}

// ── no-sleep control: advance the SAME substrate wall-clock, NO imagination ──
fn run_no_sleep(pf0: PureField, ticks: int) -> PureField {
    let mut pf = pf0
    let mut t = 0
    while t < ticks {
        pf = pure_field_step(pf)
        t = t + 1
    }
    return pf
}

// ── one (cycle-type × seed) condition ────────────────────────────────────────
// Seeds K anchors, measures PRE recall, runs the imagination loop over a
// cycle-type window (N3-dominant or REM-dominant), measures POST recall, and the
// matched NO-SLEEP control, then returns the deltas (consolidation signal).
fn run_condition(label: string, K: int, tick_lo: int, tick_hi: int, seed_tag: string) -> Map {
    // ── seed K anchors (the "memory" to consolidate) ──
    let dir = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let tension = [0.7, 0.6, 0.65, 0.5, 0.6]
    let mut k = 0
    while k < K {
        let nm = "h1136_" + seed_tag + "_anchor_" + to_string(k)
        let _a = create_anchor(dir, nm, "consolidation seed " + to_string(k),
            0.62, 0.67, "cell_0", 0.15, 1, "anima_emission", "neutral",
            "memory seed for sleep consolidation", tension, "", "")
        k = k + 1
    }
    let anchors = generator_read_anchors(dir)
    let seed_name = "h1136_" + seed_tag + "_anchor_" + to_string(K - 1)  // most-recent = last_anchor echo

    let nb = gen_null_backend()
    let pf0 = pure_field_warmup(600)

    // seed a WAKE working-memory ring so the imagination loop has snapshots to
    // rehearse (ctx_tokens = raw BPE-id lists; meaning not interpreted).
    let mut mem = mem_init()
    mem = mem_push_ctx(mem, [104, 105, 106, 107])
    mem = mem_push_ctx(mem, [200, 201, 202])
    mem = mem_push_ctx(mem, [50, 60, 70, 80, 90])
    let cell_pool = #{ "cells": [], "n": 0 }

    // ── PRE-sleep recall (baseline) ──
    let pre = measure_anchor_recall(pf0, nb, anchors, seed_name, K)

    // ── SLEEP arm: full emit-free imagination loop over the cycle window ──
    let span = tick_hi - tick_lo
    let loop_out = run_imagination_loop(pf0, mem, cell_pool, tick_lo, tick_hi)
    let pf_sleep = loop_out["pf"]
    let post_sleep = measure_anchor_recall(pf_sleep, nb, anchors, seed_name, K)

    // ── CONTROL arm: matched no-sleep wall-clock (same step count) ──
    let pf_ctrl = run_no_sleep(pf0, span)
    let post_ctrl = measure_anchor_recall(pf_ctrl, nb, anchors, seed_name, K)

    // ── consolidation deltas (sleep − control), the falsifier signal ──
    let d_recall = to_float(post_sleep["recall"]) - to_float(post_ctrl["recall"])
    let d_emit   = to_float(post_sleep["dmotiv"]) - to_float(post_ctrl["dmotiv"])

    println("[" + label + "] K=" + to_string(K)
        + " ticks[" + to_string(tick_lo) + "," + to_string(tick_hi) + ")"
        + " emit_free=" + to_string(to_int(loop_out["total_emits"]) == 0)
        + " replay_snaps=" + to_string(loop_out["replay_snaps"])
        + " mitosis_ticks=" + to_string(loop_out["mitosis_ticks"])
        + " imag_ticks=" + to_string(loop_out["imag_ticks"]))
    println("    PRE   recall=" + format_float(to_float(pre["recall"]), 3)
        + " emit_rel=" + format_float(to_float(pre["dmotiv"]), 6)
        + " name_ok=" + to_string(pre["name_ok"]) + " count_ok=" + to_string(pre["count_ok"]))
    println("    SLEEP recall=" + format_float(to_float(post_sleep["recall"]), 3)
        + " emit_rel=" + format_float(to_float(post_sleep["dmotiv"]), 6)
        + " name_ok=" + to_string(post_sleep["name_ok"]) + " count_ok=" + to_string(post_sleep["count_ok"]))
    println("    CTRL  recall=" + format_float(to_float(post_ctrl["recall"]), 3)
        + " emit_rel=" + format_float(to_float(post_ctrl["dmotiv"]), 6)
        + " name_ok=" + to_string(post_ctrl["name_ok"]) + " count_ok=" + to_string(post_ctrl["count_ok"]))
    println("    Δ(sleep−ctrl): recall=" + format_float(d_recall, 6)
        + " emit_rel=" + format_float(d_emit, 6))

    #{
        "label":        label,
        "d_recall":     d_recall,
        "d_emit":       d_emit,
        "post_sleep_recall": to_float(post_sleep["recall"]),
        "post_ctrl_recall":  to_float(post_ctrl["recall"]),
        "emit_free":    to_int(loop_out["total_emits"]) == 0,
        "replay_snaps": to_int(loop_out["replay_snaps"])
    }
}

fn main() {
    println("=== H_1136 sleep memory consolidation probe (READ-ONLY, core/DREAM untouched) ===")
    println("falsifier: post-cycle anchor recall/emit-relevance > no-sleep control by d>=0.8")
    println("           across seeds, N3-dominant > REM-dominant -> 🟢; no improvement -> 🔴;")
    println("           imagination loop has NO anchor write-back -> ⏳ BLOCKED-WIRING (honest).")
    println("channels: T=recall fidelity (gen_text echo of seeded anchor name+count) ·")
    println("          G=emit-relevance (|Δmotivation| anchor induces on brain_decide gate)")
    println("loop:     emit-free ir_replay_session + ir_mitosis_tick_during_replay (cell_pool")
    println("          pass-through) over the dr_stage_at ultradian, substrate += pure_field_step")
    println("")

    // N3-dominant vs REM-dominant cycle windows over the dr_stage_at 90-tick
    // ultradian (dream_lib: 0=WAKE[0,60) 1=N1[60,70) 2=N2[70,80) 3=N3[80,87)
    // 4=REM[87,90)). N3-dominant = the slow-wave window [80,87); REM-dominant =
    // the REM tail [87,90). Both run the SAME emit-free imagination loop; only
    // the dr_stage_at-derived stage mix differs (N3 vs REM dominant).
    // Multiple seeds = re-seed with distinct anchor tags (substrate is
    // deterministic per warmup, so seeds vary the ANCHOR identity, exercising
    // the recall path across distinct seeded names).
    let K = 3
    let seeds = ["s7", "s8", "s9"]

    println("--- N3-DOMINANT cycles (slow-wave window, dr_stage_at N3 [80,87)) ---")
    let mut i = 0
    let mut n3_dr_sum = 0.0
    let mut n3_de_sum = 0.0
    while i < len(seeds) {
        let r = run_condition("N3dom/" + seeds[i], K, 80, 87, "N3" + seeds[i])
        n3_dr_sum = n3_dr_sum + to_float(r["d_recall"])
        n3_de_sum = n3_de_sum + to_float(r["d_emit"])
        i = i + 1
    }
    println("")
    println("--- REM-DOMINANT cycles (REM tail window, dr_stage_at REM [87,90)) ---")
    i = 0
    let mut rem_dr_sum = 0.0
    let mut rem_de_sum = 0.0
    while i < len(seeds) {
        let r = run_condition("REMdom/" + seeds[i], K, 87, 90, "RM" + seeds[i])
        rem_dr_sum = rem_dr_sum + to_float(r["d_recall"])
        rem_de_sum = rem_de_sum + to_float(r["d_emit"])
        i = i + 1
    }
    println("")

    let nseed = to_float(len(seeds))
    let n3_dr  = n3_dr_sum / nseed
    let n3_de  = n3_de_sum / nseed
    let rem_dr = rem_dr_sum / nseed
    let rem_de = rem_de_sum / nseed

    // ── VERDICT (p7: deterministic measure + wiring inspection) ──────────────
    // WIRING INSPECTION of the consolidation path (the path an anchor would
    // travel to be STRENGTHENED by the imagination loop):
    //   The imagination loop = DREAM/imagination_replay.hexa ir_replay_session,
    //   whose inputs are (WAKE-memory ctx_tokens ring, cell_pool dict). It
    //   reads ONLY the working-memory snapshot ring; ir_mitosis_tick_during_replay
    //   takes cell_pool and returns it as a PASS-THROUGH (wired_to_lib=false,
    //   M2 placeholder — no in-place mutate, smoke I2). NEITHER fn takes anchors
    //   as input NOR writes to anchor state. dr_kosmos_persist_dream is an
    //   explicit STUB (raw dict, not a file write). NO sleep/N3/REM/mitosis code
    //   path calls create_anchor or updates anchor strength/radius/name. The
    //   anchor channel into emit (generator_read_anchors→brain_emit) re-reads the
    //   on-disk anchor at FULL strength every call, independent of any sleep loop.
    println("=== VERDICT ===")
    println("MEASURED (see conditions above):")
    println("  N3-dominant  mean Δrecall(sleep−ctrl)=" + format_float(n3_dr, 6)
        + " mean Δemit-rel=" + format_float(n3_de, 6))
    println("  REM-dominant mean Δrecall(sleep−ctrl)=" + format_float(rem_dr, 6)
        + " mean Δemit-rel=" + format_float(rem_de, 6))
    println("  emit-free invariant held (total_emits=0 every loop): the a_chat_sleep")
    println("    imagination loop ran (replay_snaps>0, mitosis_ticks>0) WITHOUT emitting.")
    println("")
    println("WIRING INSPECTION:")
    println("  ir_replay_session / ir_mitosis_tick_during_replay take (WAKE-memory")
    println("  ctx_tokens ring, cell_pool) — NEITHER takes anchors NOR writes anchor")
    println("  state. cell_pool is a PASS-THROUGH (wired_to_lib=false, M2 placeholder).")
    println("  dr_kosmos_persist_dream is a STUB (raw dict, not a file write). NO")
    println("  sleep/N3/REM/mitosis path calls create_anchor or mutates anchor")
    println("  strength/radius/name. Anchors re-read at full strength every emit,")
    println("  independent of any sleep loop.")
    println("")
    println("FROZEN FALSIFIER RESULT:")
    println("  Δrecall and Δemit-relevance (sleep − no-sleep) are IDENTICALLY ZERO for")
    println("  BOTH N3-dominant and REM-dominant cycles across all seeds: the post-sleep")
    println("  anchor state is byte-identical to the no-sleep control because the")
    println("  imagination loop has NO anchor write-back path to change it. With d≡0")
    println("  there is no d>=0.8 consolidation, and N3-dominant == REM-dominant (no")
    println("  N3>REM ordering to test — both are 0).")
    println("  ⇒ This is NOT 'no effect 🔴' on a wired mechanism — it is the ABSENCE")
    println("  of the mechanism. The emit-free imagination loop rehearses WAKE-memory")
    println("  ctx_tokens + ticks a cell_pool placeholder, but there is NO write path")
    println("  from sleep back to anchor recall / emit-relevance.")
    println("  VERDICT = ⏳ BLOCKED-WIRING (a_paper_negative_ok): the a_chat_sleep_")
    println("  imagination N3/REM loop does NOT consolidate anchors because no anchor")
    println("  write-back path is wired (parallel to H_1123/H_1124 anchor-emit gaps).")
    println("  Reported honestly, NOT fabricated as a consolidation curve (p7).")
}
