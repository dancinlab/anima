// h1166_live_adaptation_probe.hexa — H_1166 LIVE-ENGINE adaptation probe.
//
// DOMAIN: MITOSIS-ENGINE · Next rung #1 (the live-engine adaptation curve).
//
// QUESTION (the open rung H_1159/H_1159b left): those two results proxied
// inference-time mitosis with a TOY numpy k-means split. The domain's open rung
// is to drive the LIVE CORE engine (core/engine_cli.hexa engine_mitosis_tick +
// core/pure_field.hexa pure_field_step) over a NON-STATIONARY input stream and
// measure ADAPTATION — does the live engine's error/tension FALL as it adapts to
// new regimes (p8 NO TRAIN/INFER SPLIT) — not just cell-count growth — confirming
// the toy H_1159 ADVANTAGE on the REAL substrate.
//
// FROZEN FALSIFIER (pre-registered, deterministic >=3 seeds, live CORE, g5/p7):
//   GREEN LIVE-ADAPTS iff, on a non-stationary stream (new regimes appearing over
//      time), the live engine WITH mitosis ON shows a NON-RISING adaptation metric
//      (error/tension falls or holds as novelty grows) while mitosis OFF RISES,
//      Cohen's d >= 0.8 (ON beats OFF) — confirming H_1159's toy result live.
//   RED if the live engine does NOT adapt (ON ties or loses to OFF) — toy<->live
//      mismatch (honest, a_paper_negative_ok).
//   HOURGLASS if the live engine exposes NO usable adaptation/error signal to
//      measure (honest — note exactly what is missing).
//
// GUARD: READ-ONLY probe — it imports and CALLS the live engine surfaces
// (pure_field_step, engine_mitosis_tick, engine_cli_parse) but does NOT modify
// the engine. The engine_cli_smoke.hexa 12/12 anchor stays unbroken (re-run
// separately to confirm). p7 substrate-native metric, NOT perplexity.
//
// ── WHAT THIS PROBE MEASURES (the honest adaptation surface of the LIVE engine) ─
//
// The toy H_1159 measured a CLUSTERING RECONSTRUCTION ERROR (distance from each
// stream point to its nearest prototype cell) and showed it FELL for mitosis-ON
// as new clusters appeared. To confirm that LIVE we need the same shape on the
// real substrate: a per-step ADAPTATION METRIC the engine actually exposes, that
// ON can lower and OFF cannot.
//
// The live engine's real per-step surfaces are:
//   · pure_field_step(pf) -> phi / narrative_coherence   (internal field state)
//   · engine_mitosis_tick(cell_count, cfg) -> cell_count (the gated GROWTH tick)
// We drive BOTH over the SAME non-stationary stream, ON vs OFF, and read the
// engine's OWN coherence signal as the adaptation metric (higher coherence = the
// field has settled = lower "error"; we report 1 - coherence as a falling-good
// error so it lines up with H_1159's error-falls framing).
//
// CRUCIAL HONEST NOTE (what is actually wired — a_core_engine_map, no phantom):
//   The CORE field step (pure_field_step) is a ZERO-INPUT internal oscillator
//   loop (core/pure_field.hexa "advance field by one tick (zero external
//   input)"). It does NOT take a stream sample, and engine_mitosis_tick's
//   cell_count is NOT fed back into pure_field. So the field/coherence trajectory
//   is determined by the oscillators ALONE and is provably IDENTICAL whether
//   mitosis is ON or OFF. The probe MEASURES this directly (it does not assume
//   it): it runs the live engine ON and OFF over the SAME non-stationary stream
//   and compares the engine's own coherence-error trajectory. If ON==OFF the
//   live engine exposes NO adaptation signal that mitosis can move ⇒ the honest
//   verdict is HOURGLASS NO-SIGNAL (the toy<->live coupling is UNBUILT), exactly
//   the falsifier's HOURGLASS branch — NOT a fabricated GREEN nor a RED mismatch.

import "core/pure_field.hexa"
import "core/engine_cli.hexa"

// ── deterministic LCG (no external entropy — fully reproducible per seed) ─────
fn _lcg(state: int) -> int {
    let next = (state * 1103515245 + 12345) % 2147483648
    if next < 0 { return next + 2147483648 }
    return next
}
fn _u01(state: int) -> float {
    return to_float(state) / 2147483648.0
}

// ── non-stationary stream: K regimes appear over time ─────────────────────────
// length-N stream split into REGIMES; a new regime "appears" every N/K steps
// (novelty grows over time, like H_1159's clusters 2->5). Regime r carries a
// target center c_r in [0,1]; the stream sample = center(regime(t)) + jitter.
fn _regime_of(t: int, n: int, k: int) -> int {
    let per = n / k
    let mut r = t / per
    if r >= k { r = k - 1 }
    return r
}
fn _regime_center(r: int, k: int) -> float {
    return (to_float(r) + 0.5) / to_float(k)
}

// ── drive the LIVE engine over the non-stationary stream, ONE arm ─────────────
// Per step t: (1) pure_field_step (real engine tick) (2) engine_mitosis_tick
// (gated growth) (3) read coherence-error = 1 - narrative_coherence. Accumulate
// over the LATE window (second half, where novelty has grown to K regimes).
// Returns [late_mean_error, final_cell_count].
fn _run_arm(seed: int, n: int, k: int, cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    let mut cells = 3                 // seed cell count (matches H_1159 seed=3)
    let mut rng = seed * 2654435761 + 1
    if rng < 0 { rng = -rng }

    let mut late_err_sum = 0.0
    let mut late_cnt = 0
    let half = n / 2

    let mut t = 0
    while t < n {
        // (1) LIVE field step — the real CORE engine tick (zero-input internal).
        pf = pure_field_step(pf)

        // (2) LIVE growth tick — gated on cfg.mitosis (ON=+1 cell, OFF=no-op).
        cells = engine_mitosis_tick(cells, cfg)

        // build the stream sample (drives rng so both arms see the IDENTICAL
        // stream; the field ignores it by construction).
        rng = _lcg(rng)
        let jitter = (_u01(rng) - 0.5) * 0.10
        let r = _regime_of(t, n, k)
        let _sample = _regime_center(r, k) + jitter   // the non-stationary input

        // (3) the engine's OWN adaptation metric: coherence-error = 1 - coherence.
        let coh = pf.narrative_coherence
        let coh_err = 1.0 - coh

        if t >= half {
            late_err_sum = late_err_sum + coh_err
            late_cnt = late_cnt + 1
        }
        t = t + 1
    }

    let late_mean = if late_cnt > 0 { late_err_sum / to_float(late_cnt) } else { 0.0 }
    return [late_mean, to_float(cells)]
}

// ── Cohen's d over the per-seed late-error samples (ON vs OFF) ─────────────────
fn _mean(xs: [float]) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(xs) { s = s + xs[i] i = i + 1 }
    return s / to_float(len(xs))
}
fn _std(xs: [float], m: float) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(xs) { let d = xs[i] - m s = s + d * d i = i + 1 }
    let v = s / to_float(len(xs))
    return sqrt(v)
}
fn _cohen_d(a: [float], b: [float]) -> float {
    // d = (mean_b - mean_a) / pooled_sd. POSITIVE means b > a (OFF-err > ON-err
    // = ON beats OFF, the GREEN direction when a=ON, b=OFF).
    let ma = _mean(a)
    let mb = _mean(b)
    let sa = _std(a, ma)
    let sb = _std(b, mb)
    let pooled = sqrt((sa * sa + sb * sb) / 2.0)
    if pooled < 0.000001 { return 0.0 }
    return (mb - ma) / pooled
}

fn _fmt(x: float) -> string { return to_string(x) }

fn main() {
    println("=== H_1166 LIVE-ENGINE adaptation probe (MITOSIS-ENGINE rung #1) ===")
    println("metric: engine-OWN coherence-error = 1 - pure_field.narrative_coherence (late-window mean)")
    println("stream: non-stationary, K regimes appear over time (novelty 1->K); ON vs OFF over IDENTICAL stream")
    println("")

    let n = 600        // stream length
    let k = 5          // regimes (matches H_1159 final cluster count)
    let seeds = [7, 8, 9]

    let mut on_errs = []
    let mut off_errs = []
    let mut on_cells = []
    let mut off_cells = []

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let cfg_on  = engine_cli_parse(["--mitosis", "on"])
        let cfg_off = engine_cli_parse(["--no-mitosis"])

        let ron  = _run_arm(seed, n, k, cfg_on)
        let roff = _run_arm(seed, n, k, cfg_off)

        on_errs  = on_errs  + [ron[0]]
        off_errs = off_errs + [roff[0]]
        on_cells  = on_cells  + [ron[1]]
        off_cells = off_cells + [roff[1]]

        println("seed=" + to_string(seed)
            + "  ON  late_err=" + _fmt(ron[0])  + " cells=" + _fmt(ron[1])
            + "  | OFF late_err=" + _fmt(roff[0]) + " cells=" + _fmt(roff[1])
            + "  | ON-OFF err diff=" + _fmt(roff[0] - ron[0]))
        si = si + 1
    }

    println("")
    let m_on  = _mean(on_errs)
    let m_off = _mean(off_errs)
    let d = _cohen_d(on_errs, off_errs)   // +d => OFF-err > ON-err => ON beats OFF
    println("late_err  ON mean=" + _fmt(m_on) + "  OFF mean=" + _fmt(m_off))
    println("cells     ON mean=" + _fmt(_mean(on_cells)) + "  OFF mean=" + _fmt(_mean(off_cells)))
    println("Cohen's d (ON beats OFF, +=ON better) = " + _fmt(d))
    println("")

    // ── falsifier adjudication ───────────────────────────────────────────────
    let err_diff = m_off - m_on
    let err_diff_abs = if err_diff < 0.0 { -err_diff } else { err_diff }
    let SIGNAL_EPS = 0.000001            // below this, ON and OFF are identical.

    // GROWTH sanity: the live mitosis tick DID fire ON, not OFF.
    let grew = _mean(on_cells) > _mean(off_cells)
    println("sanity: live engine_mitosis_tick grew cells ON>OFF = "
        + (if grew { "true" } else { "false" })
        + " (ON " + _fmt(_mean(on_cells)) + " vs OFF " + _fmt(_mean(off_cells)) + ")")

    println("")
    if err_diff_abs < SIGNAL_EPS {
        // ON and OFF coherence-error are IDENTICAL -> engine exposes NO adaptation
        // signal that mitosis can move. The falsifier's HOURGLASS branch.
        println("VERDICT: HOURGLASS NO-ADAPTATION-SIGNAL (live engine exposes no usable")
        println("  error/tension metric coupled to the stream OR to the mitosis cell count).")
        println("  WHAT IS MISSING: pure_field_step is ZERO-INPUT (core/pure_field.hexa)")
        println("  — it advances internal oscillators ONLY and ignores the stream sample; and")
        println("  engine_mitosis_tick's cell_count is NOT fed back into pure_field. So the")
        println("  field/coherence trajectory is IDENTICAL ON vs OFF (err diff="
            + _fmt(err_diff_abs) + " < eps). The live engine GROWS cells (mitosis fires) but")
        println("  that growth has NO wired effect on any adaptation/error metric. The toy")
        println("  H_1159 clustering-reconstruction-error has NO live counterpart yet: the")
        println("  cell-count -> field -> error coupling is UNBUILT (a_core_engine_map).")
        println("  CANNOT adjudicate GREEN vs RED live — honest HOURGLASS, the falsifier branch.")
        exit(0)
    }

    if d >= 0.8 {
        println("VERDICT: GREEN LIVE-ADAPTS — ON adaptation-error below OFF, Cohen's d="
            + _fmt(d) + " >= 0.8 (confirms H_1159 toy result on the LIVE substrate).")
        exit(0)
    }

    println("VERDICT: RED NO-LIVE-ADVANTAGE — mitosis ON ties/loses to OFF on the live")
    println("  adaptation metric (d=" + _fmt(d) + " < 0.8). Toy<->live MISMATCH (a_paper_negative_ok).")
    exit(0)
}
