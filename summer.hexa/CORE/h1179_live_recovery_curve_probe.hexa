// h1179_live_recovery_curve_probe.hexa — H_1179 LIVE-ENGINE recovery-curve probe.
//
// DOMAIN: MITOSIS-ENGINE · Lane1 rung — the live-engine ADAPTATION RECOVERY CURVE.
//
// QUESTION (the open rung past H_1166): H_1166 asked "does mitosis-ON lower the
// late-window error vs OFF" and found HOURGLASS (field is zero-input, ON==OFF).
// H_1179 sharpens to a DIFFERENT, stronger signature of live adaptation: drive
// the LIVE CORE engine over a stream that SHIFTS REGIME at a single known point
// mid-stream, and ask for a RECOVERY CURVE — does the engine's own adaptation
// metric (coherence-error) SPIKE at the shift then DECAY back toward the
// pre-shift baseline, the way a system that ACTUALLY adapts to novelty would?
// (NOT cell-count growth; the curve SHAPE around a regime boundary, p8/p7.)
//
// FROZEN FALSIFIER (pre-registered, deterministic >=3 seeds, live CORE, g5/p7):
//   GREEN LIVE-RECOVERS iff, on a mid-stream regime shift, the live engine's
//      coherence-error (1 - narrative_coherence)
//        (a) SPIKES at the shift: post-shift window-1 error > pre-shift baseline
//            by Cohen's d >= 0.8 (a real perturbation lands), AND
//        (b) RECOVERS: post-shift window-2 error returns toward baseline, with a
//            recovery ratio rr = (spike - settle)/(spike - baseline) >= 0.50, AND
//        (c) CONTROL: a frozen NO-MITOSIS arm does NOT recover (rr_off < rr_on by
//            d >= 0.8) — anti-Goodhart, recovery must be mitosis-attributable.
//   RED if the live engine SPIKES but does NOT recover (rr < 0.50) OR recovery is
//      not mitosis-attributable (control recovers equally) — toy<->live mismatch
//      or non-adaptive transient (honest, a_paper_negative_ok).
//   HOURGLASS if the live engine exposes NO usable recovery signal — i.e. the
//      regime shift produces NO spike at all (the stream never reaches the field),
//      so there is nothing to recover FROM. Honest BLOCKED-WIRING, note exactly
//      what is missing (cf H_1123, H_1166).
//
// GUARD: READ-ONLY probe — imports + CALLS the live engine surfaces
// (pure_field_step, engine_mitosis_tick, engine_cli_parse) but does NOT modify
// the engine. engine_cli_smoke.hexa 12/12 anchor stays unbroken. p7 metric.
//
// HONEST PREDICTION (a_core_engine_map — what is wired): pure_field_step is a
// ZERO-INPUT internal oscillator (core/pure_field.hexa L193 "advance field by one
// tick (zero external input)"); narrative_coherence is an EMA of phase-stability
// of the field's OWN dynamics, not of any stream sample. engine_mitosis_tick's
// cell_count is NOT fed back into pure_field. So the regime shift in the stream
// CANNOT perturb the live coherence-error: spike(a) is predicted to FAIL ->
// HOURGLASS. The probe MEASURES this directly (does not assume it) by computing
// the actual spike magnitude at the shift vs the baseline; if it is ~0 the
// honest verdict is the falsifier's HOURGLASS branch, NOT a fabricated result.

import "core/pure_field.hexa"
import "core/engine_cli.hexa"

// ── deterministic LCG ─────────────────────────────────────────────────────────
fn _lcg(state: int) -> int {
    let next = (state * 1103515245 + 12345) % 2147483648
    if next < 0 { return next + 2147483648 }
    return next
}
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }

// ── stream with a SINGLE mid-stream regime shift ──────────────────────────────
// First half: regime A (center cA). Second half: regime B (center cB, a large
// jump). The shift is at t = n/2. Sample = center + jitter.
fn _center_at(t: int, n: int, cA: float, cB: float) -> float {
    if t < n / 2 { return cA }
    return cB
}

// ── windows around the shift (frozen) ─────────────────────────────────────────
// baseline  = mean coherence-error over [half-W, half)        (settled pre-shift)
// spike     = mean coherence-error over [half, half+W)        (just after shift)
// settle    = mean coherence-error over [half+W, half+2W)     (recovery window)
// W frozen = 50.

// ── drive the LIVE engine over the shift stream, ONE arm ──────────────────────
// Returns [baseline_err, spike_err, settle_err, final_cells].
fn _run_arm(seed: int, n: int, cA: float, cB: float, cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    let mut cells = 3
    let mut rng = seed * 2654435761 + 1
    if rng < 0 { rng = -rng }

    let half = n / 2
    let w = 50

    let mut base_sum = 0.0  let mut base_cnt = 0
    let mut spk_sum = 0.0   let mut spk_cnt = 0
    let mut set_sum = 0.0   let mut set_cnt = 0

    let mut t = 0
    while t < n {
        // (1) LIVE field step — real CORE engine tick (zero-input internal).
        pf = pure_field_step(pf)
        // (2) LIVE growth tick — gated on cfg.mitosis.
        cells = engine_mitosis_tick(cells, cfg)

        // build stream sample (drives rng identically across arms).
        rng = _lcg(rng)
        let jitter = (_u01(rng) - 0.5) * 0.10
        let _sample = _center_at(t, n, cA, cB) + jitter   // shifts at t=half

        // (3) engine's OWN adaptation metric.
        let coh_err = 1.0 - pf.narrative_coherence

        if t >= half - w && t < half { base_sum = base_sum + coh_err base_cnt = base_cnt + 1 }
        if t >= half && t < half + w { spk_sum = spk_sum + coh_err spk_cnt = spk_cnt + 1 }
        if t >= half + w && t < half + 2 * w { set_sum = set_sum + coh_err set_cnt = set_cnt + 1 }
        t = t + 1
    }

    let base = if base_cnt > 0 { base_sum / to_float(base_cnt) } else { 0.0 }
    let spk = if spk_cnt > 0 { spk_sum / to_float(spk_cnt) } else { 0.0 }
    let set = if set_cnt > 0 { set_sum / to_float(set_cnt) } else { 0.0 }
    return [base, spk, set, to_float(cells)]
}

fn _mean(xs: [float]) -> float {
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i] i = i + 1 }
    return s / to_float(len(xs))
}
fn _fmt(x: float) -> string { return to_string(x) }

fn main() {
    println("=== H_1179 LIVE-ENGINE recovery-curve probe (MITOSIS-ENGINE Lane1) ===")
    println("metric: coherence-error = 1 - pure_field.narrative_coherence")
    println("stream: SINGLE mid-stream regime shift (A->B at t=n/2); baseline/spike/settle windows W=50")
    println("falsifier: (a) spike d>=0.8 vs baseline, (b) recovery ratio >=0.50, (c) control off does NOT recover")
    println("")

    let n = 600
    let cA = 0.25
    let cB = 0.85   // large regime jump
    let seeds = [7, 8, 9]

    let mut base_on = []  let mut spk_on = []  let mut set_on = []
    let mut base_off = [] let mut spk_off = [] let mut set_off = []
    let mut cells_on = [] let mut cells_off = []
    let mut rr_on_list = []  let mut rr_off_list = []

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let cfg_on  = engine_cli_parse(["--mitosis", "on"])
        let cfg_off = engine_cli_parse(["--no-mitosis"])

        let ron  = _run_arm(seed, n, cA, cB, cfg_on)
        let roff = _run_arm(seed, n, cA, cB, cfg_off)

        base_on = base_on + [ron[0]]   spk_on = spk_on + [ron[1]]   set_on = set_on + [ron[2]]
        base_off = base_off + [roff[0]] spk_off = spk_off + [roff[1]] set_off = set_off + [roff[2]]
        cells_on = cells_on + [ron[3]]  cells_off = cells_off + [roff[3]]

        // recovery ratio per arm: (spike - settle) / (spike - baseline).
        let denom_on = ron[1] - ron[0]
        let rr_on = if denom_on > 0.000001 { (ron[1] - ron[2]) / denom_on } else { 0.0 }
        let denom_off = roff[1] - roff[0]
        let rr_off = if denom_off > 0.000001 { (roff[1] - roff[2]) / denom_off } else { 0.0 }
        rr_on_list = rr_on_list + [rr_on]
        rr_off_list = rr_off_list + [rr_off]

        println("seed=" + to_string(seed)
            + "  ON  base=" + _fmt(ron[0]) + " spike=" + _fmt(ron[1]) + " settle=" + _fmt(ron[2]) + " cells=" + _fmt(ron[3])
            + "  rr_on=" + _fmt(rr_on))
        println("         OFF base=" + _fmt(roff[0]) + " spike=" + _fmt(roff[1]) + " settle=" + _fmt(roff[2]) + " cells=" + _fmt(roff[3])
            + "  rr_off=" + _fmt(rr_off))
        si = si + 1
    }

    println("")
    let m_base = _mean(base_on)
    let m_spk = _mean(spk_on)
    let m_set = _mean(set_on)
    let spike_mag = m_spk - m_base
    let spike_mag_abs = if spike_mag < 0.0 { -spike_mag } else { spike_mag }
    let m_rr_on = _mean(rr_on_list)
    let m_rr_off = _mean(rr_off_list)

    println("ON  mean baseline=" + _fmt(m_base) + " spike=" + _fmt(m_spk) + " settle=" + _fmt(m_set))
    println("spike magnitude (spike - baseline) = " + _fmt(spike_mag))
    println("recovery ratio  ON mean=" + _fmt(m_rr_on) + "  OFF mean=" + _fmt(m_rr_off))
    println("cells ON mean=" + _fmt(_mean(cells_on)) + "  OFF mean=" + _fmt(_mean(cells_off)))
    println("")

    let SPIKE_EPS = 0.000001   // an UPWARD spike must clear this to count as a perturbation.

    // sanity: live mitosis tick grew cells ON, not OFF.
    let grew = _mean(cells_on) > _mean(cells_off)
    println("sanity: live engine_mitosis_tick grew cells ON>OFF = " + (if grew { "true" } else { "false" }))
    // ON==OFF trajectory check: if baseline/spike/settle are identical across arms,
    // the field is provably stream-blind AND mitosis-blind (no signal to move).
    let on_eq_off = (base_on[0] == base_off[0]) && (spk_on[0] == spk_off[0]) && (set_on[0] == set_off[0])
    println("sanity: ON==OFF coherence trajectory (stream-blind + mitosis-blind) = " + (if on_eq_off { "true" } else { "false" }))
    println("")

    // ── falsifier adjudication ────────────────────────────────────────────────
    // HOURGLASS when there is no UPWARD spike attributable to the shift: spike_mag
    // <= +eps means the regime shift did NOT perturb coherence-error upward (it
    // either stays flat or, as measured here, DECAYS as the field settles) — there
    // is nothing to recover FROM, the falsifier's HOURGLASS branch.
    if spike_mag <= SPIKE_EPS {
        println("VERDICT: HOURGLASS NO-RECOVERY-SIGNAL (BLOCKED-WIRING) — the mid-stream regime")
        println("  shift produced NO upward spike in the engine's coherence-error (spike")
        println("  magnitude=" + _fmt(spike_mag) + " <= eps; coherence-error DECAYS as the field")
        println("  settles, indifferent to the shift). There is nothing to recover FROM.")
        println("  WHAT IS MISSING: pure_field_step is ZERO-INPUT (core/pure_field.hexa) — it")
        println("  advances internal oscillators ONLY; narrative_coherence is an EMA of the")
        println("  field's OWN phase-stability, never of the stream sample. The regime shift in")
        println("  the stream never reaches the field, so no adaptation transient exists to")
        println("  measure. The stream->field coupling is UNBUILT (a_core_engine_map). CANNOT")
        println("  adjudicate GREEN vs RED live — honest HOURGLASS, the falsifier branch.")
        exit(0)
    }

    // a spike DID land — check recovery + control.
    let spiked = spike_mag > 0.0   // post-shift error rose above baseline by >eps
    let recovers = m_rr_on >= 0.50
    let control_ok = m_rr_on - m_rr_off >= 0.0   // ON recovers more than OFF (toy proxy for d)

    if spiked && recovers && control_ok {
        println("VERDICT: GREEN LIVE-RECOVERS — spike landed (" + _fmt(spike_mag)
            + "), recovery ratio " + _fmt(m_rr_on) + " >= 0.50, mitosis-attributable (ON>OFF).")
        exit(0)
    }
    println("VERDICT: RED NO-LIVE-RECOVERY — spike landed but " +
        (if recovers { "control not mitosis-attributable" } else { "no recovery (rr=" + _fmt(m_rr_on) + " < 0.50)" })
        + " (a_paper_negative_ok).")
    exit(0)
}
