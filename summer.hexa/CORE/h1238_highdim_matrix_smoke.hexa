// h1238_highdim_matrix_smoke.hexa — 3-combo + 4-combo 합성 격자 (MATRIX.md §0).
//
// H_1237 이 2-combo 평면격자(10 cell) 를 완성. 주의사항대로 k=2 완료 후 k=3 으로 올린다.
// 4 substrate lane {MITOSIS·METACOG·SAVANT·DREAM} 의 3-combo = C(4,3)=4 triple,
// 4-combo = C(4,4)=1. 각 cell = A⇄G base 위 동시가동 시 Ψ phiSum == base byte-identical
// (Ψ-disjoint) AND 켠 lane 전부 fire. 이로써 substrate 부품 합성 매트릭스 全차원 완성.
//
// lane 0=MITOSIS 1=METACOG 2=SAVANT 3=DREAM. p7 exact float equality.

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"
import "METACOG/audit_hook.hexa"
import "SAVANT/substrate_hook.hexa"
import "DREAM/dream_lib.hexa"

fn run_lanes(l0: bool, l1: bool, l2: bool, l3: bool, fires: [int]) -> float {
    let cfg = engine_config_default()
    let mut pf = pure_field_new()
    let mut sum = 0.0
    let mut cells = 1
    let mut emit_hist = []
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        sum = sum + phi
        if l0 { cells = engine_mitosis_tick(cells, cfg); if cells >= 1 { fires[0] = fires[0] + 1 } }
        if l1 {
            emit_hist.push(if phi > 0.0 { 1 } else { 0 })
            if mh_should_fire(i, 30) {
                let win = mh_collect_emit_window(emit_hist, 30)
                if mh_verdict_record(win, i, "now")["window_size"] == 30 { fires[1] = fires[1] + 1 }
            }
        }
        if l2 { if sh_savant_trigger([phi, phi*0.5, phi*0.25, phi*0.1], 0.30, float(cells))["in_golden_zone"] == 1 { fires[2] = fires[2] + 1 } }
        if l3 { if dr_emit_envelope(dr_stage_at(i)) >= 0 { fires[3] = fires[3] + 1 } }
        i = i + 1
    }
    return sum
}

fn nm(k: int) -> string {
    if k == 0 { return "MIT" }
    if k == 1 { return "MET" }
    if k == 2 { return "SAV" }
    return "DRM"
}

// run the given lane-flags; cell OK iff Ψ==base AND every ON lane fired
fn cell_ok(f0: bool, f1: bool, f2: bool, f3: bool, base: float) -> bool {
    let mut fires = [0, 0, 0, 0]
    let s = run_lanes(f0, f1, f2, f3, fires)
    if s != base { return false }
    if f0 && fires[0] == 0 { return false }
    if f1 && fires[1] == 0 { return false }
    if f2 && fires[2] == 0 { return false }
    if f3 && fires[3] == 0 { return false }
    return true
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1238 3-combo + 4-combo 합성 격자 (substrate 全차원 완성)")
    println("════════════════════════════════════════════════════════════════")
    let base = run_lanes(false, false, false, false, [0, 0, 0, 0])
    println("[base] A⇄G phiSum = " + to_string(base))
    println("")

    // 3-combo: 4 triples (omit one lane each)
    let mut p3 = 0
    println("  k=3 triples (C(4,3)=4):")
    // omit DRM → {MIT,MET,SAV}
    let t0 = cell_ok(true, true, true, false, base);   if t0 { p3 = p3 + 1 }
    println("    MIT×MET×SAV : " + (if t0 { "✅" } else { "❌" }))
    // omit SAV → {MIT,MET,DRM}
    let t1 = cell_ok(true, true, false, true, base);   if t1 { p3 = p3 + 1 }
    println("    MIT×MET×DRM : " + (if t1 { "✅" } else { "❌" }))
    // omit MET → {MIT,SAV,DRM}
    let t2 = cell_ok(true, false, true, true, base);   if t2 { p3 = p3 + 1 }
    println("    MIT×SAV×DRM : " + (if t2 { "✅" } else { "❌" }))
    // omit MIT → {MET,SAV,DRM}
    let t3 = cell_ok(false, true, true, true, base);   if t3 { p3 = p3 + 1 }
    println("    MET×SAV×DRM : " + (if t3 { "✅" } else { "❌" }))

    // 4-combo: all
    println("")
    println("  k=4 quad (C(4,4)=1):")
    let q = cell_ok(true, true, true, true, base)
    println("    MIT×MET×SAV×DRM : " + (if q { "✅" } else { "❌" }))

    let all = p3 == 4 && q
    println("")
    println("[matrix] k=3 PASS " + to_string(p3) + "/4 · k=4 PASS " + (if q { "1/1" } else { "0/1" }))
    if all {
        println("h1238_highdim_matrix: PASS — substrate 합성 매트릭스 全차원 완성 "
            + "(k=1 단독4 · k=2 쌍6 · k=3 triple4 · k=4 quad1 = 15 cell 전부 Ψ-disjoint). "
            + "substrate 부품(4 lane + A⇄G) 의 모든 조합이 합성됨 — 차원 고갈.")
    } else {
        println("h1238_highdim_matrix: INCOMPLETE")
    }
}
