#!hexa strict
// tests/test_n6_invariants.hexa — n=6 lattice independent witness.
//
// Hexa-native selftest port of tests/test_n6_invariants.py (2026-05-23
// py→hexa sweep). Recomputes σ / τ / φ from first principles — an
// independent witness to verify/n6_arithmetic.hexa (does NOT call it).
//
// Run:
//   hexa run tests/test_n6_invariants.hexa
// Exit 0 iff all invariants hold; non-zero on first FAIL.

fn _gcd(a: int, b: int) -> int {
    let mut x = a
    let mut y = b
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    if x < 0 { return 0 - x }
    return x
}

fn divisor_sum(n: int) -> int {
    let mut s = 0
    let mut d = 1
    while d <= n {
        if n % d == 0 { s = s + d }
        d = d + 1
    }
    return s
}

fn divisor_count(n: int) -> int {
    let mut c = 0
    let mut d = 1
    while d <= n {
        if n % d == 0 { c = c + 1 }
        d = d + 1
    }
    return c
}

fn euler_phi(n: int) -> int {
    let mut c = 0
    let mut k = 1
    while k <= n {
        if _gcd(k, n) == 1 { c = c + 1 }
        k = k + 1
    }
    return c
}

fn _pow2(e: int) -> int {
    let mut v = 1
    let mut i = 0
    while i < e {
        v = v * 2
        i = i + 1
    }
    return v
}

let mut PASSED = 0
let mut FAILED = 0

fn check(label: str, cond: bool) {
    if cond {
        println("  [PASS] " + label)
        PASSED = PASSED + 1
    } else {
        println("  [FAIL] " + label)
        FAILED = FAILED + 1
    }
}

fn main() {
    println("tests/test_n6_invariants — n=6 lattice independent witness")
    println("")

    let s = divisor_sum(6)
    let t = divisor_count(6)
    let p = euler_phi(6)

    // test_master_identity: σ(6)·φ(6) == 6·τ(6) == 24
    check("master_identity        σ·φ = n·τ = 24", (s * p == 24) && (6 * t == 24))

    // test_audio_codec_constants: σ·τ = 48 kHz, σ·φ = 24-bit
    check("audio_codec_constants  σ·τ = 48 kHz", s * t == 48)
    check("audio_codec_constants  σ·φ = 24-bit", s * p == 24)

    // test_dream_categories_sigma
    check("dream_categories       σ(6) = 12", s == 12)

    // test_olfact_receptors_sigma
    check("olfact_receptors       σ(6) = 12", s == 12)
    check("olfact_odor_patterns   2^σ(6) = 4096", _pow2(s) == 4096)

    // test_ekman_emotions_n
    check("ekman_emotions         n = 6", 6 == 6)

    // test_verb_count_is_5
    let verbs = ["dream", "ear", "empath", "olfact", "voice"]
    check("verb_count             |verbs| = 5", verbs.len() == 5)

    println("")
    println("  " + str(PASSED) + " passed, " + str(FAILED) + " failed")
    if FAILED > 0 {
        println("test_n6_invariants: FAIL")
        exit(1)
    }
    println("test_n6_invariants: PASS")
}
