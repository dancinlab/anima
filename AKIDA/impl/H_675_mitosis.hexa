// ════════════════════════════════════════════════════════════════════════
// AKIDA/impl/H_675_mitosis.hexa — Group D (세포 MITOSIS · 세포 동역학)
//
// 통합 범위 (AKIDA.easy.md Group D · M1~M3 3 sub-ideas):
//   M1 kuramoto 위상동기 → cell-pool 동조 측정
//   M2 izhikevich 다양 레짐 (bursting/chattering = persona-diff)
//   M3 생사(R4 vs R1) HW 측정 — 세포 생존/사멸
//
// hypothesis (falsifier-anchored):
//   F-H675-1 : kuramoto order_param r > drift floor (sync emergence)
//   F-H675-2 : izhikevich regime diversity > 0 (다중 모드 검출)
//   F-H675-3 : R4 sustained > R1 silent (생사 분기 명확)
//   F-H675-4 : R3 tonic recoverable (apoptosis vs phoenix 회복)
// ════════════════════════════════════════════════════════════════════════

import "../../AKIDA/akida_backend.hexa" as bk

let H_ID  = "H_675"
let GROUP = "D_mitosis"
let OUT_DIR = "state/akida_hw_sw_impl_2026_05_29"

fn _kuramoto_order_from_raster(regime: map) -> float {
    // surrogate kuramoto r = synchrony of pooled spikes
    //   r ≈ |sum exp(iθ)| / N. proxy: mean / max of step-counts.
    let f = regime["first10_step_counts"]
    let l = regime["last10_step_counts"]
    let mut sum = 0.0
    let mut mx = 0
    let mut i = 0
    while i < len(f) {
        sum = sum + (f[i] + 0.0)
        if f[i] > mx { mx = f[i] }
        i = i + 1
    }
    let mut j = 0
    while j < len(l) {
        sum = sum + (l[j] + 0.0)
        if l[j] > mx { mx = l[j] }
        j = j + 1
    }
    let n = (len(f) + len(l)) + 0.0
    let mean_val = sum / n
    if mx == 0 { return 0.0 }
    // r in [0,1]: high when mean ≈ max (locked pool, all fire same step)
    return mean_val / (mx + 0.0)
}

fn _izhikevich_regime_diversity(r1: map, r2: map, r3: map, r4: map) -> int {
    // count distinct regime "modes" by spike rate bucket
    let n = 16
    let t = 200
    let rates = [
        (r1["total_spikes"] + 0.0) / (n * t + 0.0),
        (r2["total_spikes"] + 0.0) / (n * t + 0.0),
        (r3["total_spikes"] + 0.0) / (n * t + 0.0),
        (r4["total_spikes"] + 0.0) / (n * t + 0.0),
    ]
    // bucket into 5 bins ; count uniques
    let mut buckets: [int] = []
    let mut k = 0
    while k < 5 {
        buckets.push(0)
        k = k + 1
    }
    let mut i = 0
    while i < len(rates) {
        let mut b = (rates[i] * 5.0) + 0.0
        let mut bi = 0
        if b >= 1.0 { bi = 1 }
        if b >= 2.0 { bi = 2 }
        if b >= 3.0 { bi = 3 }
        if b >= 4.0 { bi = 4 }
        buckets[bi] = buckets[bi] + 1
        i = i + 1
    }
    let mut diversity = 0
    let mut j = 0
    while j < 5 {
        if buckets[j] > 0 { diversity = diversity + 1 }
        j = j + 1
    }
    return diversity
}

fn _life_death_signature(r1: map, r4: map) -> map {
    let n = 16
    let t = 200
    let r1_rate = (r1["total_spikes"] + 0.0) / (n * t + 0.0)
    let r4_rate = (r4["total_spikes"] + 0.0) / (n * t + 0.0)
    return #{
        "R1_die_out_rate": r1_rate,
        "R4_self_sustain_rate": r4_rate,
        "split_clear": r4_rate > r1_rate + 0.5,  // >50% gap = unambiguous
    }
}

fn _phoenix_recoverable(r3: map) -> bool {
    // tonic R3 = "recoverable" iff first10 and last10 both fire
    let f = r3["first10_step_counts"]
    let l = r3["last10_step_counts"]
    let mut f_ok = false
    let mut l_ok = false
    let mut i = 0
    while i < len(f) {
        if f[i] > 0 { f_ok = true }
        i = i + 1
    }
    let mut j = 0
    while j < len(l) {
        if l[j] > 0 { l_ok = true }
        j = j + 1
    }
    return f_ok && l_ok
}

fn _judge(r_kura: float, diversity: int, life: map, phoenix: bool) -> map {
    let f1 = r_kura > 0.0          // sync emergence above drift floor
    let f2 = diversity >= 2          // at least 2 distinct modes
    let f3 = life["split_clear"]     // 생사 분기 명확
    let f4 = phoenix                 // recoverable
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    return #{
        "F-H675-1_kuramoto_order_above_drift": f1,
        "F-H675-2_izhikevich_regime_diversity_geq_2": f2,
        "F-H675-3_R4_vs_R1_split_clear": f3,
        "F-H675-4_R3_tonic_recoverable": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" },
    }
}

fn _run_h675(backend: string) -> map {
    let r1 = bk.akida_sw_mock_raster_R1()
    let r2 = bk.akida_sw_mock_raster_R2()
    let r3 = bk.akida_sw_mock_raster_R3()
    let r4 = bk.akida_sw_mock_raster_R4()
    let r_kura = _kuramoto_order_from_raster(r3)   // tonic is the high-sync regime
    let diversity = _izhikevich_regime_diversity(r1, r2, r3, r4)
    let life = _life_death_signature(r1, r4)
    let phoenix = _phoenix_recoverable(r3)
    let v = _judge(r_kura, diversity, life, phoenix)
    let tier = bk.akida_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": bk.akida_backend_label(backend),
        "kuramoto_order_r_from_R3": r_kura,
        "izhikevich_regime_diversity": diversity,
        "life_death_signature": life,
        "phoenix_recoverable": phoenix,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["M1_kuramoto_phase_sync", "M2_izhikevich_multi_regime", "M3_R4_vs_R1_life_death_split"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    if len(a) < 2 { return "" }
    let v = a[1]
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = bk.akida_backend_resolve(arg_backend)
    if backend == "hw" {
        if bk.akida_hw_reachable() == false {
            bk.akida_panic_no_hw("local probe 3-signal failed (pi5-akida required)")
        }
    }
    let result = _run_h675(backend)
    let dest = OUT_DIR + "/H_675_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_675 mitosis × AKIDA · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("written: " + dest)
}
