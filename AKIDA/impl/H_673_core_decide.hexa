// ════════════════════════════════════════════════════════════════════════
// AKIDA/impl/H_673_core_decide.hexa — Group B (두뇌 CORE · A⇄G 결정)
//
// 통합 범위 (AKIDA.easy.md Group B · A1~A4 4 sub-ideas):
//   A1 spike → Ψ=1/2 외란 (chip noise = 결정 진짜 무작위성)
//   A2 LIF → pure_field 흥분원 (engine_g 입력 step 구동)
//   A3 spike → L3 emit slot 트리거 (emit 타이밍)
//   A4 core_selftest HW-in-loop (BackendType.Hardware probe)
//
// hypothesis (falsifier-anchored):
//   F-H673-1 : R2 noise drives Ψ towards 1/2 (R2 vs R1 silence: |Ψ-0.5| 감소)
//   F-H673-2 : R3 tonic emission rate > 0 (LIF comparator → pure_field 흥분 ON)
//   F-H673-3 : R3 emit-slot trigger rate ≥ R1 silent (slot count R3 > R1)
//   F-H673-4 : selftest reachable (HW path → 3-signal OK ; SW path → mock OK)
//
// usage:
//   hexa run AKIDA/impl/H_673_core_decide.hexa sw
//   hexa run AKIDA/impl/H_673_core_decide.hexa hw
// ════════════════════════════════════════════════════════════════════════

import "../../AKIDA/akida_backend.hexa" as bk

let H_ID  = "H_673"
let GROUP = "B_core_decide"
let OUT_DIR = "state/akida_hw_sw_impl_2026_05_29"

fn _psi_distance_half(rate: float) -> float {
    // distance of activation rate from Ψ=1/2 fixed point
    let d = if rate > 0.5 { rate - 0.5 } else { 0.5 - rate }
    return d
}

fn _emit_slot_count(regime: map) -> int {
    // surrogate "emit slot" = step where >0 spikes recorded (slot per step).
    // we use first10+last10 sample.
    let f = regime["first10_step_counts"]
    let l = regime["last10_step_counts"]
    let mut n = 0
    let mut i = 0
    while i < len(f) {
        if f[i] > 0 { n = n + 1 }
        i = i + 1
    }
    let mut j = 0
    while j < len(l) {
        if l[j] > 0 { n = n + 1 }
        j = j + 1
    }
    return n
}

fn _measure(regime: map, label: string) -> map {
    let n_neurons = 16
    let n_steps = 200
    let total = regime["total_spikes"]
    let rate = (total + 0.0) / ((n_neurons + 0.0) * (n_steps + 0.0))
    let psi_dist = _psi_distance_half(rate)
    let slots = _emit_slot_count(regime)
    return #{
        "regime_label": label,
        "rate": rate,
        "psi_dist_half": psi_dist,
        "emit_slots_20step_sample": slots,
        "lif_excitable": rate > 0.0,
    }
}

fn _judge(m1: map, m2: map, m3: map, selftest_ok: bool) -> map {
    let f1 = m2["psi_dist_half"] < m1["psi_dist_half"]      // noise → closer to 1/2 than silent
    let f2 = m3["lif_excitable"]                              // tonic comparator fires
    let f3 = m3["emit_slots_20step_sample"] >= m1["emit_slots_20step_sample"]
    let f4 = selftest_ok
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    let verdict = if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" }
    return #{
        "F-H673-1_R2_closer_to_half_than_R1": f1,
        "F-H673-2_R3_LIF_excitable": f2,
        "F-H673-3_R3_emit_slots_geq_R1": f3,
        "F-H673-4_selftest_reachable": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": verdict,
    }
}

fn _run_h673(backend: string) -> map {
    let r1 = bk.akida_sw_mock_raster_R1()
    let r2 = bk.akida_sw_mock_raster_R2()
    let r3 = bk.akida_sw_mock_raster_R3()
    let m1 = _measure(r1, "R1_weak_silent")
    let m2 = _measure(r2, "R2_zero_noise")
    let m3 = _measure(r3, "R3_tonic_zero_input")
    // selftest: HW path → hw_reachable; SW path → mock-replay is its own selftest (always true).
    let selftest_ok = if backend == "hw" { bk.akida_hw_reachable() } else { true }
    let v = _judge(m1, m2, m3, selftest_ok)
    let tier = bk.akida_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": bk.akida_backend_label(backend),
        "R1": m1, "R2": m2, "R3": m3,
        "selftest_ok": selftest_ok,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["A1_spike_psi_half_perturb", "A2_LIF_pure_field_step", "A3_R3_emit_slot_trigger", "A4_core_selftest_HW_in_loop"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    if len(a) < 2 { return "" }
    let v = a[1]
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = bk.akida_backend_resolve(arg_backend)
    if backend == "hw" {
        if bk.akida_hw_reachable() == false {
            bk.akida_panic_no_hw("local probe 3-signal failed (pi5-akida required)")
        }
    }
    let result = _run_h673(backend)
    let dest = OUT_DIR + "/H_673_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_673 core-decide × AKIDA · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("written: " + dest)
}
