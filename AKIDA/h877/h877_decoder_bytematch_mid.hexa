// ═══════════════════════════════════════════════════════════
// AKIDA/h877/h877_decoder_bytematch_mid.hexa — H_877 DECODER byte-identical
// transplant @ mid (extends H_680 🟢 toy byte-match to the mid rung).
//
// 배경:
//   H_680 🟢 (toy n=16) + H_860 (live AKD1000 total_hamming=0/16000) 가 추론
//   lane 의 HW-forward == SW akida_sw_lif byte-identity 를 toy 에서 입증했다.
//   H_877 는 이 불변을 mid 생산 rung (width d512 · depth L8 · act_bits/expert E8)
//   으로 확장한다 — @L2 "inference byte-identical → chip transplant gives
//   identical answers" 를 생산 rung 에서 받친다.
//
// 설계 (ADD-ONLY · 기존 AKIDA/akida_sw_lif 미수정):
//   이 .hexa 드라이버는 이미 HW-검증된 SW int4 forward primitive
//   (AGENT/CHAT/akida_sw_lif.cascade_forward — toy byte-match 0)를
//   CONSUME 하는 python 측정기를 shell-out 으로 구동한다 (scripts/akida/
//   runner.hexa 의 _exec_capture python3 패턴과 동형). numpy/akida 무거운 부분은
//   python 측, verdict 동결·기록은 hexa 측.
//
//   - HW arm  (akida + device 도달): 동치 L8 FullyConnected int4 cascade 를
//     AKD1000 에 자체 Model 로 빌드(비파괴 — 다른 배포 모델 미접촉)·동일 frozen
//     probe forward → total_hamming(HW, SW) == 0 단언 → F-CLM-DECODER-MID-HW.
//   - SW arm  (akida 부재/무디바이스 — 정직 축소): SW int4 forward 가 in-proc
//     반복 + cross-proc 독립 실행에 걸쳐 DETERMINISTIC byte-identical
//     (total_hamming==0) 단언 → F-CLM-DECODER-MID-SW (HW==SW 는 HW-pending 🟠).
//
//   측정 by CODE (g5). 임계 forward 실행 전 동결
//   (.verdicts/clm-decoder-bytematch-mid/F-CLM-DECODER-MID_prereg.txt · post-tuning 0).
//
// CLI:
//   hexa run AKIDA/h877/h877_decoder_bytematch_mid.hexa run
//
// 규칙: hexa >=/<= 금지 — < / > 만. stdlib only.
// ═══════════════════════════════════════════════════════════

fn _ns_now() -> i64 {
    let mut r: i64 = 0
    let raw = to_string(exec("date +%s%N 2>/dev/null")).trim()  // @allow-bare-exec
    if raw.len() > 0 && raw.contains("N") == false {
        try { r = to_int(raw) } catch e {}  // @allow-silent-catch
    }
    if r < 1 {
        let s2 = to_string(exec("date +%s")).trim()  // @allow-bare-exec
        try { let sec = to_int(s2); r = sec * 1000000000 } catch e2 {}  // @allow-silent-catch
    }
    return r
}

// The python measurement program (consumes the HW-verified SW primitive). Written
// to a temp file at runtime so the numpy/akida body stays readable. ADD-ONLY: it
// IMPORTS akida_sw_lif, it does not edit it.
fn _py_program() -> string {
    let mut p: [string] = []
    p.push("import hashlib,json,os,subprocess,sys\n")
    p.push("import numpy as np\n")
    p.push("HERE=os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else os.getcwd()\n")
    p.push("SERVER=os.path.normpath(os.path.join(os.getcwd(),'HEXAD','CHAT','server'))\n")
    p.push("sys.path.insert(0,SERVER)\n")
    p.push("import akida_sw_lif\n")
    p.push("SEED=877; WIDTH=512; DEPTH=8; ACT_BITS=4; INPUT_BITS=4; N_PROBE=64; LO=-7; HI=7\n")
    p.push("def build(seed=SEED):\n")
    p.push("    rng=np.random.default_rng(seed)\n")
    p.push("    W=[rng.integers(LO,HI+1,size=(WIDTH,WIDTH)).astype(np.int64) for _ in range(DEPTH)]\n")
    p.push("    X=rng.integers(0,(1<<INPUT_BITS),size=(N_PROBE,WIDTH)).astype(np.int64)\n")
    p.push("    return W,X\n")
    p.push("def sw_bytes(seed=SEED):\n")
    p.push("    W,X=build(seed); outs=[]\n")
    p.push("    for i in range(X.shape[0]):\n")
    p.push("        y=akida_sw_lif.cascade_forward(X[i],W,ACT_BITS,input_bits=INPUT_BITS,n=WIDTH)\n")
    p.push("        outs.append(np.asarray(y,dtype=np.int64).reshape(-1))\n")
    p.push("    return np.concatenate(outs)\n")
    p.push("def bits(v):\n")
    p.push("    v=np.asarray(v,dtype=np.int64).reshape(-1)\n")
    p.push("    return ((v[:,None]>>np.arange(ACT_BITS)[None,:])&1).astype(np.int8).reshape(-1)\n")
    p.push("def ham(a,b):\n")
    p.push("    ba,bb=bits(a),bits(b)\n")
    p.push("    if ba.shape!=bb.shape:\n")
    p.push("        m=min(ba.size,bb.size); return int(abs(ba.size-bb.size)+np.count_nonzero(ba[:m]!=bb[:m]))\n")
    p.push("    return int(np.count_nonzero(ba!=bb))\n")
    p.push("def sha(v): return hashlib.sha256(np.asarray(v,dtype=np.int64).tobytes()).hexdigest()\n")
    p.push("def try_akida():\n")
    p.push("    try:\n")
    p.push("        import importlib; ak=importlib.import_module('akida')\n")
    p.push("    except Exception: return (None,None)\n")
    p.push("    try:\n")
    p.push("        d=ak.devices(); return (ak,d[0]) if d else (ak,None)\n")
    p.push("    except Exception: return (ak,None)\n")
    p.push("def hw_bytes(ak,dev,seed=SEED):\n")
    p.push("    W,X=build(seed); m=ak.Model()\n")
    p.push("    m.add(ak.InputData(input_shape=(1,1,WIDTH),input_bits=INPUT_BITS,name='in'))\n")
    p.push("    for li in range(DEPTH):\n")
    p.push("        m.add(ak.FullyConnected(units=WIDTH,weights_bits=4,activation=True,act_bits=ACT_BITS,name='fc%d'%li))\n")
    p.push("    m.map(dev)\n")
    p.push("    for li,Wl in enumerate(W): m.get_layer('fc%d'%li).set_variable('weights',Wl.astype(np.int8))\n")
    p.push("    outs=[]\n")
    p.push("    for i in range(X.shape[0]):\n")
    p.push("        x=np.clip(X[i],0,(1<<INPUT_BITS)-1).astype(np.uint8).reshape(1,1,1,WIDTH)\n")
    p.push("        outs.append(m.forward(x).reshape(-1)[:WIDTH].astype(np.int64))\n")
    p.push("    return np.concatenate(outs)\n")
    p.push("if os.environ.get('H877_SUBPROC')=='1':\n")
    p.push("    v=sw_bytes(); print(json.dumps({'sha':sha(v),'n':int(v.size)})); sys.exit(0)\n")
    p.push("ref=sw_bytes(); ref_sha=sha(ref)\n")
    p.push("rep=sw_bytes(); ham_in=ham(ref,rep)\n")
    p.push("env=dict(os.environ,H877_SUBPROC='1')\n")
    p.push("proc=subprocess.run([sys.executable,sys.argv[0]],capture_output=True,text=True,env=env,timeout=600)\n")
    p.push("try: child=json.loads(proc.stdout.strip().splitlines()[-1])\n")
    p.push("except Exception: child={'sha':'<child-failed>','n':-1}\n")
    p.push("cross=(child.get('sha')==ref_sha and child.get('n')==int(ref.size))\n")
    p.push("ak,dev=try_akida(); hw_ok=ak is not None and dev is not None; hw_h=None; hw_s=None\n")
    p.push("if hw_ok:\n")
    p.push("    try: hw=hw_bytes(ak,dev); hw_h=ham(hw,ref); hw_s=sha(hw)\n")
    p.push("    except Exception as e: hw_ok=False; hw_s='<hw-error:%s>'%type(e).__name__\n")
    p.push("if hw_ok and hw_h is not None:\n")
    p.push("    arm='HW'; fal='F-CLM-DECODER-MID-HW'; ok=(hw_h==0); th=hw_h\n")
    p.push("    verdict='SUPPORTED-NUMERICAL' if ok else 'CLOSED-NEGATIVE'\n")
    p.push("    claim='HW on-chip forward == SW akida_sw_lif byte-identical at mid'\n")
    p.push("else:\n")
    p.push("    arm='SW'; fal='F-CLM-DECODER-MID-SW'; ok=(ham_in==0 and cross); th=ham_in\n")
    p.push("    verdict='HW-PENDING (SW determinism byte-identical)' if ok else 'CLOSED-NEGATIVE'\n")
    p.push("    claim='SW int4 forward DETERMINISTIC byte-identical (in-proc+cross-proc) at mid; HW==SW HW-pending'\n")
    p.push("res={'hypothesis':'H_877','rung':{'width_d':WIDTH,'depth_L':DEPTH,'act_bits_E':ACT_BITS,'input_bits':INPUT_BITS,'n_probe':N_PROBE,'seed':SEED,'int4_range':[LO,HI]},'eval_byte_set_len':int(ref.size),'ref_sha256':ref_sha,'sw_in_process_total_hamming':ham_in,'sw_cross_process_match':bool(cross),'sw_cross_process_sha256':child.get('sha'),'hw_attempted':bool(hw_ok),'hw_total_hamming':hw_h,'hw_sha256':hw_s,'arm':arm,'falsifier':fal,'total_hamming':th,'all_pass':bool(ok),'verdict':verdict,'claim':claim,'scope':'mid rung d512/L8/E8 only (a_scale_honest_scope)','consumes':'AGENT/CHAT/akida_sw_lif.cascade_forward (HW-verified toy byte-match)'}\n")
    p.push("print(json.dumps(res,indent=2)); sys.exit(0 if ok else 1)\n")
    return p.join("")
}

// pick a numpy-capable python: $H877_PY override → first python3 on PATH that
// imports numpy → a known anima venv → bare python3 (honest last resort).
fn _python() -> string {
    let env_py = to_string(exec("printf '%s' \"$H877_PY\"")).trim()  // @allow-bare-exec
    if env_py.len() > 0 { return env_py }
    let probe = "for p in python3 \"$HOME/dancinlab/anima/.venv-eeg/bin/python3\" \"$HOME/core/anima/.venv-eeg/bin/python3\"; do \"$p\" -c 'import numpy' 2>/dev/null && { printf '%s' \"$p\"; exit 0; }; done"
    let found = to_string(exec(probe)).trim()  // @allow-bare-exec
    if found.len() > 0 { return found }
    return "python3"
}

fn run() -> i32 {
    let t0 = _ns_now()
    let py = _py_program()
    // write the measurement program to a temp .py and run it (numpy/akida body).
    let tmp = "AKIDA/h877/_h877_run.py"
    write_file(tmp, py)
    let interp = _python()
    let wrapped = interp + " " + tmp + "; echo \"__RC=$?\""
    let out = to_string(exec(wrapped))  // @allow-bare-exec
    let t1 = _ns_now()
    let rc_at = out.index_of("__RC=")
    let mut rc: i64 = 1
    if rc_at > -1 {
        let tail = out.substring(rc_at + 5, len(out)).trim()
        try { rc = to_int(tail) } catch e {}  // @allow-silent-catch
        print(out.substring(0, rc_at))
    } else {
        print(out)
    }
    eprintln("H877_BYTEMATCH_MID rc=" + to_string(rc) + " dur_us=" + to_string((t1 - t0) / 1000))
    return rc as i32
}

fn _has(a: [string], v: string) -> bool {
    let mut i = 0
    while i < len(a) { if a[i] == v { return true } i = i + 1 }
    return false
}

fn main_dispatch(a: [string]) -> i32 {
    if _has(a, "run") { return run() }
    println("usage:")
    println("  hexa run AKIDA/h877/h877_decoder_bytematch_mid.hexa run")
    return 1
}

let _argv = args()
let _rc = main_dispatch(_argv)
exit(_rc)  // @allow-silent-exit
