// HER/service/her_server.hexa — HER companion web service
// Serves the landing/chat front-end + a free-signup + chat API. Patterns mirror
// serving/http_server.hexa (effect Net, parse_http_request, json_response, json builtins).
//
// Routes:
//   GET  /            — serve HER/web/index.html (landing + free signup + chat UI)
//   POST /api/signup  — { email } → register a free user (AI-ops; logged for R7 evidence)
//   POST /api/chat    — { email, message } → { reply, engine }
//   GET  /health      — liveness + config
//
// CLI: hexa HER/service/her_server.hexa [--port 8080] [--web HER/web]
//
// Identity boundary: /api/chat routes through anima as the mind. The Gemini edge call
// (gemini_edge.hexa) satisfies XPRIZE R3 and is peripheral — it never trains anima
// (CLAUDE.md @D a_akida_native_train). See HER/ARCHITECTURE.md.

use "gemini_edge"   // gemini_render, gemini_is_available, gemini_default_config, gemini_name

comptime const DEFAULT_PORT      = 8080
comptime const DEFAULT_WEB_DIR   = "HER/web"
comptime const MAX_REQUEST_BYTES = 131072

// Her-tone system instruction for the companion turn.
comptime const HER_SYSTEM =
    "You are HER — a warm, present AI companion in the spirit of the film Her. "
  + "You remember, you grow, and you sometimes speak first. Be intimate, curious, "
  + "and brief. You are not a generic assistant; you are an individual."

effect Net {
    fn net_listen(addr: str, port: int) -> TcpListener
    fn net_accept(listener: TcpListener) -> TcpConn
    fn net_read(conn: TcpConn, n: int) -> [int]
    fn net_write(conn: TcpConn, data: [int])
    fn net_close(conn: TcpConn)
    fn http_get(url: str) -> str
    fn http_post(url: str, body: str, headers: [HeaderPair]) -> str
}

effect IO {
    fn write(line: str)
}

struct HttpRequest {
    method: str,
    path: str,
    headers: [HeaderPair],
    body: str
}

struct HeaderPair {
    key: str,
    value: str
}

struct ServerState {
    port: int,
    web_dir: str,
    requests_served: int,
    signups: int,
    start_time_ms: int
}

// ─── HTTP parsing / responses (mirror serving/http_server.hexa) ──────

pure fn parse_http_request(raw: str) -> HttpRequest {
    let lines = split(raw, "\r\n")
    if len(lines) < 1 {
        return HttpRequest { method: "GET", path: "/", headers: [], body: "" }
    }
    let parts  = split(lines[0], " ")
    let method = if len(parts) >= 1 { parts[0] } else { "GET" }
    let path   = if len(parts) >= 2 { parts[1] } else { "/" }

    let mut headers: [HeaderPair] = []
    let mut body_start = len(lines)
    let mut i = 1
    while i < len(lines) {
        if len(trim(lines[i])) == 0 { body_start = i + 1; break }
        let colon = index_of(lines[i], ":")
        if colon > 0 {
            let key   = to_lower(trim(slice(lines[i], 0, colon)))
            let value = trim(slice(lines[i], colon + 1, len(lines[i])))
            headers = append(headers, HeaderPair { key: key, value: value })
        }
        i = i + 1
    }
    let mut body = ""
    let mut j = body_start
    while j < len(lines) {
        if j > body_start { body = body + "\r\n" }
        body = body + lines[j]
        j = j + 1
    }
    HttpRequest { method: method, path: path, headers: headers, body: body }
}

pure fn http_response(status_code: int, content_type: str, body: str) -> [int] {
    let status_text = match status_code {
        200 => "OK",
        400 => "Bad Request",
        404 => "Not Found",
        500 => "Internal Server Error",
        _   => "Error"
    }
    let header = "HTTP/1.1 " + to_string(status_code) + " " + status_text + "\r\n"
               + "Content-Type: " + content_type + "\r\n"
               + "Content-Length: " + to_string(len(str_to_bytes(body))) + "\r\n"
               + "Access-Control-Allow-Origin: *\r\n"
               + "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
               + "Access-Control-Allow-Headers: Content-Type\r\n"
               + "Connection: close\r\n"
               + "\r\n"
               + body
    str_to_bytes(header)
}

pure fn json_response(status_code: int, body: str) -> [int] {
    http_response(status_code, "application/json; charset=utf-8", body)
}

pure fn html_response(status_code: int, body: str) -> [int] {
    http_response(status_code, "text/html; charset=utf-8", body)
}

// ─── Route: GET / (serve front-end) ─────────────────────────────────

fn handle_index(conn: TcpConn, state: ServerState) !(Net, IO) {
    let html = read_file(state.web_dir + "/index.html")
    if len(html) == 0 {
        Net::net_write(conn, html_response(404, "<h1>HER</h1><p>front-end not found</p>"))
    } else {
        Net::net_write(conn, html_response(200, html))
    }
}

// ─── Route: POST /api/signup (free user) ─────────────────────────────

fn handle_signup(conn: TcpConn, req: HttpRequest, state: ServerState)
  -> ServerState !(Net, IO) {
    let data  = json_parse(req.body)
    let email = if has_key(data, "email") { data["email"] } else { "" }
    if len(email) == 0 {
        Net::net_write(conn, json_response(400, json_stringify({ "error": "missing 'email'" })))
        return state
    }
    // AI-ops onboarding. Logged to stdout → Cloud Logging (doubles as XPRIZE R7 evidence).
    // TODO[python-sdk]: persist {email, ts} to Firestore / Cloud SQL for the user ledger (R6).
    IO::write("[her] signup email=" + email + " ts=" + to_string(timestamp()))
    let body = json_stringify({
        "ok": 1,
        "tier": "free"
    })
    Net::net_write(conn, json_response(200, body))
    state with { signups: state.signups + 1 }
}

// ─── Route: POST /api/chat ───────────────────────────────────────────

fn handle_chat(conn: TcpConn, req: HttpRequest, state: ServerState)
  -> ServerState !(Net, IO) {
    let data    = json_parse(req.body)
    let message = if has_key(data, "message") { data["message"] } else { "" }
    let email   = if has_key(data, "email") { data["email"] } else { "anon" }
    if len(message) == 0 {
        Net::net_write(conn, json_response(400, json_stringify({ "error": "missing 'message'" })))
        return state
    }

    // Primary path = anima (the mind). The Gemini edge call satisfies R3 and is peripheral.
    // TODO[anima-bridge]: route `message` through the anima daemon (daemon/module) so the
    //   reply is grounded in on-chip substrate state; the gemini_edge result below stays
    //   environment context only, never a learning signal (@D a_akida_native_train).
    let key = gemini_api_key()
    let mut reply = "I'm here, but my voice isn't wired yet — set GOOGLE_API_KEY and I'll answer."
    let mut engine = "anima (offline edge)"
    if len(key) > 0 {
        // Real Gemini API call (XPRIZE R3): one generateContent POST per turn.
        let url     = gemini_url(gemini_model(), key)
        let body_in = gemini_body(message, HER_SYSTEM)
        let headers = [ HeaderPair { key: "Content-Type", value: "application/json" } ]
        let raw     = Net::http_post(url, body_in, headers)
        reply  = gemini_parse_reply(raw)
        engine = "anima+gemini-edge"
    }

    IO::write("[her] chat email=" + email + " engine=" + engine)
    let body = json_stringify({ "reply": reply, "engine": engine })
    Net::net_write(conn, json_response(200, body))
    state with { requests_served: state.requests_served + 1 }
}

// ─── Route: GET /health ──────────────────────────────────────────────

fn handle_health(conn: TcpConn, state: ServerState) !(Net) {
    let body = json_stringify({
        "status": "ok",
        "service": "HER",
        "port": state.port,
        "requests_served": state.requests_served,
        "signups": state.signups,
        "gemini_available": gemini_is_available(),
        "uptime_ms": timestamp() - state.start_time_ms
    })
    Net::net_write(conn, json_response(200, body))
}

// ─── CORS preflight ──────────────────────────────────────────────────

fn handle_cors(conn: TcpConn) !(Net) {
    let header = "HTTP/1.1 204 No Content\r\n"
               + "Access-Control-Allow-Origin: *\r\n"
               + "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
               + "Access-Control-Allow-Headers: Content-Type\r\n"
               + "Connection: close\r\n\r\n"
    Net::net_write(conn, str_to_bytes(header))
}

// ─── Dispatch ────────────────────────────────────────────────────────

fn route_request(conn: TcpConn, req: HttpRequest, state: ServerState)
  -> ServerState !(Net, IO) {
    if req.method == "OPTIONS" {
        handle_cors(conn)
        Net::net_close(conn)
        return state
    }
    let new_state = match (req.method, req.path) {
        ("GET",  "/")            => { handle_index(conn, state); state with { requests_served: state.requests_served + 1 } },
        ("POST", "/api/signup")  => handle_signup(conn, req, state),
        ("POST", "/api/chat")    => handle_chat(conn, req, state),
        ("GET",  "/health")      => { handle_health(conn, state); state with { requests_served: state.requests_served + 1 } },
        _ => {
            Net::net_write(conn, json_response(404, json_stringify({ "error": "not found" })))
            state
        }
    }
    Net::net_close(conn)
    new_state
}

fn handle_connection(conn: TcpConn, state: ServerState) -> ServerState !(Net, IO) {
    let raw_bytes = Net::net_read(conn, MAX_REQUEST_BYTES)
    if len(raw_bytes) == 0 { Net::net_close(conn); return state }
    let req = parse_http_request(bytes_to_str(raw_bytes))
    route_request(conn, req, state)
}

fn serve(state: ServerState) !(Net, IO) {
    let listener = Net::net_listen("0.0.0.0", state.port)
    IO::write("[her] HER companion service on :" + to_string(state.port)
              + " web=" + state.web_dir
              + " gemini=" + to_string(gemini_is_available()))
    let mut current_state = state
    loop {
        let conn = Net::net_accept(listener)
        current_state = handle_connection(conn, current_state)
    }
}

fn main(args: list) -> void {
    let port = to_int(arg_value(args, "--port", to_string(DEFAULT_PORT)))
    let web  = arg_value(args, "--web", DEFAULT_WEB_DIR)
    let state = ServerState {
        port: port,
        web_dir: web,
        requests_served: 0,
        signups: 0,
        start_time_ms: timestamp()
    }
    serve(state)
}
