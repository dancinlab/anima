// HER/service/her_tts.hexa — her's VOICE (Gemini TTS), not her mind.
//
// Identity boundary (memory: gemini-voice-not-mind):
//   her's WORDS come from her own substrate/decoder — NEVER from Gemini. This file only
//   turns text she ALREADY decided into audio (text → speech). Gemini here is vocal cords,
//   not a mind. This single peripheral call satisfies XPRIZE R3 ("≥1 Gemini API call").
//
// Gemini 2.5 TTS (generateContent, AUDIO modality):
//   POST .../models/gemini-2.5-flash-preview-tts:generateContent?key=KEY
//   body { contents:[{parts:[{text}]}],
//          generationConfig:{ responseModalities:["AUDIO"],
//            speechConfig:{ voiceConfig:{ prebuiltVoiceConfig:{ voiceName }}}}}
//   reply candidates[0].content.parts[0].inlineData.data = base64 PCM (L16, 24kHz mono)
//
// hexa-native, no compiler change: shapes the request + exec(curl) POST (like her_publish).
// CLI: GOOGLE_API_KEY=$(secret get gemini.api_key) HER_TTS_TEXT="..." hexa HER/service/her_tts.hexa

comptime const TTS_MODEL = "gemini-2.5-flash-preview-tts"
comptime const TTS_BASE  = "https://generativelanguage.googleapis.com/v1beta/models/"
comptime const RESP_FILE = "/tmp/her_voice.json"   // raw Gemini response (holds inlineData audio)
comptime const PCM_FILE  = "/tmp/her_voice.pcm"    // decoded raw PCM
comptime const WAV_FILE  = "/tmp/her_voice.wav"    // playable WAV (PCM + 44-byte header)

// API key — GOOGLE_API_KEY preferred, GEMINI_API_KEY fallback (inject via `secret get`).
fn tts_api_key() -> string {
    let primary = env("GOOGLE_API_KEY")
    if len(primary) > 0 { return primary }
    env("GEMINI_API_KEY")
}

// her's voice — env HER_VOICE, default "Aoede" (breezy, warm — fits her).
fn her_voice_name() -> string {
    let v = env("HER_VOICE")
    if len(v) > 0 { return v }
    "Aoede"
}

fn tts_url() -> string { TTS_BASE + TTS_MODEL + ":generateContent?key=" + tts_api_key() }

// JSON request body for one utterance. json_stringify(text) safely escapes her words.
fn tts_body(text: string) -> string {
    "{\"contents\":[{\"parts\":[{\"text\":" + json_stringify(text) + "}]}],"
        + "\"generationConfig\":{\"responseModalities\":[\"AUDIO\"],"
        + "\"speechConfig\":{\"voiceConfig\":{\"prebuiltVoiceConfig\":{\"voiceName\":\""
        + her_voice_name() + "\"}}}}}"
}

// Synthesize: POST her text → save raw response → decode base64 PCM → wrap as WAV.
// Returns the audio byte count (0 = failure). The Gemini call here IS the R3 call.
fn her_voice(text: string) -> int {
    if len(tts_api_key()) == 0 {
        println("[her_tts] no GOOGLE_API_KEY — voice unavailable (words still her own)")
        return 0
    }
    write_file("/tmp/her_tts_body.json", tts_body(text))
    let _ = exec("curl -s -X POST -H 'Content-Type: application/json' --data-binary @/tmp/her_tts_body.json '"
                 + tts_url() + "' -o " + RESP_FILE)
    // extract base64 audio → raw PCM → WAV (24kHz, 16-bit, mono). python3 is the host's audio tool.
    let _ = exec("python3 - <<'PY'\n"
        + "import json,base64,struct\n"
        + "d=json.load(open('" + RESP_FILE + "'))\n"
        + "try:\n"
        + "    b=d['candidates'][0]['content']['parts'][0]['inlineData']['data']\n"
        + "except Exception:\n"
        + "    open('" + PCM_FILE + "','wb').close(); raise SystemExit\n"
        + "pcm=base64.b64decode(b); open('" + PCM_FILE + "','wb').write(pcm)\n"
        + "sr=24000; ch=1; bps=16; br=sr*ch*bps//8; ba=ch*bps//8; n=len(pcm)\n"
        + "h=b'RIFF'+struct.pack('<I',36+n)+b'WAVEfmt '+struct.pack('<IHHIIHH',16,1,ch,sr,br,ba,bps)+b'data'+struct.pack('<I',n)\n"
        + "open('" + WAV_FILE + "','wb').write(h+pcm)\n"
        + "PY")
    let bytes = to_int(exec("wc -c < " + PCM_FILE + " 2>/dev/null | tr -d ' \\n'"))
    if bytes > 0 {
        println("[her_tts] voice=" + her_voice_name() + " → " + to_string(bytes) + " PCM bytes → " + WAV_FILE)
    } else {
        println("[her_tts] no audio in response (see " + RESP_FILE + ")")
    }
    bytes
}

fn main() {
    let text = env("HER_TTS_TEXT")
    if len(text) == 0 {
        println("usage: GOOGLE_API_KEY=$(secret get gemini.api_key) HER_TTS_TEXT=\"<her words>\" hexa HER/service/her_tts.hexa")
        return
    }
    let _ = her_voice(text)
}
