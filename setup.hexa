// anima/setup.hexa — Anima Setup (hexa-native)
//
// Usage:
//   $HEXA anima/setup.hexa             # full install
//   $HEXA anima/setup.hexa --minimal   # minimal install
//
// Hexa-only: no pip, no cargo, no maturin. The hexa binary itself ships with
// all required runtime; this script only verifies presence and downloads
// model checkpoints. Runs as the `hx install anima` setup hook.

fn main() {
    let argv = args()
    let minimal = argv.contains("--minimal")

    println("=== Anima Setup (hexa-native) ===")
    if minimal { println("[--] minimal install") }

    // ─── Hexa runtime check ───
    // Prefer $HEXA (set by `hx install`), else resolve from PATH via `command -v`.
    let hexa_env = env_var("HEXA")
    let hexa_bin = if hexa_env != "" { hexa_env } else { exec("command -v hexa").trim() }
    if hexa_bin == "" || !file_exists(hexa_bin) {
        println("[!!] hexa binary not found ($HEXA unset and not on PATH)")
        println("     Install: see https://github.com/dancinlab/hexa-lang")
        exit(1)
    }
    println("[OK] hexa runtime — " + hexa_bin)

    // ─── External system tools (best-effort hint) ───
    let uname = exec("uname").trim()
    if uname == "Darwin" {
        println("[--] macOS — verify brew installs of: portaudio, opencv, whisper-cli")
    }

    // ─── Checkpoint download (best-effort) ───
    exec("mkdir -p checkpoints/clm_v2")
    let ckpt = "checkpoints/clm_v2/final.pt"
    if !file_exists(ckpt) {
        println("downloading checkpoint...")
        exec("curl -fsSL -o " + ckpt + " https://pub-41380137f47b4c4cbc79f5502935b2e9.r2.dev/clm-v2/latest.pt")
        if !file_exists(ckpt) {
            println("[!!] checkpoint download failed (will retry on first run)")
        }
    }

    // ─── `anima` PATH shim (the installed command) ───
    // hx symlinks ~/.hx/bin/<name> → <pkg>/bin/<name> for the hexa.toml [[bin]] entry,
    // but install hooks run before that symlink is guaranteed, so make it idempotently
    // here too: ensure ~/.hx/bin/anima → <pkg>/bin/anima (the canonical-entry launcher).
    // After this the user types `anima train …` / `anima serialize …` / `anima evaluate
    // …` directly — never `hexa run cli/anima.hexa -- …` (a_install_canonical single entry).
    let pkg_dir = exec("pwd").trim()
    let shim_src = pkg_dir + "/bin/anima"
    if file_exists(shim_src) {
        // resolve hx bin dir: $HX_BIN_DIR (set by hx install), else ~/.hx/bin.
        let hx_bin_env = env_var("HX_BIN_DIR")
        let home = env_var("HOME")
        let hx_bin = if hx_bin_env != "" { hx_bin_env } else { home + "/.hx/bin" }
        exec("mkdir -p '" + hx_bin + "'")
        exec("chmod +x '" + shim_src + "'")
        // overwrite any stale shim → fresh symlink to the canonical-entry launcher.
        exec("ln -sf '" + shim_src + "' '" + hx_bin + "/anima'")
        if file_exists(hx_bin + "/anima") {
            println("[OK] `anima` PATH command -> " + hx_bin + "/anima (→ bin/anima → cli/anima.hexa)")
        } else {
            println("[!!] could not install `anima` shim at " + hx_bin + "/anima (PATH command unavailable)")
        }
    } else {
        println("[!!] bin/anima launcher missing — `anima` PATH command NOT installed")
    }

    println("[OK] setup complete")
    println("Run: anima evaluate <model.clm>   |   anima train <args>   |   anima serialize <pt> <clm>")
}
