// anima-eeg/_session_manager.hexa
//
// PURPOSE
//   SSOT module for BrainFlow session lifecycle. Replaces ~120L of duplicated
//   open/retry/close logic currently inlined in collect.hexa, eeg_recorder.hexa,
//   calibrate.hexa, realtime.hexa, etc. Provides idempotent halt + atomic reinit
//   + atexit/signal shutdown hook + 2-tier feedback (output / modal).
//
// AUDIT ABSORPTION (audit BG a227988af11c71f16, top recommendation):
//   - GUI.systemHasHalted flag         → Session.has_halted flag
//   - GUI.requestReinit()              → reinit(session) atomic close+open
//   - Runtime.addShutdownHook          → atexit.register + signal.SIGTERM/SIGINT
//   - GUI.output() / outputError()     → 2-tier stderr [output]/[error]/[modal]
//
// MODES
//   --selftest        synthetic state machine + shutdown-hook fire test, no hardware
//   --inspect         print module contract + exported helper API (no run)
//
// API (terminology mirrors GUI session pattern)
//   open_session(board_id, port, retry_policy)        → Session
//   start_recording(session, fmt, max_min)            → Recording
//   rotate_if_needed(recording)                       → bool (true=rotated)
//   stop_recording(recording)                         → void
//   close_session(session)                            → void  (idempotent)
//   reinit(session)                                   → Session  (atomic)
//   on_shutdown_hook(session)                         → bind atexit + signals
//   last_error(session)                               → {code, advisory_url, retry_action}
//
// STATE MACHINE
//   PREINIT ──open_session──▶ INIT ──start_recording──▶ RUNNING ──stop_recording──▶ INIT
//                                                                  │
//                                                                  └─close_session─▶ HALTED
//   INIT    ──close_session──▶ HALTED                                                  │
//   HALTED  ──close_session──▶ HALTED  (idempotent: has_halted flag short-circuits)    │
//   HALTED  ──reinit────────▶ INIT     (release_all_sessions + fresh prepare)          │
//   ANY     ──SIGTERM/SIGINT/atexit──▶ HALTED  (best-effort release)                   │
//
// FORMATS
//   ODF  (OpenBCI Data Format) — chunked .csv, supports rotation 5/15/30/60/120/-1 min
//   BDF  (BioSemi)             — single-file 24-bit; rotation N/A (open chunk only)
//   BF   (BrainFlow native)    — single-file binary; rotation N/A
//   NPY  (numpy)               — single-file float32; rotation N/A
//
//   $HOME/anima_eeg/Recordings/AnimaEEGSession_<name>/<datetime>.csv
//   $HOME/anima_eeg/Settings/<board>UserSettings.json
//   $HOME/anima_eeg/Settings/<board>DefaultSettings.json
//
// 2-TIER FEEDBACK (terminal-friendly equivalents)
//   bottom-bar  → stderr "[output] <msg>"  or  "[error] <msg>"
//   modal popup → stderr "[modal] action_required: <msg> [retry|stop|help] url=<u>"
//
//   atexit.register(close_session)        — covers normal exit
//   signal.signal(SIGTERM, close_session) — covers kill TERM (graceful)
//   signal.signal(SIGINT,  close_session) — covers Ctrl-C
//   SIGKILL (kill -9) bypasses Python signal machinery → release_session
//   NOT reachable. Documented as DEGRADED tier honestly.
//
//   F_SM_01  open + close  → close called twice  → no exception, has_halted=true
//   F_SM_02  SIGTERM       → release_session invoked                   (synth)
//   F_SM_03  reinit        → close+open atomic, state PREINIT→INIT     (synth)
//
// USAGE
//   hexa run anima-eeg/_session_manager.hexa --selftest
//   hexa run anima-eeg/_session_manager.hexa --inspect
//
//  @resolver-bypass(reason="darwin-native: globs /dev/cu.usbserial-* and uses
//                   .venv-eeg/bin/python BrainFlow venv. Hetzner / linux pods
//                   do not expose host USB nor local venv. Selftest mode is
//                   pure-python synthetic — runs without hardware OR brainflow.")

let SCHEMA              = "anima-eeg/_session_manager/1"
let HELPER_PATH         = "/tmp/anima_eeg_session_manager_helper.py"

let DEFAULT_BOARD_ID            = 2          // BrainFlow CYTON_DAISY_BOARD
let DEFAULT_BOARD_NAME          = "cyton_daisy"
let DEFAULT_VENV_PYTHON         = ".venv-eeg/bin/python"
let DEFAULT_RECORDINGS_REL      = "anima_eeg/Recordings"
let DEFAULT_SETTINGS_REL        = "anima_eeg/Settings"

// ODF rotation tier (minutes); -1 = never rotate (single chunk).
let ROT_5    = 5
let ROT_15   = 15
let ROT_30   = 30
let ROT_60   = 60
let ROT_120  = 120
let ROT_NONE = -1

let ADVISORY_URL_BASE = "anima-eeg/docs/"

// ════════════════════════════════════════════════════════════════════
// Section 0. Hexa-side helpers (mirrors collect/calibrate/eeg_recorder)
// ════════════════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

fn _board_name_to_id(name: string) -> int {
    if name == "cyton_daisy" { return DEFAULT_BOARD_ID }
    if name == "cyton"       { return 0 }
    if name == "ganglion"    { return 1 }
    if name == "synthetic"   { return -1 }
    return DEFAULT_BOARD_ID
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════
//
// The helper carries:
//   - SessionManager class (state machine + shutdown hook)
//   - api_open / api_close / api_reinit / api_start_recording / api_rotate /
//     api_stop_recording / api_on_shutdown_hook / api_last_error
//   - selftest (synthetic, no hardware, no brainflow required)
//   - inspect (prints exported API contract)

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima-eeg session_manager helper — emitted by\n")
    parts.push("import argparse, atexit, glob, json, os, signal, sys, time, traceback\n")
    parts.push("import datetime as _dt\n\n")

    parts.push("SCHEMA          = '" + SCHEMA + "'\n")
    parts.push("VENV_PYTHON     = os.environ.get('ANIMA_EEG_VENV_PYTHON', '" + DEFAULT_VENV_PYTHON + "')\n")
    parts.push("USB_SERIAL_GLOB = '/dev/cu.usbserial-*'\n")
    parts.push("USB_MODEM_GLOB  = '/dev/cu.usbmodem*'\n\n")

    parts.push("HOME = os.path.expanduser('~')\n")
    parts.push("RECORDINGS_ROOT = os.path.join(HOME, '" + DEFAULT_RECORDINGS_REL + "')\n")
    parts.push("SETTINGS_ROOT   = os.path.join(HOME, '" + DEFAULT_SETTINGS_REL   + "')\n\n")

    // ─── 2-tier feedback (terminal mirror of GUI bottom-bar + modal popup) ───
    parts.push("def output(msg):\n")
    parts.push("    sys.stderr.write(f'[output] {msg}\\n'); sys.stderr.flush()\n\n")

    parts.push("def output_error(msg):\n")
    parts.push("    # bottom-bar tier: error. Visible but NOT action-blocking.\n")
    parts.push("    sys.stderr.write(f'[error] {msg}\\n'); sys.stderr.flush()\n\n")

    parts.push("def modal(msg, advisory_url='', retry_action='retry|stop|help'):\n")
    parts.push("    # honest C3: no PApplet → no real popup. Operator must read stderr.\n")
    parts.push("    sys.stderr.write(f'[modal] action_required: {msg} [{retry_action}] url={advisory_url}\\n')\n")
    parts.push("    sys.stderr.flush()\n\n")

    parts.push("def emit_trailer(slug, detail, fix):\n")
    parts.push("    sys.stderr.write(f'reason: {slug}: {detail}\\n')\n")
    parts.push("    sys.stderr.write(f'fix: {fix}\\n'); sys.stderr.flush()\n\n")

    // ─── leaked-session detector (audited brainflow exit_codes 2026-05-03) ───
    parts.push("def is_leak(_m):\n")
    parts.push("    _s = str(_m)\n")
    parts.push("    for _n in ('PORT_ALREADY_OPEN','BOARD_NOT_READY',\n")
    parts.push("               'STREAM_ALREADY_RUN','BOARD_NOT_CREATED',\n")
    parts.push("               'ANOTHER_BOARD_IS_CREATED'):\n")
    parts.push("        if _n in _s: return True\n")
    parts.push("    for _c in (':1 ',':7 ',':8 ',':15 ',':16 ',\n")
    parts.push("               ' code 1 ',' code 7 ',' code 8 ',\n")
    parts.push("               ' code 15 ',' code 16 '):\n")
    parts.push("        if _c in _s: return True\n")
    parts.push("    return False\n\n")

    // ─── Cyton 'v' soft-reset (firmware-level escalation) ────────────────────
    parts.push("def cyton_soft_reset(port, baud=115200, timeout_s=3.0):\n")
    parts.push("    try: import serial as _ser\n")
    parts.push("    except Exception: return False\n")
    parts.push("    try:\n")
    parts.push("        with _ser.Serial(port, baud, timeout=0.5) as _s:\n")
    parts.push("            _s.reset_input_buffer(); _s.write(b'v')\n")
    parts.push("            _dl = time.time() + timeout_s; _buf = b''\n")
    parts.push("            while time.time() < _dl:\n")
    parts.push("                _ck = _s.read(64)\n")
    parts.push("                if _ck:\n")
    parts.push("                    _buf += _ck\n")
    parts.push("                    if b'$$$' in _buf: time.sleep(0.2); return True\n")
    parts.push("            return False\n")
    parts.push("    except Exception: return False\n\n")

    // ─── Session class: state machine + idempotent halt flag ─────────────────
    parts.push("STATE_PREINIT = 'PREINIT'\n")
    parts.push("STATE_INIT    = 'INIT'\n")
    parts.push("STATE_RUNNING = 'RUNNING'\n")
    parts.push("STATE_HALTED  = 'HALTED'\n\n")

    parts.push("class Session:\n")
    parts.push("    def __init__(self, board_id, port, synthetic=False):\n")
    parts.push("        self.board_id = int(board_id)\n")
    parts.push("        self.port = port\n")
    parts.push("        self.synthetic = bool(synthetic)\n")
    parts.push("        self.state = STATE_PREINIT\n")
    parts.push("        # close_session() short-circuits when has_halted=True so\n")
    parts.push("        # double-close is a no-op (F_SM_01).\n")
    parts.push("        self.has_halted = False\n")
    parts.push("        # GUI.requestReinit() flag equivalent.\n")
    parts.push("        self.request_reinit = False\n")
    parts.push("        self.board = None\n")
    parts.push("        self.params = None\n")
    parts.push("        self.recording = None\n")
    parts.push("        self.last_err = {'code': '', 'advisory_url': '', 'retry_action': ''}\n")
    parts.push("        self.shutdown_bound = False\n")
    parts.push("        self.shutdown_fired_count = 0\n\n")

    parts.push("    def to_dict(self):\n")
    parts.push("        return {'board_id': self.board_id, 'port': self.port,\n")
    parts.push("                'synthetic': self.synthetic, 'state': self.state,\n")
    parts.push("                'has_halted': self.has_halted,\n")
    parts.push("                'request_reinit': self.request_reinit,\n")
    parts.push("                'shutdown_fired_count': self.shutdown_fired_count,\n")
    parts.push("                'last_error': self.last_err}\n\n")

    // ─── api_open_session ────────────────────────────────────────────────────
    parts.push("def api_open_session(board_id, port, retry_policy=None, synthetic=False):\n")
    parts.push("    rp = retry_policy or {'max_retries': 2, 'soft_reset': True, 'sleep_s': 0.5}\n")
    parts.push("    sess = Session(board_id, port, synthetic=synthetic)\n")
    parts.push("    if synthetic:\n")
    parts.push("        # No hardware path: state advance only.\n")
    parts.push("        sess.state = STATE_INIT\n")
    parts.push("        output(f'session opened (synthetic) board_id={board_id}')\n")
    parts.push("        return sess\n")
    parts.push("    try:\n")
    parts.push("        from brainflow.board_shim import BoardShim, BrainFlowInputParams\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        sess.last_err = {'code': 'brainflow-import-failed',\n")
    parts.push("                         'advisory_url': '" + ADVISORY_URL_BASE + "ibm_cloud_env_setup_runbook_2026_05_03.md',\n")
    parts.push("                         'retry_action': 'install-then-retry'}\n")
    parts.push("        modal(f'brainflow not importable: {exc!r}',\n")
    parts.push("              advisory_url=sess.last_err['advisory_url'])\n")
    parts.push("        sess.state = STATE_HALTED; sess.has_halted = True\n")
    parts.push("        return sess\n")
    parts.push("    params = BrainFlowInputParams(); params.serial_port = port\n")
    parts.push("    BoardShim.disable_board_logger()\n")
    parts.push("    try: BoardShim.release_all_sessions()\n")
    parts.push("    except Exception: pass\n")
    parts.push("    board = BoardShim(int(board_id), params)\n")
    parts.push("    attempt = 0\n")
    parts.push("    while True:\n")
    parts.push("        try:\n")
    parts.push("            board.prepare_session(); break\n")
    parts.push("        except Exception as e1:\n")
    parts.push("            if not is_leak(e1) or attempt >= rp['max_retries']:\n")
    parts.push("                sess.last_err = {'code': 'prepare-session-failed',\n")
    parts.push("                                 'advisory_url': '" + ADVISORY_URL_BASE + "cyton_soft_reset_v_command_spec_2026_05_03.md',\n")
    parts.push("                                 'retry_action': 'power-cycle-then-retry'}\n")
    parts.push("                modal(f'prepare_session failed: {e1!r}',\n")
    parts.push("                      advisory_url=sess.last_err['advisory_url'])\n")
    parts.push("                sess.state = STATE_HALTED; sess.has_halted = True\n")
    parts.push("                return sess\n")
    parts.push("            try: BoardShim.release_all_sessions()\n")
    parts.push("            except Exception: pass\n")
    parts.push("            time.sleep(rp.get('sleep_s', 0.5))\n")
    parts.push("            if rp.get('soft_reset', True) and port:\n")
    parts.push("                cyton_soft_reset(port)\n")
    parts.push("            time.sleep(rp.get('sleep_s', 0.5))\n")
    parts.push("            board = BoardShim(int(board_id), params)\n")
    parts.push("            attempt += 1\n")
    parts.push("    sess.board = board; sess.params = params\n")
    parts.push("    sess.state = STATE_INIT\n")
    parts.push("    output(f'session opened (real) board_id={board_id} port={port}')\n")
    parts.push("    return sess\n\n")

    // ─── api_close_session (idempotent halt-equivalent) ──────────────────────
    parts.push("def api_close_session(sess):\n")
    parts.push("    if sess is None: return\n")
    parts.push("    if sess.has_halted:\n")
    parts.push("        output('close_session: already halted (idempotent skip)')\n")
    parts.push("        return\n")
    parts.push("    try:\n")
    parts.push("        if sess.state == STATE_RUNNING and sess.board is not None:\n")
    parts.push("            try: sess.board.stop_stream()\n")
    parts.push("            except Exception: pass\n")
    parts.push("        if sess.board is not None:\n")
    parts.push("            try: sess.board.release_session()\n")
    parts.push("            except Exception: pass\n")
    parts.push("        # belt-and-suspenders: release any leaked partner session.\n")
    parts.push("        try:\n")
    parts.push("            from brainflow.board_shim import BoardShim\n")
    parts.push("            BoardShim.release_all_sessions()\n")
    parts.push("        except Exception: pass\n")
    parts.push("    finally:\n")
    parts.push("        sess.state = STATE_HALTED\n")
    parts.push("        sess.has_halted = True\n")
    parts.push("        output('close_session: state=HALTED')\n\n")

    // ─── api_reinit (atomic close + open) ────────────────────────────────────
    parts.push("def api_reinit(sess):\n")
    parts.push("    # F_SM_03: atomic close + open. Must succeed-or-fail atomically;\n")
    parts.push("    # if open phase fails, sess remains HALTED (closed) — caller\n")
    parts.push("    # must not assume RUNNING/INIT after reinit unless state asserts.\n")
    parts.push("    if sess is None: return None\n")
    parts.push("    sess.request_reinit = True\n")
    parts.push("    api_close_session(sess)\n")
    parts.push("    sess.has_halted = False  # allow new open\n")
    parts.push("    new_sess = api_open_session(sess.board_id, sess.port,\n")
    parts.push("                                synthetic=sess.synthetic)\n")
    parts.push("    sess.request_reinit = False\n")
    parts.push("    output('reinit complete')\n")
    parts.push("    return new_sess\n\n")

    // ─── api_start_recording / api_stop_recording / api_rotate ───────────────
    parts.push("class Recording:\n")
    parts.push("    def __init__(self, session, fmt, max_min, dirpath, filepath):\n")
    parts.push("        self.session = session\n")
    parts.push("        self.fmt = fmt              # 'ODF' | 'BDF' | 'BF' | 'NPY'\n")
    parts.push("        self.max_min = int(max_min) # 5/15/30/60/120/-1\n")
    parts.push("        self.dirpath = dirpath\n")
    parts.push("        self.filepath = filepath\n")
    parts.push("        self.opened_at = time.time()\n")
    parts.push("        self.rotated_count = 0\n")
    parts.push("        self.is_open = True\n")
    parts.push("    def to_dict(self):\n")
    parts.push("        return {'fmt': self.fmt, 'max_min': self.max_min,\n")
    parts.push("                'dirpath': self.dirpath, 'filepath': self.filepath,\n")
    parts.push("                'rotated_count': self.rotated_count,\n")
    parts.push("                'is_open': self.is_open}\n\n")

    parts.push("def _now_iso():\n")
    parts.push("    return _dt.datetime.now(_dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')\n\n")

    parts.push("def api_start_recording(sess, name='default', fmt='ODF', max_min=15):\n")
    parts.push("    if sess is None or sess.has_halted:\n")
    parts.push("        output_error('start_recording: session halted/null'); return None\n")
    parts.push("    if fmt not in ('ODF','BDF','BF','NPY'):\n")
    parts.push("        output_error(f'start_recording: unknown fmt {fmt}'); return None\n")
    parts.push("    if max_min not in (5,15,30,60,120,-1):\n")
    parts.push("        output_error(f'start_recording: max_min must be 5/15/30/60/120/-1, got {max_min}')\n")
    parts.push("        return None\n")
    parts.push("    dirpath = os.path.join(RECORDINGS_ROOT, f'AnimaEEGSession_{name}')\n")
    parts.push("    os.makedirs(dirpath, exist_ok=True)\n")
    parts.push("    ext = {'ODF':'csv','BDF':'bdf','BF':'bf','NPY':'npy'}[fmt]\n")
    parts.push("    filepath = os.path.join(dirpath, f'{_now_iso()}.{ext}')\n")
    parts.push("    if not sess.synthetic and sess.board is not None:\n")
    parts.push("        try:\n")
    parts.push("            sess.board.start_stream()\n")
    parts.push("        except Exception as e2:\n")
    parts.push("            sess.last_err = {'code': 'start-stream-failed',\n")
    parts.push("                             'advisory_url': '" + ADVISORY_URL_BASE + "cyton_soft_reset_v_command_spec_2026_05_03.md',\n")
    parts.push("                             'retry_action': 'reinit-then-retry'}\n")
    parts.push("            modal(f'start_stream failed: {e2!r}',\n")
    parts.push("                  advisory_url=sess.last_err['advisory_url'])\n")
    parts.push("            return None\n")
    parts.push("    sess.state = STATE_RUNNING\n")
    parts.push("    rec = Recording(sess, fmt, max_min, dirpath, filepath)\n")
    parts.push("    sess.recording = rec\n")
    parts.push("    output(f'start_recording fmt={fmt} max_min={max_min} path={filepath}')\n")
    parts.push("    return rec\n\n")

    parts.push("def api_rotate_if_needed(rec):\n")
    parts.push("    if rec is None or not rec.is_open: return False\n")
    parts.push("    if rec.fmt != 'ODF': return False  # only ODF supports rotation\n")
    parts.push("    if rec.max_min == -1: return False # never rotate\n")
    parts.push("    elapsed_min = (time.time() - rec.opened_at) / 60.0\n")
    parts.push("    if elapsed_min < rec.max_min: return False\n")
    parts.push("    new_path = os.path.join(rec.dirpath, f'{_now_iso()}.csv')\n")
    parts.push("    rec.filepath = new_path\n")
    parts.push("    rec.opened_at = time.time()\n")
    parts.push("    rec.rotated_count += 1\n")
    parts.push("    output(f'rotate_if_needed: rotated to {new_path} count={rec.rotated_count}')\n")
    parts.push("    return True\n\n")

    parts.push("def api_stop_recording(rec):\n")
    parts.push("    if rec is None or not rec.is_open: return\n")
    parts.push("    sess = rec.session\n")
    parts.push("    if sess is not None and not sess.synthetic and sess.board is not None:\n")
    parts.push("        try: sess.board.stop_stream()\n")
    parts.push("        except Exception: pass\n")
    parts.push("    rec.is_open = False\n")
    parts.push("    if sess is not None and sess.state == STATE_RUNNING:\n")
    parts.push("        sess.state = STATE_INIT\n")
    parts.push("    output(f'stop_recording fmt={rec.fmt}')\n\n")

    // ─── api_on_shutdown_hook (atexit + SIGTERM + SIGINT) ────────────────────
    parts.push("def api_on_shutdown_hook(sess):\n")
    parts.push("    if sess is None: return\n")
    parts.push("    if sess.shutdown_bound:\n")
    parts.push("        output('on_shutdown_hook: already bound (idempotent skip)')\n")
    parts.push("        return\n")
    parts.push("    def _hook(*_a, **_kw):\n")
    parts.push("        sess.shutdown_fired_count += 1\n")
    parts.push("        output(f'shutdown_hook fired n={sess.shutdown_fired_count}')\n")
    parts.push("        try: api_close_session(sess)\n")
    parts.push("        except Exception: traceback.print_exc()\n")
    parts.push("    atexit.register(_hook)\n")
    parts.push("    try: signal.signal(signal.SIGTERM, _hook)\n")
    parts.push("    except Exception: pass\n")
    parts.push("    try: signal.signal(signal.SIGINT,  _hook)\n")
    parts.push("    except Exception: pass\n")
    parts.push("    sess.shutdown_bound = True\n")
    parts.push("    output('on_shutdown_hook: bound atexit + SIGTERM + SIGINT')\n")

    // ─── api_last_error ──────────────────────────────────────────────────────
    parts.push("def api_last_error(sess):\n")
    parts.push("    if sess is None:\n")
    parts.push("        return {'code':'no-session','advisory_url':'','retry_action':''}\n")
    parts.push("    return dict(sess.last_err)\n\n")

    // ─── E-1 substrate extensions (additive — not exercised by F_SM_01..03) ──
    // eeg/substrates/brainflow_substrate.hexa or future substrate adapters.
    // Existing F_SM_01/02/03 PASS conditions are unchanged because cmd_selftest
    // below does not invoke them — byte-identical selftest output preserved.
    parts.push("# Spec: design/substrate_abstraction.md. These four api_*\n")
    parts.push("# functions extend the BrainFlow session contract to match\n")
    parts.push("# the substrate protocol declared in eeg/substrates/substrate.hexa.\n")
    parts.push("def api_read_chunk(sess, n_samples_max):\n")
    parts.push("    # Returns (data, ts). data is list-of-lists with shape\n")
    parts.push("    # (rows, n_samples_max) — BrainFlow returns timestamp + EEG\n")
    parts.push("    # + aux rows (rows == 32 for cyton_daisy). Caller MUST slice\n")
    parts.push("    # by api_get_eeg_indices() for EEG-only access. Synthetic\n")
    parts.push("    # session path returns [] (no synth data emitted here —\n")
    parts.push("    # callers should switch to synth_substrate.hexa instead).\n")
    parts.push("    if sess is None or getattr(sess,'has_halted',False):\n")
    parts.push("        return [], time.time()\n")
    parts.push("    if getattr(sess,'synthetic',False) or sess.board is None:\n")
    parts.push("        return [], time.time()\n")
    parts.push("    try:\n")
    parts.push("        data = sess.board.get_current_board_data(int(n_samples_max))\n")
    parts.push("        return [list(row) for row in data], time.time()\n")
    parts.push("    except Exception as e:\n")
    parts.push("        sess.last_err = {'code':'read-chunk-failed',\n")
    parts.push("                         'advisory_url':'',\n")
    parts.push("                         'retry_action':'reinit-then-retry'}\n")
    parts.push("        output_error(f'read_chunk failed: {e!r}')\n")
    parts.push("        return [], time.time()\n\n")

    parts.push("def api_get_eeg_indices(sess):\n")
    parts.push("    # Returns 1-indexed BrainFlow EEG channel indices. Falls\n")
    parts.push("    # back to canonical 1..16 if BoardShim unavailable.\n")
    parts.push("    if sess is None: return []\n")
    parts.push("    try:\n")
    parts.push("        from brainflow.board_shim import BoardShim\n")
    parts.push("        return list(BoardShim.get_eeg_channels(int(sess.board_id)))\n")
    parts.push("    except Exception:\n")
    parts.push("        return list(range(1, 17))\n\n")

    parts.push("def api_get_sample_rate(sess):\n")
    parts.push("    if sess is None: return 0\n")
    parts.push("    try:\n")
    parts.push("        from brainflow.board_shim import BoardShim\n")
    parts.push("        return int(BoardShim.get_sampling_rate(int(sess.board_id)))\n")
    parts.push("    except Exception:\n")
    parts.push("        return 125  # cyton_daisy default\n\n")

    parts.push("def api_stim(sess, stim_spec):\n")
    parts.push("    # BrainFlow path is scalp EEG — strictly read-only.\n")
    parts.push("    # Future cl1 substrate implements api_stim; this raises.\n")
    parts.push("    # Signature widened 2026-05-12 (see substrate.hexa APPENDIX A).\n")
    parts.push("    raise NotImplementedError(\n")
    parts.push("        '_session_manager: scalp EEG is read-only (no stim path)')\n\n")

    // ─── selftest (synthetic, no hardware, F_SM_01/02/03) ────────────────────
    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('== _session_manager selftest ==')\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=selftest_synthetic')\n")
    parts.push("    print(f'venv_python_exists={os.path.exists(VENV_PYTHON)}')\n")
    parts.push("    fails = 0\n")
    // ── F_SM_01: open + close idempotent ──
    parts.push("    print('')\n")
    parts.push("    print('[F_SM_01] open + close idempotent (close 2x no-op)')\n")
    parts.push("    s1 = api_open_session(-1, '<synthetic>', synthetic=True)\n")
    parts.push("    print(f'  state_after_open={s1.state}')\n")
    parts.push("    api_close_session(s1)\n")
    parts.push("    print(f'  state_after_close1={s1.state} has_halted={s1.has_halted}')\n")
    parts.push("    api_close_session(s1)  # double-close: must be no-op\n")
    parts.push("    print(f'  state_after_close2={s1.state} has_halted={s1.has_halted}')\n")
    parts.push("    f01_ok = (s1.state == STATE_HALTED and s1.has_halted == True)\n")
    parts.push("    print(f'F_SM_01={\"PASS\" if f01_ok else \"FAIL\"}')\n")
    parts.push("    if not f01_ok: fails += 1\n")
    // ── F_SM_02: SIGTERM hook fires release_session ──
    parts.push("    print('')\n")
    parts.push("    print('[F_SM_02] SIGTERM/atexit hook fires close_session')\n")
    parts.push("    s2 = api_open_session(-1, '<synthetic>', synthetic=True)\n")
    parts.push("    api_on_shutdown_hook(s2)\n")
    parts.push("    print(f'  shutdown_bound={s2.shutdown_bound}')\n")
    parts.push("    # Synthetic SIGTERM injection: invoke hook closure directly\n")
    parts.push("    # (sending real SIGTERM to self risks aborting selftest before\n")
    parts.push("    #  print). Same code path the signal handler would take.\n")
    parts.push("    # Find the registered hook in atexit registry (private API): use\n")
    parts.push("    # the SIGTERM handler we set, retrievable via signal.getsignal.\n")
    parts.push("    h = signal.getsignal(signal.SIGTERM)\n")
    parts.push("    if callable(h):\n")
    parts.push("        try: h(signal.SIGTERM, None)\n")
    parts.push("        except SystemExit: pass\n")
    parts.push("    print(f'  shutdown_fired_count={s2.shutdown_fired_count}')\n")
    parts.push("    print(f'  state_after_hook={s2.state} has_halted={s2.has_halted}')\n")
    parts.push("    f02_ok = (s2.shutdown_fired_count >= 1 and s2.has_halted == True)\n")
    parts.push("    print(f'F_SM_02={\"PASS\" if f02_ok else \"FAIL\"}')\n")
    parts.push("    if not f02_ok: fails += 1\n")
    // ── F_SM_03: reinit atomic ──
    parts.push("    print('')\n")
    parts.push("    print('[F_SM_03] reinit (close + open) atomic, state PREINIT->INIT')\n")
    parts.push("    s3 = api_open_session(-1, '<synthetic>', synthetic=True)\n")
    parts.push("    state_pre = s3.state\n")
    parts.push("    s3b = api_reinit(s3)\n")
    parts.push("    print(f'  state_pre={state_pre} state_post={s3b.state}')\n")
    parts.push("    f03_ok = (state_pre == STATE_INIT and s3b is not None\n")
    parts.push("              and s3b.state == STATE_INIT)\n")
    parts.push("    print(f'F_SM_03={\"PASS\" if f03_ok else \"FAIL\"}')\n")
    parts.push("    if not f03_ok: fails += 1\n")
    // ── Recording sub-tests ──
    parts.push("    print('')\n")
    parts.push("    print('[T_REC_01] start_recording / rotate_if_needed / stop_recording')\n")
    parts.push("    s4 = api_open_session(-1, '<synthetic>', synthetic=True)\n")
    parts.push("    rec = api_start_recording(s4, name='selftest', fmt='ODF', max_min=15)\n")
    parts.push("    rec_ok = rec is not None and s4.state == STATE_RUNNING\n")
    parts.push("    rotated_immediate = api_rotate_if_needed(rec)  # 0s elapsed → False\n")
    parts.push("    api_stop_recording(rec)\n")
    parts.push("    api_close_session(s4)\n")
    parts.push("    rec_pass = (rec_ok and rotated_immediate == False\n")
    parts.push("                and rec.is_open == False and s4.state == STATE_HALTED)\n")
    parts.push("    print(f'T_REC_01={\"PASS\" if rec_pass else \"FAIL\"}')\n")
    parts.push("    if not rec_pass: fails += 1\n")
    // ── last_error round-trip ──
    parts.push("    print('')\n")
    parts.push("    print('[T_ERR_01] last_error round-trip')\n")
    parts.push("    s5 = api_open_session(-1, '<synthetic>', synthetic=True)\n")
    parts.push("    err = api_last_error(s5)\n")
    parts.push("    err_pass = ('code' in err and 'advisory_url' in err\n")
    parts.push("                and 'retry_action' in err)\n")
    parts.push("    print(f'  err_keys={sorted(err.keys())}')\n")
    parts.push("    api_close_session(s5)\n")
    parts.push("    print(f'T_ERR_01={\"PASS\" if err_pass else \"FAIL\"}')\n")
    parts.push("    if not err_pass: fails += 1\n")
    parts.push("    print('')\n")
    parts.push("    if fails == 0:\n")
    parts.push("        print('verdict=PASS')\n")
    parts.push("        print('__EEG_SESSION_MGR__ PASS HALTED')\n")
    parts.push("    else:\n")
    parts.push("        print(f'verdict=FAIL fails={fails}')\n")
    parts.push("        print(f'__EEG_SESSION_MGR__ FAIL fails={fails}')\n")
    parts.push("    print('selftest=ok')\n")
    parts.push("    print('DONE')\n")
    parts.push("    sys.exit(0 if fails == 0 else 1)\n\n")

    // ─── inspect (print exported API contract) ───────────────────────────────
    parts.push("def cmd_inspect(args):\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=inspect')\n")
    parts.push("    print('exported_api=open_session,close_session,reinit,start_recording,rotate_if_needed,stop_recording,on_shutdown_hook,last_error')\n")
    parts.push("    print('states=PREINIT,INIT,RUNNING,HALTED')\n")
    parts.push("    print('formats=ODF,BDF,BF,NPY')\n")
    parts.push("    print('rotation_min=5,15,30,60,120,-1')\n")
    parts.push("    print('feedback_tiers=output,error,modal')\n")
    parts.push("    print('shutdown_signals=SIGTERM,SIGINT,atexit')\n")
    parts.push("    print('shutdown_NOT_reached=SIGKILL')\n")
    parts.push("    print('falsifiers=F_SM_01,F_SM_02,F_SM_03')\n")
    parts.push("    print('inspect=ok')\n")
    parts.push("    print('DONE')\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    sub.add_parser('selftest')\n")
    parts.push("    sub.add_parser('inspect')\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest': cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'inspect':  cmd_inspect(args)\n")
    parts.push("    else: sys.exit(2)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// Section 2. Selftest assertions (in-hexa side)
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn _run_selftest_assertions(body: string) -> int {
    let mut pass = 0
    let mut fail = 0


    println("[T1] helper marker selftest=ok")
    let t1 = assert_true(_kv_lookup(body, "selftest") == "ok", "selftest=ok present")
    if t1 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T2] schema field")
    let t2 = assert_true(_kv_lookup(body, "schema") == SCHEMA, "schema=" + SCHEMA)
    if t2 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T3] mode=selftest_synthetic")
    let t3 = assert_true(_kv_lookup(body, "mode") == "selftest_synthetic", "mode=selftest_synthetic")
    if t3 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T4] verdict=PASS")
    let t4 = assert_true(_kv_lookup(body, "verdict") == "PASS", "verdict=PASS")
    if t4 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T5] F_SM_01 (open+close idempotent)")
    let t5 = assert_true(_kv_lookup(body, "F_SM_01") == "PASS", "F_SM_01=PASS")
    if t5 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T6] F_SM_02 (SIGTERM/atexit hook fires close_session)")
    let t6 = assert_true(_kv_lookup(body, "F_SM_02") == "PASS", "F_SM_02=PASS")
    if t6 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T7] F_SM_03 (reinit atomic close+open)")
    let t7 = assert_true(_kv_lookup(body, "F_SM_03") == "PASS", "F_SM_03=PASS")
    if t7 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T8] T_REC_01 (start/rotate/stop)")
    let t8 = assert_true(_kv_lookup(body, "T_REC_01") == "PASS", "T_REC_01=PASS")
    if t8 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T9] T_ERR_01 (last_error round-trip)")
    let t9 = assert_true(_kv_lookup(body, "T_ERR_01") == "PASS", "T_ERR_01=PASS")
    if t9 { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// Section 3. CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/_session_manager.hexa --selftest")
    eprintln("       hexa run anima-eeg/_session_manager.hexa --inspect")
    eprintln("flags:")
    eprintln("  --selftest   synthetic state machine + shutdown hook fire test (no hardware)")
    eprintln("  --inspect    print exported API contract (no run)")
    eprintln("  --help       this message")
    eprintln("")
    eprintln("This module is library-only: collect.hexa / eeg_recorder.hexa /")
    eprintln("calibrate.hexa / realtime.hexa should call into the helper API")
    eprintln("(api_open_session, api_close_session, api_reinit, ...) — see header.")
}

// argv normalize — see experiment.hexa _flags_only_argv 동치.
fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path {
            if a.ends_with("/exe") { is_path = true }
        }
        if !is_path {
            if a.ends_with("hexa_interp") { is_path = true }
        }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut inspect_mode = false
    let mut want_help = false

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--inspect"  { inspect_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        _emit_trailer("unknown-arg", "unrecognized argument: " + a, "1) re-run with --help")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }

    if !selftest && !inspect_mode {
        _print_usage()
        exit(2)
    }

    _write_helper()

    if selftest {
        println("== _session_manager selftest ==")
        let r = _run_helper("selftest")
        let body = r[0]
        let st   = r[1]
        println(body)
        if st != 0 {
            eprintln("selftest helper FAILED rc=" + to_string(st))
            exit(1)
        }
        if _kv_lookup(body, "selftest") != "ok" {
            _emit_trailer("selftest-marker-missing", "no selftest=ok",
                          "1) check helper parse")
            exit(1)
        }
        println("")
        let fails = _run_selftest_assertions(body)
        if fails != 0 {
            println("selftest=fail")
            eprintln("selftest FAILED: " + to_string(fails) + " assertion(s)")
            exit(1)
        }
        println("selftest: OK")
        exit(0)
    }

    // inspect_mode
    println("== _session_manager inspect ==")
    let r = _run_helper("inspect")
    println(r[0])
    if r[1] != 0 {
        eprintln("inspect helper FAILED rc=" + to_string(r[1]))
        exit(1)
    }
    if _kv_lookup(r[0], "inspect") != "ok" {
        _emit_trailer("inspect-marker-missing", "no inspect=ok",
                      "1) check helper parse")
        exit(1)
    }
    exit(0)
}
// hexa-strict auto-invokes fn main() — do not call main() explicitly.
