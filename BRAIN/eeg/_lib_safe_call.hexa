// anima-eeg/_lib_safe_call.hexa
//
// @resolver-pure(reason="pure-hexa table dispatch + stderr emit — no syscalls
//                 except optional macOS `say` cue, no RNG, no hardware deps")
//
// PURPOSE
//   AI-native error contract helper for anima-eeg protocols. Provides:
//     - KIND classification (rc → KIND enum)
//     - Fix-recipe slug lookup (KIND → recipe)
//     - Human-readable reason lookup (KIND → reason)
//     - emit_fail / emit_ok stderr/stdout sentinel trailers
//     - say_fail_cue macOS audio cue + sentinel acknowledgement
//     - safe_call(label, rc) rc-passthrough wrapper
//
// SPEC
//   docs/anima_eeg_ai_native_error_contract_spec_2026_05_05.md
//
//   Failure trailer (stderr):
//     __ANIMA_EEG_FAIL__ kind=<KIND> site=<HEXA_PATH:LINE_OR_SLUG> fix_recipe=<SLUG>
//     reason: <human readable>
//     user_voice_cue_emitted: <true|false>
//
//   Success trailer (stdout):
//     __ANIMA_EEG_OK__ session=<TS_OR_LABEL> ledger=<PATH_OR_NONE>
//
// USAGE (hexa stage1 — no closures, rc-passthrough pattern)
//   let rc = run_collect_fg(...)
//   if rc != 0 {
//       say_fail_cue(voice)
//       emit_fail("BRAINFLOW_TIMEOUT", "berger_session_audio:phase_ec", 1)
//       return rc
//   }
//
// SELFTEST
//   hexa run anima-eeg/_lib_safe_call.hexa --selftest
//   Expected: 9 KIND × 3 path = 27 PASS / 0 FAIL, plus 3 fail-injection scenarios.

let SCHEMA = "anima-eeg/_lib_safe_call/1"

// ════════════════════════════════════════════════════════════════════
// Section 1. KIND enum + exit codes
// ════════════════════════════════════════════════════════════════════
// KIND as OTHER. Adding a new KIND requires updating 3 tables below + spec §2.

fn kind_int_parse_undefined() -> str { return "INT_PARSE_UNDEFINED" }
fn kind_board_not_detected() -> str  { return "BOARD_NOT_DETECTED" }
fn kind_impedance_red() -> str       { return "IMPEDANCE_RED" }
fn kind_brainflow_timeout() -> str   { return "BRAINFLOW_TIMEOUT" }
fn kind_lsl_no_outlet() -> str       { return "LSL_NO_OUTLET" }
fn kind_session_interrupted() -> str { return "SESSION_INTERRUPTED" }
fn kind_board_pins_shorted() -> str  { return "BOARD_PINS_SHORTED" }
fn kind_board_pins_shorted_fp() -> str { return "BOARD_PINS_SHORTED_FP" }
fn kind_other() -> str               { return "OTHER" }

// rc → KIND best-guess classification.
// collapse to rc=1, so this is a CONSERVATIVE guess. Callers SHOULD pass an
// explicit kind via emit_fail() instead of relying on _classify_kind() alone.
fn _classify_kind(rc: int) -> str {
    if rc == 1  { return kind_other() }            // generic failure
    if rc == 2  { return kind_board_not_detected() }
    if rc == 3  { return kind_impedance_red() }
    if rc == 4  { return kind_brainflow_timeout() }
    if rc == 5  { return kind_lsl_no_outlet() }
    if rc == 6  { return kind_session_interrupted() }
    if rc == 7  { return kind_board_pins_shorted() }
    if rc == 8  { return kind_board_pins_shorted_fp() }
    if rc == 130 { return kind_session_interrupted() }    // SIGINT 128+2
    if rc == 143 { return kind_session_interrupted() }    // SIGTERM 128+15
    return kind_other()
}

// KIND → exit-code (canonical, used by emit_fail() default suggestion).
fn _kind_to_exit(kind: str) -> int {
    if kind == "INT_PARSE_UNDEFINED"   { return 1 }
    if kind == "BOARD_NOT_DETECTED"    { return 2 }
    if kind == "IMPEDANCE_RED"         { return 3 }
    if kind == "BRAINFLOW_TIMEOUT"     { return 4 }
    if kind == "LSL_NO_OUTLET"         { return 5 }
    if kind == "SESSION_INTERRUPTED"   { return 6 }
    if kind == "BOARD_PINS_SHORTED"    { return 7 }
    if kind == "BOARD_PINS_SHORTED_FP" { return 8 }
    return 15
}

// KIND → fix recipe slug. AI agent uses this to auto-route or surface.
fn _fix_recipe(kind: str) -> str {
    if kind == "INT_PARSE_UNDEFINED"   { return "restage1_int_parse_fallback" }
    if kind == "BOARD_NOT_DETECTED"    { return "check_dongle_port" }
    if kind == "IMPEDANCE_RED"         { return "reseat_electrodes_check_paste" }
    if kind == "BRAINFLOW_TIMEOUT"     { return "restart_brainflow_release_all" }
    if kind == "LSL_NO_OUTLET"         { return "relaunch_lsl_outlet" }
    if kind == "SESSION_INTERRUPTED"   { return "resume_or_restart_session" }
    if kind == "BOARD_PINS_SHORTED"    { return "disambiguate_via_impedance_validate" }
    if kind == "BOARD_PINS_SHORTED_FP" { return "disambiguate_via_impedance_validate" }
    return "see_log"
}

// KIND → human-readable reason (≤120 chars, no newlines).
fn _kind_to_reason(kind: str) -> str {
    if kind == "INT_PARSE_UNDEFINED"   { return "hexa runtime undefined builtin (int_parse / to_int) — patch stage1 fallback" }
    if kind == "BOARD_NOT_DETECTED"    { return "BrainFlow prepare_session failed; dongle missing, wrong port, or driver fault" }
    if kind == "IMPEDANCE_RED"         { return "impedance check returned RED for >=1 channel; electrode contact insufficient" }
    if kind == "BRAINFLOW_TIMEOUT"     { return "start_stream / get_board_data exceeded watchdog window" }
    if kind == "LSL_NO_OUTLET"         { return "LSL outlet missing or no inlet within resolve window" }
    if kind == "SESSION_INTERRUPTED"   { return "Ctrl-C / SIGTERM received mid-capture; partial data may be on disk" }
    if kind == "BOARD_PINS_SHORTED"    { return "board_health flagged cross-channel correlation; verify via impedance-validate" }
    if kind == "BOARD_PINS_SHORTED_FP" { return "cross-channel correlation likely biological alpha (helmet worn); not a true short" }
    return "unclassified failure; consult log"
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

// Failure trailer (3 lines, stderr).
fn emit_fail(kind: str, site: str, voice_emitted: int) {
    let recipe = _fix_recipe(kind)
    let reason = _kind_to_reason(kind)
    eprintln("__ANIMA_EEG_FAIL__ kind=" + kind + " site=" + site + " fix_recipe=" + recipe)
    eprintln("reason: " + reason)
    if voice_emitted == 1 {
        eprintln("user_voice_cue_emitted: true")
    } else {
        eprintln("user_voice_cue_emitted: false")
    }
}

// Failure trailer with helmet-worn disambiguation (board_pins_shorted special).
fn emit_fail_with_helmet(kind: str, site: str, voice_emitted: int, helmet_worn: int) {
    emit_fail(kind, site, voice_emitted)
    if kind == "BOARD_PINS_SHORTED" {
        if helmet_worn == 1 {
            eprintln("false_positive_likely_if_helmet_worn=true")
        } else {
            eprintln("false_positive_likely_if_helmet_worn=unknown")
        }
    }
}

// Success trailer (1 line, stdout).
fn emit_ok(label: str, ledger: str) {
    print("__ANIMA_EEG_OK__ session=" + label + " ledger=" + ledger)
}

// ════════════════════════════════════════════════════════════════════
// Section 3. Audio cue (macOS-only; degrades silently elsewhere)
// ════════════════════════════════════════════════════════════════════
// caller still gets the sentinel because emit_fail is independent.

fn say_fail_cue(voice: str) -> int {
    let cmd = "say -v '" + voice + "' '측정 실패' 2>/dev/null"
    return exec(cmd)
}

fn say_ok_cue(voice: str) -> int {
    let cmd = "say -v '" + voice + "' '측정 완료' 2>/dev/null"
    return exec(cmd)
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════
// hexa stage1 has no closures / no fn-typed params, so the canonical
// pattern is rc-passthrough: caller invokes the child, then hands rc here.

fn safe_call(label: str, rc: int, voice: str) -> int {
    if rc == 0 {
        eprintln("__ANIMA_EEG_STEP_OK__ label=" + label)
        return 0
    }
    let kind = _classify_kind(rc)
    say_fail_cue(voice)
    emit_fail(kind, label, 1)
    return rc
}

// Variant: caller already knows the KIND (preferred — more specific than rc-classify).
fn safe_call_kinded(label: str, rc: int, kind: str, voice: str) -> int {
    if rc == 0 {
        eprintln("__ANIMA_EEG_STEP_OK__ label=" + label)
        return 0
    }
    say_fail_cue(voice)
    emit_fail(kind, label, 1)
    return rc
}

// ════════════════════════════════════════════════════════════════════
// Section 5. Selftest
// ════════════════════════════════════════════════════════════════════

fn assert_eq_str(label: str, got: str, want: str) -> int {
    if got == want {
        print("  PASS: " + label)
        return 1
    }
    print("  FAIL: " + label + " got='" + got + "' want='" + want + "'")
    return 0
}

fn assert_eq_int(label: str, got: int, want: int) -> int {
    if got == want {
        print("  PASS: " + label)
        return 1
    }
    print("  FAIL: " + label + " got=" + str(got) + " want=" + str(want))
    return 0
}

fn cmd_selftest() -> int {
    print("=== anima-eeg/_lib_safe_call selftest ===")
    let mut pass = 0
    let mut fail = 0

    // ---- Section A: KIND enum / exit / recipe / reason tables ----
    print("[A] KIND enum invariants")
    let kinds_ok = 1
    if assert_eq_str("kind.int_parse",       kind_int_parse_undefined(), "INT_PARSE_UNDEFINED") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.board_not_det",   kind_board_not_detected(),  "BOARD_NOT_DETECTED")  == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.impedance_red",   kind_impedance_red(),       "IMPEDANCE_RED")       == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.brainflow_to",    kind_brainflow_timeout(),   "BRAINFLOW_TIMEOUT")   == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.lsl_no_outlet",   kind_lsl_no_outlet(),       "LSL_NO_OUTLET")       == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.session_interr",  kind_session_interrupted(), "SESSION_INTERRUPTED") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.shorted",         kind_board_pins_shorted(),  "BOARD_PINS_SHORTED")  == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.shorted_fp",      kind_board_pins_shorted_fp(), "BOARD_PINS_SHORTED_FP") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("kind.other",           kind_other(),               "OTHER")               == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // ---- Section B: classify_kind rc → KIND ----
    print("[B] _classify_kind rc dispatch")
    if assert_eq_str("rc=1",   _classify_kind(1),   "OTHER")              == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=2",   _classify_kind(2),   "BOARD_NOT_DETECTED") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=3",   _classify_kind(3),   "IMPEDANCE_RED")      == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=4",   _classify_kind(4),   "BRAINFLOW_TIMEOUT")  == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=5",   _classify_kind(5),   "LSL_NO_OUTLET")      == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=6",   _classify_kind(6),   "SESSION_INTERRUPTED") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=130", _classify_kind(130), "SESSION_INTERRUPTED") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=143", _classify_kind(143), "SESSION_INTERRUPTED") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("rc=99",  _classify_kind(99),  "OTHER")              == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // ---- Section C: fix_recipe lookup ----
    print("[C] _fix_recipe table")
    if assert_eq_str("recipe.int_parse",  _fix_recipe("INT_PARSE_UNDEFINED"), "restage1_int_parse_fallback") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("recipe.board_not",  _fix_recipe("BOARD_NOT_DETECTED"),  "check_dongle_port")           == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("recipe.imp_red",    _fix_recipe("IMPEDANCE_RED"),       "reseat_electrodes_check_paste") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("recipe.bf_to",      _fix_recipe("BRAINFLOW_TIMEOUT"),   "restart_brainflow_release_all") == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_str("recipe.unknown",    _fix_recipe("MADE_UP_KIND"),        "see_log")                     == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // ---- Section D: kind_to_exit table ----
    print("[D] _kind_to_exit table")
    if assert_eq_int("exit.int_parse",  _kind_to_exit("INT_PARSE_UNDEFINED"), 1)  == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_int("exit.board_not",  _kind_to_exit("BOARD_NOT_DETECTED"),  2)  == 1 { pass = pass + 1 } else { fail = fail + 1 }
    if assert_eq_int("exit.other",      _kind_to_exit("OTHER"),               15) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // ---- Section E: synthetic fail-injection (3 scenarios — Phase 3) ----
    print("[E] fail-injection scenarios (stderr emit; visual inspection)")
    print("  scenario E1: INT_PARSE_UNDEFINED")
    emit_fail("INT_PARSE_UNDEFINED", "selftest:E1", 0)
    print("  scenario E2: BOARD_NOT_DETECTED")
    emit_fail("BOARD_NOT_DETECTED", "selftest:E2", 1)
    print("  scenario E3: SESSION_INTERRUPTED")
    emit_fail("SESSION_INTERRUPTED", "selftest:E3", 1)
    pass = pass + 3                                    // 3 emits succeeded

    // ---- Section F: helmet-worn disambiguation (board_pins_shorted_fp) ----
    print("[F] helmet-worn disambiguation emit")
    emit_fail_with_helmet("BOARD_PINS_SHORTED", "selftest:F1", 0, 1)
    pass = pass + 1

    // ---- Section G: emit_ok success trailer ----
    print("[G] emit_ok success trailer")
    emit_ok("selftest_label", "none")
    pass = pass + 1

    // ---- Verdict ----
    print("")
    print("[verdict] " + str(pass) + " PASS / " + str(fail) + " FAIL")
    if fail == 0 {
        print("__ANIMA_EEG_LIB_SAFE_CALL__ PASS")
        return 0
    }
    print("__ANIMA_EEG_LIB_SAFE_CALL__ FAIL")
    return 1
}

// ════════════════════════════════════════════════════════════════════
// Section 6. Argv dispatch
// ════════════════════════════════════════════════════════════════════

fn print_usage() {
    eprintln("usage:")
    eprintln("  hexa run anima-eeg/_lib_safe_call.hexa --selftest")
    eprintln("  hexa run anima-eeg/_lib_safe_call.hexa --inspect")
    eprintln("flags:")
    eprintln("  --selftest    KIND/recipe/reason tables + 3 fail-injection scenarios")
    eprintln("  --inspect     print contract API + KIND enum")
}

fn cmd_inspect() -> int {
    print("=== anima-eeg/_lib_safe_call contract ===")
    print("schema: " + SCHEMA)
    print("API:")
    print("  emit_fail(kind, site, voice_emitted)")
    print("  emit_fail_with_helmet(kind, site, voice_emitted, helmet_worn)")
    print("  emit_ok(label, ledger)")
    print("  say_fail_cue(voice) -> int")
    print("  say_ok_cue(voice) -> int")
    print("  safe_call(label, rc, voice) -> int")
    print("  safe_call_kinded(label, rc, kind, voice) -> int")
    print("  _classify_kind(rc) -> str")
    print("  _fix_recipe(kind) -> str")
    print("  _kind_to_reason(kind) -> str")
    print("  _kind_to_exit(kind) -> int")
    print("KINDs: INT_PARSE_UNDEFINED BOARD_NOT_DETECTED IMPEDANCE_RED")
    print("       BRAINFLOW_TIMEOUT LSL_NO_OUTLET SESSION_INTERRUPTED")
    print("       BOARD_PINS_SHORTED BOARD_PINS_SHORTED_FP OTHER")
    return 0
}

fn main() -> int {
    let av = argv()
    let n = len(av)

    let mut mode = "help"
    let mut start = 0
    while start < n {
        let a = av[start]
        let mut is_flag = false
        if len(a) >= 2 {
            if a.starts_with("--") { is_flag = true }
        }
        if is_flag { break }
        if a == "" { break }
        start = start + 1
    }

    let mut i = start
    while i < n {
        let a = av[i]
        if a == "--selftest" { mode = "selftest" }
        else if a == "--inspect" { mode = "inspect" }
        else if a == "--help" { mode = "help" }
        else {
            eprintln("[error] unknown flag: " + a)
            print_usage()
            return 2
        }
        i = i + 1
    }

    if mode == "selftest" { return cmd_selftest() }
    if mode == "inspect"  { return cmd_inspect() }
    print_usage()
    return 0
}
