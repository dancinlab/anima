// hexa-brain/eeg/eeg_to_tpm.hexa — EEG → IIT 4.0 TPM adapter (substrate bridge).
//
//   ROLE (commons @D g61 — engine ⊥ adapter)
//     The faithful IIT 4.0 cause-effect Φ-structure ENGINE lives once in
//     hexa-lang `stdlib/consciousness/iit4_*` (substrate-agnostic, input = a
//     state-by-node TPM). THIS file is hexa-brain's project-local ADAPTER:
//     it turns multichannel EEG into that TPM, so EEG recordings can be scored
//     with the same engine anima uses (its substrate is an ECA, ours is EEG).
//
//   PIPELINE
//     EEG samples (n_ch × n_samp, flat `s[ch*n_samp + t]`)
//       → binarize each channel at its own mean (ON/OFF)
//       → per-timestep system state = Σ_ch bit·2^ch
//       → frequency-estimate a state-by-node TPM: for each system state, the
//         fraction of next-steps in which each channel is ON (max-entropy 0.5
//         for states never observed)
//       → feed `big_phi(tpm, n_ch, state)` from the stdlib engine.
//
//   SCOPE / HONESTY
//     n_ch ≤ 8 (engine exact limit; use stdlib `big_phi_bounded` for more, or
//     pick a channel subset). The TPM is a FREQUENCY ESTIMATE from a finite
//     recording — Φ is an estimate, not a closed form. STUB: minimal honest
//     wiring (binarize + transition-count); richer estimators (lag/embedding,
//     soft-binning) are future work.
//
//   IMPORT-SAFE  NO `fn main()` / NO top-level call. Imports the shared stdlib
//   engine (single chain → big_phi + iit4_pow2/iit4_bit visible transitively).
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"


// per-channel mean threshold → binary flat array `b[ch*n_samp + t]` (0.0/1.0).
fn eeg_binarize(samples: array, n_ch: int, n_samp: int) -> array {
    let mut out = []
    let mut k = 0
    while k < n_ch * n_samp { out = out.push(0.0); k = k + 1 }
    let mut ch = 0
    while ch < n_ch {
        let mut sum = 0.0
        let mut t = 0
        while t < n_samp { sum = sum + samples[ch * n_samp + t]; t = t + 1 }
        let mean = sum / to_float(n_samp)
        t = 0
        while t < n_samp {
            if samples[ch * n_samp + t] > mean { out[ch * n_samp + t] = 1.0 }
            t = t + 1
        }
        ch = ch + 1
    }
    return out
}


// binarized system state at timestep t = Σ_ch bit·2^ch.
fn eeg_state_at(bin: array, n_ch: int, n_samp: int, t: int) -> int {
    let mut s = 0
    let mut ch = 0
    while ch < n_ch {
        if bin[ch * n_samp + t] > 0.5 { s = s + iit4_pow2(ch) }
        ch = ch + 1
    }
    return s
}


// frequency-estimate a state-by-node TPM from an EEG recording.
// tpm[s*n_ch + i] = P(channel i ON at t+1 | system state s at t), 0.5 if s unseen.
fn eeg_estimate_tpm(samples: array, n_ch: int, n_samp: int) -> array {
    let bin = eeg_binarize(samples, n_ch, n_samp)
    let nstates = iit4_pow2(n_ch)

    let mut occur = []                                   // count[s]
    let mut on_next = []                                 // count[s*n_ch + i] of next-ON
    let mut z = 0
    while z < nstates { occur = occur.push(0.0); z = z + 1 }
    z = 0
    while z < nstates * n_ch { on_next = on_next.push(0.0); z = z + 1 }

    let mut t = 0
    while t < n_samp - 1 {
        let s = eeg_state_at(bin, n_ch, n_samp, t)
        occur[s] = occur[s] + 1.0
        let mut i = 0
        while i < n_ch {
            if bin[i * n_samp + (t + 1)] > 0.5 { on_next[s * n_ch + i] = on_next[s * n_ch + i] + 1.0 }
            i = i + 1
        }
        t = t + 1
    }

    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n_ch {
            if occur[s] > 0.0 { tpm = tpm.push(on_next[s * n_ch + i] / occur[s]) }
            else { tpm = tpm.push(0.5) }                 // unseen state → max-entropy
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}


// convenience: EEG recording → faithful IIT 4.0 big-Φ at a given system state.
fn eeg_big_phi(samples: array, n_ch: int, n_samp: int, sys_state: int) -> array {
    return big_phi(eeg_estimate_tpm(samples, n_ch, n_samp), n_ch, sys_state)
}
