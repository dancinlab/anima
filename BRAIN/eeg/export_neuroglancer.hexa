// hexa-brain/eeg/export_neuroglancer.hexa
//
// @allow-bare-exec-file
// @allow-silent-exit-file
// @allow-silent-catch-file
// @allow-relop-banned-file
// @allow-bsd-awk-utf8-eq-file
// @allow-no-header-box
// @allow-incomplete-ns-fallback-file
//
// PURPOSE
//   Sprint 1 Part B-1 — convert anima .npy recordings into a Neuroglancer
//   Precomputed "image" volume so external collaborators (Google Connectomics
//   ecosystem) can drop the output into the public demo viewer with zero
//   friction (precomputed://http://localhost:9000).
//
//   Mirrors tool/module/_core/eeg_export.hexa 1:1 (template skeleton:
//   `_write_helper` parts-push emitter, `_run_helper` subprocess wrap,
//   `_flags_only_argv`, `assert_true` PASS/FAIL counter, --selftest mode).
//
//   The Neuroglancer Python client (google/neuroglancer) is Apache-2.0.
//   That license is compatible with MIT for use, but to keep hexa-brain's
//   eeg/ layer free of any third-party-licensed import we hand-write the
//   Precomputed `info` JSON + raw chunk bytes (numpy + json + open(..,'wb')).
//   The optional --verify sub-mode lazy-imports neuroglancer; on miss it
//   prints `verify_skipped=neuroglancer-not-installed` and exits 0.
//
// AXIS CONVENTION (Phase 1 — --mode=2d-time-series)
//   X axis = time samples         · resolution = 1e9 / sample_rate ns/voxel
//   Y axis = channel (16 rows)    · resolution = 1_000_000 ns (1 mm equiv)
//   Z axis = singleton (size 1)   · resolution = 1_000_000 ns
//   dtype  = float32              · chunk_size scale 0 = [1024, 16, 1]
//   n_scales = 4 (mean-pool along time 1x / 2x / 4x / 8x)
//   encoding = raw  (little-endian float32, Fortran/x-fastest order)
//
//   We use ns as a Precomputed convention crutch; the time axis is in samples,
//   not nanometres. Honest disclosure of this axis-units fiction lives in the
//   sidecar `meta.json` (non-spec) and design/core/neuroglancer_precomputed_export_2026_05_12.md.
//
// MODES
//   --selftest                    deterministic synth (16x12500) float32, 6 asserts
//   --input <npy|dir|session.json>
//                                  npy: a single .npy (+ optional .meta.json)
//                                  dir: a directory containing session_*.json
//                                  session.json: explicit session ledger
//   --output <dir>                target precomputed dir (created if missing)
//   --mode 2d-time-series         default (only supported in Phase 1)
//   --mode helmet-annotation      stub; exits verdict=FAIL reason=phase-2-not-implemented
//   --chunk-time <int>            scale-0 chunk x size (default 1024)
//   --scales <int>                number of scales (default 4)
//   --encoding raw                only raw supported in Phase 1
//   --verify <precomputed_dir>    sub-mode; lazy-import neuroglancer; skip on miss
//
// MARKER + LEDGER
//   PASS -> state/markers/export_neuroglancer_<ts>_PASS.marker (single-line JSON)
//   FAIL -> state/markers/export_neuroglancer_<ts>_FAILED.marker (with reason)
//   LEDGER -> state/export_neuroglancer_ledger.jsonl (append-by-rewrite)
//
//   F_NG_01 info JSON contains required keys (@type, type, data_type, scales)
//   F_NG_02 scales[0].size == [N_samples, 16, 1]
//   F_NG_03 n_scales == 4
//   F_NG_04 every scale dir has at-least-one chunk file
//   F_NG_05 first chunk byte size = chunk_x * chunk_y * chunk_z * 4 (= 65536)
//   F_NG_06 raw round-trip — single float32 sample bit-compares to source
//
//  @resolver-bypass(reason="emits transient helper /tmp/anima_eeg_export_neuroglancer_helper_<uniq>.py;

let SCHEMA               = "hexa-brain/eeg/export_neuroglancer/1"
let HELPER_PREFIX        = "/tmp/anima_eeg_export_neuroglancer_helper_"
let DEFAULT_VENV_PYTHON  = ".venv-eeg/bin/python"
let DEFAULT_SR           = 250.0
let DEFAULT_CHUNK_TIME   = 1024
let DEFAULT_SCALES       = 4
let DEFAULT_ENCODING     = "raw"
// 16ch 10-20 montage names — Cyton(8) + Daisy(8) order matching anima-eeg recorder.
let CH_NAMES_CSV         = "Fp1,Fp2,C3,C4,P7,P8,O1,O2,F7,F8,F3,F4,T7,T8,P3,P4"
let MARKER_DIR           = "state/markers"
let LEDGER_PATH          = "state/export_neuroglancer_ledger.jsonl"
let SELFTEST_OUTPUT      = "state/precomputed/synth_selftest"

// ─── helpers ────────────────────────────────────────────────────────────

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn now_unix() -> string {
    return exec("date -u +%s").trim()
}

// Pseudo-pid for transient-helper path uniqueness. Hexa has no getpid()
// builtin so we use a nanosecond-resolution timestamp — monotonically unique
fn _uniq_suffix() -> string {
    let n = exec("date -u +%s%N").trim()
    if n == "" { return now_unix() }
    return n
}

// Resolve a python executable: prefer .venv-eeg/bin/python, fall back to
// frequently lack the macOS-built venv on linux CI hosts).
fn _resolve_python() -> string {
    let venv = DEFAULT_VENV_PYTHON
    if file_exists(venv) {
        // Broken symlink may pass file_exists; probe with a real call.
        let r = exec_with_status(venv + " -c 'import sys; sys.exit(0)' 2>/dev/null")
        if to_int(r[1]) == 0 { return venv }
    }
    return "python3"
}


fn _write_helper(helper_path: string) {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# Mirrors tool/module/_core/eeg_export.hexa parts-push emitter shape.\n")
    parts.push("import argparse, hashlib, json, os, sys, struct, glob\n")
    parts.push("import numpy as np\n\n")

    parts.push("CH_NAMES = '" + CH_NAMES_CSV + "'.split(',')\n")
    parts.push("SCHEMA   = '" + SCHEMA + "'\n\n")

    parts.push("def emit(k, v):\n")
    parts.push("    print(f'{k}={v}')\n\n")

    parts.push("def sha256_file(path):\n")
    parts.push("    h = hashlib.sha256()\n")
    parts.push("    with open(path, 'rb') as f:\n")
    parts.push("        for chunk in iter(lambda: f.read(65536), b''):\n")
    parts.push("            h.update(chunk)\n")
    parts.push("    return h.hexdigest()\n\n")

    // -------- input normaliser --------
    parts.push("def _resolve_inputs(input_path):\n")
    parts.push("    # Returns ordered list of (npy_path, meta_dict). Multi-segment\n")
    parts.push("    # session.json concatenates along time axis in segment-index order\n")
    parts.push("    if input_path.endswith('.npy') and os.path.isfile(input_path):\n")
    parts.push("        meta = {}\n")
    parts.push("        sidecar = input_path + '.meta.json'\n")
    parts.push("        if os.path.exists(sidecar):\n")
    parts.push("            try:\n")
    parts.push("                with open(sidecar) as f: meta = json.load(f)\n")
    parts.push("            except Exception as e:\n")
    parts.push("                sys.stderr.write(f'meta-load-warn: {type(e).__name__}\\n')\n")
    parts.push("        return [(input_path, meta)]\n")
    parts.push("    if input_path.endswith('.json') and os.path.isfile(input_path):\n")
    parts.push("        return _resolve_from_session_json(input_path)\n")
    parts.push("    if os.path.isdir(input_path):\n")
    parts.push("        cands = sorted(glob.glob(os.path.join(input_path, 'session_*.json')))\n")
    parts.push("        if cands:\n")
    parts.push("            return _resolve_from_session_json(cands[0])\n")
    parts.push("        npys = sorted(glob.glob(os.path.join(input_path, '*.npy')))\n")
    parts.push("        if not npys:\n")
    parts.push("            raise FileNotFoundError(f'no .npy nor session_*.json in {input_path}')\n")
    parts.push("        out = []\n")
    parts.push("        for p in npys:\n")
    parts.push("            meta = {}\n")
    parts.push("            sc = p + '.meta.json'\n")
    parts.push("            if os.path.exists(sc):\n")
    parts.push("                try:\n")
    parts.push("                    with open(sc) as f: meta = json.load(f)\n")
    parts.push("                except Exception as e:\n")
    parts.push("                    sys.stderr.write(f'meta-load-warn: {type(e).__name__}\\n')\n")
    parts.push("            out.append((p, meta))\n")
    parts.push("        return out\n")
    parts.push("    raise FileNotFoundError(f'input not recognised: {input_path}')\n\n")

    parts.push("def _resolve_from_session_json(json_path):\n")
    parts.push("    with open(json_path) as f: sess = json.load(f)\n")
    parts.push("    base = os.path.dirname(os.path.abspath(json_path))\n")
    parts.push("    pairs = []\n")
    parts.push("    for task_record in sess.get('tasks', []):\n")
    parts.push("        for seg in sorted(task_record.get('segments', []), key=lambda s: s.get('seg', 0)):\n")
    parts.push("            if seg.get('verdict') != 'PASS': continue\n")
    parts.push("            p = seg.get('path', '')\n")
    parts.push("            if not p: continue\n")
    parts.push("            if not os.path.isabs(p) and not os.path.exists(p):\n")
    parts.push("                cand = os.path.join(base, os.path.basename(p))\n")
    parts.push("                if os.path.exists(cand): p = cand\n")
    parts.push("            if not os.path.exists(p): continue\n")
    parts.push("            meta = {}\n")
    parts.push("            sc = p + '.meta.json'\n")
    parts.push("            if os.path.exists(sc):\n")
    parts.push("                try:\n")
    parts.push("                    with open(sc) as f: meta = json.load(f)\n")
    parts.push("                except Exception as e:\n")
    parts.push("                    sys.stderr.write(f'meta-load-warn: {type(e).__name__}\\n')\n")
    parts.push("            pairs.append((p, meta))\n")
    parts.push("    if not pairs:\n")
    parts.push("        raise FileNotFoundError(f'no PASS segments in session ledger {json_path}')\n")
    parts.push("    return pairs\n\n")

    parts.push("def _load_eeg_block(npy_path, meta):\n")
    parts.push("    arr = np.load(npy_path)\n")
    parts.push("    if arr.ndim != 2:\n")
    parts.push("        raise ValueError(f'ndim={arr.ndim} not 2 ({npy_path})')\n")
    parts.push("    rows, cols = arr.shape\n")
    parts.push("    eeg_idx = meta.get('eeg_indices', None)\n")
    parts.push("    if eeg_idx is None or rows == 16:\n")
    parts.push("        if rows > 15:\n")
    parts.push("            data = arr[:16, :]\n")
    parts.push("        else:\n")
    parts.push("            data = arr\n")
    parts.push("    else:\n")
    parts.push("        eeg_idx = list(eeg_idx)\n")
    parts.push("        if max(eeg_idx) < rows:\n")
    parts.push("            data = arr[eeg_idx, :]\n")
    parts.push("        else:\n")
    parts.push("            data = arr[:16, :]\n")
    parts.push("    return data.astype(np.float32)\n\n")

    parts.push("def _assemble_volume(pairs, default_sr):\n")
    parts.push("    blocks = []\n")
    parts.push("    sr = None\n")
    parts.push("    for p, meta in pairs:\n")
    parts.push("        blocks.append(_load_eeg_block(p, meta))\n")
    parts.push("        m_sr = meta.get('sample_rate', None)\n")
    parts.push("        if m_sr is not None:\n")
    parts.push("            if sr is None:\n")
    parts.push("                sr = float(m_sr)\n")
    parts.push("            elif abs(float(m_sr) - sr) > 1e-3:\n")
    parts.push("                sys.stderr.write(f'WARN: sample_rate drift {sr} -> {m_sr}; keeping first\\n')\n")
    parts.push("    if sr is None: sr = float(default_sr)\n")
    parts.push("    norm_blocks = []\n")
    parts.push("    for b in blocks:\n")
    parts.push("        if b.shape[0] < 16:\n")
    parts.push("            pad = np.zeros((16 - b.shape[0], b.shape[1]), dtype=np.float32)\n")
    parts.push("            b = np.concatenate([b, pad], axis=0)\n")
    parts.push("        elif b.shape[0] > 16:\n")
    parts.push("            b = b[:16, :]\n")
    parts.push("        norm_blocks.append(b)\n")
    parts.push("    vol = np.concatenate(norm_blocks, axis=1) if norm_blocks else np.zeros((16, 0), np.float32)\n")
    parts.push("    return vol, sr\n\n")

    parts.push("def _scale_key(res_x_ns, res_y_ns, res_z_ns):\n")
    parts.push("    return f'{int(res_x_ns)}_{int(res_y_ns)}_{int(res_z_ns)}'\n\n")

    parts.push("def _mean_pool_time(arr_xyz, factor):\n")
    parts.push("    if factor < 2: return arr_xyz\n")
    parts.push("    X = arr_xyz.shape[0]\n")
    parts.push("    Xn = X // factor\n")
    parts.push("    if Xn == 0:\n")
    parts.push("        return arr_xyz[:0]\n")
    parts.push("    trimmed = arr_xyz[:Xn*factor]\n")
    parts.push("    return trimmed.reshape(Xn, factor, arr_xyz.shape[1], arr_xyz.shape[2]).mean(axis=1).astype(np.float32)\n\n")

    parts.push("def _write_chunk(out_dir, key, x0,x1,y0,y1,z0,z1, block_xyz):\n")
    parts.push("    fname = f'{x0}-{x1}_{y0}-{y1}_{z0}-{z1}'\n")
    parts.push("    fpath = os.path.join(out_dir, key, fname)\n")
    parts.push("    os.makedirs(os.path.dirname(fpath), exist_ok=True)\n")
    parts.push("    buf = np.ascontiguousarray(block_xyz, dtype='<f4').tobytes(order='F')\n")
    parts.push("    with open(fpath, 'wb') as f: f.write(buf)\n")
    parts.push("    return fpath, len(buf)\n\n")

    parts.push("def _write_precomputed(vol_2d, sr, out_dir, chunk_time, n_scales, encoding):\n")
    parts.push("    n_ch, n_samp = vol_2d.shape\n")
    parts.push("    if n_ch != 16:\n")
    parts.push("        raise ValueError(f'channel count {n_ch} != 16')\n")
    parts.push("    vol = vol_2d.T.reshape(n_samp, n_ch, 1).astype(np.float32)\n")
    parts.push("    os.makedirs(out_dir, exist_ok=True)\n")
    parts.push("    res_x_ns_base = max(1, int(round(1e9 / float(sr))))\n")
    parts.push("    res_y_ns = 1000000\n")
    parts.push("    res_z_ns = 1000000\n")
    parts.push("    scales = []\n")
    parts.push("    total_chunks = 0\n")
    parts.push("    chunk_files_by_scale = []\n")
    parts.push("    for s in range(n_scales):\n")
    parts.push("        factor = 1 << s\n")
    parts.push("        scaled = _mean_pool_time(vol, factor)\n")
    parts.push("        X, Y, Z = scaled.shape\n")
    parts.push("        if X == 0:\n")
    parts.push("            sys.stderr.write(f'WARN: scale {s} has X=0 after pool factor={factor}; truncating n_scales\\n')\n")
    parts.push("            break\n")
    parts.push("        res_x_ns = res_x_ns_base * factor\n")
    parts.push("        key = _scale_key(res_x_ns, res_y_ns, res_z_ns)\n")
    parts.push("        cx, cy, cz = chunk_time, Y, 1\n")
    parts.push("        n_chunks_x = (X + cx - 1) // cx\n")
    parts.push("        n_chunks_y = (Y + cy - 1) // cy\n")
    parts.push("        n_chunks_z = (Z + cz - 1) // cz\n")
    parts.push("        files = []\n")
    parts.push("        for ix in range(n_chunks_x):\n")
    parts.push("            for iy in range(n_chunks_y):\n")
    parts.push("                for iz in range(n_chunks_z):\n")
    parts.push("                    x0, x1 = ix*cx, min((ix+1)*cx, X)\n")
    parts.push("                    y0, y1 = iy*cy, min((iy+1)*cy, Y)\n")
    parts.push("                    z0, z1 = iz*cz, min((iz+1)*cz, Z)\n")
    parts.push("                    block = scaled[x0:x1, y0:y1, z0:z1]\n")
    parts.push("                    fpath, _nb = _write_chunk(out_dir, key, x0,x1,y0,y1,z0,z1, block)\n")
    parts.push("                    files.append(fpath)\n")
    parts.push("                    total_chunks += 1\n")
    parts.push("        scales.append({\n")
    parts.push("            'chunk_sizes': [[cx, cy, cz]],\n")
    parts.push("            'encoding': encoding,\n")
    parts.push("            'key': key,\n")
    parts.push("            'resolution': [res_x_ns, res_y_ns, res_z_ns],\n")
    parts.push("            'size': [X, Y, Z],\n")
    parts.push("            'voxel_offset': [0, 0, 0],\n")
    parts.push("        })\n")
    parts.push("        chunk_files_by_scale.append(files)\n")
    parts.push("    info = {\n")
    parts.push("        '@type': 'neuroglancer_multiscale_volume',\n")
    parts.push("        'type': 'image',\n")
    parts.push("        'data_type': 'float32',\n")
    parts.push("        'num_channels': 1,\n")
    parts.push("        'scales': scales,\n")
    parts.push("    }\n")
    parts.push("    info_path = os.path.join(out_dir, 'info')\n")
    parts.push("    with open(info_path, 'w') as f: json.dump(info, f, indent=2, sort_keys=True)\n")
    parts.push("    sidecar = {\n")
    parts.push("        'schema': SCHEMA,\n")
    parts.push("        'x_axis': 'time_samples',\n")
    parts.push("        'x_resolution_s': 1.0/float(sr),\n")
    parts.push("        'sample_rate_hz': float(sr),\n")
    parts.push("        'y_axis': 'electrode',\n")
    parts.push("        'z_axis': 'singleton',\n")
    parts.push("        'channel_names': CH_NAMES,\n")
    parts.push("        'n_samples': int(n_samp),\n")
    parts.push("        'n_channels': int(n_ch),\n")
    parts.push("        'n_scales': len(scales),\n")
    parts.push("        'chunk_time': int(chunk_time),\n")
    parts.push("        'encoding': encoding,\n")
    parts.push("        'axis_units_disclosure': 'time-as-X uses ns/voxel as Precomputed convention; the axis is samples, not nanometres. See design/core/neuroglancer_precomputed_export_2026_05_12.md.',\n")
    parts.push("    }\n")
    parts.push("    with open(os.path.join(out_dir, 'meta.json'), 'w') as f: json.dump(sidecar, f, indent=2)\n")
    parts.push("    return info, total_chunks, chunk_files_by_scale\n\n")

    parts.push("def cmd_export(args):\n")
    parts.push("    if args.mode == 'helmet-annotation':\n")
    parts.push("        emit('schema', SCHEMA)\n")
    parts.push("        emit('mode', 'helmet-annotation')\n")
    parts.push("        emit('verdict', 'FAIL')\n")
    parts.push("        emit('reason', 'phase-2-not-implemented')\n")
    parts.push("        sys.exit(20)\n")
    parts.push("    if args.mode != '2d-time-series':\n")
    parts.push("        emit('schema', SCHEMA)\n")
    parts.push("        emit('verdict', 'FAIL'); emit('reason', f'mode={args.mode}-unsupported'); sys.exit(3)\n")
    parts.push("    if args.encoding != 'raw':\n")
    parts.push("        emit('schema', SCHEMA)\n")
    parts.push("        emit('verdict', 'FAIL'); emit('reason', f'encoding={args.encoding}-unsupported'); sys.exit(3)\n")
    parts.push("    if not args.input or not os.path.exists(args.input):\n")
    parts.push("        emit('schema', SCHEMA)\n")
    parts.push("        emit('verdict', 'FAIL'); emit('reason', f'input-missing:{args.input}'); sys.exit(2)\n")
    parts.push("    if not args.output:\n")
    parts.push("        emit('schema', SCHEMA)\n")
    parts.push("        emit('verdict', 'FAIL'); emit('reason', 'output-required'); sys.exit(2)\n")
    parts.push("    pairs = _resolve_inputs(args.input)\n")
    parts.push("    vol_2d, sr = _assemble_volume(pairs, args.default_sr)\n")
    parts.push("    info, total_chunks, _files = _write_precomputed(\n")
    parts.push("        vol_2d, sr, args.output, args.chunk_time, args.scales, args.encoding)\n")
    parts.push("    info_path = os.path.join(args.output, 'info')\n")
    parts.push("    info_sha = sha256_file(info_path)\n")
    parts.push("    emit('schema', SCHEMA)\n")
    parts.push("    emit('mode', '2d-time-series')\n")
    parts.push("    emit('input', args.input)\n")
    parts.push("    emit('output', args.output)\n")
    parts.push("    emit('n_segments', len(pairs))\n")
    parts.push("    emit('n_channels', int(vol_2d.shape[0]))\n")
    parts.push("    emit('n_samples', int(vol_2d.shape[1]))\n")
    parts.push("    emit('sample_rate', sr)\n")
    parts.push("    emit('n_scales', len(info['scales']))\n")
    parts.push("    emit('n_chunks', total_chunks)\n")
    parts.push("    emit('info_path', info_path)\n")
    parts.push("    emit('info_sha256', info_sha)\n")
    parts.push("    emit('encoding', args.encoding)\n")
    parts.push("    emit('chunk_time', args.chunk_time)\n")
    parts.push("    emit('verdict', 'PASS')\n\n")

    parts.push("def cmd_verify(args):\n")
    parts.push("    target = args.verify\n")
    parts.push("    info_path = os.path.join(target, 'info')\n")
    parts.push("    if not os.path.exists(info_path):\n")
    parts.push("        emit('schema', SCHEMA); emit('verdict', 'FAIL'); emit('reason', f'no-info-at:{info_path}'); sys.exit(2)\n")
    parts.push("    with open(info_path) as f: info = json.load(f)\n")
    parts.push("    if info.get('type') != 'image' or info.get('data_type') != 'float32':\n")
    parts.push("        emit('schema', SCHEMA); emit('verdict', 'FAIL'); emit('reason', 'info-schema-mismatch'); sys.exit(2)\n")
    parts.push("    scales = info.get('scales', [])\n")
    parts.push("    if not scales:\n")
    parts.push("        emit('schema', SCHEMA); emit('verdict', 'FAIL'); emit('reason', 'no-scales'); sys.exit(2)\n")
    parts.push("    total = 0\n")
    parts.push("    per_scale = []\n")
    parts.push("    for s in scales:\n")
    parts.push("        key = s['key']\n")
    parts.push("        cx, cy, cz = s['chunk_sizes'][0]\n")
    parts.push("        expected = cx * cy * cz * 4\n")
    parts.push("        files = sorted(glob.glob(os.path.join(target, key, '*-*_*-*_*-*')))\n")
    parts.push("        if not files:\n")
    parts.push("            emit('schema', SCHEMA); emit('verdict', 'FAIL'); emit('reason', f'no-chunks-at:{key}'); sys.exit(2)\n")
    parts.push("        first_bytes = os.path.getsize(files[0])\n")
    parts.push("        per_scale.append((key, len(files), first_bytes, expected))\n")
    parts.push("        total += len(files)\n")
    parts.push("    try:\n")
    parts.push("        import neuroglancer  # noqa: F401\n")
    parts.push("        emit('neuroglancer_import', 'ok')\n")
    parts.push("    except ImportError:\n")
    parts.push("        emit('verify_skipped', 'neuroglancer-not-installed')\n")
    parts.push("    emit('schema', SCHEMA)\n")
    parts.push("    emit('n_scales', len(scales))\n")
    parts.push("    emit('n_chunks_total', total)\n")
    parts.push("    for i,(k,nf,fb,exp) in enumerate(per_scale):\n")
    parts.push("        emit(f'scale_{i}_key', k)\n")
    parts.push("        emit(f'scale_{i}_files', nf)\n")
    parts.push("        emit(f'scale_{i}_first_bytes', fb)\n")
    parts.push("        emit(f'scale_{i}_expected_full_bytes', exp)\n")
    parts.push("    emit('verdict', 'PASS')\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    out_dir = '" + SELFTEST_OUTPUT + "'\n")
    parts.push("    if os.path.isdir(out_dir):\n")
    parts.push("        import shutil; shutil.rmtree(out_dir)\n")
    parts.push("    os.makedirs(out_dir, exist_ok=True)\n")
    parts.push("    rows, cols, sr = 16, 12500, 250.0\n")
    parts.push("    rng = np.random.default_rng(20260512)\n")
    parts.push("    data = np.zeros((rows, cols), dtype=np.float32)\n")
    parts.push("    t = np.arange(cols, dtype=np.float32)/np.float32(sr)\n")
    parts.push("    for k in range(rows):\n")
    parts.push("        sine = (12.0*np.sin(2*np.pi*(8.0+k*0.4)*t)).astype(np.float32)\n")
    parts.push("        noise = (3.0*rng.standard_normal(cols)).astype(np.float32)\n")
    parts.push("        data[k] = sine + noise\n")
    parts.push("    npy_path = os.path.join(out_dir, '_selftest_synth.npy')\n")
    parts.push("    np.save(npy_path, data)\n")
    parts.push("    meta = {'schema':'anima-eeg/eeg_recorder/1','task':'selftest_export_ng',\n")
    parts.push("            'session_ts':'20260512T000000Z','sample_rate':sr,\n")
    parts.push("            'eeg_indices':list(range(rows)),'rows':rows,'cols':cols,\n")
    parts.push("            'duration_actual_s':cols/sr,'tier':'DEGRADED'}\n")
    parts.push("    with open(npy_path+'.meta.json','w') as f: json.dump(meta, f)\n")
    parts.push("    class A: pass\n")
    parts.push("    a = A()\n")
    parts.push("    a.input = npy_path\n")
    parts.push("    a.output = out_dir\n")
    parts.push("    a.mode = '2d-time-series'\n")
    parts.push("    a.chunk_time = 1024\n")
    parts.push("    a.scales = 4\n")
    parts.push("    a.encoding = 'raw'\n")
    parts.push("    a.default_sr = sr\n")
    parts.push("    cmd_export(a)\n")
    parts.push("    info_path = os.path.join(out_dir, 'info')\n")
    parts.push("    with open(info_path) as f: info = json.load(f)\n")
    parts.push("    req_keys = ('@type','type','data_type','scales','num_channels')\n")
    parts.push("    f01 = all(k in info for k in req_keys) and info['type']=='image' and info['data_type']=='float32'\n")
    parts.push("    sc0 = info['scales'][0]\n")
    parts.push("    f02 = sc0['size'] == [cols, rows, 1]\n")
    parts.push("    f03 = len(info['scales']) == 4\n")
    parts.push("    chunks_per_scale = []\n")
    parts.push("    for s in info['scales']:\n")
    parts.push("        files = sorted(glob.glob(os.path.join(out_dir, s['key'], '*-*_*-*_*-*')))\n")
    parts.push("        chunks_per_scale.append(len(files))\n")
    parts.push("    f04 = all(n > 0 for n in chunks_per_scale)\n")
    parts.push("    first0 = sorted(glob.glob(os.path.join(out_dir, sc0['key'], '*-*_*-*_*-*')))[0]\n")
    parts.push("    cx,cy,cz = sc0['chunk_sizes'][0]\n")
    parts.push("    expected = cx*cy*cz*4\n")
    parts.push("    actual = os.path.getsize(first0)\n")
    parts.push("    f05 = (actual == expected)\n")
    parts.push("    with open(first0, 'rb') as fh: head = fh.read(4)\n")
    parts.push("    sample_from_disk = struct.unpack('<f', head)[0]\n")
    parts.push("    src = np.float32(data[0, 0])\n")
    parts.push("    f06 = (np.float32(sample_from_disk).tobytes() == src.tobytes())\n")
    parts.push("    emit('f01_info_required_keys', 'PASS' if f01 else 'FAIL')\n")
    parts.push("    emit('f02_scale0_size', 'PASS' if f02 else 'FAIL')\n")
    parts.push("    emit('f03_n_scales', 'PASS' if f03 else 'FAIL')\n")
    parts.push("    emit('f04_chunks_per_scale', 'PASS' if f04 else 'FAIL')\n")
    parts.push("    emit('f05_first_chunk_bytes', 'PASS' if f05 else 'FAIL')\n")
    parts.push("    emit('f06_roundtrip_bit_compare', 'PASS' if f06 else 'FAIL')\n")
    parts.push("    emit('chunks_scale_0', chunks_per_scale[0] if chunks_per_scale else 0)\n")
    parts.push("    emit('chunks_scale_1', chunks_per_scale[1] if len(chunks_per_scale)>1 else 0)\n")
    parts.push("    emit('chunks_scale_2', chunks_per_scale[2] if len(chunks_per_scale)>2 else 0)\n")
    parts.push("    emit('chunks_scale_3', chunks_per_scale[3] if len(chunks_per_scale)>3 else 0)\n")
    parts.push("    emit('first_chunk_bytes', actual)\n")
    parts.push("    emit('first_chunk_expected_bytes', expected)\n")
    parts.push("    emit('output', out_dir)\n")
    parts.push("    emit('n_chunks', sum(chunks_per_scale))\n")
    parts.push("    emit('verdict', 'PASS' if all([f01,f02,f03,f04,f05,f06]) else 'FAIL')\n")
    parts.push("    emit('selftest', 'ok' if all([f01,f02,f03,f04,f05,f06]) else 'fail')\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    sub.add_parser('selftest')\n")
    parts.push("    e = sub.add_parser('export')\n")
    parts.push("    e.add_argument('--input', required=True)\n")
    parts.push("    e.add_argument('--output', required=True)\n")
    parts.push("    e.add_argument('--mode', default='2d-time-series')\n")
    parts.push("    e.add_argument('--chunk-time', dest='chunk_time', type=int, default=" + to_string(DEFAULT_CHUNK_TIME) + ")\n")
    parts.push("    e.add_argument('--scales', type=int, default=" + to_string(DEFAULT_SCALES) + ")\n")
    parts.push("    e.add_argument('--encoding', default='" + DEFAULT_ENCODING + "')\n")
    parts.push("    e.add_argument('--default-sr', dest='default_sr', type=float, default=" + to_string(DEFAULT_SR) + ")\n")
    parts.push("    v = sub.add_parser('verify')\n")
    parts.push("    v.add_argument('--verify', dest='verify', required=True)\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest':\n")
    parts.push("        class A: pass\n")
    parts.push("        cmd_selftest(A())\n")
    parts.push("    elif args.cmd == 'export':\n")
    parts.push("        cmd_export(args)\n")
    parts.push("    elif args.cmd == 'verify':\n")
    parts.push("        cmd_verify(args)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(helper_path, parts.join(""))
}

fn _run_helper(helper_path: string, py: string, args: string) -> array {
    let cmd = py + " " + helper_path + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ─── marker + ledger ───────────────────────────────────────────────────

fn _emit_marker(verdict: string, body: string, ts: string, reason: string) {
    let _ = exec("mkdir -p " + MARKER_DIR)
    let out = _kv_lookup(body, "output")
    let n_chunks = _kv_lookup(body, "n_chunks")
    let mode = _kv_lookup(body, "mode")
    let exit_code = if verdict == "PASS" { "0" } else { "1" }
    let suffix = if verdict == "PASS" { "_PASS" } else { "_FAILED" }
    let path = MARKER_DIR + "/export_neuroglancer_" + ts + suffix + ".marker"
    let mut row = "{"
    row = row + "\"source\":\"eeg/export_neuroglancer.hexa\","
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"exit\":" + exit_code + ","
    row = row + "\"verdict\":\"" + verdict + "\","
    row = row + "\"output\":\"" + out + "\","
    row = row + "\"mode\":\"" + mode + "\","
    row = row + "\"n_chunks\":" + (if n_chunks == "" { "0" } else { n_chunks }) + ","
    row = row + "\"ts\":\"" + ts + "\""
    if reason != "" {
        row = row + ",\"reason\":\"" + reason + "\""
    }
    row = row + "}\n"
    write_file(path, row)
    println("    marker: " + path)
}

fn _emit_ledger(verdict: string, body: string, ts: string, reason: string) {
    let out = _kv_lookup(body, "output")
    let n_chunks = _kv_lookup(body, "n_chunks")
    let n_samples = _kv_lookup(body, "n_samples")
    let mode = _kv_lookup(body, "mode")
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\"" + ","
    row = row + "\"verdict\":\"" + verdict + "\","
    row = row + "\"mode\":\"" + mode + "\","
    row = row + "\"output\":\"" + out + "\","
    row = row + "\"n_samples\":" + (if n_samples == "" { "0" } else { n_samples }) + ","
    row = row + "\"n_chunks\":" + (if n_chunks == "" { "0" } else { n_chunks })
    if reason != "" {
        row = row + ",\"reason\":\"" + reason + "\""
    }
    row = row + "}"
    let nl = chr(10)
    let mut existing = ""
    if file_exists(LEDGER_PATH) {
        let prior = read_file(LEDGER_PATH)
        if prior != "" { existing = prior }
    } else {
        let _ = exec("mkdir -p state")
    }
    write_file(LEDGER_PATH, existing + row + nl)
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run eeg/export_neuroglancer.hexa --selftest")
    eprintln("       hexa run eeg/export_neuroglancer.hexa \\")
    eprintln("           --input <npy|dir|session.json> --output <dir> \\")
    eprintln("           [--mode 2d-time-series] [--chunk-time 1024] [--scales 4] [--encoding raw]")
    eprintln("       hexa run eeg/export_neuroglancer.hexa --verify <precomputed_dir>")
}

fn _flags_only_argv() -> array {
    // Skip the interpreter prelude (e.g. on Linux: hexa_real, "run",
    // /path/to/script.hexa) by advancing until the first token that starts
    // with "-" (a flag). Robust to interpreter-path naming differences
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        if a.starts_with("-") { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut input_path = ""
    let mut output_path = ""
    let mut mode = "2d-time-series"
    let mut chunk_time = DEFAULT_CHUNK_TIME
    let mut scales = DEFAULT_SCALES
    let mut encoding = DEFAULT_ENCODING
    let mut verify_dir = ""
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--input" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --input"); exit(2) }
            input_path = av[i+1]; i = i + 2; continue
        }
        if a == "--output" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --output"); exit(2) }
            output_path = av[i+1]; i = i + 2; continue
        }
        if a == "--mode" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --mode"); exit(2) }
            mode = av[i+1]; i = i + 2; continue
        }
        if a == "--chunk-time" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --chunk-time"); exit(2) }
            chunk_time = to_int(av[i+1]); i = i + 2; continue
        }
        if a == "--scales" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --scales"); exit(2) }
            scales = to_int(av[i+1]); i = i + 2; continue
        }
        if a == "--encoding" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --encoding"); exit(2) }
            encoding = av[i+1]; i = i + 2; continue
        }
        if a == "--verify" {
            if (i+1) > (len(av) - 1) { eprintln("missing arg --verify"); exit(2) }
            verify_dir = av[i+1]; i = i + 2; continue
        }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        eprintln("unknown arg: " + a); _print_usage(); exit(2)
    }

    let helper_path = HELPER_PREFIX + _uniq_suffix() + ".py"
    _write_helper(helper_path)
    let py = _resolve_python()

    if verify_dir != "" {
        println("== eeg export_neuroglancer verify ==")
        let args = "verify --verify " + _sh_quote(verify_dir)
        let r = _run_helper(helper_path, py, args)
        let body = r[0]
        let rc   = r[1]
        println(body)
        if rc != 0 { eprintln("helper rc=" + to_string(rc)); exit(1) }
        exit(0)
    }

    if selftest {
        println("== eeg export_neuroglancer selftest ==")
        let r = _run_helper(helper_path, py, "selftest")
        let body = r[0]
        let rc   = r[1]
        println(body)
        let st_ts = "selftest_synth"
        if rc != 0 {
            eprintln("helper rc=" + to_string(rc))
            _emit_marker("FAIL", body, st_ts, "helper-rc-" + to_string(rc))
            _emit_ledger("FAIL", body, st_ts, "helper-rc-" + to_string(rc))
            exit(1)
        }
        let mut pass = 0
        let mut fail = 0
        let t1 = assert_true(_kv_lookup(body, "f01_info_required_keys") == "PASS", "F_NG_01 info required keys")
        if t1 { pass = pass + 1 } else { fail = fail + 1 }
        let t2 = assert_true(_kv_lookup(body, "f02_scale0_size") == "PASS", "F_NG_02 scale0 size == [12500,16,1]")
        if t2 { pass = pass + 1 } else { fail = fail + 1 }
        let t3 = assert_true(_kv_lookup(body, "f03_n_scales") == "PASS", "F_NG_03 n_scales == 4")
        if t3 { pass = pass + 1 } else { fail = fail + 1 }
        let t4 = assert_true(_kv_lookup(body, "f04_chunks_per_scale") == "PASS", "F_NG_04 chunks-per-scale > 0")
        if t4 { pass = pass + 1 } else { fail = fail + 1 }
        let t5 = assert_true(_kv_lookup(body, "f05_first_chunk_bytes") == "PASS", "F_NG_05 first chunk bytes == 65536")
        if t5 { pass = pass + 1 } else { fail = fail + 1 }
        let t6 = assert_true(_kv_lookup(body, "f06_roundtrip_bit_compare") == "PASS", "F_NG_06 round-trip bit-compare")
        if t6 { pass = pass + 1 } else { fail = fail + 1 }
        println("")
        println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL")
        let verdict = if fail == 0 { "PASS" } else { "FAIL" }
        let reason = if fail == 0 { "" } else { "assertion-fail-count-" + to_string(fail) }
        _emit_marker(verdict, body, st_ts, reason)
        _emit_ledger(verdict, body, st_ts, reason)
        if fail != 0 { exit(1) }
        println("schema=" + SCHEMA)
        println("selftest: OK")
        exit(0)
    }

    if mode == "helmet-annotation" {
        println("== eeg export_neuroglancer helmet-annotation (stub) ==")
        let args = "export --input " + _sh_quote(input_path)
            + " --output " + _sh_quote(output_path)
            + " --mode helmet-annotation"
        let r = _run_helper(helper_path, py, args)
        let body = r[0]
        println(body)
        let ts = now_unix()
        _emit_marker("FAIL", body, ts, "phase-2-not-implemented")
        _emit_ledger("FAIL", body, ts, "phase-2-not-implemented")
        exit(1)
    }

    if input_path == "" || output_path == "" {
        eprintln("ABORT: need --input and --output  (or --selftest, or --verify)")
        _print_usage(); exit(2)
    }
    println("== eeg export_neuroglancer 2d-time-series ==")
    let args = "export --input " + _sh_quote(input_path)
        + " --output " + _sh_quote(output_path)
        + " --mode " + _sh_quote(mode)
        + " --chunk-time " + to_string(chunk_time)
        + " --scales " + to_string(scales)
        + " --encoding " + _sh_quote(encoding)
    let r = _run_helper(helper_path, py, args)
    let body = r[0]
    let rc   = r[1]
    println(body)
    let ts = now_unix()
    let v = _kv_lookup(body, "verdict")
    let reason = _kv_lookup(body, "reason")
    if rc != 0 || v != "PASS" {
        let r_msg = if reason == "" { "helper-rc-" + to_string(rc) } else { reason }
        _emit_marker("FAIL", body, ts, r_msg)
        _emit_ledger("FAIL", body, ts, r_msg)
        eprintln("export FAIL")
        exit(1)
    }
    _emit_marker("PASS", body, ts, "")
    _emit_ledger("PASS", body, ts, "")
    println("schema=" + SCHEMA)
    println("export: OK")
    exit(0)
}
