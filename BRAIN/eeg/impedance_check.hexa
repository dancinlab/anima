// anima-eeg/impedance_check.hexa
//
// PURPOSE
//   Native ADS1299 lead-off impedance measurement via OpenBCI `z`-command.
//   Replaces RMS-heuristic electrode-quality with a hardware-grounded
//   impedance reading: chip injects 31.5 Hz @ 6 nA AC current; measured
//   31.5 Hz bin amplitude in EEG output gives Z = V/I (Ohm's law).
//
//   This is a NEW SEPARATE FILE per design doc
//   docs/impedance_z_command_implementation_plan_2026_04_28.md.
//   `electrode_adjustment_helper.hexa` is intentionally not modified.
//
// MODES
//   --selftest                synthetic 16ch all-GREEN ASCII render
//   --check                   one-shot full 16ch impedance sweep (~20s)
//   --watch                   round-robin 1ch/sec continuous (Ctrl-C stop)
//   --port <path>             Dongle serial node
//   --board <name>            cyton_daisy (default)
//   --green-kohm <n>          GREEN upper bound  (default 750)
//   --yellow-kohm <n>         YELLOW upper bound (default 3000 = 3 MΩ)
//   --check-n-pin             measure N-pin too (paranoid, doubles time)
//
//   F1 saline-bonded electrode reads < 750 kΩ → GREEN
//   F2 open-air electrode reads > 3 MΩ → RED
//   F3 board acks `Success: Lead off set for <N>$$$` on z<CH>10Z (verbose)
//   F4 channel separation: ch4 measurement does not bleed into ch5
//   F5 31.5 Hz FFT peak present with probe ON, absent with probe OFF
//
//  @resolver-bypass(reason="darwin-native: globs /dev/cu.usbserial-* and uses
//                   .venv-eeg/bin/python BrainFlow venv. Hetzner / linux pods
//                   do not expose host USB nor local venv.")

let SCHEMA              = "anima-eeg/impedance_check/1"
let HELPER_PATH         = "/tmp/anima_eeg_impedance_check_helper.py"

let DEFAULT_BOARD_ID            = 2
let DEFAULT_BOARD_NAME          = "cyton_daisy"
let DEFAULT_VENV_PYTHON         = ".venv-eeg/bin/python"
let DEFAULT_GREEN_KOHM          = 750
let DEFAULT_YELLOW_KOHM         = 3000
let DEFAULT_WINDOW_SECONDS      = 1
let LEDGER_PATH                 = "state/anima_eeg_impedance_ledger.jsonl"

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

// ISO-ish UTC timestamp, e.g. 20260428T130742Z. exec() since hexa has no builtin.
fn now_iso() -> string {
    return exec("date -u +%Y%m%dT%H%M%SZ").trim()
}

fn _board_name_to_id(name: string) -> int {
    if name == "cyton_daisy" { return 2 }
    if name == "cyton"       { return 0 }
    if name == "ganglion"    { return 1 }
    return -1
}

// 16-channel position metadata (matches electrode_adjustment_helper.hexa
// WIRE_META). Cyton ch1-8 use chars '1'-'8'; Daisy ch9-16 use Q W E R T Y U I.
fn _write_helper() {
    let py = "
import sys, os, time, argparse, json

def out_kv(k, v):
    print(str(k) + '=' + str(v), flush=True)

def err_trailer(reason, detail, fix):
    print('reason: ' + reason + ': ' + detail, file=sys.stderr, flush=True)
    print('fix: ' + fix, file=sys.stderr, flush=True)

def is_leaked_session_error(msg):
    #   .venv-eeg/lib/python3.12/site-packages/brainflow/exit_codes.py (2026-05-03)
    # Recoverable codes (release_all_sessions + retry):
    #     1 PORT_ALREADY_OPEN, 7 BOARD_NOT_READY, 8 STREAM_ALREADY_RUN,
    #    15 BOARD_NOT_CREATED, 16 ANOTHER_BOARD_IS_CREATED
    # NOT recoverable: 14 UNSUPPORTED_BOARD, 13 INVALID_ARGUMENTS, 17 GENERAL.
    if not isinstance(msg, str):
        msg = str(msg)
    LEAKED_NAMES = (
        'PORT_ALREADY_OPEN', 'BOARD_NOT_READY', 'STREAM_ALREADY_RUN',
        'BOARD_NOT_CREATED', 'ANOTHER_BOARD_IS_CREATED',
    )
    for name in LEAKED_NAMES:
        if name in msg:
            return True
    LEAKED_CODES = (':1 ', ':7 ', ':8 ', ':15 ', ':16 ',
                    ' code 1 ', ' code 7 ', ' code 8 ', ' code 15 ', ' code 16 ')
    for tok in LEAKED_CODES:
        if tok in msg:
            return True
    return False

def _detect_port_lock(port):
    # negative possible when foreign user owns the holding process. FALSE
    # POSITIVE possible: any process holding the port is reported, not just
    # OpenBCI GUI. Returns (locked, pid, pname).
    if not port:
        return False, 0, ''
    if not os.path.exists(port):
        return False, 0, ''
    import subprocess as _sp
    try:
        r = _sp.run(['lsof', '-F', 'p', port], capture_output=True, text=True, timeout=3)
        for ln in (r.stdout or '').splitlines():
            if ln.startswith('p'):
                try:
                    pid = int(ln[1:])
                except Exception:
                    continue
                pname = '?'
                try:
                    pr = _sp.run(['ps', '-p', str(pid), '-o', 'comm='],
                                 capture_output=True, text=True, timeout=2)
                    pname = (pr.stdout or '').strip() or '?'
                except Exception:
                    pass
                return True, pid, pname
    except Exception:
        pass
    return False, 0, ''

def _emit_port_lock_msg(port, pid, pname):
    pl = (pname or '').lower()
    guess = ''
    if 'java' in pl or 'openbci' in pl or 'processing' in pl:
        guess = ' (OpenBCI GUI 추정)'
    print('[port-lock] ' + str(port) + ' 점유 중:', file=sys.stderr, flush=True)
    print('  PID ' + str(pid) + ': ' + (pname or '?') + guess, file=sys.stderr, flush=True)
    print('', file=sys.stderr, flush=True)
    print('해결 방법:', file=sys.stderr, flush=True)
    print('  (a) OpenBCI GUI 종료 후 재시도', file=sys.stderr, flush=True)
    print('  (b) GUI 의 Networking widget 으로 LSL outlet 활성화 + anima-eeg/lsl_capture.hexa 사용', file=sys.stderr, flush=True)
    print('  (c) --force-port 로 우회 시도 (위험)', file=sys.stderr, flush=True)
    print('reason: port-lock-detected: PID=' + str(pid) + ' name=' + (pname or '?'),
          file=sys.stderr, flush=True)
    print('fix: 1) OpenBCI GUI Stop & Quit  2) 또는 --force-port 시도',
          file=sys.stderr, flush=True)

CHAN_CHARS = ['1','2','3','4','5','6','7','8','Q','W','E','R','T','Y','U','I']

WIRE_META = [
    ('Cyton', 'N1P', 'Fp1', 'Grey'),
    ('Cyton', 'N2P', 'Fp2', 'Purple'),
    ('Cyton', 'N3P', 'C3',  'Blue'),
    ('Cyton', 'N4P', 'C4',  'Green'),
    ('Cyton', 'N5P', 'P7',  'Yellow'),
    ('Cyton', 'N6P', 'P8',  'Orange'),
    ('Cyton', 'N7P', 'O1',  'Red'),
    ('Cyton', 'N8P', 'O2',  'Brown'),
    ('Daisy', 'N1P', 'F7',  'Grey'),
    ('Daisy', 'N2P', 'F8',  'Purple'),
    ('Daisy', 'N3P', 'F3',  'Blue'),
    ('Daisy', 'N4P', 'F4',  'Green'),
    ('Daisy', 'N5P', 'T7',  'Yellow'),
    ('Daisy', 'N6P', 'T8',  'Orange'),
    ('Daisy', 'N7P', 'P3',  'Red'),
    ('Daisy', 'N8P', 'P4',  'Brown'),
]

# Probe constants (ADS1299 LOFF_MAG_6NA, LOFF_FREQ_31p2HZ)
PROBE_FREQ_HZ = 31.5
PROBE_CURRENT_A = 6.0e-9   # 6 nA AC
SAMPLE_RATE_HZ = 250

def _set_ftdi_latency_1ms(serial_path):
    # 2026-05-03 sample-drop layer-2 fix. macOS Apple Silicon FTDI driver
    # ships LatencyTimer = 16 ms default → ring-buffer drains too slowly,
    # producing 33-94% sample drop (BrainFlow github #81 vendor confirm).
    #   (1) ioctl 0x80085400 = _IOW('T',0,unsigned long) on Darwin 64-bit
    #       (NOT spec-sheet 0x80045442 which is IOSSIOSPEED).
    #   (2) Per-device-attachment: persists until physical unplug.
    import platform as _pf
    if _pf.system() != 'Darwin':
        return False, 'skip-non-darwin'
    if not serial_path or not isinstance(serial_path, str):
        return False, 'no-port'
    if serial_path == '<synthetic>' or serial_path.startswith('<'):
        return False, 'skip-synthetic'
    import os as _os, fcntl as _fc, struct as _st
    if not _os.path.exists(serial_path):
        return False, 'no-device-node'
    IOSSDATALAT = 0x80085400
    try:
        fd = _os.open(serial_path, _os.O_RDWR | _os.O_NOCTTY | _os.O_NONBLOCK)
    except Exception as exc:
        return False, ('open-fail:' + repr(exc))[:120]
    try:
        _fc.ioctl(fd, IOSSDATALAT, _st.pack('L', 1000))
        ok, why = True, 'ok'
    except Exception as exc:
        ok, why = False, ('ioctl-fail:' + repr(exc))[:120]
    finally:
        try: _os.close(fd)
        except Exception: pass
    return ok, why

def classify(z_kohm, green_kohm, yellow_kohm):
    if z_kohm < 0:
        return 'GRAY'
    if z_kohm < green_kohm:
        return 'GREEN'
    if z_kohm < yellow_kohm:
        return 'YELLOW'
    return 'RED'

def measure_one_channel(board, ch_idx, eeg_chans, fs, seconds, check_n_pin):
    '''Send z<CH><P><N>Z, stream, FFT, return z_kohm (P-pin only by default).'''
    import numpy as np
    ch_char = CHAN_CHARS[ch_idx]
    p_pin = '1'
    n_pin = '1' if check_n_pin else '0'
    # Enable lead-off probe
    cmd_on = 'z' + ch_char + p_pin + n_pin + 'Z'
    cmd_off = 'z' + ch_char + '00Z'
    try:
        board.config_board(cmd_on)
    except Exception as e:
        err_trailer('config-board-failed', 'cmd=' + cmd_on + ' err=' + str(e)[:120],
                    '1) check radio link  2) verify board firmware >= v3')
        return -1.0, 'GRAY'

    # start_stream (post-prepare) when a stale board singleton leaked from a
    # prior helper. Retry once on leaked-session codes; non-leak errors abort.
    _start_err = ''
    try:
        board.start_stream()
        _start_err = ''
    except Exception as e:
        _start_err = str(e)
    if _start_err:
        if is_leaked_session_error(_start_err):
            print('[recovery] start_stream leaked-session error — retry: ' + _start_err[:120],
                  file=sys.stderr, flush=True)
            try: board.stop_stream()
            except Exception: pass
            try:
                board.start_stream()
                _start_err = ''
            except Exception as e2:
                _start_err = str(e2)
        if _start_err:
            err_trailer('start-stream-failed', _start_err[:120], '1) toggle Cyton OFF/PC')
            try: board.config_board(cmd_off)
            except: pass
            return -1.0, 'GRAY'

    time.sleep(seconds)

    try:
        data = board.get_board_data()
    except Exception as e:
        err_trailer('get-data-failed', str(e)[:120], '1) Dongle red LED?')
        try: board.stop_stream(); board.config_board(cmd_off)
        except: pass
        return -1.0, 'GRAY'

    try:
        board.stop_stream()
    except: pass

    try:
        board.config_board(cmd_off)
    except: pass

    # Pull EEG row for this channel; data shape (rows, cols), uV units
    eeg_row = eeg_chans[ch_idx]
    cols = data.shape[1] if data is not None and data.size else 0
    n_want = int(fs * seconds)
    if cols < int(n_want * 0.5):
        return -1.0, 'GRAY'

    sig = data[eeg_row, -n_want:] if cols >= n_want else data[eeg_row, :]
    n = len(sig)
    if n < 32:
        return -1.0, 'GRAY'

    # Hann-windowed rfft, find 31.5 Hz bin (bin width = fs/n ≈ 1 Hz)
    window = np.hanning(n)
    spec = np.fft.rfft(sig * window)
    freqs = np.fft.rfftfreq(n, 1.0 / fs)
    bin_idx = int(np.argmin(np.abs(freqs - PROBE_FREQ_HZ)))
    # Hann window coherent gain ≈ 0.5 → multiply by 4/n for amplitude in uV
    amplitude_uV = float(np.abs(spec[bin_idx]) * 4.0 / n)
    amplitude_V = amplitude_uV * 1.0e-6
    z_ohm = amplitude_V / PROBE_CURRENT_A
    z_kohm = z_ohm / 1000.0
    return z_kohm, 'OK_MEASURED'

def main_check(board_id, port, seconds, green_kohm, yellow_kohm, check_n_pin, watch_mode, force_port=False):
    try:
        import numpy as np
        from brainflow.board_shim import BoardShim, BrainFlowInputParams, BoardIds
    except ImportError as e:
        err_trailer('import-missing', str(e)[:160],
                    '1) source .venv-eeg/bin/activate  2) pip install brainflow numpy')
        out_kv('verdict', 'ABORT')
        return 4

    BoardShim.disable_board_logger()
    params = BrainFlowInputParams()
    if port:
        params.serial_port = port

    # Port-lock preflight: graceful fail when another process (most often
    # OpenBCI GUI) holds the dongle. macOS does not allow shared serial
    # access; without this check BrainFlow returns cryptic codes 1 / 7.
    if port and not force_port:
        _locked, _pid, _pname = _detect_port_lock(port)
        if _locked:
            _emit_port_lock_msg(port, _pid, _pname)
            out_kv('verdict', 'PORT_LOCKED')
            return 8

    # FTDI 1ms latency ioctl — call once before BrainFlow opens the port.
    # Setting persists until physical unplug, so safe to repeat per session.
    _ftdi_ok, _ftdi_why = _set_ftdi_latency_1ms(port)
    if _ftdi_ok:
        print('[ftdi-latency] set to 1ms on ' + str(port), file=sys.stderr, flush=True)
    else:
        print('[ftdi-latency] WARN: ioctl skipped/failed: ' + str(_ftdi_why), file=sys.stderr, flush=True)

    # defensive preflight to clear any leaked streaming session from a prior
    # cycle (e.g. crashed parent process left native lib holding the serial
    # port). release_all_sessions is a BoardShim classmethod that calls the
    # native release_all_sessions; if no session exists it returns STATUS_OK
    # silently → safe pre-call. retry-once on leaked-session errors (codes
    # 1/7/8/15/16 — see is_leaked_session_error) to recover without forcing
    # user toggle.
    try:
        BoardShim.release_all_sessions()
    except Exception:
        # silently pass — no session to release is the expected steady state
        pass

    board = None
    prepare_ok = False
    last_err = ''
    for attempt in (1, 2):
        try:
            board = BoardShim(board_id, params)
            board.prepare_session()
            prepare_ok = True
            break
        except Exception as e:
            last_err = str(e)[:160]
            if attempt == 1 and is_leaked_session_error(last_err):
                print('[recovery] leaked-session error 감지 — '
                      + last_err[:120],
                      file=sys.stderr, flush=True)
                print('[recovery] release_all_sessions() 호출 후 재시도...',
                      file=sys.stderr, flush=True)
                try:
                    BoardShim.release_all_sessions()
                except Exception:
                    pass
                time.sleep(2)
                continue
            # non-recoverable error or 2nd attempt failed → escape loop
            break

    if not prepare_ok:
        err_trailer('board-not-ready', last_err,
                    '1) Cyton 스위치 OFF (5초 대기) → PC 모드 → 재실행  '
                    '2) Daisy 모듈 정착 확인  3) Dongle 빨간 LED 확인')
        print('[recovery] 재시도 실패 — 사용자 액션 필요: '
              'Cyton OFF (5s) → PC → 재실행',
              file=sys.stderr, flush=True)
        out_kv('verdict', 'ABORT')
        return 4

    try:
        fs = BoardShim.get_sampling_rate(board_id)
        eeg_chans = BoardShim.get_eeg_channels(board_id)
    except Exception as e:
        err_trailer('board-meta-error', str(e)[:160], '1) check board_id')
        try: board.release_session()
        except: pass
        out_kv('verdict', 'ABORT')
        return 4

    n_ch = min(16, len(eeg_chans))
    out_kv('sample_rate_hz', fs)
    out_kv('eeg_channel_count', n_ch)
    out_kv('probe_freq_hz', PROBE_FREQ_HZ)
    out_kv('probe_current_a', PROBE_CURRENT_A)
    out_kv('check_n_pin', 1 if check_n_pin else 0)
    out_kv('green_kohm', green_kohm)
    out_kv('yellow_kohm', yellow_kohm)

    # Default register state, stop any active stream
    try: board.config_board('d')
    except: pass
    try: board.stop_stream()
    except: pass

    sweep_count = 0
    try:
        while True:
            sweep_count += 1
            out_kv('sweep_idx', sweep_count)
            n_green = 0; n_yellow = 0; n_red = 0; n_gray = 0
            for ch_idx in range(n_ch):
                z_kohm, status = measure_one_channel(board, ch_idx, eeg_chans, fs, seconds, check_n_pin)
                state = classify(z_kohm, green_kohm, yellow_kohm) if status == 'OK_MEASURED' else 'GRAY'
                if state == 'GREEN': n_green += 1
                elif state == 'YELLOW': n_yellow += 1
                elif state == 'RED': n_red += 1
                else: n_gray += 1
                wm = WIRE_META[ch_idx]
                cstr = '%02d' % ch_idx
                out_kv('ch_' + cstr + '_pos', wm[2])
                out_kv('ch_' + cstr + '_board', wm[0])
                out_kv('ch_' + cstr + '_pin', wm[1])
                out_kv('ch_' + cstr + '_color', wm[3])
                out_kv('ch_' + cstr + '_chan_char', CHAN_CHARS[ch_idx])
                out_kv('ch_' + cstr + '_z_kohm', round(z_kohm, 1) if z_kohm >= 0 else -1)
                out_kv('ch_' + cstr + '_state', state)

            out_kv('count_green', n_green)
            out_kv('count_yellow', n_yellow)
            out_kv('count_red', n_red)
            out_kv('count_gray', n_gray)
            if n_red > 0 or n_gray > 0:
                out_kv('verdict', 'NEEDS_ADJUSTMENT')
            elif n_yellow > 0:
                out_kv('verdict', 'MARGINAL')
            else:
                out_kv('verdict', 'ALL_GREEN')
            out_kv('honesty_class', 'REAL_HW_PASS' if n_red == 0 and n_gray == 0 else 'REAL_HW_FAIL')
            out_kv('sweep_done', 1)

            if not watch_mode:
                break
            # watch mode: short pause then re-sweep
            time.sleep(0.2)
    except KeyboardInterrupt:
        out_kv('verdict', 'INTERRUPTED')
    finally:
        try: board.stop_stream()
        except: pass
        try: board.release_session()
        except: pass
    return 0

def run_selftest(green_kohm, yellow_kohm):
    '''Synthetic 16ch all-GREEN — NOT_VERIFIED_SYNTHETIC honesty class.'''
    out_kv('mode', 'selftest_synthetic')
    out_kv('sample_rate_hz', SAMPLE_RATE_HZ)
    out_kv('eeg_channel_count', 16)
    out_kv('probe_freq_hz', PROBE_FREQ_HZ)
    out_kv('probe_current_a', PROBE_CURRENT_A)
    out_kv('check_n_pin', 0)
    out_kv('green_kohm', green_kohm)
    out_kv('yellow_kohm', yellow_kohm)
    out_kv('sweep_idx', 1)
    for ch_idx in range(16):
        wm = WIRE_META[ch_idx]
        cstr = '%02d' % ch_idx
        # Synthetic: deterministic 200 + 10*ch_idx kΩ → all GREEN under default 750
        synth_z = 200.0 + 10.0 * ch_idx
        out_kv('ch_' + cstr + '_pos', wm[2])
        out_kv('ch_' + cstr + '_board', wm[0])
        out_kv('ch_' + cstr + '_pin', wm[1])
        out_kv('ch_' + cstr + '_color', wm[3])
        out_kv('ch_' + cstr + '_chan_char', CHAN_CHARS[ch_idx])
        out_kv('ch_' + cstr + '_z_kohm', round(synth_z, 1))
        out_kv('ch_' + cstr + '_state', 'GREEN')
    out_kv('count_green', 16)
    out_kv('count_yellow', 0)
    out_kv('count_red', 0)
    out_kv('count_gray', 0)
    out_kv('verdict', 'ALL_GREEN')
    out_kv('honesty_class', 'NOT_VERIFIED_SYNTHETIC')
    out_kv('sweep_done', 1)
    return 0

if __name__ == '__main__':
    p = argparse.ArgumentParser()
    p.add_argument('mode', choices=['check', 'selftest', 'watch'])
    p.add_argument('--board-id', type=int, default=2)
    p.add_argument('--port', type=str, default='')
    p.add_argument('--seconds', type=int, default=1)
    p.add_argument('--green-kohm', type=int, default=750)
    p.add_argument('--yellow-kohm', type=int, default=3000)
    p.add_argument('--check-n-pin', action='store_true')
    p.add_argument('--force-port', action='store_true',
                   help='bypass port-lock detection (다른 program 점유 시 강제 시도)')
    args = p.parse_args()
    if args.mode == 'selftest':
        rc = run_selftest(args.green_kohm, args.yellow_kohm)
    elif args.mode == 'watch':
        rc = main_check(args.board_id, args.port, args.seconds,
                        args.green_kohm, args.yellow_kohm, args.check_n_pin, True,
                        force_port=args.force_port)
    else:
        rc = main_check(args.board_id, args.port, args.seconds,
                        args.green_kohm, args.yellow_kohm, args.check_n_pin, False,
                        force_port=args.force_port)
    sys.exit(rc)
"
    write_file(HELPER_PATH, py)
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        if a.starts_with("-") { break }
        let mut is_path = false
        if a.starts_with("/")    { is_path = true }
        if a.ends_with(".hexa")  { is_path = true }
        if a.ends_with(".real")  { is_path = true }
        if a.ends_with("/exe")   { is_path = true }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _kv_get_or(body: string, key: string, default_val: string) -> string {
    let v = _kv_lookup(body, key)
    if v == "" { return default_val }
    return v
}

// ANSI color rendering — chr(27) avoids `\x1b` string escape strip
fn _ansi_color(state: string) -> string {
    let esc = chr(27)
    if state == "GREEN"  { return esc + "[38;2;0;255;100m" }
    if state == "YELLOW" { return esc + "[38;2;230;199;0m" }
    if state == "RED"    { return esc + "[38;2;255;0;0m" }
    if state == "BLUE"   { return esc + "[38;2;65;96;128m" }
    if state == "GRAY"   { return esc + "[38;2;113;117;119m" }
    return ""
}

fn _ansi_reset() -> string {
    let esc = chr(27)
    return esc + "[0m"
}

fn _state_glyph(state: string) -> string {
    if state == "GREEN" || state == "YELLOW" || state == "RED" {
        return _ansi_color(state) + "[●]" + _ansi_reset()
    }
    if state == "BLUE" { return _ansi_color(state) + "[?]" + _ansi_reset() }
    return _ansi_color("GRAY") + "[·]" + _ansi_reset()
}

fn _state_for_pos(body: string, pos: string) -> string {
    let mut idx = 0
    while idx < 16 {
        let cstr = if idx < 10 { "0" + str(idx) } else { str(idx) }
        let p = _kv_lookup(body, "ch_" + cstr + "_pos")
        if p == pos {
            let s = _kv_lookup(body, "ch_" + cstr + "_state")
            if s == "" { return "GRAY" }
            return s
        }
        idx = idx + 1
    }
    return "GRAY"
}

fn _glyph_for_pos(body: string, pos: string) -> string {
    return _state_glyph(_state_for_pos(body, pos))
}

fn _render_ascii_map(body: string) {
    let g_fp1 = _glyph_for_pos(body, "Fp1")
    let g_fp2 = _glyph_for_pos(body, "Fp2")
    let g_f7  = _glyph_for_pos(body, "F7")
    let g_f3  = _glyph_for_pos(body, "F3")
    let g_f4  = _glyph_for_pos(body, "F4")
    let g_f8  = _glyph_for_pos(body, "F8")
    let g_t7  = _glyph_for_pos(body, "T7")
    let g_c3  = _glyph_for_pos(body, "C3")
    let g_c4  = _glyph_for_pos(body, "C4")
    let g_t8  = _glyph_for_pos(body, "T8")
    let g_p3  = _glyph_for_pos(body, "P3")
    let g_p4  = _glyph_for_pos(body, "P4")
    let g_p7  = _glyph_for_pos(body, "P7")
    let g_p8  = _glyph_for_pos(body, "P8")
    let g_o1  = _glyph_for_pos(body, "O1")
    let g_o2  = _glyph_for_pos(body, "O2")

    println("")
    println("    ┌─────────────────────────────────────────────┐")
    println("    │      IMPEDANCE Z-COMMAND (16ch ADS1299)     │")
    println("    └─────────────────────────────────────────────┘")
    println("")
    println("                Fp1" + g_fp1 + "   Fp2" + g_fp2 + "            Frontal pole")
    println("                    \\   /")
    println("           F7" + g_f7 + " - F3" + g_f3 + " - F4" + g_f4 + " - F8" + g_f8 + "      Frontal")
    println("                    |   |")
    println("           T7" + g_t7 + " - C3" + g_c3 + " - C4" + g_c4 + " - T8" + g_t8 + "      Central / Temporal")
    println("                    |   |")
    println("                P3" + g_p3 + " - P4" + g_p4 + "            Parietal")
    println("                   / | | \\")
    println("           P7" + g_p7 + "         P8" + g_p8 + "           Parietal-temporal")
    println("                O1" + g_o1 + "   O2" + g_o2 + "            Occipital")
    println("")
    let g_green = _ansi_color("GREEN") + "[●]" + _ansi_reset()
    let g_yellow = _ansi_color("YELLOW") + "[●]" + _ansi_reset()
    let g_red = _ansi_color("RED") + "[●]" + _ansi_reset()
    let g_gray = _ansi_color("GRAY") + "[·]" + _ansi_reset()
    println("    LEGEND:  " + g_green + " <750 kΩ   " + g_yellow + " 750k-3M   " + g_red + " >3 MΩ   " + g_gray + " not measured")
    println("")
}

fn _render_per_channel(body: string) {
    let green_kohm = _kv_get_or(body, "green_kohm", "750")
    let yellow_kohm = _kv_get_or(body, "yellow_kohm", "3000")
    println("    PER-CHANNEL IMPEDANCE (thresholds: GREEN<" + green_kohm + " kΩ, YELLOW<" + yellow_kohm + " kΩ):")
    println("    ─────────────────────────────────────────────────────────────")
    let mut idx = 0
    while idx < 16 {
        let cstr = if idx < 10 { "0" + str(idx) } else { str(idx) }
        let pos    = _kv_get_or(body, "ch_" + cstr + "_pos", "?")
        let state  = _kv_get_or(body, "ch_" + cstr + "_state", "GRAY")
        let z_kohm = _kv_get_or(body, "ch_" + cstr + "_z_kohm", "-1")
        let board  = _kv_get_or(body, "ch_" + cstr + "_board", "?")
        let pin    = _kv_get_or(body, "ch_" + cstr + "_pin", "?")
        let color_w = _kv_get_or(body, "ch_" + cstr + "_color", "?")
        let glyph = _state_glyph(state)
        let n = idx + 1
        let nstr = if n < 10 { " " + str(n) } else { str(n) }
        println("      ch" + nstr + " " + glyph + " " + pos + "  " + z_kohm + " kΩ  [" + state + "]  (" + board + " " + pin + " — " + color_w + ")")
        idx = idx + 1
    }
    println("")
}

fn _print_summary(body: string) {
    let n_green  = _kv_get_or(body, "count_green",  "0")
    let n_yellow = _kv_get_or(body, "count_yellow", "0")
    let n_red    = _kv_get_or(body, "count_red",    "0")
    let n_gray   = _kv_get_or(body, "count_gray",   "0")
    let verdict  = _kv_get_or(body, "verdict", "?")
    let honesty  = _kv_get_or(body, "honesty_class", "?")
    println("    SUMMARY: " + n_green + "/16 GREEN, " + n_yellow + "/16 YELLOW, " + n_red + "/16 RED, " + n_gray + "/16 GRAY")
    println("    VERDICT: " + verdict)
    println("")
}

// Emit per-sweep JSON snapshot to state/anima_eeg_impedance_<ts>.json
fn _emit_snapshot(body: string, ts: string) {
    let path = "state/anima_eeg_impedance_" + ts + ".json"
    let mut out = "{\n"
    out = out + "  \"schema\": \"" + SCHEMA + "\",\n"
    out = out + "  \"ts\": \"" + ts + "\",\n"
    out = out + "  \"verdict\": \"" + _kv_get_or(body, "verdict", "?") + "\",\n"
    out = out + "  \"honesty_class\": \"" + _kv_get_or(body, "honesty_class", "?") + "\",\n"
    out = out + "  \"green_kohm\": " + _kv_get_or(body, "green_kohm", "750") + ",\n"
    out = out + "  \"yellow_kohm\": " + _kv_get_or(body, "yellow_kohm", "3000") + ",\n"
    out = out + "  \"count_green\": " + _kv_get_or(body, "count_green", "0") + ",\n"
    out = out + "  \"count_yellow\": " + _kv_get_or(body, "count_yellow", "0") + ",\n"
    out = out + "  \"count_red\": " + _kv_get_or(body, "count_red", "0") + ",\n"
    out = out + "  \"count_gray\": " + _kv_get_or(body, "count_gray", "0") + ",\n"
    out = out + "  \"channels\": [\n"
    let mut idx = 0
    while idx < 16 {
        let cstr = if idx < 10 { "0" + str(idx) } else { str(idx) }
        let pos    = _kv_get_or(body, "ch_" + cstr + "_pos", "?")
        let state  = _kv_get_or(body, "ch_" + cstr + "_state", "GRAY")
        let z_kohm = _kv_get_or(body, "ch_" + cstr + "_z_kohm", "-1")
        let board  = _kv_get_or(body, "ch_" + cstr + "_board", "?")
        let pin    = _kv_get_or(body, "ch_" + cstr + "_pin", "?")
        let chan_char = _kv_get_or(body, "ch_" + cstr + "_chan_char", "?")
        out = out + "    {\"ch\": " + str(idx + 1) + ", \"chan_char\": \"" + chan_char + "\", \"pos\": \"" + pos + "\", \"board\": \"" + board + "\", \"pin\": \"" + pin + "\", \"z_kohm\": " + z_kohm + ", \"state\": \"" + state + "\"}"
        if idx < 15 { out = out + "," }
        out = out + "\n"
        idx = idx + 1
    }
    out = out + "  ]\n"
    out = out + "}\n"
    write_file(path, out)
    println("    snapshot: " + path)
}

fn _emit_ledger(body: string, ts: string) {
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"verdict\":\"" + _kv_get_or(body, "verdict", "?") + "\","
    row = row + "\"honesty_class\":\"" + _kv_get_or(body, "honesty_class", "?") + "\","
    row = row + "\"count_green\":" + _kv_get_or(body, "count_green", "0") + ","
    row = row + "\"count_yellow\":" + _kv_get_or(body, "count_yellow", "0") + ","
    row = row + "\"count_red\":" + _kv_get_or(body, "count_red", "0") + ","
    row = row + "\"count_gray\":" + _kv_get_or(body, "count_gray", "0")
    row = row + "}"
    // Append-by-rewrite: read existing (if any), concatenate new row + newline, write back.
    let nl = chr(10)
    let mut existing = ""
    let prior = read_file(LEDGER_PATH)
    if prior != "" { existing = prior }
    write_file(LEDGER_PATH, existing + row + nl)
}

fn _do_one_sweep(board_id: int, port: string, seconds: int,
                 green_kohm: int, yellow_kohm: int,
                 check_n_pin: bool, selftest: bool, ts: string, force_port: bool) -> int {
    let mode_arg = if selftest { "selftest" } else { "check" }
    let venv_py = DEFAULT_VENV_PYTHON
    let mut cmd = venv_py + " " + HELPER_PATH + " " + mode_arg
    cmd = cmd + " --board-id " + str(board_id)
    cmd = cmd + " --seconds " + str(seconds)
    cmd = cmd + " --green-kohm " + str(green_kohm)
    cmd = cmd + " --yellow-kohm " + str(yellow_kohm)
    if check_n_pin { cmd = cmd + " --check-n-pin" }
    if port != "" { cmd = cmd + " --port " + _sh_quote(port) }
    if force_port { cmd = cmd + " --force-port" }
    cmd = cmd + " > /tmp/anima_eeg_impedance_out.log 2> /tmp/anima_eeg_impedance_err.log"

    // expects int. Use exec_with_status() and unwrap the int exit code.
    let r = exec_with_status(cmd)
    let _rc = to_int(r[1])

    let stdout_body = read_file("/tmp/anima_eeg_impedance_out.log")
    let stderr_body = read_file("/tmp/anima_eeg_impedance_err.log")

    if stderr_body != "" { eprintln(stderr_body.trim()) }

    _render_ascii_map(stdout_body)
    _render_per_channel(stdout_body)
    _print_summary(stdout_body)
    _emit_snapshot(stdout_body, ts)
    _emit_ledger(stdout_body, ts)
    return _rc
}

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/impedance_check.hexa --selftest")
    eprintln("       hexa run anima-eeg/impedance_check.hexa --check  [--port <p>]")
    eprintln("       hexa run anima-eeg/impedance_check.hexa --watch  [--port <p>]")
    eprintln("flags:")
    eprintln("  --selftest                synthetic 16ch all-GREEN ASCII demo")
    eprintln("  --check                   one-shot full 16ch sweep (~20s)")
    eprintln("  --watch                   round-robin re-sweep loop")
    eprintln("  --port <path>             Dongle serial node")
    eprintln("  --board <name>            cyton_daisy | cyton (default cyton_daisy)")
    eprintln("  --green-kohm <n>          GREEN upper bound (default 750)")
    eprintln("  --yellow-kohm <n>         YELLOW upper bound (default 3000)")
    eprintln("  --check-n-pin             include N-pin probe (paranoid; doubles time)")
    eprintln("  --force-port              bypass port-lock detection (다른 program 점유 시 강제 시도)")
    eprintln("  --help                    this message")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut check_mode = false
    let mut watch_mode = false
    let mut want_help = false
    let mut port = ""
    let mut seconds = DEFAULT_WINDOW_SECONDS
    let mut board_name = DEFAULT_BOARD_NAME
    let mut green_kohm = DEFAULT_GREEN_KOHM
    let mut yellow_kohm = DEFAULT_YELLOW_KOHM
    let mut check_n_pin = false
    let mut force_port = false

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"   { selftest = true; i = i + 1; continue }
        if a == "--check"      { check_mode = true; i = i + 1; continue }
        if a == "--watch"      { watch_mode = true; i = i + 1; continue }
        if a == "--check-n-pin"{ check_n_pin = true; i = i + 1; continue }
        if a == "--force-port" { force_port = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--port" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--port requires a value", "1) re-run with --port <path>")
                exit(2)
            }
            port = av[i + 1]; i = i + 2; continue
        }
        if a == "--seconds" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--seconds requires int", "1) --seconds 1")
                exit(2)
            }
            seconds = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--green-kohm" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--green-kohm requires int", "1) --green-kohm 750")
                exit(2)
            }
            green_kohm = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--yellow-kohm" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--yellow-kohm requires int", "1) --yellow-kohm 3000")
                exit(2)
            }
            yellow_kohm = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--board" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--board requires value", "1) --board cyton_daisy")
                exit(2)
            }
            board_name = av[i + 1]; i = i + 2; continue
        }
        _emit_trailer("unknown-arg", "unrecognized: " + a, "1) --help")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }
    if !selftest && !check_mode && !watch_mode {
        eprintln("ABORT: must pass --selftest | --check | --watch")
        _print_usage()
        exit(2)
    }

    _write_helper()

    let board_id = _board_name_to_id(board_name)
    if board_id < 0 {
        _emit_trailer("invalid-board", "unknown: " + board_name, "1) --board cyton_daisy")
        exit(2)
    }

    let ts = if selftest { "selftest_synth" } else { now_iso() }

    println("══════════════════════════════════════════════════")
    println("  anima-eeg impedance_check (z-command)")
    println("  schema: " + SCHEMA)
    if selftest {
        println("  mode: selftest (synthetic — NOT_VERIFIED_SYNTHETIC)")
    } else {
        println("  mode: " + (if watch_mode { "watch (loop)" } else { "check (one-shot)" }))
        println("  port: " + port)
    }
    println("  thresholds: GREEN<" + str(green_kohm) + " kΩ, YELLOW<" + str(yellow_kohm) + " kΩ")
    println("  probe: 31.5 Hz @ 6 nA, P-pin" + (if check_n_pin { "+N-pin" } else { " only" }))
    println("══════════════════════════════════════════════════")

    if watch_mode {
        let mut tick = 0
        while true {
            tick = tick + 1
            println("")
            println("─── sweep #" + str(tick) + " ───")
            let _rc = _do_one_sweep(board_id, port, seconds, green_kohm, yellow_kohm, check_n_pin, false, now_iso(), force_port)
            println("    (Ctrl-C 로 종료)")
            sleep(1)
        }
    } else {
        let rc = _do_one_sweep(board_id, port, seconds, green_kohm, yellow_kohm, check_n_pin, selftest, ts, force_port)
        exit(rc)
    }
}
