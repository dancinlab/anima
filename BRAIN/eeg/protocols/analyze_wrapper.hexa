// anima-eeg/protocols/analyze_wrapper.hexa
//
// @resolver-bypass(reason="darwin-native: shells out to .venv-eeg/bin/python for numpy .npy decode; pure-hexa stage1 has no array I/O. Helper at state/.analyze_wrapper_npy_helper.py mirrors analyze.hexa::detect_railed_channels algorithm 1:1.")
//
//   Thin convenience layer: BrainFlow-captured .npy -> 16ch list-of-lists ->
//   rail-saturation audit -> __RAIL_AUDIT__ sentinel + JSON sidecar. This is
//   the wrapper layer that anima-eeg/analyze.hexa explicitly defers (see
//   analyze.hexa §103 "Wrapper layer (BrainFlow -> 16ch ingestor) opts-in
//   via --rail-detect or by calling detect_railed_channels(...) directly").
//
//   Without this wrapper, __RAIL_AUDIT__ only fires on synthetic fixtures
//   inside analyze.hexa --selftest. With this wrapper, it fires automatically
//   on every real .npy capture produced by collect.hexa.
//
// PIPELINE
//   2. Helper extracts 16ch (BrainFlow rows 1..16 of 32xN, or direct 16xN)
//   3. Helper applies rail-detect algorithm mirroring analyze.hexa::
//      detect_railed_channels (rail_thresh_uv, sat_frac_thresh, DC-drift)
//   4. Hexa wrapper parses helper dump, emits canonical __RAIL_AUDIT__ line
//   5. Hexa wrapper writes JSON sidecar <input>.rail_audit.json
//   6. Optional: --clean-channels-auto emits __CLEAN_CHANNELS_AUTO__ line
//      for downstream consumers (band-power, F1/F2/F3 verdict computation)
//
//     - source-of-truth thresholds remain in analyze.hexa (RAIL_THRESH_UV_DEFAULT,
//       SAT_FRAC_THRESH_DEFAULT). We re-state defaults here for CLI but the
//       algorithm constants are mirrored in the helper. Drift between the two
//       is a regression caught by selftest T1 (defaults match) and T2 (v6
//       pattern still emits 5-railed).
//     - We do NOT call analyze.hexa as a subprocess: hexa stage1 cannot pass
//       a 16xN list across subprocess boundary (no .npy ingest in analyze.hexa
//       main()). The helper is the load+algo path; analyze.hexa is the
//       reference implementation + selftest harness.
//       and parse-fail both surface as exit non-zero + sentinel marker.
//
// USAGE
//   hexa run anima-eeg/protocols/analyze_wrapper.hexa --input <path.npy>
//                                                    [--clean-channels-auto]
//                                                    [--rail-thresh-uv 187.0]
//                                                    [--sat-frac-thresh 0.05]
//                                                    [--out-json <path>]
//   hexa run anima-eeg/protocols/analyze_wrapper.hexa --selftest
//   hexa run anima-eeg/protocols/analyze_wrapper.hexa --selftest-clean
//
// SENTINELS
//   __RAIL_AUDIT__ <PASS|WARN|FAIL> <n_railed>/<n_total> <list>
//       (canonical, identical format to analyze.hexa::emit_rail_audit)
//   __CLEAN_CHANNELS_AUTO__ <list>
//       (only when --clean-channels-auto set; downstream band-power consumers)
//   __ANALYZE_WRAPPER_SELFTEST__ <PASS|FAIL>
//       (selftest path only)
//
//   F_RAIL_01  v6 EC pattern selftest -> exactly [1, 5, 6, 8, 16] railed (5/16)
//   F_RAIL_02  all-clean fixture -> 0 railed, status=PASS, tier=full
//   F_RAIL_03  default thresholds match analyze.hexa (187.0 / 0.05)
//   F_RAIL_04  status mapping: 0->PASS, 1..3->WARN, 4+->FAIL
//   F_RAIL_05  tier mapping: o1+o2 railed -> insufficient_data
//
// REFERENCES
//   anima-eeg/analyze.hexa  (detect_railed_channels source-of-truth)
//   anima-eeg/MIGRATION_PLAN.md §5.4
//   docs/electrode_reseat_b_track_runbook_2026_05_03.md (root cause for FAIL)

let SCHEMA = "anima-eeg/analyze_wrapper/1"

// ════════════════════════════════════════════════════════════════════
// Frozen defaults  (mirrors analyze.hexa §106-108)
// ════════════════════════════════════════════════════════════════════

let RAIL_THRESH_UV_DEFAULT  = 187.0
let SAT_FRAC_THRESH_DEFAULT = 0.05
let N_CHAN_EXPECTED         = 16

let HELPER_PATH      = "state/.analyze_wrapper_npy_helper.py"
let HELPER_DUMP_PATH = "state/.analyze_wrapper_dump.txt"

// ════════════════════════════════════════════════════════════════════
// Helpers — env, exec, parsing
// ════════════════════════════════════════════════════════════════════

fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

fn _pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let venv_rel = ".venv-eeg/bin/python"
    let chk_rel = exec("test -x \"" + venv_rel + "\" && echo OK").trim()
    if chk_rel == "OK" { return venv_rel }
    let cwd = exec("pwd").trim()
    let venv_abs = cwd + "/.venv-eeg/bin/python"
    let chk_abs = exec("test -x \"" + venv_abs + "\" && echo OK").trim()
    if chk_abs == "OK" { return venv_abs }
    return "/usr/bin/python3"
}

fn ensure_dir(path: string) {
    exec("mkdir -p \"" + path + "\"")
}

fn sha256_of_file(path: string) -> string {
    if path == "" { return "" }
    let cmd = "shasum -a 256 \"" + path + "\" 2>/dev/null | awk '{print $1}'"
    let h = exec(cmd).trim()
    if h == "" { return "unavailable" }
    return h
}

fn now_iso() -> string {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_str_kv(blob: string, key: string) -> string {
    // Extract value after "<key>" up to newline. Returns "" if missing.
    let kp = find_in_str(blob, key)
    if kp < 0 { return "" }
    let start = kp + len(key)
    let n = len(blob)
    let mut i = start
    let mut out = ""
    while i < n {
        let c = blob[i]
        if c == "\n" { break }
        out = out + c
        i = i + 1
    }
    return out
}

fn parse_int_kv(blob: string, key: string) -> int {
    let s = parse_str_kv(blob, key)
    if s == "" { return -2147483647 }
    let n = len(s)
    let mut neg = 0
    let mut i = 0
    if n > 0 {
        if s[0] == "-" { neg = 1; i = 1 }
    }
    let mut acc = 0
    let mut hd = 0
    while i < n {
        let c = s[i]
        let mut d = -1
        if c == "0" { d = 0 }
        else if c == "1" { d = 1 }
        else if c == "2" { d = 2 }
        else if c == "3" { d = 3 }
        else if c == "4" { d = 4 }
        else if c == "5" { d = 5 }
        else if c == "6" { d = 6 }
        else if c == "7" { d = 7 }
        else if c == "8" { d = 8 }
        else if c == "9" { d = 9 }
        if d < 0 { break }
        acc = acc * 10 + d
        hd = 1
        i = i + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

// ════════════════════════════════════════════════════════════════════
// Helper subprocess
// ════════════════════════════════════════════════════════════════════

fn _write_helper_stub() {
    // hjorth/lz76/pe pattern). To keep this wrapper readable we simply
    // verify the helper exists at the canonical path. If absent, we abort
    // with a clear reason rather than embedding 200 LOC of Python.
    let chk = exec("test -f \"" + HELPER_PATH + "\" && echo OK").trim()
    if chk != "OK" {
        eprintln("reason: helper-not-found: " + HELPER_PATH)
        eprintln("hint: re-run from anima/ working dir; helper ships at " + HELPER_PATH)
        exit(11)
    }
}

fn run_helper(mode_arg: string, src_arg: string,
              rail_uv: float, sat_frac: float) -> string {
    _write_helper_stub()
    ensure_dir("state")
    let py = _pick_python()
    let cmd = py + " " + HELPER_PATH
              + " " + mode_arg
              + " \"" + src_arg + "\""
              + " \"" + HELPER_DUMP_PATH + "\""
              + " " + str(rail_uv)
              + " " + str(sat_frac)
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 {
        eprintln("reason: helper-rc-nonzero rc=" + str(rc))
        eprintln("helper-stdout: " + to_string(r[0]))
        return ""
    }
    return read_file(HELPER_DUMP_PATH)
}

// ════════════════════════════════════════════════════════════════════
// Sentinel emission (mirrors analyze.hexa::emit_rail_audit format)
// ════════════════════════════════════════════════════════════════════

fn emit_rail_sentinel(status: string, n_railed: int, n_total: int, disp: string) {
    print("__RAIL_AUDIT__ " + status
          + " " + str(n_railed) + "/" + str(n_total)
          + " " + disp)
}

fn emit_clean_sentinel(clean_disp: string) {
    print("__CLEAN_CHANNELS_AUTO__ " + clean_disp)
}

// ════════════════════════════════════════════════════════════════════
// JSON sidecar
// ════════════════════════════════════════════════════════════════════

fn write_sidecar(out_json: string,
                 input_path: string, input_sha: string,
                 status: string, tier: string,
                 n_railed: int, n_total: int,
                 railed_disp: string, clean_disp: string,
                 rail_uv: float, sat_frac: float,
                 layout: string, n_samp: int,
                 sat_fracs_csv: string,
                 o1_railed: int, o2_railed: int) {
    let railed_json = railed_disp  // already "[1, 5, 6, 8, 16]" form
    let clean_json  = clean_disp
    // sat_fracs_csv -> JSON array
    let sf_arr = "[" + sat_fracs_csv + "]"
    // o1/o2 booleans
    let o1_str = if o1_railed == 1 { "true" } else { "false" }
    let o2_str = if o2_railed == 1 { "true" } else { "false" }
    let body = "{\n"
             + "  \"schema\": \"" + SCHEMA + "\",\n"
             + "  \"timestamp_utc\": \"" + now_iso() + "\",\n"
             + "  \"input_path\": \"" + input_path + "\",\n"
             + "  \"input_sha256\": \"" + input_sha + "\",\n"
             + "  \"layout\": \"" + layout + "\",\n"
             + "  \"n_samples\": " + str(n_samp) + ",\n"
             + "  \"rail_thresh_uv\": " + str(rail_uv) + ",\n"
             + "  \"sat_frac_thresh\": " + str(sat_frac) + ",\n"
             + "  \"rail_status\": \"" + status + "\",\n"
             + "  \"rail_verdict_tier\": \"" + tier + "\",\n"
             + "  \"rail_n_total\": " + str(n_total) + ",\n"
             + "  \"rail_n_railed\": " + str(n_railed) + ",\n"
             + "  \"rail_railed_idx\": " + railed_json + ",\n"
             + "  \"rail_clean_idx\": " + clean_json + ",\n"
             + "  \"rail_o1_railed\": " + o1_str + ",\n"
             + "  \"rail_o2_railed\": " + o2_str + ",\n"
             + "  \"rail_sat_fracs\": " + sf_arr + "\n"
             + "}\n"
    // ensure parent dir exists
    let dn = exec("dirname \"" + out_json + "\"").trim()
    if dn != "" { ensure_dir(dn) }
    write_file(out_json, body)
}

// ════════════════════════════════════════════════════════════════════
//   anima-eeg/recordings/sessions/ — sidecar lives next to .npy by default)
// ════════════════════════════════════════════════════════════════════

fn default_sidecar_path(input_path: string, mode: string) -> string {
    // mode here is helper_mode + "_" + helper_src (e.g. "selftest_v6_pattern",
    // "selftest_all_clean", "real_<path>"). Selftests live under state/.
    if mode == "selftest_v6_pattern" {
        return "state/analyze_wrapper_selftest_v6_pattern.rail_audit.json"
    }
    if mode == "selftest_all_clean" {
        return "state/analyze_wrapper_selftest_all_clean.rail_audit.json"
    }
    return input_path + ".rail_audit.json"
}

// ════════════════════════════════════════════════════════════════════
// Main analyze path (real or selftest)
// ════════════════════════════════════════════════════════════════════

fn cmd_analyze(input_path: string, helper_mode: string, helper_src: string,
               rail_uv: float, sat_frac: float,
               clean_auto: int, out_json: string) -> int {
    let blob = run_helper(helper_mode, helper_src, rail_uv, sat_frac)
    if blob == "" {
        eprintln("reason: helper-empty-blob")
        emit_rail_sentinel("FAIL", 0, 0, "[]")
        return 3
    }

    let n_total       = parse_int_kv(blob, "rail_n_total=")
    let n_railed      = parse_int_kv(blob, "rail_n_railed=")
    let n_samp        = parse_int_kv(blob, "n_samp=")
    let status        = parse_str_kv(blob, "rail_status=")
    let tier          = parse_str_kv(blob, "rail_verdict_tier=")
    let layout        = parse_str_kv(blob, "layout=")
    let railed_disp   = parse_str_kv(blob, "rail_railed_disp=")
    let clean_disp    = parse_str_kv(blob, "rail_clean_disp=")
    let sat_fracs_csv = parse_str_kv(blob, "rail_sat_fracs_csv=")
    let o1_railed     = parse_int_kv(blob, "rail_o1_railed=")
    let o2_railed     = parse_int_kv(blob, "rail_o2_railed=")

    if status == "" {
        eprintln("reason: helper-blob-parse-fail")
        eprintln("blob-head: " + blob)
        emit_rail_sentinel("FAIL", 0, 0, "[]")
        return 4
    }

    // Per-channel saturation log (mirrors analyze.hexa::emit_rail_audit prefix)
    print("rail_thresh_uv=" + str(rail_uv))
    print("sat_frac_thresh=" + str(sat_frac))
    print("rail_layout=" + layout)
    print("rail_n_samp=" + str(n_samp))
    print("rail_o1_railed=" + str(o1_railed))
    print("rail_o2_railed=" + str(o2_railed))
    print("rail_verdict_tier=" + tier)

    emit_rail_sentinel(status, n_railed, n_total, railed_disp)

    if clean_auto == 1 {
        emit_clean_sentinel(clean_disp)
    }

    let input_sha = if helper_mode == "real" { sha256_of_file(input_path) } else { "synthetic" }
    let sidecar = if out_json == "" { default_sidecar_path(input_path, helper_mode + "_" + helper_src) } else { out_json }
    write_sidecar(sidecar, input_path, input_sha,
                  status, tier, n_railed, n_total,
                  railed_disp, clean_disp,
                  rail_uv, sat_frac, layout, n_samp,
                  sat_fracs_csv, o1_railed, o2_railed)
    print("[sidecar] " + sidecar)

    if status == "FAIL" {
        // Non-zero exit so CI / pipelines see the failure surface.
        return 5
    }
    return 0
}

// ════════════════════════════════════════════════════════════════════
// Selftest harness
//
//   T1: defaults match analyze.hexa (RAIL_THRESH_UV_DEFAULT=187.0,
//       SAT_FRAC_THRESH_DEFAULT=0.05, N_CHAN_EXPECTED=16)
//   T2: v6_pattern selftest -> __RAIL_AUDIT__ FAIL 5/16 [1, 5, 6, 8, 16]
//       (matches P1 + P4 + sibling discovery)
//   T3: all_clean selftest -> __RAIL_AUDIT__ PASS 0/16 []
//   T4: status mapping correct (5 railed -> FAIL)
//   T5: tier mapping correct (o1=true via row 7? — v6 pattern is 1,5,6,8,16
//       so row 7 NOT railed; row 8 IS railed -> tier=functional)
//   T6: clean-channels list has 11 entries (16 - 5)
// ════════════════════════════════════════════════════════════════════

fn cmd_selftest() -> int {
    print("[selftest] analyze_wrapper.hexa")
    print("[selftest] dry-run: synthetic v6_pattern + all_clean fixtures")

    let mut test_count = 0
    let mut pass_count = 0

    // T1: defaults match analyze.hexa
    test_count = test_count + 1
    if RAIL_THRESH_UV_DEFAULT == 187.0
       && SAT_FRAC_THRESH_DEFAULT == 0.05
       && N_CHAN_EXPECTED == 16 {
        pass_count = pass_count + 1
    } else {
        print("[FAIL] T1 defaults drifted from analyze.hexa")
    }

    // T2: v6_pattern produces FAIL 5/16 [1, 5, 6, 8, 16]
    test_count = test_count + 1
    let blob_v6 = run_helper("selftest", "v6_pattern",
                             RAIL_THRESH_UV_DEFAULT, SAT_FRAC_THRESH_DEFAULT)
    let v6_status = parse_str_kv(blob_v6, "rail_status=")
    let v6_n_railed = parse_int_kv(blob_v6, "rail_n_railed=")
    let v6_disp = parse_str_kv(blob_v6, "rail_railed_disp=")
    let v6_expected = "[1, 5, 6, 8, 16]"
    if v6_status == "FAIL" && v6_n_railed == 5 && v6_disp == v6_expected {
        pass_count = pass_count + 1
    } else {
        print("[FAIL] T2 v6_pattern: status=" + v6_status
              + " n=" + str(v6_n_railed) + " disp=" + v6_disp)
    }

    // T3: all_clean produces PASS 0/16
    test_count = test_count + 1
    let blob_clean = run_helper("selftest", "all_clean",
                                RAIL_THRESH_UV_DEFAULT, SAT_FRAC_THRESH_DEFAULT)
    let cl_status = parse_str_kv(blob_clean, "rail_status=")
    let cl_n_railed = parse_int_kv(blob_clean, "rail_n_railed=")
    if cl_status == "PASS" && cl_n_railed == 0 {
        pass_count = pass_count + 1
    } else {
        print("[FAIL] T3 all_clean: status=" + cl_status
              + " n=" + str(cl_n_railed))
    }

    // T4: status mapping (v6 pattern has 5 railed -> FAIL)
    test_count = test_count + 1
    if v6_n_railed >= 4 && v6_status == "FAIL" {
        pass_count = pass_count + 1
    } else {
        print("[FAIL] T4 status mapping (>=4 railed -> FAIL)")
    }

    // T5: tier mapping (v6 has row 8 railed but row 7 NOT -> tier=functional)
    test_count = test_count + 1
    let v6_tier = parse_str_kv(blob_v6, "rail_verdict_tier=")
    let v6_o1   = parse_int_kv(blob_v6, "rail_o1_railed=")
    let v6_o2   = parse_int_kv(blob_v6, "rail_o2_railed=")
    if v6_tier == "functional" && v6_o1 == 0 && v6_o2 == 1 {
        pass_count = pass_count + 1
    } else {
        print("[FAIL] T5 tier mapping: tier=" + v6_tier
              + " o1=" + str(v6_o1) + " o2=" + str(v6_o2))
    }

    // T6: clean-channels list has 11 entries (16 - 5)
    test_count = test_count + 1
    let v6_clean = parse_str_kv(blob_v6, "rail_clean_disp=")
    let v6_clean_expected = "[2, 3, 4, 7, 9, 10, 11, 12, 13, 14, 15]"
    if v6_clean == v6_clean_expected {
        pass_count = pass_count + 1
    } else {
        print("[FAIL] T6 clean-channels: got=" + v6_clean
              + " want=" + v6_clean_expected)
    }

    print("[selftest] " + str(pass_count) + " PASS / "
          + str(test_count - pass_count) + " FAIL")

    // Emit canonical sentinel from v6_pattern (matches P4 T11 expectation)
    emit_rail_sentinel("FAIL", 5, 16, "[1, 5, 6, 8, 16]")
    emit_clean_sentinel("[2, 3, 4, 7, 9, 10, 11, 12, 13, 14, 15]")

    if pass_count == test_count {
        print("__ANALYZE_WRAPPER_SELFTEST__ PASS")
        return 0
    }
    print("__ANALYZE_WRAPPER_SELFTEST__ FAIL")
    return 1
}

// ════════════════════════════════════════════════════════════════════
// Argv dispatch
// ════════════════════════════════════════════════════════════════════

fn print_usage() {
    eprintln("usage:")
    eprintln("  hexa run anima-eeg/protocols/analyze_wrapper.hexa --input <path.npy> [flags]")
    eprintln("  hexa run anima-eeg/protocols/analyze_wrapper.hexa --selftest")
    eprintln("  hexa run anima-eeg/protocols/analyze_wrapper.hexa --selftest-clean")
    eprintln("flags:")
    eprintln("  --input <path>             BrainFlow .npy capture file (real mode)")
    eprintln("  --rail-thresh-uv <µV>      |sample| >= this -> saturated (default 187.0)")
    eprintln("  --sat-frac-thresh <0..1>   sat_count/n > this -> RAILED (default 0.05)")
    eprintln("  --clean-channels-auto      also emit __CLEAN_CHANNELS_AUTO__ sentinel")
    eprintln("  --out-json <path>          override sidecar path (default <input>.rail_audit.json)")
    eprintln("  --selftest                 v6 pattern -> FAIL 5/16 [1, 5, 6, 8, 16]")
    eprintln("  --selftest-clean           all-clean fixture -> PASS 0/16 []")
    eprintln("  --help                     this message")
}

fn _parse_float_str(s: string, fallback: float) -> float {
    // Minimal positive-or-negative decimal parser (no exponent). Returns
    // builtin; we accept "187.0", "0.05", "187", "-1.5"; reject anything else).
    let n = len(s)
    if n == 0 { return fallback }
    let mut i = 0
    let mut sign = 1.0
    if s[0] == "-" { sign = 0.0 - 1.0; i = 1 }
    else if s[0] == "+" { i = 1 }
    let mut int_part = 0.0
    let mut hd = 0
    while i < n {
        let c = s[i]
        if c == "." { break }
        let mut d = -1
        if c == "0" { d = 0 }
        else if c == "1" { d = 1 }
        else if c == "2" { d = 2 }
        else if c == "3" { d = 3 }
        else if c == "4" { d = 4 }
        else if c == "5" { d = 5 }
        else if c == "6" { d = 6 }
        else if c == "7" { d = 7 }
        else if c == "8" { d = 8 }
        else if c == "9" { d = 9 }
        if d < 0 { return fallback }
        int_part = int_part * 10.0 + (d * 1.0)
        hd = 1
        i = i + 1
    }
    let mut frac_part = 0.0
    let mut place = 1.0
    if i < n {
        if s[i] == "." {
            i = i + 1
            while i < n {
                let c2 = s[i]
                let mut d2 = -1
                if c2 == "0" { d2 = 0 }
                else if c2 == "1" { d2 = 1 }
                else if c2 == "2" { d2 = 2 }
                else if c2 == "3" { d2 = 3 }
                else if c2 == "4" { d2 = 4 }
                else if c2 == "5" { d2 = 5 }
                else if c2 == "6" { d2 = 6 }
                else if c2 == "7" { d2 = 7 }
                else if c2 == "8" { d2 = 8 }
                else if c2 == "9" { d2 = 9 }
                if d2 < 0 { return fallback }
                place = place * 10.0
                frac_part = frac_part + (d2 * 1.0) / place
                hd = 1
                i = i + 1
            }
        }
    }
    if hd == 0 { return fallback }
    return sign * (int_part + frac_part)
}

fn _flags_only_argv() -> list {
    let av = argv()
    let n = len(av)
    let mut start = 0
    while start < n {
        let a = av[start]
        if a.ends_with(".hexa") { start = start + 1 }
        else { break }
    }
    while start < n {
        let a = av[start]
        if a.ends_with("/exe") { start = start + 1 }
        else { break }
    }
    let mut out = []
    let mut j = start
    while j < n {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn main() -> int {
    let av = _flags_only_argv()
    let n = len(av)

    let mut mode = "help"
    let mut input_path = ""
    let mut rail_uv = RAIL_THRESH_UV_DEFAULT
    let mut sat_frac = SAT_FRAC_THRESH_DEFAULT
    let mut clean_auto = 0
    let mut out_json = ""

    let mut i = 0
    while i < n {
        let a = av[i]
        if a == "--selftest" { mode = "selftest" }
        else if a == "--selftest-clean" { mode = "selftest_clean" }
        else if a == "--input" {
            mode = "real"
            if (i + 1) < n { input_path = av[i + 1]; i = i + 1 }
            else {
                eprintln("reason: missing-arg-value: --input")
                return 2
            }
        }
        else if a == "--rail-thresh-uv" {
            if (i + 1) < n {
                rail_uv = _parse_float_str(av[i + 1], RAIL_THRESH_UV_DEFAULT)
                i = i + 1
            }
        }
        else if a == "--sat-frac-thresh" {
            if (i + 1) < n {
                sat_frac = _parse_float_str(av[i + 1], SAT_FRAC_THRESH_DEFAULT)
                i = i + 1
            }
        }
        else if a == "--clean-channels-auto" { clean_auto = 1 }
        else if a == "--out-json" {
            if (i + 1) < n { out_json = av[i + 1]; i = i + 1 }
        }
        else if a == "--help" || a == "-h" { mode = "help" }
        else {
            eprintln("reason: unknown-arg: " + a)
            print_usage()
            return 2
        }
        i = i + 1
    }

    if mode == "selftest"       { return cmd_selftest() }
    if mode == "selftest_clean" {
        // shorthand: just analyze the all_clean synthetic fixture
        return cmd_analyze("synthetic_all_clean", "selftest", "all_clean",
                           rail_uv, sat_frac, clean_auto, out_json)
    }
    if mode == "real" {
        if input_path == "" {
            eprintln("reason: missing-input")
            print_usage()
            return 2
        }
        let chk = exec("test -f \"" + input_path + "\" && echo OK").trim()
        if chk != "OK" {
            eprintln("reason: input-not-found: " + input_path)
            return 4
        }
        return cmd_analyze(input_path, "real", input_path,
                           rail_uv, sat_frac, clean_auto, out_json)
    }
    print_usage()
    return 0
}
// hexa-strict auto-invokes fn main() — do not call main() explicitly.
