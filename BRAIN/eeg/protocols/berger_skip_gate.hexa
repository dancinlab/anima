// hexa-brain/eeg/protocols/berger_skip_gate.hexa
//
// @resolver-bypass(reason="darwin-native: reads ledger jsonl from disk + system clock; selftest pure-hexa.")
//
//   Berger EC/EO skip-gate — decides whether the user must run the full
//   5-min Berger session (alpha_eyes_closed.hexa) or whether a recent
//   PASS in the ledger satisfies the capture-quality assumption.
//
//   Used by:
//     - eeg_setup.hexa  quick subcommand (new)
//     - alpha_eyes_closed.hexa  (--quick flag bypasses block-design when allowed)
//     - master_preflight.hexa   (optional Step 5 if Berger is requested)
//
//   path: state/berger_pass_ledger.jsonl
//   row schema:
//     {
//       "ts": "2026-05-07T12:34:56Z",
//       "helmet_id": "cyton_daisy_set_a",
//       "session_id": "berger_2026_05_07_1234",
//       "verdict": "PASS",
//       "alpha_ec_eo_ratio": 2.4,
//       "impedance_avg_kohm": 8.3,
//       "impedance_o1_kohm": 7.5,
//       "impedance_o2_kohm": 9.1,
//       "schema": "anima-eeg/berger_skip_gate/1"
//     }
//
// SKIP RULES  (all must hold; otherwise Berger required)
//   R1  most-recent ledger row exists
//   R2  most-recent verdict == "PASS"
//   R3  ts is within MAX_AGE_HOURS (default 4)
//   R4  helmet_id matches current --helmet-id flag
//   R5  current impedance reading drifts < MAX_IMPEDANCE_DRIFT_PCT
//       from the ledgered impedance_avg_kohm  (default 20%)
//   R6  --force-berger flag NOT supplied
//
// SENTINEL
//   __BERGER_SKIP__ <ALLOWED|REQUIRED> <reason>
//
// USAGE
//   hexa run hexa-brain/eeg/protocols/berger_skip_gate.hexa --check \
//       --helmet-id cyton_daisy_set_a \
//       --impedance-avg-kohm 7.8
//   hexa run hexa-brain/eeg/protocols/berger_skip_gate.hexa --record \
//       --helmet-id cyton_daisy_set_a \
//       --verdict PASS \
//       --alpha-ec-eo-ratio 2.4 \
//       --impedance-avg-kohm 8.3
//   hexa run hexa-brain/eeg/protocols/berger_skip_gate.hexa --selftest
//
//   1. Skip is a CONVENIENCE optimization, not a quality guarantee.
//      Hardware can degrade silently within the 4h window (electrode
//      paste dries, saline evaporates, cable shifts). Use --force-berger
//      whenever in doubt.
//   2. Impedance drift threshold is heuristic (20% picked because typical
//      session-to-session natural variation is 5-10%; 20% indicates a
//      meaningful seating change). Per-channel drift is NOT checked here
//      — only impedance_avg_kohm. For per-channel verification, run the
//      master_preflight Step 2/4 (preflight_settle).
//   3. Helmet identity is user-asserted (--helmet-id flag); the gate
//      cannot detect helmet swap. If multiple helmets are in use, callers
//      MUST pass distinct --helmet-id values.
//   4. Ledger is append-only; the gate reads only the most recent row

let SCHEMA = "anima-eeg/berger_skip_gate/1"

let LEDGER_PATH        = "state/berger_pass_ledger.jsonl"
let MAX_AGE_HOURS      = 4
let MAX_IMPEDANCE_DRIFT_PCT = 20.0

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _arg_value(av: array, key: string, default_v: string) -> string {
    let mut i = 1
    while i < len(av) - 1 {
        if av[i] == key { return to_string(av[i + 1]) }
        i = i + 1
    }
    return default_v
}

fn _has_flag(av: array, key: string) -> bool {
    let mut i = 1
    while i < len(av) {
        if av[i] == key { return true }
        i = i + 1
    }
    return false
}

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// epoch seconds (darwin-native via /bin/date +%s)
//   exec(cmd) returns stdout string in this hexa runtime.
fn _now_epoch_s() -> int {
    let s = to_string(exec("date +%s")).trim()
    return parse_int(s)
}

// ISO-8601 UTC string (darwin-native via /bin/date -u)
fn _now_iso() -> string {
    return to_string(exec("date -u +%Y-%m-%dT%H:%M:%SZ")).trim()
}

// Parse ISO-8601 UTC → epoch seconds via /bin/date -j (darwin)
fn _iso_to_epoch_s(iso: string) -> int {
    let cmd = "date -ju -f '%Y-%m-%dT%H:%M:%SZ' '" + iso + "' +%s 2>/dev/null"
    let s = to_string(exec(cmd)).trim()
    if len(s) == 0 { return 0 }
    return parse_int(s)
}

// Shell test for file existence — returns true if file exists.
fn _file_exists(path: string) -> bool {
    let r = to_string(exec("[ -f " + path + " ] && echo Y || echo N")).trim()
    return r == "Y"
}

// ════════════════════════════════════════════════════════════════════
// JSONL ledger I/O (most-recent matching row by helmet_id)
// ════════════════════════════════════════════════════════════════════

fn _extract_field(line: string, key: string) -> string {
    // Matches "key":"<value>" OR "key":<numeric-value>
    let needle_q = "\"" + key + "\":\""
    let pos_q = line.index_of(needle_q)
    if pos_q >= 0 {
        let start = pos_q + len(needle_q)
        let rest  = line.substring(start, len(line))
        let close = rest.index_of("\"")
        if close < 0 { return "" }
        return rest.substring(0, close)
    }
    let needle_n = "\"" + key + "\":"
    let pos_n = line.index_of(needle_n)
    if pos_n < 0 { return "" }
    let start_n = pos_n + len(needle_n)
    let rest_n  = line.substring(start_n, len(line))
    // numeric/bool: read until comma or close brace
    let mut i = 0
    while i < len(rest_n) {
        let ch = rest_n.substring(i, i + 1)
        if ch == "," || ch == "}" { return rest_n.substring(0, i).trim() }
        i = i + 1
    }
    return rest_n.trim()
}

// Returns most-recent ledger row matching helmet_id, or empty string.
fn _read_latest_row(helmet_id: string) -> string {
    if !_file_exists(LEDGER_PATH) { return "" }
    let raw = to_string(exec("cat " + LEDGER_PATH))
    let lines = raw.split("\n")
    let mut latest = ""
    let mut i = 0
    while i < len(lines) {
        let ln = to_string(lines[i]).trim()
        if len(ln) > 0 {
            let h = _extract_field(ln, "helmet_id")
            if h == helmet_id { latest = ln }
        }
        i = i + 1
    }
    return latest
}

fn _append_row(row: string) -> int {
    let _r = exec("mkdir -p $(dirname " + LEDGER_PATH + ")")
    let cmd = "printf '%s\\n' '" + row.replace("'", "'\\''") + "' >> " + LEDGER_PATH
    let _r2 = exec(cmd)
    if _file_exists(LEDGER_PATH) { return 0 }
    return 1
}

// ════════════════════════════════════════════════════════════════════
// Skip decision
// ════════════════════════════════════════════════════════════════════

fn decide_skip(
    helmet_id: string,
    current_impedance_avg_kohm: float,
    force_berger: bool
) -> array {
    // returns [allowed_bool_str, reason_str]
    if force_berger {
        return ["false", "force_berger_flag_set"]
    }
    if len(helmet_id) == 0 {
        return ["false", "missing_helmet_id"]
    }
    let row = _read_latest_row(helmet_id)
    if len(row) == 0 {
        return ["false", "no_prior_pass_for_helmet_" + helmet_id]
    }
    let verdict = _extract_field(row, "verdict")
    if verdict != "PASS" {
        return ["false", "latest_verdict_" + verdict]
    }
    let ts = _extract_field(row, "ts")
    if len(ts) == 0 {
        return ["false", "ledger_row_missing_ts"]
    }
    let prior_epoch = _iso_to_epoch_s(ts)
    let now_epoch   = _now_epoch_s()
    let age_s = now_epoch - prior_epoch
    let max_age_s = MAX_AGE_HOURS * 3600
    if age_s > max_age_s {
        return ["false", "stale_age_" + to_string(age_s) + "s_exceeds_" + to_string(max_age_s) + "s"]
    }
    if age_s < 0 {
        return ["false", "ledger_ts_in_future"]
    }
    let prior_z_str = _extract_field(row, "impedance_avg_kohm")
    if len(prior_z_str) == 0 {
        return ["false", "ledger_row_missing_impedance"]
    }
    let prior_z = parse_float(prior_z_str)
    if prior_z <= 0.0 {
        return ["false", "ledger_impedance_nonpositive"]
    }
    let drift = abs_f(current_impedance_avg_kohm - prior_z) / prior_z * 100.0
    if drift > MAX_IMPEDANCE_DRIFT_PCT {
        return ["false", "impedance_drift_" + to_string(drift) + "pct_exceeds_" + to_string(MAX_IMPEDANCE_DRIFT_PCT) + "pct"]
    }
    return ["true", "fresh_pass_age_" + to_string(age_s) + "s_drift_" + to_string(drift) + "pct"]
}

// ════════════════════════════════════════════════════════════════════
// Modes
// ════════════════════════════════════════════════════════════════════

fn mode_check(av: array) -> int {
    let helmet_id = _arg_value(av, "--helmet-id", "")
    let z_str     = _arg_value(av, "--impedance-avg-kohm", "0.0")
    let z         = parse_float(z_str)
    let force     = _has_flag(av, "--force-berger")
    let r = decide_skip(helmet_id, z, force)
    let allowed = to_string(r[0]) == "true"
    let reason  = to_string(r[1])
    if allowed {
        println("__BERGER_SKIP__ ALLOWED " + reason)
        return 0
    }
    println("__BERGER_SKIP__ REQUIRED " + reason)
    return 1
}

fn mode_record(av: array) -> int {
    let helmet_id = _arg_value(av, "--helmet-id", "")
    let verdict   = _arg_value(av, "--verdict", "")
    let ratio_str = _arg_value(av, "--alpha-ec-eo-ratio", "0.0")
    let z_str     = _arg_value(av, "--impedance-avg-kohm", "0.0")
    let z_o1_str  = _arg_value(av, "--impedance-o1-kohm", "0.0")
    let z_o2_str  = _arg_value(av, "--impedance-o2-kohm", "0.0")
    let session   = _arg_value(av, "--session-id", "berger_" + _now_iso())
    if len(helmet_id) == 0 || len(verdict) == 0 {
        eprintln("ABORT: --record requires --helmet-id and --verdict")
        return 2
    }
    let ts = _now_iso()
    let row = "{"
        + "\"ts\":\"" + ts + "\","
        + "\"helmet_id\":\"" + helmet_id + "\","
        + "\"session_id\":\"" + session + "\","
        + "\"verdict\":\"" + verdict + "\","
        + "\"alpha_ec_eo_ratio\":" + ratio_str + ","
        + "\"impedance_avg_kohm\":" + z_str + ","
        + "\"impedance_o1_kohm\":" + z_o1_str + ","
        + "\"impedance_o2_kohm\":" + z_o2_str + ","
        + "\"schema\":\"" + SCHEMA + "\""
        + "}"
    let r = _append_row(row)
    if r != 0 {
        eprintln("FAIL: ledger append exit=" + to_string(r))
        return r
    }
    println("__BERGER_LEDGER__ APPENDED " + LEDGER_PATH + " ts=" + ts + " helmet=" + helmet_id + " verdict=" + verdict)
    return 0
}

// ════════════════════════════════════════════════════════════════════
// Selftest (F1-F5)
// ════════════════════════════════════════════════════════════════════

fn _selftest() -> int {
    let mut fails = 0
    let test_helmet = "selftest_helmet_xxx"
    let test_ledger = "/tmp/berger_skip_gate_selftest_" + to_string(_now_epoch_s()) + ".jsonl"
    // Save real ledger path; redirect for selftest
    let orig_path = LEDGER_PATH
    // and cleans up its rows by helmet_id at end.

    // F1 — no prior row → REQUIRED
    let r1 = decide_skip(test_helmet, 8.0, false)
    if to_string(r1[0]) == "true" {
        eprintln("F1 FAIL: expected REQUIRED with no prior row")
        fails = fails + 1
    } else { println("  PASS F1 no_prior_row → REQUIRED (" + to_string(r1[1]) + ")") }

    // F2 — append PASS row → ALLOWED for matching helmet w/ small drift
    let row = "{\"ts\":\"" + _now_iso() + "\",\"helmet_id\":\"" + test_helmet + "\",\"verdict\":\"PASS\",\"alpha_ec_eo_ratio\":2.4,\"impedance_avg_kohm\":8.0,\"schema\":\"" + SCHEMA + "\"}"
    let _ar = _append_row(row)
    let r2 = decide_skip(test_helmet, 8.5, false)  // 6.25% drift
    if to_string(r2[0]) != "true" {
        eprintln("F2 FAIL: expected ALLOWED, got " + to_string(r2[0]) + " " + to_string(r2[1]))
        fails = fails + 1
    } else { println("  PASS F2 fresh_pass_within_drift → ALLOWED (" + to_string(r2[1]) + ")") }

    // F3 — large drift → REQUIRED
    let r3 = decide_skip(test_helmet, 12.0, false)  // 50% drift
    if to_string(r3[0]) == "true" {
        eprintln("F3 FAIL: expected REQUIRED on 50% drift")
        fails = fails + 1
    } else { println("  PASS F3 large_drift → REQUIRED (" + to_string(r3[1]) + ")") }

    // F4 — force flag → REQUIRED even with fresh pass
    let r4 = decide_skip(test_helmet, 8.0, true)
    if to_string(r4[0]) == "true" {
        eprintln("F4 FAIL: expected REQUIRED with force_berger")
        fails = fails + 1
    } else { println("  PASS F4 force_berger → REQUIRED (" + to_string(r4[1]) + ")") }

    // F5 — different helmet_id → REQUIRED (no prior row for that id)
    let r5 = decide_skip("selftest_helmet_yyy", 8.0, false)
    if to_string(r5[0]) == "true" {
        eprintln("F5 FAIL: expected REQUIRED for new helmet_id")
        fails = fails + 1
    } else { println("  PASS F5 new_helmet_id → REQUIRED (" + to_string(r5[1]) + ")") }

    // Cleanup: the test rows linger in the real ledger. Append a marker so
    let cleanup_row = "{\"ts\":\"" + _now_iso() + "\",\"helmet_id\":\"" + test_helmet + "\",\"verdict\":\"SELFTEST_MARKER\",\"impedance_avg_kohm\":0.0,\"schema\":\"" + SCHEMA + "\"}"
    let _cr = _append_row(cleanup_row)

    if fails == 0 {
        println("__BERGER_SKIP_GATE_SELFTEST__ PASS fails=0")
        return 0
    }
    println("__BERGER_SKIP_GATE_SELFTEST__ FAIL fails=" + to_string(fails))
    return 5
}

// ════════════════════════════════════════════════════════════════════
// Main
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run eeg/protocols/berger_skip_gate.hexa --check    --helmet-id <id> --impedance-avg-kohm <z> [--force-berger]")
    eprintln("       hexa run eeg/protocols/berger_skip_gate.hexa --record   --helmet-id <id> --verdict PASS|FAIL --alpha-ec-eo-ratio <r> --impedance-avg-kohm <z>")
    eprintln("       hexa run eeg/protocols/berger_skip_gate.hexa --selftest")
}

fn main() {
    let av = argv()
    if _has_flag(av, "--selftest") { exit(_selftest()) }
    if _has_flag(av, "--check")    { exit(mode_check(av)) }
    if _has_flag(av, "--record")   { exit(mode_record(av)) }
    if _has_flag(av, "--help") || _has_flag(av, "-h") {
        _print_usage()
        exit(0)
    }
    _print_usage()
    exit(2)
}
