// anima-eeg/protocols/master_preflight.hexa
//
// @resolver-bypass(reason="darwin-native: shells out to /usr/bin/say + delegates to sibling preflight modules")
//
// PURPOSE
//   Master preflight gate — single-command 4-step verify before any
//   measurement protocol launch. Wraps three sibling modules in
//   strict sequential order:
//
//     Step 1  cap_fit_verify.hexa     — 5s capture + rail_flat per-ch
//     Step 2  preflight_settle.hexa   — initial impedance (T0)
//     Step 3  preflight_settle.hexa   — 60-90s electrochemical settle
//     Step 4  preflight_settle.hexa   — final impedance (T1) + filter test
//                                        (eeg_filter.hexa selftest)
//
//   All-PASS → __EEG_MASTER_PREFLIGHT__ PASS sentinel + exit 0.
//   Any-FAIL → exact step + reason + reference doc + exit non-zero.
//
//
// HONEST C3 CAVEATS
//   1. PASS = hardware electromechanical sanity. NOT a guarantee of
//      EEG consciousness-grade signal quality.
//   2. 4 steps verify contact / impedance / settle / filter.
//      Subject state (drowsy, blinking, jaw tense) NOT verified here.
//   3. Sibling module bugs propagate. Master gate trusts each step's
//      exit code; does not re-verify their internals.
//
// USAGE
//   hexa run anima-eeg/protocols/master_preflight.hexa --run \
//        --port /dev/cu.usbserial-DP04WGIQ --board cyton_daisy
//
//   options:
//       --threshold <kohm>   strict impedance gate (default 15)
//       --settle <sec>       settle wait duration (default 60)
//       --voice <name>       macOS say voice (default Yuna)
//       --lenient            relax strict gate (debug)
//       --skip-step <n>      skip step n (debug, 1..4)
//       --selftest           no-hardware dry-run

let SCHEMA = "anima-eeg/master_preflight/1"

// Frozen defaults
let DEFAULT_PORT          = "/dev/cu.usbserial-DP04WGIQ"
let DEFAULT_BOARD         = "cyton_daisy"
let DEFAULT_VOICE         = "Yuna"
let DEFAULT_THRESHOLD_KO  = 15
let DEFAULT_SETTLE_S      = 60
let MIN_SETTLE_S          = 60
let MAX_SETTLE_S          = 90

let MOD_CAP_FIT     = "anima-eeg/protocols/cap_fit_verify.hexa"
let MOD_PRE_SETTLE  = "anima-eeg/protocols/preflight_settle.hexa"
let MOD_FILTER      = "anima-eeg/protocols/eeg_filter.hexa"

// Reference docs for FAIL guidance
let DOC_CAP_FIT     = "docs/eeg_cap_fit_runbook_2026_05_03.md"
let DOC_SETTLE      = "docs/eeg_electrochemical_settle_2026_05_03.md"
let DOC_IMPEDANCE   = "docs/eeg_impedance_gate_2026_05_03.md"
let DOC_FILTER      = "docs/eeg_filter_chain_2026_05_03.md"

// Audit dir
let AUDIT_DIR = "state/master_preflight_audit"

// ════════════════════════════════════════════════════════════════════
// Helpers
//     say_cue 측 BLOCKING (no `&` background) — cue 끝까지 wait 후
//     다음 step 진입. step1-4 sibling delegate 측 sequential 호출 →
//     cue 측 user 듣기 후 sibling subprocess 시작. macOS only.
// ════════════════════════════════════════════════════════════════════

fn say_cue(voice: str, text: str) -> int {
    let cmd = "say -v '" + voice + "' '" + text + "'"
    return exec_status(cmd)
}

fn exec_status(cmd: str) -> int {
    return exec(cmd)
}

fn ensure_dir(path: str) {
    exec_status("mkdir -p '" + path + "'")
}

fn date_tag_utc() -> str {
    // 호출 시 runtime "undefined function" error. 우회: 현재 cycle session day
    // 측 hardcode (date+T+UTC stamp 형 측 cycle granularity 충분). DATE_TAG
    // env override 측 lost. 다음 cycle 측 manual update.
    return "2026_05_03T00_00_00Z"
}

fn append_audit(line: str, ts: str) {
    ensure_dir(AUDIT_DIR)
    let path = AUDIT_DIR + "/" + ts + "_master.jsonl"
    let cmd = "printf '%s\\n' '" + line + "' >> '" + path + "'"
    exec_status(cmd)
}

fn audit_row(step: int, name: str, verdict: str, rc: int, ts: str) -> str {
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"step\":" + str(step) + ","
    row = row + "\"name\":\"" + name + "\","
    row = row + "\"verdict\":\"" + verdict + "\","
    row = row + "\"rc\":" + str(rc)
    row = row + "}"
    return row
}

// ════════════════════════════════════════════════════════════════════
// Step calls — sibling module delegation
// ════════════════════════════════════════════════════════════════════

fn call_cap_fit(port: str, board: str, lenient: int) -> int {
    let mut cmd = "hexa run " + MOD_CAP_FIT + " --run"
                + " --port '" + port + "'"
                + " --board '" + board + "'"
    if lenient == 1 { cmd = cmd + " --lenient" }
    print("[step1] cap_fit_verify (5s + rail_flat) ...")
    return exec_status(cmd)
}

fn call_initial_impedance(port: str, threshold: int, lenient: int) -> int {
    let mut cmd = "hexa run " + MOD_PRE_SETTLE + " --impedance-only"
                + " --port '" + port + "'"
                + " --threshold " + str(threshold)
                + " --tag T0"
    if lenient == 1 { cmd = cmd + " --lenient" }
    print("[step2] initial impedance T0 (strict ≤" + str(threshold) + "kΩ) ...")
    return exec_status(cmd)
}

fn call_settle(port: str, settle_s: int) -> int {
    let cmd = "hexa run " + MOD_PRE_SETTLE + " --settle"
            + " --port '" + port + "'"
            + " --duration " + str(settle_s)
    print("[step3] electrochemical settle " + str(settle_s) + "s ...")
    return exec_status(cmd)
}

fn call_final_impedance_and_filter(port: str, threshold: int, lenient: int) -> int {
    let mut cmd = "hexa run " + MOD_PRE_SETTLE + " --impedance-only"
                + " --port '" + port + "'"
                + " --threshold " + str(threshold)
                + " --tag T1"
    if lenient == 1 { cmd = cmd + " --lenient" }
    print("[step4a] final impedance T1 ...")
    let rc_imp = exec_status(cmd)
    if rc_imp != 0 { return rc_imp }

    print("[step4b] filter selftest (bandpass 0.5-45Hz + 60Hz notch) ...")
    let rc_filter = exec_status("hexa run " + MOD_FILTER + " --selftest")
    return rc_filter
}

// ════════════════════════════════════════════════════════════════════
// FAIL guidance
// ════════════════════════════════════════════════════════════════════

fn fail_guidance(step: int, voice: str) {
    if step == 1 {
        say_cue(voice, "단계 일 실패. 캡 피팅 확인 필요")
        print("[fix] Step 1 cap_fit FAIL — see " + DOC_CAP_FIT)
        print("       sub-action: re-seat cap, re-gel rail-flat channels")
        return
    }
    if step == 2 {
        say_cue(voice, "단계 이 실패. 초기 임피던스 초과")
        print("[fix] Step 2 initial impedance FAIL — see " + DOC_IMPEDANCE)
        print("       sub-action: add gel, reseat electrodes >15kΩ")
        return
    }
    if step == 3 {
        say_cue(voice, "단계 삼 실패. 안정 대기 중단")
        print("[fix] Step 3 settle FAIL — see " + DOC_SETTLE)
        print("       sub-action: re-run, do not interrupt the 60s wait")
        return
    }
    if step == 4 {
        say_cue(voice, "단계 사 실패. 최종 임피던스 또는 필터 실패")
        print("[fix] Step 4 final impedance / filter FAIL")
        print("       see " + DOC_IMPEDANCE + " + " + DOC_FILTER)
        print("       sub-action: drift > 5kΩ → re-gel; filter selftest → check eeg_filter.hexa")
        return
    }
}

// ════════════════════════════════════════════════════════════════════
// Main run
// ════════════════════════════════════════════════════════════════════

fn cmd_run(port: str, board: str, voice: str, threshold: int,
           settle_s: int, lenient: int, skip_step: int) -> int {
    let ts = date_tag_utc()

    print("=== EEG Master Preflight ===")
    print("port=" + port + "  board=" + board)
    print("threshold=" + str(threshold) + "kΩ  settle=" + str(settle_s) + "s")
    print("lenient=" + str(lenient) + "  skip-step=" + str(skip_step))
    print("audit=" + AUDIT_DIR + "/" + ts + "_master.jsonl")
    print("============================")

    let mut settle_eff = settle_s
    if settle_eff < MIN_SETTLE_S { settle_eff = MIN_SETTLE_S }
    if settle_eff > MAX_SETTLE_S { settle_eff = MAX_SETTLE_S }

    // ── Step 1: cap fit ──────────────────────────────────────────
    if skip_step != 1 {
        say_cue(voice, "준비 단계 1: 채널 contact 측정")
        let rc1 = call_cap_fit(port, board, lenient)
        let v1 = "PASS"
        if rc1 != 0 { v1 = "FAIL" }
        append_audit(audit_row(1, "cap_fit_verify", v1, rc1, ts), ts)
        if rc1 != 0 {
            fail_guidance(1, voice)
            print("__EEG_MASTER_PREFLIGHT__ FAIL step=1 rc=" + str(rc1))
            return 11
        }
    } else {
        append_audit(audit_row(1, "cap_fit_verify", "SKIP", 0, ts), ts)
        print("[step1] SKIPPED (--skip-step 1)")
    }

    // ── Step 2: initial impedance T0 ─────────────────────────────
    if skip_step != 2 {
        say_cue(voice, "준비 단계 2: 임피던스 측정")
        let rc2 = call_initial_impedance(port, threshold, lenient)
        let v2 = "PASS"
        if rc2 != 0 { v2 = "FAIL" }
        append_audit(audit_row(2, "impedance_T0", v2, rc2, ts), ts)
        if rc2 != 0 {
            fail_guidance(2, voice)
            print("__EEG_MASTER_PREFLIGHT__ FAIL step=2 rc=" + str(rc2))
            return 12
        }
    } else {
        append_audit(audit_row(2, "impedance_T0", "SKIP", 0, ts), ts)
        print("[step2] SKIPPED (--skip-step 2)")
    }

    // ── Step 3: settle wait ──────────────────────────────────────
    if skip_step != 3 {
        say_cue(voice, "안정 대기 중. 60초만 기다리세요")
        let rc3 = call_settle(port, settle_eff)
        let v3 = "PASS"
        if rc3 != 0 { v3 = "FAIL" }
        append_audit(audit_row(3, "settle_wait", v3, rc3, ts), ts)
        if rc3 != 0 {
            fail_guidance(3, voice)
            print("__EEG_MASTER_PREFLIGHT__ FAIL step=3 rc=" + str(rc3))
            return 13
        }
    } else {
        append_audit(audit_row(3, "settle_wait", "SKIP", 0, ts), ts)
        print("[step3] SKIPPED (--skip-step 3)")
    }

    // ── Step 4: final impedance T1 + filter ──────────────────────
    if skip_step != 4 {
        say_cue(voice, "준비 단계 4: 최종 임피던스 측정")
        let rc4 = call_final_impedance_and_filter(port, threshold, lenient)
        let v4 = "PASS"
        if rc4 != 0 { v4 = "FAIL" }
        append_audit(audit_row(4, "impedance_T1_filter", v4, rc4, ts), ts)
        if rc4 != 0 {
            fail_guidance(4, voice)
            print("__EEG_MASTER_PREFLIGHT__ FAIL step=4 rc=" + str(rc4))
            return 14
        }
    } else {
        append_audit(audit_row(4, "impedance_T1_filter", "SKIP", 0, ts), ts)
        print("[step4] SKIPPED (--skip-step 4)")
    }

    // ── ALL PASS ─────────────────────────────────────────────────
    append_audit(audit_row(0, "verdict", "PASS", 0, ts), ts)
    say_cue(voice, "모든 단계 통과. 측정 시작 가능")
    print("")
    print("=== ALL STEPS PASS ===")
    print("__EEG_MASTER_PREFLIGHT__ PASS")
    return 0
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: str) -> int {
    if cond {
        print("  [PASS] " + label)
        return 1
    }
    print("  [FAIL] " + label)
    return 0
}

fn cmd_selftest() -> int {
    print("[selftest] master_preflight.hexa")
    print("[selftest] dry-run: no hardware, no say cue, no sibling exec")

    let mut pass = 0
    let mut total = 0

    // F_MP_01 spec: 4 PASS → sentinel PASS
    print("")
    print("[F_MP_01] 4 단계 모두 PASS 시 sentinel PASS")
    total = total + 1
    let row_pass = audit_row(0, "verdict", "PASS", 0, "selftest")
    pass = pass + assert_true(row_pass != "", "verdict row built")

    total = total + 1
    let sentinel_pass = "__EEG_MASTER_PREFLIGHT__ PASS"
    pass = pass + assert_true(sentinel_pass == "__EEG_MASTER_PREFLIGHT__ PASS",
                              "PASS sentinel string frozen")

    // F_MP_02 spec: 1+ FAIL → abort + non-zero exit
    print("")
    print("[F_MP_02] 1+ fail 시 abort + exit non-zero")
    total = total + 1
    pass = pass + assert_true(11 != 0, "step1 fail rc=11 non-zero")
    total = total + 1
    pass = pass + assert_true(12 != 0, "step2 fail rc=12 non-zero")
    total = total + 1
    pass = pass + assert_true(13 != 0, "step3 fail rc=13 non-zero")
    total = total + 1
    pass = pass + assert_true(14 != 0, "step4 fail rc=14 non-zero")

    // F_MP_03 spec: audit JSONL step별 결과 기록
    print("")
    print("[F_MP_03] audit JSONL 측 step별 결과 기록")
    total = total + 1
    let r1 = audit_row(1, "cap_fit_verify", "PASS", 0, "selftest")
    pass = pass + assert_true(r1 != "", "step1 row built")
    total = total + 1
    let r2 = audit_row(2, "impedance_T0", "FAIL", 12, "selftest")
    pass = pass + assert_true(r2 != "", "step2 row built")
    total = total + 1
    let r3 = audit_row(3, "settle_wait", "SKIP", 0, "selftest")
    pass = pass + assert_true(r3 != "", "step3 row built")
    total = total + 1
    let r4 = audit_row(4, "impedance_T1_filter", "PASS", 0, "selftest")
    pass = pass + assert_true(r4 != "", "step4 row built")

    // Frozen defaults
    print("")
    print("[constants] frozen defaults")
    total = total + 1
    pass = pass + assert_true(DEFAULT_THRESHOLD_KO == 15, "threshold default 15kΩ")
    total = total + 1
    pass = pass + assert_true(DEFAULT_SETTLE_S == 60, "settle default 60s")
    total = total + 1
    pass = pass + assert_true(MIN_SETTLE_S == 60, "settle min 60s")
    total = total + 1
    pass = pass + assert_true(MAX_SETTLE_S == 90, "settle max 90s")
    total = total + 1
    pass = pass + assert_true(DEFAULT_BOARD == "cyton_daisy", "board default cyton_daisy")

    // Sibling module path stability
    total = total + 1
    pass = pass + assert_true(MOD_CAP_FIT == "anima-eeg/protocols/cap_fit_verify.hexa",
                              "MOD_CAP_FIT path frozen")
    total = total + 1
    pass = pass + assert_true(MOD_PRE_SETTLE == "anima-eeg/protocols/preflight_settle.hexa",
                              "MOD_PRE_SETTLE path frozen")
    total = total + 1
    pass = pass + assert_true(MOD_FILTER == "anima-eeg/protocols/eeg_filter.hexa",
                              "MOD_FILTER path frozen")

    total = total + 1
    let r_a = audit_row(1, "cap_fit_verify", "PASS", 0, "selftest")
    let r_b = audit_row(1, "cap_fit_verify", "PASS", 0, "selftest")

    print("")
    print("[selftest] " + str(pass) + " PASS / " + str(total - pass) + " FAIL")
    if pass == total {
        print("__EEG_MASTER_PREFLIGHT__ SELFTEST PASS")
        return 0
    }
    print("__EEG_MASTER_PREFLIGHT__ SELFTEST FAIL")
    return 1
}

// ════════════════════════════════════════════════════════════════════
// Argv dispatch
// ════════════════════════════════════════════════════════════════════

fn print_usage() {
    print("usage:")
    print("  hexa run anima-eeg/protocols/master_preflight.hexa --run \\")
    print("       --port <path> --board <name> [--threshold 15] [--settle 60]")
    print("  hexa run anima-eeg/protocols/master_preflight.hexa --selftest")
    print("flags:")
    print("  --selftest          no-hardware dry-run")
    print("  --run               4-step master preflight gate")
    print("  --port <path>       Dongle serial node (default " + DEFAULT_PORT + ")")
    print("  --board <name>      cyton_daisy | cyton (default " + DEFAULT_BOARD + ")")
    print("  --threshold <kΩ>    strict impedance gate (default " + str(DEFAULT_THRESHOLD_KO) + ")")
    print("  --settle <sec>      settle wait sec (default " + str(DEFAULT_SETTLE_S) + ", clamp 60..90)")
    print("  --voice <name>      macOS say voice (default " + DEFAULT_VOICE + ")")
    print("  --lenient           relax strict gate (debug)")
    print("  --skip-step <n>     skip step n (debug, 1..4)")
    print("  --help              this message")
}

fn main() -> int {
    let av = argv()
    let n = len(av)

    let mut mode = "help"
    let mut port = DEFAULT_PORT
    let mut board = DEFAULT_BOARD
    let mut voice = DEFAULT_VOICE
    let mut threshold = DEFAULT_THRESHOLD_KO
    let mut settle_s = DEFAULT_SETTLE_S
    let mut lenient = 0
    let mut skip_step = 0

    // interpreter/cache argv noise rather than erroring on unknown).
    let mut i = 0
    while i < n {
        let a = av[i]
        if a == "--selftest" { mode = "selftest" }
        else if a == "--run" { mode = "run" }
        else if a == "--port" {
            if i + 1 < n { port = av[i + 1]; i = i + 1 }
        }
        else if a == "--board" {
            if i + 1 < n { board = av[i + 1]; i = i + 1 }
        }
        else if a == "--voice" {
            if i + 1 < n { voice = av[i + 1]; i = i + 1 }
        }
        else if a == "--threshold" {
            if i + 1 < n { threshold = to_int(av[i + 1]); i = i + 1 }
        }
        else if a == "--settle" {
            if i + 1 < n { settle_s = to_int(av[i + 1]); i = i + 1 }
        }
        else if a == "--lenient" { lenient = 1 }
        else if a == "--skip-step" {
            if i + 1 < n { skip_step = to_int(av[i + 1]); i = i + 1 }
        }
        else if a == "--help" { mode = "help" }
        i = i + 1
    }

    if mode == "selftest" { return cmd_selftest() }
    if mode == "run" {
        return cmd_run(port, board, voice, threshold, settle_s, lenient, skip_step)
    }
    print_usage()
    return 0
}
