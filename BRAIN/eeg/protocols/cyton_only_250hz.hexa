// anima-eeg/protocols/cyton_only_250hz.hexa
//
// @resolver-bypass(reason="darwin-native: --run delegates to anima-eeg/collect.hexa subprocess (board=cyton, board_id=0) which uses .venv-eeg BrainFlow + USB-serial dongle on host; selftest is pure-hexa synthetic — unified bypass keeps route stable across darwin")
//
// PURPOSE
//   Cyton-only 8ch 250 Hz wrapper — Daisy 분리 측 effective sample rate
//   collapse 측 회피. Cyton+Daisy 16ch 측 측정 결과 effective fs 60-83 Hz
//   (Nyquist 30-41 Hz 측 EMG 50-150 Hz band 측 measure 불가능). Cyton-only
//   측 BrainFlow board_id=0 측 8ch 250 Hz 측 full bandwidth 측 보장 →
//   EMG / 빠른 transient artifact 측 robust 측정 가능.
//
//   Daisy module 측 Cyton 위 측 stack 측 물리 분리 → cap channel 측 8ch 측
//   변경 (T7/T8/F7/F8/F3/F4/P3/P4 측 lose). 재 connect 측 montage 측 재
//
// LIVE BRAINFLOW INGEST: --run delegates to anima-eeg/collect.hexa (board=cyton).
//   This protocol owns:
//     1) Daisy 분리 user hand-step instruction
//     2) cyton (board_id=0) 측 collect 호출
//     3) sample-rate guard (effective fs ≥ 200 Hz F_C8_01)
//     4) row-count guard (24 rows F_C8_02)
//     5) F_FS_01 sample_rate_guard 측 PASS verify (F_C8_03)
//     6) Daisy re-stack instruction post-session
//
//     F_C8_01: capture 후 effective fs ≥ 200 Hz (Nyquist 100 Hz 측 EMG band 측 cover)
//     F_C8_02: capture .npy rows == 24 (32 Cyton+Daisy rows minus 8 Daisy rows)
//     F_C8_03: F_FS_01 sample_rate_guard 측 PASS marker present
//
// USAGE
//   hexa run anima-eeg/protocols/cyton_only_250hz.hexa --selftest
//   hexa run anima-eeg/protocols/cyton_only_250hz.hexa --run \
//       --port <serial> --tag <paradigm> --output <npy>

let SCHEMA = "anima-eeg/cyton_only_250hz/1"

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

// Board identity (BrainFlow board_id table: 0=CYTON, 2=CYTON_DAISY)
let BOARD_NAME                  = "cyton"        // forced — Daisy 빼고
let BOARD_ID                    = 0              // BrainFlow CYTON_BOARD
let DAISY_BOARD_ID              = 2              // for contrast log
let DAISY_BOARD_NAME            = "cyton_daisy"

// Sample rate spec
let CYTON_NATIVE_FS_HZ          = 250            // Cyton-only ADS1299 native
let CYTON_DAISY_INTERLEAVED_FS  = 125            // Daisy stacked → halved
let DEFAULT_DURATION_S          = 90             // mirrors block protocols
let DEFAULT_VENV_PYTHON         = ".venv-eeg/bin/python"

let F_C8_01_FS_MIN_HZ           = 200.0          // effective fs >= 200 Hz
let F_C8_02_ROW_COUNT_EXPECTED  = 24             // 32 - 8 (Daisy 8 rows removed)
let F_C8_02_ROW_COUNT_ALT       = 32             // some BrainFlow versions keep stride
// (8 EEG + accel/timestamp/marker = 24 rows total). 일부 version 측 stride
// 32 측 그대로 하면서 Daisy rows 측 zero fill — 양쪽 accept (alt = 32).

// Cap channel mapping — Cyton-only 측 Cyton bottom N1P-N8P 측만 active
// Source: anima-eeg/protocols/cap_fit_verify.hexa frozen 16ch mapping,
//         Cyton 측 ch1-8 측 그대로.
//   ch1  Fp1   ch2  Fp2   ch3  C3   ch4  C4
//   ch5  P7    ch6  P8    ch7  O1   ch8  O2
// Daisy ch9-16 (F7 F8 F3 F4 T7 T8 P3 P4) 측 cyton-only mode 측 unavailable.

let CHAN_FP1                    = "Fp1"
let CHAN_FP2                    = "Fp2"
let CHAN_C3                     = "C3"
let CHAN_C4                     = "C4"
let CHAN_P7                     = "P7"
let CHAN_P8                     = "P8"
let CHAN_O1                     = "O1"
let CHAN_O2                     = "O2"

// Audit ledger
let AUDIT_DIR                   = "state/cyton_only_250hz_audit"

// Sentinel marker (board_health_check 측 conv compatible)
let SENTINEL_TAG                = "__EEG_C8_FS_GUARD__"

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

let g_effective_fs_hz           = 0.0
let g_row_count                 = 0
let g_fs_guard_pass_marker      = false      // F_FS_01 sample_rate_guard PASS

let g_f_c8_01_pass              = false
let g_f_c8_02_pass              = false
let g_f_c8_03_pass              = false

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _ensure_audit_dir() {
    let _rc = exec("mkdir -p " + AUDIT_DIR)
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

// ════════════════════════════════════════════════════════════════════
//   8ch (Fp1 Fp2 C3 C4 P7 P8 O1 O2) — Daisy lost (T7/T8/F7/F8/F3/F4/P3/P4 X)
//
//   eye_blink           Fp1/Fp2 측 Cyton — FULL fit
//   berger_alpha        O1/O2 측 Cyton — FULL fit
//   alpha_eyes_closed   Fp1/Fp2 + O1/O2 측 Cyton — FULL fit
//   mu_rhythm           C3/C4 측 Cyton — FULL fit
//   ssvep               O1/O2 측 Cyton — FULL fit
//   p300_visual         midline 측 Cz X (Daisy ch11=F3 측 proxy 도 X) — PARTIAL
//   jaw_clench_emg      T7/T8 측 Daisy 측 lose → frontal/temporal proxy 측
//                       Fp1/Fp2 측 partial (volume conduction);
//                       direct temporalis pickup 불가 — PARTIAL
//   ppg_heart_rate      analog ch 측 별도 — Cyton-only 측 ch independent — FULL
// ════════════════════════════════════════════════════════════════════

fn paradigm_fitness(tag: string) -> string {
    if tag == "eye_blink"          { return "FULL" }
    if tag == "berger_alpha"       { return "FULL" }
    if tag == "alpha_eyes_closed"  { return "FULL" }
    if tag == "mu_rhythm"          { return "FULL" }
    if tag == "ssvep"              { return "FULL" }
    if tag == "ppg_heart_rate"     { return "FULL" }
    if tag == "p300_visual"        { return "PARTIAL" }
    if tag == "jaw_clench_emg"     { return "PARTIAL" }
    if tag == "blink_session_audio" { return "FULL" }
    if tag == "berger_session_audio" { return "FULL" }
    return "UNKNOWN"
}

// ════════════════════════════════════════════════════════════════════
//   Daisy 분리 측 손 작업 → 재 connect 시 측 cap channel 측 변경 가능.
// ════════════════════════════════════════════════════════════════════

fn print_user_hand_step_pre() {
    println("")
    println("┌─ HAND-STEP (Daisy 분리) ────────────────────────────────────────")
    println("│ 1. OpenBCI dongle (FTDI USB) 측 unplug — power down board")
    println("│ 2. Cyton 보드 위 측 stack 된 Daisy module 측 GENTLY 위로 떼어")
    println("│    내기 (40-pin header — 핀 bend 주의)")
    println("│ 3. Daisy module 측 antistatic bag / 별도 보관")
    println("│ 4. Cyton 측 SD card / battery 측 그대로 — only Daisy lift off")
    println("│ 5. dongle 측 다시 plug — Cyton-only 8ch (board_id=0) 모드")
    println("│ 6. cap channel 측 Daisy 측 매핑 분 (T7 T8 F7 F8 F3 F4 P3 P4)")
    println("│    측 본 session 측 unavailable — 8ch Cyton 측만 active")
    println("│    (Fp1 Fp2 C3 C4 P7 P8 O1 O2)")
    println("└──────────────────────────────────────────────────────────────────")
    println("")
}

fn print_user_hand_step_post() {
    println("")
    println("┌─ HAND-STEP (Daisy 재 stack) ────────────────────────────────────")
    println("│ 1. dongle unplug (안전)")
    println("│ 2. Daisy module 측 Cyton 위 측 40-pin header 측 align — 핀 1번")
    println("│    측 mark 측 일치 측 확인 후 push down (좌우 균등)")
    println("│ 3. SRB pin Y-splitter 측 다시 외부 ganging (Daisy SRB2 ↔ Cyton")
    println("│    재 stack 측 reference path 측 확인 후 board_health_check")
    println("│    16ch 측 verify")
    println("│ 4. board_health_check 측 16ch_HEALTHY ✓ 측 확인:")
    println("│      hexa run anima-eeg/board_health_check.hexa --check \\")
    println("│        --port <serial> --board cyton_daisy --seconds 5")
    println("└──────────────────────────────────────────────────────────────────")
    println("")
}

// ════════════════════════════════════════════════════════════════════
// Sample-rate / row-count probe (post-capture .npy inspection)
//   Delegates a tiny .venv-eeg python one-liner that loads the .npy
//   produced by collect.hexa and emits two key=value lines:
//     row_count=<int>
//     effective_fs_hz=<float>
// ════════════════════════════════════════════════════════════════════

fn _write_probe_helper() -> string {
    let path = "/tmp/anima_eeg_cyton_only_probe.py"
    let py = "
import sys
import numpy as np

def out_kv(k, v):
    print(str(k) + '=' + str(v), flush=True)

def err(reason, detail):
    print('reason: ' + reason + ': ' + detail, file=sys.stderr, flush=True)

def main():
    if len(sys.argv) < 3:
        err('usage', 'cyton_only_probe.py <npy> <duration_s>')
        return 2
    npy_path = sys.argv[1]
    try:
        duration_s = float(sys.argv[2])
    except Exception:
        err('bad-duration', sys.argv[2])
        return 2
    try:
        a = np.load(npy_path, allow_pickle=False)
    except Exception as e:
        err('npy-load-fail', str(e)[:160])
        return 3
    if a.ndim != 2:
        err('bad-shape', 'expected 2D, got ' + str(a.shape))
        return 3
    rows, cols = a.shape
    out_kv('row_count', rows)
    out_kv('col_count', cols)
    if duration_s <= 0.0:
        err('bad-duration', 'duration_s <= 0')
        return 4
    eff_fs = float(cols) / duration_s
    out_kv('effective_fs_hz', '{0:.4f}'.format(eff_fs))
    return 0

if __name__ == '__main__':
    sys.exit(main())
"
    write_file(path, py)
    return path
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

fn evaluate_falsifiers() {
    // F_C8_01: effective fs >= 200 Hz
    g_f_c8_01_pass = g_effective_fs_hz >= F_C8_01_FS_MIN_HZ

    // F_C8_02: row count == 24 (or 32 alt — both BrainFlow versions accepted)
    g_f_c8_02_pass = (g_row_count == F_C8_02_ROW_COUNT_EXPECTED) || (g_row_count == F_C8_02_ROW_COUNT_ALT)

    // F_C8_03: F_FS_01 sample_rate_guard PASS marker present
    g_f_c8_03_pass = g_fs_guard_pass_marker
}

// ════════════════════════════════════════════════════════════════════
//   __EEG_C8_FS_GUARD__ <PASS|FAIL> <effective_fs> <row_count>
// ════════════════════════════════════════════════════════════════════

fn emit_sentinel() {
    let mut verdict = "PASS"
    if !(g_f_c8_01_pass && g_f_c8_02_pass && g_f_c8_03_pass) {
        verdict = "FAIL"
    }
    println(SENTINEL_TAG + " " + verdict + " " + to_string(g_effective_fs_hz) + " " + to_string(g_row_count))
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

fn emit_audit(ts: string, tag: string, port: string, output: string) {
    _ensure_audit_dir()
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"tag\":\"" + tag + "\","
    row = row + "\"port\":\"" + port + "\","
    row = row + "\"output\":\"" + output + "\","
    row = row + "\"board_name\":\"" + BOARD_NAME + "\","
    row = row + "\"board_id\":" + to_string(BOARD_ID) + ","
    row = row + "\"native_fs_hz\":" + to_string(CYTON_NATIVE_FS_HZ) + ","
    row = row + "\"effective_fs_hz\":" + to_string(g_effective_fs_hz) + ","
    row = row + "\"row_count\":" + to_string(g_row_count) + ","
    row = row + "\"fs_guard_marker\":" + _bool_str(g_fs_guard_pass_marker) + ","
    row = row + "\"f_c8_01\":" + _bool_str(g_f_c8_01_pass) + ","
    row = row + "\"f_c8_02\":" + _bool_str(g_f_c8_02_pass) + ","
    row = row + "\"f_c8_03\":" + _bool_str(g_f_c8_03_pass)
    row = row + "}"
    let nl = chr(10)
    let mut existing = ""
    let prior = read_file(path)
    if prior != "" { existing = prior }
    write_file(path, existing + row + nl)
}

// ════════════════════════════════════════════════════════════════════
// Synthetic ingest (selftest pathway) — pure-hexa fixed values
//   nominal: effective_fs = 250.0 Hz, row_count = 24, fs_guard_marker = true
// ════════════════════════════════════════════════════════════════════

let SYNTH_FS_NOMINAL_HZ      = 250.0
let SYNTH_ROW_COUNT_NOMINAL  = 24

fn ingest_synthetic(perturb_low_fs: bool, perturb_bad_rows: bool, perturb_no_marker: bool) {
    let mut fs   = SYNTH_FS_NOMINAL_HZ
    let mut rows = SYNTH_ROW_COUNT_NOMINAL
    let mut mark = true

    if perturb_low_fs    { fs   = 83.0 }      // simulates Daisy interleave collapse
    if perturb_bad_rows  { rows = 32 - 8 - 4 } // simulates wrong board mode (16 rows)
    if perturb_no_marker { mark = false }

    g_effective_fs_hz       = fs
    g_row_count             = rows
    g_fs_guard_pass_marker  = mark
}

// Real-mode probe: invoke .venv-eeg python helper on the .npy from collect.hexa.
// fail). Caller 측 외부 sample_rate_guard marker 확인 측 별도.
fn ingest_from_npy(npy_path: string, duration_s: int) {
    let helper = _write_probe_helper()
    let venv_py = DEFAULT_VENV_PYTHON
    let cmd = venv_py + " " + helper + " " + _sh_quote(npy_path) + " " + to_string(duration_s)
    eprintln("[probe] " + cmd)
    let r = exec_with_status(cmd)
    let stdout = to_string(r[0])
    let rc = to_int(r[1])
    print(stdout)
    if rc != 0 {
        eprintln("ABORT: probe rc=" + to_string(rc) + " — npy probe failed")
        g_effective_fs_hz = 0.0
        g_row_count = 0
        return
    }
    // Parse two key=value lines from stdout.
    let lines = stdout.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i]
        if ln.starts_with("row_count=") {
            g_row_count = to_int(ln.replace("row_count=", ""))
        }
        if ln.starts_with("effective_fs_hz=") {
            g_effective_fs_hz = to_float(ln.replace("effective_fs_hz=", ""))
        }
        i = i + 1
    }
}

//   Convention: state/markers/sample_rate_guard_<ts>.marker
fn check_fs_guard_marker() -> bool {
    let listing = exec("ls -1 state/markers/sample_rate_guard_*.marker 2>/dev/null | head -1")
    let s = listing.trim()
    if len(s) > 0 { return true }
    return false
}

// ════════════════════════════════════════════════════════════════════
// Run-plan printer (--run mode)
// ════════════════════════════════════════════════════════════════════

fn print_run_plan(port: string, tag: string, output: string, duration_s: int) {
    println("── cyton_only_250hz live run plan ──")
    println("schema=" + SCHEMA)
    println("port=" + port)
    println("tag=" + tag)
    println("output=" + output)
    println("board_name=" + BOARD_NAME + " (id=" + to_string(BOARD_ID) + ")")
    println("native_fs_hz=" + to_string(CYTON_NATIVE_FS_HZ))
    println("duration_s=" + to_string(duration_s))
    println("paradigm_fitness=" + paradigm_fitness(tag))
    println("")
    println("[Cyton-only 8ch cap mapping (frozen)]")
    println("  ch1 " + CHAN_FP1 + "  ch2 " + CHAN_FP2 + "  ch3 " + CHAN_C3 + "  ch4 " + CHAN_C4)
    println("  ch5 " + CHAN_P7  + "  ch6 " + CHAN_P8  + "  ch7 " + CHAN_O1 + "  ch8 " + CHAN_O2)
    println("  Daisy ch9-16 (F7 F8 F3 F4 T7 T8 P3 P4) → unavailable in cyton mode")
    println("")
    println("[delegate command — run in separate terminal AFTER Daisy 분리]")
    println("  hexa run anima-eeg/collect.hexa --port " + port + " \\")
    println("      --board " + BOARD_NAME + " --duration " + to_string(duration_s) + " \\")
    println("      --output " + output)
    println("")
    println("[honest C3 caveats]")
}

// ════════════════════════════════════════════════════════════════════
// Tests (selftest)
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn run_tests() -> int {
    let mut pass = 0
    let mut fail = 0

    println("=== cyton_only_250hz selftest ===")

    // T1: board identity frozen
    println("[T1] board identity (cyton, board_id=0)")
    let ok1a = assert_true(BOARD_NAME == "cyton", "BOARD_NAME == cyton")
    let ok1b = assert_true(BOARD_ID == 0, "BOARD_ID == 0 (CYTON_BOARD)")
    let ok1c = assert_true(DAISY_BOARD_ID == 2, "DAISY_BOARD_ID == 2 (CYTON_DAISY_BOARD)")
    let ok1d = assert_true(CYTON_NATIVE_FS_HZ == 250, "native fs == 250 Hz")
    if ok1a && ok1b && ok1c && ok1d { pass = pass + 1 } else { fail = fail + 1 }

    // T2: synthetic nominal — all 3 falsifiers PASS
    println("[T2] synthetic nominal — F_C8_01/02/03 PASS")
    ingest_synthetic(false, false, false)
    evaluate_falsifiers()
    let ok2a = assert_true(g_f_c8_01_pass, "F_C8_01 fs >= 200 Hz")
    let ok2b = assert_true(g_f_c8_02_pass, "F_C8_02 row_count == 24")
    let ok2c = assert_true(g_f_c8_03_pass, "F_C8_03 fs_guard marker present")
    let ok2d = assert_true(g_effective_fs_hz == 250.0, "effective fs == 250.0")
    let ok2e = assert_true(g_row_count == 24, "row_count == 24")
    if ok2a && ok2b && ok2c && ok2d && ok2e { pass = pass + 1 } else { fail = fail + 1 }

    // T3: F_C8_01 falsifier — Daisy interleave collapse simulation
    println("[T3] F_C8_01 falsifier — fs = 83 Hz (Daisy interleave collapse)")
    ingest_synthetic(true, false, false)
    evaluate_falsifiers()
    let ok3a = assert_true(!g_f_c8_01_pass, "F_C8_01 fails (fs < 200)")
    let ok3b = assert_true(g_f_c8_02_pass, "F_C8_02 still passes (rows OK)")
    let ok3c = assert_true(g_f_c8_03_pass, "F_C8_03 still passes (marker OK)")
    if ok3a && ok3b && ok3c { pass = pass + 1 } else { fail = fail + 1 }

    // T4: F_C8_02 falsifier — wrong row count (16, not 24 nor 32)
    println("[T4] F_C8_02 falsifier — row_count = 20 (wrong board mode)")
    ingest_synthetic(false, true, false)
    evaluate_falsifiers()
    let ok4a = assert_true(g_f_c8_01_pass, "F_C8_01 still passes")
    let ok4b = assert_true(!g_f_c8_02_pass, "F_C8_02 fails (rows != 24/32)")
    let ok4c = assert_true(g_f_c8_03_pass, "F_C8_03 still passes")
    if ok4a && ok4b && ok4c { pass = pass + 1 } else { fail = fail + 1 }

    // T5: F_C8_03 falsifier — fs_guard marker absent
    println("[T5] F_C8_03 falsifier — fs_guard marker absent")
    ingest_synthetic(false, false, true)
    evaluate_falsifiers()
    let ok5a = assert_true(g_f_c8_01_pass, "F_C8_01 still passes")
    let ok5b = assert_true(g_f_c8_02_pass, "F_C8_02 still passes")
    let ok5c = assert_true(!g_f_c8_03_pass, "F_C8_03 fails (no marker)")
    if ok5a && ok5b && ok5c { pass = pass + 1 } else { fail = fail + 1 }

    println("[T6] idempotent synthetic ingest")
    ingest_synthetic(false, false, false)
    let fs1   = g_effective_fs_hz
    let rows1 = g_row_count
    ingest_synthetic(false, false, false)
    let ok6a = assert_true(g_effective_fs_hz == fs1, "fs idempotent")
    let ok6b = assert_true(g_row_count == rows1, "rows idempotent")
    if ok6a && ok6b { pass = pass + 1 } else { fail = fail + 1 }

    // T7: alt row count (32) — accept both 24 and 32
    println("[T7] alt row_count == 32 accepted (BrainFlow stride variant)")
    g_effective_fs_hz = 250.0
    g_row_count = 32
    g_fs_guard_pass_marker = true
    evaluate_falsifiers()
    let ok7a = assert_true(g_f_c8_02_pass, "F_C8_02 passes for rows == 32")
    if ok7a { pass = pass + 1 } else { fail = fail + 1 }

    // T8: paradigm fitness mapping
    println("[T8] paradigm fitness")
    let ok8a = assert_true(paradigm_fitness("eye_blink") == "FULL", "eye_blink = FULL")
    let ok8b = assert_true(paradigm_fitness("berger_alpha") == "FULL", "berger_alpha = FULL")
    let ok8c = assert_true(paradigm_fitness("alpha_eyes_closed") == "FULL", "alpha_eyes_closed = FULL")
    let ok8d = assert_true(paradigm_fitness("mu_rhythm") == "FULL", "mu_rhythm = FULL")
    let ok8e = assert_true(paradigm_fitness("jaw_clench_emg") == "PARTIAL", "jaw_clench_emg = PARTIAL (T7/T8 측 Daisy 측 lose)")
    let ok8f = assert_true(paradigm_fitness("p300_visual") == "PARTIAL", "p300_visual = PARTIAL")
    let ok8g = assert_true(paradigm_fitness("foo_unknown") == "UNKNOWN", "unknown = UNKNOWN")
    if ok8a && ok8b && ok8c && ok8d && ok8e && ok8f && ok8g { pass = pass + 1 } else { fail = fail + 1 }

    // T9: cap channel mapping frozen (Cyton bottom N1P-N8P)
    println("[T9] cap channel mapping (cyton 8ch)")
    let ok9a = assert_true(CHAN_FP1 == "Fp1", "ch1 = Fp1")
    let ok9b = assert_true(CHAN_FP2 == "Fp2", "ch2 = Fp2")
    let ok9c = assert_true(CHAN_C3 == "C3", "ch3 = C3")
    let ok9d = assert_true(CHAN_C4 == "C4", "ch4 = C4")
    let ok9e = assert_true(CHAN_P7 == "P7", "ch5 = P7")
    let ok9f = assert_true(CHAN_P8 == "P8", "ch6 = P8")
    let ok9g = assert_true(CHAN_O1 == "O1", "ch7 = O1")
    let ok9h = assert_true(CHAN_O2 == "O2", "ch8 = O2")
    if ok9a && ok9b && ok9c && ok9d && ok9e && ok9f && ok9g && ok9h { pass = pass + 1 } else { fail = fail + 1 }

    println("[T10] audit JSONL emit deterministic")
    ingest_synthetic(false, false, false)
    evaluate_falsifiers()
    let ts = "selftest_synth"
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    write_file(path, "")
    emit_audit(ts, "eye_blink", "synthetic", "synthetic.npy")
    let body1 = read_file(path)
    write_file(path, "")
    emit_audit(ts, "eye_blink", "synthetic", "synthetic.npy")
    let body2 = read_file(path)
    let ok10a = assert_true(body1 == body2, "audit row byte-stable")
    let ok10b = assert_true(len(body1) > 0, "audit row non-empty")
    if ok10a && ok10b { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// CLI entry
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    println("usage:")
    println("  hexa run anima-eeg/protocols/cyton_only_250hz.hexa --selftest")
    println("  hexa run anima-eeg/protocols/cyton_only_250hz.hexa --run \\")
    println("      --port <serial> --tag <paradigm> --output <npy> [--duration <s>]")
    println("  paradigm tags: eye_blink berger_alpha alpha_eyes_closed mu_rhythm")
    println("                 ssvep ppg_heart_rate p300_visual jaw_clench_emg")
}

fn _arg_value(av: list, key: string, dflt: string) -> string {
    let mut i = 1
    while i < len(av) {
        if av[i] == key && i + 1 < len(av) {
            return av[i + 1]
        }
        i = i + 1
    }
    return dflt
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut run = false
    let mut i = 1
    while i < len(av) {
        if av[i] == "--selftest" { selftest = true }
        if av[i] == "--run"      { run = true }
        if av[i] == "--help"     { _print_usage(); exit(0) }
        i = i + 1
    }

    if run {
        let port     = _arg_value(av, "--port",     "")
        let tag      = _arg_value(av, "--tag",      "")
        let output   = _arg_value(av, "--output",   "")
        let dur_str  = _arg_value(av, "--duration", to_string(DEFAULT_DURATION_S))
        let duration = to_int(dur_str)
        if len(port) == 0 || len(tag) == 0 || len(output) == 0 {
            _print_usage()
            exit(2)
        }
        print_user_hand_step_pre()
        print_run_plan(port, tag, output, duration)
        // user runs the printed delegate command in a separate terminal AFTER
        // the Daisy 분리 hand-step. After capture, re-run with --probe <npy>
        // (future cycle) for falsifier evaluation. Current cycle prints plan.
        print_user_hand_step_post()
        exit(0)
    }

    if !selftest {
        _print_usage()
        exit(2)
    }

    println("── cyton_only_250hz selftest ──")
    println("schema=" + SCHEMA)
    println("raw10_honest=daisy_unstack_user_hand_step_synthetic_ingest_only")
    println("raw10_board_swap=cyton_id0_8ch_250hz_vs_cyton_daisy_id2_16ch_125hz")
    println("raw82_darwin=collect_hexa_subprocess_brainflow_via_venv_eeg")
    println("paradigm_routing=cyton_only_8ch_fp1_fp2_c3_c4_p7_p8_o1_o2")
    println("")

    // Demonstration (synthetic nominal)
    ingest_synthetic(false, false, false)
    evaluate_falsifiers()

    println("[demo nominal session]")
    println("board_name="          + BOARD_NAME + " (id=" + to_string(BOARD_ID) + ")")
    println("native_fs_hz="        + to_string(CYTON_NATIVE_FS_HZ))
    println("effective_fs_hz="     + to_string(g_effective_fs_hz))
    println("row_count="           + to_string(g_row_count))
    println("fs_guard_marker="     + _bool_str(g_fs_guard_pass_marker))
    println("f_c8_01="             + _bool_str(g_f_c8_01_pass))
    println("f_c8_02="             + _bool_str(g_f_c8_02_pass))
    println("f_c8_03="             + _bool_str(g_f_c8_03_pass))
    println("paradigm_fitness_eye_blink=" + paradigm_fitness("eye_blink"))
    println("paradigm_fitness_jaw_clench_emg=" + paradigm_fitness("jaw_clench_emg"))
    println("")

    emit_sentinel()
    emit_audit("selftest_synth", "eye_blink", "synthetic", "synthetic.npy")

    let fails = run_tests()
    if fails != 0 {
        println("selftest=fail")
        eprintln("selftest FAILED: " + to_string(fails) + " test(s) failed")
        exit(1)
    }
    println("selftest=ok")
    println("DONE")
}
