// BRAIN/eeg/state/brain_m1_synthetic_16ch_2026_05_25/run_m1.hexa
//
// M1 — synthetic 16-channel EEG → 4-region collapse → exact IIT 4.0 big-Φ.
//
//   PURPOSE
//     M0 doc (`BRAIN/eeg/ARCHITECTURE.md`) §2 + §4: validate region-collapse
//     strategy on 3 synthetic 16-ch configurations and confirm the expected
//     big-Φ ordering: fully-coupled > region-coupled > fully-independent.
//
//   PIPELINE
//     synth 16 ch × n_samp  (deterministic — no rng)
//       → 4-ch / region averaging → 4-region flat array [reg*n_samp + t]
//       → BRAIN/eeg/eeg_to_tpm.hexa adapter (binarize + estimate TPM)
//       → stdlib/consciousness/iit4_bigphi.big_phi (n=4 exact · tractable)
//
//   WHY n=4 (NOT n=8) — honest scope
//     The IIT4 engine (M9 tractability) is exact up to n=8 but n=8 exact is
//     impractical for inline runs (HEXAD/IIT4/state/iit4_m12_bounded_largen
//     reports n=6 exact already minutes). M1 uses 4-region (frontal/central/
//     parietal/occipital) which is the §4 "alternative" mapping but exact +
//     fast (n=4 → 16 states · sub-second). The 8-region mapping is M3+ via
//     stdlib big_phi_bounded (lower-bound approx). See README §4 for full C3.
//
//   3 CONFIGS (the SAME 4-region collapse applied; what differs = synth source)
//     A. fully-coupled       — global phase drives ALL 16 ch
//     B. region-coupled      — within-region (4 group) coupling, region-INDEP
//     C. fully-independent   — each of 16 ch holds itself, no cross-coupling
//
//   EXPECTED  Φ(A) ≥ Φ(B) ≥ Φ(C)  — integration > region-clustered > reducible.
//   If not: NEW finding (documented in README §3).
//
//   deterministic · hexa-only · $0 · LLM none.
// ════════════════════════════════════════════════════════════════════════════
import "../../eeg_to_tpm.hexa"
import "stdlib/io.hexa"


// ── synth: fully-coupled 16ch (global swap — all ch driven by a single phase) ─
// Channel ch alternates phase = (t + ch) % 2 — a single global oscillator drives
// all 16 channels with per-channel offset, integration across regions.
fn synth_fully_coupled(n_ch: int, n_samp: int) -> array {
    let mut s = []
    let mut ch = 0
    while ch < n_ch {
        let mut t = 0
        while t < n_samp {
            let phase = (t + ch) % 2
            s = s.push(to_float(phase))
            t = t + 1
        }
        ch = ch + 1
    }
    return s
}


// ── synth: region-coupled (4 region × 4ch; intra-region coupled, inter-region independent) ─
// region r owns ch (4r..4r+3). All 4 ch in a region share period (r+2);
// distinct period per region eliminates cross-region phase alignment.
fn synth_region_coupled(n_ch: int, n_samp: int) -> array {
    let mut s = []
    let mut ch = 0
    while ch < n_ch {
        let region = ch / 4
        let intra = ch % 4
        let period = region + 2                              // distinct per region (2..5)
        let mut t = 0
        while t < n_samp {
            let cycle = (t + intra) % period                 // intra-region offset, same period
            let on = if cycle < period / 2 { 1 } else { 0 }
            s = s.push(to_float(on))
            t = t + 1
        }
        ch = ch + 1
    }
    return s
}


// ── synth: fully-independent (each ch self-periodic with distinct period, no cross-info) ─
fn synth_fully_independent(n_ch: int, n_samp: int) -> array {
    let mut s = []
    let mut ch = 0
    while ch < n_ch {
        let period = ch + 2                                  // distinct period per channel (2..17)
        let mut t = 0
        while t < n_samp {
            let cycle = t % period
            let on = if cycle < period / 2 { 1 } else { 0 }
            s = s.push(to_float(on))
            t = t + 1
        }
        ch = ch + 1
    }
    return s
}


// ── region-collapse: 16ch → 4 region via 4-ch averaging (ARCHITECTURE.md §4 4-region alt). ─
// in : flat [ch * n_samp + t], n_ch=16
// out: flat [reg * n_samp + t], n_region=4 (region r = mean of ch 4r..4r+3)
//   R0 frontal  = ch 0..3
//   R1 central  = ch 4..7
//   R2 parietal = ch 8..11
//   R3 occip    = ch 12..15
fn collapse_16_to_4(samples: array, n_samp: int) -> array {
    let n_region = 4
    let mut out = []
    let mut r = 0
    while r < n_region {
        let mut t = 0
        while t < n_samp {
            let mut sum = 0.0
            let mut k = 0
            while k < 4 {
                sum = sum + samples[(4 * r + k) * n_samp + t]
                k = k + 1
            }
            out = out.push(sum / 4.0)
            t = t + 1
        }
        r = r + 1
    }
    return out
}


// ── pretty-print a big_phi result row ──
fn fmt_phi_row(name: string, phi: array) -> string {
    return "  [" + name + "] big-Φ=" + str(phi[0])
        + "  total=" + str(phi[1])
        + "  Σφ_d=" + str(phi[2])
        + "  Σφ_r=" + str(phi[3])
        + "  n_dist=" + str(phi[4])
}


fn main() {
    println("================================================================")
    println("  BRAIN/M1 — synthetic 16ch EEG → 4-region collapse → IIT4 big-Φ")
    println("================================================================")
    let n_ch_raw = 16
    let n_samp = 64
    let n_region = 4
    let sys_state = 1                                       // probe state "0001" (one region ON)

    // 3 configs × {synth → collapse 4 → big_phi}.
    let raw_a = synth_fully_coupled(n_ch_raw, n_samp)
    let raw_b = synth_region_coupled(n_ch_raw, n_samp)
    let raw_c = synth_fully_independent(n_ch_raw, n_samp)

    let reg_a = collapse_16_to_4(raw_a, n_samp)
    let reg_b = collapse_16_to_4(raw_b, n_samp)
    let reg_c = collapse_16_to_4(raw_c, n_samp)

    let phi_a = eeg_big_phi(reg_a, n_region, n_samp, sys_state)
    let phi_b = eeg_big_phi(reg_b, n_region, n_samp, sys_state)
    let phi_c = eeg_big_phi(reg_c, n_region, n_samp, sys_state)

    println(fmt_phi_row("A fully-coupled    ", phi_a))
    println(fmt_phi_row("B region-coupled   ", phi_b))
    println(fmt_phi_row("C fully-independent", phi_c))

    // Expected ordering: A ≥ B ≥ C (within finite-sample noise).
    let ord_ab = phi_a[0] >= phi_b[0] - 0.000001
    let ord_bc = phi_b[0] >= phi_c[0] - 0.000001
    let ord_ac = phi_a[0] >= phi_c[0] - 0.000001

    println("----------------------------------------------------------------")
    println("  ordering check  A≥B: " + str(ord_ab) + "  B≥C: " + str(ord_bc) + "  A≥C: " + str(ord_ac))

    // determinism re-run.
    let phi_a2 = eeg_big_phi(reg_a, n_region, n_samp, sys_state)
    let det = (phi_a[0] - phi_a2[0]) < 0.0000001 && (phi_a2[0] - phi_a[0]) < 0.0000001
    println("  determinism (A re-run identical): " + str(det))

    // Write JSON result for ledger.
    let mut json = "{\n"
    json = json + "  \"slug\": \"brain_m1_synthetic_16ch_2026_05_25\",\n"
    json = json + "  \"n_ch_raw\": 16,\n"
    json = json + "  \"n_region\": 4,\n"
    json = json + "  \"n_samp\": 64,\n"
    json = json + "  \"sys_state\": 1,\n"
    json = json + "  \"engine\": \"stdlib/consciousness/iit4_bigphi.big_phi (exact)\",\n"
    json = json + "  \"adapter\": \"BRAIN/eeg/eeg_to_tpm.hexa (PR #547)\",\n"
    json = json + "  \"configs\": [\n"
    json = json + "    {\"name\": \"A_fully_coupled\",     \"big_phi\": " + str(phi_a[0]) + ", \"total\": " + str(phi_a[1]) + ", \"sum_phi_d\": " + str(phi_a[2]) + ", \"sum_phi_r\": " + str(phi_a[3]) + ", \"n_dist\": " + str(phi_a[4]) + "},\n"
    json = json + "    {\"name\": \"B_region_coupled\",    \"big_phi\": " + str(phi_b[0]) + ", \"total\": " + str(phi_b[1]) + ", \"sum_phi_d\": " + str(phi_b[2]) + ", \"sum_phi_r\": " + str(phi_b[3]) + ", \"n_dist\": " + str(phi_b[4]) + "},\n"
    json = json + "    {\"name\": \"C_fully_independent\", \"big_phi\": " + str(phi_c[0]) + ", \"total\": " + str(phi_c[1]) + ", \"sum_phi_d\": " + str(phi_c[2]) + ", \"sum_phi_r\": " + str(phi_c[3]) + ", \"n_dist\": " + str(phi_c[4]) + "}\n"
    json = json + "  ],\n"
    json = json + "  \"ordering_A_ge_B\": " + str(ord_ab) + ",\n"
    json = json + "  \"ordering_B_ge_C\": " + str(ord_bc) + ",\n"
    json = json + "  \"ordering_A_ge_C\": " + str(ord_ac) + ",\n"
    json = json + "  \"determinism\": " + str(det) + "\n"
    json = json + "}\n"
    write_text("BRAIN/eeg/state/brain_m1_synthetic_16ch_2026_05_25/result.json", json)
    println("================================================================")
    println("  RESULT written → BRAIN/eeg/state/brain_m1_synthetic_16ch_2026_05_25/result.json")
    println("================================================================")
}
