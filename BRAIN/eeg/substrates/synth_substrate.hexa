// hexa-brain/eeg/substrates/synth_substrate.hexa
//
// PURPOSE
//   First-class deterministic substrate backend — generates 16-ch float32
//   EEG-shaped samples from a Numerical-Recipes LCG (seed=1, byte-identical
//   to eeg/closed_loop.hexa:72-74 constants A/C/M). Zero BrainFlow import,
//   zero numpy-randomness, runs on any python3.
//
//   This file implements the substrate contract from substrate.hexa:
//     api_open_session(spec)  / api_close_session(s)
//     api_start_recording(s,name,fmt,max_min) / api_stop_recording(rec)
//     api_read_chunk(s, n_max)
//     api_get_eeg_indices(s) / api_get_sample_rate(s)
//     api_stim(s, stim_spec)        → NotImplementedError (read-only)
//                                     (signature widened 2026-05-12 — see
//                                     substrate.hexa APPENDIX A)
//     api_reinit(s) / api_on_shutdown_hook(s,fn) / api_last_error(s)
//
//   1. Synth EEG is **not biologically meaningful** — it's a fixed-seed LCG
//      mapped to [-50µV, +50µV) per sample. No alpha/beta/gamma structure,
//      no inter-channel correlation, no eye-blink/movement artifacts.
//   2. Output shape is 16 rows (EEG channels only). NO timestamp row, NO
//      aux rows. BrainFlow data_rows=32 (timestamp+16 eeg+aux) ≠ synth
//      data_rows=16. Downstream code that reads via eeg_indices is safe;
//      code that assumes 32-row layout will need updating (deferred to
//      the collect/eeg_recorder refactor PR).
//   3. Sample rate fixed at 125 Hz (Cyton+Daisy mode). Other rates are
//      not yet supported.
//
// FALSIFIER F_SUB_01
//   16×N float32 deterministic: two runs of api_read_chunk with the
//   same seed produce byte-identical bytes.
//
// USAGE
//   hexa run eeg/substrates/synth_substrate.hexa --selftest

let SCHEMA              = "hexa-brain/eeg/synth_substrate/1"
let HELPER_PATH         = "/tmp/hexa_brain_synth_substrate_helper.py"

let EXPECTED_CHANNEL_COUNT = 16   // matches collect.hexa / eeg_recorder.hexa
let SYNTH_SAMPLE_RATE      = 125  // Hz (Daisy mode)
let SYNTH_SEED             = 1    // matches closed_loop.hexa:_lcg_seed(1)

// LCG constants — byte-identical mirror of closed_loop.hexa:72-74
let LCG_A = 1664525
let LCG_C = 1013904223
let LCG_M = 4294967296

// ════════════════════════════════════════════════════════════════════
// Section 0. Hexa-side helpers
// ════════════════════════════════════════════════════════════════════

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _emit_trailer(slug: string, detail: string, fix: string) {
    eprintln("reason: " + slug + ": " + detail)
    eprintln("fix: " + fix)
}

// ════════════════════════════════════════════════════════════════════
// Section 1. Python helper emitter
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# hexa-brain synth_substrate helper — emitted by\n")
    parts.push("import argparse, sys, time, struct\n\n")

    parts.push("SCHEMA = '" + SCHEMA + "'\n")
    parts.push("EXPECTED_CHANNEL_COUNT = " + to_string(EXPECTED_CHANNEL_COUNT) + "\n")
    parts.push("SYNTH_SAMPLE_RATE      = " + to_string(SYNTH_SAMPLE_RATE) + "\n")
    parts.push("SYNTH_SEED             = " + to_string(SYNTH_SEED) + "\n")
    parts.push("LCG_A = " + to_string(LCG_A) + "\n")
    parts.push("LCG_C = " + to_string(LCG_C) + "\n")
    parts.push("LCG_M = " + to_string(LCG_M) + "\n\n")

    parts.push("STATE_PREINIT = 'PREINIT'\n")
    parts.push("STATE_INIT    = 'INIT'\n")
    parts.push("STATE_RUNNING = 'RUNNING'\n")
    parts.push("STATE_HALTED  = 'HALTED'\n\n")

    // ─── deterministic LCG (byte-identical to closed_loop.hexa) ────────
    parts.push("def lcg_next(state):\n")
    parts.push("    # Numerical Recipes constants — deterministic.\n")
    parts.push("    return (LCG_A * state + LCG_C) % LCG_M\n\n")

    parts.push("def lcg_float(state):\n")
    parts.push("    # Returns (next_state, float in [0.0, 1.0)).\n")
    parts.push("    s = lcg_next(state)\n")
    parts.push("    return s, s / float(LCG_M)\n\n")

    // ─── Session / Recording ───────────────────────────────────────────
    parts.push("class SynthSession:\n")
    parts.push("    def __init__(self, spec):\n")
    parts.push("        self.spec = dict(spec)\n")
    parts.push("        self.state = STATE_PREINIT\n")
    parts.push("        self.has_halted = False\n")
    parts.push("        self.shutdown_bound = False\n")
    parts.push("        self.shutdown_fired_count = 0\n")
    parts.push("        self.lcg_state = SYNTH_SEED\n")
    parts.push("        self.samples_emitted = 0\n")
    parts.push("        self.opened_at = time.time()\n")
    parts.push("        self.recording = None\n")
    parts.push("        self.last_err = {'code':'', 'advisory_url':'', 'retry_action':''}\n")
    parts.push("        cs = self.spec.get('channel_set') or {}\n")
    parts.push("        self.sample_rate = int(cs.get('sample_rate') or SYNTH_SAMPLE_RATE)\n")
    parts.push("        self.eeg_indices = list(cs.get('ids') or list(range(1, EXPECTED_CHANNEL_COUNT + 1)))\n\n")

    parts.push("    def to_dict(self):\n")
    parts.push("        return {'state':self.state, 'has_halted':self.has_halted,\n")
    parts.push("                'samples_emitted':self.samples_emitted,\n")
    parts.push("                'sample_rate':self.sample_rate,\n")
    parts.push("                'eeg_indices':list(self.eeg_indices)}\n\n")

    parts.push("class SynthRecording:\n")
    parts.push("    def __init__(self, sess, name, fmt, max_min):\n")
    parts.push("        self.session = sess\n")
    parts.push("        self.name = str(name)\n")
    parts.push("        self.fmt = str(fmt)\n")
    parts.push("        self.max_min = int(max_min)\n")
    parts.push("        self.is_open = True\n")
    parts.push("        self.opened_at = time.time()\n\n")

    // ─── api_open_session ─────────────────────────────────────────────
    parts.push("def api_open_session(spec):\n")
    parts.push("    sess = SynthSession(spec)\n")
    parts.push("    sess.state = STATE_INIT\n")
    parts.push("    sys.stderr.write(f'[output] synth_substrate.open backend=synth '\n")
    parts.push("                     f'rate={sess.sample_rate}Hz '\n")
    parts.push("                     f'ch={len(sess.eeg_indices)}\\n')\n")
    parts.push("    return sess\n\n")

    // ─── api_close_session (idempotent) ───────────────────────────────
    parts.push("def api_close_session(sess):\n")
    parts.push("    if sess is None: return\n")
    parts.push("    if sess.has_halted:\n")
    parts.push("        sys.stderr.write('[output] synth_substrate.close already halted\\n')\n")
    parts.push("        return\n")
    parts.push("    sess.state = STATE_HALTED\n")
    parts.push("    sess.has_halted = True\n")
    parts.push("    sys.stderr.write('[output] synth_substrate.close state=HALTED\\n')\n\n")

    // ─── api_reinit (atomic close + open, mirrors _session_manager) ───
    parts.push("def api_reinit(sess):\n")
    parts.push("    if sess is None: return None\n")
    parts.push("    api_close_session(sess)\n")
    parts.push("    # on the *original* receiver but RETURN a fresh session\n")
    parts.push("    # (caller MUST adopt new_sess).\n")
    parts.push("    sess.has_halted = False\n")
    parts.push("    return api_open_session(sess.spec)\n\n")

    // ─── api_start_recording / api_stop_recording ─────────────────────
    parts.push("def api_start_recording(sess, name='default', fmt='NPY', max_min=-1):\n")
    parts.push("    if sess is None or sess.has_halted:\n")
    parts.push("        sys.stderr.write('[error] synth_substrate.start: halted/null\\n')\n")
    parts.push("        return None\n")
    parts.push("    rec = SynthRecording(sess, name, fmt, max_min)\n")
    parts.push("    sess.recording = rec\n")
    parts.push("    sess.state = STATE_RUNNING\n")
    parts.push("    return rec\n\n")

    parts.push("def api_stop_recording(rec):\n")
    parts.push("    if rec is None or not rec.is_open: return\n")
    parts.push("    rec.is_open = False\n")
    parts.push("    s = rec.session\n")
    parts.push("    if s is not None and s.state == STATE_RUNNING:\n")
    parts.push("        s.state = STATE_INIT\n\n")

    // ─── api_read_chunk (deterministic LCG, 16 × n float32) ───────────
    parts.push("def api_read_chunk(sess, n_samples_max):\n")
    parts.push("    # Returns (data, ts) where data is a list-of-lists shaped\n")
    parts.push("    # (16 channels, n samples) of float32-castable floats. Caller\n")
    parts.push("    # can wrap with np.asarray(data, dtype='float32') if needed.\n")
    parts.push("    # works without .venv-eeg.\n")
    parts.push("    if sess is None or sess.has_halted:\n")
    parts.push("        return [], time.time()\n")
    parts.push("    n_ch = len(sess.eeg_indices)\n")
    parts.push("    n = max(0, int(n_samples_max))\n")
    parts.push("    out = [[0.0] * n for _ in range(n_ch)]\n")
    parts.push("    st = sess.lcg_state\n")
    parts.push("    # Inline LCG loop — deterministic.\n")
    parts.push("    for j in range(n):\n")
    parts.push("        for c in range(n_ch):\n")
    parts.push("            st = (LCG_A * st + LCG_C) % LCG_M\n")
    parts.push("            # Map u32 → [-50.0, +50.0) µV-equivalent (centered)\n")
    parts.push("            u = st / float(LCG_M)\n")
    parts.push("            out[c][j] = (u - 0.5) * 100.0\n")
    parts.push("    sess.lcg_state = st\n")
    parts.push("    sess.samples_emitted += n\n")
    parts.push("    # Synthetic timestamp: deterministic sample-count / sample_rate\n")
    parts.push("    ts = float(sess.samples_emitted) / float(sess.sample_rate)\n")
    parts.push("    return out, ts\n\n")

    // ─── api_get_eeg_indices / api_get_sample_rate ────────────────────
    parts.push("def api_get_eeg_indices(sess):\n")
    parts.push("    if sess is None: return []\n")
    parts.push("    return list(sess.eeg_indices)\n\n")

    parts.push("def api_get_sample_rate(sess):\n")
    parts.push("    if sess is None: return 0\n")
    parts.push("    return int(sess.sample_rate)\n\n")

    // ─── api_stim ─────────────────────────────────────────────────────
    parts.push("def api_stim(sess, stim_spec):\n")
    parts.push("    raise NotImplementedError(\n")
    parts.push("        'synth_substrate: read-only (no stim hardware coupled)')\n\n")

    // ─── api_on_shutdown_hook / api_last_error ────────────────────────
    parts.push("def api_on_shutdown_hook(sess, fn=None):\n")
    parts.push("    import atexit, signal\n")
    parts.push("    if sess is None: return\n")
    parts.push("    if sess.shutdown_bound: return\n")
    parts.push("    def _hook(*a, **kw):\n")
    parts.push("        sess.shutdown_fired_count += 1\n")
    parts.push("        try: api_close_session(sess)\n")
    parts.push("        except Exception: pass\n")
    parts.push("        if fn is not None:\n")
    parts.push("            try: fn(sess)\n")
    parts.push("            except Exception: pass\n")
    parts.push("    atexit.register(_hook)\n")
    parts.push("    try: signal.signal(signal.SIGTERM, _hook)\n")
    parts.push("    except Exception: pass\n")
    parts.push("    try: signal.signal(signal.SIGINT,  _hook)\n")
    parts.push("    except Exception: pass\n")
    parts.push("    sess.shutdown_bound = True\n\n")

    parts.push("def api_last_error(sess):\n")
    parts.push("    if sess is None:\n")
    parts.push("        return {'code':'no-session','advisory_url':'','retry_action':''}\n")
    parts.push("    return dict(sess.last_err)\n\n")

    // ─── selftest ─────────────────────────────────────────────────────
    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('== synth_substrate selftest ==')\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=selftest_synthetic')\n")
    parts.push("    fails = 0\n")
    // F_SUB_01a: shape correctness
    parts.push("    spec = {'backend':'synth','board_id':-1,'port':None,\n")
    parts.push("            'channel_set':{'name':'cyton_daisy_16',\n")
    parts.push("                           'ids':list(range(1,17)),\n")
    parts.push("                           'sample_rate':125,\n")
    parts.push("                           'labels':None,\n")
    parts.push("                           'layout_2d':None,\n")
    parts.push("                           'coords_3d':None}}\n")
    parts.push("    s1 = api_open_session(spec)\n")
    parts.push("    rec1 = api_start_recording(s1, name='selftest', fmt='NPY', max_min=-1)\n")
    parts.push("    data1, ts1 = api_read_chunk(s1, 250)  # ~2s at 125Hz\n")
    parts.push("    shape_ok = (len(data1) == 16 and len(data1[0]) == 250)\n")
    parts.push("    rate_ok  = (api_get_sample_rate(s1) == 125)\n")
    parts.push("    idx_ok   = (api_get_eeg_indices(s1) == list(range(1,17)))\n")
    parts.push("    print(f'  data1.rows={len(data1)} cols={len(data1[0])} ts1={ts1}')\n")
    parts.push("    print(f'  sample_rate={api_get_sample_rate(s1)}')\n")
    parts.push("    print(f'  eeg_indices[:4]={api_get_eeg_indices(s1)[:4]}')\n")
    parts.push("    f01a = shape_ok and rate_ok and idx_ok\n")
    parts.push("    print(f'F_SUB_01_shape={\"PASS\" if f01a else \"FAIL\"}')\n")
    parts.push("    if not f01a: fails += 1\n")
    parts.push("    api_stop_recording(rec1); api_close_session(s1)\n")
    parts.push("    s2 = api_open_session(spec)\n")
    parts.push("    data2, ts2 = api_read_chunk(s2, 250)\n")
    parts.push("    api_close_session(s2)\n")
    // Hash via struct pack to compare exact float bytes
    parts.push("    def hash_bytes(arr):\n")
    parts.push("        flat = []\n")
    parts.push("        for row in arr:\n")
    parts.push("            for v in row:\n")
    parts.push("                flat.append(v)\n")
    parts.push("        return struct.pack('<' + 'f'*len(flat), *flat)\n")
    parts.push("    b1 = hash_bytes(data1); b2 = hash_bytes(data2)\n")
    parts.push("    f01b = (b1 == b2 and ts1 == ts2)\n")
    parts.push("    print(f'  byte_identical={f01b} len_b1={len(b1)} ts1==ts2={ts1==ts2}')\n")
    parts.push("    print(f'F_SUB_01_deterministic={\"PASS\" if f01b else \"FAIL\"}')\n")
    parts.push("    if not f01b: fails += 1\n")
    // F_SUB_01c: idempotent double-close + reinit (mirrors F_SM_01/F_SM_03)
    parts.push("    s3 = api_open_session(spec)\n")
    parts.push("    state_pre = s3.state\n")
    parts.push("    api_close_session(s3)\n")
    parts.push("    halted_after_close = s3.has_halted\n")
    parts.push("    api_close_session(s3)  # double-close: must be no-op\n")
    parts.push("    s3b = api_reinit(s3)\n")
    parts.push("    f01c = (state_pre == STATE_INIT\n")
    parts.push("            and halted_after_close is True\n")
    parts.push("            and s3b is not None\n")
    parts.push("            and s3b.state == STATE_INIT)\n")
    parts.push("    print(f'  state_pre={state_pre} halted_after_close={halted_after_close} s3b.state={s3b.state}')\n")
    parts.push("    print(f'F_SUB_01_idempotent={\"PASS\" if f01c else \"FAIL\"}')\n")
    parts.push("    if not f01c: fails += 1\n")
    parts.push("    api_close_session(s3b)\n")
    // F_SUB_01d: api_stim raises NotImplementedError
    parts.push("    s4 = api_open_session(spec)\n")
    parts.push("    raised = False\n")
    parts.push("    try: api_stim(s4, None)\n")
    parts.push("    except NotImplementedError: raised = True\n")
    parts.push("    print(f'F_SUB_01_stim_raises={\"PASS\" if raised else \"FAIL\"}')\n")
    parts.push("    if not raised: fails += 1\n")
    parts.push("    api_close_session(s4)\n")

    parts.push("    if fails == 0:\n")
    parts.push("        print('verdict=PASS')\n")
    parts.push("    else:\n")
    parts.push("        print(f'verdict=FAIL fails={fails}')\n")
    parts.push("    print('selftest=ok')\n")
    parts.push("    print('DONE')\n")
    parts.push("    sys.exit(0 if fails == 0 else 1)\n\n")

    parts.push("def cmd_inspect(args):\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=inspect')\n")
    parts.push("    print(f'sample_rate={SYNTH_SAMPLE_RATE}')\n")
    parts.push("    print(f'channels={EXPECTED_CHANNEL_COUNT}')\n")
    parts.push("    print(f'lcg_seed={SYNTH_SEED}')\n")
    parts.push("    print(f'lcg_a={LCG_A} lcg_c={LCG_C} lcg_m={LCG_M}')\n")
    parts.push("    print('exported=api_open_session,api_close_session,api_reinit,api_start_recording,api_stop_recording,api_read_chunk,api_get_eeg_indices,api_get_sample_rate,api_stim,api_on_shutdown_hook,api_last_error')\n")
    parts.push("    print('inspect=ok')\n")
    parts.push("    print('DONE')\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    sub.add_parser('selftest')\n")
    parts.push("    sub.add_parser('inspect')\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest': cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'inspect': cmd_inspect(args)\n")
    parts.push("    else: sys.exit(2)\n\n")
    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// Section 2. Hexa-side assertions
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn _run_selftest_assertions(body: string) -> int {
    let mut pass = 0
    let mut fail = 0


    println("[T1] selftest=ok marker present")
    let t1 = assert_true(_kv_lookup(body, "selftest") == "ok", "selftest=ok")
    if t1 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T2] schema=" + SCHEMA)
    let t2 = assert_true(_kv_lookup(body, "schema") == SCHEMA, "schema match")
    if t2 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T3] verdict=PASS")
    let t3 = assert_true(_kv_lookup(body, "verdict") == "PASS", "verdict=PASS")
    if t3 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T4] F_SUB_01_shape (16xN, sr=125, ids 1..16)")
    let t4 = assert_true(_kv_lookup(body, "F_SUB_01_shape") == "PASS", "shape=PASS")
    if t4 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T5] F_SUB_01_deterministic (byte-identical across 2 runs)")
    let t5 = assert_true(_kv_lookup(body, "F_SUB_01_deterministic") == "PASS", "deterministic=PASS")
    if t5 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T6] F_SUB_01_idempotent (close+close+reinit no-op state machine)")
    let t6 = assert_true(_kv_lookup(body, "F_SUB_01_idempotent") == "PASS", "idempotent=PASS")
    if t6 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T7] F_SUB_01_stim_raises (read-only)")
    let t7 = assert_true(_kv_lookup(body, "F_SUB_01_stim_raises") == "PASS", "stim_raises=PASS")
    if t7 { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// Section 3. CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run eeg/substrates/synth_substrate.hexa --selftest")
    eprintln("       hexa run eeg/substrates/synth_substrate.hexa --inspect")
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path {
            if a.ends_with("/exe") { is_path = true }
        }
        if !is_path {
            if a.ends_with("hexa_interp") { is_path = true }
        }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut inspect_mode = false
    let mut want_help = false

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--inspect"  { inspect_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        _emit_trailer("unknown-arg", "unrecognized argument: " + a, "1) re-run with --help")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }

    if !selftest && !inspect_mode {
        _print_usage()
        exit(2)
    }

    _write_helper()

    if selftest {
        println("== synth_substrate selftest ==")
        let r = _run_helper("selftest")
        let body = r[0]
        let st   = r[1]
        println(body)
        if st != 0 {
            eprintln("selftest helper FAILED rc=" + to_string(st))
            exit(1)
        }
        if _kv_lookup(body, "selftest") != "ok" {
            _emit_trailer("selftest-marker-missing", "no selftest=ok",
                          "1) check helper parse")
            exit(1)
        }
        println("")
        let fails = _run_selftest_assertions(body)
        if fails != 0 {
            println("selftest=fail")
            eprintln("selftest FAILED: " + to_string(fails) + " assertion(s)")
            exit(1)
        }
        println("selftest: OK")
        exit(0)
    }

    println("== synth_substrate inspect ==")
    let r = _run_helper("inspect")
    println(r[0])
    if r[1] != 0 {
        eprintln("inspect helper FAILED rc=" + to_string(r[1]))
        exit(1)
    }
    exit(0)
}
// hexa-strict auto-invokes fn main() — do not call main() explicitly.
