// hexa-brain/eeg/substrates/channel_set.hexa
//
// PURPOSE
//   Pure-data helper module. Exports CYTON_DAISY_16 channel-set preset
//   (16-ch 10-20 labels + 2D ASCII coords mirrored from
//   eeg/headplot_helper.hexa:111-131) and a `make_channel_set` factory
//   shape so substrate backends can stamp out conformant `channel_set`
//   dicts. NO behavior, NO BrainFlow, NO numpy.
//
//   1. `coords_3d: null` is an EXPLICIT STUB — there is no 3D head-mesh
//      coordinate source in hexa-brain yet. 2D ASCII coords are the only
//      spatial truth currently encoded (and they are tuned for an 80x20
//      character grid, not anatomy).
//   2. The 16-label list is the Cyton+Daisy default; OpenBCI users who
//      remap pins will silently get wrong labels here. Labels are LABELS,
//      not montage assertions.
//   3. Labels are sourced from
//      state/anima_eeg_impedance_selftest_synth.json (canonical 10-20
//      order: Fp1,Fp2,C3,C4,P7,P8,O1,O2,F7,F8,F3,F4,T7,T8,P3,P4).
//
// USAGE
//   hexa run eeg/substrates/channel_set.hexa --selftest
//   hexa run eeg/substrates/channel_set.hexa --inspect

let SCHEMA              = "hexa-brain/eeg/channel_set/1"
let HELPER_PATH         = "/tmp/hexa_brain_channel_set_helper.py"
let DEFAULT_VENV_PYTHON = ".venv-eeg/bin/python"

// Canonical 10-20 labels for Cyton+Daisy 16ch.
let CYTON_DAISY_16_LABELS = "Fp1,Fp2,C3,C4,P7,P8,O1,O2,F7,F8,F3,F4,T7,T8,P3,P4"

// 2D ASCII coords (col,row) mirrored from eeg/headplot_helper.hexa:111-131.
// Encoded as `lab:col,row;...` for clean python split.
let CYTON_DAISY_16_LAYOUT_2D = "Fp1:33,4;Fp2:43,4;C3:32,10;C4:44,10;P7:24,13;P8:52,13;O1:33,16;O2:43,16;F7:24,7;F8:52,7;F3:32,7;F4:44,7;T7:20,10;T8:56,10;P3:32,13;P4:44,13"

// ════════════════════════════════════════════════════════════════════
// Section 0. Hexa-side helpers
// ════════════════════════════════════════════════════════════════════

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _emit_trailer(slug: string, detail: string, fix: string) {
    eprintln("reason: " + slug + ": " + detail)
    eprintln("fix: " + fix)
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# hexa-brain channel_set helper — emitted by\n")
    parts.push("import argparse, json, sys\n\n")

    parts.push("SCHEMA = '" + SCHEMA + "'\n\n")

    parts.push("CYTON_DAISY_16_LABELS = '" + CYTON_DAISY_16_LABELS + "'.split(',')\n")
    parts.push("CYTON_DAISY_16_LAYOUT_2D_RAW = '" + CYTON_DAISY_16_LAYOUT_2D + "'\n\n")

    parts.push("def _parse_layout(raw):\n")
    parts.push("    out = {}\n")
    parts.push("    for tok in raw.split(';'):\n")
    parts.push("        lab, xy = tok.split(':')\n")
    parts.push("        col, row = xy.split(',')\n")
    parts.push("        out[lab] = [int(col), int(row)]\n")
    parts.push("    return out\n\n")

    parts.push("def make_channel_set(name, ids, sample_rate, labels, layout_2d):\n")
    parts.push("    if labels is not None and len(labels) != len(ids):\n")
    parts.push("        raise ValueError(\n")
    parts.push("            f'channel_set: len(labels)={len(labels)} != len(ids)={len(ids)}')\n")
    parts.push("    return {\n")
    parts.push("        'name': str(name),\n")
    parts.push("        'ids': [int(i) for i in ids],\n")
    parts.push("        'sample_rate': int(sample_rate),\n")
    parts.push("        'labels': list(labels) if labels is not None else None,\n")
    parts.push("        'layout_2d': list(layout_2d) if layout_2d is not None else None,\n")
    parts.push("        'coords_3d': None,\n")
    parts.push("    }\n\n")

    parts.push("def preset_cyton_daisy_16():\n")
    parts.push("    layout = _parse_layout(CYTON_DAISY_16_LAYOUT_2D_RAW)\n")
    parts.push("    ids = list(range(1, 17))\n")
    parts.push("    labels = list(CYTON_DAISY_16_LABELS)\n")
    parts.push("    layout_2d = [layout[l] for l in labels]\n")
    parts.push("    return make_channel_set(\n")
    parts.push("        name='cyton_daisy_16', ids=ids, sample_rate=125,\n")
    parts.push("        labels=labels, layout_2d=layout_2d)\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('== channel_set selftest ==')\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=selftest_synthetic')\n")
    parts.push("    fails = 0\n")
    parts.push("    cs = preset_cyton_daisy_16()\n")
    parts.push("    print(f'  preset.name={cs[\"name\"]}')\n")
    parts.push("    print(f'  preset.n_ids={len(cs[\"ids\"])}')\n")
    parts.push("    print(f'  preset.n_labels={len(cs[\"labels\"])}')\n")
    parts.push("    print(f'  preset.n_layout_2d={len(cs[\"layout_2d\"])}')\n")
    parts.push("    print(f'  preset.coords_3d_stub={cs[\"coords_3d\"] is None}')\n")
    parts.push("    f01 = (len(cs['ids']) == 16 and len(cs['labels']) == 16\n")
    parts.push("           and len(cs['layout_2d']) == 16)\n")
    parts.push("    print(f'F_CS_01={\"PASS\" if f01 else \"FAIL\"}')\n")
    parts.push("    if not f01: fails += 1\n")
    parts.push("    fp1_idx = cs['labels'].index('Fp1')\n")
    parts.push("    fp1_xy = cs['layout_2d'][fp1_idx]\n")
    parts.push("    f02 = (cs['labels'][0] == 'Fp1' and fp1_xy == [33, 4])\n")
    parts.push("    print(f'  Fp1.xy={fp1_xy}')\n")
    parts.push("    print(f'F_CS_02={\"PASS\" if f02 else \"FAIL\"}')\n")
    parts.push("    if not f02: fails += 1\n")
    parts.push("    f03 = (cs['coords_3d'] is None)\n")
    parts.push("    print(f'F_CS_03={\"PASS\" if f03 else \"FAIL\"}')\n")
    parts.push("    if not f03: fails += 1\n")
    parts.push("    if fails == 0:\n")
    parts.push("        print('verdict=PASS')\n")
    parts.push("    else:\n")
    parts.push("        print(f'verdict=FAIL fails={fails}')\n")
    parts.push("    print('selftest=ok')\n")
    parts.push("    print('DONE')\n")
    parts.push("    sys.exit(0 if fails == 0 else 1)\n\n")

    parts.push("def cmd_inspect(args):\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=inspect')\n")
    parts.push("    print('exported=make_channel_set,preset_cyton_daisy_16')\n")
    parts.push("    print('preset_names=cyton_daisy_16')\n")
    parts.push("    print('coords_3d=null_stub')\n")
    parts.push("    print('inspect=ok')\n")
    parts.push("    print('DONE')\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    sub.add_parser('selftest')\n")
    parts.push("    sub.add_parser('inspect')\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest': cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'inspect': cmd_inspect(args)\n")
    parts.push("    else: sys.exit(2)\n\n")
    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// Section 2. Hexa-side assertions
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn _run_selftest_assertions(body: string) -> int {
    let mut pass = 0
    let mut fail = 0


    println("[T1] selftest=ok marker present")
    let t1 = assert_true(_kv_lookup(body, "selftest") == "ok", "selftest=ok")
    if t1 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T2] schema field matches")
    let t2 = assert_true(_kv_lookup(body, "schema") == SCHEMA, "schema=" + SCHEMA)
    if t2 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T3] verdict=PASS")
    let t3 = assert_true(_kv_lookup(body, "verdict") == "PASS", "verdict=PASS")
    if t3 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T4] F_CS_01 (16-ch shape invariants)")
    let t4 = assert_true(_kv_lookup(body, "F_CS_01") == "PASS", "F_CS_01=PASS")
    if t4 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T5] F_CS_02 (Fp1 coord pinned)")
    let t5 = assert_true(_kv_lookup(body, "F_CS_02") == "PASS", "F_CS_02=PASS")
    if t5 { pass = pass + 1 } else { fail = fail + 1 }

    println("[T6] F_CS_03 (coords_3d null stub)")
    let t6 = assert_true(_kv_lookup(body, "F_CS_03") == "PASS", "F_CS_03=PASS")
    if t6 { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// Section 3. CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run eeg/substrates/channel_set.hexa --selftest")
    eprintln("       hexa run eeg/substrates/channel_set.hexa --inspect")
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path {
            if a.ends_with("/exe") { is_path = true }
        }
        if !is_path {
            if a.ends_with("hexa_interp") { is_path = true }
        }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut inspect_mode = false
    let mut want_help = false

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--inspect"  { inspect_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        _emit_trailer("unknown-arg", "unrecognized argument: " + a, "1) re-run with --help")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }

    if !selftest && !inspect_mode {
        _print_usage()
        exit(2)
    }

    _write_helper()

    if selftest {
        println("== channel_set selftest ==")
        let r = _run_helper("selftest")
        let body = r[0]
        let st   = r[1]
        println(body)
        if st != 0 {
            eprintln("selftest helper FAILED rc=" + to_string(st))
            exit(1)
        }
        if _kv_lookup(body, "selftest") != "ok" {
            _emit_trailer("selftest-marker-missing", "no selftest=ok",
                          "1) check helper parse")
            exit(1)
        }
        println("")
        let fails = _run_selftest_assertions(body)
        if fails != 0 {
            println("selftest=fail")
            eprintln("selftest FAILED: " + to_string(fails) + " assertion(s)")
            exit(1)
        }
        println("selftest: OK")
        exit(0)
    }

    println("== channel_set inspect ==")
    let r = _run_helper("inspect")
    println(r[0])
    if r[1] != 0 {
        eprintln("inspect helper FAILED rc=" + to_string(r[1]))
        exit(1)
    }
    exit(0)
}
// hexa-strict auto-invokes fn main() — do not call main() explicitly.
