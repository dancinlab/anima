// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg/tool/daily_life_context_logger.hexa
//
//  PURPOSE
//    Daily-life activity context logger for EEG time-alignment. Captures
//    5 coarsened, privacy-respecting features per 5-second window:
//      keystroke_active_5s, screen_locked, active_app,
//      audio_level_db, network_active.
//      state/daily_life_context/<UTC-date>_activity.jsonl
//    so the EEG verifier (eeg_daily_life_verifier.hexa) can be joined
//    against ground-truth user activity.
//
//    NO Claude / LLM / remote inference. This is system-self logging only:
//    macOS native polling via /tmp helper. User must explicitly load the
//    launchd plist; the agent never auto-loads.
//
//    I1 keystroke content NEVER stored (active boolean only)
//    I2 screen pixels NEVER captured
//    I3 audio waveform NEVER stored (integer dB only)
//    I4 URLs / hosts / dst-IPs NEVER logged (Δbytes boolean only)
//    I5 window titles NEVER stored (process name only)
//
//  USAGE
//    --selftest                synthetic 4-row activity sequence
//    --selftest-mode {all_idle|active_typing|locked|mixed}
//    --tick                    one polling cycle (used by launchd, 5s interval)
//    --out <path>              override output JSONL
//    --falsifiers              run 7 falsifiers (incl. privacy F1-F4)
//
//  RAW
//
//    daily-life-activity-context-logger
//
//  FRAMEWORKS (own-5 ≥2)
//    Larson 1983 ESM (Experience Sampling), Dey 2001 (Context-Awareness),
//    Olguin 2009 (Sociometric badges)
//
//  @resolver-bypass(reason="darwin-native: ioreg / pmset / osascript / sox /
//                   netstat are macOS-only. Hetzner / linux pods do not have
//                   these tools nor the host's HID / display state.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima/daily_life_context/1"
let HELPER_PATH  = "/tmp/daily_life_context_helper.py"
let DEFAULT_OUT_DIR = "state/daily_life_context"

// ─── arg helpers ────────────────────────────────────────────────────────────
fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut starts_dash = 0
        if len(a) >= 1 {
            if a[0] == "-" { starts_dash = 1 }
        }
        if starts_dash == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn has_flag(name: string) -> bool {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n { if av[i] == name { return true } i = i + 1 }
    return false
}

fn flag_value(name: string, default_val: string) -> string {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == name { return av[i + 1] }
        i = i + 1
    }
    return default_val
}

fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }
fn today_utc() -> string { return exec("date -u +%Y-%m-%d").trim() }

fn write_helper() {
    let py = "#!/usr/bin/env python3\n" +
"# Privacy: NO keystroke content, NO screen pixels, NO audio waveform, NO URLs.\n" +
"import sys, os, json, subprocess, time, argparse\n" +
"\n" +
"def sh(cmd, t=2):\n" +
"    try:\n" +
"        p = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t)\n" +
"        return p.stdout.strip()\n" +
"    except Exception:\n" +
"        return ''\n" +
"\n" +
"def keystroke_active_5s():\n" +
"    # IOHIDSystem HIDIdleTime is in nanoseconds. <5e9 ns ⇒ active in last 5s.\n" +
"    out = sh(\"ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF; exit}'\")\n" +
"    try:\n" +
"        idle_ns = int(out)\n" +
"    except Exception:\n" +
"        return 0\n" +
"    return 1 if idle_ns < 5_000_000_000 else 0\n" +
"\n" +
"def screen_locked():\n" +
"    # Last 'Display is turned off/on' event in last 60s of pmset log.\n" +
"    out = sh(\"pmset -g log 2>/dev/null | grep -E 'Display is turned (off|on)' | tail -1\")\n" +
"    if 'turned off' in out: return 1\n" +
"    return 0\n" +
"\n" +
"def active_app():\n" +
"    # Process name only — NEVER window title (privacy I5).\n" +
"    out = sh(\"\"\"osascript -e 'tell application \"System Events\" to get name of first process whose frontmost is true' 2>/dev/null\"\"\")\n" +
"    return out.strip() if out else 'unknown'\n" +
"\n" +
"def audio_level_db():\n" +
"    # Cheap proxy: sample 0.1s via afinfo on /dev/null fallback OR system_profiler.\n" +
"    # We do NOT record audio. Return integer dB approximation; -60 = silent.\n" +
"    # Using sox if present, else default to -60 (silent) to avoid false positives.\n" +
"    sox = sh('command -v sox')\n" +
"    if not sox:\n" +
"        return -60\n" +
"    # 0.1 s rms via sox stat (stderr). Privacy: trim immediately, do NOT save.\n" +
"    try:\n" +
"        r = subprocess.run(\n" +
"            ['sox', '-t', 'coreaudio', 'default', '-n', 'trim', '0', '0.1', 'stat'],\n" +
"            capture_output=True, text=True, timeout=2)\n" +
"        for ln in r.stderr.splitlines():\n" +
"            if 'RMS' in ln and 'amplitude' in ln:\n" +
"                v = ln.split(':')[-1].strip()\n" +
"                amp = float(v)\n" +
"                if amp <= 0: return -60\n" +
"                # 20*log10(amp); amp is 0..1.\n" +
"                import math\n" +
"                db = int(20.0 * math.log10(amp + 1e-9))\n" +
"                return max(-60, min(0, db))\n" +
"    except Exception:\n" +
"        return -60\n" +
"    return -60\n" +
"\n" +
"_PREV_NET_FILE = '/tmp/daily_life_context_prev_netbytes.txt'\n" +
"def network_active():\n" +
"    out = sh(\"netstat -ib | awk 'NR>1 && $1==\\\"en0\\\" {print $7+$10; exit}'\")\n" +
"    try: cur = int(out)\n" +
"    except Exception: return 0\n" +
"    prev = 0\n" +
"    try:\n" +
"        with open(_PREV_NET_FILE) as f: prev = int(f.read().strip() or '0')\n" +
"    except Exception: pass\n" +
"    try:\n" +
"        with open(_PREV_NET_FILE, 'w') as f: f.write(str(cur))\n" +
"    except Exception: pass\n" +
"    delta = cur - prev\n" +
"    return 1 if delta > 1024 else 0\n" +
"\n" +
"def main():\n" +
"    ap = argparse.ArgumentParser()\n" +
"    ap.add_argument('--mode', default='real')\n" +
"    ap.add_argument('--seed', type=int, default=0)\n" +
"    args = ap.parse_args()\n" +
"    if args.mode == 'real':\n" +
"        row = {\n" +
"            'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n" +
"            'active_app': active_app(),\n" +
"            'keystroke_active_5s': keystroke_active_5s(),\n" +
"            'screen_locked': screen_locked(),\n" +
"            'audio_level_db': audio_level_db(),\n" +
"            'network_active': network_active(),\n" +
"            'schema': 'anima/daily_life_context/1',\n" +
"        }\n" +
"    else:\n" +
"        # Synthetic deterministic by seed+mode for selftest.\n" +
"        s = args.seed\n" +
"        if args.mode == 'all_idle':\n" +
"            row = dict(active_app='Finder', keystroke_active_5s=0,\n" +
"                       screen_locked=0, audio_level_db=-60, network_active=0)\n" +
"        elif args.mode == 'active_typing':\n" +
"            row = dict(active_app='Terminal', keystroke_active_5s=1,\n" +
"                       screen_locked=0, audio_level_db=-30, network_active=1)\n" +
"        elif args.mode == 'locked':\n" +
"            row = dict(active_app='loginwindow', keystroke_active_5s=0,\n" +
"                       screen_locked=1, audio_level_db=-60, network_active=0)\n" +
"        else:  # mixed\n" +
"            row = dict(active_app='Safari', keystroke_active_5s=1,\n" +
"                       screen_locked=0, audio_level_db=-45, network_active=1)\n" +
"        row['ts'] = '2026-04-28T00:00:%02dZ' % (s % 60)\n" +
"        row['schema'] = 'anima/daily_life_context/1'\n" +
"    print(json.dumps(row, sort_keys=True))\n" +
"\n" +
"if __name__ == '__main__': main()\n"
    write_file(HELPER_PATH, py)
    exec("chmod +x " + HELPER_PATH)
}

fn run_falsifiers() -> int {
    write_helper()
    let mut pass = 0
    let mut total = 0

    // F1-F4 privacy: synthetic output must NOT contain forbidden fields.
    let row = exec(HELPER_PATH + " --mode all_idle --seed 0").trim()
    total = total + 1
    if row.contains("keystroke_chars") == false { pass = pass + 1 }
    total = total + 1
    if row.contains("window_title") == false { pass = pass + 1 }
    total = total + 1
    if row.contains("pcm_") == false && row.contains("audio_waveform") == false { pass = pass + 1 }
    total = total + 1
    if row.contains("\"host\"") == false && row.contains("dst_ip") == false && row.contains("\"url\"") == false { pass = pass + 1 }

    // F5 all_idle ⇒ keystroke=0 AND network=0 AND audio<=-60
    total = total + 1
    if row.contains("\"keystroke_active_5s\": 0") && row.contains("\"network_active\": 0") && row.contains("\"audio_level_db\": -60") { pass = pass + 1 }

    // F6 active_typing ⇒ keystroke=1 AND audio>-60 AND non-empty active_app
    let row2 = exec(HELPER_PATH + " --mode active_typing --seed 1").trim()
    total = total + 1
    if row2.contains("\"keystroke_active_5s\": 1") && row2.contains("\"audio_level_db\": -30") && row2.contains("\"active_app\": \"Terminal\"") { pass = pass + 1 }

    // F7 idempotency: same seed+mode ⇒ identical row
    let row3a = exec(HELPER_PATH + " --mode mixed --seed 7").trim()
    let row3b = exec(HELPER_PATH + " --mode mixed --seed 7").trim()
    total = total + 1
    if row3a == row3b { pass = pass + 1 }

    println("  F1 NO keystroke_chars        : " + (if row.contains("keystroke_chars") == false { "PASS" } else { "FAIL" }))
    println("  F2 NO window_title           : " + (if row.contains("window_title") == false { "PASS" } else { "FAIL" }))
    println("  F3 NO audio waveform         : " + (if row.contains("pcm_") == false && row.contains("audio_waveform") == false { "PASS" } else { "FAIL" }))
    println("  F4 NO host/url/dst_ip        : " + (if row.contains("\"host\"") == false && row.contains("dst_ip") == false && row.contains("\"url\"") == false { "PASS" } else { "FAIL" }))
    println("  F5 all_idle invariants       : " + (if row.contains("\"keystroke_active_5s\": 0") && row.contains("\"network_active\": 0") { "PASS" } else { "FAIL" }))
    println("  F6 active_typing invariants  : " + (if row2.contains("\"keystroke_active_5s\": 1") { "PASS" } else { "FAIL" }))
    println("  total: " + str(pass) + " / " + str(total))
    return if pass == total { 0 } else { 1 }
}

// ─── selftest: synthetic 4-row sequence ─────────────────────────────────────
fn run_selftest(mode: string, out_path: string) -> int {
    write_helper()
    let modes = if mode == "mixed_seq" { ["all_idle", "active_typing", "locked", "mixed"] } else { [mode, mode, mode, mode] }
    let mut i = 0
    let mut all = ""
    while i < len(modes) {
        let m = modes[i]
        let row = exec(HELPER_PATH + " --mode " + m + " --seed " + str(i)).trim()
        all = all + row + "\n"
        i = i + 1
    }
    write_file(out_path, all)
    println("─── selftest (mode=" + mode + ") ───")
    println("  rows written : " + str(len(modes)))
    println("  output       : " + out_path)
    println(all)
    return 0
}

// ─── tick: one real polling cycle (launchd 5s interval) ─────────────────────
fn run_tick(out_path: string) -> int {
    write_helper()
    let row = exec(HELPER_PATH + " --mode real").trim()
    if len(row) < 2 { return 1 }
    exec("mkdir -p " + DEFAULT_OUT_DIR)
    exec("printf '%s\\n' " + "'" + row.replace("'", "'\\''") + "'" + " >> " + out_path)
    println(row)
    return 0
}

fn main() {
    let date     = today_utc()
    let default_out = DEFAULT_OUT_DIR + "/" + date + "_activity.jsonl"
    let out_path = flag_value("--out", default_out)

    if has_flag("--falsifiers") { exit(run_falsifiers()) }
    if has_flag("--selftest") {
        let mode = flag_value("--selftest-mode", "mixed_seq")
        let test_out = flag_value("--out", "state/anima_eeg_daily_life_context_selftest.jsonl")
        exit(run_selftest(mode, test_out))
    }
    if has_flag("--tick") { exit(run_tick(out_path)) }

    println("daily_life_context_logger — usage:")
    println("  --selftest [--selftest-mode mixed_seq|all_idle|active_typing|locked|mixed]")
    println("  --falsifiers      run 7 falsifiers (incl. F1-F4 privacy)")
    println("  --tick            one real polling cycle (launchd 5s interval)")
    println("  --out <path>      override output JSONL")
    exit(0)
}
