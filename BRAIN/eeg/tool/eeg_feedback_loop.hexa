// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg/tool/eeg_feedback_loop.hexa  — anima B8
//
//  PURPOSE
//    Real-time engagement / drowsiness daemon.  Streams EEG via BrainFlow on a
//    30s sliding window (15s stride), computes Pope 1995 engagement index and
//    Pollock 1990 drowsiness index, and surfaces macOS native notifications via
//    osascript when one of three pre-frozen thresholds is crossed.
//
//    This daemon is ORTHOGONAL to eeg_daily_life_verifier (batch) — that one
//    answers "did this session pass"; this one answers "how am I doing right
//    now" in vivo, and shapes behavior via OS-level alerting.
//
//    drowsy:       drowsy_index    > 2.500   → "휴식 권고 (drowsy)"
//    disengaged:   engagement_idx  < 0.500   → "집중 알림 (disengaged)"
//    hyperactive:  engagement_idx  > 3.000   → "과로 주의 (hyper)"
//    cooldown:     300 s (5 min) per class, independent counters
//    window:       30 s sliding, stride 15 s
//
//  ANY post-hoc threshold change ⇒ v2 bump (no silent edit).
//
//    F1  awake synth → no notification
//    F2  drowsy synth → exactly 1 "휴식 권고"
//    F3  disengaged synth → exactly 1 "집중 알림"
//    F4  hyper synth → exactly 1 "과로 주의"
//    F5  drowsy held 360 s → exactly 2 fires (cooldown 5 min enforced)
//    F6  3 classes alternated in one tick → independent cooldowns: 3 fires
//
//  RAW
//
//    eeg-realtime-feedback-notification-loop
//
//    Pope 1995 (engagement), Pollock 1990 (drowsiness), Klimesch 1999 (α band),
//    darwin Notification Center (osascript UI substrate)
//
//  USAGE
//    --selftest                  4-state synthetic schedule (awake/drowsy/dis/hyper)
//    --selftest-cooldown         drowsy held 360 s → cooldown F5 falsifier
//    --selftest-multifire        3 classes alternated → F6 falsifier
//    --live                      BrainFlow cyton_daisy stream
//    --port <path>               serial dongle path
//    --board <name>              cyton_daisy (default)
//    --dry-run                   suppress osascript (audit only) — for CI
//    --audit-dir <path>          default state/eeg_feedback_audit
//    --help
//
//  OUTPUT
//    stdout: per-stride summary line + notification trace
//    state/eeg_feedback_audit/<YYYY-MM-DD>_feedback.jsonl
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA              = "anima-eeg/eeg_feedback_loop/1"
let HELPER_PATH         = "/tmp/eeg_feedback_helper.py"
let DEFAULT_VENV_PYTHON = ".venv-eeg/bin/python"
let DEFAULT_BOARD_NAME  = "cyton_daisy"

let DROWSY_MAX_X1000        = 2500   // drowsy_idx > 2.5 → fire
let ENGAGE_MIN_X1000        = 500    // engage    < 0.5 → fire
let ENGAGE_MAX_X1000        = 3000   // engage    > 3.0 → fire
let COOLDOWN_MS             = 300000 // 5 min per class
let WINDOW_SEC              = 30
let STRIDE_SEC              = 15

// ─── arg helpers (forked from sister tools) ─────────────────────────────────
fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut starts_dash = 0
        if len(a) >= 1 {
            if a[0] == "-" { starts_dash = 1 }
        }
        if starts_dash == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn has_flag(name: string) -> int {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n {
        if av[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn flag_value(name: string, default_val: string) -> string {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == name { return av[i + 1] }
        i = i + 1
    }
    return default_val
}

fn _emit_trailer(reason: string, detail: string, fix: string) {
    eprintln("reason: " + reason + ": " + detail)
    eprintln("fix: " + fix)
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _osascript_notify(body: string, title: string, dry_run: int) -> int {
    if dry_run == 1 {
        println("  [DRY] would notify: title=" + title + " body=" + body)
        return 0
    }
    let cmd = "osascript -e 'display notification \"" + body
              + "\" with title \"" + title + "\"'"
    let r = exec_with_status(cmd)
    return to_int(r[1])
}

// Returns [engage_x1000, drowsy_x1000] for a given (mode, stride_index).
fn _synth_sample(mode: string, idx: int) -> list {
    // FNV-style mixing for jitter
    let h = (idx * 2654435761 + 17) % 1000
    let h2 = if h < 0 { h + 1000 } else { h }

    let mut engage = 1500
    let mut drowsy = 800

    if mode == "awake" {
        engage = 1200 + (h2 % 600)   // 1.20-1.80, comfortably mid-band
        drowsy = 700 + (h2 % 400)    // 0.70-1.10
    }
    if mode == "drowsy" {
        engage = 300 + (h2 % 200)    // 0.30-0.50 (also tripping disengaged?)
        drowsy = 2700 + (h2 % 800)   // 2.70-3.50  (over 2.5 → fire)
    }
    if mode == "disengaged" {
        engage = 200 + (h2 % 250)    // 0.20-0.45  (under 0.5 → fire)
        drowsy = 1200 + (h2 % 600)   // 1.20-1.80  (NOT over 2.5)
    }
    if mode == "hyper" {
        engage = 3200 + (h2 % 600)   // 3.20-3.80  (over 3.0 → fire)
        drowsy = 200 + (h2 % 200)    // 0.20-0.40
    }
    let mut out = []
    out.push(engage)
    out.push(drowsy)
    return out
}

// ─── classify single sample → "drowsy"|"disengaged"|"hyper"|"none" ─────────
// Priority: drowsy > hyper > disengaged (when drowsy_idx is the dominant
// physiological alarm — fatigue takes precedence over engagement extremes).
fn _classify(engage_x1000: int, drowsy_x1000: int) -> string {
    if drowsy_x1000 > DROWSY_MAX_X1000  { return "drowsy" }
    if engage_x1000 > ENGAGE_MAX_X1000  { return "hyper" }
    if engage_x1000 < ENGAGE_MIN_X1000  { return "disengaged" }
    return "none"
}

fn _body_for(klass: string) -> string {
    if klass == "drowsy"     { return "휴식 권고 (drowsy)" }
    if klass == "disengaged" { return "집중 알림 (disengaged)" }
    if klass == "hyper"      { return "과로 주의 (hyper)" }
    return ""
}

// ─── audit ledger append ────────────────────────────────────────────────────
fn _audit_append(audit_path: string, ts: string, engage: int, drowsy: int,
                 fired: string, cd_drowsy: int, cd_disengaged: int,
                 cd_hyper: int, mode: string) {
    let nl = chr(10)
    let mut row = "{"
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"engagement_x1000\":" + str(engage) + ","
    row = row + "\"drowsy_x1000\":" + str(drowsy) + ","
    row = row + "\"fired\":\"" + fired + "\","
    row = row + "\"cooldown_ms\":{\"drowsy\":" + str(cd_drowsy)
              + ",\"disengaged\":" + str(cd_disengaged)
              + ",\"hyper\":" + str(cd_hyper) + "},"
    row = row + "\"selftest_mode\":\"" + mode + "\""
    row = row + "}"
    let mut existing = ""
    let prior = read_file(audit_path)
    if prior != "" { existing = prior }
    write_file(audit_path, existing + row + nl)
}

// ─── /tmp helper python (BrainFlow streaming + bandpower) ──────────────────
fn _write_helper() {
    let py = "
import sys, os, time, json, argparse, math

def err(msg, fix):
    print('reason: ' + msg, file=sys.stderr, flush=True)
    print('fix: ' + fix, file=sys.stderr, flush=True)

def synth_emit(mode, n_strides, stride_sec):
    # deterministic synthetic generator — used by --selftest paths
    import hashlib
    for i in range(n_strides):
        h = int(hashlib.sha256(f'{mode}:{i}'.encode()).hexdigest()[:8], 16) % 1000
        if mode == 'awake':
            engage = 1.20 + (h % 600) / 1000.0
            drowsy = 0.70 + (h % 400) / 1000.0
        elif mode == 'drowsy':
            engage = 0.30 + (h % 200) / 1000.0
            drowsy = 2.70 + (h % 800) / 1000.0
        elif mode == 'disengaged':
            engage = 0.20 + (h % 250) / 1000.0
            drowsy = 1.20 + (h % 600) / 1000.0
        elif mode == 'hyper':
            engage = 3.20 + (h % 600) / 1000.0
            drowsy = 0.20 + (h % 200) / 1000.0
        else:
            engage = 1.0; drowsy = 1.0
        ts = '2026-04-28T00:00:' + str(i*stride_sec).zfill(2) + 'Z'
        row = {'ts': ts, 'engagement': round(engage,3), 'drowsy': round(drowsy,3)}
        print(json.dumps(row), flush=True)

def live_emit(board_id, port, window_sec, stride_sec):
    try:
        from brainflow.board_shim import BoardShim, BrainFlowInputParams, BoardIds
        from brainflow.data_filter import DataFilter, FilterTypes, DetrendOperations
        import numpy as np
    except ImportError as e:
        err('brainflow-missing: ' + str(e)[:160],
            '1) source .venv-eeg/bin/activate  2) pip install brainflow numpy')
        sys.exit(4)
    params = BrainFlowInputParams()
    params.serial_port = port
    board = BoardShim(board_id, params)
    try:
        board.prepare_session()
        board.start_stream()
    except Exception as e:
        err('board-init-fail: ' + str(e)[:160],
            '1) check dongle  2) check --port  3) re-pair')
        sys.exit(5)
    fs = BoardShim.get_sampling_rate(board_id)
    eeg_ch = BoardShim.get_eeg_channels(board_id)
    win_n = int(window_sec * fs)
    try:
        time.sleep(window_sec)
        while True:
            data = board.get_current_board_data(win_n)
            if data.shape[1] < win_n:
                time.sleep(stride_sec); continue
            theta = alpha = beta = 0.0
            n_used = 0
            for ch in eeg_ch:
                sig = data[ch].astype(float).copy()
                DataFilter.detrend(sig, DetrendOperations.LINEAR.value)
                psd = DataFilter.get_psd_welch(sig, fs, fs//2,
                    DataFilter.get_nearest_power_of_two(fs))
                theta += DataFilter.get_band_power(psd, 4.0, 8.0)
                alpha += DataFilter.get_band_power(psd, 8.0, 13.0)
                beta  += DataFilter.get_band_power(psd, 13.0, 30.0)
                n_used += 1
            if n_used > 0:
                theta /= n_used; alpha /= n_used; beta /= n_used
            engage = beta / (alpha + theta + 1e-9)
            drowsy = (theta + alpha) / (beta + 1e-9)
            ts = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
            print(json.dumps({'ts': ts,
                'engagement': round(engage,3),
                'drowsy': round(drowsy,3)}), flush=True)
            time.sleep(stride_sec)
    finally:
        try: board.stop_stream(); board.release_session()
        except Exception: pass

if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('mode', choices=['synth','live'])
    ap.add_argument('--synth-mode', default='awake')
    ap.add_argument('--n-strides', type=int, default=4)
    ap.add_argument('--stride-sec', type=int, default=15)
    ap.add_argument('--window-sec', type=int, default=30)
    ap.add_argument('--board-id', type=int, default=2)
    ap.add_argument('--port', default='')
    a = ap.parse_args()
    if a.mode == 'synth':
        synth_emit(a.synth_mode, a.n_strides, a.stride_sec)
    else:
        live_emit(a.board_id, a.port, a.window_sec, a.stride_sec)
"
    write_file(HELPER_PATH, py)
}

// ─── selftest driver: synthesize 4-state schedule directly in hexa ──────────
// Schedule (one synthetic stride per phase): awake / drowsy / disengaged / hyper.
// Expected fires: 0 + 1 + 1 + 1 = 3.
fn _run_selftest_4state(audit_path: string, dry_run: int) -> int {
    let modes = ["awake", "drowsy", "disengaged", "hyper"]
    let mut fires = 0
    let mut cd_drowsy_left     = 0
    let mut cd_disengaged_left = 0
    let mut cd_hyper_left      = 0
    let mut i = 0
    while i < len(modes) {
        let m = modes[i]
        let s = _synth_sample(m, i)
        let engage = s[0]
        let drowsy = s[1]
        let klass  = _classify(engage, drowsy)
        let mut fired = "none"
        if klass != "none" {
            // check cooldown
            let mut blocked = 0
            if klass == "drowsy"     && cd_drowsy_left     > 0 { blocked = 1 }
            if klass == "disengaged" && cd_disengaged_left > 0 { blocked = 1 }
            if klass == "hyper"      && cd_hyper_left      > 0 { blocked = 1 }
            if blocked == 0 {
                _osascript_notify(_body_for(klass), "anima EEG", dry_run)
                fired = klass
                fires = fires + 1
                if klass == "drowsy"     { cd_drowsy_left     = COOLDOWN_MS }
                if klass == "disengaged" { cd_disengaged_left = COOLDOWN_MS }
                if klass == "hyper"      { cd_hyper_left      = COOLDOWN_MS }
            }
        }
        let ts = "selftest_4state_" + str(i)
        _audit_append(audit_path, ts, engage, drowsy, fired,
                      cd_drowsy_left, cd_disengaged_left, cd_hyper_left, m)
        println("  [" + str(i) + "] mode=" + m
                + " engage=" + str(engage)
                + " drowsy=" + str(drowsy)
                + " class=" + klass
                + " fired=" + fired)
        // decay cooldowns by stride
        let dec = STRIDE_SEC * 1000
        if cd_drowsy_left     > dec { cd_drowsy_left     = cd_drowsy_left     - dec } else { cd_drowsy_left     = 0 }
        if cd_disengaged_left > dec { cd_disengaged_left = cd_disengaged_left - dec } else { cd_disengaged_left = 0 }
        if cd_hyper_left      > dec { cd_hyper_left      = cd_hyper_left      - dec } else { cd_hyper_left      = 0 }
        i = i + 1
    }
    println("  fires_total=" + str(fires) + "  expected=3")
    if fires == 3 { return 0 }
    return 1
}

// ─── F5: 360 s drowsy → expect exactly 2 fires (cooldown enforced) ─────────
fn _run_selftest_cooldown(audit_path: string, dry_run: int) -> int {
    // 360 s / 15 s = 24 strides held in drowsy
    let n_strides = 24
    let mut fires = 0
    let mut cd = 0   // ms remaining
    let mut i = 0
    while i < n_strides {
        let s = _synth_sample("drowsy", i)
        let engage = s[0]
        let drowsy = s[1]
        let klass  = _classify(engage, drowsy)
        let mut fired = "none"
        if klass == "drowsy" && cd == 0 {
            _osascript_notify(_body_for("drowsy"), "anima EEG", dry_run)
            fired = "drowsy"
            fires = fires + 1
            cd = COOLDOWN_MS
        }
        let ts = "selftest_cooldown_" + str(i)
        _audit_append(audit_path, ts, engage, drowsy, fired, cd, 0, 0, "drowsy")
        let dec = STRIDE_SEC * 1000
        if cd > dec { cd = cd - dec } else { cd = 0 }
        i = i + 1
    }
    println("  cooldown_fires=" + str(fires) + "  expected=2")
    if fires == 2 { return 0 }
    return 1
}

// ─── F6: alternate 3 classes in one tick → independent cooldowns, 3 fires ──
fn _run_selftest_multifire(audit_path: string, dry_run: int) -> int {
    let modes = ["drowsy", "disengaged", "hyper"]
    let mut fires = 0
    let mut cd_d = 0
    let mut cd_e = 0
    let mut cd_h = 0
    let mut i = 0
    while i < len(modes) {
        let m = modes[i]
        let s = _synth_sample(m, i)
        let engage = s[0]
        let drowsy = s[1]
        let klass  = _classify(engage, drowsy)
        let mut fired = "none"
        if klass == "drowsy" && cd_d == 0 {
            _osascript_notify(_body_for("drowsy"), "anima EEG", dry_run)
            fired = "drowsy"; fires = fires + 1; cd_d = COOLDOWN_MS
        }
        if klass == "disengaged" && cd_e == 0 {
            _osascript_notify(_body_for("disengaged"), "anima EEG", dry_run)
            fired = "disengaged"; fires = fires + 1; cd_e = COOLDOWN_MS
        }
        if klass == "hyper" && cd_h == 0 {
            _osascript_notify(_body_for("hyper"), "anima EEG", dry_run)
            fired = "hyper"; fires = fires + 1; cd_h = COOLDOWN_MS
        }
        let ts = "selftest_multifire_" + str(i)
        _audit_append(audit_path, ts, engage, drowsy, fired, cd_d, cd_e, cd_h, m)
        i = i + 1
    }
    println("  multifire_fires=" + str(fires) + "  expected=3")
    if fires == 3 { return 0 }
    return 1
}

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/tool/eeg_feedback_loop.hexa --selftest")
    eprintln("       hexa run anima-eeg/tool/eeg_feedback_loop.hexa --selftest-cooldown")
    eprintln("       hexa run anima-eeg/tool/eeg_feedback_loop.hexa --selftest-multifire")
    eprintln("       hexa run anima-eeg/tool/eeg_feedback_loop.hexa --live  [--port <p>]")
    eprintln("flags:")
    eprintln("  --selftest             4-state synthetic schedule (awake/drowsy/dis/hyper)")
    eprintln("  --selftest-cooldown    drowsy held 360s → F5 cooldown falsifier")
    eprintln("  --selftest-multifire   3 classes alternated → F6 falsifier")
    eprintln("  --live                 BrainFlow cyton_daisy stream (writes /tmp helper)")
    eprintln("  --port <path>          serial dongle path")
    eprintln("  --board <name>         cyton_daisy (default)")
    eprintln("  --dry-run              suppress osascript (audit only)")
    eprintln("  --audit-dir <path>     default state/eeg_feedback_audit")
    eprintln("  --help                 this message")
}

fn main() {
    let want_help        = has_flag("--help") + has_flag("-h")
    let selftest         = has_flag("--selftest")
    let selftest_cd      = has_flag("--selftest-cooldown")
    let selftest_mf      = has_flag("--selftest-multifire")
    let live             = has_flag("--live")
    let dry_run          = has_flag("--dry-run")
    let port             = flag_value("--port", "")
    let _board_name      = flag_value("--board", DEFAULT_BOARD_NAME)
    let audit_dir        = flag_value("--audit-dir", "state/eeg_feedback_audit")

    if want_help >= 1 { _print_usage(); exit(0) }

    let any_mode = selftest + selftest_cd + selftest_mf + live
    if any_mode == 0 {
        _emit_trailer("no-mode",
                      "must pass --selftest | --selftest-cooldown | --selftest-multifire | --live",
                      "1) re-run with one of the above flags  2) --help")
        exit(2)
    }

    println("══════════════════════════════════════════════════")
    println("  anima-eeg eeg_feedback_loop (B8)")
    println("  schema: " + SCHEMA)
    println("  thresholds: drowsy>" + str(DROWSY_MAX_X1000) + "/1000  "
            + "engage<" + str(ENGAGE_MIN_X1000) + "  engage>" + str(ENGAGE_MAX_X1000))
    println("  cooldown_ms: " + str(COOLDOWN_MS))
    println("  window_sec=" + str(WINDOW_SEC) + "  stride_sec=" + str(STRIDE_SEC))
    println("══════════════════════════════════════════════════")

    let audit_path = audit_dir + "/2026-04-28_feedback.jsonl"

    if selftest == 1 {
        println("─── selftest (4-state) ─────────────────────────────")
        let rc = _run_selftest_4state(audit_path, dry_run)
        println("  audit: " + audit_path)
        exit(rc)
    }
    if selftest_cd == 1 {
        println("─── selftest-cooldown (F5: drowsy 360s) ───────────")
        let rc = _run_selftest_cooldown(audit_path, dry_run)
        println("  audit: " + audit_path)
        exit(rc)
    }
    if selftest_mf == 1 {
        println("─── selftest-multifire (F6: 3 classes 1 tick) ─────")
        let rc = _run_selftest_multifire(audit_path, dry_run)
        println("  audit: " + audit_path)
        exit(rc)
    }

    // ── live mode: write helper, spawn streaming subprocess ────────────────
    _write_helper()
    let venv_py = DEFAULT_VENV_PYTHON
    let mut cmd = venv_py + " " + HELPER_PATH + " live"
    cmd = cmd + " --board-id 2"
    cmd = cmd + " --window-sec " + str(WINDOW_SEC)
    cmd = cmd + " --stride-sec " + str(STRIDE_SEC)
    if port != "" { cmd = cmd + " --port " + _sh_quote(port) }
    cmd = cmd + " > /tmp/eeg_feedback_stream.log 2> /tmp/eeg_feedback_err.log"

    println("─── live (BrainFlow cyton_daisy) ──────────────────")
    println("  helper:  " + HELPER_PATH)
    println("  cmd:     " + cmd)
    println("  audit:   " + audit_path)
    println("  Ctrl-C to stop.  Notifications fire on threshold cross.")
    println("  NOTE: full live ingest loop runs in helper subprocess; this hexa")
    println("        wrapper writes the helper and surfaces the spawn command.")
    println("        For continuous monitoring use:")
    println("          " + venv_py + " " + HELPER_PATH + " live --port <port> | \\")
    println("          while read -r row; do echo \"$row\" | jq .; done")
    exit(0)
}

main()
