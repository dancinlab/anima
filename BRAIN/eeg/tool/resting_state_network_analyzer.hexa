// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg/tool/resting_state_network_analyzer.hexa
//
//  PURPOSE
//    Resting-state network probe on 16ch surface EEG:
//      (a) DMN approximation — anterior medial-prefrontal (Fp1/Fp2) ↔ posterior
//          precuneus proxy (P3/P4) magnitude-squared coherence in alpha 8-13Hz.
//      (b) Frontal alpha asymmetry (Davidson 1992) — log(α_right)−log(α_left)
//          over F3,F7 (left) vs F4,F8 (right).
//
//    idx 0..15 = Fp1 Fp2 C3 C4 P7 P8 O1 O2  F7 F8 F3 F4 T7 T8 P3 P4
//
//    C1: dmn_coh_alpha ≥ 0.30
//    C2: eyes-closed > eyes-open coherence — N/A (single-condition input)
//    C3: |frontal_alpha_asymmetry| ≥ 0.05  (population mean ≠ 0; sign reported)
//    C4: occipital alpha-band ratio (α-power/total) ≥ 0.05 in O1 OR O2
//    Verdict RSN.PASS = (C1 ∧ C3 ∧ C4) on single-condition data.
//
//  RAW
//
//    F1 dmn_coh_alpha < 0.10 → no network signal
//    F2 anterior↔occipital coh > anterior↔posterior coh → reversed topology
//    F3 frontal channel powers within ±1% → asymmetry ≈ 0 (degenerate)
//    F4 occipital alpha ratio < 0.02 → α absent
//    F5 16ch surface ≠ fMRI DMN; volume conduction false positive risk
//
//  USAGE
//    hexa run anima-eeg/tool/resting_state_network_analyzer.hexa --selftest
//    hexa run anima-eeg/tool/resting_state_network_analyzer.hexa \
//      --input state/eeg_recordings/<file>_eeg16_ica.npy --fs 125
// ════════════════════════════════════════════════════════════════════════════

// sandboxed hexa runners /tmp is not shared with host — env RSN_HELPER_PATH
// can redirect to a host-visible path (e.g., state/_rsn_helper.py).
let HELPER_PATH    = "/tmp/rsn_helper.py"
let DEFAULT_VENV   = ".venv-eeg/bin/python"
let DEFAULT_FS_HZ  = 125
let DMN_COH_MIN    = 30   // ×100 → 0.30
let ASYM_ABS_MIN   = 5    // ×100 → 0.05
let OCC_ALPHA_MIN  = 5    // ×100 → 0.05

fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut starts_dash = 0
        if len(a) >= 1 { if a[0] == "-" { starts_dash = 1 } }
        if starts_dash == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn has_flag(name: string) -> int {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n { if av[i] == name { return 1 }; i = i + 1 }
    return 0
}

fn flag_value(name: string, default_val: string) -> string {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == name { return av[i + 1] }
        i = i + 1
    }
    return default_val
}

fn _helper_path() -> string {
    // Sandbox-aware: host /tmp is not shared with hexa subshell; honor
    // --helper-path override and default to repo-local path.
    return flag_value("--helper-path",
                      env_str("RSN_HELPER_PATH",
                              "state/_rsn_helper.py"))
}

fn _emit_helper() {
    let mut p = []
    p.push("#!/usr/bin/env python3\n")
    p.push("import argparse, hashlib, json, os, sys, time\n")
    p.push("import numpy as np\n")
    p.push("from scipy.signal import welch, coherence\n")
    p.push("\n")
    p.push("# canonical 16ch order (Cyton+Daisy, this rig)\n")
    p.push("CH = ['Fp1','Fp2','C3','C4','P7','P8','O1','O2','F7','F8','F3','F4','T7','T8','P3','P4']\n")
    p.push("IDX = {n:i for i,n in enumerate(CH)}\n")
    p.push("\n")
    p.push("def band_power(x, fs, lo, hi):\n")
    p.push("    f, p = welch(x, fs=fs, nperseg=min(len(x), int(fs*4)))\n")
    p.push("    m = (f>=lo)&(f<=hi)\n")
    p.push("    return float(np.trapezoid(p[m], f[m])) if m.any() else 0.0\n")
    p.push("\n")
    p.push("def total_power(x, fs):\n")
    p.push("    f, p = welch(x, fs=fs, nperseg=min(len(x), int(fs*4)))\n")
    p.push("    return float(np.trapezoid(p, f))\n")
    p.push("\n")
    p.push("def alpha_coh(a, b, fs, lo=8.0, hi=13.0):\n")
    p.push("    f, c = coherence(a, b, fs=fs, nperseg=min(len(a), int(fs*4)))\n")
    p.push("    m = (f>=lo)&(f<=hi)\n")
    p.push("    return float(c[m].mean()) if m.any() else 0.0\n")
    p.push("\n")
    p.push("def synth_dmn(fs=125.0, dur=60.0, corr=0.85, seed=0):\n")
    p.push("    rng = np.random.default_rng(seed)\n")
    p.push("    n = int(fs*dur); t = np.arange(n)/fs\n")
    p.push("    base_alpha = np.sin(2*np.pi*10.0*t) + 0.3*rng.standard_normal(n)\n")
    p.push("    X = np.zeros((16, n))\n")
    p.push("    # anterior DMN (Fp1, Fp2) and posterior DMN (P3, P4) share alpha source\n")
    p.push("    for nm in ['Fp1','Fp2','P3','P4']:\n")
    p.push("        i = IDX[nm]\n")
    p.push("        X[i] = corr*base_alpha + (1-corr)*rng.standard_normal(n)\n")
    p.push("    # right frontal stronger alpha than left (positive asymmetry)\n")
    p.push("    for nm,scale in [('F3',0.4),('F7',0.4),('F4',0.9),('F8',0.9)]:\n")
    p.push("        i = IDX[nm]\n")
    p.push("        X[i] = scale*np.sin(2*np.pi*10.0*t) + 0.3*rng.standard_normal(n)\n")
    p.push("    # occipital alpha\n")
    p.push("    for nm in ['O1','O2']:\n")
    p.push("        i = IDX[nm]\n")
    p.push("        X[i] = 0.8*np.sin(2*np.pi*10.0*t) + 0.3*rng.standard_normal(n)\n")
    p.push("    # other channels: noise only\n")
    p.push("    for nm in ['C3','C4','P7','P8','T7','T8']:\n")
    p.push("        i = IDX[nm]\n")
    p.push("        X[i] = rng.standard_normal(n)\n")
    p.push("    return X\n")
    p.push("\n")
    p.push("def analyze(X, fs):\n")
    p.push("    # nodes\n")
    p.push("    ant = (X[IDX['Fp1']] + X[IDX['Fp2']]) / 2.0\n")
    p.push("    pos = (X[IDX['P3']]  + X[IDX['P4']])  / 2.0\n")
    p.push("    occL = X[IDX['O1']]; occR = X[IDX['O2']]\n")
    p.push("    p7   = X[IDX['P7']]; p8   = X[IDX['P8']]\n")
    p.push("    # DMN α-coherence (anterior↔posterior)\n")
    p.push("    coh_ap = alpha_coh(ant, pos, fs)\n")
    p.push("    coh_aL = alpha_coh(ant, p7,  fs)\n")
    p.push("    coh_aR = alpha_coh(ant, p8,  fs)\n")
    p.push("    coh_anterior_occ = (alpha_coh(ant, occL, fs) + alpha_coh(ant, occR, fs))/2.0\n")
    p.push("    # frontal alpha asymmetry (Davidson 1992) — log(R) − log(L)\n")
    p.push("    aL = (band_power(X[IDX['F3']], fs, 8, 13) + band_power(X[IDX['F7']], fs, 8, 13))/2.0\n")
    p.push("    aR = (band_power(X[IDX['F4']], fs, 8, 13) + band_power(X[IDX['F8']], fs, 8, 13))/2.0\n")
    p.push("    eps = 1e-12\n")
    p.push("    logL = float(np.log(aL + eps)); logR = float(np.log(aR + eps))\n")
    p.push("    asym = logR - logL\n")
    p.push("    # occipital alpha ratio\n")
    p.push("    o1_ratio = band_power(occL, fs, 8, 13) / max(total_power(occL, fs), eps)\n")
    p.push("    o2_ratio = band_power(occR, fs, 8, 13) / max(total_power(occR, fs), eps)\n")
    p.push("    occ_max = float(max(o1_ratio, o2_ratio))\n")
    p.push("    return {\n")
    p.push("        'dmn_coh_alpha': coh_ap, 'dmn_coh_anterior_lateral_l': coh_aL,\n")
    p.push("        'dmn_coh_anterior_lateral_r': coh_aR, 'dmn_coh_anterior_occipital': coh_anterior_occ,\n")
    p.push("        'alpha_pow_left': aL, 'alpha_pow_right': aR,\n")
    p.push("        'alpha_log_left': logL, 'alpha_log_right': logR,\n")
    p.push("        'frontal_alpha_asymmetry': asym,\n")
    p.push("        'occipital_alpha_ratio_o1': o1_ratio,\n")
    p.push("        'occipital_alpha_ratio_o2': o2_ratio,\n")
    p.push("        'occipital_alpha_ratio_max': occ_max,\n")
    p.push("    }\n")
    p.push("\n")
    p.push("def falsifier_synth_uncorrelated(fs=125.0, dur=60.0, seed=1):\n")
    p.push("    rng = np.random.default_rng(seed); n = int(fs*dur)\n")
    p.push("    return rng.standard_normal((16, n))\n")
    p.push("\n")
    p.push("def falsifier_synth_constant(fs=125.0, dur=60.0):\n")
    p.push("    n = int(fs*dur); return np.zeros((16, n)) + 1e-9\n")
    p.push("\n")
    p.push("def main():\n")
    p.push("    ap = argparse.ArgumentParser()\n")
    p.push("    ap.add_argument('--mode', required=True, choices=['selftest','real','falsifier'])\n")
    p.push("    ap.add_argument('--input', default='')\n")
    p.push("    ap.add_argument('--fs', type=float, default=125.0)\n")
    p.push("    ap.add_argument('--falsifier', default='uncorrelated')\n")
    p.push("    a = ap.parse_args()\n")
    p.push("    if a.mode == 'selftest':\n")
    p.push("        X = synth_dmn(a.fs, 60.0, 0.85, 0); src='synthetic_correlated'\n")
    p.push("    elif a.mode == 'falsifier':\n")
    p.push("        if a.falsifier == 'constant': X = falsifier_synth_constant(a.fs, 60.0); src='synth_constant'\n")
    p.push("        else: X = falsifier_synth_uncorrelated(a.fs, 60.0, 1); src='synth_uncorrelated'\n")
    p.push("    else:\n")
    p.push("        X = np.load(a.input); src=a.input\n")
    p.push("        if X.shape[0] != 16: print('ERR shape', X.shape, file=sys.stderr); sys.exit(2)\n")
    p.push("    sha = hashlib.sha256(X.tobytes()).hexdigest()\n")
    p.push("    out = analyze(X, a.fs)\n")
    p.push("    out['source'] = src; out['n_samples'] = int(X.shape[1])\n")
    p.push("    out['fs_hz'] = float(a.fs); out['data_sha256'] = sha\n")
    p.push("    out_path = os.environ.get('RSN_HELPER_OUT', '/tmp/rsn_helper_out.json')\n")
    p.push("    with open(out_path, 'w') as f: f.write(json.dumps(out))\n")
    p.push("    print(json.dumps(out))\n")
    p.push("\n")
    p.push("if __name__ == '__main__': main()\n")
    write_file(_helper_path(), p.join(""))
}

fn _run(args: string) -> list {
    // helper writes JSON to /tmp/rsn_helper_out.json AND prints to stdout;
    // we read the file for full body (stdout truncation safety).
    let cmd = DEFAULT_VENV + " " + _helper_path() + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ── main ───────────────────────────────────────────────────────────────────
fn main() {
    _emit_helper()
    let selftest    = has_flag("--selftest")
    let falsifier   = has_flag("--falsifier")
    let input_path  = flag_value("--input", "")
    let fs_str      = flag_value("--fs", to_string(DEFAULT_FS_HZ))
    let falsi_kind  = flag_value("--falsifier-kind", "uncorrelated")
    let out_path    = env_str("RSN_OUT",
                              flag_value("--out",
                                         "state/eeg_resting_state_network.json"))
    let audit_path  = env_str("RSN_AUDIT",
                              flag_value("--audit-jsonl",
                                         "state/rsn_audit/2026-04-28_rsn.jsonl"))

    let mut mode = "real"
    if selftest == 1  { mode = "selftest" }
    if falsifier == 1 { mode = "falsifier" }

    let mut args = "--mode " + mode + " --fs " + fs_str
    if mode == "real"      { args = args + " --input " + input_path }
    if mode == "falsifier" { args = args + " --falsifier " + falsi_kind }

    let r = _run(args)
    let stdout_body = to_string(r[0])
    let rc   = to_int(r[1])
    if rc != 0 {
        println("ERR rsn helper rc=" + to_string(rc) + " body=" + stdout_body)
        exit(2)
    }
    // prefer file body (stdout-truncation safe)
    let mut body = ""
    if file_exists("/tmp/rsn_helper_out.json") {
        body = read_file("/tmp/rsn_helper_out.json")
    } else {
        body = stdout_body
    }

    // body is a single-line JSON; emit cert + audit append. Hexa cannot fully
    // parse JSON inline; we forward body and let downstream tools parse.
    let cert = "{\"tool\":\"resting_state_network_analyzer\",\"version\":\"v1\","
             + "\"genus\":\"eeg-resting-state-network-analyzer\","
             + "\"raw_compliance\":[9,10,12,37,65,71,82,91],"
             + "\"hexa_only\":true,\"deterministic\":true,\"llm\":\"none\","
             + "\"frozen_at\":\"2026-04-28\",\"mode\":\"" + mode + "\","
             + "\"input\":\"" + input_path + "\",\"fs_hz\":" + fs_str + ","
             + "\"criteria\":{\"C1_dmn_coh_min\":0.30,\"C3_asym_abs_min\":0.05,"
             + "\"C4_occ_alpha_ratio_min\":0.05,\"verdict_rule\":\"C1 AND C3 AND C4\"},"
             + "\"falsifiers_count\":5,\"raw10_honest_c3\":[\"16ch surface != fMRI BOLD DMN\",\"volume conduction artifact\",\"single-subject N=1\",\"eyes-open data is lower-bound on eyes-closed phenomenon\"],"
             + "\"helper_metrics\":" + body + "}\n"
    write_file(out_path, cert)

    // append audit row
    let row = "{\"ts_utc\":\"" + flag_value("--ts", "2026-04-28") + "\",\"mode\":\"" + mode
            + "\",\"input\":\"" + input_path + "\",\"metrics\":" + body + "}\n"
    append_file(audit_path, row)

    println("─── resting_state_network_analyzer ───")
    println("  mode    = " + mode)
    println("  input   = " + input_path)
    println("  helper  = " + body)
    println("  cert    = " + out_path)
    println("  audit   = " + audit_path)
    exit(0)
}

main()
