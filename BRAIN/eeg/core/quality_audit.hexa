// anima-eeg/core/quality_audit.hexa
//
// @resolver-bypass(reason="darwin-native: invokes .venv-eeg/bin/python which is a
//                   mac-local virtualenv hosting numpy/scipy. Reads .npy +
//                   .meta.json sidecar emitted by anima-eeg/collect.hexa and
//                   produces a quality_ledger JSONL row. Sub-module subprocess
//                   invocations (sample_rate_guard, package_num_audit) require
//                   `hexa` binary on PATH; selftest path is fully synthetic
//                   numpy + tempfile + uses internal compute fallbacks (no
//                   sub-module invocation), so works on any Darwin host with
//                   .venv-eeg + numpy.")
//
//   Master quality audit module — Cycle 2 entry of AI Quality Monitoring
//   System (see anima-eeg/docs/ai-native/quality_monitoring_system_plan_
//   2026_05_03.ai.md §3 module spec table).
//
//   Reads a single .npy + .meta.json pair, runs sequential audit primitives
//   (sample_rate_guard, package_num_audit, internal DC drift compute,
//   internal 60Hz line noise compute, internal per-channel REST/ACTIVE
//   noise compute), and emits a JSONL ledger row conforming to the
//   plan §4 schema. Designed as a thin orchestrator: numerical heavy
//   lifting delegated to existing primitives where possible, internal
//   compute (DC drift / 60Hz / per-channel std) only for metrics not
//   yet covered by an existing primitive module.
//
//   Cycle 2 scope (this module):
//     • input: --audit --input <path.npy>
//     • output: ledger JSONL row appended to
//                 anima-eeg/state/quality_ledger/<YYYY-MM>.jsonl
//     • sentinel: __EEG_QUALITY_AUDIT__ <PASS|FAIL> <issues> <ledger_id>
//
//   pattern detection, dashboard rendering, LLM advisor, ML learning —
//   all are cycles 3-5+ deliverables per plan §8.
//
// API
//   hexa run anima-eeg/core/quality_audit.hexa --selftest
//
//   hexa run anima-eeg/core/quality_audit.hexa \
//        --audit --input <path.npy> \
//        [--paradigm <blink|berger|jaw|ppg|generic>] \
//        [--ledger-emit | --no-ledger-emit] \
//        [--ledger-dir <path>] \
//        [--report] \
//        [--session-id <id>]
//
//   Default ledger-emit ON. Default ledger-dir
//     anima-eeg/state/quality_ledger/<YYYY-MM>.jsonl  (monthly rotation)
//
//   F_AUDIT_01: ledger row schema-conformant — every row appended to
//               disk parses as JSON and contains the 14 required keys
//               from plan §4 (ts, session_id, paradigm, duration_s,
//               effective_fs_hz, sample_drop_pct, package_num_dropout_pct,
//               package_num_largest_gap, dc_drift_max_uv,
//               per_channel_noise, line_noise_60hz_db, rail_flat_count,
//               falsifier_verdict, issues_detected, advice_emitted).
//   F_AUDIT_02: idempotent re-audit byte-stable — same .npy + .meta.json
//               re-audited twice with identical --session-id produces a
//               second ledger row whose JSON content (modulo the `ts`
//               field which is intentionally clock-wallt) is byte-equal
//               to the first; metric values stable under re-compute.
//
//   selftest verifies both falsifiers on synthetic .npy + .meta.json
//   without touching the production ledger directory (uses tmpdir).
//
// SENTINEL
//   __EEG_QUALITY_AUDIT__ <PASS|FAIL> <issue_count> <ledger_row_id>
//
//   1. Sub-module subprocess dependency: sample_rate_guard.hexa and
//      package_num_audit.hexa are invoked via `hexa run`. If `hexa`
//      binary is not on PATH, those metrics fall back to internal
//      compute (effective_fs = cols/duration; package gaps best-effort
//      via meta-claimed sample_rate). The fallback metrics are flagged
//      `degraded=true` in the row, and the corresponding falsifier
//      verdict entries are marked "UNKNOWN" rather than PASS/FAIL.
//      This is the cycle 2 minimum viable contract; cycle 3 may revisit.
//   2. rail_flat_detector path mentioned in design plan
//      (anima-eeg-core/tool/modules/_artifact/rail_flat_detector.hexa)
//      does not exist on disk as of cycle 2 land. We compute a
//      rail_flat_count via internal numpy (channel std < 0.5 µV → flat;
//      |max| > 187500 µV → railed; warn band between) as a placeholder.
//      When the canonical detector module lands, this module's
//      `rail_flat_count` source can be re-pointed via subprocess.
//   3. per_channel_noise REST/ACTIVE split requires a paradigm-aware
//      split point (e.g. blink session: 0-30s REST + 30-90s ACTIVE).
//      The plan §3 schema shows this. Cycle 2 implementation: if meta
//      contains `phase_boundaries_s` array we split on those; otherwise
//      we split at duration/2 and emit a `phase_boundaries_inferred`
//      flag. This is a coarse heuristic — paradigm-specific split logic
//      is deferred to the protocol modules that own each paradigm.
//
// USAGE
//   # default — audit, append ledger row, print sentinel
//   hexa run anima-eeg/core/quality_audit.hexa \
//        --audit --input anima-eeg/recordings/sessions/blink_session_90s_2026_05_03.npy \
//        --paradigm blink --report
//
//   # selftest — fully synthetic
//   hexa run anima-eeg/core/quality_audit.hexa --selftest
//
//   # ledger emit OFF (dry-run)
//   hexa run anima-eeg/core/quality_audit.hexa \
//        --audit --input <path.npy> --no-ledger-emit
//
//   • cycle 3: quality_ledger.hexa query API + quality_advisor.hexa Tier 1
//   • cycle 4: quality_dashboard.hexa + measurement-time hook integration
//   • cycle 5+: LLM advisor (Tier 2) + ML learning prep (Tier 3)

let SCHEMA      = "anima-eeg/quality_audit/1"
let HELPER_PATH = "/tmp/anima_eeg_quality_audit_helper.py"

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

let DEFAULT_VENV_PYTHON       = ".venv-eeg/bin/python"
let DEFAULT_LEDGER_DIR        = "anima-eeg/state/quality_ledger"
let DEFAULT_PARADIGM          = "generic"

// Sub-module relative paths (subprocess invocation via `hexa run`)
let SUBMOD_SR_GUARD           = "anima-eeg/protocols/sample_rate_guard.hexa"
let SUBMOD_PKG_NUM            = "anima-eeg/protocols/package_num_audit.hexa"

let DC_DRIFT_FAIL_UV          = 50000.0  // > 50k µV → dc_settle_transient flag
let LINE_NOISE_FAIL_DB        = 5.0      // 60Hz peak > 5 dB above broadband mean
let CHAN_NOISE_CHRONIC_UV     = 100.0    // rest_std > 100 µV → chronic noise flag
let RAIL_FLAT_FLAT_THRESH_UV  = 0.5      // std < 0.5 µV → flat
let RAIL_FLAT_RAILED_THRESH_UV = 187500.0  // |max| > 187500 µV → railed
let RAIL_FLAT_WARN_THRESH_UV  = 50000.0  // 50000 < |max| < 187500 → warn

// Selftest synthetic params
let SELFTEST_FS_HZ            = 125
let SELFTEST_DURATION_S       = 60
let SELFTEST_NCHAN            = 4

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

// ════════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima-eeg quality_audit helper — emitted by\n")
    parts.push("import argparse, hashlib, json, os, subprocess, sys, tempfile, textwrap, time\n\n")

    parts.push("VENV_PYTHON                = '" + DEFAULT_VENV_PYTHON + "'\n")
    parts.push("DEFAULT_LEDGER_DIR         = '" + DEFAULT_LEDGER_DIR + "'\n")
    parts.push("DEFAULT_PARADIGM           = '" + DEFAULT_PARADIGM + "'\n")
    parts.push("SCHEMA                     = '" + SCHEMA + "'\n")
    parts.push("SUBMOD_SR_GUARD            = '" + SUBMOD_SR_GUARD + "'\n")
    parts.push("SUBMOD_PKG_NUM             = '" + SUBMOD_PKG_NUM + "'\n")
    parts.push("DC_DRIFT_FAIL_UV           = " + to_string(DC_DRIFT_FAIL_UV) + "\n")
    parts.push("LINE_NOISE_FAIL_DB         = " + to_string(LINE_NOISE_FAIL_DB) + "\n")
    parts.push("CHAN_NOISE_CHRONIC_UV      = " + to_string(CHAN_NOISE_CHRONIC_UV) + "\n")
    parts.push("RAIL_FLAT_FLAT_THRESH_UV   = " + to_string(RAIL_FLAT_FLAT_THRESH_UV) + "\n")
    parts.push("RAIL_FLAT_RAILED_THRESH_UV = " + to_string(RAIL_FLAT_RAILED_THRESH_UV) + "\n")
    parts.push("RAIL_FLAT_WARN_THRESH_UV   = " + to_string(RAIL_FLAT_WARN_THRESH_UV) + "\n")
    parts.push("SELFTEST_FS_HZ             = " + str(SELFTEST_FS_HZ) + "\n")
    parts.push("SELFTEST_DURATION_S        = " + str(SELFTEST_DURATION_S) + "\n")
    parts.push("SELFTEST_NCHAN             = " + str(SELFTEST_NCHAN) + "\n\n")

    parts.push("REQUIRED_KEYS = [\n")
    parts.push("    'ts','session_id','paradigm','duration_s',\n")
    parts.push("    'effective_fs_hz','sample_drop_pct',\n")
    parts.push("    'package_num_dropout_pct','package_num_largest_gap',\n")
    parts.push("    'dc_drift_max_uv','per_channel_noise','line_noise_60hz_db',\n")
    parts.push("    'rail_flat_count','falsifier_verdict','issues_detected',\n")
    parts.push("    'advice_emitted',\n")
    parts.push("]\n\n")

    parts.push("def emit_trailer(slug, detail, fix):\n")
    parts.push("    sys.stderr.write(f'reason: {slug}: {detail}\\n')\n")
    parts.push("    sys.stderr.write(f'fix: {fix}\\n')\n\n")

    parts.push("def verify_numpy():\n")
    parts.push("    if not os.path.exists(VENV_PYTHON):\n")
    parts.push("        emit_trailer('venv-missing',\n")
    parts.push("                     f'{VENV_PYTHON} not found',\n")
    parts.push("                     '1) python3 -m venv .venv-eeg  '\n")
    parts.push("                     '2) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '3) pip install --upgrade numpy scipy')\n")
    parts.push("        return False\n")
    parts.push("    r = subprocess.run([VENV_PYTHON, '-c', 'import numpy; print(\"ok\")'],\n")
    parts.push("                       capture_output=True, text=True, timeout=20)\n")
    parts.push("    if r.returncode != 0:\n")
    parts.push("        emit_trailer('numpy-missing',\n")
    parts.push("                     f'numpy import failed: {r.stderr.strip()[:200]}',\n")
    parts.push("                     '1) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '2) pip install --upgrade numpy scipy')\n")
    parts.push("        return False\n")
    parts.push("    return True\n\n")

    // ─── core compute payload (runs inside .venv-eeg python) ─────────
    parts.push("COMPUTE_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, os, sys\n")
    parts.push("    import numpy as np\n")
    parts.push("    RAIL_FLAT_FLAT_THRESH_UV   = " + to_string(RAIL_FLAT_FLAT_THRESH_UV) + "\n")
    parts.push("    RAIL_FLAT_RAILED_THRESH_UV = " + to_string(RAIL_FLAT_RAILED_THRESH_UV) + "\n")
    parts.push("    RAIL_FLAT_WARN_THRESH_UV   = " + to_string(RAIL_FLAT_WARN_THRESH_UV) + "\n")
    parts.push("    INPUT     = sys.argv[1]\n")
    parts.push("    PARADIGM  = sys.argv[2]\n")
    parts.push("    META_PATH = INPUT + '.meta.json'\n")
    parts.push("    out = {'input': INPUT, 'meta_path': META_PATH, 'error': None}\n")
    parts.push("    if not os.path.exists(INPUT) or not os.path.exists(META_PATH):\n")
    parts.push("        out['error'] = 'input-or-meta-missing'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        arr = np.load(INPUT)\n")
    parts.push("        with open(META_PATH) as fh: meta = json.load(fh)\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        out['error'] = f'load-failed: {exc!r}'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    if arr.ndim == 1:\n")
    parts.push("        arr = arr.reshape(1, -1)\n")
    parts.push("    rows, cols = int(arr.shape[0]), int(arr.shape[1])\n")
    parts.push("    sr_claimed = float(meta.get('sample_rate_claimed_hz',\n")
    parts.push("                                 meta.get('sample_rate', 0.0)))\n")
    parts.push("    dur_actual = float(meta.get('duration_actual_s',\n")
    parts.push("                                 meta.get('duration_requested_s', 0.0)))\n")
    parts.push("    if dur_actual <= 0.0:\n")
    parts.push("        out['error'] = 'duration-non-positive'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    eff_fs = float(cols) / float(dur_actual)\n")
    parts.push("    drop_pct = max(0.0, (sr_claimed - eff_fs) / sr_claimed * 100.0) if sr_claimed > 0 else 0.0\n")
    parts.push("    out['rows'] = rows; out['cols'] = cols\n")
    parts.push("    out['sample_rate_claimed_hz'] = sr_claimed\n")
    parts.push("    out['duration_s'] = round(dur_actual, 4)\n")
    parts.push("    out['effective_fs_hz_internal'] = round(eff_fs, 4)\n")
    parts.push("    out['sample_drop_pct_internal'] = round(drop_pct, 4)\n")
    parts.push("    # ─── DC drift: 5-second window max|amp| ────────────────\n")
    parts.push("    win_n = max(1, int(round(eff_fs * 5.0)))\n")
    parts.push("    if cols >= win_n:\n")
    parts.push("        first_win = arr[:, :win_n]\n")
    parts.push("        dc_max_uv = float(np.max(np.abs(first_win)))\n")
    parts.push("    else:\n")
    parts.push("        dc_max_uv = float(np.max(np.abs(arr)))\n")
    parts.push("    out['dc_drift_max_uv'] = round(dc_max_uv, 2)\n")
    parts.push("    # ─── 60Hz line noise: dB above broadband mean ────────\n")
    parts.push("    line_db = 0.0\n")
    parts.push("    if cols >= int(eff_fs * 4) and eff_fs > 130.0:\n")
    parts.push("        try:\n")
    parts.push("            x = arr[0].astype(np.float64) - float(np.mean(arr[0]))\n")
    parts.push("            n_use = int(2 ** int(np.floor(np.log2(len(x)))))\n")
    parts.push("            x = x[:n_use]\n")
    parts.push("            spec = np.abs(np.fft.rfft(x)) ** 2\n")
    parts.push("            freqs = np.fft.rfftfreq(n_use, 1.0/eff_fs)\n")
    parts.push("            mask60 = (freqs >= 58.0) & (freqs <= 62.0)\n")
    parts.push("            mask_bb = (freqs >= 1.0) & (freqs <= eff_fs/2 - 1.0)\n")
    parts.push("            if np.any(mask60) and np.any(mask_bb):\n")
    parts.push("                p60 = float(np.mean(spec[mask60]))\n")
    parts.push("                pbb = float(np.mean(spec[mask_bb]))\n")
    parts.push("                if pbb > 0 and p60 > 0:\n")
    parts.push("                    line_db = 10.0 * float(np.log10(p60 / pbb))\n")
    parts.push("        except Exception:\n")
    parts.push("            line_db = 0.0\n")
    parts.push("    out['line_noise_60hz_db'] = round(line_db, 3)\n")
    parts.push("    out['line_noise_60hz_skipped'] = bool(eff_fs <= 130.0 or cols < int(eff_fs * 4))\n")
    parts.push("    # ─── per-channel noise: REST vs ACTIVE std ──────────\n")
    parts.push("    chan_names = meta.get('channel_names')\n")
    parts.push("    if not isinstance(chan_names, list) or len(chan_names) != rows:\n")
    parts.push("        chan_names = [f'ch{i}' for i in range(rows)]\n")
    parts.push("    boundaries = meta.get('phase_boundaries_s')\n")
    parts.push("    inferred = False\n")
    parts.push("    if not isinstance(boundaries, list) or len(boundaries) < 1:\n")
    parts.push("        boundaries = [dur_actual / 2.0]\n")
    parts.push("        inferred = True\n")
    parts.push("    out['phase_boundaries_inferred'] = inferred\n")
    parts.push("    split_idx = max(1, min(cols - 1, int(round(boundaries[0] * eff_fs))))\n")
    parts.push("    rest = arr[:, :split_idx]\n")
    parts.push("    active = arr[:, split_idx:]\n")
    parts.push("    per_chan = {}\n")
    parts.push("    for i, name in enumerate(chan_names):\n")
    parts.push("        rest_std = float(np.std(rest[i])) if rest.shape[1] > 0 else 0.0\n")
    parts.push("        act_std = float(np.std(active[i])) if active.shape[1] > 0 else 0.0\n")
    parts.push("        ratio = (rest_std / act_std) if act_std > 1e-9 else 0.0\n")
    parts.push("        per_chan[name] = round(rest_std, 2)\n")
    parts.push("        out.setdefault('per_channel_noise_full', {})[name] = {\n")
    parts.push("            'rest_std': round(rest_std, 2),\n")
    parts.push("            'active_std': round(act_std, 2),\n")
    parts.push("            'rest_active_ratio': round(ratio, 4),\n")
    parts.push("        }\n")
    parts.push("    out['per_channel_noise'] = per_chan\n")
    parts.push("    rfc = {'good': 0, 'warn': 0, 'railed': 0, 'flat': 0}\n")
    parts.push("    for i in range(rows):\n")
    parts.push("        s = float(np.std(arr[i])) if arr.shape[1] > 0 else 0.0\n")
    parts.push("        m = float(np.max(np.abs(arr[i]))) if arr.shape[1] > 0 else 0.0\n")
    parts.push("        if s < RAIL_FLAT_FLAT_THRESH_UV:\n")
    parts.push("            rfc['flat'] += 1\n")
    parts.push("        elif m > RAIL_FLAT_RAILED_THRESH_UV:\n")
    parts.push("            rfc['railed'] += 1\n")
    parts.push("        elif m > RAIL_FLAT_WARN_THRESH_UV:\n")
    parts.push("            rfc['warn'] += 1\n")
    parts.push("        else:\n")
    parts.push("            rfc['good'] += 1\n")
    parts.push("    out['rail_flat_count'] = rfc\n")
    parts.push("    print(json.dumps(out))\n")
    parts.push("    sys.exit(0)\n")
    parts.push("''')\n\n")

    // ─── selftest payload: synthesize a recording, audit, verify ────
    parts.push("SELFTEST_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, os, sys, tempfile\n")
    parts.push("    import numpy as np\n")
    parts.push("    FS = int(sys.argv[1]); DUR = int(sys.argv[2]); NCH = int(sys.argv[3])\n")
    parts.push("    rng = np.random.default_rng(42)\n")
    parts.push("    n = FS * DUR\n")
    parts.push("    t = np.arange(n) / FS\n")
    parts.push("    arr = np.zeros((NCH, n), dtype=np.float32)\n")
    parts.push("    for i in range(NCH):\n")
    parts.push("        arr[i] = (10.0 * np.sin(2*np.pi*10*t)\n")
    parts.push("                  + rng.standard_normal(n).astype(np.float32) * 5.0)\n")
    parts.push("    # inject DC transient first 5s on ch0 (-78k µV)\n")
    parts.push("    arr[0, :FS*5] += -78000.0\n")
    parts.push("    # inject Fp1-style chronic noise on ch1 (rest_std > 100)\n")
    parts.push("    arr[1] += rng.standard_normal(n).astype(np.float32) * 150.0\n")
    parts.push("    tmpdir = tempfile.mkdtemp(prefix='anima_eeg_qaud_')\n")
    parts.push("    npy = os.path.join(tmpdir, 'selftest_blink.npy')\n")
    parts.push("    np.save(npy, arr)\n")
    parts.push("    meta = {\n")
    parts.push("        'schema': 'anima-eeg/collect/1',\n")
    parts.push("        'tag': 'selftest_blink',\n")
    parts.push("        'sample_rate_claimed_hz': float(FS),\n")
    parts.push("        'sample_rate_actual_hz':  float(FS),\n")
    parts.push("        'sample_rate':            float(FS),\n")
    parts.push("        'rows': NCH, 'cols': n,\n")
    parts.push("        'duration_requested_s': float(DUR),\n")
    parts.push("        'duration_actual_s':    float(DUR),\n")
    parts.push("        'channel_names': ['Fp1','Fp2','C3','C4'][:NCH],\n")
    parts.push("        'phase_boundaries_s': [DUR/2.0],\n")
    parts.push("    }\n")
    parts.push("    with open(npy + '.meta.json','w') as fh:\n")
    parts.push("        json.dump(meta, fh, indent=2)\n")
    parts.push("    out = {'tmpdir': tmpdir, 'npy': npy, 'meta': meta}\n")
    parts.push("    print(json.dumps(out))\n")
    parts.push("''')\n\n")

    parts.push("def run_compute(npy_path, paradigm):\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', COMPUTE_PY, npy_path, paradigm]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)\n")
    parts.push("    if not r.stdout.strip():\n")
    parts.push("        return None, f'rc={r.returncode} stderr={r.stderr.strip()[:300]}'\n")
    parts.push("    try:\n")
    parts.push("        m = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        return None, f'parse-failed: {exc!r}'\n")
    parts.push("    if m.get('error'):\n")
    parts.push("        return None, m['error']\n")
    parts.push("    return m, None\n\n")

    parts.push("def invoke_submodule(submod_path, args_list):\n")
    parts.push("    # Try `hexa run <module> ...`; on failure return None (degraded)\n")
    parts.push("    if not os.path.exists(submod_path):\n")
    parts.push("        return None, 'submod-missing'\n")
    parts.push("    cmd = ['hexa', 'run', submod_path] + args_list\n")
    parts.push("    try:\n")
    parts.push("        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)\n")
    parts.push("    except FileNotFoundError:\n")
    parts.push("        return None, 'hexa-not-on-path'\n")
    parts.push("    except subprocess.TimeoutExpired:\n")
    parts.push("        return None, 'submod-timeout'\n")
    parts.push("    return r, None\n\n")

    parts.push("def parse_sentinel(stdout, marker):\n")
    parts.push("    for line in stdout.splitlines()[::-1]:\n")
    parts.push("        if line.startswith(marker):\n")
    parts.push("            return line.strip().split()\n")
    parts.push("    return None\n\n")

    parts.push("def build_row(npy_path, meta_path, paradigm, session_id, compute, sr_sentinel, pkg_sentinel, degraded):\n")
    parts.push("    import datetime\n")
    parts.push("    try:\n")
    parts.push("        ts_iso = datetime.datetime.now(datetime.UTC).strftime('%Y-%m-%dT%H:%M:%SZ')\n")
    parts.push("    except AttributeError:\n")
    parts.push("        ts_iso = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\n")
    parts.push("    eff_fs = compute['effective_fs_hz_internal']\n")
    parts.push("    drop_pct = compute['sample_drop_pct_internal']\n")
    parts.push("    f_fs_verdict = 'UNKNOWN'\n")
    parts.push("    if sr_sentinel and len(sr_sentinel) >= 4:\n")
    parts.push("        f_fs_verdict = 'PASS' if sr_sentinel[1] == 'PASS' else 'FAIL'\n")
    parts.push("        try:\n")
    parts.push("            eff_fs = float(sr_sentinel[2])\n")
    parts.push("            drop_pct = float(sr_sentinel[3])\n")
    parts.push("        except Exception:\n")
    parts.push("            pass\n")
    parts.push("    pkg_drop = 0.0; pkg_gap = 0; f_pkg_verdict = 'UNKNOWN'\n")
    parts.push("    if pkg_sentinel and len(pkg_sentinel) >= 4:\n")
    parts.push("        f_pkg_verdict = 'PASS' if pkg_sentinel[1] == 'PASS' else 'FAIL'\n")
    parts.push("        try:\n")
    parts.push("            pkg_drop = float(pkg_sentinel[2])\n")
    parts.push("            pkg_gap = int(pkg_sentinel[3])\n")
    parts.push("        except Exception:\n")
    parts.push("            pass\n")
    parts.push("    issues = []\n")
    parts.push("    if eff_fs > 0 and drop_pct >= 30.0:\n")
    parts.push("        issues.append('sample_rate_drop')\n")
    parts.push("    if compute['dc_drift_max_uv'] > DC_DRIFT_FAIL_UV:\n")
    parts.push("        issues.append('dc_settle_transient')\n")
    parts.push("    if compute['line_noise_60hz_db'] > LINE_NOISE_FAIL_DB:\n")
    parts.push("        issues.append('line_noise_60hz')\n")
    parts.push("    if pkg_drop >= 10.0:\n")
    parts.push("        issues.append('package_num_dropout')\n")
    parts.push("    chronic = []\n")
    parts.push("    for ch, std in compute['per_channel_noise'].items():\n")
    parts.push("        if std > CHAN_NOISE_CHRONIC_UV:\n")
    parts.push("            chronic.append(ch)\n")
    parts.push("    if chronic:\n")
    parts.push("        issues.append('channel_chronic_noise:' + ','.join(chronic))\n")
    parts.push("    rfc = compute['rail_flat_count']\n")
    parts.push("    if rfc.get('railed', 0) > 0:\n")
    parts.push("        issues.append('rail_detected')\n")
    parts.push("    if rfc.get('flat', 0) > 0:\n")
    parts.push("        issues.append('flat_channel')\n")
    parts.push("    row = {\n")
    parts.push("        'schema': SCHEMA,\n")
    parts.push("        'ts': ts_iso,\n")
    parts.push("        'session_id': session_id,\n")
    parts.push("        'paradigm': paradigm,\n")
    parts.push("        'duration_s': compute['duration_s'],\n")
    parts.push("        'effective_fs_hz': round(eff_fs, 4),\n")
    parts.push("        'sample_drop_pct': round(drop_pct, 4),\n")
    parts.push("        'package_num_dropout_pct': round(pkg_drop, 4),\n")
    parts.push("        'package_num_largest_gap': pkg_gap,\n")
    parts.push("        'dc_drift_max_uv': compute['dc_drift_max_uv'],\n")
    parts.push("        'per_channel_noise': compute['per_channel_noise'],\n")
    parts.push("        'line_noise_60hz_db': compute['line_noise_60hz_db'],\n")
    parts.push("        'rail_flat_count': rfc,\n")
    parts.push("        'falsifier_verdict': {\n")
    parts.push("            'F_FS_01': f_fs_verdict,\n")
    parts.push("            'F_PKG_01': f_pkg_verdict,\n")
    parts.push("        },\n")
    parts.push("        'issues_detected': issues,\n")
    parts.push("        'advice_emitted': [],\n")
    parts.push("        'degraded': bool(degraded),\n")
    parts.push("    }\n")
    parts.push("    return row\n\n")

    parts.push("def append_ledger(row, ledger_dir):\n")
    parts.push("    os.makedirs(ledger_dir, exist_ok=True)\n")
    parts.push("    ts = row['ts']\n")
    parts.push("    yymm = ts[:7]  # YYYY-MM\n")
    parts.push("    path = os.path.join(ledger_dir, yymm + '.jsonl')\n")
    parts.push("    line = json.dumps(row, sort_keys=True, ensure_ascii=False)\n")
    parts.push("    with open(path, 'a') as fh:\n")
    parts.push("        fh.write(line + '\\n')\n")
    parts.push("    row_id = hashlib.sha256(line.encode('utf-8')).hexdigest()[:16]\n")
    parts.push("    return path, row_id\n\n")

    parts.push("def schema_check(row):\n")
    parts.push("    missing = [k for k in REQUIRED_KEYS if k not in row]\n")
    parts.push("    return (len(missing) == 0), missing\n\n")

    parts.push("def cmd_audit(args):\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not os.path.exists(args.input):\n")
    parts.push("        emit_trailer('input-missing',\n")
    parts.push("                     f'--input {args.input} not found',\n")
    parts.push("                     '1) verify path exists')\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not os.path.exists(args.input + '.meta.json'):\n")
    parts.push("        emit_trailer('meta-missing',\n")
    parts.push("                     f'sidecar {args.input}.meta.json not found',\n")
    parts.push("                     '1) re-run collect.hexa with --output to regenerate sidecar')\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    compute, err = run_compute(args.input, args.paradigm)\n")
    parts.push("    if compute is None:\n")
    parts.push("        emit_trailer('compute-failed', err or 'unknown',\n")
    parts.push("                     '1) inspect helper python at ' + VENV_PYTHON)\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    degraded = False\n")
    parts.push("    sr_sentinel = None; pkg_sentinel = None\n")
    parts.push("    paradigm_to_sr = {'blink':'eeg_alpha','berger':'eeg_alpha','jaw':'emg',\n")
    parts.push("                      'ppg':'ppg','generic':'default'}\n")
    parts.push("    sr_paradigm = paradigm_to_sr.get(args.paradigm, 'default')\n")
    parts.push("    sr_args = ['--input', args.input, '--paradigm', sr_paradigm,\n")
    parts.push("               '--lenient', '--no-quarantine']\n")
    parts.push("    sr_r, sr_err = invoke_submodule(SUBMOD_SR_GUARD, sr_args)\n")
    parts.push("    if sr_r is not None:\n")
    parts.push("        sr_sentinel = parse_sentinel(sr_r.stdout, '__EEG_SAMPLE_RATE__')\n")
    parts.push("        if sr_sentinel is None:\n")
    parts.push("            degraded = True\n")
    parts.push("    else:\n")
    parts.push("        degraded = True\n")
    parts.push("    pkg_r, pkg_err = invoke_submodule(SUBMOD_PKG_NUM,\n")
    parts.push("                                      ['--input', args.input, '--lenient'])\n")
    parts.push("    if pkg_r is not None:\n")
    parts.push("        pkg_sentinel = parse_sentinel(pkg_r.stdout, '__EEG_PACKAGE_NUM__')\n")
    parts.push("        if pkg_sentinel is None:\n")
    parts.push("            degraded = True\n")
    parts.push("    else:\n")
    parts.push("        degraded = True\n")
    parts.push("    session_id = args.session_id\n")
    parts.push("    if not session_id:\n")
    parts.push("        session_id = os.path.splitext(os.path.basename(args.input))[0]\n")
    parts.push("    row = build_row(args.input, args.input + '.meta.json',\n")
    parts.push("                    args.paradigm, session_id,\n")
    parts.push("                    compute, sr_sentinel, pkg_sentinel, degraded)\n")
    parts.push("    ok_schema, missing = schema_check(row)\n")
    parts.push("    if not ok_schema:\n")
    parts.push("        emit_trailer('schema-violation',\n")
    parts.push("                     f'row missing keys: {missing}',\n")
    parts.push("                     '1) inspect quality_audit helper compute output')\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    ledger_path = None; row_id = '0000000000000000'\n")
    parts.push("    if args.ledger_emit:\n")
    parts.push("        ledger_path, row_id = append_ledger(row, args.ledger_dir)\n")
    parts.push("    if args.report:\n")
    parts.push("        print(f'session_id={row[\"session_id\"]}')\n")
    parts.push("        print(f'paradigm={row[\"paradigm\"]}  duration={row[\"duration_s\"]}s')\n")
    parts.push("        print(f'effective_fs={row[\"effective_fs_hz\"]} Hz  drop={row[\"sample_drop_pct\"]}%')\n")
    parts.push("        print(f'pkg_dropout={row[\"package_num_dropout_pct\"]}%  largest_gap={row[\"package_num_largest_gap\"]}')\n")
    parts.push("        print(f'dc_drift_max={row[\"dc_drift_max_uv\"]} uV')\n")
    parts.push("        print(f'line_noise_60Hz={row[\"line_noise_60hz_db\"]} dB')\n")
    parts.push("        print(f'rail_flat_count={row[\"rail_flat_count\"]}')\n")
    parts.push("        print(f'per_channel_noise={row[\"per_channel_noise\"]}')\n")
    parts.push("        print(f'falsifier_verdict={row[\"falsifier_verdict\"]}')\n")
    parts.push("        print(f'issues_detected={row[\"issues_detected\"]}')\n")
    parts.push("        if degraded:\n")
    parts.push("        if ledger_path:\n")
    parts.push("            print(f'ledger_appended={ledger_path}  row_id={row_id}')\n")
    parts.push("    issues_count = len(row['issues_detected'])\n")
    parts.push("    verdict = 'PASS' if issues_count == 0 else 'FAIL'\n")
    parts.push("    print(f'__EEG_QUALITY_AUDIT__ {verdict} {issues_count} {row_id}')\n")
    parts.push("    sys.exit(0 if issues_count == 0 else 1)\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('schema=' + SCHEMA)\n")
    parts.push("    print('venv_python_exists=' + str(os.path.exists(VENV_PYTHON)))\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    # 1) synthesize fixture\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', SELFTEST_PY,\n")
    parts.push("           str(SELFTEST_FS_HZ), str(SELFTEST_DURATION_S), str(SELFTEST_NCHAN)]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)\n")
    parts.push("    if r.returncode != 0 or not r.stdout.strip():\n")
    parts.push("        emit_trailer('selftest-fixture-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) verify .venv-eeg numpy installed')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    fixture = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    npy = fixture['npy']\n")
    parts.push("    tmpdir = fixture['tmpdir']\n")
    parts.push("    ledger_dir = os.path.join(tmpdir, 'ledger')\n")
    parts.push("    # 2) compute\n")
    parts.push("    compute_a, err = run_compute(npy, 'blink')\n")
    parts.push("    if compute_a is None:\n")
    parts.push("        emit_trailer('selftest-compute-failed', err or 'unknown', '1) inspect helper')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        print('__EEG_QUALITY_AUDIT__ FAIL 0 0000000000000000')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    # 3) build row twice for F_AUDIT_02 idempotence (fixed session_id)\n")
    parts.push("    sid = 'selftest_blink_session'\n")
    parts.push("    row_a = build_row(npy, npy + '.meta.json', 'blink', sid, compute_a, None, None, True)\n")
    parts.push("    # second compute pass\n")
    parts.push("    compute_b, _ = run_compute(npy, 'blink')\n")
    parts.push("    row_b = build_row(npy, npy + '.meta.json', 'blink', sid, compute_b, None, None, True)\n")
    parts.push("    # F_AUDIT_01: schema check\n")
    parts.push("    ok_a, miss_a = schema_check(row_a)\n")
    parts.push("    ok_b, miss_b = schema_check(row_b)\n")
    parts.push("    f01 = bool(ok_a and ok_b and not miss_a and not miss_b)\n")
    parts.push("    # F_AUDIT_02: byte-stable modulo `ts` field\n")
    parts.push("    a_strip = {k: v for k, v in row_a.items() if k != 'ts'}\n")
    parts.push("    b_strip = {k: v for k, v in row_b.items() if k != 'ts'}\n")
    parts.push("    a_json = json.dumps(a_strip, sort_keys=True)\n")
    parts.push("    b_json = json.dumps(b_strip, sort_keys=True)\n")
    parts.push("    f02 = bool(a_json == b_json)\n")
    parts.push("    # 4) ledger append (in tmpdir)\n")
    parts.push("    ledger_path, row_id = append_ledger(row_a, ledger_dir)\n")
    parts.push("    # verify roundtrip parse\n")
    parts.push("    parsed = None\n")
    parts.push("    with open(ledger_path) as fh:\n")
    parts.push("        for line in fh:\n")
    parts.push("            parsed = json.loads(line)\n")
    parts.push("    f01_roundtrip = bool(parsed and all(k in parsed for k in REQUIRED_KEYS))\n")
    parts.push("    f01 = bool(f01 and f01_roundtrip)\n")
    parts.push("    print(f'fixture_npy={npy}')\n")
    parts.push("    print(f'effective_fs={row_a[\"effective_fs_hz\"]} Hz  drop_pct={row_a[\"sample_drop_pct\"]}%')\n")
    parts.push("    print(f'dc_drift_max_uv={row_a[\"dc_drift_max_uv\"]} (expected ~78000)')\n")
    parts.push("    print(f'per_channel_noise={row_a[\"per_channel_noise\"]}')\n")
    parts.push("    print(f'rail_flat_count={row_a[\"rail_flat_count\"]}')\n")
    parts.push("    print(f'issues_detected={row_a[\"issues_detected\"]}')\n")
    parts.push("    print(f'F_AUDIT_01_schema_conformant: {\"PASS\" if f01 else \"FAIL\"}')\n")
    parts.push("    print(f'F_AUDIT_02_byte_stable_idempotent: {\"PASS\" if f02 else \"FAIL\"}')\n")
    parts.push("    overall = 'PASS' if (f01 and f02) else 'FAIL'\n")
    parts.push("    issues_count = len(row_a['issues_detected'])\n")
    parts.push("    print(f'selftest={overall.lower()}')\n")
    parts.push("    print(f'__EEG_QUALITY_AUDIT__ {overall} {issues_count} {row_id}')\n")
    parts.push("    # cleanup tmpdir\n")
    parts.push("    import shutil\n")
    parts.push("    try: shutil.rmtree(tmpdir)\n")
    parts.push("    except OSError: pass\n")
    parts.push("    sys.exit(0 if (f01 and f02) else 1)\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    s = sub.add_parser('selftest')\n")
    parts.push("    a = sub.add_parser('audit')\n")
    parts.push("    a.add_argument('--input', required=True)\n")
    parts.push("    a.add_argument('--paradigm', default=DEFAULT_PARADIGM)\n")
    parts.push("    a.add_argument('--ledger-emit', action='store_true', default=True,\n")
    parts.push("                   dest='ledger_emit')\n")
    parts.push("    a.add_argument('--no-ledger-emit', action='store_false', dest='ledger_emit')\n")
    parts.push("    a.add_argument('--ledger-dir', default=DEFAULT_LEDGER_DIR, dest='ledger_dir')\n")
    parts.push("    a.add_argument('--report', action='store_true', default=False)\n")
    parts.push("    a.add_argument('--session-id', default='', dest='session_id')\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest': cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'audit': cmd_audit(args)\n")
    parts.push("    else: sys.exit(2)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/core/quality_audit.hexa --selftest")
    eprintln("       hexa run anima-eeg/core/quality_audit.hexa \\")
    eprintln("            --audit --input <path.npy> \\")
    eprintln("            [--paradigm <blink|berger|jaw|ppg|generic>] \\")
    eprintln("            [--ledger-emit | --no-ledger-emit] \\")
    eprintln("            [--ledger-dir <path>] [--report] [--session-id <id>]")
    eprintln("flags:")
    eprintln("  --selftest             synthetic .npy + fixture audit, verify F_AUDIT_01/02")
    eprintln("  --audit --input <p>    audit single .npy + .meta.json sidecar")
    eprintln("  --paradigm <name>      blink|berger|jaw|ppg|generic (default " + DEFAULT_PARADIGM + ")")
    eprintln("  --ledger-emit          append JSONL row (default ON)")
    eprintln("  --no-ledger-emit       dry-run; compute but do not append")
    eprintln("  --ledger-dir <path>    ledger directory (default " + DEFAULT_LEDGER_DIR + ")")
    eprintln("  --report               print human-readable terminal summary")
    eprintln("  --session-id <id>      override session id (default = npy basename)")
    eprintln("  --help                 this message")
}

fn main() {
    let av = argv()
    let mut want_selftest    = false
    let mut want_audit       = false
    let mut want_help        = false
    let mut want_report      = false
    let mut ledger_emit      = true
    let mut input_path       = ""
    let mut paradigm         = DEFAULT_PARADIGM
    let mut ledger_dir       = DEFAULT_LEDGER_DIR
    let mut session_id       = ""

    // hexa-strict: user args begin at index 2 (matches sample_rate_guard / dc_settle_trim)
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"        { want_selftest = true; i = i + 1; continue }
        if a == "--audit"           { want_audit = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--report"          { want_report = true; i = i + 1; continue }
        if a == "--ledger-emit"     { ledger_emit = true; i = i + 1; continue }
        if a == "--no-ledger-emit"  { ledger_emit = false; i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--input requires a path",
                              "1) re-run with --input <path.npy>")
                exit(2)
            }
            input_path = av[i + 1]; i = i + 2; continue
        }
        if a == "--paradigm" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--paradigm requires a name",
                              "1) re-run with --paradigm blink|berger|jaw|ppg|generic")
                exit(2)
            }
            paradigm = av[i + 1]; i = i + 2; continue
        }
        if a == "--ledger-dir" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--ledger-dir requires a path",
                              "1) re-run with --ledger-dir <dir>")
                exit(2)
            }
            ledger_dir = av[i + 1]; i = i + 2; continue
        }
        if a == "--session-id" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--session-id requires a value",
                              "1) re-run with --session-id <id>")
                exit(2)
            }
            session_id = av[i + 1]; i = i + 2; continue
        }
        // unknown flag → fall through
        _emit_trailer("unknown-flag",
                      "argv[" + str(i) + "] = " + a,
                      "1) check --help for valid flags")
        _print_usage()
        exit(2)
    }

    if want_help {
        _print_usage()
        exit(0)
    }

    if !want_selftest && !want_audit {
        _emit_trailer("missing-mode",
                      "either --selftest or --audit required",
                      "1) use --selftest for synthetic verification  "
                      "2) or --audit --input <path.npy>")
        _print_usage()
        exit(2)
    }

    _write_helper()

    if want_selftest {
        let r = _run_helper("selftest")
        let stdout = r[0]
        let rc     = to_int(r[1])
        println(stdout)
        exit(rc)
    }

    // audit mode
    if input_path == "" {
        _emit_trailer("missing-required",
                      "--input is required for --audit mode",
                      "1) provide --input <path.npy>  "
                      "2) or use --selftest for synthetic verification")
        _print_usage()
        exit(2)
    }

    let mut args = "audit"
        + " --input "    + _sh_quote(input_path)
        + " --paradigm " + _sh_quote(paradigm)
        + " --ledger-dir " + _sh_quote(ledger_dir)
    if ledger_emit  { args = args + " --ledger-emit" }
    else            { args = args + " --no-ledger-emit" }
    if want_report  { args = args + " --report" }
    if session_id != "" {
        args = args + " --session-id " + _sh_quote(session_id)
    }

    let r = _run_helper(args)
    let stdout = r[0]
    let rc     = to_int(r[1])
    println(stdout)
    exit(rc)
}
