#!/usr/bin/env bash
# hexa-brain CLI dispatcher (v1.2.0+)
# Routes to eeg/ or core (tool/) subsystem.
#
# Layout (post-2026-05-05 feature-grouped triplet migration):
#   eeg/{core,doc,module,tool,...}/  — eeg subsystem (feature folder)
#   tool/{core,module}/              — core subsystem (paradigms/metrics/etc.)
#   design/core/, docs/core/         — design + phase docs
#
# Usage:
#   hexa-brain <subsystem> <verb> [args...]
#   hexa-brain --help                       # show usage
#   hexa-brain --version | -V               # print version from CHANGELOG
#
# Subsystems:
#   eeg    — scalp EEG capture pipeline (OpenBCI Cyton+Daisy 16ch)
#   core   — paradigms + metrics + filter pipeline (anima-eeg-core), now under tool/
#
# v1.2.0 — eeg verbs route through canonical eeg/eeg_setup.hexa dispatcher
# (raw#155 hxc-consumer-adapter mandate). Direct hexa verbs preserved for
# subcommands that have no eeg_setup.hexa entry.
#
# Resolution order for HEXA_BRAIN_ROOT:
#   1. $HEXA_BRAIN_ROOT env
#   2. realpath of this script's parent dir (../)
#   3. $HOME/.hexa-brain (default git-clone location per README)

set -uo pipefail

# Resolve repo root
if [[ -n "${HEXA_BRAIN_ROOT:-}" && -d "$HEXA_BRAIN_ROOT" ]]; then
  ROOT="$HEXA_BRAIN_ROOT"
elif [[ -L "${BASH_SOURCE[0]}" ]]; then
  SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || readlink "${BASH_SOURCE[0]}")"
  ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
else
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

if [[ ! -d "$ROOT/eeg" || ! -d "$ROOT/tool" ]]; then
  if [[ -d "$HOME/.hexa-brain/eeg" && -d "$HOME/.hexa-brain/tool" ]]; then
    ROOT="$HOME/.hexa-brain"
  else
    echo "FATAL: cannot resolve hexa-brain root with eeg/+tool/ (set HEXA_BRAIN_ROOT)" >&2
    exit 2
  fi
fi

# Version flag short-circuit
if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
  if [[ -f "$ROOT/CHANGELOG.md" ]]; then
    grep -m1 -E '^## \[' "$ROOT/CHANGELOG.md" | sed -E 's/.*\[([^]]+)\].*/hexa-brain \1/'
  else
    echo "hexa-brain (version unknown — CHANGELOG.md missing)"
  fi
  exit 0
fi

print_help() {
  cat <<EOF
hexa-brain — neural substrate hexa pipeline (scalp EEG to intracortical-class)
                                                              [hex-brain logo]
USAGE:
  hexa-brain <subsystem> <verb> [args...]

SUBSYSTEMS:
  eeg    — scalp EEG capture pipeline (OpenBCI Cyton+Daisy 16ch)
  core   — paradigms + metrics + filter pipeline (anima-eeg-core)

TOP-LEVEL VERBS:
  license-check       Run bin/check_licenses.sh (LICENSE_FIREWALL.md)

EEG VERBS (hexa-brain eeg <verb>):

 CANONICAL (route via eeg/eeg_setup.hexa, raw#155 compliant):
  health              Hardware preflight (no helmet — board sanity)
  impedance           One-shot impedance diagnostic
  impedance-validate  ⭐ WORN-HELMET 5-state evidence (canonical for sessions)
  headplot            ASCII 10-20 head plot
  adjust              Live single-channel touch detector
  rich                Rich TUI variant of adjust (3-panel)
  full                16ch concurrent 5-state view
  record              Segmented .npy task recorder
  list                Enumerate eeg_setup.hexa subcommands
  selftest            Run --selftest on every backend, summarize PASS/FAIL

 DIRECT (no eeg_setup.hexa subcommand):
  collect             Live EEG acquisition (BrainFlow)
  calibrate           Per-electrode impedance + adjust loop
  analyze             Band-power + topomap analysis
  experiment          Standardized protocols (resting / alpha / anima)
  closed-loop         N-back / meditation closed-loop (WebSocket UI)
  validate            6-metric brain-likeness QA
  realtime            Live BrainState consumer thread
  lsl-capture         LSL stream capture
  dual-stream         Dual Phi+EEG stream
  neurofeedback       Binaural beats + LED feedback
  export-neuroglancer Neuroglancer Precomputed export (2D time-series)
  router              [DEPRECATED v1.3.0] legacy eeg.hexa router → eeg/legacy/

CORE VERBS (hexa-brain core <verb>):
  core                       Top-level eeg_core.hexa entry
  paradigm-resting           Resting baseline paradigm
  paradigm-daily-life        Daily-life paradigm
  paradigm-p300-visual       Visual P300 paradigm
  paradigm-p300-auditory     Auditory P300 paradigm
  paradigm-integration-test  Paradigm integration test
  export                     EEG export (npy / jsonl)
  jsonl-audit                JSONL ledger audit
  adapter                    Core adapter
  filter-pipeline            Filter pipeline
  pipeline-suggester         Pipeline suggester
  falsifier-runner           Falsifier runner
  chflags-lock               File chflags immutable lock
  npy-loader                 NPY loader

GLOBAL FLAGS:
  --version, -V    Print version from CHANGELOG.md
  --help, -h       This text

PHASE E QUICK FLOW (worn-helmet 30 min session):
  hexa-brain eeg health --check                    # 1. board sanity
  hexa-brain eeg adjust --live                     # 2. electrode placement
  hexa-brain eeg impedance-validate --measure      # 3. 5-state worn-helmet check
  hexa-brain eeg full                              # 4. concurrent overview
  hexa-brain eeg collect --duration 30m            # 5. capture
  hexa-brain eeg analyze                           # 6. offline analysis

EXAMPLES:
  hexa-brain eeg health                   # hardware preflight (canonical dispatch)
  hexa-brain eeg impedance-validate       # worn-helmet 5-state evidence
  hexa-brain eeg list                     # enumerate canonical subcommands
  hexa-brain eeg selftest                 # run --selftest on every backend
  hexa-brain core paradigm-resting        # resting baseline paradigm

DOCS:
  README.md, CHANGELOG.md, .roadmap.hexa_brain
  eeg/doc/, eeg/README.ai.md
  design/core/, docs/core/, tool/core/, tool/module/

LICENSE: MIT
Repo:    $ROOT
EOF
}

# Top-level routing
SUBSYS="${1:-}"
shift || true

# Resolve hexa runtime (lazy — only needed if dispatching to a hexa file)
# Prefer hexa.real over the ~/.hx/bin/hexa routing shim. The shim
# unconditionally dispatches `hexa run` to a remote resource host (ubu-1)
# which breaks the EEG capture pipeline — eeg/eeg_setup.hexa probes the
# OpenBCI board + impedance state via local USB serial; the Mac inode
# must execute these probes directly.
resolve_hexa_bin() {
  if [ -n "${HEXA_BIN:-}" ] && [ -x "$HEXA_BIN" ]; then
    return
  fi
  if [ -x "$HOME/.hx/packages/hexa/hexa.real" ]; then
    HEXA_BIN="$HOME/.hx/packages/hexa/hexa.real"
  elif [ -x "$HOME/.hx/bin/hexa" ]; then
    HEXA_BIN="$HOME/.hx/bin/hexa"
  elif command -v hexa >/dev/null 2>&1; then
    HEXA_BIN="$(command -v hexa)"
  else
    echo "FATAL: 'hexa' runtime not on PATH (install hexa-lang first)" >&2
    echo "  see: https://github.com/dancinlab/hexa-lang" >&2
    exit 3
  fi
}

case "$SUBSYS" in
  license-check|license)
    # Top-level cross-cutting verb — routes to bin/check_licenses.sh.
    # Does NOT require hexa runtime (firewall must run before any .hexa).
    # See LICENSE_FIREWALL.md.
    exec "$ROOT/bin/check_licenses.sh" "$@"
    ;;

  eeg)
    VERB="${1:-}"
    shift || true
    resolve_hexa_bin
    SETUP_HEXA="$ROOT/eeg/eeg_setup.hexa"

    # --list-canonical short-circuit (anywhere in eeg verb position)
    if [[ "$VERB" == "--list-canonical" ]]; then
      exec "$HEXA_BIN" run "$SETUP_HEXA" list "$@"
    fi

    case "$VERB" in
      # ── CANONICAL VERBS (route via eeg_setup.hexa, raw#155 compliant) ──
      board-health|health)
        exec "$HEXA_BIN" run "$SETUP_HEXA" health "$@" ;;
      impedance)
        exec "$HEXA_BIN" run "$SETUP_HEXA" impedance "$@" ;;
      impedance-validate|impedance_validate)
        exec "$HEXA_BIN" run "$SETUP_HEXA" impedance_validate "$@" ;;
      headplot)
        exec "$HEXA_BIN" run "$SETUP_HEXA" headplot "$@" ;;
      electrode-adjust|adjust)
        exec "$HEXA_BIN" run "$SETUP_HEXA" adjust "$@" ;;
      rich)
        exec "$HEXA_BIN" run "$SETUP_HEXA" rich "$@" ;;
      full|full-helmet-view)
        exec "$HEXA_BIN" run "$SETUP_HEXA" full "$@" ;;
      recorder|record)
        exec "$HEXA_BIN" run "$SETUP_HEXA" record "$@" ;;
      list)
        exec "$HEXA_BIN" run "$SETUP_HEXA" list "$@" ;;
      selftest)
        exec "$HEXA_BIN" run "$SETUP_HEXA" selftest "$@" ;;

      # ── DIRECT HEXA VERBS (no eeg_setup.hexa subcommand) ──
      collect)
        exec "$HEXA_BIN" run "$ROOT/eeg/collect.hexa" "$@" ;;
      calibrate)
        exec "$HEXA_BIN" run "$ROOT/eeg/calibrate.hexa" "$@" ;;
      analyze)
        exec "$HEXA_BIN" run "$ROOT/eeg/analyze.hexa" "$@" ;;
      experiment)
        exec "$HEXA_BIN" run "$ROOT/eeg/experiment.hexa" "$@" ;;
      closed-loop|nback|meditation)
        exec "$HEXA_BIN" run "$ROOT/eeg/closed_loop.hexa" "$@" ;;
      validate|brain-likeness)
        exec "$HEXA_BIN" run "$ROOT/eeg/validate_consciousness.hexa" "$@" ;;
      realtime)
        exec "$HEXA_BIN" run "$ROOT/eeg/realtime.hexa" "$@" ;;
      impedance-real-hardware|impedance-validate-rich)
        exec "$HEXA_BIN" run "$ROOT/eeg/impedance_real_hardware_validation.hexa" "$@" ;;
      lsl-capture)
        exec "$HEXA_BIN" run "$ROOT/eeg/lsl_capture.hexa" "$@" ;;
      dual-stream)
        exec "$HEXA_BIN" run "$ROOT/eeg/dual_stream.hexa" "$@" ;;
      neurofeedback)
        exec "$HEXA_BIN" run "$ROOT/eeg/neurofeedback.hexa" "$@" ;;
      export-neuroglancer|export-ng)
        exec "$HEXA_BIN" run "$ROOT/eeg/export_neuroglancer.hexa" "$@" ;;
      router|"")
        # v1.3.0: eeg.hexa scrubbed to eeg/legacy/eeg.hexa (Phase 4b TODO-stub,
        # superseded by eeg_setup.hexa). Emit deprecation warning and dispatch
        # to legacy file for backwards-compat. Migrate to canonical verbs
        # (e.g. `hexa-brain eeg health|impedance|adjust|...`) or
        # `hexa run eeg/eeg_setup.hexa <subcommand>`.
        echo "WARN: 'router' is deprecated (v1.3.0) — eeg.hexa is a TODO-stub. Use canonical verbs (hexa-brain eeg help) or eeg_setup.hexa." >&2
        exec "$HEXA_BIN" run "$ROOT/eeg/legacy/eeg.hexa" "$@" ;;

      # ── HELP ──
      -h|--help|help)
        cat <<HELPEOF
hexa-brain eeg — scalp EEG capture pipeline (OpenBCI Cyton+Daisy 16ch)

CANONICAL VERBS (route via eeg/eeg_setup.hexa, raw#155 compliant):
  health              Hardware preflight (no helmet — board sanity)
  impedance           One-shot impedance diagnostic
  impedance-validate  ⭐ WORN-HELMET 5-state evidence (canonical for sessions)
  headplot            ASCII 10-20 head plot
  adjust              Live single-channel touch detector
  rich                Rich TUI variant of adjust (3-panel: head + table + sparklines)
  full                16ch concurrent 5-state view
  record              Segmented .npy task recorder
  list                Enumerate eeg_setup.hexa subcommands
  selftest            Run --selftest on every backend, summarize PASS/FAIL

DIRECT HEXA VERBS (no eeg_setup.hexa subcommand):
  collect             Live EEG acquisition (BrainFlow)
  calibrate           Per-electrode impedance + adjust loop
  analyze             Band-power + topomap analysis
  experiment          Standardized protocols (resting / alpha / anima)
  closed-loop         N-back / meditation closed-loop (WebSocket UI)
  validate            6-metric brain-likeness QA
  realtime            Live BrainState consumer thread
  lsl-capture         LSL stream capture
  dual-stream         Dual Phi+EEG stream
  neurofeedback       Binaural beats + LED feedback
  export-neuroglancer Neuroglancer Precomputed export (2D time-series)
  router              [DEPRECATED v1.3.0] legacy eeg.hexa router → eeg/legacy/

QUICK FLOWS:
  Phase E session (worn-helmet 30min):
    hexa-brain eeg health --check                              # 1. board sanity
    hexa-brain eeg adjust --live                               # 2. electrode placement
    hexa-brain eeg impedance-validate --measure                # 3. 5-state worn-helmet check
    hexa-brain eeg full                                        # 4. concurrent overview
    hexa-brain eeg collect --duration 30m                      # 5. capture
    hexa-brain eeg analyze                                     # 6. offline analysis

ALIASES (backwards-compat from v1.1.0):
  board-health → health
  electrode-adjust → adjust
  full-helmet-view → full
  recorder → record
  impedance_validate → impedance-validate
HELPEOF
        exit 0 ;;
      *)
        echo "Unknown eeg verb: $VERB" >&2
        echo "Run 'hexa-brain eeg help' for canonical list" >&2
        exit 1 ;;
    esac
    ;;
  core)
    VERB="${1:-}"
    shift || true
    resolve_hexa_bin
    case "$VERB" in
      core|"")
        exec "$HEXA_BIN" run "$ROOT/tool/core/eeg_core.hexa" "$@" ;;
      paradigm-daily-life)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_paradigms/daily_life.hexa" "$@" ;;
      paradigm-resting|paradigm-resting-baseline)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_paradigms/resting_baseline.hexa" "$@" ;;
      paradigm-p300-visual|paradigm-visual-p300)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_paradigms/visual_p300.hexa" "$@" ;;
      paradigm-p300-auditory|paradigm-auditory-p300)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_paradigms/auditory_p300.hexa" "$@" ;;
      paradigm-integration-test)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_paradigms/_integration_test.hexa" "$@" ;;
      export|eeg-export)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/eeg_export.hexa" "$@" ;;
      jsonl-audit)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/jsonl_audit.hexa" "$@" ;;
      adapter)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/_adapter.hexa" "$@" ;;
      filter-pipeline)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/filter_pipeline.hexa" "$@" ;;
      pipeline-suggester)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/pipeline_suggester.hexa" "$@" ;;
      falsifier-runner)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/falsifier_runner.hexa" "$@" ;;
      chflags-lock)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/chflags_lock.hexa" "$@" ;;
      npy-loader)
        exec "$HEXA_BIN" run "$ROOT/tool/module/_core/npy_loader.hexa" "$@" ;;
      --help|-h|help)
        echo "CORE subsystem verbs:"
        echo "  core (top-level), paradigm-resting, paradigm-daily-life,"
        echo "  paradigm-p300-visual, paradigm-p300-auditory, paradigm-integration-test,"
        echo "  export, jsonl-audit, adapter, filter-pipeline, pipeline-suggester,"
        echo "  falsifier-runner, chflags-lock, npy-loader"
        exit 0 ;;
      *)
        echo "Unknown core verb: $VERB" >&2
        echo "Run: hexa-brain core --help" >&2
        exit 1 ;;
    esac
    ;;
  -h|--help|help|"")
    print_help
    ;;
  *)
    echo "Unknown subsystem: $SUBSYS (valid: eeg, core, help)" >&2
    echo "Run: hexa-brain --help" >&2
    exit 1
    ;;
esac
