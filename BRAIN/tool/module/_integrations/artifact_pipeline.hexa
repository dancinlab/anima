// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_integrations/artifact_pipeline.hexa
//                                                  (Phase 6 — _integrations #4)
//
//  PURPOSE
//    Full artifact-detection chain — composes 8 detectors voted by a meta
//    classifier on resting-baseline ingest:
//      blink + motion + emg + ecg + emi + aging + refdrift + meta
//    Returns higher-level verdict CLEAN / SUSPICIOUS / DOMINANT / FAIL based
//    on per-detector verdicts and a quorum policy.
//
//    DECISION: PORT (selftest), WRAP-DESIGN-REFERENCE (live).
//    Legacy backends live as 9 modules under anima-eeg-core/tool/modules/_artifact/
//    (already LANDED in the artifact agent's namespace). This integration
//    module ports the *meta-classifier vote logic* in selftest and forwards
//    to dispatcher's `eeg_core artifact detect-all` route in live mode.
//    raw 91 honest C3: live mode wraps the existing _artifact/ chain — race-
//    condition-safe per Phase 6 contract since this file does NOT touch
//    _artifact/ modules, only consumes their kv-block output.
//
//  RAW#71 FALSIFIERS (5 preregistered, frozen 2026-04-29)
//    F_AP_01: detector verdicts missing/empty           → CHAIN_INCOMPLETE
//    F_AP_02: > 4 detectors DOMINANT                    → BAD_RECORDING
//    F_AP_03: meta verdict missing                      → META_FAILED
//    F_AP_04: total detectors < 7                       → DETECTOR_DEFICIT
//    F_AP_05: any detector schema mismatch              → SCHEMA_DRIFT
//
//  CLI
//    hexa run artifact_pipeline.hexa --selftest
//    hexa run artifact_pipeline.hexa --live   (→ NOT_YET_LANDED honest C3)
//
//
//  @resolver-bypass(reason="darwin-native: live mode wraps _artifact/ which
//                   needs real .npy ingest; selftest deterministic vote sim.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA      = "anima-eeg-core/_integrations/artifact_pipeline/1"
let MODULE_NAME = "artifact_pipeline"
let LEGACY_PATH = "anima-eeg-core/tool/modules/_artifact/artifact_meta_classifier.hexa"

let SENTINEL = -2147483647
let LCG_A = 1103515245
let LCG_C = 12345
let LCG_M = 2147483648

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) { return ln.substring(prefix.len(), ln.len()) }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

fn _lcg_next(state: int) -> int {
    let mut s = state * LCG_A + LCG_C
    if s < 0 { s = -s }
    s = s - (s / LCG_M) * LCG_M
    return s
}

// ─── public API ────────────────────────────────────────────────────────
//
// Selftest synthesizes 8 detector verdicts (blink/motion/emg/ecg/emi/aging/
// refdrift/meta) seeded by LCG. Nominal CLEAN-data fixture: all CLEAN.
// Injection forces specific detectors to DOMINANT.

fn _integration_artifact_pipeline_kv(args_kv: string) -> string {
    let seed         = _to_int_or(_kv_get(args_kv, "seed"),       20260429)
    let inj_dom_3    = _to_int_or(_kv_get(args_kv, "inject_3_dominant"), 0)
    let inj_dom_5    = _to_int_or(_kv_get(args_kv, "inject_5_dominant"), 0)
    let inj_missing  = _to_int_or(_kv_get(args_kv, "inject_missing"),    0)
    let inj_meta_drop = _to_int_or(_kv_get(args_kv, "inject_meta_drop"), 0)

    // detector list
    let detectors = ["blink", "motion", "emg", "ecg", "emi", "aging", "refdrift", "meta"]
    let n_det = len(detectors)

    // seed → per-detector verdict (CLEAN nominal). LCG injects dominance count.
    let mut verdicts = []
    let mut clean_count = 0
    let mut dom_count = 0
    let mut suspicious_count = 0
    let mut state = seed
    let mut k = 0
    while k < n_det {
        state = _lcg_next(state)
        verdicts.push("CLEAN")
        clean_count = clean_count + 1
        k = k + 1
    }
    // injection logic
    if inj_dom_3 == 1 {
        let mut i = 0
        while i < 3 { verdicts[i] = "DOMINANT"; clean_count = clean_count - 1; dom_count = dom_count + 1; i = i + 1 }
    }
    if inj_dom_5 == 1 {
        let mut i = 0
        while i < 5 { verdicts[i] = "DOMINANT"; clean_count = clean_count - 1; dom_count = dom_count + 1; i = i + 1 }
    }
    // count detectors present
    let mut detectors_present = n_det
    if inj_missing == 1 { detectors_present = 5 }
    if inj_meta_drop == 1 { verdicts[7] = "" }

    let mut triggered = ""
    let mut trig_count = 0
    // F_AP_01: any verdict empty (chain incomplete)
    let mut any_empty = 0
    let mut k2 = 0
    while k2 < detectors_present {
        if verdicts[k2] == "" { any_empty = 1 }
        k2 = k2 + 1
    }
    if any_empty == 1 { triggered = triggered + "F_AP_01,"; trig_count = trig_count + 1 }
    // F_AP_02: > 4 dominant
    if dom_count > 4 { triggered = triggered + "F_AP_02,"; trig_count = trig_count + 1 }
    // F_AP_03: meta verdict missing or empty
    if verdicts[7] == "" { triggered = triggered + "F_AP_03,"; trig_count = trig_count + 1 }
    // F_AP_04: < 7 detectors present
    if detectors_present < 7 { triggered = triggered + "F_AP_04,"; trig_count = trig_count + 1 }
    // F_AP_05: schema mismatch surrogate — never in synth (always 0)
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    // composite verdict
    let mut verdict = "CLEAN"
    if dom_count >= 1 { verdict = "SUSPICIOUS" }
    if dom_count >= 3 { verdict = "DOMINANT" }
    if trig_count > 0 { verdict = "FAIL" }
    if dom_count == 0 && suspicious_count == 0 && trig_count == 0 { verdict = "PASS" }

    let value_x1000 = clean_count * 1000

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "schema_version=eeg-core-phase6.v1\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "metric=artifact_chain_meta_vote\n"
    kv = kv + "paradigm=resting_baseline\n"
    kv = kv + "n_detectors=" + str(n_det) + "\n"
    kv = kv + "detectors_present=" + str(detectors_present) + "\n"
    kv = kv + "blink_verdict=" + verdicts[0] + "\n"
    kv = kv + "motion_verdict=" + verdicts[1] + "\n"
    kv = kv + "emg_verdict=" + verdicts[2] + "\n"
    kv = kv + "ecg_verdict=" + verdicts[3] + "\n"
    kv = kv + "emi_verdict=" + verdicts[4] + "\n"
    kv = kv + "aging_verdict=" + verdicts[5] + "\n"
    kv = kv + "refdrift_verdict=" + verdicts[6] + "\n"
    kv = kv + "meta_verdict=" + verdicts[7] + "\n"
    kv = kv + "clean_count=" + str(clean_count) + "\n"
    kv = kv + "dominant_count=" + str(dom_count) + "\n"
    kv = kv + "suspicious_count=" + str(suspicious_count) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(value_x1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_status=ported_in_module_synth_meta_vote\n"
    kv = kv + "raw71_falsifier_count=5\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=8_detector_chain_+meta_vote_+quorum_policy\n"
    kv = kv + "raw91_limit=no_real_npy_ingest_synth_vote_only\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run artifact_pipeline.hexa --selftest")
    eprintln("       hexa run artifact_pipeline.hexa --live   (→ NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut live = false
    let mut seed = 20260429
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--live"     { live = true; i = i + 1; continue }
        if a == "--seed"     { seed = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --live")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        println("── _integrations/artifact_pipeline LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_real_npy_+8_detector_chain")
        println("verdict=PENDING_MIGRATION")
        println("backend=" + LEGACY_PATH)
        eprintln("reason: not-yet-landed: live requires real .npy ingest + chained _artifact/ exec")
        eprintln("fix: run dispatcher route: hexa run anima-eeg-core/tool/eeg_core.hexa artifact detect-all --input <npy>")
        exit(4)
    }

    println("== _integrations/artifact_pipeline selftest (synth seed=" + str(seed) + ") ==")
    let args_kv = "seed=" + str(seed)
    let kv = _integration_artifact_pipeline_kv(args_kv)
    print(kv)

    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: nominal selftest verdict not PASS — falsifier triggered or non-clean")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
