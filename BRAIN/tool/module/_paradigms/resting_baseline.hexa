// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_paradigms/resting_baseline.hexa
//                                                  (Phase 4 — paradigm #1)
//
//  PURPOSE
//    Resting-baseline EEG paradigm: 60s eyes-closed / eyes-open segments at
//    125 Hz on 16-ch Cyton+Daisy. Berger-gate compatible (alpha attenuation
//    fixpoint: WRAP legacy anima-eeg/eeg_recorder.hexa for live recording;
//    selftest mode emits a synthetic protocol-log kv-block (no BrainFlow
//
//    DECISION: WRAP (live record) + PORT (selftest). The legacy
//    eeg_recorder.hexa (584 LoC, frozen) has a buggy argv normalizer that
//    rejects `hexa.real run X.hexa <flags>` invocation pattern (recognises
//    so this wrapper:
//      • for live record (--input <NPY> path or --duration with hardware
//        intent) emits NOT_YET_LANDED with a fix pointer (legacy backend
//        unbroken via shell-direct path);
//      • for --selftest synthesises the protocol-log structure in-module,
//        preserving the kv-block contract.
//
//  API
//    _paradigm_resting_baseline_kv(args_kv: string) -> string
//      kv-block:
//        schema=anima-eeg-core/_paradigms/resting_baseline/1
//        paradigm=resting_baseline
//        duration_s=60
//        sample_rate_hz=125
//        channel_count=16
//        protocol_steps=eyes_open_60s,eyes_closed_60s
//        verdict=<PASS|FAIL|FALSIFIED>
//        raw71_falsifier_count=3
//        raw71_triggered_ids=<csv>
//        raw91_evidence=protocol_log_synth_or_ledger
//        raw91_limit=selftest_synthesis_no_brainflow
//
//  RAW#71 FALSIFIERS (≥3 preregister, frozen 2026-04-28)
//    F_RB_01: duration_s != requested → schedule mismatch
//    F_RB_02: sample_rate_hz != 125    → wrong board config
//    F_RB_03: channel_count != 16      → wrong montage
//
//  CLI
//    hexa run resting_baseline.hexa --selftest
//    hexa run resting_baseline.hexa --duration 60 --segment 60   (live → NOT_YET_LANDED)
//
//
//  @resolver-bypass(reason="darwin-native: legacy backend requires .venv-eeg
//                   + USB; mac selftest synth-only.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA          = "anima-eeg-core/_paradigms/resting_baseline/1"
let PARADIGM_NAME   = "resting_baseline"
let LEGACY_PATH     = "anima-eeg/eeg_recorder.hexa"

let DEFAULT_DURATION_S      = 60
let DEFAULT_SAMPLE_RATE_HZ  = 125
let DEFAULT_CHANNEL_COUNT   = 16
let DEFAULT_SEGMENT_S       = 60

// ─── helpers ────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _kv_get(kv: string, key: string) -> string {
    let prefix = key + "="
    let lines = kv.split(",")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _to_int_or(s: string, dflt: int) -> int {
    if s == "" { return dflt }
    return to_int(s)
}

// ─── public API ────────────────────────────────────────────────────────

fn _paradigm_resting_baseline_kv(args_kv: string) -> string {
    // args_kv format: "duration_s=60,sample_rate_hz=125,channel_count=16,segment_s=60"
    let dur     = _to_int_or(_kv_get(args_kv, "duration_s"),     DEFAULT_DURATION_S)
    let srh     = _to_int_or(_kv_get(args_kv, "sample_rate_hz"), DEFAULT_SAMPLE_RATE_HZ)
    let chc     = _to_int_or(_kv_get(args_kv, "channel_count"),  DEFAULT_CHANNEL_COUNT)
    let seg     = _to_int_or(_kv_get(args_kv, "segment_s"),      DEFAULT_SEGMENT_S)

    let mut triggered = ""
    let mut trig_count = 0
    if dur != DEFAULT_DURATION_S        { triggered = triggered + "F_RB_01,"; trig_count = trig_count + 1 }
    if srh != DEFAULT_SAMPLE_RATE_HZ    { triggered = triggered + "F_RB_02,"; trig_count = trig_count + 1 }
    if chc != DEFAULT_CHANNEL_COUNT     { triggered = triggered + "F_RB_03,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "PASS"
    if trig_count > 0 { verdict = "FALSIFIED" }

    let protocol = "eyes_open_" + str(dur) + "s,eyes_closed_" + str(dur) + "s"

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "paradigm=" + PARADIGM_NAME + "\n"
    kv = kv + "duration_s=" + str(dur) + "\n"
    kv = kv + "sample_rate_hz=" + str(srh) + "\n"
    kv = kv + "channel_count=" + str(chc) + "\n"
    kv = kv + "segment_s=" + str(seg) + "\n"
    kv = kv + "protocol_steps=" + protocol + "\n"
    kv = kv + "berger_gate_compatible=1\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "value_x1000=" + str(dur * 1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_status=selftest_synth_no_brainflow\n"
    kv = kv + "raw71_falsifier_count=3\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=protocol_log_synth_or_ledger\n"
    kv = kv + "raw91_limit=selftest_synthesis_no_brainflow\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run resting_baseline.hexa --selftest")
    eprintln("       hexa run resting_baseline.hexa --duration <s> [--segment <s>] (live → NOT_YET_LANDED)")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut duration = DEFAULT_DURATION_S
    let mut segment = DEFAULT_SEGMENT_S
    let mut sample_rate = DEFAULT_SAMPLE_RATE_HZ
    let mut channels = DEFAULT_CHANNEL_COUNT
    let mut live = false
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"       { selftest = true; i = i + 1; continue }
        if a == "--duration"       { duration = to_int(av[i+1]); live = true; i = i + 2; continue }
        if a == "--segment"        { segment = to_int(av[i+1]); i = i + 2; continue }
        if a == "--sample-rate-hz" { sample_rate = to_int(av[i+1]); i = i + 2; continue }
        if a == "--channels"       { channels = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if !selftest && !live {
        eprintln("ABORT: must pass --selftest or --duration <s>")
        _print_usage()
        exit(2)
    }

    if live && !selftest {
        // argv-normalizer bug under hexa.real run path. Emit NOT_YET_LANDED.
        println("── _paradigms/resting_baseline LIVE ──")
        println("schema=" + SCHEMA)
        println("status=NOT_YET_LANDED")
        println("kind=live_brainflow_record")
        println("verdict=PENDING_MIGRATION")
        println("backend=" + LEGACY_PATH)
        eprintln("reason: legacy-argv-normalizer-bug: " + LEGACY_PATH + " rejects hexa.real run prefix")
        eprintln("fix: invoke legacy directly via `cd <repo>; hexa run anima-eeg/eeg_recorder.hexa --record --task resting_eyes_open --duration " + str(duration) + "`")
        exit(4)
    }

    // selftest mode
    println("== _paradigms/resting_baseline selftest (synth no-brainflow) ==")
    let args_kv = "duration_s=" + str(duration) + ",sample_rate_hz=" + str(sample_rate) +
                  ",channel_count=" + str(channels) + ",segment_s=" + str(segment)
    let kv = _paradigm_resting_baseline_kv(args_kv)
    print(kv)

    // verdict gate: selftest with defaults must PASS
    let lines = kv.split("\n")
    let mut found_pass = 0
    let mut k = 0
    while k < len(lines) {
        let ln = lines[k].trim()
        if ln == "verdict=PASS" { found_pass = 1 }
        k = k + 1
    }
    if found_pass == 0 {
        eprintln("reason: selftest verdict not PASS")
        exit(1)
    }
    println("selftest=ok")
    exit(0)
}
