// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/ai_cleaning_pipeline.hexa
//
//    Iterative artifact-cleaning pipeline:
//      Stage 1. invoke artifact_meta_classifier → composite verdict +
//               recommended_cleaning_chain.
//      Stage 2. apply suppressors per dominant artifact:
//               • EMI       → notch 50/60/120/180 Hz
//               • BLINK     → MAD-clip Fp1/Fp2 amplitude
//               • MOTION    → epoch reject (zero-fill global spike windows)
//               • EMG       → low-pass 30 Hz
//               • ECG       → low-pass 30 Hz (already covers cardiac
//                             reflection)
//               • REF_DRIFT → high-pass 0.5 Hz
//               • AGING     → drop suspect channels (zero-fill + flag)
//      Stage 3. emit cleaned .npy alongside input (suffix _aiclean.npy).
//      Stage 4. re-run meta_classifier on cleaned output → final quality.
//
//    Greedy single-pass cleaning chain. Cleaned signal is conservative —
//    admissible). No iterative ICA refit (deferred to future phase).
//
//    pre_quality  ← meta on input
//    post_quality ← meta on cleaned npy
//    pass = post_quality > pre_quality (improvement) ∧ post_quality ≥ 60
//
//    F1 white       → no cleaning needed; pre==post
//    F2 line60      → notch removes EMI; post > pre
//    F3 blink synth → clip removes spikes; post > pre
//    F4 motion synth→ epoch reject; post > pre
//    F5 drift       → HP filter removes; post > pre
//    F6 mixed       → composite cleaning chain applied
//
//  @resolver-bypass(reason="darwin-native: dispatches meta + scipy cleaning helper")
// ════════════════════════════════════════════════════════════════════════════

let HELPER  = "state/.aiclean_helper.py"
let DUMP    = "state/.aiclean_dump.txt"
let LEDGER  = "state/eeg_artifact_audit/2026_04_28_pipeline.jsonl"
let ART_DIR = "anima-eeg-core/tool/modules/_artifact"

fn env_str(k: string, d: string) -> string { let s = env(k); if s == "" { return d }; return s }
fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}
fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}
fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle); if m <= 0 { return 0 }; if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }; i = i + 1
    }
    return -1
}
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key); if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]; if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }; if neg == 1 { return -acc }; return acc
}
fn parse_str_after(blob: string, key: string) -> string {
    let kp = find_in_str(blob, key); if kp < 0 { return "" }
    let n = len(blob); let mut q = kp + len(key); let mut out = ""
    while q < n && blob[q] != "\n" { out = out + blob[q]; q = q + 1 }
    return out
}
fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn invoke_meta(mode_arg: string, src_arg: string) -> string {
    let hexa_lang = env("HEXA_LANG")
    let mut hexa_bin = "/Users/ghost/core/hexa-lang/hexa.real"
    if hexa_lang != "" { hexa_bin = hexa_lang + "/hexa.real" }
    let path = ART_DIR + "/artifact_meta_classifier.hexa"
    let mut flag = "--selftest-mode"
    if mode_arg == "real" { flag = "--input" }
    let cmd = hexa_bin + " run " + path + " -- " + flag + " \"" + src_arg + "\""
    let r = exec_with_status(cmd)
    return to_string(r[0])
}

fn write_helper() {
    let py = "#!/usr/bin/env python3
# ai_cleaning_pipeline helper — applies suppressor chain
import sys, os
try:
    import numpy as np
    from scipy import signal
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)
if len(sys.argv) < 6:
    sys.stderr.write('usage: helper <mode> <src> <fs> <chain> <out_npy>\\n'); sys.exit(2)
mode, src, fs_s, chain, out_npy = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
fs = float(fs_s)

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch')

if mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('selftest-mode-not-supported-for-pipeline-cleaning\\n'); sys.exit(5)

eeg = eeg.astype(np.float64).copy()
ops = []

# parse chain ('+' separated or '→' separated)
parts = chain.replace('→','+').split('+')
parts = [p.strip() for p in parts if p.strip() and p.strip() != 'NONE']

for op in parts:
    if op == 'EMI':
        # notch 60Hz (US) + 50Hz (intl) + harmonics 120/180
        for f0 in [50.0, 60.0, 120.0, 180.0]:
            if f0 >= fs/2 - 0.5: continue
            try:
                bn, an = signal.iirnotch(f0/(fs/2), Q=30.0)
                for ch in range(eeg.shape[0]):
                    eeg[ch] = signal.filtfilt(bn, an, eeg[ch])
            except Exception:
                pass
        ops.append('notch_50_60_120_180')
    elif op == 'BLINK':
        # MAD-clip Fp1, Fp2 (idx 0, 1)
        for ch in [0, 1]:
            x = eeg[ch]; med = np.median(x); mad = np.median(np.abs(x - med)) + 1e-9
            thr = 6.0 * 1.4826 * mad
            eeg[ch] = np.clip(x, med - thr, med + thr)
        ops.append('mad_clip_fp1_fp2')
    elif op == 'MOTION':
        # zero-fill epochs where ≥8 channels co-spike (using 5σ)
        sds = np.std(eeg, axis=1, keepdims=True) + 1e-9
        z = np.abs(eeg - np.mean(eeg, axis=1, keepdims=True)) / sds
        spikes = z > 5.0
        win = max(1, int(0.1 * fs))
        nb = eeg.shape[1] // win
        n_zero = 0
        for b in range(nb):
            s_ = b*win; e_ = (b+1)*win
            if int(np.sum(np.any(spikes[:, s_:e_], axis=1))) >= 8:
                eeg[:, s_:e_] = 0.0; n_zero += 1
        ops.append('epoch_reject_motion_n=' + str(n_zero))
    elif op == 'EMG' or op == 'ECG':
        # low-pass 30 Hz
        if 'lp30' not in ops:
            bl, al = signal.butter(4, 30.0/(fs/2), btype='low')
            for ch in range(eeg.shape[0]):
                eeg[ch] = signal.filtfilt(bl, al, eeg[ch])
            ops.append('lp30')
    elif op == 'REF_DRIFT':
        bh, ah = signal.butter(4, 0.5/(fs/2), btype='high')
        for ch in range(eeg.shape[0]):
            eeg[ch] = signal.filtfilt(bh, ah, eeg[ch])
        ops.append('hp_0.5')
    elif op == 'AGING':
        # zero-fill suspect channels (cross-ch z>3 RMS)
        rms = np.sqrt(np.mean(eeg*eeg, axis=1))
        med = np.median(rms); mad = np.median(np.abs(rms - med)) + 1e-9
        sigma = 1.4826 * mad
        n_drop = 0
        for ci in range(eeg.shape[0]):
            if sigma > 1e-9 and (rms[ci] - med) / sigma > 3.0:
                eeg[ci] = 0.0; n_drop += 1
        ops.append('drop_suspect_n=' + str(n_drop))

np.save(out_npy, eeg.astype(np.float32))
print('ops=' + ','.join(ops))
print('OK')
"
    write_file(HELPER, py)
}

fn run_cleaner(input_npy: string, fs_arg: int, chain: string, out_npy: string) -> string {
    write_helper(); let py = pick_python()
    let cmd = py + " " + HELPER + " real \"" + input_npy + "\" " + str(fs_arg) + " \"" + chain + "\" \"" + out_npy + "\""
    let r = exec_with_status(cmd); let rc = to_int(r[1])
    if rc != 0 { eprintln("aiclean-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return to_string(r[0])
}

fn run_pipeline(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    // Stage 1: pre-cleaning meta
    let meta_pre = invoke_meta(mode_arg, src_arg)
    let q_pre = parse_int_kv(meta_pre, "composite_quality_score=")
    let dom_pre = parse_str_after(meta_pre, "dominant_artifact_type=")
    let chain = parse_str_after(meta_pre, "recommended_cleaning_chain=")

    // Stage 2: clean (only in real mode — selftest synth re-uses meta)
    let mut out_npy = ""
    let mut ops_log = ""
    let mut q_post = q_pre; let mut dom_post = dom_pre
    if mode_arg == "real" && chain != "NONE" && chain != "" {
        // suffix _aiclean
        out_npy = src_arg.replace(".npy", "_aiclean.npy")
        let log = run_cleaner(src_arg, fs_arg, chain, out_npy)
        ops_log = log
        // Stage 4: post-cleaning meta on cleaned npy
        let meta_post = invoke_meta("real", out_npy)
        q_post = parse_int_kv(meta_post, "composite_quality_score=")
        dom_post = parse_str_after(meta_post, "dominant_artifact_type=")
    }

    let improved = if q_post > q_pre { 1 } else { 0 }
    let pass_flag = if (improved == 1 || chain == "NONE") && q_post >= 60 { 1 } else { 0 }

    let mut out = "module=ai_cleaning_pipeline\n"
    out = out + "ts=" + now_iso() + "\n"
    out = out + "mode=" + mode_arg + "\n"
    out = out + "input=" + src_arg + "\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "pre_quality=" + str(q_pre) + "\n"
    out = out + "post_quality=" + str(q_post) + "\n"
    out = out + "improvement=" + str(q_post - q_pre) + "\n"
    out = out + "dominant_pre=" + dom_pre + "\n"
    out = out + "dominant_post=" + dom_post + "\n"
    out = out + "cleaning_chain=" + chain + "\n"
    out = out + "cleaned_npy=" + out_npy + "\n"
    out = out + "ops_log=" + ops_log + "\n"

    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER); let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/pipeline\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"pre_quality\":" + str(q_pre) + ",\"post_quality\":" + str(q_post) + ",\"chain\":\"" + chain + "\",\"dominant_pre\":\"" + dom_pre + "\",\"dominant_post\":\"" + dom_post + "\",\"cleaned_npy\":\"" + out_npy + "\"}\n"
    write_file(LEDGER, existing + row)
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }; start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}
fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "white"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_pipeline(mode, src, fs_arg)
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
