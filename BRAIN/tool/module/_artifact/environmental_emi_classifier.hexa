// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/environmental_emi_classifier.hexa
//
//    Detect environmental EMI (50/60 Hz mains and harmonics 100/120/180 Hz,
//    plus laptop/phone/fluorescent narrowband leaks) per channel via FFT
//    Welch PSD peaks. Flags channel as EMI-contaminated when narrowband peak
//    ≥ EMI_DB_THRESHOLD above broadband floor. Outputs per-ch dB, dominant
//    freq, fingerprint (mains vs HF), and verdict ∈ {CLEAN, MILD, DOMINANT}.
//
//    UNSUPERVISED — no labelled training. Per-channel narrowband-peak vs
//    broadband-floor SNR thresholding (kNN-equivalent in PSD space).
//    Limitation: false-positive ~5% under brain-rhythm peak collision.
//    Manual spectrogram review recommended for borderline cases.
//
//    C1: peak_db_at(50/60) − floor_db ≥ 6 dB     → mains_present
//    C2: peak_db_at(harmonics) − floor ≥ 3 dB    → harmonic_chain
//    C3: max_peak_db ≥ 12 dB (DOMINANT)         → block downstream
//
//    F1 white noise           → CLEAN expected
//    F2 line50 (50 Hz mains)  → DOMINANT expected
//    F3 line60 (60 Hz US)     → DOMINANT expected
//    F4 alpha 10 Hz only      → CLEAN expected (no EMI band)
//    F5 harm120 (60+120 Hz)   → DOMINANT (chain) expected
//    F6 drift 0.05 Hz         → CLEAN (out of EMI band)
//
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host")
// ════════════════════════════════════════════════════════════════════════════

let EMI_DB_DOMINANT = 12
let EMI_DB_MILD     = 6
let HELPER = "state/.emi_classifier_helper.py"
let DUMP   = "state/.emi_classifier_dump.txt"
let LEDGER = "state/eeg_artifact_audit/2026_04_28_emi.jsonl"

fn env_str(k: string, d: string) -> string {
    let s = env(k)
    if s == "" { return d }
    return s
}

fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m } ; j = j + 1 }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn write_helper() {
    let py = "#!/usr/bin/env python3
import sys, os
try:
    import numpy as np
    from scipy import signal
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 5:
    sys.stderr.write('usage: helper <mode> <src> <fs> <out>\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch from ' + str(a.shape))

if mode == 'selftest':
    kind = src
    n = 30 * int(fs)
    rng = np.random.RandomState(42)
    eeg = rng.normal(0, 1.0, size=(16, n))
    t = np.arange(n) / fs
    if kind == 'line50':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*50.0*t)
    elif kind == 'line60':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*60.0*t)
    elif kind == 'harm120':
        for ch in range(16): eeg[ch] += 6.0*np.sin(2*np.pi*60.0*t) + 4.0*np.sin(2*np.pi*120.0*t)
    elif kind == 'alpha':
        for ch in [6, 7]: eeg[ch] += 5.0*np.sin(2*np.pi*10.0*t)
    elif kind == 'white':
        pass
    elif kind == 'drift':
        for ch in range(16): eeg[ch] += 50.0*np.sin(2*np.pi*0.05*t)
    else:
        sys.stderr.write('unknown kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('bad mode\\n'); sys.exit(2)

def emi_score_ch(x):
    f, psd = signal.welch(x, fs=fs, nperseg=min(512, len(x)))
    psd_db = 10.0 * np.log10(psd + 1e-30)
    # broadband floor: median of 1-40 Hz brain band
    bb = (f >= 1.0) & (f <= 40.0)
    floor = float(np.median(psd_db[bb])) if np.any(bb) else -120.0
    # narrowband targets
    targets = [50.0, 60.0, 100.0, 120.0, 180.0]
    peaks = {}
    max_excess = -1e9
    dominant_freq = 0.0
    for tg in targets:
        m = (f >= tg - 1.0) & (f <= tg + 1.0)
        if not np.any(m): continue
        pk = float(np.max(psd_db[m]))
        ex = pk - floor
        peaks[tg] = ex
        if ex > max_excess:
            max_excess = ex; dominant_freq = tg
    return max_excess, dominant_freq, floor, peaks

with open(out_path, 'w') as f:
    f.write('schema=emi_classifier_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    n_dominant = 0; n_mild = 0; n_clean = 0
    max_global = -1e9; freq_global = 0.0
    for ci in range(int(n_ch)):
        ex, df, fl, pks = emi_score_ch(eeg[ci, :])
        f.write('ch' + str(ci) + '_excess_db_x10=' + str(int(round(ex*10))) + '\\n')
        f.write('ch' + str(ci) + '_dominant_freq_x10=' + str(int(round(df*10))) + '\\n')
        if ex >= 12.0: n_dominant += 1
        elif ex >= 6.0: n_mild += 1
        else: n_clean += 1
        if ex > max_global: max_global = ex; freq_global = df
    f.write('n_dominant=' + str(n_dominant) + '\\n')
    f.write('n_mild=' + str(n_mild) + '\\n')
    f.write('n_clean=' + str(n_clean) + '\\n')
    f.write('max_excess_db_x10=' + str(int(round(max_global*10))) + '\\n')
    f.write('global_dominant_freq_x10=' + str(int(round(freq_global*10))) + '\\n')
print('OK')
"
    write_file(HELPER, py)
}

fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 { eprintln("emi-helper-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}

fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn emit_ledger(verdict: string, max_db: int, freq: int, n_dom: int, n_mild: int, mode_arg: string, src_arg: string) {
    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER)
    let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/emi\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"verdict\":\"" + verdict + "\",\"max_excess_db_x10\":" + str(max_db) + ",\"dominant_freq_x10\":" + str(freq) + ",\"n_dominant\":" + str(n_dom) + ",\"n_mild\":" + str(n_mild) + "}\n"
    write_file(LEDGER, existing + row)
}

fn run_emi_detector(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg)
    if blob == "" { return "" }
    let n_dom = parse_int_kv(blob, "n_dominant=")
    let n_mild = parse_int_kv(blob, "n_mild=")
    let max_db = parse_int_kv(blob, "max_excess_db_x10=")
    let freq = parse_int_kv(blob, "global_dominant_freq_x10=")
    let mut verdict = "CLEAN"
    if n_dom >= 1 { verdict = "DOMINANT" }
    else { if n_mild >= 1 { verdict = "MILD" } }
    let pass_flag = if verdict == "CLEAN" { 1 } else { 0 }
    let mut out = "module=emi_classifier\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "n_dominant=" + str(n_dom) + "\n"
    out = out + "n_mild=" + str(n_mild) + "\n"
    out = out + "max_excess_db_x10=" + str(max_db) + "\n"
    out = out + "global_dominant_freq_x10=" + str(freq) + "\n"
    emit_ledger(verdict, max_db, freq, n_dom, n_mild, mode_arg, src_arg)
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "line60"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_emi_detector(mode, src, fs_arg)
    if res == "" { eprintln("reason: emi-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
