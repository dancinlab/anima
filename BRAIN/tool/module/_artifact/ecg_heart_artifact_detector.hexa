// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_artifact/ecg_heart_artifact_detector.hexa
//
//    Detect ECG leak — periodic R-peak component at 1.0–1.7 Hz (60–100 BPM).
//    Cross-channel autocorrelation peak in cardiac period range; 1–3 Hz
//    band power dominance with periodic R-pattern. Pan-Tompkins-lite.
//
//    UNSUPERVISED — autocorrelation periodicity (proxy for ICA component).
//    Limitation: subject's actual heart rate can be < 60 or > 100 BPM
//    (athletes / arrhythmia); range conservative.
//
//    C1: autocorr peak in [0.6, 1.0] s lag        → cardiac period
//    C2: peak height > 0.3                        → strong ECG
//    C3: any channel C1∧C2                        → DOMINANT
//
//    F1 white       → CLEAN
//    F2 alpha       → CLEAN
//    F3 ecg synth   → DOMINANT
//    F4 line60      → CLEAN
//    F5 motion      → CLEAN (aperiodic)
//    F6 mild_ecg    → MILD
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python")
// ════════════════════════════════════════════════════════════════════════════

let HELPER = "state/.ecg_helper.py"
let DUMP   = "state/.ecg_dump.txt"
let LEDGER = "state/eeg_artifact_audit/2026_04_28_ecg.jsonl"

fn env_str(k: string, d: string) -> string { let s = env(k); if s == "" { return d }; return s }
fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}
fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}
fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle); if m <= 0 { return 0 }; if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }; i = i + 1
    }
    return -1
}
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key); if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]; if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }; if neg == 1 { return -acc }; return acc
}
fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn write_helper() {
    let py = "#!/usr/bin/env python3
import sys, os
try:
    import numpy as np
    from scipy import signal
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)
if len(sys.argv) < 5:
    sys.stderr.write('usage\\n'); sys.exit(2)
mode, src, fs_s, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fs = float(fs_s)
def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch')
if mode == 'selftest':
    kind = src; n = 60 * int(fs); rng = np.random.RandomState(42)
    eeg = rng.normal(0, 5.0, size=(16, n))
    t = np.arange(n) / fs
    if kind == 'ecg':
        # 72 BPM = 1.2 Hz; QRS-like spikes
        rr = 60.0 / 72.0
        for k in range(int(60.0/rr)):
            i0 = int(k*rr*fs); w = int(0.05*fs)
            for ch in range(16):
                if i0 + w <= n: eeg[ch, i0:i0+w] += 50.0 * np.hanning(w)
    elif kind == 'mild_ecg':
        rr = 60.0 / 72.0
        for k in range(int(60.0/rr)):
            i0 = int(k*rr*fs); w = int(0.05*fs)
            for ch in [10, 11]:
                if i0 + w <= n: eeg[ch, i0:i0+w] += 50.0 * np.hanning(w)
    elif kind == 'alpha':
        for ch in [6, 7]: eeg[ch] += 8.0 * np.sin(2*np.pi*10.0*t)
    elif kind == 'line60':
        for ch in range(16): eeg[ch] += 8.0 * np.sin(2*np.pi*60.0*t)
    elif kind == 'motion':
        for k in range(10):
            i0 = int((k*5+1)*fs); w = int(0.1*fs)
            for ch in range(16): eeg[ch, i0:i0+w] += 200.0 * np.sign(rng.randn()) * np.hanning(w)
    elif kind == 'white':
        pass
    else:
        sys.stderr.write('unknown\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src): sys.stderr.write('not-found\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('bad mode\\n'); sys.exit(2)

# bandpass 1–3 Hz, then autocorr; look for peak in lag 0.6–1.0 s
b, a_ = signal.butter(4, [1.0/(fs/2), 3.0/(fs/2)], btype='band')
def autocorr_peak(x):
    xf = signal.filtfilt(b, a_, x)
    xf = xf - np.mean(xf)
    if np.std(xf) < 1e-9: return 0.0, 0.0
    xf = xf / (np.std(xf) + 1e-12)
    lo = int(0.6 * fs); hi = int(1.0 * fs)
    if hi >= len(xf): return 0.0, 0.0
    ac = np.correlate(xf, xf, mode='full')
    mid = len(ac) // 2
    seg = ac[mid+lo:mid+hi] / (len(xf))
    if len(seg) == 0: return 0.0, 0.0
    pi = int(np.argmax(seg))
    pk = float(seg[pi])
    lag_s = (lo + pi) / fs
    return pk, lag_s

n_ecg = 0; max_pk = 0.0; max_lag = 0.0
for ci in range(int(n_ch)):
    pk, lag = autocorr_peak(eeg[ci])
    if pk > 0.3 and 0.6 <= lag <= 1.0:
        n_ecg += 1
        if pk > max_pk: max_pk = pk; max_lag = lag

with open(out_path, 'w') as f:
    f.write('schema=ecg_artifact_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('n_ecg_channels=' + str(n_ecg) + '\\n')
    f.write('max_autocorr_x100=' + str(int(round(max_pk*100))) + '\\n')
    f.write('max_lag_ms=' + str(int(round(max_lag*1000))) + '\\n')
    if max_lag > 0:
        bpm = 60.0 / max_lag
        f.write('estimated_bpm_x10=' + str(int(round(bpm*10))) + '\\n')
    else:
        f.write('estimated_bpm_x10=0\\n')
print('OK')
"
    write_file(HELPER, py)
}
fn run_helper(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    write_helper(); let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" " + str(fs_arg) + " \"" + DUMP + "\""
    let r = exec_with_status(cmd); let rc = to_int(r[1])
    if rc != 0 { eprintln("ecg-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}
fn emit_ledger(verdict: string, n_ecg: int, max_pk: int, bpm: int, mode_arg: string, src_arg: string) {
    exec("mkdir -p state/eeg_artifact_audit")
    let prior = read_file(LEDGER); let mut existing = ""
    if prior != "" { existing = prior }
    let row = "{\"ts\":\"" + now_iso() + "\",\"tool\":\"_artifact/ecg\",\"mode\":\"" + mode_arg + "\",\"input\":\"" + src_arg + "\",\"verdict\":\"" + verdict + "\",\"n_ecg_channels\":" + str(n_ecg) + ",\"max_autocorr_x100\":" + str(max_pk) + ",\"bpm_x10\":" + str(bpm) + "}\n"
    write_file(LEDGER, existing + row)
}
fn run_ecg_detector(mode_arg: string, src_arg: string, fs_arg: int) -> string {
    let blob = run_helper(mode_arg, src_arg, fs_arg); if blob == "" { return "" }
    let n_ecg = parse_int_kv(blob, "n_ecg_channels=")
    let max_pk = parse_int_kv(blob, "max_autocorr_x100=")
    let bpm = parse_int_kv(blob, "estimated_bpm_x10=")
    let mut verdict = "CLEAN"
    if n_ecg >= 4 { verdict = "DOMINANT" }
    else { if n_ecg >= 1 { verdict = "MILD" } }
    let pass_flag = if verdict == "CLEAN" { 1 } else { 0 }
    let mut out = "module=ecg_heart_artifact_detector\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "n_ecg_channels=" + str(n_ecg) + "\n"
    out = out + "max_autocorr_x100=" + str(max_pk) + "\n"
    out = out + "estimated_bpm_x10=" + str(bpm) + "\n"
    emit_ledger(verdict, n_ecg, max_pk, bpm, mode_arg, src_arg)
    return out
}
fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }; start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}
fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "ecg"; let mut fs_arg = 125
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        if a == "--fs" { fs_arg = to_int(av[i+1]); i = i + 2; continue }
        i = i + 1
    }
    let res = run_ecg_detector(mode, src, fs_arg)
    if res == "" { eprintln("reason: ecg-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
