// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_metrics/lz76_native.hexa  (Phase 5a kick-off)
//
//  PURPOSE
//    Pure-native PORT of the Lempel-Ziv 1976 (Kaspar-Schuster 1987 production-
//    count) numeric core from the frozen legacy verifier
//    `anima-clm-eeg/tool/clm_eeg_lz76_real.hexa` (commit ef3efeb09 frozen,
//    1055 LoC). This module re-implements the numeric kernel directly in
//    hexa — NO `hexa.real run <LEGACY>` dispatch, NO subprocess to legacy.
//
//    Phase 5 port spec (commit 64acf23b9) §1 metric pair: lz76 / pe / hjorth
//    / gamma_theta. This file ships the lz76 (smallest backend, ~535L core)
//
//    DECISION: PORT (full numeric core, native).
//      • A3 Phase 1 audit (commit 867392918) verified WRAP/legacy semantic-
//        identical numeric (39/1218 selftest match) → algorithm is stable
//        and frozen, no further drift risk from legacy.
//      • Phase 5 port spec mandates 4 metrics ported. lz76 is the smallest
//        numeric core — start here for the smallest blast radius.
//      • Native PORT removes the per-call hexa.real subprocess (cycle-time
//        / determinism win for the dispatcher in eeg_core.hexa).
//      • lz76.hexa (WRAP) stays UNTOUCHED as the verification base — this
//        new module is byte-identity-validated against it during selftest.
//
//  ALGORITHM (mirror of legacy clm_eeg_lz76_real.hexa numeric core)
//    1. Synthesize OR ingest 16-channel sample stream (per-channel int list,
//       channels-major flat layout: flat[ci*n_samp + s]).
//       • selftest random:     synth_channel()           (FNV-1a 32-bit mix)
//       • selftest structured: synth_channel_structured() (period=64 square)
//       • --input <npy>:       load via /tmp helper into flat int list
//    2. Per-channel median binarization (rank-by-counting on a slice of the
//       flat list — no per-channel allocation; matches median_slice).
//    3. Concatenate the 16 binary streams in channel-major order →
//       single 0/1 int list of length n_total = n_ch · n_samp.
//    4. Classical Kaspar-Schuster 1987 LZ76 production count c(n).
//    5. Normalize: b(n) = c(n) · log2(n) / n  (×1000 fixed-point).
//
//    Byte-identity contract with WRAP wrapper:
//      For the same fixture (synth_channel + n_ch=16, n_samp=16, default
//      "random" mode), c_n and b_n_x1000 MUST equal the WRAP wrapper's
//      legacy backend output. Selftest cross-validates this with
//      `hexa.real run <WRAP>` and parses c(n) / b(n)_x1000 from stdout.
//
//  API
//    _metric_lz76_native_kv(npy_path: string, sidecar_kv: string,
//                           threshold_mode: string) -> string
//      threshold_mode ∈ {"median", "zero"}.
//        "median" (default) = legacy behaviour (per-channel median).
//        "zero"   = simple sign-bit binarization (above 0 → 1; for fixtures
//                   already centered at 0). Reserved for future centred-
//                   stream inputs; selftest defaults to "median".
//      Returns kv-block:
//        schema=anima-eeg-core/_metrics/lz76_native/1
//        metric=lz76_native
//        npy_path=<path>
//        threshold_mode=<median|zero>
//        n_ch=<int>
//        n_samp=<int>
//        n_total=<int>
//        c_n=<int>                       (production count)
//        lz76_norm_x1000=<int>           (b(n) = c·log2(n)/n × 1000)
//        b_n_x1000=<int>                 (alias)
//        verdict=<PASS|FAIL|FALSIFIED>
//        backend=in_module_native_lz76
//        raw71_falsifier_count=3
//        raw71_triggered_ids=<csv>
//        raw91_evidence=native_kaspar_schuster_1987_port_of_legacy
//        raw91_limit=median_binarisation_finite_length_bias_n_lt_120k
//
//  RAW#71 FALSIFIERS (≥3 preregister, frozen 2026-05-02 — mirror lz76.hexa)
//    F_LZN_01: c_n <= 1                  → algorithm-broken (degenerate)
//    F_LZN_02: lz76_norm_x1000 < 100      → catastrophic structure (sub-sine)
//    F_LZN_03: lz76_norm_x1000 > 1500     → impossible LZc (>1.5; KS-87 bound)
//
//  CLI
//    hexa run lz76_native.hexa --selftest
//    hexa run lz76_native.hexa --selftest --selftest-mode {random|structured}
//    hexa run lz76_native.hexa --input <npy_path> [--sidecar k=v,k=v]
//                                                 [--threshold-mode median|zero]
//    hexa run lz76_native.hexa --selftest --cross-validate
//        ↑ runs WRAP wrapper (anima-eeg-core/.../lz76.hexa --selftest) too
//          and asserts byte-identical c_n + b_n_x1000.
//
//    L1: pe / hjorth / gamma_theta NOT ported in this cycle (Phase 5a single-
//        file kick-off). Phase 5b/c/d will follow same template.
//    L2: scipy/numpy dependency NOT applicable for lz76 (pure integer + bit
//        algorithm; no FFT / no welch). For pe/hjorth/gamma_theta the same
//        scipy isolation question reappears.
//    L3: byte-identity vs WRAP requires the WRAP wrapper to run successfully
//        (legacy backend reachable, .venv-eeg present). On hosts without
//        .venv-eeg the cross-validate step degrades to "skipped" (NOT a fake
//
//
//  @resolver-bypass(reason="darwin-native: optional npy path requires .venv-eeg numpy")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima-eeg-core/_metrics/lz76_native/1"
let METRIC_NAME  = "lz76_native"

let F_LZN_01_CN_MIN          = 1        // c_n must be > 1
let F_LZN_02_NORM_LO_X1000   = 100
let F_LZN_03_NORM_HI_X1000   = 1500

// helper transient artefacts (state/.* convention; matches legacy conventions)
let LZN_NPY_HELPER_PATH = "state/.lz76_native_npy_helper.py"
let LZN_NPY_DUMP_PATH   = "state/.lz76_native_npy_dump.txt"

// path of the WRAP wrapper for cross-validate selftest mode
let LZ76_WRAP_PATH = "anima-eeg-core/tool/modules/_metrics/lz76.hexa"

// ─── env + shell helpers ───────────────────────────────────────────────

fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

// ─── digit / string helpers (mirror lz76.hexa shape) ───────────────────

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

// extract the integer at the END of the line containing the marker.
// Mirrors lz76.hexa::parse_int_after_marker for cross-validate parsing of
// the WRAP wrapper's stdout ("c(n) productions = N", "b(n)_x1000 = N").
fn parse_int_after_marker(blob: string, marker: string) -> int {
    let p = find_in_str(blob, marker)
    if p < 0 { return -2147483647 }
    let n = len(blob)
    let mut eol = p + len(marker)
    while eol < n && blob[eol] != "\n" { eol = eol + 1 }
    let mut k = eol - 1
    let mut digits_end = -1
    while k >= 0 {
        let c = blob[k]
        if is_digit_ch(c) == 1 { digits_end = k; break }
        if c == " " || c == "\t" || c == "\r" { k = k - 1; continue }
        return -2147483647
    }
    if digits_end < 0 { return -2147483647 }
    let mut digits_start = digits_end
    while digits_start > 0 {
        let c = blob[digits_start - 1]
        if is_digit_ch(c) == 1 { digits_start = digits_start - 1 }
        else { break }
    }
    let mut neg = 0
    if digits_start > 0 { if blob[digits_start - 1] == "-" { neg = 1 } }
    let mut acc = 0
    let mut q = digits_start
    while q <= digits_end {
        acc = acc * 10 + digit_val(blob[q])
        q = q + 1
    }
    if neg == 1 { return -acc }
    return acc
}

// ─── log2(n)·1000 fixed-point (PORT of legacy log2_x1000) ──────────────
//
// Identical algorithm: bit-length floor + linear interpolation between the
// nearest power-of-two boundaries. Required so b_n_x1000 matches WRAP byte-
// for-byte.
fn log2_x1000(n: int) -> int {
    if n <= 1 { return 0 }
    let mut bl = 0
    let mut v = n
    while v > 0 {
        bl = bl + 1
        v = v / 2
    }
    let floor_l = bl - 1
    let mut lower = 1
    let mut k = 0
    while k < floor_l {
        lower = lower * 2
        k = k + 1
    }
    let upper = lower * 2
    let frac = ((n - lower) * 1000) / (upper - lower)
    return floor_l * 1000 + frac
}

// ─── median (PORT of legacy median_slice; rank-by-counting, no helper) ──
//
// Returns rank-⌊n/2⌋ value in xs[base..base+n). Channels-major flat layout:
// xs[ci*n_samp + s]. Algorithm is byte-equivalent to legacy median_slice
// — same tie-break behaviour (first scanned candidate satisfying
// lt <= target < le wins).
fn median_slice(xs: list, base: int, n: int) -> int {
    if n <= 0 { return 0 }
    if n == 1 { return xs[base] }
    let target_rank = n / 2
    let mut best = xs[base]
    let mut i = 0
    while i < n {
        let v = xs[base + i]
        let mut lt = 0
        let mut le = 0
        let mut j = 0
        while j < n {
            let w = xs[base + j]
            if w < v { lt = lt + 1 }
            if w <= v { le = le + 1 }
            j = j + 1
        }
        if lt <= target_rank {
            if target_rank < le {
                best = v
                i = n
            }
        }
        i = i + 1
    }
    return best
}

// ─── classical LZ76 (PORT of legacy lz76_count; Kaspar-Schuster 1987) ──
//
// s : list of 0/1 ints, length n.  Returns c(n) = production count.
// Identical control-flow to legacy lz76_count — same i/k/k_max/done state
// machine. Required for byte-identity vs WRAP wrapper.
fn lz76_count(s: list, n: int) -> int {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    let mut c = 1
    let mut l = 1
    let mut i = 0
    let mut k = 1
    let mut k_max = 1
    let mut done = 0
    while done == 0 {
        if l + k > n { done = 1 }
        else {
            if s[i + k - 1] == s[l + k - 1] {
                k = k + 1
                if l + k > n {
                    c = c + 1
                    done = 1
                }
            } else {
                if k > k_max { k_max = k }
                i = i + 1
                if i == l {
                    c = c + 1
                    l = l + k_max
                    if l + 1 > n { done = 1 }
                    else {
                        i = 0
                        k = 1
                        k_max = 1
                    }
                } else {
                    k = 1
                }
            }
        }
    }
    return c
}

// b(n) = c(n) · log2(n) / n, ×1000 fixed-point (== lz_norm_x1000).
fn b_n_x1000(c_n: int, bin_len: int) -> int {
    if bin_len <= 0 { return 0 }
    let logn_x1000 = log2_x1000(bin_len)
    return (c_n * logn_x1000) / bin_len
}

// ─── synthetic deterministic stream (PORT of legacy synth_channel) ─────
//
// Channel c uses seed derived from FNV constant 2654435761 so the synthetic
// "voltage-like" amplitude in [0..1023] for median binarization.
fn synth_channel(ch: int, n_samples: int) -> list {
    let mut out = []
    let mut h = 2166136261 + ch * 2654435761
    let mut i = 0
    while i < n_samples {
        h = (h * 16777619) + (i + 1) * 2654435761
        h = h % 2147483647
        if h < 0 { h = h + 2147483647 }
        out.push(h % 1024)
        i = i + 1
    }
    return out
}

// "structured" mode: short repeating period → low LZ76. Period is ~64
// samples. Channel offset shifts the phase. (PORT of legacy
// synth_channel_structured.)
fn synth_channel_structured(ch: int, n_samples: int) -> list {
    let mut out = []
    let period = 64
    let mut i = 0
    while i < n_samples {
        let phase = (i + ch * 4) % period
        if phase < period / 2 { out.push(900) } else { out.push(100) }
        i = i + 1
    }
    return out
}

//
// Emits the same plain-text dump layout legacy uses:
//   line 1: "n_ch=<int>"
//   line 2: "n_samp=<int>"
//   line 3+: one int per line, channel-major (ch0_s0 .. chN_sM)
// Floats × 1e6 then rounded to int (median is monotone-invariant under
// positive scaling, so rounding does not affect the verdict).
fn _write_npy_helper() {
    let py = "#!/usr/bin/env python3
# anima-eeg-core/_metrics/lz76_native .npy -> flat int dump.
import sys, os
try:
    import numpy as np
except ImportError:
    sys.stderr.write('numpy not installed in invoking python\\n'); sys.exit(10)
if len(sys.argv) < 3:
    sys.stderr.write('usage: helper <in.npy> <out.txt>\\n'); sys.exit(2)
in_path, out_path = sys.argv[1], sys.argv[2]
if not os.path.isfile(in_path):
    sys.stderr.write('input not found: ' + in_path + '\\n'); sys.exit(3)
arr = np.load(in_path, allow_pickle=False)
if arr.ndim != 2:
    sys.stderr.write('expected 2-D array, got ndim=' + str(arr.ndim) + '\\n'); sys.exit(4)
rows, cols = arr.shape
if rows == 16:
    n_ch, n_samp = rows, cols
    chmajor = arr
elif cols == 16:
    n_ch, n_samp = cols, rows
    chmajor = arr.T
elif rows >= 32 and cols > rows:
    n_ch, n_samp = 16, cols
    chmajor = arr[1:17, :]
elif cols >= 32 and rows > cols:
    n_ch, n_samp = 16, rows
    chmajor = arr.T[1:17, :]
else:
    sys.stderr.write('cannot infer 16ch layout from shape ' + str(arr.shape) + '\\n'); sys.exit(5)
scaled = np.rint(np.asarray(chmajor, dtype=np.float64) * 1.0e6).astype(np.int64)
with open(out_path, 'w') as f:
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    flat = scaled.reshape(-1)
    f.write('\\n'.join(str(int(v)) for v in flat))
    f.write('\\n')
print('OK n_ch=' + str(int(n_ch)) + ' n_samp=' + str(int(n_samp)))
"
    write_file(LZN_NPY_HELPER_PATH, py)
}

fn _pick_python() -> string {
    let envp = env_str("CLM_EEG_LZ76_PYTHON", "")
    if envp != "" { return envp }
    let envp2 = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp2 != "" { return envp2 }
    let venv_rel = ".venv-eeg/bin/python"
    let chk_rel = exec("test -x \"" + venv_rel + "\" && echo OK").trim()
    if chk_rel == "OK" { return venv_rel }
    let cwd = exec("pwd").trim()
    let venv_abs = cwd + "/.venv-eeg/bin/python"
    let chk_abs = exec("test -x \"" + venv_abs + "\" && echo OK").trim()
    if chk_abs == "OK" { return venv_abs }
    let candidates = [
        "/opt/homebrew/bin/python3",
        "/usr/bin/python3"
    ]
    let mut k = 0
    while k < len(candidates) {
        let c = candidates[k]
        let ok = exec("test -x \"" + c + "\" && echo OK").trim()
        if ok == "OK" { return c }
        k = k + 1
    }
    return "/usr/bin/python3"
}

// Returns sentinel list: ret[0]=n_ch, ret[1]=n_samp,
// ret[2..2+total)=samples (chmajor int).
fn _load_npy_via_helper(npy_path: string) -> list {
    _write_npy_helper()
    let py = _pick_python()
    let cmd = py + " " + LZN_NPY_HELPER_PATH + " " + _sh_quote(npy_path) + " " + _sh_quote(LZN_NPY_DUMP_PATH)
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    let mut ret = []
    if rc != 0 {
        eprintln("[_metrics/lz76_native] npy-helper-rc=" + str(rc))
        eprintln("[_metrics/lz76_native] npy-helper-out: " + to_string(r[0]))
        ret.push(-1); ret.push(-1)
        return ret
    }
    let blob = read_file(LZN_NPY_DUMP_PATH)
    let n = len(blob)
    let mut n_ch = 0
    let mut n_samp = 0
    let kc = find_in_str(blob, "n_ch=")
    if kc >= 0 {
        let mut q = kc + 5; let mut acc = 0; let mut hd = 0
        while q < n && blob[q] != "\n" {
            if is_digit_ch(blob[q]) == 1 { acc = acc * 10 + digit_val(blob[q]); hd = 1 }
            q = q + 1
        }
        if hd == 1 { n_ch = acc }
    }
    let ks = find_in_str(blob, "n_samp=")
    if ks >= 0 {
        let mut q = ks + 7; let mut acc = 0; let mut hd = 0
        while q < n && blob[q] != "\n" {
            if is_digit_ch(blob[q]) == 1 { acc = acc * 10 + digit_val(blob[q]); hd = 1 }
            q = q + 1
        }
        if hd == 1 { n_samp = acc }
    }
    ret.push(n_ch); ret.push(n_samp)
    if n_ch <= 0 || n_samp <= 0 { return ret }
    // skip past 2nd newline (after n_samp= line)
    let mut after_header = 0
    let mut nl = 0
    let mut p = 0
    while p < n {
        if blob[p] == "\n" {
            nl = nl + 1
            if nl == 2 { after_header = p + 1; p = n }
        }
        p = p + 1
    }
    let total = n_ch * n_samp
    let mut got = 0
    let mut q = after_header
    let mut acc = 0
    let mut neg = 0
    let mut hd = 0
    while q < n && got < total {
        let c = blob[q]
        if c == "\n" {
            if hd == 1 {
                let v = if neg == 1 { -acc } else { acc }
                ret.push(v)
                got = got + 1
                acc = 0; neg = 0; hd = 0
            }
            q = q + 1
        } else {
            if c == "-" && hd == 0 { neg = 1; q = q + 1 }
            else {
                if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1; q = q + 1 }
                else { q = q + 1 }
            }
        }
    }
    if hd == 1 && got < total {
        let v = if neg == 1 { -acc } else { acc }
        ret.push(v)
    }
    return ret
}

// ─── public API ────────────────────────────────────────────────────────

// Build a flat channels-major int list of 16ch × n_samp deterministic
// synthetic samples in the requested mode.
fn _synth_flat(mode: string, n_ch: int, n_samp: int) -> list {
    let mut flat = []
    let mut c = 0
    while c < n_ch {
        let mut ch = []
        if mode == "structured" { ch = synth_channel_structured(c, n_samp) }
        else                    { ch = synth_channel(c, n_samp) }
        let mut s = 0
        while s < n_samp {
            flat.push(ch[s])
            s = s + 1
        }
        c = c + 1
    }
    return flat
}

// Binarize a flat channels-major int list per-channel by `threshold_mode`.
// Returns flat 0/1 int list, same length n_ch * n_samp.
fn _binarize_flat(flat: list, n_ch: int, n_samp: int, threshold_mode: string) -> list {
    let mut bin_stream = []
    let mut ci = 0
    while ci < n_ch {
        let base = ci * n_samp
        let mut thr = 0
        if threshold_mode == "zero" {
            thr = 0
        } else {
            // default = "median"
            thr = median_slice(flat, base, n_samp)
        }
        let mut s = 0
        while s < n_samp {
            let v = flat[base + s]
            if v >= thr { bin_stream.push(1) } else { bin_stream.push(0) }
            s = s + 1
        }
        ci = ci + 1
    }
    return bin_stream
}

// Compute (c_n, b_n_x1000) on a synthetic 16ch × n_samp fixture deterministic
// in the requested mode. Pure native — no subprocess.
fn _native_compute_synthetic(mode: string, n_ch: int, n_samp: int,
                             threshold_mode: string) -> list {
    let flat = _synth_flat(mode, n_ch, n_samp)
    let bin_stream = _binarize_flat(flat, n_ch, n_samp, threshold_mode)
    let bin_len = n_ch * n_samp
    let c_n = lz76_count(bin_stream, bin_len)
    let bnx = b_n_x1000(c_n, bin_len)
    let mut r = []
    r.push(c_n); r.push(bnx); r.push(bin_len)
    return r
}

fn _metric_lz76_native_kv(npy_path: string, sidecar_kv: string,
                          threshold_mode: string) -> string {
    let mut tmode = threshold_mode
    if tmode != "median" && tmode != "zero" { tmode = "median" }

    let mut n_ch = 0
    let mut n_samp = 0
    let mut flat = []
    let mut backend = "in_module_native_lz76"

    if npy_path != "" {
        let parsed = _load_npy_via_helper(npy_path)
        n_ch = to_int(parsed[0])
        n_samp = to_int(parsed[1])
        if n_ch > 0 && n_samp > 0 {
            let total = n_ch * n_samp
            let mut k = 0
            while k < total {
                flat.push(to_int(parsed[2 + k]))
                k = k + 1
            }
        }
    } else {
        // selftest-equivalent fixture: 16ch × 16 samples (matches legacy
        // selftest defaults so byte-identity vs WRAP wrapper is meaningful).
        n_ch = 16
        n_samp = 16
        flat = _synth_flat("random", n_ch, n_samp)
        backend = "in_module_native_lz76_selftest_random"
    }

    let mut c_n = -2147483647
    let mut lz_norm = -2147483647
    if n_ch > 0 && n_samp > 0 {
        let bin_stream = _binarize_flat(flat, n_ch, n_samp, tmode)
        let bin_len = n_ch * n_samp
        c_n = lz76_count(bin_stream, bin_len)
        lz_norm = b_n_x1000(c_n, bin_len)
    }

    let mut triggered = ""
    let mut trig_count = 0
    if c_n != -2147483647 {
        if c_n <= F_LZN_01_CN_MIN { triggered = triggered + "F_LZN_01,"; trig_count = trig_count + 1 }
    }
    if lz_norm != -2147483647 {
        if lz_norm < F_LZN_02_NORM_LO_X1000 { triggered = triggered + "F_LZN_02,"; trig_count = trig_count + 1 }
        if lz_norm > F_LZN_03_NORM_HI_X1000 { triggered = triggered + "F_LZN_03,"; trig_count = trig_count + 1 }
    }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "FAIL"
    if c_n != -2147483647 && trig_count == 0 { verdict = "PASS" }
    if trig_count > 0 { verdict = "FALSIFIED" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "metric=" + METRIC_NAME + "\n"
    kv = kv + "npy_path=" + npy_path + "\n"
    kv = kv + "sidecar_kv=" + sidecar_kv + "\n"
    kv = kv + "threshold_mode=" + tmode + "\n"
    kv = kv + "n_ch=" + str(n_ch) + "\n"
    kv = kv + "n_samp=" + str(n_samp) + "\n"
    kv = kv + "n_total=" + str(n_ch * n_samp) + "\n"
    kv = kv + "c_n=" + str(c_n) + "\n"
    kv = kv + "lz76_norm_x1000=" + str(lz_norm) + "\n"
    kv = kv + "b_n_x1000=" + str(lz_norm) + "\n"
    kv = kv + "value_x1000=" + str(lz_norm) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "backend=" + backend + "\n"
    kv = kv + "raw71_falsifier_count=3\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=native_kaspar_schuster_1987_port_of_legacy\n"
    kv = kv + "raw91_limit=median_binarisation_finite_length_bias_n_lt_120k\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run lz76_native.hexa --selftest")
    eprintln("       hexa run lz76_native.hexa --selftest --selftest-mode {random|structured}")
    eprintln("       hexa run lz76_native.hexa --selftest --cross-validate")
    eprintln("       hexa run lz76_native.hexa --input <npy> [--threshold-mode median|zero]")
}

// ─── selftest ───────────────────────────────────────────────────────────
//
// Three native invariants + one optional cross-validation:
//   1. random ordering   : c_random > c_structured   (Kaspar-Schuster 1987)
//   4. (cross-validate)  : c_n / b_n_x1000 byte-identical to WRAP wrapper
//                          legacy backend output. Skipped (not failed) if
//                          WRAP wrapper exits non-zero (e.g. .venv-eeg

fn _selftest_native_only(n_ch: int, n_samp: int) -> int {
    println("[selftest] native-only: 16ch × " + str(n_samp) + " synthetic fixture (median binarization)")
    let r_rand   = _native_compute_synthetic("random",     n_ch, n_samp, "median")
    let r_struct = _native_compute_synthetic("structured", n_ch, n_samp, "median")
    let c_rand   = r_rand[0];   let b_rand   = r_rand[1];   let bl_rand   = r_rand[2]
    let c_struct = r_struct[0]; let b_struct = r_struct[1]; let bl_struct = r_struct[2]
    println("[selftest] random:     n_total = " + str(bl_rand)   + "  c_n = " + str(c_rand)   + "  b_x1000 = " + str(b_rand))
    println("[selftest] structured: n_total = " + str(bl_struct) + "  c_n = " + str(c_struct) + "  b_x1000 = " + str(b_struct))

    if c_rand <= c_struct {
        eprintln("FAIL: ordering — c_random (" + str(c_rand) + ") <= c_structured (" + str(c_struct) + ")")
        return 1
    }
    println("[selftest] ordering OK: c_random > c_structured")

    let r_rand_2 = _native_compute_synthetic("random", n_ch, n_samp, "median")

    if b_rand < F_LZN_02_NORM_LO_X1000 {
        eprintln("FAIL: random fixture under F_LZN_02 floor (" + str(b_rand) + " < " + str(F_LZN_02_NORM_LO_X1000) + ")")
        return 1
    }
    return 0
}

// Cross-validate vs WRAP wrapper:
//   Run `hexa.real run anima-eeg-core/.../lz76.hexa --selftest`.
//   The WRAP wrapper internally invokes the legacy backend in --selftest
//   mode (synth_channel + n_ch=16 / n_samp=16, "random") and emits a kv-
//   block on stdout that begins with:
//       schema=anima-eeg-core/_metrics/lz76/1
//       metric=lz76
//       npy_path=
//       sidecar_kv=
//       c_n=N
//       lz76_norm_x1000=N
//   We parse those two kv-keys and compare against our native (mode="random",
//   threshold_mode="median", n_ch=16, n_samp=16) result. Any mismatch
fn _selftest_cross_validate() -> int {
    println("[selftest] cross-validate vs WRAP wrapper (" + LZ76_WRAP_PATH + ")")
    let cmd = _hexa_bin() + " run " + LZ76_WRAP_PATH + " --selftest"
    let r = exec_with_status(cmd)
    let out = to_string(r[0])
    let rc = to_int(r[1])
    if rc != 0 {
        eprintln("[selftest] reason: legacy backend likely unreachable on this host (.venv-eeg / hexa runtime)")
        eprintln("[selftest] (this is NOT a fake PASS — we report skipped, not byte-identical)")
        return 2  // sentinel = skipped, not failure
    }
    // WRAP kv-block markers (stdout is the kv-block; parse by key=).
    let wrap_c_n     = parse_int_after_marker(out, "c_n=")
    let wrap_b_x1000 = parse_int_after_marker(out, "lz76_norm_x1000=")
    if wrap_c_n == -2147483647 || wrap_b_x1000 == -2147483647 {
        eprintln("[selftest] cross-validate FAIL: could not parse c_n / b_n_x1000 from WRAP stdout")
        eprintln("--- WRAP stdout (first 800 chars) ---")
        let head = if len(out) > 800 { out.substring(0, 800) } else { out }
        eprintln(head)
        return 1
    }
    let r_native = _native_compute_synthetic("random", 16, 16, "median")
    let nat_c_n = r_native[0]
    let nat_b_x1000 = r_native[1]
    println("[selftest] WRAP   c_n = " + str(wrap_c_n)   + "  b_x1000 = " + str(wrap_b_x1000))
    println("[selftest] NATIVE c_n = " + str(nat_c_n)    + "  b_x1000 = " + str(nat_b_x1000))
    if nat_c_n != wrap_c_n {
        eprintln("FAIL: cross-validate c_n mismatch (native=" + str(nat_c_n) + " vs wrap=" + str(wrap_c_n) + ")")
        return 1
    }
    if nat_b_x1000 != wrap_b_x1000 {
        eprintln("FAIL: cross-validate b_n_x1000 mismatch (native=" + str(nat_b_x1000) + " vs wrap=" + str(wrap_b_x1000) + ")")
        return 1
    }
    println("[selftest] cross-validate OK: byte-identical (c_n + b_n_x1000) vs WRAP wrapper")
    return 0
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut selftest_mode = "random"
    let mut cross_validate = false
    let mut input = ""
    let mut sidecar = ""
    let mut threshold_mode = "median"
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"        { selftest = true; i = i + 1; continue }
        if a == "--selftest-mode"   { selftest_mode = av[i+1]; i = i + 2; continue }
        if a == "--cross-validate"  { cross_validate = true; i = i + 1; continue }
        if a == "--input"           { input = av[i+1]; i = i + 2; continue }
        if a == "--sidecar"         { sidecar = av[i+1]; i = i + 2; continue }
        if a == "--threshold-mode"  { threshold_mode = av[i+1]; i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if selftest {
        let n_ch = 16
        // Default selftest fixture matches legacy: 16ch × 16 samp = 256 bits.
        // Big enough for the random vs structured ordering to dominate; small
        // enough to keep wall time bounded under the legacy O(n²) kernel.
        let n_samp = 16
        let rc1 = _selftest_native_only(n_ch, n_samp)
        if rc1 != 0 { eprintln("selftest=fail (native)"); exit(1) }

        // Optional: explicit single-mode invocation (random | structured) —
        // emits the per-mode kv-block so operators can grep one line per run.
        if selftest_mode == "structured" {
            let r = _native_compute_synthetic("structured", n_ch, n_samp, "median")
            println("[selftest] mode=structured c_n=" + str(r[0]) + " b_n_x1000=" + str(r[1]))
        }

        println("           F_LZN_01: c_n <= 1                  (algorithm-broken)")
        println("           F_LZN_02: lz76_norm_x1000 < 100      (catastrophic structure)")
        println("           F_LZN_03: lz76_norm_x1000 > 1500     (impossible LZc)")

        if cross_validate {
            let rc2 = _selftest_cross_validate()
            if rc2 == 0 {
                println("selftest=ok (native+cross_validate=byte_identical)")
                exit(0)
            }
            if rc2 == 2 {
                exit(0)
            }
            eprintln("selftest=fail (cross_validate)")
            exit(1)
        }

        println("selftest=ok (native_only; cross_validate=not_requested)")
        exit(0)
    }

    if input == "" {
        eprintln("ABORT: need --selftest or --input <npy>")
        _print_usage()
        exit(2)
    }

    let kv = _metric_lz76_native_kv(input, sidecar, threshold_mode)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    if find_in_str(kv, "verdict=FALSIFIED") >= 0 { exit(1) }
    exit(2)
}
