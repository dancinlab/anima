// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_gates/hjorth_band.hexa  (Phase 2 — gate #4)
//
//  PURPOSE
//    Hjorth complexity band gate (Hjorth 1970). Awake EEG complexity ∈ [0.8,
//    2.5] empirically. Sustained sinusoid → complexity ≈ 1.0; pure white
//    noise → much higher; DC drift → near 0. Orthogonal to spectral & PE.
//
//  API     run_hjorth_band_gate(npy_path) → key=value dump
//          fields: pass, activity_log10_x1000, mobility_x1000,
//                  complexity_mean_x1000, verdict
//
//    C1: complexity_mean ∈ [0.8, 2.5]
//
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host")
// ════════════════════════════════════════════════════════════════════════════

let CPX_LO_X1000 = 800
let CPX_HI_X1000 = 2500

let HELPER = "state/.hjorth_band_gate_helper.py"
let DUMP   = "state/.hjorth_band_gate_dump.txt"

fn env_str(k: string, d: string) -> string {
    let s = env(k); if s == "" { return d } ; return s
}

fn pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let chk = exec("test -x .venv-eeg/bin/python && echo OK").trim()
    if chk == "OK" { return ".venv-eeg/bin/python" }
    return "/usr/bin/python3"
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key); let mut acc = 0; let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn write_helper() {
    let py = "#!/usr/bin/env python3
# hjorth_band_gate helper. Hjorth 1970 (Activity, Mobility, Complexity).
import sys, os, math
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 4:
    sys.stderr.write('usage: helper <mode> <input_or_kind> <out>\\n'); sys.exit(2)
mode, src, out_path = sys.argv[1], sys.argv[2], sys.argv[3]

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2: raise RuntimeError('expected 2-D')
    r, c = a.shape
    if r == 16: return a, 16, c
    if c == 16: return a.T, 16, r
    if r >= 32 and c > r: return a[1:17, :], 16, c
    if c >= 32 and r > c: return a.T[1:17, :], 16, r
    raise RuntimeError('cannot infer 16-ch from ' + str(a.shape))

def hjorth(x):
    x = np.asarray(x, dtype=np.float64)
    activity = float(np.var(x))
    if activity == 0.0: return 0.0, 0.0, 0.0
    d1 = np.diff(x); var_d1 = float(np.var(d1))
    if var_d1 == 0.0: return activity, 0.0, 0.0
    mobility = math.sqrt(var_d1 / activity)
    d2 = np.diff(d1); var_d2 = float(np.var(d2))
    if var_d1 == 0.0 or mobility == 0.0: return activity, mobility, 0.0
    mobility_d1 = math.sqrt(var_d2 / var_d1)
    complexity = mobility_d1 / mobility
    return activity, mobility, complexity

if mode == 'selftest':
    kind = src
    n = 60 * 125
    rng = np.random.RandomState(11)
    eeg = np.zeros((16, n), dtype=np.float64)
    if kind == 'awake':
        # awake-like 1/f-ish broadband
        t = np.arange(n) / 125.0
        for ch in range(16):
            eeg[ch, :] = rng.normal(0, 1, n) + 0.5 * np.sin(2 * np.pi * 10.0 * t)
    elif kind == 'const':
        pass
    elif kind == 'white':
        for ch in range(16):
            eeg[ch, :] = rng.normal(0, 1, n)
    elif kind == 'sine':
        t = np.arange(n) / 125.0
        for ch in range(16):
            eeg[ch, :] = np.sin(2 * np.pi * 10.0 * t)
    elif kind == 'drift':
        t = np.arange(n) / 125.0
        for ch in range(16):
            eeg[ch, :] = np.sin(2 * np.pi * 0.05 * t)
    else:
        sys.stderr.write('unknown kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('unknown mode\\n'); sys.exit(2)

acts, mobs, cpxs = [], [], []
for ch in range(n_ch):
    a_, m_, c_ = hjorth(eeg[ch, :])
    acts.append(a_); mobs.append(m_); cpxs.append(c_)
act_mean = float(np.mean(acts))
mob_mean = float(np.mean(mobs))
cpx_mean = float(np.mean(cpxs))

with open(out_path, 'w') as f:
    f.write('schema=hjorth_band_gate_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    if act_mean > 0:
        f.write('log10_activity_mean_x1000=' + str(int(round(math.log10(act_mean) * 1000))) + '\\n')
    else:
        f.write('log10_activity_mean_x1000=-2147483647\\n')
    f.write('mobility_mean_x1000=' + str(int(round(mob_mean * 1000))) + '\\n')
    f.write('complexity_mean_x1000=' + str(int(round(cpx_mean * 1000))) + '\\n')
print('OK cpx=' + ('%.4f' % cpx_mean))
"
    write_file(HELPER, py)
}

fn run_helper(mode_arg: string, src_arg: string) -> string {
    write_helper()
    let py = pick_python()
    let cmd = py + " " + HELPER + " " + mode_arg + " \"" + src_arg + "\" \"" + DUMP + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 { eprintln("hjorth-band-gate-rc=" + str(rc) + " out=" + to_string(r[0])); return "" }
    return read_file(DUMP)
}

fn run_hjorth_band_gate(mode_arg: string, src_arg: string) -> string {
    let blob = run_helper(mode_arg, src_arg)
    if blob == "" { return "" }
    let act = parse_int_kv(blob, "log10_activity_mean_x1000=")
    let mob = parse_int_kv(blob, "mobility_mean_x1000=")
    let cpx = parse_int_kv(blob, "complexity_mean_x1000=")
    let c1 = if cpx >= CPX_LO_X1000 && cpx <= CPX_HI_X1000 { 1 } else { 0 }
    let pass_flag = c1
    let verdict = if pass_flag == 1 { "PASS" } else { "FAIL" }
    let mut out = "gate=hjorth_band\n"
    out = out + "pass=" + str(pass_flag) + "\n"
    out = out + "verdict=" + verdict + "\n"
    out = out + "log10_activity_x1000=" + str(act) + "\n"
    out = out + "mobility_x1000=" + str(mob) + "\n"
    out = out + "complexity_x1000=" + str(cpx) + "\n"
    out = out + "c1_complexity_in_band=" + str(c1) + "\n"
    return out
}

fn flags_only_argv() -> list {
    let av = argv(); let mut start = 0
    while start < len(av) {
        let a = av[start]; let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []; let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn main() {
    let av = flags_only_argv()
    let mut mode = "selftest"; let mut src = "awake"; let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--input" { mode = "real"; src = av[i+1]; i = i + 2; continue }
        if a == "--selftest-mode" { mode = "selftest"; src = av[i+1]; i = i + 2; continue }
        i = i + 1
    }
    let res = run_hjorth_band_gate(mode, src)
    if res == "" { eprintln("reason: hjorth-helper-failed"); exit(3) }
    print(res)
    let pf = parse_int_kv(res, "pass=")
    if pf == 1 { exit(0) }
    exit(1)
}
