// anima-eeg-core/tool/modules/_core/pipeline_suggester.hexa
//
// PURPOSE
//   Phase 1 _core/ module #6 — auto-suggest analysis pipeline given a .npy.
//   Reads shape (16ch × N), duration, RMS, optional Berger gate hint, optional
//   motion-RMS proxy, then emits a ranked command list plus rationale strings
//   so the user has a defensible "why this pipeline" trail.
//
//     Suggester is ADVISORY — it never executes the recommended commands.
//     It emits a ranked list keyed off measured properties of the input (NOT
//     hard-coded preferences). All thresholds are visible in the helper so a
//     reviewer can falsify them.
//
// API (module-internal contract)
//   _core_suggest_pipeline_kv(npy_in: string, sidecar: string) -> string
//     returns kv-block:
//       schema=anima-eeg-core/_core/pipeline_suggester/1
//       n_channels=<int>
//       n_samples=<int>
//       sample_rate=<float>
//       duration_s=<float>
//       duration_band=<short|standard|extended|long|sleep>
//       rms_uv=<float>
//       motion_level=<clean|moderate|high>
//       berger_hint=<pass|fail|unknown>
//       ica_recommendation=<skip|gentle|aggressive>
//       paradigm_hint=<resting-eyes-closed|eyes-open|sleep|task|unknown>
//       cmd_count=<int>
//       cmd_1=<string>   ; rationale_1=<string>
//       cmd_2=<string>   ; rationale_2=<string>
//       ...
//       verdict=PASS|FAIL
//       reason=<short-slug>            (only on FAIL)
//
// CLI
//   hexa run pipeline_suggester.hexa --selftest
//   hexa run pipeline_suggester.hexa --suggest --input <p.npy> [--sidecar <p.json>]

let SCHEMA       = "anima-eeg-core/_core/pipeline_suggester/1"
let HELPER_PATH  = "/tmp/anima_eeg_core_pipeline_suggester_helper.py"
let VENV_PYTHON  = ".venv-eeg/bin/python"

// ─── helpers ────────────────────────────────────────────────────────────

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}


fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# Suggests analysis pipeline given .npy shape + RMS + Berger hint.\n")
    parts.push("import argparse, hashlib, json, os, sys\n")
    parts.push("import numpy as np\n\n")

    parts.push("def emit(k, v): print(f'{k}={v}')\n\n")

    parts.push("def sha256_file(path):\n")
    parts.push("    h = hashlib.sha256()\n")
    parts.push("    with open(path, 'rb') as f:\n")
    parts.push("        for chunk in iter(lambda: f.read(65536), b''):\n")
    parts.push("            h.update(chunk)\n")
    parts.push("    return h.hexdigest()\n\n")

    parts.push("def load_sidecar(npy_path, sidecar_arg):\n")
    parts.push("    if sidecar_arg:\n")
    parts.push("        sc = sidecar_arg\n")
    parts.push("    else:\n")
    parts.push("        sc = npy_path + '.meta.json'\n")
    parts.push("    if not os.path.exists(sc): return ('', {})\n")
    parts.push("    try:\n")
    parts.push("        with open(sc,'r') as f: return (sc, json.load(f))\n")
    parts.push("    except Exception:\n")
    parts.push("        return (sc, {})\n\n")

    // Berger hint: alpha (8-13Hz) eyes-closed dominance check.
    // Computed from FFT power across 16ch; hint is heuristic — full berger gate
    parts.push("def berger_hint(eeg, fs):\n")
    parts.push("    n = eeg.shape[1]\n")
    parts.push("    if n < int(fs*4):  # need >=4s for 1Hz freq resolution\n")
    parts.push("        return 'unknown'\n")
    parts.push("    f = np.fft.rfftfreq(n, 1/fs)\n")
    parts.push("    P = np.abs(np.fft.rfft(eeg, axis=1)) ** 2\n")
    parts.push("    band = lambda lo, hi: float(np.mean(P[:, (f>=lo)&(f<hi)]))\n")
    parts.push("    p_alpha = band(8.0, 13.0)\n")
    parts.push("    p_theta = band(4.0, 8.0)\n")
    parts.push("    p_beta  = band(13.0, 30.0)\n")
    parts.push("    # heuristic: alpha must be >= 1.3x mean(theta,beta) to suggest eyes-closed\n")
    parts.push("    bg = (p_theta + p_beta) / 2.0\n")
    parts.push("    if bg <= 0: return 'unknown'\n")
    parts.push("    ratio = p_alpha / bg\n")
    parts.push("    if ratio >= 1.3: return 'pass'\n")
    parts.push("    if ratio < 0.9:  return 'fail'\n")
    parts.push("    return 'unknown'\n\n")

    // Motion proxy: per-sample peak-to-peak / RMS — high motion records have
    // sporadic large excursions that lift max(|x|) far above RMS. Threshold
    // tuned conservatively on synthetic scenarios; reviewers can falsify.
    parts.push("def motion_level(eeg):\n")
    parts.push("    rms = float(np.sqrt(np.mean(eeg**2)))\n")
    parts.push("    if rms < 1e-9: return ('clean', rms, 0.0)\n")
    parts.push("    pk  = float(np.max(np.abs(eeg)))\n")
    parts.push("    crest = pk / rms\n")
    parts.push("    if rms > 5000.0 or crest > 12.0:  return ('high', rms, crest)\n")
    parts.push("    if rms > 200.0  or crest > 6.0:   return ('moderate', rms, crest)\n")
    parts.push("    return ('clean', rms, crest)\n\n")

    parts.push("def duration_band(dur_s):\n")
    parts.push("    if dur_s < 30.0:    return 'short'\n")
    parts.push("    if dur_s < 90.0:    return 'standard'\n")
    parts.push("    if dur_s < 300.0:   return 'extended'\n")
    parts.push("    if dur_s < 3600.0:  return 'long'\n")
    parts.push("    return 'sleep'\n\n")

    parts.push("def ica_recommendation(motion):\n")
    parts.push("    if motion == 'high':     return 'aggressive'\n")
    parts.push("    if motion == 'moderate': return 'gentle'\n")
    parts.push("    return 'skip'\n\n")

    parts.push("def paradigm_hint(meta, dur_band, berger):\n")
    parts.push("    task = str(meta.get('task','')).lower()\n")
    parts.push("    if 'sleep' in task or dur_band == 'sleep': return 'sleep'\n")
    parts.push("    if 'task' in task or 'pre_post' in task or 'pre-post' in task: return 'task'\n")
    parts.push("    if 'eyes_closed' in task or 'eyes-closed' in task or 'resting' in task:\n")
    parts.push("        return 'resting-eyes-closed'\n")
    parts.push("    if 'eyes_open' in task or 'eyes-open' in task or 'daily' in task:\n")
    parts.push("        return 'eyes-open'\n")
    parts.push("    # heuristic fallback by berger hint\n")
    parts.push("    if berger == 'pass': return 'resting-eyes-closed'\n")
    parts.push("    if berger == 'fail': return 'eyes-open'\n")
    parts.push("    return 'unknown'\n\n")

    parts.push("def build_commands(npy_path, dur_band, motion, berger, ica_rec, paradigm):\n")
    parts.push("    cmds = []\n")
    parts.push("    qpath = npy_path  # already validated\n")
    parts.push("    cmds.append((f'eeg_core gate-all --input {qpath}',\n")
    parts.push("                 'all 4 validity gates (berger,rms,pe,hjorth) — establish PASS/FAIL before metrics'))\n")
    parts.push("    # 1b. PRIORITY: artifact detect-all when EMI/motion suspected\n")
    parts.push("    #     (D-day Tier-B #8: 9-module artifact agent landed; run before metrics)\n")
    parts.push("    if motion in ('moderate', 'high'):\n")
    parts.push("        cmds.append((f'eeg_core artifact detect-all --input {qpath}',\n")
    parts.push("                     f'motion={motion} suspected — 7-detector composite (EMI/blink/motion/EMG/ECG/refdrift/aging) before metrics; recommends cleaning chain'))\n")
    parts.push("        cmds.append((f'eeg_core artifact clean --input {qpath}',\n")
    parts.push("                     'cleaning pipeline: meta → suppressors (notch/clip/HP/LP/reject) → re-meta; emits *_aiclean.npy'))\n")
    parts.push("    # 2. duration-driven base recommendation\n")
    parts.push("    if dur_band == 'short':\n")
    parts.push("        cmds.append((f'eeg_core gate-all --input {qpath}',\n")
    parts.push("                     'duration<30s — statistics unstable; only validity gates trustworthy'))\n")
    parts.push("    elif dur_band == 'standard':\n")
    parts.push("        cmds.append((f'eeg_core pipeline standard --input {qpath}',\n")
    parts.push("                     '30-90s standard recording — composite gate+metric+audit recipe'))\n")
    parts.push("    elif dur_band == 'extended':\n")
    parts.push("        cmds.append((f'eeg_core pipeline standard --input {qpath}',\n")
    parts.push("                     '90-300s extended — sliding-window LZ76 + spectral-entropy adds value'))\n")
    parts.push("    elif dur_band == 'long':\n")
    parts.push("        cmds.append((f'eeg_core pipeline daily-life --input {qpath}',\n")
    parts.push("                     '5min-1h long-duration — daily-life verifier with change-points'))\n")
    parts.push("    else:  # sleep\n")
    parts.push("        cmds.append((f'eeg_core record sleep --input {qpath}',\n")
    parts.push("                     '>1h — sleep tracking pipeline (HMM staging + δ/θ/α/β bandpower)'))\n")
    parts.push("    # 3. paradigm-specific metric set\n")
    parts.push("    if paradigm == 'resting-eyes-closed':\n")
    parts.push("        cmds.append((f'eeg_core metric lz76 --input {qpath}',\n")
    parts.push("                     'resting eyes-closed: LZ76 complexity (consciousness/awareness proxy)'))\n")
    parts.push("        cmds.append((f'eeg_core metric gamma_theta --input {qpath}',\n")
    parts.push("                     'resting eyes-closed: γ/θ ratio (DMN/frontal-asymmetry diagnostic)'))\n")
    parts.push("    elif paradigm == 'eyes-open':\n")
    parts.push("        cmds.append((f'eeg_core metric lz76 --input {qpath}',\n")
    parts.push("                     'eyes-open daily-life: LZ76 sliding window for fluctuation tracking'))\n")
    parts.push("        cmds.append((f'eeg_core metric pe --input {qpath}',\n")
    parts.push("                     'eyes-open daily-life: permutation entropy for change-point detection'))\n")
    parts.push("    elif paradigm == 'sleep':\n")
    parts.push("        cmds.append((f'eeg_core record sleep --input {qpath}',\n")
    parts.push("                     'sleep: HMM staging across 5 stages (Wake/N1/N2/N3/REM)'))\n")
    parts.push("    elif paradigm == 'task':\n")
    parts.push("        cmds.append((f'eeg_core record pre-post --input {qpath}',\n")
    parts.push("                     'task: pre/post comparison + ERP triggers'))\n")
    parts.push("    # 4. artifact-only path when berger fails\n")
    parts.push("    if berger == 'fail':\n")
    parts.push("        cmds.append((f'eeg_core artifact detect-all --input {qpath}',\n")
    parts.push("                     'berger gate FAIL — alpha-dominance not visible; metrics may reflect artifact only'))\n")
    parts.push("    # 5. ICA based on motion\n")
    parts.push("    if ica_rec == 'aggressive':\n")
    parts.push("        cmds.append((f'eeg_core artifact detect-all --input {qpath} --ica-aggressive',\n")
    parts.push("                     f'motion={motion} → aggressive ICA (n_excl 8-12) before metrics'))\n")
    parts.push("    elif ica_rec == 'gentle':\n")
    parts.push("        cmds.append((f'eeg_core artifact detect-all --input {qpath} --ica-gentle',\n")
    parts.push("                     f'motion={motion} → gentle ICA (n_excl 2-5) — T15 follow-up path'))\n")
    parts.push("    # else skip ICA — no command emitted\n")
    parts.push("    return cmds\n\n")

    parts.push("def cmd_suggest(args):\n")
    parts.push("    if not os.path.exists(args.npy_in):\n")
    parts.push("        emit('schema','" + SCHEMA + "')\n")
    parts.push("        emit('verdict','FAIL'); emit('reason','input-missing')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    arr = np.load(args.npy_in).astype(np.float64)\n")
    parts.push("    if arr.ndim != 2:\n")
    parts.push("        emit('schema','" + SCHEMA + "')\n")
    parts.push("        emit('verdict','FAIL'); emit('reason',f'ndim={arr.ndim}-not-2')\n")
    parts.push("        sys.exit(3)\n")
    parts.push("    n_rows, n_samples = int(arr.shape[0]), int(arr.shape[1])\n")
    parts.push("    sc_path, meta = load_sidecar(args.npy_in, args.sidecar)\n")
    parts.push("    fs = float(meta.get('sample_rate', args.default_sr))\n")
    parts.push("    # extract EEG channels — accept either 16ch direct or 32-row BrainFlow layout\n")
    parts.push("    if n_rows == 16:\n")
    parts.push("        eeg = arr\n")
    parts.push("        n_channels = 16\n")
    parts.push("    elif n_rows >= 17:\n")
    parts.push("        eeg = arr[1:17, :]\n")
    parts.push("        n_channels = 16\n")
    parts.push("    else:\n")
    parts.push("        emit('schema','" + SCHEMA + "')\n")
    parts.push("        emit('verdict','FAIL')\n")
    parts.push("        emit('reason',f'rows={n_rows}-need-16-or-32')\n")
    parts.push("        sys.exit(4)\n")
    parts.push("    dur_s = n_samples / fs if fs > 0 else 0.0\n")
    parts.push("    dur_band = duration_band(dur_s)\n")
    parts.push("    motion, rms, crest = motion_level(eeg)\n")
    parts.push("    bg = berger_hint(eeg, fs)\n")
    parts.push("    ica_rec = ica_recommendation(motion)\n")
    parts.push("    paradigm = paradigm_hint(meta, dur_band, bg)\n")
    parts.push("    cmds = build_commands(args.npy_in, dur_band, motion, bg, ica_rec, paradigm)\n")
    parts.push("    emit('schema','" + SCHEMA + "')\n")
    parts.push("    emit('input', args.npy_in)\n")
    parts.push("    emit('sidecar', sc_path)\n")
    parts.push("    emit('n_rows', n_rows)\n")
    parts.push("    emit('n_channels', n_channels)\n")
    parts.push("    emit('n_samples', n_samples)\n")
    parts.push("    emit('sample_rate', fs)\n")
    parts.push("    emit('duration_s', f'{dur_s:.3f}')\n")
    parts.push("    emit('duration_band', dur_band)\n")
    parts.push("    emit('rms_uv', f'{rms:.3f}')\n")
    parts.push("    emit('crest_factor', f'{crest:.3f}')\n")
    parts.push("    emit('motion_level', motion)\n")
    parts.push("    emit('berger_hint', bg)\n")
    parts.push("    emit('ica_recommendation', ica_rec)\n")
    parts.push("    emit('paradigm_hint', paradigm)\n")
    parts.push("    emit('cmd_count', len(cmds))\n")
    parts.push("    for i, (c, r) in enumerate(cmds, start=1):\n")
    parts.push("        emit(f'cmd_{i}', c)\n")
    parts.push("        emit(f'rationale_{i}', r)\n")
    parts.push("    emit('verdict','PASS')\n\n")

    // Selftest: synthesize 5 scenarios end-to-end and check expected fields.
    parts.push("def _synth_eeg(rng, n_ch, fs, secs, mode):\n")
    parts.push("    cols = int(fs*secs)\n")
    parts.push("    t = np.arange(cols)/fs\n")
    parts.push("    data = np.zeros((n_ch, cols), dtype=np.float64)\n")
    parts.push("    for k in range(n_ch):\n")
    parts.push("        if mode == 'clean':\n")
    parts.push("            # eyes-closed: alpha-dominant 10Hz\n")
    parts.push("            data[k] = 30.0*np.sin(2*np.pi*10*t) + 5.0*rng.standard_normal(cols)\n")
    parts.push("        elif mode == 'motion':\n")
    parts.push("            # high RMS + spike artifacts\n")
    parts.push("            base = 20.0*np.sin(2*np.pi*10*t)\n")
    parts.push("            spikes = rng.standard_normal(cols) * 100.0\n")
    parts.push("            spike_idx = rng.choice(cols, size=max(1, cols//20), replace=False)\n")
    parts.push("            big = np.zeros(cols)\n")
    parts.push("            big[spike_idx] = rng.standard_normal(len(spike_idx)) * 50000.0\n")
    parts.push("            data[k] = base + spikes + big\n")
    parts.push("        elif mode == 'sleep':\n")
    parts.push("            # delta-dominant 2Hz\n")
    parts.push("            data[k] = 50.0*np.sin(2*np.pi*2*t) + 5.0*rng.standard_normal(cols)\n")
    parts.push("        elif mode == 'task':\n")
    parts.push("            # mixed beta + alpha with brief ERP\n")
    parts.push("            data[k] = (10.0*np.sin(2*np.pi*20*t) +\n")
    parts.push("                       8.0*np.sin(2*np.pi*10*t) +\n")
    parts.push("                       3.0*rng.standard_normal(cols))\n")
    parts.push("        else:  # artifact-dominant: 60Hz mains + drift\n")
    parts.push("            data[k] = (50.0*np.sin(2*np.pi*60*t) +\n")
    parts.push("                       30.0*np.linspace(-1,1,cols) +\n")
    parts.push("                       4.0*rng.standard_normal(cols))\n")
    parts.push("    return data\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    out_dir = '/tmp/anima_eeg_core_pipeline_suggester_selftest'\n")
    parts.push("    os.makedirs(out_dir, exist_ok=True)\n")
    parts.push("    fs = 125.0\n")
    parts.push("    rng = np.random.default_rng(20260428)\n")
    parts.push("    scenarios = [\n")
    parts.push("        ('clean',    60,  'resting'),    # standard duration, eyes-closed\n")
    parts.push("        ('motion',   60,  'daily_life'), # standard duration, eyes-open with motion\n")
    parts.push("        ('sleep',    3700,'sleep'),      # >1h\n")
    parts.push("        ('task',     120, 'task_pre_post'),# extended\n")
    parts.push("        ('artifact', 60,  'resting'),    # mains-dominant\n")
    parts.push("    ]\n")
    parts.push("    expected = {\n")
    parts.push("        'clean':    {'duration_band':'standard','motion_level':'clean',   'paradigm_hint':'resting-eyes-closed'},\n")
    parts.push("        'motion':   {'duration_band':'standard','motion_level':'high',    'paradigm_hint':'eyes-open'},\n")
    parts.push("        'sleep':    {'duration_band':'sleep',   'motion_level':'clean',   'paradigm_hint':'sleep'},\n")
    parts.push("        'task':     {'duration_band':'extended','motion_level':'clean',   'paradigm_hint':'task'},\n")
    parts.push("        'artifact': {'duration_band':'standard','motion_level':'clean',   'paradigm_hint':'resting-eyes-closed'},\n")
    parts.push("    }\n")
    parts.push("    overall_pass = 0\n")
    parts.push("    overall_fail = 0\n")
    parts.push("    for mode, secs, task in scenarios:\n")
    parts.push("        eeg = _synth_eeg(rng, 16, fs, secs, mode)\n")
    parts.push("        npy = os.path.join(out_dir, f'{mode}.npy')\n")
    parts.push("        np.save(npy, eeg.astype(np.float32))\n")
    parts.push("        meta = {'schema':'anima-eeg/eeg_recorder/1','task':task,\n")
    parts.push("                'session_ts':'20260428T000000Z','sample_rate':fs,\n")
    parts.push("                'rows':16,'cols':int(fs*secs)}\n")
    parts.push("        with open(npy + '.meta.json','w') as f: json.dump(meta, f)\n")
    parts.push("        # capture buffer by emitting prefixed lines\n")
    parts.push("        emit('--- scenario', mode)\n")
    parts.push("        class A: pass\n")
    parts.push("        a = A(); a.npy_in = npy; a.sidecar = ''; a.default_sr = fs\n")
    parts.push("        # We can't easily redirect emit(); instead re-derive expected fields\n")
    parts.push("        # locally and check against build pipeline.\n")
    parts.push("        n_rows, n_samples = int(eeg.shape[0]), int(eeg.shape[1])\n")
    parts.push("        dur_s = n_samples / fs\n")
    parts.push("        dur_band = duration_band(dur_s)\n")
    parts.push("        motion, rms, crest = motion_level(eeg)\n")
    parts.push("        bg = berger_hint(eeg, fs)\n")
    parts.push("        ica_rec = ica_recommendation(motion)\n")
    parts.push("        paradigm = paradigm_hint(meta, dur_band, bg)\n")
    parts.push("        cmds = build_commands(npy, dur_band, motion, bg, ica_rec, paradigm)\n")
    parts.push("        exp = expected[mode]\n")
    parts.push("        ok_db = (dur_band == exp['duration_band'])\n")
    parts.push("        ok_ml = (motion == exp['motion_level'])\n")
    parts.push("        ok_pg = (paradigm == exp['paradigm_hint'])\n")
    parts.push("        ok_cmds = (len(cmds) >= 2)\n")
    parts.push("        scenario_pass = ok_db and ok_ml and ok_pg and ok_cmds\n")
    parts.push("        emit(f'{mode}_duration_band', dur_band)\n")
    parts.push("        emit(f'{mode}_motion_level', motion)\n")
    parts.push("        emit(f'{mode}_paradigm_hint', paradigm)\n")
    parts.push("        emit(f'{mode}_berger_hint', bg)\n")
    parts.push("        emit(f'{mode}_cmd_count', len(cmds))\n")
    parts.push("        emit(f'{mode}_scenario_pass', 'true' if scenario_pass else 'false')\n")
    parts.push("        emit(f'{mode}_expected_duration_band', exp['duration_band'])\n")
    parts.push("        emit(f'{mode}_expected_motion_level', exp['motion_level'])\n")
    parts.push("        emit(f'{mode}_expected_paradigm_hint', exp['paradigm_hint'])\n")
    parts.push("        if scenario_pass: overall_pass += 1\n")
    parts.push("        else: overall_fail += 1\n")
    parts.push("    emit('selftest_pass', overall_pass)\n")
    parts.push("    emit('selftest_fail', overall_fail)\n")
    parts.push("    emit('selftest', 'ok' if overall_fail == 0 else 'fail')\n")
    parts.push("    if overall_fail != 0: sys.exit(1)\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    sub.add_parser('selftest')\n")
    parts.push("    c = sub.add_parser('suggest')\n")
    parts.push("    c.add_argument('--input', dest='npy_in', required=True)\n")
    parts.push("    c.add_argument('--sidecar', dest='sidecar', default='')\n")
    parts.push("    c.add_argument('--default-sr', dest='default_sr', type=float, default=125.0)\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest':\n")
    parts.push("        class A: pass\n")
    parts.push("        a = A(); a.default_sr = 125.0\n")
    parts.push("        cmd_selftest(a)\n")
    parts.push("    elif args.cmd == 'suggest': cmd_suggest(args)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> array {
    let cmd = VENV_PYTHON + " " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ─── public-ish API ────────────────────────────────────────────────────

fn _core_suggest_pipeline_kv(npy_in: string, sidecar: string) -> string {
    _write_helper()
    let mut a = "suggest --input " + _sh_quote(npy_in)
    if sidecar != "" { a = a + " --sidecar " + _sh_quote(sidecar) }
    let r = _run_helper(a)
    return r[0]
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" || a == "build" { is_prefix = true } }
        if !is_prefix {
            if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true }
        }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn _print_usage() {
    eprintln("usage: hexa run pipeline_suggester.hexa --selftest")
    eprintln("       hexa run pipeline_suggester.hexa --suggest --input <p.npy> [--sidecar <p.json>]")
}

// completes; each fires iff the selftest body violates a contract.
fn _run_falsifiers(body: string) -> array {
    // returns [pass_count, fail_count, details_string]
    let mut pass = 0
    let mut fail = 0
    let mut details = ""

    // F01: clean scenario MUST suggest paradigm=resting-eyes-closed
    let f01 = (_kv_lookup(body, "clean_paradigm_hint") == "resting-eyes-closed")
    if f01 { pass = pass + 1 } else { fail = fail + 1 }
    if details != "" { details = details + ";" }
    details = details + "F01:" + (if f01 { "ok" } else { "FIRE-clean-paradigm" })

    // F02: motion scenario MUST report motion_level=high
    let f02 = (_kv_lookup(body, "motion_motion_level") == "high")
    if f02 { pass = pass + 1 } else { fail = fail + 1 }
    if details != "" { details = details + ";" }
    details = details + "F02:" + (if f02 { "ok" } else { "FIRE-motion-not-high" })

    // F03: sleep scenario MUST be duration_band=sleep
    let f03 = (_kv_lookup(body, "sleep_duration_band") == "sleep")
    if f03 { pass = pass + 1 } else { fail = fail + 1 }
    if details != "" { details = details + ";" }
    details = details + "F03:" + (if f03 { "ok" } else { "FIRE-sleep-band" })

    // F04: task scenario MUST be paradigm=task
    let f04 = (_kv_lookup(body, "task_paradigm_hint") == "task")
    if f04 { pass = pass + 1 } else { fail = fail + 1 }
    if details != "" { details = details + ";" }
    details = details + "F04:" + (if f04 { "ok" } else { "FIRE-task-paradigm" })

    // F05: every scenario MUST emit at least 2 commands (gate-all + 1 more)
    let modes = ["clean","motion","sleep","task","artifact"]
    let mut all_ok = true
    let mut i = 0
    while i < len(modes) {
        let cnt = to_int(_kv_lookup(body, modes[i] + "_cmd_count"))
        if cnt < 2 { all_ok = false }
        i = i + 1
    }
    if all_ok { pass = pass + 1 } else { fail = fail + 1 }
    if details != "" { details = details + ";" }
    details = details + "F05:" + (if all_ok { "ok" } else { "FIRE-cmd-count-lt-2" })

    return [pass, fail, details]
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut suggest_mode = false
    let mut npy_in  = ""
    let mut sidecar = ""

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--suggest"  { suggest_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        if a == "--input"    { npy_in  = av[i+1]; i = i + 2; continue }
        if a == "--sidecar"  { sidecar = av[i+1]; i = i + 2; continue }
        eprintln("unknown arg: " + a); _print_usage(); exit(2)
    }

    if !selftest && !suggest_mode {
        eprintln("ABORT: need --selftest or --suggest")
        _print_usage(); exit(2)
    }

    _write_helper()

    if selftest {
        println("== _core pipeline_suggester selftest ==")
        let r = _run_helper("selftest")
        let body = r[0]
        let rc   = r[1]
        println(body)
        if rc != 0 { eprintln("helper rc=" + to_string(rc)); exit(1) }

        println("")
        println("── 5-scenario selftest assertions ──")
        let mut pass = 0
        let mut fail = 0
        let t1 = assert_true(_kv_lookup(body, "selftest") == "ok", "selftest=ok")
        if t1 { pass = pass + 1 } else { fail = fail + 1 }
        let t2 = assert_true(_kv_lookup(body, "clean_scenario_pass") == "true",
                             "clean scenario PASS")
        if t2 { pass = pass + 1 } else { fail = fail + 1 }
        let t3 = assert_true(_kv_lookup(body, "motion_scenario_pass") == "true",
                             "motion scenario PASS")
        if t3 { pass = pass + 1 } else { fail = fail + 1 }
        let t4 = assert_true(_kv_lookup(body, "sleep_scenario_pass") == "true",
                             "sleep scenario PASS")
        if t4 { pass = pass + 1 } else { fail = fail + 1 }
        let t5 = assert_true(_kv_lookup(body, "task_scenario_pass") == "true",
                             "task scenario PASS")
        if t5 { pass = pass + 1 } else { fail = fail + 1 }
        let t6 = assert_true(_kv_lookup(body, "artifact_scenario_pass") == "true",
                             "artifact scenario PASS")
        if t6 { pass = pass + 1 } else { fail = fail + 1 }

        println("")
        let fr = _run_falsifiers(body)
        let f_pass = to_int(fr[0])
        let f_fail = to_int(fr[1])
        let f_det  = to_string(fr[2])
        println("falsifier_details=" + f_det)
        println("falsifier_pass=" + to_string(f_pass))
        println("falsifier_fail=" + to_string(f_fail))
        let tF = assert_true(f_fail == 0, "5/5 falsifiers PASS")
        if tF { pass = pass + 1 } else { fail = fail + 1 }

        println("")
        println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL")
        if fail != 0 { exit(1) }
        println("schema=" + SCHEMA)
        println("selftest: OK")
        exit(0)
    }

    // suggest mode
    if npy_in == "" { eprintln("ABORT: --suggest needs --input"); exit(2) }
    let body = _core_suggest_pipeline_kv(npy_in, sidecar)
    println(body)
    let v = _kv_lookup(body, "verdict")
    if v != "PASS" { exit(1) }
    exit(0)
}
