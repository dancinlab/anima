// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_hw/board_health.hexa  (Phase 5 — _hw module #1)
//
//  PURPOSE
//    self-host fixpoint: WRAPS the frozen legacy implementation at
//    anima-eeg/board_health_check.hexa (528 LoC, D-day 16/16 alive verified).
//
//    DECISION: WRAP (not PORT). Legacy file is 528 LoC of BrainFlow USB +
//    ADS1299 wire-state classification (DEAD / DISCONNECTED / FLOATING /
//    NORMAL) and is D-day verified (16/16 alive on host hardware). Re-
//    implementing 528 LoC under Phase 0 module API would risk silent
//    exposing kv-block surface to dispatcher meets Phase 5 contract.
//
//  API
//    _hw_board_health_kv(args_kv: string) -> string
//      Returns kv-block:
//        schema=anima-eeg-core/_hw/board_health/1
//        op=check
//        mode=<selftest|real>
//        duration_s=<int>
//        verdict=<PASS|FAIL|PARTIAL>
//        legacy_verdict=<BOARD_16CH_HEALTHY|...>
//        cyton_alive=<int>
//        daisy_alive=<int>
//        total_alive=<int>
//        adc_dead_count=<int>
//        wire_disconnected_count=<int>
//        pin_shorts_count=<int>
//        backend=anima-eeg/board_health_check.hexa
//        backend_rc=<int>
//        raw71_falsifier_count=4
//        raw71_triggered_ids=<csv>
//        raw91_evidence=ads1299_alive_+wire_classification_+cross_chan_corr
//        raw95_enforce_layer=in_module
//
//  RAW#71 FALSIFIERS (≥4 preregistered, frozen 2026-04-28)
//    F_BH_01: total_alive < 16        → PARTIAL (1+ ch dead)
//    F_BH_02: pin_shorts_count > 0    → BOARD_PINS_SHORTED
//    F_BH_03: cyton_alive == 0        → board offline (USB / FTDI)
//    F_BH_04: daisy_alive == 0        → BOARD_8CH_ONLY (stack/firmware)
//
//  CLI
//    hexa run board_health.hexa --selftest
//    hexa run board_health.hexa --check [--port <path>] [--seconds <n>]
//
//
//  @resolver-bypass(reason="darwin-native: legacy backend requires .venv-eeg
//                   + USB FTDI dongle. Hetzner / linux pods do not expose
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima-eeg-core/_hw/board_health/1"
let MODULE_NAME  = "board_health"
let LEGACY_PATH  = "anima-eeg/board_health_check.hexa"

// ─── helpers ────────────────────────────────────────────────────────────

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] { ok = 0; j = m }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

// extract integer value following "key=" on its own line
fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0
    let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

// extract string value (until newline) following "key="
fn parse_str_kv(blob: string, key: string) -> string {
    let kp = find_in_str(blob, key)
    if kp < 0 { return "" }
    let n = len(blob); let mut q = kp + len(key)
    let mut out = ""
    while q < n && blob[q] != "\n" {
        out = out + blob[q]
        q = q + 1
    }
    return out.trim()
}

// ─── public-ish API ────────────────────────────────────────────────────

// argv parser that fails on the `hexa.real` binary path (predates the lenient
// synthesizes a mock kv-block for selftest. Real-mode (--check) path forwards
// to legacy via "hexa run" — which works because real-mode is invoked from
fn _hw_board_health_mock_kv() -> string {
    let mut out = ""
    out = out + "verdict=BOARD_16CH_HEALTHY\n"
    out = out + "cyton_alive=8\n"
    out = out + "daisy_alive=8\n"
    out = out + "total_alive=16\n"
    out = out + "adc_dead_count=0\n"
    out = out + "wire_disconnected_count=0\n"
    out = out + "pin_shorts_count=0\n"
    out = out + "selftest=mock_synthetic_16ch_all_alive\n"
    return out
}

fn _hw_board_health_kv(mode: string, port: string, seconds: int) -> string {
    let mut out = ""
    let mut rc = 0
    if mode == "selftest" {
        out = _hw_board_health_mock_kv()
        rc = 0
    } else {
        let mut args = "--check --seconds " + str(seconds)
        if port != "" { args = args + " --port " + _sh_quote(port) }
        let cmd = _hexa_bin() + " run " + LEGACY_PATH + " " + args
        eprintln("[_hw/board_health] cmd=" + cmd)
        let r = exec_with_status(cmd)
        out = to_string(r[0])
        rc = to_int(r[1])
    }

    // legacy emits "  X = Y" kv lines (out_kv) — parse key fields
    let cyton_alive = parse_int_kv(out, "cyton_alive=")
    let daisy_alive = parse_int_kv(out, "daisy_alive=")
    let total_alive = parse_int_kv(out, "total_alive=")
    let adc_dead = parse_int_kv(out, "adc_dead_count=")
    let wire_disc = parse_int_kv(out, "wire_disconnected_count=")
    let pin_shorts = parse_int_kv(out, "pin_shorts_count=")
    let legacy_verdict = parse_str_kv(out, "verdict=")

    let mut triggered = ""
    let mut trig_count = 0
    if total_alive != -2147483647 && total_alive < 16 {
        triggered = triggered + "F_BH_01,"; trig_count = trig_count + 1
    }
    if pin_shorts != -2147483647 && pin_shorts > 0 {
        triggered = triggered + "F_BH_02,"; trig_count = trig_count + 1
    }
    if cyton_alive != -2147483647 && cyton_alive == 0 {
        triggered = triggered + "F_BH_03,"; trig_count = trig_count + 1
    }
    if daisy_alive != -2147483647 && daisy_alive == 0 {
        triggered = triggered + "F_BH_04,"; trig_count = trig_count + 1
    }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    // verdict policy: rc==0 + no falsifier ⇒ PASS; rc==7 (PARTIAL_DEAD) ⇒ PARTIAL
    let mut verdict = "FAIL"
    if rc == 0 && trig_count == 0 { verdict = "PASS" }
    else { if rc == 7 { verdict = "PARTIAL" } }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "op=check\n"
    kv = kv + "mode=" + mode + "\n"
    kv = kv + "duration_s=" + str(seconds) + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "legacy_verdict=" + legacy_verdict + "\n"
    kv = kv + "cyton_alive=" + str(cyton_alive) + "\n"
    kv = kv + "daisy_alive=" + str(daisy_alive) + "\n"
    kv = kv + "total_alive=" + str(total_alive) + "\n"
    kv = kv + "adc_dead_count=" + str(adc_dead) + "\n"
    kv = kv + "wire_disconnected_count=" + str(wire_disc) + "\n"
    kv = kv + "pin_shorts_count=" + str(pin_shorts) + "\n"
    kv = kv + "value_x1000=" + str(total_alive * 1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_rc=" + str(rc) + "\n"
    kv = kv + "raw71_falsifier_count=4\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=ads1299_alive_+wire_classification_+cross_chan_corr\n"
    kv = kv + "raw91_limit=requires_host_USB_FTDI_dongle_raw42_mac_local\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run board_health.hexa --selftest")
    eprintln("       hexa run board_health.hexa --check [--port <path>] [--seconds <n>]")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut check_mode = false
    let mut port = ""
    let mut seconds = 3
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--check"    { check_mode = true; i = i + 1; continue }
        if a == "--port"     { port = av[i+1]; i = i + 2; continue }
        if a == "--seconds"  { seconds = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if selftest {
        println("== _hw/board_health selftest (mock — no hardware required) ==")
        let kv = _hw_board_health_kv("selftest", "", seconds)
        print(kv)
        // selftest contract: total_alive must equal 16 in synthetic path
        let ta = parse_int_kv(kv, "total_alive=")
        if ta != 16 {
            eprintln("reason: selftest total_alive=" + str(ta) + " != 16")
            exit(1)
        }
        println("selftest=ok")
        exit(0)
    }

    if !check_mode {
        eprintln("ABORT: need --selftest or --check")
        _print_usage()
        exit(2)
    }

    let kv = _hw_board_health_kv("real", port, seconds)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    if find_in_str(kv, "verdict=PARTIAL") >= 0 { exit(7) }
    exit(1)
}
