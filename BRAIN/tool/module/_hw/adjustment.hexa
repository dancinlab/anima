// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_hw/adjustment.hexa  (Phase 5 — _hw module #3)
//
//  PURPOSE
//    Multi-channel concurrent touch detection + per-electrode state advice
//    fixpoint: WRAPS the frozen legacy implementation at
//    anima-eeg/electrode_adjustment_helper.hexa (1310 LoC, B9 multi-channel
//    concurrent touch landed in commit 6b19a6f0).
//
//    DECISION: WRAP. Legacy file is 1310 LoC and includes the live ANSI
//    in-place renderer + 60fps tick + multi-channel touch witness — 3 highly
//    coupled concerns whose port would not pay back for Phase 5. Wrapper
//    exposes per-state aggregate counts + verdict to dispatcher; the rich
//    interactive UI is preserved at the legacy CLI for human use.
//
//  API
//    _hw_adjustment_kv(args_kv) -> string
//      schema=anima-eeg-core/_hw/adjustment/1
//      op=adjust
//      mode=<selftest|check|watch|live>
//      verdict=<PASS|FAIL|PARTIAL>
//      ok_count=<int>
//      loose_count=<int>
//      bad_count=<int>
//      dead_count=<int>
//      active_count=<int>     (live mode only — concurrent touch witness)
//      backend=anima-eeg/electrode_adjustment_helper.hexa
//      backend_rc=<int>
//      raw71_falsifier_count=4
//      raw71_triggered_ids=<csv>
//      raw91_evidence=B9_multi_channel_touch_threshold_(dev>1.4_abs>3000uV_rel>0.20)
//      raw91_limit=ANSI_renderer_assumes_terminal+host_USB_only
//      raw95_enforce_layer=in_module
//
//  RAW#71 FALSIFIERS (4 preregistered, frozen 2026-04-28)
//    F_ADJ_01: dead_count >= 4    → board-level issue (ADCs not responding)
//    F_ADJ_02: ok_count == 0      → all electrodes off-scalp (no contact)
//    F_ADJ_03: bad_count >= 12    → majority off → re-attach helmet
//    F_ADJ_04: backend_rc != 0    → BrainFlow / port failure
//
//  CLI
//    hexa run adjustment.hexa --selftest
//    hexa run adjustment.hexa --check  [--port <path>]
//    hexa run adjustment.hexa --watch  [--port <path>]
//    hexa run adjustment.hexa --live   [--port <path>] [--fps <n>]
//
//
//  @resolver-bypass(reason="darwin-native: legacy backend uses BrainFlow venv +
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima-eeg-core/_hw/adjustment/1"
let MODULE_NAME  = "adjustment"
let LEGACY_PATH  = "anima-eeg/electrode_adjustment_helper.hexa"

// ─── helpers ────────────────────────────────────────────────────────────

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0
    let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn count_substr(blob: string, needle: string) -> int {
    let mut count = 0
    let mut pos = 0
    let bn = len(blob); let nn = len(needle)
    if nn == 0 { return 0 }
    while pos <= bn - nn {
        let sub = blob.substring(pos, pos + nn)
        if sub == needle { count = count + 1; pos = pos + nn }
        else { pos = pos + 1 }
    }
    return count
}

// ─── public-ish API ────────────────────────────────────────────────────

fn _hw_adjustment_kv(mode: string, port: string, fps: int) -> string {
    let mut args = ""
    if mode == "selftest" {
        args = "--selftest"
    } else { if mode == "watch" {
        args = "--watch"
        if port != "" { args = args + " --port " + _sh_quote(port) }
    } else { if mode == "live" {
        args = "--live --fps " + str(fps)
        if port != "" { args = args + " --port " + _sh_quote(port) }
    } else {
        args = "--check"
        if port != "" { args = args + " --port " + _sh_quote(port) }
    } } }
    let cmd = _hexa_bin() + " " + LEGACY_PATH + " " + args
    eprintln("[_hw/adjustment] cmd=" + cmd)
    let r = exec_with_status(cmd)
    let out = to_string(r[0])
    let rc  = to_int(r[1])

    // Legacy emits "SUMMARY: N/16 OK, N/16 LOOSE, N/16 BAD, N/16 DEAD" + an
    // "active_count=N" line in live mode. Pull the SUMMARY counts via simple
    // substring frequency on the per-channel state markers (each channel
    // emits "[✓] OK" / "[⚠] LOOSE" / "[✗] BAD" / "[⚡] DEAD" once).
    // The "16/16 OK" SUMMARY also satisfies our heuristic — both are valid.
    let ok_count    = count_substr(out, "/16 OK")
    let loose_count = count_substr(out, "/16 LOOSE")
    let bad_count   = count_substr(out, "/16 BAD")
    let dead_count  = count_substr(out, "/16 DEAD")
    // Convert "16/16 OK" → ok_count=16 by parsing the prefix int from SUMMARY
    let mut ok_real = 0
    let mut loose_real = 0
    let mut bad_real = 0
    let mut dead_real = 0
    let sp = find_in_str(out, "SUMMARY: ")
    if sp >= 0 {
        let n = len(out); let mut q = sp + 9
        // parse "N/16 OK, M/16 LOOSE, ..."
        // simple: extract first int (ok)
        let mut acc = 0; let mut got = 0
        while q < n && out[q] != "/" {
            if is_digit_ch(out[q]) == 1 { acc = acc * 10 + digit_val(out[q]); got = 1 }
            q = q + 1
        }
        if got == 1 { ok_real = acc }
        // skip to next int after ", "
        while q < n && out[q] != "," { q = q + 1 }
        acc = 0; got = 0
        while q < n && out[q] != "/" {
            if is_digit_ch(out[q]) == 1 { acc = acc * 10 + digit_val(out[q]); got = 1 }
            q = q + 1
        }
        if got == 1 { loose_real = acc }
        while q < n && out[q] != "," { q = q + 1 }
        acc = 0; got = 0
        while q < n && out[q] != "/" {
            if is_digit_ch(out[q]) == 1 { acc = acc * 10 + digit_val(out[q]); got = 1 }
            q = q + 1
        }
        if got == 1 { bad_real = acc }
        while q < n && out[q] != "," { q = q + 1 }
        acc = 0; got = 0
        while q < n && out[q] != "/" {
            if is_digit_ch(out[q]) == 1 { acc = acc * 10 + digit_val(out[q]); got = 1 }
            q = q + 1
        }
        if got == 1 { dead_real = acc }
    }
    let final_ok    = if ok_real    > 0 { ok_real }    else { ok_count }
    let final_loose = if loose_real > 0 { loose_real } else { loose_count }
    let final_bad   = if bad_real   > 0 { bad_real }   else { bad_count }
    let final_dead  = if dead_real  > 0 { dead_real }  else { dead_count }
    let active_count = parse_int_kv(out, "active_count=")

    let mut triggered = ""
    let mut trig_count = 0
    if final_dead >= 4 { triggered = triggered + "F_ADJ_01,"; trig_count = trig_count + 1 }
    if final_ok == 0 && mode != "selftest" {
        triggered = triggered + "F_ADJ_02,"; trig_count = trig_count + 1
    }
    if final_bad >= 12 { triggered = triggered + "F_ADJ_03,"; trig_count = trig_count + 1 }
    if rc != 0 { triggered = triggered + "F_ADJ_04,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "FAIL"
    if rc == 0 && trig_count == 0 {
        if final_ok >= 12 { verdict = "PASS" } else { verdict = "PARTIAL" }
    }
    if mode == "selftest" && rc == 0 { verdict = "PASS" }

    let active_emit = if active_count == -2147483647 { 0 } else { active_count }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "op=adjust\n"
    kv = kv + "mode=" + mode + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "ok_count=" + str(final_ok) + "\n"
    kv = kv + "loose_count=" + str(final_loose) + "\n"
    kv = kv + "bad_count=" + str(final_bad) + "\n"
    kv = kv + "dead_count=" + str(final_dead) + "\n"
    kv = kv + "active_count=" + str(active_emit) + "\n"
    kv = kv + "value_x1000=" + str(final_ok * 1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_rc=" + str(rc) + "\n"
    kv = kv + "raw71_falsifier_count=4\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=B9_multi_channel_touch_threshold_dev_abs_rel\n"
    kv = kv + "raw91_limit=ANSI_renderer_assumes_terminal+host_USB_only\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run adjustment.hexa --selftest")
    eprintln("       hexa run adjustment.hexa --check [--port <path>]")
    eprintln("       hexa run adjustment.hexa --watch [--port <path>]")
    eprintln("       hexa run adjustment.hexa --live  [--port <path>] [--fps <n>]")
}

fn main() {
    let av = _flags_only_argv()
    let mut mode = ""
    let mut port = ""
    let mut fps = 60
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { mode = "selftest"; i = i + 1; continue }
        if a == "--check"    { mode = "check"; i = i + 1; continue }
        if a == "--watch"    { mode = "watch"; i = i + 1; continue }
        if a == "--live"     { mode = "live"; i = i + 1; continue }
        if a == "--port"     { port = av[i+1]; i = i + 2; continue }
        if a == "--fps"      { fps = to_int(av[i+1]); i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if mode == "" {
        eprintln("ABORT: need --selftest|--check|--watch|--live")
        _print_usage()
        exit(2)
    }

    if mode == "selftest" {
        println("== _hw/adjustment selftest (mock — no hardware required) ==")
    }
    let kv = _hw_adjustment_kv(mode, port, fps)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    if find_in_str(kv, "verdict=PARTIAL") >= 0 { exit(7) }
    exit(1)
}
