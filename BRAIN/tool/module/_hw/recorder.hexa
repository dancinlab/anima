// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_hw/recorder.hexa  (Phase 5 — _hw module #5)
//
//  PURPOSE
//    BrainFlow streamer + N-minute segmentation + per-segment .npy + sidecar
//    implementation at anima-eeg/eeg_recorder.hexa (584 LoC, commit
//    a3714cbbf, 8 backends registered).
//
//    DECISION: WRAP. Legacy file is 584 LoC and includes BrainFlow capture
//    loop + multi-task orchestration + sidecar/ledger emission. Port would
//    duplicate the BrainFlow Python interop without functional gain. Wrapper
//    surfaces segment count + sidecar path + verdict to dispatcher so
//    downstream consumers (paradigms / pipelines) can chain reliably.
//
//    BrainFlow stdin streaming is currently invoked via subprocess + stdout
//    capture. Future hexa-lang feature: native BrainFlow binding or stdin
//    streaming primitive would remove the .venv-eeg dependency and allow
//    in-process segment emission.
//
//  API
//    _hw_recorder_kv(args_kv) -> string
//      schema=anima-eeg-core/_hw/recorder/1
//      op=measure
//      mode=<selftest|record|tasks>
//      duration_s=<int>
//      segment_s=<int>
//      task=<name>
//      verdict=<PASS|FAIL|PARTIAL>
//      segment_count=<int>
//      total_samples=<int>
//      sidecar_json_path=<path>
//      backend=anima-eeg/eeg_recorder.hexa
//      backend_rc=<int>
//      raw71_falsifier_count=4
//      raw71_triggered_ids=<csv>
//      raw91_evidence=BrainFlow_USB_capture+segmented_npy+sidecar_json_ledger
//      raw91_limit=inter_segment_gap_~1s_(DEGRADED_continuity_until_dual_stream)
//      raw95_enforce_layer=in_module
//
//  RAW#71 FALSIFIERS (4 preregistered, frozen 2026-04-28)
//    F_REC_01: backend_rc != 0       → BrainFlow capture failed
//    F_REC_02: segment_count == 0    → no .npy emitted (silent failure)
//    F_REC_03: total_samples < expected_min → batt low / port dropout
//    F_REC_04: missing sidecar_json  → ledger emission failed
//
//  CLI
//    hexa run recorder.hexa --selftest
//    hexa run recorder.hexa --record --task <name> --duration <n> [--segment <n>]
//    hexa run recorder.hexa --tasks <a,b,c> --per-task <n>
//
//
//  @resolver-bypass(reason="darwin-native: legacy backend uses BrainFlow
//                   .venv-eeg + USB FTDI dongle. Hardware always Mac local.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima-eeg-core/_hw/recorder/1"
let MODULE_NAME  = "recorder"
let LEGACY_PATH  = "anima-eeg/eeg_recorder.hexa"

// ─── helpers ────────────────────────────────────────────────────────────

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn is_digit_ch(c: string) -> int {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return 1 }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 }
    if c == "3" { return 3 } if c == "4" { return 4 } if c == "5" { return 5 }
    if c == "6" { return 6 } if c == "7" { return 7 } if c == "8" { return 8 }
    if c == "9" { return 9 } ; return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob); let mut q = kp + len(key); let mut acc = 0
    let mut neg = 0; let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) == 1 { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn parse_str_kv(blob: string, key: string) -> string {
    let kp = find_in_str(blob, key)
    if kp < 0 { return "" }
    let n = len(blob); let mut q = kp + len(key)
    let mut out = ""
    while q < n && blob[q] != "\n" { out = out + blob[q]; q = q + 1 }
    return out.trim()
}

fn count_substr(blob: string, needle: string) -> int {
    let mut count = 0
    let mut pos = 0
    let bn = len(blob); let nn = len(needle)
    if nn == 0 { return 0 }
    while pos <= bn - nn {
        let sub = blob.substring(pos, pos + nn)
        if sub == needle { count = count + 1; pos = pos + nn }
        else { pos = pos + 1 }
    }
    return count
}

// ─── public-ish API ────────────────────────────────────────────────────

// parser that fails on the `hexa.real` binary path (predates the lenient
// synthesizes a mock kv-block for selftest. Real-mode (--record / --tasks)
fn _hw_recorder_mock_kv(task: string, duration_s: int) -> string {
    let mut out = ""
    out = out + "segment_count=2\n"
    out = out + "total_samples=" + str(duration_s * 125) + "\n"
    out = out + "session_path=recordings/sessions/selftest_synthetic_session.json\n"
    out = out + "task=" + task + "\n"
    out = out + "selftest=mock_synthetic_16ch_2seg\n"
    return out
}

fn _hw_recorder_kv(mode: string, task: string, duration_s: int,
                   segment_s: int, port: string) -> string {
    let mut out = ""
    let mut rc = 0
    if mode == "selftest" {
        out = _hw_recorder_mock_kv(task, duration_s)
        rc = 0
    } else { if mode == "tasks" {
        // task is a CSV of tasks here
        let mut args = "--tasks " + _sh_quote(task) + " --per-task " + str(duration_s)
        if port != "" { args = args + " --port " + _sh_quote(port) }
        let cmd = _hexa_bin() + " run " + LEGACY_PATH + " " + args
        eprintln("[_hw/recorder] cmd=" + cmd)
        let r = exec_with_status(cmd)
        out = to_string(r[0])
        rc  = to_int(r[1])
    } else {
        let mut args = "--record --task " + _sh_quote(task) + " --duration " + str(duration_s)
                + " --segment " + str(segment_s)
        if port != "" { args = args + " --port " + _sh_quote(port) }
        let cmd = _hexa_bin() + " run " + LEGACY_PATH + " " + args
        eprintln("[_hw/recorder] cmd=" + cmd)
        let r = exec_with_status(cmd)
        out = to_string(r[0])
        rc  = to_int(r[1])
    } }

    // legacy emits "segment_count=N", "session_path=...", "total_samples=N"
    // Fall back to substring counting of "segment_" file paths if explicit
    let mut seg_count = parse_int_kv(out, "segment_count=")
    if seg_count == -2147483647 {
        seg_count = count_substr(out, ".npy")
    }
    let total_samples = parse_int_kv(out, "total_samples=")
    let sidecar = parse_str_kv(out, "session_path=")
    let sidecar_alt = parse_str_kv(out, "sidecar_json_path=")
    let mut sidecar_final = sidecar
    if sidecar_final == "" { sidecar_final = sidecar_alt }

    // Expected min samples = duration_s * 125 Hz * 0.8 (allow for 20% loss)
    let expected_min = (duration_s * 125 * 8) / 10

    let mut triggered = ""
    let mut trig_count = 0
    if rc != 0 { triggered = triggered + "F_REC_01,"; trig_count = trig_count + 1 }
    if seg_count == 0 && mode != "selftest" {
        triggered = triggered + "F_REC_02,"; trig_count = trig_count + 1
    }
    if total_samples != -2147483647 && total_samples > 0 && total_samples < expected_min && mode != "selftest" {
        triggered = triggered + "F_REC_03,"; trig_count = trig_count + 1
    }
    if sidecar_final == "" && mode != "selftest" {
        triggered = triggered + "F_REC_04,"; trig_count = trig_count + 1
    }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "FAIL"
    if rc == 0 && trig_count == 0 { verdict = "PASS" }
    if mode == "selftest" && rc == 0 { verdict = "PASS" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "op=measure\n"
    kv = kv + "mode=" + mode + "\n"
    kv = kv + "duration_s=" + str(duration_s) + "\n"
    kv = kv + "segment_s=" + str(segment_s) + "\n"
    kv = kv + "task=" + task + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "segment_count=" + str(seg_count) + "\n"
    kv = kv + "total_samples=" + str(total_samples) + "\n"
    kv = kv + "sidecar_json_path=" + sidecar_final + "\n"
    kv = kv + "value_x1000=" + str(seg_count * 1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_rc=" + str(rc) + "\n"
    kv = kv + "raw71_falsifier_count=4\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=BrainFlow_USB_capture+segmented_npy+sidecar_json_ledger\n"
    kv = kv + "raw91_limit=inter_segment_gap_1s_DEGRADED_continuity_until_dual_stream\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run recorder.hexa --selftest")
    eprintln("       hexa run recorder.hexa --record --task <name> --duration <n> [--segment <n>]")
    eprintln("       hexa run recorder.hexa --tasks <a,b,c> --per-task <n>")
}

fn main() {
    let av = _flags_only_argv()
    let mut mode = ""
    let mut task = "selftest_synthetic"
    let mut duration_s = 5
    let mut segment_s = 60
    let mut port = ""
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"  { mode = "selftest"; i = i + 1; continue }
        if a == "--record"    { mode = "record"; i = i + 1; continue }
        if a == "--tasks"     { mode = "tasks"; task = av[i+1]; i = i + 2; continue }
        if a == "--task"      { task = av[i+1]; i = i + 2; continue }
        if a == "--duration"  { duration_s = to_int(av[i+1]); i = i + 2; continue }
        if a == "--per-task"  { duration_s = to_int(av[i+1]); i = i + 2; continue }
        if a == "--segment"   { segment_s = to_int(av[i+1]); i = i + 2; continue }
        if a == "--port"      { port = av[i+1]; i = i + 2; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if mode == "" {
        eprintln("ABORT: need --selftest|--record|--tasks")
        _print_usage()
        exit(2)
    }

    if mode == "selftest" {
        println("== _hw/recorder selftest (mock — synthetic 16ch x 5s x 125Hz) ==")
    }
    let kv = _hw_recorder_kv(mode, task, duration_s, segment_s, port)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    if find_in_str(kv, "verdict=PARTIAL") >= 0 { exit(7) }
    exit(1)
}
