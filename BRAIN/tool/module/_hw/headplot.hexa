// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg-core/tool/modules/_hw/headplot.hexa  (Phase 5 — _hw module #4)
//
//  PURPOSE
//    10-20 ASCII headplot renderer (80×30 anatomical scalp top-down view) +
//    fixpoint: WRAPS the frozen legacy implementation at
//    anima-eeg/headplot_helper.hexa (468 LoC).
//
//    DECISION: WRAP. Legacy file is 468 LoC and includes the OpenBCI
//    ElectrodeState 5-color RGB scheme + ANSI 24-bit escape sequences +
//    coordinate map (Fp1/Fp2/F3/F4/.../O1/O2). Re-implementing the visual
//    grid in pure hexa is feasible but yields no functional gain over the
//
//  API
//    _hw_headplot_kv(args_kv) -> string
//      schema=anima-eeg-core/_hw/headplot/1
//      op=export
//      mode=<selftest|demo>
//      verdict=<PASS|FAIL>
//      ascii_lines_count=<int>
//      no_color=<int>     (1 if NO_COLOR env set)
//      backend=anima-eeg/headplot_helper.hexa
//      backend_rc=<int>
//      raw71_falsifier_count=3
//      raw71_triggered_ids=<csv>
//      raw91_evidence=10_20_anatomical_scalp_grid+OpenBCI_ElectrodeState_RGB
//      raw91_limit=ANSI_24bit_assumes_truecolor_term_(NO_COLOR_strips)
//      raw95_enforce_layer=in_module
//
//  RAW#71 FALSIFIERS (3 preregistered, frozen 2026-04-28)
//    F_HP_01: backend_rc != 0          → renderer helper failed
//    F_HP_02: ascii_lines_count < 20   → grid truncated / helper malformed
//    F_HP_03: ascii_lines_count > 200  → renderer infinite-loop / runaway
//
//  CLI
//    hexa run headplot.hexa --selftest
//    hexa run headplot.hexa --demo       (mixed-state demo)
//
//
//  @resolver-bypass(reason="darwin-native: legacy backend uses .venv-eeg
//                   helper for grid composition + truecolor ANSI escapes.")
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA       = "anima-eeg-core/_hw/headplot/1"
let MODULE_NAME  = "headplot"
let LEGACY_PATH  = "anima-eeg/headplot_helper.hexa"

// ─── helpers ────────────────────────────────────────────────────────────

fn _hexa_bin() -> string {
    let hl = env("HEXA_LANG")
    if hl != "" { return hl + "/hexa.real" }
    return "/Users/ghost/core/hexa-lang/hexa.real"
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s); let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0; let mut ok = 1
        while j < m { if s[i + j] != needle[j] { ok = 0; j = m }; j = j + 1 }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

// Count occurrences of a single character (newline counter for line counts)
fn count_char(blob: string, ch: string) -> int {
    let n = len(blob); let mut count = 0; let mut i = 0
    while i < n { if blob[i] == ch { count = count + 1 }; i = i + 1 }
    return count
}

// ─── public-ish API ────────────────────────────────────────────────────

fn _hw_headplot_kv(mode: string) -> string {
    let mut args = ""
    if mode == "demo" { args = "--demo" } else { args = "--selftest" }
    let cmd = _hexa_bin() + " " + LEGACY_PATH + " " + args
    eprintln("[_hw/headplot] cmd=" + cmd)
    let r = exec_with_status(cmd)
    let out = to_string(r[0])
    let rc  = to_int(r[1])

    let lines_count = count_char(out, "\n")
    let no_color = env("NO_COLOR")
    let nc_flag = if no_color == "" { 0 } else { 1 }

    let mut triggered = ""
    let mut trig_count = 0
    if rc != 0 { triggered = triggered + "F_HP_01,"; trig_count = trig_count + 1 }
    if lines_count < 20 { triggered = triggered + "F_HP_02,"; trig_count = trig_count + 1 }
    if lines_count > 200 { triggered = triggered + "F_HP_03,"; trig_count = trig_count + 1 }
    let nT = len(triggered)
    if nT > 0 { triggered = triggered.substring(0, nT - 1) }

    let mut verdict = "FAIL"
    if rc == 0 && trig_count == 0 { verdict = "PASS" }

    let mut kv = ""
    kv = kv + "schema=" + SCHEMA + "\n"
    kv = kv + "module=" + MODULE_NAME + "\n"
    kv = kv + "op=export\n"
    kv = kv + "mode=" + mode + "\n"
    kv = kv + "verdict=" + verdict + "\n"
    kv = kv + "ascii_lines_count=" + str(lines_count) + "\n"
    kv = kv + "no_color=" + str(nc_flag) + "\n"
    kv = kv + "value_x1000=" + str(lines_count * 1000) + "\n"
    kv = kv + "backend=" + LEGACY_PATH + "\n"
    kv = kv + "backend_rc=" + str(rc) + "\n"
    kv = kv + "raw71_falsifier_count=3\n"
    kv = kv + "raw71_triggered_count=" + str(trig_count) + "\n"
    kv = kv + "raw71_triggered_ids=" + triggered + "\n"
    kv = kv + "raw91_evidence=10_20_anatomical_scalp_grid+OpenBCI_ElectrodeState_RGB\n"
    kv = kv + "raw91_limit=ANSI_24bit_assumes_truecolor_term_NO_COLOR_strips\n"
    kv = kv + "raw95_enforce_layer=in_module\n"
    return kv
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_prefix = false
        if a.ends_with(".hexa") { is_prefix = true }
        if !is_prefix { if a.ends_with("/exe") { is_prefix = true } }
        if !is_prefix { if a == "run" { is_prefix = true } }
        if !is_prefix { if a.ends_with("hexa.real") || a.ends_with("/hexa") { is_prefix = true } }
        if is_prefix { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run headplot.hexa --selftest")
    eprintln("       hexa run headplot.hexa --demo")
}

fn main() {
    let av = _flags_only_argv()
    let mut mode = ""
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { mode = "selftest"; i = i + 1; continue }
        if a == "--demo"     { mode = "demo"; i = i + 1; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        i = i + 1
    }

    if mode == "" {
        eprintln("ABORT: need --selftest or --demo")
        _print_usage()
        exit(2)
    }

    if mode == "selftest" {
        println("== _hw/headplot selftest (mock — no hardware required) ==")
    }
    let kv = _hw_headplot_kv(mode)
    print(kv)
    if find_in_str(kv, "verdict=PASS") >= 0 { exit(0) }
    exit(1)
}
