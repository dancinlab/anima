// anima-eeg-core/tool/modules/_core/jsonl_audit.hexa
//
// PURPOSE
//   Phase 1 _core/ module #3 — append/read JSONL audit ledgers.
//   chflags-aware: caller must pre-unlock locked ledger files; this module emits
//   warning if write fails due to uchg.
//
// API
//   _core_emit_audit_row(ledger_path: string, row_kv_csv: string) -> bool
//     row_kv_csv = "k1=v1,k2=v2,..." (commas/equals inside values must be escaped)
//   _core_read_audit_jsonl(ledger_path: string) -> string
//     returns the entire ledger body (caller parses lines).
//   _core_count_audit_rows(ledger_path: string) -> int
//
// CLI
//   hexa run jsonl_audit.hexa --selftest
//   hexa run jsonl_audit.hexa --emit  --ledger <p>  --row "k1=v1,k2=v2"
//   hexa run jsonl_audit.hexa --read  --ledger <p>
//   hexa run jsonl_audit.hexa --count --ledger <p>

let SCHEMA = "anima-eeg-core/_core/jsonl_audit/1"

// ─── helpers ────────────────────────────────────────────────────────────

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _ensure_parent_dir(path: string) {
    // strip last "/x" segment
    let mut p = ""
    let parts = path.split("/")
    let mut i = 0
    let last = len(parts) - 1
    while i < last {
        if i > 0 { p = p + "/" }
        p = p + parts[i]
        i = i + 1
    }
    if p == "" { return }
    exec("mkdir -p " + p)
}

fn _now_unix_string() -> string {
    let r = exec_with_status("date +%s")
    return to_string(r[0]).trim()
}

fn _row_csv_to_json(row_csv: string) -> string {
    // Parse k=v,k=v,... into a JSON object string. Heuristics:
    //   • numeric (int/float) values emit unquoted
    //   • everything else quoted; embedded " escaped
    let mut json = "{"
    let pairs = row_csv.split(",")
    let mut i = 0
    let mut first = true
    while i < len(pairs) {
        let kv = pairs[i].trim()
        if kv == "" { i = i + 1; continue }
        let eq = kv.index_of("=")
        if eq < 0 { i = i + 1; continue }
        let k = kv.substring(0, eq).trim()
        let v = kv.substring(eq + 1, kv.len()).trim()
        if !first { json = json + "," }
        first = false
        json = json + "\"" + k + "\":"
        // numeric heuristic: optional minus, digits, optional dot+digits
        let mut numeric = false
        if v.len() > 0 {
            let s0 = v
            let mut j = 0
            if s0.len() > 0 && s0.substring(0,1) == "-" { j = 1 }
            let mut have_digit = false
            let mut have_dot = false
            let mut all_ok = true
            while j < s0.len() {
                let c = s0.substring(j, j+1)
                if c >= "0" && c <= "9" { have_digit = true }
                else if c == "." && !have_dot { have_dot = true }
                else { all_ok = false; break }
                j = j + 1
            }
            if have_digit && all_ok { numeric = true }
        }
        if numeric {
            json = json + v
        } else {
            let esc = v.replace("\\", "\\\\").replace("\"", "\\\"")
            json = json + "\"" + esc + "\""
        }
        i = i + 1
    }
    json = json + "}"
    return json
}

// ─── public-ish API ────────────────────────────────────────────────────

fn _core_emit_audit_row(ledger_path: string, row_csv: string) -> bool {
    _ensure_parent_dir(ledger_path)
    let json_row = _row_csv_to_json(row_csv)
    let nl = chr(10)
    let prior = read_file(ledger_path)
    let mut existing = ""
    if prior != "" { existing = prior }
    write_file(ledger_path, existing + json_row + nl)
    // verify line was appended
    let after = read_file(ledger_path)
    return after.len() > existing.len()
}

fn _core_read_audit_jsonl(ledger_path: string) -> string {
    return read_file(ledger_path)
}

fn _core_count_audit_rows(ledger_path: string) -> int {
    let body = read_file(ledger_path)
    if body == "" { return 0 }
    let lines = body.split("\n")
    let mut n = 0
    let mut i = 0
    while i < len(lines) {
        if lines[i].trim() != "" { n = n + 1 }
        i = i + 1
    }
    return n
}

// ─── CLI ───────────────────────────────────────────────────────────────

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path { if a.ends_with("/exe") { is_path = true } }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn _print_usage() {
    eprintln("usage: hexa run jsonl_audit.hexa --selftest")
    eprintln("       hexa run jsonl_audit.hexa --emit --ledger <p> --row 'k=v,k=v'")
    eprintln("       hexa run jsonl_audit.hexa --read  --ledger <p>")
    eprintln("       hexa run jsonl_audit.hexa --count --ledger <p>")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut emit_mode = false
    let mut read_mode = false
    let mut count_mode = false
    let mut ledger_path = ""
    let mut row_csv = ""

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--emit"     { emit_mode = true; i = i + 1; continue }
        if a == "--read"     { read_mode = true; i = i + 1; continue }
        if a == "--count"    { count_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { _print_usage(); exit(0) }
        if a == "--ledger"   { ledger_path = av[i+1]; i = i + 2; continue }
        if a == "--row"      { row_csv     = av[i+1]; i = i + 2; continue }
        eprintln("unknown arg: " + a); _print_usage(); exit(2)
    }

    if selftest {
        println("== _core jsonl_audit selftest ==")
        let path = "/tmp/anima_eeg_core_jsonl_audit_selftest.jsonl"
        exec("rm -f " + path)
        let mut pass = 0
        let mut fail = 0

        // emit row 1
        let ts = _now_unix_string()
        let row1 = "ts=" + ts + ",tool=_core/jsonl_audit,mode=selftest,input=synth1,sha256=deadbeef,metric_x=1.5"
        let ok1 = _core_emit_audit_row(path, row1)
        let t1 = assert_true(ok1, "emit row1 returned true")
        if t1 { pass = pass + 1 } else { fail = fail + 1 }

        // emit row 2
        let row2 = "ts=" + ts + ",tool=_core/jsonl_audit,mode=selftest,input=synth2,sha256=cafef00d,metric_x=2.7"
        let ok2 = _core_emit_audit_row(path, row2)
        let t2 = assert_true(ok2, "emit row2 returned true")
        if t2 { pass = pass + 1 } else { fail = fail + 1 }

        // count = 2
        let n = _core_count_audit_rows(path)
        let t3 = assert_true(n == 2, "count_audit_rows == 2 (got " + to_string(n) + ")")
        if t3 { pass = pass + 1 } else { fail = fail + 1 }

        // read body contains both inputs
        let body = _core_read_audit_jsonl(path)
        let t4 = assert_true(body.contains("synth1"), "ledger contains synth1")
        if t4 { pass = pass + 1 } else { fail = fail + 1 }
        let t5 = assert_true(body.contains("synth2"), "ledger contains synth2")
        if t5 { pass = pass + 1 } else { fail = fail + 1 }

        // numeric heuristic: metric_x must be unquoted
        let t6 = assert_true(body.contains("\"metric_x\":1.5"), "metric_x emitted as numeric (1.5)")
        if t6 { pass = pass + 1 } else { fail = fail + 1 }

        // string heuristic: tool must be quoted
        let t7 = assert_true(body.contains("\"tool\":\"_core/jsonl_audit\""), "tool field quoted")
        if t7 { pass = pass + 1 } else { fail = fail + 1 }

        // schema printed for sentinel
        println("schema=" + SCHEMA)
        println("ledger_path=" + path)
        println("rows_after=" + to_string(n))
        println("selftest=ok")
        let t8 = assert_true(SCHEMA == "anima-eeg-core/_core/jsonl_audit/1", "schema constant matches")
        if t8 { pass = pass + 1 } else { fail = fail + 1 }

        println("")
        println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL")
        if fail != 0 { exit(1) }
        println("selftest: OK")
        exit(0)
    }

    if emit_mode {
        if ledger_path == "" || row_csv == "" {
            eprintln("ABORT: --emit needs --ledger and --row"); exit(2)
        }
        let ok = _core_emit_audit_row(ledger_path, row_csv)
        println("ledger_path=" + ledger_path)
        println("emit_ok=" + (if ok { "true" } else { "false" }))
        if !ok { exit(1) }
        exit(0)
    }

    if read_mode {
        if ledger_path == "" { eprintln("ABORT: --read needs --ledger"); exit(2) }
        print(_core_read_audit_jsonl(ledger_path))
        exit(0)
    }

    if count_mode {
        if ledger_path == "" { eprintln("ABORT: --count needs --ledger"); exit(2) }
        let n = _core_count_audit_rows(ledger_path)
        println("rows=" + to_string(n))
        exit(0)
    }

    eprintln("ABORT: need --selftest|--emit|--read|--count")
    _print_usage()
    exit(2)
}
