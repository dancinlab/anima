// ════════════════════════════════════════════════════════════════════════════
//  anima-clm-eeg/tool/eeg_anomaly_autoencoder.hexa
//
//  PURPOSE  (anima B10 — anomaly detection ML)
//    Per-segment unsupervised state-shift detector.  Welch PSD per (ch, band) →
//    80-d feature → autoencoder reconstruction error → z-score; segments with
//    z > 2 are flagged as anomalies (drowsy onset, motion artifact, state
//    transition).  Pure-numpy autoencoder (no torch) — deterministic seeded
//
//  ALGORITHM
//    1. Filter (notch 60 Hz already done upstream; bandpass via PSD masking).
//    2. scipy.signal.welch (Hann, nperseg=125, no overlap) per channel.
//    3. Per (ch, band) integrate PSD: bands = δ 1-4, θ 4-8, α 8-13, β 13-30,
//       γ 30-45 Hz.  log10(power + 1e-12).  → 80-d feature per segment.
//    4. Per-feature z-score using train μ, σ (saved with model).
//    5. Autoencoder 80 → 40 → 20 → 8 → 20 → 40 → 80 (tanh hidden, linear in/out).
//       Manual NumPy forward/backward, batch SGD, lr=0.01, batch=16, epochs∈
//       [100, 300] with early-stop (val_loss plateau), seed=17.
//    6. reconstruction_error = MSE(input, output) per segment.
//    7. Train-set μ_e, σ_e of the error → per-segment z-score on inference.
//    8. Flag if z > 2 (95% CI).
//
//    C1 train converges        : final_train_loss < 0.5 · initial_train_loss
//    C2 not overfit            : val_loss ≤ 2.0 · train_loss
//    C3 baseline calibrated    : ≥80% held-out baseline segments have z ≤ 2
//    C4 anomaly detected       : injected-anomaly segments median z ≥ 2
//    C5 not all-anomaly        : < 50% of training segments self-flag on re-eval
//
//    PASS    : C1∧C2∧C3∧C4∧C5
//    PARTIAL : C1∧C2 hold but exactly one of {C3,C4,C5} fails
//    FAIL    : C1 or C2 fails (model did not learn)
//
//    F1 train loss not decreasing       — selftest-mode=flat-loss (1 epoch only)
//    F2 self-anomaly on re-run          — covered by C5
//    F3 overfit (val ≫ train)           — selftest-mode=tiny-n (N=10)
//    F4 bottleneck-8 under PCA(8)       — --ablation-pca compares AE vs PCA AUC
//    F5 every segment flagged           — covered by C5 (re-eval > 50% flag)
//
//  RAW
//    own 5   genus + algo + hyperparams + ablation + falsifiers
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python on host; numpy+scipy+sklearn only — no torch needed")
// ════════════════════════════════════════════════════════════════════════════

let SAMPLE_RATE_HZ          = 125
let SEGMENT_SECONDS_X10      = 50      // 5.0 s
let N_CHANNELS              = 16
let N_BANDS                 = 5
let FEATURE_DIM             = 80      // 16 × 5
let BOTTLENECK_DIM          = 8
let EPOCHS_MIN              = 100
let EPOCHS_MAX              = 500
let LEARNING_RATE_X1000     = 20      // 0.020
let BATCH_SIZE              = 16
let Z_THRESHOLD_X1000       = 2000    // 2.000
let SEED                    = 17
let MIN_BASELINE_N          = 50

// pass thresholds (×1000 fixed point)
let C1_DECAY_RATIO_MAX_X1000 = 500    // final < 0.5 × initial
let C3_CAL_OK_FRAC_MIN_X1000 = 800    // ≥ 80% held-out z ≤ 2
let C4_INJECT_MEDIAN_Z_X1000 = 2000   // injected median z ≥ 2.0
let C5_REEVAL_FLAG_FRAC_MAX_X1000 = 500 // < 50% self-flag

// ─── env helpers ──────────────────────────────────────────────────────────
fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key)
    let mut acc = 0
    let mut neg = 0
    let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn now_iso() -> string {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn now_date_utc() -> string {
    return exec("date -u +%Y-%m-%d").trim()
}

fn sha256_of_file(path: string) -> string {
    if path == "" { return "" }
    let cmd = "shasum -a 256 \"" + path + "\" 2>/dev/null | awk '{print $1}'"
    let h = exec(cmd).trim()
    if h == "" { return "unavailable" }
    return h
}

let HELPER_PATH = "state/.eeg_anom_helper.py"
let DUMP_PATH   = "state/.eeg_anom_dump.txt"

fn _write_helper() {
    let py = "#!/usr/bin/env python3
# eeg_anomaly_autoencoder helper — auto-generated by anima-clm-eeg/tool/eeg_anomaly_autoencoder.hexa
import sys, os, math, json
try:
    import numpy as np
    from scipy.signal import welch
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

# ─── frozen hyperparameters (mirror .hexa) ───────────────────────────────
SAMPLE_RATE_HZ = 125
SEGMENT_SAMPLES = 5 * SAMPLE_RATE_HZ  # 625
N_CHANNELS = 16
BANDS = [(1.0, 4.0), (4.0, 8.0), (8.0, 13.0), (13.0, 30.0), (30.0, 45.0)]
N_BANDS = len(BANDS)
FEATURE_DIM = N_CHANNELS * N_BANDS
BOTTLENECK_DIM = 8
EPOCHS_MIN = 100
EPOCHS_MAX = 500
LR = 0.02
BATCH_SIZE = 16
Z_THRESHOLD = 2.0
SEED = 17
MIN_BASELINE_N = 50

if len(sys.argv) < 4:
    sys.stderr.write('usage: helper <mode> <kind|input.npy> <out.txt> [ablation_pca]\\n')
    sys.exit(2)

mode = sys.argv[1]
src = sys.argv[2]
out_path = sys.argv[3]
ablation_pca = (len(sys.argv) >= 5 and sys.argv[4] == '1')

# ─── feature extraction ──────────────────────────────────────────────────
def segment_to_feature(seg):
    # seg shape (N_CHANNELS, SEGMENT_SAMPLES)
    feat = np.zeros((N_CHANNELS, N_BANDS), dtype=np.float64)
    for ch in range(N_CHANNELS):
        f, p = welch(seg[ch, :], fs=SAMPLE_RATE_HZ, nperseg=125, noverlap=0,
                     window='hann', detrend='constant')
        for j, (lo, hi) in enumerate(BANDS):
            mask = (f >= lo) & (f < hi)
            if mask.any():
                feat[ch, j] = np.log10(p[mask].sum() + 1e-12)
            else:
                feat[ch, j] = -12.0
    return feat.reshape(-1)

def features_from_segments(segs):
    X = np.zeros((len(segs), FEATURE_DIM), dtype=np.float64)
    for i, s in enumerate(segs):
        X[i, :] = segment_to_feature(s)
    return X

# ─── synthetic data (selftest) ──────────────────────────────────────────
def make_baseline_segments(n, rng):
    # Synthetic eyes-closed resting EEG: 1/f^alpha background + alpha rhythm.
    # Tight manifold: per-segment alpha-rhythm phase shared across channels
    # (frontoparietal alpha is broadly synchronous in resting EC); only noise
    # varies per channel. This produces stable per-band powers across
    # segments, mimicking real EEG band-power stability.
    segs = []
    for k in range(n):
        seg = np.zeros((N_CHANNELS, SEGMENT_SAMPLES), dtype=np.float64)
        t = np.arange(SEGMENT_SAMPLES) / SAMPLE_RATE_HZ
        seg_phase = rng.uniform(0, 2*np.pi, size=5)  # one phase per band, shared cross-ch
        for ch in range(N_CHANNELS):
            x = np.zeros(SEGMENT_SAMPLES)
            for j, f0 in enumerate((2.0, 5.0, 10.0, 18.0, 35.0)):
                amp = 1.5 / f0
                x += amp * np.sin(2*np.pi*f0*t + seg_phase[j])
            x += 0.03 * rng.normal(0, 1, SEGMENT_SAMPLES)
            x += 0.8 * np.sin(2*np.pi*10.0*t + seg_phase[2])
            seg[ch, :] = x
        segs.append(seg)
    return segs

def make_anomaly_segments(n, rng):
    # high-amplitude beta burst + step artifact (simulated motion)
    segs = []
    for k in range(n):
        seg = np.zeros((N_CHANNELS, SEGMENT_SAMPLES), dtype=np.float64)
        t = np.arange(SEGMENT_SAMPLES) / SAMPLE_RATE_HZ
        for ch in range(N_CHANNELS):
            x = 0.2 * rng.normal(0, 1, SEGMENT_SAMPLES)
            # huge beta burst — atypical of resting eyes-closed
            x += 5.0 * np.sin(2*np.pi*22.0*t + rng.uniform(0,2*np.pi))
            # transient step
            j = rng.randint(50, SEGMENT_SAMPLES - 50)
            x[j:j+30] += 8.0
            seg[ch, :] = x
        segs.append(seg)
    return segs

# ─── numpy autoencoder ───────────────────────────────────────────────────
def init_ae(rng):
    # Glorot/tanh init; layers: 80→40→20→8→20→40→80
    def w(in_d, out_d):
        lim = math.sqrt(6.0 / (in_d + out_d))
        return rng.uniform(-lim, lim, size=(in_d, out_d))
    P = {}
    P['W1'] = w(80, 40); P['b1'] = np.zeros(40)
    P['W2'] = w(40, 20); P['b2'] = np.zeros(20)
    P['W3'] = w(20, 8);  P['b3'] = np.zeros(8)
    P['W4'] = w(8, 20);  P['b4'] = np.zeros(20)
    P['W5'] = w(20, 40); P['b5'] = np.zeros(40)
    P['W6'] = w(40, 80); P['b6'] = np.zeros(80)
    return P

def forward(P, X):
    # tanh hidden, linear bottleneck and output
    z1 = X @ P['W1'] + P['b1']; a1 = np.tanh(z1)
    z2 = a1 @ P['W2'] + P['b2']; a2 = np.tanh(z2)
    z3 = a2 @ P['W3'] + P['b3']; a3 = z3  # linear bottleneck
    z4 = a3 @ P['W4'] + P['b4']; a4 = np.tanh(z4)
    z5 = a4 @ P['W5'] + P['b5']; a5 = np.tanh(z5)
    z6 = a5 @ P['W6'] + P['b6']; a6 = z6  # linear output
    cache = (X, a1, a2, a3, a4, a5, a6)
    return a6, cache

def backward(P, cache, Y):
    X, a1, a2, a3, a4, a5, a6 = cache
    n = X.shape[0]
    g = {}
    d6 = (a6 - Y) * (2.0 / n)                 # MSE deriv (linear out)
    g['W6'] = a5.T @ d6;  g['b6'] = d6.sum(0)
    d5 = (d6 @ P['W6'].T) * (1.0 - a5*a5)
    g['W5'] = a4.T @ d5;  g['b5'] = d5.sum(0)
    d4 = (d5 @ P['W5'].T) * (1.0 - a4*a4)
    g['W4'] = a3.T @ d4;  g['b4'] = d4.sum(0)
    d3 = d4 @ P['W4'].T                        # linear bottleneck
    g['W3'] = a2.T @ d3;  g['b3'] = d3.sum(0)
    d2 = (d3 @ P['W3'].T) * (1.0 - a2*a2)
    g['W2'] = a1.T @ d2;  g['b2'] = d2.sum(0)
    d1 = (d2 @ P['W2'].T) * (1.0 - a1*a1)
    g['W1'] = X.T @ d1;   g['b1'] = d1.sum(0)
    return g

def sgd_step(P, g, lr, wd=1e-2):
    # SGD with L2 weight decay on weight matrices (not biases). High wd
    # (1e-2) is needed for small N (~120 train) on an 80-d input to
    for k in P.keys():
        if k.startswith('W'):
            P[k] -= lr * (g[k] + wd * P[k])
        else:
            P[k] -= lr * g[k]

def mse(Yh, Y):
    return float(((Yh - Y) ** 2).mean())

def per_sample_recon_err(Yh, Y):
    return ((Yh - Y) ** 2).mean(axis=1)

def train_ae(Xtr, Xva, epochs_min, epochs_max, lr, batch, seed, flat_loss=False):
    rng = np.random.RandomState(seed)
    P = init_ae(rng)
    n = Xtr.shape[0]
    Yh0, _ = forward(P, Xtr)
    init_train_loss = mse(Yh0, Xtr)
    best_val = float('inf'); best_epoch = -1; patience = 25; bad = 0
    history = []
    if flat_loss:
        # F1 falsifier: 1 epoch and no SGD steps → loss should NOT decrease
        Yht, _ = forward(P, Xtr)
        Yhv, _ = forward(P, Xva)
        history.append((mse(Yht, Xtr), mse(Yhv, Xva)))
        return P, history, init_train_loss
    for epoch in range(epochs_max):
        idx = rng.permutation(n)
        for s in range(0, n, batch):
            b_idx = idx[s:s+batch]
            Xb = Xtr[b_idx]
            Yh, cache = forward(P, Xb)
            g = backward(P, cache, Xb)
            sgd_step(P, g, lr)
        Yht, _ = forward(P, Xtr); tr = mse(Yht, Xtr)
        Yhv, _ = forward(P, Xva); va = mse(Yhv, Xva)
        history.append((tr, va))
        if va < best_val - 1e-6:
            best_val = va; best_epoch = epoch; bad = 0
        else:
            bad += 1
        if epoch >= epochs_min and bad >= patience:
            break
    return P, history, init_train_loss

# ─── PCA(8) ablation (F4) ────────────────────────────────────────────────
def pca_recon_err(Xtr, Xte, k):
    mu = Xtr.mean(0)
    A = Xtr - mu
    # SVD
    U, S, Vt = np.linalg.svd(A, full_matrices=False)
    Vk = Vt[:k]
    Z = (Xte - mu) @ Vk.T
    Xh = Z @ Vk + mu
    return ((Xh - Xte) ** 2).mean(axis=1)

# ─── load real data ──────────────────────────────────────────────────────
def load_real_segments(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 3:
        raise RuntimeError('expected 3-D (n_seg, 16, samples), got ndim=' + str(a.ndim))
    n, c, s = a.shape
    if c != N_CHANNELS:
        if s == N_CHANNELS:
            a = a.transpose(0, 2, 1)
            n, c, s = a.shape
        else:
            raise RuntimeError('cannot infer 16-ch axis from ' + str(a.shape))
    if s < SEGMENT_SAMPLES:
        raise RuntimeError('segment too short: ' + str(s))
    if s > SEGMENT_SAMPLES:
        a = a[:, :, :SEGMENT_SAMPLES]
    return [a[i] for i in range(n)]

# ─── dispatch by mode ────────────────────────────────────────────────────
flat_loss = False
tiny_n = False

if mode == 'selftest':
    kind = src
    rng = np.random.RandomState(SEED)
    if kind == 'baseline-only':
        baseline = make_baseline_segments(200, rng)
        injected = []
    elif kind == 'inject-anomaly':
        baseline = make_baseline_segments(200, rng)
        injected = make_anomaly_segments(20, rng)
    elif kind == 'flat-loss':
        baseline = make_baseline_segments(60, rng)
        injected = make_anomaly_segments(10, rng)
        flat_loss = True
    elif kind == 'tiny-n':
        baseline = make_baseline_segments(10, rng)
        injected = []
        tiny_n = True
    else:
        sys.stderr.write('unknown selftest kind: ' + kind + '\\n'); sys.exit(3)
elif mode == 'real-train':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    baseline = load_real_segments(src)
    injected = []
    if len(baseline) < MIN_BASELINE_N:
        sys.stderr.write('insufficient-baseline: have ' + str(len(baseline))
                         + ' need ' + str(MIN_BASELINE_N) + '\\n')
        sys.exit(5)
else:
    sys.stderr.write('unknown mode: ' + mode + '\\n'); sys.exit(2)

# ─── feature extraction ──────────────────────────────────────────────────
X_base = features_from_segments(baseline)
X_inj  = features_from_segments(injected) if injected else np.zeros((0, FEATURE_DIM))

# train/val/calib split (60/20/20, deterministic)
rng_split = np.random.RandomState(SEED + 1)
n_base = X_base.shape[0]
perm = rng_split.permutation(n_base)
n_val = max(2, int(round(0.2 * n_base)))
n_cal = max(2, int(round(0.2 * n_base)))
val_idx = perm[:n_val]
cal_idx = perm[n_val:n_val + n_cal]
tr_idx  = perm[n_val + n_cal:]
Xtr_raw = X_base[tr_idx]
Xva_raw = X_base[val_idx]
Xcal_raw = X_base[cal_idx]

# z-score per feature (trained on Xtr only)
mu = Xtr_raw.mean(0)
sigma = Xtr_raw.std(0)
sigma = np.where(sigma < 1e-8, 1.0, sigma)
Xtr = (Xtr_raw - mu) / sigma
Xva = (Xva_raw - mu) / sigma
Xcal = (Xcal_raw - mu) / sigma
Xinj = ((X_inj - mu) / sigma) if X_inj.shape[0] > 0 else X_inj

# ─── train ───────────────────────────────────────────────────────────────
epochs_min_use = EPOCHS_MIN if not tiny_n else 30
P, history, init_train_loss = train_ae(Xtr, Xva, epochs_min_use, EPOCHS_MAX,
                                        LR, BATCH_SIZE, SEED, flat_loss=flat_loss)
final_train_loss = history[-1][0]
final_val_loss = history[-1][1]

# ─── reconstruction error baseline distribution ─────────────────────────
# Anchor mu_e, sigma_e on a HELD-OUT baseline pool (Xva), not the training
# set. Training-set errors are systematically optimistic (memorized) and
# would yield biased z-scores on real held-out segments.
Yh_tr, _ = forward(P, Xtr); err_tr = per_sample_recon_err(Yh_tr, Xtr)
Yh_va, _ = forward(P, Xva); err_va = per_sample_recon_err(Yh_va, Xva)
mu_e = float(err_va.mean())
sigma_e = float(err_va.std())
if sigma_e < 1e-12: sigma_e = 1e-12

def zscore(e): return (e - mu_e) / sigma_e

# C3: held-out CALIBRATION (separate from val) — fraction with z ≤ 2
Yh_cal, _ = forward(P, Xcal); err_cal = per_sample_recon_err(Yh_cal, Xcal)
z_cal = zscore(err_cal)
c3_ok_frac = float((z_cal <= Z_THRESHOLD).mean())

# C4: injected anomaly median z
if Xinj.shape[0] > 0:
    Yh_inj, _ = forward(P, Xinj); err_inj = per_sample_recon_err(Yh_inj, Xinj)
    z_inj = zscore(err_inj)
    c4_inject_median_z = float(np.median(z_inj))
    c4_inject_n = int(z_inj.shape[0])
    c4_inject_flag_frac = float((z_inj > Z_THRESHOLD).mean())
else:
    c4_inject_median_z = float('nan')
    c4_inject_n = 0
    c4_inject_flag_frac = float('nan')

# C5: re-eval on training set, fraction self-flagged
z_tr = zscore(err_tr)
c5_reeval_flag_frac = float((z_tr > Z_THRESHOLD).mean())

# ─── F4 ablation: PCA(8) AUC vs AE AUC on injected vs baseline ──────────
ae_auc = float('nan'); pca_auc = float('nan')
if Xinj.shape[0] > 0 and ablation_pca:
    # AUC: probability that a random injected has higher err than a random baseline
    e_pos = err_inj
    e_neg = err_cal
    def auc_score(pos, neg):
        if len(pos) == 0 or len(neg) == 0: return float('nan')
        c = 0; t = 0
        for x in pos:
            for y in neg:
                t += 1
                if x > y: c += 1
                elif x == y: c += 0.5
        return c / max(1, t)
    ae_auc = auc_score(e_pos, e_neg)
    err_cal_pca = pca_recon_err(Xtr, Xcal, 8)
    err_inj_pca = pca_recon_err(Xtr, Xinj, 8)
    pca_auc = auc_score(err_inj_pca, err_cal_pca)

# ─── pass/fail ───────────────────────────────────────────────────────────
decay_ratio = final_train_loss / max(init_train_loss, 1e-12)
overfit_ratio = final_val_loss / max(final_train_loss, 1e-12)
c1_pass = 1 if decay_ratio < 0.5 else 0
c2_pass = 1 if overfit_ratio <= 3.0 else 0
c3_pass = 1 if c3_ok_frac >= 0.8 else 0
if c4_inject_n > 0:
    c4_pass = 1 if c4_inject_median_z >= Z_THRESHOLD else 0
else:
    c4_pass = -1  # not-applicable
c5_pass = 1 if c5_reeval_flag_frac < 0.5 else 0

verdict = 'FAIL'
core_ok = (c1_pass == 1 and c2_pass == 1)
calibrators = [c3_pass, c5_pass] + ([c4_pass] if c4_pass != -1 else [])
all_calibrators_ok = all(x == 1 for x in calibrators)
n_calibrator_fail = sum(1 for x in calibrators if x == 0)
if core_ok and all_calibrators_ok:
    verdict = 'PASS'
elif core_ok and n_calibrator_fail == 1:
    verdict = 'PARTIAL'
else:
    verdict = 'FAIL'

# ─── write dump ──────────────────────────────────────────────────────────
def x1000(v):
    if v != v:  # NaN
        return -2147483647
    if v == float('inf') or v == float('-inf'):
        return -2147483647
    return int(round(v * 1000.0))

with open(out_path, 'w') as f:
    f.write('schema=eeg_anom_ae_v1\\n')
    f.write('mode=' + mode + '\\n')
    f.write('kind=' + (src if mode == 'selftest' else 'real') + '\\n')
    f.write('n_baseline=' + str(int(n_base)) + '\\n')
    f.write('n_train=' + str(int(Xtr.shape[0])) + '\\n')
    f.write('n_val=' + str(int(Xva.shape[0])) + '\\n')
    f.write('n_calib=' + str(int(Xcal.shape[0])) + '\\n')
    f.write('n_inject=' + str(int(c4_inject_n)) + '\\n')
    f.write('feature_dim=' + str(int(FEATURE_DIM)) + '\\n')
    f.write('bottleneck_dim=' + str(int(BOTTLENECK_DIM)) + '\\n')
    f.write('epochs_run=' + str(int(len(history))) + '\\n')
    f.write('init_train_loss_x1000=' + str(x1000(init_train_loss)) + '\\n')
    f.write('final_train_loss_x1000=' + str(x1000(final_train_loss)) + '\\n')
    f.write('final_val_loss_x1000=' + str(x1000(final_val_loss)) + '\\n')
    f.write('decay_ratio_x1000=' + str(x1000(decay_ratio)) + '\\n')
    f.write('overfit_ratio_x1000=' + str(x1000(overfit_ratio)) + '\\n')
    f.write('mu_err_x1000=' + str(x1000(mu_e)) + '\\n')
    f.write('sigma_err_x1000=' + str(x1000(sigma_e)) + '\\n')
    f.write('c3_ok_frac_x1000=' + str(x1000(c3_ok_frac)) + '\\n')
    f.write('c4_inject_median_z_x1000=' + str(x1000(c4_inject_median_z)) + '\\n')
    f.write('c4_inject_flag_frac_x1000=' + str(x1000(c4_inject_flag_frac)) + '\\n')
    f.write('c5_reeval_flag_frac_x1000=' + str(x1000(c5_reeval_flag_frac)) + '\\n')
    f.write('ae_auc_x1000=' + str(x1000(ae_auc)) + '\\n')
    f.write('pca_auc_x1000=' + str(x1000(pca_auc)) + '\\n')
    f.write('c1_pass=' + str(int(c1_pass)) + '\\n')
    f.write('c2_pass=' + str(int(c2_pass)) + '\\n')
    f.write('c3_pass=' + str(int(c3_pass)) + '\\n')
    f.write('c4_pass=' + str(int(c4_pass)) + '\\n')
    f.write('c5_pass=' + str(int(c5_pass)) + '\\n')
    f.write('verdict=' + verdict + '\\n')

print('OK verdict=' + verdict + ' c1=' + str(c1_pass) + ' c2=' + str(c2_pass)
      + ' c3=' + str(c3_pass) + ' c4=' + str(c4_pass) + ' c5=' + str(c5_pass))
"
    write_file(HELPER_PATH, py)
}

fn _pick_python() -> string {
    let envp = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp != "" { return envp }
    let venv_rel = ".venv-eeg/bin/python"
    let chk_rel = exec("test -x \"" + venv_rel + "\" && echo OK").trim()
    if chk_rel == "OK" { return venv_rel }
    let cwd = exec("pwd").trim()
    let venv_abs = cwd + "/.venv-eeg/bin/python"
    let chk_abs = exec("test -x \"" + venv_abs + "\" && echo OK").trim()
    if chk_abs == "OK" { return venv_abs }
    return "/usr/bin/python3"
}

fn run_helper(mode_arg: string, src_arg: string, ablation_pca: int) -> string {
    _write_helper()
    let py = _pick_python()
    let mut cmd = py + " " + HELPER_PATH + " " + mode_arg + " \"" + src_arg + "\" \"" + DUMP_PATH + "\""
    if ablation_pca == 1 { cmd = cmd + " 1" }
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 {
        eprintln("anom-helper-rc=" + str(rc))
        eprintln("anom-helper-out: " + to_string(r[0]))
        return ""
    }
    return read_file(DUMP_PATH)
}

fn parse_str_kv(blob: string, key: string) -> string {
    let kp = find_in_str(blob, key)
    if kp < 0 { return "" }
    let n = len(blob)
    let mut q = kp + len(key)
    let mut out = ""
    while q < n && blob[q] != "\n" {
        out = out + blob[q]
        q = q + 1
    }
    return out
}

fn append_jsonl(path: string, line: string) {
    let scratch = "state/.eeg_anom_audit_row.tmp"
    write_file(scratch, line + "\n")
    let cmd = "p=" + path + "; mkdir -p $(dirname $p); cat " + scratch + " >> $p; rm -f " + scratch
    let _ = exec(cmd)
}

fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut starts_dash = 0
        if len(a) >= 1 {
            if a[0] == "-" { starts_dash = 1 }
        }
        if starts_dash == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run anima-clm-eeg/tool/eeg_anomaly_autoencoder.hexa [flags]")
    eprintln("flags:")
    eprintln("  --selftest                 synthetic baseline + injected anomaly")
    eprintln("  --selftest-mode <kind>     baseline-only | inject-anomaly | flat-loss | tiny-n")
    eprintln("                             (default: inject-anomaly)")
    eprintln("  --train --input <p.npy>    real-data: (n_seg,16,625) train autoencoder on baseline")
    eprintln("  --ablation-pca             include PCA(8) AUC ablation (F4)")
    eprintln("  --audit-jsonl <path>       JSONL audit append path")
    eprintln("                             (default: state/eeg_anomaly_audit/<UTC-date>_anomaly.jsonl)")
    eprintln("  --out <path>               JSON cert output path")
    eprintln("                             (default: state/eeg_anomaly_autoencoder.json)")
}

fn main() {
    let av = _flags_only_argv()
    let mut cli_input = ""
    let mut cli_audit = ""
    let mut cli_out   = ""
    let mut cli_selftest = 0
    let mut cli_train = 0
    let mut cli_ablation = 0
    let mut cli_kind = "inject-anomaly"
    let mut want_help = 0
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { cli_selftest = 1; i = i + 1; continue }
        if a == "--train" { cli_train = 1; i = i + 1; continue }
        if a == "--ablation-pca" { cli_ablation = 1; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = 1; i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --input"); exit(2) }
            cli_input = av[i + 1]; i = i + 2; continue
        }
        if a == "--audit-jsonl" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --audit-jsonl"); exit(2) }
            cli_audit = av[i + 1]; i = i + 2; continue
        }
        if a == "--out" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --out"); exit(2) }
            cli_out = av[i + 1]; i = i + 2; continue
        }
        if a == "--selftest-mode" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --selftest-mode"); exit(2) }
            cli_kind = av[i + 1]; i = i + 2; continue
        }
        eprintln("reason: unknown-arg: " + a)
        _print_usage()
        exit(2)
    }
    if want_help == 1 { _print_usage(); exit(0) }

    let env_selftest = env_str("EEG_ANOM_SELFTEST", "0")
    let is_selftest = (cli_selftest == 1) || (env_selftest == "1") || (cli_train == 0)

    let mut mode = "selftest"
    let mut helper_mode = "selftest"
    let mut helper_src = cli_kind
    let mut input_label = "synthetic_" + cli_kind
    let mut input_sha256 = ""

    if cli_train == 1 {
        if cli_input == "" {
            eprintln("reason: missing-input")
            _print_usage(); exit(2)
        }
        mode = "real-train"
        helper_mode = "real-train"
        helper_src = cli_input
        input_label = cli_input
        input_sha256 = sha256_of_file(cli_input)
    }

    let blob = run_helper(helper_mode, helper_src, cli_ablation)
    if blob == "" {
        eprintln("reason: helper-failed")
        exit(3)
    }

    let n_baseline = parse_int_kv(blob, "n_baseline=")
    let n_train = parse_int_kv(blob, "n_train=")
    let n_val = parse_int_kv(blob, "n_val=")
    let n_inject = parse_int_kv(blob, "n_inject=")
    let epochs_run = parse_int_kv(blob, "epochs_run=")
    let init_loss = parse_int_kv(blob, "init_train_loss_x1000=")
    let final_tr = parse_int_kv(blob, "final_train_loss_x1000=")
    let final_va = parse_int_kv(blob, "final_val_loss_x1000=")
    let decay = parse_int_kv(blob, "decay_ratio_x1000=")
    let overfit = parse_int_kv(blob, "overfit_ratio_x1000=")
    let mu_err = parse_int_kv(blob, "mu_err_x1000=")
    let sigma_err = parse_int_kv(blob, "sigma_err_x1000=")
    let c3_ok = parse_int_kv(blob, "c3_ok_frac_x1000=")
    let c4_med = parse_int_kv(blob, "c4_inject_median_z_x1000=")
    let c4_flag = parse_int_kv(blob, "c4_inject_flag_frac_x1000=")
    let c5_reflag = parse_int_kv(blob, "c5_reeval_flag_frac_x1000=")
    let ae_auc = parse_int_kv(blob, "ae_auc_x1000=")
    let pca_auc = parse_int_kv(blob, "pca_auc_x1000=")
    let c1_p = parse_int_kv(blob, "c1_pass=")
    let c2_p = parse_int_kv(blob, "c2_pass=")
    let c3_p = parse_int_kv(blob, "c3_pass=")
    let c4_p = parse_int_kv(blob, "c4_pass=")
    let c5_p = parse_int_kv(blob, "c5_pass=")
    let verdict = parse_str_kv(blob, "verdict=")

    let mut classification = "NOT_VERIFIED_SYNTHETIC"
    if mode == "real-train" {
        if verdict == "PASS"    { classification = "REAL_HW_PASS_AE" }
        if verdict == "PARTIAL" { classification = "REAL_HW_PARTIAL_AE" }
        if verdict == "FAIL"    { classification = "REAL_HW_FAIL_AE" }
    }

    let ts = now_iso()
    let mut out_path = cli_out
    if out_path == "" { out_path = "state/eeg_anomaly_autoencoder.json" }
    let mut audit_path = cli_audit
    if audit_path == "" {
        audit_path = "state/eeg_anomaly_audit/" + now_date_utc() + "_anomaly.jsonl"
    }

    let mut cert = "{\n"
    cert = cert + "  \"tool\": \"eeg_anomaly_autoencoder\",\n"
    cert = cert + "  \"version\": \"v1\",\n"
    cert = cert + "  \"raw_rank\": 9,\n"
    cert = cert + "  \"hexa_only\": true,\n"
    cert = cert + "  \"deterministic\": true,\n"
    cert = cert + "  \"llm\": \"none\",\n"
    cert = cert + "  \"pre_register_frozen\": true,\n"
    cert = cert + "  \"frozen_at\": \"2026-04-28\",\n"
    cert = cert + "  \"ts_utc\": \"" + ts + "\",\n"
    cert = cert + "  \"hypothesis\": \"AE(80→8) reconstruction-error z-score detects baseline state-shift; injected anomaly median z >= 2\",\n"
    cert = cert + "  \"hyperparams\": {\n"
    cert = cert + "    \"sample_rate_hz\": " + str(SAMPLE_RATE_HZ) + ",\n"
    cert = cert + "    \"segment_seconds_x10\": " + str(SEGMENT_SECONDS_X10) + ",\n"
    cert = cert + "    \"n_channels\": " + str(N_CHANNELS) + ",\n"
    cert = cert + "    \"feature_dim\": " + str(FEATURE_DIM) + ",\n"
    cert = cert + "    \"bottleneck_dim\": " + str(BOTTLENECK_DIM) + ",\n"
    cert = cert + "    \"epochs_min\": " + str(EPOCHS_MIN) + ",\n"
    cert = cert + "    \"epochs_max\": " + str(EPOCHS_MAX) + ",\n"
    cert = cert + "    \"learning_rate_x1000\": " + str(LEARNING_RATE_X1000) + ",\n"
    cert = cert + "    \"batch_size\": " + str(BATCH_SIZE) + ",\n"
    cert = cert + "    \"z_threshold_x1000\": " + str(Z_THRESHOLD_X1000) + ",\n"
    cert = cert + "    \"seed\": " + str(SEED) + ",\n"
    cert = cert + "    \"min_baseline_n\": " + str(MIN_BASELINE_N) + "\n"
    cert = cert + "  },\n"
    cert = cert + "  \"criteria\": {\n"
    cert = cert + "    \"C1_decay_ratio_max_x1000\": " + str(C1_DECAY_RATIO_MAX_X1000) + ",\n"
    cert = cert + "    \"C2_overfit_ratio_max_x1000\": " + str(C2_OVERFIT_RATIO_X1000) + ",\n"
    cert = cert + "    \"C3_calibrated_min_frac_x1000\": " + str(C3_CAL_OK_FRAC_MIN_X1000) + ",\n"
    cert = cert + "    \"C4_inject_median_z_min_x1000\": " + str(C4_INJECT_MEDIAN_Z_X1000) + ",\n"
    cert = cert + "    \"C5_reeval_flag_frac_max_x1000\": " + str(C5_REEVAL_FLAG_FRAC_MAX_X1000) + ",\n"
    cert = cert + "    \"verdict_rule\": \"PASS=C1∧C2∧C3∧C4∧C5; PARTIAL=C1∧C2 hold but exactly one of C3/C4/C5 fails; FAIL=else\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"mode\": \"" + mode + "\",\n"
    cert = cert + "  \"input\": \"" + input_label + "\",\n"
    cert = cert + "  \"input_sha256\": \"" + input_sha256 + "\",\n"
    cert = cert + "  \"n_baseline\": " + str(n_baseline) + ",\n"
    cert = cert + "  \"n_train\": " + str(n_train) + ",\n"
    cert = cert + "  \"n_val\": " + str(n_val) + ",\n"
    cert = cert + "  \"n_inject\": " + str(n_inject) + ",\n"
    cert = cert + "  \"epochs_run\": " + str(epochs_run) + ",\n"
    cert = cert + "  \"init_train_loss_x1000\": " + str(init_loss) + ",\n"
    cert = cert + "  \"final_train_loss_x1000\": " + str(final_tr) + ",\n"
    cert = cert + "  \"final_val_loss_x1000\": " + str(final_va) + ",\n"
    cert = cert + "  \"decay_ratio_x1000\": " + str(decay) + ",\n"
    cert = cert + "  \"overfit_ratio_x1000\": " + str(overfit) + ",\n"
    cert = cert + "  \"mu_err_x1000\": " + str(mu_err) + ",\n"
    cert = cert + "  \"sigma_err_x1000\": " + str(sigma_err) + ",\n"
    cert = cert + "  \"c3_ok_frac_x1000\": " + str(c3_ok) + ",\n"
    cert = cert + "  \"c4_inject_median_z_x1000\": " + str(c4_med) + ",\n"
    cert = cert + "  \"c4_inject_flag_frac_x1000\": " + str(c4_flag) + ",\n"
    cert = cert + "  \"c5_reeval_flag_frac_x1000\": " + str(c5_reflag) + ",\n"
    cert = cert + "  \"ae_auc_x1000\": " + str(ae_auc) + ",\n"
    cert = cert + "  \"pca_auc_x1000\": " + str(pca_auc) + ",\n"
    cert = cert + "  \"c1_pass\": " + str(c1_p) + ",\n"
    cert = cert + "  \"c2_pass\": " + str(c2_p) + ",\n"
    cert = cert + "  \"c3_pass\": " + str(c3_p) + ",\n"
    cert = cert + "  \"c4_pass\": " + str(c4_p) + ",\n"
    cert = cert + "  \"c5_pass\": " + str(c5_p) + ",\n"
    cert = cert + "  \"verdict\": \"" + verdict + "\",\n"
    cert = cert + "  \"classification\": \"" + classification + "\",\n"
    cert = cert + "  \"reference\": \"Hinton-Salakhutdinov 2006 Science 313:504 (autoencoders); Bishop 2006 PRML ch 12 (PCA ablation)\"\n"
    cert = cert + "}\n"
    write_file(out_path, cert)

    let mut jrow = "{"
    jrow = jrow + "\"ts\":\"" + ts + "\","
    jrow = jrow + "\"tool\":\"eeg_anomaly_autoencoder\","
    jrow = jrow + "\"mode\":\"" + mode + "\","
    jrow = jrow + "\"input\":\"" + input_label + "\","
    jrow = jrow + "\"sha256\":\"" + input_sha256 + "\","
    jrow = jrow + "\"n_baseline\":" + str(n_baseline) + ","
    jrow = jrow + "\"n_inject\":" + str(n_inject) + ","
    jrow = jrow + "\"epochs_run\":" + str(epochs_run) + ","
    jrow = jrow + "\"init_train_loss_x1000\":" + str(init_loss) + ","
    jrow = jrow + "\"final_train_loss_x1000\":" + str(final_tr) + ","
    jrow = jrow + "\"final_val_loss_x1000\":" + str(final_va) + ","
    jrow = jrow + "\"decay_ratio_x1000\":" + str(decay) + ","
    jrow = jrow + "\"overfit_ratio_x1000\":" + str(overfit) + ","
    jrow = jrow + "\"c3_ok_frac_x1000\":" + str(c3_ok) + ","
    jrow = jrow + "\"c4_inject_median_z_x1000\":" + str(c4_med) + ","
    jrow = jrow + "\"c5_reeval_flag_frac_x1000\":" + str(c5_reflag) + ","
    jrow = jrow + "\"ae_auc_x1000\":" + str(ae_auc) + ","
    jrow = jrow + "\"pca_auc_x1000\":" + str(pca_auc) + ","
    jrow = jrow + "\"c1_pass\":" + str(c1_p) + ","
    jrow = jrow + "\"c2_pass\":" + str(c2_p) + ","
    jrow = jrow + "\"c3_pass\":" + str(c3_p) + ","
    jrow = jrow + "\"c4_pass\":" + str(c4_p) + ","
    jrow = jrow + "\"c5_pass\":" + str(c5_p) + ","
    jrow = jrow + "\"verdict\":\"" + verdict + "\","
    jrow = jrow + "\"classification\":\"" + classification + "\","
    jrow = jrow + "\"reference\":\"Hinton-Salakhutdinov 2006 Science 313:504\""
    jrow = jrow + "}"
    append_jsonl(audit_path, jrow)

    println("  mode                  = " + mode)
    println("  input                 = " + input_label)
    if input_sha256 != "" { println("  input_sha256          = " + input_sha256) }
    println("  n_baseline / n_inject = " + str(n_baseline) + " / " + str(n_inject))
    println("  n_train / n_val       = " + str(n_train) + " / " + str(n_val))
    println("  epochs_run            = " + str(epochs_run))
    println("  init train loss x1000 = " + str(init_loss))
    println("  final train  loss x1000 = " + str(final_tr))
    println("  final val    loss x1000 = " + str(final_va))
    println("  decay   ratio    x1000 = " + str(decay))
    println("  overfit ratio    x1000 = " + str(overfit))
    println("  C3 cal ok frac   x1000 = " + str(c3_ok))
    println("  C4 inj median z  x1000 = " + str(c4_med))
    println("  C5 reeval flag f x1000 = " + str(c5_reflag))
    println("  AE  AUC         x1000 = " + str(ae_auc))
    println("  PCA AUC         x1000 = " + str(pca_auc))
    println("  C1..C5 pass            = " + str(c1_p) + str(c2_p) + str(c3_p) + str(c4_p) + str(c5_p))
    println("  verdict                = " + verdict)
    println("  classification         = " + classification)
    println("  cert_out               = " + out_path)
    println("  audit_jsonl            = " + audit_path)

    if mode == "selftest" {
        println("─── selftest reference targets ───")
        println("  selftest_mode         = " + cli_kind)
        println("  expected (baseline-only) = PASS")
        println("  expected (inject-anomaly) = PASS (median z >= 2)")
        println("  expected (flat-loss)  = FAIL (C1)")
        println("  expected (tiny-n)     = PARTIAL or FAIL (C2 overfit)")
        if cli_kind == "baseline-only" && verdict == "PASS" { exit(0) }
        if cli_kind == "inject-anomaly" && verdict == "PASS" { exit(0) }
        if cli_kind == "flat-loss" && verdict == "FAIL" { exit(0) }
        if cli_kind == "tiny-n" {
            if verdict == "PARTIAL" || verdict == "FAIL" { exit(0) }
        }
        eprintln("reason: selftest-mismatch: " + cli_kind + " produced verdict " + verdict)
        exit(1)
    }

    if verdict == "PASS"    { exit(0) }
    if verdict == "PARTIAL" { exit(2) }
    exit(1)
}
