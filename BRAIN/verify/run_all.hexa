#!hexa strict
// hexa-brain/verify/run_all.hexa — aggregator (.hexa primary).
//
// Single CLI entry that runs all verify/*.hexa scripts and aggregates
// pass/fail. Sister of hexa-aura / hexa-matter / hexa-rtsc / hexa-ufo /
// hexa-cern / hexa-fusion's run_all.hexa pattern, scaled to spec-first
// neural-substrate scope.
//
// Closure shape for hexa-brain (spec-first-pipeline substrate):
//   1. spec_presence         — 36/36 dispatcher-backing files on disk
//   2. lattice_arithmetic    — n=6 self-consistency (aux per LATTICE_POLICY §1.3)
//   3. real_limits_anchor    — LIMIT_BREAKTHROUGH.md anchors (Oostendorp / Nunez /
//                              Hodgkin-Huxley / Shannon / Wolpaw / Neuralink /
//                              Neuropixels / Johnson-Nyquist / ADS1299 / Makeig)
//   4. closure_consistency   — scoreboard cross-check (toml · README · AGENTS · dispatcher)
//
// Run:
//     hexa run verify/run_all.hexa     # exit 0 = all subscripts PASS
//
// Implementation: the hexa runtime cd's into a tmp dir before running, so
// we resolve the repo root from $HEXA_BRAIN_ROOT or detect from $OLDPWD /
// $PWD by probing for bin/hexa-brain, then run subscripts with absolute
// paths.
//
//
//   PASS here means RC=0 from each of the 4 subscripts — bookkeeping
//   closure of the substrate's spec / scoreboard / real-limits anchors,
//   NOT medical-device validation, NOT clinical efficacy.
//
//   Medical-device claims (FDA / IRB / clinical / consumer-BCI) are
//   STRICTLY UNPROVEN. Scalp EEG cannot match intracortical performance
//   (L1 ~100x skull attenuation, L2 ~5-9 cm PSF — both HARD walls).
//
//   External BCI entities (Neuralink, Synchron, Blackrock Neurotech,
//   OpenBCI, Emotiv, Kernel) use THEIR OWN invariants; the n=6 lattice
//   is NOT applied to vendor numbers.
//
//   Bookkeeping closure != working pipeline != clinical validation.
//   Saturated != falsified != confirmed.

let HOME = env("HOME")
let HEXA_BRAIN_ROOT_ENV = env("HEXA_BRAIN_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_BRAIN_ROOT_ENV.len() > 0 { return HEXA_BRAIN_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/bin/hexa-brain ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/bin/hexa-brain ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/anima/BRAIN"
}

let SCRIPTS: [str] = [
    "verify/spec_presence.hexa",
    "verify/lattice_arithmetic.hexa",
    "verify/real_limits_anchor.hexa",
    "verify/closure_consistency.hexa",
]

fn main() {
    let root = _resolve_root()
    println("========================================================================")
    println("  hexa-brain verify/run_all — aggregate sweep (spec-first neural substrate)")
    println("  root: " + root)
    println("========================================================================")
    let mut passed = 0
    let mut failed = 0
    for s in SCRIPTS {
        println("")
        println("---- " + s + " ----")
        let abs_script = root + "/" + s
        let cmd = "cd " + shq(root) + " && HEXA_BRAIN_ROOT=" + shq(root) + " hexa run " + shq(abs_script) + " >/tmp/_hexa_brain_v.out 2>&1; echo $?"
        let rc_str = exec(cmd).trim()
        let parts = rc_str.split("\n")
        let last = parts[parts.len() - 1].trim()
        let rc = int(last)
        let out = exec("cat /tmp/_hexa_brain_v.out 2>/dev/null")
        // print last 6 lines for compactness
        let lines = out.split("\n")
        let n = lines.len()
        let mut start = 0
        if n > 6 { start = n - 6 }
        let mut k = start
        while k < n {
            println(lines[k])
            k = k + 1
        }
        // Accept stdout marker __HEXA_BRAIN_*__ PASS as auxiliary signal
        // (the dispatch runtime sometimes loses exit code via echo $? capture).
        let marker_pass = out.contains("__HEXA_BRAIN_") && out.contains("__ PASS")
        let marker_fail = out.contains("__HEXA_BRAIN_") && out.contains("__ FAIL")
        let script_pass = (rc == 0 && marker_pass) || (rc == 0 && marker_fail == false && out.len() > 0)
        let script_fail = rc != 0 || marker_fail
        if script_fail {
            failed = failed + 1
            println("  → " + s + " FAIL (rc=" + str(rc) + ")")
        } else if script_pass {
            passed = passed + 1
            println("  → " + s + " PASS")
        } else {
            failed = failed + 1
            println("  → " + s + " FAIL (no PASS marker, rc=" + str(rc) + ")")
        }
    }
    println("")
    println("========================================================================")
    let total = passed + failed
    println("  " + str(passed) + "/" + str(total) + " scripts passed")
    if failed > 0 {
        println("  verify sweep FAILED — see per-script output above.")
        exit(1)
    }
    println("  PASS — all hexa-brain closure invariants hold.")
    println("  Note: bookkeeping closure only — medical-device claims STRICTLY")
    println("        UNPROVEN (no FDA / IRB / clinical). External BCI entities")
    println("        (Neuralink, Synchron, Blackrock, OpenBCI, Emotiv, Kernel)")
    println("        use THEIR OWN invariants. See README §Verify + §Caveats.")
}
