// agent_skill_routing_smoke.hexa — re-score the H_1382 bars THROUGH the AGENT-LAYER call path
// (agent_route_select / agent_route_on_result), driven by simulated runtime tool RESULTS
// (success flags), NOT the CORE skill_store_* ops directly (H_1386, the END-TO-END follow-on).
//
// The runtime drive: for each task-context the executor would call agent_route_select to pick a
// tool, EXECUTE it, then feed the ToolResult back via agent_route_on_result(success=...). A FULL
// run feeds success=false the first time it sees each (task→correct_tool) (a real tool-failure →
// the routing teaches a skill-cell). STATIC runs the SAME failures under mitosis OFF (teach is a
// no-op). SHUFFLE teaches toward a derangement but is SCORED vs the TRUE map. All deterministic
// (fixed task/tool set + fixed shuffle), so the smoke is byte-repeatable across runs.

import "core/engine_cli.hexa"
import "agent/modules/core/agent_skill_routing.hexa"

fn _route_tasks() -> [string] {
    return [
        "web_search request variant 0 alpha", "web_search request variant 1 beta",
        "code_execute request variant 0 alpha", "code_execute request variant 1 beta",
        "file_read request variant 0 alpha", "file_read request variant 1 beta",
        "memory_search request variant 0 alpha", "memory_search request variant 1 beta",
        "shell_execute request variant 0 alpha", "shell_execute request variant 1 beta",
        "phi_measure request variant 0 alpha", "phi_measure request variant 1 beta"
    ]
}
fn _route_true_tools() -> [string] {
    return [
        "web_search", "web_search", "code_execute", "code_execute",
        "file_read", "file_read", "memory_search", "memory_search",
        "shell_execute", "shell_execute", "phi_measure", "phi_measure"
    ]
}
// a FIXED derangement of the true tools (every position → a DIFFERENT tool) — the SHUFFLE labels.
fn _route_shuffle_tools() -> [string] {
    return [
        "code_execute", "file_read", "memory_search", "shell_execute",
        "phi_measure", "web_search", "code_execute", "file_read",
        "memory_search", "phi_measure", "web_search", "shell_execute"
    ]
}

// _route_score — fraction of task-contexts where agent_route_select matches the TRUE tool (the
// SELECTION path consulting the learned store, i.e. skill_recall).
fn _route_score(store: SkillStore, tasks: [string], truth: [string]) -> float {
    let mut correct = 0
    let mut i = 0
    while i < len(tasks) {
        if agent_route_select(store, tasks[i]) == truth[i] { correct = correct + 1 }
        i = i + 1
    }
    return to_float(correct) / to_float(len(tasks))
}

// _route_init_acc — accuracy with ONLY the first (task→true_tool) seed cell (shared FULL/STATIC start).
fn _route_init_acc() -> float {
    let tasks = _route_tasks()
    let truth = _route_true_tools()
    let store = agent_routing_new(tasks[0], truth[0], 64)
    return _route_score(store, tasks, truth)
}

// _route_arm_acc — final SELECTION accuracy (scored vs TRUE) after walking the RUNTIME-RESULT loop:
//   the executor selects a tool, executes it; if the selection is WRONG the ToolResult.success is
//   false, and agent_route_on_result teaches toward the arm's label. We DERIVE success from the
//   live selection vs the arm's label (a real outcome-driven failure signal, p6 — no injected label):
//     "full"    teaches toward TRUE tools, mitosis ON  → learns from each failure.
//     "static"  same failures, mitosis OFF             → teach is a no-op (fixed repertoire control).
//     "shuffle" teaches toward PERMUTED tools, mitosis ON, but SCORED vs TRUE → collapses (EARNED).
fn _route_arm_acc(mode: string, cfg: EngineConfig) -> float {
    let tasks = _route_tasks()
    let truth = _route_true_tools()
    let train = if mode == "shuffle" { _route_shuffle_tools() } else { truth }
    let mut store = agent_routing_new(tasks[0], train[0], 64)
    let mut i = 0
    while i < len(tasks) {
        // RUNTIME: the executor selects, executes, observes outcome. success == "the live selection
        // already routes to the arm's target tool" — else it is a tool-failure that teaches.
        let selected = agent_route_select(store, tasks[i])
        let success = (selected == train[i])
        store = agent_route_on_result(store, tasks[i], train[i], cfg, success)
        i = i + 1
    }
    return _route_score(store, tasks, truth)
}

// _route_full_store — a FULL store after the runtime-failure loop toward the TRUE tools (for the
// footprint + abstain bars). Under cfg_off (mitosis OFF) teach is a no-op ⇒ STATIC (stays 1 cell).
fn _route_full_store(cfg: EngineConfig) -> SkillStore {
    let tasks = _route_tasks()
    let truth = _route_true_tools()
    let mut store = agent_routing_new(tasks[0], truth[0], 64)
    let mut i = 0
    while i < len(tasks) {
        let selected = agent_route_select(store, tasks[i])
        let success = (selected == truth[i])
        store = agent_route_on_result(store, tasks[i], truth[i], cfg, success)
        i = i + 1
    }
    return store
}

fn _assert_b(name: string, want: bool, got: bool) -> bool {
    if got == want { println("PASS  " + name); return true }
    println("FAIL  " + name + " want=" + to_string(want) + " got=" + to_string(got)); return false
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0

    let cfg_on  = engine_cli_parse(["--mitosis", "on"])
    let cfg_off = engine_cli_parse(["--no-mitosis"])

    let acc_init   = _route_init_acc()
    let acc_full   = _route_arm_acc("full",    cfg_on)
    let acc_static = _route_arm_acc("static",  cfg_off)   // STATIC = mitosis OFF ⇒ teach is a no-op
    let acc_shuf   = _route_arm_acc("shuffle", cfg_on)

    // bar (2) LEARNS-AT-RUNTIME — runtime tool-failures fed through agent_route_on_result grow
    //   skill-cells and improve subsequent agent_route_select accuracy by >= +0.30 over init.
    if _assert_b("case_r1_routing_learns_at_runtime", true,
                 acc_full - acc_init >= 0.30) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // bar (3a) DISTINCT-FROM-STATIC — same failures under mitosis OFF never split ⇒ no improvement.
    if _assert_b("case_r2_routing_distinct_from_static", true,
                 acc_full - acc_static >= 0.30) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // bar (3b) EARNED (shuffle) — route-teaching toward a PERMUTED map (scored vs TRUE) collapses
    //   the gain to within +0.15 of STATIC ⇒ the lift is the EARNED runtime task↔tool match (p6).
    if _assert_b("case_r3_routing_earned_shuffle", true,
                 acc_shuf - acc_static <= 0.15) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // bar (3c) NO-FAB / ABSTAIN — a FULL-routed store selected on an UNTRAINED far task-context
    //   returns "" (the runtime never fabricates a tool for an unrelated task).
    let far_store = _route_full_store(cfg_on)
    let abst1 = (agent_route_select(far_store, "中文 alien glyph zzz unrelated far0") == "")
    let abst2 = (agent_route_select(far_store, "qqq xxxxxx vvvvvv nonsense token stream far1") == "")
    if _assert_b("case_r4_routing_abstains_on_far", true,
                 abst1 && abst2) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // bar (3a footprint) Ψ-DISJOINT FOOTPRINT — FULL routing grows its OWN cells; STATIC (mitosis
    //   OFF) never grows past the single seed cell. FULL cell-count > STATIC == 1.
    let full_store   = _route_full_store(cfg_on)
    let static_store = _route_full_store(cfg_off)
    if _assert_b("case_r5_routing_footprint_grows", true,
                 agent_routing_cells(full_store) > agent_routing_cells(static_store)
              && agent_routing_cells(static_store) == 1) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    println("INFO  agent-routing acc: init=" + to_string(acc_init)
          + " full=" + to_string(acc_full)
          + " static=" + to_string(acc_static)
          + " shuffle=" + to_string(acc_shuf)
          + " cells_full=" + to_string(agent_routing_cells(full_store))
          + " cells_static=" + to_string(agent_routing_cells(static_store)))

    println("--- agent_skill_routing smoke summary: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
