// tests/test_smoke.hexa — smoke test for anima-agent CLI surface
//
// Verifies:
//   1. cli/anima-agent.hexa exists and is invocable
//   2. `version` subcmd returns version 1.0.0
//   3. `help` subcmd returns help text
//   4. `self-test` subcmd returns __ANIMA_AGENT_SELFTEST__ PASS
//
// Pure-stdlib. Deterministic. Run via:
//   hexa run tests/test_smoke.hexa

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn pkg_root() -> str {
    let env_root = env("ANIMA_AGENT_ROOT")
    if env_root.len() > 0 { return env_root }
    let mac_root = "/Users/ghost/core/anima-agent"
    let chk = exec("[ -d " + shq(mac_root) + " ] && echo y || echo n").trim()
    if chk == "y" { return mac_root }
    return exec("pwd").trim()
}

fn assert_contains(label: str, output: str, needle: str) -> bool {
    if output.contains(needle) {
        println("[smoke] PASS: " + label + " (contains \"" + needle + "\")")
        return true
    }
    eprintln("[smoke] FAIL: " + label + " (missing \"" + needle + "\")")
    eprintln("  got: " + output.substr(0, 200))
    return false
}

fn main() {
    let root = pkg_root()
    let cli = root + "/cli/anima-agent.hexa"
    let exists = exec("[ -f " + shq(cli) + " ] && echo y || echo n").trim()
    if exists != "y" {
        eprintln("[smoke] FAIL: cli/anima-agent.hexa not found at " + cli)
        exit(1)
    }
    println("[smoke] cli entry found: " + cli)

    let mut all_pass = true

    // 1. version
    let v_out = exec("hexa run " + shq(cli) + " version 2>&1")
    if assert_contains("version", v_out, "1.0.0") == false { all_pass = false }

    // 2. help
    let h_out = exec("hexa run " + shq(cli) + " help 2>&1")
    if assert_contains("help.usage", h_out, "usage: anima-agent") == false { all_pass = false }
    if assert_contains("help.subcmds", h_out, "self-test") == false { all_pass = false }
    if assert_contains("help.caveats", h_out, "raw#10") == false { all_pass = false }

    // 3. self-test
    let st_out = exec("hexa run " + shq(cli) + " self-test 2>&1")
    if assert_contains("self-test", st_out, "__ANIMA_AGENT_SELFTEST__ PASS") == false { all_pass = false }

    if all_pass {
        println("__ANIMA_AGENT_SMOKE__ PASS")
    } else {
        eprintln("__ANIMA_AGENT_SMOKE__ FAIL")
        exit(1)
    }
}
