// types.hexa — TRADING common data types (M2 closure)
// Bridge architecture: tool surface only — no consciousness framing.
//
// 6 canonical types extracted from legacy module surfaces:
//   Symbol     — ticker + exchange + asset class
//   Quote      — current bid/ask/last + timestamp
//   Position   — open position (symbol, side, entry, qty, current)
//   Order      — pending/filled order (symbol, side, type, qty, price)
//   Trade      — executed trade (filled order + fill price + fees)
//   Portfolio  — balance + positions + realized/unrealized PnL
//
// All constructors return a Map (`#{}`); fields are documented inline.
// M3+ surfaces (scanner/broker/executor) consume + return these types
// for a single uniform shape across the trading pipeline.

// ---------------------------------------------------------------
// 1. Symbol — ticker + exchange + asset class
//   ticker: string (e.g. "BTCUSDT" · "AAPL" · "KRW-BTC")
//   exchange: string ("binance" · "kis" · "alpaca" · "ibkr")
//   asset_class: string ("crypto" · "stock" · "etf" · "futures")
// ---------------------------------------------------------------
pub fn trading_symbol(ticker, exchange, asset_class) {
    return #{
        "ticker": ticker,
        "exchange": exchange,
        "asset_class": asset_class,
        "kind": "Symbol",
    }
}

// ---------------------------------------------------------------
// 2. Quote — current bid/ask/last + timestamp
//   symbol: Symbol Map
//   bid · ask · last: float
//   ts: int (unix epoch ms)
// ---------------------------------------------------------------
pub fn trading_quote(symbol, bid, ask, last, ts) {
    return #{
        "symbol": symbol,
        "bid": bid,
        "ask": ask,
        "last": last,
        "spread": ask - bid,
        "ts": ts,
        "kind": "Quote",
    }
}

// ---------------------------------------------------------------
// 3. Position — open position
//   symbol: Symbol Map
//   side: "long" · "short"
//   entry_price · current_price: float
//   quantity: float (qty in base asset)
//   unrealized_pnl: derived (current - entry) * qty * sign(side)
// ---------------------------------------------------------------
pub fn trading_position(symbol, side, entry_price, quantity, current_price) {
    let sign = 1.0
    if side == "short" {
        sign = -1.0
    }
    let unrealized_pnl = (current_price - entry_price) * quantity * sign
    return #{
        "symbol": symbol,
        "side": side,
        "entry_price": entry_price,
        "quantity": quantity,
        "current_price": current_price,
        "unrealized_pnl": unrealized_pnl,
        "kind": "Position",
    }
}

// ---------------------------------------------------------------
// 4. Order — pending/filled order
//   symbol: Symbol Map
//   side: "buy" · "sell"
//   order_type: "market" · "limit" · "stop"
//   quantity: float
//   limit_price: float (0.0 for market)
//   status: "pending" · "filled" · "cancelled" · "rejected"
//   order_id: string (broker-assigned)
// ---------------------------------------------------------------
pub fn trading_order(symbol, side, order_type, quantity, limit_price) {
    return #{
        "symbol": symbol,
        "side": side,
        "order_type": order_type,
        "quantity": quantity,
        "limit_price": limit_price,
        "status": "pending",
        "order_id": "",
        "kind": "Order",
    }
}

// ---------------------------------------------------------------
// 5. Trade — executed trade (filled order + fill_price + fees)
//   order: Order Map
//   fill_price: float (actual fill, may differ from limit_price)
//   fill_qty: float (may be partial)
//   fees: float (broker fees + slippage cost)
//   filled_ts: int (unix epoch ms)
// ---------------------------------------------------------------
pub fn trading_trade(order, fill_price, fill_qty, fees, filled_ts) {
    return #{
        "order": order,
        "fill_price": fill_price,
        "fill_qty": fill_qty,
        "fees": fees,
        "filled_ts": filled_ts,
        "kind": "Trade",
    }
}

// ---------------------------------------------------------------
// 6. Portfolio — balance + positions + PnL
//   cash_balance: float (quote currency, e.g. USDT)
//   positions: list of Position Map
//   realized_pnl: float (closed positions)
//   total_equity: cash + sum(position.value)
// ---------------------------------------------------------------
pub fn trading_portfolio(cash_balance, positions, realized_pnl) {
    let position_value = 0.0
    let i = 0
    let n = positions.len()
    while i < n {
        let p = positions[i]
        position_value = position_value + p["current_price"] * p["quantity"]
        i = i + 1
    }
    let unrealized_pnl = 0.0
    let j = 0
    while j < n {
        let p = positions[j]
        unrealized_pnl = unrealized_pnl + p["unrealized_pnl"]
        j = j + 1
    }
    return #{
        "cash_balance": cash_balance,
        "positions": positions,
        "realized_pnl": realized_pnl,
        "unrealized_pnl": unrealized_pnl,
        "total_equity": cash_balance + position_value,
        "n_positions": n,
        "kind": "Portfolio",
    }
}

// ---------------------------------------------------------------
// helpers — uniform field accessors (defensive against missing keys)
// ---------------------------------------------------------------
pub fn trading_type_kind(obj) {
    let k = obj["kind"]
    if type_of(k) == "string" {
        return k
    }
    return "unknown"
}

pub fn trading_type_summary() {
    return "TRADING M2 types: Symbol · Quote · Position · Order · Trade · Portfolio (6/6)"
}
