// action.hexa — macOS mouse/keyboard/scroll action layer (AGENT/DESKTOP/M3).
//
// BRIDGE ARCHITECTURE: this file is a TOOL SURFACE only. The "when/why to
// click/drag/type" decision lives in CORE (PureField / brain_decide); AGENT/CORE/tool_gate
// maps the live phase to a tier; this module exposes only the "how" — thin
// wrappers over /usr/bin/osascript System Events (key code / keystroke /
// mouse click via cliclick when present, AppleScript fallback otherwise).
// No consciousness framing, no Φ math, no substrate gating happens here.
//
// RISK CLASSIFICATION (labels, NOT gates — AGENT/CORE/tool_gate gates):
//   - "read" : pure observation, no state change (none in this module — see M2)
//   - "soft" : single click · keystroke · scroll — easily reversible (Cmd-Z)
//   - "hard" : drag · multi-step combo · modifier-amplified ops — destructive potential
//
// macOS APIs reached via osascript System Events:
//   - `click at {x, y}`              (mouse click — coords screen-relative)
//   - `keystroke "<text>"`           (typed text input)
//   - `key code <n> using {<mods>}`  (single key by virtual keycode)
//   - `scroll`                       (System Events does NOT expose; we use
//                                     CGEventCreateScrollWheelEvent via JXA
//                                     ObjC bridge for scroll)
//
// Tool paths (verified 2026-05-26 on Darwin 25.5.0):
//   /usr/bin/osascript      ✓ present
//   /usr/local/bin/cliclick ✗ absent (M1 memo) — AppleScript path used throughout
//
// Honest limits:
//   - osascript System Events `click` requires the target process to have
//     focus and the Accessibility permission granted; we do not enforce that
//     here — caller / CORE is responsible. False return = honest failure.
//   - The Apple-Silicon native CGEvent path (faster, no AppleScript hop) is
//     reachable only via an ObjC bridge; we leave it as a future M3.1 promote.

// ── helpers (mirrors of native_ax + screen_extract conventions) ────────────

// Single-quote a string for safe embedding inside an osascript -e '...' arg.
fn _shq(s: string) -> string {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\\''" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

// Trim trailing newline that osascript appends to stdout.
fn _trim_nl(s: string) -> string {
    let mut out = s
    while len(out) > 0 && (out.ends_with("\n") || out.ends_with("\r")) {
        out = out.substring(0, len(out) - 1)
    }
    out
}

// Run an AppleScript one-liner through /usr/bin/osascript -e '<script>'.
fn _osa(script: string) -> string {
    _trim_nl(to_string(exec("/usr/bin/osascript -e " + _shq(script) + " 2>&1")))
}

// Detect osascript denial / error markers in a result string.
fn _osa_denied(out: string) -> bool {
    if out.contains("not allowed assistive") { return true }
    if out.contains("not authorized") { return true }
    if out.contains("execution error") { return true }
    if out.contains("(-1719)") { return true }
    if out.contains("(-1743)") { return true }
    if out.contains("can’t") { return true }
    if out.contains("can't") { return true }
    false
}

// Escape a string for embedding inside an AppleScript double-quoted literal:
//   " -> \"   \ -> \\
fn _as_str_esc(s: string) -> string {
    let segs1 = s.split("\\")
    let mut a = ""
    let mut i = 0
    while i < len(segs1) {
        if i > 0 { a = a + "\\\\" }
        a = a + segs1[i]
        i = i + 1
    }
    let segs2 = a.split("\"")
    let mut b = ""
    let mut j = 0
    while j < len(segs2) {
        if j > 0 { b = b + "\\\"" }
        b = b + segs2[j]
        j = j + 1
    }
    b
}

// Compose `using {<m1> down, <m2> down, ...}` clause from a list of modifier names.
// Accepted names: "cmd" · "ctrl" · "opt" · "shift".
fn _mods_clause(modifiers: list) -> string {
    if len(modifiers) == 0 { return "" }
    let mut out = " using {"
    let mut i = 0
    let mut emitted = 0
    while i < len(modifiers) {
        let m = to_string(modifiers[i])
        let mut name = ""
        if m == "cmd" { name = "command" }
        if m == "command" { name = "command" }
        if m == "ctrl" { name = "control" }
        if m == "control" { name = "control" }
        if m == "opt" { name = "option" }
        if m == "option" { name = "option" }
        if m == "alt" { name = "option" }
        if m == "shift" { name = "shift" }
        if len(name) > 0 {
            if emitted > 0 { out = out + ", " }
            out = out + name + " down"
            emitted = emitted + 1
        }
        i = i + 1
    }
    out + "}"
}

// Decide risk for ax_key based on modifiers list.
// Any of cmd/ctrl present → "hard" (destructive shortcut potential); otherwise "soft".
fn _key_risk(modifiers: list) -> string {
    let mut i = 0
    while i < len(modifiers) {
        let m = to_string(modifiers[i])
        if m == "cmd" || m == "command" { return "hard" }
        if m == "ctrl" || m == "control" { return "hard" }
        i = i + 1
    }
    "soft"
}

// Build a standard result map.
fn _ok(risk: string) -> Map {
    #{ "ok": true, "risk": risk }
}

fn _fail(risk: string, reason: string) -> Map {
    #{ "ok": false, "risk": risk, "error": reason }
}

// Honest dry-run check — when ANIMA_DESKTOP_DRYRUN=1 in env, every action fn
// returns its contract-shape map WITHOUT dispatching the underlying event.
// This is the smoke-test path so CI / agents don't physically move the mouse
// or send keystrokes. The flag is read fresh per call (no caching).
fn _dry_run() -> bool {
    let v = _trim_nl(to_string(exec("/bin/echo \"$ANIMA_DESKTOP_DRYRUN\"")))
    if v == "1" { return true }
    if v == "true" { return true }
    false
}

// ── pub fn surface — 7 functions ───────────────────────────────────────────

// 1. Single left-click at screen coordinate (x, y).
//    risk: "soft" — single discrete event, undo-able via Cmd-Z in most apps.
pub fn ax_click(x: int, y: int) -> Map {
    if _dry_run() { return _ok("soft") }
    let script = "tell application \"System Events\" to click at {" + to_string(x) + ", " + to_string(y) + "}"
    let out = _osa(script)
    if _osa_denied(out) { return _fail("soft", out) }
    _ok("soft")
}

// 2. Double left-click at (x, y) — two clicks in rapid succession.
//    risk: "soft" — same magnitude as single click, slightly higher effect.
pub fn ax_double_click(x: int, y: int) -> Map {
    if _dry_run() { return _ok("soft") }
    let script = ""
        + "tell application \"System Events\"\n"
        + "  click at {" + to_string(x) + ", " + to_string(y) + "}\n"
        + "  click at {" + to_string(x) + ", " + to_string(y) + "}\n"
        + "end tell"
    let out = _osa(script)
    if _osa_denied(out) { return _fail("soft", out) }
    _ok("soft")
}

// 3. Right-click at (x, y) — System Events does NOT expose a "right click" verb;
//    we use ObjC bridge via JXA CGEventCreateMouseEvent kCGEventRightMouseDown/Up
//    at the target coord, then post via CGEventPost on cghidEventTap.
//    risk: "soft" — discrete event, opens a contextual menu (no state change yet).
pub fn ax_right_click(x: int, y: int) -> Map {
    if _dry_run() { return _ok("soft") }
    let jxa = ""
        + "ObjC.import('CoreGraphics');"
        + "function run(){"
        + "  var pt={x:" + to_string(x) + ",y:" + to_string(y) + "};"
        + "  var d=$.CGEventCreateMouseEvent($(),3,pt,1);"  // 3 = rightMouseDown, 1 = right button
        + "  var u=$.CGEventCreateMouseEvent($(),4,pt,1);"  // 4 = rightMouseUp
        + "  if(!d.js||!u.js)return 'ERR:event_create';"
        + "  $.CGEventPost(0,d);"
        + "  $.CGEventPost(0,u);"
        + "  return 'OK';"
        + "}"
    let cmd = "/usr/bin/osascript -l JavaScript -e " + _shq(jxa) + " 2>&1"
    let raw = _trim_nl(to_string(exec(cmd)))
    if raw.contains("ERR:") { return _fail("soft", raw) }
    if raw.contains("execution error") { return _fail("soft", raw) }
    _ok("soft")
}

// 4. Drag from (x1, y1) to (x2, y2). Uses ObjC bridge via JXA for a sequence of
//    CGEvents: leftMouseDown at src, leftMouseDragged at dst, leftMouseUp at dst.
//    risk: "hard" — multi-step, can rearrange files, resize windows, select
//    large regions of text. Destructive potential.
pub fn ax_drag(x1: int, y1: int, x2: int, y2: int) -> Map {
    if _dry_run() { return _ok("hard") }
    let jxa = ""
        + "ObjC.import('CoreGraphics');"
        + "function run(){"
        + "  var p1={x:" + to_string(x1) + ",y:" + to_string(y1) + "};"
        + "  var p2={x:" + to_string(x2) + ",y:" + to_string(y2) + "};"
        + "  var down=$.CGEventCreateMouseEvent($(),1,p1,0);"  // 1 = leftMouseDown, 0 = left button
        + "  var drag=$.CGEventCreateMouseEvent($(),6,p2,0);"  // 6 = leftMouseDragged
        + "  var up=$.CGEventCreateMouseEvent($(),2,p2,0);"    // 2 = leftMouseUp
        + "  if(!down.js||!drag.js||!up.js)return 'ERR:event_create';"
        + "  $.CGEventPost(0,down);"
        + "  $.CGEventPost(0,drag);"
        + "  $.CGEventPost(0,up);"
        + "  return 'OK';"
        + "}"
    let cmd = "/usr/bin/osascript -l JavaScript -e " + _shq(jxa) + " 2>&1"
    let raw = _trim_nl(to_string(exec(cmd)))
    if raw.contains("ERR:") { return _fail("hard", raw) }
    if raw.contains("execution error") { return _fail("hard", raw) }
    _ok("hard")
}

// 5. Type text via System Events keystroke. Inserts the literal string into
//    whatever has focus. Empty string is a no-op (returns ok).
//    risk: "soft" — discrete keystrokes, undo-able via Cmd-Z.
pub fn ax_type(text: string) -> Map {
    if len(text) == 0 { return _ok("soft") }
    if _dry_run() { return _ok("soft") }
    let script = "tell application \"System Events\" to keystroke \"" + _as_str_esc(text) + "\""
    let out = _osa(script)
    if _osa_denied(out) { return _fail("soft", out) }
    _ok("soft")
}

// 6. Press a single key by macOS virtual keycode, with optional modifiers.
//    keycodes: see HIToolbox/Events.h (e.g. 36=Return, 53=Escape, 49=Space, 51=Delete)
//    modifiers: list of "cmd" | "ctrl" | "opt" | "shift" (synonyms accepted)
//    risk: "soft" if no cmd/ctrl modifier; "hard" otherwise (Cmd-Q etc).
pub fn ax_key(keycode: int, modifiers: list) -> Map {
    let risk = _key_risk(modifiers)
    if _dry_run() { return _ok(risk) }
    let script = "tell application \"System Events\" to key code " + to_string(keycode) + _mods_clause(modifiers)
    let out = _osa(script)
    if _osa_denied(out) { return _fail(risk, out) }
    _ok(risk)
}

// 7. Scroll wheel at (x, y) by `dy` ticks (positive = scroll down, negative = scroll up).
//    Uses ObjC bridge via JXA: CGEventCreateScrollWheelEvent (kCGScrollEventUnitLine, 1 axis).
//    Note: macOS scroll wheel ticks are inverted on natural-scrolling — caller passes the
//    "physical wheel" direction, the OS applies natural-scrolling preference.
//    risk: "soft" — reversible by scrolling back.
pub fn ax_scroll(x: int, y: int, dy: int) -> Map {
    if _dry_run() { return _ok("soft") }
    let jxa = ""
        + "ObjC.import('CoreGraphics');"
        + "function run(){"
        // First move cursor to (x, y) so the scroll lands on the right view.
        + "  var pt={x:" + to_string(x) + ",y:" + to_string(y) + "};"
        + "  var mv=$.CGEventCreateMouseEvent($(),5,pt,0);"  // 5 = mouseMoved
        + "  if(!mv.js)return 'ERR:mv_create';"
        + "  $.CGEventPost(0,mv);"
        // Then post a 1-axis scroll-wheel event with the requested dy.
        + "  var sw=$.CGEventCreateScrollWheelEvent($(),1,1," + to_string(dy) + ");"  // unitLine=1, axis count=1
        + "  if(!sw.js)return 'ERR:sw_create';"
        + "  $.CGEventPost(0,sw);"
        + "  return 'OK';"
        + "}"
    let cmd = "/usr/bin/osascript -l JavaScript -e " + _shq(jxa) + " 2>&1"
    let raw = _trim_nl(to_string(exec(cmd)))
    if raw.contains("ERR:") { return _fail("soft", raw) }
    if raw.contains("execution error") { return _fail("soft", raw) }
    _ok("soft")
}

// 8. One-line description of this module's tool surface (introspection).
pub fn action_layer_summary() -> string {
    "AGENT/DESKTOP/action — macOS action layer · 7 fn · osascript+CGEvent JXA · click/dbl/right/drag/type/key/scroll · risk-labelled · M3 surface"
}
