// tool_wiring_armed_probe.hexa — F2 of the role-tool wiring smoke (effectful arm).
//
// Standalone, $0, no model/GPU. Proves exec_effectful_tool's ARMED path: with
// ANIMA_TOOLS_EFFECTFUL=1 in the env, a T2 file_write routes to the REAL surface
// and writes for real (and with the env UNSET, the SAME call honest-refuses).
// Run armed:   ANIMA_TOOLS_EFFECTFUL=1 hexa run agent/domains/CORE/tool_wiring_armed_probe.hexa
// Run default: hexa run agent/domains/CORE/tool_wiring_armed_probe.hexa   (→ gated-refusal)
//
// p7: deterministic equality, no perplexity. p5: the unset path NEVER fabricates
// a write; the armed path performs a REAL write whose bytes are read back.

import "agent/domains/CORE/tool_call_grammar.hexa"

fn main() {
    print("== F2 effectful armed-path probe ==")
    let path = "/tmp/anima_wiring_fw_probe.txt"
    let content = "armed-real-write-OK"
    let args = path + " " + content
    // clean any stale probe file (best-effort).
    let _ = exec("/bin/sh -c 'rm -f " + path + "'")

    let armed = effectful_armed()
    print("  effectful_armed() = " + to_string(armed))
    let r = exec_effectful_tool("file_write", args)
    print("  exec_effectful_tool(file_write) → \"" + r + "\"")

    if armed {
        // ARMED: assert the real write landed on disk with the exact bytes.
        let back = to_string(read_file(path))
        let ok = back == content
        print(if ok { "  [PASS] (F2) ARMED → real write landed: \"" + back + "\"" }
                    else { "  [FAIL] (F2) armed write mismatch: \"" + back + "\"" })
        print(if ok { "== F2 ARMED PASS ==" } else { "== F2 ARMED FAIL ==" })
    } else {
        // DEFAULT: assert honest gated-refusal + NO file created (no fabrication).
        let pfx = "‹effectful tool gated"
        let refused = byte_len(r) >= byte_len(pfx) && substring(r, 0, byte_len(pfx)) == pfx
        let exists = to_string(exec("/bin/sh -c 'test -e " + path + " && echo Y || echo N'"))
        let no_file = substring(exists, 0, 1) == "N"
        let ok = refused && no_file
        print(if ok { "  [PASS] (F2-default) gated-refusal AND no file written (SAFE)" }
                    else { "  [FAIL] (F2-default) refused=" + to_string(refused)
                            + " no_file=" + to_string(no_file) })
        print(if ok { "== F2 DEFAULT PASS ==" } else { "== F2 DEFAULT FAIL ==" })
    }
}
