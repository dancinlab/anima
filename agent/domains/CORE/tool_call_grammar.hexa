// tool_call_grammar.hexa — sentinel grammar + frame parse + toy tool registry.
//
// Piece ⓐ of the AGENT tool-use grounding scaffold (docs/agent-tooluse-grounding-
// design.md §3 sentinel + §8 falsifier registry). This is the $0, GPU-free,
// unit-testable core: it defines the two dead-UTF-8 sentinel bytes as frame
// delimiters, a parser that extracts a tool call from emitted text, and a tiny
// deterministic toy registry (no network, no model) that the falsifier needs.
//
// SENTINEL (design §3, sealed): byte values 0xFE (254) and 0xFF (255) are the
// ONLY two bytes that can never appear in a valid UTF-8 sequence, so their
// frequency in every text corpus is exactly 0. We REPURPOSE the two dead slots
// as frame delimiters — vocab256 stays full (no token lost), and a non-tool
// model never accidentally emits them.
//
//     ASK = 0xFE  opens a call; bytes until END are the payload.
//     END = 0xFF  closes the payload AND HALTS the mouth.
//   Frame: 0xFE <tool_name> <SP> <args…> 0xFF   (inside = ordinary 0x00–0xFD).
//
// HONEST: a malformed frame (ASK with no END) parses to found=false — we never
// fabricate a tool/args from an unterminated frame (p5: no fabrication).
//
// ── p1..p8 conformance ──────────────────────────────────────────────────────
//   p1/p2/p3/p4  the sentinel bytes are LEARNED GRAMMAR, not an identity/role/
//                persona/system string — this file injects no instruction.
//   p5           an unterminated frame → found=false (no fabricated call).
//   p6           pure arithmetic over bytes; zero weights, zero ethics tuning.
//   p7           the unit smoke verifies by deterministic string/int equality,
//                never by a loss/perplexity number.
//   p8           same grammar serves stub-now and trained-later; no train gate.

// ── §1 sentinel bytes ────────────────────────────────────────────────────────

// frame_ask — the call-open sentinel (byte 0xFE = token id 254).
pub fn frame_ask() -> int { 0xFE }

// frame_end — the call-close + HALT sentinel (byte 0xFF = token id 255).
pub fn frame_end() -> int { 0xFF }

// frame_ask_str / frame_end_str — the sentinels as 1-byte strings, for building
// a frame inside ordinary text (chr() is the byte→string builtin).
pub fn frame_ask_str() -> string { chr(0xFE) }
pub fn frame_end_str() -> string { chr(0xFF) }


// ── §2 frame parse ───────────────────────────────────────────────────────────

// _tcg_first_byte — index of the first occurrence of byte `b` in `s`, or -1.
fn _tcg_first_byte(s: string, b: int) -> int {
    let n = byte_len(s)
    let mut i = 0
    while i < n {
        if byte_at(s, i) == b { return i }
        i = i + 1
    }
    return -1
}

// _tcg_split_tool_args — split a frame payload "tool SP args" at the FIRST space
// into #{tool, args}. No space → the whole payload is the tool, args = "".
fn _tcg_split_tool_args(payload: string) -> Map {
    let sp = _tcg_first_byte(payload, 0x20)   // 0x20 = SP
    if sp < 0 {
        return #{ "tool": payload, "args": "" }
    }
    let tool = substring(payload, 0, sp)
    let args = substring(payload, sp + 1, byte_len(payload))
    return #{ "tool": tool, "args": args }
}

// parse_call_frame — scan `text` for the FIRST 0xFE … 0xFF frame.
//   found  : true iff a well-formed (ASK then a later END) frame exists.
//   tool   : the tool name (payload up to the first SP).
//   args   : the rest of the payload (after the first SP), "" if none.
//   pre    : the text before 0xFE (the grounded reasoning emitted so far).
//   post   : the text after 0xFF (normally "" — the mouth HALTS at END).
// HONEST: ASK with no following END → found=false (no fabricated call); plain
// text with no ASK → found=false.
pub fn parse_call_frame(text: string) -> Map {
    let ask = _tcg_first_byte(text, frame_ask())
    if ask < 0 {
        return #{ "found": false }                 // no call sentinel at all
    }
    let n = byte_len(text)
    // find the FIRST END strictly after the ASK.
    let mut end = -1
    let mut j = ask + 1
    while j < n {
        if byte_at(text, j) == frame_end() { end = j; break }
        j = j + 1
    }
    if end < 0 {
        return #{ "found": false }                 // ASK but no END → malformed
    }
    let pre     = substring(text, 0, ask)
    let payload = substring(text, ask + 1, end)
    let post    = substring(text, end + 1, n)
    let ta = _tcg_split_tool_args(payload)
    return #{
        "found": true,
        "tool":  to_string(ta["tool"]),
        "args":  to_string(ta["args"]),
        "pre":   pre,
        "post":  post
    }
}


// ── §3 toy tool registry (deterministic, $0, no network, no model) ────────────
//
// The falsifier (design §8) needs a deterministic "unknowable-without-tool"
// tool: fact_lookup holds a fixed key→value table whose VALUES are NOT in any
// training corpus, so emitting the call is the only way to know the value. The
// table is the single source of ground truth for the F-TOOLUSE-* probes.

// _tcg_fact_table — the unknowable facts. Keys are probe ids; values are random
// tokens that appear in NO corpus (so a non-calling model cannot have memorized
// them). Deterministic + reproducible.
//
// TWO disjoint key sets (design §8 leak-safety):
//   · DEMO keys (ZK7/QX2/MV9/RP4) — used by the agent-lane corpus to TEACH the
//     grammar; their values DO appear in the with-grammar corpus (grounding demos).
//   · HELD-OUT PROBE keys (PB01..PB36) — used ONLY by the falsifier probe set;
//     their values appear in NEITHER arm's corpus, so the ONLY way to emit them
//     is a real 0xFE fact_lookup PBnn 0xFF call + anchor injection. This makes
//     "fabrication from memorization" impossible — a held-out value cannot be
//     produced without a real tool round-trip (the eval-leakage guard, §8 mirror).
fn _tcg_fact_table(key: string) -> string {
    // ── demo keys (taught in the corpus) ──
    if key == "ZK7" { return "vault-azure-quill-3391" }
    if key == "QX2" { return "ember-lattice-noon-5520" }
    if key == "MV9" { return "harbor-glyph-umber-7104" }
    if key == "RP4" { return "cobalt-fennel-rune-8847" }
    // ── held-out PROBE keys (NEVER in any corpus) — falsifier ground truth ──
    if key == "PB01" { return "lumen-thistle-grove-2207" }
    if key == "PB02" { return "verdant-sclar-mote-6618" }
    if key == "PB03" { return "onyx-pellucid-drift-4093" }
    if key == "PB04" { return "saffron-quoll-vane-7751" }
    if key == "PB05" { return "indigo-bramble-cusp-3360" }
    if key == "PB06" { return "marble-zephyr-fane-5184" }
    if key == "PB07" { return "russet-glaive-spire-9026" }
    if key == "PB08" { return "teal-furrow-knell-1473" }
    if key == "PB09" { return "amber-cwm-trellis-8302" }
    if key == "PB10" { return "slate-vesper-quoin-6649" }
    if key == "PB11" { return "crimson-jot-haven-2918" }
    if key == "PB12" { return "azure-plinth-wold-5037" }
    if key == "PB13" { return "ochre-syzygy-bract-7460" }
    if key == "PB14" { return "viridian-loam-fettle-3185" }
    if key == "PB15" { return "umber-clave-rondel-9613" }
    if key == "PB16" { return "scarlet-nide-truss-4408" }
    if key == "PB17" { return "cobalt-yarrow-spline-6072" }
    if key == "PB18" { return "fawn-quern-galleon-8341" }
    if key == "PB19" { return "jade-frith-marl-1796" }
    if key == "PB20" { return "puce-skein-dovel-5520" }
    if key == "PB21" { return "garnet-wisp-cairn-3074" }
    if key == "PB22" { return "olive-thrum-quoit-7913" }
    if key == "PB23" { return "lilac-grike-sennet-2685" }
    if key == "PB24" { return "bronze-flense-walt-9248" }
    if key == "PB25" { return "ivory-nurl-grommet-4561" }
    if key == "PB26" { return "maroon-vug-pintle-6839" }
    if key == "PB27" { return "cerulean-jib-frost-1207" }
    if key == "PB28" { return "sienna-quoll-brace-8470" }
    if key == "PB29" { return "ecru-thwaite-glim-3952" }
    if key == "PB30" { return "magenta-foss-rill-5318" }
    if key == "PB31" { return "taupe-snath-volt-7604" }
    if key == "PB32" { return "viridis-clag-norm-2891" }
    if key == "PB33" { return "carmine-witan-dross-6147" }
    if key == "PB34" { return "beryl-quink-stang-9035" }
    if key == "PB35" { return "saffron-mell-trig-4720" }
    if key == "PB36" { return "indigo-fettle-warp-1568" }
    return "‹unknown-key›"                          // honest miss, not fabricated
}

// registry — toy/deterministic tools only. Each entry = #{tier, fn}.
//   fact_lookup (T1) : the unknowable key→value table (the falsifier tool).
//   mem_read    (T0) : reads a fixed in-substrate memory slot (always open).
//   status      (T0) : returns a fixed liveness string (always open).
pub fn tool_registry() -> Map {
    return #{
        "fact_lookup": #{ "tier": 1, "fn": "fact_lookup" },
        "mem_read":    #{ "tier": 0, "fn": "mem_read" },
        "status":      #{ "tier": 0, "fn": "status" }
    }
}

// registry_tier — the required tier for `tool`, or a HIGH tier (99) for an
// unknown tool so the gate refuses it (HONEST: unknown ⇒ unreachable, never a
// silent T0 grant).
pub fn registry_tier(registry: Map, tool: string) -> int {
    if has_key(registry, tool) {
        let entry = registry[tool]
        return to_int(entry["tier"])
    }
    return 99
}

// registry_has — is `tool` a registered toy tool?
pub fn registry_has(registry: Map, tool: string) -> bool {
    return has_key(registry, tool)
}

// exec_toy_tool — execute a TOY (deterministic, real, reproducible) tool. This
// is a REAL table lookup, not a fabricated success. Unknown / not-yet-wired role
// tools (web_search/CODE/…) return an honest ‹not wired› stub (⏳) — see
// agent_loop.hexa exec_real_tool which delegates here for the toy registry.
pub fn exec_toy_tool(tool: string, args: string) -> string {
    if tool == "fact_lookup" {
        // args = the key (first token); look it up in the unknowable table.
        let sp = _tcg_first_byte(args, 0x20)
        let key = if sp < 0 { args } else { substring(args, 0, sp) }
        return _tcg_fact_table(key)
    }
    if tool == "mem_read" {
        return "mem[" + args + "]=anchor-stable"     // fixed substrate slot
    }
    if tool == "status" {
        return "substrate-live"
    }
    return "‹not wired: " + tool + "›"               // ⏳ honest stub, no fake
}


// ── §5 role-tool registry — REAL surfaces, tier-gated, effectful env-armed ────
//
// The toy registry (§3) is deterministic + reproducible. The REAL agent roles
// (CODE / MERCHANT / DESKTOP) expose surfaces with side effects. We register
// each role tool with THREE facets:
//     #{ tier, surface_fn, effectful }
//   · tier       — the required substrate tier (reuses tool_gate semantics: the
//                  SAME T0..T3 ladder; NO 2nd gate is introduced here).
//   · surface_fn — the real executor key dispatched in exec_safe_real_tool /
//                  exec_effectful_tool (agent_loop.hexa delegates here).
//   · effectful  — false ⇒ read-only/safe, wired & fires NOW; true ⇒ has a side
//                  effect (write/run/commit/live-op), fires ONLY when the env
//                  opt-in ANIMA_TOOLS_EFFECTFUL=1 is set AND the tier gate passes.
//
// HONESTY (mission contract): the mouth is unverified (grounding 0/36 at write
// time), so an UNSUPERVISED destructive path must NOT auto-arm. Effectful tools
// therefore default SAFE — the plumbing exists, but with the env unset they
// return an honest "‹effectful tool gated…›" refusal, never a fabricated effect.
//
//   SAFE-REAL (effectful=false, wired now):
//     status (T0)      → fixed liveness  · think (T0) → real reflection echo
//     mem_read (T0)    → fixed slot      · repo_status (T0) → real `git status`
//     web_search (T1)  → real curl OR honest no-network stub
//     file_read (T1)   → real disk read  · grep (T1) → real `grep -rn`
//     market_scan (T1) → real MERCHANT inventory read (read-only)
//   EFFECTFUL (effectful=true, env-armed):
//     file_write (T2)  · run_tests/code_run (T2) · git_commit/git_push (T3)
//     publish (T3) · merchant_order/live_trade (T3) · desktop_action (T2)

// tool_registry_full — toy tools (§3) ∪ the REAL role tools. agent_loop.hexa's
// exec_real_tool consults this to route toy → deterministic, safe-real → real
// surface, effectful → env-gated. The toy entries keep their {tier, fn} shape
// (effectful absent ⇒ treated as a toy/deterministic execution).
pub fn tool_registry_full() -> Map {
    return #{
        // ── toy / deterministic (§3) ──
        "fact_lookup": #{ "tier": 1, "fn": "fact_lookup",  "effectful": false, "kind": "toy" },
        "mem_read":    #{ "tier": 0, "fn": "mem_read",     "effectful": false, "kind": "toy" },
        "status":      #{ "tier": 0, "fn": "status",       "effectful": false, "kind": "toy" },
        // ── SAFE-REAL role tools (read-only — wired NOW) ──
        "think":       #{ "tier": 0, "fn": "think",        "effectful": false, "kind": "safe" },
        "repo_status": #{ "tier": 0, "fn": "repo_status",  "effectful": false, "kind": "safe" },
        "web_search":  #{ "tier": 1, "fn": "web_search",   "effectful": false, "kind": "safe" },
        "file_read":   #{ "tier": 1, "fn": "file_read",    "effectful": false, "kind": "safe" },
        "grep":        #{ "tier": 1, "fn": "grep",         "effectful": false, "kind": "safe" },
        "market_scan": #{ "tier": 1, "fn": "market_scan",  "effectful": false, "kind": "safe" },
        // ── EFFECTFUL role tools (side-effect — env-armed, default SAFE) ──
        "file_write":     #{ "tier": 2, "fn": "file_write",     "effectful": true, "kind": "effect" },
        "run_tests":      #{ "tier": 2, "fn": "run_tests",      "effectful": true, "kind": "effect" },
        "code_run":       #{ "tier": 2, "fn": "code_run",       "effectful": true, "kind": "effect" },
        "desktop_action": #{ "tier": 2, "fn": "desktop_action", "effectful": true, "kind": "effect" },
        "git_commit":     #{ "tier": 3, "fn": "git_commit",     "effectful": true, "kind": "effect" },
        "git_push":       #{ "tier": 3, "fn": "git_push",       "effectful": true, "kind": "effect" },
        "publish":        #{ "tier": 3, "fn": "publish",        "effectful": true, "kind": "effect" },
        "merchant_order": #{ "tier": 3, "fn": "merchant_order", "effectful": true, "kind": "effect" },
        "live_trade":     #{ "tier": 3, "fn": "live_trade",     "effectful": true, "kind": "effect" }
    }
}

// registry_effectful — is `tool` registered as having a side effect? (unknown ⇒
// false here; the tier gate already refuses an unknown tool via registry_tier=99.)
pub fn registry_effectful(registry: Map, tool: string) -> bool {
    if has_key(registry, tool) {
        let entry = registry[tool]
        if has_key(entry, "effectful") { return to_bool(entry["effectful"]) }
    }
    return false
}

// registry_kind — "toy" | "safe" | "effect" | "unknown". Drives exec_real_tool's
// three-way dispatch.
pub fn registry_kind(registry: Map, tool: string) -> string {
    if has_key(registry, tool) {
        let entry = registry[tool]
        if has_key(entry, "kind") { return to_string(entry["kind"]) }
        return "toy"                                  // legacy {tier,fn} ⇒ toy
    }
    return "unknown"
}

// _tcg_env — read an environment variable via the shell (no getenv builtin).
// Same pattern agent/domains/DESKTOP/action.hexa uses for ANIMA_DESKTOP_DRYRUN.
fn _tcg_env(name: string) -> string {
    let raw = to_string(exec("/bin/sh -c 'printf %s \"${" + name + "}\"'"))
    // strip a trailing newline if the shell added one.
    let n = byte_len(raw)
    if n > 0 && byte_at(raw, n - 1) == 0x0A { return substring(raw, 0, n - 1) }
    return raw
}

// effectful_armed — true iff ANIMA_TOOLS_EFFECTFUL is explicitly opted in. Read
// FRESH per call (no caching), default OFF — the safe default (mission contract).
pub fn effectful_armed() -> bool {
    let v = _tcg_env("ANIMA_TOOLS_EFFECTFUL")
    return v == "1" || v == "true"
}

// _tcg_first_token — first whitespace-delimited token of `s` (SP split, "" safe).
fn _tcg_first_token(s: string) -> string {
    let sp = _tcg_first_byte(s, 0x20)
    if sp < 0 { return s }
    return substring(s, 0, sp)
}

// exec_safe_real_tool — execute a SAFE (read-only, no side effect) REAL role
// tool. These fire NOW (the tier gate is applied by the caller). Each is a REAL
// observation — a real disk read / real git query / real grep — NOT a fabricated
// success (p5/p7). A tool that needs an unavailable resource (web_search without
// network) returns an HONEST stub labelled as such, never a faked result.
pub fn exec_safe_real_tool(tool: string, args: string) -> string {
    if tool == "think" {
        // reflection is a real internal echo — no external effect, no fabrication.
        return "‹think› " + args
    }
    if tool == "repo_status" {
        // real, read-only `git status` of the cwd (porcelain = stable surface).
        return to_string(exec("/bin/sh -c 'git status --porcelain 2>&1 | head -40'"))
    }
    if tool == "file_read" {
        // args = a path (first token). Real disk read; missing file ⇒ honest miss.
        let path = _tcg_first_token(args)
        let probe = to_string(exec("/bin/sh -c 'test -r \"" + path + "\" && echo OK || echo NO'"))
        if _tcg_first_token(probe) != "OK" {
            return "‹file_read miss: " + path + "› (unreadable / absent — no fabrication)"
        }
        return to_string(read_file(path))
    }
    if tool == "grep" {
        // args = pattern (first token); real recursive grep of the cwd, bounded.
        let pat = _tcg_first_token(args)
        if byte_len(pat) == 0 {
            return "‹grep: empty pattern› (no fabrication)"
        }
        return to_string(exec("/bin/sh -c 'grep -rnI -- \"" + pat + "\" . 2>/dev/null | head -40'"))
    }
    if tool == "web_search" {
        // REAL only when network+curl are available; otherwise an HONEST stub
        // (no creds/network here ⇒ we do NOT fabricate a result, mission contract).
        let have = _tcg_first_token(to_string(exec("/bin/sh -c 'command -v curl >/dev/null 2>&1 && echo Y || echo N'")))
        if have != "Y" {
            return "‹web_search unavailable: no curl/network in this env› query=\"" + args + "\" (honest stub — not fabricated)"
        }
        // Network reachability probe (no result fabrication on failure).
        let net = _tcg_first_token(to_string(exec("/bin/sh -c 'curl -s -m 4 -o /dev/null -w %{http_code} https://duckduckgo.com/ 2>/dev/null || echo 000'")))
        if net == "000" || byte_len(net) == 0 {
            return "‹web_search unavailable: network unreachable› query=\"" + args + "\" (honest stub — not fabricated)"
        }
        // Real HTML fetch (provider-light); the loop's anchor carries the raw body.
        let body = to_string(exec("/bin/sh -c 'curl -s -m 6 \"https://duckduckgo.com/html/?q=" + args + "\" 2>/dev/null | sed -e s/\\<[^>]*\\>//g | tr -s \" \\n\" \" \" | head -c 600'"))
        if byte_len(body) == 0 {
            return "‹web_search: empty response› query=\"" + args + "\" (honest — not fabricated)"
        }
        return "web_search(" + args + "): " + body
    }
    if tool == "market_scan" {
        // read-only MERCHANT surface descriptor (real ops_summary is the surface;
        // a live adapter read would supply args — kept read-only, no order placed).
        return "market_scan: MERCHANT ops read-only surface available (ops_summary); no live order placed"
    }
    return "‹not wired (safe): " + tool + "›"          // honest — unreached normally
}

// exec_effectful_tool — execute an EFFECTFUL REAL role tool, GATED by the env
// opt-in. The TIER gate is already applied by the caller (tool_allowed); this
// function adds the SAFETY opt-in: with ANIMA_TOOLS_EFFECTFUL unset it returns
// an honest gated-refusal (the default), NEVER a fabricated effect. With the env
// set it routes to the real role surface. This keeps the plumbing complete while
// defaulting SAFE on an unverified mouth (mission contract honesty).
pub fn exec_effectful_tool(tool: string, args: string) -> string {
    if !effectful_armed() {
        return "‹effectful tool gated: set ANIMA_TOOLS_EFFECTFUL=1 to enable› tool=" + tool + " args=\"" + args + "\""
    }
    // ARMED — route to the real surface (tier already cleared by the caller).
    if tool == "file_write" {
        // args = "<path> <content…>" — real write of `content` to `path`.
        let sp = _tcg_first_byte(args, 0x20)
        if sp < 0 { return "‹file_write: missing content (need <path> <content>)›" }
        let path = substring(args, 0, sp)
        let content = substring(args, sp + 1, byte_len(args))
        write_file(path, content)
        return "file_write OK: " + to_string(byte_len(content)) + " bytes → " + path
    }
    if tool == "run_tests" || tool == "code_run" {
        // args = a shell command to run (CODE role T2). Real exec, bounded output.
        return to_string(exec("/bin/sh -c '" + args + " 2>&1 | head -60'"))
    }
    if tool == "desktop_action" {
        // DESKTOP role — the real ax_* surface is dispatched here when armed; we
        // keep it to the safe descriptor unless a concrete action is bound (the
        // action verbs themselves honor ANIMA_DESKTOP_DRYRUN independently).
        return "desktop_action ARMED: route to agent/domains/DESKTOP ax_* (action=" + args + ")"
    }
    if tool == "git_commit" {
        return to_string(exec("/bin/sh -c 'git commit -m \"" + args + "\" 2>&1 | head -20'"))
    }
    if tool == "git_push" {
        return to_string(exec("/bin/sh -c 'git push 2>&1 | head -20'"))
    }
    if tool == "publish" || tool == "merchant_order" || tool == "live_trade" {
        // highest-consequence T3 ops — route to the role surface when armed. Kept
        // descriptor-level here (a live order/trade needs a bound adapter+creds).
        return tool + " ARMED: route to role surface (args=" + args + ") — bind adapter+creds to fire"
    }
    return "‹not wired (effect): " + tool + "›"
}


// ── §4 unit smoke (p7: deterministic equality, NO perplexity) ────────────────
//
// Run: hexa run agent/domains/CORE/tool_call_grammar.hexa
// Proves: (1) a well-formed frame parses to the right tool+args; (2) a malformed
// frame (ASK, no END) → found=false; (3) plain text (no sentinel) → found=false;
// (4) the sentinel never collides with UTF-8 content (a Korean+emoji string
// yields no false frame); plus registry tier lookup + the real toy execution.

fn _expect_eq_str(label: string, got: string, want: string) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print("  [" + tag + "] " + label + " got=\"" + got + "\" want=\"" + want + "\"")
    return ok
}

fn _expect_eq_int(label: string, got: int, want: int) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print("  [" + tag + "] " + label + " got=" + to_string(got) + " want=" + to_string(want))
    return ok
}

fn main() {
    print("== tool_call_grammar unit smoke ==")
    let mut all = true

    // (1) well-formed frame parses.
    let fe = frame_ask_str()
    let ff = frame_end_str()
    let good = "thinking… " + fe + "fact_lookup ZK7" + ff
    let g = parse_call_frame(good)
    all = _expect_eq_str("(1) found",   to_string(g["found"]), "true") && all
    all = _expect_eq_str("(1) tool",    to_string(g["tool"]),  "fact_lookup") && all
    all = _expect_eq_str("(1) args",    to_string(g["args"]),  "ZK7") && all
    all = _expect_eq_str("(1) pre",     to_string(g["pre"]),   "thinking… ") && all

    // (2) malformed frame: ASK with no END → found=false (no fabrication).
    let bad = "thinking… " + fe + "fact_lookup ZK7 (never closed)"
    let b = parse_call_frame(bad)
    all = _expect_eq_str("(2) malformed found", to_string(b["found"]), "false") && all

    // (3) plain text (no sentinel) → found=false.
    let plain = "the answer is forty-two, no tools needed"
    let p = parse_call_frame(plain)
    all = _expect_eq_str("(3) plaintext found", to_string(p["found"]), "false") && all

    // (4) UTF-8 non-collision: Korean + emoji content must NOT yield a frame.
    //     (0xFE/0xFF can never appear inside valid UTF-8, so no false ASK.)
    let utf8 = "안녕하세요 🌊 도구 없이 그냥 텍스트입니다 émojis café"
    let u = parse_call_frame(utf8)
    all = _expect_eq_str("(4) utf8 no-collision found", to_string(u["found"]), "false") && all

    // registry: known tiers + unknown ⇒ high refuse-tier.
    let reg = tool_registry()
    all = _expect_eq_int("reg fact_lookup tier", registry_tier(reg, "fact_lookup"), 1) && all
    all = _expect_eq_int("reg mem_read tier",    registry_tier(reg, "mem_read"),    0) && all
    all = _expect_eq_int("reg unknown tier",     registry_tier(reg, "web_search"),  99) && all

    // real toy execution (deterministic, unknowable-without-tool value).
    all = _expect_eq_str("exec fact_lookup ZK7", exec_toy_tool("fact_lookup", "ZK7"),
                         "vault-azure-quill-3391") && all
    all = _expect_eq_str("exec unwired tool", exec_toy_tool("web_search", "x"),
                         "‹not wired: web_search›") && all

    print(if all { "== ALL PASS ==" } else { "== SOME FAIL ==" })
}
