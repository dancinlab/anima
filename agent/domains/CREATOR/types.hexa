// types.hexa — CREATOR common data types (M1 closure)
// Bridge architecture: tool surface only — no consciousness framing.
//
// 5 canonical types for the channel-content production pipeline:
//   Brand       — voice / palette / persona seeds for a channel
//   Script      — text outline (title · hook · beats · CTA)
//   MediaAsset  — still / clip / audio with tier + provenance
//   UploadJob   — publish task (asset → channel · status · retry)
//   Channel     — destination platform (youtube / tiktok / instagram)
//
// All constructors return a Map (`#{}`); fields documented inline.
// M2+ backend framework (CreatorBackend) consumes + returns these for a
// uniform shape across 3-tier modality (L1 STILL · L2 PROG · L3 GEN).

// ---------------------------------------------------------------
// 1. Brand — voice / palette / persona seeds for a channel
//   id: string (slug)
//   name: string (display)
//   tone: string ("calm" · "energetic" · "ironic" · "wholesome" · "professional")
//   palette: list of string (hex colors, e.g. ["#1F1F1F", "#F5F5F5"])
//   tags: list of string (semantic tags)
// ---------------------------------------------------------------
pub fn creator_brand(id, name, tone, palette, tags) {
    return #{
        "id": id,
        "name": name,
        "tone": tone,
        "palette": palette,
        "tags": tags,
        "kind": "Brand",
    }
}

// ---------------------------------------------------------------
// 2. Script — text outline for a piece of content
//   title: string
//   hook: string (first 3-5 second attention grab)
//   beats: list of string (ordered narrative beats)
//   cta: string (call-to-action — "subscribe" / "comment" / "share" / "")
//   duration_s: float (target seconds)
// ---------------------------------------------------------------
pub fn creator_script(title, hook, beats, cta, duration_s) {
    return #{
        "title": title,
        "hook": hook,
        "beats": beats,
        "cta": cta,
        "duration_s": duration_s,
        "n_beats": beats.len(),
        "kind": "Script",
    }
}

// ---------------------------------------------------------------
// 3. MediaAsset — generated still / clip / audio with provenance
//   asset_id: string
//   media_type: "still" · "clip" · "audio"
//   tier: "L1" (STILL openai) · "L2" (PROG remotion) · "L3" (GEN fal/omnishow)
//   path: string (local or URL)
//   meta: Map (free-form: width/height/duration/sample_rate)
//   provenance: Map { backend, model, prompt_hash, generated_at }
// ---------------------------------------------------------------
pub fn creator_media_asset(asset_id, media_type, tier, path, meta, provenance) {
    return #{
        "asset_id": asset_id,
        "media_type": media_type,
        "tier": tier,
        "path": path,
        "meta": meta,
        "provenance": provenance,
        "kind": "MediaAsset",
    }
}

// ---------------------------------------------------------------
// 4. UploadJob — publish task
//   job_id: string
//   asset: MediaAsset Map
//   channel: Channel Map
//   caption: string
//   tags: list of string
//   status: "pending" · "uploading" · "published" · "failed"
//   retry_count: int
//   external_id: string (set after publish success)
// ---------------------------------------------------------------
pub fn creator_upload_job(job_id, asset, channel, caption, tags) {
    return #{
        "job_id": job_id,
        "asset": asset,
        "channel": channel,
        "caption": caption,
        "tags": tags,
        "status": "pending",
        "retry_count": 0,
        "external_id": "",
        "kind": "UploadJob",
    }
}

// ---------------------------------------------------------------
// 5. Channel — destination platform
//   channel_id: string (slug)
//   platform: "youtube" · "tiktok" · "instagram"
//   user_handle: string (@user)
//   credential_ref: string (secret service key; never the secret value)
// ---------------------------------------------------------------
pub fn creator_channel(channel_id, platform, user_handle, credential_ref) {
    return #{
        "channel_id": channel_id,
        "platform": platform,
        "user_handle": user_handle,
        "credential_ref": credential_ref,
        "kind": "Channel",
    }
}

// ---------------------------------------------------------------
// helpers — kind dispatcher + summary
// ---------------------------------------------------------------
pub fn creator_type_kind(obj) {
    let k = obj["kind"]
    if type_of(k) == "string" {
        return k
    }
    return "unknown"
}

pub fn creator_type_summary() {
    return "CREATOR M1 types: Brand · Script · MediaAsset · UploadJob · Channel (5/5)"
}
