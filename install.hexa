// install.hexa — hx install hook for anima
//
// Invoked by `hx install anima` (or `hx update anima`) with env:
//   HX_PKG_DIR  — anima source dir
//   HX_BIN_DIR  — ~/.hx/bin
//   HX_PKG_NAME — "anima"
//
// anima is hexa-native (interpreted) — there is NO compile step. Install =
//   (1) tag-pin self-update so every clone converges on the latest release,
//   (2) run anima's existing setup.hexa (presence verify + checkpoint/scaffold
//       download). setup.hexa is the SSOT for the actual install work; this
//       hook only pins the release tag then delegates to it.
//
// Disable the self-update with ANIMA_NO_SELF_UPDATE=1 (offline / dev escape).

fn have(cmd: string) -> bool {
    let r = to_string(exec("command -v " + cmd + " 2>/dev/null")).trim()
    return r != ""
}

fn dir_exists(p: string) -> bool {
    let r = to_string(exec("test -d '" + p + "' && echo y || echo n")).trim()
    return r == "y"
}

fn run_or_die(cmd: string) {
    let result = exec_with_status(cmd)
    if result[1] != 0 {
        eprintln("FAILED: " + cmd)
        exit(1)
    }
}

fn main() {
    let pkg_dir_raw = env("HX_PKG_DIR")
    let pkg_dir = if pkg_dir_raw != "" { pkg_dir_raw } else { to_string(exec("pwd")).trim() }

    // 기본 브랜치를 동적으로 감지 (하드코딩 금지) — origin/HEAD가 가리키는 브랜치.
    // start-block(self-update)과 end-block(restore) 양쪽에서 읽도록 outer-scope.
    let defbranch = to_string(exec("cd '" + pkg_dir + "' && git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'")).trim()
    let defb = if defbranch != "" { defbranch } else { "main" }

    // ── SELF-UPDATE (tag-pinned, bootstrap-safe) ──
    // 모두가 동일한 "최신 릴리스 태그" 클론으로 수렴하도록 self-update.
    // bootstrap-safe: 먼저 기본 브랜치로 self-heal(가장 신선한 install.hexa 로직 로드)
    // → 그 다음 최신 v* 태그를 detach-checkout 하여 그 정확한 릴리스를 설치.
    // ANIMA_NO_SELF_UPDATE=1 로 통째로 비활성화 가능(오프라인/dev 탈출구).
    if env("ANIMA_NO_SELF_UPDATE") != "1" && have("git") && dir_exists(pkg_dir + "/.git") {
        run_or_die("cd '" + pkg_dir + "' && git fetch --tags --force origin 2>&1 | tail -2")
        run_or_die("cd '" + pkg_dir + "' && git fetch origin 2>&1 | tail -2")
        // dirty tree → WIP 보호용 stash 먼저.
        if to_string(exec("cd '" + pkg_dir + "' && git status --porcelain")).trim() != "" {
            println("🧠 anima: 작업 트리에 변경사항 있음 — self-update 전 git stash (anima-selfupdate-autostash)")
            exec("cd '" + pkg_dir + "' && git stash push -u -m anima-selfupdate-autostash 2>&1 | tail -1")
        }
        run_or_die("cd '" + pkg_dir + "' && git checkout " + defb + " 2>&1 | tail -1")
        run_or_die("cd '" + pkg_dir + "' && git reset --hard origin/" + defb + " 2>&1 | tail -1")
        // 최신 v* 태그 선택 (semver 내림차순 → head -1).
        let tag = to_string(exec("cd '" + pkg_dir + "' && git tag --list 'v*' --sort=-v:refname | head -1")).trim()
        if tag != "" {
            println("🧠 anima: installing release tag " + tag)
            run_or_die("cd '" + pkg_dir + "' && git checkout --detach " + tag + " 2>&1 | tail -1")
        } else {
            println("🧠 anima: 태그 없음 — " + defb + " head 설치 (no release tag yet)")
        }
    }

    // ── INSTALL (delegate to setup.hexa) ──
    // anima 는 interpreted hexa-native — compile 단계 없음. 실제 설치 작업
    // (hexa runtime 존재 확인 · checkpoints/clm_v2 scaffold · 모델 체크포인트
    // 다운로드) 은 setup.hexa 가 SSOT 다. 태그 핀이 끝난 정확한 릴리스 트리에서
    // 그대로 실행한다. HEXA 환경변수가 없으면 현재 hexa 바이너리로 채워준다.
    let setup = pkg_dir + "/setup.hexa"
    if env("HEXA") == "" {
        let hx = to_string(exec("command -v hexa 2>/dev/null")).trim()
        if hx != "" {
            // setup.hexa 의 hexa-runtime presence check 가 통과하도록 HEXA 를 채운다.
            exec("export HEXA='" + hx + "'")
        }
    }
    // CI/package managers may expose hexa to the parent process while the
    // runtime's nested /bin/sh has a narrower PATH.  Preserve the absolute
    // launcher supplied by hx install instead of resolving it a second time.
    let hexa_from_env = env("HEXA").trim()
    let hexa_bin = if hexa_from_env != "" {
        hexa_from_env
    } else {
        to_string(exec("command -v hexa 2>/dev/null")).trim()
    }
    let hexa_run = if hexa_bin != "" { hexa_bin } else { "hexa" }
    println("🧠 anima: running setup.hexa (presence verify + checkpoint download)")
    let hx_env = if hexa_bin != "" { "HEXA='" + hexa_bin + "' " } else { "" }
    run_or_die("cd '" + pkg_dir + "' && " + hx_env + hexa_run + " run '" + setup + "'")

    println("🧠 anima: install complete — `anima` (PATH command) → cli/anima.hexa: train · serialize · evaluate · chat")

    // ── RESTORE (self-update 종료 복원) ──
    // detach 상태(설치한 태그)에서 기본 브랜치로 되돌려, 다음 실행에서 다시
    // 브랜치의 self-update 로직이 돌도록 한다. 주의: 이 복원은 디스크의 install.hexa가
    // detach된 태그본이어도 "메모리에 로드된 브랜치본" install.hexa에서 실행된다 —
    // 이는 의도된 동작이며, self-update가 실행 간에 살아있게 유지하는 핵심이다.
    if env("ANIMA_NO_SELF_UPDATE") != "1" && have("git") && dir_exists(pkg_dir + "/.git") {
        exec("cd '" + pkg_dir + "' && git checkout " + defb + " 2>&1 | tail -1")
    }
}
