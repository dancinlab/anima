// ════════════════════════════════════════════════════════════════════════════
//  kosmos_corpus_io.hexa — `.kosmos` @corpus DATASET reader (kosmos/2.0 §5.6)
//
//  ENCODER 도메인 소유. anima 측 .kosmos 로더의 @corpus(데이터셋) 절반.
//  base helpers(trim/starts_with/unquote/field_key/field_value/parse_psi/
//  is_skip_line/anchor_name)는 UNIVERSE-BRAIN-MAP/kosmos_parser_lib.hexa 에서
//  import 재사용 (helper 중복 0). @anchor 로더는 그 lib(§5)에 그대로 있고,
//  여기는 @corpus 전용 — 두 top-level entry(@anchor XOR @corpus, spec §6.2)의
//  corpus 쪽.
//
//  kosmos_load_corpus(path) → corpus record:
//    #{ "id","name","vacuum_psi"(=coord centroid),"cell_id"(=lane),
//       "basin_radius"(=radius),"anchor_level","count","lane_mix","vocab",
//       "encoding","merkle","closed_corpus",
//       "members":[ #{"path","sha256","count","frac","lane"} ],
//       "member_count","ok" }
//
//  profile-bound (anima §5.5): coord=centroid · radius=spread — design
//  placeholder until ENCODER E_m measures them. members = anchor-pack (.limen)
//  shards (spec/limen.md).
//
//  HARD: pure-hexa · NO main · #{} dict · import abs-path.
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/UNIVERSE-BRAIN-MAP/kosmos_parser_lib.hexa"


// ── @corpus header ───────────────────────────────────────────────────────────

fn kosmos_is_corpus_header(line: string) -> bool {
    let t = kosmos_trim(line)
    return kosmos_starts_with(t, "@corpus ")
}

// extract corpus id (token between `@corpus ` and ` :=`). "@corpus " = 8 chars.
fn kosmos_corpus_id(line: string) -> string {
    let t = kosmos_trim(line)
    if kosmos_is_corpus_header(t) == false { return "" }
    let rest = kosmos_trim(t.substring(8, len(t)))
    let assign = rest.index_of(":=")
    if assign < 0 { return "" }
    return kosmos_trim(rest.substring(0, assign))
}


// ── member = ref parsing ─────────────────────────────────────────────────────

// read a `key=token` attr from a member line (token to next space; optional
// surrounding quotes). e.g. kosmos_member_attr(line, "sha256").
fn kosmos_member_attr(line: string, key: string) -> string {
    let k = key + "="
    let p = line.index_of(k)
    if p < 0 { return "" }
    let mut i = p + len(k)
    let mut quoted = false
    if i < len(line) { if line.substring(i, i + 1) == "\"" { quoted = true i = i + 1 } }
    let mut out = ""
    while i < len(line) {
        let c = line.substring(i, i + 1)
        if quoted { if c == "\"" { break } } else { if c == " " || c == "\t" { break } }
        out = out + c
        i = i + 1
    }
    return out
}

// parse `member = ref "<path>" sha256=<h> count=<N> frac=<f> lane="<l>"`.
fn kosmos_parse_member(line: string) -> any {
    let t = kosmos_trim(line)
    let mut path = ""
    let rp = t.index_of("ref")
    if rp >= 0 {
        let after_ref = t.substring(rp + 3, len(t))
        let q1 = after_ref.index_of("\"")
        if q1 >= 0 {
            let after_q = after_ref.substring(q1 + 1, len(after_ref))
            let q2 = after_q.index_of("\"")
            if q2 >= 0 { path = after_q.substring(0, q2) }
        }
    }
    return #{
        "path": path,
        "sha256": kosmos_member_attr(t, "sha256"),
        "count": to_int(kosmos_member_attr(t, "count")),
        "frac": to_float(kosmos_member_attr(t, "frac")),
        "lane": kosmos_member_attr(t, "lane")
    }
}


// ── kosmos_load_corpus — full @corpus file → corpus record ───────────────────

fn kosmos_load_corpus(path: string) -> any {
    let body = read_file(path)
    let lines = body.split("\n")
    let nlines = len(lines)

    let mut rec = #{
        "id": "",
        "name": "",
        "vacuum_psi": [],
        "cell_id": "",
        "basin_radius": 0.0,
        "anchor_level": "2tier",
        "count": 0,
        "lane_mix": "",
        "vocab": 0,
        "encoding": "",
        "merkle": "",
        "closed_corpus": "",
        "members": [],
        "member_count": 0,
        "ok": false
    }

    let mut saw_corpus = false
    let mut members = []
    let mut i = 0
    while i < nlines {
        let line = lines[i]
        if kosmos_is_skip_line(line) {
            i = i + 1
        } else {
            let t = kosmos_trim(line)
            if kosmos_is_corpus_header(t) {
                rec["id"] = kosmos_corpus_id(t)
                rec["name"] = kosmos_anchor_name(t)   // `:= "..." ::` parse identical
                saw_corpus = true
            } else {
                if kosmos_starts_with(t, "member ") || kosmos_starts_with(t, "member=") {
                    members = members.push(kosmos_parse_member(t))
                } else {
                    let key = kosmos_field_key(t)
                    let val = kosmos_field_value(t)
                    if key == "coord"         { rec["vacuum_psi"] = kosmos_parse_psi(val) }
                    if key == "lane"          { rec["cell_id"] = kosmos_unquote(val) }
                    if key == "radius"        { rec["basin_radius"] = to_float(val) }
                    if key == "anchor_level"  { rec["anchor_level"] = kosmos_unquote(val) }
                    if key == "count"         { rec["count"] = to_int(val) }
                    if key == "lane_mix"      { rec["lane_mix"] = kosmos_unquote(val) }
                    if key == "vocab"         { rec["vocab"] = to_int(val) }
                    if key == "encoding"      { rec["encoding"] = kosmos_unquote(val) }
                    if key == "merkle"        { rec["merkle"] = kosmos_unquote(val) }
                    if key == "closed_corpus" { rec["closed_corpus"] = kosmos_unquote(val) }
                }
            }
            i = i + 1
        }
    }

    rec["members"] = members
    rec["member_count"] = len(members)
    rec["ok"] = saw_corpus && (len(members) > 0) && (to_int(rec["vocab"]) > 0)
    return rec
}

// closed predicate — corpus record well-formed.
fn kosmos_corpus_valid(corpus: any) -> bool {
    return to_string(corpus["ok"]) == "true"
}
