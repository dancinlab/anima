// ═════════════════════════════════════════════════════════════════════════
// PLASTICITY/plasticity_lane.hexa — 학습 lane 라우터 (HW-first 스위치 경유)
//
// 학습 lane (비결정론 · HW-only). DECODER(추론 lane · 결정론 · byte-identical)와
// 본질이 다른 형제 lane. AKIDA HW-first 스위치 SSOT
// (../AKIDA/akida_backend.hexa::akida_backend_resolve_graceful · default "hw")
// 한 점을 경유해 HW=edge_learn / SW=numpy 근사 를 라우팅한다.
//
// 🔴 CLOSED-NEGATIVE 정직성:
//   SW 근사(plasticity_sw_approx.py)는 HW on-chip AkidaUnsupervised Hebbian 과
//   byte-identical 재현 불가 (float weight · no on-chip competition/pruning/timing).
//   DECODER lane 의 SW(akida_sw_lif)는 byte-identical 이지만, 학습 lane 의 SW 는
//   근사 baseline 일 뿐 HW 대체 아님. 위조 동치 금지 (p7 · a_blue_closed).
// ═════════════════════════════════════════════════════════════════════════

import "../AKIDA/akida_backend.hexa" as bk

// 학습 lane provenance — decoder 규약("akida-hw"/"akida-sw-fallback")과 구분.
// 학습은 SW 가 HW 비동치이므로 "fallback" 이 아닌 "sw-approx" 로 정직 표기.
pub fn plasticity_provenance(arg: string) -> string {
    let backend = bk.akida_backend_resolve_graceful(arg)
    if backend == "hw" { return "akida-learn-hw" }
    return "akida-learn-sw-approx"
}

// HW path 콜 스펙 (pi5-akida 에서 실행될 probe) — 본 hexa 는 라우팅 의도만 표기.
// 실 실행 = SUB_ENGINES/AKIDA/scripts/edge_learn_probe.py (akida.AkidaUnsupervised).
pub fn plasticity_hw_probe_path() -> string {
    return "SUB_ENGINES/AKIDA/scripts/edge_learn_probe.py"
}

// SW path 콜 스펙 — numpy 근사 (HW 비동치).
pub fn plasticity_sw_approx_path() -> string {
    return "PLASTICITY/plasticity_sw_approx.py"
}

// 학습 lane 의 SW↔HW 동치 verdict — 정직 🔴 CLOSED-NEGATIVE.
// DECODER lane 의 byte-identical(🟢) 과 대비되는 핵심 경계.
pub fn plasticity_equivalence_verdict() -> string {
    return "🔴 CLOSED-NEGATIVE (SW numpy 근사 ≠ HW on-chip AkidaUnsupervised — byte-identical 불가)"
}

// 라우팅 요약 dict (provenance + verdict + 두 경로).
pub fn plasticity_route(arg: string) -> map {
    let backend = bk.akida_backend_resolve_graceful(arg)
    return #{
        "lane": "PLASTICITY (학습 · 비결정론)",
        "backend": backend,
        "provenance": plasticity_provenance(arg),
        "hw_probe": plasticity_hw_probe_path(),
        "sw_approx": plasticity_sw_approx_path(),
        "sw_hw_equivalence": plasticity_equivalence_verdict(),
        "sibling_decoder_equivalence": "🟢 byte-identical (대비 — 추론 lane 은 결정론)",
    }
}
