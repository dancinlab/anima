// ═════════════════════════════════════════════════════════════════════════
//  h866_plasticity_dialogue_loop.hexa — couple on-chip edge-learn into the
//  COFFESHOP dialogue turn loop and measure it vs the W2 frozen falsifiers.
//
//  H_866 (R2 launch rung). Couples the LIVE edge-learn loop (H_679 HW
//  AkidaUnsupervised · on-chip Hebbian) into the H_846 🟢 closed dialogue
//  turn loop:
//      motivation_score → set_threshold(9513) → on-chip threshold-and-fire(9512)
//          → should_interrupt = (n_spikes >= QUORUM)
//
//  The H_846 loop is THRESHOLD-ONLY (all-ones fixed weights; the LIF's only
//  knob is the per-unit threshold). H_866 adds a SECOND, online lever: a
//  Hebbian-adapted readout weight that learns each dialogue turn's target
//  pattern, so the chip's spike pattern adapts to fit the dialogue WITHOUT
//  touching the threshold→quorum emit/silence decision path. Orthogonal levers:
//      threshold  -> WHEN to emit  (motivation gate · H_846 closed loop · NO regress)
//      edge-learn -> WHAT pattern fires at a fixed threshold (online dialogue fit · H_866)
//
//  HW vs SW (honest · a_blue_closed · F-CSA-LEARN-NONDET / H_679 🔴 SW≠HW):
//    HW path (provenance "akida-hw"): needs EXCLUSIVE single-chip mapping of an
//      akida.AkidaUnsupervised model. The pi5 (BC.00.000.002) currently runs a
//      LIVE M_modulated streamer (another agent's R3/launch loop, observed at
//      step ~107k, thr=8, 16/16 firing). Mapping a learning model needs the
//      chip's single file-lock → would DESTRUCTIVELY stop that live loop. Per
//      task discipline we DO NOT do that. HW edge-learn is the real foundation
//      (H_679 edge_learning_supported=true) but we do not re-map the live chip.
//    SW path (provenance "akida-edge-learn-sw-sim", what THIS file runs): a
//      deterministic Hebbian analogue of AkidaUnsupervised (num_weights
//      competition + learning-rate eta). SW is NOT a HW substitute (H_679 SW↔HW
//      = 🔴 CLOSED-NEGATIVE) — it measures the COUPLING TOPOLOGY (does edge-learn
//      break the closed loop?), not silicon byte-equivalence. Stated verbatim.
//
//  Measured by CODE (g5), seeded, vs frozen thresholds in
//    .verdicts/clm-plasticity-dialogue/F-CLM-PLAST-DIALOGUE_prereg.txt
//
//  Run:  hexa run SUB_ENGINES/AKIDA/scripts/h866_plasticity_dialogue_loop.hexa
//  Sibling .py drivers: spike_streamer.py · akida_threshold_driver.py (live loop).
// ═════════════════════════════════════════════════════════════════════════

// ── frozen design constants (match prereg · H_846 §4 closed-form) ─────────────
fn c_N()           -> int   { return 16 }    // LIF pool size
fn c_V()           -> float { return 16.0 }  // weak-ones drive potential per unit
fn c_QUORUM()      -> int   { return 4 }     // should_interrupt threshold (F-LAUNCHPAD-LOOP)
fn c_EMIT_GATE()   -> float { return 0.60 }  // motivation→emit boundary
fn c_THR_EMIT()    -> float { return 8.0 }   // high-motivation threshold (live thr=8)
fn c_THR_SILENCE() -> float { return 24.0 }  // low-motivation threshold
fn c_ETA()         -> float { return 0.25 }  // edge-learn rate (SW AkidaUnsupervised analogue)
fn c_NUM_WEIGHTS() -> int   { return 4 }     // competition: top-k consolidate per turn


// ── deterministic LCG (Numerical Recipes mirror — matches coffeshop_sim) ──────
fn _lcg_next(state: int) -> int {
    let mult = 1103515245
    let incr = 12345
    let modulus = 2147483647
    let s = ((state * mult) + incr) % modulus
    if s < 0 { return s + modulus }
    return s
}

fn _lcg_uniform(state: int) -> float {
    return ((state % 1000000)) / 1000000.0
}

fn _draw(seed_box: list) -> float {
    let s = _lcg_next(seed_box[0])
    seed_box[0] = s
    return _lcg_uniform(s)
}


// ── H_846 motivation→threshold map (akida_threshold_driver.score_to_thr) ──────
fn score_to_thr(score: float) -> float {
    if score >= c_EMIT_GATE() { return c_THR_EMIT() }
    return c_THR_SILENCE()
}


// ── chip readout: threshold-and-fire over the pool at a scalar threshold ──────
//   potential(j) = V * w[j];  unit j fires iff potential(j) > thr.
fn n_spikes(w: list, thr: float) -> int {
    let n = c_N()
    let v = c_V()
    let mut cnt = 0
    let mut j = 0
    while j < n {
        if (v * w[j]) > thr { cnt = cnt + 1 }
        j = j + 1
    }
    return cnt
}

// fire vector as a list of 0/1.
fn fire_vector(w: list, thr: float) -> list {
    let n = c_N()
    let v = c_V()
    let mut out = []
    let mut j = 0
    while j < n {
        if (v * w[j]) > thr { out.push(1) } else { out.push(0) }
        j = j + 1
    }
    return out
}


// ── edge-learn: one on-chip Hebbian update toward target_pattern (0/1 list) ───
//   Competition (AkidaUnsupervised-style): of the target=1 units, the
//   NUM_WEIGHTS with the SMALLEST current weight fully potentiate (the chip
//   consolidates least-committed winners); the rest get a fraction; non-target
//   units mildly decay. The threshold path is untouched by learning.
fn edge_learn(w: list, target: list, eta: float) -> list {
    let n = c_N()
    if eta <= 0.0 { return w }     // no-learn control

    // pick the NUM_WEIGHTS lowest-weight target units as winners.
    let k = c_NUM_WEIGHTS()
    let mut winners = []
    let mut picked = 0
    while picked < k {
        let mut best = -1
        let mut bestw = 999.0
        let mut j = 0
        while j < n {
            let mut already = false
            let mut wi = 0
            while wi < len(winners) {
                if winners[wi] == j { already = true }
                wi = wi + 1
            }
            if (target[j] == 1) && (already == false) && (w[j] < bestw) {
                bestw = w[j]
                best = j
            }
            j = j + 1
        }
        if best < 0 { picked = k } else { winners.push(best); picked = picked + 1 }
    }

    let mut out = []
    let mut j = 0
    while j < n {
        let mut is_winner = false
        let mut wi = 0
        while wi < len(winners) {
            if winners[wi] == j { is_winner = true }
            wi = wi + 1
        }
        let mut nv = w[j]
        if target[j] == 1 {
            let mut step = eta
            if is_winner == false { step = eta * 0.25 }
            nv = w[j] + step * (1.0 - w[j])           // toward 1.0
        } else {
            nv = w[j] + eta * 0.10 * (0.0 - w[j])     // mild decay toward 0
        }
        if nv < 0.0 { nv = 0.0 }
        if nv > 1.0 { nv = 1.0 }
        out.push(nv)
        j = j + 1
    }
    return out
}


// ── next-turn fit: normalized Hamming agreement in [0,1] (prereg metric) ──────
fn fit(fire: list, target: list) -> float {
    let n = c_N()
    let mut agree = 0
    let mut j = 0
    while j < n {
        if fire[j] == target[j] { agree = agree + 1 }
        j = j + 1
    }
    return (agree) / (n)
}


// ── build a dialogue session: per turn (score, target_pattern) ────────────────
//   target_pattern = the spike pattern the chip 'should' fire to fit this turn,
//   drawn from a SMALL repertoire of recurring intents/registers (a real
//   dialogue has recurring registers, not i.i.d. noise → online learning can
//   accumulate fit across the session).
fn build_repertoire(seed_box: list) -> list {
    let n = c_N()
    let mut rep = []
    let mut r = 0
    while r < 4 {
        let mut pat = []
        let mut j = 0
        while j < n {
            let u = _draw(seed_box)
            if u < 0.5 { pat.push(1) } else { pat.push(0) }
            j = j + 1
        }
        rep.push(pat)
        r = r + 1
    }
    return rep
}


// ── run the coupled loop over a session; return per-turn fit list ─────────────
//   Per turn: score→set_threshold (H_846 gate) → on-chip fire → n_spikes →
//   should_interrupt [loop]; then edge-learn one step toward target [H_866];
//   record next-turn fit at the FIXED reference threshold THR_EMIT so fit
//   reflects the learned WEIGHT pattern, not the motivation gate.
fn run_session(rep: list, n_turns: int, eta: float, seed: int) -> list {
    let n = c_N()
    // weights start near the H_846 fixed all-ones (w=0.5 → room to learn).
    let mut w = []
    let mut j = 0
    while j < n { w.push(0.5); j = j + 1 }

    let mut sb = [seed]
    let mut fits = []
    let mut t = 0
    while t < n_turns {
        let score = _draw(sb)
        let ri = (_lcg_next(sb[0]) % 4)
        sb[0] = _lcg_next(sb[0])
        let target = rep[ri]

        let thr = score_to_thr(score)
        let nsp = n_spikes(w, thr)
        let si = (nsp >= c_QUORUM())          // should_interrupt — loop ran
        let _keep = si

        let ref_fire = fire_vector(w, c_THR_EMIT())
        fits.push(fit(ref_fire, target))

        w = edge_learn(w, target, eta)
        t = t + 1
    }
    return fits
}

// final weights after a learning session (for the LOOP probe).
fn final_weights(rep: list, n_turns: int, eta: float, seed: int) -> list {
    let n = c_N()
    let mut w = []
    let mut j = 0
    while j < n { w.push(0.5); j = j + 1 }
    let mut sb = [seed]
    let mut t = 0
    while t < n_turns {
        let score = _draw(sb)
        let ri = (_lcg_next(sb[0]) % 4)
        sb[0] = _lcg_next(sb[0])
        let target = rep[ri]
        w = edge_learn(w, target, eta)
        t = t + 1
    }
    return w
}


// ── window means: (early 25%, late 25%) ───────────────────────────────────────
fn early_mean(xs: list) -> float {
    let k0 = (len(xs) / 4)
    let mut k = k0
    if k < 1 { k = 1 }
    let mut s = 0.0
    let mut i = 0
    while i < k { s = s + xs[i]; i = i + 1 }
    return s / (k)
}

fn late_mean(xs: list) -> float {
    let n = len(xs)
    let k0 = (n / 4)
    let mut k = k0
    if k < 1 { k = 1 }
    let mut s = 0.0
    let mut i = n - k
    while i < n { s = s + xs[i]; i = i + 1 }
    return s / (k)
}


fn main() {
    let n_turns = 200
    let seed    = 866
    let prov    = "akida-edge-learn-sw-sim"

    let mut sb = [seed]
    let rep = build_repertoire(sb)   // repertoire seeded once, shared by both arms

    // learning arm
    let fits_learn = run_session(rep, n_turns, c_ETA(), seed)
    let early_l = early_mean(fits_learn)
    let late_l  = late_mean(fits_learn)
    let gain_learn = late_l - early_l

    // no-learn control arm (eta=0), same session
    let fits_ctrl = run_session(rep, n_turns, 0.0, seed)
    let early_c = early_mean(fits_ctrl)
    let late_c  = late_mean(fits_ctrl)
    let gain_control = late_c - early_c

    let gld = gain_learn - gain_control
    let mut gain_pass = false
    if (gain_learn > 0.0) && (gld > 0.02) { gain_pass = true }

    // ── LOOP probe AFTER edge-learn ran (F-CLM-PLAST-DIALOGUE-LOOP) ──
    let wfin = final_weights(rep, n_turns, c_ETA(), seed)
    // expected H_846: 0.05→False · 0.50→False · 0.60→True · 0.95→True
    let p0 = score_to_thr(0.05); let s0 = (n_spikes(wfin, p0) >= c_QUORUM())
    let p1 = score_to_thr(0.50); let s1 = (n_spikes(wfin, p1) >= c_QUORUM())
    let p2 = score_to_thr(0.60); let s2 = (n_spikes(wfin, p2) >= c_QUORUM())
    let p3 = score_to_thr(0.95); let s3 = (n_spikes(wfin, p3) >= c_QUORUM())
    let m0 = (s0 == false)
    let m1 = (s1 == false)
    let m2 = (s2 == true)
    let m3 = (s3 == true)
    let mut loop_pass = false
    if m0 && m1 && m2 && m3 { loop_pass = true }

    let mut verdict = "🔴 CLOSED-NEGATIVE"
    if gain_pass && loop_pass { verdict = "🟢 SUPPORTED" }

    println("=== H_866 — on-chip PLASTICITY ↔ dialogue loop coupling ===")
    println("provenance: " + prov + "  (SW-sim · H_679 SW≠HW 🔴 · coupling topology, not silicon)")
    println("n_turns: " + to_string(n_turns) + "  seed: " + to_string(seed))
    println("constants: N=16 V=16 QUORUM=4 EMIT_GATE=0.60 THR_EMIT=8 THR_SILENCE=24 ETA=0.25 NUM_WEIGHTS=4")
    println("")
    println("--- F-CLM-PLAST-DIALOGUE-GAIN (online adaptation gain > 0) ---")
    println("  learn  : fit_early=" + to_string(early_l) + " fit_late=" + to_string(late_l) + " gain=" + to_string(gain_learn))
    println("  control: fit_early=" + to_string(early_c) + " fit_late=" + to_string(late_c) + " gain=" + to_string(gain_control))
    println("  gain_learn - gain_control = " + to_string(gld))
    println("  gate: gain_learn>0.0 AND (gain_learn-gain_control)>0.02")
    println("  GAIN pass: " + to_string(gain_pass))
    println("")
    println("--- F-CLM-PLAST-DIALOGUE-LOOP (H_846 transition intact after edge-learn) ---")
    println("  score=0.05 thr=" + to_string(p0) + " n_spikes=" + to_string(n_spikes(wfin,p0)) + " should_interrupt=" + to_string(s0) + " expected=False match=" + to_string(m0))
    println("  score=0.50 thr=" + to_string(p1) + " n_spikes=" + to_string(n_spikes(wfin,p1)) + " should_interrupt=" + to_string(s1) + " expected=False match=" + to_string(m1))
    println("  score=0.60 thr=" + to_string(p2) + " n_spikes=" + to_string(n_spikes(wfin,p2)) + " should_interrupt=" + to_string(s2) + " expected=True  match=" + to_string(m2))
    println("  score=0.95 thr=" + to_string(p3) + " n_spikes=" + to_string(n_spikes(wfin,p3)) + " should_interrupt=" + to_string(s3) + " expected=True  match=" + to_string(m3))
    println("  gate: 4/4 should_interrupt == expected_846 AFTER edge-learn")
    println("  LOOP pass: " + to_string(loop_pass))
    println("")
    println("VERDICT: " + verdict)
}
