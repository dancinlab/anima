// ════════════════════════════════════════════════════════════════════════
// TIME/time_lib_smoke.hexa — circadian + ultradian invariant smoke (M1 2026-05-28)
//
// 정체: time_lib.hexa PURE wrapper 의 stage envelope · circadian dip ·
//      drift detector · binding window · dip detection primitives 를
//      invariant 검증. bench/axis_time/bench.hexa (PR #1145) 의 round-trip
//      시그널 보존.
//
// Invariants (10):
//   I1: tm_sqrt_f(4.0) ≈ 2.0       (±1e-6)
//   I2: tm_abs_f(-3.0) == 3.0      (boundary)
//   I3: tm_stage_of_within(0)  == 0 (WAKE start)
//   I4: tm_stage_of_within(60) == 1 (N1 boundary)
//   I5: tm_stage_of_within(87) == 4 (REM boundary)
//   I6: tm_canonical_start(2)  == 70 (N2 canonical)
//   I7: tm_stage_mod(0) == 1.0 && tm_stage_mod(3) == 0.05  (envelope monotone)
//   I8: tm_circadian_mod(8, 2)  == 0.5  &&
//       tm_circadian_mod(0, 2)  == 1.0   (dip at cycle-8, edge clean)
//   I9: tm_phi_scale_abs(0, 0)  == 1.0
//       && tm_phi_scale_abs(0, 0) > tm_phi_scale_abs(80, 0)   (WAKE > N3)
//   I10: tm_observed_wake_n1_boundary(0, 0) == 60  (canonical WAKE→N1 at min 60)
//   I11: tm_circadian_phase(0, 1440) == 0.0
//        && tm_abs_f(tm_circadian_phase(720, 1440) - 0.5) < 1e-9   (mid-day)
//   I12: tm_dip_detected([1.0, 1.0, 0.5, 1.0], 0.7) == true
//        && tm_dip_detected([1.0, 0.9, 0.8], 0.5) == false
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/TIME/time_lib"

fn abs_f_local(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() {
    println("=== TIME/time_lib_smoke ===")

    let sqrt4   = tm_sqrt_f(4.0)
    let abs_neg = tm_abs_f(0.0 - 3.0)

    let s_wake  = tm_stage_of_within(0)
    let s_n1    = tm_stage_of_within(60)
    let s_rem   = tm_stage_of_within(87)
    let cs_n2   = tm_canonical_start(2)
    let sm_wake = tm_stage_mod(0)
    let sm_n3   = tm_stage_mod(3)
    let cm_8    = tm_circadian_mod(8, 2)
    let cm_0    = tm_circadian_mod(0, 2)
    let phi_wake_min0 = tm_phi_scale_abs(0,  0)
    let phi_n3_min80  = tm_phi_scale_abs(80, 0)
    let boundary_c0   = tm_observed_wake_n1_boundary(0, 0)
    let phase_t0    = tm_circadian_phase(0,   1440)
    let phase_mid   = tm_circadian_phase(720, 1440)
    let dip_yes = tm_dip_detected([1.0, 1.0, 0.5, 1.0], 0.7)
    let dip_no  = tm_dip_detected([1.0, 0.9, 0.8],      0.5)

    let i1  = abs_f_local(sqrt4 - 2.0) < 1.0e-6
    let i2  = abs_neg == 3.0
    let i3  = s_wake == 0
    let i4  = s_n1   == 1
    let i5  = s_rem  == 4
    let i6  = cs_n2  == 70
    let i7  = sm_wake == 1.0 && sm_n3 == 0.05
    let i8  = abs_f_local(cm_8 - 0.5) < 1.0e-9 && abs_f_local(cm_0 - 1.0) < 1.0e-9
    let i9  = phi_wake_min0 == 1.0 && phi_wake_min0 > phi_n3_min80
    let i10 = boundary_c0 == 60
    let i11 = phase_t0 == 0.0 && abs_f_local(phase_mid - 0.5) < 1.0e-9
    let i12 = dip_yes == true && dip_no == false

    println("I1  sqrt(4)≈2.0          " + (if i1  { "PASS (" + str(sqrt4) + ")" } else { "FAIL" }))
    println("I2  abs(-3)==3           " + (if i2  { "PASS"                       } else { "FAIL" }))
    println("I3  stage_of_within(0)=0 " + (if i3  { "PASS"                       } else { "FAIL" }))
    println("I4  stage_of_within(60)=1" + (if i4  { "PASS"                       } else { "FAIL" }))
    println("I5  stage_of_within(87)=4" + (if i5  { "PASS"                       } else { "FAIL" }))
    println("I6  canonical_start(2)=70" + (if i6  { "PASS"                       } else { "FAIL" }))
    println("I7  stage_mod WAKE/N3    " + (if i7  { "PASS"                       } else { "FAIL" }))
    println("I8  circadian_mod dip    " + (if i8  { "PASS"                       } else { "FAIL" }))
    println("I9  phi_scale WAKE>N3    " + (if i9  { "PASS"                       } else { "FAIL" }))
    println("I10 obs_wake_n1=60       " + (if i10 { "PASS"                       } else { "FAIL" }))
    println("I11 phase(720/1440)=0.5  " + (if i11 { "PASS"                       } else { "FAIL" }))
    println("I12 dip_detected         " + (if i12 { "PASS"                       } else { "FAIL" }))

    let all_ok = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8 && i9 && i10 && i11 && i12
    if all_ok {
        println("=== ALL 12 invariants PASS ===")
    } else {
        println("=== smoke FAIL ===")
        panic("TIME/time_lib_smoke failed")
    }
}
