// AXISBENCH C — NARRATIVE — REDESIGN (A1 modeling-gap fix)
// ═════════════════════════════════════════════════════════════════════
// Root-cause of the original 🔴 2/5 FAIL (F2/F4/F5):
//   COLLISION-SATURATION MODELING GAP.
//   The original reuse_rate asks "does token t appear ANYWHERE in the
//   prior WINDOW=10 turns (= 50 prior tokens)?". With VOCAB=64, a 50-token
//   prior pool covers a large fraction of the vocabulary, so even a
//   PURE-RANDOM (fragmented) token has P(present) = 1-(63/64)^50 = 0.545.
//   Confirmed by diag_probe.hexa (closed-form 0.545 ≈ observed 0.509).
//   Consequences:
//     F2 FRAGMENTED_LOW   FAIL — fragmented saturates to ~0.51, not <0.30.
//     F4 ORDERING         FAIL — drift saturates ABOVE coherent (0.92>0.86).
//     F5 COHERENT_STABLE  FAIL — binary 5-token quantization {0,.2,..,1}
//                                bounces ≥0.3 often (12 jumps).
//   The metric measured VOCAB COVERAGE, not NARRATIVE THREAD COHERENCE.
//
// REDESIGN — chance-corrected, non-saturating coherence metric:
//   (1) IMMEDIATE-PRIOR overlap (window = 1 prior turn, NOT 10):
//         raw[t] = |tokens(t) ∩ tokens(t-1)| / TOKENS_PER
//       compares against only TOKENS_PER prior tokens → no saturation.
//   (2) CHANCE CORRECTION: subtract the random-baseline expectation
//         e_chance = 1-((VOCAB-1)/VOCAB)^TOKENS_PER   (expected overlap
//         of two random 5-token turns) and renormalize to [0,1]:
//         coh[t] = max(0, (raw[t] - e_chance) / (1 - e_chance))
//       so a TRULY random thread scores ≈ 0 (kills the saturation floor).
//   (3) NARRATIVE-THREAD signal = mean coh[t].
//
// Generators preserved EXACTLY from bench.hexa (same scenarios, same LCG
// origins) so the comparison is apples-to-apples; ONLY the measurement
// (window + chance-correction) is redesigned.
//
// Redesigned falsifiers (5) — same intent, saturation-free thresholds:
//   F1 COHERENT_HIGH   : coh_coherent   > 0.50   (strong self-reference)
//   F2 FRAGMENTED_LOW  : coh_fragmented < 0.15   (chance-corrected ≈ 0)
//   F3 DRIFT_MID       : coh_fragmented < coh_drift < coh_coherent
//                        (drift is INTERMEDIATE — local overlap, no long thread)
//   F4 ORDERING        : coh_coherent > coh_drift > coh_fragmented
//   F5 SEPARATION      : (coh_coherent - coh_fragmented) > 0.30
//                        (the three classes are separable, not collapsed)
//
// Verdict: FAIL==0 → 🟢 PASS (5/5). F1∧F2∧F4 → 🟢 core. F1|F2 broken → 🔴.
// Style: globals + LCG (libm-free, byte-identical, $0 mac-local).
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn chk(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn maxf(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn pow_loop(base: float, n: int) -> float {
    let mut r = 1.0
    let mut k = 0
    while k < n { r = r * base; k = k + 1 }
    return r
}

// ─────────────────────────────────────────────────────────────────────
// LCG deterministic pseudo-random (libm-free) — IDENTICAL to bench.hexa
// ─────────────────────────────────────────────────────────────────────
fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

fn lcg_walk(origin: int, n: int) -> int {
    let mut s = origin
    let mut k = 0
    while k < n { s = lcg_step(s); k = k + 1 }
    return s
}

fn int_from(state: int, modulus: int) -> int {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    return r % modulus
}

fn u01_from(state: int) -> float {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    let bucket = r % 1048576
    return (bucket as float) / 1048576.0
}

// ─────────────────────────────────────────────────────────────────────
// CONSTANTS — generators identical to bench.hexa
// ─────────────────────────────────────────────────────────────────────
comptime const N_TURNS    = 100
comptime const TOKENS_PER = 5
comptime const VOCAB      = 64
comptime const PRIOR_LOOK = 5
comptime const REUSE_PROB = 0.80
comptime const DRIFT_RATE = 0.3
comptime const DRIFT_WIN  = 10

comptime const ORIGIN_COH  = 1100003
comptime const ORIGIN_DRI  = 2200007
comptime const ORIGIN_FRA  = 3300013
comptime const ORIGIN_PICK = 4400017

let mut HISTORY = []
let mut COH_TRAJ = []

fn clear_history() {
    HISTORY = []
    let mut k = 0
    while k < N_TURNS * TOKENS_PER { HISTORY.push(0); k = k + 1 }
}

fn hist_set(t: int, i: int, tok: int) { HISTORY[t * TOKENS_PER + i] = tok }
fn hist_get(t: int, i: int) -> int { return HISTORY[t * TOKENS_PER + i] }

// ── SCENARIO A — COHERENT (identical to bench.hexa) ──────────────────
fn gen_coherent() {
    clear_history()
    let mut s_tok  = lcg_walk(ORIGIN_COH,  3)
    let mut s_pick = lcg_walk(ORIGIN_PICK, 3)
    let mut s_prob = lcg_walk(ORIGIN_COH + 7, 3)
    let mut t = 0
    while t < N_TURNS {
        let mut i = 0
        while i < TOKENS_PER {
            s_tok  = lcg_step(s_tok)
            s_pick = lcg_step(s_pick)
            s_prob = lcg_step(s_prob)
            let mut tok = int_from(s_tok, VOCAB)
            if t >= PRIOR_LOOK {
                let p = u01_from(s_prob)
                if p < REUSE_PROB {
                    let pool_size = PRIOR_LOOK * TOKENS_PER
                    let pick = int_from(s_pick, pool_size)
                    let src_turn = t - PRIOR_LOOK + (pick / TOKENS_PER)
                    let src_pos  = pick % TOKENS_PER
                    tok = hist_get(src_turn, src_pos)
                }
            }
            hist_set(t, i, tok)
            i = i + 1
        }
        t = t + 1
    }
}

// ── SCENARIO B — DRIFT (identical to bench.hexa) ─────────────────────
fn gen_drift() {
    clear_history()
    let mut s_tok = lcg_walk(ORIGIN_DRI, 3)
    let mut t = 0
    while t < N_TURNS {
        let base = (t * 3) / 10
        let mut i = 0
        while i < TOKENS_PER {
            s_tok = lcg_step(s_tok)
            let offset = int_from(s_tok, DRIFT_WIN)
            let tok = (base + offset) % VOCAB
            hist_set(t, i, tok)
            i = i + 1
        }
        t = t + 1
    }
}

// ── SCENARIO C — FRAGMENTED (identical to bench.hexa) ────────────────
fn gen_fragmented() {
    clear_history()
    let mut s_tok = lcg_walk(ORIGIN_FRA, 3)
    let mut t = 0
    while t < N_TURNS {
        let mut i = 0
        while i < TOKENS_PER {
            s_tok = lcg_step(s_tok)
            let tok = int_from(s_tok, VOCAB)
            hist_set(t, i, tok)
            i = i + 1
        }
        t = t + 1
    }
}

// ─────────────────────────────────────────────────────────────────────
// REDESIGNED MEASUREMENT
//   raw[t]  = |tokens(t) ∩ tokens(t-1)| / TOKENS_PER  (immediate prior)
//   coh[t]  = max(0, (raw[t] - e_chance) / (1 - e_chance))
// where e_chance = expected overlap of two independent random turns
//   = 1 - ((VOCAB-1)/VOCAB)^TOKENS_PER  (per-token P that it is matched
//     by at least one of TOKENS_PER prior random tokens; mean over 5).
// ─────────────────────────────────────────────────────────────────────
fn token_in_turn(tok: int, t: int) -> bool {
    let mut i = 0
    while i < TOKENS_PER {
        if hist_get(t, i) == tok { return true }
        i = i + 1
    }
    return false
}

fn chance_overlap() -> float {
    // expected fraction of a turn's TOKENS_PER tokens that collide with
    // any of TOKENS_PER independent random prior tokens
    return 1.0 - pow_loop((VOCAB - 1) as float / (VOCAB as float), TOKENS_PER)
}

fn compute_coherence() {
    COH_TRAJ = []
    let mut t = 0
    while t < N_TURNS { COH_TRAJ.push(0.0); t = t + 1 }
    let e_chance = chance_overlap()
    t = 1
    while t < N_TURNS {
        let mut hits = 0
        let mut i = 0
        while i < TOKENS_PER {
            let tok = hist_get(t, i)
            if token_in_turn(tok, t - 1) { hits = hits + 1 }
            i = i + 1
        }
        let raw = (hits as float) / (TOKENS_PER as float)
        let coh = maxf(0.0, (raw - e_chance) / (1.0 - e_chance))
        COH_TRAJ[t] = coh
        t = t + 1
    }
}

fn mean_coh() -> float {
    let mut sum = 0.0
    let mut n = 0
    let mut t = 1
    while t < N_TURNS {
        sum = sum + COH_TRAJ[t]
        n = n + 1
        t = t + 1
    }
    if n == 0 { return 0.0 }
    return sum / (n as float)
}

fn main() {
    println("═══════════════════════════════════════════════════════════")
    println("  AXISBENCH C  —  NARRATIVE  (REDESIGN — A1 modeling-gap fix)")
    println("  chance-corrected immediate-prior coherence")
    println("  N_TURNS=" + N_TURNS.to_string() +
            "  TOKENS_PER=" + TOKENS_PER.to_string() +
            "  VOCAB=" + VOCAB.to_string())
    let e_chance = chance_overlap()
    println("  e_chance (random baseline overlap) = " + e_chance.to_string())
    println("═══════════════════════════════════════════════════════════")

    gen_coherent()
    compute_coherence()
    let coh_c = mean_coh()
    println("")
    println("[A] COHERENT   mean_coh = " + coh_c.to_string())

    gen_drift()
    compute_coherence()
    let coh_d = mean_coh()
    println("[B] DRIFT      mean_coh = " + coh_d.to_string())

    gen_fragmented()
    compute_coherence()
    let coh_f = mean_coh()
    println("[C] FRAGMENTED mean_coh = " + coh_f.to_string())

    println("")
    println("─── redesigned falsifier matrix ───")
    chk("F1 COHERENT_HIGH   (coh_coherent  > 0.50)", coh_c > 0.50)
    chk("F2 FRAGMENTED_LOW  (coh_fragmented < 0.15)", coh_f < 0.15)
    chk("F3 DRIFT_MID       (frag < drift < coherent)",
          coh_f < coh_d && coh_d < coh_c)
    chk("F4 ORDERING        (coherent > drift > fragmented)",
          coh_c > coh_d && coh_d > coh_f)
    chk("F5 SEPARATION      (coh_coherent - coh_fragmented > 0.30)",
          (coh_c - coh_f) > 0.30)

    println("")
    println("═══════════════════════════════════════════════════════════")
    println("  PASS = " + PASS.to_string() + "  /  FAIL = " + FAIL.to_string())

    let core = (coh_c > 0.50) && (coh_f < 0.15) && (coh_c > coh_d) && (coh_d > coh_f)
    let core_break = (coh_c <= 0.50) || (coh_f >= 0.15)
    let mut verdict = "UNKNOWN"
    if FAIL == 0 {
        verdict = "🟢 PASS — narrative thread discriminable (5/5 strict)"
    } else if core {
        verdict = "🟢 PASS — narrative thread discriminable (core PASS)"
    } else if core_break {
        verdict = "🔴 FAIL — substrate cannot form narrative thread"
    } else {
        verdict = "🟠 PARTIAL — core PASS, edge falsifier soft"
    }
    println("  VERDICT  =  " + verdict)
    println("═══════════════════════════════════════════════════════════")

    println("")
    println("JSON_BEGIN")
    println("{")
    println("  \"bench\": \"AXISBENCH C NARRATIVE REDESIGN\",")
    println("  \"metric\": \"chance-corrected immediate-prior coherence\",")
    println("  \"e_chance\": " + e_chance.to_string() + ",")
    println("  \"scenarios\": {")
    println("    \"coherent\":   { \"mean_coh\": " + coh_c.to_string() + " },")
    println("    \"drift\":      { \"mean_coh\": " + coh_d.to_string() + " },")
    println("    \"fragmented\": { \"mean_coh\": " + coh_f.to_string() + " }")
    println("  },")
    println("  \"falsifiers\": { \"PASS\": " + PASS.to_string() +
            ", \"FAIL\": " + FAIL.to_string() + " },")
    println("  \"verdict\": \"" + verdict + "\"")
    println("}")
    println("JSON_END")
}
