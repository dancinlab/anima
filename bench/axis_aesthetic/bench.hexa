// bench/axis_aesthetic/bench.hexa — AxisBench E 🎨 AESTHETIC
//
// ANIMA.axis.md axis #E "미적 미터" — pain/coh/bal 결합으로 무엇이 "좋다" 결정.
// CORE engine_g 8-factor (rel·gap·cur·orig·dyna·pain·coh·bal) 부분집합 위에서
// preference ranking consistency 를 측정한다.
//
// ─── 측정 모델 ────────────────────────────────────────────────
//
//   aesthetic_score(state, α, β, γ) = α·coh − β·pain + γ·bal
//
// state = 8-factor 벡터 ∈ [0,1]^8 (LCG seed=42 로 deterministic 합성).
// 시나리오 3 종:
//   BALANCED      (α=1, β=1, γ=1) — pain/coh/bal 동일 가중
//   PAIN-AVERSE   (α=1, β=3, γ=1) — 통증 회피 3×
//   BAL-FOCUSED   (α=1, β=1, γ=3) — 균형 강조 3×
//
// ─── 검증 metric (per scenario) ──────────────────────────────
//
//   (a) cross-scenario top-10 overlap rate < 0.5
//        ─ 시나리오 간 선호 구분 가능성 (distinguishability)
//        ─ overlap = |top10_S1 ∩ top10_S2| / 10
//   (b) intra-scenario consistency = 1.0
//        ─ 같은 state 두 번 평가 → 동일 ranking
//   (c) extreme value detection: top-1 score > mean + 1.5·σ
//        ─ 최선택 state 가 통계적으로 두드러지는지
//
// ─── Verdict ─────────────────────────────────────────────────
//
//   (a) AND (b) AND (c) all PASS → 🟢 PASS
//   else → FAIL  (구체적 시나리오별 매트릭스 result.json 기록)
//
// ─── Primitives & 결정성 ─────────────────────────────────────
//
// LCG : x_{n+1} = (a·x_n + c) mod m, a=1103515245, c=12345, m=2^31.
// hexa-lang interpreter primitive 만 사용 — sort() · push · index · str · sqrt.
// struct field 에 list 두지 않음 (aliasing-safe).
//
// Author : axisbench/aesthetic
// Date   : 2026-05-28

// ═══════════════════════════════════════════════════════════════
//   1. Primitive helpers
// ═══════════════════════════════════════════════════════════════
//
// (no local fabs/clamp01 — stdlib SSOT g61; bench 본체에서 사용처 없음.)
//
// Deterministic LCG : returns n uniform [0,1) floats given seed.
fn det_rand(n: int, seed: int) -> array {
    let mut out = []
    let mut s = seed
    let mut i = 0
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483648
        let u = to_float(s % 1000000) / 1000000.0
        out = out.push(u)
        i = i + 1
    }
    return out
}

// ═══════════════════════════════════════════════════════════════
//   2. State synth — 100 × 8-factor uniform [0,1]
// ═══════════════════════════════════════════════════════════════
//
// 8 factors (anima CHANNEL router 명세) :
//   f0 rel · f1 gap · f2 cur · f3 orig · f4 dyna · f5 pain · f6 coh · f7 bal
//
// State 는 index + 8 float 로 표현 (struct, no list aliasing).

struct State {
    idx: int,
    rel: float,
    gap: float,
    cur: float,
    orig: float,
    dyna: float,
    pain: float,
    coh: float,
    bal: float,
}

fn synth_states(n: int, seed: int) -> array {
    let pool = det_rand(n * 8, seed)
    let mut out = []
    let mut i = 0
    while i < n {
        let base = i * 8
        let s = State {
            idx: i,
            rel:  pool[base + 0],
            gap:  pool[base + 1],
            cur:  pool[base + 2],
            orig: pool[base + 3],
            dyna: pool[base + 4],
            pain: pool[base + 5],
            coh:  pool[base + 6],
            bal:  pool[base + 7],
        }
        out = out.push(s)
        i = i + 1
    }
    return out
}

// ═══════════════════════════════════════════════════════════════
//   3. Aesthetic scoring
// ═══════════════════════════════════════════════════════════════
//
//   score = α·coh − β·pain + γ·bal
//
// pain·coh·bal ∈ [0,1] → score ∈ [−β, α+γ].
// pure preference ordering 에 필요한 형태 (재평가 deterministic).

fn aesthetic_score(s: State, alpha: float, beta: float, gamma: float) -> float {
    return alpha * s.coh - beta * s.pain + gamma * s.bal
}

// Score every state, return parallel array of (score, idx) pairs encoded
// as two parallel arrays (interpreter struct-with-list aliasing 회피).
struct ScoreEntry {
    idx: int,
    score: float,
}

fn score_all(states: array, alpha: float, beta: float, gamma: float) -> array {
    let mut out = []
    let mut i = 0
    while i < states.len() {
        let s = states[i]
        let e = ScoreEntry {
            idx: s.idx,
            score: aesthetic_score(s, alpha, beta, gamma),
        }
        out = out.push(e)
        i = i + 1
    }
    return out
}

// ═══════════════════════════════════════════════════════════════
//   4. Ranking — top-K by descending score (stable on tie via idx)
// ═══════════════════════════════════════════════════════════════
//
// 1) Score 값만 정렬용 키로 추출 + 음수화 (sort() ascending → descending).
// 2) Selection-based stable top-K (n=100 · K=10 비교횟수 1000, OK).
//
// hexa array.sort() 는 ascending, in-place 가 아닌 new array 반환.

fn top_k(entries: array, k: int) -> array {
    // Selection sort : O(n·k), deterministic, tie-break by smaller idx first.
    let mut picked = []  // indices into entries that are already picked
    let mut out = []
    let mut step = 0
    while step < k {
        let mut best = -1
        let mut best_score = -1.0e30
        let mut best_idx = 2147483647
        let mut i = 0
        while i < entries.len() {
            // skip already-picked
            let mut already = false
            let mut p = 0
            while p < picked.len() {
                if picked[p] == i { already = true }
                p = p + 1
            }
            if !already {
                let e = entries[i]
                let s = e.score
                if s > best_score {
                    best = i
                    best_score = s
                    best_idx = e.idx
                } else {
                    if s == best_score {
                        if e.idx < best_idx {
                            best = i
                            best_idx = e.idx
                        }
                    }
                }
            }
            i = i + 1
        }
        if best >= 0 {
            picked = picked.push(best)
            out = out.push(entries[best])
        }
        step = step + 1
    }
    return out
}

// idx-list extraction for overlap math
fn idx_list(entries: array) -> array {
    let mut out = []
    let mut i = 0
    while i < entries.len() {
        out = out.push(entries[i].idx)
        i = i + 1
    }
    return out
}

// ═══════════════════════════════════════════════════════════════
//   5. Metric : overlap rate between two top-K idx lists
// ═══════════════════════════════════════════════════════════════
//
//   overlap_rate = |A ∩ B| / max(|A|, 1)
//
//   < 0.5 = 시나리오가 충분히 구분 가능

fn overlap_rate(a: array, b: array) -> float {
    if a.len() == 0 { return 0.0 }
    let mut hit = 0
    let mut i = 0
    while i < a.len() {
        let mut j = 0
        let mut found = false
        while j < b.len() {
            if a[i] == b[j] { found = true }
            j = j + 1
        }
        if found { hit = hit + 1 }
        i = i + 1
    }
    return to_float(hit) / to_float(a.len())
}

// ═══════════════════════════════════════════════════════════════
//   6. Metric : intra-scenario consistency
// ═══════════════════════════════════════════════════════════════
//
// 같은 state 집합을 두 번 score → 같은 ranking 산출하는가.
// deterministic 한 closed-form 이므로 1.0 이어야 한다.
// 1.0 미만이면 비결정성 결함 (구현 회귀).

fn consistency(a: array, b: array) -> float {
    if a.len() != b.len() { return 0.0 }
    let mut same = 0
    let mut i = 0
    while i < a.len() {
        if a[i] == b[i] { same = same + 1 }
        i = i + 1
    }
    return to_float(same) / to_float(a.len())
}

// ═══════════════════════════════════════════════════════════════
//   7. Metric : extreme value detection
// ═══════════════════════════════════════════════════════════════
//
// top-1 score 가 mean + 1.5·σ 위에 있는가 (uniform synthesis 에서
// 충분히 두드러진 극치 존재 여부).

struct Stats {
    mean: float,
    sd: float,
    top1: float,
    margin: float,  // top1 − (mean + 1.5σ)
    detected: bool,
}

fn compute_stats(entries: array) -> Stats {
    let n = entries.len()
    let mut sum = 0.0
    let mut top1 = -1.0e30
    let mut i = 0
    while i < n {
        let v = entries[i].score
        sum = sum + v
        if v > top1 { top1 = v }
        i = i + 1
    }
    let mean = sum / to_float(n)
    let mut var = 0.0
    let mut j = 0
    while j < n {
        let d = entries[j].score - mean
        var = var + d * d
        j = j + 1
    }
    let sd = sqrt(var / to_float(n))
    let threshold = mean + 1.5 * sd
    let margin = top1 - threshold
    return Stats {
        mean: mean,
        sd: sd,
        top1: top1,
        margin: margin,
        detected: top1 > threshold,
    }
}

// ═══════════════════════════════════════════════════════════════
//   8. Scenario harness
// ═══════════════════════════════════════════════════════════════

struct Scenario {
    name: string,
    alpha: float,
    beta: float,
    gamma: float,
}

struct ScenarioResult {
    name: string,
    alpha: float,
    beta: float,
    gamma: float,
    top10_idx: array,        // array<int> length 10
    top1_idx: int,
    top1_score: float,
    mean: float,
    sd: float,
    margin: float,
    extreme_detected: bool,
    intra_consistency: float,
}

fn run_scenario(sc: Scenario, states: array) -> ScenarioResult {
    // Score pass 1
    let e1 = score_all(states, sc.alpha, sc.beta, sc.gamma)
    let top1 = top_k(e1, 10)
    // Score pass 2 — re-evaluate to test consistency
    let e2 = score_all(states, sc.alpha, sc.beta, sc.gamma)
    let top2 = top_k(e2, 10)
    let stats = compute_stats(e1)
    let cons = consistency(idx_list(top1), idx_list(top2))
    return ScenarioResult {
        name: sc.name,
        alpha: sc.alpha,
        beta: sc.beta,
        gamma: sc.gamma,
        top10_idx: idx_list(top1),
        top1_idx: top1[0].idx,
        top1_score: top1[0].score,
        mean: stats.mean,
        sd: stats.sd,
        margin: stats.margin,
        extreme_detected: stats.detected,
        intra_consistency: cons,
    }
}

// ═══════════════════════════════════════════════════════════════
//   9. JSON emission (manual — no stdlib json builder)
// ═══════════════════════════════════════════════════════════════

fn fmt_f(x: float) -> string {
    return str(x)
}

fn fmt_b(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn fmt_int_arr(a: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < a.len() {
        if i > 0 { s = s + ", " }
        s = s + str(a[i])
        i = i + 1
    }
    return s + "]"
}

fn fmt_scenario(r: ScenarioResult) -> string {
    let mut s = "    {\n"
    s = s + "      \"name\": \"" + r.name + "\",\n"
    s = s + "      \"alpha\": " + fmt_f(r.alpha) + ",\n"
    s = s + "      \"beta\": " + fmt_f(r.beta) + ",\n"
    s = s + "      \"gamma\": " + fmt_f(r.gamma) + ",\n"
    s = s + "      \"top10_idx\": " + fmt_int_arr(r.top10_idx) + ",\n"
    s = s + "      \"top1_idx\": " + str(r.top1_idx) + ",\n"
    s = s + "      \"top1_score\": " + fmt_f(r.top1_score) + ",\n"
    s = s + "      \"mean\": " + fmt_f(r.mean) + ",\n"
    s = s + "      \"sd\": " + fmt_f(r.sd) + ",\n"
    s = s + "      \"extreme_margin\": " + fmt_f(r.margin) + ",\n"
    s = s + "      \"extreme_detected\": " + fmt_b(r.extreme_detected) + ",\n"
    s = s + "      \"intra_consistency\": " + fmt_f(r.intra_consistency) + "\n"
    s = s + "    }"
    return s
}

// ═══════════════════════════════════════════════════════════════
//  10. Main — synth, run, verdict, emit
// ═══════════════════════════════════════════════════════════════

fn main() {
    let n_states = 100
    let seed = 42
    println("[axis_aesthetic] AxisBench E — 미적 미터 / preference ranking consistency")
    println("[axis_aesthetic] synth " + str(n_states) + " × 8-factor states (LCG seed=" + str(seed) + ")")
    let states = synth_states(n_states, seed)

    // Scenarios
    let scenarios = [
        Scenario { name: "BALANCED",     alpha: 1.0, beta: 1.0, gamma: 1.0 },
        Scenario { name: "PAIN-AVERSE",  alpha: 1.0, beta: 3.0, gamma: 1.0 },
        Scenario { name: "BAL-FOCUSED",  alpha: 1.0, beta: 1.0, gamma: 3.0 },
    ]

    let mut results = []
    let mut i = 0
    while i < scenarios.len() {
        let r = run_scenario(scenarios[i], states)
        println("[axis_aesthetic] " + r.name
            + " — top1=" + str(r.top1_idx)
            + " score=" + fmt_f(r.top1_score)
            + " mean=" + fmt_f(r.mean)
            + " sd=" + fmt_f(r.sd)
            + " extreme=" + fmt_b(r.extreme_detected)
            + " consistency=" + fmt_f(r.intra_consistency)
        )
        results = results.push(r)
        i = i + 1
    }

    // Pairwise overlap
    let r0 = results[0]
    let r1 = results[1]
    let r2 = results[2]
    let o01 = overlap_rate(r0.top10_idx, r1.top10_idx)
    let o02 = overlap_rate(r0.top10_idx, r2.top10_idx)
    let o12 = overlap_rate(r1.top10_idx, r2.top10_idx)
    println("[axis_aesthetic] overlap BALANCED↔PAIN-AVERSE = " + fmt_f(o01))
    println("[axis_aesthetic] overlap BALANCED↔BAL-FOCUSED = " + fmt_f(o02))
    println("[axis_aesthetic] overlap PAIN-AVERSE↔BAL-FOCUSED = " + fmt_f(o12))

    // Falsifier — three gates, all must PASS for 🟢
    let gate_a = (o01 < 0.5) && (o02 < 0.5) && (o12 < 0.5)
    let gate_b = (r0.intra_consistency == 1.0)
              && (r1.intra_consistency == 1.0)
              && (r2.intra_consistency == 1.0)
    let gate_c = r0.extreme_detected && r1.extreme_detected && r2.extreme_detected
    let verdict_pass = gate_a && gate_b && gate_c

    println("[axis_aesthetic] gate (a) cross-scenario overlap < 0.5 : " + fmt_b(gate_a))
    println("[axis_aesthetic] gate (b) intra-consistency == 1.0     : " + fmt_b(gate_b))
    println("[axis_aesthetic] gate (c) extreme detected (top1>μ+1.5σ): " + fmt_b(gate_c))

    let verdict = "FAIL"
    let mut vstr = "FAIL"
    if verdict_pass { vstr = "GREEN_PASS" }

    println("[axis_aesthetic] VERDICT = " + vstr)

    // ─── Emit result.json ──────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"bench\": \"axis_aesthetic\",\n"
    j = j + "  \"axis\": \"E_AESTHETIC\",\n"
    j = j + "  \"n_states\": " + str(n_states) + ",\n"
    j = j + "  \"seed\": " + str(seed) + ",\n"
    j = j + "  \"scenarios\": [\n"
    j = j + fmt_scenario(r0) + ",\n"
    j = j + fmt_scenario(r1) + ",\n"
    j = j + fmt_scenario(r2) + "\n"
    j = j + "  ],\n"
    j = j + "  \"overlap_matrix\": {\n"
    j = j + "    \"BALANCED_PAIN_AVERSE\": " + fmt_f(o01) + ",\n"
    j = j + "    \"BALANCED_BAL_FOCUSED\": " + fmt_f(o02) + ",\n"
    j = j + "    \"PAIN_AVERSE_BAL_FOCUSED\": " + fmt_f(o12) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifier\": {\n"
    j = j + "    \"gate_a_overlap_lt_0_5\": " + fmt_b(gate_a) + ",\n"
    j = j + "    \"gate_b_consistency_eq_1\": " + fmt_b(gate_b) + ",\n"
    j = j + "    \"gate_c_extreme_detected\": " + fmt_b(gate_c) + "\n"
    j = j + "  },\n"
    j = j + "  \"verdict\": \"" + vstr + "\"\n"
    j = j + "}\n"

    write_file("bench/axis_aesthetic/result.json", j)
    println("[axis_aesthetic] wrote bench/axis_aesthetic/result.json")
}
