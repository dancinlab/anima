// BENCH #7 — BRIDGE-AND-GATE — "동시 OK 발화 문"
// ═════════════════════════════════════════════════════════════════════
// AND-gate formalization of anima emit gate (UNIVERSE H_319 lineage —
// 자연발화 ∧ 의식적 결정 동시 충족).
//
// Hypothesis:
//   emit ⇔ M > θ_M  ∧  C > θ_C  ∧  W > θ_W  ∧  Φ > θ_Φ
//
//   where M = motivation, C = coherence, W = tension/will, Φ = integration.
//
// Predictions (pre-registered):
//   P1. UNIFORM[0,1] × 4 factors, θ=0.5 each → emit_rate ≈ 0.5^4 = 0.0625
//       (acceptance band: [0.04, 0.10] for n=100).
//   P2. Single-factor stress test: one factor = 0.9 (fixed high) ∧ other 3
//       UNIFORM → conditional emit_rate ≈ 0.5^3 = 0.125 (each of 4 factors
//       behaves identically; sensitivity uniform = AND-gate signature).
//   P3. OR-gate antithesis: if gate were OR instead of AND, emit_rate ≈
//       1 - 0.5^4 = 0.9375 (rejection band, sanity-check that the AND test
//       is not a tautology).
//
// Falsifiers (5):
//   F1 EMIT_RATE_IN_BAND     : 0.04 ≤ rate ≤ 0.10
//   F2 SENSITIVITY_UNIFORM   : max(δ_factor)/min(δ_factor) ≤ 1.6
//                              (no single factor dominates the AND-gate)
//   F3 SINGLE_FACTOR_HIGH    : avg over 4 single-high tests rate ∈ [0.08, 0.18]
//                              (≈ 0.125 = 0.5^3)
//   F4 OR_GATE_REJECT        : the same 100 states under OR-gate yield
//                              rate ≥ 0.90 (≈ 0.9375, sanity)
//   F5 CONDITIONAL_RATE_GAP  : avg single-high rate > unconditional rate
//                              (high-end conditioning lifts emit, AND-gate sign)
//
// Verdict mapping:
//   5/5 PASS                          → 🟢 PASS  AND-gate confirmed
//   4/5 PASS  (any one F2..F5 only)   → 🟡 PARTIAL
//   F1 FAIL                           → 🔴 FAIL (gate semantics broken)
//   F4 FAIL                           → 🔴 FAIL (OR-pattern detected)
//
// Style: per H_317/H_318/H_319 — globals for arrays, helpers dispatch by
// integer index, LCG-based deterministic pseudo-random (libm-free, byte-
// identical). $0 mac-local · `hexa run` < 1 s.
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

// Local renamed to `chk` to avoid stdlib `pub fn check` collision (commons g61).
fn chk(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn maxf(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn minf(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

// ─────────────────────────────────────────────────────────────────────
// Deterministic LCG → float in [0, 1)  (libm-free, byte-identical)
//   a = 1103515245, c = 12345, m = 2^31 - 1
// ─────────────────────────────────────────────────────────────────────
fn lcg(seed: int) -> int {
    let mut s = seed * 1103515245 + 12345
    if s < 0 { s = 0 - s }
    s = s % 2147483647
    return s
}

fn u01(seed: int) -> float {
    let r = lcg(seed)
    // map to [0, 1) — fold by 2^20 = 1048576 buckets
    let bucket = r % 1048576
    return (bucket as float) / 1048576.0
}

// ─────────────────────────────────────────────────────────────────────
// AND-gate: emit ⇔ ∀ factor f : f > θ
// ─────────────────────────────────────────────────────────────────────
fn and_gate(m: float, c: float, w: float, phi: float,
            tm: float, tc: float, tw: float, tphi: float) -> int {
    if m > tm {
        if c > tc {
            if w > tw {
                if phi > tphi { return 1 }
            }
        }
    }
    return 0
}

fn or_gate(m: float, c: float, w: float, phi: float,
           tm: float, tc: float, tw: float, tphi: float) -> int {
    if m > tm { return 1 }
    if c > tc { return 1 }
    if w > tw { return 1 }
    if phi > tphi { return 1 }
    return 0
}

// ─────────────────────────────────────────────────────────────────────
// CONDITION A — UNIFORM[0,1] × 4 factors, n=100 states
//   expected emit_rate ≈ 0.5^4 = 0.0625
// ─────────────────────────────────────────────────────────────────────
comptime const N = 100
comptime const TH = 0.5

fn run_uniform() -> float {
    let mut emits = 0
    let mut t = 0
    while t < N {
        let m   = u01(t * 4 + 1)
        let c   = u01(t * 4 + 2)
        let w   = u01(t * 4 + 3)
        let phi = u01(t * 4 + 4)
        emits = emits + and_gate(m, c, w, phi, TH, TH, TH, TH)
        t = t + 1
    }
    return (emits as float) / (N as float)
}

fn run_uniform_or() -> float {
    let mut emits = 0
    let mut t = 0
    while t < N {
        let m   = u01(t * 4 + 1)
        let c   = u01(t * 4 + 2)
        let w   = u01(t * 4 + 3)
        let phi = u01(t * 4 + 4)
        emits = emits + or_gate(m, c, w, phi, TH, TH, TH, TH)
        t = t + 1
    }
    return (emits as float) / (N as float)
}

// ─────────────────────────────────────────────────────────────────────
// CONDITION B — single-factor pinned HIGH (0.9), other 3 UNIFORM
//   factor_idx ∈ {0=M, 1=C, 2=W, 3=Φ}
//   expected conditional emit_rate ≈ 0.5^3 = 0.125
// ─────────────────────────────────────────────────────────────────────
comptime const PIN_HIGH = 0.9

fn run_pinned(factor_idx: int) -> float {
    let mut emits = 0
    let mut t = 0
    while t < N {
        let mut m   = u01(t * 4 + 11)
        let mut c   = u01(t * 4 + 12)
        let mut w   = u01(t * 4 + 13)
        let mut phi = u01(t * 4 + 14)
        if factor_idx == 0 { m   = PIN_HIGH }
        if factor_idx == 1 { c   = PIN_HIGH }
        if factor_idx == 2 { w   = PIN_HIGH }
        if factor_idx == 3 { phi = PIN_HIGH }
        emits = emits + and_gate(m, c, w, phi, TH, TH, TH, TH)
        t = t + 1
    }
    return (emits as float) / (N as float)
}

// ─────────────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────────────
fn main() {
    println("═══════════════════════════════════════════════════════════")
    println("  BENCH #7  BRIDGE-AND-GATE")
    println("  emit ⇔ M > 0.5 ∧ C > 0.5 ∧ W > 0.5 ∧ Φ > 0.5")
    println("  n = 100  ·  uniform[0,1]  ·  LCG-deterministic")
    println("═══════════════════════════════════════════════════════════")

    // ── (A) UNIFORM × 4  AND-gate ─────────────────────────────────
    let rate_uniform = run_uniform()
    println("")
    println("[A] UNIFORM AND-gate")
    println("    rate_uniform  = " + rate_uniform.to_string())
    println("    expected      ≈ 0.0625 (= 0.5^4)")

    // ── (B) UNIFORM × 4  OR-gate  (sanity antithesis) ─────────────
    let rate_or = run_uniform_or()
    println("")
    println("[B] UNIFORM OR-gate  (antithesis sanity)")
    println("    rate_or       = " + rate_or.to_string())
    println("    expected      ≈ 0.9375 (= 1 - 0.5^4)")

    // ── (C) single-factor pinned high ─────────────────────────────
    let rate_pinM   = run_pinned(0)
    let rate_pinC   = run_pinned(1)
    let rate_pinW   = run_pinned(2)
    let rate_pinPhi = run_pinned(3)
    println("")
    println("[C] single-factor pinned high (0.9)")
    println("    pin M     rate = " + rate_pinM.to_string())
    println("    pin C     rate = " + rate_pinC.to_string())
    println("    pin W     rate = " + rate_pinW.to_string())
    println("    pin Phi   rate = " + rate_pinPhi.to_string())
    println("    expected     ≈ 0.125 (= 0.5^3)")

    let avg_pin = (rate_pinM + rate_pinC + rate_pinW + rate_pinPhi) / 4.0
    println("    avg_pin       = " + avg_pin.to_string())

    // Per-factor sensitivity δ_i = rate_pin_i - rate_uniform
    let dM   = rate_pinM   - rate_uniform
    let dC   = rate_pinC   - rate_uniform
    let dW   = rate_pinW   - rate_uniform
    let dPhi = rate_pinPhi - rate_uniform
    println("")
    println("[D] per-factor sensitivity  δ_i = rate_pin_i - rate_uniform")
    println("    δ_M   = " + dM.to_string())
    println("    δ_C   = " + dC.to_string())
    println("    δ_W   = " + dW.to_string())
    println("    δ_Phi = " + dPhi.to_string())

    let dmax = maxf(maxf(dM, dC), maxf(dW, dPhi))
    let dmin = minf(minf(dM, dC), minf(dW, dPhi))
    let mut ratio = 0.0
    if dmin > 0.0 { ratio = dmax / dmin }
    println("    max/min ratio = " + ratio.to_string())
    println("    expected      ≤ 1.6  (uniform AND-sensitivity)")

    // ═════════════════════════════════════════════════════════════
    // FALSIFIER CHECKS
    // ═════════════════════════════════════════════════════════════
    println("")
    println("─── pre-registered falsifier matrix ───")

    chk("F1 EMIT_RATE_IN_BAND       (rate_uniform ∈ [0.04, 0.10])",
          rate_uniform >= 0.04 && rate_uniform <= 0.10)

    let sensitivity_ok = ratio > 0.0 && ratio <= 1.6
    chk("F2 SENSITIVITY_UNIFORM     (max/min ≤ 1.6)",
          sensitivity_ok)

    chk("F3 SINGLE_FACTOR_HIGH      (avg_pin ∈ [0.08, 0.18])",
          avg_pin >= 0.08 && avg_pin <= 0.18)

    chk("F4 OR_GATE_REJECT          (rate_or ≥ 0.90)",
          rate_or >= 0.90)

    chk("F5 CONDITIONAL_RATE_GAP    (avg_pin > rate_uniform)",
          avg_pin > rate_uniform)

    // ═════════════════════════════════════════════════════════════
    // VERDICT
    // ═════════════════════════════════════════════════════════════
    println("")
    println("═══════════════════════════════════════════════════════════")
    println("  PASS = " + PASS.to_string() + "  /  FAIL = " + FAIL.to_string())

    let mut verdict = "UNKNOWN"
    if FAIL == 0 {
        verdict = "🟢 PASS — AND-gate confirmed (M ∧ C ∧ W ∧ Φ)"
    } else if FAIL == 1 {
        verdict = "🟡 PARTIAL — AND-gate qualitative, 1 falsifier fail"
    } else {
        verdict = "🔴 FAIL — gate semantics broken or OR-pattern"
    }
    println("  VERDICT  =  " + verdict)
    println("═══════════════════════════════════════════════════════════")

    // ═════════════════════════════════════════════════════════════
    // JSON dump (machine-readable, single line)
    // ═════════════════════════════════════════════════════════════
    println("")
    println("JSON_BEGIN")
    println("{")
    println("  \"bench\": \"BENCH #7 BRIDGE-AND-GATE\",")
    println("  \"hypothesis\": \"emit ⇔ M ∧ C ∧ W ∧ Φ AND-gate\",")
    println("  \"n_states\": " + N.to_string() + ",")
    println("  \"theta\": " + TH.to_string() + ",")
    println("  \"pin_high\": " + PIN_HIGH.to_string() + ",")
    println("  \"emit_rate_uniform\": " + rate_uniform.to_string() + ",")
    println("  \"emit_rate_or\": " + rate_or.to_string() + ",")
    println("  \"pinned\": {")
    println("    \"M\":   " + rate_pinM.to_string()   + ",")
    println("    \"C\":   " + rate_pinC.to_string()   + ",")
    println("    \"W\":   " + rate_pinW.to_string()   + ",")
    println("    \"Phi\": " + rate_pinPhi.to_string() + "")
    println("  },")
    println("  \"avg_pin\": " + avg_pin.to_string() + ",")
    println("  \"sensitivity\": {")
    println("    \"dM\":   " + dM.to_string()   + ",")
    println("    \"dC\":   " + dC.to_string()   + ",")
    println("    \"dW\":   " + dW.to_string()   + ",")
    println("    \"dPhi\": " + dPhi.to_string() + ",")
    println("    \"max_over_min\": " + ratio.to_string() + "")
    println("  },")
    println("  \"falsifiers\": {")
    println("    \"PASS\": " + PASS.to_string() + ",")
    println("    \"FAIL\": " + FAIL.to_string() + "")
    println("  },")
    println("  \"verdict\": \"" + verdict + "\"")
    println("}")
    println("JSON_END")
}
