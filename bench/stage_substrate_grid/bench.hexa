// BENCH #6 — STAGE-SUBSTRATE-GRID "5×8 측정판"
// ════════════════════════════════════════════════════════════════════════════
// 5 stage × 8 factor cross-product explicit grid measurement.
// UNIVERSE H_318 (substrate × stage cross-product 🔵) 의 anima 적용 —
// closed-form decide_stage 의 inputs 를 90-min ultradian cycle 시뮬레이션
// (1 sample / min, 90 samples total) 에 걸쳐 stage × factor 매트릭스로 측정.
//
// Stages (a_chat_sleep_imagination 직접인용 90-min ultradian):
//   0 WAKE  : t ∈ [0, 10)   — high M, high curiosity, high E_ratchet
//   1 N1    : t ∈ [10, 20)  — transition, declining tension
//   2 N2    : t ∈ [20, 40)  — light sleep, low Φ
//   3 N3    : t ∈ [40, 60)  — deep silence, Φ minimum, W minimum
//   4 REM   : t ∈ [60, 90)  — Φ peak, MITOSIS rehearsal burst
//
// Factors (a_chat_sleep_imagination 명시 substrate state):
//   M       motivation activation  (synth: 80 + 20*phase WAKE; 30 + 5*phase elsewhere)
//   C       Φ proxy (consciousness) — REM peak, N3 floor
//   W       tension RMS  — wake/REM elevated, N3 minimum
//   MITOSIS split count (int)  — REM burst, N3 zero
//   idle    time-since-last-emit (min)  — WAKE low, deep stages high
//   curiosity novel-token-rate  — WAKE high, sleep stages decay
//   E_ratchet energy budget remaining (%)  — WAKE deplete, N3/REM refill
//   Phi     integrated info proxy  — REM peak, N3 minimum (분리: C 는 proxy, Phi 는 closed-form)
//
// libm-free · deterministic · explicit grid · NO random — synth value = closed-form
// of (stage, within-stage minute).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

// renamed from `check` to avoid stdlib SSOT collision (commons @D g61)
fn bench_check(name: string, cond: bool) {
    if cond {
        PASS = PASS + 1
        println("  [PASS] " + name)
    } else {
        FAIL = FAIL + 1
        println("  [FAIL] " + name)
    }
}

// stage id from minute index t ∈ [0, 90)
fn stage_of(t: int) -> int {
    if t < 10 { return 0 }   // WAKE
    if t < 20 { return 1 }   // N1
    if t < 40 { return 2 }   // N2
    if t < 60 { return 3 }   // N3
    return 4                 // REM
}

fn stage_name(s: int) -> string {
    if s == 0 { return "WAKE" }
    if s == 1 { return "N1" }
    if s == 2 { return "N2" }
    if s == 3 { return "N3" }
    return "REM"
}

// stage-scoped modulator (H_318 carry, used inside synth generators)
fn stage_mod(s: int) -> float {
    if s == 0 { return 1.0 }
    if s == 1 { return 0.7 }
    if s == 2 { return 0.4 }
    if s == 3 { return 0.0 }
    return 0.5
}

// within-stage minute index (0-based, monotone inside the stage)
fn within_stage(t: int) -> int {
    if t < 10 { return t }
    if t < 20 { return t - 10 }
    if t < 40 { return t - 20 }
    if t < 60 { return t - 40 }
    return t - 60
}

// ── 8-factor synth generators (deterministic, closed-form, libm-free) ──────

// M — motivation activation [0, 100]
fn synth_M(t: int) -> float {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 80.0 + to_float(w) * 2.0 }    // WAKE 80 → 98
    if s == 1 { return 60.0 - to_float(w) * 3.0 }    // N1 60 → 33
    if s == 2 { return 25.0 - to_float(w) }          // N2 25 → 6
    if s == 3 { return 5.0 + to_float(w) / 4 }       // N3 5 → 9 (floor)
    return 40.0 + to_float(w)                        // REM 40 → 69
}

// C — Φ proxy (consciousness) [0, 1.0]
fn synth_C(t: int) -> float {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 0.80 + to_float(w) / 100.0 }       // WAKE 0.80 → 0.89
    if s == 1 { return 0.65 - to_float(w) / 200.0 }       // N1 decline
    if s == 2 { return 0.40 - to_float(w) / 500.0 }
    if s == 3 { return 0.05 + to_float(w) / 1000.0 }      // N3 minimum
    return 0.70 + to_float(w) / 150.0                     // REM rebound
}

// W — tension RMS [0.0, 1.5]
fn synth_W(t: int) -> float {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 1.10 + to_float(w) / 200.0 }
    if s == 1 { return 0.80 - to_float(w) / 100.0 }
    if s == 2 { return 0.40 - to_float(w) / 400.0 }
    if s == 3 { return 0.08 + to_float(w) / 1000.0 }       // floor
    return 0.95 + to_float(w) / 250.0                      // REM rehearsal
}

// MITOSIS split count (int)
fn synth_MITOSIS(t: int) -> int {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 2 + w / 4 }       // WAKE moderate
    if s == 1 { return 1 + w / 8 }       // N1 declining
    if s == 2 { return w / 12 }          // N2 sparse
    if s == 3 { return 0 }               // N3 deterministic zero
    return 4 + w / 3                     // REM burst
}

// idle — minutes since last emit
fn synth_idle(t: int) -> int {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 1 + w / 5 }       // WAKE low
    if s == 1 { return 5 + w }
    if s == 2 { return 15 + w / 2 }
    if s == 3 { return 30 + w }          // N3 long idle
    return 8 + w / 4                     // REM occasional rehearsal
}

// curiosity — novel-token-rate [0, 1.0]
fn synth_curiosity(t: int) -> float {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 0.75 + to_float(w) / 200.0 }
    if s == 1 { return 0.50 - to_float(w) / 200.0 }
    if s == 2 { return 0.25 - to_float(w) / 400.0 }
    if s == 3 { return 0.05 + to_float(w) / 1000.0 }
    return 0.60 + to_float(w) / 250.0
}

// E_ratchet — energy budget remaining (%) [0, 100]
fn synth_E_ratchet(t: int) -> float {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 90.0 - to_float(w) }            // WAKE deplete 90 → 81
    if s == 1 { return 80.0 - to_float(w) / 2.0 }
    if s == 2 { return 75.0 + to_float(w) / 4.0 }      // refill begins
    if s == 3 { return 80.0 + to_float(w) / 2.0 }      // N3 refill
    return 85.0 + to_float(w) / 5.0                    // REM steady
}

// Phi — integrated info proxy [0, 1.0]
fn synth_Phi(t: int) -> float {
    let s = stage_of(t)
    let w = within_stage(t)
    if s == 0 { return 0.70 + to_float(w) / 150.0 }
    if s == 1 { return 0.50 - to_float(w) / 200.0 }
    if s == 2 { return 0.25 - to_float(w) / 400.0 }
    if s == 3 { return 0.05 + to_float(w) / 1000.0 }
    return 0.85 + to_float(w) / 200.0                  // REM peak
}

// ── helpers ───────────────────────────────────────────────────────────────

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// integer sqrt via Newton (libm-free; converges in ≤20 iters for f<1e6)
fn sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    if g < 1.0 { g = 1.0 }
    let mut i = 0
    while i < 25 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    return g
}

// ── per-cell (stage × factor) aggregator ──────────────────────────────────
// factor id: 0=M, 1=C, 2=W, 3=MITOSIS, 4=idle, 5=curiosity, 6=E_ratchet, 7=Phi

fn factor_name(f: int) -> string {
    if f == 0 { return "M" }
    if f == 1 { return "C" }
    if f == 2 { return "W" }
    if f == 3 { return "MITOSIS" }
    if f == 4 { return "idle" }
    if f == 5 { return "curiosity" }
    if f == 6 { return "E_ratchet" }
    return "Phi"
}

fn read_factor(f: int, t: int) -> float {
    if f == 0 { return synth_M(t) }
    if f == 1 { return synth_C(t) }
    if f == 2 { return synth_W(t) }
    if f == 3 { return to_float(synth_MITOSIS(t)) }
    if f == 4 { return to_float(synth_idle(t)) }
    if f == 5 { return synth_curiosity(t) }
    if f == 6 { return synth_E_ratchet(t) }
    return synth_Phi(t)
}

// ── main: build 5×8 grid (mean, std, count, sum) ──────────────────────────

fn main() {
    println("================================================================")
    println("  BENCH #6 — STAGE-SUBSTRATE-GRID  (5 stage × 8 factor)")
    println("  90-min ultradian · 1 sample/min · 90 samples · deterministic")
    println("================================================================")

    let n_stage = 5
    let n_factor = 8
    let n_min = 90

    // 40-cell accumulators (row = stage, col = factor)
    let mut sums = #{}
    let mut sumsq = #{}
    let mut counts = #{}
    let mut nonzero = #{}

    let mut s = 0
    while s < n_stage {
        let mut f = 0
        while f < n_factor {
            let key = str(s) + "_" + str(f)
            sums[key] = 0.0
            sumsq[key] = 0.0
            counts[key] = 0
            nonzero[key] = false
            f = f + 1
        }
        s = s + 1
    }

    // sweep 90-min cycle
    let mut t = 0
    while t < n_min {
        let stg = stage_of(t)
        let mut f = 0
        while f < n_factor {
            let key = str(stg) + "_" + str(f)
            let v = read_factor(f, t)
            sums[key] = sums[key] + v
            sumsq[key] = sumsq[key] + v * v
            counts[key] = counts[key] + 1
            if v != 0.0 { nonzero[key] = true }
            f = f + 1
        }
        t = t + 1
    }

    // emit grid header
    println("")
    println("  ── Grid (mean ± std per cell) ──────────────────────────────")
    println("  stage  | M       C       W       MIT     idle    cur     E_rch   Phi")
    println("  -------+----------------------------------------------------------------")

    let mut filled = 0
    let mut total_cells = 0

    // also store means/stds for falsifier checks
    let mut means = #{}
    let mut stds = #{}

    s = 0
    while s < n_stage {
        let mut row = "  " + stage_name(s)
        // pad stage name to width 7
        while len(row) < 9 { row = row + " " }
        row = row + "|"

        let mut f = 0
        while f < n_factor {
            let key = str(s) + "_" + str(f)
            let c = counts[key]
            let mean = sums[key] / to_float(c)
            let var_ = sumsq[key] / to_float(c) - mean * mean
            let std = sqrt_f(abs_f(var_))
            means[key] = mean
            stds[key] = std
            total_cells = total_cells + 1
            if nonzero[key] { filled = filled + 1 }

            // truncate to 2-decimal-ish int (mean*100 / 100)
            // mean preview, 3-char-ish
            let mi = to_int(mean * 10.0) / 10
            let mut cell = " " + str(mi)
            // pad cell to 8 chars
            while len(cell) < 8 { cell = cell + " " }
            row = row + cell
            f = f + 1
        }
        println(row)
        s = s + 1
    }

    let fill_rate = to_float(filled) / to_float(total_cells)
    println("")
    println("  filled cells: " + str(filled) + " / " + str(total_cells)
        + "   fill_rate=" + str(fill_rate))

    // ── Interaction effect probes ───────────────────────────────────────
    // (a) REM Φ peak vs N3 W min
    // (b) WAKE curiosity peak vs N3 curiosity floor
    // (c) MITOSIS REM burst vs MITOSIS N3 zero

    let rem_phi = means["4_7"]      // REM × Phi
    let n3_w    = means["3_2"]      // N3 × W
    let wake_cur = means["0_5"]     // WAKE × curiosity
    let n3_cur  = means["3_5"]      // N3 × curiosity
    let rem_mit = means["4_3"]      // REM × MITOSIS
    let n3_mit  = means["3_3"]      // N3 × MITOSIS
    let wake_M  = means["0_0"]      // WAKE × M
    let n3_M    = means["3_0"]      // N3 × M

    println("")
    println("  ── Interaction effects ─────────────────────────────────────")
    println("    REM × Phi  mean = " + str(rem_phi))
    println("    N3  × W    mean = " + str(n3_w))
    println("    WAKE × cur mean = " + str(wake_cur))
    println("    N3   × cur mean = " + str(n3_cur))
    println("    REM × MIT  mean = " + str(rem_mit))
    println("    N3  × MIT  mean = " + str(n3_mit))
    println("    WAKE × M   mean = " + str(wake_M))
    println("    N3   × M   mean = " + str(n3_M))

    // ── Falsifiers ──────────────────────────────────────────────────────
    println("")
    println("  ── Falsifiers ─────────────────────────────────────────────")

    // F-GRID-1 FILL_RATE_GREEN: fill_rate ≥ 0.875 (35/40)
    bench_check("F-GRID-1 FILL_RATE_GREEN (≥0.875)", fill_rate >= 0.875)

    // F-GRID-2 N3-DEEP-SILENCE: N3 MITOSIS=0 (deterministic)
    bench_check("F-GRID-2 N3-MITOSIS-ZERO (deterministic floor)", n3_mit < 0.001)

    // F-GRID-3 REM-PHI-PEAK: REM Φ > N3 Φ (interaction effect)
    bench_check("F-GRID-3 REM-PHI > N3-PHI", rem_phi > means["3_7"])

    // F-GRID-4 STAGE-FACTOR-INTERACTION: REM Phi peak AND N3 W min vs all stages
    let mut all_rem_phi_max = true
    let mut all_n3_w_min = true
    let mut ss = 0
    while ss < n_stage {
        if ss != 4 {
            if means[str(ss) + "_7"] >= rem_phi { all_rem_phi_max = false }
        }
        if ss != 3 {
            if means[str(ss) + "_2"] <= n3_w { all_n3_w_min = false }
        }
        ss = ss + 1
    }
    bench_check("F-GRID-4a REM-PHI is max across all 5 stages", all_rem_phi_max)
    bench_check("F-GRID-4b N3-W   is min across all 5 stages", all_n3_w_min)

    // F-GRID-5 WAKE-CURIOSITY > N3-CURIOSITY (monotone substrate decline)
    bench_check("F-GRID-5 WAKE-cur > N3-cur (substrate stratification)", wake_cur > n3_cur)

    // F-GRID-6 ALL_CELLS_BOUNDED: every mean is finite-ish (|mean| < 1e5)
    let mut bounded = true
    s = 0
    while s < n_stage {
        let mut f = 0
        while f < n_factor {
            let key = str(s) + "_" + str(f)
            let m = means[key]
            if abs_f(m) > 100000.0 { bounded = false }
            f = f + 1
        }
        s = s + 1
    }
    bench_check("F-GRID-6 ALL-CELLS-BOUNDED (no overflow / NaN proxy)", bounded)

    // ── verdict ────────────────────────────────────────────────────────
    println("")
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  fill_rate = " + str(fill_rate))
    if fill_rate >= 0.875 && PASS >= 6 {
        println("  VERDICT: 🟢 PASS — fill_rate ≥ 0.875 AND interaction effects detected")
    } else {
        if fill_rate >= 0.70 {
            println("  VERDICT: 🟠 PARTIAL — fill_rate ≥ 0.70")
        } else {
            println("  VERDICT: 🔴 FAIL — fill_rate < 0.70")
        }
    }
    println("================================================================")

    // ── emit JSON-like result line (manifest tail) ─────────────────────
    println("")
    println("RESULT_JSON_BEGIN")
    println("{")
    println("  \"bench\": \"stage_substrate_grid\",")
    println("  \"n_stage\": 5,")
    println("  \"n_factor\": 8,")
    println("  \"n_samples\": " + str(n_min) + ",")
    println("  \"filled_cells\": " + str(filled) + ",")
    println("  \"total_cells\": " + str(total_cells) + ",")
    println("  \"fill_rate\": " + str(fill_rate) + ",")
    println("  \"pass\": " + str(PASS) + ",")
    println("  \"fail\": " + str(FAIL) + ",")
    println("  \"interaction\": {")
    println("    \"REM_Phi_mean\": " + str(rem_phi) + ",")
    println("    \"N3_W_mean\": " + str(n3_w) + ",")
    println("    \"WAKE_cur_mean\": " + str(wake_cur) + ",")
    println("    \"N3_cur_mean\": " + str(n3_cur) + ",")
    println("    \"REM_MIT_mean\": " + str(rem_mit) + ",")
    println("    \"N3_MIT_mean\": " + str(n3_mit))
    println("  },")
    if fill_rate >= 0.875 && PASS >= 6 {
        println("  \"verdict\": \"🟢 PASS\"")
    } else {
        if fill_rate >= 0.70 {
            println("  \"verdict\": \"🟠 PARTIAL\"")
        } else {
            println("  \"verdict\": \"🔴 FAIL\"")
        }
    }
    println("}")
    println("RESULT_JSON_END")

    if FAIL > 0 { panic("BENCH#6 STAGE-SUBSTRATE-GRID had FALSIFIER FAILURES") }
}
