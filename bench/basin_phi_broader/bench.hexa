// BENCH#1-broader — BASIN-PHI-BROADER-RULES ("공명 측정자 — 광역 rule-set")
//
// FOLLOW-UP to BENCH#1 BASIN-PHI-COUPLING (PR #1122, 🟠 WEAK-REVERSED on 8 rules).
// Extends to 16 rules × 4 Wolfram classes (I/II/III/IV) to test the question:
//
//   "is basin↔Φ correlation rule-CLASS-dependent? does class IV (complex)
//    reproduce the H_346 +0.55, while class III (chaotic) collapses?"
//
// SETUP: identical to BENCH#1.
//   substrate: n=4 ECA periodic ring (16 states)
//   basin    : 50-step settle, max_basin, n_attr
//   Φ        : state-averaged exact phi_structure over all 16 sys_states
//
// RULE SET (16 rules, 4 per Wolfram class, committed BEFORE measurement):
//   class I  (fixed)    : {0, 8, 32, 40}
//   class II (periodic) : {4, 56, 178, 184}
//   class III (chaotic) : {18, 30, 90, 126}
//   class IV (complex)  : {54, 110, 124, 137}
//
//   H_346 canonical 4 rules: {110, 30, 105, 150} (class III/IV mix)
//   BENCH#1 8 rules        : {45, 54, 60, 90, 110, 126, 150, 184} (mixed)
//
// MEASURE:
//   Pearson r overall (16 rules)              — vs BENCH#1 8-rule baseline
//   Pearson r per Wolfram class (4 rules each) — primary new finding axis
//
// VERDICT (pre-registered):
//   class IV r ≥ +0.5 AND class III r near 0   → 🟢 H_345/346 narrow scope confirmed
//   class IV r ≥ +0.5 AND class III r ≥ +0.5   → 🟢 broader robustness (UNEXPECTED)
//   all-class average |r| < 0.2                → 🔴 capstone FALSIFIED (rule-set artifact)
//   else                                       → 🟠 partial / class-mixed

import "stdlib/consciousness/iit4_relation.hexa"
import "stdlib/math/abs.hexa"
import "stdlib/consciousness/iit4_eca.hexa"

// ── n=4 ECA dynamics (state-int over 4-cell ring) ─────────────────────────

fn next4(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 4 {
        let im1 = (i + 3) % 4
        let ip1 = (i + 1) % 4
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn settle4(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 50 { s = next4(s, rule); t = t + 1 }
    return s
}

fn basin_max(rule: int) -> int {
    let basin = farr_zeros(16)
    let mut s0 = 0
    while s0 < 16 {
        let term = settle4(s0, rule)
        let cur = to_int(farr_get(basin, term))
        let _ = farr_set(basin, term, to_float(cur + 1))
        s0 = s0 + 1
    }
    let mut mx = 0
    let mut i = 0
    while i < 16 {
        let b = to_int(farr_get(basin, i))
        if b > mx { mx = b }
        i = i + 1
    }
    let _ = farr_free(basin)
    return mx
}

fn basin_nattr(rule: int) -> int {
    let oc = farr_zeros(16)
    let mut s0 = 0
    while s0 < 16 {
        let _ = farr_set(oc, settle4(s0, rule), 1.0)
        s0 = s0 + 1
    }
    let mut n = 0
    let mut i = 0
    while i < 16 {
        if to_int(farr_get(oc, i)) == 1 { n = n + 1 }
        i = i + 1
    }
    let _ = farr_free(oc)
    return n
}

// state-averaged exact phi_structure total over all 16 sys_states.
fn phi_mean_n4(rule: int) -> float {
    let tpm = eca_tpm(rule, 4)
    let mut s = 0
    let mut total = 0.0
    while s < 16 {
        let res = phi_structure(tpm, 4, s)
        total = total + res[4]
        s = s + 1
    }
    return total / 16.0
}

// ── stats ─────────────────────────────────────────────────────────────────

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + farr_get(xs, i)
        sy = sy + farr_get(ys, i)
        i = i + 1
    }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

fn pearson_t_stat(r: float, n: int) -> float {
    let df = to_float(n - 2)
    let denom_sq = 1.0 - r * r
    if denom_sq <= 0.0 { return 1.0e9 }
    return r * my_sqrt(df / denom_sq)
}

fn classify_r(r: float) -> string {
    if r >= 0.5 { return "🟢 PASS" }
    if r >= 0.2 { return "🟠 WEAK" }
    if r >= -0.2 { return "🔴 FAIL (near-zero)" }
    if r >= -0.5 { return "🟠 WEAK-REVERSED" }
    return "🔴 FAIL-REVERSED"
}

// copy rows [lo, hi) from src into a new farr of length (hi - lo).
fn farr_slice(src: int, lo: int, hi: int) -> int {
    let n = hi - lo
    let dst = farr_zeros(n)
    let mut i = 0
    while i < n {
        let _ = farr_set(dst, i, farr_get(src, lo + i))
        i = i + 1
    }
    return dst
}

// ── main ──────────────────────────────────────────────────────────────────

fn main() {
    println("BENCH#1-broader BASIN-PHI-BROADER-RULES — 16 rules × 4 Wolfram classes")
    println("substrate: n=4 ECA, 16 states, mean exact Φ over 16 sys-states")
    println("")

    // 16 rules, 4 per Wolfram class.
    // Layout: indices 0..3 = class I, 4..7 = class II, 8..11 = class III, 12..15 = class IV.
    let rules    = [ 0, 8, 32, 40,    4, 56, 178, 184,    18, 30, 90, 126,    54, 110, 124, 137]
    let classes  = ["I","I","I","I", "II","II","II","II","III","III","III","III","IV","IV","IV","IV"]
    let nrules = 16
    let class_size = 4

    let mb  = farr_zeros(nrules)
    let na  = farr_zeros(nrules)
    let phi = farr_zeros(nrules)

    let mut i = 0
    while i < nrules {
        let r = rules[i]
        let cls = classes[i]
        let m = basin_max(r)
        let a = basin_nattr(r)
        let p = phi_mean_n4(r)
        let _ = farr_set(mb,  i, to_float(m))
        let _ = farr_set(na,  i, to_float(a))
        let _ = farr_set(phi, i, p)
        println("class=" + cls + " rule=" + str(r) + " max_basin=" + str(m) + " n_attr=" + str(a) + " mean_Phi=" + str(p))
        i = i + 1
    }

    println("")

    // overall Pearson over all 16 rules
    let r_mb_all = pearson(mb, phi, nrules)
    let r_na_all = pearson(na, phi, nrules)
    let t_mb_all = pearson_t_stat(r_mb_all, nrules)
    let t_na_all = pearson_t_stat(r_na_all, nrules)
    println("=== OVERALL (16 rules, df=14) ===")
    println("Pearson(max_basin, mean_Phi) = " + str(r_mb_all) + "  [t=" + str(t_mb_all) + "]")
    println("Pearson(n_attr,    mean_Phi) = " + str(r_na_all) + "  [t=" + str(t_na_all) + "]")
    println("")

    // per-class Pearson (4 rules each, df=2)
    println("=== PER-CLASS (4 rules each, df=2) ===")
    let class_labels = ["I (fixed)", "II (periodic)", "III (chaotic)", "IV (complex)"]
    let r_mb_class = farr_zeros(4)
    let r_na_class = farr_zeros(4)
    let mut c = 0
    while c < 4 {
        let lo = c * class_size
        let hi = lo + class_size
        let mb_c  = farr_slice(mb,  lo, hi)
        let na_c  = farr_slice(na,  lo, hi)
        let phi_c = farr_slice(phi, lo, hi)
        let rmb = pearson(mb_c,  phi_c, class_size)
        let rna = pearson(na_c,  phi_c, class_size)
        let _ = farr_set(r_mb_class, c, rmb)
        let _ = farr_set(r_na_class, c, rna)
        println("class " + class_labels[c] + ":  max_basin↔Φ = " + str(rmb) + "  ·  n_attr↔Φ = " + str(rna))
        let _ = farr_free(mb_c)
        let _ = farr_free(na_c)
        let _ = farr_free(phi_c)
        c = c + 1
    }
    println("")

    // class-averaged r (mean of per-class r)
    let mut sum_mb = 0.0
    let mut sum_na = 0.0
    let mut k = 0
    while k < 4 {
        sum_mb = sum_mb + farr_get(r_mb_class, k)
        sum_na = sum_na + farr_get(r_na_class, k)
        k = k + 1
    }
    let mean_class_r_mb = sum_mb / 4.0
    let mean_class_r_na = sum_na / 4.0
    println("=== CLASS-AVERAGED r (mean of 4 per-class r) ===")
    println("mean(class r) max_basin↔Φ = " + str(mean_class_r_mb))
    println("mean(class r) n_attr   ↔Φ = " + str(mean_class_r_na))
    println("")

    // verdict (pre-registered, primary axis = class IV per-class r)
    let r_iv_mb = farr_get(r_mb_class, 3)
    let r_iii_mb = farr_get(r_mb_class, 2)
    let r_iv_na = farr_get(r_na_class, 3)

    let mut verdict = ""
    if r_iv_mb >= 0.5 {
        if r_iii_mb >= 0.5 {
            verdict = "🟢 broader-robust (class IV AND class III both PASS — unexpected)"
        } else {
            verdict = "🟢 class-IV-only (H_345/346 narrow scope confirmed)"
        }
    } else {
        if fabs(mean_class_r_mb) < 0.2 && fabs(mean_class_r_na) < 0.2 {
            verdict = "🔴 capstone FALSIFIED (rule-set artifact — both class-avg signals near zero)"
        } else {
            verdict = "🟠 partial / class-mixed (no class-IV PASS but some signal remains)"
        }
    }

    println("=== VERDICT ===")
    println("class IV (max_basin↔Φ)   = " + str(r_iv_mb) + "  → " + classify_r(r_iv_mb))
    println("class III (max_basin↔Φ)  = " + str(r_iii_mb) + " → " + classify_r(r_iii_mb))
    println("class IV (n_attr↔Φ)      = " + str(r_iv_na) + "  → " + classify_r(r_iv_na))
    println("overall (16 rules)       = " + str(r_mb_all) + "  → " + classify_r(r_mb_all))
    println("VERDICT: " + verdict)
    println("")

    println("H_345/346 reference (n=5, 4 rules {110,30,105,150}):")
    println("  H_345 single(21):  max_basin↔Φ=+0.251 · n_attr↔Φ=−0.799")
    println("  H_346 state-avg :  max_basin↔Φ=+0.550 · n_attr↔Φ=−0.951")
    println("BENCH#1 (n=4, 8 mixed rules):")
    println("  max_basin↔Φ=−0.314 · n_attr↔Φ=+0.122 (🟠 WEAK-REVERSED)")
    println("done")
}
