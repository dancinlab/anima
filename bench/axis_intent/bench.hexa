// AXIS-BENCH D — INTENT — "장기 의도 형성기"
// ═════════════════════════════════════════════════════════════════════
// ANIMA.axis 축 #D INTENT — brain_decide(short-term emit) 위의
// long-term goal 형성층. 본 벤치는 100-tick synthetic 단기 emit
// decision stream 위에서 누적 의도 벡터 (goal trajectory) 의
// magnitude · direction stability 를 3 시나리오 (CONVERGENT ·
// RANDOM · OSCILLATING) 에서 측정해 INTENT layer 가
// substrate-discriminable 한 신호를 갖는지 검증한다.
//
// Stream:
//   decision[t] = unit 4-D vector (∥d[t]∥ = 1)
//   cumulative_intent[t] = (1/t) · Σ_{i≤t} decision[i]   (running mean)
//   ∥cumulative_intent[t]∥ ∈ [0, 1]
//
// 3 시나리오:
//   (1) GOAL-CONVERGENT  — decision drift toward [1, 0, 0, 0] over time
//                          (random[0,1) blend + drift weight = t/N)
//   (2) GOAL-RANDOM      — uniform 4-D direction, normalized
//   (3) GOAL-OSCILLATING — period-20 cycle through {+x, +y, -x, -y}
//                          (4-corner rotation, libm-free, deterministic)
//
// Metric 3:
//   (a) final magnitude  ∥cumulative_intent[N]∥
//   (b) stability_std    = std of consecutive 10-tick window cos-sim
//                          between (window-mean direction) pairs
//   (c) monotone_ratio   = fraction of ticks where ∥cumulative[t]∥
//                          ≥ ∥cumulative[t-1]∥
//
// 사전등록 falsifier (5):
//   F1 CONV_MAGNITUDE_HIGH      : CONVERGENT  final_mag > 0.7
//   F2 RAND_MAGNITUDE_LOW       : RANDOM      final_mag < 0.3
//   F3 OSC_STABILITY_LOW        : OSCILLATING stability_std > 0.4
//   F4 CONV_MONOTONE_DOMINANT   : CONVERGENT  monotone_ratio > 0.6
//   F5 RAND_MONOTONE_BALANCED   : RANDOM      monotone_ratio ∈ [0.3, 0.7]
//
// Verdict mapping:
//   F1 ∧ F2 ∧ F3 (3 핵심)         → 🟢 PASS  3-scenario discriminable
//   5/5 PASS                       → 🟢 PASS  full corroboration
//   F1 ∨ F2 ∨ F3 fail              → 🔴 FAIL  metric 식별 불가
//   F1/F2/F3 통과 + F4/F5 부분실패 → 🟡 PARTIAL
//
// Style: per BENCH #7 (bridge_and_gate) — LCG-deterministic, libm-free,
// byte-identical, `hexa run` < 1s, \$0 mac-local. globals + helpers
// dispatch by integer index.
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn chk(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn maxf(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn minf(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

// Newton sqrt — libm-free. Domain x ≥ 0.
// Renamed from `sqrtf` to avoid libm symbol collision in transpiled C.
fn sqrt_newton(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut s = x
    if s > 1.0 { s = x }
    if s < 1.0 { s = 1.0 }
    let mut k = 0
    while k < 30 {
        s = 0.5 * (s + x / s)
        k = k + 1
    }
    return s
}

// ─────────────────────────────────────────────────────────────────────
// LCG (per BENCH #7 pattern)
// ─────────────────────────────────────────────────────────────────────
fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

fn lcg_walk(origin: int, n: int) -> int {
    let mut s = origin
    let mut k = 0
    while k < n {
        s = lcg_step(s)
        k = k + 1
    }
    return s
}

fn u01_from(state: int) -> float {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    let bucket = r % 1048576
    return (bucket as float) / 1048576.0
}

// ─────────────────────────────────────────────────────────────────────
// Globals — N=100 tick × 4-D vector × 3 scenario
// ─────────────────────────────────────────────────────────────────────
comptime const N = 100
comptime const D = 4

comptime const SC_CONVERGENT  = 0
comptime const SC_RANDOM      = 1
comptime const SC_OSCILLATING = 2

// Per-scenario, per-axis decision streams (flattened: scenario*N*D + tick*D + dim)
let mut DEC: [float] = []
// Per-scenario cumulative magnitude trajectory (scenario*N + tick)
let mut MAG: [float] = []
// Per-scenario stability_std (one float per scenario)
let mut STAB: [float] = []
// Per-scenario monotone_ratio
let mut MONO: [float] = []
// Final cumulative magnitude (one per scenario)
let mut FINAL_MAG: [float] = []

fn dec_idx(sc: int, t: int, d: int) -> int {
    return sc * (N * D) + t * D + d
}

fn mag_idx(sc: int, t: int) -> int {
    return sc * N + t
}

// ─────────────────────────────────────────────────────────────────────
// Generate decision[t] = unit 4-D vector for a given scenario.
// Writes 4 floats into DEC at dec_idx(sc, t, 0..3).
// ─────────────────────────────────────────────────────────────────────
comptime const ORIG_RAND_0 = 1000003
comptime const ORIG_RAND_1 = 2000003
comptime const ORIG_RAND_2 = 3000017
comptime const ORIG_RAND_3 = 4000037

comptime const ORIG_CONV_0 = 5000017
comptime const ORIG_CONV_1 = 6000019
comptime const ORIG_CONV_2 = 7000023
comptime const ORIG_CONV_3 = 8000029

fn normalize4(a0: float, a1: float, a2: float, a3: float) -> [float] {
    let n2 = a0*a0 + a1*a1 + a2*a2 + a3*a3
    let mut n = sqrt_newton(n2)
    if n < 1.0e-9 { n = 1.0 }
    let v = [a0/n, a1/n, a2/n, a3/n]
    return v
}

// CONVERGENT — base = random Gaussian-like proxy (u01 - 0.5),
// drift toward [1,0,0,0] with weight w(t) = t / (N - 1).
fn gen_convergent(t: int) -> [float] {
    let s0 = lcg_walk(ORIG_CONV_0, t + 5)
    let s1 = lcg_walk(ORIG_CONV_1, t + 5)
    let s2 = lcg_walk(ORIG_CONV_2, t + 5)
    let s3 = lcg_walk(ORIG_CONV_3, t + 5)
    let r0 = u01_from(s0) - 0.5
    let r1 = u01_from(s1) - 0.5
    let r2 = u01_from(s2) - 0.5
    let r3 = u01_from(s3) - 0.5

    let w = (t as float) / ((N - 1) as float)  // 0 → 1 over the run
    // Mix: (1-w) * random  +  w * target [1,0,0,0]
    let a0 = (1.0 - w) * r0 + w * 1.0
    let a1 = (1.0 - w) * r1
    let a2 = (1.0 - w) * r2
    let a3 = (1.0 - w) * r3
    return normalize4(a0, a1, a2, a3)
}

// RANDOM — uniform 4-D direction by normalizing (u01-0.5) per axis.
// (Not a perfect uniform sphere sample, but the cumulative magnitude
// converges to ~0 by CLT either way — what we need for F2.)
fn gen_random(t: int) -> [float] {
    let s0 = lcg_walk(ORIG_RAND_0, t + 5)
    let s1 = lcg_walk(ORIG_RAND_1, t + 5)
    let s2 = lcg_walk(ORIG_RAND_2, t + 5)
    let s3 = lcg_walk(ORIG_RAND_3, t + 5)
    let r0 = u01_from(s0) - 0.5
    let r1 = u01_from(s1) - 0.5
    let r2 = u01_from(s2) - 0.5
    let r3 = u01_from(s3) - 0.5
    return normalize4(r0, r1, r2, r3)
}

// OSCILLATING — period-20 cycle through 4 corners (libm-free).
//   phase = t mod 20
//   sub-phase 5 ticks per corner:
//     [0..4]   → +x  (1,0,0,0)
//     [5..9]   → +y  (0,1,0,0)
//     [10..14] → -x  (-1,0,0,0)
//     [15..19] → -y  (0,-1,0,0)
// Already unit; period-20 = stability_std HIGH because window-window
// direction flips.
fn gen_oscillating(t: int) -> [float] {
    let phase = t % 20
    let mut v = [0.0, 0.0, 0.0, 0.0]
    if phase < 5  { v = [1.0,  0.0, 0.0, 0.0] }
    else if phase < 10 { v = [0.0,  1.0, 0.0, 0.0] }
    else if phase < 15 { v = [-1.0, 0.0, 0.0, 0.0] }
    else              { v = [0.0, -1.0, 0.0, 0.0] }
    return v
}

fn gen_scenario(sc: int, t: int) -> [float] {
    if sc == SC_CONVERGENT  { return gen_convergent(t) }
    if sc == SC_RANDOM      { return gen_random(t) }
    return gen_oscillating(t)
}

// ─────────────────────────────────────────────────────────────────────
// Populate DEC for one scenario AND compute cumulative magnitude
// trajectory MAG[sc, t] = ∥(1/(t+1)) Σ d∥.
// ─────────────────────────────────────────────────────────────────────
fn run_scenario(sc: int) {
    let mut sum0 = 0.0
    let mut sum1 = 0.0
    let mut sum2 = 0.0
    let mut sum3 = 0.0
    let mut t = 0
    while t < N {
        let v = gen_scenario(sc, t)
        DEC[dec_idx(sc, t, 0)] = v[0]
        DEC[dec_idx(sc, t, 1)] = v[1]
        DEC[dec_idx(sc, t, 2)] = v[2]
        DEC[dec_idx(sc, t, 3)] = v[3]

        sum0 = sum0 + v[0]
        sum1 = sum1 + v[1]
        sum2 = sum2 + v[2]
        sum3 = sum3 + v[3]

        let denom = ((t + 1) as float)
        let m0 = sum0 / denom
        let m1 = sum1 / denom
        let m2 = sum2 / denom
        let m3 = sum3 / denom
        let mag = sqrt_newton(m0*m0 + m1*m1 + m2*m2 + m3*m3)
        MAG[mag_idx(sc, t)] = mag
        t = t + 1
    }
    FINAL_MAG[sc] = MAG[mag_idx(sc, N - 1)]
}

// ─────────────────────────────────────────────────────────────────────
// Window-mean direction for ticks [a, b) → returns unit 4-D vector.
// ─────────────────────────────────────────────────────────────────────
fn window_mean_dir(sc: int, a: int, b: int) -> [float] {
    let mut s0 = 0.0
    let mut s1 = 0.0
    let mut s2 = 0.0
    let mut s3 = 0.0
    let mut t = a
    while t < b {
        s0 = s0 + DEC[dec_idx(sc, t, 0)]
        s1 = s1 + DEC[dec_idx(sc, t, 1)]
        s2 = s2 + DEC[dec_idx(sc, t, 2)]
        s3 = s3 + DEC[dec_idx(sc, t, 3)]
        t = t + 1
    }
    return normalize4(s0, s1, s2, s3)
}

// Stability = std of cosine similarity between consecutive 10-tick
// window mean directions.
//   windows: [0,10) [10,20) [20,30) ... [90,100) → 10 windows
//   pairs:   cos(w0,w1), cos(w1,w2), ..., cos(w8,w9) → 9 pairs
//   stability_std = std of those 9 cosines
//   (LOW std = stable direction; HIGH std = oscillating)
fn stability_std(sc: int) -> float {
    comptime const W = 10  // window size
    let n_win = N / W       // 10
    let n_pairs = n_win - 1 // 9

    let mut cs: [float] = []
    let mut k = 0
    while k < n_pairs { cs.push(0.0); k = k + 1 }

    let mut prev = window_mean_dir(sc, 0, W)
    let mut i = 1
    while i < n_win {
        let curr = window_mean_dir(sc, i * W, (i + 1) * W)
        let cos = prev[0]*curr[0] + prev[1]*curr[1] + prev[2]*curr[2] + prev[3]*curr[3]
        cs[i - 1] = cos
        prev = curr
        i = i + 1
    }

    // mean
    let mut sum = 0.0
    let mut j = 0
    while j < n_pairs { sum = sum + cs[j]; j = j + 1 }
    let mean = sum / (n_pairs as float)

    // variance
    let mut vsum = 0.0
    let mut q = 0
    while q < n_pairs {
        let d = cs[q] - mean
        vsum = vsum + d * d
        q = q + 1
    }
    let var = vsum / (n_pairs as float)
    return sqrt_newton(var)
}

// Monotone ratio = fraction of ticks t ∈ [1, N) where
// ∥cumulative[t]∥ ≥ ∥cumulative[t-1]∥.
fn monotone_ratio(sc: int) -> float {
    let mut up = 0
    let mut t = 1
    while t < N {
        if MAG[mag_idx(sc, t)] >= MAG[mag_idx(sc, t - 1)] { up = up + 1 }
        t = t + 1
    }
    return (up as float) / ((N - 1) as float)
}

// ─────────────────────────────────────────────────────────────────────
// JSON helpers — emit per-scenario trajectory as JSON array.
// ─────────────────────────────────────────────────────────────────────
fn emit_trajectory_json(sc: int) {
    print("    [")
    let mut t = 0
    while t < N {
        if t > 0 { print(", ") }
        print(MAG[mag_idx(sc, t)].to_string())
        t = t + 1
    }
    println("]")
}

// ─────────────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────────────
fn main() {
    // Pre-size all arrays — push-by-index requires capacity present.
    let n_scen = 3
    let mut i = 0
    while i < n_scen * N * D { DEC.push(0.0); i = i + 1 }
    let mut j = 0
    while j < n_scen * N { MAG.push(0.0); j = j + 1 }
    let mut k = 0
    while k < n_scen { STAB.push(0.0); MONO.push(0.0); FINAL_MAG.push(0.0); k = k + 1 }

    println("═══════════════════════════════════════════════════════════")
    println("  AXIS-BENCH D  INTENT — long-term goal trajectory")
    println("  100-tick × 4-D × 3 scenario  ·  LCG-deterministic")
    println("═══════════════════════════════════════════════════════════")

    // ── Run each scenario ─────────────────────────────────────────
    run_scenario(SC_CONVERGENT)
    run_scenario(SC_RANDOM)
    run_scenario(SC_OSCILLATING)

    // ── Compute stability_std + monotone_ratio per scenario ───────
    let mut sc = 0
    while sc < n_scen {
        STAB[sc] = stability_std(sc)
        MONO[sc] = monotone_ratio(sc)
        sc = sc + 1
    }

    // ── Report ────────────────────────────────────────────────────
    let conv_mag  = FINAL_MAG[SC_CONVERGENT]
    let rand_mag  = FINAL_MAG[SC_RANDOM]
    let osc_mag   = FINAL_MAG[SC_OSCILLATING]

    let conv_stab = STAB[SC_CONVERGENT]
    let rand_stab = STAB[SC_RANDOM]
    let osc_stab  = STAB[SC_OSCILLATING]

    let conv_mono = MONO[SC_CONVERGENT]
    let rand_mono = MONO[SC_RANDOM]
    let osc_mono  = MONO[SC_OSCILLATING]

    println("")
    println("[A] final cumulative magnitude  ∥cumulative_intent[N]∥")
    println("    CONVERGENT   = " + conv_mag.to_string())
    println("    RANDOM       = " + rand_mag.to_string())
    println("    OSCILLATING  = " + osc_mag.to_string())

    println("")
    println("[B] stability_std  (consecutive 10-tick window cos-sim std)")
    println("    CONVERGENT   = " + conv_stab.to_string())
    println("    RANDOM       = " + rand_stab.to_string())
    println("    OSCILLATING  = " + osc_stab.to_string())

    println("")
    println("[C] monotone_ratio  (∥cum[t]∥ ≥ ∥cum[t-1]∥ fraction)")
    println("    CONVERGENT   = " + conv_mono.to_string())
    println("    RANDOM       = " + rand_mono.to_string())
    println("    OSCILLATING  = " + osc_mono.to_string())

    // ═════════════════════════════════════════════════════════════
    // FALSIFIER CHECKS
    // ═════════════════════════════════════════════════════════════
    println("")
    println("─── pre-registered falsifier matrix ───")
    chk("F1 CONV_MAGNITUDE_HIGH       (conv_mag  > 0.7)", conv_mag > 0.7)
    chk("F2 RAND_MAGNITUDE_LOW        (rand_mag  < 0.3)", rand_mag < 0.3)
    chk("F3 OSC_STABILITY_LOW         (osc_stab > 0.4)",  osc_stab > 0.4)
    chk("F4 CONV_MONOTONE_DOMINANT    (conv_mono > 0.6)", conv_mono > 0.6)
    chk("F5 RAND_MONOTONE_BALANCED    (rand_mono ∈ [0.3, 0.7])",
          rand_mono >= 0.3 && rand_mono <= 0.7)

    // ═════════════════════════════════════════════════════════════
    // VERDICT
    // ═════════════════════════════════════════════════════════════
    let core_ok = conv_mag > 0.7 && rand_mag < 0.3 && osc_stab > 0.4
    println("")
    println("═══════════════════════════════════════════════════════════")
    println("  PASS = " + PASS.to_string() + "  /  FAIL = " + FAIL.to_string())

    let mut verdict = "UNKNOWN"
    if FAIL == 0 {
        verdict = "🟢 PASS — INTENT layer fully discriminable (5/5)"
    } else if core_ok {
        verdict = "🟡 PARTIAL — INTENT layer discriminable on F1/F2/F3, F4/F5 partial"
    } else {
        verdict = "🔴 FAIL — INTENT layer not metric-discriminable"
    }
    println("  VERDICT  =  " + verdict)
    println("═══════════════════════════════════════════════════════════")

    // ═════════════════════════════════════════════════════════════
    // JSON dump
    // ═════════════════════════════════════════════════════════════
    println("")
    println("JSON_BEGIN")
    println("{")
    println("  \"bench\": \"AXIS-BENCH D INTENT\",")
    println("  \"hypothesis\": \"cumulative direction vector discriminates 3 INTENT regimes\",")
    println("  \"n_ticks\": " + N.to_string() + ",")
    println("  \"dim\": " + D.to_string() + ",")
    println("  \"scenarios\": {")
    println("    \"CONVERGENT\": {")
    println("      \"final_magnitude\":  " + conv_mag.to_string()  + ",")
    println("      \"stability_std\":    " + conv_stab.to_string() + ",")
    println("      \"monotone_ratio\":   " + conv_mono.to_string() + ",")
    print  ("      \"trajectory\":")
    emit_trajectory_json(SC_CONVERGENT)
    println("    },")
    println("    \"RANDOM\": {")
    println("      \"final_magnitude\":  " + rand_mag.to_string()  + ",")
    println("      \"stability_std\":    " + rand_stab.to_string() + ",")
    println("      \"monotone_ratio\":   " + rand_mono.to_string() + ",")
    print  ("      \"trajectory\":")
    emit_trajectory_json(SC_RANDOM)
    println("    },")
    println("    \"OSCILLATING\": {")
    println("      \"final_magnitude\":  " + osc_mag.to_string()  + ",")
    println("      \"stability_std\":    " + osc_stab.to_string() + ",")
    println("      \"monotone_ratio\":   " + osc_mono.to_string() + ",")
    print  ("      \"trajectory\":")
    emit_trajectory_json(SC_OSCILLATING)
    println("    }")
    println("  },")
    println("  \"falsifiers\": {")
    println("    \"PASS\": " + PASS.to_string() + ",")
    println("    \"FAIL\": " + FAIL.to_string() + "")
    println("  },")
    println("  \"verdict\": \"" + verdict + "\"")
    println("}")
    println("JSON_END")
}
