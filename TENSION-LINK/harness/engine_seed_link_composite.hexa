// ════════════════════════════════════════════════════════════════════════════
//  TENSION-LINK/harness/engine_seed_link_composite.hexa
//
//  H_6036–H_6043 .hexa ENGINE LIFT — the SEED+LINK composite, lifted from the
//  numpy toy into the REAL .hexa engine (H_1199 precedent: numpy mirror → live
//  engine). The 3-arm bidirectional Kuramoto integrator (H_6010 mechanism) runs
//  natively in .hexa over REAL paid ANU QRNG bytes read from the committed
//  snapshot ints (TENSION-LINK/anu_seed_512.ints.txt, tier=anu_paid).
//
//    SEED : shared-seed init, K=0  → rigid; detuning + drift decay the lock
//    LINK : independent init, K>0  → locks but pays a cold-start
//    BOTH : shared init + K>0       → instant lock@0 AND sustained under drift
//
//  Reproduces the numpy finding (BOTH lock@0·r≈1, LINK cold-starts, SEED decays)
//  on the engine. Param map = direct byte/255 (NOT the python sha256 expansion),
//  so the cross-check sibling (h6036b_hexa_crosscheck.py) uses the SAME map and
//  the two MATCH numerically → engine reproduces the mechanism, not a mirror.
//
//  p7 · $0 local.  Run:  hexa run TENSION-LINK/harness/engine_seed_link_composite.hexa
// ════════════════════════════════════════════════════════════════════════════

fn _f3(x: float) -> string {
    let s=floor(x*1000.0+0.5); let mut neg=false; let mut v=s
    if v<0.0 {neg=true; v=0.0-v}
    let w=floor(v/1000.0); let fr=v-w*1000.0
    let mut fs=str(to_int(fr)); while len(fs)<3 {fs="0"+fs}
    return (if neg {"-"} else {""})+str(to_int(w))+"."+fs
}

let PI2 = 6.283185307179586
let DT  = 0.02
let T   = 4000
let K   = 1.2
let LOCK = 0.90

// order parameter for two phases: r = |e^{i a}+e^{i b}| / 2  ∈ [0,1]
fn order2(a: float, b: float) -> float {
    let cr = cos(a)+cos(b); let ci = sin(a)+sin(b)
    return sqrt(cr*cr + ci*ci)/2.0
}

// run one arm. arm: 0=SEED 1=LINK 2=BOTH. returns [steady_r, t_lock]
fn run_arm(arm: int, wA: float, wB: float, sh: float, iA: float, iB: float,
           kick_ticks: [int], kick_mag: [float]) -> [float] {
    let mut a = if arm==1 {iA} else {sh}
    let mut b = if arm==1 {iB} else {sh}
    let Kc = if arm==0 {0.0} else {K}
    let mut t = 0
    let mut t_lock = -1
    let mut acc = 0.0
    let mut cnt = 0
    let warm = to_int(to_float(T)*0.8)
    while t < T {
        // drift kicks on B
        let mut ki = 0
        while ki < len(kick_ticks) {
            if kick_ticks[ki]==t { b = b + kick_mag[ki] }
            ki = ki+1
        }
        let da = wA + Kc*sin(b-a)
        let db = wB + Kc*sin(a-b)
        a = a + da*DT
        b = b + db*DT
        let r = order2(a,b)
        if t_lock < 0 { if r >= LOCK { t_lock = t } }
        if t >= warm { acc = acc + r; cnt = cnt+1 }
        t = t+1
    }
    let steady = acc / to_float(cnt)
    return [steady, to_float(if t_lock<0 {T} else {t_lock})]
}

fn main() {
    println("==============================================================================")
    println("H_6036–43 LIFT — SEED+LINK composite on the REAL .hexa engine (paid ANU bytes)")
    println("==============================================================================")
    let text = read_file("TENSION-LINK/anu_seed_512.ints.txt")
    let toks = text.trim().split(" ")
    let mut bytes: [float] = []
    let mut i = 0
    while i < len(toks) { bytes = bytes + [toks[i].to_float()]; i = i+1 }

    let offs = [0, 160, 320]
    let names = ["SEED", "LINK", "BOTH"]
    // accumulate means across 3 trials
    let mut sumR = [0.0, 0.0, 0.0]
    let mut sumL = [0.0, 0.0, 0.0]
    let mut ti = 0
    while ti < len(offs) {
        let o = offs[ti]
        let wA = 1.0 + (bytes[o]/255.0)*0.6
        let wB = 1.0 + (bytes[o+1]/255.0)*0.6
        let sh = (bytes[o+2]/255.0)*PI2
        let iA = (bytes[o+3]/255.0)*PI2
        let iB = (bytes[o+4]/255.0)*PI2
        // 6 drift kicks
        let mut kt: [int] = []
        let mut km: [float] = []
        let mut di = 0
        while di < 6 {
            let tick = to_int((bytes[o+5+di]/255.0)*(to_float(T)*0.8)) + to_int(to_float(T)*0.1)
            kt = kt + [tick]
            km = km + [((bytes[o+20+di]/255.0)-0.5)*PI2]
            di = di+1
        }
        let mut line = "  trial"+str(ti+1)+": "
        let mut arm = 0
        while arm < 3 {
            let res = run_arm(arm, wA, wB, sh, iA, iB, kt, km)
            sumR[arm] = sumR[arm] + res[0]
            sumL[arm] = sumL[arm] + res[1]
            line = line + names[arm] + " r=" + _f3(res[0]) + " lock@" + str(to_int(res[1])) + "  "
            arm = arm+1
        }
        println(line)
        ti = ti+1
    }
    println("------------------------------------------------------------------------------")
    let nf = to_float(len(offs))
    let mut arm = 0
    while arm < 3 {
        println("  "+names[arm]+": mean steady-r = "+_f3(sumR[arm]/nf)
            +"   mean ticks-to-lock = "+_f3(sumL[arm]/nf))
        arm = arm+1
    }
    println("------------------------------------------------------------------------------")
    let rS = sumR[0]/nf; let rL = sumR[1]/nf; let rB = sumR[2]/nf
    let lL = sumL[1]/nf; let lB = sumL[2]/nf
    // F2 time-domain synergy (the H_6036 real edge): BOTH locks faster than LINK
    // AND beats SEED (which decays under detuning/drift)
    let f2 = (lB < lL) && (rB > rS)
    println("  F2 time-domain synergy (lock_BOTH<lock_LINK & r_BOTH>r_SEED): "
        +"lock "+_f3(lB)+"<"+_f3(lL)+" & r "+_f3(rB)+">"+_f3(rS)
        +"  -> "+(if f2 {"PASS"} else {"FAIL"}))
    println((if f2 {"🟢"} else {"🔴"})+" engine reproduces the composite: shared-seed init removes LINK's "
        +"cold-start while surviving the detuning/drift that decays SEED-alone.")
    println("  honest: byte/255 param map (not python sha256) — matches the h6036b crosscheck, "
        +"NOT the sha-based H_6036 verdict numbers; same paid ANU entropy. Toy (a_toy_scale_recheck).")
}
