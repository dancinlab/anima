// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/harness/engine_tension_birth.hexa
//  H_6014 — 텐션으로 새 anima를 낳다 (external tension → MITOSIS birth, real engine).
//  External tension NOVELTY drives vadapt mitosis splits; a high-novelty stream
//  BIRTHS a viable self-model (many cells, low recon-err), a repetitive one does not.
//  p7 · $0.  hexa run UNIVERSE/harness/engine_tension_birth.hexa
// ════════════════════════════════════════════════════════════════════════════
import "CORE/engine_cli.hexa"

fn _f4(x: float) -> string {
    let s=floor(x*10000.0+0.5); let mut neg=false; let mut v=s
    if v<0.0 {neg=true; v=0.0-v}
    let w=floor(v/10000.0); let fr=v-w*10000.0
    let mut fs=str(to_int(fr)); while len(fs)<4 {fs="0"+fs}
    return (if neg {"-"} else {""})+str(to_int(w))+"."+fs
}

// grow a fresh substrate from an external tension stream of a given NOVELTY.
// novelty=0 → repetitive (same vector); novelty=1 → highly varied. returns cells.
fn birth(novelty: float, cfg: EngineConfig) -> int {
    let mut af = vadapt_field_new([0.0,0.0,0.0], 4096)
    let mut k = 0
    while k < 120 {
        let j = float(k) * novelty
        let x = [j*0.3, j*0.21, j*0.13]      // spread grows with novelty
        af = vadapt_field_step(af, x, cfg)
        k = k + 1
    }
    return vadapt_field_cells(af)
}
fn birth_err(novelty: float, cfg: EngineConfig) -> float {
    let mut af = vadapt_field_new([0.0,0.0,0.0], 4096)
    let mut k = 0
    while k < 120 {
        let j = float(k) * novelty
        af = vadapt_field_step(af, [j*0.3, j*0.21, j*0.13], cfg)
        k = k + 1
    }
    return vadapt_field_recon_err(af, [10.0, 7.0, 4.0])
}

fn main() {
    println("=== H_6014 — 텐션으로 새 anima를 낳다 (external tension → mitosis birth) ===")
    let cfg = engine_config_default()

    // TB1 — birth-rate tracks external tension NOVELTY
    let none = birth(0.0, cfg)      // repetitive external tension → no birth
    let lo   = birth(0.3, cfg)
    let hi   = birth(1.0, cfg)
    let tracks = (hi > lo) && (lo > none) && (none <= 2)
    println("  "+(if tracks {"🟢"} else {"🔴"})+" TB1 birth-rate ∝ external tension novelty")
    println("        cells born: novelty0="+str(none)+" 0.3="+str(lo)+" 1.0="+str(hi))

    // TB2 — viability: a high-novelty stream BIRTHS a viable self-model (>= floor)
    let VIABLE = 20
    let viable = hi >= VIABLE
    println("  "+(if viable {"🟢"} else {"🔴"})+" TB2 born substrate is viable (cells >= "+str(VIABLE)+")")
    println("        high-novelty birth = "+str(hi)+" cells (a functioning anima body)")

    // TB3 — the born anima actually models its world (low recon-err = alive, not noise)
    let e_none = birth_err(0.0, cfg)
    let e_hi   = birth_err(1.0, cfg)
    let models = e_hi < e_none
    println("  "+(if models {"🟢"} else {"🔴"})+" TB3 born anima models its world (recon-err low)")
    println("        recon-err: no-birth="+_f4(e_none)+" born="+_f4(e_hi)+" (lower = coherent self-model)")

    println("=== H_6014 complete — external tension gives birth to anima (real engine) ===")
}
