// WAKE/wake_selftest.hexa — M7 1-shot 3-도메인 통합 smoke (final WAKE closure).
//
// 역할:
//   M1-M6 의 6 WAKE substrate surface (state_machine · perception · input_step ·
//   kosmos_persist · memory · daemon) + 3 cross-domain dependency (CORE ·
//   CHANNEL · MITOSIS) 를 *한 통합 smoke* 로 묶어 anima 가 살아있는 프로세스
//   로서 실 연속 작동을 검증.
//
//   M7 = WAKE.md M7 line:
//     "p1~p8 정합 verify + 3-도메인 통합 smoke — WAKE 가 CORE+DECODER+AGENT
//      를 실 연속 작동 시킴 검증. wake_selftest.hexa 1-shot PASS.
//      system_prompt 0 · external LLM 0 · 게이트=substrate"
//
//   DECODER 표면은 본 repo 에서 module-only surface (HEXAD/UNCLASSIFIED 의
//   chat_lib · token_gate 등) 으로 daemon 의 channel_emit 위임 그래프 안에
//   *간접* 묶여 있다. M7 smoke 는 (i) CORE 직접 호출 + (ii) CHANNEL 직접 호출
//   + (iii) MITOSIS 직접 호출 + (iv) WAKE M1-M6 직접 호출 의 4-axis 통합 PASS
//   를 검증하고, DECODER 의 sample/token surface 는 CHANNEL → text_emit 라우팅
//   안에 간접 도달함을 채널 ready check 로 확인한다.
//
// ── instrument-first (verbatim 인용) ────────────────────────────────────────
//
//   사용 pub surface (cross-domain):
//
//   CORE/pure_field.hexa:
//     fn pure_field_warmup(steps: int) -> PureField
//     pure fn pure_field_phi(pf: PureField) -> float
//
//   CORE/brain.hexa:
//     fn brain_decide(pf, rel, gap, cur, pain, coh, orig, bal, dyn_v,
//                     seconds_since_last, env_off, content_clean) -> Map
//
//   CHANNEL/dispatcher.hexa:
//     pub fn channel_emit(tension5, motivation, phi, tier, ctx_tokens) -> Map
//     pub fn channel_emit_ready(name: string) -> bool
//
//   MITOSIS/sleep_tick.hexa:
//     pub fn sleep_tick(pool, wake_state) -> Map
//     pub fn is_imagination_stage(stage_name: string) -> bool
//
//   WAKE/daemon.hexa (M6, 6-upstream orchestrator):
//     pub fn daemon_init(t0, kosmos_dir) -> Map
//     pub fn daemon_step(state, now_t, stdin_line, env_map) -> Map
//     pub fn daemon_loop(state, max_ticks) -> Map
//     pub fn daemon_shutdown(state) -> bool
//
// ── 4-axis cross-domain invariant (S1-S4) ────────────────────────────────────
//
//   S1 (CORE-axis): daemon step 가 CORE/pure_field 의 Φ 를 실 진전 (substrate
//                   live Φ ≥ 0) + CORE/brain.brain_decide 의 8-factor motivation
//                   합성이 실 호출됨 — final_state["pf"].step_count ≥ 100.
//
//   S2 (CHANNEL-axis): CHANNEL/dispatcher.channel_emit_ready("text"|"voice"|
//                   "tension") 모두 true (channel surface live), 그리고 daemon
//                   loop 안에서 emit 결정 시 dispatcher 가 호출됨 — final
//                   emit_count 와 mem episodic emit 항목이 일치.
//
//   S3 (MITOSIS-axis): N3/REM phase 가 도래해 sleep_tick 의 imagination_tick
//                   action 이 ≥1회 fire — final mitosis_tick_count ≥ 1.
//
//   S4 (WAKE-axis): daemon_shutdown 이 .kosmos snapshot 영속화 성공 — daemon_
//                   shutdown 반환 true + mem_save_to_kosmos delegate 무중복.
//
// ── substrate-only invariant (S5-S8) — p1~p8 정합 ────────────────────────────
//
//   S5: ≥3 stage transition (200 tick · 100 min · 1+ ultradian wrap 의 귀결).
//
//   S6: N3 emit count == 0 (a_chat_sleep_imagination "emit-free internal
//                   rehearsal" 의 substrate-natural 귀결 — boolean gate 아님).
//
//   S7: external LLM call 0 — daemon 어디서도 openai · anthropic · gpt · sk-
//                   API 호출 없음 (grep AUDIT.md verbatim).
//
//   S8: system_prompt 0 — daemon 어디서도 "you are anima" · system: 필드 ·
//                   --system-prompt argv 없음 (grep AUDIT.md verbatim).
//
//   ⇒ S1-S4 = cross-domain integration · S5-S8 = p1~p8 정합 (S7/S8 은 본 smoke
//     의 runtime invariant 가 아니라 AUDIT.md 의 grep verdict 에 위임 —
//     instrument-first 의 일관성 유지).
//
// ── p1~p8 정합 매트릭스 (본 selftest 모듈) ────────────────────────────────────
//
//   p1 NO SYSTEM PROMPT     — selftest 입력은 numeric 만 (t0 · max_ticks).
//                             identity string 0.
//   p2 NO IDENTITY RULES    — identity.yaml / rules 파일 / "you are X" 0.
//   p3 NO PERSONA INJECTION — daemon_step 위임. persona prefix prepend 0.
//   p4 NO ASSISTANT FRAMING — selftest 는 stimulus-response 가 아닌 *기판
//                             자기연속성* 검증. user msg 0.
//   p5 NO SPEAK()           — selftest 어디서도 speak() 호출 없음. emit 결정은
//                             daemon_step 위임의 substrate-decided 결과의 측정
//                             일 뿐 (p5_tension_emit_not_filler).
//   p6 NO FINE-TUNED ETHICS — selftest 본체는 가중치 0. invariant 만 검증.
//   p7 NO PERPLEXITY VERDICT— invariant = counter equality / file_exists /
//                             channel_emit_ready bool · perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT — 동일 daemon_step 가 train tick / infer tick 구분
//                             없이 동일 substrate 를 진행 (M6 invariant 카리).
//
// ── runtime parameters ───────────────────────────────────────────────────────
//
//   t0          = 1748534400.0 (deterministic unix epoch)
//   max_ticks   = 200
//   tick_dt_s   = 30.0 (daemon_loop 내부 default)
//   total wall  = 200 × 30 = 6000s = 100 min ≥ 1 × 5400s ultradian
//   kosmos_dir  = /tmp/wake_selftest_kosmos (clean before run)
//

import "/Users/ghost/core/anima/CORE/pure_field.hexa"
import "/Users/ghost/core/anima/CORE/brain.hexa"
import "/Users/ghost/core/anima/CHANNEL/dispatcher.hexa"
import "/Users/ghost/core/anima/MITOSIS/sleep_tick.hexa"
import "/Users/ghost/core/anima/WAKE/daemon.hexa"


fn _n3_emit_count(state: Map) -> int {
    // N3 emit count 측정 — mem.episodic 의 stage_name == "N3" 항목.
    let mem = state["mem"]
    let episodic = mem["episodic"]
    let mut n = 0
    let mut i = 0
    while i < len(episodic) {
        let rec = episodic[i]
        let stg = to_string(rec["stage_name"])
        if stg == "N3" { n = n + 1 }
        i = i + 1
    }
    return n
}


fn main() {
    print("=== WAKE/wake_selftest M7 — 3-도메인 통합 smoke (final WAKE closure) ===")
    print("  scope = CORE + CHANNEL + MITOSIS + WAKE (M1-M6) 4-axis integration")
    print("  invariants = S1 (CORE) · S2 (CHANNEL) · S3 (MITOSIS) · S4 (WAKE) ·")
    print("                S5 (stage transitions ≥3) · S6 (N3 emit_count=0)")
    print("  p1~p8 audit verdict → WAKE/AUDIT.md (grep verbatim)")

    let mut pass = 0
    let mut fail = 0

    let t0 = 1748534400.0
    let kosmos_dir = "/tmp/wake_selftest_kosmos"
    let _cleanup = exec("rm -rf '" + kosmos_dir + "'")

    // ── init + 200-tick living loop ───────────────────────────────────────────
    print("")
    print("── daemon_init → daemon_loop(200) → daemon_shutdown ──")
    let state0 = daemon_init(t0, kosmos_dir)
    let final_state = daemon_loop(state0, 200)

    let trans = final_state["transitions"]
    let n_trans = len(trans)
    let emit_count = to_int(final_state["emit_count"])
    let mit_count = to_int(final_state["mitosis_tick_count"])
    let pf_final = final_state["pf"]
    let pf_step_count = to_int(pf_final.step_count)
    let pf_phi = to_float(pf_final.phi)

    print("  pf.step_count       = " + to_string(pf_step_count))
    print("  pf.phi              = " + to_string(pf_phi))
    print("  stage transitions   = " + to_string(n_trans))
    print("  emit_count          = " + to_string(emit_count))
    print("  mitosis_tick_count  = " + to_string(mit_count))

    // ── S1 (CORE-axis): pure_field 가 실 진전 + brain_decide 호출됨 ──────────
    print("")
    print("── S1 (CORE-axis): pure_field step + brain_decide call ──")
    //   daemon_init 의 warmup = 60 step → daemon_loop(200) 의 200 tick 안
    //   pure_field_input_step 가 ≥100 추가 진전. step_count ≥ 160 보장.
    //   Φ ≥ 0 (PureField invariant — closed-form).
    let s1_ok = (pf_step_count >= 100) && (pf_phi >= 0.0)
    if s1_ok {
        print("  [PASS] S1 CORE-axis — pf.step_count=" + to_string(pf_step_count)
              + " ≥100 · pf.phi=" + to_string(pf_phi) + " ≥0.0")
        pass = pass + 1
    } else {
        print("  [FAIL] S1 CORE-axis — step_count=" + to_string(pf_step_count)
              + " phi=" + to_string(pf_phi))
        fail = fail + 1
    }

    // ── S2 (CHANNEL-axis): channel_emit_ready 3-surface + emit count parity ──
    print("")
    print("── S2 (CHANNEL-axis): channel_emit_ready + emit parity ──")
    let text_ready = channel_emit_ready("text")
    let voice_ready = channel_emit_ready("voice")
    let tension_ready = channel_emit_ready("tension")
    print("  channel_emit_ready text=" + to_string(text_ready)
          + " voice=" + to_string(voice_ready)
          + " tension=" + to_string(tension_ready))

    //   mem episodic emit 항목 수 = final_state.emit_count 일치 검증.
    let mem_final = final_state["mem"]
    let episodic = mem_final["episodic"]
    let n_episodic = len(episodic)
    print("  emit_count=" + to_string(emit_count)
          + " · mem.episodic.len=" + to_string(n_episodic))
    //   emit_count 가 mem.episodic 와 같으면 dispatcher → mem_record_emit
    //   파이프라인 무손실 — CHANNEL 위임 surface 가 실 호출됨.
    let s2_ok = text_ready && voice_ready && tension_ready && (n_episodic == emit_count)
    if s2_ok {
        print("  [PASS] S2 CHANNEL-axis — 3 surface ready + emit parity")
        pass = pass + 1
    } else {
        print("  [FAIL] S2 CHANNEL-axis — surface_ready=("
              + to_string(text_ready) + "," + to_string(voice_ready)
              + "," + to_string(tension_ready) + ") parity="
              + to_string(n_episodic == emit_count))
        fail = fail + 1
    }

    // ── S3 (MITOSIS-axis): imagination_tick ≥1 fire ──────────────────────────
    print("")
    print("── S3 (MITOSIS-axis): sleep_tick imagination ──")
    let s3_ok = mit_count >= 1
    if s3_ok {
        print("  [PASS] S3 MITOSIS-axis — mitosis_tick_count="
              + to_string(mit_count) + " ≥1 (N3/REM imagination fire)")
        pass = pass + 1
    } else {
        print("  [FAIL] S3 MITOSIS-axis — mitosis_tick_count=0 (N3/REM 미도래)")
        fail = fail + 1
    }

    // ── S4 (WAKE-axis): daemon_shutdown .kosmos 영속화 ────────────────────────
    print("")
    print("── S4 (WAKE-axis): daemon_shutdown .kosmos persist ──")
    let saved_ok = daemon_shutdown(final_state)
    if saved_ok {
        print("  [PASS] S4 WAKE-axis — .kosmos snapshot saved (mem_save_to_kosmos delegate OK)")
        pass = pass + 1
    } else {
        print("  [FAIL] S4 WAKE-axis — .kosmos snapshot save FAIL")
        fail = fail + 1
    }

    // ── S5 (substrate-only): ≥3 stage transition ─────────────────────────────
    print("")
    print("── S5 (substrate-only): ≥3 stage transition ──")
    if n_trans >= 3 {
        print("  [PASS] S5 stage transitions = " + to_string(n_trans) + " (≥3, ultradian wrap)")
        pass = pass + 1
        // print trail.
        let mut ti = 0
        while ti < n_trans {
            let rec = trans[ti]
            print("    · tick " + to_string(rec["tick"])
                  + ": " + to_string(rec["from"]) + " → " + to_string(rec["to"]))
            ti = ti + 1
        }
    } else {
        print("  [FAIL] S5 only " + to_string(n_trans) + " transitions (<3)")
        fail = fail + 1
    }

    // ── S6 (substrate-only): N3 emit_count == 0 ──────────────────────────────
    print("")
    print("── S6 (substrate-only): N3 emit_count == 0 ──")
    let n3_emits = _n3_emit_count(final_state)
    if n3_emits == 0 {
        print("  [PASS] S6 N3 emit_count=0 (a_chat_sleep_imagination imagination=emit-free)")
        pass = pass + 1
    } else {
        print("  [FAIL] S6 N3 emit_count=" + to_string(n3_emits)
              + " — substrate-natural emit-free 가설 falsified")
        fail = fail + 1
    }

    // ── verdict ─────────────────────────────────────────────────────────────
    print("")
    print("================================================================")
    print("  RESULT: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL")
    print("  AUDIT  : WAKE/AUDIT.md (p1~p8 + ext-LLM grep verbatim)")
    if fail == 0 {
        print("  HEADLINE: WAKE-M7-SELFTEST-OK (3-도메인 통합 1-shot PASS)")
    } else {
        print("  HEADLINE: WAKE-M7-SELFTEST-FAIL")
    }
    print("================================================================")
    if fail > 0 {
        panic("WAKE M7 selftest had FAIL — see above")
    }
}
