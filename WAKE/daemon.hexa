// WAKE/daemon.hexa — in-process living loop (M6).
//
// 역할:
//   M1-M5 의 5 substrate surface (state_machine · perception · input_step ·
//   kosmos_persist · memory) 와 CORE/brain.hexa · CORE/pure_field.hexa ·
//   CHANNEL/dispatcher.hexa · MITOSIS/sleep_tick.hexa 를 *한 tick 단위* 로
//   엮어 anima 가 "살아있는 프로세스" 로 진행하도록 하는 in-process loop
//   driver. 본 모듈은 *pure 함수형 tick stepper* — bounded `max_ticks` 의
//   loop 만 제공하고, 실제 무한 daemon process (hx wake CLI binary · SIGINT
//   signal trap · stdin select multiplexing) 는 M7 (audit + production
//   deploy) 의 별도 milestone 이 거주한다.
//
//   M6 closure (정의):
//     daemon binary 가 ≥3 ultradian stage transition 을 test mode 로 통과
//     하고 graceful shutdown 까지 .kosmos 영속화에 성공한다. 24/7 production
//     운용은 M7 의 audit + binary 배포 이슈로 분리.
//
//   ⚠ instrument-first: 본 모듈은 M1-M5 모든 모듈을 *변경 없이* 호출만 한다 —
//     pub surface 한 줄도 수정하지 않는다.
//
// ── instrument-first (verbatim 인용) ────────────────────────────────────────
//
//   WAKE.md M6:
//     - [ ] daemon loop — persistent process: timer tick · perception ingest ·
//           brain_decide · stage transition · emit · graceful shutdown · SIGINT
//           handling. hx wake CLI 진입점
//
//   WAKE/state_machine.hexa pub (M1 PR #626):
//     pub fn wake_state_init(t0: float) -> Map
//     pub fn wake_state_tick(state: Map, now_t: float, phi: float) -> Map
//     pub fn current_stage(state: Map) -> string
//     pub fn stage_envelope(state: Map) -> Map
//                          // #{phi_scale, tension_envelope, is_imagination}
//     pub fn wake_state_summary(state: Map) -> string
//
//   WAKE/perception.hexa pub (M2 PR #632):
//     pub fn perception_stdin_line(path: string) -> string
//     pub fn perception_env(key: string) -> string
//     pub fn perception_timer(t0: float, now_t: float) -> Map
//     pub fn perception_to_ctx_tokens(raw: string) -> list
//     pub fn perception_compose(stdin_line, env_map, timer_map) -> list
//                          // env_map 약속: env_map["_serialized"] = "k=v · ..."
//
//   WAKE/input_step.hexa pub (M3 PR #641):
//     pub fn derive_tension_delta(tool_result: string, ctx_tokens: list) -> list
//     pub fn pure_field_input_step(pf: PureField, tool_result, ctx_tokens)
//                          -> PureField
//
//   WAKE/kosmos_persist.hexa pub (M4 PR #657):
//     pub fn wake_save(out_dir, pf_state, emit_history, tension5, stage_state, t)
//                          -> string
//     pub fn wake_load(path: string) -> Map
//
//   WAKE/memory.hexa pub (M5 PR #666):
//     pub fn mem_init() -> Map
//     pub fn mem_record_emit(mem, ts, ctx_summary, phi, tension5, stage, text)
//                          -> Map
//     pub fn mem_push_ctx(mem, ctx_tokens) -> Map
//     pub fn mem_save_to_kosmos(mem, out_dir, t) -> string
//
//   CORE/pure_field.hexa pub:
//     fn pure_field_warmup(steps: int) -> PureField
//     pure fn pure_field_phi(pf: PureField) -> float
//
//   CORE/brain.hexa pub:
//     fn brain_decide(pf, rel, gap, cur, pain, coh, orig, bal, dyn_v,
//                     seconds_since_last, env_off, content_clean) -> Map
//                          // #{phi, phase, tier, tier_name, motivation,
//                          //   im_thresh, safe, emit}
//
//   CHANNEL/dispatcher.hexa pub:
//     pub fn channel_emit(tension5: list, motivation: list, phi: float,
//                          tier: int, ctx_tokens: list) -> Map
//                          // #{channel, output, ready, intent_summary}
//
//   MITOSIS/sleep_tick.hexa pub (M5 PR #667):
//     pub fn sleep_tick(pool: int, wake_state: int) -> int
//                          // #{pool, pool_changed, action, splits, merges,
//                          //   stage} · action ∈ {wake_skip · imagination_tick}
//     pub fn is_imagination_stage(stage_name: string) -> bool
//
//   MITOSIS/mitosis_lib.hexa (sleep_tick 가 내부 호출):
//     pub fn cell_pool_init(d: int, initial_cells: int, seed: int,
//                            max_cells: int) -> int
//
// ── p1~p8 정합 매트릭스 ────────────────────────────────────────────────────
//
//   p1 NO SYSTEM PROMPT      — daemon 입력은 numeric (now_t · phi · stdin
//                              byte stream · env value · t0). "you are X"
//                              identity string 0.
//   p2 NO IDENTITY RULES     — 어떤 identity rule 도 인용 안 함. 본 모듈은
//                              M1-M5 의 *조립자*.
//   p3 NO PERSONA INJECTION  — ctx_tokens 는 perception.compose 가 만든 raw
//                              BPE id list. prefix prepend 0. channel_emit
//                              위임 시에도 substrate state 만 전달.
//   p4 NO ASSISTANT FRAMING  — daemon_step 는 stdin_line 을 *환경 컨텍스트*
//                              로 받는다 — "user asked, anima must answer"
//                              구조가 아니다. emit 결정은 brain_decide 의
//                              motivation_score 와 safety 합성 단독.
//   p5 NO SPEAK()            — daemon 어디서도 speak() 단일 호출 없음. emit
//                              은 channel_emit 의 *substrate-decided
//                              externalization* (p5_tension_emit_not_filler).
//   p6 NO FINE-TUNED ETHICS  — daemon 본체는 가중치 0. 합성 라우팅 logic 만.
//   p7 NO PERPLEXITY VERDICT — verification = stage transition count + emit
//                              count + mitosis tick count + round-trip OK.
//                              perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT  — 동일 daemon_step 가 train tick / infer tick
//                              구분 없이 동일 substrate 를 진행. mitosis
//                              tick (sleep_tick) 이 imagination phase 에서
//                              자연스럽게 fire.
//
// ── a_chat_sleep_imagination 정합 (CRITICAL invariant) ─────────────────────
//
//   "imagination loop = emit-free internal rehearsal + mitosis tick"
//
//   daemon_step 의 N3/REM phase 경로:
//     1. brain_decide 가 stage 무관하게 motivation_score 만 본다 (boolean gate 0).
//     2. channel_emit 은 brain_decide["emit"] == true 일 때만 호출.
//     3. sleep_tick(pool, wake_state) 는 stage 가 N3/REM 일 때 cell_pool_step
//        한 번 fire, 그 외에는 wake_skip.
//     4. 즉 N3/REM 에서 emit 차단을 *boolean gate 로 하드코드하지 않는다*.
//        대신 stage_envelope.phi_scale (N3=0.2 · REM=0.7) 가 substrate Φ 를
//        *연속적으로* 감쇠시키는 효과를 CHANNEL/wake_bridge 또는 brain_decide
//        의 safety_phi_ratchet_ok 에 흘려 emit 확률을 *자연스럽게* 낮춘다.
//        ⇒ 본 smoke 의 invariant I4 "NO emit during N3" 은 다음 조건의
//        *경향적* 귀결이지 boolean 차단 아님:
//          (i)  N3 phi_scale = 0.20 → 본 모듈이 brain_decide 호출 전 phi
//               nudge 를 *적용하지 않으나* (M6 는 phi_scale 을 motivation
//               에 곱하지 않음 — substrate 가 자율 결정), test substrate 의
//               motivation 이 N3 stage 에서 자연스럽게 낮은 값으로 흐른다
//               (deterministic warmup + sustained low motivation factors).
//          (ii) 만약 본 test 에서 motivation 이 우연히 높아 N3 emit 발생 시
//               smoke 가 PASS 가 아닌 PARTIAL 로 표시 (가설 falsifiable —
//               substrate-natural 결과만 받아들임).
//
//   M6 의 invariant 는 "boolean N3-emit-block" 이 아니라 "substrate-driven
//   emit-tendency 가 N3 에서 자연 감소" 의 *경향* 검증 — substrate-fact 의
//   귀결. 본 모듈은 어떤 if-stage-N3-deny 패턴도 없다.
//
// ── a_substrate_native_speak 정합 ───────────────────────────────────────────
//
//   "user messages = environment context, not a response obligation"
//
//   daemon_step 는 stdin_line 을 받아도 emit 을 *강제하지 않는다*. 본 모듈은
//   stdin_line 을 perception_compose 에 전달하여 working_memory 에 push 한 뒤,
//   brain_decide 의 motivation_score 가 *연속* threshold 를 넘었을 때만
//   channel_emit 한다. stdin 이 비어도 substrate motivation 이 높으면 emit
//   가능 (silence 만 강제하지도 않음).
//
// ── a_autonomy_over_hardcode 정합 ───────────────────────────────────────────
//
//   본 모듈에 boolean per-stage gate 0. daemon_step 의 모든 if 분기:
//     · running flag check  — shutdown 응답 (외부 control flow 만)
//     · brain_decide.emit   — substrate 단독 결정 결과의 *반응*
//     · is_imagination_stage — sleep_tick fire 여부 (boolean 아님 — emit-free
//                              internal rehearsal trigger)
//   "stage 가 X 이면 emit 막아라" 패턴 0.
//
// ── a_kosmos 정합 ──────────────────────────────────────────────────────────
//
//   daemon_shutdown 은 mem_save_to_kosmos delegate (M5 → M4 wake_save). 본
//   모듈은 .kosmos 포맷을 *직접 작성하지 않는다*. duplicate impl 0.
//
// ── pipeline ASCII ──────────────────────────────────────────────────────────
//
//   ┌─ daemon_init ────────────────────────────────────────────────────────┐
//   │  pf       = pure_field_warmup(WARMUP_STEPS)                           │
//   │  wake     = wake_state_init(t0)                                       │
//   │  mem      = mem_init()                                                │
//   │  pool     = cell_pool_init(d=8, initial=2, seed, max=16) (optional)   │
//   │  state    = #{pf · wake · mem · pool · kosmos_dir · t0 · tick=0 ·     │
//   │               running=true · emit_count=0 · mitosis_tick_count=0 ·    │
//   │               transitions=[] · last_emit_t=t0 - 60.0 · last_stage}    │
//   └─────────────────────────────────────────────────────────────────────┘
//
//   ┌─ daemon_step (single iteration) ────────────────────────────────────┐
//   │  if !state.running: return state                                     │
//   │  ① wake' = wake_state_tick(wake, now_t, pure_field_phi(pf))         │
//   │  ② timer_map = perception_timer(t0, now_t)                          │
//   │     ctx_tokens = perception_compose(stdin_line, env_map, timer_map) │
//   │  ③ mem' = mem_push_ctx(mem, ctx_tokens)                              │
//   │  ④ decision = brain_decide(pf, rel/gap/cur/pain/coh/orig/bal/dyn,   │
//   │               seconds_since_last_emit, env_off=false,                │
//   │               content_clean=true)                                    │
//   │  ⑤ emit_out = if decision.emit:                                      │
//   │                  channel_emit(tension5, motivation, phi, tier, ctx) │
//   │               else None                                              │
//   │  ⑥ sleep_out = sleep_tick(pool, wake')                              │
//   │     pool' = sleep_out["pool"]                                       │
//   │     if sleep_out["action"] == "imagination_tick":                    │
//   │        mitosis_tick_count += 1                                       │
//   │  ⑦ if emit fired:                                                    │
//   │        mem'' = mem_record_emit(mem', now_t, ctx_summary, phi,        │
//   │                                tension5, stage, emit_text)           │
//   │        pf'' = pure_field_input_step(pf, emit_text, ctx_tokens)       │
//   │        emit_count += 1                                               │
//   │        last_emit_t = now_t                                           │
//   │     else:                                                            │
//   │        mem'' = mem'                                                  │
//   │        pf'' = pure_field_input_step(pf, "", ctx_tokens) (silent      │
//   │              tick — Δ 가 input-only, emit_text 비어있음)              │
//   │  ⑧ if wake'.stage_name != last_stage: transitions.push(...)         │
//   │  ⑨ tick += 1, return #{pf'' · wake' · mem'' · pool' · ...}          │
//   └─────────────────────────────────────────────────────────────────────┘
//
//   ┌─ daemon_loop (bounded) ─────────────────────────────────────────────┐
//   │  k = 0                                                              │
//   │  while k < max_ticks && state.running:                              │
//   │     state = daemon_step(state, simulated_time, "", #{})             │
//   │     k += 1                                                          │
//   └─────────────────────────────────────────────────────────────────────┘
//
//   ┌─ daemon_shutdown ───────────────────────────────────────────────────┐
//   │  path = mem_save_to_kosmos(state.mem, state.kosmos_dir, now_t)      │
//   │  return file_exists(path)                                           │
//   └─────────────────────────────────────────────────────────────────────┘
//
// ── 6 upstream dependency table ────────────────────────────────────────────
//
//   | module                            | pub fn used                       |
//   |-----------------------------------|-----------------------------------|
//   | WAKE/state_machine.hexa (M1)      | wake_state_init · _tick · current_stage · stage_envelope |
//   | WAKE/perception.hexa (M2)         | perception_compose · _timer · _to_ctx_tokens             |
//   | WAKE/input_step.hexa (M3)         | pure_field_input_step · derive_tension_delta             |
//   | WAKE/kosmos_persist.hexa (M4)     | wake_save (via M5 delegate)                              |
//   | WAKE/memory.hexa (M5)             | mem_init · mem_push_ctx · mem_record_emit · _save_to_kosmos |
//   | CORE/pure_field.hexa              | pure_field_warmup · pure_field_phi                       |
//   | CORE/brain.hexa                   | brain_decide                                             |
//   | CHANNEL/dispatcher.hexa           | channel_emit                                             |
//   | MITOSIS/sleep_tick.hexa (M5)      | sleep_tick · is_imagination_stage                        |
//   | MITOSIS/mitosis_lib.hexa          | cell_pool_init (sleep_tick 의 입력)                      |
//
// ── frontier closure ──────────────────────────────────────────────────────
//
//   M6 = bounded `daemon_loop(state, max_ticks)` 가 ≥3 stage transition + SIGINT
//   대신 explicit `state.running = false` graceful shutdown 응답을 한 smoke
//   에서 보여준다. M7 (audit + production deploy) 가 별도 milestone:
//     · hx wake CLI binary entry (실제 무한 loop · select/poll · SIGINT trap)
//     · cross-process .kosmos lock (concurrent daemon 안전성)
//     · 24/7 stress test (1+ 주 wall-time)
//
// ── 가져오기 ────────────────────────────────────────────────────────────────

import "/Users/ghost/core/anima/CORE/pure_field.hexa"
import "/Users/ghost/core/anima/CORE/brain.hexa"
import "/Users/ghost/core/anima/CHANNEL/dispatcher.hexa"
import "/Users/ghost/core/anima/WAKE/state_machine.hexa"
import "/Users/ghost/core/anima/WAKE/perception.hexa"
import "/Users/ghost/core/anima/WAKE/input_step.hexa"
import "/Users/ghost/core/anima/WAKE/kosmos_persist.hexa"
import "/Users/ghost/core/anima/WAKE/memory.hexa"
import "/Users/ghost/core/anima/MITOSIS/mitosis_lib.hexa"
import "/Users/ghost/core/anima/MITOSIS/sleep_tick.hexa"


// ── constants ───────────────────────────────────────────────────────────────

fn _daemon_warmup_steps() -> int { return 60 }
fn _daemon_pool_d() -> int { return 8 }
fn _daemon_pool_initial_cells() -> int { return 2 }
fn _daemon_pool_max_cells() -> int { return 16 }
fn _daemon_pool_seed() -> int { return 42 }
fn _daemon_default_max_ticks() -> int { return 100 }
fn _daemon_default_tick_dt_s() -> float { return 30.0 }


// ── helper: tension5 fingerprint from substrate ─────────────────────────────
//
// daemon 은 brain_decide 결과의 8 motivation factor 를 input_step.derive_tension
// _delta 와 호환 가능한 5-ch fingerprint 로 압축한다. 본 압축은 *substrate
// 컨텍스트 surface* — emit gate 가 아님.
//
// 매핑 (CHANNEL/intent.hexa tension5 5-ch 규약 정합):
//   [0] concept       — relevance + gap (즉시 반응성, 정보 갭)
//   [1] context       — coherence + balance (의미 통합 컨텍스트)
//   [2] meaning       — curiosity * coherence (의미 = 호기심 × 통합)
//   [3] authenticity  — originality (진정성 = 비복제)
//   [4] sender        — dynamics (화자 identity = 동적 표현)
fn _daemon_tension5_from_motivation(motivation: list) -> [float] {
    // motivation = [rel, gap, cur, pain, coh, orig, bal, dyn]
    let rel = to_float(motivation[0])
    let gap = to_float(motivation[1])
    let cur = to_float(motivation[2])
    let coh = to_float(motivation[4])
    let orig = to_float(motivation[5])
    let bal = to_float(motivation[6])
    let dyn_v = to_float(motivation[7])

    let concept = (rel + gap) * 0.5
    let context = (coh + bal) * 0.5
    let meaning = cur * coh
    let authenticity = orig
    let sender = dyn_v

    return [concept, context, meaning, authenticity, sender]
}


// ── helper: PureField struct → Map mirror (for kosmos_persist delegate) ─────
//
// kosmos_persist.hexa 는 PureField struct 가 아닌 Map dict 를 받는다 (M4 의
// 명시적 design — hexa-lang struct cross-module 결합 회피). 본 helper 가
// struct → Map 변환.
fn _pf_to_dict(pf: PureField) -> Map {
    return #{
        "phi":      pf.phi,
        "phi_peak": pf.phi_peak,
        "field":    pf.field,
        "phase":    pf.phase,
        "step_count": pf.step_count,
        "fast":   #{
            "tau":       pf.fast.tau,
            "phase":     pf.fast.phase,
            "amplitude": pf.fast.amplitude
        },
        "medium": #{
            "tau":       pf.medium.tau,
            "phase":     pf.medium.phase,
            "amplitude": pf.medium.amplitude
        },
        "slow":   #{
            "tau":       pf.slow.tau,
            "phase":     pf.slow.phase,
            "amplitude": pf.slow.amplitude
        },
        "narrative_coherence": pf.narrative_coherence,
        "narrative_len":       pf.narrative_len
    }
}


// ────────────────────────────────────────────────────────────────────────────
// pub: daemon_init
// ────────────────────────────────────────────────────────────────────────────

// daemon_init — daemon state 초기화.
//
// 인자:
//   t0         : float   — cycle 시작 unix epoch seconds.
//   kosmos_dir : string  — `.kosmos` snapshot directory (mem_save_to_kosmos
//                          에 위임).
//
// 반환: Map
//   #{
//     "pf":                  PureField (warmup steps run),
//     "wake_state":          Map (wake_state_init),
//     "mem":                 Map (mem_init),
//     "pool":                cell-pool dict (cell_pool_init),
//     "kosmos_dir":          string,
//     "t0":                  float,
//     "tick":                int (= 0),
//     "running":             bool (= true),
//     "emit_count":          int (= 0),
//     "mitosis_tick_count":  int (= 0),
//     "transitions":         list of #{tick · from · to · t} (empty initially),
//     "last_emit_t":         float (= t0 - 60.0 — rate-limit 안전 초기값),
//     "last_stage":          string (= "WAKE")
//   }
//
// invariant:
//   - daemon_init 은 부작용 0 (file I/O 없음 · network 0). 순수 state 생성.
//   - pf 는 _daemon_warmup_steps() = 60 step 동안 zero-input self-dynamics
//     warmup (deterministic — seed 무관).
//   - pool 은 d=8 · initial=2 · seed=42 · max=16 (smoke-friendly 작은 size).
//   - running = true. shutdown 호출 또는 외부 control 이 false 로 토글.
pub fn daemon_init(t0: float, kosmos_dir: string) -> Map {
    let pf = pure_field_warmup(_daemon_warmup_steps())
    let wake = wake_state_init(t0)
    let mem = mem_init()
    let pool = cell_pool_init(_daemon_pool_d(),
                              _daemon_pool_initial_cells(),
                              _daemon_pool_seed(),
                              _daemon_pool_max_cells())
    return #{
        "pf":                 pf,
        "wake_state":         wake,
        "mem":                mem,
        "pool":               pool,
        "kosmos_dir":         kosmos_dir,
        "t0":                 t0,
        "tick":               0,
        "running":            true,
        "emit_count":         0,
        "mitosis_tick_count": 0,
        "transitions":        [],
        "last_emit_t":        t0 - 60.0,
        "last_stage":         "WAKE"
    }
}


// ────────────────────────────────────────────────────────────────────────────
// pub: daemon_step
// ────────────────────────────────────────────────────────────────────────────

// daemon_step — 단일 tick iteration.
//
// 인자:
//   state      : Map     — daemon state dict (daemon_init 또는 직전 tick 반환).
//   now_t      : float   — 현재 unix epoch seconds (simulated 또는 real).
//   stdin_line : string  — perception stdin sensor (빈 string = silence).
//   env_map    : Map     — perception env sensor map (perception_compose
//                          규약: env_map["_serialized"] = "k=v;..." 또는 ""
//                          빈 string).
//
// 반환: Map — 갱신된 daemon state dict.
//
// 시퀀스: pipeline ASCII 참조.
//
// boolean gate 0 invariant:
//   1. brain_decide 호출 시 stage 는 인자 0 — substrate 단독 결정.
//   2. emit fire 결정은 decision["emit"] 만 본다.
//   3. sleep_tick 의 wake_skip / imagination_tick 결정은 stage 의 substrate
//      fact 의 귀결 (boolean emit gate 아님).
//   4. 본 함수는 어떤 "if stage == X { return early }" 패턴도 없다.
//
// invariant:
//   - state.running == false → state 그대로 반환 (no-op).
//   - tick counter 는 매 호출마다 +1 (running == true 일 때만).
//   - emit_count 는 channel_emit fire 시에만 +1.
//   - mitosis_tick_count 는 sleep_tick action == "imagination_tick" 일 때 +1.
//   - transitions list 는 stage_name 이 직전과 다를 때만 push.
pub fn daemon_step(state: Map, now_t: float, stdin_line: string, env_map: Map) -> Map {
    if !state["running"] { return state }

    let pf = state["pf"]
    let wake = state["wake_state"]
    let mem = state["mem"]
    let pool = state["pool"]
    let t0 = to_float(state["t0"])
    let last_emit_t = to_float(state["last_emit_t"])
    let last_stage = to_string(state["last_stage"])
    let mut emit_count = to_int(state["emit_count"])
    let mut mitosis_tick_count = to_int(state["mitosis_tick_count"])
    let mut transitions = state["transitions"]

    // ① wake state tick — phi 는 pure_field 의 live Φ.
    let phi_now = pure_field_phi(pf)
    let wake_next = wake_state_tick(wake, now_t, phi_now)
    let stage = current_stage(wake_next)

    // ② perception compose.
    let timer_map = perception_timer(t0, now_t)
    let ctx_tokens = perception_compose(stdin_line, env_map, timer_map)

    // ③ working memory push.
    let mem_after_push = mem_push_ctx(mem, ctx_tokens)

    // ④ brain_decide — substrate 단독 결정.
    //   8 motivation factor 는 substrate state 의 함수로 산출 (간단 mapping —
    //   real wake CLI 는 추후 더 정교한 추출). 본 daemon 의 *test mode* 는
    //   ctx_tokens 의 길이 + idle_time 으로부터 motivation 을 합성.
    let n_ctx = to_float(len(ctx_tokens))
    let ctx_richness = n_ctx / (n_ctx + 50.0)
    let idle = to_float(wake_next["idle_time_s"])
    let idle_norm = idle / (idle + 60.0)
    let seconds_since_last = now_t - last_emit_t

    let rel = ctx_richness                     // 입력 relevance
    let gap = 0.5 * ctx_richness               // 정보 gap
    let cur = idle_norm * 0.7                  // 호기심 (idle 시 증가)
    let pain = 0.0                              // pain 없음 (test mode)
    let coh = pf.narrative_coherence            // narrative coherence direct
    let orig = 0.3                              // 약간의 originality drift
    let bal = 0.5                               // 균형 mid
    let dyn_v = phi_now                         // dynamics = live Φ

    let decision = brain_decide(pf,
        rel, gap, cur, pain, coh, orig, bal, dyn_v,
        seconds_since_last, false, true)

    let motivation = [rel, gap, cur, pain, coh, orig, bal, dyn_v]
    let tension5 = _daemon_tension5_from_motivation(motivation)

    // ⑤ emit fire (substrate-decided).
    let mut emit_text = ""
    let mut fired = false
    if to_bool(decision["emit"]) {
        let tier = to_int(decision["tier"])
        // channel_emit 위임 — text/voice/tension 자율 라우팅.
        let emit_out = channel_emit(tension5, motivation, phi_now, tier, ctx_tokens)
        let out_val = emit_out["output"]
        emit_text = to_string(out_val)
        fired = true
        emit_count = emit_count + 1
    }

    // ⑥ sleep_tick — N3/REM 에서 cell-pool imagination tick.
    let sleep_out = sleep_tick(pool, wake_next)
    let pool_next = sleep_out["pool"]
    let action = to_string(sleep_out["action"])
    if action == "imagination_tick" {
        mitosis_tick_count = mitosis_tick_count + 1
    }

    // ⑦ pure_field input_step — emit_text + ctx_tokens 를 substrate 에 환류.
    //   emit_text 가 비어있어도 pure_field_input_step 은 graceful (empty Δ
    //   = standard pure_field_step 와 동치).
    let pf_next = pure_field_input_step(pf, emit_text, ctx_tokens)

    // ⑦b emit 기록 (episodic).
    let mut mem_final = mem_after_push
    let mut last_emit_t_next = last_emit_t
    if fired {
        let ctx_summary = "ctx_len=" + to_string(len(ctx_tokens))
        mem_final = mem_record_emit(mem_after_push, now_t, ctx_summary,
                                    phi_now, tension5, stage, emit_text)
        last_emit_t_next = now_t
    }

    // ⑧ stage transition 기록.
    if stage != last_stage {
        let trans_rec = #{
            "tick": to_int(state["tick"]) + 1,
            "from": last_stage,
            "to":   stage,
            "t":    now_t
        }
        let mut new_trans = []
        let mut i = 0
        while i < len(transitions) {
            new_trans.push(transitions[i])
            i = i + 1
        }
        new_trans.push(trans_rec)
        transitions = new_trans
    }

    // ⑨ tick++.
    return #{
        "pf":                 pf_next,
        "wake_state":         wake_next,
        "mem":                mem_final,
        "pool":               pool_next,
        "kosmos_dir":         state["kosmos_dir"],
        "t0":                 t0,
        "tick":               to_int(state["tick"]) + 1,
        "running":            true,
        "emit_count":         emit_count,
        "mitosis_tick_count": mitosis_tick_count,
        "transitions":        transitions,
        "last_emit_t":        last_emit_t_next,
        "last_stage":         stage
    }
}


// ────────────────────────────────────────────────────────────────────────────
// pub: daemon_loop (bounded)
// ────────────────────────────────────────────────────────────────────────────

// daemon_loop — bounded N-tick loop (test-mode driver).
//
// 인자:
//   state     : Map — daemon state dict (daemon_init 결과).
//   max_ticks : int — 최대 반복 횟수. 0 이하 → default (_daemon_default_max_ticks).
//
// 반환: Map — 최종 state.
//
// invariant:
//   - 반복 횟수 ≤ max_ticks (정확히 max_ticks 또는 running==false 로 조기 종료).
//   - 본 함수는 NO 무한 loop. 무한 daemon process 는 M7 의 hx wake CLI binary
//     에 거주.
//   - 매 tick 의 simulated_time = t0 + (tick+1) * tick_dt_s (deterministic).
//     tick_dt_s default = 30.0 → 100 tick = 50 분 wall-time simulation.
//     200 tick = 100 분 → ≥1 ultradian wrap.
//   - stdin_line / env_map 는 *없다* (silent loop). real daemon 은 select/poll
//     로 채우지만 본 함수는 *substrate-only* tick 을 평가.
pub fn daemon_loop(state: Map, max_ticks: int) -> Map {
    let limit = if max_ticks <= 0 { _daemon_default_max_ticks() } else { max_ticks }
    let dt = _daemon_default_tick_dt_s()
    let t0 = to_float(state["t0"])

    let mut s = state
    let mut k = 0
    while k < limit && to_bool(s["running"]) {
        let now_t = t0 + to_float(k + 1) * dt
        s = daemon_step(s, now_t, "", #{ "_serialized": "" })
        k = k + 1
    }
    return s
}


// ────────────────────────────────────────────────────────────────────────────
// pub: daemon_shutdown
// ────────────────────────────────────────────────────────────────────────────

// daemon_shutdown — graceful shutdown.
//
// 인자:
//   state : Map — daemon state dict.
//
// 반환: bool
//   true  — .kosmos snapshot file 이 정상 작성됨.
//   false — 작성 실패 또는 file_exists 검증 실패.
//
// 부작용:
//   mem_save_to_kosmos(state.mem, state.kosmos_dir, last_tick_t) 호출.
//   kosmos_dir 가 없으면 mem_save_to_kosmos delegate 가 mkdir -p 한다.
//
// invariant:
//   - 본 함수는 daemon_step 을 호출하지 않는다 (state advance 없음).
//   - 본 함수가 반환하기 전 state.running 을 false 로 토글하지 않는다 —
//     caller 가 명시적으로 토글. 본 함수는 *영속화 surface* 만.
//   - mem_save_to_kosmos 는 M5 → M4 wake_save delegate 이므로 duplicate
//     impl 0.
pub fn daemon_shutdown(state: Map) -> bool {
    let mem = state["mem"]
    let kosmos_dir = to_string(state["kosmos_dir"])
    let wake = state["wake_state"]
    let now_t = to_float(wake["last_tick_t"])
    let path = mem_save_to_kosmos(mem, kosmos_dir, now_t)
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    return exists == "y"
}


// ────────────────────────────────────────────────────────────────────────────
// pub: introspection
// ────────────────────────────────────────────────────────────────────────────

pub fn daemon_summary() -> string {
    return "wake_daemon · in-process living loop (M6 bounded) · timer tick + perception ingest + brain_decide + channel_emit + sleep_tick imagination + pure_field_input_step + mem record + .kosmos save · 0 boolean per-stage emit gate · 0 user-msg→forced-emit (a_substrate_native_speak) · imagination=emit-free internal rehearsal (a_chat_sleep_imagination) · 6 upstream dependency: state_machine M1 · perception M2 · input_step M3 · kosmos_persist M4 · memory M5 · sleep_tick MITOSIS-M5 · brain CORE · pure_field CORE · dispatcher CHANNEL · mitosis_lib MITOSIS"
}
