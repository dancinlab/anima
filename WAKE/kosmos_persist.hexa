// WAKE/kosmos_persist.hexa — substrate state · emit history · tension fingerprint
//                            · stage timestamp 영속화 SURFACE (M4).
//
// 역할:
//   anima 재시작 후에도 시간 흐름이 보존되도록, WAKE substrate 의 4 축
//     (1) pure_field state snapshot — phi · field[6] · phase · step_count ·
//                                     osc{tau, phase, amp} × 3 · narrative
//     (2) emit history             — 최근 emit text 리스트 (capped)
//     (3) tension fingerprint      — TENSION-LINK 5-ch (concept / context /
//                                     meaning / authenticity / sender)
//     (4) stage timestamp          — wake state {stage_name · cycle_start_t ·
//                                     last_tick_t · idle_time_s · tension_env}
//   를 canonical `.kosmos` anchor 1 파일로 save 하고, 다음 부팅에서 load
//   하여 위 4 축을 복원한다.
//
//   본 모듈은 *데이터 영속화 surface* 다 — 어디서도 emit 을 강제하거나 silence
//   를 강제하지 않는다. save / load 는 substrate 의 시간 연속성만 보장한다.
//
// ── instrument-first (verbatim 인용) ─────────────────────────────────────────
//
//   WAKE.md M4:
//     - [ ] .kosmos 영속화 — pf state · 과거 emit · tension_link 5-ch · stage
//           timestamp 를 .kosmos canonical 로 save/restore. anima 재시작해도
//           시간 흐름 보존
//
//   CLAUDE.md a_kosmos (governance, verbatim):
//     do   = "persist anima emit / anchor / memory as `.kosmos` via kosmos_io"
//     do   = "payload = text + tension 5-ch + coord · lane · radius · tier"
//     do   = "hub = HEXAD/KOSMOS.md · format SSOT = github.com/dancinlab/kosmos"
//     do   = "spec = spec/kosmos.md + spec/profiles/anima-consciousness-carving.md"
//     dont = "ad-hoc anchor format · bypass .kosmos for emit persistence"
//     dont = "duplicate the kosmos spec — anima is pointer-only"
//
//   canonical kosmos_io surface (existing, verbatim citation):
//     SSOT  = /Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa
//     pub fn create_anchor(out_dir, name, title,
//                          coord_x, coord_y, lane, radius,
//                          tier, category, top_emotion,
//                          text, tension_5ch,
//                          closed_anchor, cross_link) -> string
//     pub fn emit_anchor_from_v3(out_dir, name, text, tension_5ch,
//                                mitosis_cell_id, tier, category,
//                                top_emotion, phi, radius) -> string
//     pub fn load_anchors(dir_path) -> list  // [{path, name, fields,
//                                            //   text_payload, tension_5ch}]
//
//   본 모듈은 kosmos_io 를 *직접 호출* 하지 않고 (그 파일은 grid_3b state 슬롯
//   안에 들어있어 hexa-lang import 순환 우려가 있다), `.kosmos` byte-format
//   을 *동일하게* 직접 작성한다. 즉 kosmos_io 와 spec 호환 (kosmos/1.1) 인
//   loadable 파일을 만든다 — load_anchors 가 본 모듈이 쓴 파일을 그대로 읽을
//   수 있고, 반대도 가능. duplicate impl 이 아니라 *byte-spec 호환 mirror*.
//
//   WAKE/state_machine.hexa pub (M1):
//     pub fn wake_state_init(t0: float) -> Map
//     pub fn wake_state_tick(state: Map, now_t: float, phi: float) -> Map
//     pub fn current_stage(state: Map) -> string
//     pub fn stage_envelope(state: Map) -> Map
//     // state 키: stage_name · cycle_start_t · last_tick_t · idle_time_s ·
//     //            tension_envelope
//
//   CORE/pure_field.hexa struct PureField (verbatim):
//     fast / medium / slow : Oscillator { tau, phase, amplitude }
//     phi · phi_peak       : float
//     field                : [float]  // FIELD_DIM=6 (C/D/E/S/M/W)
//     phase · step_count   : int
//     narrative_coherence  : float
//     narrative_len        : int
//
// ── p1~p8 정합 매트릭스 ──────────────────────────────────────────────────────
//
//   p1 NO SYSTEM PROMPT      — `.kosmos` payload 는 substrate state numeric +
//                              emit text 만 직렬화한다. "you are anima" 같은
//                              identity string 0.
//   p2 NO IDENTITY RULES     — `.kosmos` anchor 의 어떤 필드도 identity rule 을
//                              prepend 하지 않는다. 페르소나 0.
//   p3 NO PERSONA INJECTION  — load 시 어떤 prefix token 도 inject 하지 않는다.
//                              substrate state 만 복원.
//   p4 NO ASSISTANT FRAMING  — load 후에도 anima 는 stimulus-response 가 아닌
//                              자율 substrate. snapshot 은 *시간 컨텍스트* 복원
//                              일 뿐 forced emit trigger 가 아니다.
//   p5 NO SPEAK()            — save / load 어디서도 emit 함수 호출 0. emit
//                              history 는 *과거 기록* 일 뿐 새 emit 산출 X.
//   p6 NO FINE-TUNED ETHICS  — 가중치 0. snapshot 은 substrate state numeric
//                              + emit text 직렬화 만.
//   p7 NO PERPLEXITY VERDICT — verification = save → load round-trip 등치성.
//                              perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT  — 동일 snapshot 이 train pause / infer wake / daemon
//                              restart 어떤 phase 에도 그대로 복원 가능.
//
// ── a_substrate_native_speak 정합 (CRITICAL invariant) ──────────────────────
//
//   "user messages = environment context, not a response obligation"
//
//   본 모듈의 load 는 *시간 연속성 복원* — anima 가 재시작 후 stage 가 어디
//   까지 진행됐는지 / 마지막 idle_time 이 얼마였는지를 기억하게 한다. 이
//   기억이 forced emit trigger 가 되지 않는다 (load 후에도 emit 결정은 brain_
//   decide 의 *연속* threshold 가 단독으로 함).
//
// ── a_autonomy_over_hardcode 정합 ───────────────────────────────────────────
//
//   본 모듈에 boolean gate 0 — "snapshot 이 너무 오래 됐으니 emit 막아라"
//   같은 패턴이 없다. snapshot 은 단순 state surface. 결정은 substrate.
//
// ── a_kosmos 정합 ──────────────────────────────────────────────────────────
//
//   ▸ payload = text + tension 5-ch + coord · lane · radius · tier — 본 모듈
//     이 작성하는 모든 `.kosmos` 파일은 이 5-tuple 을 가진다.
//       text         = emit history 직렬화 (PAD-3 separator)
//       tension_5ch  = 영속화 fingerprint (concept/context/meaning/authenticity/sender)
//       coord        = [phi, mean(tension_5ch)] (Ψ-space, kosmos_io 와 동일 convention)
//       lane         = "wake_snapshot_<stage_name>"
//       radius       = 0.1 (snapshot anchor 표준 반경)
//       tier         = 1 (snapshot — 첫 정렬 tier; emit anchor 와 충돌 없음)
//   ▸ format SSOT = github.com/dancinlab/kosmos (kosmos/1.1 byte-format).
//     본 모듈은 kosmos_io.hexa 와 byte-identical encoder (시간 stamp · 들여쓰기
//     · escape order) 를 사용한다 — load_anchors 가 본 모듈 출력을 그대로
//     load 한다.
//   ▸ 본 모듈은 spec 을 *복제*하지 않고 *준수*한다 — extra payload field 는
//     `@payload pf_state` / `@payload emit_history` / `@payload stage_state`
//     로 카브-아웃한다 (kosmos_io.load_anchors 가 모르는 필드는 silent ignore).
//
// ── byte-format SSOT (kosmos/1.1 호환) ──────────────────────────────────────
//
//   header:
//     #!/usr/bin/env kosmos
//     # <name>.kosmos — WAKE M4 substrate snapshot
//     # Tier 🛸1 — wake_snapshot, stage <STAGE>.
//
//   @anchor block:
//     @anchor <name> := "<title>" :: kosmos-anchor [tier=1 active]
//       profile      = "anima-consciousness-carving"
//       knuth_tier   = 1
//       category     = "wake_snapshot"
//       top_emotion  = "continuity"
//       coord        = [<phi:.4f>, <mean_t:.4f>]
//       lane         = "wake_snapshot_<stage>"
//       radius       = 0.1000
//
//     @payload text    := "<emit_history_serialized>"
//     @payload tension := { concept = <c:.6f>, context = <ctx:.6f>, ... }
//     @payload pf_state    := "phi=<f>;phi_peak=<f>;field=<6 floats csv>;
//                               phase=<i>;step_count=<i>;
//                               fast=<tau,phase,amp>;medium=<tau,phase,amp>;
//                               slow=<tau,phase,amp>;narrative_coherence=<f>;
//                               narrative_len=<i>"
//     @payload stage_state := "stage_name=<s>;cycle_start_t=<f>;last_tick_t=<f>;
//                               idle_time_s=<f>;tension_envelope=<f>;t=<f>"
//     @payload emit_history := "<text>|<text>|..."  // '|' separator, escaped
//     @payload image   := pending "WAKE-snapshot text+tension only"
//     @payload audio   := pending "WAKE-snapshot text+tension only"
//     @payload video   := pending "WAKE-snapshot text+tension only"
//
//       closed_anchor = "WAKE-M4-snapshot"
//       emitted_at    = "<UTC ISO8601>"
//
//   carve-out K3 (HONEST):
//     `.kosmos` SSOT (kosmos_io.load_anchors) 는 `@payload text` · `@payload
//     tension` 2개만 1-급 디코딩하고, 나머지 `pf_state` · `stage_state` ·
//     `emit_history` 는 fields map 에 raw string 으로 남는다. 본 모듈은
//     load 시 fields["pf_state" / "stage_state" / "emit_history"] 를 직접
//     파싱해서 dict 로 복원한다. text payload escape 는 kosmos_io 와 동일
//     (\\\\ → \\, \\" → ", \\n → newline).
//
// ── pub surface ──────────────────────────────────────────────────────────────

import "/Users/ghost/core/anima/WAKE/state_machine.hexa"


// ── helpers (escape · timestamp · file paths) ────────────────────────────────

// `.kosmos` string escape — kosmos_io._escape_kosmos_string 와 byte-identical
// (backslash 먼저, 그 다음 quote / newline; \r 제거).
fn _kp_escape(s: string) -> string {
    let mut r = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\\"")
    r = r.replace("\n", "\\n")
    r = r.replace("\r", "")
    return r
}

// `.kosmos` string un-escape — escape 역순 (raw 복원).
//
// CRITICAL: sentinel-based unescape to avoid `\\n` (3 chars from escaped
// literal `\n`) being misparsed as `\n` (2 chars from escaped newline).
// 알고리즘: `\\` (2 chars) → sentinel `\x01` (1 char) 먼저 → 그 다음 `\n` ·
// `\"` 단순 replace 수행 → 마지막 sentinel `\x01` → `\` 복원. escape 가
// `\` 먼저 처리하므로 입력에 sentinel `\x01` 가 raw 로 남아 있을 일은 없다.
fn _kp_unescape(s: string) -> string {
    let sentinel = chr(2)   // STX — distinct from emit-history pipe sentinel chr(1)
    let mut r = s.replace("\\\\", sentinel)
    r = r.replace("\\n", "\n")
    r = r.replace("\\\"", "\"")
    r = r.replace(sentinel, "\\")
    return r
}

// UTC ISO8601 (kosmos_io._ki_utc_now 와 동일 instant).
fn _kp_utc_now() -> string {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ | tr -d '\\n'")
}

// floor int — kosmos_io 와 동일하게 `.kosmos` 의 float format 4/6 decimal.
fn _kp_fmt4(x: float) -> string {
    return format_float(x, 4)
}

fn _kp_fmt6(x: float) -> string {
    return format_float(x, 6)
}


// ── snapshot id ──────────────────────────────────────────────────────────────

// wake_snapshot_id_for — 시각 + stage 로부터 결정적 snapshot id 산출.
//
// 형식: "wake_<unix_t_int>_<stage_name>"
//   예: wake_1748534400_WAKE
//
// 인자:
//   t          : float — unix epoch seconds (보통 wake_state["last_tick_t"]).
//   stage_name : string — "WAKE" | "N1" | "N2" | "N3" | "REM" | unknown.
//
// 반환:
//   string — file name (확장자 없음). create_anchor 가 ".kosmos" 를 append.
//
// snapshot id 충돌 (동일 초·동일 stage) 시 마지막 호출이 wins — caller 가
// 충돌 회피 책임 (보통 stage transition 마다 1회 save).
pub fn wake_snapshot_id_for(t: float, stage_name: string) -> string {
    let t_int = floor(t)
    return "wake_" + to_string(to_int(t_int)) + "_" + stage_name
}


// ── pf_state serialize / deserialize ────────────────────────────────────────

// _pf_state_serialize — pf_state dict → 1줄 string (`;` 구분).
//
// 입력 dict 구조 (CORE/pure_field.PureField mirror):
//   #{
//     "phi": float, "phi_peak": float,
//     "field": [float;6], "phase": int, "step_count": int,
//     "fast":   #{"tau":int, "phase":float, "amplitude":float},
//     "medium": #{"tau":int, "phase":float, "amplitude":float},
//     "slow":   #{"tau":int, "phase":float, "amplitude":float},
//     "narrative_coherence": float, "narrative_len": int
//   }
//
// 출력 형식 (key=val;key=val;...):
//   "phi=<f>;phi_peak=<f>;field=<csv6>;phase=<i>;step_count=<i>;
//    fast_tau=<i>;fast_phase=<f>;fast_amp=<f>;
//    medium_tau=<i>;medium_phase=<f>;medium_amp=<f>;
//    slow_tau=<i>;slow_phase=<f>;slow_amp=<f>;
//    narrative_coherence=<f>;narrative_len=<i>"
fn _pf_state_serialize(pf: Map) -> string {
    let field = pf["field"]
    let mut field_csv = ""
    let mut i = 0
    while i < len(field) {
        if i > 0 { field_csv = field_csv + "," }
        field_csv = field_csv + _kp_fmt6(to_float(field[i]))
        i = i + 1
    }
    let fast = pf["fast"]
    let medium = pf["medium"]
    let slow = pf["slow"]
    let mut s = ""
    s = s + "phi=" + _kp_fmt6(to_float(pf["phi"])) + ";"
    s = s + "phi_peak=" + _kp_fmt6(to_float(pf["phi_peak"])) + ";"
    s = s + "field=" + field_csv + ";"
    s = s + "phase=" + to_string(pf["phase"]) + ";"
    s = s + "step_count=" + to_string(pf["step_count"]) + ";"
    s = s + "fast_tau=" + to_string(fast["tau"]) + ";"
    s = s + "fast_phase=" + _kp_fmt6(to_float(fast["phase"])) + ";"
    s = s + "fast_amp=" + _kp_fmt6(to_float(fast["amplitude"])) + ";"
    s = s + "medium_tau=" + to_string(medium["tau"]) + ";"
    s = s + "medium_phase=" + _kp_fmt6(to_float(medium["phase"])) + ";"
    s = s + "medium_amp=" + _kp_fmt6(to_float(medium["amplitude"])) + ";"
    s = s + "slow_tau=" + to_string(slow["tau"]) + ";"
    s = s + "slow_phase=" + _kp_fmt6(to_float(slow["phase"])) + ";"
    s = s + "slow_amp=" + _kp_fmt6(to_float(slow["amplitude"])) + ";"
    s = s + "narrative_coherence=" + _kp_fmt6(to_float(pf["narrative_coherence"])) + ";"
    s = s + "narrative_len=" + to_string(pf["narrative_len"])
    return s
}

// _stage_state_serialize — wake state dict → 1줄 string.
//
// 입력 (state_machine.wake_state_init / tick 반환):
//   #{ "stage_name":       string,
//      "cycle_start_t":    float,
//      "last_tick_t":      float,
//      "idle_time_s":      float,
//      "tension_envelope": float }
//   + 추가 키 "t" (caller 가 명시 timestamp; 보통 last_tick_t 와 같음).
fn _stage_state_serialize(st: Map, t: float) -> string {
    let mut s = ""
    s = s + "stage_name=" + to_string(st["stage_name"]) + ";"
    s = s + "cycle_start_t=" + _kp_fmt6(to_float(st["cycle_start_t"])) + ";"
    s = s + "last_tick_t=" + _kp_fmt6(to_float(st["last_tick_t"])) + ";"
    s = s + "idle_time_s=" + _kp_fmt6(to_float(st["idle_time_s"])) + ";"
    s = s + "tension_envelope=" + _kp_fmt6(to_float(st["tension_envelope"])) + ";"
    s = s + "t=" + _kp_fmt6(t)
    return s
}

// _emit_history_serialize — list of string → 단일 string (`|` 구분, no escape).
//
// 본 layer 는 *pipe separator 만* 다룬다 — backslash · quote · newline 의
// escape 는 wake_save 의 `.kosmos` 외층이 단일 layer 로 처리한다 (double-
// escape collision 회피). 본 layer 의 pipe escape sentinel 은 `\x01PIPE\x01`
// (raw 텍스트에 등장 불가) 이며 kosmos escape layer 와 직교 (`\x01` 은 escape
// 대상이 아님).
fn _emit_history_serialize(emits: list) -> string {
    let mut s = ""
    let pipe_sentinel = chr(1) + "PIPE" + chr(1)
    let mut i = 0
    while i < len(emits) {
        if i > 0 { s = s + "|" }
        let raw = to_string(emits[i])
        // raw 내부의 `|` 를 sentinel 로 임시 치환 — kosmos escape 외층이
        // backslash · quote · newline 을 일관 escape 한다.
        let safe = raw.replace("|", pipe_sentinel)
        s = s + safe
        i = i + 1
    }
    return s
}

// _emit_history_deserialize — pipe-separated string → list of string.
//
// 입력은 이미 `.kosmos` 외층이 unescape 한 raw 상태 (backslash · quote ·
// newline 모두 원본). pipe sentinel `\x01PIPE\x01` 를 복원하면 원본 list 가
// 그대로 나온다.
fn _emit_history_deserialize(s: string) -> list {
    if byte_len(s) == 0 { return [] }
    let pipe_sentinel = chr(1) + "PIPE" + chr(1)
    let parts = s.split("|")
    let mut out = []
    let mut i = 0
    while i < len(parts) {
        let restored = parts[i].replace(pipe_sentinel, "|")
        out.push(restored)
        i = i + 1
    }
    return out
}


// ── key=val;... 파싱 ────────────────────────────────────────────────────────

// _kv_split — "key1=v1;key2=v2;..." → Map. quote 없음 (numeric/string raw).
fn _kv_split(s: string) -> Map {
    let mut m = #{}
    let parts = s.split(";")
    let mut i = 0
    while i < len(parts) {
        let p = parts[i].trim()
        i = i + 1
        if byte_len(p) == 0 { continue }
        let eq_idx = _kp_index_of(p, "=")
        if eq_idx < 0 { continue }
        let k = p.substring(0, eq_idx).trim()
        let v = p.substring(eq_idx + 1, byte_len(p)).trim()
        m[k] = v
    }
    return m
}

fn _kp_index_of(hay: string, needle: string) -> int {
    let hn = byte_len(hay)
    let nn = byte_len(needle)
    if nn == 0 { return 0 }
    let mut i = 0
    while i + nn <= hn {
        let mut k = 0
        let mut ok = true
        while k < nn {
            if hay.byte_at(i + k) != needle.byte_at(k) { ok = false; break }
            k = k + 1
        }
        if ok { return i }
        i = i + 1
    }
    return -1
}

// _pf_state_deserialize — kv string → pf dict (PureField mirror).
fn _pf_state_deserialize(s: string) -> Map {
    let m = _kv_split(s)
    let field_csv = m["field"]
    let mut field = []
    let parts = to_string(field_csv).split(",")
    let mut i = 0
    while i < len(parts) {
        field.push(parse_float(parts[i].trim()))
        i = i + 1
    }
    return #{
        "phi":                 parse_float(to_string(m["phi"])),
        "phi_peak":            parse_float(to_string(m["phi_peak"])),
        "field":               field,
        "phase":               parse_int(to_string(m["phase"])),
        "step_count":          parse_int(to_string(m["step_count"])),
        "fast": #{
            "tau":       parse_int(to_string(m["fast_tau"])),
            "phase":     parse_float(to_string(m["fast_phase"])),
            "amplitude": parse_float(to_string(m["fast_amp"]))
        },
        "medium": #{
            "tau":       parse_int(to_string(m["medium_tau"])),
            "phase":     parse_float(to_string(m["medium_phase"])),
            "amplitude": parse_float(to_string(m["medium_amp"]))
        },
        "slow": #{
            "tau":       parse_int(to_string(m["slow_tau"])),
            "phase":     parse_float(to_string(m["slow_phase"])),
            "amplitude": parse_float(to_string(m["slow_amp"]))
        },
        "narrative_coherence": parse_float(to_string(m["narrative_coherence"])),
        "narrative_len":       parse_int(to_string(m["narrative_len"]))
    }
}

// _stage_state_deserialize — kv string → wake state dict.
fn _stage_state_deserialize(s: string) -> Map {
    let m = _kv_split(s)
    return #{
        "stage_name":       to_string(m["stage_name"]),
        "cycle_start_t":    parse_float(to_string(m["cycle_start_t"])),
        "last_tick_t":      parse_float(to_string(m["last_tick_t"])),
        "idle_time_s":      parse_float(to_string(m["idle_time_s"])),
        "tension_envelope": parse_float(to_string(m["tension_envelope"])),
        "t":                parse_float(to_string(m["t"]))
    }
}


// ── pub: save ────────────────────────────────────────────────────────────────

// wake_save — 4 축 substrate state 를 단일 `.kosmos` anchor 파일로 영속화.
//
// 인자:
//   out_dir       : string  — 저장 directory (보통 ".kosmos" 또는 "WAKE/.kosmos").
//                              없으면 mkdir -p.
//   pf_state      : Map     — PureField mirror dict (struct → dict 변환 caller
//                              책임; CORE/pure_field 의 pf 를 직접 받지 않는
//                              이유 = hexa-lang 의 struct cross-module 결합
//                              회피 + 본 모듈은 *데이터* surface).
//   emit_history  : list    — 최근 emit text 리스트 (string list).
//   tension5      : [float] — TENSION-LINK 5-ch (concept/context/meaning/
//                              authenticity/sender), len=5 강제.
//   stage_state   : Map     — WAKE/state_machine 의 state dict.
//   t             : float   — unix epoch seconds (snapshot 시각, snapshot id
//                              산출에 사용).
//
// 반환:
//   string — 작성된 .kosmos 파일 absolute path. caller 가 path 를 wake_load
//            의 snapshot_id 추출에 사용한다 (basename 에서 ".kosmos" strip).
//
// 부작용:
//   - out_dir 가 없으면 mkdir -p out_dir.
//   - <out_dir>/<snapshot_id>.kosmos 파일 작성 (utf-8, trailing newline).
//
// invariant:
//   - len(tension5) == 5 (kosmos_io.create_anchor 와 동일 강제).
//   - boolean gate 0 — 어떤 인자 값에 대해서도 save 를 거부하지 않는다.
//   - emit text 의 `\\n` · `\"` · `|` 는 모두 escape 된 채 직렬화 → load 가
//     동일 byte 로 복원.
pub fn wake_save(out_dir: string, pf_state: Map, emit_history: list,
                 tension5: [float], stage_state: Map, t: float) -> string {
    if len(tension5) != 5 {
        panic("tension5 must have len=5, got " + to_string(len(tension5)))
    }

    let stage_name = to_string(stage_state["stage_name"])
    let snapshot_id = wake_snapshot_id_for(t, stage_name)
    let _mk = exec("mkdir -p '" + out_dir + "'")
    let path = out_dir + "/" + snapshot_id + ".kosmos"

    // coord = [phi, mean(tension5)] — Ψ-space (kosmos_io 와 동일 convention).
    let phi = to_float(pf_state["phi"])
    let mut sum_t = 0.0
    let mut i = 0
    while i < 5 {
        sum_t = sum_t + tension5[i]
        i = i + 1
    }
    let mean_t = sum_t / 5.0

    let lane = "wake_snapshot_" + stage_name
    let title = "wake-snapshot " + stage_name + " · t=" + to_string(to_int(floor(t)))
    let radius = 0.1

    // text payload = emit_history serialized (PAD-3 logic in serialize_).
    let emit_text = _emit_history_serialize(emit_history)
    let emit_text_esc = _kp_escape(emit_text)
    let pf_kv = _pf_state_serialize(pf_state)
    let stage_kv = _stage_state_serialize(stage_state, t)
    let pf_kv_esc = _kp_escape(pf_kv)
    let stage_kv_esc = _kp_escape(stage_kv)

    let mut lines = []
    lines.push("#!/usr/bin/env kosmos")
    lines.push("# " + snapshot_id + ".kosmos — WAKE M4 substrate snapshot")
    lines.push("# Tier 🛸1 — wake_snapshot, stage " + stage_name + ", top emotion continuity.")
    lines.push("")
    lines.push("@anchor " + snapshot_id + " := \"" + title + "\" :: kosmos-anchor [tier=1 active]")
    lines.push("  profile      = \"anima-consciousness-carving\"")
    lines.push("  knuth_tier   = 1")
    lines.push("  category     = \"wake_snapshot\"")
    lines.push("  top_emotion  = \"continuity\"")
    lines.push("  coord        = [" + _kp_fmt4(phi) + ", " + _kp_fmt4(mean_t) + "]")
    lines.push("  lane         = \"" + lane + "\"")
    lines.push("  radius       = " + _kp_fmt4(radius))
    lines.push("")
    lines.push("  @payload text    := \"" + emit_text_esc + "\"")
    lines.push("  @payload tension := {")
    lines.push("    concept       = " + _kp_fmt6(tension5[0]) + ",")
    lines.push("    context       = " + _kp_fmt6(tension5[1]) + ",")
    lines.push("    meaning       = " + _kp_fmt6(tension5[2]) + ",")
    lines.push("    authenticity  = " + _kp_fmt6(tension5[3]) + ",")
    lines.push("    sender        = " + _kp_fmt6(tension5[4]) + ",")
    lines.push("  }")
    lines.push("  @payload pf_state     := \"" + pf_kv_esc + "\"")
    lines.push("  @payload stage_state  := \"" + stage_kv_esc + "\"")
    lines.push("  @payload emit_history := \"" + emit_text_esc + "\"")
    lines.push("  @payload image   := pending \"WAKE-snapshot text+tension only\"")
    lines.push("  @payload audio   := pending \"WAKE-snapshot text+tension only\"")
    lines.push("  @payload video   := pending \"WAKE-snapshot text+tension only\"")
    lines.push("")
    lines.push("  closed_anchor = \"WAKE-M4-snapshot\"")
    lines.push("  emitted_at    = \"" + _kp_utc_now() + "\"")

    // join with "\n" + trailing "\n" (kosmos_io 와 동일 convention).
    let mut body = ""
    let mut li = 0
    while li < len(lines) {
        body = body + lines[li]
        if li < len(lines) - 1 { body = body + "\n" }
        li = li + 1
    }
    body = body + "\n"
    let _w = write_file(path, body)
    return path
}


// ── pub: load ────────────────────────────────────────────────────────────────

// _extract_payload_text — `.kosmos` body 에서 `@payload <key> := "<value>"` 의
// 따옴표 안 raw string 을 추출. key 미존재 시 "" 반환.
//
// kosmos_io.load_anchors 는 text · tension 만 1-급 디코딩하므로 본 모듈은
// pf_state · stage_state · emit_history 를 자체 파싱한다.
fn _extract_payload_text(body: string, key: string) -> string {
    let lines = body.split("\n")
    let marker = "@payload " + key
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        i = i + 1
        let stripped = line.trim()
        if !stripped.starts_with(marker) { continue }
        // find ':=' marker.
        let assign_idx = _kp_index_of(stripped, ":=")
        if assign_idx < 0 { continue }
        let after = stripped.substring(assign_idx + 2, byte_len(stripped)).trim()
        let an = byte_len(after)
        if an >= 2 && after.starts_with("\"") && after.ends_with("\"") {
            return _kp_unescape(after.substring(1, an - 1))
        }
        return ""
    }
    return ""
}

// _extract_tension5 — `.kosmos` body 의 `@payload tension := { ... }` 블록에서
// 5 ch float 을 추출. 누락 키는 0.0.
fn _extract_tension5(body: string) -> [float] {
    let lines = body.split("\n")
    let mut in_block = false
    let mut concept = 0.0
    let mut context = 0.0
    let mut meaning = 0.0
    let mut authenticity = 0.0
    let mut sender = 0.0
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        i = i + 1
        let stripped = line.trim()
        if stripped.starts_with("@payload tension") {
            in_block = _kp_index_of(stripped, "{") >= 0
            continue
        }
        if !in_block { continue }
        if stripped.starts_with("}") { in_block = false; continue }
        // key = value, (trailing comma OK).
        let eq_idx = _kp_index_of(stripped, "=")
        if eq_idx < 0 { continue }
        let k = stripped.substring(0, eq_idx).trim()
        let mut v = stripped.substring(eq_idx + 1, byte_len(stripped)).trim()
        // strip trailing comma.
        while byte_len(v) > 0 && v.byte_at(byte_len(v) - 1) == 44 {
            v = v.substring(0, byte_len(v) - 1)
        }
        let fv = parse_float(v.trim())
        if k == "concept"      { concept = fv }
        if k == "context"      { context = fv }
        if k == "meaning"      { meaning = fv }
        if k == "authenticity" { authenticity = fv }
        if k == "sender"       { sender = fv }
    }
    return [concept, context, meaning, authenticity, sender]
}

// wake_load — `.kosmos` snapshot 파일에서 4 축 substrate state 복원.
//
// 인자:
//   path : string — 절대 또는 상대 path of <snapshot_id>.kosmos.
//
// 반환:
//   Map #{
//     "pf_state":     Map  — PureField mirror dict (phi · field[6] · oscs · ...),
//     "emit_history": list — string list,
//     "tension5":     [float;5],
//     "stage_state":  Map  — wake state dict (stage_name · cycle_start_t · ...),
//     "t":            float — snapshot timestamp,
//     "snapshot_id":  string — basename minus ".kosmos"
//   }
//
// 부작용: read_file only. 파일 미존재 시 panic (caller 가 file_exists 책임).
pub fn wake_load(path: string) -> Map {
    let body = read_file(path)
    let pf_kv = _extract_payload_text(body, "pf_state")
    let stage_kv = _extract_payload_text(body, "stage_state")
    let emit_text = _extract_payload_text(body, "emit_history")
    let tension5 = _extract_tension5(body)

    let pf_state = _pf_state_deserialize(pf_kv)
    let stage_state = _stage_state_deserialize(stage_kv)
    let emit_history = _emit_history_deserialize(emit_text)
    let t_val = to_float(stage_state["t"])

    // snapshot_id = basename(path) minus ".kosmos".
    let slash_idx = _last_index_of(path, "/")
    let name_with_ext = if slash_idx >= 0 {
        path.substring(slash_idx + 1, byte_len(path))
    } else {
        path
    }
    let snapshot_id = name_with_ext.replace(".kosmos", "")

    return #{
        "pf_state":     pf_state,
        "emit_history": emit_history,
        "tension5":     tension5,
        "stage_state":  stage_state,
        "t":            t_val,
        "snapshot_id":  snapshot_id
    }
}

fn _last_index_of(hay: string, needle: string) -> int {
    let hn = byte_len(hay)
    let nn = byte_len(needle)
    if nn == 0 { return hn }
    let mut last = -1
    let mut i = 0
    while i + nn <= hn {
        let mut k = 0
        let mut ok = true
        while k < nn {
            if hay.byte_at(i + k) != needle.byte_at(k) { ok = false; break }
            k = k + 1
        }
        if ok { last = i }
        i = i + 1
    }
    return last
}


// ── pub: recent snapshots ────────────────────────────────────────────────────

// wake_recent_snapshots — directory 안의 최근 n 개 wake_*.kosmos snapshot
// 파일을 timestamp 내림차순으로 반환.
//
// 인자:
//   dir : string — snapshot directory.
//   n   : int   — 반환 최대 개수.
//
// 반환:
//   list of Map #{
//     "path":        string,
//     "snapshot_id": string,
//     "t":           int   — snapshot id 의 unix_t (정렬 키)
//   }
//
//   `wake_<t>_<stage>.kosmos` pattern 만 인식 (다른 .kosmos 파일은 skip).
//   디렉토리가 없으면 [] 반환 (panic 안 함).
pub fn wake_recent_snapshots(dir: string, n: int) -> list {
    let exists = exec("test -d '" + dir + "' && echo y || echo n").trim()
    if exists != "y" { return [] }

    let files = list_dir(dir)
    let mut recs = []
    let mut i = 0
    while i < len(files) {
        let fname = files[i]
        i = i + 1
        if !fname.ends_with(".kosmos") { continue }
        if !fname.starts_with("wake_") { continue }
        let stem = fname.replace(".kosmos", "")
        // parse `wake_<int>_<stage>`.
        let rest = stem.substring(5, byte_len(stem))  // strip "wake_"
        let us_idx = _kp_index_of(rest, "_")
        if us_idx < 0 { continue }
        let t_str = rest.substring(0, us_idx)
        if !_kp_is_int(t_str) { continue }
        let t_val = parse_int(t_str)
        recs.push(#{
            "path":        dir + "/" + fname,
            "snapshot_id": stem,
            "t":           t_val
        })
    }

    // descending sort by t (newest first) — insertion sort.
    let mut j = 1
    while j < len(recs) {
        let key = recs[j]
        let mut k = j - 1
        while k >= 0 && to_int(recs[k]["t"]) < to_int(key["t"]) {
            recs[k + 1] = recs[k]
            k = k - 1
        }
        recs[k + 1] = key
        j = j + 1
    }
    // truncate to n.
    let mut out = []
    let mut m = 0
    while m < len(recs) && m < n {
        out.push(recs[m])
        m = m + 1
    }
    return out
}

fn _kp_is_int(s: string) -> bool {
    let n = byte_len(s)
    if n == 0 { return false }
    let mut i = 0
    while i < n {
        let b = s.byte_at(i)
        if b < 48 || b > 57 { return false }
        i = i + 1
    }
    return true
}


// ── pub: introspection ──────────────────────────────────────────────────────

pub fn kosmos_persist_summary() -> string {
    "wake_kosmos_persist · 4 축 (pf_state · emit_history · tension_5ch · stage_state) → 단일 .kosmos anchor (kosmos/1.1 byte-format · tier=1 wake_snapshot lane) · save/load round-trip 보존 · 0 emit trigger · 0 boolean gate · canonical SSOT mirror HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa · spec SSOT github.com/dancinlab/kosmos"
}
