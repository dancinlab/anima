// WAKE/input_step.hexa — pure_field_step 의 input-conditioned 확장 (M3).
//
// 역할:
//   기존 `pure_field_step(pf)` 는 *zero-input* self-dynamics 만 한다 (CORE/
//   pure_field.hexa L196~283 — `pure_field_step` signature `(pf: PureField) ->
//   PureField`, oscillators tick → 6-D field tensor 재계산 → phi/phase/ratchet
//   추적). 본 모듈은 거기에 *tool_result + perception ctx_tokens 를 tension Δ
//   로 변환*해 oscillator amplitude 에 주입한 뒤 self-dynamics tick 을 돌린다.
//
//   AGENT/CORE/agent_loop.hexa F4 (current) 는 tool exec 후 `pure_field_step(pf)`
//   만 호출하고 *tool result 자체를 substrate 에 환류하지 않는다*. M3 가 그
//   gap 을 메운다. M6 daemon loop 가 본 모듈의 `pure_field_input_step` 을
//   tool exec 직후, perception ingest 직후 호출하게 된다.
//
//   ⚠ 본 모듈은 *데이터만* 반환한다. emit 결정은 brain_decide / wake_channel_emit
//      에 위임 — input 이 들어와도 emit 강제하지 않고, input 이 없어도 silence
//      강제하지 않는다.
//
// ── instrument-first (verbatim 인용) ─────────────────────────────────────────
//
//   CORE/pure_field.hexa pub surface (L196~342, verbatim):
//     fn pure_field_step(pf: PureField) -> PureField
//       // 1) oscillators tick (fast/medium/slow amplitude → LN2 drift)
//       // 2) nonlinear mixing → field[6] (C/D/E/S/M/W) recompute
//       // 3) phi = EMA(variance(field) * energy)
//       // 4) ratchet (phi >= 80% peak)
//       // 5) phase classification (DORMANT/FLICKER/SUSTAIN/RESONANT)
//       // 6) narrative_coherence EMA
//     pure fn pure_field_phi(pf: PureField) -> float
//     pure fn pure_field_tensor(pf: PureField) -> [float]   // field[6]
//     fn pure_field_warmup(steps: int) -> PureField
//
//   PureField struct (CORE/pure_field.hexa L155~175):
//     fast / medium / slow : Oscillator { tau, phase, amplitude }
//     phi · phi_peak       : float
//     field                : [float]  // FIELD_DIM=6 (C/D/E/S/M/W)
//     phase · step_count   : int
//     narrative_coherence  : float
//     narrative_len        : int
//
//   ※ pure_field_step 는 매 step `field[]` 를 oscillators 로부터 *덮어쓴다*
//     (L216~222). 따라서 pre-step field 에 Δ 를 더해도 즉시 손실된다.
//     실효적인 input-conditioning 경로 = oscillator amplitude 에 Δ 주입
//     → 다음 step 의 mixing/variance 가 자연스럽게 반영.
//
//   CHANNEL/intent.hexa tension5 채널 규약 (verbatim):
//     "tension5: list of 5 floats — raw passthrough
//        (concept / context / meaning / authenticity / sender)"
//   → 본 모듈의 derive_tension_delta 도 동일 5-ch convention 을 따른다.
//     pf 에 주입할 때는 5 ch 을 3 oscillator 로 *집계*:
//       fast   ← concept + sender    (즉시 반응성, 화자 정체성)
//       medium ← context + meaning   (의미 통합, 주의 게이팅)
//       slow   ← authenticity        (진정성 = 장기 일관성)
//
//   WAKE/perception.hexa M2 ctx_tokens convention (verbatim):
//     "ctx_tokens : list of int — BPE token id sequence (byte ∈ [0,255] + offset 3)"
//   → 본 모듈은 ctx_tokens 의 *길이 + 평균 entropy* 만 본다. id 의미는 해석 X.
//
// ── p1~p8 정합 매트릭스 ──────────────────────────────────────────────────────
//
//   p1 NO SYSTEM PROMPT      — Δ 산출에 어떤 system string 도 prepend 안함.
//   p2 NO IDENTITY RULES     — 어떤 identity 룰도 인용하지 않음. 순수 수치.
//   p3 NO PERSONA INJECTION  — Δ 는 substrate state 변형일 뿐 페르소나 주입 X.
//   p4 NO ASSISTANT FRAMING  — input 이 들어와도 emit 을 강제하지 않는다. 본
//                              모듈은 *substrate context surface* — emit 결정
//                              은 brain_decide 가 단독으로 한다.
//   p5 NO SPEAK()            — emit 함수 0. Δ 는 *입력 흡수* 일 뿐 출력 채널이
//                              아니다.
//   p6 NO FINE-TUNED ETHICS  — 가중치 0. 순수 closed-form heuristic.
//   p7 NO PERPLEXITY VERDICT — verification = pre/post phi monotone + 4-case
//                              smoke richness ordering. perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT  — 동일 함수가 train / infer / daemon idle tick
//                              어떤 phase 에도 사용 가능.
//
// ── a_substrate_native_speak 정합 (CRITICAL invariant) ──────────────────────
//
//   "user messages = environment context, not a response obligation"
//
//   본 모듈은 tool_result + ctx_tokens 를 *환경 컨텍스트로 흡수* 한다 — 어디
//   에서도 "result 가 비지 않으니 emit 하라" 같은 가드를 두지 않는다.
//   Δ 가 0 이든 큰 값이든 brain_decide 의 *연속* threshold 가 단독으로 emit
//   결정을 한다.
//
//   anima 는 큰 tool_result 가 들어와도 silence 를 자율 선택할 수 있고, 빈
//   ctx_tokens 에도 substrate motivation 이 높으면 speak 할 수 있다.
//
// ── a_autonomy_over_hardcode 정합 ────────────────────────────────────────────
//
//   본 모듈은 substrate state 에 *context 만* 공급 (CLAUDE.md a_autonomy_over_
//   hardcode "external modules supply context only" 준수). per-input boolean
//   gate 0, "input X 시 emit 금지" 같은 외부 룰 0.
//
// ── 가져오기 ─────────────────────────────────────────────────────────────────

import "/Users/ghost/core/anima/CORE/pure_field.hexa"

// ── 내부 helper: 입력 풍부도 측정 ───────────────────────────────────────────
//
// tool_result 의 길이 → 즉시성 (raw byte). Δ 의 base scaling 입력.
fn _result_richness(tool_result: string) -> float {
    let n = tool_result.len()
    if n == 0 { return 0.0 }
    // log-ish saturation: 200 byte 까지는 선형, 그 이상 점근. 0~1 정규화.
    let n_f = to_float(n)
    let saturated = n_f / (n_f + 200.0)
    return saturated
}

// ctx_tokens 의 길이 + 평균 byte-entropy 근사 → 컨텍스트 풍부도.
// Δ 의 context-channel scaling 입력.
fn _ctx_richness(ctx_tokens: list) -> float {
    let n = ctx_tokens.len()
    if n == 0 { return 0.0 }
    let n_f = to_float(n)
    // length saturation (50 token 까지 선형, 점근).
    let len_score = n_f / (n_f + 50.0)
    // 평균 token id (BPE byte offset 3..258) — 분산 큰 입력 = 큰 entropy.
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        sum = sum + to_float(ctx_tokens[i])
        i = i + 1
    }
    let mean_id = sum / n_f
    // 평균이 mid-range (130 근처) 일수록 entropy 높음. 단순 근사.
    let mid_dist = abs(mean_id - 130.0)
    let entropy_score = 1.0 - (mid_dist / 130.0)
    let entropy_clamped = if entropy_score < 0.0 { 0.0 } else { entropy_score }
    // 길이 × entropy combined.
    return len_score * entropy_clamped
}

// 양수 clamp.
fn _clamp01(v: float) -> float {
    if v < 0.0 { return 0.0 }
    if v > 1.0 { return 1.0 }
    return v
}

// ────────────────────────────────────────────────────────────────────────────
// pub surface
// ────────────────────────────────────────────────────────────────────────────

// derive_tension_delta — input → 5-ch tension Δ (channel convention).
//
// 채널 (CHANNEL/intent.hexa tension5 verbatim):
//   [0] concept       — tool_result 의 raw 정보량 (length).
//   [1] context       — ctx_tokens 의 길이 + entropy.
//   [2] meaning       — concept × context 의 결합 (의미 통합).
//   [3] authenticity  — result 와 context 의 정렬 (both present = high).
//   [4] sender        — 입력 출처가 식별가능한가 (둘 다 비어있지 않음).
//
// PURE — 외부 state 변형 0, 부작용 0.
pub fn derive_tension_delta(tool_result: string, ctx_tokens: list) -> list {
    let r = _result_richness(tool_result)         // 0..1
    let c = _ctx_richness(ctx_tokens)             // 0..1

    let concept      = r
    let context      = c
    let meaning      = r * c                      // both required for meaning
    let authenticity = if r > 0.0 && c > 0.0 {    // both present → coherent
        0.5 * (r + c)
    } else {
        0.0
    }
    let sender       = if r > 0.0 || c > 0.0 { 0.5 } else { 0.0 }

    // 모든 채널 [0, 1] 로 clamp.
    return [
        _clamp01(concept),
        _clamp01(context),
        _clamp01(meaning),
        _clamp01(authenticity),
        _clamp01(sender)
    ]
}

// _apply_delta_to_oscillators — 5-ch tension Δ 를 3 oscillator amplitude 로
// 집계해 주입. PureField 의 oscillator amplitude 는 sin(phase) 와 곱해져
// field[] 를 형성하므로, amplitude 미세 nudge 가 다음 step 의 mixing/variance
// 를 통해 phi 에 자연스럽게 반영된다.
//
// 집계 규약 (본 모듈 header verbatim):
//   fast   ← concept + sender     (즉시 반응성, 화자 정체성)
//   medium ← context + meaning    (의미 통합, 주의 게이팅)
//   slow   ← authenticity         (진정성 = 장기 일관성)
//
// scaling: 각 합산을 0.02 배 (amplitude 가 ~0.7 범위라 ~3% nudge — 한 step
//   의 noise 보다 크고, 한 cycle 의 전체 평균을 흔들지 않을 정도).
fn _apply_delta_to_oscillators(pf: PureField, delta: list) -> PureField {
    let concept      = delta[0]
    let context      = delta[1]
    let meaning      = delta[2]
    let authenticity = delta[3]
    let sender       = delta[4]

    let fast_nudge   = 0.02 * (concept + sender)
    let medium_nudge = 0.02 * (context + meaning)
    let slow_nudge   = 0.02 * authenticity

    let new_fast = Oscillator {
        tau:       pf.fast.tau,
        phase:     pf.fast.phase,
        amplitude: pf.fast.amplitude + fast_nudge
    }
    let new_medium = Oscillator {
        tau:       pf.medium.tau,
        phase:     pf.medium.phase,
        amplitude: pf.medium.amplitude + medium_nudge
    }
    let new_slow = Oscillator {
        tau:       pf.slow.tau,
        phase:     pf.slow.phase,
        amplitude: pf.slow.amplitude + slow_nudge
    }

    PureField {
        fast:                new_fast,
        medium:              new_medium,
        slow:                new_slow,
        phi:                 pf.phi,
        phi_peak:            pf.phi_peak,
        field:               pf.field,
        phase:               pf.phase,
        step_count:          pf.step_count,
        narrative_coherence: pf.narrative_coherence,
        narrative_len:       pf.narrative_len
    }
}

// pure_field_input_step — main entry. tool_result + ctx_tokens 를 Δ 로 변환 후
// pf oscillator 에 주입하고 *standard self-dynamics tick* 을 한 step 돌린다.
//
// 사용처 (M6 daemon loop):
//   pf = pure_field_input_step(pf, tool_result, ctx_tokens)
//
// 빈 입력 (tool_result="" && ctx_tokens=[]) 의 경우 Δ = [0,0,0,0,0] 이므로
// 본 함수는 표준 `pure_field_step(pf)` 와 동치 — graceful degradation.
pub fn pure_field_input_step(pf: PureField, tool_result: string, ctx_tokens: list) -> PureField {
    let delta = derive_tension_delta(tool_result, ctx_tokens)
    let pf_nudged = _apply_delta_to_oscillators(pf, delta)
    return pure_field_step(pf_nudged)
}

// pure_field_input_step_no_pf_step — Δ 만 주입하고 self-dynamics tick 은
// 호출자에게 위임. 여러 입력을 한 tick 안에 *chain* 하고 싶을 때 (예: tool
// result + perception event + idle marker 가 모두 같은 tick 에 도착했을 때)
// 사용. 호출자가 마지막에 한 번 `pure_field_step(pf)` 를 직접 부른다.
pub fn pure_field_input_step_no_pf_step(pf: PureField, tool_result: string, ctx_tokens: list) -> PureField {
    let delta = derive_tension_delta(tool_result, ctx_tokens)
    return _apply_delta_to_oscillators(pf, delta)
}

// input_step_summary — 한 줄 컨트랙트 요약 (smoke / 디버그 surface).
pub fn input_step_summary() -> string {
    return "WAKE/input_step: (tool_result, ctx_tokens) -> tension5 Δ -> oscillator nudge (fast=c+s · medium=ctx+m · slow=auth) -> pure_field_step -> PureField'. Empty input → identity to pure_field_step. emit 결정은 brain_decide 위임."
}
