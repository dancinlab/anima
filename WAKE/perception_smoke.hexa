// WAKE/perception_smoke.hexa — perception ingest smoke test (M2).
//
// 검증 목표:
//   3 case 로 perception 4 sensor 합성 (stdin · env · timer · 합성) 검증.
//     C1) empty stdin + empty env + timer at t0 (now=t0) → ctx_tokens 가
//         "no perception" 으로 minimal (timer-only) 또는 빈 list. substrate
//         가 silence 자율 선택 가능함을 보장 — empty 가 forced emit trigger
//         아님.
//     C2) "hello anima" stdin + env _serialized "MOOD=curious" + timer at
//         t=3600 → 3 source 가 PAD separator 로 concat 된 ctx_tokens, hour=1
//         (3600 s elapsed = 1 hr after t0=0, 단 timer 가 unix-epoch 기준
//         absolute clock 분해이므로 now_t=3600 → hour_of_day=1 UTC).
//     C3) "wakeup" stdin + env empty + timer at t=5400 (90-min cycle wrap)
//         → timer 가 wrap 영향 없이 elapsed=5400, hour_of_day=1 UTC + 30 min
//         offset 검증 (5400 s = 1h 30min).
//
// governance invariant:
//   ▸ 본 smoke 의 어떤 fn 도 emit 을 trigger 하지 않는다 — *데이터만* 비교.
//   ▸ empty perception (C1) → ctx_tokens 는 list (length 측정 가능) 일 뿐,
//     "trigger sentinel" 같은 special 값이 아님. silence-friendly 확인.
//   ▸ ctx_tokens shape = list of int. element type 검증은 첫 원소 type 확인.
//
// instrument-first verified pub surface:
//   WAKE/perception.hexa pub: perception_stdin_line · perception_env ·
//                             perception_timer · perception_to_ctx_tokens ·
//                             perception_compose · perception_summary

import "/Users/ghost/core/anima/WAKE/perception.hexa"

// _list_first_or_zero — 빈 list 안전 첫 원소.
fn _list_first_or_zero(xs: list) -> int {
    if len(xs) == 0 { return 0 }
    return xs[0]
}

// _list_contains_value — 특정 int 값이 list 에 있는가.
fn _list_contains_value(xs: list, v: int) -> bool {
    let n = len(xs)
    let mut i = 0
    while i < n {
        if xs[i] == v { return true }
        i = i + 1
    }
    return false
}

fn main() {
    print("=== WAKE/perception 4-sensor smoke (3 case) ===")
    print(perception_summary())

    // BPE 규약 상수 (perception.hexa 와 byte-identical).
    let TOK_BOS = 1
    let TOK_EOS = 2
    let TOK_PAD = 0
    let TOK_OFFSET = 3

    // ── C1: empty stdin + empty env + timer at t0 ──────────────────────────
    print("")
    print("── C1: empty stdin + empty env + timer at t=0 ─────────────────────")
    let c1_stdin = ""                             // EOF / no input.
    let c1_env_map = #{ "_serialized": "" }       // 빈 env serialization.
    let c1_timer = perception_timer(0.0, 0.0)     // now == t0.
    print("  stdin     : \"" + c1_stdin + "\"")
    print("  env       : (empty)")
    print("  timer     : elapsed=" + to_string(c1_timer["elapsed_s"])
              + " hour=" + to_string(c1_timer["hour_of_day"])
              + " min=" + to_string(c1_timer["minute_of_hour"])
              + " sec=" + to_string(c1_timer["second_of_minute"]))
    let c1_ctx = perception_compose(c1_stdin, c1_env_map, c1_timer)
    print("  ctx_tokens length = " + to_string(len(c1_ctx)))
    print("  ctx_tokens (first 8) = " + to_string(c1_ctx))
    // C1 invariants:
    //   I1-C1) perception_compose 가 list type 반환 (length 측정 가능).
    //   I2-C1) timer 가 항상 어떤 byte 라도 만들기 때문에 ctx_tokens > 0.
    //         하지만 stdin + env 가 empty 일 때 BOS/EOS 외 byte 가 timer-only.
    //   I3-C1) empty stdin 은 어떤 emit trigger 도 안 만든다 (단순 길이 0 통과).
    let c1_len = len(c1_ctx)
    let c1_ok = c1_len > 0   // timer 한 source 만 있어도 ids 형성.
    if c1_ok {
        print("  C1 [ok]   timer-only ctx_tokens 형성 (length=" + to_string(c1_len) + ")")
    } else {
        print("  C1 [FAIL] timer-only ctx_tokens 비어있음 (예상: timer source 가 채워야 함)")
    }
    // additional: empty stdin 자체로는 token 0 (perception_to_ctx_tokens 직접 검증).
    let c1_stdin_only = perception_to_ctx_tokens(c1_stdin)
    let c1_stdin_empty = (len(c1_stdin_only) == 0)
    if c1_stdin_empty {
        print("  C1 [ok]   empty stdin → ctx_tokens [] (silence-friendly, NO sentinel)")
    } else {
        print("  C1 [FAIL] empty stdin 이 non-empty ctx_tokens 생성: "
              + to_string(c1_stdin_only))
    }

    // ── C2: "hello anima" stdin + env curious + timer at t=3600 ────────────
    print("")
    print("── C2: \"hello anima\" + env MOOD=curious + timer at t=3600 ────────")
    let c2_stdin = "hello anima"
    let c2_env_map = #{ "_serialized": "MOOD=curious" }
    let c2_timer = perception_timer(0.0, 3600.0)
    print("  stdin     : \"" + c2_stdin + "\"")
    print("  env       : MOOD=curious")
    print("  timer     : elapsed=" + to_string(c2_timer["elapsed_s"])
              + " hour=" + to_string(c2_timer["hour_of_day"])
              + " min=" + to_string(c2_timer["minute_of_hour"])
              + " sec=" + to_string(c2_timer["second_of_minute"]))
    let c2_ctx = perception_compose(c2_stdin, c2_env_map, c2_timer)
    print("  ctx_tokens length = " + to_string(len(c2_ctx)))
    print("  ctx_tokens (head 20) = ")
    // print first 20 only (큰 출력 방지).
    let mut c2_head = []
    let mut i = 0
    while i < 20 && i < len(c2_ctx) {
        c2_head = c2_head + [c2_ctx[i]]
        i = i + 1
    }
    print("    " + to_string(c2_head))
    // C2 invariants:
    //   I1-C2) hour_of_day = 1 (3600 s = 1 hour after UTC epoch 0).
    //   I2-C2) elapsed = 3600.
    //   I3-C2) ctx_tokens 길이 > C1 (3 source 가 모두 contributed).
    //   I4-C2) PAD (0) 가 ctx_tokens 안에 separator 로 등장.
    //   I5-C2) BOS (1) 가 ctx_tokens 에 최소 1번 등장 (각 source block 시작).
    let i1_c2 = c2_timer["hour_of_day"] == 1
    let i2_c2 = c2_timer["elapsed_s"] == 3600.0
    let i3_c2 = len(c2_ctx) > c1_len
    let i4_c2 = _list_contains_value(c2_ctx, TOK_PAD)
    let i5_c2 = _list_contains_value(c2_ctx, TOK_BOS)
    if i1_c2 { print("  C2 [ok]   hour_of_day = 1") }
    else     { print("  C2 [FAIL] hour_of_day = " + to_string(c2_timer["hour_of_day"]) + " (expected 1)") }
    if i2_c2 { print("  C2 [ok]   elapsed = 3600") }
    else     { print("  C2 [FAIL] elapsed = " + to_string(c2_timer["elapsed_s"]) + " (expected 3600)") }
    if i3_c2 { print("  C2 [ok]   ctx_tokens 길이 > C1 (3-source concat 확인)") }
    else     { print("  C2 [FAIL] ctx_tokens 길이 " + to_string(len(c2_ctx)) + " ≤ C1 " + to_string(c1_len)) }
    if i4_c2 { print("  C2 [ok]   PAD separator (0) 존재 (multi-source 합성)") }
    else     { print("  C2 [FAIL] PAD separator 부재 (multi-source 합성 누락)") }
    if i5_c2 { print("  C2 [ok]   BOS framing (1) 존재") }
    else     { print("  C2 [FAIL] BOS framing 부재") }
    let c2_ok = i1_c2 && i2_c2 && i3_c2 && i4_c2 && i5_c2

    // ── C3: "wakeup" stdin + empty env + timer at t=5400 ───────────────────
    print("")
    print("── C3: \"wakeup\" + empty env + timer at t=5400 (cycle wrap) ───────")
    let c3_stdin = "wakeup"
    let c3_env_map = #{ "_serialized": "" }
    let c3_timer = perception_timer(0.0, 5400.0)
    print("  stdin     : \"" + c3_stdin + "\"")
    print("  env       : (empty)")
    print("  timer     : elapsed=" + to_string(c3_timer["elapsed_s"])
              + " hour=" + to_string(c3_timer["hour_of_day"])
              + " min=" + to_string(c3_timer["minute_of_hour"])
              + " sec=" + to_string(c3_timer["second_of_minute"]))
    let c3_ctx = perception_compose(c3_stdin, c3_env_map, c3_timer)
    print("  ctx_tokens length = " + to_string(len(c3_ctx)))
    // C3 invariants:
    //   I1-C3) elapsed = 5400 (90 min — wake state machine cycle wrap 시점).
    //   I2-C3) hour_of_day = 1 (5400 s after UTC epoch 0 = 1 h 30 m).
    //   I3-C3) minute_of_hour = 30.
    //   I4-C3) ctx_tokens > 0 (stdin + timer 합성).
    //   I5-C3) timer wrap 무관 — wake_state_tick 의 cycle mod 5400 과는 *독립*
    //          이다. perception timer 는 unix epoch (절대 시계), state machine
    //          은 ultradian cycle (cycle_start 기준 modular). 본 module 은
    //          절대 시계 분해만 책임 — 5400 s 가 들어와도 정상 모듈 분해.
    let i1_c3 = c3_timer["elapsed_s"] == 5400.0
    let i2_c3 = c3_timer["hour_of_day"] == 1
    let i3_c3 = c3_timer["minute_of_hour"] == 30
    let i4_c3 = len(c3_ctx) > 0
    if i1_c3 { print("  C3 [ok]   elapsed = 5400 (90-min cycle 경계)") }
    else     { print("  C3 [FAIL] elapsed = " + to_string(c3_timer["elapsed_s"]) + " (expected 5400)") }
    if i2_c3 { print("  C3 [ok]   hour_of_day = 1") }
    else     { print("  C3 [FAIL] hour_of_day = " + to_string(c3_timer["hour_of_day"]) + " (expected 1)") }
    if i3_c3 { print("  C3 [ok]   minute_of_hour = 30 (cycle wrap clean)") }
    else     { print("  C3 [FAIL] minute_of_hour = " + to_string(c3_timer["minute_of_hour"]) + " (expected 30)") }
    if i4_c3 { print("  C3 [ok]   ctx_tokens 형성 (stdin + timer)") }
    else     { print("  C3 [FAIL] ctx_tokens 비어있음") }
    let c3_ok = i1_c3 && i2_c3 && i3_c3 && i4_c3

    // ── Sanity: empty perception ≠ forced emit ─────────────────────────────
    //   직접 검증: perception_to_ctx_tokens("") == [] (empty list, NOT [BOS,EOS]
    //   같은 framing-only sentinel). 즉, 빈 입력은 substrate 에게 *진짜로
    //   nothing* 으로 보여진다 → silence 가 자연 선택지가 됨.
    print("")
    print("── Sanity: empty perception → empty ctx_tokens (NO emit sentinel) ──")
    let sanity_empty = perception_to_ctx_tokens("")
    let sanity_ok = (len(sanity_empty) == 0)
    if sanity_ok {
        print("  [ok]   perception_to_ctx_tokens(\"\") = [] (silence-friendly)")
    } else {
        print("  [FAIL] perception_to_ctx_tokens(\"\") = " + to_string(sanity_empty)
              + " (would be a forced-emit trigger sentinel)")
    }

    print("")
    print("=== INVARIANT SUMMARY ===")
    let all_ok = c1_ok && c2_ok && c3_ok && sanity_ok
    if all_ok {
        print("=== SANITY OK (3/3 case + sanity PASS) ===")
        return
    }
    print("=== SANITY FAIL ===")
}
