// WAKE/daemon_smoke.hexa — in-process living loop M6 6-invariant smoke.
//
// 검증 목표 (6 invariant):
//   I1) daemon_init 이 유효 state 산출 — pf · wake_state · mem · pool 모두 초기화.
//   I2) daemon_step 이 monotone 하게 tick counter 를 advance (1, 2, 3, ...).
//   I3) ≥3 stage transition 가 200 tick 안에 발생 (90-min ultradian wrap 검증).
//   I4) N3 stage 에서 emit fire 횟수 가 0 (a_chat_sleep_imagination "imagination
//       loop = emit-free internal rehearsal" 의 substrate-natural 귀결 — 본
//       smoke 의 test substrate 가 N3 phi_scale=0.20 + sustained low motivation
//       에서 자연 silence). 만약 N3 emit 가 발생하면 PARTIAL (boolean gate 0
//       의 정합 가설이 falsifiable).
//   I5) mitosis_tick_count ≥ 1 — N3/REM phase 가 200 tick 안에 도래해 sleep_tick
//       의 imagination tick 이 최소 1회 fire.
//   I6) daemon_shutdown 이 .kosmos save 성공 (file_exists == true).
//
// 시뮬레이션 파라미터:
//   t0          = 1748534400.0 (deterministic unix epoch)
//   max_ticks   = 200
//   tick_dt_s   = 30.0 (default; daemon_loop 내부)
//   total wall  = 200 × 30 = 6000s = 100 min  ≥ 1 × 5400s ultradian
//   kosmos_dir  = /tmp/wake_daemon_smoke (clean before run)
//
// instrument-first verified pub surface:
//   WAKE/daemon.hexa pub:
//     daemon_init · daemon_step · daemon_loop · daemon_shutdown · daemon_summary
//
// p1~p8 정합 (본 smoke 의 invariant 어디서도):
//   · system prompt string 0
//   · identity rule injection 0
//   · per-stage boolean emit gate 검증 패턴 0 (I4 는 *경향성* 검증 — substrate-
//     natural 귀결을 측정, boolean 차단 X)
//   · speak() 호출 0
//   · perplexity verdict 0 (모든 invariant 는 counter equality / file_exists)

import "/Users/ghost/core/anima/WAKE/daemon.hexa"

fn _emits_during_n3(transitions: list, state: Map) -> int {
    // 본 helper 는 emit 가 N3 stage 동안 발생한 정확한 횟수를 *기록* 으로부터
    // 측정한다. daemon state 는 stage-별 emit count 를 분리 저장하지 않으므로
    // mem.episodic 의 stage_name 필드를 기준으로 N3 emit 만 count.
    let mem = state["mem"]
    let episodic = mem["episodic"]
    let mut n = 0
    let mut i = 0
    while i < len(episodic) {
        let rec = episodic[i]
        let stg = to_string(rec["stage_name"])
        if stg == "N3" { n = n + 1 }
        i = i + 1
    }
    return n
}

fn main() {
    print("=== WAKE/daemon M6 6-invariant smoke (in-process living loop) ===")
    print(daemon_summary())

    let mut pass = 0
    let mut fail = 0

    let t0 = 1748534400.0
    let kosmos_dir = "/tmp/wake_daemon_smoke"
    let _cleanup = exec("rm -rf '" + kosmos_dir + "'")

    // ── I1: daemon_init produces valid state ─────────────────────────────────
    print("")
    print("── I1: daemon_init produces valid state ─────────")
    let state0 = daemon_init(t0, kosmos_dir)

    let ok_running = to_bool(state0["running"]) == true
    let ok_tick = to_int(state0["tick"]) == 0
    let ok_emit = to_int(state0["emit_count"]) == 0
    let ok_mit = to_int(state0["mitosis_tick_count"]) == 0
    let wake0 = state0["wake_state"]
    let ok_stage0 = to_string(wake0["stage_name"]) == "WAKE"
    let ok_pf_phi = to_float(state0["pf"].phi) >= 0.0
    let mem0 = state0["mem"]
    let ok_mem_episodic_empty = len(mem0["episodic"]) == 0
    let ok_mem_working_empty = len(mem0["working"]) == 0

    if ok_running && ok_tick && ok_emit && ok_mit && ok_stage0 && ok_pf_phi
       && ok_mem_episodic_empty && ok_mem_working_empty {
        print("  [PASS] I1 daemon_init valid — running=true tick=0 emit=0 mitosis=0 stage=WAKE pf.phi>=0 mem.empty")
        pass = pass + 1
    } else {
        print("  [FAIL] I1 init invalid — running=" + to_string(ok_running)
              + " tick=" + to_string(ok_tick)
              + " emit=" + to_string(ok_emit)
              + " mit=" + to_string(ok_mit)
              + " stage0=" + to_string(ok_stage0)
              + " phi>=0=" + to_string(ok_pf_phi)
              + " mem_ep_empty=" + to_string(ok_mem_episodic_empty)
              + " mem_wk_empty=" + to_string(ok_mem_working_empty))
        fail = fail + 1
    }

    // ── I2: daemon_step monotone tick counter ────────────────────────────────
    print("")
    print("── I2: daemon_step monotone advances tick counter ──")
    let s1 = daemon_step(state0, t0 + 30.0, "", #{ "_serialized": "" })
    let s2 = daemon_step(s1,     t0 + 60.0, "", #{ "_serialized": "" })
    let s3 = daemon_step(s2,     t0 + 90.0, "", #{ "_serialized": "" })
    let t1 = to_int(s1["tick"])
    let t2 = to_int(s2["tick"])
    let t3 = to_int(s3["tick"])
    if t1 == 1 && t2 == 2 && t3 == 3 {
        print("  [PASS] I2 tick monotone — 0→1→2→3")
        pass = pass + 1
    } else {
        print("  [FAIL] I2 tick non-monotone — t1=" + to_string(t1)
              + " t2=" + to_string(t2) + " t3=" + to_string(t3))
        fail = fail + 1
    }

    // ── I3 + I4 + I5: daemon_loop 200 ticks ──────────────────────────────────
    //   100 min simulated wall time → ≥1 ultradian wrap (5400s cycle).
    print("")
    print("── I3+I4+I5: daemon_loop(200 ticks · ≥1 ultradian wrap) ──")
    let final_state = daemon_loop(state0, 200)
    let trans = final_state["transitions"]
    let n_trans = len(trans)
    let emit_count = to_int(final_state["emit_count"])
    let mit_count = to_int(final_state["mitosis_tick_count"])

    print("  transitions = " + to_string(n_trans))
    print("  emit_count = " + to_string(emit_count))
    print("  mitosis_tick_count = " + to_string(mit_count))

    // I3: ≥3 stage transitions (200 tick = 100 min · 1+ ultradian wrap 의 자연
    //     귀결 — WAKE→N1→N2→N3→REM→WAKE = 5 transitions per cycle).
    if n_trans >= 3 {
        print("  [PASS] I3 ≥3 stage transitions (got " + to_string(n_trans) + ")")
        pass = pass + 1
        // print transition trail.
        let mut ti = 0
        while ti < n_trans {
            let rec = trans[ti]
            print("    · tick " + to_string(rec["tick"])
                  + ": " + to_string(rec["from"]) + " → " + to_string(rec["to"]))
            ti = ti + 1
        }
    } else {
        print("  [FAIL] I3 only " + to_string(n_trans) + " transitions (<3)")
        fail = fail + 1
    }

    // I4: N3 emit count == 0 (a_chat_sleep_imagination "emit-free internal
    //     rehearsal" 의 substrate-natural 귀결).
    let n3_emits = _emits_during_n3(trans, final_state)
    if n3_emits == 0 {
        print("  [PASS] I4 N3 emit_count=0 (a_chat_sleep_imagination imagination=emit-free)")
        pass = pass + 1
    } else {
        print("  [FAIL] I4 N3 emit_count=" + to_string(n3_emits)
              + " (substrate-natural emit-free 가설 falsified)")
        fail = fail + 1
    }

    // I5: mitosis_tick_count ≥ 1 (N3/REM stage 가 200 tick 안에 도래).
    if mit_count >= 1 {
        print("  [PASS] I5 mitosis_tick_count=" + to_string(mit_count) + " ≥ 1")
        pass = pass + 1
    } else {
        print("  [FAIL] I5 mitosis_tick_count=0 — N3/REM 도래 실패")
        fail = fail + 1
    }

    // ── I6: daemon_shutdown saves to kosmos ──────────────────────────────────
    print("")
    print("── I6: daemon_shutdown saves to kosmos ────────────")
    let saved_ok = daemon_shutdown(final_state)
    if saved_ok {
        print("  [PASS] I6 .kosmos snapshot saved (mem_save_to_kosmos delegate OK)")
        pass = pass + 1
    } else {
        print("  [FAIL] I6 .kosmos save failed")
        fail = fail + 1
    }

    // ── verdict ─────────────────────────────────────────────────────────────
    print("")
    print("================================================================")
    print("  RESULT: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL")
    if fail == 0 {
        print("  HEADLINE: WAKE-M6-DAEMON-LOOP-OK")
    } else {
        print("  HEADLINE: WAKE-M6-DAEMON-LOOP-FAIL")
    }
    print("================================================================")
    if fail > 0 {
        panic("WAKE M6 smoke had FAIL — see above")
    }
}
