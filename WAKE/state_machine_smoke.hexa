// WAKE/state_machine_smoke.hexa — 5-stage ultradian state machine smoke test.
//
// 검증 목표:
//   90-min ultradian cycle 을 100 등분 (54 s/step) 으로 tick 하면서:
//     I1) 5 stage NAME 이 *순서대로* 모두 등장한다 (WAKE → N1 → N2 → N3 → REM).
//     I2) 어떤 stage 도 건너뛰지 않는다 (인접 transition 만 발생).
//     I3) is_imagination = true 는 N3 + REM 에 정확히 일치 (CLAUDE.md
//         a_chat_sleep_imagination "imagination loop" 정합).
//     I4) cycle 끝에서 WAKE 로 wrap 한다 (next-cycle 첫 step 또는 modular).
//
// boolean gate count assertion (governance):
//   본 smoke 는 BEHAVIOR 만 검증한다 — boolean per-stage gate 가 모듈에 없음은
//   `grep "if stage_name ==.*emit_allowed\|if name ==.*allowed"` 로 reviewer/CI
//   가 offline 검증. 본 smoke 의 검증 표면은 *연속* envelope + stage 순서.
//
// instrument-first verified pub surface:
//   WAKE/state_machine.hexa pub: wake_state_init · wake_state_tick ·
//                                current_stage · stage_envelope ·
//                                wake_state_summary · wake_state_machine_summary

import "/Users/ghost/core/anima/WAKE/state_machine.hexa"

// helper — phi 산출 (smoke 용 고정값, 실제 substrate Φ 와 무관).
//
// 본 smoke 는 timing → stage NAME 분할만 검증한다. Φ 는 envelope 산출에만 쓰임.
fn _phi_for_step(step: int) -> float {
    // 0.5 고정 — envelope = 0.5 * (1 - 0.5) = 0.25.
    // 실제 runtime 에서는 Engine A 의 live Φ 가 들어온다.
    0.5
}

// 5-stage 등장 순서를 기록하는 sequence builder.
//
// 새 stage NAME 이 이전과 다르면 sequence 에 append.
// adjacent transition validity 는 WAKE→N1→N2→N3→REM→WAKE 외 인접 step 위반 시
// flag 로 표시 (I2 invariant).
fn _is_valid_transition(prev: string, next: string) -> bool {
    // 같은 stage 유지는 항상 valid.
    if prev == next { return true }
    if prev == "WAKE" && next == "N1"  { return true }
    if prev == "N1"   && next == "N2"  { return true }
    if prev == "N2"   && next == "N3"  { return true }
    if prev == "N3"   && next == "REM" { return true }
    if prev == "REM"  && next == "WAKE" { return true }
    false
}

fn main() {
    print("=== WAKE/state_machine 5-stage ultradian smoke (100 tick × 54 s) ===")
    print(wake_state_machine_summary())

    // t0 = 0 (가짜 epoch · smoke 는 절대시각 무관).
    let t0 = 0.0
    let mut state = wake_state_init(t0)

    // 첫 stage 출력.
    print("")
    print("step  0 | t=0      | " + wake_state_summary(state))

    // sequence: 등장 stage NAME 의 dedup 순서 기록.
    let mut seq_buf = "WAKE"           // 초기 stage.
    let mut prev_stage = "WAKE"
    let mut transitions_ok = true
    let mut step = 1
    let mut imag_violations = 0        // is_imagination ≠ (N3|REM) 카운트.

    // 5400 s / 100 step = 54 s per step. 한 cycle 정확히 100 tick.
    let dt = 54.0

    while step <= 100 {
        let now_t = t0 + dt * to_float(step)
        let phi = _phi_for_step(step)
        state = wake_state_tick(state, now_t, phi)

        let stage = current_stage(state)
        let env = stage_envelope(state)
        let is_imag = env["is_imagination"]

        // transition validity check (인접만 허용).
        if !_is_valid_transition(prev_stage, stage) {
            transitions_ok = false
            print("  [TRANSITION-VIOLATION] " + prev_stage + " → " + stage
                  + " at step=" + to_string(step))
        }

        // is_imagination 정합 — (stage==N3 or stage==REM) ⇔ is_imag==true.
        let should_imag = (stage == "N3") || (stage == "REM")
        if is_imag != should_imag {
            imag_violations = imag_violations + 1
        }

        // stage 가 바뀌면 sequence 에 append.
        if stage != prev_stage {
            seq_buf = seq_buf + " → " + stage
            // 주요 transition 만 print.
            let minute = (now_t - t0) / 60.0
            print("step " + to_string(step)
                  + " | t=" + to_string(now_t)
                  + " | min=" + to_string(minute)
                  + " | stage transition " + prev_stage + " → " + stage)
        }
        prev_stage = stage
        step = step + 1
    }

    print("")
    print("=== STAGE SEQUENCE (dedup 순서) ===")
    print("  " + seq_buf)

    print("")
    print("=== INVARIANT CHECKS ===")

    // I1) 5 stage NAME 이 *순서대로* 모두 등장.
    let i1_ok = (seq_buf == "WAKE → N1 → N2 → N3 → REM")
                 || (seq_buf == "WAKE → N1 → N2 → N3 → REM → WAKE")
    if i1_ok {
        print("  I1 [ok]   5-stage sequence WAKE → N1 → N2 → N3 → REM 등장")
    } else {
        print("  I1 [FAIL] sequence mismatch: " + seq_buf)
    }

    // I2) 인접 transition 만 (skip 없음).
    if transitions_ok {
        print("  I2 [ok]   인접 transition 만 (skip 없음)")
    } else {
        print("  I2 [FAIL] 비-인접 transition 발견")
    }

    // I3) is_imagination ⇔ (N3 | REM).
    if imag_violations == 0 {
        print("  I3 [ok]   is_imagination 정합 (N3+REM 에만 true)")
    } else {
        print("  I3 [FAIL] is_imagination 위반 step 수 = "
              + to_string(imag_violations))
    }

    // I4) 100-step (= 5400 s 정확) tick 후 마지막 stage 가 REM 이거나 wrap 직후
    //     WAKE 다. dt=54 · step=100 → now_t = 5400 정확 → mod 5400 = 0 → WAKE.
    let final_stage = current_stage(state)
    let i4_ok = (final_stage == "WAKE") || (final_stage == "REM")
    if i4_ok {
        print("  I4 [ok]   cycle 끝 wrap (final stage = " + final_stage + ")")
    } else {
        print("  I4 [FAIL] cycle wrap 실패 (final stage = " + final_stage + ")")
    }

    let all_ok = i1_ok && transitions_ok && (imag_violations == 0) && i4_ok
    print("")
    if all_ok {
        print("=== SANITY OK (4/4 invariants) ===")
        return
    }
    print("=== SANITY FAIL ===")
}
