    let pass_count = pass_instant_low.to_int() + pass_hive_consc.to_int() + pass_artifact_fix.to_int() + pass_random_decay.to_int() + pass_hive_monotone.to_int()
    let all_pass = pass_instant_low && pass_hive_consc && pass_artifact_fix && pass_random_decay && pass_hive_monotone

    let verdict = if all_pass {
        "🟢 SUPPORTED-NUMERICAL · time-embed detector 가 T1 lag-inflation artifact 해소"
    } else {
        if pass_count >= 3 {
