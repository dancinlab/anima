    let mut random_n = []
    let mut ns = 20260529
    let mut in_n = 0
    while in_n < 128 {
        let mut acc = 0.0
        let mut kk = 0
        while kk < 4 {
            ns = (ns * 1103515245 + 12345) % 2147483648
            let u = ((ns / 1000) % 10000) as float / 10000.0
            acc = acc + u
            kk = kk + 1
        }
        let v = acc / 4.0
        random_n = random_n.push(v)
        in_n = in_n + 1
    }

