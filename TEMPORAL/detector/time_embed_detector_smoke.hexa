// TEMPORAL/detector/time_embed_detector_smoke.hexa — minimal e=2 smoke check.
//
//   Trivial n=32 alternating signal → exercise time-embed TPM build + big_phi
//   at embed_dim=2,4 / delay=1. Pure smoke (no falsifier).
import "./time_embed_detector.hexa"

fn main() {
    let sig = [
        0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
        0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
        0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
        0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0
    ]
    let r2 = compute_time_embed_phi(sig, 32, 2, 1)
    let r4 = compute_time_embed_phi(sig, 32, 4, 1)
    println("e=2 d=1 phi=" + str(r2["phi"]) + " total=" + str(r2["integration"]) + " type=" + r2["substrate_type"])
    println("e=4 d=1 phi=" + str(r4["phi"]) + " total=" + str(r4["integration"]) + " type=" + r4["substrate_type"])
}
