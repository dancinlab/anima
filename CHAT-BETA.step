  |> Llama-3-Korean-Bllossom-8B 8B LoRA r=32 wall 2-4 hr
  => "\$1-3 A100 — RTX 4090 도 가능"

@K path_B_cost = 20+50 = 3500 ucents-cents :: chat_beta [d=2026-05-14 ok]
  |> Phase 1A.4 → 1A.5 2000-5000 step
  => "\$0.20-0.50 A100"

@K path_C_cost = 0 :: chat_beta [d=2026-05-14 ok]
  |> corpus download/concat
  => "\$0 — disk + bandwidth 시간만"

@K path_D_cost = 0 :: chat_beta [d=2026-05-14 ok]
  |> inference mode change only
  => "\$0 — 1 min verify"

@K path_E_cost = 0+50 = 2500 ucents-cents :: chat_beta [d=2026-05-14 ok]
  |> Claude API beta proxy
  => "\$0-0.50 per user-day depending on traffic"

@K total_envelope = 20000+3500+0+0+2500 = 26000 ucents-cents :: chat_beta [d=2026-05-14 ok]
  |> all 5 paths
  => "\$2-6 cumulative for full beta launch (path A primary + D verify + E fallback)"

