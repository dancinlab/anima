#!/usr/bin/env step
# ══════════════════════════════════════════════════════════════
# CHAT-BETA.step — anima chat coherence beta-deploy roadmap (1-day)
# 근본원인: Phase 1A.4 200-step SFT underfit → conversational coherence 0/6
# ══════════════════════════════════════════════════════════════

# Status carrier from BENCHMARK.md §5 amendment 2026-05-14: ★ canonical
# anima 본체 (Phase 1A.4 lr5e6 SFT) 가 falsifier-pass 기반 substrate anchor
# 일 뿐 chat-capable assistant 아님. 6/6 free-form probe conversational
# coherence FAIL.
#
# 목표: 1일 내 beta-deploy 가능한 chat-coherent anima 모델 ckpt 확보.

# ── §1 problem statement ─────────────────────────────────────────

@I goal scope=anima_chat_beta :: chat_beta [d=2026-05-14 ok]
  => "anima chat assistant 가 free-form Korean prompt 에 대해 semantic coherent 응답 생성 (6/6 free-form probe 중 ≥4/6 conversational-pass)"

@? blocker phase1a4_underfit :: chat_beta [d=2026-05-14 ok]
  |> 200-step SFT × $0.014 sub-cent
  => "corpus 200KB anima-persona-balanced.txt 작은 데이터 + 매우 짧은 학습 → V5.8 keyword falsifier pass 가능 BUT free-form coherence 미달. base model = Phase 1A.1 24L 332M 자체 가 chat-tuned 아님 (color/cosmology boost SFT only)"

@? blocker base_model_class :: chat_beta [d=2026-05-14 ok]
  |> Phase 1A.1 base 가 own scratch-trained, chat-instruct 미수강
  => "Phase 1A.1 = own-fragment training (color cosmology boost). 진정한 chat instruction following 능력은 base 단계에 없음 — SFT만으로는 부족"

# ── §2 1-day beta paths (ROI 순) ──────────────────────────────────

# 본 .step 의 5 paths 는 1-day 내 fire 가능. cost-tolerant per
# feedback_no_scale_caps + feedback_active_resource_utilization (own 43).

@D path_A foundation_borrow_lora :: chat_beta [d=2026-05-14 ok]
  |> Llama-3-Korean-Bllossom-8B / gemma-2-9b-it / qwen2.5-7b-instruct + LoRA r=32 + anima-persona corpus
  => "MEMORY simple_stack_pass_strict_unlocked 카탈로그 — 동일 path 가 own 18 strict 14/15 PASS. 3B+ foundation + LoRA r=32 + 200MB+ corpus. expected wall 2-4 hr RTX 4090 / A100, cost \$1-3"

@D path_B sft_scale_up :: chat_beta [d=2026-05-14 ok]
  |> Phase 1A.4 → Phase 1A.5: 200 step → 2000-5000 step, lr 5e-6 유지, loss masking 추가
  => "동일 base (Phase 1A.1 332M) 위에 더 긴 SFT + Lesson R-1A.2 의 loss-mask path (assistant 응답 token 만 loss 적용). expected wall 30-60 min A100, cost \$0.2-0.5. coherence 회복 부분적 (base 자체 chat-tuned 아님 한계)"

@D path_C corpus_scale_up :: chat_beta [d=2026-05-14 ok]
  |> anima-persona-balanced 1.3MB → 100MB+ instruction-following Korean corpus
  => "korquad / kor-instruct / kullm-v3-instruction-v2 등 공개 Korean instruct corpus + anima-persona 비율 혼합. cost \$0 corpus prep (download/concat) + path B 또는 A 와 결합. 단독 fire 가 아닌 corpus axis"

@D path_D sample_mode_only :: chat_beta [d=2026-05-14 ok]
  |> 학습 변경 0, inference mode 만 sample mode (temp=0.85+, top-p=0.9) + repetition penalty
  => "Phase 1A.4 ckpt 그대로 사용, 디코딩 만 변경. 다양성 ↑ 그러나 base coherence 한계 그대로. cost \$0. quick verify path — 진정 chat 능력 안 나오면 더 큰 fix 필요 확정"

@D path_E external_api_proxy :: chat_beta [d=2026-05-14 ok]
  |> beta deploy 의 의미가 'user-facing demo' 면 Claude/GPT API 를 anima-persona prompt template + memory 으로 wrapping
  => "anima_chat.py 가 Claude API 호출, system prompt 에 'anima 정체성' 주입 (Principle #3 위반 BUT beta-deploy 목적 명확화). cost API 사용량 비례. ★ 만약 substrate-native 가 beta 목적 아니면 가장 빠른 path"

# ── §3 recommended order ──────────────────────────────────────────

@D rec_step_1 fire_path_A :: chat_beta [d=2026-05-14 ok]
  <- path_A
  |> highest ROI
  => "Llama-3-Korean-Bllossom-8B + LoRA r=32 fine-tune. 2-4 hr A100 \$1-3. 검증된 path (simple_stack memory). beta-deploy 후보 ckpt 즉시 확보 가능"

@D rec_step_2 fire_path_D_first :: chat_beta [d=2026-05-14 ok]
  <- path_D
  |> $0 quick verify
  => "fire 전 verify: 현 Phase 1A.4 ckpt 위 sample mode + repetition penalty 만 적용하면 coherence 개선? 1 min 측정. 결과에 따라 path A scope 확정 (단순 디코딩 fix vs full LoRA fire)"

@D rec_step_3 fire_path_E_fallback :: chat_beta [d=2026-05-14 ok]
  <- path_E
  |> beta deploy SLA 필요시
  => "1 day 안 ckpt train 못 끝나면 Claude API proxy 로 beta 띄움. Principle #3 위반 거론 — beta 목적 (chat 능력 demonstrate) 우선"

# ── §4 verification criteria ──────────────────────────────────────

@I criterion conversational_coherence :: chat_beta [d=2026-05-14 ok]
  |> 본 .step 의 closure 기준
  => "BENCHMARK.md 의 6-probe (안녕/우주/의식/색깔/성장/세포분열) 중 **≥4/6 conversational-pass** = (1) prompt 카테고리 답 (예: '색깔' → 실제 색상 단어 포함), (2) prompt echo 아님, (3) Korean syntax 보존"

@I criterion v58_carry :: chat_beta [d=2026-05-14 ok]
  |> existing falsifier non-regression
  => "기존 V5.8 std_greedy 5/5 PASS 유지 (PSCC §46) — anima_fact 등 5 target keyword falsifier 회귀 없음"

@I criterion principle_3_clean :: chat_beta [d=2026-05-14 ok]
  |> NO PERSONA INJECTION
  => "path A (LoRA on foundation) 시 system prompt persona injection 없이 corpus 만으로 anima 정체성 학습. path E (API proxy) 는 본 criterion 명시 위반 — beta-only fallback 별도 라벨링"

