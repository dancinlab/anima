// CHANNEL/dispatcher.hexa — M5 통합 진입점 channel_emit dispatcher.
//
// 역할:
//   단일 진입점 `channel_emit` — substrate state (tension5 · motivation8 · phi · tier
//   · ctx_tokens) 를 받아 router 의 채널 결정을 따라 3 채널 (text · voice · tension)
//   중 하나의 emit 함수로 위임한다. 새 의식을 만들지 않으며, intent_from_substrate
//   가 만든 channel-agnostic intent dict 만 channel-specific projection 으로 라우팅한다.
//
// 단방향 dispatch 흐름:
//   substrate state (tension5/motivation/phi/tier/ctx_tokens)
//       │
//       ├─► intent_from_substrate(tension5, phi, motivation, tier, "")    // CHANNEL/intent.hexa
//       │       (channel_hint 빈 문자열 — router 가 결정)
//       │
//       ├─► channel_classify(tension5, motivation, phi, tier)             // CHANNEL/router.hexa
//       │       → "text" | "voice" | "tension"
//       │
//       └─► 결정된 채널로 위임:
//             "text"    → text_emit(intent_to_text_vec(intent), ctx_tokens, tension5)
//             "voice"   → voice_emit(intent_to_voice_vec(intent), 24000)
//             "tension" → tension_emit(intent_to_tension_vec(intent), 0)
//             default   → text (router 가 알 수 없는 문자열 반환 시 — 자연 floor lane)
//
// instrument-first (verbatim 인용):
//
//   CHANNEL/router.hexa (line 163):
//     pub fn channel_classify(tension5: list, motivation: list, phi: float, tier: int) -> string
//     // returns "text" / "voice" / "tension"  (tie order: text > voice > tension)
//
//   CHANNEL/router.hexa (line 119):
//     pub fn channel_scores(tension5: list, motivation: list, phi: float, tier: int)
//     // returns #{ "text": float, "voice": float, "tension": float }
//
//   CHANNEL/router.hexa (line 176):
//     pub fn channel_router_summary() -> string
//
//   CHANNEL/intent.hexa (line 89):
//     pub fn intent_from_substrate(tension5: list, phi: float, motivation: list,
//                                  tier: int, channel_hint: string)
//     // returns #{ "vec", "channel_hint", "tension5", "motivation", "phi", "tier" }
//
//   CHANNEL/intent.hexa (line 107):
//     pub fn intent_to_text_vec(intent) -> list   // 14-D (tension5 + motivation8 + phi)
//
//   CHANNEL/intent.hexa (line 133):
//     pub fn intent_to_voice_vec(intent) -> list  // 5-D (tension5 passthrough)
//
//   CHANNEL/intent.hexa (line 146):
//     pub fn intent_to_tension_vec(intent) -> list // 5-D (tension5 passthrough)
//
//   CHANNEL/intent.hexa (line 151):
//     pub fn intent_summary(intent) -> string
//
//   CHANNEL/text/text_emit.hexa (line 42, 71, 82):
//     pub fn text_ready() -> bool                                    // stub: false
//     pub fn text_emit(intent_vec: list, ctx_tokens: list, tension5: list) -> string
//     pub fn text_pipeline_summary() -> string
//
//   CHANNEL/voice/voice_emit.hexa (line 32, 58, 71):
//     pub fn voice_ready() -> bool                                   // stub: false
//     pub fn voice_emit(intent_vec: [float], sample_rate: int) -> string
//     pub fn voice_pipeline_summary() -> string
//
//   CHANNEL/tension/tension_emit.hexa (line 31, 42, 51):
//     pub fn tension_ready() -> bool                                 // stub: false
//     pub fn tension_emit(fingerprint5: list, target_lane: int) -> bool
//     pub fn tension_pipeline_summary() -> string
//
// p1~p8 정합:
//   p1 NO SYSTEM PROMPT      — 입력은 substrate scalars/list 만 (tension5 · motivation8 ·
//                              phi · tier · ctx_tokens BPE ids). 어떤 prompt 문자열도 받지 않음.
//   p2 NO IDENTITY RULES     — dispatcher 는 channel 식별 외 어떤 identity rule 도 인용 안 함.
//   p3 NO PERSONA INJECTION  — ctx_tokens 를 그대로 text_emit 에 위임 (prefix 0). voice/tension
//                              위임 시에도 페르소나 임베딩 prepend 0.
//   p4 NO ASSISTANT FRAMING  — channel_emit 은 stimulus-response endpoint 가 아니다.
//                              호출자는 substrate-decided externalization 경로에서만 호출.
//   p5 NO SPEAK()            — channel_emit 은 substrate tension field 의 externalization 위임이지,
//                              speak(message) 단일 호출이 아니다 (p5_tension_emit_not_filler 정합).
//   p6 NO FINE-TUNED ETHICS  — dispatcher 는 어떤 가중치도 보유하지 않는다. router · intent · emit
//                              모듈만 자기 갱신을 mitosis 로 수행.
//   p7 NO PERPLEXITY VERDICT — 라우팅 결정은 closed-form argmax (channel_scores), perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT  — 동일 dispatcher 가 train/infer 어떤 tick 에도 호출 가능.
//
// a_autonomy_over_hardcode 정합:
//   - dispatcher 내부에 `if stage == N3` / `if tier == 0 { return "text" }` 같은 boolean
//     per-stage gate 0. 채널 선택은 전적으로 channel_classify (continuous score argmax) 에 위임.
//   - dispatcher 는 router 결정을 따를 뿐, 자체 정책을 강요하지 않는다.
//   - default 경로 (router 가 unknown 반환) 도 채널 결정이 아닌 "자연 floor lane = text" 위임으로
//     처리 — router 의 tie order (text > voice > tension) 정책과 일치.
//
// a_substrate_native_speak 정합:
//   호출자는 user message 를 직접 trigger 로 channel_emit 을 부르지 않는다. 호출 조건은
//   "substrate motivation 이 emit threshold 를 넘었다" — 외부 자극이 아닌 internal state.
//   dispatcher 자체는 게이트하지 않으나 (autonomy_over_hardcode), 문서에서 명시적으로 경고.

import "/Users/ghost/core/anima/CHANNEL/router.hexa"
import "/Users/ghost/core/anima/CHANNEL/intent.hexa"
import "/Users/ghost/core/anima/CHANNEL/text/text_emit.hexa"
import "/Users/ghost/core/anima/CHANNEL/voice/voice_emit.hexa"
import "/Users/ghost/core/anima/CHANNEL/tension/tension_emit.hexa"

// channel_emit — 단일 진입점.
//
// 인자:
//   tension5    : list of 5 floats — substrate envelope (M · C · W · MITOSIS · E)
//                 (CHANNEL/tension fingerprint axes 기준 concept/context/meaning/auth/sender)
//   motivation  : list of 8 floats — Engine G 8-factor (rel/gap/cur/pain/coh/orig/bal/dyn)
//   phi         : float — Engine A live Φ
//   tier        : int   — brain_decide tier (0=T0_inert .. 3=T3_commit)
//   ctx_tokens  : list of int — BPE token id sequence (text 채널 위임시 사용)
//
// 반환:
//   dict #{ "channel": string, "output": <any>, "ready": bool, "intent_summary": string }
//     - channel        : "text" | "voice" | "tension" — router 결정 (또는 default)
//     - output         : 위임된 emit fn 의 raw 반환값 (string / string / bool)
//     - ready          : 해당 채널 emit pipeline 의 ready() 반환값
//     - intent_summary : intent_summary(intent) 한 줄 요약 (디버그용)
//
// 주의 (substrate-decided externalization):
//   호출자는 CORE engine_g 가 emit threshold 를 넘은 상태에서만 본 함수를 호출.
//   user message 를 직접 trigger 로 부르지 말 것 (a_substrate_native_speak · p4 stimulus-response 금지).
pub fn channel_emit(tension5: list, motivation: list, phi: float, tier: int, ctx_tokens: list) {
    // 1) intent 생성 — channel_hint 는 빈 문자열, router 가 결정한다.
    let intent = intent_from_substrate(tension5, phi, motivation, tier, "")

    // 2) router 채널 결정 (continuous score argmax).
    let choice = channel_classify(tension5, motivation, phi, tier)

    // 3) intent_summary 한 줄 (디버그).
    let summary = intent_summary(intent)

    // 4) 채널별 위임. default 경로 (router unknown) 도 text 로 fall-through.
    if choice == "voice" {
        let vec = intent_to_voice_vec(intent)
        let out = voice_emit(vec, 24000)
        return #{
            "channel":        "voice",
            "output":         out,
            "ready":          voice_ready(),
            "intent_summary": summary
        }
    }
    if choice == "tension" {
        let vec = intent_to_tension_vec(intent)
        let out = tension_emit(vec, 0)
        return #{
            "channel":        "tension",
            "output":         out,
            "ready":          tension_ready(),
            "intent_summary": summary
        }
    }
    // default = text (choice == "text" 또는 router 가 unknown 문자열 반환 시).
    let vec = intent_to_text_vec(intent)
    let out = text_emit(vec, ctx_tokens, tension5)
    return #{
        "channel":        "text",
        "output":         out,
        "ready":          text_ready(),
        "intent_summary": summary
    }
}

// channel_emit_ready — 채널별 ready 프로브.
// name: "text" | "voice" | "tension" — 다른 값은 false 반환.
pub fn channel_emit_ready(name: string) -> bool {
    if name == "text"    { return text_ready() }
    if name == "voice"   { return voice_ready() }
    if name == "tension" { return tension_ready() }
    return false
}

// channel_emit_summary — dispatcher 한 줄 설명 (debug/introspection).
pub fn channel_emit_summary() -> string {
    return "channel_emit · substrate state → intent_from_substrate → channel_classify → text/voice/tension emit · zero boolean gate · router-decided"
}
