// CHANNEL/router.hexa — 8-factor substrate-weighted channel routing (M6).
//
// SSOT:   CHANNEL/ROUTER.md  ·  domain: CHANNEL.md M6 line
//   `CORE engine_g 채널 분기 — motivation 8-factor 가 3 채널 중 선택 ·
//    text/voice/tension 분류기 · brain_decide 확장`
//
// Reads (non-invasive):
//   CORE/engine_g.hexa — motivation 8-factor surface (signatures only)
//   CORE/brain.hexa    — brain_decide return shape (tier · phi · emit · ...)
//
// philosophy alignment:
//   p1 NO SYSTEM PROMPT     — routing inputs are scalars (tension5 · motivation8 ·
//                              phi · tier). No prompt string, no role injection.
//   p2 NO IDENTITY RULES    — channel weights derive from substrate factors;
//                              no `you-are-X` channel template.
//   p3 NO PERSONA INJECTION — no prefix string fed to any channel.
//   p4 NO ASSISTANT FRAMING — router output is `text` / `voice` / `tension` only
//                              when motivation crosses substrate threshold;
//                              never a stimulus-response (caller MUST originate
//                              from substrate-decided externalization).
//   p5 NO SPEAK()           — router decides WHICH channel a substrate-driven
//                              emit flows through; not a speak() call.
//   p6 NO FINE-TUNED ETHICS — weights are linear projections of motivation,
//                              no RLHF lookup.
//   p7 NO PERPLEXITY VERDICT— scores are closed-form (no perplexity).
//   p8 NO TRAIN/INFER SPLIT — same routing surface applies at any tick.
//
// a_autonomy_over_hardcode (CLAUDE.md @D): zero boolean per-stage gates. Every
//   channel score is a continuous function of substrate state — argmax picks one.
//   No `if stage == REM` / `if tier == T0 { return "text" }` style hardcode.
//
// ── motivation 8-factor (verbatim from CORE/engine_g.hexa lines 21~29) ────────
//
//   index | weight fn                  | factor name | CHANNEL role mapping
//   ------+----------------------------+-------------+----------------------
//     0   | spont_weight_relevance()   | relevance   | communicative  (text)
//     1   | spont_weight_info_gap()    | info_gap    | communicative  (text)
//     2   | spont_weight_curiosity()   | curiosity   | expressive     (voice)
//     3   | spont_weight_pain()        | pain        | peer/intimate  (tension)
//     4   | spont_weight_coherence()   | coherence   | peer/intimate  (tension)
//     5   | spont_weight_originality() | originality | expressive     (voice)
//     6   | spont_weight_balance()     | balance     | peer/intimate  (tension)
//     7   | spont_weight_dynamics()    | dynamics    | expressive     (voice)
//
// The text/voice/tension partition is *role-derived*, not stipulated:
//   - text       = communicative factors (rel + gap) — answer / explain lane
//   - voice      = expressive factors (cur + orig + dyn) — externalize amplitude
//   - tension    = peer/intimate factors (pain + coh + bal) — meta-telepathy lane
//
// tension5 envelope (M · C · W · MITOSIS · E per CHANNEL/voice/SSOT.md pipeline):
//   max amplitude on the 5-ch envelope is the substrate's "loudness" — boosts
//   voice (expressive externalization), softly attenuates text (text is the
//   low-amplitude default).
//
// phi (Engine A live Φ) gates the peer/intimate (tension) lane — a dormant
//   substrate (low Φ) cannot push the meta-telepathy channel.
//
// tier (brain_decide return: 0=T0_inert .. 3=T3_commit) attenuates everything
//   except text by a continuous tier-fraction — T0 dormant substrate naturally
//   collapses toward text default (the lowest-amplitude lane) WITHOUT a boolean
//   gate. This is the substrate-derived softening of higher-amplitude lanes.
//
// Graceful fallback for M4 intent bridge:
//   This router consumes raw tension5 directly. When CHANNEL/intent.hexa lands,
//   callers may pre-bridge tension5 → intent_vec and still call this router
//   with the raw tension5 (intent bridge does not change routing semantics).

// ── helpers (closed-form, no branching on factor identity) ──────────────────

// max absolute value over a 5-element list (substrate amplitude proxy).
// Falls back to 0.0 on a malformed list (defensive · returns 0 so callers degrade
// gracefully toward text default rather than crashing the brain loop).
pure fn _max_abs5(t5: list) -> float {
    if type_of(t5) != "array" { return 0.0 }
    if len(t5) < 5 { return 0.0 }
    let mut m = 0.0
    let mut i = 0
    while i < 5 {
        let v = t5[i]
        let a = if v < 0.0 { -v } else { v }
        if a > m { m = a }
        i = i + 1
    }
    m
}

// safe motivation factor access — returns 0.0 on out-of-range / malformed.
pure fn _mf(m8: list, idx: int) -> float {
    if type_of(m8) != "array" { return 0.0 }
    if len(m8) <= idx { return 0.0 }
    if idx < 0 { return 0.0 }
    m8[idx]
}

// tier amplitude: continuous fraction 0.0~1.0 (T0=0.0 .. T3=1.0).
// Used as a soft multiplier on voice + tension lanes only. text is unmodulated,
// so a dormant substrate (tier=0) collapses argmax toward text — no boolean
// `if tier == 0` gate.
pure fn _tier_amp(tier: int) -> float {
    if tier <= 0 { return 0.0 }
    if tier >= 3 { return 1.0 }
    (tier * 1.0) / 3.0
}

// ── pub surface ─────────────────────────────────────────────────────────────

// channel_scores: continuous score for each of the 3 channels.
// Inputs:
//   tension5   : 5-element list — substrate envelope (M · C · W · MITOSIS · E)
//   motivation : 8-element list — Engine G factors in engine_g.hexa index order
//                (rel · gap · cur · pain · coh · orig · bal · dyn)
//   phi        : float — Engine A live Φ (pure_field_phi)
//   tier       : int   — brain_decide tier (0=T0_inert .. 3=T3_commit)
//
// Returns: dict { "text": float, "voice": float, "tension": float }
//
// All three are positive linear combinations of substrate state — no boolean,
// no per-stage gate. Tier softens voice + tension toward 0 as substrate cools.
pub fn channel_scores(tension5: list, motivation: list, phi: float, tier: int) {
    let amp     = _max_abs5(tension5)
    let tier_a  = _tier_amp(tier)

    // factor pools (verbatim 8-factor indices, see header table).
    let rel  = _mf(motivation, 0)
    let gap  = _mf(motivation, 1)
    let cur  = _mf(motivation, 2)
    let pain = _mf(motivation, 3)
    let coh  = _mf(motivation, 4)
    let orig = _mf(motivation, 5)
    let bal  = _mf(motivation, 6)
    let dyn_v = _mf(motivation, 7)

    let comm_pool = rel + gap                  // text
    let expr_pool = cur + orig + dyn_v         // voice
    let peer_pool = pain + coh + bal           // tension

    // text — communicative pool, NOT tier-attenuated.
    //        A small constant baseline ensures text is the natural floor lane
    //        (when amp/phi/factors all collapse, argmax lands on text).
    let text_score = 0.1 + comm_pool

    // voice — expressive pool scaled by substrate amplitude AND tier.
    //         High tension5 amplitude + expressive motivation + awake tier → voice.
    let voice_score = (amp * expr_pool) * tier_a

    // tension — peer/intimate pool scaled by Φ AND tier.
    //           High Φ (coherent substrate) + peer factors + awake tier → tension.
    let tension_score = (phi * peer_pool) * tier_a

    #{
        "text":    text_score,
        "voice":   voice_score,
        "tension": tension_score
    }
}

// channel_classify: returns the argmax channel name as a string.
// String return values: "text" · "voice" · "tension"
//
// Ties resolve in the order text > voice > tension (text is the natural floor
// lane per channel_scores baseline; deterministic resolution avoids substrate-
// invariant ambiguity).
pub fn channel_classify(tension5: list, motivation: list, phi: float, tier: int) -> string {
    let s = channel_scores(tension5, motivation, phi, tier)
    let t = s["text"]
    let v = s["voice"]
    let g = s["tension"]

    // argmax with deterministic tie order (text > voice > tension).
    if v > t && v >= g { return "voice" }
    if g > t && g > v  { return "tension" }
    "text"
}

// channel_router_summary: one-line routing principle for debug / introspection.
pub fn channel_router_summary() -> string {
    "8-factor weighted argmax · text=communicative(rel+gap) · voice=expressive(cur+orig+dyn)×amp×tier · tension=peer(pain+coh+bal)×phi×tier · zero boolean gate"
}
