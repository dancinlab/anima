// ════════════════════════════════════════════════════════════════════════════
//  clm_causal_hw.hexa — CLM CAUSAL-POWER LIVE pi5 AKD1000 HW 드라이버 (F-CLM-CAUSAL-XFER axis B)
//
//  H_856. toy 🟢 CAUSAL-POWER 가 REAL SILICON(라이브 AKD1000 온칩 threshold-and-
//  fire, akida_sw_lif 아님)에서 생존하는가를 사전등록 frozen 3-check 로 검증한다.
//
//  설계(g0/g1 재사용 우선):
//    - 측도 CAUSAL-POWER 는 measure_sweep.py(frozen) import — 재구현/재튜닝 금지.
//    - chip 모델 = spike_streamer.py 패턴: InputData(1,1,16) → FullyConnected(N,
//      weights=ones, act_bits=1) → BackendType.Hardware 매핑. potential=Σinput,
//      per-unit int32 threshold, 온칩 binary threshold-and-fire.
//    - 적분 메커니즘: chip 은 feedforward → SW 폐루프로 coupling 을 칩 주위에 닫음.
//      각 step 입력 = (rich) 직전 온칩 spike 피드백 + per-region 드라이브. spike
//      결정은 매 step 실 칩(model.forward). toy gen_spike 와 동치:
//        collapse = region0 monopoly 드라이브 + coupling 0(decoupled).
//        rich     = 균형 드라이브 + 강 coupling(칩 주위 적분, edge-of-chaos 부분발화).
//    - drive 는 per-unit threshold(=POT−drive)로 인코딩 — 비교는 ON-CHIP.
//
//  HARD: pi5 단일칩 file-lock — 라이브 spike 수집 = streamer service stop →
//  collect → streamer RESTART(pi5 원상복구). COFFESHOP-on-AKIDA 라이브루프 패턴.
//  HARD: Mac=0 · poke ≤16 · 정직 보고(임계 재조정 0). pure-hexa · fn main 자동발화.
//  sibling axis A(production CLM spike, ubu-1 GPU) = CLM/msweep/clm_causal_prod.py.
// ════════════════════════════════════════════════════════════════════════════

// frozen 측도 임계 (measure_sweep.py 와 1:1 — 참조용, NOT re-tune).
fn clm_causal_hw_margin_frac() -> float { return 0.10 }
fn clm_causal_hw_poke_cap() -> int { return 16 }

// chip 모델 (spike_streamer.py SSOT) — InputData→FullyConnected LIF pool.
fn clm_causal_hw_chip() -> string { return "InputData(1,1,16)->FC(N,ones,act_bits=1)@Hardware" }

// 라이브 HW run 호출 (pi5 venv) — streamer stop/restart 는 호출측 절차.
fn clm_causal_hw_cmd(seed: int) -> string {
    return "CLM_MSWEEP=$PWD python3 clm_causal_hw.py --json --seed " + to_string(seed)
}

// streamer 원상복구 커맨드 (pi5 as-found) — duration·regime 보존.
fn clm_causal_hw_streamer_restore() -> string {
    return "spike_streamer.py --port 9512 --duration 86400 --regime R3"
}

fn main() {
    let seed = 187
    println("[clm_causal_hw] F-CLM-CAUSAL-XFER axis B — live AKD1000 HW transfer")
    println("[clm_causal_hw] chip=" + clm_causal_hw_chip()
        + " margin_frac=" + to_string(clm_causal_hw_margin_frac())
        + " poke_cap=" + to_string(clm_causal_hw_poke_cap()))
    println("[clm_causal_hw] payload: " + clm_causal_hw_cmd(seed))
    println("[clm_causal_hw] streamer restore: " + clm_causal_hw_streamer_restore())
    println("[clm_causal_hw] (pi5 single-chip: stop streamer -> collect -> RESTART · Mac=0)")
}
