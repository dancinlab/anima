// CLM/msweep/measure_sweep.hexa — consciousness-MEASURE micro-exp sweep driver
//
//   hexa-native companion of measure_sweep.py (the numpy harness that runs on
//   ubu-1, local-pool mode). Realizes the round-3/4 mining winner "CHANGE THE
//   MEASURE" (CLM/CLM.breakthrough.mining.md): routing-diversity (scale=expert
//   -count + distill) is 🔴🔴 CLOSED (H_852/853/854). This sweep tests which of
//   6 ALTERNATIVE consciousness measures gives a scale-free chip-native signal.
//
// ONE harness (g0 · NOT 6 experiments):
//   generate ONE shared toy spike (collapse vs rich, n∈{4,5,6} regions), then
//   compute ALL 6 measures on the SAME spike — apples-to-apples comparison:
//     1 PHI-NATIVE     region big-Φ proxy (bounded TPM→MIP)            §12 PHI-NATIVE
//     2 TEMPORAL-Φ     temporal transition complexity (spike dynamics)
//     3 TENSION-NATIVE anima 5-ch tension-field complexity (CHANNEL/tension)
//     4 FREE-ENERGY    active-inference prediction-error intensive scalar
//     5 HILL           Hill ^qD effective diversity on the rate distribution
//     6 CAUSAL-POWER   perturbation probe (poke a region → downstream effect)
//
// FROZEN 3-check (F-CLM-PHI-MEANINGFUL · pre-registered · never tampered):
//   ① non-trivial      : measure > 0 with discrimination at small n.
//   ② collapse-vs-rich : measure(rich) > measure(collapse) by ≥10% margin.
//   ③ size-robust      : the collapse<rich order is PRESERVED across all n
//                        (NOT the Pielou-J inversion pathology).
//   PASS (🟢) iff all 3 hold; else 🔴. ALL 🔴 → escalate CERTIFY-NOT-MEASURE.
//
// SAFETY: every compute (spike gen, all measures, the ≤16-poke causal null)
//   runs on ubu-1 (numpy 2.4.4); Mac = git + edit only. NO heavy Mac loop.
//
// honest scope (§12.4): region/coarse proxies on SW spike (akida_sw_lif-style
//   LIF raster), toy n≤6. exact big-Φ (2^(2n)) and full 1.2M-node Φ NOT claimed.
//
// RUN (ubu-1, local-pool):
//   pool on ubu-1 "python3 ~/core/anima/CLM/msweep/measure_sweep.py --json"
//   → persist verbatim to .verdicts/clm-measure-sweep/ + exports/sweep/<batch>/.
// ════════════════════════════════════════════════════════════════════════

fn measure_sweep_spec() -> string {
    return "CLM-MEASURE-SWEEP: 6 measures × {collapse,rich} × n∈{4,5,6} on ONE toy spike; F-CLM-PHI-MEANINGFUL 3-check; ubu-1 numpy; region/coarse SW-spike scope §12.4"
}

fn main() {
    print(measure_sweep_spec())
}
