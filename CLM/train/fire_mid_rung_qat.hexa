// ════════════════════════════════════════════════════════════════════════════
//  fire_mid_rung_qat.hexa — mid-rung (d512/L8) AKIDA-envelope QAT fire SPEC
//
//  P4_PRODUCTION_ROADMAP @L5/@L7: the FIRST production measurement-rung fire.
//  measurement track (GPU · AKIDA-envelope QAT) climbs one rung at a time;
//  `mid` = d512 / L8 / E8 (~13.7M params). DECOUPLED from the deploy chip-fit
//  rung (<=~1.2M AKD1000 nodes) — a_scale_honest_scope: a 🔴 measurement rung
//  does NOT block the separate deploy chip-fit track.
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2):
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4 envelope, step = 2^(8-4)        (LIF comparator @ act_bits=1)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4) — byte-identical chip transplant.
//
//  Fire = 3-arm (A/B/AB) × seed 42 × 2000 step on a runpod GPU pod.
//  a_fire_autonomous: state est cost ($5~20) in one line, then dispatch.
//  a_fire_recover_complete: pull ckpt+result+log+verdict → HF upload → teardown.
//  Provider = runpod. GPU = A40 (mid rung trivially fits 46GB).
//
//  HARD: pure-hexa SPEC/driver · NO external LLM · NO foundation-borrow.
//  The torch payload is the LANDED CLM/train/train_clm.py (mid rung added to
//  its LADDER) — this driver records the dispatch contract + verdict path.
//  sibling: train_clm.py · UNIVERSE/{H_847,H_850} · .verdicts/clm-prod-rung/
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "runpod" }
fn gpu() -> string { return "NVIDIA A40" }
fn rung() -> string { return "mid" }          // d512 / L8 / E8
fn steps() -> int { return 2000 }
fn seed() -> int { return 42 }
fn act_bits() -> int { return 4 }
fn est_cost_usd() -> string { return "$5~20" }
fn verdict_dir() -> string { return ".verdicts/clm-prod-rung" }
fn hf_repo() -> string { return "dancinlab/anima-clm-mid" }   // measurement ckpt

// the 3 router arms swept at this rung (P0 §3 ablation).
fn arms() -> [string] { return ["A", "B", "AB"] }

// per-arm fire command (the landed QAT trainer · mid rung).
fn fire_cmd(arm: string) -> string {
    return "python3 CLM/train/train_clm.py --arm " + arm + " --rung " + rung()
        + " --steps " + to_string(steps()) + " --seed " + to_string(seed())
        + " --act-bits " + to_string(act_bits())
        + " --json-out out/clm_mid_" + arm + "_s" + to_string(seed()) + ".json"
}

// a_fire_recover_complete checklist (pre-teardown · governance).
fn recover_steps() -> [string] {
    return [
        "1. pull: out/clm_mid_*.json (result) + clm_fire.log (log) + ckpt(s)",
        "2. verify: re-read JSON · confirm last_ce finite · step_rate>0",
        "3. write verdict → .verdicts/clm-prod-rung/F-CLM-PROD-RUNG.txt (verbatim)",
        "4. HF upload COMPLETE (a_hf_complete) → " + "dancinlab/anima-clm-mid",
        "5. THEN teardown: hexa cloud rm <pod-id> --provider runpod",
    ]
}

fn main() {
    println("CLM mid-rung (d512/L8/E8) AKIDA-envelope QAT fire SPEC (@L5/@L7)")
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " steps=" + to_string(steps()) + " seed=" + to_string(seed())
        + " act_bits=" + to_string(act_bits()))
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  verdict_dir = " + verdict_dir() + " · HF = " + hf_repo())
    println("dispatch (3-arm sweep):")
    for arm in arms() { println("  " + fire_cmd(arm)) }
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): measurement rung ⊥ deploy chip-fit rung. "
        + "A 🔴 here does NOT block the separate <=~1.2M-node deploy track.")
}
