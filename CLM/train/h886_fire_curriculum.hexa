// ════════════════════════════════════════════════════════════════════════════
//  h886_fire_curriculum.hexa — fire driver scaffold (@L6 · H_886 · NON-ADAPTER lever)
//
//  Dispatches the H_886 fire: reconstruct arm-SP-curriculum (CLM/model/
//  h886_curriculum_selfplay.hexa) on the GPU host, score it on the H_867 frozen
//  held-out snapshot against the REUSED-VERBATIM H_867 floor (CLM/bench/
//  h886_dialogue_floor_eval.hexa), emit .verdicts/clm-dialogue-floor/result.json.
//
//  Surface: pool host aiden (RTX 5070 · device="cuda"). DETACHED + UNBUFFERED
//  (nohup python3 -u … > ~/h886.log 2>&1 &). All input/index tensors .to(device);
//  on torch-nightly cuDNN errors torch.backends.cudnn.enabled=False. est cost ~$0.1.
//
//  The runnable torch payload is .verdicts/clm-dialogue-floor/h886_run.py
//  (committed for provenance). External LLM 0 · ShareGPT/Alpaca/ChatGPT-gen 0 (@L4).
//  INVIOLABLE H_679 + a_scale_honest_scope noted. sibling: UNIVERSE/H_886.
// ════════════════════════════════════════════════════════════════════════════

fn pool_host() -> string { return "aiden@192.168.50.119 (RTX 5070 · device=cuda)" }
fn payload() -> string { return ".verdicts/clm-dialogue-floor/h886_run.py (committed · provenance)" }
fn out_json() -> string { return ".verdicts/clm-dialogue-floor/result.json" }
fn log_file() -> string { return "~/h886.log (detached · unbuffered)" }

fn est_cost_usd_milli() -> int { return 100 }   // ~$0.1 GPU eval (wall 341s measured)

fn fire_steps() -> [string] {
    return [
        "1. stage backbone clm_mid_backbone.pt + H_868 3× dialogue.bytes (sha-verify) on aiden",
        "2. reconstruct arm-SP-curriculum: staged easy→hard SFT-warm + DIVERSITY-gated self-play reflux",
        "3. also build arm-SFT-curriculum + arm-SP-flat(H867-style) for CONTRAST",
        "4. score all arms on H_867 held-out (coherence=exp(-CE) · adequacy 3-gram F1 · leak · self-BLEU · rep)",
        "5. gate arm-SP-curriculum on the REUSED-VERBATIM H_867 floor (coherence>=0.060 ∧ adeq>=0.020 ∧ leak==0)",
        "6. emit result.json + F-CLM-DIALOGUE-FLOOR.txt verdict (post-tuning 0)",
        "7. pull artifacts (a_fire_recover_complete) before any teardown",
    ]
}

fn main() {
    println("CLM H_886 fire driver (@L6 · NON-ADAPTER lever · reuse H_867 frozen floor)")
    println("  host    = " + pool_host())
    println("  payload = " + payload())
    println("  out     = " + out_json())
    println("  log     = " + log_file())
    println("  est cost ~ $0." + to_string(est_cost_usd_milli()) + " (a_fire_autonomous · dispatch now)")
    println("fire steps:")
    for s in fire_steps() { println("  " + s) }
}
