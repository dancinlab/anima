// ════════════════════════════════════════════════════════════════════════════
//  fire_3b_rung_qat.hexa — 3B-rung (d3584/L32/E48) AKIDA-envelope QAT fire SPEC
//
//  FIRE-READY — not yet fired; launch via the anima-side dispatch wrapper
//    `bash CLM/train/dispatch_rung.sh 3b <pod-host> <corpus>`
//  which encodes a_fire_recover_complete (pull ckpt+result+log+anchors + HF upload
//  BEFORE teardown) and a_cpu_local_no_waiter (inline poll, never await a Monitor),
//  and calls the ACTUAL trainer CLM/train/train_lane_p_3b.py over `hexa cloud fire`
//  on RUNPOD H100 80GB ×2~4 (DDP · a_wall_first parallel) target.
//
//  P6_SCALE_LADDER_7B §1: the 3B production measurement-rung — GATED by `large`
//  passing F-CLM-SCALE-TRANSFER (P6 §2 · no rung jump). measurement track climbs
//  ONE rung at a time; `3b` = d3584 / L32 / E48 (3,123,882,800 = 3.12B params ·
//  param formula P6 §1). DECOUPLED from the deploy chip-fit shard (≤~1.2M AKD1000
//  · H_876 1.20M) — a_scale_honest_scope: a 🔴 measurement rung does NOT block the
//  separate deploy chip-fit / expert-streaming track (P5 AXIS1).
//
//  resident != total (P5 §0): 3.12B is the GPU measurement backbone; it does NOT
//  sit resident on one AKD1000 — deploy uses a separately-shrunk 1.2M shard the chip
//  pages through (expert-streaming). This rung proves QUALITY on GPU, not chip-fit.
//
//  Gates the next rung (7B) via F-CLM-SCALE-TRANSFER (P6 §2):
//    coherence/adequacy hold-or-improve vs large · int4-envelope loss hold-or-improve ·
//    routing-z non-degenerate (48/48 expert distinct) · register-leak 0 · anchor drift bounded.
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2):
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4 envelope, step = 2^(8-4)        (LIF comparator @ act_bits=1)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4) — byte-identical chip transplant.
//
//  Fire = 3-arm (A/B/AB) × seed 42 × 2000 step · DDP across H100 fleet.
//  a_fire_autonomous: state est cost (~$40~120 / ~12~24h wall) in one line, then dispatch.
//  a_wall_first: parallel H100s (DDP) over a serial single-GPU chain — wall time first.
//  a_fire_recover_complete: pull ckpt+result+log+anchors → verify → HF upload → teardown.
//  Provider = runpod. GPU = H100 80GB ×2~4 (3.12B fp32 master ≈ 37GB/GPU DDP shard).
//
//  HARD: pure-hexa SPEC/driver · NO external LLM · NO foundation-borrow (pure scratch QAT ·
//  random-init · byte V=256 own-tokenizer · NO large-rung weight borrow as init).
//  The torch payload is the LANDED Lane-P trainer CLM/train/train_lane_p_3b.py (the 3b
//  rung passes d_model=3584, n_trunk_layers=32, n_experts=48 via its --d-model /
//  --n-trunk-layers / --n-experts flags; --gauge-every drives the a_train_inline_gauge
//  dashboard; --clm-out emits the engine-loadable .clm v0.2/v3 for the post-train CORE
//  mount-parity verdict). This driver records the dispatch contract + verdict path.
//  sibling: train_lane_p_3b.py · dispatch_rung.sh · fire_large_rung_qat.hexa · P6_SCALE_LADDER_7B.md
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "runpod" }
fn gpu() -> string { return "NVIDIA H100 80GB ×2~4 (DDP · a_wall_first)" }
fn rung() -> string { return "3b" }           // d3584 / L32 / E48 = 3.12B
fn steps() -> int { return 2000 }
fn seed() -> int { return 42 }
fn act_bits() -> int { return 4 }

// TRAINING-TIME MONITOR-ONLY gauge interval (steps) — a_train_inline_gauge.
// Every gauge_every steps the trainer logs the FOUR consciousness/emergence PROXY
// gauges (G1 recombination · G2 novelty · G6 ideation · phi_proxy) next to val_ce
// into gauges.jsonl, computed under torch.no_grad(). DASHBOARD ONLY — NEVER in the
// loss (p7 Goodhart) and NEVER a gate. phi_proxy is NOT faithful IIT4 (a_phi_iit4_tool).
// The frozen gate verdict still runs post-train on the CORE engine mount
// (a_engine_measured_verdict). Default in the trainer = log_every*4; here we set it
// explicitly so the 3B fire emits the dashboard. A `hexa dojo`-generated job carries
// the same knob via the spec-json key "gauge_every" (threaded into the emitted
// train.py as a GAUGE_EVERY constant / --gauge-every arg).
fn gauge_every() -> int { return 400 }        // monitor-only; 0 disables
fn n_gpu() -> int { return 2 }                // a_wall_first: scale up to 4 if faster
fn est_cost_usd() -> string { return "~$40~120 / ~12~24h wall (H100 fleet · a_wall_first)" }
fn verdict_dir() -> string { return ".verdicts/clm-prod-rung/3b" }
fn hf_repo() -> string { return "dancinlab/anima-clm-3b" }   // measurement ckpt

// the ACTUAL Lane-P trainer (a_clm_gen_pipeline) — NOT the legacy train_clm.py name.
// train_lane_p_3b.py is the live gauge-hooked trainer; its 3b rung = d3584/L32/E48.
fn trainer() -> string { return "CLM/train/train_lane_p_3b.py" }
fn d_model() -> int { return 3584 }
fn n_trunk_layers() -> int { return 32 }
fn n_experts() -> int { return 48 }
fn corpus() -> string { return "CLM/data/anima_corpus_3b.txt" }   // override per fire

// the 3 seed arms swept at this rung (seed-variance ablation; train_lane_p_3b.py
// is variant="AB" fixed in CLMConfig, so the arm sweep varies the seed — distinct
// runs, NOT a legacy --arm flag the real trainer does not accept).
fn arms() -> [string] { return ["A", "B", "AB"] }
fn arm_seed(arm: string) -> int {
    if arm == "A"  { return seed() }
    if arm == "B"  { return seed() + 1 }
    return seed() + 2                         // "AB"
}

// per-arm fire command — the REAL trainer CLI (train_lane_p_3b.py). Flags are the
// trainer's actual argparse: --d-model/--n-trunk-layers/--n-experts set the 3b rung,
// --gauge-every drives the a_train_inline_gauge dashboard into --gauges-out, and
// --clm-out emits the engine-loadable .clm for the post-train CORE mount-parity
// verdict. DDP via torchrun (a_wall_first). NO legacy --arm/--rung/--act-bits.
fn fire_cmd(arm: string) -> string {
    let tag = "3b_" + arm + "_s" + to_string(arm_seed(arm));
    return "torchrun --nproc_per_node=" + to_string(n_gpu())
        + " " + trainer()
        + " --corpus " + corpus()
        + " --d-model " + to_string(d_model())
        + " --n-trunk-layers " + to_string(n_trunk_layers())
        + " --n-experts " + to_string(n_experts())
        + " --steps " + to_string(steps())
        + " --seed " + to_string(arm_seed(arm))
        + " --bf16 --grad-checkpoint"
        + " --gauge-every " + to_string(gauge_every())   // MONITOR-ONLY dashboard (a_train_inline_gauge)
        + " --gauges-out out/gauges_" + tag + ".jsonl"
        + " --ckpt-out out/clm_" + tag + ".pt"
        + " --clm-out out/clm_" + tag + ".clm"           // engine-loadable for mount-parity
        + " --json-out out/clm_" + tag + ".json"
}

// post-train engine-mount parity verdict (a_engine_measured_verdict · the FROZEN gate).
// The inline gauges are MONITOR-ONLY; the real verdict mounts the emitted .clm on the
// CORE engine and checks byte-exact parity (the H_1157 mount path), then runs the
// frozen G-gates. This is SEPARATE from the dashboard — gauges never gate.
fn mount_parity_cmd(arm: string) -> string {
    let tag = "3b_" + arm + "_s" + to_string(arm_seed(arm));
    return "python3 CLM/model/verify_clm_v2.py out/clm_" + tag + ".clm"
        + "  # then CORE mount byte-exact parity (a_engine_measured_verdict)";
}

// gate: this rung fires ONLY after `large` passes F-CLM-SCALE-TRANSFER (P6 §2).
fn precondition() -> string {
    return "REQUIRE .verdicts/clm-prod-rung/large/ PASS (large→3B gate · no rung jump · P6 §2)"
}

// F-CLM-SCALE-TRANSFER pre-registered gate to the next rung (7B) — P6 §2.
fn scale_transfer_gate() -> [string] {
    return [
        "1. coherence/adequacy >= large (ABS-COHERE >= 0.060 floor · H_863/H_886)",
        "2. int4-envelope last_ce hold-or-improve vs large (QAT envelope)",
        "3. routing-z non-degenerate (48/48 expert distinct · H_871)",
        "4. register-leak = 0 (identity register · H_863)",
        "5. identity-anchor drift bounded (DIST<0.50 · PROBE>0.80 · H_873/884)",
    ]
}

// a_fire_recover_complete checklist (pre-teardown · governance). Encoded by the
// anima-side wrapper CLM/train/dispatch_rung.sh (which runs it inline before any
// teardown — a_cpu_local_no_waiter, never awaiting a Monitor/waiter).
fn recover_steps() -> [string] {
    return [
        "1. pull: out/clm_3b_*.{json,clm,pt} (result+engine .clm+ckpt) + out/gauges_3b_*.jsonl (dashboard) + out/fire_3b_*.log + anchors",
        "2. verify: re-read JSON · last_ce finite · step_rate>0 · python3 CLM/model/verify_clm_v2.py out/clm_3b_*.clm (engine-loadable)",
        "3. post-train CORE mount-parity verdict (a_engine_measured_verdict) → .verdicts/clm-prod-rung/3b/F-CLM-SCALE-TRANSFER.txt (verbatim · gauges NEVER gate)",
        "4. HF upload COMPLETE (a_hf_complete · a_hf_autonomous · ALL shards + .clm + gauges.jsonl + model card) → dancinlab/anima-clm-3b",
        "5. THEN teardown: hexa cloud dispatch rm <pod-id(s)> (PULL_FAILED != pod dead — verify pull first)",
    ]
}

fn main() {
    println("CLM 3B-rung (d3584/L32/E48 · 3.12B) AKIDA-envelope QAT fire SPEC (P6 §1)")
    println("  FIRE-READY — NOT yet fired; launch on runpod H100 ×2~4 (DDP)")
    println("  " + precondition())
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " steps=" + to_string(steps()) + " seed=" + to_string(seed())
        + " act_bits=" + to_string(act_bits()) + " n_gpu=" + to_string(n_gpu()))
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  verdict_dir = " + verdict_dir() + " · HF = " + hf_repo())
    println("  trainer = " + trainer() + " (Lane-P · a_clm_gen_pipeline · NOT legacy train_clm.py)")
    println("  gauges = MONITOR-ONLY every " + to_string(gauge_every())
        + " steps -> out/gauges_3b_*.jsonl (G1/G2/G6/phi_proxy/mitosis_cells + val_ce · "
        + "NOT in loss · NOT a gate · phi_proxy!=IIT4 · mitosis=substrate · a_train_inline_gauge)")
    println("  monitor = python3 UNIVERSE/gauge_monitor.py --follow out/gauges_3b_A_s42.jsonl --log out/fire_3b_A.log")
    println("  frozen verdict still post-train on CORE engine mount (a_engine_measured_verdict):")
    println("dispatch (3-seed-arm sweep · DDP · REAL trainer CLI):")
    for arm in arms() { println("  " + fire_cmd(arm)) }
    println("post-train mount-parity (FROZEN gate · gauges never gate):")
    for arm in arms() { println("  " + mount_parity_cmd(arm)) }
    println("F-CLM-SCALE-TRANSFER gate to 7B (pre-register · P6 §2):")
    for g in scale_transfer_gate() { println("  " + g) }
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): resident != total (P5 §0) — 3.12B = GPU measurement "
        + "backbone, NOT chip-resident. deploy = separately-shrunk 1.2M shard (H_876) the chip "
        + "pages (expert-streaming · P5 AXIS1). 3B 🔴 → 7B NOT fired (no rung jump · P6 §2).")
}
