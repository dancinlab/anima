// ════════════════════════════════════════════════════════════════════════════
//  train_clm.hexa — CLM P2 QAT trainer hexa-native DRIVER (d5: hexa 1순위)
//
//  P0 d5: "hexa-native 학습 = 1순위(g1-pure)". hexa 학습속도 해결됨(2026-05-30)
//  전제 위에서, 이 .hexa 가 트레이너의 hexa-native 진입점(드라이버)이다.
//
//  현재 학습 PAYLOAD(QAT forward/backward · STE · CE+envelope 손실)는 torch
//  autograd 에 의존하므로 CLM/train/train_clm.py 가 담당한다(.py = 페이로드).
//  이 드라이버는:
//    (1) 3-arm(A/B/AB) × scale-ladder(tiny/small) 파라미터를 hexa 에서 조립,
//    (2) free-pool d16 dry-run smoke 를 먼저 돌려 import/path 결함을 잡고,
//    (3) python3 train_clm.py 페이로드를 인자와 함께 호출한다.
//  hexa-native autograd(CLM forward+STE)가 g1-pure 로 닫히면, 페이로드를
//  이 파일로 흡수(.py 폴백 은퇴)하는 것이 후속 목표.
//
//  HARD: pure-hexa · NO main 자동발화 주의(fn main 은 run 시 자동발사).
//  추론 AKIDA-int4-only 불변 — 이 파일은 GPU/CPU QAT pretrain 만 다룬다.
// ════════════════════════════════════════════════════════════════════════════

// scale-ladder rung 파라미터 — python 페이로드 LADDER 와 1:1 동기 (SSOT = 이 .hexa).
// P0 d3 toy rungs (tiny/small) + P6 production measurement-rungs (mid/large).
// dims (d_model / n_trunk_layers / n_experts) · param-counts P6_SCALE_LADDER_7B §1:
//   tiny  d64/L2/E4    = 120,132      · small d256/L4/E8  = 2,695,176
//   mid   d512/L8/E8   = 13,653,768   · large d768/L12/E12 = 44,678,668
// NOTE: train_clm.py LADDER MUST carry the same {mid,large} keys (1:1) or
//   build()→LADDER[rung] KeyErrors. P6 measurement track = GPU PLASTI-SIM
//   instrument (NOT the deploy learner — §0/§3).
fn clm_rung_args(rung: string) -> string {
    if rung == "tiny"  { return "--rung tiny" }
    if rung == "small" { return "--rung small" }
    if rung == "mid"   { return "--rung mid" }
    if rung == "large" { return "--rung large" }
    return "--rung tiny"
}

// rung dims (SSOT) — exposed so the payload can be driven explicitly once
// train_clm.py grows --d-model/--n-trunk-layers/--n-experts overrides (then
// the .py LADDER dict retires · full hexa-native ① migration).
fn clm_rung_dims(rung: string) -> string {
    if rung == "tiny"  { return "64 2 4" }
    if rung == "small" { return "256 4 8" }
    if rung == "mid"   { return "512 8 8" }
    if rung == "large" { return "768 12 12" }
    return "64 2 4"
}

// 3-arm router (P0 §3) — A=entropy-reg · B=topK+load-bal · AB=dual-axis.
fn clm_arm_valid(arm: string) -> bool {
    return arm == "A" || arm == "B" || arm == "AB"
}

// dry-run 스모크 1-step (forward+QAT-loss+backward) — $0 local, step-rate 측정.
fn clm_dryrun_cmd(arm: string, rung: string) -> string {
    return "python3 train_clm.py --dry-run --arm " + arm + " " + clm_rung_args(rung)
}

// full QAT 학습 호출 (local toy 또는 pod) — steps/act_bits/envelope 인자 전달.
fn clm_train_cmd(arm: string, rung: string, steps: int, act_bits: int) -> string {
    return "python3 train_clm.py --arm " + arm + " " + clm_rung_args(rung)
        + " --steps " + to_string(steps)
        + " --act-bits " + to_string(act_bits)
}

fn main() {
    // 기본 구성: AB arm · tiny rung (full-fire 는 3-arm × ladder 전부 — run.sh 참조).
    let arm  = "AB"
    let rung = "tiny"
    if clm_arm_valid(arm) == false {
        println("ERROR: arm must be A|B|AB")
        return
    }

    println("CLM P2 QAT trainer (hexa-native driver · d5 1순위)")
    println("  arm=" + arm + " rung=" + rung + " · weight=int4_sym[-7,7] STE · act=akida envelope")

    // (1) d16 free-pool dry-run smoke FIRST — import/path 결함을 GPU 임대 전에 잡는다.
    let dry = clm_dryrun_cmd(arm, rung)
    println("dry-run smoke: " + dry)
    let out = exec(dry + " 2>&1")
    print(out)

    println("")
    println("full QAT train (local toy · $0):")
    println("  " + clm_train_cmd(arm, rung, 200, 4))
    println("full fire (3-arm × ladder, GPU pod) = CLM/train/run.sh + job.hexa")
}
