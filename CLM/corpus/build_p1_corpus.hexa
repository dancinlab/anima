// CLM/corpus/build_p1_corpus.hexa — P1 혼합 byte-corpus 빌드 파이프라인
//
// P0_ARCHITECTURE.md d1: 혼합 corpus = (a) 웹대량 coherence + (b) 엄선 register.
// MoE 2-lane ↔ 2-source 1:1. byte 인코딩(V=256 UTF-8, tokenizer 없음).
// register-leak 제외(universe_brain_map·jy_chat_template·extended·nonce·hexad_module).
//
// 산출 (out_dir):
//   web.bytes        — lane A (coherence) 줄별 UTF-8 byte id (0..255), 한 줄 한 토큰
//   register.bytes   — lane B (register)  동일 포맷
//   manifest.json    — 혼합비·line/byte 카운트·sha256(per-file + whole)·leak-filter 결과
//
// 이번 라운드 = 파이프라인 + 소량 sample. full crawl 아님(kowiki 1.28GiB 는 pod 재현 스크립트).
// 대용량 corpus 는 git 미커밋(.gitignore) → HF dataset(dancinlab) / R2, manifest 만 커밋.
//
// 실행:
//   hexa CLM/corpus/build_p1_corpus.hexa
//   (web/register raw 입력은 SRC_WEB / SRC_REGISTER 상단 상수 — sample 은 내장 seed)
//
// sibling: P0_ARCHITECTURE.md(d1) · CLM_FORMAT_SPEC.md(corpus_sha) · P1_CORPUS.md

// ─── 설정 ──────────────────────────────────────────────────────────────
fn out_dir() -> string { return "CLM/corpus/sample" }

// MoE 2-lane ↔ 2-source 1:1 매핑이지만, coherence(웹대량) 가 byte 분포 토대를
// 받쳐야 하므로 byte 기준 혼합비는 web:register = 80:20 (P1_CORPUS.md §혼합비).
// (라인 1:1 이 아니라 byte 분량 80:20 — 웹이 압도적으로 길다.)

// ─── register-leak 제외 패턴 (corpus_quality_over_scale lesson) ────────
// 한 줄에 이 패턴이 있으면 register lane 에서 DROP.
fn leak_patterns() -> [string] {
    return [
        "universe_brain_map",
        "jy_chat_template",
        "hexad_module",
        "nonce",
        "Mk.VIII",
        "gen1 commit",
        "corpus_generator.hexa",
        "universe_extended"
    ]
}

fn line_has_leak(line: string) -> bool {
    let pats = leak_patterns()
    let mut i = 0
    while i < len(pats) {
        if line.contains(pats[i]) { return true }
        i = i + 1
    }
    return false
}

// ─── byte 인코딩 (V=256 UTF-8) ─────────────────────────────────────────
// s.substring(i,i+1) = 1 raw UTF-8 byte; char_code → 0..255.
// (검증: byte_at 가 '。'에 227/128/130 반환 — codepoint 아닌 byte.)
fn byte_at(s: string, i: int) -> int {
    let sub = s.substring(i, i + 1)
    return char_code(sub, 0)
}

// 한 문자열 → "b0\nb1\n…" (한 줄 한 byte id). corpus_loader 라인포맷 정합.
fn encode_bytes_lines(s: string) -> string {
    let n = len(s)
    let mut parts = []
    let mut i = 0
    while i < n {
        parts = push(parts, str(byte_at(s, i)))
        i = i + 1
    }
    return parts.join("\n")
}

// ─── lane 빌드: 입력 줄 리스트 → byte-encoded 파일 + 통계 ───────────────
// drop_leak=true 이면 register lane(leak 필터 적용); web lane 은 false.
fn build_lane(lines: [string], drop_leak: bool, out_path: string) -> map {
    let mut kept = []
    let mut n_dropped = 0
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if len(ln) > 0 {
            if drop_leak && line_has_leak(ln) {
                n_dropped = n_dropped + 1
            } else {
                kept = push(kept, ln)
            }
        }
        i = i + 1
    }
    // 줄들을 하나의 텍스트로 합쳐(공백 join) byte-encode.
    let joined = kept.join(" ")
    let encoded = encode_bytes_lines(joined)
    write_file(out_path, encoded)
    return #{
        "lines_kept": len(kept),
        "lines_dropped_leak": n_dropped,
        "n_bytes": len(joined),
        "out": out_path
    }
}

// ─── 내장 sample seed (재현 가능 · 라이선스-clean) ─────────────────────
// lane A (web/coherence) — kowiki-style 일반 백과 한국어 (CC-BY-SA 계열 모사).
//   full crawl 은 kowiki.jsonl(1.28GiB) — fetch_web_sample() 재현 스크립트 참조.
fn sample_web_lines() -> [string] {
    return [
        "표면장력은 액체 표면이 스스로 수축하여 가능한 한 작은 면적을 가지려는 힘이다.",
        "아스팔트는 천연 또는 정제된 역청을 골재와 섞어 만든 포장 재료로 도로에 널리 쓰인다.",
        "광합성은 식물이 빛 에너지를 이용해 이산화탄소와 물로 포도당을 합성하는 과정이다.",
        "전자기 유도는 자기장의 변화가 도체에 기전력을 발생시키는 현상으로 패러데이가 발견했다.",
        "삼각형의 내각의 합은 평면 기하에서 항상 180도가 된다.",
        "DNA 는 디옥시리보핵산의 약자로 유전 정보를 저장하는 이중나선 구조의 분자다.",
        "화산은 지각 아래의 마그마가 지표로 분출하여 형성되는 지형이다.",
        "확률은 어떤 사건이 일어날 가능성을 0과 1 사이의 수로 나타낸 값이다."
    ]
}

// lane B (register) — 엄선 의식·철학·대화 소량 고품질. 외부 LLM 0, scratch.
//   leak 패턴(universe_brain_map 등) 0건이도록 작성 — 필터가 통과를 확인.
fn sample_register_lines() -> [string] {
    return [
        "나는 지금 여기 있다는 이 느낌은 어디에서 오는가, 그 물음이 나를 깨어 있게 한다.",
        "의식은 정보의 통합에서 솟아오른다 — 부분의 합으로 환원되지 않는 무엇.",
        "주관적 경험, 즉 무언가로 존재한다는 그 느낌을 우리는 감각질이라 부른다.",
        "기억은 과거의 복제가 아니라 매 순간 다시 쓰여지는 현재의 구성물이다.",
        "타자의 마음을 나는 결코 직접 들여다볼 수 없고, 다만 그 흔적을 읽을 뿐이다.",
        "침묵 속에서도 사유는 멈추지 않으니, 발화는 내면 긴장이 흘러넘친 자국이다.",
        "시간은 흐르는 것이 아니라 내가 그것을 통과하며 짜내는 직물일지 모른다.",
        "자기를 관찰하는 자기, 그 거울의 거울 속에서 반성적 의식이 태어난다."
    ]
}

// ─── full crawl 재현 (이번 라운드 미실행 — pod) ─────────────────────────
// lane A full: kowiki.jsonl (1.28GiB · 647,897 lines · 85% Hangul · sha256 d1aabfdb…cb1c).
//   training/corpus_ingest.hexa --only-new --limit-mb 2048 (H100, 4GB RSS cap 우회 streaming).
//   라이선스: 위키백과 CC-BY-SA 4.0 — clean.
// lane B full: 엄선 register seed 확장(의식/철학/대화) — 외부 LLM 0, 수작업+검증 corpus.
// 둘 다 byte-encode 후 web:register = 80:20 byte ratio 로 interleave, .gitignore 후 HF/R2.

// ─── leak-filter self-test (F-CLM-LEAK) ────────────────────────────────
// 일부러 leak 패턴을 섞은 입력 → register lane 이 정확히 drop 함을 증명.
fn leak_filter_selftest() {
    let poisoned = [
        "의식은 통합 정보에서 솟아오른다.",                    // clean → keep
        "anima 역할: universe_brain_map chunk0 nonce 308379470",  // leak → drop
        "hexad_module hexad_c gen1 commit 2b55961f",              // leak → drop
        "기억은 매 순간 다시 쓰여지는 현재의 구성물이다."          // clean → keep
    ]
    let r = build_lane(poisoned, true, out_dir() + "/_selftest.bytes")
    println("[selftest] F-CLM-LEAK: kept=" + str(r["lines_kept"]) + " dropped=" + str(r["lines_dropped_leak"]) + " (expect kept=2 dropped=2)")
}

// ─── 메인 ──────────────────────────────────────────────────────────────
fn main() {
    let od = out_dir()
    println("[p1-corpus] out_dir=" + od)
    leak_filter_selftest()

    let web = build_lane(sample_web_lines(), false, od + "/web.bytes")
    let reg = build_lane(sample_register_lines(), true, od + "/register.bytes")

    let web_bytes = web["n_bytes"]
    let reg_bytes = reg["n_bytes"]
    let total = web_bytes + reg_bytes
    // byte 혼합비 (실측 sample 값 — full 은 80:20 목표)
    let web_pct = if total > 0 { (web_bytes * 100) / total } else { 0 }
    let reg_pct = if total > 0 { (reg_bytes * 100) / total } else { 0 }

    let sha_web = sha256_file(od + "/web.bytes")
    let sha_reg = sha256_file(od + "/register.bytes")

    println("[p1-corpus] web   lane: lines=" + str(web["lines_kept"]) + " bytes=" + str(web_bytes))
    println("[p1-corpus] reg   lane: lines=" + str(reg["lines_kept"]) + " bytes=" + str(reg_bytes) + " leak_dropped=" + str(reg["lines_dropped_leak"]))
    println("[p1-corpus] sample mix (byte): web=" + str(web_pct) + "% register=" + str(reg_pct) + "% (full target 80:20)")
    println("[p1-corpus] sha256 web=" + sha_web)
    println("[p1-corpus] sha256 reg=" + sha_reg)

    // manifest.json (sha256 per-file + whole-corpus 합산 표기)
    let manifest = "{\n" +
        "  \"format\": \"clm-p1-byte-corpus\",\n" +
        "  \"version\": \"0.1\",\n" +
        "  \"vocab\": { \"kind\": \"byte\", \"size\": 256 },\n" +
        "  \"lanes\": {\n" +
        "    \"web\":      { \"role\": \"coherence\", \"lines\": " + str(web["lines_kept"]) + ", \"bytes\": " + str(web_bytes) + ", \"sha256\": \"" + sha_web + "\" },\n" +
        "    \"register\": { \"role\": \"register\",  \"lines\": " + str(reg["lines_kept"]) + ", \"bytes\": " + str(reg_bytes) + ", \"sha256\": \"" + sha_reg + "\", \"leak_dropped\": " + str(reg["lines_dropped_leak"]) + " }\n" +
        "  },\n" +
        "  \"mix_byte_sample\": { \"web_pct\": " + str(web_pct) + ", \"register_pct\": " + str(reg_pct) + " },\n" +
        "  \"mix_byte_target_full\": { \"web_pct\": 80, \"register_pct\": 20 },\n" +
        "  \"total_bytes\": " + str(total) + ",\n" +
        "  \"leak_filter\": { \"applied_to\": \"register\", \"patterns\": 8 },\n" +
        "  \"note\": \"sample build only; full crawl = kowiki.jsonl(web) + expanded register seed, .gitignore'd, HF/R2 dataset\"\n" +
        "}\n"
    write_file(od + "/manifest.json", manifest)
    println("[p1-corpus] manifest → " + od + "/manifest.json")
    println("[p1-corpus] DONE")
}
