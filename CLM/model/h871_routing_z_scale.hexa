// ════════════════════════════════════════════════════════════════════════════
//  h871_routing_z_scale.hexa — H_871 routing-z = measurement-artifact (M1) DRIVER
//
//  ROADMAP @L3 / M1 (CLM/P4_PRODUCTION_ROADMAP.md): the toy routing-z 🔴
//  (H_847 / H_850 / H_852 / H_853 — near-uniform / negative routing-diversity z,
//  capped below the 3.0 chip-array gate) is SUSPECTED to be a SCALE ARTIFACT,
//  not a real toy-and-up ceiling. This driver fires the scale-ladder test that
//  measures the SAME routing-diversity z (verbatim CLM/model/judge_clm.routing_z)
//  at MULTIPLE rung sizes and checks whether z RISES monotonically with size.
//
//  hexa-native DRIVER (d5 1순위) · the QAT-free train + Dirichlet-null z PAYLOAD
//  lives in CLM/model/h871_routing_z_scale.py (torch autograd dependency), the
//  SAME .hexa-driver ⇄ .py-payload split as train_clm.hexa ⇄ train_clm.py.
//
//  LADDER (d_model / n_trunk_layers / n_experts), arm AB (= H_863 production arm):
//    tiny  = d64  / L2 / E4   (the P0 toy rung — the 🔴 origin; H_850 AB rz≈0.97)
//    small = d256 / L4 / E8   (the P0 small rung;              H_850 AB rz≈1.91)
//    mid   = d512 / L8 / E8   (the H_863 production rung — NEW, never z-measured)
//
//  PRE-REG (F-CLM-ROUTING-Z-SCALE_prereg.txt, frozen pre-fire): artifact
//  CONFIRMED 🟢 iff mean routing-z(rung) MONOTONE NON-DECREASING tiny<=small<=mid
//  AND mid_mean_z - tiny_mean_z >= MARGIN(0.5); else 🔴 real ceiling. Both honest
//  (a_paper_negative_ok). code-measured (g5 — no LLM judge).
//
//  HARD: pure-hexa driver · NO external LLM · @L1 Mac-forbidden train → runpod.
//  `fn main` auto-fires on `run`, so it only prints the fire plan + payload cmd.
// ════════════════════════════════════════════════════════════════════════════

// scale-ladder rung table (P0 d3) — 1:1 sync with the python payload RUNGS.
fn h871_rung_spec(rung: string) -> string {
    if rung == "tiny"  { return "d64/L2/E4  steps=300 lr=3e-3" }
    if rung == "small" { return "d256/L4/E8 steps=400 lr=2e-3" }
    if rung == "mid"   { return "d512/L8/E8 steps=500 lr=1e-3" }
    return "UNKNOWN rung — expected tiny|small|mid"
}

// frozen pre-reg gate (NOT tuned post-fire).
fn h871_margin_gate() -> string {
    return "0.5"
}

// the runtime-python payload invocation (torch autograd · Dirichlet-null z).
fn h871_payload_cmd(seeds: string) -> string {
    return "H871_JSON_OUT=h871_routing_z_scale.json "
        + "python3 h871_routing_z_scale.py --seeds " + seeds + " --steps-mult 1.0"
}

fn main() {
    println("H_871 routing-z scale-ladder (M1 measurement-artifact test · driver)")
    println("  arm=AB (dual-axis = H_863 prod arm) · corpus=REAL kowiki two-lane")
    println("  routing-z = (obs_entropy - mu_null)/sd_null · null=Dirichlet(1) over E"
        + " · chip-array gate z>3.0")
    let rungs = ["tiny", "small", "mid"]
    for rung in rungs {
        println("  rung " + rung + " → " + h871_rung_spec(rung))
    }
    println("  FROZEN gate: monotone tiny<=small<=mid AND (mid-tiny) >= "
        + h871_margin_gate() + " → 🟢 artifact confirmed; else 🔴 real ceiling")
    println("  payload: " + h871_payload_cmd("42,43,44"))
    println("  @L1 Mac-forbidden train — fire on runpod (a_fire_autonomous).")
}
