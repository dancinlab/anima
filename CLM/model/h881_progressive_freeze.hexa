"""H_881 - progressive freeze (BOUND E5 dynamic): move the freeze boundary
DURING a learning session and ask whether RETAIN^GAIN holds SUSTAINED across the
whole session (every checkpoint), not just at the end.

H_872 (GREEN, 8/9 static depths pass; best static depth = 3; boundary NON-MONOTONE
-- static depth 4 FAILS z_drop 9.67 while 3 and 5 pass) measured (z_drop, gain)
ONLY at the END of a 300-step session, holding the freeze depth FIXED all session.
H_881 asks the dynamic question: can the freeze boundary be MOVED across the session
(progressive freeze) so that z_drop<1.0 ^ gain>0 holds at EVERY checkpoint?

A SESSION = N_ADAPT=300 steps split into K=6 segments of 50. A SCHEDULE = a length-K
list of freeze-depths (depth_k applied during segment k); depth = # of TOP trunk layers
trainable, H_865 adapter always the edge (depth semantics identical to H_872). When the
boundary MOVES between segments, params crossing it keep their LEARNED values (no
re-init); only requires_grad flips + the optimizer is rebuilt over the new trainable set
(edge-only piecewise, no deterministic full-retrain -- @L1 / H_679 honored).

Falsifier (FROZEN VERBATIM from commit bf98c01, post-tuning = 0)
  F-CLM-BOUND-RETAIN : held-out base-ability z_drop < 1.0   AT EVERY checkpoint
  F-CLM-BOUND-GAIN   : new-context adaptation gain  > 0     AT EVERY checkpoint
  A schedule SUSTAINS iff EVERY checkpoint passes BOTH.
  Sweep verdict GREEN iff EXISTS a sustaining schedule; else RED (a_paper_negative_ok).
  The sweep VARIES the freeze SCHEDULE ONLY; the thresholds NEVER move.

SW-sim of the non-deterministic on-chip edge-learn is acceptable at the measurement
rung (a_scale_honest_scope); foundation H_679 established HW edge-learn is real.
Scope: MEASUREMENT rung (mid d512/L8/E8) only.

NOTE: project hexa-native source policy stores this scaffold as .hexa; its body is the
executable harness (torch / CLM model import) run at the measurement rung.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

import torch
import torch.nn as nn
import torch.nn.functional as F

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from model import CLMConfig, CLMConvMoE  # noqa: E402

# --- frozen experiment constants (mirror H_865 / H_872 / bf98c01 verbatim) ---
BASE_SEED = 101
NEW_SEED = 202
N_ADAPT = 300
N_SEGMENTS = 6
SEG_STEPS = N_ADAPT // N_SEGMENTS  # 50
LR_EDGE = 3e-3
SEQ_LEN = 64
BATCH_SIZE = 16
N_EVAL_BATCHES = 32
ADAPTER_RANK = 64

# FROZEN thresholds (bf98c01 verbatim) -- the sweep NEVER moves these.
THR_Z_DROP = 1.0
THR_GAIN = 0.0

# PRE-REGISTERED schedules (frozen BEFORE fire; the only lever that varies).
SCHEDULES = {
    "S1_static0":          [0, 0, 0, 0, 0, 0],
    "S2_static3":          [3, 3, 3, 3, 3, 3],
    "S3_deepen":           [0, 0, 1, 1, 2, 3],
    "S4_shrink":           [3, 3, 2, 1, 1, 0],
    "S5_anneal":           [3, 2, 1, 0, 0, 0],
    "S6_cross4":           [3, 4, 3, 4, 3, 4],
    "S7_grow_then_freeze": [1, 2, 3, 2, 1, 0],
}


def _lcg(seed):
    state = seed & 0x7FFFFFFF
    while True:
        state = (1103515245 * state + 12345) & 0x7FFFFFFF
        yield state


def make_lane_bytes(kind, n, seed):
    rng = _lcg(seed + 1)
    out = []
    if kind == "web":
        motifs = [
            [0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x20],
            [0x77, 0x6f, 0x72, 0x6c, 0x64, 0x2e, 0x20],
            [0x74, 0x68, 0x65, 0x20, 0x71, 0x75, 0x69],
        ]
        while len(out) < n:
            m = motifs[next(rng) % len(motifs)]
            out.extend(m)
            if next(rng) % 17 == 0:
                out.append(0x20 + (next(rng) % 0x5e))
    else:
        period = 11 + (seed % 7)
        base = 0x80
        for i in range(n):
            v = base + ((i % period) * 13 + (next(rng) % 5)) % 0x7f
            out.append(v & 0xFF)
    return out[:n]


def batchify(byte_list, seq_len, n_batches, batch_size, seed):
    g = torch.Generator().manual_seed(seed)
    data = torch.tensor(byte_list, dtype=torch.long)
    max_start = len(data) - seq_len - 1
    batches = []
    for _ in range(n_batches):
        starts = torch.randint(0, max_start, (batch_size,), generator=g)
        toks = torch.stack([data[s:s + seq_len] for s in starts])
        tgts = torch.stack([data[s + 1:s + seq_len + 1] for s in starts])
        batches.append((toks, tgts))
    return batches


class AdapterEdge(nn.Module):
    def __init__(self, d_model, rank):
        super().__init__()
        self.down = nn.Conv1d(d_model, rank, kernel_size=1)
        self.act = nn.GELU()
        self.up = nn.Conv1d(rank, d_model, kernel_size=1)
        nn.init.zeros_(self.up.weight)
        nn.init.zeros_(self.up.bias)

    def forward(self, h):
        return h + self.up(self.act(self.down(h)))


class ProgFreezeCLM(nn.Module):
    """H_865 adapter edge + a MOVABLE freeze boundary over the trunk.

    `set_depth(d)` makes the top `d` trunk layers trainable (adapter always
    trainable) and freezes the rest -- WITHOUT re-initializing any params, so a
    boundary that moves between segments keeps the values learned so far.
    """

    def __init__(self, base):
        super().__init__()
        self.base = base
        self.n_trunk = base.cfg.n_trunk_layers
        self.adapter = AdapterEdge(base.cfg.d_model, ADAPTER_RANK)
        self.depth = None
        self.unfrozen_trunk_idx = []

    def set_depth(self, depth):
        self.depth = depth
        for p in self.base.parameters():
            p.requires_grad_(False)
        self.unfrozen_trunk_idx = list(range(max(self.n_trunk - depth, 0), self.n_trunk))
        for idx in self.unfrozen_trunk_idx:
            for p in self.base.trunk[idx].parameters():
                p.requires_grad_(True)
        for p in self.adapter.parameters():
            p.requires_grad_(True)

    def trainable_params(self):
        return [p for p in self.parameters() if p.requires_grad]

    def n_trainable(self):
        return sum(p.numel() for p in self.trainable_params())

    def trunk_norm_out(self, tokens):
        b = self.base
        x = b.embed(tokens).transpose(1, 2)
        x = b.embed_conv(x)
        for layer in b.trunk:
            x = layer(x)
        x, _ = b.moe(x)
        h = b.norm_out(x)
        return self.adapter(h)

    def forward(self, tokens, targets=None):
        hp = self.trunk_norm_out(tokens)
        logits = self.base.readout(hp)
        out = {"logits": logits}
        if targets is not None:
            ce = F.cross_entropy(
                logits.transpose(1, 2).reshape(-1, self.base.cfg.vocab_size),
                targets.reshape(-1),
            )
            out["ce_loss"] = ce
        return out


@torch.no_grad()
def eval_ce(model, batches):
    ces = []
    for toks, tgts in batches:
        out = model(toks, tgts)
        ces.append(out["ce_loss"].item())
    t = torch.tensor(ces)
    return t.mean().item(), t.std(unbiased=False).item()


def infer_config_and_load(ckpt_path):
    obj = torch.load(ckpt_path, map_location="cpu")
    if isinstance(obj, dict) and "state_dict" in obj:
        sd = obj["state_dict"]
        meta = obj.get("config") or obj.get("cfg") or {}
    elif isinstance(obj, dict) and any(k.startswith(("embed", "trunk", "moe", "readout")) for k in obj):
        sd = obj
        meta = {}
    else:
        sd = obj.get("model", obj) if isinstance(obj, dict) else obj
        meta = obj.get("config", {}) if isinstance(obj, dict) else {}
    d_model = sd["embed.weight"].shape[1]
    vocab = sd["embed.weight"].shape[0]
    n_trunk = len({k.split(".")[1] for k in sd if k.startswith("trunk.")})
    n_experts = len({k.split(".")[2] for k in sd if k.startswith("moe.experts.")})
    variant = meta.get("variant", "AB") if isinstance(meta, dict) else "AB"
    cfg = CLMConfig(vocab_size=vocab, d_model=d_model, n_trunk_layers=n_trunk,
                    n_experts=n_experts, variant=variant)
    base = CLMConvMoE(cfg)
    base.load_state_dict(sd, strict=False)
    return base, cfg, sd


def fresh_base(sd, cfg):
    base = CLMConvMoE(cfg)
    base.load_state_dict(sd, strict=False)
    return base


def run_schedule(sd, cfg, name, schedule, device):
    base = fresh_base(sd, cfg).to(device)
    model = ProgFreezeCLM(base).to(device)

    base_bytes = make_lane_bytes("web", 30000, BASE_SEED)
    new_bytes = make_lane_bytes("new", 30000, NEW_SEED)
    half = len(new_bytes) // 2
    base_eval = batchify(base_bytes, SEQ_LEN, N_EVAL_BATCHES, BATCH_SIZE, BASE_SEED)
    new_eval = batchify(new_bytes[half:], SEQ_LEN, N_EVAL_BATCHES, BATCH_SIZE, NEW_SEED + 1)
    new_train = batchify(new_bytes[:half], SEQ_LEN, N_ADAPT, BATCH_SIZE, NEW_SEED + 2)

    model.set_depth(schedule[0])
    model.eval()
    ce_base_pre, sd_base_pre = eval_ce(model, base_eval)
    ce_new_pre, _ = eval_ce(model, new_eval)

    checkpoints = []
    step = 0
    for k, depth in enumerate(schedule):
        # MOVE the boundary; keep learned values, only flip requires_grad + rebuild opt.
        model.set_depth(depth)
        opt = torch.optim.Adam(model.trainable_params(), lr=LR_EDGE)
        model.train()
        for _ in range(SEG_STEPS):
            toks, tgts = new_train[step]
            toks, tgts = toks.to(device), tgts.to(device)
            out = model(toks, tgts)
            opt.zero_grad()
            out["ce_loss"].backward()
            opt.step()
            step += 1
        model.eval()
        ce_base_post, _ = eval_ce(model, base_eval)
        ce_new_post, _ = eval_ce(model, new_eval)
        z_drop = (ce_base_post - ce_base_pre) / max(sd_base_pre, 1e-6)
        gain = ce_new_pre - ce_new_post
        retain = bool(z_drop < THR_Z_DROP)
        gain_pass = bool(gain > THR_GAIN)
        checkpoints.append({
            "segment": k, "step": step, "depth": depth,
            "unfrozen_trunk_layers": list(model.unfrozen_trunk_idx),
            "n_trainable_params": model.n_trainable(),
            "ce_base_post": round(ce_base_post, 5),
            "ce_new_post": round(ce_new_post, 5),
            "z_drop": round(z_drop, 5), "gain": round(gain, 5),
            "RETAIN_pass": retain, "GAIN_pass": gain_pass,
            "pass": bool(retain and gain_pass),
        })

    sustains = all(c["pass"] for c in checkpoints)
    min_gain = min(c["gain"] for c in checkpoints)
    max_z = max(c["z_drop"] for c in checkpoints)
    return {
        "name": name, "schedule": schedule,
        "ce_base_pre": round(ce_base_pre, 5), "sd_base_pre": round(sd_base_pre, 5),
        "ce_new_pre": round(ce_new_pre, 5),
        "checkpoints": checkpoints,
        "min_gain_over_session": round(min_gain, 5),
        "max_z_drop_over_session": round(max_z, 5),
        "n_checkpoints_passed": sum(c["pass"] for c in checkpoints),
        "sustains": bool(sustains),
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ckpt", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--schedules", default="",
                    help="comma list of schedule names; default = all pre-registered")
    args = ap.parse_args()
    device = "cuda" if torch.cuda.is_available() else "cpu"
    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)

    base, cfg, sd = infer_config_and_load(args.ckpt)
    print("[h881] backbone d=%d L=%d E=%d V=%d params=%d device=%s" % (
        cfg.d_model, cfg.n_trunk_layers, cfg.n_experts, cfg.vocab_size,
        base.num_params(), device))

    if args.schedules.strip():
        names = [x for x in args.schedules.split(",") if x.strip()]
    else:
        names = list(SCHEDULES.keys())

    results = []
    for name in names:
        sched = SCHEDULES[name]
        r = run_schedule(sd, cfg, name, sched, device)
        results.append(r)
        cks = " ".join("c%d:z=%.2f,g=%.2f,%s" % (
            c["segment"], c["z_drop"], c["gain"], "P" if c["pass"] else "F")
            for c in r["checkpoints"])
        print("[h881 %s %s] sustains=%s pass=%d/%d min_gain=%.3f max_z=%.3f | %s" % (
            name, sched, r["sustains"], r["n_checkpoints_passed"],
            len(r["checkpoints"]), r["min_gain_over_session"],
            r["max_z_drop_over_session"], cks))

    sustaining = [r["name"] for r in results if r["sustains"]]
    best = None
    if sustaining:
        best = max((r for r in results if r["sustains"]),
                   key=lambda r: (r["min_gain_over_session"], -r["max_z_drop_over_session"]))
    verdict = "GREEN" if sustaining else "RED"

    result = {
        "campaign": "H_881 progressive freeze (BOUND E5 dynamic)",
        "frozen_thresholds_commit": "bf98c01",
        "threshold_z_drop": "<1.0 at every checkpoint",
        "threshold_gain": ">0.0 at every checkpoint",
        "rung": "mid d512/L8/E8",
        "n_trunk_layers": cfg.n_trunk_layers,
        "adapter_rank": ADAPTER_RANK,
        "n_segments": N_SEGMENTS, "seg_steps": SEG_STEPS, "n_adapt": N_ADAPT,
        "builds_on": "H_872 (static freeze-depth, END-only; best static depth=3; boundary non-monotone, static depth4 FAILS)",
        "schedule_semantics": "depth_k = # of TOP trunk layers trainable in segment k; H_865 adapter always the edge; boundary MOVES between segments keeping learned values (no re-init), only requires_grad flips + opt rebuilt (edge-only piecewise, no full-retrain @L1/H_679)",
        "edge_learn": "SW-sim (H_679 HW edge-learn real); measurement rung a_scale_honest_scope",
        "schedules_tested": {k: SCHEDULES[k] for k in names},
        "results": results,
        "sustaining_schedules": sustaining,
        "best_schedule": best["name"] if best else None,
        "best": best,
        "verdict": verdict,
        "note": "sweep VARIES the freeze SCHEDULE ONLY; thresholds bf98c01 verbatim, post-tuning 0; GREEN iff exists a schedule that SUSTAINS z_drop<1.0 ^ gain>0 at EVERY checkpoint, else RED (a_paper_negative_ok)",
    }
    with open(os.path.join(args.out, "clm_progressive_freeze_result.json"), "w") as f:
        json.dump(result, f, indent=2)
    print("[h881] sustaining=%s best=%s verdict=%s" % (
        sustaining, result["best_schedule"], verdict))
    print("=== H881 COMPLETE ===")


if __name__ == "__main__":
    main()
