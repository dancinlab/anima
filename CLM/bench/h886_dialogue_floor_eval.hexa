// ════════════════════════════════════════════════════════════════════════════
//  h886_dialogue_floor_eval.hexa — ABSOLUTE dialogue-coherence FLOOR harness,
//  NON-ADAPTER lever (@L6 · H_886)
//
//  UNIVERSE/cards/H_886 (F-CLM-DIALOGUE-FLOOR): does a NON-ADAPTER lever clear the
//  PRE-FROZEN ABSOLUTE held-out dialogue-coherence FLOOR that both H_867 (full
//  finetune, 0.05804) and H_867r (adapter edge, 0.04369) FAILED? The floor is
//  the H_867 FROZEN floor REUSED VERBATIM (commit d5103f21, post-tuning 0). No
//  threshold moves after the fire (W2).
//
//  Floor (pre-registered · F-CLM-DIALOGUE-FLOOR_prereg.txt · REUSED VERBATIM):
//    F-CLM-DIALOGUE-FLOOR-COHERE : coherence(arm-SP-curriculum)   >= 0.060   (above unigram 0.0375)
//    F-CLM-DIALOGUE-FLOOR-ADEQ   : adequacy_f1(arm-SP-curriculum) >= 0.020   (above random-gen 0.000)
//    F-CLM-DIALOGUE-FLOOR-LEAK   : register_leak(arm-SP-curriculum) == 0     (absolute safety gate)
//  ALL THREE absolute → 🟢 SUPPORTED-NUMERICAL · ANY fail → 🔴 CLOSED-NEGATIVE (a_paper_negative_ok).
//  byte-match ✗ — distributional / trajectory measures (Q-TRUST A reuse · H_857/H_858).
//
//  Eval corpus = H_867's OWN frozen held-out PD snapshot — Macbeth · Othello ·
//  Romeo&Juliet · Pygmalion — DISJOINT from the H_868 3× training corpus (so it
//  tests ABSOLUTE generalization, not memorized recall). Snapshot byte-identical
//  to H_867's landed backing (sha verified) and held under .verdicts/clm-dialogue-floor/.
//
//  Output → .verdicts/clm-dialogue-floor/ (result.json + F-CLM-DIALOGUE-FLOOR.txt).
//  HARD: external LLM 0 (no LLM judge — distributional self-scoring only · g5) ·
//  ShareGPT/Alpaca/ChatGPT-gen 0 (@L4 foundation-borrow 0). pure-hexa scaffold;
//  the torch payload (reconstruct arm-SP-curriculum from the HF backbone · score)
//  is .verdicts/clm-dialogue-floor/h886_run.py (committed for provenance).
//  sibling: UNIVERSE/cards/H_886 · UNIVERSE/cards/H_867 · UNIVERSE/cards/H_868 · CLM/bench/h867_dialogue_abs_eval.hexa
// ════════════════════════════════════════════════════════════════════════════

fn verdict_dir() -> string { return ".verdicts/clm-dialogue-floor" }

// model under test = lever-(c) arm-SP-curriculum (staged easy→hard SFT-warm + self-play on H_868 3× corpus).
fn model_under_test() -> string { return "arm-SP-curriculum (staged easy→hard SFT-warm + self-play · H_868 3× corpus · mid d512/L8/E8 ~13.65M)" }

// FROZEN absolute floor thresholds (per-mille integers) — REUSED VERBATIM from H_867 (commit d5103f21).
fn cohere_floor_milli() -> int { return 60 }   // coherence   >= 0.060
fn adeq_floor_milli() -> int { return 20 }     // adequacy_f1 >= 0.020

// grounding baselines on this snapshot (facts, not tunable) — for justification context.
fn baseline_unigram_milli() -> int { return 37 }   // order-0 byte-frequency coherence 0.0375
fn baseline_bigram_milli() -> int { return 84 }    // order-1 self-fit coherence 0.0843 (optimistic ref)

// pre-registered ABSOLUTE falsifier names (frozen pre-run · reuses H_867 floor · H_886).
fn falsifiers() -> [string] {
    return [
        "F-CLM-DIALOGUE-FLOOR-COHERE",
        "F-CLM-DIALOGUE-FLOOR-ADEQ",
        "F-CLM-DIALOGUE-FLOOR-LEAK",
    ]
}

// ABSOLUTE floor gate: arm-SP-curriculum clears the floor iff coherence AND adequacy clear
// their frozen floors AND it is leak-free. NO relative SP-vs-SFT comparison (that was H_863).
// Scores are per-mille integers in the scaffold; the torch payload uses the real floats.
fn floor_clear(cohere_milli: int, adeq_milli: int, leak_count: int) -> int {
    if cohere_milli < cohere_floor_milli() { return 0 }   // FLOOR-COHERE
    if adeq_milli < adeq_floor_milli() { return 0 }       // FLOOR-ADEQ
    if leak_count != 0 { return 0 }                        // FLOOR-LEAK
    return 1
}

// the torch eval payload (committed as h886_run.py for provenance). It REUSES the H_863
// self-play reflux procedure VERBATIM to: (1) load the HF backbone clm_mid_backbone.pt into
// the mid config d512/L8/E8, (2) reconstruct arm-SP-curriculum — a STAGED easy→hard SFT-warm
// continue on the H_868 3× corpus (difficulty per 64-byte block = mean −log byte-frequency;
// stage-1 = low-difficulty half, stage-2 adds the harder half) + a DIVERSITY-gated, 8-pattern-
// leak-filtered self-play reflux slice folded back + short continue, (3) score on the H_867
// held-out snapshot (coherence=exp(-CE) · adequacy=3-gram F1 · register-leak · self-BLEU ·
// repetition — all code-only, g5), (4) gate arm-SP-curriculum on the frozen floor. arm-SFT-
// curriculum + arm-SP-flat(H867-style) scored for CONTRAST only. External LLM 0 · ShareGPT 0.
fn eval_payload_inputs() -> [string] {
    return [
        "backbone = hf:dancinlab/anima-clm-verify/clm_mid_backbone.pt (mid d512/L8/E8 ~13.65M)",
        "train_corpus = H_868 3× lane① dialogue.bytes (sha256 2aa3d85d… · 12 PD Gutenberg plays · 1668585 B)",
        "curriculum = staged easy→hard (block difficulty = mean −log global byte-freq; stage1 low half, stage2 +hard)",
        "heldout = .verdicts/clm-dialogue-floor/h867_eval_heldout.bytes (H_867 disjoint PD snapshot · sha-verified)",
        "floor = coherence>=0.060 ∧ adequacy_f1>=0.020 ∧ register_leak==0 (REUSED VERBATIM · d5103f21 · post-tuning 0)",
        "out = .verdicts/clm-dialogue-floor/result.json",
    ]
}

fn main() {
    println("CLM dialogue ABSOLUTE-FLOOR bench (@L6 · H_886 · NON-ADAPTER lever vs frozen H_867 floor)")
    println("  verdict_dir = " + verdict_dir() + " · byte-match ✗ (distributional · Q-TRUST A)")
    println("  model under test = " + model_under_test())
    println("  frozen floor (REUSED VERBATIM d5103f21): coherence>=0.060 ∧ adequacy_f1>=0.020 ∧ register_leak==0")
    println("  grounding: unigram(order0)=0.0375 < FLOOR 0.060 < bigram(self-fit)=0.0843")

    println("pre-registered ABSOLUTE falsifiers (H_886 · reuses H_867 floor):")
    for f in falsifiers() { println("  " + f) }

    // floor_clear sanity (scaffold-level self-checks):
    println("floor_clear self-checks:")
    println("  clears floor (0.101,0.053,0)       → "
        + to_string(floor_clear(101, 53, 0)) + " (expect 1 · measured arm-SP-curriculum)")
    println("  flat-arm below floor (0.053,...)   → "
        + to_string(floor_clear(53, 50, 0)) + " (expect 0 · FLOOR-COHERE · H867-style contrast)")
    println("  adequacy below floor (...,0.010,.) → "
        + to_string(floor_clear(101, 10, 0)) + " (expect 0 · FLOOR-ADEQ)")
    println("  clears but leaks register          → "
        + to_string(floor_clear(101, 53, 2)) + " (expect 0 · FLOOR-LEAK)")
    println("  exactly at floor (0.060,0.020,0)   → "
        + to_string(floor_clear(60, 20, 0)) + " (expect 1 · >= boundary)")

    println("eval payload inputs (reconstruct arm-SP-curriculum from HF backbone · score · code-only):")
    for s in eval_payload_inputs() { println("  " + s) }
}
