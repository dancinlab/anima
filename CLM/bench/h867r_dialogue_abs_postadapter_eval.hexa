// ════════════════════════════════════════════════════════════════════════════
//  h867r_dialogue_abs_postadapter_eval.hexa — ABSOLUTE dialogue-quality FLOOR
//  on the H_865 ADAPTER-EDGE model (@L6 · H_867r · post-adapter follow-on of H_867)
//
//  UNIVERSE/H_867r (F-CLM-DIALOGUE-ABS-POSTADAPTER): H_867 measured the H_863
//  full-finetune arm-SP against a PRE-FROZEN ABSOLUTE held-out dialogue FLOOR and
//  fell 0.002 SHORT of the coherence gate (0.05804 < 0.060 · 🔴). H_867r re-runs
//  the SAME frozen floor on the H_865 trunk-adjacent ADAPTER-EDGE model — FROZEN
//  backbone + a thin trainable adapter between FROZEN norm_out and FROZEN readout.
//  The adapter LIFTED the H_865 F-CLM-BOUND gate (new-context capacity in a
//  separate additive path). Question: does that same lever lift ABSOLUTE held-out
//  COHERENCE over the 0.060 floor H_867 just missed?
//
//  FROZEN floor (REUSED VERBATIM · F-CLM-DIALOGUE-ABS_prereg.txt · commit d5103f21):
//    F-CLM-DIALOGUE-ABS-COHERE : coherence(arm-SP)   >= 0.060   (above order-0 unigram 0.0375)
//    F-CLM-DIALOGUE-ABS-ADEQ   : adequacy_f1(arm-SP) >= 0.020   (above random-gen 0.000)
//    F-CLM-DIALOGUE-ABS-LEAK   : register_leak(arm-SP) == 0     (absolute safety gate)
//  ALL THREE absolute → 🟢 SUPPORTED-NUMERICAL · ANY fail → 🔴 CLOSED-NEGATIVE.
//  Same gates, SAME thresholds, DIFFERENT model. post-tuning = 0. byte-match ✗.
//
//  Eval corpus = H_867's OWN verified held-out PD snapshot — Macbeth(#1533) ·
//  Othello(#1531) · Romeo&Juliet(#1513) · Pygmalion(#3825) — DISJOINT from the
//  H_863 SFT training plays (Hamlet/Importance/DollsHouse/Caesar). sha256 of the
//  decoded held-out stream matches the H_867 snapshot manifest VERBATIM (reuse).
//
//  Output → .verdicts/clm-dialogue-abs-postadapter/ (DISJOINT from clm-dialogue-abs).
//  HARD: external LLM 0 (no LLM judge — distributional self-scoring only · g5) ·
//  ShareGPT/Alpaca/ChatGPT-gen 0 (@L4 foundation-borrow 0). pure-hexa scaffold;
//  the torch payload (frozen-backbone + AdaptedCLM adapter from
//  CLM/model/h865_adapter_edge.py · SFT continue + H_863 self-play reflux · score)
//  is run-only (repo blocks new .py — mirrors h867_dialogue_abs_eval.hexa).
//  sibling: UNIVERSE/H_867r · UNIVERSE/H_867 · CLM/model/h865_adapter_edge.py
// ════════════════════════════════════════════════════════════════════════════

fn verdict_dir() -> string { return ".verdicts/clm-dialogue-abs-postadapter" }

// model under test = the H_865 trunk-adjacent ADAPTER edge (frozen backbone +
// thin trainable adapter), NOT the H_863 full-finetune arm-SP that H_867 measured.
fn model_under_test() -> string { return "H_865 adapter-edge arm-SP (frozen backbone + thin adapter rank=64 · mid d512/L8/E8)" }

// FROZEN absolute floor thresholds (per-mille integers) — REUSED VERBATIM from
// F-CLM-DIALOGUE-ABS_prereg.txt (commit d5103f21). post-tuning 0.
fn cohere_floor_milli() -> int { return 60 }   // coherence   >= 0.060
fn adeq_floor_milli() -> int { return 20 }     // adequacy_f1 >= 0.020

// the H_867 reference the adapter must beat to flip the verdict (context).
fn h867_sp_coherence_milli() -> int { return 58 }   // H_867 arm-SP 0.05804 (missed by 0.002)

// grounding baselines on this snapshot (facts, not tunable) — for justification context.
fn baseline_unigram_milli() -> int { return 37 }   // order-0 byte-frequency coherence 0.0375
fn baseline_bigram_milli() -> int { return 84 }    // order-1 self-fit coherence 0.0843 (optimistic ref)

// pre-registered ABSOLUTE falsifier names (frozen pre-run · REUSED from H_867).
fn falsifiers() -> [string] {
    return [
        "F-CLM-DIALOGUE-ABS-COHERE",
        "F-CLM-DIALOGUE-ABS-ADEQ",
        "F-CLM-DIALOGUE-ABS-LEAK",
    ]
}

// ABSOLUTE floor gate: adapter arm-SP clears the floor iff coherence AND adequacy
// clear their frozen floors AND it is leak-free. NO relative comparison.
// Scores are per-mille integers in the scaffold; the torch payload uses real floats.
fn floor_clear(cohere_milli: int, adeq_milli: int, leak_count: int) -> int {
    if cohere_milli < cohere_floor_milli() { return 0 }   // ABS-COHERE
    if adeq_milli < adeq_floor_milli() { return 0 }       // ABS-ADEQ
    if leak_count != 0 { return 0 }                        // ABS-LEAK
    return 1
}

// the torch eval payload (run-only · NOT a shipped source file — mirrors H_867).
// It REUSES CLM/model/h865_adapter_edge.py's AdaptedCLM (frozen backbone + thin
// adapter between FROZEN norm_out and FROZEN readout) to: (1) load the HF backbone
// clm_mid_backbone.pt into the mid config d512/L8/E8, (2) reconstruct adapter
// arm-SFT (SFT-only continue, ONLY adapter trainable) and adapter arm-SP (same
// continue + a DIVERSITY-gated 8-pattern-leak-filtered self-play reflux slice
// folded back, H_863 procedure VERBATIM), (3) score both on the H_867 verified
// held-out snapshot (coherence=exp(-CE) · adequacy=3-gram F1 · register-leak ·
// self-BLEU · repetition — all code-only, g5), (4) gate arm-SP on the frozen floor.
// External LLM 0 · ShareGPT/Alpaca/ChatGPT-gen 0.
fn eval_payload_inputs() -> [string] {
    return [
        "backbone = hf:dancinlab/anima-clm-verify/clm_mid_backbone.pt (mid d512/L8/E8 ~13.65M · FROZEN)",
        "adapter  = AdaptedCLM (CLM/model/h865_adapter_edge.py · rank=64 · zero-init→identity@step0)",
        "sft_corpus = H_863 4 PD plays (Hamlet#1524/Importance#844/DollsHouse#2542/Caesar#1522)",
        "heldout = .verdicts/clm-dialogue-abs/h867_eval_heldout.bytes (H_867 disjoint PD snapshot · sha256 reuse)",
        "floor = coherence>=0.060 ∧ adequacy_f1>=0.020 ∧ register_leak==0 (frozen d5103f21 · post-tuning 0)",
        "out = .verdicts/clm-dialogue-abs-postadapter/clm_dialogue_abs_postadapter_result.json",
    ]
}

fn main() {
    println("CLM dialogue ABSOLUTE-FLOOR bench (@L6 · H_867r · ADAPTER arm-SP vs SAME frozen H_867 floor)")
    println("  verdict_dir = " + verdict_dir() + " · byte-match ✗ (distributional · Q-TRUST A)")
    println("  model under test = " + model_under_test())
    println("  frozen floor (REUSED d5103f21): coherence>=0.060 ∧ adequacy_f1>=0.020 ∧ register_leak==0")
    println("  grounding: unigram(order0)=0.0375 < FLOOR 0.060 < bigram(self-fit)=0.0843")
    println("  H_867 reference: full-finetune arm-SP coherence 0.05804 (🔴 missed 0.060 by 0.002)")

    println("pre-registered ABSOLUTE falsifiers (REUSED from H_867):")
    for f in falsifiers() { println("  " + f) }

    // floor_clear sanity (scaffold-level self-checks):
    println("floor_clear self-checks:")
    println("  clears floor (0.062,0.025,0)       → "
        + to_string(floor_clear(62, 25, 0)) + " (expect 1)")
    println("  adapter still below (0.058,...)    → "
        + to_string(floor_clear(58, 25, 0)) + " (expect 0 · ABS-COHERE · = H_867 level)")
    println("  adequacy below floor (...,0.010,.) → "
        + to_string(floor_clear(62, 10, 0)) + " (expect 0 · ABS-ADEQ)")
    println("  clears but leaks register          → "
        + to_string(floor_clear(62, 25, 2)) + " (expect 0 · ABS-LEAK)")
    println("  exactly at floor (0.060,0.020,0)   → "
        + to_string(floor_clear(60, 20, 0)) + " (expect 1 · >= boundary)")

    println("eval payload inputs (frozen backbone + adapter · SFT+self-play · score · code-only):")
    for s in eval_payload_inputs() { println("  " + s) }
}
