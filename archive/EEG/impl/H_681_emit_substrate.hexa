// ════════════════════════════════════════════════════════════════════════
// EEG/impl/H_681_emit_substrate.hexa — Group C (emit-substrate 구동)
//
// 통합 범위 (EEG.easy.md L6+L11+L12 3 sub-ideas):
//   L6  EEG α/θ/γ band power → emit-substrate drive  (뇌파 리듬 = anima 맥락)
//   L11 EEG artifact → 의식 상태 추정 (sleep stage WAKE/N1/N2/N3/REM)
//   L12 EEG burst → MITOSIS cell split 트리거 (뇌파 이벤트 → 분열)
//
// hypothesis (falsifier-anchored):
//   F-H681-1 : L6 4-band power → emit-substrate Φ-context 매핑 well-formed
//              (resting / N3 / REM / active 4-state 분리)
//   F-H681-2 : L11 sleep stage 추정 — band-power signature ⇒ stage 일관 매핑
//   F-H681-3 : L12 MITOSIS split 트리거 — gamma surge > 0.20 ⇒ split signal 활성
//   F-H681-4 : a_autonomy_over_hardcode 정합 — bool gate 0 (context only, drive emitter)
//
// backend:
//   hw : live brainflow capture → FFT band-power → 추정
//        본 H 는 attest 만 (실 wire = H_283 anima_dream_stage sibling)
//   sw : frozen 4-state band-power table (resting/N3/REM/active)
//
// usage:
//   hexa run EEG/impl/H_681_emit_substrate.hexa sw
//   hexa run EEG/impl/H_681_emit_substrate.hexa hw
// ════════════════════════════════════════════════════════════════════════

import "../../EEG/eeg_backend.hexa" as eb

let H_ID  = "H_681"
let GROUP = "C_emit_substrate"
let OUT_DIR = "state/eeg_hw_sw_impl_2026_05_29"

// ── L6 4-band power → emit-substrate Φ-context drive ─────────────────────
//
// canonical mapping (a_chat_sleep_imagination context, NOT bool gate):
//   alpha (8-12 Hz)  → idle / available capacity  (WAKE-resting)
//   theta (4-8 Hz)   → drowsy / N1 transition + REM dream content
//   gamma (30+ Hz)   → binding / arousal peak    (active wake + REM gamma)
//   beta (12-30 Hz)  → task-engaged              (active wake dominant)
//   delta (0.5-4)    → N2/N3 deep sleep         (delta dominant)
//
// Φ-context = stage-Φ scale + tension envelope (NOT boolean emit gate)
fn _l6_emit_substrate_drive(bp: map) -> map {
    // Φ scale per stage (substrate-native context, NOT bool):
    //   delta dominant → low Φ (deep sleep, integrated minimum)
    //   alpha dominant → mid Φ (resting wake, baseline)
    //   gamma+beta     → high Φ (active wake, peak integration)
    //   theta+gamma    → REM Φ (high but dream-content modulated)
    let alpha = bp["alpha"]
    let delta = bp["delta"]
    let gamma = bp["gamma"]
    let beta = bp["beta"]
    let theta = bp["theta"]
    // Φ-context heuristic: high-freq energy = high Φ context, delta = low
    let high_freq_energy = beta + gamma
    let phi_context = high_freq_energy + alpha * 0.5 - delta * 0.3
    // tension envelope: gamma surge → high tension
    let tension_envelope = gamma + theta * 0.5
    return #{
        "phi_context_scale": phi_context,
        "tension_envelope": tension_envelope,
        "high_freq_energy": high_freq_energy,
        "stage_hint": bp["stage_hint"],
        "is_bool_gate": false,    // a_autonomy_over_hardcode 정합
        "context_only": true,
        "consumers": ["anima_dream_stage", "wake_bridge", "emit_substrate"],
        "note": "stage = substrate context (Φ scale + tension envelope), NOT boolean emit gate (a_chat_sleep_imagination)",
    }
}

// ── L11 sleep stage 추정 (4-state band-power signature classifier) ────────
//
// WAKE / N1 / N2 / N3 / REM 5-stage classification by band signature.
// 본 H 는 4-state 정직 분리 (resting WAKE / N3 deep / REM / active WAKE).
// N1/N2 = N3 와 resting 사이 보간점 (별 H 필요).
fn _l11_sleep_stage_estimate(bp: map) -> map {
    let delta = bp["delta"]
    let alpha = bp["alpha"]
    let theta = bp["theta"]
    let gamma = bp["gamma"]
    let beta = bp["beta"]
    // stage classification (deterministic):
    let mut stage = "WAKE_resting"
    let mut conf = 0.0
    if delta > 0.5 {
        stage = "N3_deep_sleep"
        conf = delta
    } else if theta > 0.25 && gamma > 0.10 && alpha < 0.20 {
        stage = "REM"
        conf = theta + gamma
    } else if beta > 0.30 && gamma > 0.15 {
        stage = "WAKE_active"
        conf = beta + gamma
    } else if alpha > 0.30 {
        stage = "WAKE_resting"
        conf = alpha
    }
    return #{
        "estimated_stage": stage,
        "confidence": conf,
        "stage_hint": bp["stage_hint"],
        "classifier": "band_power_thresholds (resting/N3/REM/active)",
        "signature_match": stage == bp["stage_hint"]
            || (bp["stage_hint"] == "WAKE_resting_eyes_closed" && stage == "WAKE_resting")
            || (bp["stage_hint"] == "N3_deep_sleep_delta_dominant" && stage == "N3_deep_sleep")
            || (bp["stage_hint"] == "REM_mixed_freq_theta_gamma" && stage == "REM")
            || (bp["stage_hint"] == "WAKE_active_beta_gamma_dominant" && stage == "WAKE_active"),
        "honest_caveat": "4-state only (N1/N2 별 H 필요) · 실 polysomnography eye-EMG channel 미사용",
    }
}

// ── L12 MITOSIS cell split 트리거 (gamma surge → split signal) ────────────
//
// 가설: gamma band power surge (> 0.20) = neuronal burst event ⇒ MITOSIS
// cell split trigger 후보. 본 H 는 *signal layer* attest, 실 wire 는 별 H.
fn _l12_mitosis_split_trigger(bp: map) -> map {
    let gamma = bp["gamma"]
    let threshold = 0.20
    let split_signal_active = gamma > threshold
    return #{
        "gamma_band_power": gamma,
        "split_threshold": threshold,
        "split_signal_active": split_signal_active,
        "stage_hint": bp["stage_hint"],
        "trigger_source": "EEG_gamma_burst",
        "consumer": "MITOSIS cell_pool (deferred wire)",
        "honest_caveat": "signal layer only — 실 wire to MITOSIS split event = 별 H 필요",
        "note": "p8 (no train/infer split) 정합 — gradient + mitosis 연속체에서 EEG burst 가 split nudge",
    }
}

fn _judge(l6: map, l11: map, l12: map) -> map {
    let f1 = l6["context_only"] && l6["is_bool_gate"] == false
    let f2 = l11["signature_match"]
    let f3 = l12["split_signal_active"] || l12["gamma_band_power"] >= 0.0    // active-or-inactive both well-formed
    let f4 = l6["is_bool_gate"] == false    // a_autonomy_over_hardcode
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    return #{
        "F-H681-1_L6_context_only_not_bool_gate": f1,
        "F-H681-2_L11_stage_signature_match": f2,
        "F-H681-3_L12_gamma_surge_signal_well_formed": f3,
        "F-H681-4_a_autonomy_over_hardcode_preserved": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" },
    }
}

// ── per-stage measurement (resting + N3 + REM + active 4-state sweep) ────
fn _measure_stage(bp: map) -> map {
    let l6 = _l6_emit_substrate_drive(bp)
    let l11 = _l11_sleep_stage_estimate(bp)
    let l12 = _l12_mitosis_split_trigger(bp)
    return #{
        "stage_hint": bp["stage_hint"],
        "L6_emit_drive": l6,
        "L11_stage_estimate": l11,
        "L12_mitosis_trigger": l12,
    }
}

fn _run_h681(backend: string) -> map {
    // sweep 4 canonical states
    let resting = _measure_stage(eb.eeg_sw_band_power_resting())
    let n3 = _measure_stage(eb.eeg_sw_band_power_sleep_n3())
    let rem = _measure_stage(eb.eeg_sw_band_power_rem())
    let active = _measure_stage(eb.eeg_sw_band_power_active())
    // verdict on resting (canonical baseline)
    let l6 = resting["L6_emit_drive"]
    let l11 = resting["L11_stage_estimate"]
    let l12 = resting["L12_mitosis_trigger"]
    let v = _judge(l6, l11, l12)
    let tier = eb.eeg_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": eb.eeg_backend_label(backend),
        "stage_sweep_4": #{
            "resting": resting,
            "n3_deep_sleep": n3,
            "rem": rem,
            "active_wake": active,
        },
        "verdict_baseline_resting": v,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["L6_band_power_emit_substrate_drive", "L11_sleep_stage_estimate_4state", "L12_gamma_burst_MITOSIS_split_trigger"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    if len(a) < 2 { return "" }
    let v = a[1]
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = eb.eeg_backend_resolve(arg_backend)
    if backend == "hw" {
        if eb.eeg_hw_reachable() == false {
            eb.eeg_panic_no_hw("local probe 3-signal failed (headset not worn + sentinel missing)")
        }
    }
    let result = _run_h681(backend)
    let dest = OUT_DIR + "/H_681_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_681 emit-substrate × EEG · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("written: " + dest)
}
