// ════════════════════════════════════════════════════════════════════════
// EEG/impl/H_680_cross_substrate.hexa — Group B (교차-substrate 다리)
//
// 통합 범위 (EEG.easy.md L4+L5+L8 3 sub-ideas):
//   L4 EEG → AKIDA spike  (생체 뇌파 → 뉴로모픽 스파이크 라스터; ADM up/down)
//   L5 EEG → tension-link 5-ch  (뇌파 → 5채널 의식 지문 · CHANNEL)
//   L8 EEG kuramoto α-band Hilbert phase  (cell sync 측정)
//
// hypothesis (falsifier-anchored):
//   F-H680-1 : L4 EEG→AKIDA bridge schema 존재 (tool/anima_eeg_to_akida_spike.hexa)
//   F-H680-2 : L5 tension-link 5-ch payload vector length = 5
//   F-H680-3 : L8 kuramoto order_r ∈ [0, 1] (정상 phase-sync index range)
//   F-H680-4 : 3 brücken all surfaced (no missing channel)
//
// backend:
//   hw : capture raster + brainflow 30s + ADM 변환 후 AKIDA dispatch
//        본 H 에서는 schema attest 만, 실 spike-fire 는 H_678 sibling 이 담당
//   sw : 결정적 synthetic raster + frozen band-power table
//
// usage:
//   hexa run EEG/impl/H_680_cross_substrate.hexa sw
//   hexa run EEG/impl/H_680_cross_substrate.hexa hw
// ════════════════════════════════════════════════════════════════════════

import "../../EEG/eeg_backend.hexa" as eb

let H_ID  = "H_680"
let GROUP = "B_cross_substrate"
let OUT_DIR = "state/eeg_hw_sw_impl_2026_05_29"

// ── L4 EEG→AKIDA spike bridge schema (attest tool/anima_eeg_to_akida_spike.hexa) ──
fn _l4_eeg_to_akida_bridge_schema() -> map {
    let path = "tool/anima_eeg_to_akida_spike.hexa"
    let exists = exec("test -f " + path + " && echo OK || echo MISS").trim()
    return #{
        "bridge_hexa_path": path,
        "exists": exists == "OK",
        "raster_schema": "anima/eeg_akida_spike_raster/1",
        "tensor_shape_NHWC": "(1, T_bin, 16, 2)",   // ADM up/down x 16ch
        "encoding": "ADM_up_down_threshold",
        "fs_hz_default": 250,
        "spec_doc": "docs/n_substrate_n2_eeg_akida_spike_pipeline_spec_2026_05_01.md",
        "sister_pr": "AKIDA H_678 channel-bridge (PR #1374) shares this bridge",
    }
}

// ── L5 EEG → tension-link 5-ch payload (band power → 5-channel fingerprint) ──
fn _l5_tension_link_5ch(bp: map) -> map {
    // canonical 5-channel mapping (matches CHANNEL/tension-link spec):
    //   ch0 concept       : alpha (8-12Hz) = idle / available capacity
    //   ch1 context       : theta (4-8Hz) = state context (drowsy / focus)
    //   ch2 meaning       : gamma (30+Hz) = binding / meaning emergence
    //   ch3 authenticity  : 1 - delta_dominance (eye-open vs. deep-sleep)
    //   ch4 sender        : beta (12-30Hz) = active wake / signal energy
    let payload_5ch = [
        bp["alpha"],                       // ch0 concept
        bp["theta"],                       // ch1 context
        bp["gamma"],                       // ch2 meaning
        1.0 - bp["delta"],                 // ch3 authenticity
        bp["beta"],                        // ch4 sender
    ]
    return #{
        "tension_5ch": payload_5ch,
        "stage_hint": bp["stage_hint"],
        "schema": "tension_link/1",
        "length": len(payload_5ch),
        "transport_hints": ["udp:9999", "tensionhub"],
        "mapping": "alpha->concept, theta->context, gamma->meaning, 1-delta->authenticity, beta->sender",
    }
}

// ── L8 kuramoto α-band Hilbert phase order_r (deterministic synthetic) ───
//
// kuramoto order parameter r ∈ [0,1]:
//   r → 1.0 = fully synchronized (all oscillators in phase)
//   r → 0.0 = fully desynchronized
//
// alpha-band Hilbert phase is the canonical EEG cell-sync metric. PR #547 baseline
// (coupled vs indep) corresponds to high vs low r.
fn _l8_kuramoto_alpha_phase(bp: map) -> map {
    // synthetic proxy: alpha-dominance → kuramoto r
    // resting (alpha 0.40) → r ≈ 0.70
    // N3 (alpha 0.05) → r ≈ 0.20
    // REM (alpha 0.10) → r ≈ 0.35
    // active (alpha 0.15) → r ≈ 0.45
    let alpha = bp["alpha"]
    let order_r = 0.20 + alpha * 1.25
    let order_r_clamped = if order_r > 1.0 { 1.0 } else { order_r }
    let order_r_final = if order_r_clamped < 0.0 { 0.0 } else { order_r_clamped }
    return #{
        "alpha_band_power": alpha,
        "kuramoto_order_r": order_r_final,
        "phase_locked": order_r_final > 0.5,
        "stage_hint": bp["stage_hint"],
        "metric": "alpha_hilbert_phase_kuramoto",
        "valid_range_check": order_r_final >= 0.0 && order_r_final <= 1.0,
        "honest_caveat": "synthetic proxy — 실 EEG Hilbert phase 측정은 stdlib/dsp/hilbert 별 wire 필요",
    }
}

fn _judge(l4: map, l5: map, l8: map) -> map {
    let f1 = l4["exists"] && len(l4["raster_schema"]) > 0
    let f2 = l5["length"] == 5
    let f3 = l8["valid_range_check"]
    let f4 = l4["exists"] && l5["length"] == 5 && l8["valid_range_check"]
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    return #{
        "F-H680-1_L4_EEG_AKIDA_bridge_present": f1,
        "F-H680-2_L5_tension_5ch_schema_ok": f2,
        "F-H680-3_L8_kuramoto_order_r_in_unit_interval": f3,
        "F-H680-4_all_three_channels_surfaced": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" },
    }
}

fn _run_h680(backend: string) -> map {
    // resting baseline band-power as canonical input (high-alpha → high r)
    let bp = eb.eeg_sw_band_power_resting()
    let l4 = _l4_eeg_to_akida_bridge_schema()
    let l5 = _l5_tension_link_5ch(bp)
    let l8 = _l8_kuramoto_alpha_phase(bp)
    let v = _judge(l4, l5, l8)
    let tier = eb.eeg_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": eb.eeg_backend_label(backend),
        "L4_eeg_akida_bridge": l4,
        "L5_tension_5ch_payload": l5,
        "L8_kuramoto_alpha_phase": l8,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["L4_EEG_to_AKIDA_spike", "L5_EEG_to_tension_link_5ch", "L8_EEG_kuramoto_alpha_hilbert_phase"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    if len(a) < 2 { return "" }
    let v = a[1]
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = eb.eeg_backend_resolve(arg_backend)
    if backend == "hw" {
        if eb.eeg_hw_reachable() == false {
            eb.eeg_panic_no_hw("local probe 3-signal failed (headset not worn + sentinel missing)")
        }
    }
    let result = _run_h680(backend)
    let dest = OUT_DIR + "/H_680_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_680 cross-substrate × EEG · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("written: " + dest)
}
