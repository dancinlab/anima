// ════════════════════════════════════════════════════════════════════════
// EEG/eeg_backend.hexa — common HW/SW backend resolver + SW mock helpers
//
// 목적 (purpose):
//   EEG.easy.md L1~L12 12 아이디어를 통합 backend switch 한 점에서 분기
//   시키는 공통 모듈. arg("auto"/"hw"/"sw") > env(EEG_BACKEND) > default("sw").
//
// 설계 계약 (AKIDA 와 의도적으로 반대):
//   · default = "sw" (synthetic 우선) — 이유: EEG live = human-only 헤드셋 착용
//     단계. 거짓 PASS 유혹을 줄이기 위해 SW 가 기본. "live" 명시 → hw.
//   · SW path = 동결 어댑터 `BRAIN/eeg/eeg_to_tpm.hexa` (PR #547) + 결정적 합성기
//     (mock-coupled / mock-indep) 호출 — 실 EEG 캡처 없이 deterministic 검증.
//   · HW 미도달 시 명시 panic + 캡처 runbook §1~§4 안내 메시지.
//   · bool gate 0 · p7 self-judge 0 · 어떤 emit_allowed 도 노출 안 함
//   · 위조 PASS 금지 (a_blue_closed) — HW 미도달은 정직 "🟡 SW-confirmed"
//
// 사용 패턴:
//   import "../EEG/eeg_backend.hexa" as eb
//   let backend = eb.eeg_backend_resolve(arg)
//   if backend == "hw" {
//       if eb.eeg_hw_reachable() == false {
//           eb.eeg_panic_no_hw("3-signal probe failed (headset/board missing)")
//       }
//       // ... call hw capture ...
//   } else {
//       // SW path — use eb.eeg_sw_mock_coupled / indep / theta / alpha / gamma
//   }
// ════════════════════════════════════════════════════════════════════════

// ── env read helper (canonical printenv pattern) ────────────────────────
fn _env_read(name: string) -> string {
    let v = exec("printenv " + name + " 2>/dev/null")
    return v.trim()
}

// ── primary resolver (3-tier precedence: arg > env > default) ────────────
//
// arg ∈ {"auto", "hw", "sw", "live", ""} ; "auto" / "" fall through to env
// env(EEG_BACKEND) ∈ {"hw", "sw", ""} ; "" falls through to "sw" default.
// "live" alias → "hw" (사용자 의도 명시).
//
// returns: "hw" or "sw" (never "auto" / "live" — fully resolved).
pub fn eeg_backend_resolve(arg: string) -> string {
    if arg == "hw" { return "hw" }
    if arg == "live" { return "hw" }       // alias — "live" 명시 → hw
    if arg == "sw" { return "sw" }
    let e = _env_read("EEG_BACKEND")
    if e == "hw" { return "hw" }
    if e == "live" { return "hw" }
    if e == "sw" { return "sw" }
    return "sw"                             // ⚠ AKIDA 와 반대: default = sw
}

// ── HW reachability probe (3-signal: brainflow + board ping + capture dir) ─
//
// signal 1: brainflow python pkg import (.venv-eeg 또는 system)
// signal 2: 캡처 디렉토리 쓰기 가능 (state/eeg_capture_*)
// signal 3: 사용자 headset-ready sentinel — `~/.config/anima/eeg_headset_ready`
//           (사용자가 헤드셋 착용 + 임피던스 확보 후 명시적으로 touch)
//
// returns: true iff ALL 3 signals pass (conservative — single failure = false).
//
// note: signal 3 는 ssh-mutating 0, read-only. 사용자가 capture runbook §1 후
//       `touch ~/.config/anima/eeg_headset_ready` 1줄로 토큰 발행.
pub fn eeg_hw_reachable() -> bool {
    // signal 1: brainflow pkg
    let pkg = exec("python3 -c 'import brainflow' 2>/dev/null && echo OK || echo MISS").trim()
    if pkg != "OK" { return false }
    // signal 2: capture dir writable
    let dir_ok = exec("mkdir -p state/eeg_hw_sw_impl_2026_05_29/capture && echo OK || echo MISS").trim()
    if dir_ok != "OK" { return false }
    // signal 3: user sentinel
    let sentinel = exec("test -f ~/.config/anima/eeg_headset_ready && echo OK || echo MISS").trim()
    if sentinel != "OK" { return false }
    return true
}

// ── HW reachability summary (debug-friendly · returns dict of 3 signals) ──
pub fn eeg_hw_probe_signals() -> map {
    let pkg = exec("python3 -c 'import brainflow' 2>/dev/null && echo OK || echo MISS").trim()
    let dir_ok = exec("test -d state/eeg_hw_sw_impl_2026_05_29 && echo OK || echo MISS").trim()
    let sentinel = exec("test -f ~/.config/anima/eeg_headset_ready && echo OK || echo MISS").trim()
    return #{
        "signal_1_brainflow_pkg": pkg,
        "signal_2_capture_dir": dir_ok,
        "signal_3_user_sentinel": sentinel,
        "all_pass": pkg == "OK" && dir_ok == "OK" && sentinel == "OK",
    }
}

// ── explicit panic helper (a_completeness_over_cheap; no silent fallback) ─
//
// reason: short human-readable reason (e.g. "headset not worn", "brainflow missing").
// behavior: print explicit guidance with runbook reference, then call panic().
pub fn eeg_panic_no_hw(reason: string) {
    println("ERROR: EEG HW 미도달 — " + reason)
    println("       헤드셋 착용 + brainflow board id 확인 필요.")
    println("       SW 대체: `--backend sw` 또는 `EEG_BACKEND=sw` (default = sw)")
    println("       live 절차: EEG/EEG_CAPTURE_RUNBOOK.md §1~§4 (착용→임피던스→capture→hexa live)")
    println("       3-신호 점검: python3 -c 'import brainflow' + capture dir + ~/.config/anima/eeg_headset_ready")
    panic("EEG HW unreachable: " + reason)
}

// ── SW synthetic generators — deterministic, matches PR #547 baseline ────
//
// numerical source: PR #547 BRAIN/eeg/eeg_iit4_demo.hexa
//   coupled (anti-phase ch0/ch1): big-Φ ≈ 1.59
//   indep   (identical streams):  big-Φ ≈ 0.44
// these are recorded synthetic measurements — frozen baseline for ±5% assert.

pub fn eeg_sw_mock_coupled(n_samp: int) -> array {
    // ch0: 0,1,0,1,...   ch1: 1,0,1,0,...  (anti-phase swap dynamics)
    let mut s = []
    let mut t = 0
    while t < n_samp { s = s.push(to_float(t % 2)); t = t + 1 }
    t = 0
    while t < n_samp { s = s.push(to_float((t + 1) % 2)); t = t + 1 }
    return s
}

pub fn eeg_sw_mock_indep(n_samp: int) -> array {
    // ch0 == ch1 (no information beyond ch0; reducible)
    let mut s = []
    let mut t = 0
    while t < n_samp { s = s.push(to_float(t % 2)); t = t + 1 }
    t = 0
    while t < n_samp { s = s.push(to_float(t % 2)); t = t + 1 }
    return s
}

// ── synthetic baseline values (frozen, for assertion) ─────────────────────
pub fn eeg_sw_baseline_coupled_phi() -> float {
    return 1.59
}

pub fn eeg_sw_baseline_indep_phi() -> float {
    return 0.44
}

// ── band-power synthetic surrogates (L6 / L11 / L12 reuse) ───────────────
// resting-state 4-band canonical relative power (textbook approximation):
//   delta(0.5-4) ≈ 0.20 · theta(4-8) ≈ 0.15 · alpha(8-12) ≈ 0.40 · beta(12-30) ≈ 0.20 · gamma(30+) ≈ 0.05
// state-dependent shifts (WAKE/N1/N2/N3/REM) as deterministic mock.
pub fn eeg_sw_band_power_resting() -> map {
    return #{
        "delta": 0.20,
        "theta": 0.15,
        "alpha": 0.40,
        "beta":  0.20,
        "gamma": 0.05,
        "stage_hint": "WAKE_resting_eyes_closed",
    }
}

pub fn eeg_sw_band_power_sleep_n3() -> map {
    // N3 deep sleep: delta dominant, alpha collapsed
    return #{
        "delta": 0.70,
        "theta": 0.15,
        "alpha": 0.05,
        "beta":  0.05,
        "gamma": 0.05,
        "stage_hint": "N3_deep_sleep_delta_dominant",
    }
}

pub fn eeg_sw_band_power_rem() -> map {
    // REM: mixed-frequency low-amplitude, theta+gamma elevated, alpha low
    return #{
        "delta": 0.20,
        "theta": 0.30,
        "alpha": 0.10,
        "beta":  0.25,
        "gamma": 0.15,
        "stage_hint": "REM_mixed_freq_theta_gamma",
    }
}

pub fn eeg_sw_band_power_active() -> map {
    // active wake / task: beta+gamma elevated, alpha suppressed (alpha block)
    return #{
        "delta": 0.10,
        "theta": 0.10,
        "alpha": 0.15,
        "beta":  0.40,
        "gamma": 0.25,
        "stage_hint": "WAKE_active_beta_gamma_dominant",
    }
}

// ── backend label helper (printable provenance tag) ──────────────────────
pub fn eeg_backend_label(backend: string) -> string {
    if backend == "hw" { return "EEG biological live (OpenBCI/brainflow HW, headset-worn)" }
    if backend == "sw" { return "SW deterministic synthetic (PR #547 baseline 1.59/0.44 replay)" }
    return "UNKNOWN"
}

// ── verdict tier helper ──────────────────────────────────────────────────
//
// SW path → "🟢 numerical (synthetic-replay)" (honest — deterministic frozen adapter)
// HW path → "🟢 numerical (biological-confirmed)" (live EEG reading)
// per a_blue_closed: 🔵 reserved for closed-form formal · we never emit 🔵 here.
//
// NOTE: HW-unreachable callers should NOT use this fn to fake green; they must
//       emit "🟡 SW-confirmed, HW-pending" explicitly.
pub fn eeg_verdict_tier(backend: string, all_pass: bool) -> string {
    if all_pass == false { return "🔴 closed-negative" }
    if backend == "hw"  { return "🟢 numerical (biological-confirmed)" }
    if backend == "sw"  { return "🟢 numerical (synthetic-replay)" }
    return "🟡 unknown-backend"
}
