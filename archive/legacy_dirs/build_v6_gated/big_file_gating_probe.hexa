#!hexa strict
//
// big_file_gating_probe.hexa — F-A18-V6-OPTIMAL-3 latency justification probe.
//
// Demonstrates the SIZE-GATING value:
//   - For each big file (json-heavy >1MB), measure v1..v4 latency (no v6).
//   - Then measure v6 latency with timeout(30s) — expect tripping on >=2MB.
//   - Records both gated-result (skip v6) and ungated-result (force v6).
//
// Output: stdout JSONL, one record per probe.

let LATENCY_CAP_MS: i64 = 30000

let AOT_BIN: string = "/Users/ghost/core/anima/build_v6/hxc_a18_v6"

fn wall_ms() -> i64 {
    let raw = exec("perl -MTime::HiRes=time -e 'printf \"%.0f\", time()*1000' 2>/dev/null | tr -d ' \n'")
    if len(raw) == 0 { return 0 }
    return parse_int(raw)
}

fn parse_encode_line(line: string) -> array {
    let mut raw_n: i64 = -1
    let mut enc_n: i64 = -1
    let raw_idx: i64 = line.index_of("raw=")
    let enc_idx: i64 = line.index_of("enc=")
    if raw_idx >= 0 {
        let mut e = raw_idx + 4
        while e < len(line) && line.substring(e, e+1) != " " { e = e + 1 }
        raw_n = parse_int(line.substring(raw_idx + 4, e))
    }
    if enc_idx >= 0 {
        let mut e = enc_idx + 4
        while e < len(line) && line.substring(e, e+1) != " " { e = e + 1 }
        enc_n = parse_int(line.substring(enc_idx + 4, e))
    }
    return [raw_n, enc_n]
}

// Invoke variant with a wall-time budget cap.  Uses `perl alarm` shell wrapper
// to enforce timeout on the AOT binary.
fn invoke_variant_capped(variant: string, src: string, out_path: string, cap_sec: i64) -> array {
    let mut flag = ""
    if variant == "v2" { flag = " --v2" }
    else if variant == "v3" { flag = " --v3" }
    else if variant == "v3-o2" { flag = " --v3-o2" }
    else if variant == "v4" { flag = " --v4" }
    else if variant == "v6" { flag = " --v6" }
    // Use `perl -e 'alarm <sec>; exec @ARGV'` for portable timeout.
    let cap_str = to_string(cap_sec)
    let cmd = "perl -e 'alarm(" + cap_str + "); exec @ARGV' "
        + AOT_BIN + " encode --force" + flag + " '" + src + "' '" + out_path + "' 2>&1"
    let t0 = wall_ms()
    let out = exec(cmd)
    let t1 = wall_ms()
    let elapsed: i64 = t1 - t0
    let parsed = parse_encode_line(out)
    let mut tripped: i64 = 0
    if parsed[0] < 0 { tripped = 1 }
    return [elapsed, parsed[0], parsed[1], tripped]
}

fn probe_file(src: string) -> string {
    let stat_out = exec("stat -f%z '" + src + "' 2>/dev/null | tr -d ' \n'")
    let raw_n: i64 = if len(stat_out) > 0 { parse_int(stat_out) } else { 0 }

    let out_dir = "/tmp/a18_size_gated_probe"
    let _mkd = exec("mkdir -p " + out_dir)
    let path_hash = exec("printf '%s' '" + src + "' | shasum -a 1 | head -c 16 | tr -d ' \n'")
    let out_base = out_dir + "/" + path_hash

    eprintln("probe: " + src + " (" + to_string(raw_n) + " B)")

    let r_v1 = invoke_variant_capped("v1", src, out_base + ".v1", 60)
    eprintln("  v1: " + to_string(r_v1[0]) + "ms enc=" + to_string(r_v1[2]))
    let r_v2 = invoke_variant_capped("v2", src, out_base + ".v2", 60)
    eprintln("  v2: " + to_string(r_v2[0]) + "ms enc=" + to_string(r_v2[2]))
    let r_v3 = invoke_variant_capped("v3", src, out_base + ".v3", 60)
    eprintln("  v3: " + to_string(r_v3[0]) + "ms enc=" + to_string(r_v3[2]))
    let r_v3o2 = invoke_variant_capped("v3-o2", src, out_base + ".v3o2", 60)
    eprintln("  v3-o2: " + to_string(r_v3o2[0]) + "ms enc=" + to_string(r_v3o2[2]))
    let r_v4 = invoke_variant_capped("v4", src, out_base + ".v4", 60)
    eprintln("  v4: " + to_string(r_v4[0]) + "ms enc=" + to_string(r_v4[2]))

    // GATED min (NO v6).
    let mut best_gated_lbl = "identity"
    let mut best_gated_enc: i64 = raw_n
    let mut all = [r_v1, r_v2, r_v3, r_v3o2, r_v4]
    let mut tags = ["v1", "v2", "v3", "v3-o2", "v4"]
    let mut k: i64 = 0
    while k < 5 {
        let r = all[k]
        let enc: i64 = r[2]
        if enc > 0 && enc < best_gated_enc {
            best_gated_enc = enc
            best_gated_lbl = tags[k]
        }
        k = k + 1
    }

    // UNGATED probe: try v6 with cap.
    let r_v6 = invoke_variant_capped("v6", src, out_base + ".v6", 60)
    eprintln("  v6 (UNGATED): " + to_string(r_v6[0]) + "ms enc=" + to_string(r_v6[2]) + " tripped=" + to_string(r_v6[3]))

    // UNGATED min including v6.
    let mut best_ungated_lbl = best_gated_lbl
    let mut best_ungated_enc = best_gated_enc
    if r_v6[2] > 0 && r_v6[2] < best_ungated_enc {
        best_ungated_enc = r_v6[2]
        best_ungated_lbl = "v6"
    }

    let _c = exec("rm -f " + out_base + ".v* 2>&1")

    // Saving in basis points.
    let saving_gated: i64 = if raw_n > 0 { ((raw_n - best_gated_enc) * 10000) / raw_n } else { 0 }
    let saving_ungated: i64 = if raw_n > 0 { ((raw_n - best_ungated_enc) * 10000) / raw_n } else { 0 }

    let cap_breach_v6: i64 = if r_v6[0] > LATENCY_CAP_MS { 1 } else { 0 }

    let rec = "{\"path\":\"" + src + "\""
        + ",\"raw_bytes\":" + to_string(raw_n)
        + ",\"size_gate_threshold\":1048576"
        + ",\"size_gate_should_skip_v6\":" + (if raw_n > 1048576 { "true" } else { "false" })
        + ",\"v1_latency_ms\":" + to_string(r_v1[0]) + ",\"v1_enc\":" + to_string(r_v1[2])
        + ",\"v2_latency_ms\":" + to_string(r_v2[0]) + ",\"v2_enc\":" + to_string(r_v2[2])
        + ",\"v3_latency_ms\":" + to_string(r_v3[0]) + ",\"v3_enc\":" + to_string(r_v3[2])
        + ",\"v3o2_latency_ms\":" + to_string(r_v3o2[0]) + ",\"v3o2_enc\":" + to_string(r_v3o2[2])
        + ",\"v4_latency_ms\":" + to_string(r_v4[0]) + ",\"v4_enc\":" + to_string(r_v4[2])
        + ",\"v6_latency_ms\":" + to_string(r_v6[0]) + ",\"v6_enc\":" + to_string(r_v6[2])
        + ",\"v6_tripped\":" + to_string(r_v6[3])
        + ",\"v6_cap_breach_30s\":" + to_string(cap_breach_v6)
        + ",\"best_gated\":\"" + best_gated_lbl + "\",\"saving_gated_bp\":" + to_string(saving_gated)
        + ",\"best_ungated\":\"" + best_ungated_lbl + "\",\"saving_ungated_bp\":" + to_string(saving_ungated)
        + "}"
    return rec
}

fn main() {
    let av_raw = argv()
    let mut av = av_raw
    let mut skip1: bool = false
    if len(av_raw) >= 2 {
        let a1 = av_raw[1]
        let l1: i64 = len(a1)
        let mut is_tmp: bool = false
        if l1 >= 9 {
            let suf = a1.substring(l1 - 9, l1)
            if suf == ".tmp.hexa" { is_tmp = true }
        }
        if av_raw[0] == av_raw[1] || is_tmp { skip1 = true }
    }
    if skip1 {
        let mut tmp: array = []
        tmp.push(av_raw[0])
        let mut i: i64 = 2
        while i < len(av_raw) {
            tmp.push(av_raw[i])
            i = i + 1
        }
        av = tmp
    }

    let big_files = [
        "/Users/ghost/core/hexa-lang/state/aot_cache_gc.jsonl",
        "/Users/ghost/core/nexus/hexa_pitfalls_log.jsonl",
        "/Users/ghost/core/nexus/growth_bus.jsonl"
    ]
    let n: i64 = len(big_files)
    let mut i: i64 = 0
    while i < n {
        let rec = probe_file(big_files[i])
        println(rec)
        i = i + 1
    }
}
