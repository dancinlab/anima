// ═════════════════════════════════════════════════════════════════════════
// LAUNCHPAD/coffeshop_quorum_learn.hexa — COFFESHOP emit-quorum 학습 lane 라우터
//
// PLASTICITY 학습 lane (비결정론 · HW-only 적응). COFFESHOP 폐루프
// (coffeshop_akida) 의 emit-quorum 을 고정 상수가 아니라 stim_type 맥락별로
// **on-chip edge-learn** 으로 적응시킨다. 추론 lane (결정론 · byte-identical)과
// 본질이 다른 형제 lane.
//
// 라우팅 (AKIDA-first · HW-first 스위치 SSOT):
//   ../AKIDA/akida_backend.hexa::akida_backend_resolve_graceful (default "hw")
//     칩 도달  → on-chip AkidaUnsupervised Hebbian (edge_learn_probe 인터페이스:
//                InputData input_bits=1 → FC units=10 weights_bits=1 ·
//                compile(AkidaUnsupervised) · fit(x)). provenance "akida-learn-hw".
//     칩 미도달 → SW 고정 quorum (적응 없음) + 명시적 비동치 표기.
//                provenance "akida-learn-sw-approx".
//
// 🔴 CLOSED-NEGATIVE 정직성 (p7 · a_blue_closed):
//   SW 경로는 HW on-chip 학습과 byte-identical 재현 불가. 추론 DECODER lane
//   (akida_sw_lif, byte-identical)과 달리 학습 lane 은 본질적으로 비결정론 ·
//   silicon-specific (1-bit integer weight · on-chip competition/pruning/timing).
//   SW = 고정-quorum baseline 일 뿐 HW 대체 아님. 적응은 *기능* 이지 재현 대상 아님.
//   위조 동치 금지.
//
// 학습 대상 = 작고 bounded: stim_type 별 quorum DELTA ∈ [−3, +3] (base 6 → [3,9]).
//   on-chip winning-unit density 가 delta 방향을 구동 (salient stim → quorum↓ 적극).
//   수렴값 자체는 비결정론 (칩 상태) — verbatim 보고, 위조 금지.
//
// 실 구동 = LAUNCHPAD/coffeshop_quorum_learn.py.
// PLASTICITY 도메인 lane(../PLASTICITY/plasticity_lane.hexa) 규약 정합 형제.
// ═════════════════════════════════════════════════════════════════════════

import "../AKIDA/akida_backend.hexa" as bk

// 학습 lane provenance — PLASTICITY 규약("akida-learn-hw"/"akida-learn-sw-approx") 정합.
pub fn quorum_learn_provenance(arg: string) -> string {
    let backend = bk.akida_backend_resolve_graceful(arg)
    if backend == "hw" { return "akida-learn-hw" }
    return "akida-learn-sw-approx"
}

// HW path 콜 스펙 (pi5-akida edge_learn_probe 인터페이스).
pub fn quorum_learn_hw_probe_path() -> string {
    return "SUB_ENGINES/AKIDA/scripts/edge_learn_probe.py"
}

// 실 구동 엔트리.
pub fn quorum_learn_py_path() -> string {
    return "LAUNCHPAD/coffeshop_quorum_learn.py"
}

// base quorum + bounded delta.
pub fn quorum_learn_base()      -> int { return 6 }
pub fn quorum_learn_delta_max() -> int { return 3 }

// 학습 lane SW↔HW 동치 verdict — 정직 🔴 CLOSED-NEGATIVE (PLASTICITY 규약 그대로).
pub fn quorum_learn_equivalence_verdict() -> string {
    return "🔴 CLOSED-NEGATIVE (SW 고정-quorum ≠ HW on-chip AkidaUnsupervised — byte-identical 불가 · 비결정론)"
}

// 라우팅 요약 dict.
pub fn quorum_learn_route(arg: string) -> map {
    let backend = bk.akida_backend_resolve_graceful(arg)
    return #{
        "lane": "COFFESHOP-QUORUM-LEARN (PLASTICITY 학습 · 비결정론)",
        "backend": backend,
        "provenance": quorum_learn_provenance(arg),
        "hw_probe": quorum_learn_hw_probe_path(),
        "py_entry": quorum_learn_py_path(),
        "base_quorum": quorum_learn_base(),
        "delta_max": quorum_learn_delta_max(),
        "sw_hw_equivalence": quorum_learn_equivalence_verdict(),
        "sibling_inference_equivalence": "🟢 byte-identical (추론 lane coffeshop_akida — 대비)",
    }
}
