// ═════════════════════════════════════════════════════════════════════════
// LAUNCHPAD/coffeshop_akida_launch.hexa — COFFESHOP 90-min 라이브 발사 엔트리
//
// LAUNCHPAD launch surface: canonical COFFESHOP 90-min 15-window group-chat
// 시나리오를 AKIDA 폐루프(coffeshop_akida)로 구동하고 window 별 emit/silence
// trajectory 를 emit. AKIDA-first (HW 우선 · SW fallback 으로도 발사). 옵션으로
// broker /ws/akida_ingest 에 window record push.
//
// 시나리오 (COFFESHOP.md §4-§8): 15 window × 6-min tick = 90-min WAKE ultradian.
//   각 window 는 substrate motivation_score (8-factor battery emergent,
//   seed=20260525) — COFFESHOP.md §8 verbatim, 여기서 재유도 안 함.
//   알려진 trajectory: emit {3,10,14,15} · silence 11 · should_interrupt(0.60).
//   본 발사는 spike-quorum 폐루프(n_spikes≥6 ⟺ score>0.60)로 칩에서 재현.
//
// 실 구동 = LAUNCHPAD/coffeshop_akida_launch.py
//   USAGE: python3 coffeshop_akida_launch.py [hw|sw] [--broker ws://…/ws/akida_ingest]
//   default backend "hw" (AKIDA-first). Mac(칩 부재) → 정직 SW fallback 발사.
//
// substrate surface only (p1~p8 · a_substrate_native_speak): emit 결정 =
//   substrate motivation 만 (user msg = 환경 context · direct_mention silence 가능).
// ═════════════════════════════════════════════════════════════════════════

import "../AKIDA/akida_backend.hexa" as bk

pub fn launch_py_path() -> string {
    return "LAUNCHPAD/coffeshop_akida_launch.py"
}

// 알려진 emit window (COFFESHOP.md §5 — 발사 재현 target).
pub fn launch_known_emit_windows() -> list {
    return [3, 10, 14, 15]
}

pub fn launch_n_windows() -> int { return 15 }   // 90min / 6min tick

// broker 런칭 연결점.
pub fn launch_broker_endpoint() -> string {
    return "/ws/akida_ingest"
}

// 발사 backend (AKIDA-first 스위치 경유 · default hw).
pub fn launch_provenance(arg: string) -> string {
    let backend = bk.akida_backend_resolve_graceful(arg)
    if backend == "hw" { return "akida-hw" }
    return "akida-sw-fallback"
}

pub fn launch_route(arg: string) -> map {
    return #{
        "lane": "COFFESHOP-AKIDA-LAUNCH (90-min 라이브 발사)",
        "backend": bk.akida_backend_resolve_graceful(arg),
        "provenance": launch_provenance(arg),
        "py_entry": launch_py_path(),
        "n_windows": launch_n_windows(),
        "known_emit_windows": launch_known_emit_windows(),
        "broker_endpoint": launch_broker_endpoint(),
        "trajectory_source": "COFFESHOP.md §8 (seed=20260525 · emergent, 재유도 안 함)",
    }
}
