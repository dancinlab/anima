fn main() {
    // mirror of __main__: READ R2 by depth — max(rw('eeg',d), rw('meg',d)) over depths.
    print("AURA-READ: READ R2 by depth")
    let depths = [1.0, 2.5, 5.0, 7.0]
    let mut i = 0
    while i < len(depths) {
        let dep = to_float(to_string(depths[i]))
        let a = rw("eeg", dep)
        let b = rw("meg", dep)
        let mut best = a
        if b > best { best = b }
        print("  d" + to_string(dep) + " R2=" + to_string(best))
        i = i + 1
    }
}
