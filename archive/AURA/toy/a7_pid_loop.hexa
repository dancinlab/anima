// AURA/toy/a7_pid_loop.hexa — relocate-N1 closed-loop PID over IIT4 big-Φ.
//
//   GOAL (AURA A6 §5 R5): the A6 diagram drew a 6-step CLOSED LOOP
//   (N1 stim → EEG → big_phi → 12-var → PID → re-stim) but step ⑥ PID was
//   only a picture. Here we SIMULATE it in-silico: a discrete-time controller
//   adjusts a single stimulation parameter (the cross-region COUPLING drive c)
//   via a PID law toward a TARGET big-Φ setpoint, using the same bypass-vs-M1
//   connectivity plant as A6 over the SAME shared stdlib big_phi engine.
//
//   PLANT (coupling → big-Φ):  c ∈ [0,1] is the controllable drive. Each node's
//   next-state confidence blends A6's two regimes by c:
//       c=0  → pure M1-like self-copy   (local, reducible, big-Φ ≈ 0)
//       c=1  → pure bypass-like majority (hub fan-in, irreducible, big-Φ ≫ 0)
//   The plant maps c monotonically to a measured big-Φ (the "EEG→big_phi" leg),
//   so the controller can climb it.
//
//   CONTROLLER (the ⑥ PID re-stim leg):  err = setpoint − Φ_measured ;
//       c ← clamp( c + Kp·err + Ki·∫err + Kd·Δerr ).
//   This is the brainwire external PID loop (neuralink-technical-analysis §5,§9,
//   ~0.8 ms on-chip) reduced to its discrete control law.
//
//   POSITION CONTRAST (the falsifier):  the N1 chip is unchanged; only WHERE it
//   attaches changes the REACHABLE coupling:
//       BYPASS position (DLPFC+insula hub): c may rise to 1.0 → can hit a HIGH
//                       big-Φ setpoint → error → ~0.
//       M1 position (motor dead-end, local): c is CLAMPED to a low ceiling
//                       c_max (limited cross-region reach) → CANNOT reach the
//                       high setpoint → retains a STEADY-STATE error.
//
//   Pre-registered falsifier (a_paper_significance):
//     H: the bypass-position loop reaches the Φ setpoint (|err| < tol) while the
//        M1-position loop retains steady-state error (|err| >= tol).
//     FALSIFIED if M1 also reaches |err| < tol, OR bypass fails to.
//
//   HONEST: TOY plant model, NOT real neural dynamics. The coupling→Φ map is a
//   synthetic A6 TPM blend, not a measured transfer function. Latency (0.8 ms),
//   charge-density safety, and phase-lock are NOT modeled — this is a control-
//   convergence demonstration only. toy substrate ≠ production scale.
//
//   deterministic · hexa-only · $0 · no LLM.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }

fn clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// COUPLING-PARAMETERIZED PLANT TPM.
//   For coupling c, each node i's next-ON confidence is a c-weighted blend of:
//     M1 term     = self-copy  (0.9 if node i ON now else 0.1)
//     bypass term = majority of the OTHER nodes (0.9 if strict-majority ON else 0.1)
//   conf = (1-c)*m1_term + c*bypass_term.  c=0 → A6 M1-like, c=1 → A6 bypass-like.
fn tpm_coupled(n: int, c: float) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            // M1 self-copy term
            let mut m1t = 0.1
            if bit_of(s, i) == 1 { m1t = 0.9 }
            // bypass majority-of-others term
            let mut on = 0
            let mut j = 0
            while j < n {
                if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
                j = j + 1
            }
            let mut byt = 0.1
            if on * 2 > (n - 1) { byt = 0.9 }
            let conf = (1.0 - c) * m1t + c * byt
            tpm = tpm.push(conf)
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// MEASURE: run the coupling c through the plant → big-Φ (the EEG→big_phi leg).
fn measure_phi(n: int, sys: int, c: float) -> float {
    let tpm = tpm_coupled(n, c)
    let r = big_phi(tpm, n, sys)
    return r[0]
}

// CLOSED-LOOP PID RUN.
//   c starts at 0 (M1-like rest). Each iteration: measure Φ(c) → err → PID → new c.
//   c_max = position-dependent reachable-coupling ceiling.
//   Returns final |err|. Prints the convergence trace.
fn run_loop(label: string, n: int, sys: int, setpoint: float, c_max: float,
            Kp: float, Ki: float, Kd: float, iters: int, tol: float) -> float {
    println("  ---- " + label + "  (setpoint Φ* = " + str(setpoint) +
            " · c_max = " + str(c_max) + ") ----")
    println("    it |   c    |   Φ      |  err")
    let mut c = 0.0
    let mut integ = 0.0
    let mut prev_err = 0.0
    let mut last_err = setpoint   // |err| if loop body never ran
    let mut it = 0
    while it < iters {
        let phi = measure_phi(n, sys, c)
        let err = setpoint - phi
        last_err = err
        integ = integ + err
        let deriv = err - prev_err
        let mut step = Kp * err + Ki * integ + Kd * deriv
        // controller emits a new coupling drive, bounded by the position's reach
        let mut c_new = c + step
        c_new = clamp01(c_new)
        if c_new > c_max { c_new = c_max }
        prev_err = err
        // print sparse trace: first 3, then every 4th, then last
        if it < 3 || (it % 4) == 0 || it == iters - 1 {
            println("    " + str(it) + "  | " + str(c) + " | " + str(phi) + " | " + str(err))
        }
        c = c_new
        it = it + 1
    }
    // final settled error after the last control move
    let phi_f = measure_phi(n, sys, c)
    let err_f = setpoint - phi_f
    let mut abs_err = err_f
    if abs_err < 0.0 { abs_err = 0.0 - abs_err }
    println("    -> settled: c = " + str(c) + " · Φ = " + str(phi_f) +
            " · |err| = " + str(abs_err))
    return abs_err
}

fn main() {
    println("================================================================")
    println("  AURA A7 — relocate-N1 CLOSED-LOOP PID over IIT4 big-Φ (in-silico)")
    println("================================================================")
    let n = 4
    let sys = pow2(n) - 1            // all-ON system state (1111), as A6

    // plant calibration endpoints (A6 reproduced): c=0 vs c=1
    let phi_lo = measure_phi(n, sys, 0.0)
    let phi_hi = measure_phi(n, sys, 1.0)
    println("  plant: Φ(c=0, M1-like) = " + str(phi_lo) +
            "  Φ(c=1, bypass-like) = " + str(phi_hi))

    // HIGH setpoint = 80% of the bypass-reachable maximum. Unreachable from M1.
    let setpoint = 0.8 * phi_hi
    let tol = 0.5

    // PID gains (small, stable for this monotone plant)
    let Kp = 0.02
    let Ki = 0.004
    let Kd = 0.0
    let iters = 30

    // M1 position: limited cross-region reach → coupling ceiling c_max = 0.25.
    let err_m1 = run_loop("M1-position (local, limited coupling)",
                          n, sys, setpoint, 0.25, Kp, Ki, Kd, iters, tol)
    // bypass position: full hub reach → coupling ceiling c_max = 1.0.
    let err_by = run_loop("bypass-position (DLPFC+insula hub, full coupling)",
                          n, sys, setpoint, 1.0, Kp, Ki, Kd, iters, tol)

    println("================================================================")
    println("  setpoint Φ* = " + str(setpoint) + "  (tol = " + str(tol) + ")")
    println("  M1-position     final |err| = " + str(err_m1))
    println("  bypass-position final |err| = " + str(err_by))
    println("================================================================")

    // sanity: plant is non-trivial and monotone at the endpoints
    check("plant monotone: Φ(c=1) > Φ(c=0)", phi_hi > phi_lo + 0.000001)
    check("setpoint positive", setpoint > 0.000001)
    // PRE-REGISTERED FALSIFIER (two-sided):
    check("FALSIFIER H-a: bypass-position reaches setpoint (|err| < tol)",
          err_by < tol)
    check("FALSIFIER H-b: M1-position retains steady-state error (|err| >= tol)",
          err_m1 >= tol)
    // determinism
    let err_by2 = run_loop("bypass re-run (determinism)",
                           n, sys, setpoint, 1.0, Kp, Ki, Kd, iters, tol)
    check("determinism: bypass loop re-run identical |err|",
          (err_by - err_by2) < 0.000001 && (err_by2 - err_by) < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("A7 PID-loop toy FAILED") }
}
