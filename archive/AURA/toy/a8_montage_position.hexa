fn main() {
    let n_ch = 4
    let n_samp = 1000
    let sys = 15
    let mA = eeg_big_phi(MOTOR_AWAKE,    n_ch, n_samp, sys)
    let mS = eeg_big_phi(MOTOR_SED,      n_ch, n_samp, sys)
    let fA = eeg_big_phi(FRONTAL_AWAKE,  n_ch, n_samp, sys)
    let fS = eeg_big_phi(FRONTAL_SED,    n_ch, n_samp, sys)
    let tA = eeg_big_phi(TEMPORAL_AWAKE, n_ch, n_samp, sys)
    let tS = eeg_big_phi(TEMPORAL_SED,   n_ch, n_samp, sys)
    println("A8 MONTAGE-POSITION ds005620 sub-1010 n=4 @250Hz 4s sys=1111")
    println("MOTOR    (C3,Cz,C4,C2)  awake=" + str(mA[0]) + " sed=" + str(mS[0]))
    println("FRONTAL  (F3,Fz,F4,AFz) awake=" + str(fA[0]) + " sed=" + str(fS[0]))
    println("TEMPORAL (F7,T7,FT7,T8) awake=" + str(tA[0]) + " sed=" + str(tS[0]))
    println("falsifier FRONTAL_awake > MOTOR_awake : " + str(fA[0]) + " vs " + str(mA[0]))
    if fA[0] > mA[0] { println("[HUB>MOTOR] frontal-hub position carries higher big-Phi (awake) -- relocate-consistent") }
    else { println("[MOTOR>=HUB] motor position not exceeded by hub -- scalp-proxy negative") }
    let fA2 = eeg_big_phi(FRONTAL_AWAKE, n_ch, n_samp, sys)
    if (fA[0]-fA2[0]) < 0.000001 && (fA2[0]-fA[0]) < 0.000001 { println("[PASS] determinism: frontal awake re-run identical") } else { println("[FAIL] determinism") }
    println("RESULT: A8 montage-position big-Phi ran on n=4 exact engine")
}
