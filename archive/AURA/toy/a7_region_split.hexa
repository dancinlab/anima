// AURA/toy/a7_region_split.hexa — per-region big-Φ split honoring IIT4 n≤8.
//
//   THESIS (AURA SURVEY §2/§6 · BRAIN.md M1): a 16ch / 16-unit brain CANNOT be
//   measured exactly — IIT4 big-Φ is exact only for n≤8 (state space 2^(2n)).
//   The TEMPTING shortcut is "16ch → 4-region averaging" (one super-node per
//   region, 4 nodes, easily ≤8). BRAIN.md M1 records WHY that is WRONG:
//   averaging the units inside a region into a single mean signal ERASES the
//   intra-region causal coupling — exactly the irreducibility big-Φ measures.
//   A region collapsed to its mean is, by construction, a single self-correlated
//   unit → its internal Φ is destroyed before the engine ever sees it.
//
//   HONEST PATH (BRAIN.md M1, the M2 1차 전략): keep each region at its native
//   resolution and measure big-Φ PER REGION at n≤4 (engine-exact). No averaging,
//   no coupling erasure. We then compare two regions:
//
//     M1-REGION     : motor output, LOCAL / self-copy connectivity (dead-end
//                     output site, low cross-coupling) → small per-region Φ.
//     BYPASS-REGION : DLPFC/insula projection hub, every unit fans in/out to the
//                     others (high coupling, irreducible) → large per-region Φ.
//
//   Pre-registered falsifier (a_paper_significance):
//     H: per-region big_phi(BYPASS) >= per-region big_phi(M1).
//     FALSIFIED if Φ(bypass-region) < Φ(M1-region).
//   And the SHORTCUT-REFUTATION sub-claim:
//     averaging the bypass region to a 1-unit super-node DESTROYS its Φ
//     (Φ_avg(bypass) < Φ_perregion(bypass)) → 4-region averaging is wrong.
//
//   HONEST: synthetic region assignment + synthetic connectivity TPM, NOT a real
//   N1 / EEG recording (toy substrate ≠ production scale,
//   feedback_toy_scale_transfer). Real region masks need an electrode montage
//   (which channel → which region). We assert only the SIGN/ORDER, not the scale.
//
//   deterministic · hexa-only · $0 · no LLM. Same stdlib engine as BRAIN/eeg
//   (g61 engine ⊥ adapter) — n≤4 per region keeps every call engine-exact.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }

// ── M1-REGION TPM: each unit copies ITSELF (local autonomy, low coupling). ──
// Factorizes into independent units → small per-region big-Φ.
fn tpm_m1_region(n: int) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            if bit_of(s, i) == 1 { tpm = tpm.push(0.9) } else { tpm = tpm.push(0.1) }
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// ── BYPASS-REGION TPM: each unit's next state = majority of the OTHER units ──
// (projection-hub fan-in/fan-out). Every unit depends on the rest → cutting any
// partition is costly → large per-region big-Φ. Same coupling law as A6.
fn tpm_bypass_region(n: int) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            let mut on = 0
            let mut j = 0
            while j < n {
                if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
                j = j + 1
            }
            if on * 2 > (n - 1) { tpm = tpm.push(0.9) } else { tpm = tpm.push(0.1) }
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// ── 16→4-REGION AVERAGING (the WRONG shortcut, made explicit). ──
// Collapse a region's units into ONE super-node = its mean. A single unit whose
// next state copies its own mean is, by construction, self-coupled only → the
// engine sees a 1-node system, whose big-Φ is identically 0 (no parts to cut).
// We model this as a 1-unit self-copy TPM: averaging ERASES the coupling that
// made the bypass region irreducible (BRAIN.md M1 — "averaging kills coupling").
fn tpm_averaged_supernode() -> array {
    // n=1: state 0 -> P(on)=0.1 ; state 1 -> P(on)=0.9 (pure self-copy, no others)
    let mut tpm = []
    tpm = tpm.push(0.1)   // state 0 (off): stays off-ish
    tpm = tpm.push(0.9)   // state 1 (on):  stays on-ish
    return tpm
}

fn main() {
    println("================================================================")
    println("  AURA A7 — per-region big-Φ split (IIT4 n<=8 exact, n<=4/region)")
    println("================================================================")
    println("  system: 16 units, 4 regions x 4 units (synthetic montage).")
    println("  WHY NOT 16-unit exact: IIT4 exact needs 2^(2n) states;")
    println("    n=16 -> 2^32 ~ 4.3e9 -> infeasible (BRAIN.md M1 n<=8 limit).")
    println("  WHY NOT 4-region averaging: mean-collapse erases intra-region")
    println("    coupling = the irreducibility big-Φ measures (BRAIN.md M1).")
    println("  HONEST PATH: per-region n<=4, native resolution, no averaging.")
    println("----------------------------------------------------------------")

    let nr = 4                       // units per region (n<=4 engine-exact)
    let sys = pow2(nr) - 1           // all-ON region state (1111)

    // honest path — per-region exact big-Φ
    let m1     = tpm_m1_region(nr)
    let bypass = tpm_bypass_region(nr)
    let phi_m1     = big_phi(m1, nr, sys)
    let phi_bypass = big_phi(bypass, nr, sys)

    // wrong shortcut — average the bypass region into a 1-node super-node
    let avg = tpm_averaged_supernode()
    let phi_avg = big_phi(avg, 1, 1)

    println("  PER-REGION (honest, n=4 exact):")
    println("    M1-region     (motor / local self-copy)   big-Φ = " + str(phi_m1[0]))
    println("    bypass-region (DLPFC+insula hub/majority)  big-Φ = " + str(phi_bypass[0]))
    println("    ΔΦ(bypass - M1) = " + str(phi_bypass[0] - phi_m1[0]))
    println("  AVERAGED SHORTCUT (wrong, bypass -> 1 super-node):")
    println("    bypass-region averaged to mean super-node  big-Φ = " + str(phi_avg[0]))
    println("    coupling erased: Φ_avg=" + str(phi_avg[0]) + " vs Φ_perregion=" + str(phi_bypass[0]))
    println("----------------------------------------------------------------")

    // finiteness
    check("M1-region big-Φ finite >= 0", phi_m1[0] >= 0.0 - 0.000001)
    check("bypass-region big-Φ finite >= 0", phi_bypass[0] >= 0.0 - 0.000001)
    check("averaged super-node big-Φ finite >= 0", phi_avg[0] >= 0.0 - 0.000001)

    // PRE-REGISTERED FALSIFIER H: bypass-region per-region Φ >= M1-region Φ
    check("FALSIFIER H: per-region big-Φ(bypass) >= big-Φ(M1)",
          phi_bypass[0] >= phi_m1[0] - 0.000001)

    // SHORTCUT REFUTATION: averaging destroys the bypass region's Φ
    // (Φ_avg < Φ_perregion) → 16->4-region averaging erases coupling.
    check("SHORTCUT WRONG: averaged Φ < per-region Φ (coupling erased)",
          phi_avg[0] < phi_bypass[0] - 0.000001)

    // engine-exactness gate: every measured region is n<=4 (=> 2^(2n) <= 256)
    check("engine-exact: per-region n<=4 (2^(2n) feasible)",
          nr <= 4 && pow2(2 * nr) <= 256)

    // determinism
    let phi_bypass2 = big_phi(tpm_bypass_region(nr), nr, sys)
    check("determinism: bypass-region re-run identical",
          (phi_bypass[0] - phi_bypass2[0]) < 0.000001 && (phi_bypass2[0] - phi_bypass[0]) < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("A7 region-split big-Φ toy FAILED") }
}
