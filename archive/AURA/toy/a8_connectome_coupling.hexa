// AURA/toy/a8_connectome_coupling.hexa — connectome-prior coupling → big-Φ.
//
//   THESIS (AURA A8, supersedes A7.2's identity link): A7 set the reach%→
//   coupling map to w = r (identity) — a UNIFORM scalar shared by every node,
//   admitted in A7 §4 to be "a modeling choice, NOT derived from physiology".
//   A8 replaces that arbitrary identity with a literature-derived, PER-POSITION
//   connectivity prior taken from the documented cortico-subcortical projection
//   pathways (archive/brainwire/n1-deep-access-strategies.md §1,§4,§5):
//
//     DLPFC → VTA  (mesocortical, Layer-5 pyramidal, "most promising") .. 0.75
//     Entorhinal → hippocampus (perforant path, "most direct c→hipp")  .. 0.60
//     PFC → LC (NE) / PFC → raphe (5HT)                                .. 0.50 / 0.45
//     Insula → NTS / hypothalamus (autonomic gateway)                  .. 0.30..0.55
//     M1  (motor output, local, NO documented dense deep projection)   .. 0.10
//
//   So each cortical SEED gets its OWN coupling weight from the documented
//   projection-strength ordering, NOT one flat r. The synthetic TPM is then
//   built with a PER-NODE coupling vector w_i (node i is the i-th seed), and
//   big-Φ is recomputed. The A8 claim is the POSITION ORDERING under the
//   grounded weights: DLPFC > entorhinal > insula > M1.
//
//   Pre-registered falsifier (a_paper_significance):
//     Ha (CLUSTER, the load-bearing claim): the dense-projection seeds
//        {DLPFC w=0.75, entorhinal w=0.60} BOTH yield strictly higher big-Φ
//        than the weak-projection seeds {insula w=0.43, M1 w=0.10}, and insula
//        strictly exceeds M1. FALSIFIED if any dense seed ≤ any weak seed.
//     Hb (SATURATION PROBE, a_paper_negative_ok): the fine top-pair ordering
//        Φ(DLPFC) ≥ Φ(entorhinal) is ALSO pre-registered as a falsifier. It is
//        EXPECTED to fail — big-Φ saturates and slightly inverts past w≈0.6
//        (a mean-field-paradox-family effect: coupling strength is NOT monotone
//        in Φ at the dense end, cf XENO F-X10-MONOTONE). A Hb FAIL is a real
//        closed-negative finding, NOT forced to PASS by tuning weights.
//
//   HONEST: the prior is a LITERATURE-DERIVED ORDINAL (documented pathway
//   strengths), NOT subject-specific tractography. No DWI / Allen / structural
//   connectome data exists locally (searched /Users/ghost/core — none found).
//   The map is grounded in real neuroanatomy ORDERING, but the absolute weights
//   are the brainwire doc's estimated coefficients, not measured tract counts.
//   Synthetic TPM · toy ≠ production (feedback_toy_scale_transfer). n=4 exact.
//   deterministic · hexa-only · $0 · no LLM.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }

// CONNECTOME PRIOR (literature-derived ordinal, n1-deep-access-strategies.md):
//   uniform coupling scalar replaced by a PER-NODE weight w_i = projection
//   strength of cortical seed i to its densest verified deep hub.
//   Same 4 seeds drive 4 nodes — node i carries seed i's documented weight.
fn prior_dlpfc()      -> float { return 0.75 }   // DLPFC→VTA mesocortical (densest)
fn prior_entorhinal() -> float { return 0.60 }   // entorhinal→hippo perforant path
fn prior_insula()     -> float { return 0.43 }   // insula→NTS autonomic (mean DA/5HT/NE)
fn prior_m1()         -> float { return 0.10 }   // M1 motor output (local, no deep proj)

// reach-PARAMETERIZED TPM, but coupling is a PER-NODE VECTOR w (one per seed),
// replacing A7's single scalar w shared by all nodes.
//   P(node i ON next | s) = (1 - w_i)*p_self(i,s) + w_i*p_hub(i,s)
fn tpm_prior(n: int, w: array) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            let mut p_self = 0.1
            if bit_of(s, i) == 1 { p_self = 0.9 }
            let mut on = 0
            let mut j = 0
            while j < n {
                if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
                j = j + 1
            }
            let mut p_hub = 0.1
            if on * 2 > (n - 1) { p_hub = 0.9 }
            let wi = w[i]
            let p = (1.0 - wi) * p_self + wi * p_hub
            tpm = tpm.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// homogeneous prior: every node carries the SAME seed weight (isolates the
// single-position effect — the per-position ordering probe A8 actually claims).
fn tpm_homog(n: int, wv: float) -> array {
    let mut w = []
    let mut i = 0
    while i < n { w = w.push(wv); i = i + 1 }
    return tpm_prior(n, w)
}

fn main() {
    println("================================================================")
    println("  AURA A8 — connectome-prior coupling → IIT4 big-Φ (per-position)")
    println("================================================================")
    let n = 4
    let sys = pow2(n) - 1          // all-ON system state (1111)

    let w_dlpfc = prior_dlpfc()
    let w_ento  = prior_entorhinal()
    let w_insula = prior_insula()
    let w_m1    = prior_m1()

    // POSITION ORDERING probe: homogeneous TPM at each seed's documented weight.
    let phi_dlpfc  = big_phi(tpm_homog(n, w_dlpfc), n, sys)
    let phi_ento   = big_phi(tpm_homog(n, w_ento), n, sys)
    let phi_insula = big_phi(tpm_homog(n, w_insula), n, sys)
    let phi_m1     = big_phi(tpm_homog(n, w_m1), n, sys)

    let p_dlpfc  = phi_dlpfc[0]
    let p_ento   = phi_ento[0]
    let p_insula = phi_insula[0]
    let p_m1     = phi_m1[0]

    println("  connectome prior (literature-derived ordinal, n1 doc §1,§4,§5):")
    println("  ----------------------------------------------------------------")
    println("  position      hub pathway                w     big-Φ (n=4 exact)")
    println("  DLPFC         →VTA mesocortical          " + str(w_dlpfc) + "  " + str(p_dlpfc))
    println("  entorhinal    →hippo perforant           " + str(w_ento) + "   " + str(p_ento))
    println("  insula        →NTS autonomic             " + str(w_insula) + "  " + str(p_insula))
    println("  M1            motor output (local)       " + str(w_m1) + "   " + str(p_m1))
    println("  ----------------------------------------------------------------")
    println("  Δ(DLPFC - M1) = " + str(p_dlpfc - p_m1))

    // finiteness
    check("Φ finite >= 0 DLPFC", p_dlpfc >= 0.0 - 0.000001)
    check("Φ finite >= 0 entorhinal", p_ento >= 0.0 - 0.000001)
    check("Φ finite >= 0 insula", p_insula >= 0.0 - 0.000001)
    check("Φ finite >= 0 M1", p_m1 >= 0.0 - 0.000001)

    // PRE-REGISTERED FALSIFIER Ha (CLUSTER, load-bearing): dense seeds {DLPFC,
    // entorhinal} BOTH strictly exceed weak seeds {insula, M1}; insula > M1.
    let dense_gt_insula = (p_dlpfc > p_insula + 0.000001) && (p_ento > p_insula + 0.000001)
    let dense_gt_m1     = (p_dlpfc > p_m1 + 0.000001) && (p_ento > p_m1 + 0.000001)
    let insula_gt_m1    = (p_insula > p_m1 + 0.000001)
    check("FALSIFIER Ha: dense{DLPFC,ento} > weak{insula,M1} AND insula > M1",
          dense_gt_insula && dense_gt_m1 && insula_gt_m1)

    // PRE-REGISTERED FALSIFIER Hb (SATURATION PROBE, EXPECTED FAIL = finding):
    // fine top-pair ordering Φ(DLPFC) >= Φ(entorhinal). Reported, NOT gated.
    let hb = (p_dlpfc >= p_ento - 0.000001)
    if hb { println("  [Hb-PROBE] top-pair Φ(DLPFC)>=Φ(ento) HOLDS (no saturation inversion)") }
    else { println("  [Hb-PROBE] top-pair Φ(DLPFC)<Φ(ento) INVERTED — saturation/mean-field-paradox (closed-negative, EXPECTED)") }

    // heterogeneous prior: ALL 4 seeds in ONE system (mixed-position substrate)
    let w_mixed = [w_dlpfc, w_ento, w_insula, w_m1]
    let phi_mixed = big_phi(tpm_prior(n, w_mixed), n, sys)
    println("  mixed-position substrate (DLPFC|ento|insula|M1) big-Φ = " + str(phi_mixed[0]))
    check("Φ finite >= 0 mixed-position substrate", phi_mixed[0] >= 0.0 - 0.000001)

    // determinism
    let phi_re = big_phi(tpm_homog(n, w_dlpfc), n, sys)
    check("determinism: DLPFC re-run identical",
          (phi_re[0] - p_dlpfc) < 0.000001 && (p_dlpfc - phi_re[0]) < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("A8 connectome-coupling toy FAILED") }
}
