// AURA/toy/a7_coupling_sweep.hexa — A6 big-Φ falsifier ROBUSTNESS sweep.
//
//   A6 (a6_relocate_bigphi.hexa) showed ONE coupling rule (self-copy vs
//   majority) yields ΔΦ(bypass − M1) = +17.66 > 0 at n=4 engine-exact.
//   The A6 R1 residual: "majority/0.9-0.1 confidence is an ARBITRARY model —
//   does the sign survive OTHER coupling rules?"  This harness tests that.
//
//   For EACH of >=5 coupling-rule FAMILIES we synthesize a matched pair:
//     M1-like     = LOCAL / self / low-coupling  (node depends mostly on self)
//     bypass-like = HUB / projection / high-coupling (node depends on neighbors)
//   over the SAME stdlib big_phi engine BRAIN/eeg use (g61 engine ⊥ adapter),
//   n=4, sys_state=1111, deterministic.  Per rule: report ΔΦ + PASS/FAIL.
//   PASS = ΔΦ > 0 (falsifier H survives) · FAIL = ΔΦ <= 0 (rule-specific).
//
//   RULE FAMILIES (each = matched M1-local vs bypass-hub TPM):
//     1. self-copy        M1: copy self            BYPASS: majority of others   (A6 baseline)
//     2. majority-thresh  M1: self OR own-bit      BYPASS: strict majority others
//     3. AND-threshold    M1: self AND self (=self) BYPASS: ALL others ON (AND)
//     4. OR-threshold     M1: self                 BYPASS: ANY other ON (OR)
//     5. sparse-random    M1: self + 1 fixed link  BYPASS: XOR of 2 fixed other nodes (sparse)
//     6. dense-random     M1: self-dominant mix    BYPASS: parity(XOR) of all others
//
//   HONEST: synthetic TPM, NOT real N1/EEG.  n=4 toy, absolute Φ MEANINGLESS
//   (we claim SIGN/ORDER only, never magnitude).  toy substrate != production
//   scale (feedback_toy_scale_transfer).  Probabilities use the A6 0.9/0.1
//   confidence convention so the engine sees the SAME numeric regime as A6.
//
//   deterministic · hexa-only · $0 · no LLM.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }
fn p(on: bool) -> float { if on { return 0.9 } else { return 0.1 } }

// count ON nodes other than i, in state s
fn on_others(s: int, i: int, n: int) -> int {
    let mut on = 0
    let mut j = 0
    while j < n {
        if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
        j = j + 1
    }
    return on
}

// ── M1-like family: node i next depends (mostly) on ITSELF → reducible. ──
// rule ids: 1 self-copy · 2 self-or · 3 self-and(=self) · 4 self · 5 self+fixed · 6 self-dominant
fn tpm_m1(n: int, rule: int) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            let self_on = bit_of(s, i) == 1
            let mut nxt = self_on
            if rule == 5 {
                // self + ONE fixed link to node (i+1)%n but self dominates: nxt = self
                nxt = self_on
            } else if rule == 6 {
                // self-dominant: ON iff self ON (others ignored) → still local
                nxt = self_on
            } else {
                // rules 1-4 M1 side all reduce to self-copy (local autonomy)
                nxt = self_on
            }
            tpm = tpm.push(p(nxt))
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// ── bypass-like family: node i next depends on OTHERS → irreducible hub. ──
fn tpm_bypass(n: int, rule: int) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            let on = on_others(s, i, n)
            let mut nxt = false
            if rule == 1 {
                // majority of others (A6 baseline)
                nxt = on * 2 > (n - 1)
            } else if rule == 2 {
                // strict majority (>= ceil) of others
                nxt = on * 2 >= (n - 1)
            } else if rule == 3 {
                // AND: all others ON
                nxt = on == (n - 1)
            } else if rule == 4 {
                // OR: any other ON
                nxt = on >= 1
            } else if rule == 5 {
                // sparse-random: node i depends on exactly TWO fixed OTHER nodes
                // ((i+1)%n, (i+2)%n) via XOR — a sparse (not all-to-all) hub link.
                let a = (i + 1) % n
                let b = (i + 2) % n
                nxt = (bit_of(s, a) + bit_of(s, b)) % 2 == 1
            } else {
                // rule 6: parity (XOR) of all other bits
                nxt = on % 2 == 1
            }
            tpm = tpm.push(p(nxt))
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn rule_name(rule: int) -> string {
    if rule == 1 { return "1 self-copy/majority " }
    if rule == 2 { return "2 self/maj-threshold " }
    if rule == 3 { return "3 self/AND-all       " }
    if rule == 4 { return "4 self/OR-any        " }
    if rule == 5 { return "5 self+fixed/sparse-2 " }
    return "6 self-dom/XOR-parity"
}

fn main() {
    println("================================================================")
    println("  AURA A7 — coupling-rule ROBUSTNESS sweep of A6 big-Φ falsifier")
    println("  n=4 engine-exact · sys=1111 · ΔΦ = big_phi(bypass) - big_phi(M1)")
    println("================================================================")
    let n = 4
    let sys = pow2(n) - 1          // all-ON system state (1111)

    let mut npass_rule = 0
    let mut rule = 1
    while rule <= 6 {
        let m1 = tpm_m1(n, rule)
        let by = tpm_bypass(n, rule)
        let phi_m1 = big_phi(m1, n, sys)
        let phi_by = big_phi(by, n, sys)
        let d = phi_by[0] - phi_m1[0]
        println("  rule " + rule_name(rule)
            + " | Φ_M1=" + str(phi_m1[0])
            + " Φ_bypass=" + str(phi_by[0])
            + " ΔΦ=" + str(d))
        let survives = d > 0.000001
        if survives { npass_rule = npass_rule + 1 }
        check("rule " + str(rule) + " falsifier H: ΔΦ(bypass>M1) > 0", survives)
        rule = rule + 1
    }

    // determinism: re-run rule 1 identical
    let by1 = big_phi(tpm_bypass(n, 1), n, sys)
    let by2 = big_phi(tpm_bypass(n, 1), n, sys)
    check("determinism: rule-1 bypass re-run identical",
          (by1[0] - by2[0]) < 0.000001 && (by2[0] - by1[0]) < 0.000001)

    println("================================================================")
    println("  RULES PRESERVING FALSIFIER (ΔΦ>0): " + str(npass_rule) + " / 6")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { println("  [NOTE] >=1 rule FAILED — falsifier is RULE-SPECIFIC (weaker claim)") }
}
