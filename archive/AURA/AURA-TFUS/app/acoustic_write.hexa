fn main() {
    // mirror of __main__: tFUS write R2 vs MEG R2 over depths 1.5..5.0.
    let depths = [1.5, 3.0, 5.0]
    let mut i = 0
    while i < len(depths) {
        let dep = to_float(to_string(depths[i]))
        print("depth " + to_string(dep) + ": tFUS write R2=" + to_string(wfid("tfus", dep)) + "  vs MEG " + to_string(wfid("meg", dep)))
        i = i + 1
    }
