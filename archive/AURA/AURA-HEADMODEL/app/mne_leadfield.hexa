// AURA-HEADMODEL — REAL MNE fsaverage BEM EEG lead-field (companion)
// companion to the MNE harness that produced verify/mne_real_leadfield.txt.
// $0 — MNE 1.12.1 pre-installed on pool ubu-1 (no pip, no pod).
//
// hexa is COMPILED — this file is the spec-companion (logic mirrored from the
// MNE run); the live numbers are in verify/mne_real_leadfield.txt (verbatim).
//
// MODEL: fsaverage 3-layer BEM forward (brain/skull/scalp 5120-tri meshes) —
//        NOT a sphere, NOT a gaussian. standard_1005 montage (343 EEG ch),
//        oct5 cortical src (2052) + volume src (1821 voxels). Real gain matrix
//        G = make_forward_solution(...) is the #1 ground-truth the AURA papers
//        left NOT-MEASURED.
// MEASURES: M1 = ||G[:,s]|| per-source scalp signal magnitude (deterministic);
//           M2 = R2 active-source recovery, ridge inverse (SAME as the toys).

fn r2(ss_res: float, ss_tot: float) -> float {
    // active-source recovery R2 = 1 - SS_res/SS_tot  (same as gaussian/3-shell)
    let v = 1.0 - ss_res / (ss_tot + 1e-30)
    return if v < -1.0 { -1.0 } else { v }
}

fn depth_drop(shallow: float, deep: float) -> float {
    // gain-magnitude cortex->deep drop. measured real ||G|| x1.27 (gentle).
    // direction (deep < shallow) is robust; the toys' R2 ratios (x8.4 gaussian,
    // x15.4 sphere) reflect smooth-kernel inverse behaviour, not real signal physics.
    return shallow / (deep + 1e-30)
}

fn main() {
    // INVARIANTS (measured — see verify/mne_real_leadfield.txt):
    //  (1) deep < cortex on REAL BEM: ||G|| 1.087e3 -> 8.568e2 (x1.27 drop);
    //      R2 0.040 -> 0.000 (noise floor) with depth.
    //  (2) electrode saturation = gaussian-only artifact (C10): real head does
    //      NOT saturate — R2 16->256 climbs 0.005->0.026 (deltas +0.002..+0.007),
    //      mean||G|| captured grows 203 -> 841; lambda-robust (M32->M256 +ve).
    //  (3) toy ABSOLUTE R2 (0.2-0.8) does NOT transfer to a real ill-conditioned
    //      BEM gain — simple-ridge R2 sits at noise floor (0.0-0.05) / goes
    //      negative at low lambda. honest toy->real limitation (cf MEMORY).
    println("AURA-HEADMODEL real MNE lead-field — see verify/mne_real_leadfield.txt")
}
