// AURA-DEPTH — 3-concentric-sphere ANALYTIC EEG depth envelope (cortex⟷deep).
// companion of the numpy reference run on pool ubu-1 (verify/sphere_depth_envelope.txt).
// ⚠ awaiting hexa-lang builtins: legendre_pn · matmul (L@x) · linalg_solve · randn/choice.
//   The Legendre P_n recurrence over N sources + (M×S) lead-field fill + min-norm
//   inverse (L.T @ solve(L L.T + λI, y)) are not yet hexa-native → numeric run done
//   via pool numpy. r2 + the Ary radial coefficient (pure arithmetic) ARE native and
//   mirrored faithfully below.
//
// MODEL (Ary/Klein/Fender 1981, radial dipole, 3 nested shells — same as AURA-HEADMODEL):
//   brain(r1=8.0, σ_b) · skull(r2=8.5, σ_sk=σ_b/40) · scalp(r3=9.2, σ_sc).
//   scalp V(θ) = Σ_n g_n(ξ,b) · P_n(cosθ).  ξ=σ_sk/σ_b ; b=source radius.
//   DEPTH sweep: source eccentricity ecc∈[0.95 cortex-surf .. 0.10 deep-core], b=ecc·r1.
//   As b→0 (deep) the radial coefficient g_n ∝ b^(2n) collapses → scalp signature
//   vanishes geometrically = a PHYSICAL depth wall (NO gaussian assumption).
//
// FINDING (verify/sphere_depth_envelope.txt, 🟡 toy, 8-seed):
//   ① 3-shell depth envelope: cortex-surf R2 0.239 → deep-core R2 0.016 (rel 100%→6.5%).
//   ② gaussian "over-pessimism" FALSIFIED / sign-REVERSED: 3-shell x15.4 STEEPER than
//      in-harness gaussian x3.2 (and ≥ C15-published x8.4). The HEADMODEL x1.5 was a
//      SHALLOW-window artifact (depth_frac 0→3 keeps b 0.85–1.0·r1, all cortical).
//   ③ direction deep<cortex ROBUST (both models monotone) — C15/B7 wall confirmed.

let R1: float = 8.0
let R2: float = 8.5
let R3: float = 9.2

// --- r2: coefficient of determination (active-source recovery). native. ---
fn r2(x: list, xh: list) -> float {
    let n = len(x)
    let mut mean = 0.0
    let mut i = 0
    while i < n { mean = mean + to_float(to_string(x[i]))   i = i + 1 }
    mean = mean / to_float(to_string(n))
    let mut den = 0.0
    let mut num = 0.0
    i = 0
    while i < n {
        let xv = to_float(to_string(x[i]))
        let xhv = to_float(to_string(xh[i]))
        den = den + (xv - mean) * (xv - mean)
        num = num + (xv - xhv) * (xv - xhv)
        i = i + 1
    }
    if den <= 0.0 { return 0.0 }
    let v = 1.0 - num / den
    if v < -1.0 { return -1.0 }
    return v
}

// --- pow helper (float base, integer exponent via repeated mul; native). ---
fn powf(base: float, e: int) -> float {
    let mut r = 1.0
    let mut i = 0
    while i < e { r = r * base   i = i + 1 }
    return r
}

// --- Ary 1981 3-shell radial-dipole Legendre coefficient g_n. native arithmetic.
//     mirrors python ary(n,xi,b). ξ=skull/brain conductivity ratio, b=src radius. ---
fn ary_gn(n: int, xi: float, b: float) -> float {
    let f1 = R1 / R3
    let f2 = R2 / R3
    let nn = to_float(to_string(n))
    let d1 = (nn + 1.0) * xi + nn
    let d2 = 1.0 - xi
    let ex = 2 * n + 1
    let geo = powf(f1 / f2, ex) - powf(f2, ex)
    let term = d1 * (nn * xi + nn + 1.0) + nn * (nn + 1.0) * d2 * d2 * geo
    let denom = 2.0 * term * (2.0 * nn + 1.0)
    if denom < 1.0e-300 && denom > -1.0e-300 { return 0.0 }
    let twonp1 = 2.0 * nn + 1.0
    let cube = twonp1 * twonp1 * twonp1
    // (2n+1)^3 * b^(n-1) * b^(n+1) / denom  ==  (2n+1)^3 * b^(2n) / denom
    return cube * powf(b, 2 * n) / denom
}

// --- depth → source radius. ecc∈[0,1] eccentricity of the brain shell; b=ecc·r1
//     normalized by r3 (matches python (ecc*R1)/R3). deeper = smaller ecc. ---
fn b_of_ecc(ecc: float) -> float { return (ecc * R1) / R3 }

// --- leading (n=1) Ary coefficient at a given depth (smoke value; full spectrum
//     needs array ops). mirrors gn_shell_ecc(xi,ecc)[0] pre-normalization. ---
fn gn1_at_ecc(xi: float, ecc: float) -> float {
    return ary_gn(1, xi, b_of_ecc(ecc))
}

// --- TODO(builtin): full g_n[0..NMAX] spectrum + L2-normalize + Legendre P_n
//     recurrence into the (M×S) L_shell matrix. numpy ref only. ---
fn gn_spectrum_stub() -> list { return [] }

// --- TODO(builtin): regularized min-norm inverse L.T @ solve(L L.T + λI, y).
//     needs matmul + linalg_solve. numpy ref only. ---
fn inv_stub() -> list { return [] }

fn main() {
    // smoke: Ary n=1 coefficient is native + finite, and DROPS from cortex→deep.
    let xi = 1.0 / 40.0
    let g_cortex = gn1_at_ecc(xi, 0.95)
    let g_deep = gn1_at_ecc(xi, 0.10)
    print("3-shell Ary g_1  cortex(ecc0.95)=" + to_string(g_cortex)
          + "  deep(ecc0.10)=" + to_string(g_deep))
    print("full depth envelope (ecc 0.95->0.10 x 8-seed) ran on pool ubu-1 numpy.")
    print("VERDICT: deep<cortex ROBUST; gaussian over-pessimism FALSIFIED (3-shell steeper).")
    print("see AURA/AURA-DEPTH/verify/sphere_depth_envelope.txt (verbatim stdout).")
}
