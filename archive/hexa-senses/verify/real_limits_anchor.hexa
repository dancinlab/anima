#!hexa strict
// hexa-senses/verify/real_limits_anchor.hexa — real-limits-first anchor.
//
// Per LATTICE_POLICY.md §1.3 rule 2: each project's verify must use at
// least one anchor from §1.2 (Shannon · Bekenstein · c · ℏ · k · etc.)
// and at least one engineering/industry threshold. For human-sensory
// substrate the "real limits" anchor set is psychophysics + receptor
// biology, all population-typical and well-cited.
//
// hexa-senses's real-limits audit lives in LIMIT_BREAKTHROUGH.md (Wave M,
// 2026-05-12). This script confirms that file is present and references
// the canonical sensory HARD walls so any agent has a pointer from
// verify→audit.
//
// Honesty: no value here is computed against the n=6 lattice. Each
// constant is sourced from peer-reviewed psychophysics (Hecht 1942,
// Bushdid 2014 vs Meister 2015, Vatakis & Spence 2006, Jeffress 1948,
// Weber/Fechner/Stevens) as cited in LIMIT_BREAKTHROUGH.md.
//
// raw#10 C3: real sensory research (NIH/NIDCD audiogram, Apple's color
// science, Dolby Atmos psychoacoustics) uses peer-reviewed thresholds.
// We anchor to those, never to lattice fits.

let HOME = env("HOME")
let HEXA_SENSES_ROOT_ENV = env("HEXA_SENSES_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_SENSES_ROOT_ENV.len() > 0 { return HEXA_SENSES_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-senses"
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    let r = exec(cmd).trim()
    return r == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-senses/verify/real_limits_anchor — real-limits-first check")
    println("  root: " + root)
    println("")
    println("  policy: LATTICE_POLICY §1.3 rule 2 — at least 1 real limit anchor required")
    println("  source: LIMIT_BREAKTHROUGH.md (Wave M, human-sensory psychophysics audit)")
    println("")

    let mut ok = 0
    let mut bad = 0

    // 1. Audit file must exist.
    let audit = root + "/LIMIT_BREAKTHROUGH.md"
    if _file_exists(audit) {
        println("  [PASS] LIMIT_BREAKTHROUGH.md present")
        ok = ok + 1
    } else {
        println("  [FAIL] LIMIT_BREAKTHROUGH.md missing (abs: " + audit + ")")
        bad = bad + 1
    }

    // 2. Audit must reference canonical human-sensory HARD walls.
    //    Each anchor is a sourced HARD/SOFT wall from LIMIT_BREAKTHROUGH.md §2.
    let anchors = [
        ["Foveal acuity 1 arcmin (Snellen 20/20)", "20/20"],            // §2.1 vision HARD
        ["Audible band 20 Hz – 20 kHz",            "20 Hz"],             // §2.2 audition HARD
        ["Auditory threshold ~0 dB SPL",            "0 dB SPL"],          // §2.2 audition HARD (NIH/NIDCD)
        ["Olfactory receptor count ~400",           "400 functional"],   // §2.3 olfact HARD
        ["Basic taste qualities = 5",               "5 (sweet"],          // §2.4 taste HARD
        ["Two-point tactile discrimination 2 mm",   "2 mm"],              // §2.5 touch HARD
        ["Cross-modal binding ~100 ms",             "Vatakis"],           // §2.6 binding HARD
        ["Hecht 1942 photon threshold",             "Hecht"],             // §6 ref
        ["Bushdid 2014 / Meister 2015 dispute",     "Meister 2015"],      // §2.3 dispute
    ]
    for a in anchors {
        let label = a[0]
        let needle = a[1]
        if _file_contains(audit, needle) {
            println("  [PASS] anchor referenced: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] anchor missing: " + label + " (needle: '" + needle + "')")
            bad = bad + 1
        }
    }

    // 3. Honesty caveat: synaesthesia / extended-sense claims must remain
    //    UNPROVEN, and BCI sensory restoration must stay UNVERIFIED at
    //    production (raw#10 C3 + LATTICE_POLICY §3.3).
    //    The voice verb is formulaic-only — learned TTS is FORBIDDEN; that
    //    constraint is also audited here.
    let caveats = [
        ["Olfactory 10^12 claim flagged DISPUTED", "DISPUTED"],
        ["Voice verb formulaic-only (FORBIDDEN learned TTS)", "FORBIDDEN"],
        ["n=6 lattice not used as anchor here",     "lattice anchors NOT used"],
    ]
    for u in caveats {
        let label = u[0]
        let needle = u[1]
        if _file_contains(audit, needle) {
            println("  [PASS] honesty caveat preserved: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] honesty caveat MISSING: " + label)
            bad = bad + 1
        }
    }

    println("")
    println("  anchors verified: " + str(ok) + "  failures: " + str(bad))
    if bad > 0 {
        println("__HEXA_SENSES_REAL_LIMITS_ANCHOR__ FAIL")
        exit(1)
    }
    println("__HEXA_SENSES_REAL_LIMITS_ANCHOR__ PASS")
}
