// SPATIAL/scan/spatial_coupling_phi.hexa — S1 spatial coupling Φ scan
//
//   XENO paper #1414 v2 의 (n × density × structure) 3D matrix +
//   TEMPORAL H_841 의 Δt 4번째 축에 이어, SPATIAL 은 5번째 축인
//   **spatial-coupling-scale** 위에서 같은 invariant_detector 가
//   어떻게 calibrate 되는지 closed-form 측정.
//
//   axis: 4 spatial-coupling-scale × n=128 dense, 4 substrate (각 scale 1개)
//     (a) local      — XOR cascade nearest-neighbor coupling
//     (b) regional   — 32-step rolling mean coupling
//     (c) global     — 전체 평균 + 자기 self 50:50 결합
//     (d) cosmic     — sparse random link 10% + 매우 long-range jump
//
//   4 × 1 = 4 measurement cells.
//
//   Pre-registered falsifiers (post-tuning 0, frozen):
//
//     F-S1-LOCAL-HIGH    : local phi > 0.3       (nearest-neighbor coupling = irreducible)
//     F-S1-REGIONAL-MID  : regional phi 0.1~0.5  (mid-range coupling Φ 살아남음)
//     F-S1-GLOBAL-LOW    : global phi < local    (averaging = reducible, 직관 monotone)
//     F-S1-COSMIC-LOWEST : cosmic phi < global   (sparse jump = uniformity 외 영역)
//     F-S1-MONOTONE      : local > regional > global > cosmic (Φ ↓ scale ↑ axiom)
//
//   pass 4/5 → 🟢 SUPPORTED-NUMERICAL (Φ monotone over spatial scale)
//   pass 3/5 → 🟡 PARTIAL-SUPPORT
//   pass < 3/5 → 🔴 FALSIFIED-INSTRUMENT
//
//   Honesty (a_blue_closed): thresholds frozen pre-run, verbatim detector out.
//   p7 = 0 (no LLM judge). a_completeness_over_cheap: 4 substrate × 1 scale
//   = 4 cells (S2/S3/S4 의 multi-scale + SOC + network 는 next round).
//   a_fire_autonomous (no GPU): Mac local $0 wall <5s.
//
import "../../XENO/detector/invariant_detector.hexa"

// ── substrate generators (hardcoded literal, deterministic, n=128) ─────────

// (a) local — XOR cascade nearest-neighbor coupling (X10-d hive emergence)
// bit[i] = bit[i-1] XOR bit[i-2] — single-step neighbor, irreducible
fn gen_local(n: int) -> array {
    let mut s = []
    s = s.push(1.0)
    s = s.push(0.0)
    let mut i = 2
    while i < n {
        let a = s[i - 1]
        let b = s[i - 2]
        let mut xor = 0.0
        if a > 0.5 {
            if b > 0.5 { xor = 0.0 } else { xor = 1.0 }
        } else {
            if b > 0.5 { xor = 1.0 } else { xor = 0.0 }
        }
        s = s.push(xor)
        i = i + 1
    }
    return s
}

// (b) regional — 32-step rolling mean coupling
// 첫 32개 seed pattern → 그 후 last-32 mean + LCG noise 결합 → binarise
fn gen_regional(n: int, seed: int) -> array {
    let mut s = []
    // seed window = period-8 pattern × 4 (32 entries)
    let pattern = [0.0, 0.25, 0.5, 0.75, 1.0, 0.75, 0.5, 0.25]
    let mut p = 0
    while p < 32 {
        s = s.push(pattern[p % 8])
        p = p + 1
    }
    let mut st = seed
    let mut i = 32
    while i < n {
        // 32-step rolling mean
        let mut m = 0.0
        let mut k = 0
        while k < 32 {
            m = m + s[i - 1 - k]
            k = k + 1
        }
        m = m / 32.0
        st = (st * 1103515245 + 12345) % 2147483648
        let noise = (((st / 1000) % 100) as float) / 100.0
        // mean-noise 결합 → binarise (mid-range coupling)
        let v = 0.5 * m + 0.5 * noise
        if v >= 0.5 { s = s.push(1.0) } else { s = s.push(0.0) }
        i = i + 1
    }
    return s
}

// (c) global — 전체 평균 + 자기 self 50:50 결합 (uniformity attractor)
// 첫 8개 seed → 그 후 (전체 mean + self) / 2 + noise → binarise
fn gen_global(n: int, seed: int) -> array {
    let mut s = []
    s = s.push(1.0)
    s = s.push(0.0)
    s = s.push(1.0)
    s = s.push(0.0)
    s = s.push(1.0)
    s = s.push(0.0)
    s = s.push(1.0)
    s = s.push(0.0)
    let mut st = seed
    let mut i = 8
    while i < n {
        // 전체 (i) 길이 평균
        let mut g = 0.0
        let mut k = 0
        while k < i {
            g = g + s[k]
            k = k + 1
        }
        g = g / (i as float)
        let self_v = s[i - 1]
        st = (st * 1103515245 + 12345) % 2147483648
        let noise = (((st / 1000) % 100) as float) / 100.0
        // 전체 평균 50% + self 50% (averaging, reducible)
        let v = 0.5 * g + 0.5 * self_v + (noise - 0.5) * 0.1
        if v >= 0.5 { s = s.push(1.0) } else { s = s.push(0.0) }
        i = i + 1
    }
    return s
}

// (d) cosmic — sparse random link 10% + 매우 long-range jump
// 90% noise + 10% 의 경우 매우 long-range (n/2 + offset) link 와 XOR
fn gen_cosmic(n: int, seed: int) -> array {
    let mut s = []
    let mut st = seed
    // 첫 (n/2 + 4) seed = pure pseudo-noise
    let halfn = n / 2
    let mut p = 0
    while p < halfn + 4 {
        st = (st * 1103515245 + 12345) % 2147483648
        let q = (st / 1000) % 10
        if q < 5 { s = s.push(0.0) } else { s = s.push(1.0) }
        p = p + 1
    }
    let mut i = halfn + 4
    while i < n {
        st = (st * 1103515245 + 12345) % 2147483648
        let r = (st / 1000) % 10
        if r < 1 {
            // 10% : sparse cosmic link — 현재 와 i - halfn (매우 long-range) XOR
            let a = s[i - 1]
            let b = s[i - halfn]
            let mut xor = 0.0
            if a > 0.5 {
                if b > 0.5 { xor = 0.0 } else { xor = 1.0 }
            } else {
                if b > 0.5 { xor = 1.0 } else { xor = 0.0 }
            }
            s = s.push(xor)
        } else {
            // 90% : pure noise (no coupling)
            st = (st * 1103515245 + 12345) % 2147483648
            let q2 = (st / 1000) % 10
            if q2 < 5 { s = s.push(0.0) } else { s = s.push(1.0) }
        }
        i = i + 1
    }
    return s
}

// density helper
fn density(sig: array) -> float {
    let mut sm = 0.0
    let mut i = 0
    while i < sig.len() {
        if sig[i] >= 0.5 { sm = sm + 1.0 }
        i = i + 1
    }
    return sm / (sig.len() as float)
}

// ── pre-registered falsifier evaluator ─────────────────────────────────────

fn eval_falsifier(label: string, cond: bool, detail: string) -> int {
    if cond {
        println("  " + label + " PASS — " + detail)
        return 1
    } else {
        println("  " + label + " FAIL — " + detail)
        return 0
    }
}

fn main() {
    println("================================================================")
    println("  SPATIAL S1 — spatial-coupling-scale × invariant_detector")
    println("================================================================")
    println("")
    println("  detector base : XENO/detector/invariant_detector.hexa")
    println("  axis sweep    : 4 spatial-coupling-scale (local/regional/global/cosmic)")
    println("  substrate     : 4 hardcoded literal (n=128 each, seed=20260529)")
    println("  paper source  : XENO #1414 v2 (3D) + TEMPORAL H_841 (Δt 4D)")
    println("")
    println("  pre-registered falsifiers (post-tuning 0, frozen):")
    println("    F-S1-LOCAL-HIGH    : local phi > 0.3")
    println("    F-S1-REGIONAL-MID  : regional phi 0.1~0.5")
    println("    F-S1-GLOBAL-LOW    : global phi < local")
    println("    F-S1-COSMIC-LOWEST : cosmic phi < global")
    println("    F-S1-MONOTONE      : local > regional > global > cosmic")
    println("")

    let n = 128
    let seed = 20260529

    // ── 4 substrate measurement ───────────────────────────────────────────
    println("  ── substrate × invariant_detector ─────────────────────────")

    let sig_local = gen_local(n)
    let r_local = compute_invariant_phi(sig_local, n)
    let d_local = density(sig_local)
    println("    (a) local      density=" + str(d_local) +
            " phi=" + str(r_local["phi"]) +
            " irr=" + str(r_local["irreducibility"]) +
            " type=" + r_local["substrate_type"])

    let sig_regional = gen_regional(n, seed)
    let r_regional = compute_invariant_phi(sig_regional, n)
    let d_regional = density(sig_regional)
    println("    (b) regional   density=" + str(d_regional) +
            " phi=" + str(r_regional["phi"]) +
            " irr=" + str(r_regional["irreducibility"]) +
            " type=" + r_regional["substrate_type"])

    let sig_global = gen_global(n, seed + 1)
    let r_global = compute_invariant_phi(sig_global, n)
    let d_global = density(sig_global)
    println("    (c) global     density=" + str(d_global) +
            " phi=" + str(r_global["phi"]) +
            " irr=" + str(r_global["irreducibility"]) +
            " type=" + r_global["substrate_type"])

    let sig_cosmic = gen_cosmic(n, seed + 2)
    let r_cosmic = compute_invariant_phi(sig_cosmic, n)
    let d_cosmic = density(sig_cosmic)
    println("    (d) cosmic     density=" + str(d_cosmic) +
            " phi=" + str(r_cosmic["phi"]) +
            " irr=" + str(r_cosmic["irreducibility"]) +
            " type=" + r_cosmic["substrate_type"])
    println("")

    // ── 5 사전등록 falsifier 평가 ─────────────────────────────────────────
    println("  ── 5 pre-registered falsifiers ────────────────────────────")
    let phi_local = r_local["phi"]
    let phi_regional = r_regional["phi"]
    let phi_global = r_global["phi"]
    let phi_cosmic = r_cosmic["phi"]

    let mut pass = 0
    pass = pass + eval_falsifier(
        "F-S1-LOCAL-HIGH    ",
        phi_local > 0.3,
        "phi_local=" + str(phi_local) + " > 0.3"
    )
    pass = pass + eval_falsifier(
        "F-S1-REGIONAL-MID  ",
        phi_regional >= 0.1 && phi_regional <= 0.5,
        "phi_regional=" + str(phi_regional) + " in [0.1, 0.5]"
    )
    pass = pass + eval_falsifier(
        "F-S1-GLOBAL-LOW    ",
        phi_global < phi_local,
        "phi_global=" + str(phi_global) + " < phi_local=" + str(phi_local)
    )
    pass = pass + eval_falsifier(
        "F-S1-COSMIC-LOWEST ",
        phi_cosmic < phi_global,
        "phi_cosmic=" + str(phi_cosmic) + " < phi_global=" + str(phi_global)
    )
    pass = pass + eval_falsifier(
        "F-S1-MONOTONE      ",
        phi_local > phi_regional && phi_regional > phi_global && phi_global > phi_cosmic,
        "monotone local > regional > global > cosmic"
    )

    println("")
    println("  ── verdict ───────────────────────────────────────────────")
    println("    pass_count = " + str(pass) + "/5")
    let mut verdict = "🔴 FALSIFIED-INSTRUMENT"
    if pass >= 4 {
        verdict = "🟢 SUPPORTED-NUMERICAL"
    } else {
        if pass == 3 { verdict = "🟡 PARTIAL-SUPPORT" }
    }
    println("    verdict    = " + verdict)
    println("")
    println("================================================================")
}
