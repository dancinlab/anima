// BRIDGE/gate_smoke.hexa — 7-invariant smoke
// anchor: BRIDGE/spec.md §7 (bench #7 H_319 정합)

import "BRIDGE/gate.hexa"

fn abs_f(x: float) -> float {
    return if x < 0.0 { -x } else { x }
}

fn assert_close(name: string, got: float, want: float, tol: float) -> bool {
    let d = abs_f(got - want)
    let ok = d <= tol
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want) + " |Δ|=" + str(d))
    return ok
}

fn assert_bool(name: string, got: bool, want: bool) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn main() {
    print("=== BRIDGE gate smoke (7 invariants) ===")
    let mut npass = 0
    let mut ntotal = 0

    // I1: uniform M=C=W=Φ=0.5 → AND ≈ 0.0625 (bench #7)
    //     softstep(0.5, 0.5) = 1/(1+e^0) = 0.5
    //     AND = 0.5 * 0.5 * 0.5 * 0.5 = 0.0625
    ntotal = ntotal + 1
    if assert_close("I1 uniform_AND", bridge_and_gate(0.5, 0.5, 0.5, 0.5), 0.0625, 1e-2) {
        npass = npass + 1
    }

    // I2: uniform OR ≈ 0.9375 (bench #7 antithesis)
    //     OR = 1 - (1-0.5)^4 = 1 - 0.0625 = 0.9375
    ntotal = ntotal + 1
    if assert_close("I2 uniform_OR", bridge_or_gate(0.5, 0.5, 0.5, 0.5), 0.9375, 1e-2) {
        npass = npass + 1
    }

    // I3: monotone — M↑ → AND↑ (strict)
    let a1 = bridge_and_gate(0.3, 0.5, 0.5, 0.5)
    let a2 = bridge_and_gate(0.7, 0.5, 0.5, 0.5)
    ntotal = ntotal + 1
    if assert_bool("I3 monotone_M", a2 > a1, true) {
        npass = npass + 1
    }

    // I4: AND ≤ min(M, C, W, Φ_step)
    let m = 0.9; let c = 0.6; let w = 0.4; let phi = 0.7
    let phi_step = softstep(phi, 0.5)
    let and_val = bridge_and_gate(m, c, w, phi)
    let mn = min4(m, c, w, phi_step)
    ntotal = ntotal + 1
    if assert_bool("I4 AND<=min", and_val <= mn, true) {
        npass = npass + 1
    }

    // I5: OR ≥ max(M, C, W, Φ_step)
    let or_val = bridge_or_gate(m, c, w, phi)
    let mx = max4(m, c, w, phi_step)
    ntotal = ntotal + 1
    if assert_bool("I5 OR>=max", or_val >= mx, true) {
        npass = npass + 1
    }

    // I6: Φ=0 edge → AND ≈ 0 (softstep(0, 0.5) ≈ 1/(1+e^4) ≈ 0.018)
    //     AND = 0.5 * 0.5 * 0.5 * 0.018 ≈ 0.00225
    let and_phi0 = bridge_and_gate(0.5, 0.5, 0.5, 0.0)
    ntotal = ntotal + 1
    if assert_close("I6 phi_zero_AND", and_phi0, 0.00225, 5e-3) {
        npass = npass + 1
    }

    // I7: any key=0 → AND = 0 (multiplicative)
    let and_m0 = bridge_and_gate(0.0, 0.9, 0.9, 0.9)
    let and_c0 = bridge_and_gate(0.9, 0.0, 0.9, 0.9)
    let and_w0 = bridge_and_gate(0.9, 0.9, 0.0, 0.9)
    ntotal = ntotal + 1
    let all_zero = (and_m0 == 0.0) && (and_c0 == 0.0) && (and_w0 == 0.0)
    if assert_bool("I7 key_zero_AND=0", all_zero, true) {
        npass = npass + 1
    }

    print("=== smoke result: " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
