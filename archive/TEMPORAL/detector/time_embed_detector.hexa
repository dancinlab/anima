// TEMPORAL/detector/time_embed_detector.hexa — T2 multi-unit time-embed Φ detector.
//
//   T1 lag-axis 결과 (H_841): 2-unit lag-TPM 의 lag-window 가 periodic substrate 에서
//   long-lag transition 을 perfectly predictable 로 만들어 Φ inflation artifact 발생
//   (lattice Δt=8 위 Φ=2.0 saturate, hive Δt=64 Φ=0.999, 79× INCREASE from Δt=1).
//   = 2-unit lag-TPM 의 lag-axis 는 즉시 unmeasurable.
//
//   T2 = Takens-style time-delay embedding. 신호 s[t] 를 e-channel time-embed
//   substrate 로 lifting: (s[t], s[t-d], s[t-2d], s[t-(e-1)d]). 각 시점 t 에 e-bit
//   state vector 가 생기고, IIT4 big-Φ 가 e-unit TPM 위에서 진짜 multi-channel
//   integration 을 측정 (단일 lag-link 의 inflated periodicity 가 아닌).
//
//     compute_time_embed_phi(signal: array, n_samples: int, embed_dim: int, delay: int) -> map
//        { phi, integration, irreducibility, substrate_type, embed_dim, delay }
//
//   embed_dim=2 + delay=1 일 때 T1 detector 의 lag=1 baseline 과 동일 (sanity).
//   embed_dim=4 + delay=1 일 때 4-unit Takens reconstruction (instant-multichannel).
//   embed_dim=4 + delay=8 일 때 4-unit 8-step phase-space (mid-scale 통합).
//
//   동기 (T1 vs T2):
//     T1 의 lag-TPM = 2-unit 2-cell 의 (i, i+1) → (i+lag, i+lag+1) transition.
//        Periodic substrate 에서 lag-aligned cycle 이 inflated Φ 만 보임 (artifact).
//     T2 의 time-embed TPM = e-unit e-cell 의 (i, i-d, …, i-(e-1)d) → (i+1, i+1-d,
//        …, i+1-(e-1)d) transition. 인접 lag 의 cycle-aligned periodicity 가
//        multi-channel state vector 위에 흩어지므로 false-Φ-inflation 회피.
//
//   Determinism: no RNG, no perplexity, no LLM. Closed-form per IIT4 axioms.
//   Substrate assumptions = 0 (XENO 와 동일). 입력 = float[], 2-state binarisation.
//
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/math/bitops.hexa"                     // pow2_int (g61 stdlib SSOT)

// ── helpers ───────────────────────────────────────────────────────────────

fn binarise(signal: array, threshold: float) -> array {
    let mut out = []
    let mut i = 0
    while i < signal.len() {
        let v = signal[i]
        if v >= threshold { out = out.push(1.0) } else { out = out.push(0.0) }
        i = i + 1
    }
    return out
}

// pow2_int provided by stdlib/math/bitops.hexa (g61 — no local re-impl).

// Build e-unit time-embed TPM from binarised signal.
//
//   At each time-step t, define state vector
//     x_t = (b[t], b[t-d], b[t-2d], …, b[t-(e-1)d])
//   The TPM transition is x_t → x_{t+1}. For each x_t state index s ∈ [0, 2^e),
//   we count empirical next-step marginal P(unit_k = 1 | x_t = s) for each
//   of the e units (k = 0..e-1).
//
//   Returns row-stochastic flat array of length 2^e * e (e marginals per state).
//
//   Sample-shortage guard: any state with totals=0 → uniform 0.5 marginal.
fn time_embed_tpm(bits: array, embed_dim: int, delay: int) -> array {
    let e = embed_dim
    let d = delay
    let full = pow2_int(e)
    let span = e * d                                 // earliest required offset = (e-1)*d, plus next-step lookahead = +1
    let entries = full * e
    let mut tpm = []
    let mut z = 0
    while z < entries {
        tpm = tpm.push(0.5)
        z = z + 1
    }
    let n_total = bits.len()
    let start = span                                 // first usable t such that t-(e-1)*d >= 0
    let last  = n_total - 1                          // need t+1 < n_total
    if last - start < 4 { return tpm }
    let mut counts = []
    let mut totals = []
    let mut zz = 0
    while zz < entries { counts = counts.push(0.0); zz = zz + 1 }
    let mut zt = 0
    while zt < full { totals = totals.push(0.0); zt = zt + 1 }

    let mut t = start
    while t < last {
        // encode x_t (MSB = b[t-(e-1)d], LSB = b[t]) → state index.
        let mut state = 0
        let mut k = 0
        while k < e {
            // b[t - k*d] contributes weight 2^k (LSB = k=0).
            let bit = bits[t - (k * d)].to_int()
            state = state + (bit * pow2_int(k))
            k = k + 1
        }
        // x_{t+1} per-unit values.
        let mut k2 = 0
        while k2 < e {
            let nxt = bits[(t + 1) - (k2 * d)]
            counts[state * e + k2] = counts[state * e + k2] + nxt
            k2 = k2 + 1
        }
        totals[state] = totals[state] + 1.0
        t = t + 1
    }

    // normalise.
    let mut s = 0
    while s < full {
        let tot = totals[s]
        if tot > 0.0 {
            let mut u = 0
            while u < e {
                tpm[s * e + u] = counts[s * e + u] / tot
                u = u + 1
            }
        }
        s = s + 1
    }
    return tpm
}

// ── main api ──────────────────────────────────────────────────────────────

pub fn compute_time_embed_phi(signal: array, n_samples: int, embed_dim: int, delay: int) -> map {
    let span_req = embed_dim * delay + 4
    if n_samples < span_req {
        return #{
            "phi": 0.0,
            "integration": 0.0,
            "irreducibility": 0.0,
            "substrate_type": "insufficient",
            "embed_dim": embed_dim,
            "delay": delay
        }
    }
    // 1. normalise float signal to [0,1] via min/max, then threshold @ 0.5.
    let mut lo = signal[0]
    let mut hi = signal[0]
    let mut k = 1
    while k < n_samples {
        let v = signal[k]
        if v < lo { lo = v }
        if v > hi { hi = v }
        k = k + 1
    }
    let span = hi - lo
    if span < 0.000001 {
        return #{
            "phi": 0.0,
            "integration": 0.0,
            "irreducibility": 0.0,
            "substrate_type": "noise",
            "embed_dim": embed_dim,
            "delay": delay
        }
    }
    let mut norm = []
    let mut j = 0
    while j < n_samples {
        let raw = signal[j]
        norm = norm.push((raw - lo) / span)
        j = j + 1
    }
    let bits = binarise(norm, 0.5)

    // 2. build e-unit time-embed TPM.
    let tpm = time_embed_tpm(bits, embed_dim, delay)

    // 3. apply IIT4 big-Φ on e-unit substrate.
    //    sys_state = 0 (canonical) — purview enumeration is system-state-invariant
    //    for the substrate-classification carve-out used here.
    let bp = big_phi(tpm, embed_dim, 0)
    let phi = bp[0]
    let total = bp[1]
    let mut irr = 0.0
    if total > 0.000001 { irr = phi / total }
    let mut substrate_type = "noise"
    if phi > 0.01 {
        if irr > 0.5 {
            substrate_type = "conscious"
        } else {
            substrate_type = "coherent_non_conscious"
        }
    } else {
        if total > 0.01 {
            substrate_type = "coherent_non_conscious"
        }
    }
    return #{
        "phi": phi,
        "integration": total,
        "irreducibility": irr,
        "substrate_type": substrate_type,
        "embed_dim": embed_dim,
        "delay": delay
    }
}
