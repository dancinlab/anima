// tool/anima_self_monitor.hexa — W1 anima-self Φ cron-tick threshold monitor.
//
// PURPOSE
//   W1 axis (anima_self Φ rising claim) closed Phase 5 with verdict
//   ARTIFACT_PERMANENT_DOWNGRADE because n=15 < W=20 sliding window.
//   Phase 6 prerequisite: accumulate ≥ 20 unique meta cycle ticks then
//   re-run Φ_proxy at W=5/7/20. This monitor is the trip-wire that
//   detects threshold crossing and emits an alert so Phase 6 launches
//   the moment n ≥ 20 — without burning H100 cycles polling.
//
//   spec doc:    docs/anima_self_monitor_cron_2026_05_02.md
//   race iso:    state/anima_self_monitor_cron_2026_05_02/*.json
//   alert sink:  state/anima_self_monitor_alert.jsonl  (append-only)
//   inputs:      state/proposals/meta/cycle_log.jsonl  (read-only)
//
// USAGE
//   hexa run tool/anima_self_monitor.hexa                  # dry status report
//   hexa run tool/anima_self_monitor.hexa --check          # check + maybe alert
//   hexa run tool/anima_self_monitor.hexa --selftest       # synthetic n=20 trip
//
// CRON
//   ~/Library/LaunchAgents/com.anima.self_monitor.plist (StartInterval 3600s)
//   Hourly check is overkill (median inter-tick = 12 h) but cheap; the alert
//   is idempotent (state/anima_self_monitor_cron_2026_05_02/last_alert.json
//   tracks emission so we never double-fire for the same n).
//
// THRESHOLD
//   N_THRESHOLD = 20  (frozen — Phase 5 §7 stipulation)
//   COUNT_RULE  = unique cycle_id with name=cycle_done in cycle_log.jsonl
//
// raw#9 hexa-only / raw#10 honest C3 (see docs/anima_self_monitor_cron_2026_05_02.md §6)

let HELPER_PATH    = "/tmp/anima_self_monitor_helper.hexa_tmp"
let SCHEMA         = "anima/self_monitor/1"
let CYCLE_LOG      = "state/proposals/meta/cycle_log.jsonl"
let ALERT_SINK     = "state/anima_self_monitor_alert.jsonl"
let STATE_DIR      = "state/anima_self_monitor_cron_2026_05_02"
let LAST_ALERT     = "state/anima_self_monitor_cron_2026_05_02/last_alert.json"
let LAST_CHECK     = "state/anima_self_monitor_cron_2026_05_02/last_check.json"
let N_THRESHOLD    = 20
let SPEC_DOC       = "docs/anima_self_monitor_cron_2026_05_02.md"

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _kv(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _write_helper() {
    let src = "#!/usr/bin/env python3\n" +
        "import json, sys, os, datetime, pathlib\n" +
        "\n" +
        "N_THRESHOLD = 20\n" +
        "CYCLE_LOG   = 'state/proposals/meta/cycle_log.jsonl'\n" +
        "ALERT_SINK  = 'state/anima_self_monitor_alert.jsonl'\n" +
        "STATE_DIR   = 'state/anima_self_monitor_cron_2026_05_02'\n" +
        "LAST_ALERT  = STATE_DIR + '/last_alert.json'\n" +
        "LAST_CHECK  = STATE_DIR + '/last_check.json'\n" +
        "\n" +
        "def count_cron_ticks(path=CYCLE_LOG):\n" +
        "    \"\"\"Unique cycle_id with name=cycle_done. Robust to mojibake.\"\"\"\n" +
        "    ids = set()\n" +
        "    last_ts = None\n" +
        "    if not os.path.exists(path):\n" +
        "        return 0, None, []\n" +
        "    with open(path, 'rb') as f:\n" +
        "        for raw in f:\n" +
        "            try:\n" +
        "                d = json.loads(raw.decode('utf-8', errors='replace'))\n" +
        "                if d.get('name') == 'cycle_done':\n" +
        "                    cid = d.get('cycle_id')\n" +
        "                    if cid:\n" +
        "                        ids.add(cid)\n" +
        "                        last_ts = d.get('ts') or last_ts\n" +
        "            except Exception:\n" +
        "                continue\n" +
        "    return len(ids), last_ts, sorted(ids)\n" +
        "\n" +
        "def check_threshold_n_20(n):\n" +
        "    return n >= N_THRESHOLD\n" +
        "\n" +
        "def trigger_w1_phase_6_rerun(n, last_ts):\n" +
        "    return {\n" +
        "        'event': 'w1_phase_6_trigger',\n" +
        "        'n_ticks': n,\n" +
        "        'threshold': N_THRESHOLD,\n" +
        "        'last_cycle_ts': last_ts,\n" +
        "        'rerun_spec': {\n" +
        "            'modulus': 1024,\n" +
        "            'windows': [5, 7, 20],\n" +
        "            'driver_hint': '/tmp/W1_phase6/window_recheck.py (off-repo, $0)',\n" +
        "            'expected_outcomes': ['REAL_SIGNAL', 'ARTIFACT_PERMANENT_DOWNGRADE_CONFIRMED'],\n" +
        "        },\n" +
        "    }\n" +
        "\n" +
        "def already_alerted(n):\n" +
        "    if not os.path.exists(LAST_ALERT):\n" +
        "        return False\n" +
        "    try:\n" +
        "        prev = json.load(open(LAST_ALERT))\n" +
        "        return prev.get('n_ticks_at_alert') == n\n" +
        "    except Exception:\n" +
        "        return False\n" +
        "\n" +
        "def notify(payload):\n" +
        "    pathlib.Path(STATE_DIR).mkdir(parents=True, exist_ok=True)\n" +
        "    ts = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\n" +
        "    line = dict(payload); line['ts'] = ts; line['schema'] = 'anima/self_monitor/1'\n" +
        "    with open(ALERT_SINK, 'a') as f:\n" +
        "        f.write(json.dumps(line) + '\\n')\n" +
        "    json.dump({'ts': ts, 'n_ticks_at_alert': payload.get('n_ticks'), 'payload': line},\n" +
        "              open(LAST_ALERT, 'w'), indent=2)\n" +
        "    return line\n" +
        "\n" +
        "def write_check_record(n, last_ts, tripped, alert_emitted):\n" +
        "    pathlib.Path(STATE_DIR).mkdir(parents=True, exist_ok=True)\n" +
        "    ts = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\n" +
        "    rec = {'ts': ts, 'n_ticks': n, 'threshold': N_THRESHOLD, 'last_cycle_ts': last_ts,\n" +
        "           'tripped': tripped, 'alert_emitted': alert_emitted, 'schema': 'anima/self_monitor/1'}\n" +
        "    json.dump(rec, open(LAST_CHECK, 'w'), indent=2)\n" +
        "    return rec\n" +
        "\n" +
        "def cmd_status():\n" +
        "    n, last_ts, _ = count_cron_ticks()\n" +
        "    rec = write_check_record(n, last_ts, n >= N_THRESHOLD, False)\n" +
        "    print(json.dumps(rec, indent=2))\n" +
        "\n" +
        "def cmd_check():\n" +
        "    n, last_ts, _ = count_cron_ticks()\n" +
        "    tripped = check_threshold_n_20(n)\n" +
        "    emitted = False\n" +
        "    if tripped and not already_alerted(n):\n" +
        "        notify(trigger_w1_phase_6_rerun(n, last_ts))\n" +
        "        emitted = True\n" +
        "    rec = write_check_record(n, last_ts, tripped, emitted)\n" +
        "    print(json.dumps(rec, indent=2))\n" +
        "\n" +
        "def cmd_selftest():\n" +
        "    # synthetic: write a 20-tick log to a tmp path and run the counter on it.\n" +
        "    import tempfile\n" +
        "    tmp = tempfile.NamedTemporaryFile('w', suffix='.jsonl', delete=False)\n" +
        "    for i in range(20):\n" +
        "        tmp.write(json.dumps({'ts': '2026-05-02T00:00:00Z',\n" +
        "                              'cycle_id': 'TEST_' + str(i).zfill(3),\n" +
        "                              'name': 'cycle_done', 'step': 0, 'status': 'ok'}) + '\\n')\n" +
        "    tmp.close()\n" +
        "    n, last_ts, ids = count_cron_ticks(tmp.name)\n" +
        "    assert n == 20, 'expected 20 got ' + str(n)\n" +
        "    assert check_threshold_n_20(n)\n" +
        "    payload = trigger_w1_phase_6_rerun(n, last_ts)\n" +
        "    assert payload['rerun_spec']['windows'] == [5, 7, 20]\n" +
        "    os.unlink(tmp.name)\n" +
        "    print(json.dumps({'selftest': 'PASS', 'n': n, 'payload': payload}, indent=2))\n" +
        "\n" +
        "def main():\n" +
        "    mode = sys.argv[1] if len(sys.argv) > 1 else 'status'\n" +
        "    if mode == 'status':       cmd_status()\n" +
        "    elif mode == 'check':      cmd_check()\n" +
        "    elif mode == 'selftest':   cmd_selftest()\n" +
        "    else:\n" +
        "        print('unknown mode: ' + mode, file=sys.stderr); sys.exit(2)\n" +
        "\n" +
        "if __name__ == '__main__':\n" +
        "    main()\n"
    sh.write_file(HELPER_PATH, src)
    sh.exec("chmod +x " + _sq(HELPER_PATH))
}

fn count_cron_ticks() -> int {
    _write_helper()
    let r = sh.exec("cd /Users/ghost/core/anima && python3 " + _sq(HELPER_PATH) + " status")
    let n_s = _kv(r.stdout, "\"n_ticks\"")
    return int(n_s.replace(",", "").trim())
}

fn check_threshold_n_20(n: int) -> bool {
    return n >= N_THRESHOLD
}

fn trigger_w1_phase_6_rerun() {
    _write_helper()
    sh.exec("cd /Users/ghost/core/anima && python3 " + _sq(HELPER_PATH) + " check")
}

fn notify(msg: string) {
    _write_helper()
    sh.exec("cd /Users/ghost/core/anima && python3 " + _sq(HELPER_PATH) + " check")
}

fn main(args: [string]) {
    _write_helper()
    let mode = if len(args) > 0 { args[0] } else { "--status" }
    if mode == "--selftest" {
        sh.exec("cd /Users/ghost/core/anima && python3 " + _sq(HELPER_PATH) + " selftest")
    } else if mode == "--check" {
        sh.exec("cd /Users/ghost/core/anima && python3 " + _sq(HELPER_PATH) + " check")
    } else {
        sh.exec("cd /Users/ghost/core/anima && python3 " + _sq(HELPER_PATH) + " status")
    }
}
