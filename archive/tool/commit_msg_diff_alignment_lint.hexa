// ════════════════════════════════════════════════════════════════════════════
//  anima/tool/commit_msg_diff_alignment_lint.hexa  (v3, anima-canonical copy)
//
//  PURPOSE
//    Audit commit-message subject ↔ diff top-N file alignment.
//    Detects silent attribution drift where a commit msg subject scope
//    (e.g. "fix(an11-fire18): Mode H ...") is unrelated to the actual
//    top-LoC file in the diff (e.g. clm_eeg_lz76_real.hexa +568).
//
//    LINEAGE
//    --------
//    v1  anima-eeg/tool/commit_msg_diff_alignment_lint.hexa  (2026-04-28 a8e5c7a2)
//    v2  +vendor-path filter (§4.1) +body-token fallback (§4.5)  (anima-eeg copy)
//    v3  THIS FILE — anima-canonical copy
//        +§4.6 batch-refactor detector (identical added==deleted, ≥2 files)
//        +§4.7 own-type EXEMPT (hive/own canonical system commits)
//        +§4.8 rfc-NNN scope body-keyword rescue (bool|coercion|coerce|refactor)
//
//    Reasoning: anima-eeg/tool/ copy is preserved as historical reference
//    (raw#1 immutability of landed lint).  This anima/tool/ copy is the
//    forward-going canonical lint per task contract "anima/tool/ ... or similar".
//
//  USAGE
//    hexa run anima/tool/commit_msg_diff_alignment_lint.hexa --selftest
//    hexa run anima/tool/commit_msg_diff_alignment_lint.hexa --audit-sha <sha>
//    hexa run anima/tool/commit_msg_diff_alignment_lint.hexa --audit-recent 100
//
//  COMPLIANCE
//    raw#1 immutability · raw#9 pure-hexa · raw#10 honest C3 · raw#12 frozen ·
//    raw#37 transient .py helper · raw#65 idempotent · raw#71 ≥6 falsifiers ·
//    raw#85 commit-landing audit · raw#91 high-variance ·
//    raw#159 hexa-lang RFC candidate (deferred) · own#4 root-cause-only
// ════════════════════════════════════════════════════════════════════════════

let HELPER_PATH = "/tmp/anima_commit_msg_diff_alignment_helper_v3.py"
let LINT_VERSION = "v3"
let DEFAULT_AUDIT_OUT = "/tmp/anima_commit_msg_drift_audit.md"
let PY3 = "/usr/bin/python3"

fn _emit_helper() -> string {
    let lines = [
        "#!/usr/bin/env python3",
        "# commit_msg_diff_alignment_helper_v3.py — raw#37 transient",
        "import os, re, sys, json, subprocess, datetime",
        "",
        "REPO = os.environ.get('ANIMA_REPO', '/Users/ghost/core/anima')",
        "STOPWORDS = {'a','an','v1','v2','v3','fix','the','and','or'}",
        "# §4.7 v3: 'own' added — hive/own canonical system commits exempt",
        "EXEMPT_TYPES = {'release','merge','own'}",
        "DOC_TYPES    = {'docs'}",
        "TYPE_RX  = re.compile(r'^([a-zA-Z][a-zA-Z0-9_-]*)\\(([^)]+)\\)\\s*[:!]')",
        "NOSCOPE_TYPE_RX = re.compile(r'^([a-zA-Z][a-zA-Z0-9_-]*)\\s*[:!]')",
        "SPLIT_RX = re.compile(r'[-_/+\\s]+')",
        "VENDOR_PREFIXES = (",
        "    '.venv-eeg/', '.venv/', '.venv-', '.hxc_aot/',",
        "    'node_modules/', 'references/', '.git/', 'dist/',",
        "    'vendor/', '__pycache__/',",
        ")",
        "BODY_STOPWORDS = STOPWORDS | {",
        "    'feat','fix','docs','ops','chore','refactor','witness','test','perf',",
        "    'with','for','from','into','via','using','that','this','only','also',",
        "    'pure','real','full','live','first','final','step','run','runs',",
        "    'pass','fail','warn','mode','seed','seeds','rate','rates',",
        "}",
        "# §4.8 v3: rfc-NNN batch-refactor body keywords — if scope is rfc-NNN-...",
        "# and body contains any of these tokens, rescue as PASS_BATCH.",
        "RFC_BATCH_KEYWORDS = {'bool','coercion','coerce','refactor','rename'}",
        "RFC_SCOPE_RX = re.compile(r'^rfc[-_]?\\d{3}([-_].*)?$')",
        "",
        "def git(*args):",
        "    r = subprocess.run(['git','-C',REPO]+list(args), capture_output=True, text=True)",
        "    return r.stdout",
        "",
        "def parse_subject(sha):",
        "    s = git('log','-1','--format=%s', sha).strip()",
        "    return s[:70]",
        "",
        "def extract_scope(subject):",
        "    m = TYPE_RX.match(subject)",
        "    if m:",
        "        return ('scoped', m.group(1).lower(), m.group(2).lower())",
        "    m2 = NOSCOPE_TYPE_RX.match(subject)",
        "    if m2:",
        "        return ('typed_no_scope', m2.group(1).lower(), '')",
        "    return ('no_match', '', '')",
        "",
        "def tokens(scope):",
        "    raw = SPLIT_RX.split(scope)",
        "    return [t for t in raw if t and t not in STOPWORDS]",
        "",
        "def _is_vendor_path(p):",
        "    pl = p.lower()",
        "    for v in VENDOR_PREFIXES:",
        "        if pl.startswith(v): return True",
        "    return False",
        "",
        "def diff_numstat(sha, include_vendor=False):",
        "    out = git('show','--numstat','--format=', sha)",
        "    rows = []",
        "    for ln in out.strip().split('\\n'):",
        "        ln = ln.strip()",
        "        if not ln: continue",
        "        parts = ln.split('\\t')",
        "        if len(parts) < 3: continue",
        "        a, d, p = parts[0], parts[1], parts[2]",
        "        try:",
        "            ai = 0 if a=='-' else int(a)",
        "            di = 0 if d=='-' else int(d)",
        "        except:",
        "            ai, di = 0, 0",
        "        rows.append((ai, di, p))",
        "    if not include_vendor:",
        "        rows = [r for r in rows if not _is_vendor_path(r[2])]",
        "    return rows",
        "",
        "def diff_top_files(sha, n=3, include_vendor=False):",
        "    rows = diff_numstat(sha, include_vendor=include_vendor)",
        "    ranked = sorted([(a+d, p) for (a,d,p) in rows], reverse=True)",
        "    return ranked[:n]",
        "",
        "def keyword_in_path(kw, path):",
        "    return kw in path.lower()",
        "",
        "def body_tokens(subject):",
        "    body = subject",
        "    if ':' in subject:",
        "        body = subject.split(':',1)[1]",
        "    raw = re.split(r'[\\s\\-_/+()\\[\\]]+', body.lower())",
        "    return [t for t in raw if len(t) > 3 and t not in BODY_STOPWORDS]",
        "",
        "def body_token_set_full(sha):",
        "    # Full subject + body for §4.8 keyword rescue",
        "    s = git('log','-1','--format=%s%n%b', sha).lower()",
        "    return set(re.split(r'[\\s\\-_/+()\\[\\]:.,;]+', s))",
        "",
        "def is_batch_refactor(rows):",
        "    # §4.6 v3: detect token-only batch refactor.",
        "    # Signature: ≥2 non-vendor files, every file has added == deleted",
        "    # (and added > 0). LoC delta sums to zero — pure rename/coerce/bool flip.",
        "    if len(rows) < 2: return False",
        "    for (a,d,p) in rows:",
        "        if a == 0 or a != d:",
        "            return False",
        "    return True",
        "",
        "def is_rfc_batch(scope, sha):",
        "    # §4.8 v3: scope matches rfc-NNN-* and body contains a refactor keyword.",
        "    if not RFC_SCOPE_RX.match(scope or ''): return False",
        "    bts = body_token_set_full(sha)",
        "    return bool(bts & RFC_BATCH_KEYWORDS)",
        "",
        "def classify(sha):",
        "    subj = parse_subject(sha)",
        "    kind, ctype, scope = extract_scope(subj)",
        "    rows_raw = diff_numstat(sha, include_vendor=True)",
        "    rows     = diff_numstat(sha, include_vendor=False)",
        "    top_raw = sorted([(a+d,p) for (a,d,p) in rows_raw], reverse=True)[:3]",
        "    top     = sorted([(a+d,p) for (a,d,p) in rows], reverse=True)[:3]",
        "    vendor_filtered = (top_raw != top)",
        "    base = {'sha': sha[:9], 'subject': subj, 'type': ctype, 'scope': scope,",
        "            'top': top, 'top_raw': top_raw, 'vendor_filtered': vendor_filtered}",
        "    if not top:",
        "        return {**base, 'verdict': 'NO_DIFF'}",
        "    if kind == 'no_match':",
        "        return {**base, 'verdict': 'NO_SCOPE'}",
        "    if ctype in EXEMPT_TYPES:",
        "        return {**base, 'verdict': 'EXEMPT'}",
        "    if ctype in DOC_TYPES:",
        "        top1 = top[0][1].lower()",
        "        if 'docs/' in top1 or top1.endswith('.md'):",
        "            return {**base, 'verdict': 'EXEMPT'}",
        "    if kind == 'typed_no_scope':",
        "        return {**base, 'verdict': 'NO_SCOPE'}",
        "    toks = tokens(scope)",
        "    if not toks:",
        "        return {**base, 'verdict': 'NO_SCOPE'}",
        "    top1_path = top[0][1].lower()",
        "    top3_paths = [p.lower() for _,p in top]",
        "    matched_in_top1 = [t for t in toks if keyword_in_path(t, top1_path)]",
        "    matched_in_top3 = [t for t in toks if any(keyword_in_path(t, p) for p in top3_paths)]",
        "    if matched_in_top1:",
        "        v = 'PASS'",
        "    elif matched_in_top3:",
        "        v = 'WARN_LOOSE'",
        "    else:",
        "        v = 'FAIL_MISMATCH'",
        "    base['tokens'] = toks",
        "    base['matched_top1'] = matched_in_top1",
        "    base['matched_top3'] = matched_in_top3",
        "    body_match_top1 = []",
        "    body_match_top3 = []",
        "    if v == 'FAIL_MISMATCH':",
        "        btoks = body_tokens(subj)",
        "        body_match_top1 = [t for t in btoks if keyword_in_path(t, top1_path)]",
        "        body_match_top3 = [t for t in btoks if any(keyword_in_path(t, p) for p in top3_paths)]",
        "        if body_match_top1:",
        "            v = 'PASS_BODY'",
        "        elif body_match_top3:",
        "            v = 'WARN_BODY'",
        "        base['body_tokens'] = btoks",
        "        base['body_match_top1'] = body_match_top1",
        "        base['body_match_top3'] = body_match_top3",
        "    # §4.6 v3: batch-refactor rescue (after body-token attempts)",
        "    if v == 'FAIL_MISMATCH' and is_batch_refactor(rows):",
        "        v = 'PASS_REFACTOR'",
        "        base['batch_refactor_n_files'] = len(rows)",
        "    # §4.8 v3: rfc-NNN keyword rescue (last resort, before FAIL)",
        "    if v == 'FAIL_MISMATCH' and is_rfc_batch(scope, sha):",
        "        v = 'PASS_BATCH'",
        "        base['rfc_batch_keywords'] = sorted(",
        "            list(body_token_set_full(sha) & RFC_BATCH_KEYWORDS))",
        "    base['verdict'] = v",
        "    return base",
        "",
        "def cmd_audit_sha(sha):",
        "    r = classify(sha)",
        "    print(json.dumps(r, indent=2))",
        "    return r",
        "",
        "def _classify_v2_legacy(sha):",
        "    # Pre §4.6 / §4.7 / §4.8 — for delta witness",
        "    subj = parse_subject(sha)",
        "    kind, ctype, scope = extract_scope(subj)",
        "    top = diff_top_files(sha, 3, include_vendor=False)",
        "    if not top: return 'NO_DIFF'",
        "    if kind == 'no_match': return 'NO_SCOPE'",
        "    # v2: 'own' was NOT exempt",
        "    v2_exempt = {'release','merge'}",
        "    if ctype in v2_exempt: return 'EXEMPT'",
        "    if ctype in DOC_TYPES:",
        "        top1 = top[0][1].lower()",
        "        if 'docs/' in top1 or top1.endswith('.md'): return 'EXEMPT'",
        "    if kind == 'typed_no_scope': return 'NO_SCOPE'",
        "    toks = tokens(scope)",
        "    if not toks: return 'NO_SCOPE'",
        "    top1_path = top[0][1].lower()",
        "    top3_paths = [p.lower() for _,p in top]",
        "    m1 = [t for t in toks if keyword_in_path(t, top1_path)]",
        "    m3 = [t for t in toks if any(keyword_in_path(t, p) for p in top3_paths)]",
        "    if m1: return 'PASS'",
        "    if m3: return 'WARN_LOOSE'",
        "    btoks = body_tokens(subj)",
        "    bm1 = [t for t in btoks if keyword_in_path(t, top1_path)]",
        "    bm3 = [t for t in btoks if any(keyword_in_path(t, p) for p in top3_paths)]",
        "    if bm1: return 'PASS_BODY'",
        "    if bm3: return 'WARN_BODY'",
        "    return 'FAIL_MISMATCH'",
        "",
        "def cmd_audit_recent(n, out_md):",
        "    shas = git('log','-n',str(n),'--format=%H').strip().split('\\n')",
        "    results = []",
        "    counts = {'PASS':0,'PASS_BODY':0,'PASS_REFACTOR':0,'PASS_BATCH':0,",
        "              'WARN_LOOSE':0,'WARN_BODY':0,'FAIL_MISMATCH':0,",
        "              'NO_SCOPE':0,'EXEMPT':0,'NO_DIFF':0}",
        "    v2_counts = {'PASS':0,'PASS_BODY':0,'WARN_LOOSE':0,'WARN_BODY':0,",
        "                 'FAIL_MISMATCH':0,'NO_SCOPE':0,'EXEMPT':0,'NO_DIFF':0}",
        "    for s in shas:",
        "        if not s.strip(): continue",
        "        r = classify(s.strip())",
        "        results.append(r)",
        "        counts[r['verdict']] = counts.get(r['verdict'],0)+1",
        "        v2v = _classify_v2_legacy(s.strip())",
        "        v2_counts[v2v] = v2_counts.get(v2v,0)+1",
        "    total = sum(counts.values())",
        "    eligible = total - counts['EXEMPT'] - counts['NO_SCOPE'] - counts['NO_DIFF']",
        "    fail = counts['FAIL_MISMATCH']",
        "    warn = counts['WARN_LOOSE'] + counts['WARN_BODY']",
        "    pass_total = (counts['PASS'] + counts['PASS_BODY'] +",
        "                  counts['PASS_REFACTOR'] + counts['PASS_BATCH'])",
        "    rate_fail = (fail/eligible*100.0) if eligible>0 else 0.0",
        "    rate_warn = (warn/eligible*100.0) if eligible>0 else 0.0",
        "    v2_eligible = sum(v2_counts.values()) - v2_counts['EXEMPT'] - v2_counts['NO_SCOPE'] - v2_counts['NO_DIFF']",
        "    v2_fail = v2_counts['FAIL_MISMATCH']",
        "    v2_rate = (v2_fail/v2_eligible*100.0) if v2_eligible>0 else 0.0",
        "    delta = v2_rate - rate_fail",
        "    lines = []",
        "    lines.append('# anima commit-msg ↔ diff alignment audit (v3: refactor + own-exempt + rfc-batch)')",
        "    lines.append('')",
        "    lines.append('- ts: '+datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ'))",
        "    lines.append('- repo: '+REPO)",
        "    lines.append('- lint_version: v3 (vendor_filter + body_token_fallback + batch_refactor + own_exempt + rfc_batch)')",
        "    lines.append('- audited: '+str(total)+' commits')",
        "    lines.append('- eligible (excl exempt/no-scope/no-diff): '+str(eligible))",
        "    lines.append('- PASS:           '+str(counts['PASS']))",
        "    lines.append('- PASS_BODY:      '+str(counts['PASS_BODY'])+'  (v2 body-token rescue)')",
        "    lines.append('- PASS_REFACTOR:  '+str(counts['PASS_REFACTOR'])+'  (v3 §4.6 batch refactor)')",
        "    lines.append('- PASS_BATCH:     '+str(counts['PASS_BATCH'])+'  (v3 §4.8 rfc-NNN body keyword)')",
        "    lines.append('- WARN_LOOSE:     '+str(counts['WARN_LOOSE']))",
        "    lines.append('- WARN_BODY:      '+str(counts['WARN_BODY']))",
        "    lines.append('- FAIL_MISMATCH:  '+str(counts['FAIL_MISMATCH']))",
        "    lines.append('- NO_SCOPE:       '+str(counts['NO_SCOPE']))",
        "    lines.append('- EXEMPT:         '+str(counts['EXEMPT'])+'  (v3: includes own-type)')",
        "    lines.append('- NO_DIFF:        '+str(counts['NO_DIFF']))",
        "    lines.append('- mismatch_rate:  %.2f%% (%d/%d eligible)' % (rate_fail, fail, eligible))",
        "    lines.append('- warn_rate:      %.2f%% (%d/%d eligible)' % (rate_warn, warn, eligible))",
        "    lines.append('')",
        "    lines.append('## v2 vs v3 delta')",
        "    lines.append('')",
        "    lines.append('- v2 (post-§4.5)  FAIL_MISMATCH: %d/%d (%.2f%%)' % (v2_fail, v2_eligible, v2_rate))",
        "    lines.append('- v3 (post-§4.8)  FAIL_MISMATCH: %d/%d (%.2f%%)' % (fail, eligible, rate_fail))",
        "    lines.append('- delta: %.2fpp reduction' % delta)",
        "    lines.append('')",
        "    lines.append('## FAIL_MISMATCH commits (v3 — true positives surviving all rescues)')",
        "    lines.append('')",
        "    for r in results:",
        "        if r['verdict']=='FAIL_MISMATCH':",
        "            top_str = ', '.join(['%s(+%d)'%(p,t) for t,p in r['top']])",
        "            lines.append('- `'+r['sha']+'` `'+r['subject']+'`')",
        "            lines.append('  - scope tokens: '+str(r.get('tokens',[])))",
        "            lines.append('  - body tokens:  '+str(r.get('body_tokens',[]))[:200])",
        "            lines.append('  - top files:    '+top_str)",
        "            if r.get('vendor_filtered'):",
        "                lines.append('  - vendor_filter: APPLIED (top_raw differed)')",
        "    lines.append('')",
        "    lines.append('## PASS_REFACTOR commits (v3 §4.6 — token-only batch refactor)')",
        "    lines.append('')",
        "    for r in results:",
        "        if r['verdict']=='PASS_REFACTOR':",
        "            lines.append('- `'+r['sha']+'` `'+r['subject']+'`  (n_files='+str(r.get('batch_refactor_n_files',0))+')')",
        "    lines.append('')",
        "    lines.append('## PASS_BATCH commits (v3 §4.8 — rfc-NNN body keyword)')",
        "    lines.append('')",
        "    for r in results:",
        "        if r['verdict']=='PASS_BATCH':",
        "            lines.append('- `'+r['sha']+'` `'+r['subject']+'`  (kw='+str(r.get('rfc_batch_keywords',[]))+')')",
        "    lines.append('')",
        "    lines.append('## PASS_BODY commits (v2 §4.5 — scope rescued by body match)')",
        "    lines.append('')",
        "    for r in results:",
        "        if r['verdict']=='PASS_BODY':",
        "            lines.append('- `'+r['sha']+'` `'+r['subject']+'`')",
        "    lines.append('')",
        "    lines.append('## WARN_LOOSE commits')",
        "    lines.append('')",
        "    for r in results:",
        "        if r['verdict']=='WARN_LOOSE':",
        "            lines.append('- `'+r['sha']+'` `'+r['subject']+'`  (matched in top-3: '+str(r.get('matched_top3',[]))+')')",
        "    with open(out_md,'w') as f:",
        "        f.write('\\n'.join(lines)+'\\n')",
        "    summary = {",
        "        'lint': 'commit_msg_diff_alignment_lint',",
        "        'version': 'v3',",
        "        'audited': total, 'eligible': eligible,",
        "        'counts': counts,",
        "        'v2_counts': v2_counts,",
        "        'v2_fail_rate_pct': v2_rate,",
        "        'mismatch_rate_pct': rate_fail,",
        "        'warn_rate_pct': rate_warn,",
        "        'delta_pp': delta,",
        "        'audit_md': out_md,",
        "    }",
        "    print(json.dumps(summary, indent=2))",
        "    return summary",
        "",
        "def cmd_selftest():",
        "    results = {}",
        "    # F1 true positive — commit 50002d89",
        "    r1 = classify('50002d89')",
        "    results['F1_50002d89_true_positive'] = r1",
        "    # F2 true negative — commit 7ea7453fa",
        "    r2 = classify('7ea7453fa')",
        "    results['F2_7ea7453fa_true_negative'] = r2",
        "    # F3 synthetic mismatch (in-memory)",
        "    fake_subj = 'fix(scope-foo): improve foo handling'",
        "    fake_top  = [(100,'bar/qux.hexa'),(50,'bar/baz.hexa')]",
        "    kind,ctype,scope = extract_scope(fake_subj)",
        "    toks = tokens(scope)",
        "    paths = [p for _,p in fake_top]",
        "    in_top1 = [t for t in toks if keyword_in_path(t, paths[0].lower())]",
        "    in_top3 = [t for t in toks if any(keyword_in_path(t, p.lower()) for p in paths)]",
        "    v3v = 'PASS' if in_top1 else ('WARN_LOOSE' if in_top3 else 'FAIL_MISMATCH')",
        "    results['F3_synth_mismatch'] = {'verdict': v3v, 'tokens': toks, 'top': fake_top}",
        "    # F4 synthetic exempt — release",
        "    s4 = 'release(anima-beta-v0.1): bla'",
        "    k4,t4,sc4 = extract_scope(s4)",
        "    v4 = 'EXEMPT' if t4 in EXEMPT_TYPES else 'NOT_EXEMPT'",
        "    results['F4_synth_release_exempt'] = {'verdict': v4, 'type': t4}",
        "    # F5 synthetic warn — scope token in top-3 only",
        "    fake_subj2 = 'fix(qux): something'",
        "    fake_top2  = [(200,'unrelated/foo.hexa'),(50,'bar/qux_helper.hexa')]",
        "    k5,t5,sc5 = extract_scope(fake_subj2)",
        "    toks2 = tokens(sc5)",
        "    paths2 = [p for _,p in fake_top2]",
        "    it1 = [t for t in toks2 if keyword_in_path(t, paths2[0].lower())]",
        "    it3 = [t for t in toks2 if any(keyword_in_path(t, p.lower()) for p in paths2)]",
        "    v5 = 'PASS' if it1 else ('WARN_LOOSE' if it3 else 'FAIL_MISMATCH')",
        "    results['F5_synth_warn'] = {'verdict': v5, 'tokens': toks2}",
        "    # F6 no-scope — 'merge: foo'",
        "    s6 = 'merge: branch x into main'",
        "    k6,t6,sc6 = extract_scope(s6)",
        "    v6 = 'EXEMPT' if t6 in EXEMPT_TYPES else ('NO_SCOPE' if k6=='typed_no_scope' else 'OTHER')",
        "    results['F6_synth_no_scope'] = {'verdict': v6, 'type': t6, 'kind': k6}",
        "    # F7 v2 vendor filter (regression guard)",
        "    f7_paths_raw = [(6202, '.venv-eeg/lib/python3.12/site-packages/numpy/__init__.pyi'),",
        "                    (50, 'anima-eeg/tool/an11_dispatch.hexa')]",
        "    f7_filtered = [(t,p) for (t,p) in f7_paths_raw if not _is_vendor_path(p)]",
        "    f7_filtered.sort(reverse=True)",
        "    f7_top1 = f7_filtered[0][1] if f7_filtered else ''",
        "    f7_ok = ('.venv' not in f7_top1) and ('an11_dispatch' in f7_top1)",
        "    results['F7_vendor_filter'] = {'top1_after_filter': f7_top1, 'ok': f7_ok}",
        "    # F8 v2 body-token fallback (regression guard)",
        "    f8_subj = 'feat(B11): behavioral_correlates_logger — 5 metrics'",
        "    f8_btoks = body_tokens(f8_subj)",
        "    f8_path = 'anima-eeg/tool/behavioral_correlates_logger.hexa'",
        "    f8_match = [t for t in f8_btoks if keyword_in_path(t, f8_path.lower())]",
        "    f8_ok = bool(f8_match)",
        "    results['F8_body_token_fallback'] = {'body_tokens': f8_btoks, 'matched': f8_match, 'ok': f8_ok}",
        "    # F9 v3 §4.6 batch-refactor detector — synthetic 4 files all +5/-5",
        "    f9_rows = [(5,5,'a/x.hexa'),(5,5,'a/y.hexa'),(5,5,'a/z.hexa'),(5,5,'b/w.hexa')]",
        "    f9_ok = is_batch_refactor(f9_rows) is True",
        "    f9_neg_rows = [(10,5,'a/x.hexa'),(5,5,'a/y.hexa')]",
        "    f9_neg_ok = is_batch_refactor(f9_neg_rows) is False",
        "    results['F9_batch_refactor'] = {'ok': f9_ok and f9_neg_ok}",
        "    # F10 v3 §4.7 own-type EXEMPT",
        "    s10 = 'own(13): user-facing-response-friendliness'",
        "    k10,t10,sc10 = extract_scope(s10)",
        "    f10_ok = t10 == 'own' and t10 in EXEMPT_TYPES",
        "    results['F10_own_exempt'] = {'type': t10, 'ok': f10_ok}",
        "    # F11 v3 §4.8 rfc-NNN keyword rescue (synthetic — checks RX + KW set)",
        "    f11_scope = 'rfc-009-batch3-t5'",
        "    f11_rx_ok = bool(RFC_SCOPE_RX.match(f11_scope))",
        "    f11_kw_ok = 'bool' in RFC_BATCH_KEYWORDS and 'coercion' in RFC_BATCH_KEYWORDS",
        "    f11_ok = f11_rx_ok and f11_kw_ok",
        "    results['F11_rfc_batch'] = {'ok': f11_ok, 'rx_ok': f11_rx_ok, 'kw_ok': f11_kw_ok}",
        "    # raw#71 falsifier: lint after refinement must NOT collapse to zero FAIL",
        "    # (would mean over-refinement). We confirm by checking known true drift",
        "    # commit ec2ae4b2f remains FAIL or WARN.",
        "    rf12 = classify('ec2ae4b2f')",
        "    f12_ok = rf12.get('verdict') in ('FAIL_MISMATCH','WARN_LOOSE','WARN_BODY')",
        "    results['F12_over_refinement_guard'] = {'ec2ae4b2f_verdict': rf12.get('verdict'),'ok': f12_ok}",
        "    f1_ok = r1.get('verdict') in ('FAIL_MISMATCH','WARN_LOOSE','PASS_REFACTOR','PASS_BATCH','PASS_BODY')",
        "    f2_ok = r2.get('verdict') == 'PASS'",
        "    f3_ok = v3v == 'FAIL_MISMATCH'",
        "    f4_ok = v4 == 'EXEMPT'",
        "    f5_ok = v5 == 'WARN_LOOSE'",
        "    f6_ok = v6 in ('EXEMPT','NO_SCOPE')",
        "    all_pass = all([f1_ok,f2_ok,f3_ok,f4_ok,f5_ok,f6_ok,f7_ok,f8_ok,f9_ok and f9_neg_ok,f10_ok,f11_ok,f12_ok])",
        "    summary = {",
        "        'selftest': 'commit_msg_diff_alignment_lint',",
        "        'version': 'v3',",
        "        'F1_true_positive_50002d89': f1_ok,",
        "        'F2_true_negative_7ea7453fa': f2_ok,",
        "        'F3_synth_mismatch': f3_ok,",
        "        'F4_synth_release_exempt': f4_ok,",
        "        'F5_synth_warn_loose': f5_ok,",
        "        'F6_synth_no_scope': f6_ok,",
        "        'F7_vendor_filter': f7_ok,",
        "        'F8_body_token_fallback': f8_ok,",
        "        'F9_batch_refactor_v3': f9_ok and f9_neg_ok,",
        "        'F10_own_exempt_v3': f10_ok,",
        "        'F11_rfc_batch_v3': f11_ok,",
        "        'F12_over_refinement_guard': f12_ok,",
        "        'all_pass': all_pass,",
        "        'detail': results,",
        "    }",
        "    print(json.dumps(summary, indent=2))",
        "    return summary",
        "",
        "def main():",
        "    args = sys.argv[1:]",
        "    if '--selftest' in args:",
        "        cmd_selftest(); return",
        "    if '--audit-sha' in args:",
        "        i = args.index('--audit-sha'); sha = args[i+1]",
        "        cmd_audit_sha(sha); return",
        "    if '--audit-recent' in args:",
        "        i = args.index('--audit-recent'); n = int(args[i+1])",
        "        out_md = '/tmp/anima_commit_msg_drift_audit.md'",
        "        if '--out' in args:",
        "            j = args.index('--out'); out_md = args[j+1]",
        "        cmd_audit_recent(n, out_md); return",
        "    print('usage: --selftest | --audit-sha <sha> | --audit-recent <N> [--out <path>]')",
        "",
        "if __name__ == '__main__': main()",
    ]
    let mut text = ""
    let mut i = 0
    while i < len(lines) {
        text = text + lines[i] + "\n"
        i = i + 1
    }
    write_file(HELPER_PATH, text)
    return HELPER_PATH
}

fn _has_flag(name: string) -> bool {
    let av = argv()
    let mut i = 0
    while i < len(av) {
        if av[i] == name { return true }
        i = i + 1
    }
    return false
}

fn _flag_value(name: string, default_val: string) -> string {
    let av = argv()
    let mut i = 0
    while i < len(av) - 1 {
        if av[i] == name { return av[i + 1] }
        i = i + 1
    }
    return default_val
}

fn main() {
    let _p = _emit_helper()
    println("__COMMIT_MSG_DIFF_ALIGN_BEGIN__ raw#9 raw#37 raw#85 v3")
    println("helper_emitted=" + HELPER_PATH)
    println("lint_version=" + LINT_VERSION)
    if _has_flag("--selftest") {
        println("mode=selftest")
        let r = exec_with_status(PY3 + " " + HELPER_PATH + " --selftest")
        println(r[0])
        if r[1] == 0 {
            println("__COMMIT_MSG_DIFF_ALIGN_RESULT__ PASS_SELFTEST")
        } else {
            println("__COMMIT_MSG_DIFF_ALIGN_RESULT__ FAIL_SELFTEST")
        }
        return 0
    }
    if _has_flag("--audit-sha") {
        let sha = _flag_value("--audit-sha", "HEAD")
        println("mode=audit-sha sha=" + sha)
        let r = exec_with_status(PY3 + " " + HELPER_PATH + " --audit-sha " + sha)
        println(r[0])
        println("__COMMIT_MSG_DIFF_ALIGN_RESULT__ AUDIT_SHA_DONE")
        return 0
    }
    if _has_flag("--audit-recent") {
        let n = _flag_value("--audit-recent", "100")
        let out = _flag_value("--out", DEFAULT_AUDIT_OUT)
        println("mode=audit-recent n=" + n + " out=" + out)
        let r = exec_with_status(PY3 + " " + HELPER_PATH + " --audit-recent " + n + " --out " + out)
        println(r[0])
        println("audit_md=" + out)
        println("__COMMIT_MSG_DIFF_ALIGN_RESULT__ AUDIT_RECENT_DONE")
        return 0
    }
    println("usage: hexa run anima/tool/commit_msg_diff_alignment_lint.hexa --selftest")
    println("       hexa run anima/tool/commit_msg_diff_alignment_lint.hexa --audit-sha <sha>")
    println("       hexa run anima/tool/commit_msg_diff_alignment_lint.hexa --audit-recent <N> [--out <path>]")
    return 0
}
