// tool/clm_v4_probe_tension.hexa — P9 P0 CLM v4 tension probe (raw#9 hexa-native).
//
// REPLACES
//   state/p9_p0_measure_2026_05_03/probe_ubu1_clm_v4_tension.py (gitignored, line 15:
//     TOKENIZER = "/tmp/tokenizer_64k_multilingual.model"  ← legacy hardcode)
//
// PURPOSE
//   N=100-record subset tension probe on CLM v4 350M ConsciousDecoderV2 + per-record
//   latency measurement -> 50K wallclock projection. Replaces /tmp tokenizer hardcode
//   with the cache-resolver pattern from tool/clm_v4_tokenizer_load.hexa.
//
// MODES
//   --selftest    Tokenizer round-trip + ConsciousDecoderV2 import dry-check on ubu1.
//                 Encodes 16 calib prompts (T=64) and emits token-sequence summary.
//                 NO GPU forward, NO ckpt load. F-MIG-1/2 evidence only.
//   --apply       Full N=100 tension probe (ckpt load + per-record forward + tension
//                 extraction + latency stats). Emits OUTPUT jsonl + LATENCY_LOG json
//                 to ubu1, scp's back to MAC_OUT_DIR.
//   (no flag)     Selftest mode (safe default — no GPU consumption).
//
// raw#9: Mac-side hexa-only. raw#37 transient helper to ubu1 (.hexa_tmp not .py).
// raw#15 SSOT this file. raw#71 falsifier-bound (F-MIG-1/2/3/4).
//
// USAGE
//   hexa_real run tool/clm_v4_probe_tension.hexa --selftest
//   hexa_real run tool/clm_v4_probe_tension.hexa --apply

let HELPER_PATH = "/tmp/clm_v4_probe_tension_helper.hexa_tmp"
let UBU1_PY = "/home/aiden/venv_orchestrator/bin/python3"
let MAC_OUT_DIR = "/Users/ghost/core/anima/state/p9_p0_measure_2026_05_03"
let UBU1_OUT_JSONL = "/tmp/p9_p0_probe_clm_v4_tension_100.jsonl"
let UBU1_LATENCY_LOG = "/tmp/p9_p0_probe_latency.json"
let UBU1_SFT_DATA = "/tmp/sft_data_subset_100.jsonl"

fn _write_helper(mode: string) {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# emitted by tool/clm_v4_probe_tension.hexa raw#37 transient (NOT committed)\n")
    parts.push("# Replaces state/p9_p0_measure_2026_05_03/probe_ubu1_clm_v4_tension.py with cache-resolver tokenizer load.\n")
    parts.push("import sys, os, glob, json, time, traceback\n")
    parts.push("from datetime import datetime, timezone\n")
    parts.push("\n")
    parts.push("# ── tokenizer cache resolver (from tool/clm_v4_tokenizer_load.hexa) ──\n")
    parts.push("def _resolve_tokenizer():\n")
    parts.push("    home = os.path.expanduser('~')\n")
    parts.push("    candidates = [\n")
    parts.push("        f'{home}/.cache/huggingface/hub/models--dancinlab--clm-v4-base-mirror/snapshots/*/tokenizer/tokenizer_64k_multilingual.model',\n")
    parts.push("        f'{home}/anima/checkpoints/clm_v4_350m/tokenizer_64k_multilingual.model',\n")
    parts.push("        '/tmp/tokenizer_64k_multilingual.model',\n")
    parts.push("    ]\n")
    parts.push("    for i, g in enumerate(candidates):\n")
    parts.push("        m = sorted(glob.glob(g))\n")
    parts.push("        if m:\n")
    parts.push("            if i == 2:\n")
    parts.push("                sys.stderr.write('[clm_v4_probe_tension] WARN: legacy /tmp fallback in use; promote via plan.md Step 2\\n')\n")
    parts.push("            return m[-1]\n")
    parts.push("    raise FileNotFoundError('CLM v4 64K tokenizer not in cache or /tmp; see state/clm_v4_tokenizer_propagation_plan_2026_05_04/plan.md Step 2')\n")
    parts.push("\n")
    parts.push("MODE = sys.argv[1] if len(sys.argv) > 1 else 'selftest'\n")
    parts.push("T = 64\n")
    parts.push("\n")
    parts.push("# 16 calibration prompts (cross-substrate consistent)\n")
    parts.push("CALIB_PROMPTS = [\n")
    parts.push("    'Define hexad as a six-fold integration:',\n")
    parts.push("    'Six modules form a hexagonal architecture when:',\n")
    parts.push("    'A balanced six-component system:',\n")
    parts.push("    'Hexad symmetry refers to:',\n")
    parts.push("    'Logical implication law: if A then:',\n")
    parts.push("    'Sequential rule application proceeds:',\n")
    parts.push("    'Closure under inference requires:',\n")
    parts.push("    'A formal proof system is closed when:',\n")
    parts.push("    'Integrated information measures partition independence:',\n")
    parts.push("    'Phi quantifies irreducibility of system:',\n")
    parts.push("    'Information integration is maximized when:',\n")
    parts.push("    'A whole greater than sum of parts:',\n")
    parts.push("    'Self-reference emerges when system observes:',\n")
    parts.push("    'Recursive meta-cognition models:',\n")
    parts.push("    'A self-aware system represents itself by:',\n")
    parts.push("    'Strange loops in cognition arise from:',\n")
    parts.push("]\n")
    parts.push("\n")
    parts.push("if MODE == 'selftest':\n")
    parts.push("    import sentencepiece as spm\n")
    parts.push("    tok_path = _resolve_tokenizer()\n")
    parts.push("    sp = spm.SentencePieceProcessor(model_file=tok_path)\n")
    parts.push("    vocab = sp.get_piece_size()\n")
    parts.push("    rows = []\n")
    parts.push("    for i, p in enumerate(CALIB_PROMPTS):\n")
    parts.push("        ids_full = sp.encode(p)\n")
    parts.push("        ids_T = ids_full[:T]\n")
    parts.push("        if len(ids_T) < T: ids_T = ids_T + [0] * (T - len(ids_T))\n")
    parts.push("        rows.append({'idx': i, 'prompt': p, 'ids_full': ids_full, 'ids_padded_T': ids_T, 'n_full': len(ids_full)})\n")
    parts.push("    # Dry-check ConsciousDecoderV2 import path resolution (no instantiation, no GPU)\n")
    parts.push("    decoder_import_ok = False\n")
    parts.push("    decoder_import_err = None\n")
    parts.push("    try:\n")
    parts.push("        sys.path.insert(0, '/home/aiden/anima/models')\n")
    parts.push("        sys.path.insert(0, '/home/aiden/anima/training')\n")
    parts.push("        sys.path.insert(0, '/home/aiden/anima')\n")
    parts.push("        from conscious_decoder import ConsciousDecoderV2  # noqa: F401\n")
    parts.push("        decoder_import_ok = True\n")
    parts.push("    except Exception as e:\n")
    parts.push("        decoder_import_err = str(e)\n")
    parts.push("    summary = {\n")
    parts.push("        'schema': 'anima/clm_v4_probe_tension/selftest/1',\n")
    parts.push("        'tokenizer_path': tok_path,\n")
    parts.push("        'vocab_size': vocab,\n")
    parts.push("        'T': T,\n")
    parts.push("        'n_calib_prompts': len(CALIB_PROMPTS),\n")
    parts.push("        'calib_tokens_shape': [len(CALIB_PROMPTS), T],\n")
    parts.push("        'rows': rows,\n")
    parts.push("        'decoder_import_ok': decoder_import_ok,\n")
    parts.push("        'decoder_import_err': decoder_import_err,\n")
    parts.push("        'verdict': 'PASS' if (vocab == 64000 and len(rows) == 16) else 'FAIL',\n")
    parts.push("        'sentinel': '__P9_clm_v4_probe_tension__ ' + ('PASS' if (vocab == 64000 and len(rows) == 16) else 'FAIL'),\n")
    parts.push("        'ts_utc': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),\n")
    parts.push("    }\n")
    parts.push("    print(json.dumps(summary))\n")
    parts.push("    sys.exit(0 if summary['verdict'] == 'PASS' else 1)\n")
    parts.push("\n")
    parts.push("# ── apply mode: full N=100 tension probe ──\n")
    parts.push("# Mirrors probe_ubu1_clm_v4_tension.py with line-15 hardcode replaced by _resolve_tokenizer().\n")
    parts.push("\n")
    parts.push("ANIMA_HOME = '/home/aiden/anima'\n")
    parts.push("CLM_CKPT = f'{ANIMA_HOME}/checkpoints/clm_v4_350m/scale_350m/best.pt'\n")
    parts.push("# TOKENIZER: was '/tmp/tokenizer_64k_multilingual.model' — now resolved at runtime\n")
    parts.push("TOKENIZER = _resolve_tokenizer()\n")
    parts.push("SFT_DATA = '" + UBU1_SFT_DATA + "'\n")
    parts.push("OUTPUT = '" + UBU1_OUT_JSONL + "'\n")
    parts.push("LATENCY_LOG = '" + UBU1_LATENCY_LOG + "'\n")
    parts.push("\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}/models')\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}/training')\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}/anima')\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}')\n")
    parts.push("\n")
    parts.push("print(f'[probe-hexa] start ts={time.strftime(\"%Y-%m-%dT%H:%M:%S\")}', flush=True)\n")
    parts.push("print(f'[probe-hexa] tokenizer_resolver_path={TOKENIZER}', flush=True)\n")
    parts.push("print(f'[probe-hexa] python={sys.version.split()[0]}', flush=True)\n")
    parts.push("\n")
    parts.push("import torch\n")
    parts.push("print(f'[probe-hexa] torch={torch.__version__} cuda={torch.cuda.is_available()}', flush=True)\n")
    parts.push("device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n")
    parts.push("print(f'[probe-hexa] device={device}', flush=True)\n")
    parts.push("\n")
    parts.push("try:\n")
    parts.push("    import sentencepiece as spm\n")
    parts.push("    sp = spm.SentencePieceProcessor(model_file=TOKENIZER)\n")
    parts.push("    vocab_size = sp.get_piece_size()\n")
    parts.push("    print(f'[probe-hexa] tokenizer loaded vocab={vocab_size}', flush=True)\n")
    parts.push("except Exception as e:\n")
    parts.push("    print(f'[probe-hexa] FAIL tokenizer: {e}', flush=True); sys.exit(2)\n")
    parts.push("\n")
    parts.push("try:\n")
    parts.push("    from conscious_decoder import ConsciousDecoderV2\n")
    parts.push("    print(f'[probe-hexa] ConsciousDecoderV2 imported', flush=True)\n")
    parts.push("except Exception as e:\n")
    parts.push("    print(f'[probe-hexa] FAIL import: {e}', flush=True); sys.exit(3)\n")
    parts.push("\n")
    parts.push("scale_cfg = {'d_model':768,'n_layer':16,'n_head':12,'n_kv_head':4,'block_size':512,'consciousness_dim':192}\n")
    parts.push("try:\n")
    parts.push("    decoder = ConsciousDecoderV2(\n")
    parts.push("        vocab_size=vocab_size, d_model=scale_cfg['d_model'], n_head=scale_cfg['n_head'],\n")
    parts.push("        n_layer=scale_cfg['n_layer'], block_size=scale_cfg['block_size'],\n")
    parts.push("        n_kv_head=scale_cfg['n_kv_head'], consciousness_dim=scale_cfg['consciousness_dim'],\n")
    parts.push("        dropout=0.0, gate_strength=0.001, n_ca_rules=8,\n")
    parts.push("    ).to(device).eval()\n")
    parts.push("    n_params = sum(p.numel() for p in decoder.parameters())\n")
    parts.push("    print(f'[probe-hexa] decoder built params={n_params:,}', flush=True)\n")
    parts.push("except Exception as e:\n")
    parts.push("    print(f'[probe-hexa] FAIL decoder build: {e}', flush=True)\n")
    parts.push("    traceback.print_exc(); sys.exit(4)\n")
    parts.push("\n")
    parts.push("try:\n")
    parts.push("    t0 = time.time()\n")
    parts.push("    ck = torch.load(CLM_CKPT, map_location=device, weights_only=False)\n")
    parts.push("    sd = ck.get('decoder', ck) if isinstance(ck, dict) else ck\n")
    parts.push("    missing, unexpected = decoder.load_state_dict(sd, strict=False)\n")
    parts.push("    t_load = time.time() - t0\n")
    parts.push("    print(f'[probe-hexa] ckpt loaded {t_load:.2f}s missing={len(missing)} unexpected={len(unexpected)}', flush=True)\n")
    parts.push("    if len(missing) > 50:\n")
    parts.push("        print(f'[probe-hexa] WARN many missing keys, e.g. {missing[:5]}', flush=True)\n")
    parts.push("except Exception as e:\n")
    parts.push("    print(f'[probe-hexa] FAIL ckpt load: {e}', flush=True)\n")
    parts.push("    traceback.print_exc(); sys.exit(5)\n")
    parts.push("\n")
    parts.push("records = []\n")
    parts.push("try:\n")
    parts.push("    with open(SFT_DATA, 'r') as f:\n")
    parts.push("        for line in f:\n")
    parts.push("            records.append(json.loads(line))\n")
    parts.push("    print(f'[probe-hexa] loaded {len(records)} records', flush=True)\n")
    parts.push("except Exception as e:\n")
    parts.push("    print(f'[probe-hexa] FAIL load sft: {e}', flush=True); sys.exit(6)\n")
    parts.push("\n")
    parts.push("augmented = []\n")
    parts.push("latencies = []\n")
    parts.push("errors = 0\n")
    parts.push("with torch.no_grad():\n")
    parts.push("    for i, rec in enumerate(records):\n")
    parts.push("        try:\n")
    parts.push("            text = rec.get('input', '') + ' ' + rec.get('completion', '')\n")
    parts.push("            tokens = sp.encode(text)[:T]\n")
    parts.push("            if len(tokens) < 2: tokens = tokens + [0] * (2 - len(tokens))\n")
    parts.push("            if len(tokens) < T: tokens = tokens + [0] * (T - len(tokens))\n")
    parts.push("            idx = torch.tensor([tokens], dtype=torch.long, device=device)\n")
    parts.push("            t0 = time.time()\n")
    parts.push("            out = decoder(idx)\n")
    parts.push("            torch.cuda.synchronize() if device.type == 'cuda' else None\n")
    parts.push("            t_fwd = time.time() - t0\n")
    parts.push("            tensions = out[2] if len(out) >= 3 else None\n")
    parts.push("            if tensions is None:\n")
    parts.push("                tension_target = [0.0] * T\n")
    parts.push("            else:\n")
    parts.push("                if isinstance(tensions, torch.Tensor):\n")
    parts.push("                    t_flat = tensions.detach().float().cpu().view(tensions.shape[0], -1)\n")
    parts.push("                    if t_flat.shape[1] >= T:\n")
    parts.push("                        tension_target = t_flat[0, :T].tolist()\n")
    parts.push("                    else:\n")
    parts.push("                        v = t_flat[0].mean().item()\n")
    parts.push("                        tension_target = [v] * T\n")
    parts.push("                elif isinstance(tensions, list):\n")
    parts.push("                    tension_target = [float(t) if not torch.is_tensor(t) else float(t.mean()) for t in tensions[:T]]\n")
    parts.push("                    if len(tension_target) < T:\n")
    parts.push("                        tension_target = tension_target + [0.0] * (T - len(tension_target))\n")
    parts.push("                else:\n")
    parts.push("                    tension_target = [0.0] * T\n")
    parts.push("            latencies.append(t_fwd)\n")
    parts.push("            rec_aug = dict(rec)\n")
    parts.push("            rec_aug['tension_target'] = tension_target\n")
    parts.push("            rec_aug['_probe_latency_s'] = t_fwd\n")
    parts.push("            augmented.append(rec_aug)\n")
    parts.push("            if i < 3 or i % 20 == 0:\n")
    parts.push("                print(f'[probe-hexa] {i+1}/{len(records)} t_fwd={t_fwd*1000:.1f}ms tension_mean={sum(tension_target)/len(tension_target):.4f}', flush=True)\n")
    parts.push("        except Exception as e:\n")
    parts.push("            errors += 1\n")
    parts.push("            if errors <= 3:\n")
    parts.push("                print(f'[probe-hexa] err at {i}: {e}', flush=True)\n")
    parts.push("            rec_aug = dict(rec)\n")
    parts.push("            rec_aug['tension_target'] = None\n")
    parts.push("            rec_aug['_probe_error'] = str(e)\n")
    parts.push("            augmented.append(rec_aug)\n")
    parts.push("\n")
    parts.push("with open(OUTPUT, 'w') as f:\n")
    parts.push("    for r in augmented:\n")
    parts.push("        f.write(json.dumps(r, ensure_ascii=False) + '\\n')\n")
    parts.push("\n")
    parts.push("if latencies:\n")
    parts.push("    lat_mean = sum(latencies) / len(latencies)\n")
    parts.push("    lat_p50 = sorted(latencies)[len(latencies)//2]\n")
    parts.push("    lat_p95 = sorted(latencies)[int(len(latencies)*0.95)]\n")
    parts.push("    proj_50k_s = lat_mean * 50000\n")
    parts.push("    proj_50k_hr = proj_50k_s / 3600\n")
    parts.push("else:\n")
    parts.push("    lat_mean = lat_p50 = lat_p95 = proj_50k_s = proj_50k_hr = 0\n")
    parts.push("\n")
    parts.push("stats = {\n")
    parts.push("    'phase': 'p9_p0_probe_clm_v4_tension',\n")
    parts.push("    'orchestrator': 'tool/clm_v4_probe_tension.hexa',\n")
    parts.push("    'tokenizer_path': TOKENIZER,\n")
    parts.push("    'n_records': len(records),\n")
    parts.push("    'n_augmented': len(augmented),\n")
    parts.push("    'n_errors': errors,\n")
    parts.push("    'latency_ms_mean': lat_mean * 1000,\n")
    parts.push("    'latency_ms_p50': lat_p50 * 1000,\n")
    parts.push("    'latency_ms_p95': lat_p95 * 1000,\n")
    parts.push("    'proj_50k_seconds': proj_50k_s,\n")
    parts.push("    'proj_50k_hours': proj_50k_hr,\n")
    parts.push("    'device': str(device),\n")
    parts.push("    'ckpt_path': CLM_CKPT,\n")
    parts.push("    'n_params': n_params,\n")
    parts.push("    'vocab_size': vocab_size,\n")
    parts.push("    'T': T,\n")
    parts.push("    'ts_utc': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),\n")
    parts.push("}\n")
    parts.push("with open(LATENCY_LOG, 'w') as f:\n")
    parts.push("    json.dump(stats, f, indent=2)\n")
    parts.push("print(f'[probe-hexa] DONE', flush=True)\n")
    parts.push("print(json.dumps(stats, indent=2), flush=True)\n")
    write_file(HELPER_PATH, parts.join(""))
}

fn _scp_helper_to_ubu1() {
    let cmd = "/usr/bin/scp -q " + HELPER_PATH + " ubu1:" + HELPER_PATH
    let r = exec_with_status(cmd)
    if to_int(r[1]) != 0 {
        eprintln("scp helper -> ubu1 FAILED: " + to_string(r[0]))
        exit(1)
    }
}

fn _ssh_run(args: string) -> [any] {
    let cmd = "/usr/bin/ssh -o ConnectTimeout=15 ubu1 '" + UBU1_PY + " " + HELPER_PATH + " " + args + "'"
    let r = exec_with_status(cmd)
    return r
}

fn _ast_validate() {
    let ast_cmd = "test -x /opt/homebrew/bin/python3 && /opt/homebrew/bin/python3 -c 'import ast,sys; ast.parse(open(\"" + HELPER_PATH + "\").read()); print(\"ast=ok\")' || echo 'ast=skip_no_python_on_mac'"
    let r = exec_with_status(ast_cmd)
    println(to_string(r[0]).trim())
}

fn cmd_selftest() {
    println("── clm_v4_probe_tension --selftest ──")
    _write_helper("selftest")
    _ast_validate()
    _scp_helper_to_ubu1()
    let r = _ssh_run("selftest")
    let out = to_string(r[0]).trim()
    println(out)
    if to_int(r[1]) != 0 {
        println("VERDICT=FAIL (selftest exit=" + to_string(r[1]) + ")")
        exit(1)
    }
    println("VERDICT=PASS")
    println("DONE")
}

fn cmd_apply() {
    println("── clm_v4_probe_tension --apply (FULL N=100 tension probe) ──")
    _write_helper("apply")
    _ast_validate()
    _scp_helper_to_ubu1()
    let r = _ssh_run("apply")
    print(to_string(r[0]))
    if to_int(r[1]) != 0 { eprintln("apply FAILED"); exit(1) }
    let scp_back = "/usr/bin/scp -q ubu1:" + UBU1_OUT_JSONL + " " + MAC_OUT_DIR + "/probe_clm_v4_tension_100_hexa.jsonl && /usr/bin/scp -q ubu1:" + UBU1_LATENCY_LOG + " " + MAC_OUT_DIR + "/probe_latency_hexa.json"
    let r2 = exec_with_status(scp_back)
    if to_int(r2[1]) != 0 {
        eprintln("scp back FAILED: " + to_string(r2[0]))
        exit(1)
    }
    println("scp back OK -> " + MAC_OUT_DIR + "/{probe_clm_v4_tension_100_hexa.jsonl,probe_latency_hexa.json}")
    println("DONE")
}

fn main() {
    let av = argv()
    let mut mode = "selftest"
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { mode = "selftest"; i = i + 1; continue }
        if a == "--apply" { mode = "apply"; i = i + 1; continue }
        i = i + 1
    }
    if mode == "selftest" { cmd_selftest(); exit(0) }
    if mode == "apply" { cmd_apply(); exit(0) }
    eprintln("unknown mode: " + mode); exit(2)
}
