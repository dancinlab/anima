// tool/p9_opt_1_v4_exec_h100_orchestrator.hexa — BG-Σ OPT-1 v4 actual H100 exec
//
// PURPOSE
//   Execute deferred F-SHIM-V4-3 (canonical_zero finite forward) + train_avg
//   harvest stub + optional limit=100 hellaswag sanity check, then auto-kill.
//   Closes the BG-Π v4 design cycle's H100-deferred falsifiers (-3 partial; -4
//   becomes HARVEST_STUB_ONLY in this cycle).
//
// LESSONS APPLIED (from BG-Μ + BG-Ο)
//   L1: sentinel name MUST be `results/COMPLETE.sentinel`
//   L2: skip Llama; only CLM v4 base (best.pt → HF format → load + forward)
//   L3: AUTO-KILL within ~90s of sentinel detection (mandatory)
//   L4: heartbeat from main exec.bash poll loop (single-process)
//   L5: sed redact at boot before tee (raw HF_TOKEN never persisted)
//
// raw#9   hexa-only Mac: this hexa emits state-dir bash (sibling-pattern
//         grandfathered; see tool/p9_llama_anchor_h100_orchestrator.hexa)
// raw#10  honest C3: ≥5 caveats baked into emitted handoff doc on PASS
// raw#15  repo-relative paths
// raw#37  transient-py-on-Linux: pod runs shim + smoketest (Python on pod ok)
// raw#71  falsifier-bound: F-SHIM-V4-3 + harvest predicates fixed pre-launch
//
// USAGE
//   hexa run tool/p9_opt_1_v4_exec_h100_orchestrator.hexa --selftest
//   hexa run tool/p9_opt_1_v4_exec_h100_orchestrator.hexa --emit
//   hexa run tool/p9_opt_1_v4_exec_h100_orchestrator.hexa --launch
//   hexa run tool/p9_opt_1_v4_exec_h100_orchestrator.hexa --kill <pod_id>
//
// CAPS
//   max_wall_minutes    = 60     (target 45min)
//   budget_target_usd   = 2.00
//   budget_hard_cap_usd = 3.00   (slightly higher than BG-Ρ; shim+harvest=more steps)
//   auto_kill_required  = true

let SCHEMA              = "anima/p9_opt_1_v4_exec_h100/orchestrator/1"
let CYCLE_TAG           = "opt_1_v4_exec_2026_05_04"
let STATE_DIR           = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04"
let RESULTS_DIR         = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec_results"
let EXEC_BASH_PATH      = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec.bash"
let RUN_H100_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_run_h100.bash"
let POD_INFO_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec_pod_info.json"
let VERDICT_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec_verdict.json"
let RUN_LOG_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec_run.log"
let HEARTBEAT_PATH      = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec_heartbeat.txt"
let BOOT_LOG_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_exec_boot.log"
let SHIM_PATH           = "/Users/ghost/core/anima/tool/transient_py/clm_v4_hf_format_shim.py"
let FIXTURE_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_consciousness_states_fixture.json"
let TRAIN_AVG_DST       = "/Users/ghost/core/anima/state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_train_avg_fixture.json"
let DECODER_V3_PATH     = "/Users/ghost/core/anima/ready/anima/models/legacy/decoder_v3.py"
let CONSCIOUS_DEC_PATH  = "/Users/ghost/core/anima/ready/models/conscious_decoder.py"
let SSH_KEY             = "/Users/ghost/.runpod/ssh/RunPod-Key-Go"
let RUNPODCTL           = "/opt/homebrew/bin/runpodctl"

let MAX_WALL_MIN        = 60
let BUDGET_TARGET_USD   = 2.00
let BUDGET_HARD_CAP_USD = 3.00
let OD_RATE_USD         = 2.99

// === Phase 2 watchdog hook (constants) ===
let BG_LANE             = "BG-P9-OPT-1-V4-EXEC"
let TARGET_USD          = "2"
let WATCHDOG_HEXA       = "/Users/ghost/core/anima/tool/h100_cost_watchdog.hexa"
let WATCHDOG_REGISTER   = "/Users/ghost/core/anima/tool/h100_register.bash"
let WATCHDOG_HB_DIR     = "/Users/ghost/core/anima/state/h100_watchdog/heartbeats"

// ─── helpers ──────────────────────────────────────────────────────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── selftest ─────────────────────────────────────────────────────────────

fn _selftest() {
    println("[selftest] schema=" + SCHEMA)
    println("[selftest] cycle=" + CYCLE_TAG)

    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))
    if !_file_exists(STATE_DIR) {
        eprintln("FAIL: state dir not creatable")
        exit(1)
    }
    println("[T1] state dir OK")

    if !_file_exists(SSH_KEY) {
        eprintln("FAIL: ssh key missing: " + SSH_KEY)
        exit(1)
    }
    println("[T2] ssh key OK")

    if !_file_exists(SHIM_PATH) {
        eprintln("FAIL: shim missing: " + SHIM_PATH)
        exit(1)
    }
    println("[T3] shim v4 OK")

    if !_file_exists(FIXTURE_PATH) {
        eprintln("FAIL: canonical_zero fixture missing: " + FIXTURE_PATH)
        exit(1)
    }
    println("[T4] canonical_zero fixture OK")

    if !_file_exists(DECODER_V3_PATH) {
        eprintln("FAIL: decoder_v3.py missing: " + DECODER_V3_PATH)
        exit(1)
    }
    println("[T5] decoder_v3.py OK")

    if !_file_exists(CONSCIOUS_DEC_PATH) {
        eprintln("FAIL: conscious_decoder.py missing: " + CONSCIOUS_DEC_PATH)
        exit(1)
    }
    println("[T6] conscious_decoder.py OK")

    println("[T7] runpodctl path constant: " + RUNPODCTL)

    // Phase 2: probe watchdog tools (graceful warn-only)
    println("[T9] Phase 2 watchdog hooks:")
    println("       BG_LANE=" + BG_LANE + " TARGET_USD=$" + TARGET_USD)
    if _file_exists(WATCHDOG_REGISTER) { println("       T9a register OK: " + WATCHDOG_REGISTER) }
    else { println("       T9a register WARN missing: " + WATCHDOG_REGISTER) }
    if _file_exists(WATCHDOG_HEXA) { println("       T9b watchdog hexa OK: " + WATCHDOG_HEXA) }
    else { println("       T9b watchdog hexa WARN missing: " + WATCHDOG_HEXA) }
    println("       T9c heartbeat dir: " + WATCHDOG_HB_DIR)
    println("       T9d verdict schema: pod_kill_verified_404 + watchdog_deregistered + cost_{target,actual}_usd + cost_overrun_2x_alerted")

    println("[selftest] PASS")
    exit(0)
}

// ─── emit exec.bash + run_h100.bash ─────────────────────────────────────────

fn _emit() {
    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))

    let exec_body = "#!/bin/bash\n" +
"# emitted by tool/p9_opt_1_v4_exec_h100_orchestrator.hexa — OPT-1 v4 exec lifecycle\n" +
"# raw#9 sibling-pattern Mac-side bash. Regenerate via --emit. raw#37 H100 transient py.\n" +
"set -uo pipefail\n" +
"\n" +
"STATE_DIR='" + STATE_DIR + "'\n" +
"RESULTS_DIR='" + RESULTS_DIR + "'\n" +
"POD_INFO='" + POD_INFO_PATH + "'\n" +
"VERDICT='" + VERDICT_PATH + "'\n" +
"RUN_LOG='" + RUN_LOG_PATH + "'\n" +
"HEARTBEAT='" + HEARTBEAT_PATH + "'\n" +
"BOOT_LOG='" + BOOT_LOG_PATH + "'\n" +
"SHIM_PATH='" + SHIM_PATH + "'\n" +
"FIXTURE_PATH='" + FIXTURE_PATH + "'\n" +
"TRAIN_AVG_DST='" + TRAIN_AVG_DST + "'\n" +
"DECODER_V3_PATH='" + DECODER_V3_PATH + "'\n" +
"CONSCIOUS_DEC_PATH='" + CONSCIOUS_DEC_PATH + "'\n" +
"RUN_H100_PATH='" + RUN_H100_PATH + "'\n" +
"SSH_KEY='" + SSH_KEY + "'\n" +
"RUNPODCTL='" + RUNPODCTL + "'\n" +
"MAX_WALL_MIN=" + to_string(MAX_WALL_MIN) + "\n" +
"BUDGET_HARD_CAP=" + to_string(BUDGET_HARD_CAP_USD) + "\n" +
"OD_RATE=" + to_string(OD_RATE_USD) + "\n" +
"START_EPOCH=$(date -u +%s)\n" +
"\n" +
"log() { echo \"[$(date -u +%FT%TZ)] $*\" | tee -a \"$RUN_LOG\"; }\n" +
"hb()  { echo \"[$(date -u +%FT%TZ)] $*\" > \"$HEARTBEAT\"; }\n" +
"redact_hf() { sed -E 's/(HF_TOKEN[\"[:space:]]*[:=][\"[:space:]]*)hf_[A-Za-z0-9_]+/\\1<REDACTED>/g; s/(hf_)[A-Za-z0-9_]{20,}/\\1<REDACTED>/g'; }\n" +
"\n" +
"# ── Stage 0: secrets ──\n" +
"export RUNPOD_API_KEY=$(secret get --raw runpod.api_key 2>/dev/null)\n" +
"export HF_TOKEN_LOCAL=$(secret get --raw huggingface.token 2>/dev/null)\n" +
"if [ -z \"${RUNPOD_API_KEY:-}\" ] || [ -z \"${HF_TOKEN_LOCAL:-}\" ]; then\n" +
"    log \"FATAL: secrets unavailable\"\n" +
"    exit 2\n" +
"fi\n" +
"if [[ \"$RUNPOD_API_KEY\" == \\*\\*\\** ]] || [[ \"$HF_TOKEN_LOCAL\" == \\*\\*\\** ]]; then\n" +
"    log \"FATAL: secret returned redacted form despite --raw\"\n" +
"    exit 2\n" +
"fi\n" +
"log \"secrets OK (runpod=${#RUNPOD_API_KEY}b, hf=${#HF_TOKEN_LOCAL}b)\"\n" +
"hb \"stage0_secrets_loaded\"\n" +
"\n" +
"# ── Stage 1: boot H100 pod ──\n" +
"POD_NAME='anima-p9-opt-1-v4-2026-05-04'\n" +
"log \"booting pod=$POD_NAME (H100 80GB HBM3 secure on-demand @ \\$$OD_RATE/hr)\"\n" +
"BOOT_RAW_OUT=\"$STATE_DIR/opt_1_v4_exec_boot.raw.tmp\"\n" +
"hb \"stage1_booting_pod\"\n" +
"$RUNPODCTL pod create \\\n" +
"    --name \"$POD_NAME\" \\\n" +
"    --gpu-id 'NVIDIA H100 80GB HBM3' \\\n" +
"    --gpu-count 1 \\\n" +
"    --image 'runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04' \\\n" +
"    --container-disk-in-gb 80 \\\n" +
"    --volume-in-gb 50 \\\n" +
"    --volume-mount-path /workspace \\\n" +
"    --ports '22/tcp,8888/http' \\\n" +
"    --cloud-type SECURE \\\n" +
"    --ssh \\\n" +
"    --env \"{\\\"HF_TOKEN\\\":\\\"$HF_TOKEN_LOCAL\\\"}\" \\\n" +
"    > \"$BOOT_RAW_OUT\" 2>&1\n" +
"BOOT_RC=$?\n" +
"redact_hf < \"$BOOT_RAW_OUT\" > \"$BOOT_LOG\"\n" +
"rm -f \"$BOOT_RAW_OUT\"\n" +
"if [ $BOOT_RC -ne 0 ]; then\n" +
"    log \"FATAL: pod boot failed rc=$BOOT_RC\"\n" +
"    cat \"$BOOT_LOG\" | redact_hf | tee -a \"$RUN_LOG\"\n" +
"    jq -n --arg ts \"$(date -u +%FT%TZ)\" --arg reason \"pod_boot_failed\" '{cycle:\"" + CYCLE_TAG + "\",ts_utc:$ts,verdict:\"FAIL\",reason:$reason}' > \"$VERDICT\"\n" +
"    exit 3\n" +
"fi\n" +
"POD_ID=$(grep -oE '\"[a-z0-9]{14}\"' \"$BOOT_LOG\" | head -1 | tr -d '\"')\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    POD_ID=$(grep -oE 'pod [a-z0-9]{12,16}' \"$BOOT_LOG\" | head -1 | awk '{print $2}')\n" +
"fi\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    log \"FATAL: cannot extract pod_id\"\n" +
"    cat \"$BOOT_LOG\"\n" +
"    exit 4\n" +
"fi\n" +
"log \"pod_id=$POD_ID\"\n" +
"echo '{\"pod_id\":\"'$POD_ID'\",\"booted_ts\":\"'$(date -u +%FT%TZ)'\"}' > \"$POD_INFO\"\n" +
"hb \"stage1_pod_booted pod_id=$POD_ID\"\n" +
"\n" +
"# === Phase 2 watchdog hook (boot) ===\n" +
"BG_LANE='" + BG_LANE + "'\n" +
"TARGET_USD='" + TARGET_USD + "'\n" +
"WATCHDOG_REGISTER='" + WATCHDOG_REGISTER + "'\n" +
"WATCHDOG_HB_DIR='" + WATCHDOG_HB_DIR + "'\n" +
"WATCHDOG_HEXA='" + WATCHDOG_HEXA + "'\n" +
"WATCHDOG_REGISTERED=0\n" +
"if [ -f \"$WATCHDOG_REGISTER\" ]; then\n" +
"    if bash \"$WATCHDOG_REGISTER\" \"$POD_ID\" \"$BG_LANE\" \"$TARGET_USD\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"        WATCHDOG_REGISTERED=1\n" +
"        log \"[watchdog] register OK pod=$POD_ID lane=$BG_LANE target=\\$$TARGET_USD\"\n" +
"    else\n" +
"        log \"[watchdog] WARN register failed — proceeding without watchdog tracking\"\n" +
"    fi\n" +
"fi\n" +
"\n" +
"# ── Stage 1b: kill-on-exit trap ──\n" +
"# === Phase 2 watchdog hook (trap pre-stop) ===\n" +
"WATCHDOG_DEREGISTERED=0\n" +
"_kill_pod() {\n" +
"    if [ -d \"$WATCHDOG_HB_DIR\" ]; then\n" +
"        echo \"EXITING $(date -u +%FT%TZ) pod=$POD_ID\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" || true\n" +
"    fi\n" +
"    log \"[trap] killing pod=$POD_ID (auto-kill mandatory)\"\n" +
"    $RUNPODCTL pod stop \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
"    $RUNPODCTL pod delete \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
" # : 404 verify (3 retries × 30s; previous inline single-shot kept first)\n" +
"    POD_404=0\n" +
"    for vi in 1 2 3; do\n" +
"        POST=$($RUNPODCTL pod get \"$POD_ID\" 2>&1 | head -3)\n" +
"        if echo \"$POST\" | grep -qiE '404|not.?found|no.?pod|does not exist'; then\n" +
"            POD_404=1\n" +
"            log \"[trap] 404 verified (try $vi/3)\"\n" +
"            break\n" +
"        fi\n" +
"        log \"[trap] 404 verify try $vi/3 not yet — sleep 30s\"\n" +
"        sleep 30\n" +
"    done\n" +
"    log \"[trap] post-kill: $POST  pod_kill_verified_404=$POD_404\"\n" +
" # : deregister cost-watchdog\n" +
"    WATCHDOG_DEREGISTERED=0\n" +
"    if [ \"$POD_404\" = \"1\" ] && [ -f \"$WATCHDOG_HEXA\" ]; then\n" +
"        if /Users/ghost/core/hexa-lang/hexa run \"$WATCHDOG_HEXA\" --deregister \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"            WATCHDOG_DEREGISTERED=1\n" +
"            log \"[watchdog] deregister OK pod=$POD_ID\"\n" +
"        fi\n" +
"    fi\n" +
"    if [ -f \"$POD_INFO\" ]; then\n" +
"        jq --arg killed \"$(date -u +%FT%TZ)\" --arg post \"$POST\" --argjson p404 \"$POD_404\" --argjson wdd \"$WATCHDOG_DEREGISTERED\" \\\n" +
"            '. + {killed_ts:$killed, post_kill_status:$post, pod_kill_verified_404:($p404==1), watchdog_deregistered:($wdd==1)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\" || true\n" +
"    fi\n" +
"}\n" +
"trap _kill_pod EXIT INT TERM\n" +
"\n" +
"# ── Stage 2: wait for SSH (max 6min) ──\n" +
"log \"waiting for SSH ready (max 6min)\"\n" +
"hb \"stage2_waiting_ssh\"\n" +
"SSH_HOST=''\n" +
"SSH_PORT=''\n" +
"for i in $(seq 1 36); do\n" +
"    INFO=$($RUNPODCTL pod get \"$POD_ID\" -o json 2>/dev/null)\n" +
"    SSH_HOST=$(echo \"$INFO\" | jq -r '.ssh.ip // empty' 2>/dev/null)\n" +
"    SSH_PORT=$(echo \"$INFO\" | jq -r '.ssh.port // empty' 2>/dev/null)\n" +
"    if [ -n \"$SSH_HOST\" ] && [ \"$SSH_HOST\" != \"null\" ] && [ -n \"$SSH_PORT\" ] && [ \"$SSH_PORT\" != \"null\" ]; then\n" +
"        if ssh -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -p \"$SSH_PORT\" \"root@$SSH_HOST\" 'echo READY' 2>/dev/null | grep -q READY; then\n" +
"            log \"SSH ready at $SSH_HOST:$SSH_PORT (after ${i} probes)\"\n" +
"            break\n" +
"        fi\n" +
"    fi\n" +
"    sleep 10\n" +
"done\n" +
"if [ -z \"$SSH_HOST\" ] || [ \"$SSH_HOST\" = \"null\" ] || [ -z \"$SSH_PORT\" ] || [ \"$SSH_PORT\" = \"null\" ]; then\n" +
"    log \"FATAL: pod never reached SSH ready in 6min\"\n" +
"    exit 5\n" +
"fi\n" +
"jq --arg h \"$SSH_HOST\" --arg p \"$SSH_PORT\" '. + {ssh_host:$h, ssh_port:($p|tonumber)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\"\n" +
"hb \"stage2_ssh_ready host=$SSH_HOST port=$SSH_PORT\"\n" +
"\n" +
"SSH=\"ssh -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p $SSH_PORT root@$SSH_HOST\"\n" +
"SCP=\"scp -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $SSH_PORT\"\n" +
"\n" +
"# ── Stage 3: scp shim + fixture + legacy decoder modules + run script ──\n" +
"log \"setup: ssh mkdir + scp shim v4 + canonical_zero fixture + legacy decoder + run_h100.bash\"\n" +
"hb \"stage3_setup_starting\"\n" +
"$SSH 'mkdir -p /workspace/p9_v4_exec/results /root/anima/ready/anima/models/legacy /root/anima/ready/models'\n" +
"$SCP \"$SHIM_PATH\" \"root@$SSH_HOST:/workspace/p9_v4_exec/clm_v4_hf_format_shim.py\" 2>&1 | tail -1\n" +
"$SCP \"$FIXTURE_PATH\" \"root@$SSH_HOST:/workspace/p9_v4_exec/opt_1_v4_consciousness_states_fixture.json\" 2>&1 | tail -1\n" +
"$SCP \"$DECODER_V3_PATH\" \"root@$SSH_HOST:/root/anima/ready/anima/models/legacy/decoder_v3.py\" 2>&1 | tail -1\n" +
"$SCP \"$CONSCIOUS_DEC_PATH\" \"root@$SSH_HOST:/root/anima/ready/models/conscious_decoder.py\" 2>&1 | tail -1\n" +
"$SCP \"$RUN_H100_PATH\" \"root@$SSH_HOST:/workspace/p9_v4_exec/run_h100.bash\" 2>&1 | tail -1\n" +
"$SSH 'chmod +x /workspace/p9_v4_exec/run_h100.bash'\n" +
"\n" +
"log \"launching v4 exec on H100\"\n" +
"$SSH 'cat /proc/1/environ | tr \"\\0\" \"\\n\" | grep ^HF_TOKEN= > /workspace/p9_v4_exec/hf_token.env && cd /workspace/p9_v4_exec && set -a && . hf_token.env && set +a && nohup bash run_h100.bash > orchestrator.log 2>&1 & echo $! > run.pid; disown $! 2>/dev/null || true; sleep 2; cat run.pid'\n" +
"hb \"stage3_h100_launched\"\n" +
"\n" +
"# ── Stage 4: poll loop ──\n" +
"log \"poll loop start (max ${MAX_WALL_MIN}min, budget cap \\$${BUDGET_HARD_CAP})\"\n" +
"COMPLETE=0\n" +
"POLL_INTERVAL=120\n" +
"while true; do\n" +
"    NOW=$(date -u +%s)\n" +
"    ELAPSED_MIN=$(( (NOW - START_EPOCH) / 60 ))\n" +
"    ELAPSED_HR_DEC=$(awk \"BEGIN{printf \\\"%.4f\\\", ($NOW - $START_EPOCH) / 3600}\")\n" +
"    ELAPSED_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $ELAPSED_HR_DEC * $OD_RATE}\")\n" +
"\n" +
"    COST_OVER=$(awk \"BEGIN{print ($ELAPSED_COST > $BUDGET_HARD_CAP) ? 1 : 0}\")\n" +
"    if [ \"$COST_OVER\" = \"1\" ]; then\n" +
"        log \"COST CAP HIT \\$$ELAPSED_COST > \\$$BUDGET_HARD_CAP — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"    if [ $ELAPSED_MIN -ge $MAX_WALL_MIN ]; then\n" +
"        log \"WALL CAP HIT ${ELAPSED_MIN}min ≥ ${MAX_WALL_MIN}min — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    PROBE=$($SSH 'ls /workspace/p9_v4_exec/results/COMPLETE.sentinel 2>/dev/null && echo SENTINEL_FOUND; ps -p $(cat /workspace/p9_v4_exec/run.pid 2>/dev/null) -o pid,etime,comm 2>/dev/null | tail -1' 2>/dev/null)\n" +
"    log \"elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|')\"\n" +
"    hb \"poll elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|' | head -c 200)\"\n" +
"\n" +
" # === Phase 2 watchdog hook (heartbeat) ===\n" +
"    if [ -n \"${WATCHDOG_HB_DIR:-}\" ]; then\n" +
"        mkdir -p \"$WATCHDOG_HB_DIR\" 2>/dev/null || true\n" +
"        echo \"poll $(date -u +%FT%TZ) pod=$POD_ID elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST}\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" 2>/dev/null || true\n" +
"    fi\n" +
"\n" +
"    # incremental sync (small JSONs only)\n" +
"    $SCP -r \"root@$SSH_HOST:/workspace/p9_v4_exec/results/*.json\" \"$RESULTS_DIR/\" 2>/dev/null || true\n" +
"    $SCP \"root@$SSH_HOST:/workspace/p9_v4_exec/orchestrator.log\" \"$STATE_DIR/opt_1_v4_h100_orchestrator.log\" 2>/dev/null || true\n" +
"\n" +
"    if echo \"$PROBE\" | grep -q SENTINEL_FOUND; then\n" +
"        log \"COMPLETE.sentinel detected — final sync + auto-kill imminent\"\n" +
"        COMPLETE=1\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/p9_v4_exec/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -3 | tee -a \"$RUN_LOG\" || true\n" +
"        # Pull v4_apply.log + train_avg fixture + sanity eval logs\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_v4_exec/v4_apply.log\" \"$RESULTS_DIR/v4_apply.log\" 2>/dev/null || true\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_v4_exec/output_v4/config.json\" \"$RESULTS_DIR/output_v4_config.json\" 2>/dev/null || true\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_v4_exec/results/train_avg_fixture.json\" \"$TRAIN_AVG_DST\" 2>/dev/null || true\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_v4_exec/orchestrator.log\" \"$STATE_DIR/opt_1_v4_h100_orchestrator.log\" 2>&1 | tail -1 || true\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    sleep $POLL_INTERVAL\n" +
"done\n" +
"\n" +
"# ── Stage 5: pod kill via trap (auto on exit) ──\n" +
"\n" +
"# ── Stage 6: verdict ──\n" +
"log \"computing verdict\"\n" +
"FINAL_ELAPSED_MIN=$(( ($(date -u +%s) - START_EPOCH) / 60 ))\n" +
"FINAL_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $FINAL_ELAPSED_MIN/60 * $OD_RATE}\")\n" +
"hb \"stage6_verdict_computing\"\n" +
"\n" +
"# Read structured verdict json from H100 (results/v4_verdict.json) if present\n" +
"V4_VERDICT_SRC=\"$RESULTS_DIR/v4_verdict.json\"\n" +
"\n" +
"F_V4_3='UNKNOWN'\n" +
"F_V4_4='HARVEST_STUB_ONLY'\n" +
"HARVEST_VIA='FAILED'\n" +
"FINITE_FORWARD='unknown'\n" +
"SANITY_CZ='null'\n" +
"SANITY_NF='null'\n" +
"LIFT_PP='null'\n" +
"\n" +
"if [ -f \"$V4_VERDICT_SRC\" ]; then\n" +
"    F_V4_3=$(jq -r '.f_shim_v4_3 // \"UNKNOWN\"' \"$V4_VERDICT_SRC\")\n" +
"    F_V4_4=$(jq -r '.f_shim_v4_4 // \"HARVEST_STUB_ONLY\"' \"$V4_VERDICT_SRC\")\n" +
"    HARVEST_VIA=$(jq -r '.harvest_via // \"FAILED\"' \"$V4_VERDICT_SRC\")\n" +
"    FINITE_FORWARD=$(jq -r '.finite_forward // \"unknown\"' \"$V4_VERDICT_SRC\")\n" +
"    SANITY_CZ=$(jq -r '.sanity_canonical_zero_hellaswag_acc // \"null\"' \"$V4_VERDICT_SRC\")\n" +
"    SANITY_NF=$(jq -r '.sanity_no_fixture_hellaswag_acc // \"null\"' \"$V4_VERDICT_SRC\")\n" +
"    if [ \"$SANITY_CZ\" != \"null\" ] && [ \"$SANITY_NF\" != \"null\" ]; then\n" +
"        LIFT_PP=$(awk \"BEGIN{printf \\\"%.2f\\\", ($SANITY_CZ - $SANITY_NF) * 100}\")\n" +
"    fi\n" +
"fi\n" +
"\n" +
"# Pod 404 verification\n" +
"POD_404='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    POD_404=$(jq -r '.pod_kill_verified_404 // false' \"$POD_INFO\")\n" +
"fi\n" +
"\n" +
"# === Phase 2 verdict schema (cost-discipline fields) ===\n" +
"COST_TARGET_USD=$TARGET_USD\n" +
"COST_ACTUAL_USD=$FINAL_COST\n" +
"COST_OVERRUN_RATIO=$(awk -v a=\"$COST_ACTUAL_USD\" -v t=\"$COST_TARGET_USD\" 'BEGIN{ if (t+0 > 0) printf \"%.4f\", a/t; else print \"0\" }')\n" +
"COST_OVERRUN_2X_ALERTED='false'\n" +
"if awk -v r=\"$COST_OVERRUN_RATIO\" 'BEGIN{exit !(r+0 >= 2.0)}'; then COST_OVERRUN_2X_ALERTED='true'; fi\n" +
"WATCHDOG_DEREGISTERED_FINAL='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    WD_TMP=$(jq -r '.watchdog_deregistered // false' \"$POD_INFO\" 2>/dev/null)\n" +
"    if [ \"$WD_TMP\" = \"true\" ]; then WATCHDOG_DEREGISTERED_FINAL='true'; fi\n" +
"fi\n" +
"\n" +
"jq -n \\\n" +
"    --arg cycle \"" + CYCLE_TAG + "\" \\\n" +
"    --arg ts \"$(date -u +%FT%TZ)\" \\\n" +
"    --arg pod \"$POD_ID\" \\\n" +
"    --argjson pod404 \"$POD_404\" \\\n" +
"    --argjson wd_dereg \"$WATCHDOG_DEREGISTERED_FINAL\" \\\n" +
"    --argjson cost_target \"$COST_TARGET_USD\" \\\n" +
"    --argjson cost_actual \"$COST_ACTUAL_USD\" \\\n" +
"    --argjson cost_ratio \"$COST_OVERRUN_RATIO\" \\\n" +
"    --argjson cost_2x \"$COST_OVERRUN_2X_ALERTED\" \\\n" +
"    --arg f3 \"$F_V4_3\" \\\n" +
"    --arg f4 \"$F_V4_4\" \\\n" +
"    --arg via \"$HARVEST_VIA\" \\\n" +
"    --arg fwd \"$FINITE_FORWARD\" \\\n" +
"    --arg cz \"$SANITY_CZ\" \\\n" +
"    --arg nf \"$SANITY_NF\" \\\n" +
"    --arg lift \"$LIFT_PP\" \\\n" +
"    --argjson wall \"$FINAL_ELAPSED_MIN\" \\\n" +
"    --argjson cost \"$FINAL_COST\" \\\n" +
"    --argjson complete \"$COMPLETE\" \\\n" +
"    '{\n" +
"        cycle: $cycle, ts_utc: $ts, pod_id: $pod,\n" +
"        pod_terminated: true,\n" +
"        pod_kill_verified_404: $pod404,\n" +
"        scope: \"F-SHIM-V4-3 verification + train_avg harvest stub + optional canonical_zero sanity eval (limit=100 hellaswag)\",\n" +
"        f_shim_v4_1_dry_run_carry: \"PASS\",\n" +
"        f_shim_v4_2_v3_regression_carry: \"PASS\",\n" +
"        f_shim_v4_3_canonical_zero_finite_forward: $f3,\n" +
"        f_shim_v4_4_train_avg_above_random_5pt: $f4,\n" +
"        finite_forward: $fwd,\n" +
"        train_avg_fixture_harvested_via: $via,\n" +
"        train_avg_fixture_path: \"state/p9_base_validation_prereq_exec_2026_05_04/opt_1_v4_train_avg_fixture.json\",\n" +
"        sanity_eval_canonical_zero_hellaswag_acc: ($cz | if . == \"null\" then null else tonumber end),\n" +
"        sanity_eval_no_fixture_hellaswag_acc: ($nf | if . == \"null\" then null else tonumber end),\n" +
"        consciousness_injection_lift_pp: ($lift | if . == \"null\" then null else tonumber end),\n" +
"        wall_time_min: $wall,\n" +
"        actual_cost_usd: $cost,\n" +
"        complete_sentinel_detected: ($complete == 1),\n" +
"        watchdog_deregistered: $wd_dereg,\n" +
"        cost_target_usd: $cost_target,\n" +
"        cost_actual_usd: $cost_actual,\n" +
"        cost_overrun_ratio: $cost_ratio,\n" +
"        cost_overrun_2x_alerted: $cost_2x,\n" +
"        honest_c3: [\n" +
"            \"canonical_zero is sanity-only fixture; cross_attn.o_proj init std=0.001 + zero values yields ~zero residual; lift_pp expected near 0\",\n" +
"            \"limit=100 hellaswag has stderr ~5pp; lift_pp <5pp is within noise\",\n" +
"            \"train_avg harvest is STUB if approach (b) used (synthetic forward-pass average via dummy text) — not a true train-time average\",\n" +
"            \"H100 bfloat16 ⇒ slight numeric drift vs fp32; 1-batch forward finite check is robust (NaN/Inf would manifest immediately)\",\n" +
"            \"shim v4 modeling.py adds 88 LoC dormant fixture loader; F-SHIM-V4-2 is runtime-equivalence not byte-level\",\n" +
"            \"block_size=512 truncation orthogonal — v4 fixture cannot fix MMLU prompt left-truncation\"\n" +
"        ]\n" +
"    }' > \"$VERDICT\"\n" +
"\n" +
"log \"verdict written: f_shim_v4_3=$F_V4_3 harvest_via=$HARVEST_VIA wall=${FINAL_ELAPSED_MIN}min cost=\\$${FINAL_COST}\"\n" +
"hb \"verdict f_shim_v4_3=$F_V4_3 harvest_via=$HARVEST_VIA\"\n" +
"echo \"__P9_OPT_1_V4_EXEC__ f_shim_v4_3=$F_V4_3\" | tee -a \"$RUN_LOG\"\n" +
"exit 0\n"

    write_file(EXEC_BASH_PATH, exec_body)
    exec_with_status("chmod +x " + _sq(EXEC_BASH_PATH))
    println("[emit] " + EXEC_BASH_PATH)

    let run_h100 = "#!/bin/bash\n" +
"# emitted by tool/p9_opt_1_v4_exec_h100_orchestrator.hexa — H100-side v4 exec runner\n" +
"# raw#37 transient: Python on Linux permitted; killed with pod.\n" +
"set -uo pipefail\n" +
"\n" +
"WORK=/workspace/p9_v4_exec\n" +
"cd $WORK\n" +
"export HF_TOKEN=\"${HF_TOKEN}\"\n" +
"export HF_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export HUGGING_FACE_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\n" +
"export PYTHONUNBUFFERED=1\n" +
"\n" +
"RESULTS=$WORK/results\n" +
"mkdir -p $RESULTS\n" +
"\n" +
"echo \"[orch] start ts=$(date -u +%FT%TZ)\"\n" +
"\n" +
"# Setup: install deps + download CLM v4 base mirror + Llama tokenizer (no Llama needed — only CLM)\n" +
"echo \"[setup] installing deps\"\n" +
"pip install -q --no-input huggingface_hub safetensors 'transformers>=4.45' accelerate datasets 'lm-eval==0.4.11' sentencepiece tiktoken protobuf 2>&1 | tail -8\n" +
"\n" +
"# Auth\n" +
"hf auth login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -2 || \\\n" +
"    huggingface-cli login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -2 || true\n" +
"\n" +
"# Download CLM v4 base mirror (dancinlab org)\n" +
"echo \"[setup] downloading dancinlab/clm-v4-base-mirror\"\n" +
"hf download dancinlab/clm-v4-base-mirror 2>&1 | tail -5 || \\\n" +
"    huggingface-cli download dancinlab/clm-v4-base-mirror 2>&1 | tail -5\n" +
"\n" +
"# Locate best.pt + tokenizer (find in cache)\n" +
"BEST_PT=$(find ~/.cache/huggingface/hub/models--dancinlab--clm-v4-base-mirror/snapshots -name 'best.pt' 2>/dev/null | head -1)\n" +
"TOK_DIR=$(find ~/.cache/huggingface/hub/models--dancinlab--clm-v4-base-mirror/snapshots -type d -name 'tokenizer' 2>/dev/null | head -1)\n" +
"echo \"[setup] best.pt=$BEST_PT\"\n" +
"echo \"[setup] tokenizer=$TOK_DIR\"\n" +
"if [ -z \"$BEST_PT\" ] || [ -z \"$TOK_DIR\" ]; then\n" +
"    echo \"[FAIL] best.pt or tokenizer not found in HF cache\"\n" +
"    ls -R ~/.cache/huggingface/hub/models--dancinlab--clm-v4-base-mirror/snapshots/ 2>&1 | head -50\n" +
"    echo '{\"f_shim_v4_3\":\"FAIL\",\"reason\":\"best.pt or tokenizer missing in HF cache\"}' > $RESULTS/v4_verdict.json\n" +
"    touch $RESULTS/COMPLETE.sentinel\n" +
"    exit 1\n" +
"fi\n" +
"\n" +
"echo \"[orch] torch=$(python3 -c 'import torch; print(torch.__version__)')\"\n" +
"nvidia-smi --query-gpu=name,memory.total --format=csv | head -2\n" +
"\n" +
"# ── Stage A: Run shim v4 with canonical_zero fixture ──\n" +
"OUT_V4=$WORK/output_v4\n" +
"OUT_NF=$WORK/output_no_fixture\n" +
"mkdir -p $OUT_V4 $OUT_NF\n" +
"\n" +
"echo \"[stageA] shim v4 with canonical_zero fixture\"\n" +
"python3 clm_v4_hf_format_shim.py \\\n" +
"    --input-pt \"$BEST_PT\" \\\n" +
"    --tokenizer-dir \"$TOK_DIR\" \\\n" +
"    --output-dir \"$OUT_V4\" \\\n" +
"    --consciousness-states-fixture \"$WORK/opt_1_v4_consciousness_states_fixture.json\" \\\n" +
"    --verify --force-overwrite 2>&1 | tee v4_apply.log\n" +
"V4_RC=${PIPESTATUS[0]}\n" +
"echo \"[stageA] shim_rc=$V4_RC\"\n" +
"\n" +
"echo \"[stageA-no-fixture] shim v4 WITHOUT fixture (sanity baseline)\"\n" +
"python3 clm_v4_hf_format_shim.py \\\n" +
"    --input-pt \"$BEST_PT\" \\\n" +
"    --tokenizer-dir \"$TOK_DIR\" \\\n" +
"    --output-dir \"$OUT_NF\" \\\n" +
"    --verify --force-overwrite 2>&1 | tee v4_apply_nf.log | tail -20\n" +
"NF_RC=${PIPESTATUS[0]}\n" +
"echo \"[stageA-no-fixture] shim_nf_rc=$NF_RC\"\n" +
"\n" +
"# ── Stage B: F-SHIM-V4-3 — canonical_zero finite forward ──\n" +
"echo \"[stageB] F-SHIM-V4-3 finite forward smoketest\"\n" +
"python3 - <<'PYEOF' 2>&1 | tee $RESULTS/f_shim_v4_3.log\n" +
"import os, json, traceback\n" +
"out = {\"f_shim_v4_3\": \"FAIL\", \"finite_forward\": \"unknown\", \"shape\": None, \"err\": None}\n" +
"try:\n" +
"    import torch\n" +
"    from transformers import AutoModelForCausalLM\n" +
"    out_v4 = \"/workspace/p9_v4_exec/output_v4\"\n" +
"    m = AutoModelForCausalLM.from_pretrained(out_v4, trust_remote_code=True, torch_dtype=torch.float16)\n" +
"    # Bypass AutoTokenizer (CLM v4 SP tokenizer not directly compatible) — use raw int ids\n" +
"    # vocab_size=64000; pick safe range [10..50] to ensure valid token ids\n" +
"    ids = torch.arange(10, 42, dtype=torch.long).unsqueeze(0)  # [1, 32]\n" +
"    with torch.no_grad():\n" +
"        result = m(ids)\n" +
"    logits = result.logits if hasattr(result, \"logits\") else result[0]\n" +
"    finite = bool(torch.isfinite(logits).all().item())\n" +
"    shape = list(logits.shape)\n" +
"    out[\"shape\"] = shape\n" +
"    out[\"finite_forward\"] = \"finite\" if finite else \"non_finite\"\n" +
"    # F-SHIM-V4-3: finite + shape [1, T, 64000]\n" +
"    if finite and len(shape) == 3 and shape[0] == 1 and shape[2] == 64000:\n" +
"        out[\"f_shim_v4_3\"] = \"PASS\"\n" +
"    else:\n" +
"        out[\"f_shim_v4_3\"] = \"FAIL\"\n" +
"    # Inspect fixture meta\n" +
"    meta = getattr(m, \"_consciousness_fixture_meta\", None)\n" +
"    out[\"fixture_meta\"] = meta if meta is None or isinstance(meta, dict) else str(meta)\n" +
"    has_fix = getattr(m, \"_consciousness_fixture_cpu\", None) is not None\n" +
"    out[\"fixture_loaded\"] = bool(has_fix)\n" +
"except Exception as e:\n" +
"    out[\"err\"] = f\"{type(e).__name__}: {e}\"\n" +
"    out[\"trace\"] = traceback.format_exc()\n" +
"print(\"=== f_shim_v4_3_smoketest_result ===\")\n" +
"print(json.dumps(out, indent=2))\n" +
"with open(\"/workspace/p9_v4_exec/results/f_shim_v4_3_result.json\", \"w\") as f:\n" +
"    json.dump(out, f, indent=2)\n" +
"PYEOF\n" +
"\n" +
"# ── Stage C: train_avg harvest stub ──\n" +
"echo \"[stageC] train_avg harvest stub\"\n" +
"python3 - <<'PYEOF' 2>&1 | tee $RESULTS/train_avg_harvest.log\n" +
"import os, json, glob, traceback\n" +
"result = {\"harvest_via\": \"FAILED\", \"err\": None, \"shape\": None, \"sample_first10\": None}\n" +
"try:\n" +
"    import torch\n" +
"    # Approach (a): scan best.pt for consciousness_state_avg-like keys\n" +
"    best_pt_paths = glob.glob(os.path.expanduser(\n" +
"        \"~/.cache/huggingface/hub/models--dancinlab--clm-v4-base-mirror/snapshots/*/best.pt\"))\n" +
"    if best_pt_paths:\n" +
"        ckpt = torch.load(best_pt_paths[0], map_location=\"cpu\", weights_only=False)\n" +
"        keys = list(ckpt.keys()) if isinstance(ckpt, dict) else []\n" +
"        result[\"ckpt_top_keys\"] = keys[:30]\n" +
"        cand_keys = [k for k in keys if any(s in k.lower() for s in [\"consciousness_avg\", \"consciousness_state_avg\", \"cell_avg\", \"c_avg\"])]\n" +
"        result[\"approach_a_candidates\"] = cand_keys\n" +
"        if cand_keys:\n" +
"            t = ckpt[cand_keys[0]]\n" +
"            if hasattr(t, \"shape\"):\n" +
"                result[\"harvest_via\"] = \"best.pt extract\"\n" +
"                result[\"key_used\"] = cand_keys[0]\n" +
"                result[\"shape\"] = list(t.shape)\n" +
"                arr = t.detach().to(torch.float32).cpu().tolist()\n" +
"                result[\"sample_first10\"] = arr[0][0][:10] if isinstance(arr[0][0], list) else arr[:10]\n" +
"                # Save as fixture\n" +
"                if list(t.shape) == [1, 8, 192] or (len(t.shape) == 3 and t.shape[2] == 192):\n" +
"                    fixture = {\n" +
"                        \"states\": arr,\n" +
"                        \"shape\": list(t.shape),\n" +
"                        \"dtype\": \"float32\",\n" +
"                        \"source\": \"train_avg\",\n" +
"                        \"provenance\": f\"best.pt extract key={cand_keys[0]}\"\n" +
"                    }\n" +
"                    with open(\"/workspace/p9_v4_exec/results/train_avg_fixture.json\", \"w\") as f:\n" +
"                        json.dump(fixture, f)\n" +
"                    result[\"fixture_saved\"] = True\n" +
"\n" +
"    # Approach (b): synthetic stub (no model load needed — STUB only since approach (a) found no key)\n" +
"    if result[\"harvest_via\"] == \"FAILED\":\n" +
"        # Build a dummy [1, 8, 192] random-init avg as STUB (canonical_zero shifted by tiny noise)\n" +
"        # This is a pure stub — flag clearly\n" +
"        torch.manual_seed(42)\n" +
"        states = torch.randn(1, 8, 192, dtype=torch.float32) * 0.01\n" +
"        result[\"harvest_via\"] = \"forward-pass synthetic stub (random N(0,0.01) — NOT actual train avg)\"\n" +
"        result[\"shape\"] = list(states.shape)\n" +
"        arr = states.tolist()\n" +
"        result[\"sample_first10\"] = arr[0][0][:10]\n" +
"        fixture = {\n" +
"            \"states\": arr,\n" +
"            \"shape\": list(states.shape),\n" +
"            \"dtype\": \"float32\",\n" +
"            \"source\": \"train_avg\",\n" +
"            \"provenance\": \"BG-Σ stub — synthetic N(0, 0.01) since best.pt has no train_avg key; placeholder for future real harvest\"\n" +
"        }\n" +
"        with open(\"/workspace/p9_v4_exec/results/train_avg_fixture.json\", \"w\") as f:\n" +
"            json.dump(fixture, f)\n" +
"        result[\"fixture_saved\"] = True\n" +
"        result[\"stub_warning\"] = \"This is a SYNTHETIC stub. Real train_avg requires anima_unified.py runtime forward pass over training data with cell hidden harvest.\"\n" +
"except Exception as e:\n" +
"    result[\"err\"] = f\"{type(e).__name__}: {e}\"\n" +
"    result[\"trace\"] = traceback.format_exc()[:3000]\n" +
"print(\"=== train_avg_harvest_result ===\")\n" +
"print(json.dumps(result, indent=2)[:4000])\n" +
"with open(\"/workspace/p9_v4_exec/results/train_avg_harvest_result.json\", \"w\") as f:\n" +
"    json.dump(result, f, indent=2)\n" +
"PYEOF\n" +
"\n" +
"# ── Stage D: optional limit=100 hellaswag sanity (with vs without fixture) ──\n" +
"echo \"[stageD] limit=100 hellaswag sanity eval\"\n" +
"\n" +
"run_sanity() {\n" +
"    local label=$1\n" +
"    local model_dir=$2\n" +
"    local out=$RESULTS/sanity_${label}_dir\n" +
"    local log=$RESULTS/sanity_${label}.log\n" +
"    echo \"[sanity] label=$label model_dir=$model_dir\"\n" +
"    lm_eval --model hf \\\n" +
"        --model_args \"pretrained=${model_dir},dtype=bfloat16,trust_remote_code=True\" \\\n" +
"        --tasks hellaswag \\\n" +
"        --num_fewshot 0 \\\n" +
"        --batch_size 8 \\\n" +
"        --device cuda:0 \\\n" +
"        --seed 42 \\\n" +
"        --limit 100 \\\n" +
"        --output_path \"$out\" \\\n" +
"        > \"$log\" 2>&1 || echo \"[sanity] $label rc=$?\"\n" +
"    if [ -d \"$out\" ]; then\n" +
"        find \"$out\" -name 'results*.json' -exec cp {} $RESULTS/sanity_${label}.json \\;\n" +
"    fi\n" +
"}\n" +
"\n" +
"# Only run sanity if F-SHIM-V4-3 looked plausible (model loadable)\n" +
"V4_3_PASS=$(jq -r '.f_shim_v4_3 // \"FAIL\"' $RESULTS/f_shim_v4_3_result.json 2>/dev/null || echo FAIL)\n" +
"if [ \"$V4_3_PASS\" = \"PASS\" ]; then\n" +
"    run_sanity 'canonical_zero' \"$OUT_V4\"\n" +
"    run_sanity 'no_fixture' \"$OUT_NF\"\n" +
"else\n" +
"    echo \"[stageD] skipped — F-SHIM-V4-3 did not pass\"\n" +
"fi\n" +
"\n" +
"# ── Stage E: aggregate verdict ──\n" +
"echo \"[stageE] aggregate verdict\"\n" +
"python3 - <<'PYEOF' 2>&1 | tee $RESULTS/v4_aggregate.log\n" +
"import os, json\n" +
"R = \"/workspace/p9_v4_exec/results\"\n" +
"v = {\n" +
"    \"f_shim_v4_3\": \"UNKNOWN\",\n" +
"    \"f_shim_v4_4\": \"HARVEST_STUB_ONLY\",\n" +
"    \"finite_forward\": \"unknown\",\n" +
"    \"harvest_via\": \"FAILED\",\n" +
"    \"sanity_canonical_zero_hellaswag_acc\": None,\n" +
"    \"sanity_no_fixture_hellaswag_acc\": None,\n" +
"}\n" +
"# F-SHIM-V4-3\n" +
"p = os.path.join(R, \"f_shim_v4_3_result.json\")\n" +
"if os.path.isfile(p):\n" +
"    d = json.load(open(p))\n" +
"    v[\"f_shim_v4_3\"] = d.get(\"f_shim_v4_3\", \"UNKNOWN\")\n" +
"    v[\"finite_forward\"] = d.get(\"finite_forward\", \"unknown\")\n" +
"    v[\"f_shim_v4_3_shape\"] = d.get(\"shape\")\n" +
"    v[\"f_shim_v4_3_fixture_loaded\"] = d.get(\"fixture_loaded\")\n" +
"    v[\"f_shim_v4_3_err\"] = d.get(\"err\")\n" +
"# Harvest\n" +
"p = os.path.join(R, \"train_avg_harvest_result.json\")\n" +
"if os.path.isfile(p):\n" +
"    d = json.load(open(p))\n" +
"    v[\"harvest_via\"] = d.get(\"harvest_via\", \"FAILED\")\n" +
"    v[\"harvest_shape\"] = d.get(\"shape\")\n" +
"    v[\"harvest_stub_warning\"] = d.get(\"stub_warning\")\n" +
"# Sanity acc extract\n" +
"def grab_acc(path):\n" +
"    if not os.path.isfile(path):\n" +
"        return None\n" +
"    try:\n" +
"        d = json.load(open(path))\n" +
"        r = d.get(\"results\", {}).get(\"hellaswag\", {})\n" +
"        for k in (\"acc_norm,none\", \"acc_norm\", \"acc,none\", \"acc\"):\n" +
"            if k in r:\n" +
"                return float(r[k])\n" +
"    except Exception:\n" +
"        return None\n" +
"    return None\n" +
"v[\"sanity_canonical_zero_hellaswag_acc\"] = grab_acc(os.path.join(R, \"sanity_canonical_zero.json\"))\n" +
"v[\"sanity_no_fixture_hellaswag_acc\"] = grab_acc(os.path.join(R, \"sanity_no_fixture.json\"))\n" +
"print(json.dumps(v, indent=2))\n" +
"with open(os.path.join(R, \"v4_verdict.json\"), \"w\") as f:\n" +
"    json.dump(v, f, indent=2)\n" +
"PYEOF\n" +
"\n" +
"# completion sentinel — STANDARDIZED NAME per spec L1\n" +
"echo \"{\\\"ok\\\": true, \\\"finished_at\\\": \\\"$(date -u +%FT%TZ)\\\"}\" > $RESULTS/COMPLETE.sentinel\n" +
"echo \"[orch] complete\"\n"

    write_file(RUN_H100_PATH, run_h100)
    exec_with_status("chmod +x " + _sq(RUN_H100_PATH))
    println("[emit] " + RUN_H100_PATH)
    println("[emit] OK")
}

// ─── kill (emergency) ─────────────────────────────────────────────────────

fn _kill(pod_id: string) {
    if pod_id == "" {
        eprintln("ERROR: --kill requires <pod_id> argument")
        exit(1)
    }
    println("[kill] pod=" + pod_id)
    exec_with_status(_sq(RUNPODCTL) + " pod stop " + _sq(pod_id))
    exec_with_status("sleep 3")
    exec_with_status(_sq(RUNPODCTL) + " pod delete " + _sq(pod_id))
    let r = exec_with_status(_sq(RUNPODCTL) + " pod get " + _sq(pod_id) + " 2>&1 | head -3")
    println("[kill] post-status: " + to_string(r[0]).trim())
}

// ─── main ─────────────────────────────────────────────────────────────────

fn main() {
    let av = _argv()

    if _flag(av, "--selftest") {
        _selftest()
        return
    }
    if _flag(av, "--kill") {
        _kill(_opt(av, "--kill", ""))
        return
    }
    if _flag(av, "--emit") {
        _emit()
        return
    }
    if _flag(av, "--launch") {
        _emit()
        println("[launch] dispatching " + EXEC_BASH_PATH)
        let r = exec_with_status("bash " + _sq(EXEC_BASH_PATH))
        println("[launch] rc=" + to_string(r[1]))
        return
    }

    println("USAGE: hexa run tool/p9_opt_1_v4_exec_h100_orchestrator.hexa [--selftest|--emit|--launch|--kill <pod_id>]")
}

