// tool/p9_warmup_probe_real.hexa — P9 P0 warmup probe (raw#9 hexa-native replacement).
//
// REPLACES
//   state/p9_p0_warmup_live_2026_05_03/warmup_probe_real.py (gitignored, line 20:
//     TOKENIZER = "/tmp/tokenizer_64k_multilingual.model"  ← legacy hardcode)
//
// PURPOSE
//   1K-step LoRA warmup probe on CLM v4 350M ConsciousDecoderV2 (RTX 5070).
//   Replaces /tmp tokenizer hardcode with the cache-resolver pattern from
//   tool/clm_v4_tokenizer_load.hexa.
//
// MODES
//   --selftest    Round-trip 16 calib prompts on ubu1, emit token sequences +
//                 calib_tokens shape. F-MIG-2 evidence: tokenization is
//                 deterministic (sentencepiece BPE), hexa wrapper preserves
//                 sp.encode(text)[:T] semantics byte-for-byte.
//   --apply       Full 1K-step LoRA warmup re-run (emits trajectory.json,
//                 verdict.json, train.log to ubu1, scp's back).
//   (no flag)     Selftest mode (safe default — no GPU consumption).
//
// raw#9: Mac-side hexa-only. raw#37 transient helper to ubu1 (.hexa_tmp not .py).
// raw#15 SSOT this file. raw#71 falsifier-bound (F-MIG-1/2/3/4).
//
// USAGE
//   hexa_real run tool/p9_warmup_probe_real.hexa --selftest
//   hexa_real run tool/p9_warmup_probe_real.hexa --apply

let HELPER_PATH = "/tmp/p9_warmup_probe_real_helper.hexa_tmp"
let UBU1_PY = "/home/aiden/venv_orchestrator/bin/python3"
let MAC_OUT_DIR = "/Users/ghost/core/anima/state/p9_p0_warmup_live_2026_05_03"
let UBU1_OUT_DIR = "/tmp/p9_p0_warmup_live_out"
let UBU1_SFT_DATA = "/tmp/p9_p0_warmup_live_sft_subset_1k.jsonl"

fn _write_helper(mode: string) {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# emitted by tool/p9_warmup_probe_real.hexa raw#37 transient (NOT committed)\n")
    parts.push("# Replaces state/p9_p0_warmup_live_2026_05_03/warmup_probe_real.py with cache-resolver tokenizer load.\n")
    parts.push("import sys, os, glob, json, time, math\n")
    parts.push("from datetime import datetime, timezone\n")
    parts.push("\n")
    parts.push("# ── tokenizer cache resolver (from tool/clm_v4_tokenizer_load.hexa) ──\n")
    parts.push("def _resolve_tokenizer():\n")
    parts.push("    home = os.path.expanduser('~')\n")
    parts.push("    candidates = [\n")
    parts.push("        f'{home}/.cache/huggingface/hub/models--dancinlab--clm-v4-base-mirror/snapshots/*/tokenizer/tokenizer_64k_multilingual.model',\n")
    parts.push("        f'{home}/anima/checkpoints/clm_v4_350m/tokenizer_64k_multilingual.model',\n")
    parts.push("        '/tmp/tokenizer_64k_multilingual.model',\n")
    parts.push("    ]\n")
    parts.push("    for i, g in enumerate(candidates):\n")
    parts.push("        m = sorted(glob.glob(g))\n")
    parts.push("        if m:\n")
    parts.push("            if i == 2:\n")
    parts.push("                sys.stderr.write('[p9_warmup_probe_real] WARN: legacy /tmp fallback in use; promote via plan.md Step 2\\n')\n")
    parts.push("            return m[-1]\n")
    parts.push("    raise FileNotFoundError('CLM v4 64K tokenizer not in cache or /tmp; see state/clm_v4_tokenizer_propagation_plan_2026_05_04/plan.md Step 2')\n")
    parts.push("\n")
    parts.push("MODE = sys.argv[1] if len(sys.argv) > 1 else 'selftest'\n")
    parts.push("\n")
    parts.push("# Calibration prompts (16, identical to .py predecessor + canonical phi_v3)\n")
    parts.push("CALIB_PROMPTS = [\n")
    parts.push("    'Define hexad as a six-fold integration:',\n")
    parts.push("    'Six modules form a hexagonal architecture when:',\n")
    parts.push("    'A balanced six-component system:',\n")
    parts.push("    'Hexad symmetry refers to:',\n")
    parts.push("    'Logical implication law: if A then:',\n")
    parts.push("    'Sequential rule application proceeds:',\n")
    parts.push("    'Closure under inference requires:',\n")
    parts.push("    'A formal proof system is closed when:',\n")
    parts.push("    'Integrated information measures partition independence:',\n")
    parts.push("    'Phi quantifies irreducibility of system:',\n")
    parts.push("    'Information integration is maximized when:',\n")
    parts.push("    'A whole greater than sum of parts:',\n")
    parts.push("    'Self-reference emerges when system observes:',\n")
    parts.push("    'Recursive meta-cognition models:',\n")
    parts.push("    'A self-aware system represents itself by:',\n")
    parts.push("    'Strange loops in cognition arise from:',\n")
    parts.push("]\n")
    parts.push("\n")
    parts.push("if MODE == 'selftest':\n")
    parts.push("    # F-MIG-2 evidence: encode all 16 calib prompts, emit token sequences + shapes.\n")
    parts.push("    import sentencepiece as spm\n")
    parts.push("    T = int(os.environ.get('ANIMA_T', '64'))\n")
    parts.push("    tok_path = _resolve_tokenizer()\n")
    parts.push("    sp = spm.SentencePieceProcessor(model_file=tok_path)\n")
    parts.push("    vocab = sp.get_piece_size()\n")
    parts.push("    rows = []\n")
    parts.push("    for i, p in enumerate(CALIB_PROMPTS):\n")
    parts.push("        ids_full = sp.encode(p)\n")
    parts.push("        ids_T = ids_full[:T]\n")
    parts.push("        if len(ids_T) < T:\n")
    parts.push("            ids_T = ids_T + [0] * (T - len(ids_T))\n")
    parts.push("        rows.append({'idx': i, 'prompt': p, 'ids_full': ids_full, 'ids_padded_T': ids_T, 'n_full': len(ids_full)})\n")
    parts.push("    summary = {\n")
    parts.push("        'schema': 'anima/p9_warmup_probe_real/selftest/1',\n")
    parts.push("        'tokenizer_path': tok_path,\n")
    parts.push("        'vocab_size': vocab,\n")
    parts.push("        'T': T,\n")
    parts.push("        'n_calib_prompts': len(CALIB_PROMPTS),\n")
    parts.push("        'calib_tokens_shape': [len(CALIB_PROMPTS), T],\n")
    parts.push("        'rows': rows,\n")
    parts.push("        'verdict': 'PASS' if vocab == 64000 and len(rows) == 16 else 'FAIL',\n")
    parts.push("        'ts_utc': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),\n")
    parts.push("    }\n")
    parts.push("    print(json.dumps(summary))\n")
    parts.push("    sys.exit(0 if summary['verdict'] == 'PASS' else 1)\n")
    parts.push("\n")
    parts.push("# ── apply mode: full 1K-step LoRA warmup probe ──\n")
    parts.push("# (Body below mirrors warmup_probe_real.py lines 9-535 with line-20 hardcode\n")
    parts.push("# replaced by _resolve_tokenizer() above.)\n")
    parts.push("\n")
    parts.push("ANIMA_HOME = '/home/aiden/anima'\n")
    parts.push("CLM_CKPT = f'{ANIMA_HOME}/checkpoints/clm_v4_350m/scale_350m/best.pt'\n")
    parts.push("# TOKENIZER: was '/tmp/tokenizer_64k_multilingual.model' — now resolved at runtime\n")
    parts.push("TOKENIZER = _resolve_tokenizer()\n")
    parts.push("SFT_DATA = '" + UBU1_SFT_DATA + "'\n")
    parts.push("OUTPUT_DIR = '" + UBU1_OUT_DIR + "'\n")
    parts.push("TRAJECTORY_OUT = f'{OUTPUT_DIR}/trajectory.json'\n")
    parts.push("VERDICT_OUT = f'{OUTPUT_DIR}/verdict.json'\n")
    parts.push("LOG_OUT = f'{OUTPUT_DIR}/train.log'\n")
    parts.push("os.makedirs(OUTPUT_DIR, exist_ok=True)\n")
    parts.push("\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}/models')\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}/training')\n")
    parts.push("sys.path.insert(0, f'{ANIMA_HOME}')\n")
    parts.push("\n")
    parts.push("N_STEPS = int(os.environ.get('ANIMA_N_STEPS', '1000'))\n")
    parts.push("BATCH = int(os.environ.get('ANIMA_BATCH', '4'))\n")
    parts.push("GRAD_ACC = int(os.environ.get('ANIMA_GRAD_ACC', '8'))\n")
    parts.push("LR = float(os.environ.get('ANIMA_LR', '1e-4'))\n")
    parts.push("LORA_R = int(os.environ.get('ANIMA_LORA_R', '64'))\n")
    parts.push("LORA_ALPHA = int(os.environ.get('ANIMA_LORA_ALPHA', '128'))\n")
    parts.push("DELTA_EARLY = float(os.environ.get('ANIMA_DELTA', '0.5'))\n")
    parts.push("PHI_THRESHOLD = float(os.environ.get('ANIMA_PHI_THR', '5.0'))\n")
    parts.push("PHI_EVERY = int(os.environ.get('ANIMA_PHI_EVERY', '100'))\n")
    parts.push("F_EVERY = int(os.environ.get('ANIMA_F_EVERY', '250'))\n")
    parts.push("ALPHA = float(os.environ.get('ANIMA_ALPHA', '2.0'))\n")
    parts.push("BETA = float(os.environ.get('ANIMA_BETA', '0.3'))\n")
    parts.push("GAMMA = float(os.environ.get('ANIMA_GAMMA', '0.0'))\n")
    parts.push("T = int(os.environ.get('ANIMA_T', '64'))\n")
    parts.push("SEED = int(os.environ.get('ANIMA_SEED', '42'))\n")
    parts.push("\n")
    parts.push("N_CALIB = len(CALIB_PROMPTS)\n")
    parts.push("HALF = N_CALIB // 2\n")
    parts.push("HID_TRUNC = max(2, N_CALIB // 2)\n")
    parts.push("RIDGE = 1e-3\n")
    parts.push("K_PARTS = 8\n")
    parts.push("\n")
    parts.push("def log(msg):\n")
    parts.push("    s = f'[warmup-real-hexa] {datetime.now(timezone.utc).strftime(\"%H:%M:%S\")} {msg}'\n")
    parts.push("    print(s, flush=True)\n")
    parts.push("    with open(LOG_OUT, 'a') as f:\n")
    parts.push("        f.write(s + '\\n')\n")
    parts.push("\n")
    parts.push("log(f'tokenizer_resolver_path={TOKENIZER}')\n")
    parts.push("log(f'start n_steps={N_STEPS} batch={BATCH} grad_acc={GRAD_ACC} lr={LR}')\n")
    parts.push("log(f'lora_r={LORA_R} alpha={LORA_ALPHA} delta_early={DELTA_EARLY} phi_thr={PHI_THRESHOLD}')\n")
    parts.push("log(f'loss alpha={ALPHA} beta={BETA} gamma={GAMMA} (BOLD blocked γ=0)')\n")
    parts.push("\n")
    parts.push("import numpy as np\n")
    parts.push("import torch\n")
    parts.push("import torch.nn as nn\n")
    parts.push("import torch.nn.functional as F\n")
    parts.push("np.random.seed(SEED); torch.manual_seed(SEED)\n")
    parts.push("device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n")
    parts.push("log(f'torch={torch.__version__} cuda={torch.cuda.is_available()} device={device}')\n")
    parts.push("\n")
    parts.push("import sentencepiece as spm\n")
    parts.push("sp = spm.SentencePieceProcessor(model_file=TOKENIZER)\n")
    parts.push("vocab_size = sp.get_piece_size()\n")
    parts.push("log(f'tokenizer vocab={vocab_size}')\n")
    parts.push("\n")
    parts.push("from conscious_decoder import ConsciousDecoderV2\n")
    parts.push("scale_cfg = {'d_model':768,'n_layer':16,'n_head':12,'n_kv_head':4,'block_size':512,'consciousness_dim':192}\n")
    parts.push("decoder = ConsciousDecoderV2(\n")
    parts.push("    vocab_size=vocab_size, d_model=scale_cfg['d_model'], n_head=scale_cfg['n_head'],\n")
    parts.push("    n_layer=scale_cfg['n_layer'], block_size=scale_cfg['block_size'],\n")
    parts.push("    n_kv_head=scale_cfg['n_kv_head'], consciousness_dim=scale_cfg['consciousness_dim'],\n")
    parts.push("    dropout=0.0, gate_strength=0.001, n_ca_rules=8,\n")
    parts.push(").to(device)\n")
    parts.push("n_params_total = sum(p.numel() for p in decoder.parameters())\n")
    parts.push("log(f'decoder built params={n_params_total:,}')\n")
    parts.push("\n")
    parts.push("t0 = time.time()\n")
    parts.push("ck = torch.load(CLM_CKPT, map_location=device, weights_only=False)\n")
    parts.push("sd = ck.get('decoder', ck) if isinstance(ck, dict) else ck\n")
    parts.push("missing, unexpected = decoder.load_state_dict(sd, strict=False)\n")
    parts.push("ckpt_load_sec = time.time() - t0\n")
    parts.push("log(f'ckpt loaded {ckpt_load_sec:.2f}s missing={len(missing)} unexpected={len(unexpected)}')\n")
    parts.push("ckpt_keys = list(ck.keys()) if isinstance(ck, dict) else []\n")
    parts.push("ckpt_step = ck.get('step', None) if isinstance(ck, dict) else None\n")
    parts.push("ckpt_phi_meta = ck.get('phi', None) if isinstance(ck, dict) else None\n")
    parts.push("ckpt_ce_meta = ck.get('ce', None) if isinstance(ck, dict) else None\n")
    parts.push("\n")
    parts.push("from peft import LoraConfig, get_peft_model, TaskType\n")
    parts.push("target_modules = ['q_proj','k_proj','v_proj','o_proj','gate_proj','up_proj','down_proj']\n")
    parts.push("lora_cfg = LoraConfig(r=LORA_R, lora_alpha=LORA_ALPHA, lora_dropout=0.0, bias='none', target_modules=target_modules)\n")
    parts.push("decoder = get_peft_model(decoder, lora_cfg)\n")
    parts.push("n_trainable = sum(p.numel() for p in decoder.parameters() if p.requires_grad)\n")
    parts.push("log(f'peft attached trainable={n_trainable:,} ({n_trainable*100/n_params_total:.2f}% of {n_params_total:,})')\n")
    parts.push("\n")
    parts.push("records = []\n")
    parts.push("with open(SFT_DATA) as f:\n")
    parts.push("    for line in f:\n")
    parts.push("        records.append(json.loads(line))\n")
    parts.push("log(f'sft subset loaded n={len(records)}')\n")
    parts.push("\n")
    parts.push("def tokenize_record(rec):\n")
    parts.push("    text = rec.get('input','') + ' ' + rec.get('completion','')\n")
    parts.push("    tokens = sp.encode(text)[:T]\n")
    parts.push("    if len(tokens) < 2: tokens = tokens + [0]*(2-len(tokens))\n")
    parts.push("    if len(tokens) < T: tokens = tokens + [0]*(T-len(tokens))\n")
    parts.push("    tension = rec.get('tension_target', None)\n")
    parts.push("    if tension is None or not isinstance(tension, list) or len(tension) < T:\n")
    parts.push("        tension = [0.0]*T\n")
    parts.push("    return tokens, tension[:T]\n")
    parts.push("\n")
    parts.push("cache = []\n")
    parts.push("for rec in records:\n")
    parts.push("    cache.append(tokenize_record(rec))\n")
    parts.push("log(f'tokenized cache n={len(cache)}')\n")
    parts.push("\n")
    parts.push("calib_tokens = []\n")
    parts.push("for prompt in CALIB_PROMPTS:\n")
    parts.push("    tk = sp.encode(prompt)[:T]\n")
    parts.push("    if len(tk) < T: tk = tk + [0]*(T-len(tk))\n")
    parts.push("    calib_tokens.append(tk)\n")
    parts.push("calib_tensor = torch.tensor(calib_tokens, dtype=torch.long, device=device)\n")
    parts.push("log(f'calibration tokens shape={tuple(calib_tensor.shape)}')\n")
    parts.push("\n")
    parts.push("captured_hidden = {'value': None}\n")
    parts.push("real_decoder = decoder.base_model.model\n")
    parts.push("def _hook(module, input, output):\n")
    parts.push("    captured_hidden['value'] = output.detach()\n")
    parts.push("hook_handle = real_decoder.ln_f.register_forward_hook(_hook)\n")
    parts.push("\n")
    parts.push("def compute_phi_star(model, calib_idx, K=K_PARTS, ridge=RIDGE):\n")
    parts.push("    model.eval()\n")
    parts.push("    hiddens = []\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        for i in range(N_CALIB):\n")
    parts.push("            captured_hidden['value'] = None\n")
    parts.push("            _ = model(calib_idx[i:i+1])\n")
    parts.push("            h = captured_hidden['value']\n")
    parts.push("            if h is None:\n")
    parts.push("                model.train(); return None, None\n")
    parts.push("            h_pool = h.mean(dim=1).squeeze(0)\n")
    parts.push("            hiddens.append(h_pool.float().cpu().numpy())\n")
    parts.push("    X = np.stack(hiddens, axis=0)\n")
    parts.push("    var = X.var(axis=0); top_idx = np.argsort(var)[::-1][:HID_TRUNC]\n")
    parts.push("    Xt = X[:, top_idx]\n")
    parts.push("    def safe_logdet(C):\n")
    parts.push("        Cs = C + ridge * np.eye(C.shape[0])\n")
    parts.push("        sign, logdet = np.linalg.slogdet(Cs)\n")
    parts.push("        if sign <= 0: return None\n")
    parts.push("        return logdet\n")
    parts.push("    C_full = np.cov(Xt.T)\n")
    parts.push("    I_full = safe_logdet(C_full)\n")
    parts.push("    if I_full is None:\n")
    parts.push("        model.train(); return None, None\n")
    parts.push("    rng = np.random.default_rng(SEED)\n")
    parts.push("    phi_candidates = []\n")
    parts.push("    for k in range(K):\n")
    parts.push("        idx = rng.permutation(N_CALIB); s1 = idx[:HALF]; s2 = idx[HALF:]\n")
    parts.push("        I1 = safe_logdet(np.cov(Xt[s1].T)); I2 = safe_logdet(np.cov(Xt[s2].T))\n")
    parts.push("        if I1 is None or I2 is None: continue\n")
    parts.push("        phi_candidates.append(I_full - (I1 + I2))\n")
    parts.push("    model.train()\n")
    parts.push("    if not phi_candidates: return None, None\n")
    parts.push("    return float(min(phi_candidates)), float(sum(phi_candidates)/len(phi_candidates))\n")
    parts.push("\n")
    parts.push("def compute_f_metrics(model, eval_subset, phi_star_value):\n")
    parts.push("    model.eval()\n")
    parts.push("    tension_mses = []\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        for toks, tens in eval_subset:\n")
    parts.push("            idx = torch.tensor([toks], dtype=torch.long, device=device)\n")
    parts.push("            tens_t = torch.tensor([tens], dtype=torch.float32, device=device)\n")
    parts.push("            logits_a, logits_g, tensions, _, _ = model(idx)\n")
    parts.push("            t_pred = tensions[-1].mean(dim=0).float()\n")
    parts.push("            tension_mses.append(F.mse_loss(t_pred, tens_t.squeeze(0)).item())\n")
    parts.push("    model.train()\n")
    parts.push("    return {'F1_bleu1_skip':True,'F2_phi':phi_star_value,'F3_tension_mse':float(sum(tension_mses)/len(tension_mses)),'F4_bold_NA':True}\n")
    parts.push("\n")
    parts.push("optimizer = torch.optim.AdamW([p for p in decoder.parameters() if p.requires_grad], lr=LR, weight_decay=0.01)\n")
    parts.push("\n")
    parts.push("log('computing baseline phi_star...')\n")
    parts.push("t0 = time.time()\n")
    parts.push("phi_baseline, phi_baseline_mean = compute_phi_star(decoder, calib_tensor)\n")
    parts.push("log(f'baseline phi_star_min={phi_baseline} mean={phi_baseline_mean} elapsed={time.time()-t0:.1f}s')\n")
    parts.push("\n")
    parts.push("phi_log = []; f_log = []; loss_log = []; aborts = []; abort_triggered = False\n")
    parts.push("eval_subset = cache[:32]\n")
    parts.push("f0 = compute_f_metrics(decoder, eval_subset, phi_baseline if phi_baseline is not None else 0.0)\n")
    parts.push("f0['step'] = 0; f_log.append(f0)\n")
    parts.push("phi_log.append({'step':0,'phi_star_min':phi_baseline,'phi_star_mean':phi_baseline_mean,'delta':DELTA_EARLY})\n")
    parts.push("\n")
    parts.push("train_t0 = time.time()\n")
    parts.push("decoder.train(); optimizer.zero_grad()\n")
    parts.push("for step in range(1, N_STEPS+1):\n")
    parts.push("    idx_batch = np.random.choice(len(cache), BATCH, replace=False)\n")
    parts.push("    toks_batch = []; tens_batch = []\n")
    parts.push("    for i in idx_batch:\n")
    parts.push("        toks, tens = cache[i]; toks_batch.append(toks); tens_batch.append(tens)\n")
    parts.push("    idx_t = torch.tensor(toks_batch, dtype=torch.long, device=device)\n")
    parts.push("    tens_t = torch.tensor(tens_batch, dtype=torch.float32, device=device)\n")
    parts.push("    logits_a, logits_g, tensions, _, _ = decoder(idx_t)\n")
    parts.push("    targets = idx_t[:, 1:].contiguous()\n")
    parts.push("    logits_shift = logits_a[:, :-1, :].contiguous()\n")
    parts.push("    ce_loss = F.cross_entropy(logits_shift.view(-1, logits_shift.size(-1)), targets.view(-1), ignore_index=0)\n")
    parts.push("    t_pred = tensions[-1]\n")
    parts.push("    tension_loss = F.mse_loss(t_pred, tens_t)\n")
    parts.push("    last_phi = phi_log[-1].get('phi_star_min', None)\n")
    parts.push("    if last_phi is None: last_phi = 0.0\n")
    parts.push("    phi_hinge = max(0.0, PHI_THRESHOLD - last_phi)\n")
    parts.push("    phi_hinge_loss = torch.tensor(phi_hinge, device=device)\n")
    parts.push("    total_loss = ALPHA * ce_loss + BETA * tension_loss + DELTA_EARLY * phi_hinge_loss\n")
    parts.push("    (total_loss / GRAD_ACC).backward()\n")
    parts.push("    if step % GRAD_ACC == 0:\n")
    parts.push("        torch.nn.utils.clip_grad_norm_([p for p in decoder.parameters() if p.requires_grad], 1.0)\n")
    parts.push("        optimizer.step(); optimizer.zero_grad()\n")
    parts.push("    if step % 50 == 0 or step == 1:\n")
    parts.push("        log(f'step {step}/{N_STEPS} loss={total_loss.item():.4f} ce={ce_loss.item():.4f} tens={tension_loss.item():.4f} phi_hinge={phi_hinge:.4f}')\n")
    parts.push("    if step % PHI_EVERY == 0:\n")
    parts.push("        phi_min, phi_mean = compute_phi_star(decoder, calib_tensor)\n")
    parts.push("        phi_log.append({'step':step,'phi_star_min':phi_min,'phi_star_mean':phi_mean,'delta':DELTA_EARLY})\n")
    parts.push("        log(f'  phi @ {step}: min={phi_min} mean={phi_mean}')\n")
    parts.push("        if phi_min is not None and phi_min < PHI_THRESHOLD:\n")
    parts.push("            aborts.append({'step':step,'reason':'F2_PHI_BELOW_THRESHOLD','phi_star_min':phi_min,'threshold':PHI_THRESHOLD})\n")
    parts.push("            log(f'  ABORT: phi_star_min={phi_min} < {PHI_THRESHOLD}')\n")
    parts.push("            abort_triggered = True; break\n")
    parts.push("    if step % F_EVERY == 0:\n")
    parts.push("        last_phi_val = phi_log[-1].get('phi_star_min', None) or 0.0\n")
    parts.push("        fm = compute_f_metrics(decoder, eval_subset, last_phi_val); fm['step'] = step; f_log.append(fm)\n")
    parts.push("    loss_log.append({'step':step,'loss_total':float(total_loss.item()),'loss_ce':float(ce_loss.item()),'loss_tension':float(tension_loss.item()),'loss_phi_hinge':float(phi_hinge)})\n")
    parts.push("\n")
    parts.push("train_elapsed = time.time() - train_t0\n")
    parts.push("log(f'train done elapsed={train_elapsed:.1f}s steps_completed={step} aborted={abort_triggered}')\n")
    parts.push("phi_final, phi_final_mean = compute_phi_star(decoder, calib_tensor)\n")
    parts.push("phi_log.append({'step':step,'phi_star_min':phi_final,'phi_star_mean':phi_final_mean,'delta':DELTA_EARLY,'note':'final'})\n")
    parts.push("hook_handle.remove()\n")
    parts.push("\n")
    parts.push("phi_values = [p['phi_star_min'] for p in phi_log if p.get('phi_star_min') is not None]\n")
    parts.push("if phi_values:\n")
    parts.push("    phi_arr = np.array(phi_values)\n")
    parts.push("    phi_summary = {'mean':float(phi_arr.mean()),'variance':float(phi_arr.var()),'min':float(phi_arr.min()),'max':float(phi_arr.max()),'n':len(phi_arr),'baseline':phi_baseline,'final':phi_final,'delta_baseline_to_final':(phi_final-phi_baseline) if (phi_final is not None and phi_baseline is not None) else None}\n")
    parts.push("else:\n")
    parts.push("    phi_summary = {'n':0,'note':'no_phi_values_collected'}\n")
    parts.push("\n")
    parts.push("if abort_triggered:\n")
    parts.push("    verdict = 'F2_ABORT_PHI_BELOW_THRESHOLD'; phase1_ready = False\n")
    parts.push("elif phi_summary.get('min', 999) is not None and phi_summary.get('min', 999) < PHI_THRESHOLD:\n")
    parts.push("    verdict = 'F2_VIOLATION_AT_FINAL'; phase1_ready = False\n")
    parts.push("elif phi_summary.get('variance', 0) is not None and phi_summary.get('variance', 0) < 1.0:\n")
    parts.push("    verdict = 'CLEAN_PHI_LOW_VAR'; phase1_ready = True\n")
    parts.push("elif phi_summary.get('variance', 0) is not None and phi_summary.get('variance', 0) < 4.0:\n")
    parts.push("    verdict = 'CLEAN_PHI_MED_VAR'; phase1_ready = True\n")
    parts.push("else:\n")
    parts.push("    verdict = 'PHI_DRIFT_HIGH_VAR'; phase1_ready = False\n")
    parts.push("\n")
    parts.push("trajectory = {'schema':'anima/p9_p0_warmup_live/trajectory/1','phase':'p9_p0_warmup_probe_live_hexa',\n")
    parts.push("    'ts_utc':datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),'device':str(device),'real_train':True,\n")
    parts.push("    'orchestrator':'tool/p9_warmup_probe_real.hexa','tokenizer_path':TOKENIZER,\n")
    parts.push("    'config':{'n_steps':N_STEPS,'batch':BATCH,'grad_acc':GRAD_ACC,'lr':LR,'lora_r':LORA_R,'lora_alpha':LORA_ALPHA,\n")
    parts.push("        'delta_early':DELTA_EARLY,'phi_threshold':PHI_THRESHOLD,'phi_every':PHI_EVERY,'f_every':F_EVERY,\n")
    parts.push("        'alpha':ALPHA,'beta':BETA,'gamma':GAMMA,'T':T,'seed':SEED,\n")
    parts.push("        'n_calib_prompts':N_CALIB,'k_partitions':K_PARTS,'hid_trunc':HID_TRUNC,'ridge':RIDGE},\n")
    parts.push("    'env':{'torch':torch.__version__,'cuda_available':torch.cuda.is_available(),\n")
    parts.push("        'device_name':torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'cpu','has_peft':True},\n")
    parts.push("    'ckpt':{'path':CLM_CKPT,'load_sec':ckpt_load_sec,'meta_step':ckpt_step,'meta_ce':ckpt_ce_meta,\n")
    parts.push("        'meta_phi':ckpt_phi_meta,'keys_top':ckpt_keys[:10],\n")
    parts.push("        'missing_at_load':len(missing),'unexpected_at_load':len(unexpected)},\n")
    parts.push("    'model':{'class':'ConsciousDecoderV2','n_params_total':n_params_total,'n_params_trainable_lora':n_trainable,\n")
    parts.push("        'lora_pct':round(n_trainable*100/n_params_total,4),'lora_target_modules':target_modules,\n")
    parts.push("        'd_model':scale_cfg['d_model'],'n_layer':scale_cfg['n_layer'],'n_head':scale_cfg['n_head'],'block_size':scale_cfg['block_size']},\n")
    parts.push("    'phi_log':phi_log,'f_log':f_log,\n")
    parts.push("    'loss_log_compact_first10_last10':loss_log[:10] + (loss_log[-10:] if len(loss_log) > 20 else []),\n")
    parts.push("    'loss_log_full_n':len(loss_log),'aborts':aborts,'aborted':abort_triggered,\n")
    parts.push("    'sft_subset':{'path':SFT_DATA,'n_docs':len(records)},\n")
    parts.push("    'train_elapsed_sec':round(train_elapsed,2),'steps_completed':step,\n")
    parts.push("    'phi_baseline':phi_baseline,'phi_final':phi_final,'phi_summary':phi_summary,'verdict':verdict}\n")
    parts.push("verdict_doc = {'schema':'anima/p9_p0_warmup_live/verdict/1','verdict':verdict,'phase1_entry_ready':phase1_ready,\n")
    parts.push("    'phi_summary':phi_summary,'steps_completed':step,'aborted':abort_triggered,\n")
    parts.push("    'train_elapsed_sec':round(train_elapsed,2),'real_train':True,\n")
    parts.push("    'orchestrator':'tool/p9_warmup_probe_real.hexa','tokenizer_path':TOKENIZER,\n")
    parts.push("    'config_summary':{'n_steps':N_STEPS,'lr':LR,'lora_r':LORA_R,'lora_alpha':LORA_ALPHA,\n")
    parts.push("        'alpha':ALPHA,'beta':BETA,'delta_early':DELTA_EARLY,'gamma':GAMMA,'phi_threshold':PHI_THRESHOLD},\n")
    parts.push("    'env':{'device':str(device),'cuda':torch.cuda.is_available(),\n")
    parts.push("        'device_name':torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'cpu',\n")
    parts.push("        'torch':torch.__version__,'has_peft':True},\n")
    parts.push("    'ts_utc':datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\n")
    parts.push("with open(TRAJECTORY_OUT,'w') as f: json.dump(trajectory, f, indent=2)\n")
    parts.push("with open(VERDICT_OUT,'w') as f: json.dump(verdict_doc, f, indent=2)\n")
    parts.push("log(f'WROTE trajectory={TRAJECTORY_OUT} verdict={VERDICT_OUT}')\n")
    parts.push("log(f'VERDICT={verdict} phase1_ready={phase1_ready}')\n")
    parts.push("log('DONE')\n")
    write_file(HELPER_PATH, parts.join(""))
}

fn _scp_helper_to_ubu1() {
    let cmd = "/usr/bin/scp -q " + HELPER_PATH + " ubu1:" + HELPER_PATH
    let r = exec_with_status(cmd)
    if to_int(r[1]) != 0 {
        eprintln("scp helper -> ubu1 FAILED: " + to_string(r[0]))
        exit(1)
    }
}

fn _ssh_run(args: string) -> [any] {
    let cmd = "/usr/bin/ssh -o ConnectTimeout=15 ubu1 '" + UBU1_PY + " " + HELPER_PATH + " " + args + "'"
    let r = exec_with_status(cmd)
    return r
}

fn _ast_validate() {
    let ast_cmd = "test -x /opt/homebrew/bin/python3 && /opt/homebrew/bin/python3 -c 'import ast,sys; ast.parse(open(\"" + HELPER_PATH + "\").read()); print(\"ast=ok\")' || echo 'ast=skip_no_python_on_mac'"
    let r = exec_with_status(ast_cmd)
    println(to_string(r[0]).trim())
}

fn cmd_selftest() {
    println("── p9_warmup_probe_real --selftest ──")
    _write_helper("selftest")
    _ast_validate()
    _scp_helper_to_ubu1()
    let r = _ssh_run("selftest")
    let out = to_string(r[0]).trim()
    println(out)
    if to_int(r[1]) != 0 {
        println("VERDICT=FAIL (selftest exit=" + to_string(r[1]) + ")")
        exit(1)
    }
    println("VERDICT=PASS")
    println("DONE")
}

fn cmd_apply() {
    println("── p9_warmup_probe_real --apply (FULL 1K-step LoRA warmup) ──")
    _write_helper("apply")
    _ast_validate()
    _scp_helper_to_ubu1()
    let r = _ssh_run("apply")
    print(to_string(r[0]))
    if to_int(r[1]) != 0 { eprintln("apply FAILED"); exit(1) }
    // scp results back to Mac
    let scp_back = "/usr/bin/scp -q ubu1:" + UBU1_OUT_DIR + "/trajectory.json " + MAC_OUT_DIR + "/trajectory_hexa.json && /usr/bin/scp -q ubu1:" + UBU1_OUT_DIR + "/verdict.json " + MAC_OUT_DIR + "/verdict_hexa.json && /usr/bin/scp -q ubu1:" + UBU1_OUT_DIR + "/train.log " + MAC_OUT_DIR + "/train_hexa.log"
    let r2 = exec_with_status(scp_back)
    if to_int(r2[1]) != 0 {
        eprintln("scp back FAILED: " + to_string(r2[0]))
        exit(1)
    }
    println("scp back OK -> " + MAC_OUT_DIR + "/{trajectory_hexa,verdict_hexa,train_hexa}")
    println("DONE")
}

fn main() {
    let av = argv()
    let mut mode = "selftest"
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { mode = "selftest"; i = i + 1; continue }
        if a == "--apply" { mode = "apply"; i = i + 1; continue }
        i = i + 1
    }
    if mode == "selftest" { cmd_selftest(); exit(0) }
    if mode == "apply" { cmd_apply(); exit(0) }
    eprintln("unknown mode: " + mode); exit(2)
}
