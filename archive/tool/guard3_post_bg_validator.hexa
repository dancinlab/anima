// tool/guard3_post_bg_validator.hexa — GUARD-3 success-signal checklist post-BG validator (emitter).
//
// PURPOSE
//   Implements GUARD-3 from docs/cleanup_bg_side_effect_audit_2026_05_03.md as a
//   STANDALONE post-hoc validator. Inspects a BG run's claim ("completed",
//   "PID gone", "naturally finished", etc.) and cross-checks against on-disk
//   evidence (verdict.json, train.log, savepoints, exit code). Emits one of:
//     - PASS         (positive signal present AND zero failure signals)
//     - FAIL         (one or more failure signals present)
//     - INDETERMINATE (claim unverifiable: missing positive signal AND no
//                      explicit failure signal — mandates manual inspection)
//
//   Per feedback_cleanup_bg_guards.md rule (2): PID-absent is NOT success
//   without ≥1 positive signal AND zero failure signals.
//
// SCOPE / NON-GOALS
//   - This is a STANDALONE tool only — does NOT modify the harness, does NOT
//     auto-inject itself into BG launch templates. Harness hook integration is
//     deferred to a later cycle (see caveat §3).
//   - Runs on Mac (raw#9 STRICT — emits a transient python helper to /tmp;
//     no .py files persist in the repo).
//   - $0 (mac-local read of disk artifacts only; no GPU, no API, no pod).
//
// HEXA-SHAPE
//   This .hexa is an EMITTER (matches tool/anima_local_system_background_auditor.hexa
//   pattern). It writes a transient python helper to /tmp and prints the
//   invocation command. Callers run the helper via `python3 <helper>`. The
//   hexa-resolver routes `--selftest` via darwin-bypass (mac-local), where
//   exec_with_status() to a child python is NOT reliable; consequently the
//   selftest only verifies emitter output and helper-file presence. End-to-end
//   smoke tests run the helper directly from the calling shell (see USAGE).
//
// USAGE
//   # 1. emit the python helper to /tmp (idempotent)
//   hexa run tool/guard3_post_bg_validator.hexa --emit
//   # → writes /tmp/guard3_post_bg_validator_helper.hexa_tmp
//
//   # 2. invoke the helper directly
//   python3 /tmp/guard3_post_bg_validator_helper.hexa_tmp \
//       --bg-claim "PID 1726340 gone, naturally completed" \
//       --verdict-path /workspace/sentinel_50k/verdict.json \
//       --log-path /workspace/sentinel_50k/train.log \
//       --expected-savepoints "step_500,step_1000,step_2000,final" \
//       --savepoint-dir /workspace/sentinel_50k/ckpt \
//       --expected-wall-seconds 1800 \
//       --actual-wall-seconds 4 \
//       --exit-code 1 \
//       --output state/guard3_validator_2026_05_03/sentinel_50k.json
//
//   # 3. or replay reconstructed JSON (for retroactive smoke tests)
//   python3 /tmp/guard3_post_bg_validator_helper.hexa_tmp \
//       --replay state/guard3_validator_2026_05_03/smoke_paradigm_d_input.json \
//       --output state/guard3_validator_2026_05_03/smoke_paradigm_d.json
//
//   # selftest
//   hexa run tool/guard3_post_bg_validator.hexa --selftest
//
// EXIT CODES (helper)
//   0  PASS          (claim verified)
//   1  FAIL          (failure signals present — claim is wrong)
//   2  INDETERMINATE (cannot verify; manual inspection required)
//   3  USAGE_ERROR   (missing required args / malformed input)
//
// raw#9  STRICT: Mac → hexa only; transient python helper in /tmp (raw#37).
// raw#10 honest: 4 caveats embedded (see below).
// raw#15 SSOT this file; additive only; destructive ops 0.
//
// CAVEATS (raw#10 honest, exactly 4 as required by retry brief)
//
//   (1) HEURISTIC SIGNALS. Positive/failure signals are pattern-matched
//       (substring on log tail, file presence, size > 0). A run that exits
//       cleanly but writes 'OOM' to a debug log will be misclassified as FAIL.
//       Conversely, a corrupted savepoint that is 0 bytes and a run that
//       printed 'training complete' before crashing will be misclassified as
//       PASS. Heuristics are calibrated for the 2 documented incidents; out-of-
//       sample BGs may need manual override.
//
//   (2) FALSE-POSITIVE RISK ON SUCCESS PATH. Real PASS runs that lack
//       verdict.json (older training scripts, small probes) will be reported
//       INDETERMINATE — not PASS. The validator deliberately biases toward
//       INDETERMINATE rather than risking a silent PASS. Consumers must treat
//       INDETERMINATE as "manual look needed" not "ignore". Net effect: more
//       parent-agent attention required, not less.
//
//   (3) HARNESS INTEGRATION DEFERRED. This cycle implements the validator as a
//       standalone CLI tool only. It does NOT auto-attach to BG launches and is
//       NOT invoked by the harness automatically. Parent agents must remember
//       to invoke it after each cleanup BG (or wrap their BG launcher to do so).
//       Drift is likely within 5-10 cycles unless a harness hook lands in a
//       follow-up.
//
//   (4) RETROACTIVE SMOKE TESTS ARE RECONSTRUCTED. The smoke tests for the 2
//       prior incidents (paradigm-D unlink, sentinel-50k OOM) replay
//       reconstructed input JSON because the original artifacts are gone (A) or
//       never existed (B). Smoke INDETERMINATE/FAIL outcomes prove the
//       validator's logic on the reconstruction; they do NOT prove the
//       validator would have caught the bug in real-time, only that, given
//       equivalent disk evidence, it would have flagged correctly.

let HELPER_PATH = "/tmp/guard3_post_bg_validator_helper.hexa_tmp"

// ---------------------------------------------------------------------------
// helper emit — python (raw#37 transient; raw#9 hexa-only at repo level)
// ---------------------------------------------------------------------------

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# guard3_post_bg_validator helper — emitted by tool/guard3_post_bg_validator.hexa\n")
    parts.push("# raw#37 transient. Pure file-read + signal-pattern-match. No mutation.\n")
    parts.push("# F-GUARD3-1: PID-absent claim requires >=1 STRONG positive signal\n")
    parts.push("#   (P1 verdict-label OR P2 exit-code-0 OR P3 all-savepoints-present)\n")
    parts.push("#   AND zero failure signals (F1/F2/F3/F4).\n")
    parts.push("import json, os, sys, argparse, datetime\n\n")

    parts.push("POSITIVE_VERDICT_LABELS = {'PASS','ALL_GREEN','ALL_GATES_PASS','OK','SUCCESS','COMPLETE'}\n")
    parts.push("POSITIVE_VERDICT_PREFIXES = ('CLEAN_','GREEN_')\n")
    parts.push("POSITIVE_LOG_PATTERNS = [\n")
    parts.push("    'training complete','training finished','run complete','all done',\n")
    parts.push("    'verdict: pass','verdict=pass','exit code 0','exit_code=0',\n")
    parts.push("]\n")
    parts.push("FAILURE_LOG_PATTERNS = [\n")
    parts.push("    'oom','cuda out of memory','cuda error','traceback','killed',\n")
    parts.push("    'segmentation fault','core dumped','runtimeerror','out of memory',\n")
    parts.push("    'cuda runtime error','assertionerror',\n")
    parts.push("]\n\n")

    parts.push("def _read_text(p, max_bytes=200_000):\n")
    parts.push("    try:\n")
    parts.push("        with open(p,'rb') as f:\n")
    parts.push("            data = f.read()\n")
    parts.push("        if len(data) > max_bytes:\n")
    parts.push("            data = data[-max_bytes:]\n")
    parts.push("        return data.decode('utf-8','replace')\n")
    parts.push("    except Exception:\n")
    parts.push("        return None\n\n")

    parts.push("def _tail_lines(text, n=80):\n")
    parts.push("    if not text: return ''\n")
    parts.push("    lines = text.splitlines()\n")
    parts.push("    return '\\n'.join(lines[-n:])\n\n")

    parts.push("def _pos_signals(args, replay):\n")
    parts.push("    sigs = []\n")
    parts.push("    # P1: verdict.json present + label in positive set\n")
    parts.push("    vp = (replay.get('verdict_path') if replay else args.verdict_path) or ''\n")
    parts.push("    vlabel = None\n")
    parts.push("    if replay and replay.get('verdict_label'):\n")
    parts.push("        vlabel = str(replay['verdict_label'])\n")
    parts.push("    elif vp and os.path.exists(vp):\n")
    parts.push("        try:\n")
    parts.push("            with open(vp) as f: vd = json.load(f)\n")
    parts.push("            cand = vd.get('verdict') or vd.get('result') or vd.get('status')\n")
    parts.push("            if cand: vlabel = str(cand)\n")
    parts.push("        except Exception:\n")
    parts.push("            pass\n")
    parts.push("    if vlabel:\n")
    parts.push("        uvl = vlabel.upper()\n")
    parts.push("        if uvl in POSITIVE_VERDICT_LABELS or any(uvl.startswith(p) for p in POSITIVE_VERDICT_PREFIXES):\n")
    parts.push("            sigs.append({'id':'P1_verdict_label','value':vlabel,'note':'positive verdict label'})\n\n")

    parts.push("    # P2: exit_code captured == 0\n")
    parts.push("    ec = replay.get('exit_code') if replay else args.exit_code\n")
    parts.push("    if ec is not None and ec != '':\n")
    parts.push("        try:\n")
    parts.push("            if int(ec) == 0:\n")
    parts.push("                sigs.append({'id':'P2_exit_code_zero','value':0,'note':'process exited cleanly'})\n")
    parts.push("        except Exception:\n")
    parts.push("            pass\n\n")

    parts.push("    # P3: ALL expected savepoints present and non-empty\n")
    parts.push("    expected = replay.get('expected_savepoints') if replay else (args.expected_savepoints.split(',') if args.expected_savepoints else [])\n")
    parts.push("    expected = [s.strip() for s in expected if s and s.strip()]\n")
    parts.push("    sp_dir = (replay.get('savepoint_dir') if replay else args.savepoint_dir) or ''\n")
    parts.push("    sp_found_explicit = replay.get('savepoints_found') if replay else None\n")
    parts.push("    present, missing = [], []\n")
    parts.push("    if expected:\n")
    parts.push("        if sp_found_explicit is not None:\n")
    parts.push("            sp_set = set(sp_found_explicit)\n")
    parts.push("            for ck in expected:\n")
    parts.push("                (present if ck in sp_set else missing).append(ck)\n")
    parts.push("        elif sp_dir and os.path.isdir(sp_dir):\n")
    parts.push("            entries = list(os.listdir(sp_dir))\n")
    parts.push("            for ck in expected:\n")
    parts.push("                hit = False\n")
    parts.push("                for e in entries:\n")
    parts.push("                    if ck in e:\n")
    parts.push("                        full = os.path.join(sp_dir, e)\n")
    parts.push("                        if os.path.isfile(full) and os.path.getsize(full) > 0:\n")
    parts.push("                            hit = True\n")
    parts.push("                        elif os.path.isdir(full):\n")
    parts.push("                            try:\n")
    parts.push("                                for f in os.listdir(full):\n")
    parts.push("                                    fp = os.path.join(full, f)\n")
    parts.push("                                    if os.path.isfile(fp) and os.path.getsize(fp) > 0:\n")
    parts.push("                                        hit = True; break\n")
    parts.push("                            except Exception:\n")
    parts.push("                                pass\n")
    parts.push("                        if hit: break\n")
    parts.push("                (present if hit else missing).append(ck)\n")
    parts.push("        else:\n")
    parts.push("            missing = list(expected)\n")
    parts.push("        if present and not missing:\n")
    parts.push("            sigs.append({'id':'P3_all_savepoints_present','value':present,'note':f'all {len(present)} expected savepoints non-empty'})\n")
    parts.push("        elif present and missing:\n")
    parts.push("            sigs.append({'id':'P3_partial_savepoints','value':{'present':present,'missing':missing},'note':'partial — weak positive only'})\n\n")

    parts.push("    # P4: log tail contains terminal sentinel\n")
    parts.push("    log_tail = replay.get('log_tail') if replay else None\n")
    parts.push("    if log_tail is None and args.log_path and os.path.exists(args.log_path):\n")
    parts.push("        log_tail = _tail_lines(_read_text(args.log_path))\n")
    parts.push("    if log_tail:\n")
    parts.push("        lt = log_tail.lower()\n")
    parts.push("        for pat in POSITIVE_LOG_PATTERNS:\n")
    parts.push("            if pat in lt:\n")
    parts.push("                sigs.append({'id':'P4_log_terminal_sentinel','value':pat,'note':'matched in log tail'})\n")
    parts.push("                break\n")
    parts.push("    return sigs, log_tail\n\n")

    parts.push("def _fail_signals(args, replay, log_tail):\n")
    parts.push("    fails = []\n")
    parts.push("    # F1: exit_code != 0\n")
    parts.push("    ec = replay.get('exit_code') if replay else args.exit_code\n")
    parts.push("    if ec is not None and ec != '':\n")
    parts.push("        try:\n")
    parts.push("            v = int(ec)\n")
    parts.push("            if v != 0:\n")
    parts.push("                fails.append({'id':'F1_exit_code_nonzero','value':v,'note':'process exited with non-zero status'})\n")
    parts.push("        except Exception:\n")
    parts.push("            pass\n\n")

    parts.push("    # F2: log tail contains crash patterns\n")
    parts.push("    if log_tail:\n")
    parts.push("        lt = log_tail.lower()\n")
    parts.push("        hits = [pat for pat in FAILURE_LOG_PATTERNS if pat in lt]\n")
    parts.push("        if hits:\n")
    parts.push("            fails.append({'id':'F2_log_crash_pattern','value':hits[:3],'note':'crash sentinel(s) in log tail'})\n\n")

    parts.push("    # F3: stderr file non-empty + has crash content tail\n")
    parts.push("    stderr_path = (replay.get('stderr_path') if replay else args.stderr_path) or ''\n")
    parts.push("    stderr_size = replay.get('stderr_size') if replay else None\n")
    parts.push("    stderr_tail = replay.get('stderr_tail') if replay else None\n")
    parts.push("    if stderr_size is None and stderr_path and os.path.exists(stderr_path):\n")
    parts.push("        stderr_size = os.path.getsize(stderr_path)\n")
    parts.push("        stderr_tail = _tail_lines(_read_text(stderr_path), n=20)\n")
    parts.push("    if stderr_size and int(stderr_size) > 0 and stderr_tail and len(str(stderr_tail).strip()) > 0:\n")
    parts.push("        snip = str(stderr_tail)[-200:].replace('\\n',' | ')\n")
    parts.push("        fails.append({'id':'F3_stderr_nonempty','value':int(stderr_size),'note':'stderr has content; tail=' + snip})\n\n")

    parts.push("    # F4: expected savepoint absent AND wall-time < 50% of expected\n")
    parts.push("    expected = replay.get('expected_savepoints') if replay else (args.expected_savepoints.split(',') if args.expected_savepoints else [])\n")
    parts.push("    expected = [s.strip() for s in expected if s and s.strip()]\n")
    parts.push("    sp_found_explicit = replay.get('savepoints_found') if replay else None\n")
    parts.push("    sp_dir = (replay.get('savepoint_dir') if replay else args.savepoint_dir) or ''\n")
    parts.push("    actual_wall = replay.get('actual_wall_seconds') if replay else args.actual_wall_seconds\n")
    parts.push("    expected_wall = replay.get('expected_wall_seconds') if replay else args.expected_wall_seconds\n")
    parts.push("    if expected:\n")
    parts.push("        if sp_found_explicit is not None:\n")
    parts.push("            missing_all = (len(set(sp_found_explicit) & set(expected)) == 0)\n")
    parts.push("        elif sp_dir and os.path.isdir(sp_dir):\n")
    parts.push("            entries = list(os.listdir(sp_dir))\n")
    parts.push("            missing_all = not any(any(ck in e for e in entries) for ck in expected)\n")
    parts.push("        else:\n")
    parts.push("            missing_all = True\n")
    parts.push("        too_short = False\n")
    parts.push("        try:\n")
    parts.push("            if actual_wall not in (None,'') and expected_wall not in (None,''):\n")
    parts.push("                too_short = float(actual_wall) < (0.5 * float(expected_wall))\n")
    parts.push("        except Exception:\n")
    parts.push("            too_short = False\n")
    parts.push("        if missing_all and too_short:\n")
    parts.push("            fails.append({'id':'F4_savepoint_absent_short_wall','value':{'actual_s':actual_wall,'expected_s':expected_wall,'expected_savepoints':expected},'note':'no expected savepoint AND wall < 50% expected'})\n")
    parts.push("    return fails\n\n")

    parts.push("def _verdict(positive, failure):\n")
    parts.push("    # F-GUARD3-1: every PID-absent / completed claim needs >=1 STRONG positive signal AND zero failure signals.\n")
    parts.push("    if failure:\n")
    parts.push("        return 'FAIL', 'one or more failure signals present (claim is wrong)'\n")
    parts.push("    if not positive:\n")
    parts.push("        return 'INDETERMINATE', 'no positive signal AND no explicit failure signal — manual inspection required (do NOT default to completed)'\n")
    parts.push("    strong_ids = {'P1_verdict_label','P2_exit_code_zero','P3_all_savepoints_present'}\n")
    parts.push("    if any(s['id'] in strong_ids for s in positive):\n")
    parts.push("        return 'PASS', 'at least one strong positive signal present and zero failure signals'\n")
    parts.push("    return 'INDETERMINATE', 'only weak positive signal (P3_partial or P4_log_sentinel) present; require P1/P2/P3 for PASS'\n\n")

    parts.push("def _run(args):\n")
    parts.push("    replay = None\n")
    parts.push("    if args.replay:\n")
    parts.push("        try:\n")
    parts.push("            with open(args.replay) as f: replay = json.load(f)\n")
    parts.push("        except Exception as e:\n")
    parts.push("            print(f'ERROR: replay read failed: {e}', file=sys.stderr); sys.exit(3)\n")
    parts.push("    if not replay:\n")
    parts.push("        if not args.bg_claim:\n")
    parts.push("            print('ERROR: --bg-claim or --replay required', file=sys.stderr); sys.exit(3)\n")
    parts.push("        if not any([args.verdict_path,args.log_path,args.stderr_path,args.savepoint_dir,args.exit_code,args.expected_savepoints]):\n")
    parts.push("            print('ERROR: at least one of --verdict-path/--log-path/--stderr-path/--savepoint-dir/--exit-code/--expected-savepoints required (live mode)', file=sys.stderr); sys.exit(3)\n")
    parts.push("    positive, log_tail = _pos_signals(args, replay)\n")
    parts.push("    failure = _fail_signals(args, replay, log_tail)\n")
    parts.push("    verdict, rationale = _verdict(positive, failure)\n")
    parts.push("    bg_claim = (replay.get('bg_claim') if replay else args.bg_claim) or ''\n")
    parts.push("    label = (replay.get('label') if replay else args.label) or ''\n")
    parts.push("    out = {\n")
    parts.push("        'schema':'anima/guard3_post_bg_validator/1',\n")
    parts.push("        'tool':'tool/guard3_post_bg_validator.hexa',\n")
    parts.push("        'ts_iso': datetime.datetime.utcnow().isoformat(timespec='seconds') + 'Z',\n")
    parts.push("        'label': label,\n")
    parts.push("        'bg_claim': bg_claim,\n")
    parts.push("        'mode': 'replay' if replay else 'live',\n")
    parts.push("        'positive_signals': positive,\n")
    parts.push("        'failure_signals': failure,\n")
    parts.push("        'verdict': verdict,\n")
    parts.push("        'rationale': rationale,\n")
    parts.push("        'guard_rule': 'F-GUARD3-1: PID-absent claim requires >=1 STRONG positive signal (P1 verdict-label OR P2 exit-code-0 OR P3 all-savepoints) AND zero failure signals',\n")
    parts.push("        'caveats': [\n")
    parts.push("            'heuristic: positive/failure signals are pattern-matched; out-of-sample BGs may need manual override',\n")
    parts.push("            'false-positive risk: real PASS runs lacking verdict.json are reported INDETERMINATE (bias toward manual look)',\n")
    parts.push("            'harness deferred: standalone CLI only; parent must invoke after each cleanup BG',\n")
    parts.push("            'retroactive smoke tests replay reconstructed input, not original artifacts',\n")
    parts.push("        ],\n")
    parts.push("    }\n")
    parts.push("    text = json.dumps(out, indent=2, ensure_ascii=False)\n")
    parts.push("    if args.output:\n")
    parts.push("        os.makedirs(os.path.dirname(args.output) or '.', exist_ok=True)\n")
    parts.push("        with open(args.output, 'w') as f: f.write(text + '\\n')\n")
    parts.push("    print(text)\n")
    parts.push("    if verdict == 'PASS': sys.exit(0)\n")
    parts.push("    if verdict == 'FAIL': sys.exit(1)\n")
    parts.push("    sys.exit(2)\n\n")

    parts.push("def main():\n")
    parts.push("    ap = argparse.ArgumentParser(description='GUARD-3 post-BG validator — checks success-signal checklist after a BG cleanup claim.')\n")
    parts.push("    ap.add_argument('--bg-claim', dest='bg_claim', default='')\n")
    parts.push("    ap.add_argument('--work-dir', dest='work_dir', default='')\n")
    parts.push("    ap.add_argument('--verdict-path', dest='verdict_path', default='')\n")
    parts.push("    ap.add_argument('--log-path', dest='log_path', default='')\n")
    parts.push("    ap.add_argument('--stderr-path', dest='stderr_path', default='')\n")
    parts.push("    ap.add_argument('--expected-savepoints', dest='expected_savepoints', default='')\n")
    parts.push("    ap.add_argument('--savepoint-dir', dest='savepoint_dir', default='')\n")
    parts.push("    ap.add_argument('--exit-code', dest='exit_code', default='')\n")
    parts.push("    ap.add_argument('--expected-wall-seconds', dest='expected_wall_seconds', default='')\n")
    parts.push("    ap.add_argument('--actual-wall-seconds', dest='actual_wall_seconds', default='')\n")
    parts.push("    ap.add_argument('--replay', dest='replay', default='')\n")
    parts.push("    ap.add_argument('--output', dest='output', default='')\n")
    parts.push("    ap.add_argument('--label', dest='label', default='')\n")
    parts.push("    args = ap.parse_args()\n")
    parts.push("    _run(args)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

// ---------------------------------------------------------------------------
// selftest — verifies the emitter ran and helper file landed (no exec).
// End-to-end smoke tests are run by the calling shell (see USAGE).
// ---------------------------------------------------------------------------

fn _selftest_invariants() -> bool {
    let mut ok = true
    if !file_exists(HELPER_PATH) {
        println("inv:helper_emitted=false (FAIL)")
        ok = false
    } else {
        println("inv:helper_emitted=true")
    }
    let sz = file_size(HELPER_PATH)
    if sz < 2000 {
        println("inv:helper_min_bytes_2000=false (got " + to_string(sz) + ")")
        ok = false
    } else {
        println("inv:helper_min_bytes_2000=true (got " + to_string(sz) + ")")
    }
    println("inv:guard_rule=F-GUARD3-1")
    println("inv:positive_signals=P1_verdict_label,P2_exit_code_zero,P3_all_savepoints_present,P4_log_terminal_sentinel")
    println("inv:failure_signals=F1_exit_code_nonzero,F2_log_crash_pattern,F3_stderr_nonempty,F4_savepoint_absent_short_wall")
    println("inv:caveats_count=4")
    return ok
}

fn cmd_selftest() {
    println("── guard3_post_bg_validator selftest ──")
    _write_helper()
    let ok = _selftest_invariants()
    if !ok {
        println("selftest=fail")
        exit(2)
    }
    println("selftest=ok")
    println("helper_emitted=" + HELPER_PATH)
    println("invocation=python3 " + HELPER_PATH + " --replay <file> --output <file>")
    println("paradigm=GUARD-3 success-signal checklist (post-BG validator; standalone; mac $0; NON_MUTATION)")
    println("DONE")
}

fn cmd_help() {
    println("guard3_post_bg_validator (emitter) — GUARD-3 success-signal checklist")
    println("")
    println("usage:")
    println("  hexa run tool/guard3_post_bg_validator.hexa --selftest   # emit + invariants")
    println("  hexa run tool/guard3_post_bg_validator.hexa --emit       # emit helper only")
    println("  hexa run tool/guard3_post_bg_validator.hexa              # emit + print usage")
    println("")
    println("then invoke the helper directly:")
    println("  python3 " + HELPER_PATH + " [args]")
    println("")
    println("helper args:")
    println("  --bg-claim STR             free-text BG output claim")
    println("  --verdict-path PATH        path to verdict.json")
    println("  --log-path PATH            path to train.log")
    println("  --stderr-path PATH         path to stderr capture")
    println("  --expected-savepoints LIST comma-sep savepoint name fragments")
    println("  --savepoint-dir DIR        dir holding savepoint files/subdirs")
    println("  --exit-code INT            captured exit code")
    println("  --expected-wall-seconds N  expected wall time (sec)")
    println("  --actual-wall-seconds N    actual wall time (sec)")
    println("  --replay PATH              JSON describing reconstructed BG state")
    println("  --output PATH              write verdict JSON here")
    println("  --label STR                event label")
    println("")
    println("helper exit codes: 0=PASS  1=FAIL  2=INDETERMINATE  3=USAGE_ERROR")
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

fn main() {
    let av = argv()
    let mut selftest = false
    let mut emit_only = false
    let mut help = false
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--emit"     { emit_only = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { help = true; i = i + 1; continue }
        i = i + 1
    }
    if help { cmd_help(); exit(0) }
    if selftest { cmd_selftest(); exit(0) }
    _write_helper()
    if emit_only {
        println("emitted=" + HELPER_PATH)
        println("DONE")
        exit(0)
    }
    println("emitted=" + HELPER_PATH)
    println("")
    cmd_help()
}

