// tool/anima_nexus_1013lens_cascade.hexa — NEXUS-6 1013-lens K-cascade aggregator (raw#9 hexa-only).
//
// PURPOSE
//   K-cascade aggregator for spec nexus6_1013lens_activation_2026_05_11.
//   Implements K ∈ {10, 25, 50, 1013} cascade steps (spec §3 + cascade_k25_plan §6 옵션 A).
//   H_135 (DD166) entry-point — uses nexus hexa lens registry (NOT anima_phi_star.hexa).
//
// HISTORY
//   2026-05-11: created as anima_nexus_1013lens_smoke.hexa (K=10 hardcoded).
//   2026-05-12: renamed → anima_nexus_1013lens_cascade.hexa, parameterized via --k flag.
//               cycle 5 §4 #H — SSOT/DRY (single aggregator for K=10/25/50/1013).
//
// PATH (audit recommendation, prereq_audit_2026_05_11.md §4)
//   P-A redefined: nexus /Users/ghost/core/nexus/lenses/core_*.hexa + Linux ~/.hx/bin/hexa runner.
//   subprocess loop: ~19 ms/lens × K. K=10 ≈ 0.2 s, K=25 ≈ 0.5 s, K=50 ≈ 1 s, K=1013 ≈ 19 s.
//   CPU-only, $0 cost.
//
// INPUT (env + CLI)
//   --k {10|25|50|1013}    K-tier (default 10, back-compat). 또는 env ANIMA_K.
//   --selftest             selftest invariants + emit helper.
//   NEXUS_LENSES_DIR       lens dir (default: /Users/ghost/core/nexus/lenses)
//                          fallback: /home/summer/core/nexus_lenses_snapshot
//   ANIMA_HEXA_BIN         hexa runner (default: $HOME/.hx/bin/hexa)
//   ANIMA_OUTPUT           output JSON (default: state/nexus6_1013lens_activation_2026_05_11/cascade_k{K}_results.json)
//   ANIMA_LENS_WHITELIST   comma-separated lens basenames (optional override; truncated to K).
//   ANIMA_LENS_REGISTRY    optional path to lens_registry.json (for K=25/50/1013 secondary source)
//
// WHITELIST SOURCE (precedence high → low)
//   1. env ANIMA_LENS_WHITELIST (manual override; truncated to K)
//   2. lens_registry.json `.k{K}_binding` field (if ANIMA_LENS_REGISTRY set + field exists)
//   3. K-specific built-in whitelist:
//        K=10  → spec §3.1 canonical 10 lens (core_info/causal/consciousness/thermo/quantum/
//                topology/gravity/network/scale/stability)
//        K=25  → cascade_k25_plan §1: K=10 carry-over + 13 core_* exhaustive + 2 cross-cat
//        K=50  → cascade_k25_plan §1 K=25 + 25 ext (TBD; agent fallback: alphabetical n6_*/anima_*)
//        K=1013→ top-1013 from lens_registry.json sorted, else all *.hexa truncated
//   4. core_*.hexa alphabetical first-K fallback
//
// C/F THRESHOLDS (K-monotone — cascade_k25_plan §2/§3)
//   C1 cascade_gate: pos_ratio >= c1_floor(K)
//                    c1_floor(10)=0.6, c1_floor(25)=max(0.6, 0.7), c1_floor(50)=max(c25, 0.8)
//                    smooth: 0.5 + 0.01 * K (used for K=1013)
//   F1 floor_breach: pos_ratio <= f1_ceil(K)
//                    f1_ceil(10)=0.4, f1_ceil(25)=0.5, f1_ceil(50)=0.6, f1_ceil(1013)=0.5
//
// OUTPUT JSON schema (anima/nexus_1013lens_cascade/1)
//   {
//     "spec_id":"nexus6_1013lens_activation_2026_05_11",
//     "k": <int>,
//     "lens_dir": <resolved path>,
//     "whitelist_source": <str>,
//     "whitelist_caveat":"binds to spec §3.1 (K=10) / cascade_k25_plan §1 (K=25) C3 no-mislabel-drift",
//     "results":[ {"lens":<basename>,"score":<float>,"hits":<int>,"total":<int>,"raw":<stdout>,"ok":<bool>,"err":<str?>}, ... ],
//     "phi_mean": <float>, "phi_std": <float>,
//     "positive_ratio": <float>,
//     "c1_cascade_gate": <bool>,                # generic name (was c1_smoke_gate for K=10)
//     "c1_smoke_gate": <bool>,                  # back-compat alias when K=10
//     "c1_floor": <float>,                      # K-monotone threshold
//     "f1_floor_breach": <bool>,
//     "f1_ceil": <float>,                       # K-monotone threshold
//     "f2_random_baseline_delta": <float|null>, # stub — cascade_k25_plan §3.1 미결정 (Agent #I scope)
//     "cross_lens_agreement_stub": <float|null>,
//     "bonferroni_alpha": <float>,
//     "n6_consistency_ratio": <float>,
//     "timing_ms": {"total":<int>,"per_lens_mean":<float>}
//   }
//
// USAGE
//   hexa run tool/anima_nexus_1013lens_cascade.hexa --selftest
//   hexa run tool/anima_nexus_1013lens_cascade.hexa --k 25
//   ANIMA_K=10 ANIMA_OUTPUT=state/nexus6_1013lens_activation_2026_05_11/cascade_k10_results.json \
//     python3 /tmp/anima_nexus_1013lens_cascade_helper.hexa_tmp
//
// LOCK POLICY
//   chflags +uchg/+schg / chattr +i 적용 금지 (memory: feedback_no_relock.md 2026-05-11).
//
// raw#9 hexa-only / raw#37 transient emit / raw#15 SSOT this file
// raw#10 honest:
//   - cross_lens_agreement = stub (pairwise sign-correlation; real K-NN agreement is K=25+ scope).
//   - F1 falsifier = implemented (K-monotone floor).
//   - F2 random-walk baseline = stub (cascade_k25_plan §3.1 MC/analytic/bootstrap 미결정 — Agent #I).
//   - whitelist K=50 / K=1013 use agent-defined fallback when plan/registry lack explicit binding.
//   - K=10 back-compat preserved: default K=10 + c1_smoke_gate alias retained.

let HELPER_PATH = "/tmp/anima_nexus_1013lens_cascade_helper.hexa_tmp"

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima_nexus_1013lens_cascade helper — emitted by tool/anima_nexus_1013lens_cascade.hexa\n")
    parts.push("# raw#37 transient. K-cascade aggregator for spec nexus6_1013lens_activation_2026_05_11.\n")
    parts.push("import json, os, re, sys, subprocess, time, statistics\n\n")

    parts.push("SPEC_ID = 'nexus6_1013lens_activation_2026_05_11'\n")
    parts.push("K = int(os.environ.get('ANIMA_K', '10'))\n")
    parts.push("if K not in (10, 25, 50, 1013):\n")
    parts.push("    print(f'[1013lens_cascade] ERR: K={K} not in (10,25,50,1013); falling back to K=10', flush=True)\n")
    parts.push("    K = 10\n")
    parts.push("DEFAULT_OUT = f'state/nexus6_1013lens_activation_2026_05_11/cascade_k{K}_results.json'\n")
    parts.push("OUTPUT = os.environ.get('ANIMA_OUTPUT', DEFAULT_OUT)\n")
    parts.push("HEXA_BIN = os.environ.get('ANIMA_HEXA_BIN', os.path.expanduser('~/.hx/bin/hexa'))\n")
    parts.push("LENS_DIR_PRIMARY = os.environ.get('NEXUS_LENSES_DIR', '/Users/ghost/core/nexus/lenses')\n")
    parts.push("LENS_DIR_FALLBACK = '/home/summer/core/nexus_lenses_snapshot'\n")
    parts.push("WHITELIST_ENV = os.environ.get('ANIMA_LENS_WHITELIST', '').strip()\n")
    parts.push("LENS_REGISTRY = os.environ.get('ANIMA_LENS_REGISTRY', '').strip()\n\n")

    parts.push("def _resolve_lens_dir():\n")
    parts.push("    for p in (LENS_DIR_PRIMARY, LENS_DIR_FALLBACK):\n")
    parts.push("        if p and os.path.isdir(p): return p\n")
    parts.push("    return None\n\n")

    parts.push("lens_dir = _resolve_lens_dir()\n")
    parts.push("if lens_dir is None:\n")
    parts.push("    summary = {\n")
    parts.push("        'spec_id': SPEC_ID, 'k': K,\n")
    parts.push("        'status': 'LENS_DIR_MISSING',\n")
    parts.push("        'hint': 'mount /Users/ghost/core/nexus or rsync lenses to /home/summer/core/nexus_lenses_snapshot',\n")
    parts.push("        'tried': [LENS_DIR_PRIMARY, LENS_DIR_FALLBACK],\n")
    parts.push("    }\n")
    parts.push("    os.makedirs(os.path.dirname(OUTPUT) or '.', exist_ok=True)\n")
    parts.push("    with open(OUTPUT,'w') as f: json.dump(summary, f, indent=2, ensure_ascii=False)\n")
    parts.push("    print(f'[1013lens_cascade] k={K} status=LENS_DIR_MISSING -> {OUTPUT}', flush=True); sys.exit(2)\n\n")

    parts.push("if not os.path.isfile(HEXA_BIN) or not os.access(HEXA_BIN, os.X_OK):\n")
    parts.push("    summary = {'spec_id':SPEC_ID, 'k':K, 'status':'HEXA_BIN_MISSING', 'hexa_bin':HEXA_BIN}\n")
    parts.push("    os.makedirs(os.path.dirname(OUTPUT) or '.', exist_ok=True)\n")
    parts.push("    with open(OUTPUT,'w') as f: json.dump(summary, f, indent=2, ensure_ascii=False)\n")
    parts.push("    print(f'[1013lens_cascade] k={K} status=HEXA_BIN_MISSING ({HEXA_BIN}) -> {OUTPUT}', flush=True); sys.exit(2)\n\n")

    parts.push("# --- Whitelist resolution (K-specific) ---\n")
    parts.push("# spec §3.1 (2026-05-11 확정) — K=10 canonical:\n")
    parts.push("SPEC_K10_WHITELIST = [\n")
    parts.push("    'core_info.hexa', 'core_causal.hexa', 'core_consciousness.hexa', 'core_thermo.hexa',\n")
    parts.push("    'core_quantum.hexa', 'core_topology.hexa', 'core_gravity.hexa', 'core_network.hexa',\n")
    parts.push("    'core_scale.hexa', 'core_stability.hexa',\n")
    parts.push("]\n")
    parts.push("# cascade_k25_plan §1.2 — K=25 expansion (K=10 + 13 core_* exhaustive):\n")
    parts.push("PLAN_K25_CORE_EXT = [\n")
    parts.push("    'core_boundary.hexa', 'core_chaos.hexa', 'core_compass.hexa', 'core_em.hexa',\n")
    parts.push("    'core_evolution.hexa', 'core_memory.hexa', 'core_mirror.hexa', 'core_multiscale.hexa',\n")
    parts.push("    'core_quantum_microscope.hexa', 'core_recursion.hexa', 'core_ruler.hexa',\n")
    parts.push("    'core_triangle.hexa', 'core_wave.hexa',\n")
    parts.push("]\n\n")

    parts.push("def _resolve_whitelist(lens_dir, K):\n")
    parts.push("    available = set(f for f in os.listdir(lens_dir) if f.endswith('.hexa'))\n")
    parts.push("    # 1. env override\n")
    parts.push("    if WHITELIST_ENV:\n")
    parts.push("        wl = [n.strip() for n in WHITELIST_ENV.split(',') if n.strip()][:K]\n")
    parts.push("        return wl, 'env ANIMA_LENS_WHITELIST'\n")
    parts.push("    # 2. lens_registry.json `.k{K}_binding`\n")
    parts.push("    if LENS_REGISTRY and os.path.isfile(LENS_REGISTRY):\n")
    parts.push("        try:\n")
    parts.push("            with open(LENS_REGISTRY) as f: reg = json.load(f)\n")
    parts.push("            field = f'k{K}_binding'\n")
    parts.push("            if isinstance(reg, dict) and field in reg and isinstance(reg[field], list):\n")
    parts.push("                wl = [str(x) for x in reg[field]][:K]\n")
    parts.push("                if all(b in available for b in wl):\n")
    parts.push("                    return wl, f'lens_registry.json .{field}'\n")
    parts.push("        except Exception as e:\n")
    parts.push("            print(f'[1013lens_cascade] WARN: lens_registry parse failed: {e!r}', flush=True)\n")
    parts.push("    # 3. K-specific built-in\n")
    parts.push("    if K == 10:\n")
    parts.push("        if all(b in available for b in SPEC_K10_WHITELIST):\n")
    parts.push("            return list(SPEC_K10_WHITELIST), 'spec §3.1 canonical K=10 (2026-05-11)'\n")
    parts.push("    elif K == 25:\n")
    parts.push("        # K=10 carry-over + 13 core_* exhaustive (cascade_k25_plan §1.2) + 2 cross-cat (§1.3)\n")
    parts.push("        core25 = list(SPEC_K10_WHITELIST) + list(PLAN_K25_CORE_EXT)\n")
    parts.push("        n6_cands = sorted([f for f in available if f.startswith('n6_')])\n")
    parts.push("        anima_cands = sorted([f for f in available if f.startswith('anima_')])\n")
    parts.push("        cross = []\n")
    parts.push("        if n6_cands: cross.append(n6_cands[0])\n")
    parts.push("        if anima_cands: cross.append(anima_cands[0])\n")
    parts.push("        wl = core25 + cross\n")
    parts.push("        wl = [b for b in wl if b in available][:K]\n")
    parts.push("        if len(wl) == K:\n")
    parts.push("            return wl, 'cascade_k25_plan §1 (K=10 + 13 core_* + n6/anima top-1)'\n")
    parts.push("    elif K == 50:\n")
    parts.push("        # K=25 base + 25 extension (agent fallback): all remaining core_* + alphabetical n6_/anima_/tecs_/sedi_\n")
    parts.push("        # cascade_k25_plan §6.2: K=50 explicit list TBD (별 plan). agent fallback below:\n")
    parts.push("        cores = sorted([f for f in available if f.startswith('core_')])\n")
    parts.push("        n6 = sorted([f for f in available if f.startswith('n6_')])\n")
    parts.push("        anima = sorted([f for f in available if f.startswith('anima_')])\n")
    parts.push("        tecs = sorted([f for f in available if f.startswith('tecs_')])\n")
    parts.push("        sedi = sorted([f for f in available if f.startswith('sedi_')])\n")
    parts.push("        wl = list(cores)\n")
    parts.push("        # fill remaining via cross-category until K=50\n")
    parts.push("        for src in (n6, anima, tecs, sedi):\n")
    parts.push("            for f in src:\n")
    parts.push("                if len(wl) >= K: break\n")
    parts.push("                if f not in wl: wl.append(f)\n")
    parts.push("            if len(wl) >= K: break\n")
    parts.push("        wl = wl[:K]\n")
    parts.push("        if wl:\n")
    parts.push("            return wl, f'agent fallback K=50 (all core_* + cross-cat fill; plan TBD)'\n")
    parts.push("    elif K == 1013:\n")
    parts.push("        # top-1013 from lens_registry if available, else all *.hexa truncated alphabetical\n")
    parts.push("        allf = sorted(available)\n")
    parts.push("        wl = allf[:K]\n")
    parts.push("        if wl:\n")
    parts.push("            return wl, f'all *.hexa alphabetical first-{K} (1013 official whitelist TBD per spec §11)'\n")
    parts.push("    # 4. alphabetical core_* first-K fallback\n")
    parts.push("    cores = sorted([f for f in available if f.startswith('core_')])\n")
    parts.push("    return cores[:K], f'core_*.hexa alphabetical first-{K} (fallback)'\n\n")

    parts.push("whitelist, whitelist_source = _resolve_whitelist(lens_dir, K)\n")
    parts.push("if len(whitelist) < K:\n")
    parts.push("    print(f'[1013lens_cascade] WARN: only {len(whitelist)} lens found in whitelist (K={K} expected)', flush=True)\n\n")

    parts.push("# --- K-monotone C/F thresholds (cascade_k25_plan §2/§3) ---\n")
    parts.push("def _c1_floor(K):\n")
    parts.push("    # K=10: 0.6, K=25: 0.7, K=50: 0.8, K=1013: 0.5 + 0.01*K capped to 0.95\n")
    parts.push("    table = {10: 0.6, 25: 0.7, 50: 0.8}\n")
    parts.push("    if K in table: return table[K]\n")
    parts.push("    return min(0.95, 0.5 + 0.01 * K)\n")
    parts.push("def _f1_ceil(K):\n")
    parts.push("    table = {10: 0.4, 25: 0.5, 50: 0.6}\n")
    parts.push("    if K in table: return table[K]\n")
    parts.push("    return min(0.7, 0.4 + 0.005 * K)\n")
    parts.push("c1_floor = _c1_floor(K)\n")
    parts.push("f1_ceil = _f1_ceil(K)\n\n")

    parts.push("SCORE_RE = re.compile(r'score=([+-]?[0-9]*\\.?[0-9]+(?:[eE][+-]?[0-9]+)?)')\n")
    parts.push("HITS_RE = re.compile(r'\\((\\d+)/(\\d+)\\)')\n\n")

    parts.push("def _run_lens(lens_basename):\n")
    parts.push("    path = os.path.join(lens_dir, lens_basename)\n")
    parts.push("    if not os.path.isfile(path):\n")
    parts.push("        return {'lens':lens_basename, 'ok':False, 'err':'file_missing', 'score':None}\n")
    parts.push("    t0 = time.time()\n")
    parts.push("    try:\n")
    parts.push("        r = subprocess.run([HEXA_BIN,'run',path], capture_output=True, text=True, timeout=10)\n")
    parts.push("    except subprocess.TimeoutExpired:\n")
    parts.push("        return {'lens':lens_basename, 'ok':False, 'err':'timeout', 'score':None}\n")
    parts.push("    except Exception as e:\n")
    parts.push("        return {'lens':lens_basename, 'ok':False, 'err':f'exec:{e!r}'[:200], 'score':None}\n")
    parts.push("    elapsed_ms = int((time.time()-t0)*1000)\n")
    parts.push("    raw = (r.stdout or '') + (r.stderr or '')\n")
    parts.push("    score = None; hits = None; total = None\n")
    parts.push("    m_last = None\n")
    parts.push("    for m in SCORE_RE.finditer(raw): m_last = m\n")
    parts.push("    if m_last:\n")
    parts.push("        try: score = float(m_last.group(1))\n")
    parts.push("        except Exception: score = None\n")
    parts.push("    mh = HITS_RE.search(raw)\n")
    parts.push("    if mh:\n")
    parts.push("        try: hits, total = int(mh.group(1)), int(mh.group(2))\n")
    parts.push("        except Exception: pass\n")
    parts.push("    return {'lens':lens_basename, 'ok':r.returncode==0 and score is not None, 'score':score,\n")
    parts.push("            'hits':hits, 'total':total, 'elapsed_ms':elapsed_ms,\n")
    parts.push("            'raw':raw.strip()[-240:], 'rc':r.returncode}\n\n")

    parts.push("t_start = time.time()\n")
    parts.push("results = [_run_lens(b) for b in whitelist]\n")
    parts.push("total_ms = int((time.time()-t_start)*1000)\n\n")

    parts.push("scores = [r['score'] for r in results if r.get('score') is not None]\n")
    parts.push("phi_mean = statistics.mean(scores) if scores else 0.0\n")
    parts.push("phi_std = statistics.pstdev(scores) if len(scores) > 1 else 0.0\n")
    parts.push("positive = sum(1 for s in scores if s > 0)\n")
    parts.push("positive_ratio = positive / len(whitelist) if whitelist else 0.0\n\n")

    parts.push("# K-monotone gates (cascade_k25_plan §2 C1 + §3 F1)\n")
    parts.push("c1_cascade_gate = (positive_ratio >= c1_floor) and (phi_mean > 0)\n")
    parts.push("f1_floor_breach = positive_ratio <= f1_ceil\n\n")

    parts.push("# cross_lens_agreement stub — pairwise sign matrix (audit risk #3 stub).\n")
    parts.push("cross_lens_stub = None\n")
    parts.push("if len(scores) >= 2:\n")
    parts.push("    signs = [1 if s > 0 else (-1 if s < 0 else 0) for s in scores]\n")
    parts.push("    pairs = [(i,j) for i in range(len(signs)) for j in range(i+1,len(signs))]\n")
    parts.push("    agree = sum(1 for (i,j) in pairs if signs[i] != 0 and signs[i]==signs[j])\n")
    parts.push("    cross_lens_stub = agree / len(pairs) if pairs else None\n\n")

    parts.push("# F2 random-walk baseline stub — cascade_k25_plan §3.1 MC/analytic/bootstrap 미결정.\n")
    parts.push("# TODO(Agent #I null synthesis): wire MC default (cascade_k25_plan §3.1 recommended).\n")
    parts.push("# When activated, write to f2_random_delta = KS-test statistic vs uniform[-1,1] × K × 1000 trial.\n")
    parts.push("f2_random_delta = None\n\n")

    parts.push("# Bonferroni — α / N_tests. At K=25: within-batch α=0.05/25=0.002 (informational at K<50).\n")
    parts.push("# spec §3: K=50 only binds; smoke/canary report only.\n")
    parts.push("bonferroni_alpha = (0.05 / K) if K >= 50 else (0.05 / 1013.0)\n\n")

    parts.push("# n6-consistency proxy = fraction lens with score>0 (audit §2.4).\n")
    parts.push("n6_consistency_ratio = positive_ratio\n\n")

    parts.push("summary = {\n")
    parts.push("    'paradigm': f'nexus 1013-lens K={K} cascade (audit-recommended P-A path)',\n")
    parts.push("    'spec_id': SPEC_ID,\n")
    parts.push("    'k': K,\n")
    parts.push("    'lens_dir': lens_dir,\n")
    parts.push("    'hexa_bin': HEXA_BIN,\n")
    parts.push("    'whitelist': whitelist,\n")
    parts.push("    'whitelist_source': whitelist_source,\n")
    parts.push("    'whitelist_caveat': 'spec §3.1 (K=10) / cascade_k25_plan §1 (K=25) binds C3 no-mislabel-drift',\n")
    parts.push("    'results': results,\n")
    parts.push("    'phi_mean': phi_mean,\n")
    parts.push("    'phi_std': phi_std,\n")
    parts.push("    'positive_ratio': positive_ratio,\n")
    parts.push("    'c1_cascade_gate': c1_cascade_gate,\n")
    parts.push("    'c1_smoke_gate': c1_cascade_gate if K == 10 else None,\n")
    parts.push("    'c1_floor': c1_floor,\n")
    parts.push("    'f1_floor_breach': f1_floor_breach,\n")
    parts.push("    'f1_ceil': f1_ceil,\n")
    parts.push("    'f2_random_baseline_delta': f2_random_delta,\n")
    parts.push("    'cross_lens_agreement_stub': cross_lens_stub,\n")
    parts.push("    'bonferroni_alpha': bonferroni_alpha,\n")
    parts.push("    'n6_consistency_ratio': n6_consistency_ratio,\n")
    parts.push("    'timing_ms': {'total': total_ms, 'per_lens_mean': (total_ms/len(whitelist)) if whitelist else 0.0},\n")
    parts.push("    'falsifier_status': {\n")
    parts.push("        'F1_phi_ratio_floor': 'BREACH' if f1_floor_breach else 'ok',\n")
    parts.push("        'F2_random_walk': 'stub-deferred-agent-I',\n")
    parts.push("        'F3_bonferroni': 'binding' if K >= 50 else 'informational-only',\n")
    parts.push("        'F4_n6_consistency': 'binding' if K >= 50 else 'proxy-only',\n")
    parts.push("        'F5_seed_sign_preservation': 'na-deterministic-lenses',\n")
    parts.push("    },\n")
    parts.push("    'lock_policy':'no chflags / chattr — memory feedback_no_relock.md 2026-05-11',\n")
    parts.push("}\n")
    parts.push("os.makedirs(os.path.dirname(OUTPUT) or '.', exist_ok=True)\n")
    parts.push("with open(OUTPUT,'w') as f: json.dump(summary, f, indent=2, ensure_ascii=False)\n")
    parts.push("ok_n = sum(1 for r in results if r.get('ok'))\n")
    parts.push("print(f'[1013lens_cascade] k={K} ok={ok_n}/{len(whitelist)} mean={phi_mean:.3f} std={phi_std:.3f} pos_ratio={positive_ratio:.2f} c1_floor={c1_floor:.2f} c1_gate={c1_cascade_gate} f1_ceil={f1_ceil:.2f} f1_breach={f1_floor_breach} cross_stub={cross_lens_stub} t={total_ms}ms -> {OUTPUT}', flush=True)\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _selftest_invariants(k_arg) -> bool {
    let k = k_arg
    let lens_dir_primary = "/Users/ghost/core/nexus/lenses"
    let lens_dir_fallback = "/home/summer/core/nexus_lenses_snapshot"
    let cross_lens_agreement = "stub-pairwise-sign"
    let f2_random_walk = "stub-deferred-agent-I-cascade-k25-plan-§3.1"
    let whitelist_strategy = "env > registry.k{K}_binding > K-specific built-in (spec §3.1 / plan §1) > alphabetical fallback"
    println("inv:k=" + to_string(k))
    println("inv:k_supported={10,25,50,1013}")
    println("inv:default_k=10 (back-compat with anima_nexus_1013lens_smoke.hexa)")
    println("inv:lens_dir_primary=" + lens_dir_primary)
    println("inv:lens_dir_fallback=" + lens_dir_fallback)
    println("inv:c1_floor_k10=0.60")
    println("inv:c1_floor_k25=0.70")
    println("inv:c1_floor_k50=0.80")
    println("inv:c1_floor_k1013=min(0.95,0.5+0.01*K)")
    println("inv:f1_ceil_k10=0.40")
    println("inv:f1_ceil_k25=0.50")
    println("inv:f1_ceil_k50=0.60")
    println("inv:cross_lens_agreement=" + cross_lens_agreement)
    println("inv:f2_random_walk=" + f2_random_walk)
    println("inv:bonferroni_alpha=0.05/K if K>=50 else 0.05/1013")
    println("inv:whitelist_strategy=" + whitelist_strategy)
    println("inv:lock_policy=no_chflags_no_chattr")
    println("inv:spec_id=nexus6_1013lens_activation_2026_05_11")
    println("inv:engine=nexus hexa lens (NOT anima_phi_star.hexa — different measurement axis)")
    return true
}

fn cmd_selftest(k_arg) {
    println("── anima_nexus_1013lens_cascade selftest ──")
    _write_helper()
    let ok = _selftest_invariants(k_arg)
    if !ok {
        println("selftest=fail")
        exit(2)
    }
    println("selftest=ok")
    println("helper_emitted=" + HELPER_PATH)
    println("paradigm=nexus 1013-lens K-cascade aggregator (audit-recommended P-A; CPU $0; spec §3 cascade K=10/25/50/1013)")
    println("DONE")
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut k = 10
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--k" {
            if i + 1 < len(av) {
                k = to_int(av[i+1])
                i = i + 2
                continue
            }
        }
        i = i + 1
    }
    if selftest { cmd_selftest(k); exit(0) }
    _write_helper()
    println("emitted=" + HELPER_PATH)
    println("run: ANIMA_K=" + to_string(k) + " python3 " + HELPER_PATH)
    println("DONE")
}
