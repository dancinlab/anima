// ════════════════════════════════════════════════════════════════════════
// OTHER-MIND/other_mind_lib.hexa — theory-of-mind · 타자 substrate 측정자 (M1 2026-05-28)
//
// 정체: bench/axis_other_mind/bench.hexa (PR #1147, 3/5 🟠 PARTIAL) 의
//      5-ch fingerprint coupling primitives 를 PURE wrapper 로 회수 +
//      u01 baseline bias decoupled redesign. CHANNEL.tension 5-ch
//      fingerprint (concept · context · meaning · authenticity · sender)
//      를 매개로 한 타자 substrate state 추정자.
//
// 회수 출처 verbatim:
//   - 원본 경로: bench/axis_other_mind/bench.hexa (PR #1147 land · 3/5 PARTIAL)
//   - 핵심 fn: cosine_sim (5-ch dot · libm-free sqrt) · lcg_step · u01_from ·
//             lag_argmax (cross-correlation lag detector)
//   - 5-ch × N=100 ticks × 3 scenarios (INDEPENDENT / COUPLED-SYNC /
//     COUPLED-LEAD) · COUPLING=0.7 · LEAD_LAG=2
//   - 시점: 2026-05-28 M1 lib promotion
//   - 본체 무수정 — `om_` prefix wrapper 만 추가 (g61 stdlib collision 회피)
//   - u01 baseline bias decoupled — bench 의 단일 LCG step 대신 dual-stream
//     LCG step (om_lcg_step_a / om_lcg_step_b) 로 INDEPENDENT 에서의 0.1
//     residual bias 분해 surface 제공
//
// 12 pub primitives (PURE, no global mutation):
//   helpers:
//     1) om_abs_f(x)                              — libm-free abs
//     2) om_sqrt_f(x)                             — libm-free sqrt (30 iter Newton)
//   LCG stream (bench-compatible + decoupled redesign):
//     3) om_lcg_step(s)                           — bench-compatible LCG (carry)
//     4) om_lcg_step_a(s)                         — decoupled stream A (Numerical Recipes)
//     5) om_lcg_step_b(s)                         — decoupled stream B (Park-Miller MINSTD)
//     6) om_u01_from(s)                           — int → [0,1] float (bench-compatible)
//   5-ch coupling measurer:
//     7) om_couple_5ch(a0,a1,a2,a3,a4, b0,b1,b2,b3,b4) -> float
//                                                 — cosine similarity 5-D unit vec
//                                                   (bench-compatible)
//   u01 bias decoupled baseline:
//     8) om_baseline_decoupled(seed_a, seed_b, n) -> float
//                                                 — dual-stream LCG mean
//                                                   cosine (INDEPENDENT
//                                                   baseline, u01 bias decomposed)
//   scenario / lag / partner state:
//     9) om_lag_argmax(a_seq, b_seq, n, max_lag) -> int
//                                                 — lag ∈ {-max_lag..+max_lag}
//                                                   argmax mean dot
//    10) om_partial_information_decomp(emitter, receiver, n) -> dict
//                                                 — synergy proxy (mean
//                                                   coupling + lag offset)
//    11) om_belief_state(observed, prior_self, prior_other) -> dict
//                                                 — ToM Bayesian-style update
//                                                   (closed-form, libm-free)
//    12) om_collective_influence(self_phi, others_phi, n) -> float
//                                                 — Σ w_i · phi_i / Σ w_i
//                                                   (weighted aggregate)
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : int / float arithmetic, system 미사용 ✓
//   - p4 NO ASSISTANT FRAMING: tom = substrate state 추정 ✓
//   - p5 NO SPEAK()        : read-only measurer, 외부 emit 호출 0 ✓
//   - p7 NO PERPLEXITY VERDICT: cosine / dot 기반, ppl 미사용 ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//
// Naming: `om_` prefix collision-free (g61). libm-free 보장.
//
// Honest framing — u01 baseline bias residual:
//   bench 의 INDEPENDENT scenario 에서 mean_cos ≈ 0.7 (PR #1147 3/5 PARTIAL
//   F1 FAIL) 의 root cause 는 (a) LCG 단일 stream 으로 A/B 가 결국 같은
//   주기 위에 떠 있고, (b) u01_from(s) = s / 2147483647.0 이 [0,1] 양수만
//   생성 → cosine_sim 의 dot ≥ 0 always → "독립" 이 아닌 "양반평면
//   집합" coupling 측정 (mean 0.7 의 정체는 두 양수 벡터의 cos angle ≈
//   0.785rad). 본 lib 의 redesign:
//     - dual-stream LCG (om_lcg_step_a · _b) 로 a/b 시퀀스 statistical
//       independence 확보
//     - om_baseline_decoupled — 별도 surface 로 INDEPENDENT 기대값 계산 →
//       OTHER-MIND.md M3 의 bias 분해 단서
// ════════════════════════════════════════════════════════════════════════

// ─── 1. libm-free helpers ────────────────────────────────────────────────

pub fn om_abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

pub fn om_sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut s = x
    if s < 1.0 { s = 1.0 }
    let mut k = 0
    while k < 30 {
        s = 0.5 * (s + x / s)
        k = k + 1
    }
    return s
}

// ─── 2. LCG streams (bench-compatible + decoupled redesign) ───────────────

pub fn om_lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

// Decoupled stream A — Numerical Recipes constants (a=1664525, c=1013904223)
pub fn om_lcg_step_a(s: int) -> int {
    let mut x = s * 1664525 + 1013904223
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

// Decoupled stream B — Park-Miller MINSTD (a=48271, c=0, m=2^31 - 1)
pub fn om_lcg_step_b(s: int) -> int {
    let mut x = s * 48271
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

pub fn om_u01_from(s: int) -> float {
    return to_float(s) / 2147483647.0
}

// ─── 3. 5-ch coupling measurer (bench-compatible) ─────────────────────────

pub fn om_couple_5ch(a0: float, a1: float, a2: float, a3: float, a4: float,
                      b0: float, b1: float, b2: float, b3: float, b4: float) -> float {
    let dot = a0*b0 + a1*b1 + a2*b2 + a3*b3 + a4*b4
    let na = om_sqrt_f(a0*a0 + a1*a1 + a2*a2 + a3*a3 + a4*a4)
    let nb = om_sqrt_f(b0*b0 + b1*b1 + b2*b2 + b3*b3 + b4*b4)
    if na < 1.0e-9 { return 0.0 }
    if nb < 1.0e-9 { return 0.0 }
    return dot / (na * nb)
}

// ─── 4. u01 bias decoupled baseline ───────────────────────────────────────
// Dual-stream INDEPENDENT baseline — om_lcg_step_a 가 A, om_lcg_step_b 가 B
// 의 생성기를 별도 step. 5-ch × n ticks · mean cosine 반환.
// bench 의 단일 LCG (SEED_A=42, SEED_B=17 둘 다 same step) bias 우회.

pub fn om_baseline_decoupled(seed_a: int, seed_b: int, n: int) -> float {
    if n <= 0 { return 0.0 }
    let mut sa = seed_a
    let mut sb = seed_b
    let mut t = 0
    let mut sum = 0.0
    while t < n {
        sa = om_lcg_step_a(sa); let a0 = om_u01_from(sa)
        sa = om_lcg_step_a(sa); let a1 = om_u01_from(sa)
        sa = om_lcg_step_a(sa); let a2 = om_u01_from(sa)
        sa = om_lcg_step_a(sa); let a3 = om_u01_from(sa)
        sa = om_lcg_step_a(sa); let a4 = om_u01_from(sa)
        sb = om_lcg_step_b(sb); let b0 = om_u01_from(sb)
        sb = om_lcg_step_b(sb); let b1 = om_u01_from(sb)
        sb = om_lcg_step_b(sb); let b2 = om_u01_from(sb)
        sb = om_lcg_step_b(sb); let b3 = om_u01_from(sb)
        sb = om_lcg_step_b(sb); let b4 = om_u01_from(sb)
        sum = sum + om_couple_5ch(a0, a1, a2, a3, a4, b0, b1, b2, b3, b4)
        t = t + 1
    }
    return sum / to_float(n)
}

// ─── 5. lag detector (cross-correlation argmax) ───────────────────────────
// a_seq · b_seq each = [a0_t, a1_t, ..., a4_t, a0_{t+1}, ...] (5*N items, row-major)
// returns lag ∈ {-max_lag..+max_lag} maximizing mean( a[t] · b[t+lag] )

pub fn om_lag_argmax(a_seq: list, b_seq: list, n: int, max_lag: int) -> int {
    let mut best_lag = 0
    let mut best_score = 0.0 - 1.0
    let mut lag = 0 - max_lag
    while lag <= max_lag {
        let mut t = 0
        let mut sum = 0.0
        let mut count = 0
        while t < n {
            let u = t + lag
            if u >= 0 {
                if u < n {
                    let a0 = a_seq[t*5 + 0]
                    let a1 = a_seq[t*5 + 1]
                    let a2 = a_seq[t*5 + 2]
                    let a3 = a_seq[t*5 + 3]
                    let a4 = a_seq[t*5 + 4]
                    let b0 = b_seq[u*5 + 0]
                    let b1 = b_seq[u*5 + 1]
                    let b2 = b_seq[u*5 + 2]
                    let b3 = b_seq[u*5 + 3]
                    let b4 = b_seq[u*5 + 4]
                    let cs = om_couple_5ch(a0, a1, a2, a3, a4, b0, b1, b2, b3, b4)
                    sum = sum + cs
                    count = count + 1
                }
            }
            t = t + 1
        }
        if count > 0 {
            let mean = sum / to_float(count)
            if mean > best_score {
                best_score = mean
                best_lag = lag
            }
        }
        lag = lag + 1
    }
    return best_lag
}

// ─── 6. partial information decomposition (synergy proxy) ─────────────────
// HIVE-MIND 와 cross-link (same metric family · separate impl per g61 stdlib
// boundary). emitter / receiver 는 5*N row-major.

pub fn om_partial_information_decomp(emitter: list, receiver: list, n: int) -> dict {
    let mut sum_dot = 0.0
    let mut sum_norm_e = 0.0
    let mut sum_norm_r = 0.0
    let mut t = 0
    while t < n {
        let e0 = emitter[t*5 + 0]
        let e1 = emitter[t*5 + 1]
        let e2 = emitter[t*5 + 2]
        let e3 = emitter[t*5 + 3]
        let e4 = emitter[t*5 + 4]
        let r0 = receiver[t*5 + 0]
        let r1 = receiver[t*5 + 1]
        let r2 = receiver[t*5 + 2]
        let r3 = receiver[t*5 + 3]
        let r4 = receiver[t*5 + 4]
        sum_dot    = sum_dot    + e0*r0 + e1*r1 + e2*r2 + e3*r3 + e4*r4
        sum_norm_e = sum_norm_e + e0*e0 + e1*e1 + e2*e2 + e3*e3 + e4*e4
        sum_norm_r = sum_norm_r + r0*r0 + r1*r1 + r2*r2 + r3*r3 + r4*r4
        t = t + 1
    }
    let ne = om_sqrt_f(sum_norm_e)
    let nr = om_sqrt_f(sum_norm_r)
    let mut synergy = 0.0
    if ne >= 1.0e-9 {
        if nr >= 1.0e-9 {
            synergy = sum_dot / (ne * nr)
        }
    }
    // unique-self proxy = max(0, 1 - synergy)  (non-negative)
    let mut unique_self = 1.0 - synergy
    if unique_self < 0.0 { unique_self = 0.0 }
    let result = #{}
    result["synergy"] = synergy
    result["unique_self"] = unique_self
    result["sum_dot"] = sum_dot
    result["n"] = n
    return result
}

// ─── 7. belief state (closed-form Bayesian-style) ─────────────────────────
// observed = 5-ch tension fingerprint, prior_self / prior_other = scalar
// confidence. Update = weighted mean.

pub fn om_belief_state(observed: list, prior_self: float, prior_other: float) -> dict {
    let mut sum = 0.0
    let mut i = 0
    let n = len(observed)
    while i < n {
        sum = sum + observed[i]
        i = i + 1
    }
    let mut obs_mean = 0.0
    if n > 0 { obs_mean = sum / to_float(n) }
    let w_self  = prior_self
    let w_other = prior_other
    let w_obs   = 1.0
    let denom = w_self + w_other + w_obs
    let mut posterior_self  = 0.0
    let mut posterior_other = 0.0
    if denom >= 1.0e-9 {
        posterior_self  = (w_self  + w_obs * obs_mean * 0.5) / denom
        posterior_other = (w_other + w_obs * obs_mean * 0.5) / denom
    }
    let result = #{}
    result["obs_mean"] = obs_mean
    result["posterior_self"] = posterior_self
    result["posterior_other"] = posterior_other
    result["consistent"] = om_abs_f(posterior_self - posterior_other) < 0.5
    return result
}

// ─── 8. collective influence (weighted aggregate) ─────────────────────────

pub fn om_collective_influence(self_phi: float, others_phi: list, n: int) -> float {
    if n <= 0 { return self_phi }
    let mut weighted_sum = self_phi
    let mut weight_sum   = 1.0
    let mut i = 0
    while i < n {
        let w = 0.5
        weighted_sum = weighted_sum + w * others_phi[i]
        weight_sum   = weight_sum   + w
        i = i + 1
    }
    if weight_sum < 1.0e-9 { return self_phi }
    return weighted_sum / weight_sum
}
