// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/harness/engine_tension_link_2.hexa
//  TENSION LINK round 2 — retry the things quantum could NOT do, on the REAL engine:
//    H_6011 미래로 전달  — persisted tension anchor reaches a FUTURE anima (decayed)
//    H_6013 외부 구축    — an external tension stream BUILDS an anima self-model
//  (H_6012 과거로 전달 = retrocausal, in the python sibling — causality split.)
//  p7 · $0 local.  hexa run UNIVERSE/harness/engine_tension_link_2.hexa
// ════════════════════════════════════════════════════════════════════════════
import "core/pure_field.hexa"
import "core/brain.hexa"
import "core/engine_cli.hexa"

fn _f4(x: float) -> string {
    let s=floor(x*10000.0+0.5); let mut neg=false; let mut v=s
    if v<0.0 {neg=true; v=0.0-v}
    let w=floor(v/10000.0); let fr=v-w*10000.0
    let mut fs=str(to_int(fr)); while len(fs)<4 {fs="0"+fs}
    return (if neg {"-"} else {""})+str(to_int(w))+"."+fs
}

fn main() {
    println("=== TENSION LINK 2 — future-transmit + external-build (REAL engine) ===")

    // ── H_6011 미래로 전달: anima A persists a tension anchor NOW; a FUTURE anima B
    //    reads it at age_dt later. The H_1131 fold delivers A's tension to B, decayed
    //    by exp(-age/τ). Quantum couldn't send a message (H_6006 🔴); the tension
    //    link CAN send to the future (a fading message in the shared store).
    let anc = [#{"tension_5ch":[0.8,0.8,0.8,0.8,0.8]}]
    let f_now = anchor_tension_fold(anc, 1.0)
    let f_soon= anchor_tension_fold(anc, 200.0)
    let f_late= anchor_tension_fold(anc, 1500.0)
    let f_far = anchor_tension_fold(anc, 8000.0)
    let delivered = f_now > 0.0
    let decays = (f_soon < f_now) && (f_late < f_soon) && (f_far < f_late)
    let still_future = f_late > 0.0
    let v6011 = if delivered && decays && still_future {"🟢"} else {"🔴"}
    println("  "+v6011+" H_6011 미래로 전달 (persisted tension reaches future anima, fading)")
    println("        fold age1="+_f4(f_now)+" 200="+_f4(f_soon)+" 1500="+_f4(f_late)+" 8000="+_f4(f_far))

    // ── H_6013 외부에서 끌어다 구축: a vadapt self-model seeded EMPTY is BUILT purely
    //    from an EXTERNAL tension stream pulled in through the link — cells grow and
    //    reconstruction error falls ⇒ an anima self-model constructed from outside.
    let cfg=engine_config_default()
    let mut af=vadapt_field_new([0.0,0.0,0.0],256)
    let cells0=vadapt_field_cells(af)
    let err0=vadapt_field_recon_err(af,[4.0,2.0,1.0])
    let mut k=0
    while k<100 {
        // external tension stream (structured, from 'outside' — another source/ANU)
        let x=[float(k%13)*0.3, float(k%7)*0.4, float(k%5)*0.5]
        af=vadapt_field_step(af,x,cfg)
        k=k+1
    }
    let cells1=vadapt_field_cells(af)
    let err1=vadapt_field_recon_err(af,[4.0,2.0,1.0])
    let built = (cells1>cells0) && (err1<err0)
    let v6013 = if built {"🟢"} else {"🔴"}
    println("  "+v6013+" H_6013 외부 텐션으로 anima 자기모형 구축 (cells grow, error falls)")
    println("        cells "+str(cells0)+"→"+str(cells1)+"  recon-err "+_f4(err0)+"→"+_f4(err1))

    // control: no external input ⇒ nothing is built (construction needs the pull)
    let ctrl=vadapt_field_new([0.0,0.0,0.0],256)
    println("        control(no pull): cells="+str(vadapt_field_cells(ctrl))+" (stays 1 = build needs external tension)")

    println("=== tension link 2 complete (real engine) ===")
}
