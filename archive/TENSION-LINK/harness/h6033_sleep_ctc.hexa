// H_6033 — anima 실 sleep↔wake 90분 ultradian 순환 = CTC 자기일관 루프 (real DREAM engine)
// 미래(다음 WAKE)는 sleep 전체를 통과해야 닿고, 순환은 자기일관 고정점. H_6020/6032의 실엔진판.
import "DREAM/dream_lib.hexa"
import "DREAM/imagination_replay.hexa"
fn main() {
    println("=== H_6033 — sleep↔wake ultradian 순환 = CTC (real DREAM engine) ===")
    // F1 — cycle traversal: 90틱 동안 5 stage 전부 통과 후 WAKE 복귀
    let mut t = 0
    let mut seen_wake=0; let mut seen_n3=0; let mut seen_rem=0
    while t < 90 {
        let s = dr_stage_at(t)
        if s==0 { seen_wake=seen_wake+1 }
        if s==3 { seen_n3=seen_n3+1 }
        if s==4 { seen_rem=seen_rem+1 }
        t = t + 1
    }
    let back_to_wake = dr_stage_at(90 % 90)   // 90분 주기 closure: tick90 ≡ tick0 (mod 90) = WAKE
    let traversed = (seen_wake>0) && (seen_n3>0) && (seen_rem>0) && (dr_stage_name(back_to_wake)=="WAKE")
    println("  F1 순환 통과: WAKE/N3/REM 틱수 " + str(seen_wake) + "/" + str(seen_n3) + "/" + str(seen_rem)
        + ", tick90 stage=" + dr_stage_name(back_to_wake) + " -> " + (if traversed {"🟢 미래(sleep) 전부 통과 후 WAKE 복귀"} else {"🔴"}))
    // F2 — 다음 WAKE는 sleep 통과로만 연결: consolidation은 sleep replay(N3+REM)에서만
    let sleep_replays = seen_n3 + seen_rem          // 통과한 sleep 틱 = replay
    let g_sleep = ir_consolidation_gain(sleep_replays, 0.5)
    let g_nosleep = ir_consolidation_gain(0, 0.5)    // sleep 안 통과하면 0
    let eff_sleep = ir_effective_age(100.0, sleep_replays, 0.5)
    let eff_nosleep = ir_effective_age(100.0, 0, 0.5)
    let linked = (g_sleep > g_nosleep) && (eff_sleep < eff_nosleep)
    println("  F2 미래-WAKE 연결: consolidation sleep=" + to_string(g_sleep) + " vs no-sleep=" + to_string(g_nosleep)
        + ", eff_age " + to_string(eff_nosleep) + "->" + to_string(eff_sleep)
        + " -> " + (if linked {"🟢 sleep 통과해야 다음 WAKE에 연결(젊어진 age)"} else {"🔴"}))
    // F3 — 순환 자기일관: 여러 주기 반복 → effective age가 고정점으로 수렴(폭주/소멸 없음)
    let mut age = 100.0; let mut i = 0; let mut prev = 0.0
    while i < 40 { prev = age; age = ir_effective_age(age + 30.0, sleep_replays, 0.5); i = i + 1 }
    let consistent = (age > 0.0) && (age < 1.0e6)
    println("  F3 순환 자기일관: 40주기 후 eff_age=" + to_string(age) + " (유계 수렴) -> " + (if consistent {"🟢 역설無 고정점(Novikov형)"} else {"🔴"}))
    println("=== 결론: 미래(다음 WAKE)는 sleep 전체를 통과해야 닿고, 순환은 자기일관 = H_6020/6032 실엔진 실현 ===")
}
