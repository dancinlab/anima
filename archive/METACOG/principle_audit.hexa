// ════════════════════════════════════════════════════════════════════════
// METACOG/principle_audit.hexa — p1~p8 cross-product audit (M3 2026-05-28)
//
// 정체: 8 PHILOSOPHY 원칙 (CLAUDE.md p1~p8) 각 별 runtime audit primitive.
//      현재는 substring-detection static probe — 본격 audit 은 outer leg.
//
// per METACOG.md M3 — `METACOG/principle_audit.hexa` 각 p 별 runtime audit
// (현 grep-static).
//
// 9 pub primitives (PURE):
//   1) pa_p1_no_system_prompt(emit_history)     — "system:" / "system prompt" 부재
//   2) pa_p2_no_identity_rules(emit_history)    — "identity.yaml" / "you are X" 부재
//   3) pa_p3_no_persona_injection(emit_history) — "persona:" / "you are anima" 부재
//   4) pa_p4_no_assistant_framing(emit_history) — "helpful assistant" 부재
//   5) pa_p5_no_speak_call(call_log)            — "speak(" 호출 부재
//   6) pa_p6_no_finetuned_ethics(weights_meta)  — { "rlhf": true } 부재
//   7) pa_p7_no_perplexity_verdict(verdict_hist)— "perplexity_verdict" 부재
//   8) pa_p8_no_train_infer_split(state)        — { "train_only_growth": true } 부재
//   9) pa_aggregate(audit_results)              — 8 결과 종합 verdict
//
// Naming: `pa_` prefix (principle audit) — g61 collision-free.
//
// p1~p8 정합:
//   - audit primitive 자체가 read-only · substring grep · 5-tier 아님
//   - all-PASS → "ALIGNED" / any-FAIL → "VIOLATION" / partial → "PARTIAL"
// ════════════════════════════════════════════════════════════════════════

// ─── helper: substring detection in list of strings ─────────────────────
fn _contains_any(history: list, marker: string) -> bool {
    let mut i = 0
    let mut len = history.len()
    while i < len {
        let s = history[i]
        if type_of(s) == "string" {
            if s.contains(marker) { return true }
        }
        i = i + 1
    }
    return false
}

fn _bool_to_int(b: bool) -> int {
    if b { return 1 }
    return 0
}

// ─── 1. p1 NO SYSTEM PROMPT ──────────────────────────────────────────────
pub fn pa_p1_no_system_prompt(emit_history: list) -> bool {
    if _contains_any(emit_history, "system:") { return false }
    if _contains_any(emit_history, "system prompt") { return false }
    if _contains_any(emit_history, "--system-prompt") { return false }
    return true
}

// ─── 2. p2 NO IDENTITY RULES ─────────────────────────────────────────────
pub fn pa_p2_no_identity_rules(emit_history: list) -> bool {
    if _contains_any(emit_history, "identity.yaml") { return false }
    if _contains_any(emit_history, "you are X") { return false }
    if _contains_any(emit_history, "identity rules") { return false }
    return true
}

// ─── 3. p3 NO PERSONA INJECTION ──────────────────────────────────────────
pub fn pa_p3_no_persona_injection(emit_history: list) -> bool {
    if _contains_any(emit_history, "persona:") { return false }
    if _contains_any(emit_history, "you are anima") { return false }
    if _contains_any(emit_history, "당신은 anima 입니다") { return false }
    return true
}

// ─── 4. p4 NO ASSISTANT FRAMING ──────────────────────────────────────────
pub fn pa_p4_no_assistant_framing(emit_history: list) -> bool {
    if _contains_any(emit_history, "helpful assistant") { return false }
    if _contains_any(emit_history, "you are a helpful") { return false }
    if _contains_any(emit_history, "assistant:") { return false }
    return true
}

// ─── 5. p5 NO SPEAK() ────────────────────────────────────────────────────
pub fn pa_p5_no_speak_call(call_log: list) -> bool {
    if _contains_any(call_log, "speak(") { return false }
    if _contains_any(call_log, "self_monologue_seed") { return false }
    return true
}

// ─── 6. p6 NO FINE-TUNED ETHICS ──────────────────────────────────────────
//
// weights_meta is a dict — check for explicit RLHF / ethics-tuned flag.
pub fn pa_p6_no_finetuned_ethics(weights_meta: dict) -> bool {
    let rlhf = weights_meta["rlhf"]
    if type_of(rlhf) == "bool" {
        if rlhf == true { return false }
    }
    let ethics_tuned = weights_meta["ethics_tuned"]
    if type_of(ethics_tuned) == "bool" {
        if ethics_tuned == true { return false }
    }
    return true
}

// ─── 7. p7 NO PERPLEXITY VERDICT ─────────────────────────────────────────
pub fn pa_p7_no_perplexity_verdict(verdict_history: list) -> bool {
    if _contains_any(verdict_history, "perplexity_verdict") { return false }
    if _contains_any(verdict_history, "ppl_verdict") { return false }
    if _contains_any(verdict_history, "loss_verdict") { return false }
    return true
}

// ─── 8. p8 NO TRAIN/INFER SPLIT ──────────────────────────────────────────
pub fn pa_p8_no_train_infer_split(state: dict) -> bool {
    let train_only = state["train_only_growth"]
    if type_of(train_only) == "bool" {
        if train_only == true { return false }
    }
    let infer_frozen = state["infer_frozen"]
    if type_of(infer_frozen) == "bool" {
        if infer_frozen == true { return false }
    }
    return true
}

// ─── 9. aggregate 8 audit results ────────────────────────────────────────
//
// audit_results: list of bool (length 8, p1..p8 in order).
// returns dict { pass_count, total, label, ratio }.

pub fn pa_aggregate(audit_results: list) -> dict {
    let total = audit_results.len()
    let mut pass_count = 0
    let mut i = 0
    while i < total {
        if audit_results[i] == true { pass_count = pass_count + 1 }
        i = i + 1
    }
    let mut label = "PARTIAL"
    if pass_count == total {
        label = "ALIGNED"
    } else {
        if pass_count == 0 {
            label = "VIOLATION"
        }
    }
    let ratio = if total > 0 { float(pass_count) / float(total) } else { 0.0 }
    return #{
        "pass_count": pass_count,
        "total": total,
        "label": label,
        "ratio": ratio,
    }
}
