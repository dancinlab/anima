// core_causal_v2.hexa — Phase 1 reimpl with input channel x
// axis: causal — lag-1 autocorrelation as transfer-entropy proxy on time series x_t

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[causal] category=core axis=\"causal (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// mean
let mut s = 0.0
for v in xs { s = s + v }
let mean = s / to_float(n)

// variance
let mut sq = 0.0
for v in xs { let d = v - mean; sq = sq + d * d }
let variance = sq / to_float(n)

// lag-1 autocovariance
let mut ac1 = 0.0
let mut j = 1
while j < n {
    ac1 = ac1 + (xs[j] - mean) * (xs[j-1] - mean)
    j = j + 1
}
ac1 = ac1 / to_float(n - 1)

// autocorrelation r1 = ac1 / variance (Pearson r between x_t and x_{t-1})
let r1 = if variance > 0.000001 { ac1 / variance } else { 0.0 }
let r1_abs = if r1 < 0.0 { 0.0 - r1 } else { r1 }
let r1_clip = if r1_abs > 1.0 { 1.0 } else { r1_abs }

// transfer-entropy proxy: -0.5 * log(1 - r1^2)   (Gaussian TE = -0.5 log(1-r^2))
let inner = 1.0 - r1_clip * r1_clip
let te_proxy = if inner > 0.000001 { -0.5 * log(inner) } else { 3.0 }
// normalize: te ∈ [0, ~3]; squash by te / (te + 1)
let causal_score = te_proxy / (te_proxy + 1.0)

let score = causal_score
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[causal] category=core axis=\"Causal arrow — lag-1 transfer-entropy proxy (-0.5 log(1-r^2))\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"r1\":" + to_string(r1) + ",\"te_proxy\":" + to_string(te_proxy) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
