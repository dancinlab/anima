// core_gravity_v2.hexa — Phase 1 reimpl with input channel x
// axis: gravity — curvature proxy (discrete second derivative norm)

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[gravity] category=core axis=\"gravity (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// Discrete Laplacian (curvature κ_t ≈ x_{t+1} - 2 x_t + x_{t-1}) — Ricci-flow analog.
// Norm of curvature field = mean |κ_t|.
let mut s_kappa = 0.0
let mut s_kappa_sq = 0.0
let mut i = 1
while i < (n - 1) {
    let kappa = xs[i+1] - 2.0 * xs[i] + xs[i-1]
    let abs_k = if kappa < 0.0 { 0.0 - kappa } else { kappa }
    s_kappa = s_kappa + abs_k
    s_kappa_sq = s_kappa_sq + kappa * kappa
    i = i + 1
}
let m = to_float(n - 2)
let mean_abs_kappa = s_kappa / m
let rms_kappa = sqrt(s_kappa_sq / m)

// "Gravitational clustering" proxy: 1 - (curvature / span)
// signal: smooth signal (low curvature) → high gravity score (mass concentrated)
//         noisy signal (high curvature) → low gravity score
let mut x_min = xs[0]
let mut x_max = xs[0]
let mut j = 1
while j < n {
    if xs[j] < x_min { x_min = xs[j] }
    if xs[j] > x_max { x_max = xs[j] }
    j = j + 1
}
let span = if x_max - x_min > 0.000001 { x_max - x_min } else { 1.0 }
let curv_ratio = rms_kappa / span
let curv_clip = if curv_ratio > 1.0 { 1.0 } else { curv_ratio }
let cluster_score = 1.0 - curv_clip

// Metric-tensor norm proxy: variance of x normalized
let mut s = 0.0
for v in xs { s = s + v }
let mean_x = s / to_float(n)
let mut s_var = 0.0
for v in xs { let d = v - mean_x; s_var = s_var + d * d }
let var_x = s_var / to_float(n)
let metric_norm = sqrt(var_x) / (span * 0.5)
let metric_clip = if metric_norm > 1.0 { 1.0 } else { metric_norm }

let score = 0.6 * cluster_score + 0.4 * metric_clip
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[gravity] category=core axis=\"Gravitational clustering — discrete Laplacian curvature (Ricci proxy) + metric norm\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"rms_kappa\":" + to_string(rms_kappa) + ",\"cluster_score\":" + to_string(cluster_score) + ",\"metric_norm\":" + to_string(metric_clip) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
