// core_quantum_v2.hexa — Phase 1 reimpl with input channel x
// axis: quantum — superposition coherence proxy via off-diagonal density-matrix element norm

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[quantum] category=core axis=\"quantum (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// Build pseudo density-matrix rho on n_states=8 basis from histogram of x.
// Diagonal = histogram counts (populations). Off-diagonal = pairwise sqrt(p_i p_j) * coherence_factor
// where coherence_factor proxied by FFT-free sinusoid sum / (mean) on the bin index.
let nb = 8
let mut x_min = xs[0]
let mut x_max = xs[0]
let mut i = 1
while i < n {
    if xs[i] < x_min { x_min = xs[i] }
    if xs[i] > x_max { x_max = xs[i] }
    i = i + 1
}
let span = if x_max - x_min > 0.000001 { x_max - x_min } else { 1.0 }

let mut bc = []
let mut bi = 0
while bi < nb { bc.push(0); bi = bi + 1 }
for v in xs {
    let raw_idx = floor((v - x_min) / span * to_float(nb))
    let i_clip = if raw_idx >= to_float(nb) { nb - 1 } else { to_int(raw_idx) }
    let idx = if i_clip < 0 { 0 } else { i_clip }
    bc[idx] = bc[idx] + 1
}

let n_f = to_float(n)
let mut ps = []
let mut bj = 0
while bj < nb {
    ps.push(to_float(bc[bj]) / n_f)
    bj = bj + 1
}

// Off-diagonal coherence: Σ_{i<j} sqrt(p_i * p_j) — purity-like coherence indicator.
// Maximum when populations are uniform (max superposition), 0 when single basis state.
let mut off_diag = 0.0
let mut ii = 0
while ii < nb {
    let mut jj = ii + 1
    while jj < nb {
        off_diag = off_diag + sqrt(ps[ii] * ps[jj])
        jj = jj + 1
    }
    ii = ii + 1
}
// max = nb*(nb-1)/2 * (1/nb) = (nb-1)/2 (uniform pop sqrt(1/nb * 1/nb) = 1/nb per pair)
let max_off = to_float(nb - 1) / 2.0
let coherence = off_diag / max_off
let coh_clip = if coherence > 1.0 { 1.0 } else { coherence }

// Bell-violation proxy: |<x_even * x_odd>| - 0.5 (CHSH-style threshold proxy)
let mut s_eo = 0.0
let mut p = 0
while p < (n - 1) {
    s_eo = s_eo + xs[p] * xs[p+1]
    p = p + 2
}
let mean_eo = s_eo / to_float(n / 2)
let bell_proxy = if mean_eo < 0.0 { 0.0 - mean_eo } else { mean_eo }
let bell_norm = if bell_proxy > 1.0 { 1.0 } else { bell_proxy }

let score = 0.6 * coh_clip + 0.4 * bell_norm
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[quantum] category=core axis=\"Quantum-like superposition — density-matrix off-diagonal coherence + Bell proxy\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"coherence\":" + to_string(coh_clip) + ",\"bell_proxy\":" + to_string(bell_proxy) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
