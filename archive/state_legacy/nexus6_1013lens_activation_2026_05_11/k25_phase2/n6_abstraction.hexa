// n6_abstraction.hexa — Phase 2 reimpl (cross-cat n6 industrial top-1)
// axis: abstraction layers / compression — entropy reduction via coarse-graining
// kernel: H_fine = entropy at scale 1, H_coarse = entropy at scale 8.
//         compression = 1 - H_coarse / H_fine. abstraction_score = max(0, compression).

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)

if n < 32 {
    println("lens[abstraction] category=extended axis=\"abstraction (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

let mut x_min = xs[0]; let mut x_max = xs[0]
let mut i = 1
while i < n {
    if xs[i] < x_min { x_min = xs[i] }
    if xs[i] > x_max { x_max = xs[i] }
    i = i + 1
}
let span = if x_max - x_min > 0.000001 { x_max - x_min } else { 1.0 }

let B = 8
// Fine entropy (scale 1)
let mut cf = []
let mut bf = 0
while bf < B { cf.push(0); bf = bf + 1 }
let mut k1 = 0
while k1 < n {
    let raw = floor((xs[k1] - x_min) / span * to_float(B))
    let idx = if raw >= to_float(B) { B - 1 } else { if to_int(raw) < 0 { 0 } else { to_int(raw) } }
    cf[idx] = cf[idx] + 1
    k1 = k1 + 1
}
let nf = to_float(n)
let mut h_fine = 0.0
let mut bj1 = 0
while bj1 < B {
    let c = cf[bj1]
    if c > 0 {
        let p = to_float(c) / nf
        h_fine = h_fine - p * log(p)
    }
    bj1 = bj1 + 1
}
let h_max = log(to_float(B))
let h_fine_n = h_fine / h_max

// Coarse entropy (scale 8): block-mean
let s = 8
let m = n / s
let mut cc = []
let mut bc = 0
while bc < B { cc.push(0); bc = bc + 1 }
let mut p_idx = 0
while p_idx < m {
    let mut bs = 0.0
    let mut q = 0
    while q < s { bs = bs + xs[p_idx * s + q]; q = q + 1 }
    let v = bs / to_float(s)
    let raw = floor((v - x_min) / span * to_float(B))
    let idx = if raw >= to_float(B) { B - 1 } else { if to_int(raw) < 0 { 0 } else { to_int(raw) } }
    cc[idx] = cc[idx] + 1
    p_idx = p_idx + 1
}
let mf = to_float(m)
let mut h_coarse = 0.0
let mut bj2 = 0
while bj2 < B {
    let c = cc[bj2]
    if c > 0 {
        let p = to_float(c) / mf
        h_coarse = h_coarse - p * log(p)
    }
    bj2 = bj2 + 1
}
let h_coarse_n = h_coarse / h_max

let compression_raw = if h_fine_n > 0.000001 { 1.0 - h_coarse_n / h_fine_n } else { 0.0 }
let compression = if compression_raw < 0.0 { 0.0 } else { if compression_raw > 1.0 { 1.0 } else { compression_raw } }

// Bonus: stability of coarse representation
let abstraction_bonus = h_coarse_n

let score = 0.7 * compression + 0.3 * abstraction_bonus
let sc = if score < 0.0 { 0.0 } else { if score > 1.0 { 1.0 } else { score } }
let hits = if sc > 0.5 { 6 } else { if sc > 0.3 { 4 } else { 2 } }
println("lens[abstraction] category=extended axis=\"Abstraction — entropy compression (1 - H_coarse/H_fine) + coarse-rep entropy\" score=" + to_string(sc) + " support=1 n=" + to_string(n) + " meta={\"h_fine\":" + to_string(h_fine_n) + ",\"h_coarse\":" + to_string(h_coarse_n) + ",\"compression\":" + to_string(compression) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
