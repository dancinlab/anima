// core_stability_v2.hexa — Phase 1 reimpl with input channel x
// axis: stability — Lyapunov-like divergence rate proxy + fixed-point variance

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 16 {
    println("lens[stability] category=core axis=\"stability (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// Lyapunov proxy: mean log|x_{t+1} - x_t| (averaged over t).
// Stable trajectory → low log → high stability score
let mut s_log_diff = 0.0
let mut count = 0
let mut i = 1
while i < n {
    let d = xs[i] - xs[i-1]
    let abs_d = if d < 0.0 { 0.0 - d } else { d }
    if abs_d > 0.000001 {
        s_log_diff = s_log_diff + log(abs_d)
        count = count + 1
    }
    i = i + 1
}
let mean_log_diff = if count > 0 { s_log_diff / to_float(count) } else { -10.0 }
// stable: mean_log_diff << 0. transform to [0,1]: stability = sigmoid(-mean_log_diff - 1)
let lyap_arg = 0.0 - mean_log_diff - 1.0
let lyap_score = 1.0 / (1.0 + exp(-1.0 * lyap_arg))

// Fixed-point convergence: tail variance / head variance ratio
let head_n = n / 4
let tail_n = n / 4
let mut s_head = 0.0
let mut s_tail = 0.0
let mut a = 0
while a < head_n { s_head = s_head + xs[a]; a = a + 1 }
let mut b = 0
while b < tail_n { s_tail = s_tail + xs[n - tail_n + b]; b = b + 1 }
let mean_head = s_head / to_float(head_n)
let mean_tail = s_tail / to_float(tail_n)

let mut var_head = 0.0
let mut var_tail = 0.0
let mut c1 = 0
while c1 < head_n { let d = xs[c1] - mean_head; var_head = var_head + d * d; c1 = c1 + 1 }
let mut c2 = 0
while c2 < tail_n {
    let d = xs[n - tail_n + c2] - mean_tail
    var_tail = var_tail + d * d
    c2 = c2 + 1
}
var_head = var_head / to_float(head_n)
var_tail = var_tail / to_float(tail_n)

// fp_conv = head_var / (head_var + tail_var) — high if tail var << head var (converging to fixed point)
let denom_v = var_head + var_tail
let fp_conv = if denom_v > 0.000001 { var_head / denom_v } else { 0.5 }

let score = 0.6 * lyap_score + 0.4 * fp_conv
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[stability] category=core axis=\"Stability — Lyapunov |Δx| log-rate + fixed-point convergence (head/tail variance)\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"mean_log_diff\":" + to_string(mean_log_diff) + ",\"lyap_score\":" + to_string(lyap_score) + ",\"fp_conv\":" + to_string(fp_conv) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
