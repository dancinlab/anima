// core_wave.hexa — Phase 2 reimpl with input channel x
// axis: oscillation / wave — zero-crossing count + sign-change density
// kernel: detrend (subtract mean). zero-crossings = #sign(xs[i]) != sign(xs[i+1]).
//         zc_norm = zc / (n-1). + lag-1 autocorrelation negativity (oscillatory signal).

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)

if n < 8 {
    println("lens[wave] category=core axis=\"wave (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// detrend
let mut s_x = 0.0
let mut i = 0
while i < n { s_x = s_x + xs[i]; i = i + 1 }
let mu = s_x / to_float(n)
let mut dt = []
let mut j = 0
while j < n { dt.push(xs[j] - mu); j = j + 1 }

// zero crossings
let mut zc = 0
let mut k = 1
while k < n {
    let prev = dt[k-1]
    let cur = dt[k]
    if (prev > 0.0 && cur < 0.0) || (prev < 0.0 && cur > 0.0) {
        zc = zc + 1
    }
    k = k + 1
}
let zc_norm = to_float(zc) / to_float(n - 1)

// lag-1 autocorr (negative indicates oscillation)
let mut s_xy = 0.0
let mut s_xx = 0.0
let mut s_yy = 0.0
let mut k2 = 1
while k2 < n {
    s_xy = s_xy + dt[k2-1] * dt[k2]
    s_xx = s_xx + dt[k2-1] * dt[k2-1]
    s_yy = s_yy + dt[k2] * dt[k2]
    k2 = k2 + 1
}
let denom = sqrt(s_xx * s_yy)
let r1 = if denom > 0.000001 { s_xy / denom } else { 0.0 }
// oscillation: r1 close to -1 → strong oscillator. wave_score from -r1 → [0,1]
let osc_raw = 0.0 - r1
let osc = (osc_raw + 1.0) / 2.0
let osc_clip = if osc < 0.0 { 0.0 } else { if osc > 1.0 { 1.0 } else { osc } }

let score = 0.6 * zc_norm + 0.4 * osc_clip
let sc = if score < 0.0 { 0.0 } else { if score > 1.0 { 1.0 } else { score } }
let hits = if sc > 0.5 { 6 } else { if sc > 0.3 { 4 } else { 2 } }
println("lens[wave] category=core axis=\"Wave/Oscillation — zero-crossing density + lag-1 anti-correlation (oscillator signature)\" score=" + to_string(sc) + " support=1 n=" + to_string(n) + " meta={\"zc\":" + to_string(zc) + ",\"zc_norm\":" + to_string(zc_norm) + ",\"r1\":" + to_string(r1) + ",\"osc\":" + to_string(osc) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
