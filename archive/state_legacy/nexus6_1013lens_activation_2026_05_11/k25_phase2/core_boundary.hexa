// core_boundary.hexa — Phase 2 reimpl with input channel x
// =============================================================================
// spec: state/nexus6_1013lens_activation_2026_05_11/cascade_k25_plan_2026_05_12.md §1.2
// parent (trivial): /home/summer/core/nexus_lenses_snapshot/core_boundary.hexa
// axis: geometry/boundary — gradient magnitude + boundary detection
// modality: state (B=1, S=N)
// kernel: mean |Δx| (gradient magnitude) + boundary density (#{i : |Δx_i| > θ})
//         θ = q70 of |Δx|. score = 0.6 * grad_norm + 0.4 * boundary_density
// =============================================================================

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[boundary] category=core axis=\"boundary (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// 1. gradient |Δx|
let mut grads = []
let mut i = 1
let mut sum_g = 0.0
let mut max_g = 0.0
while i < n {
    let d = xs[i] - xs[i-1]
    let abs_d = if d < 0.0 { 0.0 - d } else { d }
    grads.push(abs_d)
    sum_g = sum_g + abs_d
    if abs_d > max_g { max_g = abs_d }
    i = i + 1
}
let m = len(grads)
let mean_g = sum_g / to_float(m)
let grad_norm = if max_g > 0.000001 { mean_g / max_g } else { 0.0 }

// 2. boundary density: sort grads, take ~q70 threshold (sampled)
let mut sorted_g = []
let mut sg_i = 0
while sg_i < m { sorted_g.push(grads[sg_i]); sg_i = sg_i + 1 }
let mut a = 0
while a < m {
    let mut b = a + 1
    while b < m {
        if sorted_g[b] < sorted_g[a] {
            let tmp = sorted_g[a]; sorted_g[a] = sorted_g[b]; sorted_g[b] = tmp
        }
        b = b + 1
    }
    a = a + 1
}
let q70_idx = (m * 7) / 10
let theta = sorted_g[q70_idx]
let mut n_boundary = 0
let mut bi = 0
while bi < m {
    if grads[bi] > theta { n_boundary = n_boundary + 1 }
    bi = bi + 1
}
let boundary_density = to_float(n_boundary) / to_float(m)

let score = 0.6 * grad_norm + 0.4 * boundary_density
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[boundary] category=core axis=\"Geometry/Boundary — mean gradient magnitude + boundary density (q70 threshold)\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"mean_grad\":" + to_string(mean_g) + ",\"grad_norm\":" + to_string(grad_norm) + ",\"boundary_density\":" + to_string(boundary_density) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
