// core_evolution.hexa — Phase 2 reimpl with input channel x
// =============================================================================
// spec: state/nexus6_1013lens_activation_2026_05_11/cascade_k25_plan_2026_05_12.md §1.2
// parent (trivial): /home/summer/core/nexus_lenses_snapshot/core_evolution.hexa
// axis: evolution/selection — temporal difference + fitness landscape gradient
// modality: state (B=1, S=N, time series)
// kernel: mean |x_{t+1} - x_t| (selection pressure proxy)
//       + adaptive monotone trend test (longest monotone subsequence ratio).
// =============================================================================

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[evolution] category=core axis=\"evolution (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// Temporal difference E[|Δx|]
let mut sum_d = 0.0
let mut i = 1
while i < n {
    let d = xs[i] - xs[i-1]
    let abs_d = if d < 0.0 { 0.0 - d } else { d }
    sum_d = sum_d + abs_d
    i = i + 1
}
let mean_diff = sum_d / to_float(n - 1)
let diff_norm = mean_diff / (1.0 + mean_diff)

// Longest monotone subsequence — adaptive trend evidence.
let mut cur_inc = 1
let mut cur_dec = 1
let mut max_inc = 1
let mut max_dec = 1
let mut j = 1
while j < n {
    if xs[j] > xs[j-1] {
        cur_inc = cur_inc + 1
        cur_dec = 1
    } else {
        if xs[j] < xs[j-1] {
            cur_dec = cur_dec + 1
            cur_inc = 1
        } else {
            cur_inc = 1; cur_dec = 1
        }
    }
    if cur_inc > max_inc { max_inc = cur_inc }
    if cur_dec > max_dec { max_dec = cur_dec }
    j = j + 1
}
let max_mono = if max_inc > max_dec { max_inc } else { max_dec }
let mono_ratio = to_float(max_mono) / to_float(n)

let score = 0.6 * diff_norm + 0.4 * mono_ratio
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[evolution] category=core axis=\"Evolution — temporal Δx pressure + longest monotone subsequence (adaptive trend)\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"mean_diff\":" + to_string(mean_diff) + ",\"mono_ratio\":" + to_string(mono_ratio) + ",\"max_inc\":" + to_string(max_inc) + ",\"max_dec\":" + to_string(max_dec) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
