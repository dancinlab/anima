// ════════════════════════════════════════════════════════════════════════════
//  state/anima_d3_per_session_pool_2026_05_12/
//      anima_persona_4_per_session_pool_verify.hexa
//
//  PURPOSE
//    F-PERSONA-4 cond #3 ☑ verification path (d):
//      REBORN §89 hexa-native PER-SESSION cell pool (untrained, fresh-init
//      per category) vs PSCC §40 baseline SINGLE cell pool (KL≈9.7e-5 noise
//      floor).
//
//    Background — 4-alternative future-path post-cotrain (PSCC §44):
//      (a) cotrain v2 multi-corpus       FALSIFIED  PSCC §48 (ubu-2 SMALL)
//      (b) softmax τ tunable             FALSIFIED  PSCC §47 (ubu-1 sweep)
//      (c) z-score metric §A2            FALSIFIED  PSCC §45 (null perm)
//      (d) REBORN §89 hexa-native per-session pool  ← THIS BG
//
//    Hypothesis (d): cotrain ckpt's winner-take-all routing (cell-0 tension
//    793 vs runner-up 7.4) is BYPASSED by inference-time fresh cell pool
//    per session. Each session gets a fresh random-init cell pool (cells=64,
//    d=384) → cells maintain orthogonal basis → category-specific divergence
//    can emerge from the prompt-vector × random-rotation interaction.
//
//  METHOD
//    For each of 5 identity_probe categories:
//      1. fresh cell_pool_init(d_model=64, initial_cells=8)
//         (Mac-local tractable; PSCC §40 baseline used same shape so any
//          measured KL is directly comparable to 9.7e-5 noise floor.)
//      2. for each of 10 prompts in that category:
//           - prompt → byte hash → x_in (d-dim vec, same FNV as PSCC §40)
//           - tension_softmax_weights(pool, x_in) → 8-cell weight vector
//      3. category-mean weight distribution P_<cat>
//      4. After all 5 sessions: 5x5 KL matrix over 10 cat-pairs (5C2)
//         mean_KL ≥ 0.5 nats PASS
//
//    Null permutation test (PSCC §45 lesson — guards against §A2-style
//    artifact):
//      - collect all 50 (prompt, cat, weights) triples
//      - n_perms = 100: shuffle category labels, re-aggregate, re-compute
//        mean_KL on shuffled groups
//      - compute z-score = (observed - null_mean) / null_std
//      - PASS condition: observed mean_KL ≥ 0.5 AND z > 1.65 (95% one-tail)
//
//  SCENARIO VERDICTS
//    (i)   mean_KL ≥ 0.5 AND null PASS (z>1.65) → cond #3 ☑ DONE via (d)
//    (ii)  mean_KL ≥ 0.5 BUT null FAIL          → artifact, escalate
//    (iii) mean_KL < 0.5                         → (d) FALSIFIED
//
//  RUN
//    RESOURCE_LOCAL_HEXA=1 hexa run --no-sentinel \
//      state/anima_d3_per_session_pool_2026_05_12/anima_persona_4_per_session_pool_verify.hexa
//
//  OUTPUT
//    state/anima_d3_per_session_pool_2026_05_12/per_session_pool_results.json
//    state/anima_d3_per_session_pool_2026_05_12/per_session_pool_run.log
//
//  COMPLIANCE
//    raw#9/10 honest TODO · raw#11 snake_case · raw#15 no-hardcode (paths
//    rooted at /Users/ghost/core/anima/ env-stable, identity_probe path
//    is SSOT BG-LB).
//    raw-117 ≥5 honest C3 items in trailing doc.
//
//  HONEST C3 (raw#10)
//    1. d_model=64 cells=8 chosen to MATCH PSCC §40 baseline exactly so
//       the KL delta is attributable to the per-session-pool ablation
//       alone, not to architectural scale. The BG prompt suggested d=384
//       cells=64 (Phase 1 prod scale); deliberately keeping the parity
//       config preserves the dependent-variable rigor (Lesson §A1).
//    2. Fresh-per-session pool is achieved by calling cell_pool_init 5
//       times consecutively within ONE process. The gaussian RNG stream
//       (RFC 033, splitmix64) advances monotonically so each call yields
//       different cell weights. Reproducibility: set
//       __HEXA_FARR_GAUSS_SEED__=<u64> before invocation.
//    3. Null permutation test uses a hexa-side LCG (1103515245/12345),
//       NOT the gaussian stream — keeps permutation determinism orthogonal
//       to pool-init randomness. n_perms=100 chosen to match PSCC §45
//       null-test methodology (z-score normal approximation accurate at
//       n=100).
//    4. Tension softmax is computed identically to mitosis_hook.hexa
//       _mit_combine_outputs (max-subtract numerical stability). The
//       per-cell forward is _mit_cell_forward (engine_a - engine_g, mean-sq
//       tension). Both are RE-USED from the hook, not re-implemented.
//    5. Category-specific x_in derivation: prompt_to_vec is the same
//       deterministic FNV-LCG fold as PSCC §40 — equal-prompt → equal-vec.
//       The per-session-pool ablation does NOT modify x_in; only the
//       routing matrix (cell_pool) is freshened.
//    6. No persona injection (Principle #3): prompts are raw bytes; no
//       "[role:]" / "you are X" / system-prompt prepend. Identity_probe
//       jsonl is BG-LB SSOT (50 prompts × 5 cat × 10 prompts/cat).
//    7. F-PERSONA-2/3/5 PSCC §40+§42 carry — this BG ablates ONLY
//       F-PERSONA-4 (per-session-pool path); the other 4 falsifiers
//       remain at their PSCC §42 verdicts (PASS/PASS/PASS).
//    8. Scenario (i) ☑ = cond #3 D3 STRONG (4/5) → STRONG (5/5) →
//       5-cond aggregate 4/5 ☑ → 5/5 ☑ ACHIEVED 🎉. Scenario (ii)/(iii)
//       maintains STRONG 4/5 carry and definitively closes the cheap
//       cond #3 path → cotrain v2 H100 (PSCC §45 in-flight) becomes the
//       sole remaining lane.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


// ── globals ─────────────────────────────────────────────────────────────────
let mut g_log_lines = []

fn log_line(s: string) {
    println(s)
    g_log_lines.push(s)
}


// ── deterministic prompt-byte hash → d-dim vector (PSCC §40 byte-parity) ────
//
// Same FNV-1a 32-bit fold + LCG fill as
// tool/anima_persona_substrate_native_verify.hexa to guarantee
// bit-equivalent x_in vectors → KL delta is solely attributable to the
// per-session-pool ablation.

fn prompt_byte_hash(prompt: string) -> int {
    let mut h = 2166136261
    let chars = prompt.chars()
    let n = len(chars)
    let mut i = 0
    while i < n {
        let c = chars[i]
        let cs = c.chars()
        if len(cs) > 0 {
            let salt = i + 1
            h = (h ^ salt) * 16777619
            h = (h + len(c)) * 16777619
        }
        i = i + 1
    }
    if h < 0 { h = -h }
    return h
}

fn prompt_to_vec(prompt: string, d_model: int) {
    let mut seed = prompt_byte_hash(prompt) + 1
    let mut v = []
    let mut i = 0
    while i < d_model {
        seed = (1103515245 * seed + 12345)
        let m = 2147483647
        let mut s = seed
        if s < 0 { s = -s }
        let r = s - (s / m) * m
        let f = (r * 1.0) / (m * 1.0) - 0.5
        v.push(f)
        i = i + 1
    }
    return v
}


// ── jsonl loader ────────────────────────────────────────────────────────────
fn load_identity_probes(path: string) {
    let raw = read_file(path)
    let lines = raw.split("\n")
    let mut probes = []
    let n = len(lines)
    let mut i = 0
    while i < n {
        let line = lines[i]
        if len(line) > 5 {
            try {
                let d = json_parse(line)
                probes.push(d)
            } catch err {}
        }
        i = i + 1
    }
    return probes
}


// ── tension softmax weights (PSCC §40 byte-parity) ──────────────────────────
fn tension_softmax_weights(cell_pool, x_in) {
    let d_model = cell_pool["d_model"]
    let x_far = _mit_list_to_farr(x_in)
    let cells = cell_pool["cells"]
    let n = len(cells)

    let mut tensions = []
    let mut i = 0
    while i < n {
        let res = _mit_cell_forward(cells[i], x_far, d_model)
        tensions.push(res["tension"])
        i = i + 1
    }
    let _ = farr_free(x_far)

    // Softmax (max-subtract for numerical stability).
    let mut max_t = tensions[0]
    i = 1
    while i < n {
        if tensions[i] > max_t { max_t = tensions[i] }
        i = i + 1
    }
    let mut exps = []
    let mut s_exp = 0.0
    i = 0
    while i < n {
        let e = exp(tensions[i] - max_t)
        exps.push(e)
        s_exp = s_exp + e
        i = i + 1
    }
    let mut weights = []
    i = 0
    while i < n {
        weights.push(exps[i] / s_exp)
        i = i + 1
    }
    return weights
}


// ── distribution average ────────────────────────────────────────────────────
fn average_distribution(weights_list) {
    let m = len(weights_list)
    if m == 0 { return [] }
    let n = len(weights_list[0])
    let mut avg = []
    let mut j = 0
    while j < n {
        avg.push(0.0)
        j = j + 1
    }
    let mut i = 0
    while i < m {
        let w = weights_list[i]
        let mut k = 0
        while k < n {
            avg[k] = avg[k] + w[k]
            k = k + 1
        }
        i = i + 1
    }
    j = 0
    while j < n {
        avg[j] = avg[j] / (m * 1.0)
        j = j + 1
    }
    return avg
}


fn kl_divergence(p, q) {
    let n = len(p)
    let mut kl = 0.0
    let mut i = 0
    let eps = 1.0e-9
    while i < n {
        let pi = p[i] + eps
        let qi = q[i] + eps
        kl = kl + pi * _mit_log_safe(pi / qi)
        i = i + 1
    }
    return kl
}


// ── KL matrix over category averages ────────────────────────────────────────
//
// Inputs:
//   cat_names   : list[string]    length 5
//   cat_avgs    : list[list[float]] length 5 × n_cells (each row = avg dist
//                                                       for that category)
// Returns:
//   #{ "matrix": list[list[float]] 5×5, "mean_kl": float, "min_kl": float,
//      "max_kl": float, "pairs": list[float] (upper triangle) }
fn kl_matrix_from_avgs(cat_names, cat_avgs) {
    let n_cats = len(cat_names)
    let mut matrix = []
    let mut pairs = []
    let mut i = 0
    while i < n_cats {
        let mut row = []
        let mut j = 0
        while j < n_cats {
            if i == j {
                row.push(0.0)
            } else {
                let kl_ij = kl_divergence(cat_avgs[i], cat_avgs[j])
                row.push(kl_ij)
                if j > i {
                    pairs.push(kl_ij)
                }
            }
            j = j + 1
        }
        matrix.push(row)
        i = i + 1
    }
    let n_pairs = len(pairs)
    let mut sum_kl = 0.0
    let mut min_kl = pairs[0]
    let mut max_kl = pairs[0]
    let mut k = 0
    while k < n_pairs {
        let v = pairs[k]
        sum_kl = sum_kl + v
        if v < min_kl { min_kl = v }
        if v > max_kl { max_kl = v }
        k = k + 1
    }
    let mean_kl = sum_kl / (n_pairs * 1.0)
    return #{
        "matrix":  matrix,
        "mean_kl": mean_kl,
        "min_kl":  min_kl,
        "max_kl":  max_kl,
        "pairs":   pairs
    }
}


// ── LCG for null-permutation determinism (independent of gauss stream) ──────
//
// We use a hexa-side LCG so the permutation test is reproducible separately
// from the cell_pool gaussian initialization (which uses __HEXA_FARR_GAUSS_SEED__).
let mut g_lcg_state = 0

fn lcg_seed(s: int) {
    g_lcg_state = s
    if g_lcg_state == 0 { g_lcg_state = 1 }
}

fn lcg_next() -> int {
    g_lcg_state = (1103515245 * g_lcg_state + 12345)
    let m = 2147483647
    let mut s = g_lcg_state
    if s < 0 { s = -s }
    let r = s - (s / m) * m
    return r
}

fn lcg_rand_int(n: int) -> int {
    if n <= 0 { return 0 }
    let r = lcg_next()
    return r - (r / n) * n
}


// ── Fisher-Yates shuffle (in-place via index permutation) ───────────────────
fn shuffle_indices(n: int) {
    let mut idx = []
    let mut i = 0
    while i < n {
        idx.push(i)
        i = i + 1
    }
    // Fisher-Yates: for i = n-1 down to 1, swap idx[i] with idx[rand(0..i)]
    let mut k = n - 1
    while k > 0 {
        let j = lcg_rand_int(k + 1)
        let tmp = idx[k]
        idx[k] = idx[j]
        idx[j] = tmp
        k = k - 1
    }
    return idx
}


// ── Phase 1: per-session pool — collect (cat, weights) over all 50 probes ──
//
// For each category in `cat_names`:
//   - cell_pool_init(d, n_cells) — fresh gaussian draws (stream advance)
//   - for each prompt in probes whose category == cat:
//        weights = tension_softmax_weights(fresh_pool, prompt_to_vec(prompt))
//        append (cat, weights) to flat list
//
// Returns:
//   #{
//     "probe_weights": list[#{ "cat": str, "weights": list[float] }],
//     "cat_avgs":      list[list[float]]   (5 × n_cells, in cat_names order),
//     "cat_names":     list[string]        (sorted cat names, 5),
//     "pool_meta":     list[#{ "cat": str, "n_cells": int, "tension_top3": [..]}]
//   }
fn run_per_session_pools(probes, d_model: int, n_cells: int, cat_names) {
    let n_cats = len(cat_names)
    let n_probes = len(probes)

    let mut probe_weights = []
    let mut cat_avgs_dict = #{}
    let mut pool_meta = []

    let mut k1 = 0
    while k1 < n_cats {
        let cat = cat_names[k1]
        log_line("  ── session [" + cat + "] ── fresh cell_pool_init(d=" + to_string(d_model) + ", cells=" + to_string(n_cells) + ")")

        // Fresh pool per session (gauss stream advances).
        let pool = cell_pool_init(d_model, n_cells)
        let actual_n = len(pool["cells"])

        // Optionally collect a tension sample on prompt 0 of THIS category
        // for diagnostics (top-3 tension magnitudes, dominance ratio proxy).
        let mut first_cat_probe = ""
        let mut p0 = 0
        while p0 < n_probes {
            if probes[p0]["category"] == cat {
                first_cat_probe = probes[p0]["prompt"]
                p0 = n_probes
            } else {
                p0 = p0 + 1
            }
        }

        let mut tensions_diag = []
        if len(first_cat_probe) > 0 {
            let x_in_diag = prompt_to_vec(first_cat_probe, d_model)
            let xf = _mit_list_to_farr(x_in_diag)
            let mut td_i = 0
            while td_i < actual_n {
                let r = _mit_cell_forward(pool["cells"][td_i], xf, d_model)
                tensions_diag.push(r["tension"])
                td_i = td_i + 1
            }
            let _ = farr_free(xf)
        }

        let mut cat_weights = []
        let mut p = 0
        while p < n_probes {
            if probes[p]["category"] == cat {
                let prompt = probes[p]["prompt"]
                let x_in = prompt_to_vec(prompt, d_model)
                let w = tension_softmax_weights(pool, x_in)
                cat_weights.push(w)
                probe_weights.push(#{ "cat": cat, "weights": w })
            }
            p = p + 1
        }
        let n_cw = len(cat_weights)
        let avg = average_distribution(cat_weights)
        cat_avgs_dict[cat] = avg

        pool_meta.push(#{
            "cat": cat,
            "n_cells": actual_n,
            "n_probes_in_cat": n_cw,
            "tensions_diag":   tensions_diag
        })

        log_line("    probes_in_cat=" + to_string(n_cw) + " avg_dist_len=" + to_string(len(avg)))
        if len(tensions_diag) > 0 {
            let mut tdmax = tensions_diag[0]
            let mut tdmin = tensions_diag[0]
            let mut td_sum = 0.0
            let mut td_i2 = 0
            while td_i2 < len(tensions_diag) {
                let v = tensions_diag[td_i2]
                if v > tdmax { tdmax = v }
                if v < tdmin { tdmin = v }
                td_sum = td_sum + v
                td_i2 = td_i2 + 1
            }
            let td_mean = td_sum / (len(tensions_diag) * 1.0)
            log_line("    tension diag (prompt 0): max=" + to_string(tdmax) + " min=" + to_string(tdmin) + " mean=" + to_string(td_mean))
        }

        k1 = k1 + 1
    }

    // Compose cat_avgs as ordered list parallel to cat_names.
    let mut cat_avgs = []
    let mut q = 0
    while q < n_cats {
        cat_avgs.push(cat_avgs_dict[cat_names[q]])
        q = q + 1
    }

    return #{
        "probe_weights": probe_weights,
        "cat_avgs":      cat_avgs,
        "cat_names":     cat_names,
        "pool_meta":     pool_meta
    }
}


// ── Null permutation test ───────────────────────────────────────────────────
//
// shuffle category labels across probe_weights and recompute mean_KL.
//
// Returns: #{ "null_mean": float, "null_std": float, "null_max": float,
//             "null_p_value": float, "z_score": float, "n_perms": int,
//             "n_above": int }
fn null_permutation_test(probe_weights, cat_names, observed_mean_kl: float, n_perms: int) {
    let n = len(probe_weights)
    let n_cats = len(cat_names)

    let mut null_kls = []
    let mut n_above = 0
    let mut perm_i = 0
    while perm_i < n_perms {
        let idx = shuffle_indices(n)

        // Re-assign labels: probe i gets label of probe idx[i]'s original cat.
        // The "weights" stay paired with their original prompt; only the
        // "cat" assignment is shuffled. Equivalently: group_<c> = {
        //   probe_weights[i].weights : original_cat(probe_weights[idx[i]]) == c
        // }.
        let mut shuf_cat_lists = #{}
        let mut k = 0
        while k < n_cats {
            shuf_cat_lists[cat_names[k]] = []
            k = k + 1
        }
        let mut i = 0
        while i < n {
            let new_cat = probe_weights[idx[i]]["cat"]
            shuf_cat_lists[new_cat].push(probe_weights[i]["weights"])
            i = i + 1
        }

        let mut shuf_avgs = []
        let mut q = 0
        while q < n_cats {
            let cat = cat_names[q]
            shuf_avgs.push(average_distribution(shuf_cat_lists[cat]))
            q = q + 1
        }

        let shuf_kl = kl_matrix_from_avgs(cat_names, shuf_avgs)
        null_kls.push(shuf_kl["mean_kl"])
        if shuf_kl["mean_kl"] >= observed_mean_kl {
            n_above = n_above + 1
        }
        perm_i = perm_i + 1
    }

    // Compute null mean / std.
    let mut sum = 0.0
    let mut maxv = null_kls[0]
    let mut i2 = 0
    while i2 < n_perms {
        sum = sum + null_kls[i2]
        if null_kls[i2] > maxv { maxv = null_kls[i2] }
        i2 = i2 + 1
    }
    let null_mean = sum / (n_perms * 1.0)
    let mut sq_sum = 0.0
    i2 = 0
    while i2 < n_perms {
        let d = null_kls[i2] - null_mean
        sq_sum = sq_sum + d * d
        i2 = i2 + 1
    }
    let null_var = sq_sum / (n_perms * 1.0)
    let null_std = _mit_sqrt_safe(null_var)

    let z_score = if null_std > 0.0 { (observed_mean_kl - null_mean) / null_std } else { 0.0 }
    let p_value = (n_above * 1.0) / (n_perms * 1.0)

    return #{
        "null_mean":   null_mean,
        "null_std":    null_std,
        "null_max":    maxv,
        "null_p":      p_value,
        "z_score":     z_score,
        "n_perms":     n_perms,
        "n_above":     n_above
    }
}


// ── JSON serializer (hand-rolled — flat-ish schema, no nested-dict json_stringify) ─
fn list_float_to_json(xs) -> string {
    let n = len(xs)
    let mut s = "["
    let mut i = 0
    while i < n {
        if i > 0 { s = s + "," }
        s = s + to_string(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}

fn matrix_to_json(m) -> string {
    let n = len(m)
    let mut s = "["
    let mut i = 0
    while i < n {
        if i > 0 { s = s + "," }
        s = s + list_float_to_json(m[i])
        i = i + 1
    }
    s = s + "]"
    return s
}

fn list_str_to_json(xs) -> string {
    let n = len(xs)
    let mut s = "["
    let mut i = 0
    while i < n {
        if i > 0 { s = s + "," }
        s = s + "\"" + xs[i] + "\""
        i = i + 1
    }
    s = s + "]"
    return s
}

fn pool_meta_to_json(pm) -> string {
    let n = len(pm)
    let mut s = "["
    let mut i = 0
    while i < n {
        if i > 0 { s = s + "," }
        let e = pm[i]
        s = s + "{"
        s = s + "\"cat\": \"" + e["cat"] + "\","
        s = s + "\"n_cells\": " + to_string(e["n_cells"]) + ","
        s = s + "\"n_probes_in_cat\": " + to_string(e["n_probes_in_cat"]) + ","
        s = s + "\"tensions_diag\": " + list_float_to_json(e["tensions_diag"])
        s = s + "}"
        i = i + 1
    }
    s = s + "]"
    return s
}


// ── main ────────────────────────────────────────────────────────────────────
fn main() {
    log_line("")
    log_line("================================================================")
    log_line("anima_persona_4_per_session_pool_verify.hexa")
    log_line("F-PERSONA-4 cond #3 ☑ verification path (d) — REBORN §89")
    log_line("hexa-native per-session fresh cell pool")
    log_line("================================================================")

    // Phase 1: config + load probes
    //
    // d_model + n_cells via env vars (raw#15 no-hardcode robustness):
    //   PSPV_D_MODEL  default 64   (PSCC §40 byte-parity)
    //   PSPV_N_CELLS  default 8    (PSCC §40 byte-parity)
    //   PSPV_TAG      default "base" (output filename suffix)
    // BG also runs a production-scale config (d=384, cells=64) per
    // BG prompt explicit ask — second invocation with env overrides.
    // Identity_probe path: BG-LB SSOT.
    let env_d = exec("echo \"${PSPV_D_MODEL:-64}\"").trim()
    let env_n = exec("echo \"${PSPV_N_CELLS:-8}\"").trim()
    let env_tag = exec("echo \"${PSPV_TAG:-base}\"").trim()
    let d_model = to_int(env_d)
    let n_cells = to_int(env_n)
    let tag = env_tag
    let n_perms = 100
    let probe_path = "/Users/ghost/core/anima/state/p_idr_identity_rules_2026_05_12/identity_probe.jsonl"
    let kl_threshold = 0.5
    let z_threshold = 1.65   // 95% one-tail normal

    log_line("config: d_model=" + to_string(d_model) + " n_cells=" + to_string(n_cells))
    log_line("        n_perms=" + to_string(n_perms) + " kl_threshold=" + to_string(kl_threshold))
    log_line("        z_threshold=" + to_string(z_threshold))
    log_line("probe path: " + probe_path)

    let probes = load_identity_probes(probe_path)
    let n_probes = len(probes)
    log_line("loaded " + to_string(n_probes) + " probes")

    if n_probes < 50 {
        log_line("WARN: expected 50 probes, got " + to_string(n_probes))
    }

    // Phase 2: derive sorted cat names + count per-cat distribution.
    let cat_names = ["boundary", "emotion", "self_definition", "self_knowledge", "values"]
    let mut cat_count = #{}
    let mut c0 = 0
    while c0 < len(cat_names) {
        cat_count[cat_names[c0]] = 0
        c0 = c0 + 1
    }
    let mut pp = 0
    while pp < n_probes {
        let c = probes[pp]["category"]
        cat_count[c] = cat_count[c] + 1
        pp = pp + 1
    }
    let mut cc = 0
    while cc < len(cat_names) {
        log_line("  cat=" + cat_names[cc] + " n=" + to_string(cat_count[cat_names[cc]]))
        cc = cc + 1
    }

    // Phase 3: per-session pool ablation.
    log_line("")
    log_line("─── Phase 3: per-session pool measurement (5 sessions × 10 probes) ───")
    let pool_result = run_per_session_pools(probes, d_model, n_cells, cat_names)
    let cat_avgs = pool_result["cat_avgs"]
    let probe_weights = pool_result["probe_weights"]

    // Phase 4: observed KL matrix.
    log_line("")
    log_line("─── Phase 4: observed 5×5 KL matrix (10 pairs upper triangle) ───")
    let observed = kl_matrix_from_avgs(cat_names, cat_avgs)
    log_line("  observed mean_KL = " + to_string(observed["mean_kl"]) + " nats")
    log_line("  observed min_KL  = " + to_string(observed["min_kl"]) + " nats")
    log_line("  observed max_KL  = " + to_string(observed["max_kl"]) + " nats")
    log_line("  KL matrix (rows=P, cols=Q):")
    let mtx = observed["matrix"]
    let mut rr = 0
    while rr < len(cat_names) {
        let row = mtx[rr]
        let mut line = "    " + cat_names[rr] + ":  "
        let mut cc2 = 0
        while cc2 < len(cat_names) {
            line = line + to_string(row[cc2]) + "  "
            cc2 = cc2 + 1
        }
        log_line(line)
        rr = rr + 1
    }

    // Phase 5: null permutation test.
    log_line("")
    log_line("─── Phase 5: null permutation test (n_perms=" + to_string(n_perms) + ") ───")
    log_line("  seeding LCG=20260512 for reproducible permutation order")
    lcg_seed(20260512)
    let null_res = null_permutation_test(probe_weights, cat_names, observed["mean_kl"], n_perms)
    log_line("  null_mean = " + to_string(null_res["null_mean"]))
    log_line("  null_std  = " + to_string(null_res["null_std"]))
    log_line("  null_max  = " + to_string(null_res["null_max"]))
    log_line("  n_above   = " + to_string(null_res["n_above"]) + " / " + to_string(n_perms))
    log_line("  p_value   = " + to_string(null_res["null_p"]))
    log_line("  z_score   = " + to_string(null_res["z_score"]))

    // Phase 6: verdict.
    log_line("")
    log_line("─── Phase 6: verdict ───")
    let observed_pass = observed["mean_kl"] >= kl_threshold
    let null_pass     = null_res["z_score"] >= z_threshold && null_res["null_p"] <= 0.05

    let scenario = if observed_pass && null_pass {
        "(i)  PASS — cond #3 ☑ DONE via (d) hexa-native per-session pool"
    } else {
        if observed_pass && !null_pass {
            "(ii) ARTIFACT — mean_KL ≥ 0.5 but null permutation FAIL (PSCC §45 lesson)"
        } else {
            "(iii) FALSIFIED — (d) path closed, mean_KL < 0.5"
        }
    }
    log_line("  observed_pass (mean_KL ≥ " + to_string(kl_threshold) + ") = " + to_string(observed_pass))
    log_line("  null_pass     (z ≥ " + to_string(z_threshold) + " AND p ≤ 0.05) = " + to_string(null_pass))
    log_line("  SCENARIO: " + scenario)

    // Phase 7: JSON output.
    let out_path = "/Users/ghost/core/anima/state/anima_d3_per_session_pool_2026_05_12/per_session_pool_results_" + tag + ".json"
    let log_path = "/Users/ghost/core/anima/state/anima_d3_per_session_pool_2026_05_12/per_session_pool_run_" + tag + ".log"

    let mut j = "{"
    j = j + "\"timestamp\": \"" + exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() + "\","
    j = j + "\"tag\": \"" + tag + "\","
    j = j + "\"d_model\": " + to_string(d_model) + ","
    j = j + "\"n_cells\": " + to_string(n_cells) + ","
    j = j + "\"n_probes\": " + to_string(n_probes) + ","
    j = j + "\"n_perms\": " + to_string(n_perms) + ","
    j = j + "\"kl_threshold\": " + to_string(kl_threshold) + ","
    j = j + "\"z_threshold\": " + to_string(z_threshold) + ","
    j = j + "\"categories\": " + list_str_to_json(cat_names) + ","
    j = j + "\"observed_mean_kl\": " + to_string(observed["mean_kl"]) + ","
    j = j + "\"observed_min_kl\": " + to_string(observed["min_kl"]) + ","
    j = j + "\"observed_max_kl\": " + to_string(observed["max_kl"]) + ","
    j = j + "\"kl_matrix\": " + matrix_to_json(observed["matrix"]) + ","
    j = j + "\"kl_pairs\": " + list_float_to_json(observed["pairs"]) + ","
    j = j + "\"null_mean\": " + to_string(null_res["null_mean"]) + ","
    j = j + "\"null_std\": " + to_string(null_res["null_std"]) + ","
    j = j + "\"null_max\": " + to_string(null_res["null_max"]) + ","
    j = j + "\"null_p\": " + to_string(null_res["null_p"]) + ","
    j = j + "\"null_n_above\": " + to_string(null_res["n_above"]) + ","
    j = j + "\"z_score\": " + to_string(null_res["z_score"]) + ","
    j = j + "\"observed_pass\": " + (if observed_pass { "true" } else { "false" }) + ","
    j = j + "\"null_pass\": " + (if null_pass { "true" } else { "false" }) + ","
    j = j + "\"scenario\": \"" + scenario + "\","
    j = j + "\"pool_meta\": " + pool_meta_to_json(pool_result["pool_meta"])
    j = j + "}"
    write_file(out_path, j)
    log_line("")
    log_line("  result JSON: " + out_path)

    // Also dump full run log.
    let mut log_out = ""
    let mut li = 0
    while li < len(g_log_lines) {
        log_out = log_out + g_log_lines[li] + "\n"
        li = li + 1
    }
    write_file(log_path, log_out)
    log_line("  log file   : " + log_path)

    log_line("")
    log_line("================================================================")
    log_line("VERDICT: " + scenario)
    log_line("================================================================")
}
