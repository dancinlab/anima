// ═══════════════════════════════════════════════════════════════
// G2 closure — closed-form web/server falsifier (F-WEB-1..5)
// Mechanism (preserved): consciousness engine + topology + step/frame budget.
// $0 Mac local, no websocket server bind required.
// ═══════════════════════════════════════════════════════════════


fn lcg_next_we(s: int) -> int { return (s * 1103515245 + 12345) % 2147483648 }
fn lcg_unit_we(s: int) -> float {
    let raw = s % 1000000
    let pos = raw
    if pos < 0 { return to_float(pos + 1000000) / 1000000.0 }
    return to_float(pos) / 1000000.0
}

// F-WEB-1: engine construction shape — cells & faction count preserved
fn fw_we_1() -> bool {
    let e = sim_engine_new(32, 64, "ring")
    let ok = e.n_cells == 32 && e.hidden_dim == 64 && e.n_factions == N_FACTIONS
    println("  [F-WEB-1] cells=" + to_string(e.n_cells) + " hidden=" + to_string(e.hidden_dim) + " factions=" + to_string(e.n_factions))
    return ok
}

// F-WEB-2: frame budget — step() returns JSON frame for sub-millisecond emit
fn fw_we_2() -> bool {
    let e = sim_engine_new(32, 64, "ring")
    let f = sim_engine_step(e)
    let ok = len(f) > 5
    println("  [F-WEB-2] frame_len=" + to_string(len(f)) + " ok=" + to_string(ok))
    return ok
}

// F-WEB-3: batch throughput — 30 frames produced in single tick
fn fw_we_3() -> bool {
    let e = sim_engine_new(32, 64, "ring")
    let mut k = 0
    let mut total_chars = 0
    while k < 30 {
        let f = sim_engine_step(e)
        total_chars = total_chars + len(f)
        k = k + 1
    }
    let avg = to_float(total_chars) / 30.0
    println("  [F-WEB-3] 30_frames avg_chars=" + to_string(avg))
    return total_chars > 30
}

// F-WEB-4: determinism — same input → same output (no random in current stub)
fn fw_we_4() -> bool {
    let e1 = sim_engine_new(16, 32, "ring")
    let e2 = sim_engine_new(16, 32, "ring")
    let f1 = sim_engine_step(e1)
    let f2 = sim_engine_step(e2)
    let ok = f1 == f2
    println("  [F-WEB-4] determinism f1==f2: " + to_string(ok))
    return ok
}

// F-WEB-5: memory footprint — reconfigure shrinks/grows engine cell count
fn fw_we_5() -> bool {
    let e = sim_engine_new(32, 64, "ring")
    let small = sim_engine_reconfigure(e, 8, "ring")
    let large = sim_engine_reconfigure(e, 128, "small_world")
    let ok = small.n_cells == 8 && large.n_cells == 128 && large.topology_type == "small_world"
    println("  [F-WEB-5] small=" + to_string(small.n_cells) + " large=" + to_string(large.n_cells) + " topo=" + large.topology_type)
    return ok
}

fn _selftest() -> int {
    print("── web physics_server falsifier (F-WEB-1..5) ──")
    let f1 = fw_we_1()
    if f1 { print("F-WEB-1 PASS — engine shape") } else { print("F-WEB-1 FAIL") }
    let f2 = fw_we_2()
    if f2 { print("F-WEB-2 PASS — frame budget") } else { print("F-WEB-2 FAIL") }
    let f3 = fw_we_3()
    if f3 { print("F-WEB-3 PASS — batch throughput") } else { print("F-WEB-3 FAIL") }
    let f4 = fw_we_4()
    if f4 { print("F-WEB-4 PASS — determinism") } else { print("F-WEB-4 FAIL") }
    let f5 = fw_we_5()
    if f5 { print("F-WEB-5 PASS — memory reconfigure") } else { print("F-WEB-5 FAIL") }
    let mut pc = 0
    if f1 { pc = pc + 1 }
    if f2 { pc = pc + 1 }
    if f3 { pc = pc + 1 }
    if f4 { pc = pc + 1 }
    if f5 { pc = pc + 1 }
    print("[web falsifier] " + to_string(pc) + "/5 PASS")
    return pc
}

fn main() {
    let av = argv()
    let mut falsifier = false
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--falsifier" { falsifier = true; i = i + 1; continue }
        i = i + 1
    }
    if falsifier {
        let pc = _selftest()
        if pc == 5 { exit(0) }
        exit(1)
    }

    // TODO[hexa-stdlib]: argparse for --engine, --cells, --hidden-dim, --topology, --speed, --host, --port
    let engine_type = "sim"
    let cells = DEFAULT_CELLS
    let hidden_dim = DEFAULT_HIDDEN_DIM
    let topology = "ring"
    let speed = DEFAULT_SPEED
    let host = "0.0.0.0"
    let port = DEFAULT_PORT

    // Create engine (sim/snn/esp32 all use sim base for now)
    if engine_type == "snn" {
        print("[note] SNN engine currently uses sim-based simulation")
    }
    if engine_type == "esp32" {
        print("[note] ESP32 engine currently uses simulation mode")
    }

    let engine = sim_engine_new(cells, hidden_dim, topology)
    let server = physics_server_new(engine, host, port, speed)
    physics_server_run(server)
}
