// TIME E3 — BENCH ROBUSTNESS PROBE (메타 역적용)
// ════════════════════════════════════════════════════════════════════════════
// 본 probe 의 목적: bench/axis_time/bench.hexa 의 9/0 🟢 PASS 가
//   - 진짜 substrate 신호인가? (probe 변경에도 PASS 유지)
//   - 아니면 측정 artifact 인가? (probe 변경 시 PASS 무너짐)
//
// A1 (collision-saturation) · A2 (sign overlap) · A3 (degrade) · A4 (orthant-bias)
// 4 artifact 패턴을 TIME 9 falsifier 에 역적용:
//
//   probe 1 (A3 degrade trivial-ratio):
//     F-TIME-DISC-phase / -env 가 STABLE std=0.0 baseline 에 * 4.0 곱셈.
//     → 0 * 4 = 0 즉 ANY positive value 자동 PASS.
//     검정: STABLE std 가 정확히 0.0 인지 + DISC 가 무의미한지.
//
//   probe 2 (A1 collision-saturation degenerate STABLE):
//     STABLE 시나리오의 phase_std / phase_slope / env_std 가 모두 정확히 0.0.
//     → 16 cycle 동일 결과 = trivial degeneracy.
//     검정: STABLE 에 ε 노이즈 (cycle 마다 ±1min jitter) 도입 시
//     phase_std 가 여전히 < 5.0 PASS 인가? 아니면 jittered STABLE 도
//     "DRIFT" 와 구분 불가가 되는가?
//
//   probe 3 (A4 orthant-bias hand-tuned dip-window):
//     F-TIME-4a 의 dip_idx ∈ [6,10] window 가 정확히 designed-in
//     triangular peak (cycle 8 ±3) 에 맞춰져 있음.
//     검정: dip 을 cycle 12 로 이동했을 때 falsifier 가 따라가는가?
//     아니면 [6,10] 만 검사해서 진짜 dip 을 놓치는가?
//
//   probe 4 (A2 sign-overlap drift discriminability):
//     DRIFTING phase_std = 27.4 > 20.0 PASS 인데,
//     이는 boundary 가 mod-90 wrap 때문에 large jump.
//     검정: drift rate +1min/cycle (작은 drift) 일 때
//     F-TIME-2 (>20.0) 가 FAIL 되어 진짜 drift 미감지인지.
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0
let mut ROBUST = 0      // 원본 PASS 가 probe 후에도 유지된 횟수
let mut SPURIOUS = 0    // 원본 PASS 가 probe 후 무너진 횟수

fn check(name: string, cond: bool) {
    if cond {
        PASS = PASS + 1
        println("  [PASS] " + name)
    } else {
        FAIL = FAIL + 1
        println("  [FAIL] " + name)
    }
}

fn robust_check(name: string, original_pass: bool, probe_pass: bool) {
    // original PASS + probe PASS  → ROBUST (진짜 신호)
    // original PASS + probe FAIL  → SPURIOUS (artifact)
    if original_pass && probe_pass {
        ROBUST = ROBUST + 1
        println("  [ROBUST]   " + name)
    } else {
        if original_pass && !probe_pass {
            SPURIOUS = SPURIOUS + 1
            println("  [SPURIOUS] " + name + "  (origin PASS · probe FAIL)")
        } else {
            println("  [N/A]      " + name)
        }
    }
}

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    if g < 1.0 { g = 1.0 }
    let mut i = 0
    while i < 25 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    return g
}

fn std_of(xs: list, n: int) -> float {
    if n <= 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    let mean = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n {
        let d = xs[i] - mean
        ss = ss + d * d
        i = i + 1
    }
    return sqrt_f(ss / to_float(n))
}

fn mean_of(xs: list, n: int) -> float {
    if n <= 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn argmin_of(xs: list, n: int) -> int {
    let mut bi = 0
    let mut bv = xs[0]
    let mut i = 1
    while i < n {
        if xs[i] < bv { bv = xs[i]; bi = i }
        i = i + 1
    }
    return bi
}

fn min_of(xs: list, n: int) -> float {
    let mut bv = xs[0]
    let mut i = 1
    while i < n {
        if xs[i] < bv { bv = xs[i] }
        i = i + 1
    }
    return bv
}

fn max_of(xs: list, n: int) -> float {
    let mut bv = xs[0]
    let mut i = 1
    while i < n {
        if xs[i] > bv { bv = xs[i] }
        i = i + 1
    }
    return bv
}

fn linear_slope(ys: list, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut sxx = 0.0
    let mut sxy = 0.0
    let mut i = 0
    while i < n {
        let x = to_float(i)
        let y = ys[i]
        sx = sx + x
        sy = sy + y
        sxx = sxx + x * x
        sxy = sxy + x * y
        i = i + 1
    }
    let nf = to_float(n)
    let denom = nf * sxx - sx * sx
    if abs_f(denom) < 1e-9 { return 0.0 }
    return (nf * sxy - sx * sy) / denom
}

// ── stage envelope (same as bench) ─────────────────────────────────────────
fn stage_of_within(w: int) -> int {
    if w < 60 { return 0 }
    if w < 70 { return 1 }
    if w < 80 { return 2 }
    if w < 87 { return 3 }
    return 4
}

fn stage_mod(s: int) -> float {
    if s == 0 { return 1.0 }
    if s == 1 { return 0.7 }
    if s == 2 { return 0.4 }
    if s == 3 { return 0.05 }
    return 0.85
}

// libm-free pseudo-random (deterministic LCG seeded by minute)
fn lcg(seed: int) -> int {
    let mut s = seed * 1103515245 + 12345
    if s < 0 { s = 0 - s }
    return s % 2147483647
}

// jittered phase shift — deterministic per cycle, ±jitter_amplitude min
fn jitter_shift(cycle: int, amp: int) -> int {
    if amp <= 0 { return 0 }
    let r = lcg(cycle * 37 + 17)
    let m = r % (2 * amp + 1)
    return m - amp
}

// scenario-aware stage detector — extended for probes
//   sc 0  STABLE
//   sc 1  DRIFTING (+drift_rate min/cycle)
//   sc 2  CIRCADIAN (dip_center, dip_depth)
//   sc 3  STABLE-JITTERED (±jitter_amp min/cycle, no linear drift)
//   sc 4  DRIFTING-SLOW (+1min/cycle)
//   sc 5  CIRCADIAN-LATE (dip at cycle 12)
fn stage_of_abs(t: int, scenario: int, drift_rate: int, jitter_amp: int) -> int {
    let cycle = t / 90
    let mut w = t - cycle * 90
    if scenario == 1 || scenario == 4 {
        w = w - cycle * drift_rate
        while w < 0 { w = w + 90 }
        while w >= 90 { w = w - 90 }
    }
    if scenario == 3 {
        let j = jitter_shift(cycle, jitter_amp)
        w = w - j
        while w < 0 { w = w + 90 }
        while w >= 90 { w = w - 90 }
    }
    return stage_of_within(w)
}

fn circadian_mod_at(cycle: int, scenario: int, dip_center: int) -> float {
    if scenario != 2 && scenario != 5 { return 1.0 }
    let d_int = cycle - dip_center
    let mut d = d_int
    if d < 0 { d = 0 - d }
    if d >= 4 { return 1.0 }
    return 0.5 + to_float(d) * 0.125
}

fn phi_scale_abs(t: int, scenario: int, drift_rate: int, jitter_amp: int, dip_center: int) -> float {
    let s = stage_of_abs(t, scenario, drift_rate, jitter_amp)
    let cycle = t / 90
    let base = stage_mod(s)
    let cmod = circadian_mod_at(cycle, scenario, dip_center)
    return base * cmod
}

fn observed_wake_n1_boundary(start_min: int, scenario: int, drift_rate: int, jitter_amp: int) -> int {
    let mut m = start_min
    let end = start_min + 90
    let mut prev_s = stage_of_abs(start_min, scenario, drift_rate, jitter_amp)
    m = m + 1
    while m < end {
        let s_now = stage_of_abs(m, scenario, drift_rate, jitter_amp)
        if prev_s == 0 && s_now != 0 {
            return m - start_min
        }
        prev_s = s_now
        m = m + 1
    }
    return 90
}

fn run_probe_scenario(scenario: int, n_cycles: int, drift_rate: int, jitter_amp: int, dip_center: int) -> dict {
    let mut wake_boundaries = []
    let mut cycle_means = []

    let mut k = 0
    while k < n_cycles {
        let start = k * 90
        let b = observed_wake_n1_boundary(start, scenario, drift_rate, jitter_amp)
        wake_boundaries = wake_boundaries + [to_float(b)]

        let mut sum = 0.0
        let mut m = 0
        while m < 90 {
            sum = sum + phi_scale_abs(start + m, scenario, drift_rate, jitter_amp, dip_center)
            m = m + 1
        }
        cycle_means = cycle_means + [sum / 90.0]
        k = k + 1
    }

    let result = #{}
    result["phase_std"] = std_of(wake_boundaries, n_cycles)
    result["phase_slope"] = linear_slope(wake_boundaries, n_cycles)
    result["env_mean"] = mean_of(cycle_means, n_cycles)
    result["env_std"] = std_of(cycle_means, n_cycles)
    result["env_min"] = min_of(cycle_means, n_cycles)
    result["env_max"] = max_of(cycle_means, n_cycles)
    result["env_dip_idx"] = argmin_of(cycle_means, n_cycles)
    result["c1_mean"] = cycle_means[0]
    result["cN_mean"] = cycle_means[n_cycles - 1]
    return result
}

// ── main ───────────────────────────────────────────────────────────────────
fn main() {
    println("================================================================")
    println("  TIME E3 — BENCH ROBUSTNESS PROBE (4 artifact 패턴 역적용)")
    println("================================================================")

    let n_cycles = 16

    // 원본 baseline (STABLE / DRIFTING +5 / CIRCADIAN-8)
    let r_stable = run_probe_scenario(0, n_cycles, 5, 0, 8)
    let r_drift  = run_probe_scenario(1, n_cycles, 5, 0, 8)
    let r_circ   = run_probe_scenario(2, n_cycles, 5, 0, 8)

    println("")
    println("  ── ORIGIN baseline (sanity, expect 9/0) ──────────────────────")
    println("    STABLE   phase_std=" + str(r_stable["phase_std"]) +
            "  env_std=" + str(r_stable["env_std"]))
    println("    DRIFTING phase_std=" + str(r_drift["phase_std"]) +
            "  slope="    + str(r_drift["phase_slope"]))
    println("    CIRCAD   env_std="   + str(r_circ["env_std"]) +
            "  env_min/max=" + str(r_circ["env_min"]/r_circ["env_max"]) +
            "  dip_idx="  + str(r_circ["env_dip_idx"]))

    // ── PROBE 1: A3 degrade trivial-ratio ────────────────────────────────
    // F-TIME-DISC-phase: r_drift["phase_std"] > r_stable["phase_std"] * 4.0
    // r_stable["phase_std"] = 0.0 → threshold = 0.0 → 모든 positive PASS
    println("")
    println("  ── PROBE 1: A3 degrade trivial-ratio ─────────────────────────")
    let stable_std_exactly_zero = r_stable["phase_std"] == 0.0
    let stable_env_exactly_zero = r_stable["env_std"] == 0.0
    println("    r_stable[phase_std] == 0.0   ? " + str(stable_std_exactly_zero))
    println("    r_stable[env_std]   == 0.0   ? " + str(stable_env_exactly_zero))
    let trivial_phase_threshold = r_stable["phase_std"] * 4.0
    let trivial_env_threshold   = r_stable["env_std"]   * 4.0
    println("    F-DISC-phase threshold (stable*4) = " + str(trivial_phase_threshold))
    println("    F-DISC-env   threshold (stable*4) = " + str(trivial_env_threshold))
    // counter-test: 아주 작은 (0.001) noise 만 있어도 DISC 가 자동 PASS
    let toy_drift_std = 0.001
    let toy_disc_phase_pass = toy_drift_std > trivial_phase_threshold
    println("    counter-test: toy_drift_std=0.001 PASSes F-DISC-phase ? " +
            str(toy_disc_phase_pass) + "  (← trivially)")
    check("PROBE-1a F-DISC-phase threshold == 0.0 (trivial)",
          trivial_phase_threshold == 0.0)
    check("PROBE-1b F-DISC-env threshold == 0.0 (trivial)",
          trivial_env_threshold == 0.0)
    check("PROBE-1c toy noise 0.001 also passes F-DISC-phase (vacuous)",
          toy_disc_phase_pass)

    // ── PROBE 2: A1 collision-saturation — STABLE jittered ──────────────
    // STABLE 에 ±2min jitter 도입. F-TIME-1 (<5.0) 가 유지되는가?
    // F-TIME-DISC-phase (>4× STABLE) 는 jittered baseline 도 >0 → DRIFT discrim 사라짐?
    println("")
    println("  ── PROBE 2: A1 collision-saturation — STABLE +jitter ±2min ──")
    let r_stable_j2 = run_probe_scenario(3, n_cycles, 0, 2, 8)
    println("    STABLE-JITTER2 phase_std = " + str(r_stable_j2["phase_std"]))
    let jitter_passes_F1 = r_stable_j2["phase_std"] < 5.0
    println("    F-TIME-1 (<5.0) jittered ? " + str(jitter_passes_F1))
    // discriminability check: with jittered baseline, drift_std / jitter_std 비교
    let jitter_discrim_ratio = r_drift["phase_std"] / (r_stable_j2["phase_std"] + 1e-9)
    println("    DRIFT/JITTER ratio = " + str(jitter_discrim_ratio) +
            "  (origin DISC threshold = 4.0×)")
    let jitter_disc_pass = r_drift["phase_std"] > r_stable_j2["phase_std"] * 4.0
    println("    F-DISC-phase against jittered baseline ? " + str(jitter_disc_pass))
    check("PROBE-2a STABLE+jitter still passes F-TIME-1 (<5.0)", jitter_passes_F1)
    check("PROBE-2b DISC-phase still robust against jittered baseline",
          jitter_disc_pass)
    // ROBUST 판정: origin F-TIME-1, F-DISC-phase 가 jitter probe 하에서도 PASS 유지
    robust_check("F-TIME-1 robust under ±2min jitter", true, jitter_passes_F1)
    robust_check("F-DISC-phase robust against jittered baseline (non-trivial)",
                 true, jitter_disc_pass)

    // ── PROBE 3: A4 orthant-bias — CIRCADIAN dip at cycle 12 ────────────
    // dip_center 를 8 → 12 로 이동. F-TIME-4a [6,10] 가 따라가는가?
    println("")
    println("  ── PROBE 3: A4 orthant-bias — CIRCADIAN dip @cycle 12 ────────")
    let r_circ_12 = run_probe_scenario(5, n_cycles, 0, 0, 12)
    println("    CIRC@12 env_dip_idx = " + str(r_circ_12["env_dip_idx"]) +
            "  env_min/max = " + str(r_circ_12["env_min"]/r_circ_12["env_max"]))
    // origin falsifier hardcodes [6,10]
    let dip12_idx = r_circ_12["env_dip_idx"]
    let dip12_in_origin_window = dip12_idx >= 6 && dip12_idx <= 10
    println("    F-TIME-4a [6,10] window against dip@12 ? " + str(dip12_in_origin_window))
    // generalized: dip_idx 가 실제 dip_center 와 ±1 일치하는가?
    let dip12_actually_at_12 = dip12_idx >= 11 && dip12_idx <= 13
    println("    actual dip_idx ∈ [11,13] (around true center 12) ? " +
            str(dip12_actually_at_12))
    check("PROBE-3a F-TIME-4a window [6,10] FAILS when true dip moves to 12",
          !dip12_in_origin_window)
    check("PROBE-3b dip_idx detector itself locates dip near true center 12",
          dip12_actually_at_12)
    // ROBUST 판정: origin F-TIME-4a 가 좁은 window hard-coded → orthant-biased
    robust_check("F-TIME-4a window robust to dip-center change",
                 true, dip12_in_origin_window)

    // ── PROBE 4: A2 sign-overlap — DRIFTING slow +1min/cycle ────────────
    println("")
    println("  ── PROBE 4: A2 sign-overlap — DRIFTING +1min/cycle ───────────")
    let r_drift_slow = run_probe_scenario(4, n_cycles, 1, 0, 8)
    println("    DRIFT-SLOW phase_std   = " + str(r_drift_slow["phase_std"]))
    println("    DRIFT-SLOW phase_slope = " + str(r_drift_slow["phase_slope"]))
    let slow_passes_F2 = r_drift_slow["phase_std"] > 20.0
    let slow_passes_F3 = abs_f(r_drift_slow["phase_slope"]) > 3.0
    println("    F-TIME-2 (>20.0) drift_slow ? " + str(slow_passes_F2))
    println("    F-TIME-3 (|slope|>3.0) drift_slow ? " + str(slow_passes_F3))
    check("PROBE-4a F-TIME-2 detects slow drift +1min/cycle", slow_passes_F2)
    check("PROBE-4b F-TIME-3 detects slow drift +1min/cycle (|slope|>3.0)",
          slow_passes_F3)
    robust_check("F-TIME-2 (>20.0) sensitive to slow drift", true, slow_passes_F2)
    robust_check("F-TIME-3 (|slope|>3.0) sensitive to slow drift", true, slow_passes_F3)

    // ── verdict ─────────────────────────────────────────────────────────
    println("")
    println("================================================================")
    println("  PROBE RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  ROBUSTNESS: " + str(ROBUST) + " ROBUST / " + str(SPURIOUS) + " SPURIOUS")
    println("================================================================")
    println("")
    println("  해석:")
    println("    SPURIOUS > 0 → origin 9/0 PASS 일부는 artifact (bench redesign 필요)")
    println("    SPURIOUS = 0 → origin 9/0 PASS 모두 robust (진짜 substrate 신호)")

    // RESULT JSON
    println("")
    println("RESULT_JSON_BEGIN")
    println("{")
    println("  \"probe\": \"time_e3_bench_recheck\",")
    println("  \"target\": \"bench/axis_time 9/0 PASS\",")
    println("  \"probe_pass\": " + str(PASS) + ",")
    println("  \"probe_fail\": " + str(FAIL) + ",")
    println("  \"robust\":   " + str(ROBUST) + ",")
    println("  \"spurious\": " + str(SPURIOUS) + ",")
    println("  \"a3_degrade_trivial_ratio\": " + str(stable_std_exactly_zero) + ",")
    println("  \"a1_collision_jittered_f1_robust\": " + str(jitter_passes_F1) + ",")
    println("  \"a1_disc_phase_robust_under_jitter\": " + str(jitter_disc_pass) + ",")
    println("  \"a4_orthant_dip12_in_origin_window\": " + str(dip12_in_origin_window) + ",")
    println("  \"a4_dip_detector_locates_true_center\": " + str(dip12_actually_at_12) + ",")
    println("  \"a2_slow_drift_f2_detected\": " + str(slow_passes_F2) + ",")
    println("  \"a2_slow_drift_f3_detected\": " + str(slow_passes_F3))
    println("}")
    println("RESULT_JSON_END")
}
