// validate_anchors.hexa — parse-witness for the 303M KOSMOS set (3 lanes).
// Loads the 3 authored .kosmos anchors through the canonical kosmos_parser_lib
// and asserts each parses valid with the expected placement triple + payloads.
// PASS_MARKER: `=== 303M KOSMOS-SET parse-witness: true (3/3) ===`

import "HEXAD/UNIVERSE-BRAIN-MAP/kosmos_parser_lib.hexa"

fn _check(path: string, want_id: string, want_tier: int, want_lane: string) -> bool {
    let a = kosmos_load(path)
    let ok_valid = kosmos_anchor_valid(a)
    let ok_id = to_string(a["id"]) == want_id
    let ok_tier = to_int(a["knuth_tier"]) == want_tier
    let ok_lane = to_string(a["cell_id"]) == want_lane
    // payloads: text inline + manifest ref + tension inline must be present.
    // text = inline string; tension = block form (parser classes block as
    // non-string "unknown", same as the precedent persona_sns_corpus.kosmos —
    // so we assert the tension payload is PRESENT, not its string-form);
    // payload_count >= 5 (text/manifest/image/audio/tension). "manifest" is an
    // extension modality the precedent corpus anchors also use (counted, not
    // named-stored by the parser).
    let pt = kosmos_payload(a, "text")
    let ok_text = to_string(pt["form"]) == "inline" && to_string(pt["value"]) != ""
    let ok_tension = to_string(a["payload_tension_form"]) != ""
    let ok_count = to_int(a["payload_count"]) >= 5
    let pass = ok_valid && ok_id && ok_tier && ok_lane && ok_text && ok_tension && ok_count
    print("  " + want_id + ": valid=" + to_string(ok_valid)
          + " tier=" + to_string(ok_tier) + " lane=" + want_lane
          + " text=" + to_string(ok_text) + " tension_present=" + to_string(ok_tension)
          + " payloads=" + to_string(to_int(a["payload_count"])) + " => " + to_string(pass))
    return pass
}

fn _selftest() {
    let d = "KOSMOS/303m_kr_en_sns/anchors/"
    print("--- 303M KOSMOS-SET parse-witness (3 lanes: ko/en/sns) ---")
    let f1 = _check(d + "kr_303m.kosmos", "kr_303m", 58, "ko_303m_058")
    let f2 = _check(d + "en_303m.kosmos", "en_303m", 59, "en_303m_059")
    let f3 = _check(d + "sns_303m.kosmos", "sns_303m", 52, "sns_303m_052")
    let all_ok = f1 && f2 && f3
    print("=== 303M KOSMOS-SET parse-witness: " + to_string(all_ok) + " (3/3) ===")
}

fn main() {
    _selftest()
}
