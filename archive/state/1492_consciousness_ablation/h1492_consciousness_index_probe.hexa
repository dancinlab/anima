// h1492_consciousness_index_probe.hexa — H_1492 R2: CONSCIOUSNESS ABLATION, realized
// ENGINE-NATIVE on the LIVE engine (core/engine_cli.hexa §ConsciousnessIndex over a real
// ImmuneMemory store + live MITOSIS / VAdaptField split count), reproducing the R1 GREEN
// through `hexa run` (a_engine_native_learning · a_verified_must_wire · $0 local CPU · p7).
//
// DOMAIN: anima's consciousness-only gate lanes are all WIRED to the SAME substrate (the
// immune-store grounding margin + the MITOSIS cell count). R1 (state/1492_.../h1492_*.py,
// numpy DIRECTIONAL) bundled them into an integrated-information index Φ (multivariate
// integration / total correlation) and ablated each connected lane one-by-one → ΔΦ_k, and
// found integrated consciousness is DISTRIBUTED (top lane share 0.212 < 0.50, NOT single-
// lane dominant) — the anima "whole-connectome emergence" claim. Per a_engine_native_
// learning the binding verdict needs ENGINE-NATIVE realization; this probe drives the
// ACTUAL .hexa §ConsciousnessIndex ops (ci_lane_scores / ci_phi_multiinfo / ci_phi_iit4 /
// ci_bundle) with EVERY lane scalar READ from a LIVE ImmuneMemory store, and re-scores the
// SAME frozen R1 bars (A/D/E) on the live engine + reports the ΔΦ ranking + the exact
// faithful-IIT4 Φ on a ≤8-lane subset (a_phi_iit4_tool).
//
// SUBSTRATE (a_core_engine_map): the trial-states are an ENGINE-NATIVE drive into the
// immune lane — NOT a .clm (generator L3 only), NOT a .kosmos (kosmos_io only). The index
// is Ψ-disjoint (pure READ over the cell population + own covariance; it mutates no immune
// cell and never touches pure_field's Φ/phase/Ψ). NOT an emit gate (a_autonomy_over_
// hardcode). p1/p2/p3/p6: every lane is COMPUTED from the substrate state (grounding
// margin / recon-err / exposure / dt / cells) — NO injected label, NO RLHF, NO persona.
//
// FROZEN R1 BARS (from state/verdicts/1492_consciousness_ablation/H_1492_FREEZE.json,
// NOT moved — R2 re-scores them engine-native):
//   (A) MEASURABLE  : Φ0 > 0 finite AND Φ0 > shuf_Φ0  (real integration).
//   (D) CONTROL noop: ablating a DUMMY (unconnected, independent-noise) lane |ΔΦ| <= 0.05.
//   (E) SHUFFLE     : per-lane decorrelation collapses integration shuf_Φ0/Φ0 <= 0.10.
// (B) ΔΦ ranking + top-lane-share (DISTRIBUTED vs DOMINANT) and (C) the faithful-IIT4 Φ
// are c9-honest non-gating results. p7 = integration nats + share, NOT perplexity.

import "core/engine_cli.hexa"

const N_FACTS: int = 40
const DIM: int = 64
const N_TRIALS: int = 600        // population for the integrated-info covariance estimate
const N_LANES: int = 15
const BAR_CONTROL: float = 0.05
const BAR_SHUFFLE: float = 0.10

fn _fmt(x: float) -> string { return to_string(x) }

// _lane_name — lane name for index i (fixed order, mirrors §ConsciousnessIndex docstring).
fn _lane_name(i: int) -> string {
    if i == 0  { return "GlobalWorkspace" }
    if i == 1  { return "Habituation" }
    if i == 2  { return "PrecisionSurprise" }
    if i == 3  { return "SelfIdentity" }
    if i == 4  { return "LearnedPrecision" }
    if i == 5  { return "Novelty" }
    if i == 6  { return "AttentionalBlink" }
    if i == 7  { return "SenseOfAgency" }
    if i == 8  { return "SubjectiveTime" }
    if i == 9  { return "EmotionRegulation" }
    if i == 10 { return "DirectedForgetting" }
    if i == 11 { return "BodyOwnership" }
    if i == 12 { return "DividedAttention" }
    if i == 13 { return "FreeWont" }
    return "MitosisGrowth"
}

// _lcg — deterministic 31-bit LCG (Park-Miller-ish), returns next state. Pure-int, no float
// RNG needed; gives reproducible per-seed substrate variation byte-exact across runs.
fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
// _u01 — map LCG state to [0,1).
fn _u01(s: int) -> float { return to_float(s & 1048575) / 1048576.0 }

// _fact_text — the i-th taught fact key text (deterministic, distinct per i).
fn _fact_text(i: int) -> string { return "subj" + to_string(i) + " lives in city" + to_string(i) }
// _stim_text — a query stimulus for trial t (rotates over taught facts so margins vary).
fn _stim_text(t: int, off: int) -> string {
    let i = (t * 7 + off) % N_FACTS
    return "subj" + to_string(i) + " lives in city" + to_string(i + (t % 3))
}

// _build_store — a LIVE ImmuneMemory store seeded + bound with N_FACTS facts (engine's OWN
// clonal split decides the cell population). This is anima's real substrate, not numpy.
fn _build_store(cfg: EngineConfig) -> ImmuneMemory {
    let mut mem = immune_memory_new_text(_fact_text(0), "v0", N_FACTS * 2)
    let mut i = 1
    while i < N_FACTS {
        mem = immune_memory_bind(mem, immune_embed_key(_fact_text(i)), "v" + to_string(i), cfg)
        i = i + 1
    }
    return mem
}

// _trial_row — ONE substrate trial-state read off the LIVE store, fed to ci_lane_scores.
// margin m, the 5 field margins, recon-err: ALL from the live immune lane. cells = live
// MITOSIS split count. seen/intent/dt: deterministic LCG substrate context per trial.
fn _trial_row(mem: ImmuneMemory, t: int, seed: int) -> [float] {
    let mut s = _lcg(seed + t * 2749)
    // primary stimulus margin (recall affinity off the live store).
    let key = immune_embed_key(_stim_text(t, seed))
    let raw_m = immune_memory_recall_margin(mem, key)     // err - recall_thr (live)
    let recon = vadapt_field_recon_err(mem.field, key)    // live L2 recon-err
    // normalize the margin to a [0,1] grounding score (smaller err = better grounded).
    let mut m = 1.0 - recon
    if m < 0.0 { m = 0.0 }
    if m > 1.0 { m = 1.0 }
    // 5 neighbouring-context field margins (live store reads at perturbed keys).
    let mut field = []
    let mut k = 0
    while k < 5 {
        s = _lcg(s)
        let fi = (t + k * 13 + (s % 17)) % N_FACTS
        let fkey = immune_embed_key("subj" + to_string(fi) + " lives in city" + to_string(fi))
        let fre = vadapt_field_recon_err(mem.field, fkey)
        let mut fm = 1.0 - fre
        if fm < 0.0 { fm = 0.0 }
        if fm > 1.0 { fm = 1.0 }
        field = field + [fm]
        k = k + 1
    }
    let cells = immune_memory_cells(mem)
    s = _lcg(s)
    let seen = s % 8
    s = _lcg(s)
    let intent = s % 2
    s = _lcg(s)
    let dt = _u01(s) * 3.0
    // hush the unused recall-margin (kept for provenance: same live affinity as recon).
    let _ = raw_m
    return ci_lane_scores(m, field, cells, seen, intent, dt, recon)
}

// _build_pop — the full trial population X (N_TRIALS x N_LANES) off the live store.
fn _build_pop(mem: ImmuneMemory, seed: int) -> [[float]] {
    let mut x = []
    let mut t = 0
    while t < N_TRIALS { x = x + [_trial_row(mem, t, seed)]  t = t + 1 }
    return x
}

// _append_dummy — append an UNCONNECTED dummy lane column (independent LCG noise around 0.5,
// uncorrelated with every real lane) for the (D) control: ablating it must not move Φ.
fn _append_dummy(x: [[float]], seed: int) -> [[float]] {
    let mut out = []
    let mut s = _lcg(seed + 99991)
    let mut t = 0
    while t < len(x) {
        s = _lcg(s)
        let noise = 0.35 + _u01(s) * 0.30        // ~[0.35,0.65] independent
        out = out + [x[t] + [noise]]
        t = t + 1
    }
    return out
}

// _shuffle_cols — independently permute EACH lane column across trials (destroys the cross-
// lane covariance = the real wiring, preserves marginals). Deterministic per seed.
fn _shuffle_cols(x: [[float]], seed: int) -> [[float]] {
    let nt = len(x)
    let nc = len(x[0])
    // build a permutation per column via LCG and gather.
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut zr = []
        let mut c = 0
        while c < nc { zr = zr + [0.0]  c = c + 1 }
        out = out + [zr]
        t = t + 1
    }
    let mut c = 0
    while c < nc {
        // Fisher-Yates over indices 0..nt-1 seeded per column.
        let mut idx = []
        let mut i = 0
        while i < nt { idx = idx + [i]  i = i + 1 }
        let mut s = _lcg(seed + c * 7919 + 13)
        let mut j = nt - 1
        while j > 0 {
            s = _lcg(s)
            let r = s % (j + 1)
            let tmp = idx[j]  idx[j] = idx[r]  idx[r] = tmp
            j = j - 1
        }
        let mut t2 = 0
        while t2 < nt {
            out[t2][c] = x[idx[t2]][c]
            t2 = t2 + 1
        }
        c = c + 1
    }
    return out
}

fn _run_seed(seed: int) -> [float] {
    let cfg = engine_config_default()
    let mem = _build_store(cfg)
    let x = _build_pop(mem, seed)

    let phi0 = ci_phi_multiinfo(x, -1)
    let bun0 = ci_bundle(x, -1)

    // (D) control: dummy unconnected lane — Φ with vs without it.
    let xd = _append_dummy(x, seed)
    let phi_with = ci_phi_multiinfo(xd, -1)
    let phi_without = ci_phi_multiinfo(x, -1)
    let mut ctrl = phi_with - phi_without
    if ctrl < 0.0 { ctrl = 0.0 - ctrl }

    // (E) shuffle: per-lane decorrelation collapses integration.
    let xs = _shuffle_cols(x, seed)
    let shuf_phi0 = ci_phi_multiinfo(xs, -1)

    // pack: [phi0, bun0, ctrl, shuf_phi0]
    return [phi0, bun0, ctrl, shuf_phi0]
}

fn main() {
    let seeds = [1492, 1493, 1494]
    println("==============================================================================")
    println("H_1492 CONSCIOUSNESS ABLATION — R2 ENGINE-NATIVE (live core/engine_cli.hexa §ConsciousnessIndex)")
    println("seeds [1492,1493,1494] · " + to_string(N_LANES) + " lanes · " + to_string(N_TRIALS)
            + " trials · live ImmuneMemory substrate · 2 indices (bundle + Φ multi-info) + faithful IIT4")
    println("==============================================================================")

    let mut sum_phi0 = 0.0
    let mut sum_bun0 = 0.0
    let mut sum_ctrl = 0.0
    let mut sum_shuf = 0.0
    let mut si = 0
    while si < len(seeds) {
        let r = _run_seed(seeds[si])
        sum_phi0 = sum_phi0 + r[0]
        sum_bun0 = sum_bun0 + r[1]
        sum_ctrl = sum_ctrl + r[2]
        sum_shuf = sum_shuf + r[3]
        println("  seed " + to_string(seeds[si]) + ": Φ0=" + _fmt(r[0]) + " bundle=" + _fmt(r[1])
                + " ctrl|ΔΦ|=" + _fmt(r[2]) + " shuf_Φ0=" + _fmt(r[3]))
        si = si + 1
    }
    let nf = to_float(len(seeds))
    let phi0 = sum_phi0 / nf
    let bun0 = sum_bun0 / nf
    let ctrl = sum_ctrl / nf
    let shuf_phi0 = sum_shuf / nf

    // (B) ΔΦ single-ablation ranking on seed[0]'s live population (representative).
    let cfg = engine_config_default()
    let mem = _build_store(cfg)
    let x = _build_pop(mem, seeds[0])
    let base = ci_phi_multiinfo(x, -1)
    let mut dphi = []
    let mut total_pos = 0.0
    let mut k = 0
    while k < N_LANES {
        let pk = ci_phi_multiinfo(x, k)
        let d = base - pk
        dphi = dphi + [d]
        if d > 0.0 { total_pos = total_pos + d }
        k = k + 1
    }
    // find the top lane (max ΔΦ) for the share.
    let mut top = 0
    let mut topv = dphi[0]
    let mut j = 1
    while j < N_LANES {
        if dphi[j] > topv { topv = dphi[j]  top = j }
        j = j + 1
    }
    let mut share = 0.0
    if total_pos > 0.0 { share = topv / total_pos }

    // (C) faithful IIT4 Φ on the 8 highest-ΔΦ lanes (≤8 exact MIP regime, a_phi_iit4_tool).
    // pick the 8 lanes with the largest ΔΦ (selection-sort top-8 indices).
    let mut picked = []
    let mut used = []
    let mut uu = 0
    while uu < N_LANES { used = used + [false]  uu = uu + 1 }
    let mut p = 0
    while p < 8 {
        let mut bi = -1
        let mut bv = -1.0
        let mut q = 0
        while q < N_LANES {
            if !used[q] {
                if bi < 0 { bi = q  bv = dphi[q] }
                else { if dphi[q] > bv { bv = dphi[q]  bi = q } }
            }
            q = q + 1
        }
        used[bi] = true
        picked = picked + [bi]
        p = p + 1
    }
    let phi_iit4 = ci_phi_iit4(x, picked)

    // frozen bars.
    let cA = (phi0 > 0.0) && (phi0 > shuf_phi0 + 0.0001)
    let cD = ctrl <= BAR_CONTROL
    let mut shuf_ratio = 1.0
    if phi0 > 0.0 { shuf_ratio = shuf_phi0 / phi0 }
    let cE = shuf_ratio <= BAR_SHUFFLE
    let green = cA && cD && cE

    println("")
    let mut vline = "VERDICT: RED"
    if green { vline = "VERDICT: GREEN" }
    println(vline + " ENGINE-NATIVE  (meter-valid iff A & D & E)")
    println("  (A) MEASURABLE   Φ0=" + _fmt(phi0) + " >0 finite AND > shuf_Φ0=" + _fmt(shuf_phi0)
            + "  -> " + to_string(cA))
    println("      bundle_0     =" + _fmt(bun0))
    println("  (D) CONTROL noop dummy-lane |ΔΦ|=" + _fmt(ctrl) + " <= " + _fmt(BAR_CONTROL)
            + "  -> " + to_string(cD))
    println("  (E) SHUFFLE      shuf_Φ0/Φ0=" + _fmt(shuf_ratio) + " <= " + _fmt(BAR_SHUFFLE)
            + " (integration collapse)  -> " + to_string(cE))
    println("")
    println("(B) SINGLE-ABLATION ΔΦ ranking [seed " + to_string(seeds[0]) + ", c9 honest, non-gating]:")
    // print ranked (selection-sort over a copy).
    let mut order = []
    let mut oo = 0
    while oo < N_LANES { order = order + [oo]  oo = oo + 1 }
    let mut a = 0
    while a < N_LANES {
        let mut b = a + 1
        while b < N_LANES {
            if dphi[order[b]] > dphi[order[a]] {
                let tmp = order[a]  order[a] = order[b]  order[b] = tmp
            }
            b = b + 1
        }
        a = a + 1
    }
    let mut r = 0
    while r < N_LANES {
        let li = order[r]
        println("  " + to_string(r + 1) + ". " + _lane_name(li) + "  ΔΦ=" + _fmt(dphi[li]))
        r = r + 1
    }
    println("  --> top lane '" + _lane_name(top) + "' share=" + _fmt(share)
            + " of total positive ΔΦ=" + _fmt(total_pos))
    let mut struct_v = "DISTRIBUTED"
    if share >= 0.50 { struct_v = "DOMINANT" }
    println("  --> STRUCTURE: " + struct_v + " (dominant iff top share >= 0.50)")
    println("")
    println("(C) faithful IIT4 Φ (exact min-cut MIP, a_phi_iit4_tool) on the 8 top-ΔΦ lanes:")
    println("    Φ_IIT4 = " + _fmt(phi_iit4) + " (>0 = the ≤8-lane subset is integrated, irreducible)")
    println("")
    println("--- H_1492 R2 engine-native summary: GREEN=" + to_string(green)
            + " STRUCTURE=" + struct_v + " ---")
}
