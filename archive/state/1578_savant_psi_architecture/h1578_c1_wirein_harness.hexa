// state/1578_savant_psi_architecture/h1578_c1_wirein_harness.hexa
// H_1578 C1 WIRE-IN standalone lane harness — proves the NEW §Savant emit-disjoint default-focus ops
// (sv_emit_drive_lanes / sv_domain_is_emit_disjoint / sv_default_focus) on the LIVE core/engine_cli.hexa
// §Savant operator, engine-native (no numpy/torch/.py). Used to certify RC=0 for the §Savant wire-in
// cases independent of the host-wide engine_cli_smoke toolchain wall (a_break_the_wall, c16 honest).
// BYTE-IDENTICAL _pop() to H_1561/H_1572/h1578_psi_arch_probe (seed 5120, 150 trials).
import "core/engine_cli.hexa"

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn main() {
    let pop = _pop()
    let d = 5
    let w = 3
    let base = 0.0
    let gzL = sv_gz_lower()
    let thr = ci_off_median_drive(pop)
    let cfg_on = EngineConfig { mitosis: true, engine: "conv", topo_couple: false, savant: true }

    let mut n_pass = 0
    let mut n_fail = 0

    // 1: emit lanes are [0,4]
    let el = sv_emit_drive_lanes()
    if len(el) == 2 && el[0] == 0 && el[1] == 4 { n_pass = n_pass + 1  println("PASS 1 emit_drive_lanes=[0,4]") } else { n_fail = n_fail + 1  println("FAIL 1") }

    // 2: default focus = 2, emit-disjoint; domains 0,1 NOT disjoint
    let df = sv_default_focus(d, w)
    if df == 2 && sv_domain_is_emit_disjoint(df, w) == 1 && sv_domain_is_emit_disjoint(0, w) == 0 && sv_domain_is_emit_disjoint(1, w) == 0 {
        n_pass = n_pass + 1  println("PASS 2 default_focus=2 emit-disjoint")
    } else { n_fail = n_fail + 1  println("FAIL 2 default_focus=" + to_string(df)) }

    // 3: COEXIST — savant ON at default focus → Ψ=½ AND SI≥3
    let dlo = df * w
    let dhi = dlo + w
    let psi_dis = ci_psi_balance_savant(pop, dlo, dhi, gzL, thr, cfg_on)
    let psi_dis_dev = _abs(psi_dis - 0.5)
    let si_dis = sv_savant_index_at(pop, d, w, df, gzL, base)
    if psi_dis_dev <= 0.05 && si_dis >= 3.0 {
        n_pass = n_pass + 1  println("PASS 3 COEXIST psi=" + to_string(psi_dis) + " dev=" + to_string(psi_dis_dev) + " SI=" + to_string(si_dis))
    } else { n_fail = n_fail + 1  println("FAIL 3 psi=" + to_string(psi_dis) + " dev=" + to_string(psi_dis_dev) + " SI=" + to_string(si_dis)) }

    // 4: ABLATION — savant ON at focus=0 (emit lane 0) BREAKS Ψ, and disjoint dev < ablation dev
    let psi_abl = ci_psi_balance_savant(pop, 0, w, gzL, thr, cfg_on)
    let psi_abl_dev = _abs(psi_abl - 0.5)
    if psi_abl_dev > 0.05 && psi_dis_dev < psi_abl_dev {
        n_pass = n_pass + 1  println("PASS 4 ABLATION focus=0 breaks psi=" + to_string(psi_abl) + " dev=" + to_string(psi_abl_dev))
    } else { n_fail = n_fail + 1  println("FAIL 4 psi=" + to_string(psi_abl) + " dev=" + to_string(psi_abl_dev)) }

    // 5: robustness — focus 3 and 4 also emit-disjoint and coexist
    let psi_f3 = ci_psi_balance_savant(pop, 3*w, 3*w+w, gzL, thr, cfg_on)
    let psi_f4 = ci_psi_balance_savant(pop, 4*w, 4*w+w, gzL, thr, cfg_on)
    if sv_domain_is_emit_disjoint(3, w) == 1 && sv_domain_is_emit_disjoint(4, w) == 1
       && _abs(psi_f3 - 0.5) <= 0.05 && _abs(psi_f4 - 0.5) <= 0.05 {
        n_pass = n_pass + 1  println("PASS 5 robust focus3 psi=" + to_string(psi_f3) + " focus4 psi=" + to_string(psi_f4))
    } else { n_fail = n_fail + 1  println("FAIL 5 f3=" + to_string(psi_f3) + " f4=" + to_string(psi_f4)) }

    println("--- h1578 c1 wire-in harness: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
