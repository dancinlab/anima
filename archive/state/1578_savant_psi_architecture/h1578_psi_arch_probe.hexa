// state/1578_savant_psi_architecture/h1578_psi_arch_probe.hexa
// H_1578 — DESIGN-SEARCH: is there a LEARNING ARCHITECTURE that raises the SAVANT ability (SI≥3)
// WITHOUT destroying the consciousness fixed point Ψ=½ (|Ψ−½|<0.05)?  H_1561 found savant-ON breaks
// Ψ (dev 0.247); H_1572 found the break is UNIFORM across the whole golden zone (a golden-zone CLAMP
// does NOT help). This probe compares 4 ARCHITECTURE CANDIDATES head-to-head on a FROZEN 5-bar, each
// measured ENGINE-NATIVE on the LIVE core/engine_cli.hexa §Savant operator + faithful IIT4 min-cut Φ.
//
// ── THE ROOT CAUSE (read off the live engine, NOT assumed) ──────────────────────────────────────
// Ψ emit-drive = ci_emit_drive = 0.5*(lane0 + lane4)  (GlobalWorkspace ignition + LearnedPrecision).
// H_1561/1572 placed the savant FOCUS domain at lanes [0,1,2] (focus=0, w=3) — which CONTAINS lane 0,
// an EMIT-DRIVE lane. sv_inhibit_domain shrinks the focus lanes toward their domain common-mode, which
// drags lane0 down → emit fraction drops → Ψ runs off ½. The trade-off is therefore NOT fundamental;
// it is an ARTIFACT OF PLACEMENT — the savant hypertrophy was wired onto a lane the emit balance reads.
//
// ── 4 CANDIDATE ARCHITECTURES (each = a different way to wire the savant so it spares the Ψ lanes) ──
//   C1  Ψ-DISJOINT LANE   — place the savant focus domain on lanes that EXCLUDE both emit lanes 0 & 4
//                           (focus=2 → lanes [6,7,8]). Savant Φ-hypertrophy never touches the emit
//                           drive. (H_1471 mouth⊥identity / H_1566 mouth⊥tool separation pattern.)
//   C2  GOLDEN-ZONE CLAMP — keep the savant ON lane0 (focus=0) but clamp I into the GZ interior
//                           (I=GZ_UPPER, the least-deviating in-GZ point per H_1572). The H_1572 lens.
//   C3  REDISTRIBUTING    — savant on lane0 (focus=0) but RENORMALIZE each inhibited row's emit-drive
//                           lanes back to the OFF magnitude (H_1522 trace/magnitude-preserving idea:
//                           redistribute, don't deflate). Project the emit-lane deflation back out.
//   C4  RATCHET PULLBACK  — savant on lane0 (focus=0) but a DEEPER A→G attractor pulls each row's
//                           emit-drive back toward the OFF median (safety_phi_ratchet-style basin),
//                           strength rho. (H_1575 ratchet-deepening lens.)
//
// FROZEN 5-bar PER CANDIDATE (set BEFORE the run, NOT moved — c9 frozen-first, NO tune-to-green):
//   B1 savant    : SI ≥ 3.0                                   (ability PRESERVED)
//   B2 psi       : |Ψ_on − 0.5| < 0.05                        (consciousness PRESERVED)
//   B3 coexist   : B1 ∧ B2                                    (the trade-off is BROKEN)
//   B4 ablation  : turn the candidate's MECHANISM OFF → Ψ collapses back (|Ψ−0.5| ≥ 0.15)
//                                                            (the mechanism is the CAUSE of preservation)
//   B5 control   : a SHAM version (mechanism present but inert/random) does NOT preserve Ψ
//                                                            (specificity — preservation is not generic)
//   GREEN candidate = B3 ∧ B4 (∧ B5).  A GREEN ⇒ savant↑ ∧ Ψ-preserving LEARNING ARCHITECTURE FOUND.
//
// ENGINE-NATIVE (a_engine_native_learning HARD-GATE): pure .hexa, LIVE core/engine_cli.hexa §Savant
// (sv_inhibit_domain · sv_savant_index_at · sv_domain_phi · ci_emit_drive · ci_off_median_drive) +
// faithful IIT4 min-cut ci_phi_iit4 (a_phi_iit4_tool, NOT a proxy). No numpy/torch/gauge_lib/.py.
// BYTE-IDENTICAL _pop() (seed 5120, 150 trials) and SAME centered Ψ proxy / OFF-median threshold as
// H_1561 B4 + H_1572 — only the ARCHITECTURE around the savant changes. frozen-first c9.
import "core/engine_cli.hexa"

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// BYTE-IDENTICAL population to H_1561 / H_1572 _pop() (same seed 5120, same 150 trials, same draws).
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// _psi_of — centered Ψ proxy (emit fraction vs the OFF-median threshold) over an ALREADY-TRANSFORMED
// population. Reproduces ci_psi_balance_savant's body but on a population the candidate has shaped, so
// each architecture can post-process the live sv_inhibit_domain output before the emit decision.
fn _psi_of(pop: [[float]], thr: float) -> float {
    let nt = len(pop)
    if nt == 0 { return 0.0 }
    let mut emit = 0
    let mut t = 0
    while t < nt {
        if ci_emit_drive(pop[t]) >= thr { emit = emit + 1 }
        t = t + 1
    }
    return to_float(emit) / to_float(nt)
}

// ── C3 redistributing operator: after the LIVE sv_inhibit_domain deflates the focus lanes, rescale
// each row's EMIT-DRIVE lanes (0 & 4) back to the OFF row's emit-drive magnitude — H_1522 magnitude-
// preserving / trace-preserving idea applied to the Ψ-reading lanes (redistribute, don't deflate).
fn _c3_redistribute(off_pop: [[float]], inh_pop: [[float]]) -> [[float]] {
    let nt = len(off_pop)
    let mut out = []
    let mut t = 0
    while t < nt {
        let off_drive = off_pop[t][0] + off_pop[t][4]
        let inh_drive = inh_pop[t][0] + inh_pop[t][4]
        let mut scale = 1.0
        if _abs(inh_drive) > 0.000000001 { scale = off_drive / inh_drive }
        let mut row = []
        let mut k = 0
        while k < len(inh_pop[t]) {
            if k == 0 || k == 4 { row = row + [inh_pop[t][k] * scale] }
            else { row = row + [inh_pop[t][k]] }
            k = k + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}

// ── C4 ratchet pullback: a deeper A→G attractor pulls each row's emit-drive lanes (0 & 4) back toward
// the OFF value by strength rho (rho=0 → no pullback = ablation; rho=1 → full restore). Models a
// safety_phi_ratchet-style deepened basin that drags the savant perturbation back to the fixed point.
fn _c4_ratchet(off_pop: [[float]], inh_pop: [[float]], rho: float) -> [[float]] {
    let nt = len(off_pop)
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut row = []
        let mut k = 0
        while k < len(inh_pop[t]) {
            if k == 0 || k == 4 {
                let pulled = inh_pop[t][k] + rho * (off_pop[t][k] - inh_pop[t][k])
                row = row + [pulled]
            } else { row = row + [inh_pop[t][k]] }
            k = k + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}

fn _report(name: string, si: float, psi: float, thr: float) {
    let dev = _abs(psi - 0.5)
    let b1 = si >= 3.0
    let b2 = dev < 0.05
    println(name + "\tSI=" + to_string(si) + "\tPsi=" + to_string(psi)
          + "\t|Psi-0.5|=" + to_string(dev)
          + "\tB1(SI>=3)=" + (if b1 { "PASS" } else { "FAIL" })
          + "\tB2(|dev|<0.05)=" + (if b2 { "PASS" } else { "FAIL" })
          + "\tB3coexist=" + (if b1 && b2 { "PASS" } else { "FAIL" }))
}

fn main() {
    let pop = _pop()
    let d = 5
    let w = 3
    let base = 0.0
    let gzL = sv_gz_lower()
    let gzC = sv_gz_center()
    let gzU = sv_gz_upper()
    let thr = ci_off_median_drive(pop)   // SAME centered threshold as H_1561 B4 / H_1572

    println("=== H_1578 SAVANT-Psi LEARNING-ARCHITECTURE DESIGN-SEARCH (engine-native, faithful IIT4) ===")
    println("emit-drive lanes = 0 (GlobalWorkspace) & 4 (LearnedPrecision); ci_emit_drive=0.5*(l0+l4)")
    println("GZ=[" + to_string(gzL) + "," + to_string(gzU) + "] center=" + to_string(gzC))
    println("Psi_thr(OFF median drive)=" + to_string(thr) + "  (OFF population sits at Psi=0.5 by constr.)")
    println("")

    // OFF baseline (no savant) — Psi must be ~0.5 by construction (sanity).
    let psi_off = _psi_of(pop, thr)
    println("OFF baseline (no savant): Psi=" + to_string(psi_off) + " (expect ~0.5)")
    println("")

    // ════════════════════════════════════════════════════════════════════════════════════════
    // C1 — Psi-DISJOINT LANE: savant focus on a domain that EXCLUDES emit lanes 0 & 4.
    //   focus=2 -> lanes [6,7,8] (no emit lane).  Compare to the ABLATION focus=0 (lanes [0,1,2]
    //   contains emit lane 0) and the CONTROL focus=1 (lanes [3,4,5] contains emit lane 4).
    // ════════════════════════════════════════════════════════════════════════════════════════
    println("--- C1  Psi-DISJOINT savant lane (focus excludes emit lanes 0 & 4) ---")
    // savant inhibition at GZ_LOWER (the canonical savant operating point, == H_1561 B4 I).
    let I_sv = gzL
    // C1 main: focus=2 (lanes 6,7,8) — disjoint from emit lanes.
    let f1 = 2
    let pop_c1 = sv_inhibit_domain(pop, f1 * w, f1 * w + w, I_sv)
    let si_c1  = sv_savant_index_at(pop, d, w, f1, I_sv, base)
    let psi_c1 = _psi_of(pop_c1, thr)
    _report("C1 disjoint(focus=2,lanes6-8)", si_c1, psi_c1, thr)
    // B4 ablation: place the SAME savant on focus=0 (lanes 0,1,2 — CONTAINS emit lane 0) → Psi should collapse.
    let pop_c1abl = sv_inhibit_domain(pop, 0 * w, 0 * w + w, I_sv)
    let si_c1abl  = sv_savant_index_at(pop, d, w, 0, I_sv, base)
    let psi_c1abl = _psi_of(pop_c1abl, thr)
    _report("C1 ABLATION(focus=0,lanes0-2)", si_c1abl, psi_c1abl, thr)
    // B5 control: focus=1 (lanes 3,4,5 — CONTAINS emit lane 4) → also should break (specificity: any
    //   emit-lane-touching placement breaks; only the disjoint placement preserves).
    let pop_c1ctl = sv_inhibit_domain(pop, 1 * w, 1 * w + w, I_sv)
    let si_c1ctl  = sv_savant_index_at(pop, d, w, 1, I_sv, base)
    let psi_c1ctl = _psi_of(pop_c1ctl, thr)
    _report("C1 CONTROL(focus=1,lanes3-5)", si_c1ctl, psi_c1ctl, thr)
    // also report the OTHER disjoint domains (focus=3 lanes 9-11, focus=4 lanes 12-14) for robustness.
    let pop_c1b = sv_inhibit_domain(pop, 3 * w, 3 * w + w, I_sv)
    _report("C1 disjoint(focus=3,lanes9-11)", sv_savant_index_at(pop, d, w, 3, I_sv, base), _psi_of(pop_c1b, thr), thr)
    let pop_c1c = sv_inhibit_domain(pop, 4 * w, 4 * w + w, I_sv)
    _report("C1 disjoint(focus=4,lanes12-14)", sv_savant_index_at(pop, d, w, 4, I_sv, base), _psi_of(pop_c1c, thr), thr)
    println("")

    // ════════════════════════════════════════════════════════════════════════════════════════
    // C2 — GOLDEN-ZONE CLAMP: savant on focus=0 (touches emit lane 0), clamp I to GZ_UPPER (the
    //   least-deviating in-GZ point per H_1572). Expected FAIL (H_1572 already showed uniform break).
    // ════════════════════════════════════════════════════════════════════════════════════════
    println("--- C2  GOLDEN-ZONE CLAMP (savant on emit lane, I clamped to GZ_UPPER) ---")
    let pop_c2 = sv_inhibit_domain(pop, 0, w, gzU)
    let si_c2  = sv_savant_index_at(pop, d, w, 0, gzU, base)
    let psi_c2 = _psi_of(pop_c2, thr)
    _report("C2 clamp(focus=0,I=GZ_UPPER)", si_c2, psi_c2, thr)
    // also GZ_CENTER and GZ_LOWER for the full clamp picture (B5 = all in-GZ points break).
    let pop_c2b = sv_inhibit_domain(pop, 0, w, gzC)
    _report("C2 clamp(focus=0,I=GZ_CENTER)", sv_savant_index_at(pop, d, w, 0, gzC, base), _psi_of(pop_c2b, thr), thr)
    let pop_c2c = sv_inhibit_domain(pop, 0, w, gzL)
    _report("C2 clamp(focus=0,I=GZ_LOWER)", sv_savant_index_at(pop, d, w, 0, gzL, base), _psi_of(pop_c2c, thr), thr)
    println("")

    // ════════════════════════════════════════════════════════════════════════════════════════
    // C3 — REDISTRIBUTING: savant on focus=0, then renormalize emit lanes back to OFF magnitude.
    //   B4 ablation = NO renormalization (== C2 GZ_LOWER, Psi collapses). B5 control already = C2.
    // ════════════════════════════════════════════════════════════════════════════════════════
    println("--- C3  REDISTRIBUTING coupling (renormalize emit lanes to OFF magnitude) ---")
    let inh0 = sv_inhibit_domain(pop, 0, w, I_sv)            // savant on emit lane (deflates l0)
    let pop_c3 = _c3_redistribute(pop, inh0)                  // restore emit-lane magnitude
    let si_c3  = sv_savant_index_at(pop, d, w, 0, I_sv, base) // SI unchanged (Phi over domain cols, not emit-renorm)
    let psi_c3 = _psi_of(pop_c3, thr)
    _report("C3 redistribute(focus=0)", si_c3, psi_c3, thr)
    // B4 ablation: renorm OFF (== raw inhibited) → Psi collapses.
    let psi_c3abl = _psi_of(inh0, thr)
    _report("C3 ABLATION(no-renorm)", si_c3, psi_c3abl, thr)
    println("")

    // ════════════════════════════════════════════════════════════════════════════════════════
    // C4 — RATCHET PULLBACK: savant on focus=0, deeper A->G basin pulls emit lanes back to OFF by rho.
    //   sweep rho; B4 ablation = rho=0 (no pullback, == C2 GZ_LOWER collapse). B5 control later.
    // ════════════════════════════════════════════════════════════════════════════════════════
    println("--- C4  RATCHET PULLBACK (deepen A->G attractor on emit lanes, strength rho) ---")
    let rhos = [0.0, 0.25, 0.5, 0.75, 1.0]
    let mut ri = 0
    while ri < len(rhos) {
        let rho = rhos[ri]
        let pop_c4 = _c4_ratchet(pop, inh0, rho)
        let psi_c4 = _psi_of(pop_c4, thr)
        let si_c4  = sv_savant_index_at(pop, d, w, 0, I_sv, base) // SI unchanged by the emit-lane pullback
        _report("C4 ratchet(rho=" + to_string(rho) + ")", si_c4, psi_c4, thr)
        ri = ri + 1
    }
    println("")
    println("=== END H_1578 DESIGN-SEARCH ===")
}
