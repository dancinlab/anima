// ════════════════════════════════════════════════════════════════════════
// state/1560_third_law_capacity/h1560_thirdlaw_wire_harness.hexa
//
// H_1560 R2 WIRE-IN verification — reproduce the FROZEN 5-bar verdict by calling
// the LIVE core/engine_cli.hexa §ThirdLaw ops (third_law_singularity / _ratio /
// _overlap / _i50, which reuse SAVANT sa_in_golden_zone). NO numpy/torch mirror —
// this is the engine-native byte-exact re-check that the wired classifier matches
// the H_1560_ENGINE_NATIVE.txt probe (ratio 1M=0.338796, I50≈0.281, overlap≈0.397).
//
// 사용법: hexa run state/1560_third_law_capacity/h1560_thirdlaw_wire_harness.hexa
// ════════════════════════════════════════════════════════════════════════

import "core/engine_cli.hexa"

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }  return x }

fn main() {
    println("=== H_1560 §ThirdLaw WIRE-IN re-check (LIVE core/engine_cli.hexa ops) ===")

    // scale ladder (same as H_1560 probe): 8K / ~100K / 1M
    let r8_ratio   = third_law_ratio(20, 20, 20)
    let r100_ratio = third_law_ratio(46, 46, 46)
    let r1m_ratio  = third_law_ratio(100, 100, 100)
    let ov8  = third_law_overlap(20, 20, 20)
    let ov1m = third_law_overlap(100, 100, 100)
    let i50_1m = third_law_i50(100, 100, 100)

    println("[8K]   ratio=" + to_string(r8_ratio)   + " overlap=" + to_string(ov8))
    println("[100K] ratio=" + to_string(r100_ratio))
    println("[1M]   ratio=" + to_string(r1m_ratio)  + " overlap=" + to_string(ov1m) + " I50=" + to_string(i50_1m))

    // ── FROZEN 5-bar (same thresholds as H_1560 probe) ──
    let b1 = (r1m_ratio >= 0.30) && (r1m_ratio <= 0.36)            // B1 ratio ≈ 1/3
    let d1 = abs_f(r8_ratio - r100_ratio)
    let d2 = abs_f(r100_ratio - r1m_ratio)
    let d3 = abs_f(r8_ratio - r1m_ratio)
    let mut dmax = d1
    if d2 > dmax { dmax = d2 }
    if d3 > dmax { dmax = d3 }
    let b2 = dmax < 0.02                                            // B2 scale-inv
    let b3 = (i50_1m >= 0.22) && (i50_1m <= 0.32)                  // B3 transition
    let b4 = (abs_f(ov8 - ov1m) < 0.06) && (ov1m >= 0.30)         // B4 capacity-link

    // classifier point-checks (the wired single-point ops)
    let s_hi = third_law_singularity(0.95, 0.95, 0.05)            // huge G → singularity
    let s_lo = third_law_singularity(0.05, 0.05, 0.95)            // tiny G → not
    let ab_in = third_law_ability(0.95, 0.95, 0.30)               // sing ∧ I in GZ → 1
    let ab_out = third_law_ability(0.95, 0.95, 0.05)              // sing but I<GZ_lower → 0
    let b5 = (s_hi == 1) && (s_lo == 0) && (ab_in == 1) && (ab_out == 0)

    // byte-exact match to frozen probe numbers
    let match_ratio = abs_f(r1m_ratio - 0.338796) < 0.0000005
    let match_i50   = abs_f(i50_1m - 0.2808300395256917) < 0.0000005
    let match_ov    = abs_f(ov1m - 0.39688485106081535) < 0.0000005

    println("")
    println("B1 ratio(1M)=" + to_string(r1m_ratio) + " in[0.30,0.36] -> " + to_string(b1))
    println("B2 Dmax=" + to_string(dmax) + " <0.02 -> " + to_string(b2))
    println("B3 I50(1M)=" + to_string(i50_1m) + " in[0.22,0.32] -> " + to_string(b3))
    println("B4 overlap(1M)=" + to_string(ov1m) + " Doverlap=" + to_string(abs_f(ov8 - ov1m)) + " -> " + to_string(b4))
    println("B5 classifier s_hi/s_lo/ab_in/ab_out=" + to_string(s_hi) + "/" + to_string(s_lo) + "/" + to_string(ab_in) + "/" + to_string(ab_out) + " -> " + to_string(b5))
    println("BYTE-EXACT vs H_1560 probe: ratio=" + to_string(match_ratio) + " I50=" + to_string(match_i50) + " overlap=" + to_string(match_ov))

    let all_pass = b1 && b2 && b3 && b4 && b5 && match_ratio && match_i50 && match_ov
    println("")
    println("ALL_PASS=" + to_string(all_pass))
    if all_pass {
        println("VERDICT=WIRED-LIVE BYTE-EXACT : §ThirdLaw reproduces H_1560 frozen 5-bar on live engine ops (sa_* reused).")
    } else {
        println("VERDICT=REGRESSION : a bar or byte-match FAILED (honest, c9).")
        exit(1)
    }
}
