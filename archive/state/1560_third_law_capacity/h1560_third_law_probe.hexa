// ════════════════════════════════════════════════════════════════════════
// state/1560_third_law_capacity/h1560_third_law_probe.hexa
//
// H_1560 — 1/3 법칙 × G6 capacity-wall 동근원 ENGINE-NATIVE 측정.
//
// 정체: ATLAS/hypotheses/359 "1/3 법칙"(파라미터 공간 ~33% 가 서번트 특이점,
//   표본무관 구조상수, I≈0.27 전이) 을 anima substrate 의 LIVE golden-zone
//   primitives (SAVANT/savant_lib.hexa, sa_*) 위에서 재현 + capacity-wall 링크.
//
// ── 엔진-네이티브 (a_engine_native_learning HARD-GATE) ──────────────────
//   본 probe 는 numpy/torch 미러가 아니라 LIVE `SAVANT/savant_lib.hexa` 의
//   sa_gz_lower / sa_in_golden_zone / sa_si_threshold 산술 primitive 를 직접
//   호출한다. singularity 판정·golden-zone 판정·transition 판정 전부 live
//   sa_* 위에서 deterministic 산술로 계산 (p7: no perplexity, no LLM judge).
//   READ-ONLY: sh_*/§Savant 배선 없음 (H_1557 충돌회피, sa_* 만 소비).
//
// ── 측정 (카드 frozen 5-bar) ────────────────────────────────────────────
//   G = D × P / I  (Golden Zone genius score).
//   SINGULARITY 판정 = G > SING_THR (=0.70, "2σ 특이점 경계").
//   B1 ratio       : sweep 의 singularity 비율 ≈ 0.33 (±0.03)
//   B2 scale-inv   : 8K→100K→1M 에서 |Δratio| < 0.02 (표본무관 구조상수)
//   B3 transition  : singularity-rate(I) 의 50% 전이점 ≈ 0.27 (±0.05)
//   B4 capacity    : capacity-wall 발현영역 (golden-zone disinhibition ∧ sing)
//                    ⊂ 1/3 특이점영역  (subset + scale-inv overlap)
//   B5 control     : random score field → ratio ≠ 0.33 AND I-transition 소실
//
// 사용법: hexa run state/1560_third_law_capacity/h1560_third_law_probe.hexa
// ════════════════════════════════════════════════════════════════════════

import "core/savant_lib.hexa"

let SING_THR = 0.70   // FROZEN singularity boundary (2σ class, matches ATLAS 🟡 column)

// linspace(a, b, n) → list of n floats inclusive
fn linspace(a: float, b: float, n: int) -> list {
    let mut out = []
    if n <= 1 { out.push(a); return out }
    let step = (b - a) / float(n - 1)
    let mut i = 0
    while i < n {
        out.push(a + step * float(i))
        i = i + 1
    }
    return out
}

// deterministic LCG → uniform [0,1) for the B5 control (no RNG dependency)
fn lcg_next(s: int) -> int {
    // 32-bit LCG (Numerical Recipes constants), masked positive
    let m = (s * 1103515245 + 12345) % 2147483648
    if m < 0 { return m + 2147483648 }
    return m
}

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// One sweep at resolution (nD,nP,nI). Returns dict with B1/B3 measurements +
// B4 overlap + B5 control, all over LIVE sa_* golden-zone semantics.
fn run_sweep(nD: int, nP: int, nI: int, label: string) -> dict {
    let Dg = linspace(0.05, 0.95, nD)
    let Pg = linspace(0.05, 0.95, nP)
    let Ig = linspace(0.05, 0.95, nI)
    let gz_lo = sa_gz_lower()      // LIVE 0.2123… golden-zone lower
    let gz_hi = sa_gz_upper()      // LIVE 0.5    golden-zone upper

    let mut total = 0
    let mut sing  = 0          // singularity count (G > SING_THR)
    let mut abil  = 0          // capacity/ability region: in-GZ ∧ singularity
    let mut abil_outside = 0   // ability points NOT in singularity (subset violation; always 0 by def)

    // B5 control: G span max/min for the random score field
    let gmax = (0.95 * 0.95) / 0.05
    let gmin = (0.05 * 0.05) / 0.95
    let mut rand_sing = 0
    let mut seed = 7

    // per-I singularity rate (for B3 transition + B5 flatness)
    let mut perI_rate = []        // structured rate at each I
    let mut perI_rand = []        // control rate at each I

    let mut ii = 0
    while ii < nI {
        let I = Ig[ii]
        let in_gz = sa_in_golden_zone(I)   // LIVE golden-zone membership
        let mut i_total = 0
        let mut i_sing  = 0
        let mut i_rand  = 0
        let mut di = 0
        while di < nD {
            let D = Dg[di]
            let mut pi = 0
            while pi < nP {
                let P = Pg[pi]
                let G = (D * P) / I
                total = total + 1
                i_total = i_total + 1
                let is_sing = G > SING_THR
                if is_sing {
                    sing = sing + 1
                    i_sing = i_sing + 1
                    if in_gz == 1 { abil = abil + 1 }
                }
                // B5 control: random score in [gmin,gmax]
                seed = lcg_next(seed)
                let u = float(seed) / 2147483648.0
                let grand = gmin + (gmax - gmin) * u
                if grand > SING_THR { rand_sing = rand_sing + 1; i_rand = i_rand + 1 }
                pi = pi + 1
            }
            di = di + 1
        }
        perI_rate.push(float(i_sing) / float(i_total))
        perI_rand.push(float(i_rand) / float(i_total))
        ii = ii + 1
    }

    let ratio = float(sing) / float(total)
    let rand_ratio = float(rand_sing) / float(total)
    let mut overlap = 0.0
    if sing > 0 { overlap = float(abil) / float(sing) }   // P(ability | singularity)

    // B3: 50% transition crossing of perI_rate (rate decreases as I grows)
    let mut cross_I = 0.0 - 1.0
    let mut k = 0
    while k < nI - 1 {
        let y0 = perI_rate[k]
        let y1 = perI_rate[k + 1]
        if y0 >= 0.5 && y1 < 0.5 && cross_I < 0.0 {
            let x0 = Ig[k]
            let x1 = Ig[k + 1]
            cross_I = x0 + (y0 - 0.5) / (y0 - y1) * (x1 - x0)
        }
        k = k + 1
    }

    // B5: flatness of control rate across I (std). structured monotone, control flat.
    let mut rs_sum = 0.0
    let mut t = 0
    while t < nI { rs_sum = rs_sum + perI_rand[t]; t = t + 1 }
    let rs_mean = rs_sum / float(nI)
    let mut rs_ss = 0.0
    let mut t2 = 0
    while t2 < nI {
        let d = perI_rand[t2] - rs_mean
        rs_ss = rs_ss + d * d
        t2 = t2 + 1
    }
    let rand_I_std = sqrt(rs_ss / float(nI))

    println("[" + label + "] n=" + to_string(total)
        + " ratio=" + to_string(ratio)
        + " I50=" + to_string(cross_I)
        + " overlap(P abil|sing)=" + to_string(overlap)
        + " abil_subset_of_sing=true"
        + " rand_ratio=" + to_string(rand_ratio)
        + " rand_I_std=" + to_string(rand_I_std))

    return #{
        "label": label,
        "n": total,
        "ratio": ratio,
        "I50": cross_I,
        "overlap": overlap,
        "rand_ratio": rand_ratio,
        "rand_I_std": rand_I_std,
        "gz_lo": gz_lo,
        "gz_hi": gz_hi,
    }
}

fn main() {
    println("=== H_1560 1/3-LAW × CAPACITY-WALL — ENGINE-NATIVE (LIVE SAVANT/savant_lib.hexa sa_*) ===")
    println("SING_THR=" + to_string(SING_THR) + " gz_lower(LIVE)=" + to_string(sa_gz_lower())
        + " gz_upper(LIVE)=" + to_string(sa_gz_upper()) + " si_thr(LIVE)=" + to_string(sa_si_threshold()))

    // scale ladder ≥3 (a_scale_honest_scope): 8K / ~100K / 1M
    let r8   = run_sweep(20, 20, 20,  "8K")
    let r100 = run_sweep(46, 46, 46,  "100K")
    let r1m  = run_sweep(100, 100, 100, "1M")

    // ── bar evaluation (FROZEN thresholds) ──
    let ratio_1m = r1m["ratio"]
    let b1 = (ratio_1m >= 0.30) && (ratio_1m <= 0.36)         // ≈0.33 ±0.03

    // B2 scale-inv: max pairwise |Δratio| across the 3 rungs < 0.02
    let d1 = abs_f(r8["ratio"]   - r100["ratio"])
    let d2 = abs_f(r100["ratio"] - r1m["ratio"])
    let d3 = abs_f(r8["ratio"]   - r1m["ratio"])
    let mut dmax = d1
    if d2 > dmax { dmax = d2 }
    if d3 > dmax { dmax = d3 }
    let b2 = dmax < 0.02

    // B3 transition: I50 within 0.27 ±0.05 (use 1M rung)
    let i50_1m = r1m["I50"]
    let b3 = (i50_1m >= 0.22) && (i50_1m <= 0.32)

    // B4 capacity-link: ability ⊂ singularity (subset, by construction) AND
    //   overlap P(abil|sing) scale-stable (|Δ| < 0.06) AND overlap ≥ 0.30
    let ov8 = r8["overlap"]; let ov1 = r1m["overlap"]
    let ov_stable = abs_f(ov8 - ov1) < 0.06
    let b4 = ov_stable && (ov1 >= 0.30)

    // B5 control: random ratio ≠ 0.33 (|rand_ratio − 0.33| > 0.10) AND control flat (std < 0.02)
    let rr = r1m["rand_ratio"]
    let b5 = (abs_f(rr - 0.33) > 0.10) && (r1m["rand_I_std"] < 0.02)

    println("")
    println("=== FROZEN 5-BAR VERDICT (engine-native, sa_* live) ===")
    println("B1 ratio        : 1M=" + to_string(ratio_1m) + " (in[0.30,0.36]) -> " + to_string(b1))
    println("B2 scale-inv    : Dmax=" + to_string(dmax) + " (<0.02) -> " + to_string(b2))
    println("B3 transition   : I50(1M)=" + to_string(i50_1m) + " (in[0.22,0.32]) -> " + to_string(b3))
    println("B4 capacity-link: subset=true overlap(1M)=" + to_string(ov1)
        + " Doverlap=" + to_string(abs_f(ov8 - ov1)) + " (>=0.30, stable) -> " + to_string(b4))
    println("B5 control      : rand_ratio=" + to_string(rr) + " rand_I_std=" + to_string(r1m["rand_I_std"])
        + " (!=0.33 & flat) -> " + to_string(b5))
    let all_pass = b1 && b2 && b3 && b4 && b5
    println("")
    println("ALL_PASS=" + to_string(all_pass))
    if all_pass {
        println("VERDICT=GREEN-ENGINE-NATIVE : 1/3 law reproduced on anima substrate golden-zone")
        println("  primitives + capacity-wall expression region SUBSET-OF 1/3 singularity region (same-origin SUPPORT).")
    } else {
        println("VERDICT=AMBER/RED : some bar FAIL (see per-bar) - honest negative (c9).")
    }
}
