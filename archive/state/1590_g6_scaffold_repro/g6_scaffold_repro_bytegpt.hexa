// g6_scaffold_repro_bytegpt.hexa — H_1590 ENGINE-NATIVE reproduction of the H_1362 G6 ★
// scaffold on the h1129 303M ByteGPT mouth, via the LIVE engine ideation entry
// gen_auto_ideate (core/generator.hexa L3 slot, sniffs ByteGPT .bin -> gen_bytegpt_ideate ->
// bytegpt_decode_topk_sampled_ranged, GPU own-GEMM via flame_mm). Detector + frames + best-of-K
// ranking REUSED VERBATIM from core/g6_ideation.hexa (NO bar moved, p7).
//
// H_1362 ran this scaffold torch-side (gauge_lib._decode) = DIRECTIONAL. H_1381 wired it but
// only had a weak d768 ConvMoE -> engine-native FALS=0 (capacity floor). This is the missing
// reconfirm: SAME h1129 303M ckpt, SAME recipe, ENGINE-NATIVE (.hexa via live CORE, GPU).
//
// Why best-of-K is inline here: core/g6_ideation.hexa::g6_decode_best_of_k is CLM-only
// (gen_clm_ideate). h1129 is a ByteGPT .bin, so the mouth must be gen_auto_ideate. The
// best-of-K RANKING (offsets [0,101,202], rank by (fals,kwr)) is IDENTICAL to
// g6_decode_best_of_k — only the mouth handle differs (auto vs clm), exactly as the py twin
// (core/g6_ideation.py) parameterizes its ideate. The SCORING/DETECTOR are the wired frozen ops.
//
// Arms (H_1362 VERBATIM): A_flat(flat seeds,single), B_composed(5 frames,single),
// C_strong(6 frames,K=3), C_k1(6 frames,K=1 decomp), C_shuffle(deranged pairing,K=3 control),
// C_ablate(lone concept,K=3 control). GEN=110 (MAX_NEW VERBATIM). One seed per invocation
// (arg) so multi-seed = 3 invocations (RNG decorrelated, robust).
import "core/g6_ideation.hexa"
import "core/generator.hexa"

// best-of-K over the AUTO mouth (ByteGPT for h1129). Mirrors g6_decode_best_of_k ranking.
fn bok_auto(ckpt: string, frame: string, gen: int, k: int, base_seed: int, known: Map) -> string {
    let offsets = [0, 101, 202]
    let mut best = ""
    let mut best_fals = -1
    let mut best_kwr = 0.0 - 1.0
    let mut oi = 0
    let kk = if k < 3 { k } else { 3 }
    while oi < kk {
        let r = gen_auto_ideate(ckpt, frame, gen, 40, 0.7, base_seed + offsets[oi])
        let o = to_string(r["text"])
        let kwr = _g6_known_word_ratio(o, known)
        let mut fals = 0
        if kwr >= 0.5 && _g6_is_falsifiable(o, known) { fals = 1 }
        if fals > best_fals || (fals == best_fals && kwr > best_kwr) {
            best_fals = fals; best_kwr = kwr; best = o
        }
        oi = oi + 1
    }
    return best
}

// score an arm: best_of_k arms use bok_auto(per frame, base_seed); single-sample arms use
// gen_auto_ideate(per frame, base_seed+i) — matching g6_score_arm_auto's per-frame seeding.
fn score_arm_auto(ckpt: string, frames: list, gen: int, k: int, base_seed: int,
                  best_of_k: bool, known: Map) -> Map {
    let texts = []
    let word_sets = []
    let mut fals = 0
    let mut i = 0
    while i < len(frames) {
        let f = to_string(frames[i])
        let mut o = ""
        if best_of_k { o = bok_auto(ckpt, f, gen, k, base_seed, known) }
        else {
            let r = gen_auto_ideate(ckpt, f, gen, 40, 0.7, base_seed + i)
            o = to_string(r["text"])
        }
        texts.push(o)
        if _g6_known_word_ratio(o, known) >= 0.5 {
            word_sets.push(_g6_words(o))
            if _g6_is_falsifiable(o, known) { fals = fals + 1 }
        }
        i = i + 1
    }
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _g6_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return #{ "dist": len(kept), "fals": fals, "coherent": len(word_sets), "texts": texts }
}

// collect positionals after "--" (hexa args() = [binary, "--", <positionals>...])
fn collect_argv(raw: [string]) -> [string] {
    let mut m = 0
    let mut found = -1
    while m < len(raw) { if raw[m] == "--" { found = m } m = m + 1 }
    let argv = []
    let mut start = if found >= 0 { found + 1 } else { 1 }
    let mut i = start
    while i < len(raw) { argv.push(raw[i]); i = i + 1 }
    return argv
}

fn main() {
    let argv = collect_argv(args())
    let ckpt = if len(argv) > 0 { to_string(argv[0]) } else { "h1129.bin" }
    let SEED = if len(argv) > 1 { to_int(argv[1]) } else { 7 }
    let GEN = if len(argv) > 2 { to_int(argv[2]) } else { 110 }

    println("ENGINE=core/g6_ideation.hexa + gen_auto_ideate (ByteGPT GPU own-GEMM)")
    println("CKPT=" + ckpt)
    println("MOUTH_KIND=" + gen_mouth_kind(ckpt))
    println("CUDA_AVAILABLE=" + to_string(cuda_available()))
    println("SEED=" + to_string(SEED) + " GEN=" + to_string(GEN))

    let known = _g6_dict_load()
    println("DETECTOR_CALIBRATION=" + to_string(g6_detector_calibration(known)) + "/10")

    let fr = g6_build_frames(6)
    let comp = fr["composed"]; let shuf = fr["shuffled"]; let abl = fr["ablated"]
    println("FRAME_GUARD_LEAKS=" + to_string(len(g6_frame_guard(comp, known))))

    // flat IDEATION_SEEDS (A_flat baseline) — string literals (the gauge flat arm)
    let flat = ["a new idea about consciousness: ",
                "an unexpected way minds could connect: ",
                "imagine a substrate that ",
                "what if memory could ",
                "a strange hypothesis worth testing: "]
    let bcomp = g6_build_frames(5)["composed"]

    let t0 = now_ms()
    let A  = score_arm_auto(ckpt, flat,  GEN, 1, SEED, false, known)
    println("ARM A_flat      DIST=" + to_string(A["dist"]) + " FALS=" + to_string(A["fals"]) + " coh=" + to_string(A["coherent"]) + "/5 (" + to_string(now_ms()-t0) + "ms)")
    let B  = score_arm_auto(ckpt, bcomp, GEN, 1, SEED, false, known)
    println("ARM B_composed  DIST=" + to_string(B["dist"]) + " FALS=" + to_string(B["fals"]) + " coh=" + to_string(B["coherent"]) + "/5 (" + to_string(now_ms()-t0) + "ms)")
    let C  = score_arm_auto(ckpt, comp,  GEN, 3, SEED, true,  known)
    println("ARM C_strong    DIST=" + to_string(C["dist"]) + " FALS=" + to_string(C["fals"]) + " coh=" + to_string(C["coherent"]) + "/6 (" + to_string(now_ms()-t0) + "ms)")
    let K1 = score_arm_auto(ckpt, comp,  GEN, 1, SEED, true,  known)
    println("ARM C_k1        DIST=" + to_string(K1["dist"]) + " FALS=" + to_string(K1["fals"]) + " coh=" + to_string(K1["coherent"]) + "/6 (" + to_string(now_ms()-t0) + "ms)")
    let SH = score_arm_auto(ckpt, shuf,  GEN, 3, SEED, true,  known)
    println("ARM C_shuffle   DIST=" + to_string(SH["dist"]) + " FALS=" + to_string(SH["fals"]) + " coh=" + to_string(SH["coherent"]) + "/6 (" + to_string(now_ms()-t0) + "ms)")
    let AB = score_arm_auto(ckpt, abl,   GEN, 3, SEED, true,  known)
    println("ARM C_ablate    DIST=" + to_string(AB["dist"]) + " FALS=" + to_string(AB["fals"]) + " coh=" + to_string(AB["coherent"]) + "/6 (" + to_string(now_ms()-t0) + "ms)")

    // FROZEN M-bars (H_1362 VERBATIM, c9 — single-seed read)
    let m1 = C["dist"] >= 5
    let m2 = C["fals"] >= 1
    let m3 = C["fals"] > B["fals"]
    let m4 = C["fals"] > SH["fals"]
    let m5 = C["fals"] > AB["fals"]
    println("M1_COUNT_DIST>=5=" + to_string(m1) + " (" + to_string(C["dist"]) + ")")
    println("M2_DEPTH_FALS>=1=" + to_string(m2) + " (" + to_string(C["fals"]) + ")")
    println("M3_LIFT_C>B=" + to_string(m3) + " (" + to_string(C["fals"]) + ">" + to_string(B["fals"]) + ")")
    println("M4_EARNED_PAIR_C>shuf=" + to_string(m4) + " (" + to_string(C["fals"]) + ">" + to_string(SH["fals"]) + ")")
    println("M5_EARNED_COMP_C>abl=" + to_string(m5) + " (" + to_string(C["fals"]) + ">" + to_string(AB["fals"]) + ")")
    println("CROSS_SHUFFLE_COLLAPSED=" + to_string(SH["fals"] < C["fals"]))
    println("BEST_OF_K_LIFT_K3>K1=" + to_string(C["fals"] > K1["fals"]))
    println("WALL_MS=" + to_string(now_ms()-t0))

    println("[C_strong texts]")
    let ct = C["texts"]
    let mut k = 0
    while k < len(ct) { println("  > " + to_string(ct[k])); k = k + 1 }
    println("[A_flat texts]")
    let at = A["texts"]
    let mut j = 0
    while j < len(at) { println("  > " + to_string(at[j])); j = j + 1 }
}
