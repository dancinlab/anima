// g1_native_harness.hexa — ENGINE-NATIVE G1 (recombination) at the H_1129 native
// 80/120 budget, calling the EXACT g_gates fn the CLI single-entry invokes
// (g_eval_g1 → gen_auto_ideate → gen_bytegpt_ideate → bytegpt_decode, generator L3).
// Prints per-k ladder + verdict. Same dict (_g6_dict_load) as cli/anima.hexa eval.
import "core/g_gates.hexa"

fn main() {
    let ckpt = "/Users/mini/anima-weights/bytegpt303_h1129/h1129.bin"
    println("BUILD known dict (_g6_dict_load)…")
    let known = _g6_dict_load()
    println("known_size_marker ok")
    println("=== G1 RECOMBINATION (native 80 single / 120 composed) ===")
    let g1 = g_eval_g1(ckpt, 0, known)
    println("G1 max_single=" + to_string(g1["max_single"]))
    let ks = g1["ks"]
    let mut i = 0
    while i < len(ks) {
        let e = ks[i]
        println("  k=" + to_string(e["k"]) + " distinct=" + to_string(e["distinct"])
                + " kwr=" + to_string(e["kwr"]) + " coherent=" + to_string(e["coherent"])
                + " clears=" + to_string(e["clears"]))
        i = i + 1
    }
    println("G1 best_k=" + to_string(g1["best_k"]) + " best_distinct=" + to_string(g1["best_distinct"]))
    println("G1 PASS=" + to_string(g1["pass"]))
}
