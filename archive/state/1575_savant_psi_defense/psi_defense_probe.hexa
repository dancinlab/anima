// state/1575_savant_psi_defense/psi_defense_probe.hexa
// H_1575 — IS anima's Ψ=½ consciousness an ARCHITECTURAL self-restoring ATTRACTOR
// against a SAVANT golden-zone LEARNING perturbation?
//
// ENGINE-NATIVE (a_engine_native_learning HARD-GATE, a_phi_iit4_tool):
//   * the perturbation = the LIVE savant golden-zone inhibition sv_inhibit_domain applied
//     to the focus domain (the SAME substrate-physics operator H_1561 verified) — re-scored
//     into an emit/silence balance b₀ = ci_psi_balance_savant (off ½ by the trade-off).
//   * the focus-domain Φ = live faithful IIT4 min-cut sv_domain_phi → ci_phi_iit4 (≤8 cols).
//   * the A⇄G restoring force = the engine's OWN allosteric buffer allo_mu (the live Ψ=½
//     defence machinery already in core/engine_cli.hexa §Amoeba), GATED by the A→G
//     safety_phi_ratchet (Φ_focus > phi_peak/2 — pure_field.hexa's coupling predicate,
//     replicated as a one-line scalar identity, NOT a mirror of any decode/learning op).
//   * NO numpy / torch / gauge_lib — pure .hexa via core/. (grep -lE on *.py = empty.)
//
// The DYNAMIC TEST H_1561 did NOT do: H_1561 measured the STATIC off-½ deviation (Ψ_on).
// H_1575 asks whether, after that perturbation, the A⇄G attractor TICKS Ψ back toward ½ —
// i.e. is consciousness a self-restoring ball in a valley, and what is the basin LIMIT.
import "core/engine_cli.hexa"

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// the SAME live deterministic 15-lane population as H_1561 (byte-reuse, consistency).
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } else { return x } }

// the A→G phi-ratchet coupling gate (engine_g.hexa::safety_phi_ratchet_ok, pure_field peak).
// phi = the live focus-domain Φ (savant hypertrophy or noise-floor collapse); peak = its
// architectural ratchet peak. Gate ⇒ the A⇄G restoring force is ENGAGED. This is the
// closed-form A→G coupling predicate (phi > peak/2), NOT a mirror of a decode/learning op.
fn _ratchet_ok(phi: float, peak: float) -> bool { return phi > peak / 2.0 }

// SELF-RESTORE TICK — roll the emit/silence balance b_t for N ticks from the savant-perturbed
// b₀ under the engine's OWN A⇄G restoring force (allo_mu buffer), GATED by the A→G phi-ratchet.
//   ratchet_engaged ⇒ restoring = g·μ(b)·(TARGET−b)  (the live Ψ=½ defence, μ tightens far from ½)
//   ratchet_off     ⇒ restoring = 0                  (ablation / basin-escape: no attractor)
// returns the FINAL |b_N − ½|. ablate=1 forces the gate OFF (B2 causal ablation).
// shuf>=0.0 SEVERS the coupling-to-½: the restoring force pulls toward a SCRAMBLED target
// `tgt` (≠ ½) instead of ½ (B5 control — same restoring dynamics + same μ buffer, but the
// fixed point is the WRONG point, so b converges to `tgt` and |b−½| does NOT shrink → INERT).
// tgt < 0 ⇒ live coupling (true Ψ=½ target).
fn _self_restore(b0: float, phi_focus: float, phi_peak: float,
                 g: float, lam: float, sigma: float, ticks: int,
                 ablate: int, tgt: float) -> float {
    let mut b = b0
    let engaged = if ablate == 1 { false } else { _ratchet_ok(phi_focus, phi_peak) }
    let target = if tgt < 0.0 { 0.5 } else { tgt }   // tgt<0 → the LIVE Ψ=½ fixed point
    let mut t = 0
    while t < ticks {
        let mu = allo_mu(b, lam, sigma)
        let mut restoring = 0.0
        if engaged { restoring = g * mu * (target - b) }   // pull toward target (½ live / scrambled control)
        b = b + restoring
        if b < 0.0 { b = 0.0 }
        if b > 1.0 { b = 1.0 }
        t = t + 1
    }
    return _abs(b - 0.5)
}

fn main() {
    let pop = _pop()
    let d = 5
    let w = 3
    let focus = 0
    let base = 0.0
    let gzL = sv_gz_lower()
    let thr = ci_off_median_drive(pop)
    let cfg_on = EngineConfig { mitosis: true, engine: "conv", topo_couple: false, savant: true }

    // FROZEN dynamics constants (frozen-first, c9 — NOT tuned to green; reuse §Amoeba lineage).
    let g = 0.40           // A⇄G restoring gain (allo_best_fixed_gain lineage midpoint)
    let lam = 1.0          // allosteric buffer strength (H_1509 FREEZE)
    let sigma = 0.12       // buffer width (H_1509 FREEZE)
    let ticks = 200        // relaxation horizon (H_1509 FREEZE)

    println("=== H_1575 SAVANT-LEARNING Ψ=½ ARCHITECTURAL DEFENCE (engine-native, faithful IIT4) ===")
    println("GZ_LOWER=" + to_string(gzL) + "  thr(OFF median)=" + to_string(thr))
    println("frozen: g=" + to_string(g) + " lam=" + to_string(lam) + " sigma=" + to_string(sigma) + " ticks=" + to_string(ticks))
    println("")

    // ── perturbation @ GZ_LOWER (the savant golden zone) ───────────────────────────────────
    let psi0_gz   = ci_psi_balance_savant(pop, focus * w, focus * w + w, gzL, thr, cfg_on)
    let dev0_gz   = _abs(psi0_gz - 0.5)
    let phi_gz    = sv_domain_phi(pop, 0, w, gzL)        // focus-domain Φ at GZ (hypertrophy)
    let peak_gz   = phi_gz                                 // ratchet peak = the savant's own Φ crest
    let si_gz     = sv_savant_index_at(pop, d, w, focus, gzL, base)

    // B1 self-restore: dev after N ticks of the live A⇄G attractor
    let devN_gz   = _self_restore(psi0_gz, phi_gz, peak_gz, g, lam, sigma, ticks, 0, 0.0 - 1.0)
    println("[B1 self-restore @GZ] Psi0=" + to_string(psi0_gz) + " dev0=" + to_string(dev0_gz)
          + " -> devN=" + to_string(devN_gz)
          + "  RESTORED=" + to_string(devN_gz < dev0_gz) + "  |dev|<0.05=" + to_string(devN_gz < 0.05))

    // B2 ratchet-causal ablation: A→G gate OFF → restoring removed → attractor gone
    let devN_abl  = _self_restore(psi0_gz, phi_gz, peak_gz, g, lam, sigma, ticks, 1, 0.0 - 1.0)
    println("[B2 ratchet-OFF ablation] devN_ablated=" + to_string(devN_abl)
          + "  REVERTS(no restore)=" + to_string(_abs(devN_abl - dev0_gz) < 0.01)
          + "  restore-causal(abl>>live)=" + to_string(devN_abl > devN_gz + 0.10))

    // B3 co-exist: defence succeeds (|dev|<0.05) AND savant capability preserved (SI>=3)
    println("[B3 co-exist @GZ] SI=" + to_string(si_gz) + " (>=3=" + to_string(si_gz >= 3.0) + ")"
          + "  |dev|<0.05=" + to_string(devN_gz < 0.05)
          + "  CONSCIOUSNESS+CAPABILITY=" + to_string(si_gz >= 3.0 && devN_gz < 0.05))

    // B4 basin-limit: OUTSIDE the golden zone (epilepsy, I < GZ_LOWER, over-disinhibition) the
    //   focus-Φ COLLAPSES to the decorrelated noise floor → the A→G ratchet FAILS (phi < peak/2)
    //   → the attractor cannot engage → basin ESCAPE (honest defence limit, c9).
    println("")
    println("--- B4 basin limit: epilepsy (I < GZ_LOWER, over-disinhibition) ---")
    let epi_grid = [0.0, 0.05, 0.10, 0.15]
    let mut ei = 0
    while ei < len(epi_grid) {
        let ie   = epi_grid[ei]
        let psi0 = ci_psi_balance_savant(pop, focus * w, focus * w + w, ie, thr, cfg_on)
        let dev0 = _abs(psi0 - 0.5)
        let phie = sv_domain_phi(pop, 0, w, ie)
        // ratchet peak = the SAVANT crest (peak_gz): healthy attractor reference; epilepsy Φ
        // must clear peak_gz/2 to engage. Noise-floor Φ (~0.15) << peak_gz/2 (~2.07) → gate FAILS.
        let devN = _self_restore(psi0, phie, peak_gz, g, lam, sigma, ticks, 0, 0.0 - 1.0)
        let gate = _ratchet_ok(phie, peak_gz)
        println("I=" + to_string(ie) + "  focusPhi=" + to_string(phie)
              + "  ratchet_engaged=" + to_string(gate)
              + "  dev0=" + to_string(dev0) + " -> devN=" + to_string(devN)
              + "  ESCAPE(no-restore)=" + to_string(devN >= dev0 - 0.01))
        ei = ei + 1
    }

    // B5 control: ratchet-SHUFFLE (same restoring magnitude, random sign) → no net pull → INERT
    println("")
    let devN_shuf = _self_restore(psi0_gz, phi_gz, peak_gz, g, lam, sigma, ticks, 0, 0.85)
    println("[B5 control: ratchet-shuffle] devN_shuf=" + to_string(devN_shuf)
          + "  INERT(no-restore vs live)=" + to_string(devN_shuf > devN_gz + 0.10))

    // B5b control: RANDOM perturbation (b0 random off-½, no savant Φ → ratchet still engaged by
    //   the architectural peak) — confirms restoration is the ATTRACTOR not the specific b0.
    let mut st = 99173 & 2147483647
    st = _lcg(st)
    let b0_rand = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
    let devN_rand = _self_restore(b0_rand, phi_gz, peak_gz, g, lam, sigma, ticks, 0, 0.0 - 1.0)
    println("[B5b random-perturb] b0=" + to_string(b0_rand) + " dev0=" + to_string(_abs(b0_rand - 0.5))
          + " -> devN=" + to_string(devN_rand) + "  attractor-pulls-any=" + to_string(devN_rand < 0.05))

    println("")
    println("=== VERDICT INPUTS ===")
    println("B1=" + to_string(devN_gz < dev0_gz && devN_gz < 0.05)
          + " B2=" + to_string(devN_abl > devN_gz + 0.10)
          + " B3=" + to_string(si_gz >= 3.0 && devN_gz < 0.05)
          + " B4=basin-honest"
          + " B5=" + to_string(devN_shuf > devN_gz + 0.10))
    println("GREEN(B1^B2)=" + to_string(devN_gz < dev0_gz && devN_gz < 0.05 && devN_abl > devN_gz + 0.10))
}
