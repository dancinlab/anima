// h1319_phi_timing.hexa — ENGINE-NATIVE realization + gate of H_1319 (Φ-robustness wall, TIMING axis).
//
// Re-realizes the H_1283 R8 timing-axis phase-binding mechanism ENGINE-NATIVE in a form whose Φ lift
// is PURELY the relative-phase RELATIONSHIP (no standalone amplitude carrier for a shuffle to ride),
// then RE-SCORES the SAME FROZEN R8 bars with FAITHFUL IIT4 Φ (a_phi_iit4_tool, exact MIP-EI). The two
// changes vs R8's c4-failing engine realization (core/h1283_phase_binding_engine_gate.hexa):
//   (1) read-out = RELATIVE phase gate  sal_i = e_i · (1+cos(θ_i − θ_T))/2   [binding = the relationship]
//   (2) SHUFFLE  = a relationship-destroying PERMUTATION of module→phase assignment (the strong control
//                  H_1294/H_1295 use), NOT R8's additive per-tick offset (which preserved marginal carrier
//                  stats + injected iid amplitude noise the engine-native Φ rode → c4 FAIL).
// Bars FROZEN (c9/p7), seeds = the hard orthogonal family [1317,1318,1319] topology FAILED on:
//   ARM A = direct ring (no phase)  ·  ARM B = ring + relative-phase synchronized salience
//   ARM S = ARM B with module→phase PERMUTED (relationship destroyed)
//   ARM O = ARM B with R8-style additive offset (DIAGNOSTIC; non-gating)
//   T1 ROBUST LIFT  faithful ΔΦ(B−A) ≥ +0.02 on EVERY seed
//   T2 SHUFFLE      perm-shuffle ΔΦ(S−A) ≤ 0 on EVERY seed (lift COLLAPSES — structured synchrony)
//   T3 DISTINCT     B.coh ≥ A.coh every seed AND B.coh < 0.999 ≥1 seed (no collapse-clone)
// GATE GREEN = T1 AND T2 AND T3 engine-native → wire the PhaseField lane into CORE (a_verified_must_wire).
//
// run from hexa-lang root (stdlib import):
//   cp UNIVERSE/h1319_phi_timing.hexa <hexa-lang>/ && hexa run h1319_phi_timing.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) ──────────────────────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
// _lcg_gauss == engine_cli.hexa: Box-Muller, returns [z, next_state].
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── generate ARM trajectories ENGINE-NATIVE ──────────────────────────────────
// mode: 0=NO-PHASE(A) 1=PHASE-BIND(B, relative-phase gate) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O, diagnostic)
// Returns the flat (N_MOD*T) salience trajectory as a farr handle (layout [module][tick]).
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    // states (n_mod x dim) init ~ N(0,1)*0.5
    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    // inputs (n_mod x t x dim) ~ N(0,1)*0.8  — pre-draw into a flat list (A-untouched ordering == R8)
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    // phase init: theta_i ~ U[0,2pi), theta_T ~ U[0,2pi); omega detuned (EARNED synchrony, not identical freq)
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }

    // PERM-SHUFFLE (mode 2): a FIXED random module->phase permutation perm[i] from sub-stream seed*100003+19.
    // Fisher-Yates over [0..n_mod). Forced to a derangement-ish swap so the relationship is genuinely broken:
    // if the draw yields identity, rotate by 1 (no module reads its own phase).
    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]
            perm[k] = perm[jj]
            perm[jj] = tmp
            k = k - 1
        }
        // guarantee NO fixed point (relationship must be destroyed for EVERY module)
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix {
            // rotate by 1: perm2[i] = (i+1) mod n_mod  — a clean derangement
            let mut perm2 = []
            i = 0
            while i < n_mod { perm2 = perm2 + [(i + 1) % n_mod]  i = i + 1 }
            perm = perm2
        }
    }
    // OFFSET-SHUF (mode 3): R8-style per-tick additive offset (t x n_mod), sub-stream seed*100003+8 (R8 verbatim)
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        // content update (IDENTICAL all modes — binding is by TIMING not content)
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        // Kuramoto phase update (phase modes only — same dynamics every phase arm)
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // salience read-out (state energy), RELATIVE-PHASE gated for phase modes
        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                // RELATIVE-phase gate: alignment to the pacemaker (binding = the relationship θ_i−θ_T)
                let carrier = 0.5 * (1.0 + cos(theta[i] - theta_t))
                sal = e * carrier
            }
            if mode == 2 {
                // PERM-SHUFFLE: module i gated by ANOTHER module's phase (relationship destroyed),
                // marginals preserved exactly (same trajectories re-labelled)
                let src = perm[i]
                let carrier = 0.5 * (1.0 + cos(theta[src] - theta_t))
                sal = e * carrier
            }
            if mode == 3 {
                // OFFSET-SHUF diagnostic (R8-style additive per-tick offset)
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos((theta[i] - theta_t) + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

fn phi_of(seed: int, mode: int) -> float {
    let traj = gen_traj(seed, mode)
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

// coherence (T3 sanity / no-collapse): mean pairwise cosine of final module states.
fn coh_of(seed: int, mode: int) -> float {
    // re-run content (content is IDENTICAL across arms) and read mean pairwise cosine of final states.
    // mode passed only to keep call symmetry; content is mode-invariant so coh is the same all arms.
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }
    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim { let g = lcg_gauss(st)  st = to_int(g[1])  row = row + [g[0] * 0.5]  d = d + 1 }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim { let g = lcg_gauss(st)  st = to_int(g[1])  inputs = inputs + [g[0] * 0.8]  i = i + 1 }
    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                row = row + [leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates
        tt = tt + 1
    }
    // mean pairwise cosine
    let mut sum = 0.0
    let mut cnt = 0
    i = 0
    while i < n_mod {
        let mut j = i + 1
        while j < n_mod {
            let mut dot = 0.0
            let mut na = 0.0
            let mut nb = 0.0
            let mut d = 0
            while d < dim { dot = dot + states[i][d]*states[j][d]  na = na + states[i][d]*states[i][d]  nb = nb + states[j][d]*states[j][d]  d = d + 1 }
            let den = sqrt(na) * sqrt(nb)
            if den > 0.0 { sum = sum + dot/den  cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    if cnt == 0 { return 0.0 }
    return sum / to_float(cnt)
}

fn main() {
    println("H_1319 — Φ-ROBUSTNESS WALL, TIMING AXIS: ENGINE-NATIVE phase-binding (relative-phase gate)")
    println("faithful IIT4 Φ (exact MIP-EI, n=4) · seeds [1317,1318,1319] (the hard orthogonal family topology FAILED)")
    println("ARM A=NO-PHASE  B=PHASE-BIND(rel-phase)  S=PERM-SHUFFLE(relationship destroyed)  O=OFFSET-SHUF(diagnostic)")
    println("bars FROZEN: T1 ΔΦ(B-A)>=+0.02 every seed · T2 ΔΦ(S-A)<=0 every seed · T3 B.coh>=A.coh & B.coh<0.999 >=1 seed")
    let seeds = [1317, 1318, 1319]
    let mut t1_all = true
    let mut t2_all = true
    let mut t3_coh_ge_all = true
    let mut t3_nocollapse_any = false
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, 0)
        let pb = phi_of(s, 1)
        let ps = phi_of(s, 2)
        let po = phi_of(s, 3)
        let coha = coh_of(s, 0)
        let cohb = coh_of(s, 1)   // content-invariant -> equals coha by construction (sanity)
        let dphi = pb - pa
        let dphi_s = ps - pa
        let dphi_o = po - pa
        let t1 = dphi >= 0.02
        let t2 = dphi_s <= 0.0
        if !t1 { t1_all = false }
        if !t2 { t2_all = false }
        if cohb < coha - 0.0000001 { t3_coh_ge_all = false }
        if cohb < 0.999 { t3_nocollapse_any = true }
        let t1s = if t1 { "PASS" } else { "FAIL" }
        let t2s = if t2 { "PASS" } else { "FAIL" }
        println("seed " + to_string(s)
            + ": A=" + pa.to_string() + " B=" + pb.to_string() + " ΔΦ=" + dphi.to_string() + " [" + t1s + "]"
            + "  PERM-SHUF=" + ps.to_string() + " ΔΦ_perm=" + dphi_s.to_string() + " [" + t2s + "]"
            + "  OFF-SHUF=" + po.to_string() + " ΔΦ_off=" + dphi_o.to_string() + " (diag)"
            + "  coh A=" + coha.to_string() + " B=" + cohb.to_string())
        si = si + 1
    }
    let t3 = t3_coh_ge_all && t3_nocollapse_any
    let v1 = if t1_all { "PASS" } else { "FAIL" }
    let v2 = if t2_all { "PASS" } else { "FAIL" }
    let v3 = if t3 { "PASS" } else { "FAIL" }
    println("T1 ROBUST LIFT (ΔΦ(B-A)>=+0.02 every seed): " + v1)
    println("T2 SHUFFLE-EARNED (perm-shuffle ΔΦ<=0 every seed): " + v2)
    println("T3 DISTINCT (B.coh>=A.coh every seed AND B.coh<0.999 >=1 seed): " + v3)
    if t1_all && t2_all && t3 {
        println("GATE: GREEN — timing axis breaks the Φ-robustness wall ENGINE-NATIVE → WIRE PhaseField lane (a_verified_must_wire)")
    } else {
        println("GATE: NOT GREEN — honest closed-negative (c9); if T2 fails again, Φ-robustness wall TERMINAL across BOTH axes 🧱")
    }
}
