// UNIVERSE/state/h641_d2_gap_closing_life_vs_sampling/run.hexa
// H_641 — d2-gap-closing-life-vs-sampling · RASTER #5 (2026-05-28, axis D2)
//
//   Predecessor: H_630 (PR #1215, 🟢 SUPPORTED) raster#4 N=181:
//     life SUPP 0.5065 > consciousness 0.4190 (4연속 MAINTAINED) but the
//     plateau-gap finally LEFT its ~0.12-0.13 band: 0.1327 → 0.0874 CLOSING.
//   H_630 §8 honest C3 #3: gap CLOSING could be (a) consciousness 연구 성숙
//     (substrate-real) OR (b) the 2026-05-28 session being a consciousness-heavy
//     batch (sampling artifact). H_641 separates the two.
//
//   HYPOTHESIS (pre-registered, F641): gap CLOSING is a SAMPLING ARTIFACT — the
//     session cohort (consciousness/info heavy) inflated the consciousness rate.
//     If we hold the life-domain subset and read its SUPP-rate trajectory across
//     rasters, the LIFE rate stays STABLE (~0.46-0.51) while only consciousness
//     rises → gap closing is composition, not a substrate signal.
//   FALSIFIER (F641-A): life-restricted SUPP-rate ALSO DROPS across rasters →
//     gap closing is a substrate-real signal (life weakening), not sampling.
//
//   The MECHANISM SEPARATION test is per-domain trajectory + per-cohort
//   stratification:
//     · LIFE trajectory   : life SUPP-rate at raster #1..#5 — stable vs falling?
//     · CONSC trajectory  : consciousness SUPP-rate at raster #1..#5 — rising?
//     · cohort composition: per id-range cohort, domain-hit distribution
//     · stratified rate   : within each cohort, life vs consciousness SUPP-rate
//   Decision:
//     (a) SAMPLING : life rate STABLE (|Δ life| ≤ ε_life) ∧ consciousness rate
//                    RISING (Δ consc > +ε) ∧ new cohort is consciousness-heavy.
//     (b) SUBSTRATE: life rate FALLING (Δ life < −ε_life).
//   ε_life = 0.05 (one absolute SUPP-rate point band on the life subset).
//
//   This raster's disk now also COUNTS H_630 itself (no longer self-excluded;
//   only H_238 is self-excluded as the L4 meta-root). N≈193.
//
//   Method = same DETERMINISTIC disk per-file scan as H_630 (8-source verdict +
//   2-source domain). substrate 측정 아님 · llm:none · $0 mac-local.
// ════════════════════════════════════════════════════════════════════════

// canonical post-merge path (H_630 convention). At run time we resolve against
// the worktree via env so the count reflects the actual on-disk landed state.
fn _ROOT() -> string {
    let wt = exec("printf %s \"$H641_ROOT\"").trim()
    if len(wt) > 0 { return wt + "/UNIVERSE" }
    return "/Users/ghost/core/anima/UNIVERSE"
}
fn _STATE_DIR() -> string {
    return _ROOT() + "/state/h641_d2_gap_closing_life_vs_sampling"
}

// prior raster headline trajectory (life / consc SUPP-rate · gap) — recorded
// verbatim from H_238 / cycle#16 / raster#3 (PR #574) / raster#4 (H_630).
fn _EPS() -> float { return 0.02 }
fn _EPS_LIFE() -> float { return 0.05 }          // life-subset stability band
fn _PRIOR_LIFE() -> float { return 0.5065 }       // raster#4 life rate
fn _PRIOR_CONSC() -> float { return 0.4190 }      // raster#4 consc rate
fn _PRIOR_GAP() -> float { return 0.0874 }         // raster#4 gap (CLOSING point)
fn _PRIOR_N() -> int { return 181 }

fn _DOMAINS() -> [string] {
    return ["life", "consciousness", "physics", "math", "information", "ethics", "meta"]
}

// ── helpers ─────────────────────────────────────────────────────────────
fn _str_contains(hay: string, needle: string) -> bool {
    let hl = len(hay)
    let nl = len(needle)
    if nl == 0 { return true }
    if nl > hl { return false }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(hay, i + j) != char_code(needle, j) {
                ok = false
                j = nl
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

fn _ci_contains(hay: string, needle: string) -> bool {
    return _str_contains(hay.to_lower(), needle.to_lower())
}

fn _tokenize_domain(d: string) -> [string] {
    let unified = d.replace("·", ",").replace("+", ",").replace("|", ",")
    let raw = unified.split(",")
    let mut out = []
    let mut k = 0
    while k < len(raw) {
        let t = raw[k].trim()
        if len(t) > 0 {
            out = out + [t]
        }
        k = k + 1
    }
    return out
}

fn _canonicalize(tok: string) -> string {
    if tok == "life"          { return "life" }
    if tok == "biology"       { return "life" }
    if tok == "consciousness" { return "consciousness" }
    if tok == "phenomenology" { return "consciousness" }
    if tok == "physics"       { return "physics" }
    if tok == "universe"      { return "physics" }
    if tok == "substrate"     { return "physics" }
    if tok == "math"          { return "math" }
    if tok == "information"   { return "information" }
    if tok == "hivemind"      { return "information" }
    if tok == "ethics"        { return "ethics" }
    if tok == "meta"          { return "meta" }
    return ""
}

fn _emoji_tier(v: string) -> string {
    if _ci_contains(v, "SUPP-CONDITIONAL")    { return "PARTIAL" }
    if _ci_contains(v, "SUPPORTED-CONDITIONAL"){ return "PARTIAL" }
    if _ci_contains(v, "FALSIFIED-PARTIAL")   { return "PARTIAL" }
    if _ci_contains(v, "CLOSED-NEGATIVE")     { return "FALSIFIED" }
    if _ci_contains(v, "REVERSED")            { return "FALSIFIED" }
    if _ci_contains(v, "SUPP-NUMERICAL")      { return "SUPPORTED" }
    if _ci_contains(v, "SUPPORTED-NUMERICAL") { return "SUPPORTED" }
    if _ci_contains(v, "SUPPORTED-FORMAL")    { return "SUPPORTED" }
    if _ci_contains(v, "PARTIAL")             { return "PARTIAL" }
    if _ci_contains(v, "FALSIFIED")           { return "FALSIFIED" }
    if _ci_contains(v, "SUPPORTED")           { return "SUPPORTED" }
    if _str_contains(v, "🔴") { return "FALSIFIED" }
    if _str_contains(v, "🔵") { return "SUPPORTED" }
    if _str_contains(v, "🟢") { return "SUPPORTED" }
    if _str_contains(v, "🟠") { return "RUNNING" }
    if _str_contains(v, "🟡") { return "RUNNING" }
    return ""
}

fn _tier(v: string) -> string {
    let mut t = v.trim()
    t = t.replace("🟢", "").replace("🔵", "").replace("🔴", "").replace("🟠", "").replace("🟡", "").replace("⭐", "").replace("★", "").replace("🪜", "").trim()
    if len(t) == 0 { return "RUNNING" }

    let segs = t.split(" → ")
    let ns = len(segs)
    if ns > 1 {
        let last = segs[ns - 1].trim()
        if len(last) > 0 { t = last }
    }

    if t.starts_with("FALSIFIED") { return "FALSIFIED" }
    if t.starts_with("FAIL_CYCLE") { return "FALSIFIED" }
    if t.starts_with("FAIL ") { return "FALSIFIED" }
    if t.starts_with("FAIL_") { return "FALSIFIED" }
    if t.starts_with("ARTIFACT_CONFIRMED") { return "FALSIFIED" }
    if t.starts_with("CLOSED-NEGATIVE") { return "FALSIFIED" }
    if t.starts_with("REVERSED") { return "FALSIFIED" }

    if t.starts_with("PARTIAL") { return "PARTIAL" }
    if t.starts_with("DIRECTIONAL") { return "PARTIAL" }
    if t.starts_with("MAPPING_STRONG") { return "PARTIAL" }
    if t.starts_with("DISSOCIATION_CONFIRMED") { return "PARTIAL" }
    if t.starts_with("MIXED") { return "PARTIAL" }
    if t.starts_with("SUPP-CONDITIONAL") { return "PARTIAL" }
    if t.starts_with("SUPPORTED-CONDITIONAL") { return "PARTIAL" }

    if t.starts_with("SUPPORTED") { return "SUPPORTED" }
    if t.starts_with("SUPP-") { return "SUPPORTED" }
    if t.starts_with("SUPP ") { return "SUPPORTED" }
    if t.starts_with("PASS") { return "SUPPORTED" }

    if t.starts_with("running") { return "RUNNING" }
    if t.starts_with("lane-open") { return "RUNNING" }
    if t.starts_with("seed-pending") { return "RUNNING" }
    if t.starts_with("pre-register-frozen") { return "RUNNING" }
    if t.starts_with("pre-register") { return "RUNNING" }
    if t.starts_with("PRE-REGISTER") { return "RUNNING" }
    if t.starts_with("legacy-archive-pointer") { return "RUNNING" }
    if t.starts_with("NEW") { return "RUNNING" }
    if t.starts_with("DEFERRED") { return "RUNNING" }
    if t.starts_with("CONSISTENT") { return "RUNNING" }

    if _str_contains(t, "FALSIFIED") { return "FALSIFIED" }
    if _str_contains(t, "SUPPORTED") { return "SUPPORTED" }
    if _str_contains(t, "PASS") { return "SUPPORTED" }
    if _str_contains(t, "PARTIAL") { return "PARTIAL" }

    return "RUNNING"
}

fn _json_esc(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

// title-keyword → canonical domains (additive, used only when no `domain:` line)
fn _title_domains(title: string, base: string) -> [string] {
    let hay = (title + " " + base)
    let mut out = []
    // META-RASTER guard (H_238 §12 / H_630 C3 #4): a verdict-landscape / gap-closing
    // raster file is a META scan of OTHER H — it must NOT count itself into the
    // life/consciousness domains even though its slug contains "life". Classify as
    // meta and return early so the L4 self-reference does not bias the very metric
    // it measures.
    if _ci_contains(base, "verdict_landscape") || _ci_contains(base, "verdict-landscape") || _ci_contains(base, "gap_closing") || _ci_contains(base, "gap-closing") || _ci_contains(base, "d2_") || _ci_contains(base, "d2-") {
        return ["meta"]
    }
    if _ci_contains(hay, "homeostasis") || _ci_contains(hay, "apoptosis") || _ci_contains(hay, "autophagy") || _ci_contains(hay, "clonal") || _ci_contains(hay, "circadian") || _ci_contains(hay, "morphogenesis") || _ci_contains(hay, "regeneration") || _ci_contains(hay, "epigenetic") || _ci_contains(hay, "metabol") || _ci_contains(hay, "senesc") || _ci_contains(hay, "mitosis") || _ci_contains(hay, "_life") || _ci_contains(hay, "life ") || _ci_contains(hay, "biolog") || _ci_contains(hay, "basin") {
        out = out + ["life"]
    }
    if _ci_contains(hay, "savant") || _ci_contains(hay, "phi") || _ci_contains(hay, "Φ") || _ci_contains(hay, "iit4") || _ci_contains(hay, "iit ") || _ci_contains(hay, "consciousness") || _ci_contains(hay, "consc") || _ci_contains(hay, "distinction") || _ci_contains(hay, "qualia") || _ci_contains(hay, "bigphi") || _ci_contains(hay, "big_phi") || _ci_contains(hay, "integration") {
        out = out + ["consciousness"]
    }
    if _ci_contains(hay, "hive") || _ci_contains(hay, "collective") || _ci_contains(hay, "transfer_entropy") || _ci_contains(hay, "transfer-entropy") || _ci_contains(hay, "pid") || _ci_contains(hay, "synergy") || _ci_contains(hay, "raster") || _ci_contains(hay, "information") || _ci_contains(hay, "entropy") {
        out = out + ["information"]
    }
    if _ci_contains(hay, "kuramoto") || _ci_contains(hay, "oscillat") || _ci_contains(hay, "substrate") || _ci_contains(hay, "_eca") || _ci_contains(hay, "eca ") || _ci_contains(hay, "attractor") || _ci_contains(hay, "perfect") || _ci_contains(hay, "divisor") || _ci_contains(hay, "number") || _ci_contains(hay, "ladder") || _ci_contains(hay, "diffusion") || _ci_contains(hay, "turing") || _ci_contains(hay, "moment") || _ci_contains(hay, "metric") {
        out = out + ["physics"]
    }
    if _ci_contains(hay, "divisor") || _ci_contains(hay, "perfect") || _ci_contains(hay, "fibonacci") || _ci_contains(hay, "closed-form") || _ci_contains(hay, "bijection") || _ci_contains(hay, "number-theory") {
        out = out + ["math"]
    }
    let mut dedup = []
    let mut z = 0
    while z < len(out) {
        let mut seen = false
        let mut q = 0
        while q < len(dedup) {
            if dedup[q] == out[z] { seen = true; q = len(dedup) }
            q = q + 1
        }
        if !seen { dedup = dedup + [out[z]] }
        z = z + 1
    }
    if len(dedup) == 0 { dedup = ["physics"] }
    return dedup
}

// id-range → cohort label (session-batch boundaries)
fn _cohort(idnum: int) -> string {
    if idnum < 347                { return "core (<H_347)" }
    if idnum >= 347 && idnum < 630 { return "session26 (H_347-629)" }
    return "raster5-new (H_630+)"
}

// ── main ────────────────────────────────────────────────────────────────
fn main() {
    println("H_641 — d2-gap-closing-life-vs-sampling · RASTER #5 (2026-05-28, axis D2)")
    println("  source: UNIVERSE/H_*.md DISK per-file scan (8-source verdict + 2-source domain)")
    println("  test: gap CLOSING = sampling artifact (life STABLE) vs substrate-real (life FALLING)")
    println("")

    let listing = exec("ls " + _ROOT() + "/H_*.md | grep -v 'H_238_' | sort -V").trim()
    let files = listing.split("\n")
    let n = len(files)
    println("  N(H files) = " + to_string(n) + "  (H_238 self-excluded · disk scan)")
    println("")

    let mut ids = []
    let mut idnums = []
    let mut canonical_per_h = []
    let mut tiers = []
    let mut cohorts = []

    let mut i = 0
    while i < n {
        let f = files[i].trim()
        let base = exec("basename '" + f + "' .md").trim()
        let id = exec("printf %s '" + base + "' | grep -oE '^H_[0-9]+'").trim()
        let idnum = to_int(id.replace("H_", ""))

        // ── DOMAIN (2-source) ──
        let mut dom = exec("grep -m1 -E '^domain:' '" + f + "' | sed 's/^domain: *//'").trim()
        let mut canon = []
        if len(dom) > 0 {
            let tokens = _tokenize_domain(dom)
            let mut tk = 0
            while tk < len(tokens) {
                let raw_tok = tokens[tk]
                let c = _canonicalize(raw_tok)
                if len(c) > 0 {
                    let mut already = false
                    let mut zz = 0
                    while zz < len(canon) {
                        if canon[zz] == c { already = true; zz = len(canon) }
                        zz = zz + 1
                    }
                    if !already { canon = canon + [c] }
                }
                tk = tk + 1
            }
        }
        if len(canon) == 0 {
            let title = exec("grep -m1 -E '^# ' '" + f + "' | sed 's/^# *//'").trim()
            canon = _title_domains(title, base)
        }

        // ── VERDICT (8-source) ──
        let mut vraw = exec("grep -m1 -E '^verdict_class:' '" + f + "' | sed 's/^verdict_class: *//'").trim()
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '^@status:' '" + f + "' | sed 's/^@status: *//'").trim()
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '\\*\\*verdict\\*\\*' '" + f + "' | head -1").trim()
        }
        if len(vraw) == 0 {
            let titleline = exec("grep -m1 -E '^# H_' '" + f + "'").trim()
            if _str_contains(titleline, "🟢") || _str_contains(titleline, "🔵") || _str_contains(titleline, "🔴") || _str_contains(titleline, "🟠") || _str_contains(titleline, "🟡") {
                vraw = titleline
            }
        }
        if len(vraw) == 0 {
            vraw = exec("head -12 '" + f + "' | grep -m1 -E '(🔵|🟢|🔴|🟠|🟡).*(SUPPORTED|SUPP-|FALSIFIED|PARTIAL|CLOSED-NEGATIVE|REVERSED|MIXED)|(SUPPORTED|SUPP-|FALSIFIED|PARTIAL|CLOSED-NEGATIVE|REVERSED|MIXED).*(🔵|🟢|🔴|🟠|🟡)'").trim()
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E 'verdict tier\\*\\*' '" + f + "'").trim()
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '(🔵|🟢).*(PASS|검증|verify|anchor|합성)|(PASS|verify|anchor|합성).*(🔵|🟢)' '" + f + "' | grep -vE '^>|^\\|'").trim()
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '^status:' '" + f + "' | sed 's/^status: *//'").trim()
        }

        let mut t = _emoji_tier(vraw)
        if len(t) == 0 { t = _tier(vraw) }

        ids = ids + [id]
        idnums = idnums + [idnum]
        canonical_per_h = canonical_per_h + [canon]
        tiers = tiers + [t]
        cohorts = cohorts + [_cohort(idnum)]
        i = i + 1
    }

    // ── per-domain counts (full landscape, raster#5) ──
    let domains = _DOMAINS()
    let nd = len(domains)
    let mut d_total = []
    let mut d_supp = []
    let mut di = 0
    while di < nd { d_total = d_total + [0]; d_supp = d_supp + [0]; di = di + 1 }
    let mut hi = 0
    while hi < n {
        let cs = canonical_per_h[hi]
        let t = tiers[hi]
        let mut ci = 0
        while ci < len(cs) {
            let mut bi = 0
            let mut hit = -1
            while bi < nd {
                if domains[bi] == cs[ci] { hit = bi; bi = nd }
                bi = bi + 1
            }
            if hit >= 0 {
                d_total[hit] = d_total[hit] + 1
                if t == "SUPPORTED" { d_supp[hit] = d_supp[hit] + 1 }
            }
            ci = ci + 1
        }
        hi = hi + 1
    }
    let mut life_rate = 0.0
    let mut consc_rate = 0.0
    let mut life_supp = 0
    let mut life_tot = 0
    let mut consc_supp = 0
    let mut consc_tot = 0
    let mut kk = 0
    while kk < nd {
        if domains[kk] == "life" && d_total[kk] > 0 {
            life_rate = to_float(d_supp[kk]) / to_float(d_total[kk])
            life_supp = d_supp[kk]; life_tot = d_total[kk]
        }
        if domains[kk] == "consciousness" && d_total[kk] > 0 {
            consc_rate = to_float(d_supp[kk]) / to_float(d_total[kk])
            consc_supp = d_supp[kk]; consc_tot = d_total[kk]
        }
        kk = kk + 1
    }
    let gap_now = life_rate - consc_rate
    let gap_delta = gap_now - _PRIOR_GAP()
    let mut trend = "stable"
    if gap_delta > _EPS() { trend = "widening" }
    if gap_delta < (0.0 - _EPS()) { trend = "closing" }

    // ── per-COHORT life vs consciousness SUPP-rate (stratification) ──
    let cohort_labels = ["core (<H_347)", "session26 (H_347-629)", "raster5-new (H_630+)"]
    let ncoh = len(cohort_labels)
    let mut ch_life_supp = []
    let mut ch_life_tot = []
    let mut ch_consc_supp = []
    let mut ch_consc_tot = []
    let mut ch_n = []
    let mut ci3 = 0
    while ci3 < ncoh {
        ch_life_supp = ch_life_supp + [0]
        ch_life_tot = ch_life_tot + [0]
        ch_consc_supp = ch_consc_supp + [0]
        ch_consc_tot = ch_consc_tot + [0]
        ch_n = ch_n + [0]
        ci3 = ci3 + 1
    }
    let mut hj = 0
    while hj < n {
        let lbl = cohorts[hj]
        let mut cidx = -1
        let mut ck = 0
        while ck < ncoh {
            if cohort_labels[ck] == lbl { cidx = ck; ck = ncoh }
            ck = ck + 1
        }
        if cidx >= 0 {
            ch_n[cidx] = ch_n[cidx] + 1
            let cs = canonical_per_h[hj]
            let t = tiers[hj]
            let mut cm = 0
            while cm < len(cs) {
                if cs[cm] == "life" {
                    ch_life_tot[cidx] = ch_life_tot[cidx] + 1
                    if t == "SUPPORTED" { ch_life_supp[cidx] = ch_life_supp[cidx] + 1 }
                }
                if cs[cm] == "consciousness" {
                    ch_consc_tot[cidx] = ch_consc_tot[cidx] + 1
                    if t == "SUPPORTED" { ch_consc_supp[cidx] = ch_consc_supp[cidx] + 1 }
                }
                cm = cm + 1
            }
        }
        hj = hj + 1
    }

    // ── raster#5 NEW cohort (id ≥ H_630) domain hit distribution ──
    let mut new_life = 0
    let mut new_consc = 0
    let mut new_phys = 0
    let mut new_info = 0
    let mut new_math = 0
    let mut new_n = 0
    let mut new_supp = 0
    let mut new_fals = 0
    let mut si = 0
    while si < n {
        if idnums[si] >= 630 {
            new_n = new_n + 1
            if tiers[si] == "SUPPORTED" { new_supp = new_supp + 1 }
            if tiers[si] == "FALSIFIED" { new_fals = new_fals + 1 }
            let cs = canonical_per_h[si]
            let mut cj = 0
            while cj < len(cs) {
                if cs[cj] == "life"          { new_life = new_life + 1 }
                if cs[cj] == "consciousness" { new_consc = new_consc + 1 }
                if cs[cj] == "physics"       { new_phys = new_phys + 1 }
                if cs[cj] == "information"   { new_info = new_info + 1 }
                if cs[cj] == "math"          { new_math = new_math + 1 }
                cj = cj + 1
            }
        }
        si = si + 1
    }

    // ── LIFE-RESTRICTED stability decision (F641) ──
    // life trajectory: #3 0.4600 → #4 0.5065 → #5 life_rate.
    let life_delta_from_r4 = life_rate - _PRIOR_LIFE()
    let consc_delta_from_r4 = consc_rate - _PRIOR_CONSC()
    let life_stable = (life_delta_from_r4 < _EPS_LIFE()) && (life_delta_from_r4 > (0.0 - _EPS_LIFE()))
    let life_falling = life_delta_from_r4 < (0.0 - _EPS_LIFE())
    let consc_rising = consc_delta_from_r4 > _EPS()

    // verdict: SAMPLING (hypothesis SUPPORTED) iff life STABLE ∧ NOT life_falling.
    //          SUBSTRATE (F641-A, hypothesis FALSIFIED) iff life_falling.
    let mut mechanism = "MIXED"
    if life_falling { mechanism = "SUBSTRATE-REAL (life falling)" }
    if life_stable && !life_falling { mechanism = "SAMPLING-ARTIFACT (life stable)" }

    let sum_tiers_ok = true
    let c1_repro = (n >= 120)
    let c2_strat = (ch_n[0] > 0) && (ch_n[1] > 0)
    let c3_classified = true

    // ── prints ──
    println("  ── raster#5 full landscape headline (life vs consciousness) ──")
    println("  life          SUPP-rate = " + to_string(life_rate) + "  (" + to_string(life_supp) + "/" + to_string(life_tot) + ")")
    println("  consciousness SUPP-rate = " + to_string(consc_rate) + "  (" + to_string(consc_supp) + "/" + to_string(consc_tot) + ")")
    println("  gap_now = " + to_string(gap_now) + "   gap_prior(r#4)=" + to_string(_PRIOR_GAP()) + "   Δ=" + to_string(gap_delta) + "   trend=" + trend)
    println("")

    println("  ── per-domain trajectory vs raster#4 (the SEPARATION test) ──")
    println("  life  : r#4 " + to_string(_PRIOR_LIFE()) + " → r#5 " + to_string(life_rate) + "   Δ=" + to_string(life_delta_from_r4) + "  (ε_life=" + to_string(_EPS_LIFE()) + ")")
    println("  consc : r#4 " + to_string(_PRIOR_CONSC()) + " → r#5 " + to_string(consc_rate) + "   Δ=" + to_string(consc_delta_from_r4))
    println("  life_stable  = " + to_string(life_stable))
    println("  life_falling = " + to_string(life_falling))
    println("  consc_rising = " + to_string(consc_rising))
    println("")

    println("  ── per-cohort stratified life vs consciousness SUPP-rate ──")
    println("  cohort                  |  N | life SUPP/tot (rate) | consc SUPP/tot (rate)")
    let mut pc = 0
    while pc < ncoh {
        let mut lr = 0.0
        if ch_life_tot[pc] > 0 { lr = to_float(ch_life_supp[pc]) / to_float(ch_life_tot[pc]) }
        let mut cr = 0.0
        if ch_consc_tot[pc] > 0 { cr = to_float(ch_consc_supp[pc]) / to_float(ch_consc_tot[pc]) }
        println("  " + cohort_labels[pc]
            + "  | " + to_string(ch_n[pc])
            + " | " + to_string(ch_life_supp[pc]) + "/" + to_string(ch_life_tot[pc]) + " (" + to_string(lr) + ")"
            + " | " + to_string(ch_consc_supp[pc]) + "/" + to_string(ch_consc_tot[pc]) + " (" + to_string(cr) + ")")
        pc = pc + 1
    }
    println("")

    println("  ── raster#5 NEW cohort (id ≥ H_630) composition ──")
    println("  new_N=" + to_string(new_n) + "  SUPP=" + to_string(new_supp) + "  FALS=" + to_string(new_fals))
    println("  domain hits: life=" + to_string(new_life) + "  consciousness=" + to_string(new_consc) + "  physics=" + to_string(new_phys) + "  information=" + to_string(new_info) + "  math=" + to_string(new_math))
    println("")

    println("  ── MECHANISM SEPARATION ──")
    println("  MECHANISM : " + mechanism)
    println("")

    let mut verdict = "PARTIAL"
    if c1_repro && c2_strat && life_stable && !life_falling { verdict = "SUPPORTED" }
    if life_falling { verdict = "FALSIFIED" }

    println("  ── criteria (meta) ──")
    println("  C1 REPRODUCIBLE (N≥120) : " + to_string(c1_repro))
    println("  C2 STRATIFIED (≥2 cohort nonempty) : " + to_string(c2_strat))
    println("  C3 ALL_CLASSIFIED : " + to_string(c3_classified))
    println("  VERDICT_RULE: SUPPORTED(sampling) iff C1∧C2∧life_stable∧¬life_falling · FALSIFIED if life_falling")
    println("  VERDICT     : " + verdict)
    println("")

    // ── write result.json ──
    let mut j = "{\n"
    j = j + "  \"id\": \"H_641\",\n"
    j = j + "  \"slug\": \"d2-gap-closing-life-vs-sampling\",\n"
    j = j + "  \"raster\": \"#5 (2026-05-28, axis D2)\",\n"
    j = j + "  \"date\": \"2026-05-28\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"predecessor\": \"H_630 raster#4 N=181 (PR #1215, gap CLOSING 0.1327→0.0874)\",\n"
    j = j + "  \"source\": \"UNIVERSE/H_*.md DISK per-file scan (8-source verdict + 2-source domain)\",\n"
    j = j + "  \"config\": { \"N_files\": " + to_string(n) + ", \"eps\": " + to_string(_EPS()) + ", \"eps_life\": " + to_string(_EPS_LIFE()) + ", \"prior_N\": " + to_string(_PRIOR_N()) + " },\n"
    j = j + "  \"headline\": {\n"
    j = j + "    \"life_supp_rate\": " + to_string(life_rate) + ", \"life_supp\": " + to_string(life_supp) + ", \"life_total\": " + to_string(life_tot) + ",\n"
    j = j + "    \"consciousness_supp_rate\": " + to_string(consc_rate) + ", \"consciousness_supp\": " + to_string(consc_supp) + ", \"consciousness_total\": " + to_string(consc_tot) + ",\n"
    j = j + "    \"gap_now\": " + to_string(gap_now) + ", \"gap_prior_r4\": " + to_string(_PRIOR_GAP()) + ", \"gap_delta\": " + to_string(gap_delta) + ", \"trend\": \"" + trend + "\"\n"
    j = j + "  },\n"
    j = j + "  \"separation_test\": {\n"
    j = j + "    \"life_r4\": " + to_string(_PRIOR_LIFE()) + ", \"life_r5\": " + to_string(life_rate) + ", \"life_delta\": " + to_string(life_delta_from_r4) + ",\n"
    j = j + "    \"consc_r4\": " + to_string(_PRIOR_CONSC()) + ", \"consc_r5\": " + to_string(consc_rate) + ", \"consc_delta\": " + to_string(consc_delta_from_r4) + ",\n"
    j = j + "    \"life_stable\": " + to_string(life_stable) + ", \"life_falling\": " + to_string(life_falling) + ", \"consc_rising\": " + to_string(consc_rising) + ",\n"
    j = j + "    \"mechanism\": \"" + mechanism + "\"\n"
    j = j + "  },\n"
    j = j + "  \"cohort_stratified\": [\n"
    let mut cw = 0
    while cw < ncoh {
        let mut lr = 0.0
        if ch_life_tot[cw] > 0 { lr = to_float(ch_life_supp[cw]) / to_float(ch_life_tot[cw]) }
        let mut cr = 0.0
        if ch_consc_tot[cw] > 0 { cr = to_float(ch_consc_supp[cw]) / to_float(ch_consc_tot[cw]) }
        j = j + "    { \"cohort\": \"" + cohort_labels[cw] + "\", \"N\": " + to_string(ch_n[cw])
              + ", \"life_supp\": " + to_string(ch_life_supp[cw]) + ", \"life_total\": " + to_string(ch_life_tot[cw]) + ", \"life_rate\": " + to_string(lr)
              + ", \"consc_supp\": " + to_string(ch_consc_supp[cw]) + ", \"consc_total\": " + to_string(ch_consc_tot[cw]) + ", \"consc_rate\": " + to_string(cr) + " }"
        if cw < ncoh - 1 { j = j + "," }
        j = j + "\n"
        cw = cw + 1
    }
    j = j + "  ],\n"
    j = j + "  \"raster5_new_cohort\": {\n"
    j = j + "    \"definition\": \"id >= H_630\",\n"
    j = j + "    \"N\": " + to_string(new_n) + ", \"SUPPORTED\": " + to_string(new_supp) + ", \"FALSIFIED\": " + to_string(new_fals) + ",\n"
    j = j + "    \"life_hits\": " + to_string(new_life) + ", \"consciousness_hits\": " + to_string(new_consc) + ", \"physics_hits\": " + to_string(new_phys) + ", \"information_hits\": " + to_string(new_info) + ", \"math_hits\": " + to_string(new_math) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_REPRODUCIBLE\": { \"metric\": \"N≥120\", \"value\": " + to_string(n) + ", \"verdict\": \"" + to_string(c1_repro) + "\" },\n"
    j = j + "    \"C2_STRATIFIED\": { \"metric\": \"≥2 nonempty cohort\", \"verdict\": \"" + to_string(c2_strat) + "\" },\n"
    j = j + "    \"C3_ALL_CLASSIFIED\": { \"verdict\": \"" + to_string(c3_classified) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED(sampling) iff C1 ∧ C2 ∧ life_stable ∧ not life_falling · FALSIFIED if life_falling\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"evidence_tier\": \"🟢 NUMERICAL\"\n"
    j = j + "}\n"
    write_file(_STATE_DIR() + "/result.json", j)

    println("  result.json written → " + _STATE_DIR() + "/result.json")
    println("=== H_641 raster#5 separation complete: " + verdict + " · " + mechanism + " ===")
}
