// shard_polarity.hexa — H_650 AXIS 1 (POLARITY, H_628 재현) — light shard.
//   2-ECA joint n=4, rule_a=rb=30, sys=10, W=0.3.
//   perturbation = polarity {attract,repel,bipolar}; 3 × 13-grid big_phi single-shot.
//   SHAPE = argmax_I|dΦ/dI|, SCALAR = Φ(I=0.05). writes axis_polarity.json.
import "/private/tmp/u-h650b/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}
fn _mean(xs: array) -> float {
    let n = len(xs); let mut t = 0.0; let mut i = 0
    while i < n { t = t + xs[i]; i = i + 1 }
    return t / to_float(n)
}
fn _std(xs: array) -> float {
    let n = len(xs); let mu = _mean(xs); let mut t = 0.0; let mut i = 0
    while i < n { let d = xs[i] - mu; t = t + d * d; i = i + 1 }
    return _sqrt(t / to_float(n))
}
fn _cv(xs: array) -> float {
    let mu = _mean(xs); let am = _abs(mu)
    if am < 1.0e-12 { return 0.0 }
    return _std(xs) / am
}
fn peak_I_of(grid: array, phi: array) -> float {
    let m = len(grid); let mut peak_idx = 0; let mut peak_mag = 0.0 - 1.0; let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 { d = (phi[1]-phi[0])/(grid[1]-grid[0]) }
        else if k == m-1 { d = (phi[m-1]-phi[m-2])/(grid[m-1]-grid[m-2]) }
        else { d = (phi[k+1]-phi[k-1])/(grid[k+1]-grid[k-1]) }
        let ad = _abs(d)
        if ad > peak_mag { peak_mag = ad; peak_idx = k }
        k = k + 1
    }
    return grid[peak_idx]
}
fn bit_of(s: int, b: int) -> int { return iit4_bit(s, b) }
fn eca_next2(rule: int, st: int, i: int) -> int {
    let l = bit_of(st, (i-1+2)%2); let c = bit_of(st, i); let r = bit_of(st, (i+1)%2)
    return bit_of(rule, 4*l + 2*c + r)
}
fn couple_next(a_prime: int, b_prime: int, polarity: string, w: float, i: int) -> int {
    let mut eff = polarity
    if polarity == "bipolar" { if i == 1 { eff = "repel" } else { eff = "attract" } }
    if eff == "attract" {
        if w >= 0.8 { return b_prime }
        if w >= 0.3 { if a_prime == 1 { return 1 } return b_prime }
        return a_prime
    }
    if eff == "repel" {
        if w >= 0.8 { return 1 - b_prime }
        if w >= 0.3 { if a_prime == b_prime { return 0 } return 1 }
        return a_prime
    }
    return a_prime
}
fn build_joint(rule_a: int, rule_b: int, polarity: string, w: float, I: float) -> array {
    let suppress = 1.0 - I; let mut t = []; let mut s = 0
    while s < 16 {
        let sa = s % 4; let sb = (s / 4) % 4; let mut j = 0
        while j < 2 {
            let ap = eca_next2(rule_a, sa, j); let bp = eca_next2(rule_b, sb, j)
            t = t.push(to_float(couple_next(ap, bp, polarity, w, j)) * suppress); j = j + 1
        }
        let mut k = 0
        while k < 2 {
            let ap = eca_next2(rule_a, sa, k); let bp = eca_next2(rule_b, sb, k)
            t = t.push(to_float(couple_next(bp, ap, polarity, w, k)) * suppress); k = k + 1
        }
        s = s + 1
    }
    return t
}
fn joint_phi(polarity: string, I: float) -> float {
    let res = big_phi(build_joint(30, 30, polarity, 0.3, I), 4, 10)
    return res[0]
}
fn json_arr_f(xs: array) -> string {
    let mut s = "["; let mut i = 0; let n = len(xs)
    while i < n { if i > 0 { s = s + ", " } s = s + str(xs[i]); i = i + 1 }
    return s + "]"
}
fn main() {
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40, 0.50, 0.70, 0.95]
    let mg = len(grid)
    let polarities = ["attract", "repel", "bipolar"]
    let mut peaks = []; let mut scalars = []; let mut pp = 0
    while pp < 3 {
        let polr = polarities[pp]; let mut phi = []; let mut gi = 0
        while gi < mg { phi = phi.push(joint_phi(polr, grid[gi])); gi = gi + 1 }
        peaks = peaks.push(peak_I_of(grid, phi)); scalars = scalars.push(phi[0])
        println("  polarity=" + polr + " peak_I=" + str(peaks[pp]) + " Φ(0.05)=" + str(scalars[pp]))
        pp = pp + 1
    }
    let cvs = _cv(peaks); let cvc = _cv(scalars)
    // byte-equal
    let d = _abs(joint_phi("attract", 0.05) - joint_phi("attract", 0.05))
    let beq = d <= 1.0e-12
    println("CV_shape=" + str(cvs) + " CV_scalar=" + str(cvc) + " byte_eq=" + str(beq))
    let mut o = "{\n"
    o = o + "  \"axis\": \"polarity\",\n"
    o = o + "  \"peak_I\": " + json_arr_f(peaks) + ",\n"
    o = o + "  \"scalar\": " + json_arr_f(scalars) + ",\n"
    o = o + "  \"cv_shape\": " + str(cvs) + ",\n"
    o = o + "  \"cv_scalar\": " + str(cvc) + ",\n"
    o = o + "  \"byte_eq\": " + str(beq) + "\n"
    o = o + "}\n"
    write_file("UNIVERSE/state/h650_shape_robustness_axis_taxonomy_2026_05_28/axis_polarity.json", o)
    println("wrote axis_polarity.json")
}
