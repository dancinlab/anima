// UNIVERSE/state/h611_hivemind_te_align_2026_05_28/run_h611.hexa
//
//   H_611 — hivemind-transfer-entropy-align (axis F1 round 2 · H_356 fresh slug)
//
//   QUESTION (sister: H_290 single-substrate r=0.883)
//     Hivemind = 2 substrates A and B, coupled with weight W. Does collective
//     big-Φ ∥ cross-substrate transfer entropy (TE_A→B + TE_B→A) ?
//     H_290 anchored single-substrate ECA Φ ∥ inter-cell TE (r=0.883). The
//     present H asks the multi-substrate extension: is the SAME alignment
//     preserved when TE is measured across substrate boundaries instead of
//     between cells inside one substrate?
//
//   SEED-HYPOTHESIS H1
//     Pearson r(Φ_collective, TE_cross) > 0.5 across (rule_pair × W) panel.
//     Falsifier: r < 0.5 OR negative correlation.
//
//   METHOD (reuse HEXAD/IIT4/lib/iit4_eca — g61; no new IIT4 code)
//     • SUBSTRATE: 2 substrates × n=2 cells each → COMBINED 4-cell ring.
//       cells 0,1 = substrate A under rule_A; cells 2,3 = substrate B under
//       rule_B. Combined state s ∈ {0..15} maps to next-bit per cell.
//     • COUPLING W ∈ {0.0, 0.3, 0.6, 1.0}:
//       - For each cell i, own_next = ECA next-bit using intra-substrate ring
//         (cells 0,1 ring within A; cells 2,3 ring within B).
//       - cross_next = ECA next-bit using cross-substrate neighbor as the
//         "right" neighbor (A cells see B cell at same relative index; vice
//         versa). This wires the two substrates so W>0 ⇒ information FLOWS
//         across the boundary.
//       - blend = (1-W) * own_next + W * cross_next, threshold > 0.5 → 1.
//       - W=0 ⇒ pure intra-substrate (no cross flow); W=1 ⇒ pure cross flow.
//     • Φ_collective = mean over all 16 combined states of big_phi[0] (n=4).
//     • TE_cross = Σ_{j∈A} Σ_{i∈B} TE(i→j)  +  Σ_{j∈B} Σ_{i∈A} TE(i→j)
//       (lag-1 bivariate Schreiber, uniform 16-state ensemble — IDENTICAL
//       TE definition as H_290, but restricted to A↔B cell pairs).
//     • PANEL: rule_pairs × W. rule pool = {30, 90, 110, 150, 60, 105} (rich
//       ECA dynamics, same family as H_287..H_290 panel; integrating rules).
//       6 pairs × 4 W = 24 samples ≫ 10.
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-28, BEFORE measuring)
//     F611.1 W=0 ANCHOR — at W=0 (decoupled substrates), TE_cross ≈ 0
//            (no cross flow). collective-Φ may be > 0 (each substrate
//            integrates internally) but the cross-substrate TE channel is
//            empty.
//     F611.2 r-VERDICT — Pearson r(Φ_collective, TE_cross) across 24 cells.
//            H1 SUPPORTED iff r > 0.5. r + Spearman ρ verbatim.
//     F611.3 FLOW-WITNESS — at W=1 (fully coupled), at least one rule_pair
//            has TE_cross > 0 (cross flow exists when fully coupled).
//     F611.4 BOUND — Φ_collective ≥ 0 AND TE_cross ≥ 0 for all cells.
//     F611.5 DETERMINISM — re-running first cell yields byte-identical
//            (Φ_collective, TE_cross).
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU · foreground
//   honest scope (C3 carry from H_290 L1+L2 plus hivemind-specific):
//     • bivariate TE blind spot: multivariate cross-substrate synergy not
//       captured (same XOR-synergy gap as H_290 L1). multivariate TE could
//       differ.
//     • small-n IIT4: n_combined=4 toy ring; faithful big-Φ tractable.
//     • W via blend threshold = deterministic toy, not stochastic coupling.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/u-h611/HEXAD/IIT4/lib/iit4_eca.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }
fn nsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// ── hivemind combined TPM builder ────────────────────────────────────────
// 2 substrates × 2 cells each; cell indices 0,1 = A; 2,3 = B.
// rule_A applied within A (ring of 2 cells: cell 0's neighbours are cell 1 (left)
//    and cell 1 (right) — degenerate ring; Wolfram idx = 4*L+2*C+R).
// cross neighbour: A cell i's cross partner is B cell (2 + i); B cell j's cross
//    partner is A cell (j - 2).
// own_next = bit_(rule_A)[4*L_intra + 2*C + R_intra]
// cross_next = bit_(rule_A)[4*L_intra + 2*C + R_cross]
// blend = (1-W)*own + W*cross; next-bit = 1 if blend > 0.5 else 0 (ties → 0).
fn rule_bit(rule: int, idx: int) -> int {
    let mut r = rule
    let mut k = 0
    while k < idx { r = r / 2; k = k + 1 }
    return r % 2
}

fn hivemind_tpm(rule_a: int, rule_b: int, w: float) -> array {
    let n = 4
    let mut t = []
    let mut s = 0
    while s < 16 {
        let b0 = iit4_bit(s, 0)
        let b1 = iit4_bit(s, 1)
        let b2 = iit4_bit(s, 2)
        let b3 = iit4_bit(s, 3)
        // For each cell, own-substrate ring (size 2): neighbours = the other
        // cell in that substrate (both L and R wrap to it).
        // own_idx for cell c with self=C, partner=P, cross=X:
        //   intra ring of size 2 → L = P, R = P → idx = 4*P + 2*C + P = 5*P + 2*C
        // cross-replace R with the cross-substrate counterpart at same position:
        //   cross_idx = 4*P + 2*C + X   (cross-substrate partner replaces R)
        let mut i = 0
        while i < n {
            let mut c_self = b0
            let mut c_partner = b1
            let mut c_cross = b2
            let mut rule = rule_a
            if i == 0 { c_self = b0; c_partner = b1; c_cross = b2; rule = rule_a }
            if i == 1 { c_self = b1; c_partner = b0; c_cross = b3; rule = rule_a }
            if i == 2 { c_self = b2; c_partner = b3; c_cross = b0; rule = rule_b }
            if i == 3 { c_self = b3; c_partner = b2; c_cross = b1; rule = rule_b }
            let own_idx = 4 * c_partner + 2 * c_self + c_partner
            let cross_idx = 4 * c_partner + 2 * c_self + c_cross
            let own_next = to_float(rule_bit(rule, own_idx))
            let cross_next = to_float(rule_bit(rule, cross_idx))
            let blend = (1.0 - w) * own_next + w * cross_next
            let mut nb = 0.0
            if blend > 0.5 { nb = 1.0 }
            t = t.push(nb)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── TE(j→i) over uniform 16-state ensemble, lag-1 bivariate (identical to H_290) ──
fn te_j_to_i(tpm: array, n: int, i: int, j: int) -> float {
    let full = iit4_pow2(n)
    let mut c = [0,0,0,0,0,0,0,0]
    let mut s = 0
    while s < full {
        let ic = iit4_bit(s, i)
        let jc = iit4_bit(s, j)
        let mut ip = 0
        if tpm[s * n + i] > 0.5 { ip = 1 }
        let idx = 4 * ip + 2 * ic + jc
        c[idx] = c[idx] + 1
        s = s + 1
    }
    let tot = to_float(full)
    let mut te = 0.0
    let mut ip = 0
    while ip < 2 {
        let mut ic = 0
        while ic < 2 {
            let mut jc = 0
            while jc < 2 {
                let n_ipicjc = to_float(c[4*ip + 2*ic + jc])
                if n_ipicjc > 0.5 {
                    let p_joint = n_ipicjc / tot
                    let n_icjc = to_float(c[0 + 2*ic + jc] + c[4 + 2*ic + jc])
                    let p_ip_given_icjc = n_ipicjc / n_icjc
                    let n_ipic = to_float(c[4*ip + 2*ic + 0] + c[4*ip + 2*ic + 1])
                    let n_ic = to_float(c[0+2*ic+0]+c[0+2*ic+1]+c[4+2*ic+0]+c[4+2*ic+1])
                    let p_ip_given_ic = n_ipic / n_ic
                    if (p_ip_given_icjc > 0.0) && (p_ip_given_ic > 0.0) {
                        te = te + p_joint * log2(p_ip_given_icjc / p_ip_given_ic)
                    }
                }
                jc = jc + 1
            }
            ic = ic + 1
        }
        ip = ip + 1
    }
    return te
}

// cross-substrate TE = Σ_{j in A} Σ_{i in B} TE(i->j) + symmetric.
// A = {0,1}, B = {2,3}.
fn te_cross(tpm: array) -> float {
    let n = 4
    let mut acc = 0.0
    // A → B (source in A, target in B)
    let mut j = 2
    while j < 4 {
        let mut i = 0
        while i < 2 {
            acc = acc + te_j_to_i(tpm, n, j, i)   // TE measured at target j from source i
            i = i + 1
        }
        j = j + 1
    }
    // B → A (source in B, target in A)
    let mut j2 = 0
    while j2 < 2 {
        let mut i2 = 2
        while i2 < 4 {
            acc = acc + te_j_to_i(tpm, n, j2, i2)
            i2 = i2 + 1
        }
        j2 = j2 + 1
    }
    return acc
}

fn phi_collective(tpm: array) -> float {
    let n = 4
    let full = iit4_pow2(n)
    let mut acc = 0.0
    let mut st = 0
    while st < full { acc = acc + big_phi(tpm, n, st)[0]; st = st + 1 }
    return acc / to_float(full)
}

fn pearson(xs: array, ys: array, m: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < m { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(m)
    let my = sy / to_float(m)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    i = 0
    while i < m {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        i = i + 1
    }
    if (vx < 0.000000000001) || (vy < 0.000000000001) { return 0.0 }
    return cov / nsqrt(vx * vy)
}
fn rank_of(xs: array, m: int, idx: int) -> float {
    let mut less = 0.0
    let mut eq = 0.0
    let mut i = 0
    while i < m {
        if xs[i] < xs[idx] - 0.000000001 { less = less + 1.0 }
        if approx(xs[i], xs[idx]) { eq = eq + 1.0 }
        i = i + 1
    }
    return less + (eq - 1.0) / 2.0
}
fn spearman(xs: array, ys: array, m: int) -> float {
    let mut rx = []
    let mut ry = []
    let mut i = 0
    while i < m { rx = rx.push(rank_of(xs, m, i)); ry = ry.push(rank_of(ys, m, i)); i = i + 1 }
    return pearson(rx, ry, m)
}

fn main() {
    println("================================================================")
    println("  H_611 — hivemind-transfer-entropy-align (axis F1 round 2)")
    println("  Φ_collective vs TE_cross over 2-substrate × n=2 hivemind")
    println("  (sister H_290 single-substrate r=0.883)")
    println("================================================================")

    let rule_pairs_a = [30, 90, 110, 150, 60, 105]
    let rule_pairs_b = [30, 90, 110, 150, 60, 105]
    let ws = [0.0, 0.3, 0.6, 1.0]
    let nr = 6
    let nw = 4

    let mut phis = []
    let mut tes = []
    let mut labels_w = []
    let mut labels_r = []

    // 4 rule pairs across-rule (homogeneous and one heterogeneous to span dynamics)
    // To keep N=24, we sweep all 6 homogeneous rule_pairs (A=B) × 4 W.
    let mut ridx = 0
    while ridx < nr {
        let r_a = rule_pairs_a[ridx]
        let r_b = rule_pairs_b[ridx]
        let mut widx = 0
        while widx < nw {
            let w = ws[widx]
            let tpm = hivemind_tpm(r_a, r_b, w)
            let phi = phi_collective(tpm)
            let te = te_cross(tpm)
            phis = phis.push(phi)
            tes = tes.push(te)
            labels_r = labels_r.push(r_a)
            labels_w = labels_w.push(w)
            println("  rule_pair=(" + str(r_a) + "," + str(r_b) + ") W=" + str(w) + "  Phi_coll=" + str(phi) + "  TE_cross=" + str(te))
            widx = widx + 1
        }
        ridx = ridx + 1
    }

    let m = nr * nw
    let r = pearson(phis, tes, m)
    let rho = spearman(phis, tes, m)
    println("  --")
    println("  F611.2: N=" + str(m) + " Pearson r(Phi_coll, TE_cross)=" + str(r) + "  Spearman rho=" + str(rho))
    let h1_supported = r > 0.5
    if h1_supported { println("          => H1 SUPPORTED (r>0.5): collective-Phi tracks cross-substrate TE") }
    else { println("          => H1 FALSIFIED (r<=0.5): collective-Phi does NOT track cross-substrate TE") }

    // ── F611.1 W=0 ANCHOR (cross-TE = 0 at W=0) ──────────────────────────
    // indices for W=0 are widx==0 → positions 0, 4, 8, 12, 16, 20.
    let mut w0_te_ok = true
    let mut k = 0
    while k < nr {
        let pos = k * nw + 0   // widx=0
        if !approx(tes[pos], 0.0) { w0_te_ok = false }
        k = k + 1
    }
    check("F611.1 W=0 ANCHOR: TE_cross = 0 across all rule_pairs at W=0", w0_te_ok)

    // ── F611.3 FLOW-WITNESS at W=1 ───────────────────────────────────────
    let mut flow_witness = false
    let mut q = 0
    while q < nr {
        let pos = q * nw + 3   // widx=3 → W=1.0
        if tes[pos] > 0.000001 { flow_witness = true }
        q = q + 1
    }
    check("F611.3 FLOW-WITNESS: at W=1, at least one rule_pair has TE_cross > 0", flow_witness)

    // ── F611.4 BOUND ─────────────────────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < m {
        if !(phis[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(tes[b] >= 0.0 - 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F611.4 BOUND: Phi_coll>=0 AND TE_cross>=0 for all 24 samples", bound_ok)

    // ── F611.5 DETERMINISM ───────────────────────────────────────────────
    let tpm_re = hivemind_tpm(30, 30, 0.6)
    let phi_re = phi_collective(tpm_re)
    let te_re = te_cross(tpm_re)
    // first cell with rule_pair=(30,30), W=0.6 is position 2.
    check("F611.5 DETERMINISM: re-run (rule=30, W=0.6) byte-identical", approx(phis[2], phi_re) && approx(tes[2], te_re))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL  (N=" + str(m) + ")")
    println("  ANCHOR H_290 single-substrate r=0.883; H_611 hivemind r=" + str(r))
    if h1_supported {
        println("  VERDICT: H1 SUPPORTED — hivemind collective-Phi tracks cross-substrate TE.")
        println("           Inter-substrate TE alignment generalizes the H_290 single-substrate pattern.")
    } else {
        println("  VERDICT: H1 FALSIFIED — hivemind collective-Phi does NOT track cross-substrate TE (r<=0.5).")
        println("           Single-substrate Phi-TE alignment does NOT extend across substrate boundaries.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_611 had FALSIFIER FAILURES (distinct from H1 verdict)") }
}
