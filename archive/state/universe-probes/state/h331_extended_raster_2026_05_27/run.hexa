// H_331 — D2 extended raster (17 cells H_312..H_330, excluding 2 rejected)
// Tabulates verdict tiers + kernel class for the full session.
// Each (cell_id, kernel_class) declared post-hoc from the cell's method (timestep
// loop = DYNAMICAL · static Phi-arithmetic = STRUCTURAL · structural-with-dynamical-
// gate = HYBRID · observation-of-prior-cells = META). verdict_tier comes from each
// cell's already-merged result.json (independent of the class label).
//
// H1: dyn_supp_rate ≥ 2× struct_supp_rate (H_326 finding holds after 9 more cells).
// Falsifier: ratio < 2 (H_326 5× claim degrades to under 2 after extension).

fn tally(cells_tier: int, cells_class: int, n_cells: int,
         target_class: int, count_supp: int, count_total: int) -> int {
    // returns supp_count packed: result handled by caller
    return 0
}

fn main() {
    println("H_331 extended raster — 17 cells H_312..H_330")
    // class encoding: 0=STRUCTURAL  1=DYNAMICAL  2=HYBRID  3=META
    // tier  encoding: 0=🔴  1=🟢-conditional  2=🟢  3=🟡 (unused here)
    let cells = farr_zeros(34)   // 17 cells × 2 (class, tier) interleaved
    // (cell_id, class, tier)
    // H_312 apoptosis     STRUCT  🔴
    let _ = farr_set(cells,  0, 0.0); let _ = farr_set(cells,  1, 0.0)
    // H_313 STDP          DYN     🟢
    let _ = farr_set(cells,  2, 1.0); let _ = farr_set(cells,  3, 2.0)
    // H_314 sym-merge     STRUCT  🔴
    let _ = farr_set(cells,  4, 0.0); let _ = farr_set(cells,  5, 0.0)
    // H_315 prune-edge    STRUCT  🔴
    let _ = farr_set(cells,  6, 0.0); let _ = farr_set(cells,  7, 0.0)
    // H_316 greedy        META    🟢
    let _ = farr_set(cells,  8, 3.0); let _ = farr_set(cells,  9, 2.0)
    // H_317 feedback      DYN     🟢
    let _ = farr_set(cells, 10, 1.0); let _ = farr_set(cells, 11, 2.0)
    // H_318 autophagy     HYBRID  🟢-cond
    let _ = farr_set(cells, 12, 2.0); let _ = farr_set(cells, 13, 1.0)
    // H_319 clonal        HYBRID  🔴
    let _ = farr_set(cells, 14, 2.0); let _ = farr_set(cells, 15, 0.0)
    // H_320 phi-struct    STRUCT  🔴
    let _ = farr_set(cells, 16, 0.0); let _ = farr_set(cells, 17, 0.0)
    // H_321 H_278-recheck STRUCT  🟢
    let _ = farr_set(cells, 18, 0.0); let _ = farr_set(cells, 19, 2.0)
    // H_322 Kuramoto      DYN     🟢
    let _ = farr_set(cells, 20, 1.0); let _ = farr_set(cells, 21, 2.0)
    // H_325 Gini          STRUCT  🟢-cond
    let _ = farr_set(cells, 22, 0.0); let _ = farr_set(cells, 23, 1.0)
    // H_326 prior-raster  META    🟢
    let _ = farr_set(cells, 24, 3.0); let _ = farr_set(cells, 25, 2.0)
    // H_327 regeneration  DYN     🔴
    let _ = farr_set(cells, 26, 1.0); let _ = farr_set(cells, 27, 0.0)
    // H_328 cycle-len     DYN     🟢-cond
    let _ = farr_set(cells, 28, 1.0); let _ = farr_set(cells, 29, 1.0)
    // H_329 metric-tri    DYN     🔴
    let _ = farr_set(cells, 30, 1.0); let _ = farr_set(cells, 31, 0.0)
    // H_330 moments       DYN     🔴
    let _ = farr_set(cells, 32, 1.0); let _ = farr_set(cells, 33, 0.0)

    // count: class → (supp_strict, supp_cond, total)
    // strict supp = tier==2 ; cond supp = tier in {1,2}
    let struct_supp_strict = farr_zeros(1)
    let struct_supp_cond   = farr_zeros(1)
    let struct_total       = farr_zeros(1)
    let dyn_supp_strict    = farr_zeros(1)
    let dyn_supp_cond      = farr_zeros(1)
    let dyn_total          = farr_zeros(1)
    let hybrid_total       = farr_zeros(1)
    let hybrid_supp_cond   = farr_zeros(1)
    let meta_total         = farr_zeros(1)
    let meta_supp_strict   = farr_zeros(1)

    let mut i = 0
    while i < 17 {
        let cls = to_int(farr_get(cells, i * 2))
        let tier = to_int(farr_get(cells, i * 2 + 1))
        let is_cond_or_supp = if tier >= 1 { 1 } else { 0 }
        let is_strict_supp  = if tier == 2 { 1 } else { 0 }
        if cls == 0 {
            let _ = farr_set(struct_total, 0, to_float(to_int(farr_get(struct_total,0)) + 1))
            let _ = farr_set(struct_supp_cond, 0, to_float(to_int(farr_get(struct_supp_cond,0)) + is_cond_or_supp))
            let _ = farr_set(struct_supp_strict, 0, to_float(to_int(farr_get(struct_supp_strict,0)) + is_strict_supp))
        }
        if cls == 1 {
            let _ = farr_set(dyn_total, 0, to_float(to_int(farr_get(dyn_total,0)) + 1))
            let _ = farr_set(dyn_supp_cond, 0, to_float(to_int(farr_get(dyn_supp_cond,0)) + is_cond_or_supp))
            let _ = farr_set(dyn_supp_strict, 0, to_float(to_int(farr_get(dyn_supp_strict,0)) + is_strict_supp))
        }
        if cls == 2 {
            let _ = farr_set(hybrid_total, 0, to_float(to_int(farr_get(hybrid_total,0)) + 1))
            let _ = farr_set(hybrid_supp_cond, 0, to_float(to_int(farr_get(hybrid_supp_cond,0)) + is_cond_or_supp))
        }
        if cls == 3 {
            let _ = farr_set(meta_total, 0, to_float(to_int(farr_get(meta_total,0)) + 1))
            let _ = farr_set(meta_supp_strict, 0, to_float(to_int(farr_get(meta_supp_strict,0)) + is_strict_supp))
        }
        i = i + 1
    }

    let s_total = to_int(farr_get(struct_total, 0))
    let s_cond = to_int(farr_get(struct_supp_cond, 0))
    let s_strict = to_int(farr_get(struct_supp_strict, 0))
    let d_total = to_int(farr_get(dyn_total, 0))
    let d_cond = to_int(farr_get(dyn_supp_cond, 0))
    let d_strict = to_int(farr_get(dyn_supp_strict, 0))
    let h_total = to_int(farr_get(hybrid_total, 0))
    let h_cond = to_int(farr_get(hybrid_supp_cond, 0))
    let m_total = to_int(farr_get(meta_total, 0))
    let m_strict = to_int(farr_get(meta_supp_strict, 0))

    println("STRUCT total=" + str(s_total) + " strict_supp=" + str(s_strict) + " cond_supp=" + str(s_cond))
    println("DYN    total=" + str(d_total) + " strict_supp=" + str(d_strict) + " cond_supp=" + str(d_cond))
    println("HYBRID total=" + str(h_total) + " cond_supp=" + str(h_cond))
    println("META   total=" + str(m_total) + " strict_supp=" + str(m_strict))

    let s_rate_cond = to_float(s_cond) / to_float(s_total)
    let d_rate_cond = to_float(d_cond) / to_float(d_total)
    let s_rate_strict = to_float(s_strict) / to_float(s_total)
    let d_rate_strict = to_float(d_strict) / to_float(d_total)
    println("supp_rate_cond:   STRUCT=" + str(s_rate_cond) + "  DYN=" + str(d_rate_cond) + "  ratio_DYN_over_STR=" + str(d_rate_cond / s_rate_cond))
    println("supp_rate_strict: STRUCT=" + str(s_rate_strict) + "  DYN=" + str(d_rate_strict) + "  ratio_DYN_over_STR=" + str(d_rate_strict / s_rate_strict))
    println("done")
}
