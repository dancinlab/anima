// ════════════════════════════════════════════════════════════════════════════
//  run_h226.hexa — H_226 SPATIAL-ASSORTMENT × HAMILTON'S RULE prerequisite
//
//  QUESTION
//    Hamilton's rule (r·b > c) 가 cooperation evolve 의 *prerequisite* 이라면,
//    초기 spatial assortment 계수 r 의 ordered sweep 위 cooperator-fraction
//    outcome 이 monotone (clustered ≥ random ≥ anti-clustered) 해야 한다.
//    fixed payoff (b=3, c=1; r·b=1.5 > c=1 favorable) × 3 init regime →
//    Hamilton threshold cross 는 *kin-clustering 필요조건* 인가?
//
//  EXPERIMENT
//    pool N=16 cells, lattice 1-D, radius=2. fixed payoff (b=3, c=1).
//    3 init regimes (50/50 C/D, same composition, different spatial layout):
//      - CLUSTERED   : [C,C,C,C,C,C,C,C,D,D,D,D,D,D,D,D]   (r ≈ +0.5)
//      - RANDOM      : deterministic Fisher-Yates shuffle with fixed seed
//                       on clustered init  (r ≈ 0)
//      - ANTI-CLUSTER: [C,D,C,D,C,D,C,D,C,D,C,D,C,D,C,D]   (r ≈ -0.5)
//
//    assortment coefficient r (Hamilton, positional proxy):
//      r = (P(C-C) - P(C)·P(C)) / (P(C) - P(C)·P(C))
//      where P(C-C) = fraction of within-radius neighbor pairs both cooperate
//            P(C)   = global cooperator fraction (here always 0.5 init)
//      r=+1 = perfect assortment (all coop pair with coop)
//      r= 0 = random mixing
//      r=-1 = perfect anti-assortment (coop always with defector)
//
//    update rule: per H_210 (kin-selection canonical) — global argmax
//    replicates strategy into lowest-fitness neighbor within radius.
//
//  DETERMINISM
//    pure-integer/float arithmetic + deterministic argmax tie-break (lowest
//    index) + deterministic Fisher-Yates with fixed integer LCG seed (no
//    gaussian noise, no __HEXA_FARR_GAUSS_SEED__). Byte-identical re-run.
//
//  PRIMARY METRIC
//    per regime: initial assortment coef r + final cooperator-fraction.
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
//
//  FALSIFIERS (≥5, pre-registered)
//    F-H226-1 ORDERING-MONOTONE   : final_frac(clustered) ≥ final_frac(random)
//                                    ≥ final_frac(anti-cluster)
//    F-H226-2 HAMILTON-THRESHOLD  : clustered final_frac ≥ 0.5 AND anti-cluster
//                                    final_frac ≤ 0.2  (Hamilton cross consistent)
//    F-H226-3 DELTA-MAGNITUDE     : |final_frac(clustered) - final_frac(anti)| ≥ 0.7
//    F-H226-4 BYTE-IDENTICAL      : re-run identical metrics across all 3 regimes
//    F-H226-5 FRAC-DEFINED        : all final fractions ∈ [0, 1] (no NaN/undef)
// ════════════════════════════════════════════════════════════════════════════


// ─── frozen configuration ──────────────────────────────────────────────────
let N_CELLS    = 16
let N_STEPS    = 30
let RADIUS     = 2
let B_FIXED    = 3.0
let C_FIXED    = 1.0
let OUT_JSON   = "UNIVERSE/state/h226_spatial_assortment_hamilton_2026_05_24/result.json"


// ─── helpers ───────────────────────────────────────────────────────────────

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// init regime 1: CLUSTERED 50/50  [C,C,...,C,D,D,...,D]  (r ≈ +0.5).
fn init_clustered(n: int) {
    let mut s = []
    let half = n / 2
    let mut i = 0
    while i < n {
        if i < half { s.push(1) } else { s.push(0) }
        i = i + 1
    }
    return s
}

// init regime 2: ANTI-CLUSTERED  [C,D,C,D,...]  (r ≈ -0.5).
fn init_anti_clustered(n: int) {
    let mut s = []
    let mut i = 0
    while i < n {
        if (i % 2) == 0 { s.push(1) } else { s.push(0) }
        i = i + 1
    }
    return s
}

// deterministic LCG (Numerical Recipes constants).  state ∈ [0, 2^31).
fn _lcg_next(state: int) -> int {
    let a = 1103515245
    let cc = 12345
    let m = 2147483648  // 2^31
    let s = (a * state + cc) % m
    return s
}

// init regime 3: RANDOM (deterministic Fisher-Yates shuffle on clustered).
// seed=42 fixed LCG → byte-identical across runs.
fn init_random(n: int) {
    let mut s = init_clustered(n)
    let mut state = 42
    let mut i = n - 1
    while i > 0 {
        state = _lcg_next(state)
        let j = state % (i + 1)
        if j != i {
            let tmp = s[i]
            s[i] = s[j]
            s[j] = tmp
        }
        i = i - 1
    }
    return s
}

// cooperator count.
fn count_coop(strats) -> int {
    let n = len(strats)
    let mut k = 0
    let mut i = 0
    while i < n {
        if strats[i] == 1 { k = k + 1 }
        i = i + 1
    }
    return k
}

// cooperator fraction.
fn coop_frac(strats) -> float {
    let n = len(strats)
    if n == 0 { return 0.0 }
    let k = count_coop(strats)
    return (k + 0.0) / (n + 0.0)
}

// assortment coefficient r (positional Hamilton proxy).
//   r = (P(CC) - P(C)^2) / (P(C) - P(C)^2)
//   P(CC) = fraction of ordered within-radius neighbor pairs (i,j) both C
//   P(C)  = global cooperator fraction
// Returns 0.0 when denominator is 0 (degenerate: P(C)∈{0,1}).
fn assortment_coef(strats, radius: int) -> float {
    let n = len(strats)
    let pc = coop_frac(strats)
    let denom = pc - pc * pc
    if abs_f(denom) < 0.000001 { return 0.0 }

    let mut pairs = 0
    let mut both_c = 0
    let mut i = 0
    while i < n {
        let mut j = i - radius
        while j <= i + radius {
            if (j != i) && (j >= 0) && (j < n) {
                pairs = pairs + 1
                if (strats[i] == 1) && (strats[j] == 1) {
                    both_c = both_c + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    if pairs == 0 { return 0.0 }
    let p_cc = (both_c + 0.0) / (pairs + 0.0)
    return (p_cc - pc * pc) / denom
}

// compute per-cell payoff under (b, c).
// (C,C)+b-c · (C,D)-c · (D,C)+b · (D,D) 0.   no wrap.
fn compute_payoffs(strats, b: float, c: float, radius: int) {
    let n = len(strats)
    let mut payoffs = []
    let mut i = 0
    while i < n {
        let mut p = 0.0
        let mut j = i - radius
        while j <= i + radius {
            if (j != i) && (j >= 0) && (j < n) {
                let si = strats[i]
                let sj = strats[j]
                if (si == 1) && (sj == 1) {
                    p = p + b - c
                } else {
                    if (si == 1) && (sj == 0) {
                        p = p - c
                    } else {
                        if (si == 0) && (sj == 1) {
                            p = p + b
                        }
                    }
                }
            }
            j = j + 1
        }
        payoffs.push(p)
        i = i + 1
    }
    return payoffs
}

// global argmax (lowest-index tie-break).
fn argmax(payoffs) -> int {
    let n = len(payoffs)
    let mut best_i = 0
    let mut best_v = payoffs[0]
    let mut i = 1
    while i < n {
        if payoffs[i] > best_v {
            best_v = payoffs[i]
            best_i = i
        }
        i = i + 1
    }
    return best_i
}

// lowest-fitness neighbor in radius (lowest-index tie-break).  -1 if none.
fn argmin_neighbor(payoffs, focal: int, radius: int) -> int {
    let n = len(payoffs)
    let mut best_i = -1
    let mut best_v = 0.0
    let mut found = false
    let mut j = focal - radius
    while j <= focal + radius {
        if (j != focal) && (j >= 0) && (j < n) {
            if !found {
                best_v = payoffs[j]
                best_i = j
                found = true
            } else {
                if payoffs[j] < best_v {
                    best_v = payoffs[j]
                    best_i = j
                }
            }
        }
        j = j + 1
    }
    return best_i
}

// one evolution step (replication-only kin-selection).
fn evolve_step(strats, b: float, c: float, radius: int) {
    let payoffs = compute_payoffs(strats, b, c, radius)
    let n = len(strats)
    let src = argmax(payoffs)
    let src_payoff = payoffs[src]

    let mut coop_split = 0
    let mut defect_split = 0
    let mut new_strats = []
    let mut i = 0
    while i < n {
        new_strats.push(strats[i])
        i = i + 1
    }

    if src_payoff > 0.0 {
        let tgt = argmin_neighbor(payoffs, src, radius)
        if tgt >= 0 {
            let src_strat = strats[src]
            let prev_tgt = new_strats[tgt]
            new_strats[tgt] = src_strat
            if prev_tgt != src_strat {
                if src_strat == 1 { coop_split = coop_split + 1 }
                if src_strat == 0 { defect_split = defect_split + 1 }
            }
        }
    }

    return #{
        "strats":        new_strats,
        "coop_split":    coop_split,
        "defect_split":  defect_split
    }
}

// full simulation for a given init regime.
fn simulate_regime(init_strats, b: float, c: float, radius: int, n_steps: int) {
    let mut strats = init_strats
    let init_r = assortment_coef(strats, radius)
    let init_frac = coop_frac(strats)
    let mut traj = []
    traj.push(init_frac)
    let mut total_coop_split = 0
    let mut total_defect_split = 0
    let mut step = 0
    while step < n_steps {
        let res = evolve_step(strats, b, c, radius)
        strats = res["strats"]
        total_coop_split = total_coop_split + res["coop_split"]
        total_defect_split = total_defect_split + res["defect_split"]
        traj.push(coop_frac(strats))
        step = step + 1
    }
    return #{
        "init_strats":   init_strats,
        "init_r":        init_r,
        "init_frac":     init_frac,
        "final_frac":    coop_frac(strats),
        "final_strats":  strats,
        "traj":          traj,
        "coop_split":    total_coop_split,
        "defect_split":  total_defect_split
    }
}


// ─── JSON serialisation helpers ───────────────────────────────────────────

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true  v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = to_string(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + to_string(to_int(whole)) + "." + frac_str
}

fn _int_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + _f6(arr[i])
        i = i + 1
    }
    return out + "]"
}


// ─── main ─────────────────────────────────────────────────────────────────

fn _run_h226() {
    println("================================================================")
    println("H_226 SPATIAL-ASSORTMENT × HAMILTON'S RULE prerequisite")
    println("  N_CELLS=" + to_string(N_CELLS) + "  RADIUS=" + to_string(RADIUS)
            + "  N_STEPS=" + to_string(N_STEPS))
    println("  payoff: b=" + _f6(B_FIXED) + " c=" + _f6(C_FIXED)
            + "  (Hamilton: r·b > c with r≈0.5 → favorable in clustered)")
    println("  deterministic · hexa-only · LLM none · $0 mac local")
    println("================================================================")

    // ── REGIME CLUSTERED ────────────────────────────────────────────────
    println("")
    println("--- REGIME CLUSTERED: init [C,C,...,C,D,D,...,D]  (r ≈ +0.5) ---")
    let initC = init_clustered(N_CELLS)
    let rC = simulate_regime(initC, B_FIXED, C_FIXED, RADIUS, N_STEPS)
    println("  init_strats       = " + _int_arr_json(rC["init_strats"]))
    println("  init_r            = " + _f6(rC["init_r"]))
    println("  init_coop_frac    = " + _f6(rC["init_frac"]))
    println("  final_coop_frac   = " + _f6(rC["final_frac"]))
    println("  coop_splits       = " + to_string(rC["coop_split"]))
    println("  defect_splits     = " + to_string(rC["defect_split"]))

    // ── REGIME RANDOM ─────────────────────────────────────────────────
    println("")
    println("--- REGIME RANDOM: deterministic Fisher-Yates (seed=42)  (r ≈ 0) ---")
    let initR = init_random(N_CELLS)
    let rR = simulate_regime(initR, B_FIXED, C_FIXED, RADIUS, N_STEPS)
    println("  init_strats       = " + _int_arr_json(rR["init_strats"]))
    println("  init_r            = " + _f6(rR["init_r"]))
    println("  init_coop_frac    = " + _f6(rR["init_frac"]))
    println("  final_coop_frac   = " + _f6(rR["final_frac"]))
    println("  coop_splits       = " + to_string(rR["coop_split"]))
    println("  defect_splits     = " + to_string(rR["defect_split"]))

    // ── REGIME ANTI-CLUSTERED ─────────────────────────────────────────
    println("")
    println("--- REGIME ANTI-CLUSTERED: init [C,D,C,D,...]  (r ≈ -0.5) ---")
    let initA = init_anti_clustered(N_CELLS)
    let rA = simulate_regime(initA, B_FIXED, C_FIXED, RADIUS, N_STEPS)
    println("  init_strats       = " + _int_arr_json(rA["init_strats"]))
    println("  init_r            = " + _f6(rA["init_r"]))
    println("  init_coop_frac    = " + _f6(rA["init_frac"]))
    println("  final_coop_frac   = " + _f6(rA["final_frac"]))
    println("  coop_splits       = " + to_string(rA["coop_split"]))
    println("  defect_splits     = " + to_string(rA["defect_split"]))

    // ── BYTE-IDENTICAL RE-RUN ────────────────────────────────────────
    println("")
    println("--- BYTE-IDENTICAL RE-RUN: all 3 regimes repeat ---")
    let rC2 = simulate_regime(init_clustered(N_CELLS),       B_FIXED, C_FIXED, RADIUS, N_STEPS)
    let rR2 = simulate_regime(init_random(N_CELLS),          B_FIXED, C_FIXED, RADIUS, N_STEPS)
    let rA2 = simulate_regime(init_anti_clustered(N_CELLS),  B_FIXED, C_FIXED, RADIUS, N_STEPS)
    let identical_C = (rC2["final_frac"] == rC["final_frac"])
                   && (rC2["coop_split"] == rC["coop_split"])
                   && (rC2["defect_split"] == rC["defect_split"])
    let identical_R = (rR2["final_frac"] == rR["final_frac"])
                   && (rR2["coop_split"] == rR["coop_split"])
                   && (rR2["defect_split"] == rR["defect_split"])
    let identical_A = (rA2["final_frac"] == rA["final_frac"])
                   && (rA2["coop_split"] == rA["coop_split"])
                   && (rA2["defect_split"] == rA["defect_split"])
    let byte_identical = identical_C && identical_R && identical_A
    println("  clustered  identical = " + to_string(identical_C))
    println("  random     identical = " + to_string(identical_R))
    println("  anti-clust identical = " + to_string(identical_A))
    println("  BYTE_IDENTICAL_ALL   = " + to_string(byte_identical))

    // ── falsifier verdicts ──────────────────────────────────────────
    let f1_ordering = (rC["final_frac"] >= rR["final_frac"])
                   && (rR["final_frac"] >= rA["final_frac"])
    let f2_hamilton = (rC["final_frac"] >= 0.5) && (rA["final_frac"] <= 0.2)
    let delta = abs_f(rC["final_frac"] - rA["final_frac"])
    let f3_delta = (delta >= 0.7)
    let f4_byte = byte_identical
    let f5_defined = (rC["final_frac"] >= 0.0) && (rC["final_frac"] <= 1.0)
                  && (rR["final_frac"] >= 0.0) && (rR["final_frac"] <= 1.0)
                  && (rA["final_frac"] >= 0.0) && (rA["final_frac"] <= 1.0)

    let v1 = if f1_ordering { "PASS" } else { "FAIL" }
    let v2 = if f2_hamilton { "PASS" } else { "FAIL" }
    let v3 = if f3_delta    { "PASS" } else { "FAIL" }
    let v4 = if f4_byte     { "PASS" } else { "FAIL" }
    let v5 = if f5_defined  { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1_ordering { n_pass = n_pass + 1 }
    if f2_hamilton { n_pass = n_pass + 1 }
    if f3_delta    { n_pass = n_pass + 1 }
    if f4_byte     { n_pass = n_pass + 1 }
    if f5_defined  { n_pass = n_pass + 1 }

    // verdict_rule (from §Criteria):
    //   SUPPORTED if C1(F1)+C2(F2) PASS
    //   PARTIAL  if exactly one of {F1,F2} PASS
    //   FALSIFIED if both F1+F2 FAIL
    let core = f1_ordering && f2_hamilton
    let one_core = ((if f1_ordering { 1 } else { 0 }) + (if f2_hamilton { 1 } else { 0 })) == 1
    let verdict = if core {
        if (n_pass == 5) { "SUPPORTED_FULL" } else { "SUPPORTED" }
    } else {
        if one_core { "PARTIAL" } else { "FALSIFIED" }
    }

    // ── result.json ──────────────────────────────────────────────
    let mut buf = "{\n"
    buf = buf + "  \"hypothesis\": \"H_226\",\n"
    buf = buf + "  \"domain\": \"LIFE-ethics-substrate\",\n"
    buf = buf + "  \"title\": \"SPATIAL-ASSORTMENT × HAMILTON prerequisite — kin-clustering necessary condition\",\n"
    buf = buf + "  \"date\": \"2026-05-24\",\n"
    buf = buf + "  \"host\": \"mac-local\",\n"
    buf = buf + "  \"deterministic\": true,\n"
    buf = buf + "  \"llm\": \"none\",\n"
    buf = buf + "  \"n_cells\": " + to_string(N_CELLS) + ",\n"
    buf = buf + "  \"radius\": " + to_string(RADIUS) + ",\n"
    buf = buf + "  \"n_steps\": " + to_string(N_STEPS) + ",\n"
    buf = buf + "  \"payoff\": { \"b\": " + _f6(B_FIXED) + ", \"c\": " + _f6(C_FIXED) + " },\n"
    buf = buf + "  \"hamilton_note\": \"r·b > c with r≈0.5 → 1.5 > 1 favorable (clustered only)\",\n"

    buf = buf + "  \"regime_CLUSTERED\": {\n"
    buf = buf + "    \"init_r\": " + _f6(rC["init_r"]) + ",\n"
    buf = buf + "    \"init_strats\": " + _int_arr_json(rC["init_strats"]) + ",\n"
    buf = buf + "    \"init_coop_frac\": " + _f6(rC["init_frac"]) + ",\n"
    buf = buf + "    \"final_coop_frac\": " + _f6(rC["final_frac"]) + ",\n"
    buf = buf + "    \"final_strats\": " + _int_arr_json(rC["final_strats"]) + ",\n"
    buf = buf + "    \"coop_splits\": " + to_string(rC["coop_split"]) + ",\n"
    buf = buf + "    \"defect_splits\": " + to_string(rC["defect_split"]) + ",\n"
    buf = buf + "    \"traj\": " + _float_arr_json(rC["traj"]) + "\n"
    buf = buf + "  },\n"

    buf = buf + "  \"regime_RANDOM\": {\n"
    buf = buf + "    \"init_r\": " + _f6(rR["init_r"]) + ",\n"
    buf = buf + "    \"init_strats\": " + _int_arr_json(rR["init_strats"]) + ",\n"
    buf = buf + "    \"init_coop_frac\": " + _f6(rR["init_frac"]) + ",\n"
    buf = buf + "    \"final_coop_frac\": " + _f6(rR["final_frac"]) + ",\n"
    buf = buf + "    \"final_strats\": " + _int_arr_json(rR["final_strats"]) + ",\n"
    buf = buf + "    \"coop_splits\": " + to_string(rR["coop_split"]) + ",\n"
    buf = buf + "    \"defect_splits\": " + to_string(rR["defect_split"]) + ",\n"
    buf = buf + "    \"traj\": " + _float_arr_json(rR["traj"]) + "\n"
    buf = buf + "  },\n"

    buf = buf + "  \"regime_ANTI_CLUSTERED\": {\n"
    buf = buf + "    \"init_r\": " + _f6(rA["init_r"]) + ",\n"
    buf = buf + "    \"init_strats\": " + _int_arr_json(rA["init_strats"]) + ",\n"
    buf = buf + "    \"init_coop_frac\": " + _f6(rA["init_frac"]) + ",\n"
    buf = buf + "    \"final_coop_frac\": " + _f6(rA["final_frac"]) + ",\n"
    buf = buf + "    \"final_strats\": " + _int_arr_json(rA["final_strats"]) + ",\n"
    buf = buf + "    \"coop_splits\": " + to_string(rA["coop_split"]) + ",\n"
    buf = buf + "    \"defect_splits\": " + to_string(rA["defect_split"]) + ",\n"
    buf = buf + "    \"traj\": " + _float_arr_json(rA["traj"]) + "\n"
    buf = buf + "  },\n"

    buf = buf + "  \"byte_identical_run\": {\n"
    buf = buf + "    \"clustered\":  " + to_string(identical_C) + ",\n"
    buf = buf + "    \"random\":     " + to_string(identical_R) + ",\n"
    buf = buf + "    \"anti\":       " + to_string(identical_A) + ",\n"
    buf = buf + "    \"all\":        " + to_string(byte_identical) + "\n"
    buf = buf + "  },\n"

    buf = buf + "  \"delta_clustered_minus_anti\": " + _f6(delta) + ",\n"

    buf = buf + "  \"falsifiers\": {\n"
    buf = buf + "    \"F_H226_1_ORDERING_MONOTONE\": { \"metric\": \"clustered.final >= random.final >= anti.final\", \"verdict\": \"" + v1 + "\" },\n"
    buf = buf + "    \"F_H226_2_HAMILTON_THRESHOLD\": { \"metric\": \"clustered.final >= 0.5 AND anti.final <= 0.2\", \"verdict\": \"" + v2 + "\" },\n"
    buf = buf + "    \"F_H226_3_DELTA_MAGNITUDE\":   { \"metric\": \"|clustered.final - anti.final| >= 0.7\", \"value\": " + _f6(delta) + ", \"verdict\": \"" + v3 + "\" },\n"
    buf = buf + "    \"F_H226_4_BYTE_IDENTICAL\":    { \"metric\": \"all 3 regimes identical across re-run\", \"verdict\": \"" + v4 + "\" },\n"
    buf = buf + "    \"F_H226_5_FRAC_DEFINED\":      { \"metric\": \"all final_frac ∈ [0,1]\", \"verdict\": \"" + v5 + "\" }\n"
    buf = buf + "  },\n"

    buf = buf + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    buf = buf + "  \"criteria_met\": \"" + to_string(n_pass) + "/5\",\n"
    buf = buf + "  \"verdict\": \"" + verdict + "\",\n"
    buf = buf + "  \"invariant_tier\": \"GREEN_NUMERICAL\"\n"
    buf = buf + "}\n"

    write_file(OUT_JSON, buf)

    println("")
    println("F-H226-1 ORDERING-MONOTONE    " + v1
            + "  (C=" + _f6(rC["final_frac"]) + " ≥ R=" + _f6(rR["final_frac"])
            + " ≥ A=" + _f6(rA["final_frac"]) + ")")
    println("F-H226-2 HAMILTON-THRESHOLD   " + v2
            + "  (C ≥ 0.5: " + to_string(rC["final_frac"] >= 0.5)
            + "  A ≤ 0.2: " + to_string(rA["final_frac"] <= 0.2) + ")")
    println("F-H226-3 DELTA-MAGNITUDE      " + v3
            + "  (|ΔC-A| = " + _f6(delta) + " ≥ 0.7)")
    println("F-H226-4 BYTE-IDENTICAL       " + v4)
    println("F-H226-5 FRAC-DEFINED         " + v5)
    println("================================================================")
    println("VERDICT: " + verdict + "  (" + to_string(n_pass) + "/5 falsifiers PASS)")
    println("  result.json -> " + OUT_JSON)
    println("================================================================")
}


_run_h226()
