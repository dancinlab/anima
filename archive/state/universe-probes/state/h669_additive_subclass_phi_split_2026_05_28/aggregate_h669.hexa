// ════════════════════════════════════════════════════════════════════════════
// H_669 — additive-subclass-phi-split — PHI-FREE AGGREGATE (no big_phi call, <1s)
//   Consumes shard norm_conv/log_span verbatim (H_669 NEW rule60 + H_664/H_661 anchors)
//   → additive {90,150,60} vs chaotic {30,45,106} 의 Φ-속성 분포 분리도.
//   가설: additive(XOR-linear)가 chaotic class-III 와 통계적으로 분리 — additive 가
//   별도 sub-class (Φ-floor 근처, class-I 유사). Wolfram class-III = additive ⊎ chaotic.
//   분리 측도: 분산비(between/within) + cluster separation(grp-mean gap vs intra-std)
//   + 분포 겹침(min/max overlap).  pre-registered falsifier F669.1-6.
//   deterministic · hexa-only · $0 mac-local · foreground sync.
// ════════════════════════════════════════════════════════════════════════════

fn mean(xs: array) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() { s = s + xs[i]; i = i + 1 }
    return s / to_float(xs.len())
}

// population variance (deterministic, /N)
fn variance(xs: array) -> float {
    let m = mean(xs)
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() { let d = xs[i] - m; s = s + d * d; i = i + 1 }
    return s / to_float(xs.len())
}

fn maxv(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 0
    while i < xs.len() { if xs[i] > m { m = xs[i] }; i = i + 1 }
    return m
}
fn minv(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 0
    while i < xs.len() { if xs[i] < m { m = xs[i] }; i = i + 1 }
    return m
}
fn absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn main() {
    // ── norm_conv (CORE Φ-속성, H_660 측도) — shard verbatim ──
    // ADDITIVE (XOR-linear): rule90, rule150, rule60(NEW)
    let nc_ADD = [2.24029, 1.93118, 2.24029]
    // CHAOTIC (non-additive class-III): rule30, rule45, rule106
    let nc_CHA = [2.26615, 1.4608, 2.1531]

    // ── log_span (2nd Φ-속성 magnitude proxy) — rule150 DEGENERATE(Φmin=0) 제외 ──
    // additive finite: rule90, rule60   (rule150 excluded: log_span blowup 10.84)
    let ls_ADD_finite = [3.41499, 3.41489]
    // chaotic finite: rule30, rule45, rule106
    let ls_CHA_finite = [3.42656, 1.61842, 3.26926]

    // ── group means / variances (norm_conv) ──
    let mean_ADD = mean(nc_ADD)
    let mean_CHA = mean(nc_CHA)
    let var_ADD  = variance(nc_ADD)
    let var_CHA  = variance(nc_CHA)
    let var_within_pooled = (var_ADD + var_CHA) / 2.0    // 두 그룹 내부 분산 평균

    // ── between-group variance: spread of the 2 group means ──
    let grp_means = [mean_ADD, mean_CHA]
    let var_between = variance(grp_means)

    // ── separation ratio (F-test 류): between / within ──
    let ratio_between_within = var_between / (var_within_pooled + 0.0000001)

    // ── cluster separation: |group-mean gap| vs max intra-group std ──
    let grp_gap   = absf(mean_ADD - mean_CHA)
    let intra_std = pow(maxv([var_ADD, var_CHA]), 0.5)   // max group internal std

    // ── distribution overlap (norm_conv ranges) ──
    let add_min = minv(nc_ADD)
    let add_max = maxv(nc_ADD)
    let cha_min = minv(nc_CHA)
    let cha_max = maxv(nc_CHA)
    // overlap = 두 [min,max] 구간의 겹치는 길이 (양수면 겹침)
    let ov_lo = maxv([add_min, cha_min])
    let ov_hi = minv([add_max, cha_max])
    let overlap_len = ov_hi - ov_lo                        // >0 ⇒ 분포 겹침 (분리 불가)
    let add_range = add_max - add_min
    let cha_range = cha_max - cha_min
    let union_range = maxv([add_max, cha_max]) - minv([add_min, cha_min])
    let overlap_frac = overlap_len / (union_range + 0.0000001)  // 겹침 비율

    // ── floor-class test: additive 가 chaotic 보다 LOWER Φ-property (class-I 유사 floor)? ──
    //   가설은 additive=floor (mean_ADD < mean_CHA). 측정으로 검정.
    let additive_is_floor = mean_ADD < mean_CHA

    println("=== H_669 additive-subclass-phi-split aggregate (phi-free) ===");
    println("ADDITIVE(3): rule90=2.24029 rule150=1.93118 rule60=2.24029   mean_ADD=" + to_string(mean_ADD) + " var=" + to_string(var_ADD))
    println("CHAOTIC (3): rule30=2.26615 rule45=1.4608 rule106=2.1531     mean_CHA=" + to_string(mean_CHA) + " var=" + to_string(var_CHA))
    println("")
    println("var_within_pooled    = " + to_string(var_within_pooled))
    println("var_between(2 grp-m) = " + to_string(var_between))
    println("RATIO between/within = " + to_string(ratio_between_within))
    println("grp_gap |ADD-CHA|    = " + to_string(grp_gap))
    println("intra_std (max grp)  = " + to_string(intra_std))
    println("")
    println("-- distribution overlap (norm_conv ranges) --")
    println("ADD range [" + to_string(add_min) + ", " + to_string(add_max) + "]")
    println("CHA range [" + to_string(cha_min) + ", " + to_string(cha_max) + "]")
    println("overlap_len  = " + to_string(overlap_len) + "  (>0 ⇒ 분포 겹침)")
    println("overlap_frac = " + to_string(overlap_frac))
    println("additive_is_floor (mean_ADD < mean_CHA) = " + to_string(additive_is_floor))
    println("")

    // ════════ pre-registered falsifier (frozen BEFORE measuring rule60) ════════
    // 가설: additive 가 chaotic 과 분리된 별도 sub-class (floor 근처). 분리 = PASS.
    // F669.1 CORE SEPARATION — between/within var ratio ≥ 1.0 (그룹-간 분산 ≥ 그룹-내 분산)
    let f1 = ratio_between_within >= 1.0
    // F669.2 GAP-EXCEEDS-SPREAD — group-mean gap > max intra-group std (cluster 분리)
    let f2 = grp_gap > intra_std
    // F669.3 NO-OVERLAP — 두 분포 norm_conv 구간이 겹치지 않음 (overlap_len ≤ 0)
    let f3 = overlap_len <= 0.0
    // F669.4 ADDITIVE-FLOOR — additive 가 chaotic 보다 LOWER (class-I 유사 floor): mean_ADD < mean_CHA
    let f4 = additive_is_floor
    // F669.5 DISTINCT-FRAC — overlap_frac < 0.3 (겹침이 union 의 30% 미만 = 대체로 분리)
    let f5 = overlap_frac < 0.3
    // F669.6 BOUND — 全 통계 finite·non-negative
    let f6 = (var_ADD >= 0.0) && (var_CHA >= 0.0) && (var_between >= 0.0) && (ratio_between_within >= 0.0)

    let mut npass = 0
    if f1 { npass = npass + 1 }
    if f2 { npass = npass + 1 }
    if f3 { npass = npass + 1 }
    if f4 { npass = npass + 1 }
    if f5 { npass = npass + 1 }
    if f6 { npass = npass + 1 }

    println("────────── verdict ──────────")
    if f1 { println("[PASS] F669.1 CORE between/within var >= 1.0 : " + to_string(ratio_between_within) + " >= 1.0") }
    else  { println("[FAIL] F669.1 CORE between/within var >= 1.0 : " + to_string(ratio_between_within) + " < 1.0") }
    if f2 { println("[PASS] F669.2 grp-gap > intra-std : " + to_string(grp_gap) + " > " + to_string(intra_std)) }
    else  { println("[FAIL] F669.2 grp-gap > intra-std : " + to_string(grp_gap) + " <= " + to_string(intra_std)) }
    if f3 { println("[PASS] F669.3 NO-OVERLAP norm_conv 구간 분리 : overlap_len=" + to_string(overlap_len) + " <= 0") }
    else  { println("[FAIL] F669.3 NO-OVERLAP norm_conv 구간 분리 : overlap_len=" + to_string(overlap_len) + " > 0 (겹침)") }
    if f4 { println("[PASS] F669.4 ADDITIVE-FLOOR mean_ADD < mean_CHA : " + to_string(mean_ADD) + " < " + to_string(mean_CHA)) }
    else  { println("[FAIL] F669.4 ADDITIVE-FLOOR mean_ADD < mean_CHA : " + to_string(mean_ADD) + " >= " + to_string(mean_CHA)) }
    if f5 { println("[PASS] F669.5 DISTINCT overlap_frac < 0.3 : " + to_string(overlap_frac)) }
    else  { println("[FAIL] F669.5 DISTINCT overlap_frac < 0.3 : " + to_string(overlap_frac)) }
    if f6 { println("[PASS] F669.6 BOUND 全 통계 finite") }
    else  { println("[FAIL] F669.6 BOUND") }

    println("F669.1-6 " + to_string(npass) + "/6 PASS")
    let separated = f1 && f2 && f3
    let is_floor_subclass = f4 && f5
    println("additive_separated_class=" + to_string(separated) + " additive_floor_subclass=" + to_string(is_floor_subclass))
}
