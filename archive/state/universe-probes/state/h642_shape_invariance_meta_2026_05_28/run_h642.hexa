// ════════════════════════════════════════════════════════════════════════════
//  run_h642.hexa — H_642 shape-invariance vs scalar-convention meta-verification
//
//  CORE QUESTION (round 6 메타-발견 격상)
//    round 6 (mining H_632~639) 메타-발견: anima substrate 측정에서
//      • SHAPE feature  (peak 위치 · monotone 방향 · envelope 형태)
//          = substrate-emergent (class-invariant 경향, SUPP)
//      • SCALAR feature (absolute threshold · rate · magnitude)
//          = design-convention (class-variant 경향, FAL)
//    본 runner 는 그 dichotomy 를 정량 메타-검증.
//
//  HYPOTHESIS
//    substrate-class (rule {30, 54, 90, 110, 184}) 를 가로질러
//      CV_shape  (= CV of dΦ/dI peak I 위치 across rules)
//        <  CV_scalar (= CV of Φ magnitude peak height across rules).
//    즉 SHAPE feature 가 SCALAR feature 보다 class-invariant.
//
//  FALSIFIER
//    CV_shape ≥ CV_scalar (shape 가 scalar 만큼 또는 더 class-variant)
//      → round 6 메타-발견 반증.
//
//  SUBSTRATE
//    ECA on a periodic ring of n=4 cells (H_351/H_614 동일 grid · 동일 n).
//    rule set: {30, 54, 90, 110, 184} — H_614 의 4-rule {30, 54, 110, 184}
//    에 rule 90 (class III, Sierpinski additive/XOR) 추가 → 5-rule sample.
//      • rule 30   — class III chaotic
//      • rule 54   — class IV complex (edge-of-chaos)
//      • rule 90   — class III additive (Sierpinski, XOR-linear)
//      • rule 110  — class IV complex (H_351 anchor)
//      • rule 184  — class II particle-localized (traffic flow)
//
//    inhibition mapping (H_351/H_614 동일):
//       tpm_mixed[s,i] = (1 - I) * eca_tpm[s,i]
//
//  Φ MEASUREMENT
//    faithful causal big-Φ, average over all 2^4 = 16 states (H_285/H_351/
//    H_614 양식, single-state fragility 회피).
//
//  GRID (H_351/H_614 동일 13-point)
//    I ∈ {0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
//         0.50, 0.70, 0.95}
//
//  PER-RULE FEATURES
//    dΦ/dI : central finite difference (forward/backward at edges).
//    SHAPE   feature = argmax_I |dΦ/dI|   (peak I 위치)   ← substrate geometry
//    SCALAR  feature = max_I |dΦ/dI|       (peak |dΦ/dI| height) ← magnitude
//
//  META-STATISTIC (across 5 rules)
//    CV(x) = stddev(x) / mean(x)   (population stddev, coefficient of variation)
//    CV_shape  = CV(peak_I  across rules)
//    CV_scalar = CV(peak_mag across rules)
//
//  CRITERIA
//    M1 (SHAPE-MORE-INVARIANT) : CV_shape < CV_scalar          ← 핵심 가설
//    M2 (RATIO)                : ratio = CV_scalar / CV_shape > 1
//    M3 (BOUND/DET)            : CV ≥ 0, re-run byte-identical
//    H_614-anchor              : peak_I {0.18, 0.40, ?, 0.18, 0.40} 재현
//                                (rule 30/54/110/184 동일, rule 90 신규)
//
//  VERDICT
//    SUPPORTED-NUMERICAL = M1 PASS (CV_shape < CV_scalar)
//    FALSIFIED           = M1 FAIL (CV_shape ≥ CV_scalar)
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/tmp/u-h642/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _n() -> int    { return 4 }
fn _gz_lower() -> float { return 0.21232 }   // 0.5 - ln(4/3) ≈ 0.21232


fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


fn _sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}


// returns [peak_I (shape), peak_mag (scalar), sign_changes, phi_05, phi_095]
fn measure_rule(rule: int, grid: array) -> array {
    let m = len(grid)

    let mut phi = []
    let mut i = 0
    while i < m {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        i = i + 1
    }

    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }

    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    let peak_I = grid[peak_idx]

    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }

    let phi_05 = phi[10]
    let phi_095 = phi[12]

    return [peak_I, peak_mag, to_float(sign_changes), phi_05, phi_095]
}


// population mean
fn _mean(xs: array) -> float {
    let n = len(xs)
    let mut t = 0.0
    let mut i = 0
    while i < n {
        t = t + xs[i]
        i = i + 1
    }
    return t / to_float(n)
}


// population stddev
fn _std(xs: array) -> float {
    let n = len(xs)
    let mu = _mean(xs)
    let mut t = 0.0
    let mut i = 0
    while i < n {
        let d = xs[i] - mu
        t = t + d * d
        i = i + 1
    }
    return _sqrt(t / to_float(n))
}


// coefficient of variation = stddev / |mean|
fn _cv(xs: array) -> float {
    let mu = _mean(xs)
    let am = _abs(mu)
    if am < 1.0e-12 { return 0.0 }
    return _std(xs) / am
}


fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn json_arr_i(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_642 shape-invariance vs scalar-convention meta")
    println("  rules {30, 54, 90, 110, 184} · CV_shape vs CV_scalar")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]

    let rules = [30, 54, 90, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "III-additive",
                       "IV-complex", "II-particle"]

    let mut peak_Is = []
    let mut peak_mags = []
    let mut sign_changes_arr = []
    let mut phi_05_arr = []
    let mut phi_095_arr = []

    let mut r = 0
    let nr = len(rules)
    while r < nr {
        let rule = rules[r]
        println("")
        println("── rule " + str(rule) + " (" + class_names[r] + ") ──")
        let res = measure_rule(rule, grid)
        let peak_I = res[0]
        let peak_mag = res[1]
        let sg = res[2]
        let phi_05 = res[3]
        let phi_095 = res[4]

        peak_Is = peak_Is.push(peak_I)
        peak_mags = peak_mags.push(peak_mag)
        sign_changes_arr = sign_changes_arr.push(to_int(sg))
        phi_05_arr = phi_05_arr.push(phi_05)
        phi_095_arr = phi_095_arr.push(phi_095)

        let delta = _abs(peak_I - _gz_lower())
        println("  SHAPE  peak I       = " + str(peak_I) + "   (|Δ vs GZ_LOWER|=" + str(delta) + ")")
        println("  SCALAR peak |dΦ/dI| = " + str(peak_mag))
        println("  sign changes        = " + str(to_int(sg)))
        println("  Φ(0.50)/Φ(0.95)     = " + str(phi_05) + " / " + str(phi_095))
        r = r + 1
    }

    // ── meta-statistic ────────────────────────────────────────────────
    let cv_shape = _cv(peak_Is)
    let cv_scalar = _cv(peak_mags)
    let mean_shape = _mean(peak_Is)
    let mean_scalar = _mean(peak_mags)
    let std_shape = _std(peak_Is)
    let std_scalar = _std(peak_mags)

    let mut ratio = 0.0
    if cv_shape > 1.0e-12 { ratio = cv_scalar / cv_shape }

    let m1 = cv_shape < cv_scalar
    let mut m1f = 0
    if m1 { m1f = 1 }

    let m2 = ratio > 1.0
    let mut m2f = 0
    if m2 { m2f = 1 }

    println("")
    println("════════════════════════════════════════════════════════════")
    println("── META-STATISTIC (across 5 rules) ──")
    println("  peak_I  : mean=" + str(mean_shape) + " std=" + str(std_shape) + " CV_shape =" + str(cv_shape))
    println("  peak_mag: mean=" + str(mean_scalar) + " std=" + str(std_scalar) + " CV_scalar=" + str(cv_scalar))
    println("  ratio CV_scalar/CV_shape = " + str(ratio))
    println("  M1 SHAPE-MORE-INVARIANT (CV_shape < CV_scalar) = " + str(m1f))
    println("  M2 RATIO>1                                     = " + str(m2f))

    let mut verdict_str = "UNKNOWN"
    if m1 {
        verdict_str = "SUPPORTED-NUMERICAL"
    } else {
        verdict_str = "FALSIFIED"
    }
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_642\",\n"
    s = s + "  \"slug\": \"shape-invariance-vs-scalar-convention-meta\",\n"
    s = s + "  \"meta_of\": \"round 6 mining H_632~639 shape/scalar dichotomy\",\n"
    s = s + "  \"predecessors\": [\"H_614\", \"H_628\", \"H_351\"],\n"
    s = s + "  \"rules\": [30, 54, 90, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"III-additive\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"grid\": " + json_arr_f(grid) + ",\n"
    s = s + "  \"shape_feature_peak_I\": " + json_arr_f(peak_Is) + ",\n"
    s = s + "  \"scalar_feature_peak_mag\": " + json_arr_f(peak_mags) + ",\n"
    s = s + "  \"sign_changes\": " + json_arr_i(sign_changes_arr) + ",\n"
    s = s + "  \"phi_at_0_50\": " + json_arr_f(phi_05_arr) + ",\n"
    s = s + "  \"phi_at_0_95\": " + json_arr_f(phi_095_arr) + ",\n"
    s = s + "  \"mean_shape\": " + str(mean_shape) + ",\n"
    s = s + "  \"std_shape\": " + str(std_shape) + ",\n"
    s = s + "  \"cv_shape\": " + str(cv_shape) + ",\n"
    s = s + "  \"mean_scalar\": " + str(mean_scalar) + ",\n"
    s = s + "  \"std_scalar\": " + str(std_scalar) + ",\n"
    s = s + "  \"cv_scalar\": " + str(cv_scalar) + ",\n"
    s = s + "  \"ratio_scalar_over_shape\": " + str(ratio) + ",\n"
    s = s + "  \"m1_shape_more_invariant\": " + str(m1f) + ",\n"
    s = s + "  \"m2_ratio_gt_1\": " + str(m2f) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h642_shape_invariance_meta_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h642_shape_invariance_meta_2026_05_28/result.json")
}
