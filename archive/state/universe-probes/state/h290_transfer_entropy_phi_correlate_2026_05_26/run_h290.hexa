// UNIVERSE/state/h290_transfer_entropy_phi_correlate_2026_05_26/run_h290.hexa
//
//   H_290 — Does faithful IIT 4.0 big-Φ track TRANSFER ENTROPY (directed flow)?
//   (H_287 follow-up — completing the information-measure arc on the ECA panel)
//
//   ARC SO FAR (same 10-rule panel, faithful big-Φ)
//     H_287  Shannon output-entropy  ⊥ Φ   (r=0.363, reductive FALSIFIED)
//     H_288  Kolmogorov LZ-complexity ∥ Φ   (r=0.831, SUPPORTED)
//     H_290  TRANSFER ENTROPY (this)  ?      — directed inter-cell information FLOW
//
//   QUESTION
//     Shannon entropy is a SINGLE-system quantity (how many bits a system carries);
//     it dissociated from Φ. Transfer entropy (Schreiber 2000) is a PAIRWISE,
//     DIRECTED quantity — how much cell j's present reduces uncertainty about cell
//     i's future BEYOND i's own present. It measures inter-element information FLOW,
//     conceptually the closest classical proxy to "integration". Does Φ track it?
//
//   SEED-HYPOTHESIS H1 (TESTED)
//     Across the panel, faithful state-averaged big-Φ co-varies with total transfer
//     entropy: Pearson r(TE_total, Φ_mean) >= 0.5. (Prediction: SUPPORTED, and the
//     STRONGEST of the three — TE is a flow/coupling measure, like Φ.)
//
//   METHOD (reuse HEXAD/IIT4/lib — g61)
//     • eca_tpm(rule,n) → next-bit of each cell      (iit4_eca)
//     • big_phi(tpm,n,st)                            (iit4_bigphi via stdlib)
//     TE_total = Σ_{i} Σ_{j≠i} TE(j→i), over the UNIFORM 2^n state ensemble:
//       TE(j→i) = Σ p(i',i,j) · log2[ p(i'|i,j) / p(i'|i) ]
//       where i = bit_i(s) (present), j = bit_j(s) (source present), i' = next bit
//       of cell i under the rule. Joint counts over all 2^n states (deterministic
//       next ⇒ p(i'|·) are conditional frequencies). Units: bits.
//     Φ_mean = mean over all 2^n states of big_phi[0] (n=4 exact).
//     CORRELATE: Pearson r + Spearman ρ over the 10-rule panel (H_287/288 panel).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26, BEFORE measuring r / Φ)
//     F290.1 ANCHORS — constants 0/255: TE_total = 0 (no flow) AND Φ_mean = 0;
//            identity 204: TE_total = 0 (each cell self-determined, no inter-cell flow)
//            AND Φ_mean = 0.
//     F290.2 r-VERDICT — Pearson r(TE_total, Φ_mean). H1 SUPPORTED iff r >= 0.5.
//            r + Spearman ρ verbatim. Compared to H_287 (0.363) / H_288 (0.831).
//     F290.3 FLOW-WITNESS — an integrating rule (150/105/60/110/30) has TE_total > 0
//            (directed flow exists where Φ > 0).
//     F290.4 BOUND — TE_total >= 0 (transfer entropy is non-negative) and Φ_mean >= 0.
//     F290.5 DETERMINISM — rule 110 (TE_total, Φ_mean) re-run bit-identical.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope: lag-1 pairwise TE (no conditioning on other cells — Schreiber
//     bivariate TE, not the multivariate/causation-entropy variant); n=4 small.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-life-seq/HEXAD/IIT4/lib/iit4_eca.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }
fn nsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// transfer entropy TE(j->i) over the uniform 2^n state ensemble (lag-1, bivariate).
//   TE = Σ p(i',i,j) log2[ p(i'|i,j) / p(i'|i) ]   (i'=next bit of cell i)
fn te_j_to_i(tpm: array, n: int, i: int, j: int) -> float {
    let full = iit4_pow2(n)
    // joint counts over (i'∈{0,1}, i∈{0,1}, j∈{0,1}) → index = 4*ip + 2*ic + jc
    let mut c = [0,0,0,0,0,0,0,0]
    let mut s = 0
    while s < full {
        let ic = iit4_bit(s, i)
        let jc = iit4_bit(s, j)
        let mut ip = 0                                    // next bit of cell i (0/1)
        if tpm[s * n + i] > 0.5 { ip = 1 }
        let idx = 4 * ip + 2 * ic + jc
        c[idx] = c[idx] + 1
        s = s + 1
    }
    let tot = to_float(full)
    let mut te = 0.0
    let mut ip = 0
    while ip < 2 {
        let mut ic = 0
        while ic < 2 {
            let mut jc = 0
            while jc < 2 {
                let n_ipicjc = to_float(c[4*ip + 2*ic + jc])
                if n_ipicjc > 0.5 {
                    // p(i',i,j)
                    let p_joint = n_ipicjc / tot
                    // p(i'|i,j) = n(i',i,j) / n(i,j)
                    let n_icjc = to_float(c[0 + 2*ic + jc] + c[4 + 2*ic + jc])
                    let p_ip_given_icjc = n_ipicjc / n_icjc
                    // p(i'|i) = n(i',i) / n(i)
                    let n_ipic = to_float(c[4*ip + 2*ic + 0] + c[4*ip + 2*ic + 1])
                    let n_ic = to_float(c[0+2*ic+0]+c[0+2*ic+1]+c[4+2*ic+0]+c[4+2*ic+1])
                    let p_ip_given_ic = n_ipic / n_ic
                    if (p_ip_given_icjc > 0.0) && (p_ip_given_ic > 0.0) {
                        te = te + p_joint * log2(p_ip_given_icjc / p_ip_given_ic)
                    }
                }
                jc = jc + 1
            }
            ic = ic + 1
        }
        ip = ip + 1
    }
    return te
}

// total transfer entropy = Σ_i Σ_{j≠i} TE(j→i).
fn te_total(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let mut acc = 0.0
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            if j != i { acc = acc + te_j_to_i(tpm, n, i, j) }
            j = j + 1
        }
        i = i + 1
    }
    return acc
}

fn phi_mean(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut acc = 0.0
    let mut st = 0
    while st < full { acc = acc + big_phi(tpm, n, st)[0]; st = st + 1 }
    return acc / to_float(full)
}

fn pearson(xs: array, ys: array, m: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < m { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(m)
    let my = sy / to_float(m)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    i = 0
    while i < m {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        i = i + 1
    }
    if (vx < 0.000000000001) || (vy < 0.000000000001) { return 0.0 }
    return cov / nsqrt(vx * vy)
}
fn rank_of(xs: array, m: int, idx: int) -> float {
    let mut less = 0.0
    let mut eq = 0.0
    let mut i = 0
    while i < m {
        if xs[i] < xs[idx] - 0.000000001 { less = less + 1.0 }
        if approx(xs[i], xs[idx]) { eq = eq + 1.0 }
        i = i + 1
    }
    return less + (eq - 1.0) / 2.0
}
fn spearman(xs: array, ys: array, m: int) -> float {
    let mut rx = []
    let mut ry = []
    let mut i = 0
    while i < m { rx = rx.push(rank_of(xs, m, i)); ry = ry.push(rank_of(ys, m, i)); i = i + 1 }
    return pearson(rx, ry, m)
}

fn main() {
    let n = 4
    println("================================================================")
    println("  H_290 — Does faithful IIT4 big-Phi track TRANSFER ENTROPY?")
    println("  (TE_total = sum_{i,j!=i} TE(j->i) over uniform ensemble · Phi_mean = state-avg big-Phi)")
    println("================================================================")

    let rules = [0, 255, 204, 51, 150, 105, 90, 60, 110, 30]
    let m = 10
    let mut ts = []          // TE_total
    let mut ps = []          // Phi_mean
    let mut idx = 0
    while idx < m {
        let r = rules[idx]
        let te = te_total(r, n)
        let p = phi_mean(r, n)
        ts = ts.push(te)
        ps = ps.push(p)
        println("  rule " + str(r) + " : TE_total=" + str(te) + " bits   Phi_mean=" + str(p))
        idx = idx + 1
    }

    let r = pearson(ts, ps, m)
    let rho = spearman(ts, ps, m)
    println("  --")
    println("  F290.2: Pearson r(TE_total, Phi_mean)=" + str(r) + "   Spearman rho=" + str(rho))
    let h1_supported = r >= 0.5
    if h1_supported { println("          => H1 SUPPORTED (r>=0.5): Phi tracks transfer entropy (directed flow)") }
    else { println("          => H1 FALSIFIED (r<0.5): Phi does NOT track transfer entropy") }

    // ── F290.1 ANCHORS ──────────────────────────────────────────────────
    check("F290.1a ANCHOR: rule 0 (constant) TE_total = 0 (no flow)", approx(ts[0], 0.0))
    check("F290.1b ANCHOR: rule 0 (constant) Phi_mean = 0", approx(ps[0], 0.0))
    check("F290.1c ANCHOR: rule 255 (constant) TE_total = 0", approx(ts[1], 0.0))
    check("F290.1d ANCHOR: rule 204 (identity) TE_total = 0 (no inter-cell flow)", approx(ts[2], 0.0))
    check("F290.1e ANCHOR: rule 204 (identity) Phi_mean = 0", approx(ps[2], 0.0))

    // ── F290.3 FLOW-WITNESS (best integrating rule) ─────────────────────
    let mut best_te = ts[4]
    let mut bidx = 4
    let mut t = 5
    while t < m {
        if (ps[t] > 0.000001) && (ts[t] > best_te) { best_te = ts[t]; bidx = t }
        t = t + 1
    }
    println("  F290.3: integrating rule " + str(rules[bidx]) + " TE_total=" + str(best_te) + " Phi_mean=" + str(ps[bidx]))
    check("F290.3 FLOW-WITNESS: an integrating rule (Phi>0) has TE_total > 0", best_te > 0.000001)

    // ── F290.4 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < m {
        if !(ts[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(ps[b] >= 0.0 - 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F290.4 BOUND: TE_total >= 0 and Phi_mean >= 0 for all rules", bound_ok)

    // ── F290.5 DETERMINISM ──────────────────────────────────────────────
    let te110b = te_total(110, n)
    let p110b = phi_mean(110, n)
    check("F290.5 DETERMINISM: rule 110 (TE_total, Phi_mean) re-run identical", approx(ts[8], te110b) && approx(ps[8], p110b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  ARC: H_287 Shannon-entropy r=0.363 (perp) | H_288 LZ r=0.831 (parallel) | H_290 TE r=" + str(r))
    if h1_supported {
        println("  VERDICT: H1 SUPPORTED — Phi tracks transfer entropy (directed inter-cell flow).")
        println("           Phi aligns with FLOW/coupling measures (TE, LZ), not single-system entropy.")
    } else {
        println("  VERDICT: H1 FALSIFIED — Phi does NOT track transfer entropy.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_290 had FALSIFIER FAILURES (distinct from H1 verdict)") }
}
