// h349_sweep_robust.hexa — H_349 robustness sweep × multi-rule × multi-state
//
//   secondary check against (rule, sys_state) confounding:
//     rules: {90 (Class 3, chaos), 110 (Class 4, complex), 30 (Class 3, chaos)}
//     sys_state: cycle a few non-trivial states
//     n=4, same grid as primary

import "stdlib/consciousness/iit4_bigphi.hexa"

fn eca_tpm_inhibited(rule: int, n: int, I: float) -> array {
    let full = iit4_pow2(n)
    let p_fire = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            let b = iit4_bit(rule, idx)
            if b == 1 {
                t = t.push(p_fire)
            } else {
                t = t.push(0.0)
            }
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn sweep_one(rule: int, n: int, sys_state: int, I: float) {
    let tpm = eca_tpm_inhibited(rule, n, I)
    let r = big_phi(tpm, n, sys_state)
    println("ROW", rule, sys_state, I, r[0])
}

fn run_rule_state(rule: int, n: int, sys_state: int) {
    let grid = [0.05, 0.10, 0.15, 0.21, 0.25, 0.30, 0.35, 0.37, 0.40, 0.45, 0.50, 0.60, 0.75, 0.95]
    let mut k = 0
    while k < len(grid) {
        sweep_one(rule, n, sys_state, grid[k])
        k = k + 1
    }
}

fn main() {
    let n = 4
    println("# H_349 robust sweep · multi-rule × multi-state · n=", n)
    println("# 1/e =", 0.36787944117144233)

    // rule 90 (xor neighbours — Class 3 chaos)
    println("# --- rule 90, sys_state 5 ---")
    run_rule_state(90, n, 5)
    println("# --- rule 90, sys_state 3 ---")
    run_rule_state(90, n, 3)

    // rule 110 (Class 4 complex)
    println("# --- rule 110, sys_state 3 ---")
    run_rule_state(110, n, 3)

    // rule 30 (Class 3 chaos)
    println("# --- rule 30, sys_state 5 ---")
    run_rule_state(30, n, 5)

    println("# done")
}
