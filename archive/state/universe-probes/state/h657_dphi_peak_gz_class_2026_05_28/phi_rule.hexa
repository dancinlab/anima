// ════════════════════════════════════════════════════════════════════════════
//  phi_rule.hexa — H_657 per-rule Φ(I) shard (foreground, ≤60s budget)
//
//  Measures faithful big-Φ over the 13-point inhibition grid for a SINGLE
//  ECA rule (n=4, 16-state mean). Writes phi_rule_<RULE>.json with the Φ table.
//  The dΦ/dI / peak / delta-GZ / verdict aggregation is phi-free (aggregate.hexa).
//
//  Each rule = 13 grid × 16 states = 208 big_phi calls ≈ ~70s user; to stay
//  under the per-run wall budget each rule runs as its own foreground invocation.
//  (memory: exact-Φ wall shard pattern.)
//
//  RULE is selected by editing _rule() below (one shard file per rule via copy).
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h657/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _n() -> int { return 4 }
fn _rule() -> int { return RULE_PLACEHOLDER }

fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}

fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}

fn main() {
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]
    let m = len(grid)
    let rule = _rule()

    let mut phi = []
    let mut i = 0
    while i < m {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        println("rule " + str(rule) + " I=" + str(grid[i]) + " Φ=" + str(mp))
        i = i + 1
    }

    let mut s = "{\n  \"rule\": " + str(rule) + ",\n  \"n\": 4,\n  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { s = s + ", " }
        s = s + str(grid[gi])
        gi = gi + 1
    }
    s = s + "],\n  \"phi\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { s = s + ", " }
        s = s + str(phi[pi])
        pi = pi + 1
    }
    s = s + "]\n}\n"
    write_file("UNIVERSE/state/h657_dphi_peak_gz_class_2026_05_28/phi_rule_RULE_PLACEHOLDER.json", s)
    println("wrote phi_rule_RULE_PLACEHOLDER.json")
}
