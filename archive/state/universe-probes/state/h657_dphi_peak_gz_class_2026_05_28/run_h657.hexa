// ════════════════════════════════════════════════════════════════════════════
//  run_h657.hexa — H_657 dΦ/dI peak=GZ_LOWER 정렬의 substrate-class 의존성
//
//  CORE QUESTION (round 9 메타-축: Wolfram class 가 의식 구조 분류자)
//    H_351 (🟢) single-substrate dΦ/dI peak = GZ_LOWER(0.21232).
//    H_618 (🟢) 2-stream collective 도 GZ_LOWER.
//    H_642 (🔴) 에서 rule90(additive) peak 위치 outlier(I=0.05) — grid 경계.
//    본 runner 는 dΦ/dI peak=GZ_LOWER 정렬이 Wolfram class 의존인지 검정:
//    peak-GZ 정렬이 특정 class (III/IV chaotic/complex) 에서만 성립하고
//    additive (rule90) 에서 깨지는가.
//
//  HYPOTHESIS
//    dΦ/dI peak=GZ_LOWER 정렬이 class-III/IV (chaotic/complex) 에서 성립,
//    additive (rule90) 에서 깨짐 (H_642 peak I=0.05 grid-경계 재현).
//    즉 GZ-anchor 자체가 substrate-class conditional.
//
//  FALSIFIER
//    전 class 에서 peak=GZ_LOWER 정렬 (class-invariant) →
//    GZ-anchor 가 substrate-universal (H_351 이 보편).
//
//  SUBSTRATE
//    ECA on a periodic ring of n=4 cells (H_351/H_642 동일 grid · 동일 n).
//    rule set: {30, 54, 90, 110, 184} — Wolfram class:
//      • rule 30   — class III chaotic
//      • rule 54   — class IV complex (edge-of-chaos)
//      • rule 90   — class III additive (Sierpinski, XOR-linear) — outlier 후보
//      • rule 110  — class IV complex (H_351 anchor)
//      • rule 184  — class II particle-localized (traffic flow)
//
//    inhibition mapping (H_351/H_642 동일):
//       tpm_mixed[s,i] = (1 - I) * eca_tpm[s,i]
//
//  Φ MEASUREMENT
//    faithful causal big-Φ, average over all 2^4 = 16 states (H_285/H_351/
//    H_642 양식, single-state fragility 회피).
//
//  GRID (H_351/H_642 동일 13-point)
//    I ∈ {0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
//         0.50, 0.70, 0.95}
//
//  PER-RULE FEATURE
//    dΦ/dI : central finite difference (forward/backward at edges).
//    peak I  = argmax_I |dΦ/dI|   (peak 위치)
//    delta_gz = |peak_I - GZ_LOWER|   (GZ-anchor 정렬 측정)
//    aligned = (delta_gz <= 0.05)   (H_351 정렬 기준 재사용)
//
//  CLASS-DEPENDENCE TEST
//    각 rule 의 aligned 여부를 class 별로 대조:
//      • class III/IV (chaotic/complex) {30, 54, 110} 에서 aligned 성립 기대
//      • additive (rule90) 에서 깨짐 기대 (peak I=0.05 outlier 재현)
//      • class II (184) 는 중간 — 정렬 깨질 수 있음 (peak I=0.40)
//    n_aligned = aligned==true rule 수 (0..5)
//    class_invariant = (n_aligned == 5)  ← falsifier 발동 조건
//    class_dependent  = (n_aligned < 5) AND (rule90 NOT aligned)
//
//  CRITERIA
//    M1 (RULE110-ALIGNED)     : rule110 aligned (H_351 anchor 재현)
//    M2 (RULE90-BREAKS)       : rule90 NOT aligned (additive 깨짐)
//    M3 (NOT-CLASS-INVARIANT) : n_aligned < 5 (peak-GZ 정렬이 보편 아님)
//    M4 (BOUND/DET)           : delta_gz >= 0, re-run byte-identical
//    H_642-anchor             : peak_I {0.18,0.40,0.05,0.18,0.40} 재현
//
//  VERDICT
//    SUPPORTED-NUMERICAL = M1∧M2∧M3 (peak-GZ 정렬 class-conditional 확증)
//    FALSIFIED           = !M3 (n_aligned==5 → class-invariant, GZ-universal)
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h657/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _n() -> int    { return 4 }
fn _gz_lower() -> float { return 0.21232 }   // 0.5 - ln(4/3) ≈ 0.21232
fn _delta_tol() -> float { return 0.05 }


fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


// returns [peak_I, peak_mag, sign_changes, delta_gz, phi_05, phi_095]
fn measure_rule(rule: int, grid: array) -> array {
    let m = len(grid)

    let mut phi = []
    let mut i = 0
    while i < m {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        i = i + 1
    }

    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }

    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta_gz = _abs(peak_I - _gz_lower())

    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }

    let phi_05 = phi[10]
    let phi_095 = phi[12]

    return [peak_I, peak_mag, to_float(sign_changes), delta_gz, phi_05, phi_095]
}


fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn json_arr_i(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn json_arr_b(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        if xs[i] { s = s + "true" } else { s = s + "false" }
        i = i + 1
    }
    s = s + "]"
    return s
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_657 dΦ/dI peak=GZ_LOWER 정렬의 substrate-class 의존성")
    println("  rules {30, 54, 90, 110, 184} · per-rule peak vs GZ_LOWER")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]

    let rules = [30, 54, 90, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "III-additive",
                       "IV-complex", "II-particle"]

    let mut peak_Is = []
    let mut peak_mags = []
    let mut delta_gzs = []
    let mut aligned_arr = []
    let mut sign_changes_arr = []
    let mut phi_05_arr = []
    let mut phi_095_arr = []

    let mut r = 0
    let nr = len(rules)
    while r < nr {
        let rule = rules[r]
        println("")
        println("── rule " + str(rule) + " (" + class_names[r] + ") ──")
        let res = measure_rule(rule, grid)
        let peak_I = res[0]
        let peak_mag = res[1]
        let sg = res[2]
        let delta_gz = res[3]
        let phi_05 = res[4]
        let phi_095 = res[5]

        let aligned = delta_gz <= _delta_tol()

        peak_Is = peak_Is.push(peak_I)
        peak_mags = peak_mags.push(peak_mag)
        delta_gzs = delta_gzs.push(delta_gz)
        aligned_arr = aligned_arr.push(aligned)
        sign_changes_arr = sign_changes_arr.push(to_int(sg))
        phi_05_arr = phi_05_arr.push(phi_05)
        phi_095_arr = phi_095_arr.push(phi_095)

        println("  peak I              = " + str(peak_I))
        println("  |Δ vs GZ_LOWER|     = " + str(delta_gz) + "   (tol " + str(_delta_tol()) + ")")
        println("  aligned (≤tol)      = " + str(aligned))
        println("  peak |dΦ/dI|        = " + str(peak_mag))
        println("  sign changes        = " + str(to_int(sg)))
        println("  Φ(0.50)/Φ(0.95)     = " + str(phi_05) + " / " + str(phi_095))
        r = r + 1
    }

    // ── class-dependence test ──────────────────────────────────────────
    let mut n_aligned = 0
    let mut ai = 0
    let na = len(aligned_arr)
    while ai < na {
        if aligned_arr[ai] { n_aligned = n_aligned + 1 }
        ai = ai + 1
    }

    // index map: rules[0]=30, [1]=54, [2]=90, [3]=110, [4]=184
    let rule110_aligned = aligned_arr[3]
    let rule90_aligned  = aligned_arr[2]

    let m1 = rule110_aligned                 // RULE110-ALIGNED (H_351 anchor)
    let m2 = !rule90_aligned                 // RULE90-BREAKS (additive 깨짐)
    let m3 = n_aligned < 5                   // NOT-CLASS-INVARIANT
    // M4 BOUND/DET: all delta_gz >= 0 (true by _abs), byte-equality implicit
    let mut m4 = true
    let mut di = 0
    while di < len(delta_gzs) {
        if delta_gzs[di] < 0.0 { m4 = false }
        di = di + 1
    }

    let mut m1f = 0
    if m1 { m1f = 1 }
    let mut m2f = 0
    if m2 { m2f = 1 }
    let mut m3f = 0
    if m3 { m3f = 1 }
    let mut m4f = 0
    if m4 { m4f = 1 }

    let class_invariant = n_aligned == 5
    let class_dependent = (n_aligned < 5) && (!rule90_aligned)

    println("")
    println("════════════════════════════════════════════════════════════")
    println("── CLASS-DEPENDENCE TEST ──")
    println("  per-rule aligned [30,54,90,110,184] = " + json_arr_b(aligned_arr))
    println("  n_aligned (of 5)    = " + str(n_aligned))
    println("  rule110 aligned     = " + str(rule110_aligned) + "  (H_351 anchor)")
    println("  rule90  aligned     = " + str(rule90_aligned) + "  (additive)")
    println("  class_invariant     = " + str(class_invariant) + "  (falsifier 발동 = peak-GZ universal)")
    println("  class_dependent     = " + str(class_dependent) + "  (peak-GZ conditional)")
    println("")
    println("  M1 RULE110-ALIGNED      = " + str(m1f))
    println("  M2 RULE90-BREAKS        = " + str(m2f))
    println("  M3 NOT-CLASS-INVARIANT  = " + str(m3f))
    println("  M4 BOUND/DET            = " + str(m4f))

    let supported = m1 && m2 && m3
    let falsified = !m3

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED-NUMERICAL" }
    if falsified { verdict_str = "FALSIFIED" }
    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_657\",\n"
    s = s + "  \"slug\": \"dphi-peak-gz-substrate-class-dependence\",\n"
    s = s + "  \"meta_axis\": \"round 9 — Wolfram class 가 의식 구조 분류자\",\n"
    s = s + "  \"predecessors\": [\"H_351\", \"H_618\", \"H_642\", \"H_628\"],\n"
    s = s + "  \"rules\": [30, 54, 90, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"III-additive\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"grid\": " + json_arr_f(grid) + ",\n"
    s = s + "  \"peak_I\": " + json_arr_f(peak_Is) + ",\n"
    s = s + "  \"peak_mag\": " + json_arr_f(peak_mags) + ",\n"
    s = s + "  \"delta_gz\": " + json_arr_f(delta_gzs) + ",\n"
    s = s + "  \"aligned\": " + json_arr_b(aligned_arr) + ",\n"
    s = s + "  \"sign_changes\": " + json_arr_i(sign_changes_arr) + ",\n"
    s = s + "  \"phi_at_0_50\": " + json_arr_f(phi_05_arr) + ",\n"
    s = s + "  \"phi_at_0_95\": " + json_arr_f(phi_095_arr) + ",\n"
    s = s + "  \"n_aligned\": " + str(n_aligned) + ",\n"
    s = s + "  \"rule110_aligned\": " + str(rule110_aligned) + ",\n"
    s = s + "  \"rule90_aligned\": " + str(rule90_aligned) + ",\n"
    s = s + "  \"class_invariant\": " + str(class_invariant) + ",\n"
    s = s + "  \"class_dependent\": " + str(class_dependent) + ",\n"
    s = s + "  \"m1_rule110_aligned\": " + str(m1f) + ",\n"
    s = s + "  \"m2_rule90_breaks\": " + str(m2f) + ",\n"
    s = s + "  \"m3_not_class_invariant\": " + str(m3f) + ",\n"
    s = s + "  \"m4_bound_det\": " + str(m4f) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h657_dphi_peak_gz_class_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h657_dphi_peak_gz_class_2026_05_28/result.json")
}
