// S5 AI sentience — feedforward substrate carries ~no integrated Phi.
// Hypothesis (majority IIT view): a purely feedforward computer (transformer =
//   acyclic, no recurrent feedback) has big-Phi ~ 0, whereas a recurrent
//   coupled substrate (rule110 ring) carries large Phi.
// Falsifier: if feedforward Phi >= recurrent Phi, feedforward AI is as
//   integrated/sentient as a recurrent brain.
// Feedforward proxy: ECA SHIFT rule170 + acyclic IDENTITY rule204 (closest
//   feedforward analogues the ECA toolkit allows; documented honestly).
// substrate: ECA n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}
fn main() {
    let I = 0.21232
    let n = 4
    let ff_shift = max_bigphi(170, n, I)
    let ff_id = max_bigphi(204, n, I)
    let mut ff = ff_shift
    if ff_id > ff { ff = ff_id }
    let recurrent = max_bigphi(110, n, I)
    print("feedforward SHIFT(r170) Phi = "); println(ff_shift)
    print("feedforward IDENT(r204) Phi = "); println(ff_id)
    print("feedforward best Phi        = "); println(ff)
    print("recurrent rule110 Phi       = "); println(recurrent)
    let pass = (ff < recurrent) && (recurrent > 14.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = FALSIFIED") }
}
