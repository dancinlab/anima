// UNIVERSE/state/h297_n5_bounded_phi_scale_2026_05_26/run_h297.hexa
//
//   H_297 — Scale-up to n=5: do the arc's diagnostic findings survive at larger
//   N, and is rule 90's reducibility an N-PARITY artifact?
//
//   QUESTION
//     The arc (H_287-296) used n=4 throughout. Three diagnostic facts anchored
//     it: (a) identity rule 204 = Phi=0, (b) integrating rules > 0,
//     (c) rule 90 = Phi_whole=0 (with multi-complex sub-parts, H_296). At n=4
//     rule 90's reducibility came from the EVEN-RING bipartite decoupling
//     (even/odd cells decouple). At n=5 (ODD ring), no clean bipartite split
//     exists → rule 90 may INTEGRATE instead. We test the scale-robustness of
//     each diagnostic and resolve whether rule 90's reducibility is N-parity
//     dependent or fundamental.
//
//   SEED-HYPOTHESIS H1 (TESTED)
//     At n=5 (bounded big-Phi): (a) identity 204 + constants 0/255 stay at
//     Phi=0; (b) integrating rule 60 or 110 stays Phi > 0; (c) rule 90 SHIFTS
//     to Phi > 0 (the n=4 reducibility was an even-N bipartite artifact,
//     consistent with H_289's parity-even-cycle decoupling finding).
//
//   METHOD (reuse HEXAD/IIT4/lib — g61)
//     • eca_tpm(rule, 5) builds the n=5 ring TPM (2^5=32 states).
//     • big_phi_bounded(tpm, 5, st, cap) approximates big-Phi with purview-size
//       cap (cap < n ⇒ lower bound; cap = n ⇒ exact). We use cap=4 for n=5 —
//       the strongest practical bound short of exact.
//     • Compare directly with n=4 baseline (Phi at the representative state).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26, BEFORE measuring)
//     F297.1 SCALE-ANCHORS — at n=5 identity 204 bounded Phi = 0 AND
//            constant rule 0 bounded Phi = 0.
//     F297.2 INTEGRATION-SURVIVES — at n=5 rule 60 OR 110 bounded Phi > 0
//            (integration is not an n=4 artifact).
//     F297.3 RULE90-N-PARITY (the headline) — at n=5 rule 90 bounded Phi > 0,
//            i.e. on an ODD ring the even/odd bipartite decoupling fails and
//            rule 90 integrates. (If Phi=0 instead, the reducibility is deeper
//            than n-parity — also a clean finding.)
//     F297.4 BOUND — all values ≥ 0.
//     F297.5 DETERMINISM — rule 90 n=5 bounded Phi re-run identical.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope: bounded big-Phi (cap=4) is a LOWER bound at n=5; the binary
//     classification (=0 vs >0) is robust to that bound — exact value is not.
//     Single representative state per n; full state-sweep deferred.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-c35/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// state-averaged bounded big-Phi over all 2^n states (n=5: 32 states, manageable).
fn phi_b_mean(rule: int, n: int, cap: int) -> float {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut acc = 0.0
    let mut st = 0
    while st < full {
        let r = big_phi_bounded(tpm, n, st, cap)
        acc = acc + r[0]
        st = st + 1
    }
    return acc / to_float(full)
}

fn main() {
    let n5 = 5
    let cap = 4                                          // bounded purview cap (n-1 for n=5)
    let st5 = 21                                         // 10101 representative state for n=5
    println("================================================================")
    println("  H_297 — n=5 bounded big-Phi scale-up (cap=" + str(cap) + ", state 10101 + ensemble)")
    println("================================================================")

    let rules = [0, 255, 204, 51, 150, 105, 90, 60, 110, 30]
    let m = 10
    let mut idx = 0
    println("  per-rule  (single state st=21,10101)")
    while idx < m {
        let r = rules[idx]
        let tpm5 = eca_tpm(r, n5)
        let bp = big_phi_bounded(tpm5, n5, st5, cap)
        println("    rule " + str(r) + " : bounded big-Phi(n=5, state=21, cap=" + str(cap) + ") = " + str(bp[0]))
        idx = idx + 1
    }
    println("  --")

    // headline single-state values for falsifier evaluation
    let tpm204 = eca_tpm(204, n5)
    let tpm0 = eca_tpm(0, n5)
    let tpm60 = eca_tpm(60, n5)
    let tpm110 = eca_tpm(110, n5)
    let tpm90 = eca_tpm(90, n5)
    let tpm150 = eca_tpm(150, n5)
    let bp204 = big_phi_bounded(tpm204, n5, st5, cap)[0]
    let bp0   = big_phi_bounded(tpm0,   n5, st5, cap)[0]
    let bp60  = big_phi_bounded(tpm60,  n5, st5, cap)[0]
    let bp110 = big_phi_bounded(tpm110, n5, st5, cap)[0]
    let bp90  = big_phi_bounded(tpm90,  n5, st5, cap)[0]
    let bp150 = big_phi_bounded(tpm150, n5, st5, cap)[0]

    println("  rule 90 / rule 60 comparison (n=5 vs n=4):")
    let tpm90_n4 = eca_tpm(90, 4)
    let tpm60_n4 = eca_tpm(60, 4)
    let bp90_n4  = big_phi(tpm90_n4, 4, 5)[0]
    let bp60_n4  = big_phi(tpm60_n4, 4, 5)[0]
    println("    rule 90 n=4 (exact, state 5)  = " + str(bp90_n4))
    println("    rule 90 n=5 (cap=" + str(cap) + ", state 21) = " + str(bp90))
    println("    rule 60 n=4 (exact, state 5)  = " + str(bp60_n4))
    println("    rule 60 n=5 (cap=" + str(cap) + ", state 21) = " + str(bp60))

    // ── F297.1 SCALE-ANCHORS ────────────────────────────────────────────
    check("F297.1a SCALE-ANCHOR: rule 204 (identity) bounded Phi = 0 at n=5", approx(bp204, 0.0))
    check("F297.1b SCALE-ANCHOR: rule 0 (constant) bounded Phi = 0 at n=5", approx(bp0, 0.0))

    // ── F297.2 INTEGRATION-SURVIVES ─────────────────────────────────────
    check("F297.2 INTEGRATION-SURVIVES: rule 60 OR rule 110 bounded Phi > 0 at n=5", (bp60 > 0.000001) || (bp110 > 0.000001))

    // ── F297.3 RULE90-N-PARITY (HEADLINE) ───────────────────────────────
    let parity_witnessed = bp90 > 0.000001
    let mut tag90 = " (still 0 — deeper reducibility)"
    if parity_witnessed { tag90 = " (>0 — N-PARITY effect confirmed)" }
    println("  F297.3: rule 90 at n=4 Phi=" + str(bp90_n4) + " (=0) vs n=5 Phi=" + str(bp90) + tag90)
    check("F297.3 RULE90-N-PARITY: rule 90 bounded Phi > 0 at n=5 (n-parity hypothesis)", parity_witnessed)

    // ── F297.4 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    if !(bp204 >= 0.0 - 0.000001) { bound_ok = false }
    if !(bp0 >= 0.0 - 0.000001) { bound_ok = false }
    if !(bp60 >= 0.0 - 0.000001) { bound_ok = false }
    if !(bp110 >= 0.0 - 0.000001) { bound_ok = false }
    if !(bp90 >= 0.0 - 0.000001) { bound_ok = false }
    if !(bp150 >= 0.0 - 0.000001) { bound_ok = false }
    check("F297.4 BOUND: all bounded Phi >= 0 at n=5", bound_ok)

    // ── F297.5 DETERMINISM ──────────────────────────────────────────────
    let bp90b = big_phi_bounded(eca_tpm(90, n5), n5, st5, cap)[0]
    check("F297.5 DETERMINISM: rule 90 bounded Phi at n=5 re-run identical", approx(bp90, bp90b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if parity_witnessed {
        println("  FINDING: rule 90's reducibility is an EVEN-N BIPARTITE artifact —")
        println("           at n=5 (odd ring), the even/odd decoupling fails and rule 90")
        println("           integrates (Phi>0). H_296's multi-complex split was specifically")
        println("           the 4-cycle bipartite structure. Scale changes the answer.")
    } else {
        println("  FINDING: rule 90 stays Phi=0 even at n=5 (odd ring) — the reducibility")
        println("           is deeper than n-parity; rule 90's XOR-of-neighbours is structurally")
        println("           integration-killing across N.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_297 had FALSIFIER FAILURES (distinct from H1 verdict on rule 90)") }
}
