// UNIVERSE/state/h315_pruning_weak_edge_phi_retention_2026_05_27/run.hexa
// ════════════════════════════════════════════════════════════════════════════
// H_315 — PRUNING × IIT4-Φ : does pruning the WEAKEST EDGES (connections) of a
//          network substrate preserve integrated information Φ BETTER than
//          pruning random or strongest edges?
//
//   DISTINCTION FROM H_312 (already closed-negative)
//     H_312 = APOPTOSIS = removing NODES (cells), shrinking the subsystem mask.
//     H_315 = PRUNING   = removing EDGES (connections), KEEPING ALL n nodes.
//     The substrate stays n-cell; what changes is WHICH neighbour inputs each
//     cell reads. This is synaptic pruning, not cell death — a different axis.
//
//   HYPOTHESIS (H1, falsifiable)
//     Synaptic pruning sheds weak connections while preserving integration.
//     Claim: SELECTIVELY pruning the WEAKEST edges of an IIT 4.0 substrate
//     preserves big-Φ BETTER (higher Φ-retention curve) than pruning RANDOM
//     edges or STRONGEST edges, across a panel and across prune fractions.
//   FALSIFIER (pre-registered)
//     If weakest-first pruning does NOT preserve Φ better than random-first
//     pruning across the panel (mean Φ-retention AUC of weak ≤ that of random,
//     OR weak loses the per-substrate head-to-head on the majority), H1 is
//     FALSIFIED. Secondary: characterise graceful-degradation vs cliff (Φ vs
//     fraction-pruned).
//
//   SUBSTRATE & EDGES
//     ECA ring of n cells. Cell i's next state is determined by the rule lookup
//     over its 3-cell neighbourhood (L=i-1, C=i, R=i+1). The DIRECTED EDGES are
//     the neighbour dependencies (j → i): which neighbour positions actually
//     influence cell i's output. There are up to 3n candidate edges (each cell
//     has L/C/R inputs). The PRESENT edges are those that genuinely matter — an
//     edge (pos→i) is present iff flipping that neighbour changes cell i's next
//     value for at least one neighbourhood configuration (effective edge).
//
//   EDGE WEIGHT (measurable per-edge influence — NOT hardcoded)
//     weight(pos → i) = (1/2^n) Σ_s  [ nextbit(i|s) ≠ nextbit(i|s with pos flipped) ]
//     i.e. the average-sensitivity (activity / influence) of input `pos` on
//     cell i's deterministic output over all 2^n global states. weight 0 ⇒ the
//     edge does not exist (canalised / ignored input). High weight ⇒ strong
//     connection. This is the standard Boolean-network edge-activity measure.
//
//   PRUNING AN EDGE (rebuild TPM, keep all nodes)
//     Pruning edge (pos → i) means cell i no longer reads neighbour `pos`: when
//     computing cell i's next value we substitute a FIXED 0 for that neighbour
//     bit in the rule-lookup index. All n cells remain; only i's input wiring
//     shrinks. Pruning K edges = rebuild the n-cell TPM with K (pos,i) inputs
//     forced to 0, then recompute the faithful big-Φ on the FULL n-cell system.
//
//   THREE PRUNE ORDERINGS (over the present effective edges, ascending fraction)
//     weak  : prune in ASCENDING weight order  (weakest edge first)
//     strong: prune in DESCENDING weight order (strongest edge first)
//     random: prune in a FIXED-SEED permutation order (deterministic shuffle)
//     After each prune step, recompute big-Φ(full n-cell system) and report the
//     RETENTION = Φ_pruned / Φ_0  (Φ_0 = unpruned big-Φ). H1 ⇔ the weak curve
//     dominates the random curve (and ideally the strong curve).
//
//   DETERMINISTIC · hexa-only · llm:none · $0 mac/pool. n ≤ 4 (exact Φ tractable,
//   2^n ≤ 16 states, cross-process byte-identical). Reuses the IIT 4.0 stdlib
//   engine — Φ is NOT reinvented (memory: H_280 reinvented IIT4 and got it
//   wrong). The outcome COULD genuinely falsify (weak-first might not beat
//   random) — this is a real measurement, not a tautology (g73).
//
//   ENGINE (REUSED, not reinvented):
//     stdlib/consciousness/iit4_bigphi.hexa   (big_phi faithful causal chain)
//     stdlib/consciousness/iit4_tpm.hexa      (iit4_pow2, iit4_bit primitives)
//     stdlib/core/math/rng.hexa               (lcg_next — fixed-seed shuffle; g61)
//     ECA rule semantics re-derived here as a PRUNABLE TPM builder (HEXAD/IIT4/
//     lib/iit4_eca.hexa's eca_tpm is the unprunable form; we need force-0 inputs).
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/core/math/rng.hexa"

// ── ECA next-bit of cell i, given which neighbour positions are PRUNED ───────
// pos encoding: 0 = left(i-1), 1 = centre(i), 2 = right(i+1).
// pruned[i*3 + pos] == 1 ⇒ that edge is pruned ⇒ the neighbour bit is forced to
// 0 in the rule-lookup index for cell i.
fn eca_next_bit(rule: int, n: int, s: int, i: int, pruned: array) -> int {
    let lpos = (i - 1 + n) % n
    let cpos = i
    let rpos = (i + 1) % n
    let mut l = iit4_bit(s, lpos)
    let mut c = iit4_bit(s, cpos)
    let mut r = iit4_bit(s, rpos)
    if pruned[i * 3 + 0] == 1 { l = 0 }
    if pruned[i * 3 + 1] == 1 { c = 0 }
    if pruned[i * 3 + 2] == 1 { r = 0 }
    let idx = 4 * l + 2 * c + r                       // Wolfram neighbourhood index 0..7
    return iit4_bit(rule, idx)
}

// build the state-by-node TPM for `rule` on n cells under a given pruned-edge set.
fn pruned_tpm(rule: int, n: int, pruned: array) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            t = t.push(to_float(eca_next_bit(rule, n, s, i, pruned)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// edge weight: average sensitivity of cell i's output to neighbour position pos,
// under the CURRENT pruned set. Flip the raw neighbour bit in the global state
// and measure output change, holding other prunings fixed.
fn edge_weight(rule: int, n: int, i: int, pos: int, pruned: array) -> float {
    let full = iit4_pow2(n)
    let mut readpos = i
    if pos == 0 { readpos = (i - 1 + n) % n }
    if pos == 2 { readpos = (i + 1) % n }
    let mut diff = 0
    let mut s = 0
    while s < full {
        let a = eca_next_bit(rule, n, s, i, pruned)
        let s2 = s ^ iit4_pow2(readpos)               // flip the neighbour bit
        let b = eca_next_bit(rule, n, s2, i, pruned)
        if a != b { diff = diff + 1 }
        s = s + 1
    }
    return to_float(diff) / to_float(full)
}

// big-Φ of the FULL n-cell system under TPM (no subsystem masking — all nodes).
fn whole_phi(tpm: array, n: int, sys_state: int) -> float {
    let r = big_phi(tpm, n, sys_state)
    return r[0]
}

// deterministic fixed-seed Fisher-Yates over [0,m) using stdlib lcg_next (g61).
fn shuffle_indices(m: int, seed: int) -> array {
    let mut order = []
    let mut a = 0
    while a < m { order = order.push(a); a = a + 1 }
    let mut st = lcg_next(seed & 4294967295)
    let mut k = m - 1
    while k > 0 {
        st = lcg_next(st)
        let j = st % (k + 1)
        let tmp = order[k]
        order[k] = order[j]
        order[j] = tmp
        k = k - 1
    }
    return order
}

// prune the present edges in `order`, one at a time; print Φ + retention each
// step. AUC = mean retention over the prune fractions (deterministic fn of the
// measured Φs). Returns the AUC for the head-to-head verdict comparison.
fn run_ordering(name: string, label: string, rule: int, n: int, sys: int, phi0: float, m: int, edge_i: array, edge_pos: array, order: array) -> float {
    // fresh unpruned set.
    let nedge_slots = n * 3
    let mut pruned = []
    let mut z = 0
    while z < nedge_slots { pruned = pruned.push(0); z = z + 1 }

    let mut auc_sum = 0.0
    let mut steps = 0
    let mut line = "  CURVE " + name + " " + label + " retention="
    let mut k = 0
    while k < m {
        let e = order[k]
        let ci = edge_i[e]
        let cp = edge_pos[e]
        pruned[ci * 3 + cp] = 1                        // prune this edge
        let tpm = pruned_tpm(rule, n, pruned)
        let phi = whole_phi(tpm, n, sys)
        let mut retv = 0.0
        if phi0 > 0.0000000001 { retv = phi / phi0 } else { retv = 0.0 }
        line = line + to_string(retv)
        if k < m - 1 { line = line + "," }
        auc_sum = auc_sum + retv
        steps = steps + 1
        k = k + 1
    }
    let mut auc = 0.0
    if steps > 0 { auc = auc_sum / to_float(steps) }
    println(line)
    println("  AUC " + name + " " + label + " auc=" + to_string(auc))
    return auc
}

// run one substrate: enumerate present edges, build 3 orderings, prune, measure.
fn run_substrate(label: string, rule: int, n: int, sys: int) {
    let nedge_slots = n * 3
    let mut none_pruned = []
    let mut z = 0
    while z < nedge_slots { none_pruned = none_pruned.push(0); z = z + 1 }

    // enumerate PRESENT (effective) edges + their baseline weights.
    let mut edge_i = []
    let mut edge_pos = []
    let mut edge_w = []
    let mut i = 0
    while i < n {
        let mut p = 0
        while p < 3 {
            let w = edge_weight(rule, n, i, p, none_pruned)
            if w > 0.0000000001 {
                edge_i = edge_i.push(i)
                edge_pos = edge_pos.push(p)
                edge_w = edge_w.push(w)
            }
            p = p + 1
        }
        i = i + 1
    }
    let m = len(edge_i)

    let tpm0 = pruned_tpm(rule, n, none_pruned)
    let phi0 = whole_phi(tpm0, n, sys)

    println("PANEL " + label + " n=" + to_string(n) + " sys=" + to_string(sys) + " rule=" + to_string(rule))
    println("  present_edges=" + to_string(m) + " phi0=" + to_string(phi0))

    // build weak ordering: ascending weight (stable selection sort by index).
    let mut weak_order = []
    let mut used = []
    let mut u = 0
    while u < m { used = used.push(0); u = u + 1 }
    let mut picked = 0
    while picked < m {
        let mut best = -1
        let mut bestw = 1.0e308
        let mut e = 0
        while e < m {
            if used[e] == 0 {
                if edge_w[e] < bestw - 0.0000000001 {
                    bestw = edge_w[e]; best = e
                }
            }
            e = e + 1
        }
        weak_order = weak_order.push(best)
        used[best] = 1
        picked = picked + 1
    }
    // strong = reverse of weak.
    let mut strong_order = []
    let mut rr = m - 1
    while rr >= 0 { strong_order = strong_order.push(weak_order[rr]); rr = rr - 1 }
    // random = fixed seed (deterministic, derived from rule/n; identical across runs).
    let rand_order = shuffle_indices(m, 777 + rule + n)

    let auc_w = run_ordering("weak",   label, rule, n, sys, phi0, m, edge_i, edge_pos, weak_order)
    let auc_s = run_ordering("strong", label, rule, n, sys, phi0, m, edge_i, edge_pos, strong_order)
    let auc_r = run_ordering("random", label, rule, n, sys, phi0, m, edge_i, edge_pos, rand_order)

    // verdict-relevant per-substrate booleans (machine-greppable):
    let weak_beats_random = auc_w > auc_r + 0.0000000001
    let weak_beats_strong = auc_w > auc_s + 0.0000000001
    println("  CELL_RESULT weak_auc=" + to_string(auc_w) + " random_auc=" + to_string(auc_r) + " strong_auc=" + to_string(auc_s) + " weak_beats_random=" + to_string(weak_beats_random) + " weak_beats_strong=" + to_string(weak_beats_strong))
    println("")
}

fn main() {
    println("H_315 — PRUNING × IIT4-Φ : prune WEAK vs RANDOM vs STRONG edges, measure Φ-retention")
    println("  edges = ECA neighbour dependencies (j→i); prune = force-0 that input, KEEP all nodes")
    println("  weight = avg output-sensitivity; engine = stdlib iit4_bigphi (REUSED, not reinvented)")
    println("  FALSIFIER: weak Φ-retention AUC NOT > random AUC across panel ⇒ H1 FALSIFIED")
    println("")

    // PANEL: ECA rules × n × fixed sys_state (deterministic; mirrors H_312).
    run_substrate("eca90",  90,  4, 11)
    run_substrate("eca110", 110, 4, 11)
    run_substrate("eca30",  30,  4, 11)
    run_substrate("eca54",  54,  4, 11)
    run_substrate("eca150", 150, 4, 11)
    run_substrate("eca22",  22,  4, 11)
    run_substrate("eca60",  60,  4, 11)
    run_substrate("eca105", 105, 4, 11)
    run_substrate("eca90_n3",  90,  3, 5)
    run_substrate("eca110_n3", 110, 3, 5)

    println("DONE")
}
