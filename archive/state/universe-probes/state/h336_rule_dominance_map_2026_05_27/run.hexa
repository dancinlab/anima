// H_336 — full rule×rule attractor-dominance map (n=4)
// For every ordered pair (A,B) of {30,110,105,150}, run phase-1 ruleA x20 then
// phase-2 ruleB x20, and measure whether the final distribution locks to the
// ruleA attractor (d to A-baseline == 0 = A dominates / "A locks B out") or
// escapes to the ruleB attractor.
//
// H1: dominance is a PARTIAL ORDER (some rules consistently lock others; not all
//     pairs symmetric). Falsifier: every pair escapes to phase-2 (no dominance,
//     d_to_A always large) OR every pair locks to phase-1 (trivial, A always
//     wins regardless of B).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

fn hist_2phase(ra: int, rb: int, hist: int) {
    let mut s0 = 0
    while s0 < 16 {
        let mut s = s0
        let mut t = 0
        while t < 20 { s = next4(s, ra); t = t + 1 }
        let mut u = 0
        while u < 20 { s = next4(s, rb); u = u + 1 }
        let cur = to_int(farr_get(hist, s))
        let _ = farr_set(hist, s, to_float(cur + 1))
        s0 = s0 + 1
    }
}

fn hist_1phase(r: int, hist: int) {
    let mut s0 = 0
    while s0 < 16 {
        let mut s = s0
        let mut t = 0
        while t < 40 { s = next4(s, r); t = t + 1 }
        let cur = to_int(farr_get(hist, s))
        let _ = farr_set(hist, s, to_float(cur + 1))
        s0 = s0 + 1
    }
}

fn dist(h1: int, h2: int) -> float {
    let mut d = 0.0
    let mut i = 0
    while i < 16 {
        let p1 = to_float(to_int(farr_get(h1, i))) / 16.0
        let p2 = to_float(to_int(farr_get(h2, i))) / 16.0
        let diff = if p1 > p2 { p1 - p2 } else { p2 - p1 }
        d = d + diff
        i = i + 1
    }
    return d
}

// returns 1 if phase-1 (A) locks (final == A-baseline), 0 if escapes to B, 2 if neither
fn pair_outcome(ra: int, rb: int) -> int {
    let hyb = farr_zeros(16)
    hist_2phase(ra, rb, hyb)
    let ba = farr_zeros(16)
    hist_1phase(ra, ba)
    let bb = farr_zeros(16)
    hist_1phase(rb, bb)
    let dA = dist(hyb, ba)
    let dB = dist(hyb, bb)
    let _ = farr_free(hyb); let _ = farr_free(ba); let _ = farr_free(bb)
    if dA < 0.01 { return 1 }       // locked to phase-1 A
    if dB < 0.01 { return 0 }       // escaped to phase-2 B
    return 2                        // mixed / neither
}

fn main() {
    println("H_336 rule×rule attractor-dominance map (n=4)")
    let rules = farr_zeros(4)
    let _ = farr_set(rules, 0, 30.0)
    let _ = farr_set(rules, 1, 110.0)
    let _ = farr_set(rules, 2, 105.0)
    let _ = farr_set(rules, 3, 150.0)
    println("outcome: 1=phase1(A)-locks  0=phase2(B)-wins  2=mixed")
    let mut a_locks = 0
    let mut b_wins = 0
    let mut mixed = 0
    let mut i = 0
    while i < 4 {
        let mut j = 0
        while j < 4 {
            if i != j {
                let ra = to_int(farr_get(rules, i))
                let rb = to_int(farr_get(rules, j))
                let o = pair_outcome(ra, rb)
                println("A=" + str(ra) + " B=" + str(rb) + " outcome=" + str(o))
                if o == 1 { a_locks = a_locks + 1 }
                if o == 0 { b_wins = b_wins + 1 }
                if o == 2 { mixed = mixed + 1 }
            }
            j = j + 1
        }
        i = i + 1
    }
    println("totals: A_locks=" + str(a_locks) + " B_wins=" + str(b_wins) + " mixed=" + str(mixed) + " (of 12 ordered pairs)")
    println("done")
}
