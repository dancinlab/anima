// ════════════════════════════════════════════════════════════════════════════
//  run_burst.hexa — H_053 Cambrian Explosion Consciousness — burst smoke
//
//  PURPOSE
//    UNIVERSE H_053 pre-register-frozen 검증 smoke. cell-pool mitosis
//    substrate (tool/hexa_native/mitosis_hook_lib.hexa) 의 split predicate
//    threshold 를 sweep 하면서 다음을 측정:
//      (a) sweep level 별 mean n_final (over N_REPS reps)
//      (b) sweep level 별 mean cell-type diversity proxy (hidden-signature
//          hash bucket 의 unique 수, mean over reps)
//      (c) 인접 sweep 점간 mean-diversity 의 max relative jump
//          (Cambrian "폭발" = sharp transition vs smooth gradient)
//
//    가설 테마: substrate parameter 가 critical threshold 를 가로지를 때
//    cell-type diversity 가 점진적이 아닌 **갑작스런 폭발 (punctuated jump)**
//    로 emerge 하는가? — Cambrian explosion (Gould punctuated equilibrium) +
//    Wolfram edge-of-chaos / Langton λ critical regime 의 substrate-mechanism
//    유비.
//
//  SWEEP MECHANISM (raw#9/10 HONEST)
//    mitosis_hook_lib 의 _mit_update_adaptive_threshold 가 매 step 끝에
//    split_threshold 를 mean+1.5σ 로 재계산한다. 우리는 매 step 시작 시
//    pool["split_threshold"] 를 sweep level 로 강제 override → 자동 적응을
//    무력화하고 split predicate (tension > thr for `patience` 연속) 의
//    임계 종속성을 단독 변수로 측정한다. 이는 substrate primitive 의
//    값 override 일 뿐 mechanism 수정이 아님 (read-only import 보존).
//
//  DIVERSITY METRIC (raw#9/10 HONEST)
//    각 cell 의 hidden vector → sign(h[i]) 의 d_model-bit binary signature
//    → 첫 signature_bits 비트 (=d_model 까지) 를 hash bucket 으로 사용 →
//    run 종료 시 unique bucket 수 = "cell-type diversity proxy". 이는
//    weight-cluster 가 아닌 hidden-signature cluster — Lorenz 자율 교란 +
//    누적 split noise 가 벡터 부호 패턴을 얼마나 분기시켰는지의 거친
//    측정. 실제 생물 종 분기 metric 이 아니다 (Honest Limits L1, L4 참조).
//
//  N_REPS AVERAGING (raw#9/10 HONEST — gauss RNG 한계 회피)
//    `__HEXA_FARR_GAUSS_SEED__` 는 process-local 1회 seed 후 monotonic 전진
//    (self/runtime.c:7193+). hexa 가 RNG reset primitive 를 노출하지 않으므로
//    same-level 재호출이 byte-identical 불가. 따라서 sweep 의 각 level 을
//    N_REPS=3 회 반복하고 mean n_final / mean diversity 로 verdict 형성 ―
//    chaotic seed drift 가 단일-rep 변동성을 mean 로 평탄화. 결정성은
//    process-level 에서 검증 (run_burst.hexa 를 2회 invoke → result.json
//    byte-identical 확인은 외부 harness; 본 process 내부에서는 N_REPS mean
//    의 안정성 = CV ≤ cv_floor 으로 측정 / F-BURST-5).
//
//  DETERMINISM (process boundary)
//    __HEXA_FARR_GAUSS_SEED__=42 → 동일 invoke 의 모든 RNG draw 가 동일
//    sequence. 2회 외부 invoke 는 동일 process initial seed 로부터 동일
//    sequence → result.json byte-identical. LLM none. $0 mac local.
//
//  RUN
//    /Users/ghost/core/hexa-lang/hexa parse <this>
//    __HEXA_FARR_GAUSS_SEED__=42 HEXA_MEM_UNLIMITED=1 \
//        /Users/ghost/core/hexa-lang/hexa run <this>
//
//  FALSIFIERS (raw#12 ≥5, measurable)
//    F-BURST-1 LOW-THR-GROWS         : 가장 낮은 sweep level 의 mean n_final
//                                       > 초기 cell 수 (저임계 = 분열 활성).
//    F-BURST-2 FROZEN-ZONE-EXISTS    : sweep 상 ≥1 점에서 mean n_final ==
//                                       초기 cell 수 (어떤 thr 에서는 분열
//                                       0 회 = "frozen" zone 존재).
//    F-BURST-3 DIVERSITY-RANGE       : sweep 전체에서 max(mean diversity) -
//                                       min(mean diversity) ≥ range_floor
//                                       (substrate 가 thr 에 반응함).
//    F-BURST-4 BURST-JUMP            : 인접 sweep 점간 mean diversity 의
//                                       max relative jump ≥ jump_ratio_floor
//                                       (sharp transition 존재 = Cambrian
//                                       punctuated equilibrium 정합).
//    F-BURST-5 REP-STABILITY         : 모든 sweep level 에서 N_REPS rep 들의
//                                       n_final CV (std/|mean|) ≤ cv_floor
//                                       (rep-level chaotic drift 가 mean 을
//                                       못 흔들 만큼 안정 = mean-trajectory
//                                       가 thr 함수로 의미 있음).
//
//  VERDICT_RULE
//    SUPPORTED (Cambrian-like burst) = F-BURST-1..5 모두 PASS, AND
//                                       max_jump_ratio ≥ jump_ratio_floor
//                                       (sharp transition 검출).
//    PARTIAL                         = 3-4/5 PASS, 특히 F-BURST-4 단독 FAIL
//                                       이면 smooth growth (no burst).
//    FALSIFIED (no burst, gradual)   = ≤2/5 PASS — substrate 가 thr 에
//                                       의미 있게 반응 안 함, 가설 미지지.
//
//  COMPLIANCE  raw#11 snake_case · raw#15 no-hardcode (sweep array · seed ·
//              n_reps · floors 모두 명시) · raw#9/10 honest operational
//              metric · raw#12 deterministic (process boundary)
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/.claude/worktrees/agent-a0f5808c30277181c/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a0f5808c30277181c/UNIVERSE/state/h053_cambrian_2026_05_23"
}
fn _d_model() -> int { return 8 }
fn _initial_cells() -> int { return 4 }
fn _n_steps() -> int { return 40 }
fn _n_reps() -> int { return 3 }
fn _signature_bits() -> int { return 8 }             // d_model=8 까지 모두 사용.
fn _jump_ratio_floor() -> float { return 2.0 }       // 인접 점간 mean-diversity 가
                                                      // 최소 2× 점프 = sharp transition.
fn _range_floor() -> float { return 3.0 }            // sweep 전체 diversity max-min
                                                      // ≥ 3 = substrate 가 thr 에 반응.
fn _cv_floor() -> float { return 0.75 }              // rep-level CV ≤ 0.75 = mean
                                                      // 이 trajectory shape 을 가짐.


// 고정 sweep — split_threshold 값 (저 → 고). 7 점 로그-스케일.
// 매우 낮은 thr (0.0) = 거의 모든 step 에서 split predicate true → 폭발 가능.
// 매우 높은 thr (1.0e6) = tension 이 절대 못 넘음 → 분열 0회 (frozen).
fn _sweep_levels() -> array {
    return [0.0, 0.01, 0.1, 1.0, 10.0, 100.0, 1000000.0]
}


// ── §1 helpers ───────────────────────────────────────────────────────────────

// 고정 synthetic final-hidden 입력 (d_model,) — 결정론적, ckpt 불필요.
fn _make_x(d: int) {
    let mut x = []
    let mut i = 0
    while i < d {
        x.push(sin((i * 1.0) * 0.37) * 0.5)
        i = i + 1
    }
    return x
}

// hidden vector → integer signature: 첫 signature_bits 비트의 sign 패턴.
fn _hidden_signature(h: array, bits: int) -> int {
    let n = if len(h) < bits { len(h) } else { bits }
    let mut sig = 0
    let mut i = 0
    while i < n {
        let bit = if h[i] >= 0.0 { 1 } else { 0 }
        sig = sig * 2 + bit
        i = i + 1
    }
    return sig
}

// cell 들의 hidden signature 집합 → unique bucket 수.
fn _count_unique_signatures(cells: array, bits: int) -> int {
    let mut seen = #{}
    let mut i = 0
    while i < len(cells) {
        let sig = _hidden_signature(cells[i]["hidden"], bits)
        let key = to_string(sig)
        seen[key] = 1
        i = i + 1
    }
    return len(keys(seen))
}

// mean of float array.
fn _mean_arr(a: array) -> float {
    let n = len(a)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + a[i]
        i = i + 1
    }
    return s / (n * 1.0)
}

// std (population) of float array.
fn _std_arr(a: array) -> float {
    let n = len(a)
    if n == 0 { return 0.0 }
    let m = _mean_arr(a)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = a[i] - m
        s = s + d * d
        i = i + 1
    }
    let v = s / (n * 1.0)
    if v <= 0.0 { return 0.0 }
    return sqrt(v)
}

// 한 rep — sweep level thr 로 K-step run → [n_final, diversity, n_splits].
fn _run_one_rep(thr_level: float, d: int, initial_cells: int, n_steps: int, sig_bits: int) -> array {
    let mut pool = cell_pool_init(d, initial_cells)
    let x = _make_x(d)

    let mut total_splits = 0
    let mut step = 0
    while step < n_steps {
        // override adaptive threshold pre-step — sweep 의 임계 종속성 단독 측정.
        pool["split_threshold"] = thr_level

        let r = mitosis_forward_tail(x, pool, step)
        pool = r[1]
        let events = r[2]

        // override post-step too — _mit_update_adaptive_threshold 가 직후
        // mean+1.5σ 로 덮어쓴 값을 다시 sweep 으로 강제 (다음 step 시작 시
        // 이미 override 가 다시 들어가나 명시성을 위해 유지).
        pool["split_threshold"] = thr_level

        let mut ei = 0
        while ei < len(events) {
            if events[ei]["type"] == "split" { total_splits = total_splits + 1 }
            ei = ei + 1
        }
        step = step + 1
    }

    let n_final = len(pool["cells"])
    let diversity = _count_unique_signatures(pool["cells"], sig_bits)
    return [n_final * 1.0, diversity * 1.0, total_splits * 1.0]
}


// ── §2 main burst driver ──────────────────────────────────────────────────────

fn _run_burst() {
    println("================================================================")
    println("H_053 Cambrian Explosion — burst smoke (host=mac local)")
    println("================================================================")

    let d = _d_model()
    let initc = _initial_cells()
    let nsteps = _n_steps()
    let nreps = _n_reps()
    let bits = _signature_bits()
    let levels = _sweep_levels()
    let nlev = len(levels)

    println("  d_model=" + to_string(d)
            + " initial_cells=" + to_string(initc)
            + " n_steps=" + to_string(nsteps)
            + " n_reps=" + to_string(nreps)
            + " sweep_levels=" + to_string(nlev)
            + " jump_ratio_floor=" + to_string(_jump_ratio_floor())
            + " range_floor=" + to_string(_range_floor())
            + " cv_floor=" + to_string(_cv_floor()))

    // sweep: 각 level 에 대해 N_REPS rep → mean / std.
    let mut mean_n_finals = []
    let mut mean_diversities = []
    let mut mean_splits = []
    let mut cv_n_finals = []
    let mut all_reps_n_finals = []  // 디버그 / result.json 보고용 (2D).
    let mut all_reps_diversities = []

    let mut k = 0
    while k < nlev {
        let mut reps_n = []
        let mut reps_div = []
        let mut reps_spl = []
        let mut rr = 0
        while rr < nreps {
            let r = _run_one_rep(levels[k], d, initc, nsteps, bits)
            reps_n.push(r[0])
            reps_div.push(r[1])
            reps_spl.push(r[2])
            rr = rr + 1
        }
        let mn = _mean_arr(reps_n)
        let md = _mean_arr(reps_div)
        let ms = _mean_arr(reps_spl)
        let sn = _std_arr(reps_n)
        let cv = if mn == 0.0 { 0.0 } else { sn / (if mn < 0.0 { 0.0 - mn } else { mn }) }
        mean_n_finals.push(mn)
        mean_diversities.push(md)
        mean_splits.push(ms)
        cv_n_finals.push(cv)
        all_reps_n_finals.push(reps_n)
        all_reps_diversities.push(reps_div)
        println("  sweep[" + to_string(k) + "] thr=" + to_string(levels[k])
                + " mean_n=" + to_string(mn) + " mean_div=" + to_string(md)
                + " mean_splits=" + to_string(ms) + " cv_n=" + to_string(cv))
        k = k + 1
    }

    // ── §3 metrics ────────────────────────────────────────────────────────────

    // F-BURST-1: 가장 낮은 thr → mean n_final > initial.
    let low_grows = mean_n_finals[0] > (initc * 1.0)

    // F-BURST-2: 어떤 level 에서 mean n_final == initial (분열 0회 = frozen zone 존재).
    let mut frozen_exists = false
    let mut frozen_thr = -1.0
    let mut fi = 0
    while fi < nlev {
        if mean_n_finals[fi] == (initc * 1.0) {
            frozen_exists = true
            if frozen_thr < 0.0 { frozen_thr = levels[fi] }
        }
        fi = fi + 1
    }

    // F-BURST-3: sweep 전체 diversity range ≥ range_floor.
    let mut min_div = mean_diversities[0]
    let mut max_div = mean_diversities[0]
    let mut di = 1
    while di < nlev {
        if mean_diversities[di] < min_div { min_div = mean_diversities[di] }
        if mean_diversities[di] > max_div { max_div = mean_diversities[di] }
        di = di + 1
    }
    let diversity_range = max_div - min_div
    let range_ok = diversity_range >= _range_floor()

    // F-BURST-4: 인접 sweep 점간 mean diversity 의 max relative jump.
    // jump_ratio[i] = max(div[i-1], div[i]) / max(1, min(div[i-1], div[i]))
    // 방향-무관 (저→고 thr 시 diversity 증가/감소 모두 burst 로 잡음).
    let mut max_jump_ratio = 1.0
    let mut jump_idx = -1
    let mut div_before = 0.0
    let mut div_after = 0.0
    let mut ji = 1
    while ji < nlev {
        let prev = mean_diversities[ji - 1]
        let cur  = mean_diversities[ji]
        let hi = if prev > cur { prev } else { cur }
        let lo = if prev < cur { prev } else { cur }
        let denom = if lo < 1.0 { 1.0 } else { lo }
        let ratio = hi / denom
        if ratio > max_jump_ratio {
            max_jump_ratio = ratio
            jump_idx = ji
            div_before = prev
            div_after = cur
        }
        ji = ji + 1
    }
    let jump_threshold = if jump_idx >= 1 { levels[jump_idx] } else { -1.0 }
    let prev_threshold = if jump_idx >= 1 { levels[jump_idx - 1] } else { -1.0 }
    let burst_jump_ok = max_jump_ratio >= _jump_ratio_floor()

    // F-BURST-5: rep-stability — 모든 level 의 cv_n ≤ cv_floor.
    let mut all_stable = true
    let mut max_cv = 0.0
    let mut ci = 0
    while ci < nlev {
        if cv_n_finals[ci] > max_cv { max_cv = cv_n_finals[ci] }
        if cv_n_finals[ci] > _cv_floor() { all_stable = false }
        ci = ci + 1
    }

    // ── §4 verdicts ───────────────────────────────────────────────────────────
    let f1 = low_grows
    let f2 = frozen_exists
    let f3 = range_ok
    let f4 = burst_jump_ok
    let f5 = all_stable

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut npass = 0
    if f1 { npass = npass + 1 }
    if f2 { npass = npass + 1 }
    if f3 { npass = npass + 1 }
    if f4 { npass = npass + 1 }
    if f5 { npass = npass + 1 }

    let verdict = if (npass == 5) {
        "SUPPORTED_CAMBRIAN_BURST"
    } else {
        if (npass >= 3) && f1 && f2 && f3 {
            "PARTIAL_SMOOTH_GROWTH"
        } else {
            "FALSIFIED_NO_BURST"
        }
    }

    // ── §5 result.json ───────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_053\",\n"
    j = j + "  \"slug\": \"cambrian-explosion-consciousness\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"determinism\": { \"gauss_seed\": 42, \"llm\": \"none\", \"cost_usd\": 0.0 },\n"
    j = j + "  \"params\": { \"d_model\": " + to_string(d)
          + ", \"initial_cells\": " + to_string(initc)
          + ", \"n_steps\": " + to_string(nsteps)
          + ", \"n_reps\": " + to_string(nreps)
          + ", \"signature_bits\": " + to_string(bits)
          + ", \"jump_ratio_floor\": " + to_string(_jump_ratio_floor())
          + ", \"range_floor\": " + to_string(_range_floor())
          + ", \"cv_floor\": " + to_string(_cv_floor()) + " },\n"
    j = j + "  \"sweep_levels\": ["
    let mut i = 0
    while i < nlev {
        if i > 0 { j = j + ", " }
        j = j + to_string(levels[i])
        i = i + 1
    }
    j = j + "],\n"
    j = j + "  \"mean_n_finals\": ["
    i = 0
    while i < nlev {
        if i > 0 { j = j + ", " }
        j = j + to_string(mean_n_finals[i])
        i = i + 1
    }
    j = j + "],\n"
    j = j + "  \"mean_diversities\": ["
    i = 0
    while i < nlev {
        if i > 0 { j = j + ", " }
        j = j + to_string(mean_diversities[i])
        i = i + 1
    }
    j = j + "],\n"
    j = j + "  \"mean_split_events\": ["
    i = 0
    while i < nlev {
        if i > 0 { j = j + ", " }
        j = j + to_string(mean_splits[i])
        i = i + 1
    }
    j = j + "],\n"
    j = j + "  \"cv_n_finals\": ["
    i = 0
    while i < nlev {
        if i > 0 { j = j + ", " }
        j = j + to_string(cv_n_finals[i])
        i = i + 1
    }
    j = j + "],\n"
    j = j + "  \"max_jump_ratio\": " + to_string(max_jump_ratio) + ",\n"
    j = j + "  \"jump_threshold\": " + to_string(jump_threshold) + ",\n"
    j = j + "  \"prev_threshold\": " + to_string(prev_threshold) + ",\n"
    j = j + "  \"diversity_before_jump\": " + to_string(div_before) + ",\n"
    j = j + "  \"diversity_after_jump\": " + to_string(div_after) + ",\n"
    j = j + "  \"diversity_range\": " + to_string(diversity_range) + ",\n"
    j = j + "  \"frozen_thr\": " + to_string(frozen_thr) + ",\n"
    j = j + "  \"max_cv\": " + to_string(max_cv) + ",\n"
    j = j + "  \"F_BURST_1\": { \"metric\": \"low-thr mean n_final > initial\", \"value\": "
          + to_string(mean_n_finals[0]) + ", \"floor\": " + to_string(initc) + ", \"verdict\": \""
          + v1 + "\" },\n"
    j = j + "  \"F_BURST_2\": { \"metric\": \"frozen-zone exists (mean n_final == initial at some thr)\", \"frozen_thr\": "
          + to_string(frozen_thr) + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "  \"F_BURST_3\": { \"metric\": \"diversity range max-min >= floor\", \"value\": "
          + to_string(diversity_range) + ", \"floor\": " + to_string(_range_floor())
          + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "  \"F_BURST_4\": { \"metric\": \"max adjacent diversity ratio >= floor\", \"value\": "
          + to_string(max_jump_ratio) + ", \"floor\": " + to_string(_jump_ratio_floor())
          + ", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "  \"F_BURST_5\": { \"metric\": \"all-level rep-CV(n_final) <= floor\", \"max_cv\": "
          + to_string(max_cv) + ", \"floor\": " + to_string(_cv_floor())
          + ", \"verdict\": \"" + v5 + "\" },\n"
    j = j + "  \"n_pass\": " + to_string(npass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("── verdicts ──")
    println("  F-BURST-1 LOW-THR-GROWS    : " + v1 + "  (mean_n_final[low]=" + to_string(mean_n_finals[0]) + ")")
    println("  F-BURST-2 FROZEN-ZONE      : " + v2 + "  (frozen_thr=" + to_string(frozen_thr) + ")")
    println("  F-BURST-3 DIVERSITY-RANGE  : " + v3 + "  (range=" + to_string(diversity_range)
            + " floor=" + to_string(_range_floor()) + ")")
    println("  F-BURST-4 BURST-JUMP       : " + v4 + "  (max_jump_ratio=" + to_string(max_jump_ratio)
            + " floor=" + to_string(_jump_ratio_floor()) + ")")
    println("  F-BURST-5 REP-STABILITY    : " + v5 + "  (max_cv=" + to_string(max_cv)
            + " floor=" + to_string(_cv_floor()) + ")")
    println("")
    println("  burst at thr=" + to_string(jump_threshold) + " (from prev_thr=" + to_string(prev_threshold) + ")")
    println("  mean_diversity " + to_string(div_before) + " → " + to_string(div_after)
            + "  (ratio=" + to_string(max_jump_ratio) + "×)")
    println("")
    println("================================================================")
    println("H_053 BURST SMOKE " + verdict + "  (" + to_string(npass) + "/5)")
    println(j)
    println("================================================================")
}


_run_burst()
