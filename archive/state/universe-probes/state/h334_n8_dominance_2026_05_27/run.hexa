// H_334 — n=8 cycle-length dominance: does scale-rotation continue past n=6?
// Pure hexa, deterministic. n=8 periodic ring (256 states). 256 starts,
// forward up to 300 steps, first-repeat cycle length.
// Prior: n=4 rule30 dominant (6.25), n=6 rule110 dominant (7.75).
// H1: rule110 STAYS dominant at n=8 (rotation was a one-step n=4->n=6 event,
//     not a continuing sequence). Falsifier: a THIRD rule overtakes (rotation
//     continues) OR rule30 reclaims dominance (oscillation).

fn next8(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 8 {
        let im1 = (i + 7) & 7   // (i-1) mod 8
        let ip1 = (i + 1) & 7   // (i+1) mod 8
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn cycle_len(s0: int, rule: int) -> int {
    let seen = farr_zeros(256)
    let idx_at = farr_zeros(256)
    let mut s = s0
    let mut t = 0
    while t < 300 {
        if to_int(farr_get(seen, s)) == 1 {
            let first = to_int(farr_get(idx_at, s))
            let _ = farr_free(seen); let _ = farr_free(idx_at)
            return t - (first - 1)
        }
        let _ = farr_set(seen, s, 1.0)
        let _ = farr_set(idx_at, s, to_float(t + 1))
        s = next8(s, rule)
        t = t + 1
    }
    let _ = farr_free(seen); let _ = farr_free(idx_at)
    return -1
}

fn measure_rule(rule: int, name: string) -> float {
    let mut total = 0
    let mut s0 = 0
    while s0 < 256 {
        let L = cycle_len(s0, rule)
        if L > 0 { total = total + L }
        s0 = s0 + 1
    }
    let mean_L = to_float(total) / 256.0
    println("rule=" + str(rule) + " name=" + name + " sum_L=" + str(total) + " mean_L=" + str(mean_L))
    return mean_L
}

fn main() {
    println("H_334 n=8 cycle-length dominance (scale-rotation tracking)")
    let r30 = measure_rule(30, "rule30_life")
    let r110 = measure_rule(110, "rule110_life")
    let r105 = measure_rule(105, "rule105_consc")
    let r150 = measure_rule(150, "rule150_consc")
    let r90 = measure_rule(90, "rule90_xor")
    println("n8: r30=" + str(r30) + " r110=" + str(r110) + " r105=" + str(r105) + " r150=" + str(r150) + " r90=" + str(r90))
    // which rule dominant?
    let mut maxv = r30
    let mut who = 30
    if r110 > maxv { maxv = r110; who = 110 }
    if r105 > maxv { maxv = r105; who = 105 }
    if r150 > maxv { maxv = r150; who = 150 }
    if r90 > maxv { maxv = r90; who = 90 }
    println("dominant_rule_n8=" + str(who) + " mean_L=" + str(maxv))
    println("rotation_history: n4=rule30 n6=rule110 n8=rule" + str(who))
    println("done")
}
