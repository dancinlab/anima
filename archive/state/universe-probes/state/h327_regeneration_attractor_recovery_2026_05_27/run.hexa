// H_327 — REGENERATION x attractor recovery (ECA n=4 ring)
// Deterministic. No RNG. Pure hexa. Reuses no IIT4 lib.
//
// Method: for each ECA rule, forward from s0=5 long enough to land in the
// attractor cycle; collect attractor set; flip k bits of s* (first attractor
// state); measure T_recovery = first step the perturbed trajectory re-enters
// the attractor set (or -1 if it never does within step cap).
//
// Anti-tautology: the recovery time is NOT defined; it is the iteration index
// where the forward orbit first lands back in the attractor set, which could
// be 0 (if the perturbed state is already an attractor state — falsifies
// recovery-dynamic), large (long transient — supports), or -1 (different
// basin, never re-enters).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    // 4-cell periodic ring; cell i has neighbours (i-1) mod 4 and (i+1) mod 4
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

fn xor4(a: int, b: int) -> int {
    // manual XOR — avoid hexa parser ambiguity around ^ in some builds
    return (a | b) - (a & b)
}

fn measure_one(rule: int, name: string) {
    let attr = farr_zeros(16)
    // burn 70 transient steps from s0=5
    let mut s = 5
    let mut t = 0
    while t < 70 { s = next4(s, rule); t = t + 1 }
    // next 30 states = attractor set (orbit must have repeated by now)
    let mut s_star = s
    let mut t2 = 0
    while t2 < 30 {
        let _ = farr_set(attr, s, 1.0)
        s = next4(s, rule)
        t2 = t2 + 1
    }
    // attractor size
    let mut sz = 0
    let mut i = 0
    while i < 16 {
        if to_int(farr_get(attr, i)) == 1 { sz = sz + 1 }
        i = i + 1
    }
    println("rule=" + str(rule) + " name=" + name + " s_star=" + str(s_star) + " attr_size=" + str(sz))
    // perturbation sweep
    let mut k = 1
    while k < 4 {
        let mask = (1 << k) - 1     // k=1 → 0001, k=2 → 0011, k=3 → 0111
        let s_pert = xor4(s_star, mask)
        let mut sp = s_pert
        let mut step = 0
        let mut found = -1
        while step < 50 {
            if to_int(farr_get(attr, sp)) == 1 {
                if found == -1 { found = step }
            }
            sp = next4(sp, rule)
            step = step + 1
        }
        println("  k=" + str(k) + " mask=" + str(mask) + " s_pert=" + str(s_pert) + " T_recovery=" + str(found))
        k = k + 1
    }
    let _ = farr_free(attr)
}

fn main() {
    println("H_327 REGENERATION x ECA attractor recovery (n=4 ring)")
    measure_one(110, "rule110")
    measure_one(30, "rule30")
    measure_one(60, "rule60")
    measure_one(204, "rule204_anchor")  // identity rule — every state is its own attractor, T_recovery must be 0
    println("done")
}
