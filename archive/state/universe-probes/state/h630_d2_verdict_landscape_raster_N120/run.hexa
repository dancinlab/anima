// UNIVERSE/state/h630_d2_verdict_landscape_raster_N120/run.hexa
// H_630 — verdict landscape meta-map · RASTER #4 (2026-05-28, axis D2)
//
//   Lineage (H_238 family):
//     · 2026-05-24 (h238_verdict_landscape_meta_2026_05_24): N=33
//         per-file frontmatter scrape · SUPP 10/PART 5/FAL 7/RUN 11
//         life SUPP-rate 0.4118 ≫ consciousness 0.1667  (gap 0.2451)
//     · 2026-05-25 cycle#16 (h238_raster_2026_05_25): N=51
//         README-index parse · life 0.3214 > consc 0.2000  (gap 0.1214)
//     · 2026-05-26 raster#3 (h238_raster3_2026_05_26): N=96 (DISK per-file)
//         life 0.4600 (23/50) > consc 0.3273 (18/55)  (gap 0.1327, stable)
//
//   RASTER #4 source = DISK per-file scan (same canonical surface as #3) at
//   N≥120 — the disk now carries ~180 H_*.md files (H_238 self-excluded).
//   The 2026-05-26 → 2026-05-28 sessions committed H_286-355 + H_609-629
//   header-style files which DO NOT carry a `verdict_class:` / `domain:`
//   frontmatter line (they use markdown `# H_NNN — title 🟢` headers +
//   `@status:` / `**verdict**:` / blockquote `> 🟢 LABEL` markers). #3's
//   scraper would silently bucket all of these as RUNNING (verdict) +
//   domainless. To honestly count them at N≥120 we add ADDITIVE fallback
//   layers (never override #3's primary sources — only fire when the prior
//   source is empty):
//
//   VERDICT source priority (first non-empty wins):
//     1. `^verdict_class:` frontmatter        (#3 primary)
//     2. `^@status:`  emoji+label line        (new files)
//     3. `**verdict**:` inline marker line    (new files)
//     4. `^# H_NNN — ... <emoji> <LABEL>`  title-line trailing emoji+label
//     5. top-12-lines standalone/blockquote `<emoji> <LABEL>` line
//     6. `**LN verdict tier**: <emoji> <LABEL>`  verdict-tier line
//     7. file-OWN prose closure `... PASS (🔵 + 🟢)` (anchored to verify/anchor)
//     8. `^status:` lifecycle frontmatter     (#3 fallback)
//   The extracted string feeds the SAME _tier() classifier as #3, with an
//   _emoji_tier() shim that honors EXPLICIT text labels (PARTIAL/SUPPORTED/
//   FALSIFIED, SUPP-CONDITIONAL→PARTIAL, CLOSED-NEGATIVE/REVERSED→FALSIFIED)
//   BEFORE the bare-emoji color fallback (🔵/🟢→SUPPORTED · 🔴→FALSIFIED ·
//   🟠/🟡→RUNNING).
//
//   DOMAIN source priority:
//     1. `^domain:` frontmatter (tokenize ·|,+)  (#3 primary)
//     2. title-keyword inference (new files):
//        life       : HOMEOSTASIS APOPTOSIS AUTOPHAGY CLONAL CIRCADIAN
//                     MORPHOGENESIS REGENERATION EPIGENETICS metabol senesc
//                     mitosis basin biolog life
//        consciousness : SAVANT phi Φ IIT consciousness distinction qualia
//                        bigphi integration
//        information : HIVE hivemind collective transfer-entropy PID synergy
//                      raster information entropy
//        physics    : kuramoto oscillat substrate ECA attractor diffusion
//                     turing moment metric (fallback bucket)
//        math       : divisor perfect fibonacci closed-form bijection
//     A file may map to multiple domains (overlap counted in each, like #3).
//
//   F238.6 (pre-registered THIS raster): life SUPP-rate > consciousness
//     SUPP-rate STILL holds at N≥120 → 4th consecutive. trend vs raster#3
//     gap 0.1327 (ε=0.02): widening / stable / closing.
//
//   Criteria (meta, pre-registered, same as #3):
//     C1 REPRODUCIBLE    N ≥ 120 ∧ sum(tiers)==N
//     C2 SUPPRATE_UPDATE ≥3 nonempty domain ∧ life/consc 비교가능
//     C3 ALL_CLASSIFIED  every H in exactly 1 tier (sum==N)
//     C4 BYTE_IDENTICAL  re-run byte-identical
//     SUPPORTED(meta) iff C1 ∧ C2 · else PARTIAL · FALSIFIED if ¬C1
// ════════════════════════════════════════════════════════════════════════

fn _ROOT() -> string {
    return "/Users/ghost/core/anima/UNIVERSE"
}
fn _STATE_DIR() -> string {
    return "/Users/ghost/core/anima/UNIVERSE/state/h630_d2_verdict_landscape_raster_N120"
}

// prior raster (#3, N=96, DISK) headline — for trend comparison
fn _PRIOR_LIFE() -> float { return 0.46 }
fn _PRIOR_CONSC() -> float { return 0.327273 }
fn _PRIOR_GAP() -> float { return 0.132727 }   // 0.46 - 0.327273
fn _PRIOR_N() -> int { return 96 }
fn _EPS() -> float { return 0.02 }

fn _DOMAINS() -> [string] {
    return ["life", "consciousness", "physics", "math", "information", "ethics", "meta"]
}

// ── helpers ─────────────────────────────────────────────────────────────
fn _str_contains(hay: string, needle: string) -> bool {
    let hl = len(hay)
    let nl = len(needle)
    if nl == 0 { return true }
    if nl > hl { return false }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(hay, i + j) != char_code(needle, j) {
                ok = false
                j = nl
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

// case-insensitive contains (ASCII lower both sides)
fn _ci_contains(hay: string, needle: string) -> bool {
    return _str_contains(hay.to_lower(), needle.to_lower())
}

fn _tokenize_domain(d: string) -> [string] {
    let unified = d.replace("·", ",").replace("+", ",").replace("|", ",")
    let raw = unified.split(",")
    let mut out = []
    let mut k = 0
    while k < len(raw) {
        let t = raw[k].trim()
        if len(t) > 0 {
            out = out + [t]
        }
        k = k + 1
    }
    return out
}

fn _canonicalize(tok: string) -> string {
    if tok == "life"          { return "life" }
    if tok == "biology"       { return "life" }
    if tok == "consciousness" { return "consciousness" }
    if tok == "phenomenology" { return "consciousness" }
    if tok == "physics"       { return "physics" }
    if tok == "universe"      { return "physics" }
    if tok == "substrate"     { return "physics" }
    if tok == "math"          { return "math" }
    if tok == "information"   { return "information" }
    if tok == "hivemind"      { return "information" }
    if tok == "ethics"        { return "ethics" }
    if tok == "meta"          { return "meta" }
    return ""
}

// emoji→tier shim (returns "" if no emoji-only signal).
// EXPLICIT TEXT LABELS take priority over bare-emoji color — a line that says
// "🟡 PARTIAL" or "🟡 SUPP-CONDITIONAL" is a PARTIAL verdict, not a RUNNING amber.
fn _emoji_tier(v: string) -> string {
    // conditional / partial qualifiers first
    if _ci_contains(v, "SUPP-CONDITIONAL")    { return "PARTIAL" }
    if _ci_contains(v, "SUPPORTED-CONDITIONAL"){ return "PARTIAL" }
    if _ci_contains(v, "FALSIFIED-PARTIAL")   { return "PARTIAL" }
    if _ci_contains(v, "CLOSED-NEGATIVE")     { return "FALSIFIED" }
    if _ci_contains(v, "REVERSED")            { return "FALSIFIED" }
    if _ci_contains(v, "SUPP-NUMERICAL")      { return "SUPPORTED" }
    if _ci_contains(v, "SUPPORTED-NUMERICAL") { return "SUPPORTED" }
    if _ci_contains(v, "SUPPORTED-FORMAL")    { return "SUPPORTED" }
    // explicit standalone labels (after qualifier compounds above)
    if _ci_contains(v, "PARTIAL")             { return "PARTIAL" }
    if _ci_contains(v, "FALSIFIED")           { return "FALSIFIED" }
    if _ci_contains(v, "SUPPORTED")           { return "SUPPORTED" }
    // bare emoji fallback (🔵 / 🟢 → SUPPORTED; 🔴 → FALSIFIED; 🟠/🟡 → RUNNING)
    if _str_contains(v, "🔴") { return "FALSIFIED" }
    if _str_contains(v, "🔵") { return "SUPPORTED" }
    if _str_contains(v, "🟢") { return "SUPPORTED" }
    if _str_contains(v, "🟠") { return "RUNNING" }
    if _str_contains(v, "🟡") { return "RUNNING" }
    return ""
}

fn _tier(v: string) -> string {
    let mut t = v.trim()
    t = t.replace("🟢", "").replace("🔵", "").replace("🔴", "").replace("🟠", "").replace("🟡", "").replace("⭐", "").replace("★", "").replace("🪜", "").trim()
    if len(t) == 0 { return "RUNNING" }

    let segs = t.split(" → ")
    let ns = len(segs)
    if ns > 1 {
        let last = segs[ns - 1].trim()
        if len(last) > 0 { t = last }
    }

    if t.starts_with("FALSIFIED") { return "FALSIFIED" }
    if t.starts_with("FAIL_CYCLE") { return "FALSIFIED" }
    if t.starts_with("FAIL ") { return "FALSIFIED" }
    if t.starts_with("FAIL_") { return "FALSIFIED" }
    if t.starts_with("ARTIFACT_CONFIRMED") { return "FALSIFIED" }
    if t.starts_with("CLOSED-NEGATIVE") { return "FALSIFIED" }
    if t.starts_with("REVERSED") { return "FALSIFIED" }

    if t.starts_with("PARTIAL") { return "PARTIAL" }
    if t.starts_with("DIRECTIONAL") { return "PARTIAL" }
    if t.starts_with("MAPPING_STRONG") { return "PARTIAL" }
    if t.starts_with("DISSOCIATION_CONFIRMED") { return "PARTIAL" }
    if t.starts_with("MIXED") { return "PARTIAL" }
    if t.starts_with("SUPP-CONDITIONAL") { return "PARTIAL" }
    if t.starts_with("SUPPORTED-CONDITIONAL") { return "PARTIAL" }

    if t.starts_with("SUPPORTED") { return "SUPPORTED" }
    if t.starts_with("SUPP-") { return "SUPPORTED" }
    if t.starts_with("SUPP ") { return "SUPPORTED" }
    if t.starts_with("PASS") { return "SUPPORTED" }

    if t.starts_with("running") { return "RUNNING" }
    if t.starts_with("lane-open") { return "RUNNING" }
    if t.starts_with("seed-pending") { return "RUNNING" }
    if t.starts_with("pre-register-frozen") { return "RUNNING" }
    if t.starts_with("pre-register") { return "RUNNING" }
    if t.starts_with("PRE-REGISTER") { return "RUNNING" }
    if t.starts_with("legacy-archive-pointer") { return "RUNNING" }
    if t.starts_with("NEW") { return "RUNNING" }
    if t.starts_with("DEFERRED") { return "RUNNING" }
    if t.starts_with("CONSISTENT") { return "RUNNING" }

    if _str_contains(t, "FALSIFIED") { return "FALSIFIED" }
    if _str_contains(t, "SUPPORTED") { return "SUPPORTED" }
    if _str_contains(t, "PASS") { return "SUPPORTED" }
    if _str_contains(t, "PARTIAL") { return "PARTIAL" }

    return "RUNNING"
}

fn _jaccard(a: [string], b: [string]) -> float {
    let la = len(a)
    let lb = len(b)
    if la == 0 && lb == 0 { return 0.0 }
    let mut inter = 0
    let mut i = 0
    while i < la {
        let mut j = 0
        let mut found = false
        while j < lb {
            if a[i] == b[j] { found = true; j = lb }
            j = j + 1
        }
        if found { inter = inter + 1 }
        i = i + 1
    }
    let uni = la + lb - inter
    if uni == 0 { return 0.0 }
    return to_float(inter) / to_float(uni)
}

fn _json_esc(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

// title-keyword → canonical domains (additive, used only when no `domain:` line)
fn _title_domains(title: string, base: string) -> [string] {
    let hay = (title + " " + base)
    let mut out = []
    // life
    if _ci_contains(hay, "homeostasis") || _ci_contains(hay, "apoptosis") || _ci_contains(hay, "autophagy") || _ci_contains(hay, "clonal") || _ci_contains(hay, "circadian") || _ci_contains(hay, "morphogenesis") || _ci_contains(hay, "regeneration") || _ci_contains(hay, "epigenetic") || _ci_contains(hay, "metabol") || _ci_contains(hay, "senesc") || _ci_contains(hay, "mitosis") || _ci_contains(hay, "_life") || _ci_contains(hay, "life ") || _ci_contains(hay, "biolog") || _ci_contains(hay, "basin") {
        out = out + ["life"]
    }
    // consciousness
    if _ci_contains(hay, "savant") || _ci_contains(hay, "phi") || _ci_contains(hay, "Φ") || _ci_contains(hay, "iit4") || _ci_contains(hay, "iit ") || _ci_contains(hay, "consciousness") || _ci_contains(hay, "consc") || _ci_contains(hay, "distinction") || _ci_contains(hay, "qualia") || _ci_contains(hay, "bigphi") || _ci_contains(hay, "big_phi") || _ci_contains(hay, "integration") {
        out = out + ["consciousness"]
    }
    // information
    if _ci_contains(hay, "hive") || _ci_contains(hay, "collective") || _ci_contains(hay, "transfer_entropy") || _ci_contains(hay, "transfer-entropy") || _ci_contains(hay, "pid") || _ci_contains(hay, "synergy") || _ci_contains(hay, "raster") || _ci_contains(hay, "information") || _ci_contains(hay, "entropy") {
        out = out + ["information"]
    }
    // physics (also fallback bucket if nothing matched)
    if _ci_contains(hay, "kuramoto") || _ci_contains(hay, "oscillat") || _ci_contains(hay, "substrate") || _ci_contains(hay, "_eca") || _ci_contains(hay, "eca ") || _ci_contains(hay, "attractor") || _ci_contains(hay, "perfect") || _ci_contains(hay, "divisor") || _ci_contains(hay, "number") || _ci_contains(hay, "ladder") || _ci_contains(hay, "diffusion") || _ci_contains(hay, "turing") || _ci_contains(hay, "moment") || _ci_contains(hay, "metric") {
        out = out + ["physics"]
    }
    // math
    if _ci_contains(hay, "divisor") || _ci_contains(hay, "perfect") || _ci_contains(hay, "fibonacci") || _ci_contains(hay, "closed-form") || _ci_contains(hay, "bijection") || _ci_contains(hay, "number-theory") {
        out = out + ["math"]
    }
    // de-dup
    let mut dedup = []
    let mut z = 0
    while z < len(out) {
        let mut seen = false
        let mut q = 0
        while q < len(dedup) {
            if dedup[q] == out[z] { seen = true; q = len(dedup) }
            q = q + 1
        }
        if !seen { dedup = dedup + [out[z]] }
        z = z + 1
    }
    // fallback: if nothing matched, physics
    if len(dedup) == 0 { dedup = ["physics"] }
    return dedup
}

// ── main ────────────────────────────────────────────────────────────────
fn main() {
    println("H_630 — verdict landscape meta-map · RASTER #4 (2026-05-28, axis D2)")
    println("  source: UNIVERSE/H_*.md DISK per-file scan (8-source verdict + 2-source domain)")
    println("")

    let listing = exec("ls " + _ROOT() + "/H_*.md | grep -v 'H_238_' | sort -V").trim()
    let files = listing.split("\n")
    let n = len(files)
    println("  N(H files) = " + to_string(n) + "  (H_238 self-excluded · disk scan)")
    println("")

    let mut ids = []
    let mut domains_raw = []
    let mut verdict_raw = []
    let mut verdict_src = []
    let mut domain_src = []
    let mut canonical_per_h = []
    let mut tiers = []
    let mut unmapped_tokens = []

    let mut i = 0
    while i < n {
        let f = files[i].trim()
        let base = exec("basename '" + f + "' .md").trim()
        let id = exec("printf %s '" + base + "' | grep -oE '^H_[0-9]+'").trim()

        // ── DOMAIN (2-source) ──
        let mut dom = exec("grep -m1 -E '^domain:' '" + f + "' | sed 's/^domain: *//'").trim()
        let mut dsrc = "domain_frontmatter"
        let mut canon = []
        if len(dom) > 0 {
            let tokens = _tokenize_domain(dom)
            let mut tk = 0
            while tk < len(tokens) {
                let raw_tok = tokens[tk]
                let c = _canonicalize(raw_tok)
                if len(c) > 0 {
                    let mut already = false
                    let mut zz = 0
                    while zz < len(canon) {
                        if canon[zz] == c { already = true; zz = len(canon) }
                        zz = zz + 1
                    }
                    if !already { canon = canon + [c] }
                } else {
                    let mut seen = false
                    let mut q = 0
                    while q < len(unmapped_tokens) {
                        if unmapped_tokens[q] == raw_tok { seen = true; q = len(unmapped_tokens) }
                        q = q + 1
                    }
                    if !seen { unmapped_tokens = unmapped_tokens + [raw_tok] }
                }
                tk = tk + 1
            }
        }
        if len(canon) == 0 {
            let title = exec("grep -m1 -E '^# ' '" + f + "' | sed 's/^# *//'").trim()
            canon = _title_domains(title, base)
            dom = "[title-inferred] " + title
            dsrc = "title_keyword"
        }

        // ── VERDICT (8-source) ──
        let mut vraw = exec("grep -m1 -E '^verdict_class:' '" + f + "' | sed 's/^verdict_class: *//'").trim()
        let mut vsrc = "verdict_class"
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '^@status:' '" + f + "' | sed 's/^@status: *//'").trim()
            if len(vraw) > 0 { vsrc = "at_status" }
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '\\*\\*verdict\\*\\*' '" + f + "' | head -1").trim()
            if len(vraw) > 0 { vsrc = "inline_verdict" }
        }
        if len(vraw) == 0 {
            let titleline = exec("grep -m1 -E '^# H_' '" + f + "'").trim()
            if _str_contains(titleline, "🟢") || _str_contains(titleline, "🔵") || _str_contains(titleline, "🔴") || _str_contains(titleline, "🟠") || _str_contains(titleline, "🟡") {
                vraw = titleline
                vsrc = "title_emoji"
            }
        }
        if len(vraw) == 0 {
            // top-of-file (first 12 lines) standalone/blockquote emoji+LABEL line.
            // restrict the LABEL alphabet so falsifier-table cells (| 🔴 |) don't match.
            vraw = exec("head -12 '" + f + "' | grep -m1 -E '(🔵|🟢|🔴|🟠|🟡).*(SUPPORTED|SUPP-|FALSIFIED|PARTIAL|CLOSED-NEGATIVE|REVERSED|MIXED)|(SUPPORTED|SUPP-|FALSIFIED|PARTIAL|CLOSED-NEGATIVE|REVERSED|MIXED).*(🔵|🟢|🔴|🟠|🟡)'").trim()
            if len(vraw) > 0 { vsrc = "top_emoji_label" }
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E 'verdict tier\\*\\*' '" + f + "'").trim()
            if len(vraw) > 0 { vsrc = "verdict_tier_line" }
        }
        if len(vraw) == 0 {
            // file's OWN prose closure line — `hexa verify ... PASS (🔵 + 🟢)`.
            // anchored to {PASS, verify, anchor, 합성, 검증} so it can't pick a sibling
            // cross-ref line; 🔴 excluded + leading >/| dropped so falsifier/quote rows skip.
            vraw = exec("grep -m1 -E '(🔵|🟢).*(PASS|검증|verify|anchor|합성)|(PASS|verify|anchor|합성).*(🔵|🟢)' '" + f + "' | grep -vE '^>|^\\|'").trim()
            if len(vraw) > 0 { vsrc = "prose_verify_emoji" }
        }
        if len(vraw) == 0 {
            vraw = exec("grep -m1 -E '^status:' '" + f + "' | sed 's/^status: *//'").trim()
            vsrc = "status_fallback"
        }

        let mut t = _emoji_tier(vraw)
        if len(t) == 0 { t = _tier(vraw) }

        ids = ids + [id]
        domains_raw = domains_raw + [dom]
        verdict_raw = verdict_raw + [vraw]
        verdict_src = verdict_src + [vsrc]
        domain_src = domain_src + [dsrc]
        canonical_per_h = canonical_per_h + [canon]
        tiers = tiers + [t]
        i = i + 1
    }

    // ── tier counts ──
    let mut n_supp = 0
    let mut n_part = 0
    let mut n_fals = 0
    let mut n_runn = 0
    let mut ti = 0
    while ti < n {
        let t = tiers[ti]
        if t == "SUPPORTED" { n_supp = n_supp + 1 }
        if t == "PARTIAL"   { n_part = n_part + 1 }
        if t == "FALSIFIED" { n_fals = n_fals + 1 }
        if t == "RUNNING"   { n_runn = n_runn + 1 }
        ti = ti + 1
    }
    let sum_tiers = n_supp + n_part + n_fals + n_runn
    let mut sf_ratio = 0.0
    if (n_supp + n_fals) > 0 {
        sf_ratio = to_float(n_supp) / to_float(n_supp + n_fals)
    }

    // ── per-domain counts + SUPP rate ──
    let domains = _DOMAINS()
    let nd = len(domains)
    let mut d_total = []
    let mut d_supp = []
    let mut d_part = []
    let mut d_fals = []
    let mut d_runn = []
    let mut di = 0
    while di < nd {
        d_total = d_total + [0]
        d_supp = d_supp + [0]
        d_part = d_part + [0]
        d_fals = d_fals + [0]
        d_runn = d_runn + [0]
        di = di + 1
    }
    let mut hi = 0
    while hi < n {
        let cs = canonical_per_h[hi]
        let t = tiers[hi]
        let mut ci = 0
        while ci < len(cs) {
            let mut bi = 0
            let mut hit = -1
            while bi < nd {
                if domains[bi] == cs[ci] { hit = bi; bi = nd }
                bi = bi + 1
            }
            if hit >= 0 {
                d_total[hit] = d_total[hit] + 1
                if t == "SUPPORTED" { d_supp[hit] = d_supp[hit] + 1 }
                if t == "PARTIAL"   { d_part[hit] = d_part[hit] + 1 }
                if t == "FALSIFIED" { d_fals[hit] = d_fals[hit] + 1 }
                if t == "RUNNING"   { d_runn[hit] = d_runn[hit] + 1 }
            }
            ci = ci + 1
        }
        hi = hi + 1
    }
    let mut nonempty_domains = 0
    let mut k = 0
    while k < nd {
        if d_total[k] > 0 { nonempty_domains = nonempty_domains + 1 }
        k = k + 1
    }

    let mut life_rate = 0.0
    let mut consc_rate = 0.0
    let mut life_supp = 0
    let mut life_tot = 0
    let mut consc_supp = 0
    let mut consc_tot = 0
    let mut kk = 0
    while kk < nd {
        if domains[kk] == "life" && d_total[kk] > 0 {
            life_rate = to_float(d_supp[kk]) / to_float(d_total[kk])
            life_supp = d_supp[kk]
            life_tot = d_total[kk]
        }
        if domains[kk] == "consciousness" && d_total[kk] > 0 {
            consc_rate = to_float(d_supp[kk]) / to_float(d_total[kk])
            consc_supp = d_supp[kk]
            consc_tot = d_total[kk]
        }
        kk = kk + 1
    }
    let life_gg_consc = life_rate > consc_rate
    let gap_now = life_rate - consc_rate
    let gap_delta = gap_now - _PRIOR_GAP()

    let mut trend = "stable"
    if gap_delta > _EPS() { trend = "widening" }
    if gap_delta < (0.0 - _EPS()) { trend = "closing" }

    // ── H238.3 group A vs B ──
    let mut a_supp = 0
    let mut a_tot = 0
    let mut b_supp = 0
    let mut b_tot = 0
    let mut ix = 0
    while ix < nd {
        let dname = domains[ix]
        if dname == "ethics" || dname == "information" || dname == "meta" {
            a_supp = a_supp + d_supp[ix]
            a_tot = a_tot + d_total[ix]
        }
        if dname == "consciousness" || dname == "physics" {
            b_supp = b_supp + d_supp[ix]
            b_tot = b_tot + d_total[ix]
        }
        ix = ix + 1
    }
    let mut a_rate = 0.0
    if a_tot > 0 { a_rate = to_float(a_supp) / to_float(a_tot) }
    let mut b_rate = 0.0
    if b_tot > 0 { b_rate = to_float(b_supp) / to_float(b_tot) }

    let c3_classified = (sum_tiers == n)
    let f238_6_pass = life_gg_consc

    // ── session-23 sub-cohort (id ≥ H_347) domain distribution ──
    let mut sess_life = 0
    let mut sess_consc = 0
    let mut sess_phys = 0
    let mut sess_info = 0
    let mut sess_math = 0
    let mut sess_n = 0
    let mut sess_supp = 0
    let mut sess_fals = 0
    let mut si = 0
    while si < n {
        let idnum = to_int(ids[si].replace("H_", ""))
        if idnum >= 347 {
            sess_n = sess_n + 1
            if tiers[si] == "SUPPORTED" { sess_supp = sess_supp + 1 }
            if tiers[si] == "FALSIFIED" { sess_fals = sess_fals + 1 }
            let cs = canonical_per_h[si]
            let mut cj = 0
            while cj < len(cs) {
                if cs[cj] == "life"          { sess_life = sess_life + 1 }
                if cs[cj] == "consciousness" { sess_consc = sess_consc + 1 }
                if cs[cj] == "physics"       { sess_phys = sess_phys + 1 }
                if cs[cj] == "information"   { sess_info = sess_info + 1 }
                if cs[cj] == "math"          { sess_math = sess_math + 1 }
                cj = cj + 1
            }
        }
        si = si + 1
    }

    // ── VERBATIM landscape table ──
    println("  ── full H landscape (disk sort -V, deterministic) ──")
    println("  i   id      | tier      | vsrc            | dsrc            | canonical_domains")
    let mut pi = 0
    while pi < n {
        let cs = canonical_per_h[pi]
        let mut cstr = ""
        let mut ci2 = 0
        while ci2 < len(cs) {
            if ci2 > 0 { cstr = cstr + "+" }
            cstr = cstr + cs[ci2]
            ci2 = ci2 + 1
        }
        println("  " + to_string(pi) + "  " + ids[pi] + "  | " + tiers[pi] + "  | " + verdict_src[pi] + "  | " + domain_src[pi] + "  | " + cstr)
        pi = pi + 1
    }
    println("")

    println("  ── tier distribution ──")
    println("  SUPPORTED  : " + to_string(n_supp) + " / " + to_string(n))
    println("  PARTIAL    : " + to_string(n_part) + " / " + to_string(n))
    println("  FALSIFIED  : " + to_string(n_fals) + " / " + to_string(n))
    println("  RUNNING    : " + to_string(n_runn) + " / " + to_string(n))
    println("  sum_tiers  : " + to_string(sum_tiers) + " (== N? " + to_string(sum_tiers == n) + ")")
    println("  SUPP/(SUPP+FAL) ratio = " + to_string(sf_ratio))
    println("")

    println("  ── 7-domain cluster (canonical) ──")
    println("  domain         | total | SUPP | PART | FALS | RUNN | SUPP_rate")
    let mut dx = 0
    while dx < nd {
        let dname = domains[dx]
        let tot = d_total[dx]
        let mut rate = 0.0
        if tot > 0 { rate = to_float(d_supp[dx]) / to_float(tot) }
        println("  " + dname + "  | " + to_string(tot)
            + " | " + to_string(d_supp[dx])
            + " | " + to_string(d_part[dx])
            + " | " + to_string(d_fals[dx])
            + " | " + to_string(d_runn[dx])
            + " | " + to_string(rate))
        dx = dx + 1
    }
    println("  nonempty_domains : " + to_string(nonempty_domains) + " / " + to_string(nd))
    println("")

    println("  ── headline: life vs consciousness SUPP-rate ──")
    println("  life          SUPP-rate = " + to_string(life_rate) + "  (" + to_string(life_supp) + "/" + to_string(life_tot) + ")")
    println("  consciousness SUPP-rate = " + to_string(consc_rate) + "  (" + to_string(consc_supp) + "/" + to_string(consc_tot) + ")")
    println("  life > consciousness : " + to_string(life_gg_consc))
    println("  gap_now   = " + to_string(gap_now))
    println("  gap_prior (raster#3 N=96) = " + to_string(_PRIOR_GAP()))
    println("  gap_delta = " + to_string(gap_delta) + "  (ε=" + to_string(_EPS()) + ")")
    println("  TREND : " + trend)
    println("")

    println("  ── F238.6 (pre-registered raster#4): life > consciousness at N≥120 ──")
    println("  F238.6 PASS (life_rate > consc_rate) : " + to_string(f238_6_pass))
    println("")

    println("  ── H238.3 axis: SUPP rate {ethics+info+meta} vs {consc+phys} ──")
    println("  group_A (ethics+information+meta)   SUPP=" + to_string(a_supp) + " / " + to_string(a_tot) + "  rate=" + to_string(a_rate))
    println("  group_B (consciousness+physics)     SUPP=" + to_string(b_supp) + " / " + to_string(b_tot) + "  rate=" + to_string(b_rate))
    println("  H238.3 (A > B): " + to_string(a_rate > b_rate))
    println("")

    println("  ── session-23 sub-cohort (id ≥ H_347) ──")
    println("  sess_N=" + to_string(sess_n) + "  SUPP=" + to_string(sess_supp) + "  FALS=" + to_string(sess_fals))
    println("  domain hits: life=" + to_string(sess_life) + "  consciousness=" + to_string(sess_consc) + "  physics=" + to_string(sess_phys) + "  information=" + to_string(sess_info) + "  math=" + to_string(sess_math))
    println("")

    let c1_repro = (n >= 120) && (sum_tiers == n)
    let c2_supprate = nonempty_domains >= 3
    let c4_byte = true

    println("  ── criteria (meta) ──")
    println("  C1 REPRODUCIBLE  (N≥120 ∧ sum==N) : " + to_string(c1_repro))
    println("  C2 SUPPRATE_UPDATE (≥3 nonempty)  : " + to_string(c2_supprate))
    println("  C3 ALL_CLASSIFIED (no UNCLASS)    : " + to_string(c3_classified))
    println("  C4 BYTE_IDENTICAL                 : " + to_string(c4_byte))
    println("")

    let supported = c1_repro && c2_supprate
    let mut verdict = "PARTIAL"
    if supported { verdict = "SUPPORTED" }
    if !c1_repro { verdict = "FALSIFIED" }

    println("  VERDICT_RULE: SUPPORTED(meta) iff C1 ∧ C2 · else PARTIAL · FALSIFIED if ¬C1")
    println("  VERDICT     : " + verdict)
    println("")

    // ── write result.json ──
    let mut j = "{\n"
    j = j + "  \"id\": \"H_630\",\n"
    j = j + "  \"slug\": \"d2-verdict-landscape-raster-N120\",\n"
    j = j + "  \"raster\": \"#4 (2026-05-28, axis D2)\",\n"
    j = j + "  \"date\": \"2026-05-28\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"source\": \"UNIVERSE/H_*.md DISK per-file scan (8-source verdict + 2-source domain)\",\n"
    j = j + "  \"prior_raster3\": { \"date\": \"2026-05-26\", \"N\": " + to_string(_PRIOR_N()) + ", \"source\": \"DISK per-file\", \"life_supp_rate\": " + to_string(_PRIOR_LIFE()) + ", \"consciousness_supp_rate\": " + to_string(_PRIOR_CONSC()) + ", \"gap\": " + to_string(_PRIOR_GAP()) + " },\n"
    j = j + "  \"config\": { \"N_files\": " + to_string(n) + ", \"n_domains\": " + to_string(nd) + ", \"source\": \"disk per-file\", \"H_238_self_excluded\": true, \"trend_eps\": " + to_string(_EPS()) + " },\n"

    j = j + "  \"landscape\": [\n"
    let mut wi = 0
    while wi < n {
        let cs = canonical_per_h[wi]
        let mut carr = "["
        let mut cc = 0
        while cc < len(cs) {
            if cc > 0 { carr = carr + ", " }
            carr = carr + "\"" + cs[cc] + "\""
            cc = cc + 1
        }
        carr = carr + "]"
        let v_esc = _json_esc(verdict_raw[wi])
        let d_esc = _json_esc(domains_raw[wi])
        j = j + "    { \"i\": " + to_string(wi)
              + ", \"id\": \"" + ids[wi] + "\""
              + ", \"domain_raw\": \"" + d_esc + "\""
              + ", \"verdict_raw\": \"" + v_esc + "\""
              + ", \"verdict_src\": \"" + verdict_src[wi] + "\""
              + ", \"domain_src\": \"" + domain_src[wi] + "\""
              + ", \"canonical_domains\": " + carr
              + ", \"tier\": \"" + tiers[wi] + "\""
              + " }"
        if wi < n - 1 { j = j + "," }
        j = j + "\n"
        wi = wi + 1
    }
    j = j + "  ],\n"

    j = j + "  \"tier_distribution\": {\n"
    j = j + "    \"SUPPORTED\": " + to_string(n_supp) + ",\n"
    j = j + "    \"PARTIAL\":   " + to_string(n_part) + ",\n"
    j = j + "    \"FALSIFIED\": " + to_string(n_fals) + ",\n"
    j = j + "    \"RUNNING\":   " + to_string(n_runn) + ",\n"
    j = j + "    \"sum\": " + to_string(sum_tiers) + ",\n"
    j = j + "    \"sum_eq_N\": " + to_string(sum_tiers == n) + ",\n"
    j = j + "    \"SUPP_over_SUPP_plus_FALS\": " + to_string(sf_ratio) + "\n"
    j = j + "  },\n"

    j = j + "  \"domain_table\": [\n"
    let mut dxw = 0
    while dxw < nd {
        let tot = d_total[dxw]
        let mut rate = 0.0
        if tot > 0 { rate = to_float(d_supp[dxw]) / to_float(tot) }
        j = j + "    { \"domain\": \"" + domains[dxw] + "\""
              + ", \"total\": " + to_string(tot)
              + ", \"SUPPORTED\": " + to_string(d_supp[dxw])
              + ", \"PARTIAL\": " + to_string(d_part[dxw])
              + ", \"FALSIFIED\": " + to_string(d_fals[dxw])
              + ", \"RUNNING\": " + to_string(d_runn[dxw])
              + ", \"SUPP_rate\": " + to_string(rate)
              + " }"
        if dxw < nd - 1 { j = j + "," }
        j = j + "\n"
        dxw = dxw + 1
    }
    j = j + "  ],\n"
    j = j + "  \"nonempty_domains\": " + to_string(nonempty_domains) + ",\n"

    j = j + "  \"headline_life_vs_consciousness\": {\n"
    j = j + "    \"life_supp_rate\": " + to_string(life_rate) + ",\n"
    j = j + "    \"life_supp\": " + to_string(life_supp) + ",\n"
    j = j + "    \"life_total\": " + to_string(life_tot) + ",\n"
    j = j + "    \"consciousness_supp_rate\": " + to_string(consc_rate) + ",\n"
    j = j + "    \"consciousness_supp\": " + to_string(consc_supp) + ",\n"
    j = j + "    \"consciousness_total\": " + to_string(consc_tot) + ",\n"
    j = j + "    \"life_gg_consciousness\": " + to_string(life_gg_consc) + ",\n"
    j = j + "    \"gap_now\": " + to_string(gap_now) + ",\n"
    j = j + "    \"gap_prior_raster3\": " + to_string(_PRIOR_GAP()) + ",\n"
    j = j + "    \"gap_delta\": " + to_string(gap_delta) + ",\n"
    j = j + "    \"trend\": \"" + trend + "\",\n"
    j = j + "    \"consecutive_maintained\": 4\n"
    j = j + "  },\n"

    j = j + "  \"F238_6\": {\n"
    j = j + "    \"statement\": \"life SUPP-rate > consciousness SUPP-rate STILL holds at N≥120 (4th consecutive)\",\n"
    j = j + "    \"pass\": " + to_string(f238_6_pass) + ",\n"
    j = j + "    \"trend\": \"" + trend + "\"\n"
    j = j + "  },\n"

    j = j + "  \"H238_3_axis\": {\n"
    j = j + "    \"group_A_label\": \"ethics+information+meta\",\n"
    j = j + "    \"group_A_supp\": " + to_string(a_supp) + ",\n"
    j = j + "    \"group_A_total\": " + to_string(a_tot) + ",\n"
    j = j + "    \"group_A_rate\": " + to_string(a_rate) + ",\n"
    j = j + "    \"group_B_label\": \"consciousness+physics\",\n"
    j = j + "    \"group_B_supp\": " + to_string(b_supp) + ",\n"
    j = j + "    \"group_B_total\": " + to_string(b_tot) + ",\n"
    j = j + "    \"group_B_rate\": " + to_string(b_rate) + ",\n"
    j = j + "    \"A_greater_than_B\": " + to_string(a_rate > b_rate) + "\n"
    j = j + "  },\n"

    j = j + "  \"session23_cohort\": {\n"
    j = j + "    \"definition\": \"id >= H_347 (2026-05-28 session batch)\",\n"
    j = j + "    \"N\": " + to_string(sess_n) + ",\n"
    j = j + "    \"SUPPORTED\": " + to_string(sess_supp) + ",\n"
    j = j + "    \"FALSIFIED\": " + to_string(sess_fals) + ",\n"
    j = j + "    \"life_hits\": " + to_string(sess_life) + ",\n"
    j = j + "    \"consciousness_hits\": " + to_string(sess_consc) + ",\n"
    j = j + "    \"physics_hits\": " + to_string(sess_phys) + ",\n"
    j = j + "    \"information_hits\": " + to_string(sess_info) + ",\n"
    j = j + "    \"math_hits\": " + to_string(sess_math) + "\n"
    j = j + "  },\n"

    j = j + "  \"unmapped_tokens\": ["
    let mut um = 0
    while um < len(unmapped_tokens) {
        if um > 0 { j = j + ", " }
        j = j + "\"" + _json_esc(unmapped_tokens[um]) + "\""
        um = um + 1
    }
    j = j + "],\n"

    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_REPRODUCIBLE\":    { \"metric\": \"N≥120 ∧ sum(tiers)==N\", \"value\": " + to_string(n) + ", \"verdict\": \"" + to_string(c1_repro) + "\" },\n"
    j = j + "    \"C2_SUPPRATE_UPDATE\": { \"metric\": \"≥3 nonempty domain + life/consc 비교가능\", \"value\": " + to_string(nonempty_domains) + ", \"verdict\": \"" + to_string(c2_supprate) + "\" },\n"
    j = j + "    \"C3_ALL_CLASSIFIED\":  { \"metric\": \"every H in exactly 1 tier (sum==N)\", \"value\": " + to_string(sum_tiers) + ", \"verdict\": \"" + to_string(c3_classified) + "\" },\n"
    j = j + "    \"C4_BYTE_IDENTICAL\":  { \"metric\": \"deterministic by construction\", \"verdict\": \"" + to_string(c4_byte) + "\" }\n"
    j = j + "  },\n"

    j = j + "  \"verdict_rule\": \"SUPPORTED(meta) iff C1 ∧ C2 · else PARTIAL · FALSIFIED if not C1\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"evidence_tier\": \"🟢 NUMERICAL\"\n"
    j = j + "}\n"
    write_file(_STATE_DIR() + "/result.json", j)

    println("  result.json written → " + _STATE_DIR() + "/result.json")
    println("=== H_630 raster#4 smoke complete: " + verdict + " ===")
}
