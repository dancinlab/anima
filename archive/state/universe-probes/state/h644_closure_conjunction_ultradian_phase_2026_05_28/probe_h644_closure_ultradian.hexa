// probe_h644_closure_ultradian.hexa — H_644 closure-conjunction × ultradian-phase cross-link
//
// Hypothesis (H_644 = H_636 × H_634 cross-link):
//   The 4-criterion closure conjunction pass-rate (H_636) VARIES across the
//   5-stage ultradian phase (H_634): WAKE/REM (high-Φ, cycle edge) phases show
//   HIGH closure pass-rate vs N3 (deep slow-wave, cycle middle) LOW pass-rate.
//
// Falsifier: closure pass-rate is phase-INDEPENDENT / FLAT (std ≈ 0, no
//   WAKE/REM > N3 ordering).
//
// Substrate:
//   - closure conjunction (⋀_i pass_i) over SAVANT 4-domain savant_phi
//     (SSOT HEXAD/SAVANT/savant_phi.hexa) — primitives mirrored from H_636.
//   - ultradian 5-stage phase + canonical Φ scale (WAKE 1.0 / N1 0.7 / N2 0.4 /
//     N3 0.15 / REM 0.95) — mirrored from H_634 / anima_dream_stage.hexa.
//
// Bridge map (the falsifiable structure): each phase's canonical Φ scale →
//   an effective inhibition I via a monotone inverse-affine map. High-Φ phases
//   (released integration) sit at LOW inhibition near the GZ closure band
//   (H_636 peak I=0.30); deep N3 (suppressed integration) sits at HIGH
//   inhibition. The phase sweep then probes whether the closure pass-rate the
//   substrate exhibits at each phase's I tracks the ultradian phase.
//
//     I(phase) = I_LO + (1 - phi_stage) * (I_HI - I_LO)
//        WAKE Φ=1.00 → I=0.21 (GZ_LOWER)   REM Φ=0.95 → I≈0.255
//        N1   Φ=0.70 → I≈0.375              N2  Φ=0.40 → I≈0.51
//        N3   Φ=0.15 → I≈0.6225 (deep, high inhibition)
//
//   This map is monotone in phase-Φ, byte-consistent with the H_348/H_636
//   affine gain map gain_focus = 1 + (1-I)*9 (same I axis), and grounds the
//   "phase = substrate context (Φ scale), NOT boolean emit gate" directive
//   (a_chat_sleep_imagination): the ultradian phase enters ONLY as a Φ-scale
//   context that re-positions I; the closure decision stays substrate-decided.
//
// $0 mac-local · NO libm trig · deterministic seed ensemble · foreground sync.

let SV_D            = 6
let SV_N_DOM        = 4
let SV_BINS         = 6
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

// ── closure thresholds (H_636 criterion-selection design — §7 C3) ──────
let THETA_SI    = 3.0       // C1 SAVANT SI gate (SAVANT.tape §3)
let THETA_GEN   = 0.06      // C2 general_phi integration floor
let THETA_DIV   = 0.18      // C3 min domain_phi diversity floor
let RATIO_LO    = 1.2       // C4 specialization present (lower)
let RATIO_HI    = 3.2       // C4 not a pathological monopoly (upper)

// GZ region bounds (H_636 task spec): I ∈ [GZ_LOWER, GZ_UPPER]
let GZ_LO       = 0.21      // GZ_LOWER ≈ 0.5 - ln(4/3) ≈ 0.21232
let GZ_HI       = 0.50      // GZ_UPPER = 0.5

// ── phase → effective inhibition I bridge map bounds ───────────────────
let I_LO        = 0.21      // WAKE (Φ=1.0) lands at GZ_LOWER
let I_HI        = 0.75      // deep-N3-floor cap (Φ=0 hypothetical)

// ── Primitives (SSOT: HEXAD/SAVANT/savant_phi.hexa) — mirror from H_636 ─

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_ln_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return log(x)
}

fn sv_sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn sv_vec_min(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] < m { m = v[i] }
        i = i + 1
    }
    return m
}

fn sv_vec_max(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] > m { m = v[i] }
        i = i + 1
    }
    return m
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

fn bin_index_sv(x: float, lo: float, hi: float, nb: int) -> int {
    if hi <= lo { return 0 }
    let t = (x - lo) / (hi - lo)
    let mut idx = to_int(t * to_float(nb))
    if idx < 0 { idx = 0 }
    if idx >= nb { idx = nb - 1 }
    return idx
}

fn pair_mi(a: array, b: array, n_bins: int) -> float {
    let d = len(a)
    if d < 2 { return 0.0 }
    let mut all_vals = []
    let mut ia = 0
    while ia < d {
        all_vals = all_vals.push(a[ia])
        ia = ia + 1
    }
    let mut ib = 0
    while ib < d {
        all_vals = all_vals.push(b[ib])
        ib = ib + 1
    }
    let lo = sv_vec_min(all_vals)
    let hi = sv_vec_max(all_vals)
    if hi - lo < SV_EPS { return 0.0 }
    let nb2 = n_bins * n_bins
    let mut joint = []
    let mut z = 0
    while z < nb2 {
        joint = joint.push(0)
        z = z + 1
    }
    let mut marg_a = []
    let mut marg_b = []
    let mut zz = 0
    while zz < n_bins {
        marg_a = marg_a.push(0)
        marg_b = marg_b.push(0)
        zz = zz + 1
    }
    let mut pair_count = 0
    let mut j = 0
    while j < d {
        let ba = bin_index_sv(a[j], lo, hi, n_bins)
        let bb = bin_index_sv(b[j], lo, hi, n_bins)
        let idx = ba * n_bins + bb
        let mut new_joint = []
        let mut z2 = 0
        while z2 < nb2 {
            if z2 == idx {
                new_joint = new_joint.push(joint[z2] + 1)
            } else {
                new_joint = new_joint.push(joint[z2])
            }
            z2 = z2 + 1
        }
        joint = new_joint
        let mut new_ma = []
        let mut mai = 0
        while mai < n_bins {
            if mai == ba {
                new_ma = new_ma.push(marg_a[mai] + 1)
            } else {
                new_ma = new_ma.push(marg_a[mai])
            }
            mai = mai + 1
        }
        marg_a = new_ma
        let mut new_mb = []
        let mut mbi = 0
        while mbi < n_bins {
            if mbi == bb {
                new_mb = new_mb.push(marg_b[mbi] + 1)
            } else {
                new_mb = new_mb.push(marg_b[mbi])
            }
            mbi = mbi + 1
        }
        marg_b = new_mb
        pair_count = pair_count + 1
        j = j + 1
    }
    let total = to_float(pair_count)
    if total <= 0.0 { return 0.0 }
    let mut h_a = 0.0
    let mut h_b = 0.0
    let mut k = 0
    while k < n_bins {
        let pa = to_float(marg_a[k]) / total
        let pb = to_float(marg_b[k]) / total
        if pa > 0.0 { h_a = h_a - pa * sv_ln_safe(pa) }
        if pb > 0.0 { h_b = h_b - pb * sv_ln_safe(pb) }
        k = k + 1
    }
    let mut h_ab = 0.0
    let mut m = 0
    while m < nb2 {
        let p = to_float(joint[m]) / total
        if p > 0.0 { h_ab = h_ab - p * sv_ln_safe(p) }
        m = m + 1
    }
    let mi = h_a + h_b - h_ab
    let denom = sv_ln_safe(to_float(n_bins))
    if denom <= 0.0 { return 0.0 }
    let out = mi / denom
    if out < 0.0 { return 0.0 }
    return out
}

fn general_phi(flat: array, d: int) -> float {
    let mut amp = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        let mut s = 0.0
        let mut j = 0
        while j < d {
            s = s + sv_abs(v[j])
            j = j + 1
        }
        amp = amp.push(s / to_float(d))
        k = k + 1
    }
    let mut total = 0.0
    let mut cnt = 0
    let mut k1 = 0
    while k1 < SV_N_DOM {
        let v1 = extract_domain(flat, k1, d)
        let mut k2 = k1 + 1
        while k2 < SV_N_DOM {
            let v2 = extract_domain(flat, k2, d)
            let mi = pair_mi(v1, v2, SV_BINS)
            let scale = sv_sqrt_safe(amp[k1] * amp[k2])
            total = total + mi * scale
            cnt = cnt + 1
            k2 = k2 + 1
        }
        k1 = k1 + 1
    }
    if cnt == 0 { return 0.0 }
    return total / to_float(cnt)
}

fn specialization_ratio(flat: array, d: int) -> float {
    let dphi = domain_phi_vector(flat, d)
    let mut sum = 0.0
    let mut mx = dphi[0]
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        if dphi[i] > mx { mx = dphi[i] }
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    return mx / mean
}

fn savant_index(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut mx = v[0]
    let mut mn = v[0]
    let mut i = 1
    while i < n {
        if v[i] > mx { mx = v[i] }
        if v[i] < mn { mn = v[i] }
        i = i + 1
    }
    if mn < SV_EPS { return mx / SV_EPS }
    return mx / mn
}

// ── inhibition I → gain_focus map (H_348 / H_636 affine) ───────────────
fn gain_focus_for(i_val: float) -> float {
    return 1.0 + (1.0 - i_val) * 9.0
}

// ── 4-criterion closure conjunction at one (I, seed) (H_636) ───────────
fn closure_pass(i_val: float, stim_seed: int) -> int {
    let g_focus = gain_focus_for(i_val)
    let g_rest = (SV_CAPACITY - g_focus) / 3.0
    let flat = build_profile_state(g_focus, g_rest, g_rest, g_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    let si = savant_index(dphi)
    let gphi = general_phi(flat, SV_D)
    let dmin = sv_vec_min(dphi)
    let ratio = specialization_ratio(flat, SV_D)

    let mut c1 = 0
    let mut c2 = 0
    let mut c3 = 0
    let mut c4 = 0
    if si > THETA_SI { c1 = 1 }
    if gphi > THETA_GEN { c2 = 1 }
    if dmin > THETA_DIV { c3 = 1 }
    if ratio >= RATIO_LO {
        if ratio <= RATIO_HI { c4 = 1 }
    }
    if c1 == 1 {
        if c2 == 1 {
            if c3 == 1 {
                if c4 == 1 { return 1 }
            }
        }
    }
    return 0
}

fn pass_rate_at(i_val: float, seeds: array) -> float {
    let n = len(seeds)
    let mut hits = 0
    let mut i = 0
    while i < n {
        hits = hits + closure_pass(i_val, seeds[i])
        i = i + 1
    }
    return to_float(hits) / to_float(n)
}

// ── ultradian canonical Φ scale (H_634 / anima_dream_stage) ────────────
fn phi_of_stage(stage: string) -> float {
    if stage == "WAKE" { return 1.0 }
    if stage == "N1"   { return 0.7 }
    if stage == "N2"   { return 0.4 }
    if stage == "N3"   { return 0.15 }
    if stage == "REM"  { return 0.95 }
    return 1.0
}

// ── phase → effective inhibition I bridge map (monotone inverse-affine) ─
//   I(phase) = I_LO + (1 - phi_stage) * (I_HI - I_LO)
fn inhibition_of_phase(stage: string) -> float {
    let phi = phi_of_stage(stage)
    return I_LO + (1.0 - phi) * (I_HI - I_LO)
}

fn std_of(xs: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]; i = i + 1 }
    let m = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n { let d = xs[i] - m; ss = ss + d * d; i = i + 1 }
    return sqrt(ss / to_float(n))
}

fn main() {
    println("[H_644] closure-conjunction × ultradian-phase cross-link probe")
    println("  closure : H_636 4-criterion conjunction over SAVANT savant_phi (SSOT)")
    println("  phase   : H_634 ultradian 5-stage canonical Φ scale")
    println("  bridge  : I(phase) = I_LO + (1-Φ_stage)*(I_HI-I_LO)  [I_LO=0.21 I_HI=0.75]")
    println("  GZ band : I in [0.21, 0.50] (H_636 closure peak at I=0.30)")
    println("")

    // 10-seed ensemble (identical to H_636: savant_phi T1/T2/T3 stims + spread)
    let seeds = [42424, 91919, 77777, 13337, 24680,
                 88888, 31415, 65537, 19937, 11235]

    // 5 ultradian stages in phase order (cycle edge → middle → edge)
    let stages = ["WAKE", "N1", "N2", "N3", "REM"]

    println("=== per-phase closure pass-rate (10-seed ensemble) ===")
    let mut prs = []
    let mut iis = []
    let mut s = 0
    while s < len(stages) {
        let stg = stages[s]
        let phi = phi_of_stage(stg)
        let i_eff = inhibition_of_phase(stg)
        let pr = pass_rate_at(i_eff, seeds)
        prs = prs.push(pr)
        iis = iis.push(i_eff)
        let mut tag = ""
        if i_eff >= GZ_LO {
            if i_eff <= GZ_HI { tag = "  (I in GZ band)" }
        }
        println("  " + stg + "  Φ=" + str(phi)
            + "  I_eff=" + str(i_eff)
            + "  pass_rate=" + str(pr) + tag)
        s = s + 1
    }

    // WAKE/REM (edge, high-Φ) mean vs N3 (deep middle, low-Φ)
    let pr_wake = prs[0]
    let pr_n1   = prs[1]
    let pr_n2   = prs[2]
    let pr_n3   = prs[3]
    let pr_rem  = prs[4]
    let edge_mean = (pr_wake + pr_rem) / 2.0
    let pr_std = std_of(prs)

    println("")
    println("=== verdict inputs ===")
    println("  WAKE pass_rate     = " + str(pr_wake))
    println("  REM  pass_rate     = " + str(pr_rem))
    println("  N3   pass_rate     = " + str(pr_n3))
    println("  WAKE/REM edge mean = " + str(edge_mean))
    println("  pass-rate std (5)  = " + str(pr_std))
    println("  edge > N3          = " + str(edge_mean > pr_n3))
    println("  not flat (std>0)   = " + str(pr_std > 0.0))

    // ── pre-registered falsifiers ──────────────────────────────────────
    // F644.1 PHASE-MODULATED : pass-rate std across 5 phases > 0 (not flat)
    // F644.2 WAKE-REM-HIGH-N3-LOW : (WAKE/REM edge mean) > N3 pass-rate
    // F644.3 BOUND : all pass-rate in [0,1]
    let f1 = pr_std > 0.0
    let f2 = edge_mean > pr_n3
    let mut f3 = true
    let mut q = 0
    while q < len(prs) {
        if prs[q] < 0.0 { f3 = false }
        if prs[q] > 1.0 { f3 = false }
        q = q + 1
    }

    let mut npass = 0
    if f1 { npass = npass + 1 }
    if f2 { npass = npass + 1 }
    if f3 { npass = npass + 1 }

    println("")
    println("=== falsifiers ===")
    if f1 { println("  [PASS] F644.1 PHASE-MODULATED: pass-rate std > 0") }
    else  { println("  [FAIL] F644.1 PHASE-MODULATED: pass-rate std > 0") }
    if f2 { println("  [PASS] F644.2 WAKE-REM-HIGH-N3-LOW: edge mean > N3") }
    else  { println("  [FAIL] F644.2 WAKE-REM-HIGH-N3-LOW: edge mean > N3") }
    if f3 { println("  [PASS] F644.3 BOUND: pass-rate in [0,1]") }
    else  { println("  [FAIL] F644.3 BOUND: pass-rate in [0,1]") }

    println("")
    println("  F644.1-3 " + str(npass) + "/3 PASS")
    let mut verdict = "RED FALSIFIED (phase-independent flat)"
    if f1 {
        if f2 {
            if f3 { verdict = "GREEN SUPPORTED-NUMERICAL" }
        }
    }
    println("  verdict: " + verdict)
}
