// ════════════════════════════════════════════════════════════════════════════
//  run_h618.hexa — H_618 collective-Φ GZ inverse-U dΦ_collective/dI peak
//
//  CORE QUESTION  (SAVANT × HIVE-MIND cross-link, axis E2 round 3)
//    H_351 (single-substrate rule 110 n=4) 🟢 SUPPORTED 5/5 에서 dΦ/dI peak
//    위치가 GZ_LOWER ≈ 0.21232 와 일치함을 보였다 (|Δ|=0.03232 ≤ 0.05).
//    H_614 round 2 cross-substrate invariance 는 multi-rule 에서 FALSIFIED 2/4.
//    round 3 cross-link: 2-substrate hivemind 의 collective dΦ_collective/dI
//    peak 도 GZ_LOWER 와 일치하는가? 즉, H_351 의 inverse-U structure 가
//    single-substrate 차원을 넘어 collective(다중 substrate joint) 차원
//    에서도 유지되는가?
//
//  SUBSTRATE
//    H_609 anchor: 2× ECA n_a=n_b=2 → joint n=4 ring, rule(110,110), W=0.6
//    (super-additive Φ peak cell verified at H_609 §5).
//    Within-A neighbors (decoupled, 2-ring degenerate):
//       cell 0: L=1, R=1   ·   cell 1: L=0, R=0
//    Within-B neighbors (decoupled):
//       cell 2: L=3, R=3   ·   cell 3: L=2, R=2
//    Coupled (full n=4 ring):
//       cell 0: L=3, R=1   ·   cell 1: L=0, R=2
//       cell 2: L=1, R=3   ·   cell 3: L=2, R=0
//    Per-cell blend by W: p_next = (1-W)*p_dec + W*p_cou.
//    Inhibition mix (H_351 양식):
//       tpm_mixed[s,i] = (1 - I) * tpm_collective[s,i]
//
//  Φ MEASUREMENT
//    faithful causal big-Φ at every 2^4=16 sys_state, then mean
//    (H_285/H_351 양식: single-state fragility 회피). n=4 small enough
//    to use full big_phi (no bounded cap needed).
//
//  GRID (8-point dense in GZ region — task-specified)
//    I ∈ {0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50}
//
//  dΦ_collective/dI : central finite difference (forward at start, backward at end).
//  peak  : argmax_i |dΦ_collective/dI|.
//  delta : |I[peak_idx] - GZ_LOWER|.
//
//  CRITERIA
//    F1 PEAK-IN-GZ       : delta ≤ 0.05
//    F2 PEAK-IN-WINDOW   : I[peak_idx] ∈ [0.15, 0.30]   (broader GZ window)
//    F3 UNIMODAL         : sign-change count ≤ 1       (단봉 inverse-U)
//    F4 MONOTONE-DECAY-RIGHT : Φ_collective[I=0.50] ≤ Φ_collective[I=0.25]
//    F5 BYTE-EQUAL       : in-process recompute byte-identical
//
//    SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4 ∧ F5
//    PARTIAL   = F2 ∧ F3 ∧ F4 ∧ F5  (peak in window but |Δ|>0.05)
//    FALSIFIED = !F2 ∨ !F3          (peak outside window OR multi-peak)
//
//  $0 · mac-local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4_bigphi.hexa"


fn _rule_a() -> int    { return 110 }
fn _rule_b() -> int    { return 110 }
fn _n_combined() -> int { return 4 }
fn _w() -> float        { return 0.6 }
fn _gz_lower() -> float { return 0.21232 }   // 0.5 - ln(4/3) ≈ 0.21232
fn _delta_tol() -> float { return 0.05 }


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


// ── n=4 coupled-ring TPM with weight W gating cross-half edges. ──
//
// Half A = cells {0,1} under rule_a · Half B = cells {2,3} under rule_b.
// Within-half (decoupled) neighbors — n=2 ring degenerate:
//   cell 0: L=1, R=1   ·   cell 1: L=0, R=0
//   cell 2: L=3, R=3   ·   cell 3: L=2, R=2
// Coupled (full n=4 ring) neighbors:
//   cell 0: L=3, R=1   ·   cell 1: L=0, R=2
//   cell 2: L=1, R=3   ·   cell 3: L=2, R=0
fn build_tpm_collective(rule_a: int, rule_b: int, W: float) -> array {
    let n = 4
    let full = 16
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let b0 = iit4_bit(s, 0)
        let b1 = iit4_bit(s, 1)
        let b2 = iit4_bit(s, 2)
        let b3 = iit4_bit(s, 3)
        let mut i = 0
        while i < n {
            // pick rule by half
            let mut rule = rule_a
            if i >= 2 { rule = rule_b }
            // decoupled neighbors (within-half n=2 degenerate)
            let mut l_dec = 0
            let mut c_dec = 0
            let mut r_dec = 0
            if i == 0 { l_dec = b1; c_dec = b0; r_dec = b1 }
            if i == 1 { l_dec = b0; c_dec = b1; r_dec = b0 }
            if i == 2 { l_dec = b3; c_dec = b2; r_dec = b3 }
            if i == 3 { l_dec = b2; c_dec = b3; r_dec = b2 }
            let idx_dec = 4 * l_dec + 2 * c_dec + r_dec
            let next_dec = iit4_bit(rule, idx_dec)
            // coupled neighbors (full n=4 ring)
            let mut l_cou = 0
            let mut c_cou = 0
            let mut r_cou = 0
            if i == 0 { l_cou = b3; c_cou = b0; r_cou = b1 }
            if i == 1 { l_cou = b0; c_cou = b1; r_cou = b2 }
            if i == 2 { l_cou = b1; c_cou = b2; r_cou = b3 }
            if i == 3 { l_cou = b2; c_cou = b3; r_cou = b0 }
            let idx_cou = 4 * l_cou + 2 * c_cou + r_cou
            let next_cou = iit4_bit(rule, idx_cou)
            // blend
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}


// inhibition-mixed collective TPM
fn mixed_tpm_collective(inhibit: float) -> array {
    let base = build_tpm_collective(_rule_a(), _rule_b(), _w())
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


// mean big-Φ over all 2^n states
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_618 collective-Φ GZ inverse-U dΦ_collective/dI peak")
    println("  rule(110,110) · n_a=n_b=2 · n_combined=4 · W=0.6 (H_609 anchor)")
    println("  axis E2 round 3 · SAVANT × HIVE-MIND cross-link")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50]
    let m = len(grid)

    // ── Φ_collective(I) ─────────────────────────────────────────────
    let mut phi = []
    let mut i = 0
    println("── Φ_collective(I) ──")
    while i < m {
        let inhibit = grid[i]
        let tpm = mixed_tpm_collective(inhibit)
        let mp = mean_big_phi(tpm, _n_combined())
        phi = phi.push(mp)
        println("  I=" + str(inhibit) + "  Φ_c=" + str(mp))
        i = i + 1
    }

    // byte-equal recompute (F5) — recompute at GZ_LOWER-near index (=0.21, idx 3).
    // single-point byte-eq keeps wall-time within budget; full-grid recompute
    // is 2× cost, the single peak-candidate index suffices for determinism.
    let _bytec_idx = 3
    let tpm_bc = mixed_tpm_collective(grid[_bytec_idx])
    let phi_bc = mean_big_phi(tpm_bc, _n_combined())
    let byte_eq = _abs(phi[_bytec_idx] - phi_bc) <= 1.0e-12

    // ── dΦ_collective/dI (central finite difference) ────────────────
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }

    println("")
    println("── dΦ_collective/dI ──")
    let mut p = 0
    while p < m {
        println("  I=" + str(grid[p]) + "  dΦ_c/dI=" + str(dphi[p]))
        p = p + 1
    }

    // ── peak (argmax |dΦ_c/dI|) ─────────────────────────────────────
    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta = _abs(peak_I - _gz_lower())

    // ── unimodality: count sign changes in dΦ_c/dI ──────────────────
    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }

    // ── falsifiers ───────────────────────────────────────────────────
    // grid indices: 0.10=0, 0.15=1, 0.18=2, 0.21=3, 0.25=4, 0.30=5, 0.40=6, 0.50=7
    let f1 = delta <= _delta_tol()
    let f2 = (peak_I >= 0.15) && (peak_I <= 0.30)
    let f3 = sign_changes <= 1
    let f4 = phi[7] <= phi[4]    // Φ(0.50) ≤ Φ(0.25)
    let f5 = byte_eq

    println("")
    println("── verdict ──")
    println("  peak I             = " + str(peak_I))
    println("  GZ_LOWER           = " + str(_gz_lower()))
    println("  |Δ|                = " + str(delta) + "   (tol " + str(_delta_tol()) + ")")
    println("  peak |dΦ_c/dI|     = " + str(peak_mag))
    println("  sign changes       = " + str(sign_changes))
    println("  Φ_c(0.25)          = " + str(phi[4]))
    println("  Φ_c(0.50)          = " + str(phi[7]))
    println("  byte_eq            = " + str(byte_eq))
    println("")
    println("  F1 PEAK-IN-GZ            = " + str(f1))
    println("  F2 PEAK-IN-WINDOW        = " + str(f2))
    println("  F3 UNIMODAL              = " + str(f3))
    println("  F4 MONOTONE-DECAY-RIGHT  = " + str(f4))
    println("  F5 BYTE-EQUAL            = " + str(f5))

    let supported = f1 && f2 && f3 && f4 && f5
    let partial   = (!f1) && f2 && f3 && f4 && f5
    let falsified = (!f2) || (!f3)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // ── result.json ─────────────────────────────────────────────────
    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_618\",\n"
    s = s + "  \"slug\": \"collective-gz-inverse-u-derivative-peak\",\n"
    s = s + "  \"axis\": \"E2 round 3 (SAVANT × HIVE-MIND cross-link)\",\n"
    s = s + "  \"predecessor_single\": \"H_351\",\n"
    s = s + "  \"predecessor_hivemind\": \"H_609\",\n"
    s = s + "  \"rule_a\": 110,\n"
    s = s + "  \"rule_b\": 110,\n"
    s = s + "  \"n_a\": 2,\n"
    s = s + "  \"n_b\": 2,\n"
    s = s + "  \"n_combined\": 4,\n"
    s = s + "  \"W\": " + str(_w()) + ",\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { s = s + ", " }
        s = s + str(grid[gi])
        gi = gi + 1
    }
    s = s + "],\n"
    s = s + "  \"phi_collective\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { s = s + ", " }
        s = s + str(phi[pi])
        pi = pi + 1
    }
    s = s + "],\n"
    s = s + "  \"dphi_di\": ["
    let mut di = 0
    while di < m {
        if di > 0 { s = s + ", " }
        s = s + str(dphi[di])
        di = di + 1
    }
    s = s + "],\n"
    s = s + "  \"peak_idx\": " + str(peak_idx) + ",\n"
    s = s + "  \"peak_I\": " + str(peak_I) + ",\n"
    s = s + "  \"peak_mag\": " + str(peak_mag) + ",\n"
    s = s + "  \"delta\": " + str(delta) + ",\n"
    s = s + "  \"sign_changes\": " + str(sign_changes) + ",\n"
    s = s + "  \"byte_eq\": " + str(byte_eq) + ",\n"
    s = s + "  \"f1\": " + str(f1) + ",\n"
    s = s + "  \"f2\": " + str(f2) + ",\n"
    s = s + "  \"f3\": " + str(f3) + ",\n"
    s = s + "  \"f4\": " + str(f4) + ",\n"
    s = s + "  \"f5\": " + str(f5) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h618_collective_gz_inverse_u_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h618_collective_gz_inverse_u_2026_05_28/result.json")
}
