// H_342 — 4|n law crossover REFINEMENT at n in {11, 12, 13, 14}
// Context: H_337 found 4|n <=> rule30 dominant (5/5 at n in {4,6,8,10,12}).
//          H_340 found this is a SMALL-N artifact: at n>=14 rule30 dominates
//          UNCONDITIONALLY (r30=1219@14, 4605@16 vs r110 31-98).
// QUESTION: where EXACTLY is the crossover? Measure rule30 vs rule110 mean
//           cycle length at n in {11,12,13,14}. n=11,13 are ODD rings (new —
//           no even-N bipartite structure), n=12 is 4-div (predict rule30),
//           n=14 is 2*7 4-not-div (H_340 showed rule30 wins anyway at 1219).
//
// Pre-registered H1: rule110 still LEADS at some small n in this range and the
//   lead SHRINKS toward n=14 where rule30 takes over. Identify the LARGEST n
//   where rule110 still leads (the crossover).
// Falsifier:
//   - if rule110 NEVER leads at any n in {11,12,13,14} (rule30 already dominant
//     from n=11) -> crossover is BELOW n=11.
//   - if rule110 LEADS even at n=14 -> H_340 is WRONG.
//
// Method: FULL enumeration for n<=13 (2^11=2048, 2^12=4096, 2^13=8192 starts),
//   stride 8 for n=14 (16384/8=2048 samples). Floyd period detection
//   (memory-free). Deterministic byte-identical. Outcome could place the
//   crossover anywhere — anti-tautology.

fn nextN(s: int, rule: int, n: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < n {
        let im1 = (i + n - 1) % n
        let ip1 = (i + 1) % n
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

// tortoise-hare (Floyd) period detection — O(period) memory-free.
fn cycle_len_floyd(s0: int, rule: int, n: int, cap: int) -> int {
    let mut tort = s0
    let mut hare = s0
    let mut steps = 0
    while steps < cap {
        tort = nextN(tort, rule, n)
        hare = nextN(nextN(hare, rule, n), rule, n)
        steps = steps + 1
        if tort == hare {
            let mut p = 1
            let mut h2 = nextN(tort, rule, n)
            while h2 != tort {
                h2 = nextN(h2, rule, n)
                p = p + 1
                if p > cap { return -1 }
            }
            return p
        }
    }
    return -1
}

fn mean_cycle_sampled(rule: int, n: int, nstates: int, stride: int, cap: int) -> float {
    let mut total = 0
    let mut count = 0
    let mut s0 = 0
    while s0 < nstates {
        let L = cycle_len_floyd(s0, rule, n, cap)
        if L > 0 { total = total + L; count = count + 1 }
        s0 = s0 + stride
    }
    if count == 0 { return 0.0 }
    return to_float(total) / to_float(count)
}

fn report(n: int, nstates: int, stride: int, cap: int) {
    let r30 = mean_cycle_sampled(30, n, nstates, stride, cap)
    let r110 = mean_cycle_sampled(110, n, nstates, stride, cap)
    let dom = if r30 > r110 { 30 } else { 110 }
    println("n=" + str(n) + " r30=" + str(r30) + " r110=" + str(r110) + " dominant=rule" + str(dom))
}

fn main() {
    println("H_342 4|n law crossover refine at n in {11,12,13,14}")
    // FULL enumeration n<=13 (stride 1); n=14 stride 8 = 2048 samples.
    // cap 16384 (generous: rule30@14 ~ 1219 in H_340, well under cap).
    report(11, 2048,  1, 16384)   // prime, ODD ring, 4-not-div
    report(12, 4096,  1, 16384)   // 2^2*3, 4-DIV -> H_337 predicts rule30
    report(13, 8192,  1, 16384)   // prime, ODD ring, 4-not-div
    report(14, 16384, 8, 16384)   // 2*7, 4-not-div -> H_340 found rule30 (1219)
    println("done")
}
