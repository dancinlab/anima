// UNIVERSE/state/h617_hivemind_savant_collective_si_2026_05_28/run_h617.hexa
//
//   H_617 — hivemind-savant-induced collective SI
//   axis E×F (SAVANT × HIVE-MIND) cross-link · round 3.
//
//   ANCHORS (independent predecessors from rounds 1/2):
//     • H_348 (axis E SAVANT round 1) — single-substrate Savant Index
//             SI = max(domain_phi)/min(domain_phi) > 3 PASS @ GZ_LOWER
//             (3/3 seed, SI_phi 4.18~5.25 on canonical savant_phi.hexa).
//     • H_609 (axis F1 HIVE-MIND round 2) — collective Φ super-additive
//             🟢 at rule pair (110,110) / W=0.6 on n_a=n_b=3 ECA hivemind.
//
//   CROSS-LINK QUESTION
//     Take the H_609 hivemind anchor (n_a=n_b=3, rule pair (110,110), W=0.6).
//     Lower the inhibition I on substrate A only (mirror H_348's
//     dropout→hypertrophy mapping). Does collective Savant Index
//       SI_collective = max(Φ_a, Φ_b) / min(Φ_a, Φ_b)
//     cross the SI > 3 threshold at I = GZ_LOWER ≈ 0.21232 ?
//
//   H1: SI_collective > 3 at I = GZ_LOWER, AND I → 0 trend boosts SI further
//       (lower-I monotone, matching H_348's affine sweep shape).
//   H0 (FALSIFIER): SI_collective ≤ 3 at GZ_LOWER OR I sweep flat / inverted.
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-28 BEFORE measuring)
//     F617.1 GZ-LOWER-SI:  SI_collective(I = GZ_LOWER) > 3
//     F617.2 I-MONOTONIC:  SI_collective non-increasing in I across
//                          {0.05, 0.10, 0.15, 0.21, 0.25, 0.30, 0.40, 0.50}
//                          (lower I ⇒ stronger A ⇒ higher SI; allow tiny tol)
//     F617.3 SYMMETRY-NULL:SI_collective(I_a = 0.0 baseline) ≈ 1 on the
//                          symmetric (110,110) pair anchor (within-pair Φ
//                          identical when both halves under pure rule).
//     F617.4 DETERMINISM:  re-run @ GZ_LOWER byte-identical
//
//   INHIBITION → TPM MAPPING
//     Inhibition I on substrate A only · blend A-half TPM with max-entropy
//     uniform-noise floor (p = 0.5) by weight I:
//        tpm_a_eff(I) = (1 - I) * tpm_a_rule + I * 0.5
//     I=1 (full inhibition) ⇒ A is pure noise (low Φ); I=0 (full release)
//     ⇒ pure rule (max Φ). This is the natural ECA analogue of H_348's
//     `gain_focus = 1 + (1-I)*9` affine map — lower-I unleashes the rule.
//     B half is held at pure rule (no modulation, I_b = 0.0).
//
//   deterministic · hexa-only · $0 mac-local · foreground sync · single run.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn approx(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < tol }
    return d < tol
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── n=3 ECA TPM, with inhibition I blending toward p=0.5 noise floor.
//    I=0 → pure rule deterministic · I=1 → fully uniform noise.
fn eca_tpm_n3_I(rule: int, I: float) -> array {
    let n = 3
    let one_minus_i = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < 8 {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            let p_rule = to_float(iit4_bit(rule, idx))
            let p = one_minus_i * p_rule + I * 0.5
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── Per-substrate Φ at sys_state=0 ──
fn phi_isolated(rule: int, I: float) -> float {
    let tpm = eca_tpm_n3_I(rule, I)
    let r = big_phi_bounded(tpm, 3, 0, 3)
    return r[0]
}

fn si_collective(phi_a: float, phi_b: float) -> float {
    let mut hi = phi_a
    let mut lo = phi_b
    if phi_b > phi_a { hi = phi_b; lo = phi_a }
    if lo < 0.000001 { return 1.0e9 }
    return hi / lo
}

fn i_at(j: int) -> float {
    if j == 0 { return 0.05 }
    if j == 1 { return 0.10 }
    if j == 2 { return 0.15 }
    if j == 3 { return 0.21232 } // GZ_LOWER = 1/2 - ln(4/3)
    if j == 4 { return 0.25 }
    if j == 5 { return 0.30 }
    if j == 6 { return 0.40 }
    return 0.50
}
fn i_label(j: int) -> string {
    if j == 0 { return "I=0.05" }
    if j == 1 { return "I=0.10" }
    if j == 2 { return "I=0.15" }
    if j == 3 { return "I=0.21232 GZ_LOWER" }
    if j == 4 { return "I=0.25" }
    if j == 5 { return "I=0.30" }
    if j == 6 { return "I=0.40" }
    return "I=0.50"
}

fn main() {
    println("================================================================")
    println("  H_617 — hivemind-savant induced collective SI (axis E*F round 3)")
    println("  anchors: H_348 (SAVANT GZ_LOWER SI>3) | H_609 (HIVE-MIND collPhi)")
    println("  substrate: n_a=n_b=3 | rule pair (110,110) | W=0.6 | sys=0")
    println("  inhibition I on A only | tpm_a_eff = (1-I)*rule + I*0.5")
    println("  GZ_LOWER = 1/2 - ln(4/3) ~ 0.21232")
    println("  falsifier: SI_collective(GZ_LOWER) <= 3 OR sweep not monotone")
    println("================================================================")

    let rule_a = 110
    let rule_b = 110

    // ── Symmetry null: I_a = 0.0 → A pure rule = B pure rule, SI ≈ 1
    let phi_b_pure = phi_isolated(rule_b, 0.0)
    let phi_a_at_zero = phi_isolated(rule_a, 0.0)
    println("  baseline (I_a=0.0, pure rule on both halves):")
    println("    Phi_a = " + str(phi_a_at_zero) + "  Phi_b = " + str(phi_b_pure))
    let si_sym = si_collective(phi_a_at_zero, phi_b_pure)
    println("    SI_collective (baseline symmetry) = " + str(si_sym))

    println("  --")
    println("  I sweep (inhibition on A only, B at pure rule):")
    let mut max_si = -1.0
    let mut max_si_idx = 0
    let mut si_at_gz = 0.0
    let mut si_arr = []
    let mut j = 0
    while j < 8 {
        let I_a = i_at(j)
        let phi_a = phi_isolated(rule_a, I_a)
        let phi_b = phi_b_pure
        let si = si_collective(phi_a, phi_b)
        si_arr = si_arr.push(si)
        println("  " + i_label(j) + "  Phi_a=" + str(phi_a) + "  Phi_b=" + str(phi_b) + "  SI=" + str(si))
        if si > max_si { max_si = si; max_si_idx = j }
        if j == 3 { si_at_gz = si }
        j = j + 1
    }

    println("  --")
    println("  MAX SI = " + str(max_si) + "  @ " + i_label(max_si_idx))
    println("  SI @ GZ_LOWER = " + str(si_at_gz))

    // ── F617.1 GZ-LOWER-SI ──
    check("F617.1 GZ-LOWER-SI: SI_collective(I=GZ_LOWER) > 3", si_at_gz > 3.0)

    // ── F617.2 I-MONOTONIC: SI non-increasing as I increases ──
    let mut mono = true
    let mut k = 0
    while k < 7 {
        if si_arr[k] + 0.000001 < si_arr[k + 1] {
            mono = false
        }
        k = k + 1
    }
    check("F617.2 I-MONOTONIC: SI non-increasing across I = 0.05 .. 0.50", mono)

    // ── F617.3 SYMMETRY-NULL: at I_a = 0.0 on symmetric (110,110), SI ≈ 1 ──
    check("F617.3 SYMMETRY-NULL: SI(I_a=0.0, symmetric pair) ~ 1 (within 0.01)", fabs(si_sym - 1.0) < 0.01)

    // ── F617.4 DETERMINISM: re-run @ GZ_LOWER byte-identical ──
    let phi_a_re = phi_isolated(rule_a, 0.21232)
    let phi_b_re = phi_isolated(rule_b, 0.0)
    let si_re = si_collective(phi_a_re, phi_b_re)
    check("F617.4 DETERMINISM: SI(GZ_LOWER) re-run byte-identical", approx(si_re, si_at_gz, 0.0))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if si_at_gz > 3.0 {
        if mono {
            println("  VERDICT: H1 SUPPORTED — hivemind-induced collective SI crosses")
            println("           SI > 3 at GZ_LOWER with monotone I-sweep")
        } else {
            println("  VERDICT: PARTIAL — GZ_LOWER SI>3 PASS but sweep non-monotone")
        }
    } else {
        println("  VERDICT: H1 FALSIFIED — SI_collective(GZ_LOWER) <= 3 — no")
        println("           cross-link emergence at the H_609/H_348 anchor.")
    }
    println("================================================================")
}
