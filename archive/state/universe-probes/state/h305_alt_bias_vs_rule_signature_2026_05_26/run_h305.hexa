// UNIVERSE/state/h305_alt_bias_vs_rule_signature_2026_05_26/run_h305.hexa
//
//   H_305 — alt-bias × rule signature correlation
//
//   QUESTION
//     Cross-H synthesis: do the 4 rules' (90, 60, 30, 110) mean/alt ratios
//     correlate with their distinct-value counts (3, 6, 29, 32 from H_301)?
//     Re-measure all 4 with bug-free pattern and verify correlation +
//     cross-H consistency.
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26)
//     F305.1 RULE-90-MEAN-ALT:  mean ≈ 21.375, alt ≈ 19.5
//     F305.2 RULE-60-MEAN-ALT:  mean ≈ 18.125, alt ≈ 16.5
//     F305.3 RULE-30-MEAN-ALT:  mean ≈ 23.6, alt ≈ 20.27
//     F305.4 RULE-110-MEAN-ALT: mean ≈ 27.07, alt ≈ 17.69
//     F305.5 RANK-MONOTONE: distinct-count rank = mean/alt ratio rank
//     F305.6 ALT-BIAS-AT-110-EXTREME: rule 110 ratio > 1.3 (3 others < 1.2)
//     F305.7 BOUND
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-c43/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn close_to(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.5 }
    return d < 0.5
}

// returns [mean, alt(st=21)]
fn mean_alt(rule: int) -> array {
    let n = 5
    let cap = 4
    let tpm = eca_tpm(rule, n)
    let mut total = 0.0
    let mut alt_val = 0.0
    let mut st = 0
    while st < 32 {
        let r = big_phi_bounded(tpm, n, st, cap)
        let v = r[0]
        total = total + v
        if st == 21 { alt_val = v }
        st = st + 1
    }
    return [total / 32.0, alt_val]
}

fn main() {
    println("================================================================")
    println("  H_305 — alt-bias × rule signature (4 rules × 32 states cap=4)")
    println("================================================================")

    println("  Computing rule 90...")
    let r90  = mean_alt(90)
    println("    mean = " + str(r90[0])  + " · alt(st=21) = " + str(r90[1])  + " · ratio = " + str(r90[0]  / r90[1]))

    println("  Computing rule 60...")
    let r60  = mean_alt(60)
    println("    mean = " + str(r60[0])  + " · alt(st=21) = " + str(r60[1])  + " · ratio = " + str(r60[0]  / r60[1]))

    println("  Computing rule 30...")
    let r30  = mean_alt(30)
    println("    mean = " + str(r30[0])  + " · alt(st=21) = " + str(r30[1])  + " · ratio = " + str(r30[0]  / r30[1]))

    println("  Computing rule 110...")
    let r110 = mean_alt(110)
    println("    mean = " + str(r110[0]) + " · alt(st=21) = " + str(r110[1]) + " · ratio = " + str(r110[0] / r110[1]))

    println("  ────────────── verdict ──────────────")

    // ── F305.1 RULE-90-MEAN-ALT ─────────────────────────────────────────
    check("F305.1 RULE-90: mean≈21.375 AND alt≈19.5", close_to(r90[0], 21.375) && close_to(r90[1], 19.5))

    // ── F305.2 RULE-60-MEAN-ALT ─────────────────────────────────────────
    check("F305.2 RULE-60: mean≈18.125 AND alt≈16.5", close_to(r60[0], 18.125) && close_to(r60[1], 16.5))

    // ── F305.3 RULE-30-MEAN-ALT ─────────────────────────────────────────
    check("F305.3 RULE-30: mean≈23.6 AND alt≈20.27", close_to(r30[0], 23.6) && close_to(r30[1], 20.27))

    // ── F305.4 RULE-110-MEAN-ALT ────────────────────────────────────────
    check("F305.4 RULE-110: mean≈27.07 AND alt≈17.69", close_to(r110[0], 27.07) && close_to(r110[1], 17.69))

    // ── F305.5 RANK-MONOTONE ────────────────────────────────────────────
    // distinct-count rank: rule 90(3) < rule 60(6) < rule 30(29) < rule 110(32)
    // expect: ratio(90) <= ratio(60) <= ratio(30) <= ratio(110)
    let q90  = r90[0]  / r90[1]
    let q60  = r60[0]  / r60[1]
    let q30  = r30[0]  / r30[1]
    let q110 = r110[0] / r110[1]
    println("    ratios: rule90=" + str(q90) + " rule60=" + str(q60) + " rule30=" + str(q30) + " rule110=" + str(q110))
    let monotone = (q90 <= q60 + 0.01) && (q60 <= q30 + 0.01) && (q30 <= q110 + 0.01)
    check("F305.5 RANK-MONOTONE: q(90) ≤ q(60) ≤ q(30) ≤ q(110) (distinct-count rank ↔ ratio rank)", monotone)

    // ── F305.6 ALT-BIAS-AT-110-EXTREME ──────────────────────────────────
    check("F305.6 ALT-BIAS-AT-110-EXTREME: ratio(110) > 1.3 AND all others < 1.2", (q110 > 1.3) && (q90 < 1.2) && (q60 < 1.2) && (q30 < 1.2))

    // ── F305.7 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    if !(r90[0] >= 0.0) { bound_ok = false }
    if !(r60[0] >= 0.0) { bound_ok = false }
    if !(r30[0] >= 0.0) { bound_ok = false }
    if !(r110[0] >= 0.0) { bound_ok = false }
    if !(r90[1] >= 0.0) { bound_ok = false }
    if !(r60[1] >= 0.0) { bound_ok = false }
    if !(r30[1] >= 0.0) { bound_ok = false }
    if !(r110[1] >= 0.0) { bound_ok = false }
    check("F305.7 BOUND: all mean + alt >= 0", bound_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  ALT-BIAS × RULE-SIGNATURE TABLE:")
    println("    rule  distinct  mean        alt          ratio")
    println("    90    3         " + str(r90[0])  + "  " + str(r90[1])  + "  " + str(q90))
    println("    60    6         " + str(r60[0])  + "  " + str(r60[1])  + "  " + str(q60))
    println("    30    29        " + str(r30[0])  + "  " + str(r30[1])  + "  " + str(q30))
    println("    110   32        " + str(r110[0]) + "  " + str(r110[1]) + "  " + str(q110))
    println("================================================================")
    if FAIL > 0 { panic("H_305 had FALSIFIER FAILURES") }
}
