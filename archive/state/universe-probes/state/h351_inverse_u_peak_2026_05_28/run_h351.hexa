// ════════════════════════════════════════════════════════════════════════════
//  run_h351.hexa — H_351 GZ inverse-U Φ-derivative peak
//
//  CORE QUESTION
//    substrate 의 inhibition I 에 대한 big-Φ 의 미분 dΦ/dI 의 peak 위치
//    (최대 기울기 지점) 가 GZ_LOWER = 0.5 - ln(4/3) ≈ 0.21232 와 일치
//    하는가 (|Δ| ≤ 0.05).
//
//  SUBSTRATE
//    ECA rule 110 (Wolfram class IV edge-of-chaos, H_285 anchor) on a
//    periodic ring of n=4 cells. inhibition I ∈ [0,1] mixes the ECA TPM
//    with a "force-to-zero" inhibitor TPM:
//       tpm_mixed[s,i] = (1 - I) * eca_tpm[s,i] + I * 0
//                      = (1 - I) * eca_tpm[s,i]
//    Probabilistic interpretation: per cell-state transition, with probability
//    (1-I) the ECA rule fires; with probability I the cell is inhibited to 0.
//    I=0 → pure rule 110 (max Φ regime). I=1 → fully inhibited (all-zero, Φ=0).
//    The transition point: somewhere in (0,1), with dΦ/dI peak (max steepness).
//
//  Φ MEASUREMENT
//    faithful causal big-Φ (HEXAD/IIT4 M6, iit4_bigphi + iit4_eca). For each
//    I in the grid, build mixed TPM, then average big-Φ over all 16 = 2^4
//    states (single-state fragility 회피, H_285 양식).
//
//  GRID (dense near GZ region)
//    I ∈ {0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
//         0.50, 0.70, 0.95}                                   — 13 points
//
//  dΦ/dI (central finite difference)
//    dPhi[i] = (Phi[i+1] - Phi[i-1]) / (I[i+1] - I[i-1])     (i=1..N-2)
//    edges (i=0, i=N-1) = forward / backward difference
//    peak_idx = argmax(|dPhi/dI|)
//    delta = |I[peak_idx] - GZ_LOWER|
//
//  UNIMODALITY CHECK
//    count sign changes in dPhi/dI sequence over the full grid; a single
//    inverse-U should yield ≤ 1 sign change (단봉).
//
//  CRITERIA
//    F1 PEAK-IN-GZ : delta ≤ 0.05                   (peak within GZ tolerance)
//    F2 PEAK-IN-WINDOW : I[peak_idx] ∈ [0.18, 0.28] (broader GZ window)
//    F3 UNIMODAL : sign-change count ≤ 1            (단봉 inverse-U)
//    F4 MONOTONE-DECAY-RIGHT : Phi[I=0.95] ≤ Phi[I=0.5]  (inhibition→Phi 붕괴)
//    F5 BYTE-EQUAL : in-process recompute byte-identical   (RFC 033)
//
//    SUPPORTED = F1∧F2∧F3∧F4∧F5
//    PARTIAL   = F2∧F3∧F4∧F5 (peak in window but |Δ|>0.05)
//    FALSIFIED = !F2 OR !F3 (peak outside GZ window OR multi-peak)
//
//  $0 · mac-local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/tmp/u-h351/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _rule() -> int { return 110 }
fn _n() -> int    { return 4 }
fn _gz_lower() -> float { return 0.21232 }  // 0.5 - ln(4/3) ≈ 0.21232
fn _delta_tol() -> float { return 0.05 }


// build the inhibition-mixed TPM: tpm_mixed[k] = (1 - I) * eca_tpm[k]
fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


// average big-Φ over all 2^n states (H_285 양식 - single-state fragility 회피).
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


// absolute value helper
fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


// sign(x) → -1 / 0 / +1 (with a small epsilon dead-band)
fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_351 GZ inverse-U Φ-derivative peak — rule 110, n=4")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]
    let m = len(grid)

    // ── Φ measurement at every I ───────────────────────────────────────
    let mut phi = []
    let mut i = 0
    println("── Φ(I) ──")
    while i < m {
        let inhibit = grid[i]
        let tpm = mixed_tpm(_rule(), _n(), inhibit)
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        println("  I=" + str(inhibit) + "  Φ=" + str(mp))
        i = i + 1
    }

    // byte-equal recompute (F5)
    let mut phi2 = []
    let mut j = 0
    while j < m {
        let tpm2 = mixed_tpm(_rule(), _n(), grid[j])
        phi2 = phi2.push(mean_big_phi(tpm2, _n()))
        j = j + 1
    }
    let mut byte_eq = true
    let mut bk = 0
    while bk < m {
        if _abs(phi[bk] - phi2[bk]) > 1.0e-12 { byte_eq = false }
        bk = bk + 1
    }

    // ── dΦ/dI (central difference, forward at start, backward at end) ─
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }

    println("")
    println("── dΦ/dI ──")
    let mut p = 0
    while p < m {
        println("  I=" + str(grid[p]) + "  dΦ/dI=" + str(dphi[p]))
        p = p + 1
    }

    // ── peak (argmax |dΦ/dI|) ────────────────────────────────────────
    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta = _abs(peak_I - _gz_lower())

    // ── unimodality: count sign changes in dΦ/dI ─────────────────────
    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let s = _sign(dphi[u])
        if (s != 0) && (prev_sign != 0) && (s != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if s != 0 { prev_sign = s }
        u = u + 1
    }

    // ── falsifiers ───────────────────────────────────────────────────
    let f1 = delta <= _delta_tol()
    let f2 = (peak_I >= 0.18) && (peak_I <= 0.28)
    let f3 = sign_changes <= 1
    // index of I=0.50 = 10, I=0.95 = 12
    let f4 = phi[12] <= phi[10]
    let f5 = byte_eq

    println("")
    println("── verdict ──")
    println("  peak I       = " + str(peak_I))
    println("  GZ_LOWER     = " + str(_gz_lower()))
    println("  |Δ|          = " + str(delta) + "   (tol " + str(_delta_tol()) + ")")
    println("  peak |dΦ/dI| = " + str(peak_mag))
    println("  sign changes = " + str(sign_changes))
    println("  Φ(0.50)      = " + str(phi[10]))
    println("  Φ(0.95)      = " + str(phi[12]))
    println("  byte_eq      = " + str(byte_eq))
    println("")
    println("  F1 PEAK-IN-GZ            = " + str(f1))
    println("  F2 PEAK-IN-WINDOW        = " + str(f2))
    println("  F3 UNIMODAL              = " + str(f3))
    println("  F4 MONOTONE-DECAY-RIGHT  = " + str(f4))
    println("  F5 BYTE-EQUAL            = " + str(f5))

    let supported = f1 && f2 && f3 && f4 && f5
    let partial   = (!f1) && f2 && f3 && f4 && f5
    let falsified = (!f2) || (!f3)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // ── result.json ─────────────────────────────────────────────────
    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_351\",\n"
    s = s + "  \"slug\": \"gz-inverse-u-phi-derivative-peak\",\n"
    s = s + "  \"rule\": 110,\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { s = s + ", " }
        s = s + str(grid[gi])
        gi = gi + 1
    }
    s = s + "],\n"
    s = s + "  \"phi\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { s = s + ", " }
        s = s + str(phi[pi])
        pi = pi + 1
    }
    s = s + "],\n"
    s = s + "  \"dphi_di\": ["
    let mut di = 0
    while di < m {
        if di > 0 { s = s + ", " }
        s = s + str(dphi[di])
        di = di + 1
    }
    s = s + "],\n"
    s = s + "  \"peak_idx\": " + str(peak_idx) + ",\n"
    s = s + "  \"peak_I\": " + str(peak_I) + ",\n"
    s = s + "  \"peak_mag\": " + str(peak_mag) + ",\n"
    s = s + "  \"delta\": " + str(delta) + ",\n"
    s = s + "  \"sign_changes\": " + str(sign_changes) + ",\n"
    s = s + "  \"byte_eq\": " + str(byte_eq) + ",\n"
    s = s + "  \"f1\": " + str(f1) + ",\n"
    s = s + "  \"f2\": " + str(f2) + ",\n"
    s = s + "  \"f3\": " + str(f3) + ",\n"
    s = s + "  \"f4\": " + str(f4) + ",\n"
    s = s + "  \"f5\": " + str(f5) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h351_inverse_u_peak_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h351_inverse_u_peak_2026_05_28/result.json")
}
