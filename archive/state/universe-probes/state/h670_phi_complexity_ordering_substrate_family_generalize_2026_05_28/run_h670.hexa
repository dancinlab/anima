// UNIVERSE/state/h670_.../run_h670.hexa
// H_670 — phi-complexity-ordering-substrate-family-generalize (축 G 메타-축 일반화)
//
//   Question: round 9-13 에서 ECA Wolfram class (I floor < II < III < IV ceiling)
//   가 collective-Φ 의 최선 1차 분류자로 수렴했다 (H_661/663/667/669). 이것이
//   ECA 전용 artifact 인가, 아니면 complexity-tier → Φ ordinal 이 substrate-universal
//   인가? 다른 dynamical family (Kuramoto coupling-regime · logistic map r-regime)
//   에서도 complexity-tier 가 Φ 를 ordinal 하게 order 하는가?
//
//   Two non-ECA substrate families, each with 4 complexity-tiers labelled by
//   the canonical dynamical-systems complexity ladder (정지 < 주기 < 카오스/edge):
//
//   FAMILY A — Kuramoto N=16 coupled oscillators (H_207 engine verbatim reuse).
//     coupling-regime tiers (complexity 오름차순):
//       T1 incoherent      K=0.3   (정지류 — 동기화 없음, 거의 random phase)
//       T2 partial-sync    K=1.0   (주기류 — 부분 클러스터)
//       T3 edge-of-sync    K=1.6 ≈ Kc (edge — 임계 결합, 가장 복잡한 부분동기)
//       T4 hyper-sync      K=5.0   (카오스/over-lock 상한 — full lock)
//     Φ = phi_spatial(cos θ trajectory, N, dim, n_bins) per tier (실측, lookup 아님).
//
//   FAMILY B — logistic-map population N=16 coupled maps x→r·x·(1−x).
//     r-regime tiers (Feigenbaum complexity 오름차순):
//       T1 fixed-point     r=2.8   (정지 — 단일 고정점)
//       T2 periodic        r=3.4   (주기-2)
//       T3 edge-of-chaos   r=3.5699 (edge — Feigenbaum accumulation point)
//       T4 chaotic         r=3.9   (카오스 — full chaotic band)
//     coupled via diffusive ring (small ε) → population trajectory → phi_spatial.
//
//   ECA Wolfram ordinal anchor (H_661/663): complexity-tier index 1<2<3<4
//   should ordinally co-rank with Φ — "complexity → Φ ceiling" universal?
//   Isomorphism to ECA = same monotone-rising complexity→Φ ordinal.
//
//   Φ primitive: phi_spatial runtime builtin (RFC 036, byte-equal phi_rs native
//   replica) — same primitive H_207/H_656 used. deterministic, NO RNG, $0 mac.
// ════════════════════════════════════════════════════════════════════════════

fn _state_dir() -> string {
    return "/private/tmp/u-h670/UNIVERSE/state/h670_phi_complexity_ordering_substrate_family_generalize_2026_05_28"
}

// ── shared config ────────────────────────────────────────────────────────────
fn _N() -> int      { return 16 }   // # units (oscillators / maps)
fn _DIM() -> int    { return 12 }   // recorded trajectory length / unit
fn _NBINS() -> int  { return 4 }    // bins per cell for phi_spatial
fn _two_pi() -> float { return 6.283185307179586 }

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

// ════════════════════════════════════════════════════════════════════════════
// FAMILY A — Kuramoto coupled oscillators (H_207 engine verbatim)
// ════════════════════════════════════════════════════════════════════════════
fn _kura_STEPS() -> int { return 100 }
fn _kura_WARM()  -> int { return 60 }
fn _kura_dt()    -> float { return 0.05 }
fn _omega_std()  -> float { return 1.0 }

// 5 deterministic z-quantiles of N(0,1) cycled by i%5 (H_207 verbatim).
fn _omega_i(i: int) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    return z * _omega_std()
}
fn _theta0(i: int, n: int) -> float { return _two_pi() * (i * 1.0) / (n * 1.0) }

// run Kuramoto for K, record cos θ trajectory (N × dim). returns states handle.
fn _run_kuramoto(K: float) -> int {
    let n = _N()
    let dim = _DIM()
    let warm = _kura_WARM()
    let steps = _kura_STEPS()
    let dt = _kura_dt()

    let theta = farr_zeros(n)
    let mut i = 0
    while i < n { farr_set(theta, i, _theta0(i, n)); i = i + 1 }

    let states = farr_zeros(n * dim)
    let mut s = 0
    while s < steps {
        if s >= warm {
            let t = s - warm
            if t < dim {
                let mut k = 0
                while k < n { farr_set(states, k * dim + t, cos(farr_get(theta, k))); k = k + 1 }
            }
        }
        let next = farr_zeros(n)
        let mut a = 0
        while a < n {
            let theta_a = farr_get(theta, a)
            let mut coupling_sum = 0.0
            let mut b = 0
            while b < n {
                coupling_sum = coupling_sum + sin(farr_get(theta, b) - theta_a)
                b = b + 1
            }
            let dtheta = _omega_i(a) + (K / (n * 1.0)) * coupling_sum
            farr_set(next, a, theta_a + dt * dtheta)
            a = a + 1
        }
        let mut k2 = 0
        while k2 < n { farr_set(theta, k2, farr_get(next, k2)); k2 = k2 + 1 }
        farr_free(next)
        s = s + 1
    }
    farr_free(theta)
    return states
}

fn _kura_phi(K: float) -> float {
    let traj = _run_kuramoto(K)
    let phi = phi_spatial(traj, _N(), _DIM(), _NBINS())
    farr_free(traj)
    return phi
}

// ════════════════════════════════════════════════════════════════════════════
// FAMILY B — logistic-map coupled population x_{n+1}=r·x_n·(1−x_n) diffusive ring
// ════════════════════════════════════════════════════════════════════════════
fn _log_STEPS() -> int { return 200 }
fn _log_WARM()  -> int { return 80 }
fn _coupling_eps() -> float { return 0.05 }   // weak diffusive ring coupling

// deterministic initial condition spread on (0,1) by index.
fn _x0(i: int, n: int) -> float { return (i * 1.0 + 0.5) / (n * 1.0) }

// run coupled logistic-map population for r, record x trajectory (N × dim).
fn _run_logistic(r: float) -> int {
    let n = _N()
    let dim = _DIM()
    let warm = _log_WARM()
    let steps = _log_STEPS()
    let eps = _coupling_eps()

    let x = farr_zeros(n)
    let mut i = 0
    while i < n { farr_set(x, i, _x0(i, n)); i = i + 1 }

    let states = farr_zeros(n * dim)
    let mut s = 0
    while s < steps {
        if s >= warm {
            let t = s - warm
            if t < dim {
                let mut k = 0
                while k < n { farr_set(states, k * dim + t, farr_get(x, k)); k = k + 1 }
            }
        }
        // local logistic map then diffusive ring coupling
        let local = farr_zeros(n)
        let mut a = 0
        while a < n {
            let xa = farr_get(x, a)
            farr_set(local, a, r * xa * (1.0 - xa))
            a = a + 1
        }
        let next = farr_zeros(n)
        let mut c = 0
        while c < n {
            let left  = (c - 1 + n) % n
            let right = (c + 1) % n
            let coupled = (1.0 - eps) * farr_get(local, c)
                        + 0.5 * eps * (farr_get(local, left) + farr_get(local, right))
            farr_set(next, c, coupled)
            c = c + 1
        }
        let mut k2 = 0
        while k2 < n { farr_set(x, k2, farr_get(next, k2)); k2 = k2 + 1 }
        farr_free(local)
        farr_free(next)
        s = s + 1
    }
    farr_free(x)
    return states
}

fn _log_phi(r: float) -> float {
    let traj = _run_logistic(r)
    let phi = phi_spatial(traj, _N(), _DIM(), _NBINS())
    farr_free(traj)
    return phi
}

// ════════════════════════════════════════════════════════════════════════════
// ordinal-monotone helpers (tier index 1<2<3<4 vs Φ)
// ════════════════════════════════════════════════════════════════════════════
// strict ordinal monotone: phi[0] <= phi[1] <= phi[2] <= phi[3] (4-tier rising)
fn _is_monotone_rising(p0: float, p1: float, p2: float, p3: float) -> bool {
    return p0 <= p1 && p1 <= p2 && p2 <= p3
}
// floor: tier-1 (정지) is strict min of the 4
fn _is_floor(p0: float, p1: float, p2: float, p3: float) -> bool {
    return p0 < p1 && p0 < p2 && p0 < p3
}
// ceiling: tier-4 (카오스/edge top) is strict max of the 4
fn _is_ceiling(p0: float, p1: float, p2: float, p3: float) -> bool {
    return p3 > p0 && p3 > p1 && p3 > p2
}
// # of correctly-ordered adjacent pairs (3 pairs) — partial-monotone score
fn _ordered_pairs(p0: float, p1: float, p2: float, p3: float) -> int {
    let mut c = 0
    if p0 <= p1 { c = c + 1 }
    if p1 <= p2 { c = c + 1 }
    if p2 <= p3 { c = c + 1 }
    return c
}

fn main() {
    println("H_670 — phi-complexity-ordering-substrate-family-generalize (축 G 메타-축 일반화)")
    println("  Question: complexity-tier → Φ ordinal 이 ECA Wolfram class 너머 다른 substrate-family 로 일반화되는가?")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM()) + " nbins=" + to_string(_NBINS())
            + "  Φ=phi_spatial(RFC 036) · deterministic NO RNG · $0 mac-local")
    println("")

    // ── FAMILY A — Kuramoto K-regime tiers ──────────────────────────────────
    println("── FAMILY A: Kuramoto coupling-regime (정지<주기<edge<카오스) ──")
    let kA_K0 = 0.3      // T1 incoherent (정지)
    let kA_K1 = 1.0      // T2 partial-sync (주기)
    let kA_K2 = 1.6      // T3 edge-of-sync (edge, ≈Kc)
    let kA_K3 = 5.0      // T4 hyper-sync (카오스/over-lock top)
    let a0 = _kura_phi(kA_K0)
    let a1 = _kura_phi(kA_K1)
    let a2 = _kura_phi(kA_K2)
    let a3 = _kura_phi(kA_K3)
    println("  T1 incoherent   K=" + to_string(kA_K0) + "   Φ=" + to_string(a0))
    println("  T2 partial-sync K=" + to_string(kA_K1) + "   Φ=" + to_string(a1))
    println("  T3 edge-of-sync K=" + to_string(kA_K2) + "   Φ=" + to_string(a2))
    println("  T4 hyper-sync   K=" + to_string(kA_K3) + "   Φ=" + to_string(a3))
    let a_mono = _is_monotone_rising(a0, a1, a2, a3)
    let a_floor = _is_floor(a0, a1, a2, a3)
    let a_ceil = _is_ceiling(a0, a1, a2, a3)
    let a_pairs = _ordered_pairs(a0, a1, a2, a3)
    println("  → monotone-rising=" + _bool_str(a_mono) + "  floor(T1 min)=" + _bool_str(a_floor)
            + "  ceiling(T4 max)=" + _bool_str(a_ceil) + "  ordered_pairs=" + to_string(a_pairs) + "/3")
    println("")

    // ── FAMILY B — logistic-map r-regime tiers ──────────────────────────────
    println("── FAMILY B: logistic-map r-regime (정지<주기<edge<카오스) ──")
    let rB_r0 = 2.8      // T1 fixed-point (정지)
    let rB_r1 = 3.4      // T2 periodic-2 (주기)
    let rB_r2 = 3.5699   // T3 edge-of-chaos (Feigenbaum accumulation)
    let rB_r3 = 3.9      // T4 chaotic (카오스 band)
    let b0 = _log_phi(rB_r0)
    let b1 = _log_phi(rB_r1)
    let b2 = _log_phi(rB_r2)
    let b3 = _log_phi(rB_r3)
    println("  T1 fixed-point  r=" + to_string(rB_r0) + "   Φ=" + to_string(b0))
    println("  T2 periodic     r=" + to_string(rB_r1) + "   Φ=" + to_string(b1))
    println("  T3 edge-of-chaos r=" + to_string(rB_r2) + "  Φ=" + to_string(b2))
    println("  T4 chaotic      r=" + to_string(rB_r3) + "   Φ=" + to_string(b3))
    let b_mono = _is_monotone_rising(b0, b1, b2, b3)
    let b_floor = _is_floor(b0, b1, b2, b3)
    let b_ceil = _is_ceiling(b0, b1, b2, b3)
    let b_pairs = _ordered_pairs(b0, b1, b2, b3)
    println("  → monotone-rising=" + _bool_str(b_mono) + "  floor(T1 min)=" + _bool_str(b_floor)
            + "  ceiling(T4 max)=" + _bool_str(b_ceil) + "  ordered_pairs=" + to_string(b_pairs) + "/3")
    println("")

    // ── pre-registered falsifiers ────────────────────────────────────────────
    // F670.1 KURA-FLOOR (CORE):    Family-A T1(정지) = strict Φ floor (ECA class-I floor 동형)
    // F670.2 LOG-FLOOR:            Family-B T1(정지) = strict Φ floor
    // F670.3 ANY-FAMILY-CEILING:   ≥1 non-ECA family 에서 T4(카오스/edge top) = Φ ceiling (ECA IV ceiling 동형)
    // F670.4 ORDINAL-COREL:        ≥1 family 에서 ordered_pairs ≥ 2/3 (complexity→Φ partial-monotone)
    // F670.5 NOT-ALL-FLAT:         두 family 모두 Φ-range>0 (tier 간 Φ 분화 존재, "complexity ⊥ Φ" 무관 반증)
    // F670.6 BOUND:                全 Φ finite ≥ 0
    let f1_kura_floor = a_floor
    let f2_log_floor  = b_floor
    let f3_any_ceil   = a_ceil || b_ceil
    let f4_ordinal    = a_pairs >= 2 || b_pairs >= 2

    // Φ-range per family
    let mut amin = a0
    if a1 < amin { amin = a1 }
    if a2 < amin { amin = a2 }
    if a3 < amin { amin = a3 }
    let mut amax = a0
    if a1 > amax { amax = a1 }
    if a2 > amax { amax = a2 }
    if a3 > amax { amax = a3 }
    let mut bmin = b0
    if b1 < bmin { bmin = b1 }
    if b2 < bmin { bmin = b2 }
    if b3 < bmin { bmin = b3 }
    let mut bmax = b0
    if b1 > bmax { bmax = b1 }
    if b2 > bmax { bmax = b2 }
    if b3 > bmax { bmax = b3 }
    let a_range = amax - amin
    let b_range = bmax - bmin
    let f5_not_flat = a_range > 0.0 && b_range > 0.0
    let f6_bound = a0 >= 0.0 && a1 >= 0.0 && a2 >= 0.0 && a3 >= 0.0
                && b0 >= 0.0 && b1 >= 0.0 && b2 >= 0.0 && b3 >= 0.0

    let n_pass = (if f1_kura_floor { 1 } else { 0 })
               + (if f2_log_floor { 1 } else { 0 })
               + (if f3_any_ceil { 1 } else { 0 })
               + (if f4_ordinal { 1 } else { 0 })
               + (if f5_not_flat { 1 } else { 0 })
               + (if f6_bound { 1 } else { 0 })

    // verdict:
    //   universal generalization (🟢) iff BOTH families show floor + ≥1 ceiling + ordinal ≥2/3
    //     = F670.1∧F670.2∧F670.3∧F670.4 PASS
    //   ECA-artifact (🔴) iff NEITHER family floor NOR ordinal (complexity ⊥ Φ in other families)
    //     = F670.1 FAIL ∧ F670.2 FAIL ∧ F670.4 FAIL
    //   else 🟡 PARTIAL (some-but-not-full generalization)
    let universal = f1_kura_floor && f2_log_floor && f3_any_ceil && f4_ordinal
    let eca_artifact = (!f1_kura_floor) && (!f2_log_floor) && (!f4_ordinal)
    let mut verdict = "PARTIAL"
    if universal { verdict = "SUPPORTED-NUMERICAL" }
    if eca_artifact { verdict = "FALSIFIED" }

    println("  Family-A Φ-range = " + to_string(a_range) + "  (min=" + to_string(amin) + " max=" + to_string(amax) + ")")
    println("  Family-B Φ-range = " + to_string(b_range) + "  (min=" + to_string(bmin) + " max=" + to_string(bmax) + ")")
    println("")
    println("  ── verdict ──")
    println("  [" + _verdict(f1_kura_floor) + "] F670.1 KURA-FLOOR (CORE): Family-A T1(정지) strict Φ floor")
    println("  [" + _verdict(f2_log_floor)  + "] F670.2 LOG-FLOOR: Family-B T1(정지) strict Φ floor")
    println("  [" + _verdict(f3_any_ceil)   + "] F670.3 ANY-FAMILY-CEILING: ≥1 family T4(top) Φ ceiling")
    println("  [" + _verdict(f4_ordinal)    + "] F670.4 ORDINAL-COREL: ≥1 family ordered_pairs ≥2/3")
    println("  [" + _verdict(f5_not_flat)   + "] F670.5 NOT-ALL-FLAT: 두 family Φ-range>0")
    println("  [" + _verdict(f6_bound)      + "] F670.6 BOUND: 全 Φ finite ≥0")
    println("  F670.1-6 " + to_string(n_pass) + "/6 PASS")
    println("  verdict: " + verdict)
    println("  kura_floor=" + _bool_str(f1_kura_floor) + " log_floor=" + _bool_str(f2_log_floor)
            + " any_ceil=" + _bool_str(f3_any_ceil) + " ordinal=" + _bool_str(f4_ordinal))

    // ── write result.json ────────────────────────────────────────────────────
    let mut o = "{\n"
    o = o + "  \"id\": \"H_670\",\n"
    o = o + "  \"slug\": \"phi-complexity-ordering-substrate-family-generalize\",\n"
    o = o + "  \"date\": \"2026-05-28\",\n"
    o = o + "  \"axis\": \"G\",\n"
    o = o + "  \"deterministic\": true,\n"
    o = o + "  \"llm\": \"none\",\n"
    o = o + "  \"cost\": \"$0 mac local\",\n"
    o = o + "  \"phi_primitive\": \"RFC 036 phi_spatial (byte-equal phi_rs native replica)\",\n"
    o = o + "  \"config\": { \"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"n_bins\": " + to_string(_NBINS()) + " },\n"
    o = o + "  \"family_A_kuramoto\": {\n"
    o = o + "    \"tiers\": [\"incoherent(정지) K=0.3\", \"partial-sync(주기) K=1.0\", \"edge-of-sync K=1.6\", \"hyper-sync(카오스) K=5.0\"],\n"
    o = o + "    \"phi\": [" + to_string(a0) + ", " + to_string(a1) + ", " + to_string(a2) + ", " + to_string(a3) + "],\n"
    o = o + "    \"monotone_rising\": " + _bool_str(a_mono) + ", \"floor\": " + _bool_str(a_floor)
          + ", \"ceiling\": " + _bool_str(a_ceil) + ", \"ordered_pairs\": " + to_string(a_pairs) + ", \"range\": " + to_string(a_range) + "\n"
    o = o + "  },\n"
    o = o + "  \"family_B_logistic\": {\n"
    o = o + "    \"tiers\": [\"fixed-point(정지) r=2.8\", \"periodic(주기) r=3.4\", \"edge-of-chaos r=3.5699\", \"chaotic(카오스) r=3.9\"],\n"
    o = o + "    \"phi\": [" + to_string(b0) + ", " + to_string(b1) + ", " + to_string(b2) + ", " + to_string(b3) + "],\n"
    o = o + "    \"monotone_rising\": " + _bool_str(b_mono) + ", \"floor\": " + _bool_str(b_floor)
          + ", \"ceiling\": " + _bool_str(b_ceil) + ", \"ordered_pairs\": " + to_string(b_pairs) + ", \"range\": " + to_string(b_range) + "\n"
    o = o + "  },\n"
    o = o + "  \"falsifiers\": {\n"
    o = o + "    \"F670_1_KURA_FLOOR\":      \"" + _verdict(f1_kura_floor) + "\",\n"
    o = o + "    \"F670_2_LOG_FLOOR\":       \"" + _verdict(f2_log_floor) + "\",\n"
    o = o + "    \"F670_3_ANY_CEILING\":     \"" + _verdict(f3_any_ceil) + "\",\n"
    o = o + "    \"F670_4_ORDINAL_COREL\":   \"" + _verdict(f4_ordinal) + "\",\n"
    o = o + "    \"F670_5_NOT_ALL_FLAT\":    \"" + _verdict(f5_not_flat) + "\",\n"
    o = o + "    \"F670_6_BOUND\":           \"" + _verdict(f6_bound) + "\"\n"
    o = o + "  },\n"
    o = o + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    o = o + "  \"verdict\": \"" + verdict + "\"\n"
    o = o + "}\n"
    write_file(_state_dir() + "/result.json", o)

    println("")
    println("  result.json → " + _state_dir() + "/result.json")
    println("=== H_670 complete: " + verdict + " (" + to_string(n_pass) + "/6) ===")
}
