// H_322 — CIRCADIAN × Kuramoto phase-coupled oscillator synchronization
// ════════════════════════════════════════════════════════════════════════════
// REAL Kuramoto N-oscillator simulation:
//
//   dθ_i/dt = ω_i + (K/N) · Σ_j sin(θ_j − θ_i)
//
// Discretised via fixed-step Euler (dt small), N=16, ω_i drawn from a fixed
// deterministic 5-quantile Gaussian-like spread cycled by i%5 (z-quantiles
// {-1.28, -0.52, 0.0, 0.52, 1.28} scaled by ω_std=1.0).
//
// Order parameter measured from the ACTUAL phase trajectory after warmup:
//   r = | (1/N) Σ_j exp(i θ_j) | = sqrt(C² + S²) / N
//   where  C = Σ cos θ_j,  S = Σ sin θ_j.
//
// r is NOT defined to equal 0 or 1 by construction. It is computed from the
// real θ_j produced by the timestep loop. Below K_c each oscillator drifts
// at its own ω_i and phases scatter → r small. Above K_c the coupling term
// overpowers the frequency spread and pulls phases together → r → 1.
//
// Anti-tautology checklist (g73):
//   • r is NOT hard-coded as f(K). It is a function of the integrated θ_j.
//   • Falsifiers (any one fatal): (a) r ≈ 0 for ALL K, (b) r ≈ 1 for ALL K,
//     (c) r monotone-linear in K with no transition, (d) r non-monotone in K.
//   • A 🔴 outcome is a real possibility (e.g. if dt too large → numerical
//     blow-up, or if ω spread too wide for our K range).
//
// Mean-field analytic estimate K_c = 2 / (π · g(ω_0)) ≈ 2·sqrt(2/π) ≈ 1.596
// for std-normal natural frequencies with ω_std=1.0 — POST-HOC cross-check
// only, NEVER used to decide PASS.
// ════════════════════════════════════════════════════════════════════════════

// ── config (deterministic) ──────────────────────────────────────────────────
fn _N() -> int       { return 16 }      // # oscillators
fn _STEPS() -> int   { return 2000 }    // total Euler steps
fn _WARM() -> int    { return 1500 }    // warmup steps (transient discard)
fn _DT() -> float    { return 0.05 }    // Euler timestep
fn _OMEGA_STD() -> float { return 1.0 } // ω spread scale
fn _TWO_PI() -> float    { return 6.283185307179586 }
fn _PI() -> float        { return 3.141592653589793 }
fn _state_dir() -> string {
    return "/tmp/anima-h322/UNIVERSE/state/h322_circadian_kuramoto_sync_2026_05_27"
}

fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// 5 deterministic z-quantiles of N(0,1), cycled by i%5.
fn _omega_i(i: int) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    return z * _OMEGA_STD()
}

// deterministic initial phase: uniform spread on [0, 2π) by index.
fn _theta0(i: int, n: int) -> float {
    return _TWO_PI() * (i * 1.0) / (n * 1.0)
}

// mean-field K_c for the underlying Gaussian distribution that the
// 5-quantile cycle is sampled from.
fn _Kc_analytic() -> float {
    return 2.0 * sqrt(2.0 / _PI()) * _OMEGA_STD()
}

// Instantaneous order parameter r = | (1/N) Σ exp(i θ_j) |
// from a [float] array of N phases.
fn _order_param(theta: [float]) -> float {
    let n = _N()
    let mut C = 0.0
    let mut S = 0.0
    let mut i = 0
    while i < n {
        C = C + cos(theta[i])
        S = S + sin(theta[i])
        i = i + 1
    }
    return sqrt(C * C + S * S) / (n * 1.0)
}

// ── simulate(K) ────────────────────────────────────────────────────────────
// Runs the Kuramoto Euler integration for `steps` total, then averages r
// over the post-warmup window so transient incoherence does not pollute
// the steady-state measurement. Returns (r_mean, r_final).
let mut g_r_mean = 0.0
let mut g_r_final = 0.0

fn simulate_kuramoto(K: float) {
    let n = _N()
    let steps = _STEPS()
    let warm  = _WARM()
    let dt    = _DT()

    // initial phases (deterministic).
    let mut theta: [float] = []
    let mut i = 0
    while i < n {
        theta.push(_theta0(i, n))
        i = i + 1
    }

    // pre-fetch ω_i.
    let mut omega: [float] = []
    let mut j = 0
    while j < n {
        omega.push(_omega_i(j))
        j = j + 1
    }

    let mut r_sum = 0.0
    let mut r_count = 0
    let mut s = 0
    while s < steps {
        // record r if past warmup.
        if s >= warm {
            r_sum = r_sum + _order_param(theta)
            r_count = r_count + 1
        }

        // compute Σ_j sin(θ_j − θ_a) for each oscillator a.
        // Use cos / sin decomposition for ONE forward pass:
        //   Σ_j sin(θ_j − θ_a) = cos(θ_a)·Σ sin θ_j − sin(θ_a)·Σ cos θ_j
        let mut Csum = 0.0
        let mut Ssum = 0.0
        let mut p = 0
        while p < n {
            Csum = Csum + cos(theta[p])
            Ssum = Ssum + sin(theta[p])
            p = p + 1
        }

        // update each θ_a in lockstep (synchronous Euler step).
        let mut next: [float] = []
        let mut a = 0
        while a < n {
            let ta = theta[a]
            let coupling_sum = cos(ta) * Ssum - sin(ta) * Csum
            let dtheta = omega[a] + (K / (n * 1.0)) * coupling_sum
            next.push(ta + dt * dtheta)
            a = a + 1
        }

        // copy next into theta.
        let mut b = 0
        while b < n {
            theta[b] = next[b]
            b = b + 1
        }

        s = s + 1
    }

    let r_final = _order_param(theta)
    let mut r_mean = 0.0
    if r_count > 0 { r_mean = r_sum / (r_count * 1.0) }

    g_r_mean = r_mean
    g_r_final = r_final
}

fn main() {
    println("================================================================")
    println("  H_322 — CIRCADIAN × Kuramoto phase-coupled oscillator sync")
    println("  dθ_i/dt = ω_i + (K/N) Σ_j sin(θ_j − θ_i)")
    println("================================================================")
    println("  N=" + str(_N()) + " steps=" + str(_STEPS()) + " warm=" + str(_WARM())
            + " dt=" + str(_DT()) + " ω_std=" + str(_OMEGA_STD()))
    println("  ω_i: 5 z-quantiles {-1.28,-0.52,0,0.52,1.28} cycled by i%5")
    println("  analytic K_c (mean-field, std-normal ω) = " + str(_Kc_analytic()))
    println("  (analytic K_c is POST-HOC cross-check only — verdict from r(K))")
    println("----------------------------------------------------------------")

    // ── K sweep — measure REAL r(K) per coupling ────────────────────────────
    let mut Ks: [float] = []
    Ks.push(0.0)
    Ks.push(0.5)
    Ks.push(1.0)
    Ks.push(1.5)
    Ks.push(2.0)
    Ks.push(3.0)
    Ks.push(5.0)
    let n_K = 7

    let mut r_means: [float] = []
    let mut r_finals: [float] = []

    let mut k_i = 0
    while k_i < n_K {
        let K = Ks[k_i]
        simulate_kuramoto(K)
        r_means.push(g_r_mean)
        r_finals.push(g_r_final)
        println("  K=" + str(K) + "   r_mean=" + str(g_r_mean) + "   r_final=" + str(g_r_final))
        k_i = k_i + 1
    }
    println("----------------------------------------------------------------")

    // ── Falsifier evaluation (from MEASURED r(K)) ───────────────────────────
    // r(K) at the endpoints:
    let r_K0  = r_means[0]              // K=0.0
    let r_Kmax = r_means[n_K - 1]       // K=5.0

    // F322.1 INCOHERENT-AT-ZERO-COUPLING: r(K=0) < 0.4 (phases scatter freely).
    let f1 = r_K0 < 0.4

    // F322.2 COHERENT-AT-LARGE-COUPLING: r(K=5.0) > 0.9 (near-full lock).
    let f2 = r_Kmax > 0.9

    // F322.3 BOUNDARY-REAL: r_Kmax − r_K0 >= 0.5 (large coherence jump).
    let f3 = (r_Kmax - r_K0) >= 0.5

    // F322.4 MONOTONE-RISE: r is non-decreasing across the sweep within tol.
    // tolerance 0.05 absorbs small finite-N fluctuations.
    let mut f4 = true
    let mut m = 0
    while m < n_K - 1 {
        if r_means[m + 1] < r_means[m] - 0.05 { f4 = false }
        m = m + 1
    }

    // F322.5 NON-LINEAR-TRANSITION: somewhere in the interior, the forward
    // difference Δr / ΔK exceeds the average slope (r_Kmax - r_K0) / K_total
    // by a factor ≥ 1.5. This rejects a pure linear ramp.
    let total_slope = (r_Kmax - r_K0) / (Ks[n_K - 1] - Ks[0])
    let mut max_slope = 0.0
    let mut max_slope_idx = 0
    let mut s_i = 0
    while s_i < n_K - 1 {
        let dK = Ks[s_i + 1] - Ks[s_i]
        let dr = r_means[s_i + 1] - r_means[s_i]
        let slope = dr / dK
        if s_i == 0 { max_slope = slope; max_slope_idx = 0 }
        if slope > max_slope { max_slope = slope; max_slope_idx = s_i }
        s_i = s_i + 1
    }
    let f5 = (max_slope >= 1.5 * total_slope) && (max_slope > 0.0)

    // F322.6 K_c-LOCATABLE: estimate K_c as the midpoint of the K-interval
    // where r first crosses 0.5. Require K_c ∈ (0, 5.0) — i.e. transition
    // happens inside the sweep range.
    let mut Kc_est = 0.0 - 1.0   // sentinel: not found
    let mut x_i = 0
    while x_i < n_K - 1 {
        if Kc_est < 0.0 {
            if (r_means[x_i] < 0.5) && (r_means[x_i + 1] >= 0.5) {
                Kc_est = (Ks[x_i] + Ks[x_i + 1]) / 2.0
            }
        }
        x_i = x_i + 1
    }
    let f6 = (Kc_est > 0.0) && (Kc_est < 5.0)

    // F322.7 r-BOUNDS-RESPECTED: every r ∈ [0, 1] (sanity — would fail if
    // numerical blow-up corrupted the trajectory).
    let mut f7 = true
    let mut y_i = 0
    while y_i < n_K {
        let rv = r_means[y_i]
        if (rv < 0.0 - 0.001) || (rv > 1.001) { f7 = false }
        y_i = y_i + 1
    }

    let mut pass = 0
    let mut fail = 0
    if f1 { pass = pass + 1 } else { fail = fail + 1 }
    if f2 { pass = pass + 1 } else { fail = fail + 1 }
    if f3 { pass = pass + 1 } else { fail = fail + 1 }
    if f4 { pass = pass + 1 } else { fail = fail + 1 }
    if f5 { pass = pass + 1 } else { fail = fail + 1 }
    if f6 { pass = pass + 1 } else { fail = fail + 1 }
    if f7 { pass = pass + 1 } else { fail = fail + 1 }

    println("  FALSIFIER EVALUATION (from MEASURED r(K)):")
    println("  F322.1 INCOHERENT-AT-ZERO     r(K=0) < 0.4         : " + str(f1) + "  (r_K0=" + str(r_K0) + ")")
    println("  F322.2 COHERENT-AT-LARGE      r(K=5) > 0.9         : " + str(f2) + "  (r_Kmax=" + str(r_Kmax) + ")")
    println("  F322.3 BOUNDARY-REAL          Δr ≥ 0.5             : " + str(f3) + "  (Δr=" + str(r_Kmax - r_K0) + ")")
    println("  F322.4 MONOTONE-RISE          non-decreasing (tol) : " + str(f4))
    println("  F322.5 NON-LINEAR-TRANSITION  max_slope ≥ 1.5×avg  : " + str(f5) + "  (max=" + str(max_slope) + " avg=" + str(total_slope) + ")")
    println("  F322.6 K_c-LOCATABLE          r=0.5 crossing in (0,5): " + str(f6) + "  (K_c_est=" + str(Kc_est) + ")")
    println("  F322.7 r-BOUNDS-RESPECTED     r ∈ [0,1] ∀K         : " + str(f7))
    println("================================================================")
    println("  RESULT: " + str(pass) + " PASS / " + str(fail) + " FAIL out of 7")

    let mut verdict = "ORANGE"
    let mut tier = "🟠"
    if pass >= 6 {
        verdict = "SUPPORTED_NUMERICAL"
        tier = "🟢"
    } else {
        // Determine the dominant failure mode for the 🔴 sub-classification.
        if (r_K0 >= 0.4) && (r_Kmax >= 0.4) && ((r_Kmax - r_K0) < 0.5) {
            verdict = "FALSIFIED_ALL_K_COHERENT"
            tier = "🔴"
        }
        if (r_K0 < 0.4) && (r_Kmax < 0.4) {
            verdict = "FALSIFIED_NO_SYNC_EVER"
            tier = "🔴"
        }
        if !f4 {
            verdict = "FALSIFIED_NON_MONOTONE"
            tier = "🔴"
        }
    }

    println("  VERDICT: " + tier + " " + verdict + "  (criteria_met=" + str(pass) + "/7)")
    println("  analytic K_c cross-check (mean-field): " + str(_Kc_analytic()))
    println("  measured K_c estimate (r=0.5 crossing midpoint): " + str(Kc_est))
    println("================================================================")

    // ── write result.json ──────────────────────────────────────────────────
    let mut o = "{\n"
    o = o + "  \"id\": \"H_322\",\n"
    o = o + "  \"slug\": \"circadian-kuramoto-sync\",\n"
    o = o + "  \"date\": \"2026-05-27\",\n"
    o = o + "  \"deterministic\": true,\n"
    o = o + "  \"hexa_only\": true,\n"
    o = o + "  \"llm\": \"none\",\n"
    o = o + "  \"cost\": \"$0 mac local\",\n"
    o = o + "  \"config\": {\n"
    o = o + "    \"N\": " + str(_N()) + ",\n"
    o = o + "    \"steps\": " + str(_STEPS()) + ",\n"
    o = o + "    \"warm\": " + str(_WARM()) + ",\n"
    o = o + "    \"dt\": " + str(_DT()) + ",\n"
    o = o + "    \"omega_std\": " + str(_OMEGA_STD()) + ",\n"
    o = o + "    \"omega_quantiles_z\": [-1.28, -0.52, 0.0, 0.52, 1.28]\n"
    o = o + "  },\n"
    o = o + "  \"K_sweep\": [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 5.0],\n"
    o = o + "  \"r_mean_per_K\": [\n"
    let mut q1 = 0
    while q1 < n_K {
        o = o + "    " + str(r_means[q1])
        if q1 < n_K - 1 { o = o + "," }
        o = o + "\n"
        q1 = q1 + 1
    }
    o = o + "  ],\n"
    o = o + "  \"r_final_per_K\": [\n"
    let mut q2 = 0
    while q2 < n_K {
        o = o + "    " + str(r_finals[q2])
        if q2 < n_K - 1 { o = o + "," }
        o = o + "\n"
        q2 = q2 + 1
    }
    o = o + "  ],\n"
    o = o + "  \"Kc_analytic_meanfield\": " + str(_Kc_analytic()) + ",\n"
    o = o + "  \"Kc_measured_r05_midpoint\": " + str(Kc_est) + ",\n"
    o = o + "  \"max_slope\": " + str(max_slope) + ",\n"
    o = o + "  \"max_slope_idx\": " + str(max_slope_idx) + ",\n"
    o = o + "  \"avg_slope\": " + str(total_slope) + ",\n"
    o = o + "  \"falsifiers\": {\n"
    o = o + "    \"F322_1_incoherent_at_zero\":     " + str(f1) + ",\n"
    o = o + "    \"F322_2_coherent_at_large\":      " + str(f2) + ",\n"
    o = o + "    \"F322_3_boundary_real\":          " + str(f3) + ",\n"
    o = o + "    \"F322_4_monotone_rise\":          " + str(f4) + ",\n"
    o = o + "    \"F322_5_nonlinear_transition\":   " + str(f5) + ",\n"
    o = o + "    \"F322_6_Kc_locatable\":           " + str(f6) + ",\n"
    o = o + "    \"F322_7_r_bounds_respected\":     " + str(f7) + "\n"
    o = o + "  },\n"
    o = o + "  \"criteria_met\": " + str(pass) + ",\n"
    o = o + "  \"criteria_total\": 7,\n"
    o = o + "  \"verdict\": \"" + verdict + "\",\n"
    o = o + "  \"tier\": \"" + tier + "\"\n"
    o = o + "}\n"
    write_file(_state_dir() + "/result.json", o)
    println("  result.json written → " + _state_dir() + "/result.json")
}
