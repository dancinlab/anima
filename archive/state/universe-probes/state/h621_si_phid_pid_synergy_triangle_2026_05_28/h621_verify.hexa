// ════════════════════════════════════════════════════════════════════════
//  H_621 verify — SI/ΦD ∥ PID synergy_ratio cross-link (E×F round 4)
//
//  triangle:
//    H_350 (round 1, 🟢 r=0.9264) : SI ∥ ΦD_maxmin
//    H_613 (round 2, 🟢 r=0.9896) : SI ∥ ΦD_cov (orthogonal)
//    H_355 (axis F1, 🟢 ratio=1.0) : hivemind PID synergy_ratio
//
//  본 H 는 두 substrate (savant_phi continuous · hivemind binary) 의 cross-link:
//    "savant 의 Φ-diversity 가 높을수록 hivemind 가 더 synergy-dominant 인가?"
//
//  BRIDGE 정의 (§3 본문):
//    savant_phi 의 4-domain capacity-bound 모델에서 (dom, g_focus, stim) 별로
//    SI 와 ΦD_cov 를 측정 + 같은 config 에서 induced hivemind 의 PID synergy
//    측정. induced hivemind: XOR-density K = g_focus / SV_CAPACITY ∈ [0.087, 0.87],
//    n_xor = round(3 * K) ∈ {0, 1, 2, 3} → H_355 의 결정적 PID 구조에 의해
//    synergy_total = n_xor (XOR-family redundancy ≡ 0).
//
//  Hypothesis: Spearman ρ(ΦD_cov, synergy_total) > 0.5 (양의 단조 cross-link).
//  Falsifier:  ρ < 0.3 (Φ-diversity 가 hivemind PID synergy 와 무관).
//
//  N = 4 dom × 5 g_focus × 2 stim = 40 (rule-of-thumb N ≥ 30 충족).
//  $0 Mac-local, wall < 10s, deterministic (RNG 없음, enumeration only).
// ════════════════════════════════════════════════════════════════════════

let SV_D            = 6
let SV_N_DOM        = 4
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

// phi_module(v) = Σ |v[j]|^1.5 / d  (H_350/H_613 byte-identical)
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

// SI = max / mean (H_350 byte-identical)
fn savant_index(dphi: array) -> float {
    let mut sum = 0.0
    let mut mx = dphi[0]
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        if dphi[i] > mx { mx = dphi[i] }
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    return mx / mean
}

// ΦD_cov = std / mean (H_613 orthogonal primary)
fn phi_diversity_cov(dphi: array) -> float {
    let mut sum = 0.0
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    let mut s2 = 0.0
    let mut j = 0
    while j < SV_N_DOM {
        let dd = dphi[j] - mean
        s2 = s2 + dd * dd
        j = j + 1
    }
    let var = s2 / to_float(SV_N_DOM)
    let sd = sv_sqrt_safe(var)
    return sd / mean
}

// ────────────────────────────────────────────────────────────────────
//  Hivemind PID side (H_355 substrate reuse — 3 binary substrates × 1 cell,
//  uniform 8-state ensemble, McGill net 3-source co-information II_3).
//
//  Bridge: K = g_focus / SV_CAPACITY ∈ [0.087, 0.87]
//          n_xor = round(3 * K) ∈ {0, 1, 2, 3}
//  H_355 결정적 PID 구조: synergy_total = n_xor (XOR cells), redundancy = 0.
//
//  본 H 는 K-induction 만 사용 (per-config 별 직접 n_xor 매핑). H_355 의
//  full PID 측정 (16-bin joint hist) 은 §A1 sanity-check 로 K=0,1,2,3 에서
//  재계산해 anchor pin (n_xor 와 일치 확인).
// ────────────────────────────────────────────────────────────────────

fn n_xor_from_g_focus(g_focus: float) -> int {
    let k_density = g_focus / SV_CAPACITY
    let raw = 3.0 * k_density
    // round-to-nearest
    let mut n = 0
    if raw < 0.5 { n = 0 }
    else if raw < 1.5 { n = 1 }
    else if raw < 2.5 { n = 2 }
    else { n = 3 }
    return n
}

// H_355 결정적 결과 — synergy_total = n_xor (XOR cells), redundancy = 0.
// ratio = 1.0 if n_xor > 0, else 0.0.
fn synergy_total_from_n_xor(n_xor: int) -> float {
    return to_float(n_xor)
}

fn synergy_ratio_from_n_xor(n_xor: int) -> float {
    if n_xor == 0 { return 0.0 }
    return 1.0
}

// ── §A1 PID anchor sanity (H_355 micro-recompute) ─────────────────────
// 16-bin joint histogram + bitmask marginal entropy, K=0/1/2/3 anchors.
// Returns synergy_total for a given XOR-cell count via deterministic mask.

fn log2(x: float) -> float { return log(x) / log(2.0) }

fn pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}

fn bit_at(s: int, i: int) -> int {
    return (s / pow2(i)) % 2
}

fn build_tpm(xor_mask: array) -> array {
    let n = 3
    let mut tpm = []
    let mut s = 0
    while s < 8 {
        let b0 = bit_at(s, 0)
        let b1 = bit_at(s, 1)
        let b2 = bit_at(s, 2)
        let xor3 = (b0 + b1 + b2) % 2
        let mut i = 0
        while i < n {
            if xor_mask[i] == 1 { tpm = tpm.push(to_float(xor3)) }
            else {
                let mut cell_val = b0
                if i == 1 { cell_val = b1 }
                if i == 2 { cell_val = b2 }
                tpm = tpm.push(to_float(cell_val))
            }
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn marg_entropy(counts: array, mask: int, total: float) -> float {
    let mut sub = []
    let mut z = 0
    while z < 16 { sub = sub.push(0); z = z + 1 }
    let mut k = 0
    while k < 16 {
        let key = k & mask
        sub[key] = sub[key] + counts[k]
        k = k + 1
    }
    let mut h = 0.0
    let mut j = 0
    while j < 16 {
        if sub[j] > 0 { let p = to_float(sub[j]) / total; h = h - p * log2(p) }
        j = j + 1
    }
    return h
}

fn co_info_3(tpm: array, cell_i: int) -> float {
    let mut counts = []
    let mut z = 0
    while z < 16 { counts = counts.push(0); z = z + 1 }
    let mut s = 0
    while s < 8 {
        let s0 = bit_at(s, 0)
        let s1 = bit_at(s, 1)
        let s2 = bit_at(s, 2)
        let mut t = 0
        if tpm[s * 3 + cell_i] > 0.5 { t = 1 }
        let idx = 8 * t + 4 * s0 + 2 * s1 + s2
        counts[idx] = counts[idx] + 1
        s = s + 1
    }
    let tot = 8.0
    let h_t   = marg_entropy(counts, 8, tot)
    let h_s0  = marg_entropy(counts, 4, tot)
    let h_s1  = marg_entropy(counts, 2, tot)
    let h_s2  = marg_entropy(counts, 1, tot)
    let h_t_s0  = marg_entropy(counts, 8 + 4, tot)
    let h_t_s1  = marg_entropy(counts, 8 + 2, tot)
    let h_t_s2  = marg_entropy(counts, 8 + 1, tot)
    let h_s0_s1 = marg_entropy(counts, 4 + 2, tot)
    let h_s0_s2 = marg_entropy(counts, 4 + 1, tot)
    let h_s1_s2 = marg_entropy(counts, 2 + 1, tot)
    let h_t_s0_s1 = marg_entropy(counts, 8 + 4 + 2, tot)
    let h_t_s0_s2 = marg_entropy(counts, 8 + 4 + 1, tot)
    let h_t_s1_s2 = marg_entropy(counts, 8 + 2 + 1, tot)
    let h_s0_s1_s2   = marg_entropy(counts, 4 + 2 + 1, tot)
    let h_t_s0_s1_s2 = marg_entropy(counts, 8 + 4 + 2 + 1, tot)
    let i_t_s0 = h_t + h_s0 - h_t_s0
    let i_t_s1 = h_t + h_s1 - h_t_s1
    let i_t_s2 = h_t + h_s2 - h_t_s2
    let i_t_s0s1 = h_t + h_s0_s1 - h_t_s0_s1
    let i_t_s0s2 = h_t + h_s0_s2 - h_t_s0_s2
    let i_t_s1s2 = h_t + h_s1_s2 - h_t_s1_s2
    let i_t_s0s1s2 = h_t + h_s0_s1_s2 - h_t_s0_s1_s2
    let ii3 = (i_t_s0 + i_t_s1 + i_t_s2) - (i_t_s0s1 + i_t_s0s2 + i_t_s1s2) + i_t_s0s1s2
    return ii3
}

fn syn_total_mask(xor_mask: array) -> float {
    let tpm = build_tpm(xor_mask)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii > 0.0 { acc = acc + ii }
        i = i + 1
    }
    return acc
}

// Anchor masks for n_xor ∈ {0,1,2,3}
fn anchor_mask(n_xor: int) -> array {
    if n_xor == 0 { return [0, 0, 0] }
    if n_xor == 1 { return [1, 0, 0] }
    if n_xor == 2 { return [1, 1, 0] }
    return [1, 1, 1]
}

// ── Pearson / Spearman ─────────────────────────────────────────────
fn pearson_corr(x: array, y: array) -> float {
    let n = len(x)
    if n < 2 { return 0.0 }
    let mut mx = 0.0
    let mut my = 0.0
    let mut i = 0
    while i < n {
        mx = mx + x[i]
        my = my + y[i]
        i = i + 1
    }
    mx = mx / to_float(n)
    my = my / to_float(n)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n {
        let dx = x[j] - mx
        let dy = y[j] - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom = sv_sqrt_safe(dx2 * dy2)
    if denom < SV_EPS { return 0.0 }
    return num / denom
}

fn rank_vector(x: array) -> array {
    let n = len(x)
    let mut ranks = []
    let mut i = 0
    while i < n {
        ranks = ranks.push(0.0)
        i = i + 1
    }
    let mut a = 0
    while a < n {
        let mut lt = 0
        let mut eq = 0
        let mut b = 0
        while b < n {
            if x[b] < x[a] { lt = lt + 1 }
            if x[b] == x[a] { eq = eq + 1 }
            b = b + 1
        }
        let r = to_float(lt) + (to_float(eq) + 1.0) / 2.0
        ranks[a] = r
        a = a + 1
    }
    return ranks
}

fn spearman_corr(x: array, y: array) -> float {
    let rx = rank_vector(x)
    let ry = rank_vector(y)
    return pearson_corr(rx, ry)
}

// ── Sample sweep (H_350/H_613 byte-identical sweep + induced hivemind) ──
fn run_sweep() -> dict {
    let mut si_arr = []
    let mut phid_cov_arr = []
    let mut syn_total_arr = []
    let mut syn_ratio_arr = []
    let mut g_focus_arr = []

    let g_focus_vals = [1.0, 3.0, 5.0, 7.0, 10.0]
    let stim_seeds = [11111, 77777]

    let mut dom = 0
    while dom < SV_N_DOM {
        let mut gi = 0
        while gi < 5 {
            let g_focus = g_focus_vals[gi]
            let g_rest = (SV_CAPACITY - g_focus) / 3.0
            let mut g0 = g_rest
            let mut g1 = g_rest
            let mut g2 = g_rest
            let mut g3 = g_rest
            if dom == 0 { g0 = g_focus }
            if dom == 1 { g1 = g_focus }
            if dom == 2 { g2 = g_focus }
            if dom == 3 { g3 = g_focus }
            let mut si_idx = 0
            while si_idx < 2 {
                let stim = stim_seeds[si_idx]
                let flat = build_profile_state(g0, g1, g2, g3, SV_D, stim)
                let dphi = domain_phi_vector(flat, SV_D)
                let si_val = savant_index(dphi)
                let cov_val = phi_diversity_cov(dphi)
                let n_xor = n_xor_from_g_focus(g_focus)
                let syn_t = synergy_total_from_n_xor(n_xor)
                let syn_r = synergy_ratio_from_n_xor(n_xor)
                si_arr = si_arr.push(si_val)
                phid_cov_arr = phid_cov_arr.push(cov_val)
                syn_total_arr = syn_total_arr.push(syn_t)
                syn_ratio_arr = syn_ratio_arr.push(syn_r)
                g_focus_arr = g_focus_arr.push(g_focus)
                si_idx = si_idx + 1
            }
            gi = gi + 1
        }
        dom = dom + 1
    }
    return #{
        "si": si_arr,
        "phid_cov": phid_cov_arr,
        "syn_total": syn_total_arr,
        "syn_ratio": syn_ratio_arr,
        "g_focus": g_focus_arr,
    }
}

fn min_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] < m { m = v[i] }
        i = i + 1
    }
    return m
}

fn max_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] > m { m = v[i] }
        i = i + 1
    }
    return m
}

fn mean_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_621 verify — SI/ΦD ∥ PID synergy_ratio triangle (E×F round 4)")
    println("════════════════════════════════════════════════════════════════")
    println("  triangle: H_350 (SI∥ΦD r=0.93) · H_613 (SI∥ΦD_cov r=0.99) · H_355 (PID ratio=1)")
    println("  bridge: K = g_focus/SV_CAPACITY → n_xor = round(3K) → synergy = n_xor")
    println("  H1: Spearman ρ(ΦD_cov, synergy_total) > 0.5 ; FAL: ρ < 0.3")
    println("  N = 4 dom × 5 g_focus × 2 stim = 40")
    println("")

    // §A1 sanity-check: H_355 anchor recompute (n_xor 0..3, full PID)
    println("──────────────────────────────────────────────────────────────")
    println("  §A1 sanity anchor (H_355 micro-recompute, n_xor 0..3):")
    let mut nx = 0
    while nx < 4 {
        let mask = anchor_mask(nx)
        let s = syn_total_mask(mask)
        println("    n_xor=" + str(nx) + " mask=" + str(mask) + " synergy_total=" + str(s))
        nx = nx + 1
    }
    println("──────────────────────────────────────────────────────────────")
    println("")

    let res = run_sweep()
    let si_arr     = res["si"]
    let phid_cov   = res["phid_cov"]
    let syn_total  = res["syn_total"]
    let syn_ratio  = res["syn_ratio"]
    let g_focus_a  = res["g_focus"]

    let n = len(si_arr)
    println("  sample count = " + str(n))
    println("  SI range          = [" + str(min_arr(si_arr)) + ", " + str(max_arr(si_arr)) + "] mean=" + str(mean_arr(si_arr)))
    println("  ΦD_cov range      = [" + str(min_arr(phid_cov)) + ", " + str(max_arr(phid_cov)) + "] mean=" + str(mean_arr(phid_cov)))
    println("  synergy_total rg  = [" + str(min_arr(syn_total)) + ", " + str(max_arr(syn_total)) + "] mean=" + str(mean_arr(syn_total)))
    println("  synergy_ratio rg  = [" + str(min_arr(syn_ratio)) + ", " + str(max_arr(syn_ratio)) + "] mean=" + str(mean_arr(syn_ratio)))
    println("")

    // Primary: ρ(ΦD_cov, synergy_total)
    let rho_phid_syn = spearman_corr(phid_cov, syn_total)
    let r_phid_syn   = pearson_corr(phid_cov, syn_total)
    // Secondary: ρ(SI, synergy_total)
    let rho_si_syn = spearman_corr(si_arr, syn_total)
    let r_si_syn   = pearson_corr(si_arr, syn_total)
    // Anchor: ρ(g_focus, synergy_total) — should be near 1 by construction
    let rho_gf_syn = spearman_corr(g_focus_a, syn_total)

    println("──────────────────────────────────────────────────────────────")
    println("  PRIMARY  ΦD_cov ~ synergy_total:")
    println("    Spearman ρ = " + str(rho_phid_syn))
    println("    Pearson  r = " + str(r_phid_syn))
    println("")
    println("  SECONDARY  SI ~ synergy_total:")
    println("    Spearman ρ = " + str(rho_si_syn))
    println("    Pearson  r = " + str(r_si_syn))
    println("")
    println("  ANCHOR  g_focus ~ synergy_total (construction monotone):")
    println("    Spearman ρ = " + str(rho_gf_syn))
    println("──────────────────────────────────────────────────────────────")

    println("")
    println("  sample preview (g_focus, SI, ΦD_cov, syn_total):")
    let mut k = 0
    while k < 10 {
        println("    [" + str(k) + "] gf=" + str(g_focus_a[k]) + " SI=" + str(si_arr[k]) + " cov=" + str(phid_cov[k]) + " syn=" + str(syn_total[k]))
        k = k + 1
    }
    println("    ...")
    let mut kk = n - 4
    while kk < n {
        println("    [" + str(kk) + "] gf=" + str(g_focus_a[kk]) + " SI=" + str(si_arr[kk]) + " cov=" + str(phid_cov[kk]) + " syn=" + str(syn_total[kk]))
        kk = kk + 1
    }
    println("")

    // Verdict
    let mut pass = true
    let mut reason = ""
    if rho_phid_syn < 0.3 {
        pass = false
        reason = "Spearman ρ(ΦD_cov, syn_total)=" + str(rho_phid_syn) + " < 0.3 — FALSIFIED (Φ-diversity ⊥ PID synergy)"
    }
    let mut partial = false
    if pass && rho_phid_syn < 0.5 {
        partial = true
    }

    println("══════════════════════════════════════════════════════════════")
    if !pass {
        println("  VERDICT: 🔴 FALSIFIED")
        println("  " + reason)
    } else if partial {
        println("  VERDICT: 🟡 PARTIAL")
        println("  ρ(ΦD_cov, syn_total) = " + str(rho_phid_syn) + " ∈ [0.3, 0.5)")
        println("  cross-link 약함 (FAL bar 0.3 통과, H1 strict bar 0.5 미달)")
    } else {
        println("  VERDICT: 🟢 SUPPORTED-NUMERICAL")
        println("  ρ(ΦD_cov, syn_total) = " + str(rho_phid_syn) + " ≥ 0.5")
        println("  ρ(SI,     syn_total) = " + str(rho_si_syn))
        println("  cross-substrate triangle: savant ΦD ∥ hivemind PID synergy")
    }
    println("══════════════════════════════════════════════════════════════")
}
