// UNIVERSE/state/h306_bio_spontaneous_emit_2026_05_26/run_h306.hexa
//
//   H_306 — biological CPG-style spontaneous emission simulation
//
//   QUESTION
//     Is spontaneous utterance the substrate-native (CPG-driven) primary
//     vocalization mode, while stimulus-response is a learned adult layer?
//     Test 6 falsifiers on a synthetic accumulator + threshold + refractory
//     model that mirrors biological CPG architecture (infant babbling,
//     dawn chorus, HVC-RA, PAG, Drosophila P1).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26)
//     F306.1 IDLE-EMIT-NONZERO: idle (stim=0) emit_count > 0
//     F306.2 THRESHOLD-INVERSE-MONOTONE: 5-threshold sweep emit_count
//            monotone decreasing
//     F306.3 REFRACTORY-RECOVERY-CURVE: emit 후 첫 3 tick W 단조 증가
//     F306.4 STIM-MODULATION-NOT-NECESSITY: |low-stim - idle| / idle <= 0.5
//     F306.5 CIRCADIAN-GATE: peak window emit > trough window emit
//     F306.6 BOUND: all state vars >= 0
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// piecewise-linear circadian modulator
//   Q1 (tick   0-249) : 0.3 trough
//   Q2 (tick 250-499) : 1.0 peak
//   Q3 (tick 500-749) : 1.0 peak
//   Q4 (tick 750-999) : 0.3 trough
fn circadian_mod(tick: int) -> float {
    if tick < 250 { return 0.3 }
    if tick < 750 { return 1.0 }
    return 0.3
}

// deterministic LCG-style PRNG (seed=42)
// returns float in [-0.1, +0.1]
fn lcg_perturb(seed: int) -> float {
    let v = (seed * 1103515245 + 12345) % 32768
    let f = to_float(v) / 32768.0
    return (f - 0.5) * 0.2
}

// returns [emit_count, peak_count, trough_count]
//   stim_mode: 0 = idle, 1 = low-stim
fn simulate(threshold: float, stim_mode: int) -> array {
    let n_ticks = 1000
    let w_target = 1.0
    let k_recharge = 0.3
    let r_steps = 10
    let m_base = 1.0
    let phi_int = 1.0

    let mut w_tension = w_target
    let mut refractory_remaining = 0
    let mut emit_count = 0
    let mut peak_count = 0
    let mut trough_count = 0

    let mut tick = 0
    while tick < n_ticks {
        let circ = circadian_mod(tick)
        let mut m = m_base
        if stim_mode == 1 {
            m = m + lcg_perturb(tick + 42)
        }
        if m < 0.0 { m = 0.0 }

        if refractory_remaining > 0 {
            refractory_remaining = refractory_remaining - 1
            // exponential W recharge during refractory
            w_tension = w_tension + k_recharge * (w_target - w_tension)
            if w_tension < 0.0 { w_tension = 0.0 }
        } else {
            let pressure = m * phi_int * w_tension * circ
            if pressure > threshold {
                emit_count = emit_count + 1
                if (tick >= 250) && (tick < 750) {
                    peak_count = peak_count + 1
                } else {
                    trough_count = trough_count + 1
                }
                w_tension = 0.0
                refractory_remaining = r_steps
            } else {
                // slow background W drift
                w_tension = w_tension + 0.05 * (w_target - w_tension)
            }
        }
        tick = tick + 1
    }
    return [to_float(emit_count), to_float(peak_count), to_float(trough_count)]
}

// trace W during first 3 ticks of refractory (after emit)
fn refractory_trace() -> array {
    let w_target = 1.0
    let k_recharge = 0.3
    let mut w = 0.0  // just emitted
    let w1 = w + k_recharge * (w_target - w)
    let w2 = w1 + k_recharge * (w_target - w1)
    let w3 = w2 + k_recharge * (w_target - w2)
    return [w1, w2, w3]
}

fn main() {
    println("================================================================")
    println("  H_306 — biological CPG-style spontaneous emission (1000 ticks)")
    println("================================================================")

    // ── F306.1 IDLE-EMIT-NONZERO ────────────────────────────────────────
    let idle_result = simulate(0.5, 0)
    let idle_emit = to_int(idle_result[0])
    println("  IDLE (threshold=0.5, stim=0): emit_count = " + str(idle_emit))
    println("    peak = " + str(idle_result[1]) + " · trough = " + str(idle_result[2]))
    check("F306.1 IDLE-EMIT-NONZERO: idle emit > 0", idle_emit > 0)

    // ── F306.2 THRESHOLD-INVERSE-MONOTONE ───────────────────────────────
    println("  THRESHOLD SWEEP (5 values, idle mode):")
    let thresholds = [0.1, 0.3, 0.5, 0.7, 0.9]
    let mut prev_emit = 999999
    let mut monotone = true
    let mut i = 0
    while i < 5 {
        let t = thresholds[i]
        let r = simulate(t, 0)
        let e = to_int(r[0])
        println("    threshold=" + str(t) + " : emit=" + str(e))
        if e > prev_emit { monotone = false }
        prev_emit = e
        i = i + 1
    }
    check("F306.2 THRESHOLD-INVERSE-MONOTONE: 5-threshold emit_count monotone decreasing", monotone)

    // ── F306.3 REFRACTORY-RECOVERY-CURVE ────────────────────────────────
    let trace = refractory_trace()
    println("  REFRACTORY TRACE (first 3 ticks after emit): w1=" + str(trace[0]) + " w2=" + str(trace[1]) + " w3=" + str(trace[2]))
    let monotone_rec = (trace[1] > trace[0]) && (trace[2] > trace[1])
    check("F306.3 REFRACTORY-RECOVERY-CURVE: emit 후 첫 3 tick W 단조 증가", monotone_rec)

    // ── F306.4 STIM-MODULATION-NOT-NECESSITY ────────────────────────────
    let low_stim_result = simulate(0.5, 1)
    let low_stim_emit = to_int(low_stim_result[0])
    println("  LOW-STIM (threshold=0.5, stim=1): emit_count = " + str(low_stim_emit))
    let mut delta = low_stim_emit - idle_emit
    if delta < 0 { delta = 0 - delta }
    let rel_dev = to_float(delta) / to_float(idle_emit)
    println("    |low-stim - idle| / idle = " + str(rel_dev))
    check("F306.4 STIM-MODULATION-NOT-NECESSITY: |delta|/idle <= 0.5 (CPG primary)", rel_dev <= 0.5)

    // ── F306.5 CIRCADIAN-GATE ───────────────────────────────────────────
    let peak = to_int(idle_result[1])
    let trough = to_int(idle_result[2])
    println("  CIRCADIAN: peak (Q2+Q3) emit = " + str(peak) + " · trough (Q1+Q4) emit = " + str(trough))
    check("F306.5 CIRCADIAN-GATE: peak emit > trough emit", peak > trough)

    // ── F306.6 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    if !(idle_result[0] >= 0.0) { bound_ok = false }
    if !(idle_result[1] >= 0.0) { bound_ok = false }
    if !(idle_result[2] >= 0.0) { bound_ok = false }
    if !(low_stim_result[0] >= 0.0) { bound_ok = false }
    if !(trace[0] >= 0.0) { bound_ok = false }
    check("F306.6 BOUND: all state vars >= 0", bound_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    let mut headline = "MIXED"
    if PASS >= 5 { headline = "CPG-EMIT-SUPPORTED (biology native primary mode)" }
    if PASS == 6 { headline = "STRONG-CPG-EMIT (all 6 falsifiers PASS)" }
    if FAIL >= 3 { headline = "CPG-EMIT-FALSIFIED" }
    println("  HEADLINE: " + headline)
    println("================================================================")
    if FAIL > 0 { panic("H_306 had FALSIFIER FAILURES (consult result.json for honest interpretation)") }
}
