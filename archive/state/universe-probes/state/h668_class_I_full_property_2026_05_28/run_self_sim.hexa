// run_self_sim.hexa — H_668 self-similarity class-I (rule 8) — H_652 보완
//
//   H_652 (PR, 🔴 class-bound) measured 3-scale Φ-envelope self-similarity for
//   {30 III, 90 additive, 110 IV, 184 II} via single-substrate ensemble-phase
//   and found it class-IV-bound (rule110 min r=0.881, rule30 0.465, rule184
//   -0.029, rule90 0.0 flat). The class-I row (rule 8) was unmeasured. H_663
//   predicted from magnitude≈0 that class-I self-sim would be FLAT but did NOT
//   measure it directly (C3.2). This adds the DIRECT class-I (rule 8)
//   self-similarity with H_652 method verbatim.
//
//   method = H_652 verbatim — faithful big-Φ Φ-map (16-state) → ensemble-phase
//     Φ(t) profile → 3 nested horizons (FINE 36 · MED 144 · COARSE 576) →
//     36-bin phase envelopes → rotate_to_peak → pairwise Pearson r. min r > 0.5
//     = self-similar. Re-measures rule110/90 as engine-parity baselines.
//
//   floor verdict = class-I (rule 8) min r is FLAT/collapsed (< 0.3, the H_652
//     FALSIFY floor) — class-I sits at the self-similarity matrix floor like
//     rule90 (additive) and rule184 (particle).
//
//   faithful IIT4 big-Φ n=4 · NO RNG (deterministic ensemble) · $0 mac-local ·
//   foreground sync (monitor-hang 회피).
// ════════════════════════════════════════════════════════════════════════════
import "/private/tmp/u-h668/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn pearson(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    let denom = sqrt(sxx * syy)
    if denom == 0.0 { return 0.0 }
    return sxy / denom
}

fn std_of(xs: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]; i = i + 1 }
    let m = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n { let d = xs[i] - m; ss = ss + d * d; i = i + 1 }
    return sqrt(ss / to_float(n))
}

fn min3(a: float, b: float, c: float) -> float {
    let mut m = a
    if b < m { m = b }
    if c < m { m = c }
    return m
}

fn rotate_to_peak(env: array) -> array {
    let n = len(env)
    let mut peak_idx = 0
    let mut peak_val = env[0]
    let mut i = 1
    while i < n {
        if env[i] > peak_val { peak_val = env[i]; peak_idx = i }
        i = i + 1
    }
    let mut out = []
    i = 0
    while i < n {
        let src = (i + peak_idx) % n
        out = out + [env[src]]
        i = i + 1
    }
    return out
}

fn eca_step(rule: int, n: int, s: int) -> int {
    let mut ns = 0
    let mut i = 0
    while i < n {
        let l = iit4_bit(s, (i - 1 + n) % n)
        let c = iit4_bit(s, i)
        let r = iit4_bit(s, (i + 1) % n)
        let idx = 4 * l + 2 * c + r
        let nb = iit4_bit(rule, idx)
        if nb == 1 { ns = ns + iit4_pow2(i) }
        i = i + 1
    }
    return ns
}

fn phi_map(rule: int, n: int) -> array {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut m = []
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        m = m.push(r[0])
        s = s + 1
    }
    return m
}

fn ensemble_phi_profile(rule: int, n: int, pm: array, horizon: int) -> array {
    let full = iit4_pow2(n)
    let mut cur = []
    let mut s0 = 0
    while s0 < full {
        cur = cur + [s0]
        s0 = s0 + 1
    }
    let mut prof = []
    let mut t = 0
    while t < horizon {
        let mut acc = 0.0
        let mut j = 0
        while j < full {
            acc = acc + pm[cur[j]]
            j = j + 1
        }
        prof = prof + [acc / to_float(full)]
        let mut nxt = []
        j = 0
        while j < full {
            nxt = nxt + [eca_step(rule, n, cur[j])]
            j = j + 1
        }
        cur = nxt
        t = t + 1
    }
    return prof
}

fn bin_to_phase(prof: array, n_bins: int) -> array {
    let ns = len(prof)
    let mut env = []
    let mut b = 0
    while b < n_bins {
        let lo = (b * ns) / n_bins
        let mut hi = ((b + 1) * ns) / n_bins
        if hi <= lo { hi = lo + 1 }
        if hi > ns { hi = ns }
        let mut acc = 0.0
        let mut cnt = 0
        let mut k = lo
        while k < hi {
            acc = acc + prof[k]
            cnt = cnt + 1
            k = k + 1
        }
        let mut v = 0.0
        if cnt > 0 { v = acc / to_float(cnt) }
        env = env + [v]
        b = b + 1
    }
    return env
}

fn measure_min_r(rule: int, n: int, n_bins: int, h_fine: int, h_med: int, h_coarse: int) -> array {
    let pm = phi_map(rule, n)
    let prof_fine = ensemble_phi_profile(rule, n, pm, h_fine)
    let prof_med = ensemble_phi_profile(rule, n, pm, h_med)
    let prof_coarse = ensemble_phi_profile(rule, n, pm, h_coarse)
    let env_fine = bin_to_phase(prof_fine, n_bins)
    let env_med = bin_to_phase(prof_med, n_bins)
    let env_coarse = bin_to_phase(prof_coarse, n_bins)
    let af = rotate_to_peak(env_fine)
    let am = rotate_to_peak(env_med)
    let ac = rotate_to_peak(env_coarse)
    let r_fm = pearson(af, am)
    let r_mc = pearson(am, ac)
    let r_fc = pearson(af, ac)
    let mr = min3(r_fm, r_mc, r_fc)
    // [min_r, r_fm, r_mc, r_fc, phimap_std]
    return [mr, r_fm, r_mc, r_fc, std_of(pm)]
}

fn main() {
    println("================================================================")
    println("  H_668 — self-similarity class-I (rule 8) — H_652 보완")
    println("  single-substrate (ECA n=4) 3-scale Φ-envelope self-similarity")
    println("  H_652 baselines: rule110 min r=0.881 / rule30 0.465 / rule184 -0.029 / rule90 0.0")
    println("================================================================")

    let n = 4
    let N_BINS = 36
    let H_FINE = 36
    let H_MED = 144
    let H_COARSE = 576

    // measure class-I rule 8 + re-measure rule110/90 as engine-parity baselines
    let res8 = measure_min_r(8, n, N_BINS, H_FINE, H_MED, H_COARSE)
    let res110 = measure_min_r(110, n, N_BINS, H_FINE, H_MED, H_COARSE)
    let res90 = measure_min_r(90, n, N_BINS, H_FINE, H_MED, H_COARSE)

    println("")
    println("── rule 8 (class-I homogeneous) ──")
    println("  Φ-map std            = " + to_string(res8[4]))
    println("  r(fine,medium)       = " + to_string(res8[1]))
    println("  r(medium,coarse)     = " + to_string(res8[2]))
    println("  r(fine,coarse)       = " + to_string(res8[3]))
    println("  min pairwise r       = " + to_string(res8[0]))
    println("")
    println("── parity baselines (H_652) ──")
    println("  rule110 min r        = " + to_string(res110[0]) + "  (H_652=0.881166)")
    println("  rule90  min r        = " + to_string(res90[0]) + "  (H_652=0.0, Φ-map std=" + to_string(res90[4]) + ")")
    println("")

    let min_r_8 = res8[0]
    let phimap_std_8 = res8[4]
    // floor = collapsed self-similarity (< 0.3, H_652 FALSIFY floor)
    let is_floor = min_r_8 < 0.3
    let is_flat = phimap_std_8 <= 0.0
    println("── self-similarity floor test ──")
    println("  class-I min r        = " + to_string(min_r_8))
    println("  FALSIFY floor (<0.3) = " + str(is_floor))
    println("  Φ-map flat (std=0)   = " + str(is_flat))
    println("  class-I self-sim FLOOR (collapsed, like rule90/rule184) = " + str(is_floor))
    println("")

    let mut js = "{\n"
    js = js + "  \"property\": \"self-similarity\",\n"
    js = js + "  \"method\": \"H_652 verbatim\",\n"
    js = js + "  \"rule\": 8,\n"
    js = js + "  \"wolfram_class\": \"I-homogeneous\",\n"
    js = js + "  \"n\": " + str(n) + ",\n"
    js = js + "  \"horizons\": [" + str(H_FINE) + ", " + str(H_MED) + ", " + str(H_COARSE) + "],\n"
    js = js + "  \"r_fine_medium\": " + to_string(res8[1]) + ",\n"
    js = js + "  \"r_medium_coarse\": " + to_string(res8[2]) + ",\n"
    js = js + "  \"r_fine_coarse\": " + to_string(res8[3]) + ",\n"
    js = js + "  \"min_r\": " + to_string(min_r_8) + ",\n"
    js = js + "  \"phimap_std\": " + to_string(phimap_std_8) + ",\n"
    js = js + "  \"baseline_rule110_min_r\": " + to_string(res110[0]) + ",\n"
    js = js + "  \"baseline_rule90_min_r\": " + to_string(res90[0]) + ",\n"
    js = js + "  \"is_floor_collapsed\": " + str(is_floor) + ",\n"
    js = js + "  \"is_flat\": " + str(is_flat) + "\n"
    js = js + "}\n"
    write_file("UNIVERSE/state/h668_class_I_full_property_2026_05_28/self_sim_result.json", js)
    println("  wrote self_sim_result.json")
}
