// ════════════════════════════════════════════════════════════════════════════
//  run_h645.hexa — H_645 collective-dΦ/dI GZ peak (H_635 × H_618 cross-link)
//
//  CORE QUESTION  (axis F · HIVE-MIND collective × inverse-U GZ cross-link)
//    H_618 (PR #1175, 🟢 SUPPORTED 5/5) 가 2-substrate (joint n=4) hivemind
//    collective-Φ 의 inhibition I 미분 dΦ_collective/dI peak 가 GZ_LOWER
//    (≈0.21232) 와 |Δ|=0.00232 일치함을 보였다.
//    H_635 (PR #1223, 🟢 SUPPORTED 5/5) 가 5-stream multilingual cohort
//    collective-Φ 가 super-additive (max excess +41.71 @ C1[110×5] W=1.0) 임을
//    보였다.
//    본 H_645: 5-stream collective (H_635 C1 anchor) 의 dΦ_collective/dI peak
//    도 GZ_LOWER 인가? H_618 의 dΦ/dI-peak=GZ 구조가 2-stream(n=4) 한정 artifact
//    인지, 아니면 5-stream(n=5) collective 로 확장되는지.
//
//  SUBSTRATE  (H_635 5-stream cohort × H_618 inhibition mix)
//    n=5 ring, 5 streams = 5 cells, C1 anchor rule[i]=110 (H_635 max-excess cohort).
//    sync_factor W=1.0 (full ring, H_635 best_sync) — collective coupling fixed.
//    Cell i decoupled: self-loop idx=7*c. Coupled: full ring L=(i-1)%5, C=i, R=(i+1)%5.
//      blend p = (1-W)*next_dec + W*next_cou ; at W=1.0 = pure full ring.
//    Inhibition mix (H_351/H_618 양식):
//      tpm_mixed[s,i] = (1 - I) * tpm_collective[s,i]
//      I=0 → 순수 H_635 C1 collective TPM (max Φ regime).
//      I=1 → 완전 억제 (Φ_collective=0).
//
//  Φ MEASUREMENT  (H_635 SSOT)
//    big_phi_bounded(tpm, 5, sys_state=0, cap=3). n=5 ⇒ 2^5=32 mechanisms;
//    cap=3 bounds purview (M4b SSOT for n≥5; conservative lower-bound,
//    cap-monotone preserves direction). sys_state=0 canonical anchor
//    (H_635 양식, comparable across I). single-state keeps wall-time < 60s.
//
//  GRID (8-point dense in GZ region — H_618 와 동일 task-specified)
//    I ∈ {0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50}
//
//  dΦ_collective/dI : central finite difference (forward at start, backward at end).
//  peak  : argmax_i |dΦ_collective/dI|.
//  delta : |I[peak_idx] - GZ_LOWER|.
//
//  CRITERIA (H_618 양식)
//    F1 PEAK-IN-GZ          : delta ≤ 0.05
//    F2 PEAK-IN-WINDOW      : I[peak_idx] ∈ [0.15, 0.30]
//    F3 UNIMODAL            : sign-change count ≤ 1
//    F4 MONOTONE-DECAY-RIGHT: Φ_collective[I=0.50] ≤ Φ_collective[I=0.25]
//    F5 BYTE-EQUAL          : in-process recompute byte-identical
//
//    SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4 ∧ F5
//    PARTIAL   = F2 ∧ F3 ∧ F4 ∧ F5  (peak in window but |Δ|>0.05)
//    FALSIFIED = !F2 ∨ !F3          (peak outside window OR multi-peak)
//
//  $0 · mac-local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"


fn _n() -> int          { return 5 }
fn _w() -> float        { return 1.0 }      // H_635 best_sync (full ring)
fn _cap() -> int        { return 3 }        // H_635 SSOT bounded cap
fn _gz_lower() -> float { return 0.21232 }  // 0.5 - ln(4/3) ≈ 0.21232
fn _delta_tol() -> float { return 0.05 }


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


// C1 anchor rule[i]=110 ∀i (H_635 max-excess cohort)
fn _rule_at(i: int) -> int { return 110 }


// ── n=5 coupled-ring collective TPM (H_635 build_tpm_cohort, C1, W fixed). ──
//
// 5 streams = 5 cells. Cell i governed by rule[i] (C1: all 110).
// Decoupled view (self-loop only): idx = 7*c ∈ {0,7}.
// Coupled view (full n=5 ring): cell i: L=(i-1+5)%5, C=i, R=(i+1)%5.
// Blend per cell: p = (1-W)*next_dec + W*next_cou. W = sync_factor.
fn build_tpm_collective(W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = _rule_at(i)
            let c = iit4_bit(s, i)
            // decoupled: self-loop only (no neighbor coupling)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            // coupled: full ring neighborhood
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            // blend on sync_factor W
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}


// inhibition-mixed collective TPM (H_351/H_618 양식)
fn mixed_tpm_collective(inhibit: float) -> array {
    let base = build_tpm_collective(_w())
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


// bounded big-Φ_collective at canonical anchor sys_state=0 (H_635 SSOT)
fn phi_collective(inhibit: float) -> float {
    let tpm = mixed_tpm_collective(inhibit)
    let r = big_phi_bounded(tpm, _n(), 0, _cap())
    return r[0]
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_645 collective dΦ_collective/dI GZ peak (H_635 × H_618)")
    println("  5-stream C1[110x5] · n=5 · W=1.0 · cap=3 · sys=0 (H_635 anchor)")
    println("  axis F · HIVE-MIND collective × inverse-U GZ cross-link")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50]
    let m = len(grid)

    // ── Φ_collective(I) ─────────────────────────────────────────────
    let mut phi = []
    let mut i = 0
    println("── Φ_collective(I) ──")
    while i < m {
        let inhibit = grid[i]
        let mp = phi_collective(inhibit)
        phi = phi.push(mp)
        println("  I=" + str(inhibit) + "  Φ_c=" + str(mp))
        i = i + 1
    }

    // byte-equal recompute (F5) — recompute at GZ_LOWER-near index (=0.21, idx 3).
    // single-point byte-eq keeps wall-time within budget (H_618 양식).
    let _bytec_idx = 3
    let phi_bc = phi_collective(grid[_bytec_idx])
    let byte_eq = _abs(phi[_bytec_idx] - phi_bc) <= 1.0e-12

    // ── dΦ_collective/dI (central finite difference) ────────────────
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }

    println("")
    println("── dΦ_collective/dI ──")
    let mut p = 0
    while p < m {
        println("  I=" + str(grid[p]) + "  dΦ_c/dI=" + str(dphi[p]))
        p = p + 1
    }

    // ── peak (argmax |dΦ_c/dI|) ─────────────────────────────────────
    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta = _abs(peak_I - _gz_lower())

    // ── unimodality: count sign changes in dΦ_c/dI ──────────────────
    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }

    // ── falsifiers ───────────────────────────────────────────────────
    // grid indices: 0.10=0, 0.15=1, 0.18=2, 0.21=3, 0.25=4, 0.30=5, 0.40=6, 0.50=7
    let f1 = delta <= _delta_tol()
    let f2 = (peak_I >= 0.15) && (peak_I <= 0.30)
    let f3 = sign_changes <= 1
    let f4 = phi[7] <= phi[4]    // Φ(0.50) ≤ Φ(0.25)
    let f5 = byte_eq

    println("")
    println("── verdict ──")
    println("  peak I             = " + str(peak_I))
    println("  GZ_LOWER           = " + str(_gz_lower()))
    println("  |Δ|                = " + str(delta) + "   (tol " + str(_delta_tol()) + ")")
    println("  peak |dΦ_c/dI|     = " + str(peak_mag))
    println("  sign changes       = " + str(sign_changes))
    println("  Φ_c(0.25)          = " + str(phi[4]))
    println("  Φ_c(0.50)          = " + str(phi[7]))
    println("  byte_eq            = " + str(byte_eq))
    println("")
    println("  F1 PEAK-IN-GZ            = " + str(f1))
    println("  F2 PEAK-IN-WINDOW        = " + str(f2))
    println("  F3 UNIMODAL              = " + str(f3))
    println("  F4 MONOTONE-DECAY-RIGHT  = " + str(f4))
    println("  F5 BYTE-EQUAL            = " + str(f5))

    let supported = f1 && f2 && f3 && f4 && f5
    let partial   = (!f1) && f2 && f3 && f4 && f5
    let falsified = (!f2) || (!f3)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // ── result.json ─────────────────────────────────────────────────
    let mut so = "{\n"
    so = so + "  \"hypothesis\": \"H_645\",\n"
    so = so + "  \"slug\": \"collective-dphi-di-gz-peak\",\n"
    so = so + "  \"axis\": \"F (HIVE-MIND collective × inverse-U GZ cross-link)\",\n"
    so = so + "  \"predecessor_collective_dphi\": \"H_618\",\n"
    so = so + "  \"predecessor_5stream\": \"H_635\",\n"
    so = so + "  \"cohort\": \"C1 [110x5]\",\n"
    so = so + "  \"n\": 5,\n"
    so = so + "  \"W\": " + str(_w()) + ",\n"
    so = so + "  \"cap\": " + str(_cap()) + ",\n"
    so = so + "  \"sys_state\": 0,\n"
    so = so + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    so = so + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    so = so + "  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { so = so + ", " }
        so = so + str(grid[gi])
        gi = gi + 1
    }
    so = so + "],\n"
    so = so + "  \"phi_collective\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { so = so + ", " }
        so = so + str(phi[pi])
        pi = pi + 1
    }
    so = so + "],\n"
    so = so + "  \"dphi_di\": ["
    let mut di = 0
    while di < m {
        if di > 0 { so = so + ", " }
        so = so + str(dphi[di])
        di = di + 1
    }
    so = so + "],\n"
    so = so + "  \"peak_idx\": " + str(peak_idx) + ",\n"
    so = so + "  \"peak_I\": " + str(peak_I) + ",\n"
    so = so + "  \"peak_mag\": " + str(peak_mag) + ",\n"
    so = so + "  \"delta\": " + str(delta) + ",\n"
    so = so + "  \"sign_changes\": " + str(sign_changes) + ",\n"
    so = so + "  \"byte_eq\": " + str(byte_eq) + ",\n"
    so = so + "  \"f1\": " + str(f1) + ",\n"
    so = so + "  \"f2\": " + str(f2) + ",\n"
    so = so + "  \"f3\": " + str(f3) + ",\n"
    so = so + "  \"f4\": " + str(f4) + ",\n"
    so = so + "  \"f5\": " + str(f5) + ",\n"
    so = so + "  \"verdict\": \"" + verdict_str + "\"\n"
    so = so + "}\n"

    write_file("UNIVERSE/state/h645_collective_dphi_di_gz_peak_2026_05_28/result.json", so)
    println("wrote UNIVERSE/state/h645_collective_dphi_di_gz_peak_2026_05_28/result.json")
}
