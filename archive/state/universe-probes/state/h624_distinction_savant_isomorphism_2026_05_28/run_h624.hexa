// ════════════════════════════════════════════════════════════════════════════
//  run_h624.hexa — H_624 IIT4 distinction × SAVANT cell isomorphism
//
//  axis C (full-IIT4 cause-effect structure) · C2 row.
//
//  CORE QUESTION
//    H_618 (PR #1175) collective dΦ/dI peak ∥ GZ_LOWER 발견 — *왜* 정렬되는지
//    구조 차원 미답. round 4 = IIT4 Φ-structure 의 distinction 이 SAVANT
//    4-domain cell 과 *isomorphic* 한지 검정.
//
//  HYPOTHESIS (H1)
//    savant_phi 4-domain cell {CALENDAR, MUSIC, ART, MEMORY} 의 internal Φ
//    와 IIT4 distinction 의 small-φ 가 cell-by-cell 일대일 대응:
//      Spearman ρ(cell_phi[i], distinction_phi[i]) > 0.7
//    pooled over 5 gain profiles × 4 cells = N=20 paired samples.
//
//  FALSIFIER (H0)
//    ρ < 0.5 (대응 약함) — cell 분해와 distinction 분해가 다른 기저.
//
//  SUBSTRATE
//    4-cell binary TPM `tpm_savant[s,i]`, gain-parameterized:
//      g_i ∈ [0.5, 10.0]  per cell.
//      sig_i = g_i / (1.0 + g_i)   (gain → signal-strength ∈ [0,1])
//      noise_i = 1.0 - sig_i        (noise share)
//      structural_next[s,i] = MAJ(bit_self, bit_left, bit_right)
//                              — auto-regression + ring-neighbor mix (so the
//                              cell has both causal grip on itself AND
//                              influence from neighbors; pure XOR of neighbors
//                              loses self-effect and singleton distinction → 0
//                              regardless of gain, probed and confirmed).
//      p_next[s,i] = sig_i * structural_next + noise_i * 0.5
//    Identity-blanket noise (0.5) means low-gain cells lose causal grip,
//    matching savant_phi's "near-silent module" mechanism (Treffert
//    "little island in sea of disability").
//
//  CELL Φ MEASUREMENT (savant_phi adapted, inline)
//    cell_phi[i] = phi_module( build_domain_activation(i, d=6, g_i, stim) )
//      where phi_module(v) = mean |v[j]|^1.5  (super-linear energy proxy).
//
//  DISTINCTION Φ MEASUREMENT (IIT4 stdlib)
//    For each sys_state s in [0, 16) and each singleton mechanism mask=1<<i:
//      d = distinction(tpm_savant, 4, 1<<i, s)
//      phi_d[s,i] = d[0]  (= min(phi_cause, phi_effect))
//    cell_distinction_phi[i] = mean_s phi_d[s, i]   (mean over 16 sys_states)
//
//  PROFILES (5 gain vectors, balanced + 4 single-hypertrophy)
//      P0 BALANCED      = (2.875, 2.875, 2.875, 2.875)   (capacity/4 = 11.5/4)
//      P1 CALENDAR-DOM  = (10.0,  0.5,   0.5,   0.5  )
//      P2 MUSIC-DOM     = (0.5,   10.0,  0.5,   0.5  )
//      P3 ART-DOM       = (0.5,   0.5,   10.0,  0.5  )
//      P4 MEMORY-DOM    = (0.5,   0.5,   0.5,   10.0 )
//
//    For each profile, 4 paired samples (one per cell).
//    Total N = 5 × 4 = 20 paired samples for Spearman ρ.
//
//  CRITERIA
//    F1  ISOMORPH-STRONG  : Spearman ρ ≥ 0.7
//    F2  ISOMORPH-WEAK    : Spearman ρ ≥ 0.5
//    F3  PEARSON-CONSIST  : Pearson r  ≥ 0.5  (linear consistency)
//    F4  PER-PROFILE-RANK : per-profile argmax(cell_phi) == argmax(dist_phi)
//                          for each non-balanced profile (4/4)
//    F5  BYTE-EQUAL       : in-process recompute byte-identical
//
//    SUPPORTED  = F1 ∧ F3 ∧ F4 ∧ F5
//    PARTIAL    = F2 ∧ F3 ∧ F5  (correspondence weak but present)
//    FALSIFIED  = ¬F2  (ρ < 0.5)
//
//  $0 · mac-local · hexa-only · deterministic · NO ckpt.
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4_distinction.hexa"


// ── SAVANT primitives (inline, h350-style — single-file verify) ────────────
let SV_D = 6
let SV_N_DOM = 4

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

// d-dim activation vector for domain k under gain
fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

// phi_module(v) = mean |v[j]|^1.5 — super-linear energy proxy
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            // |x|^1.5 = |x| * sqrt(|x|) via Newton sqrt
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

// 4-cell vector of savant cell-Φ under gain profile
fn savant_cell_phi(g0: float, g1: float, g2: float, g3: float, stim_seed: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let v = build_domain_activation(k, SV_D, g, stim_seed)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}


// ── Substrate TPM — 4 cells, gain-parameterized noise mix ──────────────────
//
// Cells arranged on n=4 ring; each cell's "structural next" = XOR of its two
// ring-neighbors (deterministic component). Per-cell noise mix scaled by gain:
//   sig_i  = g_i / (1.0 + g_i)        ∈ [0,1]   (gain saturation)
//   p[s,i] = sig_i * struct_next[s,i] + (1 - sig_i) * 0.5
//
// High gain ⇒ near-deterministic structural cause ⇒ high distinction φ.
// Low gain  ⇒ near-uniform 0.5 ⇒ no causal grip ⇒ zero distinction φ.
fn _bit(s: int, i: int) -> int {
    if iit4_bit(s, i) == 1 { return 1 }
    return 0
}

// majority of (self, left, right) — gives the cell causal grip on its own
// next state AND mixes neighbors. Pure XOR(neighbors) leaves self-effect=0
// (probed and confirmed: distinction phi_effect=0 ∀ singleton mech).
fn struct_next(s: int, i: int) -> int {
    let mut left_i = 0
    let mut right_i = 0
    if i == 0 { left_i = 3; right_i = 1 }
    if i == 1 { left_i = 0; right_i = 2 }
    if i == 2 { left_i = 1; right_i = 3 }
    if i == 3 { left_i = 2; right_i = 0 }
    let bs = _bit(s, i)
    let bl = _bit(s, left_i)
    let br = _bit(s, right_i)
    let total = bs + bl + br
    if total >= 2 { return 1 }
    return 0
}

fn build_savant_tpm(g0: float, g1: float, g2: float, g3: float) -> array {
    let n = 4
    let full = 16
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let mut g = g0
            if i == 1 { g = g1 }
            if i == 2 { g = g2 }
            if i == 3 { g = g3 }
            let sig = g / (1.0 + g)
            let sn = struct_next(s, i)
            let p = sig * to_float(sn) + (1.0 - sig) * 0.5
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}


// ── per-cell singleton-distinction φ, mean over 16 sys_states ──────────────
fn cell_distinction_phi_vector(tpm: array) -> array {
    let n = 4
    let full = 16
    let mut out = []
    let mut i = 0
    while i < n {
        let mask = iit4_pow2(i)
        let mut sum_phi = 0.0
        let mut cnt = 0
        let mut s = 0
        while s < full {
            let d = distinction(tpm, n, mask, s)
            sum_phi = sum_phi + d[0]
            cnt = cnt + 1
            s = s + 1
        }
        out = out.push(sum_phi / to_float(cnt))
        i = i + 1
    }
    return out
}


// ── inline Spearman / Pearson on float arrays of length N (no farr) ────────
fn _array_rank(v: array, idx: int) -> float {
    let n = len(v)
    let me = v[idx]
    let mut less = 0
    let mut eq = 0
    let mut k = 0
    while k < n {
        if v[k] < me { less = less + 1 }
        if v[k] == me { eq = eq + 1 }
        k = k + 1
    }
    return to_float(less + 1) + to_float(eq - 1) / 2.0
}

fn pearson_arr(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + xs[i]
        sy = sy + ys[i]
        i = i + 1
    }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n {
        let dx = xs[j] - mx
        let dy = ys[j] - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom2 = dx2 * dy2
    if denom2 <= 0.0 { return 0.0 }
    // sqrt via Newton
    let mut r = denom2
    let mut m = 0
    while m < 16 {
        if r > 0.0 { r = (r + denom2 / r) / 2.0 }
        m = m + 1
    }
    if r <= 0.0 { return 0.0 }
    return num / r
}

fn spearman_arr(xs: array, ys: array) -> float {
    let n = len(xs)
    let mut rx = []
    let mut ry = []
    let mut k = 0
    while k < n {
        rx = rx.push(_array_rank(xs, k))
        ry = ry.push(_array_rank(ys, k))
        k = k + 1
    }
    return pearson_arr(rx, ry)
}


// ── per-profile measurement: returns parallel float arrays (cell, dist) ────
fn measure_profile(g0: float, g1: float, g2: float, g3: float, stim_seed: int) -> array {
    let cellv = savant_cell_phi(g0, g1, g2, g3, stim_seed)
    let tpm = build_savant_tpm(g0, g1, g2, g3)
    let distv = cell_distinction_phi_vector(tpm)
    // flat: [c0,c1,c2,c3, d0,d1,d2,d3]
    let mut out = []
    out = out.push(cellv[0])
    out = out.push(cellv[1])
    out = out.push(cellv[2])
    out = out.push(cellv[3])
    out = out.push(distv[0])
    out = out.push(distv[1])
    out = out.push(distv[2])
    out = out.push(distv[3])
    return out
}


// pretty-print a 4-vector
fn fmt4(v: array) -> string {
    return "[" + str(v[0]) + ", " + str(v[1]) + ", " + str(v[2]) + ", " + str(v[3]) + "]"
}

fn argmax4(v: array) -> int {
    let mut bi = 0
    let mut bv = v[0]
    let mut i = 1
    while i < 4 {
        if v[i] > bv { bv = v[i]; bi = i }
        i = i + 1
    }
    return bi
}


fn main() {
    println("[H_624] IIT4 distinction × SAVANT cell isomorphism — axis C2")
    println("  substrate: 4-cell ring, gain-modulated XOR-next + identity noise mix")
    println("  measurement: savant phi_module vs IIT4 small-φ on singleton mechs")
    println("  N=20 paired samples (5 profiles × 4 cells), Spearman ρ + Pearson r")
    println("")

    let stim = 42424

    // Five profiles: balanced + 4 single-hypertrophy
    let mut g0s = []
    let mut g1s = []
    let mut g2s = []
    let mut g3s = []
    let mut names = []

    g0s = g0s.push(2.875); g1s = g1s.push(2.875); g2s = g2s.push(2.875); g3s = g3s.push(2.875); names = names.push("P0_BALANCED")
    g0s = g0s.push(10.0);  g1s = g1s.push(0.5);   g2s = g2s.push(0.5);   g3s = g3s.push(0.5);   names = names.push("P1_CALENDAR_DOM")
    g0s = g0s.push(0.5);   g1s = g1s.push(10.0);  g2s = g2s.push(0.5);   g3s = g3s.push(0.5);   names = names.push("P2_MUSIC_DOM")
    g0s = g0s.push(0.5);   g1s = g1s.push(0.5);   g2s = g2s.push(10.0);  g3s = g3s.push(0.5);   names = names.push("P3_ART_DOM")
    g0s = g0s.push(0.5);   g1s = g1s.push(0.5);   g2s = g2s.push(0.5);   g3s = g3s.push(10.0);  names = names.push("P4_MEMORY_DOM")

    // Accumulate paired samples and per-profile argmax check
    let mut cell_pool = []
    let mut dist_pool = []
    let mut argmax_match = 0
    let mut argmax_total = 0

    let mut p = 0
    while p < 5 {
        let g0 = g0s[p]
        let g1 = g1s[p]
        let g2 = g2s[p]
        let g3 = g3s[p]
        let nm = names[p]
        let r = measure_profile(g0, g1, g2, g3, stim)
        let cellv = [r[0], r[1], r[2], r[3]]
        let distv = [r[4], r[5], r[6], r[7]]

        println("[profile " + str(p) + " " + nm + "]")
        println("  gains      = [" + str(g0) + ", " + str(g1) + ", " + str(g2) + ", " + str(g3) + "]")
        println("  cell_phi   = " + fmt4(cellv))
        println("  dist_phi   = " + fmt4(distv))
        println("  argmax_cell=" + str(argmax4(cellv)) + " argmax_dist=" + str(argmax4(distv)))

        // skip BALANCED for argmax check (no true argmax — by design degenerate)
        if p > 0 {
            argmax_total = argmax_total + 1
            if argmax4(cellv) == argmax4(distv) { argmax_match = argmax_match + 1 }
        }

        let mut i = 0
        while i < 4 {
            cell_pool = cell_pool.push(cellv[i])
            dist_pool = dist_pool.push(distv[i])
            i = i + 1
        }
        p = p + 1
    }

    println("")
    println("[pool] N=" + str(len(cell_pool)) + " paired samples")

    let rho = spearman_arr(cell_pool, dist_pool)
    let r_p = pearson_arr(cell_pool, dist_pool)

    println("  Spearman ρ = " + str(rho))
    println("  Pearson  r = " + str(r_p))
    println("  argmax-match (non-balanced) = " + str(argmax_match) + "/" + str(argmax_total))

    // byte-equal recompute (F5)
    let rho2 = spearman_arr(cell_pool, dist_pool)
    let r2 = pearson_arr(cell_pool, dist_pool)
    let mut byte_eq = true
    if rho2 != rho { byte_eq = false }
    if r2 != r_p { byte_eq = false }
    println("  byte_eq    = " + str(byte_eq))

    println("")

    // Criteria
    let f1 = rho >= 0.7
    let f2 = rho >= 0.5
    let f3 = r_p >= 0.5
    let f4 = argmax_match == argmax_total
    let f5 = byte_eq

    if f1 { println("F1 PASS — Spearman ρ ≥ 0.7  (ISOMORPH-STRONG)") } else { println("F1 FAIL — Spearman ρ = " + str(rho) + " < 0.7") }
    if f2 { println("F2 PASS — Spearman ρ ≥ 0.5  (ISOMORPH-WEAK)") } else { println("F2 FAIL — Spearman ρ < 0.5 (FALSIFIED)") }
    if f3 { println("F3 PASS — Pearson r ≥ 0.5  (linear consistency)") } else { println("F3 FAIL") }
    if f4 { println("F4 PASS — per-profile argmax match " + str(argmax_match) + "/" + str(argmax_total)) } else { println("F4 FAIL — argmax mismatch " + str(argmax_match) + "/" + str(argmax_total)) }
    if f5 { println("F5 PASS — byte_eq recompute identical") } else { println("F5 FAIL") }

    println("")
    let mut verdict = "FALSIFIED"
    if f2 && f3 && f5 {
        verdict = "PARTIAL"
        if f1 && f4 { verdict = "SUPPORTED" }
    }
    println("[H_624] verdict = " + verdict)
    println("[H_624] summary  rho=" + str(rho) + "  r=" + str(r_p) + "  argmax=" + str(argmax_match) + "/" + str(argmax_total) + "  byte_eq=" + str(byte_eq))
}
