// probe: why distinction_phi = 0 across the board?
import "stdlib/consciousness/iit4_distinction.hexa"

fn _bit(s: int, i: int) -> int {
    if iit4_bit(s, i) == 1 { return 1 }
    return 0
}

fn struct_next(s: int, i: int) -> int {
    let mut li = 0
    let mut ri = 0
    if i == 0 { li = 3; ri = 1 }
    if i == 1 { li = 0; ri = 2 }
    if i == 2 { li = 1; ri = 3 }
    if i == 3 { li = 2; ri = 0 }
    let bl = _bit(s, li)
    let br = _bit(s, ri)
    if bl != br { return 1 }
    return 0
}

fn build_tpm(g0: float, g1: float, g2: float, g3: float) -> array {
    let mut t = []
    let mut s = 0
    while s < 16 {
        let mut i = 0
        while i < 4 {
            let mut g = g0
            if i == 1 { g = g1 }
            if i == 2 { g = g2 }
            if i == 3 { g = g3 }
            let sig = g / (1.0 + g)
            let sn = struct_next(s, i)
            let p = sig * to_float(sn) + (1.0 - sig) * 0.5
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn main() {
    println("[probe] full-deterministic XOR ring (g=∞ proxy via g=100)")
    let tpm = build_tpm(100.0, 100.0, 100.0, 100.0)
    let mut s = 0
    while s < 4 {
        println("  sys_state=" + str(s))
        let mut i = 0
        while i < 4 {
            let mask = iit4_pow2(i)
            let d = distinction(tpm, 4, mask, s)
            println("    cell " + str(i) + " distinction phi=" + str(d[0]) + " phi_c=" + str(d[6]) + " phi_e=" + str(d[7]))
            i = i + 1
        }
        s = s + 1
    }

    // also probe distinction at larger mech (mask=3 = cells 0+1)
    println("[probe] pair mech mask=3 (cells 0+1)")
    let mut s2 = 0
    while s2 < 4 {
        let d = distinction(tpm, 4, 3, s2)
        println("  s=" + str(s2) + " phi_d=" + str(d[0]) + " phi_c=" + str(d[6]) + " phi_e=" + str(d[7]))
        s2 = s2 + 1
    }
}
