// H_631 state-averaged (8-state representative subset, Hamming-stratified)
// n=5, cap 1..5, all 3 rules. subset avoids the full-32 SIGKILL blowup while
// still being a genuine multi-state average (vs H_625 single-state st=21).
// subset = {0,1,3,7,15,31,21,10} — Hamming weights {0,1,2,3,4,5,3,2} span.
import "/tmp/u-h631/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"
let N = 5

fn savg(rule: int) -> array {
    let tpm = eca_tpm(rule, N)
    let subset = [0, 1, 3, 7, 15, 31, 21, 10]
    let ns = len(subset)
    let mut out = []
    let mut k = 1
    while k <= 5 {
        let mut acc = 0.0
        let mut j = 0
        while j < ns {
            let r = big_phi_bounded(tpm, N, subset[j], k)
            acc = acc + r[0]
            j = j + 1
        }
        out = out.push(acc / to_float(ns))
        k = k + 1
    }
    return out
}
fn pr(label: string, b: array) {
    println(label + " c1=" + str(b[0]) + " c2=" + str(b[1]) + " c3=" + str(b[2]) + " c4=" + str(b[3]) + " c5=" + str(b[4]))
}
fn main() {
    pr("SAVG8 r30 ", savg(30))
    pr("SAVG8 r90 ", savg(90))
    pr("SAVG8 r110", savg(110))
    println("SAVG8_DONE")
}
