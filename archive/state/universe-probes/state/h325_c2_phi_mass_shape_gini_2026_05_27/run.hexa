// UNIVERSE/state/h325_c2_phi_mass_shape_gini_2026_05_27/run.hexa
//
//   H_325 — C2 axis: Φ-mass distribution SHAPE (Gini of per-distinction φ_d).
//
//   PRIOR (H_320 / H_323)
//     H_320 measured rd_ratio = sum_phi_r / sum_phi_d (relation-to-distinction
//     scalar) and found life > consciousness — H1 REVERSED, 🔴 closed-negative.
//     H_323 followed up with nd-normalized variants. Both attacked C2 via SUM-
//     reductions of the Φ-structure.
//
//   H_325 — DIFFERENT ANGLE on C2 (Φ-mass distribution SHAPE)
//     Rather than summing φ_d across distinctions, this run asks how the
//     Φ-mass is SHAPED across the per-distinction vector. Gini coefficient G
//     is the canonical concentration metric:
//
//         G  =  Σ_i Σ_j |φ_d_i − φ_d_j|  /  (2 · N · Σ φ_d)
//
//     G=0 means perfectly uniform (every distinction carries equal Φ-mass);
//     G→1 means concentrated (one distinction monopolizes Φ-mass). This is a
//     SHAPE metric, orthogonal to the SUM-based rd_ratio. The kernel reused:
//     stdlib/consciousness/iit4_distinction.distinction() returns φ_d per
//     (mech_mask, sys_state); we iterate mech_mask ∈ [1, 2^n−1] and keep the
//     φ_d > 0 entries (distinctions actually exist).
//
//   H1 — Φ-mass CONCENTRATION differs systematically by class
//     Hypothesis: across the n=4 ECA panel, one class (life {30,54,110} or
//     consciousness {150,105}) shows distinctively HIGHER Gini concentration
//     than the other. Either direction is admissible; the test is whether the
//     SHAPE axis separates them at all.
//
//     CANDIDATE DIRECTIONS — either is a valid finding:
//       (a) consciousness > life — XOR-feedback integration concentrates Φ on
//           a few high-symmetry distinctions ("binding" dominates).
//       (b) life > consciousness — life-class substrates fragment Φ-mass into
//           a few dominant high-order mechs while consciousness spreads it
//           uniformly across symmetric XOR distinctions.
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-27 BEFORE measuring values)
//     F325.1 SEPARATION  — at state 0101: min(class_A Gini) > max(class_B Gini)
//                          for AT LEAST one class assignment (A,B) ∈
//                          {(life,consc), (consc,life)}. Strict, no overlap.
//     F325.2 ORDERING    — class-mean Gini over all 2^n=16 states (distinction-
//                          bearing only) is strictly separated, AND no
//                          substrate "flips class" by Gini (no life-substrate
//                          Gini falls between two consc Ginis, nor vice versa).
//     F325.3 FAITHFULNESS — anchors: rule 204 (identity) and rule 0 (constant)
//                          have ≤1 distinction with φ_d>0 (no concentration
//                          contest possible — Gini=0 by convention when N≤1).
//                          AND Gini ∈ [0,1] for every measured substrate
//                          (definitional sanity).
//
//   IRON RULE (commons @D g73 — anti-fake-closure)
//     The Gini formula is class-blind (depends ONLY on the φ_d vector). The
//     distinction kernel was authored before this hypothesis. Each falsifier
//     is an arithmetic comparison of independently computed values. A 🔴
//     CLOSED-NEGATIVE result (no separation by Gini) is a valid finding —
//     it would add a SECOND failed axis (after H_320's rd_ratio direction)
//     to the C2 closed-negative family, ruling out Φ-mass SHAPE as a
//     life-vs-consciousness predictor at small n.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope: n=4 ring · 5 ECA (3 life + 2 consc) + 2 anchors · headline
//   state 0101 + all-16-state class-mean robustness.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_distinction.hexa"

// ECA → state-by-node TPM bridge (mirrored from HEXAD/IIT4/lib/iit4_eca.hexa
// for ubu-2 portability — same body, snake_case, no top-level call).
fn eca_tpm(rule: int, n: int) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            t = t.push(to_float(iit4_bit(rule, idx)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// Collect per-distinction φ_d vector at (rule, n, sys_state).
// Iterates mech_mask ∈ [1, 2^n−1], keeps only φ_d > 0 entries.
// Returns the kept array (length = N_distinctions at this state).
fn phi_d_vector(rule: int, n: int, sys_state: int) -> array {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut vec = []
    let mut m = 1
    while m < full {
        let d = distinction(tpm, n, m, sys_state)
        if d[0] > 1.0e-9 {
            vec = vec.push(d[0])
        }
        m = m + 1
    }
    return vec
}

// Gini concentration coefficient. Convention: Gini=0 when N ≤ 1 OR sum=0.
//   G = Σ_i Σ_j |φ_d_i − φ_d_j| / (2 · N · Σ φ_d)
fn gini(vec: array) -> float {
    let N = len(vec)
    if N <= 1 { return 0.0 }
    let mut sum = 0.0
    let mut i = 0
    while i < N {
        sum = sum + vec[i]
        i = i + 1
    }
    if sum < 1.0e-12 { return 0.0 }
    let mut num = 0.0
    let mut a = 0
    while a < N {
        let mut b = 0
        while b < N {
            num = num + abs_f(vec[a] - vec[b])
            b = b + 1
        }
        a = a + 1
    }
    return num / (2.0 * to_float(N) * sum)
}

// All-16-state class-mean Gini for one rule (over states with ≥2 distinctions).
fn gini_mean_allstates(rule: int, n: int) -> array {
    let mut acc = 0.0
    let mut cnt = 0
    let mut st = 0
    let full = iit4_pow2(n)
    while st < full {
        let vec = phi_d_vector(rule, n, st)
        if len(vec) >= 2 {
            acc = acc + gini(vec)
            cnt = cnt + 1
        }
        st = st + 1
    }
    if cnt > 0 { return [acc / to_float(cnt), to_float(cnt)] }
    return [0.0, 0.0]
}

fn main() {
    let n = 4
    let st = 5                                           // 0101 headline state
    println("================================================================")
    println("  H_325 — Φ-mass distribution SHAPE (Gini of per-distinction φ_d)")
    println("  (n=" + str(n) + " ring · headline state=0101 · Gini ∈ [0,1])")
    println("================================================================")

    // ── per-substrate φ_d vectors @ 0101 ─────────────────────────────────
    let v_l110 = phi_d_vector(110, n, st)
    let v_l30  = phi_d_vector(30,  n, st)
    let v_l54  = phi_d_vector(54,  n, st)
    let v_c150 = phi_d_vector(150, n, st)
    let v_c105 = phi_d_vector(105, n, st)
    let v_a204 = phi_d_vector(204, n, st)
    let v_a0   = phi_d_vector(0,   n, st)

    let g_l110 = gini(v_l110)
    let g_l30  = gini(v_l30)
    let g_l54  = gini(v_l54)
    let g_c150 = gini(v_c150)
    let g_c105 = gini(v_c105)
    let g_a204 = gini(v_a204)
    let g_a0   = gini(v_a0)

    println("  [LIFE]  rule 110 : N_d=" + str(len(v_l110)) + " Gini=" + str(g_l110))
    println("    phi_d_vec=" + str(v_l110))
    println("  [LIFE]  rule  30 : N_d=" + str(len(v_l30))  + " Gini=" + str(g_l30))
    println("    phi_d_vec=" + str(v_l30))
    println("  [LIFE]  rule  54 : N_d=" + str(len(v_l54))  + " Gini=" + str(g_l54))
    println("    phi_d_vec=" + str(v_l54))
    println("  [CONSC] rule 150 : N_d=" + str(len(v_c150)) + " Gini=" + str(g_c150))
    println("    phi_d_vec=" + str(v_c150))
    println("  [CONSC] rule 105 : N_d=" + str(len(v_c105)) + " Gini=" + str(g_c105))
    println("    phi_d_vec=" + str(v_c105))
    println("  [ANCH]  rule 204 : N_d=" + str(len(v_a204)) + " Gini=" + str(g_a204))
    println("    phi_d_vec=" + str(v_a204))
    println("  [ANCH]  rule   0 : N_d=" + str(len(v_a0))   + " Gini=" + str(g_a0))
    println("    phi_d_vec=" + str(v_a0))

    // ── F325.1 SEPARATION (state 0101, either-direction admissible) ──────
    let mut life_min = g_l110
    if g_l30 < life_min { life_min = g_l30 }
    if g_l54 < life_min { life_min = g_l54 }
    let mut life_max = g_l110
    if g_l30 > life_max { life_max = g_l30 }
    if g_l54 > life_max { life_max = g_l54 }
    let mut consc_min = g_c150
    if g_c105 < consc_min { consc_min = g_c105 }
    let mut consc_max = g_c150
    if g_c105 > consc_max { consc_max = g_c150 }
    println("  --")
    println("  F325.1: life_range=[" + str(life_min) + "," + str(life_max) + "] consc_range=[" + str(consc_min) + "," + str(consc_max) + "]")
    let consc_above_life = consc_min > life_max + 0.000001
    let life_above_consc = life_min > consc_max + 0.000001
    check("F325.1 SEPARATION: classes strictly separated at 0101 (either direction)", consc_above_life || life_above_consc)

    // ── F325.2 ORDERING — all-16-state class-means + no-flip ─────────────
    let m_l110 = gini_mean_allstates(110, n)
    let m_l30  = gini_mean_allstates(30,  n)
    let m_l54  = gini_mean_allstates(54,  n)
    let m_c150 = gini_mean_allstates(150, n)
    let m_c105 = gini_mean_allstates(105, n)
    println("  [LIFE]  rule 110 all-state mean Gini=" + str(m_l110[0]) + " (n_states=" + str(m_l110[1]) + ")")
    println("  [LIFE]  rule  30 all-state mean Gini=" + str(m_l30[0])  + " (n_states=" + str(m_l30[1])  + ")")
    println("  [LIFE]  rule  54 all-state mean Gini=" + str(m_l54[0])  + " (n_states=" + str(m_l54[1])  + ")")
    println("  [CONSC] rule 150 all-state mean Gini=" + str(m_c150[0]) + " (n_states=" + str(m_c150[1]) + ")")
    println("  [CONSC] rule 105 all-state mean Gini=" + str(m_c105[0]) + " (n_states=" + str(m_c105[1]) + ")")
    let life_class_mean  = (m_l110[0] + m_l30[0] + m_l54[0]) / 3.0
    let consc_class_mean = (m_c150[0] + m_c105[0]) / 2.0
    println("  F325.2: life_class_mean=" + str(life_class_mean) + " consc_class_mean=" + str(consc_class_mean))

    // no-flip test: at all-state mean, sort all 5 substrates; both consc must
    // be strictly on one side of all three life means.
    let mut all_consc_above = (m_c150[0] > m_l110[0] + 0.000001) && (m_c150[0] > m_l30[0] + 0.000001) && (m_c150[0] > m_l54[0] + 0.000001) && (m_c105[0] > m_l110[0] + 0.000001) && (m_c105[0] > m_l30[0] + 0.000001) && (m_c105[0] > m_l54[0] + 0.000001)
    let mut all_consc_below = (m_c150[0] + 0.000001 < m_l110[0]) && (m_c150[0] + 0.000001 < m_l30[0]) && (m_c150[0] + 0.000001 < m_l54[0]) && (m_c105[0] + 0.000001 < m_l110[0]) && (m_c105[0] + 0.000001 < m_l30[0]) && (m_c105[0] + 0.000001 < m_l54[0])
    check("F325.2 ORDERING: no class-flip across substrates at all-state-mean Gini", all_consc_above || all_consc_below)

    // ── F325.3 FAITHFULNESS — anchors + Gini ∈ [0,1] ─────────────────────
    let anchor204_ok = len(v_a204) <= 1 && approx(g_a204, 0.0)
    let anchor0_ok   = len(v_a0)   <= 1 && approx(g_a0,   0.0)
    check("F325.3a ANCHOR: rule 204 (identity) ≤1 distinction · Gini=0", anchor204_ok)
    check("F325.3b ANCHOR: rule 0 (constant) ≤1 distinction · Gini=0", anchor0_ok)
    let mut bounds_ok = true
    if g_l110 < 0.0 || g_l110 > 1.0 { bounds_ok = false }
    if g_l30  < 0.0 || g_l30  > 1.0 { bounds_ok = false }
    if g_l54  < 0.0 || g_l54  > 1.0 { bounds_ok = false }
    if g_c150 < 0.0 || g_c150 > 1.0 { bounds_ok = false }
    if g_c105 < 0.0 || g_c105 > 1.0 { bounds_ok = false }
    check("F325.3c BOUNDS: Gini ∈ [0,1] for all 5 measured substrates", bounds_ok)

    // ── determinism ──────────────────────────────────────────────────────
    let g_l110b = gini(phi_d_vector(110, n, st))
    check("determinism: rule110 Gini re-run identical", approx(g_l110, g_l110b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  HEADLINE:")
    println("    life@0101 Gini range  = [" + str(life_min) + "," + str(life_max) + "]")
    println("    consc@0101 Gini range = [" + str(consc_min) + "," + str(consc_max) + "]")
    println("    life_class_mean(all-16)  = " + str(life_class_mean))
    println("    consc_class_mean(all-16) = " + str(consc_class_mean))
    println("================================================================")
    // NO panic — both outcomes (H1 SUPPORTED + H1 FALSIFIED) are valid.
    // result.json written AFTER reading stdout (anti-self-judge).
}
