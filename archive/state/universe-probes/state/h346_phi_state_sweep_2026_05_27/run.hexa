// H_346 — state-averaged exact Phi at n=5 (H_345 single-state robustness)
// H_345 used a single sys_state=21. Does the basin<->Phi coupling hold when Phi
// is averaged over ALL 32 sys-states (state-averaged big-Phi, the H_287 convention)?
//
// H1: state-averaged Pearson(max_basin, mean_Phi) keeps the n=5 single-state sign
//     (positive) and Pearson(n_attr, mean_Phi) keeps negative -> H_345 robust to
//     state choice. Falsifier: sign flips under averaging -> single-state was an
//     outlier.

import "stdlib/consciousness/iit4_relation.hexa"
import "HEXAD/IIT4/lib/iit4_eca.hexa"

fn next5(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 5 {
        let im1 = (i + 4) % 5
        let ip1 = (i + 1) % 5
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn settle(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 50 { s = next5(s, rule); t = t + 1 }
    return s
}

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0; let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + farr_get(xs, i); sy = sy + farr_get(ys, i); i = i + 1 }
    let mx = sx / to_float(n); let my = sy / to_float(n)
    let mut cov = 0.0; let mut vx = 0.0; let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx; let dy = farr_get(ys, j) - my
        cov = cov + dx * dy; vx = vx + dx * dx; vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

fn basin_max(rule: int) -> int {
    let basin = farr_zeros(32)
    let mut s0 = 0
    while s0 < 32 { let t = settle(s0, rule); let c = to_int(farr_get(basin,t)); let _ = farr_set(basin,t,to_float(c+1)); s0 = s0+1 }
    let mut mx = 0; let mut i = 0
    while i < 32 { let b = to_int(farr_get(basin,i)); if b > mx { mx = b }; i = i+1 }
    let _ = farr_free(basin)
    return mx
}

fn basin_nattr(rule: int) -> int {
    let oc = farr_zeros(32)
    let mut s0 = 0
    while s0 < 32 { let _ = farr_set(oc, settle(s0,rule), 1.0); s0 = s0+1 }
    let mut n = 0; let mut i = 0
    while i < 32 { if to_int(farr_get(oc,i)) == 1 { n = n+1 }; i = i+1 }
    let _ = farr_free(oc)
    return n
}

// state-AVERAGED exact phi over all 32 sys-states
fn mean_phi_n5(rule: int) -> float {
    let tpm = eca_tpm(rule, 5)
    let mut tot = 0.0
    let mut s = 0
    while s < 32 {
        let res = phi_structure(tpm, 5, s)
        tot = tot + res[4]
        s = s + 1
    }
    return tot / 32.0
}

fn main() {
    println("H_346 state-averaged exact Phi at n=5 (32-state mean)")
    let mb = farr_zeros(4); let na = farr_zeros(4); let phi = farr_zeros(4)
    let _ = farr_set(mb, 0, to_float(basin_max(110)))
    let _ = farr_set(mb, 1, to_float(basin_max(30)))
    let _ = farr_set(mb, 2, to_float(basin_max(105)))
    let _ = farr_set(mb, 3, to_float(basin_max(150)))
    let _ = farr_set(na, 0, to_float(basin_nattr(110)))
    let _ = farr_set(na, 1, to_float(basin_nattr(30)))
    let _ = farr_set(na, 2, to_float(basin_nattr(105)))
    let _ = farr_set(na, 3, to_float(basin_nattr(150)))
    let _ = farr_set(phi, 0, mean_phi_n5(110))
    let _ = farr_set(phi, 1, mean_phi_n5(30))
    let _ = farr_set(phi, 2, mean_phi_n5(105))
    let _ = farr_set(phi, 3, mean_phi_n5(150))
    println("rule110 max_basin=" + str(to_int(farr_get(mb,0))) + " n_attr=" + str(to_int(farr_get(na,0))) + " mean_phi=" + str(farr_get(phi,0)))
    println("rule30  max_basin=" + str(to_int(farr_get(mb,1))) + " n_attr=" + str(to_int(farr_get(na,1))) + " mean_phi=" + str(farr_get(phi,1)))
    println("rule105 max_basin=" + str(to_int(farr_get(mb,2))) + " n_attr=" + str(to_int(farr_get(na,2))) + " mean_phi=" + str(farr_get(phi,2)))
    println("rule150 max_basin=" + str(to_int(farr_get(mb,3))) + " n_attr=" + str(to_int(farr_get(na,3))) + " mean_phi=" + str(farr_get(phi,3)))
    let r_mb = pearson(mb, phi, 4)
    let r_na = pearson(na, phi, 4)
    println("Pearson(max_basin, mean_Phi)        = " + str(r_mb))
    println("Pearson(n_attractor_states, mean_Phi) = " + str(r_na))
    println("H_345 single-state(21): max_basin +0.251 · n_attr -0.799")
    println("done")
}
