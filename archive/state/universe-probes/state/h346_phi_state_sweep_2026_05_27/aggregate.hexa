// H_346 aggregation — Pearson over the 4 per-rule shard points (no phi_structure).
// Points are the state-averaged exact-Phi shard outputs (shard_{110,30,105,150}.log).

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0; let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + farr_get(xs, i); sy = sy + farr_get(ys, i); i = i + 1 }
    let mx = sx / to_float(n); let my = sy / to_float(n)
    let mut cov = 0.0; let mut vx = 0.0; let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx; let dy = farr_get(ys, j) - my
        cov = cov + dx * dy; vx = vx + dx * dx; vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

fn main() {
    // order: rule110, rule30, rule105, rule150
    let mb = farr_zeros(4); let na = farr_zeros(4); let phi = farr_zeros(4)
    let _ = farr_set(mb, 0, 32.0); let _ = farr_set(mb, 1, 6.0); let _ = farr_set(mb, 2, 1.0); let _ = farr_set(mb, 3, 1.0)
    let _ = farr_set(na, 0, 1.0);  let _ = farr_set(na, 1, 6.0); let _ = farr_set(na, 2, 32.0); let _ = farr_set(na, 3, 32.0)
    let _ = farr_set(phi, 0, 35.1296); let _ = farr_set(phi, 1, 41.3617); let _ = farr_set(phi, 2, 15.5625); let _ = farr_set(phi, 3, 15.5625)
    let r_mb = pearson(mb, phi, 4)
    let r_na = pearson(na, phi, 4)
    println("H_346 state-averaged (32-state) exact Phi at n=5")
    println("rule110 mb=32 na=1  phi=35.1296")
    println("rule30  mb=6  na=6  phi=41.3617")
    println("rule105 mb=1  na=32 phi=15.5625")
    println("rule150 mb=1  na=32 phi=15.5625")
    println("Pearson(max_basin, mean_Phi)        = " + str(r_mb))
    println("Pearson(n_attractor_states, mean_Phi) = " + str(r_na))
    println("H_345 single-state(21): max_basin +0.250836 · n_attr -0.799002")
    println("done")
}
