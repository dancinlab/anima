// run_h616.hexa — H_616 GZ_LOWER SI peak — non-linear inhibition→gain mapping recovery test
//
// Round-2 follow-up to H_348 (golden-zone-lower-bound-SI, 🟡 PARTIAL).
// H_348 found: SI>3 @ GZ_LOWER PASS (F-1) but SI(I) sweep MONOTONE — peak at
// I→0 boundary, NOT at GZ_LOWER (F-2 FALSIFIED under affine map).
// H_348 §9 Next + §7 C3-4 named the round-2 lever explicitly:
//   "inhibition I → gain affine 매핑은 design choice — 비선형 매핑(1/I, sigmoid)을
//    채택하면 peak 위치가 GZ_LOWER 로 이동할 가능성 잔존. F-2 falsification 은 affine 한정."
//
// H_616 tests that escape: does ANY non-linear I→gain mapping move the SI(I)
// peak into the GZ_LOWER window [0.16232, 0.26232] (= 0.21232 ± 0.05)?
//
// 3 mappings, all sharing endpoints (I=0 → gain_focus=10, I=1 → gain_focus=1)
// so only curvature differs:
//   AFFINE     gf = 1 + (1-I)*9                      (H_348 baseline, linear)
//   RECIPROCAL gf = 1 + 9*(1-I)/(1+K*I)  K=8         (front-loaded: drops fast as I↑)
//   SIGMOID    gf = 1 + 9*logistic(I; c=GZ_LOWER)    (S-curve centered at GZ_LOWER)
//
// Substrate + SI metric identical to H_348 (savant_phi.hexa 4-domain, d=6,
// SI = max(domain_phi)/min(domain_phi)). Constants duplicated (SSOT marker).

let SV_D            = 6
let SV_N_DOM        = 4
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

let GZ_LOWER        = 0.21232    // 0.5 - ln(4/3)
let GZ_WIN          = 0.05       // ±window for peak-location PASS

// ── Primitives (SSOT: HEXAD/SAVANT/savant_phi.hexa) ─────────────

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

fn savant_index(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut mx = v[0]
    let mut mn = v[0]
    let mut i = 1
    while i < n {
        if v[i] > mx { mx = v[i] }
        if v[i] < mn { mn = v[i] }
        i = i + 1
    }
    if mn < SV_EPS { return mx / SV_EPS }
    return mx / mn
}

// ── inhibition I → gain_focus  (3 mappings, shared endpoints) ────
// endpoints: gf(0)=10, gf(1)=1  in all three. Only curvature differs.

fn gf_affine(i_val: float) -> float {
    return 1.0 + (1.0 - i_val) * 9.0
}

// reciprocal: front-loaded. gf(I) = 1 + 9*(1-I)/(1+K*I), K=8.
// gf(0)=1+9=10, gf(1)=1+9*0/(1+8)=1. Steeper drop at small I.
fn gf_reciprocal(i_val: float) -> float {
    let k = 8.0
    return 1.0 + 9.0 * (1.0 - i_val) / (1.0 + k * i_val)
}

// sigmoid: S-curve centered at GZ_LOWER. raw logistic L(I)=1/(1+exp(a*(I-c))),
// a=12 (steep), c=GZ_LOWER. Renormalize so gf(0)=10, gf(1)=1 exactly.
fn logistic_raw(i_val: float) -> float {
    let a = 12.0
    let c = 0.21232
    return 1.0 / (1.0 + exp(a * (i_val - c)))
}
fn gf_sigmoid(i_val: float) -> float {
    let l0 = logistic_raw(0.0)
    let l1 = logistic_raw(1.0)
    let l  = logistic_raw(i_val)
    // map l in [l1, l0] linearly onto gain in [1, 10]
    let frac = (l - l1) / (l0 - l1)
    return 1.0 + 9.0 * frac
}

fn si_at(g_focus: float, stim_seed: int) -> float {
    let g_rest = (SV_CAPACITY - g_focus) / 3.0
    let flat = build_profile_state(g_focus, g_rest, g_rest, g_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    return savant_index(dphi)
}

// fixed 9-point I grid (H_348 spec order, dense near GZ_LOWER / GZ_CENTER)
fn grid_i(idx: int) -> float {
    if idx == 0 { return 0.05 }
    if idx == 1 { return 0.10 }
    if idx == 2 { return 0.15 }
    if idx == 3 { return 0.21232 }   // GZ_LOWER ★
    if idx == 4 { return 0.25 }
    if idx == 5 { return 0.36788 }   // GZ_CENTER (1/e)
    if idx == 6 { return 0.50 }
    if idx == 7 { return 0.75 }
    if idx == 8 { return 0.95 }
    return 0.0
}
let GRID_N = 9

fn gf_for(mapping: int, i_val: float) -> float {
    if mapping == 0 { return gf_affine(i_val) }
    if mapping == 1 { return gf_reciprocal(i_val) }
    return gf_sigmoid(i_val)
}

fn mapping_name(mapping: int) -> string {
    if mapping == 0 { return "AFFINE    " }
    if mapping == 1 { return "RECIPROCAL" }
    return "SIGMOID   "
}

// run one mapping across the grid; returns argmax I value
fn run_mapping(mapping: int, stim_seed: int) -> float {
    let mut argmax_i = grid_i(0)
    let mut best_si = 0.0 - 1.0
    let mut idx = 0
    while idx < GRID_N {
        let i_val = grid_i(idx)
        let gf = gf_for(mapping, i_val)
        let si = si_at(gf, stim_seed)
        let mark0 = mark_for(i_val)
        println("  " + mapping_name(mapping) + " I=" + str(i_val)
             + " gf=" + str(gf) + " SI_phi=" + str(si) + mark0)
        if si > best_si {
            best_si = si
            argmax_i = i_val
        }
        idx = idx + 1
    }
    return argmax_i
}

fn mark_for(i_val: float) -> string {
    if i_val == 0.21232 { return "   <- GZ_LOWER" }
    if i_val == 0.36788 { return "   <- GZ_CENTER" }
    return ""
}

fn in_gz_window(i_val: float) -> int {
    let d = sv_abs(i_val - GZ_LOWER)
    if d <= GZ_WIN { return 1 }
    return 0
}

fn main() {
    println("[H_616] GZ_LOWER SI peak — non-linear inhibition->gain mapping recovery test")
    println("  predecessor: H_348 (golden-zone-lower-bound-SI, PARTIAL: F-1 SI>3 PASS, F-2 peak FAIL under affine)")
    println("  substrate  : HEXAD/SAVANT/savant_phi.hexa (SSOT) 4-domain d=6")
    println("  SI metric  : max(domain_phi)/min(domain_phi)  (H_348 identical)")
    println("  GZ_LOWER   = 0.21232 ; PASS window = [" + str(GZ_LOWER - GZ_WIN) + ", " + str(GZ_LOWER + GZ_WIN) + "]")
    println("  mappings   : AFFINE (H_348 baseline) | RECIPROCAL (1/I front-load) | SIGMOID (S-curve @ GZ_LOWER)")
    println("  all mappings share endpoints gf(0)=10, gf(1)=1 (only curvature differs)")
    println("  F-2 recovery falsifier (pre-registered):")
    println("    SUPPORTED if >=1 NON-LINEAR mapping has argmax(SI) in GZ_LOWER window (on >=2/3 seeds)")
    println("    FALSIFIED if ALL 3 mappings keep argmax(SI) at I->0 boundary (peak mapping-independent)")
    println("")

    let seeds = [42424, 91919, 77777]
    let mut pass_recip = 0
    let mut pass_sig = 0
    let mut s = 0
    while s < 3 {
        let stim = seeds[s]
        println("=== seed " + str(stim) + " ===")
        let am_aff = run_mapping(0, stim)
        let am_rec = run_mapping(1, stim)
        let am_sig = run_mapping(2, stim)
        println("  argmax I: AFFINE=" + str(am_aff)
             + " RECIPROCAL=" + str(am_rec) + " SIGMOID=" + str(am_sig))
        let in_aff = in_gz_window(am_aff)
        let in_rec = in_gz_window(am_rec)
        let in_sig = in_gz_window(am_sig)
        println("  in GZ_LOWER window?  AFFINE=" + str(in_aff)
             + " RECIPROCAL=" + str(in_rec) + " SIGMOID=" + str(in_sig))
        if in_rec == 1 { pass_recip = pass_recip + 1 }
        if in_sig == 1 { pass_sig = pass_sig + 1 }
        println("")
        s = s + 1
    }

    println("=== VERDICT ===")
    println("  RECIPROCAL argmax in GZ_LOWER window: " + str(pass_recip) + "/3 seeds")
    println("  SIGMOID    argmax in GZ_LOWER window: " + str(pass_sig) + "/3 seeds")
    let recip_ok = pass_recip >= 2
    let sig_ok = pass_sig >= 2
    if recip_ok {
        println("  -> RECOVERED via RECIPROCAL (>=2/3) : F-2 was a mapping artifact")
    }
    if sig_ok {
        println("  -> RECOVERED via SIGMOID (>=2/3)    : F-2 was a mapping artifact")
    }
    if recip_ok {
        println("VERDICT: SUPPORTED-NUMERICAL (non-linear mapping moves SI peak to GZ_LOWER)")
    } else {
        if sig_ok {
            println("VERDICT: SUPPORTED-NUMERICAL (non-linear mapping moves SI peak to GZ_LOWER)")
        } else {
            println("VERDICT: FALSIFIED (SI peak at I->0 boundary is mapping-INDEPENDENT)")
            println("  -> H_348 F-2 falsification is NOT a mapping artifact; the SI(I) monotone")
            println("     decrease is intrinsic to the capacity-bounded savant_phi substrate.")
            println("     GZ_LOWER is a SI>3 threshold boundary (H_348 F-1), not a SI peak location.")
        }
    }
}
