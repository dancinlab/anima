// ════════════════════════════════════════════════════════════════════════
//  H_350 verify — Savant Index SI vs Φ-diversity 양의 상관 측정
//
//  SI       = max(domain_phi) / mean(domain_phi)        (savant_phi.hexa specialization_ratio 동일)
//  ΦD       = max(domain_phi) / min(domain_phi)          (primary metric)
//  ΦD_alt   = std(domain_phi) / mean(domain_phi)         (sensitivity 검증용)
//
//  Falsifier: Pearson r < 0.5 AND Spearman ρ < 0.5 (둘 다 약함), 또는 r 음의 상관
//
//  Sample set: 다양한 hypertrophy 분포 × 다양한 stim seed = N=40 (multi-seed N≥8 충족)
//    - 4 domain × 5 hypertrophy level × 2 stim seed = 40 samples
//    - capacity invariant SV_CAPACITY=11.5 유지
//
//  Tool: savant_phi.hexa 함수 재구현 (import 의존 회피 — single-file verify)
// ════════════════════════════════════════════════════════════════════════

let SV_D            = 6
let SV_N_DOM        = 4
let SV_BINS         = 6
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

// phi_module(v) = Σ |v[j]|^1.5 / d
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

// SI = max / mean (savant_phi.hexa specialization_ratio 와 byte-identical)
fn savant_index(dphi: array) -> float {
    let mut sum = 0.0
    let mut mx = dphi[0]
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        if dphi[i] > mx { mx = dphi[i] }
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    return mx / mean
}

// Φ-diversity primary = max / min
fn phi_diversity_maxmin(dphi: array) -> float {
    let mut mx = dphi[0]
    let mut mn = dphi[0]
    let mut i = 1
    while i < SV_N_DOM {
        if dphi[i] > mx { mx = dphi[i] }
        if dphi[i] < mn { mn = dphi[i] }
        i = i + 1
    }
    if mn <= SV_EPS { return 0.0 }
    return mx / mn
}

// Φ-diversity sensitivity = std / mean
fn phi_diversity_stdmean(dphi: array) -> float {
    let mut sum = 0.0
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    let mut s2 = 0.0
    let mut j = 0
    while j < SV_N_DOM {
        let dd = dphi[j] - mean
        s2 = s2 + dd * dd
        j = j + 1
    }
    let var = s2 / to_float(SV_N_DOM)
    let sd = sv_sqrt_safe(var)
    return sd / mean
}

// Pearson correlation
fn pearson_corr(x: array, y: array) -> float {
    let n = len(x)
    if n < 2 { return 0.0 }
    let mut mx = 0.0
    let mut my = 0.0
    let mut i = 0
    while i < n {
        mx = mx + x[i]
        my = my + y[i]
        i = i + 1
    }
    mx = mx / to_float(n)
    my = my / to_float(n)

    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n {
        let dx = x[j] - mx
        let dy = y[j] - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom = sv_sqrt_safe(dx2 * dy2)
    if denom < SV_EPS { return 0.0 }
    return num / denom
}

// Rank vector with average-rank tie handling
fn rank_vector(x: array) -> array {
    let n = len(x)
    let mut ranks = []
    let mut i = 0
    while i < n {
        ranks = ranks.push(0.0)
        i = i + 1
    }
    let mut a = 0
    while a < n {
        // For x[a], count how many strictly less + 0.5 * (ties - 1)
        let mut lt = 0
        let mut eq = 0
        let mut b = 0
        while b < n {
            if x[b] < x[a] { lt = lt + 1 }
            if x[b] == x[a] { eq = eq + 1 }
            b = b + 1
        }
        // rank = lt + (eq + 1) / 2  (1-based average rank)
        let r = to_float(lt) + (to_float(eq) + 1.0) / 2.0
        ranks[a] = r
        a = a + 1
    }
    return ranks
}

fn spearman_corr(x: array, y: array) -> float {
    let rx = rank_vector(x)
    let ry = rank_vector(y)
    return pearson_corr(rx, ry)
}

// ── Sample generation ──────────────────────────────────────────
//
// Sweep:
//   dom    ∈ {0,1,2,3}       — 어느 domain 이 hypertrophy 받는지 (4)
//   g_focus ∈ {1,3,5,7,10}   — hypertrophy 강도 (5)
//   stim   ∈ {11111, 77777}  — stimulus seed (2 multi-seed)
// → 4 × 5 × 2 = 40 samples
fn run_sweep() -> dict {
    let mut si_arr = []
    let mut phid_arr = []
    let mut phid_alt_arr = []

    let g_focus_vals = [1.0, 3.0, 5.0, 7.0, 10.0]
    let stim_seeds = [11111, 77777]

    let mut dom = 0
    while dom < SV_N_DOM {
        let mut gi = 0
        while gi < 5 {
            let g_focus = g_focus_vals[gi]
            let g_rest = (SV_CAPACITY - g_focus) / 3.0
            let mut g0 = g_rest
            let mut g1 = g_rest
            let mut g2 = g_rest
            let mut g3 = g_rest
            if dom == 0 { g0 = g_focus }
            if dom == 1 { g1 = g_focus }
            if dom == 2 { g2 = g_focus }
            if dom == 3 { g3 = g_focus }
            let mut si = 0
            while si < 2 {
                let stim = stim_seeds[si]
                let flat = build_profile_state(g0, g1, g2, g3, SV_D, stim)
                let dphi = domain_phi_vector(flat, SV_D)
                let si_val = savant_index(dphi)
                let phid = phi_diversity_maxmin(dphi)
                let phid_alt = phi_diversity_stdmean(dphi)
                si_arr = si_arr.push(si_val)
                phid_arr = phid_arr.push(phid)
                phid_alt_arr = phid_alt_arr.push(phid_alt)
                si = si + 1
            }
            gi = gi + 1
        }
        dom = dom + 1
    }
    return #{
        "si": si_arr,
        "phid_maxmin": phid_arr,
        "phid_stdmean": phid_alt_arr,
    }
}

fn min_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] < m { m = v[i] }
        i = i + 1
    }
    return m
}

fn max_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] > m { m = v[i] }
        i = i + 1
    }
    return m
}

fn mean_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_350 verify — Savant Index SI vs Φ-diversity correlation")
    println("════════════════════════════════════════════════════════════════")
    println("  SI       = max(domain_phi) / mean(domain_phi)  [primary]")
    println("  ΦD       = max(domain_phi) / min(domain_phi)   [primary]")
    println("  ΦD_alt   = std(domain_phi) / mean(domain_phi)  [sensitivity]")
    println("  N samples = 4 dom × 5 g_focus × 2 stim = 40")
    println("")

    let res = run_sweep()
    let si_arr  = res["si"]
    let phid    = res["phid_maxmin"]
    let phid_alt = res["phid_stdmean"]

    let n = len(si_arr)
    println("  sample count = " + str(n))
    println("  SI range  = [" + str(min_arr(si_arr)) + ", " + str(max_arr(si_arr)) + "] mean=" + str(mean_arr(si_arr)))
    println("  ΦD range  = [" + str(min_arr(phid)) + ", " + str(max_arr(phid)) + "] mean=" + str(mean_arr(phid)))
    println("  ΦDalt range = [" + str(min_arr(phid_alt)) + ", " + str(max_arr(phid_alt)) + "] mean=" + str(mean_arr(phid_alt)))
    println("")

    // Primary: SI vs ΦD (max/min)
    let r_primary  = pearson_corr(si_arr, phid)
    let rho_primary = spearman_corr(si_arr, phid)
    // Sensitivity: SI vs ΦD_alt (std/mean)
    let r_sens     = pearson_corr(si_arr, phid_alt)
    let rho_sens   = spearman_corr(si_arr, phid_alt)

    println("──────────────────────────────────────────────────────────────")
    println("  PRIMARY  SI ~ ΦD(max/min):")
    println("    Pearson  r = " + str(r_primary))
    println("    Spearman ρ = " + str(rho_primary))
    println("")
    println("  SENSITIVITY  SI ~ ΦD(std/mean):")
    println("    Pearson  r = " + str(r_sens))
    println("    Spearman ρ = " + str(rho_sens))
    println("──────────────────────────────────────────────────────────────")

    // Sample preview (head 8 + tail 4)
    println("")
    println("  sample preview (SI, ΦD_maxmin, ΦD_stdmean):")
    let mut k = 0
    while k < 8 {
        println("    [" + str(k) + "] SI=" + str(si_arr[k]) + " ΦD=" + str(phid[k]) + " ΦDalt=" + str(phid_alt[k]))
        k = k + 1
    }
    println("    ...")
    let mut kk = n - 4
    while kk < n {
        println("    [" + str(kk) + "] SI=" + str(si_arr[kk]) + " ΦD=" + str(phid[kk]) + " ΦDalt=" + str(phid_alt[kk]))
        kk = kk + 1
    }
    println("")

    // Falsifier check — pass if r >= 0.5 OR ρ >= 0.5  (둘 다 < 0.5 OR r < 0 → FAIL)
    let mut pass = true
    let mut reason = ""
    if r_primary < 0.0 {
        pass = false
        reason = "Pearson r 음의 상관 → FALSIFIED"
    }
    if r_primary < 0.5 {
        if rho_primary < 0.5 {
            pass = false
            reason = "r<0.5 AND ρ<0.5 둘 다 약함 → FALSIFIED"
        }
    }

    println("══════════════════════════════════════════════════════════════")
    if pass {
        println("  VERDICT: 🟢 SUPPORTED-NUMERICAL")
        println("  r=" + str(r_primary) + " ρ=" + str(rho_primary) + " (둘 중 하나 ≥ 0.5, r ≥ 0)")
        println("  Sensitivity (std/mean): r=" + str(r_sens) + " ρ=" + str(rho_sens))
    } else {
        println("  VERDICT: 🔴 FALSIFIED")
        println("  " + reason)
    }
    println("══════════════════════════════════════════════════════════════")
}
