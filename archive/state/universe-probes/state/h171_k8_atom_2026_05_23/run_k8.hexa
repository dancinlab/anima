    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"model\": \"K-cell periodic logistic ring (r=3.85, DIFFUSE=0.08) deterministic recurrence; obs=cell state; WARM=8 DIM=12; K in {4,6,8,10,12,16}\",\n"
    j = j + "  \"seed_base\": " + to_string(SEED_BASE()) + ",\n"
    j = j + "  \"config\": { \"dim\": " + to_string(DIM())
          + ", \"warm\": " + to_string(WARM()) + ", \"n_seeds\": " + to_string(N_SEEDS())
          + ", \"logistic_r\": " + to_string(LOGISTIC_R()) + ", \"diffuse\": " + to_string(DIFFUSE())
          + ", \"n_bins\": " + to_string(_PHI_N_BINS()) + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"phi_mean\": {\n"
    j = j + "    \"K_4\": "  + to_string(phi4)  + ",\n"
    j = j + "    \"K_6\": "  + to_string(phi6)  + ",\n"
    j = j + "    \"K_8\": "  + to_string(phi8)  + ",\n"
    j = j + "    \"K_10\": " + to_string(phi10) + ",\n"
    j = j + "    \"K_12\": " + to_string(phi12) + ",\n"
