// H_319 — CLONAL-SELECTION × diversity-pool + fitness-gated dynamics
// ═════════════════════════════════════════════════════════════════════
// REAL deterministic simulation of clonal-selection vs single-best policy
// against a SHIFTING target task.
//
// Setup:
//   N = 8 variants. Each variant i has a scalar parameter w_i (linear map
//   f_i(x) = w_i * x).  Target function g(x) = w_star * x where w_star
//   SHIFTS every K_SHIFT epochs (in SHIFTING regime) or stays fixed
//   (STATIONARY regime).
//
//   Two policies on the SAME deterministic task stream:
//     SINGLE : at t=0, pick the variant i_best with smallest training error
//              and LOCK it.  All future predictions use w_{i_best} (= w at t=0).
//     CLONAL : each epoch, score every variant on the current training batch.
//              Keep the top k=2 (smallest error) — drop the bottom (N-k=6).
//              Regenerate the dropped slots by mutating the top-k:
//              new_w = top_w + perturbation(seed, slot).  Deterministic.
//
//   Anti-tautology: SELECTION uses *training* error.  LOSS measurement uses a
//   SEPARATE deterministic eval grid (different x-values) — the loss is NOT
//   the selection score and could disagree (and in fact does, after a shift
//   the locked SINGLE picks a stale top variant whose eval error explodes).
//
// Conditions:
//   COND-A SHIFTING  : w_star rotates through 4 phases every K_SHIFT epochs.
//   COND-B STATIONARY: w_star fixed at phase=0 the whole T epochs.
//
// Hypothesis H1: CLONAL beats SINGLE under SHIFT by non-trivial margin
//   (>= 2x lower cumulative eval loss) AND CLONAL does NOT beat SINGLE
//   under STATIONARY (≤ : single ties or wins on a stationary task).
//
// Potential falsifications (ALL live before measurement):
//   (i)   CLONAL does not beat SINGLE under SHIFT — H1 FALSIFIED
//   (ii)  CLONAL beats SINGLE under SHIFT but margin < 2x — non-trivial-margin FAIL
//   (iii) CLONAL beats SINGLE under STATIONARY too — conditional structure FAIL
//         (clonal is "just better", no dynamical-gating story)
//
// Style: per H_317/H_318 — globals for per-variant arrays, no &mut, helpers
// dispatch by integer index. Deterministic; no RNG; perturbation is a fixed
// pseudo-random hash of (slot, epoch).
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

// ── per-variant weights (globals, N=8) ──────────────────────────────────────
let mut W_0 = 0.0
let mut W_1 = 0.0
let mut W_2 = 0.0
let mut W_3 = 0.0
let mut W_4 = 0.0
let mut W_5 = 0.0
let mut W_6 = 0.0
let mut W_7 = 0.0

fn W_get(i: int) -> float {
    if i == 0 { return W_0 }
    if i == 1 { return W_1 }
    if i == 2 { return W_2 }
    if i == 3 { return W_3 }
    if i == 4 { return W_4 }
    if i == 5 { return W_5 }
    if i == 6 { return W_6 }
    return W_7
}
fn W_set(i: int, v: float) {
    if i == 0 { W_0 = v; return }
    if i == 1 { W_1 = v; return }
    if i == 2 { W_2 = v; return }
    if i == 3 { W_3 = v; return }
    if i == 4 { W_4 = v; return }
    if i == 5 { W_5 = v; return }
    if i == 6 { W_6 = v; return }
    W_7 = v
}

// ── deterministic pseudo-random in [-1, 1] from int seeds ──────────────────
// Linear-congruential mod 2^31 - 1, then map to [-1,1].  Used ONLY for
// generating the initial variant pool and clonal mutation perturbations.
// No use of any built-in RNG (libm-free / byte-identical).
fn lcg(seed: int) -> int {
    // a = 1103515245, c = 12345, m = 2147483647
    let mut s = seed * 1103515245 + 12345
    // emulate mod by repeated subtraction (keep small): use bit-level via int wraparound
    // hexa int wraps; force into 0..2147483647 range
    if s < 0 { s = 0 - s }
    s = s % 2147483647
    return s
}

fn rand_unit(seed: int) -> float {
    let s = lcg(seed)
    // map to [-1, 1]
    let f = (s % 20001) - 10000
    return (f * 1.0) / 10000.0
}

// ── target function w_star ──────────────────────────────────────────────────
// SHIFTING: phase = (t / K_SHIFT) % 4, w_star ∈ {-1.5, +0.5, +1.5, -0.5}
// STATIONARY: phase = 0 always.
fn w_star_at(regime: int, t: int, K_SHIFT: int) -> float {
    let mut phase = 0
    if regime == 1 { phase = (t / K_SHIFT) % 4 }
    if phase == 0 { return 0.0 - 1.5 }
    if phase == 1 { return 0.5 }
    if phase == 2 { return 1.5 }
    return 0.0 - 0.5
}

// ── training batch: 4 x-values, deterministic per epoch ─────────────────────
// x[t,j] = some deterministic stream of x's; selection score uses these.
fn x_train(t: int, j: int) -> float {
    // 4 distinct x's per epoch, slowly rotating to avoid degeneracy
    let base = ((t * 7 + j * 13) % 20) - 10
    return (base * 1.0) / 5.0
}

// ── eval grid: 5 DIFFERENT x-values, independent of training ────────────────
// Loss = mean squared error over these 5 points.
fn x_eval(j: int) -> float {
    // fixed eval grid: -2, -1, 0, +1, +2 — INDEPENDENT of training stream
    if j == 0 { return 0.0 - 2.0 }
    if j == 1 { return 0.0 - 1.0 }
    if j == 2 { return 0.0 }
    if j == 3 { return 1.0 }
    return 2.0
}

// ── compute training error for variant i at epoch t (sum sq err over 4 pts)
fn train_err(i: int, regime: int, t: int, K_SHIFT: int) -> float {
    let w = W_get(i)
    let w_star = w_star_at(regime, t, K_SHIFT)
    let mut s = 0.0
    let mut j = 0
    while j < 4 {
        let x = x_train(t, j)
        let y = w_star * x
        let yhat = w * x
        let e = y - yhat
        s = s + e * e
        j = j + 1
    }
    return s
}

// ── compute eval error for variant i at epoch t (INDEPENDENT grid) ─────────
fn eval_err(i: int, regime: int, t: int, K_SHIFT: int) -> float {
    let w = W_get(i)
    let w_star = w_star_at(regime, t, K_SHIFT)
    let mut s = 0.0
    let mut j = 0
    while j < 5 {
        let x = x_eval(j)
        let y = w_star * x
        let yhat = w * x
        let e = y - yhat
        s = s + e * e
        j = j + 1
    }
    return s
}

// ── initialize the variant pool with diverse weights ────────────────────────
// Spread initial weights in [-1, 1] via deterministic seeds.
fn init_pool() {
    let mut i = 0
    while i < 8 {
        let w = rand_unit(i * 7919 + 17)  // diverse-but-deterministic seeds
        W_set(i, w)
        i = i + 1
    }
}

// ── find best variant (smallest training error) at epoch t ──────────────────
fn best_variant(regime: int, t: int, K_SHIFT: int) -> int {
    let mut best_i = 0
    let mut best_e = 1.0e30
    let mut i = 0
    while i < 8 {
        let e = train_err(i, regime, t, K_SHIFT)
        if e < best_e { best_e = e; best_i = i }
        i = i + 1
    }
    return best_i
}

// ── clonal step: keep top-k by training-error, regenerate bottom by mutation
// top-k = 2. Mutation amplitude = mu (e.g. 0.3).
// Mutation: perturb a top-k parent's weight by rand_unit(seed) * mu.
fn clonal_step(regime: int, t: int, K_SHIFT: int, mu: float) {
    // compute training errors
    let mut e0 = train_err(0, regime, t, K_SHIFT)
    let mut e1 = train_err(1, regime, t, K_SHIFT)
    let mut e2 = train_err(2, regime, t, K_SHIFT)
    let mut e3 = train_err(3, regime, t, K_SHIFT)
    let mut e4 = train_err(4, regime, t, K_SHIFT)
    let mut e5 = train_err(5, regime, t, K_SHIFT)
    let mut e6 = train_err(6, regime, t, K_SHIFT)
    let mut e7 = train_err(7, regime, t, K_SHIFT)

    // find indices of two SMALLEST errors (top-k=2)
    // linear selection (N=8 small)
    let mut top1 = 0
    let mut top1_e = e0
    if e1 < top1_e { top1 = 1; top1_e = e1 }
    if e2 < top1_e { top1 = 2; top1_e = e2 }
    if e3 < top1_e { top1 = 3; top1_e = e3 }
    if e4 < top1_e { top1 = 4; top1_e = e4 }
    if e5 < top1_e { top1 = 5; top1_e = e5 }
    if e6 < top1_e { top1 = 6; top1_e = e6 }
    if e7 < top1_e { top1 = 7; top1_e = e7 }

    let mut top2 = 0
    let mut top2_e = 1.0e30
    let mut i = 0
    while i < 8 {
        if i != top1 {
            let ei =
                if i == 0 { e0 }
                else if i == 1 { e1 }
                else if i == 2 { e2 }
                else if i == 3 { e3 }
                else if i == 4 { e4 }
                else if i == 5 { e5 }
                else if i == 6 { e6 }
                else { e7 }
            if ei < top2_e { top2 = i; top2_e = ei }
        }
        i = i + 1
    }

    // capture parent weights BEFORE mutating slots
    let w_top1 = W_get(top1)
    let w_top2 = W_get(top2)

    // mutate the 6 non-top slots — alternate between top1 and top2 as parent
    i = 0
    let mut alt = 0
    while i < 8 {
        if i != top1 && i != top2 {
            let parent_w = if (alt % 2) == 0 { w_top1 } else { w_top2 }
            let pert = rand_unit(i * 131 + t * 977 + 3)
            W_set(i, parent_w + pert * mu)
            alt = alt + 1
        }
        i = i + 1
    }
    // top1, top2 weights unchanged
}

// ── episode runner ──────────────────────────────────────────────────────────
// policy 0 = SINGLE (pick best at t=0, lock; eval that variant every epoch)
// policy 1 = CLONAL (clonal_step every epoch; eval the CURRENT best variant)
// regime 0 = STATIONARY, regime 1 = SHIFTING.
//
// Loss = sum over t of eval_err(active_variant, regime, t, K_SHIFT).
let mut g_loss = 0.0

fn run_episode(policy: int, regime: int, T: int, K_SHIFT: int, mu: float) {
    g_loss = 0.0
    init_pool()

    // policy 0 (SINGLE): pick best at t=0, lock i_active
    let mut i_active = 0
    if policy == 0 {
        i_active = best_variant(regime, 0, K_SHIFT)
    }

    let mut t = 0
    while t < T {
        // accumulate eval loss on the CURRENT variant
        // for CLONAL, the "current best" by training error at this epoch.
        let i_now = if policy == 0 { i_active } else { best_variant(regime, t, K_SHIFT) }
        let l = eval_err(i_now, regime, t, K_SHIFT)
        g_loss = g_loss + l

        // mutation step (CLONAL only) — at END of epoch so next epoch sees update
        if policy == 1 {
            clonal_step(regime, t, K_SHIFT, mu)
        }
        t = t + 1
    }
}

fn main() {
    println("================================================================")
    println("  H_319 — CLONAL-SELECTION x diversity-pool + fitness-gated")
    println("  N=8 variants, top-k=2, mu=0.3, T=200 epochs, K_SHIFT=50")
    println("  SINGLE-best-locked  vs  CLONAL-mutate-cull")
    println("================================================================")

    let T       = 200
    let K_SHIFT = 50
    let mu      = 0.3

    // ── COND-A: SHIFTING ────────────────────────────────────────────────────
    println("  --- COND-A SHIFTING ---")
    run_episode(0, 1, T, K_SHIFT, mu)
    let loss_single_shift = g_loss
    println("    SINGLE cum_loss = " + str(loss_single_shift))

    run_episode(1, 1, T, K_SHIFT, mu)
    let loss_clonal_shift = g_loss
    println("    CLONAL cum_loss = " + str(loss_clonal_shift))

    let delta_shift = loss_single_shift - loss_clonal_shift
    let mut pct_shift = 0.0
    if loss_single_shift > 1.0e-9 { pct_shift = 100.0 * delta_shift / loss_single_shift }
    println("    delta = " + str(delta_shift) + "  (clonal reduces loss by " + str(pct_shift) + " %)")
    let mut ratio_shift = 1.0
    if loss_clonal_shift > 1.0e-9 { ratio_shift = loss_single_shift / loss_clonal_shift }
    println("    ratio single/clonal = " + str(ratio_shift) + " x")

    // ── COND-B: STATIONARY ──────────────────────────────────────────────────
    println("  --- COND-B STATIONARY ---")
    run_episode(0, 0, T, K_SHIFT, mu)
    let loss_single_stat = g_loss
    println("    SINGLE cum_loss = " + str(loss_single_stat))

    run_episode(1, 0, T, K_SHIFT, mu)
    let loss_clonal_stat = g_loss
    println("    CLONAL cum_loss = " + str(loss_clonal_stat))

    let delta_stat = loss_single_stat - loss_clonal_stat
    let mut pct_stat = 0.0
    if loss_single_stat > 1.0e-9 { pct_stat = 100.0 * delta_stat / loss_single_stat }
    println("    delta = " + str(delta_stat) + "  (clonal reduces loss by " + str(pct_stat) + " %)")

    println("----------------------------------------------------------------")
    println("  FALSIFIER EVALUATION (from MEASURED cumulative eval losses):")

    // ── F319.1 CLONAL-WINS-UNDER-SHIFT ──────────────────────────────────────
    check("F319.1 CLONAL-WINS-UNDER-SHIFT: clonal cum_loss < single cum_loss under SHIFTING",
          loss_clonal_shift < loss_single_shift)

    // ── F319.2 NON-TRIVIAL-MARGIN-UNDER-SHIFT (>= 2x) ───────────────────────
    check("F319.2 NON-TRIVIAL-MARGIN-UNDER-SHIFT: single cum_loss >= 2 x clonal cum_loss under SHIFTING",
          loss_single_shift >= 2.0 * loss_clonal_shift)

    // ── F319.3 SINGLE-COMPETITIVE-UNDER-STATIONARY ──────────────────────────
    // under stationary, the SINGLE best at t=0 IS the right pick — clonal
    // must NOT do non-trivially better. Allow tie within 10% slack.
    check("F319.3 SINGLE-COMPETITIVE-UNDER-STATIONARY: single cum_loss <= 1.1 x clonal cum_loss under STATIONARY",
          loss_single_stat <= 1.1 * loss_clonal_stat + 1.0e-6)

    // ── F319.4 CONDITIONAL-BENEFIT-REAL ─────────────────────────────────────
    // shift benefit pct > stationary benefit pct — clonal's advantage is
    // *driven by* the shift, not an unconditional improvement.
    check("F319.4 CONDITIONAL-BENEFIT-REAL: shift-benefit pct > stationary-benefit pct",
          pct_shift > pct_stat)

    // ── F319.5 SHIFT-IS-NON-TRIVIAL ─────────────────────────────────────────
    check("F319.5 SHIFT-IS-NON-TRIVIAL: single cum_loss(shift) > 1.5 x single cum_loss(stationary)",
          loss_single_shift > 1.5 * loss_single_stat)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS == 5 {
        println("  HEADLINE: CLONAL beats SINGLE under SHIFTING with >= 2 x margin,")
        println("    while SINGLE remains competitive under STATIONARY — full H1 SUPPORTED.")
        println("    Verdict candidate: SUPPORTED-NUMERICAL.")
    } else if loss_clonal_shift < loss_single_shift {
        println("  HEADLINE: CLONAL conditionally helps under shift; some falsifier failed —")
        println("    honest disaggregation needed.")
    } else {
        println("  HEADLINE: CLONAL does NOT beat SINGLE under SHIFTING — H1 FALSIFIED.")
        println("    Verdict candidate: CLOSED-NEGATIVE.")
    }
    println("================================================================")

    // ── machine-readable result block ───────────────────────────────────────
    println("RESULT_JSON_BEGIN")
    println("{")
    println("  \"shift\": {")
    println("    \"single_loss\": " + str(loss_single_shift) + ",")
    println("    \"clonal_loss\": " + str(loss_clonal_shift) + ",")
    println("    \"delta\":       " + str(delta_shift) + ",")
    println("    \"pct_reduction\": " + str(pct_shift) + ",")
    println("    \"ratio_single_over_clonal\": " + str(ratio_shift))
    println("  },")
    println("  \"stationary\": {")
    println("    \"single_loss\": " + str(loss_single_stat) + ",")
    println("    \"clonal_loss\": " + str(loss_clonal_stat) + ",")
    println("    \"delta\":       " + str(delta_stat) + ",")
    println("    \"pct_reduction\": " + str(pct_stat))
    println("  },")
    println("  \"falsifiers\": { \"pass\": " + str(PASS) + ", \"fail\": " + str(FAIL) + " }")
    println("}")
    println("RESULT_JSON_END")

    if FAIL > 0 { println("NOTE: some falsifiers failed — honest disaggregation in doc section results.") }
}
