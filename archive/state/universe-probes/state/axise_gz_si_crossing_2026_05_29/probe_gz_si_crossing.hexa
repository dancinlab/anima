// ════════════════════════════════════════════════════════════════════════════
//  probe_gz_si_crossing.hexa — H_axise_gz_si_crossing
//
//  CORE QUESTION
//    H_axise_gz_band_si established that SI(GZ_LOWER) > 3 (savant) and
//    SI(GZ_UPPER=0.5) < 3 (sub-savant). So the savant threshold SI=3 is crossed
//    SOMEWHERE in the Golden Zone band [GZ_LOWER, GZ_UPPER]. WHERE exactly?
//    Does the crossing land near GZ_CENTER = 1/e (the band midpoint), which
//    would establish GZ_CENTER as the SI savant→sub-savant transition point?
//
//  HYPOTHESIS (pre-registered falsifier, frozen before run)
//    The SI=3 crossing point I* (linear interpolation between the bracketing
//    grid points where mean-SI passes 3) lies strictly inside the GZ band AND
//    near GZ_CENTER=1/e≈0.36788 (|I* - 1/e| <= 0.05).
//
//      F1 INSIDE-BAND  : GZ_LOWER < I* < GZ_UPPER          (crossing in the band)
//      F2 NEAR-CENTER  : |I* - 1/e| <= 0.05                (crossing ≈ GZ_CENTER)
//      F3 MONO-SWEEP   : mean-SI(I) strictly decreasing over the fine grid
//                        (single crossing — no re-entry)
//      F4 DETERMINISM  : recompute byte-identical (|Δ| <= 1e-12)
//
//    SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4
//    PARTIAL   = F1 ∧ F3 ∧ F4 ∧ !F2   (in-band but not near 1/e)
//    FALSIFIED = !F1 ∨ !F3             (crossing outside band OR multi-crossing)
//
//  SUBSTRATE / MAPPING  — identical to H_axise_gz_band_si + H_348:
//    savant_phi.hexa 4-domain d=6, cap=11.5, SI=max/min(domain_phi),
//    gain_focus = 1 + (1-I)*9, dom=0 (CALENDAR) hypertrophy.
//
//  FINE GRID across the GZ band (dense, brackets the SI=3 crossing):
//    I ∈ {0.21232, 0.25, 0.28, 0.30, 0.32, 0.34, 0.36788, 0.40, 0.45, 0.50}
//    mean-SI over seeds {42424, 91919, 77777}.
//
//  $0 · mac-local + ubu-2 · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

let SV_D        = 6
let SV_N_DOM    = 4
let SV_CAPACITY = 11.5

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}
fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}
fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}
fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}
fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}
fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}
fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}
fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}
fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}
fn savant_index(dphi: array) -> float {
    let n = len(dphi)
    if n == 0 { return 0.0 }
    let mut mx = dphi[0]
    let mut mn = dphi[0]
    let mut i = 1
    while i < n {
        if dphi[i] > mx { mx = dphi[i] }
        if dphi[i] < mn { mn = dphi[i] }
        i = i + 1
    }
    if mn <= 0.000000001 { return 0.0 }
    return mx / mn
}
fn si_at_inhibition(inhibit: float, stim_seed: int) -> float {
    let gain_focus = 1.0 + (1.0 - inhibit) * 9.0
    let gain_rest  = (SV_CAPACITY - gain_focus) / 3.0
    let flat = build_profile_state(gain_focus, gain_rest, gain_rest, gain_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    return savant_index(dphi)
}

fn mean_si_at(inhibit: float, seeds: array) -> float {
    let ns = len(seeds)
    let mut s = 0.0
    let mut i = 0
    while i < ns {
        s = s + si_at_inhibition(inhibit, seeds[i])
        i = i + 1
    }
    return s / to_float(ns)
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_axise_gz_si_crossing — where SI=3 crosses inside the GZ band")
    println("  substrate: HEXAD/SAVANT/savant_phi.hexa (SSOT) — 4-domain d=6")
    println("  SI=max/min(domain_phi) ; threshold=3 ; mean over 3 seeds")
    println("  GZ_LOWER=0.21232  GZ_CENTER=0.36788(1/e)  GZ_UPPER=0.5")
    println("════════════════════════════════════════════════════════════")

    let seeds = [42424, 91919, 77777]
    let grid = [0.21232, 0.25, 0.28, 0.30, 0.32, 0.34, 0.36788, 0.40, 0.45, 0.50]
    let m = len(grid)
    let thresh = 3.0
    let gz_lower = 0.21232
    let gz_upper = 0.5
    let gz_center = 0.36788

    let mut msi = []
    let mut i = 0
    println("")
    println("── mean-SI(I) fine sweep ──")
    while i < m {
        let v = mean_si_at(grid[i], seeds)
        msi = msi.push(v)
        println("  I=" + str(grid[i]) + "  mean_SI=" + str(v))
        i = i + 1
    }

    // strictly decreasing check (F3)
    let mut mono = true
    let mut a = 1
    while a < m {
        if msi[a] >= msi[a-1] { mono = false }
        a = a + 1
    }

    // find SI=3 crossing bracket: first index where msi[k] < 3 with msi[k-1] >= 3
    let mut cross_found = false
    let mut i_star = 0.0
    let mut k = 1
    while k < m {
        if (msi[k-1] >= thresh) && (msi[k] < thresh) && (!cross_found) {
            // linear interpolation for I*
            let frac = (msi[k-1] - thresh) / (msi[k-1] - msi[k])
            i_star = grid[k-1] + frac * (grid[k] - grid[k-1])
            cross_found = true
        }
        k = k + 1
    }

    // determinism (F4)
    let mut byte_eq = true
    let mut c = 0
    while c < m {
        let r = mean_si_at(grid[c], seeds)
        if sv_abs(r - msi[c]) > 0.000000000001 { byte_eq = false }
        c = c + 1
    }

    let delta_center = sv_abs(i_star - gz_center)

    let f1 = cross_found && (i_star > gz_lower) && (i_star < gz_upper)
    let f2 = cross_found && (delta_center <= 0.05)
    let f3 = mono
    let f4 = byte_eq

    println("")
    println("── crossing ──")
    println("  crossing found = " + str(cross_found))
    println("  I* (SI=3)      = " + str(i_star))
    println("  GZ_CENTER 1/e  = " + str(gz_center))
    println("  |I* - 1/e|     = " + str(delta_center) + "   (F2 needs <= 0.05)")

    println("")
    println("── falsifiers ──")
    println("  F1 INSIDE-BAND (GZ_LOWER < I* < GZ_UPPER)  = " + str(f1))
    println("  F2 NEAR-CENTER (|I*-1/e| <= 0.05)          = " + str(f2))
    println("  F3 MONO-SWEEP  (mean-SI strictly dec.)     = " + str(f3))
    println("  F4 DETERMINISM (byte-identical)            = " + str(f4))

    let supported = f1 && f2 && f3 && f4
    let partial   = f1 && f3 && f4 && (!f2)
    let falsified = (!f1) || (!f3)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")
}
