// H_338 — attractor basin size vs dominance rank (n=4)
// H_336 found dominance partial order 110 > 30 > {105,150}. Hypothesis: this
// order tracks the size of each rule's attractor basin — the number of distinct
// attractor states (or the number of states whose orbit terminates in the
// smallest cycle). A bigger/more-absorbing basin should lock more rules out.
//
// We measure two basin descriptors per rule on the n=4 ring (16 states):
//   (A) n_attractor_states = count of states that lie ON a cycle (period-membership)
//   (B) max_basin = the size of the largest basin of attraction (how many of the
//       16 starts converge to the single most-attracting cycle)
//
// H1: dominance rank (110 > 30 > 105~150) is INVERSELY related to n_attractor_states
//     — the dominant rule has the SMALLEST, most-absorbing attractor (few states,
//     large basin), consistent with H_332 (rule110's 4-state attractor sinks rule30).
// Falsifier: rank does NOT track basin descriptors (no monotone relation).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

// terminal state of a start after settling (run 40 steps -> on the cycle)
fn settle(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 40 { s = next4(s, rule); t = t + 1 }
    return s
}

fn measure_rule(rule: int, name: string) {
    // A: states ON a cycle = settle(s) for all s, collect distinct terminal states.
    // After 40 steps every start is on its cycle; the set of settle() images is a
    // superset of attractor states. Count distinct terminal states.
    let on_cycle = farr_zeros(16)
    // B: basin counts — map each terminal to how many starts reach it
    let basin = farr_zeros(16)
    let mut s0 = 0
    while s0 < 16 {
        let term = settle(s0, rule)
        let _ = farr_set(on_cycle, term, 1.0)
        let cur = to_int(farr_get(basin, term))
        let _ = farr_set(basin, term, to_float(cur + 1))
        s0 = s0 + 1
    }
    let mut n_attr = 0
    let mut max_basin = 0
    let mut i = 0
    while i < 16 {
        if to_int(farr_get(on_cycle, i)) == 1 { n_attr = n_attr + 1 }
        let b = to_int(farr_get(basin, i))
        if b > max_basin { max_basin = b }
        i = i + 1
    }
    println("rule=" + str(rule) + " name=" + name + " n_attractor_states=" + str(n_attr) + " max_basin=" + str(max_basin))
    let _ = farr_free(on_cycle); let _ = farr_free(basin)
}

fn main() {
    println("H_338 attractor basin size vs dominance rank (n=4)")
    println("dominance rank from H_336: 110 > 30 > {105,150}")
    measure_rule(110, "rule110_RANK1")
    measure_rule(30, "rule30_RANK2")
    measure_rule(105, "rule105_RANK3")
    measure_rule(150, "rule150_RANK3")
    println("done")
}
