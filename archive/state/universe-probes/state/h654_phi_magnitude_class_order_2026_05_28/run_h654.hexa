// ════════════════════════════════════════════════════════════════════════════
//  run_h654.hexa — H_654 Φ-magnitude × Wolfram-class monotone order
//
//  CORE QUESTION (round 9 새 메타-축)
//    round 8 에서 Wolfram class 가 여러 Φ-속성을 지배함이 드러남:
//      • convexity 단조 (H_653: additive 12.1 < III 30.4 < IV 35.5)
//      • self-similarity class-IV 한정 (H_652)
//      • rule90 additive big-Φ ≈ 0 (H_642 Φ(0.50)=0.0526, H_614)
//    본 H = Φ-MAGNITUDE 자체가 Wolfram class 로 단조 정렬되는가.
//    "substrate-class = 의식 통합량 분류자" 새 메타-축의 기둥.
//
//  HYPOTHESIS
//    faithful big-Φ magnitude 가 Wolfram class 단조:
//      class-IV(rule110) > class-III(rule30/90chaotic) > class-II(rule184)
//      > additive(rule90 XOR ≈ 0).
//    즉 동역학 복잡도(class)가 Φ 절대크기를 order.
//
//  FALSIFIER
//    Φ-magnitude 가 class 무관 또는 비단조 (예: class-II 가 IV 보다 큼)
//    → class 가 Φ-magnitude 분류자 아님.
//
//  SUBSTRATE
//    ECA on a periodic ring of n=4 cells (H_351/H_614/H_642 동일 n).
//    rule set: {30, 54, 90, 110, 184} — Wolfram class 대표:
//      • rule 30   — class III chaotic
//      • rule 54   — class IV complex (edge-of-chaos)
//      • rule 90   — class III additive (XOR-linear, Sierpinski)
//      • rule 110  — class IV complex (universal)
//      • rule 184  — class II particle-localized (traffic flow)
//
//  Φ MEASUREMENT
//    faithful causal big-Φ at I=0 (UNMIXED eca_tpm, no inhibition),
//    average over all 2^4 = 16 states (single-state fragility 회피,
//    H_285/H_351/H_614/H_642 양식). 이것이 substrate 의 intrinsic
//    Φ-magnitude.
//
//  CRITERIA
//    class-tier label (lower = simpler):
//      additive(rule90)=0, II(rule184)=1, III-chaotic(rule30)=2, IV=3
//    M1 MONOTONE : tier-ordered Φ 가 약단조 비감소
//      (Φ[additive] ≤ Φ[II] ≤ Φ[III] ≤ Φ[IV])
//    M2 ADDITIVE-FLOOR : rule90 additive Φ 가 다른 4 rule 의 최소보다 작음
//      (H_642 rule90≈0 재현)
//    M3 IV-CEILING : class-IV (rule 110) Φ 가 class-II (rule 184) 보다 큼
//
//  AGGREGATE
//    SUPPORTED = M1 (full monotone tier order)
//    PARTIAL   = M2 & M3 PASS 이나 M1 FAIL (부분 정렬)
//    FALSIFIED = M2 또는 M3 FAIL (class 가 분류자 아님)
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h654/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _n() -> int { return 4 }


fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


fn intrinsic_phi(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)   // I=0, unmixed
    return mean_big_phi(tpm, n)
}


fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn json_arr_i(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_654 Φ-magnitude × Wolfram-class monotone order")
    println("rules {30, 54, 90, 110, 184}  n=4  I=0 intrinsic big-Φ")
    println("════════════════════════════════════════════════════════════")

    // measure order (rule index for reporting)
    let rules = [30, 54, 90, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "III-additive", "IV-complex", "II-particle"]

    let mut phis = []
    let mut r = 0
    let nr = len(rules)
    while r < nr {
        let rule = rules[r]
        let p = intrinsic_phi(rule, _n())
        phis = phis.push(p)
        println("  rule " + str(rule) + " (" + class_names[r] + ")  Φ = " + str(p))
        r = r + 1
    }

    // indices into rules[]:  0=r30(III) 1=r54(IV) 2=r90(additive) 3=r110(IV) 4=r184(II)
    let phi_r30  = phis[0]   // class III chaotic
    let phi_r54  = phis[1]   // class IV
    let phi_r90  = phis[2]   // class III additive (XOR)
    let phi_r110 = phis[3]   // class IV
    let phi_r184 = phis[4]   // class II

    // ── tier representatives (one per tier; class IV repr = rule 110 universal) ──
    // tier 0 additive  = rule 90
    // tier 1 II        = rule 184
    // tier 2 III-chaos = rule 30
    // tier 3 IV        = rule 110
    let t0 = phi_r90
    let t1 = phi_r184
    let t2 = phi_r30
    let t3 = phi_r110

    println("")
    println("── tier-ordered representatives ──")
    println("  tier0 additive (r90)  Φ = " + str(t0))
    println("  tier1 II      (r184)  Φ = " + str(t1))
    println("  tier2 III     (r30 )  Φ = " + str(t2))
    println("  tier3 IV      (r110)  Φ = " + str(t3))

    // M1 MONOTONE : t0 <= t1 <= t2 <= t3
    let mono01 = t0 <= t1
    let mono12 = t1 <= t2
    let mono23 = t2 <= t3
    let m1 = mono01 && mono12 && mono23
    let mut m1f = 0
    if m1 { m1f = 1 }

    // M2 ADDITIVE-FLOOR : rule90 < min of the other 4
    let mut min_other = phi_r30
    if phi_r54  < min_other { min_other = phi_r54 }
    if phi_r110 < min_other { min_other = phi_r110 }
    if phi_r184 < min_other { min_other = phi_r184 }
    let m2 = phi_r90 < min_other
    let mut m2f = 0
    if m2 { m2f = 1 }

    // M3 IV-CEILING : class IV (rule110) > class II (rule184)
    let m3 = phi_r110 > phi_r184
    let mut m3f = 0
    if m3 { m3f = 1 }

    println("")
    println("── falsifiers ──")
    println("  M1 MONOTONE      (t0≤t1≤t2≤t3) = " + str(m1f))
    println("       t0≤t1 = " + str(mono01) + "  t1≤t2 = " + str(mono12) + "  t2≤t3 = " + str(mono23))
    println("  M2 ADDITIVE-FLOOR (r90<min4)   = " + str(m2f) + "   (r90=" + str(phi_r90) + " min_other=" + str(min_other) + ")")
    println("  M3 IV-CEILING     (r110>r184)  = " + str(m3f) + "   (r110=" + str(phi_r110) + " r184=" + str(phi_r184) + ")")

    let mut verdict_str = "UNKNOWN"
    if m1 {
        verdict_str = "SUPPORTED"
    } else if m2 && m3 {
        verdict_str = "PARTIAL"
    } else {
        verdict_str = "FALSIFIED"
    }

    println("")
    println("════════════════════════════════════════════════════════════")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // descriptive observed order (sorted descending by Φ for the report)
    let m1_arr = [m1f, m2f, m3f]

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_654\",\n"
    s = s + "  \"slug\": \"phi-magnitude-wolfram-class-order\",\n"
    s = s + "  \"meta_axis\": \"round 9 — substrate-class = consciousness-integration classifier\",\n"
    s = s + "  \"rules\": [30, 54, 90, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"III-additive\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"inhibition\": 0.0,\n"
    s = s + "  \"phi_per_rule\": " + json_arr_f(phis) + ",\n"
    s = s + "  \"tier_repr_additive_r90\": " + str(t0) + ",\n"
    s = s + "  \"tier_repr_II_r184\": " + str(t1) + ",\n"
    s = s + "  \"tier_repr_III_r30\": " + str(t2) + ",\n"
    s = s + "  \"tier_repr_IV_r110\": " + str(t3) + ",\n"
    s = s + "  \"m1_monotone\": " + str(m1f) + ",\n"
    s = s + "  \"m2_additive_floor\": " + str(m2f) + ",\n"
    s = s + "  \"m3_iv_ceiling\": " + str(m3f) + ",\n"
    s = s + "  \"falsifiers\": " + json_arr_i(m1_arr) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h654_phi_magnitude_class_order_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h654_phi_magnitude_class_order_2026_05_28/result.json")
}
