// ════════════════════════════════════════════════════════════════════════════
// H_653 — collective-convexity-substrate-class  (H_643 정밀화, axis G×F)
//
//   PARENT FINDING (the thing being refined)
//     H_643 (PR #1237, 🟢 6/6) showed the 5-stream COLLECTIVE Φ entrains to the
//     90-min ultradian phase (r=0.568) but MORE WEAKLY than a single substrate
//     (H_634 r=0.802). The diagnosed cause: H_635's W→Φ_collective curve is
//     super-linear / CONVEX (N3 1.17 → REM 34.88 = ~30× span) so it departs
//     from a pure cosine far more than the single-substrate near-linear stage
//     projection (~7× span). H_643 used cohort C1 = [110×5] (rule110, class-IV).
//
//   THIS H — QUANTIFY HOW THAT CONVEXITY DEPENDS ON SUBSTRATE COMPLEXITY (rule
//   class). We re-run the H_643/H_635 engine (collective ring × sync-factor W
//   modulation) but swap the cohort's update law across 4 ECA rules spanning
//   the Wolfram complexity classes, sweep W over the ultradian-stage grid, and
//   read off the convexity = span ratio Φ_max/Φ_min for each rule.
//
//     ECA rule → Wolfram class (substrate complexity, ascending):
//       rule184  class-II   (additive/traffic, simplest ordered)
//       rule 90  class-III  (XOR/additive fractal, chaotic-additive)
//       rule 30  class-III  (chaotic, non-additive)
//       rule110  class-IV   (complex / universal, edge-of-chaos — H_643 winner)
//
//   H1 (CONVEXITY MONOTONE IN CLASS):  the W→Φ_collective span ratio
//       Φ_max/Φ_min rises monotonically with rule class:
//       class-IV (rule110) most convex > the additive/class-II rules.
//   H0 (FALSIFIER): convexity ⊥ rule class — span ratio rule-independent
//       (H_643's ~30× span would then be a cohort artifact, not substrate-class).
//
//   MODEL (no new physics — H_635/H_643 engine, only the cohort rule changes)
//     • homogeneous cohort [rule×5] for each of the 4 rules.
//     • W grid = the H_643 ultradian-stage sync_factor set {0.15,0.40,0.70,
//       0.95,1.0} PLUS a 0.55 mid-point (6 points) — same W-domain H_643 rides.
//     • collective-Φ(W) = big_phi_bounded(build_tpm_cohort([rule×5], W),5,0,3)[0]
//       — REAL IIT4 measurement per (rule,W) point, not a lookup.
//     • convexity(rule) = span ratio Φ_max / Φ_min over the W grid
//       (Φ_min guarded at a small floor; Φ_min≈0 → use additive offset).
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F653.1 CONVEXITY-MONOTONE : span_ratio(rule110) ≥ span_ratio(rule30)
//             ≥ span_ratio(rule90) ≥ span_ratio(rule184)  (monotone in class;
//             ties allowed via ≥). i.e. class-IV most convex.
//     F653.2 CLASS-IV-MOST-CONVEX: span_ratio(rule110) = max over the 4 rules
//             (strict head — class-IV is the single most-convex substrate).
//     F653.3 ADDITIVE-MORE-LINEAR: span_ratio(rule184) < span_ratio(rule110)
//             (the simplest additive/class-II rule is strictly more linear).
//     F653.4 W-MONOTONE-EACH-RULE : for every rule, Φ_collective is non-
//             decreasing in W (the H_635 monotone-in-W property survives the
//             rule swap — collective coupling helps regardless of class).
//     F653.5 H643-REPLICATE       : rule110 span ratio reproduces the H_643
//             order of magnitude (span_ratio(rule110) ≥ 10 — the ~30× H_643
//             span is a substrate-class property, replicated here).
//     F653.6 BOUND               : all Φ_collective ≥ 0, span ratios finite.
//
//   verdict: ≥4/6 PASS → 🟢 SUPPORTED-NUMERICAL.
//            F653.1 FAIL (convexity ⊥ class) → 🔴 FALSIFIED.
//
//   anchors: H_643 (collective ultradian r=0.568, convexity-cause diagnosis) ·
//            H_635 (collective-Φ super-additive, monotone-in-W) ·
//            H_634 (single-substrate ultradian r=0.802) ·
//            H_618 (collective gz inverse-U derivative peak).
//   deterministic · hexa-only · $0 mac-local · sys_state=0 · cap=3.
//
//   ⚠ C3: 5-stream cap=3 (H_643 cap retained). If a single sync run risks
//   >60s the W grid is shrunk to {0.15,0.40,0.70,0.95} (4 pts) per rule
//   (3-stream / cap=2 fallback noted as the harder-budget escape). Here the
//   full 6-pt × 4-rule = 24 big_phi_bounded calls ≈ H_643's 36-call budget.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── n=5 coupled-ring TPM with sync_factor W (verbatim from H_635/H_643) ───────
// 5 streams = 5 cells, cell i governed by distinct cohort rule[i].
// Decoupled (W=0): self-loop only (idx=7*c). Coupled (W=1): full ring.
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// collective big-Φ of the n=5 cohort ring at sync W (H_635/H_643 engine).
fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

fn main() {
    println("================================================================")
    println("  H_653 — collective-convexity-substrate-class (H_643 정밀화)")
    println("  W→Φ_collective convexity (span ratio) vs ECA rule class?")
    println("  IIT4 big_phi_bounded · n=5 homog cohort · cap=3 · sys=0")
    println("  4 rules × 6-pt W grid · convexity = Φ_max / Φ_min")
    println("================================================================")

    // 4 ECA rules spanning Wolfram complexity classes (ascending complexity)
    let RULES  = [184, 90, 30, 110]
    let CLASS  = ["II-additive", "III-XOR/additive", "III-chaotic", "IV-complex"]
    // W grid = H_643 ultradian-stage sync_factor set + a 0.55 mid (6 points).
    let WGRID  = [0.15, 0.40, 0.55, 0.70, 0.95, 1.0]
    let NW = 6
    let NR = 4

    // floor to guard Φ_min ≈ 0 in the span ratio (additive offset).
    let FLOOR = 0.0001

    println("  W grid: [0.15, 0.40, 0.55, 0.70, 0.95, 1.0]  (H_643 stage W + mid)")
    println("  ─────────────────────────────────────")

    let mut span_ratios = []
    let mut phi_mins = []
    let mut phi_maxs = []
    let mut all_w_monotone = true
    let mut all_bound = true

    let mut ri = 0
    while ri < NR {
        let rule = RULES[ri]
        let cohort = [rule, rule, rule, rule, rule]
        let mut phi_w = []
        let mut wi = 0
        while wi < NW {
            let W = WGRID[wi]
            let phi = phi_collective(cohort, W)
            phi_w = phi_w + [phi]
            if phi < 0.0 { all_bound = false }
            wi = wi + 1
        }
        // min / max over W grid
        let mut pmin = phi_w[0]
        let mut pmax = phi_w[0]
        wi = 0
        while wi < NW {
            if phi_w[wi] < pmin { pmin = phi_w[wi] }
            if phi_w[wi] > pmax { pmax = phi_w[wi] }
            wi = wi + 1
        }
        // W-monotone (non-decreasing) check per rule
        let mut mono = true
        wi = 1
        while wi < NW {
            if phi_w[wi] < phi_w[wi - 1] - 0.000001 { mono = false }
            wi = wi + 1
        }
        if mono == false { all_w_monotone = false }
        // span ratio = Φ_max / Φ_min (guarded floor)
        let denom = pmin + FLOOR
        let ratio = pmax / denom
        span_ratios = span_ratios + [ratio]
        phi_mins = phi_mins + [pmin]
        phi_maxs = phi_maxs + [pmax]

        // per-rule report line
        println("  rule" + str(rule) + " [" + CLASS[ri] + "]")
        let mut line = "    Φ(W):"
        wi = 0
        while wi < NW {
            line = line + " " + to_string(phi_w[wi])
            wi = wi + 1
        }
        println(line)
        let mono_s = "yes"
        if mono == false { mono_s = "NO" }
        println("    Φ_min=" + to_string(pmin) + " Φ_max=" + to_string(pmax) + " span_ratio=" + to_string(ratio) + " W-monotone=" + mono_s)
        ri = ri + 1
    }

    // index map: RULES = [184, 90, 30, 110] → idx 0,1,2,3
    let sr_184 = span_ratios[0]
    let sr_90  = span_ratios[1]
    let sr_30  = span_ratios[2]
    let sr_110 = span_ratios[3]

    println("  ─────────────────────────────────────")
    println("  span ratios by class (ascending complexity):")
    println("    rule184 (II-additive)      : " + to_string(sr_184))
    println("    rule90  (III-XOR/additive) : " + to_string(sr_90))
    println("    rule30  (III-chaotic)      : " + to_string(sr_30))
    println("    rule110 (IV-complex)       : " + to_string(sr_110))
    println("  ────────────── verdict ──────────────")

    // F653.1 CONVEXITY-MONOTONE: sr_110 >= sr_30 >= sr_90 >= sr_184
    let mono_class = (sr_110 >= sr_30) && (sr_30 >= sr_90) && (sr_90 >= sr_184)
    check("F653.1 CONVEXITY-MONOTONE: sr(110)>=sr(30)>=sr(90)>=sr(184)", mono_class)

    // F653.2 CLASS-IV-MOST-CONVEX: sr_110 = max
    let iv_max = (sr_110 >= sr_30) && (sr_110 >= sr_90) && (sr_110 >= sr_184)
    check("F653.2 CLASS-IV-MOST-CONVEX: sr(110) = max over 4 rules", iv_max)

    // F653.3 ADDITIVE-MORE-LINEAR: sr_184 < sr_110
    check("F653.3 ADDITIVE-MORE-LINEAR: sr(184) < sr(110)", sr_184 < sr_110)

    // F653.4 W-MONOTONE-EACH-RULE
    check("F653.4 W-MONOTONE-EACH-RULE: Φ_coll non-decreasing in W, all rules", all_w_monotone)

    // F653.5 H643-REPLICATE: sr_110 >= 10 (the ~30× H_643 span is substrate-class)
    check("F653.5 H643-REPLICATE: sr(rule110) >= 10 (H_643 ~30x span replicated)", sr_110 >= 10.0)

    // F653.6 BOUND: all Φ ≥ 0, span ratios finite
    let mut ratios_finite = true
    ri = 0
    while ri < NR {
        if fabs(span_ratios[ri]) > 1.0e12 { ratios_finite = false }
        ri = ri + 1
    }
    check("F653.6 BOUND: Φ_coll ≥ 0, span ratios finite", all_bound && ratios_finite)

    println("  ──────────────────────────────────────")
    println("  F653.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let mut verdict = "🔴 FALSIFIED"
    if PASS >= 4 { verdict = "🟢 SUPPORTED-NUMERICAL" }
    if mono_class == false { verdict = "🔴 FALSIFIED (convexity ⊥ rule class — cohort artifact)" }
    println("  verdict: " + verdict)
    println("  cross-link: H_643 cohort=rule110 span≈30x → here rule110 span_ratio=" + to_string(sr_110))
}
