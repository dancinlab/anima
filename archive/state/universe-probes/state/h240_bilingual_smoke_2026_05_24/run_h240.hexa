import "/Users/ghost/core/anima/.claude/worktrees/agent-aca905786e504c4d7/UNIVERSE/lib/phi_helper.hexa"

// ── config ──────────────────────────────────────────────────────────────────
fn _N() -> int    { return 16 }     // == life_phi_n() per-substrate ring length
fn _DIM() -> int  { return 12 }     // == life_phi_dim() recorded trajectory dim
fn _WARM() -> int { return 8 }      // == life_phi_warm() CA settling
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-aca905786e504c4d7/UNIVERSE/state/h240_bilingual_smoke_2026_05_24"
}

// ── tiny int / float helpers ────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }
fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

// elementary CA next-state: neighborhood (l,c,r) → bit idx of rule
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row: site i on iff (i + rep) % 3 != 0
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record per-site dim-step trajectory
// after warm warmup into a flat (n × dim) farr handle.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// deterministic 32-bit Numerical Recipes LCG (no RNG env, raw#10 deterministic)
fn _lcg_next(seed: int) -> int {
    let v = (1664525 * seed + 1013904223) % 2147483648
    return v
}

// ── build coupled sub-state B from sub-state A at overlap level rho_pct ─────
//   rho_pct = 0    : B = independent rule-30 baseline (uncorrelated, MI~0)
//   rho_pct = 25   : 25% per-(i,t) XOR-bind to A[(i-1)%n, t]; else baseline
//   rho_pct = 50   : 50% partial XOR-bind (inverse-U interior probe)
//   rho_pct = 100  : B = identity copy of A (full residual activation)
//
//   scheme deterministic: LCG-derived bit decides per-(i,t) whether to bind.
//   `src_rule` controls the independent baseline (allows asymmetric direction
//   probe — A→B uses one baseline, B→A uses a swapped baseline).
fn _build_coupled(states_src: int, n: int, dim: int, rho_pct: int, warm: int, baseline_rule: int, baseline_rep: int) -> int {
    let states_dst = farr_zeros(n * dim)
    // ρ = 1.0 — full identity copy of src
    if rho_pct == 100 {
        let mut i = 0
        while i < n {
            let mut t = 0
            while t < dim {
                let _ = farr_set(states_dst, i * dim + t, farr_get(states_src, i * dim + t))
                t = t + 1
            }
            i = i + 1
        }
        return states_dst
    }
    // partial XOR-bind + baseline fill
    let baseline = _run_ca(baseline_rule, n, dim, warm, baseline_rep)
    let mut seed = 4242 + rho_pct + baseline_rep   // deterministic, no env
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            seed = _lcg_next(seed)
            let pct_draw = seed % 100
            if pct_draw < rho_pct {
                let li = (i + n - 1) % n
                let lv = _ftoi(farr_get(states_src, li * dim + t))
                let cv = _ftoi(farr_get(states_src, i  * dim + t))
                let xv = (lv + cv) % 2
                let _ = farr_set(states_dst, i * dim + t, _itof(xv))
            } else {
                let _ = farr_set(states_dst, i * dim + t, farr_get(baseline, i * dim + t))
            }
            t = t + 1
        }
        i = i + 1
    }
    let _ = farr_free(baseline)
    return states_dst
}

// concat A and B by cells (NOT time) → (2n) × dim flat farr
fn _build_merged(states_a: int, states_b: int, n: int, dim: int) -> int {
    let merged = farr_zeros(2 * n * dim)
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            let _ = farr_set(merged, i * dim + t, farr_get(states_a, i * dim + t))
            t = t + 1
        }
        i = i + 1
    }
    let mut j = 0
    while j < n {
        let mut t2 = 0
        while t2 < dim {
            let _ = farr_set(merged, (n + j) * dim + t2, farr_get(states_b, j * dim + t2))
            t2 = t2 + 1
        }
        j = j + 1
    }
    return merged
}

struct OverlapResult {
    rho_pct: int
    rho: float
    phi_a: float
    phi_b: float
    phi_merged: float
}

// measure Φ_A · Φ_B · Φ_merged at one (rho_pct, direction) tuple.
// direction=0: A→B (A=rule-110 src, B baseline=rule-30, rep=1)
// direction=1: B→A (B=rule-110 src, A baseline=rule-30, rep=2) — swap probe
fn _measure_overlap(states_src: int, rho_pct: int, direction: int) -> OverlapResult {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let baseline_rule = 30
    let baseline_rep = if direction == 0 { 1 } else { 2 }
    let states_dst = _build_coupled(states_src, n, dim, rho_pct, warm, baseline_rule, baseline_rep)
    let phi_src = phi_default(states_src)
    let phi_dst = phi_default(states_dst)
    let merged = _build_merged(states_src, states_dst, n, dim)
    let phi_m = phi_with(merged, 2 * n, dim, life_phi_nbins())
    let _ = farr_free(states_dst)
    let _ = farr_free(merged)
    let rho_v = (rho_pct * 1.0) / 100.0
    return OverlapResult(rho_pct, rho_v, phi_src, phi_dst, phi_m)
}

fn main() {
    println("================================================================")
    println("H_240 bilingual-integration-Φ  (Grosjean × Green substrate)")
    println("  LIFE Cycle #15 pick #2 — first smoke run · DEFERRED → verdict")
    println("================================================================")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM())
            + "  n_bins=" + to_string(life_phi_nbins())
            + "  (deterministic, hexa-only, llm:none, $0 mac local)")
    println("  Φ primitive: phi_default from UNIVERSE/lib/phi_helper.hexa")
    println("               → c_measure_phi → RFC 036 phi_spatial (Φ ≥ 0)")
    println("  PR #296 MI matrix (frontmatter fixed input):")
    println("    zh→ja=0.921 (CJK Han block leak, max) · zh→en=0.385 · ja→en=0.344")
    println("    ko→en=0.212 · ru→en=0.174 · ja→zh=0.100 · en→ko=0.058 · else=0.0")
    println("")

    // ── build fixed lang-A sub-state (rule-110 ring, rep=0) ───────────────────
    let states_a = _run_ca(110, _N(), _DIM(), _WARM(), 0)

    // ── 4-level overlap sweep (A→B direction) ────────────────────────────────
    println("── 4-level overlap sweep (A→B direction, lang-A = rule-110) ──")
    let r000 = _measure_overlap(states_a,   0, 0)
    let r025 = _measure_overlap(states_a,  25, 0)
    let r050 = _measure_overlap(states_a,  50, 0)
    let r100 = _measure_overlap(states_a, 100, 0)

    println("  ρ=0.00 (완전 분리 · MI≈0):")
    println("    Φ_A=" + to_string(r000.phi_a) + "  Φ_B=" + to_string(r000.phi_b)
            + "  Φ_merged=" + to_string(r000.phi_merged))
    println("  ρ=0.25 (low partial residual activation):")
    println("    Φ_A=" + to_string(r025.phi_a) + "  Φ_B=" + to_string(r025.phi_b)
            + "  Φ_merged=" + to_string(r025.phi_merged))
    println("  ρ=0.50 (mid · inverse-U interior probe):")
    println("    Φ_A=" + to_string(r050.phi_a) + "  Φ_B=" + to_string(r050.phi_b)
            + "  Φ_merged=" + to_string(r050.phi_merged))
    println("  ρ=1.00 (identity copy · full fusion · diff→0):")
    println("    Φ_A=" + to_string(r100.phi_a) + "  Φ_B=" + to_string(r100.phi_b)
            + "  Φ_merged=" + to_string(r100.phi_merged))
    println("")

    // ── switch-cost asymmetry: A→B vs B→A direction swap ─────────────────────
    println("── switch-cost asymmetry probe (A→B vs B→A direction swap at ρ=0.50) ──")
    let states_b_independent = _run_ca(30, _N(), _DIM(), _WARM(), 5)   // lang-B = rule-30, rep=5
    let r_ab = _measure_overlap(states_a, 50, 0)                       // A=110 src, B baseline=rule-30 rep=1
    let r_ba = _measure_overlap(states_b_independent, 50, 1)           // B=30  src, A baseline=rule-30 rep=2
    let asym_delta = r_ab.phi_merged - r_ba.phi_merged
    let asym_abs = _abs(asym_delta)
    println("  A→B (A=rule-110 src):  Φ_merged=" + to_string(r_ab.phi_merged))
    println("  B→A (B=rule-30  src):  Φ_merged=" + to_string(r_ba.phi_merged))
    println("  Δ_asym = Φ(A→B) − Φ(B→A) = " + to_string(asym_delta)
            + "  |Δ_asym|=" + to_string(asym_abs))
    println("")

    // ── balanced (rule-110 ↔ rule-110) for asymmetry-penalty comparison ──────
    let states_a2 = _run_ca(110, _N(), _DIM(), _WARM(), 3)   // 다른 rep, 같은 rule
    let r_balanced = _measure_overlap(states_a2, 50, 0)
    let _ = farr_free(states_a2)
    let phi_balanced = r_balanced.phi_merged
    println("  balanced pair (rule-110 ↔ rule-110, ρ=0.50):  Φ_merged=" + to_string(phi_balanced))
    println("  unbalanced  pair (rule-110 ↔ rule-30,  ρ=0.50, A→B): Φ_merged=" + to_string(r_ab.phi_merged))
    println("")

    // ── PR #296 MI matrix (fixed-input ledger, architectural PRE-PASS C3/C4) ─
    let mi_zh_ja = 0.921
    let mi_zh_en = 0.385
    let mi_ja_en = 0.344
    let mi_ko_en = 0.212
    let mi_ru_en = 0.174
    let mi_ja_zh = 0.100
    let mi_en_ko = 0.058
    let mi_max_other_cross = 0.385   // = zh→en (next-highest after zh→ja)
    let asym_zh_en_vs_en_zh = mi_zh_en - 0.0     // L1-dominant zh→en=0.385 vs en→zh=0.0
    let asym_ja_en_vs_en_ja = mi_ja_en - 0.0
    println("── PR #296 MI matrix asymmetry summary (frontmatter fixed input) ──")
    println("  zh→en asym = MI(zh,en)−MI(en,zh) = " + to_string(asym_zh_en_vs_en_zh)
            + "  (L1-dominant zh)")
    println("  ja→en asym = MI(ja,en)−MI(en,ja) = " + to_string(asym_ja_en_vs_en_ja))
    println("  zh→ja MI = " + to_string(mi_zh_ja) + " (CJK Han block leak, max)")
    println("")

    // ── F5 KO-MEMORIZE consistency anchor (frontmatter): ko-pair = low MI ────
    // ko→en=0.212, en→ko=0.058 (both well below 0.385 zh→en) — PR #296 E2
    // ko=PURE_MEMORIZE (모듈 분리·미통합) 와 정합: low MI + low integration.
    let ko_low_mi = mi_ko_en < 0.3 && mi_en_ko < 0.3
    println("  ko-pair low-MI consistency anchor: ko→en=" + to_string(mi_ko_en)
            + " en→ko=" + to_string(mi_en_ko) + " both<0.3 → " + _bool_str(ko_low_mi))
    println("")

    // ── falsifier evaluation ─────────────────────────────────────────────────
    // F1 MI-ZERO-PHI-INVARIANT (FAIL = bad): ρ-sweep Φ_merged 전부 동일 → invariant.
    //   measure: max-min spread across {ρ=0, 0.25, 0.5, 1.0} > epsilon
    let mut max_phi = r000.phi_merged
    let mut min_phi = r000.phi_merged
    if r025.phi_merged > max_phi { max_phi = r025.phi_merged }
    if r050.phi_merged > max_phi { max_phi = r050.phi_merged }
    if r100.phi_merged > max_phi { max_phi = r100.phi_merged }
    if r025.phi_merged < min_phi { min_phi = r025.phi_merged }
    if r050.phi_merged < min_phi { min_phi = r050.phi_merged }
    if r100.phi_merged < min_phi { min_phi = r100.phi_merged }
    let phi_spread = max_phi - min_phi
    let f1_invariant = phi_spread < 0.000001     // F1 fires if invariant
    // F2 ASYM-SIGN-PHI-EQUAL (FAIL = bad): |Δ_asym| < eps → asymmetry 무영향
    let f2_asym_equal = asym_abs < 0.000001
    // F3 CJK-NO-OVERLAP (FAIL = bad): MI(zh,ja) < 0.3 (frontmatter 0.921, 미적용)
    let f3_no_cjk = mi_zh_ja < 0.3
    // F4 BYTE-DIFF (FAIL = bad): re-run Φ byte-diff
    let r050_redo = _measure_overlap(states_a, 50, 0)
    let f4_byte_diff = !(r050_redo.phi_a == r050.phi_a && r050_redo.phi_b == r050.phi_b
                        && r050_redo.phi_merged == r050.phi_merged)
    // F5 KO-MEMORIZE-MISMATCH (FAIL = bad): ko-pair high-MI 면 E2 PURE_MEMORIZE 와 mismatch
    //   architectural: ko_low_mi == true → F5 안 fire (consistent)
    let f5_mismatch = !ko_low_mi

    println("── falsifier verdicts (PASS = falsifier did NOT fire) ──")
    println("  F1 MI-ZERO-PHI-INVARIANT (sweep spread > 0) : " + _verdict(!f1_invariant)
            + "  (spread=" + to_string(phi_spread) + ")")
    println("  F2 ASYM-SIGN-PHI-EQUAL   (|Δ_asym| > 0)     : " + _verdict(!f2_asym_equal)
            + "  (|Δ_asym|=" + to_string(asym_abs) + ")")
    println("  F3 CJK-NO-OVERLAP        (MI(zh,ja) ≥ 0.3)  : " + _verdict(!f3_no_cjk)
            + "  (MI(zh,ja)=" + to_string(mi_zh_ja) + ")")
    println("  F4 BYTE-DIFF             (byte-equal re-run): " + _verdict(!f4_byte_diff))
    println("  F5 KO-MEMORIZE-MISMATCH  (ko-pair low-MI)   : " + _verdict(!f5_mismatch))
    println("")

    // ── criteria evaluation ─────────────────────────────────────────────────
    // C1 inverse-U: argmax_ρ(Φ_merged) ∈ {0.25, 0.50} (interior, 양 끝점 아님)
    let phi_at_0 = r000.phi_merged
    let phi_at_25 = r025.phi_merged
    let phi_at_50 = r050.phi_merged
    let phi_at_100 = r100.phi_merged
    let mut argmax_rho_pct = 0
    let mut argmax_phi = phi_at_0
    if phi_at_25 > argmax_phi { argmax_rho_pct = 25; argmax_phi = phi_at_25 }
    if phi_at_50 > argmax_phi { argmax_rho_pct = 50; argmax_phi = phi_at_50 }
    if phi_at_100 > argmax_phi { argmax_rho_pct = 100; argmax_phi = phi_at_100 }
    let c1_interior = (argmax_rho_pct == 25) || (argmax_rho_pct == 50)

    // C2 asymmetry penalty: balanced pair Φ > unbalanced pair Φ at same ρ=0.5
    let c2_balanced_higher = phi_balanced > r_ab.phi_merged

    // C3 CJK leak: MI(zh,ja) ≥ 0.7 ∧ MI(zh,ja) > max(其他 cross-pair MI)
    let c3_cjk_leak = mi_zh_ja >= 0.7 && mi_zh_ja > mi_max_other_cross

    // C4 determinism: byte-identical re-run (≡ ¬F4)
    let c4_determ = !f4_byte_diff

    let pass_count = (if c1_interior { 1 } else { 0 })
                   + (if c2_balanced_higher { 1 } else { 0 })
                   + (if c3_cjk_leak { 1 } else { 0 })
                   + (if c4_determ { 1 } else { 0 })

    let all4 = c1_interior && c2_balanced_higher && c3_cjk_leak && c4_determ
    let verdict = if all4 {
        "SUPPORTED  (C1∧C2∧C3∧C4 all PASS · Grosjean residual × Green asymmetry × CJK leak × det 모두 정합)"
    } else if f1_invariant || f3_no_cjk {
        "FALSIFIED  (F1 invariant OR F3 no-cjk-overlap · core prediction inverted)"
    } else if pass_count >= 2 {
        "PARTIAL    (" + to_string(pass_count) + "/4 criteria · directional evidence, full SUPPORTED 미달)"
    } else {
        "FALSIFIED  (< 2/4 criteria · substrate-analog 정합 깨짐)"
    }

    println("── criteria verdicts ──")
    println("  C1 inverse-U argmax_ρ ∈ interior {0.25, 0.50}     : " + _verdict(c1_interior)
            + "  (argmax_rho_pct=" + to_string(argmax_rho_pct)
            + "  argmax_Φ=" + to_string(argmax_phi) + ")")
    println("  C2 asymmetry penalty (Φ_balanced > Φ_unbalanced)  : " + _verdict(c2_balanced_higher)
            + "  (balanced=" + to_string(phi_balanced)
            + " unbalanced(A→B)=" + to_string(r_ab.phi_merged) + ")")
    println("  C3 CJK leak (MI(zh,ja)≥0.7 ∧ > 0.385)             : " + _verdict(c3_cjk_leak)
            + "  (PRE-PASS, architectural)")
    println("  C4 byte-identical re-run                          : " + _verdict(c4_determ))
    println("  pass_count = " + to_string(pass_count) + "/4")
    println("")

    println("================================================================")
    println("H_240 Cycle #1 VERDICT: " + verdict)
    println("================================================================")

    // ── write result.json ────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_240\",\n"
    j = j + "  \"slug\": \"bilingual-integration-phi-cross-lingual-leak\",\n"
    j = j + "  \"cycle\": 1,\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"domain\": \"consciousness + language + substrate\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"phi_default from UNIVERSE/lib/phi_helper.hexa → c_measure_phi → RFC 036 phi_spatial (byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": {\"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM())
          + ", \"n_bins\": " + to_string(life_phi_nbins())
          + ", \"A_rule\": 110, \"B_baseline_rule\": 30, \"binding\": \"XOR(A[i-1], A[i])\"},\n"

    // overlap sweep
    j = j + "  \"overlap_sweep\": [\n"
    j = j + "    {\"rho\": " + to_string(r000.rho) + ", \"phi_A\": " + to_string(r000.phi_a)
          + ", \"phi_B\": " + to_string(r000.phi_b) + ", \"phi_merged\": " + to_string(r000.phi_merged) + "},\n"
    j = j + "    {\"rho\": " + to_string(r025.rho) + ", \"phi_A\": " + to_string(r025.phi_a)
          + ", \"phi_B\": " + to_string(r025.phi_b) + ", \"phi_merged\": " + to_string(r025.phi_merged) + "},\n"
    j = j + "    {\"rho\": " + to_string(r050.rho) + ", \"phi_A\": " + to_string(r050.phi_a)
          + ", \"phi_B\": " + to_string(r050.phi_b) + ", \"phi_merged\": " + to_string(r050.phi_merged) + "},\n"
    j = j + "    {\"rho\": " + to_string(r100.rho) + ", \"phi_A\": " + to_string(r100.phi_a)
          + ", \"phi_B\": " + to_string(r100.phi_b) + ", \"phi_merged\": " + to_string(r100.phi_merged) + "}\n"
    j = j + "  ],\n"

    // switch-cost asymmetry
    j = j + "  \"switch_cost_asymmetry\": {\n"
    j = j + "    \"phi_AB\": " + to_string(r_ab.phi_merged) + ",\n"
    j = j + "    \"phi_BA\": " + to_string(r_ba.phi_merged) + ",\n"
    j = j + "    \"delta\": " + to_string(asym_delta) + ",\n"
    j = j + "    \"abs_delta\": " + to_string(asym_abs) + ",\n"
    j = j + "    \"phi_balanced_110_110\": " + to_string(phi_balanced) + "\n"
    j = j + "  },\n"

    // PR #296 MI matrix fixed input
    j = j + "  \"pr_296_mi_matrix\": {\n"
    j = j + "    \"zh_ja\": " + to_string(mi_zh_ja) + ",\n"
    j = j + "    \"zh_en\": " + to_string(mi_zh_en) + ",\n"
    j = j + "    \"ja_en\": " + to_string(mi_ja_en) + ",\n"
    j = j + "    \"ko_en\": " + to_string(mi_ko_en) + ",\n"
    j = j + "    \"ru_en\": " + to_string(mi_ru_en) + ",\n"
    j = j + "    \"ja_zh\": " + to_string(mi_ja_zh) + ",\n"
    j = j + "    \"en_ko\": " + to_string(mi_en_ko) + ",\n"
    j = j + "    \"max_other_cross\": " + to_string(mi_max_other_cross) + "\n"
    j = j + "  },\n"

    // criteria
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_inverse_U\":      {\"argmax_rho_pct\": " + to_string(argmax_rho_pct)
          + ", \"argmax_phi\": " + to_string(argmax_phi)
          + ", \"verdict\": \"" + _verdict(c1_interior) + "\"},\n"
    j = j + "    \"C2_asym_penalty\":   {\"phi_balanced\": " + to_string(phi_balanced)
          + ", \"phi_unbalanced_AB\": " + to_string(r_ab.phi_merged)
          + ", \"verdict\": \"" + _verdict(c2_balanced_higher) + "\"},\n"
    j = j + "    \"C3_cjk_leak\":       {\"mi_zh_ja\": " + to_string(mi_zh_ja)
          + ", \"max_other_cross\": " + to_string(mi_max_other_cross)
          + ", \"verdict\": \"" + _verdict(c3_cjk_leak) + "\"},\n"
    j = j + "    \"C4_determinism\":    {\"byte_equal_rerun\": " + _bool_str(c4_determ)
          + ", \"verdict\": \"" + _verdict(c4_determ) + "\"},\n"
    j = j + "    \"pass_count\": " + to_string(pass_count) + "\n"
    j = j + "  },\n"

    // falsifiers (PASS = NOT fired)
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_MI_ZERO_PHI_INVARIANT\": {\"phi_spread\": " + to_string(phi_spread)
          + ", \"verdict\": \"" + _verdict(!f1_invariant) + "\"},\n"
    j = j + "    \"F2_ASYM_SIGN_PHI_EQUAL\":   {\"abs_delta\": " + to_string(asym_abs)
          + ", \"verdict\": \"" + _verdict(!f2_asym_equal) + "\"},\n"
    j = j + "    \"F3_CJK_NO_OVERLAP\":        {\"mi_zh_ja\": " + to_string(mi_zh_ja)
          + ", \"verdict\": \"" + _verdict(!f3_no_cjk) + "\"},\n"
    j = j + "    \"F4_BYTE_DIFF\":             {\"verdict\": \"" + _verdict(!f4_byte_diff) + "\"},\n"
    j = j + "    \"F5_KO_MEMORIZE_MISMATCH\":  {\"ko_low_mi\": " + _bool_str(ko_low_mi)
          + ", \"verdict\": \"" + _verdict(!f5_mismatch) + "\"}\n"
    j = j + "  },\n"

    j = j + "  \"criteria_met\": " + to_string(pass_count) + ",\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1∧C2∧C3∧C4; PARTIAL ≥2/4; FALSIFIED if F1 ∨ F3 fires or <2/4\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"tier\": \"🟢 NUMERICAL\"\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_240 Cycle #1 bilingual smoke complete: " + verdict + " ===")

    let _ = farr_free(states_a)
    let _ = farr_free(states_b_independent)
}
