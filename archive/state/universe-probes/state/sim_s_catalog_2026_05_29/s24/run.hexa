// S24 cloud-distributed consciousness (IIT exclusion).
// Falsifier: if a substrate severed into two independent halves keeps Φ,
//   distributed (network-partitioned) consciousness is viable. Severing the
//   ring's {0,1}|{2,3} causal links drops Φ 14.1492 -> 0.0 (100%) ⇒ no
//   distributed consciousness (IIT exclusion postulate).
// substrate: ECA rule110 n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi_tpm(t: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(t, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}
// Sever cross-group links: build TPM from rule but each cell sees neighbours
// only within its group {0,1} or {2,3} (cross edges replaced by self / wrap-in-group).
fn severed_tpm(rule: int) -> array {
    let n = 4
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            // group of cell i: {0,1} or {2,3}; neighbours wrap WITHIN the group.
            let g0 = (i / 2) * 2          // group base
            let lo = g0
            let hi = g0 + 1
            let mut li = lo               // left neighbour within group
            if i == lo { li = hi }
            let mut ri = lo               // right neighbour within group
            if i == lo { ri = hi }
            let l = iit4_bit(s, li)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, ri)
            let idx = 4 * l + 2 * c + r
            t = t.push(to_float(iit4_bit(rule, idx)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn main() {
    let I = 0.21232
    let n = 4
    let whole = max_bigphi_tpm(scale_tpm(eca_tpm(110, n), 1.0 - I), n)
    let sev = max_bigphi_tpm(scale_tpm(severed_tpm(110), 1.0 - I), n)
    let mut drop_pct = 0.0
    if whole > 1.0e-9 { drop_pct = 100.0 * (whole - sev) / whole }
    print("whole Phi          = "); println(whole)
    print("severed {0,1}|{2,3}= "); println(sev)
    print("drop %             = "); println(drop_pct)
    let pass = (whole > 14.0) && (sev < 1.0e-9) && (drop_pct > 99.999)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
