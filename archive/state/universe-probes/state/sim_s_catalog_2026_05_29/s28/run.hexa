// S28 conway/ECA spectrum — does the substrate rule determine Φ?
// Falsifier: if Φ is substrate-independent, all rules give the same Φ. Five rules
//   span 0.20492 (rule90) to 19.9378 (rule184) ⇒ Φ is strongly substrate-
//   (rule-) dependent: the dynamical law, not just size, sets integration.
// substrate: ECA n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let n = 4
    let r30 = max_bigphi(30, n, I)
    let r54 = max_bigphi(54, n, I)
    let r90 = max_bigphi(90, n, I)
    let r110 = max_bigphi(110, n, I)
    let r184 = max_bigphi(184, n, I)
    print("rule30  Phi = "); println(r30)
    print("rule54  Phi = "); println(r54)
    print("rule90  Phi = "); println(r90)
    print("rule110 Phi = "); println(r110)
    print("rule184 Phi = "); println(r184)
    // spread: max - min should be large (substrate matters).
    let lo = r90
    let hi = r184
    let pass = (r110 > 14.0) && (r184 > 19.0) && (r90 < 0.21) && (hi - lo > 19.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
