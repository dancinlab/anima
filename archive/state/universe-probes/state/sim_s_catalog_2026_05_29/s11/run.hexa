// S11 single-cell Φ — integration requires >=2 elements.
// Falsifier: if a single cell (n=1) carries Φ>0, a lone element is conscious.
//   Φ(n=1)=0; Φ rises with system size ⇒ integration is a >=2-element property.
// substrate: ECA rule110, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let p1 = max_bigphi(110, 1, I)
    let p2 = max_bigphi(110, 2, I)
    let p3 = max_bigphi(110, 3, I)
    let p4 = max_bigphi(110, 4, I)
    print("Phi(n=1) = "); println(p1)
    print("Phi(n=2) = "); println(p2)
    print("Phi(n=3) = "); println(p3)
    print("Phi(n=4) = "); println(p4)
    let pass = (p1 < 1.0e-9) && (p2 > 0.0) && (p4 > p3) && (p3 > p2)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
