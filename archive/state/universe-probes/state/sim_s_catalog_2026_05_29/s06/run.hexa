// S06 merge — is Φ additive when two systems merge?
// Falsifier: if merging two n=2 systems (Φ each 0.10246, sum 0.20492) yields a
//   merged n=4 Φ equal to the sum, Φ is additive. Merged = 14.1492 >> 0.20492
//   ⇒ strongly non-additive (1+1 >> 2): integration creates novel structure.
// substrate: ECA rule110, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let part = max_bigphi(110, 2, I)     // each isolated n=2
    let part_sum = part + part
    let merged = max_bigphi(110, 4, I)   // merged n=4
    let delta = merged - part_sum
    let mut ad = delta
    if ad < 0.0 { ad = 0.0 - ad }
    print("each part n=2 Phi  = "); println(part)
    print("parts sum (2x)     = "); println(part_sum)
    print("merged n=4 Phi     = "); println(merged)
    print("|merged - sum|     = "); println(ad)
    let pass = (merged > 14.0) && (part_sum < 0.21) && (part_sum > 0.20) && (merged > 10.0 * part_sum)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
