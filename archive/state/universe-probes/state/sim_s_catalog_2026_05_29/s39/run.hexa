// S39 free will (Libet) — can a fully deterministic substrate still be integrated?
// Falsifier: if integration (Phi>0) requires indeterminism, a perfectly predictable
//   substrate must have Phi=0. rule110 is 100% deterministic (t-1 -> t prediction
//   accuracy 16/16 = 1.0) yet max big-Phi = 14.1492 > 0 ⇒ "free will" is not
//   randomness: a determined substrate can be a maximal integrated complex.
// substrate: ECA rule110 n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
// determinism check on RAW (unscaled) TPM: every entry 0.0 or 1.0 ⇒ next state
// is a unique function of current state ⇒ perfectly predictable.
fn det_accuracy(rule: int, n: int) -> float {
    let raw = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut ok = 0
    let mut s = 0
    while s < full {
        let mut deterministic = 1
        let mut i = 0
        while i < n {
            let v = raw[s * n + i]
            let near0 = (v < 1.0e-9)
            let near1 = ((v - 1.0) < 1.0e-9) && ((v - 1.0) > -1.0e-9)
            if (near0 == false) && (near1 == false) { deterministic = 0 }
            i = i + 1
        }
        if deterministic == 1 { ok = ok + 1 }
        s = s + 1
    }
    return to_float(ok) / to_float(full)
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let n = 4
    let acc = det_accuracy(110, n)
    let phi = max_bigphi(110, n, I)
    print("pred_accuracy(t-1 -> t) = "); println(acc)
    print("max big-Phi             = "); println(phi)
    let acc_is_one = ((acc - 1.0) < 1.0e-9) && ((acc - 1.0) > -1.0e-9)
    let pass = acc_is_one && (phi > 14.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
