// H_337 — oscillation number-theory: dominant rule vs ring-size factorization
// H_334 found: n=4 rule30, n=6 rule110, n=8 rule30 dominant (cycle length).
// Hypothesis: rule30 (chaotic) dominates at n = 2^k (4,8,16),
//             rule110 (universal) dominates at n = 2*odd (6,10).
// Test n in {4,6,8,10,12}. n=12 = 2^2 * 3 (mixed) is the decisive case.
//
// n=10 -> 1024 states, n=12 -> 4096 states; forward cycle length is cheap
// (single visited bitmap per start). We measure mean cycle length for rule30
// and rule110 at each n and report which dominates.
//
// H1 (number-theory): rule30 dominant at n in {4,8} (pure 2^k), rule110 dominant
//    at n in {6,10} (2*odd); n=12 (2^2*3) is the tiebreak.
// Falsifier: the dominance does NOT follow the 2^k vs 2*odd split.

fn nextN(s: int, rule: int, n: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < n {
        let im1 = (i + n - 1) % n
        let ip1 = (i + 1) % n
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

// cycle length via Floyd-free visited bitmap; nstates can be large so we cap the
// forward horizon at 4*nstates (a cycle must appear within nstates steps, cap is
// generous). visited tracked in a farr of size nstates.
fn cycle_len(s0: int, rule: int, n: int, nstates: int, cap: int) -> int {
    let seen = farr_zeros(nstates)
    let idx_at = farr_zeros(nstates)
    let mut s = s0
    let mut t = 0
    while t < cap {
        if to_int(farr_get(seen, s)) == 1 {
            let first = to_int(farr_get(idx_at, s))
            let _ = farr_free(seen); let _ = farr_free(idx_at)
            return t - (first - 1)
        }
        let _ = farr_set(seen, s, 1.0)
        let _ = farr_set(idx_at, s, to_float(t + 1))
        s = nextN(s, rule, n)
        t = t + 1
    }
    let _ = farr_free(seen); let _ = farr_free(idx_at)
    return -1
}

// To keep runtime bounded we SAMPLE starting states: stride over the state space.
fn mean_cycle_sampled(rule: int, n: int, nstates: int, stride: int) -> float {
    let cap = nstates + 5
    let mut total = 0
    let mut count = 0
    let mut s0 = 0
    while s0 < nstates {
        let L = cycle_len(s0, rule, n, nstates, cap)
        if L > 0 { total = total + L; count = count + 1 }
        s0 = s0 + stride
    }
    if count == 0 { return 0.0 }
    return to_float(total) / to_float(count)
}

fn report_n(n: int, nstates: int, stride: int) {
    let r30 = mean_cycle_sampled(30, n, nstates, stride)
    let r110 = mean_cycle_sampled(110, n, nstates, stride)
    let dom = if r30 > r110 { 30 } else { 110 }
    println("n=" + str(n) + " nstates=" + str(nstates) + " stride=" + str(stride) + " r30=" + str(r30) + " r110=" + str(r110) + " dominant=rule" + str(dom))
}

fn main() {
    println("H_337 oscillation number-theory (dominant rule vs n factorization)")
    // small n: full sweep (stride 1). large n: sampled stride.
    report_n(4, 16, 1)       // 2^2
    report_n(6, 64, 1)       // 2*3
    report_n(8, 256, 1)      // 2^3
    report_n(10, 1024, 1)    // 2*5  (1024 full is fine)
    report_n(12, 4096, 4)    // 2^2*3  (sample stride 4 = 1024 starts)
    println("factorization: n4=2^2 n6=2*3 n8=2^3 n10=2*5 n12=2^2*3")
    println("done")
}
