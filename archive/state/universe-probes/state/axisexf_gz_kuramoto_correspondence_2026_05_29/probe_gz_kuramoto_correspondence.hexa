// ════════════════════════════════════════════════════════════════════════════
//  probe_gz_kuramoto_correspondence.hexa — H_axisexf_gz_kuramoto_correspondence
//
//  CROSS-PRODUCT  axis-E (SAVANT) × axis-F (HIVE-MIND)
//
//  CORE QUESTION
//    Both substrates carry an "interaction-strength → integration" curve:
//      • SAVANT  : interaction = inhibition I ∈ [0,1]; integration = SI = max/min(domain_Φ).
//                  (axis-E PR#1364) SI(I) is MONOTONE DECREASING — savant (SI>3) at low I,
//                  sub-savant (SI<3) at high I, crossing SI=3 at I*≈0.398≈1/e (GZ_CENTER).
//      • HIVE-MIND : interaction = Kuramoto coupling K ≥ 0; sync r∞(K) MONOTONE INCREASING,
//                  but collective-Φ super-additive Δ MONOTONE DECREASING (sub-additive),
//                  Pearson(r∞,Δ)=−0.934 (axis-F PR#1362). K_c sync-transition ≈ 2.
//    Do these two interaction→integration curves CORRESPOND (genuine shared law) or are
//    they ORTHOGONAL (interaction-strength acts on integration by unrelated mechanisms)?
//    Prior E×F rounds (H_617-628) found ⊥. We test the NEW band/transition findings.
//
//  PRE-REGISTERED FALSIFIERS (frozen before run)
//    We run BOTH substrates in one process, normalize each interaction axis to [0,1],
//    and compare the integration curves at matched normalized positions.
//
//    F1 SLOPE-SIGN     : both integration curves have the SAME sign of slope vs interaction.
//                        SAVANT integration slope (SI vs I) and HIVE-MIND integration slope
//                        (Δ vs K) — both must be < 0 (interaction anti-drives integration)
//                        OR both > 0. If signs MATCH ⇒ a shared interaction→integration law.
//    F2 TRANSITION-MAP : the SAVANT savant→sub transition (normalized I*_norm = (I*−I_lo)/(I_hi−I_lo))
//                        aligns with the Kuramoto sync K_c transition (normalized K_c_norm)
//                        within tol 0.15. Both are the "integration regime boundary" on their axis.
//    F3 CURVE-PEARSON  : Pearson( SI(I_norm) , Δ(K_norm) ) over matched normalized interaction
//                        grid. |Pearson| ≥ 0.7 ⇒ curves co-vary (correspondence). < 0.3 ⇒ ⊥.
//    F4 DETERMINISM    : in-process recompute byte-identical (|Δ| ≤ 1e-12).
//
//  VERDICT_RULE
//    ALIGNED (🟢)      = F1 ∧ F3 ∧ F4 ∧ F2          (shared law: same slope sign + transition map + co-vary)
//    PARTIAL (🟠)      = F1 ∧ F4 ∧ (F2 XOR F3)       (slope sign matches but transition OR curve only)
//    ORTHOGONAL (🔴)   = (!F1) ∨ (!F3 ∧ !F2)         (slope sign differs OR neither transition nor curve match)
//                        — closed-negative: GZ band ⊥ Kuramoto K-curve, valid finding (a_paper_negative_ok).
//
//  HONEST NOTE on directionality: SAVANT SI is a SPECIALIZATION/diversity measure (high SI =
//    one domain dominates = specialist), while HIVE-MIND Δ is a SUPER-ADDITIVE INTEGRATION
//    measure (high Δ = whole > parts). They are NOT the same observable. F1 tests whether the
//    SIGN of "interaction → that-substrate's-integration-proxy" coincides, NOT whether the
//    proxies are interchangeable. A negative F1/F3 is the honest expected outcome and closes
//    the E×F cross with a genuine orthogonality finding.
//
//  $0 · pool ubu-2 Linux + mac-local cross · hexa-only · LLM none · deterministic.
//  Primitives replicated in-file (import-avoidance, per H_348/H_axise convention +
//    hivemind_lib.hexa committed harness carries a stale abs-path import).
// ════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
//  SAVANT substrate (verbatim from probe_gz_si_crossing.hexa / savant_phi.hexa SSOT)
// ─────────────────────────────────────────────────────────────────────────────
let SV_D        = 6
let SV_N_DOM    = 4
let SV_CAPACITY = 11.5

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}
fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}
fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}
fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}
fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}
fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}
fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}
fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}
fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}
fn savant_index(dphi: array) -> float {
    let n = len(dphi)
    if n == 0 { return 0.0 }
    let mut mx = dphi[0]
    let mut mn = dphi[0]
    let mut i = 1
    while i < n {
        if dphi[i] > mx { mx = dphi[i] }
        if dphi[i] < mn { mn = dphi[i] }
        i = i + 1
    }
    if mn <= 0.000000001 { return 0.0 }
    return mx / mn
}
fn si_at_inhibition(inhibit: float, stim_seed: int) -> float {
    let gain_focus = 1.0 + (1.0 - inhibit) * 9.0
    let gain_rest  = (SV_CAPACITY - gain_focus) / 3.0
    let flat = build_profile_state(gain_focus, gain_rest, gain_rest, gain_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    return savant_index(dphi)
}
fn mean_si_at(inhibit: float, seeds: array) -> float {
    let ns = len(seeds)
    let mut s = 0.0
    let mut i = 0
    while i < ns {
        s = s + si_at_inhibition(inhibit, seeds[i])
        i = i + 1
    }
    return s / to_float(ns)
}

// ─────────────────────────────────────────────────────────────────────────────
//  HIVE-MIND substrate (verbatim from hivemind_lib.hexa + axisf run.hexa)
// ─────────────────────────────────────────────────────────────────────────────
fn hm_kuramoto_order_r(phases: array) -> float {
    let n = len(phases)
    if n == 0 { return 0.0 }
    let mut sum_c = 0.0
    let mut sum_s = 0.0
    let mut i = 0
    while i < n {
        sum_c = sum_c + cos(phases[i])
        sum_s = sum_s + sin(phases[i])
        i = i + 1
    }
    let nn = to_float(n)
    let cx = sum_c / nn
    let cy = sum_s / nn
    return sqrt(cx * cx + cy * cy)
}
fn hm_collective_phi_super_additive(phi_a: float, phi_b: float, phi_ab: float) -> float {
    return phi_ab - (phi_a + phi_b)
}
fn omega_table(n: int) -> array {
    let q = [-1.2815515594, -0.5244005127, 0.0, 0.5244005127, 1.2815515594]
    let mut out = []
    let mut i = 0
    while i < n {
        out = out.push(q[i % 5])
        i = i + 1
    }
    return out
}
fn init_phases(n: int) -> array {
    let twopi = 6.283185307179586
    let mut out = []
    let mut i = 0
    while i < n {
        out = out.push(twopi * to_float(i) / to_float(n))
        i = i + 1
    }
    return out
}
fn kuramoto_step(phases: array, omega: array, K: float, dt: float) -> array {
    let n = len(phases)
    let mut np = []
    let mut i = 0
    while i < n {
        let mut cs = 0.0
        let mut j = 0
        while j < n {
            cs = cs + sin(phases[j] - phases[i])
            j = j + 1
        }
        let dtheta = omega[i] + (K / to_float(n)) * cs
        np = np.push(phases[i] + dt * dtheta)
        i = i + 1
    }
    return np
}
fn slice_half(phases: array, lo: int, hi: int) -> array {
    let mut out = []
    let mut i = lo
    while i < hi {
        out = out.push(phases[i])
        i = i + 1
    }
    return out
}
fn phi_proxy(r: float) -> float {
    let mut rr = r
    if rr > 0.999999 { rr = 0.999999 }
    if rr < 0.0 { rr = 0.0 }
    return 0.0 - log(1.0 - rr)
}
// steady-state delta + order r for a given K. returns [r_ab, delta]
fn kuramoto_cell(K: float, N: int, dt: float, STEPS: int) -> array {
    let mut ph = init_phases(N)
    let omega = omega_table(N)
    let mut s = 0
    while s < STEPS {
        ph = kuramoto_step(ph, omega, K, dt)
        s = s + 1
    }
    let r_ab = hm_kuramoto_order_r(ph)
    let r_a  = hm_kuramoto_order_r(slice_half(ph, 0, N / 2))
    let r_b  = hm_kuramoto_order_r(slice_half(ph, N / 2, N))
    let phi_a  = phi_proxy(r_a)
    let phi_b  = phi_proxy(r_b)
    let phi_ab = phi_proxy(r_ab)
    let delta = hm_collective_phi_super_additive(phi_a, phi_b, phi_ab)
    return [r_ab, delta]
}

// ─────────────────────────────────────────────────────────────────────────────
//  cross utilities
// ─────────────────────────────────────────────────────────────────────────────
fn pearson(xs: array, ys: array) -> float {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let nn = to_float(n)
    let mut mx = 0.0
    let mut my = 0.0
    let mut i = 0
    while i < n { mx = mx + xs[i]; my = my + ys[i]; i = i + 1 }
    mx = mx / nn
    my = my / nn
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    let mut k = 0
    while k < n {
        let dx = xs[k] - mx
        let dy = ys[k] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        k = k + 1
    }
    if sxx <= 0.0 || syy <= 0.0 { return 0.0 }
    return sxy / sqrt(sxx * syy)
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_axisexf_gz_kuramoto_correspondence")
    println("  E×F cross: SAVANT GZ band (I→SI) vs HIVE-MIND Kuramoto (K→Δ)")
    println("  both are interaction-strength → integration curves")
    println("════════════════════════════════════════════════════════════")

    let seeds = [42424, 91919, 77777]

    // ── matched normalized interaction grid (10 points, t ∈ [0,1]) ──
    // SAVANT I ∈ [GZ_LOWER, GZ_UPPER] = [0.21232, 0.5]   (the Golden Zone band)
    // HIVE   K ∈ [0, K_MAX=4.0]                          (sub→super critical sweep)
    let I_lo = 0.21232
    let I_hi = 0.5
    let K_lo = 0.0
    let K_hi = 4.0
    let NP = 10
    let N = 8
    let dt = 0.05
    let STEPS = 400

    let mut tnorm = []
    let mut si_curve = []     // SAVANT integration proxy (SI) at I(t)
    let mut delta_curve = []  // HIVE-MIND integration proxy (Δ) at K(t)
    let mut rinf_curve = []   // HIVE-MIND sync r∞ at K(t)

    println("")
    println("── matched normalized sweep  t = (interaction − lo)/(hi − lo) ──")
    println("  t      |  I(savant) | SI        || K(hive) | r_inf    | Delta")
    let mut g = 0
    while g < NP {
        let t = to_float(g) / to_float(NP - 1)
        let I = I_lo + t * (I_hi - I_lo)
        let K = K_lo + t * (K_hi - K_lo)
        let si = mean_si_at(I, seeds)
        let kc = kuramoto_cell(K, N, dt, STEPS)
        let r_ab = kc[0]
        let delta = kc[1]
        tnorm = tnorm.push(t)
        si_curve = si_curve.push(si)
        delta_curve = delta_curve.push(delta)
        rinf_curve = rinf_curve.push(r_ab)
        println("  " + str(t) + "  | " + str(I) + " | " + str(si)
                + " || " + str(K) + " | " + str(r_ab) + " | " + str(delta))
        g = g + 1
    }

    // ── F1 SLOPE-SIGN: end-to-start slope sign on each substrate ──
    let si_slope = si_curve[NP - 1] - si_curve[0]        // SAVANT integration vs interaction
    let delta_slope = delta_curve[NP - 1] - delta_curve[0]  // HIVE integration vs interaction
    let si_sign_neg = si_slope < 0.0
    let delta_sign_neg = delta_slope < 0.0
    let f1 = (si_sign_neg == delta_sign_neg)             // same sign

    // ── F2 TRANSITION-MAP ──
    //  SAVANT transition: SI=3 crossing I* (interpolate), normalized to band.
    let thresh = 3.0
    let mut si_cross = false
    let mut i_star = 0.0
    let mut a = 1
    while a < NP {
        if (si_curve[a-1] >= thresh) && (si_curve[a] < thresh) && (!si_cross) {
            let frac = (si_curve[a-1] - thresh) / (si_curve[a-1] - si_curve[a])
            let I_prev = I_lo + tnorm[a-1] * (I_hi - I_lo)
            let I_curr = I_lo + tnorm[a]   * (I_hi - I_lo)
            i_star = I_prev + frac * (I_curr - I_prev)
            si_cross = true
        }
        a = a + 1
    }
    let i_star_norm = (i_star - I_lo) / (I_hi - I_lo)
    //  HIVE transition: Kuramoto K_c — r∞ steepest-rise midpoint. Find largest
    //  consecutive r∞ jump; K_c = midpoint of that K-interval (the sync transition).
    let mut max_jump = -1.0
    let mut kc_idx = 0
    let mut b = 1
    while b < NP {
        let jump = rinf_curve[b] - rinf_curve[b-1]
        if jump > max_jump { max_jump = jump; kc_idx = b }
        b = b + 1
    }
    let kc_norm = (tnorm[kc_idx] + tnorm[kc_idx - 1]) / 2.0   // normalized K_c position
    let trans_gap = sv_abs(i_star_norm - kc_norm)
    let f2 = si_cross && (trans_gap <= 0.15)

    // ── F3 CURVE-PEARSON ──
    let pr = pearson(si_curve, delta_curve)
    let abspr = sv_abs(pr)
    let f3 = abspr >= 0.7
    let f3_orth = abspr < 0.3

    // ── F4 DETERMINISM (recompute) ──
    let mut byte_eq = true
    let mut c = 0
    while c < NP {
        let t = to_float(c) / to_float(NP - 1)
        let I = I_lo + t * (I_hi - I_lo)
        let K = K_lo + t * (K_hi - K_lo)
        let si2 = mean_si_at(I, seeds)
        let kc2 = kuramoto_cell(K, N, dt, STEPS)
        if sv_abs(si2 - si_curve[c]) > 0.000000000001 { byte_eq = false }
        if sv_abs(kc2[1] - delta_curve[c]) > 0.000000000001 { byte_eq = false }
        c = c + 1
    }
    let f4 = byte_eq

    println("")
    println("── F1 SLOPE-SIGN ──")
    println("  SAVANT  SI slope (I_hi − I_lo)      = " + str(si_slope) + "   neg=" + str(si_sign_neg))
    println("  HIVE    Δ slope (K_hi − K_lo)       = " + str(delta_slope) + "   neg=" + str(delta_sign_neg))
    println("  F1 same-sign                        = " + str(f1))
    println("")
    println("── F2 TRANSITION-MAP ──")
    println("  SAVANT SI=3 crossing  I*            = " + str(i_star) + "   norm=" + str(i_star_norm))
    println("  HIVE   K_c (steepest r∞ rise)  norm = " + str(kc_norm) + "   (max jump=" + str(max_jump) + ")")
    println("  |I*_norm − K_c_norm|                = " + str(trans_gap) + "   (F2 needs <= 0.15)")
    println("  F2 transition-map                   = " + str(f2))
    println("")
    println("── F3 CURVE-PEARSON ──")
    println("  Pearson( SI(t) , Δ(t) )             = " + str(pr) + "   |r|=" + str(abspr))
    println("  F3 co-vary (|r|>=0.7)               = " + str(f3))
    println("  orthogonal (|r|<0.3)                = " + str(f3_orth))
    println("")
    println("── F4 DETERMINISM ──")
    println("  byte-identical recompute            = " + str(f4))

    let aligned    = f1 && f3 && f4 && f2
    let partial    = f1 && f4 && ((f2 && (!f3)) || ((!f2) && f3))
    let orthogonal = (!f1) || ((!f3) && (!f2))

    let mut verdict_str = "UNKNOWN"
    if orthogonal { verdict_str = "ORTHOGONAL" }
    if partial    { verdict_str = "PARTIAL" }
    if aligned    { verdict_str = "ALIGNED" }

    println("")
    println("  VERDICT_RULE: ALIGNED iff F1∧F2∧F3∧F4 ; PARTIAL iff F1∧F4∧(F2 XOR F3) ; ORTHOGONAL iff !F1 ∨ (!F2∧!F3)")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")
}
