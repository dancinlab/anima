// ════════════════════════════════════════════════════════════════════════════
//  probe_gz_band_per_domain.hexa — H_axise_gz_band_per_domain
//
//  CORE QUESTION
//    H_axise_gz_band_si + H_348 measured the GZ SI-band only for CALENDAR (dom 0)
//    hypertrophy. The savant_phi model has 4 hypertrophy domains
//    (CALENDAR/MUSIC/ART/MEMORY). Is the "GZ is a bounded SI band" property
//    DOMAIN-INVARIANT — does SI(GZ_LOWER)>3 AND SI(GZ_UPPER)<3 hold for ALL 4
//    domains, or is it CALENDAR-specific? If the band is a structural
//    consequence of the capacity invariant (Treffert/Snyder release), it should
//    be invariant to WHICH domain is released.
//
//  HYPOTHESIS (pre-registered falsifier, frozen before run)
//    For all 4 hypertrophy domains d ∈ {0,1,2,3}, with SI = max/min(domain_phi)
//    averaged over seeds {42424,91919,77777}:
//
//      F1 ALL-LOWER-SAVANT : for ALL d, mean SI_d(GZ_LOWER)  > 3
//      F2 ALL-UPPER-SUBSAV : for ALL d, mean SI_d(GZ_UPPER)  < 3
//      F3 ALL-MONO         : for ALL d, SI_d(LOWER) > SI_d(CENTER) > SI_d(UPPER)
//      F4 DETERMINISM      : recompute byte-identical (|Δ| <= 1e-12)
//
//    SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4   (band is domain-invariant)
//    PARTIAL   = (>=1 domain passes F1∧F2∧F3) ∧ !(all 4) ∧ F4  (partial invariance)
//    FALSIFIED = no domain passes F1∧F2∧F3  (band is not a real property)
//
//  SUBSTRATE / MAPPING — identical to H_axise_gz_band_si + H_348:
//    savant_phi.hexa 4-domain d=6, cap=11.5, SI=max/min(domain_phi),
//    gain_focus = 1 + (1-I)*9. Only the hypertrophied domain index varies.
//
//  $0 · mac-local + ubu-2 · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

let SV_D        = 6
let SV_N_DOM    = 4
let SV_CAPACITY = 11.5

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}
fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}
fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}
fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}
fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}
fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}
fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}
fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}
fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}
fn savant_index(dphi: array) -> float {
    let n = len(dphi)
    if n == 0 { return 0.0 }
    let mut mx = dphi[0]
    let mut mn = dphi[0]
    let mut i = 1
    while i < n {
        if dphi[i] > mx { mx = dphi[i] }
        if dphi[i] < mn { mn = dphi[i] }
        i = i + 1
    }
    if mn <= 0.000000001 { return 0.0 }
    return mx / mn
}

// SI at inhibition I, hypertrophying domain `dom`
fn si_at_inhibition_dom(inhibit: float, dom: int, stim_seed: int) -> float {
    let gain_focus = 1.0 + (1.0 - inhibit) * 9.0
    let gain_rest  = (SV_CAPACITY - gain_focus) / 3.0
    let mut g0 = gain_rest
    let mut g1 = gain_rest
    let mut g2 = gain_rest
    let mut g3 = gain_rest
    if dom == 0 { g0 = gain_focus }
    if dom == 1 { g1 = gain_focus }
    if dom == 2 { g2 = gain_focus }
    if dom == 3 { g3 = gain_focus }
    let flat = build_profile_state(g0, g1, g2, g3, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    return savant_index(dphi)
}

fn mean_si_dom(inhibit: float, dom: int, seeds: array) -> float {
    let ns = len(seeds)
    let mut s = 0.0
    let mut i = 0
    while i < ns {
        s = s + si_at_inhibition_dom(inhibit, dom, seeds[i])
        i = i + 1
    }
    return s / to_float(ns)
}

fn dom_name(d: int) -> string {
    if d == 0 { return "CALENDAR" }
    if d == 1 { return "MUSIC" }
    if d == 2 { return "ART" }
    if d == 3 { return "MEMORY" }
    return "?"
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_axise_gz_band_per_domain — is the GZ SI-band domain-invariant?")
    println("  substrate: HEXAD/SAVANT/savant_phi.hexa (SSOT) — 4-domain d=6")
    println("  SI=max/min(domain_phi) ; threshold=3 ; mean over 3 seeds")
    println("  GZ_LOWER=0.21232  GZ_CENTER=0.36788(1/e)  GZ_UPPER=0.5")
    println("  hypertrophy domain d in {CALENDAR, MUSIC, ART, MEMORY}")
    println("════════════════════════════════════════════════════════════")

    let seeds = [42424, 91919, 77777]
    let gz_lower = 0.21232
    let gz_center = 0.36788
    let gz_upper = 0.5

    let mut all_f1 = true
    let mut all_f2 = true
    let mut all_f3 = true
    let mut n_pass = 0

    println("")
    println("── per-domain SI at GZ landmarks (mean over 3 seeds) ──")
    let mut d = 0
    while d < SV_N_DOM {
        let lo = mean_si_dom(gz_lower,  d, seeds)
        let ce = mean_si_dom(gz_center, d, seeds)
        let up = mean_si_dom(gz_upper,  d, seeds)

        let d_f1 = lo > 3.0
        let d_f2 = up < 3.0
        let d_f3 = (lo > ce) && (ce > up)

        if !d_f1 { all_f1 = false }
        if !d_f2 { all_f2 = false }
        if !d_f3 { all_f3 = false }
        if d_f1 && d_f2 && d_f3 { n_pass = n_pass + 1 }

        println("  d=" + str(d) + " " + dom_name(d) +
                "  SI(LOWER)=" + str(lo) +
                "  SI(CENTER)=" + str(ce) +
                "  SI(UPPER)=" + str(up) +
                "  [F1>3=" + str(d_f1) + " F2<3=" + str(d_f2) + " F3mono=" + str(d_f3) + "]")
        d = d + 1
    }

    // determinism F4
    let mut byte_eq = true
    let mut dd = 0
    while dd < SV_N_DOM {
        let r1 = mean_si_dom(gz_lower,  dd, seeds)
        let r2 = mean_si_dom(gz_lower,  dd, seeds)
        if sv_abs(r1 - r2) > 0.000000000001 { byte_eq = false }
        dd = dd + 1
    }

    let f1 = all_f1
    let f2 = all_f2
    let f3 = all_f3
    let f4 = byte_eq

    println("")
    println("── falsifiers ──")
    println("  F1 ALL-LOWER-SAVANT (all 4 dom SI@LOWER > 3)  = " + str(f1))
    println("  F2 ALL-UPPER-SUBSAV (all 4 dom SI@UPPER < 3)  = " + str(f2))
    println("  F3 ALL-MONO         (all 4 dom L>C>U)         = " + str(f3))
    println("  F4 DETERMINISM      (byte-identical)          = " + str(f4))
    println("  domains passing F1∧F2∧F3 = " + str(n_pass) + " / 4")

    let supported = f1 && f2 && f3 && f4
    let partial   = (n_pass >= 1) && (!(f1 && f2 && f3)) && f4
    let falsified = n_pass == 0

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")
}
