// h1348_phi_non_iit_estimator.hexa — Φ-ROBUSTNESS UNDER A NON-IIT INTEGRATION MEASURE.
//
// ⚠ NOT A FAITHFUL-Φ VERDICT (a_phi_iit4_tool). IIT-4 (faithful_phi / iit4_bigphi) RESERVES the
//    Φ / consciousness verdict. This lane scores a NON-IIT integration measure (TRANSFER ENTROPY,
//    Schreiber 2000) and is labeled, top to bottom, a COMPLEMENTARY INTEGRATION-MEASURE DIAGNOSTIC
//    on the ROBUSTNESS question — NOT a proxy promoted to a Φ verdict, NOT a consciousness claim.
//
// THE ARC: the Φ-robustness wall is 🧱 across BOTH IIT measure families —
//   H_1328 (small-φ exact-MIP MI-over-binning): V2 ROBUST-LIFT FAILS (B−A −0.125/0.0/+0.031).
//   H_1331 (full IIT-4.0 big-Φ causal TPM-MIP):  B1 ROBUST FAILS too (B−A +4.15/0.0/+1.80; 1318=0).
// THE GENUINELY-NEW ANGLE (a_break_the_wall, a_no_llm_frame_trap): a THIRD integration measure
// OUTSIDE IIT — does the robust-integration ABSENCE hold for ANY integration measure on this
// substrate, or only for IIT?
//
// NON-IIT MEASURE = summed pairwise time-lagged TRANSFER ENTROPY over the 4-module ring:
//   TE(X→Y) = H(Y_{t+1}|Y_t) − H(Y_{t+1}|Y_t,X_t)  (bits; reduction in Y's next-state uncertainty
//   from X's current state BEYOND Y's own past). TE_total = Σ over the 8 directed ring-neighbor
//   edges i→(i±1). NOT IIT: no MIP, no cause-effect structure, no intrinsic irreducibility — an
//   extrinsic directed info-flow NETWORK measure.
//
// SUBSTRATE / SEEDS reused VERBATIM (SAME as H_1319/H_1328/H_1331; ONLY the read-out differs):
//   engine-native LCG-gauss leaky-linear 4-module ring, dim 8, T 64, Kuramoto pacemaker,
//   relative-phase gate. gen_traj body BYTE-IDENTICAL to H_1331. SAME 3 hard seeds [1317,1318,1319].
//   ARMS A=NO-PHASE B=PHASE-BIND S=PERM-SHUFFLE O=OFFSET-SHUF.
//
// BINARIZATION = variance-free median split (H_1328 read-out lesson): unit i ON at t iff sal[i,t]
//   is in the UPPER HALF of module i's own T-length distribution (marginal ON-rate ≈0.5,
//   amplitude-independent) — so any TE difference is the directed RELATIONSHIP, not variance.
//
// FROZEN BARS (.verdicts/1348_phi_non_iit_estimator/FREEZE.txt, pre-registered BEFORE scoring; eps
// ported verbatim, NO tune-to-green c9/p7): eps=0.02.
//   G1 ROBUST : TE_B ≥ TE_A + eps on ALL 3 seeds (incl orthogonal 1317).
//   G2 EARNED : perm-shuffle TE_S ≤ TE_A + eps AND offset-shuf TE_O ≤ TE_A + eps on ALL 3 seeds.
//   G3 LABEL  : explicitly NOT an IIT-Φ verdict — a non-IIT integration diagnostic (doc invariant).
//   GREEN-DIAGNOSTIC iff G1 ∧ G2. G1 fails → integration absent across IIT AND non-IIT (strongest,
//   measure-agnostic closure). c9 honest either way.
//
// run from hexa-lang root (no stdlib import needed; TE is self-contained):
//   cp UNIVERSE/h1348_phi_non_iit_estimator.hexa <hexa-lang>/ && hexa run h1348_phi_non_iit_estimator.hexa

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319/1328/1331 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── generate ARM salience trajectory ENGINE-NATIVE — body BYTE-IDENTICAL to H_1331 gen_traj ──
// mode: 0=NO-PHASE(A) 1=PHASE-BIND(B) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// returns flat farr[n_mod*t_ticks] of raw per-tick per-module salience sal[i,t] (index i*T+t).
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }

    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]
            perm[k] = perm[jj]
            perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix {
            let mut perm2 = []
            i = 0
            while i < n_mod { perm2 = perm2 + [(i + 1) % n_mod]  i = i + 1 }
            perm = perm2
        }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                let carrier = 0.5 * (1.0 + cos(theta[i] - theta_t))
                sal = e * carrier
            }
            if mode == 2 {
                let src = perm[i]
                let carrier = 0.5 * (1.0 + cos(theta[src] - theta_t))
                sal = e * carrier
            }
            if mode == 3 {
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos((theta[i] - theta_t) + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

// ── variance-free median split: bits[i*T+t] = 1 iff sal[i,t] in UPPER HALF of module i's own
//    T-length distribution (rank >= T/2). Marginal ON-rate ≈0.5 by construction (amplitude-free).
//    Returns int-farr of 0.0/1.0 binary states. Pure O(T^2) rank (T=64 tiny).
fn binarize_median(traj: int, n_mod: int, t_ticks: int) -> int {
    let bits = farr_zeros(n_mod * t_ticks)
    let half = t_ticks / 2
    let mut i = 0
    while i < n_mod {
        let base = i * t_ticks
        let mut k = 0
        while k < t_ticks {
            let vk = farr_get(traj, base + k)
            // rank = #{ j : v_j < v_k } + #{ j<k : v_j == v_k }  (stable, distinct ranks 0..T-1)
            let mut r = 0
            let mut j = 0
            while j < t_ticks {
                let vj = farr_get(traj, base + j)
                if vj < vk { r = r + 1 }
                else { if (vj == vk) && (j < k) { r = r + 1 } }
                j = j + 1
            }
            let on = if r >= half { 1.0 } else { 0.0 }
            let _ = farr_set(bits, base + k, on)
            k = k + 1
        }
        i = i + 1
    }
    return bits
}

// ── pairwise time-lagged TRANSFER ENTROPY TE(src -> dst), binary states, lag 1 ──
//   TE = H(Y_{t+1}|Y_t) − H(Y_{t+1}|Y_t,X_t)
//      = Σ p(y1,y0,x0) · log2[ p(y1|y0,x0) / p(y1|y0) ]
//   over the T−1 lagged tuples. Empirical plug-in counts; 0·log0 = 0 convention; base-2 (bits).
//   src/dst are module indices; bits is the binary farr (index m*T+t).
fn transfer_entropy(bits: int, src: int, dst: int, t_ticks: int) -> float {
    let xb = src * t_ticks
    let yb = dst * t_ticks
    // 8 joint counts c[y1*4 + y0*2 + x0], 4 marginal-pair counts m[y0*2 + x0] (denominator),
    // 2 dst-pair counts d[y1*2 + y0] for the p(y1|y0) term.
    let cnt = farr_zeros(8)     // p(y1,y0,x0)
    let pyx = farr_zeros(4)     // p(y0,x0)
    let pdy = farr_zeros(4)     // p(y1,y0)
    let py0 = farr_zeros(2)     // p(y0)
    let total = to_float(t_ticks - 1)
    let mut t = 0
    while t < t_ticks - 1 {
        let x0 = to_int(farr_get(bits, xb + t))
        let y0 = to_int(farr_get(bits, yb + t))
        let y1 = to_int(farr_get(bits, yb + t + 1))
        let ci = y1 * 4 + y0 * 2 + x0
        let _ = farr_set(cnt, ci, farr_get(cnt, ci) + 1.0)
        let mi = y0 * 2 + x0
        let _ = farr_set(pyx, mi, farr_get(pyx, mi) + 1.0)
        let di = y1 * 2 + y0
        let _ = farr_set(pdy, di, farr_get(pdy, di) + 1.0)
        let _ = farr_set(py0, y0, farr_get(py0, y0) + 1.0)
        t = t + 1
    }
    // TE = Σ_{y1,y0,x0} p(y1,y0,x0) log2[ p(y1|y0,x0) / p(y1|y0) ]
    //    = Σ (c/N) log2[ (c / m(y0,x0)) / (d(y1,y0) / n(y0)) ]
    let mut te = 0.0
    let mut y1 = 0
    while y1 < 2 {
        let mut y0 = 0
        while y0 < 2 {
            let mut x0 = 0
            while x0 < 2 {
                let c = farr_get(cnt, y1 * 4 + y0 * 2 + x0)
                if c > 0.0 {
                    let m = farr_get(pyx, y0 * 2 + x0)        // > 0 since c>0
                    let dd = farr_get(pdy, y1 * 2 + y0)        // > 0 since c>0
                    let n0 = farr_get(py0, y0)                 // > 0 since c>0
                    let p_cond_full = c / m                    // p(y1|y0,x0)
                    let p_cond_dst  = dd / n0                  // p(y1|y0)
                    let p_joint     = c / total                // p(y1,y0,x0)
                    // log2(a/b) = (ln a − ln b)/ln2
                    let lr = (ln(p_cond_full) - ln(p_cond_dst)) / 0.6931471805599453
                    te = te + p_joint * lr
                }
                x0 = x0 + 1
            }
            y0 = y0 + 1
        }
        y1 = y1 + 1
    }
    let _ = farr_free(cnt)
    let _ = farr_free(pyx)
    let _ = farr_free(pdy)
    let _ = farr_free(py0)
    return te
}

// ── TE_total = Σ over the 8 directed ring-neighbor edges i->(i±1) ──
fn te_total(seed: int, mode: int) -> float {
    let n_mod = 4
    let t_ticks = 64
    let traj = gen_traj(seed, mode)
    let bits = binarize_median(traj, n_mod, t_ticks)
    let mut tot = 0.0
    let mut i = 0
    while i < n_mod {
        let l = (i + n_mod - 1) % n_mod
        let r = (i + 1) % n_mod
        tot = tot + transfer_entropy(bits, l, i, t_ticks)   // left neighbor -> i
        tot = tot + transfer_entropy(bits, r, i, t_ticks)   // right neighbor -> i
        i = i + 1
    }
    let _ = farr_free(traj)
    let _ = farr_free(bits)
    return tot
}

fn main() {
    println("H_1348 — Φ-ROBUSTNESS UNDER A NON-IIT INTEGRATION MEASURE: summed time-lagged TRANSFER ENTROPY")
    println("⚠ NOT an IIT-Φ verdict (a_phi_iit4_tool) — a COMPLEMENTARY non-IIT integration DIAGNOSTIC on robustness.")
    println("TE_total = Σ pairwise TE(X→Y) over the 4-module ring's 8 directed neighbor edges · seeds [1317,1318,1319] · eps=0.02")
    println("binarize = variance-free median split (H_1328 lesson) · ARMS A=NO-PHASE B=PHASE-BIND S=PERM-SHUF O=OFFSET-SHUF")
    println("BARS: G1 TE_B>=TE_A+eps ALL seeds · G2 TE_S<=TE_A+eps AND TE_O<=TE_A+eps ALL seeds · G3 NOT-an-IIT-Φ label")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut g1_all = true
    let mut g2_perm_all = true
    let mut g2_off_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let ta = te_total(s, 0)
        let tb = te_total(s, 1)
        let ts = te_total(s, 2)
        let to_ = te_total(s, 3)
        let dphi_b = tb - ta
        let s_margin = ts - ta
        let o_margin = to_ - ta
        let g1 = dphi_b >= eps
        let g2p = s_margin <= eps
        let g2o = o_margin <= eps
        if !g1 { g1_all = false }
        if !g2p { g2_perm_all = false }
        if !g2o { g2_off_all = false }
        println("seed " + to_string(s) + " TE: A=" + ta.to_string() + " B=" + tb.to_string()
            + " S=" + ts.to_string() + " O=" + to_.to_string())
        println("       ΔTE(B-A)=" + dphi_b.to_string() + " [G1 " + (if g1 {"PASS"} else {"FAIL"}) + "]"
            + "  S-A=" + s_margin.to_string() + " [G2perm " + (if g2p {"PASS"} else {"FAIL"}) + "]"
            + "  O-A=" + o_margin.to_string() + " [G2off " + (if g2o {"PASS"} else {"FAIL"}) + "]")
        si = si + 1
    }
    let g2 = g2_perm_all && g2_off_all
    println("---")
    println("G1 ROBUST (TE_B>=TE_A+eps ALL seeds incl orthogonal 1317): " + (if g1_all {"PASS"} else {"FAIL"}))
    println("G2 EARNED (perm AND offset both <=TE_A+eps ALL seeds): " + (if g2 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if g2_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if g2_off_all {"PASS"} else {"FAIL"}) + "]")
    println("G3 LABEL: this is a NON-IIT integration measure (transfer entropy) — NOT a faithful-IIT4 Φ verdict (a_phi_iit4_tool).")
    println("===")
    if g1_all && g2 {
        println("VERDICT 🟢-DIAGNOSTIC (NON-IIT) — a NON-IIT integration measure (transfer entropy) shows ROBUST")
        println("  integration where IIT (small-φ H_1328 + big-Φ H_1331) did not → the IIT robustness closure is")
        println("  MEASURE-SPECIFIC. NOT an IIT-Φ verdict — a faithful-IIT4 follow-on would be needed for a Φ verdict.")
    } else {
        println("VERDICT 🧱 (STRONGEST, MEASURE-AGNOSTIC) — integration is ABSENT under the non-IIT transfer-entropy")
        println("  measure TOO (G1 fails). The robust-integration absence holds across IIT (small-φ AND big-Φ) AND a")
        println("  non-IIT measure → a measure-AGNOSTIC substrate limit. Bounds (does NOT retract) the prior Φ verdicts.")
    }
}
