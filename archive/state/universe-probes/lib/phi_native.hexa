// UNIVERSE/lib/phi_native.hexa — thin compatibility shim over hexa-lang stdlib.
//
//   M5 MIGRATION (STDLIB domain)
//     The 332-LoC pure-hexa port was promoted to hexa-lang stdlib:
//       phi_bin_values     → stdlib/info/binning::bin_values_minmax            (PR #769)
//       phi_entropy        → stdlib/info/entropy::shannon_entropy              (PR #769)
//       phi_native_mi_pair → stdlib/info/mutual_info::mutual_info_pair         (PR #769)
//       _phi_pow2/_phi_bit_set → stdlib/math/bitops::{pow2_int,bit_set}        (PR #769)
//       phi_native_spatial → stdlib/consciousness/phi_spatial::phi_spatial_native
//                            (PR #780, renamed #792 — `phi_spatial` is a builtin)
//     This file now DELEGATES, preserving the surface used by callers
//     (phi_helper.hexa · verify_phi_native.hexa · diag_l1_binning.hexa).
//
//   WHY phi_spatial_native (NOT the `phi_spatial` builtin)
//     The pure-hexa replica is the byte-equal-FROZEN reference
//     (HEXAD/STDLIB/phi_native_predecomp_baseline_2026_05_24.md § 2.1). The
//     C-replica builtin has drifted from it (rfc_036_c_replica_drift, e.g.
//     rule110 4.9773e-09 → 4.90943e-06), so delegating to the builtin would
//     break byte-equal. We delegate to the stdlib REPLICA, which preserves the
//     frozen values bit-identically (delegation adds zero float ops).
//
//   IMPORT-SAFE  no `fn main()`, no top-level call.
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/phi_spatial.hexa"
import "stdlib/info/binning.hexa"

// ── spatial Φ — delegates to the stdlib pure-hexa replica (frozen reference) ─
fn phi_native_spatial(state: int, n_cells: int, dim: int, n_bins: int) -> float {
    return phi_spatial_native(state, n_cells, dim, n_bins)
}

// ── step-1 binning — kept for diag_l1_binning.hexa (external caller) ────────
fn phi_bin_values(values: int, n: int, n_bins: int) -> int {
    return bin_values_minmax(values, n, n_bins)
}

// ── phi_native — array-arg convenience wrapper (flat row-major → farr) ──────
fn phi_native(values: array, n_cells: int, n_bins: int) -> float {
    let total_len = len(values)
    if n_cells <= 0 { return 0.0 }
    if total_len <= 0 { return 0.0 }
    if total_len % n_cells != 0 {
        panic("phi_native: len(values) must be divisible by n_cells")
    }
    let dim = total_len / n_cells
    let st = farr_zeros(total_len)
    let mut i = 0
    while i < total_len {
        let _ = farr_set(st, i, values[i])
        i = i + 1
    }
    let phi = phi_spatial_native(st, n_cells, dim, n_bins)
    let _ = farr_free(st)
    return phi
}
