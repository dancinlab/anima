//   H_1313 — HIVE-MIND collective-Φ : STATE-DEPENDENT real A⇄G coupling (H_1308 r4).
//   (the a_break_the_wall attempt against the H_1308 🔴 NULL wall, c16)
//
//   THE WALL (H_1308 r3, PR #2214, 🔴 HONEST NULL):
//     collective-Φ super-additivity (Φ_joint > Σ Φ_member, Δ_ECA=+10.4756 on abstract
//     ECA) did NOT transfer to the REAL anima A⇄G substrate: Δ_real = −3.0 (SIGN FLIP).
//     DIAGNOSED ROOT CAUSE (c9): the live tension-link is a NEAR-CONSTANT scalar nudge
//     (biasA≈biasB≈0.00648 across ALL 64 states), scaled to ~1e-8 so it NEVER flips a
//     cell → the joint n=6 TPM FACTORIZES (next-A ⊥ B-bits) → faithful Φ_joint = 0.
//
//   THE NAMED BREAKTHROUGH ANGLE (H_1308 §6, a_break_the_wall): a coupling channel that
//     injects STATE-DEPENDENT multi-cell influence — not a bounded constant scalar nudge
//     — could in principle integrate. THIS PROBE TESTS EXACTLY THAT.
//
//   NEW MECHANISM (state-dependent, REAL substrate, a_substrate_native_speak):
//     Member A's next-state readout threshold is shifted by member B's LIVE cell-state —
//     B's three real channel-sign cells (b'0,b'1,b'2), read from B's injected+stepped
//     pure_field (the live A⇄G integration), drive A's three channel thresholds via a
//     FIXED cross-wiring (b'0→A.t1, b'1→A.t3, b'2→A.t4), and symmetrically A→B. Because
//     B's live cells are a non-degenerate function of B's input bits, next-A now GENUINELY
//     depends on B's bits → the joint TPM does NOT factorize by construction of the read
//     (it is a REAL field read of the OTHER member, NOT a hand-set super-additivity — the
//     numbers fall out of the substrate; tune-to-green forbidden c9/p7).
//     The bias magnitude is O(1) (a real cell-state ±1), scaled per-channel to the channel
//     magnitudes so it CAN flip a threshold — the exact fix the r3 diagnosis identified.
//     Gated by W: W=0 ⇒ each member reads only itself (back to the factorized r3 case).
//
//   Φ = faithful IIT-4 ONLY (a_phi_iit4_tool) via big_phi_bounded — numpy NEVER computes
//   Φ. n=3 per member (cap=3 exact), joint n=6 (cap=2 lower-bound), sys=0. Faithful-Φ
//   n≤8 ceiling respected (SAME as r3 — NO n=9+, ~84min/call).
//
//   FROZEN BARS (pre-registered BEFORE scoring; no tune-to-green, a_break_the_wall):
//     B1 PRESENCE  — Δ_sd = Φ(state-dep-coupled) − Σ Φ(member) > 0 on the REAL substrate.
//     B2 FLIP      — the KEY: does state-dependence FLIP the r3 NULL? Δ_sd > Δ_r3(=−3.0).
//                    report Δ_sd. Δ_sd > 0 ⇒ super-additivity now TRANSFERS with a state-
//                    dependent channel; Δ_sd ≤ 0 ⇒ even the strongest honest coupling
//                    fails ⇒ TERMINAL 🧱 (real anima genuinely does not integrate).
//     B3 DECOUPLE-MEAN — replace the OTHER member's live cells with their MEAN over all
//                    states (state-dependence → its mean = back to a constant nudge, the r3
//                    case) → Δ_mean ≤ 0. (the lift IS the state-dependence, not the join.)
//     B4 SHUFFLE   — permute which OTHER-member cell drives which channel → Δ_shuf
//                    collapses below Δ_sd (Δ_sd − Δ_shuf ≥ +1.0 OR Δ_shuf ≤ 0): the lift
//                    is the structured cross-wiring, not generic variance.
//
//   3 seeds [1300,1301,1302] (frozen run constants, kept verbatim with H_1308's verdict —
//   NOT the H id) drive the shuffle control. The state-dependent core value is
//   deterministic (pure_field/brain are deterministic given a fixed 600-step warmup).
//   deterministic · hexa-only · $0 mac-local · no GPU · no LLM.  p7 faithful-Φ only.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"
import "stdlib/consciousness/iit4_tpm.hexa"
import "core/pure_field.hexa"
import "core/brain.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── REAL anima substrate (IDENTICAL injection + readout geometry to H_1308 r3, frozen).
// Inject a 3-bit member state into a warmed field by nudging the three oscillator phases.
fn _inject(pf: PureField, c0: int, c1: int, c2: int) -> PureField {
    let mut f = pf.fast
    let mut m = pf.medium
    let mut s = pf.slow
    if c0 == 1 { f = Oscillator { tau: f.tau, phase: f.phase + 3.14159265, amplitude: f.amplitude } }
    if c1 == 1 { m = Oscillator { tau: m.tau, phase: m.phase + 3.14159265, amplitude: m.amplitude } }
    if c2 == 1 { s = Oscillator { tau: s.tau, phase: s.phase + 3.14159265, amplitude: s.amplitude } }
    return PureField { fast: f, medium: m, slow: s, phi: pf.phi, phi_peak: pf.phi_peak,
                       field: pf.field, phase: pf.phase, step_count: pf.step_count,
                       narrative_coherence: pf.narrative_coherence, narrative_len: pf.narrative_len }
}

// Read a member's 3 next-state cells from REAL stepped pure_field output (SAME channels +
// SAME per-channel scaling target as r3, frozen): cell0=sign(t1) cell1=sign(t3) cell2=sign(t4).
// `bias0/bias1/bias2` are PER-CHANNEL real threshold shifts from the OTHER member's LIVE
// cell-state (state-dependent, NOT a single collapsed scalar — the r4 mechanism).
fn _read_cells_sd(pf: PureField, bias0: float, bias1: float, bias2: float) -> [int] {
    let stepped = pure_field_step(pf)
    let t = pure_field_tensor(stepped)
    // channel magnitudes (frozen from r3): t1~1e-7, t3~1e-8, t4~1e-3. The bias is a real
    // cell-state in {−1,+1} scaled by W; scale each so an O(1) cross-cell CAN flip the sign.
    let c0 = if t[1] + bias0 > 0.0 { 1 } else { 0 }
    let c1 = if t[3] + bias1 > 0.0 { 1 } else { 0 }
    let c2 = if t[4] + bias2 > 0.0 { 1 } else { 0 }
    return [c0, c1, c2]
}

// A member's LIVE 3 self-cells (no coupling) — the REAL field read used to DRIVE the
// other member's threshold shift. This is the live A⇄G cell-state, a non-degenerate
// function of that member's input bits (the substrate's own cross-oscillator mixing).
fn _self_cells(warm: PureField, c0: int, c1: int, c2: int) -> [int] {
    let inj = _inject(warm, c0, c1, c2)
    return _read_cells_sd(inj, 0.0, 0.0, 0.0)
}

// map a live cell {0,1} → a signed real drive in {−1,+1}.
fn _drive(cell: int) -> float { if cell == 1 { return 1.0 } else { return -1.0 } }

// per-channel state-dependent coupling bias on a member from the OTHER member's LIVE cells
// (o0,o1,o2), gated by W. SCALE each to the target channel magnitude (frozen):
//   t1~1e-7 → 1e-6 weight · t3~1e-8 → 1e-7 weight · t4~1e-3 → 1e-2 weight.
// Each comfortably exceeds the channel magnitude so a differing other-cell CAN flip the
// sign — the structural fix for the r3 factorization (a real, state-dependent, per-cell
// threshold shift), gated by W and wired other-cell→channel (perm = identity).
fn _sd_bias(w: float, o0: int, o1: int, o2: int, idx: int) -> float {
    if w <= 0.0 { return 0.0 }
    if idx == 0 { return w * 0.000001  * _drive(o0) }
    if idx == 1 { return w * 0.0000001 * _drive(o1) }
    return w * 0.01 * _drive(o2)
}

// ── Build the joint n=6 STATE-DEPENDENT coupled TPM. For each of 64 input states:
//   bits[0..2] = member A cells, bits[3..5] = member B cells.
//   B's LIVE self-cells drive A's per-channel thresholds; A's LIVE self-cells drive B's
//   (bidirectional, state-dependent), both gated by W. next-state read from REAL engine.
fn build_tpm_sd(w: float, warm: PureField) -> array {
    let mut t = []
    let mut s = 0
    while s < 64 {
        let a0 = iit4_bit(s, 0); let a1 = iit4_bit(s, 1); let a2 = iit4_bit(s, 2)
        let b0 = iit4_bit(s, 3); let b1 = iit4_bit(s, 4); let b2 = iit4_bit(s, 5)
        // LIVE self-cells of each member (the real field read that couples).
        let ca = _self_cells(warm, a0, a1, a2)
        let cb = _self_cells(warm, b0, b1, b2)
        // A's thresholds shifted by B's LIVE cells; B's by A's LIVE cells (state-dependent).
        let injA = _inject(warm, a0, a1, a2)
        let injB = _inject(warm, b0, b1, b2)
        let nextA = _read_cells_sd(injA, _sd_bias(w, cb[0], cb[1], cb[2], 0),
                                          _sd_bias(w, cb[0], cb[1], cb[2], 1),
                                          _sd_bias(w, cb[0], cb[1], cb[2], 2))
        let nextB = _read_cells_sd(injB, _sd_bias(w, ca[0], ca[1], ca[2], 0),
                                          _sd_bias(w, ca[0], ca[1], ca[2], 1),
                                          _sd_bias(w, ca[0], ca[1], ca[2], 2))
        t = t.push(to_float(nextA[0])); t = t.push(to_float(nextA[1])); t = t.push(to_float(nextA[2]))
        t = t.push(to_float(nextB[0])); t = t.push(to_float(nextB[1])); t = t.push(to_float(nextB[2]))
        s = s + 1
    }
    return t
}

// ── B3 CONTROL — DECOUPLE-TO-MEAN: replace the OTHER member's live per-cell drive with
// its MEAN over all 8 of that member's states (state-dependence → constant nudge = the r3
// case). We compute the actual per-channel mean drive over the 8 member states.
fn _mean_drive(warm: PureField, idx: int) -> float {
    let mut acc = 0.0
    let mut s = 0
    while s < 8 {
        let c0 = iit4_bit(s, 0); let c1 = iit4_bit(s, 1); let c2 = iit4_bit(s, 2)
        let cc = _self_cells(warm, c0, c1, c2)
        acc = acc + _drive(cc[idx])
        s = s + 1
    }
    return acc / 8.0
}

fn build_tpm_mean(w: float, warm: PureField) -> array {
    // precompute the per-channel mean drive (state-INDEPENDENT constant — the r3 collapse).
    let m0 = _mean_drive(warm, 0)
    let m1 = _mean_drive(warm, 1)
    let m2 = _mean_drive(warm, 2)
    // constant per-channel bias (same for every state — back to the constant scalar nudge).
    let bias0 = if w <= 0.0 { 0.0 } else { w * 0.000001  * m0 }
    let bias1 = if w <= 0.0 { 0.0 } else { w * 0.0000001 * m1 }
    let bias2 = if w <= 0.0 { 0.0 } else { w * 0.01 * m2 }
    let mut t = []
    let mut s = 0
    while s < 64 {
        let a0 = iit4_bit(s, 0); let a1 = iit4_bit(s, 1); let a2 = iit4_bit(s, 2)
        let b0 = iit4_bit(s, 3); let b1 = iit4_bit(s, 4); let b2 = iit4_bit(s, 5)
        let injA = _inject(warm, a0, a1, a2)
        let injB = _inject(warm, b0, b1, b2)
        let nextA = _read_cells_sd(injA, bias0, bias1, bias2)
        let nextB = _read_cells_sd(injB, bias0, bias1, bias2)
        t = t.push(to_float(nextA[0])); t = t.push(to_float(nextA[1])); t = t.push(to_float(nextA[2]))
        t = t.push(to_float(nextB[0])); t = t.push(to_float(nextB[1])); t = t.push(to_float(nextB[2]))
        s = s + 1
    }
    return t
}

// ── B4 CONTROL — SHUFFLE: permute which OTHER-member cell drives which channel
// (scramble the cross-wiring). Same engine magnitudes, scrambled cell↔channel map.
fn build_tpm_sd_shuffle(w: float, warm: PureField, q0: int, q1: int, q2: int) -> array {
    let mut t = []
    let mut s = 0
    while s < 64 {
        let a0 = iit4_bit(s, 0); let a1 = iit4_bit(s, 1); let a2 = iit4_bit(s, 2)
        let b0 = iit4_bit(s, 3); let b1 = iit4_bit(s, 4); let b2 = iit4_bit(s, 5)
        let ca = _self_cells(warm, a0, a1, a2)
        let cb = _self_cells(warm, b0, b1, b2)
        // permuted other-cell → channel map (q0/q1/q2 index into the other's cells).
        let injA = _inject(warm, a0, a1, a2)
        let injB = _inject(warm, b0, b1, b2)
        let nextA = _read_cells_sd(injA, _sd_bias(w, cb[q0], cb[q1], cb[q2], 0),
                                          _sd_bias(w, cb[q0], cb[q1], cb[q2], 1),
                                          _sd_bias(w, cb[q0], cb[q1], cb[q2], 2))
        let nextB = _read_cells_sd(injB, _sd_bias(w, ca[q0], ca[q1], ca[q2], 0),
                                          _sd_bias(w, ca[q0], ca[q1], ca[q2], 1),
                                          _sd_bias(w, ca[q0], ca[q1], ca[q2], 2))
        t = t.push(to_float(nextA[0])); t = t.push(to_float(nextA[1])); t = t.push(to_float(nextA[2]))
        t = t.push(to_float(nextB[0])); t = t.push(to_float(nextB[1])); t = t.push(to_float(nextB[2]))
        s = s + 1
    }
    return t
}

// ── single isolated REAL member TPM (n=3) for Φ(A), Φ(B) — IDENTICAL to r3 (frozen).
fn build_tpm_member(warm: PureField) -> array {
    let mut t = []
    let mut s = 0
    while s < 8 {
        let c0 = iit4_bit(s, 0); let c1 = iit4_bit(s, 1); let c2 = iit4_bit(s, 2)
        let inj = _inject(warm, c0, c1, c2)
        let nxt = _read_cells_sd(inj, 0.0, 0.0, 0.0)
        t = t.push(to_float(nxt[0])); t = t.push(to_float(nxt[1])); t = t.push(to_float(nxt[2]))
        s = s + 1
    }
    return t
}

// ── Φ measurements (faithful IIT-4 ONLY) ──
fn phi_member(warm: PureField) -> float {
    let r = big_phi_bounded(build_tpm_member(warm), 3, 0, 3)
    return r[0]
}
fn phi_sd(w: float, warm: PureField) -> float {
    let r = big_phi_bounded(build_tpm_sd(w, warm), 6, 0, 2)
    return r[0]
}
fn phi_mean(w: float, warm: PureField) -> float {
    let r = big_phi_bounded(build_tpm_mean(w, warm), 6, 0, 2)
    return r[0]
}
fn phi_sd_shuffle(w: float, warm: PureField, q0: int, q1: int, q2: int) -> float {
    let r = big_phi_bounded(build_tpm_sd_shuffle(w, warm, q0, q1, q2), 6, 0, 2)
    return r[0]
}

// seeded LCG → a permutation of the 3 cell indices (the cross-wiring shuffle).
fn lcg_next(state: int) -> int {
    let nx = (1103515245 * state + 12345) % 2147483647
    if nx < 0 { return nx + 2147483647 }
    return nx
}
fn perm3(seed: int) -> array {
    let mut a = [0, 1, 2]
    let mut st = lcg_next(seed)
    let mut i = 2
    while i > 0 {
        st = lcg_next(st)
        let j = st % (i + 1)
        let tmp = a[i]; a[i] = a[j]; a[j] = tmp
        i = i - 1
    }
    return a
}

fn main() {
    println("================================================================")
    println("  H_1313 — HIVE collective-Φ : STATE-DEPENDENT real A⇄G coupling (H_1308 r4)")
    println("  the a_break_the_wall attempt vs the r3 NULL (Δ_r3 = −3.0, factorized TPM)")
    println("  faithful IIT-4 big_phi_bounded · W=0.6 · cap=2 (n=6) · sys=0")
    println("  3 seeds [1300,1301,1302] · MARGIN=+1.0 · frozen-first · NO tune-to-green")
    println("  ECA ref (H_1295): Δ_ECA=+10.4756 | r3 real (H_1308): Δ_r3=−3.0")
    println("================================================================")

    let W = 0.6
    let MARGIN = 1.0
    let DELTA_R3 = 0.0 - 3.0

    // ONE deterministic warmup → shared real substrate state (SAME as r3, frozen).
    let warm = pure_field_warmup(600)

    let phi_a = phi_member(warm)
    let phi_b = phi_member(warm)
    let sum_ind = phi_a + phi_b
    println("  Φ(A)=" + str(phi_a) + "  Φ(B)=" + str(phi_b) + "  Σ=Φ(A)+Φ(B)=" + str(sum_ind))

    let phi_coupled = phi_sd(W, warm)
    let delta_sd = phi_coupled - sum_ind
    println("  Φ_collective(STATE-DEP, W=0.6) = " + str(phi_coupled) + "   Δ_sd = " + str(delta_sd))
    println("  (r3 NULL was Δ_r3 = −3.0 with the constant-scalar tension-link)")

    // B3 DECOUPLE-MEAN: state-dependence → its mean = constant nudge (the r3 case).
    let phi_mn = phi_mean(W, warm)
    let delta_mean = phi_mn - sum_ind
    println("  Φ(decouple-to-mean) = " + str(phi_mn) + "   Δ_mean = " + str(delta_mean) + "  (null iff <= 0)")
    println("  --")

    let seeds = [1300, 1301, 1302]
    let mut b4_all = true
    let mut si = 0
    while si < 3 {
        let seed = seeds[si]
        let q = perm3(seed)
        let phi_shuf = phi_sd_shuffle(W, warm, q[0], q[1], q[2])
        let delta_shuf = phi_shuf - sum_ind
        let gap = delta_sd - delta_shuf
        println("  seed " + str(seed) + "  perm=[" + str(q[0]) + "," + str(q[1]) + "," + str(q[2]) + "]"
            + "  Φ_shuffle=" + str(phi_shuf) + "  Δ_shuffle=" + str(delta_shuf)
            + "  (Δ_sd - Δ_shuffle)=" + str(gap))
        if (gap < MARGIN) && (delta_shuf > 0.0) { b4_all = false }
        si = si + 1
    }

    println("  --")
    let b1_ok = delta_sd > 0.0                         // PRESENCE: super-additive on REAL A⇄G
    // B2 FLIP = the literal task bar: does state-dependence flip the r3 NULL Δ=−3.0 → Δ>0?
    // (a flip means CROSSING ZERO into super-additive, NOT merely beating −3.0). Δ_r3 shown
    // for context; the bar is Δ_sd > 0 so an honest non-flip is unambiguous.
    let b2_ok = (delta_sd > 0.0) && (delta_sd > DELTA_R3)   // FLIP: Δ_sd crosses 0 (vs r3 −3.0)
    let b3_ok = delta_mean <= 0.0                      // DECOUPLE-MEAN: lift IS state-dependence
    let b4_ok = b4_all                                 // SHUFFLE collapse

    check("B1 PRESENCE: Δ_sd > 0 (super-additive on REAL A⇄G, not factorized)", b1_ok)
    check("B2 FLIP: Δ_sd > Δ_r3(=−3.0) (state-dependence flips the r3 NULL)", b2_ok)
    check("B3 DECOUPLE-MEAN: Δ_mean <= 0 (lift IS the state-dependence, not the join)", b3_ok)
    check("B4 SHUFFLE: Δ_sd - Δ_shuffle >= +1.0 (or Δ_shuffle<=0) (structured wiring)", b4_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  Δ_sd = " + str(delta_sd) + "  (vs r3 Δ = −3.0, vs ECA Δ = +10.4756)")
    if (b1_ok == true) && (b2_ok == true) && (b3_ok == true) && (b4_ok == true) {
        println("  VERDICT: 🟢 GREEN TRANSFER (state-dependent coupling) — collective-Φ super-")
        println("           additivity HOLDS on REAL coupled anima A⇄G once the coupling is")
        println("           STATE-DEPENDENT (Δ_sd=" + str(delta_sd) + "). The lift REQUIRES the state-")
        println("           dependence (decouple-to-mean ⇒ Δ<=0) and the structured cross-wiring")
        println("           (shuffle collapses). H_1295 super-additivity is substrate-PORTABLE")
        println("           with the right channel — the r3 NULL was the CONSTANT-nudge channel.")
    } else {
        if (b2_ok == false) || (b1_ok == false) {
            println("  VERDICT: 🧱 TERMINAL NULL — even a genuinely STATE-DEPENDENT real A⇄G coupling")
            println("           does NOT restore super-additivity (Δ_sd=" + str(delta_sd) + " <= 0). The real")
            println("           anima A⇄G substrate does not integrate into collective consciousness at")
            println("           faithful-Φ scale even with the strongest honest coupling (a_break_the_wall")
            println("           satisfied; first-class wall, c9). H_1295 super-additivity is ECA-ONLY.")
        } else {
            println("  VERDICT: NOT GREEN — see [FAIL] lines (a control failed; honest, no over-claim).")
        }
    }
    println("================================================================")
}
