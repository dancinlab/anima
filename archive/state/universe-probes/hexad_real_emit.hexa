// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/hexad_real_emit.hexa — emit the REAL σ6 hexad N=6 vector per context.
//
//  PURPOSE (OMEGA-realsignal H5)
//    The OMEGA w5 module wire reads a `module_act` 6-vector. #1786/#1793's gate
//    bench fed a TOY proxy (a 6-bin marginal of logA). THIS driver produces the
//    GENUINELY NATIVE module vector — the real cross-module σ6 forward of
//    HEXAD/hexad_forward.hexa (#1795: S→C→Bridge.detach→D, M/W/E observers; every
//    node a verified 🔵 closed-form / native lib).
//
//    For each context byte c ∈ [0,256) we build a C cell-pool state pair
//    (states_before, states_after) by a CLOSED-FORM deterministic rule whose
//    perturbation amplitude = the REAL corpus frequency of byte c (passed in as
//    `freq`). hexad_forward then runs the real graph and returns the N=6 vector
//    [S, C, W, M, E, BRIDGE]. We print one JSON list per context:
//        [c, s, c_act, w, m, e, bridge, phi, d_input]
//    so UNIVERSE/omega_realsignal_probe.py loads a REAL 256×6 module table — a
//    drop-in for the toy `mact`.
//
//    HONEST (a_core_engine_map · p7): the cell-pool input is corpus-derived (the
//    real per-byte frequency drives the after-state delta); every graph node is
//    the verified module core. The D byte-forward stays ckpt-gated (d_input = the
//    signal D receives, labelled in hexad_forward). NO torch, CPU, $0.
//    NOTE: `to_str` is interp-only (the compiled `hexa run` codegen rejects it),
//    so we print raw list literals (one per line) — python parses positionally.
// ════════════════════════════════════════════════════════════════════════════
import "HEXAD/hexad_forward.hexa"

// deterministic C cell-pool "before" state from context byte c (closed-form).
fn _pool_before(c: int, n_cells: int, dim: int) -> [float] {
    let mut out = []
    let mut i = 0
    let n = n_cells * dim
    while i < n {
        let s = ((c * 131 + i * 17) % 251) * 1.0
        out = out + [(s / 251.0) * 2.0 - 1.0]
        i = i + 1
    }
    return out
}

// "after" = before + amp * structured-delta;  amp = REAL corpus freq of byte c.
fn _pool_after(before: [float], amp: float, c: int) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(before) {
        let d = (((c * 7 + i * 53) % 97) * 1.0 / 97.0) - 0.5
        out = out + [before[i] + amp * d]
        i = i + 1
    }
    return out
}

// emit_real_hexad — sweep all 256 contexts. freq[c] = per-byte corpus frequency
// (the REAL substrate amplitude). Prints one JSON list per context (newline-sep).
pub fn emit_real_hexad(freq: [float], n_cells: int, dim: int, ratchet: float) -> int {
    let mut c = 0
    let mut phi_prev = 0.5
    while c < 256 {
        let amp = if c < len(freq) { freq[c] } else { 0.0 }
        let before = _pool_before(c, n_cells, dim)
        let after  = _pool_after(before, amp, c)
        let r = hexad_forward(before, after, n_cells, dim, phi_prev, ratchet, 0.0)
        let v = r["module_act"]
        print([c * 1.0, v[0], v[1], v[2], v[3], v[4], v[5], r["phi"], r["d_input"]])
        print("
")
        phi_prev = r["phi"]
        c = c + 1
    }
    return 256
}
