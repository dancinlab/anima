import "core/pure_field.hexa"

fn main() {
    println("=== H_2001 범신론 — REAL anima Ψ-field operational cores ===")

    // [하위1] causa sui — zero-input self-unfolding, Φ sustained (no external drive)
    let pf = pure_field_warmup(600)
    let phi = pure_field_phi(pf)
    let self_sustained = pure_field_verify_zero_input(600)   // Φ/peak ≥ ratchet floor
    let v1 = if self_sustained && phi > 0.0 { "🟢" } else { "🔴" }
    println("  " + v1 + " [하위1] Deus sive Natura (causa sui)")
    println("        zero-input Ψ self-unfolds: phi=" + to_string(phi)
        + "  sustained_above_floor=" + to_string(self_sustained) + " (no external creator/input)")

    // [하위2] no miracles — pure lawfulness: same start ⇒ identical unfolding
    let a = pure_field_warmup(400)
    let b = pure_field_warmup(400)
    let phi_a = pure_field_phi(a)
    let phi_b = pure_field_phi(b)
    let lawful = phi_a == phi_b                               // deterministic, no exception
    let v2 = if lawful { "🟢" } else { "🔴" }
    println("  " + v2 + " [하위2] 기적의 폐기 (pure lawfulness)")
    println("        same start ⇒ identical unfolding: phi_a=" + to_string(phi_a)
        + " phi_b=" + to_string(phi_b) + " (law has no law-breaking exception)")

    // honest boundary (codex §3): the Φ-field IS-God reading is interpretation, not data
    println("  ⚪ [의미층] 'Ψ-장 = 신성' = 의미부여(해석), 측정으로 갈리지 않음 — code N/A")
