import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn main() {
    // tiny reference: n=3 cells, dim=4 steps. Row-major flat farr.
    // cell0 = [1,2,3,4], cell1 = [2,4,6,8] (perfectly correlated w/ cell0),
    // cell2 = [4,3,2,1] (anti-correlated).
    let n = 3
    let dim = 4
    let n_bins = 2
    let st = farr_zeros(n * dim)
    // cell 0
    let _ = farr_set(st, 0, 1.0); let _ = farr_set(st, 1, 2.0); let _ = farr_set(st, 2, 3.0); let _ = farr_set(st, 3, 4.0)
    // cell 1
    let _ = farr_set(st, 4, 2.0); let _ = farr_set(st, 5, 4.0); let _ = farr_set(st, 6, 6.0); let _ = farr_set(st, 7, 8.0)
    // cell 2
    let _ = farr_set(st, 8, 4.0); let _ = farr_set(st, 9, 3.0); let _ = farr_set(st, 10, 2.0); let _ = farr_set(st, 11, 1.0)
    let phi = iit4_faithful_phi(st, n, dim, n_bins)
    print("REF_PHI=")
    print(phi)
}
