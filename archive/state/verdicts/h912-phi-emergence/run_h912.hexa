// UNIVERSE/state/h912_phi_emergence_correlate_2026_06_02/run_h912.hexa
//
//   H_912 — "higher consciousness → higher emergence" (graded) + Hc_912 (existence)
//
//   QUESTION
//     Does a system's CONSCIOUSNESS measure (canonical phi_proxy Φ, the
//     variance-partition integration `global_var − part_var` exposed at runtime
//     as `phi_spatial`, RFC 036) positively correlate with an INDEPENDENT
//     EMERGENCE measure across a population of dynamical systems?
//
//     H  (graded)    : Φ_proxy ↑  ⇒  emergence ↑   (positive correlation)
//     Hc (existence) : Φ_proxy > 0 ⇒ emergence > 0   (nonzero Φ ⇒ measurable structure)
//
//   POPULATION (low→high Φ span)
//     A panel of elementary cellular automata (ECA) rules — the canonical in-repo
//     substrate that spans Wolfram classes I (homogeneous, low Φ) → IV (complex,
//     high Φ). Same 10-rule panel as H_287/H_288 for cross-comparability, here
//     re-measured with the *canonical proxy* Φ (phi_spatial) rather than faithful
//     causal big-Φ — so this directly tests whether the CHEAP proxy anima uses
//     carries the Φ↔emergence link.
//
//   AXES (pre-registered, BEFORE any measurement)
//     consciousness axis  Φ  = phi_spatial(traj, N, T, nbins) on the spacetime
//                              trajectory matrix (N cells × T steps). This IS the
//                              canonical phi_proxy = global_var − part_var
//                              integration (+ cross-coherence). NOT a new metric.
//     emergence axis      E  = normalised Lempel-Ziv (LZ76, Kaspar-Schuster 1976)
//                              complexity of the row-major binarised spacetime
//                              trace.  Standard "macroscopic dynamical complexity /
//                              algorithmic emergence" estimator (the PCI proxy,
//                              Casali et al. 2013; Lempel & Ziv 1976). Chosen
//                              because it is computed on a DIFFERENT REPRESENTATION
//                              (a symbol sequence) by a DIFFERENT OPERATION
//                              (dictionary parsing), so it is NOT definitionally Φ.
//
//   CIRCULARITY GUARD (g: Φ and E must not be the same quantity)
//     Φ  : variance partition + sign-coherence on real-valued binned activations
//          of the (N×T) trajectory matrix.
//     E  : count of distinct phrases in a left-to-right LZ parse of the flat
//          binary string. No variance, no partition, no coherence term.
//     ⇒ construction-independent. Verified empirically by the DISSOCIATION test
//       (a rule with E>0 but Φ≈0, or Φ>0 but E low) — if Φ and E moved in
//       lockstep with no dissociation AND r≈1.0, that would flag tautology.
//
//   TEST + NULL (paired-bootstrap honesty, same as clm_h911_scale)
//     observed  : Pearson r(Φ, E) + Spearman ρ over the panel.
//     NULL      : permutation control — shuffle the E labels against Φ K times
//                 (deterministic LCG), recompute r'; NULL collapses iff observed r
//                 lies in the upper tail (perm p-value < 0.05).
//     CI        : paired bootstrap (resample rules with replacement K times),
//                 report r 2.5/97.5 percentile CI.
//     VERDICT   : 🟢 SUPPORTED iff  CI_lo > 0  AND  perm-p < 0.05  AND no tautology.
//                 🔴 FALSIFIED iff  CI_lo <= 0  (link not separable from null).
//                 ⛔ OPEN-BLOCKED iff Φ≡E (r≈1.0 with zero dissociation = circular).
//
//   deterministic · hexa-only · LLM none · NO GPU · $0 mac-local.
// ════════════════════════════════════════════════════════════════════════════

fn _state_dir() -> string {
    return "/Users/mini/dancinlab/anima-universe-phi/UNIVERSE/state/h912_phi_emergence_correlate_2026_06_02"
}

fn _N() -> int     { return 16 }   // ring cells (population unit count)
fn _T() -> int     { return 64 }   // trajectory steps
fn _NBINS() -> int { return 4 }    // bins/cell for phi_spatial

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

fn nsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}
fn log2(x: float) -> float {
    if x < 0.000001 { return 0.0 }
    return log(x) / log(2.0)
}
fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

// ── ECA bit helpers (self-contained, no fragile import) ─────────────────────
fn bit_of(rule: int, idx: int) -> int {
    return (rule / ipow2(idx)) % 2
}
fn ipow2(k: int) -> int {
    let mut v = 1
    let mut i = 0
    while i < k { v = v * 2; i = i + 1 }
    return v
}

// next ECA row (Wolfram neighbourhood, periodic ring).
fn eca_next_row(rule: int, row: array, n: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let l = row[(i - 1 + n) % n]
        let c = row[i]
        let rr = row[(i + 1) % n]
        let idx = 4 * l + 2 * c + rr
        out = out.push(bit_of(rule, idx))
        i = i + 1
    }
    return out
}

// build the (N×T) spacetime as a flat binary array (row-major: step-major),
// seeded with a single 1 at the centre cell.
fn spacetime_bits(rule: int, n: int, t: int) -> array {
    let mut row = []
    let mut i = 0
    while i < n { row = row.push(0); i = i + 1 }
    row[n / 2] = 1
    let mut s = []
    let mut step = 0
    while step < t {
        let mut j = 0
        while j < n { s = s.push(row[j]); j = j + 1 }
        row = eca_next_row(rule, row, n)
        step = step + 1
    }
    return s
}

// ── CONSCIOUSNESS axis: canonical phi_proxy via phi_spatial builtin ─────────
// Build the trajectory matrix the way phi_spatial expects: N cells, each with a
// DIM=T length feature vector (the cell's value over T steps). This is the
// canonical proxy (global_var − part_var integration). float farr handle.
fn phi_proxy(rule: int) -> float {
    let n = _N()
    let t = _T()
    let bits = spacetime_bits(rule, n, t)        // step-major: bits[step*n + cell]
    let traj = farr_zeros(n * t)                 // cell-major: traj[cell*t + step]
    let mut step = 0
    while step < t {
        let mut cell = 0
        while cell < n {
            farr_set(traj, cell * t + step, to_float(bits[step * n + cell]))
            cell = cell + 1
        }
        step = step + 1
    }
    let phi = phi_spatial(traj, n, t, _NBINS())
    farr_free(traj)
    return phi
}

// ── EMERGENCE axis: normalised LZ76 of the binary spacetime trace ───────────
// Lempel-Ziv 1976 (Kaspar-Schuster parse), reused verbatim from H_288.
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}
fn emergence(rule: int) -> float {
    let n = _N()
    let t = _T()
    let s = spacetime_bits(rule, n, t)
    let len = n * t
    let c = lz76(s, len)
    return to_float(c) * log2(to_float(len)) / to_float(len)   // random → ~1
}

// ── stats ───────────────────────────────────────────────────────────────────
fn pearson(xs: array, ys: array, m: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < m { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(m)
    let my = sy / to_float(m)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    i = 0
    while i < m {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        i = i + 1
    }
    if (vx < 0.000000000001) || (vy < 0.000000000001) { return 0.0 }
    return cov / nsqrt(vx * vy)
}
fn rank_of(xs: array, m: int, idx: int) -> float {
    let mut less = 0.0
    let mut eq = 0.0
    let mut i = 0
    while i < m {
        if xs[i] < xs[idx] - 0.000000001 { less = less + 1.0 }
        if approx(xs[i], xs[idx]) { eq = eq + 1.0 }
        i = i + 1
    }
    return less + (eq - 1.0) / 2.0
}
fn spearman(xs: array, ys: array, m: int) -> float {
    let mut rx = []
    let mut ry = []
    let mut i = 0
    while i < m { rx = rx.push(rank_of(xs, m, i)); ry = ry.push(rank_of(ys, m, i)); i = i + 1 }
    return pearson(rx, ry, m)
}

// deterministic LCG (same family as mvp_randn) → int in [0, mod)
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

// percentile of a sorted-by-selection-not-required array — simple O(K^2) is fine for K~2000.
fn percentile(vals: array, k: int, q: float) -> float {
    // copy + insertion-sort
    let mut a = []
    let mut i = 0
    while i < k { a = a.push(vals[i]); i = i + 1 }
    let mut p = 1
    while p < k {
        let key = a[p]
        let mut j = p - 1
        while j >= 0 && a[j] > key { a[j + 1] = a[j]; j = j - 1 }
        a[j + 1] = key
        p = p + 1
    }
    let mut pos = q * to_float(k - 1)
    if pos < 0.0 { pos = 0.0 }
    let lo = to_int(pos)
    let mut hi = lo + 1
    if hi > k - 1 { hi = k - 1 }
    let frac = pos - to_float(lo)
    return a[lo] * (1.0 - frac) + a[hi] * frac
}

fn main() {
    println("================================================================")
    println("  H_912 — Φ_proxy (consciousness) vs LZ76 (emergence) — graded + existence")
    println("  population = ECA panel · N=" + to_string(_N()) + " T=" + to_string(_T())
            + " nbins=" + to_string(_NBINS()) + " · Φ=phi_spatial(canonical proxy) · E=LZ76_norm")
    println("  deterministic · LLM none · $0 mac-local")
    println("================================================================")

    // same panel as H_287/288 (class I floor → class IV ceiling), cross-comparable
    let rules = [0, 255, 204, 51, 150, 105, 90, 60, 110, 30]
    let m = 10
    let mut ps = []     // Φ_proxy
    let mut es = []     // emergence (LZ_norm)
    let mut idx = 0
    while idx < m {
        let rule = rules[idx]
        let p = phi_proxy(rule)
        let e = emergence(rule)
        ps = ps.push(p)
        es = es.push(e)
        println("  rule " + to_string(rule) + " : Phi_proxy=" + to_string(p) + "   E_LZ=" + to_string(e))
        idx = idx + 1
    }

    let r_obs = pearson(ps, es, m)
    let rho_obs = spearman(ps, es, m)
    println("  --")
    println("  observed Pearson r(Phi, E)=" + to_string(r_obs) + "   Spearman rho=" + to_string(rho_obs))

    // ── NULL: permutation test (shuffle E labels vs Phi) ─────────────────────
    let K = 2000
    let mut seed = 1234567
    let mut perm_ge = 0          // # permutations with r' >= r_obs
    let mut perm_rs = []
    let mut kk = 0
    while kk < K {
        // Fisher-Yates shuffle of an index array using LCG
        let mut perm = []
        let mut a = 0
        while a < m { perm = perm.push(a); a = a + 1 }
        let mut b = m - 1
        while b > 0 {
            seed = lcg_next(seed)
            let j = seed % (b + 1)
            let tmp = perm[b]; perm[b] = perm[j]; perm[j] = tmp
            b = b - 1
        }
        let mut es_perm = []
        let mut c = 0
        while c < m { es_perm = es_perm.push(es[perm[c]]); c = c + 1 }
        let rp = pearson(ps, es_perm, m)
        perm_rs = perm_rs.push(rp)
        if rp >= r_obs { perm_ge = perm_ge + 1 }
        kk = kk + 1
    }
    let perm_p = to_float(perm_ge + 1) / to_float(K + 1)   // +1 smoothing (one-sided)
    let null_mean_abs_lo = percentile(perm_rs, K, 0.025)
    let null_mean_abs_hi = percentile(perm_rs, K, 0.975)
    println("  NULL(permutation K=" + to_string(K) + ") one-sided p=" + to_string(perm_p)
            + "   null r 95% band=[" + to_string(null_mean_abs_lo) + ", " + to_string(null_mean_abs_hi) + "]")

    // ── paired bootstrap CI on r ─────────────────────────────────────────────
    let mut boot_rs = []
    let mut bb = 0
    while bb < K {
        let mut bx = []
        let mut by = []
        let mut c = 0
        while c < m {
            seed = lcg_next(seed)
            let j = seed % m
            bx = bx.push(ps[j])
            by = by.push(es[j])
            c = c + 1
        }
        boot_rs = boot_rs.push(pearson(bx, by, m))
        bb = bb + 1
    }
    let ci_lo = percentile(boot_rs, K, 0.025)
    let ci_hi = percentile(boot_rs, K, 0.975)
    println("  bootstrap r 95% CI = [" + to_string(ci_lo) + ", " + to_string(ci_hi) + "]")

    // ── circularity / tautology guard ────────────────────────────────────────
    // dissociation: at least one rule where Phi and E rank-disagree strongly.
    // rule 90 (idx 6) is the canonical sync-death rule — high LZ, low integration.
    let phi90 = ps[6]
    let e90 = es[6]
    let phi0 = ps[0]    // rule 0 constant: both should floor
    let e0 = es[0]
    // tautology iff r >= 0.999 (Phi==E up to monotone) AND no dissociation witness.
    let dissociation = !(approx(phi90, phi0) && approx(e90, e0))   // 90 differs from constant floor on >=1 axis
    let tautology = (r_obs >= 0.999) && (!dissociation)
    println("  circularity: rule90 Phi=" + to_string(phi90) + " E=" + to_string(e90)
            + " ; rule0 Phi=" + to_string(phi0) + " E=" + to_string(e0)
            + " ; dissociation=" + _bool_str(dissociation) + " tautology=" + _bool_str(tautology))

    // ── existence framing (Hc_912): nonzero Phi ⇒ nonzero emergence ──────────
    // count rules with Phi>eps; among those, fraction with E>eps.
    let eps = 0.05
    let mut n_phi_pos = 0
    let mut n_phi_pos_and_e_pos = 0
    let mut q = 0
    while q < m {
        if ps[q] > eps {
            n_phi_pos = n_phi_pos + 1
            if es[q] > eps { n_phi_pos_and_e_pos = n_phi_pos_and_e_pos + 1 }
        }
        q = q + 1
    }
    let existence_ok = n_phi_pos > 0 && n_phi_pos == n_phi_pos_and_e_pos
    println("  existence(Hc_912): #Phi>eps=" + to_string(n_phi_pos)
            + "  #(Phi>eps & E>eps)=" + to_string(n_phi_pos_and_e_pos)
            + "  implication_holds=" + _bool_str(existence_ok))

    // ── pre-registered falsifiers ────────────────────────────────────────────
    // F912.1 POSITIVE:    r_obs > 0  (graded direction correct)
    // F912.2 CI:          bootstrap CI_lo > 0  (link separable from 0)
    // F912.3 NULL:        permutation p < 0.05  (NULL collapses)
    // F912.4 NOT-CIRCULAR:tautology == false  (Phi !≡ E)
    // F912.5 EXISTENCE:   Hc_912 implication holds (Phi>eps ⇒ E>eps)
    // F912.6 BOUND:       all Phi>=0 and E>=0
    let f1 = r_obs > 0.0
    let f2 = ci_lo > 0.0
    let f3 = perm_p < 0.05
    let f4 = !tautology
    let f5 = existence_ok
    let mut bound_ok = true
    let mut z = 0
    while z < m {
        if ps[z] < 0.0 - 0.000001 { bound_ok = false }
        if es[z] < 0.0 - 0.000001 { bound_ok = false }
        z = z + 1
    }
    let f6 = bound_ok

    let n_pass = (if f1 {1} else {0}) + (if f2 {1} else {0}) + (if f3 {1} else {0})
               + (if f4 {1} else {0}) + (if f5 {1} else {0}) + (if f6 {1} else {0})

    // verdict gate:
    //   🟢 SUPPORTED  iff CI_lo>0 AND perm-p<0.05 AND not-circular (F1∧F2∧F3∧F4)
    //   ⛔ OPEN-BLOCKED iff tautology (F4 FAIL with r≈1) — circular, not evidence
    //   🔴 FALSIFIED  iff CI_lo<=0 (link not separable from null)
    let mut verdict = "PARTIAL"
    if tautology { verdict = "OPEN-BLOCKED-CIRCULAR" }
    else {
        if f1 && f2 && f3 && f4 { verdict = "SUPPORTED-NUMERICAL" }
        else {
            if !f2 { verdict = "FALSIFIED" }
        }
    }

    println("================================================================")
    println("  [" + _verdict(f1) + "] F912.1 POSITIVE: r_obs > 0")
    println("  [" + _verdict(f2) + "] F912.2 CI: bootstrap CI_lo > 0")
    println("  [" + _verdict(f3) + "] F912.3 NULL: permutation p < 0.05")
    println("  [" + _verdict(f4) + "] F912.4 NOT-CIRCULAR: Phi not identical to E")
    println("  [" + _verdict(f5) + "] F912.5 EXISTENCE (Hc_912): Phi>eps => E>eps")
    println("  [" + _verdict(f6) + "] F912.6 BOUND: all Phi>=0 and E>=0")
    println("  F912.1-6 " + to_string(n_pass) + "/6 PASS")
    println("  VERDICT: " + verdict)

    // ── write result.json ────────────────────────────────────────────────────
    let mut o = "{\n"
    o = o + "  \"id\": \"H_912\",\n"
    o = o + "  \"slug\": \"phi-emergence-correlate\",\n"
    o = o + "  \"date\": \"2026-06-02\",\n"
    o = o + "  \"domain\": \"UNIVERSE\",\n"
    o = o + "  \"deterministic\": true,\n"
    o = o + "  \"llm\": \"none\",\n"
    o = o + "  \"cost\": \"$0 mac local\",\n"
    o = o + "  \"consciousness_axis\": \"canonical phi_proxy = phi_spatial(global_var - part_var integration), RFC 036\",\n"
    o = o + "  \"emergence_axis\": \"normalised Lempel-Ziv LZ76 (Kaspar-Schuster 1976 / PCI proxy Casali 2013) of binarised spacetime trace\",\n"
    o = o + "  \"population\": \"ECA rule panel [0,255,204,51,150,105,90,60,110,30] (Wolfram class I->IV)\",\n"
    o = o + "  \"config\": { \"N\": " + to_string(_N()) + ", \"T\": " + to_string(_T())
          + ", \"n_bins\": " + to_string(_NBINS()) + ", \"K_resample\": " + to_string(K) + " },\n"
    o = o + "  \"phi_proxy\": [";
    let mut w = 0
    while w < m { o = o + to_string(ps[w]); if w < m - 1 { o = o + ", " }; w = w + 1 }
    o = o + "],\n"
    o = o + "  \"emergence_lz\": [";
    w = 0
    while w < m { o = o + to_string(es[w]); if w < m - 1 { o = o + ", " }; w = w + 1 }
    o = o + "],\n"
    o = o + "  \"pearson_r\": " + to_string(r_obs) + ",\n"
    o = o + "  \"spearman_rho\": " + to_string(rho_obs) + ",\n"
    o = o + "  \"perm_p_onesided\": " + to_string(perm_p) + ",\n"
    o = o + "  \"null_r_95band\": [" + to_string(null_mean_abs_lo) + ", " + to_string(null_mean_abs_hi) + "],\n"
    o = o + "  \"bootstrap_r_95ci\": [" + to_string(ci_lo) + ", " + to_string(ci_hi) + "],\n"
    o = o + "  \"dissociation_witness\": " + _bool_str(dissociation) + ",\n"
    o = o + "  \"tautology\": " + _bool_str(tautology) + ",\n"
    o = o + "  \"existence_holds\": " + _bool_str(existence_ok) + ",\n"
    o = o + "  \"falsifiers\": {\n"
    o = o + "    \"F912_1_POSITIVE\":      \"" + _verdict(f1) + "\",\n"
    o = o + "    \"F912_2_CI_LO_POS\":     \"" + _verdict(f2) + "\",\n"
    o = o + "    \"F912_3_NULL_COLLAPSE\": \"" + _verdict(f3) + "\",\n"
    o = o + "    \"F912_4_NOT_CIRCULAR\":  \"" + _verdict(f4) + "\",\n"
    o = o + "    \"F912_5_EXISTENCE\":     \"" + _verdict(f5) + "\",\n"
    o = o + "    \"F912_6_BOUND\":         \"" + _verdict(f6) + "\"\n"
    o = o + "  },\n"
    o = o + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    o = o + "  \"verdict\": \"" + verdict + "\"\n"
    o = o + "}\n"
    write_file(_state_dir() + "/result.json", o)
    println("  result.json -> " + _state_dir() + "/result.json")
    println("=== H_912 complete: " + verdict + " (" + to_string(n_pass) + "/6) ===")
}
