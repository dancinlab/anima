fn pow2(e) {
  let mut r = 1
  let mut i = 0
  while i < e {
    r = r * 2
    i = i + 1
  }
  return r
}
fn step_of(input_bits, act_bits) {
  return pow2(input_bits - act_bits)
}
fn main() {
  let s4 = step_of(4, 4)
  let s2 = step_of(4, 2)
  let s1 = step_of(4, 1)
  print("step_ib4_ab4=" + to_string(s4))
  print("step_ib4_ab2=" + to_string(s2))
  print("step_ib4_ab1=" + to_string(s1))
  let pass = (s4 == 1) && (s2 == 4) && (s1 == 8)
  print("ENVELOPE_STEP_FORMULA_MATCH=" + to_string(pass))
}
