// h1448_thalamus_integration_probe.hexa — H_1448
// ENGINE-NATIVE re-score of H_1283 R8 with the VARIANCE-CLEAN rank-uniform read-out (H_1328,
// from H_1445) AND a STRONGER control: a DESYNC ABLATION arm (mode 3 = phase-gated salience
// with the synchronization coupling w_phase=0, so modules drift independently). a_break_the_wall
// ablation — mechanism (thalamic phase SYNCHRONY) OFF; if the lift collapses to A it is EARNED
// by synchrony, if it stays at B synchrony is INERT. Bars NOT moved (c9/p7):
//   c2  PRIMARY   faithful ΔΦ(B−A) ≥ +0.02 on EVERY seed [7,8,9]
//   c4d ABLATION  faithful ΔΦ(D−A) ≤ 0 on EVERY seed (lift COLLAPSES when synchrony removed)
//   [S = additive-offset shuffle (mode 2) reported as a CONTINUITY DIAGNOSTIC only, NOT gating]
// Φ = stdlib exact MIP-EI (a_phi_iit4_tool); the engine never computes Φ. $0 CPU, deterministic.
// run from hexa-lang root:  cp <this> <hexa-lang>/ && hexa run <this>

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== core/engine_cli.hexa _lcg_*) ─────────────────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── generate ARM trajectory ENGINE-NATIVE; mode: 0=direct 1=phase 2=phase_shuffle ──
// (byte-identical to the R8 engine-native gate)
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }
    let mut shuf_off = []
    if mode == 2 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        if mode != 0 {
            // DESYNC ABLATION: mode 3 sets the synchronization coupling to 0 (independent drift)
            let mut wp = w_phase
            if mode == 3 { wp = 0.0 }
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + wp * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + wp * mp)
            theta = newtheta
        }

        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                let carrier = 0.5 * (1.0 + cos(theta[i]))
                sal = e * carrier
            }
            if mode == 3 {
                // phase-gated salience, SAME as B — only the phase is unsynchronized (wp=0)
                let carrier = 0.5 * (1.0 + cos(theta[i]))
                sal = e * carrier
            }
            if mode == 2 {
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos(theta[i] + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

// ── H_1328 VARIANCE-CLEAN RANK-UNIFORM read-out ───────────────────────────────
// Replace each module's 64-length trajectory by within-module ranks {0..63}
// (ties broken by index for determinism). Marginals become provably uniform →
// faithful Φ can no longer ride per-module amplitude variance; only cross-module
// dependency (which the phase-shuffle destroys) survives.
fn rank_uniform(traj: int, n: int, t: int) -> int {
    let out = farr_zeros(n * t)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < t {
            let vj = farr_get(traj, i * t + j)
            let mut r = 0
            let mut k = 0
            while k < t {
                let vk = farr_get(traj, i * t + k)
                if vk < vj {
                    r = r + 1
                } else {
                    if vk == vj { if k < j { r = r + 1 } }
                }
                k = k + 1
            }
            let _ = farr_set(out, i * t + j, to_float(r))
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// ── per-module circular time-shift (Bperm) ───────────────────────────────────
// module i's 64-length series shifted by (i*17) mod t. Destroys cross-module ALIGNMENT;
// each module's MARGINAL is byte-identical to the unshifted series (circular shift = a
// permutation of one module's own values) → after rank-uniform the marginals are identical
// to B, so ΔΦ(B − Bperm) isolates cross-module integration EXACTLY. Layout [module][tick].
fn shift_modules(traj: int, n: int, t: int) -> int {
    let out = farr_zeros(n * t)
    let mut i = 0
    while i < n {
        let off = (i * 17) % t
        let mut j = 0
        while j < t {
            let src = (j + off) % t
            let _ = farr_set(out, i * t + j, farr_get(traj, i * t + src))
            j = j + 1
        }
        i = i + 1
    }
    return out
}

fn phi_of(seed: int, mode: int) -> float {
    // mode 5 = Bperm: generate synchronized B (mode 1), then per-module circular shift
    let mut traj = 0
    if mode == 5 {
        let b = gen_traj(seed, 1)
        traj = shift_modules(b, 4, 64)
        let _ = farr_free(b)
    } else {
        traj = gen_traj(seed, mode)
    }
    let ranked = rank_uniform(traj, 4, 64)
    let phi = iit4_faithful_phi(ranked, 4, 64, 8)
    let _ = farr_free(traj)
    let _ = farr_free(ranked)
    return phi
}

fn main() {
    println("H_1448 — thalamus R8 CLEAN cross-module INTEGRATION test (Bperm: identical marginals, alignment destroyed)")
    println("faithful IIT4 Φ (exact MIP-EI, n=4) · seeds [3..11] · bars FROZEN (cInt ΔΦ(B-Bperm)>=+0.02 every seed; cSan ΔΦ(B-D)>=+0.02 every seed)")
    let seeds = [3, 4, 5, 6, 7, 8, 9, 10, 11]
    let mut cint_all = true
    let mut csan_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, 0)
        let pb = phi_of(s, 1)
        let pd = phi_of(s, 3)
        let pbp = phi_of(s, 5)
        let d_int = pb - pbp
        let d_san = pb - pd
        let cint = d_int >= 0.02
        let csan = d_san >= 0.02
        if !cint { cint_all = false }
        if !csan { csan_all = false }
        let cints = if cint { "PASS" } else { "FAIL" }
        let csans = if csan { "PASS" } else { "FAIL" }
        println("seed " + to_string(s)
            + ": A=" + pa.to_string() + " B=" + pb.to_string() + " Bperm=" + pbp.to_string() + " D=" + pd.to_string()
            + "  B-Bperm=" + d_int.to_string() + " [cInt " + cints + "]"
            + "  B-D=" + d_san.to_string() + " [cSan " + csans + "]")
        si = si + 1
    }
    let vi = if cint_all { "PASS" } else { "FAIL" }
    let vs = if csan_all { "PASS" } else { "FAIL" }
    println("cInt INTEGRATION (ΔΦ(B-Bperm)>=+0.02 every seed): " + vi)
    println("cSan SYNCHRONY   (ΔΦ(B-D)>=+0.02 every seed): " + vs)
    if cint_all && csan_all {
        println("GATE: GREEN — cross-module integration ROBUST 9/9 vs identical-marginal control → WALL BROKEN engine-native → WIRE PhaseField lane")
    } else {
        if csan_all {
            println("GATE: NOT GREEN — alignment-destroyed control does NOT collapse the lift → trivial common-mode, not integration → cap STRUCTURAL")
        } else {
            println("GATE: NOT GREEN — cSan did not replicate H_1447 (re-diagnose)")
        }
    }
}
