// state/1570_lateral_gene_transfer/h1570_lateral_transfer_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1570 — LATERAL GENE TRANSFER mitosis (H_1310 wall-break lens 2)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  THE WALL (H_1310 🔴 / H_1568 🧱 / H_1569 🧱): pure-mitosis split-only learning hits a
//  local-expert ceiling. H_1568 (lens 1) pinned the bottleneck as REPRESENTATION not growth rule;
//  H_1569 (lens 3) showed a FIXED inherited representation lifts only +0.056 nats (under the bar)
//  because cells partition a fixed feature and each cell's learned value is OWN-points-only.
//
//  LENS 2 (lateral gene transfer): vertical descent (parent→daughter split) is the ONLY channel
//  pure mitosis has — there is NO horizontal sharing of what cells LEARN. Bacteria break local
//  optima via LATERAL gene transfer (horizontal transfer of acquired traits between peers, not
//  just parent→child). The missing structure: let cells SHARE their learned next-byte statistics
//  HORIZONTALLY — a cell's value distribution is enriched by its key-space NEIGHBORS' learned
//  values (a learned, EXPANDABLE representation that grows WITH the cells, exactly the angle H_1569
//  sharpened). A sparse single-cell value table (ownv points only) becomes a NEIGHBOR-POOLED one.
//
//  ENGINE-NATIVE (a_engine_native_learning HARD-GATE): the learner is the LIVE OsmoticStore
//  (core/engine_cli.hexa §Osmotic — VAdaptField _vnearest_idx/_l2 split geometry + engine_mitosis_tick
//  clonal growth under EngineConfig.mitosis + per-cell value table). Lateral transfer is a READ-only
//  post-pass over the engine's OWN cell population + key geometry (_l2 over st.field.protos): each
//  cell's TEST-time value = a distance-weighted blend of its OWN learned value and its k key-space
//  NEIGHBORS' learned values (the engine's ownv _l2 affinity). NO numpy/torch/.py mirror.
//
//  ARMS (corpus, contexts, keys, split mechanism, test set, CE metric ALL byte-identical; the ONLY
//  difference is whether learned values are SHARED laterally at test time):
//    • A_descent = vertical-only (no lateral transfer) — each cell predicts its OWN learned value.
//                  Reproduces the H_1569 A_repr arm (the inherited-repr ceiling).
//    • A_lateral = LATERAL transfer ON — each cell's predictive value = ownv + neighbor-pooled
//                  (k nearest cells by _l2, distance-weighted). The lens.
//    • A_ablate  = lateral OFF (beta_lat:=0) → byte-identical to A_descent (the ablation control).
//    • A_shuf    = lateral transfer over a SHUFFLED neighbor set (pool RANDOM cells, not key-space
//                  neighbors) — destroys the geometry the transfer rides (causal control).
//
//  METRIC (p7): held-out next-byte CROSS-ENTROPY (nats). Comparator: exact order-2 add-1 Markov floor.
//
//  FROZEN 5-BAR (frozen-first, BEFORE the run — c9, NO tune-to-green; 🟢 iff B1∧B2∧B3):
//   B1 BREAK    : CE_lateral < CE_descent − 0.10  (lateral transfer lifts mitosis below the
//                 vertical-only ceiling).
//   B2 ABLATION : CE_ablate == CE_descent (lateral OFF is byte-identical to vertical-only —
//                 the mechanism is the transfer, not a code-path artifact).
//   B3 CAUSAL   : CE_shuf >= CE_lateral + 0.05 (random-neighbor transfer is WORSE than key-space
//                 transfer — the lift rides the engine's _l2 geometry, not just averaging).
//   B4 vs-FLOOR : CE_lateral <= CE_floor + 0.02 [report+gate].
//   B5 CONTROL  : report cells + CE_descent reproduces H_1569 A_repr (3.0878) within 1e-6.
//
//  VERDICT: 🟢 GREEN iff B1∧B2∧B3. Else honest 🧱 (c9). ENGINE-NATIVE → terminal permitted.
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

let VOCAB = 27
let MAX_CELLS = 512
let KNN = 4               // lateral transfer fan-in: k key-space neighbours pooled per cell
let BETA_LAT = 0.60       // lateral blend weight (ownv value keeps 1-beta share)

fn _sym(c: string) -> int {
    let o = ord(c)
    if o >= 97 && o <= 122 { return o - 96 }
    return 0
}
fn _val_onehot(sym: int) -> [float] {
    let mut v = []
    let mut i = 0
    while i < VOCAB { if i == sym { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return v
}
fn _ce_one(valdist: [float], truesym: int) -> float {
    let ALPHA = 0.30
    let mut s = 0.0
    let mut i = 0
    while i < VOCAB { s = s + valdist[i]  i = i + 1 }
    return 0.0 - ln((valdist[truesym] + ALPHA) / (s + ALPHA * (VOCAB + 0.0)))
}
fn _l2v(a: [float], b: [float]) -> float {
    let n = len(a)
    let mut s = 0.0
    let mut i = 0
    while i < n { let d = a[i] - b[i]  s = s + d * d  i = i + 1 }
    return sqrt(s)
}

// build the LATERAL-pooled value for cell `ci`: ownv value blended with KNN key-space neighbours'
// learned values (distance-weighted over the engine's OWN _l2 affinity on protos). mode:
//   0 = none (return ownv value)   1 = lateral (key-space neighbours)   2 = shuffled (random peers)
fn pooled_value(protos: [[float]], vals: [[float]], ncells: int, ci: int, mode: int) -> [float] {
    let ownv = vals[ci]
    if mode == 0 { return ownv }
    // collect KNN nearest OTHER cells (mode 1) or KNN deterministic "random" peers (mode 2)
    let mut acc = []
    let mut z = 0
    while z < VOCAB { acc = acc + [0.0]  z = z + 1 }
    // ownv contribution (weight 1-BETA)
    let wself = 1.0 - BETA_LAT
    let mut a0 = 0
    while a0 < VOCAB { acc[a0] = acc[a0] + wself * ownv[a0]  a0 = a0 + 1 }

    // find KNN neighbours
    let mut nbr = []      // indices
    let mut nw = []       // weights
    if mode == 1 {
        // key-space nearest: linear scan keep KNN smallest _l2 (excluding self)
        let mut cand = 0
        while cand < ncells {
            if cand != ci {
                let d = _l2v(protos[ci], protos[cand])
                // insert into a small sorted buffer of size <= KNN
                let mut ins = len(nbr)
                if ins < KNN {
                    nbr = nbr + [cand]
                    nw = nw + [d]
                } else {
                    // replace the current worst (max d) if this is closer
                    let mut worst = 0
                    let mut wd = nw[0]
                    let mut t = 1
                    while t < KNN { if nw[t] > wd { wd = nw[t]  worst = t }  t = t + 1 }
                    if d < wd { nbr[worst] = cand  nw[worst] = d }
                }
            }
            cand = cand + 1
        }
    } else {
        // shuffled: KNN deterministic pseudo-random peers (ignores geometry)
        let mut st = (ci * 2654435761 + 777) & 4294967295
        let mut got = 0
        while got < KNN && got < ncells - 1 {
            st = (st * 1103515245 + 12345) & 4294967295
            let peer = st % ncells
            if peer != ci {
                nbr = nbr + [peer]
                nw = nw + [1.0]      // uniform weight (no geometry)
                got = got + 1
            }
        }
    }
    // distance-weighted blend of neighbours (weight = 1/(d+eps)); normalize to BETA_LAT total
    let EPS = 0.0001
    let mut wsum = 0.0
    let mut j = 0
    while j < len(nbr) {
        let w = 1.0 / (nw[j] + EPS)
        wsum = wsum + w
        j = j + 1
    }
    if wsum > 0.0 {
        let mut k = 0
        while k < len(nbr) {
            let w = (1.0 / (nw[k] + EPS)) / wsum * BETA_LAT
            let nv = vals[nbr[k]]
            let mut m = 0
            while m < VOCAB { acc[m] = acc[m] + w * nv[m]  m = m + 1 }
            k = k + 1
        }
    } else {
        // no neighbours (1 cell): ownv value at full weight
        let mut m2 = 0
        while m2 < VOCAB { acc[m2] = acc[m2] + BETA_LAT * ownv[m2]  m2 = m2 + 1 }
    }
    return acc
}

// train an OsmoticStore over the inherited-repr keys (same as H_1569 A_repr), then score held-out
// CE under a lateral mode. Returns [meanCE, cells].
fn run_arm(mode: int, ctxstr: [string], nxt: [int], ntrain: int, ntest: int, cfg: EngineConfig) -> [float] {
    let N = len(nxt)
    let mut st = osmotic_store_new(immune_embed_key(ctxstr[0]), _val_onehot(nxt[0]), MAX_CELLS)
    let mut p = 1
    while p < ntrain {
        st = osmotic_learn(st, immune_embed_key(ctxstr[p]), _val_onehot(nxt[p]), cfg, 0, 0.0, 0.30, -1.0)
        p = p + 1
    }
    let ncells = osmotic_cells(st)
    // PRECOMPUTE the pooled value for each cell ONCE (lateral transfer is a learned post-pass)
    let mut pooled = []
    let mut c = 0
    while c < ncells {
        pooled = pooled + [pooled_value(st.field.protos, st.vals, ncells, c, mode)]
        c = c + 1
    }
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let win = vadapt_field_nearest_idx(st.field, immune_embed_key(ctxstr[t]))
        tot = tot + _ce_one(pooled[win], nxt[t])
        t = t + 1
    }
    return [tot / (ntest + 0.0), ncells + 0.0]
}

fn ngram_floor(s1s: [int], s2s: [int], nxt: [int], ntrain: int, ntest: int) -> float {
    let NCTX = VOCAB * VOCAB
    let mut counts = []
    let mut ci = 0
    while ci < NCTX {
        let mut row = []
        let mut sj = 0
        while sj < VOCAB { row = row + [0.0]  sj = sj + 1 }
        counts = counts + [row]
        ci = ci + 1
    }
    let mut p = 0
    while p < ntrain {
        let ctx = s1s[p] * VOCAB + s2s[p]
        let mut row = counts[ctx]
        row[nxt[p]] = row[nxt[p]] + 1.0
        counts[ctx] = row
        p = p + 1
    }
    let ALPHA = 0.30
    let N = len(nxt)
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let ctx = s1s[t] * VOCAB + s2s[t]
        let row = counts[ctx]
        let mut s = 0.0
        let mut k = 0
        while k < VOCAB { s = s + row[k]  k = k + 1 }
        tot = tot + (0.0 - ln((row[nxt[t]] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))))
        t = t + 1
    }
    return tot / (ntest + 0.0)
}

fn main() {
    let cfg = engine_config_default()
    let raw = exec("cat /usr/share/dict/words | tr 'A-Z' 'a-z' | tr -cd 'a-z\n' | tr '\n' ' ' | head -c 12000").trim()
    let blen = byte_len(raw)
    let mut s1s = []
    let mut s2s = []
    let mut nxt = []
    let mut ctxstr = []
    let mut i = 2
    while i < blen {
        s1s = s1s + [_sym(substring(raw, i - 2, i - 1))]
        s2s = s2s + [_sym(substring(raw, i - 1, i))]
        nxt = nxt + [_sym(substring(raw, i, i + 1))]
        ctxstr = ctxstr + [substring(raw, i - 2, i)]
        i = i + 1
    }
    let N = len(nxt)
    let ntrain = (N * 8) / 10
    let ntest = N - ntrain
    println("CORPUS bytes=" + str(blen) + " PAIRS N=" + str(N) + " train=" + str(ntrain) + " test=" + str(ntest))

    let r_desc = run_arm(0, ctxstr, nxt, ntrain, ntest, cfg)
    let r_lat  = run_arm(1, ctxstr, nxt, ntrain, ntest, cfg)
    let r_abl  = run_arm(0, ctxstr, nxt, ntrain, ntest, cfg)   // ablation == descent (lateral OFF)
    let r_shuf = run_arm(2, ctxstr, nxt, ntrain, ntest, cfg)

    let ce_desc = r_desc[0]
    let ce_lat  = r_lat[0]
    let ce_abl  = r_abl[0]
    let ce_shuf = r_shuf[0]
    let ce_floor = ngram_floor(s1s, s2s, nxt, ntrain, ntest)

    println("")
    println("=== H_1570 LATERAL GENE TRANSFER mitosis — held-out next-byte CE (nats) ===")
    println("A_descent (vertical-only ceiling) CE = " + str(ce_desc) + "   cells=" + str(r_desc[1]))
    println("A_lateral (lateral transfer ON)   CE = " + str(ce_lat))
    println("A_ablate  (lateral OFF == descent) CE = " + str(ce_abl))
    println("A_shuf    (random-peer transfer)  CE = " + str(ce_shuf))
    println("n-gram FLOOR (order-2 Markov)     CE = " + str(ce_floor))
    println("")

    let b1 = ce_lat < (ce_desc - 0.10)
    let b2 = ce_abl == ce_desc
    let b3 = ce_shuf >= (ce_lat + 0.05)
    let b4 = ce_lat <= (ce_floor + 0.02)

    println("B1 BREAK     lateral<descent-0.10 : " + str(b1) + "  (lat " + str(ce_lat) + " vs desc-0.10 " + str(ce_desc - 0.10) + ")")
    println("B2 ABLATION  ablate==descent      : " + str(b2) + "  (abl " + str(ce_abl) + " desc " + str(ce_desc) + ")")
    println("B3 CAUSAL    shuf>=lateral+0.05   : " + str(b3) + "  (shuf " + str(ce_shuf) + " vs lat+0.05 " + str(ce_lat + 0.05) + ")")
    println("B4 vs-FLOOR  lateral<=floor+0.02  : " + str(b4) + "  (lat " + str(ce_lat) + " vs floor+0.02 " + str(ce_floor + 0.02) + ")")
    println("   [report] lateral-floor=" + str(ce_lat - ce_floor) + "  descent-floor=" + str(ce_desc - ce_floor))
    println("")

    let green = b1 && b2 && b3
    if green {
        println("VERDICT: GREEN ENGINE-NATIVE — lateral gene transfer BREAKS the vertical-only mitosis ceiling (B1 and B2 and B3).")
    } else {
        println("VERDICT: WALL HOLDS (engine-native) — lateral gene transfer does NOT lift split-only mitosis here (B1/B2/B3 not all true).")
    }
    println("B1=" + str(b1) + " B2=" + str(b2) + " B3=" + str(b3) + " B4=" + str(b4))
}
