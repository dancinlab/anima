// g6_mbar_probe_303m.hexa — H_1394 G6 r2 PRODUCTION-CLOSE engine-native M-bar re-score
// on a 303M-class ConvMoE .clm (d5000/E2/L1, n_params 302.6M), via the SAME live engine
// ideation entry gen_clm_ideate (core/generator.hexa L3 slot). Detector + frames + best-of-K
// reused VERBATIM from core/g6_ideation.hexa (NO bar moved, p7). GEN bumped 24->110 to match
// the H_1362 gauge regime (MAX_NEW=110) so the larger mouth has the SAME byte budget to emit
// a measurable falsifiable mark; still HARD-BOUNDED (g6_decode_best_of_k caps each draw at GEN).
import "core/g6_ideation.hexa"
fn main() {
    let ckpt = "state/1387_g6_production_close/clm303_d5000.clm"
    let known = _g6_dict_load()
    println("CKPT=" + ckpt)
    println("DETECTOR_CALIBRATION=" + to_string(g6_detector_calibration(known)) + "/10")
    let fr = g6_build_frames(6)
    let comp = fr["composed"]; let shuf = fr["shuffled"]; let abl = fr["ablated"]
    println("FRAME_GUARD_LEAKS=" + to_string(len(g6_frame_guard(comp, known))))
    let st = g6_sampler_selftest()
    println("SAMPLER det=" + to_string(st["deterministic"]) + " diverse=" + to_string(st["diverse"]) + " in_topk=" + to_string(st["in_topk"]))
    let GEN = 110
    let SEED = 7
    let t0 = now_ms()
    let C = g6_score_arm(ckpt, comp, GEN, 3, SEED, true, known)
    println("ARM C_strong   DIST=" + to_string(C["dist"]) + " FALS=" + to_string(C["fals"]) + " coh=" + to_string(C["coherent"]) + "/6")
    let SH = g6_score_arm(ckpt, shuf, GEN, 3, SEED, true, known)
    println("ARM C_shuffle  DIST=" + to_string(SH["dist"]) + " FALS=" + to_string(SH["fals"]) + " coh=" + to_string(SH["coherent"]) + "/6")
    let AB = g6_score_arm(ckpt, abl, GEN, 3, SEED, true, known)
    println("ARM C_ablate   DIST=" + to_string(AB["dist"]) + " FALS=" + to_string(AB["fals"]) + " coh=" + to_string(AB["coherent"]) + "/6")
    let bfr = g6_build_frames(5)
    let B = g6_score_arm(ckpt, bfr["composed"], GEN, 1, SEED, false, known)
    println("ARM B_composed DIST=" + to_string(B["dist"]) + " FALS=" + to_string(B["fals"]) + " coh=" + to_string(B["coherent"]) + "/5")
    // M-bar tally (frozen bars, c9 — verbatim from FREEZE.txt)
    let m1 = C["dist"] >= 5
    let m2 = C["fals"] >= 1
    let m3 = C["fals"] > B["fals"]
    let m4 = C["fals"] > SH["fals"]
    let m5 = C["fals"] > AB["fals"]
    println("M1_COUNT_DIST>=5=" + to_string(m1) + " (" + to_string(C["dist"]) + ")")
    println("M2_DEPTH_FALS>=1=" + to_string(m2) + " (" + to_string(C["fals"]) + ")")
    println("M3_LIFT_C>B=" + to_string(m3) + " (" + to_string(C["fals"]) + ">" + to_string(B["fals"]) + ")")
    println("M4_EARNED_PAIR_C>shuf=" + to_string(m4) + " (" + to_string(C["fals"]) + ">" + to_string(SH["fals"]) + ")")
    println("M5_EARNED_COMP_C>abl=" + to_string(m5) + " (" + to_string(C["fals"]) + ">" + to_string(AB["fals"]) + ")")
    println("WALL_MS=" + to_string(now_ms()-t0))
    println("[C_strong texts]")
    let ct = C["texts"]
    let mut k = 0
    while k < len(ct) { println("  > " + to_string(ct[k])); k = k + 1 }
}
