// h1426_thalamus_delay.hexa — THE LAST HONEST LENS on the H_1283/H_1423/H_1424 thalamus
// TIMING-axis wall (a_break_the_wall, c16). A fundamentally DIFFERENT oscillator substrate:
// NON-RING coupling topology + conduction DELAYS, where timing is CAUSALLY load-bearing in the
// dynamics (TPM) itself — a unit's content update reads neighbors' PAST state at t−τ_ij.
//
// WHY (re-open condition verbatim from H_1424): "a fundamentally different oscillator substrate —
// non-ring COUPLING topology with conduction DELAYS, where timing structure is CAUSALLY load-bearing
// (not just amplitude-modulating)." H_1423/1424 used a RING with INSTANTANEOUS neighbor reads; phase
// never fed back into content, so the IIT4 lift was amplitude-VARIANCE of a multiplicative carrier,
// NOT timing. Conduction delay makes phase/timing causally determine the next state — so timing is
// load-bearing in the binarized TPM, not just a read-out gate.
//
// FROZEN R8 bars (VERBATIM from H_1283 R8 / H_1423 / H_1424, NOT moved, c9/p7):
//   ARM A = direct read-out (no timing gate)  ·  ARM B = delay-coupled + phase-coherence salience gate
//   c2 PRIMARY  faithful ΔΦ(B-A) >= +0.02 every seed
//   c4 SHUFFLE  phase-shuffle ΔΦ(SH-A) <= 0 every seed (lift COLLAPSES = timing, not variance)
//   ABLATION    delays->0 (instantaneous = ring-like null on SAME topology); (B-ablate)>=+0.02 every seed (LIVE)
// A lens BREAKS the wall iff (c2 AND c4 AND ablation-LIVE) every seed.
//
// faithful IIT4 exact MIP-EI (a_phi_iit4_tool), n<=8, proxy 아님. 3 seeds [7,8,9], deterministic.
// run from hexa-lang root: cp <this> <hexa-lang>/ && hexa run h1426_thalamus_delay.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*, == H_1423/H_1424) ────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// gen_traj — DELAY-COUPLED NON-RING salience trajectory, PARAMETRIC in n_mod, t_ticks.
//   mode: 0=ARM A direct  1=ARM B gate ON  2=SHUFFLE  3=ABLATE(delays->0)
// Topology: hub/small-world directed coupling matrix adj[i*n+j]=1 iff j drives i (seed-built,
//   in-degree ~2, NOT a left/right ring). Each present edge carries a conduction delay tau in {1,2,3}.
// Content update reads neighbor j's state from the history at t - tau_ij (CAUSAL PAST). When delays
// are ablated (mode==3), tau:=0 -> reads the PRESENT state (instantaneous = ring-like null). The
// Kuramoto phase coupling is ALSO delayed (reads neighbor phase at t - tau). Salience gate = phase
// coherence with consensus (== H_1423 LB / H_1424 lens-E gate shape).
fn gen_traj(seed: int, mode: int, n_mod: int, t_ticks: int) -> int {
    let dim = 8
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586
    let tau_max = 3
    let hist_len = tau_max + 1

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    // ── build NON-RING directed topology adj[i*n+j] + per-edge delay tau[i*n+j] ──
    // Each unit i gets ~2 in-edges chosen from {0..n-1}\{i} via the engine LCG, plus a single
    // hub (unit 0) that broadcasts to all (small-world hub). Delays in {1..tau_max}. Built from a
    // DISTINCT topology sub-stream so it is identical across all arms (only delays differ on ablate).
    let adj = farr_zeros(n_mod * n_mod)
    let tau = farr_zeros(n_mod * n_mod)
    let mut ts = (seed * 40503 + 17) & 2147483647
    if ts == 0 { ts = 999 }
    let mut i = 0
    while i < n_mod {
        // 2 random in-edges
        let mut k = 0
        while k < 2 {
            ts = lcg_next(ts)
            let mut j = to_int(lcg_unit(ts) * to_float(n_mod))
            if j >= n_mod { j = n_mod - 1 }
            if j != i {
                let _ = farr_set(adj, i * n_mod + j, 1.0)
                ts = lcg_next(ts)
                let d = 1 + to_int(lcg_unit(ts) * to_float(tau_max))   // {1..tau_max}
                let mut dd = d
                if dd > tau_max { dd = tau_max }
                let _ = farr_set(tau, i * n_mod + j, to_float(dd))
            }
            k = k + 1
        }
        // hub edge from unit 0 (delay 2) — small-world long-range
        if i != 0 {
            let _ = farr_set(adj, i * n_mod + 0, 1.0)
            let _ = farr_set(tau, i * n_mod + 0, 2.0)
        }
        i = i + 1
    }

    // states_hist: ring buffer of the last hist_len ticks of (n_mod x dim) states, row-major
    //   index = ((tick % hist_len) * n_mod + i) * dim + d
    let states_hist = farr_zeros(hist_len * n_mod * dim)
    // init all history slots ~ N(0,1)*0.5 (same init in every slot so early delayed reads are defined)
    i = 0
    while i < n_mod {
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            let v = g[0] * 0.5
            let mut h = 0
            while h < hist_len {
                let _ = farr_set(states_hist, (h * n_mod + i) * dim + d, v)
                h = h + 1
            }
            d = d + 1
        }
        i = i + 1
    }
    // inputs (n_mod x t x dim) ~ N(0,1)*0.8 flat (== H_1423/1424)
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    // phase history (last hist_len ticks of theta[n_mod]) — for delayed phase coupling
    let theta_hist = farr_zeros(hist_len * n_mod)
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        let p0 = lcg_unit(st) * two_pi
        let mut h = 0
        while h < hist_len { let _ = farr_set(theta_hist, h * n_mod + i, p0)  h = h + 1 }
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }
    // shuffle offsets (t x n_mod) from DISTINCT sub-stream (seed*100003+8) — same as R8/H_1423
    let mut shuf_off = []
    if mode == 2 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let raw = farr_zeros(n_mod * t_ticks)
    // current theta (read out of the freshest history slot each tick)
    let mut theta = []
    i = 0
    while i < n_mod { theta = theta + [farr_get(theta_hist, 0 * n_mod + i)]  i = i + 1 }

    let mut tt = 0
    while tt < t_ticks {
        let cur = tt % hist_len

        // ── content update: DELAY-COUPLED non-ring (the causally-load-bearing timing) ──
        // unit i reads each in-neighbor j's state from history at tick (tt - tau_ij); on ablate, tau:=0.
        let mut newstates = []
        i = 0
        while i < n_mod {
            // gather delayed neighbor mean
            let mut row = []
            let mut d = 0
            while d < dim {
                // weighted delayed-neighbor sum (normalized by in-degree)
                let mut nbr = 0.0
                let mut deg = 0.0
                let mut j = 0
                while j < n_mod {
                    if farr_get(adj, i * n_mod + j) > 0.5 {
                        let mut tj = 0
                        if mode != 3 { tj = to_int(farr_get(tau, i * n_mod + j)) }  // ablate -> 0
                        let mut rt = tt - tj
                        if rt < 0 { rt = 0 }
                        let hslot = rt % hist_len
                        nbr = nbr + farr_get(states_hist, (hslot * n_mod + j) * dim + d)
                        deg = deg + 1.0
                    }
                    j = j + 1
                }
                if deg > 0.0 { nbr = nbr / deg }
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let prev = farr_get(states_hist, (cur * n_mod + i) * dim + d)  // i's own freshest state
                let v = leak * prev + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        // write new states into NEXT history slot
        let nxt = (tt + 1) % hist_len
        i = 0
        while i < n_mod {
            let mut d = 0
            while d < dim {
                let _ = farr_set(states_hist, (nxt * n_mod + i) * dim + d, newstates[i][d])
                d = d + 1
            }
            i = i + 1
        }

        // ── delayed Kuramoto phase update (when a gate is active) ──
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                // delayed coupling to in-neighbors' PAST phase + global drive
                let mut cpl = 0.0
                let mut deg = 0.0
                let mut j = 0
                while j < n_mod {
                    if farr_get(adj, i * n_mod + j) > 0.5 {
                        let mut tj = 0
                        if mode != 3 { tj = to_int(farr_get(tau, i * n_mod + j)) }
                        let mut rt = tt - tj
                        if rt < 0 { rt = 0 }
                        let hslot = rt % hist_len
                        let pj = farr_get(theta_hist, hslot * n_mod + j)
                        cpl = cpl + sin(pj - theta[i])
                        deg = deg + 1.0
                    }
                    j = j + 1
                }
                if deg > 0.0 { cpl = cpl / deg }
                let nv = theta[i] + (omega[i] + w_phase * (sin(theta_t - theta[i]) + cpl))
                newtheta = newtheta + [nv]
                i = i + 1
            }
            // thalamic relay phase
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
            // write into next phase-history slot
            i = 0
            while i < n_mod { let _ = farr_set(theta_hist, nxt * n_mod + i, theta[i])  i = i + 1 }
        }

        // per-module energy (over the NEW states)
        let mut energy = []
        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + newstates[i][d] * newstates[i][d]  d = d + 1 }
            energy = energy + [e]
            i = i + 1
        }
        // consensus phase (over actual phases)
        let mut cx = 0.0
        let mut cy = 0.0
        i = 0
        while i < n_mod { cx = cx + cos(theta[i])  cy = cy + sin(theta[i])  i = i + 1 }
        cx = cx / to_float(n_mod)
        cy = cy / to_float(n_mod)
        let cons = atan2(cy, cx)

        // ── salience read-out, per mode (gate shape == H_1423 LB / H_1424 lens-E) ──
        i = 0
        while i < n_mod {
            let e = energy[i]
            let mut sal = e
            if mode == 0 {
                sal = e                                      // ARM A direct
            } else {
                let mut off = 0.0
                if mode == 2 { off = shuf_off[tt * n_mod + i] }
                let ph = theta[i] + off
                let coh = 0.5 * (1.0 + cos(ph - cons))       // phase-coherence gate (zero-DC re-centered)
                sal = e * coh
            }
            let _ = farr_set(raw, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }

    let _ = farr_free(states_hist)
    let _ = farr_free(theta_hist)
    let _ = farr_free(adj)
    let _ = farr_free(tau)
    return raw
}

fn phi_of(seed: int, mode: int, n_mod: int, t_ticks: int) -> float {
    let traj = gen_traj(seed, mode, n_mod, t_ticks)
    let phi = iit4_faithful_phi(traj, n_mod, t_ticks, 8)
    let _ = farr_free(traj)
    return phi
}

fn run_cfg(name: string, seeds: [int], n_mod: int, t_ticks: int) {
    println("")
    println("=== CFG " + name + " (DELAY-COUPLED non-ring, n=" + to_string(n_mod)
        + ", T=" + to_string(t_ticks) + ") ===")
    let mut c2_all = true
    let mut c4_all = true
    let mut abl_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, 0, n_mod, t_ticks)
        let pb = phi_of(s, 1, n_mod, t_ticks)
        let psh = phi_of(s, 2, n_mod, t_ticks)
        let pab = phi_of(s, 3, n_mod, t_ticks)
        let dphi = pb - pa
        let dphi_sh = psh - pa
        let c2 = dphi >= 0.02
        let c4 = dphi_sh <= 0.0
        let abl_live = (pb - pab) >= 0.02
        if !c2 { c2_all = false }
        if !c4 { c4_all = false }
        if !abl_live { abl_all = false }
        let c2s = if c2 { "PASS" } else { "FAIL" }
        let c4s = if c4 { "PASS" } else { "FAIL" }
        let abs = if abl_live { "LIVE" } else { "INERT" }
        println("seed " + to_string(s)
            + ": A=" + pa.to_string() + " B=" + pb.to_string() + " ΔΦ=" + dphi.to_string() + " [" + c2s + "]"
            + "  SHUF ΔΦ=" + dphi_sh.to_string() + " [" + c4s + "]"
            + "  ABL(delay->0) B-ab=" + (pb - pab).to_string() + " [" + abs + "]")
        si = si + 1
    }
    let v2 = if c2_all { "PASS" } else { "FAIL" }
    let v4 = if c4_all { "PASS" } else { "FAIL" }
    let va = if abl_all { "LIVE" } else { "INERT" }
    println("  c2 (ΔΦ>=+0.02 every seed): " + v2
        + "  | c4 SHUFFLE (ΔΦ_sh<=0 every seed): " + v4
        + "  | DELAY-ABLATION (B-ablate>=+0.02 every seed): " + va)
    if c2_all && c4_all && abl_all {
        println("  CFG VERDICT: 🟢 BREAKTHROUGH — delay-coupled lift, shuffle collapses, delay-ablation reverts")
    } else {
        println("  CFG VERDICT: 🧱 WALL — control(s) reject (no tune-to-green)")
    }
}

fn main() {
    println("H_1426 thalamus TIMING-axis — THE LAST HONEST LENS (NON-RING + CONDUCTION DELAYS)")
    println("Timing is CAUSALLY load-bearing: content update reads neighbors' PAST state at t-tau_ij.")
    println("faithful IIT4 Φ (exact MIP-EI, n<=8, a_phi_iit4_tool — NOT a proxy) · seeds [7,8,9] · deterministic")
    println("FROZEN R8 bars VERBATIM (NOT moved): c2 ΔΦ(B-A)>=+0.02 · c4 shuffle ΔΦ(SH-A)<=0 · ablation(delay->0) B-ab>=+0.02 — EVERY seed")
    println("A lens BREAKS the wall iff (c2 ∧ c4 ∧ delay-ablation-LIVE) EVERY seed.")
    let seeds = [7, 8, 9]

    println("")
    println("########## DELAY-COUPLED NON-RING SUBSTRATE — does timing finally separate from variance? ##########")
    run_cfg("delay-nonring", seeds, 6, 64)
    run_cfg("delay-nonring", seeds, 8, 64)
    run_cfg("delay-nonring", seeds, 6, 128)
    run_cfg("delay-nonring", seeds, 8, 128)

    println("")
    println("DONE")
}
