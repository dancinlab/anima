// engine_decode_batch_cli.hexa — LOAD-ONCE batch decode for the H_1431 5-bar (Lane C).
// argv: <bin_path> <jobs_path> <out_path> <gen> <top_k> <temp_milli>
// Loads the 303M ONCE (bg_load_ranged) then generates every fragment in jobs_path,
// appending `tag<TAB>text` to out_path as each finishes (commit-early/resumable).
import "core/bytegpt_decode.hexa"
fn main() {
    let a = argv()
    let bin  = a[1]
    let jobs = a[2]
    let out  = a[3]
    let gen   = to_int(a[4])
    let top_k = to_int(a[5])
    let temp  = to_float(to_int(a[6])) / 1000.0
    let n = bytegpt_decode_batch_to_file(bin, jobs, out, gen, top_k, temp)
    println("BATCH_DONE " + to_string(n) + " fragments")
}
