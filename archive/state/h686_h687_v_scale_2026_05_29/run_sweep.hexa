// V-scale sweep driver — runs 20 combos (5 V × 4 cell).
// $0 Mac local · 10min cap per cell via shell timeout.

fn main() {
    let vs = [8, 64, 256, 1024, 4096]
    let cells = ["none", "ent", "kl", "both"]
    let outdir = "state/h686_h687_v_scale_2026_05_29"
    let _ = exec("mkdir -p " + outdir)
    let _ = exec("date -u +%FT%TZ > " + outdir + "/MANIFEST.txt")

    let mut vi = 0
    while vi < vs.len() {
        let V = vs[vi]
        let mut ci = 0
        while ci < cells.len() {
            let CELL = cells[ci]
            let OUT = outdir + "/V" + str(V) + "_" + CELL + ".out"
            println("── V=" + str(V) + " CELL=" + CELL + " → " + OUT)
            let cmd = "cd /tmp/wt-vsw && START=$(date +%s) && timeout 600 hexa run core/DECODER/h686_h687_v_scale.hexa " + str(V) + " " + CELL + " > " + OUT + " 2>&1; RC=$?; END=$(date +%s); DUR=$((END-START)); echo \"V=" + str(V) + " CELL=" + CELL + " rc=$RC dur=${DUR}s\" >> " + outdir + "/MANIFEST.txt; echo \"rc=$RC dur=${DUR}s\""
            let result = exec(cmd)
            println("  " + result.trim())
            ci = ci + 1
        }
        vi = vi + 1
    }
    let _ = exec("date -u +%FT%TZ >> " + outdir + "/MANIFEST.txt")
    println("sweep done")
}
