// h1455 — G6 coherence-detector exploration: does engine byte-trigram clause-cosine
// (immune_embed_key) discriminate coherent vs cross-shuffle clause pairs? RESULT: SEP=0.0
// (byte-trigram over NL clauses is common-trigram-dominated → cos≈1.0 for all) → NOT-VIABLE.
import "core/engine_cli.hexa"
fn cos(a: [float], b: [float]) -> float {
    let mut d = 0.0  let mut na = 0.0  let mut nb = 0.0  let mut i = 0
    while i < len(a) { d = d + a[i]*b[i]  na = na + a[i]*a[i]  nb = nb + b[i]*b[i]  i = i + 1 }
    if na <= 0.0 || nb <= 0.0 { return 0.0 }
    return d / (sqrt(na) * sqrt(nb))
}
fn main() {
    let compc = ["if consciousness increases the emit","tension predicts a higher","memory density correlates with a lower error","the phi value is greater when distinct cells exceed a","novelty rate decreases faster than coherence when the corpus"]
    let measc = ["rate measured at the boundary rises","number of mitosis cells than silence","threshold when grounded","count of eight","size grows"]
    let mut sc = 0.0  let mut i = 0
    while i < 5 { sc = sc + cos(immune_embed_key(compc[i]), immune_embed_key(measc[i]))  i = i + 1 }
    let mco = sc / 5.0
    let mut ss = 0.0  let mut cnt = 0  i = 0
    while i < 5 { let mut j = 0  while j < 5 { if j != i { ss = ss + cos(immune_embed_key(compc[i]), immune_embed_key(measc[j]))  cnt = cnt + 1 }  j = j + 1 }  i = i + 1 }
    let msh = ss / to_float(cnt)
    println("MEAN coherent=" + to_string(mco) + " cross-shuffle=" + to_string(msh) + " SEP=" + to_string(mco - msh))
}
