// Engine-native G6 multi-seed harness for h1129 (303M ByteGPT) — G6-ONLY (lean).
// Imports core/g_gates.hexa -> g_g6_multiseed_only -> g_eval_g6_multiseed via the WIRED
// mouth-agnostic op g6_score_arm_auto. Mouth enters through generator L3 gen_auto_ideate
// (mouth-sniff -> bytegpt_decode). ZERO torch / numpy. seeds {7,4302,4303}, majority>=2/3.
// per_seed[0] (base_seed=7) == the frozen single-seed G6 default frame-for-frame.
import "core/g_gates.hexa"

fn main() {
    let ckpt = "/home/summer/anima-weights/bytegpt303_h1129/h1129.bin"
    let gen = 80
    let ms = g_g6_multiseed_only(ckpt, gen)
    println("=== h1129 G6 MULTISEED ENGINE-NATIVE (core/g_gates.hexa, gen=120) ===")
    println("ckpt=" + ckpt)
    let per = ms["per_seed"]
    let mut i = 0
    while i < len(per) {
        let p = per[i]
        println("seed=" + to_string(p["base_seed"]) + "  dist=" + to_string(p["dist"]) + "  fals=" + to_string(p["fals"]) + "  coherent=" + to_string(p["coherent"]) + "  pass=" + to_string(p["pass"]))
        i = i + 1
    }
    println("MAJORITY: pass=" + to_string(ms["pass"]) + "  n_green=" + to_string(ms["n_green"]) + "/" + to_string(ms["n_seeds"]) + "  max_fals=" + to_string(ms["max_fals"]))
    println("G6_MULTISEED_DONE")
}
