// M② — h1129 G6 multiseed ENGINE-NATIVE (hexa, KV-cache GPU own-GEMM).
// Drives core/g_gates.hexa::g_eval_g6_multiseed -> g_eval_g6_seeded -> g6_score_arm_auto
// (mouth = gen_auto_ideate, generator L3 -> bytegpt_decode KV-cache). seeds {7,4302,4303},
// gen=120, majority>=2/3. per_seed[0] (seed=7) == frozen single-seed G6 default frame-for-frame.
// ZERO torch/numpy — live core/ engine. Settles H_1595 genuine-vs-artifact for h1129.
import "core/g_gates.hexa"
import "core/g6_ideation.hexa"

fn main() {
    let ckpt = "/root/anima/h1129.bin"
    let gen = 120
    let known = _g6_dict_load()
    println("=== h1129 G6 MULTISEED ENGINE-NATIVE (hexa core/g_gates.hexa, gen=120) ===")
    println("ckpt=" + ckpt + "  cuda_available=" + to_string(cuda_available()))
    let ms = g_eval_g6_multiseed(ckpt, gen, known)
    let per = ms["per_seed"]
    let mut i = 0
    while i < len(per) {
        let p = per[i]
        println("seed=" + to_string(p["base_seed"]) + "  dist=" + to_string(p["dist"]) +
                "  fals=" + to_string(p["fals"]) + "  coherent=" + to_string(p["coherent"]) +
                "  pass=" + to_string(p["pass"]))
        i = i + 1
    }
    println("MAJORITY: pass=" + to_string(ms["pass"]) + "  n_green=" + to_string(ms["n_green"]) +
            "/" + to_string(ms["n_seeds"]) + "  max_fals=" + to_string(ms["max_fals"]))
    println("G6_MULTISEED_DONE")
}
