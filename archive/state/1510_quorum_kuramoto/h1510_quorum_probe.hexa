// H_1510 QUORUM-KURAMOTO — engine-native probe (R2). Re-scores the SAME frozen bars as the R1
// numpy mirror (state/1510_quorum_kuramoto/h1510.py) BYTE-EXACT on the live core/engine_cli.hexa
// § QuorumPhase lane. external proposal — Amoeba Protocol (adjacency-weighted Kuramoto / quorum).
//   A semantic-lock : within-cluster PLV >= 0.70 AND cross-cluster PLV <= 0.50
//   B no-central-hub: decentralized drop-node order >= 0.70 AND star no-hub order <= 0.50
//   C integration   : quorum within-cluster order >= centralized star baseline
//   D earned shuffle: |PLV_in_shuf - PLV_cross_shuf| <= 0.20
// usage: hexa run state/1510_quorum_kuramoto/h1510_quorum_probe.hexa
import "core/engine_cli.hexa"

let NC = 3
let PER = 3
let STEPS = 64
let TAIL = 48

fn run_seed(seed: int) -> [float] {
    let qp = quorum_new(seed, NC, PER)
    let settled = quorum_run(qp, STEPS)
    let r_in = quorum_cluster_order(settled)
    let plv_in = quorum_within_plv(qp, TAIL)
    let plv_cross = quorum_cross_plv(qp, TAIL)
    // B: decentralized survives node removal; star dies without hub
    let r_drop = quorum_drop_node_order(seed, NC, PER, STEPS)
    let r_star_nohub = quorum_star_no_hub_order(seed, NC, PER, STEPS)
    // C baseline: centralized PhaseField star (k=0.5, hub present) within-cluster order
    let r_star_base = quorum_star_baseline_order(seed, NC, PER, STEPS)
    // D: shuffle adjacency
    let sadj = quorum_shuffle_adj(seed + 5000, NC, PER)
    let qsh = quorum_with_adj(seed, NC, PER, sadj)
    let plv_in_sh = quorum_within_plv(qsh, TAIL)
    let plv_cross_sh = quorum_cross_plv(qsh, TAIL)
    return [r_in, plv_in, plv_cross, r_drop, r_star_nohub, plv_in_sh, plv_cross_sh, r_star_base]
}

pub fn main() {
    println("H_1510 QUORUM-KURAMOTO engine-native probe (core/engine_cli.hexa § QuorumPhase)")
    let seeds = [7, 8, 9]
    let mut s = 0
    while s < len(seeds) {
        let seed = seeds[s]
        let r = run_seed(seed)
        println("[seed " + to_string(seed) + "]"
            + " R_in=" + to_string(r[0])
            + " PLV_in=" + to_string(r[1])
            + " PLV_cross=" + to_string(r[2])
            + " drop=" + to_string(r[3])
            + " star_nohub=" + to_string(r[4])
            + " PLV_in_sh=" + to_string(r[5])
            + " PLV_cross_sh=" + to_string(r[6])
            + " star_base=" + to_string(r[7]))
        s = s + 1
    }
}
