// h1423_thalamus_multilens.hexa — MULTI-LENS engine-native breakthrough attempt on the
// H_1283 thalamus TIMING-axis wall (a_break_the_wall, c16).
//
// THE WALL (verbatim from UNIVERSE/cards/H_1283): the relay-CONTENT axis (R1-R5/R7/R9) is 🧱
// (every content cut caps faithful-IIT4 Φ). The TIMING axis (R8 Kuramoto phase-gated salience)
// was 🟢 numpy-mirror DIRECTIONAL, but its ENGINE-NATIVE re-verification FAILED the c4 SHUFFLE
// control: c2 (Φ-lift) reproduced (ΔΦ +1.466/+0.844/+0.709) BUT c4 phase-shuffle did NOT collapse
// the lift engine-native (ΔΦ_sh +0.026/+0.380/+0.296, all positive). The R8 salience gate
// e*(1+cosθ)/2 is a MULTIPLICATIVE carrier whose VARIANCE alone lifts Φ even under shuffled phases.
//
// FROZEN R8 bars (VERBATIM, NOT moved, c9/p7):
//   ARM A = direct ring (no timing gate)   ·   ARM B = ring + timing-gated salience
//   c2 PRIMARY  faithful ΔΦ(B-A) >= +0.02 on EVERY seed [7,8,9]
//   c4 SHUFFLE  phase_shuffle ΔΦ(SH-A) <= 0 on EVERY seed (lift COLLAPSES = structured, not variance)
//   ABLATION    timing-mechanism OFF must == ARM A (== baseline relay) -> if lift survives ablation
//               the mechanism is INERT (a_break_the_wall (d) ablation-ceiling tool)
// A lens BREAKS the engine-native wall iff (c2 AND c4 AND ablation-LIVE) on every seed.
//
// THREE biology-faithful timing lenses, each its OWN shuffle + ablation:
//   LA RE-ENTRANT LOOP GATE      — content reaches workspace only if it survives a thalamo-cortico-
//                                  thalamic re-validation pass. Salience gated by agreement between
//                                  forward content and fed-back re-validated content (a re-entrant
//                                  GATE, not a free carrier). SHUF = scramble feedback pairing.
//                                  ABLATE = feedback OFF (pass-through relay == ARM A read-out).
//   LB PHASE-DIFFERENCE COHERENCE — gate salience by RELATIVE phase locking cos(θ_i - θ_consensus)
//                                  (zero net DC carrier bias). Under shuffle, random phases ->
//                                  coherence ~ 0 -> gate uniform -> lift MUST collapse. The fix vs R8:
//                                  no multiplicative absolute-phase carrier. ABLATE = coherence=const.
//   LC ADDITIVE ORDER-PARAM BIAS  — NO multiplicative carrier; ADD a synchrony term only when the
//                                  population is phase-locked: sal = e + lam*R*e_mean, R = Kuramoto
//                                  order parameter |mean(e^{i theta})|. SHUF destroys R. ABLATE R=0.
//
// run from hexa-lang root:  cp <this> <hexa-lang>/ && hexa run h1423_thalamus_multilens.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) ──────────────────────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── frozen R8 constants ───────────────────────────────────────────────────────
//   N_MOD=4 DIM=8 T=64 GAIN=0.30 LEAK=0.55 W_NBR=0.5 W_IN=0.5 NBINS=8
//   W_PHASE=0.5 OMEGA_T=0.45 DOMEGA=0.08
//
// gen_traj — engine-native salience trajectory under a chosen LENS + MODE.
//   lens: 0=R8-original(absolute-carrier)  1=LA reentrant  2=LB phase-diff-coherence  3=LC additive-order
//   mode: 0=ARM A (direct, NO gate)  1=ARM B (gate ON)  2=SHUFFLE  3=ABLATE
// Content update is IDENTICAL across all arms (binding is by TIMING, not content).
fn gen_traj(seed: int, lens: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let lam = 0.5
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    // states (n_mod x dim) init ~ N(0,1)*0.5
    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    // inputs (n_mod x t x dim) ~ N(0,1)*0.8 flat
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    // phase init + detuned omega
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }
    // shuffle offsets (t x n_mod) from a DISTINCT sub-stream (seed*100003+8) — same as R8
    let mut shuf_off = []
    if mode == 2 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        // content update (IDENTICAL all modes)
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        // Kuramoto phase update (only when a gate is active: mode 1/2, or ablate mode 3 for lenses
        // that still need phases computed — but ablate NULLS the gate effect at read-out)
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // ── per-module energy ──
        let mut energy = []
        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            energy = energy + [e]
            i = i + 1
        }
        // consensus phase (vector mean) + order parameter R
        let mut cx = 0.0
        let mut cy = 0.0
        i = 0
        while i < n_mod { cx = cx + cos(theta[i])  cy = cy + sin(theta[i])  i = i + 1 }
        cx = cx / to_float(n_mod)
        cy = cy / to_float(n_mod)
        let bigr = sqrt(cx * cx + cy * cy)           // Kuramoto order parameter |mean e^{i theta}|
        let cons = atan2(cy, cx)                      // consensus phase
        let mut emean = 0.0
        i = 0
        while i < n_mod { emean = emean + energy[i]  i = i + 1 }
        emean = emean / to_float(n_mod)

        // ── salience read-out, per lens × mode ──
        i = 0
        while i < n_mod {
            let e = energy[i]
            let mut sal = e
            // shuffle offset for this (tt,i) if mode==2
            let mut off = 0.0
            if mode == 2 { off = shuf_off[tt * n_mod + i] }

            if mode == 0 {
                sal = e                              // ARM A: direct, no gate (all lenses)
            } else if lens == 0 {
                // R8 original absolute-phase carrier (sanity anchor; reproduces the engine-gate failure)
                if mode == 3 { sal = e } else {
                    let carrier = 0.5 * (1.0 + cos(theta[i] + off))
                    sal = e * carrier
                }
            } else if lens == 1 {
                // LA RE-ENTRANT LOOP GATE: forward content energy e is broadcast only if it AGREES
                // with the consensus (re-validated content). Agreement = phase locking to consensus
                // gates a FRACTION of e to pass; the re-entrant loop multiplies the AGREEMENT, not a
                // free carrier. gate = max(0, cos(theta_i - cons)) — content survives only if locked
                // to the re-validated workspace consensus. SHUF: theta_i+off scrambles the loop pairing
                // -> agreement randomized. ABLATE: feedback OFF -> gate=1 (pass-through == ARM A).
                if mode == 3 {
                    sal = e
                } else {
                    let ph = theta[i] + off
                    let ag = cos(ph - cons)
                    let gate = if ag > 0.0 { ag } else { 0.0 }
                    sal = e * gate
                }
            } else if lens == 2 {
                // LB PHASE-DIFFERENCE COHERENCE: gate by RELATIVE locking to consensus, RE-CENTERED so
                // the gate has ZERO mean carrier bias: gate = 0.5*(1 + cos(theta_i - cons)). Under
                // shuffle, theta_i+off random vs cons -> E[cos]=0 -> gate -> 0.5 uniform -> lift collapses.
                // ABLATE: coherence frozen -> gate=0.5 const (same DC, NO timing structure).
                if mode == 3 {
                    sal = e * 0.5
                } else {
                    let ph = theta[i] + off
                    let coh = 0.5 * (1.0 + cos(ph - cons))
                    sal = e * coh
                }
            } else {
                // LC ADDITIVE ORDER-PARAM BIAS: NO multiplicative carrier. ADD a synchrony term scaled
                // by the population order parameter R (only large when modules are phase-locked):
                //   sal = e + lam * R * emean.  Under shuffle, R computed from scrambled phases -> small
                //   when desynchronized. ABLATE: R:=0 -> sal=e (== ARM A) so ablate==baseline by design.
                if mode == 3 {
                    sal = e
                } else {
                    // shuffle perturbs the phases entering R: recompute R over theta_i+off
                    let mut rr = bigr
                    if mode == 2 {
                        let mut sx = 0.0
                        let mut sy = 0.0
                        let mut k = 0
                        while k < n_mod {
                            let p2 = theta[k] + shuf_off[tt * n_mod + k]
                            sx = sx + cos(p2)  sy = sy + sin(p2)  k = k + 1
                        }
                        sx = sx / to_float(n_mod)
                        sy = sy / to_float(n_mod)
                        rr = sqrt(sx * sx + sy * sy)
                    }
                    sal = e + lam * rr * emean
                }
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

fn phi_of(seed: int, lens: int, mode: int) -> float {
    let traj = gen_traj(seed, lens, mode)
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn run_lens(name: string, lens: int, seeds: [int]) {
    println("")
    println("=== LENS " + name + " (lens=" + to_string(lens) + ") ===")
    let mut c2_all = true
    let mut c4_all = true
    let mut abl_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, lens, 0)     // ARM A direct (shared baseline relay)
        let pb = phi_of(s, lens, 1)     // ARM B gate ON
        let psh = phi_of(s, lens, 2)    // SHUFFLE
        let pab = phi_of(s, lens, 3)    // ABLATE
        let dphi = pb - pa
        let dphi_sh = psh - pa
        let dphi_ab = pab - pa
        let c2 = dphi >= 0.02
        let c4 = dphi_sh <= 0.0
        // ABLATION-LIVE: with the mechanism OFF the lift must DISAPPEAR (ablate near baseline) — i.e.
        // the gate ON must beat its own ablation. abl_live = (pb - pab) > 0.02 (mechanism contributes).
        let abl_live = (pb - pab) >= 0.02
        if !c2 { c2_all = false }
        if !c4 { c4_all = false }
        if !abl_live { abl_all = false }
        let c2s = if c2 { "PASS" } else { "FAIL" }
        let c4s = if c4 { "PASS" } else { "FAIL" }
        let abs = if abl_live { "LIVE" } else { "INERT" }
        println("seed " + to_string(s)
            + ": A=" + pa.to_string() + " B=" + pb.to_string() + " ΔΦ=" + dphi.to_string() + " [" + c2s + "]"
            + "  SHUF ΔΦ=" + dphi_sh.to_string() + " [" + c4s + "]"
            + "  ABL B-ab=" + (pb - pab).to_string() + " [" + abs + "]")
        si = si + 1
    }
    let v2 = if c2_all { "PASS" } else { "FAIL" }
    let v4 = if c4_all { "PASS" } else { "FAIL" }
    let va = if abl_all { "LIVE" } else { "INERT" }
    println("  c2 PRIMARY (ΔΦ>=+0.02 every seed): " + v2
        + "  | c4 SHUFFLE (ΔΦ_sh<=0 every seed): " + v4
        + "  | ABLATION (B-ablate>=+0.02 every seed): " + va)
    if c2_all && c4_all && abl_all {
        println("  LENS VERDICT: 🟢 BREAKTHROUGH — engine-native lift, shuffle collapses, ablation LIVE")
    } else {
        println("  LENS VERDICT: 🧱 WALL — control(s) reject (no tune-to-green)")
    }
}

fn main() {
    println("H_1423 thalamus TIMING-axis MULTI-LENS engine-native breakthrough attempt")
    println("faithful IIT4 Φ (exact MIP-EI, n=4) · seeds [7,8,9] · FROZEN R8 bars (c2 ΔΦ>=+0.02 every seed; c4 shuffle ΔΦ<=0 every seed; ABLATION mechanism-OFF must collapse the lift)")
    let seeds = [7, 8, 9]
    run_lens("R8-ORIGINAL (absolute carrier — sanity: must FAIL c4 engine-native)", 0, seeds)
    run_lens("LA RE-ENTRANT LOOP GATE", 1, seeds)
    run_lens("LB PHASE-DIFFERENCE COHERENCE", 2, seeds)
    run_lens("LC ADDITIVE ORDER-PARAM BIAS", 3, seeds)
    println("")
    println("DONE")
}
