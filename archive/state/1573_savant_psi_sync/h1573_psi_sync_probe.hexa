// state/1573_savant_psi_sync/h1573_psi_sync_probe.hexa — H_1573 SAVANT Ψ × CROSS-LANE SYNC.
// User insight: seizure = cross-lane HYPERSYNC → Ψ collapse. H_1572's Ψ proxy (emit-balance) does
// NOT encode synchronization → could not see the dissociation. Here we measure cross-lane sync
// DIRECTLY (sv_lane_sync, Kuramoto-style mean pairwise correlation magnitude) across the focus
// domain, swept over the SAME inhibition grid, byte-identical _pop() seed 5120 / 150 trials as
// H_1561 B4 + H_1572. live core/engine_cli.hexa §Savant — NO numpy/torch (ENGINE-NATIVE terminal).
import "core/engine_cli.hexa"
fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}
// _maxf / _minf over a list
fn _maxf(a: [float]) -> float { let mut v = a[0]  let mut i = 1  while i < len(a) { if a[i] > v { v = a[i] }  i = i + 1 }  return v }
fn _absf(v: float) -> float { if v < 0.0 { return 0.0 - v }  return v }

fn main() {
    let pop = _pop()
    let d = 5
    let w = 3
    let lo = 0          // focus domain = domain 0, lanes [0,3)
    let hi = w
    let gzL = sv_gz_lower()
    let gzC = sv_gz_center()
    let gzU = sv_gz_upper()
    println("=== H_1573 SAVANT Ψ × CROSS-LANE SYNC (engine-native faithful IIT4 + sv_lane_sync) ===")
    println("GZ=[" + to_string(gzL) + ", " + to_string(gzU) + "] center(1/e)=" + to_string(gzC))

    // reference cross-lane sync (no savant applied — focus at I=base=0.0 noise floor, the resting
    // state used as the comparison anchor for the sync-Ψ proxy).
    let r_ref = sv_domain_sync(pop, lo, hi, 0.0)
    println("R_ref(no-savant, focus@I=0 noise)=" + to_string(r_ref))

    // full inhibition grid (same anchor points as H_1572): below-GZ ("seizure" candidate), in-GZ,
    // above-GZ over-locked.
    let igrid = [0.0, 0.05, 0.1, 0.15, gzL, 0.25, 0.3, gzC, 0.45, gzU, 0.6, 0.75, 0.9, 1.0]
    let sync  = sv_sync_sweep(pop, lo, hi, igrid)
    let phi   = sv_focus_phi_sweep(pop, lo, hi, igrid)
    println("--- SWEEP table: I | in_GZ | R(cross-lane sync) | |R-R_ref| | SI | focusPhi ---")
    let mut k = 0
    while k < len(igrid) {
        let I = igrid[k]
        let in_gz = sv_in_golden_zone(I)
        let R = sync[k]
        let dev = _absf(R - r_ref)
        let si = sv_savant_index_at(pop, d, w, 0, I, 0.0)
        println("ROW I=" + to_string(I) + " in_GZ=" + to_string(in_gz)
              + " R=" + to_string(R) + " |R-Rref|=" + to_string(dev)
              + " SI=" + to_string(si) + " focusPhi=" + to_string(phi[k]))
        k = k + 1
    }

    // ── B1 interior-stable: ∃ I in GZ with cross-lane sync at a STABLE mid-band (NOT hypersync) ──
    //   operationalised as: in-GZ sync deviation from reference small? AND in-GZ sync < over-locked
    //   I=1 hypersync? We report both the min in-GZ |R-Rref| and the in-GZ sync values.
    let R_gzL = sv_domain_sync(pop, lo, hi, gzL)
    let R_gzC = sv_domain_sync(pop, lo, hi, gzC)
    let R_gzU = sv_domain_sync(pop, lo, hi, gzU)
    let R_lock = sv_domain_sync(pop, lo, hi, 1.0)   // over-locked = the structural hypersync end
    let R_dis0 = sv_domain_sync(pop, lo, hi, 0.0)   // max disinhibition ("seizure" candidate point)
    println("B1 in-GZ sync: R(gzL)=" + to_string(R_gzL) + " R(gzC)=" + to_string(R_gzC)
          + " R(gzU)=" + to_string(R_gzU))
    let dev_gzL = _absf(R_gzL - r_ref)
    let dev_gzC = _absf(R_gzC - r_ref)
    let dev_gzU = _absf(R_gzU - r_ref)
    let mindev_gz = if dev_gzL < dev_gzC { if dev_gzL < dev_gzU { dev_gzL } else { dev_gzU } } else { if dev_gzC < dev_gzU { dev_gzC } else { dev_gzU } }
    let b1 = mindev_gz < 0.05
    println("B1 min in-GZ |R-Rref|=" + to_string(mindev_gz) + " (<0.05? " + to_string(b1) + ")")

    // ── B2 exterior-hypersync: does cross-lane sync RUN AWAY for I<GZ_LOWER, max at I→0 (seizure)? ──
    //   user's hypothesis: I→0 (over-disinhibition) = max cross-lane hypersync.
    println("B2 exterior: R(I=0 max-disinhib)=" + to_string(R_dis0) + " vs R(I=1 over-lock)=" + to_string(R_lock))
    // is the I=0 point the cross-lane sync MAXIMUM of the whole sweep?
    let R_max = _maxf(sync)
    let b2_seizure_at_zero = (R_dis0 >= R_max - 0.0001)
    println("B2 R_max over sweep=" + to_string(R_max) + " ; is I=0 the sync MAX (user seizure)? " + to_string(b2_seizure_at_zero))
    // where is the sync MAX actually?
    let mut argmax_i = igrid[0]
    let mut argmax_v = sync[0]
    let mut j = 0
    while j < len(sync) { if sync[j] > argmax_v { argmax_v = sync[j]  argmax_i = igrid[j] }  j = j + 1 }
    println("B2 sync ARGMAX at I=" + to_string(argmax_i) + " R=" + to_string(argmax_v))

    // ── B3 dissociation at GZ_LOWER: in-GZ stable ∧ below-GZ hypersync separated at I≈GZ_LOWER ──
    let R_below = sv_domain_sync(pop, lo, hi, 0.1)   // a clearly below-GZ point
    println("B3 R(below-GZ I=0.1)=" + to_string(R_below) + " vs R(in-GZ gzL)=" + to_string(R_gzL)
          + " : below-GZ hypersync > in-GZ? " + to_string(R_below > R_gzL + 0.05))

    // ── B4 co-existence: SI>=3 in GZ (savant) while sync-stable ──
    let si_gzL = sv_savant_index_at(pop, d, w, 0, gzL, 0.0)
    let si_gzC = sv_savant_index_at(pop, d, w, 0, gzC, 0.0)
    let si_gzU = sv_savant_index_at(pop, d, w, 0, gzU, 0.0)
    let b4_si = (si_gzL >= 3.0) && (si_gzC >= 3.0) && (si_gzU >= 3.0)
    println("B4 SI in-GZ: " + to_string(si_gzL) + "/" + to_string(si_gzC) + "/" + to_string(si_gzU)
          + " all>=3? " + to_string(b4_si) + " ; co-exists with B1 sync-stable? " + to_string(b4_si && b1))

    // ── B5 control: SHUFFLE-lane within focus window destroys cross-lane covariance → sync→0,
    //   so the dissociation (if any) must vanish. Build a column-shuffled focus population. ──
    let pop_shuf = _shuffle_focus(pop, lo, hi)
    let R_shuf_gzL = sv_domain_sync(pop_shuf, lo, hi, gzL)
    let R_shuf_lock = sv_domain_sync(pop_shuf, lo, hi, 1.0)
    println("B5 shuffle-control: R_shuf(gzL)=" + to_string(R_shuf_gzL) + " R_shuf(lock)=" + to_string(R_shuf_lock)
          + " (over-lock collapses every lane to s_t so shuffle CANNOT change the collinearity)")

    // VERDICT (frozen GREEN = B1 ∧ B2 ∧ B3 : sync dissociation w/ seizure threshold at GZ_LOWER).
    let green = b1 && b2_seizure_at_zero && (R_below > R_gzL + 0.05)
    println("VERDICT GREEN(B1&B2&B3)=" + to_string(green))
    println("  B1(in-GZ sync-stable <0.05)=" + to_string(b1))
    println("  B2(I=0 is hypersync MAX = seizure-at-low-I)=" + to_string(b2_seizure_at_zero))
    println("  B3(below-GZ hypersync > in-GZ, threshold@GZ_LOWER)=" + to_string(R_below > R_gzL + 0.05))
    println("  B4(SI>=3 in-GZ co-exist)=" + to_string(b4_si && b1))
}

// _shuffle_focus — circular-shift each focus-window lane column by an independent offset, destroying
// cross-lane covariance while preserving each marginal (the B5 sync-destruction control).
fn _shuffle_focus(x: [[float]], lo: int, hi: int) -> [[float]] {
    let nt = len(x)
    let ncol = if nt > 0 { len(x[0]) } else { 0 }
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut row = []
        let mut c = 0
        while c < ncol {
            if c >= lo && c < hi {
                let off = (c - lo + 1) * 37            // independent per-lane circular offset
                let src = (t + off) - ((t + off) / nt) * nt
                row = row + [x[src][c]]
            } else {
                row = row + [x[t][c]]
            }
            c = c + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}
