// BUG REPRO: farr_set(arr, i, to_float(intLiteralArray[i])) silently stores 0
// on the C-transpile (dispatch) path. Found via anima 303M ByteGPT parity (argmax 227 vs 32).
//
//   hexa run scripts/scratch/farr_set_i64index_drop_repro.hexa
//   EXPECT (correct): BUGONLY 84 104 110
//   ACTUAL  (bug):    BUGONLY 0 0 0
//
// NOTE on FRAGILITY (also a diagnostic): the miscompile is suppressed by surrounding
// code — adding a SECOND store loop that uses the HOISTED form (let v=pb[j]; ...), or
// extra standalone pb[k]/farr_get reads after the loop, makes the FIRST loop compile
// correctly. Keep this repro to the single buggy loop ONLY or it stops reproducing.
fn main() {
    let pb = [84, 104, 110]            // int literal -> i64-specialized array backing
    let a = farr_zeros(3)
    let mut i = 0
    while i < 3 { let _ = farr_set(a, i, to_float(pb[i])); i = i + 1 }   // <- stores 0 (BUG)
    let mut s = ""
    let mut t = 0
    while t < 3 { s = s + to_string(to_int(farr_get(a, t))) + " " t = t + 1 }
    println("BUGONLY " + s)
}
// FIX (apply at the call site): hoist the subscript out of the store value-arg:
//   while i < 3 { let v = pb[i]; let _ = farr_set(a, i, to_float(v)); i = i + 1 }  // 84 104 110
