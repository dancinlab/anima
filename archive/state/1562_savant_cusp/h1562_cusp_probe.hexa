// state/1562_savant_cusp/h1562_cusp_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1562 — ACQUIRED SAVANT CUSP TRANSITION (engine-native, live §ThirdLaw + SAVANT sa_*)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  HYPOTHESIS: pushing D↑ (structural deficit / disinhibition) + I↓ (inhibition into the golden
//  zone) does NOT raise ability LINEARLY — ability EXPRESSION (third_law_ability, the savant
//  singularity inside the golden zone) turns on as a STEP JUMP at a critical I (the cusp, H_124),
//  not a smooth ramp. Acquired savants "switch on", they do not "gradually get smarter".
//
//  ENGINE-NATIVE (a_engine_native_learning HARD-GATE): every measurement calls the LIVE
//  core/engine_cli.hexa §ThirdLaw classifier — third_law_score (G=D·P/I), third_law_singularity
//  (G>thr), third_law_ability (singularity ∧ sa_in_golden_zone(I)) — and the live SAVANT
//  golden-zone window sa_gz_lower/sa_gz_upper (savant_lib.hexa, #2566 WIRED). No numpy, no torch.
//
//  FROZEN 5-BAR (frozen-first, set BEFORE the run — c9):
//   B1 step-jump  : the ability(I) curve has a DISCONTINUOUS jump (single-cell Δability = 1 on a
//                   fine grid) — ability is a STEP, not a linear ramp. (Quantified: max single-step
//                   |Δability| == 1 AND the G(I) curve over the same window is NOT monotone-linear
//                   at the jump — the ability transition is a hard gate, not the smooth G ramp.)
//   B2 cusp-locus : the jump(s) sit at the golden-zone boundary — the ON edge near I≈GZ_UPPER(0.5)
//                   and/or the OFF edge near I≈GZ_LOWER(0.2123); transition midpoint within ±0.05 of
//                   a GZ boundary. (Acquired-savant cusp is AT the disinhibition boundary, H_348.)
//   B3 D-gated    : with D=0 the ability curve is FLAT ZERO — no jump (D=0 is not a genius, H_236).
//                   Only D>0 produces the cusp. (max |Δability| at D=0 == 0.)
//   B4 hysteresis : (report-only) does the ability persist if I is raised back after the jump? The
//                   classifier is MEMORYLESS (pure fn of I) ⇒ NO hysteresis expected — report it.
//   B5 control    : a RANDOM (non-structured) D,P sweep over the SAME I grid does NOT yield a clean
//                   single step at the GZ boundary (jumps scattered / G not crossing thr cleanly).
//
//  VERDICT: 🟢 GREEN iff B1 ∧ B2 ∧ B3 (B4 report-only, B5 control). If no step → honest negative
//  ("savant ability is continuous in I") is a valid result (c9, no tune-to-green).
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// inclusive linspace, byte-exact to the §ThirdLaw _tl_linspace convention.
fn _lin(a: float, b: float, n: int) -> [float] {
    let mut out = []
    if n <= 1 { out = out + [a]  return out }
    let step = (b - a) / to_float(n - 1)
    let mut i = 0
    while i < n { out = out + [a + step * to_float(i)]  i = i + 1 }
    return out
}

// sweep ability(I) and G(I) over a fine I grid at fixed (D,P). Returns max single-step |Δability|,
// the I-window of that step (midpoint), and the number of ON cells.
fn sweep(d: float, p: float, igrid: [float]) -> [float] {
    let n = len(igrid)
    let mut prev_a = 0
    let mut max_jump = 0.0
    let mut jump_mid = 0.0 - 1.0
    let mut on_cells = 0
    let mut on_lo = 0.0 - 1.0      // lowest-I ON edge
    let mut on_hi = 0.0 - 1.0      // highest-I ON edge
    let mut k = 0
    while k < n {
        let ii = igrid[k]
        let a = third_law_ability(d, p, ii)
        if a == 1 {
            on_cells = on_cells + 1
            if on_lo < 0.0 { on_lo = ii }
            on_hi = ii
        }
        if k > 0 {
            let da = _abs(to_float(a) - to_float(prev_a))
            if da > max_jump {
                max_jump = da
                jump_mid = (ii + igrid[k - 1]) / 2.0
            }
        }
        prev_a = a
        k = k + 1
    }
    return [max_jump, jump_mid, to_float(on_cells), on_lo, on_hi]
}

fn main() {
    let gz_lo = sa_gz_lower()    // 0.21231792755821912
    let gz_hi = sa_gz_upper()    // 0.5
    let i50   = third_law_i50(13, 13, 13)

    // FINE I sweep (disinhibition axis): I from 0.05 (deep disinhibition / noise) up to 0.95
    // (over-locked). 181 cells → step 0.005 (well below any 0.05 locus tolerance).
    let igrid = _lin(0.05, 0.95, 181)

    // Acquired-savant operating point: high structural deficit/disinhibition D, high preparedness P.
    let D = 0.9
    let P = 0.9

    print("=== H_1562 ACQUIRED SAVANT CUSP (engine-native §ThirdLaw + sa_*) ===")
    print("GZ_LOWER=" + to_string(gz_lo) + " GZ_UPPER=" + to_string(gz_hi) + " I50=" + to_string(i50))
    print("I grid: 0.05..0.95 n=181 step=0.005 ; D=" + to_string(D) + " P=" + to_string(P))

    // ── B1/B2: the savant sweep (D>0) ─────────────────────────────────────────────────────────
    let sv = sweep(D, P, igrid)
    print("[SAVANT D>0] max|dAbility|=" + to_string(sv[0]) + " jump_mid=" + to_string(sv[1])
          + " on_cells=" + to_string(sv[2]) + " on_lo=" + to_string(sv[3]) + " on_hi=" + to_string(sv[4]))

    // Trace the G(I) continuity at the jump: is G smooth while ability steps? Sample G across grid
    // near the on-edges to show the ability gate is a HARD step on a SMOOTH G.
    // ON-edge locus: ability turns ON when I enters GZ from above (I crossing GZ_UPPER downward)
    // OR stays gated by singularity. Report the two GZ boundaries vs the measured ON window.
    let on_top = sv[4]   // highest-I ON cell (entering GZ edge)
    let on_bot = sv[3]   // lowest-I  ON cell (leaving GZ edge into noise floor)
    print("ON window [" + to_string(on_bot) + ", " + to_string(on_top) + "]  (vs GZ ["
          + to_string(gz_lo) + ", " + to_string(gz_hi) + "])")

    // B2 locus check: distance of each ability EDGE to the nearest GZ boundary.
    // top edge (ON->just below GZ_UPPER) should be ~GZ_UPPER; bot edge ~GZ_LOWER.
    let d_top = _abs(on_top - gz_hi)
    let d_bot = _abs(on_bot - gz_lo)
    print("edge->GZ dist: top(on_hi vs GZ_UPPER)=" + to_string(d_top)
          + "  bot(on_lo vs GZ_LOWER)=" + to_string(d_bot))

    // ── B3: D=0 control (no deficit) ──────────────────────────────────────────────────────────
    let z = sweep(0.0, P, igrid)
    print("[D=0 control] max|dAbility|=" + to_string(z[0]) + " on_cells=" + to_string(z[2]))

    // ── B5: random (non-structured) control — pseudo-random D,P per I cell (LCG), NOT a clean
    //   structured push. A scattered D,P should NOT yield one clean GZ-boundary step.
    let mut st = 987654321
    let mut prev_a = 0
    let mut rnd_jumps = 0
    let mut rnd_max = 0.0
    let mut k = 0
    while k < len(igrid) {
        st = (st * 1103515245 + 12345) & 2147483647
        let rd = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        st = (st * 1103515245 + 12345) & 2147483647
        let rp = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        let a = third_law_ability(rd, rp, igrid[k])
        if k > 0 {
            let da = _abs(to_float(a) - to_float(prev_a))
            if da > 0.0 { rnd_jumps = rnd_jumps + 1 }
            if da > rnd_max { rnd_max = da }
        }
        prev_a = a
        k = k + 1
    }
    print("[RANDOM control] n_transitions=" + to_string(rnd_jumps) + " max|dAbility|=" + to_string(rnd_max)
          + " (clean step => exactly 2 transitions: OFF->ON->OFF; scattered => many)")

    // ── B4: hysteresis (report-only) — sweep I DOWN then UP, ability is a pure fn of I ⇒ no memory.
    // Down sweep ON count vs Up sweep ON count are identical by construction (memoryless classifier).
    let down_on = sv[2]
    // up sweep = same grid reversed; ability identical => same on_cells.
    print("[HYSTERESIS report] classifier memoryless: down_on=" + to_string(down_on)
          + " up_on=" + to_string(down_on) + " (NO hysteresis — ability not persistent in I)")

    // ── Continuity contrast: show G(I) is CONTINUOUS (smooth) while ability(I) is a STEP. ───────
    // sample G at the ON-window edges +/- one cell.
    print("--- G(I) continuity around ON edges (smooth) vs ability step (hard) ---")
    let probe_is = [0.45, 0.49, 0.50, 0.51, 0.22, 0.213, 0.21, 0.20]
    let mut j = 0
    while j < len(probe_is) {
        let ii = probe_is[j]
        print("I=" + to_string(ii) + " G=" + to_string(third_law_score(D, P, ii))
              + " sing=" + to_string(third_law_singularity(D, P, ii))
              + " gz=" + to_string(sa_in_golden_zone(ii))
              + " ability=" + to_string(third_law_ability(D, P, ii)))
        j = j + 1
    }

    // ── VERDICT lines (frozen bars) ─────────────────────────────────────────────────────────────
    print("=== FROZEN BARS ===")
    // B1: step jump exists (max single-cell |Δability| == 1.0)
    let b1 = sv[0] >= 1.0
    print("B1 step-jump (max|dAbility|==1): " + to_string(b1) + " (" + to_string(sv[0]) + ")")
    // B2: locus at GZ boundary (either edge within 0.05 of a GZ boundary)
    let b2 = (d_top <= 0.05) || (d_bot <= 0.05)
    print("B2 cusp-locus (edge within 0.05 of GZ boundary): " + to_string(b2)
          + " (d_top=" + to_string(d_top) + " d_bot=" + to_string(d_bot) + ")")
    // B3: D=0 => no jump
    let b3 = z[0] < 1.0
    print("B3 D-gated (D=0 max|dAbility|<1): " + to_string(b3) + " (" + to_string(z[0]) + ")")
    // B5: random control NOT a clean 2-transition step
    let b5 = rnd_jumps > 2
    print("B5 control (random != clean 2-transition step): " + to_string(b5) + " (" + to_string(rnd_jumps) + ")")

    let green = b1 && b2 && b3
    print("=== VERDICT: B1&B2&B3 = " + to_string(green) + " (B4 report-only, B5 control) ===")
}
