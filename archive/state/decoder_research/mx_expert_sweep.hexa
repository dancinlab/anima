// mx_expert_sweep.hexa — DECODER micro-exp: EXPERT-COUNT (E) axis sweep.
//
// HYPOTHESIS H_DEC_EXPERT_AXIS: the production MoE mode-collapse (#1296 / #1315:
// E=2 experts, hard top-1 routing, d=64, V=151643 -> decode collapsed to a single
// expert + single token) is sometimes blamed on "too few experts". This toy asks
// the ROUTING-side question the prior routing-FREE toy (mx_capacity_cliff.hexa)
// could NOT: at fixed (d, V, training budget), does increasing the expert count
// E (1 -> 2 -> 4 -> 8) reduce collapse, or does the router just collapse to ONE
// expert regardless of E (winner-take-all), confirming routing is NOT the lever?
//
// MECHANISM-ISOLATING TOY (a minimal top-1 hard-routed MoE successor LM):
//   token k -> z = Emb[k] (d)
//     gate[e]   = softmax( W_router[e] . z )          (E experts)
//     top       = argmax(gate)                          (top-1 hard route)
//     logits[c] = gate[top] * ( expert[top][c] . z )    (winner emits, gated)
//     target    = (k+1) % V                             (successor permutation)
//   CE loss + hand-written backward mirroring v3_moe_bwd (top-1: only the winner
//   expert + the gate row receive gradient; router softmax bwd is top-only).
//
// A capable model learns the successor permutation -> decode visits all V tokens
// (distinct == V) = ESCAPE. A collapsed model decodes to ~1 token = COLLAPSE.
// We also report distinct_experts_used + per-expert routing fraction f_e (load
// balance) to see whether more experts share the load or the router monopolizes.
//
// $0 mac/pool-local, hexa-native. toy-only: validates the routing MECHANISM at
// toy scale; production transfer (#1315 E=2 at V=151643) needs a real fire
// (toy-scale-transfer principle — distinct_experts is a toy mechanism observation,
// transfer-unverified).

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"

// CE loss + grad into d_logits (= softmax(logits) - onehot(target)); returns CE.
// (reused verbatim from mx_capacity_cliff.hexa)
fn ce_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        let lv = farr_get(logits, i)
        if lv > mx { mx = lv }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = dt_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - dt_ln(p_tgt + 0.000000001)
    let mut k = 0
    while k < V {
        let p = farr_get(d_logits_out, k) / tot
        let onehot = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, p - onehot)
        k = k + 1
    }
    return ce
}

// argmax over n
fn argmax_n(a: int, n: int) -> int {
    let mut top = 0
    let mut tv = farr_get(a, 0)
    let mut c = 1
    while c < n {
        let lv = farr_get(a, c)
        if lv > tv { tv = lv; top = c }
        c = c + 1
    }
    return top
}

// router gate forward: gate_out[E] = softmax( Router[e].z ), returns top = argmax.
//   Router layout: Router[e*d + j]   (E rows of d)
fn gate_fwd(Router: int, z: int, E: int, d: int, gate_out: int) -> int {
    let mut e = 0
    while e < E {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(Router, e * d + j) * farr_get(z, j)
            j = j + 1
        }
        let _ = farr_set(gate_out, e, acc)
        e = e + 1
    }
    // softmax (stable: subtract max)
    let mut gmax = farr_get(gate_out, 0)
    let mut e2 = 1
    while e2 < E {
        let gv = farr_get(gate_out, e2)
        if gv > gmax { gmax = gv }
        e2 = e2 + 1
    }
    let mut zsum = 0.0
    let mut e3 = 0
    while e3 < E {
        let ev = dt_exp(farr_get(gate_out, e3) - gmax)
        let _ = farr_set(gate_out, e3, ev)
        zsum = zsum + ev
        e3 = e3 + 1
    }
    let mut e4 = 0
    while e4 < E {
        let _ = farr_set(gate_out, e4, farr_get(gate_out, e4) / zsum)
        e4 = e4 + 1
    }
    return argmax_n(gate_out, E)
}

// expert head forward (winner only): logits[c] = g_top * sum_j Expert[top][c,j]*z[j]
//   Experts layout: Experts[top*V*d + c*d + j]
fn expert_fwd(Experts: int, z: int, top: int, g_top: float, V: int, d: int, logits_out: int) {
    let exp_base = top * V * d
    let mut c = 0
    while c < V {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(Experts, exp_base + c * d + j) * farr_get(z, j)
            j = j + 1
        }
        let _ = farr_set(logits_out, c, g_top * acc)
        c = c + 1
    }
}

// one MoE trial: V tokens, dim d, E experts, successor task target=(k+1)%V.
// Returns nothing directly — fills out[0]=distinct_decoded, out[1]=distinct_experts;
// out[2..2+E] = per-expert routing fraction (decode-time) scaled x1000 (int).
fn moe_trial(d: int, V: int, E: int, n_steps: int, lr: float, out: int) {
    let emb_n = V * d
    let router_n = E * d
    let experts_n = E * V * d
    let Emb = t_zeros(emb_n)
    let Router = t_zeros(router_n)
    let Experts = t_zeros(experts_n)
    // deterministic small init (decorrelated triangular wave, distinct phase per matrix).
    let mut ii = 0
    while ii < emb_n {
        let s = (ii * 7 + 3) % 17
        let _ = farr_set(Emb, ii, 0.05 * (to_float(s) - 8.0))
        ii = ii + 1
    }
    ii = 0
    while ii < router_n {
        // break inter-expert symmetry: include expert index in the phase so each
        // router row starts distinct (else identical rows -> argmax ties to e=0).
        let s = (ii * 13 + 7) % 23
        let _ = farr_set(Router, ii, 0.05 * (to_float(s) - 11.0))
        ii = ii + 1
    }
    ii = 0
    while ii < experts_n {
        let s = (ii * 11 + 5) % 19
        let _ = farr_set(Experts, ii, 0.05 * (to_float(s) - 9.0))
        ii = ii + 1
    }
    let logits = t_zeros(V)
    let d_logits = t_zeros(V)
    let gate = t_zeros(E)
    let d_z = t_zeros(d)
    let mut step = 0
    while step < n_steps {
        let mut k = 0
        while k < V {
            let target = (k + 1) % V
            let z_off = k * d
            // z = Emb[k] (read via offset directly). Pack a small z view.
            let z = t_zeros(d)
            let mut jz0 = 0
            while jz0 < d {
                let _ = farr_set(z, jz0, farr_get(Emb, z_off + jz0))
                jz0 = jz0 + 1
            }
            // ── forward ──
            let top = gate_fwd(Router, z, E, d, gate)
            let g_top = farr_get(gate, top)
            expert_fwd(Experts, z, top, g_top, V, d, logits)
            let _ = ce_grad(logits, target, V, d_logits)
            // ── backward (mirror v3_moe_bwd top-1) ──
            // dl_scaled[c] = d_logits[c]*g_top
            // d_expert[top][c,j] += dl_scaled[c]*z[j] ; d_z += expert_top^T @ dl_scaled
            // d_g_top = sum_c d_logits[c]*(expert_top.z)[c] = dot(d_logits, logits/g_top)
            let mut jr = 0
            while jr < d {
                let _ = farr_set(d_z, jr, 0.0)
                jr = jr + 1
            }
            let exp_base = top * V * d
            let mut d_g_top = 0.0
            let mut c = 0
            while c < V {
                let dl = farr_get(d_logits, c)
                let dl_sc = dl * g_top
                // logits_raw[c] = (expert_top.z)[c] = logits[c]/g_top (recompute clean)
                let mut raw = 0.0
                let mut j = 0
                while j < d {
                    let w = farr_get(Experts, exp_base + c * d + j)
                    raw = raw + w * farr_get(z, j)
                    // accumulate d_z using pre-update weight
                    let dzp = farr_get(d_z, j)
                    let _ = farr_set(d_z, j, dzp + dl_sc * w)
                    // expert update: W -= lr * dl_sc * z[j]
                    let _ = farr_set(Experts, exp_base + c * d + j, w - lr * dl_sc * farr_get(z, j))
                    j = j + 1
                }
                d_g_top = d_g_top + dl * raw
                c = c + 1
            }
            // softmax bwd on top-only:
            //   d_gate_raw[e] = gate[e] * d_g_top * ([e==top] - gate[top])
            // router update: Router[e,j] -= lr * d_gate_raw[e]*z[j]
            // d_z += d_gate_raw[e]*Router[e,j]
            let mut e = 0
            while e < E {
                let ge = farr_get(gate, e)
                let mut d_raw = 0.0 - ge * g_top * d_g_top
                if e == top { d_raw = d_raw + ge * d_g_top }
                let mut j = 0
                while j < d {
                    let rprev = farr_get(Router, e * d + j)
                    // accumulate d_z (pre-update router row)
                    let dzp = farr_get(d_z, j)
                    let _ = farr_set(d_z, j, dzp + d_raw * rprev)
                    let _ = farr_set(Router, e * d + j, rprev - lr * d_raw * farr_get(z, j))
                    j = j + 1
                }
                e = e + 1
            }
            // Emb[k] update from d_z
            let mut j2 = 0
            while j2 < d {
                let eprev = farr_get(Emb, z_off + j2)
                let _ = farr_set(Emb, z_off + j2, eprev - lr * farr_get(d_z, j2))
                j2 = j2 + 1
            }
            let _ = farr_free(z)
            k = k + 1
        }
        step = step + 1
    }
    // ── decode: for each context k, route + argmax; count distinct tokens +
    //    distinct experts + per-expert routing fraction (load balance) ──
    let seen = t_zeros(V)
    let exp_count = t_zeros(E)
    let z2 = t_zeros(d)
    let mut k2 = 0
    while k2 < V {
        let z_off = k2 * d
        let mut jz = 0
        while jz < d {
            let _ = farr_set(z2, jz, farr_get(Emb, z_off + jz))
            jz = jz + 1
        }
        let top = gate_fwd(Router, z2, E, d, gate)
        let g_top = farr_get(gate, top)
        let _ = farr_set(exp_count, top, farr_get(exp_count, top) + 1.0)
        expert_fwd(Experts, z2, top, g_top, V, d, logits)
        let dec = argmax_n(logits, V)
        let _ = farr_set(seen, dec, 1.0)
        k2 = k2 + 1
    }
    let mut distinct = 0
    let mut s2 = 0
    while s2 < V {
        if farr_get(seen, s2) > 0.5 { distinct = distinct + 1 }
        s2 = s2 + 1
    }
    let mut distinct_exp = 0
    let mut e2 = 0
    while e2 < E {
        if farr_get(exp_count, e2) > 0.5 { distinct_exp = distinct_exp + 1 }
        e2 = e2 + 1
    }
    let _ = farr_set(out, 0, to_float(distinct))
    let _ = farr_set(out, 1, to_float(distinct_exp))
    // per-expert fraction x1000 (so we can print integer permille)
    let mut e3 = 0
    while e3 < E {
        let frac = farr_get(exp_count, e3) / to_float(V)
        let _ = farr_set(out, 2 + e3, frac * 1000.0)
        e3 = e3 + 1
    }
    let _ = farr_free(Emb)
    let _ = farr_free(Router)
    let _ = farr_free(Experts)
    let _ = farr_free(logits)
    let _ = farr_free(d_logits)
    let _ = farr_free(gate)
    let _ = farr_free(d_z)
    let _ = farr_free(seen)
    let _ = farr_free(exp_count)
    let _ = farr_free(z2)
}

fn main() {
    println("=== mx_expert_sweep — EXPERT-COUNT (E) axis · top-1 hard-routed MoE successor LM ===")
    println("  task: k -> (k+1)%V · 150 epochs · grid d x V x E · top-1 routing")
    println("  cols: distinct_decoded/V [ESCAPE if ==V else COLLAPSE] · distinct_experts/E · f_e permille(/1000)")
    let lr = 0.5
    let n_steps = 150
    let ds = [8, 16]
    let vs = [32, 64]
    let es = [1, 2, 4, 8]
    let out = t_zeros(2 + 8)   // out[0]=distinct, out[1]=distinct_exp, out[2..2+E]=f_e permille
    let mut di = 0
    while di < 2 {
        let d = ds[di]
        let mut vi = 0
        while vi < 2 {
            let V = vs[vi]
            let mut ei = 0
            while ei < 4 {
                let E = es[ei]
                moe_trial(d, V, E, n_steps, lr, out)
                let distinct = to_int(farr_get(out, 0))
                let distinct_exp = to_int(farr_get(out, 1))
                print("d=") ; print(d) ; print(" V=") ; print(V) ; print(" E=") ; print(E)
                print(" | decoded=") ; print(distinct) ; print("/") ; print(V)
                if distinct == V { print(" [ESCAPE]") } else { print(" [COLLAPSE]") }
                print(" | experts_used=") ; print(distinct_exp) ; print("/") ; print(E)
                print(" | f_e(permille)=[")
                let mut pe = 0
                while pe < E {
                    print(to_int(farr_get(out, 2 + pe)))
                    if pe < E - 1 { print(",") }
                    pe = pe + 1
                }
                println("]")
                ei = ei + 1
            }
            vi = vi + 1
        }
        di = di + 1
    }
    println("=== done — E-axis: compare [ESCAPE]/[COLLAPSE] across E at fixed d,V; experts_used reveals winner-take-all ===")
}
