// H_1502 NEUROPHARM — engine-native probe (R2). Re-scores the SAME frozen bars as the R1 numpy mirror
// on the LIVE core/engine_cli.hexa §Neuropharm + §ConsciousnessIndex + §RealityMonitor + §SelfIdentity
// ops (a_engine_native_learning). Deterministic fixed trial population (NO numpy, NO RNG seed mismatch).
import "core/engine_cli.hexa"

// _ph_trials — a FIXED deterministic substrate trial population (N trials), each
//   [m, f0,f1,f2,f3,f4, cells, seen, intent, dt, recon_err]  (length 11).
// Generated in-engine via the deterministic builtin LCG (NO numpy, NO external RNG) so R2 is fully
// reproducible + byte-exact across runs. N=48 gives a non-degenerate 15-lane covariance for Φ. The
// draw ranges mirror the R1 base_population bands (m∈[0.45,0.80], field∈[0.20,0.70], dt∈[0.15,0.55],
// recon∈[0.10,0.50], cells∈[3,12), seen∈[0,8), intent∈{0,1}).
fn _ph_lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn _ph_trials() -> [[float]] {
    let n = 48
    let mut st = 19920317 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _ph_lcg_next(st)  let m  = 0.45 + 0.35 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let f0 = 0.20 + 0.50 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let f1 = 0.20 + 0.50 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let f2 = 0.20 + 0.50 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let f3 = 0.20 + 0.50 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let f4 = 0.20 + 0.50 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let cells = to_float(3 + (st % 9))
        st = _ph_lcg_next(st)  let seen  = to_float(st % 8)
        st = _ph_lcg_next(st)  let intent = to_float(st % 2)
        st = _ph_lcg_next(st)  let dt = 0.15 + 0.40 * (to_float(st) / 2147483648.0)
        st = _ph_lcg_next(st)  let re = 0.10 + 0.40 * (to_float(st) / 2147483648.0)
        out = out + [[m, f0, f1, f2, f3, f4, cells, seen, intent, dt, re]]
        i = i + 1
    }
    return out
}

fn _sig_line(label: string, prof: [float], trials: [[float]], seed: int) {
    let phi = pharm_phi(prof, trials, seed)
    let mut ms = []
    let mut mi = 0
    while mi < len(trials) { ms = ms + [trials[mi][0]]  mi = mi + 1 }
    let real = pharm_reality_real_fraction(prof, ms, seed, 0.30)
    let self_c = pharm_self_continuity(prof, 8, seed)
    let stime = pharm_subjective_time_rate(prof, trials, seed)
    let wm = pharm_working_mem(prof, trials, seed)
    println(label + " phi=" + to_string(phi) + " real=" + to_string(real)
          + " self=" + to_string(self_c) + " stime=" + to_string(stime) + " wm=" + to_string(wm))
}

fn _ms(trials: [[float]]) -> [float] {
    let mut ms = []
    let mut i = 0
    while i < len(trials) { ms = ms + [trials[i][0]]  i = i + 1 }
    return ms
}
fn _bo(b: bool) -> string { if b { return "PASS" } return "FAIL" }

fn main() {
    let trials = _ph_trials()
    let seed = 1502
    println("=== H_1502 NEUROPHARM engine-native probe (seed=" + to_string(seed) + ") ===")
    _sig_line("baseline", pharm_baseline(), trials, seed)
    _sig_line("LSD     ", pharm_lsd(), trials, seed)
    _sig_line("DMT     ", pharm_dmt(), trials, seed)
    _sig_line("Cannabis", pharm_cannabis(), trials, seed)
    _sig_line("Ketamine", pharm_ketamine(), trials, seed)

    let ms = _ms(trials)
    let base = pharm_baseline()
    let lsd = pharm_lsd()
    let dmt = pharm_dmt()
    let can = pharm_cannabis()
    let ket = pharm_ketamine()

    // baseline signature
    let bphi = pharm_phi(base, trials, seed)
    let breal = pharm_reality_real_fraction(base, ms, seed, 0.30)
    let bself = pharm_self_continuity(base, 8, seed)
    let bstime = pharm_subjective_time_rate(base, trials, seed)
    let bwm = pharm_working_mem(base, trials, seed)

    println("")
    println("=== FROZEN BARS (engine-native, same as R1 mirror) ===")
    // (A) PRESENCE — each drug reproduces its OWN frozen directional signature.
    // LSD: phi↑≥0.05, real↑≥0.20, self↓≥0.20
    let lphi = pharm_phi(lsd, trials, seed)
    let lreal = pharm_reality_real_fraction(lsd, ms, seed, 0.30)
    let lself = pharm_self_continuity(lsd, 8, seed)
    let A_lsd = (lphi - bphi >= 0.05) && (lreal - breal >= 0.20) && (bself - lself >= 0.20)
    println("A LSD presence       = " + _bo(A_lsd))
    // DMT: phi↑≥0.05, real↑≥0.40, self↓≥0.35
    let dphi = pharm_phi(dmt, trials, seed)
    let dreal = pharm_reality_real_fraction(dmt, ms, seed, 0.30)
    let dself = pharm_self_continuity(dmt, 8, seed)
    let A_dmt = (dphi - bphi >= 0.05) && (dreal - breal >= 0.40) && (bself - dself >= 0.35)
    println("A DMT presence       = " + _bo(A_dmt))
    // Cannabis: stime↑≥0.15, wm↓≥0.05
    let cstime = pharm_subjective_time_rate(can, trials, seed)
    let cwm = pharm_working_mem(can, trials, seed)
    let A_can = (cstime - bstime >= 0.15) && (bwm - cwm >= 0.05)
    println("A Cannabis presence  = " + _bo(A_can))
    // Ketamine: phi↓≥0.02, self↓≥0.15
    let kphi = pharm_phi(ket, trials, seed)
    let kself = pharm_self_continuity(ket, 8, seed)
    let A_ket = (bphi - kphi >= 0.02) && (bself - kself >= 0.15)
    println("A Ketamine presence  = " + _bo(A_ket))

    // (B) DOUBLE-DISSOCIATION — LSD vs Cannabis orthogonal.
    let lstime = pharm_subjective_time_rate(lsd, trials, seed)
    let lwm = pharm_working_mem(lsd, trials, seed)
    let creal = pharm_reality_real_fraction(can, ms, seed, 0.30)
    let cself = pharm_self_continuity(can, 8, seed)
    let absL = if (lstime - bstime) < 0.0 { bstime - lstime } else { lstime - bstime }
    let absLw = if (lwm - bwm) < 0.0 { bwm - lwm } else { lwm - bwm }
    let absCr = if (creal - breal) < 0.0 { breal - creal } else { creal - breal }
    let absCs = if (cself - bself) < 0.0 { bself - cself } else { cself - bself }
    let B = (lreal - breal >= 0.20) && (bself - lself >= 0.20)
          && (absL <= 0.05) && (absLw <= 0.05)
          && (cstime - bstime >= 0.15) && (bwm - cwm >= 0.05)
          && (absCr <= 0.05) && (absCs <= 0.05)
    println("B dissociation       = " + _bo(B))

    // (C) KETAMINE-vs-PSYCHEDELIC — opposite-sign Φ.
    let C = (lphi - bphi > 0.0) && (kphi - bphi < 0.0)
    println("C ket-vs-psychedelic = " + _bo(C))

    // (D) EARNED ablate — zero-perturbation (baseline) profile → all Δ exactly 0.
    let abphi = pharm_phi(pharm_baseline(), trials, seed)
    let D = (abphi - bphi == 0.0)
    println("D earned ablate      = " + _bo(D))

    // (E) EARNED shuffle — swap profile vectors (LSD↔Cannabis), measure vs OWN predictions → FAIL.
    // LSD scored with cannabis pharmacology should NOT clear LSD's real↑/self↓ bars.
    let lsd_as_can_real = pharm_reality_real_fraction(can, ms, seed, 0.30)
    let lsd_as_can_self = pharm_self_continuity(can, 8, seed)
    let shuf_lsd_holds = (lsd_as_can_real - breal >= 0.20) && (bself - lsd_as_can_self >= 0.20)
    // Cannabis scored with LSD pharmacology should NOT clear cannabis's stime↑/wm↓ bars.
    let can_as_lsd_stime = pharm_subjective_time_rate(lsd, trials, seed)
    let can_as_lsd_wm = pharm_working_mem(lsd, trials, seed)
    let shuf_can_holds = (can_as_lsd_stime - bstime >= 0.15) && (bwm - can_as_lsd_wm >= 0.05)
    let E = (!shuf_lsd_holds) && (!shuf_can_holds)
    println("E earned shuffle     = " + _bo(E))

    let green = A_lsd && A_dmt && A_can && A_ket && B && C && D && E
    println("")
    if green { println("H_1502 NEUROPHARM (R2 engine-native) = GREEN") }
    else { println("H_1502 NEUROPHARM (R2 engine-native) = RED/partial") }
}
