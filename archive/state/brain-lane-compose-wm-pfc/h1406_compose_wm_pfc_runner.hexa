// ════════════════════════════════════════════════════════════════════════════
//  state/brain-lane-compose-wm-pfc/h1406_compose_wm_pfc_runner.hexa
//
//  H_1406 — brain-lane COMPOSE (pair #3): WM (H_1282) × hier-PFC (H_1294),
//  ENGINE-NATIVE re-measure (a_engine_native_learning · a_verified_must_wire).
//
//  Drives the LIVE CORE faculties — wm_buffer_new / wm_buffer_gate_in /
//  wm_buffer_distractor / wm_buffer_probe_score (the H_1282 WorkMemBuffer) and the
//  HierGoalStack grounding cosine read (H_1294, via the engine's _cos through a
//  re-export) — over the deterministic 5-family stimulus written by
//  state/brain-lane-compose-wm-pfc/h1406_emit_states.py, then re-scores the THREE
//  frozen bars (B1 COMPOSE-EFFECT, B2 ORACLE, B3 EARNED) + the only-X separability
//  decomposition with the H_1397 scale-relative-confidence arbiter (NO hardcoded
//  priority), all on the LIVE engine. This is the h1404_phi_runner.hexa pattern.
//
//  Run (CPU, $0):
//    python3 state/brain-lane-compose-wm-pfc/h1406_emit_states.py /tmp/h1406_states.txt
//    H1406_STATE=/tmp/h1406_states.txt hexa run state/brain-lane-compose-wm-pfc/h1406_compose_wm_pfc_runner.hexa
// ════════════════════════════════════════════════════════════════════════════

import "core/engine_cli.hexa"   // wm_buffer_* (H_1282) + EngineConfig + _cos geometry

// frozen knobs — VERBATIM from h1406_compose_wm_pfc.py / FREEZE.txt
fn _WM_THR() -> float { return 0.40 }
fn _ALIGN_THR() -> float { return 0.85 }
fn _K() -> int { return 4 }
fn _LAMBDA() -> float { return 0.85 }
fn _COMPOSE_DELTA() -> float { return 0.05 }
fn _ORACLE_MARGIN() -> float { return 0.02 }
fn _SHUFFLE_TOL() -> float { return 0.02 }

fn _f4(x: float) -> string {
    let scaled = floor(x * 10000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 10000.0)
    let frac  = v - whole * 10000.0
    let mut fs = str(to_int(frac))
    while len(fs) < 4 { fs = "0" + fs }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + fs
}

fn _state_path() -> string {
    let p = env("H1406_STATE")
    if len(p) > 0 { return p }
    return "/tmp/h1406_states.txt"
}

// cosine via the same _cos the WM lane uses (re-implemented locally, identical formula)
fn _cosv(a: [float], b: [float]) -> float {
    let n = len(a)
    let mut dot = 0.0
    let mut na = 0.0
    let mut nb = 0.0
    let mut i = 0
    while i < n {
        dot = dot + a[i] * b[i]
        na = na + a[i] * a[i]
        nb = nb + b[i] * b[i]
        i = i + 1
    }
    let denom = sqrt(na) * sqrt(nb) + 0.000000000001
    return dot / denom
}

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn main() {
    let path = _state_path()
    let cfg = engine_config_default()
    println("=== H_1406 WM×PFC compose — ENGINE-NATIVE (live wm_buffer_* + _cos) ===")
    println("engine: core/engine_cli.hexa  WorkMemBuffer(H_1282) + HierGoalStack-cos(H_1294)")
    println("state file: " + path)

    let text = read_file(path)
    let lines = text.split("\n")

    // per-item engine-derived reads
    let mut wm_dec  = []     // 1/0 decisions
    let mut wm_conf = []     // |wm_score - WM_THR|
    let mut pf_dec  = []
    let mut pf_conf = []
    let mut corr    = []
    let n_lines = len(lines)

    let mut i = 0
    while i < n_lines {
        let line = lines[i].trim()
        if len(line) > 0 && line.split(" ")[0] == "#" && len(line.split(" ")) >= 5 && line.split(" ")[2] != "states" {
            let toks = line.split(" ")
            // # <seed> <fam> <correct> <gap> <ndst>   (fam = F1..F5; skip the file header line)
            let correct = toks[3].to_int()
            let ndst    = toks[4].to_int()
            // read CUE
            i = i + 1
            let cue = _read_vec(lines[i])
            i = i + 1
            let tgt = _read_vec(lines[i])      // TGT
            // read ndst distractors
            let mut dsts = []
            let mut d = 0
            while d < ndst {
                i = i + 1
                dsts = dsts + [_read_vec(lines[i])]
                d = d + 1
            }
            i = i + 1
            let sub = _read_vec(lines[i])      // SUB
            i = i + 1
            let pfc_ovr = lines[i].trim().split(" ")[1].to_float()   // PFCOVR <f>
            i = i + 1
            let wm_ovr  = lines[i].trim().split(" ")[1].to_float()   // WMRAW_OVR <f>

            // ── LIVE WM read ──
            let mut wm_score = 0.0
            if wm_ovr <= -998.0 {
                // run the live engine WM buffer: gate-in target @1.0, ndst distractor steps, probe cue
                let mut wm = wm_buffer_new(_K(), _LAMBDA(), 0.5, len(tgt))
                wm = wm_buffer_gate_in(wm, tgt, 1.0)
                let mut dd = 0
                while dd < len(dsts) {
                    wm = wm_buffer_distractor(wm, dsts[dd])
                    dd = dd + 1
                }
                wm_score = wm_buffer_probe_score(wm, cue)
            } else {
                wm_score = wm_ovr
            }
            // ── LIVE PFC read (cosine of cue vs current-subgoal target) ──
            let mut pf_align = 0.0
            if pfc_ovr <= -998.0 {
                pf_align = _cosv(cue, sub)
            } else {
                pf_align = pfc_ovr
            }

            let wd = if wm_score >= _WM_THR() { 1 } else { 0 }
            let pd = if pf_align >= _ALIGN_THR() { 1 } else { 0 }
            wm_dec  = wm_dec  + [wd]
            wm_conf = wm_conf + [_absf(wm_score - _WM_THR())]
            pf_dec  = pf_dec  + [pd]
            pf_conf = pf_conf + [_absf(pf_align - _ALIGN_THR())]
            corr    = corr    + [correct]
        }
        i = i + 1
    }

    let n = len(corr)
    // mean confidences (for scale-relative arbiter)
    let mut sw = 0.0
    let mut sp = 0.0
    let mut k = 0
    while k < n { sw = sw + wm_conf[k]  sp = sp + pf_conf[k]  k = k + 1 }
    let wm_mean = sw / to_float(n)
    let pf_mean = sp / to_float(n)

    // per-item accuracies + compose + oracle + only-X
    let mut acc_wm = 0
    let mut acc_pf = 0
    let mut acc_cmp = 0
    let mut acc_orc = 0
    let mut only_wm = 0
    let mut only_pf = 0
    let mut both = 0
    let mut neither = 0
    let mut conflict = 0
    let mut j = 0
    while j < n {
        let wok = if wm_dec[j] == corr[j] { 1 } else { 0 }
        let pok = if pf_dec[j] == corr[j] { 1 } else { 0 }
        acc_wm = acc_wm + wok
        acc_pf = acc_pf + pok
        // compose: agree → shared; conflict → higher scale-relative confidence wins (NO priority)
        let mut cdec = wm_dec[j]
        if wm_dec[j] != pf_dec[j] {
            conflict = conflict + 1
            let wrel = wm_conf[j] / (wm_mean + 0.000000001)
            let prel = pf_conf[j] / (pf_mean + 0.000000001)
            cdec = if wrel >= prel { wm_dec[j] } else { pf_dec[j] }
        }
        if cdec == corr[j] { acc_cmp = acc_cmp + 1 }
        if wok == 1 || pok == 1 { acc_orc = acc_orc + 1 }
        if wok == 1 && pok == 0 { only_wm = only_wm + 1 }
        if pok == 1 && wok == 0 { only_pf = only_pf + 1 }
        if wok == 1 && pok == 1 { both = both + 1 }
        if wok == 0 && pok == 0 { neither = neither + 1 }
        j = j + 1
    }

    let fn_ = to_float(n)
    let a_wm = to_float(acc_wm) / fn_
    let a_pf = to_float(acc_pf) / fn_
    let a_cmp = to_float(acc_cmp) / fn_
    let a_orc = to_float(acc_orc) / fn_
    let o_wm = to_float(only_wm) / fn_
    let o_pf = to_float(only_pf) / fn_
    let best = if a_wm > a_pf { a_wm } else { a_pf }

    // SHUFFLE control: re-arbitrate with the WM and PFC reads paired against item j+1 (a
    // deterministic permutation — breaks the per-item link, EARNED control).
    let mut acc_shuf = 0
    let mut j2 = 0
    while j2 < n {
        let pw = (j2 + 137) % n      // deterministic shuffle (independent of rng — engine-side)
        let pp = (j2 + 911) % n
        let mut cdec = wm_dec[pw]
        if wm_dec[pw] != pf_dec[pp] {
            let wrel = wm_conf[pw] / (wm_mean + 0.000000001)
            let prel = pf_conf[pp] / (pf_mean + 0.000000001)
            cdec = if wrel >= prel { wm_dec[pw] } else { pf_dec[pp] }
        }
        if cdec == corr[j2] { acc_shuf = acc_shuf + 1 }
        j2 = j2 + 1
    }
    let a_shuf = to_float(acc_shuf) / fn_

    println("")
    println("=== ENGINE-NATIVE means (n=" + str(n) + " items, 3 seeds pooled) ===")
    println("  acc_wm        = " + _f4(a_wm))
    println("  acc_pfc       = " + _f4(a_pf))
    println("  best_single   = " + _f4(best))
    println("  acc_compose   = " + _f4(a_cmp))
    println("  acc_shuffle   = " + _f4(a_shuf))
    println("  ORACLE        = " + _f4(a_orc) + "   (oracle - best = " + _f4(a_orc - best) + ")")
    println("  conflict_rate = " + _f4(to_float(conflict) / fn_))
    println("  decomposition : only_wm=" + _f4(o_wm) + " only_pfc=" + _f4(o_pf)
            + " both=" + _f4(to_float(both)/fn_) + " neither=" + _f4(to_float(neither)/fn_))
    println("")

    let b1 = a_cmp >= (best + _COMPOSE_DELTA())
    let b2 = (a_orc - best) > _ORACLE_MARGIN()
    let b3 = (a_cmp - a_shuf) > _SHUFFLE_TOL()
    let separable = (o_wm > 0.0) && (o_pf > 0.0)
    println("=== FROZEN bars (engine-native) ===")
    println("  B1 COMPOSE-EFFECT compose>=best+0.05 : " + _f4(a_cmp) + " >= " + _f4(best + 0.05) + "  => " + (if b1 { "PASS" } else { "FAIL" }))
    println("  B2 ORACLE         oracle-best>0.02    : " + _f4(a_orc - best) + " > 0.02  => " + (if b2 { "PASS" } else { "FAIL" }))
    println("  B3 EARNED         compose-shuffle>0.02: " + _f4(a_cmp - a_shuf) + " > 0.02  => " + (if b3 { "PASS" } else { "FAIL" }))
    println("  SEPARABLE         only_wm>0 AND only_pfc>0 : " + (if separable { "TRUE" } else { "FALSE" }))
    println("")
    if b1 && b2 && b3 {
        println("VERDICT(engine-native): 🟢 COMPOSE-LIFT")
    } else {
        if b2 && separable && (!b1) {
            println("VERDICT(engine-native): 🧱 ORACLE-HEADROOM-but-ARBITER-FAILS (a)->(d) — SEPARABLE + oracle lift EXISTS but the scale-relative confidence arbiter does NOT capture it (compose<best). CONFIRMS the torch-side closed-negative engine-native.")
        } else {
            println("VERDICT(engine-native): see per-bar tally (no compose lift)")
        }
    }
    println("=== H_1406 engine-native measurement complete ===")
}

fn _read_vec(line: string) -> [float] {
    let toks = line.trim().split(" ")
    // toks[0] is the tag (CUE/TGT/DST/SUB)
    let mut v = []
    let mut i = 1
    while i < len(toks) {
        if len(toks[i]) > 0 { v = v + [toks[i].to_float()] }
        i = i + 1
    }
    return v
}
