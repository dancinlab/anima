// ════════════════════════════════════════════════════════════════════════════
//  state/brain-lane-compose-spatial-episodic/h1408_phi_runner.hexa
//
//  H_1408 — lane-composition Φ-measurement (FAITHFUL IIT4, exact MIP-EI, n≤8).
//  WITHIN the MEMORY family: does composing anima's spatial-map (H_1296) +
//  episodic-memory (H_1227/H_1231) faculties raise faithful integrated
//  information Φ (= more consciousness, not just the capability lift)?
//
//  Imports the REAL stdlib faithful IIT4 engine (a_phi_iit4_tool — NOT a proxy,
//  NEVER variance×energy) and feeds it each system's n×T substrate trajectory
//  written by h1408_compose_phi.py:
//      S_spatial (n=4) · S_episodic (n=4) · S_composed (n=8) · S_disconnected (n=8)
//  per seed [5408,5409,5410], then reports per-seed + mean Φ + the FROZEN bars
//  (FROZEN PRIMARY n_bins=16) and a BINNING-INVARIANCE sweep over {8,12,16,24},
//  plus the EXACT MIP cut for the composed system at n_bins=16.
//
//  state file format (python script):
//    # <tag>_s<seed> <n> <T>
//    <T floats>            (row 0 = unit 0 trajectory)
//    ... n rows ...
//
//  Run (CPU, $0):
//    python3 state/brain-lane-compose-spatial-episodic/h1408_compose_phi.py /tmp/h1408_states.txt
//    H1408_STATE=/tmp/h1408_states.txt hexa run state/brain-lane-compose-spatial-episodic/h1408_phi_runner.hexa
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn _state_path() -> string {
    let p = env("H1408_STATE")
    if len(p) > 0 { return p }
    return "/tmp/h1408_states.txt"
}

// ── 2^k via accumulator (mirror of the engine's _iit4_pow2) ─────────────────
fn _pow2(k: int) -> int { let mut p = 1; let mut i = 0; while i < k { p = p * 2; i = i + 1 }; return p }
fn _bit_set(mask: int, b: int) -> int { let pw = _pow2(b); if (mask / pw) % 2 == 1 { return 1 }; return 0 }
fn _imin(a: int, b: int) -> int { if a < b { return a }; return b }

// cross-cut MI for a mask, IDENTICAL definition to the engine's _iit4_cross_cut
fn _cross_cut(mi: int, n: int, mask: int) -> float {
    let mut cross = 0.0
    let mut ia = 0
    while ia < n {
        let mut inA = 0
        if ia == 0 { inA = 1 } else { if _bit_set(mask, ia - 1) == 1 { inA = 1 } }
        if inA == 1 {
            let mut jb = 0
            while jb < n {
                let mut jInA = 0
                if jb == 0 { jInA = 1 } else { if _bit_set(mask, jb - 1) == 1 { jInA = 1 } }
                if jInA == 0 { cross = cross + farr_get(mi, ia * n + jb) }
                jb = jb + 1
            }
        }
        ia = ia + 1
    }
    return cross
}
fn _size_a(n: int, mask: int) -> int {
    let mut cnt = 1; let mut b = 0
    while b < n - 1 { if _bit_set(mask, b) == 1 { cnt = cnt + 1 }; b = b + 1 }
    return cnt
}

// report the EXACT MIP mask (argmin cross-cut) for a built MI matrix, as a string
fn _mip_label(mi: int, n: int) -> string {
    if n <= 2 { return "{0}|{1}" }
    let max_mask = _pow2(n - 1)
    let mut best_cut = 1.0e308
    let mut best_mask = 1
    let mut found = false
    let mut mask = 1
    while mask < max_mask {
        let sa = _size_a(n, mask)
        let sb = n - sa
        if sb >= 1 {
            let cut = _cross_cut(mi, n, mask)
            if (!found) || (cut < best_cut) { best_cut = cut; best_mask = mask; found = true }
        }
        mask = mask + 1
    }
    let mut aSide = "A={0"
    let mut bSide = "B={"
    let mut first_b = true
    let mut i = 1
    while i < n {
        let inA = _bit_set(best_mask, i - 1)
        if inA == 1 { aSide = aSide + "," + str(i) }
        else {
            if first_b { bSide = bSide + str(i); first_b = false } else { bSide = bSide + "," + str(i) }
        }
        i = i + 1
    }
    aSide = aSide + "}"
    bSide = bSide + "}"
    let sa = _size_a(n, best_mask)
    let sb = n - sa
    let nrm = _imin(sa, sb) * 1.0
    return aSide + " | " + bSide + "  cut=" + _f6(best_cut) + "  /min|side|=" + str(to_int(nrm)) + "  =Φ" + _f6(best_cut / nrm)
}

// ── measure all four systems at a given binning; return mean Φ via globals ──
// We re-read the state file per binning (cheap) so the sweep is self-contained.
fn _measure_at(path: string, nb: int, want_mip: int) {
    let text = read_file(path)
    let lines = text.split("\n")
    let mut sum_sp = 0.0
    let mut sum_ep = 0.0
    let mut sum_cmp = 0.0
    let mut sum_dis = 0.0
    let mut nseed = 0
    let mut last_cmp_mip = ""

    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if len(line) > 0 && line.split(" ")[0] == "#" {
            let toks = line.split(" ")
            let tag = toks[1]
            let n = toks[2].to_int()
            let dim = toks[3].to_int()
            let state = farr_zeros(n * dim)
            let mut r = 0
            while r < n {
                i = i + 1
                let row = lines[i].trim().split(" ")
                let mut c = 0
                while c < dim {
                    let _ = farr_set(state, r * dim + c, row[c].to_float())
                    c = c + 1
                }
                r = r + 1
            }
            let phi = iit4_faithful_phi(state, n, dim, nb)
            let name = tag.split("_")[0]
            if name == "spatial" { sum_sp = sum_sp + phi }
            if name == "episodic" { sum_ep = sum_ep + phi }
            if name == "composed" {
                sum_cmp = sum_cmp + phi; nseed = nseed + 1
                if want_mip == 1 {
                    let mi = iit4_build_mi_matrix(state, n, dim, nb)
                    last_cmp_mip = _mip_label(mi, n)
                    let _ = farr_free(mi)
                }
            }
            if name == "disconnected" { sum_dis = sum_dis + phi }
            if want_mip == 1 {
                println("  [" + tag + "]  n=" + str(n) + " T=" + str(dim) + "  faithful_Φ=" + _f6(phi))
            }
            let _ = farr_free(state)
        }
        i = i + 1
    }

    let nf = nseed * 1.0
    let mSp = sum_sp / nf
    let mEp = sum_ep / nf
    let mCmp = sum_cmp / nf
    let mDis = sum_dis / nf
    let best_part = if mSp > mEp { mSp } else { mEp }
    let b1 = mCmp > (best_part + 0.02)
    let b2 = mCmp > (mDis + 0.02)
    let b3 = mDis <= (best_part + 0.02)
    let green = b1 && b2 && b3

    if want_mip == 1 {
        println("")
        println("=== MEAN faithful Φ over " + str(nseed) + " seeds (FROZEN PRIMARY n_bins=" + str(nb) + ") ===")
        println("  Φ_spatial      = " + _f6(mSp) + "   (n=4)")
        println("  Φ_episodic     = " + _f6(mEp) + "   (n=4)")
        println("  Φ_composed     = " + _f6(mCmp) + "   (n=8, coupled)")
        println("  Φ_disconnected = " + _f6(mDis) + "   (n=8, coupling removed — EARNED control)")
        println("  max(parts)     = " + _f6(best_part))
        println("  composed MIP cut: " + last_cmp_mip)
        println("")
        println("=== FROZEN bars (n_bins=" + str(nb) + ") ===")
        println("  Bφ1 INTEGRATION-RAISES-Φ  Φ_composed > max(parts)+0.02 : " + _f6(mCmp) + " > " + _f6(best_part + 0.02) + "  => " + (if b1 { "PASS" } else { "FAIL" }))
        println("  Bφ2 EARNED (coupling)     Φ_composed > Φ_disc+0.02      : " + _f6(mCmp) + " > " + _f6(mDis + 0.02) + "  => " + (if b2 { "PASS" } else { "FAIL" }))
        println("  Bφ3 control sane          Φ_disc ≤ max(parts)+0.02      : " + _f6(mDis) + " ≤ " + _f6(best_part + 0.02) + "  => " + (if b3 { "PASS" } else { "FAIL" }))
        println("")
        if green {
            println("VERDICT (frozen n_bins=" + str(nb) + "): 🟢 INTEGRATION-RAISES-Φ — composing spatial-map+episodic-memory raises faithful IIT4 Φ (earned vs disconnected control)")
        } else {
            println("VERDICT (frozen n_bins=" + str(nb) + "): 🧱 NO-Φ-LIFT — capability composes but faithful IIT4 Φ does NOT rise at this granularity (an honest, valid result; c9)")
        }
    } else {
        println("  n_bins=" + str(nb) + " : Φ_cmp=" + _f6(mCmp) + " Φ_sp=" + _f6(mSp) + " Φ_ep=" + _f6(mEp) + " Φ_disc=" + _f6(mDis) + " max(parts)=" + _f6(best_part) + "  => " + (if green { "🟢" } else { "🧱" }))
    }
}

fn main() {
    let path = _state_path()
    println("=== H_1408 lane-composition FAITHFUL IIT4 Φ (stdlib exact MIP-EI, n<=8) ===")
    println("engine: stdlib/consciousness/iit4/faithful_phi.hexa  (a_phi_iit4_tool — NOT a proxy)")
    println("WITHIN-FAMILY pair: spatial-map (H_1296) × episodic-memory (H_1227/H_1231)")
    println("state file: " + path)
    println("")

    // FROZEN PRIMARY measurement (n_bins=16) with full per-system Φ + MIP cut + bars
    _measure_at(path, 16, 1)

    // BINNING-INVARIANCE sweep (reported; the FROZEN verdict is the n_bins=16 above)
    println("")
    println("=== BINNING-INVARIANCE sweep (frozen verdict = n_bins=16; ordering robustness) ===")
    _measure_at(path, 8, 0)
    _measure_at(path, 12, 0)
    _measure_at(path, 16, 0)
    _measure_at(path, 24, 0)
    println("")
    println("=== H_1408 faithful Φ measurement complete (a_phi_iit4_tool) ===")
}
