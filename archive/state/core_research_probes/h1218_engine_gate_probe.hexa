// ════════════════════════════════════════════════════════════════════════
// core/h1218_engine_gate_probe.hexa — H_1218 ENGINE-MEASURED generation gates.
//
// WHY: G1 (창발/recombination), G2 (novelty), G6 (ideation) were measured TORCH-side
// (H_1129 / H_1140 / H_1158). a_engine_measured_verdict wants them measured ON THE
// ENGINE — by GENERATING through the mounted 303M ByteGPT via core/bytegpt_decode.hexa
// (the .hexa forward), not the torch reference. H_1157 proved byte-exact greedy parity,
// so engine greedy output SHOULD be byte-identical to torch greedy — running it is the
// honest verification (c2). This probe ADDS the seed loop; it does NOT edit the engine.
//
// Decode = GREEDY argmax (bytegpt_decode_argmax) — the deterministic byte-exact-parity
// path. NOTE: the torch gauge_lib._decode uses top-k=40 temp=0.7 SAMPLING; greedy is a
// DIFFERENT (deterministic) regime — the verdict reports this explicitly (no silent swap).
//
// Seeds = VERBATIM from UNIVERSE/gauge_lib.py (CONCEPTS + IDEATION_SEEDS).
// Output = one `RESULT|<role>|<gen-text>` line per seed on stdout (captured + scored
// by scripts/scratch/h1218/score_engine_gates.py with the FROZEN gauge_lib evaluators).
// ════════════════════════════════════════════════════════════════════════

import "core/bytegpt_decode.hexa"

// seed text -> list of utf-8 byte ints
fn _bytes_of(s: string) -> list {
    let out = []
    let n = byte_len(s)
    let mut i = 0
    while i < n {
        out.push(ord(substring(s, i, i + 1)))
        i = i + 1
    }
    return out
}

fn _gen_one(bin: string, role: string, seed: string, gen: int) {
    let r = bytegpt_decode_argmax(bin, _bytes_of(seed), gen)
    // emit a single parseable line. newlines in text are stripped to keep one line.
    let t = to_string(r["text"])
    println("RESULT|" + role + "|" + t)
}

fn main() {
    let bin = "/tmp/h1218_mount/bytegpt_chat_full.bin"
    let gen = 96   // matches gauge_lib max_new=96

    // ── G1 composed seed = ". ".join(CONCEPTS) + ". " (gauge_lib comp_seed) ──
    let comp = "consciousness arises from cells. tension ripples between distant minds. memory composes into new meaning. silence still carries information. the engine dreams when alone. "
    _gen_one(bin, "G1_composed", comp, gen)

    // ── G2 also reads comp_out + first 3 single-concept decodes (gauge_lib) ──
    _gen_one(bin, "G2_single_0", "consciousness arises from cells. ", gen)
    _gen_one(bin, "G2_single_1", "tension ripples between distant minds. ", gen)
    _gen_one(bin, "G2_single_2", "memory composes into new meaning. ", gen)

    // ── G6 ideation seeds (gauge_lib IDEATION_SEEDS) ──
    _gen_one(bin, "G6_ideation_0", "a new idea about consciousness: ", gen)
    _gen_one(bin, "G6_ideation_1", "an unexpected way minds could connect: ", gen)
    _gen_one(bin, "G6_ideation_2", "imagine a substrate that ", gen)
    _gen_one(bin, "G6_ideation_3", "what if memory could ", gen)
    _gen_one(bin, "G6_ideation_4", "a strange hypothesis worth testing: ", gen)

    println("DONE")
}
