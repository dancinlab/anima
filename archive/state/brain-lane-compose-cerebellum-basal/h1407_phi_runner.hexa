// ════════════════════════════════════════════════════════════════════════════
//  state/brain-lane-compose-cerebellum-basal/h1407_phi_runner.hexa
//
//  H_1407 — lane-composition Φ-measurement (FAITHFUL IIT4, exact MIP-EI, n≤8).
//  PAIR #4: CEREBELLUM forward-model (H_1280) × BASAL-GANGLIA gating (H_1281).
//
//  Imports the REAL stdlib faithful IIT4 engine (a_phi_iit4_tool — NOT a proxy,
//  NEVER variance×energy) and feeds it each system's n×T substrate trajectory
//  written by state/brain-lane-compose-cerebellum-basal/h1407_compose_phi.py:
//      S_cerebellum (n=4) · S_basal (n=4) · S_composed (n=8) · S_disconnected (n=8)
//  per seed [4700,4701,4702], then reports per-seed + mean Φ + the FROZEN bars
//  at the FROZEN PRIMARY n_bins=16, and a BINNING-INVARIANCE sweep over
//  n_bins ∈ {8,12,16,24}, plus the EXACT MIP cut for the composed system.
//
//  THE LAW TEST: report Φ_cerebellum and Φ_basal EXPLICITLY. The program law
//  (H_1404 vs H_1405) predicts a pair Φ-composes IFF BOTH parts are LOW individual-Φ.
//  cerebellum + basal are both low-Φ control faculties → law predicts Φ-compose.
//
//  state file format (python script):
//    # <tag>_s<seed> <n> <T>
//    <T floats>            (row 0 = unit 0 trajectory)
//    ... n rows ...
//
//  Run (CPU, $0):
//    python3 state/brain-lane-compose-cerebellum-basal/h1407_compose_phi.py /tmp/h1407_states.txt
//    H1407_STATE=/tmp/h1407_states.txt hexa run state/brain-lane-compose-cerebellum-basal/h1407_phi_runner.hexa
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn _state_path() -> string {
    let p = env("H1407_STATE")
    if len(p) > 0 { return p }
    return "/tmp/h1407_states.txt"
}

// ── 2^k via accumulator (mirror of the engine's _iit4_pow2) ─────────────────
fn _pow2(k: int) -> int { let mut p = 1; let mut i = 0; while i < k { p = p * 2; i = i + 1 }; return p }
fn _bit_set(mask: int, b: int) -> int { let pw = _pow2(b); if (mask / pw) % 2 == 1 { return 1 }; return 0 }
fn _imin(a: int, b: int) -> int { if a < b { return a }; return b }

// cross-cut MI for a mask, IDENTICAL definition to the engine's _iit4_cross_cut
fn _cross_cut(mi: int, n: int, mask: int) -> float {
    let mut cross = 0.0
    let mut ia = 0
    while ia < n {
        let mut inA = 0
        if ia == 0 { inA = 1 } else { if _bit_set(mask, ia - 1) == 1 { inA = 1 } }
        if inA == 1 {
            let mut jb = 0
            while jb < n {
                let mut jInA = 0
                if jb == 0 { jInA = 1 } else { if _bit_set(mask, jb - 1) == 1 { jInA = 1 } }
                if jInA == 0 { cross = cross + farr_get(mi, ia * n + jb) }
                jb = jb + 1
            }
        }
        ia = ia + 1
    }
    return cross
}
fn _size_a(n: int, mask: int) -> int {
    let mut cnt = 1; let mut b = 0
    while b < n - 1 { if _bit_set(mask, b) == 1 { cnt = cnt + 1 }; b = b + 1 }
    return cnt
}

// report the EXACT MIP mask (argmin cross-cut) for a built MI matrix, as a string
// listing which unit indices are on side A. Reuses the engine's MI matrix.
fn _mip_label(mi: int, n: int) -> string {
    if n <= 2 { return "{0}|{1}" }
    let max_mask = _pow2(n - 1)
    let mut best_cut = 1.0e308
    let mut best_mask = 1
    let mut found = false
    let mut mask = 1
    while mask < max_mask {
        let sa = _size_a(n, mask)
        let sb = n - sa
        if sb >= 1 {
            let cut = _cross_cut(mi, n, mask)
            if (!found) || (cut < best_cut) { best_cut = cut; best_mask = mask; found = true }
        }
        mask = mask + 1
    }
    let mut aSide = "A={0"
    let mut bSide = "B={"
    let mut first_b = true
    let mut i = 1
    while i < n {
        let inA = _bit_set(best_mask, i - 1)
        if inA == 1 { aSide = aSide + "," + str(i) }
        else {
            if first_b { bSide = bSide + str(i); first_b = false } else { bSide = bSide + "," + str(i) }
        }
        i = i + 1
    }
    aSide = aSide + "}"
    bSide = bSide + "}"
    let sa = _size_a(n, best_mask)
    let sb = n - sa
    let nrm = _imin(sa, sb) * 1.0
    return aSide + " | " + bSide + "  cut=" + _f6(best_cut) + "  /min|side|=" + str(to_int(nrm)) + "  =Φ" + _f6(best_cut / nrm)
}

// ── compute the four mean Φ values at a given n_bins (one full pass over lines) ──
// returns via println side-effects + bars; reused by the binning sweep.
fn _measure_at(lines: [string], nb: int, verbose: bool) -> [float] {
    let mut sum_cb = 0.0
    let mut sum_bg = 0.0
    let mut sum_cmp = 0.0
    let mut sum_dis = 0.0
    let mut nseed = 0
    let mut last_cmp_mip = ""

    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if len(line) > 0 && line.split(" ")[0] == "#" {
            let toks = line.split(" ")
            let tag = toks[1]                 // e.g. composed_s4700
            let n = toks[2].to_int()
            let dim = toks[3].to_int()
            let state = farr_zeros(n * dim)
            let mut r = 0
            while r < n {
                i = i + 1
                let row = lines[i].trim().split(" ")
                let mut c = 0
                while c < dim {
                    let _ = farr_set(state, r * dim + c, row[c].to_float())
                    c = c + 1
                }
                r = r + 1
            }
            let phi = iit4_faithful_phi(state, n, dim, nb)
            let name = tag.split("_")[0]
            if name == "cerebellum" { sum_cb = sum_cb + phi }
            if name == "basal" { sum_bg = sum_bg + phi }
            if name == "composed" {
                sum_cmp = sum_cmp + phi; nseed = nseed + 1
                let mi = iit4_build_mi_matrix(state, n, dim, nb)
                last_cmp_mip = _mip_label(mi, n)
                let _ = farr_free(mi)
            }
            if name == "disconnected" { sum_dis = sum_dis + phi }
            if verbose {
                println("  [" + tag + "]  n=" + str(n) + " T=" + str(dim) + "  faithful_Φ=" + _f6(phi))
            }
            let _ = farr_free(state)
        }
        i = i + 1
    }

    let nf = nseed * 1.0
    let mCb = sum_cb / nf
    let mBg = sum_bg / nf
    let mCmp = sum_cmp / nf
    let mDis = sum_dis / nf
    let best_part = if mCb > mBg { mCb } else { mBg }

    if verbose {
        println("")
        println("=== MEAN faithful Φ over " + str(nseed) + " seeds (n_bins=" + str(nb) + ") ===")
        println("  Φ_cerebellum   = " + _f6(mCb) + "   (n=4)")
        println("  Φ_basal        = " + _f6(mBg) + "   (n=4)")
        println("  Φ_composed     = " + _f6(mCmp) + "   (n=8, coupled)")
        println("  Φ_disconnected = " + _f6(mDis) + "   (n=8, coupling removed — EARNED control)")
        println("  max(parts)     = " + _f6(best_part))
        println("  composed MIP cut: " + last_cmp_mip)
        println("")
    }

    let mut res = farr_zeros(5)
    let _ = farr_set(res, 0, mCb)
    let _ = farr_set(res, 1, mBg)
    let _ = farr_set(res, 2, mCmp)
    let _ = farr_set(res, 3, mDis)
    let _ = farr_set(res, 4, best_part)
    // return as a hexa list
    return [mCb, mBg, mCmp, mDis, best_part]
}

fn main() {
    let path = _state_path()
    println("=== H_1407 lane-composition FAITHFUL IIT4 Φ (cerebellum × basal) — stdlib exact MIP-EI, n<=8 ===")
    println("engine: stdlib/consciousness/iit4/faithful_phi.hexa  (a_phi_iit4_tool — NOT a proxy)")
    println("state file: " + path)
    println("PROGRAM LAW TEST: both parts LOW individual-Φ control faculties ⇒ law predicts Φ-composes.")
    println("")

    let text = read_file(path)
    let lines = text.split("\n")

    // ── FROZEN PRIMARY: n_bins=16 (the pre-registered bar; terminal Φ verdict) ──
    println("--- FROZEN PRIMARY n_bins=16 (terminal Φ verdict) ---")
    let prim = _measure_at(lines, 16, true)
    let mCb = prim[0]
    let mBg = prim[1]
    let mCmp = prim[2]
    let mDis = prim[3]
    let best_part = prim[4]

    // FROZEN bars (.verdicts/1407_brain_lane_compose_cerebellum_basal/FREEZE.txt — NOT moved)
    //   Bφ1 INTEGRATION-RAISES-Φ : Φ_composed > max(parts) + 0.02
    //   Bφ2 EARNED (coupling)    : Φ_composed > Φ_disconnected + 0.02
    //   Bφ3 control sane         : Φ_disconnected ≤ max(parts) + 0.02
    let b1 = mCmp > (best_part + 0.02)
    let b2 = mCmp > (mDis + 0.02)
    let b3 = mDis <= (best_part + 0.02)
    println("=== FROZEN bars (n_bins=16) ===")
    println("  Bφ1 INTEGRATION-RAISES-Φ  Φ_composed > max(parts)+0.02 : " + _f6(mCmp) + " > " + _f6(best_part + 0.02) + "  => " + (if b1 { "PASS" } else { "FAIL" }))
    println("  Bφ2 EARNED (coupling)     Φ_composed > Φ_disc+0.02      : " + _f6(mCmp) + " > " + _f6(mDis + 0.02) + "  => " + (if b2 { "PASS" } else { "FAIL" }))
    println("  Bφ3 control sane          Φ_disc ≤ max(parts)+0.02      : " + _f6(mDis) + " ≤ " + _f6(best_part + 0.02) + "  => " + (if b3 { "PASS" } else { "FAIL" }))
    let green = b1 && b2 && b3
    println("")
    if green {
        println("VERDICT: 🟢 INTEGRATION-RAISES-Φ — composing cerebellum+basal RAISES faithful IIT4 Φ (earned vs disconnected control)")
        println("  → CONFIRMS the program LAW: a both-LOW-individual-Φ control pair Φ-composes (the H_1404 mechanism, not the H_1405 ToM-dominates case).")
    } else {
        println("VERDICT: 🧱 NO-Φ-LIFT — capability composes but faithful IIT4 Φ does NOT rise at the frozen granularity (an honest, valid result; c9)")
    }
    println("")

    // ── BINNING-INVARIANCE SWEEP (honest robustness report) ─────────────────
    println("--- BINNING-INVARIANCE SWEEP (n_bins ∈ {8,12,16,24}; primary=16) ---")
    let r8  = _measure_at(lines, 8,  false)
    let r12 = _measure_at(lines, 12, false)
    let r16 = prim
    let r24 = _measure_at(lines, 24, false)
    println("  n_bins= 8 : Φ_cb=" + _f6(r8[0])  + " Φ_bg=" + _f6(r8[1])  + " Φ_cmp=" + _f6(r8[2])  + " Φ_dis=" + _f6(r8[3])  + " max(parts)=" + _f6(r8[4])  + " → Bφ1 " + (if r8[2]  > r8[4]  + 0.02 { "PASS" } else { "FAIL" }))
    println("  n_bins=12 : Φ_cb=" + _f6(r12[0]) + " Φ_bg=" + _f6(r12[1]) + " Φ_cmp=" + _f6(r12[2]) + " Φ_dis=" + _f6(r12[3]) + " max(parts)=" + _f6(r12[4]) + " → Bφ1 " + (if r12[2] > r12[4] + 0.02 { "PASS" } else { "FAIL" }))
    println("  n_bins=16 : Φ_cb=" + _f6(r16[0]) + " Φ_bg=" + _f6(r16[1]) + " Φ_cmp=" + _f6(r16[2]) + " Φ_dis=" + _f6(r16[3]) + " max(parts)=" + _f6(r16[4]) + " → Bφ1 " + (if r16[2] > r16[4] + 0.02 { "PASS" } else { "FAIL" }) + "  [FROZEN BAR]")
    println("  n_bins=24 : Φ_cb=" + _f6(r24[0]) + " Φ_bg=" + _f6(r24[1]) + " Φ_cmp=" + _f6(r24[2]) + " Φ_dis=" + _f6(r24[3]) + " max(parts)=" + _f6(r24[4]) + " → Bφ1 " + (if r24[2] > r24[4] + 0.02 { "PASS" } else { "FAIL" }))
    println("")
    println("=== H_1407 faithful Φ measurement complete (a_phi_iit4_tool) ===")
}
