// H_1521 measurement probe — engine-native (live core/engine_cli.hexa ci_ ops).
// Measures the headline numbers to PRE-REGISTER frozen bars BEFORE wiring smoke cases:
//   P2 COUPLING-IS-LIVE: L2 diff of ON vs OFF lane vectors (must be > 0)
//   P3 Ψ=½ SURVIVES: |Ψ_on − ½| for FLAT/BRAIN/OPTIMAL coupling
//   P4 FUNCTIONAL DIRECTION: topo_func_integration FLAT vs BRAIN vs OPTIMAL ordering
import "core/engine_cli.hexa"

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// same population builder as the smoke _topo_lane_pop (byte-identical seed/recipe).
fn pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn main() {
    let x = pop()
    let alpha = 0.6
    let cfg_off = EngineConfig { mitosis: true, engine: "conv", topo_couple: false }
    let cfg_on  = EngineConfig { mitosis: true, engine: "conv", topo_couple: true }
    let adj_flat = _topo_zeros(15)
    let adj_brain = topo_brain_adjacency()
    let adj_opt   = topo_optimal_adjacency()

    // P1 OFF byte-identical: coupled-OFF vector == raw ci_lane_scores
    let raw0 = x[0]
    let off0 = ci_lane_scores_coupled(0.5, [0.3,0.3,0.3,0.3,0.3], 3, 2, 1, 0.5, 0.4, adj_opt, alpha, cfg_off)
    let on0  = ci_lane_scores_coupled(0.5, [0.3,0.3,0.3,0.3,0.3], 3, 2, 1, 0.5, 0.4, adj_opt, alpha, cfg_on)
    let manual0 = ci_lane_scores(0.5, [0.3,0.3,0.3,0.3,0.3], 3, 2, 1, 0.5, 0.4)
    println("P1 OFF==raw L2=" + to_string(ci_lane_vector_l2_diff(off0, manual0)))
    println("P2 ON!=OFF L2=" + to_string(ci_lane_vector_l2_diff(on0, off0)))

    // P3 Ψ=½ survival (ABSOLUTE proxy — threshold at the architectural ½ midpoint)
    let psi_off  = ci_psi_balance(x, adj_opt, alpha, cfg_off)   // OFF ignores adj
    let psi_flat = ci_psi_balance(x, adj_flat, alpha, cfg_on)
    let psi_brain= ci_psi_balance(x, adj_brain, alpha, cfg_on)
    let psi_opt  = ci_psi_balance(x, adj_opt, alpha, cfg_on)
    println("P3abs Psi OFF="    + to_string(psi_off))
    println("P3abs Psi ON flat="  + to_string(psi_flat))
    println("P3abs Psi ON brain=" + to_string(psi_brain))
    println("P3abs Psi ON opt="   + to_string(psi_opt))
    // P3 Ψ=½ survival (CENTERED proxy — threshold = OFF median drive ⇒ OFF == ½ by construction)
    let thr = ci_off_median_drive(x)
    let cpsi_off  = ci_psi_balance_centered(x, adj_opt, alpha, thr, cfg_off)
    let cpsi_flat = ci_psi_balance_centered(x, adj_flat, alpha, thr, cfg_on)
    let cpsi_brain= ci_psi_balance_centered(x, adj_brain, alpha, thr, cfg_on)
    let cpsi_opt  = ci_psi_balance_centered(x, adj_opt, alpha, thr, cfg_on)
    println("P3ctr thr=" + to_string(thr))
    println("P3ctr Psi OFF="    + to_string(cpsi_off))
    println("P3ctr Psi ON flat="  + to_string(cpsi_flat))
    println("P3ctr Psi ON brain=" + to_string(cpsi_brain))
    println("P3ctr Psi ON opt="   + to_string(cpsi_opt))

    // P4 functional integration ordering
    let f_flat  = topo_func_integration_flat(x)
    let f_brain = topo_func_integration(x, adj_brain, alpha)
    let f_opt   = topo_func_integration(x, adj_opt, alpha)
    println("P4 func flat="  + to_string(f_flat))
    println("P4 func brain=" + to_string(f_brain))
    println("P4 func opt="   + to_string(f_opt))
    println("P4 opt-brain gain=" + to_string(f_opt - f_brain))
}
