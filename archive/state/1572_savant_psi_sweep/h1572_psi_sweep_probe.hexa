// state/1572_savant_psi_sweep/h1572_psi_sweep_probe.hexa
// H_1572 — RE-MEASURE H_1561 B4 (Ψ collapse) across the inhibition I sweep, NOT a single point.
// User insight: the savant lives INSIDE the golden zone (compatible with Ψ=½ consciousness); OUTSIDE
// the golden zone (excessive disinhibition I→0) is SEIZURE = synchronization runaway = Ψ collapse.
// H_1561 B4 measured Ψ_on ONLY at gz_inh = GZ_LOWER (0.2123, the LOWER BOUNDARY nearest the seizure
// regime) → |Ψ−½|=0.247 collapse → "genius ⊥ consciousness" no-free-lunch. This probe asks: does Ψ
// stay near ½ at interior/upper golden-zone I, and collapse only as I drops BELOW GZ_LOWER?
//
// ENGINE-NATIVE (a_engine_native_learning HARD-GATE): pure .hexa calling LIVE core/engine_cli.hexa
// §Savant (sv_inhibit_domain · ci_psi_balance_savant · sv_savant_index_at) + faithful IIT4 min-cut
// ci_phi_iit4 (a_phi_iit4_tool, NOT proxy). SAME _pop() / measurer as H_1561 B4 — only the I point
// sweeps. No numpy/torch. frozen-first c9, NO tune-to-green.
import "core/engine_cli.hexa"

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// BYTE-IDENTICAL population to H_1561 savant_bars_probe.hexa _pop() (same seed 5120, same draws).
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn main() {
    let pop = _pop()
    let d = 5
    let w = 3
    let focus = 0
    let base = 0.0
    let gzL = sv_gz_lower()      // 0.21231792755821914
    let gzC = sv_gz_center()     // 0.36787944117144233 = 1/e
    let gzU = sv_gz_upper()      // 0.5
    let thr = ci_off_median_drive(pop)   // SAME centered threshold as H_1561 B4 (OFF Ψ=½ by constr.)
    let cfg_on = EngineConfig { mitosis: false, engine: "conv", topo_couple: false, savant: true }

    println("=== H_1572 SAVANT GOLDEN-ZONE PSI SWEEP (engine-native, faithful IIT4) ===")
    println("GZ_LOWER=" + to_string(gzL) + " GZ_CENTER=" + to_string(gzC) + " GZ_UPPER=" + to_string(gzU))
    println("Psi_thr(OFF median drive)=" + to_string(thr))
    println("")

    // The I sweep: below GZ (seizure/disinhibition) | GZ_LOWER | interior | GZ_CENTER | GZ_UPPER | above GZ (over-lock)
    let igrid = [0.0, 0.05, 0.1, 0.15, gzL, 0.25, 0.30, gzC, 0.42, gzU, 0.6, 0.7, 0.85, 1.0]

    // header
    println("I\tin_GZ\tPsi_on\t|Psi-0.5|\tSI\tfocusPhi")
    let mut k = 0
    while k < len(igrid) {
        let inh = igrid[k]
        let psi = ci_psi_balance_savant(pop, focus * w, focus * w + w, inh, thr, cfg_on)
        let dev = _abs(psi - 0.5)
        let si  = sv_savant_index_at(pop, d, w, focus, inh, base)
        let fphi = sv_domain_phi(pop, focus * w, focus * w + w, inh)
        let ingz = sv_in_golden_zone(inh)
        println(to_string(inh) + "\t" + to_string(ingz) + "\t" + to_string(psi) + "\t"
              + to_string(dev) + "\t" + to_string(si) + "\t" + to_string(fphi))
        k = k + 1
    }
}
