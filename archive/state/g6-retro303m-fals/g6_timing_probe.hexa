import "core/generator.hexa"

// Minimal single bounded decode on the 303M ConvMoE-RETRO trunk to MEASURE per-byte
// forward cost + confirm the engine runs a forward on this ckpt, BEFORE the full 5-arm
// re-score (FREEZE (ii) hard-bound, a_cpu_local_no_waiter — no unbounded decode).
fn main() {
    let ckpt = "state/g6-retro303m-fals/retro303m.clm"
    let GEN = 8                  // tiny bound to measure ms/byte
    let t0 = now_ms()
    let r = gen_clm_ideate(ckpt, "if consciousness arises from cells, then memory composes into new meaning: ", GEN, 40, 0.7, 7)
    let dt = now_ms() - t0
    println("DECODE_OK text=\"" + to_string(r["text"]) + "\"")
    println("GEN=" + to_string(GEN) + " WALL_MS=" + to_string(dt) + " MS_PER_BYTE=" + to_string(dt / GEN))
}
