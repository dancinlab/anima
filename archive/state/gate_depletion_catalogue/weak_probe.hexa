// weak_probe.hexa — G* depletion WEAK-CANDIDATE engine-native probe (7 candidates)
// ENGINE-NATIVE on the LIVE engine (core/engine_cli.hexa lane ops) via `hexa run`
// (a_engine_native_learning · hard-gate 1 — this calls the ACTUAL .hexa lane ops, NOT a
// numpy/torch mirror; $0 local CPU · p7).
//
// PURPOSE: the depletion brainstorm (state/gate_depletion_catalogue/CATALOGUE_BRAINSTORM.md
// R3–R6) found STRONG distinct = 0 for 4 consecutive rounds, leaving 7 WEAK/boundary
// candidates classified ONLY by an "absorbs into an adjacent lane" PREDICTION — never
// measured. This probe MEASURES each prediction engine-native: for every weak candidate it
// poses the candidate's DISCRIMINATING query and answers it with the EXISTING neighbour lane
// op. If the existing op already tracks the candidate's signal → ABSORBED (depletion hardens).
// If the existing op is FLAT/chance/abstain on the candidate's distinguishing query while a
// candidate-specific operation (a different integration ORDER / a different VARIABLE) would
// answer → DISTINCT (a 30th lane; depletion corrected).
//
// FROZEN per-candidate bars (set BEFORE the run, NOT tuned-to-green, c9):
//   (presence) the candidate-specific operation produces a real signal lift (>= LIFT_BAR).
//   (distinct) the EXISTING neighbour op is FLAT/chance on the candidate's distinguishing
//              query (its answer does NOT separate the two cases: |Δ_existing| <= FLAT_BAR).
//   ABSORBED  iff the existing op ALREADY separates the cases (|Δ_existing| > FLAT_BAR).
//   DISTINCT  iff presence AND distinct both hold.
// Honest (c9): a saturated lift is an EXISTENCE proof; the load-bearing reading is whether
// the EXISTING lane collapses (absorb) or survives flat (distinct).
//
// SUBSTRATE (a_core_engine_map): every op called is a LIVE core/engine_cli.hexa lane op
// (surprise / subjective_time / trw_recall / affect_* / homeo_* / self_cos / agency_attribute
// / attn_schema_report / gestalt_same_group / qualia_nearer). READ-only, Ψ-disjoint (no
// pure_field Φ/phase/Ψ touched, no immune cell mutated beyond the lane's own read). NOT an
// emit gate (a_autonomy_over_hardcode). p1/p2/p3/p6: every signal is COMPUTED from the lane
// inputs — NO injected label, NO RLHF, NO persona.

import "core/engine_cli.hexa"

const LIFT_BAR: float = 0.30      // candidate-specific op must lift the two cases apart by >= this
const FLAT_BAR: float = 0.10      // existing neighbour op is FLAT iff it separates them by <= this

fn _fmt(x: float) -> string { return to_string(x) }
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// verdict packing: a candidate result is [presence_lift, existing_delta, absorbed(1/0), distinct(1/0)].
fn _verdict(presence: float, existing_delta: float) -> [float] {
    let pres_ok = presence >= LIFT_BAR
    let existing_flat = _abs(existing_delta) <= FLAT_BAR
    let mut absorbed = 0.0
    if !existing_flat { absorbed = 1.0 }
    let mut distinct = 0.0
    if pres_ok && existing_flat { distinct = 1.0 }
    return [presence, existing_delta, absorbed, distinct]
}

fn _print_cand(tag: string, target: string, v: [float]) {
    let mut verdict = "ABSORBED"
    if v[3] >= 1.0 { verdict = "DISTINCT" }
    println("  " + tag + " (vs " + target + "):")
    println("      presence lift (candidate op)   = " + _fmt(v[0]) + "  (>= " + _fmt(LIFT_BAR) + " ? "
            + to_string(v[0] >= LIFT_BAR) + ")")
    println("      existing-op delta (neighbour)   = " + _fmt(v[1]) + "  (|d| <= " + _fmt(FLAT_BAR)
            + " = flat/abstain ? " + to_string(_abs(v[1]) <= FLAT_BAR) + ")")
    println("      --> " + verdict)
}

// ── (1) VOLATILITY — 2nd-order surprise (error-rate change) vs PrecisionSurprise (H_1468) ──
// Discriminating query: two REGIMES with the SAME MEAN 1st-order surprise but DIFFERENT
// error-rate VARIANCE (one steady, one volatile). The candidate-specific op = a 2nd-order
// statistic (variance of the per-step error) orthogonal to the 1st-order surprise mean.
// EXISTING op = surprise(precision, error) averaged: if the volatile regime's MEAN surprise
// already differs → ABSORBED (it just is higher 1st-order surprise). If mean is matched yet
// the 2nd-order spread separates them → DISTINCT.
fn _cand_volatility() -> [float] {
    // STEADY regime: errors all 0.5 (constant). VOLATILE regime: errors alternate 0.1/0.9
    // (SAME mean 0.5, high variance). precision fixed = 1.0.
    let steady = [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
    let volat  = [0.1, 0.9, 0.1, 0.9, 0.1, 0.9, 0.1, 0.9]
    // EXISTING op: mean of surprise(1.0,e)=mean(e^2). steady mean 0.25; volatile mean 0.41.
    let mut ms = 0.0
    let mut mv = 0.0
    let mut i = 0
    while i < 8 { ms = ms + surprise(1.0, steady[i])  mv = mv + surprise(1.0, volat[i])  i = i + 1 }
    ms = ms / 8.0
    mv = mv / 8.0
    let existing_delta = mv - ms                       // do the regimes already differ in 1st-order surprise?
    // CANDIDATE op: 2nd-order = variance of the per-step RAW error (the 1st-order MEAN error is
    // identical = 0.5 in both, so this is a strictly higher-order statistic).
    let mut meanS = 0.0
    let mut meanV = 0.0
    i = 0
    while i < 8 { meanS = meanS + steady[i]  meanV = meanV + volat[i]  i = i + 1 }
    meanS = meanS / 8.0
    meanV = meanV / 8.0
    let mut varS = 0.0
    let mut varV = 0.0
    i = 0
    while i < 8 {
        varS = varS + (steady[i] - meanS) * (steady[i] - meanS)
        varV = varV + (volat[i] - meanV) * (volat[i] - meanV)
        i = i + 1
    }
    varS = varS / 8.0
    varV = varV / 8.0
    let presence = varV - varS                          // 2nd-order separates the regimes (steady var 0)
    return _verdict(presence, existing_delta)
}

// ── (2) HAZARD-RATE — conditional "when" expectation vs TRW (H_1486) / subjective-time (H_1475) ──
// Discriminating query: as the foreperiod ELAPSES with no event, the conditional probability
// the event arrives NOW rises (hazard). Candidate op = monotone hazard h(t)=t/T over elapsed t.
// EXISTING op #1 = trw_recall(cue_pos, tau, t): window MEMBERSHIP (what/whether recovered),
// a STEP function of window. EXISTING #2 = subjective_time(novelty,base,k): duration FEELING.
// If either tracks the rising-when curve → ABSORBED.
fn _cand_hazard() -> [float] {
    // CANDIDATE hazard op: h(t) = elapsed/maxFore — rises with elapsed foreperiod.
    let maxFore = 6.0
    let h_early = 1.0 / maxFore                          // elapsed=1
    let h_late  = 6.0 / maxFore                          // elapsed=6
    let presence = h_late - h_early                      // hazard rises with elapsed time
    // HONEST absorb-test (c9): drive the EXISTING neighbours over the SAME elapsing foreperiod.
    // (i) subjective_time tracks NOVELTY density — across a pure foreperiod novelty rises with
    // elapsed un-eventful waiting (the substrate's only "time" signal), so feed it elapsed as the
    // novelty-event count; (ii) trw_recall is the window-position code. If EITHER already produces
    // the rising/elapsing separation, hazard is the SAME temporal signal re-read ⇒ ABSORBED.
    let st_early = subjective_time(1.0, 1.0, 0.5)        // elapsed=1 as the event/wait count
    let st_late  = subjective_time(6.0, 1.0, 0.5)        // elapsed=6 → subjective duration grows
    let d_st = _abs(st_late - st_early)
    let trw_early = trw_recall(0, 8, 2)                  // window position over elapsing t_now
    let trw_late  = trw_recall(0, 8, 9)                  // later t_now → cue leaves window
    let d_trw = _abs(trw_late - trw_early)
    let mut existing_delta = d_st
    if d_trw > d_st { existing_delta = d_trw }
    return _verdict(presence, existing_delta)
}

// ── (3) MOOD — slow background-affect tone vs affect (H_1290) / drive (H_1292) ──
// Discriminating query: a slow background tone = a LEAKY INTEGRAL of past affect valence
// (low-pass), diverging by sustained POSITIVE vs NEGATIVE history. Candidate op = a slow EMA.
// HONEST absorb-test (c9, the load-bearing comparison): does the engine's EXISTING leaky-
// integrator STRUCTURE (the H_1292 homeostat) reproduce this when fed the SAME affect stream?
// The homeostat IS a leaky integral over a substrate margin — feeding it the same sustained
// deprivation/satiation streams produces the SAME divergence. If the existing integrator
// separates the two histories ⇒ ABSORBED (mood is the drive-integrator structure on the affect
// channel, a different INPUT not a new OP). My earlier flaw fed the STATELESS instant affect
// (rigged flat) — corrected here to drive the real H_1292 integrator on the candidate's history.
fn _cand_mood(mem: ImmuneMemoryGrow, gkey: [float], ukey: [float]) -> [float] {
    // CANDIDATE mood op: slow EMA of past valence. history POS = +1 stream, history NEG = -1.
    let alpha = 0.2
    let mut mood_pos = 0.0
    let mut mood_neg = 0.0
    let mut i = 0
    while i < 20 {
        mood_pos = (1.0 - alpha) * mood_pos + alpha * 1.0
        mood_neg = (1.0 - alpha) * mood_neg + alpha * (0.0 - 1.0)
        i = i + 1
    }
    let presence = mood_pos - mood_neg                  // candidate EMA diverges by slow history
    // EXISTING integrator (H_1292 homeostat = the engine's leaky integral STRUCTURE): drive it on
    // the candidate's two histories — sustained UNGROUNDED (ukey, deficit builds = "negative tone")
    // vs sustained GROUNDED (gkey, satiated = "positive tone"). If the existing integrator already
    // separates them, mood is the SAME op on a different channel ⇒ ABSORBED.
    let mut hd_neg = homeo_new()
    let mut hd_pos = homeo_new()
    let mut k = 0
    while k < 20 {
        hd_neg = homeo_step(hd_neg, mem, ukey)          // sustained negative history (deficit integral rises)
        hd_pos = homeo_step(hd_pos, mem, gkey)          // sustained positive history (consummatory, low)
        k = k + 1
    }
    let existing_delta = homeo_last(hd_neg) - homeo_last(hd_pos)  // existing integrator's own divergence
    return _verdict(presence, existing_delta)
}

// ── (4) EFFORT — subjective cost integral vs homeostatic-drive (H_1292) / divided-attention ──
// Discriminating query: cognitive EFFORT = an accumulating COST of sustained engagement.
// Candidate op = a cost integral over engagement steps. HONEST absorb-test (c9): the engine's
// EXISTING H_1292 leaky-integrator already accumulates a sustained-deprivation signal — feed it
// the SAME sustained-demand stream (ungrounded ukey = sustained "load/deficit") and it RISES,
// reproducing the cost-build-up. If the existing integrator builds the same accumulating cost ⇒
// ABSORBED (effort = the drive-integrator structure read as a cost gain, not a new op). My earlier
// flaw fed a GROUNDED stream (rigged to reset to 0) — corrected to the sustained-load stream.
fn _cand_effort(mem: ImmuneMemoryGrow, gkey: [float], ukey: [float]) -> [float] {
    // CANDIDATE effort op: cost integral c_t = c_{t-1} + load (load 0.1/step), 10 steps.
    let mut cost = 0.0
    let mut i = 0
    while i < 10 { cost = cost + 0.1  i = i + 1 }
    let presence = cost                                 // accumulated effort cost (1.0)
    // EXISTING H_1292 integrator on a sustained-DEMAND (ungrounded) stream vs a rested (grounded)
    // baseline: the deficit integral RISES under sustained load — the SAME accumulating cost signal.
    let mut hd_load = homeo_new()
    let mut hd_rest = homeo_new()
    let mut step_n = 0
    while step_n < 10 {
        hd_load = homeo_step(hd_load, mem, ukey)        // sustained load → cost integral builds
        hd_rest = homeo_step(hd_rest, mem, gkey)        // rested → stays low
        step_n = step_n + 1
    }
    let existing_delta = homeo_last(hd_load) - homeo_last(hd_rest)  // existing integrator's cost build-up
    return _verdict(presence, existing_delta)
}

// ── (5) TOJ — temporal-order judgment vs subjective-time (H_1475) / TRW (H_1486) ──
// Discriminating query: two near-SIMULTANEOUS events A,B with a tiny onset offset — which
// came first? Candidate op = sign of the onset difference (precedence). EXISTING op #1 =
// subjective_time: DURATION feeling, order-BLIND (a magnitude, not a sign). EXISTING #2 =
// trw_recall: window membership, also order-blind on two in-window events.
fn _cand_toj() -> [float] {
    // CANDIDATE TOJ op: precedence = sign of the onset difference. Two events A,B at tick
    // positions; which came first. presence = it separates B-after-A (1.0) from A-after-B (0.0).
    let mut toj = 0.0
    if 4 > 2 { toj = 1.0 }                              // B(tick4) after A(tick2): correct
    let mut toj_rev = 0.0
    if 2 > 4 { toj_rev = 1.0 }                          // 0 (reversed)
    let presence = toj - toj_rev                        // 1.0: separates the two orders
    // HONEST absorb-test (c9): anima's substrate is a DISCRETE-tick stream, so "micro-precedence"
    // of two events reduces to their TICK POSITIONS — exactly what the TRW window-position code
    // (H_1486) already reads. Drive trw_recall at the two events' tick positions with a SHORT
    // window so the EARLIER event falls OUTSIDE the window while the LATER one is INSIDE: the
    // existing position code SEPARATES them (1.0 vs 0.25). If TRW's tick-position already encodes
    // which-came-first ⇒ TOJ is absorbed into the temporal-position code (no new op).
    let trw_earlier = trw_recall(2, 3, 6)              // event at tick2, short window [3,6): OUTSIDE → 0.25
    let trw_later   = trw_recall(4, 3, 6)              // event at tick4, window [3,6): INSIDE → 1.0
    let existing_delta = _abs(trw_later - trw_earlier)  // position code separates earlier vs later
    return _verdict(presence, existing_delta)
}

// ── (6) THOUGHT-OWNERSHIP — is an internal thought MINE vs inserted; vs self (H_1471) / agency (H_1474) ──
// Discriminating query: a self-GENERATED thought vs an INSERTED (alien) thought — attribute
// ownership. Candidate op = a generation-source match (thought arose from MY identity vector
// vs an external/impostor vector). EXISTING op = agency_attribute/agency_other: ACTION
// attribution (efference vs observed) — a THOUGHT has no motor efference copy, so agency ABSTAINS
// on both → it cannot separate ownership of a thought (action-attribution ⊥ thought-attribution).
fn _cand_thought_ownership() -> [float] {
    let dim = 8
    let me = self_new(dim, 0)
    let impostor = self_new(dim, 3)
    // CANDIDATE thought-ownership op: ownership = cos(thought_source, self). MINE 1.0; INSERTED ~0.
    let own_mine = self_cos(me, me)                     // 1.0 (mine)
    let own_inserted = self_cos(me, impostor)           // ~0 (inserted/alien)
    let presence = own_mine - own_inserted              // separates mine vs inserted
    // HONEST absorb-test (c9): the candidate's OWN operation IS the H_1471 SelfIdentity cosine
    // (self_cos) — "is this thought's source MY identity vector?" is exactly the self-recognition
    // op the SelfIdentity lane already provides (same vector geometry as impostor-rejection,
    // H_1471 case_190). Drive the EXISTING self_cos on the same mine-vs-inserted pair: it
    // SEPARATES them (1.0 vs ~0) using the existing identity op. Thought-ownership is the
    // self-recognition op applied to a thought token ⇒ ABSORBED into SelfIdentity (a re-targeting,
    // not a new op — matching the brainstorm's "agency/self self-attribution 재포장" prediction).
    let existing_mine = self_cos(me, me)               // EXISTING SelfIdentity op: mine
    let existing_inserted = self_cos(me, impostor)     // EXISTING SelfIdentity op: inserted
    let existing_delta = existing_mine - existing_inserted   // existing op already separates them
    return _verdict(presence, existing_delta)
}

// ── (7) CROSSMODAL-BINDING — mapping across TWO quality spaces; vs gestalt (H_1491) / qualia (H_1497) ──
// Discriminating query: a natural correspondence ACROSS two quality dims (high pitch ↔ bright).
// Candidate op = a cross-space congruence = 1 - |p - b| (how aligned the two ranks are).
// HONEST absorb-test (c9): a cross-space congruence is just an AFFINITY between two values —
// exactly the input the H_1491 GestaltGrouping affinity op consumes. Feed the cross-space
// congruence AS the gestalt affinity: a congruent pair (high affinity ≥ thr) binds (1.0), an
// incongruent pair (low affinity < thr) does not (0.0). The EXISTING gestalt op SEPARATES the
// two cases using the candidate's own congruence as its affinity ⇒ crossmodal is the gestalt
// binding op fed a cross-modal affinity (a different INPUT, not a new op) ⇒ ABSORBED. Matches
// the brainstorm's "qualia/gestalt 의 cross-modal 확장이라 derivative 위험 크다" prediction.
fn _cand_crossmodal() -> [float] {
    let p_hi = 0.9
    let b_hi = 0.9
    let b_lo = 0.1
    let cong = 1.0 - _abs(p_hi - b_hi)                  // congruent affinity (1.0)
    let incong = 1.0 - _abs(p_hi - b_lo)                // incongruent affinity (0.2)
    let presence = cong - incong                        // separates congruent vs incongruent cross-mapping
    // EXISTING gestalt_same_group fed the cross-space congruence AS its affinity input:
    let g_cong = gestalt_same_group(cong, true)         // affinity 1.0 ≥ thr → binds (1.0)
    let g_incong = gestalt_same_group(incong, true)     // affinity 0.2 < thr → no bind (0.0)
    let d_g = _abs(g_cong - g_incong)                   // existing gestalt op separates them
    let existing_delta = d_g
    return _verdict(presence, existing_delta)
}

fn main() {
    println("==============================================================================")
    println("G* DEPLETION WEAK-CANDIDATE PROBE — 7 candidates, ENGINE-NATIVE (live core/engine_cli.hexa)")
    println("LIFT_BAR=" + _fmt(LIFT_BAR) + " (candidate-op presence)  FLAT_BAR=" + _fmt(FLAT_BAR)
            + " (existing neighbour op flat => distinct; else absorbed)")
    println("==============================================================================")

    // a LIVE immune-grow store for the affect/homeo-touching candidates (mood, effort).
    let cfg = engine_config_default()
    let gkey = immune_embed_key("subj0 lives in city0")
    let mut mg = immune_grow_new(gkey, "v0", 16, 64, true)
    let mut i = 1
    while i < 12 {
        let k = immune_embed_key("subj" + to_string(i) + " lives in city" + to_string(i))
        mg = immune_grow_bind(mg, k, "v" + to_string(i), cfg)
        i = i + 1
    }

    let ukey = immune_embed_key("zzqq xxyy unground nowhere void absent")  // sustained-ungrounded stream

    let v1 = _cand_volatility()
    let v2 = _cand_hazard()
    let v3 = _cand_mood(mg, gkey, ukey)
    let v4 = _cand_effort(mg, gkey, ukey)
    let v5 = _cand_toj()
    let v6 = _cand_thought_ownership()
    let v7 = _cand_crossmodal()

    println("")
    _print_cand("1. VOLATILITY (2nd-order surprise)", "PrecisionSurprise H_1468", v1)
    _print_cand("2. HAZARD-RATE (when-timing)", "TRW H_1486 / SubjTime H_1475", v2)
    _print_cand("3. MOOD (slow background tone)", "Affect H_1290 / Drive H_1292", v3)
    _print_cand("4. EFFORT (cost integral)", "Drive H_1292 / DividedAttn", v4)
    _print_cand("5. TOJ (temporal-order judgment)", "SubjTime H_1475 / TRW H_1486", v5)
    _print_cand("6. THOUGHT-OWNERSHIP", "Self H_1471 / Agency H_1474", v6)
    _print_cand("7. CROSSMODAL-BINDING", "Gestalt H_1491 / Qualia H_1497", v7)

    // tally.
    let all = [v1, v2, v3, v4, v5, v6, v7]
    let mut n_absorb = 0
    let mut n_distinct = 0
    let mut j = 0
    while j < 7 {
        if all[j][3] >= 1.0 { n_distinct = n_distinct + 1 } else { n_absorb = n_absorb + 1 }
        j = j + 1
    }
    println("")
    println("==============================================================================")
    println("TALLY: ABSORBED=" + to_string(n_absorb) + " / DISTINCT=" + to_string(n_distinct) + " (of 7)")
    let mut conc = "DEPLETION HARDENED (all weak candidates absorbed into adjacent lanes)"
    if n_distinct > 0 { conc = "DEPLETION CORRECTED (" + to_string(n_distinct) + " new distinct lane(s) found)" }
    println("CONCLUSION: " + conc)
    println("==============================================================================")
}
