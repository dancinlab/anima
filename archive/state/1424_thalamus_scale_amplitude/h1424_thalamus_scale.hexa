// h1424_thalamus_scale.hexa — CONTINUED MULTI-LENS attack on the H_1283/H_1423 thalamus
// TIMING-axis engine-native wall (a_break_the_wall, c16). Re-opens H_1423's explicit defer
// conditions: "a LARGER oscillator substrate where faithful-IIT4 separates timing from amplitude
// variance" and "an amplitude-controlled measurement that removes the carrier-variance confound".
//
// H_1423 FINDING (verbatim): on the engine LCG n=4/T=64 toy, the multiplicative carrier
// e*(1+cosθ)/2 lifts faithful-IIT4 Φ even under PHASE-SHUFFLE because its VARIANCE (not its TIMING
// structure) drives the MIP. The phase-SHUFFLE control did NOT collapse the lift (c4 FAIL). All
// variance-free lenses gave no robust lift (c2 FAIL). → 🧱 DEFERRED to larger n / amplitude-control.
//
// FROZEN R8 bars (VERBATIM from H_1283 R8 / H_1423, NOT moved, c9/p7):
//   ARM A = direct ring (no timing gate)   ·   ARM B = ring + timing-gated salience
//   c2 PRIMARY  faithful ΔΦ(B-A) >= +0.02 on EVERY seed
//   c4 SHUFFLE  phase_shuffle ΔΦ(SH-A) <= 0 on EVERY seed (lift COLLAPSES = timing, not variance)
//   ABLATION    (B - ablate) >= +0.02 every seed (mechanism-OFF must kill the lift = LIVE)
// A lens BREAKS the wall iff (c2 AND c4 AND ablation-LIVE) on every seed.
//
// CONTINUED LENSES:
//   Lens D — LARGER SUBSTRATE ((e) investment): run R8-original carrier (anchor) + LC additive-order
//            at n_mod ∈ {4,6,8} and T ∈ {64,256}. KEY TEST: at larger n / longer T, does the
//            phase-SHUFFLE control finally COLLAPSE the lift (does timing separate from variance)?
//   Lens E — AMPLITUDE-CONTROLLED MEASUREMENT ((a) measurement-fix): UNIT-NORM each module's salience
//            time-series (subtract mean, divide by std) so per-unit VARIANCE is IDENTICAL across
//            ARM B (phase-coherent gate) and SHUFFLE. With variance held equal, ONLY phase/timing
//            structure can drive Φ. If a phase-coherent gate STILL lifts Φ over phase-shuffle under
//            EQUAL variance → timing is REAL, not a variance artifact. This directly removes the
//            confound H_1423 named. Run at n ∈ {4,6,8}, T=64.
//
// faithful IIT4 exact MIP-EI (a_phi_iit4_tool), n<=8. proxy 아님. 3 seeds [7,8,9], deterministic.
// run from hexa-lang root: cp <this> <hexa-lang>/ && hexa run h1424_thalamus_scale.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*, == H_1423) ───────────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// gen_traj — engine-native salience trajectory, PARAMETRIC in n_mod and t_ticks.
//   lens: 0=R8-original(absolute multiplicative carrier)
//         3=LC additive-order-param
//         4=Lens E amplitude-controlled phase-coherent gate (unit-norm per-module read-out)
//   mode: 0=ARM A direct  1=ARM B gate ON  2=SHUFFLE  3=ABLATE
// amp_ctrl: when true, unit-norm each module's salience time-series after the gate (Lens E core).
// Content update IDENTICAL across arms (binding is TIMING, not content). All frozen R8 constants.
fn gen_traj(seed: int, lens: int, mode: int, n_mod: int, t_ticks: int, amp_ctrl: bool) -> int {
    let dim = 8
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let lam = 0.5
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    // states (n_mod x dim) init ~ N(0,1)*0.5
    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    // inputs (n_mod x t x dim) ~ N(0,1)*0.8 flat
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    // phase init + detuned omega
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }
    // shuffle offsets (t x n_mod) from a DISTINCT sub-stream (seed*100003+8) — same as R8/H_1423
    let mut shuf_off = []
    if mode == 2 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    // raw salience buffer (n_mod x t_ticks), row-major per module
    let raw = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        // content update (IDENTICAL all modes)
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        // Kuramoto phase update (when a gate is active)
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // per-module energy
        let mut energy = []
        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            energy = energy + [e]
            i = i + 1
        }
        // consensus phase + order param R (over actual phases)
        let mut cx = 0.0
        let mut cy = 0.0
        i = 0
        while i < n_mod { cx = cx + cos(theta[i])  cy = cy + sin(theta[i])  i = i + 1 }
        cx = cx / to_float(n_mod)
        cy = cy / to_float(n_mod)
        let bigr = sqrt(cx * cx + cy * cy)
        let cons = atan2(cy, cx)
        let mut emean = 0.0
        i = 0
        while i < n_mod { emean = emean + energy[i]  i = i + 1 }
        emean = emean / to_float(n_mod)

        // salience read-out, per lens × mode
        i = 0
        while i < n_mod {
            let e = energy[i]
            let mut sal = e
            let mut off = 0.0
            if mode == 2 { off = shuf_off[tt * n_mod + i] }

            if mode == 0 {
                sal = e
            } else if lens == 0 {
                // R8 original absolute-phase multiplicative carrier (anchor)
                if mode == 3 { sal = e } else {
                    let carrier = 0.5 * (1.0 + cos(theta[i] + off))
                    sal = e * carrier
                }
            } else if lens == 3 {
                // LC additive order-param bias (no multiplicative carrier)
                if mode == 3 {
                    sal = e
                } else {
                    let mut rr = bigr
                    if mode == 2 {
                        let mut sx = 0.0
                        let mut sy = 0.0
                        let mut k = 0
                        while k < n_mod {
                            let p2 = theta[k] + shuf_off[tt * n_mod + k]
                            sx = sx + cos(p2)  sy = sy + sin(p2)  k = k + 1
                        }
                        sx = sx / to_float(n_mod)
                        sy = sy / to_float(n_mod)
                        rr = sqrt(sx * sx + sy * sy)
                    }
                    sal = e + lam * rr * emean
                }
            } else {
                // lens == 4 : Lens E phase-coherent gate (same multiplicative gate as LB coherence,
                // gate = 0.5*(1+cos(theta_i - cons))); ablate = const 0.5. The amplitude-CONTROL is
                // applied AFTER the full time-series is built (unit-norm per module), below.
                if mode == 3 {
                    sal = e * 0.5
                } else {
                    let ph = theta[i] + off
                    let coh = 0.5 * (1.0 + cos(ph - cons))
                    sal = e * coh
                }
            }
            let _ = farr_set(raw, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }

    // ── Lens E amplitude-control: unit-norm each module's salience time-series ──
    // After this, every module (in EVERY arm: B, SHUFFLE, ablate) has mean 0 and std 1 over time,
    // so per-unit VARIANCE is IDENTICAL. Only the TIMING/phase structure of the salience can then
    // drive faithful-IIT4 Φ. (ARM A is also normed for a fair baseline.)
    if amp_ctrl {
        i = 0
        while i < n_mod {
            // mean
            let mut m = 0.0
            let mut tj = 0
            while tj < t_ticks { m = m + farr_get(raw, i * t_ticks + tj)  tj = tj + 1 }
            m = m / to_float(t_ticks)
            // var
            let mut v = 0.0
            tj = 0
            while tj < t_ticks {
                let dx = farr_get(raw, i * t_ticks + tj) - m
                v = v + dx * dx
                tj = tj + 1
            }
            v = v / to_float(t_ticks)
            let mut sd = sqrt(v)
            if sd < 0.0000001 { sd = 0.0000001 }
            tj = 0
            while tj < t_ticks {
                let z = (farr_get(raw, i * t_ticks + tj) - m) / sd
                let _ = farr_set(raw, i * t_ticks + tj, z)
                tj = tj + 1
            }
            i = i + 1
        }
    }
    return raw
}

fn phi_of(seed: int, lens: int, mode: int, n_mod: int, t_ticks: int, amp_ctrl: bool) -> float {
    let traj = gen_traj(seed, lens, mode, n_mod, t_ticks, amp_ctrl)
    let phi = iit4_faithful_phi(traj, n_mod, t_ticks, 8)
    let _ = farr_free(traj)
    return phi
}

fn run_lens(name: string, lens: int, seeds: [int], n_mod: int, t_ticks: int, amp_ctrl: bool) {
    println("")
    let ac = if amp_ctrl { " [AMP-CTRL unit-norm]" } else { "" }
    println("=== LENS " + name + " (lens=" + to_string(lens) + ", n=" + to_string(n_mod)
        + ", T=" + to_string(t_ticks) + ")" + ac + " ===")
    let mut c2_all = true
    let mut c4_all = true
    let mut abl_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, lens, 0, n_mod, t_ticks, amp_ctrl)
        let pb = phi_of(s, lens, 1, n_mod, t_ticks, amp_ctrl)
        let psh = phi_of(s, lens, 2, n_mod, t_ticks, amp_ctrl)
        let pab = phi_of(s, lens, 3, n_mod, t_ticks, amp_ctrl)
        let dphi = pb - pa
        let dphi_sh = psh - pa
        let c2 = dphi >= 0.02
        let c4 = dphi_sh <= 0.0
        let abl_live = (pb - pab) >= 0.02
        if !c2 { c2_all = false }
        if !c4 { c4_all = false }
        if !abl_live { abl_all = false }
        let c2s = if c2 { "PASS" } else { "FAIL" }
        let c4s = if c4 { "PASS" } else { "FAIL" }
        let abs = if abl_live { "LIVE" } else { "INERT" }
        println("seed " + to_string(s)
            + ": A=" + pa.to_string() + " B=" + pb.to_string() + " ΔΦ=" + dphi.to_string() + " [" + c2s + "]"
            + "  SHUF ΔΦ=" + dphi_sh.to_string() + " [" + c4s + "]"
            + "  ABL B-ab=" + (pb - pab).to_string() + " [" + abs + "]")
        si = si + 1
    }
    let v2 = if c2_all { "PASS" } else { "FAIL" }
    let v4 = if c4_all { "PASS" } else { "FAIL" }
    let va = if abl_all { "LIVE" } else { "INERT" }
    println("  c2 (ΔΦ>=+0.02 every seed): " + v2
        + "  | c4 SHUFFLE (ΔΦ_sh<=0 every seed): " + v4
        + "  | ABLATION (B-ablate>=+0.02 every seed): " + va)
    if c2_all && c4_all && abl_all {
        println("  LENS VERDICT: 🟢 BREAKTHROUGH — engine-native lift, shuffle collapses, ablation LIVE")
    } else {
        println("  LENS VERDICT: 🧱 WALL — control(s) reject (no tune-to-green)")
    }
}

fn main() {
    println("H_1424 thalamus TIMING-axis — CONTINUED attack (Lens D larger-substrate + Lens E amplitude-controlled)")
    println("faithful IIT4 Φ (exact MIP-EI, n<=8) · seeds [7,8,9] · FROZEN R8 bars (c2 ΔΦ>=+0.02; c4 shuffle ΔΦ<=0; ablation B-ab>=+0.02) every seed")
    let seeds = [7, 8, 9]

    println("")
    println("########## LENS D — LARGER SUBSTRATE ((e) investment) ##########")
    println("# KEY TEST: at larger n / longer T, does phase-SHUFFLE finally COLLAPSE the lift?")
    // anchor R8-original carrier across the ladder
    run_lens("D/R8-carrier", 0, seeds, 4, 64, false)
    run_lens("D/R8-carrier", 0, seeds, 6, 64, false)
    run_lens("D/R8-carrier", 0, seeds, 8, 64, false)
    run_lens("D/R8-carrier", 0, seeds, 4, 256, false)
    run_lens("D/R8-carrier", 0, seeds, 6, 256, false)
    // LC additive-order across the ladder (the other carrier-variance lens)
    run_lens("D/LC-additive", 3, seeds, 6, 64, false)
    run_lens("D/LC-additive", 3, seeds, 8, 64, false)

    println("")
    println("########## LENS E — AMPLITUDE-CONTROLLED MEASUREMENT ((a) measurement-fix) ##########")
    println("# unit-norm per-module salience => variance IDENTICAL across B/SHUFFLE => only TIMING can drive Φ")
    run_lens("E/phase-coherent amp-ctrl", 4, seeds, 4, 64, true)
    run_lens("E/phase-coherent amp-ctrl", 4, seeds, 6, 64, true)
    run_lens("E/phase-coherent amp-ctrl", 4, seeds, 8, 64, true)

    println("")
    println("DONE")
}
