// flatrss.hexa — load-once flat-RSS proof: ONE gen_auto_load handle → N decodes.
// The eval-driver mechanism (g_eval_all loads once, all gates decode off the handle).
// If load-once works, RSS is flat across the N decodes (no per-decode whole-file reload).
import "core/generator.hexa"
fn main() {
    let ck = "/home/summer/clm_d768_gen.clm"
    let h = gen_auto_load(ck)
    println("HANDLE_OK=" + to_string(h["ok"]) + " kind=" + to_string(h["kind"]))
    let mut i = 0
    while i < 20 {
        let r = gen_auto_ideate_W(h, "consciousness arises: ", 40, 40, 0.7, 7 + i)
        println("decode" + to_string(i) + " len=" + to_string(byte_len(to_string(r["text"]))))
        i = i + 1
    }
    gen_auto_free(h)
    println("FLATRSS_DONE 20 decodes off ONE load")
}
