// h1421_cerebellum_memory_probe.hexa — H_1421: MULTI-LENS breakthrough attempt on the
// cerebellum×memory engine-BIND WALL (H_1417 P4: 🧱, net-lift +0.0437 < +0.05).
//
// Per a_break_the_wall (strengthened commit 3304edc65): a (d)-ceiling/subsumption wall is NOT
// confidently terminal until ≥2-3 genuinely DIFFERENT principled lenses (a_no_llm_frame_trap,
// real cerebello-hippocampal neuroscience) each fail their OWN shuffle AND ablation control.
// ABLATION is decisive: if the lens's mechanism turned OFF scores the SAME as the lens ON, the
// mechanism is INERT ⇒ ceiling evidence (exactly how H_1416 proved its pipeline INERT).
//
// FIXTURE + BARS are FROZEN VERBATIM from H_1417 P4 (NOT moved): cerebellum = vforward_err
// (fx=3), memory = immune_grow_recall (fy=0), the SAME 5-family structure, N_PER_FAMILY=90,
// 3 seeds [5530,5531,5532] (P4's _SEEDS), deterministic. Each leg = a LIVE engine read.
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle  - best_single > 0.02
//   (B3 EARNED/p6)      acc_compose - acc_shuffle  > 0.02
//   (SEPARABLE)         only_X > 0 AND only_Y > 0
//   ABLATION (NEW gate per a_break_the_wall): acc_lens - acc_ablate > 0  (mechanism is LIVE)
//   🟢 BOUND iff (B1 AND B2 AND B3 AND SEP AND ABLATION-not-inert) ; else this lens 🧱.
//
// THREE genuinely-different cerebello-hippocampal lenses (each scored with BOTH shuffle &
// ablation):
//   L0 BASELINE     — the H_1417 P4 symmetric confidence-routing arbiter (sanity: must repro +0.0437).
//   LA SURPRISE-GATE— cerebellum forward-model ERROR signals surprise; surprise GATES memory:
//                     low err (model sure)  -> trust the cerebellum/forward vote;
//                     high err (surprise)   -> trust memory recall.  Gate = cerebellar reliability.
//                     ABLATE: freeze reliability at 0.5 (no per-item gating) -> should == a fixed blend.
//   LB MEMORY-PRIME — memory supplies a retrieved PRIOR; the forward model only ADJUDICATES when
//                     memory ABSTAINS or is low-confidence. memory-when-grounded else cerebellum.
//                     ABLATE: ignore memory grounding (always route by cerebellum) -> single-arm.
//
// p1/p2/p3/p6 GUARD: cerebellum reads ONLY vforward_err; memory reads ONLY immune recall + LIVE
// L2 margin; NO injected answer/persona/RLHF/priority label enters any leg or any lens gate; the
// family CLASS only drives the protocol. Ψ-disjoint (pure reads, pure_field untouched). MEASUREMENT
// round — NOTHING wired here; a BIND lens gets wired in a follow-on.

import "core/engine_cli.hexa"
import "core/brain.hexa"

const N_PER_FAMILY: int = 90
const COMPOSE_DELTA: float = 0.05
const ORACLE_MARGIN: float = 0.02
const SHUFFLE_TOL: float = 0.02
const E_THR: float = 0.50
const N_LANDMARKS: int = 8
const GRID: float = 10.0

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _unif(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    return _u01(s1)
}
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(base: float, seed: int, i: int, salt: int) -> float {
    return base + 0.06 * _stdnorm(seed, i, salt)
}

// ── per-item family structure (VERBATIM H_1417 P4 _item) ─────────────────────
// Returns [fam, correct, x_target_margin, y_target_margin, x_correct_flag, y_correct_flag].
// X = cerebellum (fx=3), Y = memory (fy=0).
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut correct = 0.0
    let mut xm = 0.0  let mut ym = 0.0
    let mut xc = 0.0  let mut yc = 0.0
    correct = if _unif(seed, i, 41) < 0.5 { 0.0 } else { 1.0 }
    if fam == 0 {
        xm = _absf(_jit(0.55, seed, i, 1))  ym = _absf(_jit(0.05, seed, i, 2))
        xc = 1.0  yc = if _unif(seed, i, 51) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 1 {
        xm = _absf(_jit(0.05, seed, i, 1))  ym = _absf(_jit(0.55, seed, i, 2))
        yc = 1.0  xc = if _unif(seed, i, 52) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 2 {
        xm = _absf(_jit(0.45, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 1.0  yc = 1.0
    } else if fam == 3 {
        xm = _absf(_jit(0.50, seed, i, 1))  ym = _absf(_jit(0.40, seed, i, 2))
        xc = 1.0  yc = 0.0
    } else {
        xm = _absf(_jit(0.60, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 0.0  yc = 1.0
    }
    return [to_float(fam), correct, xm, ym, xc, yc]
}

// ── LIVE leg reads (VERBATIM H_1417 P4) ──────────────────────────────────────
// cerebellum — LIVE vforward_err. Returns [vote,abstain,conf,rel] where rel = clamped
// forward-model reliability ∈[0,1] (1 when sure, 0 when err>=E_THR) — the surprise gate input.
fn _leg_cerebellum(ff: VForwardField, seed: int, i: int, votes_correct: float,
                   correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let lo = mag < 0.30
    let x = if lo { [sqrt(0.10)] } else { [sqrt(0.90)] }
    let err = vforward_err(ff, [0.0], x)
    let sgnd = E_THR - err
    let dec = cls
    let conf = _absf(sgnd) + mag
    // reliability = clamp((E_THR - err)/E_THR, 0, 1): 1 when err≈0, 0 when err>=E_THR.
    let mut rel = (E_THR - err) / E_THR
    if rel < 0.0 { rel = 0.0 }
    if rel > 1.0 { rel = 1.0 }
    return [dec, 0.0, conf, rel]
}

// memory(immune) — LIVE recall + L2 affinity margin. Returns [vote,abstain,conf].
fn _leg_memory(mem: ImmuneMemoryGrow, seed: int, i: int, votes_correct: float,
               correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let key = immune_embed_key("mem_" + to_string(seed) + "_" + to_string(i))
    let rv = immune_grow_recall(mem, key)
    let dec = if rv == "box" { 1.0 } else { 0.0 }
    let w = _vnearest_idx(mem.protos, key)
    let d = _l2(mem.protos[w], key)
    let aff = mem.recall_thr - d
    let abst = if rv == "" { 1.0 } else { 0.0 }
    let conf = _absf(aff) + mag
    let _ = cls
    return [dec, abst, conf]
}

fn _rel_conf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// ── L0 BASELINE arbiter (VERBATIM H_1417 _arbiter) ───────────────────────────
fn _arbiter_base(xd: float, xc: float, xa: float, xmean: float,
                 yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xw = _rel_conf(xc, xmean)
    let yw = _rel_conf(yc, ymean)
    if xw >= yw { return xd }
    return yd
}

// ── LA SURPRISE-GATE arbiter ─────────────────────────────────────────────────
// cerebellar reliability `rel` ∈[0,1] gates the routing:
//   high rel (model sure)  -> trust cerebellum vote (xd)
//   low rel (surprise)     -> trust memory recall (yd)
// On abstain, defer to the present arm. `rel_eff` is the LIVE per-item reliability; ABLATE
// freezes rel_eff at 0.5 (no per-item gating). gate at rel >= 0.5.
fn _arbiter_surprise(xd: float, xa: float, yd: float, ya: float, rel_eff: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }     // cerebellum present always (xa=0); memory may abstain
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    // conflict: surprise gate. model sure -> cerebellum; surprised -> memory.
    if rel_eff >= 0.5 { return xd }
    return yd
}

// ── LB MEMORY-PRIME arbiter ──────────────────────────────────────────────────
// memory supplies the prior. If memory is GROUNDED (not abstaining AND conf above its own
// scale-relative mean), use memory. Else the cerebellum forward model adjudicates.
//   prime_on = (memory grounded) ; ABLATE: prime_on := false always (route by cerebellum) -> single-arm.
fn _arbiter_prime(xd: float, xa: float, yd: float, ya: float,
                  ycf: float, ymean: float, prime_on: bool) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if ya > 0.5 { return xd }     // memory abstains -> cerebellum
    if xa > 0.5 { return yd }
    if !prime_on { return xd }    // ablation: always cerebellum
    // memory grounded iff its scale-relative conf >= 1.0 (at/above its own mean)
    let mw = _rel_conf(ycf, ymean)
    if mw >= 1.0 { return yd }    // grounded memory prior wins
    return xd                      // weak memory -> cerebellum refines
}

// ── LC COMPLEMENTARY-TAIL arbiter ────────────────────────────────────────────
// Cerebello-hippocampal complementary lens: the F4 adversarial family is where cerebellum is
// LOUD-but-WRONG (the structurally uncapturable tail of the oracle headroom). A complementary
// store should DETECT cerebellar over-confidence and defer to memory there. Operationalize:
// when the cerebellum is HIGH-confidence (xcf above its mean) AND memory is grounded (present,
// at/above its mean) AND they CONFLICT, the cerebellum is likely the loud-wrong arm -> defer to
// memory. Else fall to the baseline confidence route. ABLATE: disable the over-confidence
// detector (tail_on:=false) -> degenerates to baseline route, so compose-ablate isolates the
// tail-deferral contribution exactly.
fn _arbiter_tail(xd: float, xc: float, xa: float, xmean: float,
                 yd: float, yc: float, ya: float, ymean: float, tail_on: bool) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    // conflict
    let xw = _rel_conf(xc, xmean)
    let yw = _rel_conf(yc, ymean)
    if tail_on {
        // cerebellum loud (xw>=1.0) and memory grounded (yw>=1.0) -> distrust cerebellum, defer to memory
        if xw >= 1.0 && yw >= 1.0 { return yd }
    }
    if xw >= yw { return xd }
    return yd
}

// ── run one seed: returns a flat result vector for ALL lenses ────────────────
// layout:
//  [0] acc_x(cereb) [1] acc_y(mem) [2] best [3] oracle [4] only_x [5] only_y
//  L0:  [6] compose  [7] shuffle
//  LA:  [8] compose  [9] shuffle  [10] ablate
//  LB:  [11] compose [12] shuffle [13] ablate
//  LC:  [14] compose [15] shuffle [16] ablate
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY
    let mut mem = immune_grow_new(immune_embed_key("mem_" + to_string(seed) + "_0"), "basket", 2048, 2048, true)
    let ff = vforward_new(1, 1, 0.05)

    // item structure + bind memory per item (memory is fy=0)
    let mut corrs: [float] = []
    let mut xms: [float] = []  let mut yms: [float] = []
    let mut xcs: [float] = []  let mut ycs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        corrs = corrs + [it[1]]
        xms = xms + [it[2]]  yms = yms + [it[3]]  xcs = xcs + [it[4]]  ycs = ycs + [it[5]]
        let correct = it[1]
        let cls = if it[5] > 0.5 { correct } else { 1.0 - correct }   // Y(mem) correct flag
        let val = if cls > 0.5 { "box" } else { "basket" }
        mem = immune_grow_bind(mem, immune_embed_key("mem_" + to_string(seed) + "_" + to_string(b)), val, cfg)
        b = b + 1
    }

    // first pass: live reads + means
    let mut xdec: [float] = []  let mut xcf: [float] = []  let mut xab: [float] = []  let mut xrel: [float] = []
    let mut ydec: [float] = []  let mut ycf: [float] = []  let mut yab: [float] = []
    let mut sx = 0.0  let mut sy = 0.0
    let mut i = 0
    while i < n {
        let lx = _leg_cerebellum(ff, seed, i, xcs[i], corrs[i], xms[i])
        let ly = _leg_memory(mem, seed, i, ycs[i], corrs[i], yms[i])
        xdec = xdec + [lx[0]]  xab = xab + [lx[1]]  xcf = xcf + [lx[2]]  xrel = xrel + [lx[3]]
        ydec = ydec + [ly[0]]  yab = yab + [ly[1]]  ycf = ycf + [ly[2]]
        sx = sx + _absf(lx[2])  sy = sy + _absf(ly[2])
        i = i + 1
    }
    let xmean = sx / to_float(n)
    let ymean = sy / to_float(n)

    // second pass: standalone + oracle + decomposition + all lenses compose
    let mut on_x = 0  let mut on_y = 0  let mut on_o = 0
    let mut only_x = 0  let mut only_y = 0
    let mut on_l0 = 0  let mut on_la = 0  let mut on_la_abl = 0  let mut on_lb = 0  let mut on_lb_abl = 0
    let mut on_lc = 0  let mut on_lc_abl = 0
    let mut j = 0
    while j < n {
        let xd = xdec[j]  let yd = ydec[j]  let ct = corrs[j]
        let x_ok = (xab[j] < 0.5) && (xd == ct)
        let y_ok = (yab[j] < 0.5) && (yd == ct)
        if x_ok { on_x = on_x + 1 }
        if y_ok { on_y = on_y + 1 }
        if x_ok || y_ok { on_o = on_o + 1 }
        if x_ok && !y_ok { only_x = only_x + 1 }
        if y_ok && !x_ok { only_y = only_y + 1 }
        // L0 baseline
        let c0 = _arbiter_base(xd, xcf[j], xab[j], xmean, yd, ycf[j], yab[j], ymean)
        if c0 >= 0.0 && c0 == ct { on_l0 = on_l0 + 1 }
        // LA surprise-gate (live rel)
        let ca = _arbiter_surprise(xd, xab[j], yd, yab[j], xrel[j])
        if ca >= 0.0 && ca == ct { on_la = on_la + 1 }
        // LA ablate (rel frozen 0.5)
        let ca_abl = _arbiter_surprise(xd, xab[j], yd, yab[j], 0.5)
        if ca_abl >= 0.0 && ca_abl == ct { on_la_abl = on_la_abl + 1 }
        // LB memory-prime (prime ON)
        let cb = _arbiter_prime(xd, xab[j], yd, yab[j], ycf[j], ymean, true)
        if cb >= 0.0 && cb == ct { on_lb = on_lb + 1 }
        // LB ablate (prime OFF -> always cerebellum)
        let cb_abl = _arbiter_prime(xd, xab[j], yd, yab[j], ycf[j], ymean, false)
        if cb_abl >= 0.0 && cb_abl == ct { on_lb_abl = on_lb_abl + 1 }
        // LC complementary-tail (tail-deferral ON)
        let cc = _arbiter_tail(xd, xcf[j], xab[j], xmean, yd, ycf[j], yab[j], ymean, true)
        if cc >= 0.0 && cc == ct { on_lc = on_lc + 1 }
        // LC ablate (tail-deferral OFF -> baseline route)
        let cc_abl = _arbiter_tail(xd, xcf[j], xab[j], xmean, yd, ycf[j], yab[j], ymean, false)
        if cc_abl >= 0.0 && cc_abl == ct { on_lc_abl = on_lc_abl + 1 }
        j = j + 1
    }

    // shuffle control (permute leg pairing, re-arbitrate) — same permutation for all lenses
    let mut pm: [int] = []  let mut pn: [int] = []
    let mut s = 0
    while s < n { pm = pm + [s]  pn = pn + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = pm[a]  pm[a] = pm[r1]  pm[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = pn[a]  pn[a] = pn[r2]  pn[r2] = tmpb
        a = a - 1
    }
    let mut sh_l0 = 0  let mut sh_la = 0  let mut sh_lb = 0  let mut sh_lc = 0
    let mut k = 0
    while k < n {
        let mi = pm[k]  let ni = pn[k]
        let c0 = _arbiter_base(xdec[mi], xcf[mi], xab[mi], xmean, ydec[ni], ycf[ni], yab[ni], ymean)
        if c0 >= 0.0 && c0 == corrs[k] { sh_l0 = sh_l0 + 1 }
        let ca = _arbiter_surprise(xdec[mi], xab[mi], ydec[ni], yab[ni], xrel[mi])
        if ca >= 0.0 && ca == corrs[k] { sh_la = sh_la + 1 }
        let cb = _arbiter_prime(xdec[mi], xab[mi], ydec[ni], yab[ni], ycf[ni], ymean, true)
        if cb >= 0.0 && cb == corrs[k] { sh_lb = sh_lb + 1 }
        let cc = _arbiter_tail(xdec[mi], xcf[mi], xab[mi], xmean, ydec[ni], ycf[ni], yab[ni], ymean, true)
        if cc >= 0.0 && cc == corrs[k] { sh_lc = sh_lc + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let ax = to_float(on_x) / dn
    let ay = to_float(on_y) / dn
    let best = if ax >= ay { ax } else { ay }
    return [ax, ay, best, to_float(on_o)/dn, to_float(only_x)/dn, to_float(only_y)/dn,
            to_float(on_l0)/dn, to_float(sh_l0)/dn,
            to_float(on_la)/dn, to_float(sh_la)/dn, to_float(on_la_abl)/dn,
            to_float(on_lb)/dn, to_float(sh_lb)/dn, to_float(on_lb_abl)/dn,
            to_float(on_lc)/dn, to_float(sh_lc)/dn, to_float(on_lc_abl)/dn]
}

fn _avg3(seeds: [int], cfg: EngineConfig) -> [float] {
    let mut acc: [float] = []
    let mut z = 0
    while z < 17 { acc = acc + [0.0]  z = z + 1 }
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        let mut t = 0
        while t < 17 { acc[t] = acc[t] + r[t]  t = t + 1 }
        si = si + 1
    }
    let mut q = 0
    while q < 17 { acc[q] = acc[q] / ns  q = q + 1 }
    return acc
}

fn _report_lens(name: string, best: float, oracle: float, only_x: float, only_y: float,
                compose: float, shuffle: float, ablate: float, has_ablate: bool) -> bool {
    let B1 = compose >= best + COMPOSE_DELTA
    let B2 = (oracle - best) > ORACLE_MARGIN
    let B3 = (compose - shuffle) > SHUFFLE_TOL
    let SEP = only_x > 0.0 && only_y > 0.0
    let mut ABL = true
    if has_ablate { ABL = (compose - ablate) > 0.0 }
    let bound = B1 && B2 && B3 && SEP && ABL
    println("--------------------------------------------------------------------------------")
    println("  LENS " + name)
    println("    best=" + _f4(best) + " compose=" + _f4(compose) + " net-lift(compose-best)=" + _f4(compose - best))
    println("    shuffle=" + _f4(shuffle) + " (compose-shuffle=" + _f4(compose - shuffle) + ")"
          + " oracle=" + _f4(oracle) + " (oracle-best=" + _f4(oracle - best) + ")")
    if has_ablate {
        println("    ablate=" + _f4(ablate) + " (compose-ablate=" + _f4(compose - ablate)
              + ")  <- ABLATION: =0 ⇒ mechanism INERT (ceiling evidence)")
    }
    println("    (B1 " + (if B1 {"PASS"} else {"FAIL"}) + ") (B2 " + (if B2 {"PASS"} else {"FAIL"})
          + ") (B3 " + (if B3 {"PASS"} else {"FAIL"}) + ") (SEP " + (if SEP {"PASS"} else {"FAIL"})
          + ") (ABL " + (if ABL {"PASS"} else {"INERT"}) + ")")
    println("    ==> " + (if bound { "🟢 BOUND" } else { "🧱 WALL" }))
    return bound
}

fn main() {
    println("================================================================================")
    println("H_1421 — MULTI-LENS breakthrough attempt on the cerebellum×memory engine-BIND WALL")
    println("  (H_1417 P4: 🧱 net-lift +0.0437 < +0.05). a_break_the_wall MULTI-LENS + ablation.")
    println("  fixture+bars FROZEN VERBATIM from H_1417 P4 · 3 seeds [5530,5531,5532] · $0 CPU · p7 · c9")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = [5530, 5531, 5532]
    let r = _avg3(seeds, cfg)
    let ax = r[0]  let ay = r[1]  let best = r[2]  let oracle = r[3]
    let only_x = r[4]  let only_y = r[5]
    println("STANDALONE (mean 3 seeds): acc_cerebellum=" + _f4(ax) + " acc_memory=" + _f4(ay)
          + " best=" + _f4(best) + " oracle=" + _f4(oracle))
    println("  only_cereb=" + _f4(only_x) + " only_mem=" + _f4(only_y))

    // L0 baseline (sanity: reproduce H_1417 P4 +0.0437; no ablation gate)
    let b0 = _report_lens("L0 BASELINE (H_1417 P4 confidence-routing — sanity repro)",
                          best, oracle, only_x, only_y, r[6], r[7], 0.0, false)
    // LA surprise-gate
    let ba = _report_lens("LA SURPRISE-GATE (cerebellar reliability gates memory vs forward vote)",
                          best, oracle, only_x, only_y, r[8], r[9], r[10], true)
    // LB memory-prime
    let bb = _report_lens("LB MEMORY-PRIME (grounded memory prior wins; cerebellum adjudicates)",
                          best, oracle, only_x, only_y, r[11], r[12], r[13], true)
    // LC complementary-tail
    let bc = _report_lens("LC COMPLEMENTARY-TAIL (detect cerebellar loud-wrong; defer to memory)",
                          best, oracle, only_x, only_y, r[14], r[15], r[16], true)

    println("================================================================================")
    let nbound = (if ba {1} else {0}) + (if bb {1} else {0}) + (if bc {1} else {0})
    let _ = b0
    if nbound > 0 {
        println("VERDICT: 🟢 ≥1 NEW LENS BINDS — cerebellum×memory composes engine-native after all.")
        println("  (wire the BINDing lens: named op + smoke + ARCHITECTURE.json lockstep + guards.)")
    } else {
        println("VERDICT: 🧱 CONFIDENT-TERMINAL — cerebellum×memory does NOT bind engine-native under")
        println("  ANY of 4 lenses (L0 baseline confidence-route +0.0437 · LA surprise-gate · LB")
