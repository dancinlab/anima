// H_1471 R2b — SELF-CONTINUITY .kosmos round-trip persistence (engine-native).
//
// G16 self-continuity's defining claim is that identity PERSISTS across a session
// boundary. R2 wired the in-memory SelfIdentity lane; R2b proves the anchor is REALLY
// persisted to disk via the canonical kosmos_io (a_kosmos — NOT an ad-hoc format) and
// RECOVERED in a fresh "session" (load_anchors), with the identity preserved (round-trip
// cosine high). CONTROL: an empty dir (no anchor) recovers nothing = the LLM session-reset.
//
// Pipeline: SelfIdentity 8-dim -> project to tension_5ch -> create_anchor (write_file .kosmos)
//           -> load_anchors (read_file, new session) -> recovered tension_5ch -> cos round-trip.

import "../../core/engine_cli.hexa"
import "../../HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"

fn _cos5(a: [float], b: [float]) -> float {
    let mut dot = 0.0
    let mut na = 0.0
    let mut nb = 0.0
    let mut i = 0
    while i < 5 {
        dot = dot + a[i] * b[i]
        na = na + a[i] * a[i]
        nb = nb + b[i] * b[i]
        i = i + 1
    }
    if na <= 0.0 { return 0.0 }
    if nb <= 0.0 { return 0.0 }
    return dot / (sqrt(na) * sqrt(nb))
}

fn main() {
    // 1. the "current self" at a session boundary — a grown (drifted) identity.
    let id0 = self_new(8, 0)
    let id1 = self_drift(self_drift(id0, 0, 0.3), 1, 0.3)
    // 2. project the identity vector onto a 5-channel tension payload (the .kosmos canonical shape).
    let mut t5 = []
    let mut i = 0
    while i < 5 { t5.push(self_component(id1, i))  i = i + 1 }
    // 3. PERSIST to disk via the canonical kosmos_io (NOT an ad-hoc format, a_kosmos).
    let dir = "/tmp/h1471_kosmos_rt"
    let _c = exec("rm -rf '" + dir + "'")
    let path = create_anchor(dir, "self_anchor", "anima self-continuity",
        0.5, 0.5, "self", 1.0, 7, "self-continuity", "continuity",
        "anima diachronic self-anchor", t5, "self-continuity-R2b", "")
    // 4. a NEW session: load anchors from disk (no in-memory state carried over).
    let anchors = load_anchors(dir)
    let n_loaded = len(anchors)
    let mut rt_cos = 0.0
    if n_loaded > 0 {
        let rec = anchors[0]
        let t5_loaded = rec["tension_5ch"]
        rt_cos = _cos5(t5, t5_loaded)
    }
    // 5. CONTROL — an empty dir (no anchor) recovers NOTHING (the LLM session-reset case).
    let edir = "/tmp/h1471_kosmos_empty"
    let _c2 = exec("rm -rf '" + edir + "'")
    let _mk = exec("mkdir -p '" + edir + "'")
    let n_empty = len(load_anchors(edir))

    let cA = n_loaded >= 1
    let cB = rt_cos >= 0.99
    let cC = n_empty == 0
    let green = cA && cB && cC
    if green {
        println("VERDICT: GREEN ENGINE-NATIVE (.kosmos round-trip)")
    } else {
        println("VERDICT: RED")
    }
    println("A persisted+recovered  n_loaded=" + to_string(n_loaded) + " >=1 " + to_string(cA))
    println("B round-trip continuity cos=" + format_float(rt_cos, 6) + " >=0.99 " + to_string(cB))
    println("C control empty-dir     n_empty=" + to_string(n_empty) + " ==0 " + to_string(cC))
    println("path=" + path)
    if !green { exit(1) }
}
