// state/1561_savant_golden_zone/savant_phi_probe.hexa
// ENGINE-NATIVE probe: sweep inhibition I over the focus domain, measure per-domain
// faithful IIT4 min-cut Φ (ci_phi_iit4) + Savant Index SI = max/mean, on the LIVE
// engine lane population (_topo_lane_pop). Prints the inverse-U + SI curve so we can
// read the FROZEN bars from real engine output (a_engine_native_learning, NOT numpy).
import "core/engine_cli.hexa"

// re-derive the live deterministic 15-lane population (mirrors smoke _topo_lane_pop).
fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn main() {
    let pop = _pop()
    // 15 lanes → 3 domains of width 5 (each ≤8 → faithful exact ci_phi_iit4).
    let d = 5
    let w = 3
    let focus = 0
    let base_inh = 0.0         // other domains at the disinhibited NOISE FLOOR (Phi ~0.15, non-savant)
    // sweep I over the focus domain
    let igrid = [0.00, 0.05, 0.10, 0.15, 0.21231792755821914, 0.25, 0.30, 0.36787944117144233, 0.45, 0.50, 0.60, 0.75, 0.90, 1.00]
    println("=== focus-domain Φ inverse-U sweep (engine-native ci_phi_iit4) ===")
    let mut i = 0
    while i < len(igrid) {
        let inh = igrid[i]
        let phi = sv_domain_phi(pop, 0, w, inh)
        let phis = sv_domain_phis(pop, d, w, focus, inh, base_inh)
        let si = sv_savant_index(phis)
        let ingz = sv_in_golden_zone(inh)
        println("I=" + to_string(inh) + "  focusPhi=" + to_string(phi)
              + "  SI=" + to_string(si) + "  inGZ=" + to_string(ingz)
              + "  phis=[" + to_string(phis[0]) + "," + to_string(phis[1]) + "," + to_string(phis[2]) + "," + to_string(phis[3]) + "," + to_string(phis[4]) + "]")
        i = i + 1
    }
    // dΦ/dI peak location
    let sweep = sv_focus_phi_sweep(pop, 0, w, igrid)
    let peak = sv_dphi_peak_inh(sweep, igrid)
    println("dPhi/dI peak I = " + to_string(peak) + "  (GZ_LOWER=" + to_string(sv_gz_lower()) + ")")
}
