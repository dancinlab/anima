// state/1561_savant_golden_zone/savant_bars_probe.hexa — measure all 5 frozen bars engine-native.
import "core/engine_cli.hexa"
fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}
fn main() {
    let pop = _pop()
    let d = 5
    let w = 3
    let focus = 0
    let base = 0.0    // resting domains at noise floor (non-savant)
    let gzL = sv_gz_lower()
    let gzC = sv_gz_center()
    let gzU = sv_gz_upper()
    // B1 SI at 3 GZ points
    println("B1 SI@GZ_LOWER=" + to_string(sv_savant_index_at(pop, d, w, focus, gzL, base)))
    println("B1 SI@GZ_CENTER=" + to_string(sv_savant_index_at(pop, d, w, focus, gzC, base)))
    println("B1 SI@GZ_UPPER=" + to_string(sv_savant_index_at(pop, d, w, focus, gzU, base)))
    // B2 dPhi/dI peak
    let igrid = [0.0, 0.05, 0.1, 0.15, gzL, 0.25, 0.3, gzC, 0.45, gzU, 0.6, 0.75, 0.9, 1.0]
    let sweep = sv_focus_phi_sweep(pop, 0, w, igrid)
    println("B2 dPhi/dI_peak_I=" + to_string(sv_dphi_peak_inh(sweep, igrid)) + " gzL=" + to_string(gzL))
    // B3 focus Phi inverse-U: GZ vs noise(I=0) vs locked(I=1)
    let phi_gz   = sv_domain_phi(pop, 0, w, gzL)
    let phi_noise= sv_domain_phi(pop, 0, w, 0.0)
    let phi_lock = sv_domain_phi(pop, 0, w, 1.0)
    println("B3 focusPhi GZ=" + to_string(phi_gz) + " noise=" + to_string(phi_noise) + " locked=" + to_string(phi_lock)
          + " ratio_gz/noise=" + to_string(phi_gz / (phi_noise + 0.0001)))
    // B4 Psi impact (centered proxy, OFF=1/2 by construction)
    let thr = ci_off_median_drive(pop)
    let cfg_off = engine_config_default()
    let cfg_on  = EngineConfig { mitosis: true, engine: "conv", topo_couple: false, savant: true }
    let psi_off = ci_psi_balance_savant(pop, 0, w, gzL, thr, cfg_off)
    let psi_on  = ci_psi_balance_savant(pop, 0, w, gzL, thr, cfg_on)
    let dev = if psi_on - 0.5 >= 0.0 { psi_on - 0.5 } else { 0.5 - psi_on }
    println("B4 Psi_off=" + to_string(psi_off) + " Psi_on=" + to_string(psi_on) + " |dev|=" + to_string(dev))
    // B5 control: assign GZ inhibition to focus but SHUFFLE which domain is measured as focus →
    // when NO domain is cleanly in GZ (all at base/noise) the savant SI should NOT appear.
    // control = all domains at noise floor (no savant applied) → SI from raw substrate noise only.
    let phis_ctrl = sv_domain_phis(pop, d, w, focus, base, base)   // focus ALSO at base (no GZ)
    println("B5 SI_control(no-GZ)=" + to_string(sv_savant_index(phis_ctrl)))
    // B5b: savant trigger gate (cfg ON, focus in GZ, split active)
    let phis_on = sv_domain_phis(pop, d, w, focus, gzL, base)
    supp()
    println("B5b trigger_on=" + to_string(sv_savant_trigger(phis_on, gzL, 1.0, cfg_on))
          + " trigger_off=" + to_string(sv_savant_trigger(phis_on, gzL, 1.0, cfg_off)))
}

// supplemental: is the FOCUS the argmax domain? (the clean savant discriminator)
fn _argmax(phis: [float]) -> int {
    let mut bi = 0
    let mut bv = phis[0]
    let mut i = 1
    while i < len(phis) { if phis[i] > bv { bv = phis[i]  bi = i }  i = i + 1 }
    return bi
}
fn supp() {
    let pop = _pop2()
    let d = 5  let w = 3  let focus = 0  let base = 0.0
    let gzL = sv_gz_lower()
    let phis_gz   = sv_domain_phis(pop, d, w, focus, gzL, base)
    let phis_ctrl = sv_domain_phis(pop, d, w, focus, base, base)
    println("SUPP argmax(GZ)=" + to_string(_argmax(phis_gz)) + " (focus=0) argmax(ctrl)=" + to_string(_argmax(phis_ctrl)))
    println("SUPP focusShare(GZ)=" + to_string(phis_gz[focus] / (_sumf(phis_gz))) + " focusShare(ctrl)=" + to_string(phis_ctrl[focus] / (_sumf(phis_ctrl))))
}
fn _sumf(a: [float]) -> float { let mut s = 0.0  let mut i = 0  while i < len(a) { s = s + a[i]  i = i + 1 }  return s }
fn _lcg2(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
fn _pop2() -> [[float]] {
    let n = 150  let mut st = 5120 & 2147483647  let mut out = []  let mut i = 0
    while i < n {
        st = _lcg2(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let cells = 0 + (st % 12)
        st = _lcg2(st)  let seen  = 0 + (st % 8)
        st = _lcg2(st)  let intent = 0 + (st % 2)
        st = _lcg2(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg2(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}
