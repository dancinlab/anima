// ════════════════════════════════════════════════════════════════════════
// state/1565_thirdlaw_neuromod/h1565_thirdlaw_neuromod_probe.hexa
//
// H_1565 — 1/3 LAW × H_1284 NEUROMODULATION WALL — same-origin or independent?
//
// QUESTION: H_1560 (§ThirdLaw) found the G6 CAPACITY-wall is the expression of a
// scale-invariant 1/3 structural constant (G=D·P/I golden-zone singularity ≈ 0.339,
// I50 ≈ 0.281). H_1284 found a SEPARATE wall: a context-adaptive NEUROMODULATION
// controller (DA gain / NE exploration / ACh plasticity) NEVER beats best-fixed
// hyperparameters — 0/3 regimes, a "no-free-lunch" ceiling re-confirmed by 14+ lenses
// (H_1509/1523/1524/1528/1532…). Are these TWO walls the SAME 1/3 origin, or independent?
//
// BRIDGE (engine-native, deterministic, p7-clean): the H_1284 neuromod controller's
// real lever is the store's EFFECTIVE INHIBITION I (abstain-margin / split-threshold /
// plasticity-rate all gate which cells fire/consolidate). Model the controller as a
// BOUNDED disinhibition nudge δ on I (the neuromod amplitude). At operating point
// (D,P,I) the controller is EFFECTIVE iff disinhibiting by δ moves the point INTO the
// §ThirdLaw ability-expression manifold it was NOT already in:
//     neuromod_effective(D,P,I) = third_law_ability(D,P,I) == 0
//                              AND third_law_ability(D,P, I−δ) == 1
// i.e. neuromod only "works" where it can push I across into the 1/3 reopening
// manifold (golden-zone ∧ singularity, H_1560 R2). Everywhere else (already-ON, or
// δ cannot reach the GZ singularity) it is INERT — exactly the H_1284 result.
//
// ENGINE-NATIVE: calls LIVE core/engine_cli.hexa §ThirdLaw ops (third_law_ability /
// third_law_singularity / third_law_score) which REUSE SAVANT sa_in_golden_zone, plus
// the canonical GZ constants. NO numpy / NO torch (a_engine_native_learning).
//
// ⚠️ SCOPE (c9): this is the G=D×P/I GEOMETRY classifier of the neuromod operating
// space, NOT a re-run of the H_1284 learning store. The link it tests is whether the
// neuromod-EFFECTIVE region is the SAME 1/3 manifold as the capacity wall.
//
// frozen 5-bar (pre-registered BEFORE measurement, c9 frozen-first):
//   B1 ratio      : fraction of (D×P×I) space where neuromod is effective ≈ 1/3 (±0.03)
//   B2 scale-inv  : ratio stable across grid 8K / 100K / 1M (Δ < 0.02)
//   B3 overlap    : neuromod-effective ⊂ §ThirdLaw singularity manifold
//                   (P(effective ⇒ landing-point is a singularity) == 1.0; capacity-wall
//                    same manifold)  AND ratio differs from the 0.339 capacity baseline
//                    enough to be its OWN sub-region (effective is the BOUNDARY shell).
//   B4 transition : effective/ineffective transition at I ≈ 0.27–0.28 (H_1560 I50)
//   B5 control    : shuffled / random "neuromod" target → ratio ≠ 1/3 (rule out chance)
//
// 사용법: hexa run state/1565_thirdlaw_neuromod/h1565_thirdlaw_neuromod_probe.hexa
// ════════════════════════════════════════════════════════════════════════

import "core/engine_cli.hexa"

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }  return x }

fn _linspace(a: float, b: float, n: int) -> [float] {
    let mut out = []
    if n <= 1 { out = out + [a]  return out }
    let step = (b - a) / to_float(n - 1)
    let mut i = 0
    while i < n { out = out + [a + step * to_float(i)]  i = i + 1 }
    return out
}

// FROZEN neuromod disinhibition amplitude δ — the controller's bounded inhibition nudge.
// 0.10 = H_1284 controller LR/abstain swing scale (the controller moved LR 0.05..0.20,
// abstain 0.45..0.60 — an O(0.10–0.15) effective-inhibition excursion). Frozen pre-measure.
fn _nm_delta() -> float { return 0.10 }

// neuromod_effective(D,P,I,δ) — 1 iff the controller's δ-disinhibition REOPENS ability at
// (D,P,I) that was not already expressed: ability(D,P,I)==0 AND ability(D,P,I−δ)==1.
// LIVE engine ops only (third_law_ability reuses sa_in_golden_zone).
fn nm_effective(d: float, p: float, ii: float, dl: float) -> int {
    let id = ii - dl
    if id <= 0.0 { return 0 }
    if third_law_ability(d, p, ii) == 0 && third_law_ability(d, p, id) == 1 { return 1 }
    return 0
}

// nm_ratio — fraction of the (D×P×I) sweep where neuromod is effective (B1/B2).
// Grid = the H_1560 sweep [0.05,0.95]^3 at resolution nD×nP×nI.
fn nm_ratio(nD: int, nP: int, nI: int, dl: float) -> float {
    let dg = _linspace(0.05, 0.95, nD)
    let pg = _linspace(0.05, 0.95, nP)
    let ig = _linspace(0.05, 0.95, nI)
    let mut tot = 0
    let mut eff = 0
    let mut a = 0
    while a < nI {
        let ii = ig[a]
        let mut b = 0
        while b < nD {
            let d = dg[b]
            let mut c = 0
            while c < nP {
                tot = tot + 1
                if nm_effective(d, pg[c], ii, dl) == 1 { eff = eff + 1 }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if tot == 0 { return 0.0 }
    return to_float(eff) / to_float(tot)
}

// nm_overlap_into_singularity — B3: of the points where neuromod is effective, the
// fraction whose LANDING point (I−δ) is a §ThirdLaw singularity. Should be 1.0 by the
// ability definition (ability ⊂ singularity) → the effective set lands ENTIRELY inside
// the 1/3 singularity manifold = SAME ORIGIN. Returns -1 if no effective points.
fn nm_overlap_into_singularity(nD: int, nP: int, nI: int, dl: float) -> float {
    let dg = _linspace(0.05, 0.95, nD)
    let pg = _linspace(0.05, 0.95, nP)
    let ig = _linspace(0.05, 0.95, nI)
    let mut eff = 0
    let mut land_sing = 0
    let mut a = 0
    while a < nI {
        let ii = ig[a]
        let mut b = 0
        while b < nD {
            let d = dg[b]
            let mut c = 0
            while c < nP {
                let pp = pg[c]
                if nm_effective(d, pp, ii, dl) == 1 {
                    eff = eff + 1
                    if third_law_singularity(d, pp, ii - dl) == 1 { land_sing = land_sing + 1 }
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if eff == 0 { return 0.0 - 1.0 }
    return to_float(land_sing) / to_float(eff)
}

// nm_effective_rate_at_I — per-I effective rate over the (D×P) plane (B4 transition).
fn nm_effective_rate_at_I(ii: float, nDP: int, dl: float) -> float {
    let dg = _linspace(0.05, 0.95, nDP)
    let pg = _linspace(0.05, 0.95, nDP)
    let mut tot = 0
    let mut eff = 0
    let mut b = 0
    while b < nDP {
        let d = dg[b]
        let mut c = 0
        while c < nDP {
            tot = tot + 1
            if nm_effective(d, pg[c], ii, dl) == 1 { eff = eff + 1 }
            c = c + 1
        }
        b = b + 1
    }
    if tot == 0 { return 0.0 }
    return to_float(eff) / to_float(tot)
}

// nm_i50 — the I at which the per-I effective rate crosses 50% (rate FALLS as I grows past
// the reopening shell). Linear-interpolated. Mirrors third_law_i50 method (B4).
fn nm_i50(nD: int, nP: int, nI: int, dl: float) -> float {
    let ig = _linspace(0.05, 0.95, nI)
    let mut rate = []
    let mut a = 0
    while a < nI {
        rate = rate + [nm_effective_rate_at_I(ig[a], nD, dl)]
        a = a + 1
    }
    let mut k = 0
    while k < nI - 1 {
        let y0 = rate[k]
        let y1 = rate[k + 1]
        if y0 >= 0.5 && y1 < 0.5 {
            let x0 = ig[k]
            let x1 = ig[k + 1]
            return x0 + (y0 - 0.5) / (y0 - y1) * (x1 - x0)
        }
        k = k + 1
    }
    return 0.0 - 1.0
}

// ── B5 control: a SHUFFLED "neuromod" — disinhibition nudge on the WRONG axis. Instead
// of nudging I (the real capacity lever), nudge D (preparedness/disinhibition strength).
// This is the C-SHUF analogue of H_1284 (the controller's movement carries NO capacity
// signal). The effective-ratio under this mis-targeted nudge should NOT be ≈ 1/3.
fn nm_effective_wrongaxis(d: float, p: float, ii: float, dl: float) -> int {
    // nudge D up instead of I down: same magnitude, wrong lever.
    let dd = d + dl
    if third_law_ability(d, p, ii) == 0 && third_law_ability(dd, p, ii) == 1 { return 1 }
    return 0
}
fn nm_ratio_wrongaxis(nD: int, nP: int, nI: int, dl: float) -> float {
    let dg = _linspace(0.05, 0.95, nD)
    let pg = _linspace(0.05, 0.95, nP)
    let ig = _linspace(0.05, 0.95, nI)
    let mut tot = 0
    let mut eff = 0
    let mut a = 0
    while a < nI {
        let ii = ig[a]
        let mut b = 0
        while b < nD {
            let d = dg[b]
            let mut c = 0
            while c < nP {
                tot = tot + 1
                if nm_effective_wrongaxis(d, pg[c], ii, dl) == 1 { eff = eff + 1 }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if tot == 0 { return 0.0 }
    return to_float(eff) / to_float(tot)
}

fn main() {
    println("=== H_1565 — 1/3 LAW × H_1284 NEUROMOD WALL (live §ThirdLaw ops · engine-native) ===")
    let dl = _nm_delta()
    let gz_lo = sa_gz_lower()
    let gz_up = sa_gz_upper()
    println("neuromod δ (disinhibition amplitude) = " + to_string(dl))
    println("GZ_LOWER=" + to_string(gz_lo) + " GZ_UPPER=" + to_string(gz_up))
    println("")

    // ── scale ladder 8K / ~100K / 1M (same as H_1560) ──
    let r8   = nm_ratio(20, 20, 20, dl)
    let r100 = nm_ratio(46, 46, 46, dl)
    let r1m  = nm_ratio(100, 100, 100, dl)
    println("[8K]   neuromod-effective ratio = " + to_string(r8))
    println("[100K] neuromod-effective ratio = " + to_string(r100))
    println("[1M]   neuromod-effective ratio = " + to_string(r1m))

    // capacity-wall baseline (§ThirdLaw singularity ratio) for comparison
    let cap_ratio = third_law_ratio(100, 100, 100)
    println("[1M]   §ThirdLaw capacity singularity ratio = " + to_string(cap_ratio))

    let ov1m = nm_overlap_into_singularity(100, 100, 100, dl)
    let i50  = nm_i50(100, 100, 100, dl)
    println("[1M]   neuromod-effective ⇒ landing-singularity overlap = " + to_string(ov1m))
    println("[1M]   neuromod-effective I50 transition = " + to_string(i50))

    // ── per-I effective rate table (the transition shell) ──
    println("")
    println("--- per-I neuromod-effective rate (D×P plane, nDP=100) ---")
    let itab = [0.50, 0.45, 0.40, 0.36787944117144233, 0.32, 0.30, 0.28, 0.27, 0.25, gz_lo, 0.18, 0.10]
    let mut ti = 0
    while ti < len(itab) {
        let ii = itab[ti]
        let er = nm_effective_rate_at_I(ii, 100, dl)
        println("I=" + to_string(ii) + "  eff_rate=" + to_string(er) + "  inGZ=" + to_string(sa_in_golden_zone(ii)))
        ti = ti + 1
    }

    // ── B5 control: wrong-axis (D-nudge) "neuromod" ──
    let ctrl_r1m = nm_ratio_wrongaxis(100, 100, 100, dl)
    println("")
    println("[1M]   CONTROL wrong-axis (D-nudge) effective ratio = " + to_string(ctrl_r1m))

    // ══ FROZEN 5-bar ══
    let d1 = abs_f(r8 - r100)
    let d2 = abs_f(r100 - r1m)
    let d3 = abs_f(r8 - r1m)
    let mut dmax = d1
    if d2 > dmax { dmax = d2 }
    if d3 > dmax { dmax = d3 }

    let b1 = (r1m >= 0.30) && (r1m <= 0.36)               // B1 ratio ≈ 1/3
    let b2 = dmax < 0.02                                   // B2 scale-inv
    let b3 = (ov1m >= 0.9999999) && (abs_f(r1m - cap_ratio) >= 0.03)  // B3 ⊂ singularity AND own sub-region
    let b4 = (i50 >= 0.22) && (i50 <= 0.32)               // B4 transition near I50
    let b5 = abs_f(ctrl_r1m - 0.3333333) >= 0.03          // B5 control ≠ 1/3

    println("")
    println("════ FROZEN 5-bar ════")
    println("B1 ratio(1M)=" + to_string(r1m) + " in[0.30,0.36] -> " + to_string(b1))
    println("B2 Dmax=" + to_string(dmax) + " <0.02 -> " + to_string(b2))
    println("B3 overlap=" + to_string(ov1m) + " ==1.0 AND |ratio−cap|=" + to_string(abs_f(r1m - cap_ratio)) + " >=0.03 -> " + to_string(b3))
    println("B4 I50=" + to_string(i50) + " in[0.22,0.32] -> " + to_string(b4))
    println("B5 control_ratio=" + to_string(ctrl_r1m) + " |−1/3|=" + to_string(abs_f(ctrl_r1m - 0.3333333)) + " >=0.03 -> " + to_string(b5))

    let all_pass = b1 && b2 && b3 && b4 && b5
    println("")
    // ── verdict logic ──
    // overlap-PASS (B3) = neuromod-effective region lands ENTIRELY in the §ThirdLaw 1/3
    //   singularity manifold → SAME ORIGIN (unified law). ratio≈1/3 (B1) + scale-inv (B2)
    //   + I50 (B4) confirm it is itself a 1/3-shaped structural constant.
    println("ALL_PASS=" + to_string(all_pass))
    if all_pass {
        println("VERDICT=SAME-ORIGIN : the H_1284 neuromod wall's effective region IS the §ThirdLaw 1/3 manifold.")
        println("  → neuromod-effective ratio ≈ 1/3, scale-invariant, lands inside the capacity-wall singularity")
        println("    manifold, transition at I≈I50. The two walls share ONE 1/3 structural constant.")
    } else {
        println("VERDICT=INDEPENDENT-or-PARTIAL : a bar FAILED (honest, c9, no tune-to-green).")
        println("  → the neuromod wall is NOT (fully) the same 1/3 manifold; report which bar separates them.")
        exit(1)
    }
}
