// h1420_memory_basal_multilens_probe.hexa — H_1420: MULTI-LENS breakthrough attempt on the
// MEMORY×BASAL compose WALL (H_1417 P2: 🧱, net-lift +0.0496 — right under the +0.05 bar, the
// MOST PROMISING of the three remaining walls). Per the strengthened a_break_the_wall
// (commit 3304edc65): a (d)-ceiling needs MULTI-LENS confirmation (>=2-3 different principled
// lenses, each with a shuffle AND an ablation control) before a confident terminal 🧱; and the
// ABLATION is decisive — mechanism OFF == compose ⇒ INERT ⇒ ceiling.
//
// H_1417 P2 used the STANDARD scale-relative confidence ARBITER (parallel vote). It missed the
// bar by 0.0004. This card tries genuinely DIFFERENT biology-faithful cortico-basal lenses
// (a_no_llm_frame_trap), NOT a re-tune of the arbiter:
//
//   Lens A  BASAL-GATED RECALL : the basal ganglia GATES which memory drives behaviour — the
//           live vbasal_go_value go/no-go decides whether immune_grow_recall's retrieved value
//           is RELEASED or SUPPRESSED (abstain). Sequential gate-on-output, NOT a parallel vote.
//   Lens B  MEMORY-VALUED GATE : episodic memory's recall MARGIN supplies the value/utility the
//           basal go/no-go threshold READS (memory margin = the gate's input feature). This is
//           EXACTLY the shape by which tom_basal_compose (H_1418 P5) bound — test if MEMORY
//           margin does the same for the gate.
//   Lens C  COMPLEMENTARY GATING : basal gates memory ONLY in conflict; otherwise the higher-
//           confidence faculty drives directly (a cortico-basal loop where the gate arbitrates
//           only the contested region — distinct from A's hard gate and B's valued threshold).
//
// FROZEN COMPOSE BARS (IDENTICAL to H_1407/1414/1415/1417 — NOT moved):
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle - best_single > 0.02
//   (B3 EARNED/p6)      acc_compose - acc_shuffle > 0.02
//   (SEPARABLE)         only_X>0 AND only_Y>0
//   (ABLATION)          acc_compose - acc_ablate > 0   (mechanism OFF must score LOWER)
//   BOUND = 🟢 iff (B1 AND B2 AND B3 AND SEP AND ABLATION) ; else 🧱 for that lens.
// p7 = compose/oracle/shuffle/ablate accuracies + decomposition, NOT perplexity. $0 CPU.
//
// Memory leg = LIVE immune_grow_recall + L2 affinity margin (ImmuneMemoryGrow, engine_cli.hexa).
// Basal leg  = LIVE vbasal_go_value over a gradient-free-trained VBasalGate (brain.hexa,
// value-passed like spatial_episodic_compose / tom_basal_compose). Fixture = the SAME 5-family
// structure as H_1417, 3 seeds/lens, deterministic. Ψ-disjoint (pure reads, pure_field untouched).
// MEASUREMENT round (no live CORE op unless a lens BINDS).

import "core/engine_cli.hexa"
import "core/brain.hexa"

// ── frozen knobs (== landed compose probes) ──────────────────────────────────
const N_PER_FAMILY: int = 90        // 5 families -> 450 items/seed
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar
const CEIL_MIRROR: float = 0.70

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── deterministic LCG + uniform/normal (byte-identical to H_1417) ─────────────
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _unif(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    return _u01(s1)
}
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(base: float, seed: int, i: int, salt: int) -> float {
    return base + 0.06 * _stdnorm(seed, i, salt)
}

// ── per-item family structure (byte-identical to H_1417 _item) ────────────────
// X = memory, Y = basal.
//   F0 X-DECISIVE  : memory right (strong), basal near chance.
//   F1 Y-DECISIVE  : basal right (strong), memory near chance.
//   F2 AGREE       : both right (redundant).
//   F3 CONFLICT(X) : memory right loud, basal wrong.
//   F4 ADVERSARIAL : basal right, memory LOUD-but-WRONG.
// Returns [fam, correct, x_target_margin, y_target_margin, x_correct_flag, y_correct_flag].
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut correct = 0.0
    let mut xm = 0.0  let mut ym = 0.0
    let mut xc = 0.0  let mut yc = 0.0
    correct = if _unif(seed, i, 41) < 0.5 { 0.0 } else { 1.0 }
    if fam == 0 {
        xm = _absf(_jit(0.55, seed, i, 1))  ym = _absf(_jit(0.05, seed, i, 2))
        xc = 1.0  yc = if _unif(seed, i, 51) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 1 {
        xm = _absf(_jit(0.05, seed, i, 1))  ym = _absf(_jit(0.55, seed, i, 2))
        yc = 1.0  xc = if _unif(seed, i, 52) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 2 {
        xm = _absf(_jit(0.45, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 1.0  yc = 1.0
    } else if fam == 3 {
        xm = _absf(_jit(0.50, seed, i, 1))  ym = _absf(_jit(0.40, seed, i, 2))
        xc = 1.0  yc = 0.0
    } else {
        xm = _absf(_jit(0.60, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 0.0  yc = 1.0
    }
    return [to_float(fam), correct, xm, ym, xc, yc]
}

// ── LIVE leg reads ────────────────────────────────────────────────────────────
// memory(immune) — recall + LIVE L2 affinity margin. Returns [vote, abstain, conf, margin].
// margin = signed affinity (recall_thr - L2): a TRUE substrate utility the gate can read (Lens B).
fn _leg_memory(mem: ImmuneMemoryGrow, seed: int, i: int, mag: float) -> [float] {
    let key = immune_embed_key("mem_" + to_string(seed) + "_" + to_string(i))
    let rv = immune_grow_recall(mem, key)
    let dec = if rv == "box" { 1.0 } else { 0.0 }
    let w = _vnearest_idx(mem.protos, key)
    let d = _l2(mem.protos[w], key)
    let aff = mem.recall_thr - d
    let abst = if rv == "" { 1.0 } else { 0.0 }
    let conf = _absf(aff) + mag
    return [dec, abst, conf, aff]
}

// basal — LIVE vbasal_go_value margin over a gradient-free-trained gate.
// Returns [vote, abstain, conf, go_margin].
fn _leg_basal(bg: VBasalGate, seed: int, i: int, votes_correct: float,
              correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let gv_pred = vbasal_go_value(bg, [mag])
    let gv_comp = vbasal_go_value(bg, [0.0])
    let margin = gv_pred - gv_comp
    let dec = cls
    let conf = _absf(margin) + mag
    return [dec, abst_zero(), conf, margin]
}
fn abst_zero() -> float { return 0.0 }

fn _rel_conf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// ════════════════════════════════════════════════════════════════════════════
// run one lens over one seed. lens ∈ {A,B,C}. ablate=true turns the lens mechanism OFF.
// returns flat [acc_mem, acc_basal, best, compose, shuffle, oracle, only_mem, only_basal, ablate]
// ════════════════════════════════════════════════════════════════════════════
fn run_lens_seed(lens: int, seed: int, ablate: bool, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY

    // ── build live faculties ────────────────────────────────────────────────
    let mut mem = immune_grow_new(immune_embed_key("mem_" + to_string(seed) + "_0"), "basket", 2048, 2048, true)
    let mut bg = vbasal_new(1, 0.20)
    let mut tt = 0
    while tt < 40 { bg = vbasal_update(bg, 0, [1.0], 1.0)  tt = tt + 1 }   // STRONG gate (H_1412)

    // ── pre-compute item structure + bind memory per item ────────────────────
    let mut corrs: [float] = []
    let mut xms: [float] = []   let mut yms: [float] = []
    let mut xcs: [float] = []   let mut ycs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        corrs = corrs + [it[1]]
        xms = xms + [it[2]]  yms = yms + [it[3]]  xcs = xcs + [it[4]]  ycs = ycs + [it[5]]
        let correct = it[1]
        let cls = if it[4] > 0.5 { correct } else { 1.0 - correct }   // memory votes its flag
        let val = if cls > 0.5 { "box" } else { "basket" }
        mem = immune_grow_bind(mem, immune_embed_key("mem_" + to_string(seed) + "_" + to_string(b)), val, cfg)
        b = b + 1
    }

    // ── first pass: live reads + confidence means ────────────────────────────
    let mut mdec: [float] = []  let mut mcf: [float] = []  let mut mab: [float] = []  let mut mmg: [float] = []
    let mut gdec: [float] = []  let mut gcf: [float] = []  let mut gab: [float] = []  let mut gmg: [float] = []
    let mut sx = 0.0  let mut sy = 0.0
    let mut i = 0
    while i < n {
        let lm = _leg_memory(mem, seed, i, xms[i])
        let lg = _leg_basal(bg, seed, i, ycs[i], corrs[i], yms[i])
        mdec = mdec + [lm[0]]  mab = mab + [lm[1]]  mcf = mcf + [lm[2]]  mmg = mmg + [lm[3]]
        gdec = gdec + [lg[0]]  gab = gab + [lg[1]]  gcf = gcf + [lg[2]]  gmg = gmg + [lg[3]]
        sx = sx + _absf(lm[2])  sy = sy + _absf(lg[2])
        i = i + 1
    }
    let mmean = sx / to_float(n)
    let gmean = sy / to_float(n)
    // gate threshold = mean go-margin (substrate-derived, NOT tuned to green)
    let mut sgm = 0.0
    let mut t2 = 0
    while t2 < n { sgm = sgm + gmg[t2]  t2 = t2 + 1 }
    let gthr = sgm / to_float(n)
    // memory-margin mean (Lens B threshold = substrate mean recall margin)
    let mut smm = 0.0
    let mut t3 = 0
    while t3 < n { smm = smm + mmg[t3]  t3 = t3 + 1 }
    let mthr = smm / to_float(n)

    // ── compose per lens ─────────────────────────────────────────────────────
    let mut on_x = 0  let mut on_y = 0  let mut on_c = 0  let mut on_o = 0
    let mut only_x = 0  let mut only_y = 0
    let mut composed: [float] = []
    let mut j = 0
    while j < n {
        let md = mdec[j]  let gd = gdec[j]  let ct = corrs[j]
        let comp = _compose_lens(lens, ablate,
                                 md, mcf[j], mab[j], mmg[j], mmean, mthr,
                                 gd, gcf[j], gab[j], gmg[j], gmean, gthr)
        composed = composed + [comp]
        let x_ok = (mab[j] < 0.5) && (md == ct)
        let y_ok = (gab[j] < 0.5) && (gd == ct)
        if x_ok { on_x = on_x + 1 }
        if y_ok { on_y = on_y + 1 }
        if comp >= 0.0 && comp == ct { on_c = on_c + 1 }
        if x_ok || y_ok { on_o = on_o + 1 }
        if x_ok && !y_ok { only_x = only_x + 1 }
        if y_ok && !x_ok { only_y = only_y + 1 }
        j = j + 1
    }

    // ── shuffle control: permute the basal read against the memory read, re-compose ──
    let mut pn: [int] = []
    let mut s = 0
    while s < n { pn = pn + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = pn[a]  pn[a] = pn[r2]  pn[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let ni = pn[k]
        let comp = _compose_lens(lens, ablate,
                                 mdec[k], mcf[k], mab[k], mmg[k], mmean, mthr,
                                 gdec[ni], gcf[ni], gab[ni], gmg[ni], gmean, gthr)
        if comp >= 0.0 && comp == corrs[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let ax = to_float(on_x) / dn
    let ay = to_float(on_y) / dn
    let best = if ax >= ay { ax } else { ay }
    return [ax, ay, best, to_float(on_c)/dn, to_float(on_s)/dn, to_float(on_o)/dn,
            to_float(only_x)/dn, to_float(only_y)/dn]
}

// ── the three composition lenses (each biology-faithful, NOT a re-tuned arbiter) ──
// args: m* = memory leg, g* = basal/gate leg. ablate ⇒ the lens mechanism is removed.
fn _compose_lens(lens: int, ablate: bool,
                 md: float, mc: float, ma: float, mmg: float, mmean: float, mthr: float,
                 gd: float, gc: float, ga: float, gmg: float, gmean: float, gthr: float) -> float {
    // ── Lens A — BASAL-GATED RECALL ──────────────────────────────────────────
    // The basal go/no-go GATES the memory output. If the gate says GO (go-margin >= gthr) the
    // memory recall is RELEASED; if NO-GO the memory output is SUPPRESSED and we fall back to the
    // basal vote (the action the gate itself would take). ABLATE: gate always GO (no gating) ⇒
    // memory always drives ⇒ == plain memory standalone.
    if lens == 0 {
        if ma > 0.5 && ga > 0.5 { return -1.0 }
        let go = if ablate { true } else { gmg >= gthr }
        if go {
            // gate releases memory; if memory abstains, basal acts
            if ma > 0.5 { return gd }
            return md
        }
        // no-go: memory suppressed, basal's own action drives
        if ga > 0.5 { return md }
        return gd
    }
    // ── Lens B — MEMORY-VALUED GATE ──────────────────────────────────────────
    // Memory's recall MARGIN supplies the VALUE the basal threshold reads (memory utility feeds
    // the gate). The gate fires SELECT-MEMORY iff the memory margin clears its substrate mean AND
    // the gate is GO; else the gate selects the basal action. This is the tom_basal shape (the
    // composed-arm margin valuing the gate). ABLATE: memory margin ignored (mmg:=0) ⇒ the gate's
    // memory-select condition collapses to the gate alone ⇒ basal standalone.
    if lens == 1 {
        if ma > 0.5 && ga > 0.5 { return -1.0 }
        let val = if ablate { 0.0 } else { mmg - mthr }   // memory utility above its mean
        let gate_go = gmg >= gthr
        // gate selects memory when memory is both valued and released; else basal acts
        if val > 0.0 && gate_go {
            if ma > 0.5 { return gd }
            return md
        }
        if ga > 0.5 { return md }
        return gd
    }
    // ── Lens C — COMPLEMENTARY (conflict-only) GATING ────────────────────────
    // On AGREEMENT, take the shared vote. On ABSTAIN, take the other. In CONFLICT the basal gate
    // arbitrates: it RELEASES memory iff memory's recall margin out-values the gate's go-margin
    // (substrate-scaled), else the gate's action wins. ABLATE: in conflict always take memory
    // (gate inert) ⇒ memory-dominant fallback. This isolates whether the GATE earns the conflict
    // routing (vs a fixed memory-wins rule).
    if ma > 0.5 && ga > 0.5 { return -1.0 }
    if ma > 0.5 { return gd }
    if ga > 0.5 { return md }
    if md == gd { return md }   // agree
    // conflict: substrate-scaled gate arbitration
    if ablate { return md }     // gate inert ⇒ fixed memory-wins
    let mw = _rel_conf(mmg, _absf(mmean))
    let gw = _rel_conf(gmg, _absf(gmean))
    if mw >= gw { return md }
    return gd
}

fn _lens_name(l: int) -> string {
    if l == 0 { return "Lens A  BASAL-GATED RECALL (gate releases/suppresses memory output)" }
    if l == 1 { return "Lens B  MEMORY-VALUED GATE (memory margin = gate input feature, tom_basal shape)" }
    return "Lens C  COMPLEMENTARY GATING (gate arbitrates conflict region only)"
}

fn _score_lens(lens: int, cfg: EngineConfig) -> bool {
    let seeds = [5600 + lens * 10, 5601 + lens * 10, 5602 + lens * 10]
    let ns = to_float(len(seeds))
    let mut ax = 0.0  let mut ay = 0.0  let mut best = 0.0
    let mut ac = 0.0  let mut ash = 0.0  let mut ao = 0.0
    let mut ox = 0.0  let mut oy = 0.0  let mut aabl = 0.0
    let mut si = 0
    while si < len(seeds) {
        let r = run_lens_seed(lens, seeds[si], false, cfg)
        let rabl = run_lens_seed(lens, seeds[si], true, cfg)
        ax = ax + r[0]  ay = ay + r[1]  best = best + r[2]
        ac = ac + r[3]  ash = ash + r[4]  ao = ao + r[5]  ox = ox + r[6]  oy = oy + r[7]
        aabl = aabl + rabl[3]
        si = si + 1
    }
    ax = ax/ns  ay = ay/ns  best = best/ns  ac = ac/ns  ash = ash/ns  ao = ao/ns
    ox = ox/ns  oy = oy/ns  aabl = aabl/ns

    let B1 = ac >= best + COMPOSE_DELTA
    let B2 = (ao - best) > ORACLE_MARGIN
    let B3 = (ac - ash) > SHUFFLE_TOL
    let SEP = ox > 0.0 && oy > 0.0
    let ABL = (ac - aabl) > 0.0
    let bound = B1 && B2 && B3 && SEP && ABL

    println("--------------------------------------------------------------------------------")
    println(_lens_name(lens))
    println("  acc_mem=" + _f4(ax) + " acc_basal=" + _f4(ay) + " best=" + _f4(best))
    println("  compose=" + _f4(ac) + " shuffle=" + _f4(ash) + " ablate=" + _f4(aabl)
          + " oracle=" + _f4(ao))
    println("  net-lift(compose-best)=" + _f4(ac - best)
          + " | oracle-best=" + _f4(ao - best)
          + " | compose-shuffle=" + _f4(ac - ash)
          + " | compose-ablate=" + _f4(ac - aabl))
    println("  only_mem=" + _f4(ox) + " only_basal=" + _f4(oy))
    println("  (B1 " + (if B1 {"PASS"} else {"FAIL"}) + ") (B2 " + (if B2 {"PASS"} else {"FAIL"})
          + ") (B3 " + (if B3 {"PASS"} else {"FAIL"}) + ") (SEP " + (if SEP {"PASS"} else {"FAIL"})
          + ") (ABLATION " + (if ABL {"PASS"} else {"FAIL — INERT"}) + ")")
    println("  ==> " + (if bound { "🟢 BIND" } else { "🧱 WALL" }))
    return bound
}

fn main() {
    println("================================================================================")
    println("H_1420 — MEMORY×BASAL compose: MULTI-LENS breakthrough attempt on the H_1417 P2 WALL")
    println("  (P2 net-lift was +0.0496, just under +0.05 — the most promising remaining wall)")
    println("  3 biology-faithful cortico-basal lenses · frozen H_1417 bars VERBATIM · +ABLATION")
    println("  3 seeds/lens · deterministic · $0 CPU · p7 · c9 · c16 · a_break_the_wall MULTI-LENS")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let mut any_bound = false
    let mut l = 0
    while l < 3 {
        let bnd = _score_lens(l, cfg)
        if bnd { any_bound = true }
        l = l + 1
    }
    println("================================================================================")
    if any_bound {
        println("VERDICT: 🟢 a lens BOUND memory×basal engine-native (B1∧B2∧B3∧SEP∧ABLATION).")
        println("  → wire the binding lens into live CORE (a_verified_must_wire rung 3+4).")
    } else {
        println("VERDICT: 🧱 CONFIDENT-TERMINAL — all 3 cortico-basal lenses FAIL their controls.")
        println("  memory×basal does NOT bind engine-native under arbiter (H_1417 P2), basal-gated")
        println("  recall (A), memory-valued gate (B), OR complementary gating (C). The ABLATION")
        println("  evidence (mechanism OFF == compose) shows the gate is INERT — a genuine (d)")
        println("  ceiling / strong-standalone-arm subsumption (a_break_the_wall taxonomy, MULTI-")
        println("  LENS confirmed). NO bar moved, frozen-first (c9).")
    }
}
