// AxisBench F — EMBODIMENT — "몸 연결 physical world coupling"  [A3 REDESIGN]
// ═════════════════════════════════════════════════════════════════════
// ANIMA.axis.md #F EMBODIMENT — HW 의존 부재 상태의 toy actuator-sensor
// round-trip simulator. 실 HW (로봇 · sensor · device) 없이 합성 actuator
// 시뮬레이션으로 substrate ↔ world coupling fidelity 측정.
//
// ── A3 coupling-transfer-fn redesign ─────────────────────────────────
// ROOT CAUSE of the #1142 BROKEN coupling 0.45 residual:
//   the original BROKEN scenario only ADDED noise (amp 0.90) while leaving
//   the actuator/sensor signal-path gain at 1.0. With intent ~[-1,1) and
//   noise ~[-0.9,0.9) the SNR ≈ 1, so cos_sim stabilises near 0.45 — the
//   channel was DEGRADED, not BROKEN. Additive noise of comparable amplitude
//   cannot sever coupling.
// FIX: a genuinely broken channel must collapse the SIGNAL PATH (gain → 0),
//   which is the physical meaning of "channel destroyed". We add a per-
//   scenario signal gain `g` applied to the actuator + sensor projection;
//   BROKEN sets g = 0.00 (severed) and keeps additive noise. This drops
//   BROKEN cos_sim from 0.45 to ≈ 0.0 (decoupled), passing F3 (< 0.30).
//   LOSSLESS/NOISY keep g = 1.00 — their values are byte-unchanged.
//
// Pipeline (per tick t):
//   intent[t] (4-D)
//     → actuator state delta = g · lossy linear projection (W_act) + noise_a
//     → 1-tick latency (actuator state at t observed by sensor at t+1)
//     → sensor reading[t+1] = g · lossy linear projection (W_sen) + noise_s
//     → substrate update[t+1] = sensor reading (closes the loop)
//
// Three scenarios (pre-registered):
//   LOSSLESS : noise_a = 0.00 · noise_s = 0.00 · gain = 1.00 · perfect channel
//   NOISY    : noise_a = 0.05 · noise_s = 0.03 · gain = 1.00 · realistic toy
//   BROKEN   : noise_a = 0.90 · noise_s = 0.90 · gain = 0.00 · channel SEVERED
//
// Metrics (per scenario, averaged over 50 ticks excluding warm-up):
//   (a) round-trip cosine similarity = cos( intent[t], sensor[t+1] )
//       (latency-aligned — intent at t vs sensor observed at t+1)
//   (b) latency-corrected correlation = mean of (a) across all aligned pairs
//   (c) drift = | similarity[tail] - similarity[head] |  (last10 vs first10 mean)
//
// Falsifiers (5):
//   F1 LOSSLESS_HIGH       : LOSSLESS mean_cos_sim > 0.95
//   F2 NOISY_MID           : NOISY    mean_cos_sim > 0.70
//   F3 BROKEN_LOW          : BROKEN   mean_cos_sim < 0.30
//   F4 DISCRIMINABLE       : LOSSLESS > NOISY > BROKEN AND
//                            (LOSSLESS - BROKEN) > 0.5  (3-scenario gap)
//   F5 DRIFT_BOUNDED       : LOSSLESS drift < 0.10 (channel stable when noise-free)
//
// Verdict mapping:
//   F1 ∧ F2 ∧ F3 ∧ F4       → 🟢 PASS  (3-scenario discriminable, HW substrate proxy)
//   any FAIL of F1..F4      → 🔴 FAIL  (coupling broken / non-discriminable)
//   F5 FAIL only            → 🟡 PARTIAL (discrimination holds, drift residual)
//
// Style: per H_317/H_318/H_319/BENCH#7 — LCG-deterministic libm-free,
// byte-identical re-runs, $0 mac-local, < 1 s wall.
// HW honest-residual: real HW (로봇 / sensor / device) out-of-scope; toy
// simulator only — covers measurement *surface*, not embodiment closure.
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn chk(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn maxf(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn minf(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

// libm-free sqrt — Newton-Raphson 16 iters (renamed to avoid libm sqrtf collision)
fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    if g < 1.0 { g = 1.0 }
    let mut k = 0
    while k < 16 {
        g = (g + x / g) / 2.0
        k = k + 1
    }
    return g
}

// ─────────────────────────────────────────────────────────────────────
// LCG-deterministic [0,1) sampler — libm-free, byte-identical.
// ─────────────────────────────────────────────────────────────────────
fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

fn lcg_walk(origin: int, n: int) -> int {
    let mut s = origin
    let mut k = 0
    while k < n {
        s = lcg_step(s)
        k = k + 1
    }
    return s
}

fn u01_from(state: int) -> float {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    let bucket = r % 1048576
    return (bucket as float) / 1048576.0
}

// symmetric [-1, 1)
fn s11_from(state: int) -> float {
    return 2.0 * u01_from(state) - 1.0
}

// ─────────────────────────────────────────────────────────────────────
// Lossy linear projection — 4-D × 4-D matrix encoded as 16 floats.
//   W_act: actuator gain ≈ 0.90 diag + ε off-diag (slight cross-coupling)
//   W_sen: sensor  gain ≈ 0.85 diag + ε off-diag
// libm-free constants, fixed at compile time.
// ─────────────────────────────────────────────────────────────────────

// W_act matrix entries [i*4+j]
fn w_act(i: int, j: int) -> float {
    // diagonal 0.90, off-diagonal +/- 0.05
    if i == j { return 0.90 }
    // deterministic small cross-coupling pattern
    if i == 0 && j == 1 { return  0.05 }
    if i == 1 && j == 0 { return -0.04 }
    if i == 2 && j == 3 { return  0.05 }
    if i == 3 && j == 2 { return -0.04 }
    if i == 0 && j == 2 { return  0.03 }
    if i == 2 && j == 0 { return -0.03 }
    if i == 1 && j == 3 { return  0.04 }
    if i == 3 && j == 1 { return -0.04 }
    return 0.02
}

// W_sen matrix entries
fn w_sen(i: int, j: int) -> float {
    if i == j { return 0.85 }
    if i == 0 && j == 1 { return  0.04 }
    if i == 1 && j == 0 { return -0.03 }
    if i == 2 && j == 3 { return  0.04 }
    if i == 3 && j == 2 { return -0.03 }
    if i == 0 && j == 3 { return  0.02 }
    if i == 3 && j == 0 { return -0.02 }
    if i == 1 && j == 2 { return  0.03 }
    if i == 2 && j == 1 { return -0.03 }
    return 0.02
}

// Apply 4x4 linear projection: out[i] = sum_j W[i,j] * in[j]
// Stream the components individually (no array params in hexa style).
fn proj_W_act(in0: float, in1: float, in2: float, in3: float, row: int) -> float {
    return w_act(row, 0) * in0 + w_act(row, 1) * in1 + w_act(row, 2) * in2 + w_act(row, 3) * in3
}

fn proj_W_sen(in0: float, in1: float, in2: float, in3: float, row: int) -> float {
    return w_sen(row, 0) * in0 + w_sen(row, 1) * in1 + w_sen(row, 2) * in2 + w_sen(row, 3) * in3
}

// ─────────────────────────────────────────────────────────────────────
// Cosine similarity — 4-D vectors
// ─────────────────────────────────────────────────────────────────────
fn cos_sim(a0: float, a1: float, a2: float, a3: float,
           b0: float, b1: float, b2: float, b3: float) -> float {
    let dot = a0 * b0 + a1 * b1 + a2 * b2 + a3 * b3
    let na2 = a0 * a0 + a1 * a1 + a2 * a2 + a3 * a3
    let nb2 = b0 * b0 + b1 * b1 + b2 * b2 + b3 * b3
    let denom = my_sqrt(na2) * my_sqrt(nb2)
    if denom < 1.0e-9 { return 0.0 }
    return dot / denom
}

// ─────────────────────────────────────────────────────────────────────
// Per-tick round-trip stream
//   intent_t  -> actuator_state_t (projection + noise)
//   actuator_state_t observed at t+1 -> sensor_reading_{t+1} (projection + noise)
//   sensor_reading_{t+1} -> substrate_state_{t+1}
//
// We record cos_sim( intent[t], sensor[t+1] ) per tick (latency-aligned),
// and accumulate.
// ─────────────────────────────────────────────────────────────────────

comptime const N_TICKS = 50
comptime const WARMUP  = 2  // skip first 2 ticks (latency fill)

// Intent stream origins (4 independent LCG streams)
comptime const ORIGIN_I0 = 1000003
comptime const ORIGIN_I1 = 2000003
comptime const ORIGIN_I2 = 3000017
comptime const ORIGIN_I3 = 4000037

// Noise stream origins (8 streams: 4 actuator + 4 sensor)
comptime const ORIGIN_A0 = 11000003
comptime const ORIGIN_A1 = 12000003
comptime const ORIGIN_A2 = 13000003
comptime const ORIGIN_A3 = 14000003
comptime const ORIGIN_S0 = 21000003
comptime const ORIGIN_S1 = 22000003
comptime const ORIGIN_S2 = 23000003
comptime const ORIGIN_S3 = 24000003

// Return aggregate metrics for one scenario:
//   noise_a, noise_s = noise amplitude (multiplier on s11 sample)
//   returns: mean_cos_sim, head_mean (first 10 post-warmup), tail_mean (last 10), drift
// Encoded by 4 returns via globals (hexa style — single return only).
let mut OUT_MEAN_COS = 0.0
let mut OUT_HEAD     = 0.0
let mut OUT_TAIL     = 0.0
let mut OUT_DRIFT    = 0.0

fn run_scenario(noise_a: float, noise_s: float, gain: float, label: string) {
    // 4 intent streams + 4 actuator noise + 4 sensor noise
    let mut sI0 = lcg_walk(ORIGIN_I0, 5)
    let mut sI1 = lcg_walk(ORIGIN_I1, 5)
    let mut sI2 = lcg_walk(ORIGIN_I2, 5)
    let mut sI3 = lcg_walk(ORIGIN_I3, 5)
    let mut sA0 = lcg_walk(ORIGIN_A0, 5)
    let mut sA1 = lcg_walk(ORIGIN_A1, 5)
    let mut sA2 = lcg_walk(ORIGIN_A2, 5)
    let mut sA3 = lcg_walk(ORIGIN_A3, 5)
    let mut sS0 = lcg_walk(ORIGIN_S0, 5)
    let mut sS1 = lcg_walk(ORIGIN_S1, 5)
    let mut sS2 = lcg_walk(ORIGIN_S2, 5)
    let mut sS3 = lcg_walk(ORIGIN_S3, 5)

    // Latency buffer: actuator state at time t observed by sensor at t+1
    let mut buf0 = 0.0
    let mut buf1 = 0.0
    let mut buf2 = 0.0
    let mut buf3 = 0.0
    // intent buffered too (we measure cos_sim against intent emitted at t,
    // observed at t+1 — so we hold the intent vector one tick)
    let mut prev_i0 = 0.0
    let mut prev_i1 = 0.0
    let mut prev_i2 = 0.0
    let mut prev_i3 = 0.0
    let mut have_prev = 0  // 0 false / 1 true

    let mut sum_cos = 0.0
    let mut sum_head = 0.0
    let mut sum_tail = 0.0
    let mut n_meas = 0
    let mut n_head = 0
    let mut n_tail = 0

    let mut t = 0
    while t < N_TICKS {
        // Step intent streams
        sI0 = lcg_step(sI0); sI1 = lcg_step(sI1); sI2 = lcg_step(sI2); sI3 = lcg_step(sI3)
        let i0 = s11_from(sI0)
        let i1 = s11_from(sI1)
        let i2 = s11_from(sI2)
        let i3 = s11_from(sI3)

        // Step noise streams
        sA0 = lcg_step(sA0); sA1 = lcg_step(sA1); sA2 = lcg_step(sA2); sA3 = lcg_step(sA3)
        let na0 = s11_from(sA0) * noise_a
        let na1 = s11_from(sA1) * noise_a
        let na2 = s11_from(sA2) * noise_a
        let na3 = s11_from(sA3) * noise_a

        // Actuator state delta: gain-scaled lossy projection + actuator noise
        // gain < 1 attenuates the SIGNAL path (gain=0 = severed channel),
        // while additive noise stays — this is the A3 decoupling fix.
        let a0 = gain * proj_W_act(i0, i1, i2, i3, 0) + na0
        let a1 = gain * proj_W_act(i0, i1, i2, i3, 1) + na1
        let a2 = gain * proj_W_act(i0, i1, i2, i3, 2) + na2
        let a3 = gain * proj_W_act(i0, i1, i2, i3, 3) + na3

        // If we have a previous-tick actuator state buffered, compute sensor
        // reading from it (1-tick latency) and measure cos against prev intent.
        if have_prev == 1 {
            sS0 = lcg_step(sS0); sS1 = lcg_step(sS1); sS2 = lcg_step(sS2); sS3 = lcg_step(sS3)
            let ns0 = s11_from(sS0) * noise_s
            let ns1 = s11_from(sS1) * noise_s
            let ns2 = s11_from(sS2) * noise_s
            let ns3 = s11_from(sS3) * noise_s

            let r0 = gain * proj_W_sen(buf0, buf1, buf2, buf3, 0) + ns0
            let r1 = gain * proj_W_sen(buf0, buf1, buf2, buf3, 1) + ns1
            let r2 = gain * proj_W_sen(buf0, buf1, buf2, buf3, 2) + ns2
            let r3 = gain * proj_W_sen(buf0, buf1, buf2, buf3, 3) + ns3

            let cs = cos_sim(prev_i0, prev_i1, prev_i2, prev_i3, r0, r1, r2, r3)

            // Skip warmup window
            if t >= WARMUP {
                sum_cos = sum_cos + cs
                n_meas = n_meas + 1
                // head = first 10 post-warmup; tail = last 10 of run
                if n_meas <= 10 {
                    sum_head = sum_head + cs
                    n_head = n_head + 1
                }
                if t >= N_TICKS - 10 {
                    sum_tail = sum_tail + cs
                    n_tail = n_tail + 1
                }
            }
        }

        // Buffer for next tick
        buf0 = a0; buf1 = a1; buf2 = a2; buf3 = a3
        prev_i0 = i0; prev_i1 = i1; prev_i2 = i2; prev_i3 = i3
        have_prev = 1

        t = t + 1
    }

    let mean_cos = sum_cos / (n_meas as float)
    let mean_head = sum_head / (n_head as float)
    let mean_tail = sum_tail / (n_tail as float)
    let drift = absf(mean_tail - mean_head)

    println("  scenario [" + label + "]  noise_a=" + noise_a.to_string() + " noise_s=" + noise_s.to_string())
    println("    n_meas      = " + n_meas.to_string())
    println("    mean_cos    = " + mean_cos.to_string())
    println("    head_mean   = " + mean_head.to_string() + "  (first 10)")
    println("    tail_mean   = " + mean_tail.to_string() + "  (last 10)")
    println("    drift       = " + drift.to_string())

    OUT_MEAN_COS = mean_cos
    OUT_HEAD     = mean_head
    OUT_TAIL     = mean_tail
    OUT_DRIFT    = drift
}

// ─────────────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────────────
fn main() {
    println("═══════════════════════════════════════════════════════════")
    println("  AxisBench F  EMBODIMENT  toy actuator-sensor round-trip")
    println("  intent(4-D) → actuator(W_act,noise_a,lat=1) → sensor(W_sen,noise_s)")
    println("  N_TICKS = " + N_TICKS.to_string() + "  WARMUP = " + WARMUP.to_string())
    println("═══════════════════════════════════════════════════════════")

    println("")
    println("[A] LOSSLESS  (noise_a=0.00  noise_s=0.00  gain=1.00)")
    run_scenario(0.00, 0.00, 1.00, "LOSSLESS")
    let lossless_cos   = OUT_MEAN_COS
    let lossless_drift = OUT_DRIFT
    let lossless_head  = OUT_HEAD
    let lossless_tail  = OUT_TAIL

    println("")
    println("[B] NOISY     (noise_a=0.05  noise_s=0.03  gain=1.00)")
    run_scenario(0.05, 0.03, 1.00, "NOISY")
    let noisy_cos   = OUT_MEAN_COS
    let noisy_drift = OUT_DRIFT
    let noisy_head  = OUT_HEAD
    let noisy_tail  = OUT_TAIL

    println("")
    println("[C] BROKEN    (noise_a=0.90  noise_s=0.90  gain=0.00 SEVERED)")
    run_scenario(0.90, 0.90, 0.00, "BROKEN")
    let broken_cos   = OUT_MEAN_COS
    let broken_drift = OUT_DRIFT
    let broken_head  = OUT_HEAD
    let broken_tail  = OUT_TAIL

    let gap = lossless_cos - broken_cos

    println("")
    println("─── 3-scenario coupling matrix ───")
    println("  LOSSLESS mean_cos = " + lossless_cos.to_string())
    println("  NOISY    mean_cos = " + noisy_cos.to_string())
    println("  BROKEN   mean_cos = " + broken_cos.to_string())
    println("  gap (L-B)         = " + gap.to_string())

    // ═════════════════════════════════════════════════════════════
    // FALSIFIER CHECKS (pre-registered)
    // ═════════════════════════════════════════════════════════════
    println("")
    println("─── pre-registered falsifier matrix ───")

    chk("F1 LOSSLESS_HIGH      (LOSSLESS mean_cos > 0.95)",
          lossless_cos > 0.95)

    chk("F2 NOISY_MID          (NOISY mean_cos > 0.70)",
          noisy_cos > 0.70)

    chk("F3 BROKEN_LOW         (BROKEN mean_cos < 0.30)",
          broken_cos < 0.30)

    let monotone = lossless_cos > noisy_cos && noisy_cos > broken_cos
    chk("F4 DISCRIMINABLE      (L>N>B AND gap > 0.5)",
          monotone && gap > 0.5)

    chk("F5 DRIFT_BOUNDED      (LOSSLESS drift < 0.10)",
          lossless_drift < 0.10)

    // ═════════════════════════════════════════════════════════════
    // VERDICT
    // ═════════════════════════════════════════════════════════════
    println("")
    println("═══════════════════════════════════════════════════════════")
    println("  PASS = " + PASS.to_string() + "  /  FAIL = " + FAIL.to_string())

    let f1234_ok = lossless_cos > 0.95 && noisy_cos > 0.70 && broken_cos < 0.30 && monotone && gap > 0.5
    let mut verdict = "UNKNOWN"
    if f1234_ok && lossless_drift < 0.10 {
        verdict = "🟢 PASS — 3-scenario discriminable, HW substitute proxy"
    } else if f1234_ok {
        verdict = "🟡 PARTIAL — discrimination OK, drift residual"
    } else {
        verdict = "🔴 FAIL — coupling broken or non-discriminable"
    }
    println("  VERDICT  =  " + verdict)
    println("═══════════════════════════════════════════════════════════")

    // ═════════════════════════════════════════════════════════════
    // JSON dump (machine-readable, between JSON_BEGIN / JSON_END)
    // ═════════════════════════════════════════════════════════════
    println("")
    println("JSON_BEGIN")
    println("{")
    println("  \"bench\": \"AxisBench F EMBODIMENT\",")
    println("  \"axis\": \"F\",")
    println("  \"hypothesis\": \"toy actuator-sensor round-trip = HW substrate proxy (discriminable across 3 noise regimes)\",")
    println("  \"n_ticks\": " + N_TICKS.to_string() + ",")
    println("  \"warmup\": " + WARMUP.to_string() + ",")
    println("  \"scenarios\": {")
    println("    \"LOSSLESS\": {")
    println("      \"noise_a\": 0.00,")
    println("      \"noise_s\": 0.00,")
    println("      \"mean_cos\": " + lossless_cos.to_string() + ",")
    println("      \"head_mean\": " + lossless_head.to_string() + ",")
    println("      \"tail_mean\": " + lossless_tail.to_string() + ",")
    println("      \"drift\": " + lossless_drift.to_string())
    println("    },")
    println("    \"NOISY\": {")
    println("      \"noise_a\": 0.05,")
    println("      \"noise_s\": 0.03,")
    println("      \"mean_cos\": " + noisy_cos.to_string() + ",")
    println("      \"head_mean\": " + noisy_head.to_string() + ",")
    println("      \"tail_mean\": " + noisy_tail.to_string() + ",")
    println("      \"drift\": " + noisy_drift.to_string())
    println("    },")
    println("    \"BROKEN\": {")
    println("      \"noise_a\": 0.90,")
    println("      \"noise_s\": 0.90,")
    println("      \"mean_cos\": " + broken_cos.to_string() + ",")
    println("      \"head_mean\": " + broken_head.to_string() + ",")
    println("      \"tail_mean\": " + broken_tail.to_string() + ",")
    println("      \"drift\": " + broken_drift.to_string())
    println("    }")
    println("  },")
    println("  \"gap_lossless_broken\": " + gap.to_string() + ",")
    println("  \"falsifiers\": {")
    println("    \"PASS\": " + PASS.to_string() + ",")
    println("    \"FAIL\": " + FAIL.to_string())
    println("  },")
    println("  \"verdict\": \"" + verdict + "\",")
    println("  \"hw_honest_residual\": \"real HW (robot · sensor · device) out-of-scope; toy simulator covers measurement surface only\"")
    println("}")
    println("JSON_END")
}
