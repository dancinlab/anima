// BENCH/self_correction_probe/template.hexa
//
// Generic self-correction probe analyzer (Bench #5 SELF-CORRECTION-PROBE).
//
// Pattern (mined from UNIVERSE H_340 / H_342 self-correction saga):
//   1. A finding PASSES at some small scale n0 (e.g. F-M4B-FIRE-3 at n_steps=20).
//   2. We *suspect* it may be a small-n artifact.
//   3. We re-run the same probe across a swept n-range {n_lo .. n_hi}.
//   4. Verdict logic:
//        - all-n PASS  ........... robust              (🟢 ROBUST)
//        - PASS at small n only .. small-n artifact    (🔴 SMALL-N-ARTIFACT)
//        - FAIL at small n only .. inverse-artifact    (🟠 INVERSE-ARTIFACT)
//        - mixed / non-monotone .. ambiguous           (🟡 AMBIGUOUS)
//
// Usage convention (no fn-pointers in hexa — the probe is plugged in by the
// caller, which constructs the (n, pass_flag) pairs and hands them to
// `analyze_probe_table`). See `probe_f_m4b_fire_3.hexa` for a concrete driver.
//
// The template is intentionally agnostic to *what* the probe measures: it only
// inspects the PASS/FAIL bitmap across the swept n-axis. This makes it reusable
// across any hypothesis that produced a small-n PASS we want to defend.

// ─────────────────────────────────────────────────────────────────────────────
// 1. PROBE-TABLE TYPES (hexa-list convention)
//
// Inputs come as two parallel lists of equal length len:
//   ns      : list<int>  -- sweep axis (e.g. [5, 10, 20, 50])
//   passes  : list<int>  -- 1 = PASS at this n, 0 = FAIL at this n
//   metrics : list<float>-- optional per-n quantitative metric (e.g. # distinct
//                           experts; pass NaN-ish 0.0 if unused).
//
// The first element ns[0] is taken as the SMALL-N reference (the n where the
// original finding was claimed). Verdicts are computed relative to it.
// ─────────────────────────────────────────────────────────────────────────────

// ─── 2. Predicate helpers ───────────────────────────────────────────────────

fn all_pass(passes: list) -> int {
    let mut i = 0
    let mut len = passes.len()
    while i < len {
        if passes[i] == 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn all_fail(passes: list) -> int {
    let mut i = 0
    let mut len = passes.len()
    while i < len {
        if passes[i] == 1 { return 0 }
        i = i + 1
    }
    return 1
}

// Is the pattern "PASS at n0, FAIL at every n > n0"?  → small-n artifact.
fn is_small_n_artifact(passes: list) -> int {
    let mut len = passes.len()
    if len < 2 { return 0 }
    if passes[0] != 1 { return 0 }
    let mut i = 1
    while i < len {
        if passes[i] == 1 { return 0 }
        i = i + 1
    }
    return 1
}

// Inverse: FAIL at n0, PASS at every n > n0  → inverse artifact (rare but real;
// e.g. measurement noise dominating at small n, signal emerging at large n).
fn is_inverse_artifact(passes: list) -> int {
    let mut len = passes.len()
    if len < 2 { return 0 }
    if passes[0] != 0 { return 0 }
    let mut i = 1
    while i < len {
        if passes[i] == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Count PASS flags (for ambiguous / mixed pattern detection).
fn count_pass(passes: list) -> int {
    let mut c = 0
    let mut i = 0
    let mut len = passes.len()
    while i < len {
        if passes[i] == 1 { c = c + 1 }
        i = i + 1
    }
    return c
}

// ─── 3. Verdict assembly ────────────────────────────────────────────────────

// Returns a verdict code:
//   1 = ROBUST                  (all n PASS)
//   2 = SMALL-N-ARTIFACT        (PASS only at n0)
//   3 = INVERSE-ARTIFACT        (FAIL only at n0)
//   4 = AMBIGUOUS / MIXED       (anything else)
//   5 = ALL-FAIL                (no n PASS — finding was never real)
fn verdict_code(passes: list) -> int {
    if all_pass(passes) == 1 { return 1 }
    if all_fail(passes) == 1 { return 5 }
    if is_small_n_artifact(passes) == 1 { return 2 }
    if is_inverse_artifact(passes) == 1 { return 3 }
    return 4
}

fn verdict_label(code: int) -> string {
    if code == 1 { return "ROBUST" }
    if code == 2 { return "SMALL-N-ARTIFACT" }
    if code == 3 { return "INVERSE-ARTIFACT" }
    if code == 4 { return "AMBIGUOUS" }
    if code == 5 { return "ALL-FAIL" }
    return "UNKNOWN"
}

fn verdict_tier(code: int) -> string {
    if code == 1 { return "GREEN" }
    if code == 2 { return "RED" }
    if code == 3 { return "ORANGE" }
    if code == 4 { return "YELLOW" }
    if code == 5 { return "RED" }
    return "GREY"
}

// ─── 4. Reporting ───────────────────────────────────────────────────────────

fn report_table(label: string, ns: list, passes: list, metrics: list) {
    println("=== self-correction probe: " + label + " ===")
    println("n,pass,metric")
    let mut i = 0
    let mut len = ns.len()
    while i < len {
        let p = passes[i]
        let m = metrics[i]
        println(str(ns[i]) + "," + str(p) + "," + str(m))
        i = i + 1
    }
}

fn analyze_probe_table(label: string, ns: list, passes: list, metrics: list) -> int {
    report_table(label, ns, passes, metrics)
    let code = verdict_code(passes)
    let lab = verdict_label(code)
    let tier = verdict_tier(code)
    let np = count_pass(passes)
    let nt = ns.len()
    println("verdict_code=" + str(code))
    println("verdict_label=" + lab)
    println("verdict_tier=" + tier)
    println("pass_count=" + str(np) + "/" + str(nt))
    if code == 1 { println("=> ROBUST PASS across full n-sweep (no small-n artifact)") }
    if code == 2 { println("=> SMALL-N ARTIFACT detected — finding only holds at n=" + str(ns[0])) }
    if code == 3 { println("=> INVERSE ARTIFACT — failure was at n=" + str(ns[0]) + " only") }
    if code == 4 { println("=> AMBIGUOUS — non-monotone pattern, needs finer sweep") }
    if code == 5 { println("=> ALL-FAIL — finding does not reproduce at any swept n") }
    return code
}

// ─── 5. Sanity self-test of the template logic ──────────────────────────────
// Run via `hexa run template.hexa` to confirm verdict_code() works.
// (Drivers should NOT depend on this main — they import this file and call
//  analyze_probe_table directly.)
fn main() {
    println("BENCH/self_correction_probe/template.hexa — self-test")
    // case A: ROBUST
    let ns_a = [5, 10, 20, 50]
    let p_a = [1, 1, 1, 1]
    let m_a = [0.0, 0.0, 0.0, 0.0]
    let c_a = analyze_probe_table("self-test-A-robust", ns_a, p_a, m_a)
    println("expected code=1 got=" + str(c_a))
    println("")
    // case B: SMALL-N ARTIFACT
    let ns_b = [5, 10, 20, 50]
    let p_b = [1, 0, 0, 0]
    let m_b = [0.0, 0.0, 0.0, 0.0]
    let c_b = analyze_probe_table("self-test-B-smallN", ns_b, p_b, m_b)
    println("expected code=2 got=" + str(c_b))
    println("")
    // case C: INVERSE
    let ns_c = [5, 10, 20, 50]
    let p_c = [0, 1, 1, 1]
    let m_c = [0.0, 0.0, 0.0, 0.0]
    let c_c = analyze_probe_table("self-test-C-inverse", ns_c, p_c, m_c)
    println("expected code=3 got=" + str(c_c))
    println("")
    // case D: AMBIGUOUS
    let ns_d = [5, 10, 20, 50]
    let p_d = [1, 0, 1, 0]
    let m_d = [0.0, 0.0, 0.0, 0.0]
    let c_d = analyze_probe_table("self-test-D-ambig", ns_d, p_d, m_d)
    println("expected code=4 got=" + str(c_d))
    println("")
    // case E: ALL-FAIL
    let ns_e = [5, 10, 20, 50]
    let p_e = [0, 0, 0, 0]
    let m_e = [0.0, 0.0, 0.0, 0.0]
    let c_e = analyze_probe_table("self-test-E-allfail", ns_e, p_e, m_e)
    println("expected code=5 got=" + str(c_e))
    println("template self-test done")
}
