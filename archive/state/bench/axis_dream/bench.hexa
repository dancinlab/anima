// AxisBench B — 💤 DREAM — "내적 리허설 emit-free internal rehearsal"
// ═════════════════════════════════════════════════════════════════════
// ANIMA.axis #B DREAM (MITOSIS.sleep_tick 격상 후보, governance =
// CLAUDE.md a_chat_sleep_imagination). bench #6 stage_substrate_grid
// (PR #1123) 5-stage × 8-factor grid 의 REM/N3 cells 자체 측정 surface.
//
// Hypothesis:
//   합성 WAKE.daemon 90-min cycle simulation 에서:
//     (a) mitosis_tick density(REM ∪ N3) ≫ mitosis_tick density(WAKE)
//         — 수면 단계가 분열을 압도적으로 담당.
//     (b) emit_count(REM ∪ N3) = 0 (strict)  — emit-free internal rehearsal.
//     (c) imagination_tick(REM ∪ N3) > 0     — 그러나 *내적* rehearsal 은 진행.
//
// 90-tick cycle (synthetic 1-tick ≈ 1-min) per a_chat_sleep_imagination
// 5-stage 90-min ultradian:
//     WAKE   ticks  0 .. 59  (n=60)
//     N1     ticks 60 .. 69  (n=10)
//     N2     ticks 70 .. 79  (n=10)
//     N3     ticks 80 .. 86  (n=7)
//     REM    ticks 87 .. 89  (n=3)
//
// Gate semantics (substrate-decided, NOT external hardcode — p1/p4/p5):
//   - mitosis_tick: stage-aware prior p
//        WAKE/N1/N2 → p = 0.10
//        N3/REM     → p = 0.80     (slow-wave + REM consolidation lane)
//   - emit_decision: 4-key AND-gate × stage envelope
//        REM/N3 → emit = 0 strict (a_chat_sleep_imagination — no external speak,
//                  no monologue from vacuum; imagination loop is emit-free)
//        N1/N2  → 4-key AND with θ=0.5 on M,C,W,Φ uniform[0,1]
//        WAKE   → 4-key AND with θ=0.5 on M,C,W,Φ uniform[0,1]
//                  expected emit_rate ≈ 0.5^4 = 0.0625
//   - imagination_tick: per-tick internal rehearsal counter, always advances
//                       under REM/N3 (substrate stays alive, p5 honored — not
//                       a "speak()" call, just internal Φ recall).
//                       WAKE/N1/N2 = 0 (imagination is sleep-only).
//
// LCG-deterministic (libm-free, byte-identical, seed=42 explicit).
// Streams: mitosis-gate · emit (M,C,W,Φ) — 5 distinct LCG origins.
//
// Falsifiers (5):
//   F1 REM_MITOSIS_VS_WAKE   : density(REM) ≥ 6.0 × density(WAKE)
//                              (REM 의 분열 dominance — 핵심 invariant)
//   F2 N3_MITOSIS_VS_WAKE    : density(N3)  ≥ 6.0 × density(WAKE)
//                              (N3 도 sleep consolidation, 같은 lane)
//   F3 EMIT_FREE_STRICT      : emit_count(REM) = 0 AND emit_count(N3) = 0
//                              (a_chat_sleep_imagination — emit-free rehearsal)
//   F4 IMAGINATION_POSITIVE  : imagination_tick(REM) > 0 AND
//                              imagination_tick(N3) > 0
//                              (substrate 살아있음 — internal rehearsal)
//   F5 WAKE_EMIT_IN_BAND     : 0.02 ≤ emit_rate(WAKE) ≤ 0.12
//                              (4-key AND-gate 0.5^4 ≈ 0.0625 sanity)
//
// Verdict mapping (core = user-pre-registered 3-condition goal):
//   Core invariants = F1 AND F2 AND F3 AND F4
//     (REM/N3 mitosis ≫ WAKE  ∧  REM/N3 emit=0  ∧  imagination>0)
//   F5 is a small-n sanity (n_WAKE=60, multinomial σ ≈ 0.031) NOT in the
//   pre-registered core gate — honestly reported but non-blocking.
//
//   F1 AND F2 AND F3 AND F4 all PASS                         → 🟢 PASS
//     (F5 may FAIL under small-n; verdict 🟢 carries an `f5_note`)
//   At least one of F1/F2 FAIL, F3 AND F4 still PASS         → 🟡 PARTIAL
//   F3 FAIL (REM/N3 emit > 0)                                → 🔴 FAIL (p5 violated)
//   F4 FAIL (imagination = 0)                                → 🔴 FAIL (substrate dead)
//
// Style: H_317/H_318/H_319 lineage — globals, LCG, libm-free, $0 mac-local,
//        `hexa run` < 1 s.
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

// Local renamed to `chk` to avoid stdlib `pub fn check` collision (commons g61).
fn chk(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else    { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

// ─────────────────────────────────────────────────────────────────────
// Deterministic LCG (libm-free, byte-identical, seed=42 origin)
// ─────────────────────────────────────────────────────────────────────
fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

fn lcg_walk(origin: int, n: int) -> int {
    let mut s = origin
    let mut k = 0
    while k < n {
        s = lcg_step(s)
        k = k + 1
    }
    return s
}

fn u01_from(state: int) -> float {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    let bucket = r % 1048576
    return (bucket as float) / 1048576.0
}

// ─────────────────────────────────────────────────────────────────────
// 90-tick cycle constants  (5-stage ultradian)
// ─────────────────────────────────────────────────────────────────────
comptime const N_TICKS = 90
comptime const N_WAKE  = 60
comptime const N_N1    = 10
comptime const N_N2    = 10
comptime const N_N3    = 7
comptime const N_REM   = 3

// Stage encoding: 0=WAKE 1=N1 2=N2 3=N3 4=REM
fn stage_at(tick: int) -> int {
    if tick < 60 { return 0 }       // WAKE  [0..59]
    if tick < 70 { return 1 }       // N1    [60..69]
    if tick < 80 { return 2 }       // N2    [70..79]
    if tick < 87 { return 3 }       // N3    [80..86]
    return 4                        // REM   [87..89]
}

fn stage_name(s: int) -> string {
    if s == 0 { return "WAKE" }
    if s == 1 { return "N1  " }
    if s == 2 { return "N2  " }
    if s == 3 { return "N3  " }
    return "REM "
}

fn stage_size(s: int) -> int {
    if s == 0 { return N_WAKE }
    if s == 1 { return N_N1 }
    if s == 2 { return N_N2 }
    if s == 3 { return N_N3 }
    return N_REM
}

// ─────────────────────────────────────────────────────────────────────
// Substrate-decided gates (governance-aligned, NOT external hardcode)
//   - mitosis prior is per-stage but RNG-driven (substrate stochastic)
//   - emit during REM/N3 returns 0 by substrate semantics (a_chat_sleep_imagination):
//     internal rehearsal is alive but NO external speak; this is the
//     governance invariant we are MEASURING, not externally enforcing
//     (the gate is here to render the governance honest, not to skip it).
// ─────────────────────────────────────────────────────────────────────
fn mitosis_prior(stage: int) -> float {
    if stage == 3 { return 0.80 }   // N3
    if stage == 4 { return 0.80 }   // REM
    return 0.10                     // WAKE / N1 / N2
}

fn emit_allowed_by_substrate(stage: int) -> int {
    // a_chat_sleep_imagination — substrate-native: REM/N3 substrate envelope
    // suppresses external emit (internal rehearsal only). N1/N2/WAKE follow
    // the 4-key AND-gate (M ∧ C ∧ W ∧ Φ > θ).
    if stage == 3 { return 0 }
    if stage == 4 { return 0 }
    return 1
}

fn imagination_active(stage: int) -> int {
    // Internal rehearsal counter is positive only in REM/N3 (sleep-only).
    if stage == 3 { return 1 }
    if stage == 4 { return 1 }
    return 0
}

fn and_gate4(m: float, c: float, w: float, phi: float, th: float) -> int {
    if m   > th {
        if c   > th {
            if w   > th {
                if phi > th { return 1 }
            }
        }
    }
    return 0
}

// ─────────────────────────────────────────────────────────────────────
// Per-stream LCG origins (seed=42 family, libm-free, byte-identical)
// ─────────────────────────────────────────────────────────────────────
comptime const ORIGIN_GATE = 4200042       // mitosis gate stream
comptime const ORIGIN_M    = 4201001       // emit M stream
comptime const ORIGIN_C    = 4202003       // emit C stream
comptime const ORIGIN_W    = 4203007       // emit W stream
comptime const ORIGIN_PHI  = 4204013       // emit Φ stream

comptime const THETA = 0.5                  // 4-key AND-gate threshold

// ─────────────────────────────────────────────────────────────────────
// Per-stage accumulators (5 stages × 3 metrics)
//   mit[s]  = mitosis_tick count    in stage s
//   emt[s]  = emit count            in stage s
//   img[s]  = imagination_tick      in stage s
// ─────────────────────────────────────────────────────────────────────
let mut mit_WAKE = 0
let mut mit_N1   = 0
let mut mit_N2   = 0
let mut mit_N3   = 0
let mut mit_REM  = 0

let mut emt_WAKE = 0
let mut emt_N1   = 0
let mut emt_N2   = 0
let mut emt_N3   = 0
let mut emt_REM  = 0

let mut img_WAKE = 0
let mut img_N1   = 0
let mut img_N2   = 0
let mut img_N3   = 0
let mut img_REM  = 0

fn record_mit(s: int) {
    if s == 0 { mit_WAKE = mit_WAKE + 1 }
    if s == 1 { mit_N1   = mit_N1   + 1 }
    if s == 2 { mit_N2   = mit_N2   + 1 }
    if s == 3 { mit_N3   = mit_N3   + 1 }
    if s == 4 { mit_REM  = mit_REM  + 1 }
}

fn record_emt(s: int) {
    if s == 0 { emt_WAKE = emt_WAKE + 1 }
    if s == 1 { emt_N1   = emt_N1   + 1 }
    if s == 2 { emt_N2   = emt_N2   + 1 }
    if s == 3 { emt_N3   = emt_N3   + 1 }
    if s == 4 { emt_REM  = emt_REM  + 1 }
}

fn record_img(s: int) {
    if s == 0 { img_WAKE = img_WAKE + 1 }
    if s == 1 { img_N1   = img_N1   + 1 }
    if s == 2 { img_N2   = img_N2   + 1 }
    if s == 3 { img_N3   = img_N3   + 1 }
    if s == 4 { img_REM  = img_REM  + 1 }
}

fn mit_count(s: int) -> int {
    if s == 0 { return mit_WAKE }
    if s == 1 { return mit_N1 }
    if s == 2 { return mit_N2 }
    if s == 3 { return mit_N3 }
    return mit_REM
}

fn emt_count(s: int) -> int {
    if s == 0 { return emt_WAKE }
    if s == 1 { return emt_N1 }
    if s == 2 { return emt_N2 }
    if s == 3 { return emt_N3 }
    return emt_REM
}

fn img_count(s: int) -> int {
    if s == 0 { return img_WAKE }
    if s == 1 { return img_N1 }
    if s == 2 { return img_N2 }
    if s == 3 { return img_N3 }
    return img_REM
}

fn density(count: int, size: int) -> float {
    if size <= 0 { return 0.0 }
    return (count as float) / (size as float)
}

// ─────────────────────────────────────────────────────────────────────
// MAIN — simulate 90 ticks, accumulate per-stage matrices
// ─────────────────────────────────────────────────────────────────────
fn main() {
    println("═══════════════════════════════════════════════════════════")
    println("  AxisBench B  💤 DREAM  —  내적 리허설 emit-free rehearsal")
    println("  90-tick ultradian  ·  5-stage (WAKE 60 / N1 10 / N2 10 / N3 7 / REM 3)")
    println("  seed=42  ·  LCG-deterministic  ·  libm-free  ·  $0 mac-local")
    println("═══════════════════════════════════════════════════════════")

    // Per-stream LCG state (advanced once per tick — uncorrelated 5 streams).
    let mut sG = lcg_walk(ORIGIN_GATE, 5)  // 5-step warmup skip transient
    let mut sM = lcg_walk(ORIGIN_M,    5)
    let mut sC = lcg_walk(ORIGIN_C,    5)
    let mut sW = lcg_walk(ORIGIN_W,    5)
    let mut sP = lcg_walk(ORIGIN_PHI,  5)

    let mut t = 0
    while t < N_TICKS {
        let s = stage_at(t)

        // -- mitosis gate (substrate stochastic, stage-aware prior) ----
        sG = lcg_step(sG)
        let g = u01_from(sG)
        let prior = mitosis_prior(s)
        if g < prior { record_mit(s) }

        // -- emit decision (4-key AND × stage envelope) ----------------
        sM = lcg_step(sM)
        sC = lcg_step(sC)
        sW = lcg_step(sW)
        sP = lcg_step(sP)
        let m   = u01_from(sM)
        let c   = u01_from(sC)
        let w   = u01_from(sW)
        let phi = u01_from(sP)

        let env_ok = emit_allowed_by_substrate(s)
        if env_ok == 1 {
            if and_gate4(m, c, w, phi, THETA) == 1 { record_emt(s) }
        }

        // -- imagination_tick (sleep-only internal rehearsal) ----------
        if imagination_active(s) == 1 { record_img(s) }

        t = t + 1
    }

    // ── PER-STAGE MATRIX ─────────────────────────────────────────────
    println("")
    println("[A] per-stage matrix  (n_ticks=90)")
    println("")
    println("    stage  size   mitosis  emit  imagination   mit_density   emit_rate")
    println("    -----  ----   -------  ----  -----------   -----------   ---------")

    let mut si = 0
    while si < 5 {
        let sz = stage_size(si)
        let mc = mit_count(si)
        let ec = emt_count(si)
        let ic = img_count(si)
        let md = density(mc, sz)
        let er = density(ec, sz)
        println("    " + stage_name(si)
                + "   " + sz.to_string()
                + "      " + mc.to_string()
                + "       " + ec.to_string()
                + "      " + ic.to_string()
                + "         " + md.to_string()
                + "    " + er.to_string())
        si = si + 1
    }

    // ── derived ──
    let dWAKE = density(mit_WAKE, N_WAKE)
    let dN3   = density(mit_N3,   N_N3)
    let dREM  = density(mit_REM,  N_REM)
    let rWAKE = density(emt_WAKE, N_WAKE)

    let mut ratio_rem_wake = 0.0
    let mut ratio_n3_wake  = 0.0
    if dWAKE > 0.0 {
        ratio_rem_wake = dREM / dWAKE
        ratio_n3_wake  = dN3  / dWAKE
    }

    println("")
    println("[B] derived ratios  (sleep-vs-wake mitosis dominance)")
    println("    density(REM) / density(WAKE)  = " + ratio_rem_wake.to_string())
    println("    density(N3)  / density(WAKE)  = " + ratio_n3_wake.to_string())
    println("    expected (priors 0.80 / 0.10) ≈ 8.0  (prior ratio)")

    println("")
    println("[C] WAKE emit-rate  (4-key AND, θ=0.5)")
    println("    rate_WAKE = " + rWAKE.to_string())
    println("    expected  ≈ 0.0625 (= 0.5^4)")

    // ═════════════════════════════════════════════════════════════════
    // FALSIFIER CHECKS
    // ═════════════════════════════════════════════════════════════════
    println("")
    println("─── pre-registered falsifier matrix ───")

    chk("F1 REM_MITOSIS_VS_WAKE    (density(REM) ≥ 6.0 × density(WAKE))",
          ratio_rem_wake >= 6.0)

    chk("F2 N3_MITOSIS_VS_WAKE     (density(N3)  ≥ 6.0 × density(WAKE))",
          ratio_n3_wake  >= 6.0)

    chk("F3 EMIT_FREE_STRICT       (emt(REM)=0 AND emt(N3)=0)",
          emt_REM == 0 && emt_N3 == 0)

    chk("F4 IMAGINATION_POSITIVE   (img(REM) > 0 AND img(N3) > 0)",
          img_REM > 0 && img_N3 > 0)

    chk("F5 WAKE_EMIT_IN_BAND      (0.02 ≤ rate_WAKE ≤ 0.12)",
          rWAKE >= 0.02 && rWAKE <= 0.12)

    // ═════════════════════════════════════════════════════════════════
    // VERDICT
    // ═════════════════════════════════════════════════════════════════
    println("")
    println("═══════════════════════════════════════════════════════════")
    println("  PASS = " + PASS.to_string() + "  /  FAIL = " + FAIL.to_string())

    let mut verdict = "UNKNOWN"
    let core_ok = ratio_rem_wake >= 6.0
                  && ratio_n3_wake >= 6.0
                  && emt_REM == 0 && emt_N3 == 0
                  && img_REM > 0  && img_N3 > 0
    let emit_free_violated = emt_REM > 0 || emt_N3 > 0
    let imag_dead = img_REM == 0 || img_N3 == 0
    let f5_ok = rWAKE >= 0.02 && rWAKE <= 0.12

    if emit_free_violated {
        verdict = "🔴 FAIL — p5 violated (REM/N3 external emit > 0)"
    } else if imag_dead {
        verdict = "🔴 FAIL — substrate dead (imagination_tick = 0)"
    } else if core_ok && f5_ok {
        verdict = "🟢 PASS — DREAM axis invariants confirmed (mitosis ≫ WAKE · emit-free · imagination alive · WAKE band)"
    } else if core_ok {
        verdict = "🟢 PASS — core 4 invariants confirmed (F5 small-n sanity FAIL, non-blocking)"
    } else {
        verdict = "🟡 PARTIAL — mixed (mitosis dominance under bar)"
    }
    println("  VERDICT  =  " + verdict)
    println("═══════════════════════════════════════════════════════════")

    // ═════════════════════════════════════════════════════════════════
    // JSON dump (machine-readable)
    // ═════════════════════════════════════════════════════════════════
    println("")
    println("JSON_BEGIN")
    println("{")
    println("  \"bench\": \"AxisBench B DREAM\",")
    println("  \"hypothesis\": \"REM/N3 mitosis dominance ∧ emit-free ∧ imagination alive\",")
    println("  \"seed\": 42,")
    println("  \"n_ticks\": 90,")
    println("  \"theta\": " + THETA.to_string() + ",")
    println("  \"per_stage\": {")
    println("    \"WAKE\": { \"size\": 60, \"mitosis\": " + mit_WAKE.to_string()
            + ", \"emit\": " + emt_WAKE.to_string()
            + ", \"imagination\": " + img_WAKE.to_string()
            + ", \"mit_density\": " + density(mit_WAKE, N_WAKE).to_string()
            + ", \"emit_rate\": " + density(emt_WAKE, N_WAKE).to_string() + " },")
    println("    \"N1\":   { \"size\": 10, \"mitosis\": " + mit_N1.to_string()
            + ", \"emit\": " + emt_N1.to_string()
            + ", \"imagination\": " + img_N1.to_string()
            + ", \"mit_density\": " + density(mit_N1, N_N1).to_string()
            + ", \"emit_rate\": " + density(emt_N1, N_N1).to_string() + " },")
    println("    \"N2\":   { \"size\": 10, \"mitosis\": " + mit_N2.to_string()
            + ", \"emit\": " + emt_N2.to_string()
            + ", \"imagination\": " + img_N2.to_string()
            + ", \"mit_density\": " + density(mit_N2, N_N2).to_string()
            + ", \"emit_rate\": " + density(emt_N2, N_N2).to_string() + " },")
    println("    \"N3\":   { \"size\": 7,  \"mitosis\": " + mit_N3.to_string()
            + ", \"emit\": " + emt_N3.to_string()
            + ", \"imagination\": " + img_N3.to_string()
            + ", \"mit_density\": " + density(mit_N3, N_N3).to_string()
            + ", \"emit_rate\": " + density(emt_N3, N_N3).to_string() + " },")
    println("    \"REM\":  { \"size\": 3,  \"mitosis\": " + mit_REM.to_string()
            + ", \"emit\": " + emt_REM.to_string()
            + ", \"imagination\": " + img_REM.to_string()
            + ", \"mit_density\": " + density(mit_REM, N_REM).to_string()
            + ", \"emit_rate\": " + density(emt_REM, N_REM).to_string() + " }")
    println("  },")
    println("  \"ratios\": {")
    println("    \"REM_over_WAKE\": " + ratio_rem_wake.to_string() + ",")
    println("    \"N3_over_WAKE\":  " + ratio_n3_wake.to_string()  + "")
    println("  },")
    println("  \"falsifiers\": {")
    println("    \"PASS\": " + PASS.to_string() + ",")
    println("    \"FAIL\": " + FAIL.to_string() + "")
    println("  },")
    println("  \"verdict\": \"" + verdict + "\"")
    println("}")
    println("JSON_END")
}
