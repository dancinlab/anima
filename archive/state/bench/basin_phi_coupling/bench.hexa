// BENCH #1 — BASIN-PHI-COUPLING ("공명 측정자")
//
// anima-side benchmark of UNIVERSE H_345/346 capstone (🟢 SUPPORTED-NUMERICAL):
//   "basin size and exact Φ are monotonically coupled, sign-robust across
//    sys-state averaging."
//
// QUESTION: does the H_345/346 finding survive when we broaden the rule set
//   beyond Wolfram's curated {110, 30, 105, 150} on an anima-substrate proxy?
//
// SETUP: n=4 elementary cellular automaton (ECA) on a periodic ring.
//   16 states, 8 Wolfram rules chosen to span class I/II/III/IV behaviour
//   (45/54/60/90/110/126/150/184), per H_002/H_278 substrate.
//
//   basin   — 50-step settle from each of 16 starts, count attractor occupancy.
//             max_basin = largest basin size, n_attr = number of attractors.
//   Φ       — state-averaged exact IIT 4.0 phi_structure total:
//             mean_{s ∈ 0..15} phi_structure(eca_tpm(rule, 4), 4, s)[4]
//
// MEASURE: Pearson r over the 8 rules between (max_basin, mean_Φ) and
//   (n_attr, mean_Φ).
//
// VERDICT (PRE-REGISTERED on max_basin↔Φ as the primary signal, per H_341/345):
//   r ≥ +0.5   → 🟢 PASS  (anima-side reproduction of H_346 sign + strength)
//   +0.2 ≤ r < +0.5 → 🟠 WEAK
//   r < +0.2   → 🔴 FAIL  (anima-side does not reproduce; rule-set broadening
//             dilutes the signal beyond H_346's n=5 4-rule frame)

import "stdlib/consciousness/iit4_relation.hexa"
import "stdlib/consciousness/iit4_eca.hexa"

// ── n=4 ECA dynamics (state-int over 4-cell ring) ─────────────────────────

fn next4(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 4 {
        let im1 = (i + 3) % 4
        let ip1 = (i + 1) % 4
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn settle4(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 50 { s = next4(s, rule); t = t + 1 }
    return s
}

fn basin_max(rule: int) -> int {
    let basin = farr_zeros(16)
    let mut s0 = 0
    while s0 < 16 {
        let term = settle4(s0, rule)
        let cur = to_int(farr_get(basin, term))
        let _ = farr_set(basin, term, to_float(cur + 1))
        s0 = s0 + 1
    }
    let mut mx = 0
    let mut i = 0
    while i < 16 {
        let b = to_int(farr_get(basin, i))
        if b > mx { mx = b }
        i = i + 1
    }
    let _ = farr_free(basin)
    return mx
}

fn basin_nattr(rule: int) -> int {
    let oc = farr_zeros(16)
    let mut s0 = 0
    while s0 < 16 {
        let _ = farr_set(oc, settle4(s0, rule), 1.0)
        s0 = s0 + 1
    }
    let mut n = 0
    let mut i = 0
    while i < 16 {
        if to_int(farr_get(oc, i)) == 1 { n = n + 1 }
        i = i + 1
    }
    let _ = farr_free(oc)
    return n
}

// state-averaged exact phi_structure total over all 16 sys_states.
fn phi_mean_n4(rule: int) -> float {
    let tpm = eca_tpm(rule, 4)
    let mut s = 0
    let mut total = 0.0
    while s < 16 {
        let res = phi_structure(tpm, 4, s)
        total = total + res[4]
        s = s + 1
    }
    return total / 16.0
}

// ── stats ─────────────────────────────────────────────────────────────────

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + farr_get(xs, i)
        sy = sy + farr_get(ys, i)
        i = i + 1
    }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

// approximate two-sided p-value for Pearson r at sample size n (df = n-2),
// via Student-t approximation t = r * sqrt((n-2) / (1 - r^2)). For small n
// we use a coarse table cutoff for the verdict significance line.
fn pearson_t_stat(r: float, n: int) -> float {
    let df = to_float(n - 2)
    let denom_sq = 1.0 - r * r
    if denom_sq <= 0.0 { return 1.0e9 }
    return r * my_sqrt(df / denom_sq)
}

fn classify_r(r: float) -> string {
    if r >= 0.5 { return "🟢 PASS" }
    if r >= 0.2 { return "🟠 WEAK" }
    if r >= -0.2 { return "🔴 FAIL (near-zero)" }
    if r >= -0.5 { return "🟠 WEAK-REVERSED" }
    return "🔴 FAIL-REVERSED"
}

// ── main ──────────────────────────────────────────────────────────────────

fn main() {
    println("BENCH#1 BASIN-PHI-COUPLING — anima-side bench of H_345/346 capstone")
    println("substrate: n=4 ECA, 16 states, 8 rules; mean exact Φ over 16 sys-states")
    println("")

    // rule set chosen to span Wolfram classes I-IV
    let rules = [45, 54, 60, 90, 110, 126, 150, 184]
    let nrules = 8

    let mb = farr_zeros(nrules)
    let na = farr_zeros(nrules)
    let phi = farr_zeros(nrules)

    let mut i = 0
    while i < nrules {
        let r = rules[i]
        let m = basin_max(r)
        let a = basin_nattr(r)
        let p = phi_mean_n4(r)
        let _ = farr_set(mb, i, to_float(m))
        let _ = farr_set(na, i, to_float(a))
        let _ = farr_set(phi, i, p)
        println("rule=" + str(r) + " max_basin=" + str(m) + " n_attr=" + str(a) + " mean_Phi=" + str(p))
        i = i + 1
    }

    println("")
    let r_mb = pearson(mb, phi, nrules)
    let r_na = pearson(na, phi, nrules)
    let t_mb = pearson_t_stat(r_mb, nrules)
    let t_na = pearson_t_stat(r_na, nrules)
    println("Pearson(max_basin, mean_Phi)       = " + str(r_mb) + "  [t=" + str(t_mb) + " df=" + str(nrules - 2) + "]")
    println("Pearson(n_attr,    mean_Phi)       = " + str(r_na) + "  [t=" + str(t_na) + " df=" + str(nrules - 2) + "]")
    println("")
    println("primary signal: max_basin↔mean_Phi → " + classify_r(r_mb))
    println("aux    signal:  n_attr   ↔mean_Phi → " + classify_r(r_na))
    println("")
    println("H_345/346 reference (n=5):")
    println("  H_345 single(21):  max_basin↔Phi=+0.251 · n_attr↔Phi=−0.799")
    println("  H_346 state-avg :  max_basin↔Phi=+0.550 · n_attr↔Phi=−0.951")
    println("done")
}
