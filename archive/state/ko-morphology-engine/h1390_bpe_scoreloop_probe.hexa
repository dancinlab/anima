// h1390_bpe_scoreloop_probe.hexa — engine-native BINDING re-confirmation of H_1388 (🟢 GAP-REDUCED-
// CANDIDATE, DIRECTIONAL numpy MIRROR over REAL 30MB KO). Drives the WIRED morphology consult
// gen_bpe_scoreloop (core/generator.hexa §6.5d → engine_cli.hexa § KO-MORPHOLOGY BPE-ON-JAMO faculty
// bpe_learn_merges/_apply/_byte_fair_ce) on the frozen corpus-free in-engine morpheme-grammar fixture
// and prints the three structural bars + their H_1388-verbatim margin thresholds.
//
//   bar1 GAP-REDUCED : structured BPE byte-fair CE below the un-merged jamo anchor by >= 0.05
//   bar2 EARNED      : structured gain over the random-merge SHUFFLE >= 0.03 (linguistic structure)
//   bar3 CONTROL     : circular-shift surrogate earned (shift CE - novel CE >= 0.05)
//
// $0 CPU, deterministic, no corpus/secret/GPU, Ψ-disjoint pure SCORER. usage: hexa run <this>.
import "core/generator.hexa"

fn main() {
    let s = gen_bpe_scoreloop()
    let bpe = to_float(s["bpe_ce"])
    let shuf = to_float(s["shuffle_ce"])
    let jamo = to_float(s["jamo_ce"])
    let gap = to_float(s["gap_reduced"])
    let earned = to_float(s["earned"])
    let shift = to_float(s["shift_minus_novel"])
    println("===== H_1390 BPE-on-jamo morphology — engine-native scoreloop =====")
    println(gen_bpe_scoreloop_summary())
    println("")
    println("byte-fair CE (engine fixture):")
    println("  structured BPE-on-jamo : " + to_string(bpe))
    println("  random-merge SHUFFLE   : " + to_string(shuf))
    println("  un-merged jamo anchor  : " + to_string(jamo))
    println("units (struct/shuf/jamo) : " + to_string(s["n_units_struct"]) + "/"
            + to_string(s["n_units_shuf"]) + "/" + to_string(s["n_jamo"]))
    println("")
    println("bar1 GAP-REDUCED  gap_reduced=" + to_string(gap) + " >= 0.05 (jamo_ce-bpe_ce) -> "
            + (if gap >= 0.05 { "PASS" } else { "FAIL" }))
    println("bar2 EARNED       earned=" + to_string(earned) + " >= 0.03 (shuffle_ce-bpe_ce) -> "
            + (if earned >= 0.03 { "PASS" } else { "FAIL" }))
    println("bar3 CONTROL      shift-novel=" + to_string(shift) + " >= 0.05 -> "
            + (if shift >= 0.05 { "PASS" } else { "FAIL" }))
    let green = gap >= 0.05 && earned >= 0.03 && shift >= 0.05
    println("")
    println("TIER: " + (if green {
        "🟢 ENGINE-NATIVE BINDING — the BPE-on-jamo morphology unit re-confirms all 3 H_1388 structural bars engine-native"
    } else {
        "🟠/🧱 ENGINE-TRANSFER MISS — a frozen bar missed engine-native (honest, c9; report verbatim, NO bar moved)"
    }))
}
