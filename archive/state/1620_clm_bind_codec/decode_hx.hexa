// hexa-engine decode readout for the bind codec parity oracle. Runs the live
// core/clm_decode.hexa (the hexa production engine) clm_forward_ce + argmax on a
// bind/additive .clm, printing the SAME fields decode_py.py prints, so a driver
// can byte-diff hexa<=>py (single-decode parity oracle). a_engine_native_learning.
//   args: <clm> <corpus> <nwin> <seed> <gen>
use "core/clm_decode"

fn _argv(raw: [string]) -> [string] {
    let mut start = 1
    let mut k = 0
    while k < len(raw) { if raw[k] == "--" { start = k + 1 }  k = k + 1 }
    let a = []
    let mut m = start
    while m < len(raw) { a.push(raw[m]); m = m + 1 }
    return a
}

fn main() {
    let av = _argv(args())
    let clm = av[0]
    let corpus = av[1]
    let nwin = to_int(av[2])
    let seed = av[3]
    let gen = to_int(av[4])

    let rt = clm_readout_type(clm)
    let ce = clm_forward_ce(clm, corpus, nwin)
    let am = clm_decode_argmax(clm, seed, gen)

    print("RTYPE=" + to_string(rt) + " KBIND=" + to_string(to_int(ce["kbind"])))
    print("CE model_ce=" + fmt6(to_float(ce["model_ce"]))
          + " shuffle_ce=" + fmt6(to_float(ce["shuffle_ce"]))
          + " uniform_ce=" + fmt6(to_float(ce["uniform_ce"]))
          + " windows=" + to_string(to_int(ce["windows"])))
    print("ARGMAX:" + to_string(am["text"]))
}

// fmt6 — fixed 6-decimal print so the text matches python's %.6f for the diff.
fn fmt6(x: float) -> string {
    let neg = x < 0.0
    let mut v = x
    if neg { v = 0.0 - v }
    let scaled = v * 1000000.0 + 0.5
    let ip = to_int(scaled)
    let whole = ip / 1000000
    let frac = ip - whole * 1000000
    let mut fs = to_string(frac)
    while byte_len(fs) < 6 { fs = "0" + fs }
    let mut out = to_string(whole) + "." + fs
    if neg { out = "-" + out }
    return out
}
