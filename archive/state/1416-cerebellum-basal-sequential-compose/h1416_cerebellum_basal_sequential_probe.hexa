// h1416_cerebellum_basal_sequential_probe.hexa — H_1416: the THIRD lens on the
// engine-native cerebellum×basal WALL (after H_1412 arbitration 🧱, H_1413 modulation 🧱).
//
// LENS #3 — SEQUENTIAL cerebello-basal-thalamo-cortical LOOP (a_no_llm_frame_trap):
// the cerebellum's FORWARD MODEL does NOT vote against the basal gate's OUTPUT — it REFINES
// the cortical STATE ESTIMATE the basal gate READS, BEFORE the (single) gate fires. The
// cerebellum supplies a reliability-gated correction to the basal gate's INPUT feature; the
// LIVE basal gate then fires on the CORRECTED state. PIPELINE (cerebellum→basal), not
// PARALLEL arbitration (H_1412) or margin-modulation (H_1413).
//
// FROZEN H_1407 bars re-scored VERBATIM (NOT moved). 3 seeds [4700,4701,4702].
// Engine-native: LIVE vforward_err (H_1280 VForwardField) + LIVE vbasal_go_value (H_1281
// VBasalGate). p7 · p8 · a_engine_native_learning · a_verified_must_wire · c9 · c16.

import "core/engine_cli.hexa"
import "core/brain.hexa"

// ── frozen knobs (pre-registered, == H_1407 FREEZE.txt) ──────────────────────
fn _SEEDS() -> [int] { return [4700, 4701, 4702] }
const N_PER_FAMILY: int = 90        // items per family (F1..F5) → 450 items/seed
const AMBIG_NOISE: float = 0.18     // jitter toward decision boundary
const E_THR: float = 0.30           // cerebellum prediction-error threshold
const GO_THR: float = 0.0           // basal go-margin threshold
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar
const REFINE_GAIN: float = 1.0      // FROZEN at the gate's go-value unit (NO tuned knob)

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _clamp01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }

// ── deterministic Gaussian jitter (Box–Muller over a deterministic LCG) ──────
// VERBATIM the H_1412 draw so the fixture is byte-for-byte the SAME items.
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(x: float, seed: int, idx: int, salt: int) -> float {
    return x + AMBIG_NOISE * _stdnorm(seed, idx, salt)
}

// ── per-item (pred_error, go_margin, correct, fam) — the 5 H_1407 families ────
// VERBATIM the H_1412 _item build (NOT changed): the substrate states are DERIVED from the
// family structure, NOT set to the answer.
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut pred_error = 0.0
    let mut go_margin = 0.0
    let mut correct = 0.0
    if fam == 0 {
        // F1 CEREBELLUM-DECISIVE: low pred-error (cerebellum SELECTS-PRED, correct), basal tie.
        pred_error = _jit(0.12, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(0.0, seed, i, 2)
        correct = 1.0
    } else if fam == 1 {
        // F2 BASAL-DECISIVE: strong negative go-margin (basal SELECTS-COMPETITOR, correct),
        //                    cerebellum near threshold (~chance).
        pred_error = E_THR + _jit(0.0, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.5, seed, i, 2)
        correct = 0.0
    } else if fam == 2 {
        // F3 AGREE: low pred-error + positive go-margin, both lean correct (redundant).
        pred_error = _jit(0.10, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(0.5, seed, i, 2)
        correct = 1.0
    } else if fam == 3 {
        // F4 CONFLICT (cerebellum right): low pred-error (cerebellum correct) BUT negative
        //                                 go-margin (basal wrong).
        pred_error = _jit(0.08, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.45, seed, i, 2)
        correct = 1.0
    } else {
        // F5 ADVERSARIAL (basal right, cerebellum LOUDER-but-wrong): VERY low pred-error
        //   (cerebellum votes PRED loudly, WRONG) + strong negative go-margin (basal correct).
        pred_error = _jit(0.05, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.6, seed, i, 2)
        correct = 0.0
    }
    return [pred_error, go_margin, correct]
}

// ── a LIVE VBasalGate trained gradient-free to a positive go-weight on dim0 ───
// VERBATIM the H_1412 trained gate: the LIVE vbasal_update delta rule grows a positive
// go-weight on dim0, so go_value([v]) ≈ gw0*v + go_b and the go-margin preserves SIGN+SCALE.
fn _trained_gate(cfg: EngineConfig) -> VBasalGate {
    let mut bg = vbasal_new(1, 0.20)
    let mut t = 0
    while t < 40 {
        bg = vbasal_update(bg, 0, [1.0], 1.0)
        t = t + 1
    }
    return bg
}

// ── cerebellum reliability (LIVE vforward_err) ───────────────────────────────
// reliability rel = clamp01((E_THR − err)/E_THR): 1 when the forward model is sure (err→0),
// 0 when err ≥ E_THR. err is the LIVE vforward_err (ctx=[0], x=[sqrt(pe)] ⇒ err = pe).
fn _cb_reliability(ff: VForwardField, pe: float) -> float {
    let err = vforward_err(ff, [0.0], [sqrt(pe)])
    return _clamp01((E_THR - err) / E_THR)
}
fn _cb_err(ff: VForwardField, pe: float) -> float {
    return vforward_err(ff, [0.0], [sqrt(pe)])
}

// ── the SEQUENTIAL refine→gate: cerebellum REFINES the basal INPUT, then the LIVE gate fires.
// refined_pred_feat = pred_feat + REFINE_GAIN*rel ; refined_comp_feat = comp_feat (unchanged).
// decision = SELECT-PREDICTED iff vbasal_go_value(refined_pred) − vbasal_go_value(refined_comp) > GO_THR.
// `rel` is the cerebellum reliability fed in (the LIVE value, or a SHUFFLED one, or 0 for ablate).
fn _seq_decide(bg: VBasalGate, go_margin: float, rel: float) -> float {
    let refined_pred = go_margin + REFINE_GAIN * rel   // the predicted-move feature, cerebellum-refined
    let refined_comp = 0.0                             // competitor feature unchanged
    let gv_pred = vbasal_go_value(bg, [refined_pred])
    let gv_comp = vbasal_go_value(bg, [refined_comp])
    let margin = gv_pred - gv_comp
    if margin > GO_THR { return 1.0 }
    return 0.0
}

// run_seed — score the FROZEN bars for one seed on the LIVE faculties. Returns a flat list:
//   [acc_cerebellum, acc_basal, best_single, acc_seq, acc_shuffle, acc_oracle, acc_ablate,
//    conflict_rate, only_cerebellum, only_basal, both, neither, gw0]
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY
    let ff = vforward_new(1, 1, 0.10)        // untrained forward model: predicts zero frame
    let bg = _trained_gate(cfg)              // LIVE gate with a learned positive go-weight
    let gw0 = bg.go_w[0]

    // first pass: per-item LIVE reads (cerebellum reliability+direction, basal-alone decision, correct).
    let mut cb_dec: [float] = []     // cerebellum-alone decision (err < E_THR ⇒ 1)
    let mut bg_dec: [float] = []     // basal-alone decision (plain go-margin > 0)
    let mut rel:   [float] = []      // cerebellum reliability (LIVE), for the refinement
    let mut gm:    [float] = []      // the per-item basal go_margin feature
    let mut corr:  [float] = []
    let mut i = 0
    while i < n {
        let it = _item(seed, i)
        let pe = it[0]  let go_margin = it[1]
        corr = corr + [it[2]]
        gm = gm + [go_margin]
        // CEREBELLUM-alone — LIVE vforward_err.
        let err = _cb_err(ff, pe)
        cb_dec = cb_dec + [if err < E_THR { 1.0 } else { 0.0 }]
        rel = rel + [_clamp01((E_THR - err) / E_THR)]
        // BASAL-alone — LIVE vbasal_go_value with NO refinement (rel implicitly 0).
        bg_dec = bg_dec + [_seq_decide(bg, go_margin, 0.0)]
        i = i + 1
    }

    // SHUFFLE control: permute which cerebellum RELIABILITY attaches to which item, then
    // run the SAME sequential refine→gate. A deterministic Fisher–Yates (seed-derived LCG).
    let mut perm: [int] = []
    let mut s = 0
    while s < n { perm = perm + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r = st % (a + 1)
        let tmp = perm[a]  perm[a] = perm[r]  perm[r] = tmp
        a = a - 1
    }

    // second pass: SEQUENTIAL compose (LIVE refine→gate), shuffle, ablate, oracle, decomposition.
    let mut on_cb = 0  let mut on_bg = 0  let mut on_seq = 0  let mut on_shuf = 0
    let mut on_abl = 0  let mut on_oracle = 0
    let mut conflict = 0
    let mut only_c = 0  let mut only_b = 0  let mut both = 0  let mut neither = 0
    let mut j = 0
    while j < n {
        let cd = cb_dec[j]  let bd = bg_dec[j]  let ct = corr[j]
        // SEQUENTIAL compose: cerebellum reliability refines the basal input, gate fires.
        let seq = _seq_decide(bg, gm[j], rel[j])
        // SHUFFLE: the WRONG item's reliability refines THIS item's basal input.
        let shuf = _seq_decide(bg, gm[j], rel[perm[j]])
        // ABLATION: refinement OFF (rel := 0) ⇒ plain basal gate.
        let abl = _seq_decide(bg, gm[j], 0.0)
        let cb_ok = cd == ct
        let bg_ok = bd == ct
        if cb_ok { on_cb = on_cb + 1 }
        if bg_ok { on_bg = on_bg + 1 }
        if seq == ct { on_seq = on_seq + 1 }
        if shuf == ct { on_shuf = on_shuf + 1 }
        if abl == ct { on_abl = on_abl + 1 }
        if cb_ok || bg_ok { on_oracle = on_oracle + 1 }
        if cd != bd { conflict = conflict + 1 }
        if cb_ok && !bg_ok { only_c = only_c + 1 }
        if bg_ok && !cb_ok { only_b = only_b + 1 }
        if cb_ok && bg_ok { both = both + 1 }
        if !cb_ok && !bg_ok { neither = neither + 1 }
        j = j + 1
    }

    let dn = to_float(n)
    let acc_cb = to_float(on_cb) / dn
    let acc_bg = to_float(on_bg) / dn
    let best = if acc_cb >= acc_bg { acc_cb } else { acc_bg }
    let acc_seq = to_float(on_seq) / dn
    let acc_shuf = to_float(on_shuf) / dn
    let acc_abl = to_float(on_abl) / dn
    let acc_o = to_float(on_oracle) / dn
    return [acc_cb, acc_bg, best, acc_seq, acc_shuf, acc_o, acc_abl,
            to_float(conflict) / dn,
            to_float(only_c) / dn, to_float(only_b) / dn,
            to_float(both) / dn, to_float(neither) / dn, gw0]
}

fn main() {
    println("================================================================================")
    println("H_1416 — ENGINE-NATIVE cerebellum (H_1280 VForwardField) × basal (H_1281 VBasalGate)")
    println("  LENS #3: SEQUENTIAL cerebello-basal PIPELINE (cerebellum REFINES the basal INPUT, then")
    println("  the LIVE gate fires) — re-scoring frozen H_1407 bars. After arbitration (H_1412 🧱)")
    println("  and modulation (H_1413 🧱). $0 CPU · 3 seeds · p7 · p8 · a_break_the_wall · c16")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = _SEEDS()

    let mut acc_cb = 0.0  let mut acc_bg = 0.0  let mut best = 0.0
    let mut acc_seq = 0.0  let mut acc_shuf = 0.0  let mut acc_o = 0.0  let mut acc_abl = 0.0
    let mut conf = 0.0  let mut o_c = 0.0  let mut o_b = 0.0  let mut bo = 0.0  let mut ne = 0.0
    let mut gw0 = 0.0
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        println("  seed " + to_string(seeds[si]) + ": cb=" + _f4(r[0]) + " bg=" + _f4(r[1])
              + " best=" + _f4(r[2]) + " seq=" + _f4(r[3]) + " shuf=" + _f4(r[4])
              + " oracle=" + _f4(r[5]) + " ablate=" + _f4(r[6]) + " | conflict=" + _f4(r[7])
              + " [onlyCB=" + _f4(r[8]) + " onlyBG=" + _f4(r[9]) + " both=" + _f4(r[10])
              + " neither=" + _f4(r[11]) + "] gw0=" + _f4(r[12]))
        acc_cb = acc_cb + r[0]  acc_bg = acc_bg + r[1]  best = best + r[2]
        acc_seq = acc_seq + r[3]  acc_shuf = acc_shuf + r[4]  acc_o = acc_o + r[5]  acc_abl = acc_abl + r[6]
        conf = conf + r[7]  o_c = o_c + r[8]  o_b = o_b + r[9]  bo = bo + r[10]  ne = ne + r[11]
        gw0 = gw0 + r[12]
        si = si + 1
    }
    acc_cb = acc_cb / ns  acc_bg = acc_bg / ns  best = best / ns
    acc_seq = acc_seq / ns  acc_shuf = acc_shuf / ns  acc_o = acc_o / ns  acc_abl = acc_abl / ns
    conf = conf / ns  o_c = o_c / ns  o_b = o_b / ns  bo = bo / ns  ne = ne / ns  gw0 = gw0 / ns

    println("--------------------------------------------------------------------------------")
    println("MEAN (3 seeds, ENGINE-NATIVE, SEQUENTIAL PIPELINE):")
    println("  acc_cerebellum = " + _f4(acc_cb))
    println("  acc_basal      = " + _f4(acc_bg))
    println("  best_single    = " + _f4(best))
    println("  acc_seqcompose = " + _f4(acc_seq))
    println("  acc_shuffle    = " + _f4(acc_shuf) + "   (compose - shuffle = " + _f4(acc_seq - acc_shuf) + ")")
    println("  acc_ablate     = " + _f4(acc_abl) + "   (compose - ablate  = " + _f4(acc_seq - acc_abl) + ")")
    println("  ORACLE         = " + _f4(acc_o) + "   (oracle - best = " + _f4(acc_o - best) + ")")
    println("  conflict_rate  = " + _f4(conf))
    println("  decomposition  : only_cerebellum=" + _f4(o_c) + " only_basal=" + _f4(o_b)
          + " both=" + _f4(bo) + " neither=" + _f4(ne))
    println("  (LIVE gate learned go-weight gw0 = " + _f4(gw0) + " > 0 ⇒ basal margins are the gate's OWN go-value)")

    let B1 = acc_seq >= best + COMPOSE_DELTA
    let B2 = (acc_o - best) > ORACLE_MARGIN
    let B3 = (acc_seq - acc_shuf) > SHUFFLE_TOL
    let ABL = (acc_seq - acc_abl) > 0.0
    let SEP = o_c > 0.0 && o_b > 0.0
    println("--------------------------------------------------------------------------------")
    println("  (B1 COMPOSE-EFFECT) seqcompose " + _f4(acc_seq) + " >= best+" + _f4(COMPOSE_DELTA)
          + " (" + _f4(best + COMPOSE_DELTA) + ") : " + (if B1 { "PASS" } else { "FAIL" }))
    println("  (B2 ORACLE)         oracle-best " + _f4(acc_o - best) + " > " + _f4(ORACLE_MARGIN)
          + " : " + (if B2 { "PASS" } else { "FAIL" }))
    println("  (B3 EARNED)         seqcompose-shuffle " + _f4(acc_seq - acc_shuf) + " > " + _f4(SHUFFLE_TOL)
          + " : " + (if B3 { "PASS" } else { "FAIL" }))
    println("  (ABLATION)          seqcompose-ablate " + _f4(acc_seq - acc_abl) + " > 0 : " + (if ABL { "PASS" } else { "FAIL" }))
    println("  (SEPARABLE)         only_cerebellum>0 AND only_basal>0 : " + (if SEP { "PASS" } else { "FAIL" }))
    println("================================================================================")
    if B1 && B2 && B3 && ABL && SEP {
        println("VERDICT: 🟢 SEQUENTIAL-COMPOSE-BINDS (ENGINE-NATIVE) — the cerebello-basal PIPELINE")
        println("  (cerebellum reliability REFINES the LIVE basal INPUT, then the single gate fires)")
        println("  lifts over best-single, EARNED vs shuffle, refinement-dependent (ablation collapses).")
        println("  Lens #3 BINDS where arbitration (H_1412) and modulation (H_1413) did not.")
    } else {
        println("VERDICT: 🧱 THIRD-LENS TERMINAL — a frozen bar did not reproduce engine-native.")
        println("  The cerebellum×basal wall is confirmed terminal across THREE genuinely different")
        println("  lenses (arbitration H_1412, modulation H_1413, sequential pipeline H_1416):")
        println("  a strong-standalone-arm pair does NOT bind engine-native. Honest 🧱 = valid (c9/c16).")
    }
    println("  HONEST (c9): bars FROZEN from H_1407 FREEZE.txt, NOT moved. Toy 5-family fixture, 3 seeds,")
    println("  deterministic. cerebellum reliability = LIVE vforward_err; basal decision = LIVE vbasal_go_value")
    println("  on the cerebellum-REFINED input. REFINE_GAIN frozen at the gate's go-value unit (1.0), no tuned")
    println("  knob. Scale/real-corpus/engine-transfer UNVERIFIED.")
    if !(B1 && B2 && B3 && ABL && SEP) { exit(1) }
}
