// probe_h348_gz_si.hexa — H_348 GZ_LOWER inhibition → Savant Index probe
//
// Hypothesis (H_348): lowering one domain's inhibition I to
// GZ_LOWER = 1/2 - ln(4/3) ≈ 0.21232 in the SAVANT canonical 4-domain
// substrate (savant_phi.hexa) produces SI = max(domain_phi) / min(domain_phi) > 3.
// Falsifier: SI ≤ 3 OR I sweep is flat (no peak at GZ_LOWER).
//
// Mapping (substrate-level — see body §3): inhibition I ∈ (0,1] is mapped
// to a per-domain gain via gain_focus = 1.0 + (1.0 - I) * 9.0  so
//   I = 1.0   → gain_focus = 1.0  (no release, balanced)
//   I = 0.5   → gain_focus = 5.5  (mid release)
//   I = 1/e   → gain_focus ≈ 6.69 (GZ_CENTER)
//   I = 0.21232 → gain_focus ≈ 8.09 (GZ_LOWER)
//   I = 0.05  → gain_focus = 9.55 (extreme release)
// Other domains share the remaining capacity:
//   gain_rest = (SV_CAPACITY - gain_focus) / 3
//
// SI is measured as max(domain_phi) / min(domain_phi) per the H_348
// definition (we use phi instead of raw tension — phi already aggregates
// the per-domain super-linear activation energy, matching the H_348
// "phi or tension" disjunction).
//
// Constants are duplicated from savant_phi.hexa (SSOT comment marker).

let SV_D            = 6
let SV_N_DOM        = 4
let SV_BINS         = 6
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

let DOM_CALENDAR = 0

// ── Primitives (SSOT: HEXAD/SAVANT/savant_phi.hexa) ─────────────

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

// Tension of a domain = mean(|activation|) — alt measurement (H_348 disjunction)
fn domain_tension(flat: array, k: int, d: int) -> float {
    let v = extract_domain(flat, k, d)
    let mut s = 0.0
    let mut j = 0
    while j < d {
        s = s + sv_abs(v[j])
        j = j + 1
    }
    return s / to_float(d)
}

fn domain_tension_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        out = out.push(domain_tension(flat, k, d))
        k = k + 1
    }
    return out
}

// SI = max(v) / min(v)  with eps guard
fn savant_index(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut mx = v[0]
    let mut mn = v[0]
    let mut i = 1
    while i < n {
        if v[i] > mx { mx = v[i] }
        if v[i] < mn { mn = v[i] }
        i = i + 1
    }
    if mn < SV_EPS { return mx / SV_EPS }
    return mx / mn
}

// ── inhibition I → gain_focus mapping ───────────────────────────
//
// gain_focus(I) = 1 + (1 - I) * 9   (I=1 → 1, I=0 → 10)
// gain_rest = (SV_CAPACITY - gain_focus) / 3
fn gain_focus_for(i_val: float) -> float {
    return 1.0 + (1.0 - i_val) * 9.0
}

// Single-I measurement on CALENDAR domain at fixed stim_seed
fn measure_at_inhibition(i_val: float, stim_seed: int) {
    let g_focus = gain_focus_for(i_val)
    let g_rest = (SV_CAPACITY - g_focus) / 3.0
    let flat = build_profile_state(g_focus, g_rest, g_rest, g_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    let dten = domain_tension_vector(flat, SV_D)
    let si_phi = savant_index(dphi)
    let si_ten = savant_index(dten)
    println("I=" + str(i_val) + " gf=" + str(g_focus) + " gr=" + str(g_rest)
         + " phi=[" + str(dphi[0]) + "," + str(dphi[1]) + "," + str(dphi[2]) + "," + str(dphi[3]) + "]"
         + " ten=[" + str(dten[0]) + "," + str(dten[1]) + "," + str(dten[2]) + "," + str(dten[3]) + "]"
         + " SI_phi=" + str(si_phi)
         + " SI_ten=" + str(si_ten))
}

fn main() {
    println("[H_348] GZ_LOWER inhibition → Savant Index probe")
    println("  substrate: HEXAD/SAVANT/savant_phi.hexa (SSOT) — 4-domain, d=6")
    println("  GZ_LOWER  = 0.5 - ln(4/3) ≈ 0.21232")
    println("  GZ_CENTER = 1/e          ≈ 0.36788")
    println("  mapping   : gain_focus = 1 + (1 - I) * 9 ; gain_rest = (11.5 - gf) / 3")
    println("  SI metric : max(domain_phi or tension) / min(...)")
    println("  falsifier : SI ≤ 3 OR sweep flat (no peak at GZ_LOWER)")
    println("")
    println("I sweep — seed 42424 (savant_phi T1 stim):")

    // Sweep I in the H_348 spec order
    measure_at_inhibition(0.05, 42424)
    measure_at_inhibition(0.10, 42424)
    measure_at_inhibition(0.15, 42424)
    measure_at_inhibition(0.21232, 42424)   // GZ_LOWER ★
    measure_at_inhibition(0.25, 42424)
    measure_at_inhibition(0.36788, 42424)   // GZ_CENTER (1/e)
    measure_at_inhibition(0.50, 42424)
    measure_at_inhibition(0.75, 42424)
    measure_at_inhibition(0.95, 42424)

    println("")
    println("I sweep — seed 91919 (savant_phi T2 stim) — replication:")
    measure_at_inhibition(0.05, 91919)
    measure_at_inhibition(0.21232, 91919)
    measure_at_inhibition(0.36788, 91919)
    measure_at_inhibition(0.50, 91919)
    measure_at_inhibition(0.95, 91919)

    println("")
    println("I sweep — seed 77777 (savant_phi T3 stim) — replication:")
    measure_at_inhibition(0.05, 77777)
    measure_at_inhibition(0.21232, 77777)
    measure_at_inhibition(0.36788, 77777)
    measure_at_inhibition(0.50, 77777)
    measure_at_inhibition(0.95, 77777)
}
