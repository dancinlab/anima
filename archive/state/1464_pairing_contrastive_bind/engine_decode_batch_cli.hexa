// engine_decode_batch_cli.hexa — LOAD-ONCE batch decode for the H_1441 engine-native 5-bar.
// argv: <bin_path> <jobs_path> <out_path> <gen> <top_k> <temp_milli>
// Loads the 303M ONCE (bg_load) then generates every fragment in jobs_path via the live
// native-GEMM CORE/bytegpt_decode forward (farr_matmul / cuBLAS), appending `tag<TAB>text`
// to out_path as each finishes (commit-early/resumable).
//
// argv() in this hexa ships [bin, "--", user-args...] → first user arg lives after the "--"
// separator. Compute a base offset so the CLI is robust to the separator's presence/absence.
import "core/bytegpt_decode.hexa"
fn main() {
    let a = argv()
    let b = 0
    let i = 0
    while i < len(a) {
        if a[i] == "--" { b = i + 1 }
        i = i + 1
    }
    // if no "--" was seen, fall back to legacy a[1..] (b stays 0 → first arg at a[b+1]).
    let bin   = a[b + 0]
    let jobs  = a[b + 1]
    let out   = a[b + 2]
    let gen   = to_int(a[b + 3])
    let top_k = to_int(a[b + 4])
    let temp  = to_float(to_int(a[b + 5])) / 1000.0
    let n = bytegpt_decode_batch_to_file(bin, jobs, out, gen, top_k, temp)
    println("BATCH_DONE " + to_string(n) + " fragments")
}
