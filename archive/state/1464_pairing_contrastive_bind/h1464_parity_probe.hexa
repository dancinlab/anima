// h1464_parity_probe.hexa — argmax==torch parity for H_1464 engine-native (a_engine_native_learning).
// Loads a ByteGPT-303M .bin via the live core/bytegpt_decode forward (bytegpt_forward_last_ranged),
// prints last-position next-byte argmax for the SAME 15-byte prompt "The quick brown" as the torch
// golden (h1464_torch_golden.py). PARITY: CORE_ARGMAX must == TORCH_ARGMAX (byte-faithful mouth).
// argv: <bin_path>
import "core/bytegpt_decode.hexa"
fn main() {
    let a = argv()
    let mut b = 0
    let mut i = 0
    while i < len(a) { if a[i] == "--" { b = i + 1 } i = i + 1 }
    let path = a[b + 0]
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut j = 0
    while j < T { let _ = farr_set(ids, j, to_float(pb[j])); j = j + 1 }
    let am = bytegpt_forward_last_ranged(path, ids, T)
    println("CORE_ARGMAX " + to_string(am))
}
