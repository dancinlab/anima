// state/1563_savant_cusp_hysteresis/h1563_hysteresis_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1563 — SAVANT CUSP HYSTERESIS / IRREVERSIBILITY (engine-native, live §ThirdLaw latch)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  DIRECT FOLLOW-ON to H_1562 (#2568 GREEN). H_1562 found savant ability turns ON as a STEP JUMP at
//  the golden-zone boundary, but its B4 (report-only) noted the classifier is MEMORYLESS — raise I
//  back above the GZ and the savant instantly turns OFF. Real ACQUIRED savants (Orlando Serrell,
//  Derek Amato) are the opposite: a one-time event flips the ability ON and it PERSISTS for life.
//  HYPOTHESIS: savant cusp is a HYSTERESIS loop — disinhibit (I↓) into the GZ ⇒ ability ON; then
//  re-inhibit (I↑) back across the GZ boundary ⇒ ability STAYS ON (latch); only much STRONGER
//  over-inhibition (I > I_off ≫ GZ_UPPER) finally erases it. ON-threshold ≠ OFF-threshold = the
//  asymmetric loop = the substrate basis of acquired-savant permanence.
//
//  ENGINE-NATIVE (a_engine_native_learning HARD-GATE): every measurement calls the LIVE
//  core/engine_cli.hexa §ThirdLaw latch ops — third_law_ability_latched (1-bit latch over the
//  memoryless third_law_ability), third_law_ability_memoryless (B5 ablation alias), and
//  third_law_hysteresis_width (down→up trajectory loop width). NO numpy, NO torch. The latch builds
//  ON TOP of H_1562's third_law_ability and the live SAVANT golden-zone window (sa_gz_lower/upper).
//
//  FROZEN 5-BAR (frozen-first, set BEFORE the run — c9):
//   B1 latch       : after I↓ latches ON, raising I back ABOVE the ON edge (GZ_UPPER) but ≤ I_off
//                    keeps ability == 1 (does NOT drop to 0 the moment I leaves the GZ). Concretely:
//                    latched ability at I=0.55 and I=0.70 (both > GZ_UPPER=0.5, both ≤ I_off=0.75) == 1.
//   B2 asymmetry   : ON threshold (down trajectory) ≠ OFF threshold (up trajectory); measured loop
//                    width = |I_on − I_off| > 0 (a real hysteresis band, not a single switch point).
//   B3 eventual-off: raising I far enough (> I_off) DOES turn the latched faculty OFF — the latch is
//                    NOT a permanent stick (biologically plausible: extreme over-inhibition erases).
//                    latched ability at I=0.90 (> I_off=0.75) == 0.
//   B4 D-gated     : with D=0 the latch NEVER engages (no ON to begin with) — width == 0 / latched
//                    ability stays 0 across the whole trajectory (D=0 is not a genius, H_236).
//   B5 control     : ABLATING the latch (third_law_ability_memoryless, no state) reverts to the
//                    H_1562 memoryless behaviour — re-inhibition OFFs immediately, measured width 0.
//                    latch ON ⇒ width > 0 vs memoryless ⇒ width 0 = the latch IS the cause of hysteresis.
//
//  VERDICT: 🟢 GREEN iff B1 ∧ B2 ∧ B3 ∧ B4 ∧ B5. If no latch is realisable (width 0 everywhere),
//  the honest negative — "savant ability is memoryless; acquired-savant permanence is a DIFFERENT
//  mechanism" — is a valid result (c9, NO tune-to-green).
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn main() {
    let gz_lo = sa_gz_lower()    // 0.21231792755821914
    let gz_hi = sa_gz_upper()    // 0.5

    // Acquired-savant operating point: high structural deficit/disinhibition D, high preparedness P.
    let D = 0.9
    let P = 0.9

    print("=== H_1563 SAVANT CUSP HYSTERESIS (engine-native §ThirdLaw latch + sa_*) ===")
    print("GZ_LOWER=" + to_string(gz_lo) + " GZ_UPPER=" + to_string(gz_hi))
    print("operating point D=" + to_string(D) + " P=" + to_string(P))

    // ── B2: measured hysteresis loop width on the LIVE engine trajectory (down 181 → up 181) ─────
    let width   = third_law_hysteresis_width(D, P, 181, 181)
    let width_z = third_law_hysteresis_width(0.0, P, 181, 181)   // D=0 control (B4)
    print("[LOOP] hysteresis width (D>0) = " + to_string(width))
    print("[LOOP] hysteresis width (D=0) = " + to_string(width_z))

    // ── Trace the latch trajectory explicitly: disinhibit (I falls), then re-inhibit (I rises). ──
    // We replay the same physics the width fn measures so the I_on / I_off edges are printed.
    let down = [0.95, 0.80, 0.60, 0.50, 0.40, 0.30, 0.22, 0.15]   // I descending (disinhibition)
    let up   = [0.15, 0.22, 0.40, 0.50, 0.55, 0.70, 0.80, 0.90]   // I ascending  (re-inhibition)

    print("--- DOWN leg (disinhibit, I falling): memoryless ability vs latched ability ---")
    let mut latch = 0
    let mut j = 0
    while j < len(down) {
        let ii = down[j]
        let ml = third_law_ability_memoryless(D, P, ii)
        latch = third_law_ability_latched(D, P, ii, latch)
        print("I=" + to_string(ii) + " memoryless=" + to_string(ml) + " latched=" + to_string(latch))
        j = j + 1
    }
    let latch_after_down = latch

    print("--- UP leg (re-inhibit, I rising): memoryless DROPS, latched PERSISTS until I>I_off ---")
    j = 0
    while j < len(up) {
        let ii = up[j]
        let ml = third_law_ability_memoryless(D, P, ii)
        latch = third_law_ability_latched(D, P, ii, latch)
        print("I=" + to_string(ii) + " memoryless=" + to_string(ml) + " latched=" + to_string(latch))
        j = j + 1
    }

    // ── B1 spot checks: latched ability at I above GZ_UPPER but ≤ I_off persists. We must re-latch
    //   from a fresh ON state (the trajectory above already released it at I=0.90). ───────────────
    // re-establish ON via a disinhibition tick inside the GZ, then probe the persistence band.
    let on0 = third_law_ability_latched(D, P, 0.30, 0)            // enter GZ → latch ON
    let p55 = third_law_ability_latched(D, P, 0.55, on0)          // I above GZ_UPPER, ≤ I_off
    let p70 = third_law_ability_latched(D, P, 0.70, p55)          // still ≤ I_off
    let p90 = third_law_ability_latched(D, P, 0.90, p70)          // I > I_off → erase
    print("[B1/B3 band] on@0.30=" + to_string(on0) + " persist@0.55=" + to_string(p55)
          + " persist@0.70=" + to_string(p70) + " erase@0.90=" + to_string(p90))

    // ── B5 control: memoryless ablation width is 0 by construction (no state to carry). We show the
    //   memoryless ON→OFF flips the instant I leaves the GZ (no persistence band). ────────────────
    let ml55 = third_law_ability_memoryless(D, P, 0.55)
    let ml70 = third_law_ability_memoryless(D, P, 0.70)
    print("[B5 memoryless band] ml@0.55=" + to_string(ml55) + " ml@0.70=" + to_string(ml70)
          + " (memoryless ⇒ 0 above GZ_UPPER, no hysteresis)")

    // ── VERDICT lines (frozen bars) ─────────────────────────────────────────────────────────────
    print("=== FROZEN BARS ===")
    // B1 latch: persists above GZ_UPPER (0.5) within the band
    let b1 = (p55 == 1) && (p70 == 1)
    print("B1 latch (ability persists at I=0.55 & I=0.70 > GZ_UPPER): " + to_string(b1)
          + " (p55=" + to_string(p55) + " p70=" + to_string(p70) + ")")
    // B2 asymmetry: measured loop width > 0
    let b2 = width > 0.0
    print("B2 asymmetry (hysteresis width > 0): " + to_string(b2) + " (width=" + to_string(width) + ")")
    // B3 eventual-off: over-inhibition erases
    let b3 = (p90 == 0)
    print("B3 eventual-off (I=0.90 > I_off erases latch): " + to_string(b3) + " (p90=" + to_string(p90) + ")")
    // B4 D-gated: D=0 → no loop
    let b4 = (width_z == 0.0)
    print("B4 D-gated (D=0 width == 0, latch never engages): " + to_string(b4) + " (width_z=" + to_string(width_z) + ")")
    // B5 control: memoryless ablation has no persistence band (0 above GZ_UPPER) ⇒ width 0
    let b5 = (ml55 == 0) && (ml70 == 0) && (width > 0.0)
    print("B5 control (memoryless OFF above GZ_UPPER while latch persists): " + to_string(b5)
          + " (ml55=" + to_string(ml55) + " ml70=" + to_string(ml70) + " latch_width=" + to_string(width) + ")")

    let green = b1 && b2 && b3 && b4 && b5
    print("=== VERDICT: B1&B2&B3&B4&B5 = " + to_string(green) + " ===")
}
