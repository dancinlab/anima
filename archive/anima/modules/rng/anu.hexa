// anima/modules/rng/anu.hexa — ANU Quantum Random Numbers Server (Tier 1)
//
// Public quantum RNG service from Australian National University.
// API: https://qrng.anu.edu.au/API/jsonI.php?length=N&type=uint8
//
// Tier 1: free, public, real quantum (vacuum fluctuation), ~1k bps unsigned
// (rate-limited).
//
// raw#9 hexa-only strict. raw#10:
//   (1) UPSTREAM SWAP DONE 2026-05-02 — uses hexa-lang `stdlib/qrng_anu`
//       (`qrng_anu_uint8_live`) for HTTP+JSON. Legacy `_anu_fetch_via_curl`
//       removed; `_anu_parse_json` retained as internal selftest helper only.
//   (2) ANU public API rate-limit ~1 request/min unsigned. Inter-chunk pause
//       bumped to 60s (ANU_PAUSE_MS=60000) to honor FAQ recommendation.
//   (3) NIST SP 800-90B health tests NOT applied (informational only).
//   (4) Selftest uses fixture JSON (mock); set ANIMA_QRNG_LIVE=1 for real call.
//   (5) Network failure / rate-limit → returns ok=0 with reason; router falls
//       back to next source in chain (esp32 → urandom).

// ── inline struct mirror (SSOT: anima/core/rng/source.hexa) ─

use "stdlib/qrng_anu"

struct RngSourceMeta {
    name:           str,
    tier:           int,
    throughput_bps: int,
    cost_usd:       int,
    lead_days:      int,
    is_quantum:     int,
    is_local:       int,
    is_free:        int,
    status:         str,
    vendor:         str
}

struct RngCollectResult {
    ok:             int,
    n_bytes:        int,
    bytes_:         [int],
    sha256_hex:     str,
    message:        str
}

fn rng_meta_make(
    name: str, tier: int, throughput_bps: int, cost_usd: int,
    lead_days: int, is_quantum: int, is_local: int, is_free: int,
    status: str, vendor: str
) -> RngSourceMeta {
    return RngSourceMeta {
        name: name, tier: tier, throughput_bps: throughput_bps,
        cost_usd: cost_usd, lead_days: lead_days,
        is_quantum: is_quantum, is_local: is_local, is_free: is_free,
        status: status, vendor: vendor
    }
}

fn rng_result_fail(reason: str) -> RngCollectResult {
    return RngCollectResult { ok: 0, n_bytes: 0, bytes_: [], sha256_hex: "", message: reason }
}

fn rng_result_ok(bytes_: [int], sha256_hex: str, message: str) -> RngCollectResult {
    return RngCollectResult { ok: 1, n_bytes: len(bytes_), bytes_: bytes_, sha256_hex: sha256_hex, message: message }
}

// ── ANU constants ───────────────────────────────────────────

let ANU_NAME       = "anu"
let ANU_TIER       = 1
let ANU_BPS        = 1000             // ~1 kbit/s sustained on free tier
let ANU_VENDOR     = "ANU_qrng_au"
let ANU_ENDPOINT   = "https://qrng.anu.edu.au/API/jsonI.php"
let ANU_CHUNK_MAX  = 1024             // server hard cap per request
let ANU_PAUSE_MS   = 60000            // inter-chunk pause to avoid rate-limit (ANU FAQ: ~1 req/min)
let ANU_TIMEOUT_S  = 10

// ── Meta export ─────────────────────────────────────────────

fn rng_source_meta_anu() -> RngSourceMeta {
    return rng_meta_make(
        ANU_NAME, ANU_TIER, ANU_BPS,
        0,    // cost_usd (free tier)
        0,    // lead_days (immediate signup)
        1,    // is_quantum (vacuum fluctuation)
        0,    // is_local (network call)
        1,    // is_free
        "IMPLEMENTED",
        ANU_VENDOR
    )
}

// ── Helper: parse ANU JSON manually (selftest only; live path uses stdlib) ─
//
// Expected shape: {"type":"uint8","length":N,"data":[v0,v1,...,vN-1],"success":true}
// Returns parsed bytes array; empty array on failure.

fn _anu_parse_json(body: str) -> [int] {
    // Quick success check
    if body.contains("\"success\":true") == false {
        return []
    }
    if body.contains("\"data\":[") == false {
        return []
    }
    // Extract data array between '"data":[' and ']'
    let after = body.split("\"data\":[")
    if len(after) < 2 { return [] }
    let arr_and_rest = after[1]
    let arr_parts = arr_and_rest.split("]")
    if len(arr_parts) < 1 { return [] }
    let arr_str = arr_parts[0]
    // Split on commas
    let toks = arr_str.split(",")
    let mut out = []
    let mut i = 0
    while i < len(toks) {
        let t = toks[i].trim()
        if len(t) > 0 {
            let v = to_int(t)
            if v >= 0 {
                if v <= 255 {
                    out = out.push(v)
                }
            }
        }
        i = i + 1
    }
    return out
}

// ── Helper: sha256 of byte array ────────────────────────────

fn _anu_sha256_of_bytes(bytes_: [int], seed: int) -> str {
    let n = len(bytes_)
    if n == 0 { return "" }
    let tmp = "/tmp/anima_rng_anu_" + str(seed) + "_" + str(n) + ".bin"
    let mut hex = ""
    let mut k = 0
    while k < n {
        let b = bytes_[k]
        let hi = b / 16
        let lo = b - hi * 16
        let hi_c = if hi < 10 { str(hi) } else { if hi == 10 { "a" } else { if hi == 11 { "b" } else { if hi == 12 { "c" } else { if hi == 13 { "d" } else { if hi == 14 { "e" } else { "f" } } } } } }
        let lo_c = if lo < 10 { str(lo) } else { if lo == 10 { "a" } else { if lo == 11 { "b" } else { if lo == 12 { "c" } else { if lo == 13 { "d" } else { if lo == 14 { "e" } else { "f" } } } } } }
        hex = hex + hi_c + lo_c
        k = k + 1
    }
    let cmd = "printf '%s' '" + hex + "' | xxd -r -p > " + tmp + " 2>&1; (shasum -a 256 " + tmp + " 2>/dev/null || sha256sum " + tmp + ") | awk '{print $1}'"
    let sha = exec(cmd).trim()
    let _rc = exec("rm -f " + tmp + "; echo OK")
    return sha
}

// ── Collect ─────────────────────────────────────────────────

fn rng_source_collect_anu(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("anu: n_bytes must be >= 1")
    }
    // Selftest mock path: ANIMA_QRNG_MOCK=1 → fixture
    let mock_env = exec("printenv ANIMA_QRNG_MOCK 2>/dev/null || true").trim()
    if mock_env == "1" {
        // Deterministic fixture: same as ESP32 LCG seeded by 'seed'
        let mut s = if seed > 0 { seed } else { 12345 }
        let mut bytes_ = []
        let mut i = 0
        while i < n_bytes {
            s = (1664525 * s + 1013904223) % 4294967296
            let b = (s % 256)
            bytes_ = bytes_.push(b)
            i = i + 1
        }
        let sha = _anu_sha256_of_bytes(bytes_, seed)
        return rng_result_ok(bytes_, sha, "anu: mock fixture (ANIMA_QRNG_MOCK=1)")
    }
    // Live path: hexa-lang stdlib qrng_anu_uint8_live (UPSTREAM)
    let mut accum = []
    let mut remaining = n_bytes
    let mut chunk_idx = 0
    while remaining > 0 {
        let want = if remaining < ANU_CHUNK_MAX { remaining } else { ANU_CHUNK_MAX }
        let chunk_bytes = qrng_anu_uint8_live(want)
        if len(chunk_bytes) != want {
            return rng_result_fail("anu: stdlib fetch fail want=" + str(want) + " got=" + str(len(chunk_bytes)) + " chunk=" + str(chunk_idx) + " (rate-limit or network)")
        }
        let mut i = 0
        while i < len(chunk_bytes) {
            accum = accum.push(chunk_bytes[i])
            i = i + 1
        }
        remaining = remaining - want
        chunk_idx = chunk_idx + 1
        if remaining > 0 {
            let pause_cmd = "sleep " + str(ANU_PAUSE_MS / 1000)
            let _rc = exec(pause_cmd + "; echo OK")
        }
    }
    let sha = _anu_sha256_of_bytes(accum, seed)
    return rng_result_ok(accum, sha, "anu: ok (live stdlib, " + str(chunk_idx) + " chunks)")
}

// ── Selftest ────────────────────────────────────────────────
//
// Default: ANIMA_QRNG_MOCK=1 path (deterministic fixture).
// Live: opt-in with ANIMA_QRNG_LIVE=1 (network call, free).

fn _selftest_anu() -> int {
    let m = rng_source_meta_anu()
    if m.name != "anu" { return 0 }
    if m.tier != 1 { return 0 }
    if m.is_quantum != 1 { return 0 }
    if m.is_local != 0 { return 0 }
    // Force mock path for selftest determinism
    let _set = exec("export ANIMA_QRNG_MOCK=1; echo set")
    // Mock collect with fixture
    let _rc = exec("export ANIMA_QRNG_MOCK=1")
    // We can't set env from inside hexa exec; instead inject mock manually
    // by checking the env var inside collect. For deterministic selftest,
    // call the parser on a known fixture body:
    let fixture = "{\"type\":\"uint8\",\"length\":4,\"data\":[100,200,50,25],\"success\":true}"
    let parsed = _anu_parse_json(fixture)
    if len(parsed) != 4 { return 0 }
    if parsed[0] != 100 { return 0 }
    if parsed[1] != 200 { return 0 }
    if parsed[2] != 50 { return 0 }
    if parsed[3] != 25 { return 0 }
    // Failure path: malformed JSON
    let bad = "{\"success\":false,\"data\":[]}"
    let parsed_bad = _anu_parse_json(bad)
    if len(parsed_bad) != 0 { return 0 }
    // sha256 round-trip on a 4-byte fixture
    let sha = _anu_sha256_of_bytes(parsed, 42)
    if len(sha) != 64 { return 0 }
    return 1
}

fn main() {
    println("[rng/anu] ANU public quantum RNG (Tier 1)")
    if _selftest_anu() == 1 {
        println("[rng/anu] SELFTEST PASS")
    } else {
        println("[rng/anu] SELFTEST FAIL")
    }
    // Optional live probe
    let live = exec("printenv ANIMA_QRNG_LIVE 2>/dev/null || true").trim()
    if live == "1" {
        println("[rng/anu] LIVE probe (ANIMA_QRNG_LIVE=1)")
        let r = rng_source_collect_anu(8, 1)
        if r.ok == 1 {
            println("[rng/anu] LIVE n=" + str(r.n_bytes) + " sha=" + r.sha256_hex)
        } else {
            println("[rng/anu] LIVE FAIL: " + r.message)
        }
    }
}
