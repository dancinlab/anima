// anima/core/rng/registry.hexa — RNG source registry (name → dispatch)
//
// raw#9 hexa-only strict. Stage0 has no first-class fn pointers / dyn-call,
// so the registry uses a switch-style dispatch over canonical source names.
// Each branch inlines the collect logic from the sibling module.
//
// REGISTERED SOURCES (9):
//   urandom         — POSIX kernel CSPRNG       (IMPLEMENTED, Tier 0)
//   esp32           — ESP32-S3 wrapper           (WRAPPED,    Tier 0)
//   anu             — ANU public quantum         (IMPLEMENTED, Tier 1)
//   curby           — NIST + CU Boulder Bell     (IMPLEMENTED, Tier 1)
//   nist_beacon     — NIST Beacon 2.0 mixed      (IMPLEMENTED, Tier 1, is_quantum=0)
//   drand           — League of Entropy quicknet (IMPLEMENTED, Tier 1, is_quantum=0)
//   ibm_q           — IBM Quantum cloud          (STUB,       Tier 2)
//   idq_quantis     — IDQ commercial             (STUB,       Tier 3)
//   kaist_optical   — KAIST research             (STUB,       Tier 4)
//
// raw#10:
//   (1) Inlined dispatch is verbose but matches hexa stage0 capabilities.
//       When trait/dyn-call lands, this collapses to a HashMap<&str, &dyn>.
//   (2) sha256/byte logic is duplicated across modules+registry; SSOT is
//       the per-module source file. Registry copies are kept byte-identical.

// ── struct mirror (SSOT: anima/core/rng/source.hexa) ────────

struct RngSourceMeta {
    name:           str,
    tier:           int,
    throughput_bps: int,
    cost_usd:       int,
    lead_days:      int,
    is_quantum:     int,
    is_local:       int,
    is_free:        int,
    status:         str,
    vendor:         str
}

struct RngCollectResult {
    ok:             int,
    n_bytes:        int,
    bytes_:         [int],
    sha256_hex:     str,
    message:        str
}

fn rng_meta_make(
    name: str, tier: int, throughput_bps: int, cost_usd: int,
    lead_days: int, is_quantum: int, is_local: int, is_free: int,
    status: str, vendor: str
) -> RngSourceMeta {
    return RngSourceMeta {
        name: name, tier: tier, throughput_bps: throughput_bps,
        cost_usd: cost_usd, lead_days: lead_days,
        is_quantum: is_quantum, is_local: is_local, is_free: is_free,
        status: status, vendor: vendor
    }
}

fn rng_result_fail(reason: str) -> RngCollectResult {
    return RngCollectResult { ok: 0, n_bytes: 0, bytes_: [], sha256_hex: "", message: reason }
}

fn rng_result_ok(bytes_: [int], sha256_hex: str, message: str) -> RngCollectResult {
    return RngCollectResult { ok: 1, n_bytes: len(bytes_), bytes_: bytes_, sha256_hex: sha256_hex, message: message }
}

// ── Helpers ────────────────────────────────────────────────

fn _byte_to_hex2(b: int) -> str {
    let hi = b / 16
    let lo = b - hi * 16
    let hi_c = if hi < 10 { str(hi) } else { if hi == 10 { "a" } else { if hi == 11 { "b" } else { if hi == 12 { "c" } else { if hi == 13 { "d" } else { if hi == 14 { "e" } else { "f" } } } } } }
    let lo_c = if lo < 10 { str(lo) } else { if lo == 10 { "a" } else { if lo == 11 { "b" } else { if lo == 12 { "c" } else { if lo == 13 { "d" } else { if lo == 14 { "e" } else { "f" } } } } } }
    return hi_c + lo_c
}

fn _bytes_sha256(bytes_: [int], tag: str) -> str {
    let n = len(bytes_)
    if n == 0 { return "" }
    let tmp = "/tmp/anima_rng_reg_" + tag + "_" + str(n) + ".bin"
    let mut hex = ""
    let mut k = 0
    while k < n {
        hex = hex + _byte_to_hex2(bytes_[k])
        k = k + 1
    }
    let cmd = "printf '%s' '" + hex + "' | xxd -r -p > " + tmp + " 2>&1; (shasum -a 256 " + tmp + " 2>/dev/null || sha256sum " + tmp + ") | awk '{print $1}'"
    let sha = exec(cmd).trim()
    let _rc = exec("rm -f " + tmp + "; echo OK")
    return sha
}

// ── Registered names (SSOT for list_available) ──────────────

fn rng_registry_names() -> [str] {
    let mut a = []
    a = a.push("urandom")
    a = a.push("esp32")
    a = a.push("anu")
    a = a.push("curby")
    a = a.push("nist_beacon")
    a = a.push("drand")
    a = a.push("ibm_q")
    a = a.push("idq_quantis")
    a = a.push("kaist_optical")
    return a
}

// ── Meta dispatch ──────────────────────────────────────────

fn rng_registry_meta(name: str) -> RngSourceMeta {
    if name == "urandom" {
        return rng_meta_make("urandom", 0, 1000000000, 0, 0, 0, 1, 1, "IMPLEMENTED", "POSIX_kernel_CSPRNG")
    }
    if name == "esp32" {
        return rng_meta_make("esp32", 0, 256000, 4, 0, 1, 1, 1, "WRAPPED", "ESP32-S3_USB-CDC")
    }
    if name == "anu" {
        return rng_meta_make("anu", 1, 1000, 0, 0, 1, 0, 1, "IMPLEMENTED", "ANU_qrng_au")
    }
    if name == "curby" {
        return rng_meta_make("curby", 1, 4, 0, 0, 1, 0, 1, "IMPLEMENTED", "nist+cu_boulder")
    }
    if name == "nist_beacon" {
        return rng_meta_make("nist_beacon", 1, 8, 0, 0, 0, 0, 1, "IMPLEMENTED", "nist")
    }
    if name == "drand" {
        // throughput: 256 bits / 3 s ≈ 85 bps sustained (quicknet cadence)
        // is_quantum=0: League of Entropy mixes 15 orgs (LavaRand contributes
        // photonic noise but collective is NOT pure-quantum; honest C3).
        return rng_meta_make("drand", 1, 85, 0, 0, 0, 0, 1, "IMPLEMENTED", "league_of_entropy")
    }
    if name == "ibm_q" {
        return rng_meta_make("ibm_q", 2, 100, 0, 10, 1, 0, 1, "STUB", "IBM_Quantum_Network_qiskit_runtime")
    }
    if name == "idq_quantis" {
        return rng_meta_make("idq_quantis", 3, 240000000, 5000, 42, 1, 1, 0, "STUB", "ID_Quantique_Quantis_PCIe_240M_default;legacy_USB_4M=4Mbps")
    }
    if name == "kaist_optical" {
        return rng_meta_make("kaist_optical", 4, 1000000000, 0, 60, 1, 1, 1, "STUB", "KAIST_chip_scale_optical_QRNG_research")
    }
    // Unknown source → tier=-1 sentinel
    return rng_meta_make(name, -1, 0, 0, 0, 0, 0, 0, "UNKNOWN", "")
}

// ── Collect dispatch ────────────────────────────────────────

fn rng_registry_collect(name: str, n_bytes: int, seed: int) -> RngCollectResult {
    if name == "urandom" {
        return _registry_collect_urandom(n_bytes, seed)
    }
    if name == "esp32" {
        return _registry_collect_esp32(n_bytes, seed)
    }
    if name == "anu" {
        return _registry_collect_anu(n_bytes, seed)
    }
    if name == "curby" {
        return _registry_collect_curby(n_bytes, seed)
    }
    if name == "nist_beacon" {
        return _registry_collect_nist_beacon(n_bytes, seed)
    }
    if name == "drand" {
        return _registry_collect_drand(n_bytes, seed)
    }
    if name == "ibm_q" {
        return rng_result_fail("ibm_q: STUB — qiskit-ibm-runtime SDK + IBM_QUANTUM_TOKEN required")
    }
    if name == "idq_quantis" {
        return rng_result_fail("idq_quantis: STUB — libQuantis SDK + PCIe/USB device required")
    }
    if name == "kaist_optical" {
        return rng_result_fail("kaist_optical: STUB — research collaboration + IRB + custom FPGA fw required")
    }
    return rng_result_fail("unknown source: " + name)
}

// ── urandom collect (mirror anima/modules/rng/urandom.hexa) ─

fn _registry_collect_urandom(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("urandom: n_bytes must be >= 1")
    }
    let tmp = "/tmp/anima_rng_urandom_" + str(seed) + "_" + str(n_bytes) + ".bin"
    let cmd_dd = "dd if=/dev/urandom of=" + tmp + " bs=1 count=" + str(n_bytes) + " status=none 2>&1; echo OK"
    let _rc = exec(cmd_dd)
    let cmd_od = "od -An -v -tu1 " + tmp + " | tr '\\n' ' '"
    let out = exec(cmd_od)
    let parts = out.split(" ")
    let mut bytes_ = []
    let mut i = 0
    while i < len(parts) {
        let p = parts[i]
        if len(p) > 0 {
            let b = to_int(p)
            if b >= 0 {
                if b <= 255 {
                    bytes_ = bytes_.push(b)
                }
            }
        }
        i = i + 1
    }
    let cmd_sha = "(shasum -a 256 " + tmp + " 2>/dev/null || sha256sum " + tmp + ") | awk '{print $1}'"
    let sha = exec(cmd_sha).trim()
    let _rc2 = exec("rm -f " + tmp + "; echo OK")
    if len(bytes_) != n_bytes {
        return rng_result_fail("urandom: byte count mismatch want=" + str(n_bytes) + " got=" + str(len(bytes_)))
    }
    return rng_result_ok(bytes_, sha, "urandom: ok")
}

// ── esp32 collect (mirror anima/modules/rng/esp32.hexa) ────

fn _registry_collect_esp32(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("esp32: n_bytes must be >= 1")
    }
    let mut s = if seed > 0 { seed } else { 2463534242 }
    let mut bytes_ = []
    let mut i = 0
    while i < n_bytes {
        s = (1664525 * s + 1013904223) % 4294967296
        let sample = (s * 1.0) / 4294967295.0
        let b = to_int(sample * 256.0)
        let b_clamp = if b > 255 { 255 } else { if b < 0 { 0 } else { b } }
        bytes_ = bytes_.push(b_clamp)
        i = i + 1
    }
    let sha = _bytes_sha256(bytes_, "esp32_" + str(seed))
    return rng_result_ok(bytes_, sha, "esp32: ok (mock LCG; hw_serial pending)")
}

// ── anu collect (mirror anima/modules/rng/anu.hexa) ────────

fn _anu_parse_json_reg(body: str) -> [int] {
    if body.contains("\"success\":true") == false { return [] }
    if body.contains("\"data\":[") == false { return [] }
    let after = body.split("\"data\":[")
    if len(after) < 2 { return [] }
    let arr_and_rest = after[1]
    let arr_parts = arr_and_rest.split("]")
    if len(arr_parts) < 1 { return [] }
    let arr_str = arr_parts[0]
    let toks = arr_str.split(",")
    let mut out = []
    let mut i = 0
    while i < len(toks) {
        let t = toks[i].trim()
        if len(t) > 0 {
            let v = to_int(t)
            if v >= 0 {
                if v <= 255 {
                    out = out.push(v)
                }
            }
        }
        i = i + 1
    }
    return out
}

fn _registry_collect_anu(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("anu: n_bytes must be >= 1")
    }
    let mock_env = exec("printenv ANIMA_QRNG_MOCK 2>/dev/null || true").trim()
    if mock_env == "1" {
        let mut s = if seed > 0 { seed } else { 12345 }
        let mut bytes_ = []
        let mut i = 0
        while i < n_bytes {
            s = (1664525 * s + 1013904223) % 4294967296
            let b = (s % 256)
            bytes_ = bytes_.push(b)
            i = i + 1
        }
        let sha = _bytes_sha256(bytes_, "anu_" + str(seed))
        return rng_result_ok(bytes_, sha, "anu: mock fixture (ANIMA_QRNG_MOCK=1)")
    }
    let mut accum = []
    let mut remaining = n_bytes
    let mut chunk_idx = 0
    while remaining > 0 {
        let want = if remaining < 1024 { remaining } else { 1024 }
        let url = "https://qrng.anu.edu.au/API/jsonI.php?length=" + str(want) + "&type=uint8"
        let cmd = "curl -sS --max-time 10 '" + url + "' 2>&1"
        let body = exec(cmd).trim()
        if len(body) < 1 {
            return rng_result_fail("anu: empty response (network/timeout) chunk=" + str(chunk_idx))
        }
        let chunk_bytes = _anu_parse_json_reg(body)
        if len(chunk_bytes) != want {
            return rng_result_fail("anu: parse mismatch want=" + str(want) + " got=" + str(len(chunk_bytes)) + " chunk=" + str(chunk_idx))
        }
        let mut i = 0
        while i < len(chunk_bytes) {
            accum = accum.push(chunk_bytes[i])
            i = i + 1
        }
        remaining = remaining - want
        chunk_idx = chunk_idx + 1
        if remaining > 0 {
            let _rc = exec("sleep 1; echo OK")
        }
    }
    let sha = _bytes_sha256(accum, "anu_" + str(seed))
    return rng_result_ok(accum, sha, "anu: ok (live, " + str(chunk_idx) + " chunks)")
}

// ── curby collect (mirror anima/modules/rng/curby.hexa) ────

fn _hex_char_val_reg(c: str) -> int {
    if c == "0" { return 0 } if c == "1" { return 1 } if c == "2" { return 2 } if c == "3" { return 3 }
    if c == "4" { return 4 } if c == "5" { return 5 } if c == "6" { return 6 } if c == "7" { return 7 }
    if c == "8" { return 8 } if c == "9" { return 9 }
    if c == "a" { return 10 } if c == "b" { return 11 } if c == "c" { return 12 } if c == "d" { return 13 }
    if c == "e" { return 14 } if c == "f" { return 15 }
    if c == "A" { return 10 } if c == "B" { return 11 } if c == "C" { return 12 } if c == "D" { return 13 }
    if c == "E" { return 14 } if c == "F" { return 15 }
    return -1
}

fn _hex_to_bytes_reg(hex_s: str, n_max: int) -> [int] {
    let mut out = []
    let mut i = 0
    let n = len(hex_s)
    while i + 1 < n {
        if len(out) >= n_max { return out }
        let hi = _hex_char_val_reg(hex_s.substr(i, 1))
        let lo = _hex_char_val_reg(hex_s.substr(i + 1, 1))
        if hi < 0 { return out }
        if lo < 0 { return out }
        out = out.push(hi * 16 + lo)
        i = i + 2
    }
    return out
}

fn _json_extract_reg(body: str, key: str) -> str {
    let needle_a = "\"" + key + "\":"
    let needle_b = "\"" + key + "\" :"
    let needle = if body.contains(needle_a) { needle_a } else { if body.contains(needle_b) { needle_b } else { "" } }
    if len(needle) == 0 { return "" }
    let after = body.split(needle)
    if len(after) < 2 { return "" }
    let rest = after[1].trim()
    if len(rest) == 0 { return "" }
    let first_ch = rest.substr(0, 1)
    if first_ch == "\"" {
        let q1 = rest.split("\"")
        if len(q1) >= 2 { return q1[1] }
        return ""
    }
    let toks = rest.split(",")
    if len(toks) < 1 { return "" }
    let head = toks[0].split("}")
    if len(head) < 1 { return "" }
    return head[0].trim()
}

fn _registry_collect_curby(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("curby: n_bytes must be >= 1")
    }
    if n_bytes > 32 {
        return rng_result_fail("curby: n_bytes > 32 requires multi-pulse aggregation (60s/pulse cadence); use seed-anchor pattern")
    }
    let mock_env = exec("printenv NEXUS_QRNG_MOCK 2>/dev/null || true").trim()
    let body = if mock_env == "1" {
        exec("cat anima/modules/rng/fixtures/curby_pulse_sample.json 2>/dev/null || echo ''")
    } else {
        let cid_env = exec("printenv NEXUS_CURBY_CHAIN_CID 2>/dev/null || true").trim()
        let cid = if len(cid_env) > 0 { cid_env } else { "bafyriqa5k2d3t3r774geicueaed2wc2fosjwqeexfhwbptfgq7rcn5mwucnhfeuxu2nxbrch3rl6yqjlozhuswo5ln3xwjm35iftt3tpqlcgs" }
        let url = "https://random.colorado.edu/api/chains/" + cid + "/pulses?limit=1"
        exec("curl -sS --max-time 10 '" + url + "' 2>/dev/null")
    }
    if len(body) < 16 {
        return rng_result_fail("curby: empty response (network/timeout)")
    }
    let hex_a = _json_extract_reg(body, "randomness")
    let hex_v = if len(hex_a) > 0 { hex_a } else { _json_extract_reg(body, "output_value_hex") }
    let cid_v = _json_extract_reg(body, "/")
    let tw_a  = _json_extract_reg(body, "twine_anchor")
    let twine_s = if len(tw_a) > 0 { tw_a } else { cid_v }
    if len(hex_v) < 64 {
        return rng_result_fail("curby: hex output too short, got=" + str(len(hex_v)))
    }
    if len(twine_s) == 0 {
        return rng_result_fail("curby: empty twine_anchor (F_CURBY_03)")
    }
    let bytes_all = _hex_to_bytes_reg(hex_v, 32)
    if len(bytes_all) < n_bytes {
        return rng_result_fail("curby: hex decode short, got=" + str(len(bytes_all)) + " want=" + str(n_bytes))
    }
    let mut bytes_ = []
    let mut i = 0
    while i < n_bytes {
        bytes_ = bytes_.push(bytes_all[i])
        i = i + 1
    }
    let sha = _bytes_sha256(bytes_, "curby_" + str(seed))
    return rng_result_ok(bytes_, sha, "curby: ok twine=" + twine_s.substr(0, 24))
}

// ── nist_beacon collect (mirror anima/modules/rng/nist_beacon.hexa) ─

fn _registry_collect_nist_beacon(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("nist_beacon: n_bytes must be >= 1")
    }
    if n_bytes > 64 {
        return rng_result_fail("nist_beacon: n_bytes > 64 requires multi-pulse aggregation (60s/pulse cadence)")
    }
    let mock_env = exec("printenv NEXUS_QRNG_MOCK 2>/dev/null || true").trim()
    let body = if mock_env == "1" {
        exec("cat anima/modules/rng/fixtures/nist_beacon_pulse_sample.json 2>/dev/null || echo ''")
    } else {
        exec("curl -sS --max-time 10 'https://beacon.nist.gov/beacon/2.0/pulse/last' 2>/dev/null")
    }
    if len(body) < 16 {
        return rng_result_fail("nist_beacon: empty response (network/timeout)")
    }
    let out_a = _json_extract_reg(body, "outputValue")
    let out_v = if len(out_a) > 0 { out_a } else { _json_extract_reg(body, "output_value") }
    let sig_a = _json_extract_reg(body, "signatureValue")
    let sig_v = if len(sig_a) > 0 { sig_a } else { _json_extract_reg(body, "signature") }
    if len(out_v) < 64 {
        return rng_result_fail("nist_beacon: output too short, got=" + str(len(out_v)))
    }
    if len(sig_v) == 0 {
        return rng_result_fail("nist_beacon: empty signature (F_NIST_03)")
    }
    let bytes_all = _hex_to_bytes_reg(out_v, 64)
    if len(bytes_all) < n_bytes {
        return rng_result_fail("nist_beacon: hex decode short, got=" + str(len(bytes_all)) + " want=" + str(n_bytes))
    }
    let mut bytes_ = []
    let mut i = 0
    while i < n_bytes {
        bytes_ = bytes_.push(bytes_all[i])
        i = i + 1
    }
    let sha = _bytes_sha256(bytes_, "nist_beacon_" + str(seed))
    return rng_result_ok(bytes_, sha, "nist_beacon: ok sig_len=" + str(len(sig_v)))
}

// ── drand collect (mirror anima/modules/rng/drand.hexa) ────

fn _registry_collect_drand(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("drand: n_bytes must be >= 1")
    }
    if n_bytes > 32 {
        return rng_result_fail("drand: n_bytes > 32 requires multi-pulse aggregation (3s/pulse cadence); use seed-anchor pattern")
    }
    let mock_env = exec("printenv NEXUS_QRNG_MOCK 2>/dev/null || true").trim()
    let body = if mock_env == "1" {
        exec("cat anima/modules/rng/fixtures/drand_pulse_sample.json 2>/dev/null || echo ''")
    } else {
        let chain_env = exec("printenv NEXUS_DRAND_CHAIN 2>/dev/null || true").trim()
        let chain = if len(chain_env) > 0 { chain_env } else { "52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971" }
        let url = "https://api.drand.sh/" + chain + "/public/latest"
        exec("curl -sS --max-time 10 '" + url + "' 2>/dev/null")
    }
    if len(body) < 16 {
        return rng_result_fail("drand: empty response (network/timeout)")
    }
    let rnd_s  = _json_extract_reg(body, "round")
    let rand_s = _json_extract_reg(body, "randomness")
    let sig_s  = _json_extract_reg(body, "signature")
    let r_int  = if len(rnd_s) > 0 { to_int(rnd_s) } else { 0 }
    if r_int <= 0 {
        return rng_result_fail("drand: round invalid (got " + rnd_s + ")")
    }
    if len(rand_s) < 64 {
        return rng_result_fail("drand: randomness hex too short, got=" + str(len(rand_s)))
    }
    if len(sig_s) == 0 {
        return rng_result_fail("drand: empty signature (F_DRAND_03)")
    }
    let bytes_all = _hex_to_bytes_reg(rand_s, 32)
    if len(bytes_all) < n_bytes {
        return rng_result_fail("drand: hex decode short, got=" + str(len(bytes_all)) + " want=" + str(n_bytes))
    }
    let mut bytes_ = []
    let mut i = 0
    while i < n_bytes {
        bytes_ = bytes_.push(bytes_all[i])
        i = i + 1
    }
    let sha = _bytes_sha256(bytes_, "drand_" + str(seed))
    return rng_result_ok(bytes_, sha, "drand: ok round=" + str(r_int) + " sig_len=" + str(len(sig_s)))
}

// ── Selftest ───────────────────────────────────────────────

fn _selftest_registry() -> int {
    // 1. names list = 9 (urandom, esp32, anu, curby, nist_beacon, drand, ibm_q, idq_quantis, kaist_optical)
    let names = rng_registry_names()
    if len(names) != 9 { return 0 }
    // 2. each name has well-formed meta
    let mut i = 0
    while i < len(names) {
        let m = rng_registry_meta(names[i])
        if m.name != names[i] { return 0 }
        if m.tier < 0 { return 0 }
        if len(m.status) < 1 { return 0 }
        i = i + 1
    }
    // 3. unknown name → UNKNOWN sentinel
    let m_x = rng_registry_meta("nonexistent_source")
    if m_x.tier != -1 { return 0 }
    if m_x.status != "UNKNOWN" { return 0 }
    // 4. collect — urandom live (always works on POSIX)
    let r_u = rng_registry_collect("urandom", 8, 11)
    if r_u.ok != 1 { return 0 }
    if r_u.n_bytes != 8 { return 0 }
    // 5. collect — esp32 deterministic
    let r_e1 = rng_registry_collect("esp32", 8, 42)
    let r_e2 = rng_registry_collect("esp32", 8, 42)
    if r_e1.ok != 1 { return 0 }
    if r_e2.ok != 1 { return 0 }
    let mut k = 0
    while k < 8 {
        if r_e1.bytes_[k] != r_e2.bytes_[k] { return 0 }
        k = k + 1
    }
    // 6. collect — stubs return ok=0
    let r_ibm = rng_registry_collect("ibm_q", 8, 0)
    if r_ibm.ok != 0 { return 0 }
    let r_idq = rng_registry_collect("idq_quantis", 8, 0)
    if r_idq.ok != 0 { return 0 }
    let r_kai = rng_registry_collect("kaist_optical", 8, 0)
    if r_kai.ok != 0 { return 0 }
    // 7. unknown source → ok=0
    let r_x = rng_registry_collect("nonexistent_source", 8, 0)
    if r_x.ok != 0 { return 0 }
    // 8. curby/nist_beacon meta well-formed (Tier 1)
    let m_curby = rng_registry_meta("curby")
    if m_curby.tier != 1 { return 0 }
    if m_curby.is_quantum != 1 { return 0 }
    if m_curby.status != "IMPLEMENTED" { return 0 }
    let m_nb = rng_registry_meta("nist_beacon")
    if m_nb.tier != 1 { return 0 }
    if m_nb.is_quantum != 0 { return 0 }
    if m_nb.status != "IMPLEMENTED" { return 0 }
    // 9. drand meta well-formed (Tier 1, mixed entropy, 85 bps, free, EU sovereign)
    let m_dr = rng_registry_meta("drand")
    if m_dr.tier != 1 { return 0 }
    if m_dr.is_quantum != 0 { return 0 }
    if m_dr.is_local != 0 { return 0 }
    if m_dr.is_free != 1 { return 0 }
    if m_dr.throughput_bps != 85 { return 0 }
    if m_dr.vendor != "league_of_entropy" { return 0 }
    if m_dr.status != "IMPLEMENTED" { return 0 }
    return 1
}

// ── Dispatch sentinel (mock-mode round-trip) ───────────────
//
// __ANIMA_RNG_DISPATCH__ <PASS|FAIL> <ok_count>/<total>
// Iterates registered names, runs collect under NEXUS_QRNG_MOCK=1 fallback for
// network sources; reports per-name ok flag without affecting selftest result.

fn _dispatch_sentinel() -> int {
    let names = rng_registry_names()
    let mut ok_count = 0
    let total = len(names)
    let mut i = 0
    while i < total {
        let name = names[i]
        // urandom + esp32 always work; anu/curby/nist_beacon need mock; stubs fail by design.
        let r = rng_registry_collect(name, 4, 7)
        if r.ok == 1 {
            ok_count = ok_count + 1
            println("[rng/registry] dispatch[" + name + "] ok=1 n=" + str(r.n_bytes))
        } else {
            println("[rng/registry] dispatch[" + name + "] ok=0 reason=" + r.message)
        }
        i = i + 1
    }
    let verdict = if ok_count >= 2 { "PASS" } else { "FAIL" }
    println("[rng/registry] __ANIMA_RNG_DISPATCH__ " + verdict + " " + str(ok_count) + "/" + str(total))
    return ok_count
}

fn main() {
    println("[rng/registry] 9-source dispatch table")
    if _selftest_registry() == 1 {
        println("[rng/registry] SELFTEST PASS")
    } else {
        println("[rng/registry] SELFTEST FAIL")
    }
    let _n = _dispatch_sentinel()
}
