// core/DECODER/moe_collapse_gate_smoke.hexa — M4b collapse gate invariant
// anchor: D1 LZ76 측정값 (#1257) — healthy 0.849 vs collapse 0.212, floor 0.50.

import "core/DECODER/moe_collapse_gate.hexa"

fn assert_eq_f(name: string, got: float, want: float) -> bool {
    let d = if got - want < 0.0 { want - got } else { got - want }
    let ok = d <= 1e-9
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn assert_str(name: string, got: string, want: string) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + got + " want=" + want)
    return ok
}

fn main() {
    print("=== moe_collapse_gate smoke (M4b · D1 LZ76 floor 0.50) ===")
    let mut npass = 0
    let mut ntotal = 0

    let floor = moe_collapse_floor()

    // I1: D1 healthy seq (LZ_norm 0.849) → healthy 1.0
    ntotal = ntotal + 1
    if assert_eq_f("I1 healthy_0.849", moe_collapse_healthy(0.849, floor), 1.0) {
        npass = npass + 1
    }
    // I2: D1 collapse seq (LZ_norm 0.212) → collapsed 0.0
    ntotal = ntotal + 1
    if assert_eq_f("I2 collapse_0.212", moe_collapse_healthy(0.212, floor), 0.0) {
        npass = npass + 1
    }
    // I3: floor 경계 = D1 healthy floor 0.50
    ntotal = ntotal + 1
    if assert_eq_f("I3 floor_0.50", floor, 0.50) {
        npass = npass + 1
    }
    // I4: production router = HARD top-1 (soft 아님 — toy 검증 정합)
    ntotal = ntotal + 1
    if assert_str("I4 router_hard_top1", moe_prod_router_kind(), "hard-top1") {
        npass = npass + 1
    }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
