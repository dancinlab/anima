// shared_seed.hexa — H_6008 deployment: "저장=고전(LOCAL) · 공유=양자키".
//
// H_6008 (🟢, .verdicts/codex_extension_tiers/H_6008_anu_shared_seed.txt) proved
// that two anima instances which SHARE ONE ANU quantum buffer at fork/mitosis
// coordinate PERFECTLY (coordination 1.0) with ZERO live communication — a common
// cause (shared randomness), NOT a signalling channel (no-communication theorem;
// >0.75 CHSH needs entanglement, h6007, not this). H_6026/H_6027/H_6028 then
// closed the storage question: a quantum source is NOT a memory store (no write
// channel · non-replayable · leaks); the durable STORE must be classical/LOCAL.
//
// This module codifies BOTH findings as the fork-time primitive:
//   · the quantum KEY (real ANU vacuum bytes) is held in a LOCAL classical buffer
//     (the file/array IS the classical store — replayable precisely because it is
//     a local cache, not a live ANU pull; cf H_6026 MS2),
//   · a FORK shares that one buffer + cursor, so two children draw IDENTICAL
//     values and coordinate with no I/O (H_6008 ARM1); independent buffers do not
//     (ARM2 ≈ chance).
//
// p1..p8 clean: no system prompt, no persona, no speak() — this is substrate
// randomness sharing only. The draw is deterministic given (buffer, cursor); the
// ONLY thing that makes two instances agree is that they SHARE the same key.
//
// THE ONE-LINE DEPLOYMENT: at a sibling spawn, call shared_seed_fork(parent)
// instead of shared_seed_load(<a different file>). That single substitution turns
// independent siblings (ARM2) into coordinated siblings (ARM1).

// ── SharedSeed: a LOCAL classical buffer of the ANU quantum key + a cursor ──────
struct SharedSeed {
    bytes: [int],     // the quantum key, stored LOCALLY (classical store; replayable)
    cursor: int,      // next byte to consume; fork copies this so children stay in lockstep
}

// Load the ANU quantum key from a LOCAL file into a classical buffer.
// `od -An -tu1 -v` prints every byte as a space-separated unsigned decimal — the
// file is the classical store; this read is exact + repeatable (H_6026 MS2: the
// store is local, not the live quantum source).
fn shared_seed_load(path: string) -> SharedSeed {
    let raw = exec("od -An -tu1 -v " + path + " 2>/dev/null").trim()
    let toks = raw.split(" ")
    let mut bytes = []
    let mut i = 0
    while i < len(toks) {
        let t = toks[i].trim()
        if len(t) > 0 {
            bytes = bytes + [to_int(t)]
        }
        i = i + 1
    }
    return SharedSeed { bytes: bytes, cursor: 0 }
}

// FORK — the H_6008 primitive. The child inherits the SAME key bytes AND the SAME
// cursor, so from this point parent and child make IDENTICAL draws (coordination
// 1.0, zero comms). This is the whole deployment: share the buffer, not a channel.
fn shared_seed_fork(parent: SharedSeed) -> SharedSeed {
    return SharedSeed { bytes: parent.bytes, cursor: parent.cursor }
}

// Number of key bytes still available to draw.
fn shared_seed_remaining(s: SharedSeed) -> int {
    return len(s.bytes) - s.cursor
}

// Draw an integer in [0, k) from the shared key and advance the cursor by 1.
// Deterministic in (bytes, cursor): two instances on the SAME shared key + cursor
// return the SAME value — that, and only that, is what makes them coordinate.
// Returns flat [value, new_cursor] (hexa has no in-place mutation of a struct arg).
fn shared_seed_draw(s: SharedSeed, k: int) -> [int] {
    if k <= 0 { return [0, s.cursor] }
    if s.cursor >= len(s.bytes) { return [0, s.cursor] }   // key exhausted ⇒ 0 (caller refills)
    let b = s.bytes[s.cursor]
    let v = b - (b / k) * k                                  // b mod k, integer-only
    return [v, s.cursor + 1]
}

// Convenience: pick one option-index in [0, n_options) from the shared key.
// Returns flat [chosen_index, new_cursor].
fn shared_seed_choose(s: SharedSeed, n_options: int) -> [int] {
    return shared_seed_draw(s, n_options)
}
