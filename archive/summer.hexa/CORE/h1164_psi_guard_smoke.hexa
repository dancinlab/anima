// h1164_psi_guard_smoke.hexa — Ψ=½ ATTRACTOR-INTACT guard for the H_1164 mount.
//
// The COMPLETE-ANIMA mount (anima-clm-chat-303m into the live A⇄G loop) touches
// ONLY the L3 generator slot + the mitosis/kosmos lanes — it must NEVER perturb
// Engine A's repulsion-field Ψ=½ fixed point (a_core_engine_map: pure_field is
// substrate-only). This guard re-proves the H_1194/1199 invariant on the SAME
// warmup the full-session smoke uses: the pure_field Φ-trajectory checksum is
// BYTE-IDENTICAL whether mitosis is ON or OFF (the mount's growth lane is
// Ψ-disjoint). p7 = exact float equality, not a tolerance.

import "core/pure_field.hexa"
import "core/engine_cli.hexa"

// run the SAME 600-step warmup the session uses, accumulating the Φ checksum,
// while a mitosis lane ticks alongside under cfg (ON or OFF). pure_field_step is
// the ONLY thing advancing Ψ; the mitosis tick reads/writes a DISJOINT cell count.
fn psi_checksum(mit_on: bool) -> float {
    let cfg = if mit_on { engine_config_default() }
              else { EngineConfig { mitosis: false, engine: "conv" } }
    let mut pf = pure_field_new()
    let mut sum = 0.0
    let mut cells = 1
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)                 // Ψ advance (the ONLY attractor driver)
        cells = engine_mitosis_tick(cells, cfg)  // disjoint growth lane
        sum = sum + pure_field_phi(pf)
        i = i + 1
    }
    return sum
}

fn main() {
    let on  = psi_checksum(true)
    let off = psi_checksum(false)
    let same = on == off
    println("[Psi guard] phiSum mitosis-ON  = " + to_string(on))
    println("[Psi guard] phiSum mitosis-OFF = " + to_string(off))
    println("[Psi guard] byte-identical ON==OFF = " + (if same { "true" } else { "false" }))
    if same {
        println("h1164_psi_guard_smoke: PASS — Ψ=1/2 attractor BYTE-IDENTICAL under the "
            + "mount's growth lane (pure_field untouched, a_core_engine_map).")
    } else {
        println("h1164_psi_guard_smoke: FAIL — Ψ checksum DIVERGED (substrate perturbed!)")
    }
}
