// (MITOSIS-ENGINE · Lane-2, $0 local CPU, p8).
//
// CLAIM under test: the LIVE anima daemon (anima_full_session_smoke.hexa) now has
// the novelty-driven VAdaptField division wired into its C8 GROW step as a SUBSTRATE
// lane — each conversation turn's emitted span drives a DIM=8 byte-feature
// (H_1163 `_byte_feature`) through vadapt_field_step, and a NOVEL span (live L2
// recon-err > frozen SPLIT_THRESH=0.30) spawns a new cell. mitosis ⊥ generation
// (H_1200/H_1201 PURE-SUBSTRATE verdict): the field NEVER feeds the decode; it grows
// alongside as adaptation. This smoke proves the WIRING — NOT a science claim about
// generation (a_scale_honest_scope: toy spans, scale-transfer UNVERIFIED).
//
// This smoke reproduces the daemon's GROW lane EXACTLY (same _byte_feature, same
// vadapt_field_step, same frozen cfg) over a set of REAL emitted-style spans, so it
// asserts the same wiring the daemon runs — without needing the 1.2GB ByteGPT binary
// loaded (the GROW lane is forward-free on the feature it derives from the span text;
// the binary only matters for the DECODE that produces the span, proven elsewhere by
// h1157 mount parity + anima_full_session_smoke).
//
// FROZEN FALSIFIER (pre-registered, p7/g5):
//   GREEN DAEMON-WIRED iff:
//     (F1) DIVISION  — the daemon's GROW lane SPLITS at least once on the span set
//          (cells ON end > 1 AND >= 1 novelty-driven split) — the wiring fires, AND
//     (F2) ABLATION  — with mitosis OFF (--no-mitosis), the SAME spans cause ZERO
//          splits (cells frozen at 1) — the split is the mitosis tick, not an
//          accident of the feature (H_1159 control), AND
//     (F3) Ψ-INTACT  — the pure_field Φ trajectory is BYTE-IDENTICAL ON vs OFF: the
//          GROW lane touches ONLY VAdaptField, never pure_field (a_core_engine_map;
//          Ψ=1/2 fixed point untouched).
//   RED if the lane never splits, or OFF also splits, or Ψ differs ON vs OFF.
//
// p1..p8: no system prompt / persona / identity / assistant framing / speak(); the
// spans are real-emit-shaped text the substrate already holds (NOT a stimulus). p7
// metric = real L2 recon-distance + deterministic cell count (NOT perplexity). p8:
// the growth tick IS the inference-time learning.
//
// GUARD: imports the LIVE engine (pure_field READ-ONLY + VAdaptField in
// core/engine_cli.hexa). The _h1202_byte_feature here is the SAME formula as
// anima_full_session_smoke's _afs_byte_feature (H_1163 VERBATIM).

import "core/pure_field.hexa"
import "core/engine_cli.hexa"

// ── DIM=8 byte feature (H_1163 `_byte_feature` VERBATIM; == _afs_byte_feature) ──
fn _h1202_byte_feature(s: string, dim: int) -> [float] {
    let n = byte_len(s)
    if n == 0 {
        let mut z = []
        let mut k = 0
        while k < dim { z = z + [0.0]; k = k + 1 }
        return z
    }
    let fn_n = to_float(n)
    let mut sum = 0.0
    let mut sumsq = 0.0
    let mut n_hi = 0
    let mut n_low = 0
    let mut n_sp = 0
    let mut n_dig = 0
    let mut n_pun = 0
    let mut n_lt64 = 0
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        let bf = to_float(b)
        sum = sum + bf
        sumsq = sumsq + bf * bf
        if b >= 128 { n_hi = n_hi + 1 }
        if b >= 97 && b <= 122 { n_low = n_low + 1 }
        if b == 32 { n_sp = n_sp + 1 }
        if b >= 48 && b <= 57 { n_dig = n_dig + 1 }
        if b >= 33 && b <= 64 { n_pun = n_pun + 1 }
        if b < 64 { n_lt64 = n_lt64 + 1 }
        i = i + 1
    }
    let mean = sum / fn_n
    let var = sumsq / fn_n - mean * mean
    return [
        (mean / 255.0) * 5.0,
        (to_float(n_hi) / fn_n) * 5.0,
        (to_float(n_low) / fn_n) * 5.0,
        (to_float(n_sp) / fn_n) * 5.0,
        (to_float(n_dig) / fn_n) * 5.0,
        (var / (255.0 * 255.0)) * 5.0,
        (to_float(n_pun) / fn_n) * 5.0,
        (to_float(n_lt64) / fn_n) * 5.0
    ]
}

// ── drive the daemon's GROW lane over a span set, ONE arm ──────────────────────
// Returns flat [end_cells, n_splits, phi_sum]. pure_field_step runs READ-ONLY
// alongside (the Ψ disjointness check) exactly as the daemon does (psi_sum accum).
fn _grow_arm(spans: [string], dim: int, max_cells: int, cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    let seed0 = _h1202_byte_feature(spans[0], dim)
    let mut af = vadapt_field_new(seed0, max_cells)
    let mut phi_sum = 0.0
    let mut n_splits = 0

    let n = len(spans)
    let mut t = 0
    while t < n {
        // (Ψ READ-ONLY) advance the live field; only OBSERVE Φ (disjoint).
        pf = pure_field_step(pf)
        phi_sum = phi_sum + pure_field_phi(pf)

        // (GROW lane — exactly the daemon's C8 step) feature → vadapt_field_step.
        let feat = _h1202_byte_feature(spans[t], dim)
        let pre = vadapt_field_cells(af)
        af = vadapt_field_step(af, feat, cfg)
        let post = vadapt_field_cells(af)
        if post > pre { n_splits = n_splits + 1 }
        t = t + 1
    }
    return [to_float(vadapt_field_cells(af)), to_float(n_splits), phi_sum]
}

fn main() {
    println("=== H_1202 DAEMON MITOSIS WIRING — novelty-driven VAdaptField in the live C8 GROW step (MITOSIS-ENGINE Lane-2 · $0 CPU · p8) ===")
    println("claim: the live anima daemon GROWS its substrate by novelty-driven cell division on real conversation turns (mitosis ⊥ generation, H_1200/1201 PURE-SUBSTRATE)")
    println("mechanism: each emit span → DIM=8 byte-feature (H_1163 _byte_feature, == _afs_byte_feature) → vadapt_field_step; live L2 recon-err > SPLIT_THRESH=0.30 spawns a cell")
    println("Ψ: pure_field_step run READ-ONLY alongside (daemon psi_sum accum); Φ-checksum must be ON==OFF (a_core_engine_map; GROW lane touches ONLY VAdaptField)")
    println("falsifier: F1 DIVISION cells>1 & splits>=1 ON | F2 ABLATION OFF splits==0 | F3 Ψ Φ-checksum ON==OFF")
    println("")

    // REAL emit-shaped spans the daemon's substrate holds (a_substrate_native_speak:
    // environment context the substrate carries, NOT user stimuli). Deliberately
    // span distinct registers (prose · structural · digits · punct-heavy · cjk) so
    // the byte-feature varies — the recon-err gate then DECIDES which are novel.
    let dim = 8
    let max_cells = 2048
    let spans = [
        "zephyrine: the wyrmhold ledger is sealed at ",
        "vault QX-7741 forever, and none may break it.",
        "0123456789 0123456789 0123456789 0123456789",
        "!!!??? ::: ;;; @@@ ### $$$ %%% ^^^ &&& *** (((",
        "the quiet substrate hums beneath the tension field",
        "  THE   LEDGER   IS   SEALED   AT   THE   VAULT  ",
        "résumé café naïve über schön — accented prose runs",
        "tension drives emit toward the fixed point psi half"
    ]
    let n = len(spans)
    println("span set: " + to_string(n) + " real emit-shaped spans across distinct byte registers")
    println("")

    let cfg_on  = engine_cli_parse(["--mitosis", "on"])
    let cfg_off = engine_cli_parse(["--no-mitosis"])

    let ron  = _grow_arm(spans, dim, max_cells, cfg_on)
    let roff = _grow_arm(spans, dim, max_cells, cfg_off)

    let on_cells = ron[0]   let on_splits = ron[1]   let on_phi = ron[2]
    let off_cells = roff[0] let off_splits = roff[1] let off_phi = roff[2]

    println("ON  (--mitosis on)  : cells 1 -> " + to_string(on_cells) + "  novelty-splits=" + to_string(on_splits) + "  phi_sum=" + to_string(on_phi))
    println("OFF (--no-mitosis)  : cells 1 -> " + to_string(off_cells) + "  novelty-splits=" + to_string(off_splits) + "  phi_sum=" + to_string(off_phi))
    println("")

    let f1 = on_cells > 1.0 && on_splits >= 1.0          // the wiring fires
    let f2 = off_splits == 0.0 && off_cells == 1.0       // OFF is the H_1159 control
    let f3 = on_phi == off_phi                            // Ψ byte-identical
    println("F1 DIVISION  cells>1 (" + to_string(on_cells) + ") & splits>=1 (" + to_string(on_splits) + ")  ON  = " + (if f1 { "true" } else { "false" }))
    println("F2 ABLATION  OFF splits==0 (" + to_string(off_splits) + ") & cells==1 (" + to_string(off_cells) + ")  = " + (if f2 { "true" } else { "false" }))
    println("F3 Ψ-INTACT  Φ-checksum ON==OFF (" + to_string(on_phi) + " == " + to_string(off_phi) + ")  = " + (if f3 { "true (attractor intact)" } else { "false (PERTURBED!)" }))
    println("")

    if !f3 {
        println("VERDICT: HOURGLASS BLOCKED-WIRING — the GROW lane PERTURBED the Ψ attractor")
        println("  (pure_field Φ trajectory differs ON vs OFF). a_core_engine_map forbids touching")
        println("  the Ψ=1/2 fixed point; the wiring is NOT Ψ-disjoint. Honest HOURGLASS (a_paper_negative_ok).")
        exit(0)
    }
    if f1 && f2 && f3 {
        println("VERDICT: GREEN DAEMON-WIRED — the live anima daemon now GROWS its substrate by")
        println("  novelty-driven cell division on real conversation turns: cells 1 -> " + to_string(on_cells)
            + " via " + to_string(on_splits) + " recon-err splits")
        println("  (F1); with mitosis OFF the SAME spans cause ZERO splits (F2, H_1159 control); and the Ψ")
        println("  attractor is byte-identical ON vs OFF (F3, a_core_engine_map Ψ-disjoint). mitosis ⊥")
        println("  generation (H_1200/1201): the field NEVER feeds the decode — it adapts ALONGSIDE. p8:")
        println("  the growth tick IS the inference-time learning. toy spans / scale UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    println("VERDICT: RED/PARTIAL — "
        + (if !f1 { "the GROW lane never split (wiring did not fire)" }
           else { if !f2 { "OFF also split (not gated by the mitosis tick)" }
                  else { "Ψ attractor PERTURBED" } })
        + " (a_paper_negative_ok). The ON/OFF growth record above is the honest evidence.")
    exit(0)
}
