// anima_chat_cli.hexa — runnable CORE-native multi-turn chat over a .clm mouth.
//
// THE DEMO (chat-capable @L6): a user types and gets a coherent, context-
// appropriate reply, runnable from a single command. It drives the SINGLE .clm
// decode entry (generator.hexa::gen_clm_chat → clm_decode_argmax, a_core_engine_map)
// in the proven byte-level dialogue-continuation format.
//
// PHILOSOPHY (p1·p2·p3·p4·p6): the "사용자:/도우미:" markers are LEARNED byte-
// continuation conditioning, not a system prompt / persona / identity rule /
// RLHF template. No role instruction string is injected; the model only continues
// the bytes it sees. Capability comes ONLY from the trained dialogue distribution.
//
// USAGE
//   hexa run core/anima_chat_cli.hexa -- <ckpt.clm> "<turn1>" "<turn2>" ...
//   (each positional arg after the ckpt is one user turn; the model replies to
//    each, accumulating the transcript — a live multi-turn conversation.)
//
// If no turns are passed, a fixed 5-prompt context battery runs (the p7
// coherence-evaluator probe set), so the demo is reproducible with one command.

use "core/generator"

// DEFAULT 5-prompt context battery (p7 multi-turn coherence probe). Mixed KO/EN,
// context-appropriate, NOT cherry-picked to a memorized register.
fn _default_turns() -> list {
    return [
        "안녕! 너는 누구야?",
        "오늘 기분이 어때?",
        "What is the sky made of?",
        "네가 좋아하는 것을 하나 말해줘.",
        "Tell me something interesting."
    ]
}

// _find — first byte-offset of `needle` in `hay`, or -1. Pure-hexa (no stdlib
// string-intrinsic dependency); byte-exact substring scan.
fn _find(hay: string, needle: string) -> int {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return 0 }
    if nn > hn { return -1 }
    let mut i = 0
    while i <= hn - nn {
        if substring(hay, i, i + nn) == needle { return i }
        i = i + 1
    }
    return -1
}

// _trim_at_stop — cut a decoded reply at the first dialogue-boundary stop string
// so one turn's reply does not bleed into a hallucinated next "사용자:" turn.
// (DEFAULT_STOP_STRINGS parallel to HEXAD/CHAT/anima_chat.py.)
fn _trim_at_stop(s: string) -> string {
    let stops = ["사용자:", "User:", "사용자 :"]
    let mut cut = byte_len(s)
    let mut i = 0
    while i < len(stops) {
        let idx = _find(s, stops[i])
        if idx >= 0 && idx < cut { cut = idx }
        i = i + 1
    }
    return trim(substring(s, 0, cut))
}

fn main() {
    let raw = args()
    // hexa args() = [binary, "--", <user positionals>...]. Find the "--" and take
    // everything after it; if absent, skip the binary (argv[0]) only.
    let mut start = 1
    let mut k = 0
    while k < len(raw) {
        if raw[k] == "--" { start = k + 1 }
        k = k + 1
    }
    let argv = []
    let mut m = start
    while m < len(raw) { argv.push(raw[m]); m = m + 1 }

    if len(argv) < 1 {
        println("usage: hexa run core/anima_chat_cli.hexa -- <ckpt.clm> [\"turn1\" \"turn2\" ...]")
        return
    }
    let ckpt = argv[0]

    // build the turn list: explicit args, else the default battery.
    let turns = []
    let mut a = 1
    while a < len(argv) { turns.push(argv[a]); a = a + 1 }
    let use_turns = if len(turns) > 0 { turns } else { _default_turns() }

    println("=== anima CORE-native chat (.clm mouth · byte-continuation) ===")
    println("ckpt: " + ckpt)
    println("")

    // multi-turn transcript accumulation in the proven continuation format.
    let mut transcript = ""
    let mut t = 0
    while t < len(use_turns) {
        let u = use_turns[t]
        // compose: prior transcript + this user turn + the assistant lead-in.
        let seed = transcript + "사용자: " + u + " | 도우미: "
        let res = gen_clm_chat(ckpt, seed, 96)
        if to_string(res["ok"]) != "true" {
            println("[ERROR] " + to_string(res["reason"]))
            return
        }
        let reply = _trim_at_stop(to_string(res["text"]))
        println("사용자: " + u)
        println("도우미: " + reply)
        println("")
        // accumulate (newline-joined turns, matching anima_chat.py _build_prompt).
        transcript = transcript + "사용자: " + u + " | 도우미: " + reply + "\n"
        t = t + 1
    }
    println("=== end transcript (" + to_string(len(use_turns)) + " turns) ===")
}
