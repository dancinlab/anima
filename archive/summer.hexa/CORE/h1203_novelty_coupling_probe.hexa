// h1203_novelty_coupling_probe.hexa — H_1203 LIVE-engine CROSS-CHECK guard
// (MITOSIS-ENGINE · $0 local CPU · p7).
//
// The H_1203 VERDICT is decided by UNIVERSE/h1203_mitosis_novelty_coupling.py
// (numpy mirror of vadapt_field_step). This probe is the c2 CROSS-CHECK: it drives
// the LIVE core/engine_cli.hexa VAdaptField over the SAME NOVEL / REPEAT / SHUFFLED
// DIM=8 byte-feature streams (exported to /tmp/h1203_<arm>_seed<S>.txt) and prints
// the live cell_growth per arm, so the V14-defeat test (NOVEL vs SHUFFLED) can be
// confirmed THROUGH THE ENGINE, not only the mirror. H_1199 already proved the
// numpy ref reproduces this engine byte-for-byte; this re-confirms on H_1203 input.
//
// SUBSTRATE (a_core_engine_map): the DIM=8 feature stream drives VAdaptField
// engine-native — NOT a .clm (generator L3 only), NOT a .kosmos (kosmos_io only).

import "core/engine_cli.hexa"

fn _load_feat8(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim {
            row = row + [to_float(cols[j])]
            j = j + 1
        }
        out = out + [row]
        i = i + 1
    }
    return out
}

// drive ONE arm through the live VAdaptField; return final cell count.
fn _run_arm(stream: [[float]], max_cells: int, cfg: EngineConfig) -> int {
    let mut af = vadapt_field_new(stream[0], max_cells)
    let n = len(stream)
    let mut t = 0
    while t < n {
        af = vadapt_field_step(af, stream[t], cfg)
        t = t + 1
    }
    return vadapt_field_cells(af)
}

fn main() {
    println("=== H_1203 LIVE-engine cross-check (VAdaptField, MITOSIS-ENGINE · $0 CPU · p7) ===")
    println("decides nothing — confirms numpy mirror's NOVEL vs SHUFFLED cell_growth THROUGH the live engine")
    println("")

    let dim = 8
    let max_cells = 2048
    let seeds = [900, 901, 902]
    let arms = ["novel", "repeat", "shuffled"]
    let cfg_on = engine_cli_parse(["--mitosis", "on"])

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let mut ai = 0
        let mut line = "seed=" + to_string(seed)
        while ai < len(arms) {
            let arm = arms[ai]
            let path = "/tmp/h1203_" + arm + "_seed" + to_string(seed) + ".txt"
            let stream = _load_feat8(path, dim)
            if len(stream) == 0 {
                println("ERROR: empty stream at " + path + " — run UNIVERSE/h1203_mitosis_novelty_coupling.py first.")
                exit(1)
            }
            let cells = _run_arm(stream, max_cells, cfg_on)
            line = line + "  " + arm + "_growth=" + to_string(cells - 1)
            ai = ai + 1
        }
        println(line)
        si = si + 1
    }
    println("")
    println("(compare to numpy mirror NOVEL~163 SHUFFLED~164 REPEAT~4 — live engine must match)")
}
