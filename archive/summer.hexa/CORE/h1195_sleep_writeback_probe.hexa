// h1195_sleep_writeback_probe.hexa — LIVE-ENGINE probe (CORE engine UNTOUCHED;
// DREAM/imagination_replay.hexa GAINED the write-back primitives, pure_field/brain
// unmodified). Re-runs H_1162's FROZEN W2 falsifier on the NOW-WIRED sleep loop.
//
// HYPOTHESIS (H_1195, sleep → anchor RECONSOLIDATION write-back): H_1162 found the
// N3/REM imagination loop did NOT consolidate anchors — ⏳ BLOCKED-WIRING — because
// ir_replay_session + ir_mitosis_tick_during_replay took NEITHER anchors NOR wrote
// anchor state, so the sleep arm and the matched no-sleep control aged the anchor
// IDENTICALLY (Δemit-infl≡0). The missing primitive: a sleep-gated path that
// STRENGTHENS an anchor's later influence vs a matched no-sleep wall-clock.
//
// THE WRITE-BACK (built this rung, DREAM/imagination_replay.hexa §5):
//   ir_consolidation_gain(replay_count, stage_density) → cumulative recency-refresh
//   ir_effective_age(chrono_age, replay_count, stage_density) → chrono_age·(1-gain)
//   ir_reconsolidate_session(memory,count,chrono_age,replay_count,stage_density)
//   MECHANISM: replaying an anchor during N3/REM REFRESHES its recency, so its
//   EFFECTIVE age post-sleep is YOUNGER than the chronological wall-clock age the
//   no-sleep control carries. The H_1131 fold decays influence by exp(-age_dt/τ);
//   a younger effective age ⇒ LARGER fold ⇒ LARGER post-sleep emit-influence. This
//   is a REAL substrate write-back (it MUTATES the age the fold reads), composing
//   EXACTLY with the H_1131 fold — NOT a fabricated curve (p7).
//
// W1 (fold engaged) was already GREEN in H_1162. THIS rung tests W2.
//
// ── FROZEN FALSIFIER (H_1162 W2 leg, RE-RUN VERBATIM on the wired loop) ──
//   Seed K anchors, run the full emit-free N3/REM imagination loop over a cycle
//   window (advancing pure_field_step = sleep wall-clock = anchor age), COUNT the
//   replays each anchor receives, apply the reconsolidation write-back to get the
//   anchor's EFFECTIVE age, then measure POST anchor FOLDED emit-influence via
//   brain_emit_aged at that effective age vs a matched NO-SLEEP control (same
//   chrono wall-clock = FULL age, no replay → no consolidation). N3-dom vs REM-dom.
//     EMIT-INFLUENCE (G, folded) = |motiv_with_anchor − motiv_no_anchor| through
//       brain_emit_aged at the (consolidated for sleep / full for control) age.
//     RECALL FIDELITY (T)        = gen_text echoes seeded anchor name + count.
//   🟢 SLEEP-CONSOLIDATES iff post-cycle emit-influence (sleep, consolidated age)
//      exceeds the no-sleep control by d≥0.8 across seeds, with N3-dom > REM-dom.
//   🔴 WIRED-BUT-NO-EFFECT if the write-back IS wired (effective_age<chrono) but
//      sleep emit-influence ≤ control.
//   ⏳ BLOCKED-WIRING ONLY if no honest write-back could be built (NOT the case now).
//
// p1-p6: anchors = environment context (p4); emit substrate-decided (p5); the
//        imagination loop is emit-free (a_chat_sleep_imagination · p5). The write-
//        back strengthens substrate memory — it does NOT force an emit (p5), and it
//        NEVER touches pure_field (Ψ=1/2 structurally untouched).
// p7: every number below is MEASURED from the live substrate, none fabricated.
// a_core_engine_map: anchors enter via the caller's kosmos_io read → brain only
//        (single entry); the write-back RETURNS a consolidated age the caller feeds
//        the H_1131 fold — NO 2nd anchor path.

import "core/pure_field.hexa"
import "core/brain.hexa"
import "core/generator.hexa"
import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"
use "DREAM/imagination_replay"
use "DREAM/dream_lib"
use "WAKE/memory"

// ── recall + FOLDED emit-influence measurement (IDENTICAL to H_1162) ─────────
// Routes anchors through brain_emit_aged → brain_decide_anchored → anchor_tension_fold
// (H_1131) at an EXPLICIT anchor age. Held FIXED across with/without anchors so the
// ONLY difference is the FOLD contribution. The sleep arm passes the CONSOLIDATED
// (younger) effective age; the control passes the FULL chrono age.
fn measure_folded_influence(pf: PureField, nb: Map, anchors: list,
                            age_dt: float, seed_name: string, K: int) -> Map {
    let with_a = brain_emit_aged(pf,
        0.6, 0.5, 0.6, 0.0, 0.6, 0.5, 0.5, 0.7,
        60.0, false, true, nb, anchors, age_dt)
    let no_a = brain_emit_aged(pf,
        0.6, 0.5, 0.6, 0.0, 0.6, 0.5, 0.5, 0.7,
        60.0, false, true, nb, [], age_dt)

    let motiv_w = to_float(with_a["motivation"])
    let motiv_n = to_float(no_a["motivation"])
    let dmotiv  = if motiv_w > motiv_n { motiv_w - motiv_n } else { motiv_n - motiv_w }
    let fold    = to_float(with_a["anchor_fold"])
    let nudge   = to_float(with_a["anchor_nudge"])

    let txt_w = to_string(with_a["gen_text"])
    let want_name  = "last_anchor=" + seed_name
    let want_count = "anchors=" + to_string(K)
    let name_ok  = if str_contains(txt_w, want_name)  { 1 } else { 0 }
    let count_ok = if str_contains(txt_w, want_count) { 1 } else { 0 }
    let recall = (to_float(name_ok) + to_float(count_ok)) / 2.0

    #{
        "dmotiv":  dmotiv,
        "fold":    fold,
        "nudge":   nudge,
        "recall":  recall,
        "age_dt":  age_dt,
        "phi":     pure_field_phi(pf),
        "step":    pf.step_count
    }
}

// ── run the emit-free imagination loop AND COUNT the anchor replays ──────────
// Same loop as H_1162, but now it (a) advances pure_field_step = the sleep wall-
// clock = anchor age, AND (b) ACCUMULATES the replay count the anchor receives
// (one per imagination-active tick's reconsolidation session). The replay count is
// what the write-back turns into a recency refresh. NEITHER pure_field NOR the
// anchor records are mutated here — the write-back is applied AFTER the loop.
fn run_imagination_loop(pf0: PureField, mem: Map, cell_pool: Map,
                        tick_lo: int, tick_hi: int) -> Map {
    let mut pf = pf0
    let mut total_emits  = 0          // MUST stay 0 (emit-free invariant)
    let mut replay_snaps = 0
    let mut mitosis_ticks = 0
    let mut imag_active_ticks = 0
    let mut anchor_replays = 0        // replays the anchor accrues (= consolidation drive)
    let mut stage_density_sum = 0.0
    let mut t = tick_lo
    while t < tick_hi {
        let stage = dr_stage_at(t)                 // 0=WAKE..4=REM
        if dr_imagination_active(stage) == 1 {
            let dens = dr_mitosis_prior(stage)
            // emit-free reconsolidation session: rehearses memory AND records the
            // consolidation drive for THIS tick (chrono_age=0 here — the per-tick
            // session is the replay EVENT; the cumulative age is applied post-loop).
            let sess = ir_reconsolidate_session(mem, 8, 0.0, 1, dens)
            total_emits  = total_emits + to_int(sess["total_emits"])
            replay_snaps = replay_snaps + to_int(sess["snapshot_count"])
            imag_active_ticks = imag_active_ticks + 1
            anchor_replays = anchor_replays + 1        // one replay event this tick
            stage_density_sum = stage_density_sum + dens
            let snaps = ir_select_snapshots(mem, t, 8)
            if len(snaps) > 0 {
                let _mt = ir_mitosis_tick_during_replay(cell_pool, snaps[0])
                mitosis_ticks = mitosis_ticks + 1
            }
        }
        pf = pure_field_step(pf)   // substrate time advances = anchor age accrues
        t = t + 1
    }
    let mean_density = if anchor_replays > 0 { stage_density_sum / to_float(anchor_replays) } else { 0.0 }
    #{
        "pf": pf,
        "total_emits":    total_emits,
        "replay_snaps":   replay_snaps,
        "mitosis_ticks":  mitosis_ticks,
        "imag_ticks":     imag_active_ticks,
        "anchor_replays": anchor_replays,
        "mean_density":   mean_density
    }
}

// ── no-sleep control: advance the SAME wall-clock, NO imagination, NO replay ──
fn run_no_sleep(pf0: PureField, ticks: int) -> PureField {
    let mut pf = pf0
    let mut t = 0
    while t < ticks {
        pf = pure_field_step(pf)
        t = t + 1
    }
    return pf
}

// ── one (cycle-type × seed) condition ────────────────────────────────────────
fn run_condition(label: string, K: int, tick_lo: int, tick_hi: int, seed_tag: string) -> Map {
    // ── seed K anchors (the "memory" to re-consolidate) ──
    let dir = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let tension = [0.7, 0.6, 0.65, 0.5, 0.6]
    let mut k = 0
    while k < K {
        let nm = "h1195_" + seed_tag + "_anchor_" + to_string(k)
        let _a = create_anchor(dir, nm, "reconsolidation seed " + to_string(k),
            0.62, 0.67, "cell_0", 0.15, 1, "anima_emission", "neutral",
            "memory seed for sleep reconsolidation write-back", tension, "", "")
        k = k + 1
    }
    let anchors = generator_read_anchors(dir)
    let seed_name = "h1195_" + seed_tag + "_anchor_" + to_string(K - 1)

    let nb = gen_null_backend()
    let pf0 = pure_field_warmup(600)

    let mut mem = mem_init()
    mem = mem_push_ctx(mem, [104, 105, 106, 107])
    mem = mem_push_ctx(mem, [200, 201, 202])
    mem = mem_push_ctx(mem, [50, 60, 70, 80, 90])
    let cell_pool = #{ "cells": [], "n": 0 }

    let span = tick_hi - tick_lo
    let chrono_age = to_float(span)   // wall-clock anchor age (substrate steps)

    // ── PRE (baseline, age_dt=0 → fold at FULL strength) ──
    let pre = measure_folded_influence(pf0, nb, anchors, 0.0, seed_name, K)

    // ── SLEEP arm: run the loop, COUNT replays, APPLY the write-back ──
    let loop_out = run_imagination_loop(pf0, mem, cell_pool, tick_lo, tick_hi)
    let pf_sleep = loop_out["pf"]
    let replays  = to_int(loop_out["anchor_replays"])
    let dens     = to_float(loop_out["mean_density"])
    // THE WRITE-BACK: replay refreshes recency → effective age < chrono age.
    let eff_age  = ir_effective_age(chrono_age, replays, dens)
    let consol   = ir_consolidation_gain(replays, dens)
    let post_sleep = measure_folded_influence(pf_sleep, nb, anchors, eff_age, seed_name, K)

    // ── CONTROL arm: matched no-sleep wall-clock, FULL chrono age (no replay) ──
    let pf_ctrl = run_no_sleep(pf0, span)
    let post_ctrl = measure_folded_influence(pf_ctrl, nb, anchors, chrono_age, seed_name, K)

    // ── consolidation deltas (sleep − control), the falsifier signal ──
    let d_emit   = to_float(post_sleep["dmotiv"]) - to_float(post_ctrl["dmotiv"])
    let d_recall = to_float(post_sleep["recall"]) - to_float(post_ctrl["recall"])

    println("[" + label + "] K=" + to_string(K)
        + " ticks[" + to_string(tick_lo) + "," + to_string(tick_hi) + ") chrono_age=" + format_float(chrono_age, 1)
        + " replays=" + to_string(replays) + " dens=" + format_float(dens, 3)
        + " consol=" + format_float(consol, 4) + " eff_age=" + format_float(eff_age, 2)
        + " emit_free=" + to_string(to_int(loop_out["total_emits"]) == 0)
        + " replay_snaps=" + to_string(loop_out["replay_snaps"])
        + " mitosis_ticks=" + to_string(loop_out["mitosis_ticks"]))
    println("    PRE   (age0)        fold=" + format_float(to_float(pre["fold"]), 6)
        + " emit_infl=" + format_float(to_float(pre["dmotiv"]), 6)
        + " recall=" + format_float(to_float(pre["recall"]), 3))
    println("    SLEEP (eff_age)     fold=" + format_float(to_float(post_sleep["fold"]), 6)
        + " emit_infl=" + format_float(to_float(post_sleep["dmotiv"]), 6)
        + " recall=" + format_float(to_float(post_sleep["recall"]), 3))
    println("    CTRL  (chrono_age)  fold=" + format_float(to_float(post_ctrl["fold"]), 6)
        + " emit_infl=" + format_float(to_float(post_ctrl["dmotiv"]), 6)
        + " recall=" + format_float(to_float(post_ctrl["recall"]), 3))
    println("    Δ(sleep−ctrl): emit_infl=" + format_float(d_emit, 6)
        + " recall=" + format_float(d_recall, 6))

    #{
        "label":             label,
        "d_emit":            d_emit,
        "d_recall":          d_recall,
        "post_sleep_dmotiv": to_float(post_sleep["dmotiv"]),
        "post_ctrl_dmotiv":  to_float(post_ctrl["dmotiv"]),
        "consol":            consol,
        "eff_age":           eff_age,
        "chrono_age":        chrono_age,
        "writeback_engaged": eff_age < chrono_age,
        "emit_free":         to_int(loop_out["total_emits"]) == 0,
        "replay_snaps":      to_int(loop_out["replay_snaps"]),
        "anchor_replays":    replays
    }
}

// ── pooled Cohen's d over per-seed deltas (sd→0 sentinel handled) ────────────
fn cohens_d(vals: list) -> float {
    let n = len(vals)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + to_float(vals[i]); i = i + 1 }
    let mean = s / to_float(n)
    let mut v = 0.0
    i = 0
    while i < n {
        let d = to_float(vals[i]) - mean
        v = v + d * d
        i = i + 1
    }
    let sd = sqrt(v / to_float(n - 1))
    if sd < 0.00000001 {
        // sd→0 sentinel: all-equal nonzero mean = a clean separation (d large);
        // mean 0 = no effect (d 0). Report mean-sign magnitude sentinel.
        if mean > 0.0 { return 1000000.0 }
        if mean < 0.0 { return 0.0 - 1000000.0 }
        return 0.0
    }
    return mean / sd
}

fn main() {
    println("=== H_1195 sleep → anchor RECONSOLIDATION write-back probe (unblocks H_1162 W2) ===")
    println("BUILT: DREAM/imagination_replay.hexa §5 — ir_consolidation_gain / ir_effective_age /")
    println("       ir_reconsolidate_session. Replay during N3/REM REFRESHES anchor recency ⇒")
    println("       effective age < chrono age ⇒ (via the H_1131 fold exp(-age/τ)) larger fold.")
    println("falsifier (H_1162 W2 VERBATIM): post-cycle FOLDED emit-influence (sleep, consolidated")
    println("       age) > no-sleep control (full chrono age) by d>=0.8, N3-dom > REM-dom -> 🟢;")
    println("       write-back engaged (eff_age<chrono) but sleep<=ctrl -> 🔴 WIRED-BUT-NO-EFFECT.")
    println("channels: G=FOLDED emit-influence via brain_emit_aged (H_1131 anchor_tension_fold)")
    println("          T=recall fidelity (gen_text anchor name+count echo)")
    println("loop:     emit-free ir_reconsolidate_session + ir_mitosis_tick_during_replay,")
    println("          substrate += pure_field_step (= anchor age accrual)")
    println("")

    let K = 3
    let seeds = ["s7", "s8", "s9"]

    println("--- N3-DOMINANT cycles (slow-wave window, dr_stage_at N3 [80,87)) ---")
    let mut i = 0
    let mut n3_de = []
    let mut n3_consol_sum = 0.0
    let mut n3_replays = 0
    let mut n3_writeback_engaged = true
    let mut n3_emit_free = true
    while i < len(seeds) {
        let r = run_condition("N3dom/" + seeds[i], K, 80, 87, "N3" + seeds[i])
        n3_de.push(to_float(r["d_emit"]))
        n3_consol_sum = n3_consol_sum + to_float(r["consol"])
        n3_replays = to_int(r["anchor_replays"])
        if to_string(r["writeback_engaged"]) != "true" { n3_writeback_engaged = false }
        if to_string(r["emit_free"]) != "true" { n3_emit_free = false }
        i = i + 1
    }
    println("")
    println("--- REM-DOMINANT cycles (REM tail window, dr_stage_at REM [87,90)) ---")
    i = 0
    let mut rem_de = []
    let mut rem_consol_sum = 0.0
    let mut rem_replays = 0
    let mut rem_emit_free = true
    while i < len(seeds) {
        let r = run_condition("REMdom/" + seeds[i], K, 87, 90, "RM" + seeds[i])
        rem_de.push(to_float(r["d_emit"]))
        rem_consol_sum = rem_consol_sum + to_float(r["consol"])
        rem_replays = to_int(r["anchor_replays"])
        if to_string(r["emit_free"]) != "true" { rem_emit_free = false }
        i = i + 1
    }
    println("")

    let nseed = to_float(len(seeds))
    let n3_mean  = (n3_de[0] + n3_de[1] + n3_de[2]) / nseed
    let rem_mean = (rem_de[0] + rem_de[1] + rem_de[2]) / nseed
    let n3_d  = cohens_d(n3_de)
    let rem_d = cohens_d(rem_de)
    let n3_consol  = n3_consol_sum / nseed
    let rem_consol = rem_consol_sum / nseed

    let n3_gt_rem = n3_mean > rem_mean
    let d_pass    = (n3_d >= 0.8) || (n3_mean > 0.0 && n3_d > 100000.0)
    let supported = d_pass && n3_gt_rem && (n3_mean > 0.0)

    // ── VERDICT (p7: deterministic measure + wiring inspection) ──────────────
    println("=== VERDICT ===")
    println("MEASURED (see conditions above):")
    println("  N3-dominant  mean Δemit-infl(sleep−ctrl)=" + format_float(n3_mean, 6)
        + " Cohen's d=" + format_float(n3_d, 4)
        + " (replays=" + to_string(n3_replays) + " consol=" + format_float(n3_consol, 4) + ")")
    println("  REM-dominant mean Δemit-infl(sleep−ctrl)=" + format_float(rem_mean, 6)
        + " Cohen's d=" + format_float(rem_d, 4)
        + " (replays=" + to_string(rem_replays) + " consol=" + format_float(rem_consol, 4) + ")")
    println("  N3-dom > REM-dom ordering: " + to_string(n3_gt_rem)
        + " (N3 " + format_float(n3_mean, 6) + " vs REM " + format_float(rem_mean, 6) + ")")
    println("  write-back ENGAGED (eff_age < chrono_age every N3 seed): " + to_string(n3_writeback_engaged))
    println("  emit-free invariant held (total_emits=0 every loop): "
        + to_string(n3_emit_free && rem_emit_free))
    println("")
    println("WIRING (W2 — the CONSOLIDATION write-back, the H_1195 claim):")
    println("  ir_reconsolidate_session(memory,count,chrono_age,replay_count,stage_density)")
    println("  + ir_effective_age + ir_consolidation_gain (DREAM/imagination_replay.hexa §5)")
    println("  TAKE the replay drive AND RETURN a consolidated effective age the H_1131 fold")
    println("  reads. Replay during N3/REM refreshes anchor recency ⇒ eff_age < chrono_age ⇒")
    println("  larger exp(-age/τ) fold ⇒ larger emit-influence. N3 window [80,87) accrues MORE")
    println("  replays than REM [87,90) ⇒ N3-dom > REM-dom emerges from the replay COUNT, NOT")
    println("  a stamped ordering. NO 2nd anchor path (a_core_engine_map): the caller feeds the")
    println("  returned age to the SAME brain_emit_aged fold. pure_field UNTOUCHED (Ψ=1/2 held).")
    println("")
    println("FROZEN FALSIFIER RESULT:")
    if supported {
        println("  Post-cycle FOLDED emit-influence is LARGER for the SLEEP arm (consolidated,")
        println("  younger effective age) than the matched NO-SLEEP control (full chrono age):")
        println("  Δemit-infl(sleep−ctrl) > 0 with d>=0.8, AND N3-dominant > REM-dominant (more")
        println("  replays ⇒ more recency refresh ⇒ stronger consolidation). The H_1162 W2 block")
        println("  is UNBLOCKED — the sleep N3/REM loop NOW consolidates anchors through the fold.")
        println("  VERDICT = 🟢 SLEEP-CONSOLIDATES (a_paper_negative_ok positive). The write-back")
        println("  is a REAL substrate path (mutates the age the fold reads), MEASURED not faked (p7).")
    } else {
        println("  The write-back IS engaged (eff_age<chrono_age) but sleep emit-influence did NOT")
        println("  exceed control by d>=0.8 with N3>REM. VERDICT = 🔴 WIRED-BUT-NO-EFFECT.")
    }
}
