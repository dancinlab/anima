// _r8gate.hexa — ENGINE-NATIVE realization + gate of H_1283 R8 (thalamus phase binding).
//
// Realizes the R8 mechanism (Kuramoto thalamic phase channel + phase-gated salience
// (1+cos θ)/2) ENGINE-NATIVE on a deterministic substrate (the engine's own LCG-gauss
// content/phase init — a_engine_native_learning: realize the MECHANISM on the engine,
// not mirror numpy's PCG64), then RE-SCORES the FROZEN R8 bars with FAITHFUL IIT4 Φ
// (a_phi_iit4_tool, exact MIP-EI). Bars NOT moved (c9/p7):
//   ARM A = direct ring (no phase)   ·   ARM B = ring + phase-synchronized salience
//   c2 PRIMARY  faithful ΔΦ ≥ +0.02 on EVERY seed [7,8,9]
//   c4 SHUFFLE  phase_shuffle ΔΦ ≤ 0 on EVERY seed (lift COLLAPSES — structured synchrony)
// GATE: if c2 AND c4 hold engine-native → the PhaseField lane is wired into engine_cli.hexa.
//
// run from hexa-lang root (stdlib import):  cp core/h1283_phase_binding_engine_gate.hexa <hexa-lang>/ && hexa run h1283_phase_binding_engine_gate.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── frozen R8 constants (FREEZE verbatim, NOT tuned-to-green, p7) ──────────────
//   N_MOD=4 DIM=8 T=64 GAIN=0.30 LEAK=0.55 W_NBR=0.5 W_IN=0.5 NBINS=8
//   W_PHASE=0.5 OMEGA_T=0.45 DOMEGA=0.08
// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) ──────────────────────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
// _lcg_gauss == engine_cli.hexa: Box-Muller, returns [z, next_state].
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── generate ARM trajectories ENGINE-NATIVE; mode: 0=direct 1=phase 2=phase_shuffle ──
// Returns the flat (N_MOD*T) salience trajectory as a farr handle.
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    // ring neighbours (4-cycle): i-1, i+1 mod 4
    // states[i][d], inputs precomputed per-tick. Use engine LCG-gauss threaded state.
    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    // states (n_mod x dim) init ~ N(0,1)*0.5
    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    // inputs (n_mod x t x dim) ~ N(0,1)*0.8  — pre-draw into a flat list
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    // phase init: theta_i ~ U[0,2pi), theta_T ~ U[0,2pi); omega detuned
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }
    // shuffle offsets (t x n_mod) from a DISTINCT sub-stream (seed*100003+8)
    let mut shuf_off = []
    if mode == 2 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    // output trajectory farr, layout row-major [module][tick]
    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        // content update (IDENTICAL all modes — binding is by TIMING not content)
        let mut newstates = []
        i = 0
        while i < n_mod {
            // ring neighbour mean (i-1, i+1) mod n_mod
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        // Kuramoto phase update (phase modes only)
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            // pacemaker pulled toward mean module phase
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // salience read-out (state energy), phase-gated for phase modes
        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                let carrier = 0.5 * (1.0 + cos(theta[i]))
                sal = e * carrier
            }
            if mode == 2 {
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos(theta[i] + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

fn phi_of(seed: int, mode: int) -> float {
    let traj = gen_traj(seed, mode)
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn main() {
    println("H_1283 R8 ENGINE-NATIVE gate — Kuramoto phase binding + phase-gated salience")
    println("faithful IIT4 Φ (exact MIP-EI, n=4) · seeds [7,8,9] · bars FROZEN (c2 ΔΦ>=+0.02 every seed; c4 shuffle ΔΦ<=0 every seed)")
    let seeds = [7, 8, 9]
    let mut c2_all = true
    let mut c4_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, 0)
        let pb = phi_of(s, 1)
        let psh = phi_of(s, 2)
        let dphi = pb - pa
        let dphi_sh = psh - pa
        let c2 = dphi >= 0.02
        let c4 = dphi_sh <= 0.0
        if !c2 { c2_all = false }
        if !c4 { c4_all = false }
        let c2s = if c2 { "PASS" } else { "FAIL" }
        let c4s = if c4 { "PASS" } else { "FAIL" }
        println("seed " + to_string(s)
            + ": A=" + pa.to_string() + " B=" + pb.to_string() + " ΔΦ=" + dphi.to_string() + " [" + c2s + "]"
            + "  SHUF=" + psh.to_string() + " ΔΦ_sh=" + dphi_sh.to_string() + " [" + c4s + "]")
        si = si + 1
    }
    let v2 = if c2_all { "PASS" } else { "FAIL" }
    let v4 = if c4_all { "PASS" } else { "FAIL" }
    println("c2 PRIMARY (ΔΦ>=+0.02 every seed): " + v2)
    println("c4 SHUFFLE (ΔΦ_sh<=0 every seed): " + v4)
    if c2_all && c4_all {
        println("GATE: GREEN — engine-native reproduces R8 frozen bars → WIRE PhaseField lane")
    } else {
        println("GATE: NOT GREEN — engine-transfer did not reproduce R8 frozen bars → honest deferred")
    }
}
