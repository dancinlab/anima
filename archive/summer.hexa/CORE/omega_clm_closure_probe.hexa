// omega_clm_closure_probe.hexa — OMEGA OΩ6: run the substrate→decode closure
// on the REAL PRODUCTION CONV .clm (CLMConvMoE), not the CDV2 transformer stub.
//
// Prior OMEGA rungs (OH1 #1802) measured the min-gate gB·base+gA·A on CDV2's
// base+A. OΩ6 puts `base` = the REAL conv .clm byte mouth (clm_omega_closure →
// _clmd_fwd_logits) and asks whether the OMEGA min-gate modulates THAT decode.
//
// Honest result axes (p7, no fabrication):
//   base_ce          : the real conv .clm next-byte CE (the production mouth)
//   gated_ce_self    : min-gate with A := conv's OWN logits (the only NATIVE A on
//                      a single-head conv .clm). With gB+gA=1 this MUST equal
//                      base_ce (pure rescale → no coupling). DEGENERATE non-closure.
//   gated_ce_oracle  : min-gate with a leak-free one-hot oracle A (upper bound on
//                      what ANY external A-wire could do; proves the bus plumbing).
//
// Env: OCL_CLM (.clm path) · OCL_CORPUS · OCL_NWIN.
import "core/clm_decode.hexa"

fn main() {
    let clm = env("OCL_CLM")
    let corpus = env("OCL_CORPUS")
    let nwin = if env("OCL_NWIN") == "" { 16 } else { to_int(env("OCL_NWIN")) }
    println("=== OMEGA OΩ6 — closure on the REAL conv .clm (CLMConvMoE) ===")
    println("clm=" + clm)
    println("corpus=" + corpus)

    if !clm_decodable(clm) {
        println("OCL_DECODABLE=0  (.clm not v0.2 — not ENGINE-loadable)")
        println("F-OMEGA-CLM-TRANSFER = 0  (load gate FAILED)")
        return
    }
    println("OCL_DECODABLE=1  (real conv .clm loads through CORE L3 — loaded=true)")

    // (1) min-gate at gB=1,gA=1  → self-coupling (gB+gA)=2: a pure 2x rescale.
    //     CE under argmax-free softmax is monotone in the scale → reported.
    // (2) min-gate at the OH1-fit point gB=0.040, gA=0.901 (sum 0.941 ≈ 1):
    //     self ≈ base (rescale ~identity); oracle shows the plumbing carries A.
    let r1 = clm_omega_closure(clm, corpus, nwin, 1.0, 1.0)
    let r2 = clm_omega_closure(clm, corpus, nwin, 0.040, 0.901)

    println("windows=" + to_string(r1["windows"]) + " d=" + to_string(r1["d"])
        + " E=" + to_string(r1["E"]) + " V=" + to_string(r1["V"]))
    println("--- gate gB=1.0 gA=1.0 (self-coupling = (gB+gA)x rescale) ---")
    println("base_ce        = " + to_string(r1["base_ce"]))
    println("gated_ce_self  = " + to_string(r1["gated_ce_self"]) + "  (A := conv's OWN logits)")
    println("gated_ce_oracle= " + to_string(r1["gated_ce_oracle"]) + "  (A := leak-free 1-hot oracle)")
    println("--- gate gB=0.040 gA=0.901 (OH1-fit point; sum≈1) ---")
    println("base_ce        = " + to_string(r2["base_ce"]))
    println("gated_ce_self  = " + to_string(r2["gated_ce_self"]) + "  (≈ base ⇔ self is a rescale, NO coupling)")
    println("gated_ce_oracle= " + to_string(r2["gated_ce_oracle"]) + "  (oracle upper bound on external-A plumbing)")

    // self_is_rescale: at gB+gA=1 the gate is the identity rescale → self_ce==base_ce.
    let bce = to_float(r2["base_ce"])
    let sce = to_float(r2["gated_ce_self"])
    let oce = to_float(r2["gated_ce_oracle"])
    let diff = if sce > bce { sce - bce } else { bce - sce }
    let self_is_rescale = diff < 0.01
    let oracle_carries = oce < bce
    println("SELF_IS_RESCALE=" + to_string(self_is_rescale) + " (|self-base|=" + to_string(diff) + " < 0.01)")
    println("ORACLE_CARRIES=" + to_string(oracle_carries) + " (oracle_ce < base_ce ⇒ bus plumbing carries an external A)")
    // OΩ6 ruling: the closure LOADS + RUNS on the real conv .clm (decode wired,
    // bus plumbing carries an external A) BUT the conv .clm has NO native A-head
    // substrate — its only native A (self) is a degenerate rescale. So the real-
    // .clm closure is plumbing-COMPLETE but substrate-EMPTY: a genuine A-wire
    // requires the SEPARATE CDV2 dual-head engine (the existing OH1 closure).
    let plumbing_ok = (to_string(r1["ok"]) == "true") && self_is_rescale && oracle_carries
    let mut verdict = "0"
    if plumbing_ok { verdict = "1-PLUMBING" }
    println("F-OMEGA-CLM-TRANSFER = " + verdict
        + "  (real conv .clm decode WIRED + bus carries external-A; native-A degenerate => substrate-empty)")
}
