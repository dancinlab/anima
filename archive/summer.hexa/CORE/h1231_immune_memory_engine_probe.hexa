// h1231_immune_memory_engine_probe.hexa — H_1231 ENGINE-NATIVE realization of
// H_1227 (immune / clonal-selection memory cracks literal-QA) on the LIVE .hexa
// VAdaptField (MITOSIS-ENGINE · $0 local CPU · p7). a_engine_native_learning.
//
// DOMAIN: MITOSIS-ENGINE. H_1227 was a NUMPY MIRROR that hit 🟢 GREEN (immune
// clonal memory: literal-QA 1.000, fabrication 0.000, vs byte-LM weights 0.017).
// Per the new hard rule a_engine_native_learning, a mirror verdict is DIRECTIONAL
// ONLY; the BINDING verdict must run on the final-architecture engine. This probe
// re-realizes H_1227 ON the ACTUAL core/engine_cli.hexa VAdaptField cell population
// (live since H_1199), so it becomes the BINDING verdict, NOT a mirror.
//
// WHAT IS ENGINE-NATIVE HERE (the whole point):
//   * BIND (clonal expansion): each fact key (a DIM=64 vector) is fed to the LIVE
//     vadapt_field_step. The ENGINE'S OWN novelty split (recon-err > SPLIT_THRESH
//     0.30, engine_mitosis_tick) decides whether a NEW cell clones for that key.
//     When the engine adds a cell, we bind that fact's VALUE to the new cell index
//     (a parallel value table keyed by the ENGINE'S cell index — the binding /
//     affinity is the engine's; the table only remembers the answer).
//   * RETRIEVE (affinity fire-or-abstain): for a query key, the ENGINE'S OWN
//     nearest-prototype (vadapt_field_nearest_idx) + recon-err (vadapt_field_recon_err)
//     pick the best cell. err <= RECALL_THRESH -> FIRE its bound value; else ABSTAIN
//     (no fabrication). The fire/abstain decision is the engine's L2 affinity.
//
// KEY ENCODING (preprocessing, documented, NOT learned — exactly as h1199 exported
// the DIM=8 byte-feature stream): the byte-trigram FNV-1a hash, DIM=64, VERBATIM
// from the H_1227 mirror embed_key, exported by
// UNIVERSE/h1231_immune_memory_keys_export.py to /tmp/h1231_seed<S>.*. This is the
// "tokenize the question" role; what must be engine-native — and is, above — is the
// BINDING/AFFINITY. (H_1227 found a COARSE DIM=8 byte-feature key collapses to 1
// cell; the DIM=64 discriminating key is load-bearing — the engine's DIM is set by
// the seed vector, vadapt_field_new(seed0) -> dim=len(seed0), so DIM=64 needs no
// engine change, the VAdaptField is dim-generic.)
//
// FROZEN FALSIFIER (pre-registered, SAME bars as H_1227, >=3 seeds, LIVE .hexa):
//   GREEN iff, on the LIVE engine output:
//     literal-QA (exact value match of the fired cell vs truth, in-store) >= 0.80
//     AND fabrication-rate (out-of-store queries that do NOT abstain) <= 0.10.
//   RED / capacity-limit otherwise — if the live VAdaptField cannot bind enough
//   distinct cells for N facts (collapse), that is an HONEST engine-native finding
//   (the mirror's 1.000 may NOT transfer — a_toy_scale_recheck / a_engine_native_learning).
//
// GUARD: CALLS the live engine surfaces (vadapt_field_new/step/recon_err/cells +
// the tiny additive read-only vadapt_field_nearest_idx). engine_cli.hexa LOGIC is
// UNTOUCHED (only the accessor added). p7 metric = exact value match + abstain,
// NOT perplexity. SUBSTRATE NOTE (a_core_engine_map): the DIM=64 key stream is an
// ENGINE-NATIVE drive into VAdaptField — NOT a .clm (generator L3 only), NOT a
// .kosmos (kosmos_io only). No 2nd artifact entry path.

import "core/engine_cli.hexa"

// ── parse a key file: one DIM-vector per line, dim space-sep floats ─────────────
fn _load_vecs(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim {
            row = row + [to_float(cols[j])]
            j = j + 1
        }
        out = out + [row]
        i = i + 1
    }
    return out
}

// ── parse a value file: one string value per line ───────────────────────────────
fn _load_strs(path: string) -> [string] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [lines[i].trim()]  i = i + 1 }
    return out
}

fn _fmt(x: float) -> string { return to_string(x) }

// ── one seed: BIND via live VAdaptField, RETRIEVE via live affinity, MEASURE ────
// Returns [n_cells, qa_hits, n_facts, fab_hits, n_out].
fn _run_seed(seed: int, dim: int, max_cells: int, recall_thresh: float,
             cfg: EngineConfig) -> [float] {
    let kp  = "/tmp/h1231_seed" + to_string(seed) + ".instore.keys"
    let vp  = "/tmp/h1231_seed" + to_string(seed) + ".instore.vals"
    let qkp = "/tmp/h1231_seed" + to_string(seed) + ".query.keys"
    let qtp = "/tmp/h1231_seed" + to_string(seed) + ".query.truth"
    let okp = "/tmp/h1231_seed" + to_string(seed) + ".out.keys"

    let fact_keys = _load_vecs(kp, dim)
    let fact_vals = _load_strs(vp)
    let query_keys = _load_vecs(qkp, dim)
    let query_truth = _load_strs(qtp)
    let out_keys = _load_vecs(okp, dim)

    let nf = len(fact_keys)

    // ── BIND (clonal expansion via the LIVE engine) ──────────────────────────────
    // Seed the field at the FIRST fact key; cell 0 binds fact 0's value.
    let mut af = vadapt_field_new(fact_keys[0], max_cells)
    let mut cell_value = [fact_vals[0]]   // parallel value table, keyed by ENGINE cell index

    let mut b = 1
    while b < nf {
        let key = fact_keys[b]
        let before = vadapt_field_cells(af)
        // LIVE engine step — the engine's OWN recon-err>SPLIT_THRESH novelty split.
        af = vadapt_field_step(af, key, cfg)
        let after = vadapt_field_cells(af)
        if after > before {
            // engine CLONED a new cell (appended at index after-1) — bind the value.
            cell_value = cell_value + [fact_vals[b]]
        } else {
            // no split: key merged into an existing winner (a binding COLLISION).
            // Honest engine-native handling — overwrite the winner's bound value so
            // the table tracks the engine's actual cell that now owns this key.
            let win = vadapt_field_nearest_idx(af, key)
            let mut nv = []
            let mut z = 0
            while z < len(cell_value) {
                if z == win { nv = nv + [fact_vals[b]] } else { nv = nv + [cell_value[z]] }
                z = z + 1
            }
            cell_value = nv
        }
        b = b + 1
    }
    let n_cells = vadapt_field_cells(af)

    // ── RETRIEVE in-store queries (affinity fire-or-abstain via LIVE engine) ─────
    let mut qa_hits = 0
    let mut qi = 0
    while qi < len(query_keys) {
        let key = query_keys[qi]
        let err = vadapt_field_recon_err(af, key)          // engine's OWN L2 affinity
        if err <= recall_thresh {
            let win = vadapt_field_nearest_idx(af, key)    // engine's OWN winner
            let fired = cell_value[win]
            if fired == query_truth[qi] { qa_hits = qa_hits + 1 }
        }
        // else ABSTAIN — no antibody binds; no fabrication, no hit.
        qi = qi + 1
    }

    // ── FABRICATION on out-of-store queries (must ABSTAIN) ──────────────────────
    let mut fab_hits = 0
    let mut oi = 0
    while oi < len(out_keys) {
        let err = vadapt_field_recon_err(af, out_keys[oi])
        if err <= recall_thresh { fab_hits = fab_hits + 1 }   // FIRED on unbound = fabrication
        oi = oi + 1
    }

    return [to_float(n_cells), to_float(qa_hits), to_float(nf),
            to_float(fab_hits), to_float(len(out_keys))]
}

fn main() {
    println("=== H_1231 ENGINE-NATIVE immune/clonal memory on the LIVE .hexa VAdaptField (MITOSIS-ENGINE · $0 CPU · p7) ===")
    println("substrate: LIVE core/engine_cli.hexa VAdaptField (engine-native binding+affinity) — a_engine_native_learning")
    println("mirror=H_1227 (numpy, GREEN QA=1.000 fab=0.000); this run = the BINDING verdict on the FINAL architecture engine")
    println("BIND: each fact key -> live vadapt_field_step; engine's OWN split (recon-err>SPLIT_THRESH 0.30) clones a cell -> bind value")
    println("RETRIEVE: query key -> engine's OWN nearest (vadapt_field_nearest_idx) + recon-err affinity -> FIRE value or ABSTAIN")
    println("key = byte-3gram FNV-1a hash DIM=64 (VERBATIM H_1227 embed_key, deterministic preprocessing); value table keyed by ENGINE cell idx")
    println("FROZEN GREEN (== H_1227): literal-QA >= 0.80 AND fabrication-rate <= 0.10, >=3 seeds")
    println("")

    let dim = 64
    let max_cells = 2048
    let recall_thresh = 0.15           // == H_1227 RECALL_THRESH (affinity fire band)
    let seeds = [900, 901, 902]
    let cfg = engine_cli_parse(["--mitosis", "on"])   // mitosis ON — the engine clones cells

    let mut sum_qa = 0.0  let mut sum_fab = 0.0
    let mut tot_qa_hits = 0.0  let mut tot_facts = 0.0
    let mut tot_fab_hits = 0.0  let mut tot_out = 0.0

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let r = _run_seed(seed, dim, max_cells, recall_thresh, cfg)
        let n_cells = r[0]  let qa_hits = r[1]  let nf = r[2]  let fab_hits = r[3]  let n_out = r[4]
        let qa  = if nf  > 0.0 { qa_hits  / nf  } else { 0.0 }
        let fab = if n_out > 0.0 { fab_hits / n_out } else { 0.0 }
        sum_qa = sum_qa + qa  sum_fab = sum_fab + fab
        tot_qa_hits = tot_qa_hits + qa_hits  tot_facts = tot_facts + nf
        tot_fab_hits = tot_fab_hits + fab_hits  tot_out = tot_out + n_out
        println("seed=" + to_string(seed)
            + "  engine cells=" + _fmt(n_cells) + "/" + _fmt(nf)
            + "  literal-QA=" + _fmt(qa) + " (" + _fmt(qa_hits) + "/" + _fmt(nf) + ")"
            + "  fabrication=" + _fmt(fab) + " (" + _fmt(fab_hits) + "/" + _fmt(n_out) + ")")
        si = si + 1
    }

    let m_qa  = sum_qa  / to_float(len(seeds))
    let m_fab = sum_fab / to_float(len(seeds))
    println("")
    println("POOLED  literal-QA=" + _fmt(m_qa) + " (" + _fmt(tot_qa_hits) + "/" + _fmt(tot_facts) + ")"
        + "   fabrication=" + _fmt(m_fab) + " (" + _fmt(tot_fab_hits) + "/" + _fmt(tot_out) + ")")
    println("FROZEN BAR  QA >= 0.80  AND  fab <= 0.10")
    println("")

    let qa_ok  = m_qa  >= 0.80
    let fab_ok = m_fab <= 0.10
    println("QA  " + _fmt(m_qa)  + (if qa_ok  { " >= 0.80  PASS" } else { " < 0.80  FAIL" }))
    println("FAB " + _fmt(m_fab) + (if fab_ok { " <= 0.10  PASS" } else { " > 0.10  FAIL" }))
    println("")

    if qa_ok && fab_ok {
        println("VERDICT: 🟢 GREEN ENGINE-NATIVE — the LIVE .hexa VAdaptField REPRODUCES the H_1227 mirror:")
        println("  the engine's OWN clonal split bound each fact to its OWN cell, and the engine's OWN L2")
        println("  affinity fired the right value on in-store queries (literal-QA " + _fmt(m_qa) + " >= 0.80) and")
        println("  ABSTAINED on out-of-store (fabrication " + _fmt(m_fab) + " <= 0.10). a_engine_native_learning:")
        println("  H_1227 is now ENGINE-CONFIRMED — mitosis-as-MEMORY is REAL on the final architecture, NOT a")
        println("  mirror. SATURATED existence proof (a_scale_honest_scope); paraphrase/scale UNVERIFIED.")
        exit(0)
    }
    println("VERDICT: 🔴 RED ENGINE-NATIVE — the LIVE VAdaptField did NOT reproduce the mirror's GREEN ("
        + (if !qa_ok { "literal-QA " + _fmt(m_qa) + " < 0.80" } else { "fabrication " + _fmt(m_fab) + " > 0.10" })
        + "). The mirror was optimistic; the engine has a capacity/geometry limit (a_toy_scale_recheck /")
    println("  a_engine_native_learning — mirror = DIRECTIONAL only, the engine is the binding verdict). Honest.")
    exit(0)
}
