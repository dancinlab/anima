// h1264_lane_functional_coupling.hexa — native lane 기능적 결합(functional coupling) 측정.
//
// 배경: H_1242/H_1262 에서 native lane 들이 Ψ-disjoint(비간섭: 모든 lane ON 시 phiSum
//   byte-identical)임은 입증됐다. 그러나 "비간섭"은 *상태가 서로 망가뜨리지 않음*을 뜻할 뿐,
//   두 lane 의 출력 시계열이 *상관(coupling)* 되는지(서로 같이 움직이는지)는 미탐사다.
//   비간섭 ≠ 무상관 일 수도, 둘 다일 수도 있다 — 둘 다 정직한 finding.
//
// 목표: 한 pure_field run 안에서 native lane 들의 스칼라 출력을 매 step 기록하고,
//   lane 쌍의 시계열 사이 부호일치율(sign-agreement)과 공분산 부호를 측정한다 (≥2 쌍).
//   lane scalar (매 step 변동하는 연속 스칼라를 각 lane 의 실제 산출에서 추출):
//     · MITOSIS  = engine_mitosis_tick 누적 cell 수            (Δ = +1 상수, phi-독립 — 실엔진 그대로)
//     · METACOG  = mh_collect_emit_window(...) 의 30-emit 합   (최근 30 emit(phi>0) 카운트, phi-구동, 연속)
//                   + mh_verdict_record pass_count 도 보조 기록
//     · SAVANT   = sh_savant_trigger(...)["savant_index"]      (phi-list 함수, phi-구동)
//
// 측정: 각 lane scalar 의 per-step delta 를 잡고, 두 lane delta 의 부호일치율 + 공분산부호.
//   부호일치 > 0.7 또는 |공분산| 뚜렷 → 🟢 "기능적 결합 존재".
//   ≈ 0.5 (무상관) → 🔴 "독립 (Ψ-disjoint 가 기능적 독립도 동반)".
//
// 공통-phi 교란 (정직 명시): pure_field 는 공유되므로 phi 가 두 lane 의 공통 입력이다.
//   두 lane 이 phi 의 결정론적 함수면 상관은 trivial(공통원인 매개). 이를 드러내기 위해
//   각 lane delta vs Δphi 의 부호일치도 함께 보고하고, MITOSIS(phi-독립 ramp)를 음성대조로 둔다.
//   따라서 결합이 보이면 "공통 phi 경유 결합"으로, 안 보이면 "phi-독립 기능적 독립"으로 한계 기술.

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "METACOG/audit_hook.hexa"
import "SAVANT/substrate_hook.hexa"

let STEPS = 600

// ── sign helper: -1 / 0 / +1 ─────────────────────────────────────────────
fn sgn(x: float) -> int {
    if x > 0.0 { return 1 }
    if x < 0.0 { return -1 }
    return 0
}

// ── coupling between two delta-series: sign-agreement + covariance sign ───
// only steps where BOTH deltas are non-zero count toward sign-agreement
// (a constant-delta lane like MITOSIS has zero variation → degenerate, reported separately).
fn couple(da: [float], db: [float]) -> dict {
    let n = da.len()
    let mut agree = 0
    let mut active = 0          // steps where both deltas vary (non-zero)
    let mut cov = 0.0
    let mut i = 0
    while i < n {
        let sa = sgn(da[i])
        let sb = sgn(db[i])
        cov = cov + da[i] * db[i]
        let mut both_vary = false
        if sa != 0 { if sb != 0 { both_vary = true } }
        if both_vary {
            active = active + 1
            if sa == sb { agree = agree + 1 }
        }
        i = i + 1
    }
    let mut rate = 0.5
    if active > 0 { rate = float(agree) / float(active) }
    return #{
        "n": n,
        "active": active,
        "agree": agree,
        "sign_agreement": rate,
        "covariance": cov,
        "cov_sign": sgn(cov),
    }
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1264 — native lane 기능적 결합(functional coupling) 측정")
    println("════════════════════════════════════════════════════════════════")

    let cfg = engine_config_default()
    let mut pf = pure_field_new()

    // per-step scalar series (levels)
    let mut phi_s   = []
    let mut mit_s   = []   // MITOSIS cumulative cells
    let mut meta_s  = []   // METACOG pass_count
    let mut sav_s   = []   // SAVANT savant_index

    let mut cells = 1
    let mut emit_hist = []
    let mut last_pass = 0     // pass_count held between 30-tick audit fires

    let mut i = 0
    while i < STEPS {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)

        // MITOSIS — real engine tick (phi-INDEPENDENT monotone ramp)
        cells = engine_mitosis_tick(cells, cfg)

        // METACOG — continuous emit-window confidence: sum of last-30 emit(phi>0).
        // (mh_collect_emit_window 의 실제 window 합 = lane 의 confidence proxy, 매 step 변동.)
        emit_hist.push(if phi > 0.0 { 1 } else { 0 })
        let win = mh_collect_emit_window(emit_hist, 30)
        let mut wsum = 0
        let mut wj = 0
        while wj < win.len() { if win[wj] == 1 { wsum = wsum + 1 } wj = wj + 1 }
        // pass_count 보조 기록 (30-tick verdict)
        if mh_should_fire(i, 30) {
            let rec = mh_verdict_record(win, i, "now")
            last_pass = rec["pass_count"]
        }

        // SAVANT — savant_index over a phi-derived domain vector
        let trig = sh_savant_trigger([phi, phi*0.5, phi*0.25, phi*0.1], 0.30, float(cells))
        let sav_val = trig["savant_index"]

        phi_s.push(phi)
        mit_s.push(float(cells))
        meta_s.push(float(wsum))
        sav_s.push(sav_val)
        i = i + 1
    }
    let meta_pass_final = last_pass

    // ── per-step deltas ──────────────────────────────────────────────────
    let mut d_phi  = []
    let mut d_mit  = []
    let mut d_meta = []
    let mut d_sav  = []
    let mut k = 1
    while k < STEPS {
        d_phi.push(phi_s[k]  - phi_s[k-1])
        d_mit.push(mit_s[k]  - mit_s[k-1])
        d_meta.push(meta_s[k] - meta_s[k-1])
        d_sav.push(sav_s[k]  - sav_s[k-1])
        k = k + 1
    }

    // ── lane-pair couplings (≥2 pairs) ───────────────────────────────────
    let c_meta_sav = couple(d_meta, d_sav)   // both phi-driven (common-phi candidate)
    let c_mit_meta = couple(d_mit, d_meta)   // MITOSIS(phi-indep) vs METACOG
    let c_mit_sav  = couple(d_mit, d_sav)    // MITOSIS(phi-indep) vs SAVANT

    // ── common-phi confound exposure: each phi-driven lane vs Δphi ────────
    let c_meta_phi = couple(d_meta, d_phi)
    let c_sav_phi  = couple(d_sav,  d_phi)

    println("\n  per-step scalar series over " + to_string(STEPS) + " steps (shared pure_field):")
    println("    MITOSIS cells : 1 → " + to_string(mit_s[STEPS-1]) + "  (Δ=+1 상수, phi-독립 음성대조)")
    println("    METACOG win30 : final " + to_string(meta_s[STEPS-1]) + " (pass_count=" + to_string(meta_pass_final) + ")")
    println("    SAVANT index  : final " + to_string(sav_s[STEPS-1]))

    println("\n  lane-쌍 결합 (delta sign-agreement / covariance):")
    println("    METACOG⇄SAVANT : active=" + to_string(c_meta_sav["active"])
        + " sign-agree=" + to_string(c_meta_sav["sign_agreement"])
        + " cov=" + to_string(c_meta_sav["covariance"])
        + " cov_sign=" + to_string(c_meta_sav["cov_sign"]))
    println("    MITOSIS⇄METACOG: active=" + to_string(c_mit_meta["active"])
        + " sign-agree=" + to_string(c_mit_meta["sign_agreement"]) + " (active=0=phi-indep)")
    println("    MITOSIS⇄SAVANT : active=" + to_string(c_mit_sav["active"])
        + " sign-agree=" + to_string(c_mit_sav["sign_agreement"]) + " (active=0=phi-indep)")

    println("\n  공통-phi 교란 노출 (각 phi-구동 lane vs Δphi):")
    println("    METACOG⇄Δphi : sign-agree=" + to_string(c_meta_phi["sign_agreement"])
        + " active=" + to_string(c_meta_phi["active"]))
    println("    SAVANT ⇄Δphi : sign-agree=" + to_string(c_sav_phi["sign_agreement"])
        + " active=" + to_string(c_sav_phi["active"]))

    // ── verdict ──────────────────────────────────────────────────────────
    // primary pair = METACOG⇄SAVANT (both have phi-driven variation).
    let ms_rate = c_meta_sav["sign_agreement"]
    let ms_active = c_meta_sav["active"]
    let mut coupled = false
    if ms_active > 0 { if ms_rate > 0.7 { coupled = true } }
    // a strong covariance with sufficient active steps also counts
    let mut strong_cov = false
    if ms_active >= 10 { if c_meta_sav["cov_sign"] != 0 { strong_cov = true } }

    // is the coupling (if any) just common-phi? both lanes track phi if both ⇄Δphi high.
    let mut via_phi = false
    if c_meta_phi["sign_agreement"] > 0.7 { if c_sav_phi["sign_agreement"] > 0.7 { via_phi = true } }

    println("")
    if ms_active == 0 {
        println("h1264_lane_functional_coupling: INCONCLUSIVE 🟠 — primary 쌍(METACOG⇄SAVANT) "
            + "active step=0 (한 lane 이 변동 없음). 부호일치 측정 불가; lane scalar 가 너무 평탄.")
    } else {
        if coupled {
            let mut origin = "lane-고유 결합"
            if via_phi { origin = "공통 phi 경유 (trivial)" }
            println("h1264_lane_functional_coupling: PASS 🟢 — METACOG⇄SAVANT delta 부호일치 "
                + to_string(ms_rate) + " (>0.7, active=" + to_string(ms_active) + "), cov_sign="
                + to_string(c_meta_sav["cov_sign"]) + " ⇒ 기능적 결합 존재. 결합기원=" + origin
                + ". MITOSIS(phi-독립)는 active=0 음성대조 — Ψ-disjoint 가 무조건 무상관은 아님.")
        } else {
            println("h1264_lane_functional_coupling: PASS 🔴 — METACOG⇄SAVANT delta 부호일치 "
                + to_string(ms_rate) + " (≈0.5, active=" + to_string(ms_active)
                + ") ⇒ 기능적 독립: Ψ-disjoint 가 기능적 독립도 동반. 공통 phi 를 받아도 두 lane "
                + "출력이 상관되지 않음 (METACOG⇄Δphi=" + to_string(c_meta_phi["sign_agreement"])
                + ", SAVANT⇄Δphi=" + to_string(c_sav_phi["sign_agreement"]) + ").")
        }
    }
}
