// EEG_CLM/berger.hexa — Berger 효과: 눈감음 vs 눈뜸 알파(8-12Hz) 비교 (H_1273).
//
// 고전 Berger(1929): 눈 감으면 후두엽 알파파(8-12Hz)가 증가. 두 녹음(eyes_open/closed)의
// 16채널 알파파워(MA-diff 밴드패스 분산)를 비교 — 눈감음 > 눈뜸 채널이 다수면 Berger 확인.
// 합격: F1 알파 증가(closed>open) 채널 ≥ 절반 ∧ F2 전체평균 알파비 closed/open > 1.
// 실행: hexa run EEG_CLM/berger.hexa

fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}
fn parse_eeg(path: string) -> Map {
    let body = read_file(path)
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    return #{"n_ch": nums[0], "n_samp": nums[1], "samples": samples}
}
// 채널 c 의 알파(8-12Hz) 파워 = (ma5-ma8) 밴드패스 분산. @125Hz: hw5≈12Hz, hw8≈8Hz.
fn alpha_power(samples: array, base: int, n: int) -> float {
    let mut bp = []
    let mut t = 0
    while t < n {
        let mut s5 = 0.0
        let mut c5 = 0
        let mut u = t - 5
        while u <= t + 5 { if u >= 0 && u < n { s5 = s5 + samples[base + u]; c5 = c5 + 1 } u = u + 1 }
        let mut s8 = 0.0
        let mut c8 = 0
        u = t - 8
        while u <= t + 8 { if u >= 0 && u < n { s8 = s8 + samples[base + u]; c8 = c8 + 1 } u = u + 1 }
        bp = bp.push(s5 / to_float(c5) - s8 / to_float(c8))
        t = t + 1
    }
    let mut m = 0.0
    t = 0
    while t < n { m = m + bp[t]; t = t + 1 }
    m = m / to_float(n)
    let mut v = 0.0
    t = 0
    while t < n { let d = bp[t] - m; v = v + d * d; t = t + 1 }
    return v / to_float(n)
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1273 Berger 효과 — 눈감음 vs 눈뜸 알파(8-12Hz)")
    println("════════════════════════════════════════════════════════════════")
    let o = parse_eeg("EEG_CLM/eeg_eyes_open.txt")
    let c = parse_eeg("EEG_CLM/eeg_eyes_closed.txt")
    let n_ch = o["n_ch"]
    let no = o["n_samp"]
    let nc = c["n_samp"]
    let so = o["samples"]
    let sc = c["samples"]
    println("[parse] open " + str(n_ch) + "ch x " + str(no) + " · closed x " + str(nc))
    println("  ch │ open α    │ closed α  │ closed/open")
    println("  ───┼───────────┼───────────┼────────────")
    let mut inc = 0
    let mut r_sum = 0.0          // 채널별 ratio 합 (outlier-robust mean 용)
    let mut best_ch = 0
    let mut best_ratio = 0.0
    let mut ch = 0
    while ch < n_ch {
        let ao = alpha_power(so, ch * no, no)
        let ac = alpha_power(sc, ch * nc, nc)
        let ratio = if ao > 0.0 { ac / ao } else { 0.0 }
        r_sum = r_sum + ratio
        if ac > ao { inc = inc + 1 }
        if ratio > best_ratio { best_ratio = ratio; best_ch = ch }
        if ch < 8 || ratio > 1.5 { println("  " + str(ch) + " │ " + str(ao) + " │ " + str(ac) + " │ " + str(ratio)) }
        ch = ch + 1
    }
    let mean_ratio = r_sum / to_float(n_ch)   // 채널별 ratio 평균 (큰 채널 sum-지배 회피)
    println("  ... (16채널)")
    println("[berger] 알파증가 채널 " + str(inc) + "/" + str(n_ch) + " · 전체평균 closed/open = " + str(mean_ratio))
    println("[berger] 최대증가 ch" + str(best_ch) + " ratio=" + str(best_ratio) + " (후두 추정 = 알파 핫스팟)")
    let f1 = inc * 2 >= n_ch
    let f2 = mean_ratio > 1.0
    println("[F1] 알파증가 채널≥절반 : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 평균 알파비 >1     : " + (if f2 {"PASS"} else {"FAIL"}))
    if f1 && f2 {
        println("h1273_berger: PASS 🟢 — Berger 효과 확인: 눈감음 알파(8-12Hz)가 눈뜸보다 증가 "
            + "(" + str(inc) + "/" + str(n_ch) + " 채널↑, 평균 " + str(mean_ratio) + "x, 핫스팟 ch" + str(best_ch)
            + " " + str(best_ratio) + "x). 실 EEG 로 고전 신경생리(1929) 재현.")
    } else {
        println("h1273_berger: " + (if f2 {"INCONCLUSIVE 🟠 부분"} else {"FAIL 🔴 알파 증가 없음"})
            + " (증가 " + str(inc) + "/" + str(n_ch) + " 평균 " + str(mean_ratio) + "x)")
    }
}
