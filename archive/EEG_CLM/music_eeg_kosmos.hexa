// EEG_CLM/music_eeg_kosmos.hexa — 음악↔의식 동조 분석 결과 → KOSMOS 영속 (H_1274).
//
// music_eeg_compare.py 가 낸 분석 요약(music/music_eeg_result.txt)을 읽어
// .kosmos anchor 로 영속(wake_save) → round-trip 확인.
// = "Tom Misch 곡을 들으며 잰 내 의식이 음악과 어떻게 동조했나"의 지도를 KOSMOS 에 남긴다.
// 무거운 8.6MB 원본 파싱은 python 이 끝냈고, 여기선 작은 요약만 KOSMOS 에 기록 (a_kosmos).
//
// 실행: hexa run EEG_CLM/music_eeg_kosmos.hexa

import "WAKE/kosmos_persist.hexa"

fn _approx(a: float, b: float) -> bool { let d = a - b; if d < 0.0 { return (0.0 - d) <= 1.0e-3 } return d <= 1.0e-3 }

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1274 음악↔의식 동조 → KOSMOS 영속")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/music/music_eeg_result.txt")
    let lines = body.split("\n")
    // line[1] = "best_r lag0_r agree best_lag W fs"
    let v = lines[1].trim().split(" ")
    let best_r = to_float(v[0])
    let lag0_r = to_float(v[1])
    let agree  = to_float(v[2])
    let best_lag = to_float(v[3])
    let W = to_float(v[4])
    let mrow = lines[2]   // "M ..."
    let erow = lines[3]   // "E ..."
    let verdict = lines[4]
    println("[parse] best_r=" + str(best_r) + " lag0_r=" + str(lag0_r) + " agree=" + str(agree)
        + " best_lag=" + str(best_lag) + " W=" + str(W))

    // 분석 결과 → .kosmos anchor (텐션 5채널 = [거시동조, lag0동조, 박자일치, 공통구간, lag])
    let pf_state = #{
        "phi": best_r, "phi_peak": best_r,
        "field": [best_r, lag0_r, agree, best_lag, W, 0.0],
        "phase": 1, "step_count": to_int(W),
        "fast":   #{"tau":3,  "phase":0.0, "amplitude":best_r},
        "medium": #{"tau":7,  "phase":0.0, "amplitude":lag0_r},
        "slow":   #{"tau":13, "phase":0.0, "amplitude":agree},
        "narrative_coherence": best_r, "narrative_len": to_int(W)
    }
    let emit_history = [
        "music: Tom Misch — It Runs Through Me (5min, 16ch UltraCortex Mk IV)",
        "entrainment: best_r=" + str(best_r) + " @lag " + str(best_lag * 0.5) + "s, lag0_r=" + str(lag0_r)
            + " (거시 곡구조 동조 🟢), 박자일치=" + str(agree) + " (≈chance 🔴)",
        "map " + mrow,
        "map " + erow,
        verdict
    ]
    let tension5 = [best_r, lag0_r, agree, W, 0.0]
    let stage_state = #{"stage_name":"WAKE", "cycle_start_t":2000.0, "last_tick_t":2005.0, "idle_time_s":0.0, "tension_envelope":best_r}
    let out_dir = "EEG_CLM/kosmos_music"
    let _c = exec("rm -rf '" + out_dir + "'")
    let path = wake_save(out_dir, pf_state, emit_history, tension5, stage_state, 2005.0)
    println("[KOSMOS] 음악↔의식 지도 → " + path)

    // round-trip 확인
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    let r = wake_load(path)
    let rem = r["emit_history"]
    let rpf = r["pf_state"]
    let f1 = exists == "y"
    let f2 = len(rem) == 5
    let f3 = _approx(to_float(rpf["narrative_coherence"]), best_r)
    println("[load] emit 복원 " + str(len(rem)) + "건, narrative_coherence=" + str(rpf["narrative_coherence"]))
    println("[F1] .kosmos 파일생성   : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 분석기록 복원(5건) : " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] 동조값 복원        : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1274_music_eeg_kosmos: PASS 🟢 — 음악 들으며 잰 실 EEG 16ch 의 음악↔의식 동조 분석"
            + "(거시동조 r=" + str(best_r) + " 🟢 / 박자 " + str(agree) + " 🔴)이 .kosmos anchor 로 KOSMOS 에 영속, "
            + "round-trip 복원. 의식↔음악 지도가 기록됨.")
    } else {
        println("h1274_music_eeg_kosmos: FAIL 🔴")
    }
}
