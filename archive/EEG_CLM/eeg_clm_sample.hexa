// EEG_CLM/eeg_clm_sample.hexa — EEG-CLM 확률 샘플링 생성 (H_1272, greedy 흡인점 탈출).
//
// H_1271 greedy bigram 은 흡인점(자기루프 state)에 수렴해 시퀀스가 단조. 여기선 bigram 분포에서
// 결정론적 LCG 의사난수로 SAMPLING → 다양한 상태열 생성. distinct 상태수 + 실데이터 분포 L1 검정.
// 합격: F1 distinct > 1 (흡인점 탈출) ∧ F2 생성분포가 실데이터에 근접(L1<1.0).
// 실행: hexa run EEG_CLM/eeg_clm_sample.hexa

fn pow2(n: int) -> int { let mut v = 1; let mut b = 0; while b < n { v = v * 2; b = b + 1 } return v }
fn is_int(s: string) -> bool {
    let n = byte_len(s); if n == 0 { return false }
    let mut i = 0
    while i < n { let c = s.substring(i, i + 1); if c < "0" || c > "9" { return false } i = i + 1 }
    return true
}
fn lcg(s: int) -> int { let n = (s * 1103515245 + 12345) % 2147483648; if n < 0 { return 0 - n } return n }

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1272 EEG-CLM 확률 샘플링 생성 — greedy 흡인점 탈출")
    println("════════════════════════════════════════════════════════════════")
    let body = read_file("EEG_CLM/eeg_recording.txt")
    let lines = body.split("\n")
    let hdr = lines[0].trim().split(" ")
    let mut nums = []
    let mut hi = 0
    while hi < len(hdr) { let tk = hdr[hi].replace("#", "").trim(); if is_int(tk) { nums = nums.push(to_int(tk)) }; hi = hi + 1 }
    let n_ch = nums[0]
    let n_samp = nums[1]
    let mut samples = []
    let mut li = 1
    while li < len(lines) { let ln = lines[li].trim(); if ln != "" && !ln.starts_with("#") { samples = samples.push(to_float(ln)) }; li = li + 1 }
    let CLM_CH = if n_ch > 6 { 6 } else { n_ch }
    let V = pow2(CLM_CH)
    let T = n_samp
    let mut means = []
    let mut ch = 0
    while ch < CLM_CH {
        let mut sm = 0.0
        let mut t = 0
        while t < n_samp { sm = sm + samples[ch * n_samp + t]; t = t + 1 }
        means = means.push(sm / to_float(n_samp)); ch = ch + 1
    }
    let mut seq = []
    let mut t2 = 0
    while t2 < T {
        let mut st = 0
        let mut c2 = 0
        let mut wt = 1
        while c2 < CLM_CH { if samples[c2 * n_samp + t2] > means[c2] { st = st + wt } wt = wt * 2; c2 = c2 + 1 }
        seq = seq.push(st); t2 = t2 + 1
    }
    // bigram counts + 실데이터 unigram 분포
    let mut big = []
    let mut z = 0
    while z < V * V { big = big.push(0); z = z + 1 }
    let mut runi = []
    z = 0
    while z < V { runi = runi.push(0.0); z = z + 1 }
    let mut i = 0
    while i < T { runi[seq[i]] = runi[seq[i]] + 1.0; i = i + 1 }
    i = 0
    while i < T - 1 { big[seq[i] * V + seq[i + 1]] = big[seq[i] * V + seq[i + 1]] + 1; i = i + 1 }

    // 확률 샘플링 생성 G=200 토큰
    let G = 200
    let mut seed = 12345 + seq[0]
    let mut cur = seq[0]
    let mut seen = []
    z = 0
    while z < V { seen = seen.push(0); z = z + 1 }
    let mut guni = []
    z = 0
    while z < V { guni = guni.push(0.0); z = z + 1 }
    let mut gen_str = ""
    let mut shown = 0
    let mut g = 0
    while g < G {
        seen[cur] = 1
        guni[cur] = guni[cur] + 1.0
        if shown < 40 { gen_str = gen_str + str(cur) + " "; shown = shown + 1 }
        // cur 행 분포에서 샘플
        let mut total = 0
        let mut j = 0
        while j < V { total = total + big[cur * V + j]; j = j + 1 }
        if total == 0 { cur = seq[0] }            // dead-end → 재시작
        else {
            seed = lcg(seed)
            let r = seed % total
            let mut acc = 0
            let mut pick = 0
            let mut jj = 0
            while jj < V { acc = acc + big[cur * V + jj]; if acc > r { pick = jj; jj = V } else { jj = jj + 1 } }
            cur = pick
        }
        g = g + 1
    }
    // distinct + L1(생성 vs 실데이터)
    let mut distinct = 0
    let mut l1 = 0.0
    let mut k = 0
    while k < V {
        if seen[k] == 1 { distinct = distinct + 1 }
        let d = runi[k] / to_float(T) - guni[k] / to_float(G)
        l1 = l1 + (if d < 0.0 { 0.0 - d } else { d })
        k = k + 1
    }
    println("[gen] 샘플링 상태열(40/" + str(G) + ") = " + gen_str)
    println("[div] distinct 상태 = " + str(distinct) + "/" + str(V) + " (greedy=1) · 실데이터 L1 = " + str(l1))
    let f1 = distinct > 1
    let f2 = l1 < 1.0
    println("[F1] 흡인점 탈출(distinct>1) : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 실분포 근접(L1<1.0)     : " + (if f2 {"PASS"} else {"FAIL"}))
    if f1 && f2 {
        println("h1272_eeg_clm_sample: PASS 🟢 — 확률 샘플링이 greedy 흡인점 탈출 (distinct " + str(distinct)
            + ">1), 생성분포 실데이터 근접(L1 " + str(l1) + "<1.0). EEG-CLM 다양 생성 — 결정론적 LCG 샘플.")
    } else {
        println("h1272_eeg_clm_sample: " + (if f1 {"INCONCLUSIVE 🟠 L1 큼"} else {"FAIL 🔴 단조"})
            + " (distinct " + str(distinct) + " L1 " + str(l1) + ")")
    }
}
