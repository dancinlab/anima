// ════════════════════════════════════════════════════════════════════════
// AKIDA/impl/H_672_spontaneous_firing.hexa — Group A (자연발화·동기)
//
// 통합 범위 (AKIDA.easy.md Group A · C1~C4 4 sub-ideas):
//   C1 R3 tonic → idle 동기 소스    (입력0 발화 = p5 정답의 HW 동기)
//   C2 spontaneous_gate emit 맥락 (bool gate 아닌 context)
//   C3 SPIKE_FACTOR_MAP → 8-factor 동기 (curiosity/tension/...)
//   C4 R2 noise-straddling → "언제 말할까" stochastic timing
//
// hypothesis (falsifier-anchored):
//   F-H672-1 : R3 tonic spike rate > 0       (입력0 자발 발화 존재)
//   F-H672-2 : R3 tonic rate ∈ (0.0, 1.0)    (full chaos 도 die-out 도 아님)
//   F-H672-3 : R2 noise ≥ R1 silent          (noise straddling > sub-threshold)
//   F-H672-4 : 8-factor map fires            (rate>0 ⇒ at least one factor non-zero)
//
// backend:
//   hw : (시도) pi5-akida AKD1000 실측 — 미도달 시 panic
//   sw : SUB_ENGINES/AKIDA/state/spontaneous_emission_result_2026_05_22.json
//        canonical raster numbers (deterministic mock-replay)
//
// usage:
//   hexa run AKIDA/impl/H_672_spontaneous_firing.hexa sw
//   hexa run AKIDA/impl/H_672_spontaneous_firing.hexa hw
//   AKIDA_BACKEND=sw hexa run AKIDA/impl/H_672_spontaneous_firing.hexa auto
// ════════════════════════════════════════════════════════════════════════

import "../../AKIDA/akida_backend.hexa" as bk

let H_ID  = "H_672"
let GROUP = "A_spontaneous_firing"
let OUT_DIR = "state/akida_hw_sw_impl_2026_05_29"

// ── 8-factor SPIKE_FACTOR_MAP scaffold (mirror of spontaneous_lib::apply_spike_features) ──
//   curiosity · tension · novelty · coherence · valence · arousal · saliency · drive
// computed as cheap linear projections of the raster summary so we can verify
// "non-zero firing produces non-zero factor" (F-H672-4) end-to-end in hexa.
fn _spike_factor_map(rate: float, std_ratio: float, sat_ratio: float) -> map {
    // rate     ∈ [0,1] = total_spikes / (N * T)
    // std_ratio∈ [0,1] = spike_count_std / N      (normalized burst variability)
    // sat_ratio∈ [0,1] = max_step_active / N      (peak fraction firing in one step)
    return #{
        "curiosity": rate * (1.0 - sat_ratio),       // active but not saturated
        "tension":   std_ratio,                       // burstiness → tension
        "novelty":   std_ratio * (1.0 - sat_ratio),  // variable & non-locked
        "coherence": sat_ratio * (1.0 - std_ratio),  // locked pool, low burst
        "valence":   rate - sat_ratio * 0.5,         // signed-ish (placeholder)
        "arousal":   rate,                            // overall activity
        "saliency":  std_ratio,                       // peaks salient
        "drive":     rate * std_ratio,                // burst-rate composite
    }
}

fn _sum_first10(regime: map) -> int {
    let xs = regime["first10_step_counts"]
    let mut s = 0
    let mut i = 0
    while i < len(xs) {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

fn _measure(regime: map, label: string) -> map {
    let total = regime["total_spikes"]
    let n_neurons = 16
    let n_steps = 200
    let rate = (total + 0.0) / ((n_neurons + 0.0) * (n_steps + 0.0))
    let std_ratio = (regime["spike_count_std"] + 0.0) / (n_neurons + 0.0)
    let sat_ratio = (regime["spike_count_max"] + 0.0) / (n_neurons + 0.0)
    let factors = _spike_factor_map(rate, std_ratio, sat_ratio)
    // sum of all 8 factors as a "any non-zero?" check
    let total_factor = factors["curiosity"] + factors["tension"] + factors["novelty"]
                     + factors["coherence"] + factors["valence"]  + factors["arousal"]
                     + factors["saliency"]  + factors["drive"]
    return #{
        "regime_label": label,
        "total_spikes": total,
        "rate": rate,
        "std_ratio": std_ratio,
        "sat_ratio": sat_ratio,
        "factors_8": factors,
        "factors_sum": total_factor,
    }
}

fn _judge(r1: map, r2: map, r3: map) -> map {
    // r3 = tonic (R3 zero-input)
    let f1 = r3["rate"] > 0.0
    let r3_rate = r3["rate"] + 0.0
    let f2 = r3_rate > 0.0 && r3_rate < 1.0
    let f3 = r2["rate"] >= r1["rate"]
    let f4 = r3["factors_sum"] > 0.0
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    let verdict = if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" }
    return #{
        "F-H672-1_R3_rate_gt_0": f1,
        "F-H672-2_R3_in_open_unit": f2,
        "F-H672-3_R2_geq_R1": f3,
        "F-H672-4_8factor_fires": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": verdict,
    }
}

fn _run_h672(backend: string) -> map {
    // gather raster for R1/R2/R3 (R4 not strictly needed but reported)
    let r1_raster = bk.akida_sw_mock_raster_R1()
    let r2_raster = bk.akida_sw_mock_raster_R2()
    let r3_raster = bk.akida_sw_mock_raster_R3()
    let r4_raster = bk.akida_sw_mock_raster_R4()
    let m1 = _measure(r1_raster, "R1_weak_silent")
    let m2 = _measure(r2_raster, "R2_zero_noise")
    let m3 = _measure(r3_raster, "R3_tonic_zero_input")
    let m4 = _measure(r4_raster, "R4_recurrent_selfsustained")
    let v  = _judge(m1, m2, m3)
    let tier = bk.akida_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": bk.akida_backend_label(backend),
        "n_neurons": 16,
        "n_steps": 200,
        "raster_source": if backend == "hw" { "AKD1000 silicon (live)" } else { "canonical raster replay (2026-05-22)" },
        "R1": m1, "R2": m2, "R3": m3, "R4": m4,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["C1_R3_tonic_idle_source", "C2_spontaneous_gate_emit_context", "C3_SPIKE_FACTOR_MAP_8factor", "C4_R2_noise_straddle_timing"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    // hexa-lang args()[0] is the dispatch binary path; user args start at idx 1.
    if len(a) < 2 { return "" }
    let v = a[1]
    // support both bare ("sw") and flagged ("--backend sw") forms
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = bk.akida_backend_resolve(arg_backend)
    if backend == "hw" {
        if bk.akida_hw_reachable() == false {
            bk.akida_panic_no_hw("local probe 3-signal failed (pi5-akida required)")
        }
    }
    let result = _run_h672(backend)
    let dest = OUT_DIR + "/H_672_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_672 spontaneous-firing × AKIDA · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("R1.rate=" + to_string(result["R1"]["rate"]) + " R2.rate=" + to_string(result["R2"]["rate"]) + " R3.rate=" + to_string(result["R3"]["rate"]) + " R4.rate=" + to_string(result["R4"]["rate"]))
    println("written: " + dest)
}
