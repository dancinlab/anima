// ════════════════════════════════════════════════════════════════════════
// AKIDA/impl/H_676_decoder.hexa — Group E (출력 DECODER)
//
// 통합 범위 (AKIDA.easy.md Group E · O1~O2 2 sub-ideas):
//   O1 spike-tier LM head (에너지 비례 토큰 방출)
//   O2 이벤트-구동 attention 게이트 (salient burst 에만 GPU wake)
//
// hypothesis (falsifier-anchored):
//   F-H676-1 : spike-tier LM head — emit budget proportional to rate
//                (R3>R1 emit, R4 saturated cap)
//   F-H676-2 : sparse-attention gate — burst threshold triggers wake
//                (R2 burst variance triggers > R1 silent)
//   F-H676-3 : energy ratchet — total budget < N*T (sparse efficient)
//   F-H676-4 : decoder is a *context* (returns float emit budget · NO bool gate)
// ════════════════════════════════════════════════════════════════════════

import "../../AKIDA/akida_backend.hexa" as bk

let H_ID  = "H_676"
let GROUP = "E_decoder"
let OUT_DIR = "state/akida_hw_sw_impl_2026_05_29"

fn _spike_tier_lm_emit_budget(regime: map) -> float {
    // proportional to rate, capped at 1.0 to avoid R4 saturation runaway
    let total = regime["total_spikes"]
    let rate = (total + 0.0) / (16.0 * 200.0)
    let capped = if rate > 1.0 { 1.0 } else { rate }
    return capped
}

fn _sparse_attention_wake_signal(regime: map) -> map {
    // wake if std_ratio (burstiness) exceeds 0.1 (event-driven only)
    let std_ratio = (regime["spike_count_std"] + 0.0) / 16.0
    let wake_score = std_ratio  // float, NOT bool gate
    let above_thresh = std_ratio > 0.1
    return #{
        "std_ratio": std_ratio,
        "wake_score": wake_score,
        "above_thresh_0_1": above_thresh,
    }
}

fn _energy_proxy(regime: map) -> float {
    // proxy: total_spikes / (N*T) — fraction of NPU activations.
    // sparse iff < 0.6 (R2 noise ≈ 0.475 ; R3 tonic = 0.5 ; R4 = 1.0 over)
    let total = regime["total_spikes"]
    return (total + 0.0) / (16.0 * 200.0)
}

fn _judge(m: map) -> map {
    // m holds R1..R4 measurements
    let r1 = m["R1"]
    let r2 = m["R2"]
    let r3 = m["R3"]
    let r4 = m["R4"]
    let f1 = r3["emit_budget"] > r1["emit_budget"] && r4["emit_budget"] >= r3["emit_budget"]
    let f2 = r2["sparse"]["wake_score"] > r1["sparse"]["wake_score"]
    let f3 = r2["energy"] < 1.0 && r3["energy"] < 1.0   // sparse efficient on edge regimes
    // F4: emit_budget is float ∈ [0,1], NOT a bool gate
    let f4 = r3["emit_budget"] >= 0.0 && r3["emit_budget"] <= 1.0
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    return #{
        "F-H676-1_emit_budget_proportional": f1,
        "F-H676-2_sparse_wake_burst_triggered": f2,
        "F-H676-3_energy_sparse_efficient": f3,
        "F-H676-4_emit_budget_is_float_not_bool": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" },
    }
}

fn _measure(regime: map, label: string) -> map {
    return #{
        "regime_label": label,
        "emit_budget": _spike_tier_lm_emit_budget(regime),
        "sparse": _sparse_attention_wake_signal(regime),
        "energy": _energy_proxy(regime),
    }
}

fn _run_h676(backend: string) -> map {
    let r1 = bk.akida_sw_mock_raster_R1()
    let r2 = bk.akida_sw_mock_raster_R2()
    let r3 = bk.akida_sw_mock_raster_R3()
    let r4 = bk.akida_sw_mock_raster_R4()
    let measurements = #{
        "R1": _measure(r1, "R1_weak_silent"),
        "R2": _measure(r2, "R2_zero_noise"),
        "R3": _measure(r3, "R3_tonic_zero_input"),
        "R4": _measure(r4, "R4_recurrent_selfsustained"),
    }
    let v = _judge(measurements)
    let tier = bk.akida_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": bk.akida_backend_label(backend),
        "measurements": measurements,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["O1_spike_tier_LM_head_emit", "O2_sparse_attention_burst_gate"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    if len(a) < 2 { return "" }
    let v = a[1]
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = bk.akida_backend_resolve(arg_backend)
    if backend == "hw" {
        if bk.akida_hw_reachable() == false {
            bk.akida_panic_no_hw("local probe 3-signal failed (pi5-akida required)")
        }
    }
    let result = _run_h676(backend)
    let dest = OUT_DIR + "/H_676_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_676 decoder × AKIDA · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("written: " + dest)
}
