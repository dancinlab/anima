// ════════════════════════════════════════════════════════════════════════
// AKIDA/akida_backend_smoke.hexa — backend switch self-test (4 cases)
//
// 검증 (4 cases, all $0):
//   case 1 : arg("hw")  → "hw"
//   case 2 : arg("sw")  → "sw"
//   case 3 : arg("auto") + AKIDA_BACKEND unset → "hw" (default)
//   case 4 : akida_hw_probe_signals() returns 3-signal map (Mac: not pi5-akida)
//
// usage:
//   hexa run AKIDA/akida_backend_smoke.hexa
// ════════════════════════════════════════════════════════════════════════

import "../AKIDA/akida_backend.hexa" as bk

fn _assert(label: string, want: string, got: string) -> bool {
    if want == got {
        println("PASS  " + label + " want=" + want + " got=" + got)
        return true
    }
    println("FAIL  " + label + " want=" + want + " got=" + got)
    return false
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0

    // case 1 : explicit arg "hw"
    let r1 = bk.akida_backend_resolve("hw")
    if _assert("case_1_arg_hw", "hw", r1) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 2 : explicit arg "sw"
    let r2 = bk.akida_backend_resolve("sw")
    if _assert("case_2_arg_sw", "sw", r2) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 3 : arg "auto" + env unset → default "hw"
    //   NOTE: this test assumes AKIDA_BACKEND is NOT set in the smoke env.
    //         caller can verify by `unset AKIDA_BACKEND ; hexa run ...`.
    let r3 = bk.akida_backend_resolve("auto")
    if _assert("case_3_auto_default_hw", "hw", r3) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 4 : probe signals (Mac dev box → not pi5-akida → all_pass = false)
    //          we verify the map shape rather than the boolean (host-dependent).
    let probe = bk.akida_hw_probe_signals()
    let has_s1 = probe["signal_1_dev_node"]
    let has_s2 = probe["signal_2_akida_pkg"]
    let has_s3 = probe["signal_3_hostname"]
    println("INFO  hw_probe_signals: dev=" + has_s1 + " pkg=" + has_s2 + " host=" + has_s3 + " all_pass=" + to_string(probe["all_pass"]))
    n_pass = n_pass + 1

    // case 5 : backend label
    let lbl_hw = bk.akida_backend_label("hw")
    let lbl_sw = bk.akida_backend_label("sw")
    println("INFO  hw_label=" + lbl_hw)
    println("INFO  sw_label=" + lbl_sw)
    if _assert("case_5_hw_label_contains_silicon", "AKIDA AKD1000 silicon (HW)", lbl_hw) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 6 : verdict tier (sw all_pass)
    let v_sw = bk.akida_verdict_tier("sw", true)
    if _assert("case_6_sw_tier", "🟢 numerical (mock-replay)", v_sw) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    let v_hw = bk.akida_verdict_tier("hw", true)
    if _assert("case_6b_hw_tier", "🟢 numerical (silicon-confirmed)", v_hw) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    let v_fail = bk.akida_verdict_tier("hw", false)
    if _assert("case_6c_red_neg", "🔴 closed-negative", v_fail) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 7 : sw mock raster R1..R4 returns expected shape
    let r1m = bk.akida_sw_mock_raster_R1()
    let r2m = bk.akida_sw_mock_raster_R2()
    let r3m = bk.akida_sw_mock_raster_R3()
    let r4m = bk.akida_sw_mock_raster_R4()
    let t1 = to_string(r1m["total_spikes"])
    let t2 = to_string(r2m["total_spikes"])
    let t3 = to_string(r3m["total_spikes"])
    let t4 = to_string(r4m["total_spikes"])
    println("INFO  mock totals: R1=" + t1 + " R2=" + t2 + " R3=" + t3 + " R4=" + t4)
    if _assert("case_7_R1_total_0", "0", t1) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert("case_7_R3_total_1600", "1600", t3) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert("case_7_R4_total_3200", "3200", t4) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    println("--- backend smoke summary: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
