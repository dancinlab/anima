// HER/service/gemini_edge.hexa — Gemini edge adapter (pure request/response helpers)
// Satisfies XPRIZE rule R3 ("≥1 Gemini API LLM call when LLM functionality is present")
// as a PERIPHERAL edge call only. The actual Net::http_post is done by her_server.hexa
// (which holds the Net effect); this file only shapes the request/response — so it stays
// effectless and parses cleanly under `hexa parse`.
//
// HARD BOUNDARY (CLAUDE.md @D a_akida_native_train):
//   Gemini output is ENVIRONMENT input to a turn. It is NEVER a training target /
//   gradient / weight source for anima. anima learns on-chip (AKIDA) only.
//   See HER/ARCHITECTURE.md for the boundary contract.
//
// Gemini REST (v1beta generateContent):
//   POST https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent?key=<KEY>
//   body  { "contents":[{"parts":[{"text": <prompt>}]}],
//           "systemInstruction":{"parts":[{"text": <system>}]} }
//   reply candidates[0].content.parts[0].text

comptime const DEFAULT_GEMINI_MODEL = "gemini-2.5-flash"
comptime const GEMINI_API_BASE = "https://generativelanguage.googleapis.com/v1beta/models/"

fn gemini_name() -> string { "gemini" }

// Default model id (function form so it crosses `use` boundaries; consts stay file-local).
fn gemini_model() -> string { DEFAULT_GEMINI_MODEL }

// Resolve the API key from the environment (GOOGLE_API_KEY preferred, GEMINI_API_KEY fallback).
// At runtime, inject via:  GOOGLE_API_KEY=$(secret get gemini.api_key)
fn gemini_api_key() -> string {
    let primary = env("GOOGLE_API_KEY")
    if len(primary) > 0 { return primary }
    env("GEMINI_API_KEY")
}

// R3 gate: true when a Gemini API key is configured.
fn gemini_is_available() -> bool {
    len(gemini_api_key()) > 0
}

// Full generateContent endpoint URL for `model`, with the key as a query param.
pure fn gemini_url(model: string, api_key: string) -> string {
    GEMINI_API_BASE + model + ":generateContent?key=" + api_key
}

// JSON request body for one prompt + optional system instruction (pass "" for none).
pure fn gemini_body(prompt: string, system: string) -> string {
    if len(system) > 0 {
        json_stringify({
            "contents": [ { "parts": [ { "text": prompt } ] } ],
            "systemInstruction": { "parts": [ { "text": system } ] }
        })
    } else {
        json_stringify({
            "contents": [ { "parts": [ { "text": prompt } ] } ]
        })
    }
}

// Extract the model text from a generateContent JSON response string.
pure fn gemini_parse_reply(raw: string) -> string {
    let text = json_get_str(json_parse(raw), "candidates[0].content.parts[0].text")
    trim(text)
}

fn main() {
    println("HER/service/gemini_edge.hexa loaded")
    println("model:", DEFAULT_GEMINI_MODEL)
    println("available:", gemini_is_available())
    println("url:", gemini_url(DEFAULT_GEMINI_MODEL, "REDACTED"))
}
