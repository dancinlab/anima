// HER/service/her_publish.hexa — anima 자연발화 → public room publisher.
//
// her's spontaneous-speech bridge. The anima daemon (AKIDA substrate) decides WHEN and
// WHAT to speak (daemon/module/auto_speak_bridge.hexa — the speak gate). When the gate
// fires, it calls her_say(text) here, which posts the utterance into the Firestore public
// room so everyone in /room sees her drop in.
//
// Identity (CLAUDE.md @D a_substrate_native_speak / a_nondet_identity): the DECISION is the
// substrate's — this file only PUBLISHES what the substrate already chose to say. No
// stimulus-response; her speaks from internal motivation, then this carries it to the room.
//
// hexa-native, no backend, no compiler change: uses the `exec` + `write_file` builtins to
// POST to the Firestore REST API (verified end-to-end). effect/map-literal walls avoided.
//
// CLI: HER_SAY="<utterance>" hexa HER/service/her_publish.hexa

comptime const PROJECT  = "dancinlab"
comptime const ROOM_PATH = "rooms/public/messages"
// Firebase web API key (public by design; access is gated by firestore.rules).
// Override via env HER_FIRESTORE_KEY.
comptime const DEFAULT_KEY = "AIzaSyAbPCfiejGKOQ8V7aYTHLXQTFKqKC_wJdU"

fn firestore_key() -> string {
    let k = env("HER_FIRESTORE_KEY")
    if len(k) > 0 { return k }
    DEFAULT_KEY
}

fn firestore_url() -> string {
    "https://firestore.googleapis.com/v1/projects/" + PROJECT
        + "/databases/(default)/documents/" + ROOM_PATH
        + "?key=" + firestore_key()
}

// Current RFC3339 UTC timestamp (Firestore timestampValue) — via the substrate host's clock.
// `tr -d` strips the trailing newline shell `date` appends (no string-trim builtin needed).
fn now_rfc3339() -> string {
    exec("date -u +%Y-%m-%dT%H:%M:%SZ | tr -d '\\n'")
}

// Build the Firestore createDocument body. json_stringify(text) safely escapes the utterance.
fn her_body(text: string) -> string {
    "{\"fields\":{"
      + "\"text\":{\"stringValue\":" + json_stringify(text) + "},"
      + "\"kind\":{\"stringValue\":\"her\"},"
      + "\"name\":{\"stringValue\":\"her\"},"
      + "\"ts\":{\"timestampValue\":\"" + now_rfc3339() + "\"}"
      + "}}"
}

// Publish one spontaneous utterance from her into the public room.
// Returns the Firestore response (the created doc JSON, or an error doc).
fn her_say(text: string) -> string {
    if len(text) == 0 { return "" }
    // body to a temp file → curl --data-binary @file: injection-safe (no shell quoting of text).
    let tmp = "/tmp/her_say.json"
    write_file(tmp, her_body(text))
    exec("curl -s -X POST -H 'Content-Type: application/json' --data-binary @" + tmp
         + " '" + firestore_url() + "'")
}

fn main() {
    // The anima daemon's speak gate calls her_say(text) directly. This CLI path reads the
    // chosen utterance from env HER_SAY for standalone testing / cron-style invocation.
    let text = env("HER_SAY")
    if len(text) == 0 {
        println("usage: HER_SAY=\"<utterance>\" hexa HER/service/her_publish.hexa")
        println("(the anima daemon's speak gate calls her_say(text) when the substrate decides to speak)")
        return
    }
    let resp = her_say(text)
    println("[her_publish] posted to /room (resp " + to_string(len(resp)) + " bytes)")
}
