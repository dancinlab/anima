// ════════════════════════════════════════════════════════════════════════════
//  clm_causal_band.hexa — CLM CAUSAL-POWER LIVE AKD1000 coupling-BAND 드라이버
//                          (F-CLM-CAUSAL-XFER axis B 후속 특성화 · H_857)
//
//  H_856 axis B 가 🟢: toy CAUSAL-POWER 측도가 REAL SILICON(라이브 AKD1000)에서
//  ONE coupling 점(rich=균형드라이브+coupling 3)에서 frozen 3-check PASS 했다.
//  이 드라이버는 그 regime 을 CHARACTERIZE 한다 — coupling K(칩 주위 SW 폐루프
//  피드백 gain, ENVIRONMENT knob · 측도 knob 아님)를 스윕해 Δ(K)=cp_rich(K)−
//  cp_collapse 곡선을 라이브 AKD1000 에서 그려, 측도가 통합을 읽는 edge-of-chaos
//  BAND 를 매핑한다.
//
//  설계(g0/g1 재사용 우선):
//    - 측도 CAUSAL-POWER 는 measure_sweep.py(frozen) import — 재구현/재튜닝 0.
//    - chip 모델 = clm_causal_hw.py 와 동일: InputData(1,1,16) → FullyConnected(N,
//      weights=ones, act_bits=1) → BackendType.Hardware. drive 는 per-unit int32
//      threshold(=POT−drive)로 인코딩, 비교는 ON-CHIP. coupling K 가 직전 온칩
//      spike 를 드라이브로 피드백(칩 주위 적분). collapse floor=monopoly·K=0.
//
//  사전등록 falsifier F-CLM-CAUSAL-BAND (edge-of-chaos 가 BOUNDED 인가):
//    K_GRID=[0,1,2,3,4,6,9,13,18,24] frozen. Δ(K), K*=interior argmax.
//    PASS ⟺ ① band-exists: Δ(K*)>eps ∧ K* INTERIOR(끝 아님)
//          ② cold rolloff : Δ(K_min) < (1−MARGIN_FRAC)·Δ(K*)  (약결합=decoupled)
//          ③ sat rolloff  : Δ(K_max) < (1−MARGIN_FRAC)·Δ(K*)  (강결합=all-fire 포화)
//    RED ⟺ Δ 가 K 에 MONOTONE(고단 rolloff 無) → "더 결합=더 통합" 방향뿐,
//          bounded edge-of-chaos band 아님 → 측도가 regime 을 certify 못 함.
//    per-K mean fire_frac 보고(cold ~0·band 부분발화·saturate ~1) = 양끝 기전 서명.
//
//  HARD: pi5 단일칩 file-lock — spike-streamer.service stop → 라이브 스윕 →
//  service start(원상복구·is-active=active). MARGIN_FRAC/eps/POKES frozen·재조정 0.
//  HARD: Mac=0 · $0. runnable = clm_causal_band.py (akida SDK = python).
//  sibling: clm_causal_hw.{hexa,py}(axis B 점) · measure_sweep.py(frozen 측도).
// ════════════════════════════════════════════════════════════════════════════

// frozen 측도 임계 (measure_sweep.py 와 1:1 — 참조용, NOT re-tune).
let MARGIN_FRAC   = 0.10      // rolloff margin · 봉우리 대비 양끝 하강 판정
let NONTRIVIAL_EPS = 0.000001 // 1e-6 · 봉우리 비-자명성
let CAUSAL_POKES  = 16        // poke cap
let N_SIZES       = [4, 5, 6] // region 수

// 사전등록 coupling 그리드 (frozen · post-hoc trim 금지).
let K_GRID = [0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 9.0, 13.0, 18.0, 24.0]

fn main() -> i32 {
  // 실 실행은 clm_causal_band.py(akida HW) 가 수행한다:
  //   collapse floor(monopoly·K=0) 1회 + K_GRID 각 점 rich 스윕(3 size 평균)
  //   → Δ(K) 곡선 → evaluate_band 3-check → verdict(JSON).
  // 이 .hexa 는 canonical 드라이버 명세(임계·그리드·falsifier SSOT) 동반본.
  print("clm_causal_band: F-CLM-CAUSAL-BAND · live AKD1000 coupling-band map")
  print("frozen: MARGIN_FRAC=0.10 · POKES=16 · K_GRID=[0..24] · seed=187")
  print("runnable: python3 train/clm/msweep/clm_causal_band.py --json (on pi5-akida)")
  return 0
}
