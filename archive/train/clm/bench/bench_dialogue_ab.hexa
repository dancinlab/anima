// ════════════════════════════════════════════════════════════════════════════
//  bench_dialogue_ab.hexa — SFT-only vs SFT+self-play A/B harness (STUB · @L6)
//
//  P4_PRODUCTION_ROADMAP @L6 / UNIVERSE/cards/H_863 (F-CLM-DIALOGUE): per-rung
//  (tiny/small/mid) A/B comparison of two dialogue-training arms:
//    arm-SFT : SFT only        (CC dialogue-log imitation)
//    arm-SP  : SFT + self-play (chip self-dialogue → re-learn · @L1 living-learn)
//
//  Verdict (pre-registered, frozen pre-run · H_863):
//    F-CLM-DIALOGUE-COHERE : arm-SP multi-turn coherence  > arm-SFT  (distributional)
//    F-CLM-DIALOGUE-ADEQ   : arm-SP response adequacy      > arm-SFT  (distributional)
//    F-CLM-DIALOGUE-LEAK   : register-leak == 0            (8-pattern filter)
//    F-CLM-DIALOGUE-DIV    : self-BLEU < 0.8 ∧ repetition < 0.20  (DIVERSITY)
//  byte-match ✗ — dialogue has no single gold; judge by distributional /
//  trajectory measures (Q-TRUST A reuse · H_857/H_858 edge-of-chaos).
//
//  Output → .verdicts/clm-dialogue/  (per-rung A/B verdict).
//
//  HARD: external LLM 0 (no LLM judge — distributional self-scoring only) ·
//  pure-hexa stub. The torch payload (train both arms · score) reuses
//  train/clm/train/train_clm.py + a self-play generator (P4 follow-on).
//  sibling: UNIVERSE/cards/H_863 · build_p4_dialogue_corpus.hexa · CLM.md P5
// ════════════════════════════════════════════════════════════════════════════

fn verdict_dir() -> string { return ".verdicts/clm-dialogue" }

// the two arms (@L6).
fn arms() -> [string] { return ["SFT", "SP"] }

// per-rung ladder (@L5) — A/B runs per rung; mid is the first production rung.
fn rungs() -> [string] { return ["tiny", "small", "mid"] }

// frozen DIVERSITY thresholds (@L6 · per-mille) — H_863 F-CLM-DIALOGUE-DIV.
fn self_bleu_max_milli() -> int { return 800 }    // self-BLEU < 0.8
fn repetition_max_milli() -> int { return 200 }   // repetition < 20%

// pre-registered falsifier names (frozen pre-run · H_863).
fn falsifiers() -> [string] {
    return [
        "F-CLM-DIALOGUE-COHERE",
        "F-CLM-DIALOGUE-ADEQ",
        "F-CLM-DIALOGUE-LEAK",
        "F-CLM-DIALOGUE-DIV",
    ]
}

// A/B gate: arm-SP PASSES the quality axis iff its score strictly beats arm-SFT
// AND it stays leak-free AND diverse. Scores are per-mille integers in the stub.
fn ab_quality_pass(
    sp_cohere_milli: int, sft_cohere_milli: int,
    sp_adeq_milli: int, sft_adeq_milli: int,
    leak_count: int,
    self_bleu_milli: int, repetition_milli: int
) -> int {
    if sp_cohere_milli <= sft_cohere_milli { return 0 }   // COHERE
    if sp_adeq_milli <= sft_adeq_milli { return 0 }       // ADEQ
    if leak_count != 0 { return 0 }                        // LEAK
    if self_bleu_milli >= self_bleu_max_milli() { return 0 }   // DIV self-BLEU
    if repetition_milli >= repetition_max_milli() { return 0 } // DIV repetition
    return 1
}

// per-rung train command (reuses the landed QAT trainer · @L6 AKIDA-envelope).
// arm-SP additionally folds a DIVERSITY-gated self-play slice into the corpus.
fn train_cmd(arm: string, rung: string) -> string {
    if arm == "SP" {
        return "python3 train/clm/train/train_clm.py --arm AB --rung " + rung
            + " --corpus train/clm/corpus/p4_dialogue/clm_p4.corpus.kosmos  # SFT+self-play"
    }
    return "python3 train/clm/train/train_clm.py --arm AB --rung " + rung
        + " --corpus train/clm/corpus/p4_dialogue/cc_only.corpus.kosmos  # SFT only"
}

fn main() {
    println("CLM dialogue A/B bench (STUB · @L6 · SFT-only vs SFT+self-play)")
    println("  verdict_dir = " + verdict_dir() + " · byte-match ✗ (distributional · Q-TRUST A)")
    println("  rungs = tiny,small,mid · arms = SFT,SP · frozen DIVERSITY: self-BLEU<0.8 ∧ rep<0.20")

    println("pre-registered falsifiers (H_863):")
    for f in falsifiers() { println("  " + f) }

    println("per-rung train commands:")
    for rung in rungs() {
        for arm in arms() {
            println("  [" + rung + "/" + arm + "] " + train_cmd(arm, rung))
        }
    }

    println("A/B gate self-test (stub numbers):")
    println("  SP beats SFT, leak-free, diverse → "
        + to_string(ab_quality_pass(720, 650, 700, 640, 0, 610, 120)) + " (expect 1 · SP wins)")
    println("  SP ties SFT coherence            → "
        + to_string(ab_quality_pass(650, 650, 700, 640, 0, 610, 120)) + " (expect 0 · no gain)")
    println("  SP wins but mode-collapses       → "
        + to_string(ab_quality_pass(720, 650, 700, 640, 0, 850, 120)) + " (expect 0 · self-BLEU)")
    println("  SP wins but leaks register       → "
        + to_string(ab_quality_pass(720, 650, 700, 640, 3, 610, 120)) + " (expect 0 · leak)")
}
