// ════════════════════════════════════════════════════════════════════════════
//  h886_curriculum_selfplay.hexa — lever-(c) arm-SP-curriculum reconstruction
//  scaffold (@L6 · H_886 · NON-ADAPTER lever)
//
//  Builds the H_886 model-under-test: arm-SP-curriculum = STAGED easy→hard
//  SFT-warm continue on the H_868 3× corpus + a DIVERSITY-gated, 8-pattern-leak-
//  filtered self-play reflux fold-back + short continue (H_863 procedure VERBATIM).
//  This is the THIRD, NON-ADAPTER lever in the H_886 menu — after the H_867 full
//  finetune (0.05804) and the H_867r adapter edge (0.04369) both FAILED the floor.
//
//  Lever-(c) = (a) curriculum ⊕ (b) larger rung:
//    (a) curriculum  — difficulty per 64-byte block = mean −log(global byte freq);
//                      stage-1 trains only the LOW-difficulty half, stage-2 adds the
//                      harder half. Pure ORDERING of the SAME corpus — no new data.
//    (b) larger rung — the H_868 LANDED/CLEAN 3.007× lane① corpus (dialogue.bytes,
//                      sha256 2aa3d85d… · 12 PD Gutenberg plays · license-clean PD +
//                      8-pattern register-leak-free).
//
//  Inference stays AKIDA-int4-only (P0 d4). External LLM 0 · ShareGPT/Alpaca/
//  ChatGPT-gen 0 (@L4). INVIOLABLE H_679 noted. The runnable torch payload is
//  .verdicts/clm-dialogue-floor/h886_run.py (committed for provenance).
//  sibling: UNIVERSE/cards/H_886 · UNIVERSE/cards/H_868 · train/clm/bench/h886_dialogue_floor_eval.hexa
// ════════════════════════════════════════════════════════════════════════════

fn backbone() -> string { return "hf:dancinlab/anima-clm-verify/clm_mid_backbone.pt (mid d512/L8/E8 ~13.65M · AKIDA int4-sym[-7,+7] STE act_bits=4)" }
fn train_corpus() -> string { return "H_868 3× lane① dialogue.bytes (sha256 2aa3d85de72c28f28aa0b2ee8a702a41894aae22fce52d326cecd7d43689febb · 12 PD Gutenberg plays · 1668585 B)" }

fn block_bytes() -> int { return 64 }   // difficulty unit = 64-byte block (matches eval block size)
fn n_stages() -> int { return 2 }       // stage-1 = low-difficulty half · stage-2 = +harder half

// curriculum stage membership: a block joins stage s (1-indexed) iff its difficulty rank quantile
// is <= s/n_stages. difficulty = mean −log(global byte freq) over the block (rarer bytes = harder).
// scaffold returns 1 if block at quantile q (per-mille) is in stage s, else 0.
fn block_in_stage(q_milli: int, s: int) -> int {
    let cutoff_milli = (1000 * s) / n_stages()
    if q_milli <= cutoff_milli { return 1 }
    return 0
}

// self-play reflux gate (H_863 VERBATIM): a generated slice is folded back iff it is diverse
// (self_bleu < 0.80) AND non-repetitive (repetition < 0.20) AND register-leak-free (8-pattern).
fn reflux_gate_ok(self_bleu_milli: int, rep_milli: int, leak_count: int) -> int {
    if self_bleu_milli >= 800 { return 0 }
    if rep_milli >= 200 { return 0 }
    if leak_count != 0 { return 0 }
    return 1
}

fn arms() -> [string] {
    return [
        "arm-SP-curriculum  (MODEL UNDER TEST · staged SFT-warm + self-play reflux)",
        "arm-SFT-curriculum (CONTRAST · staged SFT-warm only)",
        "arm-SP-flat        (CONTRAST · H867-style flat SFT-warm + self-play · no curriculum)",
    ]
}

fn main() {
    println("CLM H_886 lever-(c) reconstruction (@L6 · arm-SP-curriculum · NON-ADAPTER)")
    println("  backbone     = " + backbone())
    println("  train_corpus = " + train_corpus())
    println("  curriculum   = staged easy→hard · " + to_string(n_stages()) + " stages · block = " + to_string(block_bytes()) + " B · difficulty = mean −log byte-freq")

    println("curriculum stage-membership self-checks (quantile per-mille → stage):")
    println("  easiest block (q=100) in stage-1 → " + to_string(block_in_stage(100, 1)) + " (expect 1)")
    println("  hard block   (q=700) in stage-1 → " + to_string(block_in_stage(700, 1)) + " (expect 0)")
    println("  hard block   (q=700) in stage-2 → " + to_string(block_in_stage(700, 2)) + " (expect 1)")

    println("self-play reflux gate self-checks (H_863 VERBATIM):")
    println("  diverse non-rep leak-free (0.70,0.10,0) → " + to_string(reflux_gate_ok(700, 100, 0)) + " (expect 1)")
    println("  too repetitive            (0.70,0.30,0) → " + to_string(reflux_gate_ok(700, 300, 0)) + " (expect 0)")
    println("  register leak             (0.70,0.10,1) → " + to_string(reflux_gate_ok(700, 100, 1)) + " (expect 0)")

    println("arms:")
    for a in arms() { println("  " + a) }
}
