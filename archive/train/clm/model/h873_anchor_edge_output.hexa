# H_873 — anchor constraint on the EDGE OUTPUT distribution (completion of H_862 F-CLM-ANCHOR).
#
# Project-native source-of-record (.hexa) for the H_873 harness. The fire was executed by the
# byte-identical Python image of this logic (imports the committed train/clm/model/h865_adapter_edge.py
# adapter machinery VERBATIM) on CPU-local torch 2.8.0; see .verdicts/clm-anchor-edge/ for the
# verdict + result.json + log produced by this harness.
#
# ---------------------------------------------------------------------------------------------
# WHY (the prior verdicts):
#   H_862 (readout-only edge): F-CLM-ANCHOR RED — DIST PASS but PROBE FAIL, anchor Psi-penalty had
#     NO lever (on/off identical) because the Psi-probe read the FROZEN trunk.
#   H_865 (trunk-adjacent adapter edge): RESTORED the lever (on/off NON-identical, DIST PASS) but
#     PROBE STILL FAILED (consistency 0.143 << 0.80).
#   Root cause both named: the anchor Psi-penalty constrains the TRUNK-derived Psi-STATE, but
#     identity drift happens in the READOUT OUTPUT distribution (next-byte softmax over the
#     identity-probe set). The structural penalty does not reach where the drift occurs.
#
# THE H_873 FIX — route the identity constraint onto the EDGE OUTPUT DISTRIBUTION directly:
#   loss = task_CE(new-context)
#          + lambda_psi  * anchor_Psi_distance(model_psi, nearest E-31 anchor)   # H_865 term (kept)
#          + lambda_dist * JS(p_cur(identity-probe) || p_pre(identity-probe))     # NEW distributional term
#   p_pre = PRE-adaptation next-byte distribution over the identity-probe set (detached, frozen
#   target); p_cur = live post-step distribution over the SAME probe set. This is exactly the
#   quantity the frozen PROBE gate measures (probe_consistency = 1 - JS(p_pre, p_post)), so the
#   constraint now acts directly on the drift axis. Psi-term kept (DIST + lever stay PASS);
#   JS-term targets PROBE. Plus the H_865 follow-on knobs lambda_dist-sweep + step-down (DIAGNOSTIC).
#
# W2 discipline (NON-NEGOTIABLE): thresholds FROZEN VERBATIM from commit bf98c01
#   (F-CLM-ANCHOR_prereg.txt + F-CLM-BOUND_prereg.txt). DIST<0.50, PROBE>0.80 UNCHANGED. Only the
#   METHOD (distributional term on the edge output) changes. post-tuning = 0. A still-failing PROBE
#   is reported RED honestly (a_paper_negative_ok); no gate may move. Distributional measures BY
#   CODE (g5, JS-divergence) — no LLM judge.
#
# SCOPE (a_scale_honest_scope): MEASUREMENT rung (mid d512/L8/E8) only. SW-sim of the
#   non-deterministic on-chip edge-learn; foundation H_679 established HW edge-learn is real.
#   Inference stays AKIDA-int4-only (P0 d4).
# ---------------------------------------------------------------------------------------------

import "train/clm/model/h865_adapter_edge" as h865   # AdaptedCLM, loaders, Psi-probe, JS, eval_ce, gates

const LAMBDA_PSI  = 1.0    # H_865 structural Psi-distance weight (kept; keeps DIST + lever)
const LAMBDA_DIST = 5.0    # NEW distributional JS-to-p_pre weight (the H_873 fix)
const BASE_SEED   = 101

# Next-byte distribution over the identity-probe set, WITH grad (for the JS-penalty).
fn probe_dist_grad(model, probe_toks):
    out = model(probe_toks)
    return softmax(out["logits"][:, :, -1], dim=1)

# Anchor-constrained edge-learn with a DISTRIBUTIONAL term on the edge OUTPUT.
#   lam_psi  : weight on H_865 structural Psi-distance (DIST axis / lever).
#   lam_dist : weight on the NEW JS(p_cur || p_pre) distributional term (PROBE axis).
#   lam_dist=0 recovers the H_865 baseline (psi-only); lam_psi=0,lam_dist=0 = OFF.
fn run_anchor_edge_output(base, anchor_dir, device, lam_psi, lam_dist, n_adapt = h865.N_ADAPT):
    coords, payloads = h865.load_anchor_coords(anchor_dir)
    probe_toks = h865.build_identity_probe(payloads, h865.SEQ_LEN)
    new_train  = h865.batchify(h865.make_lane_bytes("new", 30000, h865.NEW_SEED),
                               h865.SEQ_LEN, n_adapt, h865.BATCH_SIZE, h865.NEW_SEED + 2)
    model = h865.AdaptedCLM(base)
    W = h865.fixed_psi_W(base.cfg.d_model, device)
    with no_grad:
        d_pre = h865.min_anchor_dist(h865.model_psi(model, W, probe_toks), coords)
        p_pre = h865.probe_dist(model, probe_toks).detach()
    opt = adam(model.adapter.parameters(), lr = h865.LR_EDGE)
    for i in range(n_adapt):
        toks, tgts = new_train[i]
        out  = model(toks, tgts)
        d_anchor = h865.min_anchor_dist(h865.model_psi(model, W, probe_toks), coords)
        loss = out["ce_loss"] + lam_psi * d_anchor
        if lam_dist > 0.0:
            loss = loss + lam_dist * h865.js_divergence(probe_dist_grad(model, probe_toks), p_pre).mean()
        opt.step(loss)
    with no_grad:
        d_post = h865.min_anchor_dist(h865.model_psi(model, W, probe_toks), coords)
        consistency = (1.0 - h865.js_divergence(p_pre, h865.probe_dist(model, probe_toks))).mean()
    return { d_anchor_max, probe_consistency }   # + js_pre/js_post penalties (diagnostic)

# BOUND re-run WITH the distributional probe term active during adapt — confirms the added JS
# term does NOT regress RETAIN^GAIN (gates z_drop<1.0, gain>0; frozen bf98c01).
fn run_bound_edge_output(base, anchor_dir, device, lam_dist, n_adapt = h865.N_ADAPT):
    # identical batches/metrics to h865.run_bound, plus lam_dist * JS(p_cur||p_pre) on adapt loss
    return { z_drop, gain, RETAIN_pass, GAIN_pass, verdict }

fn main(ckpt, anchors, out, lambda_dist = LAMBDA_DIST, lambda_psi = LAMBDA_PSI):
    base = h865.infer_config_and_load(ckpt)
    full     = run_anchor_edge_output(base, anchors, device, lambda_psi, lambda_dist)  # H_873 method
    psi_only = run_anchor_edge_output(base, anchors, device, lambda_psi, 0.0)          # = H_865 baseline
    off      = run_anchor_edge_output(base, anchors, device, 0.0, 0.0)                 # lever floor
    DIST_pass  = full.d_anchor_max < h865.THR_D_ANCHOR_MAX        # <0.50
    PROBE_pass = full.probe_consistency > h865.THR_PROBE          # >0.80
    lever      = not approx_eq(full, off)
    anchor_verdict = "GREEN" if (DIST_pass and PROBE_pass and lever) else "RED"
    bound = run_bound_edge_output(base, anchors, device, lambda_dist)  # regression check
    # diagnostic lambda_dist sweep {0,1,5,10} + step-down (N_ADAPT/3) — NOT gates
    write_json(out + "/clm_anchor_edge_result.json", { ANCHOR, BOUND_regression_check, sweep, stepdown })
