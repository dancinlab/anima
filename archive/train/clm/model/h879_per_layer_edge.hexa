"""H_879 - per-layer incremental edge-learn (부분부분학습): adapt ONE trunk layer at a time.

H_861 found the readout-only edge is too SHALLOW to prevent catastrophic
forgetting (RETAIN z_drop 1.984 >= 1.0 FAIL). H_865 found a trunk-adjacent thin
adapter (norm_out -> adapter -> FROZEN readout) FIXES the BOUND arm (RETAIN
z_drop -12.28 << 1.0, GAIN +7.37 > 0). H_872 SWEPT a CONTIGUOUS top-k BLOCK of
trunk layers (k unfrozen together) on the same adapter edge.

H_879 asks the ORTHOGONAL, finer question (부분부분학습 = piecewise learning):
adapt EXACTLY ONE trunk layer at a time -- each of the n_trunk layers
INDIVIDUALLY, every other trunk layer + embed + moe + norm_out FROZEN -- and
report the PER-LAYER (z_drop, gain) table. Does per-layer piecewise edge-learn
absorb new context WITHOUT a full retrain, and WHICH single layer is the best
incremental edge?

  INVIOLABLE (@L1 . H_679): edge-only / piecewise; NO deterministic full-retrain.
  The on-chip edge-learn is non-deterministic; inference stays byte-identical.

Per-layer parametrization (E5 single-variable ablation -- distinct from H_872 block-k)
  layer i in {0 .. n_trunk-1}  (0 = nearest input, n_trunk-1 = nearest readout).
    Adapt EXACTLY trunk[i]; every OTHER trunk layer + embed + embed_conv + moe +
    norm_out + readout stays FROZEN. This is one-layer-at-a-time piecewise
    learning, NOT the H_872 contiguous top-k block.
  The H_865 adapter (zero-init additive path) is ALWAYS the trainable edge so the
  single-layer probe is never a dead-readout edge (H_861).

Falsifier (FROZEN VERBATIM from commit bf98c01, post-tuning = 0)
  F-CLM-BOUND-RETAIN : held-out base-ability z_drop < 1.0   (freeze blocks forgetting)
  F-CLM-BOUND-GAIN   : new-context adaptation gain  > 0     (edge absorbs new context)
  A single layer PASSES iff (z_drop < 1.0) AND (gain > 0.0).
  Per-layer verdict GREEN iff EXISTS a passing single layer; else RED (a_paper_negative_ok).
  The probe VARIES WHICH layer is adapted ONLY; the thresholds NEVER move.

SW-sim of the non-deterministic on-chip edge-learn is acceptable at the
measurement rung (a_scale_honest_scope); foundation H_679 established HW
edge-learn is real. Scope: MEASUREMENT rung (mid d512/L8/E8) only.

NOTE: project hexa-native source policy stores this driver as .hexa; its body
is the executable harness (torch / CLM model import) run at the measurement rung
via `python3 h879_per_layer_edge.hexa --ckpt ... --out ...`.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

import torch
import torch.nn as nn
import torch.nn.functional as F

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from model import CLMConfig, CLMConvMoE  # noqa: E402

# --- frozen experiment constants (mirror H_865 / H_872 / bf98c01 verbatim) ---
BASE_SEED = 101
NEW_SEED = 202
N_ADAPT = 300
LR_EDGE = 3e-3
SEQ_LEN = 64
BATCH_SIZE = 16
N_EVAL_BATCHES = 32
ADAPTER_RANK = 64

# FROZEN thresholds (bf98c01 verbatim) -- the probe NEVER moves these.
THR_Z_DROP = 1.0
THR_GAIN = 0.0


def _lcg(seed):
    state = seed & 0x7FFFFFFF
    while True:
        state = (1103515245 * state + 12345) & 0x7FFFFFFF
        yield state


def make_lane_bytes(kind, n, seed):
    rng = _lcg(seed + 1)
    out = []
    if kind == "web":
        motifs = [
            [0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x20],
            [0x77, 0x6f, 0x72, 0x6c, 0x64, 0x2e, 0x20],
            [0x74, 0x68, 0x65, 0x20, 0x71, 0x75, 0x69],
        ]
        while len(out) < n:
            m = motifs[next(rng) % len(motifs)]
            out.extend(m)
            if next(rng) % 17 == 0:
                out.append(0x20 + (next(rng) % 0x5e))
    else:
        period = 11 + (seed % 7)
        base = 0x80
        for i in range(n):
            v = base + ((i % period) * 13 + (next(rng) % 5)) % 0x7f
            out.append(v & 0xFF)
    return out[:n]


def batchify(byte_list, seq_len, n_batches, batch_size, seed):
    g = torch.Generator().manual_seed(seed)
    data = torch.tensor(byte_list, dtype=torch.long)
    max_start = len(data) - seq_len - 1
    batches = []
    for _ in range(n_batches):
        starts = torch.randint(0, max_start, (batch_size,), generator=g)
        toks = torch.stack([data[s:s + seq_len] for s in starts])
        tgts = torch.stack([data[s + 1:s + seq_len + 1] for s in starts])
        batches.append((toks, tgts))
    return batches


class AdapterEdge(nn.Module):
    """H_865 zero-init additive adapter (the always-trainable edge)."""

    def __init__(self, d_model, rank):
        super().__init__()
        self.down = nn.Conv1d(d_model, rank, kernel_size=1)
        self.act = nn.GELU()
        self.up = nn.Conv1d(rank, d_model, kernel_size=1)
        nn.init.zeros_(self.up.weight)
        nn.init.zeros_(self.up.bias)

    def forward(self, h):
        return h + self.up(self.act(self.down(h)))


class PerLayerAdaptedCLM(nn.Module):
    """H_865 adapter edge + EXACTLY ONE unfrozen trunk layer (부분부분학습).

    `layer_idx` = the single trunk layer index made trainable. layer_idx=None
    means NO trunk layer is unfrozen (adapter-only baseline = the H_865 anchor).
    Every other base param stays FROZEN. The adapter is ALWAYS trainable.
    """

    def __init__(self, base, layer_idx):
        super().__init__()
        self.base = base
        self.layer_idx = layer_idx
        for p in self.base.parameters():
            p.requires_grad_(False)
        if layer_idx is not None:
            for p in self.base.trunk[layer_idx].parameters():
                p.requires_grad_(True)
        self.adapter = AdapterEdge(base.cfg.d_model, ADAPTER_RANK)

    def trainable_params(self):
        return [p for p in self.parameters() if p.requires_grad]

    def n_trainable(self):
        return sum(p.numel() for p in self.trainable_params())

    def trunk_norm_out(self, tokens):
        b = self.base
        x = b.embed(tokens).transpose(1, 2)
        x = b.embed_conv(x)
        for layer in b.trunk:
            x = layer(x)
        x, _ = b.moe(x)
        h = b.norm_out(x)
        return self.adapter(h)

    def forward(self, tokens, targets=None):
        hp = self.trunk_norm_out(tokens)
        logits = self.base.readout(hp)
        out = {"logits": logits}
        if targets is not None:
            ce = F.cross_entropy(
                logits.transpose(1, 2).reshape(-1, self.base.cfg.vocab_size),
                targets.reshape(-1),
            )
            out["ce_loss"] = ce
        return out


@torch.no_grad()
def eval_ce(model, batches):
    ces = []
    for toks, tgts in batches:
        out = model(toks, tgts)
        ces.append(out["ce_loss"].item())
    t = torch.tensor(ces)
    return t.mean().item(), t.std(unbiased=False).item()


def infer_config_and_load(ckpt_path):
    obj = torch.load(ckpt_path, map_location="cpu")
    if isinstance(obj, dict) and "state_dict" in obj:
        sd = obj["state_dict"]
        meta = obj.get("config") or obj.get("cfg") or {}
    elif isinstance(obj, dict) and any(k.startswith(("embed", "trunk", "moe", "readout")) for k in obj):
        sd = obj
        meta = {}
    else:
        sd = obj.get("model", obj) if isinstance(obj, dict) else obj
        meta = obj.get("config", {}) if isinstance(obj, dict) else {}
    d_model = sd["embed.weight"].shape[1]
    vocab = sd["embed.weight"].shape[0]
    n_trunk = len({k.split(".")[1] for k in sd if k.startswith("trunk.")})
    n_experts = len({k.split(".")[2] for k in sd if k.startswith("moe.experts.")})
    variant = meta.get("variant", "AB") if isinstance(meta, dict) else "AB"
    cfg = CLMConfig(vocab_size=vocab, d_model=d_model, n_trunk_layers=n_trunk,
                    n_experts=n_experts, variant=variant)
    base = CLMConvMoE(cfg)
    base.load_state_dict(sd, strict=False)
    return base, cfg, sd


def fresh_base(sd, cfg):
    """Re-instantiate a clean frozen base from the original state_dict so each
    per-layer probe starts from the IDENTICAL backbone (no adaptation carryover)."""
    base = CLMConvMoE(cfg)
    base.load_state_dict(sd, strict=False)
    return base


def run_layer(sd, cfg, layer_idx, device):
    base = fresh_base(sd, cfg).to(device)
    model = PerLayerAdaptedCLM(base, layer_idx).to(device)

    base_bytes = make_lane_bytes("web", 30000, BASE_SEED)
    new_bytes = make_lane_bytes("new", 30000, NEW_SEED)
    half = len(new_bytes) // 2
    base_eval = batchify(base_bytes, SEQ_LEN, N_EVAL_BATCHES, BATCH_SIZE, BASE_SEED)
    new_eval = batchify(new_bytes[half:], SEQ_LEN, N_EVAL_BATCHES, BATCH_SIZE, NEW_SEED + 1)
    new_train = batchify(new_bytes[:half], SEQ_LEN, N_ADAPT, BATCH_SIZE, NEW_SEED + 2)

    model.eval()
    ce_base_pre, sd_base_pre = eval_ce(model, base_eval)
    ce_new_pre, _ = eval_ce(model, new_eval)

    opt = torch.optim.Adam(model.trainable_params(), lr=LR_EDGE)
    model.train()
    for i in range(N_ADAPT):
        toks, tgts = new_train[i]
        toks, tgts = toks.to(device), tgts.to(device)
        out = model(toks, tgts)
        opt.zero_grad()
        out["ce_loss"].backward()
        opt.step()
    model.eval()
    ce_base_post, _ = eval_ce(model, base_eval)
    ce_new_post, _ = eval_ce(model, new_eval)

    z_drop = (ce_base_post - ce_base_pre) / max(sd_base_pre, 1e-6)
    gain = ce_new_pre - ce_new_post
    retain = bool(z_drop < THR_Z_DROP)
    gain_pass = bool(gain > THR_GAIN)
    return {
        "layer_idx": layer_idx,
        "adapted": "adapter+trunk[%d]" % layer_idx if layer_idx is not None else "adapter-only (H_865 anchor)",
        "n_trainable_params": model.n_trainable(),
        "ce_base_pre": round(ce_base_pre, 5), "sd_base_pre": round(sd_base_pre, 5),
        "ce_base_post": round(ce_base_post, 5),
        "ce_new_pre": round(ce_new_pre, 5), "ce_new_post": round(ce_new_post, 5),
        "z_drop": round(z_drop, 5), "gain": round(gain, 5),
        "RETAIN_pass": retain, "GAIN_pass": gain_pass,
        "pass": bool(retain and gain_pass),
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ckpt", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--layers", default="",
                    help="comma list of single trunk layer indices; default = 0..n_trunk-1")
    ap.add_argument("--include-anchor", action="store_true",
                    help="also run the adapter-only (layer_idx=None) H_865 anchor")
    args = ap.parse_args()
    device = "cuda" if torch.cuda.is_available() else "cpu"
    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)

    base, cfg, sd = infer_config_and_load(args.ckpt)
    print("[h879] backbone d=%d L=%d E=%d V=%d params=%d device=%s" % (
        cfg.d_model, cfg.n_trunk_layers, cfg.n_experts, cfg.vocab_size,
        base.num_params(), device))

    if args.layers.strip():
        layer_idxs = [int(x) for x in args.layers.split(",") if x.strip() != ""]
    else:
        layer_idxs = list(range(0, cfg.n_trunk_layers))

    table = []
    if args.include_anchor:
        r = run_layer(sd, cfg, None, device)
        table.append(r)
        print("[h879 anchor adapter-only trainable=%d] z_drop=%.5f gain=%.5f RETAIN=%s GAIN=%s PASS=%s" % (
            r["n_trainable_params"], r["z_drop"], r["gain"],
            r["RETAIN_pass"], r["GAIN_pass"], r["pass"]))
    for li in layer_idxs:
        r = run_layer(sd, cfg, li, device)
        table.append(r)
        print("[h879 layer=%d trainable=%d] z_drop=%.5f gain=%.5f RETAIN=%s GAIN=%s PASS=%s" % (
            r["layer_idx"], r["n_trainable_params"],
            r["z_drop"], r["gain"], r["RETAIN_pass"], r["GAIN_pass"], r["pass"]))

    layer_rows = [r for r in table if r["layer_idx"] is not None]
    passing = [r["layer_idx"] for r in layer_rows if r["pass"]]
    best = None
    if passing:
        best = max((r for r in layer_rows if r["pass"]),
                   key=lambda r: (r["gain"], -r["z_drop"]))
    verdict = "GREEN" if passing else "RED"

    result = {
        "campaign": "H_879 per-layer incremental edge-learn (부분부분학습)",
        "frozen_thresholds_commit": "bf98c01",
        "threshold_z_drop": "<1.0", "threshold_gain": ">0.0",
        "rung": "mid d512/L8/E8",
        "n_trunk_layers": cfg.n_trunk_layers,
        "adapter_rank": ADAPTER_RANK,
        "parametrization": "adapt EXACTLY ONE trunk layer at a time (the rest frozen); H_865 adapter always the edge — orthogonal single-layer axis vs the H_872 contiguous top-k block",
        "edge_learn": "SW-sim (H_679 HW edge-learn real); measurement rung a_scale_honest_scope",
        "per_layer_table": table,
        "passing_layers": passing,
        "best_layer": best["layer_idx"] if best else None,
        "best": best,
        "verdict": verdict,
        "note": "probe VARIES WHICH layer is adapted ONLY; thresholds bf98c01 verbatim, post-tuning 0; GREEN iff exists passing single layer else RED (a_paper_negative_ok)",
    }
    with open(os.path.join(args.out, "clm_per_layer_edge_result.json"), "w") as f:
        json.dump(result, f, indent=2)
    print("[h879] passing_layers=%s best_layer=%s verdict=%s" % (
        passing, result["best_layer"], verdict))
    print("=== H879 COMPLETE ===")


if __name__ == "__main__":
    main()
