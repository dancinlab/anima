// ════════════════════════════════════════════════════════════════════════════
//  array_moe.hexa — MITOSIS-ARRAY harness hexa-native DRIVER (d5: hexa 1순위)
//
//  P0 §11 (DISSOLVE) · @L4: py(train/clm/model/array_moe.py·array_smoke.py)=PRIMARY
//  payload(torch sparse-MoE forward+dispatch entropy) + hexa thin driver.
//
//  이 드라이버는:
//    (1) expert-count sweep 축(E ∈ {4,8,16,32,64})을 hexa 에서 조립하고,
//    (2) array_smoke.py 페이로드(forward+entropy 1-step smoke)를 호출한다.
//  routing-diversity 재정의(@L2) = expert-count sweep inter-expert dispatch
//  entropy. 각 expert = mitosis cell = AKD1000 칩(@L3, chip-fit ≤1.2M).
//
//  HARD: pure-hexa · NO main 자동발화 주의(fn main 은 run 시 자동발사).
//  토이/$0 local · toy != scale (H_666) — verdict run 은 run_array_sweep.py(PR3).
// ════════════════════════════════════════════════════════════════════════════

// expert-count sweep 축 (P0 §11.2 · @L7) — python SWEEP_EXPERT_COUNTS 와 1:1 동기.
fn array_sweep_counts() -> string {
    return "4,8,16,32,64"
}

// AKD1000 노드 예산 (P0 §11 · @L3) — expert 가 이 이하면 chip-fit.
fn array_akd1000_budget() -> int {
    return 1200000
}

// harness smoke (forward + dispatch entropy 1-step, 전 E 구성) — $0 local.
fn array_smoke_cmd() -> string {
    return "python3 array_smoke.py"
}

fn main() {
    println("MITOSIS-ARRAY harness (DISSOLVE · hexa-native driver · d5 1순위)")
    println("  scale axis = expert-COUNT (@L2) · sweep E = " + array_sweep_counts())
    println("  expert = mitosis cell = AKD1000 chip (@L3) · budget = "
        + to_string(array_akd1000_budget()) + " nodes")
    println("  routing-diversity = inter-expert dispatch entropy (chip-native)")

    // harness smoke FIRST — forward+entropy 배선을 verdict run 전에 잡는다.
    let cmd = array_smoke_cmd()
    println("smoke: " + cmd)
    let out = exec(cmd + " 2>&1")
    print(out)
}
