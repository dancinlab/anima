// ════════════════════════════════════════════════════════════════════════════
//  build_p4_dialogue_corpus.hexa — P4 production dialogue corpus pipe (STUB)
//
//  P4_PRODUCTION_ROADMAP @L4: TWO dialogue sources, both license-clean:
//    ① CC public dialogue logs / forums / subtitles  (license-clean gate)
//    ② self-play (chip self-dialogue generation → re-learn)  (@L1 living-learn)
//  ③ Alpaca / ShareGPT (ChatGPT-generated) = FORBIDDEN — foundation-borrow
//    violation (@L4). The license-clean gate REJECTS any ChatGPT-gen source.
//
//  Fact / knowledge lane = kowiki CC-BY-SA (P1, already built in
//  train/clm/corpus/build_p1_corpus.hexa) + hexa-codex datasets-source-manifest
//  (CC sources · license_clean_scan reference — KNOWLEDGE REFERENCE ONLY, no
//  code/model borrow; anima external-LLM-0 / pure-scratch is inviolable).
//
//  Output (out_dir):
//    cc_dialogue.bytes   — lane ① CC dialogue (one UTF-8 byte id 0..255 / line)
//    selfplay.bytes      — lane ② chip self-dialogue (DIVERSITY-gated, @L6)
//    manifest.json       — mix ratio · counts · sha256 · license-clean verdict
//
//  This round = pipeline STUB (coherent, runnable-shaped). Full crawl =
//  reproduce-script only; large corpus stays git-uncommitted (.gitignore) →
//  HF dataset (dancinlab) / R2, manifest committed. The byte encoding (V=256,
//  no tokenizer) reuses P1 (round-trip verified).
//
//  HARD: external LLM 0 · ShareGPT/Alpaca FORBIDDEN · pure-hexa stub.
//  sibling: P1_CORPUS.md · build_p1_corpus.hexa · UNIVERSE/cards/H_863 (F-CLM-DIALOGUE)
// ════════════════════════════════════════════════════════════════════════════

fn out_dir() -> string { return "train/clm/corpus/p4_dialogue" }

// byte mix ratio (@L4) — CC dialogue carries the distributional floor, self-play
// supplies living-learn signal. Tunable per rung; default 70:30 (CC:self-play).
fn mix_cc() -> int { return 70 }
fn mix_selfplay() -> int { return 30 }

// ─── @L4 license-clean gate — FORBIDDEN source families (foundation-borrow) ──
// Any source whose provenance matches one of these is REJECTED before ingest.
fn forbidden_source_families() -> [string] {
    return [
        "sharegpt",        // ChatGPT conversation dumps
        "alpaca",          // self-instruct distilled from GPT
        "chatgpt",         // any ChatGPT-generated
        "gpt4",            // GPT-4 generated
        "openai",          // OpenAI-API generated
        "claude-gen",      // any external-LLM-generated
        "wizardlm",        // GPT-distilled instruction data
        "oasst-gpt",       // GPT-augmented OASST slices
    ]
}

// allowed CC license families (@L4 ①) — license-clean PASS set.
fn allowed_cc_licenses() -> [string] {
    return ["CC-BY", "CC-BY-SA", "CC0", "PD", "MIT-data", "OPUS-subtitle-CC"]
}

// license-clean check: 1 = clean (ingest), 0 = REJECT (foundation-borrow).
// `family` = lowercased source-provenance tag; `license` = SPDX-ish license id.
fn license_clean_ok(family: string, license: string) -> int {
    for bad in forbidden_source_families() {
        if family == bad { return 0 }       // ChatGPT-gen etc. → hard reject
    }
    for ok in allowed_cc_licenses() {
        if license == ok { return 1 }       // CC-clean → ingest
    }
    return 0                                 // unknown license → reject (fail-safe)
}

// self-play DIVERSITY gate (@L6 · H_863 F-CLM-DIALOGUE-DIV) — reject a self-play
// batch that collapses (self-BLEU ≥ 0.8 OR repetition ≥ 0.20 = mode collapse).
// Values are per-mille (×1000) integers since hexa stubs stay int-only here.
fn selfplay_diversity_ok(self_bleu_milli: int, repetition_milli: int) -> int {
    if self_bleu_milli >= 800 { return 0 }   // self-BLEU >= 0.8 → collapse
    if repetition_milli >= 200 { return 0 }  // repetition >= 20% → collapse
    return 1
}

// register-leak gate (reuse P1 F-CLM-LEAK 8-pattern filter) — applied to BOTH
// lanes before write (the real filter lives in build_p1_corpus.hexa leak_patterns).
fn leak_filter_cmd() -> string {
    return "hexa train/clm/corpus/build_p1_corpus.hexa  # reuse 8-pattern leak filter"
}

fn main() {
    println("CLM P4 dialogue corpus pipe (STUB · @L4 two-source · license-clean gated)")
    println("  out_dir = " + out_dir()
        + " · mix CC:self-play = " + to_string(mix_cc()) + ":" + to_string(mix_selfplay()))
    println("  lane ① CC dialogue (forums/subtitles/logs) · lane ② self-play (@L1 living-learn)")
    println("  lane ③ Alpaca/ShareGPT = FORBIDDEN (foundation-borrow · @L4)")

    println("license-clean gate self-test:")
    println("  sharegpt/CC-BY     → " + to_string(license_clean_ok("sharegpt", "CC-BY"))   + " (expect 0 · forbidden family)")
    println("  forum/CC-BY-SA     → " + to_string(license_clean_ok("forum", "CC-BY-SA"))   + " (expect 1 · CC clean)")
    println("  subtitle/CC0       → " + to_string(license_clean_ok("subtitle", "CC0"))     + " (expect 1 · CC clean)")
    println("  unknown/Proprietary→ " + to_string(license_clean_ok("unknown", "Proprietary")) + " (expect 0 · fail-safe)")

    println("self-play DIVERSITY gate self-test:")
    println("  self-BLEU 0.62 rep 0.11 → " + to_string(selfplay_diversity_ok(620, 110)) + " (expect 1 · diverse)")
    println("  self-BLEU 0.85 rep 0.05 → " + to_string(selfplay_diversity_ok(850, 50))  + " (expect 0 · collapse)")
    println("  self-BLEU 0.40 rep 0.30 → " + to_string(selfplay_diversity_ok(400, 300)) + " (expect 0 · repetitive)")

    println("leak filter = " + leak_filter_cmd())
    println("full crawl = reproduce-script only · large corpus → HF dataset/R2 · manifest committed.")
}
