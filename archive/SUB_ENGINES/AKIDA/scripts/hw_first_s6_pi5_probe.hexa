// ═════════════════════════════════════════════════════════════════════════
// hw_first_s6_pi5_probe.hexa — AKIDA HW-first 척추 §6 pi5 live probe (canonical
// companion of hw_first_s6_pi5_probe.py).
//
// LIVE AKD1000 (BackendType.Hardware · BC.00.000.002 · /dev/akida0) 2-part probe:
//
//   PART 1 — DECODER byte-match (H_680 재검증, 기대 = MATCH):
//     canonical R0..R4 spontaneous-emission regime 를 실 칩에서 재실행
//     (FullyConnected units=16 · weights_bits=4 · act_bits=1 · all-ones, 즉
//      substrate_akida._hw_forward 가 감싸는 동일 threshold-and-fire 모델) 후,
//     per-step 16-neuron raster 를 결정론 SW akida_sw_lif numpy LIF(seed=187)과
//     Hamming 거리로 diff. 기대 = Hamming 0 (byte-identical) → H_680 현 실리콘 유지.
//
//   PART 2 — PLASTICITY few-shot 비결정론 (H_679 특성화, 기대 = DIVERGE):
//     edge_learn_probe 모델(InputData input_bits=1 → FC units=10 weights_bits=1 +
//     AkidaUnsupervised) 을 few-shot N ∈ {1,2,4,8} 에 대해, 동일 init weight ∧
//     동일 N-shot binary 입력(seed=42)으로 TWICE fit(run A · run B) 후 post-learn
//     가중치를 read-back 하여 run-to-run Hamming 측정. 비영(非零) divergence ==
//     HW on-chip 학습이 비결정론(은닉 plasticity/competition/timing 상태) →
//     SW numpy 근사는 byte-identical 불가 (H_679 CLOSED-NEGATIVE 실리콘 확증).
//
// 단일칩 점유: caller 가 spike-streamer stop → run → start 로 감싼다. 비용 $0
// (pi5-akida own host). 실 실행 = sibling .py (akida 2.19.1 venv); 본 hexa 는
// probe 의도/스펙/판정규약을 표기하는 canonical companion.
// ═════════════════════════════════════════════════════════════════════════

import "../../../AKIDA/akida_backend.hexa" as bk

// 본 probe 가 실행될 backend — HW-first 스위치 SSOT 경유 (default "hw").
// pi5-akida 도달 시 "hw", Mac 미도달 시 graceful "sw" (probe 는 HW 전용 → pi5 only).
pub fn s6_probe_backend(arg: string) -> string {
    return bk.akida_backend_resolve_graceful(arg)
}

// 실 실행 harness 경로 (akida.devices()[0] · BackendType.Hardware 필요).
pub fn s6_probe_path() -> string {
    return "SUB_ENGINES/AKIDA/scripts/hw_first_s6_pi5_probe.py"
}

// ── PART 1 판정규약 — DECODER byte-match ────────────────────────────────────
// total_hamming == 0 ⟺ byte-identical (H_680 🟢 유지). 비영 ⟺ DIVERGE.
pub fn part1_decoder_pass_rule() -> string {
    return "total_hamming == 0 over 200×5 steps (R0..R4, 16-neuron raster) ⟺ MATCH"
}

// canonical raster spec (seed=187 · 16-neuron · 200-step · R0..R4).
pub fn part1_canonical_regimes() -> string {
    return "R0_driven · R1_weak_silent · R2_zero_noise · R3_tonic_zero_input · R4_recurrent_selfsustained"
}

// ── PART 2 판정규약 — PLASTICITY few-shot 비결정론 ──────────────────────────
// any run-to-run weight Hamming > 0 (≥1 shot) ⟹ NON-DETERMINISTIC ⟹ SW≠HW 확증.
pub fn part2_plasticity_pass_rule() -> string {
    return "any run-to-run weight hamming > 0 (N∈{1,2,4,8}) ⟹ NON-DETERMINISTIC ⟹ SW numpy ≠ HW (H_679 🔴 confirmed)"
}

// 두 part 의 형제 lane 대비 — DECODER(추론·결정·byte-identical) ⊥ PLASTICITY(학습·비결정·HW-only).
pub fn s6_sibling_lanes() -> string {
    return "DECODER lane = 추론(결정·byte-identical 🟢, H_680) ⊥ PLASTICITY lane = 학습(비결정·HW-only 🔴, H_679)"
}

// verdict 영속 경로 (g73 — id-dir raw stdout VERBATIM).
pub fn s6_verdict_dir() -> string {
    return ".verdicts/860_hw_first_s6_pi5_probe/"
}
