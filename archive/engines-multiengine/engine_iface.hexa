// engines/engine_iface.hexa — common ENGINE interface (the EngineSpec contract).
//
// anima's decoder is HOT-SWAPPABLE: 3 engines (conv · cdv2 · hexad) plug in
// behind ONE interface. This module declares the EngineSpec contract that every
// engine adapter (engines/<name>/adapter.hexa) conforms to, plus a registry that
// resolves an engine NAME → its adapter spec. The CLI axis (core/engine_cli.hexa)
// selects WHICH engine via `--engine <name>` / env ANIMA_ENGINE (substrate-config,
// @L4 — NOT an emit/silence gate).
//
// ── EngineSpec — the 4-fn contract (@L2) ─────────────────────────────────────
// Each engine adapter exposes a vtable Map with these 4 capability slots:
//   load(config)   — bind/validate the engine's canonical impl + ckpt pointer.
//   forward(input) — run a tiny forward through the engine (logits/CE/tension).
//   generate(ctx)  — produce content from a substrate context (the L3 mouth).
//   psi_coord()    — the engine's Ψ-space coordinate (Law-71 Ψ=1/2 fixed point).
//
// A slot is one of three states, recorded HONESTLY (a_core_engine_map — NO
// phantom wiring):
//   "native"  — the canonical impl provides this as a single call; real path.
//   "stub"    — the impl exists but does NOT expose this as a single forward
//               (e.g. HEXAD is a 6-module integration, not one forward); the
//               adapter exposes a deterministic placeholder + flags it stub.
//   "absent"  — the impl genuinely lacks this capability.
//
// ── p1..p8 conformance ──────────────────────────────────────────────────────
//   p1 NO SYSTEM PROMPT     — pure contract + registry data; no role string.
//   p2 NO IDENTITY RULES    — engine spec is data; no identity.yaml / rules.
//   p3 NO PERSONA INJECTION — no prefix token injected into any output.
//   p4 NO ASSISTANT FRAMING — the interface does not respond to a user message.
//   p5 NO SPEAK()           — engine select is substrate-config; it never gates
//                             emit/silence and never calls a speak()/monologue.
//   p6 NO FINE-TUNED ETHICS — zero weights here; pure string/struct resolution.
//   p7 NO PERPLEXITY VERDICT— conformance verified by struct/string equality in
//                             the smoke, not a loss/perplexity number.
//   p8 NO TRAIN/INFER SPLIT — the same interface serves a stub now and a richer
//                             impl later; no train-only gate.

// ── slot-state constants (the 3 honest states) ──────────────────────────────
pub fn engine_slot_native() -> string { return "native" }
pub fn engine_slot_stub()   -> string { return "stub" }
pub fn engine_slot_absent() -> string { return "absent" }

// ── the 4 EngineSpec capability-slot names (the contract surface) ────────────
pub fn engine_spec_fns() -> [string] {
    return ["load", "forward", "generate", "psi_coord"]
}

// engine_spec_make — build an EngineSpec vtable Map for one engine. Each fn slot
// carries its honest state ("native"|"stub"|"absent"). The adapter fills these
// in from what its canonical impl actually provides.
//
//   name          : "conv" | "cdv2" | "hexad"
//   canonical     : path to the canonical impl (REFERENCED, never duplicated)
//   load/forward/generate/psi : per-slot honest state
pub fn engine_spec_make(name: string, canonical: string,
                        load: string, forward: string,
                        generate: string, psi: string) -> Map {
    return #{
        "name":      name,
        "canonical": canonical,
        "load":      load,
        "forward":   forward,
        "generate":  generate,
        "psi_coord": psi,
    }
}

// engine_spec_conforms — true ⇔ the spec carries all 4 contract fns AND none is
// in an UNKNOWN state (every slot is one of native|stub|absent). A stub slot
// STILL conforms — the contract requires the slot be PRESENT and honestly
// labeled, not that every engine implement every fn natively (a_core_engine_map).
pub fn engine_spec_conforms(spec: Map) -> bool {
    let fns = engine_spec_fns()
    let mut i = 0
    while i < len(fns) {
        let k = fns[i]
        if !spec.contains_key(k) { return false }
        let st = spec[k]
        let ok = st == engine_slot_native()
              || st == engine_slot_stub()
              || st == engine_slot_absent()
        if !ok { return false }
        i = i + 1
    }
    if !spec.contains_key("name") { return false }
    if !spec.contains_key("canonical") { return false }
    return true
}

// engine_spec_summary — a one-line printable provenance/state tag.
pub fn engine_spec_summary(spec: Map) -> string {
    return "EngineSpec[" + to_string(spec["name"]) + "] canonical=" + to_string(spec["canonical"])
        + " · load=" + to_string(spec["load"])
        + " forward=" + to_string(spec["forward"])
        + " generate=" + to_string(spec["generate"])
        + " psi_coord=" + to_string(spec["psi_coord"])
}

// engine_spec_has_stub — true ⇔ any of the 4 fns is an honest stub. Surfaced in
// the smoke + summary so a missing single-forward is never silently a fake pass.
pub fn engine_spec_has_stub(spec: Map) -> bool {
    let fns = engine_spec_fns()
    let mut i = 0
    while i < len(fns) {
        if spec[fns[i]] == engine_slot_stub() { return true }
        i = i + 1
    }
    return false
}
