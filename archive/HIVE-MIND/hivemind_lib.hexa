// ─── 1. Kuramoto order / sync τ primitives (H_354) ───────────────────────

pub fn hm_kuramoto_order_r(phases: list) -> float {
    // r = | (1/N) Σ_i exp(i θ_i) | — Kuramoto order parameter, ∈ [0, 1].
    // Implementation: r^2 = (Σ cos θ)^2 + (Σ sin θ)^2 / N^2.
    let mut n = phases.len()
    if n == 0 { return 0.0 }
    let mut sum_c = 0.0
    let mut sum_s = 0.0
    let mut i = 0
    while i < n {
        sum_c = sum_c + cos(phases[i])
        sum_s = sum_s + sin(phases[i])
        i = i + 1
    }
    let nn = float(n)
    let cx = sum_c / nn
    let cy = sum_s / nn
    return sqrt(cx * cx + cy * cy)
}

pub fn hm_kuramoto_sync_tau(phases: list, K: float, dt: float) -> float {
    // H_354 simplified single-cycle step: integrate one Euler step of
    //   dθ_i/dt = (K/N) Σ_j sin(θ_j - θ_i)
    // and return the new order parameter r. ω-spread = 0 (paper-fix in H_354
    // 의 deterministic anchor; full multi-step τ_sync 측정은 caller loop).
    // Returns the NEW order r AFTER one Euler tick.
    let mut n = phases.len()
    if n == 0 { return 0.0 }
    let mut new_phases = []
    let mut i = 0
    while i < n {
        let mut coupling_sum = 0.0
        let mut j = 0
        while j < n {
            coupling_sum = coupling_sum + sin(phases[j] - phases[i])
            j = j + 1
        }
        let dtheta = (K / float(n)) * coupling_sum
        new_phases.push(phases[i] + dt * dtheta)
        i = i + 1
    }
    return hm_kuramoto_order_r(new_phases)
}

// ─── 2. PID synergy primitives (H_355 / H_619) ───────────────────────────

pub fn hm_pid_synergy(II3: float) -> dict {
    // H_355 sign convention: 3-source (odd parity) McGill 3-variate net
    // interaction information II_3 → synergy / redundancy split:
    //   II_3 > 0  ⇒ synergy = II_3,        redundancy = 0
    //   II_3 < 0  ⇒ synergy = 0,           redundancy = |II_3|
    //   II_3 = 0  ⇒ both = 0 (trivial unique-info)
    // synergy_ratio = synergy_total / (synergy_total + redundancy_total)
    let mut syn = 0.0
    let mut red = 0.0
    if II3 > 0.0 {
        syn = II3
    } else if II3 < 0.0 {
        red = 0.0 - II3
    }
    let total = syn + red
    let mut ratio = 0.0
    if total > 0.0 { ratio = syn / total }
    return #{
        "synergy_total":    syn,
        "redundancy_total": red,
        "synergy_ratio":    ratio,
    }
}

pub fn hm_pid_synergy_ratio(synergy: float, redundancy: float) -> float {
    // Direct ratio computation (caller already has totals across cells).
    // H_355 verbatim: synergy_total / (synergy_total + redundancy_total).
    let total = synergy + redundancy
    if total <= 0.0 { return 0.0 }
    return synergy / total
}

// ─── 3. collective-Φ measurers (H_609 / H_617) ───────────────────────────

pub fn hm_collective_phi_super_additive(phi_a: float, phi_b: float, phi_ab: float) -> float {
    // H_609 verdict-bearing measurement:
    //   Δ = Φ(AB) - (Φ(A) + Φ(B))
    //   Δ > 0 ⇒ super-additive (collective integration emerges)
    //   Δ ≤ 0 ⇒ sub-additive / additive
    return phi_ab - (phi_a + phi_b)
}

pub fn hm_collective_si(phi_a: float, phi_b: float) -> float {
    // H_617 substrate-SI: max(Φ_a, Φ_b) / min(Φ_a, Φ_b).
    // min ≤ 0 → 0.0 safe floor.
    let mut hi = phi_a
    let mut lo = phi_a
    if phi_b > hi { hi = phi_b }
    if phi_b < lo { lo = phi_b }
    if lo <= 0.0 { return 0.0 }
    return hi / lo
}

// ─── 4. E×F cross-link (H_618 / H_619) ───────────────────────────────────

pub fn hm_cross_link_savant_modulation(synergy_ratio_series: list) -> dict {
    // H_619 verdict criteria:
    //   - spread = max - min across I sweep
    //   - monotone = 1 if non-increasing (≤ 1 inversion), 0 else
    //   - modulated = 1 if spread ≥ 0.05, 0 else (H619.1 criterion)
    let mut n = synergy_ratio_series.len()
    if n == 0 {
        return #{ "spread": 0.0, "monotone": 0, "modulated": 0 }
    }
    let mut hi = synergy_ratio_series[0]
    let mut lo = synergy_ratio_series[0]
    let mut i = 1
    while i < n {
        let v = synergy_ratio_series[i]
        if v > hi { hi = v }
        if v < lo { lo = v }
        i = i + 1
    }
    let spread = hi - lo
    // monotone non-increasing check (allow ≤ 1 inversion per H619.2)
    let mut inversions = 0
    let mut j = 1
    while j < n {
        if synergy_ratio_series[j] > synergy_ratio_series[j - 1] {
            inversions = inversions + 1
        }
        j = j + 1
    }
    let mut mono = 0
    if inversions <= 1 { mono = 1 }
    let mut modu = 0
    if spread >= 0.05 { modu = 1 }
    return #{
        "spread":     spread,
        "monotone":   mono,
        "modulated":  modu,
        "inversions": inversions,
    }
}

pub fn hm_gz_inverse_u_collective(phi_series: list, I_grid: list) -> dict {
    // H_618: collective-Φ dΦ/dI peak measurement on hivemind substrate.
    //   Finite difference (central inner, forward/backward at endpoints).
    //   Returns {peak_I, peak_abs_d, delta_from_gz_lower, sign_change_count}.
    //   GZ_LOWER = 0.21231792755821914 (H_348 / sa_gz_lower).
    let mut n = phi_series.len()
    if n < 2 {
        return #{
            "peak_I": 0.0,
            "peak_abs_d": 0.0,
            "delta_from_gz_lower": 1.0,
            "sign_change_count": 0,
        }
    }
    let mut deriv = []
    let mut i = 0
    while i < n {
        let mut d = 0.0
        if i == 0 {
            d = (phi_series[1] - phi_series[0]) / (I_grid[1] - I_grid[0])
        } else if i == n - 1 {
            d = (phi_series[n - 1] - phi_series[n - 2]) / (I_grid[n - 1] - I_grid[n - 2])
        } else {
            d = (phi_series[i + 1] - phi_series[i - 1]) / (I_grid[i + 1] - I_grid[i - 1])
        }
        deriv.push(d)
        i = i + 1
    }
    let mut peak_idx = 0
    let mut peak_abs = -1.0
    let mut k = 0
    while k < n {
        let mut a = deriv[k]
        if a < 0.0 { a = 0.0 - a }
        if a > peak_abs {
            peak_abs = a
            peak_idx = k
        }
        k = k + 1
    }
    let mut sign_changes = 0
    let mut prev_sign = 0
    let mut m = 0
    while m < n {
        let v = deriv[m]
        let mut s = 0
        if v > 0.0 { s = 1 } else { if v < 0.0 { s = -1 } else { s = 0 } }
        if prev_sign != 0 && s != 0 && s != prev_sign {
            sign_changes = sign_changes + 1
        }
        if s != 0 { prev_sign = s }
        m = m + 1
    }
    let peak_I = I_grid[peak_idx]
    let gz_lo  = 0.21231792755821914
    let mut delta = peak_I - gz_lo
    if delta < 0.0 { delta = 0.0 - delta }
    return #{
        "peak_I": peak_I,
        "peak_abs_d": peak_abs,
        "delta_from_gz_lower": delta,
        "sign_change_count": sign_changes,
    }
}
