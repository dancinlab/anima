// BUG 2 reproducer — hexa 0.1.0-dispatch: the parser aborts with
//   "index 0 out of bounds (len 0)"
// on a triple-nested `for` where a `let` declared between the 2nd and 3rd
// loop level is mutated inside the innermost `for` (the matmul accumulator
// shape). `hexa parse` / `hexa build` emit no C. A double-`for`, a flat
// `for`+`if/else`, and 7 sibling for-loop functions ALL parse cleanly, so
// the trigger is this specific nested-for+interleaved-let shape, not loop
// count. Confirmed on linux pool hosts aiden + summer. (C-PORT M3 blocker
// #2 — blocks the i×j×k GEMM reference port.)
fn f(m, n, k) {
    for i in 0..m {
        for j in 0..n {
            let s = 0.0
            for kk in 0..k {
                s = s + 1.0
            }
            println(str(s))
        }
    }
}
fn main() { f(2, 2, 2) }
