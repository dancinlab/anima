// training/build_corpus_diverse_v2.hexa — M4b-fire-rev2 diverse corpus builder
//
// Phase 5b TTR=0.10 FAIL root cause (D3 #1269 finding):
//   corpus_consciousness_v1.jsonl = 240 lines of near-identical templated text
//   (only nonce / gen / chunk_idx varies). Token sequence has trivial repetition
//   → router can't escape collapse no matter how good. D3 production-fix path:
//   diverse Korean QA corpus from corpus_alm_70b.jsonl (90K lines, varied
//   instruction-tuning data — koalpaca, kobest, kobest_copa, ...).
//
// Output: training/corpus_consciousness_v2_diverse.jsonl — N lines each with
//   {"id": "ccv2_<i>", "text": "<user-question> <assistant-answer>"}
//   Matches the shape ccv1 had (single "text" field) so flame_bpe_corpus_load
//   reads it without modification (it concatenates all "text" fields).

fn main() {
    println("=== build_corpus_diverse_v2 — diverse Korean QA from corpus_alm_70b ===")
    let src_path = "/Users/ghost/core/anima/training/corpus_alm_70b.jsonl"
    let out_path = "/Users/ghost/core/anima/training/corpus_consciousness_v2_diverse.jsonl"
    let n_target = 2000
    let min_chars = 150
    let max_chars = 2000

    let raw = read_file(src_path)
    if type_of(raw) != "string" {
        println("FAIL: source file read returned non-string")
        return
    }
    let raw_len = len(raw)
    print("  source: "); print(src_path); print(" bytes="); println(raw_len)

    let lines = raw.split("\n")
    let n_lines = len(lines)
    print("  parsed lines="); println(n_lines)

    let mut parts = []
    let mut n_out = 0
    let mut idx = 0
    let u_anchor = "\"role\":\"user\",\"content\":\""
    let a_anchor = "\"role\":\"assistant\",\"content\":\""
    let user_end_anchor = "\"},{\"role\":\"assistant\""
    let asst_end_anchor = "\"}]"
    let u_anchor_len = len(u_anchor)
    let a_anchor_len = len(a_anchor)

    while idx < n_lines && n_out < n_target {
        let line = lines[idx]
        let u_at = line.index_of(u_anchor)
        let a_at = line.index_of(a_anchor)
        if u_at >= 0 && a_at > u_at {
            let u_start = u_at + u_anchor_len
            let a_start = a_at + a_anchor_len
            // Use .index_of(needle, start) start-offset form (regression T37).
            let u_end = line.index_of(user_end_anchor, u_start)
            let a_end = line.index_of(asst_end_anchor, a_start)
            if u_end > u_start && a_end > a_start {
                let u_txt = line.substring(u_start, u_end)
                let a_txt = line.substring(a_start, a_end)
                let total_chars = len(u_txt) + len(a_txt)
                if total_chars >= min_chars && total_chars <= max_chars {
                    let combined = u_txt + " " + a_txt
                    let id_str = "ccv2_" + to_string(n_out)
                    let out_line = "{\"id\":\"" + id_str + "\",\"text\":\"" + combined + "\"}\n"
                    parts.push(out_line)
                    n_out = n_out + 1
                }
            }
        }
        idx = idx + 1
    }
    let out_str = parts.join("")
    write_file(out_path, out_str)
    print("  out: "); print(out_path); print(" lines="); println(n_out)
    print("BUILD_CORPUS_DIVERSE_V2 DONE n_out="); println(n_out)
}
