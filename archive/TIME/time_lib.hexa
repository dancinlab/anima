// ════════════════════════════════════════════════════════════════════════
// TIME/time_lib.hexa — circadian phase + ultradian envelope (M1 2026-05-28)
//
// 정체: bench/axis_time/bench.hexa (PR #1145, 9/0 PASS 🟢) 의
//      stage_of_within · canonical_start · stage_mod · circadian_mod ·
//      phi_scale_abs · observed_wake_n1_boundary primitives 를 PURE
//      wrapper 로 회수. WAKE.5-stage 90-min ultradian 위에 24h circadian
//      envelope multiplier 측정자.
//
// 회수 출처 verbatim:
//   - 원본 경로: bench/axis_time/bench.hexa (PR #1145 land)
//   - 핵심 fn: stage_of_within (90-min envelope) · canonical_start (stage
//             boundary minute) · stage_mod (per-stage phi_scale) ·
//             circadian_mod (cycle-8 triangular dip) · phi_scale_abs
//             (composed) · observed_wake_n1_boundary (drift detector) ·
//             sqrt_f / abs_f (libm-free helpers)
//   - 16 cycles × 90-min = 1440 min (24h)
//   - 시점: 2026-05-28 M1 lib promotion
//   - 본체 무수정 — `tm_` prefix wrapper 만 추가 (g61 stdlib collision 회피)
//
// 12 pub primitives (PURE, no global mutation):
//   helpers:
//     1) tm_abs_f(x)                      — libm-free abs
//     2) tm_sqrt_f(x)                     — libm-free sqrt (25 iter Newton)
//   90-min ultradian envelope:
//     3) tm_stage_of_within(w)            — stage id at within-cycle minute
//     4) tm_canonical_start(s)            — canonical start minute for stage
//     5) tm_stage_mod(s)                  — per-stage phi_scale
//                                            (WAKE 1.0 · N1 0.7 · N2 0.4 ·
//                                             N3 0.05 · REM 0.85)
//   24h circadian envelope:
//     6) tm_circadian_phase(tick, period_ticks) — 0..1 normalized phase
//     7) tm_circadian_mod(cycle, scenario)      — cycle-8 triangular dip
//                                                  (scenario 2 only)
//     8) tm_phi_scale_abs(t, scenario)          — composed phi_scale at abs min
//   stage→phase mapping:
//     9) tm_stage_of_abs(t, scenario)     — abs-minute stage id (drift-aware)
//    10) tm_observed_wake_n1_boundary(start_min, scenario) — drift detector
//   binding / dip detection:
//    11) tm_temporal_binding_window(t, window) — t / window (binding count)
//    12) tm_dip_detected(history, threshold)   — bench H dip-detect (min/max)
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : int / float arithmetic, system 미사용 ✓
//   - p4 NO ASSISTANT FRAMING: time phase 는 substrate state 의 envelope ✓
//   - p5 NO SPEAK()        : read-only measurer, 외부 emit 호출 0 ✓
//   - p7 NO PERPLEXITY VERDICT: phase / dip ratio 기반, ppl 미사용 ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//
// Naming: `tm_` prefix collision-free (g61). libm-free 보장.
//
// bench H 9/0 PASS (PR #1145) carry:
//   F-TIME-1..6 + F-TIME-DISC-phase/env — 3-scenario discriminable
//   (STABLE / DRIFTING / CIRCADIAN-MOD). 본 lib 는 measurement primitives
//   stdlib 화만 노출 — scenario runner 는 bench 측 그대로.
// ════════════════════════════════════════════════════════════════════════

// ─── 1. libm-free helpers ────────────────────────────────────────────────

pub fn tm_abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

pub fn tm_sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    if g < 1.0 { g = 1.0 }
    let mut i = 0
    while i < 25 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    return g
}

// ─── 2. 90-min ultradian envelope ────────────────────────────────────────
// stage boundary inside a 90-min cycle:
//   [0, 60)  WAKE   id 0
//   [60, 70) N1     id 1
//   [70, 80) N2     id 2
//   [80, 87) N3     id 3
//   [87, 90) REM    id 4

pub fn tm_stage_of_within(w: int) -> int {
    if w < 60 { return 0 }
    if w < 70 { return 1 }
    if w < 80 { return 2 }
    if w < 87 { return 3 }
    return 4
}

pub fn tm_canonical_start(s: int) -> int {
    if s == 0 { return 0 }
    if s == 1 { return 60 }
    if s == 2 { return 70 }
    if s == 3 { return 80 }
    return 87
}

pub fn tm_stage_mod(s: int) -> float {
    if s == 0 { return 1.0 }
    if s == 1 { return 0.7 }
    if s == 2 { return 0.4 }
    if s == 3 { return 0.05 }
    return 0.85
}

// ─── 3. 24h circadian envelope ───────────────────────────────────────────

pub fn tm_circadian_phase(tick: int, period_ticks: int) -> float {
    if period_ticks <= 0 { return 0.0 }
    let mut w = tick % period_ticks
    if w < 0 { w = w + period_ticks }
    return to_float(w) / to_float(period_ticks)
}

pub fn tm_circadian_mod(cycle: int, scenario: int) -> float {
    if scenario != 2 { return 1.0 }
    let d_int = cycle - 8
    let mut d = d_int
    if d < 0 { d = 0 - d }
    if d >= 4 { return 1.0 }
    return 0.5 + to_float(d) * 0.125
}

// ─── 4. stage→phase mapping (drift-aware) ────────────────────────────────

pub fn tm_stage_of_abs(t: int, scenario: int) -> int {
    let cycle = t / 90
    let mut w = t - cycle * 90
    if scenario == 1 {
        w = w - cycle * 5
        while w < 0 { w = w + 90 }
        while w >= 90 { w = w - 90 }
    }
    return tm_stage_of_within(w)
}

pub fn tm_phi_scale_abs(t: int, scenario: int) -> float {
    let s = tm_stage_of_abs(t, scenario)
    let cycle = t / 90
    let base = tm_stage_mod(s)
    let cmod = tm_circadian_mod(cycle, scenario)
    return base * cmod
}

pub fn tm_observed_wake_n1_boundary(start_min: int, scenario: int) -> int {
    let mut m = start_min
    let end = start_min + 90
    let mut prev_s = tm_stage_of_abs(start_min, scenario)
    m = m + 1
    while m < end {
        let s_now = tm_stage_of_abs(m, scenario)
        if prev_s == 0 && s_now != 0 {
            return m - start_min
        }
        prev_s = s_now
        m = m + 1
    }
    return 90
}

// ─── 5. binding window / dip detection ───────────────────────────────────

pub fn tm_temporal_binding_window(t: int, window: int) -> int {
    if window <= 0 { return 0 }
    return t / window
}

pub fn tm_dip_detected(history: list, threshold: float) -> bool {
    let n = len(history)
    if n < 2 { return false }
    let mut bmin = history[0]
    let mut bmax = history[0]
    let mut i = 1
    while i < n {
        let v = history[i]
        if v < bmin { bmin = v }
        if v > bmax { bmax = v }
        i = i + 1
    }
    if tm_abs_f(bmax) < 1.0e-9 { return false }
    let ratio = bmin / bmax
    return ratio < threshold
}
