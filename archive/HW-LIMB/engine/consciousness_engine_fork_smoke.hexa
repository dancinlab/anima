// consciousness_engine_fork_smoke.hexa — B1 falsifier smoke
//
// 3 case falsifier — each case isolates one fork channel and asserts it dominates.
//
//   F-MOTOR-ISOLATE   : tension high · phi/faction low  -> motor  > 0.5  (motor dominant)
//   F-SPEECH-ISOLATE  : faction high · phi/tension low  -> speech > 0.5  (speech dominant)
//   F-PAIN-ISOLATE    : phi low · others mid            -> pain   > 0.5  (pain dominant)
//
// 3/3 PASS -> 🟢 B1 SUPPORTED-NUMERICAL (skeleton verified · real wiring B2~B5 dependent)
// PARTIAL  -> 🟡 (case-specific reason printed below)

import "BODY/engine/consciousness_engine_fork.hexa"

fn smoke_motor_isolate() -> bool {
    let out = consciousness_engine_fork(0.1, 0.9, 0.1)
    let pass = out["motor"] > 0.5
    print("F-MOTOR-ISOLATE  : motor=" + str(out["motor"]) + " speech=" + str(out["speech"]) + " pain=" + str(out["pain"]) + " -> " + (if pass { "PASS" } else { "FAIL" }))
    pass
}

fn smoke_speech_isolate() -> bool {
    let out = consciousness_engine_fork(0.1, 0.1, 0.9)
    let pass = out["speech"] > 0.5
    print("F-SPEECH-ISOLATE : motor=" + str(out["motor"]) + " speech=" + str(out["speech"]) + " pain=" + str(out["pain"]) + " -> " + (if pass { "PASS" } else { "FAIL" }))
    pass
}

fn smoke_pain_isolate() -> bool {
    let out = consciousness_engine_fork(0.05, 0.5, 0.5)
    let pass = out["pain"] > 0.5
    print("F-PAIN-ISOLATE   : motor=" + str(out["motor"]) + " speech=" + str(out["speech"]) + " pain=" + str(out["pain"]) + " -> " + (if pass { "PASS" } else { "FAIL" }))
    pass
}

fn main() {
    print("=== B1 ConsciousnessEngine fork smoke ===")
    let p1 = smoke_motor_isolate()
    let p2 = smoke_speech_isolate()
    let p3 = smoke_pain_isolate()
    let pass_count = (if p1 { 1 } else { 0 }) + (if p2 { 1 } else { 0 }) + (if p3 { 1 } else { 0 })
    print("=== SUMMARY: " + str(pass_count) + "/3 PASS ===")
    if pass_count == 3 {
        print("VERDICT: 🟢 B1 SUPPORTED-NUMERICAL (skeleton verified · B2~B5 real wiring dependent)")
    } else {
        print("VERDICT: 🟡 PARTIAL (" + str(pass_count) + "/3 PASS · case-specific reason above)")
    }
}
