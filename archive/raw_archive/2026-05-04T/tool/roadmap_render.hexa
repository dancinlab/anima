#!hexa strict
// @tool slug=roadmap_render
// @sentinel mk2 raw9 raw10 raw11 raw15 ai-native
// @usage hexa tool/roadmap_render.hexa --format md|text|json [--domain d] [--track t]
// @resolver-bypass safe
//
// tool/roadmap_render.hexa — .roadmap.<domain>.hxc → md/text/json view
//
// Reads HXC (or JSONL fallback if HXC missing) and renders for human/agent.
//
// FORMATS
//   md   — markdown table + per-entry bullet narrative
//   text — fixed-width CLI table
//   json — agent-consumable JSON array (default to stdout)
//
// CROSS-REPO (Option D Hybrid; raw 270/271 ai-native; 2026-05-02)
//   --repo <name|path>  : target repo (e.g. --repo nexus). pwd auto-detect fallback.
//   --all-repos         : render across registry mk2_roadmap=true repos (union output).
//   Domain list discovered dynamically; fallback hardcoded.

let REPO_ROOT_DEFAULT = "/Users/<user>/core/anima"
let DOMAINS_FALLBACK = ["clm", "eeg", "akida", "qrng", "sim", "meta"]
let RESOLVER_PATH = "/Users/<user>/core/anima/tool/_roadmap_repo_resolver.hexa"
let mut DOMAINS = DOMAINS_FALLBACK

fn _sh_quote(s: string) -> string { return "'" + s.replace("'", "'\\''") + "'" }
fn _file_exists(p: string) -> bool { return to_string(exec("test -f " + _sh_quote(p) + " && echo 1 || echo 0")).trim() == "1" }
fn _read_file(p: string) -> string {
    if !_file_exists(p) { return "" }
    return to_string(exec("cat " + _sh_quote(p)))
}

fn _is_comment_or_blank(line: string) -> bool {
    let t = line.trim()
    if len(t) == 0 { return true }
    if t.substring(0, 1) == "#" { return true }
    return false
}

fn _extract_str_field(line: string, field: string) -> string {
    let key = "\"" + field + "\":\""
    let i = line.index_of(key)
    if i < 0 { return "" }
    let start = i + len(key)
    let rest = line.substring(start, len(line))
    let end = rest.index_of("\"")
    if end < 0 { return "" }
    return rest.substring(0, end)
}

fn _arg_value(args: array, flag: string) -> string {
    let mut i = 0
    while i < len(args) {
        if args[i] == flag {
            if i + 1 < len(args) { return args[i + 1] }
        }
        i = i + 1
    }
    return ""
}

fn _pad_right(s: string, n: int) -> string {
    let mut out = s
    while len(out) < n { out = out + " " }
    return out
}

fn collect_entries(repo_root: string, dom_filter: string, tr_filter: string) -> array {
    let mut out = []
    let mut d = 0
    while d < len(DOMAINS) {
        let domain = DOMAINS[d]
        if len(dom_filter) == 0 || dom_filter == domain {
            // Prefer HXC if available
            let hxc = repo_root + "/.roadmap." + domain + ".hxc"
            let src = repo_root + "/.roadmap." + domain
            let p = if _file_exists(hxc) { hxc } else { src }
            let content = _read_file(p)
            let lines = content.split("\n")
            let mut i = 0
            while i < len(lines) {
                let line = lines[i]
                if !_is_comment_or_blank(line) {
                    let tr = _extract_str_field(line, "track")
                    if len(tr_filter) == 0 || tr == tr_filter {
                        out = out.push(line)
                    }
                }
                i = i + 1
            }
        }
        d = d + 1
    }
    return out
}

fn render_json(entries: array) -> string {
    let mut out = "["
    let mut i = 0
    while i < len(entries) {
        if i > 0 { out = out + "," }
        out = out + entries[i]
        i = i + 1
    }
    out = out + "]"
    return out
}

fn render_text(entries: array) -> string {
    let header = _pad_right("ID", 22) + " " + _pad_right("STATUS", 12) + " " + _pad_right("DOMAIN", 8) + " " + "TITLE"
    let mut out = header + "\n" + _pad_right("", 22 + 1 + 12 + 1 + 8 + 1 + 40).replace(" ", "-") + "\n"
    let mut i = 0
    while i < len(entries) {
        let line = entries[i]
        let id = _extract_str_field(line, "id")
        let st = _extract_str_field(line, "status")
        let dom = _extract_str_field(line, "domain")
        let title = _extract_str_field(line, "title")
        out = out + _pad_right(id, 22) + " " + _pad_right(st, 12) + " " + _pad_right(dom, 8) + " " + title + "\n"
        i = i + 1
    }
    return out
}

fn render_md(entries: array) -> string {
    let mut out = "# .roadmap mk2 view\n\n"
    out = out + "| id | domain | status | track | title |\n"
    out = out + "|---|---|---|---|---|\n"
    let mut i = 0
    while i < len(entries) {
        let line = entries[i]
        let id = _extract_str_field(line, "id")
        let dom = _extract_str_field(line, "domain")
        let st = _extract_str_field(line, "status")
        let tr = _extract_str_field(line, "track")
        let title = _extract_str_field(line, "title")
        out = out + "| `" + id + "` | " + dom + " | " + st + " | " + tr + " | " + title + " |\n"
        i = i + 1
    }
    out = out + "\n## Per-entry detail\n\n"
    let mut j = 0
    while j < len(entries) {
        let line = entries[j]
        let id = _extract_str_field(line, "id")
        let why = _extract_str_field(line, "why")
        let cost = _extract_str_field(line, "cost")
        let eff_val = _extract_str_field(line, "effect")
        out = out + "### `" + id + "`\n"
        out = out + "- **why**: " + why + "\n"
        out = out + "- **cost**: " + cost + "  **effect**: " + eff_val + "\n\n"
        j = j + 1
    }
    return out
}

// ─── cross-repo helpers ───────────────────────────────────────

fn _resolver_query(subcmd: string, arg: string) -> string {
    let cmd = "hexa_real " + _sh_quote(RESOLVER_PATH) + " " + subcmd
    let full = if len(arg) > 0 { cmd + " " + _sh_quote(arg) + " 2>/dev/null" } else { cmd + " 2>/dev/null" }
    return to_string(exec(full)).trim()
}

fn _resolver_query2(subcmd: string, flag: string, val: string) -> string {
    let cmd = "hexa_real " + _sh_quote(RESOLVER_PATH) + " " + subcmd + " " + flag + " " + _sh_quote(val) + " 2>/dev/null"
    return to_string(exec(cmd)).trim()
}

fn _resolve_repo_arg(spec: string) -> string {
    if len(spec) == 0 { return "" }
    if spec.substring(0, 1) == "/" { return spec }
    let raw = _resolver_query("resolve-dep", spec + ":")
    if len(raw) > 1 && raw.substring(len(raw) - 1, len(raw)) == "/" {
        return raw.substring(0, len(raw) - 1)
    }
    return raw
}

fn _autodetect_repo_root() -> string {
    let r = _resolver_query("resolve-root", "")
    if len(r) > 0 { return r }
    return REPO_ROOT_DEFAULT
}

fn _parse_str_array(raw: string) -> array {
    let mut out = []
    if len(raw) < 3 { return out }
    if raw.substring(0, 1) != "[" { return out }
    let inner = raw.substring(1, len(raw) - 1)
    if len(inner) == 0 { return out }
    let parts = inner.split(",")
    let mut i = 0
    while i < len(parts) {
        let s = parts[i].trim()
        if len(s) >= 2 && s.substring(0, 1) == "\"" {
            let stripped = s.substring(1, len(s) - 1)
            if len(stripped) > 0 { out = out.push(stripped) }
        }
        i = i + 1
    }
    return out
}

fn _discover_domains(repo: string) -> array {
    return _parse_str_array(_resolver_query2("list-domains", "--repo", repo))
}

fn _all_mk2_repos() -> array {
    return _parse_str_array(_resolver_query("list-mk2", ""))
}

fn _arg_present(arr: array, flag: string) -> bool {
    let mut i = 0
    while i < len(arr) {
        if arr[i] == flag { return true }
        i = i + 1
    }
    return false
}

let _argv = args()
let mut _rest = []
let mut _i = 2
while _i < len(_argv) {
    _rest = _rest.push(to_string(_argv[_i]))
    _i = _i + 1
}
let _fmt = if len(_arg_value(_rest, "--format")) > 0 { _arg_value(_rest, "--format") } else { "json" }
let _dom = _arg_value(_rest, "--domain")
let _tr = _arg_value(_rest, "--track")
let _all_repos = _arg_present(_rest, "--all-repos")
let _repo_arg = _arg_value(_rest, "--repo")

// Determine repo set
let mut _repos = []
if _all_repos {
    _repos = _all_mk2_repos()
} else {
    let mut _r = REPO_ROOT_DEFAULT
    if len(_repo_arg) > 0 {
        let rr = _resolve_repo_arg(_repo_arg)
        _r = if len(rr) > 0 { rr } else { _repo_arg }
    } else {
        _r = _autodetect_repo_root()
    }
    _repos = [_r]
}

// Collect entries across all repos in scope
let mut _all_entries = []
let mut _ri = 0
while _ri < len(_repos) {
    let dd = _discover_domains(_repos[_ri])
    DOMAINS = if len(dd) > 0 { dd } else { DOMAINS_FALLBACK }
    let part = collect_entries(_repos[_ri], _dom, _tr)
    let mut pi = 0
    while pi < len(part) {
        _all_entries = _all_entries.push(part[pi])
        pi = pi + 1
    }
    _ri = _ri + 1
}

if _fmt == "json" {
    println(render_json(_all_entries))
} else if _fmt == "text" {
    print(render_text(_all_entries))
} else if _fmt == "md" {
    print(render_md(_all_entries))
} else {
    println("{\"error\":\"unknown format\",\"got\":\"" + _fmt + "\",\"valid\":[\"json\",\"text\",\"md\"]}")
    exit(1)
}
exit(0)
