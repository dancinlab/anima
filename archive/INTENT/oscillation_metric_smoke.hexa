// ════════════════════════════════════════════════════════════════════════
// INTENT/oscillation_metric_smoke.hexa — OSCILLATING fix invariant smoke
//
// 정체: INTENT/oscillation_metric.hexa 의 5 pub primitives invariant 검증.
//      M4 의 critical claim — OSCILLATING direction_std > 0 (bench D 의
//      stability_std=0 artifact 의 honest fix) 을 in-test 로 보여준다.
//
// Invariants (6):
//   I1: CONVERGENT scenario — 4-D vector const → direction_std ≈ 0
//   I2: RANDOM scenario — uncorrelated 4-D → direction_std 큰 값 (> 0.05)
//   I3: OSCILLATING scenario (period-4) — direction_std > 0
//        (legacy stability_std=0 fix)
//   I4: om_period_detect 의 period-4 trajectory → return 4
//   I5: om_residual_verdict 가 5 key 출력 (stability_std·direction_std·
//        period_detected·verdict_code·verdict_label)
//   I6: om_classify boundary — stability_std<0.05 && direction_std<0.05 →
//        "CONVERGENT"; OSCILLATING period>0 && direction_std>0.05 → label
// ════════════════════════════════════════════════════════════════════════

use "INTENT/oscillation_metric"
use "INTENT/intent_lib"

fn absf(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() {
    println("=== INTENT/oscillation_metric_smoke ===")

    // ─── I1 CONVERGENT (const direction) ────────────────────────────────
    let mut conv_traj = []
    let mut i = 0
    while i < 12 {
        conv_traj.push([1.0, 0.0, 0.0, 0.0])
        i = i + 1
    }
    let d_conv = om_direction_std(conv_traj)
    let i1 = d_conv < 0.05

    // ─── I2 RANDOM-like (alternating sign 4-D drift) ────────────────────
    let mut rand_traj = []
    let mut k = 0
    while k < 12 {
        // pseudo-random direction via different orthogonal axes
        let m = k % 4
        if m == 0 { rand_traj.push([1.0, 0.0, 0.0, 0.0]) }
        if m == 1 { rand_traj.push([0.0, 1.0, 0.0, 0.0]) }
        if m == 2 { rand_traj.push([0.0, 0.0, 1.0, 0.0]) }
        if m == 3 { rand_traj.push([0.0, 0.0, 0.0, 1.0]) }
        k = k + 1
    }
    let d_rand = om_direction_std(rand_traj)
    let i2 = d_rand > 0.05

    // ─── I3 OSCILLATING period-4 (the bench D fix target) ──────────────
    // sequence cycles through 4 distinct directions deterministically.
    // legacy stability_std (cos-sim std) ≈ 0 (cos-sim is periodic 0/1).
    // direction_std (component variance) > 0 ← honest fix.
    let mut osc_traj = []
    let mut j = 0
    while j < 16 {
        let m = j % 4
        if m == 0 { osc_traj.push([1.0, 0.0, 0.0, 0.0]) }
        if m == 1 { osc_traj.push([0.0, 1.0, 0.0, 0.0]) }
        if m == 2 { osc_traj.push([0.0, 0.0, 1.0, 0.0]) }
        if m == 3 { osc_traj.push([0.0, 0.0, 0.0, 1.0]) }
        j = j + 1
    }
    let d_osc = om_direction_std(osc_traj)
    let i3 = d_osc > 0.0

    // ─── I4 om_period_detect period-4 ───────────────────────────────────
    // component 0 sequence: 1,0,0,0,1,0,0,0,... period=4.
    let period = om_period_detect(osc_traj, 25)
    let i4 = period == 4

    // ─── I5 residual_verdict 5 keys ─────────────────────────────────────
    let v = om_residual_verdict(osc_traj)
    let has_sstd = v["stability_std"]    != void
    let has_dstd = v["direction_std"]    != void
    let has_per  = v["period_detected"]  != void
    let has_code = v["verdict_code"]     != void
    let has_lab  = v["verdict_label"]    != void
    let i5 = has_sstd && has_dstd && has_per && has_code && has_lab

    // ─── I6 classify CONVERGENT ─────────────────────────────────────────
    let lab_conv = om_classify(0.0, 0.0, 0)
    let lab_osc  = om_classify(0.0, 0.5, 4)
    let i6 = lab_conv == "CONVERGENT" && lab_osc == "OSCILLATING"

    println("I1  CONVERGENT direction_std ≈0   " + (if i1 { "PASS (" + str(d_conv) + ")" } else { "FAIL" }))
    println("I2  RANDOM direction_std >0.05    " + (if i2 { "PASS (" + str(d_rand) + ")" } else { "FAIL" }))
    println("I3  OSCILLATING direction_std >0  " + (if i3 { "PASS (" + str(d_osc) + ")" } else { "FAIL (legacy artifact!)" }))
    println("I4  period_detect P=4             " + (if i4 { "PASS" } else { "FAIL (got " + str(period) + ")" }))
    println("I5  residual_verdict 5 keys       " + (if i5 { "PASS" } else { "FAIL" }))
    println("I6  classify CONVERGENT+OSCILLATING " + (if i6 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (6/6) — bench D OSCILLATING std=0 artifact 폐기" } else { "INVARIANT FAILURE" })
}
