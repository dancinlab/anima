// ════════════════════════════════════════════════════════════════════════
// INTENT/intent_lib.hexa — cumulative intent vector + decay window (M1 2026-05-28)
//
// 정체: bench/axis_intent/bench.hexa (PR #1143, 4/5 falsifier 🟠 PARTIAL) 의
//      cumulative_intent + window_mean_dir + monotone_ratio + stability_std
//      primitives 를 PURE wrapper 로 회수. brain_decide(short-term emit) 위의
//      long-term goal formation layer.
//
// 회수 출처 verbatim:
//   - 원본 경로: bench/axis_intent/bench.hexa (PR #1143 land)
//   - 핵심 fn: cumulative_intent (running mean) · window_mean_dir (10-tick) ·
//             monotone_ratio (magnitude monotonicity) · stability_std (std of
//             consecutive window cos-sim) · normalize4 · sqrt_newton (libm-free)
//   - 4-D vector, N=100 ticks
//   - 시점: 2026-05-28 M1 lib promotion
//   - 본체 무수정 — `it_` prefix wrapper 만 추가 (g61 stdlib collision 회피)
//
// 12 pub primitives (PURE, no global mutation):
//   helpers:
//     1) it_sqrt_newton(x)                — libm-free sqrt (30 iter)
//     2) it_normalize4(a0,a1,a2,a3)       — unit 4-D vector (eps guarded)
//     3) it_norm4(a0,a1,a2,a3)            — ‖[a0,a1,a2,a3]‖
//   running mean / cumulative:
//     4) it_cumulative_mean_4d(s0,s1,s2,s3,n) — Σ/n (returns 4-tuple as list)
//     5) it_cumulative_magnitude_4d(s0,s1,s2,s3,n) — ‖(1/n)·Σ‖
//   stability metric:
//     6) it_cos_sim_4d(a, b)              — cos similarity of two 4-D unit vectors
//     7) it_mean_f(xs)                    — list mean (float)
//     8) it_std_f(xs)                     — list std (population)
//     9) it_stability_std(cosines)        — std of consecutive window cos-sim
//   monotone:
//    10) it_monotone_ratio(mag_traj)      — fraction of t where mag[t] >= mag[t-1]
//   decay window (M3 hint):
//    11) it_decay_weight(t, half_life)    — exp-decay proxy (libm-free 1/(1+t/h))
//    12) it_decayed_sum(values, half_life) — Σ values[i] · it_decay_weight(i, half_life)
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : 4-D float arithmetic, system 미사용 ✓
//   - p4 NO ASSISTANT FRAMING: intent vector 는 substrate state 의 cumulative ✓
//   - p5 NO SPEAK()        : read-only measurer, 외부 emit 호출 0 ✓
//   - p7 NO PERPLEXITY VERDICT: magnitude / cos-sim 기반, ppl 미사용 ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//
// Naming: `it_` prefix collision-free (g61). libm-free 보장.
//
// Honest framing — OSCILLATING residual:
//   bench D 의 period-4 (변형: period-20) zero-std artifact (OSCILLATING
//   scenario std=0 관측) 는 stability_std metric ≠ direction std 의 root
//   cause. 본 lib 는 stability_std 만 노출 — 재설계 (alternative metric) 는
//   INTENT.md M4 carry. carry-over: OSCILLATING 의 cos-sim 이 sub-period 의
//   integer 윈도우에서 deterministically equal 해지므로 std=0.
// ════════════════════════════════════════════════════════════════════════

// ─── 1. libm-free helpers ────────────────────────────────────────────────

pub fn it_sqrt_newton(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut s = x
    if s > 1.0 { s = x }
    if s < 1.0 { s = 1.0 }
    let mut k = 0
    while k < 30 {
        s = 0.5 * (s + x / s)
        k = k + 1
    }
    return s
}

pub fn it_norm4(a0: float, a1: float, a2: float, a3: float) -> float {
    return it_sqrt_newton(a0*a0 + a1*a1 + a2*a2 + a3*a3)
}

pub fn it_normalize4(a0: float, a1: float, a2: float, a3: float) -> list {
    let n2 = a0*a0 + a1*a1 + a2*a2 + a3*a3
    let mut n = it_sqrt_newton(n2)
    if n < 1.0e-9 { n = 1.0 }
    let v = [a0/n, a1/n, a2/n, a3/n]
    return v
}

// ─── 2. running mean / cumulative ────────────────────────────────────────

pub fn it_cumulative_mean_4d(s0: float, s1: float, s2: float, s3: float, n: int) -> list {
    if n <= 0 { return [0.0, 0.0, 0.0, 0.0] }
    let d = float(n)
    return [s0/d, s1/d, s2/d, s3/d]
}

pub fn it_cumulative_magnitude_4d(s0: float, s1: float, s2: float, s3: float, n: int) -> float {
    if n <= 0 { return 0.0 }
    let d = float(n)
    let m0 = s0 / d
    let m1 = s1 / d
    let m2 = s2 / d
    let m3 = s3 / d
    return it_norm4(m0, m1, m2, m3)
}

// ─── 3. stability metric ─────────────────────────────────────────────────

pub fn it_cos_sim_4d(a: list, b: list) -> float {
    return a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3]
}

pub fn it_mean_f(xs: list) -> float {
    let n = xs.len()
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / float(n)
}

pub fn it_std_f(xs: list) -> float {
    let n = xs.len()
    if n == 0 { return 0.0 }
    let mu = it_mean_f(xs)
    let mut v = 0.0
    let mut i = 0
    while i < n {
        let d = xs[i] - mu
        v = v + d * d
        i = i + 1
    }
    return it_sqrt_newton(v / float(n))
}

pub fn it_stability_std(cosines: list) -> float {
    return it_std_f(cosines)
}

// ─── 4. monotone ratio ───────────────────────────────────────────────────

pub fn it_monotone_ratio(mag_traj: list) -> float {
    let n = mag_traj.len()
    if n < 2 { return 0.0 }
    let mut up = 0
    let mut t = 1
    while t < n {
        if mag_traj[t] >= mag_traj[t - 1] { up = up + 1 }
        t = t + 1
    }
    return float(up) / float(n - 1)
}

// ─── 5. decay window (M3 carry hint) ─────────────────────────────────────
//
// libm-free decay proxy: weight(t) = 1 / (1 + t / half_life). Replaces
// exp-decay 의 simpler positive monotone-decreasing kernel (substrate
// cumulative intent 의 short-term ↔ long-term blend 에 사용).

pub fn it_decay_weight(t: int, half_life: float) -> float {
    if half_life <= 0.0 { return 1.0 }
    let denom = 1.0 + float(t) / half_life
    return 1.0 / denom
}

pub fn it_decayed_sum(values: list, half_life: float) -> float {
    let n = values.len()
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + values[i] * it_decay_weight(i, half_life)
        i = i + 1
    }
    return s
}
