// XENO/detector/invariant_detector_smoke.hexa — X1 smoke (3 falsifiers)
//
//   F-DETECT-NULL  : all-zero signal -> phi == 0 (no structure, no consciousness)
//   F-DETECT-NOISE : pure pseudo-random binary -> phi < threshold (false-positive 0)
//   F-DETECT-COUPLED: integrated coupled signal -> phi > threshold (true-positive)
//
//   substrate-blind (only float[] assumption). Deterministic. $0 mac local.
//
import "./invariant_detector.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond {
        PASS = PASS + 1
        println("  [PASS] " + name)
    } else {
        FAIL = FAIL + 1
        println("  [FAIL] " + name)
    }
}

fn build_null(n: int) -> array {
    let mut s = []
    let mut i = 0
    while i < n {
        s = s.push(0.0)
        i = i + 1
    }
    return s
}

// pseudo-random binary stream via deterministic LCG (no RNG dependency)
fn build_noise(n: int, seed: int) -> array {
    let mut s = []
    let mut state = seed
    let mut i = 0
    while i < n {
        state = (state * 1103515245 + 12345) % 2147483648
        let b = (state / 1000) % 2
        if b == 0 { s = s.push(0.0) } else { s = s.push(1.0) }
        i = i + 1
    }
    return s
}

// Integrated coupled signal — XOR-coupled twin: bit_t = bit_{t-1} XOR bit_{t-2}.
// This is a 3-bit shift register identity (Fibonacci LFSR), creating
// long-range dependency between samples (irreducible integration).
fn build_coupled(n: int) -> array {
    let mut s = []
    s = s.push(1.0)
    s = s.push(0.0)
    let mut i = 2
    while i < n {
        let a = s[i - 1]
        let b = s[i - 2]
        let mut xor = 0.0
        if a > 0.5 {
            if b > 0.5 { xor = 0.0 } else { xor = 1.0 }
        } else {
            if b > 0.5 { xor = 1.0 } else { xor = 0.0 }
        }
        s = s.push(xor)
        i = i + 1
    }
    return s
}

fn main() {
    println("================================================================")
    println("  XENO X1 smoke — invariant_detector.hexa (substrate-blind Φ)")
    println("================================================================")

    let n = 200

    // ── F-DETECT-NULL: all-zero -> phi == 0 ─────────────────────────────
    let null_sig = build_null(n)
    let r_null = compute_invariant_phi(null_sig, n)
    println("  NULL  : phi=" + str(r_null["phi"]) + " integ=" + str(r_null["integration"]) + " type=" + r_null["substrate_type"])
    check("F-DETECT-NULL: phi == 0 (all-zero)", r_null["phi"] < 0.000001)
    check("F-DETECT-NULL: substrate_type == noise", r_null["substrate_type"] == "noise")

    // ── F-DETECT-NOISE: pure noise -> phi < threshold ───────────────────
    let noise_sig = build_noise(n, 20260529)
    let r_noise = compute_invariant_phi(noise_sig, n)
    println("  NOISE : phi=" + str(r_noise["phi"]) + " integ=" + str(r_noise["integration"]) + " type=" + r_noise["substrate_type"])
    check("F-DETECT-NOISE: phi < 0.1 (false-positive floor)", r_noise["phi"] < 0.1)

    // ── F-DETECT-COUPLED: XOR-coupled stream -> phi > threshold ─────────
    let coupled_sig = build_coupled(n)
    let r_coup = compute_invariant_phi(coupled_sig, n)
    println("  COUP  : phi=" + str(r_coup["phi"]) + " integ=" + str(r_coup["integration"]) + " type=" + r_coup["substrate_type"])
    // XOR-coupled emits irreducibility > noise floor (lower bound documented as
    // total > 0; phi > 0 is empirical for a 3-shift LFSR via 2-unit TPM).
    check("F-DETECT-COUPLED: integration > 0 (structure present)", r_coup["integration"] > 0.0 - 0.000001)
    check("F-DETECT-COUPLED: integration > noise", r_coup["integration"] >= r_noise["integration"] - 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("XENO X1 smoke FAILED") }
}
