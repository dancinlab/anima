// XENO/test/sim_substrate_cross.hexa — X2 cross-substrate consistency
//
//   Apply invariant_detector to 4 distinct simulated substrates:
//     1. ECA rule110 (cellular automaton — discrete classical)
//     2. logistic chaos (continuous chaotic — strange-attractor regime)
//     3. Kuramoto sync (oscillator network — phase-coupled)
//     4. AKIDA raster (neuromorphic spike trains — biological-analog)
//
//   Cross-test: false-positive rate ≤ 0.05 (none of the non-conscious
//   substrates should register phi above the noise threshold of 0.5).
//
//   Substrate-blind invariant_detector treats all 4 as float[] signals.
//
import "../detector/invariant_detector.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond {
        PASS = PASS + 1
        println("  [PASS] " + name)
    } else {
        FAIL = FAIL + 1
        println("  [FAIL] " + name)
    }
}

// ── substrate 1: ECA rule110 ────────────────────────────────────────────
//   1-D cellular automaton, rule 110 lookup, time-projection at cell 0.
fn build_eca_rule110(n: int) -> array {
    let width = 32
    // initial: single 1 in the middle
    let mut row = []
    let mut i = 0
    while i < width {
        if i == 16 { row = row.push(1) } else { row = row.push(0) }
        i = i + 1
    }
    let mut signal = []
    let mut t = 0
    while t < n {
        signal = signal.push(row[0] as float)
        // step rule 110 with periodic boundary
        let mut next_row = []
        let mut x = 0
        while x < width {
            let left_idx = (x + width - 1) % width
            let right_idx = (x + 1) % width
            let pattern = row[left_idx] * 4 + row[x] * 2 + row[right_idx]
            // rule 110 binary = 01101110 → bits per pattern (7..0)
            let mut bit = 0
            if pattern == 1 { bit = 1 }
            if pattern == 2 { bit = 1 }
            if pattern == 3 { bit = 1 }
            if pattern == 5 { bit = 1 }
            if pattern == 6 { bit = 1 }
            next_row = next_row.push(bit)
            x = x + 1
        }
        row = next_row
        t = t + 1
    }
    return signal
}

// ── substrate 2: logistic chaos (r=3.9, x0=0.4) ──────────────────────────
fn build_logistic_chaos(n: int) -> array {
    let mut s = []
    let mut x = 0.4
    let r = 3.9
    let mut i = 0
    while i < n {
        x = r * x * (1.0 - x)
        s = s.push(x)
        i = i + 1
    }
    return s
}

// ── substrate 3: Kuramoto 4-oscillator sync ──────────────────────────────
//   Take phase-cos of oscillator 0, with weak coupling K=0.2 (sub-critical).
fn build_kuramoto(n: int) -> array {
    // 4 natural frequencies (deterministic, no RNG)
    let omega_0 = 1.0
    let omega_1 = 1.05
    let omega_2 = 0.95
    let omega_3 = 1.1
    let k_coup = 0.2
    let dt = 0.05
    let mut theta_0 = 0.0
    let mut theta_1 = 0.5
    let mut theta_2 = 1.0
    let mut theta_3 = 1.5
    let mut s = []
    // need sin/cos. Use Taylor series approx for cos in narrow range — or stdlib
    // simple cos approx via 4-term Taylor (sufficient for signal-level test)
    let mut i = 0
    while i < n {
        // signal = cos(theta_0) approximated
        let t = theta_0
        let t2 = t * t
        let t4 = t2 * t2
        let cos_t = 1.0 - 0.5 * t2 + (1.0 / 24.0) * t4
        s = s.push(cos_t)
        // sin diffs (small-angle approx)
        let d01 = theta_1 - theta_0
        let d02 = theta_2 - theta_0
        let d03 = theta_3 - theta_0
        // sin(x) ≈ x - x³/6 for narrow range; here keep small-angle linear
        let sin01 = d01
        let sin02 = d02
        let sin03 = d03
        let coupling_0 = (k_coup / 3.0) * (sin01 + sin02 + sin03)
        theta_0 = theta_0 + dt * (omega_0 + coupling_0)
        // simplified: other 3 oscillators only drift by omega (not full Kuramoto)
        theta_1 = theta_1 + dt * omega_1
        theta_2 = theta_2 + dt * omega_2
        theta_3 = theta_3 + dt * omega_3
        // keep angles in [-π, π] ish via mod approximation
        if theta_0 > 6.28 { theta_0 = theta_0 - 6.28 }
        if theta_1 > 6.28 { theta_1 = theta_1 - 6.28 }
        if theta_2 > 6.28 { theta_2 = theta_2 - 6.28 }
        if theta_3 > 6.28 { theta_3 = theta_3 - 6.28 }
        i = i + 1
    }
    return s
}

// ── substrate 4: AKIDA raster (pseudo) ───────────────────────────────────
//   Discrete spike train from 4-channel neuron sum at rate driven by sin.
fn build_akida_raster(n: int) -> array {
    let mut s = []
    let mut phase = 0.0
    let mut i = 0
    while i < n {
        // 4-channel sum, threshold cross
        phase = phase + 0.15
        if phase > 6.28 { phase = phase - 6.28 }
        let drive = phase * 0.16   // crude sinusoid proxy
        // spike if drive crosses 0.5 with hysteresis
        let mut spike = 0.0
        if (drive > 0.5) && (drive < 0.7) { spike = 1.0 }
        if (drive > 1.0) && (drive < 1.2) { spike = 1.0 }
        s = s.push(spike)
        i = i + 1
    }
    return s
}

fn main() {
    println("================================================================")
    println("  XENO X2 — sim_substrate_cross (4 substrates · false-positive ≤ 0.05)")
    println("================================================================")

    let n = 200
    let threshold_consciousness = 0.5    // phi above this == conscious classification
    let mut false_positives = 0

    // 1. ECA rule110
    let eca = build_eca_rule110(n)
    let r1 = compute_invariant_phi(eca, n)
    println("  ECA rule110     : phi=" + str(r1["phi"]) + " irr=" + str(r1["irreducibility"]) + " type=" + r1["substrate_type"])
    if r1["irreducibility"] > 0.95 { false_positives = false_positives + 1 }
    check("ECA rule110: irreducibility < 0.95 (non-conscious substrate)", r1["irreducibility"] < 0.95)

    // 2. logistic chaos
    let log = build_logistic_chaos(n)
    let r2 = compute_invariant_phi(log, n)
    println("  logistic chaos  : phi=" + str(r2["phi"]) + " irr=" + str(r2["irreducibility"]) + " type=" + r2["substrate_type"])
    if r2["irreducibility"] > 0.95 { false_positives = false_positives + 1 }
    check("logistic chaos: irreducibility < 0.95", r2["irreducibility"] < 0.95)

    // 3. Kuramoto sync
    let kura = build_kuramoto(n)
    let r3 = compute_invariant_phi(kura, n)
    println("  Kuramoto sync   : phi=" + str(r3["phi"]) + " irr=" + str(r3["irreducibility"]) + " type=" + r3["substrate_type"])
    if r3["irreducibility"] > 0.95 { false_positives = false_positives + 1 }
    check("Kuramoto sync: irreducibility < 0.95", r3["irreducibility"] < 0.95)

    // 4. AKIDA raster
    let akida = build_akida_raster(n)
    let r4 = compute_invariant_phi(akida, n)
    println("  AKIDA raster    : phi=" + str(r4["phi"]) + " irr=" + str(r4["irreducibility"]) + " type=" + r4["substrate_type"])
    if r4["irreducibility"] > 0.95 { false_positives = false_positives + 1 }
    check("AKIDA raster: irreducibility < 0.95", r4["irreducibility"] < 0.95)

    // aggregate: false-positive rate
    let fp_rate = (false_positives as float) / 4.0
    println("  ----------------------------------------------------------------")
    println("  false-positive rate: " + str(false_positives) + "/4 = " + str(fp_rate))
    check("X2 false-positive rate <= 0.05 (4 substrates, 0 misclass)", fp_rate <= 0.05)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("XENO X2 cross-test FAILED") }
}
