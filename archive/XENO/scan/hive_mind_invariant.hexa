// XENO/scan/hive_mind_invariant.hexa — X10 hive-mind invariant detector
//
//   Apply invariant_detector to 4 multi-cell substrates spanning the
//   hive-mind axis (IIT4 integration axiom test: 통합 > 분리):
//
//     a. independent 4-cell      (4 independent LCG random walkers concat,
//                                  no inter-cell coupling, n=128 total)
//     b. weak coupled 4-cell     (each cell next = 50% self + 50% mean,
//                                  mild mean-field sync, n=128 total)
//     c. strong coupled 4-cell   (Kuramoto-like all-to-all phase sync,
//                                  high coherence, n=128 total)
//     d. hive emergence 4-cell   (full XOR cascade: cell_i = cell_{i-1}
//                                  XOR cell_{i+1} + 1-lag carry, n=128)
//
//   Each substrate = 4 cell × 32 sample/cell concat -> n=128 (X7-aligned
//   dense regime). cell-density mean ≥ 60% guaranteed (paper #1411 regime).
//
//   Pre-registered falsifiers (post-tuning 0, X7 baseline aligned):
//
//     F-X10-INDEP    : independent 4-cell phi < 0.3
//                       (separable random walkers = noise floor)
//     F-X10-WEAK     : weak coupled phi < 0.5
//                       (mild mean-field sync = not yet integrated)
//     F-X10-STRONG   : strong coupled phi ≥ 0.5
//                       (Kuramoto sync = integrated substrate)
//     F-X10-HIVE     : hive emergence phi ≥ 0.5
//                       (XOR cascade = irreducible)
//     F-X10-MONOTONE : indep < weak ≤ strong ≤ hive
//                       (Φ monotone w/ coupling strength)
//
//   pass 4/5 + monotone => 🟢 SUPPORTED-NUMERICAL (hive-mind axis 측정 가능)
//   pass 3/5            => 🟡 PARTIAL-SUPPORT     (border, applicability frontier)
//   pass < 3/5          => 🔴 FALSIFIED-INSTRUMENT (regime 한계, 정직 보고)
//
//   Honesty (a_blue_closed): thresholds frozen pre-run, verbatim detector out.
//   p7 = 0 (no LLM judge). a_completeness_over_cheap: hardcoded literal (no
//   hexa native h5/npy/json reader). a_fire_autonomous (no GPU): Mac local $0.
//
import "../detector/invariant_detector.hexa"

// build 32-sample independent LCG random walker on a fresh seed
fn indep_cell(seed: int) -> array {
    let mut s = []
    let mut st = seed
    let mut i = 0
    while i < 32 {
        st = (st * 1103515245 + 12345) % 2147483648
        // bias to ~60% ones (X7-aligned dense regime) via uneven threshold
        let r = (st / 1000) % 100
        if r < 60 { s = s.push(1.0) } else { s = s.push(0.0) }
        i = i + 1
    }
    return s
}

// weak-coupled cell: each step = 0.5 * self_prev + 0.5 * mean_of_4_prev
// implemented as 32 timesteps × 4 cells, then flatten cell-major (concat)
fn weak_coupled() -> array {
    // initial state of 4 cells (seeded)
    let mut c0 = 1.0
    let mut c1 = 0.0
    let mut c2 = 1.0
    let mut c3 = 0.0
    let mut hist0 = []
    let mut hist1 = []
    let mut hist2 = []
    let mut hist3 = []
    let mut t = 0
    let mut st = 20260529
    while t < 32 {
        hist0 = hist0.push(c0)
        hist1 = hist1.push(c1)
        hist2 = hist2.push(c2)
        hist3 = hist3.push(c3)
        let mean = (c0 + c1 + c2 + c3) / 4.0
        // mild noise per cell to avoid trivial fixed point
        st = (st * 1103515245 + 12345) % 2147483648
        let n0 = ((st / 1000) % 100) as float / 100.0
        st = (st * 1103515245 + 12345) % 2147483648
        let n1 = ((st / 1000) % 100) as float / 100.0
        st = (st * 1103515245 + 12345) % 2147483648
        let n2 = ((st / 1000) % 100) as float / 100.0
        st = (st * 1103515245 + 12345) % 2147483648
        let n3 = ((st / 1000) % 100) as float / 100.0
        // binarize: 0.5 self + 0.5 mean + small noise > 0.5 -> 1
        let v0 = 0.5 * c0 + 0.5 * mean + (n0 - 0.5) * 0.1
        let v1 = 0.5 * c1 + 0.5 * mean + (n1 - 0.5) * 0.1
        let v2 = 0.5 * c2 + 0.5 * mean + (n2 - 0.5) * 0.1
        let v3 = 0.5 * c3 + 0.5 * mean + (n3 - 0.5) * 0.1
        if v0 >= 0.5 { c0 = 1.0 } else { c0 = 0.0 }
        if v1 >= 0.5 { c1 = 1.0 } else { c1 = 0.0 }
        if v2 >= 0.5 { c2 = 1.0 } else { c2 = 0.0 }
        if v3 >= 0.5 { c3 = 1.0 } else { c3 = 0.0 }
        t = t + 1
    }
    // concat cell-major: cell0[0..32] + cell1[0..32] + cell2[0..32] + cell3[0..32]
    let mut out = []
    let mut i = 0
    while i < 32 { out = out.push(hist0[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist1[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist2[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist3[i]); i = i + 1 }
    return out
}

// strong-coupled 4-cell: Kuramoto-like all-to-all sync.
// Each cell maintains phase θ ∈ [0, 2π); θ_i(t+1) = θ_i(t) + dt*(ω_i + K*Σ sin(θ_j - θ_i)/N).
// We emit sign(cos θ) per timestep, ≈ 60% ones via baseline ω bias.
// Coupling K = 2.0 (strong) ensures phase-lock within ~10 steps.
fn strong_coupled() -> array {
    // 4 cells × 32 timesteps. Use scaled int phases (×1000) to avoid float drift.
    // ω_i in [0.5, 0.7] (close, syncable). Emit 1 when phase in upper half-cycle.
    let mut p0 = 0.0
    let mut p1 = 1000.0
    let mut p2 = 2000.0
    let mut p3 = 3000.0
    let w0 = 540.0
    let w1 = 580.0
    let w2 = 620.0
    let w3 = 660.0
    let two_pi = 6283.0
    let K = 200.0  // coupling strength
    let mut hist0 = []
    let mut hist1 = []
    let mut hist2 = []
    let mut hist3 = []
    let mut t = 0
    while t < 32 {
        // emit: bias to 1 (X7-aligned ~60% ones) via cos approx
        // use phase mod two_pi; if in [0, 2*two_pi/3] emit 1 else 0 (66% bias)
        let m0 = ((p0 as int) % (two_pi as int)) as float
        let m1 = ((p1 as int) % (two_pi as int)) as float
        let m2 = ((p2 as int) % (two_pi as int)) as float
        let m3 = ((p3 as int) % (two_pi as int)) as float
        let thresh = two_pi * 0.6
        if m0 < thresh { hist0 = hist0.push(1.0) } else { hist0 = hist0.push(0.0) }
        if m1 < thresh { hist1 = hist1.push(1.0) } else { hist1 = hist1.push(0.0) }
        if m2 < thresh { hist2 = hist2.push(1.0) } else { hist2 = hist2.push(0.0) }
        if m3 < thresh { hist3 = hist3.push(1.0) } else { hist3 = hist3.push(0.0) }
        // Kuramoto-like: phase_i += ω_i + K * (mean_phase - phase_i) / N
        let mean_p = (p0 + p1 + p2 + p3) / 4.0
        p0 = p0 + w0 + K * (mean_p - p0) / 1000.0
        p1 = p1 + w1 + K * (mean_p - p1) / 1000.0
        p2 = p2 + w2 + K * (mean_p - p2) / 1000.0
        p3 = p3 + w3 + K * (mean_p - p3) / 1000.0
        t = t + 1
    }
    let mut out = []
    let mut i = 0
    while i < 32 { out = out.push(hist0[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist1[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist2[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist3[i]); i = i + 1 }
    return out
}

// hive emergence — XOR cascade: cell_i(t+1) = cell_{i-1}(t) XOR cell_{i+1}(t)
// with 1-lag carry. Wrap-around (cyclic). Irreducible by construction
// (every cell depends on multiple neighbors over time).
fn hive_emergence() -> array {
    let mut c0 = 1.0
    let mut c1 = 0.0
    let mut c2 = 1.0
    let mut c3 = 1.0  // bias initial ones-density
    let mut carry = 1.0
    let mut hist0 = []
    let mut hist1 = []
    let mut hist2 = []
    let mut hist3 = []
    let mut t = 0
    while t < 32 {
        hist0 = hist0.push(c0)
        hist1 = hist1.push(c1)
        hist2 = hist2.push(c2)
        hist3 = hist3.push(c3)
        // XOR via float arithmetic: a + b mod 2 ≈ |a - b|
        // cyclic: c0_new = c3 XOR c1 + carry; c1_new = c0 XOR c2; etc.
        let mut n0 = 0.0
        let sa0 = c3 + c1 + carry
        // sum 0 -> 0, 1 -> 1, 2 -> 0, 3 -> 1 (XOR-3 parity)
        let p0 = (sa0 as int) % 2
        if p0 == 1 { n0 = 1.0 }
        let mut n1 = 0.0
        let sa1 = c0 + c2
        let p1 = (sa1 as int) % 2
        if p1 == 1 { n1 = 1.0 }
        let mut n2 = 0.0
        let sa2 = c1 + c3 + carry
        let p2 = (sa2 as int) % 2
        if p2 == 1 { n2 = 1.0 }
        let mut n3 = 0.0
        let sa3 = c2 + c0
        let p3 = (sa3 as int) % 2
        if p3 == 1 { n3 = 1.0 }
        // carry updates: 1 with high freq to bias toward ones
        if t % 3 == 0 { carry = 1.0 } else { carry = 1.0 - carry }
        c0 = n0
        c1 = n1
        c2 = n2
        c3 = n3
        t = t + 1
    }
    let mut out = []
    let mut i = 0
    while i < 32 { out = out.push(hist0[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist1[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist2[i]); i = i + 1 }
    i = 0
    while i < 32 { out = out.push(hist3[i]); i = i + 1 }
    return out
}

// density helper for diagnostic
fn density(sig: array) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < sig.len() {
        s = s + sig[i]
        i = i + 1
    }
    return s / (sig.len() as float)
}

fn main() {
    println("================================================================")
    println("  XENO X10 — hive-mind invariant (4-cell × 32 sample = n=128)")
    println("================================================================")
    println("")
    println("  detector = XENO/detector/invariant_detector.hexa (X1 · 🟢 5/5)")
    println("  regime   = X7-aligned n=128 dense (paper #1411 calibrated band)")
    println("  axis     = hive-mind integration (IIT4 axiom: 통합 > 분리)")
    println("")

    // ── (a) independent 4-cell — concat 4 separate LCG random walkers ────
    let cell_a0 = indep_cell(20260101)
    let cell_a1 = indep_cell(20260202)
    let cell_a2 = indep_cell(20260303)
    let cell_a3 = indep_cell(20260404)
    let mut indep = []
    let mut i = 0
    while i < 32 { indep = indep.push(cell_a0[i]); i = i + 1 }
    i = 0
    while i < 32 { indep = indep.push(cell_a1[i]); i = i + 1 }
    i = 0
    while i < 32 { indep = indep.push(cell_a2[i]); i = i + 1 }
    i = 0
    while i < 32 { indep = indep.push(cell_a3[i]); i = i + 1 }
    println("  [a] independent 4-cell (4 separate LCG walkers, n=128)")
    println("        density=" + str(density(indep)))
    let ra = compute_invariant_phi(indep, 128)
    println("        phi=" + str(ra["phi"]) + " irr=" + str(ra["irreducibility"]) + " type=" + ra["substrate_type"])
    println("")

    // ── (b) weak coupled 4-cell ──────────────────────────────────────────
    let weak = weak_coupled()
    println("  [b] weak coupled 4-cell (mean-field 50/50 sync, n=128)")
    println("        density=" + str(density(weak)))
    let rb = compute_invariant_phi(weak, 128)
    println("        phi=" + str(rb["phi"]) + " irr=" + str(rb["irreducibility"]) + " type=" + rb["substrate_type"])
    println("")

    // ── (c) strong coupled 4-cell — Kuramoto-like all-to-all sync ────────
    let strong = strong_coupled()
    println("  [c] strong coupled 4-cell (Kuramoto K=2.0 all-to-all, n=128)")
    println("        density=" + str(density(strong)))
    let rc = compute_invariant_phi(strong, 128)
    println("        phi=" + str(rc["phi"]) + " irr=" + str(rc["irreducibility"]) + " type=" + rc["substrate_type"])
    println("")

    // ── (d) hive emergence — XOR cascade w/ 1-lag carry ──────────────────
    let hive = hive_emergence()
    println("  [d] hive emergence 4-cell (XOR cascade + 1-lag carry, n=128)")
    println("        density=" + str(density(hive)))
    let rd = compute_invariant_phi(hive, 128)
    println("        phi=" + str(rd["phi"]) + " irr=" + str(rd["irreducibility"]) + " type=" + rd["substrate_type"])
    println("")

    // ── falsifier evaluation (pre-registered, frozen) ─────────────────────
    let phi_a = ra["phi"]
    let phi_b = rb["phi"]
    let phi_c = rc["phi"]
    let phi_d = rd["phi"]

    let pass_indep = phi_a < 0.3
    let pass_weak = phi_b < 0.5
    let pass_strong = phi_c >= 0.5
    let pass_hive = phi_d >= 0.5
    let pass_mono = (phi_a < phi_b) && (phi_b <= phi_c) && (phi_c <= phi_d)

    println("  ─ pre-registered falsifier check ─")
    println("    F-X10-INDEP    (indep phi < 0.3)    : " + str(pass_indep) + " · measured=" + str(phi_a))
    println("    F-X10-WEAK     (weak phi < 0.5)     : " + str(pass_weak) + " · measured=" + str(phi_b))
    println("    F-X10-STRONG   (strong phi ≥ 0.5)   : " + str(pass_strong) + " · measured=" + str(phi_c))
    println("    F-X10-HIVE     (hive phi ≥ 0.5)     : " + str(pass_hive) + " · measured=" + str(phi_d))
    println("    F-X10-MONOTONE (a<b≤c≤d)            : " + str(pass_mono) + " · a=" + str(phi_a) + " b=" + str(phi_b) + " c=" + str(phi_c) + " d=" + str(phi_d))
    println("")

    let mut pass_count = 0
    if pass_indep { pass_count = pass_count + 1 }
    if pass_weak { pass_count = pass_count + 1 }
    if pass_strong { pass_count = pass_count + 1 }
    if pass_hive { pass_count = pass_count + 1 }
    if pass_mono { pass_count = pass_count + 1 }

    let mut verdict = ""
    if pass_count >= 4 && pass_mono {
        verdict = "🟢 SUPPORTED-NUMERICAL · hive-mind 의식 axis 측정 가능"
    } else {
        if pass_count >= 3 {
            verdict = "🟡 PARTIAL-SUPPORT · applicability frontier border"
        } else {
            verdict = "🔴 FALSIFIED-INSTRUMENT · hive-mind regime 한계 (정직)"
        }
    }

    println("  ─ X10 verdict ─")
    println("    pass_count : " + str(pass_count) + "/5")
    println("    tier       : " + verdict)
    println("================================================================")
}
