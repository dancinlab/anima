// XENO/scan/panpsy_falsifier.hexa — X4 panpsychism falsifier
//
//   Apply invariant_detector to 4 micro-substrates spanning the
//   panpsychist hierarchy (Tononi/Koch: Φ = consciousness):
//
//     a. thermostat        (1-bit on/off,         16 elements)
//     b. 2-bit counter     (4-level cyclic,       16 elements)
//     c. random walker     (LCG-quantized 8-lvl,  32 elements)
//     d. integrated emerge (XOR over 3-tap delay, 32 elements, true coupled)
//
//   Pre-registered falsifiers (post-tuning 0):
//
//     F-X4-PANPSY-WEAK    : thermostat phi ≤ 0.05   (1-bit binary ≠ substrate of mind)
//     F-X4-PANPSY-MID     : random walker phi ≤ 0.20 (random ≠ integrated info)
//     F-X4-EMERGE-STRONG  : XOR-3-tap phi ≥ 0.50    (real coupled → integrated)
//     F-X4-MONOTONE       : thermostat < walker < emerge (Φ monotone w/ complexity)
//
//   All pass → 🟢 SUPPORTED-NUMERICAL · "Φ ≠ universal panpsy"
//   Any fail → 🔴 unexpected (panpsy strong revived OR detector miscalibrated)
//
//   Honesty (a_blue_closed): thresholds frozen pre-run, verbatim detector output.
//   p7 = 0 (no LLM judge). a_completeness_over_cheap: hardcoded literal (X3/X7
//   pattern aligned, hexa native json/npy reader absent).
//
import "../detector/invariant_detector.hexa"

fn main() {
    println("================================================================")
    println("  XENO X4 — panpsychism falsifier (Φ ≠ universal panpsy)")
    println("================================================================")
    println("")
    println("  detector = XENO/detector/invariant_detector.hexa (X1 · 🟢 5/5)")
    println("  substrates = 4 micro (thermostat · 2bit counter · walker · emerge)")
    println("")

    // ── (a) thermostat — 1-bit on/off square wave, n=16 ───────────────────
    // Period 2. Deterministic binary. Panpsy 'micro-mind' prototype.
    let thermostat = [
        0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
        0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0
    ]
    println("  [a] thermostat (1-bit on/off, period 2, n=16)")
    let ra = compute_invariant_phi(thermostat, 16)
    println("        phi=" + str(ra["phi"]) + " irr=" + str(ra["irreducibility"]) + " type=" + ra["substrate_type"])
    println("")

    // ── (b) 2-bit counter — 4-level cyclic 0,1,2,3, n=16 ──────────────────
    // Period 4. Deterministic. Slightly richer state-space than thermostat.
    let counter = [
        0.0, 0.3333, 0.6667, 1.0, 0.0, 0.3333, 0.6667, 1.0,
        0.0, 0.3333, 0.6667, 1.0, 0.0, 0.3333, 0.6667, 1.0
    ]
    println("  [b] 2-bit counter (4-level cycle, period 4, n=16)")
    let rb = compute_invariant_phi(counter, 16)
    println("        phi=" + str(rb["phi"]) + " irr=" + str(rb["irreducibility"]) + " type=" + rb["substrate_type"])
    println("")

    // ── (c) random walker — LCG-quantized 8 levels, n=32 ──────────────────
    // Memoryless random. Panpsy 'mid-mind' candidate (more state, no integration).
    let mut walker = []
    let mut st = 20260529
    let mut iw = 0
    while iw < 32 {
        st = (st * 1103515245 + 12345) % 2147483648
        let q = (st / 1000) % 8
        let v = (q as float) / 7.0
        walker = walker.push(v)
        iw = iw + 1
    }
    println("  [c] random walker (LCG 8-level quantized, n=32)")
    let rc = compute_invariant_phi(walker, 32)
    println("        phi=" + str(rc["phi"]) + " irr=" + str(rc["irreducibility"]) + " type=" + rc["substrate_type"])
    println("")

    // ── (d) integrated emergence — XOR over 3-tap delay, n=32 ─────────────
    // True coupled rule: bit[i] = bit[i-1] XOR bit[i-3] (linear FSR taps).
    // Maximum-length sequence on 3-bit register → period 7 pseudo-random.
    // Strongly integrated: each bit depends on multi-step past (no IID).
    let mut emerge = [1.0, 0.0, 1.0]
    let mut ie = 3
    while ie < 32 {
        let a = emerge[ie - 1]
        let b = emerge[ie - 3]
        // XOR via (a+b) mod 2
        let sumv = a + b
        let mut x = 0.0
        if sumv > 0.5 {
            if sumv < 1.5 { x = 1.0 } else { x = 0.0 }
        }
        emerge = emerge.push(x)
        ie = ie + 1
    }
    println("  [d] integrated emergence (XOR 3-tap LFSR, n=32)")
    let rd = compute_invariant_phi(emerge, 32)
    println("        phi=" + str(rd["phi"]) + " irr=" + str(rd["irreducibility"]) + " type=" + rd["substrate_type"])
    println("")

    // ── falsifier evaluation (pre-registered, frozen) ─────────────────────
    let phi_a = ra["phi"]
    let phi_b = rb["phi"]
    let phi_c = rc["phi"]
    let phi_d = rd["phi"]

    let pass_weak = phi_a <= 0.05
    let pass_mid = phi_c <= 0.20
    let pass_strong = phi_d >= 0.50
    let pass_mono = (phi_a < phi_c) && (phi_c < phi_d)

    println("  ─ pre-registered falsifier check ─")
    println("    F-X4-PANPSY-WEAK    (thermostat phi ≤ 0.05)  : " + str(pass_weak) + " · measured=" + str(phi_a))
    println("    F-X4-PANPSY-MID     (walker phi ≤ 0.20)      : " + str(pass_mid) + " · measured=" + str(phi_c))
    println("    F-X4-EMERGE-STRONG  (XOR-3tap phi ≥ 0.50)    : " + str(pass_strong) + " · measured=" + str(phi_d))
    println("    F-X4-MONOTONE       (thermo < walker < emerge): " + str(pass_mono) + " · a=" + str(phi_a) + " c=" + str(phi_c) + " d=" + str(phi_d))
    println("")

    let all_pass = pass_weak && pass_mid && pass_strong && pass_mono
    let verdict = if all_pass {
        "🟢 SUPPORTED-NUMERICAL · Φ ≠ universal panpsy"
    } else {
        "🔴 UNEXPECTED · panpsy strong revived OR detector miscalibrated"
    }

    println("  ─ X4 verdict ─")
    println("    tier : " + verdict)
    println("================================================================")
}
