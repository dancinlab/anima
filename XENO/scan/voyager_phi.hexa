// XENO/scan/voyager_phi.hexa — X7 BL Voyager-1 invariant_detector 실 실행
//
//   Real BL Green Bank Voyager-1 single_block IQ baseband → Φ scan.
//
//   Source: DATASET/breakthrough_listen/Voyager1_block1.npy
//     shape    = (64, 1000, 2) complex64 = 64 channel × 1000 sample × 2 pol
//     dtype    = complex64 (8-bit quantization, range ±40)
//     extract  = real part flatten, first 128 sample → normalize [0,1]
//
//   Prediction (pre-registered):
//     Voyager-1 1.42 GHz carrier = narrow-band technosignature
//     ⊂ coherent but NOT integrated/irreducible
//     ⇒ invariant_detector verdict expected: phi ≈ 0, type = "noise" or "coherent_non_conscious"
//     ⇒ tier = 🟢 SUPPORTED-NUMERICAL (real-data measurement, honest result)
//
//   Honesty constraint (a_blue_closed): no synthetic re-binarization fakery.
//     binarize threshold = 0.5 (same as X1 default), no parameter tuning post-result.
//
import "../detector/invariant_detector.hexa"

fn main() {
    println("================================================================")
    println("  XENO X7 — BL Voyager-1 invariant_detector 실 실행")
    println("================================================================")
    println("")
    println("  source = DATASET/breakthrough_listen/Voyager1_block1.npy")
    println("         = (64, 1000, 2) complex64, BL Green Bank Voyager-1 baseband")
    println("         = real-part flatten first 128 samples, [0,1] normalized")
    println("")
    let voyager_128 = [
        0.6500, 0.0000, 0.6500, 1.0000, 0.6500, 0.0000, 0.0000, 0.3500,
        1.0000, 0.3500, 0.0000, 0.6500, 0.0000, 0.3500, 0.6500, 0.6500,
        0.6500, 0.6500, 0.0000, 0.6500, 0.0000, 0.3500, 0.6500, 0.3500,
        1.0000, 1.0000, 1.0000, 0.0000, 0.0000, 0.0000, 0.0000, 0.0000,
        1.0000, 0.6500, 0.6500, 1.0000, 0.6500, 1.0000, 0.6500, 0.3500,
        0.0000, 0.3500, 1.0000, 0.0000, 0.0000, 0.3500, 0.6500, 0.6500,
        1.0000, 0.3500, 0.6500, 0.3500, 0.6500, 0.3500, 0.6500, 0.3500,
        0.6500, 0.6500, 0.0000, 0.0000, 0.6500, 0.6500, 1.0000, 0.6500,
        0.6500, 0.6500, 1.0000, 0.6500, 0.6500, 1.0000, 0.6500, 0.0000,
        0.6500, 1.0000, 0.6500, 0.3500, 0.6500, 0.0000, 0.6500, 0.3500,
        1.0000, 0.0000, 0.6500, 0.3500, 0.6500, 1.0000, 0.6500, 0.6500,
        0.6500, 1.0000, 0.6500, 0.6500, 0.6500, 1.0000, 0.0000, 0.6500,
        1.0000, 0.3500, 0.6500, 0.0000, 0.6500, 1.0000, 0.0000, 0.6500,
        0.6500, 0.0000, 0.0000, 0.0000, 0.6500, 0.0000, 0.6500, 0.6500,
        0.6500, 1.0000, 0.6500, 1.0000, 0.6500, 1.0000, 0.6500, 0.3500,
        0.6500, 0.3500, 0.0000, 0.0000, 0.0000, 0.3500, 0.6500, 0.3500
    ]
// stats: n=128, min=0.0000, max=1.0000, mean=0.5137, ones≥0.5 = 78/128 (60.9%)

    let r = compute_invariant_phi(voyager_128, 128)
    println("  ─ invariant_detector verdict ─")
    println("    phi             = " + str(r["phi"]))
    println("    integration     = " + str(r["integration"]))
    println("    irreducibility  = " + str(r["irreducibility"]))
    println("    substrate_type  = " + r["substrate_type"])
    println("")

    let phi_val = r["phi"]
    let irr = r["irreducibility"]
    let stype = r["substrate_type"]

    println("  ─ pre-registered prediction check ─")
    println("    pred: phi ≈ 0 (narrow-band carrier ≠ irreducible)")
    println("    pred: type = 'noise' or 'coherent_non_conscious'")
    println("")

    let pass_phi = phi_val < 0.5
    let pass_type = stype == "noise" || stype == "coherent_non_conscious"
    let verdict = if pass_phi && pass_type { "🟢 SUPPORTED-NUMERICAL" } else { "🔴 UNEXPECTED" }

    println("  ─ X7 verdict ─")
    println("    pre-reg phi < 0.5    : " + str(pass_phi))
    println("    pre-reg type match   : " + str(pass_type))
    println("    tier                 : " + verdict)
    println("================================================================")
}

