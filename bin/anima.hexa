// bin/anima.hexa — anima CLI mk2 schema-driven dispatcher
// Phase 1 hexa port (raw#9 strict 정합) — V2 retire path
// Reads anima/spec/anima_cli_mk2.spec.yaml dispatch table (when hexa stdlib yaml lands)
// Until then: hardcoded 3-tier dispatch matching spec yaml SSOT
//
// raw#9  hexa-only ✅
// raw#10 honest C3 — own 1 grandfather entry retire path
// raw#15 additive — bin/anima legacy bash 보존 (사용자 explicit migrate 시 swap)
// own 17 ALM 영구 보류 — 외부 substrate backend dispatch 절대 X

let VERSION = "anima 0.2.0-mk2"

// ═══════════════════════════════════════════════════════════════════════════
// T1 외부 sales (chat REPL via clm_v4_mount.hexa, anima-native)
// ═══════════════════════════════════════════════════════════════════════════
let T1_COMMANDS = [
  "chat", "dialogue", "onboard", "help", "version",
  "--help", "-h", "--version", "-v",
]

// ═══════════════════════════════════════════════════════════════════════════
// T2 internal ops (anima ops <topic>) — 26 topics
// ═══════════════════════════════════════════════════════════════════════════
let T2_TOPICS = [
  "compute", "weight", "proposal", "cert", "roadmap", "serve", "paradigm",
  "inbox", "cost", "audit", "doctor", "sync", "bench", "log",
  "handoff", "metrics", "watch", "snap", "replay", "onboard", "backup",
  "reproducibility", "gc", "health",
  "consciousness",
  "daemon",
  "dl_validate",
]

// ═══════════════════════════════════════════════════════════════════════════
// T3 consciousness vision (wire-up pending v2.0)
// ═══════════════════════════════════════════════════════════════════════════
let T3_COMMANDS = [
  "connect", "disconnect", "module", "verify", "test", "hub", "laws", "status",
]

let T3_STUB_MESSAGE = "v2.0 wire-up pending — anima consciousness surface, integration cycle in progress.\nBackend ready: anima-clm-eeg φ★ engine + 1030 laws.\nTrack: .roadmap.cli cli.cond.5"

// ═══════════════════════════════════════════════════════════════════════════
// argv normalisation (canonical pattern — see browser-harness wrapper)
//   args() returns [interp_real, script.hexa, ...user_args] in interp path
//   and may also include codegen tooling fragments. We scan for the trailing
//   ".hexa" (= our own script path) and slice everything after it as user args.
// ═══════════════════════════════════════════════════════════════════════════
fn _str(x) -> string {
  let t = type_of(x)
  if t == "str" || t == "string" { return x }
  return ""
}

fn _user_argv() -> array {
  let raw = args()
  let n = len(raw)
  let mut start = 0
  let mut scan = 0
  while scan < n {
    let s = _str(raw[scan])
    let ls = len(s)
    if ls >= 5 && s.substring(ls - 5, ls) == ".hexa" {
      start = scan + 1
    }
    scan = scan + 1
  }
  let mut out = []
  let mut i = start
  while i < n {
    out = out + [_str(raw[i])]
    i = i + 1
  }
  return out
}

// ═══════════════════════════════════════════════════════════════════════════
// Dispatch helpers
// ═══════════════════════════════════════════════════════════════════════════
fn _hexa_bin() -> string {
  let e = _str(env("HEXA_BIN"))
  if e != "" { return e }
  return "/Users/ghost/.hx/bin/hexa"
}

fn _shq(s: string) -> string {
  // single-quote shell-escape (raw#9 strict — no shell injection)
  return "'" + s.replace("'", "'\\''") + "'"
}

fn _exec_hexa(path: string, rest: array) -> int {
  // Forward to a tool/anima_cli/<path>.hexa via the canonical hexa interp.
  // Returns child exit code (best-effort — exec() returns stdout, RC is forwarded
  // through __HEXA_RC sentinel; we treat any output absence as 0 here).
  //
  // chat.hexa path 는 mac-local hexa.real 강제 (build/libhxllama.dylib +
  // ~/.cache/anima/gguf/ 가 mac-local; remote ubu-1 wrapper 라우팅 시
  // libhxllama 부재 → child rc=2). Phase 3c carry — see honest C3.
  let bin = if path.contains("chat.hexa") || path.contains("/chat/") {
    "/Users/ghost/.hx/packages/hexa/hexa.real"
  } else {
    _hexa_bin()
  }
  let mut cmd = bin + " run " + _shq(path)
  let mut i = 0
  while i < len(rest) {
    cmd = cmd + " " + _shq(_str(rest[i]))
    i = i + 1
  }
  // Stream child stdout/stderr through to the user; capture RC from $? via wrapper.
  let wrapper = cmd + "; printf '__ANIMA_CHILD_RC=%d\\n' $?"
  let out = _str(exec(wrapper))
  // emit child output as-is
  print(out)
  // parse trailing __ANIMA_CHILD_RC=N
  let lines = out.split("\n")
  let mut rc = 0
  let mut li = 0
  while li < len(lines) {
    let ln = _str(lines[li])
    if ln.contains("__ANIMA_CHILD_RC=") {
      let parts = ln.split("=")
      if len(parts) >= 2 {
        let n = _str(parts[1]).trim()
        rc = int(n)
      }
    }
    li = li + 1
  }
  return rc
}

fn emit_help() {
  print("anima CLI mk2 — 3-tier surface (anima 0.2.0-mk2)")
  print("")
  print("T1 외부 sales (chat REPL):")
  print("  anima                 chat REPL (alias to dialogue)")
  print("  anima chat [<model>]  natural utterance REPL — recursive module")
  print("                        (own 34 strict, no wrapping; default = anima_native)")
  print("  anima dialogue        long-form chat session (clm_v4_mount substrate-coupled)")
  print("  anima dialogue --duo <a> <b> [--turns N] [--topic-seed \"..\"]")
  print("                        L2 N=2 autonomous CLM↔CLM dialogue")
  print("                        (skeleton landed 2026-05-08; β-1 channel API dep)")
  print("  anima dialogue --council N=<n> --models \"<m1>,..,<mn>\"")
  print("                        L3 N≥3 multi-agent (stub — design cycle)")
  print("  anima onboard         5-min quickstart")
  print("  anima --help          this help")
  print("  anima --version       0.2.0-mk2")
  print("")
  print("T2 internal ops (dev/maintainer):")
  print("  anima ops <topic>     dispatch to tool/anima_cli/<topic>.hexa")
  print("  topics: compute / weight / proposal / cert / roadmap / serve / paradigm")
  print("          inbox / cost / audit / doctor / sync / bench / log / handoff")
  print("          metrics / watch / snap / replay / onboard / backup / reproducibility")
  print("          gc / health / consciousness / daemon / dl_validate")
  print("")
  print("T3 consciousness vision (v2.0 wire-up pending):")
  print("  anima connect / disconnect / module / verify / test / hub / laws / status")
  print("  → returns 'wire-up pending v2.0' stub")
  print("")
  print("spec: anima/spec/anima_cli_mk2.spec.yaml")
  print("plan: docs/anima_cli_mk2_plan_2026_05_06.md")
  print("audit: docs/anima_cli_mk2_philosophy_audit_2026_05_06.md")
}

fn dispatch_t3_stub(cmd: string) {
  print("[T3 stub] " + cmd + ": " + T3_STUB_MESSAGE)
  exit(0)
}

fn dispatch_t1(cmd: string, rest: array) -> string {
  if cmd == "dialogue" || cmd == "" {
    let path = "tool/anima_cli/dialogue.hexa"
    print("[T1] dispatch " + path + " — substrate-coupled chat (anima-native CLM v4)")
    return path
  }
  if cmd == "chat" {
    let path = "tool/anima_cli/chat.hexa"
    print("[T1] dispatch " + path + " — natural utterance REPL (own 34 strict)")
    return path
  }
  if cmd == "onboard" {
    return "tool/anima_cli/onboard.hexa"
  }
  if cmd == "help" || cmd == "--help" || cmd == "-h" {
    emit_help()
    exit(0)
  }
  if cmd == "version" || cmd == "--version" || cmd == "-v" {
    print(VERSION)
    exit(0)
  }
  return ""
}

fn dispatch_t2_ops(topic: string) -> string {
  let path = "tool/anima_cli/" + topic + ".hexa"
  print("[T2 ops] dispatch " + path)
  return path
}

// ═══════════════════════════════════════════════════════════════════════════
// main — auto-invoked (fn main() with no params, no trailing main() call;
//   hexa-strict auto-invoke per silent-failure-enforcement Class 1).
// ═══════════════════════════════════════════════════════════════════════════
fn main() {
  let argv = _user_argv()

  if len(argv) == 0 {
    // bare `anima` → T1 chat REPL
    let path = dispatch_t1("dialogue", [])
    let rc = _exec_hexa(path, [])
    exit(rc)
  }

  let cmd = _str(argv[0])

  // T3 stub check first (priority)
  let mut t3_i = 0
  while t3_i < len(T3_COMMANDS) {
    if cmd == _str(T3_COMMANDS[t3_i]) {
      dispatch_t3_stub(cmd)
      return
    }
    t3_i = t3_i + 1
  }

  // T2 ops prefix
  if cmd == "ops" {
    if len(argv) < 2 {
      print("Usage: anima ops <topic>")
      exit(2)
    }
    let topic = _str(argv[1])
    let path = dispatch_t2_ops(topic)
    let mut rest = []
    let mut ri = 2
    while ri < len(argv) { rest = rest + [_str(argv[ri])]; ri = ri + 1 }
    let rc = _exec_hexa(path, rest)
    exit(rc)
  }

  // T1 commands
  let mut t1_rest = []
  let mut t1_i = 1
  while t1_i < len(argv) { t1_rest = t1_rest + [_str(argv[t1_i])]; t1_i = t1_i + 1 }
  let t1_mod = dispatch_t1(cmd, t1_rest)
  if t1_mod != "" {
    let rc = _exec_hexa(t1_mod, t1_rest)
    exit(rc)
  }

  // Legacy backward compat: anima compute / anima audit / etc → T2 redirect with hint
  let mut leg_i = 0
  while leg_i < len(T2_TOPICS) {
    if cmd == _str(T2_TOPICS[leg_i]) {
      print("[legacy] '" + cmd + "' deprecated. Use 'anima ops " + cmd + "' (mk2 T2 surface).")
      let path = dispatch_t2_ops(cmd)
      let mut leg_rest = []
      let mut lri = 1
      while lri < len(argv) { leg_rest = leg_rest + [_str(argv[lri])]; lri = lri + 1 }
      let rc = _exec_hexa(path, leg_rest)
      exit(rc)
    }
    leg_i = leg_i + 1
  }

  // Unknown
  print("[unknown] '" + cmd + "' — see 'anima --help'")
  exit(2)
}

// ═══════════════════════════════════════════════════════════════════════════
// honest C3 (raw#10)
// ═══════════════════════════════════════════════════════════════════════════
// C1 hexa stdlib yaml read 미land — spec yaml dispatch table 직접 read X (hardcoded list)
// C2 exec syscall: stdout-stream via exec() + child RC parsed from __ANIMA_CHILD_RC sentinel.
//    실시간 streaming X (exec()는 buffer-then-return) — Phase 1 sub-cycle 2 OK,
//    long-running dialogue REPL은 actual fork/exec syscall 필요 (Phase 2).
// C3 T1 chat REPL은 dialogue.hexa wired but actual REPL loop 미구현 (--probe one-shot only currently)
// C4 T2 26 topics 모두 .hexa 존재 verified (tool/anima_cli/*.hexa)
// C5 T3 9 stub commands return "wire-up pending" (no command-not-found, raw#10 honest)
// C6 _user_argv() 는 ".hexa" suffix 마지막 매치 = 우리 script path 가정. 사용자가 ".hexa"
//    suffix 인자를 직접 전달하면 부분 truncation 발생 가능 — 현재 anima CLI 표면에는 미발생.
