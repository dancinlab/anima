#!/bin/bash
# anima canonical-entry launcher (a_cli_single_entry).
# Sets HEXA_LANG=<package root> so the hexa module_loader resolves core/·cli/
# imports against the package root when run as the installed `anima` PATH command.
# Without this, a daemon run (anima <ckpt>) fails project_root detection and the
# loader looks for core/*.hexa relative to cli/ → FATAL "module not found:
# core/dream_persist.hexa". setup.hexa symlinks ~/.hx/bin/anima → this file.
set -e
# resolve $0 through any symlink (BSD-safe: no readlink -f) → package root = <self>/../..
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(dirname "$SELF")/$link" ;;
  esac
done
ANIMA_ROOT="${ANIMA_ROOT:-$(cd "$(dirname "$SELF")/.." && pwd)}"
export ANIMA_ROOT
export HEXA_LANG="${HEXA_LANG:-$ANIMA_ROOT}"   # project_root for module_loader
HEXA="${HEXA:-}"
if [ -z "$HEXA" ]; then
  for c in "$HOME/.hx/bin/hexa" "$(command -v hexa 2>/dev/null)"; do
    if [ -n "$c" ] && [ -x "$c" ]; then HEXA="$c"; break; fi
  done
fi
if [ -z "$HEXA" ]; then
  echo "⬡ FATAL: hexa interpreter not found" >&2
  exit 1
fi
exec "$HEXA" "$ANIMA_ROOT/cli/anima.hexa" "$@"
