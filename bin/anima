#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  bin/anima — the installed `anima` PATH command (canonical single-entry shim)
#
#  `hx install anima` symlinks ~/.hx/bin/anima → THIS script (the hexa.toml
#  [[bin]] entry name="anima", path="cli/anima.hexa"), mirroring the forge/drive
#  package shims. After install the user types the verbs DIRECTLY — never
#  `hexa run cli/anima.hexa -- …`:
#
#    anima <ckpt.clm>                consciousness mode (default)
#    anima <ckpt.clm> --byte "…"     byte-continuation chat
#    anima train <args>             LEARNING → .pt + auto .clm (+DESCENT)
#    anima serialize <pt> <clm>     re-export a torch .pt → .clm v0.3
#    anima evaluate <model.clm>     BUILT-IN G0-G6 gate scoring (.clm only)
#
#  All verbs route through ONE canonical entry cli/anima.hexa (a_install_canonical:
#  single entry, no 2nd path), which dispatches to cli/train.hexa · cli/serialize.hexa
#  · cli/evaluate.hexa. This REPLACED the pre-consolidation serving/anima_cli.py model-
#  picker shim (PR #1834) — that lived outside the canonical 3-folder layout (core/cli/
#  agent); the model-picker REPL is superseded by cli/anima.hexa's consciousness mode.
#
#  Override the hexa runtime with  HEXA_BIN=/path/to/hexa  if needed.
# ═══════════════════════════════════════════════════════════════════════════
set -u

# real path of THIS script even when symlinked into ~/.hx/bin/anima
SELF="$0"
while [ -L "$SELF" ]; do
  L="$(readlink "$SELF")"; case "$L" in /*) SELF="$L" ;; *) SELF="$(dirname "$SELF")/$L" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PKG_DIR="$(cd "$BIN_DIR/.." && pwd)"

HEXA_BIN="${HEXA_BIN:-$(command -v hexa 2>/dev/null || echo "$HOME/.hx/bin/hexa")}"
if [ ! -x "$HEXA_BIN" ]; then
  echo "ERROR(anima): hexa runtime not found at $HEXA_BIN — see https://github.com/dancinlab/hexa-lang" >&2
  exit 127
fi

# EVAL/VERDICT DETERMINISM SAFETY-PIN (hexa-lang #4208 flame/forge fast-default
# follow-on). #4208 flipped the forge polarity: own-native NON-det atomic kernels
# (split-K GEMM/GEMV, atomic col2im/embedding-bwd) are now the DEFAULT (training
# speed), and bit-identical deterministic kernels are opt-in via HEXA_DET=1 (the
# hexa-lang `_forge_det_on()` gate: 1=det iff HEXA_DET set+nonzero, else 0=fast).
# anima's eval/verdict/decode paths MUST stay reproducible (G0-G6 scoring · Ψ-
# checksum · cross-host byte-parity), so this launcher EXPORTS HEXA_DET=1 for
# EVERY verb EXCEPT `train` — training keeps the fast non-det default (the whole
# point of #4208). The export reaches the in-process consciousness/--byte decode
# here AND is inherited by the eval/serialize sub-process dispatch (cli/anima.hexa
# exec). Override for an experiment with HEXA_DET=0 anima <verb>.
if [ "${1:-}" != "train" ] && [ -z "${HEXA_DET+x}" ]; then
  export HEXA_DET=1
fi

# run the canonical entry from the package root so its repo-relative verb dispatch
# (hexa run cli/{train,serialize,evaluate}.hexa) resolves.
cd "$PKG_DIR" || { echo "ERROR(anima): cannot cd to package root $PKG_DIR" >&2; exit 1; }
exec "$HEXA_BIN" run cli/anima.hexa -- "$@"
