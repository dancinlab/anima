            let d_eff_B_s2  = if s2_n > 0 { to_float(s2_b_flip)  / to_float(s2_n) } else { 0.0 }
            let d_eff_AB_s2 = if s2_n > 0 { to_float(s2_ab_flip) / to_float(s2_n) } else { 0.0 }
            let s2_bind = d_eff_AB_s2 - (d_eff_A_s2 + d_eff_B_s2)
            let s2_testable = s2_n >= 10
            let bind_ok = s2_testable && s2_bind >= 0.05
            // ── Ψ-guard ──
            let psiF_off = to_float(og_emit_liveF_mid) / midfF
            let psiF_on  = to_float(og_emit_vqF_mid) / midfF
