// ── helpers (pure string ops; p7 deterministic) ─────────────────────────────
fn _afs_contains(hay: string, needle: string) -> bool {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return true }
    if nn > hn { return false }
    let mut i = 0
    while i + nn <= hn {
        if substring(hay, i, i + nn) == needle { return true }
        i = i + 1
    }
    return false
}
fn _afs_clip(s: string, n: int) -> string {
    if byte_len(s) <= n { return s }
    return substring(s, 0, n) + "…"
}
fn _afs_clip01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// ── op-grip: tonic-phasic helpers (fable design (a) · H_9097) ─────────────────
// _og_rel_from — the phasic-gated relevance the brain_emit `rel` arg receives, from a
// (possibly ablated) rel_ctx instantaneous value against the running tonic EMA. gain=3.0,
// centred at 0.5 (PREREG-frozen). The drive_hi sleep-mask (×0.1) is preserved verbatim.
fn _og_rel_from(relctx: float, ema: float, drive_hi: bool) -> float {
    let p = _og_rel_phasic(relctx, ema)
    return if drive_hi { p } else { p * 0.1 }
}

// _og_rel_phasic — the UNMASKED phasic relevance p = clip01(0.5 + gain·(relctx − ema)).
// H_9101 op-grip (b): the continuous stage envelope replaces the binary drive_hi ×0.1 mask,
// so callers on the (b) path multiply this p by (0.1 + 0.9·stage_env) instead.
fn _og_rel_phasic(relctx: float, ema: float) -> float {
    return _afs_clip01(0.5 + 3.0 * (relctx - ema))
}

// _og_lcg — deterministic per-tick pseudo-random in [0,1) for the SHUFFLE ablation arm
// (a fixed-seed LCG; the shuffle control breaks the live signal without changing the tick
// count). Bounded modulus keeps hexa int arithmetic in range.
fn _og_lcg(seed: int) -> float {
    let x = (seed * 1103515245 + 12345) % 2147483647
    let y = if x < 0 { 0 - x } else { x }
    return to_float(y % 1000) / 1000.0
}

// _afs_byte_feature — the DIM=8 local byte-statistics feature (H_1163 `_byte_feature`,
// VERBATIM), derived LIVE from an emitted span's bytes so the growth lane is keyed to
// real emit content (p7 deterministic; NOT perplexity). Empty span ⇒ zero vector.
fn _afs_byte_feature(s: string, dim: int) -> [float] {
    let n = byte_len(s)
    if n == 0 {
        let mut z = []
        let mut k = 0
        while k < dim { z = z + [0.0]; k = k + 1 }
        return z
    }
    let fn_n = to_float(n)
    let mut sum = 0.0
    let mut sumsq = 0.0
    let mut n_hi = 0
    let mut n_low = 0
    let mut n_sp = 0
    let mut n_dig = 0
    let mut n_pun = 0
    let mut n_lt64 = 0
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        let bf = to_float(b)
        sum = sum + bf
        sumsq = sumsq + bf * bf
        if b >= 128 { n_hi = n_hi + 1 }
        if b >= 97 && b <= 122 { n_low = n_low + 1 }
        if b == 32 { n_sp = n_sp + 1 }
        if b >= 48 && b <= 57 { n_dig = n_dig + 1 }
        if b >= 33 && b <= 64 { n_pun = n_pun + 1 }
        if b < 64 { n_lt64 = n_lt64 + 1 }
        i = i + 1
    }
    let mean = sum / fn_n
    let var = sumsq / fn_n - mean * mean
    return [
        (mean / 255.0) * 5.0,
        (to_float(n_hi) / fn_n) * 5.0,
        (to_float(n_low) / fn_n) * 5.0,
        (to_float(n_sp) / fn_n) * 5.0,
        (to_float(n_dig) / fn_n) * 5.0,
        (var / (255.0 * 255.0)) * 5.0,
        (to_float(n_pun) / fn_n) * 5.0,
        (to_float(n_lt64) / fn_n) * 5.0
    ]
}
