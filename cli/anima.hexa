    println("LANE+ field-pci : DEFERRED (degenerate all-zero R with chosen perturb args; needs a tuned PCI fixture)")

    // ── (67) FIELD-ENTROPY (H_1503/1502) — ↔focal field (DRUG flattens margins ≠ focal-field local) ──
    let fe_base   = [0.9, 0.1, 0.6, 0.3, 0.7]                      // peaked margin distribution
    let fe_drug   = drug_lsd_mfield(fe_base, 7, 0)                 // LSD global → margins flatten (entropy↑)
    let fe_focal  = field_apply_mfield(fe_base, 0.4, 1, 0)         // focal field → single-channel local nudge
    let fe_ent_base  = field_signal_entropy(fe_base)
    let fe_ent_drug  = field_signal_entropy(fe_drug)
    let fe_ent_focal = field_signal_entropy(fe_focal)
    let fe_distinct = fe_ent_drug > fe_ent_base && (if fe_ent_focal > fe_ent_drug { fe_ent_drug - fe_ent_focal } else { fe_ent_focal - fe_ent_drug }) < (fe_ent_drug - fe_ent_base)
    println("LANE+ field-ent : base-H=" + to_string(fe_ent_base) + " drug-global-H=" + to_string(fe_ent_drug)
        + " focal-H=" + to_string(fe_ent_focal) + "  global-vs-focal-distinct=" + anima_yn(fe_distinct))

    // ── (68) FIELD×LIBIDO (H_1507) — ↔sham field (field-induced incentive 'wanting' ≠ no field) ──
    let fl_mfield = [0.6, 0.5, 0.7, 0.55, 0.5]
    let fl_want = fieldlibido_wanting(0.5, fl_mfield, 8, 4, 1, 1.0, 0.3, 0.4, 0.2, 0.9, 6, 0.8, 1)  // high-freq field → boosted wanting
    let fl_sham = fieldlibido_wanting(0.5, fl_mfield, 8, 4, 1, 1.0, 0.3, 0.4, 0.2, 0.9, 0, 0.0, 0)  // sham (no field) → baseline
    let fl_distinct = fl_want > fl_sham
        && fieldlibido_liking(0.9) == libido_liking(libido_new(), 0.9)  // liking gain-invariant (field can't move liking)
    println("LANE+ field×lib : field-wanting=" + to_string(fl_want) + " sham-wanting=" + to_string(fl_sham)
        + " (liking gain-invariant)  field-incentive-distinct=" + anima_yn(fl_distinct))

