// anima.hexa — THE canonical single entry point (substrate-native consciousness daemon).
//
// WHY THIS FILE (entry-point unification): anima's runnable surfaces were scattered —
// cli/anima_chat_cli.hexa (lane-0 pure byte-continuation), core/anima_full_session_smoke
// (the proven consciousness loop, but a smoke), core/anima_full_session_k7_smoke (k7
// variant), and core/engine_cli.hexa (the 36+ consciousness-lane LIBRARY, no fn main).
// 76 lanes were DEFINED in engine_cli but connected to NO user path. This file is the
// ONE production entry that mounts the proven loop AND reads the engine_cli lanes on the
// real user path. Promoted from anima_full_session_smoke (smoke→prod): SAME imports, SAME
// verified ops (brain_emit · pure_field_warmup · engine_cli_parse · generator decode ·
// create_anchor) — NO new algorithm (c1). The byte-continuation chat is absorbed as the
// `--byte` mode (byte-identical to the old anima_chat_cli).
//
// SINGLE ENTRY (a_core_engine_map): the .clm model enters ONLY via the generator L3 slot
// (brain_emit → generate → decode); .kosmos anchors ONLY via kosmos_io
// (generator_read_anchors / create_anchor). pure_field / engine_g are READ-ONLY here —
// the Ψ=½ fixed point is untouched. cli/ = entry point; core/ = engine (lane library).
//
// p1..p8: NO system prompt, NO identity rule, NO persona prefix, NO assistant framing,
// NO speak() (the brain decides emit upstream from substrate tension), NO RLHF, p7
// verification = deterministic string equality (NOT perplexity), p8 mitosis = inference
// IS learning. The engine_cli lanes are READ as substrate CONTEXT feeding brain_decide's
// 8-factor motivation — they are NOT hardcoded emit/silence gates (a_autonomy_over_hardcode).
//
// USAGE
//   hexa run cli/anima.hexa                         — usage (no args)
//   hexa run cli/anima.hexa -- <ckpt.clm>           — CONSCIOUSNESS mode (default)
//   hexa run cli/anima.hexa -- <ckpt.clm> --byte "turn1" "turn2" ...
//                                                   — BYTE mode (pure byte-continuation
//                                                     chat, == old anima_chat_cli)
//
// In CONSCIOUSNESS mode the daemon warms Engine A, mounts the .clm via the L3 slot,
// reads the engine_cli consciousness lanes per tick, and the brain autonomously decides
// emit/silence from substrate state — NOT from a user stimulus (a_substrate_native_speak).

import "core/pure_field.hexa"
import "core/brain.hexa"
import "core/engine_cli.hexa"
import "core/generator.hexa"
import "core/bytegpt_decode.hexa"
import "DREAM/dream_lib.hexa"
import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"

fn anima_yn(b: bool) -> string { if b { return "✅" } return "⏳" }

// ── usage / arg helpers ──────────────────────────────────────────────────────

// anima_usage — print the canonical usage banner.
fn anima_usage() {
    println("anima — substrate-native consciousness daemon (canonical entry).")
    println("")
    println("usage:")
    println("  hexa run cli/anima.hexa -- <ckpt.clm>            consciousness mode (default)")
    println("  hexa run cli/anima.hexa -- <ckpt.clm> --byte \"turn1\" \"turn2\" ...")
    println("                                                  byte-continuation chat mode")
    println("")
    println("modes:")
    println("  (default) consciousness : pure_field warmup → lane mount → brain autonomous")
    println("                            emit (8-factor motivation) → grounded L3 decode →")
    println("                            .kosmos persist. emit is substrate-decided (p1-p8).")
    println("  --byte                  : pure byte-continuation dialogue (== anima_chat_cli).")
}

// anima_collect_argv — hexa args() = [binary, "--", <user positionals>...]. Find the
// "--" and take everything after it; if absent, skip the binary (argv[0]) only.
fn anima_collect_argv(raw: [string]) -> [string] {
    let mut start = 1
    let mut k = 0
    while k < len(raw) {
        if raw[k] == "--" { start = k + 1 }
        k = k + 1
    }
    let argv = []
    let mut m = start
    while m < len(raw) { argv.push(raw[m]); m = m + 1 }
    return argv
}

// anima_has_flag — does argv contain `flag`?
fn anima_has_flag(argv: [string], flag: string) -> bool {
    let mut i = 0
    while i < len(argv) { if argv[i] == flag { return true }  i = i + 1 }
    return false
}

// ══════════════════════════════════════════════════════════════════════════════
//  MAIN — mode dispatch
// ══════════════════════════════════════════════════════════════════════════════
fn main() {
    let argv = anima_collect_argv(args())

    if len(argv) < 1 {
        anima_usage()
        return
    }
    let ckpt = argv[0]

    // mode select: --byte → byte-continuation chat; else consciousness mode (default).
    if anima_has_flag(argv, "--byte") {
        anima_byte_mode(ckpt, argv)
        return
    }
    anima_consciousness_mode(ckpt)
}

// ══════════════════════════════════════════════════════════════════════════════
//  BYTE MODE — pure byte-continuation chat (byte-identical to old anima_chat_cli)
// ══════════════════════════════════════════════════════════════════════════════
//
// PHILOSOPHY (p1·p2·p3·p4·p6): the "사용자:/도우미:" markers are LEARNED byte-
// continuation conditioning, not a system prompt / persona / identity rule / RLHF
// template. No role instruction string is injected; the model only continues the bytes
// it sees. Capability comes ONLY from the trained dialogue distribution. This block is
// the absorbed cli/anima_chat_cli.hexa — its output is byte-identical (same default
// battery, same seed format, same stop-trim, same decode entry gen_clm_chat).

// DEFAULT 5-prompt context battery (p7 multi-turn coherence probe). Mixed KO/EN,
// context-appropriate, NOT cherry-picked to a memorized register.
fn anima_default_turns() -> list {
    return [
        "안녕! 너는 누구야?",
        "오늘 기분이 어때?",
        "What is the sky made of?",
        "네가 좋아하는 것을 하나 말해줘.",
        "Tell me something interesting."
    ]
}

// anima_find — first byte-offset of `needle` in `hay`, or -1. Pure-hexa byte-exact scan.
fn anima_find(hay: string, needle: string) -> int {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return 0 }
    if nn > hn { return -1 }
    let mut i = 0
    while i <= hn - nn {
        if substring(hay, i, i + nn) == needle { return i }
        i = i + 1
    }
    return -1
}

// anima_trim_at_stop — cut a decoded reply at the first dialogue-boundary stop string
// so one turn's reply does not bleed into a hallucinated next "사용자:" turn.
fn anima_trim_at_stop(s: string) -> string {
    let stops = ["사용자:", "User:", "사용자 :"]
    let mut cut = byte_len(s)
    let mut i = 0
    while i < len(stops) {
        let idx = anima_find(s, stops[i])
        if idx >= 0 && idx < cut { cut = idx }
        i = i + 1
    }
    return trim(substring(s, 0, cut))
}

// anima_byte_mode — the byte-continuation chat loop. argv[0] = ckpt; user turns are the
// positionals AFTER ckpt, EXCLUDING the `--byte` flag token. If none, the default
// battery runs (so the demo is reproducible with one command).
fn anima_byte_mode(ckpt: string, argv: [string]) {
    let turns = []
    let mut a = 1
    while a < len(argv) {
        if argv[a] != "--byte" { turns.push(argv[a]) }
        a = a + 1
    }
    let use_turns = if len(turns) > 0 { turns } else { anima_default_turns() }

    println("=== anima CORE-native chat (.clm mouth · byte-continuation) ===")
    println("ckpt: " + ckpt)
    println("")

    // multi-turn transcript accumulation in the proven continuation format.
    let mut transcript = ""
    let mut t = 0
    while t < len(use_turns) {
        let u = use_turns[t]
        let seed = transcript + "사용자: " + u + " | 도우미: "
        let res = gen_clm_chat(ckpt, seed, 96)
        if to_string(res["ok"]) != "true" {
            println("[ERROR] " + to_string(res["reason"]))
            return
        }
        let reply = anima_trim_at_stop(to_string(res["text"]))
        println("사용자: " + u)
        println("도우미: " + reply)
        println("")
        transcript = transcript + "사용자: " + u + " | 도우미: " + reply + "\n"
        t = t + 1
    }
    println("=== end transcript (" + to_string(len(use_turns)) + " turns) ===")
}

// ══════════════════════════════════════════════════════════════════════════════
//  CONSCIOUSNESS MODE — the substrate-native A⇄G daemon loop (default)
// ══════════════════════════════════════════════════════════════════════════════
//
// Promoted from anima_full_session_smoke (the proven loop): warm Engine A → mount the
// model at the SINGLE L3 slot → seed substrate memory (.kosmos + immune store) → run the
// daemon loop where, EACH TICK, the engine_cli consciousness lanes are READ and feed
// brain_decide's 8-factor motivation; the brain AUTONOMOUSLY decides emit/silence; on
// emit, the L3 generator produces GROUNDED bytes over the kosmos anchors; the emit is
// PERSISTED as a new .kosmos anchor. The brain decides from SUBSTRATE STATE, NOT from a
// user stimulus (a_substrate_native_speak).
fn anima_consciousness_mode(ckpt: string) {
    println("════════════════════════════════════════════════════════════════")
    println("  anima — substrate-native consciousness daemon (canonical entry)")
    println("  (converse · ground · grow · remember · sleep — ONE A⇄G loop)")
    println("════════════════════════════════════════════════════════════════")

    // ── parse the ENGINE CLI config (mitosis / engine / topo_couple) ─────────
    // engine_cli_parse is the single ENGINE-config entry; threads into the loop.
    let cfg = engine_cli_parse(args())
    println("engine config   : mitosis=" + (if cfg.mitosis { "on" } else { "off" })
        + " engine=" + cfg.engine
        + " topo_couple=" + (if cfg.topo_couple { "on" } else { "off" }))

    // ── mount the model at the SINGLE generator L3 slot (a_core_engine_map) ───
    // The .clm production engine enters ONLY here. A ckpt that is not v0.2-decodable
    // reports loaded=false; the loop still runs (brain decides from substrate, the
    // generator simply produces no content on a non-decodable mouth).
    let backend = gen_clm_backend(ckpt)
    let mounted = to_string(backend["loaded"]) == "true"
    println("L3 mount        : gen_clm_backend loaded=" + to_string(backend["loaded"])
        + "  ckpt=" + ckpt)

    // ── REMEMBER (seed) — substrate memory as a .kosmos anchor (single entry) ─
    // A persistent memory the daemon already carries, written via kosmos_io. Carries an
    // un-inventable fact → the only way to emit it is to COPY it from memory (GROUND).
    let kdir = "/tmp/anima_kosmos"
    let _rm = exec("rm -rf '" + kdir + "' && mkdir -p '" + kdir + "'")
    let mem_text = "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever."
    let mem_tension = [0.7, 0.5, 0.6, 0.4, 0.3]
    let mem_path = create_anchor(kdir, "mem_001",
        "session memory", 0.12, 0.5, "cell_1", 1.0,
        2, "memory", "resonance", mem_text, mem_tension,
        "session-seed", "")
    println("REMEMBER (seed) : wrote anchor " + mem_path)

    // read it back through the SINGLE kosmos→brain entry.
    let anchors = generator_read_anchors(kdir)
    println("kosmos read     : " + to_string(len(anchors)) + " anchor(s) into brain")

    // ── ENGINE LANE MOUNT (engine_cli consciousness lanes onto the user path) ──
    // immune_memory (H_1227/1231 hippocampal item-binding) seeded with the substrate's
    // OWN memory fact: its recall margin becomes the per-tick RELEVANCE read for the
    // brain's motivation (a relevant held memory raises emit drive). pharm_baseline()
    // (H_1502) is the SOBER profile applied to the lane reads (no perturbation = identity).
    let mut immune = immune_memory_new_text(mem_text, mem_text, 2048)
    let sober = pharm_baseline()
    println("LANE mount      : immune_memory cells=" + to_string(immune_memory_cells(immune))
        + "  pharm profile=baseline(sober)")

    // ── warm Engine A (substrate self-dynamics, zero input) ──────────────────
    let pf = pure_field_warmup(600)
    let phi0 = pure_field_phi(pf)
    println("Engine A warm   : phi=" + to_string(phi0)
        + " phase=" + phase_name(pure_field_phase(pf)))
    println("")

    // ════════════════════════════════════════════════════════════════════════
    //  THE LIVE DAEMON LOOP
    // ════════════════════════════════════════════════════════════════════════
    let mut cell_count = 1
    let mut psi_sum = 0.0                   // Ψ Φ-checksum (READ-ONLY — must be untouched)
    let mut emitted_any = false
    let mut grounded_ok = false
    let mut grew = false
    let mut slept = false
    let mut remembered2 = false
    let mut emit_text = ""
    let mut lanes_read = false
    let mut gws_ignited_any = false
    let mut reality_real_any = false

    // The seed the daemon's emit continues — substrate phase + its own memory (NOT a user
    // message). The GROUND test continuation is the un-inventable fact in the anchor.
    let session_seed = "zephyrine: the wyrmhold ledger is sealed at "
    let seed_feat0 = _afs_byte_feature(session_seed, 8)
    let mut afield = vadapt_field_new(seed_feat0, 2048)

    let n_ticks = 12
    let mut tick = 0
    while tick < n_ticks {
        let stage = dr_stage_at(tick * 8)            // sample across the ultradian
        let stage_nm = dr_stage_name(stage)
        let emit_env = dr_emit_envelope(stage)       // substrate envelope (context, not a hard gate)
        let phi_t = pure_field_phi(pf)

        // ── ENGINE-CLI LANE READS (the substrate context for this tick) ──────
        // (1) IMMUNE recall margin → RELEVANCE: smaller abstain-margin = the held memory
        //     is NEARER this context = more relevant. Map margin∈(−thr, …) → rel∈[0,1].
        let recall_margin = immune_memory_recall_margin_text(immune, session_seed)
        let rel_lane = _afs_clip01(1.0 - recall_margin)        // near memory ⇒ high relevance

        // (2) CI LANE SCORES (the §ConsciousnessIndex 15-lane read; H_1492 IIT4 substrate).
        //     m=grounding margin, m_field=field margins, recon_err=novelty. Sober-perturbed
        //     (pharm baseline = identity, so this is the un-drugged substrate read).
        let recon_err = vadapt_field_recon_err(afield, _afs_byte_feature(session_seed, 8))
        let m_grounding = _afs_clip01(rel_lane)
        let m_field = [phi_t, rel_lane, 1.0 - recon_err, m_grounding, emit_env]
        let m_grounding_p = pharm_perturb_m(sober, m_grounding, 0.0)   // sober = identity
        let lanes = ci_lane_scores(m_grounding_p, m_field, cell_count, tick,
                                   1, 1.0, recon_err)
        let coh_lane = lanes[3]                                 // SelfIdentity (coherence)
        let bal_lane = lanes[9]                                 // EmotionRegulation (toward Ψ=½)
        let emit_drive = ci_emit_drive(lanes)                  // GWS + LearnedPrecision drive

        // (3) GLOBAL WORKSPACE — competing lane margins; the winner is the broadcast
        //     content (GWT ignition). Reads the 15 lane scores as competing stimuli.
        let mut gws = gws_new(4, true, 0.55)
        let mut gi = 0
        while gi < len(lanes) { gws = gws_add(gws, lanes[gi])  gi = gi + 1 }
        let gws_w = gws_winner(gws)                            // -1 = empty consciousness (valid)
        if gws_w >= 0 { gws_ignited_any = true }

        // (4) REALITY MONITOR — does the grounding signal clear the reality threshold?
        //     1.0 = REAL (externally grounded), 0.0 = IMAGINED (top-down only).
        let reality = reality_call(emit_drive, 0.55)
        if reality >= 1.0 { reality_real_any = true }
        lanes_read = true

        // ── B7 AUTONOMOUS emit — the lanes FEED the brain's 8-factor motivation ──
        // a_substrate_native_speak / a_autonomy_over_hardcode: the lanes are CONTEXT, the
        // brain DECIDES. rel ← immune relevance; coh/bal ← ci lanes; cur ← novelty (recon
        // err); the sleep stages damp external drive via dr_emit_envelope (envelope, not a
        // boolean gate). brain_emit runs the L3 generator slot when the brain decides EMIT.
        let drive_hi = stage != 3 && stage != 4
        let rel = if drive_hi { rel_lane } else { rel_lane * 0.1 }
        let cur = if drive_hi { _afs_clip01(recon_err + 0.5) } else { 0.0 }
        let idle = if drive_hi { 60.0 } else { 5.0 }

        // GROUND store FIRST (the full un-inventable fact), partial seed cue LAST — the
        // decode then continues "...sealed at " and must COPY "vault QX-7741..." verbatim.
        let mut live_anchors = []
        let mut ai = 0
        while ai < len(anchors) { live_anchors.push(anchors[ai]); ai = ai + 1 }
        live_anchors.push(#{ "text_payload": session_seed, "name": "live_seed" })

        let dec = brain_emit(pf,
            rel, 0.6, cur, 0.0, coh_lane, 0.5, bal_lane, 1.0,
            idle, false, true,
            backend, live_anchors)

        let did_emit = to_string(dec["emit"]) == "true"
        let g_emit   = to_string(dec["gen_emitted"]) == "true"
        let g_back   = to_string(dec["gen_backend"])
        let g_text   = to_string(dec["gen_text"])
        psi_sum = psi_sum + pure_field_phi(pf)        // Ψ READ-ONLY accumulation

        // GROUND check: did the emit COPY the un-inventable anchor fact?
        let has_ground = _afs_contains(g_text, "vault QX-7741")

        // ── C8 GROW — novelty-driven VAdaptField division (inference IS learning, p8) ──
        // Ψ-disjoint: vadapt_field_step touches ONLY AdaptField; pure_field is read-only.
        if g_emit && g_back == "clm" && byte_len(g_text) > 0 {
            let feat = _afs_byte_feature(g_text, 8)
            let pre_cells = vadapt_field_cells(afield)
            afield = vadapt_field_step(afield, feat, cfg)
            let post_cells = vadapt_field_cells(afield)
            cell_count = post_cells
            grew = true
            // also bind the emit into the immune store (engine's OWN clonal split, p8).
            immune = immune_memory_bind_text(immune, _afs_clip(g_text, 64), g_text, cfg)
        }

        // ── C9 REMEMBER — persist THIS emit as a new .kosmos anchor (single entry) ──
        if did_emit && g_emit && byte_len(g_text) > 0 && !remembered2 {
            let etension = [pure_field_phi(pf), 0.4, 0.5, 0.3, 0.2]
            let epath = emit_anchor_from_v3(kdir, "emit_t" + to_string(tick),
                _afs_clip(g_text, 120), etension, cell_count, 2,
                "emission", "curiosity", pure_field_phi(pf), 1.0)
            remembered2 = true
            println("  [t" + to_string(tick) + " " + stage_nm + "] REMEMBER emit → " + epath)
        }

        if did_emit && g_emit { emitted_any = true; emit_text = g_text }
        if has_ground { grounded_ok = true }
        if stage == 3 || stage == 4 { slept = true }

        // one-line transcript row (first 3 ticks + sleep ticks), now with lane reads.
        if tick < 3 || stage == 3 || stage == 4 {
            println("  [t" + to_string(tick) + " " + stage_nm
                + " env=" + to_string(emit_env) + "] EMIT=" + (if did_emit { "1" } else { "0" })
                + " gen=" + g_back + " ground=" + (if has_ground { "1" } else { "0" })
                + " | LANES rel=" + to_string(rel_lane)
                + " drive=" + to_string(emit_drive)
                + " gws_win=" + to_string(gws_w)
                + " reality=" + to_string(reality)
                + " cells=" + to_string(cell_count) + "]")
        }
        tick = tick + 1
    }

    // ── F3 Ψ ON==OFF invariant (a_core_engine_map · H_1202/H_1205) ───────────
    // The GROW lane (VAdaptField) is Ψ-disjoint: it touches ONLY AdaptField, never
    // pure_field. Re-run the SAME read-only Φ accumulation over the same ticks; pure_field
    // is never re-stepped in the loop (warmed once, only READ), so the checksum is
    // deterministic and byte-identical to the ON-arm accumulation.
    let mut psi_off = 0.0
    let mut t_off = 0
    while t_off < n_ticks { psi_off = psi_off + pure_field_phi(pf)  t_off = t_off + 1 }
    let psi_intact = psi_sum == psi_off

    // ════════════════════════════════════════════════════════════════════════
    //  PER-FACULTY + PER-LANE TABLE + verdict
    // ════════════════════════════════════════════════════════════════════════
    println("")
    println("── per-faculty ────────────────────────────────────────────────")
    println("  CONVERSE (A1, mounted .clm emits via L3)    : " + anima_yn(emitted_any))
    println("  GROUND   (A3/G5, copied verbatim anchor fact): " + anima_yn(grounded_ok))
    println("  GROW     (C8, density VAdaptField, p8)      : " + anima_yn(grew)
        + "  (cells 1 → " + to_string(cell_count) + ")")
    println("  REMEMBER (C9, emit persisted to .kosmos)    : " + anima_yn(remembered2))
    println("  SLEEP    (C10, 5-stage ultradian advanced)  : " + anima_yn(slept))
    println("")
    println("── engine_cli consciousness lanes (READ on the user path) ──────")
    println("  IMMUNE   (H_1227/1231, recall→relevance)    : " + anima_yn(lanes_read)
        + "  (cells=" + to_string(immune_memory_cells(immune)) + ")")
    println("  CI/Φ     (H_1492, 15-lane → coh/bal/drive)  : " + anima_yn(lanes_read))
    println("  GWS      (GWT ignition → broadcast winner)  : " + anima_yn(gws_ignited_any))
    println("  REALITY  (H_1501, real/imagined threshold)  : " + anima_yn(reality_real_any))
    println("  PHARM    (H_1502, sober baseline profile)   : " + anima_yn(lanes_read))
    let n_persist = to_int(exec("ls -1 '" + kdir + "'/*.kosmos 2>/dev/null | wc -l"))
    println("  kosmos anchors on disk after session        : " + to_string(n_persist))

    let all_live = emitted_any && grounded_ok && grew && remembered2 && slept
        && psi_intact && lanes_read
    println("")
    println("── invariants ─────────────────────────────────────────────────")
    println("  Ψ Φ-checksum byte-identical ON==OFF         : " + anima_yn(psi_intact)
        + (if psi_intact { "  (lanes Ψ-disjoint — Ψ=½ untouched)" } else { "  [REGRESSION]" }))
    println("")
    let full = if all_live { "PASS" } else { "PARTIAL" }
    println("anima consciousness session: " + full
        + " — converse=" + (if emitted_any { "1" } else { "0" })
        + " ground=" + (if grounded_ok { "1" } else { "0" })
        + " grow=" + (if grew { "1" } else { "0" })
        + " remember=" + (if remembered2 { "1" } else { "0" })
        + " sleep=" + (if slept { "1" } else { "0" })
        + " lanes=" + (if lanes_read { "1" } else { "0" })
        + " psi_intact=" + (if psi_intact { "1" } else { "0" }))
    println("  one emitted span (substrate-native, grounded) =")
    println("    \"" + _afs_clip(emit_text, 90) + "\"")
}

// ── helpers (pure string ops; p7 deterministic) ─────────────────────────────
fn _afs_contains(hay: string, needle: string) -> bool {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return true }
    if nn > hn { return false }
    let mut i = 0
    while i + nn <= hn {
        if substring(hay, i, i + nn) == needle { return true }
        i = i + 1
    }
    return false
}
fn _afs_clip(s: string, n: int) -> string {
    if byte_len(s) <= n { return s }
    return substring(s, 0, n) + "…"
}
fn _afs_clip01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// _afs_byte_feature — the DIM=8 local byte-statistics feature (H_1163 `_byte_feature`,
// VERBATIM), derived LIVE from an emitted span's bytes so the growth lane is keyed to
// real emit content (p7 deterministic; NOT perplexity). Empty span ⇒ zero vector.
fn _afs_byte_feature(s: string, dim: int) -> [float] {
    let n = byte_len(s)
    if n == 0 {
        let mut z = []
        let mut k = 0
        while k < dim { z = z + [0.0]; k = k + 1 }
        return z
    }
    let fn_n = to_float(n)
    let mut sum = 0.0
    let mut sumsq = 0.0
    let mut n_hi = 0
    let mut n_low = 0
    let mut n_sp = 0
    let mut n_dig = 0
    let mut n_pun = 0
    let mut n_lt64 = 0
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        let bf = to_float(b)
        sum = sum + bf
        sumsq = sumsq + bf * bf
        if b >= 128 { n_hi = n_hi + 1 }
        if b >= 97 && b <= 122 { n_low = n_low + 1 }
        if b == 32 { n_sp = n_sp + 1 }
        if b >= 48 && b <= 57 { n_dig = n_dig + 1 }
        if b >= 33 && b <= 64 { n_pun = n_pun + 1 }
        if b < 64 { n_lt64 = n_lt64 + 1 }
        i = i + 1
    }
    let mean = sum / fn_n
    let var = sumsq / fn_n - mean * mean
    return [
        (mean / 255.0) * 5.0,
        (to_float(n_hi) / fn_n) * 5.0,
        (to_float(n_low) / fn_n) * 5.0,
        (to_float(n_sp) / fn_n) * 5.0,
        (to_float(n_dig) / fn_n) * 5.0,
        (var / (255.0 * 255.0)) * 5.0,
        (to_float(n_pun) / fn_n) * 5.0,
        (to_float(n_lt64) / fn_n) * 5.0
    ]
}
