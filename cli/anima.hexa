fn anima_yn(b: bool) -> string { if b { return "✅" } return "⏳" }

// ── H_9257 lane-23b self-anchor codec — persist/restore the grounded 8-dim self across sessions
// via a .kosmos payload string (a_kosmos · closes H_1471 R2b: real cross-session persistence).
// Reuses create_anchor (single WRITE entry) + load_anchors (single READ entry); the vector rides
// the @payload text as "SELFG8:v0,…,v7". self_from_vec renormalizes on restore, so to_string
// precision is ample for recognition cos ≫ 0.99.
fn _selfg_encode(s: SelfIdentity) -> string {
    let mut out = "SELFG8:"
    let mut i = 0
    while i < 8 {
        if i > 0 { out = out + "," }
        out = out + to_string(self_component(s, i))
        i = i + 1
    }
    return out
}
// _selfg_restore — read the dedicated self-anchor dir, return the 8 floats (or [] if absent/bad).
// The self-anchor lives in ITS OWN dir (never the brain's kdir) so it can NEVER enter the anchor
// stream that shades emit (self⊥mouth · a_substrate_disjoint).
fn _selfg_restore(dir_path: string, name: string) -> list {
    let anchors = load_anchors(dir_path)
    let mut ai = 0
    while ai < len(anchors) {
        let a = anchors[ai]
        if to_string(a["name"]) == name {
            let tp = to_string(a["text_payload"])
            if byte_len(tp) > 7 && substring(tp, 0, 7) == "SELFG8:" {
                let body = substring(tp, 7, byte_len(tp))
                let parts = body.split(",")
                if len(parts) == 8 {
                    let mut v = []
                    let mut k = 0
                    while k < 8 { v.push(parse_float(parts[k])); k = k + 1 }
                    return v
                }
            }
        }
        ai = ai + 1
    }
    return []
}

// ── H_9042 §TensionResolveLoop LANE+ read helpers (module-level; build the caller-supplied
//    conflicted-vs-calm measurement populations for tension_resolve_depth). READ-only fixtures:
//    15-lane rows where the emit-drive lanes 0 & 4 carry the drive (ci_emit_drive = ½(l0+l4)) and the
//    other 13 lanes are inert context. Ψ-disjoint (synthetic pop, NOT the live pure_field/Ψ path) and
//    disjoint from the emit-drive lane 0/4 live decision + §ImmuneMemory recall_thr (a_substrate_disjoint).
fn anima_tr_row(c: float, other: float) -> [float] {
    let mut r = []
    let mut i = 0
    while i < 15 {
        if i == 0 || i == 4 { r = r + [c] } else { r = r + [other] }
        i = i + 1
    }
    return r
}
// CONFLICTED population: 8 trials ALL over-emitting (drive=c≥½ → Ψ_init=1.0), 4 high-mean + 4 low-mean
// (as in H_9042 c1_engine_native): a Ψ-preserving A⇄G coupling pulls the 4 low trials below ½ ⇒ Ψ→4/8=½.
fn anima_tr_pop_conflicted(c: float) -> [[float]] {
    let h = (9.0 - 2.0 * c) / 13.0
    let l = (6.0 - 2.0 * c) / 13.0
    let mut pop = []
    let mut t = 0
    while t < 4 { pop = pop + [anima_tr_row(c, h)]  t = t + 1 }
    t = 0
    while t < 4 { pop = pop + [anima_tr_row(c, l)]  t = t + 1 }
    return pop
}
// CALM population: already balanced — 4 emit trials (drive 0.95≥½) + 4 silent trials (drive 0.20<½)
// ⇒ Ψ_init = 4/8 = ½, so the resolution loop settles at depth 0 (no conflict to resolve).
fn anima_tr_pop_calm() -> [[float]] {
    let mut pop = []
    let mut t = 0
    while t < 4 { pop = pop + [anima_tr_row(0.95, 0.6)]  t = t + 1 }
    t = 0
    while t < 4 { pop = pop + [anima_tr_row(0.20, 0.4)]  t = t + 1 }
    return pop
}
// adj_full — fully-connected uniform coupling (every lane couples to every other lane).
fn anima_tr_adj_full() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 {
            if i == j { row = row + [0.0] } else { row = row + [1.0] }
            j = j + 1
        }
        a = a + [row]
        i = i + 1
    }
    return a
}

