            println("  F VERDICT = " + vqF_verdict)
            println("  ── INTERPRETATION ──")
            println("  F COMPETENT+BIND ⇒ first non-additive bind at any seam ⇒ extraordinary, ≥2-seed + WIRE (prior: expect regression).")
            println("  F COMPETENT (S1) ⇒ discrete-code bottleneck grips emit but no BIND ⇒ G1 additive-floor law survives a fifth lens.")
            println("  F THEATER ⇒ fourth orthogonal recoding inert ⇒ read-side recoding family CLOSED (escalation = write-side train-coupling).")
        }
        // ══════════ OPGRIP_R4 F2 window-moved VQ-code VERDICT (Family F · AUTHORITATIVE · calib 100-199, score 200-399) ══════════
        // The powered re-instrument of H_9229: SAME frozen bars (ΔEff 0.10/0.02, margin_cb≥0.08, s2_bind≥0.05 ∧ n_AB≥10,
        // n_visited≥4, POS-PASS, N3=0, Ψ-guard) — this is instrument ZEROING on the driven window (calib 100-199 sees the
        // same stationary 4-class mixture the 200-399 scoring window sees), NOT a bar move (its success modes INCLUDE
        // cementing THEATER, so it cannot be tune-to-green). PLUS a run-wide bar-0 p5 envelope: live emit-fraction on
        // scored mid ∈ [0.05,0.60] else STIM-OVER/UNDERDRIVE (no family cements from the run). r4 = the FINAL shared-tape
        // generation for F and B — a third n_visited<4 parks F op-grip-UNMEASURABLE terminal (mirror of the B2 rule).
        // The tape enters only via the production heard-message seam (og_h_frzF2==0 proves the emit path byte-untouched).
        if og_r3 {
            let midfF2 = if og_vq2F_mid_ticks > 0 { to_float(og_vq2F_mid_ticks) } else { 1.0 }
            let d_eff_vq2F = to_float(og_h_vq2F_mid) / midfF2
            let d_eff_vq2shuf = to_float(og_h_vq2shuf_mid) / midfF2
            let margin_cb2 = d_eff_vq2F - d_eff_vq2shuf
            // ── SECONDARY ARM-INPERM (tick-order stride-perm of the F2 code stream, diagnostic no-bar) ──
            let nF2 = len(og_f3_vq2code)
            let gvq2F_use = if g_vq2 < 0.0 { 0.0 } else { g_vq2 }
            let mut inpermF2_h = 0
            let mut tf2 = 0
            while tf2 < nF2 {
                let stff2 = og_f3_stg[tf2]
                if tf2 >= 200 && (stff2 == 1.0 || stff2 == 2.0 || stff2 == 4.0) {
                    let jf2 = (tf2 * 7 + 13) % nF2
                    let pc2 = to_int(og_f3_vq2code[jf2])
                    let sh_pf2 = _afs_clip01(0.5 + gvq2F_use * vq2_bias[pc2])
                    let idle_pf2 = 5.0 + 55.0 * _afs_clip01(og_f3_senv[tf2] * (0.5 + og_f3_urg[tf2] + (sh_pf2 - 0.5)))
                    let e_pf2 = if to_string(brain_decide_anchored(pf,
                        og_f3_rel[tf2], og_f3_gap[tf2], og_f3_cur[tf2], og_f3_allo[tf2], og_f3_coh[tf2],
                        og_f3_nov[tf2], og_f3_bal[tf2], og_f3_agl[tf2], idle_pf2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                    if to_float(e_pf2) != og_f3_elive[tf2] { inpermF2_h = inpermF2_h + 1 }
                }
                tf2 = tf2 + 1
            }
            let d_eff_inpermF2 = to_float(inpermF2_h) / midfF2
            // ── S2 composition (the G1 BIND test at the seam): non-additivity of emit-effect ──
            let d_eff_A_s22  = if s2_2_n > 0 { to_float(s2_2_a_flip)  / to_float(s2_2_n) } else { 0.0 }
            let d_eff_B_s22  = if s2_2_n > 0 { to_float(s2_2_b_flip)  / to_float(s2_2_n) } else { 0.0 }
            let d_eff_AB_s22 = if s2_2_n > 0 { to_float(s2_2_ab_flip) / to_float(s2_2_n) } else { 0.0 }
            let s2_bind2 = d_eff_AB_s22 - (d_eff_A_s22 + d_eff_B_s22)
            let s2_testable2 = s2_2_n >= 10
            let bind_ok2 = s2_testable2 && s2_bind2 >= 0.05
            // ── Ψ-guard + run-wide bar-0 envelope ──
            let psiF2_off = to_float(og_emit_liveF2_mid) / midfF2
            let psiF2_on  = to_float(og_emit_vq2F_mid) / midfF2
            let psiF2_ok = psiF2_on >= psiF2_off && (psiF2_on - psiF2_off) <= 0.05
            let run_invalidF2 = psiF2_off < 0.05 || psiF2_off > 0.60   // bar-0 emit-frac envelope [0.05,0.60]
            let harnessF2_bug = og_h_frzF2 > 0
            let degenF2 = g_vq2 < 0.0
            let n3F2_ok = og_h_vq2F_n3 == 0
            let comp_S1_2 = d_eff_vq2F >= 0.10 && margin_cb2 >= 0.08
            println("")
            println("──────── OPGRIP_R4 F2 discrete VQ-code (Family F · AUTHORITATIVE · K=8-bit product code · mid=" + to_string(og_vq2F_mid_ticks)
                + " · N=" + to_string(nF2) + " · calib 100-199 · score 200-399 · rides --opgrip-r3 · OG_STIM2 4-class dwell tape) ────────")
            println("  FROZEN byte-identity: og_h_frzF2 = " + to_string(og_h_frzF2) + "  (MUST be 0 — else HARNESS-BUG, run VOID)")
            println("  RUN-VALIDITY (bar-0 · run-wide): live emit-frac on scored mid = " + to_string(psiF2_off) + " (envelope [0.05,0.60]) valid=" + (if run_invalidF2 {"NO — STIM-OVER/UNDERDRIVE"} else {"YES"}))
            println("  POS-CONTROL (reuse dense ARM-SHOCK) = " + to_string(og_h_shock_mid) + " flips · POS-PASS(≥2)=" + (if pos_pass {"YES"} else {"NO"}))
            println("  gain: g_vq2=" + to_string(g_vq2) + " (capsat=" + (if vq2_capsat {"YES"} else {"no"}) + ") · codes visited on scored mid = " + to_string(n_vq2_visited) + " (bar ≥4)")
            println("  ── S1 code-selection ──")
            println("    ΔEff_vq2 = " + to_string(og_h_vq2F_mid) + "/" + to_string(og_vq2F_mid_ticks) + " = " + to_string(d_eff_vq2F) + "   [HEADLINE]")
            println("    ARM-SHUFFLE-CODEBOOK (PRIMARY theater-killer) = " + to_string(og_h_vq2shuf_mid) + " = " + to_string(d_eff_vq2shuf)
                + "  → margin_cb = ΔEff−shuf = " + to_string(margin_cb2) + " (bar ≥0.08)")
            println("    ARM-INPERM (tick-order, SECONDARY diagnostic no-bar) = " + to_string(inpermF2_h) + " = " + to_string(d_eff_inpermF2))
            println("  ── S2 composition (G1 BIND test at the seam · A=coh_lane B=ag_conflict · 2×2 bit-toggle) ──")
            println("    ΔEff_A=" + to_string(d_eff_A_s22) + " ΔEff_B=" + to_string(d_eff_B_s22) + " ΔEff_AB=" + to_string(d_eff_AB_s22)
                + " → s2_bind = AB−(A+B) = " + to_string(s2_bind2) + " (n_AB=" + to_string(s2_2_n) + " · bar ≥0.05 ∧ n_AB≥10) BIND=" + (if bind_ok2 {"YES"} else {"NO (S2 " + (if s2_testable2 {"sub-bar"} else {"NOT-TESTABLE"}) + ")"}))
            println("    GUARDS: N3=" + to_string(og_h_vq2F_n3) + " (must 0) · WAKE=" + to_string(og_h_vq2F_wake)
                + " · Ψ_ON=" + to_string(psiF2_on) + " Ψ_OFF=" + to_string(psiF2_off) + " Ψ-ok=" + (if psiF2_ok {"YES"} else {"NO"})
                + " · axis " + (if degenF2 {"DEGENERATE"} else {"ok"}))
            println("  ── PRE-REG OPGRIP_R4 FROZEN BARS (verbatim · printed BEFORE verdict · p7 no tune-to-green · frozen thresholds byte-identical to H_9229) ──")
            println("  0 RUN-INVALID: emit_frac(e_live, scored mid) ∉ [0.05,0.60] (STIM-OVER/UNDERDRIVE — no family cements from the run)")
            println("  1 HARNESS-BUG(VOID): og_h_frzF2>0 (FROZEN not byte-identical to prod)")
            println("  2 INSTRUMENT-FAIL: POS-FAIL(shock<2) ∨ g=−1.0(codebook flat) ∨ capsat(UNDER-COUPLED)")
            println("  2b PARKED-TERMINAL: n_visited_codes<4 again (bottleneck never engaged even under the 4-class tape) ⇒ F op-grip-UNMEASURABLE, no third instrument generation (r4=final shared-tape gen)")
            println("     [S2 sub-clause: n_AB<10 = combined code never testable ⇒ gates bar-5 BIND only, NOT whole instrument]")
            println("  3 FORCING-GATE(REVERT): N3>0 ∨ Ψ-guard fail (Ψ_ON<Ψ_OFF ∨ Ψ_ON−Ψ_OFF>0.05)")
            println("  4 COMPETENT: n_visited≥4 ∧ S1(ΔEff≥0.10 ∧ margin_cb≥0.08) ∧ POS-PASS ∧ N3=0 ∧ Ψ-guard")
