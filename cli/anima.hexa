        // ══════════ H_9230 efference-copy / corollary-discharge VERDICT (Family E · Fable SPEC 2 · state/9230_efference) ══════════
        // Reuses the H_9225 band-pass transducer on x=ec_x (self-output prediction error). Distinguishing signature = onset-vs-
        // continuation DISSOCIATION (efference copy shapes keep-going, not start). ARM-INPERM = stride-perm of the recorded
        // x_eff stream, re-run with the E-calibrated gain (theater-killer). pos_pass/live_anchors/n9 reused above.
        if og_r3 {
            let midfE = if og_effE_mid_ticks > 0 { to_float(og_effE_mid_ticks) } else { 1.0 }
            let d_eff_effE = to_float(og_h_effE_mid) / midfE
            // ── ARM-INPERM (PRIMARY control): rebuild the band-pass over stride-permuted x_eff j(t)=(t·7+13)%N, same gain. ──
            let nE = len(og_f3_xeff)
            let gE_use = if g_eff < 0.0 { 0.0 } else { g_eff }
            let mut inpermE_h = 0
            let mut ema_f_pe = 0.5   let mut ema_s_pe = 0.5
            let mut te = 0
            while te < nE {
                let je = (te * 7 + 13) % nE
                let xpe = og_f3_xeff[je]
                ema_f_pe = 0.7 * ema_f_pe + 0.3 * xpe   ema_s_pe = 0.95 * ema_s_pe + 0.05 * xpe
                let stfe = og_f3_stg[te]
                if te >= 50 && (stfe == 1.0 || stfe == 2.0 || stfe == 4.0) {
                    let ph_pe = _afs_clip01(0.5 + gE_use * (ema_f_pe - ema_s_pe))
                    let idle_pe = 5.0 + 55.0 * _afs_clip01(og_f3_senv[te] * (0.5 + og_f3_urg[te] + (ph_pe - 0.5)))
                    let e_pe = if to_string(brain_decide_anchored(pf,
                        og_f3_rel[te], og_f3_gap[te], og_f3_cur[te], og_f3_allo[te], og_f3_coh[te],
                        og_f3_nov[te], og_f3_bal[te], og_f3_agl[te], idle_pe, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
