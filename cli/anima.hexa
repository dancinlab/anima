            println("    ΔEff_A=" + to_string(d_eff_A_s2) + " ΔEff_B=" + to_string(d_eff_B_s2) + " ΔEff_AB=" + to_string(d_eff_AB_s2)
                + " → s2_bind = AB−(A+B) = " + to_string(s2_bind) + " (n_AB=" + to_string(s2_n) + " · bar ≥0.05 ∧ n_AB≥10) BIND=" + (if bind_ok {"YES"} else {"NO (S2 " + (if s2_testable {"sub-bar"} else {"NOT-TESTABLE"}) + ")"}))
            println("    GUARDS: N3=" + to_string(og_h_vqF_n3) + " (must 0) · WAKE=" + to_string(og_h_vqF_wake)
