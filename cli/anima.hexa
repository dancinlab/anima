    let rc_correct = reality_confidence_readout(true)             // correct content winner → 0.90 (real & imagined alike)
    let rc_wrong   = reality_confidence_readout(false)            // wrong content → 0.50 chance
    let rc_distinct = rc_correct > rc_wrong && reality_imagery_readout() >= 1.0  // confidence ⊥ reality (flat-null)
    println("LANE+ reality-c : content-correct-conf=" + to_string(rc_correct) + " wrong-conf=" + to_string(rc_wrong)
        + "  content-not-reality-confidence-distinct=" + anima_yn(rc_distinct))

