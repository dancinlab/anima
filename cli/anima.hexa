    // ── (61) OSMOTIC (H_1511) — ↔standard split (KL>C bottleneck trigger ≠ pure L_recon) ──
    let okey0 = [0.0, 0.0, 0.0, 0.0]
    let oval0 = [0.9, 0.1, 0.0, 0.0]                              // winner prior distribution
    let osmo  = osmotic_store_new(okey0, oval0, 8)
    let onkey = [0.4, 0.0, 0.0, 0.0]                             // near key (L2 d=0.4 < cap 0.6)
    let onval = [0.1, 0.9, 0.0, 0.0]                             // divergent val → high KL
    let osmo_split  = osmotic_should_split(osmo, onkey, onval, 1, 5.0, 0.6, 0.0 - 1.0)  // OSMOTIC: d+β·KL > C
    let osmo_ablate = osmotic_should_split(osmo, onkey, onval, 2, 5.0, 0.6, 0.0 - 1.0)  // ABLATED β=0: d<C → false
    let osmo_distinct = osmo_split && !osmo_ablate
    println("LANE+ osmotic   : osmotic-split=" + (if osmo_split { "1" } else { "0" })
        + " ablate(β0)-split=" + (if osmo_ablate { "1" } else { "0" })
        + "  kl-bottleneck-distinct=" + anima_yn(osmo_distinct))

    // ── (62) CATEG-PERCEPT (H_1325) — ↔shuffled labels (real boundary → discrim peak ≠ no boundary) ──
    let cpN = 13
    let cpDIM = 16
    let cpX = cp_stimuli(cpN, cpDIM)
    let mut cppos = []
    let mut cppi = 0
    while cppi < cpN { cppos = cppos + [to_float(cppi) / to_float(cpN - 1)]  cppi = cppi + 1 }
    let cp_curve_b = cp_discrim_curve(cp_fit(cpX, cp_labels_boundary(cppos, 0.5), 16, 16), cpX)  // real boundary
    let cp_curve_s = cp_discrim_curve(cp_fit(cpX, cp_labels_shuffle(cppos, 7), 16, 16), cpX)      // shuffled labels
    let cp_margin_b = cp_within_cross_margin(cp_curve_b, cpN, 0.5)
    let cp_margin_s = cp_within_cross_margin(cp_curve_s, cpN, 0.5)
    let cp_distinct = cp_margin_b > cp_margin_s && cp_coherent_peak_near(cp_curve_b, cpN, 0.5)
    println("LANE+ categ-perc: boundary-margin=" + to_string(cp_margin_b) + " shuffle-margin=" + to_string(cp_margin_s)
        + "  category-boundary-distinct=" + anima_yn(cp_distinct))

    // ── (63) CP-RELOCATE (H_1384) — ↔split-only regrow (move-the-cells peak tracks p_A' ≠ stuck) ──
    let crN = 21
    let crDIM = 16
    let crX = cp_stimuli(crN, crDIM)
    let mut crpos = []
    let mut crpi = 0
    while crpi < crN { crpos = crpos + [to_float(crpi) / to_float(crN - 1)]  crpi = crpi + 1 }
    let crA  = 1.0 / 3.0
    let crAp = 2.0 / 3.0
    let cr1  = cp_fit(crX, cp_labels_boundary(crpos, crA), 24, 24)
    let cr_n1 = cr1.n
    let cr_split = cp_peak_loc_idx(cp_discrim_curve(cp_regrow(cr1, crX, cp_labels_boundary(crpos, crAp), 24, 24), crX))
    let cr_reloc = cp_peak_loc_idx(cp_discrim_curve(cp_relocate(cr1, crX, crpos, cp_labels_boundary(crpos, crAp), crAp, 0.15, cr_n1, crDIM, 24), crX))
    let cr_split_pk = (to_float(cr_split) + 0.5) / to_float(crN - 1)
    let cr_reloc_pk = (to_float(cr_reloc) + 0.5) / to_float(crN - 1)
    let cr_split_err = if cr_split_pk > crAp { cr_split_pk - crAp } else { crAp - cr_split_pk }
    let cr_reloc_err = if cr_reloc_pk > crAp { cr_reloc_pk - crAp } else { crAp - cr_reloc_pk }
    let cr_distinct = cr_reloc_err < cr_split_err                  // relocation tracks moved boundary; split-only lags
    println("LANE+ cp-reloc  : reloc-peak=" + to_string(cr_reloc_pk) + " split-only-peak=" + to_string(cr_split_pk)
        + " (p_A'=0.667)  move-the-cells-distinct=" + anima_yn(cr_distinct))

    // ── (64) METACOG-CTRL (H_1508) — ↔margin-blind (RPL margin-aware allocation lift ≠ uniform) ──
    let mcc_lift = mc_control_lift(4297, 6)                        // RPL reads live margin → recovery lift
    let mcc_abl  = mc_control_lift_ablated(4297, 6)                // margin-blind uniform → ~0 lift
    let mcc_distinct = mcc_lift > mcc_abl
    println("LANE+ metacog-c : rpl-lift=" + to_string(mcc_lift) + " margin-blind=" + to_string(mcc_abl)
        + "  metacog-control-distinct=" + anima_yn(mcc_distinct))

    // ── (65) METACOG-AUROC (H_1506 type-2) — ↔shuffle (meta-d' discriminates genuine vs halluc ≠ chance) ──
    let mauroc      = mi_metad_auroc(4297, 12)                     // type-2 AUROC > 0.5 (insight sorts)
    let mauroc_shuf = mi_shuffle_auroc(4297, 12)                   // shuffled percept↔signal → chance ~0.5
    let mauroc_distinct = mauroc > 0.5 && mauroc > mauroc_shuf
    println("LANE+ metacog-a : type2-auroc=" + to_string(mauroc) + " shuffle-auroc=" + to_string(mauroc_shuf)
        + "  meta-d'-sensitivity-distinct=" + anima_yn(mauroc_distinct))

    // ── (66) FIELD-PCI (H_1503) — DEFERRED: the chosen single-channel perturbation args yield a
