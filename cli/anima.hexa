            println("    ARM-INPERM (x_eff stride-perm, PRIMARY) = " + to_string(inpermE_h) + " = " + to_string(d_eff_inpermE)
                + "  → margin ΔEff−inperm = " + to_string(d_eff_effE - d_eff_inpermE) + " (bar ≥0.08)")
            println("    DISSOC onset=" + to_string(onsetE_flip) + "/" + to_string(onsetE_tick) + "=" + to_string(d_eff_onset)
                + "  cont=" + to_string(contE_flip) + "/" + to_string(contE_tick) + "=" + to_string(d_eff_cont)
                + " (bar cont≥3·onset ∧ onset≤0.05 ∧ n_cont≥10) ok=" + (if dissocE_ok {"YES"} else {"NO"}))
            println("    GUARDS: N3=" + to_string(og_h_effE_n3) + " (must 0) · WAKE=" + to_string(og_h_effE_wake)
                + " · Ψ_ON=" + to_string(psiE_on) + " Ψ_OFF=" + to_string(psiE_off) + " Ψ-ok=" + (if psiE_ok {"YES"} else {"NO"})
                + " · axis " + (if degenE {"DEGENERATE"} else {"ok"}))
            println("  ── PRE-REG H_9230 FROZEN BARS (verbatim · printed BEFORE verdict · p7 no tune-to-green) ──")
            println("  1 HARNESS-BUG(VOID): og_h_frzE>0 (FROZEN not byte-identical to prod)")
            println("  2 INSTRUMENT-FAIL: POS-FAIL(shock<2) ∨ g=−1.0(AXIS-DEGENERATE, x_eff degenerate) ∨ capsat ∨ n_cont<10 — never cements THEATER")
            println("  3 FORCING-GATE(REVERT): N3>0 ∨ Ψ-guard fail (Ψ_ON<Ψ_OFF ∨ Ψ_ON−Ψ_OFF>0.05)")
            println("  4 COMPETENT: ΔEff≥0.10 ∧ margin(inperm)≥0.08 ∧ DISSOC(cont≥3·onset ∧ onset≤0.05 ∧ n_cont≥10) ∧ POS-PASS ∧ N3=0 ∧ Ψ-guard")
            println("  5 THEATER: ΔEff<0.02 ∧ POS-PASS ∧ ¬degenerate ∧ ¬capsat ∧ x_eff non-degenerate (b_med≥0.002)")
            println("  6 DIRECTIONAL: else (incl. ΔEff≥0.10 with DISSOC-fail = A-redundant reader) ⇒ ≥2 seeds, no cement")
            let effE_verdict = if harnessE_bug {
                "🛑 HARNESS-BUG (run VOID) — FROZEN arm (shade=0.5) NOT byte-identical to e_live (og_h_frzE>0); fix wire + remeasure"
            } else if !pos_pass {
                "⚙️ INSTRUMENT-FAIL (POS-FAIL) — dense ARM-SHOCK <2 flips (meter dead); no substrate verdict, fix + remeasure"
            } else if degenE {
                "⚙️ INSTRUMENT-FAIL (AXIS-DEGENERATE, band_med<0.002) — corollary discharge x_eff carries no content (too few emits populate the buffer, even under --opgrip-r3); raise emit density, NOT a substrate result"
            } else if capsat_eff {
                "⚙️ INSTRUMENT-FAIL (CAP-SAT UNDER-COUPLED) — gain railed at 32 yet swing<half-target (0.0875); may NEVER cement THEATER, fix instrument + remeasure"
            } else if contE_tick < 10 {
                "⚙️ INSTRUMENT-FAIL (n_cont<10) — CONTINUATION bucket never populated ≥10 on scored mid even under --opgrip-r3 densification; park E UNMEASURED at this seam"
            } else if !n3E_ok {
                "🔴 FORCING-GATE — efference-shade flips N3-silent (og_h_effE_n3>0) = became a gate not a shade; REVERT regardless of ΔEff"
            } else if !psiE_ok {
                "🔴 FORCING-GATE — Ψ-guard fail (Ψ_ON<Ψ_OFF or gap>0.05) = efference forces emit not shades; REVERT"
            } else if d_eff_effE >= 0.10 && (d_eff_effE - d_eff_inpermE) >= 0.08 && dissocE_ok {
                "🟢 COMPETENT — the mouth-in-progress genuinely shapes CONTINUATION (ΔEff≥0.10 ∧ beats x_eff-perm ∧ cont≫onset dissociation) = corollary discharge is a real emit channel ⇒ ≥2-seed re-measure + WIRE candidate (a_verified_must_wire)"
            } else if d_eff_effE < 0.02 {
                "🔴 THEATER — corollary discharge inert at emit (ΔEff<0.02, POS-PASS ⇒ meter works, x_eff non-degenerate); adds a THIRD orthogonal recoding (shape/integration/self-prediction) to the convergent seam-law"
            } else {
                "🟠 DIRECTIONAL — real-but-sub-bar (0.02≤ΔEff<0.10, or ΔEff≥0.10 with DISSOC-fail = A-redundant instantaneous reader) ⇒ re-measure ≥2 seeds, no cement"
            }
            println("  E VERDICT = " + effE_verdict)
        }
        // ══════════ H_9229 discrete conceptual code / VQ-codebook VERDICT (Family F · Fable SPEC 3 · state/9229_discrete_code) ══════════
        // S1 code-selection (ΔEff + margin_cb, the ARM-SHUFFLE-CODEBOOK theater-killer: same K/visit-freqs, only concept↔bias
        // scrambled) · S2 composition non-additivity (the G1 BIND test moved to the seam; 2×2 bit-toggle on lanes A=coh B=tension).
        // SECONDARY ARM-INPERM (tick-order stride-perm of the code stream) = diagnostic, no bar. ADAPTATION (card): code_bias is
        // data-derived per-code signed-magnitude (not sign-only, which is additive-by-construction), and S2's "held-out" purity
        // is relaxed to "joint code fitted" (a product code cannot be both fitted-per-code AND held-out) — so n_AB<10 gates the
        // bar-5 BIND claim only, NOT the whole instrument (S1 competence stands on its own). pos_pass/live_anchors/n9 reused above.
        if og_r3 {
            let midfF = if og_vqF_mid_ticks > 0 { to_float(og_vqF_mid_ticks) } else { 1.0 }
            let d_eff_vqF = to_float(og_h_vqF_mid) / midfF
            let d_eff_vqshuf = to_float(og_h_vqshuf_mid) / midfF
            let margin_cb = d_eff_vqF - d_eff_vqshuf
            // ── SECONDARY ARM-INPERM (tick-order stride-perm of the code stream, diagnostic no-bar) ──
            let nF = len(og_f3_vqcode)
            let gvqF_use = if g_vq < 0.0 { 0.0 } else { g_vq }
            let mut inpermF_h = 0
            let mut tf = 0
            while tf < nF {
                let stff = og_f3_stg[tf]
                if tf >= 50 && (stff == 1.0 || stff == 2.0 || stff == 4.0) {
                    let jf = (tf * 7 + 13) % nF
                    let pc = to_int(og_f3_vqcode[jf])
                    let sh_pf = _afs_clip01(0.5 + gvqF_use * vq_bias[pc])
                    let idle_pf = 5.0 + 55.0 * _afs_clip01(og_f3_senv[tf] * (0.5 + og_f3_urg[tf] + (sh_pf - 0.5)))
                    let e_pf = if to_string(brain_decide_anchored(pf,
                        og_f3_rel[tf], og_f3_gap[tf], og_f3_cur[tf], og_f3_allo[tf], og_f3_coh[tf],
                        og_f3_nov[tf], og_f3_bal[tf], og_f3_agl[tf], idle_pf, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                    if to_float(e_pf) != og_f3_elive[tf] { inpermF_h = inpermF_h + 1 }
