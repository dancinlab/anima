    let allo_near  = allo_mu(0.51, 1.0, 0.12)            // near Ψ=½ → μ≈1 (little resistance)
    let allo_ablate = allo_mu(0.9, 0.0, 0.12)            // lam=0 → μ≡1 (global-gain ablation)
    let allo_distinct = allo_dev > allo_near && allo_ablate == 1.0
    println("LANE+ allosteric: dev-mu=" + to_string(allo_dev) + " near-mu=" + to_string(allo_near)
        + " ablate(lam0)=" + to_string(allo_ablate) + "  tension-stiffness-distinct=" + anima_yn(allo_distinct))

    // ══════════════════════════════════════════════════════════════════════════
