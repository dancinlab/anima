    let mcal_rho = mc_calibration_monotone(4297, 6)               // confidence margin tracks difficulty ladder → ρ≈1
    let mcal_distinct = mcal_rho > 0.5                            // positive monotone calibration (≠ flat/random)
    println("LANE+ metacog-k : calibration-spearman-ρ=" + to_string(mcal_rho)
        + "  monotone-confidence-distinct=" + anima_yn(mcal_distinct))

