    // ── (53) NEUROPHARM-SIG (H_1502) — ↔sober PHARM (drug ego-dissolution ≠ baseline) ──
    let np_lsd   = pharm_self_continuity(pharm_lsd(), 16, 7)        // 5-HT2A REBUS → ego dissolution < 1
    let np_ket   = pharm_self_continuity(pharm_ketamine(), 16, 7)   // NMDA-antagonist dissociative < 1
    let np_sober = pharm_self_continuity(pharm_baseline(), 16, 7)   // sober identity → 1.0
    let np_distinct = np_sober > np_lsd && np_sober > np_ket        // both drugs dissolve, sober intact
    println("LANE+ neuropharm: sober=" + to_string(np_sober) + " lsd=" + to_string(np_lsd)
        + " ketamine=" + to_string(np_ket) + "  drug-signature-distinct=" + anima_yn(np_distinct))

    // ── (54) LIBIDO (H_1504) — ↔homeostat hunger (cue-incentive 'wanting' ≠ setpoint deficit) ──
    let lib_want_da = libido_wanting(libido_new_da(0.8), 0.4, 0.9)  // dopaminergic gain → high WANTING
    let lib_want_pl = libido_wanting(libido_new(), 0.4, 0.9)        // no da gain → lower wanting
    let lib_distinct = lib_want_da > lib_want_pl
        && libido_liking(libido_new_da(0.8), 0.9) == libido_liking(libido_new(), 0.9)  // liking gain-invariant (Berridge)
    println("LANE+ libido    : wanting-da=" + to_string(lib_want_da) + " wanting-plain=" + to_string(lib_want_pl)
        + " (liking gain-invariant)  wanting-not-liking-distinct=" + anima_yn(lib_distinct))

    // ── (55) TRANS-ORDER (H_1429) — ↔item-store (transitive INFERENCE ≠ per-pair lookup) ──
    let mut tord = trans_order_new()
    tord = trans_order_premise(tord, "A", "B")
    tord = trans_order_premise(tord, "B", "C")
    tord = trans_order_premise(tord, "C", "D")
    tord = trans_order_integrate(tord)
    let tord_inf  = trans_order_higher(tord, "A", "D")             // UNOBSERVED pair → infers "A"
    let tord_item = trans_order_item_higher(tord, "A", "D")        // item-store → abstains ""
    let tord_distinct = tord_inf == "A" && tord_item == ""
    println("LANE+ trans-ord : infer(A,D)=\"" + tord_inf + "\" item-store(A,D)=\"" + tord_item
        + "\"  latent-rank-distinct=" + anima_yn(tord_distinct))

