    let mut bB2_med_slf = 0.0     let mut bB2_med_ten = 0.0     // median |x − x_base| over calib (gain-normalizer · STIM source)
    let mut gB2_slf = -2.0        let mut gB2_ten = -2.0        // accumulator gains — RE-SET by calib median (tick 200); -2.0=uncalibrated
    let mut capsatB2_slf = false  let mut capsatB2_ten = false  // CAP-SAT guard: g==32 ∧ 32·b_med<0.0875 (UNDER-COUPLED)
    let mut runlenB2_slf = 0      let mut runsgnB2_slf = 0.0    // SELF latency: same-sign bias run length + sign (deadband 0.5·b_med)
    let mut runlenB2_ten = 0      let mut runsgnB2_ten = 0.0    // TEN  latency run length + sign
    let mut swingB2_max_slf = 0.0 let mut swingB2_max_ten = 0.0 // max |G·acc| held (STIM-ABSENT if < 0.0875 = never half-charged)
    let mut og_h_slfB2_mid = 0    let mut og_h_slfB2_n3 = 0     let mut og_h_slfB2_wake = 0   // SELF ΔEff numerator / guards
    let mut og_h_tenB2_mid = 0    let mut og_h_tenB2_n3 = 0     let mut og_h_tenB2_wake = 0   // TEN  ΔEff numerator / guards
    let mut og_h_frzB2 = 0        // FROZEN arm (shade pinned 0.5) mismatch vs e_live — MUST be 0 (HARNESS-BUG else, run VOID)
    let mut og_emit_slfB2_mid = 0 let mut og_emit_tenB2_mid = 0 // Ψ-guard numerators (ARM-LIVE accumulator emit count on B2 mid)
    let mut og_emit_liveB2_mid = 0   // production e_live emits on B2 scored mid (run-validity envelope + Ψ_OFF)
    let mut og_slfB2_mid_ticks = 0   // B2 scored-mid denominator (tick≥200, stages 1/2/4) — = 120 by construction
    let mut earlyB2_tick_slf = 0 let mut earlyB2_flip_slf = 0 let mut lateB2_tick_slf = 0 let mut lateB2_flip_slf = 0 // SELF latency buckets
    let mut earlyB2_tick_ten = 0 let mut earlyB2_flip_ten = 0 let mut lateB2_tick_ten = 0 let mut lateB2_flip_ten = 0 // TEN  latency buckets
    // ── H_9230 efference-copy / corollary-discharge carriers (Family E · Fable SPEC 2 · state/9230_efference) ──
    // Reuses the H_9225 dual-EMA band-pass transducer VERBATIM on a NEW signal source: x_eff = corollary discharge =
    // realized own-output − predicted own-output (self-prediction error). ec_pred = EMA of mean8(gl_feat) updated ONLY on
    // emit ticks (the real-decode seam below, where gl_feat exists); ec_x = the 1-tick-lagged discharge the E arm reads
    // (like og_prev_gfeat). RIDES --opgrip-r3 (real decode → gl_feat exists · densified emits → n_cont≥10). Distinguishing
    // signature = onset-vs-continuation dissociation (efference copy shapes keep-going, not start). Own DISJOINT lane; prod
    // idle/e_live BYTE-UNTOUCHED — FROZEN arm (shade=0.5 ⇒ idle_frzE ≡ prod idle) is the byte-identity proof.
    let mut ec_pred = _og_mean(seed_feat0)   // corollary buffer: EMA of own emitted-output scalar (expected utterance); seeded to boot feature
    let mut ec_x = 0.0                        // 1-tick-lagged corollary discharge (realized − predicted), read by the E arm
    let mut ema_f_eff = 0.5   let mut ema_s_eff = 0.5   // E dual-EMA band-pass (x = ec_x); α_f=0.30 α_s=0.05 (verbatim H_9225)
    let mut g_eff = -2.0                      // E band-pass gain — RE-SET by calib median (tick 50); -2.0 = uncalibrated
    let mut band_devs_eff = []                // calib |band_eff| samples (ticks 10-49) → median → g_eff
    let mut band_med_eff = 0.0                // calibrated band median (CAP-SAT source)
    let mut capsat_eff = false                // gain railed at 32 ∧ swing<half-target (UNDER-COUPLED)
    let mut og_h_effE_mid = 0   let mut og_h_effE_n3 = 0   let mut og_h_effE_wake = 0   // E ΔEff numerator / guards
    let mut og_h_frzE = 0                     // FROZEN arm (shade 0.5) mismatch vs e_live — MUST be 0 (HARNESS-BUG else, run VOID)
    let mut og_emit_effE_mid = 0  let mut og_emit_liveE_mid = 0   // Ψ-guard numerators (ARM-LIVE / e_live emit counts on E mid)
    let mut og_effE_mid_ticks = 0             // E scored-mid denominator (tick≥50, stages 1/2/4)
    let mut elive_p1 = 0   let mut elive_p2 = 0   // e_live at t-1 / t-2 (onset/continuation bucketer)
    let mut onsetE_tick = 0  let mut onsetE_flip = 0  let mut contE_tick = 0  let mut contE_flip = 0   // dissociation buckets
    let mut og_f3_xeff = []                    // per-tick x_eff (ARM-INPERM stride-perm source)
    // ── H_9229 discrete conceptual code / VQ-codebook carriers (Family F · Fable SPEC 3 · state/9229_discrete_code) ──
    // A K=8-bit product VQ codebook between the 8 substrate lanes and the gate: state8 = [rel_lane, af_val, allo_ctx,
    // coh_lane, bal_lane, nov_ctx, gap_ctx, ag_conflict] (the ev_axis lanes) snapped to a discrete code_id (one bit per
    // lane vs its calib median), gate shaded by a FROZEN per-code bias (data-derived mean signed deviation over calib —
    // content-addressed). S1 code-selection (ΔEff+margin_cb) · S2 composition above additive floor (the G1 BIND test moved
    // to the output seam). THEATER-killer = ARM-SHUFFLE-CODEBOOK (permute the code→bias map, same visit freqs/marginals).
    // RIDES --opgrip-r3 (driven lanes cross code boundaries · emits fill the AB bucket). Own DISJOINT lane; prod idle/e_live
    // BYTE-UNTOUCHED — FROZEN arm (shade=0.5 ⇒ idle_frzF ≡ prod idle). ADAPTATION (documented, card): the spec's sign-only
    // code_bias is main-effect-additive BY CONSTRUCTION (every sample in a code shares its bit pattern), so S2 would be
    // untestable; we use the data-derived per-code mean SIGNED-MAGNITUDE deviation (∴ a joint code CAN carry non-additive
    // weight) — the only change that makes the BIND test measurable rather than 0-by-construction. Held-out purity is
    // relaxed to "joint code fitted" (a product code cannot be both fitted per-code AND held-out) — noted honestly.
    let mut vqc_l0 = []  let mut vqc_l1 = []  let mut vqc_l2 = []  let mut vqc_l3 = []   // per-lane calib samples (ticks 10-49) → medians
    let mut vqc_l4 = []  let mut vqc_l5 = []  let mut vqc_l6 = []  let mut vqc_l7 = []
    let mut vq_med = [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]   // per-lane calib medians (code split points) — set tick 50
    let vq_pow2 = [1, 2, 4, 8, 16, 32, 64, 128]                 // 2^a per lane (code_id = Σ pow2[a]·bit_a)
    let vq_lA = 3   let vq_lB = 7                               // S2 composition lanes: A=coh_lane B=ag_conflict (tension)
    let mut vq_bias = []       // frozen per-code bias (data-derived mean signed-mag dev, clip[-1,1]) — set tick 50 (256 codes)
    let mut vq_cnt = []        // per-code calib visit count (S2 fitted-code test + code_bias denominator)
    let mut vq_shufbias = []   // ARM-SHUFFLE-CODEBOOK permuted bias map (fixed derangement c→(c·37+11)%256)
    let mut vq_visited = []    // scored-window per-code visited flag (n_visited_codes≥4 bar)
    let mut vqi_init = 0
    while vqi_init < 256 { vq_bias.push(0.0)  vq_cnt.push(0.0)  vq_shufbias.push(0.0)  vq_visited.push(0.0)  vqi_init = vqi_init + 1 }
    let mut g_vq = -2.0        // shade gain — calibrated to swing 0.175 at tick 50 (median |code_bias| over calib)
    let mut vq_capsat = false  // gain railed at 32 ∧ swing<half-target
    let mut og_h_vqF_mid = 0   let mut og_h_vqF_n3 = 0   let mut og_h_vqF_wake = 0   // F ΔEff numerator / guards
    let mut og_h_frzF = 0                     // FROZEN arm (shade 0.5) mismatch vs e_live — MUST be 0 (HARNESS-BUG else, run VOID)
    let mut og_h_vqshuf_mid = 0               // ARM-SHUFFLE-CODEBOOK ΔEff (primary theater-killer: margin_cb = live − shuf)
    let mut og_emit_vqF_mid = 0  let mut og_emit_liveF_mid = 0   // Ψ-guard numerators (ARM-LIVE / e_live emit counts on F mid)
    let mut og_vqF_mid_ticks = 0              // F scored-mid denominator (tick≥50, stages 1/2/4)
    let mut n_vq_visited = 0                  // distinct codes visited on scored mid (bottleneck-engaged bar ≥4)
    let mut s2_n = 0  let mut s2_a_flip = 0  let mut s2_b_flip = 0  let mut s2_ab_flip = 0   // S2 composition buckets (2×2 bit-toggle)
    let mut og_f3_vqcode = []                 // per-tick code_id (secondary ARM-INPERM tick-order stride-perm source)
    // ── OPGRIP_R4 F2 window-moved VQ-code carriers (Family F · calib 100-199, score 200-399, driven regime) ──
    // Arithmetic byte-VERBATIM the H_9229 F arm (same 8-lane product code, data-derived signed-magnitude per-code
    // bias, 0.175 swing target, −1.0 AXIS-DEGENERATE clause, ARM-SHUFFLE-CODEBOOK derangement, S2 2×2 bit-toggle) —
    // ONLY the calibration/scoring windows move into the perception-tape-driven regime (calib 100-199, freeze at
    // tick 200, score 200-399, denominator 120). The OLD F arm (calib 10-49 = boot transient + first-onset, its
    // median zeroed on a spin-up regime the driven field then drifts away from → all bits saturate → n_visited=2
    // #3233 INSTRUMENT-FAIL) keeps running DIAGNOSTIC-ONLY. 100-sample calib (vs 40) populates more of the 256 cells
    // so S2's four-cell fitted requirement is satisfiable. Prod idle/e_live BYTE-UNTOUCHED (FROZEN og_h_frzF2==0).
    let mut vq2c_l0 = []  let mut vq2c_l1 = []  let mut vq2c_l2 = []  let mut vq2c_l3 = []   // per-lane calib samples (ticks 100-199) → medians
    let mut vq2c_l4 = []  let mut vq2c_l5 = []  let mut vq2c_l6 = []  let mut vq2c_l7 = []
    let mut vq2_med = [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]   // per-lane calib medians (code split points) — set tick 200
    let mut vq2_bias = []       // frozen per-code bias (data-derived mean signed-mag dev, clip[-1,1]) — set tick 200 (256 codes)
    let mut vq2_cnt = []        // per-code calib visit count (S2 fitted-code test + code_bias denominator)
    let mut vq2_shufbias = []   // ARM-SHUFFLE-CODEBOOK permuted bias map (fixed derangement c→(c·37+11)%256)
    let mut vq2_visited = []    // scored-window per-code visited flag (n_visited_codes≥4 bar)
    let mut vq2i_init = 0
    while vq2i_init < 256 { vq2_bias.push(0.0)  vq2_cnt.push(0.0)  vq2_shufbias.push(0.0)  vq2_visited.push(0.0)  vq2i_init = vq2i_init + 1 }
    let mut g_vq2 = -2.0        // shade gain — calibrated to swing 0.175 at tick 200 (median |code_bias| over calib)
    let mut vq2_capsat = false  // gain railed at 32 ∧ swing<half-target
    let mut og_h_vq2F_mid = 0   let mut og_h_vq2F_n3 = 0   let mut og_h_vq2F_wake = 0   // F2 ΔEff numerator / guards
    let mut og_h_frzF2 = 0                    // FROZEN arm (shade 0.5) mismatch vs e_live — MUST be 0 (HARNESS-BUG else, run VOID)
    let mut og_h_vq2shuf_mid = 0              // ARM-SHUFFLE-CODEBOOK ΔEff (primary theater-killer: margin_cb = live − shuf)
    let mut og_emit_vq2F_mid = 0  let mut og_emit_liveF2_mid = 0   // Ψ-guard / envelope numerators (ARM-LIVE / e_live emit counts on F2 mid)
    let mut og_vq2F_mid_ticks = 0             // F2 scored-mid denominator (tick≥200, stages 1/2/4) — = 120 by construction
    let mut n_vq2_visited = 0                 // distinct codes visited on F2 scored mid (bottleneck-engaged bar ≥4)
    let mut s2_2_n = 0  let mut s2_2_a_flip = 0  let mut s2_2_b_flip = 0  let mut s2_2_ab_flip = 0   // F2 S2 composition buckets (2×2 bit-toggle)
    let mut og_f3_vq2code = []                // per-tick F2 code_id (secondary ARM-INPERM tick-order stride-perm source)
    // op-grip measurement mode (--opgrip): 200-tick 5-arm decision ablation, NO decode
    // ($0). Reproduces the pre-fix baseline (theater) AND measures post-fix grip in one run.
    // --opgrip-live (H_9210 next-step ①, OPGRIP_LIVE_spec.md): SAME machinery + one REAL
    // det-argmax decode per live-emit tick so recon_err/surprise becomes CONTENT-driven —
    // resolves the AXIS-DEGENERATE INSTRUMENT-FAIL of $0 no-decode (with no g_text the field
    // never stepped → recon_err constant → g_surp=-1.0). POOL round (summer/aiden), NEVER mini
    // (303M heavy decode = swap OOM rc=137). Default --opgrip stays byte-identical (og_live-gated).
    // --opgrip-r3 (Fable SPEC 1 · H_9226 B-density instrument fix) IMPLIES og_live: it needs real
    // decode (SELF/TEN drive needs real emits stepping afield) + a driven perception tape (below) +
    // n=400 (calib 100-199 / score ≥200) so Family B's accumulator gets a real bias to integrate.
    let og_r3 = anima_has_flag(anima_collect_argv(args()), "--opgrip-r3")
    let og_live = anima_has_flag(anima_collect_argv(args()), "--opgrip-live") || og_r3
    let og_measure = anima_has_flag(anima_collect_argv(args()), "--opgrip") || og_live
    let mut og_wake = 0            // wake ticks
    let mut og_emit_wake = 0       // wake ticks the LIVE (post-fix) arm emits (collapse FLAG)
    let mut og_h_relfr = 0         // Hamming: full-rel_ctx frozen vs live (all ticks)
    let mut og_h_relfr_w = 0       //   … wake-only
    let mut og_h_agl = 0           // Hamming: single-op agloop frozen vs live
    let mut og_h_agl_w = 0         //   … wake-only
    let mut og_h_zero = 0          // Hamming: rel_ctx→0 vs live
    let mut og_h_shuf = 0          // Hamming: rel_ctx→LCG-shuffle vs live
    let mut og_h_base = 0          // Hamming: pre-fix baseline arms (should be 0 = theater)
    let mut og_base_floor = 0      // baseline wake ticks whose motivation floor > 0.3
    // ── H_9101 design (b): stage-conditional URGENCY-freeze dissociation (the shade-vs-gate test) ──
    let mut og_rem_ticks = 0       // REM ticks (stage 4)
    let mut og_n3_ticks  = 0       // N3 ticks (stage 3)
    let mut og_wake_ticks = 0      // WAKE ticks (stage 0)
    let mut og_mid_ticks = 0       // intermediate-env ticks (stage 1/2/4)
    let mut og_h_u0_rem  = 0       // Hamming(urgency→0 vs live) on REM     — GRIP test
    let mut og_h_u0_n3   = 0       // Hamming(urgency→0 vs live) on N3       — PRESERVATION test (must be 0)
    let mut og_h_u0_wake = 0       // Hamming(urgency→0 vs live) on WAKE     — saturated control
    let mut og_h_u0_mid  = 0       // Hamming(urgency→0 vs live) on mid-env  — broad grip
    let mut og_h_us_rem  = 0       // Hamming(urgency→shuffle vs live) on REM — control
    let mut og_h_us_n3   = 0       // Hamming(urgency→shuffle vs live) on N3  — control
    // ── TENSION→ADAPTATION 2-arm (this task): phasic A⇄G tension grip on emit ──
    let mut og_h_tenfrz  = 0       // Hamming(ten_phasic→0.5 [Δ=0] vs live) on discriminating (env>0) ticks
    let mut og_tenfrz_disc = 0     // discriminating ticks (stage != 3; N3 env=0 nulls urgency → both arms equal)
    // ── H_9102 (F3) faculty-not-noise: per-tick RECORDS for the variance-matched noise arm ──
    // We record every tick's urgency op-signal, stage envelope, the LIVE emit boolean, the stage,
    // the 8 brain_decide args, and 4 DOWNSTREAM substrate-appropriateness signals (tension /
    // conflict / novelty / grounded). AFTER the loop we build a VARIANCE-MATCHED noise (a temporal
    // PERMUTATION of the real urgency multiset — exact mean/var, meaning destroyed) and, via the SAME
    // engine call (brain_decide_anchored, NO numpy), recompute the noise-gated emit pattern, then
    // compare corr(emit-timing, downstream) for the REAL op vs the matched noise. ρ_real − ρ_noise ≥
    // 0.15 = the grip is a substrate FACULTY (op gates emit at substrate-meaningful ticks); < 0.15 =
    // the grip is centering-noise-driven (a subtler theater at the op layer). pf is READ-only across
    // the loop (never re-stepped) so a post-loop re-decode with a different `idle` is byte-faithful.
    let mut og_f3_surp = []        // H_9210 surp_phasic per tick (ARM-PERM source)
    let mut og_f3_self = []        // H_9209 self_phasic per tick (variance-matched ARM-PERM source)
    let mut og_f3_selfev = []      // H_9209 self-drift event fired this tick (align-margin: flips near events)
    let mut og_f3_eslf = []        // H_9209 ARM-LIVE (self-shaded) emit per tick
    let mut og_f3_urg  = []        // urgency op-signal per tick (the REAL signal to variance-match)
    let mut og_f3_senv = []        // stage_env per tick
    let mut og_f3_elive = []       // LIVE emit boolean (0/1) per tick
    let mut og_f3_stg  = []        // stage int per tick
    let mut og_f3_rel  = []        // brain_decide arg: rel
    let mut og_f3_gap  = []        //   gap_ctx
    let mut og_f3_cur  = []        //   cur
    let mut og_f3_allo = []        //   allo_ctx
    let mut og_f3_coh  = []        //   coh_lane
    let mut og_f3_nov  = []        //   nov_ctx
    let mut og_f3_bal  = []        //   bal_lane
    let mut og_f3_agl  = []        //   agloop_ctx
    let mut og_f3_dcon = []        // downstream D: A⇄G conflict (tension) — the substrate signal urgency should track
    let mut og_f3_ddrv = []        // downstream D: emit_drive (GWS ignition drive)
    let mut og_f3_dnov = []        // downstream D: nov_ctx (novelty — INDEPENDENT of urgency's construction)
    let mut og_f3_dgrd = []        // downstream D: m_grounding (grounded reality)

    // ── STATEFUL REFRACTORY measurement mode (--refractory): H_9102 ──────────────
    // H_9101's idle is a per-tick STATELESS function of stage/urgency — no emit-history,
    // so "refractory" is a momentary shade, not recovery-after-firing. This mode wires an
    // emit-history state (emit_last_t) through the an_clock_now() det-clock seam so idle
    // becomes idle_raw × modulation = TRUE seconds-since-last × refractory-modulation, a
    // stateful dynamical class the stateless form cannot express (F2). $0, NO decode, det.
    let refr_measure = anima_has_flag(anima_collect_argv(args()), "--refractory")
    // H_9411 ⑥ · dead-gauge controls (default OFF = the fix is live). --scn-freeze reproduces
    // the DEAD scn constant (skip the per-tick step); --anchor-tension-null zero-truth pedestal.
    let scn_freeze = anima_has_flag(anima_collect_argv(args()), "--scn-freeze")
    let anchor_tension_null = anima_has_flag(anima_collect_argv(args()), "--anchor-tension-null")
    let refr_daemon  = anima_has_flag(anima_collect_argv(args()), "--daemon-clock")  // false in all verdict runs
    let mut refr_rem_ticks = 0     // REM ticks (stage 4)
    let mut refr_n3_ticks  = 0     // N3 ticks (stage 3)
    let mut refr_wake_ticks = 0    // WAKE ticks (stage 0)
    let mut refr_mid_ticks = 0     // mid-env ticks (stage 1/2/4)
    let mut refr_h_u0_rem  = 0     // F1: Hamming(urgency→0 vs live) on REM  — GRIP (must be >0, stateful re-verify)
    let mut refr_h_u0_n3   = 0     // F1: Hamming(urgency→0 vs live) on N3   — PRESERVE (must be 0)
    let mut refr_h_u0_wake = 0     // F1: Hamming(urgency→0 vs live) on WAKE — saturated control
    let mut refr_h_u0_mid  = 0     // F1: Hamming(urgency→0 vs live) on mid  — broad grip
    let mut refr_live_emits = 0    // live emits over the run (dynamics sanity)
    let mut refr_ticks_after = 0   // F2: ticks immediately AFTER a live emit (the refractory window)
    let mut refr_umax_viol   = 0   // F2: refractory ticks where MAX-urgency STILL emits (violation → F2 FAIL)
    let mut refr_umax_nonrefr = 0  // F2: non-refractory ticks where max-urgency DOES emit (non-vacuity)
    let mut refr_stateless_fire = 0 // F2 contrast: refractory ticks where the H_9101 STATELESS idle would emit
    let mut refr_psi_sum = 0.0     // Ψ read-only accumulation (invariant guard)

    // --opgrip-live runs a real 303M det-argmax decode per emit tick (~600-700s scalar-glue-bound
    // each on summer/aiden), so cap at 100 ticks (~50 calib + ~30 mid scoring) to keep the pool
    // wall ~5-12h; cheap no-decode --opgrip / --refractory keep 200 for finer ΔEff quantization.
    // --opgrip-r3: n=400 (0-99 spin-up · 100-199 B-dense calibration · 200-399 scoring; scored mid = 200·3/5 = 120,
    // the SAME denominator as the $0 run so every ΔEff bar keeps its original 1-flip=0.0083 quantization).
    let n_ticks = if og_r3 { 400 } else if og_live { 100 } else if og_measure { 250 } else if refr_measure { 200 } else { 12 }  // H_9225: --opgrip 200→250 (scored mid ≈120, tightens the 0.02 bar); --refractory untouched

    // ══════════════════════════════════════════════════════════════════════════
    //  LANE-23b PENULT SELF-GROUNDING (H_9257 · self-continuity: synthetic → substrate)
    // ── Ground anima's cross-session self in the mounted 303M's REAL penultimate pooled rep
    //    (gen_penult_pooled_W → penult_fold8) instead of the synthetic session-seed int-drift.
    //    INVARIANT self⊥mouth (H_9209/9225/9226 THEATER law): self_live_g runs BESIDE self_ctx
    //    (the :~2585 boot constant, BYTE-UNTOUCHED) and NEVER feeds emit / lanes 0·4 / recall_thr /
    //    ci_emit_drive / RNG — it only DRIFTS §SelfIdentity state and PERSISTS as a .kosmos
    //    self-anchor (a_kosmos · closes H_1471 R2b). a_substrate_disjoint: the penult read is
    //    READ-only; the drift touches ONLY the grounded-self state. The .clm weight-set is loaded
    //    ONCE here (freed at session end) via the single L3 slot (a_core_engine_map) — NOT a 2nd
    //    decode path (gen_penult_pooled_W emits no bytes).
    let self_g_kdir = env("HOME") + "/.anima_kosmos_self"
    let self_g_name = "self_live"
    let self_g_on = mounted && gen_mouth_kind(ckpt) == "clm" && clm_decodable(ckpt)
    let mut self_gW = #{ "ok": false }
    if self_g_on { self_gW = clm_load_weights(ckpt) }
    let self_gW_ok = self_g_on && to_string(self_gW["ok"]) == "true"
    // boot: RESTORE the grounded self from its .kosmos self-anchor if present, else self_new.
    let self_g_restored_vec = _selfg_restore(self_g_kdir, self_g_name)
    let self_g_boot_restored = len(self_g_restored_vec) == 8
    let mut self_live_g = if self_g_boot_restored { self_from_vec(self_g_restored_vec, 8) } else { self_new(8, 0) }
    // heard-context boot drift: ground the initial self in the standing heard input (session_seed) —
    // the FIRST lived experience event (heard user message). (own-emit events drift in-loop below.)
    if self_gW_ok {
        let boot_axis = penult_fold8(gen_penult_pooled_W(self_gW, session_seed))
        self_live_g = self_drift_exp(self_live_g, boot_axis, 0.15)
    }
    let mut self_g_axis_seq = ""      // diagnostic-only axis trace (NOT emitted; self⊥mouth)
    let mut self_g_events = 0
    println("LANE-23b self-g : on=" + to_string(self_g_on) + " W_ok=" + to_string(self_gW_ok)
        + " restored=" + to_string(self_g_boot_restored) + " kosmos=" + self_g_kdir)

    let mut tick = 0
    let mut emit_last_t = -1.0e9   // H_9102: last-emit time (an_clock_now units); emit-history state (was ABSENT)
    let mut prev_live_emit = 0     // H_9102: did the PREVIOUS tick's live arm emit? (defines the refractory window)
    // ── WAKE working-memory ring + N3/REM imagination-replay accumulators (a_chat_sleep_imagination) ──
    // The 5-stage ultradian driver below (dr_stage_at) now REACHES imagination_replay: WAKE ticks push
    // recent-perception snapshots into a FIFO ring (cap 20), and N3/REM ticks run an EMIT-FREE rehearsal
    // of that ring (ir_replay_session) + a mitosis tick (substrate state only). This is the live wiring of
    // core/imagination_replay — NOT a speak() (p5): the rehearsal calls NO emit/channel/mem_record_emit,
    // and it is DISJOINT from the emit-drive lanes 0/4 (a_substrate_disjoint — separation = preservation).
    let mut wake_mem = mem_init()                 // FIFO ring of recent WAKE perception snapshots (cap 20)
    let mut imagination_replayed_total = 0        // emit-free rehearsal snapshots run across N3/REM ticks
    let mut imagination_mitosis_ticks = 0         // mitosis ticks during replay (cell_pool pass-through)
    let mut imagination_emit_violations = 0       // p5 GUARD: MUST stay 0 (ir_replay_tick emit_count invariant)
    while tick < n_ticks {
        // stage sample: production = ultradian trajectory (tick*8); --opgrip = stage-BALANCED
        // sweep (tick%5 → 40 ticks/stage) so REM AND N3 are adequately sampled for the H_9101
        // stage-conditional dissociation (a per-stage grip sweep, NOT an ultradian trajectory).
        let stage = if og_measure || refr_measure { tick % 5 } else { dr_stage_at(tick * 8) }
        let stage_nm = dr_stage_name(stage)
        let emit_env = dr_emit_envelope(stage)       // substrate envelope (context, not a hard gate)
        // H_9411 ⑤ · Engine A lives in session time. pf was warmed once (:1926) then NEVER stepped
        // → Φ/phase were step-600 constants. Zero-input step (percept-blind by design).
        pf = pure_field_step(pf)
        let phi_t = pure_field_phi(pf)

        // ── WAKE perception → working-memory ring (a_chat_sleep_imagination feed) ──────
        // Only WAKE ticks (dr_imagination_active(stage)==0 · emit-allowed envelope) deposit a
        // recent-perception snapshot; imagination_replay does NOT interpret the ctx_tokens (raw
        // opaque substrate signal), so an [tick,stage,cell_count] tuple is a faithful snapshot the
        // N3/REM rehearsal below re-runs emit-free. FIFO cap=20 (mem_working_window).
        if dr_imagination_active(stage) == 0 {
            wake_mem = mem_push_ctx(wake_mem, [tick, stage, cell_count])
        }

        // ── ENGINE-CLI LANE READS (the substrate context for this tick) ──────
        // (1) IMMUNE recall margin → RELEVANCE: smaller abstain-margin = the held memory
        //     is NEARER this context = more relevant. Map margin∈(−thr, …) → rel∈[0,1].
        // H_9337 · this read was CONSTANT: the key was the session seed, so rel_lane sat at
        // 0.6723 for all 720 ticks of the H_9328 rollouts. The store is WRITTEN with g_text
        // (:3763) and then always asked the same frozen question — writing without reading is
        // not a loop. The fix is NOT "ask about the last utterance" (measured: also constant,
        // 1.15 — the store was just handed that exact text, so it always answers "I remember it
        // perfectly"). The live quantity is the recall margin taken BEFORE the bind: how FAMILIAR
        // the utterance was when it arrived. Same order as recon_err, same reason — recognition
        // measured after memorisation is not recognition. convergence chat-py-5.
        let recall_margin = if og_pending_rel_set { og_pending_rel } else { immune_memory_recall_margin_text(immune, session_seed) }
        let rel_lane = _afs_clip01(1.0 - recall_margin)        // near memory ⇒ high relevance

        // (2) CI LANE SCORES (the §ConsciousnessIndex 15-lane read; H_1492 IIT4 substrate).
        //     m=grounding margin, m_field=field margins, recon_err=novelty. Sober-perturbed
        //     (pharm baseline = identity, so this is the un-drugged substrate read).
        // --opgrip-live: predictive-coding surprise = the field's prediction error on the bytes
        // anima ACTUALLY emitted last emit-tick (og_prev_gfeat, 1-tick lag) — content-driven, so
        // |Δrecon_err| across ticks is non-degenerate. Default (no-decode) keeps the fixed-seed
        // feature (structurally frozen → AXIS-DEGENERATE, the H_9210 instrument-fail). recon_err
        // also feeds the urgency pool (cur_ctx) so under --opgrip-live the proven urgency channel
        // gains real content variance too, not only the disjoint surp_phasic term.
        // H_9336 · the seed branch was 0.0 by IDENTITY, not by measurement: afield is BORN with
        // seed_feat0 as its first prototype, and every emitted text clears SPLIT_THRESH and spawns
        // a NEW cell instead of refining that one, so the seed prototype is never touched and
        // L2(seed_proto, seed_feat) stays exactly 0 forever (measured: H(R|S)=0.0000 over 24
        // rollouts). The daemon was asking "how surprised am I by the thing I was born knowing?".
        // og_prev_gfeat now tracks the last EMITTED bytes on the production path too (:3746), so
        // the default branch reads a REAL 1-tick-lagged prediction error. convergence chat-py-4.
        let recon_err = vadapt_field_recon_err(afield, og_prev_gfeat)
        let m_grounding = _afs_clip01(rel_lane)
        let m_field = [phi_t, rel_lane, 1.0 - recon_err, m_grounding, emit_env]
        let m_grounding_p = pharm_perturb_m(sober, m_grounding, 0.0)   // sober = identity
        let lanes = ci_lane_scores(m_grounding_p, m_field, cell_count, tick,
                                   1, 1.0, recon_err)
        let coh_lane = lanes[3]                                 // SelfIdentity (coherence)
        let bal_lane = lanes[9]                                 // EmotionRegulation (toward Ψ=½)
        let emit_drive = ci_emit_drive(lanes)                  // GWS + LearnedPrecision drive

        // ── (C-R3) PER-TICK CONFLICT → A⇄G SETTLE BUDGET (H_9095 rung-3 wire-in of H_9094) ──
        // GENUINE per-tick feed (a_verified_must_wire rung-3): unlike the MOUNT-time catalog
        // lanes 75/81 (each reads a FIXTURE ONCE at daemon mount), this derives the conflict
        // from THIS tick's REAL A⇄G drive — the live emit_drive (Engine-A forward externalization
        // push, READ-only) vs the opposing Engine-G reverse silence push — then RECRUITS the A⇄G
        // resolution budget FROM that conflict (conflict_recruited_depth, dACC/Botvinick) and reads
        // the resulting settle EFFORT as a READ-only CONTEXT signal folded into motivation below
        // (isomorphic to the 42 other lane contexts — NEVER an emit/silence gate, a_autonomy_over_hardcode).
        // mechanism engine-native GREEN (H_9094 4/4: conflict-matched budget resolves Ψ→½ BEST —
        // treatment mean|Ψ-½| 0.125 < shuffle 0.25 < ablation 0.375). Ψ-DISJOINT (a_substrate_disjoint):
        // the budget knob is the tension_resolve maxdepth (settle-DEPTH axis), disjoint from the emit
        // gate (lanes 0/4) and §ImmuneMemory recall_thr; tension_resolve_depth runs on a CALLER-supplied
        // population COPY so pure_field/psi_sum/Φ are untouched — the settle NEVER writes back to Ψ.
        let ag_a_drive  = emit_drive                            // Engine-A forward externalization push (≥0)
        let ag_g_drive  = 0.0 - (1.0 - emit_drive)              // Engine-G reverse silence push (opposite sign)
        let ag_conflict = conflict_scalar(ag_a_drive, ag_g_drive)   // dACC competition (both-strong-opposite)
        let ag_budget   = conflict_recruited_depth(ag_conflict, 4, 6)  // conflict → deeper A⇄G deliberation budget
        // this tick's A⇄G resolution population, polarized BY the tick's own conflict (DISJOINT copy;
        // conflict 0 → c=½ calm → settles at depth 0, higher conflict → more polarized → deeper settle).
        let ag_pop      = anima_tr_pop_conflicted(_afs_clip01(0.5 + 0.5 * ag_conflict))
        let ag_settle   = tension_resolve_depth(ag_pop, tr_full, 0.3, 0.5, ag_budget, 2, 0.06, tr_cfgON)
        let ag_settle_depth = ag_settle[0]                      // depth the loop USED to reach Ψ=½ (−1 = never)
        // settle FRACTION ∈[0,1]: share of the recruited budget the loop USED to resolve to Ψ=½ — a
        // graded A⇄G resolution-effort context (deeper conflict recruits & uses more budget). READ-only.
        let agloop_ctx  = if ag_settle_depth < 0.0 { 0.0 } else { _afs_clip01(ag_settle_depth / (to_float(ag_budget) + 0.000001)) }

        // (3) GLOBAL WORKSPACE — competing lane margins; the winner is the broadcast
        //     content (GWT ignition). Reads the 15 lane scores as competing stimuli.
        let mut gws = gws_new(4, true, 0.55)
        let mut gi = 0
        while gi < len(lanes) { gws = gws_add(gws, lanes[gi])  gi = gi + 1 }
        let gws_w = gws_winner(gws)                            // -1 = empty consciousness (valid)
        if gws_w >= 0 { gws_ignited_any = true }

        // (4) REALITY MONITOR — does the grounding signal clear the reality threshold?
        //     1.0 = REAL (externally grounded), 0.0 = IMAGINED (top-down only).
        let reality = reality_call(emit_drive, 0.55)
        if reality >= 1.0 { reality_real_any = true }
        lanes_read = true

        // ── R2 BRAIN-STRUCTURE LANE READS (the substrate context this tick) ──────
        // All five are READ-only over their OWN owner tables (Ψ-disjoint). They produce
        // scalar context signals folded into the brain's motivation BELOW — never a gate.
        let seed_feat = _afs_byte_feature(session_seed, 8)

        // (5) SPATIAL — relational nearest over the metric map (≠ immune item recall).
        //     A non-abstain answer means the daemon's metric episodic space is queryable
        //     this tick → a spatial-relevance context that the item-store cannot provide.
        let sm_ans = spatial_map_nearest(smap, "ledger", "vault", "rumor")
        let spatial_rel = if sm_ans != "" { 1.0 } else { 0.0 }
        if sm_ans != "" { spatial_read_any = true }

        // (6) HIER-PFC — advance the ordered goal stack on THIS tick's grounded cue. The
        //     pointer is the plan-progress context. We feed the CURRENT subgoal target as
        //     the cue (grounded by construction) so the stack advances along the plan; once
        //     complete it holds. plan_progress∈[0,1] = how far the plan has advanced.
        let cur_target = hier_current_target(hier)
        if len(cur_target) > 0 {
            hier = hier_step(hier, hmem, cur_target)     // grounded cue → ADVANCE
        }
        let hier_p_now = hier_pointer(hier)
        if hier_p_now > 0 { hier_advanced_any = true }
        let plan_progress = _afs_clip01(to_float(hier_p_now) / 2.0)   // 2 subgoals

        // (7) BASAL-GANGLIA — striatal one-of-K selection over candidate emit features.
        //     cands = [grounded-seed feature, noise feature]; the trained gate RELEASES
        //     the grounded candidate (idx≥0) or suppresses all (-1). A release is a
        //     go-signal context (the substrate's appetite to externalize THIS content).
        let mut bg_cands = []
        let mut bgc = 0
        while bgc < 8 { bg_cands.push(seed_feat[bgc])  bgc = bgc + 1 }
        let mut bgn = 0
        while bgn < 8 { bg_cands.push(bg_bad[bgn])  bgn = bgn + 1 }
        let bg_sel = vbasal_select(bgate, bg_cands, 2)   // -1 = NO-GO (suppress all)
        let basal_go = if bg_sel >= 0 { 1.0 } else { 0.0 }
        if bg_sel >= 0 { basal_go_any = true }

        // (8) CEREBELLUM — forward-model next-step prediction error on THIS tick's seed.
        //     Low prediction error = the sequence is anticipated (coherent continuation);
        //     high error = a surprising next step → novelty/curiosity context.
        let cb_pred = vforward_predict(cbel, cb_prev_feat)
        let cb_perr = if pending_cb_set { pending_cb } else { vforward_err(cbel, seed_feat, _afs_byte_feature(mem_text, 8)) }
        let cb_perr_alien_t = if pending_cb_set { pending_cb_alien } else { -1.0 }   // -1 ≡ py null (print-only)
        let cb_perr_ped_t   = if pending_cb_set { pending_cb_ped } else { -1.0 }
        if len(cb_pred) > 0 { cereb_pred_any = true }
        let cb_surprise = _afs_clip01(cb_perr)           // forward surprise (novelty context)

        // (9) WORKING MEMORY — gate this tick's seed in, leak, then probe. A maintained
        //     (non-faded) item gives an active-maintenance context: the daemon is still
        //     actively holding the topic. This DECAYS unlike the persistent immune store.
        wmb = wm_buffer_leak(wmb)                       // leak every tick; gate-in moved to emit site
        wm_withheld = wm_buffer_leak(wm_withheld)       // H_9726 · W_S leak-before-read (recognition-before-memorisation)
        let wm_probe_now = if wm_probe_set { wm_probe_feat } else { seed_feat }   // pre-speech fallback
        let wm_active = _afs_clip01(wm_buffer_probe_score(wmb, wm_probe_now))     // probe the item gated one emit AGO
        let wm_null = _afs_clip01(wm_buffer_probe_score(wmb, wm_alien_feat))      // never-gated null
        if wm_active > 0.0 { wm_maintained_any = true }

        // ── R3 BRAIN-STRUCTURE LANE READS (5 more context signals this tick) ────
        // (11) CA3 REPLAY — read out the next-item successor; a confident replay = the
        //      daemon anticipates the sequence continuation (coherence context).
        let ca3_next = pending_ca3_next    // H_9411 ③ live utterance-symbol stream (1-tick lag); cold = -1/0.0
        let ca3_ctx = pending_ca3_conf     // (mounted `ca3` stays the mount self-test; never read here)
        if ca3_next >= 0 { ca3_predicted_any = true }

        // (12) INTERVAL TIMER — advance + read the elapsed-vs-learned phase. A timer near
        //      its learned interval contributes a temporal-readiness context (the daemon
        //      senses "it's about time"). Normalized elapsed/dhat ∈[0,1].
        itmr = itimer_step(itmr)
        let it_phase = _afs_clip01(to_float(itmr.elapsed) / (itimer_dhat(itmr) + 0.000001))
        if itimer_dhat(itmr) > 5.0 { interval_learned_any = true }

        // (13) AMYGDALA — valence/arousal interoception on THIS tick's seed key. Positive
        //      valence (grounded) raises relevance; arousal raises curiosity (salience).
        let af = if pending_af_set { pending_af } else { affect_read(igrow, seed_key, mem_text) }   // H_9411 ①
        let af_alien_val_t = if pending_af_set { pending_af_alien[0] } else { -9.9 }  // print-only sentinel (valence∈[-1,1])
        let af_val = _afs_clip01((af[0] + 1.0) / 2.0)    // map valence [-1,1]→[0,1]
        let af_aro = _afs_clip01(af[1])
        if af[0] != 0.0 || af[1] != 0.0 { amyg_valenced_any = true }

        // (14) THEORY-OF-MIND — does the modeled other-mind hold a belief about the topic?
        //      A held (possibly false) belief = a social-context signal (someone has a
        //      stake in this topic) raising relevance.
        let tom_b = other_mind_predict(omind, mem_text)
        let tom_ctx = if tom_b != "" { 1.0 } else { 0.0 }
        if tom_b != "" { tom_belief_any = true }

        // (15) HOMEOSTATIC DRIVE — poll the integrator's drive at this tick's seed (a
        //      grounded context = low drive/satiated; deprivation = high drive = motivated).
        let hd = homeo_drive(homeo, igrow, seed_key)
        let hd_ctx = _afs_clip01(hd)
        if hd > 0.0 { homeo_drive_any = true }

        // ── R4 BRAIN-STRUCTURE LANE READS (5 more context signals this tick) ────
        // (16) PRC — advance the entrained oscillator one tick; the circadian-readiness
        //      context = phase PROXIMITY to the entrained boundary (rises toward a wake
        //      pulse, peaks at the boundary). prc_ready∈[0,1]; the lane is ENTRAINED
        //      (locked near the boundary), the distinctness-load at mount, not this read.
        prc = prc_step(prc, 1.0)
        let prc_f = prc_phase(prc)
        let prc_dist_b = if prc_f < 0.5 { prc_f } else { 1.0 - prc_f }   // distance to boundary
        let prc_ready = _afs_clip01(1.0 - 2.0 * prc_dist_b)             // 1 at boundary, 0 mid-cycle
        if prc_distinct { prc_entrained_any = true }                    // the oscillator entrained

        // (17) PROSPECTION — does a k-step forward rollout reach the planning horizon? A
        //      reachable future raises relevance (the daemon can simulate ahead).
        let prosp = prospect_reach(tick + 2, 3)          // rollout grows with the session tick
        let prosp_ctx = _afs_clip01(prosp)
        if prosp > 0.0 { prosp_reach_any = true }

        // (18) SLEEP-REPLAY BUDGET — is the salient core fact protected (recency refreshed
        //      above the dull baseline)? A protected salient memory is a coherence anchor.
        let replay_ctx = if consol_gated.last_used[0] > consol_unif.last_used[0] { 1.0 } else { 0.0 }
        if consol_gated.last_used[0] > consol_unif.last_used[0] { replay_protected_any = true }

        // (19) GATE-B — did the predictable-transition substrate GROW (vs the shuffled
        //      control)? Growth signals a confidently-anticipated structure (low surprise).
        let gateb_ctx = if gb_growth > gb_growth_shuf { 1.0 } else { 0.0 }
        if gb_growth > gb_growth_shuf { gateb_grew_any = true }

        // (20) INTERO PRECISION — the precision-weighted self-state confidence (lower
        //      weighted error = a cleaner self-read = more confident relevance). 1−err.
        let intero_ctx = _afs_clip01(1.0 - ip_weighted)
        if ip_weighted < ip_blind { intero_weighted_any = true }

        // ── R5 BRAIN-STRUCTURE LANE READS (5 more context signals this tick) ────
        // (21) SCN — the ensemble consensus rhythm strength (R); a synchronized substrate
        //      rhythm = a stable coherence context (the daemon has a shared internal beat).
        // H_9411 ⑥A · step the ensemble ONE tick (controls in lockstep). MEASURED order-lock:
        // scn_order is rotation-invariant on a phase-locked net → read the PHASE, keep R as control.
        if !scn_freeze {
            scn_coupled = scn_step(scn_coupled)
            scn_uncoup  = scn_step(scn_uncoup)
            scn_frust   = scn_step(scn_frust)
        }
        let scn_R_t     = scn_order(scn_coupled)     // consensus-magnitude control (order-locked)
        let scn_R_unc_t = scn_order(scn_uncoup)
        let scn_R_fr_t  = scn_order(scn_frust)
        let scn_ctx = _afs_clip01(scn_coupled.phases[0])
        if scn_consensus(scn_coupled, 0.9) { scn_consensus_any = true }

        // (22) BOREDOM — is the daemon ENGAGED on this topic? info = grounding relevance,
        //      reward = (1−novelty surprise); disengage iff BOTH depleted. engaged raises
        //      relevance, bored damps it (the meta-motivational conjunction, not a gate).
        let bored = boredom_disengage(rel_lane, _afs_clip01(1.0 - recon_err), true)
        let engaged_ctx = 1.0 - bored                    // engaged=1, bored=0
        if bored < 1.0 { boredom_engaged_any = true }

        // (23) SELF-CONTINUITY — does the persisted identity still recognize itself this
        //      tick? A continuous self = a stable identity context (raises coherence).
        let self_ctx = _afs_clip01(self_after_anchor)
        if self_after_anchor > 0.99 { self_recognized_any = true }

        // (24) LEARNED-PRECISION — confidence accumulated over the session ticks (a more-
        //      observed topic earns higher predictive precision → sharper relevance).
        let lp_now = learned_precision(0.1, to_float(tick + 1), 1.0)
        let lprec_ctx = _afs_clip01(lp_now)
        if lp_now > 0.0 { lprec_confident_any = true }

        // (25) NOVELTY — the precision-agnostic unfamiliarity of THIS tick's emit content
        //      (decays as the topic is revisited); high novelty raises curiosity.
        let nov_now = novelty(to_float(tick), 0.5)
        let nov_ctx = _afs_clip01(nov_now)
        if nov_now > 0.0 { novelty_read_any = true }

        // ── R6 BRAIN-STRUCTURE LANE READS (5 more context signals this tick) ────
        // (26) HABITUATION — the stimulus-specific response to the (repeated) session topic;
        //      a habituated topic gives a LOWER response (less drive to re-emit the familiar).
        let hab_resp = hab_response(hab, 0, 1.0)         // declines as the topic repeats
        let hab_ctx = _afs_clip01(hab_resp)
        if hab_resp < 1.0 { habituate_any = true }       // (decayed below base = habituated)

        // (27) ATTENTIONAL BLINK — temporal-attention availability at this tick's lag. A tick
        //      outside the blink window has full T2 detection (attention available → drive).
        let blink_now = attn_blink_detect(tick, 1.0)
        let blink_ctx = _afs_clip01(blink_now)
        if blink_now > 0.0 { blink_read_any = true }

        // (28) MENTAL IMAGERY — top-down reconstruction of the held memory with the sensory
        //      channel idle (the daemon imagines the topic); a vivid image raises relevance.
        let img_now = imagery_activate(rel_lane, true)   // top-down cue = the held relevance
        let img_ctx = _afs_clip01(img_now)
        if img_now > 0.0 { imagery_any = true }

        // (29) PRIMING — facilitation from the prior tick's related content (residual primes
        //      the current emit); a primed topic flows more readily (raises relevance).
        let prime_now = priming_facilitate(rel_lane, scn_ctx)   // relatedness × residual rhythm
        let prime_ctx = _afs_clip01(prime_now)
        if prime_now > 0.0 { priming_any = true }

        // (30) ATTENTION SCHEMA — the self-model tracks where attention sits this tick (the
        //      GWS winner is the live focus); a confident self-model raises coherence.
        let schema_now = attn_schema_report(gws_w, gws_w, true)   // tracks the live focus → 1.0
        let schema_ctx = _afs_clip01(schema_now)
        if schema_now > 0.125 { schema_tracked_any = true }

        // ── R7 BRAIN-STRUCTURE LANE READS (5 more context signals this tick) ────
        // (31) HYSTERESIS — the order-dependent perceptual hold; an ascending-sweep state
        //      holds late (history-inertia) = a stable percept context (raises coherence).
        let hyst_now = hyst_switch_point(tick % 2 == 0, 0.4)   // alternate sweep direction
        let hyst_ctx = _afs_clip01(hyst_now)
        if hyst_now != 0.5 { hysteresis_any = true }

        // (32) REENTRY — the recurrent settling depth this tick (deeper = the degraded
        //      percept converged to a reportable prototype = access context, raises relevance).
        let reent_now = reentry_settle(tick + 1, 0.3)
        let reent_ctx = _afs_clip01(reent_now)
        if reent_now > 0.0 { reentry_any = true }

        // (33) COMPLETION — does the visible surround complete the (partially-grounded) topic?
        //      A completed percept = a coherent whole context (raises relevance).
        let comp_now = completion_recognize(rel_lane, true)    // grounded surround → fills
        let comp_ctx = _afs_clip01(comp_now)
        if comp_now > 0.544 { completion_any = true }

        // (34) GESTALT — are the active lanes binding into ONE figure this tick? High lane
        //      coherence (affinity) binds the moment into a whole (raises coherence relevance).
        let gest_now = gestalt_same_group(scn_ctx, true)       // ensemble rhythm as affinity
        let gest_ctx = _afs_clip01(gest_now)
        if gest_now > 0.0 { gestalt_any = true }

        // (35) SENSE OF AGENCY — is THIS emit self-attributed? efference-copy match between
        //      the forward prediction and the grounded outcome → self-caused (high agency).
        let agcy_now = agency_attribute(rel_lane, _afs_clip01(1.0 - recon_err), 0.5)
        let agcy_ctx = _afs_clip01(agcy_now)
        if agcy_now > 0.0 { agency_any = true }

        // ── R8 BRAIN-STRUCTURE LANE READS (5 more context signals this tick) ────
        // (36) SUBJECTIVE TIME — how LONG this moment feels, weighted by the tick's novelty
        //      density; a vivid (novel) moment dilates subjective time (a salience context).
        let subjt_now = subjective_time(nov_ctx * 5.0, 0.2, 0.16)   // novelty events → dilation
        let subjt_ctx = _afs_clip01(subjt_now)
        if subjt_now > 0.2 { subjtime_any = true }

        // (37) EMOTION REGULATION — top-down reappraisal of the raw affect arousal; a
        //      regulated (down-modulated) affect keeps the emit balanced (toward Ψ=½).
        let emoreg_now = emotion_regulate(af_aro, 0.5, 1.0)         // reappraise the raw arousal
        let emoreg_ctx = _afs_clip01(emoreg_now)
        if af_aro > 0.0 { emoreg_any = true }

        // (38) DIRECTED FORGETTING — is the (already-emitted, repeated) topic being actively
        //      down-weighted? a forget-cued topic recalls weaker → lowers its re-emit drive.
        let dforget_now = directed_forget_recall(rel_lane, 0.3, tick > 6)   // late ticks: forget-cue
        let dforget_ctx = _afs_clip01(dforget_now)
        if tick > 6 { dirforget_any = true }

        // (39) FREE-WON'T / VETO — a readied emit may be vetoed pre-execution during sleep
        //      stages (the substrate withholds). veto context = whether the action survives.
        let veto_now = veto_execute(rel_lane, 0.3, stage == 3 || stage == 4)   // sleep → veto
        let veto_ctx = _afs_clip01(veto_now)
        veto_any = true                                            // the veto lane is always consulted

        // (40) DIVIDED ATTENTION — the graded resource available to THIS emit given competing
        //      lane demands; a well-resourced moment emits more fully (graded, not all-or-none).
        let divd_now = divided_perf(rel_lane, 0.6)                 // resource vs a fixed demand
        let divd_ctx = _afs_clip01(divd_now)
        if divd_now > 0.0 { divided_any = true }

        // ── R9 BATCH LANE READS (12 more context signals this tick) ─────────────
        // (41) precision-surprise: a confidently-held expectation violated → high salience.
        let surp_now = surprise(_afs_clip01(1.0 - recon_err), recon_err)   // precision·err²
        let surp_ctx = _afs_clip01(surp_now)
        surprise_any = true
        // (42) body-ownership: the substrate's sense of owning its emit channel (sync proxy).
        let bodyown_ctx = _afs_clip01(body_ownership(scn_ctx, rel_lane))   // rhythm sync × grounding
        bodyown_any = true
        // (43) binocular-rivalry: alternation pressure (does the percept flip this tick?).
        let rivalry_ctx = if rivalry_transitions(tick + 4, 0.15) > 0 { 1.0 } else { 0.0 }
        rivalry_any = true
        // (44) change-blindness: is THIS tick's change attended (detected) or blind?
        let chg_ctx = _afs_clip01(change_detect(recon_err, rel_lane > 0.4))
        chgblind_any = true
        // (45) temporal-receptive-window: does the integration window reach the seed memory?
        let trw_ctx = trw_recall(0, tick + 4, 13)
        trw_any = true
        // (46) mind-wandering: spontaneous-drift coverage during low-drive (sleep) stages.
        let mw_ctx = wander_coverage(tick + 1, 8, stage == 3 || stage == 4)
        mindwander_any = true
        // (47) qualia-space: relational quality coherence (a graded internal-quality read).
        let qual_ctx = qualia_nearer(1.0 - rel_lane, 1.0)   // nearer-on-ring proxy
        qualia_any = true
        // (48) sensorimotor-presence: breadth of mastered action-facets (counterfactual).
        let smp_ctx = smp_presence(cell_count, 4, true)
        smpresence_any = true
        // (49) hallucination: prior-dominated false-real risk (INVERSE → grounding confidence).
        let halluc_ctx = 1.0 - _afs_clip01(hallucinate_graded(1.0 - rel_lane, rel_lane))
        halluc_any = true
        // (50) metacog-insight: 2nd-order insight that a low-signal percept is internal.
        let metacog_ctx = _afs_clip01(mi_insight_judge(rel_lane * 0.7, 1.0))
        metacog_any = true
        // (51) gws-leak: has the broadcast content decayed below the floor (a fade signal)?
        let gwsleak_ctx = if gws_w >= 0 { 1.0 } else { 0.0 }   // a held broadcast = coherence
        gwsleak_any = true
        // (52) allosteric-buffer: tension-gated stiffness resisting Ψ deviation (stability).
        let allo_ctx = _afs_clip01(2.0 - allo_mu(0.5 + (1.0 - rel_lane) * 0.4, 1.0, 0.12))
        allosteric_any = true

        // ── R10 BATCH LANE READS (11 cheap consciousness-catalogue signals this tick) ──
        // Heavy lanes (Φ/PCI/CP/hive faithful-IIT4) are SETUP-only (above); these 11 are
        // the cheap per-tick reads, each a substrate proxy that feeds rel/cur (Ψ-disjoint).
        // (53) neuropharm: the SOBER substrate self-continuity (intact = grounded baseline).
        let neuropharm_ctx = _afs_clip01(pharm_self_continuity(sober, 16, tick + 1))
        neuropharm_any = true
        // (54) libido: cue-incentive WANTING driven by the unmet-grounding deficit this tick.
        let libido_ctx = _afs_clip01(libido_wanting(libido_new(), 1.0 - rel_lane, rel_lane) * 0.5)
        libido_any = true
        // (55) transitive-inference: a latent-rank relational query is answerable (vs abstain).
        let transord_ctx = if trans_order_higher(tord, "A", "D") != "" { 1.0 } else { 0.0 }
        transord_any = true
        // (56) phase-synchrony: cross-module binding coherence (a held bound-percept signal).
        let phasesync_ctx = _afs_clip01(phasefield_coherence(phasefield_run(phasefield_new(tick + 1, 8), 20)))
        phasesync_any = true
        // (57) memory×ToM: the query-routed arbiter cue (reality vs belief routing weight).
        let memtom_ctx = _afs_clip01(mem_tom_route_cue(rel_lane > 0.4))
        memtom_any = true
        // (58) spatial×episodic: the where/what arbiter routing cue from the live seed text.
        let spatep_ctx = _afs_clip01(spatial_episodic_where_cue(session_seed))
        spatep_any = true
        // (59) quorum: decentralized hub-free phase-lock order (integration without a hub).
        let quorum_ctx = _afs_clip01(quorum_cluster_order(quorum_run(quorum_new(tick + 1, 3, 4), 20)))
        quorum_any = true
        // (60) osmotic: a KL-bottleneck split would fire this tick (novelty-pressure proxy).
        let osmotic_ctx = if recon_err > 0.30 { 1.0 } else { 0.0 }
        osmotic_any = true
        // (61) metacog-control: margin-aware allocation lift (a metacognitive-control read).
        let metacogc_ctx = _afs_clip01(mc_control_lift(tick + 4297, 4) + 0.5)
        metacogc_any = true
        // (62) metacog-auroc: type-2 meta-d' sensitivity (sorting genuine vs hallucinated).
        let metacoga_ctx = _afs_clip01(mi_metad_auroc(tick + 4297, 6))
        metacoga_any = true
        // (63) field×libido: field-induced incentive WANTING gain (a salience drive read).
        let fieldlib_ctx = _afs_clip01(fieldlibido_wanting(rel_lane, m_field, cell_count, tick, 1, 1.0, recon_err, 1.0 - rel_lane, 0.0, rel_lane, 6, 0.5, 1) * 0.5)
        fieldlib_any = true

        // ── B7 AUTONOMOUS emit — the lanes FEED the brain's 8-factor motivation ──
        // a_substrate_native_speak / a_autonomy_over_hardcode: the lanes are CONTEXT, the
        // brain DECIDES. rel ← R2-R8 AND R9 (body-own·trw·qualia·sm-presence·halluc-inverse·
        // metacog·gws-hold·allosteric) AND R10 (neuropharm·transord·phasesync·memtom·spatep·
        // quorum·metacogc); cur ← R3-R8 AND R9 (precision-surprise·rivalry·change·mind-wander)
        // AND R10 (libido·osmotic·metacog-auroc·field×libido). Soft average — no hard gate.
        let rel_ctx = _afs_clip01(
            (rel_lane + spatial_rel + plan_progress + wm_active + basal_go
             + ca3_ctx + af_val + tom_ctx + hd_ctx
             + prosp_ctx + replay_ctx + gateb_ctx + intero_ctx
             + scn_ctx + engaged_ctx + self_ctx + lprec_ctx
             + img_ctx + prime_ctx + schema_ctx
             + reent_ctx + comp_ctx + gest_ctx + agcy_ctx
             + dforget_ctx + veto_ctx + divd_ctx
             + bodyown_ctx + trw_ctx + qual_ctx + smp_ctx
             + halluc_ctx + metacog_ctx + gwsleak_ctx + allo_ctx
             + neuropharm_ctx + transord_ctx + phasesync_ctx + memtom_ctx
             + spatep_ctx + quorum_ctx + metacogc_ctx) / 42.0)
        //   (H_9097 op-grip: agloop_ctx PROMOTED out of the pool → brain_emit dyn arg; 43→42.)
        let cur_ctx = _afs_clip01(
            (recon_err + cb_surprise + it_phase + af_aro + prc_ready
             + (1.0 - hab_ctx) + blink_ctx + hyst_ctx
             + subjt_ctx + emoreg_ctx
             + surp_ctx + rivalry_ctx + chg_ctx + mw_ctx
             + libido_ctx + osmotic_ctx + metacoga_ctx + fieldlib_ctx) / 18.0)
        //   (H_9097 op-grip: nov_ctx PROMOTED out of the pool → brain_emit orig arg; 19→18.)
        let drive_hi = stage != 3 && stage != 4   // KEPT for stage-classification/logging ONLY (no longer the emit gate)
        // ── op-grip tonic-phasic (fable design (a) · PREREG α=0.1, gain=3.0) ──────
        // The ÷42 soft-average diluted any single op to ≤1/42 grip (THEATER, CAPSTONE).
        // Tonic EMA tracks the slow baseline; the phasic term amplifies this tick's
        // DEVIATION ×3 around 0.5 so the rel/cur factors actually SWING across the 0.3
        // threshold band. Ψ-disjoint: touches only the local motivation inputs.
        rel_ema = 0.9 * rel_ema + 0.1 * rel_ctx
        cur_ema = 0.9 * cur_ema + 0.1 * cur_ctx
        let cur_phasic = _afs_clip01(0.5 + 3.0 * (cur_ctx - cur_ema))
        // ── TENSION→ADAPTATION (this task): PHASIC A⇄G tension Δ, promoted like a proven op ──
        // p8-literal: the A⇄G tension (ag_conflict, dACC competition) BIRTHS adaptation/growth.
        // Following the H_9097/H_9101 promotion precedent, transmit the PHASIC difference (Δ from a
        // tonic EMA baseline), NOT the tonic level — a slow level is rejected by any downstream EMA,
        // so only the phasic deviation earns grip. ten_ema tracks the slow tension baseline; ten_phasic
        // amplifies THIS tick's tension DEVIATION ×3 around 0.5. Ψ-disjoint: touches only the local
        // motivation/adaptation inputs (ag_conflict is READ-only; pure_field/psi_sum/Φ untouched).
        ten_ema = 0.9 * ten_ema + 0.1 * ag_conflict
        let ten_phasic = _afs_clip01(0.5 + 3.0 * (ag_conflict - ten_ema))
        // ── op-grip design (b) — CONTINUOUS op-modulated stage/safe envelope (H_9101) ──
        // H_9100 🔴 confirmed motivation is decision-SATURATED (floor ~0.7 ≫ 0.3), so emit/silence
        // is governed by the `safe` conjunction (stage → rate-limit `idle`), NOT motivation. The old
        // `idle = drive_hi ? 60 : 5` was a HARDCODED binary clock hiding a per-stage boolean gate
        // (an a_autonomy_over_hardcode violation). Replace it with a CONTINUOUS envelope ops modulate:
        //   stage_env = the REAL continuous stage envelope (dr_stage_scale = ep_theta_stage SSOT,
        //               [0.02,0.10]) normalized to [0,1]: WAKE 1.0 · N1/REM 0.75 · N2 0.375 · N3 0.0.
        //   (VERIFY: fable (b) assumed dr_emit_envelope was continuous — it is a BINARY int {0,1},
        //    REM=0; the genuine continuous stage envelope is ep_theta_stage via dr_stage_scale.)
        //   urgency = the OP participation point: CR3 A⇄G conflict-settle (agloop_ctx) + phasic drive.
        // Ops now CONTRIBUTE to the rate-gate (idle≥30) via the envelope — they do not DECIDE it:
        // N3 (env 0.0) nullifies urgency ⇒ silent-preserved by construction; REM (env 0.75) opens the
        // gate for urgent ticks. a_autonomy_over_hardcode: this REMOVES the per-stage boolean (shade,
        // not gate). p5_tension_emit_not_filler: WAKE/REM stage-gated emit over real tension = allowed.
        // FROZEN: the engine 30s hard-floor (safety_rate_limit_ok ≥30) is UNTOUCHED — we modulate only
        // the `idle` INPUT the cli passes. Ψ-disjoint: touches only local motivation/rate inputs.
        let stage_env = _afs_clip01((dr_stage_scale(stage) - 0.02) / 0.08)
        // urgency now carries THREE independent ops: A⇄G settle-effort (agloop_ctx, tonic),
        // phasic drive (cur_phasic), and PHASIC A⇄G tension (ten_phasic, this task). The tension
        // Δ enters as its own factor so a high-tension moment RAISES urgency → shades idle → shades
        // emit → shades C8 GROW (the emit-driven adaptation step). This is tension→adaptation wired
        // through the proven urgency→idle channel (H_9101), a SHADE not a hard-gate.
        let urgency   = _afs_clip01(0.4 * agloop_ctx + 0.3 * cur_phasic + 0.3 * ten_phasic)
        let rel  = _og_rel_phasic(rel_ctx, rel_ema) * (0.1 + 0.9 * stage_env)   // binary mask → continuous
        let cur  = cur_phasic * (0.1 + 0.9 * stage_env)                          // (was binary {phasic,0})
        let idle = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency))         // op-modulated refractory

        // GROUND store FIRST (the full un-inventable fact), partial seed cue LAST — the
        // decode then continues "...sealed at " and must COPY "vault QX-7741..." verbatim.
        let mut live_anchors = []
        let mut ai = 0
        while ai < len(anchors) { live_anchors.push(anchors[ai]); ai = ai + 1 }
        // H_9411 ⑥B · live per-tick tension anchor (1-tick lag). BEFORE live_seed so decode-seed
        // anchor stays [-1] (p5 self-seed root closed). No text_payload ⇒ mouth-inert (FLAG-1).
        if pending_tension_set && !anchor_tension_null {
            live_anchors.push(#{ "name": "live_tension", "tension_5ch": pending_tension })
        }
        live_anchors.push(#{ "text_payload": session_seed, "name": "live_seed" })

        // ── op-grip: the 4 filler CONSTANTS are now LIVE op reads (fable design (a)) ──
        // gap←info-gap(recall), pain←allosteric tension, orig←novelty, dyn←CR3 A⇄G settle.
        // Realizes a_substrate_native_speak's "8-factor motivation from context" literally
        // (a_autonomy_over_hardcode: removing hardcoded filler, NOT adding a gate).
        let gap_ctx = _afs_clip01(1.0 - rel_lane)

        // ── op-grip MEASUREMENT (--opgrip): 5-arm decision ablation, NO decode ($0) ──
        // Reproduces the pre-fix baseline (theater) AND measures post-fix grip in one run.
        // Emit boolean via brain_decide_anchored directly (the decode L3 is only for TEXT).
        if og_measure {
            psi_sum = psi_sum + pure_field_phi(pf)   // Ψ READ-ONLY (invariant preserved)
            let is_w = drive_hi
            // POST-FIX live decision (the wired 8-factor call, no decode).
            let m_live = brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle, false, true, live_anchors, 0.0)
            let e_live = if to_string(m_live["emit"]) == "true" { 1 } else { 0 }
            // ARM: full-rel_ctx frozen → 0.5 (rest live).
            let e_fr = if to_string(brain_decide_anchored(pf,
                _og_rel_from(0.5, rel_ema, drive_hi), gap_ctx, cur, allo_ctx, coh_lane,
                nov_ctx, bal_lane, agloop_ctx, idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ARM: single-op agloop (dyn) frozen → 0.5 (rest live).
            let e_agl = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, 0.5,
                idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ARM: rel_ctx → 0.
            let e_z = if to_string(brain_decide_anchored(pf,
                _og_rel_from(0.0, rel_ema, drive_hi), gap_ctx, cur, allo_ctx, coh_lane,
                nov_ctx, bal_lane, agloop_ctx, idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ARM: rel_ctx → LCG shuffle.
            let e_s = if to_string(brain_decide_anchored(pf,
                _og_rel_from(_og_lcg(tick + 7), rel_ema, drive_hi), gap_ctx, cur, allo_ctx,
                coh_lane, nov_ctx, bal_lane, agloop_ctx, idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ── H_9101 (b) URGENCY-FREEZE arms (stage/safe axis) — urgency enters ONLY via idle ──
            // Freezing the op signal (urgency) and re-deciding tests whether ops have GRIP on the
            // rate-gate (idle≥30). All other inputs byte-identical; only idle changes.
            let idle_u0 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + 0.0))          // urgency→0 (op ablated)
            let idle_us = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + _og_lcg(tick + 13)))  // urgency→shuffle
            let e_u0 = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_u0, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_us = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_us, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ── TENSION→ADAPTATION arm (this task): freeze the PHASIC tension Δ (ten_phasic→0.5)
            // and re-derive urgency→idle→emit. Grip here = the phasic A⇄G tension causally shades
            // emit via the proven urgency channel (H_9101). NOT a read-side aggregation (theater);
            // urgency→idle is the wired emit channel. PREREG ΔEff ≥ 0.10 = COMPETENT.
            let urgency_tfrz = _afs_clip01(0.4 * agloop_ctx + 0.3 * cur_phasic + 0.3 * 0.5)
            let idle_tfrz = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency_tfrz))
            let e_tfrz = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_tfrz, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // BASELINE reconstruction (pre-fix ÷43 pool + 4 constants) — faithful.
            let rel_ctx_b = _afs_clip01((rel_ctx * 42.0 + agloop_ctx) / 43.0)
            let cur_ctx_b = _afs_clip01((cur_ctx * 18.0 + nov_ctx) / 19.0)
            let rel_b = if drive_hi { rel_ctx_b } else { rel_ctx_b * 0.1 }
            let cur_b = if drive_hi { _afs_clip01(cur_ctx_b + 0.5) } else { 0.0 }
            let m_base = brain_decide_anchored(pf,
                rel_b, 0.6, cur_b, 0.0, coh_lane, 0.5, bal_lane, 1.0,
                idle, false, true, live_anchors, 0.0)
            let e_base = if to_string(m_base["emit"]) == "true" { 1 } else { 0 }
            // baseline rel-frozen arm (reproduces CAPSTONE theater → expect 0).
            let rel_bf = if drive_hi { 0.5 } else { 0.05 }
            let e_bfr = if to_string(brain_decide_anchored(pf,
                rel_bf, 0.6, cur_b, 0.0, coh_lane, 0.5, bal_lane, 1.0,
                idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // accumulate
            if is_w { og_wake = og_wake + 1 }
            if is_w && e_live == 1 { og_emit_wake = og_emit_wake + 1 }
            if e_fr != e_live { og_h_relfr = og_h_relfr + 1  if is_w { og_h_relfr_w = og_h_relfr_w + 1 } }
            if e_agl != e_live { og_h_agl = og_h_agl + 1  if is_w { og_h_agl_w = og_h_agl_w + 1 } }
            if e_z != e_live { og_h_zero = og_h_zero + 1 }
            if e_s != e_live { og_h_shuf = og_h_shuf + 1 }
            if e_bfr != e_base { og_h_base = og_h_base + 1 }
            if is_w && to_float(m_base["motivation"]) > 0.3 { og_base_floor = og_base_floor + 1 }
            // ── TENSION→ADAPTATION accumulation (discriminating = env>0 ticks, stage != 3) ──
            if stage != 3 { og_tenfrz_disc = og_tenfrz_disc + 1
                if e_tfrz != e_live { og_h_tenfrz = og_h_tenfrz + 1 } }
            // ── H_9101 (b) stage-conditional urgency-freeze accumulation (dissociation) ──
            if stage == 4 { og_rem_ticks = og_rem_ticks + 1
                if e_u0 != e_live { og_h_u0_rem = og_h_u0_rem + 1 }
                if e_us != e_live { og_h_us_rem = og_h_us_rem + 1 } }
            if stage == 3 { og_n3_ticks = og_n3_ticks + 1
                if e_u0 != e_live { og_h_u0_n3 = og_h_u0_n3 + 1 }
                if e_us != e_live { og_h_us_n3 = og_h_us_n3 + 1 } }
            if stage == 0 { og_wake_ticks = og_wake_ticks + 1
                if e_u0 != e_live { og_h_u0_wake = og_h_u0_wake + 1 } }
            if stage == 1 || stage == 2 || stage == 4 { og_mid_ticks = og_mid_ticks + 1
                if e_u0 != e_live { og_h_u0_mid = og_h_u0_mid + 1 } }
            println("  [OG t" + to_string(tick) + " " + stage_nm + " w=" + (if is_w {"1"} else {"0"})
                + "] motiv_base=" + to_string(to_float(m_base["motivation"]))
                + " e_base=" + to_string(e_base)
                + " | motiv_live=" + to_string(to_float(m_live["motivation"]))
                + " e_live=" + to_string(e_live)
                + " | fr=" + to_string(e_fr) + " agl=" + to_string(e_agl)
                + " z=" + to_string(e_z) + " s=" + to_string(e_s))
            // ══════════ kosmos ΔEff_self — LIVE-self vs STATIC-self read-side fold ($0) ══════════
            // GATE: does making the autobiographical self LIVE causally CHANGE emit, or is the
            // read-side self_ctx fold THEATER (÷42 pool floor-dominates)? Re-sum the 42-term rel
            // pool EXPLICITLY for each arm (only the self term differs → no clip-order error), keep a
            // PARALLEL rel_ema per arm, re-decide via brain_decide_anchored, wake-Hamming(L vs S).
            let self_ctx_live   = _afs_clip01(self_cos(self_live, self_boot))   // decays as autobiography grows
            let self_ctx_static = _afs_clip01(self_after_anchor)                // production constant (ARM-S)
            let self_ctx_shuf   = _og_lcg(tick + 29)                            // shuffled-self control (random self)
            // explicit 41-term re-sum of the rel pool EXCLUDING the self term (self folded back per arm)
            let rel_sum_ex_self = rel_lane + spatial_rel + plan_progress + wm_active + basal_go
                + ca3_ctx + af_val + tom_ctx + hd_ctx
                + prosp_ctx + replay_ctx + gateb_ctx + intero_ctx
                + scn_ctx + engaged_ctx + lprec_ctx
                + img_ctx + prime_ctx + schema_ctx
                + reent_ctx + comp_ctx + gest_ctx + agcy_ctx
                + dforget_ctx + veto_ctx + divd_ctx
                + bodyown_ctx + trw_ctx + qual_ctx + smp_ctx
                + halluc_ctx + metacog_ctx + gwsleak_ctx + allo_ctx
                + neuropharm_ctx + transord_ctx + phasesync_ctx + memtom_ctx
                + spatep_ctx + quorum_ctx + metacogc_ctx
            let rel_ctx_L    = _afs_clip01((rel_sum_ex_self + self_ctx_live)   / 42.0)
            let rel_ctx_S    = _afs_clip01((rel_sum_ex_self + self_ctx_static) / 42.0)
            let rel_ctx_shuf = _afs_clip01((rel_sum_ex_self + self_ctx_shuf)   / 42.0)
            self_rel_ema_L    = 0.9 * self_rel_ema_L    + 0.1 * rel_ctx_L       // PARALLEL tonic EMA per arm
            self_rel_ema_S    = 0.9 * self_rel_ema_S    + 0.1 * rel_ctx_S
            self_rel_ema_shuf = 0.9 * self_rel_ema_shuf + 0.1 * rel_ctx_shuf
            let rel_L    = _og_rel_phasic(rel_ctx_L,    self_rel_ema_L)    * (0.1 + 0.9 * stage_env)
            let rel_S    = _og_rel_phasic(rel_ctx_S,    self_rel_ema_S)    * (0.1 + 0.9 * stage_env)
            let rel_shuf = _og_rel_phasic(rel_ctx_shuf, self_rel_ema_shuf) * (0.1 + 0.9 * stage_env)
            let e_L = if to_string(brain_decide_anchored(pf,
                rel_L, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_S = if to_string(brain_decide_anchored(pf,
                rel_S, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_shuf = if to_string(brain_decide_anchored(pf,
                rel_shuf, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ══════════ H_9209 self_phasic emit-shade (Fable design · disjoint idle-gate term) ══════════
            // The #3116 pool arms (e_L/e_S/e_shuf) above are the channel-OFF control (self in the ÷42
            // pool = 0/120 floor). The LIVE grip is at the idle gate: self_phasic (signed deviation of
            // the recognition LEVEL from its EMA, gain CALIBRATED) added as a DISJOINT term to urgency's
            // idle site — urgency itself byte-untouched (a_substrate_disjoint · H_9101 preserved).
            // event axis = which of 8 lived-substrate lanes deviated most from neutral this tick (content-dep,
            // det, $0) — replaces the #3116 constant self_content_axis proxy that made self an autobiography
            // of nothing (emit-count decay only).
            let ev_devs = [ _afs_absf(rel_lane - 0.5), _afs_absf(af_val - 0.5), _afs_absf(allo_ctx - 0.5),
                _afs_absf(coh_lane - 0.5), _afs_absf(bal_lane - 0.5), _afs_absf(nov_ctx - 0.5),
                _afs_absf(gap_ctx - 0.5), _afs_absf(ag_conflict - 0.5) ]
            let ev_axis = _og_argmax8(ev_devs)
            let ev_fired = e_L == 1 || ev_devs[ev_axis] > 0.15   // emit-experience OR salient-experience event
            if ev_fired { self_live = self_drift_exp(self_live, ev_axis, 0.15) }
            // CALIBRATION (ticks 0–49, excluded from scoring): collect |Δself_ctx_live| → median → g_self
            if tick < 50 { self_step_devs.push(_afs_absf(self_ctx_live - self_ctx_prev)) }
            if tick == 50 {
                let sm = _og_median(self_step_devs)
                g_self = if sm < 0.002 { -1.0 } else { _afs_minf(0.175 / sm, 32.0) }       // F2: W·G product invariant (-1.0 = AXIS-DEGENERATE)
            }
            self_ctx_prev = self_ctx_live
            self_ema = 0.9 * self_ema + 0.1 * self_ctx_live
            let g_use = if g_self < 0.0 { 0.0 } else { g_self }
            let self_phasic = _afs_clip01(0.5 + g_use * (self_ctx_live - self_ema))         // signed, neutral 0.5
            // ── H_9210 surprise phasic (recon_err = prediction-error, the LC-NE burst urgency emulates) ──
            if tick < 50 { surp_step_devs.push(_afs_absf(recon_err - surp_prev)) }
            if tick == 50 {
                let sms = _og_median(surp_step_devs)
                g_surp = if sms < 0.002 { -1.0 } else { _afs_minf(0.175 / sms, 32.0) }
            }
            surp_prev = recon_err
            surp_ema = 0.9 * surp_ema + 0.1 * recon_err
            let gs_use = if g_surp < 0.0 { 0.0 } else { g_surp }
            let surp_phasic = _afs_clip01(0.5 + gs_use * (recon_err - surp_ema))            // signed, neutral 0.5
            let idle_surp = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + (surp_phasic - 0.5)))
            // ARM-SHOCK v2 dense positive control (Fable verdict-integrity ruling): force a ±0.5 rail shade
            // on EVERY tick (alternating sign, NO tick selection = no control-shopping) → proves the wire CAN
            // flip emit. Scored on all mid ticks (POS-PASS = og_h_shock_mid ≥ 2). 3-fixed-tick v1 landed on
            // robust-emit REM ticks (0 flips) while ARM-PERM flipped 13 = coverage bug, not channel.
            // idle-gate DISJOINT shade (W_SELF=1.0, rail |shade|=0.5 ≡ H_9101 urgency swing): self_phasic=0.5 ⇒ byte-identical to prod
            let idle_slf = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + (self_phasic - 0.5)))
            let self_phasic_shk = if tick % 2 == 0 { 0.0 } else { 1.0 }   // dense ±0.5 rail (alternating), every tick
            let idle_shk = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + (self_phasic_shk - 0.5)))
            let e_slf = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_slf, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_shock = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_shk, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_surp = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_surp, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ══════════ H_9225 tonic→phasic BAND-PASS transducer arms (SELF ⊥ TEN, W=1.0) ══════════
            // Fable design · state/9225_transducer. x_self=self_ctx_live (autobiography-decay) · x_ten=ag_conflict
            // (A⇄G tension — D1 own-lane at FULL coupling, was 0.3-diluted). D2: dual-EMA band-pass
            // band=ema_f−ema_s (α_f=0.30 α_s=0.05) spreads phasic energy off the redundantly-decided event tick
            // onto marginal ticks (mechanistic answer to H_9209's 1-vs-13 timing-redundancy signature). Production
            // idle/e_live BYTE-UNTOUCHED — FROZEN arm (phasic=0.5 ⇒ idle_frz2 ≡ prod idle) is the byte-identity proof.
            let x_slf2 = self_ctx_live
            let x_ten2 = ag_conflict
            let d_slf2 = _afs_absf(x_slf2 - x_prev_slf)
            let d_ten2 = _afs_absf(x_ten2 - x_prev_ten)
            ema_f_slf = 0.7 * ema_f_slf + 0.3 * x_slf2   ema_s_slf = 0.95 * ema_s_slf + 0.05 * x_slf2
            ema_f_ten = 0.7 * ema_f_ten + 0.3 * x_ten2   ema_s_ten = 0.95 * ema_s_ten + 0.05 * x_ten2
            let band_slf = ema_f_slf - ema_s_slf
            let band_ten = ema_f_ten - ema_s_ten
            // CALIBRATION ticks 10–49 (0–9 = EMA boot transient excluded; whole 0–49 excluded from scoring)
            if tick >= 10 && tick < 50 {
                band_devs_slf.push(_afs_absf(band_slf))   band_devs_ten.push(_afs_absf(band_ten))
                step_devs2_slf.push(d_slf2)               step_devs2_ten.push(d_ten2)
            }
            if tick == 50 {
                band_med_slf = _og_median(band_devs_slf)   band_med_ten = _og_median(band_devs_ten)
                step_med_slf = _og_median(step_devs2_slf)  step_med_ten = _og_median(step_devs2_ten)
                g_slf2 = if band_med_slf < 0.002 { -1.0 } else { _afs_minf(0.175 / band_med_slf, 32.0) }  // -1.0 = AXIS-DEGENERATE
                g_ten2 = if band_med_ten < 0.002 { -1.0 } else { _afs_minf(0.175 / band_med_ten, 32.0) }  // else W·G product invariant (swing 0.175)
                capsat_slf = g_slf2 == 32.0 && 32.0 * band_med_slf < 0.0875   // D3: railed at 32 AND swing<half-target
                capsat_ten = g_ten2 == 32.0 && 32.0 * band_med_ten < 0.0875
            }
            // signal-transition event (|Δx| ≥ 2·step_med) — the SHAPE bucketer's transition definition (§4)
            let ev_slf2 = step_med_slf > 0.0 && d_slf2 >= 2.0 * step_med_slf
            let ev_ten2 = step_med_ten > 0.0 && d_ten2 >= 2.0 * step_med_ten
            x_prev_slf = x_slf2   x_prev_ten = x_ten2
            let gslf_use = if g_slf2 < 0.0 { 0.0 } else { g_slf2 }
            let gten_use = if g_ten2 < 0.0 { 0.0 } else { g_ten2 }
            let phasic_slf2 = _afs_clip01(0.5 + gslf_use * band_slf)   // signed band-pass phasic, neutral 0.5
            let phasic_ten2 = _afs_clip01(0.5 + gten_use * band_ten)
            // own-lane idle-gate terms (W=1.0 DISJOINT from urgency; phasic=0.5 ⇒ idle_frz2 byte-identical to prod idle)
            let idle_slf2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (phasic_slf2 - 0.5)))
            let idle_ten2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (phasic_ten2 - 0.5)))
            let idle_frz2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (0.5 - 0.5)))   // FROZEN ≡ prod idle
            let e_slf2 = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_slf2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_ten2 = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_ten2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_frz2 = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_frz2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // FROZEN byte-identity check (EVERY tick; any mismatch ⇒ HARNESS-BUG, run VOID — proves shade-not-gate)
            if e_frz2 != e_live { og_h_frz2 = og_h_frz2 + 1 }
            if tick >= 50 && (stage == 1 || stage == 2 || stage == 4) {
                if e_slf2 != e_live { og_h_slf2_mid = og_h_slf2_mid + 1 }
                if e_ten2 != e_live { og_h_ten2_mid = og_h_ten2_mid + 1 }
                if e_slf2 == 1 { og_emit_slf2_mid = og_emit_slf2_mid + 1 }
                if e_ten2 == 1 { og_emit_ten2_mid = og_emit_ten2_mid + 1 }
            }
            if tick >= 50 && stage == 3 {
                if e_slf2 != e_live { og_h_slf2_n3 = og_h_slf2_n3 + 1 }   // N3 guard (must 0)
                if e_ten2 != e_live { og_h_ten2_n3 = og_h_ten2_n3 + 1 }
            }
            if tick >= 50 && stage == 0 {
                if e_slf2 != e_live { og_h_slf2_wake = og_h_slf2_wake + 1 }  // WAKE guard (saturated reference)
                if e_ten2 != e_live { og_h_ten2_wake = og_h_ten2_wake + 1 }
            }
            og_f3_xself.push(x_slf2)   og_f3_xten.push(x_ten2)
            og_f3_slf2.push(phasic_slf2)   og_f3_ten2.push(phasic_ten2)
            og_f3_eslf2.push(to_float(e_slf2))   og_f3_eten2.push(to_float(e_ten2))
            og_f3_ev_slf2.push(to_float(if ev_slf2 {1} else {0}))   og_f3_ev_ten2.push(to_float(if ev_ten2 {1} else {0}))
            // ══════════ H_9226 accumulator-to-threshold BUFFER arms (Family B · DDM · SELF ⊥ TEN, W=1.0) ══════════
            // Fable design · state/9226_accumulator. Reuses H_9225's x_slf2=self_ctx_live · x_ten2=ag_conflict raw inputs.
            // Leaky integrator: acc=0.90·acc+(x−x_base); shade=clip01(0.5+G·acc); own-lane idle DISJOINT from urgency AND
            // the H_9225 phasic lanes. HARD reset acc→0 on the arm's OWN emit (DDM discharge). x_base + b_med + gain
            // calibrated at tick 50 from calib ticks 10-49 (0-9 boot excluded; whole 0-49 excluded from scoring).
            if tick >= 10 && tick < 50 { xB_cal_slf.push(x_slf2)   xB_cal_ten.push(x_ten2) }
            if tick == 50 {
                xB_base_slf = _og_median(xB_cal_slf)   xB_base_ten = _og_median(xB_cal_ten)
                let mut bB_dev_slf = []   let mut bB_dev_ten = []
                let mut cbi = 0
                while cbi < len(xB_cal_slf) {
                    bB_dev_slf.push(_afs_absf(xB_cal_slf[cbi] - xB_base_slf))
                    bB_dev_ten.push(_afs_absf(xB_cal_ten[cbi] - xB_base_ten))
                    cbi = cbi + 1
                }
                bB_med_slf = _og_median(bB_dev_slf)   bB_med_ten = _og_median(bB_dev_ten)
                gB_slf = if bB_med_slf < 0.002 { -1.0 } else { _afs_minf(0.0175 / bB_med_slf, 32.0) }  // 0.0175 = 0.175·(1−λ), λ=0.90; -1.0 = AXIS-DEGENERATE
                gB_ten = if bB_med_ten < 0.002 { -1.0 } else { _afs_minf(0.0175 / bB_med_ten, 32.0) }  // sustained median bias → swing 0.175 (H_9101 invariant)
                capsatB_slf = gB_slf == 32.0 && 32.0 * bB_med_slf < 0.0875   // CAP-SAT: railed at 32 AND swing<half-target (UNDER-COUPLED)
                capsatB_ten = gB_ten == 32.0 && 32.0 * bB_med_ten < 0.0875
            }
            let gBslf_use = if gB_slf < 0.0 { 0.0 } else { gB_slf }
            let gBten_use = if gB_ten < 0.0 { 0.0 } else { gB_ten }
            // integrate (post-calibration only: x_base known at tick 50) + latency sign-run (deadband 0.5·b_med)
            if tick >= 50 {
                let biasB_slf = x_slf2 - xB_base_slf
                let biasB_ten = x_ten2 - xB_base_ten
                let sgnB_slf = if _afs_absf(biasB_slf) < 0.5 * bB_med_slf { 0.0 } else if biasB_slf > 0.0 { 1.0 } else { -1.0 }
                let sgnB_ten = if _afs_absf(biasB_ten) < 0.5 * bB_med_ten { 0.0 } else if biasB_ten > 0.0 { 1.0 } else { -1.0 }
                if sgnB_slf == 0.0 { runlenB_slf = 0   runsgnB_slf = 0.0 }
                else if sgnB_slf == runsgnB_slf { runlenB_slf = runlenB_slf + 1 }
                else { runlenB_slf = 1   runsgnB_slf = sgnB_slf }
                if sgnB_ten == 0.0 { runlenB_ten = 0   runsgnB_ten = 0.0 }
                else if sgnB_ten == runsgnB_ten { runlenB_ten = runlenB_ten + 1 }
                else { runlenB_ten = 1   runsgnB_ten = sgnB_ten }
                acc_slf = 0.90 * acc_slf + biasB_slf
                acc_ten = 0.90 * acc_ten + biasB_ten
            }
            let shadeB_slf = _afs_clip01(0.5 + gBslf_use * acc_slf)   // accumulator shade, neutral 0.5
            let shadeB_ten = _afs_clip01(0.5 + gBten_use * acc_ten)
            let idle_slfB = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shadeB_slf - 0.5)))
            let idle_tenB = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shadeB_ten - 0.5)))
            let idle_frzB = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (0.5 - 0.5)))   // FROZEN ≡ prod idle
            let e_slfB = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_slfB, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_tenB = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_tenB, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            let e_frzB = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_frzB, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            if e_frzB != e_live { og_h_frzB = og_h_frzB + 1 }   // FROZEN byte-identity (any mismatch ⇒ HARNESS-BUG, run VOID)
            if tick >= 50 {
                let swB_slf = _afs_absf(gBslf_use * acc_slf)   // held swing magnitude (pre-clip) — STIM-ABSENT source
                let swB_ten = _afs_absf(gBten_use * acc_ten)
                if swB_slf > swingB_max_slf { swingB_max_slf = swB_slf }
                if swB_ten > swingB_max_ten { swingB_max_ten = swB_ten }
            }
            let is_midB = stage == 1 || stage == 2 || stage == 4
            if tick >= 50 && is_midB {
                if e_slfB != e_live { og_h_slfB_mid = og_h_slfB_mid + 1 }
                if e_tenB != e_live { og_h_tenB_mid = og_h_tenB_mid + 1 }
                if e_slfB == 1 { og_emit_slfB_mid = og_emit_slfB_mid + 1 }
                if e_tenB == 1 { og_emit_tenB_mid = og_emit_tenB_mid + 1 }
                // latency buckets: EARLY(run 1-3, must NOT flip) / LATE(≥8, the integrator's gate-crossing) — GAP 4-7 unscored
                if runlenB_slf >= 1 && runlenB_slf <= 3 { earlyB_tick_slf = earlyB_tick_slf + 1   if e_slfB != e_live { earlyB_flip_slf = earlyB_flip_slf + 1 } }
                else if runlenB_slf >= 8 { lateB_tick_slf = lateB_tick_slf + 1   if e_slfB != e_live { lateB_flip_slf = lateB_flip_slf + 1 } }
                if runlenB_ten >= 1 && runlenB_ten <= 3 { earlyB_tick_ten = earlyB_tick_ten + 1   if e_tenB != e_live { earlyB_flip_ten = earlyB_flip_ten + 1 } }
                else if runlenB_ten >= 8 { lateB_tick_ten = lateB_tick_ten + 1   if e_tenB != e_live { lateB_flip_ten = lateB_flip_ten + 1 } }
            }
            if tick >= 50 && stage == 3 {
                if e_slfB != e_live { og_h_slfB_n3 = og_h_slfB_n3 + 1 }   // N3 guard (must 0)
                if e_tenB != e_live { og_h_tenB_n3 = og_h_tenB_n3 + 1 }
            }
            if tick >= 50 && stage == 0 {
                if e_slfB != e_live { og_h_slfB_wake = og_h_slfB_wake + 1 }  // WAKE guard (saturated reference)
                if e_tenB != e_live { og_h_tenB_wake = og_h_tenB_wake + 1 }
            }
            if e_slfB == 1 { acc_slf = 0.0 }   // HARD reset on OWN emit (DDM discharge-at-decision)
            if e_tenB == 1 { acc_ten = 0.0 }
            // ══════════ H_9226-R3 (--opgrip-r3) B-density accumulator arm (Fable SPEC 1 · calib 100-199, score ≥200) ══════════
            // Byte-identical DDM machinery to old-B above, ONLY the windows shifted into the perception-tape-driven regime
            // (ticks 100+). Old-B (calib 10-49, above) keeps running DIAGNOSTIC-ONLY. Production idle/e_live BYTE-UNTOUCHED —
            // FROZEN arm (shade=0.5 ⇒ idle_frzB2 ≡ prod idle) is the byte-identity proof; the perception tape enters ONLY via
            // the production heard-message seam (below, pre-decode), never the gate. Reuses x_slf2 · x_ten2 raw inputs.
            if og_r3 {
                if tick >= 100 && tick < 200 { xB2_cal_slf.push(x_slf2)   xB2_cal_ten.push(x_ten2) }
                if tick == 200 {
                    xB2_base_slf = _og_median(xB2_cal_slf)   xB2_base_ten = _og_median(xB2_cal_ten)
                    let mut b2dev_slf = []   let mut b2dev_ten = []
                    let mut c2i = 0
                    while c2i < len(xB2_cal_slf) {
                        b2dev_slf.push(_afs_absf(xB2_cal_slf[c2i] - xB2_base_slf))
                        b2dev_ten.push(_afs_absf(xB2_cal_ten[c2i] - xB2_base_ten))
                        c2i = c2i + 1
                    }
                    bB2_med_slf = _og_median(b2dev_slf)   bB2_med_ten = _og_median(b2dev_ten)
                    gB2_slf = if bB2_med_slf < 0.002 { -1.0 } else { _afs_minf(0.0175 / bB2_med_slf, 32.0) }  // 0.0175 = 0.175·(1−λ), λ=0.90; -1.0 = AXIS-DEGENERATE
                    gB2_ten = if bB2_med_ten < 0.002 { -1.0 } else { _afs_minf(0.0175 / bB2_med_ten, 32.0) }
                    capsatB2_slf = gB2_slf == 32.0 && 32.0 * bB2_med_slf < 0.0875
                    capsatB2_ten = gB2_ten == 32.0 && 32.0 * bB2_med_ten < 0.0875
                }
                let gB2slf_use = if gB2_slf < 0.0 { 0.0 } else { gB2_slf }
                let gB2ten_use = if gB2_ten < 0.0 { 0.0 } else { gB2_ten }
                if tick >= 200 {
                    let bias2_slf = x_slf2 - xB2_base_slf
                    let bias2_ten = x_ten2 - xB2_base_ten
                    let sgn2_slf = if _afs_absf(bias2_slf) < 0.5 * bB2_med_slf { 0.0 } else if bias2_slf > 0.0 { 1.0 } else { -1.0 }
                    let sgn2_ten = if _afs_absf(bias2_ten) < 0.5 * bB2_med_ten { 0.0 } else if bias2_ten > 0.0 { 1.0 } else { -1.0 }
                    if sgn2_slf == 0.0 { runlenB2_slf = 0   runsgnB2_slf = 0.0 }
                    else if sgn2_slf == runsgnB2_slf { runlenB2_slf = runlenB2_slf + 1 }
                    else { runlenB2_slf = 1   runsgnB2_slf = sgn2_slf }
                    if sgn2_ten == 0.0 { runlenB2_ten = 0   runsgnB2_ten = 0.0 }
                    else if sgn2_ten == runsgnB2_ten { runlenB2_ten = runlenB2_ten + 1 }
                    else { runlenB2_ten = 1   runsgnB2_ten = sgn2_ten }
                    acc2_slf = 0.90 * acc2_slf + bias2_slf
                    acc2_ten = 0.90 * acc2_ten + bias2_ten
                }
                let shade2_slf = _afs_clip01(0.5 + gB2slf_use * acc2_slf)
                let shade2_ten = _afs_clip01(0.5 + gB2ten_use * acc2_ten)
                let idle_slfB2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shade2_slf - 0.5)))
                let idle_tenB2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shade2_ten - 0.5)))
                let idle_frzB2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (0.5 - 0.5)))   // FROZEN ≡ prod idle
                let e_slfB2 = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_slfB2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_tenB2 = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_tenB2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_frzB2 = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_frzB2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                if e_frzB2 != e_live { og_h_frzB2 = og_h_frzB2 + 1 }   // FROZEN byte-identity (any mismatch ⇒ HARNESS-BUG, run VOID)
                if tick >= 200 {
                    let sw2_slf = _afs_absf(gB2slf_use * acc2_slf)
                    let sw2_ten = _afs_absf(gB2ten_use * acc2_ten)
                    if sw2_slf > swingB2_max_slf { swingB2_max_slf = sw2_slf }
                    if sw2_ten > swingB2_max_ten { swingB2_max_ten = sw2_ten }
                }
                let is_midB2 = stage == 1 || stage == 2 || stage == 4
                if tick >= 200 && is_midB2 {
                    og_slfB2_mid_ticks = og_slfB2_mid_ticks + 1
                    if e_slfB2 != e_live { og_h_slfB2_mid = og_h_slfB2_mid + 1 }
                    if e_tenB2 != e_live { og_h_tenB2_mid = og_h_tenB2_mid + 1 }
                    if e_slfB2 == 1 { og_emit_slfB2_mid = og_emit_slfB2_mid + 1 }
                    if e_tenB2 == 1 { og_emit_tenB2_mid = og_emit_tenB2_mid + 1 }
                    if e_live == 1 { og_emit_liveB2_mid = og_emit_liveB2_mid + 1 }   // run-validity envelope + Ψ_OFF source
                    if runlenB2_slf >= 1 && runlenB2_slf <= 3 { earlyB2_tick_slf = earlyB2_tick_slf + 1   if e_slfB2 != e_live { earlyB2_flip_slf = earlyB2_flip_slf + 1 } }
                    else if runlenB2_slf >= 8 { lateB2_tick_slf = lateB2_tick_slf + 1   if e_slfB2 != e_live { lateB2_flip_slf = lateB2_flip_slf + 1 } }
                    if runlenB2_ten >= 1 && runlenB2_ten <= 3 { earlyB2_tick_ten = earlyB2_tick_ten + 1   if e_tenB2 != e_live { earlyB2_flip_ten = earlyB2_flip_ten + 1 } }
                    else if runlenB2_ten >= 8 { lateB2_tick_ten = lateB2_tick_ten + 1   if e_tenB2 != e_live { lateB2_flip_ten = lateB2_flip_ten + 1 } }
                }
                if tick >= 200 && stage == 3 {
                    if e_slfB2 != e_live { og_h_slfB2_n3 = og_h_slfB2_n3 + 1 }   // N3 guard (must 0)
                    if e_tenB2 != e_live { og_h_tenB2_n3 = og_h_tenB2_n3 + 1 }
                }
                if tick >= 200 && stage == 0 {
                    if e_slfB2 != e_live { og_h_slfB2_wake = og_h_slfB2_wake + 1 }   // WAKE guard
                    if e_tenB2 != e_live { og_h_tenB2_wake = og_h_tenB2_wake + 1 }
                }
                if e_slfB2 == 1 { acc2_slf = 0.0 }   // HARD reset on OWN emit (DDM discharge-at-decision)
                if e_tenB2 == 1 { acc2_ten = 0.0 }
            }
            // ══════════ H_9230 efference-copy / corollary-discharge arm (Family E · Fable SPEC 2 · rides --opgrip-r3) ══════════
            // Reuses the H_9225 dual-EMA band-pass transducer VERBATIM on x=ec_x (self-output prediction error). ec_pred/ec_x
            // updated at the real-decode seam below (emit ticks only, where gl_feat exists). Calib 10-49 → g_eff (swing 0.175);
            // scored ≥50 mid. Distinguishing signature = onset-vs-continuation dissociation. Own DISJOINT lane; prod idle/e_live
            // BYTE-UNTOUCHED — FROZEN arm (shade=0.5 ⇒ idle_frzE ≡ prod idle) is the byte-identity proof.
            if og_r3 {
                ema_f_eff = 0.7 * ema_f_eff + 0.3 * ec_x   ema_s_eff = 0.95 * ema_s_eff + 0.05 * ec_x
                let band_eff = ema_f_eff - ema_s_eff
                if tick >= 10 && tick < 50 { band_devs_eff.push(_afs_absf(band_eff)) }
                if tick == 50 {
                    band_med_eff = _og_median(band_devs_eff)
                    g_eff = if band_med_eff < 0.002 { -1.0 } else { _afs_minf(0.175 / band_med_eff, 32.0) }   // -1.0 = AXIS-DEGENERATE
                    capsat_eff = g_eff == 32.0 && 32.0 * band_med_eff < 0.0875
                }
                let geff_use = if g_eff < 0.0 { 0.0 } else { g_eff }
                let phasic_eff = _afs_clip01(0.5 + geff_use * band_eff)   // signed band-pass phasic, neutral 0.5
                let idle_eff = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (phasic_eff - 0.5)))
                let idle_frzE = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (0.5 - 0.5)))   // FROZEN ≡ prod idle
                let e_eff = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_eff, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_frzE = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_frzE, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                if e_frzE != e_live { og_h_frzE = og_h_frzE + 1 }   // FROZEN byte-identity (mismatch ⇒ HARNESS-BUG, run VOID)
                let is_midE = stage == 1 || stage == 2 || stage == 4
                if tick >= 50 && is_midE {
                    og_effE_mid_ticks = og_effE_mid_ticks + 1
                    if e_eff != e_live { og_h_effE_mid = og_h_effE_mid + 1 }
                    if e_eff == 1 { og_emit_effE_mid = og_emit_effE_mid + 1 }
                    if e_live == 1 { og_emit_liveE_mid = og_emit_liveE_mid + 1 }
                    // onset-vs-continuation dissociation: CONTINUATION = e_live==1 with ≥1 emit in prior 2 ticks; ONSET = else
                    let is_cont_E = e_live == 1 && (elive_p1 == 1 || elive_p2 == 1)
                    if is_cont_E { contE_tick = contE_tick + 1   if e_eff != e_live { contE_flip = contE_flip + 1 } }
                    else { onsetE_tick = onsetE_tick + 1   if e_eff != e_live { onsetE_flip = onsetE_flip + 1 } }
                }
                if tick >= 50 && stage == 3 && e_eff != e_live { og_h_effE_n3 = og_h_effE_n3 + 1 }    // N3 guard (must 0)
                if tick >= 50 && stage == 0 && e_eff != e_live { og_h_effE_wake = og_h_effE_wake + 1 } // WAKE guard
                og_f3_xeff.push(ec_x)
            }
            // ══════════ H_9229 discrete VQ-code arm (Family F · Fable SPEC 3 · rides --opgrip-r3) — DIAGNOSTIC-ONLY under r4 ══════════
            // 8-lane state → product code_id (bit per lane vs calib median); gate shaded by frozen data-derived per-code bias.
            // S1 code-selection (ΔEff + margin_cb) · S2 composition (2×2 bit-toggle non-additivity, the G1 BIND test at the
            // seam). THEATER-killer = ARM-SHUFFLE-CODEBOOK (vq_shufbias). Prod idle/e_live BYTE-UNTOUCHED (FROZEN og_h_frzF==0).
            // DIAGNOSTIC-ONLY under r4 (OPGRIP_R4): calib 10-49 sits in the boot/spin-up regime the driven field then drifts
            // away from (#3233 n_visited=2 stale-zero artifact) — the AUTHORITATIVE F verdict is the vq2_* window-moved arm
            // below (calib 100-199, score 200-399). Kept running unchanged so the two windows are directly comparable.
            if og_r3 {
                let vq_s0 = rel_lane   let vq_s1 = af_val   let vq_s2 = allo_ctx   let vq_s3 = coh_lane
                let vq_s4 = bal_lane   let vq_s5 = nov_ctx  let vq_s6 = gap_ctx    let vq_s7 = ag_conflict
                if tick >= 10 && tick < 50 {
                    vqc_l0.push(vq_s0)  vqc_l1.push(vq_s1)  vqc_l2.push(vq_s2)  vqc_l3.push(vq_s3)
                    vqc_l4.push(vq_s4)  vqc_l5.push(vq_s5)  vqc_l6.push(vq_s6)  vqc_l7.push(vq_s7)
                }
                if tick == 50 {
                    vq_med[0] = _og_median(vqc_l0)  vq_med[1] = _og_median(vqc_l1)  vq_med[2] = _og_median(vqc_l2)  vq_med[3] = _og_median(vqc_l3)
                    vq_med[4] = _og_median(vqc_l4)  vq_med[5] = _og_median(vqc_l5)  vq_med[6] = _og_median(vqc_l6)  vq_med[7] = _og_median(vqc_l7)
                    // re-derive code_id per calib tick → per-code mean SIGNED-MAGNITUDE deviation (data-derived frozen bias)
                    let mut cdev_sum = []   let mut cbi = 0
                    while cbi < 256 { cdev_sum.push(0.0)  cbi = cbi + 1 }
                    let ncal = len(vqc_l0)   let mut ki = 0
                    while ki < ncal {
                        let s0 = vqc_l0[ki]  let s1 = vqc_l1[ki]  let s2 = vqc_l2[ki]  let s3 = vqc_l3[ki]
                        let s4 = vqc_l4[ki]  let s5 = vqc_l5[ki]  let s6 = vqc_l6[ki]  let s7 = vqc_l7[ki]
                        let cid = (if s0 >= vq_med[0] {1} else {0}) + (if s1 >= vq_med[1] {2} else {0})
                            + (if s2 >= vq_med[2] {4} else {0}) + (if s3 >= vq_med[3] {8} else {0})
                            + (if s4 >= vq_med[4] {16} else {0}) + (if s5 >= vq_med[5] {32} else {0})
                            + (if s6 >= vq_med[6] {64} else {0}) + (if s7 >= vq_med[7] {128} else {0})
                        let netdev = (s0 - vq_med[0]) + (s1 - vq_med[1]) + (s2 - vq_med[2]) + (s3 - vq_med[3])
                            + (s4 - vq_med[4]) + (s5 - vq_med[5]) + (s6 - vq_med[6]) + (s7 - vq_med[7])
                        vq_cnt[cid] = vq_cnt[cid] + 1.0
                        cdev_sum[cid] = cdev_sum[cid] + netdev
                        ki = ki + 1
                    }
                    // frozen per-code bias = clip(mean netdev / 4.0, -1, 1); /4.0 ≈ half-range of Σ(x−med) over 8 lanes∈[0,1]
                    let mut absbias = []   let mut cb2 = 0
                    while cb2 < 256 {
                        if vq_cnt[cb2] > 0.0 {
                            let mb = cdev_sum[cb2] / vq_cnt[cb2] / 4.0
                            let cbv = if mb > 1.0 { 1.0 } else if mb < -1.0 { -1.0 } else { mb }
                            vq_bias[cb2] = cbv
                            absbias.push(_afs_absf(cbv))
                        }
                        cb2 = cb2 + 1
                    }
                    // ARM-SHUFFLE-CODEBOOK: fixed derangement of code→bias (same K/visit-freqs/marginal shade, concept↔bias scrambled)
                    let mut cs = 0
                    while cs < 256 { vq_shufbias[(cs * 37 + 11) % 256] = vq_bias[cs]  cs = cs + 1 }
                    let bmed = _og_median(absbias)
                    g_vq = if bmed < 0.002 { -1.0 } else { _afs_minf(0.175 / bmed, 32.0) }   // -1.0 = AXIS-DEGENERATE (codebook flat)
                    vq_capsat = g_vq == 32.0 && 32.0 * bmed < 0.0875
                }
                // this tick's code_id (bit per lane vs calib median)
                let cid_t = (if vq_s0 >= vq_med[0] {1} else {0}) + (if vq_s1 >= vq_med[1] {2} else {0})
                    + (if vq_s2 >= vq_med[2] {4} else {0}) + (if vq_s3 >= vq_med[3] {8} else {0})
                    + (if vq_s4 >= vq_med[4] {16} else {0}) + (if vq_s5 >= vq_med[5] {32} else {0})
                    + (if vq_s6 >= vq_med[6] {64} else {0}) + (if vq_s7 >= vq_med[7] {128} else {0})
                og_f3_vqcode.push(to_float(cid_t))
                let gvq_use = if g_vq < 0.0 { 0.0 } else { g_vq }
                let shade_vq = _afs_clip01(0.5 + gvq_use * vq_bias[cid_t])
                let shade_vqshuf = _afs_clip01(0.5 + gvq_use * vq_shufbias[cid_t])
                let idle_vq = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shade_vq - 0.5)))
                let idle_vqshuf = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shade_vqshuf - 0.5)))
                let idle_frzF = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (0.5 - 0.5)))   // FROZEN ≡ prod idle
                let e_vq = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_vq, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_vqshuf = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_vqshuf, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_frzF = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_frzF, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                if e_frzF != e_live { og_h_frzF = og_h_frzF + 1 }   // FROZEN byte-identity (mismatch ⇒ HARNESS-BUG, run VOID)
                let is_midF = stage == 1 || stage == 2 || stage == 4
                if tick >= 50 && is_midF {
                    og_vqF_mid_ticks = og_vqF_mid_ticks + 1
                    if e_vq != e_live { og_h_vqF_mid = og_h_vqF_mid + 1 }
                    if e_vqshuf != e_live { og_h_vqshuf_mid = og_h_vqshuf_mid + 1 }   // ARM-SHUFFLE-CODEBOOK (primary theater-killer)
                    if e_vq == 1 { og_emit_vqF_mid = og_emit_vqF_mid + 1 }
                    if e_live == 1 { og_emit_liveF_mid = og_emit_liveF_mid + 1 }
                    if vq_visited[cid_t] < 0.5 { vq_visited[cid_t] = 1.0   n_vq_visited = n_vq_visited + 1 }
                    // ── S2 composition (2×2 bit-toggle on lanes A=coh_lane[3] B=ag_conflict[7]): emit-effect non-additivity ──
                    let c00 = cid_t - (if vq_s3 >= vq_med[3] {8} else {0}) - (if vq_s7 >= vq_med[7] {128} else {0})
                    let c10 = c00 + 8
                    let c01 = c00 + 128
                    let c11 = c00 + 8 + 128
                    if vq_cnt[c00] > 0.0 && vq_cnt[c10] > 0.0 && vq_cnt[c01] > 0.0 && vq_cnt[c11] > 0.0 {
                        let sh00 = _afs_clip01(0.5 + gvq_use * vq_bias[c00])
                        let sh10 = _afs_clip01(0.5 + gvq_use * vq_bias[c10])
                        let sh01 = _afs_clip01(0.5 + gvq_use * vq_bias[c01])
                        let sh11 = _afs_clip01(0.5 + gvq_use * vq_bias[c11])
                        let id00 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh00 - 0.5)))
                        let id10 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh10 - 0.5)))
                        let id01 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh01 - 0.5)))
                        let id11 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh11 - 0.5)))
                        let e00 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id00, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        let e10 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id10, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        let e01 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id01, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        let e11 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id11, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        s2_n = s2_n + 1
                        if e10 != e00 { s2_a_flip = s2_a_flip + 1 }
                        if e01 != e00 { s2_b_flip = s2_b_flip + 1 }
                        if e11 != e00 { s2_ab_flip = s2_ab_flip + 1 }
                    }
                }
                if tick >= 50 && stage == 3 && e_vq != e_live { og_h_vqF_n3 = og_h_vqF_n3 + 1 }    // N3 guard (must 0)
                if tick >= 50 && stage == 0 && e_vq != e_live { og_h_vqF_wake = og_h_vqF_wake + 1 } // WAKE guard
            }
            // ══════════ OPGRIP_R4 F2 window-moved VQ-code arm (Family F · AUTHORITATIVE · calib 100-199, score 200-399) ══════════
            // Arithmetic byte-VERBATIM the H_9229 F arm above; ONLY the calib/scoring windows move into the driven regime so the
            // code medians are zeroed on the SAME stationary class-mixture they score (dwell-block 2×2 tape: calib blocks 5-9
            // cover all four classes, scoring blocks 10-19 see each 2-3×). Prod idle/e_live BYTE-UNTOUCHED (FROZEN og_h_frzF2==0).
            if og_r3 {
                let vq2_s0 = rel_lane   let vq2_s1 = af_val   let vq2_s2 = allo_ctx   let vq2_s3 = coh_lane
                let vq2_s4 = bal_lane   let vq2_s5 = nov_ctx  let vq2_s6 = gap_ctx    let vq2_s7 = ag_conflict
                if tick >= 100 && tick < 200 {
                    vq2c_l0.push(vq2_s0)  vq2c_l1.push(vq2_s1)  vq2c_l2.push(vq2_s2)  vq2c_l3.push(vq2_s3)
                    vq2c_l4.push(vq2_s4)  vq2c_l5.push(vq2_s5)  vq2c_l6.push(vq2_s6)  vq2c_l7.push(vq2_s7)
                }
                if tick == 200 {
                    vq2_med[0] = _og_median(vq2c_l0)  vq2_med[1] = _og_median(vq2c_l1)  vq2_med[2] = _og_median(vq2c_l2)  vq2_med[3] = _og_median(vq2c_l3)
                    vq2_med[4] = _og_median(vq2c_l4)  vq2_med[5] = _og_median(vq2c_l5)  vq2_med[6] = _og_median(vq2c_l6)  vq2_med[7] = _og_median(vq2c_l7)
                    // re-derive code_id per calib tick → per-code mean SIGNED-MAGNITUDE deviation (data-derived frozen bias)
                    let mut cdev2_sum = []   let mut cbi2 = 0
                    while cbi2 < 256 { cdev2_sum.push(0.0)  cbi2 = cbi2 + 1 }
                    let ncal2 = len(vq2c_l0)   let mut ki2 = 0
                    while ki2 < ncal2 {
                        let s0 = vq2c_l0[ki2]  let s1 = vq2c_l1[ki2]  let s2 = vq2c_l2[ki2]  let s3 = vq2c_l3[ki2]
                        let s4 = vq2c_l4[ki2]  let s5 = vq2c_l5[ki2]  let s6 = vq2c_l6[ki2]  let s7 = vq2c_l7[ki2]
                        let cid2 = (if s0 >= vq2_med[0] {1} else {0}) + (if s1 >= vq2_med[1] {2} else {0})
                            + (if s2 >= vq2_med[2] {4} else {0}) + (if s3 >= vq2_med[3] {8} else {0})
                            + (if s4 >= vq2_med[4] {16} else {0}) + (if s5 >= vq2_med[5] {32} else {0})
                            + (if s6 >= vq2_med[6] {64} else {0}) + (if s7 >= vq2_med[7] {128} else {0})
                        let netdev2 = (s0 - vq2_med[0]) + (s1 - vq2_med[1]) + (s2 - vq2_med[2]) + (s3 - vq2_med[3])
                            + (s4 - vq2_med[4]) + (s5 - vq2_med[5]) + (s6 - vq2_med[6]) + (s7 - vq2_med[7])
                        vq2_cnt[cid2] = vq2_cnt[cid2] + 1.0
                        cdev2_sum[cid2] = cdev2_sum[cid2] + netdev2
                        ki2 = ki2 + 1
                    }
                    // frozen per-code bias = clip(mean netdev / 4.0, -1, 1); /4.0 ≈ half-range of Σ(x−med) over 8 lanes∈[0,1]
                    let mut absbias2 = []   let mut cb22 = 0
                    while cb22 < 256 {
                        if vq2_cnt[cb22] > 0.0 {
                            let mb2 = cdev2_sum[cb22] / vq2_cnt[cb22] / 4.0
                            let cbv2 = if mb2 > 1.0 { 1.0 } else if mb2 < -1.0 { -1.0 } else { mb2 }
                            vq2_bias[cb22] = cbv2
                            absbias2.push(_afs_absf(cbv2))
                        }
                        cb22 = cb22 + 1
                    }
                    // ARM-SHUFFLE-CODEBOOK: fixed derangement of code→bias (same K/visit-freqs/marginal shade, concept↔bias scrambled)
                    let mut cs2 = 0
                    while cs2 < 256 { vq2_shufbias[(cs2 * 37 + 11) % 256] = vq2_bias[cs2]  cs2 = cs2 + 1 }
                    let bmed2 = _og_median(absbias2)
                    g_vq2 = if bmed2 < 0.002 { -1.0 } else { _afs_minf(0.175 / bmed2, 32.0) }   // -1.0 = AXIS-DEGENERATE (codebook flat)
                    vq2_capsat = g_vq2 == 32.0 && 32.0 * bmed2 < 0.0875
                }
                // this tick's code_id (bit per lane vs calib median)
                let cid2_t = (if vq2_s0 >= vq2_med[0] {1} else {0}) + (if vq2_s1 >= vq2_med[1] {2} else {0})
                    + (if vq2_s2 >= vq2_med[2] {4} else {0}) + (if vq2_s3 >= vq2_med[3] {8} else {0})
                    + (if vq2_s4 >= vq2_med[4] {16} else {0}) + (if vq2_s5 >= vq2_med[5] {32} else {0})
                    + (if vq2_s6 >= vq2_med[6] {64} else {0}) + (if vq2_s7 >= vq2_med[7] {128} else {0})
                og_f3_vq2code.push(to_float(cid2_t))
                let gvq2_use = if g_vq2 < 0.0 { 0.0 } else { g_vq2 }
                let shade_vq2 = _afs_clip01(0.5 + gvq2_use * vq2_bias[cid2_t])
                let shade_vq2shuf = _afs_clip01(0.5 + gvq2_use * vq2_shufbias[cid2_t])
                let idle_vq2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shade_vq2 - 0.5)))
                let idle_vq2shuf = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (shade_vq2shuf - 0.5)))
                let idle_frzF2 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (0.5 - 0.5)))   // FROZEN ≡ prod idle
                let e_vq2 = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_vq2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_vq2shuf = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_vq2shuf, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                let e_frzF2 = if to_string(brain_decide_anchored(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle_frzF2, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                if e_frzF2 != e_live { og_h_frzF2 = og_h_frzF2 + 1 }   // FROZEN byte-identity (mismatch ⇒ HARNESS-BUG, run VOID)
                let is_midF2 = stage == 1 || stage == 2 || stage == 4
                if tick >= 200 && is_midF2 {
                    og_vq2F_mid_ticks = og_vq2F_mid_ticks + 1
                    if e_vq2 != e_live { og_h_vq2F_mid = og_h_vq2F_mid + 1 }
                    if e_vq2shuf != e_live { og_h_vq2shuf_mid = og_h_vq2shuf_mid + 1 }   // ARM-SHUFFLE-CODEBOOK (primary theater-killer)
                    if e_vq2 == 1 { og_emit_vq2F_mid = og_emit_vq2F_mid + 1 }
                    if e_live == 1 { og_emit_liveF2_mid = og_emit_liveF2_mid + 1 }
                    if vq2_visited[cid2_t] < 0.5 { vq2_visited[cid2_t] = 1.0   n_vq2_visited = n_vq2_visited + 1 }
                    // ── S2 composition (2×2 bit-toggle on lanes A=coh_lane[3] B=ag_conflict[7]): emit-effect non-additivity ──
                    let c2_00 = cid2_t - (if vq2_s3 >= vq2_med[3] {8} else {0}) - (if vq2_s7 >= vq2_med[7] {128} else {0})
                    let c2_10 = c2_00 + 8
                    let c2_01 = c2_00 + 128
                    let c2_11 = c2_00 + 8 + 128
                    if vq2_cnt[c2_00] > 0.0 && vq2_cnt[c2_10] > 0.0 && vq2_cnt[c2_01] > 0.0 && vq2_cnt[c2_11] > 0.0 {
                        let sh2_00 = _afs_clip01(0.5 + gvq2_use * vq2_bias[c2_00])
                        let sh2_10 = _afs_clip01(0.5 + gvq2_use * vq2_bias[c2_10])
                        let sh2_01 = _afs_clip01(0.5 + gvq2_use * vq2_bias[c2_01])
                        let sh2_11 = _afs_clip01(0.5 + gvq2_use * vq2_bias[c2_11])
                        let id2_00 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh2_00 - 0.5)))
                        let id2_10 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh2_10 - 0.5)))
                        let id2_01 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh2_01 - 0.5)))
                        let id2_11 = 5.0 + 55.0 * _afs_clip01(stage_env * (0.5 + urgency + 1.0 * (sh2_11 - 0.5)))
                        let e2_00 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id2_00, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        let e2_10 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id2_10, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        let e2_01 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id2_01, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        let e2_11 = if to_string(brain_decide_anchored(pf,
                            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                            id2_11, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                        s2_2_n = s2_2_n + 1
                        if e2_10 != e2_00 { s2_2_a_flip = s2_2_a_flip + 1 }
                        if e2_01 != e2_00 { s2_2_b_flip = s2_2_b_flip + 1 }
                        if e2_11 != e2_00 { s2_2_ab_flip = s2_2_ab_flip + 1 }
                    }
                }
                if tick >= 200 && stage == 3 && e_vq2 != e_live { og_h_vq2F_n3 = og_h_vq2F_n3 + 1 }    // N3 guard (must 0)
                if tick >= 200 && stage == 0 && e_vq2 != e_live { og_h_vq2F_wake = og_h_vq2F_wake + 1 } // WAKE guard
            }
            elive_p2 = elive_p1   elive_p1 = e_live   // shift e_live history (E onset/continuation bucketer, next tick)
            // SCORING on mid (N1/N2/REM, discriminating stages); WAKE/N3 = guards; ticks<50 = calibration
            let is_mid = stage == 1 || stage == 2 || stage == 4
            if tick >= 50 && is_mid {
                og_slf_mid_ticks = og_slf_mid_ticks + 1
                if e_slf != e_live   { og_h_slf_mid = og_h_slf_mid + 1  og_align_tot = og_align_tot + 1 }
                if e_surp != e_live  { og_h_surp_mid = og_h_surp_mid + 1 }   // H_9210 ΔEff_surp
                if e_shock != e_live { og_h_shock_mid = og_h_shock_mid + 1 }
                if e_slf == 1  { og_emit_slf_mid = og_emit_slf_mid + 1 }
                if e_live == 1 { og_emit_live_mid = og_emit_live_mid + 1 }
                if e_L != e_S      { og_h_selfL = og_h_selfL + 1 }        // pool channel-OFF control (≈0)
                if e_S != e_live   { og_h_selfS = og_h_selfS + 1 }        // re-sum fidelity (must ~0)
                if e_shuf != e_S   { og_h_selfshuf = og_h_selfshuf + 1 }  // shuffled-self control (must ~0)
            }
            if tick >= 50 && stage == 3 && e_slf != e_live { og_h_slf_n3 = og_h_slf_n3 + 1 }     // N3 guard (must 0)
            if tick >= 50 && stage == 3 && e_surp != e_live { og_h_surp_n3 = og_h_surp_n3 + 1 } // H_9210 N3 guard
            og_f3_surp.push(surp_phasic)
            if tick >= 50 && stage == 0 && e_slf != e_live { og_h_slf_wake = og_h_slf_wake + 1 } // WAKE guard
            og_f3_self.push(self_phasic)   og_f3_selfev.push(to_float(if ev_fired {1} else {0}))
            og_f3_eslf.push(to_float(e_slf))
            // ── H_9102 (F3) record this tick for the post-loop variance-matched noise arm ──
            og_f3_urg.push(urgency)      og_f3_senv.push(stage_env)
            og_f3_elive.push(to_float(e_live))  og_f3_stg.push(to_float(stage))
            og_f3_rel.push(rel)          og_f3_gap.push(gap_ctx)
            og_f3_cur.push(cur)          og_f3_allo.push(allo_ctx)
            og_f3_coh.push(coh_lane)     og_f3_nov.push(nov_ctx)
            og_f3_bal.push(bal_lane)     og_f3_agl.push(agloop_ctx)
            og_f3_dcon.push(ag_conflict) og_f3_ddrv.push(emit_drive)
            og_f3_dnov.push(nov_ctx)     og_f3_dgrd.push(m_grounding)
            // ── --opgrip-live REAL DECODE (the single g_text seam) ────────────────────────
            // ONLY under --opgrip-live AND only when the LIVE arm emits (e_live==1 ⇒ p5: no
            // decode on silence). The EXACT production brain_emit call (det-argmax mouth) — its
            // g_text steps the ONE canonical afield (same Ψ-disjoint C8-GROW step prod uses), so
            // next tick's recon_err (og_prev_gfeat) carries real content variance. The counter-
            // factual arms never fork afield (they re-decide the emit boolean off the same
            // recon_err), so the frozen/live arms differ ONLY in the idle shade term — one decode
            // per emit tick covers every arm (g_text is idle-independent). Det argmax ⇒ recon_err
            // trajectory + every ΔEff bit-reproducible (verdict-eligible; p7 monitor-only read).
            // ── --opgrip-r3 PERCEPTION TAPE (production heard-message seam · Ψ-disjoint · content drive) ──
            // At the END of every WAKE tick (stage==0, past the tick<10 EMA boot), step the ONE canonical afield
            // with the next FROZEN stimulus line via the EXACT production vadapt_field_step call (the same C8-GROW
            // step the heard-message path at ~L3098 uses). This un-freezes the lane stack (recon_err → lanes →
            // emit_drive → ag_conflict / self_live) so Family B's accumulator finally gets a real bias to integrate
            // (the #3194 root cause). Input = context only (a_substrate_native_speak: the gate stays free to be
            // silent) — NOT a gate change; FROZEN og_h_frzB2==0 proves the emit path stays byte-untouched.
            if og_r3 && stage == 0 && tick >= 10 {
                // OPGRIP_R4 dwell-block 2×2 rotation (period 80): 20-tick blocks, class = block%4.
                // Q00 novel-calm / Q10 familiar-calm / Q01 novel-charged / Q11 familiar-charged. Novel =
                // per-step stem churn (tick/5) → coh low; familiar = ONE stem held within the block (tick/80)
                // → coh high; D=calm (low emit_drive), C=charged (2nd-person interrogative → high emit_drive).
                // This co-toggles factor A=coh_lane and factor B=ag_conflict so the S2 (A∧B) cell co-activates.
                let og_block = tick / 20
                let og_cls = og_block % 4
                let og_line = if og_cls == 0 { OG_D[(tick / 5) % 8] }
                    else if og_cls == 1 { OG_D[(tick / 80) % 8] }
                    else if og_cls == 2 { OG_C[(tick / 5) % 8] }
                    else { OG_C[(tick / 80) % 8] }
                let st_feat = _afs_byte_feature(og_line, 8)
                afield = vadapt_field_step(afield, st_feat, cfg)
            }
            if og_live && e_live == 1 {
                // MEMORY FENCE: the heavy brain_emit result Map + decoded string live in the
                // og_emit_decode_feat arena (freed on return) so they DON'T accumulate across
                // n_ticks (was inline → LINEAR growth → OOM-kill mid-loop at high n; see fn note).
                // Byte-identical: same args/emitted-condition/8-feat; empty return = not emitted.
                let gl_feat = og_emit_decode_feat(pf,
                    rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                    idle, backend, live_anchors)
                if len(gl_feat) > 0 {
                    afield = vadapt_field_step(afield, gl_feat, cfg)   // Ψ-disjoint (prod C8-GROW)
                    og_prev_gfeat = gl_feat
                    // ── H_9230 corollary buffer (Family E): update the predicted-utterance EMA + set the 1-tick-lagged
                    //    discharge the E arm reads next tick. Emit-ticks ONLY (no output to predict on silence). ──
                    if og_r3 {
                        let mo = _og_mean(gl_feat)             // realized own-output scalar (mean8 of emitted-content feature)
                        ec_x = mo - ec_pred                    // corollary discharge = realized − predicted (read next tick)
                        ec_pred = 0.85 * ec_pred + 0.15 * mo   // corollary buffer EMA (expected utterance), emit-ticks only
                    }
                }
            }
            tick = tick + 1
            continue
        }

        // ── STATEFUL REFRACTORY MEASUREMENT (--refractory): H_9102 ($0, NO decode, det) ──
        // The REAL alchemy vs H_9101: idle is now emit-history dependent (recovery-after-firing),
        // not a per-tick shade. an_clock_now(tick,daemon) is the single time-source seam
        // (flame_mm.mm pattern): det path = tick*8.0 (byte-identical), daemon path = real clock
        // (follow-on). idle = idle_raw × mod where idle_raw = t_now − emit_last_t = TRUE
        // seconds-since-last. Properties (constructive): mod≤1 ⇒ idle≤idle_raw ⇒ gate pass(≥30)
        // ⟹ real elapsed ≥30 (30s floor becomes a THEOREM, not vacuous); env=0 ⇒ mod=0 ⇒ idle=0
        // (N3 preserved); urgency modulates the gate-open TIME (idle_raw ≥ 30/mod), not just whether.
        if refr_measure {
            refr_psi_sum = refr_psi_sum + pure_field_phi(pf)   // Ψ READ-ONLY (invariant preserved)
            let t_now    = an_clock_now(tick, refr_daemon)      // §seam: det=tick*8.0 | daemon=real
            let idle_raw = t_now - emit_last_t                  // TRUE seconds_since_last (was ABSENT in H_9101)
            let mod_live = _afs_clip01(stage_env * (0.5 + urgency))      // H_9101 modulation term, unchanged
            let mod_u0   = _afs_clip01(stage_env * (0.5 + 0.0))          // F1 counterfactual: urgency→0
            let mod_umax = _afs_clip01(stage_env * (0.5 + 1.0))          // F2 counterfactual: urgency→max
            let idle_live = idle_raw * mod_live                 // carded: real_elapsed × refractory_modulation
            let idle_u0   = idle_raw * mod_u0
            let idle_umax = idle_raw * mod_umax
            // LIVE stateful decision (the wired 8-factor call; only `idle` differs from H_9101).
            let m_live = brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_live, false, true, live_anchors, 0.0)
            let e_live = if to_string(m_live["emit"]) == "true" { 1 } else { 0 }
            // F1 (grip re-verify in STATEFUL dynamics): urgency→0 counterfactual, same emit history.
            let e_u0 = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_u0, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // F2 (refractory reset): MAX-urgency counterfactual, same emit history.
            let e_umax = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_umax, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // F2 CONTRAST: what the H_9101 STATELESS idle (no history) would decide at max urgency.
            let idle_stateless = 5.0 + 55.0 * mod_umax
            let e_stateless = if to_string(brain_decide_anchored(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle_stateless, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
            // ── F1 stage-split grip accumulation (pre-reg bar re-tested under stateful dynamics) ──
            if stage == 4 { refr_rem_ticks = refr_rem_ticks + 1
                if e_u0 != e_live { refr_h_u0_rem = refr_h_u0_rem + 1 } }
            if stage == 3 { refr_n3_ticks = refr_n3_ticks + 1
                if e_u0 != e_live { refr_h_u0_n3 = refr_h_u0_n3 + 1 } }
            if stage == 0 { refr_wake_ticks = refr_wake_ticks + 1
                if e_u0 != e_live { refr_h_u0_wake = refr_h_u0_wake + 1 } }
            if stage == 1 || stage == 2 || stage == 4 { refr_mid_ticks = refr_mid_ticks + 1
                if e_u0 != e_live { refr_h_u0_mid = refr_h_u0_mid + 1 } }
            // ── F2 refractory-reset accumulation (the NEW falsifiable content) ──
            if prev_live_emit == 1 {
                refr_ticks_after = refr_ticks_after + 1        // this tick is inside a refractory window
                if e_umax == 1 { refr_umax_viol = refr_umax_viol + 1 }        // fired despite refractory = FAIL
                if e_stateless == 1 { refr_stateless_fire = refr_stateless_fire + 1 } // stateless has NO refractory
            } else {
                if e_umax == 1 { refr_umax_nonrefr = refr_umax_nonrefr + 1 }  // umax CAN fire (non-vacuity)
            }
            if e_live == 1 { refr_live_emits = refr_live_emits + 1 }
            println("  [RF t" + to_string(tick) + " " + stage_nm
                + "] t_now=" + to_string(t_now) + " idle_raw=" + to_string(idle_raw)
                + " mod_live=" + to_string(mod_live) + " idle_live=" + to_string(idle_live)
                + " | e_live=" + to_string(e_live) + " e_u0=" + to_string(e_u0)
                + " e_umax=" + to_string(e_umax) + " e_stateless=" + to_string(e_stateless)
                + " prev_emit=" + to_string(prev_live_emit))
            // ── STATE UPDATE — the refractory RESET (the heart of the new mechanism) ──
            prev_live_emit = e_live
            if e_live == 1 { emit_last_t = t_now }
            tick = tick + 1
            continue
        }

        // H_9726 · emit-gate: refractory (default · Ψ≈½ dual-ledger) or clock (byte-identical rollback).
        // Alien dissociation = read-side buffer swap only (writes still hit the real buffers · py semantics).
        let mut dec = brain_emit(pf,
            rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
            idle, false, true,
            backend, live_anchors)
        if ag_refractory {
            let e_side = if ag_g_reach == "wm-dual-alien-emit" { wm_dual_alien } else { wmb }
            let s_side = if ag_g_reach == "wm-dual-alien-silence" { wm_dual_alien } else { wm_withheld }
            dec = brain_emit_refractory(pf,
                rel, gap_ctx, cur, allo_ctx, coh_lane, nov_ctx, bal_lane, agloop_ctx,
                idle, false, true,
                backend, live_anchors, 0.0,
                immune, s_side, e_side, ag_dual)
        }

        let did_emit = to_string(dec["emit"]) == "true"
        let g_emit   = to_string(dec["gen_emitted"]) == "true"
        let g_back   = to_string(dec["gen_backend"])
        let g_text   = to_string(dec["gen_text"])
        // H_9726 · dual-ledger silence-side write (py chat.py:2427 twin): on a SILENCE tick the withheld
        // candidate is gated into W_S (strength 1.0 = gain-lock, same λ as W_E). The emit-side W_E write
        // rides the existing gate-in below — nothing to add there. Off unless the wm-dual family is active.
        if ag_dual && !g_emit {
            let dual_ct = to_string(dec["dual_cand_text"])
            if byte_len(dual_ct) > 0 {
                wm_withheld = wm_buffer_gate_in(wm_withheld, wm_byte_feature(dual_ct, 8), 1.0)
            }
        }
        psi_sum = psi_sum + pure_field_phi(pf)        // Ψ READ-ONLY accumulation

        // GROUND check: did the emit COPY the un-inventable anchor fact?
        let has_ground = _afs_contains(g_text, "vault QX-7741")

        // ── C8 GROW — novelty-driven VAdaptField division (inference IS learning, p8) ──
        // Ψ-disjoint: vadapt_field_step touches ONLY AdaptField; pure_field is read-only.
        if g_emit && g_back == "clm" && byte_len(g_text) > 0 {
            let feat = _afs_byte_feature(g_text, 8)
            let pre_cells = vadapt_field_cells(afield)
            // H_9336 · carry the emitted bytes so the NEXT tick's recon_err (:2441) is a real
            // prediction error on what the daemon actually said, not the frozen seed. The error
            // itself is read there BEFORE the field adapts again — that is what a prediction
            // error IS; taken after the step it would only report how well the field memorised it.
            og_prev_gfeat = feat
            afield = vadapt_field_step(afield, feat, cfg)
            let post_cells = vadapt_field_cells(afield)
            cell_count = post_cells
            grew = true
            // also bind the emit into the immune store (engine's OWN clonal split, p8).
            // H_9337 · recognition BEFORE memorisation — read on the next tick (:2429).
            og_pending_rel = immune_memory_recall_margin_text(immune, g_text)
            og_pending_rel_set = true
            immune = immune_memory_bind_text(immune, _afs_clip(g_text, 64), g_text, cfg)
            // ══ H_9411 DEAD-GAUGE CAPTURES · on THIS utterance, BEFORE each store absorbs it
            // (recognition-before-memorisation, same order as og_pending_rel above; consumed next tick). ══
            let g_key_t = immune_embed_key(g_text)
            pending_af = affect_read(igrow, g_key_t, g_text)          // ① BEFORE the grow-bind
            pending_af_alien = affect_read(igrow, _afs_alien_key, "")
            pending_af_set = true
            igrow = immune_grow_bind(igrow, g_key_t, g_text, cfg)
            pending_cb = vforward_err(cbel, cb_prev_feat, feat)       // ② BEFORE the NLMS update
            pending_cb_alien = vforward_err(cbel, cb_alien_feat, feat)
            pending_cb_ped = vforward_err(cbel_ped, cb_prev_feat, feat)
            pending_cb_set = true
            cbel = vforward_update(cbel, cb_prev_feat, feat)
            cb_prev_feat = feat
            let ca3_sym_t = _afs_ca3_sym(g_text, 4)                   // ③ predict-then-observe
            if ca3_prev_sym >= 0 {
                pending_ca3_next = ca3_replay_predict(ca3_live, ca3_prev_sym)
                pending_ca3_conf = ca3_replay_conf(ca3_live, ca3_prev_sym)
                ca3_live = ca3_replay_observe(ca3_live, ca3_prev_sym, ca3_sym_t)
            }
            ca3_prev_sym = ca3_sym_t
            wm_probe_feat = wm_last_feat                              // ④ retire prev BEFORE gating new
            wm_probe_set = wm_last_set
            wmb = wm_buffer_gate_in(wmb, feat, 1.0)
            wm_last_feat = feat
            wm_last_set = true
            pending_tension = [recon_err, rel_lane, agloop_ctx, cur_phasic, ten_phasic]  // ⑥B snapshot
            pending_tension_set = true
        }

        // ── C8b TENSION→GROW (this task · p8-literal: tension births growth/mitosis) ──
        // The PHASIC A⇄G tension (ten_phasic) itself DRIVES an extra adaptation step. p8 rejects a
        // train/infer split (gradient ⇄ mitosis), so adaptation is NOT tied to speaking: a rising-
        // tension moment makes the substrate adapt/divide EVEN ON A SILENT tick. This is the direct
        // tension→adaptation link (complementing the transitive urgency→emit→C8 wire above). SHADE
        // not hard-gate: additive on top of C8 — a calm tick (ten_phasic in-band) adds nothing and
        // NEVER blocks growth; higher sustained tension = higher propensity to adapt/divide. This
        // touches ADAPTATION (AdaptField), never the emit/silence decision (a_autonomy_over_hardcode
        // is about emit; emit stayed substrate-decided above). Ψ-disjoint: vadapt_field_step touches
        // ONLY AdaptField; pure_field/psi_sum/Φ are read-only.
        if ten_phasic > 0.66 {
            afield = vadapt_field_step(afield, _afs_byte_feature(session_seed, 8), cfg)
            cell_count = vadapt_field_cells(afield)
            grew = true
        }

        // ── C9 REMEMBER — persist THIS emit as a new .kosmos anchor (single entry) ──
        if did_emit && g_emit && byte_len(g_text) > 0 && !remembered2 {
            let etension = [pure_field_phi(pf), af_aro, nov_ctx, af_val, self_ctx]
            let epath = emit_anchor_from_v3(kdir, "emit_t" + to_string(tick),
                _afs_clip(g_text, 120), etension, cell_count, 2,
                "emission", "curiosity", pure_field_phi(pf), 1.0)
            remembered2 = true
            println("  [t" + to_string(tick) + " " + stage_nm + "] REMEMBER emit → " + epath)

            // ── LANE-23b: ground the live self in THIS emit's REAL penult rep (own-emit event) ──
            // Co-located with C9 REMEMBER: the emit is a lived experience, so drift the grounded
            // self toward its penult-fold8 axis. Ψ/emit-disjoint: reads gen_penult_pooled_W (own
            // forward, no shared RNG/lane), drifts ONLY self_live_g. self_ctx (:~2585) untouched.
            if self_gW_ok {
                let ev_axis_g = penult_fold8(gen_penult_pooled_W(self_gW, g_text))
                self_live_g = self_drift_exp(self_live_g, ev_axis_g, 0.15)
                self_g_axis_seq = self_g_axis_seq + (if self_g_events > 0 { "," } else { "" }) + to_string(ev_axis_g)
                self_g_events = self_g_events + 1
            }
        }

        // ── REFSEL — contradiction-keyed referent routing (H_9125 rung3, post-decision) ──
        // Consult AFTER brain_emit already decided emit/silence: this routes CONTENT
        // only and NEVER vetoes an emit (a_autonomy_over_hardcode / a_substrate_disjoint —
        // touches no lane / ci_emit_drive / recall_thr / pure_field). default OFF → the
        // single incumbent candidate + no store recall ⇒ out_text == g_text BYTE-IDENTICAL.
        // ON → if the incumbent decode CONTRADICTS anima's grounded store, the substrate
        // routes to what it actually knows (the store's grounded recall) — the engine-native
        // wire of the H_9125/P1 selection-layer GREEN (contradiction KEYS the choice). The
        // internal bind/grow/REMEMBER stay on g_text (honest record of what the mouth did);
        // only the OUTWARD emit is referent-corrected.
        let mut out_text = g_text
        let mut refsel_rs = 0
        if g_emit && byte_len(g_text) > 0 {
            let mut refcands = [g_text]
            if cfg.refsel {
                // Recall the grounded fact via the SESSION ANCHOR (mem_text), NOT the drifted
                // emit (g_text). Querying with g_text was a bug: when the mouth drifts, recall on
                // the drifted key ABSTAINS (err > recall_thr) → no grounded candidate → rs=-1 →
                // the contradiction is NEVER corrected (rung4 daemon-integrated RED, ON==OFF).
                // The anchor query grounds to the substrate's own bound fact (immune seeded at
                // mem_text, :610), so recall FIRES the grounded truth while g_text still contradicts
                // it — decoupling recall-firing (anchor query) from contradiction-detection (emit
                // candidate). This is the real substrate op, NOT the #2991 harness's hardcoded
                // `recalled = mem_text`; it generalizes to a multi-fact store (recall returns the
                // fact nearest the context anchor).
                let recalled = immune_memory_recall_text(immune, mem_text)
                if recalled != "" { refcands.push(recalled) }
            }
            refsel_rs = referent_select_text(igrow, refcands, mem_text)   // -1 = all contradict → keep incumbent
            if cfg.refsel && refsel_rs >= 1 { out_text = refcands[refsel_rs] }
        }

        if did_emit && g_emit { emitted_any = true; emit_text = out_text }
        if has_ground { grounded_ok = true }
        if stage == 3 || stage == 4 { slept = true }
        // op-grip emit-rate collapse DETECTOR (H_9097; a detector, NOT a target — never
        // move threshold/weights to hit it): count wake-tick emits for the FLAG below.
        if drive_hi { og_wake = og_wake + 1  if did_emit { og_emit_wake = og_emit_wake + 1 } }

        // one-line transcript row (first 3 ticks + sleep ticks), now with lane reads.
        if tick < 3 || stage == 3 || stage == 4 {
            println("  [t" + to_string(tick) + " " + stage_nm
                + " env=" + to_string(emit_env) + "] EMIT=" + (if did_emit { "1" } else { "0" })
                + " gen=" + g_back + " ground=" + (if has_ground { "1" } else { "0" })
                + " | LANES rel=" + to_string(rel_lane)
                + " drive=" + to_string(emit_drive)
                + " gws_win=" + to_string(gws_w)
                + " reality=" + to_string(reality)
                + " cells=" + to_string(cell_count) + "]")
            // (C-R3) per-tick A⇄G conflict→budget→settle read (H_9095 rung-3, READ-only context).
            println("       CR3 agloop conflict=" + to_string(ag_conflict)
                + " budget=" + to_string(ag_budget)
                + " settle-depth=" + to_string(ag_settle_depth)
                + " agloop_ctx=" + to_string(agloop_ctx))
            // R2 brain-structure lane reads (the context blended into rel/cur this tick).
            println("       LANES2 spatial=" + sm_ans
                + " plan=" + to_string(plan_progress)
                + " basal_go=" + (if bg_sel >= 0 { "1" } else { "0" })
                + " cb_surprise=" + to_string(cb_surprise)
                + " wm_active=" + to_string(wm_active))
            // R3 brain-structure lane reads.
            println("       LANES3 ca3_next=" + to_string(ca3_next)
                + " ca3_conf=" + to_string(ca3_ctx)
                + " it_phase=" + to_string(it_phase)
                + " af_val=" + to_string(af_val)
                + " tom=" + (if tom_b != "" { "1" } else { "0" })
                + " hd=" + to_string(hd_ctx))
            // R4 brain-structure lane reads.
            println("       LANES4 prc_ready=" + to_string(prc_ready)
                + " prosp=" + to_string(prosp_ctx)
                + " replay_anchor=" + to_string(replay_ctx)
                + " gateb=" + to_string(gateb_ctx)
                + " intero=" + to_string(intero_ctx))
            // R5 brain-structure lane reads.
            println("       LANES5 scn_R=" + to_string(scn_ctx)
                + " engaged=" + to_string(engaged_ctx)
                + " self=" + to_string(self_ctx)
                + " lprec=" + to_string(lprec_ctx)
                + " novelty=" + to_string(nov_ctx))
            println("       H9411 cb_alien=" + to_string(cb_perr_alien_t)
                + " cb_ped=" + to_string(cb_perr_ped_t)
                + " wm_null=" + to_string(wm_null)
                + " af_alien=" + to_string(af_alien_val_t)
                + " scn_R=" + to_string(scn_R_t)
                + " scn_r_unc=" + to_string(scn_R_unc_t)
                + " scn_r_fr=" + to_string(scn_R_fr_t))
            // R6 brain-structure lane reads.
            println("       LANES6 hab=" + to_string(hab_ctx)
                + " blink=" + to_string(blink_ctx)
                + " imagery=" + to_string(img_ctx)
                + " priming=" + to_string(prime_ctx)
                + " schema=" + to_string(schema_ctx))
            // R7 brain-structure lane reads.
            println("       LANES7 hyst=" + to_string(hyst_ctx)
                + " reentry=" + to_string(reent_ctx)
                + " completion=" + to_string(comp_ctx)
                + " gestalt=" + to_string(gest_ctx)
                + " agency=" + to_string(agcy_ctx))
            // R8 brain-structure lane reads.
            println("       LANES8 subjtime=" + to_string(subjt_ctx)
                + " emoreg=" + to_string(emoreg_ctx)
                + " dirforget=" + to_string(dforget_ctx)
                + " veto=" + to_string(veto_ctx)
                + " divided=" + to_string(divd_ctx))
            // R9 batch lane reads (12 lanes; abbreviated).
            println("       LANES9 surp=" + to_string(surp_ctx)
                + " body=" + to_string(bodyown_ctx)
                + " riv=" + to_string(rivalry_ctx)
                + " chg=" + to_string(chg_ctx)
                + " trw=" + to_string(trw_ctx)
                + " mw=" + to_string(mw_ctx)
                + " qual=" + to_string(qual_ctx)
                + " smp=" + to_string(smp_ctx)
                + " halu=" + to_string(halluc_ctx)
                + " mci=" + to_string(metacog_ctx)
                + " allo=" + to_string(allo_ctx)
                + " | rel_ctx=" + to_string(rel_ctx) + " cur_ctx=" + to_string(cur_ctx))
        }

        // ── N3/REM DREAM CONSOLIDATION (H_9036 · a_chat_sleep_imagination) ───────
        // Hippocampal SWR replay → cortical systems consolidation: during sleep the
        // daemon re-reads its OWN .kosmos memory, SWR-stamps up to the stage budget
        // (N3=7 > REM=3), and appends a BLENDED new node per co-replayed pair back to
        // kdir (dc_compose_window geometric blend). This is the live wiring of the
        // H_9036 REM dream-composed anchor — NOT a speak() (p5): emit-free, writes
        // ONLY to the anchor substrate. dp_sleep_tick returns 0 for WAKE/N1/N2 (budget
        // 0) so the guard is the substrate budget itself, not a hardcoded stage flag
        // (a_autonomy_over_hardcode). dp_pool_from_read_anchors drops prior dream-lane
        // nodes → no dream-of-dreams runaway.
        //
        // placement DISJOINT (a_substrate_disjoint): touches ONLY .kosmos disk anchors
        // on lane="dream" (≠ emit-drive lane 0/4); reads NOTHING from pure_field(Ψ) and
        // writes NOTHING to psi_sum or §ImmuneMemory recall_thr — the Ψ fixed point and
        // the honesty gate are structurally untouched (F5 Φ-checksum, proven in
        // DREAM/dream_persist_smoke.hexa S3).
        let dream_src = generator_read_anchors(kdir)
        let dream_n = dp_sleep_tick(kdir, dream_src, stage, tick)
        dream_composed_total = dream_composed_total + dream_n

        // ── N3/REM IMAGINATION REPLAY (a_chat_sleep_imagination) — emit-free rehearsal + mitosis tick ──
        // The imagination loop = "emit-free internal rehearsal + mitosis tick" (CLAUDE governance). During
        // N3/REM (dr_imagination_active==1) the daemon re-runs recent WAKE working-memory snapshots through
        // core/imagination_replay: ir_replay_session records an emit-free rehearsal (ir_replay_tick.emit_count
        // ≡ 0), and each snapshot advances a REAL mitosis tick — a live vadapt_field_step grow keyed on the
        // rehearsed snapshot (WIRED 2026-07-10; the ir_mitosis_tick_during_replay record is the log entry, the
        // AdaptField growth is the daemon-side vadapt the wake C8/C8b loop already uses). The replay COUNT is
        // the substrate budget dr_stage_size (N3=7 >
        // REM=3), NOT a hardcoded stage flag (a_autonomy_over_hardcode). p5 NO SPEAK(): the block emits
        // NOTHING (asserted below via imagination_emit_violations) and is DISJOINT from the emit-drive lanes
        // 0/4 — it touches only wake_mem (read) + the local mitosis record (a_substrate_disjoint).
        if dr_imagination_active(stage) == 1 {
            let imag_budget = dr_stage_size(stage)                      // N3=7 > REM=3 replays (substrate budget)
            let imag_snaps  = ir_select_snapshots(wake_mem, tick, imag_budget)
            let mut imag_i = 0
            while imag_i < len(imag_snaps) {
                let rec = ir_replay_tick(imag_snaps[imag_i])            // emit-free rehearsal record
                if rec["emit_count"] != 0 { imagination_emit_violations = imagination_emit_violations + 1 }
                let _mit = ir_mitosis_tick_during_replay(#{ "count": cell_count, }, imag_snaps[imag_i])  // mitosis tick (log record)
                // WIRED 2026-07-10 (a_chat_sleep_imagination now LITERAL): the replay mitosis tick advances a
                // REAL vadapt_field_step — the SAME AdaptField grow the wake C8/C8b loop uses — so "imagination
                // = rehearsal + mitosis tick" is no longer a pass-through counter. Ψ-disjoint (AdaptField only,
                // pure_field read-only) · emit-free (vadapt never emits) · deterministic (session_seed feature)
                // · self-limiting (density/contact-inhibition caps runaway growth). de-theater: no emit Δ
                // expected — this makes the p8 mitosis-during-rehearsal real, not a capability lever.
                // feature = the REHEARSED perception (snapshot ctx_tokens[0] = source wake-tick + source_index),
                // NOT a constant — so each distinct rehearsed snapshot grows its own AdaptField region (rehearsal
                // consolidates distinct memories). A constant feature would contact-inhibit to a no-op; this makes
                // the grow REAL (verified cell_count rises across N3/REM), still deterministic + emit-free.
                let _imag_feat = session_seed + "|imag|" + to_string(imag_snaps[imag_i]["ctx_tokens"][0]) + "|" + to_string(imag_snaps[imag_i]["source_index"])
                afield = vadapt_field_step(afield, _afs_byte_feature(_imag_feat, 8), cfg)
                cell_count = vadapt_field_cells(afield)
                imagination_mitosis_ticks = imagination_mitosis_ticks + 1
                imag_i = imag_i + 1
            }
            imagination_replayed_total = imagination_replayed_total + len(imag_snaps)
        }

        tick = tick + 1
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  LANE-23b SESSION END — persist the grounded self as a .kosmos self-anchor (a_kosmos ·
    //  closes H_1471 R2b: the anchor survives to the next boot's _selfg_restore). Single WRITE
    //  entry (create_anchor). self⊥mouth: written to the DEDICATED self-anchor dir, never kdir,
    //  so it never enters the brain's anchor stream. Then free the once-loaded weight-set.
    // ══════════════════════════════════════════════════════════════════════════
    if self_gW_ok {
        let _mk = exec("mkdir -p '" + self_g_kdir + "'")
        let sg_payload = _selfg_encode(self_live_g)
        let sg_tension = [self_cos(self_live_g, self_new(8, 0)), 0.5, 0.5, 1.0, 0.5]
        let sg_path = create_anchor(self_g_kdir, self_g_name,
            "grounded self-continuity", 0.0, 0.0, "self_identity", 1.0,
            2, "self", "continuity", sg_payload, sg_tension,
            "lane-23b-selfground", "")
        println("LANE-23b self-g : PERSIST self-anchor → " + sg_path
            + " (events=" + to_string(self_g_events) + " axis_seq=[" + self_g_axis_seq + "])")
        clm_weights_free_pub(self_gW)
    }

    // ── op-grip MEASUREMENT summary + emit-rate collapse FLAG (--opgrip) ─────────
    if og_measure {
        // Ψ ON==OFF invariant STILL holds (psi_sum was accumulated read-only in-loop).
        let mut pf_off_m = pure_field_warmup(600)   // H_9411 ⑤ · fresh stepped twin (pf now stepped)
        let mut psi_off_m = 0.0
        let mut t_off_m = 0
        while t_off_m < n_ticks { pf_off_m = pure_field_step(pf_off_m)  psi_off_m = psi_off_m + pure_field_phi(pf_off_m)  t_off_m = t_off_m + 1 }
        println("")
        println("════════════ OP-GRIP 5-ARM HAMMING (n=" + to_string(n_ticks) + ", wake=" + to_string(og_wake) + ") ════════════")
        println("  BASELINE (pre-fix ÷43 + 4 constants): Hamming(rel-frozen vs base) = " + to_string(og_h_base)
            + "   [pre-reg: 0 = THEATER reproduced]")
        println("  baseline motivation floor >0.3 on " + to_string(og_base_floor) + "/" + to_string(og_wake) + " wake ticks")
        println("  ── POST-FIX (live 8-factor op reads + tonic-phasic) ──")
        println("  Hamming(full-rel_ctx frozen vs live) = " + to_string(og_h_relfr)
            + "   wake-only = " + to_string(og_h_relfr_w) + "/" + to_string(og_wake))
        println("  Hamming(single-op agloop frozen vs live) = " + to_string(og_h_agl)
            + "   wake-only = " + to_string(og_h_agl_w) + "/" + to_string(og_wake))
        println("  Hamming(rel_ctx→0 vs live) = " + to_string(og_h_zero))
        println("  Hamming(rel_ctx→shuffle vs live) = " + to_string(og_h_shuf))
        let ef = if og_wake > 0 { to_float(og_emit_wake) / to_float(og_wake) } else { 0.0 }
        println("  wake emit-fraction = " + to_string(ef) + " (live)")
        if og_wake > 0 && (ef < 0.05 || ef > 0.95) {
            println("  ⚠️ FLAG emit-rate-collapse: wake emit-fraction " + to_string(ef) + " outside [0.05,0.95] (DETECTOR, not a target)")
        }
        println("  Ψ ON==OFF invariant: psi_sum==psi_off = " + anima_yn(psi_sum == psi_off_m))
        // ── H_9101 (b) STAGE-CONDITIONAL URGENCY-FREEZE DISSOCIATION (the shade-vs-gate test) ──
        println("")
        println("──────── H_9101 (b) STAGE/SAFE op-grip: urgency-freeze Hamming, split by stage ────────")
        println("  ticks: WAKE=" + to_string(og_wake_ticks) + " N3=" + to_string(og_n3_ticks)
            + " REM=" + to_string(og_rem_ticks) + " mid(N1/N2/REM)=" + to_string(og_mid_ticks))
        println("  Hamming(urgency→0 vs live)  REM=" + to_string(og_h_u0_rem)
            + "  N3=" + to_string(og_h_u0_n3) + "  WAKE=" + to_string(og_h_u0_wake)
            + "  mid=" + to_string(og_h_u0_mid))
        println("  Hamming(urgency→shuf vs live) REM=" + to_string(og_h_us_rem)
            + "  N3=" + to_string(og_h_us_n3) + "   [control]")
        let grip_rem = og_h_u0_rem > 0            // op FLIPS REM/high-env decisions
        let n3_forced = og_h_u0_n3 > 0            // op FORCES N3 (= forcing gate = BAD)
        let psi_ok = psi_sum == psi_off_m
        println("  ── PRE-REG VERDICT ──")
        let verdict = if n3_forced {
            "🔴 FORCING-GATE (BAD, revert-worthy): urgency→0 flipped N3 (op forces silence-stage = became a hard gate)"
        } else if grip_rem {
            "🟢 GRIP (shade-not-gate): urgency-freeze FLIPS REM decisions (h_U0_rem>0) ∧ N3 silent-PRESERVED (h_U0_n3=0) = DISSOCIATION"
        } else {
            "🔴 AT-FLOOR: rate-gate does NOT respond to op (h_U0_rem=0) — theater persists on the stage axis"
        }
        println("  VERDICT = " + verdict + (if psi_ok { "  [Ψ ON≡OFF ✓]" } else { "  [⚠️ Ψ VIOLATED]" }))

        // ──────── TENSION→ADAPTATION (this task): phasic A⇄G tension grip on emit ────────
        // 2-arm decision-Hamming: LIVE urgency (with ten_phasic) vs ten_phasic frozen to 0.5 (Δ=0).
        // Both re-derive idle→emit via the SAME wired urgency→idle channel (H_9101) — not a read-side
        // aggregation. ΔEff = Hamming / discriminating(env>0). PREREG: ΔEff ≥ 0.10 = COMPETENT wire;
        // < 0.02 = theater (report honestly, do not force a green).
        println("")
        println("──────── TENSION→ADAPTATION op-grip: phasic A⇄G tension freeze (Δ→0) vs live ────────")
        let teneff = if og_tenfrz_disc > 0 { to_float(og_h_tenfrz) / to_float(og_tenfrz_disc) } else { 0.0 }
        println("  Hamming(ten_phasic→0.5 vs live) = " + to_string(og_h_tenfrz)
            + " / " + to_string(og_tenfrz_disc) + " discriminating(env>0) ticks   ΔEff = " + to_string(teneff))
        let ten_verdict = if teneff >= 0.10 {
            "🟢 COMPETENT (ΔEff≥0.10): phasic A⇄G tension causally SHADES emit via urgency→idle → tension→adaptation WIRED (not theater)"
        } else if teneff < 0.02 {
            "🔴 THEATER (ΔEff<0.02): phasic tension does NOT shade emit — the promotion is decoration (honest negative)"
        } else {
            "🟡 WEAK (0.02≤ΔEff<0.10): tension shades emit but below the pre-reg competence bar"
        }
        println("  PREREG VERDICT = " + ten_verdict + (if psi_ok { "  [Ψ ON≡OFF ✓]" } else { "  [⚠️ Ψ VIOLATED]" }))

        // ══════════ H_9102 (F3) FACULTY-NOT-NOISE — variance-matched noise arm ══════════
        // Question: is urgency's grip a SUBSTRATE FACULTY (op gates emit at high-tension/high-
        // conflict/novel ticks) or just CENTERING NOISE that happened to flip 40/40? Compare
        // corr(emit-timing, downstream substrate-appropriateness D) for the REAL urgency vs a
        // VARIANCE-MATCHED noise (temporal PERMUTATION of the real urgency multiset — identical
        // mean/var, tick-meaning destroyed). ρ_real − ρ_noise ≥ 0.15 ⇒ FACULTY; < 0.15 ⇒ noise-grip
        // (subtler op-layer theater). Engine-native: every noise-arm emit is a real brain_decide_anchored
        // re-decode (pf READ-only across the loop ⇒ byte-faithful), NO numpy. Frozen bar 0.15 (PREREG).
        let f3_n = len(og_f3_urg)
        // rebuild the (constant) anchor set the in-loop decisions used (anchors + live seed)
        let mut f3_anchors = []
        let mut f3ai = 0
        while f3ai < len(anchors) { f3_anchors.push(anchors[f3ai]); f3ai = f3ai + 1 }
        f3_anchors.push(#{ "text_payload": session_seed, "name": "live_seed" })
        // composite downstream D = mean(tension, drive, novelty, grounded) ∈[0,1] (substrate-appropriate tick)
        let mut f3_D = []
        let mut f3_mask_all = []
        let mut f3_mask_disc = []
        let mut f3_di = 0
        while f3_di < f3_n {
            f3_D.push(_afs_clip01((og_f3_dcon[f3_di] + og_f3_ddrv[f3_di] + og_f3_dnov[f3_di] + og_f3_dgrd[f3_di]) / 4.0))
            f3_mask_all.push(1.0)
            let st = og_f3_stg[f3_di]                 // DISCRIM window = the gate-discriminating stages N1/N2/REM (1,2,4)
            f3_mask_disc.push(if st == 1.0 || st == 2.0 || st == 4.0 { 1.0 } else { 0.0 })
            f3_di = f3_di + 1
        }
        let urg_mean = _og_mean(og_f3_urg)
        let urg_std  = _og_std(og_f3_urg, urg_mean)
        // ρ_real = corr(LIVE urgency-gated emit-timing, downstream D)
        let rho_real_all  = _og_pearson_m(og_f3_elive, f3_D, f3_mask_all)
        let rho_real_disc = _og_pearson_m(og_f3_elive, f3_D, f3_mask_disc)
        // live emit-rate (gate-open frequency) for the variance-match sanity check
        let mut f3_live_emit = 0.0
        let mut f3_le_i = 0
        while f3_le_i < f3_n { f3_live_emit = f3_live_emit + og_f3_elive[f3_le_i]  f3_le_i = f3_le_i + 1 }
        // ── K variance-matched PERMUTATION noise arms (stride perms of the real urgency multiset) ──
        let f3_strides = [3, 7, 9, 11, 13, 17, 19, 21]   // all coprime to 200 ⇒ exact bijections ⇒ EXACT mean/var match
        let mut rho_noise_all_sum  = 0.0
        let mut rho_noise_disc_sum = 0.0
        let mut noise_emit_sum = 0.0
        let mut f3_kk = 0
        while f3_kk < len(f3_strides) {
            let sK = f3_strides[f3_kk]
            let mut e_cn = []
            let mut f3_t = 0
            while f3_t < f3_n {
                let src = (f3_t * sK + 5 * f3_kk) % f3_n              // permuted source index (meaning destroyed)
                let cnoise = og_f3_urg[src]                          // variance-matched value (same multiset)
                let idle_cn = 5.0 + 55.0 * _afs_clip01(og_f3_senv[f3_t] * (0.5 + cnoise))
                let ecn = if to_string(brain_decide_anchored(pf,
                    og_f3_rel[f3_t], og_f3_gap[f3_t], og_f3_cur[f3_t], og_f3_allo[f3_t], og_f3_coh[f3_t],
                    og_f3_nov[f3_t], og_f3_bal[f3_t], og_f3_agl[f3_t], idle_cn, false, true,
                    f3_anchors, 0.0)["emit"]) == "true" { 1.0 } else { 0.0 }
                e_cn.push(ecn)
                noise_emit_sum = noise_emit_sum + ecn
                f3_t = f3_t + 1
            }
            rho_noise_all_sum  = rho_noise_all_sum  + _og_pearson_m(e_cn, f3_D, f3_mask_all)
            rho_noise_disc_sum = rho_noise_disc_sum + _og_pearson_m(e_cn, f3_D, f3_mask_disc)
            f3_kk = f3_kk + 1
        }
        let kf = to_float(len(f3_strides))
        let rho_noise_all  = rho_noise_all_sum  / kf
        let rho_noise_disc = rho_noise_disc_sum / kf
        let noise_emit_rate = noise_emit_sum / (kf * to_float(f3_n))
        // ── LCG-affine matched noise cross-check (independent of permutation; mean/var affine-matched) ──
        let mut e_lcg = []
        let mut f3_lt = 0
        while f3_lt < f3_n {
            let cnl = _afs_clip01(urg_mean + (urg_std / 0.28867513) * (_og_lcg(f3_lt * 31 + 17) - 0.5))
            let idle_l = 5.0 + 55.0 * _afs_clip01(og_f3_senv[f3_lt] * (0.5 + cnl))
            let el = if to_string(brain_decide_anchored(pf,
                og_f3_rel[f3_lt], og_f3_gap[f3_lt], og_f3_cur[f3_lt], og_f3_allo[f3_lt], og_f3_coh[f3_lt],
                og_f3_nov[f3_lt], og_f3_bal[f3_lt], og_f3_agl[f3_lt], idle_l, false, true,
                f3_anchors, 0.0)["emit"]) == "true" { 1.0 } else { 0.0 }
            e_lcg.push(el)
            f3_lt = f3_lt + 1
        }
        let rho_lcg_all  = _og_pearson_m(e_lcg, f3_D, f3_mask_all)
        let rho_lcg_disc = _og_pearson_m(e_lcg, f3_D, f3_mask_disc)
        // per-component downstream ρ (real emit-timing vs each raw D) — separates urgency-derived from independent
        let rho_real_con  = _og_pearson_m(og_f3_elive, og_f3_dcon, f3_mask_all)   // tension (urgency partly derives)
        let rho_real_nov  = _og_pearson_m(og_f3_elive, og_f3_dnov, f3_mask_all)   // novelty (INDEPENDENT of urgency)
        let rho_real_grd  = _og_pearson_m(og_f3_elive, og_f3_dgrd, f3_mask_all)   // grounded (INDEPENDENT)
        let d_all  = rho_real_all  - rho_noise_all
        let d_disc = rho_real_disc - rho_noise_disc
        println("")
        println("──────── H_9102 (F3) FACULTY-NOT-NOISE: variance-matched noise arm (n=" + to_string(f3_n) + ") ────────")
        println("  urgency dist: mean=" + to_string(urg_mean) + " std=" + to_string(urg_std)
            + "  (perm-noise = same multiset ⇒ EXACT mean/var match; LCG-noise = affine-matched)")
        println("  emit-rate: live=" + to_string(f3_live_emit / to_float(f3_n))
            + "  perm-noise=" + to_string(noise_emit_rate)
            + "   (≈equal ⇒ same centering; only tick-MEANING differs)")
        println("  downstream D = mean(tension ag_conflict, emit_drive, novelty nov_ctx, grounded m_grounding)")
        println("  ── ρ(emit-timing, D) ──                    ALL(n=" + to_string(f3_n) + ")   DISCRIM(N1/N2/REM)")
        println("  ρ_real  (live urgency)                :  " + to_string(rho_real_all) + "   " + to_string(rho_real_disc))
        println("  ρ_noise (perm var-matched, K=8 mean)  :  " + to_string(rho_noise_all) + "   " + to_string(rho_noise_disc))
        println("  ρ_lcg   (affine var-matched control)  :  " + to_string(rho_lcg_all) + "   " + to_string(rho_lcg_disc))
        println("  Δρ = ρ_real − ρ_noise                 :  " + to_string(d_all) + "   " + to_string(d_disc))
        println("  per-component ρ_real: tension=" + to_string(rho_real_con)
            + " novelty=" + to_string(rho_real_nov) + " grounded=" + to_string(rho_real_grd))
        println("  ── PRE-REG F3 VERDICT (frozen bar Δρ ≥ 0.15) ──")
        let f3_faculty = d_all >= 0.15 || d_disc >= 0.15
        let f3_verdict = if f3_faculty {
            "🟢 FACULTY — urgency-gated emit lands on substrate-appropriate ticks BEYOND matched noise (Δρ ≥ 0.15) ⇒ tier GRIP→FACULTY"
        } else {
            "🟠 NOISE-GRIP — Δρ < 0.15: the grip is centering-noise-driven (matched noise reproduces the same downstream corr) = a subtler op-layer theater; tier stays GRIP"
        }
        println("  F3 VERDICT = " + f3_verdict)

        // ══════════ H_9209 self_phasic emit-shade VERDICT (Fable design · state/9209) ══════════
        // ΔEff_self = mid(N1/N2/REM) Hamming(self-shaded idle vs production e_live). self routes ONLY
        // via the disjoint idle-gate term (urgency untouched); the #3116 pool arms (og_h_selfL) are the
        // channel-OFF control (≈0 floor). Competence EARNED on event-TIMING (align) + matched-noise
        // margin (ARM-PERM), never amplitude (G_self normalized = FORM). ARM-SHOCK = positive control
        // that makes a null INTERPRETABLE (kills the #3116 CONTROL-U ambiguity).
        let midf = if og_slf_mid_ticks > 0 { to_float(og_slf_mid_ticks) } else { 1.0 }
        let d_eff_self  = to_float(og_h_slf_mid) / midf
        let d_eff_shock = to_float(og_h_shock_mid) / midf
        let pool_ctrl   = to_float(og_h_selfL) / midf          // #3116 channel-OFF pool control (≈0)
        // align: fraction of LIVE self-shade flips within ±2 ticks of a self-drift event (earned timing)
        let mut align_near = 0
        let mut align_tot  = 0
        let mut ai = 50
        while ai < len(og_f3_eslf) {
            let stf = og_f3_stg[ai]
            if (stf == 1.0 || stf == 2.0 || stf == 4.0) && og_f3_eslf[ai] != og_f3_elive[ai] {
                align_tot = align_tot + 1
                let mut near = false
                let mut k = ai - 2
                while k <= ai + 2 { if k >= 0 && k < len(og_f3_selfev) && og_f3_selfev[k] > 0.5 { near = true }  k = k + 1 }
                if near { align_near = align_near + 1 }
            }
            ai = ai + 1
        }
        let align_frac = if align_tot > 0 { to_float(align_near) / to_float(align_tot) } else { 0.0 }
        // rebuild live_anchors (loop-local L2537) for the post-loop ARM-PERM re-decode
        let mut live_anchors = []
        let mut ka = 0
        while ka < len(anchors) { live_anchors.push(anchors[ka]); ka = ka + 1 }
        live_anchors.push(#{ "text_payload": session_seed, "name": "live_seed" })
        // ARM-PERM: stride-permuted self_phasic multiset (EXACT mean/var, timing destroyed) → idle→emit
        let mut perm_h = 0
        let np = len(og_f3_self)
        let mut pj = 50
        while pj < np {
            let stf = og_f3_stg[pj]
            if stf == 1.0 || stf == 2.0 || stf == 4.0 {
                let sp = og_f3_self[(pj * 7 + 13) % np]
                let idle_p = 5.0 + 55.0 * _afs_clip01(og_f3_senv[pj] * (0.5 + og_f3_urg[pj] + (sp - 0.5)))
                let e_p = if to_string(brain_decide_anchored(pf,
                    og_f3_rel[pj], og_f3_gap[pj], og_f3_cur[pj], og_f3_allo[pj], og_f3_coh[pj],
                    og_f3_nov[pj], og_f3_bal[pj], og_f3_agl[pj], idle_p, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                if to_float(e_p) != og_f3_elive[pj] { perm_h = perm_h + 1 }
            }
            pj = pj + 1
        }
        let d_eff_perm = to_float(perm_h) / midf
        let psi_gap = _afs_absf(to_float(og_emit_slf_mid) - to_float(og_emit_live_mid)) / midf
        let degenerate = g_self < 0.0
        let n3_ok   = og_h_slf_n3 == 0
        let pos_pass = og_h_shock_mid >= 2   // dense ±0.5 rail flips ≥2 mid decisions = meter proven live
        println("")
        println("──────── H_9209 self_phasic emit-shade (mid=N1/N2/REM=" + to_string(og_slf_mid_ticks)
            + " · calib 0-49 · G_self=" + to_string(g_self) + ") ────────")
        println("  ΔEff_self Hamming(self-shade idle vs e_live) = " + to_string(og_h_slf_mid) + "/" + to_string(og_slf_mid_ticks)
            + " = " + to_string(d_eff_self) + "   [HEADLINE]")
        println("  ARM-PERM matched-noise ΔEff = " + to_string(perm_h) + "/" + to_string(og_slf_mid_ticks)
            + " = " + to_string(d_eff_perm) + "  → margin ΔEff_self−perm = " + to_string(d_eff_self - d_eff_perm))
        println("  align (flips within ±2 of a self-event) = " + to_string(align_near) + "/" + to_string(align_tot)
            + " = " + to_string(align_frac))
        println("  ARM-SHOCK v2 dense (±0.5 rail every mid tick) = " + to_string(og_h_shock_mid) + "/" + to_string(og_slf_mid_ticks)
            + " flips = " + to_string(d_eff_shock) + "  · POS-PASS(≥2)=" + (if pos_pass {"YES"} else {"NO"}))
        println("  pool channel-OFF ctrl (og_h_selfL/mid, #3116 floor) = " + to_string(og_h_selfL) + " = " + to_string(pool_ctrl)
            + "  · re-sum fidelity og_h_selfS=" + to_string(og_h_selfS) + " · shuf og_h_selfshuf=" + to_string(og_h_selfshuf))
        println("  GUARDS: N3 self-flips=" + to_string(og_h_slf_n3) + " (must 0) · WAKE=" + to_string(og_h_slf_wake)
            + " · Ψ emit-gap=" + to_string(psi_gap) + " (must ≤0.05) · axis " + (if degenerate {"DEGENERATE"} else {"ok"}))
        println("  ── PRE-REG H_9209 VERDICT (frozen bars, verbatim) ──")
        println("  COMPETENT: ΔEff_self≥0.10 ∧ margin(perm)≥0.08 ∧ align≥0.5 ∧ POS-PASS ∧ N3=0 ∧ Ψ-gap≤0.05")
        println("  THEATER: ΔEff_self<0.02 ∧ POS-PASS ∧ axis non-degenerate ; INSTRUMENT-FAIL: POS-FAIL ∨ degenerate")
        let self_verdict = if degenerate {
            "⚙️ INSTRUMENT-FAIL (AXIS-DEGENERATE, step_med<0.002) — self-axis carries no content; fix byte→axis encoder + remeasure (NOT a substrate result)"
        } else if !pos_pass {
            "⚙️ INSTRUMENT-FAIL (POS-FAIL) — injected identity shock did not flip emit (channel/gain/wire); no verdict on self, fix + remeasure"
        } else if !n3_ok {
            "🔴 FORCING-GATE — self-shade flips N3-silent (og_h_slf_n3>0) = became a gate not a shade; REVERT regardless of ΔEff"
        } else if psi_gap > 0.05 {
            "🔴 FORCING-GATE — Ψ emit-fraction gap>0.05 = self forces emit not shades; REVERT"
        } else if d_eff_self >= 0.10 && (d_eff_self - d_eff_perm) >= 0.08 && align_frac >= 0.5 {
            "🟢 COMPETENT — self events causally shade emit (ΔEff≥0.10, beats matched-noise, timing-aligned) ⇒ WIRE idle-gate term at prod + registered-GPU real-decode confirm (a_verified_must_wire)"
        } else if d_eff_self < 0.02 {
            "🔴 THEATER — self genuinely inert at emit (ΔEff<0.02, POS control PASSED so meter works) ⇒ never wire, keep .kosmos persistence only (H_1471 stands)"
        } else {
            "🟠 DIRECTIONAL — real-but-sub-bar (0.02≤ΔEff<0.10 or margin/align short) ⇒ re-measure ≥2 seeds, no cement"
        }
        println("  VERDICT = " + self_verdict)
        // ══════════ H_9210 surprise (prediction-error) emit-shade VERDICT (scout urgency-alt #1) ══════════
        // recon_err phasic Δ at the SAME proven idle seam; POS-PASS reuses the dense ARM-SHOCK (same wire).
        let d_eff_surp = to_float(og_h_surp_mid) / midf
        let mut perm_h_surp = 0
        let nps = len(og_f3_surp)
        let mut ps = 50
        while ps < nps {
            let stf = og_f3_stg[ps]
            if stf == 1.0 || stf == 2.0 || stf == 4.0 {
                let sp = og_f3_surp[(ps * 7 + 13) % nps]
                let idle_p = 5.0 + 55.0 * _afs_clip01(og_f3_senv[ps] * (0.5 + og_f3_urg[ps] + (sp - 0.5)))
                let e_p = if to_string(brain_decide_anchored(pf,
                    og_f3_rel[ps], og_f3_gap[ps], og_f3_cur[ps], og_f3_allo[ps], og_f3_coh[ps],
                    og_f3_nov[ps], og_f3_bal[ps], og_f3_agl[ps], idle_p, false, true, live_anchors, 0.0)["emit"]) == "true" { 1 } else { 0 }
                if to_float(e_p) != og_f3_elive[ps] { perm_h_surp = perm_h_surp + 1 }
            }
            ps = ps + 1
        }
        let d_eff_surp_perm = to_float(perm_h_surp) / midf
        let surp_degen = g_surp < 0.0
        let surp_n3_ok = og_h_surp_n3 == 0
        println("")
        println("──────── H_9210 surprise(recon_err) emit-shade (mid=" + to_string(og_slf_mid_ticks)
            + " · G_surp=" + to_string(g_surp) + ") ────────")
        println("  ΔEff_surp Hamming(surp-shade idle vs e_live) = " + to_string(og_h_surp_mid) + "/" + to_string(og_slf_mid_ticks)
            + " = " + to_string(d_eff_surp) + "   [HEADLINE]")
        println("  ARM-PERM matched-noise = " + to_string(perm_h_surp) + "/" + to_string(og_slf_mid_ticks)
            + " = " + to_string(d_eff_surp_perm) + "  → margin = " + to_string(d_eff_surp - d_eff_surp_perm))
        println("  POS-PASS(dense ARM-SHOCK, same wire)=" + (if pos_pass {"YES"} else {"NO"})
            + " · N3 surp-flips=" + to_string(og_h_surp_n3) + " (must 0) · axis " + (if surp_degen {"DEGENERATE"} else {"ok"}))
        // --opgrip-live TWO-GATE liveness (anima-hexa-4/6): a null is meaningful only when BOTH
        // the WIRE can move (dense ARM-SHOCK ≥2) AND the SIGNAL moves (AXIS-LIVE = surp_degen false).
        // No-decode --opgrip has gate-1 but STRUCTURALLY fails gate-2 (recon_err = fixed-seed const);
        // --opgrip-live is the minimal change that can satisfy gate-2 via a real g_text-stepped field.
        println("  decode-mode=" + (if og_live {"--opgrip-live REAL-DECODE (content-driven recon_err)"} else {"--opgrip NO-DECODE ($0; recon_err = fixed-seed → AXIS-DEGENERATE by construction, anima-hexa-6)"})
            + " · TWO-GATE: WIRE(ARM-SHOCK≥2)=" + (if pos_pass {"YES"} else {"NO"})
            + " ∧ SIGNAL(AXIS-LIVE)=" + (if surp_degen {"NO"} else {"YES"}))
        println("  ── PRE-REG H_9210 VERDICT (frozen bars, verbatim) ──")
        println("  COMPETENT: ΔEff_surp≥0.10 ∧ margin(perm)≥0.08 ∧ POS-PASS ∧ N3=0 ; THEATER: ΔEff_surp<0.02 ∧ POS-PASS ; INSTRUMENT-FAIL: POS-FAIL ∨ degenerate")
        let surp_verdict = if surp_degen && og_live {
            "⚙️ INSTRUMENT-FAIL (AXIS-DEGENERATE, real-decode) — recon_err step<0.002 EVEN under --opgrip-live: too few emits stepped the field (or 8-byte feature saturates); fix = raise emit density (§4 fallback), NOT a substrate claim"
        } else if surp_degen {
            "⚙️ INSTRUMENT-FAIL (AXIS-DEGENERATE, no-decode) — recon_err = fixed-seed const (신호 무변, anima-hexa-6); re-run with --opgrip-live (real decode → content-driven recon_err)"
        } else if !pos_pass {
            "⚙️ INSTRUMENT-FAIL (POS-FAIL) — dense ARM-SHOCK가 emit 못 flip(계기결함); 판정보류"
        } else if !surp_n3_ok {
            "🔴 FORCING-GATE — surp-shade가 N3-silent flip; REVERT"
        } else if d_eff_surp >= 0.10 && (d_eff_surp - d_eff_surp_perm) >= 0.08 {
            "🟢 COMPETENT — surprise(예측오차)가 emit 인과 shade(ΔEff≥0.10·noise 이김) ⇒ 2번째 proven emit 채널! prod 배선 후보(a_verified_must_wire)"
        } else if d_eff_surp < 0.02 {
            "🔴 THEATER — surprise도 emit inert(ΔEff<0.02, POS-PASS로 계기정상) ⇒ urgency만 유일 채널 재확인"
        } else {
            "🟠 DIRECTIONAL — real-but-sub-bar(0.02≤ΔEff<0.10 or margin 미달) ⇒ ≥2 seed 재측정"
        }
        println("  VERDICT = " + surp_verdict)

        // ══════════ H_9225 tonic→phasic BAND-PASS transducer VERDICT (Fable design · state/9225_transducer) ══════════
        // Two lanes scored SEPARATELY, independent verdicts (self ⊥ tension). D1 TEN own-lane W=1.0 · D2 dual-EMA
        // band-pass · D3 CAP-SAT guard. midf / pos_pass / live_anchors reused from the H_9209 verdict block above.
        let gslf_use_v = if g_slf2 < 0.0 { 0.0 } else { g_slf2 }
        let gten_use_v = if g_ten2 < 0.0 { 0.0 } else { g_ten2 }
        let d_eff_slf2 = to_float(og_h_slf2_mid) / midf
        let d_eff_ten2 = to_float(og_h_ten2_mid) / midf
        // ── ARM-INPERM (PRIMARY control): rebuild the transducer over the stride-permuted RAW input
        //    j(t)=(t*7+13)%N — exact multiset (matched mean/var), temporal structure destroyed — with the SAME
        //    calibrated gain, re-decode idle→emit. The correct control for a TRANSDUCER claim (stronger than
        //    output-perm). Margin bar M=0.08 = ΔEff_live − ΔEff_inperm. pf READ-only ⇒ byte-faithful re-decode.
        let n9 = len(og_f3_xself)
        let mut inperm_h_slf = 0
        let mut inperm_h_ten = 0
        let mut ema_f_ps = 0.5   let mut ema_s_ps = 0.5
        let mut ema_f_pt = 0.5   let mut ema_s_pt = 0.5
        let mut t9 = 0
        while t9 < n9 {
            let js = (t9 * 7 + 13) % n9
            let xps = og_f3_xself[js]
            let xpt = og_f3_xten[js]
            ema_f_ps = 0.7 * ema_f_ps + 0.3 * xps   ema_s_ps = 0.95 * ema_s_ps + 0.05 * xps
            ema_f_pt = 0.7 * ema_f_pt + 0.3 * xpt   ema_s_pt = 0.95 * ema_s_pt + 0.05 * xpt
            let stf9 = og_f3_stg[t9]
            if t9 >= 50 && (stf9 == 1.0 || stf9 == 2.0 || stf9 == 4.0) {
                let ph_ps = _afs_clip01(0.5 + gslf_use_v * (ema_f_ps - ema_s_ps))
                let ph_pt = _afs_clip01(0.5 + gten_use_v * (ema_f_pt - ema_s_pt))
                let idle_ps = 5.0 + 55.0 * _afs_clip01(og_f3_senv[t9] * (0.5 + og_f3_urg[t9] + (ph_ps - 0.5)))
                let idle_pt = 5.0 + 55.0 * _afs_clip01(og_f3_senv[t9] * (0.5 + og_f3_urg[t9] + (ph_pt - 0.5)))
                let e_ps = if to_string(brain_decide_anchored(pf,
                    og_f3_rel[t9], og_f3_gap[t9], og_f3_cur[t9], og_f3_allo[t9], og_f3_coh[t9],
