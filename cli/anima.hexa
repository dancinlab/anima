// ── time-source seam (H_9102 stateful refractory) ───────────────────────────
// ONE function, TWO bindings, ONE downstream algebra — the flame_mm.mm pattern
// (cuda host = own-GEMM · else farr CPU · byte-identical). Here: det proper-time
// vs real wall-clock. The VERDICT path always reads det (daemon=false) so every
// frozen-bar / G-gate / --refractory run is byte-identical across executions (F4).
fn an_tick_seconds() -> float { return 8.0 }   // det proper-time: 1 tick = 8s (matches dr_stage_at(tick*8))

fn an_clock_now(tick: int, daemon: bool) -> float {
    // daemon=true (production real channel): real monotonic wall-clock. No persistent daemon
    //   exists yet (the loop is bounded 12/200 ticks) so this branch is a FOLLOW-ON (ING) — when
    //   wired it makes the FROZEN 30s safety floor a true world-time promise (F3 smoke). Never
    //   reached on the verdict path (refr_daemon=false), so determinism is preserved.
    if daemon { return to_float(to_int(exec("date +%s"))) }
    // daemon=false (verdict/det path): substrate proper-time = tick * an_tick_seconds().
    return to_float(tick) * an_tick_seconds()
}

// ── helpers (pure string ops; p7 deterministic) ─────────────────────────────
fn _afs_contains(hay: string, needle: string) -> bool {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return true }
    if nn > hn { return false }
    let mut i = 0
    while i + nn <= hn {
        if substring(hay, i, i + nn) == needle { return true }
        i = i + 1
    }
    return false
}
fn _afs_clip(s: string, n: int) -> string {
    if byte_len(s) <= n { return s }
    return substring(s, 0, n) + "…"
}
fn _afs_clip01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// ── op-grip: tonic-phasic helpers (fable design (a) · H_9097) ─────────────────
// _og_rel_from — the phasic-gated relevance the brain_emit `rel` arg receives, from a
// (possibly ablated) rel_ctx instantaneous value against the running tonic EMA. gain=3.0,
// centred at 0.5 (PREREG-frozen). The drive_hi sleep-mask (×0.1) is preserved verbatim.
fn _og_rel_from(relctx: float, ema: float, drive_hi: bool) -> float {
    let p = _og_rel_phasic(relctx, ema)
    return if drive_hi { p } else { p * 0.1 }
}

// _og_rel_phasic — the UNMASKED phasic relevance p = clip01(0.5 + gain·(relctx − ema)).
// H_9101 op-grip (b): the continuous stage envelope replaces the binary drive_hi ×0.1 mask,
// so callers on the (b) path multiply this p by (0.1 + 0.9·stage_env) instead.
fn _og_rel_phasic(relctx: float, ema: float) -> float {
    return _afs_clip01(0.5 + 3.0 * (relctx - ema))
}

// _og_lcg — deterministic per-tick pseudo-random in [0,1) for the SHUFFLE ablation arm
// (a fixed-seed LCG; the shuffle control breaks the live signal without changing the tick
// count). Bounded modulus keeps hexa int arithmetic in range.
fn _og_lcg(seed: int) -> float {
    let x = (seed * 1103515245 + 12345) % 2147483647
    let y = if x < 0 { 0 - x } else { x }
    return to_float(y % 1000) / 1000.0
}

// _og_argmax8 — argmax index over an 8-vector (kosmos ΔEff_self content-axis pick).
// Deterministic; ties resolve to the lowest index. Bounded to dim=8 (the self-vector dim).
fn _og_argmax8(v: [float]) -> int {
    let mut bi = 0
    let mut bv = v[0]
    let mut i = 1
    while i < 8 { if v[i] > bv { bv = v[i]  bi = i }  i = i + 1 }
    return bi
}

// _afs_absf / _afs_minf — plain float abs & min (H_9209 self_phasic calibration & event-dev).
fn _afs_absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _afs_minf(a: float, b: float) -> float { if a < b { return a } return b }
fn _afs_maxf(a: float, b: float) -> float { if a > b { return a } return b }

// _og_median — median of a float array via O(n²) rank-select (H_9209 G_self calibration, n≤50).
// Unique ranks (equal-with-lower-index tiebreak) ⇒ exactly one element has rank == n/2.
fn _og_median(a: [float]) -> float {
    let n = len(a)
    if n == 0 { return 0.0 }
    let target = n / 2
    let mut i = 0
    while i < n {
        let mut lt = 0
        let mut j = 0
        while j < n {
            if a[j] < a[i] { lt = lt + 1 }
            else { if a[j] == a[i] && j < i { lt = lt + 1 } }
            j = j + 1
        }
        if lt == target { return a[i] }
        i = i + 1
    }
    return a[target]
}

// ── op-grip per-tick real decode (MEMORY FENCE) ──────────────────────────────────
// The op-grip measurement loop (--opgrip-live n=100 · --opgrip-r3 n=400) runs the EXACT
// production brain_emit (det-argmax mouth) once per emit-tick to step the ONE canonical
// afield with real content variance. Inlining that decode in the big measurement function's
// arena accumulates the brain_emit result Map (`dec`) + decoded string (`gl_text`) across ALL
// n_ticks iterations → LINEAR growth → OOM-kill mid-loop (n=100 fine, n=400 died ~tick126 on
// 30GB). Extracting the heavy decode here frees `dec`+`gl_text` on RETURN (hexa frees a fn's
// arena on __hexa_fn_arena_return) — only the small 8-element emitted-content feature crosses
// back to the caller. BEHAVIOUR is byte-identical to the inline form: same brain_emit args
// (det-argmax mouth · env_off=false · content_clean=true), same emitted condition
// (gen_emitted=="true" ∧ byte_len(gen_text)>0), same _afs_byte_feature(gl_text,8). Returns the
// 8-feat on emit, or an EMPTY array (len==0) as the not-emitted sentinel — the caller keeps all
// persistent state (afield · og_prev_gfeat · ec_x · ec_pred).
fn og_emit_decode_feat(pf: PureField,
                       rel: float, gap: float, cur: float, allo: float,
                       coh: float, nov: float, bal: float, agl: float,
                       idle: float, backend: Map, anchors: list) -> [float] {
    let dec = brain_emit(pf,
        rel, gap, cur, allo, coh, nov, bal, agl,
        idle, false, true,
        backend, anchors)
    let gl_text = to_string(dec["gen_text"])
    if to_string(dec["gen_emitted"]) == "true" && byte_len(gl_text) > 0 {
        return _afs_byte_feature(gl_text, 8)   // small 8-elem feat copied to caller arena on return
    }
    let empty: [float] = []                    // not-emitted sentinel (len==0)
    return empty
}

// ── H_9102 (F3) stats helpers (plain-float, NO numpy — engine-native discipline) ──
fn _og_mean(a: [float]) -> float {
    let n = len(a)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + a[i]  i = i + 1 }
    return s / to_float(n)
}
fn _og_std(a: [float], m: float) -> float {
    let n = len(a)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { let d = a[i] - m  s = s + d * d  i = i + 1 }
    return sqrt(s / to_float(n))
}
// _og_pearson_m — Pearson r(x,y) over the indices where mask[i] > 0.5 (point-biserial when x is 0/1).
// Returns 0.0 on a degenerate arm (fewer than 2 points, or either series constant).
fn _og_pearson_m(x: [float], y: [float], mask: [float]) -> float {
    let n = len(x)
    let mut cnt = 0
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        if mask[i] > 0.5 { sx = sx + x[i]  sy = sy + y[i]  cnt = cnt + 1 }
        i = i + 1
    }
    if cnt < 2 { return 0.0 }
    let cf = to_float(cnt)
    let mx = sx / cf
    let my = sy / cf
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    let mut j = 0
    while j < n {
        if mask[j] > 0.5 {
            let dx = x[j] - mx
            let dy = y[j] - my
            sxy = sxy + dx * dy
            sxx = sxx + dx * dx
            syy = syy + dy * dy
        }
        j = j + 1
    }
    if sxx <= 0.0 || syy <= 0.0 { return 0.0 }
    return sxy / sqrt(sxx * syy)
}

// _afs_byte_feature — the DIM=8 local byte-statistics feature (H_1163 `_byte_feature`,
// VERBATIM), derived LIVE from an emitted span's bytes so the growth lane is keyed to
// real emit content (p7 deterministic; NOT perplexity). Empty span ⇒ zero vector.
fn _afs_byte_feature(s: string, dim: int) -> [float] {
    let n = byte_len(s)
    if n == 0 {
        let mut z = []
        let mut k = 0
        while k < dim { z = z + [0.0]; k = k + 1 }
        return z
    }
    let fn_n = to_float(n)
    let mut sum = 0.0
    let mut sumsq = 0.0
    let mut n_hi = 0
    let mut n_low = 0
    let mut n_sp = 0
    let mut n_dig = 0
    let mut n_pun = 0
    let mut n_lt64 = 0
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        let bf = to_float(b)
        sum = sum + bf
        sumsq = sumsq + bf * bf
        if b >= 128 { n_hi = n_hi + 1 }
        if b >= 97 && b <= 122 { n_low = n_low + 1 }
        if b == 32 { n_sp = n_sp + 1 }
        if b >= 48 && b <= 57 { n_dig = n_dig + 1 }
        if b >= 33 && b <= 64 { n_pun = n_pun + 1 }
        if b < 64 { n_lt64 = n_lt64 + 1 }
        i = i + 1
    }
    let mean = sum / fn_n
    let var = sumsq / fn_n - mean * mean
    return [
        (mean / 255.0) * 5.0,
        (to_float(n_hi) / fn_n) * 5.0,
        (to_float(n_low) / fn_n) * 5.0,
        (to_float(n_sp) / fn_n) * 5.0,
        (to_float(n_dig) / fn_n) * 5.0,
        (var / (255.0 * 255.0)) * 5.0,
        (to_float(n_pun) / fn_n) * 5.0,
        (to_float(n_lt64) / fn_n) * 5.0
    ]
}

// _afs_ca3_sym — H_9411 ③ · CA3 percept symbol (byte-sum mod n; twin of cli/chat.py _afs_ca3_sym).
fn _afs_ca3_sym(s: string, n: int) -> int {
    let bl = byte_len(s)
    if bl == 0 { return 0 }
    let mut t = 0
    let mut i = 0
    while i < bl { t = t + ord(substring(s, i, i + 1))  i = i + 1 }
    return t % n
}
