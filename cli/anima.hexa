            println("  gain: g_vq=" + to_string(g_vq) + " (capsat=" + (if vq_capsat {"YES"} else {"no"}) + ") · codes visited on scored mid = " + to_string(n_vq_visited) + " (bar ≥4)")
            println("  ── S1 code-selection ──")
            println("    ΔEff_vq = " + to_string(og_h_vqF_mid) + "/" + to_string(og_vqF_mid_ticks) + " = " + to_string(d_eff_vqF) + "   [HEADLINE]")
            println("    ARM-SHUFFLE-CODEBOOK (PRIMARY theater-killer) = " + to_string(og_h_vqshuf_mid) + " = " + to_string(d_eff_vqshuf)
                + "  → margin_cb = ΔEff−shuf = " + to_string(margin_cb) + " (bar ≥0.08)")
            println("    ARM-INPERM (tick-order, SECONDARY diagnostic no-bar) = " + to_string(inpermF_h) + " = " + to_string(d_eff_inpermF))
