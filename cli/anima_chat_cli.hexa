// anima_chat_cli.hexa — THIN SHIM → cli/anima.hexa --byte (canonical entry unification).
//
// The byte-continuation chat that used to live here was ABSORBED into the canonical
// single entry point cli/anima.hexa as its `--byte` mode (a_core_engine_map: cli/ holds
// ONE entry point). This shim is kept so the documented invocation
//   hexa run cli/anima_chat_cli.hexa -- <ckpt.clm> ["turn1" "turn2" ...]
// (CLAUDE.md pod-upload entry · README · bootstrap scripts) keeps working byte-identical
// — it simply delegates to anima.hexa's byte mode. PREFER `hexa run cli/anima.hexa --
// <ckpt.clm> --byte …` going forward; this path is the back-compat alias.
//
// p1..p8 unchanged: the byte-continuation markers are LEARNED conditioning, NOT a system
// prompt / persona / identity rule (capability comes only from the trained distribution).

import "cli/anima.hexa"

fn main() {
    let argv = anima_collect_argv(args())
    if len(argv) < 1 {
        println("usage: hexa run cli/anima_chat_cli.hexa -- <ckpt.clm> [\"turn1\" \"turn2\" ...]")
        println("  (alias of: hexa run cli/anima.hexa -- <ckpt.clm> --byte …)")
        return
    }
    // delegate to the canonical byte mode. anima_byte_mode skips any "--byte" token in
    // argv, so passing the raw argv here is byte-identical to the pre-absorption loop
    // (positionals after the ckpt are the user turns; none ⇒ the default battery).
    anima_byte_mode(argv[0], argv)
}
