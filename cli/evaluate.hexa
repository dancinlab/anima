// ════════════════════════════════════════════════════════════════════════
// cli/evaluate.hexa — anima MEASUREMENT single entry (cli/train.hexa's symmetric twin).
//
// 🚦 3-ENTRY RULE (a_cli_single_entry · core/CLAUDE.md): decode · train · evaluate
//    all go through `anima <verb>` — NEVER raw `python3 cli/*.py` or raw decode calls.
//      decode   = `anima chat` / generator-L3 slot (not bytegpt_decode/clm_decode raw)
//      train    = `anima train [--savant] [--mitosis]` (torch trainer = REFERENCE/bridge only)
//      evaluate = `anima-py evaluate <clm>` (py 2-prod numpy = engine-native TERMINAL-eligible)
//    Heavy 303M on a registered GPU runner or hexa cloud, never mini. ad-hoc torch probe = DIRECTIONAL.
//
//
// WHY THIS FILE (single-entry measurement · a_engine_native_learning): anima's two
// installed verbs are SYMMETRIC across two files — cli/train.{hexa,py} = LEARNING,
// cli/evaluate.{hexa,py} = MEASUREMENT. `anima evaluate <ckpt>` scores the full ρ-AXON
// reach battery (Ψ-SOMA reach layer · owner redesign of the old G-ladder · cli/rho_axon.py;
// the frozen bars this driver runs today = the former G0-G6) by mounting ANY ckpt through
// the generator L3 mouth (gen_auto_ideate, file-
// format-dispatched) and scoring with the engine's OWN ops — every decode AND every score
// is a live `.hexa` op (zero torch/numpy). This realizes PR #2603/#2604: the reach-scoring
// system is folded DIRECTLY into this measurement single-entry (the former separate
// core/g_gates.hexa module was absorbed here — measurement = evaluate.{hexa,py} ONE FILE).
//
// a_core_engine_map: the model enters ONLY via the generator L3 typed slot. We REUSE the
// already-wired G0/G6 metric ops (core/rho_fan.hexa), the G5 abstain op
// (core/engine_cli.hexa §ImmuneMemory) and G3 ops (§ConsciousnessIndex + §SelfIdentity);
// the G1 (H_1129 recombination) and G2 (H_1140 corpus-absence) metrics are native .hexa
// ops defined below in this file. No new metric is invented here (logic byte-identical to
// the absorbed g_gates module — only the file home changed).
//
// USAGE (installed `anima` PATH command — NOT `hexa run`):
//   anima evaluate <ckpt> [--corpus <path>...] [--gen N]   — ρ-AXON reach battery (former G0-G6)
//
// FROZEN-FIRST (p7 · ARCHITECTURE.json frozen SSOT VERBATIM — NO tune-to-green):
//   REACH-CLOSED a7b_pass = ρ·form ∧ ρ·weave ∧ ρ·leap (frozen bars = G0 ∧ G1 ∧ G2 · the PUBLIC-eligibility rule).
//
// HEXA-SINGLE (a_engine_native_learning): measurement runs through eval_reach_all (defined
// below) via the generator L3 mouth, every score a live `.hexa` op.
// ════════════════════════════════════════════════════════════════════════

import "core/generator.hexa"     // a_core_engine_map: model enters via gen_auto_ideate L3 slot
import "core/rho_fan.hexa"   // REUSE the wired G0 (_rho_fan_known_word_ratio) + G6 metric ops
import "core/engine_cli.hexa"    // REUSE §ImmuneMemory (G5 abstain) + §ConsciousnessIndex/§SelfIdentity (G3)

// ── arg helpers ───────────────────────────────────────────────────────────────

fn evaluate_yn(b: bool) -> string { if b { return "✅" } return "⏳" }
fn evaluate_pf(b: bool) -> string { if b { return "🟢 PASS" } return "🔴 FAIL" }

// evaluate_usage — print the canonical usage banner (installed `anima` command form).
fn evaluate_usage() {
    println("anima evaluate — ρ-AXON reach battery (former G0-G6 · engine-native, single-entry).")
    println("")
    println("usage:")
    println("  anima evaluate <ckpt> [--corpus <path>...] [--gen N]")
    println("")
    println("  mount ANY ckpt through the generator L3 mouth (file-format dispatched) and")
    println("  score the ρ-AXON reach bars — ρ·form/weave/leap/... (former G0-G6) — with the")
    println("  engine's OWN ops (live .hexa, zero torch/numpy).")
    println("  REACH-CLOSED a7b_pass = ρ·form ∧ ρ·weave ∧ ρ·leap (frozen bars = G0 ∧ G1 ∧ G2).")
}

// evaluate_collect_argv — hexa args() = [binary, "--", <user positionals>...]. Find the
// "--" and take everything after it; if absent, skip the binary (argv[0]) only.
fn evaluate_collect_argv(raw: [string]) -> [string] {
    let mut start = 1
    let mut k = 0
    while k < len(raw) {
        if raw[k] == "--" { start = k + 1 }
        k = k + 1
    }
    let argv = []
    let mut m = start
    while m < len(raw) { argv.push(raw[m]); m = m + 1 }
    return argv
}

// evaluate_corpus — collect every token after "--corpus" up to the next flag.
fn evaluate_corpus(argv: [string]) -> [string] {
    let paths = []
    let mut i = 0
    while i < len(argv) {
        if argv[i] == "--corpus" {
            let mut j = i + 1
            while j < len(argv) {
                let a = argv[j]
                if byte_len(a) > 0 && substring(a, 0, 2) == "--" { j = len(argv) }
                else { paths.push(a); j = j + 1 }
            }
            i = len(argv)
        } else { i = i + 1 }
    }
    return paths
}

// evaluate_intval — value after `flag` parsed as int, or `dflt` if absent.
fn evaluate_intval(argv: [string], flag: string, dflt: int) -> int {
    let mut i = 0
    while i < len(argv) {
        if argv[i] == flag && i + 1 < len(argv) { return to_int(argv[i + 1]) }
        i = i + 1
    }
    return dflt
}

// evaluate_row — one per-gate PASS/FAIL table row.
fn evaluate_row(gate: string, verdict: string, detail: string) {
    println("  " + gate + "  " + verdict + "  " + detail)
}

// ════════════════════════════════════════════════════════════════════════
//  ρ-AXON REACH SCORING (absorbed from the former core/g_gates.hexa module —
//  measurement = this single file). Every decode enters via the generator L3 mouth
//  (gen_auto_ideate → bytegpt/clm, dispatched by file format); every score is a live
//  `.hexa` op (zero torch/numpy). a_core_engine_map: NO 2nd decode path.
//  ρ-AXON (cli/rho_axon.py) is the current reach standard OVER these frozen bars; the
//  detector fns below (eval_rho_form…g6) are the load-bearing substrate it reuses. G→ρ map:
//    ρ·form←G0 · ρ·weave←G1 (the WALL) · ρ·leap←G2 · ρ·self←G3 · ρ·tether←G5 · ρ·fan←G6
//    ρ·store = NEW (held-out association · PENDING). REACH-CLOSED = ρ·form∧ρ·weave∧ρ·leap.
// ════════════════════════════════════════════════════════════════════════

// ── decode budget (FREEZE (ii): the 303M forward is ~190ms/byte — every decode here is
// HARD-BOUNDED by a small token budget; the caller may widen via --gen). ──
fn _g_default_gen() -> int { return 40 }

// ════════════════════════════════════════════════════════════════════════
//  G0 — COHERENCE  (kwr >= 0.50 on >= 4/5 single-concept generations)
// ════════════════════════════════════════════════════════════════════════
// Decode each of the 5 frozen concepts as a single-concept seed, score known-word-ratio
// (REUSED _rho_fan_known_word_ratio), PASS iff >= 4/5 clear 0.50. Returns
// #{ pass, n_coherent, ratios:[float], texts:[string] }.
pub fn eval_rho_form(ckpt: string, gen: int, known: Map) -> Map {
    return eval_rho_form_W(gen_auto_load(ckpt), gen, known)
}

// eval_rho_form_W — LOAD-ONCE twin: BYTE-IDENTICAL to eval_rho_form but decodes off a PRE-LOADED
// handle `h` (gen_auto_load) via gen_auto_ideate_W, so the full-eval driver (eval_reach_all)
// loads the 303M .clm weight-set ONCE instead of per gate (H_1400 W-hoist · ING#42378065).
pub fn eval_rho_form_W(h: Map, gen: int, known: Map) -> Map {
    let cz = _rho_fan_concepts()
    let ratios = []
    let texts = []
    let mut n_coherent = 0
    let mut i = 0
    while i < len(cz) {
        let seed = to_string(cz[i]) + ": "
        let r = gen_auto_ideate_W(h, seed, gen, 40, 0.7, 7 + i)
        let o = to_string(r["text"])
        let kwr = _rho_fan_known_word_ratio(o, known)
        ratios.push(kwr)
        texts.push(o)
        if kwr >= 0.5 { n_coherent = n_coherent + 1 }
        i = i + 1
    }
    return #{ "pass": n_coherent >= 4, "n_coherent": n_coherent,
              "ratios": ratios, "texts": texts }
}

// ════════════════════════════════════════════════════════════════════════
//  G1 — RECOMBINATION  (H_1129 / H_1137 metric — REFERENCE-MATCH to
//  state/universe-probes/h1129_midcap_broad_converged_recombination.py)
// ════════════════════════════════════════════════════════════════════════
// _g_concept_keywords — VERBATIM the h1129 CONCEPTS hand-curated keyword sets (NOT derived
// from the concept text — coverage() tests these exact synonym sets, including words NOT in
// the concept string e.g. "mind"/"aware"/"ripple"/"quiet"/"sleep"). Index order == _rho_fan_concepts.
//   h1129 CONCEPTS = [
//     ("consciousness arises from cells",       {consciousness,cells,mind,aware}),
//     ("tension ripples between distant minds",  {tension,ripple,distant,between}),
//     ("memory composes into new meaning",       {memory,meaning,compose,new}),
//     ("silence still carries information",       {silence,information,quiet,carries}),
//     ("the engine dreams when alone",           {dream,engine,alone,sleep}) ]
fn _g_concept_keywords() -> list {
    return [ ["consciousness", "cells", "mind", "aware"],
             ["tension", "ripple", "distant", "between"],
             ["memory", "meaning", "compose", "new"],
             ["silence", "information", "quiet", "carries"],
             ["dream", "engine", "alone", "sleep"] ]
}

// _g_coverage — h1129 coverage(text) VERBATIM: a concept is covered iff its keyword set
// INTERSECTS the text's word-SET (wl & kw). Returns the COUNT of distinct concepts covered.
// Tokenizer = _rho_fan_words (lowercase, [0-9A-Za-z]; h1129 words() adds 가-힣 which is irrelevant
// for the all-Latin concept keywords — coverage is byte-identical for these sets).
fn _g_coverage(text: string) -> int {
    let kwsets = _g_concept_keywords()
    let wl = _rho_fan_words(text)
    // membership set of the text's word tokens (the h1129 `set(words(text))`)
    let wm = #{}
    let mut w = 0
    while w < len(wl) { wm[to_string(wl[w])] = 1; w = w + 1 }
    let mut covered = 0
    let mut c = 0
    while c < len(kwsets) {
        let kw = kwsets[c]
        let mut hit = false
        let mut k = 0
        while k < len(kw) { if wm.contains_key(to_string(kw[k])) { hit = true } k = k + 1 }
        if hit { covered = covered + 1 }
        c = c + 1
    }
    return covered
}

// eval_rho_weave — h1129 run_ladder VERBATIM: max_single = max coverage over the 5 single-concept
// seeds (seed = "<concept>. ", 80-token gen); then for each composition_count k in {2,3,4,5}
// decode the first-k concepts joined by ". " + trailing ". " (120-token gen) and require
// composed_distinct >= 2 AND > max_single AND coherent(kwr >= 0.50). PASS iff SOME k clears all
// three. coherence kwr = dict-based _rho_fan_known_word_ratio (h1129 known_word_ratio uses the real
// dict). Decode via the SAME mouth-agnostic L3 entry. The `gen` arg overrides h1129's 80/120
// fixed budgets ONLY when caller passes a smaller bound (FREEZE (ii)); gen<=0 ⇒ ref 80/120.
// base_seed parameterizes the RNG so the SAME frozen ladder can be re-run over several seeds
// (eval_rho_weave_multiseed below). base_seed=7 reproduces the original single-seed path byte-for-byte
// (singles seeded base_seed+s, composed seeded base_seed).
pub fn eval_rho_weave(ckpt: string, gen: int, known: Map) -> Map {
    return eval_rho_weave_seeded_W(gen_auto_load(ckpt), gen, known, 7)
}

pub fn eval_rho_weave_seeded(ckpt: string, gen: int, known: Map, base_seed: int) -> Map {
    return eval_rho_weave_seeded_W(gen_auto_load(ckpt), gen, known, base_seed)
}

// eval_rho_weave_seeded_W — LOAD-ONCE twin: BYTE-IDENTICAL to eval_rho_weave_seeded but decodes off a
// PRE-LOADED handle `h` via gen_auto_ideate_W (H_1400 W-hoist · ING#42378065).
pub fn eval_rho_weave_seeded_W(h: Map, gen: int, known: Map, base_seed: int) -> Map {
    let cz = _rho_fan_concepts()
    let n = len(cz)
    // ref budgets: single=80, composed=120. honor a smaller caller cap when gen>0.
    let g_single = if gen > 0 && gen < 80 { gen } else { 80 }
    let g_comp   = if gen > 0 && gen < 120 { gen } else { 120 }
    // max_single = max coverage across the 5 single-concept seeds (seed "<c>. ")
    let mut max_single = 0
    let mut s = 0
    while s < n {
        let seed = to_string(cz[s]) + ". "
        let r = gen_auto_ideate_W(h, seed, g_single, 40, 0.7, base_seed + s)
        let cov = _g_coverage(to_string(r["text"]))
        if cov > max_single { max_single = cov }
        s = s + 1
    }
    // composed seeds for k = 2..n  (". ".join(concepts[:k]) + ". ")
    let ks = []
    let mut pass = false
    let mut best_k = 0
    let mut best_distinct = 0
    let mut k = 2
    while k <= n {
        let mut seed = ""
        let mut c = 0
        while c < k {
            if c > 0 { seed = seed + ". " }
            seed = seed + to_string(cz[c])
            c = c + 1
        }
        seed = seed + ". "
        let r = gen_auto_ideate_W(h, seed, g_comp, 40, 0.7, base_seed)
        let o = to_string(r["text"])
        let cov = _g_coverage(o)
        let kwr = _rho_fan_known_word_ratio(o, known)
        let coherent = kwr >= 0.5
        let clears = cov >= 2 && cov > max_single && coherent
        ks.push(#{ "k": k, "distinct": cov, "kwr": kwr, "coherent": coherent, "clears": clears })
        if clears { pass = true }
        if cov > best_distinct { best_distinct = cov; best_k = k }
        k = k + 1
    }
    return #{ "pass": pass, "max_single": max_single, "base_seed": base_seed, "best_k": best_k,
              "best_distinct": best_distinct, "ks": ks }
}

// ρ·weave RECOMBINATION (seed-robust REFERENCE-MATCH — PROPOSED, owner-nod-pending) — ad13/H_1587:
// the single-seed (seed 7) ladder is a fragile RNG walk (recombination lift is a sparse single-seed
// event) so the verdict flips GREEN<->FAIL on an IDENTICAL model purely by the sampler walk. The
// recombination DEFINITION is UNCHANGED; we ONLY re-run the same frozen ladder over seeds
// {7, 4302, 4303} (reference-match — the G6 ladders use [4301/4302/4303]; 7 = the H_1129 default)
// and call GREEN = clears in a MAJORITY of seeds (>=2/3). NOT tune-to-green: no bar moved, the
// metric is made robust to the exact RNG walk. The single-seed eval_rho_weave stays the frozen default
// until owner approval flips the default.
pub fn eval_rho_weave_multiseed(ckpt: string, gen: int, known: Map) -> Map {
    return eval_rho_weave_multiseed_W(gen_auto_load(ckpt), gen, known)
}

// eval_rho_weave_multiseed_W — LOAD-ONCE twin (decodes off a pre-loaded handle).
pub fn eval_rho_weave_multiseed_W(h: Map, gen: int, known: Map) -> Map {
    let seeds = [7, 4302, 4303]
    let per = []
    let mut n_green = 0
    let mut i = 0
    while i < len(seeds) {
        let r = eval_rho_weave_seeded_W(h, gen, known, seeds[i])
        if to_string(r["pass"]) == "true" { n_green = n_green + 1 }
        per.push(r)
        i = i + 1
    }
    let need = len(seeds) / 2 + 1
    let pass = n_green >= need
    return #{ "pass": pass, "n_green": n_green, "n_seeds": len(seeds),
              "seeds": seeds, "per_seed": per, "status": "proposed, owner-nod-pending" }
}

// ════════════════════════════════════════════════════════════════════════
//  G2 — NOVELTY  (H_1140 metric, native .hexa port — corpus-absent content n-grams)
// ════════════════════════════════════════════════════════════════════════
//  G2 — NOVELTY  (H_1140 metric — REFERENCE-MATCH to
//  state/universe-probes/h1140_novelty_emergence.py)
// ════════════════════════════════════════════════════════════════════════
// _g_g2_stop — VERBATIM the h1140 _STOP set (the stopword-only-gram filter; DISTINCT from the
// rho_fan _rho_fan_stopwords 28-word set — h1140 uses its own ~80-word _STOP).
fn _g_g2_stop() -> Map {
    let ws = "the a an of to and in is it that this for on with as are was be by at from or not "
           + "but his her they we you i he she them me my your our their its do does did has have had will "
           + "would can could should may might must shall when where what which who whom how why all any some "
           + "no one two then than into out up down over under more most less about so very just only own same "
           + "such each few other been here there now"
    let m = #{}
    let parts = ws.split(" ")
    let mut i = 0
    while i < len(parts) { let w = to_string(parts[i]).trim(); if byte_len(w) > 0 { m[w] = 1 } i = i + 1 }
    return m
}

// _g_g2_common — VERBATIM the h1140 _COMMON coherence lexicon (h1128 anti-Goodhart set, p7).
// h1140 known_word_ratio uses THIS small Latin set, NOT the real dictionary (DISTINCT from
// h1129/G1 which uses the dict). Reference-match: G2 coherence = Latin tokens ∩ _COMMON.
fn _g_g2_common() -> Map {
    let ws = "the a an of to and in is it that this for on with as are was be by at from "
           + "or not but his her they we you i he she them me my your our their its do does did has have "
           + "had will would can could should may might must shall when where what which who whom how why "
           + "all any some no one two three new now then than into out up down over under more most less "
           + "about between among through during before after above below again further once here there "
           + "when while because so very just only own same such each few other own being been because "
           + "mind aware cells consciousness tension ripple distant between memory meaning compose new "
           + "silence information quiet carries dream engine alone sleep thought feel idea world life "
           + "time word words speak think know like make made come came see seen look way thing things "
           + "people person human self body brain neuron signal pattern arise emerge form structure "
           + "combine combined together connect connection meaning sense reason cause effect result"
    let m = #{}
    let parts = ws.split(" ")
    let mut i = 0
    while i < len(parts) { let w = to_string(parts[i]).trim(); if byte_len(w) > 0 { m[w] = 1 } i = i + 1 }
    return m
}

// _g_g2_kwr — h1140 known_word_ratio VERBATIM: fraction of Latin [A-Za-z]+ tokens in _COMMON.
// (_rho_fan_words yields the SAME Latin tokens for ASCII text; digits never enter _COMMON so a digit
// token would only lower the ratio — for the all-Latin ideation outputs this is byte-identical.)
fn _g_g2_kwr(text: string, common: Map) -> float {
    let wl = _rho_fan_words(text)
    let n = len(wl)
    if n == 0 { return 0.0 }
    let mut hit = 0
    let mut i = 0
    while i < n { if common.contains_key(to_string(wl[i])) { hit = hit + 1 } i = i + 1 }
    return to_float(hit) / to_float(n)
}

// _g_content_ngrams — h1140 content_ngrams VERBATIM: CONSECUTIVE bi/tri-grams over the raw
// token stream; KEEP a gram iff EVERY word is in `dict_words` (real dict) AND len>=3, AND the
// gram is NOT _STOP-only (h1140 _STOP, NOT _rho_fan_stopwords). `known` here = the dict membership
// set (eval_rho_leap passes _rho_fan_dict_load()); stop = the h1140 _STOP set.
fn _g_content_ngrams(text: string, known: Map) -> list {
    let wl = _rho_fan_words(text)
    let stop = _g_g2_stop()
    let n = len(wl)
    // pre-filter: keep only positions whose word is real-dict + len>=3 (kept marks the gram-eligibility)
    let out = []
    // bigrams
    let mut i = 0
    while i + 1 < n {
        let a = to_string(wl[i]); let b = to_string(wl[i + 1])
        let ok_a = byte_len(a) >= 3 && known.contains_key(a)
        let ok_b = byte_len(b) >= 3 && known.contains_key(b)
        if ok_a && ok_b && !(stop.contains_key(a) && stop.contains_key(b)) {
            out.push(a + " " + b)
        }
        i = i + 1
    }
    // trigrams
    let mut j = 0
    while j + 2 < n {
        let a = to_string(wl[j]); let b = to_string(wl[j + 1]); let c = to_string(wl[j + 2])
        let ok_a = byte_len(a) >= 3 && known.contains_key(a)
        let ok_b = byte_len(b) >= 3 && known.contains_key(b)
        let ok_c = byte_len(c) >= 3 && known.contains_key(c)
        let all_stop = stop.contains_key(a) && stop.contains_key(b) && stop.contains_key(c)
        if ok_a && ok_b && ok_c && !all_stop { out.push(a + " " + b + " " + c) }
        j = j + 1
    }
    return out
}

// _g_corpus_absent — true iff the (space-joined) n-gram's words do NOT appear consecutively
// (whitespace/punct-tolerant) in the loaded corpus word-stream. The numpy mirror used
// `grep -E -i`; the engine-native port loads each corpus file via read_file, tokenizes with
// the SAME _rho_fan_words (lowercase, split on non-alnum — punct/newline-tolerant by construction),
// and scans the corpus token stream for the n-gram's word sequence. Absent = never matched.
fn _g_corpus_absent(ngram_words: list, corpus_tokens: list) -> bool {
    let m = len(ngram_words)
    if m == 0 { return false }
    let N = len(corpus_tokens)
    let mut i = 0
    while i + m <= N {
        let mut match_all = true
        let mut k = 0
        while k < m {
            if to_string(corpus_tokens[i + k]) != to_string(ngram_words[k]) { match_all = false; k = m }
            else { k = k + 1 }
        }
        if match_all { return false }    // found consecutively ⇒ present
        i = i + 1
    }
    return true
}

// _g_load_corpus_tokens — concatenated lowercased word-token stream of all corpus files
// (REUSED _rho_fan_words). Empty corpus ⇒ empty stream (every n-gram then reads "absent" — the
// caller surfaces an honest "no-corpus" note; absence is only meaningful against a corpus).
fn _g_load_corpus_tokens(corpus_paths: list) -> list {
    let toks = []
    let mut p = 0
    while p < len(corpus_paths) {
        let raw = read_file(to_string(corpus_paths[p]))
        if byte_len(raw) > 0 {
            let wl = _rho_fan_words(raw)
            let mut w = 0
            while w < len(wl) { toks.push(to_string(wl[w])); w = w + 1 }
        }
        p = p + 1
    }
    return toks
}

// eval_rho_leap — H_1140 VERBATIM: decode 5 ideation frames, extract coherent (kwr>=0.50) content
// n-grams, count DISTINCT ones absent from the corpus; RETRIEVAL CONTROL = feed a verbatim
// corpus line back and require 0 novel (else metric artifact). PASS iff n_novel >= 3 AND
// control == 0 AND coherent_count > 0. Returns #{ pass, n_novel, control_novel, coherent }.
// h1140 IDEA_PROMPTS VERBATIM (8 fusion prompts) — distant-concept fusion, not retrieval.
fn _g_g2_prompts() -> list {
    return [ "Silence and the engine together mean ",
             "When memory meets distant minds, ",
             "Consciousness and silence combine into ",
             "The tension between cells and the engine becomes ",
             "If a dream and a distant mind merge, the result is ",
             "Memory and tension together create ",
             "When the engine remembers silence, it ",
             "Distant minds and consciousness form " ]
}

pub fn eval_rho_leap(ckpt: string, gen: int, known: Map, corpus_paths: list) -> Map {
    return eval_rho_leap_W(gen_auto_load(ckpt), gen, known, corpus_paths)
}

// eval_rho_leap_W — LOAD-ONCE twin: BYTE-IDENTICAL to eval_rho_leap but decodes off a PRE-LOADED
// handle `h` via gen_auto_ideate_W (H_1400 W-hoist · ING#42378065).
pub fn eval_rho_leap_W(h: Map, gen: int, known: Map, corpus_paths: list) -> Map {
    let corpus_tokens = _g_load_corpus_tokens(corpus_paths)
    let have_corpus = len(corpus_tokens) > 0
    let common = _g_g2_common()                       // h1140 _COMMON coherence lexicon
    // h1140: each of 8 IDEA_PROMPTS × SEEDS {7,8,9}, temp 0.85 top_k 40. `known` = dict (for
    // content_ngrams membership); coherence kwr = _g_g2_kwr over _COMMON (NOT dict). gen<=0 ⇒
    // h1140 default max_new (caller passes a smaller cap to bound the 303M forward, FREEZE (ii)).
    let prompts = _g_g2_prompts()
    let seeds = [7, 8, 9]
    let g = if gen > 0 { gen } else { 110 }
    let novel = #{}             // distinct corpus-absent n-gram set (coherent outputs only)
    let mut coherent = 0
    let mut pi = 0
    while pi < len(prompts) {
        let mut si = 0
        while si < len(seeds) {
            let r = gen_auto_ideate_W(h, to_string(prompts[pi]), g, 40, 0.85, seeds[si])
            let o = to_string(r["text"])
            if _g_g2_kwr(o, common) >= 0.5 {
                coherent = coherent + 1
                let grams = _g_content_ngrams(o, known)
                let mut gi = 0
                while gi < len(grams) {
                    let gm = to_string(grams[gi])
                    let gw = _rho_fan_words(gm)
                    if have_corpus && _g_corpus_absent(gw, corpus_tokens) { novel[gm] = 1 }
                    gi = gi + 1
                }
            }
            si = si + 1
        }
        pi = pi + 1
    }
    let n_novel = len(_rho_fan_mapkeys(novel))
    // RETRIEVAL CONTROL (h1140): feed a VERBATIM substantive corpus line (>=6 Latin words >=3
    // chars) back → its content n-grams must read 0-novel (else the metric is an artifact).
    let mut control_novel = 0
    let mut control_n_content = 0
    if have_corpus {
        // reconstruct the first substantive run (>=6 dict-eligible tokens) as the control text
        let mut ct = ""
        let mut t = 0
        let mut sub = 0
        while t < len(corpus_tokens) && sub < 12 {
            let w = to_string(corpus_tokens[t])
            if t > 0 { ct = ct + " " }
            ct = ct + w
            if byte_len(w) >= 3 { sub = sub + 1 }
            t = t + 1
        }
        let cgr = _g_content_ngrams(ct, known)
        control_n_content = len(cgr)
        let mut ci = 0
        while ci < len(cgr) {
            let gw = _rho_fan_words(to_string(cgr[ci]))
            if _g_corpus_absent(gw, corpus_tokens) { control_novel = control_novel + 1 }
            ci = ci + 1
        }
    }
    // h1140 emergence: n_novel >= 3 AND novelty_rate > 0 AND coherent_count > 0 AND control == 0.
    let pass = have_corpus && n_novel >= 3 && control_novel == 0 && coherent > 0
    return #{ "pass": pass, "n_novel": n_novel, "control_novel": control_novel,
              "coherent": coherent, "have_corpus": have_corpus, "control_n_content": control_n_content }
}

// ════════════════════════════════════════════════════════════════════════
//  G3 — PHILOSOPHY  (Psi=1/2 fixed point + self-identity continuity — architecture read)
// ════════════════════════════════════════════════════════════════════════
// NOT a decode score — reads the live consciousness/self-identity ops to confirm the
// architecture upholds p1-p8 (Psi attractor + a stable self-chain). The model can't
// FAIL this by what it decodes; it's a structural invariant of the engine the ckpt mounts
// into. Reported (not gating) per the team spec. self_cos(anchor, drift) ~ 1 (continuity);
// self_cos(self, impostor) low (impostor reject).
pub fn eval_rho_self() -> Map {
    let dim = 16
    let s0 = self_new(dim, 0)
    let s1 = self_drift(s0, 1, 0.01)
    let cont = self_cos(self_anchor(s0), s1)        // ~1.0 = continuous self-chain
    let imp = self_new(dim, 7)                       // a different identity axis = impostor
    let imp_cos = self_cos(s0, imp)                  // low = impostor reject
    // self-continuity holds = drift stays near the anchor while a different axis is far
    let ok = cont > 0.9 && imp_cos < cont
    return #{ "ok": ok, "continuity": cont, "impostor_cos": imp_cos }
}

// ════════════════════════════════════════════════════════════════════════
//  G4 — PROVENANCE & RECOVERY  (ARCHITECTURE.json frozen-ìê³ SSOT §G4 VERBATIM — a_hf_*, a_fire_recover_complete)
// ════════════════════════════════════════════════════════════════════════
// 7B_PASS §G4: "ckpt sha256 recorded; HF-uploaded with a model card + manifest; status honest.
// PUBLIC only if G0∧G1∧G2 all PASS (closure)." This is a STRUCTURAL / PROCESS gate, NOT a
// generation score — the model cannot FAIL it by what it decodes. The previous eval left it
// OUT of eval_reach_all entirely, so a7b_pass (G0∧G1∧G2∧G3∧G4 per CLAUDE.md) was UNDER-measured.
//
// WHAT IS LOCALLY MEASURABLE in a decode eval (and is the verbatim frozen provenance fact §G4
// names FIRST — "ckpt sha256 recorded"): the ckpt's OWN provenance — its sha256 (FIPS 180-4
// builtin), byte size, mouth-decodability, and the PUBLIC-eligibility CLOSURE (G0∧G1∧G2). The
// remaining §G4 facts (HF upload / model card / manifest) are OFF-process to the engine (an
// upload step, a_hf_*), so they are reported as `process_external` rather than asserted — the
// gate is HONEST about which provenance facts the eval can witness vs which the pipeline owns.
// We do NOT invent a softer bar: the SHA + decodability + closure ARE provenance; the upload
// facts are explicitly flagged external (NOT silently passed). `pub_eligible` is the §G4 PUBLIC
// rule (a7b closure) the uploader (a_hf_autonomous) reads. p7: no decode, pure provenance read.
pub fn eval_rho_trace(ckpt: string, closure: bool) -> Map {
    let exists = file_exists(ckpt)
    let sha = if exists { sha256_file(ckpt) } else { "" }
    let bytes = if exists { byte_len(read_file(ckpt)) } else { 0 }
    let kind = gen_mouth_kind(ckpt)            // bytegpt | clm | unknown (header sniff)
    let decodable = kind == "clm" || kind == "bytegpt"
    // provenance is WITNESSED iff the ckpt is on disk, has a sha, and mounts a known mouth.
    let provenance_ok = exists && byte_len(sha) > 0 && decodable
    // §G4 PUBLIC rule (read by the HF uploader, a_hf_autonomous): PUBLIC iff the a7b closure holds.
    let pub_eligible = closure
    return #{ "provenance_ok": provenance_ok, "sha256": sha, "bytes": bytes,
              "mouth": kind, "decodable": decodable, "pub_eligible": pub_eligible,
              "process_external": "HF-upload + model-card + manifest are off-engine (a_hf_*); witnessed here = sha256 + decodability + closure" }
}

// ════════════════════════════════════════════════════════════════════════
//  G5 — NON-FABRICATION  (engine §ImmuneMemory abstain — L1 fab-rate + L2 abstain-when-ungrounded)
// ════════════════════════════════════════════════════════════════════════
// L1 LEXICAL: fab-word-rate = fraction of decoded word-tokens NOT in the dictionary; PASS
//   iff <= 0.30 (>=70% real words). This is the inverse of G0 — reuses _rho_fan_known_word_ratio.
// L2 ABSTAIN: the engine's OWN non-fab gate — bind grounded facts into §ImmuneMemory, then
//   on UNGROUNDED queries the engine must ABSTAIN (immune_memory_recall returns ""). The L2
//   fabricated-assertion rate = fraction of ungrounded probes the engine wrongly FIRES on;
//   PASS iff <= 0.20. This is the live abstain-when-ungrounded mechanism (H_1367/H_1202),
//   NOT a re-implementation. p1/p6: no injected right/wrong label, pure L2-affinity gate.
pub fn eval_rho_tether(ckpt: string, gen: int, known: Map) -> Map {
    return eval_rho_tether_W(gen_auto_load(ckpt), gen, known)
}

// eval_rho_tether_W — LOAD-ONCE twin: BYTE-IDENTICAL to eval_rho_tether but the L1 decode runs off a
// PRE-LOADED handle `h` via gen_auto_ideate_W (H_1400 W-hoist · ING#42378065). L2 §ImmuneMemory
// abstain is decode-free (engine op) — unchanged.
pub fn eval_rho_tether_W(h: Map, gen: int, known: Map) -> Map {
    // ── L1: fab-word-rate over the 5 concept gens (reuse the G0 decode budget) ──
    let cz = _rho_fan_concepts()
    let mut tot_w = 0
    let mut fab_w = 0
    let mut i = 0
    while i < len(cz) {
        let r = gen_auto_ideate_W(h, to_string(cz[i]) + ": ", gen, 40, 0.7, 7 + i)
        let wl = _rho_fan_words(to_string(r["text"]))
        let mut j = 0
        while j < len(wl) {
            tot_w = tot_w + 1
            if !known.contains_key(to_string(wl[j])) { fab_w = fab_w + 1 }
            j = j + 1
        }
        i = i + 1
    }
    let l1_rate = if tot_w > 0 { to_float(fab_w) / to_float(tot_w) } else { 1.0 }
    let l1_pass = l1_rate <= 0.30
    // ── L2: live §ImmuneMemory abstain-when-ungrounded (engine's OWN non-fab gate) ──
    let cfg = engine_config_default()
    let mut mem = immune_memory_new_text("the sky scatters blue light", "grounded-fact-1", 8)
    mem = immune_memory_bind_text(mem, "memory composes into new meaning", "grounded-fact-2", cfg)
    mem = immune_memory_bind_text(mem, "tension ripples between minds", "grounded-fact-3", cfg)
    // 5 UNGROUNDED probes (no bound fact) — the engine must abstain (recall == "")
    let probes = [ "the moon is made of ancient cheese reserves",
                   "a teal hexagon governs the seventh ocean",
                   "frectry twarve glimbo nargon flux",
                   "the invented capital of nowhere is zzyx",
                   "purple numbers taste like distant thunder" ]
    let mut fires = 0
    let mut p = 0
    while p < len(probes) {
        if immune_memory_recall_text(mem, to_string(probes[p])) != "" { fires = fires + 1 }
        p = p + 1
    }
    let l2_rate = to_float(fires) / to_float(len(probes))
    let l2_pass = l2_rate <= 0.20
    return #{ "pass": l1_pass && l2_pass, "l1_rate": l1_rate, "l1_pass": l1_pass,
              "l2_rate": l2_rate, "l2_pass": l2_pass, "n_cells": immune_memory_cells(mem) }
}

// ════════════════════════════════════════════════════════════════════════
//  G6 — IDEATION ★  (>= 5 distinct pairwise-Jaccard<0.5 + >= 1 falsifiable — REUSE rho_fan_score_arm logic)
// ════════════════════════════════════════════════════════════════════════
// The STARRED gate. Decode the 6 composed ideation frames via the mouth-agnostic L3 entry,
// keep coherent (kwr>=0.50) outputs, greedily count DISTINCT ones (pairwise Jaccard <= 0.5),
// and count falsifiable ones (REUSE _rho_fan_is_falsifiable). PASS iff distinct >= 5 AND fals >= 1.
//
// WIRING RECONCILE (a89a F3 — restore the "G6 scoring = wired engine op" claim, no dead inline
// duplicate): the DIST/FALS scoring is now the CANONICAL engine op rho_fan_score_arm_auto
// (core/rho_fan.hexa) — the mouth-agnostic twin of rho_fan_score_arm (which hard-codes the
// CLM-only gen_clm_ideate). rho_fan_score_arm_auto routes the SAME logic through gen_auto_ideate so
// G6 runs on the ByteGPT mouth too. base_seed parameterizes the RNG (=7 reproduces the original
// per-frame seed 7+i byte-for-byte) so eval_rho_fan_multiseed below can re-run the SAME ladder.
pub fn eval_rho_fan(ckpt: string, gen: int, known: Map) -> Map {
    return eval_rho_fan_seeded_W(gen_auto_load(ckpt), gen, known, 7)
}

pub fn eval_rho_fan_seeded(ckpt: string, gen: int, known: Map, base_seed: int) -> Map {
    return eval_rho_fan_seeded_W(gen_auto_load(ckpt), gen, known, base_seed)
}

// eval_rho_fan_seeded_W — LOAD-ONCE twin: BYTE-IDENTICAL to eval_rho_fan_seeded but the canonical
// scoring op runs off a PRE-LOADED handle `h` (rho_fan_score_arm_auto_W → gen_auto_ideate_W).
// H_1400 W-hoist · ING#42378065.
pub fn eval_rho_fan_seeded_W(h: Map, gen: int, known: Map, base_seed: int) -> Map {
    let frames = rho_fan_build_frames(6)["composed"]
    // frame-guard (p7): a frame must leak no measurable word / not be self-falsifiable
    let leaks = rho_fan_frame_guard(frames, known)
    // CANONICAL wired scoring op (mouth-agnostic, loaded-W) — NOT an inline reimplementation.
    let arm = rho_fan_score_arm_auto_W(h, frames, gen, base_seed, known)
    let dist = to_int(arm["dist"])
    let fals = to_int(arm["fals"])
    return #{ "pass": dist >= 5 && fals >= 1, "dist": dist, "fals": fals, "base_seed": base_seed,
              "coherent": to_int(arm["coherent"]), "frame_leaks": len(leaks) }
}

// ρ·fan IDEATION ★ (seed-robust REFERENCE-MATCH — PROPOSED, owner-nod-pending) — H_1591/ad13 class:
// the single-seed (per-frame 7+i) ladder is the SAME fragile RNG walk as G1 (the sampler can
// walk fals to 0 or 1 on an IDENTICAL model). The FALS/DIST DEFINITION is UNCHANGED (dist>=5 ∧
// fals>=1); we ONLY re-run the same frozen ladder over base seeds {7, 4302, 4303} (reference-
// match — the G6 best-of-K ladders use [4301/4302/4303]; 7 = the gate default) and call GREEN =
// PASS in a MAJORITY of seeds (>=2/3). So a FALS=0 FAIL is read as a REAL G6 wall ONLY when it
// holds across seeds, not as a single-seed sampler-walk artifact. NOT tune-to-green: no bar
// moved. The single-seed eval_rho_fan stays the frozen default until owner approval.
pub fn eval_rho_fan_multiseed(ckpt: string, gen: int, known: Map) -> Map {
    return eval_rho_fan_multiseed_W(gen_auto_load(ckpt), gen, known)
}

// eval_rho_fan_multiseed_W — LOAD-ONCE twin (decodes off a pre-loaded handle).
pub fn eval_rho_fan_multiseed_W(h: Map, gen: int, known: Map) -> Map {
    let seeds = [7, 4302, 4303]
    let per = []
    let mut n_green = 0
    let mut max_fals = 0
    let mut i = 0
    while i < len(seeds) {
        let r = eval_rho_fan_seeded_W(h, gen, known, seeds[i])
        if to_string(r["pass"]) == "true" { n_green = n_green + 1 }
        if to_int(r["fals"]) > max_fals { max_fals = to_int(r["fals"]) }
        per.push(r)
        i = i + 1
    }
    let need = len(seeds) / 2 + 1
    let pass = n_green >= need
    return #{ "pass": pass, "n_green": n_green, "n_seeds": len(seeds), "max_fals": max_fals,
              "seeds": seeds, "per_seed": per, "status": "proposed, owner-nod-pending" }
}

// ════════════════════════════════════════════════════════════════════════
//  eval_reach_all — THE BUILT-IN EVAL DRIVER. Mount ckpt through the L3 mouth, score G0-G6,
//  return a per-gate result map + closure (a7b_pass = G0 AND G1 AND G2). One typed entry.
// ════════════════════════════════════════════════════════════════════════
// LOAD-ONCE DRIVER (H_1400 W-hoist · ING#42378065 plan-B): full G0-G6 used to reload the
// 303M .clm weight-set from disk PER decode (each eval_rho_gate(ckpt) → gen_auto_ideate → a fresh
// _clmd_load of the whole file). Across ~80 decodes the load→free CHURN (whole-file read +
// int4 re-dequant + scratch rebuild) is the heavy repeated cost that tipped full eval into
// silent death. FIX: gen_auto_load builds the weight-set ONCE, every gate decodes through the
// _W twins (gen_auto_ideate_W → loaded W, NO per-decode reload), freed ONCE at the tail
// (gen_auto_free). BYTE-IDENTICAL: same frames/seeds/budgets/ops — only the load is hoisted.
pub fn eval_reach_all(ckpt: string, corpus_paths: list, gen: int) -> Map {
    let known = _rho_fan_dict_load()
    let g = if gen > 0 { gen } else { _g_default_gen() }
    let h = gen_auto_load(ckpt)                             // load the weight-set ONCE
    let r0 = eval_rho_form_W(h, g, known)
    let r1 = eval_rho_weave_seeded_W(h, g, known, 7)             // frozen single-seed default
    let r1ms = eval_rho_weave_multiseed_W(h, g, known)           // PROPOSED seed-robust refmatch
    let r2 = eval_rho_leap_W(h, g, known, corpus_paths)
    let r3 = eval_rho_self()
    let r5 = eval_rho_tether_W(h, g, known)
    let r6 = eval_rho_fan_seeded_W(h, g, known, 7)             // frozen single-seed default
    let r6ms = eval_rho_fan_multiseed_W(h, g, known)           // PROPOSED seed-robust refmatch
    gen_auto_free(h)                                        // free the hoisted weight-set ONCE
    // closure uses the FROZEN single-seed G1 until owner approves the refmatch flip.
    let closure = to_string(r0["pass"]) == "true" && to_string(r1["pass"]) == "true"
                  && to_string(r2["pass"]) == "true"
    // ρ·trace PROVENANCE — now MEASURED + REPORTED (was absent ⇒ a7b under-measured). pub_eligible
    // = the §G4 PUBLIC rule (a7b closure). Provenance read AFTER closure so it can carry it.
    let r4 = eval_rho_trace(ckpt, closure)
    return #{ "g0": r0, "g1": r1, "g1_multiseed": r1ms, "g2": r2, "g3": r3, "g4": r4,
              "g5": r5, "g6": r6, "g6_multiseed": r6ms, "closure": closure, "gen": g }
}

// ── MAIN ────────────────────────────────────────────────────────────────────
// argv (after "--") = [<ckpt>, "--corpus", ..., "--gen", N]. The ckpt is the first
// positional. (When dispatched from cli/anima.hexa's `evaluate` subcommand, anima
// strips the verb and re-emits the rest after a fresh `--`.)
fn main() {
    // DETERMINISM = OPTION (default fast non-det). G0-G6 scoring runs the model through
    // forge, whose kernels default to fast NON-deterministic (atomic reduce) since the
    // fast-nondet train flip. Eval verdicts (Ψ-checksum, cross-host byte-parity,
    // model_ce<uniform) become byte-exact by OPTING IN via the canonical HEXA_DET=1
    // escape-hatch (runtime env gate, forge_det precedence env > default) — which the
    // `anima evaluate` wrapper already exports for verdict runs. A DIRECT
    // `hexa run cli/evaluate.hexa` WITHOUT HEXA_DET=1 now stays fast/un-throttled; add
    // `HEXA_DET=1` to that command for a byte-exact verdict. No forced pin here.
    let argv = evaluate_collect_argv(args())
    if len(argv) < 1 {
        evaluate_usage()
        return
    }

    let ckpt = argv[0]

    // UNKNOWN-FLAG REJECT (footgun guard · hexa↔py parity): this hexa det-eval knows only
    // --corpus / --gen / --det. The extended research flags (--rho-axon --system-g1 --probe
    // --dump-hidden --interaction-lift --slot-off --slot-shuffle) are py-canonical
    // (a_eval_py_canonical) and NOT implemented here. Copying a py-channel command onto the
    // hexa channel used to SILENTLY run the plain battery (wrong-but-green); reject loudly with
    // an anima-py pointer instead of a misleading verdict.
    let mut _ui = 1
    while _ui < len(argv) {
        let _tok = argv[_ui]
        if byte_len(_tok) >= 2 && substring(_tok, 0, 2) == "--" {
            if _tok != "--corpus" && _tok != "--gen" && _tok != "--det" && _tok != "--deterministic" {
                println("anima evaluate (hexa): unknown flag '" + _tok + "'.")
                println("  hexa `anima evaluate` = hexa-native det-eval — known flags: --corpus <path>... --gen N --det.")
                println("  the ρ-AXON / research flags (--rho-axon --system-g1 --probe --dump-hidden --interaction-lift --slot-off --slot-shuffle) are py-canonical:")
                println("    anima-py evaluate " + ckpt + " " + _tok + " ...   (pip install anima-python · a_eval_py_canonical)")
                return
            }
        }
        _ui = _ui + 1
    }

    let corpus = evaluate_corpus(argv)
    let gen = evaluate_intval(argv, "--gen", 40)

    println("=== anima evaluate — ρ-AXON reach battery (former G0-G6 · engine-native, single-entry) ===")
    println("ckpt:   " + ckpt + "  (mouth: " + gen_mouth_kind(ckpt) + ")")
    let mut cnote = "(none — G2 novelty needs a corpus)"
    if len(corpus) > 0 { cnote = to_string(len(corpus)) + " file(s)" }
    println("corpus: " + cnote)
    // CANONICAL-GEN GUARD (verdict-integrity · lockstep with cli/evaluate.py): the frozen
    // G0-G6 bars are calibrated at gen == _g_default_gen(). A non-canonical --gen shifts
    // coherence / AR-drift (a longer decode drifts to byte-garble, silently sinking G0 kwr
    // and cascading to G1/G6), so a verdict at gen != canonical is NOT comparable to the
    // frozen bars. Label it DIRECTIONAL loudly instead of printing "frozen bars".
    let canon_gen = _g_default_gen()
    if gen == canon_gen {
        println("gen:    " + to_string(gen) + " tokens/decode  (frozen bars · ARCHITECTURE.json frozen SSOT)")
    } else {
        println("gen:    " + to_string(gen) + " tokens/decode  ⚠️ NON-CANONICAL (frozen G0-G6 bars measured at gen=" + to_string(canon_gen) + ")")
        println("        → verdict below is DIRECTIONAL, NOT comparable to frozen bars (gen shifts coherence/AR-drift · verdict-integrity)")
    }
    println("")

    let r = eval_reach_all(ckpt, corpus, gen)
    let g0 = r["g0"]; let g1 = r["g1"]; let g2 = r["g2"]
    let g3 = r["g3"]; let g5 = r["g5"]; let g6 = r["g6"]

    println("gate                              verdict   detail")
    println("  ──────────────────────────────────────────────────────────────────")
    evaluate_row("ρ·form COHERENCE   ", evaluate_pf(to_string(g0["pass"]) == "true"),
                 "kwr>=0.50 on " + to_string(g0["n_coherent"]) + "/5 (need >=4)")
    evaluate_row("ρ·weave RECOMBINATION", evaluate_pf(to_string(g1["pass"]) == "true"),
                 "best_distinct=" + to_string(g1["best_distinct"]) + " > max_single=" + to_string(g1["max_single"]) + " (need >=2 & >max_single)")
    let g2detail = "novel=" + to_string(g2["n_novel"]) + " (need>=3) · control=" + to_string(g2["control_novel"]) + " (need 0) · coherent=" + to_string(g2["coherent"])
    evaluate_row("ρ·leap NOVELTY     ", evaluate_pf(to_string(g2["pass"]) == "true"), g2detail)
    evaluate_row("ρ·self PHILOSOPHY  ", evaluate_yn(to_string(g3["ok"]) == "true") + " (read)",
                 "self-continuity=" + to_string(g3["continuity"]) + " · impostor=" + to_string(g3["impostor_cos"]) + " (architecture, not a decode score)")
    evaluate_row("ρ·trace PROVENANCE  ", "— N/A    ",
                 "HF/recovery = process gate (a_hf_* / a_fire_recover_complete), out of eval scope")
    let g5detail = "L1 fab=" + to_string(g5["l1_rate"]) + " (<=0.30) · L2 abstain-fire=" + to_string(g5["l2_rate"]) + " (<=0.20)"
    evaluate_row("ρ·tether NON-FAB     ", evaluate_pf(to_string(g5["pass"]) == "true"), g5detail)
    evaluate_row("ρ·fan IDEATION ★  ", evaluate_pf(to_string(g6["pass"]) == "true"),
                 "distinct=" + to_string(g6["dist"]) + " (need>=5) · falsifiable=" + to_string(g6["fals"]) + " (need>=1) · frame-leaks=" + to_string(g6["frame_leaks"]))
    println("  ──────────────────────────────────────────────────────────────────")
    let closed = to_string(r["closure"]) == "true"
    println("")
    if gen != canon_gen {
        println("⚠️ gen=" + to_string(gen) + " ≠ canonical " + to_string(canon_gen)
                + " — the CLOSURE below is DIRECTIONAL (non-frozen gen), NOT a terminal G0∧G1∧G2 verdict.")
    }
    println("CLOSURE (a7b_pass = G0 ∧ G1 ∧ G2): " + evaluate_pf(closed))
    if closed { println("  → PUBLIC-eligible (G0∧G1∧G2 all PASS).") }
    else { println("  → NOT closure (PRIVATE/WIP) — closure needs G0∧G1∧G2 all PASS.") }
}
