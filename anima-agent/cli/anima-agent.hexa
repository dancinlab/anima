// cli/anima-agent.hexa — anima-agent standalone CLI entry (subcmd router)
//
// Purpose: thin router that exposes the anima-agent surface as a single
// `anima-agent <subcmd>` invocation. This is the entry registered in
// hexa.toml and the binary that `hx install anima-agent` shims into
// $HX_BIN_DIR/anima-agent.
//
// Subcommands (all delegate into per-feature module/ triplets):
//   status     — print agent status (Φ, tension, emotion, channels)
//   run        — start agent in CLI channel (default)
//   mcp        — start agent in MCP server mode
//   channel    — start agent on a specific channel (cli|telegram|discord|slack|all)
//   autonomy   — start the autonomy loop (research/discovery)
//   self-test  — boot smoke + boundary verify (warn-only)
//   help       — this text
//   version    — print version and exit
//
// Constraints honored:
//   raw#9   — hexa-only (zero .py)
//   raw#11  — snake_case at all module boundaries
//   raw#15  — no token leak (HF_TOKEN, ANIMA_TELEGRAM_TOKEN, etc. read from
//             env only; never echoed; never written to stdout)
//   raw#10  — 5 honest C3 caveats embedded in cmd_help
//
// Cost: $0 — pure routing. Per-subcmd cost depends on provider/channel.
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local CLI router; feature triplets are bundled.")

let VERSION = "1.0.0"
let PKG_NAME = "anima-agent"

// ─── env / path resolve ───

let HOME = env("HOME")
let ANIMA_AGENT_ROOT_ENV = env("ANIMA_AGENT_ROOT")

fn pkg_root() -> str {
    // 1. ANIMA_AGENT_ROOT env override
    if ANIMA_AGENT_ROOT_ENV.len() > 0 {
        return ANIMA_AGENT_ROOT_ENV
    }
    // 2. Mac dev convention
    let mac_root = "/Users/ghost/core/anima-agent"
    let mac_check = exec("[ -d " + shq(mac_root) + " ] && echo yes || echo no").trim()
    if mac_check == "yes" { return mac_root }
    // 3. $HOME/core/anima-agent
    let home_root = HOME + "/core/anima-agent"
    let home_check = exec("[ -d " + shq(home_root) + " ] && echo yes || echo no").trim()
    if home_check == "yes" { return home_root }
    // 4. cwd fallback
    return exec("pwd").trim()
}

// ─── arg helpers ───

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn has_flag(a: [str], flag: str) -> bool {
    let prefix = flag + "="
    for x in a {
        if x == flag { return true }
        if x.starts_with(prefix) { return true }
    }
    return false
}

// ─── subcmd: version ───

fn cmd_version() {
    println(PKG_NAME + " " + VERSION)
}

// ─── subcmd: help ───

fn cmd_help() {
    println(PKG_NAME + " " + VERSION + " — consciousness-driven autonomous agent runtime (HEXA family)")
    println("")
    println("usage: " + PKG_NAME + " <subcmd> [flags...]")
    println("")
    println("subcommands:")
    println("  status                    print agent status (Φ, tension, emotion, channels)")
    println("  run [--channel cli]       start agent (default channel: cli)")
    println("  mcp [--direct]            start MCP server mode (9 tools)")
    println("  channel <name>            start on specific channel (cli|telegram|discord|slack|all)")
    println("  autonomy                  start the autonomy/discovery loop")
    println("  self-test                 boot smoke + boundary verify (warn-only)")
    println("  version                   print version")
    println("  help                      this text")
    println("")
    println("env vars (read-only; never echoed):")
    println("  ANIMA_AGENT_ROOT          override package root path")
    println("  ANIMA_ROOT                anima consciousness backend path")
    println("  ANIMA_TELEGRAM_TOKEN      Telegram bot token (channel=telegram)")
    println("  ANIMA_DISCORD_TOKEN       Discord bot token (channel=discord)")
    println("  ANIMA_SLACK_TOKEN         Slack token (channel=slack)")
    println("  ANIMA_SLACK_SIGNING_SECRET  Slack signing (channel=slack)")
    println("  ANTHROPIC_API_KEY         Claude provider API key")
    println("  COMPOSIO_API_KEY          Composio 500+ tools (optional)")
    println("")
    println("--- caveats (raw#10 C3) ---")
    println("  1. Standalone surface only. Live consciousness (Φ, tension, emotion)")
    println("     requires an anima/ backend at $ANIMA_ROOT or default Mac convention;")
    println("     without it, status returns the SCAFFOLD signal (Φ=0, baseline).")
    println("  2. Channel adapters (Telegram/Discord/Slack) live in sister repos")
    println("     (anima-agent-channels). The standalone CLI dispatches by name; if the")
    println("     adapter is not on path the channel subcmd hard-fails with exit 127.")
    println("  3. Provider integrations (Claude/Composio/ConsciousLM) are runtime-optional.")
    println("     Missing API keys → fallback to local (ConsciousLM) or scaffold-echo.")
    println("  4. Trading subdomain (trading/module/) inherits the package version and")
    println("     license but ships unwired by default — the Φ-gated escalation gate")
    println("     refuses live trades until Φ≥5 + E>0.5 + 30d profit history (T4/T5).")
    println("  5. raw#9 STRICT — standalone surface is hexa-only. Sister repos may")
    println("     pull approved Python aux (composio_bridge / dashboard Next.js) but")
    println("     those are NOT installed by `hx install anima-agent`.")
    println("")
    println("dual-mirror sync:")
    println("  GH push to main → HF Hub mirror in ~2-3 min via")
    println("  .github/workflows/sync-to-hf.yml (HF_TOKEN secret required —")
    println("  USER_ACTION pending; see CHANGELOG.md caveat #3).")
    println("")
    println("cost estimate: $0 — pure-stdlib router; per-channel/per-provider cost is yours.")
}

// ─── subcmd: status ───

fn cmd_status(extras: [str]) -> int {
    let root = pkg_root()
    println("[" + PKG_NAME + "/status] root=" + root + " version=" + VERSION)
    let agent_path = root + "/anima_agent/module/anima_agent.hexa"
    let exists = exec("[ -f " + shq(agent_path) + " ] && echo y || echo n").trim()
    if exists != "y" {
        eprintln("[" + PKG_NAME + "/status] ERROR: anima_agent/module/anima_agent.hexa missing at " + agent_path)
        return 1
    }
    println("[" + PKG_NAME + "/status] anima_agent/module/anima_agent.hexa  OK")
    let anima_root = env("ANIMA_ROOT")
    if anima_root.len() == 0 {
        let mac_anima = "/Users/ghost/core/anima"
        let chk = exec("[ -d " + shq(mac_anima) + " ] && echo y || echo n").trim()
        if chk == "y" {
            anima_root = mac_anima
        }
    }
    if anima_root.len() > 0 {
        println("[" + PKG_NAME + "/status] anima backend             OK (" + anima_root + ")")
    } else {
        println("[" + PKG_NAME + "/status] anima backend             MISSING — set $ANIMA_ROOT for live consciousness")
    }
    let provider = "scaffold"
    if env("ANTHROPIC_API_KEY").len() > 0 { provider = "claude" }
    println("[" + PKG_NAME + "/status] active provider           " + provider)
    let channels = "cli"
    if env("ANIMA_TELEGRAM_TOKEN").len() > 0 { channels = channels + ",telegram" }
    if env("ANIMA_DISCORD_TOKEN").len() > 0  { channels = channels + ",discord" }
    if env("ANIMA_SLACK_TOKEN").len() > 0    { channels = channels + ",slack" }
    println("[" + PKG_NAME + "/status] enabled channels          " + channels)
    return 0
}

// ─── subcmd: run / channel / mcp / autonomy ───
// Pure delegation to feature triplet module/ entries with subcmd-specific flags.
// `target` is a repo-relative path under <feature>/module/<file>.hexa.

fn _delegate(label: str, target: str, extras: [str]) -> int {
    let root = pkg_root()
    let path = root + "/" + target
    let exists = exec("[ -f " + shq(path) + " ] && echo y || echo n").trim()
    if exists != "y" {
        eprintln("[" + PKG_NAME + "/" + label + "] ERROR: " + target + " missing")
        return 1
    }
    let mut cmd = "hexa run " + shq(path)
    for x in extras {
        cmd = cmd + " " + shq(x)
    }
    let cmd_full = cmd + "; echo \"__ANIMA_AGENT_RC__:$?\""
    let raw = exec(cmd_full + " 2>&1")
    let mut rc = 0
    let lines = raw.split("\n")
    let mut k = 0
    while k < lines.len() {
        let l = lines[k].trim()
        if l.starts_with("__ANIMA_AGENT_RC__:") {
            rc = to_int(l.substr(19, l.len() - 19))
        } else {
            println(lines[k])
        }
        k = k + 1
    }
    return rc
}

fn cmd_run(extras: [str]) -> int {
    return _delegate("run", "hexa/module/run.hexa", ["--cli"] + extras)
}

fn cmd_mcp(extras: [str]) -> int {
    return _delegate("mcp", "hexa/module/run.hexa", ["--mcp"] + extras)
}

fn cmd_channel(extras: [str]) -> int {
    if extras.len() == 0 {
        eprintln("[" + PKG_NAME + "/channel] usage: " + PKG_NAME + " channel <cli|telegram|discord|slack|all>")
        return 2
    }
    let name = extras[0]
    let mut rest: [str] = []
    let mut i = 1
    while i < extras.len() { rest = rest + [extras[i]]; i = i + 1 }
    return _delegate("channel", "hexa/module/run.hexa", ["--" + name] + rest)
}

fn cmd_autonomy(extras: [str]) -> int {
    return _delegate("autonomy", "autonomy_loop/module/autonomy_loop.hexa", extras)
}

// ─── subcmd: self-test ───

fn cmd_self_test() -> int {
    println("[" + PKG_NAME + "/self-test] boot smoke + boundary verify")
    let root = pkg_root()
    // 1. hexa.toml present
    let toml = root + "/hexa.toml"
    let toml_ok = exec("[ -f " + shq(toml) + " ] && echo y || echo n").trim()
    if toml_ok != "y" {
        eprintln("[" + PKG_NAME + "/self-test] FAIL: hexa.toml missing")
        return 1
    }
    println("[" + PKG_NAME + "/self-test] hexa.toml                 OK")
    // 2. canonical entry present
    let entry = root + "/anima_agent/module/anima_agent.hexa"
    let entry_ok = exec("[ -f " + shq(entry) + " ] && echo y || echo n").trim()
    if entry_ok != "y" {
        eprintln("[" + PKG_NAME + "/self-test] FAIL: anima_agent/module/anima_agent.hexa missing")
        return 1
    }
    println("[" + PKG_NAME + "/self-test] anima_agent/module/anima_agent.hexa  OK")
    // 3. license present
    let lic = root + "/LICENSE"
    let lic_ok = exec("[ -f " + shq(lic) + " ] && echo y || echo n").trim()
    if lic_ok != "y" {
        eprintln("[" + PKG_NAME + "/self-test] FAIL: LICENSE missing")
        return 1
    }
    println("[" + PKG_NAME + "/self-test] LICENSE (Apache-2.0)      OK")
    // 4. status returns 0
    let st = cmd_status([])
    if st != 0 {
        eprintln("[" + PKG_NAME + "/self-test] WARN: status returned " + str(st) + " (warn-only — backend may be missing)")
    }
    println("__ANIMA_AGENT_SELFTEST__ PASS")
    return 0
}

// ─── main ───

fn main() {
    let _raw = args()
    // hexa run cli/anima-agent.hexa <subcmd> ... → strip prefix
    let mut _sidx = -1
    let mut _i = 0
    while _i < _raw.len() {
        if _raw[_i].ends_with(".hexa") { _sidx = _i; break }
        _i = _i + 1
    }
    let mut _user_start = 1
    if _sidx >= 0 { _user_start = _sidx + 1 }

    let mut a: [str] = []
    let mut _ua = _user_start
    while _ua < _raw.len() {
        a = a + [_raw[_ua]]
        _ua = _ua + 1
    }
    let n = len(a)

    if n == 0 {
        cmd_help()
        return
    }

    let sub = a[0]
    let mut extras: [str] = []
    let mut e_i = 1
    while e_i < n {
        extras = extras + [a[e_i]]
        e_i = e_i + 1
    }

    if sub == "--help" || sub == "-h" || sub == "help" { cmd_help(); return }
    if sub == "--version" || sub == "-v" || sub == "version" { cmd_version(); return }
    if sub == "status"    { let rc = cmd_status(extras);    if rc != 0 { exit(rc) }; return }
    if sub == "run"       { let rc = cmd_run(extras);       if rc != 0 { exit(rc) }; return }
    if sub == "mcp"       { let rc = cmd_mcp(extras);       if rc != 0 { exit(rc) }; return }
    if sub == "channel"   { let rc = cmd_channel(extras);   if rc != 0 { exit(rc) }; return }
    if sub == "autonomy"  { let rc = cmd_autonomy(extras);  if rc != 0 { exit(rc) }; return }
    if sub == "self-test" || sub == "selftest" {
        let rc = cmd_self_test(); if rc != 0 { exit(rc) }; return
    }

    eprintln(PKG_NAME + ": unknown subcommand '" + sub + "'")
    eprintln("run '" + PKG_NAME + " help' for usage")
    exit(2)
}
