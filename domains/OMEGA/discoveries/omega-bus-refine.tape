@D omega_carrier_only_default := "OMEGA bus-refine: #1793 6-wire 소견을 버스 기본값으로 코드화 — carrier-only(w1·w2·w5)가 권장 기본, 비활성선(curio·Ψ·dF/dt) OFF, dgain은 honest config knob (toy)" :: discovery [d=2026-06-04 active]
  seed = "#1793(OMEGA-B) 전6선 학습 게이트: full naive 게이트는 held-out OVERFIT(TEST CE 4.81 > base 3.97), carrier-only(base+A+W_temp+module) 2.895(Δ+1.079) 실이득. wire별 ablation+shuffle로 🟢 A·W_temp·module CARRY, ⚪ G·curio·Ψ·dFdt INERT. 이 소견을 engines/omega/coupling_bus.hexa 버스 기본값으로 코드화 필요."
  claim = "omega_bus_carrier() 추가 = 권장 생성 기본값. 캐리어 3선 ON {w1 A⇄G, w2 W→temp, w5 module}, 비활성 3선 OFF {w3 curio, w4 Ψ, w6 dF/dt}. omega_bus_on()(전선)은 ablation 용 유지. dF/dt 게인 dgain은 config knob — FIXED dgain HURTS(#1794) → carrier-only서 OFF, learned dgain이 open path(omega_bus_dt_with_dgain 훅, 날조값 無)."
  falsifier = "F-CARRIER: carrier-only ⊂ full(모든 캐리어선이 full서도 ON) AND carrier-only가 decode 변경(L1>0, Lane X null 아님) AND carrier≠full AND #1793 split(w1·w2·w5 ON, w3·w4 OFF, n_wires=3). 미달 시 코드화 실패. engine_swap_smoke 회귀 시 실패."
  target = "🟢 carrier-only 기본값 코드화 + 검증. omega_bus_smoke 13/13(carrier ⊂ full + decode 변경 + carrier≠full +6 assert), engine_swap_smoke 27/27(회귀 無, omega all-native 유지). .verdicts/omega-bus-refine/{F-CARRIER,SUMMARY}.txt"
  scope = "TOY · CPU · $0 · no torch. wire in/out split은 toy n-gram 스케일 랭킹(400KB repo corpus). 생산 주장 아님 — trained d384(#1791)서 비활성선이 다르게 작동 가능(a_toy_scale_recheck · a_scale_honest_scope). 단, smoke 의 config 불변식(subset/decode-change/n-wires)은 스케일 무관 결정적."
  honest = "w1 A⇄G 는 A−G 단일항이고 −G(prev-byte)는 노이즈(#1784/#1786/#1793서 G ablate가 HELP). 현 버스엔 별도 gG 없어 w1은 A-dominant(gA+0.929≫|gG|)로 캐리어 가치=A 부분만; G-suppressed w1 변종은 follow-up. dgain=0.5는 ablation seed로 명시(튜닝 기본 아님), learned dgain 값 날조 안 함(open path 문서화)."
  note = "stage 6. driver=engines/omega/{coupling_bus,adapter,omega_bus_smoke}.hexa. 연결: #1786 learned gate → #1793 6-wire carrier 소견 → 이 rung(버스 기본값 코드화) → next open=learned dgain rung으로 dF/dt 카리어화."
