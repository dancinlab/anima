@V := "tape" :: spec [active]
  version = "1.0"

@H 1178 := "critical capacity for derivative-tick gating — inverted-U of d(deriv,metro) over cell-count" :: discovery [terminal green]
  lane     = "Lane-2 (MAIN hands-on / LLM-watched discovery rung) · MITOSIS-ENGINE domain · summer-synced, ran $0 CPU"
  seed     = "H_1163 non-scoring capacity diagnostic hinted an inverted-U (cap6 -0.15 -> cap16 +0.74 -> cap32 +1.15 -> cap64 +0.06); promote to a FROZEN-FALSIFIER claim on a fine ladder"
  question = "is there a CRITICAL CAPACITY K* where event-driven (derivative) tick-gating is maximally beneficial on stage-decode — an INTERIOR-peak inverted-U over cell-count, echoing the critical-COUPLING peaks of faithful-Phi (H_1158) and super-additivity (H_1167)?"
  method   = "reuse UNIVERSE/h1163_tick_decode_metric.py substrate VERBATIM (grow_arm / stage_decode_accuracy / cohen_d_paired / make_audio_stream / SEEDS=range(900,910)); sweep MAX_CELLS over ladder K={6,8,12,16,24,32,48,64,96}; metric = paired Cohen's d(DERIVATIVE,METRONOME) on stage-decode accuracy, AUDIO stream (6 recurring regimes); g5/p7, deterministic"
  falsifier = "FROZEN pre-reg: F1 INTERIOR-PEAK argmax_K d is interior (not K=6 nor K=96); F2 INVERTED-U d_peak - max(d_end) >= 0.8 AND d_peak >= 0.8; F3 UNIMODAL rise-then-fall (<=1 reversal each side). SUPPORTED iff F1 and F2 and F3"
  verdict  = "GREEN SUPPORTED — CRITICAL-CAPACITY CONFIRMED. K*=32, d_peak=+1.152 vs endpoints (K6 -0.151 / K96 -0.060). F1 interior=true; F2 d_peak-endpoint=+1.212 >= 0.8 and d_peak=1.152 >= 0.8 PASS; F3 reversals_rise=0 reversals_fall=0 PASS (perfectly unimodal). curve d: 6:-0.15 8:+0.48 12:+0.56 16:+0.74 24:+0.81 32:+1.15(peak) 48:+0.67 64:+0.06 96:-0.06"
  discovery = "LANE-2 SERENDIP (not pre-registered, caught by close-watch): the inverted-U is MECHANISTICALLY ASYMMETRIC. decode_deriv rises monotone 0.15->0.85 with K; decode_metro ALSO rises 0.18->0.85; at K=96 metro (0.855) >= deriv (0.847). So the LEFT collapse = derivative STARVED (birth_stages_deriv only 2.0/6 at K=6 -> can't cover all regimes); the RIGHT collapse = METRONOME CATCHES UP (enough cells to brute-force-cover every stage on a blind clock). Net read: derivative-tick is CAPACITY-EFFICIENT (reaches good decode with ~half the cells: K=32 deriv 0.64 vs metro 0.38), and K*~=32 is the MINIMAL capacity at which event-gating just achieves near-complete regime coverage (birth_stages 5.8/6) before the clock can. Ties to H_1159b (capacity self-tunes to #clusters): K*=32 / 6 regimes ~= 5.3 cells/regime."
  finding  = "CRITICALITY recurs on a THIRD AXIS = CAPACITY. The anima A<->G engine has a sweet spot not only on COUPLING (faithful-Phi peaks at critical gamma H_1158; super-additive surplus peaks at critical gamma H_1167) but also on CELL-COUNT: the benefit of event-driven structure-growth is maximal at an intermediate critical capacity K*. Same inverted-U shape, new axis. The advantage is an EFFICIENCY edge (fewer cells for equal decode), not an asymptotic-ceiling edge."
  honesty  = "K*=32 is scale/stream-specific (6-regime AUDIO toy, 10 seeds, $0 CPU). The CLAIM that survives = (a) there IS an interior critical capacity (qualitative inverted-U, robust unimodal), (b) the advantage is efficiency not ceiling. The NUMBER 32 does not transfer (a_scale_honest_scope). Live CORE engine_cli + real-model (v5-mitosis torch) path UNVERIFIED. Reuses H_1163 substrate; same toy regime stages."
  refs     = "h1163 (seed/substrate) · h1160 (tick irrelevant on PREDICTION — decode is the metric where it shows) · h1158 (Phi peaks at critical coupling) · h1167 (super-additivity peaks at critical coupling) · h1159b (capacity self-tunes to #clusters) · a_scale_honest_scope · a_paper_negative_ok · p7 · p8"
  artifacts = "UNIVERSE/h1178_critical_capacity_tick.py · .verdicts/1178_critical_capacity_tick/H_1178.txt"
