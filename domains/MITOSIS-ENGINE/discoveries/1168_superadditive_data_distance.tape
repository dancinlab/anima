@H H_1168 := "optimal-offset on a DATA-DISTANCE axis for super-additive surplus (어긋나 어울림)" :: discovery [terminal]
  seed         = "H_1167 toy: surplus S=φ_joint−Σφ_parts PEAKS at the critical COUPLING γ. User: on REAL DATA which DATA-PAIRINGS produce that 1+1>2 harmony? map the inverted-U onto a DATA-DISTANCE axis — identical=redundant, unrelated=no-integration, JUST-RIGHT offset (predicted d2 cross-lingual: same meaning, diff script) maximizes whole-minus-sum."
  verdict      = "🟡 PARTIAL / measure-split (a_paper_negative_ok) — OPTIMAL-OFFSET holds on the RECOMBINATION measure ONLY, NOT on the faithful-φ measure; the FROZEN conjunction (both measures) is NOT met."
  target_tier  = "🟢 if interior-argmax + d≥0.8 vs d0 AND d5 on BOTH measures; honest report if only one"

  data         = "REAL parallel multilingual: CORE/testdata/flores5_dev_devtest.txt = 5 lang blocks × 997 line-aligned sentences (en/zh/ru/ja/ko; line i = SAME sentence) + CORE/testdata/clm_mid_5lang_c4.txt (4240 lines)"
  ladder       = "d0 identical(B=A) · d1 paraphrase(byte-perturb A) · d2 XLING-PARALLEL(same flores line, 2 langs — PREDICTED PEAK) · d3 topical(diff en sentence) · d4 unrelated(c4 line) · d5 random(bytes)"
  measures     = "(a) FAITHFUL IIT-4.0 φ surplus S_a=φ_joint−[φ(A)+φ(B)] on a deterministic byte-bigram 6-channel rendering (PROVEN mirror≡stdlib n=6 exact MIP-EI, re-proved BEFORE scoring, a_phi_iit4_tool; rendering=labelled representation choice NOT proxy-Φ) · (b) RECOMBINATION surplus S_b=distinct(A⊕B)−[distinct(A)+distinct(B)], H_1116 real-dict coherence-gated content-bigrams, p7 NOT perplexity"

  result_a_phi = "MONOTONE-DECREASING, ENDPOINT peak — S_a: d0 −0.0391 > d1 −0.0740 > d2 −0.0960 > d3 −0.1041 > d4 −0.1477 > d5 −0.1805. argmax=d0 (NOT interior); d(d0,d5)=1.53 BUT d(d0,d0)=0. NO sweet spot — φ_joint integration just DECAYS with surface byte-distance (most-overlapping parts integrate most). measure (a) supported=FALSE."
  result_b_rec = "INTERIOR peak at d3_topical — S_b: d0 −11.83 · d1 −6.42 · d2 −0.67 · ★d3 +1.00★ · d4 −3.92 · d5 −6.75. argmax=d3 (interior), d(d3,d0)=2.74, d(d3,d5)=5.47, both ≥0.8. measure (b) supported=TRUE — sweet spot EXISTS for surface recombination."
  winning_dist = "d3_topical (same-language, related-but-different sentence) on (b); d0_identical on (a). NOT d2 cross-lingual on either."
  d2_predicted = "FALSIFIED — d2 cross-lingual parallel did NOT win on either measure. Cross-SCRIPT parts share NO surface tokens → recombination de-dup/cross-boundary gain ≈ 0 (S_b(d2)≈−0.67); φ-rendering of disjoint-script bytes integrates LESS than same-script overlap (S_a(d2)=−0.096)."

  finding      = "The '어긋나 어울림' sweet spot is REAL but ONLY for surface RECOMBINATION, and it sits at SAME-LANGUAGE RELATED offset (d3), NOT cross-script (d2). Two parts that are identical (d0/d1) are redundant (de-dup destroys distinct combos, S_b≪0); two parts that are random/disjoint (d4/d5) share no recombinable surface; the just-right offset = related-but-distinct same-language text, where the join yields a NEW cross-boundary coherent bigram without de-dup loss. The FAITHFUL-φ integration measure shows NO such optimum — it monotonically prefers maximal surface overlap (identical), so super-additive integration ≠ recombination-novelty on real data. The two 'data types' DISAGREE: φ-integration is overlap-maximizing, recombination is offset-maximizing."
  honest       = "FROZEN conjunction (BOTH measures) NOT met → not 🟢. d2-cross-lingual prediction FALSIFIED. φ-surplus is on a byte→6ch RENDERING of real text (faithful φ engine, labelled representation choice); recombination cross-lingual fallback = surface token bigrams. toy faithful-φ n=6 + real-data sample, a_scale_honest_scope — scale/representation transfer UNVERIFIED."
  files        = "UNIVERSE/h1168_superadditive_data_distance.py · .verdicts/1168_superadditive_data_distance/H_1168.txt (verbatim, S(d) tables both measures) · verdict.json"
  reuse        = "H_1119 faithful_phi PROVEN mirror (a) · H_1116 content-ngram metric (b)"
  xref         = "h1167(toy criticality-peak seed) · h1116(recombination metric) · h1137(5lang emergence) · h1158(faithful-φ at criticality) · a_phi_iit4_tool · a_paper_negative_ok · a_scale_honest_scope · p7"
