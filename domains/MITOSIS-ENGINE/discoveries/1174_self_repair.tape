@V := "tape" :: spec [active]
  version = "1.0"

@H 1174 := "SELF-REPAIR — does damage->repair maintain function under sustained perturbation better than homeostasis alone? (life-criterion MISSING #4: self-repair)" :: universe [🟢 REPAIR-HELPS — terminal, both frozen clauses PASS]
  seed         = "Audit gap: homeostasis (SOC/Psi=1/2, H_931/1126) keeps the REGIME stable but does not REPAIR damaged components. Life repairs damage (DNA repair, wound healing). Distinct from homeostasis."
  substrate    = "toy $0 CPU 12 seeds. REUSE h1159b cells; INJECT damage = perturb a fraction f=0.30 of cell centroids each step (gaussian kick mag 5-6); REPAIR rule = nudge damaged cells back toward their RECENT assignment manifold (running-mean of recently-won points, repair_LR=0.30). Compare REPAIR vs HOMEOSTASIS-ONLY (online LR on the won cell only, no repair) under the IDENTICAL damage (shared RNG draw)."
  method       = "FROZEN FALSIFIER (pre-reg, VERBATIM): 🟢 REPAIR-HELPS iff under sustained damage the repair arm holds lower error than homeostasis-only (Cohen's d>=0.8) AND recovers toward pre-damage error after a damage burst. 🔴 if repair ~= homeostasis (the regime self-heals already; repair is redundant) (a_paper_negative_ok). CLAUSE-A=sustained d>=0.8; CLAUSE-B=burst-then-recover (frac_recovered>=0.8 within +20% of pre-burst baseline in 400 steps AND post-burst d>=0.8 vs homeo)."
  result       = "🟢 SUPPORTED — both clauses PASS. CLAUSE-A sustained: repair_err=12.48 vs homeo_err=29.25, Cohen's d=22.51 (>=0.8). CLAUSE-B burst-recovery: frac_recovered=0.92 (11/12 seeds return within +20% of pre-burst baseline, mean 124/400 steps), post-burst repair_err=6.13 vs homeo_err=10.25, d=3.26 (>=0.8)."
  audit        = "Homeostasis-only is NOT a strawman: clean no-damage err=2.95; after burst homeostasis PARTIALLY self-heals (14.65->9.54) but does NOT return to the 2.95 baseline in-window — stays damaged at ~9.54, while repair restores to ~6.13 in ~124 steps. The SOC/online-update regime self-heals slowly+incompletely; active repair is a DISTINCT function-maintaining mechanism, not redundant (life-criterion #4 PRESENT)."
  verdict_tier = "🟢 REPAIR-HELPS (toy $0 12 seeds, deterministic; reuses h1159b; separates repair from homeostasis)"
  scope        = "toy; prototype-cell PROXY for the CORE cell substrate; live engine + scale UNVERIFIED (a_scale_honest_scope). p7 (real assignment error, not perplexity)."
  artifact     = "UNIVERSE/h1174_self_repair.py · .verdicts/1174_self_repair/H_1174.txt"
  xref         = "h931_self_organized_criticality · 1126_psi_stability · h1159b_mitosis_capacity_self_tuning · h1153_criticality_branching"
