<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anima.self_monitor</string>

    <!--
        W1 anima-self Φ cron-tick threshold monitor (Phase 6 trip-wire).

        Polls state/proposals/meta/cycle_log.jsonl hourly, counts unique
        cycle_done events, and when count crosses N_THRESHOLD=20 emits a
        single idempotent alert into state/anima_self_monitor_alert.jsonl
        with the W1 Phase 6 rerun spec (mod-1024 + W=5/7/20 cross-check).

        SSOT:        docs/anima_self_monitor_cron_2026_05_02.md
        Tool:        tool/anima_self_monitor.hexa
        Race iso:    state/anima_self_monitor_cron_2026_05_02/

        StartInterval = 3600s (hourly). Median inter-tick = 12h, so the
        polling gap is well below the signal granularity. Cost ≈ 0.

        Activation (manual — no auto-bootstrap, raw#83 cron rationale):
          1) cp config/launchd/com.anima.self_monitor.plist ~/Library/LaunchAgents/
          2) launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.anima.self_monitor.plist
          3) launchctl enable gui/$UID/com.anima.self_monitor
          4) (optional kick) launchctl kickstart -k gui/$UID/com.anima.self_monitor

        Tear-down:
          launchctl bootout gui/$UID/com.anima.self_monitor
          rm ~/Library/LaunchAgents/com.anima.self_monitor.plist

        Output:
          state/anima_self_monitor_alert.jsonl
            { ts, schema, event:'w1_phase_6_trigger', n_ticks, threshold,
              last_cycle_ts, rerun_spec:{modulus,windows,expected_outcomes} }
          state/anima_self_monitor_cron_2026_05_02/last_check.json
          state/anima_self_monitor_cron_2026_05_02/last_alert.json   (idempotency)
          logs/anima_self_monitor.out.log
          logs/anima_self_monitor.err.log
    -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/ghost/core/anima &amp;&amp; /Users/ghost/.hx/bin/hexa run tool/anima_self_monitor.hexa --check 2&gt;&amp;1 || (TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; printf '{"ts":"%s","event":"hexa_unavailable_fallback","mode":"python_direct"}\n' "$TS" &gt;&gt; /Users/ghost/core/anima/state/anima_self_monitor_cron_2026_05_02/fallback.jsonl; cd /Users/ghost/core/anima &amp;&amp; python3 /tmp/anima_self_monitor_helper.hexa_tmp check 2&gt;/dev/null || true)</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ghost/core/anima</string>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/ghost/core/anima/logs/anima_self_monitor.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ghost/core/anima/logs/anima_self_monitor.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
