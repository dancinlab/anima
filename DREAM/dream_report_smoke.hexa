// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_report_smoke.hexa — M4 invariant smoke (2026-05-28)
//
// 정체: dream_report.hexa 의 4 pub primitives 가 wake transition · narrative
//      summary · .kosmos anchor stub · emit-free carry invariants 를 모두
//      만족하는지 검증.
//
// Invariants (6):
//   I1: dr_collect_replay_log({"replay_log": [...]}) 길이 == snapshot_count
//   I2: dr_summarize([]) startswith "DREAM rehearsal session: 0"
//       AND dr_summarize(non-empty) contains "emit-free"
//   I3: dr_wake_transition_report total_emits == 0 (emit-free carry)
//       AND is_wake_up == true for (N3 → WAKE) AND (REM → WAKE)
//       AND is_wake_up == false for (WAKE → N1)
//   I4: dr_kosmos_persist_dream.tension5 len == 5
//       AND anchor_kind == "dream_report"
//       AND wired_to_kosmos_io == false (M4 stub)
//   I5: empty session → report total_emits == 0 (empty edge case)
//   I6: report_kind == "dream_report_m4" 항상
// ════════════════════════════════════════════════════════════════════════

use "DREAM/dream_report"

fn main() {
    println("=== DREAM/dream_report_smoke ===")

    // ── Setup: synthetic replay session ───────────────────────────────────
    let rec_a = #{
        "ctx_tokens":     [10, 20, 30],
        "ctx_len":        3,
        "source_tick":    85,
        "source_index":   0,
        "emit_count":     0,
        "rehearsal_kind": "internal_silent",
    }
    let rec_b = #{
        "ctx_tokens":     [40, 50],
        "ctx_len":        2,
        "source_tick":    87,
        "source_index":   1,
        "emit_count":     0,
        "rehearsal_kind": "internal_silent",
    }
    let session_full = #{
        "snapshot_count": 2,
        "replay_log":     [rec_a, rec_b],
        "total_emits":    0,
        "session_kind":   "emit_free_rehearsal",
    }
    let session_empty = #{
        "snapshot_count": 0,
        "replay_log":     [],
        "total_emits":    0,
        "session_kind":   "emit_free_rehearsal",
    }

    // ── I1: dr_collect_replay_log length == snapshot_count ────────────────
    let log = dr_collect_replay_log(session_full)
    let i1 = len(log) == session_full["snapshot_count"]

    // ── I2: dr_summarize (empty + non-empty) ──────────────────────────────
    let s_empty = dr_summarize([])
    let s_full = dr_summarize(log)
    // empty summary startswith "DREAM rehearsal session: 0"
    let empty_ok = str_contains(s_empty, "0 snapshots")
    // non-empty has emit-free signal
    let full_ok = str_contains(s_full, "emit-free")
    let i2 = empty_ok && full_ok

    // ── I3: wake_transition_report (3 transition variants) ────────────────
    let rep_n3_wake = dr_wake_transition_report("N3", "WAKE", session_full)
    let rep_rem_wake = dr_wake_transition_report("REM", "WAKE", session_full)
    let rep_wake_n1 = dr_wake_transition_report("WAKE", "N1", session_full)
    let n3_ok = rep_n3_wake["is_wake_up"] == true
    let rem_ok = rep_rem_wake["is_wake_up"] == true
    let wake_n1_ok = rep_wake_n1["is_wake_up"] == false
    let emits_ok = (rep_n3_wake["total_emits"] == 0) && (rep_rem_wake["total_emits"] == 0)
    let i3 = n3_ok && rem_ok && wake_n1_ok && emits_ok

    // ── I4: kosmos_persist_dream stub fields ──────────────────────────────
    let anchor = dr_kosmos_persist_dream(rep_n3_wake)
    let t5_ok = len(anchor["tension5"]) == 5
    let kind_ok = anchor["anchor_kind"] == "dream_report"
    let wire_ok = anchor["wired_to_kosmos_io"] == false
    let i4 = t5_ok && kind_ok && wire_ok

    // ── I5: empty session edge case ───────────────────────────────────────
    let rep_empty = dr_wake_transition_report("REM", "WAKE", session_empty)
    let i5 = (rep_empty["total_emits"] == 0) && (rep_empty["snapshot_count"] == 0)

    // ── I6: report_kind constant ──────────────────────────────────────────
    let i6 = rep_n3_wake["report_kind"] == "dream_report_m4"

    println("I1  log len == count       " + (if i1 { "PASS" } else { "FAIL" }))
    println("I2  summarize empty/full   " + (if i2 { "PASS" } else { "FAIL" }))
    println("I3  wake-transition logic  " + (if i3 { "PASS (N3→WAKE up, REM→WAKE up, WAKE→N1 not-up)" } else { "FAIL" }))
    println("I4  kosmos anchor stub     " + (if i4 { "PASS (tension5 len=5, kind, wired=false)" } else { "FAIL" }))
    println("I5  empty session edge     " + (if i5 { "PASS" } else { "FAIL" }))
    println("I6  report_kind constant   " + (if i6 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (6/6)" } else { "INVARIANT FAILURE" })
}
