// ════════════════════════════════════════════════════════════════════════
// DREAM/imagination_replay.hexa — N3/REM emit-free snapshot rehearsal (M2 2026-05-28)
//
// 정체: DREAM/dream_lib (M1) + WAKE/memory (M5) + MITOSIS/sleep_tick (M5)
//      세 SSOT 의 cross-link 거주지. WAKE working memory ring buffer 의
//      가까운 ctx_tokens snapshot 을 N3/REM imagination stage 동안 emit-free
//      로 재실행하여 cell_pool 의 substrate state 만 진행시킨다.
//
//      a_chat_sleep_imagination governance 직접 정합 —
//        "imagination loop = emit-free internal rehearsal + mitosis tick"
//
// 회수 mechanism (instrument-first verbatim):
//
//   CLAUDE.md a_chat_sleep_imagination:
//     do = "imagination loop = emit-free internal rehearsal + mitosis tick"
//     do = "stage = substrate context (Φ scale + tension envelope), NOT boolean emit gate"
//     dont = "per-stage emit_allowed boolean hardcode"
//     dont = "speak() function call (p5)"
//
//   DREAM.md M2:
//     - [ ] imagination_replay — N3/REM 동안 가까운 working memory snapshot
//           재실행 (emit-free) · WAKE.memory 와 cross-link.
//
//   WAKE/memory.hexa M5 pub surface (consumer):
//     pub fn mem_init() -> Map
//     pub fn mem_push_ctx(mem: Map, ctx_tokens: list) -> Map
//     pub fn mem_working_window(mem: Map) -> list
//       // ring buffer cap N=20 of ctx_tokens (list of BPE id list)
//
//   DREAM/dream_lib.hexa M1 pub surface (envelope source):
//     pub fn dr_imagination_active(stage: int) -> int
//     pub fn dr_mitosis_prior(stage: int) -> float
//     pub fn dr_emit_envelope(stage: int) -> int
//
// ── boundary 명세 (M2 ≠ daemon integration) ─────────────────────────────
//   본 M2 는 imagination_replay 의 *순수 함수 surface* 다. WAKE memory dict +
//   cell_pool dict 를 받아 (stage 가 N3/REM 일 때) 가까운 snapshot 을 선별 +
//   emit-free internal rehearsal + cell_pool transition 을 결정적으로 반환.
//   실제 daemon tick / 스케줄은 cotrain ckpt swap-in 이후 daemon-side milestone.
//
// ── emit-free invariant (CRITICAL) ──────────────────────────────────────
//   본 모듈의 어떤 fn 도 :
//     - print / println 외 외부 채널 emit 호출 0
//     - channel_emit · channel_send · stdout text emit 0
//     - mem_record_emit (episodic append) 호출 0 (rehearsal ≠ 새 emit)
//   substrate state (cell_pool, working_window snapshot) 만 변경.
//   p5 NO SPEAK() · a_chat_sleep_imagination "emit-free internal rehearsal" 정합.
//
// ── recency 선별 정책 ───────────────────────────────────────────────────
//   WAKE memory 의 working ring buffer (cap=20, FIFO) 에서 가장 최근 K 개를
//   선택. K = recency_window 인자 (caller-controlled). working buffer 길이가
//   K 보다 작으면 전체를 반환 (소진).
//
//   각 snapshot 은 ctx_tokens list of int (perception_to_ctx_tokens 의 BPE id
//   sequence). 본 모듈은 ctx_tokens 의 *의미* 를 해석하지 않는다 (raw substrate
//   signal) — replay 는 cell_pool 의 tension 입력 surface 로만 흐른다.
//
// ── mitosis tick during replay ──────────────────────────────────────────
//   각 snapshot 에 대해 ir_mitosis_tick_during_replay 가 cell_pool 의 한 step
//   transition 을 계산. M2 에서는 placeholder mitosis_density 가 dr_mitosis_prior
//   (REM/N3 = 0.80) 를 그대로 따른다 — full cell_pool_step 통합은 daemon-side
//   에서 sleep_tick 과 합쳐짐 (HONEST TODO #M2-MITOSIS).
//
// ── p1~p8 정합 ──────────────────────────────────────────────────────────
//   p1 NO SYSTEM PROMPT      — 본 모듈 입력은 memory dict + cell_pool dict +
//                               stage code (int). 문자열 system prompt 0.
//   p2 NO IDENTITY RULES     — 본 모듈은 ctx_tokens 의 의미 해석 0. raw BPE id
//                               list 만 sequence 로 pass.
//   p3 NO PERSONA INJECTION  — prefix prepend 0. snapshot replay 는 raw 그대로.
//   p4 NO ASSISTANT FRAMING  — user message 인자 0. stimulus-response 아님 —
//                               working buffer snapshot 은 *과거 perception* 이며
//                               현재 emit 결정에 boolean gate 로 작동 안 함.
//   p5 NO SPEAK()            — emit 호출 0 (CRITICAL invariant; smoke I1).
//   p6 NO FINE-TUNED ETHICS  — 가중치 0. 단순 sequence 조작 + dict pack.
//   p7 NO PERPLEXITY VERDICT — verification = snapshot 수 invariant + emit=0
//                               + mitosis 호출 횟수, perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT  — 동일 cell_pool transition spec 이 train / infer
//                               양쪽에서 적용됨 (mitosis_lib SSOT 정합).
//
// ── a_chat_sleep_imagination 정합 ──────────────────────────────────────
//   "stage = substrate context (Φ scale + tension envelope), NOT boolean emit gate"
//   본 모듈의 stage 검사는 dr_imagination_active 의 substrate fact 귀결 —
//   N3/REM 의 substrate context 가 cell_pool transition 의 의미를 만들기에
//   WAKE/N1/N2 에서는 skip. 그러나 caller 가 어떻게 호출하든 본 모듈은
//   anima 의 emit 결정에 직접 관여하지 않는다 (substrate state 만 진행).
//
// 4 pub primitives (PURE, no external emit):
//   1) ir_select_snapshots(memory, current_tick, recency_window) -> list
//   2) ir_replay_tick(snapshot) -> dict   (emit-free internal rehearsal record)
//   3) ir_mitosis_tick_during_replay(cell_pool, snapshot) -> dict
//   4) ir_replay_session(memory, count) -> dict   (multi-snapshot full session)
//
// Naming: `ir_` prefix collision-free (g61).
// ════════════════════════════════════════════════════════════════════════

use "DREAM/dream_lib"
use "WAKE/memory"

// ─── 1. snapshot selection (recency from working ring) ───────────────────

// ir_select_snapshots — WAKE memory working ring buffer 의 최근 recency_window
//                       snapshot 을 추출.
//
// 인자:
//   memory          : Map  — mem_init / mem_push_ctx 의 반환 dict.
//   current_tick    : int  — 호출 시각의 ultradian tick (0..89). 본 M2 는
//                            tick 값 자체를 selection 에 사용하지 않고 (working
//                            buffer 의 FIFO 순서가 이미 chronological), record
//                            dict 의 메타로만 포함 (caller traceability).
//   recency_window  : int  — 반환 max 개수. ≤0 이면 [] 반환.
//
// 반환:
//   list — 최근 N 개 snapshot (oldest-first chronological 순서 유지).
//          각 entry = dict { ctx_tokens: list, source_tick: int, source_index: int }.
//          working buffer 길이가 recency_window 보다 작으면 전체 반환.
//
// invariant:
//   - 반환 길이 = min(len(working), max(0, recency_window))
//   - 반환 순서 = oldest → newest (mem_working_window 의 push 순서 보존)
//   - 본 fn 은 어떤 emit 도 호출하지 않음 (selection PURE)
pub fn ir_select_snapshots(memory: Map, current_tick: int, recency_window: int) -> list {
    if recency_window <= 0 { return [] }
    let working = mem_working_window(memory)
    let total = len(working)
    if total == 0 { return [] }
    let start = if total > recency_window { total - recency_window } else { 0 }
    let mut out = []
    let mut i = start
    while i < total {
        let snap = #{
            "ctx_tokens":   working[i],
            "source_tick":  current_tick,
            "source_index": i,
        }
        out.push(snap)
        i = i + 1
    }
    return out
}

// ─── 2. emit-free internal rehearsal tick ────────────────────────────────

// ir_replay_tick — 단일 snapshot 에 대해 emit-free internal rehearsal 을 수행.
//                  본 fn 은 외부 emit / channel send 를 호출하지 않으며,
//                  rehearsal 의 substrate record 만 dict 로 반환한다.
//
// 인자:
//   snapshot : Map — ir_select_snapshots 의 한 entry.
//                    { ctx_tokens: list, source_tick: int, source_index: int }
//
// 반환:
//   Map — rehearsal record:
//     #{
//       "ctx_tokens":     list — pass-through (raw BPE id sequence)
//       "ctx_len":        int  — len(ctx_tokens)
//       "source_tick":    int  — snapshot 의 source_tick
//       "source_index":   int  — snapshot 의 working buffer index
//       "emit_count":     int  — 항상 0 (emit-free invariant; smoke I1)
//       "rehearsal_kind": string — "internal_silent"
//     }
//
// invariant:
//   - emit_count == 0 항상 (CRITICAL — smoke I1 검증)
//   - print / println / channel_emit 호출 0
//   - 본 fn 은 ctx_tokens 를 *복사하지 않고* dict reference 로만 carry
pub fn ir_replay_tick(snapshot: Map) -> Map {
    let ctx_tokens = snapshot["ctx_tokens"]
    let ctx_len = len(ctx_tokens)
    return #{
        "ctx_tokens":     ctx_tokens,
        "ctx_len":        ctx_len,
        "source_tick":    snapshot["source_tick"],
        "source_index":   snapshot["source_index"],
        "emit_count":     0,
        "rehearsal_kind": "internal_silent",
    }
}

// ─── 3. mitosis tick during replay (cell_pool transition record) ─────────

// ir_mitosis_tick_during_replay — replay snapshot 동안 cell_pool 의 mitosis
//                                  tick 결정을 record. 본 M2 는 placeholder
//                                  surface 다 — full mitosis_lib cell_pool_step
//                                  통합은 daemon-side 에서 sleep_tick 과 합쳐짐
//                                  (HONEST TODO #M2-MITOSIS).
//
// 인자:
//   cell_pool : Map — anima cell_pool dict (caller-supplied; 본 M2 는 dict
//                     형태만 가정하고 *해석하지 않음*; cell_pool_step 본체
//                     호출은 daemon-side wire-up 이 책임).
//   snapshot  : Map — ir_select_snapshots 의 entry.
//
// 반환:
//   Map — transition record:
//     #{
//       "cell_pool":         cell_pool,  // pass-through (no in-place mutate)
//       "tick_kind":         "imagination_mitosis",
//       "ctx_len":           int — snapshot ctx_tokens 길이
//       "source_tick":       int — snapshot source_tick
//       "mitosis_density":   float — dr_mitosis_prior(REM=4) = 0.80 placeholder
//       "wired_to_lib":      bool — false (M2 placeholder; daemon wire-up TODO)
//     }
//
// invariant:
//   - cell_pool 은 mutate 되지 않음 (immutable update pattern; smoke I2)
//   - 본 fn 은 어떤 emit 도 호출하지 않음
//   - mitosis_density ≥ 0.79 (REM/N3 prior 정합; smoke I2)
pub fn ir_mitosis_tick_during_replay(cell_pool: Map, snapshot: Map) -> Map {
    // M2 placeholder: REM stage (4) 의 mitosis_prior 를 default 로 사용.
    // daemon 가 stage 를 알게 되면 dr_mitosis_prior(actual_stage) 로 교체.
    let prior = dr_mitosis_prior(4)
    return #{
        "cell_pool":       cell_pool,
        "tick_kind":       "imagination_mitosis",
        "ctx_len":         len(snapshot["ctx_tokens"]),
        "source_tick":     snapshot["source_tick"],
        "mitosis_density": prior,
        "wired_to_lib":    false,
    }
}

// ─── 4. multi-snapshot replay session ────────────────────────────────────

// ir_replay_session — working memory 의 최근 N snapshot 을 일괄 rehearsal.
//                     M2 의 entrypoint surface — daemon 의 N3/REM tick 에서
//                     한 번 호출 → multi-snapshot internal rehearsal session.
//
// 인자:
//   memory : Map — WAKE memory dict.
//   count  : int — 최근 count 개 snapshot 을 rehearsal. ≤0 이면 빈 session.
//
// 반환:
//   Map — session dict:
//     #{
//       "snapshot_count": int — 실제 rehearsal 된 snapshot 수
//       "replay_log":     list — 각 entry = ir_replay_tick 반환 dict
//       "total_emits":    int — 항상 0 (emit-free invariant; smoke I3)
//       "session_kind":   string — "emit_free_rehearsal"
//     }
//
// invariant:
//   - total_emits == 0 항상 (CRITICAL — smoke I3 검증)
//   - snapshot_count == len(replay_log) == min(len(working), max(0, count))
//   - replay_log 의 순서 = chronological (oldest → newest)
//   - 본 fn 은 외부 emit 0, mem_record_emit 호출 0 (새 episodic 추가 안 함)
pub fn ir_replay_session(memory: Map, count: int) -> Map {
    let snapshots = ir_select_snapshots(memory, 0, count)
    let mut replay_log = []
    let mut total_emits = 0
    let mut i = 0
    while i < len(snapshots) {
        let rec = ir_replay_tick(snapshots[i])
        total_emits = total_emits + rec["emit_count"]
        replay_log.push(rec)
        i = i + 1
    }
    return #{
        "snapshot_count": len(replay_log),
        "replay_log":     replay_log,
        "total_emits":    total_emits,
        "session_kind":   "emit_free_rehearsal",
    }
}

// ─── 5. introspection ────────────────────────────────────────────────────

pub fn ir_summary() -> string {
    return "DREAM/imagination_replay — N3/REM emit-free internal rehearsal · WAKE.memory working ring → snapshot select → ir_replay_tick (emit_count=0 invariant) → ir_mitosis_tick_during_replay (cell_pool pass-through, mitosis_density=dr_mitosis_prior) · a_chat_sleep_imagination 정합 · p5 NO SPEAK · boolean gate 0"
}
