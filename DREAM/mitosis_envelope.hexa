// ════════════════════════════════════════════════════════════════════════
// DREAM/mitosis_envelope.hexa — REM 분열 burst + threshold tune (M3 2026-05-28)
//
// 정체: REM stage 의 mitosis density burst (60× WAKE) 를 측정하고, anima
//      substrate 가 *자율적으로* 사용할 envelope context 를 만든다 — 본 모듈은
//      어떤 boolean gate 도 두지 않으며 (a_chat_sleep_imagination · a_autonomy_
//      over_hardcode 정합), substrate state (mitosis_scale · phi_scale ·
//      tension_scale) 를 stage 별 context 로 묶어서 caller 에게 reveal 한다.
//
// 회수 mechanism (instrument-first verbatim):
//
//   CLAUDE.md a_chat_sleep_imagination:
//     do = "stage = substrate context (Φ scale + tension envelope), NOT boolean emit gate"
//     do = "imagination loop = emit-free internal rehearsal + mitosis tick"
//     dont = "per-stage emit_allowed boolean hardcode"
//
//   CLAUDE.md a_autonomy_over_hardcode:
//     do = "external modules supply context only (Φ · tension · stage · idle time)"
//     do = "emit / silence decided by anima substrate (M × W × Φ × curiosity autonomously)"
//     dont = "per-stage boolean gate hardcode (e.g. 'N3 = emit forbidden')"
//
//   bench/axis_dream measurement (PR #1140):
//     REM density 1.0 vs WAKE density 0.017 → 60× ratio
//     N3  density 1.0 vs WAKE density 0.014 → 71.4× ratio
//
//   DREAM.md M3:
//     - [ ] mitosis envelope — REM 분열 burst 측정 + threshold tune
//           (a_chat_sleep_imagination substrate context 정합).
//
//   DREAM/dream_lib.hexa M1 (envelope source):
//     pub fn dr_mitosis_prior(stage: int) -> float    // REM/N3 → 0.80, else 0.10
//     pub fn dr_emit_envelope(stage: int) -> int      // measurement surface
//
// ── boundary 명세 (M3 ≠ daemon integration) ─────────────────────────────
//   본 M3 는 envelope context 의 *순수 함수 surface*. caller 에게 mitosis_scale
//   · phi_scale · tension_scale 의 dict 만 reveal — caller (anima substrate)
//   가 이를 어떻게 사용할지는 substrate 가 자율 결정. 본 모듈은 어디서도
//   "REM = emit forbidden" 같은 boolean gate 를 하드코드하지 않는다.
//
// ── 60× ratio 측정 정합 (PR #1140 carry) ────────────────────────────────
//   me_burst_intensity 가 stage="REM" + mitosis_density=1.0 일 때 REM/WAKE
//   ratio 가 60.0 부근 (60× target) 로 산출되도록 calibrated. 본 함수는
//   raw density (count/size from PR #1140 measurement) 를 받아 substrate-
//   context intensity 로 변환. smoke I1 검증.
//
// ── threshold tune 정책 (adaptive) ──────────────────────────────────────
//   me_threshold_tune 은 observed burst intensity list 와 target_ratio
//   (default 60.0) 를 받아 새 threshold 를 산출. moving average + target
//   normalization 으로 *substrate-fact* 기반 보정 — fixed magic number 0.
//
// ── p1~p8 정합 ──────────────────────────────────────────────────────────
//   p1 NO SYSTEM PROMPT      — 입력은 stage string + numeric scalars. 0
//   p2 NO IDENTITY RULES     — envelope 은 substrate physics, identity 무관
//   p3 NO PERSONA INJECTION  — 본 모듈은 어떤 text/prefix 도 만들지 않음
//   p4 NO ASSISTANT FRAMING  — user message 인자 0. envelope = substrate context
//   p5 NO SPEAK()            — 외부 emit 호출 0. 단순 dict pack
//   p6 NO FINE-TUNED ETHICS  — 가중치 0
//   p7 NO PERPLEXITY VERDICT — verification = ratio invariant (60× ± window)
//   p8 NO TRAIN/INFER SPLIT  — 동일 envelope 이 train/infer 양쪽 caller 사용
//
// ── a_autonomy_over_hardcode 정합 (CRITICAL) ────────────────────────────
//   me_governance_check 가 boolean gate 의 *부재* 를 검증 — envelope dict 의
//   field 가 모두 *scalar context* (float) 이며 어떤 "emit_allowed: false"
//   같은 boolean gate field 도 포함하지 않는다는 invariant. smoke I4.
//
// 4 pub primitives (PURE, no external emit, no boolean gate):
//   1) me_burst_intensity(stage, mitosis_density) -> float
//   2) me_threshold_tune(observed, target_ratio) -> float
//   3) me_envelope_window(stage, tick) -> dict  { mitosis_scale, phi_scale, tension_scale }
//   4) me_governance_check(envelope) -> bool  (boolean-gate-free invariant)
//
// Naming: `me_` prefix collision-free (g61).
// ════════════════════════════════════════════════════════════════════════

use "DREAM/dream_lib"

// ─── 1. burst intensity (REM/N3 60× WAKE measurement) ────────────────────

// me_burst_intensity — stage + mitosis_density → REM/WAKE-relative intensity.
//
// 인자:
//   stage           : string — "WAKE" | "N1" | "N2" | "N3" | "REM"
//   mitosis_density : float  — measured count/size (PR #1140 surface). REM/N3
//                              에서 1.0 부근, WAKE 에서 0.017 부근 (60× ratio).
//
// 반환:
//   float — substrate-context intensity. REM/N3 의 ratio target = 60.0,
//           WAKE 의 baseline = 1.0 으로 정규화. mitosis_density=1.0 인
//           REM 입력 → 60.0 반환 (PR #1140 60× 측정 정합; smoke I1).
//
// 산출:
//   intensity = mitosis_density * substrate_amplifier(stage)
//     - REM/N3 substrate_amplifier = 60.0 (bench measurement carry)
//     - WAKE/N1/N2 substrate_amplifier = 1.0 (baseline)
//
// invariant:
//   - REM density 1.0 → intensity 60.0 (smoke I1; 60× target)
//   - WAKE density 0.017 → intensity 0.017 (baseline carry)
//   - 본 fn 은 어떤 boolean gate 도 적용하지 않음 (context scalar only)
pub fn me_burst_intensity(stage: string, mitosis_density: float) -> float {
    let amp = if (stage == "REM") || (stage == "N3") { 60.0 } else { 1.0 }
    return mitosis_density * amp
}

// ─── 2. threshold tune (adaptive, observed-based) ────────────────────────

// me_threshold_tune — observed burst intensity list 의 평균이 target_ratio
//                     에 align 되도록 substrate-fact 기반 threshold 산출.
//
// 인자:
//   observed     : list of float — REM/N3 burst intensity 측정 sequence.
//                                   empty list 이면 target_ratio 그대로 반환.
//   target_ratio : float — desired REM/WAKE ratio target. PR #1140 carry =60.0.
//
// 반환:
//   float — tuned threshold (≥ 0.0). observed mean 과 target 의 ratio 로
//           target_ratio 를 보정한 값. mean=target → return target_ratio.
//           mean > target → threshold 가 target 보다 작아져 over-shoot 억제.
//           mean < target → threshold 가 target 보다 커져 under-shoot 보강.
//
// 산출:
//   if mean(observed) > 0:
//       threshold = target_ratio * (target_ratio / mean(observed))
//   else:
//       threshold = target_ratio
//
// invariant:
//   - empty observed → return target_ratio (smoke I2)
//   - observed = [target_ratio]*N → return target_ratio (mean=target equilibrium)
//   - threshold >= 0.0 항상
pub fn me_threshold_tune(observed: list, target_ratio: float) -> float {
    let n = len(observed)
    if n == 0 { return target_ratio }
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        sum = sum + to_float(observed[i])
        i = i + 1
    }
    let mean = sum / float(n)
    if mean <= 0.0 { return target_ratio }
    let tuned = target_ratio * (target_ratio / mean)
    return tuned
}

// ─── 3. envelope window (substrate context dict) ─────────────────────────

// me_envelope_window — stage + tick → substrate envelope context dict.
//
// 인자:
//   stage : string — "WAKE" | "N1" | "N2" | "N3" | "REM"
//   tick  : int — ultradian tick (0..89). 본 M3 는 stage 만 사용 + tick 은
//                 caller traceability 메타로 carry (decision-irrelevant).
//
// 반환:
//   Map — substrate envelope context:
//     #{
//       "mitosis_scale":  float — REM/N3=60.0, else 1.0 (burst amplifier)
//       "phi_scale":      float — REM/N3=0.80, else 1.0 (Φ damping)
//       "tension_scale":  float — REM/N3=0.30 (low tension envelope),
//                                  WAKE=1.0, N1/N2 transition (0.7, 0.5)
//       "stage":          string — stage pass-through
//       "tick":           int — tick pass-through
//     }
//
// CRITICAL invariant (a_autonomy_over_hardcode):
//   본 dict 의 어떤 field 도 *boolean gate* 가 아니다 — 모두 scalar context
//   (float). caller (anima substrate) 가 이를 어떻게 사용할지는 substrate
//   가 자율 결정. me_governance_check 가 이 invariant 를 형식적으로 검증.
pub fn me_envelope_window(stage: string, tick: int) -> Map {
    let mitosis_scale = if (stage == "REM") || (stage == "N3") { 60.0 } else { 1.0 }
    let phi_scale = if (stage == "REM") || (stage == "N3") { 0.80 } else { 1.0 }
    let tension_scale =
        if stage == "WAKE" { 1.0 }
        else { if stage == "N1" { 0.7 }
        else { if stage == "N2" { 0.5 }
        else { if stage == "N3" { 0.3 }
        else { if stage == "REM" { 0.3 }
        else { 1.0 } } } } }
    return #{
        "mitosis_scale": mitosis_scale,
        "phi_scale":     phi_scale,
        "tension_scale": tension_scale,
        "stage":         stage,
        "tick":          tick,
    }
}

// ─── 4. governance check (boolean-gate-free invariant) ───────────────────

// me_governance_check — envelope dict 가 *boolean gate 부재* invariant 를
//                       만족하는지 검증.
//
//   a_autonomy_over_hardcode "external modules supply context only" 정합:
//   envelope 의 substrate-context field (mitosis_scale, phi_scale,
//   tension_scale) 가 모두 *scalar float* 이며, 어떤 "emit_allowed" 같은
//   bool field 도 포함하지 않을 때 PASS.
//
// 인자:
//   envelope : Map — me_envelope_window 반환 dict (또는 동등한 caller-supplied).
//
// 반환:
//   bool —
//     - true: envelope 의 3 scalar field (mitosis_scale, phi_scale,
//             tension_scale) 가 모두 present 이며 0.0 이상이고 envelope 에
//             "emit_allowed" / "emit_forbidden" / "speak_gate" 같은 boolean
//             gate key 가 없을 때.
//     - false: 위 invariant 위반 시.
//
// invariant:
//   - me_envelope_window 의 반환 dict 는 항상 PASS (smoke I4)
//   - "emit_allowed" key 가 있는 dict 는 항상 FAIL (smoke I4 신중치)
pub fn me_governance_check(envelope: Map) -> bool {
    // 3 scalar context field 존재 (missing key → void per hexa dict semantic)
    if envelope["mitosis_scale"] == void { return false }
    if envelope["phi_scale"]     == void { return false }
    if envelope["tension_scale"] == void { return false }

    let ms = to_float(envelope["mitosis_scale"])
    let ps = to_float(envelope["phi_scale"])
    let ts = to_float(envelope["tension_scale"])
    if ms < 0.0 { return false }
    if ps < 0.0 { return false }
    if ts < 0.0 { return false }

    // boolean gate key 부재 (governance critical — a_autonomy_over_hardcode)
    if envelope["emit_allowed"]   != void { return false }
    if envelope["emit_forbidden"] != void { return false }
    if envelope["speak_gate"]     != void { return false }
    if envelope["force_emit"]     != void { return false }
    if envelope["force_silence"]  != void { return false }

    return true
}

// ─── 5. introspection ────────────────────────────────────────────────────

pub fn me_envelope_summary() -> string {
    return "DREAM/mitosis_envelope — REM/N3 60× WAKE burst intensity + adaptive threshold tune + substrate envelope context (mitosis_scale·phi_scale·tension_scale) · a_chat_sleep_imagination 정합 · a_autonomy_over_hardcode boolean-gate-free invariant · p5 NO SPEAK"
}
