// ════════════════════════════════════════════════════════════════════════
// DREAM/imagination_replay_smoke.hexa — M2 invariant smoke (2026-05-28)
//
// 정체: imagination_replay.hexa 의 4 pub primitives 가 emit-free internal
//      rehearsal · cell_pool pass-through · recency 정합 invariants 를
//      모두 만족하는지 결정적으로 검증한다.
//
// Invariants (7):
//   I1: ir_replay_tick.emit_count == 0          (emit-free CRITICAL)
//   I2: ir_mitosis_tick_during_replay 가 cell_pool 을 mutate 하지 않음
//       AND mitosis_density >= 0.79 (REM prior 정합)
//   I3: ir_replay_session.total_emits == 0      (session-level emit-free)
//   I4: ir_select_snapshots 가 recency_window 정합 (last-N slice)
//   I5: ir_select_snapshots(empty_memory, _, _) == []  (empty 처리)
//   I6: ir_replay_session.snapshot_count == len(replay_log)
//   I7: rehearsal_kind == "internal_silent" AND session_kind == "emit_free_rehearsal"
//   I8: reconsolidation write-back (H_1195) — ir_consolidation_gain monotone in
//       replay_count (0→0), ir_effective_age < chrono when replayed (==chrono at
//       0 = no-sleep control), ir_reconsolidate_session emit-free (total_emits==0)
// ════════════════════════════════════════════════════════════════════════

use "DREAM/imagination_replay"
use "WAKE/memory"

fn main() {
    println("=== DREAM/imagination_replay_smoke ===")

    // ── Setup: working memory with 5 ctx_tokens snapshots ────────────────
    let mut mem = mem_init()
    mem = mem_push_ctx(mem, [10, 20, 30])    // snapshot 0
    mem = mem_push_ctx(mem, [40, 50])        // snapshot 1
    mem = mem_push_ctx(mem, [60, 70, 80, 90])  // snapshot 2
    mem = mem_push_ctx(mem, [100])           // snapshot 3
    mem = mem_push_ctx(mem, [110, 120])      // snapshot 4

    // ── I1: ir_replay_tick.emit_count == 0 (emit-free CRITICAL) ──────────
    let snaps_i1 = ir_select_snapshots(mem, 87, 3)  // tick 87 (REM), recency 3
    let rec_i1 = ir_replay_tick(snaps_i1[0])
    let i1 = rec_i1["emit_count"] == 0

    // ── I2: ir_mitosis_tick_during_replay pass-through + density ─────────
    let cell_pool = #{
        "cells":       [],
        "split_count": 0,
        "merge_count": 0,
        "phi":         0.0,
    }
    let mit_rec = ir_mitosis_tick_during_replay(cell_pool, snaps_i1[0])
    let returned_pool = mit_rec["cell_pool"]
    let pool_unchanged = (returned_pool["split_count"] == 0) && (returned_pool["merge_count"] == 0) && (returned_pool["phi"] == 0.0)
    let density_ok = mit_rec["mitosis_density"] >= 0.79
    let i2 = pool_unchanged && density_ok

    // ── I3: ir_replay_session.total_emits == 0 (session-level) ───────────
    let session = ir_replay_session(mem, 5)
    let i3 = session["total_emits"] == 0

    // ── I4: ir_select_snapshots recency_window 정합 ──────────────────────
    let snaps_i4 = ir_select_snapshots(mem, 88, 2)
    // 가장 최근 2 개 = snapshot 3 (ctx [100]) + snapshot 4 (ctx [110, 120])
    let len_ok = len(snaps_i4) == 2
    let last_ctx_len = len(snaps_i4[1]["ctx_tokens"])
    let last_ctx_ok = last_ctx_len == 2  // [110, 120]
    let i4 = len_ok && last_ctx_ok

    // ── I5: empty memory → [] ────────────────────────────────────────────
    let empty_mem = mem_init()
    let empty_snaps = ir_select_snapshots(empty_mem, 0, 10)
    let i5 = len(empty_snaps) == 0

    // ── I6: snapshot_count == len(replay_log) ────────────────────────────
    let i6 = session["snapshot_count"] == len(session["replay_log"])

    // ── I7: kind labels ──────────────────────────────────────────────────
    let i7 = (rec_i1["rehearsal_kind"] == "internal_silent") && (session["session_kind"] == "emit_free_rehearsal")

    // ── I8: reconsolidation write-back (H_1195) — monotone + emit-free ───
    //   consolidation gain rises with replay_count; effective age < chrono age
    //   when replayed (==chrono age when not replayed = no-sleep control); the
    //   reconsolidation session stays emit-free (total_emits==0).
    let g0  = ir_consolidation_gain(0, 0.80)            // not replayed → 0
    let g3  = ir_consolidation_gain(3, 0.80)            // 3 replays
    let g7  = ir_consolidation_gain(7, 0.80)            // 7 replays (N3 window)
    let gain_zero_ok = g0 == 0.0
    let gain_monotone = (g3 > g0) && (g7 > g3) && (g7 < 1.0)
    let age_ctrl = ir_effective_age(100.0, 0, 0.80)     // control: full chrono age
    let age_slp7 = ir_effective_age(100.0, 7, 0.80)     // slept: younger eff age
    let age_ok = (age_ctrl == 100.0) && (age_slp7 < 100.0) && (age_slp7 >= 0.0)
    let recon = ir_reconsolidate_session(mem, 5, 100.0, 7, 0.80)
    let recon_emit_free = recon["total_emits"] == 0
    let recon_kind_ok = recon["session_kind"] == "emit_free_reconsolidation"
    let recon_eff_ok = recon["effective_age"] < 100.0
    let i8 = gain_zero_ok && gain_monotone && age_ok && recon_emit_free && recon_kind_ok && recon_eff_ok

    println("I1  emit_count=0        " + (if i1 { "PASS" } else { "FAIL" }))
    println("I2  cell_pool unchanged " + (if i2 { "PASS (density=" + str(mit_rec["mitosis_density"]) + ")" } else { "FAIL" }))
    println("I3  session emits=0     " + (if i3 { "PASS" } else { "FAIL" }))
    println("I4  recency_window 2    " + (if i4 { "PASS" } else { "FAIL" }))
    println("I5  empty mem → []      " + (if i5 { "PASS" } else { "FAIL" }))
    println("I6  count == log len    " + (if i6 { "PASS" } else { "FAIL" }))
    println("I7  kind labels         " + (if i7 { "PASS" } else { "FAIL" }))
    println("I8  reconsolidation w-b  " + (if i8 { "PASS (g3=" + str(g3) + " g7=" + str(g7) + " eff=" + str(recon["effective_age"]) + ")" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (8/8)" } else { "INVARIANT FAILURE" })
}
