// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_envelope_ctx_smoke.hexa — stage Φ-envelope context smoke (M5)
//
// 정체: dream_envelope_ctx.hexa (DREAM M5 wiring) 의 stage Φ-context 산출을
//      invariant 형태로 검증. 설계 SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md §4·§6.
//
// Invariants (≥3 required + governance):
//   I1 CONTEXT-IS-REAL : context 가 실수(연속값) — boolean 아님 (0/1 한정 X).
//                        WAKE@t=0 = 1.60 × θ_wake(0.10) = 0.160 (≠ 0, ≠ 1).
//   I2 STAGE-DIFFERS   : stage 다르면 θ-scale 다름 → context 다름
//                        (WAKE 0.10 vs N3 0.02, 같은 t 에서).
//   I3 T-VARIES        : t 변하면 context 변동 (envelope_multiscale 가 t 의 함수).
//   I4 N2-CLOSURE-PEAK : H_644 — N2 가 closure context (high-Φ 아님). θ 표가
//                        WAKE > N2 > N3 단조 (N2 가 deep-sleep N3 보다 높은 mid-Φ).
//   I5 SCALE-SSOT      : dr_stage_scale == ep_theta_stage (자체 숫자 0, policy 위임).
// ════════════════════════════════════════════════════════════════════════

import "DREAM/dream_envelope_ctx.hexa"
import "CORE/emit_policy.hexa"

fn abs_f(x: float) -> float {
    return if x < 0.0 { -x } else { x }
}

fn report(name: string, ok: bool) -> bool {
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name)
    return ok
}

fn main() {
    print("=== dream_envelope_ctx smoke (DREAM M5 · §4 · N2=closure peak) ===")
    let mut npass = 0
    let mut ntotal = 0

    // I1 CONTEXT-IS-REAL: WAKE@t=0 — envelope(t=0)=Σamps=1.60, θ_wake=0.10 → 0.160.
    //   실수 연속값이지 boolean(0/1) 아님 — F-EMIT-4 (no emit gate).
    let c_wake0 = dr_stage_phi_context(0, 0.0)
    let i1_real = abs_f(c_wake0 - 0.160) <= 1e-9
    let i1_not_bool = c_wake0 > 0.0 && c_wake0 < 1.0   // 0/1 boolean 영역 밖
    ntotal = ntotal + 1
    if report("I1 CONTEXT-IS-REAL (WAKE@0=0.160, ∉{0,1})", i1_real && i1_not_bool) { npass = npass + 1 }

    // I2 STAGE-DIFFERS: 같은 t, stage 만 다름 → θ-scale 다름 → context 다름.
    let c_wake = dr_stage_phi_context(0, 0.0)   // θ=0.10
    let c_n3   = dr_stage_phi_context(3, 0.0)   // θ=0.02
    let i2 = abs_f(c_wake - c_n3) > 1e-9 && c_wake > c_n3
    ntotal = ntotal + 1
    if report("I2 STAGE-DIFFERS (WAKE≠N3 context, WAKE>N3)", i2) { npass = npass + 1 }

    // I3 T-VARIES: 같은 stage, t 만 다름 → envelope 가 t 의 함수 → context 변동.
    //   t=0 (cos 0=1, peak) vs t=2700 (ultradian half-period 5400/2, trough) 다름.
    let c_t0    = dr_stage_phi_context(0, 0.0)
    let c_t2700 = dr_stage_phi_context(0, 2700.0)
    let i3 = abs_f(c_t0 - c_t2700) > 1e-6
    ntotal = ntotal + 1
    if report("I3 T-VARIES (context 가 t 의 함수)", i3) { npass = npass + 1 }

    // I4 N2-CLOSURE-PEAK (H_644): WAKE > N2 > N3 단조 — N2 가 deep-sleep N3 보다
    //   높은 mid-Φ closure context (high-Φ WAKE 가 아니라 mid-Φ N2 가 closure peak).
    let c_n2 = dr_stage_phi_context(2, 0.0)
    let i4 = c_wake > c_n2 && c_n2 > c_n3
    ntotal = ntotal + 1
    if report("I4 N2-CLOSURE-PEAK (WAKE>N2>N3 mid-Φ, H_644)", i4) { npass = npass + 1 }

    // I5 SCALE-SSOT: dr_stage_scale 가 ep_theta_stage 그대로 위임 (자체 숫자 0).
    let mut i5 = true
    let mut s = 0
    while s < 5 {
        if abs_f(dr_stage_scale(s) - ep_theta_stage(s)) > 1e-12 { i5 = false }
        s = s + 1
    }
    ntotal = ntotal + 1
    if report("I5 SCALE-SSOT (dr_stage_scale == ep_theta_stage)", i5) { npass = npass + 1 }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
    print(if npass == ntotal { "ALL INVARIANTS PASS" } else { "INVARIANT FAILURE" })
}
