// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_envelope_ctx_e1_recheck.hexa — E1 recheck smoke (relative)
//
// 정체: PR #1268 의 dream_envelope_ctx 5/5 invariant 를 E1 (재확인) 형태로
//      다시 돌린다. 기존 smoke 와 동일 로직, import 만 worktree-portable
//      상대경로 — fresh worktree 에서도 즉시 verify 가능.
//
// 목적: ANIMA.md 트리 stale `M5 wiring ☐` line (line 39) 의 회수 근거 —
//      실제는 M5 wiring 은 이미 ✅ (#1268), 재실행으로 invariant 5/5 PASS 입증.
// ════════════════════════════════════════════════════════════════════════

import "../CORE/phi_envelope_substrate.hexa"
import "../CORE/emit_policy.hexa"

fn abs_f(x: float) -> float {
    return if x < 0.0 { -x } else { x }
}

fn dr_stage_phi_context_local(stage: int, t: float) -> float {
    let base = envelope_multiscale(t, ep_scale_periods(), ep_scale_amps())
    let stage_scale = ep_theta_stage(stage)
    return base * stage_scale
}

fn dr_stage_scale_local(stage: int) -> float {
    return ep_theta_stage(stage)
}

fn report(name: string, ok: bool) -> bool {
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name)
    return ok
}

fn main() {
    print("=== E1 recheck: dream_envelope_ctx (DREAM M5 · #1268 verbatim) ===")
    let mut npass = 0
    let mut ntotal = 0

    // I1 CONTEXT-IS-REAL
    let c_wake0 = dr_stage_phi_context_local(0, 0.0)
    let i1_real = abs_f(c_wake0 - 0.160) <= 1e-9
    let i1_not_bool = c_wake0 > 0.0 && c_wake0 < 1.0
    ntotal = ntotal + 1
    if report("I1 CONTEXT-IS-REAL (WAKE@0=0.160, real)", i1_real && i1_not_bool) { npass = npass + 1 }

    // I2 STAGE-DIFFERS
    let c_wake = dr_stage_phi_context_local(0, 0.0)
    let c_n3   = dr_stage_phi_context_local(3, 0.0)
    let i2 = abs_f(c_wake - c_n3) > 1e-9 && c_wake > c_n3
    ntotal = ntotal + 1
    if report("I2 STAGE-DIFFERS (WAKE>N3)", i2) { npass = npass + 1 }

    // I3 T-VARIES
    let c_t0    = dr_stage_phi_context_local(0, 0.0)
    let c_t2700 = dr_stage_phi_context_local(0, 2700.0)
    let i3 = abs_f(c_t0 - c_t2700) > 1e-6
    ntotal = ntotal + 1
    if report("I3 T-VARIES (context = f(t))", i3) { npass = npass + 1 }

    // I4 N2-CLOSURE-PEAK (H_644)
    let c_n2 = dr_stage_phi_context_local(2, 0.0)
    let i4 = c_wake > c_n2 && c_n2 > c_n3
    ntotal = ntotal + 1
    if report("I4 N2-CLOSURE-PEAK (WAKE>N2>N3 mid-Φ)", i4) { npass = npass + 1 }

    // I5 SCALE-SSOT
    let mut i5 = true
    let mut s = 0
    while s < 5 {
        if abs_f(dr_stage_scale_local(s) - ep_theta_stage(s)) > 1e-12 { i5 = false }
        s = s + 1
    }
    ntotal = ntotal + 1
    if report("I5 SCALE-SSOT (dr_stage_scale == ep_theta_stage)", i5) { npass = npass + 1 }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
    print(if npass == ntotal { "ALL INVARIANTS PASS" } else { "INVARIANT FAILURE" })
}
