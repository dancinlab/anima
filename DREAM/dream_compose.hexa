// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_compose.hexa — REM dream-composed anchor (H_DREAM_COMPOSE, 2026-07-02)
//
// 정체: N3/REM replay window 안에서 CO-REPLAYED 된 두 anchor 를 기하 blend
//      하여 .kosmos 에 NEW derived anchor(새 NODE)로 append 하는 순수 함수 층.
//      B① 경로 — dr_kosmos_persist_dream STUB(h1162)의 실질 구현. 기존 sleep
//      write-back(imagination_replay.hexa §5 ir_reconsolidate_session)은 recency
//      만 refresh 하고 NODE 를 만들지 않는다(h1195). 본 모듈이 그 gap 을 메운다.
//
// 생물 렌즈(a_no_llm_frame_trap):
//   해마 SWR replay → 피질 consolidation. interleaved replay 가 서로 안 붙어
//   있던 경험 둘을 하나의 새 schema 로 bind ("어젯밤 꿈이 두 기억을 아침의
//   통찰로 엮었다"). 두 부모의 link 를 .kosmos node-only 규약(a_kosmos: edge
//   없음)에 맞춰 *blended new node* 로 실현한다 — 이게 spec 에 정확히 fit.
//
// blend 법칙(설계된 geometric law, 학습된 의미통찰 아님 — c9 honest scope):
//   coord   = 두 부모 coord 의 midpoint (성분별 (a+b)/2)
//   tension5= 두 부모 tension5 의 mean  (성분별 (a+b)/2)
//   radius  = 두 부모 radius 의 max
//   lane    = "dream" (derived-schema lane)
//
// ── placement DISJOINT (a_substrate_disjoint · placement-first) ──────────
//   본 모듈은 ONLY anchor/memory substrate(dict)에만 쓴다:
//     · pure_field(Ψ) 미접촉 — pure_field import 0, Ψ 인자/반환 0.
//     · emit-drive lane(0/4) 미접촉 — 새 anchor 의 lane = "dream"(≠ 0/4).
//     · §ImmuneMemory recall_thr 미접촉 — recall gate 인자/반환 0.
//   H_1195 선례: fold 는 Engine-G motivation age 만 건드리고 Ψ 보존. 본 모듈은
//   더 약하게 — 오직 새 anchor node dict 를 반환할 뿐 어떤 state 도 mutate 안 함.
//
// p1~p8 정합: emit 호출 0(p5) · user message 인자 0(p4) · ctx 의미해석 0(p2) ·
//   train/infer 동일 blend(p8) · perplexity 무관, 검증=anchor-graph 구조(p7).
//
// pub primitives (PURE, no external emit, no import):
//   dc_make_anchor(id, coord, lane, radius, tension5, text) -> Map
//   dc_vec_mid(a, b) -> list          (성분별 midpoint = 2-원소 mean)
//   dc_fmax(a, b) -> float
//   dc_cosine(a, b) -> float          (F3 real-composition 측정용)
//   dc_stage_replay_budget(stage) -> int   (N3=7 > REM=3, dr_stage_ticks mirror)
//   dc_coreplayed(anchor_a, anchor_b, window) -> bool   (F4 co-activation gate)
//   dc_compose_dream_anchor(parent_a, parent_b) -> Map  (THE blend, 새 NODE)
//   dc_compose_window(anchors, stage, window) -> list   (co-replayed 쌍 → 새 nodes)
// ════════════════════════════════════════════════════════════════════════

// ─── anchor 생성자 ────────────────────────────────────────────────────────
// anchor = .kosmos node payload:
//   { id, coord:list<float>, lane:string, radius:float, tension5:list<float>(len5),
//     text:string, replay_window:int(어느 stage window 에서 replay 됐나; -1=미replay),
//     anchor_kind:string }
pub fn dc_make_anchor(id: string, coord: list, lane: string, radius: float,
                      tension5: list, text: string) -> Map {
    return #{
        "id":            id,
        "coord":         coord,
        "lane":          lane,
        "radius":        radius,
        "tension5":      tension5,
        "text":          text,
        "replay_window": -1,
        "anchor_kind":   "seed",
    }
}

// ─── 성분별 midpoint (두 float list 의 mean) ─────────────────────────────
// len(a)==len(b) 가정. 길이 다르면 min 길이까지만.
pub fn dc_vec_mid(a: list, b: list) -> list {
    let na = len(a)
    let nb = len(b)
    let n = if na < nb { na } else { nb }
    let mut out = []
    let mut i = 0
    while i < n {
        let av = to_float(a[i])
        let bv = to_float(b[i])
        out.push((av + bv) / 2.0)
        i = i + 1
    }
    return out
}

pub fn dc_fmax(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

// ─── cosine similarity (F3 측정) ─────────────────────────────────────────
// 두 vector 가 동일 방향이면 1.0. blend 가 진짜면 new≠copy → cos<1.0.
pub fn dc_cosine(a: list, b: list) -> float {
    let na = len(a)
    let nb = len(b)
    let n = if na < nb { na } else { nb }
    let mut dot = 0.0
    let mut sa = 0.0
    let mut sb = 0.0
    let mut i = 0
    while i < n {
        let av = to_float(a[i])
        let bv = to_float(b[i])
        dot = dot + av * bv
        sa = sa + av * av
        sb = sb + bv * bv
        i = i + 1
    }
    return dot / (sqrt(sa) * sqrt(sb) + 0.000000001)
}

// ─── stage replay budget (N3 > REM 자연 ordering) ────────────────────────
// dr_stage_ticks mirror(self-contained): N3(3)=7, REM(4)=3, 그 외 0.
// window 의 replay slot 수 = 이 budget. 더 넓은 N3 window ⇒ 더 많은 anchor 가
// co-replay ⇒ 더 많은 composed node (외부에서 stamp 안 함 — budget 에서 창발).
pub fn dc_stage_replay_budget(stage: int) -> int {
    if stage == 3 { return 7 }   // N3
    if stage == 4 { return 3 }   // REM
    return 0
}

// ─── co-activation gate (F4) ─────────────────────────────────────────────
// 두 anchor 가 같은 window 에서 함께 replay 됐을 때만 true. window<0 이면 false.
pub fn dc_coreplayed(anchor_a: Map, anchor_b: Map, window: int) -> bool {
    if window < 0 { return false }
    let wa = to_int(anchor_a["replay_window"])
    let wb = to_int(anchor_b["replay_window"])
    return (wa == window) && (wb == window)
}

// ─── THE blend: 두 부모 → 새 NODE ────────────────────────────────────────
// coord=midpoint · tension5=mean · radius=max · lane="dream".
// 새 anchor 는 부모 link 를 blended node 로 실현(a_kosmos node-only, edge 0).
pub fn dc_compose_dream_anchor(parent_a: Map, parent_b: Map) -> Map {
    let coord = dc_vec_mid(parent_a["coord"], parent_b["coord"])
    let t5    = dc_vec_mid(parent_a["tension5"], parent_b["tension5"])
    let ra    = to_float(parent_a["radius"])
    let rb    = to_float(parent_b["radius"])
    let radius = dc_fmax(ra, rb)
    let id_a = to_string(parent_a["id"])
    let id_b = to_string(parent_b["id"])
    return #{
        "id":            "dream(" + id_a + "+" + id_b + ")",
        "coord":         coord,
        "lane":          "dream",          // derived-schema lane (≠ emit-drive 0/4)
        "radius":        radius,
        "tension5":      t5,
        "text":          "",               // NARRATIVE M1 이 채울 hook (지금은 빈 payload)
        "replay_window": -1,               // 새 node 는 이번 window 의 replay 대상 아님
        "anchor_kind":   "dream_composed", // baseline(recency-only)는 이 kind node 0개
        "parent_a":      id_a,
        "parent_b":      id_b,
    }
}

// ─── window compose: co-replayed 쌍 전부 → 새 nodes ──────────────────────
// anchors 중 replay_window==window 인 것만 골라 unordered pair 마다 새 node.
// replay 대상 수 = min(co-replayed anchor 수, dc_stage_replay_budget(stage)).
// co-replayed <2 이면 [] (F4: 단독 replay → 0 node).
pub fn dc_compose_window(anchors: list, stage: int, window: int) -> list {
    let budget = dc_stage_replay_budget(stage)
    // 1) 이 window 에서 replay 된 anchor 를 budget 까지 수집.
    let mut replayed = []
    let mut i = 0
    while i < len(anchors) {
        let a = anchors[i]
        if to_int(a["replay_window"]) == window && window >= 0 {
            if len(replayed) < budget {
                replayed.push(a)
            }
        }
        i = i + 1
    }
    // 2) co-replayed 쌍마다 새 node.
    let mut out = []
    let n = len(replayed)
    let mut p = 0
    while p < n {
        let mut q = p + 1
        while q < n {
            out.push(dc_compose_dream_anchor(replayed[p], replayed[q]))
            q = q + 1
        }
        p = p + 1
    }
    return out
}

// ─── introspection ───────────────────────────────────────────────────────
pub fn dc_summary() -> string {
    return "DREAM/dream_compose — REM/N3 co-replayed 두 anchor 를 기하 blend(coord midpoint · tension5 mean · radius max · lane=dream)하여 .kosmos 에 새 NODE append · a_kosmos node-only 정합 · pure_field/emit-drive/recall_thr DISJOINT · p5 NO SPEAK · 설계된 geometric law(학습 의미통찰 아님, c9)"
}
