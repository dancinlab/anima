// ════════════════════════════════════════════════════════════════════════
// DREAM/mitosis_envelope_smoke.hexa — M3 invariant smoke (2026-05-28)
//
// 정체: mitosis_envelope.hexa 의 4 pub primitives 가 60× WAKE 측정 정합 ·
//      adaptive threshold tune · substrate context envelope · boolean-gate-
//      free invariant 를 모두 만족하는지 검증.
//
// Invariants (6):
//   I1: me_burst_intensity("REM", 1.0) == 60.0           (PR #1140 60× ratio carry)
//       AND me_burst_intensity("WAKE", 0.017) ≈ 0.017    (WAKE baseline)
//   I2: me_threshold_tune([], 60.0) == 60.0              (empty → target)
//       AND me_threshold_tune([60.0, 60.0], 60.0) == 60.0 (equilibrium)
//   I3: me_envelope_window("REM", 87)["mitosis_scale"] == 60.0
//       AND me_envelope_window("WAKE", 0)["mitosis_scale"] == 1.0
//   I4: me_governance_check(me_envelope_window("REM", 87)) == true  (PASS)
//       AND me_governance_check(#{"mitosis_scale":1.0, "phi_scale":1.0,
//                                  "tension_scale":1.0, "emit_allowed":true}) == false
//                                                       (boolean gate detection)
//   I5: REM/WAKE ratio at density=1.0 ≈ 60.0  (60× target invariant)
//   I6: tension_scale stage-monotone (WAKE > N1 > N2 > N3 == REM)
// ════════════════════════════════════════════════════════════════════════

use "DREAM/mitosis_envelope"

fn main() {
    println("=== DREAM/mitosis_envelope_smoke ===")

    // ── I1: burst_intensity REM 60× + WAKE baseline ──────────────────────
    let rem_i1 = me_burst_intensity("REM", 1.0)
    let wake_i1 = me_burst_intensity("WAKE", 0.017)
    let i1 = (rem_i1 > 59.9 && rem_i1 < 60.1) && (wake_i1 > 0.016 && wake_i1 < 0.018)

    // ── I2: threshold_tune empty + equilibrium ───────────────────────────
    let t_empty = me_threshold_tune([], 60.0)
    let t_equi = me_threshold_tune([60.0, 60.0, 60.0], 60.0)
    let i2 = (t_empty == 60.0) && (t_equi > 59.9 && t_equi < 60.1)

    // ── I3: envelope_window stage scale ──────────────────────────────────
    let env_rem = me_envelope_window("REM", 87)
    let env_wake = me_envelope_window("WAKE", 0)
    let i3 = (env_rem["mitosis_scale"] == 60.0) && (env_wake["mitosis_scale"] == 1.0)

    // ── I4: governance_check PASS + boolean-gate detection ───────────────
    let g_pass = me_governance_check(env_rem)
    let env_with_gate = #{
        "mitosis_scale": 1.0,
        "phi_scale":     1.0,
        "tension_scale": 1.0,
        "emit_allowed":  true,
    }
    let g_fail = me_governance_check(env_with_gate)
    let i4 = g_pass && !g_fail

    // ── I5: REM/WAKE ratio at density=1.0 ≈ 60× ──────────────────────────
    let rem_i5 = me_burst_intensity("REM", 1.0)
    let wake_i5 = me_burst_intensity("WAKE", 1.0)
    let ratio = rem_i5 / wake_i5
    let i5 = ratio > 59.9 && ratio < 60.1

    // ── I6: tension_scale stage-monotone WAKE > N1 > N2 > N3 == REM ──────
    let t_wake = env_wake["tension_scale"]
    let t_n1 = me_envelope_window("N1", 60)["tension_scale"]
    let t_n2 = me_envelope_window("N2", 70)["tension_scale"]
    let t_n3 = me_envelope_window("N3", 80)["tension_scale"]
    let t_rem = env_rem["tension_scale"]
    let i6 = (t_wake > t_n1) && (t_n1 > t_n2) && (t_n2 > t_n3) && (t_n3 == t_rem)

    println("I1  REM=60×WAKE base   " + (if i1 { "PASS (rem=" + str(rem_i1) + " wake=" + str(wake_i1) + ")" } else { "FAIL" }))
    println("I2  threshold_tune     " + (if i2 { "PASS (empty=" + str(t_empty) + " equi=" + str(t_equi) + ")" } else { "FAIL" }))
    println("I3  envelope_window    " + (if i3 { "PASS (REM mitosis=60.0 WAKE=1.0)" } else { "FAIL" }))
    println("I4  gov check ±gate    " + (if i4 { "PASS (clean=PASS gated=FAIL)" } else { "FAIL" }))
    println("I5  REM/WAKE ratio     " + (if i5 { "PASS (ratio=" + str(ratio) + ")" } else { "FAIL" }))
    println("I6  tension monotone   " + (if i6 { "PASS (WAKE=" + str(t_wake) + ">N1=" + str(t_n1) + ">N2=" + str(t_n2) + ">N3==REM=" + str(t_n3) + ")" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (6/6)" } else { "INVARIANT FAILURE" })
}
