// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_envelope_ctx.hexa — stage Φ-envelope context wiring (M5 2026-05-28)
//
// 정체: emit-substrate 의 4번째이자 마지막 소비자 (DREAM M5). 5-stage 수면
//      머신이 통합 Φ-envelope substrate (CORE/phi_envelope_substrate.hexa)
//      + free-number policy (CORE/emit_policy.hexa) 를 import 하는 얇은 소비자.
//      stage 별 Φ-envelope CONTEXT (실수) 를 산출 — boolean emit 게이트 아님.
//
// 설계 SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md §4 (DREAM M5 wiring)
//
// ── 핵심 설계 계약 (위반 금지) ───────────────────────────────────────────
//   · stage = Φ scale + tension envelope CONTEXT 지 boolean emit 게이트 아님
//     (a_chat_sleep_imagination · p5 · a_autonomy_over_hardcode · F-EMIT-4)
//   · per-stage emit_allowed boolean 하드코드 절대 금지 ("N3=emit forbidden" 류 X)
//   · 반환은 실수만 — emit/silence 결정은 anima 세포가 자율 (M × W × Φ × curiosity)
//   · 숫자(scale·θ) 하드코드 금지 — 전부 emit_policy.hexa accessor 에서만 주입
//   · imagination loop 은 emit-free 내부 rehearsal (본 모듈은 context 공급만)
//
// ── round-7/8 substrate verdict 정합 ─────────────────────────────────────
//   H_648 🟢 scale-free self-similar Φ-envelope (gamma⊂ultradian⊂circadian)
//   H_634 🟢 ultradian Φ-envelope (90-min 5-stage 머신의 envelope 형상)
//   ⚠ H_644 정정: closure ultradian peak = mid-Φ **N2** (high-Φ 아님 · FAL-REVERSED)
//     → ep_theta_stage(2) 가 closure peak context scale (emit_policy SSOT)
//
// ── 구조 vs 숫자 (2층 분리) ──────────────────────────────────────────────
//   · 구조(형상)  = envelope_multiscale(t, periods, amps) [substrate-grounded]
//   · 숫자(scale) = ep_scale_periods/ep_scale_amps/ep_theta_stage [design-tunable]
//   본 모듈은 둘을 잇는 wiring 일 뿐 — 자체 숫자 0, 자체 형상식 0 (g61 중복 금지).
//
// Naming: `dr_` prefix collision-free (g61 stdlib).
// ════════════════════════════════════════════════════════════════════════

import "CORE/phi_envelope_substrate.hexa"
import "CORE/emit_policy.hexa"

// ─── stage Φ-envelope context ────────────────────────────────────────────
// 5-stage 머신의 stage 별 Φ-envelope CONTEXT (실수) 산출:
//   base envelope = envelope_multiscale(t, ep_scale_periods(), ep_scale_amps())
//                   — 시점 t 의 multi-scale self-similar Φ-envelope (구조 층 형상)
//   stage scale   = ep_theta_stage(stage) — stage 별 Φ-context scale (숫자 층)
//   context       = base × stage_scale
//
// stage int: 0=WAKE 1=N1 2=N2 3=N3 4=REM. N2 가 closure peak (H_644 정정 —
// high-Φ 아님; emit_policy ep_theta_stage 의 θ 표가 closure context scale).
//
// ⚠ 반환 = 실수 (Φ-context). boolean 게이트 아님 — anima 세포가 이 context 를
//   읽어 emit/silence 를 자율 결정 (p5 · a_autonomy_over_hardcode · F-EMIT-4).
pub fn dr_stage_phi_context(stage: int, t: float) -> float {
    let base = envelope_multiscale(t, ep_scale_periods(), ep_scale_amps())
    let stage_scale = ep_theta_stage(stage)
    return base * stage_scale
}

// ─── stage scale accessor (얇은 패스스루) ────────────────────────────────
// stage 별 Φ-context scale 만 노출 (envelope 형상 없이 scale 만 필요한 caller 용).
// emit_policy SSOT 에 위임 — 본 모듈 자체 숫자 0.
pub fn dr_stage_scale(stage: int) -> float {
    return ep_theta_stage(stage)
}

pub fn dream_envelope_ctx_summary() -> string {
    return "dream_envelope_ctx: DREAM M5 — stage Φ-envelope context wiring (envelope_multiscale × ep_theta_stage). stage = Φ-context scale 지 emit 게이트 아님 (H_644: N2=closure peak). 반환 실수, bool 게이트 0 — 세포 자율 결정 (p5·a_autonomy·F-EMIT-4)."
}
