// ════════════════════════════════════════════════════════════════════════
// DREAM/sleep_pressure_smoke.hexa — T3 homeostatic sleep-pressure drive (Process-S)
//                                    engine-native falsifier smoke
//
// Verifies the § SleepPressure op-slot added to core/dream_lib.hexa against its
// pre-registered falsifier set, AND proves substrate-disjointness against the
// live engine_cli emit-drive lanes 0/4 (ci_emit_drive = Ψ proxy) and the
// §ImmuneMemory recall_thr non-fab honesty gate (a_substrate_disjoint).
//
// This is ENGINE-NATIVE (live core/*.hexa decode of dream_lib + engine_cli), NOT a
// numpy/torch mirror → terminal-eligible per a_engine_native_learning.
//
// Falsifiers (pre-registered, frozen-first):
//   F1 ACCUM     : sp_pressure_wake / sp_pressure_at strictly ↑ with wake ticks.
//   F2 DISCHARGE : sp_pressure_sleep / sp_pressure_at strictly ↓ with sleep ticks.
//   F3 GATE-BIAS : sp_sleep_propensity strictly ↑ with pressure, graded in (0,1)
//                  (additive, NOT a boolean gate).
//   F4 ABLATION  : with pressure frozen out (sp_sleep_propensity_ablated), the
//                  propensity is INVARIANT to wake-duration AND differs from ON
//                  (mechanism is NOT inert — it actually contributes).
//   F5 DISJOINT  : invoking every sp_* op leaves ci_emit_drive (lanes 0/4, Ψ) and
//                  §ImmuneMemory recall_margin BYTE-IDENTICAL (separation=preservation).
// ════════════════════════════════════════════════════════════════════════

use "core/dream_lib"
import "core/engine_cli.hexa"

fn main() {
    println("=== DREAM/sleep_pressure_smoke (T3 Process-S) ===")

    let s0 = 0.10   // seed pressure (rested-but-not-zero)

    // ── F1 ACCUM: monotone accumulation over the WAKE window ──────────────────
    // sample sp_pressure_at at rising wake ticks 0,10,...,50 — each strictly > prev.
    let mut f1_mono = true
    let mut prev = -1.0
    let mut w = 0
    while w <= 55 {
        let p = sp_pressure_at(w, s0)
        if p <= prev { f1_mono = false }
        prev = p
        w = w + 5
    }
    let p_wake_lo = sp_pressure_at(5,  s0)
    let p_wake_hi = sp_pressure_at(55, s0)
    let f1 = f1_mono && (p_wake_hi > p_wake_lo) && (p_wake_hi <= 1.0)
    println("F1 ACCUM     sp(5)=" + str(p_wake_lo) + " < sp(55)=" + str(p_wake_hi)
            + "  " + (if f1 { "PASS (monotone accumulate)" } else { "FAIL" }))

    // ── F2 DISCHARGE: monotone discharge across the sleep window [60..89] ──────
    let mut f2_mono = true
    prev = 2.0
    let mut t = 60
    while t <= 89 {
        let p = sp_pressure_at(t, s0)
        if p >= prev { f2_mono = false }
        prev = p
        t = t + 3
    }
    let p_sleep_onset = sp_pressure_at(60, s0)
    let p_sleep_end   = sp_pressure_at(89, s0)
    let f2 = f2_mono && (p_sleep_end < p_sleep_onset)
    println("F2 DISCHARGE onset(60)=" + str(p_sleep_onset) + " > end(89)=" + str(p_sleep_end)
            + "  " + (if f2 { "PASS (monotone discharge)" } else { "FAIL" }))

    // ── F3 GATE-BIAS: propensity strictly ↑ with pressure, graded (not boolean) ─
    let circ = sp_circadian_bias(55)          // fixed rhythm phase near sleep onset
    let prop_lowp  = sp_sleep_propensity(0.10, circ)
    let prop_midp  = sp_sleep_propensity(0.50, circ)
    let prop_highp = sp_sleep_propensity(0.95, circ)
    let f3_mono  = (prop_highp > prop_midp) && (prop_midp > prop_lowp)
    // graded = strictly inside (0,1) at mid pressure, i.e. NOT a 0/1 boolean gate.
    let f3_graded = (prop_midp > 0.0) && (prop_midp < 1.0)
    let f3 = f3_mono && f3_graded
    println("F3 GATE-BIAS prop(p=.1)=" + str(prop_lowp) + " < prop(.5)=" + str(prop_midp)
            + " < prop(.95)=" + str(prop_highp)
            + "  " + (if f3 { "PASS (additive graded, not boolean)" } else { "FAIL" }))

    // ── F4 ABLATION: freeze pressure out → propensity ⟂ wake-duration, ON≠OFF ──
    let circ_fixed = sp_circadian_bias(40)
    // ON path fed by pressure at two very different wake-durations:
    let on_wake10  = sp_sleep_propensity(sp_pressure_at(10, s0), circ_fixed)
    let on_wake50  = sp_sleep_propensity(sp_pressure_at(50, s0), circ_fixed)
    // OFF (ablated) path — pressure frozen out, takes ONLY circadian:
    let off_wake10 = sp_sleep_propensity_ablated(circ_fixed)
    let off_wake50 = sp_sleep_propensity_ablated(circ_fixed)
    let f4_invariant = (off_wake10 == off_wake50)             // ablated ⟂ wake-duration
    let f4_on_varies = (on_wake10 != on_wake50)               // ON path DOES track wake
    let f4_not_inert = (on_wake50 != off_wake50)              // mechanism contributes (not INERT)
    let f4 = f4_invariant && f4_on_varies && f4_not_inert
    println("F4 ABLATION  OFF(w10)=" + str(off_wake10) + "==OFF(w50)=" + str(off_wake50)
            + " | ON(w10)=" + str(on_wake10) + "!=ON(w50)=" + str(on_wake50)
            + "  " + (if f4 { "PASS (frozen⟂wake, ON≠OFF non-inert)" } else { "FAIL" }))

    // ── F5 DISJOINT: Ψ (ci_emit_drive lanes 0/4) + §ImmuneMemory recall_thr gate ─
    //    must be BYTE-IDENTICAL before vs after invoking the Process-S ops.
    // (a) Ψ proxy — the live emit-drive read over lanes 0/4.
    let lanes = [0.62, 0.11, 0.44, 0.20, 0.58, 0.33, 0.05, 0.71,
                 0.19, 0.40, 0.66, 0.28, 0.13, 0.52, 0.37]
    let psi_before = ci_emit_drive(lanes)
    // (b) §ImmuneMemory non-fab gate — recall margin (= recon_err − recall_thr).
    let key0 = [0.30, 0.60, 0.10, 0.90, 0.25, 0.75, 0.40, 0.55]
    let probe = [0.31, 0.59, 0.11, 0.88, 0.26, 0.74, 0.41, 0.54]
    let mem = immune_memory_new(key0, "anchor-A", 32)
    let margin_before = immune_memory_recall_margin(mem, probe)

    // ── invoke the ENTIRE Process-S surface (the only "mechanism ON" action) ──
    let mut sink = 0.0
    let mut k = 0
    while k <= 89 {
        sink = sink + sp_pressure_at(k, s0)
        sink = sink + sp_sleep_propensity(sp_pressure_at(k, s0), sp_circadian_bias(k))
        sink = sink + sp_sleep_propensity_ablated(sp_circadian_bias(k))
        k = k + 1
    }

    // re-read Ψ and the recall gate AFTER the Process-S ops fired.
    let psi_after    = ci_emit_drive(lanes)
    let margin_after = immune_memory_recall_margin(mem, probe)
    let psi_identical    = (psi_before == psi_after)
    let margin_identical = (margin_before == margin_after)
    let f5 = psi_identical && margin_identical
    println("F5 DISJOINT  Psi " + str(psi_before) + "->" + str(psi_after)
            + " | recall_margin " + str(margin_before) + "->" + str(margin_after)
            + "  " + (if f5 { "PASS (byte-identical, separation=preservation)" } else { "FAIL" }))
    println("             (sink=" + str(sink) + " — proves the sp_* ops actually executed)")

    let all_pass = f1 && f2 && f3 && f4 && f5
    println("")
    println(if all_pass { "ALL FALSIFIERS PASS (5/5) — T3 engine-native GREEN + disjoint" }
            else { "FALSIFIER FAILURE" })
}
