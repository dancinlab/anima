// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_lib_smoke.hexa — 5-stage envelope round-trip smoke (M1 2026-05-28)
//
// 정체: dream_lib.hexa PURE wrapper 의 5-stage transition + envelope +
//      density primitives 를 invariant 형태로 검증.
//      bench/axis_dream/bench.hexa (PR #1140) 의 stage encoding 보존 확인.
//
// Invariants (10):
//   I1: dr_stage_at(0)   == 0   (WAKE)
//   I2: dr_stage_at(65)  == 1   (N1)
//   I3: dr_stage_at(75)  == 2   (N2)
//   I4: dr_stage_at(85)  == 3   (N3)
//   I5: dr_stage_at(89)  == 4   (REM)
//   I6: dr_stage_size(0) + ... + dr_stage_size(4) == 90  (totality)
//   I7: dr_mitosis_prior(3) == 0.80 && dr_mitosis_prior(0) == 0.10  (REM≫WAKE)
//   I8: dr_imagination_active(4) == 1 && dr_imagination_active(0) == 0
//   I9: dr_emit_envelope(0) == 1 && dr_emit_envelope(3) == 0  (REM/N3 emit suppress)
//   I10: dr_mitosis_density_ratio(7,7,1,60) > 6.0  (sleep dominance simulation)
// ════════════════════════════════════════════════════════════════════════

use "DREAM/dream_lib"

fn main() {
    println("=== DREAM/dream_lib_smoke ===")

    // I1-I5: stage_at boundary checks
    let s0  = dr_stage_at(0)
    let s65 = dr_stage_at(65)
    let s75 = dr_stage_at(75)
    let s85 = dr_stage_at(85)
    let s89 = dr_stage_at(89)

    // I6: stage_size totality
    let total = dr_stage_size(0) + dr_stage_size(1) + dr_stage_size(2) + dr_stage_size(3) + dr_stage_size(4)

    // I7: mitosis_prior REM ≫ WAKE
    let prior_n3   = dr_mitosis_prior(3)
    let prior_wake = dr_mitosis_prior(0)

    // I8: imagination only in REM/N3
    let img_rem  = dr_imagination_active(4)
    let img_wake = dr_imagination_active(0)

    // I9: emit envelope WAKE → 1, REM/N3 → 0
    let env_wake = dr_emit_envelope(0)
    let env_n3   = dr_emit_envelope(3)

    // I10: density ratio (REM-like 7/7 = 1.0 vs WAKE-like 1/60 ≈ 0.017) ≈ 60×
    let ratio = dr_mitosis_density_ratio(7, 7, 1, 60)

    let i1  = s0 == 0
    let i2  = s65 == 1
    let i3  = s75 == 2
    let i4  = s85 == 3
    let i5  = s89 == 4
    let i6  = total == 90
    let i7  = prior_n3 > 0.79 && prior_wake < 0.11
    let i8  = img_rem == 1 && img_wake == 0
    let i9  = env_wake == 1 && env_n3 == 0
    let i10 = ratio > 6.0

    println("I1  WAKE(0)=0      "  + (if i1  { "PASS" } else { "FAIL" }))
    println("I2  N1(65)=1       "  + (if i2  { "PASS" } else { "FAIL" }))
    println("I3  N2(75)=2       "  + (if i3  { "PASS" } else { "FAIL" }))
    println("I4  N3(85)=3       "  + (if i4  { "PASS" } else { "FAIL" }))
    println("I5  REM(89)=4      "  + (if i5  { "PASS" } else { "FAIL" }))
    println("I6  size_sum=90    "  + (if i6  { "PASS" } else { "FAIL" }))
    println("I7  REM/WAKE prior "  + (if i7  { "PASS (8x split prior)" } else { "FAIL" }))
    println("I8  imagination    "  + (if i8  { "PASS (REM=1 WAKE=0)"   } else { "FAIL" }))
    println("I9  emit envelope  "  + (if i9  { "PASS (WAKE=1 N3=0)"    } else { "FAIL" }))
    println("I10 density ratio  "  + (if i10 { "PASS (ratio=" + str(ratio) + ")" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8 && i9 && i10
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (10/10)" } else { "INVARIANT FAILURE" })
}
