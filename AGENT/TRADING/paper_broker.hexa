// paper_broker.hexa — Simulated broker for paper trading (M4 closure)
// Bridge architecture: tool surface only — no consciousness framing.
//
// Same 5-verb interface as a real broker will expose:
//   get_quote(symbol)           — current bid/ask/last
//   place_order(order)          — submit Order; returns Trade or status=rejected
//   cancel_order(order_id)      — cancel pending order
//   list_positions()            — current open positions
//   get_portfolio()             — cash + positions + PnL
//
// State is held in a Map ("paper_state") that callers thread through —
// no global state, byte-clean & test-friendly. live_broker (M5) will plug
// the same verbs into a real KIS / IBKR / Alpaca client.

import "/Users/ghost/core/anima/AGENT/TRADING/types.hexa"

// ---------------------------------------------------------------
// 1. paper_broker_new — initialize broker with starting cash
//   returns state Map { cash, positions, orders, trades, fee_bps, slippage_bps }
// ---------------------------------------------------------------
pub fn paper_broker_new(initial_cash, fee_bps, slippage_bps) {
    return #{
        "cash": initial_cash,
        "positions": [],
        "open_orders": [],
        "trades": [],
        "fee_bps": fee_bps,
        "slippage_bps": slippage_bps,
        "next_order_id": 1,
        "kind": "PaperBrokerState",
    }
}

// ---------------------------------------------------------------
// 2. paper_broker_get_quote — simulated quote at given last price
//   state: PaperBrokerState
//   symbol: Symbol Map
//   last_price: current market mid (caller supplies; live broker fetches)
//   returns Quote Map (M2 type)
// ---------------------------------------------------------------
pub fn paper_broker_get_quote(state, symbol, last_price, ts) {
    let slip = state["slippage_bps"]
    let bps_div = 10000.0
    let bid = last_price * (1.0 - slip / bps_div)
    let ask = last_price * (1.0 + slip / bps_div)
    return trading_quote(symbol, bid, ask, last_price, ts)
}

// ---------------------------------------------------------------
// 3. paper_broker_place_order — execute an order at market (immediate fill)
//   only "market" orders fill immediately; "limit" goes to open_orders.
//   returns { state, trade or void }
// ---------------------------------------------------------------
pub fn paper_broker_place_order(state, order, last_price, ts) {
    let order_type = order["order_type"]
    let side = order["side"]
    let qty = order["quantity"]
    let fee_bps = state["fee_bps"]
    let slip_bps = state["slippage_bps"]
    let bps_div = 10000.0

    // assign order_id
    let oid = state["next_order_id"]
    let order_id_str = "PB-" + str(oid)
    let new_next_id = oid + 1

    if order_type == "limit" {
        // queue the order with assigned id (M4 keeps limit pending, no matching engine yet)
        let pending = #{
            "symbol": order["symbol"],
            "side": side,
            "order_type": "limit",
            "quantity": qty,
            "limit_price": order["limit_price"],
            "status": "pending",
            "order_id": order_id_str,
            "kind": "Order",
        }
        let new_open = state["open_orders"] + [pending]
        let new_state = #{
            "cash": state["cash"],
            "positions": state["positions"],
            "open_orders": new_open,
            "trades": state["trades"],
            "fee_bps": state["fee_bps"],
            "slippage_bps": state["slippage_bps"],
            "next_order_id": new_next_id,
            "kind": "PaperBrokerState",
        }
        return #{
            "state": new_state,
            "trade": "",
            "order_id": order_id_str,
        }
    }

    // market order — immediate fill at last_price ± slippage
    if side == "buy" {
        let fill_price = last_price * (1.0 + slip_bps / bps_div)
        let gross = qty * fill_price
        let fee = gross * fee_bps / bps_div
        let total_cost = gross + fee
        if total_cost > state["cash"] {
            // rejection — insufficient funds
            let rejected = #{
                "symbol": order["symbol"],
                "side": side,
                "order_type": "market",
                "quantity": qty,
                "limit_price": 0.0,
                "status": "rejected",
                "order_id": order_id_str,
                "reason": "insufficient_cash",
                "kind": "Order",
            }
            let new_state = #{
                "cash": state["cash"],
                "positions": state["positions"],
                "open_orders": state["open_orders"],
                "trades": state["trades"],
                "fee_bps": state["fee_bps"],
                "slippage_bps": state["slippage_bps"],
                "next_order_id": new_next_id,
                "kind": "PaperBrokerState",
            }
            return #{
                "state": new_state,
                "trade": "",
                "order_id": order_id_str,
                "rejected": rejected,
            }
        }
        // accept — open or add to position
        let new_pos = trading_position(order["symbol"], "long", fill_price, qty, last_price)
        let filled_order = #{
            "symbol": order["symbol"],
            "side": "buy",
            "order_type": "market",
            "quantity": qty,
            "limit_price": fill_price,
            "status": "filled",
            "order_id": order_id_str,
            "kind": "Order",
        }
        let trd = trading_trade(filled_order, fill_price, qty, fee, ts)
        let new_state = #{
            "cash": state["cash"] - total_cost,
            "positions": state["positions"] + [new_pos],
            "open_orders": state["open_orders"],
            "trades": state["trades"] + [trd],
            "fee_bps": state["fee_bps"],
            "slippage_bps": state["slippage_bps"],
            "next_order_id": new_next_id,
            "kind": "PaperBrokerState",
        }
        return #{
            "state": new_state,
            "trade": trd,
            "order_id": order_id_str,
        }
    }

    if side == "sell" {
        // close first matching long position
        let positions = state["positions"]
        let np = positions.len()
        if np == 0 {
            let rejected = #{
                "symbol": order["symbol"],
                "side": "sell",
                "order_type": "market",
                "quantity": qty,
                "limit_price": 0.0,
                "status": "rejected",
                "order_id": order_id_str,
                "reason": "no_position",
                "kind": "Order",
            }
            let new_state = #{
                "cash": state["cash"],
                "positions": state["positions"],
                "open_orders": state["open_orders"],
                "trades": state["trades"],
                "fee_bps": state["fee_bps"],
                "slippage_bps": state["slippage_bps"],
                "next_order_id": new_next_id,
                "kind": "PaperBrokerState",
            }
            return #{
                "state": new_state,
                "trade": "",
                "order_id": order_id_str,
                "rejected": rejected,
            }
        }
        let pos = positions[0]
        let fill_qty = pos["quantity"]
        let entry = pos["entry_price"]
        let fill_price = last_price * (1.0 - slip_bps / bps_div)
        let gross = fill_qty * fill_price
        let fee = gross * fee_bps / bps_div
        let proceeds = gross - fee
        let filled_order = #{
            "symbol": order["symbol"],
            "side": "sell",
            "order_type": "market",
            "quantity": fill_qty,
            "limit_price": fill_price,
            "status": "filled",
            "order_id": order_id_str,
            "kind": "Order",
        }
        let trd = trading_trade(filled_order, fill_price, fill_qty, fee, ts)
        let new_state = #{
            "cash": state["cash"] + proceeds,
            "positions": [],
            "open_orders": state["open_orders"],
            "trades": state["trades"] + [trd],
            "fee_bps": state["fee_bps"],
            "slippage_bps": state["slippage_bps"],
            "next_order_id": new_next_id,
            "kind": "PaperBrokerState",
        }
        return #{
            "state": new_state,
            "trade": trd,
            "order_id": order_id_str,
        }
    }

    // unknown side — reject
    return #{
        "state": state,
        "trade": "",
        "order_id": "",
        "rejected": #{ "reason": "unknown_side", "side": side },
    }
}

// ---------------------------------------------------------------
// 4. paper_broker_cancel_order — remove pending limit order by id
// ---------------------------------------------------------------
pub fn paper_broker_cancel_order(state, order_id) {
    let open = state["open_orders"]
    let n = open.len()
    let new_open = []
    let cancelled = false
    let i = 0
    while i < n {
        let o = open[i]
        if o["order_id"] == order_id {
            cancelled = true
        } else {
            new_open = new_open + [o]
        }
        i = i + 1
    }
    let new_state = #{
        "cash": state["cash"],
        "positions": state["positions"],
        "open_orders": new_open,
        "trades": state["trades"],
        "fee_bps": state["fee_bps"],
        "slippage_bps": state["slippage_bps"],
        "next_order_id": state["next_order_id"],
        "kind": "PaperBrokerState",
    }
    return #{
        "state": new_state,
        "cancelled": cancelled,
    }
}

// ---------------------------------------------------------------
// 5. paper_broker_list_positions — current open positions
// ---------------------------------------------------------------
pub fn paper_broker_list_positions(state) {
    return state["positions"]
}

// ---------------------------------------------------------------
// 6. paper_broker_get_portfolio — Portfolio view (M2 type)
//   last_price: caller supplies for mark-to-market unrealized PnL
// ---------------------------------------------------------------
pub fn paper_broker_get_portfolio(state, last_price) {
    // mark-to-market each position before passing to Portfolio
    let positions = state["positions"]
    let n = positions.len()
    let mtm_positions = []
    let i = 0
    while i < n {
        let p = positions[i]
        let mtm = trading_position(p["symbol"], p["side"], p["entry_price"], p["quantity"], last_price)
        mtm_positions = mtm_positions + [mtm]
        i = i + 1
    }
    // realized_pnl = sum of (sell.fill_price - earlier buy.fill_price - fees) for paired trades — naive: trade fees only summed here
    let trades = state["trades"]
    let nt = trades.len()
    let realized = 0.0
    let j = 0
    while j + 1 < nt {
        let a = trades[j]
        let b = trades[j + 1]
        let a_side = a["order"]["side"]
        let b_side = b["order"]["side"]
        if a_side == "buy" {
            if b_side == "sell" {
                let pnl = (b["fill_price"] - a["fill_price"]) * b["fill_qty"] - a["fees"] - b["fees"]
                realized = realized + pnl
                j = j + 2
                continue
            }
        }
        j = j + 1
    }
    return trading_portfolio(state["cash"], mtm_positions, realized)
}

// ---------------------------------------------------------------
// 7. paper_broker_summary — one-line status
// ---------------------------------------------------------------
pub fn paper_broker_summary(state) {
    return "PaperBroker: cash=" + str(state["cash"]) + " · positions=" + str(state["positions"].len()) + " · open_orders=" + str(state["open_orders"].len()) + " · trades=" + str(state["trades"].len())
}
