        // synthetic quote — caller knows this is a stub
        return #{
            "symbol": symbol,
            "bid": 0.0,
            "ask": 0.0,
            "last": 0.0,
            "spread": 0.0,
            "ts": 0,
            "kind": "Quote",
            "stub": true,
            "reason": "DRYRUN — real quote not fetched",
        }
    }
    if state["configured"] == false {
        return #{
            "symbol": symbol,
            "bid": 0.0,
            "ask": 0.0,
            "last": 0.0,
            "spread": 0.0,
            "ts": 0,
            "kind": "Quote",
            "stub": true,
            "reason": "kis_not_configured — call kis_broker_configure first",
        }
    }
    // TODO: real KIS API call (intentionally not implemented in M5)
    return #{
        "symbol": symbol,
        "bid": 0.0,
        "ask": 0.0,
        "last": 0.0,
        "spread": 0.0,
        "ts": 0,
        "kind": "Quote",
        "stub": true,
        "reason": "real_api_not_implemented — M5 stub closure",
    }
}

// ---------------------------------------------------------------
// 4. kis_broker_place_order — STUB · gate-checked, never fires real order
//   ALWAYS routes through live_gate first.
//   returns { state, gate_verdict, result }
// ---------------------------------------------------------------
pub fn kis_broker_place_order(state, gate_state, order, ref_price, current_positions) {
    // STEP 1 — gate check (M5 핵심)
    let verdict = live_gate_enforce(gate_state, order, ref_price, current_positions)
    if verdict["accepted"] == false {
        return #{
            "broker_state": state,
            "gate_state": gate_state,
            "gate_verdict": verdict,
            "result": #{
                "filled": false,
                "reason": "gate_refused — " + verdict["reason"],
                "kind": "KisOrderResult",
            },
        }
    }

    // STEP 2 — even if gate accepts, stub never fires
    let new_gate_state = verdict["audit_state"]
    if state["env"] == "DRYRUN" {
        return #{
            "broker_state": state,
            "gate_state": new_gate_state,
            "gate_verdict": verdict,
            "result": #{
                "filled": false,
                "reason": "DRYRUN — gate ACCEPTED but no real order placed",
                "would_send": order,
                "kind": "KisOrderResult",
            },
        }
    }

    if state["configured"] == false {
        return #{
            "broker_state": state,
            "gate_state": new_gate_state,
            "gate_verdict": verdict,
            "result": #{
                "filled": false,
                "reason": "kis_not_configured — gate ACCEPTED but secrets missing",
                "kind": "KisOrderResult",
            },
        }
    }

    // TODO: real KIS POST /uapi/domestic-stock/v1/trading/order-cash
    // (intentionally not implemented in M5 — real fire requires user wire-up)
    return #{
        "broker_state": state,
        "gate_state": new_gate_state,
        "gate_verdict": verdict,
        "result": #{
            "filled": false,
            "reason": "real_api_not_implemented — gate ACCEPTED but stub still refuses",
            "would_send": order,
            "kind": "KisOrderResult",
        },
    }
}

