// ---------------------------------------------------------------
// 7. kis_broker_summary — one-line status
// ---------------------------------------------------------------
pub fn kis_broker_summary(state) {
    let cfg = "unconfigured"
    if state["configured"] {
        cfg = "configured"
    }
    return "KisBroker [STUB]: env=" + state["env"] + " · account=" + state["account_no"] + " · " + cfg
}
