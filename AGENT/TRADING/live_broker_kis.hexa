// ---------------------------------------------------------------
// 1. kis_broker_new — initialize the KIS adapter (DRYRUN by default)
//   env: "DRYRUN" (default · no real calls) · "REAL" (requires keys)
// ---------------------------------------------------------------
pub fn kis_broker_new(env, account_no) {
    return #{
        "env": env,
        "account_no": account_no,
        "app_key": "",
        "app_secret": "",
        "access_token": "",
        "configured": false,
        "kind": "KisBrokerState",
    }
}

// ---------------------------------------------------------------
// 2. kis_broker_configure — wire secrets (caller passes — never logged)
//   app_key/secret expected via `secret get kis.app_key` etc.
// ---------------------------------------------------------------
pub fn kis_broker_configure(state, app_key, app_secret) {
    let configured = false
    if app_key != "" {
        if app_secret != "" {
            configured = true
        }
    }
    return #{
        "env": state["env"],
        "account_no": state["account_no"],
        "app_key": app_key,
        "app_secret": app_secret,
        "access_token": "",
        "configured": configured,
        "kind": "KisBrokerState",
    }
}

