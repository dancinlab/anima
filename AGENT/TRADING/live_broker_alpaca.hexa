// live_broker_alpaca.hexa — Alpaca US-stock broker adapter STUB (TRADING M10)
// Bridge architecture: tool surface only — no consciousness framing.
//
// ⚠ STUB ONLY — no real HTTP calls. M10 delivers the SHAPE (7 pub fn matching
// kis_broker + paper_broker) without ever placing a real order.
//
// Alpaca = ✨ 2026 BrokerChooser "Best Broker for Algorithmic Trading":
//   • PAPER endpoint:  https://paper-api.alpaca.markets    (가상매매, 위험 0)
//   • LIVE  endpoint:  https://api.alpaca.markets          (실 매매 ⚠)
//   • Auth: header `APCA-API-KEY-ID` + `APCA-API-SECRET-KEY`
//   • Rate: 200 req/min (free) · 1000 req/min (funded)
//
// All real fills route through live_gate.live_gate_enforce FIRST.

import "/Users/ghost/core/anima/AGENT/TRADING/types.hexa"
import "/Users/ghost/core/anima/AGENT/TRADING/live_gate.hexa"

// ---------------------------------------------------------------
// 1. alpaca_broker_new — initialize the Alpaca adapter
//   env: "DRYRUN" (default · no call) · "PAPER" (would hit paper endpoint) ·
//        "LIVE" (would hit live endpoint)
// ---------------------------------------------------------------
pub fn alpaca_broker_new(env) {
    let endpoint = "https://paper-api.alpaca.markets"
    if env == "LIVE" {
        endpoint = "https://api.alpaca.markets"
    }
    return #{
        "env": env,
        "endpoint": endpoint,
        "api_key": "",
        "api_secret": "",
        "configured": false,
        "kind": "AlpacaBrokerState",
    }
}

// ---------------------------------------------------------------
// 2. alpaca_broker_configure — wire secrets (caller passes; never logged)
// ---------------------------------------------------------------
pub fn alpaca_broker_configure(state, api_key, api_secret) {
    let cfg = false
    if api_key != "" {
        if api_secret != "" {
            cfg = true
        }
    }
    return #{
        "env": state["env"],
        "endpoint": state["endpoint"],
        "api_key": api_key,
        "api_secret": api_secret,
        "configured": cfg,
        "kind": "AlpacaBrokerState",
    }
}

// ---------------------------------------------------------------
// 3. alpaca_broker_get_quote — STUB · returns a synthetic Quote
//   real: GET /v2/stocks/{symbol}/quotes/latest
// ---------------------------------------------------------------
pub fn alpaca_broker_get_quote(state, symbol) {
    return #{
        "symbol": symbol,
        "bid": 0.0,
        "ask": 0.0,
        "last": 0.0,
        "spread": 0.0,
        "ts": 0,
        "kind": "Quote",
        "stub": true,
        "reason": "STUB — real Alpaca quote API not implemented in M10",
    }
}

// ---------------------------------------------------------------
// 4. alpaca_broker_place_order — STUB · gate-checked, never fires real order
//   real: POST /v2/orders  (body: symbol, qty, side, type, time_in_force)
// ---------------------------------------------------------------
pub fn alpaca_broker_place_order(state, gate_state, order, ref_price, current_positions) {
    // STEP 1 — gate check
    let verdict = live_gate_enforce(gate_state, order, ref_price, current_positions)
    if verdict["accepted"] == false {
        return #{
            "broker_state": state,
            "gate_state": gate_state,
            "gate_verdict": verdict,
            "result": #{
                "filled": false,
                "reason": "gate_refused — " + verdict["reason"],
                "kind": "AlpacaOrderResult",
            },
        }
    }

    let new_gate_state = verdict["audit_state"]

    if state["env"] == "DRYRUN" {
        return #{
            "broker_state": state,
            "gate_state": new_gate_state,
            "gate_verdict": verdict,
            "result": #{
                "filled": false,
                "reason": "DRYRUN — gate ACCEPTED but no real order placed",
                "would_send": order,
                "kind": "AlpacaOrderResult",
            },
        }
    }

    if state["configured"] == false {
        return #{
            "broker_state": state,
            "gate_state": new_gate_state,
            "gate_verdict": verdict,
            "result": #{
                "filled": false,
                "reason": "alpaca_not_configured — gate ACCEPTED but secrets missing",
                "kind": "AlpacaOrderResult",
            },
        }
    }

    // TODO: real Alpaca POST /v2/orders (intentionally not implemented in M10)
    return #{
        "broker_state": state,
        "gate_state": new_gate_state,
        "gate_verdict": verdict,
        "result": #{
            "filled": false,
            "reason": "real_api_not_implemented — gate ACCEPTED but stub still refuses",
            "would_send": order,
            "endpoint": state["endpoint"],
            "kind": "AlpacaOrderResult",
        },
    }
}

// ---------------------------------------------------------------
// 5. alpaca_broker_cancel_order — STUB
//   real: DELETE /v2/orders/{order_id}
// ---------------------------------------------------------------
pub fn alpaca_broker_cancel_order(state, order_id) {
    return #{
        "cancelled": false,
        "reason": "STUB — real Alpaca cancel not implemented in M10",
        "order_id": order_id,
        "kind": "AlpacaCancelResult",
    }
}

// ---------------------------------------------------------------
// 6. alpaca_broker_list_positions — STUB
//   real: GET /v2/positions
// ---------------------------------------------------------------
pub fn alpaca_broker_list_positions(state) {
    return []
}

// ---------------------------------------------------------------
// 7. alpaca_broker_summary
// ---------------------------------------------------------------
pub fn alpaca_broker_summary(state) {
    let cfg = "unconfigured"
    if state["configured"] {
        cfg = "configured"
    }
    return "AlpacaBroker [STUB]: env=" + state["env"] + " · endpoint=" + state["endpoint"] + " · " + cfg
}
