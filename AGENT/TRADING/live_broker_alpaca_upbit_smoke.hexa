// live_broker_alpaca_upbit_smoke.hexa — TRADING M10 + M13 verify
// 12-case smoke covering both Alpaca (US stocks) and Upbit (KR crypto).

import "/Users/ghost/core/anima/AGENT/TRADING/types.hexa"
import "/Users/ghost/core/anima/AGENT/TRADING/live_gate.hexa"
import "/Users/ghost/core/anima/AGENT/TRADING/live_broker_alpaca.hexa"
import "/Users/ghost/core/anima/AGENT/TRADING/live_broker_upbit.hexa"

fn assert_eq(label, got, want) {
    if got == want {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label + " got=" + str(got) + " want=" + str(want))
    return false
}

fn main() {
    print("=== TRADING M10 + M13 Alpaca + Upbit smoke ===")

    // ─── ALPACA (US stocks) ──────────────────────────────────────
    print("--- Alpaca ---")

    let aapl = trading_symbol("AAPL", "alpaca", "stock")

    // A1: new DRYRUN (paper endpoint default)
    let a_state = alpaca_broker_new("DRYRUN")
    assert_eq("A1.kind", a_state["kind"], "AlpacaBrokerState")
    assert_eq("A1.env", a_state["env"], "DRYRUN")
    assert_eq("A1.paper_endpoint", a_state["endpoint"], "https://paper-api.alpaca.markets")
    assert_eq("A1.unconfigured", a_state["configured"], false)

    // A1b: new LIVE → live endpoint
    let a_live = alpaca_broker_new("LIVE")
    assert_eq("A1b.live_endpoint", a_live["endpoint"], "https://api.alpaca.markets")

    // A2: configure both secrets
    let a_cfg = alpaca_broker_configure(a_state, "PKABC123", "stub-secret")
    assert_eq("A2.configured", a_cfg["configured"], true)
    // missing secret → unconfigured
    let a_bad = alpaca_broker_configure(a_state, "PKABC", "")
    assert_eq("A2b.missing_secret", a_bad["configured"], false)

    // A3: get_quote returns stub quote
    let a_quote = alpaca_broker_get_quote(a_state, aapl)
    assert_eq("A3.quote_kind", a_quote["kind"], "Quote")
    assert_eq("A3.quote_is_stub", a_quote["stub"], true)

    // A4: place_order on L0 gate → refused, no fill
    let g0 = live_gate_new(10000.0, 50000.0, 5)
    let buy_order = trading_order(aapl, "buy", "market", 10.0, 150.0)
    let a_r1 = alpaca_broker_place_order(a_state, g0, buy_order, 150.0, 0)
    assert_eq("A4.gate_refused", a_r1["gate_verdict"]["accepted"], false)
    assert_eq("A4.no_fill", a_r1["result"]["filled"], false)

    // A5: place_order on L1 gate · DRYRUN → gate accepts, broker still no-fill
    let g1 = live_gate_approve_session(g0, "alpaca smoke")
    let a_r2 = alpaca_broker_place_order(a_state, g1, buy_order, 150.0, 0)
    assert_eq("A5.gate_accepted", a_r2["gate_verdict"]["accepted"], true)
    assert_eq("A5.dryrun_no_fill", a_r2["result"]["filled"], false)

    // ─── UPBIT (KR crypto KRW market) ────────────────────────────
    print("--- Upbit ---")

    let btc = trading_symbol("KRW-BTC", "upbit", "crypto")

    // U1: new DRYRUN with KRW market
    let u_state = upbit_broker_new("DRYRUN", "KRW")
    assert_eq("U1.kind", u_state["kind"], "UpbitBrokerState")
    assert_eq("U1.env", u_state["env"], "DRYRUN")
    assert_eq("U1.market", u_state["market_quote"], "KRW")
    assert_eq("U1.endpoint", u_state["endpoint"], "https://api.upbit.com/v1")
    assert_eq("U1.unconfigured", u_state["configured"], false)

    // U2: configure secrets
    let u_cfg = upbit_broker_configure(u_state, "access-stub", "secret-stub")
    assert_eq("U2.configured", u_cfg["configured"], true)
    let u_bad = upbit_broker_configure(u_state, "", "secret-stub")
    assert_eq("U2b.missing_access", u_bad["configured"], false)

    // U3: get_quote
    let u_quote = upbit_broker_get_quote(u_state, btc)
    assert_eq("U3.quote_kind", u_quote["kind"], "Quote")
    assert_eq("U3.quote_is_stub", u_quote["stub"], true)

    // U4: L0 gate → refused
    let u_buy = trading_order(btc, "buy", "market", 0.01, 50000000.0)
    let u_r1 = upbit_broker_place_order(u_state, g0, u_buy, 50000000.0, 0)
    assert_eq("U4.gate_refused", u_r1["gate_verdict"]["accepted"], false)
    assert_eq("U4.no_fill", u_r1["result"]["filled"], false)

    // U5: L1 gate + DRYRUN → gate accepts, broker still no-fill
    let g2 = live_gate_new(1000000.0, 5000000.0, 5)  // KRW caps higher
    let g2_open = live_gate_approve_session(g2, "upbit smoke")
    let u_small = trading_order(btc, "buy", "market", 0.001, 50000000.0)
    let u_r2 = upbit_broker_place_order(u_state, g2_open, u_small, 50000000.0, 0)
    assert_eq("U5.gate_accepted", u_r2["gate_verdict"]["accepted"], true)
    assert_eq("U5.dryrun_no_fill", u_r2["result"]["filled"], false)

    // ─── CROSS-BROKER UNIFORMITY ──────────────────────────────────
    print("--- Cross-broker uniformity ---")

    // Both broker results use 5-verb interface (place_order/cancel/list/get_quote)
    let a_cancel = alpaca_broker_cancel_order(a_state, "alpaca-order-id-1")
    let u_cancel = upbit_broker_cancel_order(u_state, "upbit-uuid-1")
    assert_eq("X1.alpaca_cancel_kind", a_cancel["kind"], "AlpacaCancelResult")
    assert_eq("X1.upbit_cancel_kind", u_cancel["kind"], "UpbitCancelResult")

    assert_eq("X2.alpaca_positions_empty", alpaca_broker_list_positions(a_state).len(), 0)
    assert_eq("X2.upbit_positions_empty", upbit_broker_list_positions(u_state).len(), 0)

    print("=== TRADING M10 + M13 Alpaca + Upbit smoke: 12-case PASS ===")
    print(alpaca_broker_summary(a_cfg))
    print(upbit_broker_summary(u_cfg))
}
