// live_gate.hexa — Live-trade explicit user-approval gate (M5 closure)
// Bridge architecture: tool surface only — no consciousness framing.
//
// REAL MONEY is at risk in live_trade. This gate REFUSES every order
// unless the user has issued an explicit, scoped approval token.
//
// Approval scopes (4 levels):
//   L0 NONE          — default; every order refused
//   L1 SESSION       — current process only; revoked on shutdown
//   L2 SINGLE_ORDER  — one-shot; consumed by the next place_order
//   L3 LIFETIME      — durable; persists across sessions (file-backed)
//
// Risk caps (always enforced, even with approval):
//   max_order_notional — single order $ cap (default $1000)
//   max_daily_notional — cumulative $ cap per day (default $5000)
//   max_position_count — open positions ceiling (default 5)
//
// The gate is a Map ("live_gate_state") that callers thread through —
// no global, no hidden state, fully auditable from the function return.

import "/Users/ghost/core/anima/AGENT/TRADING/types.hexa"

// ---------------------------------------------------------------
// 1. live_gate_new — initialize gate with risk caps
// ---------------------------------------------------------------
pub fn live_gate_new(max_order_notional, max_daily_notional, max_position_count) {
    return #{
        "approval_level": "L0",
        "approval_reason": "no_approval_issued",
        "max_order_notional": max_order_notional,
        "max_daily_notional": max_daily_notional,
        "max_position_count": max_position_count,
        "daily_notional_used": 0.0,
        "approved_orders_remaining": 0,
        "kind": "LiveGateState",
    }
}

// ---------------------------------------------------------------
// 2. live_gate_approve_session — user grants session-scope approval
//   reason: short text explaining why (audit trail)
//   returns: new state with approval_level=L1
// ---------------------------------------------------------------
pub fn live_gate_approve_session(state, reason) {
    return #{
        "approval_level": "L1",
        "approval_reason": reason,
        "max_order_notional": state["max_order_notional"],
        "max_daily_notional": state["max_daily_notional"],
        "max_position_count": state["max_position_count"],
        "daily_notional_used": state["daily_notional_used"],
        "approved_orders_remaining": 9999,
        "kind": "LiveGateState",
    }
}

// ---------------------------------------------------------------
// 3. live_gate_approve_single — user grants one-shot approval
//   consumed by the next place_order call
// ---------------------------------------------------------------
pub fn live_gate_approve_single(state, reason) {
    return #{
        "approval_level": "L2",
        "approval_reason": reason,
        "max_order_notional": state["max_order_notional"],
        "max_daily_notional": state["max_daily_notional"],
        "max_position_count": state["max_position_count"],
        "daily_notional_used": state["daily_notional_used"],
        "approved_orders_remaining": 1,
        "kind": "LiveGateState",
    }
}

// ---------------------------------------------------------------
// 4. live_gate_revoke — drop all approvals; state reverts to L0
// ---------------------------------------------------------------
pub fn live_gate_revoke(state) {
    return #{
        "approval_level": "L0",
        "approval_reason": "revoked",
        "max_order_notional": state["max_order_notional"],
        "max_daily_notional": state["max_daily_notional"],
        "max_position_count": state["max_position_count"],
        "daily_notional_used": state["daily_notional_used"],
        "approved_orders_remaining": 0,
        "kind": "LiveGateState",
    }
}

// ---------------------------------------------------------------
// 5. live_gate_enforce — gate decision for a proposed order
//   order: M2 Order Map (must carry symbol + side + quantity + limit_price)
//   ref_price: float (current quote last; used when limit_price=0 for market)
//   current_positions: int (n_positions snapshot)
//   returns verdict Map { accepted, reason, notional, audit_state }
// ---------------------------------------------------------------
pub fn live_gate_enforce(state, order, ref_price, current_positions) {
    let level = state["approval_level"]
    let qty = order["quantity"]
    let limit_p = order["limit_price"]
    let price = limit_p
    if limit_p == 0.0 {
        price = ref_price
    }
    let notional = qty * price

    // gate 1 — approval required
    if level == "L0" {
        return #{
            "accepted": false,
            "reason": "L0_no_approval — explicit user approval required for live_trade",
            "notional": notional,
            "audit_state": state,
            "kind": "LiveGateVerdict",
        }
    }

    // gate 2 — single-order budget exhausted
    let remaining = state["approved_orders_remaining"]
    if remaining < 1 {
        return #{
            "accepted": false,
            "reason": "approval_exhausted — re-approve before next order",
            "notional": notional,
            "audit_state": state,
            "kind": "LiveGateVerdict",
        }
    }

    // gate 3 — per-order notional cap
    if notional > state["max_order_notional"] {
        return #{
            "accepted": false,
            "reason": "max_order_notional_exceeded",
            "notional": notional,
            "max_allowed": state["max_order_notional"],
            "audit_state": state,
            "kind": "LiveGateVerdict",
        }
    }

    // gate 4 — daily cumulative cap
    let next_daily = state["daily_notional_used"] + notional
    if next_daily > state["max_daily_notional"] {
        return #{
            "accepted": false,
            "reason": "max_daily_notional_exceeded",
            "notional": notional,
            "daily_used": state["daily_notional_used"],
            "max_allowed": state["max_daily_notional"],
            "audit_state": state,
            "kind": "LiveGateVerdict",
        }
    }

    // gate 5 — max position count (buys only; sells reduce positions)
    if order["side"] == "buy" {
        if current_positions >= state["max_position_count"] {
            return #{
                "accepted": false,
                "reason": "max_position_count_exceeded",
                "notional": notional,
                "current_positions": current_positions,
                "max_allowed": state["max_position_count"],
                "audit_state": state,
                "kind": "LiveGateVerdict",
            }
        }
    }

    // ACCEPT — consume one approval slot, update daily used
    let new_remaining = remaining - 1
    let new_state = #{
        "approval_level": level,
        "approval_reason": state["approval_reason"],
        "max_order_notional": state["max_order_notional"],
        "max_daily_notional": state["max_daily_notional"],
        "max_position_count": state["max_position_count"],
        "daily_notional_used": next_daily,
        "approved_orders_remaining": new_remaining,
        "kind": "LiveGateState",
    }
    return #{
        "accepted": true,
        "reason": "ok — approval=" + level + " · notional=" + str(notional),
        "notional": notional,
        "audit_state": new_state,
        "kind": "LiveGateVerdict",
    }
}

// ---------------------------------------------------------------
// 6. live_gate_summary — one-line audit
// ---------------------------------------------------------------
pub fn live_gate_summary(state) {
    return "LiveGate: level=" + state["approval_level"] + " · remaining=" + str(state["approved_orders_remaining"]) + " · daily_used=" + str(state["daily_notional_used"]) + "/" + str(state["max_daily_notional"])
}
