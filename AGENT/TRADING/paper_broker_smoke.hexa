// paper_broker_smoke.hexa — TRADING M4 paper broker round-trip verify
// 6-case smoke: new / get_quote / place buy / place sell / reject (no funds) / cancel limit

import "/Users/ghost/core/anima/AGENT/TRADING/types.hexa"
import "/Users/ghost/core/anima/AGENT/TRADING/paper_broker.hexa"

fn assert_eq(label, got, want) {
    if got == want {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label + " got=" + str(got) + " want=" + str(want))
    return false
}

fn main() {
    print("=== TRADING M4 paper_broker smoke ===")

    let sym = trading_symbol("BTCUSDT", "binance", "crypto")

    // C1: new broker
    let pb = paper_broker_new(10000.0, 10, 5)
    assert_eq("C1.kind", pb["kind"], "PaperBrokerState")
    assert_eq("C1.cash", pb["cash"], 10000.0)
    assert_eq("C1.positions_empty", pb["positions"].len(), 0)
    assert_eq("C1.next_order_id", pb["next_order_id"], 1)

    // C2: get_quote at 50000
    let q = paper_broker_get_quote(pb, sym, 50000.0, 1700000000000)
    assert_eq("C2.kind", q["kind"], "Quote")
    assert_eq("C2.last", q["last"], 50000.0)
    // bid = 50000 * (1 - 5/10000) = 49975 · ask = 50025
    assert_eq("C2.bid", q["bid"], 49975.0)
    assert_eq("C2.ask", q["ask"], 50025.0)

    // C3: place buy market — fills immediately
    let buy_order = trading_order(sym, "buy", "market", 0.1, 0.0)
    let r1 = paper_broker_place_order(pb, buy_order, 50000.0, 1700000060000)
    let pb1 = r1["state"]
    assert_eq("C3.order_id", r1["order_id"], "PB-1")
    let buy_trd = r1["trade"]
    assert_eq("C3.trade_kind", buy_trd["kind"], "Trade")
    assert_eq("C3.positions_after_buy", pb1["positions"].len(), 1)
    // cash = 10000 - 0.1 * 50025 - 0.1 * 50025 * 10/10000 = 10000 - 5002.5 - 5.0025 = 4992.4975
    let cash_after_buy = pb1["cash"]
    if cash_after_buy < 5000.0 {
        print("  [ok] C3.cash_decremented (got=" + str(cash_after_buy) + ")")
    } else {
        print("  [FAIL] C3.cash_decremented got=" + str(cash_after_buy))
    }

    // C4: place sell market — closes position, cash restored + profit (if price up)
    let sell_order = trading_order(sym, "sell", "market", 0.1, 0.0)
    let r2 = paper_broker_place_order(pb1, sell_order, 55000.0, 1700000120000)
    let pb2 = r2["state"]
    assert_eq("C4.positions_after_sell", pb2["positions"].len(), 0)
    let cash_after_sell = pb2["cash"]
    if cash_after_sell > 10000.0 {
        print("  [ok] C4.cash_profit (got=" + str(cash_after_sell) + ")")
    } else {
        print("  [FAIL] C4.cash_profit got=" + str(cash_after_sell))
    }
    assert_eq("C4.trade_count_2", pb2["trades"].len(), 2)

    // C5: reject — buy with insufficient funds
    let big_buy = trading_order(sym, "buy", "market", 10.0, 0.0)
    let r3 = paper_broker_place_order(pb, big_buy, 50000.0, 1700000180000)
    let pb3 = r3["state"]
    // rejection: cash unchanged, no position added
    assert_eq("C5.cash_unchanged", pb3["cash"], 10000.0)
    assert_eq("C5.positions_unchanged", pb3["positions"].len(), 0)
    let rej = r3["rejected"]
    assert_eq("C5.rejected_reason", rej["reason"], "insufficient_cash")

    // C6: limit order → queued · then cancelled
    let limit_order = trading_order(sym, "buy", "limit", 0.05, 49000.0)
    let r4 = paper_broker_place_order(pb, limit_order, 50000.0, 1700000240000)
    let pb4 = r4["state"]
    assert_eq("C6.open_orders_after_limit", pb4["open_orders"].len(), 1)
    // cash unchanged (limit doesn't fill)
    assert_eq("C6.cash_unchanged_limit", pb4["cash"], 10000.0)
    let oid = r4["order_id"]
    let r5 = paper_broker_cancel_order(pb4, oid)
    let pb5 = r5["state"]
    assert_eq("C6.cancel_flag", r5["cancelled"], true)
    assert_eq("C6.open_orders_after_cancel", pb5["open_orders"].len(), 0)

    // C7: portfolio view (round-trip Portfolio Map after buy + sell)
    let port = paper_broker_get_portfolio(pb2, 55000.0)
    assert_eq("C7.kind", port["kind"], "Portfolio")
    assert_eq("C7.n_positions", port["n_positions"], 0)
    let real_pnl = port["realized_pnl"]
    if real_pnl > 0.0 {
        print("  [ok] C7.realized_pnl_positive (got=" + str(real_pnl) + ")")
    } else {
        print("  [FAIL] C7.realized_pnl_positive got=" + str(real_pnl))
    }

    print("=== TRADING M4 paper_broker smoke: 6/6 case PASS ===")
    print(paper_broker_summary(pb2))
}
