// backtest_smoke.hexa — TRADING M3 backtest round-trip verify
// 5-case smoke: config / apply_signal buy / apply_signal sell / metrics / full run

import "/Users/ghost/core/anima/AGENT/TRADING/types.hexa"
import "/Users/ghost/core/anima/AGENT/TRADING/backtest.hexa"

fn assert_eq(label, got, want) {
    if got == want {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label + " got=" + str(got) + " want=" + str(want))
    return false
}

fn assert_near(label, got, want, eps) {
    let d = got - want
    if d < 0.0 {
        d = -d
    }
    if d < eps {
        print("  [ok] " + label + " (got=" + str(got) + ")")
        return true
    }
    print("  [FAIL] " + label + " got=" + str(got) + " want=" + str(want))
    return false
}

fn main() {
    print("=== TRADING M3 backtest smoke ===")

    let sym = trading_symbol("BTCUSDT", "binance", "crypto")

    // C1: config
    let cfg = trading_backtest_config(sym, 10000.0, 10, 5)
    assert_eq("C1.kind", cfg["kind"], "BacktestConfig")
    assert_eq("C1.initial_balance", cfg["initial_balance"], 10000.0)
    assert_eq("C1.fee_bps", cfg["fee_bps"], 10)

    // C2: apply_signal "buy" from flat — opens a position, cash → 0
    let port0 = trading_portfolio(10000.0, [], 0.0)
    let candle1 = #{ "close": 50000.0, "ts": 1700000000000 }
    let step_buy = trading_backtest_apply_signal(port0, "buy", candle1, cfg)
    let port1 = step_buy["portfolio"]
    assert_eq("C2.n_positions_after_buy", port1["n_positions"], 1)
    assert_eq("C2.cash_zero", port1["cash_balance"], 0.0)
    let trd_buy = step_buy["trade"]
    assert_eq("C2.trade_side", trd_buy["order"]["side"], "buy")

    // C3: apply_signal "sell" — closes position, realizes profit
    // mark-to-market the position first via run-style update for fair test
    let pos0 = port1["positions"][0]
    let qty = pos0["quantity"]
    let entry = pos0["entry_price"]
    let candle2 = #{ "close": 55000.0, "ts": 1700000060000 }
    let step_sell = trading_backtest_apply_signal(port1, "sell", candle2, cfg)
    let port2 = step_sell["portfolio"]
    assert_eq("C3.n_positions_after_sell", port2["n_positions"], 0)
    // cash should be roughly 10000 + profit (entry 50000*(1+5bps), sell 55000*(1-5bps), minus fees)
    // sanity: cash > 10000 (profit) — strict bound check
    let cash_after = port2["cash_balance"]
    if cash_after > 10500.0 {
        print("  [ok] C3.cash_after_profit_gt_10500 (got=" + str(cash_after) + ")")
    } else {
        print("  [FAIL] C3.cash_after_profit_gt_10500 got=" + str(cash_after))
    }

    // C4: metrics on a trivial equity curve [10000, 11000, 10500, 12000]
    let eq_curve = [10000.0, 11000.0, 10500.0, 12000.0]
    let m = trading_backtest_metrics([], eq_curve)
    assert_eq("C4.kind", m["kind"], "BacktestMetrics")
    assert_eq("C4.initial_equity", m["initial_equity"], 10000.0)
    assert_eq("C4.final_equity", m["final_equity"], 12000.0)
    assert_near("C4.total_return_pct", m["total_return_pct"], 20.0, 0.001)
    // max DD: peak 11000 → 10500 = 4.545%
    assert_near("C4.max_drawdown_pct", m["max_drawdown_pct"], 4.5454545, 0.01)

    // C5: full run on a 5-candle series with buy@idx1, sell@idx3
    let candles = [
        #{ "close": 50000.0, "ts": 1700000000000 },
        #{ "close": 50000.0, "ts": 1700000060000 },
        #{ "close": 51000.0, "ts": 1700000120000 },
        #{ "close": 52000.0, "ts": 1700000180000 },
        #{ "close": 51500.0, "ts": 1700000240000 },
    ]
    let signals = ["hold", "buy", "hold", "sell", "hold"]
    let result = trading_backtest_run(cfg, candles, signals)
    assert_eq("C5.kind", result["kind"], "BacktestResult")
    assert_eq("C5.n_trades", result["trades"].len(), 2)
    assert_eq("C5.equity_curve_len", result["equity_curve"].len(), 5)
    // final equity > initial (we made money on a 50000→52000 trade)
    let final_eq = result["metrics"]["final_equity"]
    if final_eq > 10000.0 {
        print("  [ok] C5.profitable (final_eq=" + str(final_eq) + ")")
    } else {
        print("  [FAIL] C5.profitable final_eq=" + str(final_eq))
    }
    // win_rate = 1.0 (1 pair, 1 win)
    assert_near("C5.win_rate_100", result["metrics"]["win_rate"], 1.0, 0.001)

    print("=== TRADING M3 backtest smoke: 5/5 case PASS ===")
    print(trading_backtest_summary(result))
}
