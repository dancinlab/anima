// risk.hexa — Risk management: drawdown limits, tier gating, position sizing
// Port of agent/trading/risk.py (M1 회수 + M6 본문 구현)
//
// Bridge architecture: AGENT/CORE supplies the tier; this module = tool surface only.
// TierGate halts trading when AGENT/CORE tier is below the required threshold.
//
// Surface (6 pub fn):
//   risk_manager_new            — initialize with caps
//   risk_check_drawdown          — equity curve → max_dd vs limit
//   risk_check_position_count    — open positions vs cap
//   risk_check_tier              — AGENT/CORE tier vs required
//   risk_calculate_var           — historical VaR at confidence level
//   risk_audit                   — apply all checks, return verdict Map

// ---------------------------------------------------------------
// 1. risk_manager_new — initialize risk limits
// ---------------------------------------------------------------
pub fn risk_manager_new(max_drawdown_pct, max_position_count, max_daily_loss_pct) {
    return #{
        "max_drawdown_pct": max_drawdown_pct,
        "max_position_count": max_position_count,
        "max_daily_loss_pct": max_daily_loss_pct,
        "kind": "RiskManager",
    }
}

// ---------------------------------------------------------------
// 2. risk_check_drawdown — compute max DD from equity curve & test vs cap
//   returns { ok, max_dd_pct, limit_pct, reason }
// ---------------------------------------------------------------
pub fn risk_check_drawdown(equity_curve, max_drawdown_pct) {
    let n = equity_curve.len()
    if n == 0 {
        return #{
            "ok": true,
            "max_dd_pct": 0.0,
            "limit_pct": max_drawdown_pct,
            "reason": "empty_curve",
            "kind": "RiskVerdict",
        }
    }
    let peak = equity_curve[0]
    let max_dd = 0.0
    let i = 0
    while i < n {
        let eq = equity_curve[i]
        if eq > peak {
            peak = eq
        }
        let dd = (peak - eq) / peak * 100.0
        if dd > max_dd {
            max_dd = dd
        }
        i = i + 1
    }
    let ok = true
    let reason = "ok"
    if max_dd > max_drawdown_pct {
        ok = false
        reason = "max_drawdown_exceeded"
    }
    return #{
        "ok": ok,
        "max_dd_pct": max_dd,
        "limit_pct": max_drawdown_pct,
        "reason": reason,
        "kind": "RiskVerdict",
    }
}

// ---------------------------------------------------------------
// 3. risk_check_position_count — vs cap
// ---------------------------------------------------------------
pub fn risk_check_position_count(n_positions, max_position_count) {
    let ok = true
    let reason = "ok"
    if n_positions > max_position_count {
        ok = false
        reason = "max_position_count_exceeded"
    }
    return #{
        "ok": ok,
        "n_positions": n_positions,
        "limit": max_position_count,
        "reason": reason,
        "kind": "RiskVerdict",
    }
}

// ---------------------------------------------------------------
// 4. risk_check_tier — AGENT/CORE tier vs required tier (bridge arch)
//   tier args supplied by AGENT/CORE; this module is mechanical policy
// ---------------------------------------------------------------
pub fn risk_check_tier(tier, required_tier) {
    let ok = true
    let reason = "ok"
    if tier < required_tier {
        ok = false
        reason = "tier_below_required (tier=" + str(tier) + " < required=" + str(required_tier) + ")"
    }
    return #{
        "ok": ok,
        "tier": tier,
        "required_tier": required_tier,
        "reason": reason,
        "kind": "RiskVerdict",
    }
}

// ---------------------------------------------------------------
// 5. risk_calculate_var — historical VaR at confidence level (e.g. 0.95)
//   returns: float (negative number = loss; magnitude = VaR)
//   simple historical: sort returns ascending, take quantile at (1 - confidence)
// ---------------------------------------------------------------
pub fn risk_calculate_var(returns, confidence) {
    let n = returns.len()
    if n == 0 {
        return 0.0
    }
    // simple insertion sort (returns list is small for VaR; O(n²) acceptable)
    let sorted = []
    let i = 0
    while i < n {
        sorted = sorted + [returns[i]]
        i = i + 1
    }
    // bubble sort ascending
    let m = n
    let pass = 0
    while pass < m - 1 {
        let j = 0
        while j < m - 1 - pass {
            if sorted[j] > sorted[j + 1] {
                let tmp = sorted[j]
                let next = sorted[j + 1]
                // hexa lists are immutable on element assignment; rebuild
                let rebuilt = []
                let k = 0
                while k < m {
                    if k == j {
                        rebuilt = rebuilt + [next]
                    }
                    if k == j + 1 {
                        rebuilt = rebuilt + [tmp]
                    }
                    if k != j {
                        if k != j + 1 {
                            rebuilt = rebuilt + [sorted[k]]
                        }
                    }
                    k = k + 1
                }
                sorted = rebuilt
            }
            j = j + 1
        }
        pass = pass + 1
    }
    let q = 1.0 - confidence
    let idx_float = q * (m - 1)
    let idx = 0
    let i2 = 0
    while i2 < m {
        if i2 * 1.0 <= idx_float {
            idx = i2
        }
        i2 = i2 + 1
    }
    return sorted[idx]
}

// ---------------------------------------------------------------
// 6. risk_audit — apply ALL checks; combine into single verdict
//   returns { ok, checks, reason }
// ---------------------------------------------------------------
pub fn risk_audit(rm, equity_curve, n_positions, tier, required_tier) {
    let dd_check = risk_check_drawdown(equity_curve, rm["max_drawdown_pct"])
    let pos_check = risk_check_position_count(n_positions, rm["max_position_count"])
    let tier_check = risk_check_tier(tier, required_tier)

    let all_ok = true
    let reasons = []
    if dd_check["ok"] == false {
        all_ok = false
        reasons = reasons + [dd_check["reason"]]
    }
    if pos_check["ok"] == false {
        all_ok = false
        reasons = reasons + [pos_check["reason"]]
    }
    if tier_check["ok"] == false {
        all_ok = false
        reasons = reasons + [tier_check["reason"]]
    }

    let combined = "ok"
    if all_ok == false {
        combined = "risk_audit_FAIL"
    }

    return #{
        "ok": all_ok,
        "drawdown": dd_check,
        "position": pos_check,
        "tier": tier_check,
        "reason": combined,
        "violations": reasons,
        "kind": "RiskAudit",
    }
}

fn main() {
    print("trading/risk.hexa — 6 pub fn surface (M6 본문 구현)")
}
