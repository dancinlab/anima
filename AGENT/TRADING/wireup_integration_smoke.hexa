// wireup_integration_smoke.hexa — TRADING M17 5-broker uniformity verify
// Validates the 4 wire-up scope brokers (KIS · Alpaca · Upbit · Binance) +
// paper_broker all expose the SAME 5-verb interface on top of M2 types.

import "AGENT/TRADING/types.hexa"
import "AGENT/TRADING/live_gate.hexa"
import "AGENT/TRADING/paper_broker.hexa"
import "AGENT/TRADING/live_broker_kis.hexa"
import "AGENT/TRADING/live_broker_alpaca.hexa"
import "AGENT/TRADING/live_broker_upbit.hexa"
import "AGENT/TRADING/live_broker_binance.hexa"

fn assert_true(label, cond) {
    if cond {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label)
    return false
}

fn main() {
    print("=== TRADING M17 5-broker wireup integration smoke ===")

    // ──────────────── SETUP ──────────────────────────────────────
    let g0 = live_gate_new(10000.0, 50000.0, 5)
    let g1 = live_gate_approve_session(g0, "M17 integration smoke")

    // ──────────────── PAPER (M4 baseline) ────────────────────────
    print("--- paper_broker (M4) ---")
    let pb = paper_broker_new(10000.0, 10, 5)
    let sym_paper = trading_symbol("BTCUSDT", "binance", "crypto")
    let pq = paper_broker_get_quote(pb, sym_paper, 50000.0, 1700000000000)
    assert_true("paper.get_quote_kind", pq["kind"] == "Quote")
    let p_ord = trading_order(sym_paper, "buy", "market", 0.1, 0.0)
    let p_r = paper_broker_place_order(pb, p_ord, 50000.0, 1700000000000)
    assert_true("paper.place_order_fills", p_r["state"]["positions"].len() == 1)
    let p_port = paper_broker_get_portfolio(p_r["state"], 50000.0)
    assert_true("paper.portfolio_kind", p_port["kind"] == "Portfolio")

    // ──────────────── KIS (M5 STUB) ──────────────────────────────
    print("--- kis_broker (M5) ---")
    let kis = kis_broker_new("DRYRUN", "12345678")
    let sym_kis = trading_symbol("005930", "kis", "stock")
    let kq = kis_broker_get_quote(kis, sym_kis)
    assert_true("kis.get_quote_kind", kq["kind"] == "Quote")
    let kis_ord = trading_order(sym_kis, "buy", "market", 1.0, 70000.0)
    let kis_r0 = kis_broker_place_order(kis, g0, kis_ord, 70000.0, 0)
    assert_true("kis.L0_refused", kis_r0["gate_verdict"]["accepted"] == false)
    let kis_r1 = kis_broker_place_order(kis, g1, kis_ord, 70000.0, 0)
    assert_true("kis.L1_accepted_no_fill", kis_r1["gate_verdict"]["accepted"] == true)
    assert_true("kis.no_real_fill", kis_r1["result"]["filled"] == false)

    // ──────────────── ALPACA (M10 STUB) ──────────────────────────
    print("--- alpaca_broker (M10) ---")
    let alp = alpaca_broker_new("DRYRUN")
    let sym_alp = trading_symbol("AAPL", "alpaca", "stock")
    let aq = alpaca_broker_get_quote(alp, sym_alp)
    assert_true("alpaca.get_quote_kind", aq["kind"] == "Quote")
    let alp_ord = trading_order(sym_alp, "buy", "market", 10.0, 150.0)
    let alp_r0 = alpaca_broker_place_order(alp, g0, alp_ord, 150.0, 0)
    assert_true("alpaca.L0_refused", alp_r0["gate_verdict"]["accepted"] == false)
    let alp_r1 = alpaca_broker_place_order(alp, g1, alp_ord, 150.0, 0)
    assert_true("alpaca.L1_accepted_no_fill", alp_r1["gate_verdict"]["accepted"] == true)
    assert_true("alpaca.no_real_fill", alp_r1["result"]["filled"] == false)

    // ──────────────── UPBIT (M13 STUB) ───────────────────────────
    print("--- upbit_broker (M13) ---")
    let upb = upbit_broker_new("DRYRUN", "KRW")
    let sym_upb = trading_symbol("KRW-BTC", "upbit", "crypto")
    let uq = upbit_broker_get_quote(upb, sym_upb)
    assert_true("upbit.get_quote_kind", uq["kind"] == "Quote")
    let upb_ord = trading_order(sym_upb, "buy", "market", 0.001, 50000000.0)
    let upb_r0 = upbit_broker_place_order(upb, g0, upb_ord, 50000000.0, 0)
    assert_true("upbit.L0_refused", upb_r0["gate_verdict"]["accepted"] == false)
    // L1 with bigger caps for KRW
    let g_krw = live_gate_new(1000000.0, 5000000.0, 5)
    let g_krw_open = live_gate_approve_session(g_krw, "upbit krw")
    let upb_r1 = upbit_broker_place_order(upb, g_krw_open, upb_ord, 50000000.0, 0)
    assert_true("upbit.L1_accepted_no_fill", upb_r1["gate_verdict"]["accepted"] == true)
    assert_true("upbit.no_real_fill", upb_r1["result"]["filled"] == false)

    // ──────────────── BINANCE (M15 STUB) ─────────────────────────
    print("--- binance_broker (M15) ---")
    let bnb = binance_broker_new("DRYRUN")
    let sym_bnb = trading_symbol("BTCUSDT", "binance", "crypto")
    let bq = binance_broker_get_quote(bnb, sym_bnb)
    assert_true("binance.get_quote_kind", bq["kind"] == "Quote")
    let bnb_ord = trading_order(sym_bnb, "buy", "market", 0.01, 50000.0)
    let bnb_r0 = binance_broker_place_order(bnb, g0, bnb_ord, 50000.0, 0)
    assert_true("binance.L0_refused", bnb_r0["gate_verdict"]["accepted"] == false)
    let bnb_r1 = binance_broker_place_order(bnb, g1, bnb_ord, 50000.0, 0)
    assert_true("binance.L1_accepted_no_fill", bnb_r1["gate_verdict"]["accepted"] == true)
    assert_true("binance.no_real_fill", bnb_r1["result"]["filled"] == false)

    // ──────────────── CROSS-BROKER UNIFORMITY ─────────────────────
    print("--- 5-verb interface uniformity ---")

    // every broker.cancel_order returns a *CancelResult / empty positions list
    let kis_c = kis_broker_cancel_order(kis, "kis-id-1")
    let alp_c = alpaca_broker_cancel_order(alp, "alp-id-1")
    let upb_c = upbit_broker_cancel_order(upb, "upb-uuid-1")
    let bnb_c = binance_broker_cancel_order(bnb, "bnb-id-1")
    assert_true("kis.cancel_kind", kis_c["kind"] == "KisCancelResult")
    assert_true("alpaca.cancel_kind", alp_c["kind"] == "AlpacaCancelResult")
    assert_true("upbit.cancel_kind", upb_c["kind"] == "UpbitCancelResult")
    assert_true("binance.cancel_kind", bnb_c["kind"] == "BinanceCancelResult")

    assert_true("kis.positions_list", kis_broker_list_positions(kis).len() == 0)
    assert_true("alpaca.positions_list", alpaca_broker_list_positions(alp).len() == 0)
    assert_true("upbit.positions_list", upbit_broker_list_positions(upb).len() == 0)
    assert_true("binance.positions_list", binance_broker_list_positions(bnb).len() == 0)

    // ──────────────── SAFETY INVARIANT ────────────────────────────
    // All 4 live brokers (kis/alpaca/upbit/binance) DRYRUN+L1 acceptance still produced no real fill
    assert_true("invariant.kis_no_fill", kis_r1["result"]["filled"] == false)
    assert_true("invariant.alpaca_no_fill", alp_r1["result"]["filled"] == false)
    assert_true("invariant.upbit_no_fill", upb_r1["result"]["filled"] == false)
    assert_true("invariant.binance_no_fill", bnb_r1["result"]["filled"] == false)

    print("=== TRADING M17 5-broker wireup integration smoke: PASS ===")
    print("  paper:   " + paper_broker_summary(p_r["state"]))
    print("  kis:     " + kis_broker_summary(kis))
    print("  alpaca:  " + alpaca_broker_summary(alp))
    print("  upbit:   " + upbit_broker_summary(upb))
    print("  binance: " + binance_broker_summary(bnb))
}
