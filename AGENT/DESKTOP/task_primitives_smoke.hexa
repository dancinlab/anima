// task_primitives_smoke.hexa — runtime smoke for AGENT/DESKTOP/task_primitives (M5).
//
// 4 cases — SAFE BY CONSTRUCTION. The smoke sets ANIMA_DESKTOP_DRYRUN=1 in
// its own env, then every macro returns its contract-shape Map WITHOUT
// dispatching the underlying osascript / screencapture / CGEvent calls.
// No apps are launched, no windows captured, no keystrokes fired, no apps quit.
//
//   C1 task_open_and_type contract dict
//        → keys {ok, app, text_len, risk: "soft", launched, focused, typed_ok}
//   C2 task_screenshot_app contract
//        → keys {ok, app, path, risk: "soft", focused, captured}
//   C3 task_open_read_close contract + hard risk
//        → keys {ok, app, text, char_count, risk: "hard", launched, captured, ocr_ok, quit_ok}
//   C4 task_multi_app_screenshot 3 apps → count=3
//        → keys {ok, count, paths, failed, risk: "soft"}, count == 3
//
// All cases complete → exit 0. No real OS event is dispatched.

import "/Users/ghost/core/anima/AGENT/DESKTOP/task_primitives.hexa"

fn _enable_dry_run() {
    set_env("ANIMA_DESKTOP_DRYRUN", "1")
}

fn _map_get_int(m: Map, key: string) -> int {
    let v = m[key]
    let s = to_string(v)
    s.to_int()
}

fn _map_get_str(m: Map, key: string) -> string {
    let v = m[key]
    to_string(v)
}

fn _map_get_bool(m: Map, key: string) -> bool {
    let v = m[key]
    let s = to_string(v)
    if s == "true" { return true }
    false
}

fn _map_has(m: Map, key: string) -> bool {
    let v = m[key]
    let s = to_string(v)
    // missing key returns "void" stringification in hexa
    if s == "void" { return false }
    true
}

fn main() {
    println("[smoke] AGENT/DESKTOP/task_primitives — " + task_primitives_summary())

    _enable_dry_run()
    println("[init] ANIMA_DESKTOP_DRYRUN=1 (no real app/window/keystroke events will fire)")

    // ── C1 task_open_and_type contract dict ───────────────────────────────
    let r1 = task_open_and_type("TextEdit", "hello anima")
    let has_ok_1 = _map_has(r1, "ok")
    let has_app_1 = _map_has(r1, "app")
    let has_text_len_1 = _map_has(r1, "text_len")
    let has_launched_1 = _map_has(r1, "launched")
    let has_focused_1 = _map_has(r1, "focused")
    let has_typed_ok_1 = _map_has(r1, "typed_ok")
    let risk1 = _map_get_str(r1, "risk")
    let text_len1 = _map_get_int(r1, "text_len")
    let app1 = _map_get_str(r1, "app")
    println("[C1] open_and_type(TextEdit, 'hello anima') keys: ok=" + to_string(has_ok_1) + " app=" + app1 + " text_len=" + to_string(text_len1) + " risk=" + risk1)
    let c1_pass = has_ok_1 && has_app_1 && has_text_len_1 && has_launched_1 && has_focused_1 && has_typed_ok_1 && (risk1 == "soft") && (text_len1 == 11) && (app1 == "TextEdit")
    if !c1_pass {
        println("[C1] FAIL — expected full contract dict + risk=soft + text_len=11 + app=TextEdit")
    } else {
        println("[C1] PASS — open_and_type contract dict verified (risk=soft)")
    }

    // ── C2 task_screenshot_app contract ───────────────────────────────────
    let r2 = task_screenshot_app("Finder", "/tmp/anima_m5_smoke_finder.png")
    let has_ok_2 = _map_has(r2, "ok")
    let has_app_2 = _map_has(r2, "app")
    let has_path_2 = _map_has(r2, "path")
    let has_focused_2 = _map_has(r2, "focused")
    let has_captured_2 = _map_has(r2, "captured")
    let risk2 = _map_get_str(r2, "risk")
    let path2 = _map_get_str(r2, "path")
    let ok2 = _map_get_bool(r2, "ok")
    println("[C2] screenshot_app(Finder) keys: ok=" + to_string(ok2) + " path=" + path2 + " risk=" + risk2)
    let c2_pass = has_ok_2 && has_app_2 && has_path_2 && has_focused_2 && has_captured_2 && (risk2 == "soft") && (path2 == "/tmp/anima_m5_smoke_finder.png") && ok2
    if !c2_pass {
        println("[C2] FAIL — expected full contract dict + risk=soft + path preserved")
    } else {
        println("[C2] PASS — screenshot_app contract dict verified (risk=soft)")
    }

    // ── C3 task_open_read_close contract + hard risk ──────────────────────
    let r3 = task_open_read_close("Calculator")
    let has_ok_3 = _map_has(r3, "ok")
    let has_app_3 = _map_has(r3, "app")
    let has_text_3 = _map_has(r3, "text")
    let has_char_count_3 = _map_has(r3, "char_count")
    let has_launched_3 = _map_has(r3, "launched")
    let has_captured_3 = _map_has(r3, "captured")
    let has_ocr_ok_3 = _map_has(r3, "ocr_ok")
    let has_quit_ok_3 = _map_has(r3, "quit_ok")
    let risk3 = _map_get_str(r3, "risk")
    let app3 = _map_get_str(r3, "app")
    let char_count3 = _map_get_int(r3, "char_count")
    println("[C3] open_read_close(Calculator) keys: ok=" + to_string(has_ok_3) + " app=" + app3 + " char_count=" + to_string(char_count3) + " risk=" + risk3)
    let c3_pass = has_ok_3 && has_app_3 && has_text_3 && has_char_count_3 && has_launched_3 && has_captured_3 && has_ocr_ok_3 && has_quit_ok_3 && (risk3 == "hard") && (app3 == "Calculator")
    if !c3_pass {
        println("[C3] FAIL — expected full contract dict + risk=hard (quit step)")
    } else {
        println("[C3] PASS — open_read_close contract dict + hard risk verified")
    }

    // ── C4 task_multi_app_screenshot 3 apps → count=3 ─────────────────────
    let apps = ["Finder", "Safari", "Terminal"]
    let r4 = task_multi_app_screenshot(apps, "/tmp")
    let has_ok_4 = _map_has(r4, "ok")
    let has_count_4 = _map_has(r4, "count")
    let has_paths_4 = _map_has(r4, "paths")
    let has_failed_4 = _map_has(r4, "failed")
    let risk4 = _map_get_str(r4, "risk")
    let count4 = _map_get_int(r4, "count")
    let paths_v = r4["paths"]
    let paths_len = len(paths_v)
    println("[C4] multi_app_screenshot(3 apps, /tmp) count=" + to_string(count4) + " paths_len=" + to_string(paths_len) + " risk=" + risk4)
    let c4_pass = has_ok_4 && has_count_4 && has_paths_4 && has_failed_4 && (risk4 == "soft") && (count4 == 3) && (paths_len == 3)
    if !c4_pass {
        println("[C4] FAIL — expected count=3 paths_len=3 risk=soft")
    } else {
        println("[C4] PASS — 3-app multi-screenshot contract verified (count=3)")
    }

    // ── verdict ───────────────────────────────────────────────────────────
    let all_pass = c1_pass && c2_pass && c3_pass && c4_pass
    if all_pass {
        println("[smoke] DONE — 4/4 PASS (exit 0)")
    } else {
        println("[smoke] DONE — some cases FAILED (exit 0, honest)")
    }
}
