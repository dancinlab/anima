// native_ax_smoke.hexa — runtime smoke for AGENT/DESKTOP/native_ax (M1).
//
// 4 cases, read-only first → write last:
//   C1 ax_screen_size()       — sanity: w > 0 ∧ h > 0
//   C2 ax_app_list()          — sanity: non-empty JSON array
//   C3 ax_check_permissions() — honest verdict (deny ok, print verbatim)
//   C4 launch+focus+quit Calculator — print each return value
//
// All cases complete → exit 0 (Calculator may be absent on some installs).

import "/Users/ghost/core/anima/AGENT/DESKTOP/native_ax.hexa"

fn main() {
    println("[smoke] AGENT/DESKTOP/native_ax — " + native_ax_summary())

    // ── C1 screen size ─────────────────────────────────────────────────────
    let sz = ax_screen_size()
    println("[C1] ax_screen_size() = " + sz)
    if sz.contains("\"w\":0") {
        println("[C1] NOTE: screen size 0 — automation permission likely denied (honest)")
    }

    // ── C2 app list ────────────────────────────────────────────────────────
    let apps = ax_app_list()
    let head = if len(apps) > 200 { apps.substring(0, 200) + "...(truncated)" } else { apps }
    println("[C2] ax_app_list() = " + head)
    if apps == "[]" {
        println("[C2] NOTE: empty app list — System Events / Accessibility likely denied")
    }

    // ── C3 permissions ─────────────────────────────────────────────────────
    let perm = ax_check_permissions()
    println("[C3] ax_check_permissions() = " + perm)

    // ── C4 launch + focus + quit (Calculator) ──────────────────────────────
    let app = "Calculator"
    let launched = ax_app_launch(app)
    println("[C4.launch] ax_app_launch(" + app + ") = " + to_string(launched))

    let focused = ax_app_focus(app)
    println("[C4.focus]  ax_app_focus(" + app + ") = " + to_string(focused))

    let quit_ok = ax_app_quit(app)
    println("[C4.quit]   ax_app_quit(" + app + ") = " + to_string(quit_ok))

    println("[smoke] DONE — all 4 cases completed (exit 0)")
}
