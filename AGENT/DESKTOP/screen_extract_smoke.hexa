// screen_extract_smoke.hexa — runtime smoke for AGENT/DESKTOP/screen_extract (M2).
//
// 3 cases, all read-or-write to /tmp only:
//   C1 ax_screenshot("/tmp/desk_smoke.png") — sanity: rc=0 ∧ file size > 0
//   C2 ax_tree_dump("Finder")               — print first 500 chars of JSON
//   C3 ax_ocr("/tmp/desk_smoke.png")        — print first 200 chars (empty OK)
//
// All cases complete → exit 0. Permission denial (Screen Recording / Accessibility)
// surfaces as honest false / empty string, not a crash.

import "/Users/ghost/core/anima/AGENT/DESKTOP/screen_extract.hexa"

fn main() {
    println("[smoke] AGENT/DESKTOP/screen_extract — " + screen_extract_summary())

    // ── C1 screenshot ──────────────────────────────────────────────────────
    let out_path = "/tmp/desk_smoke.png"
    let shot_ok = ax_screenshot(out_path)
    println("[C1] ax_screenshot(\"" + out_path + "\") = " + to_string(shot_ok))
    if !shot_ok {
        println("[C1] NOTE: screenshot failed — Screen Recording permission likely denied (honest)")
    }

    // ── C2 tree dump ───────────────────────────────────────────────────────
    let tree = ax_tree_dump("Finder")
    let tree_head = if len(tree) > 500 { tree.substring(0, 500) + "...(truncated)" } else { tree }
    println("[C2] ax_tree_dump(\"Finder\") first 500 = " + tree_head)
    if tree == "[]" {
        println("[C2] NOTE: empty tree — Accessibility permission likely denied (honest)")
    }

    // ── C3 OCR ─────────────────────────────────────────────────────────────
    let ocr_text = ax_ocr(out_path)
    let ocr_head = if len(ocr_text) > 200 { ocr_text.substring(0, 200) + "...(truncated)" } else { ocr_text }
    println("[C3] ax_ocr(\"" + out_path + "\") first 200 = " + ocr_head)
    if len(ocr_text) == 0 {
        println("[C3] NOTE: empty OCR result — either no text in image, Vision unavailable, or upstream C1 failed (honest)")
    }

    println("[smoke] DONE — all 3 cases completed (exit 0)")
}
