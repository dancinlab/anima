// action_smoke.hexa — runtime smoke for AGENT/DESKTOP/action (M3).
//
// 4 cases — SAFE BY CONSTRUCTION. The smoke sets ANIMA_DESKTOP_DRYRUN=1 in
// its own env via /bin/sh -c, then every pub fn returns its contract-shape
// map WITHOUT dispatching the underlying mouse/keyboard CGEvent. The user's
// mouse / keyboard is NEVER touched.
//
//   C1 ax_click(100,100) dry-run     — verify Map shape {ok, risk}
//   C2 7-fn risk label sweep         — every fn returns a valid risk in {read,soft,hard}
//   C3 ax_type("")                   — empty-string fast-path (always ok, soft)
//   C4 ax_drag risk = "hard"         — verify hard classification
//
// All cases complete → exit 0. No osascript / CGEvent is actually posted.

import "/Users/ghost/core/anima/AGENT/DESKTOP/action.hexa"

// Local helpers — re-derive shell env probe to enable dry-run for the whole run.
// (We set ANIMA_DESKTOP_DRYRUN=1 via /bin/sh -c export before each call site;
//  since hexa exec spawns a fresh shell, we set it inline through env command.)
fn _enable_dry_run() {
    // Set process env via setenv(3) — but hexa exec is /bin/sh -c child,
    // so we instead export through a wrapper. The action.hexa _dry_run() reads
    // $ANIMA_DESKTOP_DRYRUN from the spawned sub-shell, so we must export it
    // in this process's env. exec("export ...") in a subshell won't persist.
    //
    // Workaround: the action.hexa _dry_run() runs `/bin/echo "$ANIMA_DESKTOP_DRYRUN"`
    // in a child shell, which inherits env from THIS process. So we set it via
    // the hexa runtime — `set_env` if available, else via direct exec that the
    // sub-shells inherit. We use `_ = exec(... export ...)` in the parent shell
    // line is no good either — same isolation. The correct path is the runtime
    // helper. Hexa-lang exposes `set_env(name, value)`.
    set_env("ANIMA_DESKTOP_DRYRUN", "1")
}

fn _is_valid_risk(r: string) -> bool {
    if r == "read" { return true }
    if r == "soft" { return true }
    if r == "hard" { return true }
    false
}

fn _map_get_str(m: Map, key: string) -> string {
    let v = m[key]
    to_string(v)
}

fn _map_get_bool(m: Map, key: string) -> bool {
    let v = m[key]
    let s = to_string(v)
    if s == "true" { return true }
    false
}

fn main() {
    println("[smoke] AGENT/DESKTOP/action — " + action_layer_summary())

    // Enable dry-run BEFORE any pub fn call — guarantees zero actual events.
    _enable_dry_run()
    println("[init] ANIMA_DESKTOP_DRYRUN=1 (no real mouse/keyboard events will fire)")

    // ── C1 ax_click(100, 100) dry-run shape ────────────────────────────────
    let r1 = ax_click(100, 100)
    let r1_ok = _map_get_bool(r1, "ok")
    let r1_risk = _map_get_str(r1, "risk")
    println("[C1] ax_click(100,100) = #{ok:" + to_string(r1_ok) + ", risk:" + r1_risk + "}")
    let c1_pass = r1_ok && (r1_risk == "soft")
    if !c1_pass {
        println("[C1] FAIL — expected ok=true risk=soft, got ok=" + to_string(r1_ok) + " risk=" + r1_risk)
    } else {
        println("[C1] PASS — dict shape + soft risk verified")
    }

    // ── C2 7-fn risk label sweep ───────────────────────────────────────────
    let s_click = _map_get_str(ax_click(50, 50), "risk")
    let s_dbl   = _map_get_str(ax_double_click(50, 50), "risk")
    let s_right = _map_get_str(ax_right_click(50, 50), "risk")
    let s_drag  = _map_get_str(ax_drag(10, 10, 20, 20), "risk")
    let s_type  = _map_get_str(ax_type("x"), "risk")
    let s_key   = _map_get_str(ax_key(53, []), "risk")  // 53 = Escape, no mods → soft
    let s_scrl  = _map_get_str(ax_scroll(50, 50, 1), "risk")
    println("[C2] risks = click:" + s_click + " dbl:" + s_dbl + " right:" + s_right + " drag:" + s_drag + " type:" + s_type + " key:" + s_key + " scroll:" + s_scrl)
    let c2_pass = _is_valid_risk(s_click)
        && _is_valid_risk(s_dbl)
        && _is_valid_risk(s_right)
        && _is_valid_risk(s_drag)
        && _is_valid_risk(s_type)
        && _is_valid_risk(s_key)
        && _is_valid_risk(s_scrl)
    if !c2_pass {
        println("[C2] FAIL — at least one risk label not in {read,soft,hard}")
    } else {
        println("[C2] PASS — all 7 fn return valid risk labels")
    }

    // ── C3 ax_type("") empty-string fast-path ──────────────────────────────
    let r3 = ax_type("")
    let r3_ok = _map_get_bool(r3, "ok")
    let r3_risk = _map_get_str(r3, "risk")
    println("[C3] ax_type(\"\") = #{ok:" + to_string(r3_ok) + ", risk:" + r3_risk + "}")
    let c3_pass = r3_ok && (r3_risk == "soft")
    if !c3_pass {
        println("[C3] FAIL — expected ok=true risk=soft")
    } else {
        println("[C3] PASS — empty-string no-op returns ok/soft")
    }

    // ── C4 ax_drag risk = "hard" classification ────────────────────────────
    let r4 = ax_drag(100, 100, 200, 200)
    let r4_risk = _map_get_str(r4, "risk")
    println("[C4] ax_drag(100,100,200,200) risk = " + r4_risk)
    let c4_pass = r4_risk == "hard"
    if !c4_pass {
        println("[C4] FAIL — expected risk=hard, got " + r4_risk)
    } else {
        println("[C4] PASS — drag classified as hard")
    }

    // ── verdict ────────────────────────────────────────────────────────────
    let all_pass = c1_pass && c2_pass && c3_pass && c4_pass
    if all_pass {
        println("[smoke] DONE — 4/4 PASS (exit 0)")
    } else {
        println("[smoke] DONE — some cases FAILED (exit 0, honest)")
    }
}
