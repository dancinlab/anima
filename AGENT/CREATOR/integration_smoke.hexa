// integration_smoke.hexa — CREATOR M6 5-stage round-trip + risk audit
// script (M1 type) → still (M3 fal STUB) → prog (M4 remotion STUB) → clip (M5 fal STUB) → publish (M6 STUB)
//
// Validates the whole CREATOR domain wire-up — all M1 types flow uniform
// across all M3-M5 backends + M6 publish stub on all 3 platforms.

import "/Users/ghost/core/anima/AGENT/CREATOR/types.hexa"
import "/Users/ghost/core/anima/AGENT/CREATOR/still_backend_fal.hexa"
import "/Users/ghost/core/anima/AGENT/CREATOR/prog_backend_remotion.hexa"
import "/Users/ghost/core/anima/AGENT/CREATOR/clip_backend_fal.hexa"
import "/Users/ghost/core/anima/AGENT/CREATOR/publish.hexa"

fn assert_true(label, cond) {
    if cond {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label)
    return false
}

fn main() {
    print("=== CREATOR M6 integration smoke (5-stage round-trip) ===")

    // ────────────────────────────────────────────────────────────
    // SETUP — brand + 3 channels
    // ────────────────────────────────────────────────────────────
    let brand = creator_brand("anima-ch", "Anima Channel", "calm", ["#1F1F1F", "#F5F5F5"], ["ai", "consciousness"])
    assert_true("S0.brand", brand["kind"] == "Brand")

    let yt = creator_channel("yt-anima", "youtube", "@anima_yt", "youtube.oauth_token")
    let tt = creator_channel("tt-anima", "tiktok", "@anima_tt", "tiktok.access_token")
    let ig = creator_channel("ig-anima", "instagram", "@anima_ig", "instagram.graph_token")
    assert_true("S0.yt", yt["platform"] == "youtube")
    assert_true("S0.tt", tt["platform"] == "tiktok")
    assert_true("S0.ig", ig["platform"] == "instagram")

    // ────────────────────────────────────────────────────────────
    // STAGE 1 — script (M1 Script type)
    // ────────────────────────────────────────────────────────────
    let beats = ["pose the question", "explore tension", "land the insight"]
    let scr = creator_script("On Consciousness", "What if the field thinks?", beats, "subscribe", 30.0)
    assert_true("S1.script_kind", scr["kind"] == "Script")
    assert_true("S1.n_beats", scr["n_beats"] == 3)

    // ────────────────────────────────────────────────────────────
    // STAGE 2 — STILL via fal.ai (M3 STUB)
    // ────────────────────────────────────────────────────────────
    let still_state = still_fal_new("DRYRUN", "fal-ai/openai-images-2.0")
    let r_still = still_fal_generate(still_state, scr["hook"], 1024, 1024, "")
    let still_asset = r_still["asset"]
    assert_true("S2.still_tier_L1", still_asset["tier"] == "L1")
    assert_true("S2.still_backend_fal", still_asset["provenance"]["backend"] == "fal.ai")

    // ────────────────────────────────────────────────────────────
    // STAGE 3 — PROG via Remotion (M4 STUB)
    // ────────────────────────────────────────────────────────────
    let prog_state = prog_remotion_new("DRYRUN", "/Users/ghost/projects/anima-video")
    let spec = #{
        "composition_id": "AnimaIntro",
        "frames": 900,
        "fps": 30,
        "duration_s": 30.0,
        "components": [
            #{ "type": "text", "value": scr["title"] },
            #{ "type": "image", "value": still_asset["path"] },
        ],
    }
    let r_prog = prog_remotion_render(prog_state, spec, "")
    let prog_asset = r_prog["asset"]
    assert_true("S3.prog_tier_L2", prog_asset["tier"] == "L2")
    assert_true("S3.prog_backend_remotion", prog_asset["provenance"]["backend"] == "remotion")
    assert_true("S3.prog_n_components_2", prog_asset["meta"]["n_components"] == 2)

    // ────────────────────────────────────────────────────────────
    // STAGE 4 — CLIP via fal.ai (M5 STUB · HOIVG image-conditioned)
    // ────────────────────────────────────────────────────────────
    let clip_state = clip_fal_new("DRYRUN", "fal-ai/seedance-2.0")
    let r_clip = clip_fal_generate(clip_state, scr["hook"], 15.0, "fal-ai/omnishow-hoivg", still_asset["path"])
    let clip_asset = r_clip["asset"]
    assert_true("S4.clip_tier_L3", clip_asset["tier"] == "L3")
    assert_true("S4.clip_backend_fal", clip_asset["provenance"]["backend"] == "fal.ai")
    assert_true("S4.hoivg_model", clip_asset["provenance"]["model"] == "fal-ai/omnishow-hoivg")
    assert_true("S4.image_conditioned", clip_asset["meta"]["image_conditioned"] == true)
    assert_true("S4.sample_24k", clip_asset["meta"]["sample_rate_hz"] == 24000)

    // ────────────────────────────────────────────────────────────
    // STAGE 5 — PUBLISH (M6 STUB, 3 platforms via dispatch)
    // ────────────────────────────────────────────────────────────
    let caption = "Anima drop · " + scr["title"]
    let tags = ["ai", "anima", "shorts"]
    let yt_job = creator_upload_job("j-yt-1", clip_asset, yt, caption, tags)
    let tt_job = creator_upload_job("j-tt-1", clip_asset, tt, caption, tags)
    let ig_job = creator_upload_job("j-ig-1", clip_asset, ig, caption, tags)

    let yt_pub = publish_dispatch(yt_job, true)  // dry_run=true
    let tt_pub = publish_dispatch(tt_job, true)
    let ig_pub = publish_dispatch(ig_job, true)
    assert_true("S5.yt_ok", yt_pub["ok"] == true)
    assert_true("S5.yt_platform", yt_pub["platform"] == "youtube")
    assert_true("S5.tt_ok", tt_pub["ok"] == true)
    assert_true("S5.tt_platform", tt_pub["platform"] == "tiktok")
    assert_true("S5.ig_ok", ig_pub["ok"] == true)
    assert_true("S5.ig_platform", ig_pub["platform"] == "instagram")

    // dry_run=false → all 3 platforms refuse (real_upload_not_implemented)
    let yt_real = publish_dispatch(yt_job, false)
    assert_true("S5.yt_real_refused", yt_real["ok"] == false)

    // unknown platform
    let bad_channel = creator_channel("xx-anima", "myspace", "@x", "x.token")
    let bad_job = creator_upload_job("j-x-1", clip_asset, bad_channel, caption, tags)
    let bad_pub = publish_dispatch(bad_job, true)
    assert_true("S5.unknown_platform_refused", bad_pub["ok"] == false)
    assert_true("S5.unknown_reason", bad_pub["reason"] == "unknown_platform")

    // ────────────────────────────────────────────────────────────
    // SUMMARY
    // ────────────────────────────────────────────────────────────
    print("=== CREATOR M6 integration smoke: 5-stage round-trip PASS ===")
    print("  brand:    " + brand["name"] + " · tone=" + brand["tone"])
    print("  script:   " + scr["title"] + " · beats=" + str(scr["n_beats"]) + " · " + str(scr["duration_s"]) + "s")
    print("  still:    " + still_asset["path"] + " · model=" + still_asset["provenance"]["model"])
    print("  prog:     " + prog_asset["path"] + " · frames=" + str(prog_asset["meta"]["frames"]))
    print("  clip:     " + clip_asset["path"] + " · model=" + clip_asset["provenance"]["model"])
    print("  publish:  " + publish_summary(yt_pub))
    print("  publish:  " + publish_summary(tt_pub))
    print("  publish:  " + publish_summary(ig_pub))
}
