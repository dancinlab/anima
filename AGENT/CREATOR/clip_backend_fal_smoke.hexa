// clip_backend_fal_smoke.hexa — CREATOR M5 L3 GEN fal clip verify
// 8-case smoke: new / DRYRUN default / DRYRUN model override / HOIVG image-conditioned /
// configure empty 거부 / configure valid / REAL unconfigured / REAL configured

import "/Users/ghost/core/anima/AGENT/CREATOR/types.hexa"
import "/Users/ghost/core/anima/AGENT/CREATOR/clip_backend_fal.hexa"

fn assert_eq(label, got, want) {
    if got == want {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label + " got=" + str(got) + " want=" + str(want))
    return false
}

fn main() {
    print("=== CREATOR M5 clip_backend_fal smoke ===")

    // C1: new (DRYRUN default · unconfigured)
    let s = clip_fal_new("DRYRUN", "fal-ai/seedance-2.0")
    assert_eq("C1.kind", s["kind"], "ClipFalState")
    assert_eq("C1.env", s["env"], "DRYRUN")
    assert_eq("C1.model", s["model"], "fal-ai/seedance-2.0")
    assert_eq("C1.configured_false", s["configured"], false)
    assert_eq("C1.next_id", s["next_asset_id"], 1)

    // C2: DRYRUN — default model · text-only · duration=0 → 15s default
    let r1 = clip_fal_generate(s, "anima riding a wave", 0.0, "", "")
    let s1 = r1["state"]
    let a1 = r1["asset"]
    assert_eq("C2.no_error", r1["error"], "")
    assert_eq("C2.tier_L3", a1["tier"], "L3")
    assert_eq("C2.media_clip", a1["media_type"], "clip")
    assert_eq("C2.default_duration_15", a1["meta"]["duration_s"], 15.0)
    assert_eq("C2.sample_rate_24k", a1["meta"]["sample_rate_hz"], 24000)
    assert_eq("C2.text_only", a1["meta"]["image_conditioned"], false)
    assert_eq("C2.backend", a1["provenance"]["backend"], "fal.ai")
    assert_eq("C2.default_model", a1["provenance"]["model"], "fal-ai/seedance-2.0")
    assert_eq("C2.stub_mode", a1["provenance"]["stub_mode"], true)
    assert_eq("C2.path", a1["path"], "/tmp/fal-clip-1.mp4")
    assert_eq("C2.state_advanced", s1["next_asset_id"], 2)

    // C3: DRYRUN model override — seedance-2.0-pro · custom duration 8s
    let r1b = clip_fal_generate(s1, "anima abstract glow", 8.0, "fal-ai/seedance-2.0-pro", "")
    let a1b = r1b["asset"]
    assert_eq("C3.model_override", a1b["provenance"]["model"], "fal-ai/seedance-2.0-pro")
    assert_eq("C3.custom_duration", a1b["meta"]["duration_s"], 8.0)
    assert_eq("C3.backend_unchanged", a1b["provenance"]["backend"], "fal.ai")

    // C4: HOIVG image-conditioned — omnishow model + image_ref
    let r1c = clip_fal_generate(r1b["state"], "anima walking forward", 12.0, "fal-ai/omnishow-hoivg", "/tmp/anima_face.png")
    let a1c = r1c["asset"]
    assert_eq("C4.hoivg_model", a1c["provenance"]["model"], "fal-ai/omnishow-hoivg")
    assert_eq("C4.image_conditioned", a1c["meta"]["image_conditioned"], true)
    assert_eq("C4.image_ref_preserved", a1c["provenance"]["image_ref"], "/tmp/anima_face.png")

    // C5: configure empty key — stays unconfigured
    let s_bad = clip_fal_configure(s, "")
    assert_eq("C5.empty_key_unconfigured", s_bad["configured"], false)

    // C6: configure valid key
    let s_cfg = clip_fal_configure(s, "stub-fal-key-redacted")
    assert_eq("C6.configured_true", s_cfg["configured"], true)
    assert_eq("C6.api_key_set", s_cfg["api_key"], "stub-fal-key-redacted")

    // C7: REAL + unconfigured → error=fal_not_configured · still stub asset
    let s_real_uncfg = clip_fal_new("REAL", "fal-ai/seedance-2.0")
    let r5 = clip_fal_generate(s_real_uncfg, "test", 15.0, "", "")
    assert_eq("C7.error_fal_not_cfg", r5["error"], "fal_not_configured")
    assert_eq("C7.stub_mode_kept", r5["asset"]["provenance"]["stub_mode"], true)
    if r5["asset"]["provenance"]["reason"].len() < 5 {
        print("  [FAIL] C7.reason_empty")
    } else {
        print("  [ok] C7.reason_set (got=" + r5["asset"]["provenance"]["reason"] + ")")
    }

    // C8: REAL + configured → real_api_not_implemented (M5 stub)
    let s_real_cfg = clip_fal_configure(s_real_uncfg, "stub-key")
    let r6 = clip_fal_generate(s_real_cfg, "test", 15.0, "", "")
    assert_eq("C8.error_real_not_impl", r6["error"], "real_api_not_implemented")
    assert_eq("C8.still_stub", r6["asset"]["provenance"]["stub_mode"], true)

    print("=== CREATOR M5 clip_backend_fal smoke: 8-case PASS ===")
    print(clip_fal_summary(s_real_cfg))
}
