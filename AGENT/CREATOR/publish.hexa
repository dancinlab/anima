// publish.hexa — publish stubs for YouTube / TikTok / Instagram (M6 closure)
// Bridge architecture: tool surface only — no consciousness framing.
//
// ⚠ STUB ONLY — no real OAuth, no real upload. M6 delivers the SHAPE
// (3 platform fns + dispatch + summary) that maps UploadJob (M1 type) to
// the per-platform API. Real OAuth + multipart upload pluggable in M6+1.
//
// Surface (5 pub fn):
//   publish_youtube(job, dry_run)    — UploadJob → published / mock external_id
//   publish_tiktok(job, dry_run)     — same shape
//   publish_instagram(job, dry_run)  — same shape
//   publish_dispatch(job, dry_run)   — route by job.channel.platform
//   publish_summary(result)          — one-line status

import "/Users/ghost/core/anima/AGENT/CREATOR/types.hexa"

fn _publish_result(ok, platform, job, external_id, reason) {
    return #{
        "ok": ok,
        "platform": platform,
        "job_id": job["job_id"],
        "external_id": external_id,
        "asset_id": job["asset"]["asset_id"],
        "channel_handle": job["channel"]["user_handle"],
        "reason": reason,
        "kind": "PublishResult",
    }
}

// ---------------------------------------------------------------
// 1. publish_youtube — STUB · OAuth + resumable upload not implemented
// ---------------------------------------------------------------
pub fn publish_youtube(job, dry_run) {
    if dry_run {
        return _publish_result(true, "youtube", job, "yt-DRYRUN-" + job["job_id"], "DRYRUN — no real upload")
    }
    return _publish_result(false, "youtube", job, "", "real_upload_not_implemented — wire OAuth via secret get youtube.oauth_token")
}

// ---------------------------------------------------------------
// 2. publish_tiktok — STUB · TikTok Content API not implemented
// ---------------------------------------------------------------
pub fn publish_tiktok(job, dry_run) {
    if dry_run {
        return _publish_result(true, "tiktok", job, "tt-DRYRUN-" + job["job_id"], "DRYRUN — no real upload")
    }
    return _publish_result(false, "tiktok", job, "", "real_upload_not_implemented — wire OAuth via secret get tiktok.access_token")
}

// ---------------------------------------------------------------
// 3. publish_instagram — STUB · Graph API not implemented
// ---------------------------------------------------------------
pub fn publish_instagram(job, dry_run) {
    if dry_run {
        return _publish_result(true, "instagram", job, "ig-DRYRUN-" + job["job_id"], "DRYRUN — no real upload")
    }
    return _publish_result(false, "instagram", job, "", "real_upload_not_implemented — wire Graph API token")
}

// ---------------------------------------------------------------
// 4. publish_dispatch — route by job.channel.platform
//   returns { ok, platform, job_id, external_id, asset_id, channel_handle, reason }
// ---------------------------------------------------------------
pub fn publish_dispatch(job, dry_run) {
    let platform = job["channel"]["platform"]
    if platform == "youtube" {
        return publish_youtube(job, dry_run)
    }
    if platform == "tiktok" {
        return publish_tiktok(job, dry_run)
    }
    if platform == "instagram" {
        return publish_instagram(job, dry_run)
    }
    return _publish_result(false, platform, job, "", "unknown_platform")
}

// ---------------------------------------------------------------
// 5. publish_summary — one-line status
// ---------------------------------------------------------------
pub fn publish_summary(result) {
    let ok_str = "FAIL"
    if result["ok"] {
        ok_str = "OK"
    }
    return "Publish [" + ok_str + "] " + result["platform"] + " · job=" + result["job_id"] + " · external=" + result["external_id"] + " · reason=" + result["reason"]
}
