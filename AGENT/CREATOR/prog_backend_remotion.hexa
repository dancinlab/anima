// prog_backend_remotion.hexa — L2 PROG backend via Remotion (M4 closure)
// Bridge architecture: tool surface only — no consciousness framing.
//
// ⚠ STUB ONLY — no real `npx remotion render` call. M4 delivers the SHAPE
// (5 pub fn + spec-to-React codegen string) without spawning Node.js.
//
// Remotion is a programmatic React framework that compiles JSX components
// to MP4 video. Unlike fal.ai (queue+poll HTTP), it runs locally via Node:
//   1. Author Composition.tsx (React component with frame-by-frame rendering)
//   2. `npx remotion render src/index.tsx <CompositionId> out.mp4`
//
// Surface (5 pub fn):
//   prog_remotion_new(env, project_path)        — initialize state
//   prog_remotion_configure(state, project_path) — update project path
//   prog_remotion_codegen(state, spec)            — spec → React component string
//   prog_remotion_render(state, spec, out_path)   — render to MediaAsset L2
//   prog_remotion_summary(state)                  — one-line status

import "/Users/ghost/core/anima/AGENT/CREATOR/types.hexa"

// ---------------------------------------------------------------
// 1. prog_remotion_new — initialize the Remotion adapter
//   env: "DRYRUN" (default · no real call) · "REAL" (requires project_path)
//   project_path: filesystem path to the Remotion project root
// ---------------------------------------------------------------
pub fn prog_remotion_new(env, project_path) {
    let configured = false
    if project_path != "" {
        configured = true
    }
    return #{
        "env": env,
        "project_path": project_path,
        "configured": configured,
        "next_asset_id": 1,
        "asset_log": [],
        "kind": "ProgRemotionState",
    }
}

// ---------------------------------------------------------------
// 2. prog_remotion_configure — wire / update the project path
// ---------------------------------------------------------------
pub fn prog_remotion_configure(state, project_path) {
    let cfg = false
    if project_path != "" {
        cfg = true
    }
    return #{
        "env": state["env"],
        "project_path": project_path,
        "configured": cfg,
        "next_asset_id": state["next_asset_id"],
        "asset_log": state["asset_log"],
        "kind": "ProgRemotionState",
    }
}

// ---------------------------------------------------------------
// 3. prog_remotion_codegen — produce a React component string from spec
//   spec: Map { "composition_id": string, "fps": int, "duration_s": float,
//               "components": list of Map { "type": "text"/"image", ... } }
//   returns string (TSX snippet) — caller can write to disk before render
// ---------------------------------------------------------------
pub fn prog_remotion_codegen(state, spec) {
    let comp_id = spec["composition_id"]
    if type_of(comp_id) != "string" {
        comp_id = "AnimaComp"
    }
    let fps = spec["fps"]
    let duration_s = spec["duration_s"]
    let durationInFrames = 0
    if type_of(fps) == "int" {
        if type_of(duration_s) == "float" {
            durationInFrames = fps * 1
        }
    }
    let components = spec["components"]
    let body = "  // 0 components"
    if type_of(components) == "array" {
        let n = components.len()
        body = "  // " + str(n) + " components"
    }
    let tsx = ""
    tsx = tsx + "import {Composition} from 'remotion';\n"
    tsx = tsx + "import {AbsoluteFill} from 'remotion';\n"
    tsx = tsx + "\n"
    tsx = tsx + "export const " + comp_id + " = () => {\n"
    tsx = tsx + body + "\n"
    tsx = tsx + "  return (<AbsoluteFill style={{backgroundColor: 'black'}} />);\n"
    tsx = tsx + "};\n"
    return tsx
}

// ---------------------------------------------------------------
// 4. prog_remotion_render — render Composition to MediaAsset L2 clip
//   spec: Map (same shape as codegen)
//   out_path: string (target .mp4 path; ""=auto)
//   returns { state, asset, error }
// ---------------------------------------------------------------
pub fn prog_remotion_render(state, spec, out_path) {
    let aid = state["next_asset_id"]
    let asset_id = "remotion-" + str(aid)
    let final_out = out_path
    if final_out == "" {
        final_out = "/tmp/" + asset_id + ".mp4"
    }
    let frames = 0
    let fps = 30
    let duration_s = 0.0
    if type_of(spec["frames"]) == "int" {
        frames = spec["frames"]
    }
    if type_of(spec["fps"]) == "int" {
        fps = spec["fps"]
    }
    if type_of(spec["duration_s"]) == "float" {
        duration_s = spec["duration_s"]
    }
    let n_components = 0
    if type_of(spec["components"]) == "array" {
        n_components = spec["components"].len()
    }
    let meta = #{
        "frames": frames,
        "fps": fps,
        "duration_s": duration_s,
        "n_components": n_components,
    }
    let prov_reason = ""
    if state["env"] == "DRYRUN" {
        prov_reason = "DRYRUN — no real npx remotion render"
    } else {
        if state["configured"] == false {
            prov_reason = "remotion_not_configured — project_path missing"
        } else {
            prov_reason = "real_render_not_implemented — M4 stub closure"
        }
    }
    let prov = #{
        "backend": "remotion",
        "model": "remotion-codegen-stub",
        "spec_hash": "s-" + str(aid),
        "generated_at": 1700000000000,
        "stub_mode": true,
        "reason": prov_reason,
        "project_path": state["project_path"],
    }
    let asset = creator_media_asset(asset_id, "clip", "L2", final_out, meta, prov)
    let new_state = #{
        "env": state["env"],
        "project_path": state["project_path"],
        "configured": state["configured"],
        "next_asset_id": aid + 1,
        "asset_log": state["asset_log"] + [asset_id],
        "kind": "ProgRemotionState",
    }
    let err = ""
    if state["env"] == "REAL" {
        if state["configured"] == false {
            err = "remotion_not_configured"
        } else {
            err = "real_render_not_implemented"
        }
    }
    return #{
        "state": new_state,
        "asset": asset,
        "error": err,
    }
}

// ---------------------------------------------------------------
// 5. prog_remotion_summary — one-line status
// ---------------------------------------------------------------
pub fn prog_remotion_summary(state) {
    let cfg = "unconfigured"
    if state["configured"] {
        cfg = "configured(" + state["project_path"] + ")"
    }
    return "ProgRemotion [STUB]: env=" + state["env"] + " · " + cfg + " · log_len=" + str(state["asset_log"].len())
}
