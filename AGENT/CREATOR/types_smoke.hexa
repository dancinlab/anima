// types_smoke.hexa — CREATOR M1 types round-trip verify
// 5-case smoke: every constructor returns a valid Map with required fields.

import "/Users/ghost/core/anima/AGENT/CREATOR/types.hexa"

fn assert_eq(label, got, want) {
    if got == want {
        print("  [ok] " + label)
        return true
    }
    print("  [FAIL] " + label + " got=" + str(got) + " want=" + str(want))
    return false
}

fn main() {
    print("=== CREATOR M1 types smoke ===")

    // C1: Brand
    let brand = creator_brand("anima-ch", "Anima Channel", "calm", ["#1F1F1F", "#F5F5F5"], ["ai", "consciousness", "philosophy"])
    assert_eq("C1.kind", creator_type_kind(brand), "Brand")
    assert_eq("C1.id", brand["id"], "anima-ch")
    assert_eq("C1.tone", brand["tone"], "calm")
    assert_eq("C1.palette_count", brand["palette"].len(), 2)

    // C2: Script (3 beats · 30s target)
    let beats = ["pose the question", "explore tension", "land the insight"]
    let scr = creator_script("On Consciousness", "What if the field thinks?", beats, "subscribe", 30.0)
    assert_eq("C2.kind", creator_type_kind(scr), "Script")
    assert_eq("C2.title", scr["title"], "On Consciousness")
    assert_eq("C2.n_beats", scr["n_beats"], 3)
    assert_eq("C2.duration", scr["duration_s"], 30.0)

    // C3: MediaAsset (L3 GEN clip)
    let meta = #{ "duration_s": 15.0, "sample_rate_hz": 24000 }
    let prov = #{ "backend": "fal", "model": "seedance-2.0", "prompt_hash": "abc123", "generated_at": 1700000000000 }
    let asset = creator_media_asset("a-001", "clip", "L3", "/tmp/clip_001.mp4", meta, prov)
    assert_eq("C3.kind", creator_type_kind(asset), "MediaAsset")
    assert_eq("C3.tier", asset["tier"], "L3")
    assert_eq("C3.media_type", asset["media_type"], "clip")
    assert_eq("C3.provenance_backend", asset["provenance"]["backend"], "fal")

    // C4: Channel
    let ch = creator_channel("yt-main", "youtube", "@anima_channel", "youtube.oauth_token")
    assert_eq("C4.kind", creator_type_kind(ch), "Channel")
    assert_eq("C4.platform", ch["platform"], "youtube")
    assert_eq("C4.credential_ref_is_ref", ch["credential_ref"], "youtube.oauth_token")
    // sanity: the ref is a key name, not a token value
    assert_eq("C4.no_raw_secret", ch["credential_ref"].len() < 64, true)

    // C5: UploadJob (asset → channel)
    let job = creator_upload_job("j-001", asset, ch, "Anima ch001 first drop", ["ai", "shorts"])
    assert_eq("C5.kind", creator_type_kind(job), "UploadJob")
    assert_eq("C5.status_pending", job["status"], "pending")
    assert_eq("C5.retry_zero", job["retry_count"], 0)
    assert_eq("C5.tag_count", job["tags"].len(), 2)
    // asset preserved through composition
    assert_eq("C5.nested_asset_tier", job["asset"]["tier"], "L3")
    assert_eq("C5.nested_channel_platform", job["channel"]["platform"], "youtube")

    // C6: defensive — kind on Map with no kind field
    let bad = #{ "foo": "bar" }
    assert_eq("C6.kind_missing", creator_type_kind(bad), "unknown")

    print("=== CREATOR M1 types smoke: 5/5 types + 1 defensive PASS ===")
    print(creator_type_summary())
}
