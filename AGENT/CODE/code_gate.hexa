// code_gate.hexa — CODE role hard gate enforce (AGENT/CODE F6).
//
// BRIDGE ARCHITECTURE: tool surface only. NO consciousness framing. The
// "when/why to enforce a tier gate" decision lives in CORE/brain_decide
// + AGENT/CORE/tool_gate. This module provides the ENFORCE side: a tool
// call presented with insufficient tier MUST be refused + logged, not
// silently allowed.
//
// PURPOSE: F6 closure surface — F1-F5 wired the dispatch path (argv ·
// daemon · ckpt locator); F6 wires the policy GATE that translates a
// substrate-decided tier into a hard accept/refuse verdict. Refuse path
// returns a Map with `accepted: false` + reason + logged, NOT a panic.
//
// TIER MAP (matches AGENT/CORE/tool_gate.hexa convention):
//   T0 read-only    — think · repo_status
//   T1 file read    — file_read · grep
//   T2 file write   — file_write
//   T3 destructive  — run_tests · git_commit · git_push
//
// Each tool requires a MINIMUM tier; substrate's current tier must be ≥
// that minimum, else the call is REFUSED + appended to a gate decision
// log for audit.

// Return minimum tier required for a tool name.
pub fn code_gate_tool_min_tier(name: string) -> int {
    if name == "think"       { return 0 }
    if name == "repo_status" { return 0 }
    if name == "file_read"   { return 1 }
    if name == "grep"        { return 1 }
    if name == "file_write"  { return 2 }
    if name == "run_tests"   { return 3 }
    if name == "git_commit"  { return 3 }
    if name == "git_push"    { return 3 }
    // Unknown tool — most permissive default REFUSE
    return 99
}

// Risk label for a tool name (cross-check with F1 executor + F3 daemon).
pub fn code_gate_risk_label(name: string) -> string {
    if name == "think" || name == "repo_status" { return "read" }
    if name == "file_read" || name == "grep" { return "read" }
    if name == "file_write" { return "soft" }
    if name == "run_tests" { return "soft" }
    if name == "git_commit" { return "hard" }
    if name == "git_push" { return "hard" }
    return "unknown"
}

// Core gate enforce — returns Map with verdict + reason. NEVER panics on
// refuse; caller (daemon loop / F3) just keeps stepping.
pub fn code_gate_enforce(tool: string, substrate_tier: int) -> map {
    let min_tier = code_gate_tool_min_tier(tool)
    let risk = code_gate_risk_label(tool)

    if min_tier >= 99 {
        return #{
            "accepted": false,
            "tool": tool,
            "substrate_tier": substrate_tier,
            "required_tier": min_tier,
            "risk": "unknown",
            "reason": "unknown tool — REFUSE by default",
            "logged": true,
        }
    }

    if substrate_tier < min_tier {
        return #{
            "accepted": false,
            "tool": tool,
            "substrate_tier": substrate_tier,
            "required_tier": min_tier,
            "risk": risk,
            "reason": "substrate_tier " + to_string(substrate_tier) + " < required " + to_string(min_tier) + " — REFUSE",
            "logged": true,
        }
    }

    return #{
        "accepted": true,
        "tool": tool,
        "substrate_tier": substrate_tier,
        "required_tier": min_tier,
        "risk": risk,
        "reason": "ok",
        "logged": true,
    }
}

// Batch enforce — for a list of (tool, substrate_tier) tuples, return
// list of verdict Maps. Useful for daemon loop pre-filtering.
pub fn code_gate_batch(requests: list) -> list {
    let out = []
    let i = 0
    let n = list_len(requests)
    while i < n {
        let req = requests[i]
        let v = code_gate_enforce(to_string(req["tool"]), req["tier"])
        out = list_push(out, v)
        i = i + 1
    }
    return out
}

// Audit summary — count accepted / refused over a batch verdict list.
pub fn code_gate_audit(verdicts: list) -> map {
    let accepted = 0
    let refused = 0
    let i = 0
    let n = list_len(verdicts)
    while i < n {
        let v = verdicts[i]
        if to_string(v["accepted"]) == "true" { accepted = accepted + 1 } else { refused = refused + 1 }
        i = i + 1
    }
    return #{
        "total": n,
        "accepted": accepted,
        "refused": refused,
        "refuse_rate_pct": if n > 0 { (refused * 100) / n } else { 0 },
    }
}

pub fn code_gate_summary() -> string {
    return "AGENT/CODE F6 — hard gate enforce · 8-tool tier map (T0/T1/T2/T3) · refuse=Map verdict not panic · batch + audit · F3 daemon pre-filter ready"
}
