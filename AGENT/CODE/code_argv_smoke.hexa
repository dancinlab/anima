// code_argv_smoke.hexa — runtime smoke for AGENT/CODE/code_argv (F2).
//
// 4 cases, all in-process (no process spawn, no FS write):
//   C1 [] (empty)                    → tool="help",      mode="help",  known=true
//   C2 ["think"]                     → tool="think",     mode="once",  known=true
//   C3 ["file_read","AGENT.md"]      → tool="file_read", arg="AGENT.md", known=true
//   C4 ["unknown"]                   → tool="unknown",   mode="once",  known=false
//
// Each case calls code_argv_parse with a synthetic args_list, prints the
// resolved dict fields, and asserts the 4 expected invariants. A 5th
// "live" line then echoes code_argv_read() against the actual process argv
// so the substrate-native path is exercised end-to-end (output varies with
// how the file is invoked — by design, that IS the F2 closure).
//
// All cases complete → exit 0. No external side effects.

import "/Users/ghost/core/anima/AGENT/CODE/code_argv.hexa"

// Print a parse dict in a stable one-line form for the case logs.
fn _fmt(d: Map) -> string {
    return "tool=" + to_string(d["tool"])
         + " arg="  + to_string(d["arg"])
         + " mode=" + to_string(d["mode"])
         + " known=" + to_string(d["known"])
}

// Tiny assert: print PASS/FAIL alongside the case label without aborting.
// (Smoke convention — see screen_extract_smoke for the same shape.)
fn _check(label: string, ok: bool) {
    if ok {
        println("       " + label + " ✓")
    } else {
        println("       " + label + " ✗ FAIL")
    }
}

fn main() {
    println("[smoke] AGENT/CODE/code_argv — " + code_argv_summary())

    // ── C1 empty argv → help mode ──────────────────────────────────────────
    let c1 = code_argv_parse([])
    println("[C1] code_argv_parse([])")
    println("     → " + _fmt(c1))
    _check("tool=help",  c1["tool"] == "help")
    _check("mode=help",  c1["mode"] == "help")
    _check("known=true", c1["known"] == true)

    // ── C2 ["think"] → tool=think, default mode=once ───────────────────────
    let c2 = code_argv_parse(["think"])
    println("[C2] code_argv_parse([\"think\"])")
    println("     → " + _fmt(c2))
    _check("tool=think", c2["tool"] == "think")
    _check("mode=once",  c2["mode"] == "once")
    _check("arg=empty",  c2["arg"]  == "")
    _check("known=true", c2["known"] == true)

    // ── C3 ["file_read","AGENT.md"] → tool=file_read, arg=AGENT.md ─────────
    let c3 = code_argv_parse(["file_read", "AGENT.md"])
    println("[C3] code_argv_parse([\"file_read\",\"AGENT.md\"])")
    println("     → " + _fmt(c3))
    _check("tool=file_read",  c3["tool"] == "file_read")
    _check("arg=AGENT.md",    c3["arg"]  == "AGENT.md")
    _check("mode=once",       c3["mode"] == "once")
    _check("known=true",      c3["known"] == true)

    // ── C4 ["unknown"] → tool preserved, known=false fallback ──────────────
    let c4 = code_argv_parse(["unknown"])
    println("[C4] code_argv_parse([\"unknown\"])")
    println("     → " + _fmt(c4))
    _check("tool=unknown", c4["tool"]  == "unknown")
    _check("mode=once",    c4["mode"]  == "once")
    _check("known=false",  c4["known"] == false)

    // ── live: read actual process argv (echo only, output varies) ──────────
    let live_args = code_argv_read()
    println("[live] code_argv_read() = " + to_string(live_args)
            + "  (size=" + to_string(len(live_args)) + ")")
    let live_parse = code_argv_parse(live_args)
    println("[live] parse           = " + _fmt(live_parse))

    println("[smoke] DONE — 4 cases + live echo (exit 0)")
}
