// code_gate_smoke.hexa — F6 hard gate enforce 5-case smoke.

import "/Users/ghost/core/anima/AGENT/CODE/code_gate.hexa"

fn _check(label: string, ok: bool) {
    let mark = "FAIL"
    if ok { mark = "PASS" }
    println("[" + label + "] " + mark)
}

fn main() {
    println("=== F6 hard gate enforce smoke ===")

    // C1 — T0 think at substrate_tier=0 → accepted
    let v1 = code_gate_enforce("think", 0)
    let c1_ok = to_string(v1["accepted"]) == "true" && to_string(v1["risk"]) == "read"
    _check("C1 think@T0 accepted+read", c1_ok)

    // C2 — file_write (min=T2) at substrate_tier=0 → refused
    let v2 = code_gate_enforce("file_write", 0)
    let c2_ok = to_string(v2["accepted"]) == "false" && to_string(v2["risk"]) == "soft"
    _check("C2 file_write@T0 refused+soft", c2_ok)
    println("  reason: " + to_string(v2["reason"]))

    // C3 — git_push (min=T3) at substrate_tier=3 → accepted
    let v3 = code_gate_enforce("git_push", 3)
    let c3_ok = to_string(v3["accepted"]) == "true" && to_string(v3["risk"]) == "hard"
    _check("C3 git_push@T3 accepted+hard", c3_ok)

    // C4 — unknown tool → refused (min_tier=99 default)
    let v4 = code_gate_enforce("rm_dash_rf_slash", 3)
    let c4_ok = to_string(v4["accepted"]) == "false" && to_string(v4["risk"]) == "unknown"
    _check("C4 unknown tool refused", c4_ok)

    // C5 — batch + audit
    let reqs = [
        #{"tool": "think", "tier": 0},
        #{"tool": "file_read", "tier": 0},
        #{"tool": "file_write", "tier": 1},
        #{"tool": "git_commit", "tier": 3},
        #{"tool": "unknown_tool_x", "tier": 3},
    ]
    let verdicts = code_gate_batch(reqs)
    let audit = code_gate_audit(verdicts)
    let c5_ok = audit["total"] == 5 && audit["accepted"] == 2 && audit["refused"] == 3
    _check("C5 batch audit 5 reqs (2 ok / 3 refuse)", c5_ok)
    println("  audit: total=" + to_string(audit["total"]) + " accepted=" + to_string(audit["accepted"]) + " refused=" + to_string(audit["refused"]) + " refuse_pct=" + to_string(audit["refuse_rate_pct"]))

    let all = c1_ok && c2_ok && c3_ok && c4_ok && c5_ok
    println("")
    println("ALL: " + to_string(all))
}
