// order_pipeline_smoke.hexa — MERCHANT M4 order pipeline smoke (AGENT/MERCHANT).
//
// 1-shot self-check — exercise the 6-fn order pipeline surface against the
// L1 ARBITRAGE adapter pair (amazon_adapter source · coupang_adapter target)
// established in M3. This is a stub-level smoke — no real HTTP calls, no
// marketplace credentials. It only proves the orchestration contract holds:
//
//   C1  pipeline_receive_order returns Order with state="received".
//   C2  pipeline_source_purchase advances state to "sourcing".
//   C3  pipeline_track_shipment returns Shipment with status="in_transit".
//   C4  pipeline_fulfill_to_customer returns Shipment with status="delivered".
//   C5  pipeline_run_order full chain returns steps_completed=4 +
//       status="delivered".
//
// Also exercises pipeline_handle_cs (CS wrap) + order_pipeline_summary
// (manifest), and dumps the M3 adapter pair through adapter_validate as a
// sanity-tier check that the bundles are still well-formed.

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapter.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapters/amazon.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapters/coupang.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/order_pipeline.hexa"

fn main() {
    print("[MERCHANT/M4] order_pipeline smoke — amazon(source) + coupang(target)")
    print("")

    // ── Adapter bundles (M3) ─────────────────────────────────────────
    let source = amazon_adapter()
    let target = coupang_adapter()
    print("[setup] source=" + to_string(source["name"])
        + " validate=" + adapter_validate(source))
    print("[setup] target=" + to_string(target["name"])
        + " validate=" + adapter_validate(target))
    print("")

    let order_id = "ORD-M4-7001"

    // ── C1 ───────────────────────────────────────────────────────────
    print("[C1] pipeline_receive_order(target, '" + order_id + "')")
    let received = pipeline_receive_order(target, order_id)
    print("    " + order_summary(received))
    print("    expected state=received · got state=" + to_string(received["state"]))
    print("")

    // ── C2 ───────────────────────────────────────────────────────────
    print("[C2] pipeline_source_purchase(source, received)")
    let sourced = pipeline_source_purchase(source, received)
    print("    " + order_summary(sourced))
    print("    expected state=sourcing · got state=" + to_string(sourced["state"]))
    if "source_purchase_ref" in sourced {
        print("    source_purchase_ref=" + to_string(sourced["source_purchase_ref"]))
    }
    print("")

    // ── C3 ───────────────────────────────────────────────────────────
    print("[C3] pipeline_track_shipment(source, sourced)")
    let upstream_ship = pipeline_track_shipment(source, sourced)
    print("    " + shipment_summary(upstream_ship))
    print("    expected status=in_transit · got status=" + to_string(upstream_ship["status"]))
    print("")

    // ── C4 ───────────────────────────────────────────────────────────
    print("[C4] pipeline_fulfill_to_customer(target, sourced, upstream_ship)")
    let delivered_ship = pipeline_fulfill_to_customer(target, sourced, upstream_ship)
    print("    " + shipment_summary(delivered_ship))
    print("    expected status=delivered · got status=" + to_string(delivered_ship["status"]))
    print("    upstream events folded forward: " + to_string(len(delivered_ship["events"])) + " total")
    print("")

    // ── C5 ───────────────────────────────────────────────────────────
    print("[C5] pipeline_run_order(source, target, 'ORD-M4-7002') — full 4-stage chain")
    let result = pipeline_run_order(source, target, "ORD-M4-7002")
    let final_order = result["order"]
    let final_ship = result["shipment"]
    let steps = result["steps_completed"]
    print("    final " + order_summary(final_order))
    print("    final " + shipment_summary(final_ship))
    print("    status=" + to_string(result["status"]))
    print("    steps_completed (n=" + to_string(len(steps)) + "): ")
    let mut i = 0
    while i < len(steps) {
        print("      - " + to_string(steps[i]))
        i = i + 1
    }
    print("    expected steps_completed=4 · got=" + to_string(len(steps)))
    print("")

    // ── CS wrap (advisory) ───────────────────────────────────────────
    print("[advisory] pipeline_handle_cs(target, case)")
    let case_open = cs_case_open("CS-M4-1", "ORD-M4-7001", "refund", "Item arrived damaged", "Box was crushed.")
    print("    [open]        " + cs_case_summary(case_open))
    let case_step1 = pipeline_handle_cs(target, case_open)
    print("    [in_progress] " + cs_case_summary(case_step1))
    let case_step2 = pipeline_handle_cs(target, case_step1)
    print("    [resolved]    " + cs_case_summary(case_step2))
    print("")

    // ── manifest (advisory) ──────────────────────────────────────────
    print("[advisory] order_pipeline_summary()")
    print(order_pipeline_summary())
    print("")

    print("[MERCHANT/M4] order_pipeline smoke OK")
}
