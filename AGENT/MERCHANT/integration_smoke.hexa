// integration_smoke.hexa — MERCHANT 3-lane round-trip integration smoke
// (AGENT/MERCHANT/M6 closure · 6/6).
//
// BRIDGE ARCHITECTURE: pure smoke runner — verifies framework reuse across
// 3 lanes (L1 ARBITRAGE source · L1 ARBITRAGE target · L2 NATIVE source) by
// running `pipeline_run_order` chain with each adapter pairing. No conscious-
// ness framing, no real HTTP — stub adapters return contract-shape dicts.
//
// 3-LANE MATRIX:
//   C1 L1-ARBITRAGE — amazon (source) → coupang (target) : 해외 → 국내
//   C2 L2-NATIVE → COUPANG — native (source) → coupang (target) : 자체 → 국내
//   C3 ARBITRAGE OPS — L1 inventory_sync + cs_response_build + settlement
//      (M5 OPS surface 통합 검증)
//
// FRAMEWORK REUSE 핵심:
//   - C1 와 C2 가 SAME `pipeline_run_order` fn 사용
//   - native_adapter() 가 amazon_adapter() 와 byte-identical surface (5 verb)
//   - zero modification to types.hexa / adapter.hexa / order_pipeline.hexa

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapter.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/order_pipeline.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/ops.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapters/amazon.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapters/coupang.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapters/native.hexa"

// C1 — L1 ARBITRAGE round-trip: amazon → coupang
pub fn smoke_case_arbitrage() -> map {
    let src = amazon_adapter()
    let tgt = coupang_adapter()
    let r = pipeline_run_order(src, tgt, "ORD-C1-ARBITRAGE-0001")
    let steps = r["steps_completed"]
    let pass = list_len(steps) == 4 && to_string(r["status"]) == "delivered"
    return #{
        "case": "L1-arbitrage",
        "source": "amazon",
        "target": "coupang",
        "steps_completed": steps,
        "final_status": to_string(r["status"]),
        "pass": pass,
    }
}

// C2 — L2 NATIVE round-trip: native (own warehouse) → coupang
pub fn smoke_case_native() -> map {
    let src = native_adapter()
    let tgt = coupang_adapter()
    let r = pipeline_run_order(src, tgt, "ORD-C2-NATIVE-0001")
    let steps = r["steps_completed"]
    let pass = list_len(steps) == 4 && to_string(r["status"]) == "delivered"
    return #{
        "case": "L2-native",
        "source": "native",
        "target": "coupang",
        "steps_completed": steps,
        "final_status": to_string(r["status"]),
        "pass": pass,
    }
}

// C3 — L3 OPS surface 통합: inventory_sync + cs_response + settlement
pub fn smoke_case_ops() -> map {
    let tgt = coupang_adapter()

    // ops_cs_response_build (pure template, LLM 호출 0)
    let case = cs_case_open("CS-001", "ORD-X-0001", "refund", "환불 요청", "고객 불만")
    let resp = ops_cs_response_build(case, "환불 처리 완료: {order_id} / 사유: {kind}")
    let expected_resp = "환불 처리 완료: ORD-X-0001 / 사유: refund"
    let pass_cs = resp == expected_resp

    // ops_settlement_monitor — adapter 의 settlement verb 가 없으면 zero shape 반환 (honest)
    let settlement = ops_settlement_monitor(tgt, 0.0, 86400.0)
    let pass_settle = map_has(settlement, "gross") && map_has(settlement, "fees") && map_has(settlement, "net")

    let pass = pass_cs && pass_settle
    return #{
        "case": "L3-ops",
        "cs_response": resp,
        "cs_pass": pass_cs,
        "settlement_keys_ok": pass_settle,
        "pass": pass,
    }
}

pub fn integration_smoke_run() -> map {
    let c1 = smoke_case_arbitrage()
    let c2 = smoke_case_native()
    let c3 = smoke_case_ops()
    let all_pass = (to_string(c1["pass"]) == "true") && (to_string(c2["pass"]) == "true") && (to_string(c3["pass"]) == "true")
    return #{
        "arbitrage": c1,
        "native": c2,
        "ops": c3,
        "all_pass": all_pass,
    }
}

pub fn integration_smoke_summary() -> string {
    return "AGENT/MERCHANT/M6 — 3-lane round-trip (L1 amazon→coupang · L2 native→coupang · L3 OPS) · framework reuse 검증 · MERCHANT 6/6 closure"
}

fn main() {
    let r = integration_smoke_run()
    println("=== MERCHANT M6 3-lane integration smoke ===")
    let c1 = r["arbitrage"]
    println("[C1 L1-arbitrage] amazon→coupang · steps=" + to_string(list_len(c1["steps_completed"])) + " status=" + to_string(c1["final_status"]) + " pass=" + to_string(c1["pass"]))
    let c2 = r["native"]
    println("[C2 L2-native]    native→coupang · steps=" + to_string(list_len(c2["steps_completed"])) + " status=" + to_string(c2["final_status"]) + " pass=" + to_string(c2["pass"]))
    let c3 = r["ops"]
    println("[C3 L3-ops]       cs+settlement · cs_pass=" + to_string(c3["cs_pass"]) + " settlement_keys_ok=" + to_string(c3["settlement_keys_ok"]) + " pass=" + to_string(c3["pass"]))
    println("all_pass: " + to_string(r["all_pass"]))
}
