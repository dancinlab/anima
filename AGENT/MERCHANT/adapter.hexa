// adapter.hexa — MarketplaceAdapter abstract surface (AGENT/MERCHANT).
//
// Bridge architecture: this file defines a CONVENTION, not an enforced
// interface. hexa-lang has no formal trait/interface — an adapter is simply
// a dict carrying a `name` plus five named function values. Concrete
// adapters (Amazon · AliExpress · Coupang · Naver SS · ...) land in M2+
// and conform to this shape so AGENT/CORE/tool_gate can dispatch uniformly.
//
// Verb surface (5 lanes — search · list · order · ship · cs) is fixed and
// matches the five MERCHANT.md lanes. Concrete signatures are documented by
// adapter_verb_signatures() below; validation is structural (presence-only),
// so an adapter under development can stub a verb with a no-op and still
// pass adapter_validate() while M2 fleshes out the live calls.

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"

// ── Verb signature catalogue ───────────────────────────────────────────────
// Documentation function — returns a human-readable signature manifest so
// callers (and reviewers) can confirm the surface without grepping source.

pub fn adapter_verb_signatures() -> string {
    "MarketplaceAdapter 5-verb surface:\n"
        + "  search(query: string, max_results: int) -> [Product]\n"
        + "      // discover candidate items on the SOURCE marketplace.\n"
        + "  list(listing: Listing, dry_run: bool) -> Listing\n"
        + "      // post listing to TARGET marketplace; returns updated\n"
        + "      // listing with target_url populated and status advanced.\n"
        + "  order(order: Order) -> Order\n"
        + "      // submit order; returns updated order with state advanced\n"
        + "      // (received -> sourcing -> shipping -> delivered).\n"
        + "  ship(order_id: string) -> Shipment\n"
        + "      // fetch current shipment snapshot for the given order.\n"
        + "  cs(case: CSCase) -> CSCase\n"
        + "      // step a CS case forward; returns updated case with\n"
        + "      // status advanced (open -> in_progress -> resolved)."
}

// ── Structural validation ──────────────────────────────────────────────────
// Presence-only check — confirms the 5 required verbs + `name` are on the
// adapter dict. Callers in AGENT/CORE should validate before dispatch.

pub fn adapter_required_verbs() -> [string] {
    ["search", "list", "order", "ship", "cs"]
}

pub fn adapter_validate(adapter: map) -> string {
    let required = adapter_required_verbs()
    let mut missing = []
    let mut i = 0
    while i < len(required) {
        let verb = required[i]
        if !(verb in adapter) {
            missing = missing + [verb]
        }
        i = i + 1
    }
    if len(missing) == 0 {
        return "ok"
    }
    let mut out = "missing:"
    let mut j = 0
    while j < len(missing) {
        out = out + " " + missing[j]
        j = j + 1
    }
    out
}

// ── Uniform dispatch helper ────────────────────────────────────────────────
// adapter_call(a, "search", [query, max_results]) — invoked from AGENT/CORE
// once the substrate's tier opens the right tool. Args are positional; the
// helper unpacks them so the caller does not need a verb-specific branch.

pub fn adapter_call(adapter: map, verb: string, args: [any]) -> any {
    if !(verb in adapter) {
        return "ERROR: verb '" + verb + "' not on adapter '" + to_string(adapter["name"]) + "'"
    }
    let f = adapter[verb]
    let n = len(args)
    if n == 0 { return f() }
    if n == 1 { return f(args[0]) }
    if n == 2 { return f(args[0], args[1]) }
    if n == 3 { return f(args[0], args[1], args[2]) }
    "ERROR: adapter_call supports up to 3 args (got " + to_string(n) + ")"
}

// ── Convenience: skeleton builder ──────────────────────────────────────────
// Build an adapter dict from five function values. M2 concrete adapters can
// either use this helper or assemble the dict literal directly.

pub fn adapter_new(
    name: string,
    search_fn: fn,
    list_fn: fn,
    order_fn: fn,
    ship_fn: fn,
    cs_fn: fn
) -> map {
    #{
        "name": name,
        "search": search_fn,
        "list": list_fn,
        "order": order_fn,
        "ship": ship_fn,
        "cs": cs_fn
    }
}
