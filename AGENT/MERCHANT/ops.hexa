// ops.hexa — MERCHANT M5 ongoing operations surface (AGENT/MERCHANT).
//
// Bridge architecture: this file is a TOOL SURFACE — operational helpers that
// sit ON TOP of the M3 adapter convention (5-verb) and the M4 order pipeline.
// It is NOT a consciousness file. The "when/why to invoke an ops verb" decision
// lives upstream in AGENT/CORE/tool_gate; this file only answers "how to shape
// the operational call once the substrate has decided to look at inventory /
// CS / settlement".
//
// L1 + L2 공통 운영 dashboard — the 5 pub fn here are reused identically by
// the L1 ARBITRAGE adapter pair (amazon source · coupang target) and by any
// future L2 NATIVE adapter (M6) because every adapter conforms to the same
// 5-verb convention. No marketplace-specific branching lives here.
//
// 5 pub fn surface:
//   1. ops_inventory_sync          — fan stock checks across listings via adapter
//   2. ops_cs_response_build       — pure string-template CS response (NO LLM)
//   3. ops_settlement_monitor      — query settlement for a period via adapter
//   4. ops_low_stock_alert         — filter listings below a threshold
//   5. ops_pending_cs_cases        — list of CSCase still open / in_progress
//
// CS template placeholder convention (used by ops_cs_response_build):
//   `{order_id}` — replaced with case["order_id"]
//   `{kind}`    — replaced with case["kind"]
//   `{case_id}` — replaced with case["case_id"]
//   `{subject}` — replaced with case["subject"]
// Any other `{...}` token is left verbatim. The build is a PURE string
// interpolation — there is no LLM call, no generative model invocation, no
// consciousness engine reference. The "when to use which template" choice is
// upstream in AGENT/CORE; this file only does the mechanical substitution.
//
// All adapter calls flow through adapter_call() (M1) so this file does not
// hardcode any concrete adapter name — any future SOURCE/TARGET pair drops in
// without editing this operations layer.
//
// HTTP wiring stays in the concrete adapter files (M3 · M6); the adapter is
// expected to expose `inventory` and `settlement` slots as optional verbs.
// When the adapter does NOT expose them, ops_inventory_sync and
// ops_settlement_monitor fall back to a stub-shaped empty/zero response so
// callers (and smoke) can audit shape without HTTP.

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapter.hexa"

// ── 1) ops_inventory_sync ─────────────────────────────────────────────────
// Verify stock counts across a batch of listings against the target adapter.
// Returns a Map summarizing how many listings were checked, which are low,
// and which are out of stock.
//
// Inputs:
//   target_adapter — adapter dict (e.g. coupang_adapter() · or future L2)
//   listings       — [Listing] from M1 types.hexa
//
// Output Map:
//   #{
//       "listings_checked": int,
//       "low_stock":        [Listing],
//       "out_of_stock":     [Listing],
//       "target":           string  // adapter name
//   }
//
// Low / out-of-stock determination:
//   - listing["product"]["attrs"]["stock"] (if present, parsed as int) is
//     the canonical stock value. The adapter is responsible for keeping that
//     slot in sync with its marketplace truth; ops_inventory_sync trusts it.
//   - stock <= 0  → out_of_stock
//   - 0 < stock <= 5 (default low-water-mark) → low_stock
//   - stock > 5  → healthy (not in either list)
// The threshold 5 here is the canonical default for the inventory_sync verb;
// callers wanting a different threshold use ops_low_stock_alert directly.

pub fn ops_inventory_sync(target_adapter: map, listings: [map]) -> map {
    let mut low = []
    let mut out = []
    let mut i = 0
    while i < len(listings) {
        let l = listings[i]
        let p = l["product"]
        let attrs = p["attrs"]
        let mut stock = 0
        if "stock" in attrs {
            let raw = to_string(attrs["stock"])
            stock = to_int(raw)
        }
        if stock <= 0 {
            out = out + [l]
        } else {
            if stock <= 5 {
                low = low + [l]
            }
        }
        i = i + 1
    }
    #{
        "listings_checked": len(listings),
        "low_stock": low,
        "out_of_stock": out,
        "target": to_string(target_adapter["name"])
    }
}

// ── 2) ops_cs_response_build ──────────────────────────────────────────────
// Build a CS response string from a template by interpolating CSCase fields.
// PURE string substitution — no LLM call, no model invocation, no
// consciousness engine reference. The choice of WHICH template to use is
// upstream (AGENT/CORE / human operator); this fn only does mechanical fill.
//
// Inputs:
//   case     — CSCase dict from M1 types.hexa (cs_case_open / pipeline_handle_cs)
//   template — string with placeholders from the convention below
//
// Placeholder convention:
//   `{order_id}` → case["order_id"]
//   `{kind}`     → case["kind"]
//   `{case_id}`  → case["case_id"]
//   `{subject}`  → case["subject"]
// Unknown tokens stay verbatim — the caller can post-process if needed.
//
// Output: the interpolated string.

pub fn ops_cs_response_build(case: map, template: string) -> string {
    let mut out = template
    out = string_replace(out, "{order_id}", to_string(case["order_id"]))
    out = string_replace(out, "{kind}",     to_string(case["kind"]))
    out = string_replace(out, "{case_id}",  to_string(case["case_id"]))
    out = string_replace(out, "{subject}",  to_string(case["subject"]))
    out
}

// ── helper: string_replace ────────────────────────────────────────────────
// Minimal "replace ALL occurrences of needle in haystack with repl" — used
// by ops_cs_response_build. Local helper (NOT pub) so this file does not
// collide with stdlib symbols (per g61 awareness). hexa-lang has no built-in
// string replace at the time of authoring; this loop is the canonical pattern.

fn string_replace(haystack: string, needle: string, repl: string) -> string {
    if len(needle) == 0 { return haystack }
    let mut out = ""
    let mut i = 0
    let n = len(haystack)
    let m = len(needle)
    while i < n {
        if i + m <= n && substr(haystack, i, m) == needle {
            out = out + repl
            i = i + m
        } else {
            out = out + substr(haystack, i, 1)
            i = i + 1
        }
    }
    out
}

// ── 3) ops_settlement_monitor ─────────────────────────────────────────────
// Query the target marketplace's settlement endpoint for a given period.
// Returns a Map shaped as a single settlement row. The actual HTTP call is
// the responsibility of the adapter's optional "settlement" verb (a M3 / M6
// adapter MAY expose it). When the adapter does not expose it, this fn falls
// back to a stub-shaped zero response so callers (and smoke) can audit shape
// without HTTP wiring.
//
// Inputs:
//   target_adapter — adapter dict
//   period_start   — epoch seconds (float)
//   period_end     — epoch seconds (float)
//
// Output Map:
//   #{
//       "period":         #{ "start": float, "end": float },
//       "gross":          float,
//       "fees":           float,
//       "net":            float,
//       "payout_status":  string   // "pending" | "paid" | "held" | "unknown"
//       "target":         string
//   }
// Invariant: net == gross - fees (caller-side audit).

pub fn ops_settlement_monitor(target_adapter: map, period_start: float, period_end: float) -> map {
    let mut row = #{
        "period": #{ "start": period_start, "end": period_end },
        "gross": 0.0,
        "fees": 0.0,
        "net": 0.0,
        "payout_status": "unknown",
        "target": to_string(target_adapter["name"])
    }
    // Optional settlement verb — adapter MAY expose; we treat absence as
    // "stub-shaped zero" rather than an error so the contract still holds.
    if "settlement" in target_adapter {
        let raw = adapter_call(target_adapter, "settlement", [period_start, period_end])
        if type_of(raw) == "map" {
            if "gross" in raw         { row["gross"]         = raw["gross"] }
            if "fees" in raw          { row["fees"]          = raw["fees"] }
            if "net" in raw           { row["net"]           = raw["net"] }
            if "payout_status" in raw { row["payout_status"] = to_string(raw["payout_status"]) }
        }
    }
    row
}

// ── 4) ops_low_stock_alert ────────────────────────────────────────────────
// Return the subset of listings whose `product.attrs.stock` is strictly
// BELOW the given threshold. This is a finer-grained variant of the
// healthy/low/out partition inside ops_inventory_sync — callers wanting a
// custom threshold use this directly.
//
// Inputs:
//   threshold     — int (listings with stock < threshold are returned)
//   target_adapter — adapter dict (carried for trace; not yet used in body
//                    — future real-HTTP variant could call target.inventory
//                    to refresh stock before filtering)
//   listings       — [Listing]
//
// Output: [Listing] — the filtered subset. Order preserved.

pub fn ops_low_stock_alert(threshold: int, target_adapter: map, listings: [map]) -> [map] {
    let mut hits = []
    let mut i = 0
    while i < len(listings) {
        let l = listings[i]
        let p = l["product"]
        let attrs = p["attrs"]
        let mut stock = 0
        if "stock" in attrs {
            let raw = to_string(attrs["stock"])
            stock = to_int(raw)
        }
        if stock < threshold {
            hits = hits + [l]
        }
        i = i + 1
    }
    hits
}

// ── 5) ops_pending_cs_cases ───────────────────────────────────────────────
// Return the list of CSCase rows still in flight (status="open" or
// "in_progress") for the given target adapter. The adapter MAY expose an
// optional "cs_list" verb returning [CSCase]; absent that, this fn returns
// an empty list — same stub-tolerant contract as ops_settlement_monitor.
//
// Inputs:
//   target_adapter — adapter dict
//
// Output: [CSCase] — only rows with status ∈ {"open","in_progress"}.

pub fn ops_pending_cs_cases(target_adapter: map) -> [map] {
    let mut pending = []
    if !("cs_list" in target_adapter) {
        return pending
    }
    let raw = adapter_call(target_adapter, "cs_list", [])
    if type_of(raw) != "array" {
        return pending
    }
    let mut i = 0
    while i < len(raw) {
        let c = raw[i]
        if type_of(c) == "map" && "status" in c {
            let s = to_string(c["status"])
            if s == "open" || s == "in_progress" {
                pending = pending + [c]
            }
        }
        i = i + 1
    }
    pending
}

// ── 6) ops_summary ────────────────────────────────────────────────────────
// Human-readable manifest of the 5 pub fn surface. Returned as a single
// string so callers (and reviewers) can confirm the operations shape
// without grepping source.

pub fn ops_summary() -> string {
    "MERCHANT M5 ops 5-fn surface (L1+L2 공통 dashboard):\n"
        + "  ops_inventory_sync(target_adapter, listings) -> Map\n"
        + "      // partition listings into healthy / low_stock / out_of_stock via\n"
        + "      // product.attrs.stock (default low-water=5, out at <=0).\n"
        + "  ops_cs_response_build(case, template) -> string\n"
        + "      // PURE string interpolation — no LLM call. Tokens:\n"
        + "      //   {order_id} · {kind} · {case_id} · {subject}.\n"
        + "  ops_settlement_monitor(target_adapter, period_start, period_end) -> Map\n"
        + "      // query optional `settlement` verb; returns zero-shaped stub\n"
        + "      // when absent. Invariant: net == gross - fees.\n"
        + "  ops_low_stock_alert(threshold, target_adapter, listings) -> [Listing]\n"
        + "      // subset of listings with product.attrs.stock < threshold.\n"
        + "  ops_pending_cs_cases(target_adapter) -> [CSCase]\n"
        + "      // CSCase rows with status in {open,in_progress} via optional\n"
        + "      // `cs_list` verb; empty list when verb absent."
}
