// amazon.hexa — Amazon SOURCE-side L1 ARBITRAGE adapter (AGENT/MERCHANT).
//
// Bridge architecture: this file is a TOOL SURFACE — concrete adapter that
// conforms to the MarketplaceAdapter convention defined in
// AGENT/MERCHANT/adapter.hexa. It maps Amazon's catalog into MERCHANT's
// normalized Product/Listing/Order/Shipment/CSCase types so AGENT/CORE can
// dispatch uniformly. The "when/why" to call any verb is decided upstream
// in AGENT/CORE/tool_gate; this file only answers "how to shape the call".
//
// Stub-level implementation: all 5 verbs return placeholder values shaped
// to the M1 type contract. Real HTTP wiring (Amazon Product Advertising API
// v5 · MWS · SP-API · scraping fallback) is deferred to a follow-up
// milestone — endpoints are cited inline so the wiring work has a target.
//
// Source role in the L1 ARBITRAGE flow:
//   amazon (here) ── search → Product ─→ Listing ─→ (target adapter, e.g. coupang)
//   amazon (here) ── order → ──→ purchase upstream against the source SKU
//   amazon (here) ── ship  → ──→ tracking snapshot from Amazon's carrier
//   amazon (here) ── cs    → ──→ refund / return ticket against Amazon
//   amazon (here) ── list  → no-op (Amazon is not a target marketplace in L1)
//
// All identifiers below are English; doc strings are bilingual (KO for
// rationale notes, EN for endpoint citations).

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapter.hexa"

// ── 1) search ──────────────────────────────────────────────────────────────
// Real endpoint (TODO):
//   POST https://webservices.amazon.com/paapi5/searchitems
//   PA-API v5 — requires access_key + secret_key + partner_tag,
//   signed AWS-v4 request, region-locked to one of na/eu/fe.
//   Response → ItemsResult.Items[].{ASIN, ItemInfo.Title, Offers.Listings,
//   Images.Primary.Large, DetailPageURL}
//
// Stub: returns one canonical Product so downstream pipeline smoke can run.

pub fn amazon_search(query: string, max_results: int) -> [map] {
    // TODO(M-real-http): replace stub with hexa_exec curl + AWS-v4 sign.
    // The shape here MUST stay the same — return [Product].
    let sample = product_new(
        "AMZ-STUB-USBCHUB-7P",
        "7-Port USB-C Hub (Aluminum, 100W PD, 4K HDMI)",
        24.99,
        "USD",
        "Aluminum-bodied USB-C hub. 1×HDMI 4K@30Hz, 3×USB-A 3.0, 1×PD-100W, 1×SD, 1×TF. Stub Product for the " + query + " query.",
        ["https://m.media-amazon.com/images/I/STUB-USBCHUB-7P.jpg"],
        "amazon",
        "https://www.amazon.com/dp/B0STUBUSBCHUB",
        #{
            "asin": "B0STUBUSBCHUB",
            "rating": "4.4",
            "review_count": "12834",
            "prime": "true",
            "query_echo": query,
            "max_results_echo": to_string(max_results)
        }
    )
    // Cap at max_results (here always 1, but the shape is the contract).
    if max_results <= 0 { return [] }
    [sample]
}

// ── 2) list ────────────────────────────────────────────────────────────────
// Amazon is a SOURCE marketplace in L1 ARBITRAGE — there is no "post a
// listing" verb meaningful at this end. We honor the adapter convention by
// returning the input listing with a clear marker so callers see the no-op.

pub fn amazon_list(listing: map, dry_run: bool) -> map {
    // TODO(M-l2-native): if Amazon becomes a TARGET in L2 NATIVE, this is
    //   where Amazon-Seller-Central listing creation lands (SP-API
    //   /listings/2021-08-01/items/{sellerId}/{sku}).
    let l = listing
    let mut next = #{}
    let mut keys = ["product", "target_marketplace", "listed_price", "margin_pct", "target_url", "status"]
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        next[k] = l[k]
        i = i + 1
    }
    next["status"] = "noop_source_only"
    next["target_url"] = ""
    next["dry_run_echo"] = dry_run
    next
}

// ── 3) order ───────────────────────────────────────────────────────────────
// Place a purchase against Amazon for the source SKU referenced by the
// upstream listing.product. Advances state received → sourcing.
//
// Real endpoint (TODO):
//   No public consumer-purchase API exists. Three practical paths:
//   (a) Amazon Business Buy Shopping API (B2B accounts, region-gated)
//   (b) headless browser automation against amazon.com (fragile, ToS risk)
//   (c) third-party fulfillment middlemen (Zinc API, etc.)
//   Wiring decision deferred — adapter shape stays the same regardless.

pub fn amazon_order(order: map) -> map {
    // TODO(M-real-http): hexa_exec curl against chosen path (a/b/c above).
    let mut next = #{}
    let keys = ["order_id", "listing", "qty", "customer_ref", "placed_at", "state"]
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        next[k] = order[k]
        i = i + 1
    }
    next["state"] = "sourcing"
    next["source_purchase_ref"] = "AMZ-PO-STUB-" + to_string(order["order_id"])
    next
}

// ── 4) ship ────────────────────────────────────────────────────────────────
// Fetch a shipment snapshot for the given order. Stub returns an in_transit
// shipment with one carrier event so downstream consumers can render.
//
// Real endpoint (TODO):
//   GET https://api.amazon.com/orders/v0/orders/{orderId}/shipments  (SP-API)
//   or aggregate carrier (UPS/USPS/Amazon-Logistics) tracking endpoints.

pub fn amazon_ship(order_id: string) -> map {
    // TODO(M-real-http): hexa_exec curl SP-API GET; map carrier events to
    //   the events: [map] slot on Shipment.
    shipment_new(
        order_id,
        "1Z-AMZ-STUB-" + order_id,
        "amazon_logistics",
        "in_transit",
        [
            #{
                "at": "1748180000",
                "where": "Amazon-Fulfillment-PHX7",
                "note": "Departed origin (stub)"
            }
        ]
    )
}

// ── 5) cs ──────────────────────────────────────────────────────────────────
// Step a CS case (refund · exchange · inquiry · complaint) one stage
// forward against Amazon's seller-CS surface.
//
// Real endpoint (TODO):
//   POST https://sellercentral.amazon.com/messaging/v1/orders/{orderId}/messages
//   (SP-API Messaging) for inquiry/complaint,
//   POST https://sellercentral.amazon.com/orders-api/refunds for refund.

pub fn amazon_cs(case: map) -> map {
    // TODO(M-real-http): branch on case["kind"] and dispatch to the
    //   correct SP-API endpoint; map response to CSCase.status transition.
    let mut next = #{}
    let keys = ["case_id", "order_id", "kind", "subject", "body", "status"]
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        next[k] = case[k]
        i = i + 1
    }
    let cur = to_string(case["status"])
    if cur == "open" {
        next["status"] = "in_progress"
    } else {
        next["status"] = "resolved"
    }
    next["upstream_marketplace"] = "amazon"
    next
}

// ── adapter bundle ─────────────────────────────────────────────────────────
// Return the 5-verb dict per MarketplaceAdapter convention. AGENT/CORE
// calls this once at boot and stashes the result for tier-gated dispatch.

pub fn amazon_adapter() -> map {
    adapter_new(
        "amazon",
        amazon_search,
        amazon_list,
        amazon_order,
        amazon_ship,
        amazon_cs
    )
}
