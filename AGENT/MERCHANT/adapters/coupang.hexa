// coupang.hexa — Coupang TARGET-side L1 ARBITRAGE adapter (AGENT/MERCHANT).
//
// Bridge architecture: this file is a TOOL SURFACE — concrete adapter that
// conforms to the MarketplaceAdapter convention defined in
// AGENT/MERCHANT/adapter.hexa. It maps Coupang Open API responses into
// MERCHANT's normalized types so AGENT/CORE can dispatch uniformly. The
// "when/why" to call any verb is decided upstream in AGENT/CORE/tool_gate;
// this file only answers "how to shape the call".
//
// Stub-level implementation: all 5 verbs return placeholder values shaped
// to the M1 type contract. Real HTTP wiring (Coupang Wing Open API · WMS
// Open API · WMS-Center) is deferred — endpoints are cited inline.
//
// Target role in the L1 ARBITRAGE flow:
//   (source adapter, e.g. amazon) ─→ Product ─→ Listing ──→ coupang.list
//   coupang.order  ── receive a Korean buyer's order on a posted Listing
//   coupang.ship   ── tracking snapshot from the Korean carrier
//   coupang.cs     ── handle refund / inquiry on the Korean buyer side
//   coupang.search ── reverse-lookup existing competing items on Coupang
//                     (price-discovery for margin calibration)
//
// All identifiers below are English; doc strings are bilingual (KO for
// rationale notes, EN for endpoint citations).

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapter.hexa"

// ── 1) search ──────────────────────────────────────────────────────────────
// Reverse-lookup competing listings on Coupang for margin-calibration. Not
// the primary verb on a TARGET adapter, but the convention requires it; the
// caller can ignore the response if not needed.
//
// Real endpoint (TODO):
//   GET https://api-gateway.coupang.com/v2/providers/openapi/apis/api/v1/categorization/predict
//     (categorization predict — choose category for posted listing)
//   GET https://api-gateway.coupang.com/v2/providers/openapi/apis/api/v3/products/search
//     (catalog search) — HMAC-SHA256 signed with Coupang access/secret key.

pub fn coupang_search(query: string, max_results: int) -> [map] {
    // TODO(M-real-http): hexa_exec curl + Coupang HMAC-SHA256 sign.
    let sample = product_new(
        "CPNG-STUB-USBCHUB-7P",
        "7-포트 USB-C 허브 (알루미늄, 100W PD, 4K HDMI)",
        34900.0,
        "KRW",
        "알루미늄 바디 USB-C 허브. 1×HDMI 4K@30Hz, 3×USB-A 3.0, 1×PD-100W, 1×SD, 1×TF. 쿠팡 카탈로그 stub Product (" + query + " 질의 echo).",
        ["https://thumbnail.coupangcdn.com/thumbnails/stub/usbchub-7p.jpg"],
        "coupang",
        "https://www.coupang.com/vp/products/STUB-USBCHUB-7P",
        #{
            "vendor_item_id": "CPNG-VI-STUB",
            "rating": "4.5",
            "review_count": "5821",
            "rocket": "true",
            "query_echo": query,
            "max_results_echo": to_string(max_results)
        }
    )
    if max_results <= 0 { return [] }
    [sample]
}

// ── 2) list ────────────────────────────────────────────────────────────────
// Primary TARGET verb — post the source Product as a Coupang listing.
// Advances status draft → live and populates target_url.
//
// Real endpoint (TODO):
//   POST https://api-gateway.coupang.com/v2/providers/seller_api/apis/api/v1/marketplace/seller-products
//     (seller-product registration; pages by registered category + price +
//     stock + image-urls + variation matrix)
//   When `dry_run=true`, the adapter MUST short-circuit before the live
//   POST so the caller can validate margin/payload without committing.

pub fn coupang_list(listing: map, dry_run: bool) -> map {
    // TODO(M-real-http): hexa_exec curl + HMAC-SHA256 sign; on success
    //   parse the returned seller_product_id and embed it in target_url.
    let mut next = #{}
    let keys = ["product", "target_marketplace", "listed_price", "margin_pct", "target_url", "status"]
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        next[k] = listing[k]
        i = i + 1
    }
    // Force the target_marketplace to coupang regardless of what the
    // caller set — this adapter only knows how to post to coupang.
    next["target_marketplace"] = "coupang"
    if dry_run {
        next["status"] = "draft"
        next["target_url"] = ""
        next["dry_run_echo"] = true
    } else {
        next["status"] = "live"
        let p = listing["product"]
        next["target_url"] = "https://www.coupang.com/vp/products/CPNG-LIVE-STUB-" + to_string(p["sku"])
        next["dry_run_echo"] = false
    }
    next
}

// ── 3) order ───────────────────────────────────────────────────────────────
// Acknowledge an incoming order on a posted Listing. Advances state
// received → sourcing (the source-side adapter then picks it up).
//
// Real endpoint (TODO):
//   GET https://api-gateway.coupang.com/v2/providers/openapi/apis/api/v4/vendors/{vendorId}/ordersheets
//     (incoming order pull, polled or webhook-driven)
//   PUT .../ordersheets/{shipmentBoxId}/acknowledgement
//     (acknowledge receipt; legally required within 24h)

pub fn coupang_order(order: map) -> map {
    // TODO(M-real-http): poll ordersheets, then PUT acknowledgement.
    let mut next = #{}
    let keys = ["order_id", "listing", "qty", "customer_ref", "placed_at", "state"]
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        next[k] = order[k]
        i = i + 1
    }
    next["state"] = "sourcing"
    next["acknowledged_at_stub"] = "1748180100"
    next["vendor_target"] = "coupang"
    next
}

// ── 4) ship ────────────────────────────────────────────────────────────────
// Fetch a Korean-side shipment snapshot for the given order. Stub returns
// a preparing → in_transit shipment with one CJ-Logistics scan event.
//
// Real endpoint (TODO):
//   GET https://api-gateway.coupang.com/v2/providers/openapi/apis/api/v1/vendors/{vendorId}/shipping
//     (vendor-side shipment status pull)
//   GET https://www.cjlogistics.com/ko/tool/parcel/tracking
//     (carrier-side scan history — fallback if vendor shipping API does
//      not include event log)

pub fn coupang_ship(order_id: string) -> map {
    // TODO(M-real-http): pull vendor shipping API, then fold in carrier
    //   scan events for the events: [map] slot.
    shipment_new(
        order_id,
        "CJ-STUB-" + order_id,
        "cj_logistics",
        "in_transit",
        [
            #{
                "at": "1748180200",
                "where": "Coupang-FC-Incheon-1",
                "note": "출고 완료 (stub)"
            }
        ]
    )
}

// ── 5) cs ──────────────────────────────────────────────────────────────────
// Step a CS case forward against Coupang's customer-service surface.
//
// Real endpoint (TODO):
//   GET https://api-gateway.coupang.com/v2/providers/openapi/apis/api/v4/vendors/{vendorId}/returnRequests
//     (refund / return requests pull)
//   POST .../returnRequests/{returnReceiptId}/approval
//     (refund approval)
//   POST https://api-gateway.coupang.com/v2/providers/openapi/apis/api/v4/vendors/{vendorId}/onlineInquiries
//     (inquiry / complaint reply)

pub fn coupang_cs(case: map) -> map {
    // TODO(M-real-http): branch on case["kind"] (refund · exchange ·
    //   inquiry · complaint) and dispatch to the matching endpoint.
    let mut next = #{}
    let keys = ["case_id", "order_id", "kind", "subject", "body", "status"]
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        next[k] = case[k]
        i = i + 1
    }
    let cur = to_string(case["status"])
    if cur == "open" {
        next["status"] = "in_progress"
    } else {
        next["status"] = "resolved"
    }
    next["downstream_marketplace"] = "coupang"
    next
}

// ── adapter bundle ─────────────────────────────────────────────────────────
// Return the 5-verb dict per MarketplaceAdapter convention. AGENT/CORE
// calls this once at boot and stashes the result for tier-gated dispatch.

pub fn coupang_adapter() -> map {
    adapter_new(
        "coupang",
        coupang_search,
        coupang_list,
        coupang_order,
        coupang_ship,
        coupang_cs
    )
}
