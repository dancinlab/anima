// types_smoke.hexa — MERCHANT M1 smoke (AGENT/MERCHANT).
//
// 1-shot self-check — construct one of each of the 5 types, print summaries,
// validate two adapter dicts (one complete, one missing the `cs` verb). Used
// as a hand-run gate for the M1 milestone before M2 builds concrete adapters.

import "/Users/ghost/core/anima/AGENT/MERCHANT/types.hexa"
import "/Users/ghost/core/anima/AGENT/MERCHANT/adapter.hexa"

// ── Stub adapter verbs (no-op shapes for validation only) ──────────────────

fn stub_search(query: string, max_results: int) -> [map] { [] }
fn stub_list(listing: map, dry_run: bool) -> map { listing }
fn stub_order(order: map) -> map { order }
fn stub_ship(order_id: string) -> map { shipment_preparing(order_id, "stub") }
fn stub_cs(case: map) -> map { case }

fn main() {
    print("[MERCHANT/M1] types + adapter smoke")

    // 1) Product
    let p = product_new(
        "SKU-001",
        "AAA battery 12-pack",
        9.99,
        "USD",
        "Long-life alkaline batteries.",
        ["https://example.com/img1.jpg"],
        "amazon",
        "https://amazon.com/dp/AAA001",
        #{"category": "electronics", "weight_g": "180"}
    )
    print(product_summary(p))

    // 2) Listing
    let l = listing_draft(p, "coupang", 14990.0, 30.0)
    print(listing_summary(l))

    // 3) Order
    let o = order_received("ORD-9001", l, 2, "cust-ref-opaque", 1748131200.0)
    print(order_summary(o))

    // 4) Shipment
    let s = shipment_new("ORD-9001", "1Z999AA10123456784", "ups", "in_transit", [
        #{"at": "1748131500", "where": "JFK", "note": "Departed origin"}
    ])
    print(shipment_summary(s))

    // 5) CSCase
    let c = cs_case_open("CS-1", "ORD-9001", "refund", "Item arrived damaged", "Box was crushed.")
    print(cs_case_summary(c))

    // 6) Adapter validate — complete
    let full = adapter_new("stub_full", stub_search, stub_list, stub_order, stub_ship, stub_cs)
    print("[validate full] " + adapter_validate(full))

    // 7) Adapter validate — missing `cs`
    let partial = #{
        "name": "stub_partial",
        "search": stub_search,
        "list": stub_list,
        "order": stub_order,
        "ship": stub_ship
    }
    print("[validate partial] " + adapter_validate(partial))

    // 8) Verb signature manifest (advisory)
    print(adapter_verb_signatures())

    print("[MERCHANT/M1] smoke OK")
}
