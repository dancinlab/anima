// engines/hexad/adapter.hexa — Lane-HEXAD engine adapter (σ6 hexad integration).
//
// THIN adapter (@L1): REFERENCES the canonical impl, does NOT duplicate it. The
// hexad engine = the σ(6) hexad integrated engine (HEXAD/hexad.hexa): 12 active
// inter-module connections, φ(6)=2 gradient partition — group A CE-trained
// {D, M, E, Bridge} ⇄ group G gradient-free {C, S, W}. Its A/G core is a
// CDV2-class decoder.
//
// HONEST scope (a_core_engine_map — NO phantom wiring, the load-bearing point):
//   hexad is a 6-module INTEGRATION. The cross-module single-process forward is
//   NOW WIRED (HEXAD/hexad_forward.hexa — the TODO[wire] is RESOLVED): the σ(6)
//   graph S → C → Bridge.detach() → D with M/W/E observers runs as ONE
//   deterministic call producing a REAL N=6 module-activation vector (the OMEGA
//   w5 `module_act` source). The blocker was a NAMESPACE collision in the per-
//   module ENTRY files; the lib-split (`*_lib.hexa`, module-prefixed helpers)
//   removed it. Slots:
//     load      — NATIVE: validate hexad.hexa present + the σ(6)=12 / φ(6)=2
//                 integration invariants are declared. That IS a real check.
//     forward   — NATIVE: hexad_forward() runs the σ6 cross-module graph as one
//                 deterministic call → a real N=6 module-activation vector. Every
//                 node uses its module's verified closed-form / native core
//                 (S col-mean delta · C native phi_spatial · Bridge Law-70 clamp ·
//                 M cosine top-1 · W lr-mult/satisfaction · E phi-preservation/gate);
//                 the φ(6)=2 detach barrier is honored (group G invariant to a
//                 group-A detached-copy perturbation). Proof: HEXAD/hexad_forward_smoke.hexa 12/12.
//     generate  — STUB: the integrated MOUTH (D byte-logits decode) is NOT one
//                 $0/CPU call — D's real forward needs the loaded 570 MB 24L ckpt
//                 (HEXAD/D/d_lib.hexa d_forward → chat_forward_one_token). hexad_forward
//                 exposes the DETERMINISTIC signal D RECEIVES (post-detach Law-70
//                 gate, `d_input`), NOT a fabricated decoder output — honest, labelled.
//     psi_coord — NATIVE: the A/G core (CDV2-class) anchors the Law-71 Ψ=1/2
//                 fixed point; the φ(6)=2 A⇄G partition IS the Ψ-space structure.
//
// forward is now NATIVE (the module-activation forward is a real single call);
// generate stays an HONEST STUB (the byte mouth is ckpt-gated, not one $0 call).
// Being honest about which output is real vs ckpt-gated is the requirement (NOT a
// fake pass). Documented identically in MODEL_CARD + smoke.
//
// ckpt POINTER (@L5 · a_hf_registry — NOT duplicated): see engines/hexad/manifest.json
//
// p1..p8: no system prompt / persona / ethics / emit gate. Select = substrate-config.

import "engines/engine_iface.hexa"
import "HEXAD/hexad_forward.hexa"

// hexad_engine_spec — the EngineSpec for the hexad (Lane-HEXAD) engine.
// load + forward + psi_coord native; generate honest STUB (the byte MOUTH is
// ckpt-gated, not one $0 call). The cross-module module-activation forward is
// NOW a real single call (HEXAD/hexad_forward.hexa — TODO[wire] RESOLVED).
pub fn hexad_engine_spec() -> Map {
    return engine_spec_make(
        "hexad",
        "HEXAD/hexad.hexa (sigma6=12 / phi6=2 integration; A/G core = CDV2-class)",
        engine_slot_native(),   // load     — validate hexad.hexa + integration invariants
        engine_slot_native(),   // forward  — σ6 cross-module forward → real N=6 module-act vec
        engine_slot_stub(),     // generate — byte MOUTH is ckpt-gated (570MB 24L), not one $0 call
        engine_slot_native()    // psi_coord— A/G core anchors Law-71 Ψ=1/2 fixed point
    )
}

// hexad_ckpt_pointer — ckpt pointer record (@L5). hexad A/G core ckpts live under
// HEXAD/*/state/ (CDV2-class) and in HF.jsonl; the integration itself ships no
// single fused ckpt. Honest.
pub fn hexad_ckpt_pointer() -> Map {
    return #{
        "local": "HEXAD/hexad.hexa (spec entry); A/G-core ckpts under HEXAD/*/state/*",
        "hf_repo_id": "",
        "status": "integration spec (sigma6=12 / phi6=2); no single fused ckpt — A/G core ckpts tracked in HF.jsonl",
        "duplicated": false,
    }
}

// hexad_tiny_forward — REAL forward proof for the smoke. Runs the σ6 cross-module
// forward (HEXAD/hexad_forward.hexa) on a tiny deterministic fixture → a real N=6
// module-activation vector (the OMEGA w5 source). No output is fabricated (p7):
// every node is a verified closed-form / native module core. Also validates the
// canonical impl is present. Returns a record the smoke asserts on.
pub fn hexad_tiny_forward(spec: Map) -> Map {
    let canon = "HEXAD/hexad.hexa"
    let file_ok = exec("test -f " + canon + " && echo Y || echo N").trim() == "Y"
    let sigma_ok = exec("grep -l 'hexad_sigma6_count' " + canon + " >/dev/null 2>&1 && echo Y || echo N").trim() == "Y"
    // tiny deterministic σ6 forward: 2 cells × 2 dim, t-1 → t state pair.
    let before = [0.10, 0.20, 0.30, 0.40]
    let after  = [0.90, 0.10, 0.20, 0.80]
    let r = hexad_forward(before, after, 2, 2, 0.30, 0.60, 0.0)
    let vec = hexad_forward_vec(r)
    return #{
        "engine": "hexad",
        "forward_slot": spec["forward"],
        "canonical_present": file_ok && sigma_ok,
        "canonical": spec["canonical"],
        "module_act": vec,                 // the REAL N=6 vector
        "n_modules": len(vec),
        "d_input": hexad_forward_d_input(r),
        "generate_stub_reason": "hexad byte MOUTH (D decode) is ckpt-gated (570MB 24L); generate stays honest STUB. forward (module-act vec) is NATIVE.",
    }
}
