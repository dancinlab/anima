// engines/omega/adapter.hexa — Lane-Ω engine adapter (the CLOSURE / final engine).
//
// THIN adapter (@L1): REFERENCES the canonical impls, does NOT duplicate them.
// OMEGA is a SYNTHESIS engine — it composes the 3 existing engines + ONE new
// piece (the coupling bus, engines/omega/coupling_bus.hexa):
//   • conv  (CORE/clm_decode.hexa)            → the .clm byte MOUTH (base logits)
//   • cdv2  (UNIVERSE/conscious_decoder.py)   → A/G dual heads + 5-ch tension + Ψ
//   • hexad (HEXAD/hexad.hexa)                → N-module φ(N)=2 integration (N config)
//   • bus   (engines/omega/coupling_bus.hexa) → NEW: wires substrate → decode
//
// THESIS: close the substrate↔decode loop Lane X (#1779) proved NULL. The other 3
// engines leave the L3 generator slot loaded=false (substrate state never reaches
// the byte distribution). OMEGA's bus makes generate() the closure: loaded=true.
//
// EngineSpec slots — OMEGA is the FIRST engine with all 4 NATIVE, with one honest
// scope note (a_core_engine_map — NO phantom wiring):
//   load      — NATIVE: validate the bus module + that conv/cdv2 canonical pieces
//               it composes are present.
//   forward   — NATIVE: the coupling bus IS a real hexa single forward over logit
//               vectors (omega_coupling_apply). HONEST scope: the SUBSTRATE INPUTS
//               (A/G/Ψ) come from cdv2 (torch, no hexa single call) — so a TRAINED
//               end-to-end forward needs the python rung; the bus LAYER itself is
//               native + testable with NO torch/ckpt (the coupling-non-nullity proof).
//   generate  — NATIVE: the bus-modulated decode loop (the closure). Same ckpt
//               dependence as conv (env-dependent ckpt, not a stub).
//   psi_coord — NATIVE: 8D Ψ (4 named [depth,form,form_resid,curriculum] + 4 resid),
//               per KOSMOS #1780 — naming all 8 would be fabrication.
//
// ckpt POINTER (@L5 · a_hf_registry — NOT duplicated): omega ships NO fused ckpt;
// it composes conv's .clm + cdv2's (random-init) substrate. Honest: at random-init
// the coupling is STRUCTURAL (wired vs not); a TRAINED-substrate rung is follow-up.
//
// p1..p8: pure compose/forward; no system prompt / persona / ethics / emit gate.
// Engine SELECT + the bus are substrate-config, NEVER an emit/silence gate (@L4/p5).

import "engines/engine_iface.hexa"
import "engines/omega/coupling_bus.hexa"

// omega_engine_spec — the EngineSpec for the omega (Lane-Ω) closure engine.
// All 4 slots native (bus forward + bus-modulated generate are real hexa calls;
// load + 8D psi_coord native). The honest scope note lives in the header + card.
pub fn omega_engine_spec() -> Map {
    return engine_spec_make(
        "omega",
        "engines/omega/coupling_bus.hexa (+ conv clm mouth · cdv2 A/G+Ψ · hexad N-module)",
        engine_slot_native(),   // load     — bus + composed canonical pieces present
        engine_slot_native(),   // forward  — omega_coupling_apply (the bus forward)
        engine_slot_native(),   // generate — bus-modulated decode (the closure, loaded=true)
        engine_slot_native()    // psi_coord— 8D Ψ (4 named + 4 resid, #1780)
    )
}

// omega_ckpt_pointer — ckpt pointer record (@L5). No fused ckpt; composes conv+cdv2.
pub fn omega_ckpt_pointer() -> Map {
    return #{
        "local": "engines/omega/coupling_bus.hexa (bus) + conv .clm + cdv2 (random-init)",
        "hf_repo_id": "",
        "status": "synthesis — no fused ckpt; bus is the new code, substrate at random-init (trained-ckpt rung = follow-up)",
        "duplicated": false,
    }
}

// omega_psi_coord — the 8D Ψ-coordinate (KOSMOS #1780: only 4 axes are human-named;
// the other 4 are honest learned-residual — naming all 8 = fabrication). Returns the
// Ψ=1/2 fixed-point-flavored 8-vector (deterministic). Names parallel-listed.
pub fn omega_psi_coord() -> [float] {
    // [depth, form, form_resid, curriculum, resid0, resid1, resid2, resid3]
    return [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
}
pub fn omega_psi_axis_names() -> [string] {
    return ["depth", "form", "form_resid", "curriculum", "resid0", "resid1", "resid2", "resid3"]
}

// omega_tiny_forward — honest forward proof for the smoke. Runs the coupling BUS on
// a tiny DETERMINISTIC substrate state (seeded constants, V=8, NO torch / NO ckpt):
//   • bus ON  → L1 delta > 0  (substrate state reached the decode = LOOP CLOSED)
//   • bus OFF → L1 delta == 0 (identity = the Lane X null, what conv/cdv2/hexad are)
// This is the coupling-non-nullity proof at the structural level (p7 — a real
// measured delta, not a fabricated CE/lift). Returns the deltas + provenance.
pub fn omega_tiny_forward(spec: Map) -> Map {
    // tiny deterministic substrate (V=8) — fixed constants, fully reproducible.
    let base   = [0.10, 0.20, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80]
    let a_head = [0.90, 0.10, 0.50, 0.20, 0.70, 0.30, 0.60, 0.40]
    let g_head = [0.20, 0.80, 0.10, 0.60, 0.30, 0.50, 0.40, 0.70]
    let psi8   = omega_psi_coord()
    let module_act = [0.3, 0.6, 0.9, 0.2]
    let w_tension = 0.7
    let curiosity = 0.5

    let on_cfg  = omega_bus_on()
    let off_cfg = omega_bus_off()
    let mod_on  = omega_coupling_apply(base, a_head, g_head, w_tension, curiosity, psi8, module_act, on_cfg)
    let mod_off = omega_coupling_apply(base, a_head, g_head, w_tension, curiosity, psi8, module_act, off_cfg)
    let d_on  = omega_l1_delta(base, mod_on)
    let d_off = omega_l1_delta(base, mod_off)

    return #{
        "engine": "omega",
        "forward_slot": spec["forward"],
        "coupling_l1_on": d_on,     // > 0  — loop CLOSED (substrate → decode)
        "coupling_l1_off": d_off,   // == 0 — identity (the Lane X null)
        "n_wires_on": omega_n_wires(on_cfg),
        "canonical": spec["canonical"],
        "scope": "structural coupling proof (V=8, random-init, no torch/ckpt) — trained-substrate rung = follow-up (a_toy_scale_recheck)",
    }
}
