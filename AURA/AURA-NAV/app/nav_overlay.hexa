// AURA-NAV app — V5/V6 turn-arrow AR-overlay write fidelity (hexa-native companion).
// Mirrors app/nav_overlay.py (proven on ubu-1, see verify/nav_write_fidelity.txt).
// encode 8-dir GPS turn -> V5/V6 retinotopic arrow map -> modality write (focality + noise)
// -> perceived map -> decode (nearest-template) + perceived-fidelity R2.
// honest: toy (synthetic arrows, gaussian focality). G=12 grid, NA=8 directions.

let G = 12
let NA = 8

// arrow(angle) -> flat GxG activation template (drawn ray + arrowhead)
fn arrow(angle) {
  // numpy companion is the runnable reference; hexa port draws the same ray+head.
  // TODO(hexa-port): rasterize ray from center at `angle` + 2-wing arrowhead onto GxG.
  return arrow_raster(G, angle)
}

// gaussian write-focality kernel applied separably (K @ M @ K^T)
fn blur(x, sigma) {
  let k = gaussian_kernel_1d(G, sigma)   // row-normalized GxG
  return separable_blur(x, k)
}

// one trial: write direction k through modality (sigma, snr) -> (correct?, fidelity_r2)
fn trial(k, sigma, snr_db, seed, templates_blurred) {
  let y      = add_gaussian_noise(blur(arrow_at(k), sigma), snr_db, seed)
  let pred   = nearest_template(y, templates_blurred)
  let fid    = r2(y, templates_blurred[k])
  return [eq(pred, k), max(fid, -1.0)]
}

// sweep modalities: EEG-blurry / OPM-MEG / tFUS / RTSC-MEG
fn main() {
  let templates = build_templates(NA)            // arrow per direction
  let rows = [["EEG-class", 2.6, 10], ["OPM-MEG", 1.6, 10],
              ["tFUS", 0.9, 10], ["RTSC-MEG", 0.7, 18]]
  for row in rows {
    let tb  = blur_all(templates, row[1])
    let acc = mean_accuracy(NA, row[1], row[2], 240, tb)
    let fid = mean_fidelity(NA, row[1], row[2], 240, tb)
    print(row[0], row[1], row[2], acc, fid)
  }
}
