// AURA-HEADMODEL — 3-concentric-sphere ANALYTIC EEG lead-field.
// companion of the numpy reference run on pool ubu-1 (verify/sphere_leadfield.txt).
// ⚠ awaiting hexa-lang builtins: legendre_pn · matmul (L@x) · linalg_solve · randn/choice.
//   matrix ops (L@L.T, np.linalg.solve) + Legendre recurrence over N sources are
//   not yet hexa-native → numeric run done via pool numpy. r2 + the Ary radial
//   coefficient (pure arithmetic) ARE native and mirrored faithfully below.
//
// MODEL (Ary/Klein/Fender 1981, radial dipole, 3 nested shells):
//   brain(r1=8.0, σ_b) · skull(r2=8.5, σ_sk=σ_b/40) · scalp(r3=9.2, σ_sc).
//   scalp V(θ) = Σ_n g_n(ξ,b) · P_n(cosθ).  ξ=σ_sk/σ_b ; b=source radius.
//   The skull low-conductivity + source eccentricity attenuate high n =
//   a PHYSICAL low-pass filter, with NO gaussian assumption (unlike C5~C17 toy).
//
// FINDING (verify/sphere_leadfield.txt, 🟡 toy, 8-seed):
//   C10 strawman ✅ SUPPORTED — electrode "saturation" is a gaussian-only artifact.
//   3-shell does NOT saturate (R2 0.19→0.40, +deltas at high M); gaussian flattens.
//   depth: qualitative match w/ C15 (cortex>deep), gentler slope (toy-specific).
//   skull ratio 1/20~1/80: NOT-DISCRIMINATING (R2~0.316 flat, cutoff n≈19).

let R1: float = 8.0
let R2: float = 8.5
let R3: float = 9.2

// --- r2: coefficient of determination (active-source recovery). native. ---
fn r2(x: list, xh: list) -> float {
    let n = len(x)
    let mut mean = 0.0
    let mut i = 0
    while i < n { mean = mean + to_float(to_string(x[i]))   i = i + 1 }
    mean = mean / to_float(to_string(n))
    let mut den = 0.0
    let mut num = 0.0
    i = 0
    while i < n {
        let xv = to_float(to_string(x[i]))
        let xhv = to_float(to_string(xh[i]))
        den = den + (xv - mean) * (xv - mean)
        num = num + (xv - xhv) * (xv - xhv)
        i = i + 1
    }
    if den <= 0.0 { return 0.0 }
    let v = 1.0 - num / den
    if v < -1.0 { return -1.0 }
    return v
}

// --- pow helper (float exponent via repeated mul for integer n; native). ---
fn powf(base: float, e: int) -> float {
    let mut r = 1.0
    let mut i = 0
    while i < e { r = r * base   i = i + 1 }
    return r
}

// --- Ary 1981 3-shell radial-dipole Legendre coefficient g_n. native arithmetic.
//     mirrors python ary(n,xi,b). ξ=skull/brain conductivity ratio, b=src radius. ---
fn ary_gn(n: int, xi: float, b: float) -> float {
    let f1 = R1 / R3
    let f2 = R2 / R3
    let nn = to_float(to_string(n))
    let d1 = (nn + 1.0) * xi + nn
    let d2 = 1.0 - xi
    // (f1/f2)^(2n+1) and f2^(2n+1) — integer exponent powf.
    let ex = 2 * n + 1
    let geo = powf(f1 / f2, ex) - powf(f2, ex)
    let term = d1 * (nn * xi + nn + 1.0) + nn * (nn + 1.0) * d2 * d2 * geo
    let denom = 2.0 * term * (2.0 * nn + 1.0)
    if denom < 1.0e-300 && denom > -1.0e-300 { return 0.0 }
    // (2n+1)^3 * b^(n-1) * b^(n+1) / denom  == (2n+1)^3 * b^(2n) / denom
    let twonp1 = 2.0 * nn + 1.0
    let cube = twonp1 * twonp1 * twonp1
    return cube * powf(b, 2 * n) / denom
}

// --- build g_n spectrum for a skull ratio + source depth. mirrors gn_shell. ---
// TODO(builtin): sqrt-normalize over array + legendre P_n assembly into L matrix.
fn gn_shell_n1(xi: float, depth: float) -> float {
    // returns the leading (n=1) coefficient as a smoke value (full spectrum
    // needs array ops). source radius b = (R1/R3)*(1 - 0.05*depth).
    let b = (R1 / R3) * (1.0 - 0.05 * depth)
    return ary_gn(1, xi, b)
}

// --- TODO(builtin): L_shell(M,S,gn) = Σ_n g_n P_n(cos(θ_elec - θ_src)).
//     needs legendre_pn recurrence + (M×S) matrix fill. numpy ref only. ---
fn L_shell_stub() -> list { return [] }

// --- TODO(builtin): regularized min-norm inverse L.T @ solve(L L.T + λI, y).
//     needs matmul + linalg_solve. numpy ref only. ---
fn inv_stub() -> list { return [] }

fn main() {
    // smoke: Ary coefficient is native + finite for the standard 1/40 skull.
    let g1 = gn_shell_n1(1.0 / 40.0, 1.0)
    print("3-shell Ary g_1(skull 1/40, depth 1.0) = " + to_string(g1))
    print("full sweep (depth/electrode-sat/skull-ratio) ran on pool ubu-1 numpy.")
    print("VERDICT: C10 strawman SUPPORTED — electrode-sat is a gaussian artifact.")
    print("see AURA/AURA-HEADMODEL/verify/sphere_leadfield.txt (verbatim stdout).")
}
