// AURA/toy/a7_reach_to_phi.hexa — brainwire deep-reach% → TPM coupling → big-Φ.
//
//   THESIS (AURA A7, bridges A6): A6 showed a BINARY contrast (M1-local vs
//   bypass-hub) maps to a big-Φ jump. A7 makes the link CONTINUOUS: it takes
//   the brainwire per-variable DEEP-ACCESS REACH% (archive/brainwire/
//   n1-deep-access-strategies.md — M1 ~10%; bypass DA~29% 5HT~30% NE~37%
//   eCB~20% Theta~16%) and PARAMETERIZES the synthetic TPM connectivity with it.
//
//   BRIDGE FUNCTION (the load-bearing modeling choice):
//     f(reach) : reach% scalar r ∈ [0,1]  →  coupling weight w ∈ [0,1]
//     w = r                          (identity link — reach% IS the cross-
//                                     coupling probability mass)
//   Per-node next-state probability is a reach-weighted BLEND of two extremes:
//     P(node i ON next | state s)
//        = (1 - w) * p_self(i, s)    // M1 limit: node copies ITSELF (local)
//        +     w   * p_hub (i, s)    // bypass limit: node = majority of OTHERS
//   where p_self = 0.9 if bit_i ON else 0.1   (self-copy, reducible)
//         p_hub  = 0.9 if strict-majority of the OTHER nodes ON else 0.1 (fan-in).
//
//   So w=0 reproduces A6's pure M1-like TPM (Φ≈0, fully reducible) and w=1
//   reproduces A6's pure bypass-like TPM (large Φ, irreducible). Intermediate
//   reach% interpolates the connectivity, and big-Φ should rise MONOTONICALLY
//   with reach% — that is the A7 finding.
//
//   Pre-registered falsifier (a_paper_significance):
//     H: big_phi is NON-DECREASING in reach% across the swept grid.
//        FALSIFIED if any adjacent step has Φ(r_{k+1}) < Φ(r_k) - eps.
//
//   HONEST: f(reach)=identity blend is an ASSUMED monotone link, NOT derived
//   from physiology. The reach%→coupling map is a modeling choice; real coupling
//   needs connectome / lesion data. Synthetic TPM, NOT a real N1/EEG recording.
//   toy substrate ≠ production scale (feedback_toy_scale_transfer). n=4 exact.
//   deterministic · hexa-only · $0 · no LLM.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }

// BRIDGE: reach% scalar r → coupling weight w. Identity link (modeling choice).
fn reach_to_coupling(r: float) -> float { return r }

// reach-PARAMETERIZED TPM: per-node next-prob = (1-w)*self + w*hub.
//   w=0 → A6 M1-like (self-copy, reducible) ; w=1 → A6 bypass-like (hub majority).
fn tpm_reach(n: int, r: float) -> array {
    let w = reach_to_coupling(r)
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            // self-copy limit (M1)
            let mut p_self = 0.1
            if bit_of(s, i) == 1 { p_self = 0.9 }
            // hub majority-of-others limit (bypass)
            let mut on = 0
            let mut j = 0
            while j < n {
                if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
                j = j + 1
            }
            let mut p_hub = 0.1
            if on * 2 > (n - 1) { p_hub = 0.9 }
            // reach-weighted blend
            let p = (1.0 - w) * p_self + w * p_hub
            tpm = tpm.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn main() {
    println("================================================================")
    println("  AURA A7 — brainwire deep-reach% → TPM coupling → IIT4 big-Φ")
    println("================================================================")
    let n = 4
    let sys = pow2(n) - 1          // all-ON system state (1111)

    // swept reach% grid: M1≈0.10 → bypass band 0.20/0.30/0.40 → 0.55 ceiling.
    let grid = [0.10, 0.20, 0.30, 0.40, 0.55]
    let mut phis = []

    println("  bridge: f(reach)=identity → coupling w; P_next=(1-w)*self+w*hub")
    println("  ----------------------------------------------------------------")
    println("  reach%   coupling w   big-Φ (n=4 exact)")
    let mut k = 0
    while k < grid.len() {
        let r = grid[k]
        let phi = big_phi(tpm_reach(n, r), n, sys)
        phis = phis.push(phi[0])
        println("  " + str(r) + "      " + str(r) + "          " + str(phi[0]))
        k = k + 1
    }

    println("  ----------------------------------------------------------------")
    println("  Δ(reach 0.55 - reach 0.10) = " + str(phis[4] - phis[0]))

    // finiteness
    let mut m = 0
    while m < phis.len() {
        check("Φ finite >= 0 at grid[" + str(m) + "]", phis[m] >= 0.0 - 0.000001)
        m = m + 1
    }

    // PRE-REGISTERED FALSIFIER: monotone non-decreasing in reach%
    let mut mono = true
    let mut g = 1
    while g < phis.len() {
        if phis[g] < phis[g - 1] - 0.000001 { mono = false }
        g = g + 1
    }
    check("FALSIFIER H: big-Φ non-decreasing as reach% rises", mono)

    // STRICT rise across the full sweep endpoints (reach lifts integration at all)
    check("net rise: Φ(0.55) > Φ(0.10)", phis[4] > phis[0] + 0.000001)

    // determinism
    let phi_re = big_phi(tpm_reach(n, 0.30), n, sys)
    let phi_30 = phis[2]
    check("determinism: reach=0.30 re-run identical",
          (phi_re[0] - phi_30) < 0.000001 && (phi_30 - phi_re[0]) < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("A7 reach→Φ toy FAILED") }
}
