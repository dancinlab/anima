// AURA/toy/a9_connectome_real.hexa — REAL connectome-prior coupling → big-Φ.
//
//   THESIS (AURA A9, supersedes A8.4's literature ORDINAL): A8.4 set the
//   per-position coupling prior from the brainwire doc's ESTIMATED coefficients
//   (DLPFC→VTA 0.75, entorhinal→hippo 0.60, insula→NTS 0.43, M1 0.10) — a
//   literature ORDINAL, explicitly admitted to be NOT subject tractography.
//   A9 replaces those estimated numbers with REAL measured projection weights
//   pulled live from the Allen Mouse Connectivity Atlas (api.brain-map.org,
//   anterograde rAAV tracer, ProjectionStructureUnionize.normalized_projection_volume).
//
//   REAL Allen weights (normalized_projection_volume, top/representative exp):
//     entorhinal (ENTl id167212932)   → HIP   ........ 0.265   (perforant path)
//     frontal/orbital (id156741826)   → VTA   ........ 0.108   (DLPFC analog, mesocortical)
//     M1 (MOp id114292355)            → VTA   ........ 0.0130
//     insula (AId id267397941)        → NTS   ........ 0.00151 (autonomic gateway)
//
//   REAL ordering:  entorhinal > DLPFC > M1 > insula
//   A8.4 ORDINAL :  DLPFC > entorhinal > insula > M1
//
//   So the real data (1) FLIPS the top pair (ento now strongest, not DLPFC) and
//   (2) drops insula below M1 (mouse insula→NTS is far weaker than the brainwire
//   taVNS-derived 0.43 estimate). This is a genuine CHANGE, not a confirmation.
//
//   Pre-registered falsifiers (a_paper_significance):
//     Ha-REAL (the load-bearing claim under REAL data): the two strongest REAL
//        seeds {entorhinal, DLPFC} BOTH yield strictly higher big-Φ than the two
//        weakest {M1, insula}. FALSIFIED if any strong seed ≤ any weak seed.
//     Hb-CONFIRM (does A8.4's ORDINAL survive REAL data?): pre-registered
//        DLPFC ≥ entorhinal (A8.4 top-pair claim). EXPECTED to FAIL under real
//        weights (ento measured stronger) — a real closed-negative that REVISES
//        A8.4, reported NOT gated (a_paper_negative_ok).
//
//   Mapping: w_i is taken DIRECTLY as the Allen normalized_projection_volume —
//   no rescale, no tuning — so the coupling scale is the measured tract weight.
//   (A max-normalized variant is ALSO reported to show the regime is robust to
//   the absolute-scale choice; the ORDERING is the claim, not the absolute Φ.)
//   Synthetic TPM · toy ≠ production (feedback_toy_scale_transfer). n=4 exact.
//   deterministic · hexa-only · $0 · no LLM. Real data = mouse, not human DWI.
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/.hx/packages/hexa-lang/stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }

// REAL Allen Mouse Connectivity weights (normalized_projection_volume),
// fetched live api.brain-map.org 2026-05-30. NO rescale, NO tuning.
fn real_ento()   -> float { return 0.265 }    // ENTl id167212932 → HIP
fn real_dlpfc()  -> float { return 0.108 }    // frontal/orbital id156741826 → VTA
fn real_m1()     -> float { return 0.0130 }   // MOp id114292355 → VTA
fn real_insula() -> float { return 0.00151 }  // AId id267397941 → NTS

fn tpm_prior(n: int, w: array) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            let mut p_self = 0.1
            if bit_of(s, i) == 1 { p_self = 0.9 }
            let mut on = 0
            let mut j = 0
            while j < n {
                if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
                j = j + 1
            }
            let mut p_hub = 0.1
            if on * 2 > (n - 1) { p_hub = 0.9 }
            let wi = w[i]
            let p = (1.0 - wi) * p_self + wi * p_hub
            tpm = tpm.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn tpm_homog(n: int, wv: float) -> array {
    let mut w = []
    let mut i = 0
    while i < n { w = w.push(wv); i = i + 1 }
    return tpm_prior(n, w)
}

fn main() {
    println("================================================================")
    println("  AURA A9 — REAL Allen connectome-prior coupling → IIT4 big-Φ")
    println("================================================================")
    let n = 4
    let sys = pow2(n) - 1          // all-ON system state (1111)

    let w_ento   = real_ento()
    let w_dlpfc  = real_dlpfc()
    let w_m1     = real_m1()
    let w_insula = real_insula()

    // POSITION ORDERING probe: homogeneous TPM at each seed's REAL measured weight.
    let phi_ento   = big_phi(tpm_homog(n, w_ento), n, sys)
    let phi_dlpfc  = big_phi(tpm_homog(n, w_dlpfc), n, sys)
    let phi_m1     = big_phi(tpm_homog(n, w_m1), n, sys)
    let phi_insula = big_phi(tpm_homog(n, w_insula), n, sys)

    let p_ento   = phi_ento[0]
    let p_dlpfc  = phi_dlpfc[0]
    let p_m1     = phi_m1[0]
    let p_insula = phi_insula[0]

    println("  REAL connectome prior (Allen Mouse Connectivity, norm_proj_vol):")
    println("  ----------------------------------------------------------------")
    println("  position    hub pathway              w(real)   big-Φ (n=4 exact)")
    println("  entorhinal  →HIP perforant           " + str(w_ento) + "    " + str(p_ento))
    println("  DLPFC       →VTA mesocortical         " + str(w_dlpfc) + "    " + str(p_dlpfc))
    println("  M1          →VTA (weak)               " + str(w_m1) + "    " + str(p_m1))
    println("  insula      →NTS autonomic            " + str(w_insula) + "  " + str(p_insula))
    println("  ----------------------------------------------------------------")
    println("  Δ(entorhinal - insula) = " + str(p_ento - p_insula))

    // finiteness
    check("Φ finite >= 0 entorhinal", p_ento >= 0.0 - 0.000001)
    check("Φ finite >= 0 DLPFC", p_dlpfc >= 0.0 - 0.000001)
    check("Φ finite >= 0 M1", p_m1 >= 0.0 - 0.000001)
    check("Φ finite >= 0 insula", p_insula >= 0.0 - 0.000001)

    // FALSIFIER Ha-REAL (load-bearing): strong{ento,DLPFC} BOTH strictly exceed
    // weak{M1,insula}.
    let strong_gt_m1     = (p_ento > p_m1 + 0.000001) && (p_dlpfc > p_m1 + 0.000001)
    let strong_gt_insula = (p_ento > p_insula + 0.000001) && (p_dlpfc > p_insula + 0.000001)
    check("FALSIFIER Ha-REAL: strong{ento,DLPFC} > weak{M1,insula}",
          strong_gt_m1 && strong_gt_insula)

    // FALSIFIER Hb-CONFIRM (does A8.4 ORDINAL survive?): A8.4 claimed DLPFC>=ento
    // AND insula>M1. Under REAL data both are EXPECTED to flip. Reported, NOT gated.
    let a84_toppair  = (p_dlpfc >= p_ento - 0.000001)   // A8.4: DLPFC top
    let a84_insgtm1  = (p_insula > p_m1 + 0.000001)     // A8.4: insula > M1
    if a84_toppair { println("  [Hb-CONFIRM] A8.4 top-pair DLPFC>=ento HOLDS under real data") }
    else { println("  [Hb-CONFIRM] A8.4 top-pair DLPFC>=ento FLIPPED — REAL: entorhinal strongest (REVISES A8.4)") }
    if a84_insgtm1 { println("  [Hb-CONFIRM] A8.4 insula>M1 HOLDS under real data") }
    else { println("  [Hb-CONFIRM] A8.4 insula>M1 FLIPPED — REAL: M1>insula (mouse insula→NTS weaker than taVNS estimate, REVISES A8.4)") }

    // mixed-position substrate: all 4 REAL weights in ONE system.
    let w_mixed = [w_dlpfc, w_ento, w_insula, w_m1]
    let phi_mixed = big_phi(tpm_prior(n, w_mixed), n, sys)
    println("  mixed-position substrate (DLPFC|ento|insula|M1, real w) big-Φ = " + str(phi_mixed[0]))
    check("Φ finite >= 0 mixed-position substrate", phi_mixed[0] >= 0.0 - 0.000001)

    // ROBUSTNESS: max-normalize the real weights to top=0.75 (A8.4's top scale),
    // preserving real RATIOS — show the ORDERING claim is scale-invariant.
    let scale = 0.75 / w_ento
    let phi_ento_n   = big_phi(tpm_homog(n, w_ento * scale), n, sys)
    let phi_dlpfc_n  = big_phi(tpm_homog(n, w_dlpfc * scale), n, sys)
    let phi_m1_n     = big_phi(tpm_homog(n, w_m1 * scale), n, sys)
    let phi_insula_n = big_phi(tpm_homog(n, w_insula * scale), n, sys)
    let strong_gt_m1_n     = (phi_ento_n[0] > phi_m1_n[0] + 0.000001) && (phi_dlpfc_n[0] > phi_m1_n[0] + 0.000001)
    let strong_gt_insula_n = (phi_ento_n[0] > phi_insula_n[0] + 0.000001) && (phi_dlpfc_n[0] > phi_insula_n[0] + 0.000001)
    println("  [SCALE-ROBUST] max-norm to 0.75: ento=" + str(phi_ento_n[0]) + " dlpfc=" + str(phi_dlpfc_n[0]) + " m1=" + str(phi_m1_n[0]) + " insula=" + str(phi_insula_n[0]))
    check("SCALE-ROBUST: ordering survives max-normalization",
          strong_gt_m1_n && strong_gt_insula_n)

    // determinism
    let phi_re = big_phi(tpm_homog(n, w_ento), n, sys)
    check("determinism: entorhinal re-run identical",
          (phi_re[0] - p_ento) < 0.000001 && (p_ento - phi_re[0]) < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("A9 real-connectome-coupling toy FAILED") }
}
