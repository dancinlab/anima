// AURA/toy/a6_relocate_bigphi.hexa — relocate-N1 → big-Φ in-silico toy probe.
//
//   THESIS (AURA SURVEY §2/§6): N1 stays cortical (3-6mm), but moving it from
//   M1 (a dead-end OUTPUT site, local/low cross-coupling) to a PROJECTION HUB
//   (DLPFC+insula, the cortical endpoint of deep neuromodulatory loops,
//   high cross-region coupling) should raise whole-brain INTEGRATION.
//
//   We translate "connectivity difference" into IIT 4.0 big-Φ by building two
//   synthetic state-by-node TPMs (n=4 nodes, engine-exact ≤8) over the SAME
//   stdlib engine anima/BRAIN use (g61 engine ⊥ adapter):
//
//     M1-LIKE     : each node copies ITSELF next step (local autonomy,
//                   reducible — cutting any link costs ~nothing) + weak noise.
//     BYPASS-LIKE : each node's next state = XOR/majority of its NEIGHBORS
//                   (projection-hub coupling, irreducible — every node needs
//                   the others), modeling DLPFC/insula fan-in/fan-out.
//
//   Pre-registered falsifier (a_paper_significance):
//     H: big_phi(bypass) > big_phi(M1).   FALSIFIED if Φ(bypass) <= Φ(M1).
//
//   HONEST: synthetic TPM, NOT a real N1 / EEG recording. toy substrate ≠
//   production scale (feedback_toy_scale_transfer). This probes only whether
//   the hub-vs-local connectivity CONTRAST maps to a big-Φ contrast in-engine.
//
//   deterministic · hexa-only · $0 · no LLM.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn pow2(k: int) -> int { return iit4_pow2(k) }
fn bit_of(s: int, k: int) -> int { if (s / pow2(k)) % 2 == 1 { return 1 } else { return 0 } }

// M1-LIKE TPM: node i next ≈ its OWN current bit (self-copy). Low coupling →
// the system factorizes into independent units → small big-Φ.
fn tpm_m1(n: int) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            // P(node i ON next | state s) = 0.9 if i currently ON else 0.1
            if bit_of(s, i) == 1 { tpm = tpm.push(0.9) } else { tpm = tpm.push(0.1) }
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// BYPASS-LIKE TPM: node i next = majority/parity of the OTHER nodes (hub fan-in).
// Every node depends on the rest → cutting any partition is costly → larger Φ.
fn tpm_bypass(n: int) -> array {
    let nstates = pow2(n)
    let mut tpm = []
    let mut s = 0
    while s < nstates {
        let mut i = 0
        while i < n {
            // count ON neighbors (all nodes except i)
            let mut on = 0
            let mut j = 0
            while j < n {
                if j != i { if bit_of(s, j) == 1 { on = on + 1 } }
                j = j + 1
            }
            // node ON next iff a (strict) majority of the others are ON
            if on * 2 > (n - 1) { tpm = tpm.push(0.9) } else { tpm = tpm.push(0.1) }
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn main() {
    println("================================================================")
    println("  AURA A6 — relocate-N1 connectivity → IIT4 big-Φ (in-silico toy)")
    println("================================================================")
    let n = 4
    let sys = pow2(n) - 1          // all-ON system state (1111)

    let m1 = tpm_m1(n)
    let by = tpm_bypass(n)

    let phi_m1 = big_phi(m1, n, sys)
    let phi_by = big_phi(by, n, sys)

    println("  M1-like     (local/self-copy)  big-Φ = " + str(phi_m1[0]))
    println("  bypass-like (hub/majority)     big-Φ = " + str(phi_by[0]))
    println("  Δ(bypass - M1) = " + str(phi_by[0] - phi_m1[0]))

    check("M1 big-Φ finite >= 0", phi_m1[0] >= 0.0 - 0.000001)
    check("bypass big-Φ finite >= 0", phi_by[0] >= 0.0 - 0.000001)
    // PRE-REGISTERED FALSIFIER:
    check("FALSIFIER H: big-Φ(bypass) > big-Φ(M1)", phi_by[0] > phi_m1[0] + 0.000001)

    // determinism
    let phi_by2 = big_phi(tpm_bypass(n), n, sys)
    check("determinism: bypass re-run identical",
          (phi_by[0] - phi_by2[0]) < 0.000001 && (phi_by2[0] - phi_by[0]) < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("A6 relocate big-Φ toy FAILED") }
}
