// --- 정맥동 도달 zone 매핑 (표면 피질=1, 심부=0). native — 행렬 비의존. ---
fn zone_names() -> list {
    return ["M1(SSS)", "측두A1(가로동)", "후두V1(S자동)", "DLPFC(전두)", "섬엽(심부)", "심부핵"]
}
fn zone_reach() -> list {
    return [1, 1, 1, 0, 0, 0]   // 1=도달 · 0=미도달
}

fn main() {
    // mirror of __main__: coverage count + 도달/미도달 zone 목록.
    let names = zone_names()
    let reach = zone_reach()
    let mut cov = 0
    let mut i = 0
    while i < len(reach) { cov = cov + to_int(to_string(reach[i]))   i = i + 1 }
    print("정맥동 도달 " + to_string(cov) + "/" + to_string(len(reach)) + " zone")
    let mut yes = ""
    let mut no = ""
    i = 0
    while i < len(names) {
        let nm = to_string(names[i])
        if to_int(to_string(reach[i])) > 0 {
            if len(yes) > 0 { yes = yes + ", " }
            yes = yes + nm
        } else {
            if len(no) > 0 { no = no + ", " }
            no = no + nm
        }
        i = i + 1
    }
    print("도달: " + yes)
    print("미도달: " + no)
}
