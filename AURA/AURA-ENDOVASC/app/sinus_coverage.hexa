// AURA-ENDOVASC — Synchron 정맥동 혈관내 도달 zone 매핑 — 표면 피질 yes, 심부 no (B3/B5).
// companion of sinus_coverage.py (numpy reference, verified in verify/sinus_coverage.txt)
// ⚠ awaiting hexa-lang builtins (handoff f125d45c): gaussian_kernel_1d·separable_blur·nearest_template·r2
//
// 핵심: 정맥동 경로로 도달 가능한 zone(표면 피질) vs 미도달(심부) 를 0/1 로 표기,
// 도달 커버리지를 카운트. LF/r2 fidelity 인프라는 토대로만 두고 zone 매핑이 본체.
// LF/inv 의 행렬연산(@ · np.linalg.solve)은 미존재 builtin 의존 → TODO 스텁.
// r2 는 순수 산술이라 native 구현.

let G: int = 10
let N: int = 100   // G*G

// --- r2: 결정계수. 순수 산술 — native 구현 (handoff r2 의 hexa 등가). ---
fn r2(x: list, xh: list) -> float {
    let n = len(x)
    let mut mean = 0.0
    let mut i = 0
    while i < n { mean = mean + to_float(to_string(x[i]))   i = i + 1 }
    mean = mean / to_float(to_string(n))
    let mut den = 0.0
    let mut num = 0.0
    i = 0
    while i < n {
        let xv = to_float(to_string(x[i]))
        let xhv = to_float(to_string(xh[i]))
        den = den + (xv - mean) * (xv - mean)
        num = num + (xv - xhv) * (xv - xhv)
        i = i + 1
    }
    if den <= 0.0 { return 0.0 }
    let v = 1.0 - num / den
    if v < -1.0 { return -1.0 }
    return v
}

