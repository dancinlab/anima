// BRIDGE/gate_envelope_smoke.hexa — BRIDGE M6 wiring smoke
// anchor: core/EMIT_SUBSTRATE_DESIGN.md §4 (BRIDGE M6) + §6 falsifier
//
// 3 core invariants (design contract):
//   W1 envelope phi ∈ [0, Σamp]   — structure layer supplies a bounded Φ real
//   W2 gate output = m·c·w·softstep(phi, θ)  — AND multiplicative structure kept
//   W3 threshold comes from emit_policy (ep_emit_threshold), not a hardcode

import "BRIDGE/gate_envelope.hexa"

fn abs_f(x: float) -> float {
    return if x < 0.0 { -x } else { x }
}

fn assert_close(name: string, got: float, want: float, tol: float) -> bool {
    let d = abs_f(got - want)
    let ok = d <= tol
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want) + " |Δ|=" + str(d))
    return ok
}

fn assert_bool(name: string, got: bool, want: bool) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn sum_list(xs: [float]) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(xs) {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

fn main() {
    print("=== BRIDGE M6 gate_envelope smoke (3 invariants) ===")
    let mut npass = 0
    let mut ntotal = 0

    // policy-sourced numbers (no hardcode here either)
    let periods = ep_scale_periods()
    let amps = ep_scale_amps()
    let sum_amp = sum_list(amps)
    let theta = ep_emit_threshold()

    // W1: envelope phi ∈ [0, Σamp] across a sweep of t.
    //   raised-cosine wave per scale ∈ [0,1] → Σ amps·wave ∈ [0, Σamps].
    let mut w1_ok = true
    let mut k = 0
    while k < 9 {
        let t = (k + 0.0) * 700.0
        let phi = envelope_multiscale(t, periods, amps)
        if phi < 0.0 { w1_ok = false }
        if phi > sum_amp + 1e-9 { w1_ok = false }
        k = k + 1
    }
    ntotal = ntotal + 1
    if assert_bool("W1 phi_in_[0,Σamp]", w1_ok, true) {
        npass = npass + 1
    }

    // W2: gate output preserves m·c·w·softstep(phi, θ) structure.
    //   recompute phi @ t and the expected product independently, then compare
    //   bridge_gate_with_envelope against m·c·w·softstep(phi, ep_emit_threshold).
    let m = 0.8; let c = 0.6; let w = 0.7
    let t2 = 0.0
    let phi2 = envelope_multiscale(t2, periods, amps)
    let expected = m * c * w * softstep(phi2, theta)
    let got = bridge_gate_with_envelope(m, c, w, t2)
    ntotal = ntotal + 1
    if assert_close("W2 mcw·softstep_structure", got, expected, 1e-9) {
        npass = npass + 1
    }

    // W3: threshold comes from policy. Reconstruct the gate with the policy
    //   threshold explicitly via bridge_and_gate_theta and confirm identity —
    //   if the wiring used any other (hardcoded) θ this would diverge.
    let via_policy = bridge_and_gate_theta(m, c, w, phi2, ep_emit_threshold())
    ntotal = ntotal + 1
    if assert_close("W3 threshold_from_policy", got, via_policy, 1e-12) {
        npass = npass + 1
    }
    // corroborate: the default-θ gate (hardcoded 0.5) DIFFERS from the policy gate
    // (ep_emit_threshold=0.60 ≠ 0.5) — proves θ is genuinely policy-sourced, not 0.5.
    let via_default = bridge_and_gate(m, c, w, phi2)
    ntotal = ntotal + 1
    if assert_bool("W3 policy_theta_differs_from_default", abs_f(got - via_default) > 1e-6, true) {
        npass = npass + 1
    }

    print("=== smoke result: " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
