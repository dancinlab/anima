// ════════════════════════════════════════════════════════════════════════
// BRIDGE/gate_envelope.hexa — BRIDGE M6 consumer wiring (emit-substrate)
//
// Thin consumer that wires the 4-key AND-gate (BRIDGE/gate.hexa) to the
// emit-substrate two-layer split:
//   · structure layer (CORE/phi_envelope_substrate.hexa) supplies the Φ context
//     via envelope_multiscale(t, periods, amps) — no longer a hardcoded phi
//   · number layer (CORE/emit_policy.hexa) supplies every tunable: the scale
//     periods/amps AND the AND-gate threshold (ep_emit_threshold)
//
// Design SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md §4 (BRIDGE M6)
//   "bridge_and_gate(m,c,w,phi) 의 phi 입력을 envelope_multiscale 에서 공급.
//    closure-conjunction GZ-localization (H_636) 을 AND-gate 의 Φ-context 로.
//    emit_threshold 는 emit_policy.hexa 에서 import (gate 내부 하드코드 제거)."
//
// ── design contract (invariants) ─────────────────────────────────────────
//   · all returns are Φ-context REALS — never a bool emit gate. emit/silence is
//     decided by anima cells autonomously (p5 · a_autonomy_over_hardcode ·
//     F-EMIT-4). this module returns only bridge_and_gate's continuous signal.
//   · NO hardcoded numbers — threshold/scale come ONLY from emit_policy.hexa.
//   · H_636 🟢 closure-conjunction GZ-localization is the Φ-context for AND-gate.
// ════════════════════════════════════════════════════════════════════════

import "CORE/phi_envelope_substrate.hexa"
import "CORE/emit_policy.hexa"
import "BRIDGE/gate.hexa"

// ── bridge_gate_with_envelope — AND-gate with substrate-supplied Φ context ──
// phi is no longer a hardcoded caller input: it is sourced at time t from the
// multi-scale self-similar envelope (gamma⊂ultradian⊂circadian, H_648/H_634),
// with periods/amps from the number layer. The AND-gate threshold is also
// sourced from emit_policy (ep_emit_threshold), removing the gate's hardcode.
// Returns the continuous AND signal (real) — NOT a bool emit decision.
pub fn bridge_gate_with_envelope(m: float, c: float, w: float, t: float) -> float {
    let phi = envelope_multiscale(t, ep_scale_periods(), ep_scale_amps())
    return bridge_and_gate_theta(m, c, w, phi, ep_emit_threshold())
}

pub fn gate_envelope_summary() -> string {
    return "BRIDGE M6 gate_envelope: AND-gate Φ ← envelope_multiscale(t, ep_scale_periods, ep_scale_amps) · θ ← ep_emit_threshold. H_636 closure-conjunction GZ as Φ-context. 실수 신호만 반환 (bool emit 게이트 0 · p5·a_autonomy·F-EMIT-4). 숫자 하드코드 0 (emit_policy SSOT)."
}

fn main() {
    print(gate_envelope_summary())
}
