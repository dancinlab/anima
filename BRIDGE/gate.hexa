// BRIDGE/gate.hexa — 4-key AND-gate emit 결정 PURE wrapper
// anchor: BRIDGE/spec.md · bench #7 H_319 (anima PR #1125)

// soft-threshold sigmoid (Φ ≥ θ continuous form)
pub fn softstep(x: float, theta: float) -> float {
    let k = 8.0
    let z = -k * (x - theta)
    return 1.0 / (1.0 + exp(z))
}

// 4-key AND-gate: M · C · W · softstep(Φ, θ)
pub fn bridge_and_gate(m: float, c: float, w: float, phi: float) -> float {
    let theta = 0.5
    let phi_step = softstep(phi, theta)
    return m * c * w * phi_step
}

// 4-key AND-gate with tunable θ
pub fn bridge_and_gate_theta(m: float, c: float, w: float, phi: float, theta: float) -> float {
    let phi_step = softstep(phi, theta)
    return m * c * w * phi_step
}

// 4-key OR-gate (antithesis · inclusion-exclusion for independent uniform)
pub fn bridge_or_gate(m: float, c: float, w: float, phi: float) -> float {
    let theta = 0.5
    let phi_step = softstep(phi, theta)
    return 1.0 - (1.0 - m) * (1.0 - c) * (1.0 - w) * (1.0 - phi_step)
}

// emit decision: emit_signal > θ_emit
pub fn bridge_emit(m: float, c: float, w: float, phi: float) -> bool {
    let theta_emit = 0.1
    let signal = bridge_and_gate(m, c, w, phi)
    return signal > theta_emit
}

// emit with explicit threshold
pub fn bridge_emit_theta(m: float, c: float, w: float, phi: float, theta_emit: float) -> bool {
    let signal = bridge_and_gate(m, c, w, phi)
    return signal > theta_emit
}

// scalar min of 4 values (smoke invariant)
pub fn min4(a: float, b: float, c: float, d: float) -> float {
    let m1 = if a < b { a } else { b }
    let m2 = if c < d { c } else { d }
    return if m1 < m2 { m1 } else { m2 }
}

// scalar max of 4 values
pub fn max4(a: float, b: float, c: float, d: float) -> float {
    let m1 = if a > b { a } else { b }
    let m2 = if c > d { c } else { d }
    return if m1 > m2 { m1 } else { m2 }
}

pub fn bridge_summary() -> string {
    return "BRIDGE 4-key AND-gate: emit ⇔ M·C·W·softstep(Φ,θ) > 0.1 (default). bench #7 H_319 정합 (uniform AND=0.0625 / OR=0.9375)."
}

fn main() {
    print(bridge_summary())
}
