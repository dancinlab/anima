// ----------------------------------------------------------------------------
// Empirical scaling data (cells, Phi, MI) — measured 2026 on worktree-6.
// Power-law fit in log-log space yields:
//   Phi  =  a * N^b   with b ~ 1.09 (super-linear in N)
//   MI   =  c * N^d   with d ~ 2.0  (quadratic — pairwise channels)
// Super-linear b means doubling cells more-than-doubles integrated information.
// ----------------------------------------------------------------------------

struct ScalingPoint {
    cells: int,
    phi: float,
    mi: float
}

// Frozen empirical evidence (DO NOT EDIT — this is the historical witness).
// Source: worktree-6 phi_scaling_calculator.py:9-16.
const EMPIRICAL: [ScalingPoint; 6] = [
    ScalingPoint { cells: 2,   phi: 1.5,    mi: 1.0     },
    ScalingPoint { cells: 8,   phi: 4.5,    mi: 28.0    },
    ScalingPoint { cells: 16,  phi: 10.6,   mi: 149.9   },
    ScalingPoint { cells: 32,  phi: 27.6,   mi: 842.7   },
    ScalingPoint { cells: 64,  phi: 54.3,   mi: 3376.7  },   // *** super-linear cell ***
    ScalingPoint { cells: 128, phi: 112.3,  mi: 14135.8 }
];

struct BrainScale {
    name: string,
    units: int
}

// Reference systems for extrapolation (functional modules, not raw neurons).
const BRAIN_SCALES: [BrainScale; 8] = [
    BrainScale { name: "C. elegans (302 neurons)", units: 302 },
    BrainScale { name: "Ant (~250K neurons)",      units: 250000 },
    BrainScale { name: "Bee (~1M neurons)",        units: 1000000 },
    BrainScale { name: "Mouse (71M neurons)",      units: 71000000 },
    BrainScale { name: "Human (86B neurons)",      units: 86000000000 },
    BrainScale { name: "Anima 128 cells",          units: 128 },
    BrainScale { name: "Anima 512 cells",          units: 512 },
    BrainScale { name: "Anima 1024 cells",         units: 1024 }
];

struct ScalingLaw {
    a: float,   // Phi prefactor
    b: float,   // Phi exponent (~1.09 from EMPIRICAL fit)
    c: float,   // MI  prefactor
    d: float    // MI  exponent (~2.0 from EMPIRICAL fit)
}

