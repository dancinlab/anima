    //   accumulate amp * harm_amp * sin(phase + 2*pi*harm_freq*t/SR)
    //   phase[i] += 2*pi*freq*n_samples/SR (mod 2*pi)
    // After loop: vibrato AM at 5 Hz * tempo, breath envelope at 1/(20/tempo) Hz,
    // soft clip = tanh(samples * 3) * 0.8.
    []
}

