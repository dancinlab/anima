    //   freq   *= 2^(emotion.pitch_shift * 0.5)
    //   freq   *= 1 + psi_gate * 0.001 * (norm[i] - 1)                      (Law 63)
    //   amp     = min(0.3, norm[i] * 0.05) / n_cells
