// ---------------------------------------------------------------------------
// Diagnostics — Psi status snapshot (Law 71 witness).
// ---------------------------------------------------------------------------
struct PsiStatus {
    residual: float,
    gate: float,
    entropy: float,    // H = -p log2 p - (1-p) log2 (1-p)
    step: int
}

fn psi_status(state: VoiceState) -> PsiStatus {
    // TODO[pytorch]: H from psi_residual; pack and return.
    PsiStatus { residual: state.psi_residual, gate: state.psi_gate, entropy: 0.0, step: state.step }
}
