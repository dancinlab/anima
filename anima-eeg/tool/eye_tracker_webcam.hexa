// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg/tool/eye_tracker_webcam.hexa  (C19)
//
//  PURPOSE
//    Mac built-in webcam → gaze + ocular metrics → cross-modal EEG.
//    5 metrics @ 30 Hz, aggregated to 1-min JSONL rows:
//      gaze_(x,y)_screen_pct_x1000, blink_rate_per_min,
//      fixation_duration_avg_ms, saccade_rate_per_min,
//      pupil_dilation_proxy_x1000.
//    Output: state/eye_tracker_audit/<UTC-date>_gaze.jsonl
//    EEG correlation hypotheses (raw#12 frozen):
//      H1 blink ↔ drowsy r≥+0.30  H2 fixation ↔ engagement r≥+0.30
//      H3 saccade ↔ alpha attenuation r≥+0.20
//
//  NO API (raw#13)
//    NO Claude / LLM / remote inference. /tmp helper raw#37 transient.
//    User explicitly grants Camera + launches calibrate; agent NEVER auto-runs.
//
//  PRIVACY INVARIANTS (raw#13 reinforced — falsifiable, F4)
//    I1 NO frames stored      I2 NO face encoding
//    I3 landmarks RAM-only    I4 NO iris pixel patches
//    I5 5-metric output only  I6 chflags uchg after rotation
//    I7 hardware Camera-light remains visible
//
//  FROZEN CRITERIA (raw#12)
//    30 Hz, 9-pt calibration, EAR<0.20 blink, residual≤5°, r≥0.30 minimum.
//
//  USAGE
//    --selftest [--mode normal|low_light|iris_occluded|cal_fail|eyes_closed|permission_denied|mixed_seq]
//    --calibrate                    9-point calibration session (writes synth ledger only in selftest)
//    --tick                         one 1-min polling cycle (real webcam)
//    --falsifiers                   run 7 falsifiers (incl. privacy F4)
//    --out <path>                   override output JSONL
//
//  RAW
//    raw#9 · raw#10 · raw#12 · raw#13 · raw#22 · raw#37 · raw#65 · raw#71 ·
//    raw#77 · raw#82 · raw#91 · own 5
//
//  GENUS (raw#106)
//    webcam-gaze-ocular-cross-modal-eeg-tracker
//
//  FRAMEWORKS (own-5 ≥ 2)
//    Soukupová 2016 (EAR) · Salvucci 2000 (I-VT/I-DT) · Stern 1994 (blink↔drowsy)
//    Pope 1995 (engagement) · Berger 1929 (alpha attenuation)
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA          = "anima/eye_tracker/1"
let HELPER_PATH     = "/tmp/eye_tracker_helper.py"
let DEFAULT_OUT_DIR = "state/eye_tracker_audit"
let SELFTEST_OUT    = "state/anima_eeg_eye_tracker_selftest.jsonl"
// Resolve python3 (hexa sandbox PATH can be minimal). raw#37 portable.
let PY3             = "/usr/bin/python3"

// ─── arg helpers ────────────────────────────────────────────────────────────
fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]) j = j + 1 }
    return out
}

fn has_flag(name: string) -> int {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n { if av[i] == name { return 1 } i = i + 1 }
    return 0
}

fn flag_value(name: string, default_val: string) -> string {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == name { return av[i + 1] }
        i = i + 1
    }
    return default_val
}

fn now_iso() -> string { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }
fn today_utc() -> string { return exec("date -u +%Y-%m-%d").trim() }

// ─── hexa-native synth row generator (raw#65 idempotent, sandbox-portable) ──
// The python helper handles real-mode webcam capture; this hexa generator
// produces deterministic synthetic rows for selftest + falsifier runs and is
// independent of /tmp helper executability (hexa exec sandbox does not allow
// arbitrary python invocation).
fn synth_row(mode: string, seed: int) -> string {
    let mut sec = seed
    if sec < 0 { sec = -sec }
    sec = sec % 60
    let mut ts_sec = "0" + str(sec)
    if sec >= 10 { ts_sec = str(sec) }
    let ts = "2026-04-28T00:" + ts_sec + ":00Z"

    let mut error = ""
    let mut gx = 512
    let mut gy = 480
    let mut blink = 16
    let mut fix = 280
    let mut sacc = 90
    let mut pupil = 320
    let mut cal = 2400

    if mode == "permission_denied" {
        error = "camera_denied"
        gx = -1 gy = -1 blink = -1 fix = -1 sacc = -1 pupil = -1 cal = -1
    }
    if mode == "low_light" {
        error = "landmark_fail"
        gx = -1 gy = -1 blink = -1 fix = -1 sacc = -1 pupil = -1 cal = -1
    }
    if mode == "iris_occluded" {
        gx = 500 gy = 500 blink = 18 fix = 260 sacc = 85 pupil = -1 cal = 3500
    }
    if mode == "cal_fail" {
        error = "calibration_fail"
        gx = -1 gy = -1 blink = -1 fix = -1 sacc = -1 pupil = -1 cal = 7800
    }
    if mode == "eyes_closed" {
        gx = -1 gy = -1 blink = 60 fix = -1 sacc = 0 pupil = -1 cal = 2000
    }
    if mode == "focused_reading" {
        gx = 420 gy = 510 blink = 8 fix = 420 sacc = 45 pupil = 350 cal = 1800
    }
    if mode == "drowsy" {
        gx = 480 gy = 620 blink = 28 fix = 180 sacc = 70 pupil = 280 cal = 2400
    }
    if mode == "distracted_scanning" {
        gx = 300 gy = 400 blink = 20 fix = 160 sacc = 180 pupil = 400 cal = 2200
    }

    // Build JSON sorted-keys to mirror python's json.dumps(sort_keys=True).
    // Sorted key order:
    //   blink_rate_per_min, calibration_residual_deg_x1000, [error,]
    //   fixation_duration_avg_ms, gaze_x_screen_pct_x1000, gaze_y_screen_pct_x1000,
    //   pupil_dilation_proxy_x1000, saccade_rate_per_min, schema, ts
    let mut row = "{"
    row = row + "\"blink_rate_per_min\": " + str(blink)
    row = row + ", \"calibration_residual_deg_x1000\": " + str(cal)
    if error != "" { row = row + ", \"error\": \"" + error + "\"" }
    row = row + ", \"fixation_duration_avg_ms\": " + str(fix)
    row = row + ", \"gaze_x_screen_pct_x1000\": " + str(gx)
    row = row + ", \"gaze_y_screen_pct_x1000\": " + str(gy)
    row = row + ", \"pupil_dilation_proxy_x1000\": " + str(pupil)
    row = row + ", \"saccade_rate_per_min\": " + str(sacc)
    row = row + ", \"schema\": \"anima/eye_tracker/1\""
    row = row + ", \"ts\": \"" + ts + "\""
    row = row + "}"
    return row
}

// ─── /tmp helper writer (raw#37 transient — Privacy: NO frame/image/encoding) ─
fn write_helper() {
    let py = "#!/usr/bin/env python3\n" +
"# /tmp/eye_tracker_helper.py — transient (raw#37) — overwritten each run\n" +
"# Privacy (raw#13): NO frames stored, NO encoding, NO iris patches.\n" +
"# 30 Hz webcam landmarks → 5 ocular metrics → 1-min JSONL row.\n" +
"# Real mode: cv2.VideoCapture(0) + (dlib 68-pt OR mediapipe 468-pt FaceMesh)\n" +
"# in-memory only; landmarks reduced to 5 aggregates BEFORE any disk write.\n" +
"import sys, os, json, argparse, time, math\n" +
"\n" +
"SCHEMA = 'anima/eye_tracker/1'\n" +
"\n" +
"def synth_row(mode, seed):\n" +
"    # Deterministic by (mode, seed) — raw#65 idempotent.\n" +
"    ts = '2026-04-28T00:%02d:00Z' % (seed % 60)\n" +
"    base = dict(ts=ts, schema=SCHEMA)\n" +
"    if mode == 'permission_denied':\n" +
"        base.update(dict(error='camera_denied',\n" +
"            gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"            blink_rate_per_min=-1, fixation_duration_avg_ms=-1,\n" +
"            saccade_rate_per_min=-1, pupil_dilation_proxy_x1000=-1,\n" +
"            calibration_residual_deg_x1000=-1))\n" +
"        return base\n" +
"    if mode == 'low_light':\n" +
"        base.update(dict(error='landmark_fail',\n" +
"            gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"            blink_rate_per_min=-1, fixation_duration_avg_ms=-1,\n" +
"            saccade_rate_per_min=-1, pupil_dilation_proxy_x1000=-1,\n" +
"            calibration_residual_deg_x1000=-1))\n" +
"        return base\n" +
"    if mode == 'iris_occluded':\n" +
"        # F3: glasses / occlusion — pupil proxy invalid, others still ok.\n" +
"        base.update(dict(\n" +
"            gaze_x_screen_pct_x1000=500, gaze_y_screen_pct_x1000=500,\n" +
"            blink_rate_per_min=18, fixation_duration_avg_ms=260,\n" +
"            saccade_rate_per_min=85, pupil_dilation_proxy_x1000=-1,\n" +
"            calibration_residual_deg_x1000=3500))\n" +
"        return base\n" +
"    if mode == 'cal_fail':\n" +
"        # F5: residual > 5deg.\n" +
"        base.update(dict(error='calibration_fail',\n" +
"            gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"            blink_rate_per_min=-1, fixation_duration_avg_ms=-1,\n" +
"            saccade_rate_per_min=-1, pupil_dilation_proxy_x1000=-1,\n" +
"            calibration_residual_deg_x1000=7800))\n" +
"        return base\n" +
"    if mode == 'eyes_closed':\n" +
"        # F7: closed lids 60s = continuous EAR<0.20 -> blink_rate=60,\n" +
"        # no valid fixations.\n" +
"        base.update(dict(\n" +
"            gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"            blink_rate_per_min=60, fixation_duration_avg_ms=-1,\n" +
"            saccade_rate_per_min=0, pupil_dilation_proxy_x1000=-1,\n" +
"            calibration_residual_deg_x1000=2000))\n" +
"        return base\n" +
"    if mode == 'focused_reading':\n" +
"        # long fixations, low saccade, low blink, normal pupil.\n" +
"        base.update(dict(\n" +
"            gaze_x_screen_pct_x1000=420, gaze_y_screen_pct_x1000=510,\n" +
"            blink_rate_per_min=8, fixation_duration_avg_ms=420,\n" +
"            saccade_rate_per_min=45, pupil_dilation_proxy_x1000=350,\n" +
"            calibration_residual_deg_x1000=1800))\n" +
"        return base\n" +
"    if mode == 'drowsy':\n" +
"        # high blink rate, drifting gaze, short fixations.\n" +
"        base.update(dict(\n" +
"            gaze_x_screen_pct_x1000=480, gaze_y_screen_pct_x1000=620,\n" +
"            blink_rate_per_min=28, fixation_duration_avg_ms=180,\n" +
"            saccade_rate_per_min=70, pupil_dilation_proxy_x1000=280,\n" +
"            calibration_residual_deg_x1000=2400))\n" +
"        return base\n" +
"    if mode == 'distracted_scanning':\n" +
"        # high saccade rate, short fixations, high blink rate, alpha attenuation expected.\n" +
"        base.update(dict(\n" +
"            gaze_x_screen_pct_x1000=300, gaze_y_screen_pct_x1000=400,\n" +
"            blink_rate_per_min=20, fixation_duration_avg_ms=160,\n" +
"            saccade_rate_per_min=180, pupil_dilation_proxy_x1000=400,\n" +
"            calibration_residual_deg_x1000=2200))\n" +
"        return base\n" +
"    # default 'normal' — center gaze, ~16 blinks/min, 280 ms fixation.\n" +
"    base.update(dict(\n" +
"        gaze_x_screen_pct_x1000=512, gaze_y_screen_pct_x1000=480,\n" +
"        blink_rate_per_min=16, fixation_duration_avg_ms=280,\n" +
"        saccade_rate_per_min=90, pupil_dilation_proxy_x1000=320,\n" +
"        calibration_residual_deg_x1000=2400))\n" +
"    return base\n" +
"\n" +
"def real_window():\n" +
"    # Real-mode: requires opencv-python + mediapipe (user-installed).\n" +
"    # Privacy: frames live in RAM only, never written; only 5 aggregates emit.\n" +
"    try:\n" +
"        import cv2  # type: ignore\n" +
"    except Exception:\n" +
"        return dict(ts=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n" +
"                    schema=SCHEMA, error='cv2_not_installed',\n" +
"                    gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"                    blink_rate_per_min=-1, fixation_duration_avg_ms=-1,\n" +
"                    saccade_rate_per_min=-1, pupil_dilation_proxy_x1000=-1,\n" +
"                    calibration_residual_deg_x1000=-1)\n" +
"    cap = cv2.VideoCapture(0)\n" +
"    if not cap.isOpened():\n" +
"        return dict(ts=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n" +
"                    schema=SCHEMA, error='camera_denied',\n" +
"                    gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"                    blink_rate_per_min=-1, fixation_duration_avg_ms=-1,\n" +
"                    saccade_rate_per_min=-1, pupil_dilation_proxy_x1000=-1,\n" +
"                    calibration_residual_deg_x1000=-1)\n" +
"    # NOTE: full 60-s loop with MediaPipe FaceMesh would go here. To stay\n" +
"    # within hexa-orchestrator scope, we sample 30 frames (~1s) and report\n" +
"    # an honest C3 caveat. User runs --tick under launchd 60s for 1-min agg.\n" +
"    frames = 30\n" +
"    blinks = 0\n" +
"    saccades = 0\n" +
"    fix_total_ms = 0\n" +
"    fix_count = 0\n" +
"    last_x = None\n" +
"    last_y = None\n" +
"    iris_radius_acc = 0.0\n" +
"    iris_n = 0\n" +
"    inter_canthal_acc = 0.0\n" +
"    n = 0\n" +
"    for i in range(frames):\n" +
"        ok, frame = cap.read()\n" +
"        if not ok or frame is None: break\n" +
"        # frame is RAM-only; we DO NOT write it.\n" +
"        # Without dlib/mediapipe wired here we emit a sentinel-honest row.\n" +
"        n += 1\n" +
"    cap.release()\n" +
"    # Honest C3: this scaffold does not include the dlib model on disk; we\n" +
"    # return SCAFFOLD_OK with sentinel metrics so the orchestrator records\n" +
"    # an honest 'partial' row instead of fabricating gaze coords.\n" +
"    ts = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\n" +
"    return dict(ts=ts, schema=SCHEMA, error='scaffold_no_landmark_model',\n" +
"                gaze_x_screen_pct_x1000=-1, gaze_y_screen_pct_x1000=-1,\n" +
"                blink_rate_per_min=-1, fixation_duration_avg_ms=-1,\n" +
"                saccade_rate_per_min=-1, pupil_dilation_proxy_x1000=-1,\n" +
"                calibration_residual_deg_x1000=-1,\n" +
"                frames_captured_ramonly=n)\n" +
"\n" +
"def main():\n" +
"    ap = argparse.ArgumentParser()\n" +
"    ap.add_argument('--mode', default='real')\n" +
"    ap.add_argument('--seed', type=int, default=0)\n" +
"    args = ap.parse_args()\n" +
"    if args.mode == 'real':\n" +
"        row = real_window()\n" +
"    else:\n" +
"        row = synth_row(args.mode, args.seed)\n" +
"    print(json.dumps(row, sort_keys=True))\n" +
"\n" +
"if __name__ == '__main__': main()\n"
    write_file(HELPER_PATH, py)
    exec("chmod +x " + HELPER_PATH)
}

// ─── selftest: synthetic 4-window sequence (hexa-native, no python required) ─
fn run_selftest(mode: string, out_path: string) -> int {
    write_helper()  // still emit /tmp helper for real-mode tick later
    let modes = if mode == "mixed_seq" { ["normal", "focused_reading", "drowsy", "distracted_scanning"] } else { [mode, mode, mode, mode] }
    let mut i = 0
    let mut all = ""
    while i < len(modes) {
        let m = modes[i]
        let row = synth_row(m, i)
        all = all + row + "\n"
        i = i + 1
    }
    write_file(out_path, all)
    println("─── selftest (C19, mode=" + mode + ") ───")
    println("  rows written : " + str(len(modes)))
    println("  output       : " + out_path)
    println(all)
    return 0
}

// ─── 9-point calibration runner (hexa-native synth in scaffold mode) ────────
fn run_calibrate() -> int {
    write_helper()
    println("─── calibration (C19, 9-point, raw#12) ───")
    println("  targets : 4 corners + 4 edge-midpoints + 1 center")
    println("  protocol: 1.5 s fixation per target (avg last 1.0 s)")
    println("  acceptance: residual ≤ 5° visual angle")
    let row = synth_row("normal", 0)
    println("  synth row (selftest cal): " + row)
    println("  NOTE: real calibration requires Camera permission + opencv-python +")
    println("        mediapipe; this scaffold validates the protocol shape and")
    println("        emits a sentinel row so the agent never fabricates real gaze.")
    return 0
}

// ─── tick: one 1-min polling cycle (launchd 60-s interval) ──────────────────
fn run_tick(out_path: string) -> int {
    write_helper()
    let row = exec(PY3 + " " + HELPER_PATH + " --mode real").trim()
    if len(row) < 2 { return 1 }
    exec("mkdir -p " + DEFAULT_OUT_DIR)
    exec("printf '%s\\n' " + "'" + row.replace("'", "'\\''") + "'" + " >> " + out_path)
    println(row)
    return 0
}

// ─── falsifier runner (raw#71 ≥ 5; here 7 incl. privacy F4) ─────────────────
fn run_falsifiers() -> int {
    write_helper()
    let mut pass = 0
    let mut total = 0

    // F1: permission denied -> error=camera_denied
    let r_denied = synth_row("permission_denied", 0)
    total = total + 1
    let f1 = if r_denied.contains("\"error\": \"camera_denied\"") { 1 } else { 0 }
    if f1 == 1 { pass = pass + 1 }

    // F2: low_light -> landmark_fail + sentinels (-1)
    let r_dark = synth_row("low_light", 0)
    total = total + 1
    let mut f2 = 0
    if r_dark.contains("\"error\": \"landmark_fail\"") {
        if r_dark.contains("\"blink_rate_per_min\": -1") { f2 = 1 }
    }
    if f2 == 1 { pass = pass + 1 }

    // F3: iris_occluded -> pupil proxy = -1, other 4 metrics still computed
    let r_occ = synth_row("iris_occluded", 0)
    total = total + 1
    let mut f3 = 0
    if r_occ.contains("\"pupil_dilation_proxy_x1000\": -1") {
        if r_occ.contains("\"blink_rate_per_min\": 18") { f3 = 1 }
    }
    if f3 == 1 { pass = pass + 1 }

    // F4: PRIVACY — NO forbidden substrings across ALL synthetic rows
    let r_norm = synth_row("normal", 0)
    let r_focu = synth_row("focused_reading", 1)
    let r_drow = synth_row("drowsy", 2)
    let r_scan = synth_row("distracted_scanning", 3)
    let combined = r_norm + r_focu + r_drow + r_scan + r_denied + r_dark + r_occ
    total = total + 1
    let mut f4 = 1
    if combined.contains("\"frame\"")        { f4 = 0 }
    if combined.contains("\"image\"")        { f4 = 0 }
    if combined.contains("face_encoding")    { f4 = 0 }
    if combined.contains("\"landmark\"")     { f4 = 0 }
    if combined.contains("iris_patch")       { f4 = 0 }
    if combined.contains("\"pixel\"")        { f4 = 0 }
    if combined.contains("\"embedding\"")    { f4 = 0 }
    if combined.contains("iVBORw0KGgo")      { f4 = 0 }
    if combined.contains("/9j/4")            { f4 = 0 }
    if f4 == 1 { pass = pass + 1 }

    // F5: cal_fail -> error=calibration_fail + residual > 5000 (5deg x1000)
    let r_cal = synth_row("cal_fail", 0)
    total = total + 1
    let mut f5 = 0
    if r_cal.contains("\"error\": \"calibration_fail\"") {
        if r_cal.contains("\"calibration_residual_deg_x1000\": 7800") { f5 = 1 }
    }
    if f5 == 1 { pass = pass + 1 }

    // F6: idempotent (raw#65) — same (mode, seed) -> identical row
    let r_a = synth_row("normal", 5)
    let r_b = synth_row("normal", 5)
    total = total + 1
    let f6 = if r_a == r_b { 1 } else { 0 }
    if f6 == 1 { pass = pass + 1 }

    // F7: eyes_closed -> blink_rate=60 AND fixation=-1 sentinel
    let r_eye = synth_row("eyes_closed", 0)
    total = total + 1
    let mut f7 = 0
    if r_eye.contains("\"blink_rate_per_min\": 60") {
        if r_eye.contains("\"fixation_duration_avg_ms\": -1") { f7 = 1 }
    }
    if f7 == 1 { pass = pass + 1 }

    println("─── falsifiers (raw#71, C19) ───")
    println("  F1 permission_denied error  : " + (if f1 == 1 { "PASS" } else { "FAIL" }))
    println("  F2 low_light sentinel -1    : " + (if f2 == 1 { "PASS" } else { "FAIL" }))
    println("  F3 iris_occluded partial    : " + (if f3 == 1 { "PASS" } else { "FAIL" }))
    println("  F4 NO privacy leak fields   : " + (if f4 == 1 { "PASS" } else { "FAIL" }))
    println("  F5 calibration_fail abort   : " + (if f5 == 1 { "PASS" } else { "FAIL" }))
    println("  F6 idempotent (raw#65)      : " + (if f6 == 1 { "PASS" } else { "FAIL" }))
    println("  F7 eyes_closed signature    : " + (if f7 == 1 { "PASS" } else { "FAIL" }))
    println("  total: " + str(pass) + " / " + str(total))
    return if pass == total { 0 } else { 1 }
}

fn main() {
    let date        = today_utc()
    let default_out = DEFAULT_OUT_DIR + "/" + date + "_gaze.jsonl"
    let out_path    = flag_value("--out", default_out)

    if has_flag("--falsifiers") == 1 { exit(run_falsifiers()) }
    if has_flag("--selftest") == 1 {
        let mode = flag_value("--mode", "mixed_seq")
        let test_out = flag_value("--out", SELFTEST_OUT)
        exit(run_selftest(mode, test_out))
    }
    if has_flag("--calibrate") == 1 { exit(run_calibrate()) }
    if has_flag("--tick") == 1 { exit(run_tick(out_path)) }

    println("eye_tracker_webcam (C19) — usage:")
    println("  --selftest [--mode mixed_seq|normal|low_light|iris_occluded|cal_fail|eyes_closed|permission_denied|focused_reading|drowsy|distracted_scanning]")
    println("  --calibrate       9-point calibration session (Camera permission required for real)")
    println("  --tick            one 1-min polling cycle (launchd 60 s)")
    println("  --falsifiers      run 7 falsifiers (incl. privacy F4)")
    println("  schema            : " + SCHEMA)
    println("  out               : " + out_path)
    exit(0)
}

main()
