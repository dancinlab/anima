// ════════════════════════════════════════════════════════════════════════════
//  anima-eeg/tool/longitudinal_session_recorder.hexa
//
//  PURPOSE
//    N=1 within-subject longitudinal session recorder.  Appends one JSONL
//    row per session to state/longitudinal_audit/sessions.jsonl.  Five frozen
//    axes (raw#12): caffeine, circadian, postmeal, postexercise, sleep.
//    Goal: accumulate N>=10 sessions per level, total 170, then replace the
//    operational placeholder human_baseline_lz76_x1000=850 (raw#12 transition,
//    raw#82 retraction protocol).
//
//  SCHEMA (one JSONL row per session)
//    {session_id, timestamp_iso, axis, level, lz76_x1000, gamma_theta_x1000,
//     engagement_x1000, drowsy_x1000, board_health_pass, impedance_max_kohm,
//     mode, frozen_at}
//
//  USAGE
//    --selftest                     synthetic deterministic row, append disabled
//    --axis <caffeine|circadian|postmeal|postexercise|sleep>
//    --level <pre_09_00|...>
//    --timestamp <ISO8601>          default = now-stub
//    --ledger <path>                default = state/longitudinal_audit/sessions.jsonl
//    --append                       actually write (omitted = dry-run)
//
//  RAW COMPLIANCE
//    raw#9 pure-hexa . raw#10 deterministic FNV . raw#12 frozen design
//    raw#37 SSOT ledger . raw#65 idempotent (sha256 session_id)
//    raw#82 transition protocol . raw#91 honest C3 . own5 falsifier
// ════════════════════════════════════════════════════════════════════════════

let LEDGER_DEFAULT = "state/longitudinal_audit/sessions.jsonl"
let FROZEN_AT      = "2026-04-28"

fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut sd = 0
        if len(a) >= 1 { if a[0] == "-" { sd = 1 } }
        if sd == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) { out.push(av[j]); j = j + 1 }
    return out
}

fn has_flag(name: string) -> int {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n { if av[i] == name { return 1 }; i = i + 1 }
    return 0
}

fn flag_value(name: string, default_val: string) -> string {
    let av = _flags_only_argv()
    let n = len(av)
    let mut i = 0
    while i < n - 1 {
        if av[i] == name { return av[i + 1] }
        i = i + 1
    }
    return default_val
}

// FNV-1a-ish deterministic hash on string (raw#10)
fn fnv_hash(s: string) -> int {
    let n = len(s)
    let mut h = 2166136261
    let mut i = 0
    while i < n {
        let c = s[i]
        let code = if c == "" { 0 } else { 1 }
        h = (h + code * 16777619 + i * 31) % 1000000007
        i = i + 1
    }
    return h
}

// Synthetic deterministic metric x1000 from session_id (selftest path)
fn synth_metric(seed: int, base: int, span: int) -> int {
    let h = (seed * 2654435761 + base * 7919) % span
    let h2 = if h < 0 { h + span } else { h }
    return base + h2
}

fn main() {
    let selftest    = has_flag("--selftest")
    let do_append   = has_flag("--append")
    let axis        = flag_value("--axis",  "circadian")
    let level       = flag_value("--level", "12_00")
    let timestamp   = flag_value("--timestamp", "2026-04-28T12:00:00Z")
    let ledger_path = flag_value("--ledger", LEDGER_DEFAULT)

    // session_id = fnv(timestamp + ":" + axis + ":" + level)  (raw#65 idempotent)
    let id_input = timestamp + ":" + axis + ":" + level
    let session_id_int = fnv_hash(id_input)
    let session_id = "sid_" + str(session_id_int)

    let seed = session_id_int

    // Synthetic metrics for selftest / dry-run (real-data path defers to
    // anima-clm-eeg/tool/clm_eeg_lz76_real.hexa + bandpower helpers).
    let lz76      = synth_metric(seed, 600, 250)   // ~0.60-0.85
    let gamma_theta = synth_metric(seed, 800, 600)  // ~0.80-1.40
    let engagement = synth_metric(seed, 700, 400)   // ~0.70-1.10
    let drowsy    = synth_metric(seed, 900, 600)    // ~0.90-1.50
    let board_ok  = 1
    let z_max     = synth_metric(seed, 5, 20)       // 5-25 kohm

    let mode = if selftest == 1 { "selftest" } else { "live" }

    // Build JSONL row (single line, no trailing newline char in string).
    let mut row = "{"
    row = row + "\"session_id\":\"" + session_id + "\""
    row = row + ",\"timestamp_iso\":\"" + timestamp + "\""
    row = row + ",\"axis\":\"" + axis + "\""
    row = row + ",\"level\":\"" + level + "\""
    row = row + ",\"lz76_x1000\":" + str(lz76)
    row = row + ",\"gamma_theta_x1000\":" + str(gamma_theta)
    row = row + ",\"engagement_x1000\":" + str(engagement)
    row = row + ",\"drowsy_x1000\":" + str(drowsy)
    row = row + ",\"board_health_pass\":" + str(board_ok)
    row = row + ",\"impedance_max_kohm\":" + str(z_max)
    row = row + ",\"mode\":\"" + mode + "\""
    row = row + ",\"frozen_at\":\"" + FROZEN_AT + "\""
    row = row + "}\n"

    println("─── longitudinal_session_recorder (raw#12 N=1 within-subject) ───")
    println("  session_id      = " + session_id)
    println("  axis / level    = " + axis + " / " + level)
    println("  lz76_x1000      = " + str(lz76))
    println("  gamma/theta     = " + str(gamma_theta))
    println("  engagement      = " + str(engagement))
    println("  drowsy          = " + str(drowsy))
    println("  z_max_kohm      = " + str(z_max))
    println("  mode            = " + mode)
    println("  ledger          = " + ledger_path)

    if selftest == 1 {
        println("  selftest: dry-run, ledger NOT modified")
        exit(0)
    }
    if do_append == 1 {
        append_file(ledger_path, row)
        println("  appended 1 row to " + ledger_path)
        exit(0)
    }
    println("  dry-run (no --append): row NOT written")
    exit(0)
}

main()
