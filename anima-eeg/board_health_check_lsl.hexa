// anima-eeg/board_health_check_lsl.hexa
// raw#9 hexa-only · raw#10 honest C3 · raw#11 snake_case · raw#12 silent-error-ban
// raw#15 SSOT · raw#37 transient-helper-in-/tmp · raw#65 idempotent
// raw#71 falsifier-bound · raw#80 sentinel · raw#82 darwin-native · raw#101 minimal
//
// PURPOSE
//   LSL-side health check — counterpart to board_health_check.hexa (BrainFlow).
//   Verifies that the OpenBCI GUI is currently emitting an LSL outlet that
//   anima-eeg/lsl_capture.hexa can subscribe to.
//
//   Distinct verdicts (raw#10 honest):
//     LSL_HEALTHY              — stream resolved + 16ch + 125Hz + samples flowing
//     LSL_STREAM_NOT_FOUND     — no outlet with that name within timeout
//     LSL_SHAPE_MISMATCH       — wrong channel count or sample rate
//     LSL_NO_SAMPLES           — outlet exists but no data flows (GUI not started?)
//     LSL_PYLSL_MISSING        — .venv-eeg lacks pylsl
//
//   Falsifier set (raw#71 frozen 2026-05-03):
//     F_LSL_HC_01: pylsl import OK
//     F_LSL_HC_02: stream resolves within --resolve-timeout
//     F_LSL_HC_03: channel_count == --channel-count AND nominal_srate ≈ --sample-rate
//     F_LSL_HC_04: ≥1 chunk pulled within --probe-seconds (proves data flows)
//
// MODES
//   --selftest                    self outlet+inlet round-trip (pylsl install
//                                 verify, no GUI required)
//   --check --source <name>       real LSL outlet probe
//      [--probe-seconds <n>]      sample-flow probe seconds (default 3)
//      [--channel-count N]        expected ch count (default 16)
//      [--sample-rate Hz]         expected nominal rate (default 125)
//      [--resolve-timeout <n>]    stream resolve seconds (default 10)
//
// USE CASE
//   Pre-flight before lsl_capture.hexa --capture. If LSL_HEALTHY, the user
//   knows the GUI Networking widget is correctly configured and START STREAM
//   is engaged.
//
// raw#10 HONEST C3 CAVEATS
//   - This module CANNOT distinguish "GUI not running" from "Networking widget
//     not enabled" from "GUI START STREAM not pressed" — all surface as
//     LSL_STREAM_NOT_FOUND. The reason/fix trailer enumerates the steps.
//   - Sample rate match uses ±1 Hz tolerance (LSL nominal_srate is the declared
//     rate, not measured throughput; observed throughput in lsl_capture.hexa
//     gives the honest picture).
//
//  @resolver-bypass(reason="darwin-native: LSL outlet is produced by the
//                   OpenBCI_GUI Processing app running on the local laptop.
//                   Hetzner / linux pods do not run the GUI, so this check is
//                   meaningless there. Uses .venv-eeg/bin/python with pylsl.")

let SCHEMA              = "anima-eeg/board_health_lsl/1"
let HELPER_PATH         = "/tmp/anima_eeg_board_health_lsl_helper.py"

let DEFAULT_PROBE_SECONDS    = 3
let DEFAULT_CHANNEL_COUNT    = 16
let DEFAULT_SAMPLE_RATE      = 125
let DEFAULT_RESOLVE_TIMEOUT  = 10
let DEFAULT_VENV_PYTHON      = ".venv-eeg/bin/python"

let SENTINEL_TAG = "__EEG_LSL_HEALTH__"

// ────────────────────────────────────────────────────────────────────
// Section 0. Helpers
// ────────────────────────────────────────────────────────────────────

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path {
            if a.ends_with("/exe") { is_path = true }
        }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

// ────────────────────────────────────────────────────────────────────
// Section 1. Helper python emitter
// ────────────────────────────────────────────────────────────────────

fn _write_helper() {
    let py = "
import sys
import os
import time
import argparse

SENTINEL = '__EEG_LSL_HEALTH__'

def out_kv(k, v):
    print(str(k) + '=' + str(v), flush=True)

def err_trailer(reason, detail, fix):
    print('reason: ' + reason + ': ' + detail, file=sys.stderr, flush=True)
    print('fix: ' + fix, file=sys.stderr, flush=True)

def _import_pylsl():
    try:
        import pylsl
        return pylsl
    except ImportError as e:
        err_trailer('pylsl-missing', str(e)[:120],
                    '1) source .venv-eeg/bin/activate  2) pip install pylsl')
        return None

def run_check(source, probe_seconds, channel_count, sample_rate, resolve_timeout):
    pylsl = _import_pylsl()
    if pylsl is None:
        out_kv('verdict', 'LSL_PYLSL_MISSING')
        print(SENTINEL + ' FAIL reason=pylsl-missing', flush=True)
        return 4
    out_kv('pylsl_version', getattr(pylsl, '__version__', 'unknown'))
    out_kv('source', source)
    out_kv('expected_channel_count', channel_count)
    out_kv('expected_sample_rate', sample_rate)

    # F_LSL_HC_02: resolve.
    streams = pylsl.resolve_byprop('name', source, 1, resolve_timeout)
    if not streams:
        err_trailer('lsl-stream-not-found',
                    'no LSL stream named ' + repr(source) + ' within '
                    + str(resolve_timeout) + 's',
                    '1) launch OpenBCI GUI  '
                    '2) connect Cyton+Daisy + START SYSTEM  '
                    '3) Networking widget -> protocol LSL  '
                    '4) set name=' + repr(source) + ' type=EEG '
                    'data type=TimeSeriesRaw  '
                    '5) press START on Networking widget  '
                    '6) press START STREAM (top of GUI)')
        out_kv('verdict', 'LSL_STREAM_NOT_FOUND')
        print(SENTINEL + ' FAIL reason=stream-not-found', flush=True)
        return 5

    info = streams[0]
    inlet = pylsl.StreamInlet(info, max_buflen=60, recover=False)
    full_info = inlet.info()
    obs_ch = full_info.channel_count()
    obs_sr = float(full_info.nominal_srate())
    obs_type = full_info.type()
    out_kv('observed_channel_count', obs_ch)
    out_kv('observed_sample_rate_nominal', obs_sr)
    out_kv('observed_type', obs_type)

    # F_LSL_HC_03: shape match.
    if obs_ch != channel_count:
        err_trailer('lsl-shape-channel-mismatch',
                    'observed ' + str(obs_ch) + ' channels, expected '
                    + str(channel_count),
                    '1) GUI data type = TimeSeriesRaw or TimeSeriesFilt  '
                    '2) board = Cyton+Daisy (16ch); pure Cyton = 8ch')
        out_kv('verdict', 'LSL_SHAPE_MISMATCH')
        try: inlet.close_stream()
        except Exception: pass
        print(SENTINEL + ' FAIL reason=channel-count', flush=True)
        return 6

    if abs(obs_sr - float(sample_rate)) > 1.0:
        err_trailer('lsl-shape-rate-mismatch',
                    'observed ' + str(obs_sr) + ' Hz, expected '
                    + str(sample_rate),
                    '1) Cyton+Daisy native = 125 Hz  2) verify GUI sample rate')
        out_kv('verdict', 'LSL_SHAPE_MISMATCH')
        try: inlet.close_stream()
        except Exception: pass
        print(SENTINEL + ' FAIL reason=sample-rate', flush=True)
        return 6

    # F_LSL_HC_04: probe samples flow.
    t0 = time.time()
    pull_chunks = 0
    n_samples = 0
    deadline = t0 + probe_seconds
    while time.time() < deadline:
        chunk, _ = inlet.pull_chunk(timeout=0.5, max_samples=int(obs_sr))
        if chunk:
            pull_chunks += 1
            n_samples += len(chunk)
    duration = time.time() - t0
    out_kv('probe_duration_s', round(duration, 3))
    out_kv('probe_pull_chunks', pull_chunks)
    out_kv('probe_n_samples', n_samples)
    observed_rate = n_samples / max(duration, 1e-6)
    out_kv('probe_observed_rate', round(observed_rate, 2))

    try: inlet.close_stream()
    except Exception: pass

    if n_samples == 0:
        err_trailer('lsl-no-samples',
                    'outlet declared ' + str(int(obs_sr)) + 'Hz × '
                    + str(obs_ch) + 'ch but 0 samples in '
                    + str(round(duration, 1)) + 's probe',
                    '1) press START STREAM (top of GUI)  '
                    '2) Networking widget RUNNING (not STOPPED)?  '
                    '3) Cyton dongle red LED blinking?')
        out_kv('verdict', 'LSL_NO_SAMPLES')
        print(SENTINEL + ' FAIL reason=no-samples', flush=True)
        return 7

    out_kv('verdict', 'LSL_HEALTHY')
    print(SENTINEL + ' PASS chunks=' + str(pull_chunks)
          + ' samples=' + str(n_samples), flush=True)
    return 0

def run_selftest(probe_seconds):
    pylsl = _import_pylsl()
    if pylsl is None:
        out_kv('verdict', 'LSL_PYLSL_MISSING')
        print(SENTINEL + ' FAIL reason=pylsl-missing', flush=True)
        return 4
    try:
        import numpy as np
    except ImportError:
        err_trailer('numpy-missing', 'numpy not in venv',
                    '1) pip install numpy in .venv-eeg')
        out_kv('verdict', 'LSL_PYLSL_MISSING')
        print(SENTINEL + ' FAIL reason=numpy-missing', flush=True)
        return 4

    name = 'anima_lsl_health_selftest_' + str(int(time.time()))
    sr = 125.0
    n_ch = 16
    info = pylsl.StreamInfo(name, 'EEG', n_ch, sr, pylsl.cf_float32,
                            'anima_lsl_health_selftest_uid')
    outlet = pylsl.StreamOutlet(info, chunk_size=int(sr), max_buffered=10)

    streams = pylsl.resolve_byprop('name', name, 1, 5.0)
    if not streams:
        err_trailer('selftest-resolve-fail',
                    'self outlet did not resolve within 5s',
                    '1) restart pylsl  2) check loopback multicast permission')
        out_kv('verdict', 'LSL_SELFTEST_FAIL')
        print(SENTINEL + ' FAIL reason=selftest-resolve', flush=True)
        return 5

    inlet = pylsl.StreamInlet(streams[0], max_buflen=10, recover=False)
    rng = np.random.default_rng(7)
    chunk_size = 25
    n_pushed = 0
    n_pulled = 0
    t_end = time.time() + probe_seconds
    while time.time() < t_end:
        block = rng.standard_normal((chunk_size, n_ch)).astype(np.float32) * 5.0
        outlet.push_chunk(block.tolist())
        n_pushed += chunk_size
        time.sleep(chunk_size / sr)
        chunk, _ = inlet.pull_chunk(timeout=0.1, max_samples=chunk_size * 4)
        if chunk:
            n_pulled += len(chunk)

    try: inlet.close_stream()
    except Exception: pass
    del outlet

    out_kv('selftest_pushed', n_pushed)
    out_kv('selftest_pulled', n_pulled)
    if n_pulled == 0:
        out_kv('verdict', 'LSL_SELFTEST_FAIL')
        print(SENTINEL + ' FAIL reason=no-samples', flush=True)
        return 7
    out_kv('verdict', 'LSL_SELFTEST_OK')
    print(SENTINEL + ' PASS pushed=' + str(n_pushed)
          + ' pulled=' + str(n_pulled), flush=True)
    return 0

if __name__ == '__main__':
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest='mode', required=True)

    pc = sub.add_parser('check')
    pc.add_argument('--source', required=True)
    pc.add_argument('--probe-seconds', dest='probe_seconds', type=int, default=3)
    pc.add_argument('--channel-count', dest='channel_count', type=int, default=16)
    pc.add_argument('--sample-rate', dest='sample_rate', type=int, default=125)
    pc.add_argument('--resolve-timeout', dest='resolve_timeout', type=int, default=10)

    ps = sub.add_parser('selftest')
    ps.add_argument('--probe-seconds', dest='probe_seconds', type=int, default=2)

    args = p.parse_args()
    if args.mode == 'check':
        rc = run_check(args.source, args.probe_seconds, args.channel_count,
                       args.sample_rate, args.resolve_timeout)
    else:
        rc = run_selftest(args.probe_seconds)
    sys.exit(rc)
"
    write_file(HELPER_PATH, py)
}

// ────────────────────────────────────────────────────────────────────
// Section 2. CLI — main()
// ────────────────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/board_health_check_lsl.hexa --selftest [--probe-seconds <n>]")
    eprintln("       hexa run anima-eeg/board_health_check_lsl.hexa --check --source <name> \\")
    eprintln("              [--probe-seconds 3] [--channel-count 16] [--sample-rate 125]")
    eprintln("              [--resolve-timeout 10]")
    eprintln("flags:")
    eprintln("  --selftest             pylsl install + outlet+inlet round-trip (no GUI)")
    eprintln("  --check                real LSL outlet probe")
    eprintln("  --source <name>        LSL stream name to probe (e.g. obci_eeg1)")
    eprintln("  --probe-seconds <n>    sample-flow probe window (default 3)")
    eprintln("  --channel-count <n>    expected channels (default 16)")
    eprintln("  --sample-rate <Hz>     expected nominal rate (default 125)")
    eprintln("  --resolve-timeout <n>  stream resolve timeout seconds (default 10)")
    eprintln("  --help                 this message")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut check_mode = false
    let mut want_help = false
    let mut source = ""
    let mut probe_seconds = DEFAULT_PROBE_SECONDS
    let mut channel_count = DEFAULT_CHANNEL_COUNT
    let mut sample_rate = DEFAULT_SAMPLE_RATE
    let mut resolve_timeout = DEFAULT_RESOLVE_TIMEOUT

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--check"    { check_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--source" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--source requires stream name",
                              "1) re-run with --source obci_eeg1")
                exit(2)
            }
            source = av[i + 1]; i = i + 2; continue
        }
        if a == "--probe-seconds" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--probe-seconds requires int",
                              "1) re-run with --probe-seconds 3")
                exit(2)
            }
            probe_seconds = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--channel-count" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--channel-count requires int",
                              "1) re-run with --channel-count 16")
                exit(2)
            }
            channel_count = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--sample-rate" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--sample-rate requires int",
                              "1) re-run with --sample-rate 125")
                exit(2)
            }
            sample_rate = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--resolve-timeout" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--resolve-timeout requires int",
                              "1) re-run with --resolve-timeout 10")
                exit(2)
            }
            resolve_timeout = to_int(av[i + 1]); i = i + 2; continue
        }
        _emit_trailer("unknown-arg", "unrecognized argument: " + a,
                      "1) re-run with --help")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }
    if !selftest && !check_mode {
        eprintln("ABORT: must pass --selftest or --check")
        _print_usage()
        exit(2)
    }
    if check_mode && source == "" {
        _emit_trailer("missing-required-arg", "--source is required for --check",
                      "1) re-run with --source obci_eeg1")
        exit(2)
    }

    _write_helper()

    println("── board_health_check_lsl (raw#9 hexa-only, raw#71 falsifier-bound) ──")
    println("schema: " + SCHEMA)
    if selftest {
        println("mode: selftest (synthetic outlet+inlet)")
        println("probe_seconds: " + str(probe_seconds))
    } else {
        println("mode: check (real LSL outlet probe)")
        println("source: " + source)
        println("probe_seconds: " + str(probe_seconds))
        println("channel_count: " + str(channel_count))
        println("sample_rate: " + str(sample_rate))
        println("resolve_timeout: " + str(resolve_timeout) + "s")
    }

    let venv_py = DEFAULT_VENV_PYTHON
    let mut cmd = venv_py + " " + HELPER_PATH
    if selftest {
        cmd = cmd + " selftest --probe-seconds " + str(probe_seconds)
    } else {
        cmd = cmd + " check"
        cmd = cmd + " --source " + _sh_quote(source)
        cmd = cmd + " --probe-seconds " + str(probe_seconds)
        cmd = cmd + " --channel-count " + str(channel_count)
        cmd = cmd + " --sample-rate " + str(sample_rate)
        cmd = cmd + " --resolve-timeout " + str(resolve_timeout)
    }

    eprintln("[GATE] dispatch=local cmd=" + cmd)

    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    print(to_string(r[0]))

    println("──")
    println("schema: " + SCHEMA)
    println("exit_code: " + str(rc))
    if rc == 0 {
        if selftest {
            println("verdict: LSL_SELFTEST_OK ✓")
        } else {
            println("verdict: LSL_HEALTHY ✓")
        }
        exit(0)
    }
    if rc == 4 {
        println("verdict: LSL_PYLSL_MISSING ✗")
        exit(4)
    }
    if rc == 5 {
        println("verdict: LSL_STREAM_NOT_FOUND ✗")
        exit(5)
    }
    if rc == 6 {
        println("verdict: LSL_SHAPE_MISMATCH ✗")
        exit(6)
    }
    if rc == 7 {
        println("verdict: LSL_NO_SAMPLES ✗ (outlet exists but no data flowing)")
        exit(7)
    }
    println("verdict: UNKNOWN exit_code=" + str(rc))
    exit(rc)
}
