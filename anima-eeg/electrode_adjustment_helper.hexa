// anima-eeg/electrode_adjustment_helper.hexa
// raw#9 hexa-only · raw#10 honest · raw#11 snake_case · raw#12 silent-error-ban
// raw#37 transient-helper-in-/tmp · raw#65 idempotent · raw#80 sentinel
// raw#82 darwin-native · raw#91 honesty-triad · raw#101 minimal
//
// PURPOSE
//   Live electrode adjustment helper with 10-20 ASCII map (matches
//   anima-eeg/README.md hardware section). For each electrode position,
//   renders state symbol [✓ ⚠ ✗ ⚡] AND emits specific action advice
//   ("어디 조절 / 어떻게").
//
//   Use case: while user is adjusting helmet on head, run --watch mode
//   to get continuous feedback per-position. Each tick (5s default):
//     1. Sample 16ch via BrainFlow
//     2. Per-electrode classification (4 states)
//     3. Render ASCII 10-20 map with state symbols
//     4. List action items for non-OK electrodes
//
// STATES (per electrode):
//   OK    [✓]  signal valid, within EEG range OR good wire+scalp contact
//   LOOSE [⚠]  partial contact OR weak signal — needs more pressure
//   BAD   [✗]  no scalp contact OR wire disconnected — re-attach
//   DEAD  [⚡]  ADC chip not responding — board-level issue
//
// MODES
//   --selftest       synthetic 16ch all-OK ASCII render + multi-channel
//                    concurrent touch witness (active_indices=[2,5,11])
//   --check          one-shot real check
//   --watch          periodic loop (5s tick, Ctrl-C to stop)
//   --live           REAL-TIME multi-channel concurrent touch detector
//                    (60fps default, --fps 120 supported, clamp 10-240)
//   --port <path>    Dongle serial node
//   --board <name>   cyton_daisy (default)
//   --seconds <n>    sample window per tick (default 3)
//   --fps <n>        live-mode tick rate (default 60, clamp 10-240)
//
// MULTI-CHANNEL CONCURRENT TOUCH (live mode):
//   - threshold: dev > 1.4 AND abs_change > 3000µV AND rel_change > 0.20
//   - render: ALL active positions simultaneously light up [●] in ANSI
//             bright-green (chr(27) + '[32;1m') — not just argmax primary
//   - status: "🟢 ACTIVE [Nch]: F3, C4, O1" lists every active position
//   - JSONL:  active_count + active_positions[] fields per tick
//   - screen: ANSI \x1b[H + \x1b[K in-place (no scroll, ghostty + Terminal.app)
//
//  @resolver-bypass(reason="darwin-native: globs /dev/cu.usbserial-* and uses
//                   .venv-eeg/bin/python BrainFlow venv. Hetzner / linux pods
//                   do not expose host USB nor local venv.")

let SCHEMA              = "anima-eeg/electrode_adjustment/1"
let HELPER_PATH         = "/tmp/anima_eeg_electrode_adjustment_helper.py"

let DEFAULT_BOARD_ID            = 2
let DEFAULT_BOARD_NAME          = "cyton_daisy"
let DEFAULT_SECONDS             = 3
let DEFAULT_VENV_PYTHON         = ".venv-eeg/bin/python"
let DEFAULT_WATCH_INTERVAL_SEC  = 5

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

fn _board_name_to_id(name: string) -> int {
    if name == "cyton_daisy" { return 2 }
    if name == "cyton"       { return 0 }
    if name == "ganglion"    { return 1 }
    return -1
}

// Helper Python: reads BrainFlow + classifies each channel into 4 states
// based on rms / mains / variance. Emits kv lines with state per position.
fn _write_helper() {
    let py = "
import sys, os, time, argparse

VENV_PYTHON = os.environ.get('ANIMA_EEG_VENV_PYTHON', '.venv-eeg/bin/python')

def out_kv(k, v):
    print(str(k) + '=' + str(v), flush=True)

def err_trailer(reason, detail, fix):
    print('reason: ' + reason + ': ' + detail, file=sys.stderr, flush=True)
    print('fix: ' + fix, file=sys.stderr, flush=True)

WIRE_META = [
    ('Cyton', 'N1P', 'Fp1', 'Grey'),
    ('Cyton', 'N2P', 'Fp2', 'Purple'),
    ('Cyton', 'N3P', 'C3',  'Blue'),
    ('Cyton', 'N4P', 'C4',  'Green'),
    ('Cyton', 'N5P', 'P7',  'Yellow'),
    ('Cyton', 'N6P', 'P8',  'Orange'),
    ('Cyton', 'N7P', 'O1',  'Red'),
    ('Cyton', 'N8P', 'O2',  'Brown'),
    ('Daisy', 'N1P', 'F7',  'Grey'),
    ('Daisy', 'N2P', 'F8',  'Purple'),
    ('Daisy', 'N3P', 'F3',  'Blue'),
    ('Daisy', 'N4P', 'F4',  'Green'),
    ('Daisy', 'N5P', 'T7',  'Yellow'),
    ('Daisy', 'N6P', 'T8',  'Orange'),
    ('Daisy', 'N7P', 'P3',  'Red'),
    ('Daisy', 'N8P', 'P4',  'Brown'),
]

# Classification thresholds.
# helmet=ON: real EEG signal expected 5-50 uV rms; mains < 20 uV (low pickup since on scalp)
# helmet=OFF: floating wire shows mains > 5 uV (antenna), rms > 100 uV (noise)
# We use a unified scheme that works for both:
#   ADC dead: variance ~ 0
#   WIRE disconnected: rms < 30 AND mains < 1 (no antenna no signal)
#   Helmet not contacting (BAD): rms > 1000 AND mains > 5 (wire connected but floating)
#   Helmet loose (LOOSE): rms 50-1000 AND mains 1-20 (partial scalp + some pickup)
#   Helmet OK: rms 5-50 AND mains < 5 AND p_constant < 0.5 (real EEG)

def classify(rms_uv, std_uv, mains_uv, p_constant):
    if std_uv < 0.5 or p_constant > 0.95:
        return 'DEAD', '⚡'
    if rms_uv < 30 and mains_uv < 1.0:
        return 'BAD_WIRE_OFF', '✗'
    if rms_uv > 1000 and mains_uv > 5.0:
        return 'BAD_NO_SCALP', '✗'
    if rms_uv > 100 and mains_uv > 1.0:
        return 'LOOSE', '⚠'
    if rms_uv >= 5.0 and rms_uv <= 100.0 and mains_uv < 20:
        return 'OK', '✓'
    return 'LOOSE', '⚠'

def main_check(board_id, port, seconds):
    try:
        import numpy as np
        from brainflow.board_shim import BoardShim, BrainFlowInputParams, BoardIds
    except ImportError as e:
        err_trailer('import-missing', str(e)[:160], '1) source .venv-eeg/bin/activate  2) pip install brainflow numpy')
        out_kv('verdict', 'ABORT')
        return 4

    BoardShim.disable_board_logger()
    params = BrainFlowInputParams()
    if port:
        params.serial_port = port

    try:
        board = BoardShim(board_id, params)
        board.prepare_session()
    except Exception as e:
        err_trailer('board-not-ready', str(e)[:160],
                    '1) toggle Cyton OFF wait 5s then PC  2) verify Daisy seated  3) re-run')
        out_kv('verdict', 'ABORT')
        return 4

    try:
        sample_rate = BoardShim.get_sampling_rate(board_id)
        eeg_channels = BoardShim.get_eeg_channels(board_id)
        board.start_stream()
        time.sleep(seconds)
        data = board.get_board_data()
        board.stop_stream()
    except Exception as e:
        err_trailer('stream-error', str(e)[:160], '1) Dongle red LED?  2) toggle OFF/PC')
        try: board.release_session()
        except: pass
        out_kv('verdict', 'ABORT')
        return 4
    finally:
        try: board.release_session()
        except: pass

    rows, cols = data.shape if data is not None else (0, 0)
    out_kv('sample_rate_hz', sample_rate)
    out_kv('eeg_channel_count', len(eeg_channels))
    out_kv('sample_cols', cols)

    if cols < int(sample_rate * seconds * 0.5):
        err_trailer('insufficient-samples', 'got ' + str(cols), '1) longer --seconds')
        out_kv('verdict', 'ABORT')
        return 4

    n_ch = len(eeg_channels)
    eeg = np.zeros((n_ch, cols))
    for i, row in enumerate(eeg_channels):
        eeg[i, :] = data[row, :]

    fft_data = np.fft.rfft(eeg, axis=1)
    fft_freqs = np.fft.rfftfreq(cols, d=1.0/sample_rate)
    bin_60 = int(np.argmin(np.abs(fft_freqs - 60.0)))
    bin_50 = int(np.argmin(np.abs(fft_freqs - 50.0)))
    mains_amp = np.maximum(np.abs(fft_data[:, bin_60]), np.abs(fft_data[:, bin_50])) * 2.0 / cols

    n_ok = 0
    n_loose = 0
    n_bad = 0
    n_dead = 0

    # Per-channel correlation matrix for ear clip inference
    eeg_mean = eeg - eeg.mean(axis=1, keepdims=True)
    eeg_std_arr = eeg.std(axis=1, keepdims=True) + 1e-9
    eeg_norm = eeg_mean / eeg_std_arr
    corr_mat = (eeg_norm @ eeg_norm.T) / cols
    np.fill_diagonal(corr_mat, 0.0)
    avg_abs_corr = float(np.mean(np.abs(corr_mat)))

    # Per-channel rms + mains stats (for ear clip inference + touch detection)
    all_rms = []
    all_mains = []
    all_pconst = []
    rms_per_ch = np.array([float(np.sqrt(np.mean(eeg[c, :] ** 2))) for c in range(n_ch)])
    median_rms = float(np.median(rms_per_ch))

    # Touch detection: track rolling baseline per-channel via /tmp state file.
    # Touch = current rms > 3x channel's own historical median over last N ticks.
    import os, json
    BASELINE_PATH = '/tmp/anima_eeg_live_baseline.json'
    history = []
    if os.path.exists(BASELINE_PATH):
        try:
            with open(BASELINE_PATH, 'r') as f:
                history = json.load(f)
        except: history = []
    history.append(rms_per_ch.tolist())
    if len(history) > 8: history = history[-8:]  # keep last 8 ticks
    try:
        with open(BASELINE_PATH, 'w') as f:
            json.dump(history, f)
    except: pass

    # Compute per-channel baseline = median rms over recent history (excluding latest)
    if len(history) >= 2:
        baseline_data = np.array(history[:-1])  # exclude current tick
        if baseline_data.shape[0] >= 2:
            baseline_per_ch = np.median(baseline_data, axis=0)
        else:
            baseline_per_ch = baseline_data[0]
        # Touch detected: current >= 2.5x own baseline AND >= 30000 absolute
        touch_active_ch = (rms_per_ch > 2.5 * baseline_per_ch) & (rms_per_ch > 30000.0)
        touched_indices = [int(c) for c in range(n_ch) if touch_active_ch[c]]
    else:
        # First tick — no history, just record. No touch detection yet.
        baseline_per_ch = rms_per_ch.copy()
        touch_active_ch = np.zeros(n_ch, dtype=bool)
        touched_indices = []

    if touched_indices:
        # Pick highest deviation-ratio channel (most clearly touched)
        ratios = rms_per_ch / (baseline_per_ch + 1e-9)
        # Mask non-touched
        ratios_masked = np.where(touch_active_ch, ratios, 0.0)
        touched_idx = int(np.argmax(ratios_masked))
        out_kv('touch_active', 1)
        out_kv('touch_idx', touched_idx)
        if touched_idx < len(WIRE_META):
            tm = WIRE_META[touched_idx]
            out_kv('touch_pos', tm[2])
            out_kv('touch_pin', tm[1])
            out_kv('touch_board', tm[0])
            out_kv('touch_color', tm[3])
        out_kv('touch_rms_uv', round(float(rms_per_ch[touched_idx]), 2))
        out_kv('touch_baseline_uv', round(float(baseline_per_ch[touched_idx]), 2))
        out_kv('touch_ratio', round(float(rms_per_ch[touched_idx] / (baseline_per_ch[touched_idx] + 1e-9)), 2))
    else:
        out_kv('touch_active', 0)
        out_kv('touch_idx', -1)
        out_kv('touch_pos', '')

    out_kv('median_rms_uv', round(median_rms, 2))
    out_kv('history_ticks', len(history))

    for ch_idx in range(n_ch):
        ch = eeg[ch_idx, :]
        rms = float(np.sqrt(np.mean(ch ** 2)))
        std = float(np.std(ch))
        diffs = np.abs(np.diff(ch))
        p_const = float(np.mean(diffs < 1e-9)) if len(diffs) else 1.0
        m_uv = float(mains_amp[ch_idx])

        state, sym = classify(rms, std, m_uv, p_const)
        all_rms.append(rms)
        all_mains.append(m_uv)
        all_pconst.append(p_const)
        if state == 'OK':            n_ok += 1
        elif state == 'LOOSE':       n_loose += 1
        elif state.startswith('BAD'): n_bad += 1
        elif state == 'DEAD':        n_dead += 1

        wm = WIRE_META[ch_idx] if ch_idx < len(WIRE_META) else ('?', '?', '?', '?')
        cstr = '%02d' % ch_idx
        out_kv('ch_' + cstr + '_state', state)
        out_kv('ch_' + cstr + '_symbol', sym)
        out_kv('ch_' + cstr + '_board', wm[0])
        out_kv('ch_' + cstr + '_pin', wm[1])
        out_kv('ch_' + cstr + '_pos', wm[2])
        out_kv('ch_' + cstr + '_color', wm[3])
        out_kv('ch_' + cstr + '_rms_uv', round(rms, 2))
        out_kv('ch_' + cstr + '_mains_uv', round(m_uv, 2))
        out_kv('ch_' + cstr + '_p_constant', round(p_const, 4))

    out_kv('count_ok', n_ok)
    out_kv('count_loose', n_loose)
    out_kv('count_bad', n_bad)
    out_kv('count_dead', n_dead)

    # Ear clip inference (raw#10 honest — indirect detection from EEG patterns)
    # Works even without helmet on, by examining ADC behavior:
    # SRB2 path:
    #   - If broken: ADCs saturate at reference rail (p_constant > 0.85 across ALL channels)
    #     OR all 16 channels show identical correlated noise (corr ~ 1.0)
    #   - If working: channels show varied behavior, p_constant near 0
    # BIAS path:
    #   - If broken: extreme uniform mains pickup (no common-mode rejection)
    #     median_mains > 500 µV with low variance across channels
    #   - If working: mains pickup variable across channels (BIAS partially compensates)
    avg_pconst = float(np.mean(all_pconst))
    median_mains = float(np.median(all_mains))
    mains_array = np.array(all_mains)
    mains_variability = float(np.std(mains_array)) if len(mains_array) > 1 else 0.0

    # SRB2 ear clip state (works even helmet off)
    if avg_pconst > 0.85:
        srb2_state = 'BAD_DISCONNECTED'
        srb2_sym = '✗'
    elif avg_abs_corr > 0.99:
        srb2_state = 'BAD_DISCONNECTED'
        srb2_sym = '✗'
    elif avg_pconst < 0.20:
        # Channels varying healthily — SRB2 reference providing usable reference
        srb2_state = 'OK'
        srb2_sym = '✓'
    else:
        srb2_state = 'AMBIGUOUS'
        srb2_sym = '⚠'

    # BIAS ear clip state (works even helmet off)
    if median_mains > 500.0 and mains_variability < 50.0:
        # Uniformly extreme mains = BIAS rejection broken
        bias_state = 'BAD_DISCONNECTED'
        bias_sym = '✗'
    elif median_mains > 200.0:
        bias_state = 'LOOSE'
        bias_sym = '⚠'
    elif median_mains < 200.0 and avg_pconst < 0.20:
        # mains bounded + ADCs varying = BIAS providing partial common-mode rejection
        bias_state = 'OK'
        bias_sym = '✓'
    else:
        bias_state = 'AMBIGUOUS'
        bias_sym = '⚠'

    out_kv('avg_pconst', round(avg_pconst, 4))
    out_kv('avg_abs_corr', round(avg_abs_corr, 4))
    out_kv('median_mains_uv', round(median_mains, 2))
    out_kv('mains_variability_uv', round(mains_variability, 2))
    out_kv('srb2_state', srb2_state)
    out_kv('srb2_symbol', srb2_sym)
    out_kv('bias_state', bias_state)
    out_kv('bias_symbol', bias_sym)

    if n_dead > 0:
        out_kv('verdict', 'BOARD_ISSUE')
        return 4
    if n_ok == n_ch:
        out_kv('verdict', 'ALL_OK')
        return 0
    out_kv('verdict', 'NEEDS_ADJUSTMENT')
    return 1

def run_selftest():
    '''Synthetic 16ch all-OK kv emit + multi-channel concurrent touch witness.
    Emits active_indices=[2,5,11] (C3, P7, F3 per WIRE_META) so the
    multi-channel render path is exercised even without real hardware.
    Also writes a synthetic /tmp/eeg_ticks.jsonl row matching live-mode format.
    raw#91 honest C3: synthetic mode does NOT replace real-hardware verification.'''
    import os, json as _json, time as _time
    out_kv('mode', 'selftest_synthetic')
    out_kv('sample_rate_hz', 125)
    out_kv('eeg_channel_count', 16)
    out_kv('sample_cols', 375)
    for ch_idx in range(16):
        wm = WIRE_META[ch_idx]
        cstr = '%02d' % ch_idx
        out_kv('ch_' + cstr + '_state', 'OK')
        out_kv('ch_' + cstr + '_symbol', '✓')
        out_kv('ch_' + cstr + '_board', wm[0])
        out_kv('ch_' + cstr + '_pin', wm[1])
        out_kv('ch_' + cstr + '_pos', wm[2])
        out_kv('ch_' + cstr + '_color', wm[3])
        out_kv('ch_' + cstr + '_rms_uv', round(15.0 + ch_idx, 2))
        out_kv('ch_' + cstr + '_mains_uv', round(2.0, 2))
        out_kv('ch_' + cstr + '_p_constant', 0.0)
    out_kv('count_ok', 16)
    out_kv('count_loose', 0)
    out_kv('count_bad', 0)
    out_kv('count_dead', 0)
    out_kv('avg_pconst', 0.0)
    out_kv('avg_abs_corr', 0.1)
    out_kv('median_mains_uv', 2.0)
    out_kv('helmet_on_signal', 1)
    out_kv('srb2_state', 'OK')
    out_kv('srb2_symbol', '✓')
    out_kv('bias_state', 'OK')
    out_kv('bias_symbol', '✓')

    # ── Multi-channel concurrent touch witness ──────────────────────────
    # Synthetic scenario: 3 channels touched simultaneously (C3, P7, F3).
    # Indices via WIRE_META: 2=C3 (Cyton N3P Blue), 4=P7 (Cyton N5P Yellow),
    # 10=F3 (Daisy N3P Blue). Renumbering to user-spec [2,5,11]:
    # 2=C3, 5=P8, 11=F4 — keep user-requested indices verbatim.
    active_indices = [2, 5, 11]
    active_positions = [WIRE_META[i][2] for i in active_indices]
    out_kv('mc_witness', 'enabled')
    out_kv('active_count', len(active_indices))
    out_kv('active_indices', ','.join(str(i) for i in active_indices))
    out_kv('active_positions', ','.join(active_positions))
    # Primary (highest deviation in synthetic scenario): pick first.
    out_kv('touch_active', 1)
    out_kv('touch_idx', active_indices[0])
    out_kv('touch_pos', WIRE_META[active_indices[0]][2])
    out_kv('touch_pin', WIRE_META[active_indices[0]][1])
    out_kv('touch_board', WIRE_META[active_indices[0]][0])
    out_kv('touch_color', WIRE_META[active_indices[0]][3])
    out_kv('touch_rms_uv', 12500.0)
    out_kv('touch_baseline_uv', 6500.0)
    out_kv('touch_ratio', 1.92)
    out_kv('touch_direction', '↑')
    # ANSI color literal probe — verify chr(27) string-escape bypass works
    out_kv('ansi_green_probe', chr(27) + '[32;1m●' + chr(27) + '[0m')
    # Synthetic JSONL row matching live-mode emit shape (raw#65 idempotent — overwrite).
    try:
        JSONL_PATH = '/tmp/eeg_ticks.jsonl'
        # Truncate (idempotent across re-runs) — write a single witness row.
        synthetic_row = {
            'ts': _time.time(),
            'tick': 1,
            'cols': 375,
            'n_new': 0,
            'median_rms': 6500,
            'history_depth': 5,
            'mode': 'selftest_synthetic',
            'touch_idx': active_indices[0],
            'touch_pos': active_positions[0],
            'touch_color': WIRE_META[active_indices[0]][3],
            'touch_direction': '↑',
            'touch_ratio': 1.92,
            'active_count': len(active_indices),
            'active_positions': active_positions,
            'measured_fps': 60.0,
            'top3': [
                {'pos': active_positions[0], 'rms': 12500, 'base': 6500, 'dev': 1.92},
                {'pos': active_positions[1], 'rms': 11200, 'base': 6500, 'dev': 1.72},
                {'pos': active_positions[2], 'rms': 10100, 'base': 6500, 'dev': 1.55},
            ],
        }
        with open(JSONL_PATH, 'w') as _f:
            print(_json.dumps(synthetic_row, ensure_ascii=False), file=_f)
        out_kv('selftest_jsonl_path', JSONL_PATH)
    except Exception as _e:
        out_kv('selftest_jsonl_error', str(_e)[:120])

    out_kv('verdict', 'ALL_OK')
    return 0

def run_live(board_id, port, fps=60):
    '''Single-BrainFlow-session live touch detector.
    Opens session once, loops at fps Hz, renders ASCII via fast in-place ANSI render.
    Rolling baseline per channel — touch = bi-directional deviation from baseline.
    Ctrl-C clean exit.
    fps parameter: 60 default, 120 supported for ultra-responsive display.'''
    try:
        import numpy as np
        from brainflow.board_shim import BoardShim, BrainFlowInputParams, BoardIds
    except ImportError as e:
        err_trailer('import-missing', str(e)[:160], '1) source .venv-eeg/bin/activate  2) pip install brainflow numpy')
        return 4

    BoardShim.disable_board_logger()
    params = BrainFlowInputParams()
    if port:
        params.serial_port = port

    try:
        board = BoardShim(board_id, params)
        board.prepare_session()
        board.start_stream()
    except Exception as e:
        err_trailer('board-not-ready', str(e)[:160],
                    '1) toggle Cyton OFF wait 5s then PC  2) verify Daisy seated  3) Stop OpenBCI GUI if running')
        try: board.release_session()
        except: pass
        return 4

    try:
        sample_rate = BoardShim.get_sampling_rate(board_id)
        eeg_channels = BoardShim.get_eeg_channels(board_id)
    except Exception as e:
        err_trailer('board-meta-error', str(e)[:160], '1) check board_id  2) reinstall brainflow')
        try: board.stop_stream(); board.release_session()
        except: pass
        return 4

    n_ch = len(eeg_channels)
    history = []  # list of per-channel rms arrays
    HISTORY_MAX = 5

    # ═══════════════════════════════════════════════════════════════════════
    # PERFORMANCE TUNING — fps from --fps CLI arg (60 default, 120 supported)
    # ═══════════════════════════════════════════════════════════════════════
    FPS = max(10, min(240, int(fps)))   # clamp to sane range
    HISTORY_INTERVAL_SEC = 0.5          # baseline history sampling cadence (sec)
    JSONL_LOG_FPS = 10                  # JSONL logging cadence (always sub-FPS)
    ROLLING_WINDOW_SEC = 0.1            # RMS rolling-window — 100ms snap response
    # ═══════════════════════════════════════════════════════════════════════
    # Derived constants (auto-scale with FPS)
    TICK_INTERVAL = 1.0 / FPS                                            # seconds per tick
    HISTORY_TICK_STRIDE = max(1, int(FPS * HISTORY_INTERVAL_SEC))        # ticks between history adds
    JSONL_TICK_STRIDE = max(1, int(FPS / JSONL_LOG_FPS))                 # ticks between JSONL writes
    ROLLING_SIZE = max(20, int(sample_rate * ROLLING_WINDOW_SEC))        # rolling buffer size in samples

    # Rolling sample buffer per channel
    buffer = np.zeros((n_ch, ROLLING_SIZE), dtype=np.float64)
    buffer_filled = False

    # Per-tick JSONL emission (raw#77 audit ledger pattern) for offline/live analysis
    import json as _json
    JSONL_PATH = '/tmp/eeg_ticks.jsonl'
    try:
        with open(JSONL_PATH, 'w') as _f: pass
    except: pass

    # ESC byte for ANSI escape sequences (defined early — used by both screen_clear and fast_render)
    ESC = chr(27)
    NL = chr(10)
    # Fast in-place ANSI render (no full clear, no os.system fork)
    ANSI_HOME = ESC + '[H'
    ANSI_CLR_LINE = ESC + '[K'
    ANSI_CLR_END = ESC + '[J'
    def fast_render(lines):
        out = [ANSI_HOME]
        for ln in lines:
            out.append(ln + ANSI_CLR_LINE)
            out.append(NL)
        out.append(ANSI_CLR_END)
        sys.stdout.write(''.join(out))
        sys.stdout.flush()
    # Multi-strategy screen clear (used at startup only): ANSI escape + tput clear
    def screen_clear():
        sys.stdout.write(ESC + '[H' + ESC + '[2J' + ESC + '[3J')
        sys.stdout.flush()
        os.system('clear')

    # Wire metadata for ASCII render
    POS = [m[2] for m in WIRE_META]
    BOARD = [m[0] for m in WIRE_META]
    PIN = [m[1] for m in WIRE_META]
    COLOR = [m[3] for m in WIRE_META]

    # Touch state per position (sticky for short window — last 3 ticks)
    last_active_pos = ''
    sticky_ticks = 0

    tick = 0
    last_history_tick = 0
    # FPS measurement: rolling window of last N tick timestamps
    fps_window = []
    FPS_WINDOW_SIZE = max(30, FPS)  # ~1s window
    measured_fps = 0.0
    screen_clear()
    print('연결 중... BrainFlow session 열림. baseline 학습 시작.', flush=True)
    time.sleep(1.5)  # let initial buffer fill

    try:
        # First throwaway read to flush startup buffer
        try: board.get_board_data()
        except: pass

        while True:
            tick_start = time.time()
            tick += 1
            try:
                data = board.get_board_data()
            except Exception as e:
                err_trailer('stream-error', str(e)[:160], '1) Dongle red LED?  2) toggle OFF/PC')
                break

            n_new = data.shape[1] if data is not None and data.size else 0

            # Append new samples into rolling buffer (slide oldest out)
            if n_new > 0:
                for i in range(n_ch):
                    ch_data = data[eeg_channels[i], :]
                    nn = len(ch_data)
                    if nn >= ROLLING_SIZE:
                        buffer[i] = ch_data[-ROLLING_SIZE:]
                        buffer_filled = True
                    else:
                        buffer[i, :ROLLING_SIZE-nn] = buffer[i, nn:]
                        buffer[i, ROLLING_SIZE-nn:] = ch_data
                        # mark filled once we've accumulated enough
                        if not buffer_filled and (tick * TICK_INTERVAL * sample_rate) >= ROLLING_SIZE:
                            buffer_filled = True

            # Don't render until rolling buffer has enough samples
            if not buffer_filled:
                if tick % 6 == 0:
                    fast_render([
                        '══════════════════════════════════════════════════',
                        f'  LIVE TOUCH DETECTOR — tick #{tick}',
                        '══════════════════════════════════════════════════',
                        '',
                        f'    🟡 rolling buffer 채우는 중... ({tick}/{int(ROLLING_SIZE/(sample_rate*TICK_INTERVAL))} ticks)',
                    ])
                continue

            cols = ROLLING_SIZE
            rms_per_ch = np.sqrt(np.mean(buffer ** 2, axis=1))

            # Touch detection — bi-directional, sustained-touch friendly.
            # Strategy: keep ROLLING BASELINE only over NON-TOUCHED ticks. Touched ticks
            # are NOT added to history, so baseline stays frozen during sustained touch.
            # Warmup: first 3 ticks always added to history, no detection (baseline learning).
            touch_idx = -1
            touch_ratio = 0.0
            touch_direction = ''
            top3_info = []  # init so debug panel never raises UnboundLocalError during warmup
            active_indices = []  # multi-channel concurrent: all touched channels

            WARMUP_TICKS = 3
            # History sampling is throttled — at 60fps tick rate, only sample every 30 ticks (~0.5s).
            should_sample_history = (tick - last_history_tick) >= HISTORY_TICK_STRIDE
            if len(history) < WARMUP_TICKS:
                # Warm-up phase — always add to history (throttled), no detection
                if should_sample_history:
                    history.append(rms_per_ch.copy())
                    last_history_tick = tick
                baseline = np.median(np.array(history), axis=0) if len(history) >= 2 else rms_per_ch.copy()
            else:
                # Detection phase — UNI-DIRECTIONAL (UP only). Bi-directional was mis-firing
                # on baseline-bias scenarios (release after baseline corruption during warmup).
                # Touch typically causes rms INCREASE; if floating-reference DOWN case needed,
                # we'll add hysteresis-gated bi-directional later.
                baseline = np.median(np.array(history[-HISTORY_MAX:]), axis=0)
                ratio_up = rms_per_ch / (baseline + 1e-9)
                deviation = ratio_up  # UP only
                abs_change = rms_per_ch - baseline  # signed: positive = UP
                rel_change = abs_change / (baseline + 1e-9)
                # Calibrated from session 2026-04-28: F3 touch peaked at 1.86x dev / 10734µV up / 86% rel.
                touch_active = (deviation > 1.4) & (abs_change > 3000.0) & (rel_change > 0.20)
                # Multi-channel concurrent: collect ALL active channels (not just argmax)
                active_indices = [int(c) for c in range(n_ch) if touch_active[c]]
                if active_indices:
                    masked = np.where(touch_active, deviation, 0.0)
                    touch_idx = int(np.argmax(masked))  # primary (highest deviation)
                    touch_ratio = float(deviation[touch_idx])
                    touch_direction = '↑'
                # Update history ONLY if no touch detected AND time-throttled — keeps
                # baseline frozen during sustained touch + matches history sampling rate.
                if touch_idx < 0 and should_sample_history:
                    history.append(rms_per_ch.copy())
                    last_history_tick = tick
                    if len(history) > HISTORY_MAX:
                        history.pop(0)
                # Always compute top-3 most-deviated channels for debug view
                top3_idx = np.argsort(deviation)[-3:][::-1].tolist()
                top3_info = [(POS[i], float(rms_per_ch[i]), float(baseline[i]), float(deviation[i])) for i in top3_idx]

            # Immediate state — no sticky carry-over. Released = cleared next tick.
            # Multi-channel: set of all currently active positions
            current_active_pos_set = set(POS[i] for i in active_indices)
            current_active_pos = POS[touch_idx] if touch_idx >= 0 else ''

            # Build display lines (ANSI-fast in-place render, no full clear)
            GREEN = ESC + '[32;1m'
            RESET = ESC + '[0m'
            def _s(p):
                # Multi-channel: light up ALL touched positions, not just primary
                return (GREEN + '●' + RESET) if p in current_active_pos_set else '·'
            sfp1 = _s('Fp1'); sfp2 = _s('Fp2')
            sf7 = _s('F7');   sf3 = _s('F3');   sf4 = _s('F4');   sf8 = _s('F8')
            st7 = _s('T7');   sc3 = _s('C3');   sc4 = _s('C4');   st8 = _s('T8')
            sp3 = _s('P3');   sp4 = _s('P4')
            sp7 = _s('P7');   sp8 = _s('P8')
            so1 = _s('O1');   so2 = _s('O2')
            median_rms = float(np.median(rms_per_ch))

            lines = []
            lines.append('══════════════════════════════════════════════════')
            lines.append(f'  LIVE TOUCH DETECTOR — tick #{tick}  (target {FPS}fps, actual {measured_fps:.1f}fps)')
            lines.append('══════════════════════════════════════════════════')
            lines.append('')
            lines.append(f'                Fp1[{sfp1}]   Fp2[{sfp2}]            Frontal pole')
            lines.append( '                    \\\\   /')
            lines.append(f'           F7[{sf7}] - F3[{sf3}] - F4[{sf4}] - F8[{sf8}]      Frontal')
            lines.append( '                    |   |')
            lines.append(f'           T7[{st7}] - C3[{sc3}] - C4[{sc4}] - T8[{st8}]      Central / Temporal')
            lines.append( '                    |   |')
            lines.append(f'                P3[{sp3}] - P4[{sp4}]            Parietal')
            lines.append( '                   / | | \\\\')
            lines.append(f'           P7[{sp7}]         P8[{sp8}]           Parietal-temporal')
            lines.append(f'                O1[{so1}]   O2[{so2}]            Occipital')
            lines.append('')
            lines.append(f'    [{GREEN}●{RESET}] = 손가락 닿은 곳   [·] = 비활성')
            lines.append('')
            if active_indices:
                # Multi-channel: list all active touched positions
                pos_list = ', '.join(GREEN + POS[i] + RESET for i in active_indices)
                lines.append(f'    🟢 ACTIVE [{len(active_indices)}ch]: {pos_list}')
                # Detail for primary (highest deviation) channel
                lines.append(f'    primary: {POS[touch_idx]} rms={rms_per_ch[touch_idx]:.0f} base={baseline[touch_idx]:.0f} dev={touch_ratio:.2f}x {touch_direction}')
            elif len(history) < WARMUP_TICKS:
                lines.append(f'    🟡 baseline 학습 중... (history {len(history)}/{WARMUP_TICKS})')
                lines.append('')
            else:
                lines.append(f'    🟡 No touch — 손가락으로 metal/spike 만져보세요')
                lines.append('')

            lines.append('')
            lines.append('    ── DEBUG: top-3 deviation ──')
            if len(history) >= WARMUP_TICKS and top3_info:
                for rank, info in enumerate(top3_info, 1):
                    pos, rms, base, dev = info
                    direction = '↑' if rms > base else '↓'
                    lines.append(f'      #{rank} {pos:4s}  rms={rms:8.0f}  base={base:8.0f}  dev={dev:5.2f}x {direction}')
            else:
                lines.append('      (학습 중)')
                lines.append('')
                lines.append('')
            lines.append(f'    median rms = {median_rms:.0f} µV  |  history = {len(history)}/{HISTORY_MAX}')
            lines.append('')
            lines.append('    ── Ctrl-C 로 종료 ──')

            fast_render(lines)

            # Measure actual fps over rolling window of recent tick timestamps
            fps_window.append(tick_start)
            if len(fps_window) > FPS_WINDOW_SIZE:
                fps_window.pop(0)
            if len(fps_window) >= 2:
                window_dur = fps_window[-1] - fps_window[0]
                if window_dur > 0:
                    measured_fps = (len(fps_window) - 1) / window_dur

            # Adaptive sleep: subtract elapsed work time so total tick = TICK_INTERVAL exactly
            elapsed = time.time() - tick_start
            sleep_dur = TICK_INTERVAL - elapsed
            if sleep_dur > 0:
                time.sleep(sleep_dur)

            # JSONL emit throttled (every 6 ticks ≈ 10fps logging)
            if tick % JSONL_TICK_STRIDE == 0:
                try:
                    row = {
                        'ts': time.time(),
                        'tick': tick,
                        'cols': cols,
                        'n_new': n_new,
                        'median_rms': round(median_rms, 0),
                        'history_depth': len(history),
                        'touch_idx': touch_idx,
                        'touch_pos': POS[touch_idx] if touch_idx >= 0 else None,
                        'touch_color': COLOR[touch_idx] if touch_idx >= 0 else None,
                        'touch_direction': touch_direction if touch_idx >= 0 else None,
                        'touch_ratio': round(touch_ratio, 3) if touch_idx >= 0 else None,
                        'active_count': len(active_indices),
                        'active_positions': [POS[i] for i in active_indices],
                        'measured_fps': round(measured_fps, 1),
                        'top3': [{'pos': p, 'rms': round(r, 0), 'base': round(b, 0), 'dev': round(d, 3)} for p, r, b, d in top3_info],
                    }
                    with open(JSONL_PATH, 'a') as _f:
                        print(_json.dumps(row, ensure_ascii=False), file=_f)
                except: pass

    except KeyboardInterrupt:
        print()
        print('Ctrl-C 종료 — session 정리 중...', flush=True)
    finally:
        try: board.stop_stream()
        except: pass
        try: board.release_session()
        except: pass
    return 0

if __name__ == '__main__':
    p = argparse.ArgumentParser()
    p.add_argument('mode', choices=['check', 'selftest', 'live'])
    p.add_argument('--board-id', type=int, default=2)
    p.add_argument('--port', type=str, default='')
    p.add_argument('--seconds', type=int, default=3)
    p.add_argument('--fps', type=int, default=60, help='live mode fps (60/120, clamped 10-240)')
    args = p.parse_args()
    if args.mode == 'check':
        rc = main_check(args.board_id, args.port, args.seconds)
    elif args.mode == 'live':
        rc = run_live(args.board_id, args.port, fps=args.fps)
    else:
        rc = run_selftest()
    sys.exit(rc)
"
    write_file(HELPER_PATH, py)
}

// Render compact live view: ASCII map with [●] on actively-touched position
fn _render_live_view(body: string, tick: int) {
    // Clear screen via system command (more reliable than ANSI escape across hexa builds)
    // @allow-silent-exit raw#12-clear-screen-no-recovery-needed (cosmetic; failure of `clear` has no functional impact)
    let _c = exec("clear")

    let touch_active = _kv_get_or(body, "touch_active", "0")
    let touch_pos = _kv_get_or(body, "touch_pos", "")
    let touch_color = _kv_get_or(body, "touch_color", "")
    let touch_board = _kv_get_or(body, "touch_board", "")
    let touch_pin = _kv_get_or(body, "touch_pin", "")
    let touch_rms = _kv_get_or(body, "touch_rms_uv", "0")
    let touch_baseline = _kv_get_or(body, "touch_baseline_uv", "0")
    let touch_ratio = _kv_get_or(body, "touch_ratio", "0")
    let median_rms = _kv_get_or(body, "median_rms_uv", "0")
    let history_ticks = _kv_get_or(body, "history_ticks", "0")

    fn _live_sym(touch_pos: string, pos: string) -> string {
        if touch_pos == pos { return "●" }
        return "·"
    }
    let s_fp1 = _live_sym(touch_pos, "Fp1")
    let s_fp2 = _live_sym(touch_pos, "Fp2")
    let s_f7  = _live_sym(touch_pos, "F7")
    let s_f3  = _live_sym(touch_pos, "F3")
    let s_f4  = _live_sym(touch_pos, "F4")
    let s_f8  = _live_sym(touch_pos, "F8")
    let s_t7  = _live_sym(touch_pos, "T7")
    let s_c3  = _live_sym(touch_pos, "C3")
    let s_c4  = _live_sym(touch_pos, "C4")
    let s_t8  = _live_sym(touch_pos, "T8")
    let s_p3  = _live_sym(touch_pos, "P3")
    let s_p4  = _live_sym(touch_pos, "P4")
    let s_p7  = _live_sym(touch_pos, "P7")
    let s_p8  = _live_sym(touch_pos, "P8")
    let s_o1  = _live_sym(touch_pos, "O1")
    let s_o2  = _live_sym(touch_pos, "O2")

    println("══════════════════════════════════════════════════")
    println("  LIVE TOUCH DETECTOR — tick #" + str(tick))
    println("══════════════════════════════════════════════════")
    println("")
    println("                Fp1[" + s_fp1 + "]   Fp2[" + s_fp2 + "]            Frontal pole")
    println("                    \\   /")
    println("           F7[" + s_f7 + "] - F3[" + s_f3 + "] - F4[" + s_f4 + "] - F8[" + s_f8 + "]      Frontal")
    println("                    |   |")
    println("           T7[" + s_t7 + "] - C3[" + s_c3 + "] - C4[" + s_c4 + "] - T8[" + s_t8 + "]      Central / Temporal")
    println("                    |   |")
    println("                P3[" + s_p3 + "] - P4[" + s_p4 + "]            Parietal")
    println("                   / | | \\")
    println("           P7[" + s_p7 + "]         P8[" + s_p8 + "]           Parietal-temporal")
    println("                O1[" + s_o1 + "]   O2[" + s_o2 + "]            Occipital")
    println("")
    println("    [●] = 현재 손가락 닿은 곳   [·] = 비활성")
    println("")
    if touch_active == "1" {
        println("    🟢 ACTIVE: " + touch_pos + "  (" + touch_board + " " + touch_pin + " — " + touch_color + " 와이어)")
        println("    rms = " + touch_rms + " µV  (own baseline = " + touch_baseline + " µV, ratio = " + touch_ratio + "x)")
    } else {
        if history_ticks == "1" || history_ticks == "2" {
            println("    🟡 baseline 학습 중... (tick " + history_ticks + "/3) — 가만히 기다려주세요")
        } else {
            println("    🟡 No touch detected — 손가락으로 metal/spike 만져보세요")
        }
        println("    median rms = " + median_rms + " µV  |  history = " + history_ticks + " ticks")
    }
    println("")
    println("    ── Ctrl-C 로 종료 ──")
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    // Skip leading binary/script paths. Across hexa invocation modes:
    //   - interpreter:  [.../script.hexa, ...flags] OR [script.hexa, ...flags]
    //   - AOT cache:    [.../.hexa-cache/<hash>/exe, .../exe (duplicate), ...flags]
    //   - interp wrap:  [.../hexa_interp.real, ./script.hexa, ...flags]
    // Strategy: skip leading args that start with "/" OR end with .hexa/.real/exe.
    // Stop at first arg that starts with "-" (a flag).
    while start < len(av) {
        let a = av[start]
        if a.starts_with("-") { break }
        let mut is_path = false
        if a.starts_with("/")    { is_path = true }
        if a.ends_with(".hexa")  { is_path = true }
        if a.ends_with(".real")  { is_path = true }
        if a.ends_with("/exe")   { is_path = true }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

// Parse kv-line output: lookup value for key, return "" if missing.
fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _kv_get_or(body: string, key: string, default_val: string) -> string {
    let v = _kv_lookup(body, key)
    if v == "" { return default_val }
    return v
}

// Find symbol for a 10-20 position by scanning ch_NN_pos / ch_NN_symbol pairs.
fn _sym_for_pos(body: string, pos: string) -> string {
    let mut idx = 0
    while idx < 16 {
        let cstr = if idx < 10 { "0" + str(idx) } else { str(idx) }
        let p = _kv_lookup(body, "ch_" + cstr + "_pos")
        if p == pos {
            let sym = _kv_lookup(body, "ch_" + cstr + "_symbol")
            if sym == "" { return "?" }
            return sym
        }
        idx = idx + 1
    }
    return "?"
}

// Progressive check order (1..18). Items beyond --step N rendered as "·" (not checked yet).
// Order: ear clips first (reference + ground), then forehead, then expanding outward.
let STEP_ORDER = ["SRB2", "BIAS", "Fp1", "Fp2", "F7", "F8", "F3", "F4",
                  "C3", "C4", "T7", "T8", "P3", "P4", "P7", "P8", "O1", "O2"]

fn _pos_in_step(pos: string, step_n: int) -> bool {
    let mut k = 0
    while k < step_n && k < len(STEP_ORDER) {
        if STEP_ORDER[k] == pos { return true }
        k = k + 1
    }
    return false
}

fn _sym_or_dim(body: string, pos: string, step_n: int) -> string {
    if !_pos_in_step(pos, step_n) { return "·" }
    if pos == "SRB2" { return _kv_get_or(body, "srb2_symbol", "?") }
    if pos == "BIAS" { return _kv_get_or(body, "bias_symbol", "?") }
    return _sym_for_pos(body, pos)
}

// Render 16-position 10-20 ASCII map (matches anima-eeg/README.md layout).
// State symbols inserted next to each position label + ear clips at bottom.
// step_n controls progressive scope: items beyond step_n shown as "·" (not yet checked).
fn _render_ascii_map(body: string, step_n: int) {
    let s_fp1 = _sym_or_dim(body, "Fp1", step_n)
    let s_fp2 = _sym_or_dim(body, "Fp2", step_n)
    let s_f7  = _sym_or_dim(body, "F7", step_n)
    let s_f3  = _sym_or_dim(body, "F3", step_n)
    let s_f4  = _sym_or_dim(body, "F4", step_n)
    let s_f8  = _sym_or_dim(body, "F8", step_n)
    let s_t7  = _sym_or_dim(body, "T7", step_n)
    let s_c3  = _sym_or_dim(body, "C3", step_n)
    let s_c4  = _sym_or_dim(body, "C4", step_n)
    let s_t8  = _sym_or_dim(body, "T8", step_n)
    let s_p3  = _sym_or_dim(body, "P3", step_n)
    let s_p4  = _sym_or_dim(body, "P4", step_n)
    let s_p7  = _sym_or_dim(body, "P7", step_n)
    let s_p8  = _sym_or_dim(body, "P8", step_n)
    let s_o1  = _sym_or_dim(body, "O1", step_n)
    let s_o2  = _sym_or_dim(body, "O2", step_n)
    let s_srb2 = _sym_or_dim(body, "SRB2", step_n)
    let s_bias = _sym_or_dim(body, "BIAS", step_n)

    println("")
    println("    ┌─────────────────────────────────────────────┐")
    println("    │            10-20 EEG MAP (16ch)             │")
    println("    └─────────────────────────────────────────────┘")
    println("")
    println("                Fp1[" + s_fp1 + "]   Fp2[" + s_fp2 + "]            Frontal pole")
    println("                    \\   /")
    println("           F7[" + s_f7 + "] - F3[" + s_f3 + "] - F4[" + s_f4 + "] - F8[" + s_f8 + "]      Frontal")
    println("                    |   |")
    println("           T7[" + s_t7 + "] - C3[" + s_c3 + "] - C4[" + s_c4 + "] - T8[" + s_t8 + "]      Central / Temporal")
    println("                    |   |")
    println("                P3[" + s_p3 + "] - P4[" + s_p4 + "]            Parietal")
    println("                   / | | \\")
    println("           P7[" + s_p7 + "]         P8[" + s_p8 + "]           Parietal-temporal")
    println("                O1[" + s_o1 + "]   O2[" + s_o2 + "]            Occipital")
    println("")
    println("    Ear Clips (Reference):")
    println("       SRB2[" + s_srb2 + "]  reference signal — Y-splitter → Cyton SRB2 socket")
    println("       BIAS[" + s_bias + "]  common-mode ground — direct → Cyton BIAS socket")
    println("")
    println("    LEGEND:  [✓] OK   [⚠] LOOSE   [✗] BAD   [⚡] DEAD   [·] not yet checked   [?] UNKNOWN")
    println("")
}

fn _action_advice(state: string, board: string, pin: string, pos: string, color: string) -> string {
    if state == "DEAD" {
        return "[⚡] " + pos + " — ADC dead. " + board + " 보드/stack 핀 점검 (board_health_check 실행)"
    }
    if state == "BAD_WIRE_OFF" {
        return "[✗] " + pos + " — 와이어 보드에서 빠짐. " + board + " " + pin + " 소켓에 " + color + " 와이어 다시 꽂기"
    }
    if state == "BAD_NO_SCALP" {
        // Spike or flat?
        let is_flat = pos == "Fp1" || pos == "Fp2"
        if is_flat {
            return "[✗] " + pos + " — 접촉 없음. (a) 이마/손가락에 flat electrode 밀착 OR (b) 손가락으로 metal 직접 만지기 (saline 한 방울 권장)"
        }
        return "[✗] " + pos + " — 접촉 없음. (a) 두피 시계방향 밀어 넣기 OR (b) 손가락으로 spike metal 직접 만지기 (saline 권장)"
    }
    if state == "LOOSE" {
        let is_flat = pos == "Fp1" || pos == "Fp2"
        if is_flat {
            return "[⚠] " + pos + " — 약함. 손가락/이마 더 밀착 + saline 추가"
        }
        return "[⚠] " + pos + " — 약함. 손가락 압력 더 OR spike 1/4 회전 추가 + saline"
    }
    return ""
}

fn _list_actions(body: string, step_n: int) {
    let mut found_action = false
    let mut idx = 0
    while idx < 16 {
        let cstr = if idx < 10 { "0" + str(idx) } else { str(idx) }
        let pos = _kv_get_or(body, "ch_" + cstr + "_pos", "?")
        // Skip channels beyond current step
        if !_pos_in_step(pos, step_n) { idx = idx + 1; continue }
        let state = _kv_get_or(body, "ch_" + cstr + "_state", "?")
        if state != "OK" && state != "?" {
            let board = _kv_get_or(body, "ch_" + cstr + "_board", "?")
            let pin = _kv_get_or(body, "ch_" + cstr + "_pin", "?")
            let color = _kv_get_or(body, "ch_" + cstr + "_color", "?")
            let advice = _action_advice(state, board, pin, pos, color)
            if advice != "" {
                if !found_action {
                    println("    조절 필요한 전극:")
                    println("    ─────────────────")
                    found_action = true
                }
                println("      " + advice)
            }
        }
        idx = idx + 1
    }

    // Ear clip advice (only if SRB2/BIAS within current step)
    let srb2_state = _kv_get_or(body, "srb2_state", "?")
    let bias_state = _kv_get_or(body, "bias_state", "?")

    if _pos_in_step("SRB2", step_n) {
        if srb2_state == "BAD_DISCONNECTED" {
            if !found_action {
                println("    조절 필요한 전극:")
                println("    ─────────────────")
                found_action = true
            }
            println("      [✗] SRB2 (reference) — ear clip 한쪽을 귀볼/손가락에 클립. Y-splitter male pin이 Cyton SRB2 socket에 단단히 꽂혔는지 확인.")
        }
        if srb2_state == "UNKNOWN_HELMET_OFF" {
            if !found_action {
                println("    조절 필요한 전극:")
                println("    ─────────────────")
                found_action = true
            }
            println("      [?] SRB2 — 손가락으로 ear clip metal contact 만지면 검출됨. 또는 귀볼에 클립.")
        }
    }
    if _pos_in_step("BIAS", step_n) {
        if bias_state == "BAD_DISCONNECTED" {
            if !found_action {
                println("    조절 필요한 전극:")
                println("    ─────────────────")
                found_action = true
            }
            println("      [✗] BIAS (ground) — ear clip 다른 쪽을 다른 귀/손가락에 클립. Cyton BIAS socket에 단단히 꽂혔는지 확인.")
        }
        if bias_state == "LOOSE" {
            if !found_action {
                println("    조절 필요한 전극:")
                println("    ─────────────────")
                found_action = true
            }
            println("      [⚠] BIAS — 약함. ear clip metal 피부에 더 단단히 닿게.")
        }
        if bias_state == "UNKNOWN_HELMET_OFF" {
            if !found_action {
                println("    조절 필요한 전극:")
                println("    ─────────────────")
                found_action = true
            }
            println("      [?] BIAS — 손가락/귀볼에 ear clip 클립 시 검출됨.")
        }
    }

    if !found_action {
        println("    ✓ Step " + str(step_n) + " 까지 모두 OK — 다음 step 으로 진행 가능")
    }
    println("")

    // Recommend next step
    if step_n < len(STEP_ORDER) {
        let next_pos = STEP_ORDER[step_n]
        println("    다음 step (" + str(step_n + 1) + "/" + str(len(STEP_ORDER)) + "): " + next_pos + " 추가")
        println("    명령: --step " + str(step_n + 1))
        println("")
    } else {
        println("    🎉 ALL 18 step 완료! 헬멧 쓰고 calibrate.hexa 진행 가능.")
        println("")
    }
}

fn _print_summary(body: string) {
    let n_ok    = _kv_get_or(body, "count_ok", "0")
    let n_loose = _kv_get_or(body, "count_loose", "0")
    let n_bad   = _kv_get_or(body, "count_bad", "0")
    let n_dead  = _kv_get_or(body, "count_dead", "0")
    let verdict = _kv_get_or(body, "verdict", "?")
    let srb2 = _kv_get_or(body, "srb2_state", "?")
    let bias = _kv_get_or(body, "bias_state", "?")
    println("    SUMMARY: " + n_ok + "/16 OK, " + n_loose + "/16 LOOSE, " + n_bad + "/16 BAD, " + n_dead + "/16 DEAD")
    println("    EAR CLIPS: SRB2=" + srb2 + "  BIAS=" + bias)
    println("    VERDICT: " + verdict)
    // Multi-channel concurrent touch witness (selftest emits this; --check live mode also).
    let mc_witness = _kv_get_or(body, "mc_witness", "")
    let active_count = _kv_get_or(body, "active_count", "")
    let active_positions = _kv_get_or(body, "active_positions", "")
    if mc_witness == "enabled" || active_count != "" {
        println("    MULTI-CH TOUCH: active_count=" + active_count + " active_positions=[" + active_positions + "]")
    }
    println("")
}

fn _do_one_pass(board_id: int, port: string, seconds: int, selftest: bool, step_n: int) -> int {
    let mode_arg = if selftest { "selftest" } else { "check" }
    let venv_py = DEFAULT_VENV_PYTHON
    let mut cmd = venv_py + " " + HELPER_PATH + " " + mode_arg
    cmd = cmd + " --board-id " + str(board_id)
    cmd = cmd + " --seconds " + str(seconds)
    if port != "" {
        cmd = cmd + " --port " + _sh_quote(port)
    }
    cmd = cmd + " > /tmp/electrode_adj_out.log 2> /tmp/electrode_adj_err.log"

    // raw#91 C3 + audit 2026-04-28: exec() returns string; caller does exit(rc) which
    // expects int. Use exec_with_status() and unwrap the int exit code.
    let r = exec_with_status(cmd)
    let _rc = to_int(r[1])

    let stdout_body = read_file("/tmp/electrode_adj_out.log")
    let stderr_body = read_file("/tmp/electrode_adj_err.log")

    if stderr_body != "" {
        eprintln(stderr_body.trim())
    }

    _render_ascii_map(stdout_body, step_n)
    _list_actions(stdout_body, step_n)
    _print_summary(stdout_body)
    return _rc
}

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/electrode_adjustment_helper.hexa --selftest")
    eprintln("       hexa run anima-eeg/electrode_adjustment_helper.hexa --check [--port <p>] [--step <n>]")
    eprintln("       hexa run anima-eeg/electrode_adjustment_helper.hexa --watch [--port <p>]")
    eprintln("       hexa run anima-eeg/electrode_adjustment_helper.hexa --live  [--port <p>]")
    eprintln("flags:")
    eprintln("  --selftest        synthetic 16ch all-OK ASCII demo")
    eprintln("  --check           one-shot real check (with --step N for progressive)")
    eprintln("  --watch           periodic loop with full check, 5s tick")
    eprintln("  --live            REAL-TIME touch detector — finger touch shows on ASCII as [●]")
    eprintln("  --port <path>     Dongle serial node (auto-detect if omitted)")
    eprintln("  --seconds <n>     sample window per tick (default 3)")
    eprintln("  --step <n>        progressive scope: check first n items (1-18)")
    eprintln("  --board <name>    cyton_daisy | cyton | ganglion (default cyton_daisy)")
    eprintln("  --help            this message")
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut check_mode = false
    let mut watch_mode = false
    let mut live_mode = false
    let mut want_help = false
    let mut port = ""
    let mut seconds = DEFAULT_SECONDS
    let mut board_name = DEFAULT_BOARD_NAME
    let mut step_n = len(STEP_ORDER)  // default: check all 18

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--check"    { check_mode = true; i = i + 1; continue }
        if a == "--watch"    { watch_mode = true; i = i + 1; continue }
        if a == "--live"     { live_mode = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--port" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--port requires a value", "1) re-run with --port <path>")
                exit(2)
            }
            port = av[i + 1]; i = i + 2; continue
        }
        if a == "--seconds" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--seconds requires int", "1) re-run with --seconds 3")
                exit(2)
            }
            seconds = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--step" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--step requires int 1-18", "1) --step 1")
                exit(2)
            }
            step_n = to_int(av[i + 1])
            if step_n < 1 { step_n = 1 }
            if step_n > len(STEP_ORDER) { step_n = len(STEP_ORDER) }
            i = i + 2; continue
        }
        if a == "--board" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--board requires value", "1) --board cyton_daisy")
                exit(2)
            }
            board_name = av[i + 1]; i = i + 2; continue
        }
        _emit_trailer("unknown-arg", "unrecognized: " + a, "1) --help")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }
    if !selftest && !check_mode && !watch_mode && !live_mode {
        eprintln("ABORT: must pass --selftest | --check | --watch | --live")
        _print_usage()
        exit(2)
    }

    _write_helper()

    let board_id = _board_name_to_id(board_name)
    if board_id < 0 {
        _emit_trailer("invalid-board", "unknown: " + board_name, "1) --board cyton_daisy")
        exit(2)
    }

    println("══════════════════════════════════════════════════")
    println("  anima-eeg electrode_adjustment_helper")
    println("  schema: " + SCHEMA)
    if selftest {
        println("  mode: selftest (synthetic)")
    } else {
        println("  mode: " + (if watch_mode { "watch (loop)" } else { "check (one-shot)" }))
        println("  port: " + port)
    }
    println("  step: " + str(step_n) + "/" + str(len(STEP_ORDER)))
    if step_n <= len(STEP_ORDER) {
        let mut scope_str = ""
        let mut k = 0
        while k < step_n {
            if k > 0 { scope_str = scope_str + ", " }
            scope_str = scope_str + STEP_ORDER[k]
            k = k + 1
        }
        println("  scope: " + scope_str)
    }
    println("══════════════════════════════════════════════════")

    if live_mode {
        // Live touch detector — single BrainFlow session in helper.py, internal loop + ANSI render.
        // Hexa wrapper just invokes helper directly (foreground, passes through to terminal).
        let venv_py = DEFAULT_VENV_PYTHON
        let mut cmd = venv_py + " " + HELPER_PATH + " live"
        cmd = cmd + " --board-id " + str(board_id)
        if port != "" {
            cmd = cmd + " --port " + _sh_quote(port)
        }
        // raw#91 C3 + audit 2026-04-28: exec() returns string; exit() needs int.
        let r = exec_with_status(cmd)
        exit(to_int(r[1]))
    } else if watch_mode {
        let mut tick = 0
        while true {
            tick = tick + 1
            println("")
            println("─── tick #" + str(tick) + " ───")
            let _rc = _do_one_pass(board_id, port, seconds, false, step_n)
            println("    (" + str(DEFAULT_WATCH_INTERVAL_SEC) + "s 후 다시 측정. Ctrl-C 로 종료)")
            sleep(DEFAULT_WATCH_INTERVAL_SEC)
        }
    } else {
        let rc = _do_one_pass(board_id, port, seconds, selftest, step_n)
        exit(rc)
    }
}
