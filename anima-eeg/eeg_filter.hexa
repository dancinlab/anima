// anima-eeg/eeg_filter.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#15 no-personal-paths · raw#34 no-backup-files · raw#37 transient-helper-in-/tmp
// raw#65 idempotent · raw#66 ai-native error trailer · raw#71 falsifier-bound
// raw#80 sentinel · raw#82 darwin-native marker · raw#91 honest-class
//
// PURPOSE
//   Standalone EEG filter chain module. Wraps BrainFlow `DataFilter`
//   primitives so analysis protocols (eye_blink_detect / jaw_clench_emg /
//   ppg_heart_rate / alpha_eyes_closed) consume FILTERED signal, not raw.
//
//   Direct response to OpenBCI Berger fail root cause #4 (audit
//   2026-05-03): collect.hexa stores raw 16ch float32; downstream
//   analyses ran filter-less and Berger α failed because DC drift,
//   60 Hz line noise, and high-frequency noise were never removed.
//
//   OpenBCI standard filter chain (ko grid):
//     1) Bandpass 0.5-45 Hz Butterworth order-4
//     2) 60 Hz environmental noise notch
//   EU variant uses 50 Hz notch.
//
// API (callable as subprocess CLI, also synthesized via .venv-eeg):
//   apply_bandpass(signal, fs, lo_hz, hi_hz, order)
//   apply_notch(signal, fs, notch_hz)
//   filter_chain(signal, fs)            # default 0.5-45 BP + 60 notch
//   filter_chain_eu(signal, fs)         # 0.5-45 BP + 50 notch
//
// USAGE
//   hexa run anima-eeg/eeg_filter.hexa --selftest
//   hexa run anima-eeg/eeg_filter.hexa --filter --input raw.npy --output filt.npy
//   hexa run anima-eeg/eeg_filter.hexa --filter --input raw.npy --output filt.npy --grid eu
//   hexa run anima-eeg/eeg_filter.hexa --inline --signal-stdin --fs 125
//
// SAFETY
//   - read-only against --input; --output may be overwritten (raw#65 idempotent)
//   - no sudo
//   - selftest synthesizes its own signal in /tmp (raw#37 transient)
//
// HONEST C3 (raw#10)
//   1) Butterworth order-4 introduces phase distortion. We use the
//      forward-only `DataFilter.perform_bandpass` (causal, single-pass);
//      this means a frequency-dependent group delay (~order/(2*fs) at
//      band edges, larger near cutoff). For pre-recorded analysis a
//      zero-phase filtfilt would be preferable, but BrainFlow's
//      perform_bandpass is single-direction. Live closed-loop callers
//      MUST account for the latency.
//   2) `remove_environmental_noise` uses BrainFlow's IIR notch with
//      fixed Q (~30); attenuation depth depends on signal length and
//      sample rate. We require >= 40 dB at 60.0 Hz on a stationary
//      synthetic test — broadband line drift around the notch may not
//      meet the spec on real recordings (raw#10).
//   3) Bandpass 0.5 Hz lower cutoff is borderline for slow EEG features
//      (delta band 0.5-4 Hz); the order-4 roll-off attenuates valid
//      delta content near 0.5 Hz. Callers analyzing slow waves should
//      explicitly pass a lower lo_hz (e.g. 0.1) and accept more drift.
//
//  @resolver-bypass(reason="darwin-native: invokes .venv-eeg/bin/python
//                   which is a mac-local virtualenv hosting BrainFlow
//                   DataFilter. Linux pods do not expose this venv;
//                   external dispatch yields silent no-op. selftest is
//                   pure-helper so works wherever .venv-eeg + brainflow
//                   are present (Darwin host today).")

let SCHEMA            = "anima-eeg/eeg_filter/1"
let HELPER_PATH       = "/tmp/anima_eeg_filter_helper.hexa_tmp"

// ════════════════════════════════════════════════════════════════════
// Frozen filter chain defaults (raw#12)
// ════════════════════════════════════════════════════════════════════

let DEFAULT_BANDPASS_LO_HZ  = 0.5
let DEFAULT_BANDPASS_HI_HZ  = 45.0
let DEFAULT_BANDPASS_ORDER  = 4
let DEFAULT_NOTCH_KO_HZ     = 60.0       // Korea / North America grid
let DEFAULT_NOTCH_EU_HZ     = 50.0       // Europe / Asia (50 Hz)
let DEFAULT_VENV_PYTHON     = ".venv-eeg/bin/python"

// Falsifier thresholds (raw#71 pre-registered)
let F_FILTER_01_LINE_ATTEN_DB_MIN = 40.0   // 60 Hz attenuation depth >= 40 dB
let F_FILTER_02_DC_ATTEN_DB_MIN   = 20.0   // 0.1 Hz DC drift attenuated >= 20 dB
let F_FILTER_03_HF_ATTEN_DB_MIN   = 20.0   // 100 Hz attenuation >= 20 dB

// Synthetic selftest signal parameters
let SELFTEST_FS_HZ          = 250
let SELFTEST_DURATION_S     = 4
let SELFTEST_EEG_BAND_HZ    = 10.0       // alpha-band carrier
let SELFTEST_EEG_AMP_UV     = 20.0       // realistic α amplitude
let SELFTEST_LINE_AMP_UV    = 50.0       // 60 Hz line contamination
let SELFTEST_HF_FREQ_HZ     = 100.0      // out-of-band high freq
let SELFTEST_HF_AMP_UV      = 30.0
let SELFTEST_DC_AMP_UV      = 100.0      // DC drift / very low freq

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

// ════════════════════════════════════════════════════════════════════
// Helper python emitter (raw#37 transient)
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima-eeg eeg_filter helper — emitted by\n")
    parts.push("# anima-eeg/eeg_filter.hexa (raw#37 transient).\n")
    parts.push("import argparse, json, math, os, subprocess, sys, textwrap\n\n")

    parts.push("VENV_PYTHON = '" + DEFAULT_VENV_PYTHON + "'\n")
    parts.push("DEFAULT_BP_LO = " + to_string(DEFAULT_BANDPASS_LO_HZ) + "\n")
    parts.push("DEFAULT_BP_HI = " + to_string(DEFAULT_BANDPASS_HI_HZ) + "\n")
    parts.push("DEFAULT_BP_ORDER = " + to_string(DEFAULT_BANDPASS_ORDER) + "\n")
    parts.push("DEFAULT_NOTCH_KO = " + to_string(DEFAULT_NOTCH_KO_HZ) + "\n")
    parts.push("DEFAULT_NOTCH_EU = " + to_string(DEFAULT_NOTCH_EU_HZ) + "\n")
    parts.push("F_LINE_ATTEN_DB_MIN = " + to_string(F_FILTER_01_LINE_ATTEN_DB_MIN) + "\n")
    parts.push("F_DC_ATTEN_DB_MIN   = " + to_string(F_FILTER_02_DC_ATTEN_DB_MIN) + "\n")
    parts.push("F_HF_ATTEN_DB_MIN   = " + to_string(F_FILTER_03_HF_ATTEN_DB_MIN) + "\n")
    parts.push("SELFTEST_FS         = " + to_string(SELFTEST_FS_HZ) + "\n")
    parts.push("SELFTEST_SECONDS    = " + to_string(SELFTEST_DURATION_S) + "\n")
    parts.push("SELFTEST_EEG_HZ     = " + to_string(SELFTEST_EEG_BAND_HZ) + "\n")
    parts.push("SELFTEST_EEG_AMP    = " + to_string(SELFTEST_EEG_AMP_UV) + "\n")
    parts.push("SELFTEST_LINE_AMP   = " + to_string(SELFTEST_LINE_AMP_UV) + "\n")
    parts.push("SELFTEST_HF_HZ      = " + to_string(SELFTEST_HF_FREQ_HZ) + "\n")
    parts.push("SELFTEST_HF_AMP     = " + to_string(SELFTEST_HF_AMP_UV) + "\n")
    parts.push("SELFTEST_DC_AMP     = " + to_string(SELFTEST_DC_AMP_UV) + "\n\n")

    parts.push("def emit_trailer(slug, detail, fix):\n")
    parts.push("    sys.stderr.write(f'reason: {slug}: {detail}\\n')\n")
    parts.push("    sys.stderr.write(f'fix: {fix}\\n')\n\n")

    parts.push("def verify_brainflow():\n")
    parts.push("    if not os.path.exists(VENV_PYTHON):\n")
    parts.push("        emit_trailer('venv-missing',\n")
    parts.push("                     f'{VENV_PYTHON} not found',\n")
    parts.push("                     '1) python3 -m venv .venv-eeg  '\n")
    parts.push("                     '2) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '3) pip install --upgrade brainflow numpy')\n")
    parts.push("        return False\n")
    parts.push("    _probe_src = (\n")
    parts.push("        'from brainflow.data_filter import DataFilter, FilterTypes, NoiseTypes\\n'\n")
    parts.push("        'import numpy as _np\\n'\n")
    parts.push("        'print(\"ok\")\\n'\n")
    parts.push("    )\n")
    parts.push("    r = subprocess.run([VENV_PYTHON, '-c', _probe_src],\n")
    parts.push("                       capture_output=True, text=True, timeout=20)\n")
    parts.push("    if r.returncode != 0:\n")
    parts.push("        emit_trailer('brainflow-missing',\n")
    parts.push("                     f'brainflow import failed: {r.stderr.strip()[:200]}',\n")
    parts.push("                     '1) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '2) pip install --upgrade brainflow numpy')\n")
    parts.push("        return False\n")
    parts.push("    return True\n\n")

    // ─── filter execution payload (runs inside .venv-eeg python) ────
    // raw#10 honest C3: use r'''...''' so embedded \n stay as 2-char escape.
    parts.push("FILTER_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, sys\n")
    parts.push("    import numpy as np\n")
    parts.push("    from brainflow.data_filter import DataFilter, FilterTypes, NoiseTypes\n")
    parts.push("    INPUT  = sys.argv[1]\n")
    parts.push("    OUTPUT = sys.argv[2]\n")
    parts.push("    FS     = float(sys.argv[3])\n")
    parts.push("    LO     = float(sys.argv[4])\n")
    parts.push("    HI     = float(sys.argv[5])\n")
    parts.push("    ORDER  = int(sys.argv[6])\n")
    parts.push("    NOTCH  = sys.argv[7]   # 'ko' | 'eu' | 'none'\n")
    parts.push("    arr = np.load(INPUT)\n")
    parts.push("    if arr.ndim == 1:\n")
    parts.push("        arr = arr.reshape(1, -1)\n")
    parts.push("    # BrainFlow DataFilter expects float64 contiguous; per-channel.\n")
    parts.push("    out = np.ascontiguousarray(arr.astype(np.float64))\n")
    parts.push("    # apply_bandpass: Butterworth, ripple=0 (no ripple for Butterworth)\n")
    parts.push("    for ch in range(out.shape[0]):\n")
    parts.push("        DataFilter.perform_bandpass(out[ch], int(FS), LO, HI, ORDER, FilterTypes.BUTTERWORTH.value, 0)\n")
    parts.push("    if NOTCH == 'ko':\n")
    parts.push("        for ch in range(out.shape[0]):\n")
    parts.push("            DataFilter.remove_environmental_noise(out[ch], int(FS), NoiseTypes.SIXTY.value)\n")
    parts.push("    elif NOTCH == 'eu':\n")
    parts.push("        for ch in range(out.shape[0]):\n")
    parts.push("            DataFilter.remove_environmental_noise(out[ch], int(FS), NoiseTypes.FIFTY.value)\n")
    parts.push("    np.save(OUTPUT, out.astype(np.float32))\n")
    parts.push("    meta = {'rows': int(out.shape[0]), 'cols': int(out.shape[1]),\n")
    parts.push("            'fs': FS, 'lo': LO, 'hi': HI, 'order': ORDER, 'notch': NOTCH}\n")
    parts.push("    print(json.dumps(meta))\n")
    parts.push("''')\n\n")

    // ─── Selftest payload: synthesize, filter, evaluate falsifiers ──
    parts.push("SELFTEST_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, math, sys\n")
    parts.push("    import numpy as np\n")
    parts.push("    from brainflow.data_filter import DataFilter, FilterTypes, NoiseTypes\n")
    parts.push("    FS         = int(sys.argv[1])\n")
    parts.push("    SECONDS    = int(sys.argv[2])\n")
    parts.push("    BP_LO      = float(sys.argv[3])\n")
    parts.push("    BP_HI      = float(sys.argv[4])\n")
    parts.push("    BP_ORDER   = int(sys.argv[5])\n")
    parts.push("    NOTCH_HZ   = float(sys.argv[6])\n")
    parts.push("    EEG_HZ     = float(sys.argv[7])\n")
    parts.push("    EEG_AMP    = float(sys.argv[8])\n")
    parts.push("    LINE_AMP   = float(sys.argv[9])\n")
    parts.push("    HF_HZ      = float(sys.argv[10])\n")
    parts.push("    HF_AMP     = float(sys.argv[11])\n")
    parts.push("    DC_AMP     = float(sys.argv[12])\n")
    parts.push("    F_LINE_ATTEN_DB_MIN = float(sys.argv[13])\n")
    parts.push("    F_DC_ATTEN_DB_MIN   = float(sys.argv[14])\n")
    parts.push("    F_HF_ATTEN_DB_MIN   = float(sys.argv[15])\n")
    parts.push("    n = FS * SECONDS\n")
    parts.push("    t = np.arange(n) / float(FS)\n")
    parts.push("    # composite synthetic: EEG α + 60 Hz line + 100 Hz HF + DC drift\n")
    parts.push("    eeg_band = EEG_AMP * np.sin(2*math.pi*EEG_HZ*t)\n")
    parts.push("    line     = LINE_AMP * np.sin(2*math.pi*NOTCH_HZ*t)\n")
    parts.push("    hf       = HF_AMP   * np.sin(2*math.pi*HF_HZ*t)\n")
    parts.push("    dc       = DC_AMP   * np.ones_like(t)  # pure DC\n")
    parts.push("    raw = (eeg_band + line + hf + dc).astype(np.float64)\n")
    parts.push("    raw_in = np.ascontiguousarray(raw.copy())\n")
    parts.push("    # FFT helper for attenuation measurement\n")
    parts.push("    def amp_at(sig, freq):\n")
    parts.push("        win = np.hanning(len(sig))\n")
    parts.push("        sp  = np.fft.rfft(sig * win)\n")
    parts.push("        fr  = np.fft.rfftfreq(len(sig), 1.0/FS)\n")
    parts.push("        idx = int(np.argmin(np.abs(fr - freq)))\n")
    parts.push("        return float(np.abs(sp[idx])) + 1e-12\n")
    parts.push("    def db(a_in, a_out):\n")
    parts.push("        return 20.0 * math.log10((a_in + 1e-12) / (a_out + 1e-12))\n")
    parts.push("    # measurement: input amplitudes\n")
    parts.push("    a_in_eeg  = amp_at(raw_in, EEG_HZ)\n")
    parts.push("    a_in_line = amp_at(raw_in, NOTCH_HZ)\n")
    parts.push("    a_in_hf   = amp_at(raw_in, HF_HZ)\n")
    parts.push("    # for DC: measure amplitude at 0 Hz bin (mean component)\n")
    parts.push("    dc_in     = float(abs(np.mean(raw_in))) + 1e-12\n")
    parts.push("    # apply chain\n")
    parts.push("    out = np.ascontiguousarray(raw.copy())\n")
    parts.push("    DataFilter.perform_bandpass(out, FS, BP_LO, BP_HI, BP_ORDER, FilterTypes.BUTTERWORTH.value, 0)\n")
    parts.push("    if abs(NOTCH_HZ - 60.0) < 0.01:\n")
    parts.push("        DataFilter.remove_environmental_noise(out, FS, NoiseTypes.SIXTY.value)\n")
    parts.push("    elif abs(NOTCH_HZ - 50.0) < 0.01:\n")
    parts.push("        DataFilter.remove_environmental_noise(out, FS, NoiseTypes.FIFTY.value)\n")
    parts.push("    a_out_eeg  = amp_at(out, EEG_HZ)\n")
    parts.push("    a_out_line = amp_at(out, NOTCH_HZ)\n")
    parts.push("    a_out_hf   = amp_at(out, HF_HZ)\n")
    parts.push("    dc_out     = float(abs(np.mean(out))) + 1e-12\n")
    parts.push("    eeg_atten_db  = db(a_in_eeg,  a_out_eeg)   # ~ 0 dB ideal (band passed)\n")
    parts.push("    line_atten_db = db(a_in_line, a_out_line)  # F_FILTER_01 target >= 40 dB\n")
    parts.push("    dc_atten_db   = db(dc_in,     dc_out)      # F_FILTER_02 target >= 20 dB\n")
    parts.push("    hf_atten_db   = db(a_in_hf,   a_out_hf)    # F_FILTER_03 target >= 20 dB\n")
    parts.push("    # Falsifier verdicts\n")
    parts.push("    f01_pass = bool(line_atten_db >= F_LINE_ATTEN_DB_MIN)\n")
    parts.push("    f02_pass = bool(dc_atten_db   >= F_DC_ATTEN_DB_MIN)\n")
    parts.push("    f03_pass = bool(hf_atten_db   >= F_HF_ATTEN_DB_MIN)\n")
    parts.push("    eeg_preserved = bool(abs(eeg_atten_db) < 6.0)  # in-band loss < 6 dB\n")
    parts.push("    overall = bool(f01_pass and f02_pass and f03_pass and eeg_preserved)\n")
    parts.push("    out_obj = {\n")
    parts.push("        'rc': 0,\n")
    parts.push("        'fs': FS, 'seconds': SECONDS, 'n': int(n),\n")
    parts.push("        'eeg_atten_db':  round(eeg_atten_db,  3),\n")
    parts.push("        'line_atten_db': round(line_atten_db, 3),\n")
    parts.push("        'dc_atten_db':   round(dc_atten_db,   3),\n")
    parts.push("        'hf_atten_db':   round(hf_atten_db,   3),\n")
    parts.push("        'f01_pass': f01_pass, 'f02_pass': f02_pass, 'f03_pass': f03_pass,\n")
    parts.push("        'eeg_preserved': eeg_preserved,\n")
    parts.push("        'overall': overall,\n")
    parts.push("    }\n")
    parts.push("    print(json.dumps(out_obj))\n")
    parts.push("''')\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('schema=' + '" + SCHEMA + "')\n")
    parts.push("    print('venv_python_exists=' + str(os.path.exists(VENV_PYTHON)))\n")
    parts.push("    if not verify_brainflow():\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    notch = DEFAULT_NOTCH_KO if args.grid == 'ko' else DEFAULT_NOTCH_EU\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', SELFTEST_PY,\n")
    parts.push("           str(SELFTEST_FS), str(SELFTEST_SECONDS),\n")
    parts.push("           str(DEFAULT_BP_LO), str(DEFAULT_BP_HI), str(DEFAULT_BP_ORDER),\n")
    parts.push("           str(notch),\n")
    parts.push("           str(SELFTEST_EEG_HZ), str(SELFTEST_EEG_AMP),\n")
    parts.push("           str(SELFTEST_LINE_AMP),\n")
    parts.push("           str(SELFTEST_HF_HZ), str(SELFTEST_HF_AMP),\n")
    parts.push("           str(SELFTEST_DC_AMP),\n")
    parts.push("           str(F_LINE_ATTEN_DB_MIN), str(F_DC_ATTEN_DB_MIN), str(F_HF_ATTEN_DB_MIN)]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)\n")
    parts.push("    if r.returncode != 0 or not r.stdout.strip():\n")
    parts.push("        emit_trailer('selftest-subprocess-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) verify .venv-eeg brainflow + numpy installed  '\n")
    parts.push("                     '2) re-run')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        m = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('selftest-parse-failed',\n")
    parts.push("                     f'could not parse helper output: {exc!r}; raw={r.stdout[-200:]!r}',\n")
    parts.push("                     '1) re-run; if persistent, inspect helper python')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    print(f'fs={m[\"fs\"]}  seconds={m[\"seconds\"]}  n_samples={m[\"n\"]}')\n")
    parts.push("    print(f'eeg_band_atten_db={m[\"eeg_atten_db\"]}  (target ~0, |.|<6 dB)')\n")
    parts.push("    print(f'line_atten_db={m[\"line_atten_db\"]}    (target >= {F_LINE_ATTEN_DB_MIN})')\n")
    parts.push("    print(f'dc_atten_db={m[\"dc_atten_db\"]}        (target >= {F_DC_ATTEN_DB_MIN})')\n")
    parts.push("    print(f'hf_atten_db={m[\"hf_atten_db\"]}        (target >= {F_HF_ATTEN_DB_MIN})')\n")
    parts.push("    f01 = 'PASS' if m['f01_pass'] else 'FAIL'\n")
    parts.push("    f02 = 'PASS' if m['f02_pass'] else 'FAIL'\n")
    parts.push("    f03 = 'PASS' if m['f03_pass'] else 'FAIL'\n")
    parts.push("    eegk= 'PASS' if m['eeg_preserved'] else 'FAIL'\n")
    parts.push("    print(f'F_FILTER_01_line60: {f01}')\n")
    parts.push("    print(f'F_FILTER_02_dc:     {f02}')\n")
    parts.push("    print(f'F_FILTER_03_hf100:  {f03}')\n")
    parts.push("    print(f'eeg_band_preserved: {eegk}')\n")
    parts.push("    overall = 'PASS' if m['overall'] else 'FAIL'\n")
    parts.push("    print(f'selftest={overall.lower()}')\n")
    parts.push("    print(f'__EEG_FILTER__ {overall} {m[\"line_atten_db\"]:.2f} {m[\"dc_atten_db\"]:.2f}')\n")
    parts.push("    sys.exit(0 if m['overall'] else 1)\n\n")

    parts.push("def cmd_filter(args):\n")
    parts.push("    if not os.path.exists(args.input):\n")
    parts.push("        emit_trailer('input-missing',\n")
    parts.push("                     f'--input {args.input} not found',\n")
    parts.push("                     '1) verify path; .npy file from collect.hexa')\n")
    parts.push("        print('__EEG_FILTER__ FAIL 0.00 0.00')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not verify_brainflow():\n")
    parts.push("        print('__EEG_FILTER__ FAIL 0.00 0.00')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    notch = 'ko' if args.grid == 'ko' else ('eu' if args.grid == 'eu' else 'none')\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', FILTER_PY,\n")
    parts.push("           args.input, args.output,\n")
    parts.push("           str(args.fs), str(args.lo), str(args.hi), str(args.order), notch]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)\n")
    parts.push("    if r.returncode != 0 or not r.stdout.strip():\n")
    parts.push("        emit_trailer('filter-subprocess-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) check input npy shape (1-D or 2-D channels x samples)  '\n")
    parts.push("                     '2) verify fs matches recorded data')\n")
    parts.push("        print('__EEG_FILTER__ FAIL 0.00 0.00')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        meta = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('filter-parse-failed',\n")
    parts.push("                     f'could not parse helper output: {exc!r}',\n")
    parts.push("                     '1) re-run; check brainflow version')\n")
    parts.push("        print('__EEG_FILTER__ FAIL 0.00 0.00')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    print(f'rows={meta[\"rows\"]} cols={meta[\"cols\"]}')\n")
    parts.push("    print(f'fs={meta[\"fs\"]} lo={meta[\"lo\"]} hi={meta[\"hi\"]} order={meta[\"order\"]} notch={meta[\"notch\"]}')\n")
    parts.push("    print(f'output={args.output}')\n")
    parts.push("    print(f'filter=ok')\n")
    parts.push("    print(f'__EEG_FILTER__ PASS line=applied dc=applied')\n")
    parts.push("    sys.exit(0)\n\n")

    parts.push("def cmd_inline(args):\n")
    parts.push("    # Read float32 LE samples from stdin (single channel), filter, write stdout.\n")
    parts.push("    if not verify_brainflow():\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    import numpy as _np\n")
    parts.push("    raw_bytes = sys.stdin.buffer.read()\n")
    parts.push("    if len(raw_bytes) == 0:\n")
    parts.push("        emit_trailer('inline-empty-stdin',\n")
    parts.push("                     'no bytes received on stdin',\n")
    parts.push("                     '1) pipe float32 little-endian samples on stdin')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    arr = _np.frombuffer(raw_bytes, dtype=_np.float32).astype(_np.float64).copy()\n")
    parts.push("    if arr.size == 0:\n")
    parts.push("        emit_trailer('inline-zero-samples',\n")
    parts.push("                     'stdin decoded to 0 samples',\n")
    parts.push("                     '1) verify byte alignment to float32')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    from brainflow.data_filter import DataFilter, FilterTypes, NoiseTypes\n")
    parts.push("    arr = _np.ascontiguousarray(arr)\n")
    parts.push("    DataFilter.perform_bandpass(arr, int(args.fs), args.lo, args.hi, args.order, FilterTypes.BUTTERWORTH.value, 0)\n")
    parts.push("    if args.grid == 'ko':\n")
    parts.push("        DataFilter.remove_environmental_noise(arr, int(args.fs), NoiseTypes.SIXTY.value)\n")
    parts.push("    elif args.grid == 'eu':\n")
    parts.push("        DataFilter.remove_environmental_noise(arr, int(args.fs), NoiseTypes.FIFTY.value)\n")
    parts.push("    sys.stdout.buffer.write(arr.astype(_np.float32).tobytes())\n")
    parts.push("    sys.exit(0)\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    s = sub.add_parser('selftest')\n")
    parts.push("    s.add_argument('--grid', default='ko', choices=['ko','eu'])\n")
    parts.push("    f = sub.add_parser('filter')\n")
    parts.push("    f.add_argument('--input', required=True)\n")
    parts.push("    f.add_argument('--output', required=True)\n")
    parts.push("    f.add_argument('--fs', type=int, default=125)\n")
    parts.push("    f.add_argument('--lo', type=float, default=DEFAULT_BP_LO)\n")
    parts.push("    f.add_argument('--hi', type=float, default=DEFAULT_BP_HI)\n")
    parts.push("    f.add_argument('--order', type=int, default=DEFAULT_BP_ORDER)\n")
    parts.push("    f.add_argument('--grid', default='ko', choices=['ko','eu','none'])\n")
    parts.push("    i = sub.add_parser('inline')\n")
    parts.push("    i.add_argument('--fs', type=int, default=125)\n")
    parts.push("    i.add_argument('--lo', type=float, default=DEFAULT_BP_LO)\n")
    parts.push("    i.add_argument('--hi', type=float, default=DEFAULT_BP_HI)\n")
    parts.push("    i.add_argument('--order', type=int, default=DEFAULT_BP_ORDER)\n")
    parts.push("    i.add_argument('--grid', default='ko', choices=['ko','eu','none'])\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest': cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'filter': cmd_filter(args)\n")
    parts.push("    elif args.cmd == 'inline': cmd_inline(args)\n")
    parts.push("    else: sys.exit(2)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/eeg_filter.hexa --selftest [--grid ko|eu]")
    eprintln("       hexa run anima-eeg/eeg_filter.hexa --filter --input <npy> --output <npy>")
    eprintln("                                          [--fs 125] [--lo 0.5] [--hi 45] [--order 4] [--grid ko|eu|none]")
    eprintln("       hexa run anima-eeg/eeg_filter.hexa --inline --signal-stdin [--fs 125] [--grid ko|eu|none]")
    eprintln("flags:")
    eprintln("  --selftest          synthesize signal, verify F_FILTER_01/02/03")
    eprintln("  --filter            file-based: read --input npy, write filtered --output npy")
    eprintln("  --inline            stream: read float32 LE on stdin, write float32 LE on stdout")
    eprintln("  --signal-stdin      explicit marker for --inline (raw#10 honest: no-op flag)")
    eprintln("  --input <path>      input .npy (1-D or 2-D channels x samples)")
    eprintln("  --output <path>     output .npy (float32; raw#65 idempotent overwrite)")
    eprintln("  --fs <int>          sample rate Hz (default 125; Cyton+Daisy 16ch)")
    eprintln("  --lo <float>        bandpass low cut Hz (default 0.5)")
    eprintln("  --hi <float>        bandpass high cut Hz (default 45.0)")
    eprintln("  --order <int>       Butterworth order (default 4)")
    eprintln("  --grid ko|eu|none   notch: 60 Hz (ko/NA) | 50 Hz (eu) | skip (default ko)")
    eprintln("  --help              this message")
}

fn main() {
    let av = argv()
    let mut want_selftest = false
    let mut want_filter   = false
    let mut want_inline   = false
    let mut want_help     = false
    let mut input_path    = ""
    let mut output_path   = ""
    let mut fs            = 125
    let mut lo            = DEFAULT_BANDPASS_LO_HZ
    let mut hi            = DEFAULT_BANDPASS_HI_HZ
    let mut order         = DEFAULT_BANDPASS_ORDER
    let mut grid          = "ko"

    // hexa-strict: user args begin at index 2
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"     { want_selftest = true; i = i + 1; continue }
        if a == "--filter"       { want_filter   = true; i = i + 1; continue }
        if a == "--inline"       { want_inline   = true; i = i + 1; continue }
        if a == "--signal-stdin" { want_inline   = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--input requires a path",
                              "1) re-run with --input <path.npy>")
                exit(2)
            }
            input_path = av[i + 1]; i = i + 2; continue
        }
        if a == "--output" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--output requires a path",
                              "1) re-run with --output <path.npy>")
                exit(2)
            }
            output_path = av[i + 1]; i = i + 2; continue
        }
        if a == "--fs" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--fs requires an integer Hz",
                              "1) re-run with --fs 125")
                exit(2)
            }
            fs = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--lo" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--lo requires a float Hz",
                              "1) re-run with --lo 0.5")
                exit(2)
            }
            lo = to_float(av[i + 1]); i = i + 2; continue
        }
        if a == "--hi" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--hi requires a float Hz",
                              "1) re-run with --hi 45")
                exit(2)
            }
            hi = to_float(av[i + 1]); i = i + 2; continue
        }
        if a == "--order" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--order requires an integer",
                              "1) re-run with --order 4")
                exit(2)
            }
            order = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--grid" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--grid requires ko|eu|none",
                              "1) re-run with --grid ko")
                exit(2)
            }
            grid = av[i + 1]; i = i + 2; continue
        }
        _emit_trailer("unknown-arg",
                      "unrecognized argument: " + a,
                      "1) re-run with --help to see flags  2) drop the unknown arg")
        _print_usage()
        exit(2)
    }

    if want_help {
        _print_usage()
        exit(0)
    }

    // raw#65 idempotent: emit helper every run; /tmp transient
    _write_helper()

    if want_selftest {
        println("== eeg_filter selftest (synthetic) ==")
        let mut a = "selftest --grid " + _sh_quote(grid)
        let r = _run_helper(a)
        println(r[0])
        exit(r[1])
    }

    if want_filter {
        if input_path == "" || output_path == "" {
            _emit_trailer("missing-required-arg",
                          "--filter requires both --input and --output",
                          "1) re-run with --input raw.npy --output filt.npy")
            _print_usage()
            exit(2)
        }
        let mut a = "filter --input " + _sh_quote(input_path) +
                    " --output " + _sh_quote(output_path) +
                    " --fs " + to_string(fs) +
                    " --lo " + to_string(lo) +
                    " --hi " + to_string(hi) +
                    " --order " + to_string(order) +
                    " --grid " + _sh_quote(grid)
        let r = _run_helper(a)
        println(r[0])
        exit(r[1])
    }

    if want_inline {
        let mut a = "inline --fs " + to_string(fs) +
                    " --lo " + to_string(lo) +
                    " --hi " + to_string(hi) +
                    " --order " + to_string(order) +
                    " --grid " + _sh_quote(grid)
        let r = _run_helper(a)
        // inline mode is bytes-on-stdout; helper exits with rc only
        exit(r[1])
    }

    // No mode selected — show usage
    _print_usage()
    exit(2)
}
// hexa-strict auto-invokes fn main() — do not call main() explicitly.
