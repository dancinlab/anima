// anima-eeg/protocols/background_quality_audit.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#15 no-personal-paths · raw#34 no-backup-files · raw#37 transient-helper-in-/tmp
// raw#65 idempotent (append-only ledger) · raw#66 ai-native error trailer
// raw#71 falsifier-bound · raw#80 sentinel · raw#82 darwin-bypass · raw#91 honest-class
//
// @resolver-bypass(reason="darwin-bypass: silent quality monitor that runs
//                   alongside an active EEG capture session. Reads .npy +
//                   .meta.json sidecars (collect.hexa convention), computes
//                   impedance drift / rail-flat / DC drift / 60Hz line /
//                   effective-fs metrics, appends to an append-only JSONL
//                   ledger under state/quality_ledger/<YYYY-MM>.jsonl. Helper
//                   python invoked is /tmp transient (raw#37). Selftest is
//                   fully synthetic numpy + tempfile and runs on Darwin host.")
//
// PURPOSE  (raw#106 genus name)
//   Background silent quality audit module — Phase 2 prototype.
//   Two operating modes:
//     • --watch      : infinite loop, audit every --interval seconds,
//                      stdout = JSONL only (no user-facing chatter),
//                      Ctrl-C 측 graceful exit.
//     • --audit-once : single-shot audit on a captured .npy artifact.
//   In both modes, alerts are appended to an append-only JSONL ledger
//   (one row per metric breach). The user is NOT interrupted unless
//   --audio-alert is supplied AND a CRITICAL breach is observed.
//
//   Sister modules (separate cycles, NO touch in this file):
//     • protocols/cap_fit_verify.hexa             — pre-session impedance
//     • protocols/sample_rate_guard.hexa          — duration/cols/fs gate
//     • protocols/package_num_audit.hexa          — package_num drop audit
//     • anima-eeg-core/_artifact/rail_flat_detector.hexa  — rail/flat onset
//
// API
//   hexa run anima-eeg/protocols/background_quality_audit.hexa --selftest
//
//   hexa run anima-eeg/protocols/background_quality_audit.hexa \
//        --audit-once --input <raw.npy> \
//        [--ledger-path <path>] [--session-id <id>]
//
//   hexa run anima-eeg/protocols/background_quality_audit.hexa \
//        --watch --port <serial-port> \
//        [--interval 300] [--ledger-path <path>] \
//        [--audio-alert] [--max-iterations <n>]
//
//   Ledger default: state/quality_ledger/<YYYY-MM>.jsonl  (raw#15)
//
// AUDIT METRICS  (per call)
//   1) impedance_drift  : |z_now - z_baseline| / z_baseline > 20%  → WARN
//                         > 50% → CRIT  (per channel)
//   2) channel_rail_flat: 30s short capture → rail_flat_detector;
//                         any rail/flat channel → WARN
//   3) dc_drift         : per-channel |mean| > 100 µV → WARN
//                         > 200 µV → CRIT
//   4) line_60hz_notch  : notch attenuation < 30 dB → WARN
//                         < 20 dB → CRIT
//   5) effective_fs     : cumulative cols/duration < 80% claimed → WARN
//                         < 50% → CRIT
//
// FALSIFIERS  (raw#71 frozen 2026-05-03)
//   F_BGQ_01: synthetic baseline → no alert emitted (silent OK)
//   F_BGQ_02: synthetic drift trigger → alert correctly emitted
//             (≥1 row in ledger with alert_level ∈ {WARN,CRIT})
//   F_BGQ_03: ledger row byte-stable across two identical calls
//             (idempotent re-write of the SAME synthetic input)
//
//   selftest passes when F_BGQ_01 AND F_BGQ_02 AND F_BGQ_03 all true.
//
// SENTINEL
//   __EEG_BACKGROUND_QUALITY_AUDIT__ <PASS|FAIL> <n_alerts> <ledger_path>
//
// LEDGER ROW SCHEMA  (raw#65 append-only, one row per metric breach)
//   {
//     "ts": "2026-05-03T20:00:00Z",
//     "session_id": "background_watch_20260503_2000",
//     "metric_type": "impedance_drift",
//     "channel": "Fp1",
//     "value": 25.8,
//     "baseline": 5.2,
//     "drift_pct": 396.0,
//     "alert_level": "WARN",
//     "advice": "Fp1 paste 보충 권장"
//   }
//
//   metric_type ∈ {impedance_drift, channel_rail_flat, dc_drift,
//                  line_60hz_notch, effective_fs}
//   alert_level ∈ {INFO, WARN, CRIT}
//
// HONEST C3 CAVEATS  (raw#10)
//   1. Silent monitoring 측 사용자 측 active 측 인지 X 가능 — 사용자 측
//      session 측 끝 측까지 alert 측 알림 X (audio-alert flag 측 opt-in).
//      → 사용자 측 ledger 측 manual review 측 책임 측 짊어진다.
//   2. impedance baseline 측 first audit 측 등록; 측정 시작 측 paste 측
//      stale 측 시 측 baseline 측 이미 high — drift % 측 deceptive.
//      → cap_fit_verify.hexa 측 pre-session 측 must run.
//   3. line_60hz_notch 측 estimate 측 notch filter 측 attenuation 측
//      proxy (band-power ratio); 50Hz region 측 EU 측 invalid.
//      → --line-hz 측 future flag (이번 cycle 측 60Hz hardcoded; KR/US OK).
//
// USAGE
//   # selftest (synthetic, no hardware required)
//   hexa run anima-eeg/protocols/background_quality_audit.hexa --selftest
//
//   # post-session single audit
//   hexa run anima-eeg/protocols/background_quality_audit.hexa \
//        --audit-once \
//        --input anima-eeg/recordings/sessions/berger_ec_60s_2026_05_03.npy
//
//   # watch mode (5min interval, audio cue on CRIT)
//   hexa run anima-eeg/protocols/background_quality_audit.hexa \
//        --watch --port /dev/cu.usbserial-DM... \
//        --interval 300 --audio-alert
//
// FOLLOW-UP (raw#10 — not done here, separate cycle):
//   • --line-hz 50/60 selector for EU compatibility
//   • integrate impedance_check.hexa live-call instead of synthetic baseline
//   • alert dedup window (currently every breach → 1 ledger row)

let SCHEMA      = "anima-eeg/background_quality_audit/1"
let HELPER_PATH = "/tmp/anima_eeg_background_quality_audit_helper.py"

// ════════════════════════════════════════════════════════════════════
// Frozen defaults (raw#12)
// ════════════════════════════════════════════════════════════════════

let DEFAULT_VENV_PYTHON                  = ".venv-eeg/bin/python"
let DEFAULT_INTERVAL_S                   = 300        // 5 min
let DEFAULT_LEDGER_DIR                   = "state/quality_ledger"

// Thresholds — frozen (raw#12)
let IMP_DRIFT_PCT_WARN                   = 20.0
let IMP_DRIFT_PCT_CRIT                   = 50.0
let DC_DRIFT_UV_WARN                     = 100.0
let DC_DRIFT_UV_CRIT                     = 200.0
let LINE_NOTCH_DB_WARN                   = 30.0
let LINE_NOTCH_DB_CRIT                   = 20.0
let EFF_FS_FRAC_WARN                     = 0.80
let EFF_FS_FRAC_CRIT                     = 0.50

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

// ════════════════════════════════════════════════════════════════════
// Helper python emitter (raw#37 transient)
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima-eeg background_quality_audit helper — emitted by\n")
    parts.push("# anima-eeg/protocols/background_quality_audit.hexa (raw#37 transient).\n")
    parts.push("import argparse, json, os, signal, subprocess, sys, tempfile, textwrap, time\n\n")

    parts.push("VENV_PYTHON              = '" + DEFAULT_VENV_PYTHON + "'\n")
    parts.push("DEFAULT_INTERVAL_S       = " + str(DEFAULT_INTERVAL_S) + "\n")
    parts.push("DEFAULT_LEDGER_DIR       = '" + DEFAULT_LEDGER_DIR + "'\n")
    parts.push("IMP_DRIFT_PCT_WARN       = " + to_string(IMP_DRIFT_PCT_WARN) + "\n")
    parts.push("IMP_DRIFT_PCT_CRIT       = " + to_string(IMP_DRIFT_PCT_CRIT) + "\n")
    parts.push("DC_DRIFT_UV_WARN         = " + to_string(DC_DRIFT_UV_WARN) + "\n")
    parts.push("DC_DRIFT_UV_CRIT         = " + to_string(DC_DRIFT_UV_CRIT) + "\n")
    parts.push("LINE_NOTCH_DB_WARN       = " + to_string(LINE_NOTCH_DB_WARN) + "\n")
    parts.push("LINE_NOTCH_DB_CRIT       = " + to_string(LINE_NOTCH_DB_CRIT) + "\n")
    parts.push("EFF_FS_FRAC_WARN         = " + to_string(EFF_FS_FRAC_WARN) + "\n")
    parts.push("EFF_FS_FRAC_CRIT         = " + to_string(EFF_FS_FRAC_CRIT) + "\n\n")

    parts.push("SCHEMA = 'anima-eeg/background_quality_audit/1'\n\n")

    parts.push("def emit_trailer(slug, detail, fix):\n")
    parts.push("    sys.stderr.write(f'reason: {slug}: {detail}\\n')\n")
    parts.push("    sys.stderr.write(f'fix: {fix}\\n')\n\n")

    parts.push("def verify_numpy():\n")
    parts.push("    if not os.path.exists(VENV_PYTHON):\n")
    parts.push("        emit_trailer('venv-missing',\n")
    parts.push("                     f'{VENV_PYTHON} not found',\n")
    parts.push("                     '1) python3 -m venv .venv-eeg  '\n")
    parts.push("                     '2) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '3) pip install --upgrade numpy')\n")
    parts.push("        return False\n")
    parts.push("    r = subprocess.run([VENV_PYTHON, '-c', 'import numpy; print(\"ok\")'],\n")
    parts.push("                       capture_output=True, text=True, timeout=20)\n")
    parts.push("    if r.returncode != 0:\n")
    parts.push("        emit_trailer('numpy-missing',\n")
    parts.push("                     f'numpy import failed: {r.stderr.strip()[:200]}',\n")
    parts.push("                     '1) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '2) pip install --upgrade numpy')\n")
    parts.push("        return False\n")
    parts.push("    return True\n\n")

    parts.push("def default_ledger_path():\n")
    parts.push("    import datetime\n")
    parts.push("    yyyymm = datetime.datetime.utcnow().strftime('%Y-%m')\n")
    parts.push("    return os.path.join(DEFAULT_LEDGER_DIR, f'{yyyymm}.jsonl')\n\n")

    parts.push("def ensure_ledger_dir(path):\n")
    parts.push("    d = os.path.dirname(path) or '.'\n")
    parts.push("    os.makedirs(d, exist_ok=True)\n\n")

    parts.push("def utc_now_iso():\n")
    parts.push("    import datetime\n")
    parts.push("    return datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\n\n")

    // ─── audit kernel: numpy-side metric computation ────────────────
    parts.push("AUDIT_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, os, sys\n")
    parts.push("    import numpy as np\n")
    parts.push("    INPUT          = sys.argv[1]\n")
    parts.push("    SESSION_ID     = sys.argv[2]\n")
    parts.push("    LINE_HZ        = float(sys.argv[3])\n")
    parts.push("    THRESH_JSON    = sys.argv[4]\n")
    parts.push("    META_PATH      = INPUT + '.meta.json'\n")
    parts.push("    th = json.loads(THRESH_JSON)\n")
    parts.push("    rows_out = []\n")
    parts.push("    summary = {\n")
    parts.push("        'schema': 'anima-eeg/background_quality_audit/1',\n")
    parts.push("        'session_id': SESSION_ID,\n")
    parts.push("        'input': INPUT,\n")
    parts.push("        'metrics_evaluated': [],\n")
    parts.push("        'n_alerts': 0,\n")
    parts.push("        'highest_level': 'INFO',\n")
    parts.push("        'rows': [],\n")
    parts.push("    }\n")
    parts.push("    if not os.path.exists(INPUT):\n")
    parts.push("        summary['error'] = 'input-missing'\n")
    parts.push("        print(json.dumps(summary)); sys.exit(2)\n")
    parts.push("    if not os.path.exists(META_PATH):\n")
    parts.push("        summary['error'] = 'meta-missing'\n")
    parts.push("        print(json.dumps(summary)); sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        arr = np.load(INPUT)\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        summary['error'] = f'npy-load-failed: {exc!r}'\n")
    parts.push("        print(json.dumps(summary)); sys.exit(2)\n")
    parts.push("    with open(META_PATH) as fh: meta = json.load(fh)\n")
    parts.push("    if arr.ndim == 1: arr = arr.reshape(1, -1)\n")
    parts.push("    rows, cols = int(arr.shape[0]), int(arr.shape[1])\n")
    parts.push("    eeg_rows = meta.get('eeg_channel_rows', list(range(min(8, rows))))\n")
    parts.push("    ch_names = meta.get('channel_names',\n")
    parts.push("                        [f'ch{i}' for i in range(len(eeg_rows))])\n")
    parts.push("    fs_claimed = float(meta.get('sample_rate_claimed_hz',\n")
    parts.push("                                 meta.get('sample_rate', 250.0)))\n")
    parts.push("    dur = float(meta.get('duration_actual_s',\n")
    parts.push("                          meta.get('duration_requested_s', 0.0)))\n")
    parts.push("    imp_baseline = meta.get('impedance_baseline_kohm', {})\n")
    parts.push("    imp_now      = meta.get('impedance_now_kohm', {})\n")
    parts.push("    def add_row(metric_type, channel, value, baseline, alert_level, advice, extra=None):\n")
    parts.push("        row = {\n")
    parts.push("            'ts': __import__('datetime').datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ'),\n")
    parts.push("            'session_id': SESSION_ID,\n")
    parts.push("            'metric_type': metric_type,\n")
    parts.push("            'channel': channel,\n")
    parts.push("            'value': value,\n")
    parts.push("            'baseline': baseline,\n")
    parts.push("            'alert_level': alert_level,\n")
    parts.push("            'advice': advice,\n")
    parts.push("        }\n")
    parts.push("        if extra: row.update(extra)\n")
    parts.push("        rows_out.append(row)\n")
    parts.push("    # ── 1) impedance_drift ───────────────────────────────────────\n")
    parts.push("    summary['metrics_evaluated'].append('impedance_drift')\n")
    parts.push("    for ch, z_base in imp_baseline.items():\n")
    parts.push("        if ch not in imp_now: continue\n")
    parts.push("        z_n = float(imp_now[ch]); z_b = float(z_base)\n")
    parts.push("        if z_b <= 0: continue\n")
    parts.push("        drift_pct = abs(z_n - z_b) / z_b * 100.0\n")
    parts.push("        if drift_pct >= th['imp_drift_crit']:\n")
    parts.push("            add_row('impedance_drift', ch, round(z_n,2), round(z_b,2),\n")
    parts.push("                    'CRIT', f'{ch} 측 paste 측 즉시 보충 / re-fit 필요',\n")
    parts.push("                    {'drift_pct': round(drift_pct,2)})\n")
    parts.push("        elif drift_pct >= th['imp_drift_warn']:\n")
    parts.push("            add_row('impedance_drift', ch, round(z_n,2), round(z_b,2),\n")
    parts.push("                    'WARN', f'{ch} paste 보충 권장',\n")
    parts.push("                    {'drift_pct': round(drift_pct,2)})\n")
    parts.push("    # ── 2) channel_rail_flat ─────────────────────────────────────\n")
    parts.push("    summary['metrics_evaluated'].append('channel_rail_flat')\n")
    parts.push("    # local rail/flat heuristic — actual rail_flat_detector is in\n")
    parts.push("    # anima-eeg-core/_artifact (NOT touched here, raw#10 honest C3)\n")
    parts.push("    for idx, ch in zip(eeg_rows, ch_names):\n")
    parts.push("        if idx >= rows: continue\n")
    parts.push("        sig = arr[idx].astype(np.float64)\n")
    parts.push("        if sig.size < 32: continue\n")
    parts.push("        # rail = abs near max int24 range (proxy: > 1e5 µV)\n")
    parts.push("        rail_frac = float(np.mean(np.abs(sig) > 1e5))\n")
    parts.push("        # flat = stddev across signal < 0.5 µV\n")
    parts.push("        flat = bool(np.std(sig) < 0.5)\n")
    parts.push("        if rail_frac > 0.10:\n")
    parts.push("            add_row('channel_rail_flat', ch, round(rail_frac,4), 0.0,\n")
    parts.push("                    'WARN', f'{ch} rail (>10% saturated) — re-seat electrode')\n")
    parts.push("        if flat:\n")
    parts.push("            add_row('channel_rail_flat', ch, round(float(np.std(sig)),4), 0.0,\n")
    parts.push("                    'WARN', f'{ch} flat (std<0.5µV) — disconnected?')\n")
    parts.push("    # ── 3) dc_drift ──────────────────────────────────────────────\n")
    parts.push("    summary['metrics_evaluated'].append('dc_drift')\n")
    parts.push("    for idx, ch in zip(eeg_rows, ch_names):\n")
    parts.push("        if idx >= rows: continue\n")
    parts.push("        sig = arr[idx].astype(np.float64)\n")
    parts.push("        if sig.size < 32: continue\n")
    parts.push("        m = float(np.abs(np.mean(sig)))\n")
    parts.push("        if m >= th['dc_drift_crit']:\n")
    parts.push("            add_row('dc_drift', ch, round(m,2), 0.0,\n")
    parts.push("                    'CRIT', f'{ch} DC drift {m:.1f}µV — re-fit + dc_settle_trim 권장')\n")
    parts.push("        elif m >= th['dc_drift_warn']:\n")
    parts.push("            add_row('dc_drift', ch, round(m,2), 0.0,\n")
    parts.push("                    'WARN', f'{ch} DC drift {m:.1f}µV — observe')\n")
    parts.push("    # ── 4) line_60hz_notch (proxy: band-power ratio) ─────────────\n")
    parts.push("    summary['metrics_evaluated'].append('line_60hz_notch')\n")
    parts.push("    if fs_claimed > 0 and cols > int(fs_claimed * 2):\n")
    parts.push("        for idx, ch in zip(eeg_rows, ch_names):\n")
    parts.push("            if idx >= rows: continue\n")
    parts.push("            sig = arr[idx].astype(np.float64)\n")
    parts.push("            if sig.size < int(fs_claimed * 2): continue\n")
    parts.push("            sig = sig - np.mean(sig)\n")
    parts.push("            n = sig.size\n")
    parts.push("            freqs = np.fft.rfftfreq(n, d=1.0/fs_claimed)\n")
    parts.push("            spec  = np.abs(np.fft.rfft(sig))**2\n")
    parts.push("            line_lo = LINE_HZ - 1.0; line_hi = LINE_HZ + 1.0\n")
    parts.push("            band_lo = max(LINE_HZ - 10.0, 1.0)\n")
    parts.push("            band_hi = LINE_HZ + 10.0\n")
    parts.push("            line_mask = (freqs >= line_lo) & (freqs <= line_hi)\n")
    parts.push("            band_mask = (freqs >= band_lo) & (freqs <= band_hi) & (~line_mask)\n")
    parts.push("            line_p = float(np.mean(spec[line_mask])) if line_mask.any() else 0.0\n")
    parts.push("            band_p = float(np.mean(spec[band_mask])) if band_mask.any() else 0.0\n")
    parts.push("            if band_p <= 0 or line_p <= 0: continue\n")
    parts.push("            # attenuation_db: 10*log10(band_p / line_p) — positive when\n")
    parts.push("            # line is suppressed below neighbouring band (notch effective)\n")
    parts.push("            atten_db = 10.0 * np.log10(band_p / line_p)\n")
    parts.push("            if atten_db <= th['line_notch_crit']:\n")
    parts.push("                add_row('line_60hz_notch', ch, round(float(atten_db),2), 0.0,\n")
    parts.push("                        'CRIT', f'{ch} 60Hz notch {atten_db:.1f}dB — re-enable notch / cable shield 점검')\n")
    parts.push("            elif atten_db <= th['line_notch_warn']:\n")
    parts.push("                add_row('line_60hz_notch', ch, round(float(atten_db),2), 0.0,\n")
    parts.push("                        'WARN', f'{ch} 60Hz notch {atten_db:.1f}dB — observe')\n")
    parts.push("    # ── 5) effective_fs ──────────────────────────────────────────\n")
    parts.push("    summary['metrics_evaluated'].append('effective_fs')\n")
    parts.push("    if dur > 0 and fs_claimed > 0:\n")
    parts.push("        eff_fs = cols / dur\n")
    parts.push("        frac = eff_fs / fs_claimed\n")
    parts.push("        if frac < th['eff_fs_crit']:\n")
    parts.push("            add_row('effective_fs', 'all', round(eff_fs,2), round(fs_claimed,2),\n")
    parts.push("                    'CRIT', f'eff_fs {eff_fs:.1f}Hz < 50% claimed {fs_claimed:.0f}Hz — board/USB 즉시 점검',\n")
    parts.push("                    {'frac': round(float(frac),4)})\n")
    parts.push("        elif frac < th['eff_fs_warn']:\n")
    parts.push("            add_row('effective_fs', 'all', round(eff_fs,2), round(fs_claimed,2),\n")
    parts.push("                    'WARN', f'eff_fs {eff_fs:.1f}Hz < 80% claimed {fs_claimed:.0f}Hz — observe',\n")
    parts.push("                    {'frac': round(float(frac),4)})\n")
    parts.push("    # ── summary ──────────────────────────────────────────────────\n")
    parts.push("    LEVEL_RANK = {'INFO': 0, 'WARN': 1, 'CRIT': 2}\n")
    parts.push("    INV_RANK   = {0:'INFO', 1:'WARN', 2:'CRIT'}\n")
    parts.push("    highest = 0\n")
    parts.push("    for r in rows_out:\n")
    parts.push("        highest = max(highest, LEVEL_RANK.get(r['alert_level'], 0))\n")
    parts.push("    summary['rows'] = rows_out\n")
    parts.push("    summary['n_alerts'] = len(rows_out)\n")
    parts.push("    summary['highest_level'] = INV_RANK[highest]\n")
    parts.push("    print(json.dumps(summary))\n")
    parts.push("    sys.exit(0)\n")
    parts.push("''')\n\n")

    // ─── selftest payload: synthesize 3 cases for F_BGQ_01/02/03 ─────
    parts.push("SELFTEST_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, os, sys, tempfile, subprocess\n")
    parts.push("    import numpy as np\n")
    parts.push("    AUDIT_PY  = sys.argv[1]\n")
    parts.push("    THRESH_JSON = sys.argv[2]\n")
    parts.push("    LINE_HZ   = float(sys.argv[3])\n")
    parts.push("    tmpdir = tempfile.mkdtemp(prefix='anima_eeg_bgq_audit_')\n")
    parts.push("    LEDGER_PATH = os.path.join(tmpdir, 'ledger.jsonl')\n")
    parts.push("    FS = 250.0\n")
    parts.push("    DUR = 30.0\n")
    parts.push("    N_COLS = int(FS * DUR)\n")
    parts.push("    N_EEG  = 4\n")
    parts.push("    CH_NAMES = ['Fp1','Fp2','C3','C4']\n")
    parts.push("    rng = np.random.default_rng(7)\n")
    parts.push("    def synth(tag, *, drift=False):\n")
    parts.push("        # baseline EEG: pink-ish noise, ±10 µV scale\n")
    parts.push("        arr = rng.normal(0.0, 5.0, size=(N_EEG, N_COLS)).astype(np.float64)\n")
    parts.push("        # ensure DC near zero\n")
    parts.push("        for i in range(N_EEG): arr[i] -= np.mean(arr[i])\n")
    parts.push("        imp_baseline = {'Fp1': 5.0, 'Fp2': 5.0, 'C3': 5.0, 'C4': 5.0}\n")
    parts.push("        if drift:\n")
    parts.push("            # Fp1 paste degraded: impedance 5 → 30 (500% drift)\n")
    parts.push("            imp_now = {'Fp1': 30.0, 'Fp2': 5.5, 'C3': 5.2, 'C4': 5.1}\n")
    parts.push("            # add DC drift to C3 (>200µV → CRIT)\n")
    parts.push("            arr[2] += 250.0\n")
    parts.push("        else:\n")
    parts.push("            imp_now = {'Fp1': 5.1, 'Fp2': 5.2, 'C3': 5.0, 'C4': 5.1}\n")
    parts.push("        npy = os.path.join(tmpdir, tag + '.npy')\n")
    parts.push("        np.save(npy, arr)\n")
    parts.push("        meta = {\n")
    parts.push("            'schema': 'anima-eeg/collect/1',\n")
    parts.push("            'tag': tag,\n")
    parts.push("            'sample_rate_claimed_hz': FS,\n")
    parts.push("            'sample_rate': FS,\n")
    parts.push("            'duration_actual_s': DUR,\n")
    parts.push("            'duration_requested_s': DUR,\n")
    parts.push("            'rows': N_EEG, 'cols': N_COLS,\n")
    parts.push("            'eeg_channel_rows': list(range(N_EEG)),\n")
    parts.push("            'channel_names': CH_NAMES,\n")
    parts.push("            'impedance_baseline_kohm': imp_baseline,\n")
    parts.push("            'impedance_now_kohm':      imp_now,\n")
    parts.push("        }\n")
    parts.push("        with open(npy + '.meta.json', 'w') as fh: json.dump(meta, fh, indent=2)\n")
    parts.push("        return npy\n")
    parts.push("    npy_a = synth('case_baseline', drift=False)\n")
    parts.push("    npy_b = synth('case_drift',    drift=True)\n")
    parts.push("    def run_audit(npy, sid):\n")
    parts.push("        cmd = [sys.executable, '-c', AUDIT_PY, npy, sid,\n")
    parts.push("               str(LINE_HZ), THRESH_JSON]\n")
    parts.push("        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)\n")
    parts.push("        return json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    res_a = run_audit(npy_a, 'sid_baseline')\n")
    parts.push("    res_b = run_audit(npy_b, 'sid_drift')\n")
    parts.push("    # F_BGQ_01: baseline → no alerts (n_alerts == 0)\n")
    parts.push("    f01 = bool(res_a['n_alerts'] == 0 and res_a['highest_level'] == 'INFO')\n")
    parts.push("    # F_BGQ_02: drift → ≥1 alert AND highest_level ∈ {WARN,CRIT}\n")
    parts.push("    f02 = bool(res_b['n_alerts'] >= 1 and\n")
    parts.push("               res_b['highest_level'] in ('WARN','CRIT'))\n")
    parts.push("    # F_BGQ_03: idempotent ledger row — write rows for case_b twice\n")
    parts.push("    # to a synthetic ledger; rows must be byte-stable when ts is\n")
    parts.push("    # frozen + ordering preserved.\n")
    parts.push("    def write_rows(rows, path, fixed_ts):\n")
    parts.push("        with open(path, 'w') as fh:\n")
    parts.push("            for r in rows:\n")
    parts.push("                rr = dict(r)\n")
    parts.push("                rr['ts'] = fixed_ts\n")
    parts.push("                fh.write(json.dumps(rr, sort_keys=True) + '\\n')\n")
    parts.push("    p1 = os.path.join(tmpdir, 'l1.jsonl')\n")
    parts.push("    p2 = os.path.join(tmpdir, 'l2.jsonl')\n")
    parts.push("    write_rows(res_b['rows'], p1, '2026-05-03T20:00:00Z')\n")
    parts.push("    write_rows(res_b['rows'], p2, '2026-05-03T20:00:00Z')\n")
    parts.push("    with open(p1,'rb') as fh: b1 = fh.read()\n")
    parts.push("    with open(p2,'rb') as fh: b2 = fh.read()\n")
    parts.push("    f03 = bool(b1 == b2 and len(b1) > 0)\n")
    parts.push("    overall = bool(f01 and f02 and f03)\n")
    parts.push("    out = {\n")
    parts.push("        'rc': 0,\n")
    parts.push("        'case_baseline_n_alerts': res_a['n_alerts'],\n")
    parts.push("        'case_baseline_level':    res_a['highest_level'],\n")
    parts.push("        'case_drift_n_alerts':    res_b['n_alerts'],\n")
    parts.push("        'case_drift_level':       res_b['highest_level'],\n")
    parts.push("        'case_drift_metrics': sorted({r['metric_type'] for r in res_b['rows']}),\n")
    parts.push("        'f_bgq_01': f01,\n")
    parts.push("        'f_bgq_02': f02,\n")
    parts.push("        'f_bgq_03': f03,\n")
    parts.push("        'overall':  overall,\n")
    parts.push("        'ledger_byte_len': len(b1),\n")
    parts.push("    }\n")
    parts.push("    import shutil\n")
    parts.push("    try: shutil.rmtree(tmpdir)\n")
    parts.push("    except OSError: pass\n")
    parts.push("    print(json.dumps(out))\n")
    parts.push("''')\n\n")

    parts.push("def append_rows(ledger_path, rows):\n")
    parts.push("    if not rows: return 0\n")
    parts.push("    ensure_ledger_dir(ledger_path)\n")
    parts.push("    n = 0\n")
    parts.push("    with open(ledger_path, 'a') as fh:\n")
    parts.push("        for r in rows:\n")
    parts.push("            fh.write(json.dumps(r, sort_keys=True) + '\\n')\n")
    parts.push("            n += 1\n")
    parts.push("    return n\n\n")

    parts.push("def thresh_json():\n")
    parts.push("    return json.dumps({\n")
    parts.push("        'imp_drift_warn': IMP_DRIFT_PCT_WARN,\n")
    parts.push("        'imp_drift_crit': IMP_DRIFT_PCT_CRIT,\n")
    parts.push("        'dc_drift_warn':  DC_DRIFT_UV_WARN,\n")
    parts.push("        'dc_drift_crit':  DC_DRIFT_UV_CRIT,\n")
    parts.push("        'line_notch_warn': LINE_NOTCH_DB_WARN,\n")
    parts.push("        'line_notch_crit': LINE_NOTCH_DB_CRIT,\n")
    parts.push("        'eff_fs_warn':    EFF_FS_FRAC_WARN,\n")
    parts.push("        'eff_fs_crit':    EFF_FS_FRAC_CRIT,\n")
    parts.push("    })\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('schema=' + SCHEMA)\n")
    parts.push("    print('venv_python_exists=' + str(os.path.exists(VENV_PYTHON)))\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', SELFTEST_PY,\n")
    parts.push("           AUDIT_PY, thresh_json(), '60.0']\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)\n")
    parts.push("    if r.returncode != 0 or not r.stdout.strip():\n")
    parts.push("        emit_trailer('selftest-subprocess-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) verify .venv-eeg numpy installed  2) re-run')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        m = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('selftest-parse-failed',\n")
    parts.push("                     f'could not parse helper output: {exc!r}; raw={r.stdout[-200:]!r}',\n")
    parts.push("                     '1) re-run; if persistent inspect helper python')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    f01 = 'PASS' if m['f_bgq_01'] else 'FAIL'\n")
    parts.push("    f02 = 'PASS' if m['f_bgq_02'] else 'FAIL'\n")
    parts.push("    f03 = 'PASS' if m['f_bgq_03'] else 'FAIL'\n")
    parts.push("    print(f'case_baseline      n_alerts={m[\"case_baseline_n_alerts\"]} level={m[\"case_baseline_level\"]}')\n")
    parts.push("    print(f'case_drift         n_alerts={m[\"case_drift_n_alerts\"]} level={m[\"case_drift_level\"]} metrics={m[\"case_drift_metrics\"]}')\n")
    parts.push("    print(f'F_BGQ_01_baseline_silent:    {f01}')\n")
    parts.push("    print(f'F_BGQ_02_drift_alert:        {f02}')\n")
    parts.push("    print(f'F_BGQ_03_ledger_byte_stable: {f03}  (bytes={m[\"ledger_byte_len\"]})')\n")
    parts.push("    overall = 'PASS' if m['overall'] else 'FAIL'\n")
    parts.push("    print(f'selftest={overall.lower()}')\n")
    parts.push("    print(f'__EEG_BACKGROUND_QUALITY_AUDIT__ {overall} {m[\"case_drift_n_alerts\"]} <selftest>')\n")
    parts.push("    sys.exit(0 if m['overall'] else 1)\n\n")

    parts.push("def run_audit_once(input_path, session_id, line_hz):\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', AUDIT_PY, input_path, session_id,\n")
    parts.push("           str(line_hz), thresh_json()]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)\n")
    parts.push("    if not r.stdout.strip():\n")
    parts.push("        emit_trailer('audit-subprocess-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) check input + meta sidecar  2) re-run --selftest')\n")
    parts.push("        return None\n")
    parts.push("    try:\n")
    parts.push("        return json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('audit-parse-failed',\n")
    parts.push("                     f'parse error: {exc!r}',\n")
    parts.push("                     '1) re-run --selftest to validate helper')\n")
    parts.push("        return None\n\n")

    parts.push("def cmd_audit_once(args):\n")
    parts.push("    if not os.path.exists(args.input):\n")
    parts.push("        emit_trailer('input-missing',\n")
    parts.push("                     f'--input {args.input} not found',\n")
    parts.push("                     '1) verify path; .npy from collect.hexa')\n")
    parts.push("        print('__EEG_BACKGROUND_QUALITY_AUDIT__ FAIL 0 <none>')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not os.path.exists(args.input + '.meta.json'):\n")
    parts.push("        emit_trailer('meta-missing',\n")
    parts.push("                     f'sidecar {args.input}.meta.json not found',\n")
    parts.push("                     '1) re-run collect.hexa with --output to regenerate')\n")
    parts.push("        print('__EEG_BACKGROUND_QUALITY_AUDIT__ FAIL 0 <none>')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('__EEG_BACKGROUND_QUALITY_AUDIT__ FAIL 0 <none>')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    ledger = args.ledger_path or default_ledger_path()\n")
    parts.push("    sid = args.session_id or ('audit_once_' +\n")
    parts.push("           __import__('datetime').datetime.utcnow().strftime('%Y%m%d_%H%M%S'))\n")
    parts.push("    res = run_audit_once(args.input, sid, args.line_hz)\n")
    parts.push("    if res is None or 'error' in (res or {}):\n")
    parts.push("        err = (res or {}).get('error', 'unknown')\n")
    parts.push("        emit_trailer('audit-error', f'helper error: {err}',\n")
    parts.push("                     '1) inspect input + meta sidecar')\n")
    parts.push("        print('__EEG_BACKGROUND_QUALITY_AUDIT__ FAIL 0 ' + ledger)\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    n = append_rows(ledger, res['rows'])\n")
    parts.push("    print(f'session_id={sid}')\n")
    parts.push("    print(f'metrics_evaluated={res[\"metrics_evaluated\"]}')\n")
    parts.push("    print(f'n_alerts={res[\"n_alerts\"]}  highest={res[\"highest_level\"]}')\n")
    parts.push("    print(f'ledger={ledger}  rows_appended={n}')\n")
    parts.push("    overall = 'PASS' if res['n_alerts'] == 0 else 'WARN'\n")
    parts.push("    if res['highest_level'] == 'CRIT': overall = 'FAIL'\n")
    parts.push("    print(f'__EEG_BACKGROUND_QUALITY_AUDIT__ {overall} {res[\"n_alerts\"]} {ledger}')\n")
    parts.push("    sys.exit(0 if overall != 'FAIL' else 1)\n\n")

    parts.push("STOP = {'flag': False}\n")
    parts.push("def _on_sig(signum, frame): STOP['flag'] = True\n\n")

    parts.push("def cmd_watch(args):\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('__EEG_BACKGROUND_QUALITY_AUDIT__ FAIL 0 <none>')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    ledger = args.ledger_path or default_ledger_path()\n")
    parts.push("    ensure_ledger_dir(ledger)\n")
    parts.push("    signal.signal(signal.SIGINT,  _on_sig)\n")
    parts.push("    signal.signal(signal.SIGTERM, _on_sig)\n")
    parts.push("    iteration = 0\n")
    parts.push("    sid_root = ('background_watch_' +\n")
    parts.push("                __import__('datetime').datetime.utcnow().strftime('%Y%m%d_%H%M%S'))\n")
    parts.push("    # silent stdout: emit one JSONL line per iteration summary\n")
    parts.push("    while not STOP['flag']:\n")
    parts.push("        iteration += 1\n")
    parts.push("        sid = f'{sid_root}_iter{iteration:04d}'\n")
    parts.push("        # In watch mode, --input is REQUIRED to point at the most\n")
    parts.push("        # recent .npy snapshot (raw#10 honest C3: this module does\n")
    parts.push("        # NOT itself capture; capture is collect.hexa's job).\n")
    parts.push("        n_alerts = 0\n")
    parts.push("        highest = 'INFO'\n")
    parts.push("        if args.input and os.path.exists(args.input) and os.path.exists(args.input + '.meta.json'):\n")
    parts.push("            res = run_audit_once(args.input, sid, args.line_hz)\n")
    parts.push("            if res is not None and 'error' not in res:\n")
    parts.push("                append_rows(ledger, res['rows'])\n")
    parts.push("                n_alerts = res['n_alerts']\n")
    parts.push("                highest = res['highest_level']\n")
    parts.push("                # audio cue: opt-in, only on CRIT\n")
    parts.push("                if args.audio_alert and highest == 'CRIT':\n")
    parts.push("                    try:\n")
    parts.push("                        subprocess.run(['/usr/bin/say', 'critical eeg quality alert'],\n")
    parts.push("                                       timeout=4)\n")
    parts.push("                    except Exception: pass\n")
    parts.push("        line = json.dumps({\n")
    parts.push("            'ts': utc_now_iso(),\n")
    parts.push("            'session_id': sid,\n")
    parts.push("            'iteration': iteration,\n")
    parts.push("            'n_alerts': n_alerts,\n")
    parts.push("            'highest_level': highest,\n")
    parts.push("            'ledger': ledger,\n")
    parts.push("            'port': args.port,\n")
    parts.push("        })\n")
    parts.push("        print(line, flush=True)\n")
    parts.push("        if args.max_iterations and iteration >= args.max_iterations: break\n")
    parts.push("        # interruptible sleep — break early on signal\n")
    parts.push("        slept = 0.0\n")
    parts.push("        step = 0.5\n")
    parts.push("        while slept < args.interval and not STOP['flag']:\n")
    parts.push("            time.sleep(step); slept += step\n")
    parts.push("    print(f'__EEG_BACKGROUND_QUALITY_AUDIT__ PASS {iteration} {ledger}')\n")
    parts.push("    sys.exit(0)\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    s = sub.add_parser('selftest')\n")
    parts.push("    a = sub.add_parser('audit_once')\n")
    parts.push("    a.add_argument('--input', required=True)\n")
    parts.push("    a.add_argument('--ledger-path', default=None, dest='ledger_path')\n")
    parts.push("    a.add_argument('--session-id',  default=None, dest='session_id')\n")
    parts.push("    a.add_argument('--line-hz',     type=float, default=60.0, dest='line_hz')\n")
    parts.push("    w = sub.add_parser('watch')\n")
    parts.push("    w.add_argument('--port',        default='', dest='port')\n")
    parts.push("    w.add_argument('--input',       default='', dest='input')\n")
    parts.push("    w.add_argument('--interval',    type=int, default=DEFAULT_INTERVAL_S)\n")
    parts.push("    w.add_argument('--ledger-path', default=None, dest='ledger_path')\n")
    parts.push("    w.add_argument('--line-hz',     type=float, default=60.0, dest='line_hz')\n")
    parts.push("    w.add_argument('--audio-alert', action='store_true', default=False)\n")
    parts.push("    w.add_argument('--max-iterations', type=int, default=0,\n")
    parts.push("                   dest='max_iterations',\n")
    parts.push("                   help='0 = infinite (default); n>0 stops after n iters')\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest':    cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'audit_once': cmd_audit_once(args)\n")
    parts.push("    elif args.cmd == 'watch':      cmd_watch(args)\n")
    parts.push("    else: sys.exit(2)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/protocols/background_quality_audit.hexa --selftest")
    eprintln("       hexa run anima-eeg/protocols/background_quality_audit.hexa \\")
    eprintln("            --audit-once --input <raw.npy> \\")
    eprintln("            [--ledger-path <path>] [--session-id <id>]")
    eprintln("       hexa run anima-eeg/protocols/background_quality_audit.hexa \\")
    eprintln("            --watch [--port <serial>] [--input <raw.npy>] \\")
    eprintln("            [--interval " + str(DEFAULT_INTERVAL_S) + "] \\")
    eprintln("            [--ledger-path <path>] [--audio-alert] \\")
    eprintln("            [--max-iterations <n>]")
    eprintln("flags:")
    eprintln("  --selftest               synthetic 2-case audit, verify F_BGQ_01/02/03")
    eprintln("  --audit-once             single-shot audit on .npy + meta sidecar")
    eprintln("  --watch                  loop every --interval s, append to ledger")
    eprintln("  --input <path>           .npy artifact (sidecar <path>.meta.json)")
    eprintln("  --port <serial>          informational; capture itself is collect.hexa")
    eprintln("  --interval <sec>         watch interval (default " + str(DEFAULT_INTERVAL_S) + " = 5min)")
    eprintln("  --ledger-path <path>     append-only JSONL (default state/quality_ledger/<YYYY-MM>.jsonl)")
    eprintln("  --session-id <id>        override session_id (default auto UTC ts)")
    eprintln("  --audio-alert            opt-in /usr/bin/say cue on CRIT only")
    eprintln("  --max-iterations <n>     watch stop after n iters (0=infinite)")
    eprintln("  --line-hz <hz>           power-line freq (default 60; future: 50 EU)")
    eprintln("  --help                   this message")
}

fn main() {
    let av = argv()
    let mut want_selftest    = false
    let mut want_audit_once  = false
    let mut want_watch       = false
    let mut want_help        = false
    let mut input_path       = ""
    let mut ledger_path      = ""
    let mut session_id       = ""
    let mut port             = ""
    let mut interval_s       = DEFAULT_INTERVAL_S
    let mut audio_alert      = false
    let mut max_iterations   = 0
    let mut line_hz          = 60.0

    // hexa-strict: user args begin at index 2 (matches sample_rate_guard / package_num_audit)
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"    { want_selftest = true;   i = i + 1; continue }
        if a == "--audit-once"  { want_audit_once = true; i = i + 1; continue }
        if a == "--watch"       { want_watch = true;      i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--audio-alert" { audio_alert = true;     i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--input requires a path",
                              "1) re-run with --input <path.npy>")
                exit(2)
            }
            input_path = av[i + 1]; i = i + 2; continue
        }
        if a == "--ledger-path" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--ledger-path requires a path",
                              "1) re-run with --ledger-path state/quality_ledger/<YYYY-MM>.jsonl")
                exit(2)
            }
            ledger_path = av[i + 1]; i = i + 2; continue
        }
        if a == "--session-id" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--session-id requires a string",
                              "1) re-run with --session-id <id>")
                exit(2)
            }
            session_id = av[i + 1]; i = i + 2; continue
        }
        if a == "--port" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--port requires a serial path",
                              "1) re-run with --port /dev/cu.usbserial-...")
                exit(2)
            }
            port = av[i + 1]; i = i + 2; continue
        }
        if a == "--interval" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--interval requires seconds",
                              "1) re-run with --interval 300")
                exit(2)
            }
            interval_s = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--max-iterations" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--max-iterations requires an integer",
                              "1) re-run with --max-iterations 6")
                exit(2)
            }
            max_iterations = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--line-hz" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--line-hz requires a frequency",
                              "1) re-run with --line-hz 60  (or 50 for EU)")
                exit(2)
            }
            line_hz = to_float(av[i + 1]); i = i + 2; continue
        }
        // unknown flag → fall through
        _emit_trailer("unknown-flag",
                      "argv[" + str(i) + "] = " + a,
                      "1) check --help for valid flags")
        _print_usage()
        exit(2)
    }

    if want_help {
        _print_usage()
        exit(0)
    }

    // mode-mutex: at most one of selftest / audit_once / watch
    let mut n_modes = 0
    if want_selftest   { n_modes = n_modes + 1 }
    if want_audit_once { n_modes = n_modes + 1 }
    if want_watch      { n_modes = n_modes + 1 }
    if n_modes == 0 {
        _emit_trailer("missing-mode",
                      "exactly one of --selftest / --audit-once / --watch required",
                      "1) see --help")
        _print_usage()
        exit(2)
    }
    if n_modes > 1 {
        _emit_trailer("conflicting-mode",
                      "--selftest / --audit-once / --watch are mutually exclusive",
                      "1) pick exactly one mode")
        exit(2)
    }

    if want_audit_once {
        if input_path == "" {
            _emit_trailer("missing-required",
                          "--audit-once requires --input <path.npy>",
                          "1) provide --input <raw.npy>")
            _print_usage()
            exit(2)
        }
    }

    if want_watch {
        if interval_s <= 0 {
            _emit_trailer("invalid-interval",
                          "--interval must be > 0 (got " + str(interval_s) + ")",
                          "1) re-run with --interval 300")
            exit(2)
        }
    }

    _write_helper()

    if want_selftest {
        let r = _run_helper("selftest")
        let stdout = r[0]
        let rc     = to_int(r[1])
        println(stdout)
        exit(rc)
    }

    if want_audit_once {
        let mut args = "audit_once"
            + " --input " + _sh_quote(input_path)
            + " --line-hz " + to_string(line_hz)
        if ledger_path != "" { args = args + " --ledger-path " + _sh_quote(ledger_path) }
        if session_id  != "" { args = args + " --session-id "  + _sh_quote(session_id) }
        let r = _run_helper(args)
        let stdout = r[0]
        let rc     = to_int(r[1])
        println(stdout)
        exit(rc)
    }

    if want_watch {
        let mut args = "watch"
            + " --interval " + str(interval_s)
            + " --line-hz "  + to_string(line_hz)
            + " --max-iterations " + str(max_iterations)
        if input_path  != "" { args = args + " --input "       + _sh_quote(input_path) }
        if port        != "" { args = args + " --port "        + _sh_quote(port) }
        if ledger_path != "" { args = args + " --ledger-path " + _sh_quote(ledger_path) }
        if audio_alert       { args = args + " --audio-alert" }
        let r = _run_helper(args)
        let stdout = r[0]
        let rc     = to_int(r[1])
        println(stdout)
        exit(rc)
    }

    exit(0)
}
