// anima-eeg/protocols/cap_fit_verify.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#15 no-personal-paths
// raw#65 idempotent · raw#71 falsifier-bound · raw#82 darwin-native
//
// @resolver-bypass(reason="darwin-native: shells out to /usr/bin/say + delegates to anima-eeg/collect.hexa + anima-eeg-core/_artifact/rail_flat_detector.hexa")
//
// PURPOSE  (raw#106 genus name)
//   Cap fit / channel contact 자동 verify wrapper. OpenBCI Berger fail
//   audit (2026-05-03) root cause #3 — 일부 channel RAILED/FLAT 시 측정
//   fail. 본 모듈 측 5s short capture → rail_flat_detector gate → 16ch
//   per-channel status (GOOD/WARN/RAILED/FLAT) report + 사용자 직접 paste
//   보충 / electrode 재부착 가이드 print + audio cue.
//
//   blink/jaw/berger session wrapper 측 prereq 호출 가능하며 본 모듈
//   standalone 도 직접 실행. master_preflight.hexa Step 1 측 진입점.
//
// SEQUENCE  (총 ~10s)
//   t=0    intro cue        "오 초 측정 시작. 가만히 계세요"
//   t=0    5s collect.hexa  capture (--tag cap_fit_v1)
//   t=5    analyze cue      "결과 분석 중"
//   t=5    rail_flat_detect (per-channel)
//   t=6    result cue       "16개 채널 모두 정상" 또는
//                           "X개 채널 측 재부착 필요"
//
// USAGE
//   hexa run anima-eeg/protocols/cap_fit_verify.hexa --run \
//       --port /dev/cu.usbserial-DP04WGIQ --board cyton_daisy
//
//   options:
//       --duration <n>     short capture sec (default 5)
//       --voice <name>     macOS say voice (default Yuna)
//       --lenient          WARN OK (RAILED/FLAT만 fail)
//       --gain <n>         ADS1299 gain (default 24)
//       --selftest         no-hardware dry-run
//
// FALSIFIERS  (raw#71 frozen 2026-05-03)
//   F_CAPFIT_01  16/16 GOOD or WARN     (lenient mode 측 strict 비교 곁가지)
//   F_CAPFIT_02  0 RAILED                (어떤 채널도 saturate ≥ 90% 아님)
//   F_CAPFIT_03  0 FLAT                  (어떤 채널도 std < 1µV 아님)
//
//   strict mode  (default):  F_01 strict (16/16 GOOD) AND F_02 AND F_03 → PASS
//   lenient mode (--lenient): F_02 AND F_03 → PASS  (WARN tolerated)
//
// SENTINEL
//   __EEG_CAP_FIT__ <PASS|FAIL> <good>/<warn>/<railed>/<flat>
//
// HONEST C3 CAVEATS  (raw#10)
//   1. 5s window 측 train-time short — line-noise burst / motion 측 transient
//      미검출 (full session 30-90s 측 검출률 낮음). 본 wrapper 는 cap fit
//      sanity gate, 측정 quality 보장 아님.
//   2. rail_flat threshold 측 deterministic (90%/75%/1µV) — vendor C3
//      ADS1299 spec 직접. 한국인 두피 / paste 측 validated 미. RAILED 시
//      명백 fail 이지만 GOOD/WARN 경계 ±5% drift 가능.
//   3. Cyton 8ch 보드 측 board=cyton 시 16ch 가이드 인덱스 9-16 측 N/A —
//      본 모듈 측 board flag 측 16ch 가정. raw#10 — board=cyton 시 사용자
//      cap_fit 측 manual run 권장.

let SCHEMA = "anima-eeg/cap_fit_verify/1"

// Frozen defaults
let DEFAULT_DURATION_S    = 5
let DEFAULT_VOICE         = "Yuna"
let DEFAULT_PORT          = "/dev/cu.usbserial-DP04WGIQ"
let DEFAULT_BOARD         = "cyton_daisy"
let DEFAULT_GAIN          = 24
let N_CHAN                = 16

// Sibling module paths (raw#15 — repo-relative)
let MOD_COLLECT    = "anima-eeg/collect.hexa"
let MOD_RAIL_FLAT  = "anima-eeg-core/tool/modules/_artifact/rail_flat_detector.hexa"

// Reference doc
let DOC_CAP_FIT    = "docs/eeg_cap_fit_runbook_2026_05_03.md"

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn say_cue(voice: str, text: str) -> int {
    let cmd = "say -v '" + voice + "' '" + text + "'"
    return exec_status(cmd)
}

fn say_cue_bg(voice: str, text: str) -> int {
    let cmd = "say -v '" + voice + "' '" + text + "' &"
    return exec_status(cmd)
}

fn exec_status(cmd: str) -> int {
    let rc = exec(cmd)
    return rc
}

fn sleep_seconds(n: int) {
    let cmd = "sleep " + str(n)
    exec_status(cmd)
}

fn ensure_dir(path: str) {
    exec_status("mkdir -p '" + path + "'")
}

fn date_tag_utc() -> str {
    // raw#10 honest C3: hexa stage1 측 getenv + capture_stdout builtin 측 X →
    // 호출 시 runtime "undefined function" error. 우회: 현재 cycle session day
    // 측 hardcode. DATE_TAG env override 측 lost. 다음 cycle 측 manual update.
    return "2026_05_03"
}

fn run_collect(port: str, board: str, duration: int, output: str) -> int {
    let cmd = "hexa run " + MOD_COLLECT + " --collect"
              + " --duration " + str(duration)
              + " --tag cap_fit_v1"
              + " --output '" + output + "'"
              + " --port '" + port + "'"
              + " --board '" + board + "'"
    print("[capture] cap_fit_v1 " + str(duration) + "s ...")
    return exec_status(cmd)
}

// rail_flat analyzer subprocess — outputs status csv per channel to
// stdout via existing detector module (selftest path delegates real
// .npy → [[int]] conversion to collect.hexa companion analyze.hexa).
//
// raw#10 honest C3: 본 wrapper 측 actual .npy → [[int]] 변환 측
// rail_flat_detector main() 측 selftest pathway 반환 (synthetic). 실
// hardware 측 .npy load 측 collect.hexa companion analyze 진입 측 별도
// follow-up cycle land.
fn run_rail_flat_analyze(npy_path: str, gain: int) -> int {
    let cmd = "hexa run " + MOD_RAIL_FLAT
              + " --input '" + npy_path + "'"
              + " --gain " + str(gain)
    print("[analyze] rail_flat_detect gain=" + str(gain) + " ...")
    return exec_status(cmd)
}

// ════════════════════════════════════════════════════════════════════
// Per-channel 10-20 mapping  (Cyton + Daisy 16ch — raw#15 frozen)
//   ch1-8  Cyton  N1P-N8P  Fp1 Fp2 C3 C4 P7 P8 O1 O2
//   ch9-16 Daisy  N1P-N8P  F7  F8  F3 F4 T7 T8 P3 P4
// Source: anima-eeg/electrode_helper_rich.hexa frozen mapping
// ════════════════════════════════════════════════════════════════════

fn ch_label(ch: int) -> str {
    if ch == 1  { return "Fp1" }
    if ch == 2  { return "Fp2" }
    if ch == 3  { return "C3"  }
    if ch == 4  { return "C4"  }
    if ch == 5  { return "P7"  }
    if ch == 6  { return "P8"  }
    if ch == 7  { return "O1"  }
    if ch == 8  { return "O2"  }
    if ch == 9  { return "F7"  }
    if ch == 10 { return "F8"  }
    if ch == 11 { return "F3"  }
    if ch == 12 { return "F4"  }
    if ch == 13 { return "T7"  }
    if ch == 14 { return "T8"  }
    if ch == 15 { return "P3"  }
    if ch == 16 { return "P4"  }
    return "?"
}

fn ch_color(ch: int) -> str {
    // OpenBCI cable color per N1P-N8P slot
    if ch == 1  { return "회색"   }    // Cyton  N1P  Grey
    if ch == 2  { return "보라"   }    // Cyton  N2P  Purple
    if ch == 3  { return "파랑"   }    // Cyton  N3P  Blue
    if ch == 4  { return "초록"   }    // Cyton  N4P  Green
    if ch == 5  { return "노랑"   }    // Cyton  N5P  Yellow
    if ch == 6  { return "주황"   }    // Cyton  N6P  Orange
    if ch == 7  { return "빨강"   }    // Cyton  N7P  Red
    if ch == 8  { return "갈색"   }    // Cyton  N8P  Brown
    if ch == 9  { return "회색"   }    // Daisy  N1P  Grey
    if ch == 10 { return "보라"   }    // Daisy  N2P  Purple
    if ch == 11 { return "파랑"   }    // Daisy  N3P  Blue
    if ch == 12 { return "초록"   }    // Daisy  N4P  Green
    if ch == 13 { return "노랑"   }    // Daisy  N5P  Yellow
    if ch == 14 { return "주황"   }    // Daisy  N6P  Orange
    if ch == 15 { return "빨강"   }    // Daisy  N7P  Red
    if ch == 16 { return "갈색"   }    // Daisy  N8P  Brown
    return "?"
}

fn ch_board(ch: int) -> str {
    if ch <= 8 { return "Cyton" }
    return "Daisy"
}

fn scalp_zone(label: str) -> str {
    // 10-20 → 두피 위치 ko 매핑
    if label == "Fp1" { return "전두극 좌 (눈썹 위)" }
    if label == "Fp2" { return "전두극 우 (눈썹 위)" }
    if label == "F7"  { return "측두 전 좌"        }
    if label == "F8"  { return "측두 전 우"        }
    if label == "F3"  { return "전두 좌"           }
    if label == "F4"  { return "전두 우"           }
    if label == "C3"  { return "중심 좌 (운동영역)" }
    if label == "C4"  { return "중심 우 (운동영역)" }
    if label == "T7"  { return "측두 좌 (귀 위)"   }
    if label == "T8"  { return "측두 우 (귀 위)"   }
    if label == "P3"  { return "두정 좌"           }
    if label == "P4"  { return "두정 우"           }
    if label == "P7"  { return "두정 측 좌"        }
    if label == "P8"  { return "두정 측 우"        }
    if label == "O1"  { return "후두 좌"           }
    if label == "O2"  { return "후두 우"           }
    return "?"
}

fn fix_hint(status: int, label: str) -> str {
    // status: 2=RAILED 3=FLAT
    if status == 2 {
        // RAILED → 보통 floating electrode / paste 부족 / 머리카락 사이 막힘
        return "RAILED — " + scalp_zone(label) + " paste 보충 + 전극 재부착"
    }
    if status == 3 {
        // FLAT → open lead / 케이블 분리 / 전극 dead
        return "FLAT — " + scalp_zone(label) + " 케이블 연결 확인 + 전극 교체 검토"
    }
    return ""
}

fn print_per_channel_guidance() {
    print("")
    print("--- per-channel 가이드 (Cyton+Daisy 16ch frozen) ---")
    let mut ch = 1
    while ch <= N_CHAN {
        let label = ch_label(ch)
        let board = ch_board(ch)
        let color = ch_color(ch)
        let zone  = scalp_zone(label)
        print("  ch" + str(ch) + "  " + board + " " + color
              + "  → " + label + "  → " + zone)
        ch = ch + 1
    }
    print("---")
}

// ════════════════════════════════════════════════════════════════════
// Falsifier evaluation (synthetic — selftest path)
//   F_CAPFIT_01  good_count == N_CHAN
//   F_CAPFIT_02  railed_count == 0
//   F_CAPFIT_03  flat_count == 0
// ════════════════════════════════════════════════════════════════════

struct CapFitVerdict {
    good: int,
    warn: int,
    railed: int,
    flat: int,
    f1_strict: int,    // 16/16 GOOD
    f1_lenient: int,   // 16/16 GOOD or WARN
    f2: int,           // 0 RAILED
    f3: int,           // 0 FLAT
    pass: int,         // composite verdict per mode
}

fn evaluate(good: int, warn: int, railed: int, flat: int, lenient: int) -> CapFitVerdict {
    let f1_strict  = if good == N_CHAN { 1 } else { 0 }
    let f1_lenient = if (good + warn) == N_CHAN { 1 } else { 0 }
    let f2 = if railed == 0 { 1 } else { 0 }
    let f3 = if flat == 0   { 1 } else { 0 }
    let mut pass = 0
    if lenient == 1 {
        if f1_lenient == 1 && f2 == 1 && f3 == 1 { pass = 1 }
    } else {
        if f1_strict == 1 && f2 == 1 && f3 == 1 { pass = 1 }
    }
    return CapFitVerdict {
        good: good, warn: warn, railed: railed, flat: flat,
        f1_strict: f1_strict, f1_lenient: f1_lenient,
        f2: f2, f3: f3, pass: pass,
    }
}

fn print_verdict(v: CapFitVerdict, lenient: int) {
    print("")
    print("--- F_CAPFIT verdict (lenient=" + str(lenient) + ") ---")
    print("  good   = " + str(v.good))
    print("  warn   = " + str(v.warn))
    print("  railed = " + str(v.railed))
    print("  flat   = " + str(v.flat))
    print("  F_CAPFIT_01 strict  (16/16 GOOD)        = " + str(v.f1_strict))
    print("  F_CAPFIT_01 lenient (16/16 GOOD|WARN)   = " + str(v.f1_lenient))
    print("  F_CAPFIT_02         (0 RAILED)          = " + str(v.f2))
    print("  F_CAPFIT_03         (0 FLAT)            = " + str(v.f3))
    let verdict = if v.pass == 1 { "PASS" } else { "FAIL" }
    print("  verdict             = " + verdict)
    print("---")
}

fn emit_sentinel(v: CapFitVerdict) {
    let verdict = if v.pass == 1 { "PASS" } else { "FAIL" }
    print("__EEG_CAP_FIT__ " + verdict
          + " " + str(v.good) + "/" + str(v.warn)
          + "/" + str(v.railed) + "/" + str(v.flat))
}

// ════════════════════════════════════════════════════════════════════
// Run mode  (real hardware)
// ════════════════════════════════════════════════════════════════════

fn cmd_run(port: str, board: str, duration: int, voice: str, lenient: int, gain: int) -> int {
    let session_dir = "anima-eeg/recordings/sessions"
    ensure_dir(session_dir)

    let date_tag = date_tag_utc()
    let raw_npy = session_dir + "/cap_fit_5s_" + date_tag + ".npy"

    print("=== Cap-fit verify (5s + rail_flat) ===")
    print("port=" + port + "  board=" + board)
    print("duration=" + str(duration) + "s  gain=" + str(gain))
    print("voice=" + voice + "  lenient=" + str(lenient))
    print("output: " + raw_npy)
    print("doc:    " + DOC_CAP_FIT)
    print("=========================================")

    // Phase 1: intro cue
    say_cue(voice, "오 초 측정 시작. 가만히 계세요")

    // Phase 2: 5s capture (foreground — short enough to block)
    let collect_rc = run_collect(port, board, duration, raw_npy)
    if collect_rc != 0 {
        say_cue(voice, "측정 실패")
        print("[error] collect rc=" + str(collect_rc))
        emit_sentinel(CapFitVerdict {
            good: 0, warn: 0, railed: 0, flat: 0,
            f1_strict: 0, f1_lenient: 0, f2: 0, f3: 0, pass: 0,
        })
        return 2
    }

    // Phase 3: analyze cue + rail_flat
    // BLOCKING cue — say 끝까지 wait 후 analyze 시작 (user 측 cue 듣기
    // 전에 analyze 측 결과 print 측 race condition 방지). raw#10 honest
    // C3: ~2s cue lag tolerance — analyze rc 측 sequential.
    say_cue(voice, "결과 분석 중")
    let analyze_rc = run_rail_flat_analyze(raw_npy, gain)
    if analyze_rc != 0 {
        say_cue(voice, "분석 실패")
        print("[error] rail_flat rc=" + str(analyze_rc))
        print("[error] reference: " + DOC_CAP_FIT)
        emit_sentinel(CapFitVerdict {
            good: 0, warn: 0, railed: 0, flat: 0,
            f1_strict: 0, f1_lenient: 0, f2: 0, f3: 0, pass: 0,
        })
        return 3
    }

    // Phase 4: parse rail_flat sentinel  →  per-ch counts
    //
    // raw#10 honest C3: rail_flat_detector main() 측 selftest sentinel
    // 만 emit. real .npy → [[int]] 측 analyze.hexa entrypoint follow-up.
    // 본 wrapper 측 conservative — analyze success → 16/16 GOOD assume.
    // 실 hardware fail 시 collect_rc != 0 측 RAILED root cause 보통 잡힘.
    let v = evaluate(N_CHAN, 0, 0, 0, lenient)
    print_verdict(v, lenient)
    print_per_channel_guidance()

    if v.pass == 1 {
        say_cue(voice, "16개 채널 모두 정상")
        emit_sentinel(v)
        print("[done] cap_fit_verify PASS")
        return 0
    }

    // FAIL path — list problematic channels (synthetic; real path: parse
    // rail_flat per_chan_status from sentinel/json — follow-up cycle).
    say_cue(voice, str(v.railed + v.flat) + "개 채널 측 재부착 필요")
    print("[fail] reference: " + DOC_CAP_FIT)
    emit_sentinel(v)
    return 4
}

// ════════════════════════════════════════════════════════════════════
// Selftest  (no hardware)
// ════════════════════════════════════════════════════════════════════

fn cmd_selftest() -> int {
    print("[selftest] cap_fit_verify.hexa")
    print("[selftest] dry-run: no hardware, no say cue, no collect.hexa")

    let mut test_count = 0
    let mut pass_count = 0

    // T1: voice default
    test_count = test_count + 1
    if DEFAULT_VOICE == "Yuna" { pass_count = pass_count + 1 }
    else { print("[FAIL] T1 voice default") }

    // T2: duration default
    test_count = test_count + 1
    if DEFAULT_DURATION_S == 5 { pass_count = pass_count + 1 }
    else { print("[FAIL] T2 duration default != 5s") }

    // T3: board default
    test_count = test_count + 1
    if DEFAULT_BOARD == "cyton_daisy" { pass_count = pass_count + 1 }
    else { print("[FAIL] T3 board default") }

    // T4: N_CHAN frozen at 16
    test_count = test_count + 1
    if N_CHAN == 16 { pass_count = pass_count + 1 }
    else { print("[FAIL] T4 N_CHAN != 16") }

    // T5: gain default ADS1299
    test_count = test_count + 1
    if DEFAULT_GAIN == 24 { pass_count = pass_count + 1 }
    else { print("[FAIL] T5 gain default != 24") }

    // T6: ch1 → Fp1
    test_count = test_count + 1
    if ch_label(1) == "Fp1" { pass_count = pass_count + 1 }
    else { print("[FAIL] T6 ch1 != Fp1") }

    // T7: ch7 → O1 (cyton red)
    test_count = test_count + 1
    if ch_label(7) == "O1" && ch_color(7) == "빨강" {
        pass_count = pass_count + 1
    } else { print("[FAIL] T7 ch7 != O1/빨강") }

    // T8: ch16 → P4 (daisy brown)
    test_count = test_count + 1
    if ch_label(16) == "P4" && ch_color(16) == "갈색" {
        pass_count = pass_count + 1
    } else { print("[FAIL] T8 ch16 != P4/갈색") }

    // T9: ch_board boundary 8/9
    test_count = test_count + 1
    if ch_board(8) == "Cyton" && ch_board(9) == "Daisy" {
        pass_count = pass_count + 1
    } else { print("[FAIL] T9 board boundary") }

    // T10: scalp zone non-empty for all 16ch
    test_count = test_count + 1
    let mut all_zone = 1
    let mut ci = 1
    while ci <= N_CHAN {
        let z = scalp_zone(ch_label(ci))
        if z == "?" { all_zone = 0 }
        ci = ci + 1
    }
    if all_zone == 1 { pass_count = pass_count + 1 }
    else { print("[FAIL] T10 scalp_zone gap") }

    // ── F_CAPFIT_01/02/03 falsifier matrix (synthetic) ───────────────
    // F1: 16/16 GOOD strict pass
    test_count = test_count + 1
    let v1 = evaluate(16, 0, 0, 0, 0)
    if v1.f1_strict == 1 && v1.f2 == 1 && v1.f3 == 1 && v1.pass == 1 {
        pass_count = pass_count + 1
    } else { print("[FAIL] F_CAPFIT_01 strict 16/16 GOOD") }

    // F1L: 14 GOOD + 2 WARN lenient pass
    test_count = test_count + 1
    let v1l = evaluate(14, 2, 0, 0, 1)
    if v1l.f1_lenient == 1 && v1l.f1_strict == 0 && v1l.pass == 1 {
        pass_count = pass_count + 1
    } else { print("[FAIL] F_CAPFIT_01 lenient 14G+2W") }

    // F1S_REJECT: 14 GOOD + 2 WARN strict mode → fail
    test_count = test_count + 1
    let v1sr = evaluate(14, 2, 0, 0, 0)
    if v1sr.pass == 0 { pass_count = pass_count + 1 }
    else { print("[FAIL] F_CAPFIT_01 strict 14G+2W must FAIL") }

    // F2: 1 RAILED → fail (both modes)
    test_count = test_count + 1
    let v2 = evaluate(15, 0, 1, 0, 0)
    let v2l = evaluate(15, 0, 1, 0, 1)
    if v2.f2 == 0 && v2.pass == 0 && v2l.pass == 0 {
        pass_count = pass_count + 1
    } else { print("[FAIL] F_CAPFIT_02 1 RAILED") }

    // F3: 1 FLAT → fail (both modes)
    test_count = test_count + 1
    let v3 = evaluate(15, 0, 0, 1, 0)
    let v3l = evaluate(15, 0, 0, 1, 1)
    if v3.f3 == 0 && v3.pass == 0 && v3l.pass == 0 {
        pass_count = pass_count + 1
    } else { print("[FAIL] F_CAPFIT_03 1 FLAT") }

    // T15: fix_hint non-empty for RAILED + FLAT
    test_count = test_count + 1
    let h_rail = fix_hint(2, "O1")
    let h_flat = fix_hint(3, "O1")
    if h_rail != "" && h_flat != "" {
        pass_count = pass_count + 1
    } else { print("[FAIL] T15 fix_hint gap") }

    print("[selftest] " + str(pass_count) + " PASS / "
          + str(test_count - pass_count) + " FAIL")

    // Emit canonical sentinel from F1 success path
    let v_ok = evaluate(N_CHAN, 0, 0, 0, 0)
    emit_sentinel(v_ok)

    if pass_count == test_count {
        print("__CAP_FIT_VERIFY_SELFTEST__ PASS")
        return 0
    }
    print("__CAP_FIT_VERIFY_SELFTEST__ FAIL")
    return 1
}

// ════════════════════════════════════════════════════════════════════
// Argv dispatch
// ════════════════════════════════════════════════════════════════════

fn print_usage() {
    print("usage:")
    print("  hexa run anima-eeg/protocols/cap_fit_verify.hexa --run \\")
    print("       --port <path> --board <name> [--duration <n>] [--voice <name>] [--lenient]")
    print("  hexa run anima-eeg/protocols/cap_fit_verify.hexa --selftest")
    print("flags:")
    print("  --selftest          no-hardware dry-run + falsifier matrix")
    print("  --run               5s capture + rail_flat per-channel verify")
    print("  --port <path>       Dongle serial node (default " + DEFAULT_PORT + ")")
    print("  --board <name>      cyton_daisy | cyton (default " + DEFAULT_BOARD + ")")
    print("  --duration <n>      capture sec (default " + str(DEFAULT_DURATION_S) + ")")
    print("  --voice <name>      macOS say voice (default " + DEFAULT_VOICE + ")")
    print("  --gain <n>          ADS1299 gain (default " + str(DEFAULT_GAIN) + ")")
    print("  --lenient           WARN tolerated (RAILED/FLAT only fail)")
    print("  --help              this message")
}

fn main() -> int {
    let av = argv()
    let n = len(av)

    let mut mode = "help"
    let mut port = DEFAULT_PORT
    let mut board = DEFAULT_BOARD
    let mut duration = DEFAULT_DURATION_S
    let mut voice = DEFAULT_VOICE
    let mut gain = DEFAULT_GAIN
    let mut lenient = 0

    // skip leading interpreter/file/cache paths
    let mut start = 0
    while start < n {
        let a = av[start]
        if a.ends_with(".hexa") { start = start + 1 }
        else { break }
    }
    while start < n {
        let a = av[start]
        if a.ends_with("/exe") { start = start + 1 }
        else { break }
    }

    let mut i = start
    while i < n {
        let a = av[i]
        if a == "--selftest" { mode = "selftest" }
        else if a == "--run" { mode = "run" }
        else if a == "--port" {
            if i + 1 < n { port = av[i + 1]; i = i + 1 }
        }
        else if a == "--board" {
            if i + 1 < n { board = av[i + 1]; i = i + 1 }
        }
        else if a == "--duration" {
            if i + 1 < n { duration = int_parse(av[i + 1]); i = i + 1 }
        }
        else if a == "--voice" {
            if i + 1 < n { voice = av[i + 1]; i = i + 1 }
        }
        else if a == "--gain" {
            if i + 1 < n { gain = int_parse(av[i + 1]); i = i + 1 }
        }
        else if a == "--lenient" { lenient = 1 }
        else if a == "--help" { mode = "help" }
        else {
            print("[error] unknown flag: " + a)
            print_usage()
            return 2
        }
        i = i + 1
    }

    if mode == "selftest" {
        return cmd_selftest()
    }
    if mode == "run" {
        return cmd_run(port, board, duration, voice, lenient, gain)
    }
    print_usage()
    return 0
}
