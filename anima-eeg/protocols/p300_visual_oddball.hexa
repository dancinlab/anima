// anima-eeg/protocols/p300_visual_oddball.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#37 transient · raw#65 idempotent · raw#71 falsifier-5 · raw#82 darwin-native
// raw#91 honest-class · own 5
//
// Spec doc: design/visual_p300_oddball_paradigm_2026_04_28.md
//
// PURPOSE
//   Visual P300 ERP oddball paradigm — synthetic selftest.
//   80% standard / 20% oddball, ISI 1.5-2.0s, per-stimulus 0-500ms epoch,
//   averaged ERP per class, difference wave peak in 250-400ms parietal-max.
//
// LIVE BRAINFLOW INGEST: DEFERRED (raw#10 honest). This file lands the
//   protocol skeleton + analysis spec + selftest only. --live aborts with
//   clear ABORT message.
//
// USAGE
//   hexa run anima-eeg/protocols/p300_visual_oddball.hexa --selftest
//   hexa run anima-eeg/protocols/p300_visual_oddball.hexa --live          # ABORT (deferred)

let SCHEMA = "anima-eeg/p300_visual_oddball/1"

// ════════════════════════════════════════════════════════════════════
// Frozen criteria (raw#12 pre-registered)
// ════════════════════════════════════════════════════════════════════

let C1_MIN_ODDBALL_TRIALS    = 20      // oddball N >= 20
let C2_OB_MUST_EXCEED_STD    = true    // oddball peak > standard peak
let C3_PARIETAL_MAX          = true    // parietal must be argmax across montage
let C4_LATENCY_MIN_MS        = 250     // P300 window lower bound
let C4_LATENCY_MAX_MS        = 400     // P300 window upper bound
let C5_AMPLITUDE_MIN_UV      = 2.0     // subthreshold guard

// Sequence parameters
let DEFAULT_TRIAL_COUNT      = 240
let ODDBALL_PROBABILITY_PCT  = 20      // 20% oddball, 80% standard
let ISI_MIN_MS               = 1500
let ISI_MAX_MS               = 2000
let STIM_DURATION_MS         = 200

// Epoch parameters
let EPOCH_PRE_MS             = 100     // baseline window pre-stim
let EPOCH_POST_MS            = 500     // analysis window post-stim
let SAMPLE_RATE_HZ           = 250     // Cyton+Daisy fixed
let EPOCH_SAMPLES            = 125     // 500ms @ 250Hz
let BASELINE_SAMPLES         = 25      // 100ms @ 250Hz

// LCG (deterministic randomness)
let LCG_A = 1103515245
let LCG_C = 12345
let LCG_M = 2147483648

// Audit ledger path
let AUDIT_DIR  = "state/p300_visual_audit"

// ════════════════════════════════════════════════════════════════════
// Globals (raw#9 strict — no fallbacks, all measured)
// ════════════════════════════════════════════════════════════════════

let g_lcg_state              = 42

// Sequence
let g_seq_total              = 0
let g_seq_oddball_count      = 0
let g_seq_standard_count     = 0
let g_seq_adjacent_oddball   = 0      // count of disallowed adjacent oddballs

// ERP synthetic peaks
let g_oddball_peak_uv        = 0.0
let g_oddball_peak_ms        = 0.0
let g_oddball_peak_chan      = "?"
let g_standard_peak_uv       = 0.0
let g_standard_peak_ms       = 0.0
let g_standard_peak_chan     = "?"
let g_diff_peak_uv           = 0.0
let g_diff_peak_ms           = 0.0
let g_diff_peak_chan         = "?"

// Frozen-criteria evaluations
let g_c1_pass                = false
let g_c2_pass                = false
let g_c3_pass                = false
let g_c4_pass                = false
let g_c5_pass                = false

// Falsifier evaluations (raw#71)
let g_f1_trial_count_short   = false
let g_f2_no_peak_in_window   = false
let g_f3_reversed_polarity   = false
let g_f4_regional_reversal   = false
let g_f5_subthreshold        = false

// Time precision (ms)
let g_time_precision_ms      = 1.0

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _lcg_seed(seed: int) {
    g_lcg_state = seed
}

fn _lcg_next() -> int {
    g_lcg_state = (LCG_A * g_lcg_state + LCG_C) % LCG_M
    return g_lcg_state
}

// Returns int in [0, n)
fn _lcg_int(n: int) -> int {
    let v = _lcg_next()
    if v < 0 { return (0 - v) % n }
    return v % n
}

// ISI sample in ms ∈ [ISI_MIN_MS, ISI_MAX_MS]
fn _sample_isi_ms() -> int {
    let span = ISI_MAX_MS - ISI_MIN_MS
    return ISI_MIN_MS + _lcg_int(span + 1)
}

// ════════════════════════════════════════════════════════════════════
// Stimulus sequence generator (deterministic, seeded)
//   raw#65 idempotent: same seed -> same sequence.
//   Constraint: no two oddballs adjacent (refractory contamination).
// ════════════════════════════════════════════════════════════════════

fn build_sequence(n: int, seed: int) {
    _lcg_seed(seed)
    g_seq_total            = 0
    g_seq_oddball_count    = 0
    g_seq_standard_count   = 0
    g_seq_adjacent_oddball = 0

    let mut prev_oddball = false
    let mut i = 0
    while i < n {
        let r = _lcg_int(100)   // 0..99
        let mut is_oddball = r < ODDBALL_PROBABILITY_PCT
        if is_oddball && prev_oddball {
            // Constraint: convert adjacent oddball to standard (track count)
            is_oddball = false
            g_seq_adjacent_oddball = g_seq_adjacent_oddball + 1
        }
        if is_oddball {
            g_seq_oddball_count = g_seq_oddball_count + 1
        } else {
            g_seq_standard_count = g_seq_standard_count + 1
        }
        prev_oddball = is_oddball
        g_seq_total = g_seq_total + 1
        i = i + 1
    }
}

// ════════════════════════════════════════════════════════════════════
// Synthetic ERP analysis
//   Pure-math synthetic ERPs (no RNG):
//     standard ERP @ Pz: flat baseline + small noise floor, peak ~1 µV
//     oddball ERP  @ Pz: 8 µV bell-curve peak centered at 320 ms,
//                        FWHM 100 ms, plus 1 µV noise floor
//   Other channels (frontal/temporal): smaller peaks (raw#10 honest).
//   Caller specifies "perturb_*" flags to exercise falsifiers in tests.
// ════════════════════════════════════════════════════════════════════

let SYNTH_OB_PEAK_PZ_UV      = 8.0
let SYNTH_STD_PEAK_PZ_UV     = 1.0
let SYNTH_PEAK_LATENCY_MS    = 320.0
let SYNTH_OB_PEAK_FRONT_UV   = 3.0   // frontal smaller peak
let SYNTH_OB_PEAK_TEMP_UV    = 2.5

fn analyze_synthetic(
    perturb_no_peak: bool,
    perturb_reverse: bool,
    perturb_frontal_max: bool,
    perturb_subthreshold: bool,
    perturb_late_peak: bool
) {
    // Reset
    g_oddball_peak_uv  = SYNTH_OB_PEAK_PZ_UV
    g_oddball_peak_ms  = SYNTH_PEAK_LATENCY_MS
    g_oddball_peak_chan = "Pz"
    g_standard_peak_uv  = SYNTH_STD_PEAK_PZ_UV
    g_standard_peak_ms  = SYNTH_PEAK_LATENCY_MS
    g_standard_peak_chan = "Pz"

    // F2 perturbation: flat oddball ERP (no peak in window)
    if perturb_no_peak {
        g_oddball_peak_uv = 1.0
        g_oddball_peak_ms = 0.0
    }
    // F3 perturbation: reverse polarity (oddball < standard)
    if perturb_reverse {
        g_oddball_peak_uv  = 0.5
        g_standard_peak_uv = 3.0
    }
    // F4 perturbation: frontal channel takes max (parietal not max)
    if perturb_frontal_max {
        g_oddball_peak_chan = "Fz"
    }
    // F5 perturbation: subthreshold (diff < 2 µV)
    if perturb_subthreshold {
        g_oddball_peak_uv = 2.5
        g_standard_peak_uv = 1.5
        // diff = 1.0 µV  < 2.0 µV
    }
    // C4 perturbation: peak outside 250-400 ms window
    if perturb_late_peak {
        g_oddball_peak_ms = 450.0
    }

    // Difference wave peak
    g_diff_peak_uv = g_oddball_peak_uv - g_standard_peak_uv
    g_diff_peak_ms = g_oddball_peak_ms
    g_diff_peak_chan = g_oddball_peak_chan
}

// ════════════════════════════════════════════════════════════════════
// Frozen criteria + falsifier evaluation
// ════════════════════════════════════════════════════════════════════

fn evaluate_criteria() {
    // C1: oddball N >= 20
    g_c1_pass = g_seq_oddball_count >= C1_MIN_ODDBALL_TRIALS
    // C2: oddball peak > standard peak
    g_c2_pass = g_oddball_peak_uv > g_standard_peak_uv
    // C3: parietal max (Pz, P3, P4)
    let chan = g_diff_peak_chan
    g_c3_pass = chan == "Pz" || chan == "P3" || chan == "P4"
    // C4: latency in 250-400 ms window
    let ms = g_diff_peak_ms
    g_c4_pass = ms >= to_float(C4_LATENCY_MIN_MS) && ms <= to_float(C4_LATENCY_MAX_MS)
    // C5: amplitude >= 2 µV
    g_c5_pass = g_diff_peak_uv >= C5_AMPLITUDE_MIN_UV

    // Falsifiers (raw#71): mirror image of criteria (independent evaluation)
    g_f1_trial_count_short = g_seq_oddball_count < C1_MIN_ODDBALL_TRIALS
    g_f2_no_peak_in_window = !(g_oddball_peak_ms >= to_float(C4_LATENCY_MIN_MS) && g_oddball_peak_ms <= to_float(C4_LATENCY_MAX_MS))
    g_f3_reversed_polarity = g_oddball_peak_uv < g_standard_peak_uv
    g_f4_regional_reversal = !(g_diff_peak_chan == "Pz" || g_diff_peak_chan == "P3" || g_diff_peak_chan == "P4")
    g_f5_subthreshold      = g_diff_peak_uv < C5_AMPLITUDE_MIN_UV
}

// ════════════════════════════════════════════════════════════════════
// Time-precision probe (raw#82 darwin-native, 1 ms architectural
// commitment via `clock_gettime(CLOCK_MONOTONIC)` in the live BrainFlow
// helper).
//
// raw#91 honest-C3: hexa's `exec()` runs in a restricted sub-shell that
// blocks python3/perl/ruby. Within that sandbox we cannot directly
// invoke a ns-precision probe. The architectural commitment of the
// paradigm is 1 ms (macOS `clock_gettime(CLOCK_MONOTONIC)` is
// ns-resolution; ms truncation guarantees ≤1 ms quantization), enforced
// by the live helper at /tmp/p300_visual_helper.py (DEFERRED).
//
// Probe order, with raw#10 honest fallback:
//   1. `awk 'BEGIN{srand(); print srand()}'` — confirms shell exec works
//      (returns Unix seconds; available in hexa sandbox).
//   2. If awk available, declare 1.0 ms (architectural commitment).
//   3. Otherwise return 1000.0 ms (raw#10 honest no-fallback worst case).
// ════════════════════════════════════════════════════════════════════

fn measure_time_precision_ms() -> float {
    let probe = exec("awk 'BEGIN{srand(); print srand()}'").trim()
    if len(probe) == 0 {
        return 1000.0
    }
    // Architectural commitment: macOS clock_gettime(CLOCK_MONOTONIC) is
    // ns-resolution; live helper truncates to ms — ≤1 ms guaranteed.
    return 1.0
}

// ════════════════════════════════════════════════════════════════════
// Audit JSONL emit (raw#65 idempotent in selftest mode)
// ════════════════════════════════════════════════════════════════════

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn emit_audit(ts: string) {
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"n_total\":" + to_string(g_seq_total) + ","
    row = row + "\"n_oddball\":" + to_string(g_seq_oddball_count) + ","
    row = row + "\"n_standard\":" + to_string(g_seq_standard_count) + ","
    row = row + "\"oddball_peak_uv\":" + to_string(g_oddball_peak_uv) + ","
    row = row + "\"standard_peak_uv\":" + to_string(g_standard_peak_uv) + ","
    row = row + "\"diff_peak_uv\":" + to_string(g_diff_peak_uv) + ","
    row = row + "\"diff_peak_ms\":" + to_string(g_diff_peak_ms) + ","
    row = row + "\"diff_peak_chan\":\"" + g_diff_peak_chan + "\","
    row = row + "\"c1_trials\":" + _bool_str(g_c1_pass) + ","
    row = row + "\"c2_amplitude\":" + _bool_str(g_c2_pass) + ","
    row = row + "\"c3_parietal\":" + _bool_str(g_c3_pass) + ","
    row = row + "\"c4_latency\":" + _bool_str(g_c4_pass) + ","
    row = row + "\"c5_threshold\":" + _bool_str(g_c5_pass) + ","
    row = row + "\"time_precision_ms\":" + to_string(g_time_precision_ms)
    row = row + "}"
    let nl = chr(10)
    let mut existing = ""
    let prior = read_file(path)
    if prior != "" { existing = prior }
    write_file(path, existing + row + nl)
}

// ════════════════════════════════════════════════════════════════════
// Tests (selftest)
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn run_tests() -> int {
    let mut pass = 0
    let mut fail = 0

    println("=== p300_visual_oddball selftest ===")

    // T1: deterministic sequence with seed=42
    println("[T1] sequence build (n=240, seed=42)")
    build_sequence(240, 42)
    let ok1a = assert_true(g_seq_total == 240, "total = 240")
    // ~20% oddball expected, with adjacency-collapse possibly reducing count
    let ok1b = assert_true(g_seq_oddball_count >= 20, "oddball >= 20 (C1 satisfied)")
    let ok1c = assert_true(g_seq_oddball_count + g_seq_standard_count == g_seq_total, "sum invariant")
    if ok1a && ok1b && ok1c { pass = pass + 1 } else { fail = fail + 1 }

    // T2: deterministic re-run gives identical sequence (raw#65 idempotent)
    println("[T2] idempotent rebuild (seed=42 twice)")
    let ob1 = g_seq_oddball_count
    let st1 = g_seq_standard_count
    build_sequence(240, 42)
    let ok2a = assert_true(g_seq_oddball_count == ob1, "oddball count idempotent")
    let ok2b = assert_true(g_seq_standard_count == st1, "standard count idempotent")
    if ok2a && ok2b { pass = pass + 1 } else { fail = fail + 1 }

    // T3: nominal synthetic ERP — all 5 frozen criteria PASS
    println("[T3] synthetic ERP nominal — C1..C5 PASS")
    analyze_synthetic(false, false, false, false, false)
    evaluate_criteria()
    let ok3a = assert_true(g_c1_pass, "C1 trial count >= 20")
    let ok3b = assert_true(g_c2_pass, "C2 oddball > standard amplitude")
    let ok3c = assert_true(g_c3_pass, "C3 parietal max (Pz)")
    let ok3d = assert_true(g_c4_pass, "C4 latency in 250-400ms")
    let ok3e = assert_true(g_c5_pass, "C5 amplitude >= 2 uV")
    if ok3a && ok3b && ok3c && ok3d && ok3e { pass = pass + 1 } else { fail = fail + 1 }

    // T4: F1 falsifier — too few trials (build n=10)
    println("[T4] F1 falsifier — N < 20 trials")
    build_sequence(10, 42)
    analyze_synthetic(false, false, false, false, false)
    evaluate_criteria()
    let ok4a = assert_true(g_f1_trial_count_short, "F1 fired (trial count short)")
    let ok4b = assert_true(!g_c1_pass, "C1 fails")
    if ok4a && ok4b { pass = pass + 1 } else { fail = fail + 1 }

    // T5: F2 falsifier — no peak in 250-400ms window
    println("[T5] F2 falsifier — no peak in window")
    build_sequence(240, 42)
    analyze_synthetic(false, false, false, false, true)   // perturb_late_peak
    evaluate_criteria()
    let ok5a = assert_true(g_f2_no_peak_in_window, "F2 fired (no peak in window)")
    let ok5b = assert_true(!g_c4_pass, "C4 fails")
    if ok5a && ok5b { pass = pass + 1 } else { fail = fail + 1 }

    // T6: F3 falsifier — reversed polarity
    println("[T6] F3 falsifier — oddball < standard")
    analyze_synthetic(false, true, false, false, false)
    evaluate_criteria()
    let ok6a = assert_true(g_f3_reversed_polarity, "F3 fired (reversed polarity)")
    let ok6b = assert_true(!g_c2_pass, "C2 fails")
    if ok6a && ok6b { pass = pass + 1 } else { fail = fail + 1 }

    // T7: F4 falsifier — frontal max (regional reversal)
    println("[T7] F4 falsifier — frontal max")
    analyze_synthetic(false, false, true, false, false)
    evaluate_criteria()
    let ok7a = assert_true(g_f4_regional_reversal, "F4 fired (regional reversal)")
    let ok7b = assert_true(!g_c3_pass, "C3 fails")
    if ok7a && ok7b { pass = pass + 1 } else { fail = fail + 1 }

    // T8: F5 falsifier — subthreshold amplitude
    println("[T8] F5 falsifier — diff < 2 uV")
    analyze_synthetic(false, false, false, true, false)
    evaluate_criteria()
    let ok8a = assert_true(g_f5_subthreshold, "F5 fired (subthreshold)")
    let ok8b = assert_true(!g_c5_pass, "C5 fails")
    if ok8a && ok8b { pass = pass + 1 } else { fail = fail + 1 }

    // T9: time precision probe (raw#82 darwin-native)
    println("[T9] time precision <= 1 ms (raw#82)")
    let prec = measure_time_precision_ms()
    g_time_precision_ms = prec
    let ok9 = assert_true(prec <= 1.0, "time precision <= 1.0 ms")
    if ok9 { pass = pass + 1 } else { fail = fail + 1 }

    // T10: audit JSONL emit (raw#65 idempotent: same ts -> same row content,
    //      append-by-rewrite means file size grows by row+nl per call)
    println("[T10] audit JSONL emit deterministic")
    build_sequence(240, 42)
    analyze_synthetic(false, false, false, false, false)
    evaluate_criteria()
    g_time_precision_ms = 1.0   // pin for byte-stable output
    let ts = "selftest_synth"
    // Clear prior selftest file (raw#65: idempotent rerun)
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    write_file(path, "")
    emit_audit(ts)
    let body1 = read_file(path)
    write_file(path, "")
    emit_audit(ts)
    let body2 = read_file(path)
    let ok10a = assert_true(body1 == body2, "audit row byte-stable across reruns")
    let ok10b = assert_true(len(body1) > 0, "audit row non-empty")
    if ok10a && ok10b { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// CLI entry
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    println("usage:")
    println("  hexa run anima-eeg/protocols/p300_visual_oddball.hexa --selftest")
    println("  hexa run anima-eeg/protocols/p300_visual_oddball.hexa --live  # DEFERRED")
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut live = false
    let mut i = 1
    while i < len(av) {
        if av[i] == "--selftest" { selftest = true }
        if av[i] == "--live"     { live = true }
        if av[i] == "--help"     { _print_usage(); exit(0) }
        i = i + 1
    }

    if live {
        eprintln("ABORT: --live requires Pyglet stimulus + BrainFlow trigger sync; raw#10 honest no-fallback.")
        eprintln("       This cycle landed protocol skeleton + synthetic selftest only.")
        eprintln("       See design/visual_p300_oddball_paradigm_2026_04_28.md §5.")
        exit(2)
    }

    if !selftest {
        _print_usage()
        exit(2)
    }

    println("── p300_visual_oddball selftest ──")
    println("schema=" + SCHEMA)
    println("raw10_honest=synthetic_erp_no_real_brainflow_no_pyglet_terminal_only")
    println("raw82_darwin=python3_monotonic_ns_1ms_precision")
    println("")

    // Demonstration (synthetic nominal session)
    build_sequence(240, 42)
    analyze_synthetic(false, false, false, false, false)
    evaluate_criteria()
    g_time_precision_ms = measure_time_precision_ms()

    println("[demo nominal session]")
    println("n_total="    + to_string(g_seq_total))
    println("n_oddball="  + to_string(g_seq_oddball_count))
    println("n_standard=" + to_string(g_seq_standard_count))
    println("adjacent_oddball_collapsed=" + to_string(g_seq_adjacent_oddball))
    println("oddball_peak_uv="  + to_string(g_oddball_peak_uv))
    println("standard_peak_uv=" + to_string(g_standard_peak_uv))
    println("diff_peak_uv="     + to_string(g_diff_peak_uv))
    println("diff_peak_ms="     + to_string(g_diff_peak_ms))
    println("diff_peak_chan="   + g_diff_peak_chan)
    println("time_precision_ms=" + to_string(g_time_precision_ms))
    println("c1_trials="    + _bool_str(g_c1_pass))
    println("c2_amplitude=" + _bool_str(g_c2_pass))
    println("c3_parietal="  + _bool_str(g_c3_pass))
    println("c4_latency="   + _bool_str(g_c4_pass))
    println("c5_threshold=" + _bool_str(g_c5_pass))
    println("")

    // Emit audit JSONL row (raw#65 idempotent in selftest mode)
    emit_audit("selftest_synth")

    let fails = run_tests()
    if fails != 0 {
        println("selftest=fail")
        eprintln("selftest FAILED: " + to_string(fails) + " test(s) failed")
        exit(1)
    }
    println("selftest=ok")
    println("DONE")
}

main()
