// anima-eeg/protocols/package_num_audit.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#15 no-personal-paths · raw#34 no-backup-files · raw#37 transient-helper-in-/tmp
// raw#65 idempotent · raw#66 ai-native error trailer · raw#71 falsifier-bound
// raw#80 sentinel · raw#82 darwin-native marker · raw#91 honest-class
//
// @resolver-bypass(reason="darwin-native: invokes .venv-eeg/bin/python which is a
//                   mac-local virtualenv hosting numpy + brainflow. Reads .npy +
//                   .meta.json sidecar emitted by anima-eeg/collect.hexa, locates
//                   the Cyton package_num row via BoardShim.get_package_num_channel
//                   and audits the 0-255 cyclic sequence for missing samples.
//                   selftest path is fully synthetic numpy + tempfile; works
//                   wherever .venv-eeg + numpy are present (Darwin host today).
//                   brainflow import is OPTIONAL — we fall back to meta.json
//                   `package_num_channel` when brainflow is absent.")
//
// PURPOSE  (raw#106 genus name)
//   Standalone Cyton/Cyton+Daisy `package_num` (sequence number) analyzer.
//   Detects silently-dropped samples that BrainFlow does NOT detect.
//
//   Background (2026-05-03 BrainFlow research BG adb7ceec):
//     • cyton_daisy.cpp inspects START_BYTE only — no sequence validation
//     • timestamp is PC-side at combined-package emit, not hardware clock
//     • → BrainFlow may silently skip a packet on bus jitter; we cannot
//       detect this from the EEG sample matrix alone (constant-Hz NaN-fill
//       hides the gap). The Cyton firmware emits a 0-255 cyclic
//       `package_num` byte per packet; auditing diffs gives us a true
//       drop count.
//
//   Sister modules (separate cycles, NO touch in this file):
//     • protocols/sample_rate_guard.hexa  — duration / cols / fs gate
//     • collect.hexa                      — capture loop (root-cause BG)
//   Integration into collect.hexa post-capture is a follow-up cycle item.
//
// API
//   hexa run anima-eeg/protocols/package_num_audit.hexa --selftest
//
//   hexa run anima-eeg/protocols/package_num_audit.hexa \
//        --input <raw.npy> [--threshold-loss-pct <n>] \
//        [--strict | --lenient]
//
//   Threshold default 5.0 % (lenient — α-band paradigms tolerate this).
//
// FALSIFIERS  (raw#71 frozen 2026-05-03)
//   F_PKG_01: dropout_rate_pct  < threshold_loss_pct (default 5%)
//   F_PKG_02: largest_gap       < 10 packets (catastrophic burst loss)
//   F_PKG_03: actual_fs_hz      ≥ 100 Hz   (= 80% of Cyton+Daisy 125 Hz)
//
//   strict mode (default): F_PKG_01 AND F_PKG_02 AND F_PKG_03 → PASS
//                          FAIL → exit 1 (non-zero)
//   lenient mode (--lenient): warn-only, exit 0
//
// SENTINEL
//   __EEG_PACKAGE_NUM__ <PASS|FAIL> <dropout_pct> <largest_gap>
//
// HONEST C3 CAVEATS  (raw#10)
//   1. package_num is an 8-bit byte (0-255) and wraps. We compute the
//      diff modulo 256, so wrap is *not* counted as drop. The cost is
//      that a true gap of exactly 256 packets aliases to 0 and is
//      invisible. At Cyton+Daisy 125 Hz this would require a 2.05 s
//      stall — unlikely in practice but documented as a known blind
//      spot. F_PKG_02 (largest_gap < 10) provides defence-in-depth
//      against bursts smaller than the wrap horizon.
//   2. The package_num row index depends on board_id (Cyton-only ≠
//      Cyton+Daisy). We resolve via BoardShim.get_package_num_channel
//      when brainflow is importable; otherwise we fall back to a meta
//      key `package_num_channel` written by collect.hexa. If neither is
//      available we emit a hard error trailer rather than guess — raw#10
//      forbids silent C-class assumption.
//   3. BrainFlow itself does NOT detect sample drops — it emits PC-side
//      timestamps and silently skips bus-jittered packets. Therefore
//      "package_num gap" is the ground truth we lean on; it is the
//      firmware-side counter, not a wrapper-side reconstruction. If the
//      firmware were ever to lie we would have no recourse from the npy
//      alone. (Documented limitation; raw#10 honest-class C3.)
//
// USAGE
//   # default 5% loss threshold, strict
//   hexa run anima-eeg/protocols/package_num_audit.hexa \
//        --input anima-eeg/recordings/sessions/blink_session_90s_2026_05_03.npy \
//        --strict --threshold-loss-pct 5
//
//   # lenient warn-only
//   hexa run anima-eeg/protocols/package_num_audit.hexa \
//        --input anima-eeg/recordings/sessions/berger_ec_60s_2026_05_03.npy \
//        --lenient --threshold-loss-pct 10
//
// FOLLOW-UP (raw#10 — not done here, separate cycle):
//   • integrate into anima-eeg/collect.hexa post-capture hook alongside
//     sample_rate_guard.hexa; combined quality gate
//   • add as Step 6 in anima-eeg/protocols/master_preflight.hexa
//   • emit per-session audit summary into state/eeg_session_audit/

let SCHEMA      = "anima-eeg/package_num_audit/1"
let HELPER_PATH = "/tmp/anima_eeg_package_num_audit_helper.py"

// ════════════════════════════════════════════════════════════════════
// Frozen defaults (raw#12)
// ════════════════════════════════════════════════════════════════════

let DEFAULT_VENV_PYTHON              = ".venv-eeg/bin/python"
let DEFAULT_THRESHOLD_LOSS_PCT       = 5.0       // F_PKG_01 default
let F_PKG_02_MAX_GAP                 = 10        // F_PKG_02 burst gate
let F_PKG_03_MIN_ACTUAL_FS_HZ        = 100.0     // F_PKG_03 (80% of 125 Hz)

// Selftest synthetic params
let SELFTEST_PACKETS_GOOD            = 7500      // 60 s × 125 Hz
let SELFTEST_DROP_FEW                = 50        // ~0.66% loss
let SELFTEST_DROP_MANY               = 2000      // ~21% loss
let SELFTEST_BURST_GAP               = 25        // single 25-packet stall
let SELFTEST_DURATION_S              = 60

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

// ════════════════════════════════════════════════════════════════════
// Helper python emitter (raw#37 transient)
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima-eeg package_num_audit helper — emitted by\n")
    parts.push("# anima-eeg/protocols/package_num_audit.hexa (raw#37 transient).\n")
    parts.push("import argparse, json, os, subprocess, sys, tempfile, textwrap\n\n")

    parts.push("VENV_PYTHON                  = '" + DEFAULT_VENV_PYTHON + "'\n")
    parts.push("DEFAULT_THRESHOLD_LOSS_PCT   = " + to_string(DEFAULT_THRESHOLD_LOSS_PCT) + "\n")
    parts.push("F_PKG_02_MAX_GAP             = " + str(F_PKG_02_MAX_GAP) + "\n")
    parts.push("F_PKG_03_MIN_ACTUAL_FS_HZ    = " + to_string(F_PKG_03_MIN_ACTUAL_FS_HZ) + "\n")
    parts.push("SELFTEST_PACKETS_GOOD        = " + str(SELFTEST_PACKETS_GOOD) + "\n")
    parts.push("SELFTEST_DROP_FEW            = " + str(SELFTEST_DROP_FEW) + "\n")
    parts.push("SELFTEST_DROP_MANY           = " + str(SELFTEST_DROP_MANY) + "\n")
    parts.push("SELFTEST_BURST_GAP           = " + str(SELFTEST_BURST_GAP) + "\n")
    parts.push("SELFTEST_DURATION_S          = " + str(SELFTEST_DURATION_S) + "\n\n")

    parts.push("def emit_trailer(slug, detail, fix):\n")
    parts.push("    sys.stderr.write(f'reason: {slug}: {detail}\\n')\n")
    parts.push("    sys.stderr.write(f'fix: {fix}\\n')\n\n")

    parts.push("def verify_numpy():\n")
    parts.push("    if not os.path.exists(VENV_PYTHON):\n")
    parts.push("        emit_trailer('venv-missing',\n")
    parts.push("                     f'{VENV_PYTHON} not found',\n")
    parts.push("                     '1) python3 -m venv .venv-eeg  '\n")
    parts.push("                     '2) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '3) pip install --upgrade numpy brainflow')\n")
    parts.push("        return False\n")
    parts.push("    r = subprocess.run([VENV_PYTHON, '-c', 'import numpy; print(\"ok\")'],\n")
    parts.push("                       capture_output=True, text=True, timeout=20)\n")
    parts.push("    if r.returncode != 0:\n")
    parts.push("        emit_trailer('numpy-missing',\n")
    parts.push("                     f'numpy import failed: {r.stderr.strip()[:200]}',\n")
    parts.push("                     '1) source .venv-eeg/bin/activate  '\n")
    parts.push("                     '2) pip install --upgrade numpy')\n")
    parts.push("        return False\n")
    parts.push("    return True\n\n")

    // ─── verify payload (runs inside .venv-eeg python) ──────────────────
    parts.push("VERIFY_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, os, sys\n")
    parts.push("    import numpy as np\n")
    parts.push("    INPUT          = sys.argv[1]\n")
    parts.push("    THRESHOLD_PCT  = float(sys.argv[2])\n")
    parts.push("    F02_MAX_GAP    = int(sys.argv[3])\n")
    parts.push("    F03_MIN_FS     = float(sys.argv[4])\n")
    parts.push("    META_PATH      = INPUT + '.meta.json'\n")
    parts.push("    out = {\n")
    parts.push("        'schema': 'anima-eeg/package_num_audit/1',\n")
    parts.push("        'input': INPUT,\n")
    parts.push("        'meta_path': META_PATH,\n")
    parts.push("        'threshold_loss_pct': THRESHOLD_PCT,\n")
    parts.push("        'package_num_row': -1,\n")
    parts.push("        'row_source': 'unknown',\n")
    parts.push("        'board_id': None,\n")
    parts.push("        'rows': 0, 'cols': 0,\n")
    parts.push("        'total_packets_received': 0,\n")
    parts.push("        'total_packets_dropped': 0,\n")
    parts.push("        'dropout_rate_pct': 0.0,\n")
    parts.push("        'duration_s': 0.0,\n")
    parts.push("        'duration_source': 'unknown',\n")
    parts.push("        'effective_fs_hz': 0.0,\n")
    parts.push("        'actual_fs_hz': 0.0,\n")
    parts.push("        'sample_rate_claimed_hz': 0.0,\n")
    parts.push("        'largest_gap': 0,\n")
    parts.push("        'gap_distribution': {},\n")
    parts.push("        'f01_pass': False,\n")
    parts.push("        'f02_pass': False,\n")
    parts.push("        'f03_pass': False,\n")
    parts.push("        'overall': False,\n")
    parts.push("    }\n")
    parts.push("    if not os.path.exists(INPUT):\n")
    parts.push("        out['error'] = 'input-missing'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    if not os.path.exists(META_PATH):\n")
    parts.push("        out['error'] = 'meta-missing'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        arr = np.load(INPUT)\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        out['error'] = f'npy-load-failed: {exc!r}'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    if arr.ndim == 1:\n")
    parts.push("        arr = arr.reshape(1, -1)\n")
    parts.push("    rows, cols = int(arr.shape[0]), int(arr.shape[1])\n")
    parts.push("    out['rows'] = rows; out['cols'] = cols\n")
    parts.push("    try:\n")
    parts.push("        with open(META_PATH, 'r') as fh:\n")
    parts.push("            meta = json.load(fh)\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        out['error'] = f'meta-parse-failed: {exc!r}'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    board_id = meta.get('board_id', None)\n")
    parts.push("    out['board_id'] = board_id\n")
    parts.push("    out['sample_rate_claimed_hz'] = float(meta.get('sample_rate_claimed_hz',\n")
    parts.push("                                                    meta.get('sample_rate', 0.0)))\n")
    parts.push("    # ── package_num row resolution (raw#10 honest C3 #2) ─────────\n")
    parts.push("    pkg_row = -1\n")
    parts.push("    row_source = 'unknown'\n")
    parts.push("    # 1) prefer brainflow API when board_id known and brainflow importable\n")
    parts.push("    if board_id is not None:\n")
    parts.push("        try:\n")
    parts.push("            from brainflow.board_shim import BoardShim\n")
    parts.push("            pkg_row = int(BoardShim.get_package_num_channel(int(board_id)))\n")
    parts.push("            row_source = 'brainflow.get_package_num_channel'\n")
    parts.push("        except Exception:\n")
    parts.push("            pkg_row = -1\n")
    parts.push("    # 2) fallback to meta key written by collect.hexa\n")
    parts.push("    if pkg_row < 0 and 'package_num_channel' in meta:\n")
    parts.push("        try:\n")
    parts.push("            pkg_row = int(meta['package_num_channel'])\n")
    parts.push("            row_source = 'meta.package_num_channel'\n")
    parts.push("        except Exception:\n")
    parts.push("            pkg_row = -1\n")
    parts.push("    if pkg_row < 0 or pkg_row >= rows:\n")
    parts.push("        out['error'] = ('package-num-row-unresolvable: '\n")
    parts.push("                        f'board_id={board_id} rows={rows} '\n")
    parts.push("                        f'meta_has_package_num_channel='\n")
    parts.push("                        f'{\"package_num_channel\" in meta}')\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    out['package_num_row'] = pkg_row\n")
    parts.push("    out['row_source'] = row_source\n")
    parts.push("    pkg = arr[pkg_row].astype(np.int64)\n")
    parts.push("    n_packets = int(pkg.shape[0])\n")
    parts.push("    if n_packets < 2:\n")
    parts.push("        out['error'] = f'too-few-packets: n={n_packets}'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    # ── sequence diff (raw#10 honest C3 #1: mod 256 wrap) ────────\n")
    parts.push("    diff = (pkg[1:] - pkg[:-1]) % 256\n")
    parts.push("    # expected diff per consecutive packet = 1\n")
    parts.push("    # missing = sum(diff - 1) for diff >= 1 (diff == 0 is a duplicate, skip)\n")
    parts.push("    valid_mask = diff >= 1\n")
    parts.push("    dropped_per_step = (diff[valid_mask] - 1).astype(np.int64)\n")
    parts.push("    total_dropped = int(dropped_per_step.sum())\n")
    parts.push("    largest_gap = int(diff.max()) if diff.size > 0 else 1\n")
    parts.push("    # gap histogram — top 16 buckets (raw#10: bounded output)\n")
    parts.push("    uniq, counts = np.unique(diff, return_counts=True)\n")
    parts.push("    gap_dist = {int(k): int(v) for k, v in zip(uniq.tolist(), counts.tolist())}\n")
    parts.push("    out['total_packets_received'] = n_packets\n")
    parts.push("    out['total_packets_dropped']  = total_dropped\n")
    parts.push("    total_expected = n_packets + total_dropped\n")
    parts.push("    if total_expected > 0:\n")
    parts.push("        out['dropout_rate_pct'] = round(total_dropped / total_expected * 100.0, 4)\n")
    parts.push("    out['largest_gap'] = largest_gap\n")
    parts.push("    out['gap_distribution'] = gap_dist\n")
    parts.push("    # duration: prefer duration_actual_s, fallback duration_requested_s\n")
    parts.push("    dur_actual = float(meta.get('duration_actual_s', 0.0))\n")
    parts.push("    dur_req    = float(meta.get('duration_requested_s', 0.0))\n")
    parts.push("    if dur_actual > 0.0:\n")
    parts.push("        dur = dur_actual; dur_src = 'duration_actual_s'\n")
    parts.push("    elif dur_req > 0.0:\n")
    parts.push("        dur = dur_req; dur_src = 'duration_requested_s'\n")
    parts.push("    else:\n")
    parts.push("        out['error'] = 'no-duration-in-meta'\n")
    parts.push("        print(json.dumps(out)); sys.exit(2)\n")
    parts.push("    out['duration_s'] = dur\n")
    parts.push("    out['duration_source'] = dur_src\n")
    parts.push("    out['effective_fs_hz'] = round(n_packets / dur, 4)\n")
    parts.push("    out['actual_fs_hz']    = round(total_expected / dur, 4)\n")
    parts.push("    # F_PKG_01: dropout < threshold\n")
    parts.push("    out['f01_pass'] = bool(out['dropout_rate_pct'] < THRESHOLD_PCT)\n")
    parts.push("    # F_PKG_02: largest gap < F02_MAX_GAP\n")
    parts.push("    out['f02_pass'] = bool(largest_gap < F02_MAX_GAP)\n")
    parts.push("    # F_PKG_03: actual_fs (corrected for drops) >= floor\n")
    parts.push("    out['f03_pass'] = bool(out['actual_fs_hz'] >= F03_MIN_FS)\n")
    parts.push("    out['overall'] = bool(out['f01_pass'] and out['f02_pass'] and out['f03_pass'])\n")
    parts.push("    print(json.dumps(out))\n")
    parts.push("    sys.exit(0 if out['overall'] else 1)\n")
    parts.push("''')\n\n")

    // ─── selftest payload: synthesize good + lossy + burst sequences ────
    parts.push("SELFTEST_PY = textwrap.dedent(r'''\n")
    parts.push("    import json, os, sys, tempfile\n")
    parts.push("    import numpy as np\n")
    parts.push("    N_GOOD       = int(sys.argv[1])\n")
    parts.push("    DROP_FEW     = int(sys.argv[2])\n")
    parts.push("    DROP_MANY    = int(sys.argv[3])\n")
    parts.push("    BURST_GAP    = int(sys.argv[4])\n")
    parts.push("    DUR_S        = int(sys.argv[5])\n")
    parts.push("    THRESHOLD    = float(sys.argv[6])\n")
    parts.push("    F02_MAX_GAP  = int(sys.argv[7])\n")
    parts.push("    F03_MIN_FS   = float(sys.argv[8])\n")
    parts.push("    tmpdir = tempfile.mkdtemp(prefix='anima_eeg_pkg_audit_')\n")
    parts.push("    PKG_ROW = 31  # mimic Cyton+Daisy package_num row index\n")
    parts.push("    N_ROWS  = 32\n")
    parts.push("    def synthesize(tag, drop_indices_set, n_total_expected):\n")
    parts.push("        # Build a 0..n_total_expected-1 % 256 sequence then delete dropped indices\n")
    parts.push("        seq = np.arange(n_total_expected, dtype=np.int64) % 256\n")
    parts.push("        keep = np.array([i for i in range(n_total_expected) if i not in drop_indices_set],\n")
    parts.push("                        dtype=np.int64)\n")
    parts.push("        kept = seq[keep]\n")
    parts.push("        arr = np.zeros((N_ROWS, kept.shape[0]), dtype=np.float64)\n")
    parts.push("        arr[PKG_ROW] = kept.astype(np.float64)\n")
    parts.push("        npy = os.path.join(tmpdir, tag + '.npy')\n")
    parts.push("        np.save(npy, arr)\n")
    parts.push("        meta = {\n")
    parts.push("            'schema': 'anima-eeg/collect/1',\n")
    parts.push("            'tag': tag,\n")
    parts.push("            'board_id': 2,  # Cyton+Daisy\n")
    parts.push("            'sample_rate_claimed_hz': 125.0,\n")
    parts.push("            'sample_rate': 125.0,\n")
    parts.push("            'rows': N_ROWS, 'cols': int(kept.shape[0]),\n")
    parts.push("            'duration_actual_s': float(DUR_S),\n")
    parts.push("            'duration_requested_s': float(DUR_S),\n")
    parts.push("            'package_num_channel': PKG_ROW,\n")
    parts.push("        }\n")
    parts.push("        with open(npy + '.meta.json', 'w') as fh:\n")
    parts.push("            json.dump(meta, fh, indent=2)\n")
    parts.push("        return npy\n")
    parts.push("    rng = np.random.default_rng(42)\n")
    parts.push("    # Case A: GOOD — no drops\n")
    parts.push("    npy_a = synthesize('case_a_good', set(), N_GOOD)\n")
    parts.push("    # Case B: FEW DROPS — random scattered, single-packet gaps only\n")
    parts.push("    drop_b = set(rng.choice(N_GOOD, size=DROP_FEW, replace=False).tolist())\n")
    parts.push("    npy_b = synthesize('case_b_few_drops', drop_b, N_GOOD)\n")
    parts.push("    # Case C: MANY DROPS — large fraction\n")
    parts.push("    drop_c = set(rng.choice(N_GOOD, size=DROP_MANY, replace=False).tolist())\n")
    parts.push("    npy_c = synthesize('case_c_many_drops', drop_c, N_GOOD)\n")
    parts.push("    # Case D: BURST GAP — single contiguous chunk of BURST_GAP missing\n")
    parts.push("    burst_start = N_GOOD // 2\n")
    parts.push("    drop_d = set(range(burst_start, burst_start + BURST_GAP))\n")
    parts.push("    npy_d = synthesize('case_d_burst_gap', drop_d, N_GOOD)\n")
    parts.push("    def evaluate(npy):\n")
    parts.push("        meta_path = npy + '.meta.json'\n")
    parts.push("        with open(meta_path) as fh: meta = json.load(fh)\n")
    parts.push("        arr = np.load(npy)\n")
    parts.push("        if arr.ndim == 1: arr = arr.reshape(1, -1)\n")
    parts.push("        pkg_row = int(meta['package_num_channel'])\n")
    parts.push("        pkg = arr[pkg_row].astype(np.int64)\n")
    parts.push("        diff = (pkg[1:] - pkg[:-1]) % 256\n")
    parts.push("        total_dropped = int((diff[diff >= 1] - 1).sum())\n")
    parts.push("        n_pkts = int(pkg.shape[0])\n")
    parts.push("        n_expected = n_pkts + total_dropped\n")
    parts.push("        dropout_pct = total_dropped / n_expected * 100.0 if n_expected > 0 else 0.0\n")
    parts.push("        largest_gap = int(diff.max()) if diff.size > 0 else 1\n")
    parts.push("        dur = float(meta['duration_actual_s'])\n")
    parts.push("        actual_fs = n_expected / dur\n")
    parts.push("        f01 = bool(dropout_pct < THRESHOLD)\n")
    parts.push("        f02 = bool(largest_gap < F02_MAX_GAP)\n")
    parts.push("        f03 = bool(actual_fs >= F03_MIN_FS)\n")
    parts.push("        return {\n")
    parts.push("            'n_received': n_pkts, 'n_dropped': total_dropped,\n")
    parts.push("            'dropout_pct': round(dropout_pct, 4),\n")
    parts.push("            'largest_gap': largest_gap,\n")
    parts.push("            'actual_fs': round(actual_fs, 4),\n")
    parts.push("            'f01': f01, 'f02': f02, 'f03': f03,\n")
    parts.push("            'overall': bool(f01 and f02 and f03),\n")
    parts.push("        }\n")
    parts.push("    r_a = evaluate(npy_a)\n")
    parts.push("    r_b = evaluate(npy_b)\n")
    parts.push("    r_c = evaluate(npy_c)\n")
    parts.push("    r_d = evaluate(npy_d)\n")
    parts.push("    import shutil\n")
    parts.push("    try: shutil.rmtree(tmpdir)\n")
    parts.push("    except OSError: pass\n")
    parts.push("    # Expected matrix:\n")
    parts.push("    #   case_a_good         → all PASS\n")
    parts.push("    #   case_b_few_drops    → F_PKG_01 PASS (~0.66% < 5%) F_PKG_02 PASS F_PKG_03 PASS\n")
    parts.push("    #   case_c_many_drops   → F_PKG_01 FAIL (>5%) F_PKG_03 may FAIL\n")
    parts.push("    #   case_d_burst_gap    → F_PKG_02 FAIL (gap 25 ≥ 10)\n")
    parts.push("    f01_matrix = bool(r_a['f01'] and r_b['f01'] and (not r_c['f01']))\n")
    parts.push("    f02_matrix = bool(r_a['f02'] and r_b['f02'] and (not r_d['f02']))\n")
    parts.push("    f03_matrix = bool(r_a['f03'] and r_b['f03'])\n")
    parts.push("    overall = bool(f01_matrix and f02_matrix and f03_matrix\n")
    parts.push("                   and r_a['overall']\n")
    parts.push("                   and (not r_c['overall']) and (not r_d['overall']))\n")
    parts.push("    out = {\n")
    parts.push("        'rc': 0,\n")
    parts.push("        'case_a_good':       r_a,\n")
    parts.push("        'case_b_few_drops':  r_b,\n")
    parts.push("        'case_c_many_drops': r_c,\n")
    parts.push("        'case_d_burst_gap':  r_d,\n")
    parts.push("        'f01_matrix':        f01_matrix,\n")
    parts.push("        'f02_matrix':        f02_matrix,\n")
    parts.push("        'f03_matrix':        f03_matrix,\n")
    parts.push("        'overall':           overall,\n")
    parts.push("    }\n")
    parts.push("    print(json.dumps(out))\n")
    parts.push("''')\n\n")

    parts.push("def cmd_selftest(args):\n")
    parts.push("    print('schema=' + '" + SCHEMA + "')\n")
    parts.push("    print('venv_python_exists=' + str(os.path.exists(VENV_PYTHON)))\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', SELFTEST_PY,\n")
    parts.push("           str(SELFTEST_PACKETS_GOOD), str(SELFTEST_DROP_FEW),\n")
    parts.push("           str(SELFTEST_DROP_MANY), str(SELFTEST_BURST_GAP),\n")
    parts.push("           str(SELFTEST_DURATION_S),\n")
    parts.push("           str(DEFAULT_THRESHOLD_LOSS_PCT),\n")
    parts.push("           str(F_PKG_02_MAX_GAP), str(F_PKG_03_MIN_ACTUAL_FS_HZ)]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)\n")
    parts.push("    if r.returncode != 0 or not r.stdout.strip():\n")
    parts.push("        emit_trailer('selftest-subprocess-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) verify .venv-eeg numpy installed  2) re-run')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        m = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('selftest-parse-failed',\n")
    parts.push("                     f'could not parse helper output: {exc!r}; raw={r.stdout[-200:]!r}',\n")
    parts.push("                     '1) re-run; if persistent inspect helper python')\n")
    parts.push("        print('selftest=fail')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    a = m['case_a_good']; b = m['case_b_few_drops']\n")
    parts.push("    c = m['case_c_many_drops']; d = m['case_d_burst_gap']\n")
    parts.push("    print(f'case_a_good        n={a[\"n_received\"]} drop={a[\"n_dropped\"]} pct={a[\"dropout_pct\"]}% gap={a[\"largest_gap\"]} fs={a[\"actual_fs\"]} f01/02/03={a[\"f01\"]}/{a[\"f02\"]}/{a[\"f03\"]} overall={a[\"overall\"]}')\n")
    parts.push("    print(f'case_b_few_drops   n={b[\"n_received\"]} drop={b[\"n_dropped\"]} pct={b[\"dropout_pct\"]}% gap={b[\"largest_gap\"]} fs={b[\"actual_fs\"]} f01/02/03={b[\"f01\"]}/{b[\"f02\"]}/{b[\"f03\"]} overall={b[\"overall\"]}')\n")
    parts.push("    print(f'case_c_many_drops  n={c[\"n_received\"]} drop={c[\"n_dropped\"]} pct={c[\"dropout_pct\"]}% gap={c[\"largest_gap\"]} fs={c[\"actual_fs\"]} f01/02/03={c[\"f01\"]}/{c[\"f02\"]}/{c[\"f03\"]} overall={c[\"overall\"]}')\n")
    parts.push("    print(f'case_d_burst_gap   n={d[\"n_received\"]} drop={d[\"n_dropped\"]} pct={d[\"dropout_pct\"]}% gap={d[\"largest_gap\"]} fs={d[\"actual_fs\"]} f01/02/03={d[\"f01\"]}/{d[\"f02\"]}/{d[\"f03\"]} overall={d[\"overall\"]}')\n")
    parts.push("    f01m = 'PASS' if m['f01_matrix'] else 'FAIL'\n")
    parts.push("    f02m = 'PASS' if m['f02_matrix'] else 'FAIL'\n")
    parts.push("    f03m = 'PASS' if m['f03_matrix'] else 'FAIL'\n")
    parts.push("    print(f'F_PKG_01_matrix(dropout < 5%):       {f01m}')\n")
    parts.push("    print(f'F_PKG_02_matrix(largest_gap < 10):    {f02m}')\n")
    parts.push("    print(f'F_PKG_03_matrix(actual_fs >= 100Hz):  {f03m}')\n")
    parts.push("    overall = 'PASS' if m['overall'] else 'FAIL'\n")
    parts.push("    print(f'selftest={overall.lower()}')\n")
    parts.push("    print(f'__EEG_PACKAGE_NUM__ {overall} {a[\"dropout_pct\"]:.2f} {a[\"largest_gap\"]}')\n")
    parts.push("    sys.exit(0 if m['overall'] else 1)\n\n")

    parts.push("def cmd_verify(args):\n")
    parts.push("    if not os.path.exists(args.input):\n")
    parts.push("        emit_trailer('input-missing',\n")
    parts.push("                     f'--input {args.input} not found',\n")
    parts.push("                     '1) verify path; .npy file from collect.hexa')\n")
    parts.push("        print('__EEG_PACKAGE_NUM__ FAIL 100.00 0')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not os.path.exists(args.input + '.meta.json'):\n")
    parts.push("        emit_trailer('meta-missing',\n")
    parts.push("                     f'sidecar {args.input}.meta.json not found',\n")
    parts.push("                     '1) re-run collect.hexa with --output to regenerate sidecar')\n")
    parts.push("        print('__EEG_PACKAGE_NUM__ FAIL 100.00 0')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if not verify_numpy():\n")
    parts.push("        print('__EEG_PACKAGE_NUM__ FAIL 100.00 0')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    cmd = [VENV_PYTHON, '-c', VERIFY_PY,\n")
    parts.push("           args.input, str(args.threshold_loss_pct),\n")
    parts.push("           str(F_PKG_02_MAX_GAP), str(F_PKG_03_MIN_ACTUAL_FS_HZ)]\n")
    parts.push("    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)\n")
    parts.push("    if not r.stdout.strip():\n")
    parts.push("        emit_trailer('verify-subprocess-failed',\n")
    parts.push("                     f'rc={r.returncode} stderr={r.stderr.strip()[:300]}',\n")
    parts.push("                     '1) re-run with verbose: python ' + VENV_PYTHON + ' helper manually')\n")
    parts.push("        print('__EEG_PACKAGE_NUM__ FAIL 100.00 0')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        meta = json.loads(r.stdout.strip().splitlines()[-1])\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('verify-parse-failed',\n")
    parts.push("                     f'could not parse helper output: {exc!r}',\n")
    parts.push("                     '1) re-run; inspect helper python at ' + VENV_PYTHON)\n")
    parts.push("        print('__EEG_PACKAGE_NUM__ FAIL 100.00 0')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    if 'error' in meta:\n")
    parts.push("        emit_trailer('verify-helper-error',\n")
    parts.push("                     f'helper error: {meta[\"error\"]}',\n")
    parts.push("                     '1) inspect ' + meta.get('meta_path','<unknown>') + '  '\n")
    parts.push("                     '2) ensure board_id present in meta or brainflow installed')\n")
    parts.push("        print('__EEG_PACKAGE_NUM__ FAIL 100.00 0')\n")
    parts.push("        sys.exit(2)\n")
    parts.push("    drop_pct  = meta['dropout_rate_pct']\n")
    parts.push("    largest   = meta['largest_gap']\n")
    parts.push("    print(f'input={meta[\"input\"]}')\n")
    parts.push("    print(f'meta={meta[\"meta_path\"]}')\n")
    parts.push("    print(f'rows={meta[\"rows\"]}  cols={meta[\"cols\"]}')\n")
    parts.push("    print(f'board_id={meta[\"board_id\"]}  package_num_row={meta[\"package_num_row\"]}  source={meta[\"row_source\"]}')\n")
    parts.push("    print(f'sample_rate_claimed={meta[\"sample_rate_claimed_hz\"]} Hz')\n")
    parts.push("    print(f'duration={meta[\"duration_s\"]} s ({meta[\"duration_source\"]})')\n")
    parts.push("    print(f'total_packets_received={meta[\"total_packets_received\"]}')\n")
    parts.push("    print(f'total_packets_dropped={meta[\"total_packets_dropped\"]}')\n")
    parts.push("    print(f'dropout_rate_pct={drop_pct}%  (threshold {meta[\"threshold_loss_pct\"]}%)')\n")
    parts.push("    print(f'effective_fs_hz={meta[\"effective_fs_hz\"]} Hz  (cols/dur)')\n")
    parts.push("    print(f'actual_fs_hz={meta[\"actual_fs_hz\"]} Hz  (cols+drops)/dur)')\n")
    parts.push("    print(f'largest_gap={largest}  (limit {F_PKG_02_MAX_GAP})')\n")
    parts.push("    # gap_distribution: print top 8 buckets\n")
    parts.push("    gd = meta['gap_distribution']\n")
    parts.push("    items = sorted(((int(k), int(v)) for k,v in gd.items()), key=lambda x: -x[1])[:8]\n")
    parts.push("    print('gap_distribution_top8=' + ','.join(f'{k}:{v}' for k,v in items))\n")
    parts.push("    f01 = 'PASS' if meta['f01_pass'] else 'FAIL'\n")
    parts.push("    f02 = 'PASS' if meta['f02_pass'] else 'FAIL'\n")
    parts.push("    f03 = 'PASS' if meta['f03_pass'] else 'FAIL'\n")
    parts.push("    print(f'F_PKG_01_dropout:    {f01}')\n")
    parts.push("    print(f'F_PKG_02_burst_gap:  {f02}')\n")
    parts.push("    print(f'F_PKG_03_actual_fs:  {f03}')\n")
    parts.push("    overall = 'PASS' if meta['overall'] else 'FAIL'\n")
    parts.push("    print(f'verdict={overall}')\n")
    parts.push("    print(f'__EEG_PACKAGE_NUM__ {overall} {drop_pct:.2f} {largest}')\n")
    parts.push("    if not meta['overall']:\n")
    parts.push("        if args.strict: sys.exit(1)\n")
    parts.push("        print('lenient: WARN only — exit 0')\n")
    parts.push("        sys.exit(0)\n")
    parts.push("    sys.exit(0)\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    s = sub.add_parser('selftest')\n")
    parts.push("    v = sub.add_parser('verify')\n")
    parts.push("    v.add_argument('--input', required=True)\n")
    parts.push("    v.add_argument('--threshold-loss-pct', type=float,\n")
    parts.push("                   default=DEFAULT_THRESHOLD_LOSS_PCT,\n")
    parts.push("                   dest='threshold_loss_pct')\n")
    parts.push("    v.add_argument('--strict', action='store_true', default=True)\n")
    parts.push("    v.add_argument('--lenient', dest='strict', action='store_false')\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest': cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'verify': cmd_verify(args)\n")
    parts.push("    else: sys.exit(2)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// CLI
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/protocols/package_num_audit.hexa --selftest")
    eprintln("       hexa run anima-eeg/protocols/package_num_audit.hexa \\")
    eprintln("            --input <raw.npy> [--threshold-loss-pct <n>] \\")
    eprintln("            [--strict | --lenient]")
    eprintln("flags:")
    eprintln("  --selftest                  synthetic 4-case matrix, verify F_PKG_01/02/03")
    eprintln("  --input <path>              input .npy (sidecar <path>.meta.json required)")
    eprintln("  --threshold-loss-pct <n>    max dropout %% before F_PKG_01 fails (default " + to_string(DEFAULT_THRESHOLD_LOSS_PCT) + ")")
    eprintln("  --strict                    (default) FAIL → exit 1")
    eprintln("  --lenient                   warn-only, exit 0 even on FAIL")
    eprintln("  --help                      this message")
}

fn main() {
    let av = argv()
    let mut want_selftest = false
    let mut want_help     = false
    let mut strict        = true
    let mut input_path    = ""
    let mut threshold_pct = DEFAULT_THRESHOLD_LOSS_PCT

    // hexa-strict: user args begin at index 2 (matches sample_rate_guard / eeg_filter)
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"          { want_selftest = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--strict"            { strict = true; i = i + 1; continue }
        if a == "--lenient"           { strict = false; i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--input requires a path",
                              "1) re-run with --input <path.npy>")
                exit(2)
            }
            input_path = av[i + 1]; i = i + 2; continue
        }
        if a == "--threshold-loss-pct" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--threshold-loss-pct requires a numeric percent",
                              "1) re-run with --threshold-loss-pct 5")
                exit(2)
            }
            threshold_pct = to_float(av[i + 1]); i = i + 2; continue
        }
        // unknown flag → fall through
        _emit_trailer("unknown-flag",
                      "argv[" + str(i) + "] = " + a,
                      "1) check --help for valid flags")
        _print_usage()
        exit(2)
    }

    if want_help {
        _print_usage()
        exit(0)
    }

    _write_helper()

    if want_selftest {
        let r = _run_helper("selftest")
        let stdout = r[0]
        let rc     = to_int(r[1])
        println(stdout)
        exit(rc)
    }

    if input_path == "" {
        _emit_trailer("missing-required",
                      "--input is required for verify mode",
                      "1) provide --input <raw.npy>  "
                      "2) or use --selftest for synthetic verification")
        _print_usage()
        exit(2)
    }

    if threshold_pct <= 0.0 {
        _emit_trailer("invalid-threshold",
                      "--threshold-loss-pct must be > 0 (got " + to_string(threshold_pct) + ")",
                      "1) re-run with --threshold-loss-pct <positive number>")
        exit(2)
    }

    let mut args = "verify"
        + " --input "              + _sh_quote(input_path)
        + " --threshold-loss-pct " + to_string(threshold_pct)
    if strict { args = args + " --strict" }
    else      { args = args + " --lenient" }

    let r = _run_helper(args)
    let stdout = r[0]
    let rc     = to_int(r[1])
    println(stdout)
    exit(rc)
}
