// anima-eeg/protocols/concentration_episodes.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#15 no-personal-paths · raw#65 idempotent · raw#71 falsifier-3 · raw#82 darwin-native
// raw#91 honest-class · own 5
//
// @resolver-bypass(reason="darwin-native: --realtime/--analyze delegate to
//                   anima-eeg/collect.hexa subprocess + .venv-eeg python helper
//                   for Welch PSD over .npy on host; selftest is pure-hexa
//                   synthetic band-power surrogate (no scipy / no BrainFlow).
//                   Linux pods do not have host USB to drive --realtime; the
//                   --selftest path runs anywhere. Unified bypass keeps the
//                   route stable across darwin live + linux selftest.")
//
// PURPOSE
//   Daily-life concentration / mind-wandering episode detection over
//   resting-task EEG (coding, writing, reading sessions on user's own
//   cap). Frontal θ + frontal β rise during focused attention while
//   occipital α suppresses (Klimesch 1999); the inverse pattern (rising
//   frontal α + falling β + DMN-like idle) marks mind-wandering. We
//   compute a per-window concentration_score and segment sustained
//   high-score / low-score regions into episodes.
//
//   Three falsifiers locked pre-registration (raw#71). NB: F_CONC_*
//   exercise pure-hexa synthetic band shapes; PASS implies the
//   directional formula behaves correctly, NOT that the user's cap +
//   reference + Klimesch parameters reproduce literature on this body.
//
//     F_CONC_01: synthetic focused signal (high frontal θ+β, low O α)
//                → score > 0.7
//     F_CONC_02: synthetic mind-wandering (high O α, low frontal θ+β)
//                → score < 0.3
//     F_CONC_03: episode duration ≥ 30 s sustained → robust detection
//                (no spurious < 30 s blips classified as episodes)
//
// HONEST C3 CAVEATS (raw#10 — pre-registered, mistake-pattern flagged)
//   1. Klimesch 1999 reports group-level frontal-θ rise during focused
//      attention; individual variance is large (some subjects show no
//      frontal-θ effect at all). N=1 self-experiment cannot replicate
//      group statistics. Score formula is a directional surrogate.
//   2. Eye-blink artifact dominates Fp1/Fp2 at 100-300 µV (10-30× any
//      θ-band cortical signal). Without ICA / regression cleanup the
//      "frontal_θ" estimate is contaminated by blink residue, inflating
//      concentration_score in any session where the user blinks more.
//   3. Korean grid 60 Hz line noise leaks harmonics into the β band
//      (60 Hz fundamental + sidebands → 13-30 Hz aliasing if the notch
//      is poorly tuned). β-band power may reflect grid contamination,
//      not cognitive workload, until the notch is verified per session.
//
// USAGE
//   hexa run anima-eeg/protocols/concentration_episodes.hexa --selftest
//   hexa run anima-eeg/protocols/concentration_episodes.hexa --analyze \
//       --input <npy>
//   hexa run anima-eeg/protocols/concentration_episodes.hexa --realtime \
//       --port <serial> --board cyton_daisy --duration <s>

let SCHEMA = "anima-eeg/concentration_episodes/1"

// ════════════════════════════════════════════════════════════════════
// Frozen detection configuration (raw#12 pre-registered)
// ════════════════════════════════════════════════════════════════════

// Channels (10-20 system) — frontal pickup + occipital reference
let CHAN_FP1                 = "Fp1"        // ch1 (left frontal-polar)
let CHAN_FP2                 = "Fp2"        // ch2 (right frontal-polar)
let CHAN_F3                  = "F3"         // ch3 (left frontal)
let CHAN_F4                  = "F4"         // ch4 (right frontal)
let CHAN_O1                  = "O1"         // ch7 (left occipital)
let CHAN_O2                  = "O2"         // ch8 (right occipital)
let FRONTAL_CHAN_COUNT       = 4
let OCCIPITAL_CHAN_COUNT     = 2

// Board / signal-chain frozen
let SAMPLE_RATE_HZ           = 250          // Cyton+Daisy fixed
let NOTCH_HZ                 = 60.0         // 한국 grid (raw#10 honest assumption)
let BANDPASS_LO_HZ           = 1.0
let BANDPASS_HI_HZ           = 50.0
let BANDPASS_ORDER           = 4            // Butterworth order-4

// Welch PSD sliding window
let WINDOW_SECONDS           = 5            // 5 s window
let WINDOW_STEP_S            = 1            // 1 s step (4 s overlap)
let WELCH_NPERSEG_S          = 2            // 2 s nperseg inside window

// Klimesch band edges (1999)
let THETA_LO_HZ              = 4.0
let THETA_HI_HZ              = 8.0
let ALPHA_LO_HZ              = 8.0
let ALPHA_HI_HZ              = 13.0
let BETA_LO_HZ               = 13.0
let BETA_HI_HZ               = 30.0

// Score thresholds (frozen, raw#12)
let SCORE_LO                 = 0.0
let SCORE_HI                 = 1.0
let FOCUSED_THRESHOLD        = 0.7          // F_CONC_01
let MIND_WANDERING_THRESHOLD = 0.3          // F_CONC_02
let EPISODE_MIN_DURATION_S   = 30           // F_CONC_03 sustained-window
let ALERT_REST_DURATION_S    = 60           // live-mode "휴식 권장" trigger

// Realtime defaults
let DEFAULT_DURATION_S       = 300
let DEFAULT_BOARD            = "cyton_daisy"
let DEFAULT_VENV_PYTHON      = ".venv-eeg/bin/python"

// Audit ledger path
let AUDIT_DIR  = "state/concentration_episodes_audit"

// Synthetic series cap (selftest sliding-window simulation)
let SYNTH_MAX_WINDOWS        = 600          // ≤ 10 min worth of 1 s steps

// ════════════════════════════════════════════════════════════════════
// Globals (raw#9 strict — no fallbacks, all measured)
// ════════════════════════════════════════════════════════════════════

// Per-window band powers (most-recent window state)
let g_frontal_theta          = 0.0
let g_frontal_beta           = 0.0
let g_occipital_alpha        = 0.0
let g_beta_alpha_ratio       = 0.0
let g_concentration_score    = 0.0

// Sliding-window time series (selftest synthetic + offline analyze)
let g_window_count           = 0
let g_focused_episode_count  = 0
let g_mind_wander_episode_count = 0
let g_focused_total_seconds  = 0
let g_mind_wander_total_seconds = 0
let g_total_session_seconds  = 0
let g_overall_concentration_pct = 0.0

// Last-detected episode bounds (for sentinel emit)
let g_last_focused_start_s   = -1
let g_last_focused_end_s     = -1
let g_last_focused_mean      = 0.0
let g_last_mind_wander_start_s = -1
let g_last_mind_wander_end_s   = -1
let g_last_mind_wander_mean    = 0.0

// Falsifier evaluations (raw#71)
let g_f_conc_01_pass         = false       // focused score > 0.7
let g_f_conc_02_pass         = false       // mind-wander score < 0.3
let g_f_conc_03_pass         = false       // episode ≥ 30 s sustained

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn min_f(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

fn clamp01(x: float) -> float {
    if x < SCORE_LO { return SCORE_LO }
    if x > SCORE_HI { return SCORE_HI }
    return x
}

// ════════════════════════════════════════════════════════════════════
// Per-window scoring
//   raw#10 honest: this is NOT a Welch PSD implementation. It is the
//   directional surrogate that consumes already-extracted band powers
//   (frontal_theta, frontal_beta averaged over Fp1/Fp2/F3/F4; occipital
//   alpha averaged over O1/O2). The Welch PSD itself runs in the
//   .venv-eeg python helper invoked by --realtime / --analyze.
//
//   Score formula:
//     numer = frontal_theta + frontal_beta
//     denom = numer + occipital_alpha + ε
//     score = numer / denom              ∈ [0, 1]
//
//   Interpretation (Klimesch 1999 directional, not group-stat-validated):
//     score → 1: frontal θ+β dominant, occipital α suppressed = focused
//     score → 0: occipital α dominant, frontal θ+β quiet     = mind-wander
//     score ≈ 0.5: indeterminate / transition
// ════════════════════════════════════════════════════════════════════

let SCORE_EPSILON            = 0.0001

fn compute_window_score(theta: float, beta: float, occ_alpha: float) -> float {
    let numer = theta + beta
    let denom = numer + occ_alpha + SCORE_EPSILON
    let raw   = numer / denom
    let score = clamp01(raw)
    g_frontal_theta       = theta
    g_frontal_beta        = beta
    g_occipital_alpha     = occ_alpha
    g_beta_alpha_ratio    = beta / (occ_alpha + SCORE_EPSILON)
    g_concentration_score = score
    return score
}

// ════════════════════════════════════════════════════════════════════
// Synthetic sliding-window series for selftest
//   Each scenario produces a list of per-window scores (1 s step).
//   Scenarios:
//     "focused_steady"    — 60 windows, all focused (score ≈ 0.85)
//     "mindwander_steady" — 60 windows, all mind-wander (score ≈ 0.15)
//     "short_focused"     — 20 windows focused (< 30 s), 40 windows neutral
//     "mixed_long"        — 45 focused + 60 neutral + 45 mind-wander
//     "spurious_blip"     — 5 windows focused (< 30 s), then mind-wander
// ════════════════════════════════════════════════════════════════════

// Returns score for window index `idx` in scenario `mode`.
fn synth_window_score(mode: string, idx: int) -> float {
    if mode == "focused_steady" {
        // theta=0.40, beta=0.45, occ_alpha=0.15 → ≈ 0.85
        return compute_window_score(0.40, 0.45, 0.15)
    }
    if mode == "mindwander_steady" {
        // theta=0.05, beta=0.05, occ_alpha=0.55 → ≈ 0.15
        return compute_window_score(0.05, 0.05, 0.55)
    }
    if mode == "short_focused" {
        if idx < 20 {
            return compute_window_score(0.40, 0.45, 0.15)
        }
        return compute_window_score(0.20, 0.20, 0.20)
    }
    if mode == "mixed_long" {
        if idx < 45 {
            return compute_window_score(0.40, 0.45, 0.15)
        }
        if idx < 105 {
            return compute_window_score(0.20, 0.20, 0.20)
        }
        return compute_window_score(0.05, 0.05, 0.55)
    }
    if mode == "spurious_blip" {
        if idx < 5 {
            return compute_window_score(0.40, 0.45, 0.15)
        }
        return compute_window_score(0.05, 0.05, 0.55)
    }
    // default neutral
    return compute_window_score(0.20, 0.20, 0.20)
}

// Returns total window count for scenario `mode`.
fn synth_window_count(mode: string) -> int {
    if mode == "focused_steady"     { return 60 }
    if mode == "mindwander_steady"  { return 60 }
    if mode == "short_focused"      { return 60 }
    if mode == "mixed_long"         { return 150 }
    if mode == "spurious_blip"      { return 60 }
    return 30
}

// ════════════════════════════════════════════════════════════════════
// Episode segmentation
//   Walks per-window scores at 1 s step. A "focused episode" is a
//   contiguous run of ≥ EPISODE_MIN_DURATION_S windows with
//   score > FOCUSED_THRESHOLD; symmetric rule for mind-wander on
//   score < MIND_WANDERING_THRESHOLD.
//
//   Updates globals:
//     g_focused_episode_count, g_focused_total_seconds
//     g_mind_wander_episode_count, g_mind_wander_total_seconds
//     g_last_focused_*, g_last_mind_wander_*
//     g_overall_concentration_pct
// ════════════════════════════════════════════════════════════════════

fn reset_episode_state() {
    g_window_count                  = 0
    g_focused_episode_count         = 0
    g_mind_wander_episode_count     = 0
    g_focused_total_seconds         = 0
    g_mind_wander_total_seconds     = 0
    g_total_session_seconds         = 0
    g_overall_concentration_pct     = 0.0
    g_last_focused_start_s          = -1
    g_last_focused_end_s            = -1
    g_last_focused_mean             = 0.0
    g_last_mind_wander_start_s      = -1
    g_last_mind_wander_end_s        = -1
    g_last_mind_wander_mean         = 0.0
}

// Run segmentation over a synthetic scenario (selftest path).
fn segment_synthetic(mode: string) {
    reset_episode_state()
    let n = synth_window_count(mode)
    g_window_count = n
    // Each window represents 1 s of step; total session length =
    // n + (WINDOW_SECONDS - WINDOW_STEP_S) covered seconds. We use
    // window-step granularity (1 s/window) for episode bookkeeping.
    g_total_session_seconds = n

    let mut focused_run_start  = -1
    let mut focused_run_sum    = 0.0
    let mut focused_run_len    = 0
    let mut mw_run_start       = -1
    let mut mw_run_sum         = 0.0
    let mut mw_run_len         = 0

    let mut i = 0
    while i < n {
        let score = synth_window_score(mode, i)

        // Focused run tracking
        if score > FOCUSED_THRESHOLD {
            if focused_run_start < 0 {
                focused_run_start = i
                focused_run_sum   = 0.0
                focused_run_len   = 0
            }
            focused_run_sum = focused_run_sum + score
            focused_run_len = focused_run_len + 1
        } else {
            if focused_run_start >= 0 {
                if focused_run_len >= EPISODE_MIN_DURATION_S {
                    let mean = focused_run_sum / to_float(focused_run_len)
                    g_focused_episode_count    = g_focused_episode_count + 1
                    g_focused_total_seconds    = g_focused_total_seconds + focused_run_len
                    g_last_focused_start_s     = focused_run_start
                    g_last_focused_end_s       = focused_run_start + focused_run_len
                    g_last_focused_mean        = mean
                }
                focused_run_start = -1
                focused_run_sum   = 0.0
                focused_run_len   = 0
            }
        }

        // Mind-wander run tracking
        if score < MIND_WANDERING_THRESHOLD {
            if mw_run_start < 0 {
                mw_run_start = i
                mw_run_sum   = 0.0
                mw_run_len   = 0
            }
            mw_run_sum = mw_run_sum + score
            mw_run_len = mw_run_len + 1
        } else {
            if mw_run_start >= 0 {
                if mw_run_len >= EPISODE_MIN_DURATION_S {
                    let mean = mw_run_sum / to_float(mw_run_len)
                    g_mind_wander_episode_count    = g_mind_wander_episode_count + 1
                    g_mind_wander_total_seconds    = g_mind_wander_total_seconds + mw_run_len
                    g_last_mind_wander_start_s     = mw_run_start
                    g_last_mind_wander_end_s       = mw_run_start + mw_run_len
                    g_last_mind_wander_mean        = mean
                }
                mw_run_start = -1
                mw_run_sum   = 0.0
                mw_run_len   = 0
            }
        }

        i = i + 1
    }

    // Flush trailing runs
    if focused_run_start >= 0 && focused_run_len >= EPISODE_MIN_DURATION_S {
        let mean = focused_run_sum / to_float(focused_run_len)
        g_focused_episode_count    = g_focused_episode_count + 1
        g_focused_total_seconds    = g_focused_total_seconds + focused_run_len
        g_last_focused_start_s     = focused_run_start
        g_last_focused_end_s       = focused_run_start + focused_run_len
        g_last_focused_mean        = mean
    }
    if mw_run_start >= 0 && mw_run_len >= EPISODE_MIN_DURATION_S {
        let mean = mw_run_sum / to_float(mw_run_len)
        g_mind_wander_episode_count    = g_mind_wander_episode_count + 1
        g_mind_wander_total_seconds    = g_mind_wander_total_seconds + mw_run_len
        g_last_mind_wander_start_s     = mw_run_start
        g_last_mind_wander_end_s       = mw_run_start + mw_run_len
        g_last_mind_wander_mean        = mean
    }

    // Overall concentration percentage = focused_total / total_session
    if g_total_session_seconds > 0 {
        let pct = to_float(g_focused_total_seconds) / to_float(g_total_session_seconds)
        g_overall_concentration_pct = pct
    }
}

// ════════════════════════════════════════════════════════════════════
// Frozen falsifier evaluation (raw#71)
// ════════════════════════════════════════════════════════════════════

fn reset_falsifiers() {
    g_f_conc_01_pass = false
    g_f_conc_02_pass = false
    g_f_conc_03_pass = false
}

fn evaluate_falsifiers() {
    // Drive each falsifier from a deterministic synthetic scenario.

    // F_CONC_01: focused_steady → score > 0.7
    let s_focused = synth_window_score("focused_steady", 0)
    g_f_conc_01_pass = s_focused > FOCUSED_THRESHOLD

    // F_CONC_02: mindwander_steady → score < 0.3
    let s_mw = synth_window_score("mindwander_steady", 0)
    g_f_conc_02_pass = s_mw < MIND_WANDERING_THRESHOLD

    // F_CONC_03: episode duration ≥ 30 s sustained — focused_steady (60 s)
    // produces ≥ 1 focused episode AND short_focused (20 s) produces 0
    // focused episodes (sub-threshold duration).
    segment_synthetic("focused_steady")
    let long_episode_count = g_focused_episode_count
    let long_last_dur = g_last_focused_end_s - g_last_focused_start_s
    segment_synthetic("short_focused")
    let short_episode_count = g_focused_episode_count
    g_f_conc_03_pass = long_episode_count >= 1
                    && long_last_dur >= EPISODE_MIN_DURATION_S
                    && short_episode_count == 0

    // Restore frontmost demo state for sentinel print: focused_steady.
    segment_synthetic("focused_steady")
}

// ════════════════════════════════════════════════════════════════════
// Sentinel emit (raw#71 falsifier-bound)
//   __EEG_CONCENTRATION__ <PASS|FAIL> <focused_episodes> <mw_episodes> <pct>
// ════════════════════════════════════════════════════════════════════

fn emit_sentinel() {
    let mut verdict = "PASS"
    if !(g_f_conc_01_pass && g_f_conc_02_pass && g_f_conc_03_pass) {
        verdict = "FAIL"
    }
    println("__EEG_CONCENTRATION__ " + verdict
        + " " + to_string(g_focused_episode_count)
        + " " + to_string(g_mind_wander_episode_count)
        + " " + to_string(g_overall_concentration_pct))
}

// ════════════════════════════════════════════════════════════════════
// Audit JSONL emit (raw#65 idempotent in selftest mode)
// ════════════════════════════════════════════════════════════════════

fn _ensure_audit_dir() {
    let _rc = exec("mkdir -p " + AUDIT_DIR)
}

fn emit_audit(ts: string, mode: string) {
    _ensure_audit_dir()
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"mode\":\"" + mode + "\","
    row = row + "\"sample_rate_hz\":" + to_string(SAMPLE_RATE_HZ) + ","
    row = row + "\"window_seconds\":" + to_string(WINDOW_SECONDS) + ","
    row = row + "\"window_step_s\":"  + to_string(WINDOW_STEP_S)  + ","
    row = row + "\"frontal_chan_count\":" + to_string(FRONTAL_CHAN_COUNT) + ","
    row = row + "\"occipital_chan_count\":" + to_string(OCCIPITAL_CHAN_COUNT) + ","
    row = row + "\"frontal_theta\":"    + to_string(g_frontal_theta)       + ","
    row = row + "\"frontal_beta\":"     + to_string(g_frontal_beta)        + ","
    row = row + "\"occipital_alpha\":"  + to_string(g_occipital_alpha)     + ","
    row = row + "\"beta_alpha_ratio\":" + to_string(g_beta_alpha_ratio)    + ","
    row = row + "\"concentration_score\":" + to_string(g_concentration_score) + ","
    row = row + "\"window_count\":" + to_string(g_window_count) + ","
    row = row + "\"focused_episode_count\":" + to_string(g_focused_episode_count) + ","
    row = row + "\"mind_wander_episode_count\":" + to_string(g_mind_wander_episode_count) + ","
    row = row + "\"focused_total_seconds\":" + to_string(g_focused_total_seconds) + ","
    row = row + "\"mind_wander_total_seconds\":" + to_string(g_mind_wander_total_seconds) + ","
    row = row + "\"total_session_seconds\":" + to_string(g_total_session_seconds) + ","
    row = row + "\"overall_concentration_pct\":" + to_string(g_overall_concentration_pct) + ","
    row = row + "\"last_focused_start_s\":" + to_string(g_last_focused_start_s) + ","
    row = row + "\"last_focused_end_s\":" + to_string(g_last_focused_end_s) + ","
    row = row + "\"last_focused_mean\":" + to_string(g_last_focused_mean) + ","
    row = row + "\"last_mind_wander_start_s\":" + to_string(g_last_mind_wander_start_s) + ","
    row = row + "\"last_mind_wander_end_s\":" + to_string(g_last_mind_wander_end_s) + ","
    row = row + "\"last_mind_wander_mean\":" + to_string(g_last_mind_wander_mean) + ","
    row = row + "\"f_conc_01\":" + _bool_str(g_f_conc_01_pass) + ","
    row = row + "\"f_conc_02\":" + _bool_str(g_f_conc_02_pass) + ","
    row = row + "\"f_conc_03\":" + _bool_str(g_f_conc_03_pass) + ","
    row = row + "\"honest_c3_klimesch_individual_variance\":true,"
    row = row + "\"honest_c3_blink_artifact_frontal_contamination\":true,"
    row = row + "\"honest_c3_korean_grid_60hz_beta_leak\":true"
    row = row + "}"
    let nl = chr(10)
    let mut existing = ""
    let prior = read_file(path)
    if prior != "" { existing = prior }
    write_file(path, existing + row + nl)
}

// ════════════════════════════════════════════════════════════════════
// --analyze offline mode
//   raw#10 honest: this protocol does NOT decode .npy in hexa space;
//   it prints the python-helper invocation that the user runs against
//   .venv-eeg to load scipy + the captured array, run Welch PSD over
//   sliding windows, and emit per-window theta/beta/alpha back through
//   the same sentinel shape so the audit ledger row stays schema-stable.
// ════════════════════════════════════════════════════════════════════

fn print_analyze_plan(input: string) {
    println("── concentration_episodes analyze plan ──")
    println("schema=" + SCHEMA)
    println("input=" + input)
    println("sample_rate_hz=" + to_string(SAMPLE_RATE_HZ))
    println("window_seconds=" + to_string(WINDOW_SECONDS))
    println("window_step_s=" + to_string(WINDOW_STEP_S))
    println("welch_nperseg_s=" + to_string(WELCH_NPERSEG_S))
    println("frontal_channels=" + CHAN_FP1 + "," + CHAN_FP2 + "," + CHAN_F3 + "," + CHAN_F4)
    println("occipital_channels=" + CHAN_O1 + "," + CHAN_O2)
    println("theta_band_hz=" + to_string(THETA_LO_HZ) + "-" + to_string(THETA_HI_HZ))
    println("alpha_band_hz=" + to_string(ALPHA_LO_HZ) + "-" + to_string(ALPHA_HI_HZ))
    println("beta_band_hz="  + to_string(BETA_LO_HZ)  + "-" + to_string(BETA_HI_HZ))
    println("focused_threshold=" + to_string(FOCUSED_THRESHOLD))
    println("mind_wandering_threshold=" + to_string(MIND_WANDERING_THRESHOLD))
    println("episode_min_duration_s=" + to_string(EPISODE_MIN_DURATION_S))
    println("")
    println("[delegate command — run in separate terminal]")
    println("  " + DEFAULT_VENV_PYTHON + " -c \\")
    println("  'import numpy as np; from scipy.signal import welch;\\")
    println("   d = np.load(\"" + input + "\");\\")
    println("   fs = " + to_string(SAMPLE_RATE_HZ) + "; win = " + to_string(WINDOW_SECONDS) + "*fs; step = " + to_string(WINDOW_STEP_S) + "*fs;\\")
    println("   front = d[[0,1,2,3], :].mean(0); occ = d[[6,7], :].mean(0);\\")
    println("   for t in range(0, d.shape[1] - win, step):\\")
    println("     fF, pxxF = welch(front[t:t+win], fs=fs, nperseg=" + to_string(WELCH_NPERSEG_S) + "*fs);\\")
    println("     fO, pxxO = welch(occ[t:t+win],   fs=fs, nperseg=" + to_string(WELCH_NPERSEG_S) + "*fs);\\")
    println("     th = pxxF[(fF>=4)&(fF<8)].mean(); be = pxxF[(fF>=13)&(fF<30)].mean(); al = pxxO[(fO>=8)&(fO<13)].mean();\\")
    println("     score = (th+be) / (th+be+al+1e-4); print(t/fs, score)'")
    println("")
    println("[honest C3 reminder]")
    println("  1. Klimesch 1999 frontal-θ rise has large individual variance (group stat)")
    println("  2. Eye-blink artifact contaminates Fp1/Fp2 θ-band (10-30× signal)")
    println("  3. Korean grid 60 Hz harmonics leak into β-band without verified notch")
}

// ════════════════════════════════════════════════════════════════════
// --realtime live mode
//   1 Hz refresh: per-window concentration_score printed as the user
//   works on coding / writing / reading. Optional audio alert hook
//   triggers when score < MIND_WANDERING_THRESHOLD sustained ≥
//   ALERT_REST_DURATION_S ("휴식 권장"). Actual stream is launched by
//   anima-eeg/collect.hexa in a separate terminal; this protocol
//   prints the plan + Welch loop body the user pipes into the helper.
// ════════════════════════════════════════════════════════════════════

fn print_realtime_plan(port: string, board: string, duration: int) {
    println("── concentration_episodes realtime plan ──")
    println("schema=" + SCHEMA)
    println("port=" + port)
    println("board=" + board)
    println("duration_s=" + to_string(duration))
    println("sample_rate_hz=" + to_string(SAMPLE_RATE_HZ))
    println("window_seconds=" + to_string(WINDOW_SECONDS))
    println("window_step_s=" + to_string(WINDOW_STEP_S) + " (1 Hz refresh)")
    println("frontal_channels=" + CHAN_FP1 + "," + CHAN_FP2 + "," + CHAN_F3 + "," + CHAN_F4)
    println("occipital_channels=" + CHAN_O1 + "," + CHAN_O2)
    println("focused_threshold=" + to_string(FOCUSED_THRESHOLD))
    println("mind_wandering_threshold=" + to_string(MIND_WANDERING_THRESHOLD))
    println("episode_min_duration_s=" + to_string(EPISODE_MIN_DURATION_S))
    println("alert_rest_duration_s=" + to_string(ALERT_REST_DURATION_S))
    println("")
    println("[user hand-step — montage assumption (10-20 system)]")
    println("  N1P (ch1)  -> Fp1  (forehead, 1\" above left brow,  1\" left of midline)")
    println("  N2P (ch2)  -> Fp2  (forehead, 1\" above right brow, 1\" right of midline)")
    println("  N3P (ch3)  -> F3   (left frontal,  midway Fp1-C3)")
    println("  N4P (ch4)  -> F4   (right frontal, midway Fp2-C4)")
    println("  N7P (ch7)  -> O1   (1\" above inion, 1\" left)")
    println("  N8P (ch8)  -> O2   (1\" above inion, 1\" right)")
    println("  SRB2       -> A1   earlobe (white wire)")
    println("  BIAS       -> A2   earlobe (black wire)")
    println("")
    println("[delegate command — run in separate terminal]")
    println("  hexa run anima-eeg/collect.hexa --port " + port + " \\")
    println("      --board " + board + " --duration " + to_string(duration) + " \\")
    println("      --output anima-eeg/recordings/sessions/concentration_realtime.npy")
    println("")
    println("[then live-tail score @ 1 Hz — pipe into a Welch helper]")
    println("  (separate terminal; reads the growing .npy in 5 s window, 1 s step)")
    println("  print: t=<s>  score=<0..1>  state=<focused|neutral|mind-wander>")
    println("  alert (sustained " + to_string(ALERT_REST_DURATION_S) + " s mind-wander):")
    println("    \"휴식 권장 (Rest recommended)\"  via afplay / TTS hook")
    println("")
    println("[then offline analyze]")
    println("  hexa run anima-eeg/protocols/concentration_episodes.hexa --analyze \\")
    println("      --input anima-eeg/recordings/sessions/concentration_realtime.npy")
    println("")
    println("[honest C3 reminder — printed every realtime invocation]")
    println("  1. Klimesch 1999 frontal-θ has large individual variance (N=1 risk)")
    println("  2. Eye-blink contaminates frontal θ estimate (run eye_blink_detect first)")
    println("  3. 60 Hz Korean grid harmonics leak into β-band (verify notch per session)")
}

// ════════════════════════════════════════════════════════════════════
// Tests (selftest)
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn run_tests() -> int {
    let mut pass = 0
    let mut fail = 0

    println("=== concentration_episodes selftest ===")

    // T1: score formula range — neutral input
    println("[T1] score formula range — neutral input")
    let s_neu = compute_window_score(0.20, 0.20, 0.20)
    let ok1a = assert_true(s_neu >= 0.0 && s_neu <= 1.0, "score in [0, 1] (s=" + to_string(s_neu) + ")")
    let ok1b = assert_true(g_concentration_score == s_neu, "global score updated")
    if ok1a && ok1b { pass = pass + 1 } else { fail = fail + 1 }

    // T2: F_CONC_01 — focused_steady → score > 0.7
    println("[T2] F_CONC_01 focused_steady score > 0.7")
    let s_foc = synth_window_score("focused_steady", 0)
    let ok2 = assert_true(s_foc > FOCUSED_THRESHOLD, "score=" + to_string(s_foc) + " > 0.7")
    if ok2 { pass = pass + 1 } else { fail = fail + 1 }

    // T3: F_CONC_02 — mindwander_steady → score < 0.3
    println("[T3] F_CONC_02 mindwander_steady score < 0.3")
    let s_mw = synth_window_score("mindwander_steady", 0)
    let ok3 = assert_true(s_mw < MIND_WANDERING_THRESHOLD, "score=" + to_string(s_mw) + " < 0.3")
    if ok3 { pass = pass + 1 } else { fail = fail + 1 }

    // T4: episode segmentation — focused_steady → 1 episode of 60 s
    println("[T4] focused_steady → 1 focused episode ≥ 30 s")
    segment_synthetic("focused_steady")
    let ok4a = assert_true(g_focused_episode_count == 1, "focused_episode_count=" + to_string(g_focused_episode_count))
    let dur4 = g_last_focused_end_s - g_last_focused_start_s
    let ok4b = assert_true(dur4 >= EPISODE_MIN_DURATION_S, "duration=" + to_string(dur4) + " s ≥ 30")
    let ok4c = assert_true(g_mind_wander_episode_count == 0, "no spurious mind-wander episodes")
    if ok4a && ok4b && ok4c { pass = pass + 1 } else { fail = fail + 1 }

    // T5: episode segmentation — mindwander_steady → 1 episode of 60 s
    println("[T5] mindwander_steady → 1 mind-wander episode ≥ 30 s")
    segment_synthetic("mindwander_steady")
    let ok5a = assert_true(g_mind_wander_episode_count == 1, "mw_episode_count=" + to_string(g_mind_wander_episode_count))
    let dur5 = g_last_mind_wander_end_s - g_last_mind_wander_start_s
    let ok5b = assert_true(dur5 >= EPISODE_MIN_DURATION_S, "duration=" + to_string(dur5) + " s ≥ 30")
    let ok5c = assert_true(g_focused_episode_count == 0, "no spurious focused episodes")
    if ok5a && ok5b && ok5c { pass = pass + 1 } else { fail = fail + 1 }

    // T6: F_CONC_03 — short_focused (20 s) → 0 focused episodes
    println("[T6] F_CONC_03 short_focused (20 s) → 0 episodes")
    segment_synthetic("short_focused")
    let ok6 = assert_true(g_focused_episode_count == 0, "20 s focused run does NOT qualify")
    if ok6 { pass = pass + 1 } else { fail = fail + 1 }

    // T7: F_CONC_03 — spurious_blip (5 s) → 0 focused episodes
    println("[T7] F_CONC_03 spurious 5 s blip → 0 episodes")
    segment_synthetic("spurious_blip")
    let ok7a = assert_true(g_focused_episode_count == 0, "5 s focused blip does NOT qualify")
    let ok7b = assert_true(g_mind_wander_episode_count == 1, "55 s mind-wander tail qualifies")
    if ok7a && ok7b { pass = pass + 1 } else { fail = fail + 1 }

    // T8: mixed_long — 1 focused (45 s) + 1 mind-wander (45 s)
    println("[T8] mixed_long → 1 focused + 1 mind-wander episode")
    segment_synthetic("mixed_long")
    let ok8a = assert_true(g_focused_episode_count == 1, "1 focused episode (45 s)")
    let ok8b = assert_true(g_mind_wander_episode_count == 1, "1 mind-wander episode (45 s)")
    let ok8c = assert_true(g_focused_total_seconds == 45, "focused total = 45 s")
    let ok8d = assert_true(g_mind_wander_total_seconds == 45, "mw total = 45 s")
    if ok8a && ok8b && ok8c && ok8d { pass = pass + 1 } else { fail = fail + 1 }

    // T9: overall_concentration_pct — mixed_long: 45 / 150 = 0.30
    println("[T9] overall_concentration_pct = focused_total / session")
    segment_synthetic("mixed_long")
    let drift9 = abs_f(g_overall_concentration_pct - 0.3)
    let ok9 = assert_true(drift9 < 0.001, "pct=" + to_string(g_overall_concentration_pct) + " (expected 0.30)")
    if ok9 { pass = pass + 1 } else { fail = fail + 1 }

    // T10: idempotent compute_window_score (raw#65)
    println("[T10] idempotent compute_window_score (raw#65)")
    let s10a = compute_window_score(0.40, 0.45, 0.15)
    let s10b = compute_window_score(0.40, 0.45, 0.15)
    let ok10 = assert_true(s10a == s10b, "compute_window_score byte-stable")
    if ok10 { pass = pass + 1 } else { fail = fail + 1 }

    // T11: idempotent segment_synthetic (raw#65)
    println("[T11] idempotent segment_synthetic (raw#65)")
    segment_synthetic("mixed_long")
    let f11a = g_focused_episode_count
    let m11a = g_mind_wander_episode_count
    let p11a = g_overall_concentration_pct
    segment_synthetic("mixed_long")
    let ok11a = assert_true(g_focused_episode_count == f11a, "focused count stable")
    let ok11b = assert_true(g_mind_wander_episode_count == m11a, "mw count stable")
    let ok11c = assert_true(g_overall_concentration_pct == p11a, "pct stable")
    if ok11a && ok11b && ok11c { pass = pass + 1 } else { fail = fail + 1 }

    // T12: clamp01 boundary
    println("[T12] clamp01 boundary")
    let ok12a = assert_true(clamp01(0.0 - 1.0) == 0.0, "clamp(-1) == 0")
    let ok12b = assert_true(clamp01(2.0) == 1.0, "clamp(2) == 1")
    let ok12c = assert_true(clamp01(0.5) == 0.5, "clamp(0.5) == 0.5")
    if ok12a && ok12b && ok12c { pass = pass + 1 } else { fail = fail + 1 }

    // T13: full falsifier matrix
    println("[T13] full falsifier matrix F_CONC_01/02/03")
    reset_falsifiers()
    evaluate_falsifiers()
    let ok13a = assert_true(g_f_conc_01_pass, "F_CONC_01 (focused score > 0.7)")
    let ok13b = assert_true(g_f_conc_02_pass, "F_CONC_02 (mind-wander score < 0.3)")
    let ok13c = assert_true(g_f_conc_03_pass, "F_CONC_03 (episode ≥ 30 s sustained)")
    if ok13a && ok13b && ok13c { pass = pass + 1 } else { fail = fail + 1 }

    // T14: thresholds frozen (raw#12)
    println("[T14] thresholds frozen (raw#12)")
    let ok14a = assert_true(FOCUSED_THRESHOLD == 0.7, "FOCUSED_THRESHOLD = 0.7")
    let ok14b = assert_true(MIND_WANDERING_THRESHOLD == 0.3, "MIND_WANDERING_THRESHOLD = 0.3")
    let ok14c = assert_true(EPISODE_MIN_DURATION_S == 30, "EPISODE_MIN_DURATION_S = 30 s")
    let ok14d = assert_true(WINDOW_SECONDS == 5, "WINDOW_SECONDS = 5 s")
    let ok14e = assert_true(WINDOW_STEP_S == 1, "WINDOW_STEP_S = 1 s")
    let ok14f = assert_true(SAMPLE_RATE_HZ == 250, "SAMPLE_RATE_HZ = 250")
    if ok14a && ok14b && ok14c && ok14d && ok14e && ok14f { pass = pass + 1 } else { fail = fail + 1 }

    // T15: audit JSONL emit (raw#65 byte-stable)
    println("[T15] audit JSONL emit deterministic")
    segment_synthetic("focused_steady")
    reset_falsifiers()
    evaluate_falsifiers()
    let ts = "selftest_synth"
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    write_file(path, "")
    emit_audit(ts, "focused_steady")
    let body1 = read_file(path)
    write_file(path, "")
    emit_audit(ts, "focused_steady")
    let body2 = read_file(path)
    let ok15a = assert_true(body1 == body2, "audit row byte-stable")
    let ok15b = assert_true(len(body1) > 0, "audit row non-empty")
    if ok15a && ok15b { pass = pass + 1 } else { fail = fail + 1 }

    // T16: honest C3 caveat strings present in audit row
    println("[T16] honest C3 caveat fields in audit row")
    let body = read_file(path)
    let has_klimesch = contains(body, "honest_c3_klimesch_individual_variance")
    let has_blink    = contains(body, "honest_c3_blink_artifact_frontal_contamination")
    let has_grid     = contains(body, "honest_c3_korean_grid_60hz_beta_leak")
    let ok16 = assert_true(has_klimesch && has_blink && has_grid, "all 3 honest_c3 fields present")
    if ok16 { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// CLI entry
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    println("usage:")
    println("  hexa run anima-eeg/protocols/concentration_episodes.hexa --selftest")
    println("  hexa run anima-eeg/protocols/concentration_episodes.hexa --analyze --input <npy>")
    println("  hexa run anima-eeg/protocols/concentration_episodes.hexa --realtime \\")
    println("      --port <serial> --board <cyton_daisy> --duration <s>")
}

fn _arg_value(av: list, key: string, dflt: string) -> string {
    let mut i = 1
    while i < len(av) {
        if av[i] == key && i + 1 < len(av) {
            return av[i + 1]
        }
        i = i + 1
    }
    return dflt
}

fn _arg_int(av: list, key: string, dflt: int) -> int {
    let s = _arg_value(av, key, "")
    if len(s) == 0 { return dflt }
    return to_int(s)
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut analyze  = false
    let mut realtime = false
    let mut i = 1
    while i < len(av) {
        if av[i] == "--selftest" { selftest = true }
        if av[i] == "--analyze"  { analyze  = true }
        if av[i] == "--realtime" { realtime = true }
        if av[i] == "--help"     { _print_usage(); exit(0) }
        i = i + 1
    }

    if analyze {
        let input = _arg_value(av, "--input", "")
        if len(input) == 0 {
            eprintln("ABORT: --analyze requires --input <npy> (raw#15 no personal paths)")
            _print_usage()
            exit(2)
        }
        print_analyze_plan(input)
        exit(0)
    }

    if realtime {
        let port     = _arg_value(av, "--port",     "")
        let board    = _arg_value(av, "--board",    DEFAULT_BOARD)
        let duration = _arg_int(  av, "--duration", DEFAULT_DURATION_S)
        if len(port) == 0 {
            eprintln("ABORT: --realtime requires --port (raw#15 no personal paths)")
            _print_usage()
            exit(2)
        }
        print_realtime_plan(port, board, duration)
        exit(0)
    }

    if !selftest {
        _print_usage()
        exit(2)
    }

    println("── concentration_episodes selftest ──")
    println("schema=" + SCHEMA)
    println("raw10_honest=synthetic_band_surrogate_no_real_welch_no_real_brainflow_terminal_only")
    println("raw82_darwin=welch_via_venv_eeg_python_helper")
    println("paradigm=daily_life_focus_mind_wander_episode_detection")
    println("")
    println("[honest C3 caveats — pre-registered]")
    println("  1. Klimesch 1999 frontal-θ has large individual variance (N=1 risk)")
    println("  2. Eye-blink contaminates Fp1/Fp2 θ-band 10-30× cortical signal")
    println("  3. Korean grid 60 Hz harmonics leak into β-band (verify notch per session)")
    println("")

    // Demonstration: focused_steady scenario → 1 focused episode of 60 s
    segment_synthetic("focused_steady")
    reset_falsifiers()
    evaluate_falsifiers()

    println("[demo focused_steady session]")
    println("frontal_theta="                + to_string(g_frontal_theta))
    println("frontal_beta="                 + to_string(g_frontal_beta))
    println("occipital_alpha="              + to_string(g_occipital_alpha))
    println("beta_alpha_ratio="             + to_string(g_beta_alpha_ratio))
    println("concentration_score="          + to_string(g_concentration_score))
    println("window_count="                 + to_string(g_window_count))
    println("focused_episode_count="        + to_string(g_focused_episode_count))
    println("mind_wander_episode_count="    + to_string(g_mind_wander_episode_count))
    println("focused_total_seconds="        + to_string(g_focused_total_seconds))
    println("mind_wander_total_seconds="    + to_string(g_mind_wander_total_seconds))
    println("total_session_seconds="        + to_string(g_total_session_seconds))
    println("overall_concentration_pct="    + to_string(g_overall_concentration_pct))
    println("last_focused_start_s="         + to_string(g_last_focused_start_s))
    println("last_focused_end_s="           + to_string(g_last_focused_end_s))
    println("last_focused_mean="            + to_string(g_last_focused_mean))
    println("f_conc_01="                    + _bool_str(g_f_conc_01_pass))
    println("f_conc_02="                    + _bool_str(g_f_conc_02_pass))
    println("f_conc_03="                    + _bool_str(g_f_conc_03_pass))
    println("")

    emit_sentinel()
    emit_audit("selftest_synth", "focused_steady")

    let fails = run_tests()
    if fails != 0 {
        println("selftest=fail")
        eprintln("selftest FAILED: " + to_string(fails) + " test(s) failed")
        exit(1)
    }
    println("selftest=ok")
    println("DONE")
}
