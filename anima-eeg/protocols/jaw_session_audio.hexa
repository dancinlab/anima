// anima-eeg/protocols/jaw_session_audio.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#15 no-personal-paths
// raw#65 idempotent · raw#71 falsifier-bound · raw#82 darwin-native
//
// @resolver-bypass(reason="darwin-native: shells out to /usr/bin/say + delegates to anima-eeg/collect.hexa")
//
// PURPOSE
//   Jaw-clench EMG artifact 측정 풀 sequence — audio cue (macOS `say -v Yuna`)
//   + collect.hexa 단일 90s capture wrapper. jaw_clench_emg.hexa pattern
//   보강 (eye_blink_detect / blink_session_audio mirror): 본 wrapper 가
//   phase 경계 측 실 say 호출 (audio cue interleaved with foreground
//   capture) 그리고 raw stream 측 collect.hexa 측 store.
//
//   Jaw-clench EMG artifact 는 1-2 mV (1000-2000 µV) 수준 (α-rhythm 보다
//   100-200×) 으로 robust easy-PASS paradigm. 본 wrapper 측 audio cue
//   timing + collect 측 raw npy 만 owner — analysis falsifier 측
//   jaw_clench_emg.hexa --run --input <npy> 측 별도 실행.
//
//   N=1 self-experiment, macOS only, no IRB scope (raw#10 honest C3).
//
// SEQUENCE (90s total)
//   phase 1 (0-30s):   REST    — "삼 초 후 휴식 시작" → 3s → "휴식. 턱 이완"
//   phase 2 (30-60s):  CLENCH  — "어금니 꽉 깨무세요. 일초당 한 번씩 삼십 번"
//   phase 3 (60-90s):  REST    — "휴식. 턱 이완"
//   end:               "측정 완료"
//
// USAGE
//   hexa run anima-eeg/protocols/jaw_session_audio.hexa --run \
//       --port /dev/cu.usbserial-DP04WGIQ --board cyton_daisy
//
//   options:
//       --duration <n>     full session sec (default 90; phases scale ÷3)
//       --voice <name>     macOS say voice (default Yuna)
//       --skip-impedance   impedance check 생략
//       --selftest         no-hardware dry-run

let SCHEMA = "anima-eeg/jaw_session_audio/1"

// Frozen defaults
let DEFAULT_DURATION_S    = 90
let DEFAULT_VOICE         = "Yuna"
let DEFAULT_PORT          = "/dev/cu.usbserial-DP04WGIQ"
let DEFAULT_BOARD         = "cyton_daisy"
let PHASE_REST1_S         = 30      // phase 1
let PHASE_CLENCH_S        = 30      // phase 2
let PHASE_REST2_S         = 30      // phase 3
let CUE_LEAD_S            = 3       // count-down before phase 1

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn say_cue(voice: str, text: str) -> int {
    // macOS `say` blocking call (returns 0 on success)
    let cmd = "say -v '" + voice + "' '" + text + "'"
    return exec_status(cmd)
}

fn say_cue_bg(voice: str, text: str) -> int {
    // background say — phase boundary cue overlapped with foreground capture
    let cmd = "say -v '" + voice + "' '" + text + "' &"
    return exec_status(cmd)
}

fn exec_status(cmd: str) -> int {
    let rc = exec(cmd)
    return rc
}

fn run_impedance(port: str) -> int {
    let cmd = "hexa run anima-eeg/impedance_check.hexa --check --port '" + port + "'"
    print("[step1] impedance check...")
    return exec_status(cmd)
}

fn run_collect_bg(port: str, board: str, duration: int, tag: str, output: str) -> int {
    // foreground 90s collect — phase audio cues fired via say_cue_bg between
    // sleep boundaries. collect.hexa owns USB serial capture; this wrapper
    // owns block-design timing.
    let cmd = "hexa run anima-eeg/collect.hexa --collect --duration " + str(duration)
              + " --tag " + tag
              + " --output '" + output + "'"
              + " --port '" + port + "'"
              + " --board '" + board + "' &"
    print("[capture-bg] " + tag + " " + str(duration) + "s ...")
    return exec_status(cmd)
}

fn wait_collect() -> int {
    return exec_status("wait")
}

fn sleep_seconds(n: int) {
    let cmd = "sleep " + str(n)
    exec_status(cmd)
}

fn ensure_dir(path: str) {
    exec_status("mkdir -p '" + path + "'")
}

fn date_tag_utc() -> str {
    // YYYY_MM_DD UTC — environment override 가능
    let env_tag = getenv("DATE_TAG")
    if env_tag != "" {
        return env_tag
    }
    let cmd = "date -u +%Y_%m_%d"
    return exec_capture(cmd)
}

fn exec_capture(cmd: str) -> str {
    return capture_stdout(cmd)
}

// ════════════════════════════════════════════════════════════════════
// Phases
//   Single 90s collect runs in background (subshell &).
//   Phase boundaries: sleep + non-blocking say cue overlap with capture.
// ════════════════════════════════════════════════════════════════════

fn phase_intro(voice: str) {
    // pre-capture cue (blocking) — kickoff
    say_cue(voice, "삼 초 후 휴식 시작")
    sleep_seconds(CUE_LEAD_S)
}

fn phase_rest1(voice: str, duration_phase: int) {
    // phase 1: REST (0 → duration_phase)
    say_cue_bg(voice, "휴식. 턱 이완")
    sleep_seconds(duration_phase)
}

fn phase_clench(voice: str, duration_phase: int) {
    // phase 2: CLENCH (duration_phase → 2*duration_phase)
    say_cue_bg(voice, "어금니 꽉 깨무세요. 일초당 한 번씩 삼십 번")
    sleep_seconds(duration_phase)
}

fn phase_rest2(voice: str, duration_phase: int) {
    // phase 3: REST (2*duration_phase → 3*duration_phase)
    say_cue_bg(voice, "휴식. 턱 이완")
    sleep_seconds(duration_phase)
}

fn phase_outro(voice: str) {
    // post-capture cue
    say_cue(voice, "측정 완료")
}

// ════════════════════════════════════════════════════════════════════
// Main
// ════════════════════════════════════════════════════════════════════

fn cmd_run(port: str, board: str, duration: int, voice: str, skip_impedance: int) -> int {
    let session_dir = "anima-eeg/recordings/sessions"
    ensure_dir(session_dir)

    let date_tag = date_tag_utc()
    let raw_npy = session_dir + "/jaw_audio_90s_" + date_tag + ".npy"

    // phase split: equal thirds (default 30/30/30 for 90s total)
    let phase_s = duration / 3

    print("=== Jaw-Clench EMG 측정 (audio cue) ===")
    print("port=" + port + "  board=" + board)
    print("duration=" + str(duration) + "s (REST " + str(phase_s)
          + "s → CLENCH " + str(phase_s) + "s → REST " + str(phase_s) + "s)")
    print("voice=" + voice)
    print("output: " + raw_npy)
    print("=======================================")

    // Step 1: impedance (optional)
    if skip_impedance == 0 {
        say_cue(voice, "임피던스 측정 시작")
        let imp_rc = run_impedance(port)
        if imp_rc != 0 {
            say_cue(voice, "임피던스 측정 실패. 전극을 다시 확인하세요")
            print("[error] impedance check 실패")
            return 1
        }
        print("[step1] impedance: 16/16 GREEN 확인 후 Enter (Ctrl-C 중단)")
        // raw#10: bash heredoc 측 사용자 confirm 직접 require
        readline()
    }

    // Step 2: launch single 90s capture in background
    let collect_rc = run_collect_bg(port, board, duration, "jaw_audio_v1", raw_npy)
    if collect_rc != 0 {
        say_cue(voice, "측정 실패")
        print("[error] collect launch 실패 rc=" + str(collect_rc))
        return 2
    }

    // Step 3: phase audio cues interleaved with sleep
    phase_intro(voice)
    phase_rest1(voice, phase_s)
    phase_clench(voice, phase_s)
    phase_rest2(voice, phase_s)

    // Step 4: wait for collect.hexa subshell completion
    let wait_rc = wait_collect()
    if wait_rc != 0 {
        say_cue(voice, "측정 실패")
        print("[error] collect 측 wait rc=" + str(wait_rc))
        return 3
    }

    phase_outro(voice)

    print("")
    print("=== 측정 완료 ===")
    print("output: " + raw_npy)
    print("")
    print("다음 단계: jaw_clench_emg.hexa --run --input " + raw_npy)
    print("           (F_JAW_01/02/03 verdict)")
    return 0
}

fn cmd_selftest() -> int {
    print("[selftest] jaw_session_audio.hexa")
    print("[selftest] dry-run: no hardware, no say cue, no collect.hexa")

    let voice = DEFAULT_VOICE
    let port = DEFAULT_PORT
    let board = DEFAULT_BOARD

    // assertions (synthetic)
    let test_count = 0
    let pass_count = 0

    // T1: voice default
    test_count = test_count + 1
    if voice == "Yuna" { pass_count = pass_count + 1 }
    else { print("[FAIL] T1 voice default") }

    // T2: duration default
    test_count = test_count + 1
    if DEFAULT_DURATION_S == 90 { pass_count = pass_count + 1 }
    else { print("[FAIL] T2 duration default") }

    // T3: phase split (REST1 + CLENCH + REST2 == DEFAULT_DURATION_S)
    test_count = test_count + 1
    let phase_sum = PHASE_REST1_S + PHASE_CLENCH_S + PHASE_REST2_S
    if phase_sum == DEFAULT_DURATION_S { pass_count = pass_count + 1 }
    else { print("[FAIL] T3 phase sum != 90 (got " + str(phase_sum) + ")") }

    // T4: equal thirds — phase 1 REST
    test_count = test_count + 1
    if PHASE_REST1_S == 30 { pass_count = pass_count + 1 }
    else { print("[FAIL] T4 phase 1 != 30s") }

    // T5: equal thirds — phase 2 CLENCH
    test_count = test_count + 1
    if PHASE_CLENCH_S == 30 { pass_count = pass_count + 1 }
    else { print("[FAIL] T5 phase 2 != 30s") }

    // T6: equal thirds — phase 3 REST
    test_count = test_count + 1
    if PHASE_REST2_S == 30 { pass_count = pass_count + 1 }
    else { print("[FAIL] T6 phase 3 != 30s") }

    // T7: cue lead
    test_count = test_count + 1
    if CUE_LEAD_S == 3 { pass_count = pass_count + 1 }
    else { print("[FAIL] T7 cue lead != 3s") }

    // T8: board default
    test_count = test_count + 1
    if board == "cyton_daisy" { pass_count = pass_count + 1 }
    else { print("[FAIL] T8 board default") }

    // T9: synthetic phase timing (computed split equals frozen split)
    test_count = test_count + 1
    let computed_phase = DEFAULT_DURATION_S / 3
    if computed_phase == PHASE_REST1_S { pass_count = pass_count + 1 }
    else { print("[FAIL] T9 computed phase != frozen phase") }

    // T10: port default (raw#15 — default is dongle node, never personal home)
    test_count = test_count + 1
    if port == "/dev/cu.usbserial-DP04WGIQ" { pass_count = pass_count + 1 }
    else { print("[FAIL] T10 port default") }

    print("[selftest] " + str(pass_count) + " PASS / "
          + str(test_count - pass_count) + " FAIL")
    if pass_count == test_count {
        print("__JAW_AUDIO__ PASS")
        return 0
    }
    print("__JAW_AUDIO__ FAIL")
    return 1
}

// ════════════════════════════════════════════════════════════════════
// Argv dispatch
// ════════════════════════════════════════════════════════════════════

fn print_usage() {
    print("usage:")
    print("  hexa run anima-eeg/protocols/jaw_session_audio.hexa --run \\")
    print("       --port <path> --board <name> [--duration <n>] [--voice <name>]")
    print("  hexa run anima-eeg/protocols/jaw_session_audio.hexa --selftest")
    print("flags:")
    print("  --selftest          no-hardware dry-run")
    print("  --run               full jaw-clench session (impedance + 90s capture)")
    print("  --port <path>       Dongle serial node (default " + DEFAULT_PORT + ")")
    print("  --board <name>      cyton_daisy | cyton (default " + DEFAULT_BOARD + ")")
    print("  --duration <n>      full session sec (default " + str(DEFAULT_DURATION_S) + ")")
    print("  --voice <name>      macOS say voice (default " + DEFAULT_VOICE + ")")
    print("  --skip-impedance    skip impedance check")
    print("  --help              this message")
}

fn main() -> int {
    let av = argv()
    let n = len(av)

    let mut mode = "help"
    let mut port = DEFAULT_PORT
    let mut board = DEFAULT_BOARD
    let mut duration = DEFAULT_DURATION_S
    let mut voice = DEFAULT_VOICE
    let mut skip_impedance = 0

    // skip leading interpreter / script / cache paths until first flag
    // (handles: hexa_interp.real, anima-eeg/.../jaw_session_audio.hexa,
    //  build cache /exe stubs, any absolute path-like argv prefix)
    let mut start = 0
    while start < n {
        let a = av[start]
        let mut is_flag = false
        if len(a) >= 2 {
            // crude flag detector — first two chars "--"
            if a.starts_with("--") { is_flag = true }
        }
        if is_flag { break }
        if a == "" { break }
        // anything else (interp path, script path, /exe, .real) = skip
        start = start + 1
    }

    let mut i = start
    while i < n {
        let a = av[i]
        if a == "--selftest" { mode = "selftest" }
        else if a == "--run" { mode = "run" }
        else if a == "--port" {
            if i + 1 < n { port = av[i + 1]; i = i + 1 }
        }
        else if a == "--board" {
            if i + 1 < n { board = av[i + 1]; i = i + 1 }
        }
        else if a == "--duration" {
            if i + 1 < n { duration = int_parse(av[i + 1]); i = i + 1 }
        }
        else if a == "--voice" {
            if i + 1 < n { voice = av[i + 1]; i = i + 1 }
        }
        else if a == "--skip-impedance" { skip_impedance = 1 }
        else if a == "--help" { mode = "help" }
        else {
            print("[error] unknown flag: " + a)
            print_usage()
            return 2
        }
        i = i + 1
    }

    if mode == "selftest" {
        return cmd_selftest()
    }
    if mode == "run" {
        return cmd_run(port, board, duration, voice, skip_impedance)
    }
    print_usage()
    return 0
}
