// anima-eeg/protocols/alpha_eyes_closed.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#15 no-personal-paths · raw#65 idempotent · raw#71 falsifier-3 · raw#82 darwin-native
// raw#91 honest-class · own 5
//
// @resolver-bypass(reason="darwin-native: --run delegates to anima-eeg/collect.hexa subprocess which uses .venv-eeg BrainFlow + USB-serial dongle on host; selftest uses pure-hexa block-design simulation but unified bypass keeps route stable")
//
// Source: references/Documentation/.../01-EEG-Setup.md §4 ("Alpha brain waves")
// Historic: Berger H. (1929) "Über das Elektrenkephalogramm des Menschen"
//
// PURPOSE
//   Berger 1929 alpha-rhythm reproduction (eyes-closed vs eyes-open block design).
//   Single self-validating session: board sanity + SRB2/BIAS + 60Hz notch +
//   O1/O2 occipital pickup. N=1, no IRB scope (raw#10 honest C3).
//
//   Three falsifiers locked pre-registration (raw#71):
//     F_BERGER_01: alpha peak in 7.5-12.5 Hz (Berger 1929)
//     F_BERGER_02: O1/O2 amplitude > Fp2 amplitude (occipital-dominant)
//     F_BERGER_03: eyes-closed alpha power > eyes-open alpha power × 2
//                  (Berger 1929 alpha-blocking)
//
// LIVE BRAINFLOW INGEST: --run gates on a sibling helper subprocess.
//   This file lands the protocol skeleton + analysis + selftest. --run
//   delegates to anima-eeg/collect.hexa (NameError BG fix applied) for
//   raw stream capture; this protocol owns block design + audio cue +
//   alpha-band analysis + falsifier evaluation.
//
// USAGE
//   hexa run anima-eeg/protocols/alpha_eyes_closed.hexa --selftest
//   hexa run anima-eeg/protocols/alpha_eyes_closed.hexa --run \
//       --port /dev/cu.usbserial-DP04WGIQ \
//       --board cyton_daisy \
//       --output anima-eeg/recordings/sessions/berger_2026_05_03.npy

let SCHEMA = "anima-eeg/alpha_eyes_closed/1"

// ════════════════════════════════════════════════════════════════════
// Frozen block design (raw#12 pre-registered)
// ════════════════════════════════════════════════════════════════════

let BLOCK_DURATION_S         = 30           // each EC or EO block
let BLOCK_REPEATS            = 5            // 5 EC + 5 EO interleaved
let TOTAL_DURATION_S         = 300          // 5 min
let CUE_LEAD_MS              = 500          // audio cue lead before block start

// Board / signal-chain frozen
let SAMPLE_RATE_HZ           = 250          // Cyton+Daisy fixed
let CHANNEL_COUNT            = 16           // Cyton+Daisy 16ch
let NOTCH_HZ                 = 60.0         // 한국 grid (raw#10 honest assumption)
let BANDPASS_LO_HZ           = 1.0
let BANDPASS_HI_HZ           = 50.0
let BANDPASS_ORDER           = 4            // Butterworth order-4

// Alpha analysis frozen
let ALPHA_LO_HZ              = 7.5          // Berger 1929 lower bound
let ALPHA_HI_HZ              = 12.5         // Berger 1929 upper bound
let WELCH_NPERSEG_S          = 2            // 2 s windows for Welch PSD
let EC_EO_RATIO_MIN          = 2.0          // F_BERGER_03 threshold

// Channel mapping (10-20 system; user must verify physical placement)
let CHAN_FP2                 = "Fp2"        // frontal-polar (control)
let CHAN_O1                  = "O1"         // left occipital
let CHAN_O2                  = "O2"         // right occipital

// Audit ledger path
let AUDIT_DIR  = "state/alpha_eyes_closed_audit"

// ════════════════════════════════════════════════════════════════════
// Globals (raw#9 strict — no fallbacks, all measured)
// ════════════════════════════════════════════════════════════════════

// Block schedule
let g_block_count            = 0           // total blocks scheduled
let g_block_ec_count         = 0
let g_block_eo_count         = 0
let g_total_seconds          = 0

// Synthetic alpha analysis state
let g_alpha_peak_hz          = 0.0         // dominant peak in 7.5-12.5 Hz
let g_alpha_peak_chan        = "?"
let g_o1_alpha_uv            = 0.0
let g_o2_alpha_uv            = 0.0
let g_fp2_alpha_uv           = 0.0
let g_ec_alpha_power         = 0.0
let g_eo_alpha_power         = 0.0
let g_ec_eo_ratio            = 0.0

// Falsifier evaluations (raw#71)
let g_f_berger_01_pass       = false       // peak in 7.5-12.5 Hz
let g_f_berger_02_pass       = false       // O1/O2 > Fp2
let g_f_berger_03_pass       = false       // EC alpha > EO alpha × 2

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn max_f(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

// ════════════════════════════════════════════════════════════════════
// Block schedule generator (raw#65 idempotent — no RNG needed)
//   Interleaved EC → EO → EC → EO → ... starting with EC.
//   5 × EC + 5 × EO = 10 blocks × 30 s = 300 s.
// ════════════════════════════════════════════════════════════════════

fn build_schedule() {
    g_block_ec_count = BLOCK_REPEATS
    g_block_eo_count = BLOCK_REPEATS
    g_block_count    = g_block_ec_count + g_block_eo_count
    g_total_seconds  = g_block_count * BLOCK_DURATION_S
}

// Returns "EC" or "EO" for block index i (0-based).
fn block_kind_at(i: int) -> string {
    if (i % 2) == 0 { return "EC" }
    return "EO"
}

// Returns audio cue text for block index i.
fn cue_text_at(i: int) -> string {
    if block_kind_at(i) == "EC" { return "눈 감으세요 (close eyes)" }
    return "눈 뜨세요 (open eyes)"
}

// ════════════════════════════════════════════════════════════════════
// Synthetic alpha-band analysis
//   Pure-math synthetic α power per channel × condition (no RNG):
//     EC condition: O1/O2 strong α (~30 µV²/Hz peak @ 10 Hz),
//                   Fp2 weak α (~5 µV²/Hz, blink-corrupted)
//     EO condition: O1/O2 attenuated to ~10 µV²/Hz (alpha-blocking),
//                   Fp2 ~5 µV²/Hz (unchanged)
//   Caller specifies "perturb_*" flags to exercise falsifiers in tests.
// ════════════════════════════════════════════════════════════════════

let SYNTH_O_EC_ALPHA_UV2     = 30.0
let SYNTH_O_EO_ALPHA_UV2     = 10.0
let SYNTH_FP2_ALPHA_UV2      = 5.0
let SYNTH_PEAK_HZ_NOMINAL    = 10.0

fn analyze_synthetic(
    perturb_no_alpha: bool,
    perturb_frontal_max: bool,
    perturb_no_blocking: bool
) {
    // Baseline values
    let mut o_ec  = SYNTH_O_EC_ALPHA_UV2
    let mut o_eo  = SYNTH_O_EO_ALPHA_UV2
    let mut fp2   = SYNTH_FP2_ALPHA_UV2
    let mut peak  = SYNTH_PEAK_HZ_NOMINAL

    // F_BERGER_01 perturbation: peak outside 7.5-12.5 Hz
    if perturb_no_alpha {
        peak = 5.0   // 5 Hz theta — outside α band
    }

    // F_BERGER_02 perturbation: Fp2 dominates (frontal max)
    if perturb_frontal_max {
        fp2  = 50.0
        o_ec = 10.0
    }

    // F_BERGER_03 perturbation: no alpha-blocking (EC ≈ EO)
    if perturb_no_blocking {
        o_eo = 25.0   // close to o_ec → ratio < 2
    }

    g_alpha_peak_hz   = peak
    g_alpha_peak_chan = "O2"
    if perturb_frontal_max { g_alpha_peak_chan = "Fp2" }

    g_o1_alpha_uv  = o_ec
    g_o2_alpha_uv  = o_ec
    g_fp2_alpha_uv = fp2

    g_ec_alpha_power = o_ec
    g_eo_alpha_power = o_eo
    if g_eo_alpha_power > 0.0 {
        g_ec_eo_ratio = g_ec_alpha_power / g_eo_alpha_power
    } else {
        g_ec_eo_ratio = 0.0
    }
}

// ════════════════════════════════════════════════════════════════════
// Frozen falsifier evaluation (raw#71)
// ════════════════════════════════════════════════════════════════════

fn evaluate_falsifiers() {
    // F_BERGER_01: peak in 7.5-12.5 Hz
    g_f_berger_01_pass = g_alpha_peak_hz >= ALPHA_LO_HZ && g_alpha_peak_hz <= ALPHA_HI_HZ

    // F_BERGER_02: O1/O2 max amplitude > Fp2 amplitude
    let o_max = max_f(g_o1_alpha_uv, g_o2_alpha_uv)
    g_f_berger_02_pass = o_max > g_fp2_alpha_uv

    // F_BERGER_03: EC alpha > EO alpha × 2
    g_f_berger_03_pass = g_ec_eo_ratio >= EC_EO_RATIO_MIN
}

// ════════════════════════════════════════════════════════════════════
// Sentinel emit (raw#71 falsifier-bound)
//   __EEG_BERGER_1929__ <PASS|FAIL> <peak_hz> <ec_eo_ratio>
// ════════════════════════════════════════════════════════════════════

fn emit_sentinel() {
    let mut verdict = "PASS"
    if !(g_f_berger_01_pass && g_f_berger_02_pass && g_f_berger_03_pass) {
        verdict = "FAIL"
    }
    println("__EEG_BERGER_1929__ " + verdict + " " + to_string(g_alpha_peak_hz) + " " + to_string(g_ec_eo_ratio))
}

// ════════════════════════════════════════════════════════════════════
// Audit JSONL emit (raw#65 idempotent in selftest mode)
// ════════════════════════════════════════════════════════════════════

fn emit_audit(ts: string) {
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"block_count\":" + to_string(g_block_count) + ","
    row = row + "\"block_ec\":" + to_string(g_block_ec_count) + ","
    row = row + "\"block_eo\":" + to_string(g_block_eo_count) + ","
    row = row + "\"total_seconds\":" + to_string(g_total_seconds) + ","
    row = row + "\"alpha_peak_hz\":" + to_string(g_alpha_peak_hz) + ","
    row = row + "\"alpha_peak_chan\":\"" + g_alpha_peak_chan + "\","
    row = row + "\"o1_alpha_uv\":" + to_string(g_o1_alpha_uv) + ","
    row = row + "\"o2_alpha_uv\":" + to_string(g_o2_alpha_uv) + ","
    row = row + "\"fp2_alpha_uv\":" + to_string(g_fp2_alpha_uv) + ","
    row = row + "\"ec_alpha_power\":" + to_string(g_ec_alpha_power) + ","
    row = row + "\"eo_alpha_power\":" + to_string(g_eo_alpha_power) + ","
    row = row + "\"ec_eo_ratio\":" + to_string(g_ec_eo_ratio) + ","
    row = row + "\"f_berger_01\":" + _bool_str(g_f_berger_01_pass) + ","
    row = row + "\"f_berger_02\":" + _bool_str(g_f_berger_02_pass) + ","
    row = row + "\"f_berger_03\":" + _bool_str(g_f_berger_03_pass)
    row = row + "}"
    let nl = chr(10)
    let mut existing = ""
    let prior = read_file(path)
    if prior != "" { existing = prior }
    write_file(path, existing + row + nl)
}

// ════════════════════════════════════════════════════════════════════
// Live runner — collect.hexa subprocess delegation
//   raw#10 honest: this protocol does NOT do raw BrainFlow ingest itself;
//   it delegates to anima-eeg/collect.hexa (NameError BG fix applied) and
//   then post-analyzes the .npy. --run prints the audio cue schedule and
//   shells out the collect command; user runs in a separate terminal /
//   hooks audio. raw#15: no personal paths hardcoded (all CLI args).
// ════════════════════════════════════════════════════════════════════

fn print_run_plan(port: string, board: string, output: string) {
    build_schedule()
    println("── alpha_eyes_closed live run plan ──")
    println("schema=" + SCHEMA)
    println("port=" + port)
    println("board=" + board)
    println("output=" + output)
    println("sample_rate_hz=" + to_string(SAMPLE_RATE_HZ))
    println("channel_count=" + to_string(CHANNEL_COUNT))
    println("notch_hz=" + to_string(NOTCH_HZ))
    println("bandpass=" + to_string(BANDPASS_LO_HZ) + "-" + to_string(BANDPASS_HI_HZ) + " Hz, order=" + to_string(BANDPASS_ORDER))
    println("total_seconds=" + to_string(g_total_seconds))
    println("")
    println("[block schedule — interleaved EC/EO × 5]")
    let mut i = 0
    while i < g_block_count {
        let t0 = i * BLOCK_DURATION_S
        let kind = block_kind_at(i)
        let cue = cue_text_at(i)
        println("  t=" + to_string(t0) + "s  block#" + to_string(i + 1) + "  " + kind + "  cue=\"" + cue + "\"")
        i = i + 1
    }
    println("")
    println("[user hand-step — montage assumption]")
    println("  N2P (ch2)  -> Fp2 (forehead, 1\" above right brow, 1\" right of midline)")
    println("  N7P (ch7)  -> O1  (1\" above inion, 1\" left)")
    println("  N8P (ch8)  -> O2  (1\" above inion, 1\" right)")
    println("  SRB2       -> A1 earlobe (white wire)")
    println("  BIAS       -> A2 earlobe (black wire)")
    println("")
    println("[delegate command — run in separate terminal]")
    println("  hexa run anima-eeg/collect.hexa --port " + port + " \\")
    println("      --board " + board + " --duration " + to_string(g_total_seconds) + " \\")
    println("      --output " + output)
    println("")
    println("[audio cues — follow on speaker / TTS at t=0,30,60,90,120,150,180,210,240,270]")
}

// ════════════════════════════════════════════════════════════════════
// Tests (selftest)
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn run_tests() -> int {
    let mut pass = 0
    let mut fail = 0

    println("=== alpha_eyes_closed selftest ===")

    // T1: schedule build (10 blocks, 300 s)
    println("[T1] schedule build")
    build_schedule()
    let ok1a = assert_true(g_block_count == 10, "block_count == 10")
    let ok1b = assert_true(g_block_ec_count == 5, "EC blocks == 5")
    let ok1c = assert_true(g_block_eo_count == 5, "EO blocks == 5")
    let ok1d = assert_true(g_total_seconds == TOTAL_DURATION_S, "total seconds == 300")
    if ok1a && ok1b && ok1c && ok1d { pass = pass + 1 } else { fail = fail + 1 }

    // T2: interleaved EC/EO ordering
    println("[T2] interleaved EC/EO ordering")
    let ok2a = assert_true(block_kind_at(0) == "EC", "block 0 = EC")
    let ok2b = assert_true(block_kind_at(1) == "EO", "block 1 = EO")
    let ok2c = assert_true(block_kind_at(8) == "EC", "block 8 = EC")
    let ok2d = assert_true(block_kind_at(9) == "EO", "block 9 = EO")
    if ok2a && ok2b && ok2c && ok2d { pass = pass + 1 } else { fail = fail + 1 }

    // T3: idempotent rebuild (raw#65)
    println("[T3] idempotent schedule rebuild")
    build_schedule()
    let bc1 = g_block_count
    build_schedule()
    let ok3 = assert_true(g_block_count == bc1, "block count idempotent")
    if ok3 { pass = pass + 1 } else { fail = fail + 1 }

    // T4: nominal synthetic — all 3 falsifiers PASS
    println("[T4] synthetic nominal — F_BERGER_01/02/03 PASS")
    analyze_synthetic(false, false, false)
    evaluate_falsifiers()
    let ok4a = assert_true(g_f_berger_01_pass, "F_BERGER_01 alpha peak in 7.5-12.5 Hz")
    let ok4b = assert_true(g_f_berger_02_pass, "F_BERGER_02 O1/O2 > Fp2")
    let ok4c = assert_true(g_f_berger_03_pass, "F_BERGER_03 EC/EO ratio >= 2")
    let ok4d = assert_true(g_ec_eo_ratio >= 2.0, "EC/EO ratio = " + to_string(g_ec_eo_ratio))
    if ok4a && ok4b && ok4c && ok4d { pass = pass + 1 } else { fail = fail + 1 }

    // T5: F_BERGER_01 falsifier — peak outside α band
    println("[T5] F_BERGER_01 falsifier — peak @ 5 Hz (theta)")
    analyze_synthetic(true, false, false)
    evaluate_falsifiers()
    let ok5a = assert_true(!g_f_berger_01_pass, "F_BERGER_01 fails")
    let ok5b = assert_true(g_f_berger_02_pass, "F_BERGER_02 still passes")
    let ok5c = assert_true(g_f_berger_03_pass, "F_BERGER_03 still passes")
    if ok5a && ok5b && ok5c { pass = pass + 1 } else { fail = fail + 1 }

    // T6: F_BERGER_02 falsifier — frontal max
    println("[T6] F_BERGER_02 falsifier — Fp2 dominates")
    analyze_synthetic(false, true, false)
    evaluate_falsifiers()
    let ok6a = assert_true(g_f_berger_01_pass, "F_BERGER_01 still passes")
    let ok6b = assert_true(!g_f_berger_02_pass, "F_BERGER_02 fails (frontal max)")
    if ok6a && ok6b { pass = pass + 1 } else { fail = fail + 1 }

    // T7: F_BERGER_03 falsifier — no α blocking
    println("[T7] F_BERGER_03 falsifier — EC ≈ EO")
    analyze_synthetic(false, false, true)
    evaluate_falsifiers()
    let ok7a = assert_true(g_f_berger_01_pass, "F_BERGER_01 still passes")
    let ok7b = assert_true(g_f_berger_02_pass, "F_BERGER_02 still passes")
    let ok7c = assert_true(!g_f_berger_03_pass, "F_BERGER_03 fails (no blocking)")
    if ok7a && ok7b && ok7c { pass = pass + 1 } else { fail = fail + 1 }

    // T8: cue text mapping
    println("[T8] audio cue text")
    let cue_ec = cue_text_at(0)
    let cue_eo = cue_text_at(1)
    let ok8a = assert_true(cue_ec == "눈 감으세요 (close eyes)", "EC cue text")
    let ok8b = assert_true(cue_eo == "눈 뜨세요 (open eyes)", "EO cue text")
    if ok8a && ok8b { pass = pass + 1 } else { fail = fail + 1 }

    // T9: audit JSONL emit (raw#65 byte-stable)
    println("[T9] audit JSONL emit deterministic")
    build_schedule()
    analyze_synthetic(false, false, false)
    evaluate_falsifiers()
    let ts = "selftest_synth"
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    write_file(path, "")
    emit_audit(ts)
    let body1 = read_file(path)
    write_file(path, "")
    emit_audit(ts)
    let body2 = read_file(path)
    let ok9a = assert_true(body1 == body2, "audit row byte-stable")
    let ok9b = assert_true(len(body1) > 0, "audit row non-empty")
    if ok9a && ok9b { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// CLI entry
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    println("usage:")
    println("  hexa run anima-eeg/protocols/alpha_eyes_closed.hexa --selftest")
    println("  hexa run anima-eeg/protocols/alpha_eyes_closed.hexa --run \\")
    println("      --port <serial> --board <cyton_daisy> --output <npy>")
}

fn _arg_value(av: list, key: string, dflt: string) -> string {
    let mut i = 1
    while i < len(av) {
        if av[i] == key && i + 1 < len(av) {
            return av[i + 1]
        }
        i = i + 1
    }
    return dflt
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut run = false
    let mut i = 1
    while i < len(av) {
        if av[i] == "--selftest" { selftest = true }
        if av[i] == "--run"      { run = true }
        if av[i] == "--help"     { _print_usage(); exit(0) }
        i = i + 1
    }

    if run {
        let port   = _arg_value(av, "--port",   "")
        let board  = _arg_value(av, "--board",  "cyton_daisy")
        let output = _arg_value(av, "--output", "")
        if len(port) == 0 || len(output) == 0 {
            eprintln("ABORT: --run requires --port and --output (raw#15 no personal paths)")
            _print_usage()
            exit(2)
        }
        print_run_plan(port, board, output)
        // raw#10 honest: this cycle prints plan + audio cue schedule;
        // the actual collect.hexa subprocess + audio TTS hook is the
        // user hand-step. Plan is logged; user executes in separate
        // terminal and reports back the .npy for analyze pass.
        exit(0)
    }

    if !selftest {
        _print_usage()
        exit(2)
    }

    println("── alpha_eyes_closed selftest ──")
    println("schema=" + SCHEMA)
    println("raw10_honest=synthetic_alpha_no_real_brainflow_no_audio_terminal_only")
    println("raw82_darwin=clock_gettime_monotonic_via_collect_hexa")
    println("source=references/.../01-EEG-Setup.md_§4_Berger_1929")
    println("")

    // Demonstration (synthetic nominal session)
    build_schedule()
    analyze_synthetic(false, false, false)
    evaluate_falsifiers()

    println("[demo nominal session]")
    println("block_count="     + to_string(g_block_count))
    println("total_seconds="   + to_string(g_total_seconds))
    println("alpha_peak_hz="   + to_string(g_alpha_peak_hz))
    println("alpha_peak_chan=" + g_alpha_peak_chan)
    println("o1_alpha_uv="     + to_string(g_o1_alpha_uv))
    println("o2_alpha_uv="     + to_string(g_o2_alpha_uv))
    println("fp2_alpha_uv="    + to_string(g_fp2_alpha_uv))
    println("ec_alpha_power="  + to_string(g_ec_alpha_power))
    println("eo_alpha_power="  + to_string(g_eo_alpha_power))
    println("ec_eo_ratio="     + to_string(g_ec_eo_ratio))
    println("f_berger_01="     + _bool_str(g_f_berger_01_pass))
    println("f_berger_02="     + _bool_str(g_f_berger_02_pass))
    println("f_berger_03="     + _bool_str(g_f_berger_03_pass))
    println("")

    emit_sentinel()
    emit_audit("selftest_synth")

    let fails = run_tests()
    if fails != 0 {
        println("selftest=fail")
        eprintln("selftest FAILED: " + to_string(fails) + " test(s) failed")
        exit(1)
    }
    println("selftest=ok")
    println("DONE")
}

main()
