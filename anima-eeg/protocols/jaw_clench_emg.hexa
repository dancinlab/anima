// anima-eeg/protocols/jaw_clench_emg.hexa
// raw#9 hexa-only · raw#10 honest-C3 · raw#11 snake_case · raw#12 frozen
// raw#15 no-personal-paths · raw#65 idempotent · raw#71 falsifier-3 · raw#82 darwin-native
// raw#91 honest-class · own 5
//
// @resolver-bypass(reason="darwin-native: --run delegates to anima-eeg/collect.hexa subprocess which uses .venv-eeg BrainFlow + USB-serial dongle on host; selftest uses pure-hexa synthetic clench train (rectified RMS amplitude time-domain) but unified bypass keeps route stable")
//
// PURPOSE
//   Jaw-clench EMG artifact detection — highest-confidence easy-PASS
//   paradigm following eye_blink_detect (524L, 10/10 selftest PASS).
//   Temporalis/masseter EMG amplitude at temporal electrodes (T7/T8)
//   reaches 500-2000 µV during voluntary clench, even more robust than
//   blink. Frequency content (20-200 Hz) cleanly separates from EEG band
//   (1-50 Hz). Fully user-controlled. N=1 self-experiment, no IRB scope
//   (raw#10 honest C3).
//
//   raw#10 honest C3 — EMG ≠ EEG: this protocol detects MUSCLE artifact
//   (electromyography), not brain electrical activity. EEG purists treat
//   muscle activity as noise; here it is the SIGNAL because temporal
//   electrode pickup of temporalis/masseter contraction is unambiguous,
//   high-amplitude, and falsifiable. Sentinel reads __EEG_JAW_CLENCH__
//   only because the recording chain is the same Cyton+Daisy used for
//   EEG; the physiological substrate is muscle, not cortex.
//
//   Three falsifiers locked pre-registration (raw#71):
//     F_JAW_01: T7/T8 CLENCH RMS amplitude > 300 µV
//     F_JAW_02: CLENCH/REST RMS ratio >= 5x (strong EMG signal)
//     F_JAW_03: T7/T8 EMG amplitude > O1/O2 amplitude (temporal-dominant)
//
// LIVE BRAINFLOW INGEST: --run delegates to anima-eeg/collect.hexa for
//   raw stream capture; this protocol owns block design + audio cue +
//   bandpass-rectify-RMS analysis + falsifier evaluation.
//
// USAGE
//   hexa run anima-eeg/protocols/jaw_clench_emg.hexa --selftest
//   hexa run anima-eeg/protocols/jaw_clench_emg.hexa --run \
//       --port <serial> --board cyton_daisy --output <npy>

let SCHEMA = "anima-eeg/jaw_clench_emg/1"

// ════════════════════════════════════════════════════════════════════
// Frozen block design (raw#12 pre-registered)
//   REST 30s → CLENCH 30s → REST 30s = 90s total
//   CLENCH: voluntary teeth-clench, 1 per second (~30 bursts)
// ════════════════════════════════════════════════════════════════════

let BLOCK_REST_S             = 30           // each REST block (jaw relaxed)
let BLOCK_CLENCH_S           = 30           // CLENCH block (1 Hz repetition)
let BLOCK_COUNT              = 3            // REST, CLENCH, REST
let TOTAL_DURATION_S         = 90           // 30+30+30
let CUE_LEAD_MS              = 500          // audio cue lead

// Board / signal-chain frozen
let SAMPLE_RATE_HZ           = 250          // Cyton+Daisy fixed
let CHANNEL_COUNT            = 16           // Cyton+Daisy 16ch
let NOTCH_HZ                 = 60.0         // 한국 grid (raw#10 honest assumption)

// EMG-band bandpass (high-frequency dominant — separates from EEG 1-50 Hz)
let BANDPASS_LO_HZ           = 20.0         // EMG starts ~20 Hz
let BANDPASS_HI_HZ           = 200.0        // EMG up to 200 Hz (Nyquist=125)
let BANDPASS_ORDER           = 4            // Butterworth order-4
// raw#10 honest: 250 Hz sample → Nyquist 125 Hz; effective EMG band is
// 20-125 Hz (200 Hz HP cutoff is theoretical; HW band-limits to Nyquist).

// Time-domain rectified-RMS detection
let CLENCH_RMS_WINDOW_MS     = 100          // moving RMS window (100 ms)
let CLENCH_THRESHOLD_UV      = 200.0        // rectified RMS > 200 µV → event
let CLENCH_INTERVAL_MIN_MS   = 500          // refractory between events
let CLENCH_RMS_PASS_UV       = 300.0        // F_JAW_01: RMS > 300 µV
let CLENCH_REST_RATIO_PASS   = 5.0          // F_JAW_02: clench/rest >= 5x
let CLENCH_TARGET_COUNT      = 30           // intentional 1 Hz × 30 s
let CLENCH_COUNT_LO          = 20           // observed-count sanity floor
let CLENCH_COUNT_HI          = 40           // observed-count sanity ceiling

// Channel mapping (10-20 system, Cyton+Daisy 16ch)
let CHAN_T7                  = "T7"         // left temporal — temporalis
let CHAN_T8                  = "T8"         // right temporal — masseter pickup
let CHAN_O1                  = "O1"         // left occipital (EMG-immune)
let CHAN_O2                  = "O2"         // right occipital (EMG-immune)

// Audit ledger path
let AUDIT_DIR  = "state/jaw_clench_emg_audit"

// ════════════════════════════════════════════════════════════════════
// Globals (raw#9 strict — no fallbacks, all measured)
// ════════════════════════════════════════════════════════════════════

// Block schedule
let g_block_count            = 0
let g_total_seconds          = 0

// Synthetic clench-train analysis state
let g_clench_count           = 0
let g_t_max_amp_uv           = 0.0          // max T7/T8 peak amplitude
let g_t_clench_rms_uv        = 0.0          // T max RMS during CLENCH
let g_t_rest_rms_uv          = 0.0          // T max RMS during REST
let g_o_clench_rms_uv        = 0.0          // O max RMS during CLENCH
let g_o_rest_rms_uv          = 0.0          // O max RMS during REST
let g_t7_clench_rms_uv       = 0.0
let g_t8_clench_rms_uv       = 0.0
let g_o1_clench_rms_uv       = 0.0
let g_o2_clench_rms_uv       = 0.0
let g_clench_rest_ratio      = 0.0          // T_clench / T_rest
let g_min_iclench_interval_ms = 0           // tightest inter-clench interval

// Falsifier evaluations (raw#71)
let g_f_jaw_01_pass          = false        // T7/T8 RMS > 300 µV
let g_f_jaw_02_pass          = false        // CLENCH/REST ratio >= 5x
let g_f_jaw_03_pass          = false        // T7/T8 > O1/O2 (temporal-dominant)

// ════════════════════════════════════════════════════════════════════
// Helpers
// ════════════════════════════════════════════════════════════════════

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn max_f(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn safe_div(a: float, b: float) -> float {
    if b <= 0.0 { return 0.0 }
    return a / b
}

// ════════════════════════════════════════════════════════════════════
// Block schedule generator (raw#65 idempotent)
//   block 0: REST 30s (jaw relaxed)
//   block 1: CLENCH 30s (teeth clench, 1 per second)
//   block 2: REST 30s
// ════════════════════════════════════════════════════════════════════

fn build_schedule() {
    g_block_count   = BLOCK_COUNT
    g_total_seconds = BLOCK_REST_S + BLOCK_CLENCH_S + BLOCK_REST_S
}

// Returns "REST" or "CLENCH" for block index i (0-based).
fn block_kind_at(i: int) -> string {
    if i == 1 { return "CLENCH" }
    return "REST"
}

// Returns block start time in seconds.
fn block_start_at(i: int) -> int {
    if i == 0 { return 0 }
    if i == 1 { return BLOCK_REST_S }
    return BLOCK_REST_S + BLOCK_CLENCH_S
}

// Returns block duration in seconds.
fn block_duration_at(i: int) -> int {
    if i == 1 { return BLOCK_CLENCH_S }
    return BLOCK_REST_S
}

// Returns audio cue text for block index i.
fn cue_text_at(i: int) -> string {
    if block_kind_at(i) == "CLENCH" {
        return "어금니 꽉 깨무세요 1초당 한 번 (Clench teeth, once per second)"
    }
    return "휴식, 턱 이완 (Rest, jaw relaxed)"
}

// ════════════════════════════════════════════════════════════════════
// Synthetic clench-train analysis
//   Pure-math synthetic rectified-RMS amplitudes per channel (no RNG):
//     Nominal CLENCH: 30 bursts @ 1 Hz, T7/T8 RMS ~800 µV during burst,
//                     T7/T8 RMS ~30 µV during rest (baseline EMG tone),
//                     O1/O2 RMS ~15 µV (EMG-immune occipital).
//   Caller specifies "perturb_*" flags to exercise falsifiers in tests.
// ════════════════════════════════════════════════════════════════════

let SYNTH_CLENCH_COUNT_NOMINAL = 30
let SYNTH_T_CLENCH_RMS_UV      = 800.0       // strong temporalis burst
let SYNTH_T_REST_RMS_UV        = 30.0        // jaw-relaxed baseline
let SYNTH_O_CLENCH_RMS_UV      = 15.0        // volume-conducted occipital
let SYNTH_O_REST_RMS_UV        = 10.0        // pure baseline at occipital
let SYNTH_T_PEAK_AMP_UV        = 1500.0      // peak amplitude (informational)
let SYNTH_ICI_NOMINAL_MS       = 1000        // 1 Hz → 1000 ms gap

fn analyze_synthetic(
    perturb_low_amp: bool,
    perturb_count_off: bool,
    perturb_low_ratio: bool,
    perturb_occipital_max: bool
) {
    let mut count    = SYNTH_CLENCH_COUNT_NOMINAL
    let mut t_clench = SYNTH_T_CLENCH_RMS_UV
    let mut t_rest   = SYNTH_T_REST_RMS_UV
    let mut o_clench = SYNTH_O_CLENCH_RMS_UV
    let mut o_rest   = SYNTH_O_REST_RMS_UV
    let mut t_peak   = SYNTH_T_PEAK_AMP_UV
    let mut ici      = SYNTH_ICI_NOMINAL_MS

    // F_JAW_01 perturbation: RMS below 300 µV threshold
    if perturb_low_amp {
        t_clench = 250.0   // sub-threshold weak clench
        t_peak   = 500.0
    }

    // F_JAW_02 perturbation: ratio below 5x (rest creep or weak clench)
    if perturb_low_ratio {
        t_rest = 250.0    // pushes ratio to ~3.2x
    }

    // count-off perturbation (sanity, not a frozen falsifier directly)
    if perturb_count_off {
        count = 8         // user did not clench intentionally
    }

    // F_JAW_03 perturbation: occipital RMS exceeds temporal
    if perturb_occipital_max {
        t_clench = 200.0
        o_clench = 400.0
    }

    g_clench_count           = count
    g_t7_clench_rms_uv       = t_clench
    g_t8_clench_rms_uv       = t_clench
    g_o1_clench_rms_uv       = o_clench
    g_o2_clench_rms_uv       = o_clench
    g_t_clench_rms_uv        = max_f(g_t7_clench_rms_uv, g_t8_clench_rms_uv)
    g_t_rest_rms_uv          = t_rest
    g_o_clench_rms_uv        = max_f(g_o1_clench_rms_uv, g_o2_clench_rms_uv)
    g_o_rest_rms_uv          = o_rest
    g_t_max_amp_uv           = t_peak
    g_clench_rest_ratio      = safe_div(g_t_clench_rms_uv, g_t_rest_rms_uv)
    g_min_iclench_interval_ms = ici
}

// ════════════════════════════════════════════════════════════════════
// Frozen falsifier evaluation (raw#71)
// ════════════════════════════════════════════════════════════════════

fn evaluate_falsifiers() {
    // F_JAW_01: T7/T8 CLENCH RMS amplitude > 300 µV
    g_f_jaw_01_pass = g_t_clench_rms_uv > CLENCH_RMS_PASS_UV

    // F_JAW_02: CLENCH/REST RMS ratio >= 5x
    g_f_jaw_02_pass = g_clench_rest_ratio >= CLENCH_REST_RATIO_PASS

    // F_JAW_03: T7/T8 CLENCH RMS > O1/O2 CLENCH RMS (temporal-dominant)
    g_f_jaw_03_pass = g_t_clench_rms_uv > g_o_clench_rms_uv
}

// ════════════════════════════════════════════════════════════════════
// Sentinel emit (raw#71 falsifier-bound)
//   __EEG_JAW_CLENCH__ <PASS|FAIL> <count> <max_amp_uv> <ratio>
// ════════════════════════════════════════════════════════════════════

fn emit_sentinel() {
    let mut verdict = "PASS"
    if !(g_f_jaw_01_pass && g_f_jaw_02_pass && g_f_jaw_03_pass) {
        verdict = "FAIL"
    }
    println("__EEG_JAW_CLENCH__ " + verdict + " " + to_string(g_clench_count) + " " + to_string(g_t_max_amp_uv) + " " + to_string(g_clench_rest_ratio))
}

// ════════════════════════════════════════════════════════════════════
// Audit JSONL emit (raw#65 idempotent in selftest mode)
// ════════════════════════════════════════════════════════════════════

fn _ensure_audit_dir() {
    let _rc = exec("mkdir -p " + AUDIT_DIR)
}

fn emit_audit(ts: string) {
    _ensure_audit_dir()
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    let mut row = "{"
    row = row + "\"schema\":\"" + SCHEMA + "\","
    row = row + "\"ts\":\"" + ts + "\","
    row = row + "\"block_count\":" + to_string(g_block_count) + ","
    row = row + "\"total_seconds\":" + to_string(g_total_seconds) + ","
    row = row + "\"clench_count\":" + to_string(g_clench_count) + ","
    row = row + "\"t7_clench_rms_uv\":" + to_string(g_t7_clench_rms_uv) + ","
    row = row + "\"t8_clench_rms_uv\":" + to_string(g_t8_clench_rms_uv) + ","
    row = row + "\"o1_clench_rms_uv\":" + to_string(g_o1_clench_rms_uv) + ","
    row = row + "\"o2_clench_rms_uv\":" + to_string(g_o2_clench_rms_uv) + ","
    row = row + "\"t_clench_rms_uv\":" + to_string(g_t_clench_rms_uv) + ","
    row = row + "\"t_rest_rms_uv\":" + to_string(g_t_rest_rms_uv) + ","
    row = row + "\"o_clench_rms_uv\":" + to_string(g_o_clench_rms_uv) + ","
    row = row + "\"o_rest_rms_uv\":" + to_string(g_o_rest_rms_uv) + ","
    row = row + "\"t_max_amp_uv\":" + to_string(g_t_max_amp_uv) + ","
    row = row + "\"clench_rest_ratio\":" + to_string(g_clench_rest_ratio) + ","
    row = row + "\"min_iclench_interval_ms\":" + to_string(g_min_iclench_interval_ms) + ","
    row = row + "\"f_jaw_01\":" + _bool_str(g_f_jaw_01_pass) + ","
    row = row + "\"f_jaw_02\":" + _bool_str(g_f_jaw_02_pass) + ","
    row = row + "\"f_jaw_03\":" + _bool_str(g_f_jaw_03_pass)
    row = row + "}"
    let nl = chr(10)
    let mut existing = ""
    let prior = read_file(path)
    if prior != "" { existing = prior }
    write_file(path, existing + row + nl)
}

// ════════════════════════════════════════════════════════════════════
// Live runner — collect.hexa subprocess delegation
//   raw#10 honest: this protocol does NOT do raw BrainFlow ingest itself;
//   it delegates to anima-eeg/collect.hexa and post-analyzes the .npy.
//   --run prints the audio cue schedule and the collect command;
//   user runs in a separate terminal / hooks audio. raw#15: no personal
//   paths hardcoded (all CLI args).
// ════════════════════════════════════════════════════════════════════

fn print_run_plan(port: string, board: string, output: string) {
    build_schedule()
    println("── jaw_clench_emg live run plan ──")
    println("schema=" + SCHEMA)
    println("port=" + port)
    println("board=" + board)
    println("output=" + output)
    println("sample_rate_hz=" + to_string(SAMPLE_RATE_HZ))
    println("channel_count=" + to_string(CHANNEL_COUNT))
    println("notch_hz=" + to_string(NOTCH_HZ))
    println("bandpass=" + to_string(BANDPASS_LO_HZ) + "-" + to_string(BANDPASS_HI_HZ) + " Hz, order=" + to_string(BANDPASS_ORDER))
    println("clench_rms_window_ms=" + to_string(CLENCH_RMS_WINDOW_MS))
    println("clench_threshold_uv=" + to_string(CLENCH_THRESHOLD_UV))
    println("clench_refractory_ms=" + to_string(CLENCH_INTERVAL_MIN_MS))
    println("total_seconds=" + to_string(g_total_seconds))
    println("")
    println("[block schedule — REST / CLENCH / REST]")
    let mut i = 0
    while i < g_block_count {
        let t0 = block_start_at(i)
        let dur = block_duration_at(i)
        let kind = block_kind_at(i)
        let cue = cue_text_at(i)
        println("  t=" + to_string(t0) + "s  block#" + to_string(i + 1) + "  " + kind + "  dur=" + to_string(dur) + "s  cue=\"" + cue + "\"")
        i = i + 1
    }
    println("")
    println("[user hand-step — montage assumption (Cyton+Daisy 16ch)]")
    println("  Daisy N5P (ch13) -> T7 (left temporal, above ear, temporalis muscle)")
    println("  Daisy N6P (ch14) -> T8 (right temporal, above ear, masseter pickup)")
    println("  Cyton N7P (ch7)  -> O1  (1\" above inion, 1\" left)")
    println("  Cyton N8P (ch8)  -> O2  (1\" above inion, 1\" right)")
    println("  SRB2             -> A1 earlobe (white wire)")
    println("  BIAS             -> A2 earlobe (black wire)")
    println("")
    println("[delegate command — run in separate terminal]")
    println("  hexa run anima-eeg/collect.hexa --port " + port + " \\")
    println("      --board " + board + " --duration " + to_string(g_total_seconds) + " \\")
    println("      --output " + output)
    println("")
    println("[audio cues — follow on speaker / TTS at t=0,30,60]")
    println("  t=0s   → \"휴식, 턱 이완 (Rest, jaw relaxed)\"")
    println("  t=30s  → \"어금니 꽉 깨무세요 1초당 한 번 (Clench teeth, once per second)\"")
    println("  t=60s  → \"휴식, 턱 이완 (Rest, jaw relaxed)\"")
    println("")
    println("[honest C3 caveat]")
    println("  raw#10: this is EMG (muscle electrography), NOT EEG (cortical).")
    println("  T7/T8 picks up temporalis/masseter muscle contraction directly;")
    println("  EEG purists treat this as artifact — here it IS the signal.")
}

// ════════════════════════════════════════════════════════════════════
// Tests (selftest)
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn run_tests() -> int {
    let mut pass = 0
    let mut fail = 0

    println("=== jaw_clench_emg selftest ===")

    // T1: schedule build (3 blocks, 90 s)
    println("[T1] schedule build")
    build_schedule()
    let ok1a = assert_true(g_block_count == 3, "block_count == 3")
    let ok1b = assert_true(g_total_seconds == TOTAL_DURATION_S, "total seconds == 90")
    if ok1a && ok1b { pass = pass + 1 } else { fail = fail + 1 }

    // T2: REST/CLENCH/REST ordering
    println("[T2] REST → CLENCH → REST ordering")
    let ok2a = assert_true(block_kind_at(0) == "REST", "block 0 = REST")
    let ok2b = assert_true(block_kind_at(1) == "CLENCH", "block 1 = CLENCH")
    let ok2c = assert_true(block_kind_at(2) == "REST", "block 2 = REST")
    let ok2d = assert_true(block_start_at(1) == 30, "CLENCH starts at t=30s")
    let ok2e = assert_true(block_start_at(2) == 60, "second REST at t=60s")
    if ok2a && ok2b && ok2c && ok2d && ok2e { pass = pass + 1 } else { fail = fail + 1 }

    // T3: idempotent rebuild (raw#65)
    println("[T3] idempotent schedule rebuild")
    build_schedule()
    let bc1 = g_block_count
    build_schedule()
    let ok3 = assert_true(g_block_count == bc1, "block count idempotent")
    if ok3 { pass = pass + 1 } else { fail = fail + 1 }

    // T4: nominal synthetic — all 3 falsifiers PASS
    println("[T4] synthetic nominal — F_JAW_01/02/03 PASS")
    analyze_synthetic(false, false, false, false)
    evaluate_falsifiers()
    let ok4a = assert_true(g_f_jaw_01_pass, "F_JAW_01 T RMS > 300 µV")
    let ok4b = assert_true(g_f_jaw_02_pass, "F_JAW_02 ratio >= 5x")
    let ok4c = assert_true(g_f_jaw_03_pass, "F_JAW_03 T > O")
    let ok4d = assert_true(g_clench_count == 30, "clench count = 30")
    let ok4e = assert_true(g_t_clench_rms_uv > 300.0, "T clench RMS = " + to_string(g_t_clench_rms_uv))
    let ok4f = assert_true(g_clench_rest_ratio >= 5.0, "ratio = " + to_string(g_clench_rest_ratio))
    if ok4a && ok4b && ok4c && ok4d && ok4e && ok4f { pass = pass + 1 } else { fail = fail + 1 }

    // T5: F_JAW_01 falsifier — RMS below threshold
    println("[T5] F_JAW_01 falsifier — T RMS = 250 µV (sub-threshold)")
    analyze_synthetic(true, false, false, false)
    evaluate_falsifiers()
    let ok5a = assert_true(!g_f_jaw_01_pass, "F_JAW_01 fails")
    let ok5b = assert_true(g_f_jaw_03_pass, "F_JAW_03 still passes (T > O)")
    if ok5a && ok5b { pass = pass + 1 } else { fail = fail + 1 }

    // T6: F_JAW_02 falsifier — ratio below 5x
    println("[T6] F_JAW_02 falsifier — ratio < 5x (rest creep)")
    analyze_synthetic(false, false, true, false)
    evaluate_falsifiers()
    let ok6a = assert_true(g_f_jaw_01_pass, "F_JAW_01 still passes")
    let ok6b = assert_true(!g_f_jaw_02_pass, "F_JAW_02 fails (ratio < 5)")
    let ok6c = assert_true(g_f_jaw_03_pass, "F_JAW_03 still passes")
    if ok6a && ok6b && ok6c { pass = pass + 1 } else { fail = fail + 1 }

    // T7: F_JAW_03 falsifier — occipital max
    println("[T7] F_JAW_03 falsifier — O > T (occipital max)")
    analyze_synthetic(false, false, false, true)
    evaluate_falsifiers()
    let ok7a = assert_true(!g_f_jaw_03_pass, "F_JAW_03 fails (occipital max)")
    if ok7a { pass = pass + 1 } else { fail = fail + 1 }

    // T8: cue text mapping
    println("[T8] audio cue text")
    let cue_rest = cue_text_at(0)
    let cue_clench = cue_text_at(1)
    let ok8a = assert_true(cue_rest == "휴식, 턱 이완 (Rest, jaw relaxed)", "REST cue text")
    let ok8b = assert_true(cue_clench == "어금니 꽉 깨무세요 1초당 한 번 (Clench teeth, once per second)", "CLENCH cue text")
    if ok8a && ok8b { pass = pass + 1 } else { fail = fail + 1 }

    // T9: detection thresholds frozen
    println("[T9] detection thresholds frozen")
    let ok9a = assert_true(CLENCH_THRESHOLD_UV == 200.0, "event threshold = 200 µV")
    let ok9b = assert_true(CLENCH_RMS_PASS_UV == 300.0, "F_JAW_01 cutoff = 300 µV")
    let ok9c = assert_true(CLENCH_REST_RATIO_PASS == 5.0, "F_JAW_02 ratio = 5x")
    let ok9d = assert_true(CLENCH_INTERVAL_MIN_MS == 500, "refractory = 500 ms")
    let ok9e = assert_true(BANDPASS_LO_HZ == 20.0, "BP lo = 20 Hz (EMG band)")
    let ok9f = assert_true(BANDPASS_HI_HZ == 200.0, "BP hi = 200 Hz (EMG band)")
    if ok9a && ok9b && ok9c && ok9d && ok9e && ok9f { pass = pass + 1 } else { fail = fail + 1 }

    // T10: audit JSONL emit (raw#65 byte-stable)
    println("[T10] audit JSONL emit deterministic")
    build_schedule()
    analyze_synthetic(false, false, false, false)
    evaluate_falsifiers()
    let ts = "selftest_synth"
    let path = AUDIT_DIR + "/" + ts + "_session.jsonl"
    write_file(path, "")
    emit_audit(ts)
    let body1 = read_file(path)
    write_file(path, "")
    emit_audit(ts)
    let body2 = read_file(path)
    let ok10a = assert_true(body1 == body2, "audit row byte-stable")
    let ok10b = assert_true(len(body1) > 0, "audit row non-empty")
    if ok10a && ok10b { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail) + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// CLI entry
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    println("usage:")
    println("  hexa run anima-eeg/protocols/jaw_clench_emg.hexa --selftest")
    println("  hexa run anima-eeg/protocols/jaw_clench_emg.hexa --run \\")
    println("      --port <serial> --board <cyton_daisy> --output <npy>")
}

fn _arg_value(av: list, key: string, dflt: string) -> string {
    let mut i = 1
    while i < len(av) {
        if av[i] == key && i + 1 < len(av) {
            return av[i + 1]
        }
        i = i + 1
    }
    return dflt
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut run = false
    let mut i = 1
    while i < len(av) {
        if av[i] == "--selftest" { selftest = true }
        if av[i] == "--run"      { run = true }
        if av[i] == "--help"     { _print_usage(); exit(0) }
        i = i + 1
    }

    if run {
        let port   = _arg_value(av, "--port",   "")
        let board  = _arg_value(av, "--board",  "cyton_daisy")
        let output = _arg_value(av, "--output", "")
        if len(port) == 0 || len(output) == 0 {
            eprintln("ABORT: --run requires --port and --output (raw#15 no personal paths)")
            _print_usage()
            exit(2)
        }
        print_run_plan(port, board, output)
        // raw#10 honest: this cycle prints plan + audio cue schedule;
        // the actual collect.hexa subprocess + audio TTS hook is the
        // user hand-step. Plan is logged; user executes in separate
        // terminal and reports back the .npy for analyze pass.
        exit(0)
    }

    if !selftest {
        _print_usage()
        exit(2)
    }

    println("── jaw_clench_emg selftest ──")
    println("schema=" + SCHEMA)
    println("raw10_honest=synthetic_clench_train_no_real_brainflow_no_audio_terminal_only")
    println("raw10_emg_not_eeg=temporalis_masseter_muscle_artifact_at_temporal_electrodes")
    println("raw82_darwin=clock_gettime_monotonic_via_collect_hexa")
    println("paradigm=highest_confidence_emg_easy_pass_succeeding_eye_blink_detect")
    println("")

    // Demonstration (synthetic nominal session: 30 bursts @ 1 Hz, 800 µV RMS)
    build_schedule()
    analyze_synthetic(false, false, false, false)
    evaluate_falsifiers()

    println("[demo nominal session]")
    println("block_count="              + to_string(g_block_count))
    println("total_seconds="            + to_string(g_total_seconds))
    println("clench_count="             + to_string(g_clench_count))
    println("t7_clench_rms_uv="         + to_string(g_t7_clench_rms_uv))
    println("t8_clench_rms_uv="         + to_string(g_t8_clench_rms_uv))
    println("o1_clench_rms_uv="         + to_string(g_o1_clench_rms_uv))
    println("o2_clench_rms_uv="         + to_string(g_o2_clench_rms_uv))
    println("t_clench_rms_uv="          + to_string(g_t_clench_rms_uv))
    println("t_rest_rms_uv="            + to_string(g_t_rest_rms_uv))
    println("o_clench_rms_uv="          + to_string(g_o_clench_rms_uv))
    println("o_rest_rms_uv="            + to_string(g_o_rest_rms_uv))
    println("t_max_amp_uv="             + to_string(g_t_max_amp_uv))
    println("clench_rest_ratio="        + to_string(g_clench_rest_ratio))
    println("min_iclench_interval_ms="  + to_string(g_min_iclench_interval_ms))
    println("f_jaw_01="                 + _bool_str(g_f_jaw_01_pass))
    println("f_jaw_02="                 + _bool_str(g_f_jaw_02_pass))
    println("f_jaw_03="                 + _bool_str(g_f_jaw_03_pass))
    println("")

    emit_sentinel()
    emit_audit("selftest_synth")

    let fails = run_tests()
    if fails != 0 {
        println("selftest=fail")
        eprintln("selftest FAILED: " + to_string(fails) + " test(s) failed")
        exit(1)
    }
    println("selftest=ok")
    println("DONE")
}
