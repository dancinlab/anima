// anima-eeg/eeg_setup.hexa
// raw#9 hexa-only · raw#10 honest · raw#11 snake_case · raw#12 silent-error-ban
// raw#65 idempotent · raw#82 darwin-native · raw#91 honesty-triad · raw#101 minimal
// raw#155 hxc-consumer-adapter-mandate (canonical entry; consumers go through this)
//
// PURPOSE
//   Single canonical entry point that dispatches to anima-eeg helpers.
//   raw#0 root-ssot pattern at module level — one shim, six backends.
//
// USAGE
//   hexa run anima-eeg/eeg_setup.hexa <subcommand> [flags]
//
//   Subcommands:
//     health             → board_health_check.hexa       (no-helmet hardware sanity)
//     impedance          → impedance_check.hexa          (z<CH><PCHAN><NCHAN>Z 5-state)
//     impedance_validate → impedance_real_hardware_validation.hexa (worn-helmet evidence)
//     headplot           → headplot_helper.hexa          (ASCII 10-20 head plot)
//     adjust             → electrode_adjustment_helper.hexa (live single-channel touch)
//     rich               → electrode_helper_rich.hexa    (Rich TUI variant)
//     full               → full_helmet_view.hexa         (16ch concurrent 5-state)
//     record             → eeg_recorder.hexa             (segmented .npy task recording)
//     list               → enumerate available subcommands + their files
//     selftest           → run --selftest on every backend, summarize PASS/FAIL
//
//   Pass-through flags after subcommand are forwarded verbatim to backend.
//   Example:
//     hexa run anima-eeg/eeg_setup.hexa health --selftest
//     hexa run anima-eeg/eeg_setup.hexa impedance --check --port /dev/cu.usbserial-DM01N7AM
//     hexa run anima-eeg/eeg_setup.hexa full --selftest --fps 60
//
//  @resolver-bypass(reason="darwin-native: backends require host USB + .venv-eeg.
//                   hetzner / linux pods do not expose host hardware. eeg_setup is
//                   pure dispatch — no compute, but routing must stay on mac.")

let SCHEMA = "anima-eeg/eeg_setup/1"

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _backend_for(sub: string) -> string {
    if sub == "health"             { return "anima-eeg/board_health_check.hexa" }
    if sub == "impedance"          { return "anima-eeg/impedance_check.hexa" }
    if sub == "impedance_validate" { return "anima-eeg/impedance_real_hardware_validation.hexa" }
    if sub == "headplot"           { return "anima-eeg/headplot_helper.hexa" }
    if sub == "adjust"             { return "anima-eeg/electrode_adjustment_helper.hexa" }
    if sub == "rich"               { return "anima-eeg/electrode_helper_rich.hexa" }
    if sub == "full"               { return "anima-eeg/full_helmet_view.hexa" }
    if sub == "record"             { return "anima-eeg/eeg_recorder.hexa" }
    return ""
}

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/eeg_setup.hexa <subcommand> [flags]")
    eprintln("")
    eprintln("subcommands:")
    eprintln("  health              board_health_check                 no-helmet hardware sanity")
    eprintln("  impedance           impedance_check                    z<CH><PCHAN><NCHAN>Z 5-state")
    eprintln("  impedance_validate  impedance_real_hardware_validation real-helmet 5-state + JSONL evidence")
    eprintln("  headplot            headplot_helper                    ASCII 10-20 head plot")
    eprintln("  adjust              electrode_adjustment               live single-channel touch")
    eprintln("  rich                electrode_helper_rich              Rich TUI variant")
    eprintln("  full                full_helmet_view                   16ch concurrent 5-state")
    eprintln("  record              eeg_recorder                       segmented .npy task recording")
    eprintln("  list                enumerate subcommands + backends")
    eprintln("  selftest            run --selftest on every backend")
    eprintln("")
    eprintln("flags after subcommand are forwarded to the backend.")
    eprintln("examples:")
    eprintln("  hexa run anima-eeg/eeg_setup.hexa health --selftest")
    eprintln("  hexa run anima-eeg/eeg_setup.hexa full --check --fps 60")
}

fn _print_list() {
    println("── eeg_setup available backends ──")
    println("schema: " + SCHEMA)
    let subs = ["health", "impedance", "impedance_validate", "headplot", "adjust", "rich", "full", "record"]
    let mut i = 0
    while i < len(subs) {
        let s = subs[i]
        let b = _backend_for(s)
        println(s + " → " + b)
        i = i + 1
    }
    println("──")
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path {
            if a.ends_with("/exe") { is_path = true }
        }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

// Streaming dispatcher: exec_stream forwards backend stdout line-by-line
// to the user terminal AS IT ARRIVES (no buffering) and returns the int
// exit code. exec() (without _stream/_with_status) returns CAPTURED stdout
// as a string — wrong for an interactive helper dispatcher because the
// user sees nothing until the backend exits.
fn _stream_line(line: string) {
    // Backend lines already include a trailing newline from fgets() in the
    // runtime. Use print() (no newline) to avoid double-spacing.
    print(line)
}

fn _run_backend_stream(backend: string, fwd_args: array) -> int {
    let mut cmd = "hexa run " + backend
    let mut i = 0
    while i < len(fwd_args) {
        cmd = cmd + " " + _sh_quote(fwd_args[i])
        i = i + 1
    }
    eprintln("[GATE] dispatch=local backend=" + backend)
    eprintln("[GATE] cmd=" + cmd)
    let rc = exec_stream(cmd, _stream_line)
    return rc
}

fn _run_selftest_all() -> int {
    println("── eeg_setup selftest dispatcher ──")
    println("schema: " + SCHEMA)
    let subs = ["health", "impedance", "impedance_validate", "headplot", "adjust", "rich", "full", "record"]
    let mut pass = 0
    let mut fail = 0
    let mut details = []
    let st_args = ["--selftest"]
    let mut i = 0
    while i < len(subs) {
        let s = subs[i]
        let b = _backend_for(s)
        println("")
        println("[run] " + s + " → " + b + " --selftest")
        let rc = _run_backend_stream(b, st_args)
        if rc == 0 {
            pass = pass + 1
            details.push(s + ": PASS")
        } else {
            fail = fail + 1
            details.push(s + ": FAIL rc=" + str(rc))
        }
        i = i + 1
    }
    println("")
    println("── selftest summary ──")
    let mut k = 0
    while k < len(details) {
        println("  " + details[k])
        k = k + 1
    }
    println("pass: " + str(pass) + "  fail: " + str(fail) + "  total: " + str(len(subs)))
    if fail == 0 {
        println("verdict: ALL_BACKENDS_SELFTEST_PASS ✓")
        return 0
    }
    println("verdict: SOME_BACKENDS_SELFTEST_FAIL ✗")
    return 1
}

fn main() {
    let av = _flags_only_argv()

    if len(av) == 0 {
        _emit_trailer(
            "missing-subcommand",
            "no subcommand provided",
            "1) hexa run anima-eeg/eeg_setup.hexa list  2) --help"
        )
        _print_usage()
        exit(2)
    }

    let sub = av[0]

    if sub == "--help" || sub == "-h" || sub == "help" {
        _print_usage()
        exit(0)
    }

    if sub == "list" {
        _print_list()
        exit(0)
    }

    if sub == "selftest" {
        let rc = _run_selftest_all()
        exit(rc)
    }

    let backend = _backend_for(sub)
    if backend == "" {
        _emit_trailer(
            "unknown-subcommand",
            "unrecognized subcommand: " + sub,
            "1) hexa run anima-eeg/eeg_setup.hexa list  2) --help"
        )
        _print_usage()
        exit(2)
    }

    // Forward remaining args after the subcommand verbatim to the backend.
    let mut fwd_args = []
    let mut i = 1
    while i < len(av) {
        fwd_args.push(av[i])
        i = i + 1
    }

    let rc = _run_backend_stream(backend, fwd_args)

    println("──")
    println("schema: " + SCHEMA)
    println("subcommand: " + sub)
    println("backend: " + backend)
    println("exit_code: " + str(rc))
    if rc == 0 {
        println("verdict: BACKEND_PASS ✓")
    } else {
        println("verdict: BACKEND_FAIL ✗ rc=" + str(rc))
    }
    exit(rc)
}
