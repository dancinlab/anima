// anima-eeg/core/quality_ledger.hexa
// raw#9 hexa-only · raw#10 honest C3 · raw#11 snake_case · raw#15 SSOT
// raw#37 transient-helper-in-/tmp · raw#65 idempotent · raw#71 falsifier-bound
// raw#80 sentinel · raw#82 darwin-native
//
// PURPOSE
//   Cycle 2 deliverable for the AI Quality Monitoring System
//   (see anima-eeg/docs/ai-native/quality_monitoring_system_plan_2026_05_03.ai.md
//   §3 module #2). Append-only JSONL time-series ledger that stores
//   per-measurement quality_audit rows and exposes a small query API
//   used by quality_advisor (cycle 3) + quality_dashboard (cycle 4).
//
//   Storage layout (monthly rotation):
//     anima-eeg/state/quality_ledger/<YYYY-MM>.jsonl
//
//   Each row is a single-line JSON object emitted by quality_audit. The
//   ledger is the SSOT for ledger reads; advisor + dashboard MUST go
//   through this module's query API rather than reading the JSONL files
//   directly (so future schema migration / cross-month merge / index
//   builds happen in one place).
//
// API (CLI surface — invoked by quality_audit BG and by humans)
//   --append --row '<json>'        single row append (or stdin pipe)
//   --append --row-stdin           read JSON object from stdin
//   --get-recent <N>               most recent N rows (cross-month walk)
//   --get-by-paradigm <name>       filter rows where paradigm == <name>
//   --get-trend <metric>           emit (ts, value) pairs for one metric
//   --query <expr>                 ad-hoc filter, expr = "key op value"
//                                  ops: == != >= <= > <
//   --selftest                     synthetic mode (F_LEDGER_01/02)
//
// SCOPE BOUNDARY (raw#15)
//   This module ONLY writes:
//     anima-eeg/core/quality_ledger.hexa                     (this file)
//     anima-eeg/state/quality_ledger/<YYYY-MM>.jsonl         (auto-create)
//     anima-eeg/state/quality_ledger/                        (auto-create)
//   It does NOT modify quality_audit.hexa, quality_advisor.hexa,
//   quality_dashboard.hexa, or any anima-eeg core .hexa file.
//   Other concurrent BGs (quality_audit, paradigm specs, runbook docs)
//   are agentId-disjoint by file scope.
//
// FALSIFIERS (raw#71 frozen)
//   F_LEDGER_01: append → re-read round-trip identical
//                 (one synthetic row appended; get-recent 1 must return
//                  byte-exact same JSON object — keys + values).
//   F_LEDGER_02: get-recent N returns exactly N rows
//                 (5 synthetic rows appended; get-recent 3 returns 3 rows
//                  in reverse-chronological order; get-recent 5 returns 5;
//                  get-recent 10 returns 5 (cap at available)).
//
// raw#10 honest C3 caveats
//   1. flock() on macOS is best-effort — Apple's HFS+/APFS implements
//      advisory locking via fcntl(F_SETLK), but the standard caveat
//      applies: another process must ALSO call flock() to honor the
//      lock; raw open(..., 'a') writes from a non-cooperating process
//      will interleave bytes. We rely on the convention that all
//      writers route through this module. NFS / cross-host locking is
//      explicitly out of scope (single-host darwin-native only).
//   2. Monthly file rotation uses datetime.utcnow().strftime('%Y-%m');
//      timezone is hard-pinned to UTC in the helper. If a row's ts field
//      is in a different zone, the row may land in a different month
//      file than the wall-clock month implied by its ts string. We
//      route purely on UTC-now of the append call, NOT on row.ts. This
//      is documented; consumers parsing across the boundary must either
//      trust UTC-now (preferred) or load both N and N-1 files.
//   3. JSONL load grows O(N) with file size; a single month with high
//      N=1000 sessions may be ~5-10 MB which python json.loads + scan
//      handles in <1s. Beyond ~10 MB per file (rare for N=1 self-
//      experiment), query latency degrades; future cycle (5+) MAY add
//      a sqlite index but for cycle 2 the JSONL flat-file is SSOT and
//      simplest auditable surface.
//
// USAGE
//   hexa run anima-eeg/core/quality_ledger.hexa --selftest
//   hexa run anima-eeg/core/quality_ledger.hexa --append --row '{"ts":"...","session_id":"...","paradigm":"blink"}'
//   echo '{"ts":"...","session_id":"...","paradigm":"blink"}' | \
//     hexa run anima-eeg/core/quality_ledger.hexa --append --row-stdin
//   hexa run anima-eeg/core/quality_ledger.hexa --get-recent 10
//   hexa run anima-eeg/core/quality_ledger.hexa --get-by-paradigm blink
//   hexa run anima-eeg/core/quality_ledger.hexa --get-trend effective_fs_hz
//   hexa run anima-eeg/core/quality_ledger.hexa --query 'sample_drop_pct > 30'
//
//  @resolver-bypass(reason="darwin-native: writes anima-eeg/state/quality_ledger
//                   on the local filesystem; uses fcntl.flock advisory locks
//                   that are macOS-cooperative. Linux pods do not own the
//                   ledger SSOT (which lives next to live measurements). The
//                   --selftest path is pure synthetic and runs anywhere, but
//                   real append/query operate on the local repo state dir.")

let SCHEMA              = "anima-eeg/core/quality_ledger/1"
let HELPER_PATH         = "/tmp/anima_eeg_quality_ledger_helper.hexa_tmp"
let LEDGER_DIR          = "anima-eeg/state/quality_ledger"

// ════════════════════════════════════════════════════════════════════
// Section 0. Hexa-side helpers
// ════════════════════════════════════════════════════════════════════

fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _emit_trailer(reason_slug: string, reason_detail: string, fix: string) {
    eprintln("reason: " + reason_slug + ": " + reason_detail)
    eprintln("fix: " + fix)
}

fn _kv_lookup(body: string, key: string) -> string {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

// ════════════════════════════════════════════════════════════════════
// Section 1. Helper python emitter (raw#37 transient, /tmp only)
// ════════════════════════════════════════════════════════════════════

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# anima-eeg/core/quality_ledger.hexa transient helper\n")
    parts.push("# raw#37: emitted to /tmp, NOT git-tracked.\n")
    parts.push("import argparse, fcntl, glob, json, os, sys\n")
    parts.push("from datetime import datetime, timezone\n\n")

    parts.push("LEDGER_DIR = '" + LEDGER_DIR + "'\n")
    parts.push("SCHEMA     = '" + SCHEMA + "'\n\n")

    parts.push("def emit_trailer(slug, detail, fix):\n")
    parts.push("    sys.stderr.write(f'reason: {slug}: {detail}\\n')\n")
    parts.push("    sys.stderr.write(f'fix: {fix}\\n')\n\n")

    // ─── Path / month resolution ────────────────────────────────────
    parts.push("def _ensure_dir():\n")
    parts.push("    os.makedirs(LEDGER_DIR, exist_ok=True)\n\n")

    parts.push("def _month_path(now=None):\n")
    parts.push("    # raw#10 honest C3 (caveat 2): UTC-now month, NOT row.ts month.\n")
    parts.push("    if now is None: now = datetime.now(timezone.utc)\n")
    parts.push("    return os.path.join(LEDGER_DIR, now.strftime('%Y-%m') + '.jsonl')\n\n")

    parts.push("def _list_month_files():\n")
    parts.push("    if not os.path.isdir(LEDGER_DIR): return []\n")
    parts.push("    fs = sorted(glob.glob(os.path.join(LEDGER_DIR, '*.jsonl')))\n")
    parts.push("    return fs\n\n")

    // ─── Append (with flock + schema validate) ──────────────────────
    parts.push("MANDATORY_KEYS = ('ts', 'session_id', 'paradigm')\n\n")

    parts.push("def _validate_row(row):\n")
    parts.push("    if not isinstance(row, dict): return (False, 'row-not-object')\n")
    parts.push("    for k in MANDATORY_KEYS:\n")
    parts.push("        if k not in row: return (False, f'missing-key:{k}')\n")
    parts.push("        if not isinstance(row[k], str) or not row[k].strip():\n")
    parts.push("            return (False, f'empty-or-non-string:{k}')\n")
    parts.push("    return (True, '')\n\n")

    parts.push("def cmd_append(args):\n")
    parts.push("    if args.row_stdin:\n")
    parts.push("        raw = sys.stdin.read()\n")
    parts.push("    else:\n")
    parts.push("        raw = args.row or ''\n")
    parts.push("    raw = raw.strip()\n")
    parts.push("    if not raw:\n")
    parts.push("        emit_trailer('append-empty-row', 'no JSON object given',\n")
    parts.push("                     '1) --row \\'{\\\"ts\\\":...}\\'  2) --row-stdin via pipe')\n")
    parts.push("        print('append=fail'); sys.exit(2)\n")
    parts.push("    try:\n")
    parts.push("        row = json.loads(raw)\n")
    parts.push("    except Exception as exc:\n")
    parts.push("        emit_trailer('append-parse-failed', repr(exc)[:200],\n")
    parts.push("                     '1) verify JSON well-formed (single-line preferred)')\n")
    parts.push("        print('append=fail'); sys.exit(2)\n")
    parts.push("    ok, why = _validate_row(row)\n")
    parts.push("    if not ok:\n")
    parts.push("        emit_trailer('append-schema-fail', why,\n")
    parts.push("                     '1) row needs ts + session_id + paradigm fields (non-empty strings)')\n")
    parts.push("        print('append=fail'); sys.exit(2)\n")
    parts.push("    _ensure_dir()\n")
    parts.push("    path = _month_path()\n")
    parts.push("    line = json.dumps(row, ensure_ascii=False, separators=(',', ':')) + '\\n'\n")
    parts.push("    # raw#10 honest C3 (caveat 1): flock advisory; cooperative writers only.\n")
    parts.push("    with open(path, 'a', encoding='utf-8') as f:\n")
    parts.push("        try:\n")
    parts.push("            fcntl.flock(f.fileno(), fcntl.LOCK_EX)\n")
    parts.push("        except Exception as exc:\n")
    parts.push("            sys.stderr.write(f'flock-warn: {exc!r}\\n')\n")
    parts.push("        f.write(line)\n")
    parts.push("        f.flush()\n")
    parts.push("        try: fcntl.flock(f.fileno(), fcntl.LOCK_UN)\n")
    parts.push("        except Exception: pass\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print(f'append=ok')\n")
    parts.push("    print(f'path={path}')\n")
    parts.push("    print(f'session_id={row[\"session_id\"]}')\n")
    parts.push("    print(f'paradigm={row[\"paradigm\"]}')\n")
    parts.push("    print(f'ts={row[\"ts\"]}')\n")
    parts.push("    # raw#80 sentinel\n")
    parts.push("    print('__EEG_QUALITY_LEDGER__ APPEND ok 1')\n\n")

    // ─── Load all rows (cross-month, chronological) ─────────────────
    parts.push("def _load_all_rows():\n")
    parts.push("    rows = []\n")
    parts.push("    for fp in _list_month_files():\n")
    parts.push("        try:\n")
    parts.push("            with open(fp, 'r', encoding='utf-8') as f:\n")
    parts.push("                for ln in f:\n")
    parts.push("                    ln = ln.strip()\n")
    parts.push("                    if not ln: continue\n")
    parts.push("                    try:\n")
    parts.push("                        rows.append(json.loads(ln))\n")
    parts.push("                    except Exception:\n")
    parts.push("                        # raw#12 silent-error-ban: surface but don't crash on corrupt line\n")
    parts.push("                        sys.stderr.write(f'corrupt-line-skipped: {fp}\\n')\n")
    parts.push("        except Exception as exc:\n")
    parts.push("            sys.stderr.write(f'load-warn: {fp}: {exc!r}\\n')\n")
    parts.push("    return rows\n\n")

    // ─── get-recent ─────────────────────────────────────────────────
    parts.push("def cmd_get_recent(args):\n")
    parts.push("    n = int(args.n)\n")
    parts.push("    if n <= 0:\n")
    parts.push("        emit_trailer('get-recent-bad-n', f'N={n}',\n")
    parts.push("                     '1) --get-recent <positive int>')\n")
    parts.push("        print('get_recent=fail'); sys.exit(2)\n")
    parts.push("    rows = _load_all_rows()\n")
    parts.push("    # Reverse-chronological by file order (later month files come last\n")
    parts.push("    # in sorted glob; within a file, later rows are appended last). We\n")
    parts.push("    # take the last n rows, then reverse so the most recent is first.\n")
    parts.push("    tail = rows[-n:] if len(rows) >= n else rows[:]\n")
    parts.push("    tail = list(reversed(tail))\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print(f'requested={n}')\n")
    parts.push("    print(f'returned={len(tail)}')\n")
    parts.push("    print(f'available={len(rows)}')\n")
    parts.push("    out = json.dumps(tail, ensure_ascii=False)\n")
    parts.push("    print(f'rows_json={out}')\n")
    parts.push("    print('get_recent=ok')\n")
    parts.push("    print(f'__EEG_QUALITY_LEDGER__ QUERY ok {len(tail)}')\n\n")

    // ─── get-by-paradigm ────────────────────────────────────────────
    parts.push("def cmd_get_by_paradigm(args):\n")
    parts.push("    paradigm = args.paradigm\n")
    parts.push("    rows = _load_all_rows()\n")
    parts.push("    matched = [r for r in rows if r.get('paradigm') == paradigm]\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print(f'paradigm={paradigm}')\n")
    parts.push("    print(f'matched={len(matched)}')\n")
    parts.push("    print(f'available={len(rows)}')\n")
    parts.push("    out = json.dumps(matched, ensure_ascii=False)\n")
    parts.push("    print(f'rows_json={out}')\n")
    parts.push("    print('get_by_paradigm=ok')\n")
    parts.push("    print(f'__EEG_QUALITY_LEDGER__ QUERY ok {len(matched)}')\n\n")

    // ─── get-trend ──────────────────────────────────────────────────
    parts.push("def cmd_get_trend(args):\n")
    parts.push("    metric = args.metric\n")
    parts.push("    rows = _load_all_rows()\n")
    parts.push("    points = []\n")
    parts.push("    for r in rows:\n")
    parts.push("        if metric in r and 'ts' in r:\n")
    parts.push("            v = r[metric]\n")
    parts.push("            # Only numeric metrics make sense for trend; coerce or skip.\n")
    parts.push("            if isinstance(v, (int, float)):\n")
    parts.push("                points.append([r['ts'], v])\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print(f'metric={metric}')\n")
    parts.push("    print(f'point_count={len(points)}')\n")
    parts.push("    out = json.dumps(points, ensure_ascii=False)\n")
    parts.push("    print(f'trend_json={out}')\n")
    parts.push("    print('get_trend=ok')\n")
    parts.push("    print(f'__EEG_QUALITY_LEDGER__ QUERY ok {len(points)}')\n\n")

    // ─── ad-hoc query (key op value) ────────────────────────────────
    parts.push("def _parse_query(expr):\n")
    parts.push("    expr = (expr or '').strip()\n")
    parts.push("    if not expr: return (None, None, None, 'empty-expr')\n")
    parts.push("    # Try multi-char ops first (>= <= == !=) then single (> < =).\n")
    parts.push("    for op in ('>=', '<=', '==', '!=', '>', '<', '='):\n")
    parts.push("        idx = expr.find(op)\n")
    parts.push("        if idx > 0:\n")
    parts.push("            key = expr[:idx].strip()\n")
    parts.push("            val = expr[idx + len(op):].strip()\n")
    parts.push("            # Strip optional surrounding quotes on val.\n")
    parts.push("            if len(val) >= 2 and val[0] == val[-1] and val[0] in ('\"', \"'\"):\n")
    parts.push("                val = val[1:-1]\n")
    parts.push("            real_op = '==' if op == '=' else op\n")
    parts.push("            return (key, real_op, val, '')\n")
    parts.push("    return (None, None, None, 'no-op-found')\n\n")

    parts.push("def _row_match(row, key, op, val):\n")
    parts.push("    if key not in row: return False\n")
    parts.push("    rv = row[key]\n")
    parts.push("    # Numeric coerce when val parses as number.\n")
    parts.push("    is_num = False\n")
    parts.push("    try:\n")
    parts.push("        f_val = float(val); is_num = True\n")
    parts.push("    except Exception:\n")
    parts.push("        f_val = None\n")
    parts.push("    if is_num and isinstance(rv, (int, float)):\n")
    parts.push("        if op == '==': return rv == f_val\n")
    parts.push("        if op == '!=': return rv != f_val\n")
    parts.push("        if op == '>=': return rv >= f_val\n")
    parts.push("        if op == '<=': return rv <= f_val\n")
    parts.push("        if op == '>':  return rv >  f_val\n")
    parts.push("        if op == '<':  return rv <  f_val\n")
    parts.push("        return False\n")
    parts.push("    s_rv = str(rv)\n")
    parts.push("    if op == '==': return s_rv == val\n")
    parts.push("    if op == '!=': return s_rv != val\n")
    parts.push("    # Lexical comparison fallback for string-typed metrics.\n")
    parts.push("    if op == '>=': return s_rv >= val\n")
    parts.push("    if op == '<=': return s_rv <= val\n")
    parts.push("    if op == '>':  return s_rv >  val\n")
    parts.push("    if op == '<':  return s_rv <  val\n")
    parts.push("    return False\n\n")

    parts.push("def cmd_query(args):\n")
    parts.push("    key, op, val, why = _parse_query(args.expr)\n")
    parts.push("    if key is None:\n")
    parts.push("        emit_trailer('query-parse-failed', why,\n")
    parts.push("                     '1) format: \\'<key> <op> <value>\\'  '\n")
    parts.push("                     '2) ops: == != >= <= > <')\n")
    parts.push("        print('query=fail'); sys.exit(2)\n")
    parts.push("    rows = _load_all_rows()\n")
    parts.push("    matched = [r for r in rows if _row_match(r, key, op, val)]\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print(f'expr={args.expr}')\n")
    parts.push("    print(f'parsed_key={key}')\n")
    parts.push("    print(f'parsed_op={op}')\n")
    parts.push("    print(f'parsed_val={val}')\n")
    parts.push("    print(f'matched={len(matched)}')\n")
    parts.push("    print(f'available={len(rows)}')\n")
    parts.push("    out = json.dumps(matched, ensure_ascii=False)\n")
    parts.push("    print(f'rows_json={out}')\n")
    parts.push("    print('query=ok')\n")
    parts.push("    print(f'__EEG_QUALITY_LEDGER__ QUERY ok {len(matched)}')\n\n")

    // ─── selftest (synthetic; F_LEDGER_01 + F_LEDGER_02) ────────────
    parts.push("def cmd_selftest(args):\n")
    parts.push("    print(f'schema={SCHEMA}')\n")
    parts.push("    print('mode=selftest_synthetic')\n")
    parts.push("    # Use a temp dir so selftest does NOT pollute live ledger.\n")
    parts.push("    import tempfile, shutil\n")
    parts.push("    global LEDGER_DIR\n")
    parts.push("    saved_dir = LEDGER_DIR\n")
    parts.push("    tmp = tempfile.mkdtemp(prefix='anima_eeg_quality_ledger_selftest_')\n")
    parts.push("    LEDGER_DIR = tmp\n")
    parts.push("    print(f'selftest_tmp_dir={tmp}')\n")
    parts.push("    overall_ok = True\n")
    parts.push("    try:\n")
    parts.push("        # Synthetic rows: 5 with monotonic ts, 3 paradigms.\n")
    parts.push("        synth = [\n")
    parts.push("            {'ts': '2026-05-03T19:00:00Z', 'session_id': 'sess_a',\n")
    parts.push("             'paradigm': 'blink', 'effective_fs_hz': 60.5,\n")
    parts.push("             'sample_drop_pct': 51.6},\n")
    parts.push("            {'ts': '2026-05-03T19:05:00Z', 'session_id': 'sess_b',\n")
    parts.push("             'paradigm': 'rest',  'effective_fs_hz': 124.0,\n")
    parts.push("             'sample_drop_pct': 0.8},\n")
    parts.push("            {'ts': '2026-05-03T19:10:00Z', 'session_id': 'sess_c',\n")
    parts.push("             'paradigm': 'blink', 'effective_fs_hz': 92.1,\n")
    parts.push("             'sample_drop_pct': 26.3},\n")
    parts.push("            {'ts': '2026-05-03T19:15:00Z', 'session_id': 'sess_d',\n")
    parts.push("             'paradigm': 'mi',    'effective_fs_hz': 119.0,\n")
    parts.push("             'sample_drop_pct': 4.8},\n")
    parts.push("            {'ts': '2026-05-03T19:20:00Z', 'session_id': 'sess_e',\n")
    parts.push("             'paradigm': 'blink', 'effective_fs_hz': 75.0,\n")
    parts.push("             'sample_drop_pct': 40.0},\n")
    parts.push("        ]\n")
    parts.push("        os.makedirs(LEDGER_DIR, exist_ok=True)\n")
    parts.push("        path = _month_path()\n")
    parts.push("        for r in synth:\n")
    parts.push("            line = json.dumps(r, ensure_ascii=False, separators=(',', ':')) + '\\n'\n")
    parts.push("            with open(path, 'a', encoding='utf-8') as f:\n")
    parts.push("                try: fcntl.flock(f.fileno(), fcntl.LOCK_EX)\n")
    parts.push("                except Exception: pass\n")
    parts.push("                f.write(line); f.flush()\n")
    parts.push("                try: fcntl.flock(f.fileno(), fcntl.LOCK_UN)\n")
    parts.push("                except Exception: pass\n")
    parts.push("        # F_LEDGER_01: round-trip identity (first row)\n")
    parts.push("        loaded = _load_all_rows()\n")
    parts.push("        rt_first = (loaded[0] == synth[0])\n")
    parts.push("        rt_all   = (loaded == synth)\n")
    parts.push("        print(f'f_ledger_01_first_roundtrip={int(rt_first)}')\n")
    parts.push("        print(f'f_ledger_01_all_roundtrip={int(rt_all)}')\n")
    parts.push("        # F_LEDGER_02: get-recent N count\n")
    parts.push("        def _recent(n):\n")
    parts.push("            tail = loaded[-n:] if len(loaded) >= n else loaded[:]\n")
    parts.push("            return list(reversed(tail))\n")
    parts.push("        r3 = _recent(3); r5 = _recent(5); r10 = _recent(10)\n")
    parts.push("        ok_3  = (len(r3)  == 3)\n")
    parts.push("        ok_5  = (len(r5)  == 5)\n")
    parts.push("        ok_10 = (len(r10) == 5)  # cap at available=5\n")
    parts.push("        # First in r3 is most-recent (sess_e), session_id check.\n")
    parts.push("        ok_order = (r3[0]['session_id'] == 'sess_e' and\n")
    parts.push("                    r3[1]['session_id'] == 'sess_d' and\n")
    parts.push("                    r3[2]['session_id'] == 'sess_c')\n")
    parts.push("        print(f'f_ledger_02_recent_3_count={len(r3)}')\n")
    parts.push("        print(f'f_ledger_02_recent_5_count={len(r5)}')\n")
    parts.push("        print(f'f_ledger_02_recent_10_capped={len(r10)}')\n")
    parts.push("        print(f'f_ledger_02_reverse_chrono_order={int(ok_order)}')\n")
    parts.push("        # get-by-paradigm sanity (3 blinks expected)\n")
    parts.push("        blinks = [r for r in loaded if r.get('paradigm') == 'blink']\n")
    parts.push("        ok_paradigm = (len(blinks) == 3)\n")
    parts.push("        print(f'paradigm_filter_blink_count={len(blinks)}')\n")
    parts.push("        # get-trend sanity (5 numeric points for effective_fs_hz)\n")
    parts.push("        pts = [(r['ts'], r['effective_fs_hz']) for r in loaded\n")
    parts.push("               if 'effective_fs_hz' in r and 'ts' in r]\n")
    parts.push("        ok_trend = (len(pts) == 5)\n")
    parts.push("        print(f'trend_effective_fs_count={len(pts)}')\n")
    parts.push("        # query op > sanity: sample_drop_pct > 30 → 2 (sess_a=51.6, sess_e=40.0;\n")
    parts.push("        # sess_c=26.3 is below threshold).\n")
    parts.push("        q_match = [r for r in loaded\n")
    parts.push("                   if isinstance(r.get('sample_drop_pct'), (int, float))\n")
    parts.push("                   and r['sample_drop_pct'] > 30]\n")
    parts.push("        ok_query = (len(q_match) == 2)\n")
    parts.push("        print(f'query_drop_gt_30_count={len(q_match)}')\n")
    parts.push("        # Schema validate negative path: missing paradigm\n")
    parts.push("        bad = {'ts': 'x', 'session_id': 'y'}\n")
    parts.push("        ok_v, _why = _validate_row(bad)\n")
    parts.push("        ok_neg = (ok_v == False)\n")
    parts.push("        print(f'schema_negative_validate_rejected={int(ok_neg)}')\n")
    parts.push("        overall_ok = (rt_first and rt_all and ok_3 and ok_5 and ok_10\n")
    parts.push("                      and ok_order and ok_paradigm and ok_trend\n")
    parts.push("                      and ok_query and ok_neg)\n")
    parts.push("    finally:\n")
    parts.push("        try: shutil.rmtree(tmp)\n")
    parts.push("        except Exception: pass\n")
    parts.push("        LEDGER_DIR = saved_dir\n")
    parts.push("    print('verdict=' + ('PASS' if overall_ok else 'FAIL'))\n")
    parts.push("    # raw#80 sentinel\n")
    parts.push("    print('__EEG_QUALITY_LEDGER__ ' + ('SELFTEST ok 0' if overall_ok else 'SELFTEST fail 0'))\n")
    parts.push("    print('selftest=' + ('ok' if overall_ok else 'fail'))\n")
    parts.push("    print('DONE')\n")
    parts.push("    sys.exit(0 if overall_ok else 1)\n\n")

    parts.push("def main():\n")
    parts.push("    p = argparse.ArgumentParser()\n")
    parts.push("    sub = p.add_subparsers(dest='cmd', required=True)\n")
    parts.push("    sub.add_parser('selftest')\n")
    parts.push("    a = sub.add_parser('append')\n")
    parts.push("    a.add_argument('--row', default='')\n")
    parts.push("    a.add_argument('--row-stdin', dest='row_stdin', action='store_true')\n")
    parts.push("    gr = sub.add_parser('get-recent')\n")
    parts.push("    gr.add_argument('--n', required=True)\n")
    parts.push("    gp = sub.add_parser('get-by-paradigm')\n")
    parts.push("    gp.add_argument('--paradigm', required=True)\n")
    parts.push("    gt = sub.add_parser('get-trend')\n")
    parts.push("    gt.add_argument('--metric', required=True)\n")
    parts.push("    qy = sub.add_parser('query')\n")
    parts.push("    qy.add_argument('--expr', required=True)\n")
    parts.push("    args = p.parse_args()\n")
    parts.push("    if args.cmd == 'selftest':         cmd_selftest(args)\n")
    parts.push("    elif args.cmd == 'append':          cmd_append(args)\n")
    parts.push("    elif args.cmd == 'get-recent':      cmd_get_recent(args)\n")
    parts.push("    elif args.cmd == 'get-by-paradigm': cmd_get_by_paradigm(args)\n")
    parts.push("    elif args.cmd == 'get-trend':       cmd_get_trend(args)\n")
    parts.push("    elif args.cmd == 'query':           cmd_query(args)\n")
    parts.push("    else: sys.exit(2)\n\n")

    parts.push("if __name__ == '__main__': main()\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _run_helper(args: string) -> list {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

fn _run_helper_stdin(args: string, stdin_body: string) -> list {
    // Pipe stdin_body into the helper via shell heredoc-equivalent.
    let q = _sh_quote(stdin_body)
    let cmd = "printf '%s' " + q + " | python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

// ════════════════════════════════════════════════════════════════════
// Section 2. Hexa-side selftest assertions over helper kv-line body
// ════════════════════════════════════════════════════════════════════

fn assert_true(cond: bool, label: string) -> bool {
    if cond { println("  PASS: " + label) } else { println("  FAIL: " + label) }
    return cond
}

fn _run_selftest_assertions(body: string) -> int {
    let mut pass = 0
    let mut fail = 0

    println("=== quality_ledger raw#9 selftest assertions ===")

    // T1: helper marker selftest=ok
    println("[T1] helper marker selftest=ok")
    let t1 = assert_true(_kv_lookup(body, "selftest") == "ok", "selftest=ok present")
    if t1 { pass = pass + 1 } else { fail = fail + 1 }

    // T2: schema field
    println("[T2] schema field")
    let t2 = assert_true(_kv_lookup(body, "schema") == SCHEMA,
                         "schema=" + SCHEMA)
    if t2 { pass = pass + 1 } else { fail = fail + 1 }

    // T3: synthetic mode
    println("[T3] mode=selftest_synthetic")
    let t3 = assert_true(_kv_lookup(body, "mode") == "selftest_synthetic",
                         "mode=selftest_synthetic")
    if t3 { pass = pass + 1 } else { fail = fail + 1 }

    // T4: F_LEDGER_01 round-trip identity
    println("[T4] F_LEDGER_01 round-trip identical")
    let t4a = assert_true(_kv_lookup(body, "f_ledger_01_first_roundtrip") == "1",
                          "f_ledger_01_first_roundtrip=1")
    let t4b = assert_true(_kv_lookup(body, "f_ledger_01_all_roundtrip") == "1",
                          "f_ledger_01_all_roundtrip=1 (5 rows)")
    if t4a && t4b { pass = pass + 1 } else { fail = fail + 1 }

    // T5: F_LEDGER_02 get-recent N count
    println("[T5] F_LEDGER_02 get-recent N counts")
    let t5a = assert_true(_kv_lookup(body, "f_ledger_02_recent_3_count") == "3",
                          "get-recent 3 → 3 rows")
    let t5b = assert_true(_kv_lookup(body, "f_ledger_02_recent_5_count") == "5",
                          "get-recent 5 → 5 rows")
    let t5c = assert_true(_kv_lookup(body, "f_ledger_02_recent_10_capped") == "5",
                          "get-recent 10 → 5 rows (cap at available)")
    let t5d = assert_true(_kv_lookup(body, "f_ledger_02_reverse_chrono_order") == "1",
                          "get-recent in reverse-chronological order")
    if t5a && t5b && t5c && t5d { pass = pass + 1 } else { fail = fail + 1 }

    // T6: get-by-paradigm filter
    println("[T6] get-by-paradigm blink → 3 rows")
    let t6 = assert_true(_kv_lookup(body, "paradigm_filter_blink_count") == "3",
                         "paradigm_filter_blink_count=3")
    if t6 { pass = pass + 1 } else { fail = fail + 1 }

    // T7: get-trend numeric
    println("[T7] get-trend effective_fs_hz → 5 numeric points")
    let t7 = assert_true(_kv_lookup(body, "trend_effective_fs_count") == "5",
                         "trend_effective_fs_count=5")
    if t7 { pass = pass + 1 } else { fail = fail + 1 }

    // T8: query op
    println("[T8] query 'sample_drop_pct > 30' → 2 rows (sess_a=51.6, sess_e=40.0)")
    let t8 = assert_true(_kv_lookup(body, "query_drop_gt_30_count") == "2",
                         "query_drop_gt_30_count=2")
    if t8 { pass = pass + 1 } else { fail = fail + 1 }

    // T9: schema validation rejects bad row
    println("[T9] schema validation rejects missing paradigm")
    let t9 = assert_true(_kv_lookup(body, "schema_negative_validate_rejected") == "1",
                         "schema_negative_validate_rejected=1")
    if t9 { pass = pass + 1 } else { fail = fail + 1 }

    // T10: verdict + sentinel
    println("[T10] verdict=PASS + __EEG_QUALITY_LEDGER__ sentinel")
    let v_ok = (_kv_lookup(body, "verdict") == "PASS")
    let s_present = body.contains("__EEG_QUALITY_LEDGER__ SELFTEST ok")
    let t10 = assert_true(v_ok && s_present,
                          "verdict=PASS && sentinel SELFTEST ok emitted")
    if t10 { pass = pass + 1 } else { fail = fail + 1 }

    println("")
    println("Results: " + to_string(pass) + " PASS / " + to_string(fail)
            + " FAIL out of " + to_string(pass + fail))
    return fail
}

// ════════════════════════════════════════════════════════════════════
// Section 3. CLI dispatch
// ════════════════════════════════════════════════════════════════════

fn _print_usage() {
    eprintln("usage: hexa run anima-eeg/core/quality_ledger.hexa --selftest")
    eprintln("       --append --row '<json-object>'")
    eprintln("       --append --row-stdin   (read JSON from stdin)")
    eprintln("       --get-recent <N>")
    eprintln("       --get-by-paradigm <name>")
    eprintln("       --get-trend <metric>")
    eprintln("       --query '<key> <op> <value>'    ops: == != >= <= > <")
    eprintln("flags:")
    eprintln("  --selftest          synthetic 10 PASS / 0 FAIL "
             + "(F_LEDGER_01/02 + filter/trend/query surrogates)")
    eprintln("  --append            append a single audit row to "
             + LEDGER_DIR + "/<YYYY-MM>.jsonl")
    eprintln("  --get-recent N      most recent N rows, reverse-chronological")
    eprintln("  --get-by-paradigm   filter rows by paradigm name")
    eprintln("  --get-trend metric  emit (ts, value) pairs for one numeric metric")
    eprintln("  --query 'k op v'    ad-hoc filter expression")
    eprintln("  --help              this message")
}

fn _flags_only_argv() -> array {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut is_path = false
        if a.ends_with(".hexa") { is_path = true }
        if !is_path {
            if a.ends_with("/exe") { is_path = true }
        }
        if is_path { start = start + 1 } else { break }
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn main() {
    let av = _flags_only_argv()
    let mut selftest = false
    let mut want_help = false
    let mut do_append = false
    let mut do_get_recent = false
    let mut do_get_by_par = false
    let mut do_get_trend = false
    let mut do_query = false

    let mut row_json = ""
    let mut row_stdin = false
    let mut recent_n = 0
    let mut paradigm = ""
    let mut metric = ""
    let mut query_expr = ""

    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest"   { selftest = true; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = true; i = i + 1; continue }
        if a == "--append"     { do_append = true; i = i + 1; continue }
        if a == "--row" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--row requires JSON object",
                              "1) --row '{\"ts\":\"...\",\"session_id\":\"...\",\"paradigm\":\"...\"}'")
                exit(2)
            }
            row_json = av[i + 1]; i = i + 2; continue
        }
        if a == "--row-stdin" { row_stdin = true; i = i + 1; continue }
        if a == "--get-recent" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--get-recent requires int N",
                              "1) --get-recent 10")
                exit(2)
            }
            do_get_recent = true; recent_n = to_int(av[i + 1]); i = i + 2; continue
        }
        if a == "--get-by-paradigm" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--get-by-paradigm requires <name>",
                              "1) --get-by-paradigm blink")
                exit(2)
            }
            do_get_by_par = true; paradigm = av[i + 1]; i = i + 2; continue
        }
        if a == "--get-trend" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value",
                              "--get-trend requires <metric>",
                              "1) --get-trend effective_fs_hz")
                exit(2)
            }
            do_get_trend = true; metric = av[i + 1]; i = i + 2; continue
        }
        if a == "--query" {
            if (i + 1) >= len(av) {
                _emit_trailer("missing-arg-value", "--query requires expr",
                              "1) --query 'sample_drop_pct > 30'")
                exit(2)
            }
            do_query = true; query_expr = av[i + 1]; i = i + 2; continue
        }
        _emit_trailer("unknown-arg", "unrecognized argument: " + a,
                      "1) re-run with --help to see flags")
        _print_usage()
        exit(2)
    }

    if want_help { _print_usage(); exit(0) }

    let any = selftest || do_append || do_get_recent || do_get_by_par
              || do_get_trend || do_query
    if !any {
        eprintln("ABORT: must pass one of --selftest / --append / --get-recent /")
        eprintln("       --get-by-paradigm / --get-trend / --query")
        eprintln("       (raw#9 strict no-fallback policy)")
        _print_usage()
        exit(2)
    }

    _write_helper()

    // ─── Selftest path (synthetic, isolated /tmp dir) ───────────────
    if selftest {
        println("== quality_ledger selftest ==")
        let r = _run_helper("selftest")
        let body = r[0]
        let st   = r[1]
        println(body)
        if st != 0 { eprintln("selftest helper FAILED rc=" + to_string(st)); exit(1) }
        if _kv_lookup(body, "selftest") != "ok" {
            _emit_trailer("selftest-marker-missing",
                          "helper did not emit selftest=ok",
                          "1) inspect " + HELPER_PATH + "  2) re-run")
            exit(1)
        }
        println("")
        let fails = _run_selftest_assertions(body)
        if fails != 0 {
            println("selftest=fail")
            eprintln("selftest FAILED: " + to_string(fails) + " assertion(s) failed")
            exit(1)
        }
        println("selftest: OK")
        exit(0)
    }

    // ─── Append (real ledger write) ─────────────────────────────────
    if do_append {
        if !row_stdin && row_json == "" {
            _emit_trailer("append-missing-input",
                          "--append needs --row '<json>' or --row-stdin",
                          "1) --row '{...}'  2) echo '{...}' | ... --row-stdin")
            exit(2)
        }
        let mut cmd = "append"
        if row_stdin {
            cmd = cmd + " --row-stdin"
            // We DO NOT pre-read stdin in hexa; helper reads sys.stdin directly.
            let r = _run_helper(cmd)
            println(r[0])
            exit(to_int(r[1]))
        }
        cmd = cmd + " --row " + _sh_quote(row_json)
        let r = _run_helper(cmd)
        println(r[0])
        exit(to_int(r[1]))
    }

    // ─── get-recent ─────────────────────────────────────────────────
    if do_get_recent {
        let r = _run_helper("get-recent --n " + to_string(recent_n))
        println(r[0])
        exit(to_int(r[1]))
    }

    // ─── get-by-paradigm ────────────────────────────────────────────
    if do_get_by_par {
        let r = _run_helper("get-by-paradigm --paradigm " + _sh_quote(paradigm))
        println(r[0])
        exit(to_int(r[1]))
    }

    // ─── get-trend ──────────────────────────────────────────────────
    if do_get_trend {
        let r = _run_helper("get-trend --metric " + _sh_quote(metric))
        println(r[0])
        exit(to_int(r[1]))
    }

    // ─── query ──────────────────────────────────────────────────────
    if do_query {
        let r = _run_helper("query --expr " + _sh_quote(query_expr))
        println(r[0])
        exit(to_int(r[1]))
    }
}
// hexa-strict auto-invokes fn main() — do not call main() explicitly.
