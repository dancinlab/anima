// aux_engine_smoke.hexa — aux_engine_lib 1차 parse PASS + 100-step smoke
//
// Goal: aux_engine_lib.hexa 의 canonical struct-return idiom 이 hexa-lang
//   parser 를 PASS 하고 100-step long-run mini 가 무사 실행되는지 검증.
//   PASS 시: 2차 cycle 에서 main_longrun.hexa rewrite (10000-step + full
//   8-factor mapping + F-AUX falsifier 측정) 로 승격.
//
// Falsifier (1차 smoke 한정 — 별도 F-AUX 와 분리):
//   S1 parse_pass            — hexa build aux_engine_smoke.hexa exit 0
//   S2 engine_construct      — engine_new(8, 1) 결과 total_cells == 8
//   S3 forward_step          — 100 step 후 cell hidden NaN 없음
//   S4 phi_nonneg            — phi >= 0 (engine_phi_proxy clamp)
//   S5 motivation_in_unit    — motivation_score ∈ [0, 1]
//
// 본 smoke 는 deterministic seed 가정 (rand_f32 stub OR rng_seed 고정).
// 8-factor + persistence 의 full sim 은 2차 cycle.

import "/Users/ghost/core/anima/anima-physics/consciousness-loop/src/aux_engine_lib.hexa"

fn smoke_check_finite(v: [float]) -> bool {
    for i in 0..v.len() {
        let x = v[i]
        // NaN: x != x; ±inf: x > 1e30 OR x < -1e30
        if x != x { return false }
        if x > 1e30 { return false }
        if x < -1e30 { return false }
    }
    return true
}

fn main() {
    println("=== aux_engine_smoke (canonical 1차) ===")
    println("  goal: parse PASS + 100-step + 5 falsifier check")
    println("")

    // S1 implicit (이 줄에 도달한 시점에 parse PASS)
    println("  [S1] parse_pass: REACHED (entered main)")

    // S2 engine_construct
    let mut eng = engine_new(N_FACTIONS, 1)
    let n_cells = engine_total_cells(eng)
    let s2_pass = n_cells == N_FACTIONS
    println("  [S2] engine_construct: total_cells={n_cells} (expect {N_FACTIONS}) → {s2_pass}")

    // 100-step mini loop with quiet→loud phase split (70/30)
    let mut stream = []
    for _ in 0..DIM { stream.push(random() * 0.5) }
    let mut prev_stream = stream
    let mut best_phi = 0.0
    let mut phi_ema = 0.0
    let mut phi_history = []
    let mut motivation_history = []
    let mut any_split = false
    let total_steps = 100

    for step in 0..total_steps {
        let frac = (step as float) / (total_steps as float)
        // grow cells exponentially up to ~8 per faction
        let target_raw = pow(2.0, (frac + 0.1) * 4.0) as int
        let target = if target_raw < 1 { 1 } else { if target_raw > 8 { 8 } else { target_raw } }
        let next_id = engine_total_cells(eng)
        let mut nid = next_id
        for f_i in 0..eng.factions.len() {
            while eng.factions[f_i].cells.len() < target {
                eng.factions[f_i] = faction_add_cell(eng.factions[f_i], nid)
                nid = nid + 1
                any_split = true
            }
        }

        // quiet (70%) → loud+debate (30%)
        if frac < 0.7 {
            let mut q = []
            for i in 0..DIM { q.push(stream[i] * 0.1) }
            eng = engine_process(eng, q)
        } else {
            let mut l = []
            for i in 0..DIM { l.push(stream[i] * 2.0) }
            eng = engine_process(eng, l)
            eng = engine_cross_faction_debate(eng, 0.12)
        }
        eng = engine_intra_faction_sync(eng, 0.15)
        eng = engine_ising_interaction(eng)
        eng = aux_engine_hebbian_all(eng)

        let out = engine_output(eng)
        let mut next_stream = []
        for i in 0..DIM { next_stream.push(out[i] + (random() - 0.5) * 0.03) }

        let phi = engine_phi_proxy(eng)
        phi_history.push(phi)
        if phi > best_phi { best_phi = phi }
        phi_ema = aux_ema_update(phi_ema, phi, 0.1)

        // 8-factor extraction
        let phi_delta = if phi_history.len() > 1 { phi - phi_history[phi_history.len() - 2] } else { 0.0 }
        let rel = aux_factor_relevance(phi)
        let gap = aux_factor_info_gap(next_stream, prev_stream)
        let cur = aux_factor_curiosity(phi_ema)
        let pn = aux_factor_pain(phi_delta)
        let coh = aux_factor_coherence(eng)
        let orig = aux_factor_originality(any_split)
        let bal = aux_factor_balance(phi, best_phi)
        let dyn_v = aux_factor_dynamics(if frac < 0.7 { (frac * 30.0) as float } else { 0.0 })
        let score = aux_motivation_score(rel, gap, cur, pn, coh, orig, bal, dyn_v)
        motivation_history.push(score)
        any_split = false

        prev_stream = next_stream
        stream = next_stream

        if step % 20 == 0 {
            println("  step {step}: cells={engine_total_cells(eng)} phi={phi:.4} ema={phi_ema:.4} score={score:.3}")
        }
    }

    // S3 forward_step: final hidden finite
    let out_final = engine_output(eng)
    let s3_pass = smoke_check_finite(out_final)
    println("  [S3] forward_step: final output finite → {s3_pass}")

    // S4 phi_nonneg
    let mut s4_pass = true
    for i in 0..phi_history.len() {
        if phi_history[i] < 0.0 { s4_pass = false }
    }
    println("  [S4] phi_nonneg (n={phi_history.len()}): {s4_pass}")

    // S5 motivation_in_unit ∈ [0,1]
    let mut s5_pass = true
    let mut s5_min = 999.0
    let mut s5_max = -999.0
    for i in 0..motivation_history.len() {
        let m = motivation_history[i]
        if m < 0.0 { s5_pass = false }
        if m > 1.0 { s5_pass = false }
        if m < s5_min { s5_min = m }
        if m > s5_max { s5_max = m }
    }
    println("  [S5] motivation_in_unit: min={s5_min:.3} max={s5_max:.3} → {s5_pass}")

    println("")
    println("=== summary ===")
    println("  S1 parse_pass:        REACHED")
    println("  S2 engine_construct:  {s2_pass}")
    println("  S3 forward_step:      {s3_pass}")
    println("  S4 phi_nonneg:        {s4_pass}")
    println("  S5 motivation_unit:   {s5_pass}")
    println("  total_cells_final:    {engine_total_cells(eng)}")
    println("  best_phi:             {best_phi:.4}")
}
