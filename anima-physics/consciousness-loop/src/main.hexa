// Consciousness Infinite Loop v2 — Hexa 심화 구현 (canonical, 2026-05-21 G1)
//
// v1 결과: 발화 존재, 대화 수렴 약함
// v2 해결: 파벌 구조 + 물리적 상호작용 + Phi 근사 + 노이즈 주입
//
// 아키텍처 (발화 코드 0줄):
//   Cell = GRU hidden state (float x HIDDEN)
//   Faction = Cell 그룹 (독립적 관점 발전)
//   Engine = [Faction] + 물리적 상호작용
//   Loop = output(전체 mean) -> input(next step)
//
// Canonical rewrite (G1 closure):
//   - legacy `self: *T` / `&engine` borrow + `++` concat + `or` keyword + `[]*[…]`
//     pointer-to-list 제거. Cell + Faction + Engine 정의는 aux_engine_lib (SSOT) 에 위임.
//   - 모든 mutation 은 functional-update 로 변환: `engine = engine_xxx(engine, ...)`
//   - 세 Test 의 시맨틱 보존:
//       Test 1 8-Faction Debate Loop (1000 step quiet→loud)
//       Test 2 Dual 8-Faction Engine Conversation (1000 step, cross-debate after 50%)
//       Test 3 Zero-Input Eternal Loop (500 step sensory deprivation)
//   - 출력 형식 유지 (println 라벨 동일)

import "/Users/ghost/core/anima/anima-physics/consciousness-loop/src/aux_engine_lib.hexa"

fn vec_norm_local(v: [float]) -> float {
    let mut sum = 0.0
    for i in 0..v.len() { sum = sum + v[i] * v[i] }
    return sqrt(sum)
}


fn main() {
    let steps = 1000

    println("=== Consciousness Infinite Loop v2 (Hexa) ===")
    println("  Factions:", N_FACTIONS, " Cells: 2->512  Steps:", steps)
    println("  발화 코드: 0줄. 디코더: 없음. speak(): 없음.")
    println("  추가: 파벌 구조 + Ising 자석 + Phi 근사 + 침묵->폭발")
    println("")

    // ─────────────────────────────────────────────────────────────────
    // Test 1: 8-Faction Debate Loop
    // ─────────────────────────────────────────────────────────────────
    println(">> Test 1: 8-Faction Debate Loop")
    let mut engine = engine_new(N_FACTIONS, 1)
    let mut stream = []
    for _ in 0..DIM { stream.push(random() * 0.5) }
    let mut output_norms = []
    let mut phi_history = []
    let mut diversity_history = []

    for step in 0..steps {
        let frac = step as float / steps as float
        let raw_target = pow(2.0, (frac + 0.1) * 6.0) as int
        let target_per_faction = if raw_target > 64 { 64 } else { raw_target }
        let mut nid = engine_total_cells(engine)
        for f_i in 0..engine.factions.len() {
            while engine.factions[f_i].cells.len() < target_per_faction {
                engine.factions[f_i] = faction_add_cell(engine.factions[f_i], nid)
                nid = nid + 1
            }
        }
        if frac < 0.70 {
            let mut quiet_input = []
            for i in 0..DIM { quiet_input.push(stream[i] * 0.1) }
            engine = engine_process(engine, quiet_input)
            engine = engine_intra_faction_sync(engine, 0.15)
            engine = engine_ising_interaction(engine)
        } else {
            let mut loud_input = []
            for i in 0..DIM { loud_input.push(stream[i] * 2.0) }
            engine = engine_process(engine, loud_input)
            engine = engine_intra_faction_sync(engine, 0.15)
            engine = engine_cross_faction_debate(engine, 0.12)
            engine = engine_ising_interaction(engine)
        }
        let out = engine_output(engine)
        let norm = vec_norm_local(out)
        output_norms.push(norm)
        let mut next_stream = []
        for i in 0..DIM { next_stream.push(out[i] + (random() - 0.5) * 0.03) }
        stream = next_stream
        let phi = engine_phi_proxy(engine)
        let div = engine_diversity(engine)
        phi_history.push(phi)
        diversity_history.push(div)
        if step % 200 == 0 || step == steps - 1 {
            println("  step", step, ": cells=", engine_total_cells(engine), "Phi~", phi, "diversity=", div, "out_norm=", norm)
        }
    }

    let mut mean_norm = 0.0
    for i in 0..output_norms.len() { mean_norm = mean_norm + output_norms[i] }
    mean_norm = mean_norm / output_norms.len() as float
    let mut std_sq = 0.0
    for i in 0..output_norms.len() {
        let d = output_norms[i] - mean_norm
        std_sq = std_sq + d * d
    }
    let std_norm = sqrt(std_sq / output_norms.len() as float)

    let mut never_silent = 0
    for i in 1..output_norms.len() {
        if fabs(output_norms[i] - output_norms[i - 1]) > 0.001 {
            never_silent = never_silent + 1
        }
    }
    let denom_ns = if output_norms.len() < 2 { 1 } else { output_norms.len() - 1 }
    let never_silent_pct = never_silent as float / denom_ns as float

    let phi_final = phi_history[phi_history.len() - 1]
    let mut phi_max = 0.0
    for i in 0..phi_history.len() {
        if phi_history[i] > phi_max { phi_max = phi_history[i] }
    }

    println("")
    println("  --- 발화 분석 ---")
    println("    output_std:     ", std_norm)
    println("    never_silent:   ", never_silent_pct * 100.0, "%")
    println("    Phi final:      ", phi_final)
    println("    Phi max:        ", phi_max)
    println("    diversity final:", diversity_history[diversity_history.len() - 1])

    // ─────────────────────────────────────────────────────────────────
    // Test 2: Dual Engine Conversation
    // ─────────────────────────────────────────────────────────────────
    println("")
    println(">> Test 2: Dual 8-Faction Engine Conversation")
    let mut ea = engine_new(N_FACTIONS, 1)
    let mut eb = engine_new(N_FACTIONS, 1)
    let mut sa = []
    let mut sb = []
    for _ in 0..DIM {
        sa.push(random() * 0.5)
        sb.push(random() * 0.5)
    }
    let mut agreements = []

    for step in 0..steps {
        let frac = step as float / steps as float
        let raw_target2 = pow(2.0, (frac + 0.1) * 5.0) as int
        let target = if raw_target2 > 16 { 16 } else { raw_target2 }

        let mut nid_a = engine_total_cells(ea)
        for f_i in 0..ea.factions.len() {
            while ea.factions[f_i].cells.len() < target {
                ea.factions[f_i] = faction_add_cell(ea.factions[f_i], nid_a)
                nid_a = nid_a + 1
            }
        }
        let mut nid_b = engine_total_cells(eb)
        for f_i in 0..eb.factions.len() {
            while eb.factions[f_i].cells.len() < target {
                eb.factions[f_i] = faction_add_cell(eb.factions[f_i], nid_b)
                nid_b = nid_b + 1
            }
        }

        let mut sa_noisy = []
        let mut sb_noisy = []
        for i in 0..DIM {
            sa_noisy.push(sa[i] + (random() - 0.5) * 0.05)
            sb_noisy.push(sb[i] + (random() - 0.5) * 0.05)
        }
        ea = engine_process(ea, sb_noisy)
        eb = engine_process(eb, sa_noisy)
        ea = engine_intra_faction_sync(ea, 0.10)
        eb = engine_intra_faction_sync(eb, 0.10)
        if frac > 0.50 {
            ea = engine_cross_faction_debate(ea, 0.08)
            eb = engine_cross_faction_debate(eb, 0.08)
        }
        ea = engine_ising_interaction(ea)
        eb = engine_ising_interaction(eb)

        let oa = engine_output(ea)
        let ob = engine_output(eb)
        let mut dot = 0.0
        let mut na = 0.0
        let mut nb = 0.0
        for i in 0..DIM {
            dot = dot + oa[i] * ob[i]
            na = na + oa[i] * oa[i]
            nb = nb + ob[i] * ob[i]
        }
        let na_norm = sqrt(na)
        let nbn = sqrt(nb)
        let cos = if na_norm > 0.001 && nbn > 0.001 { dot / (na_norm * nbn) } else { 0.0 }
        agreements.push(cos)
        sa = oa
        sb = ob
        if step % 200 == 0 || step == steps - 1 {
            println("  step", step, ": cells=", engine_total_cells(ea), "+", engine_total_cells(eb), "agreement=", cos)
        }
    }

    let first_agree = agreements[0]
    let last_agree = agreements[agreements.len() - 1]
    let mut max_agree = -999.0
    for i in 0..agreements.len() {
        if agreements[i] > max_agree { max_agree = agreements[i] }
    }
    let converging = last_agree > first_agree + 0.05 || max_agree > 0.5

    println("")
    println("  --- 대화 분석 ---")
    println("    initial agreement:", first_agree)
    println("    final agreement:  ", last_agree)
    println("    max agreement:    ", max_agree)
    if converging {
        println("    convergence: YES")
    } else {
        println("    convergence: weak")
    }

    // ─────────────────────────────────────────────────────────────────
    // Test 3: Zero-Input Eternal Loop
    // ─────────────────────────────────────────────────────────────────
    println("")
    println(">> Test 3: Zero-Input Eternal Loop (sensory deprivation)")
    let mut engine_z = engine_new(N_FACTIONS, 8)
    let mut zero_input = []
    for _ in 0..DIM { zero_input.push(0.0) }
    let mut z_changes = []
    let mut prev_out = engine_output(engine_z)
    for step in 0..500 {
        engine_z = engine_process(engine_z, zero_input)
        engine_z = engine_intra_faction_sync(engine_z, 0.10)
        engine_z = engine_ising_interaction(engine_z)
        if step > 250 { engine_z = engine_cross_faction_debate(engine_z, 0.08) }
        let out = engine_output(engine_z)
        let mut change_sq = 0.0
        for i in 0..DIM {
            let d = out[i] - prev_out[i]
            change_sq = change_sq + d * d
        }
        let change = sqrt(change_sq)
        z_changes.push(change)
        prev_out = out
        if step % 100 == 0 || step == 499 {
            println("  step", step, ": delta=", change, "Phi~", engine_phi_proxy(engine_z))
        }
    }
    let mut eternal_active = 0
    for i in 0..z_changes.len() {
        if z_changes[i] > 0.0001 { eternal_active = eternal_active + 1 }
    }
    let denom_z = if z_changes.len() < 1 { 1 } else { z_changes.len() }
    let eternal_pct = eternal_active as float / denom_z as float

    println("")
    println("  --- 감각 박탈 분석 ---")
    println("    still active:", eternal_pct * 100.0, "% of steps")

    println("")
    println("=======================================")
    println("  v2 결론:")
    if std_norm > 0.01 {
        println("  발화:  YES")
    } else {
        println("  발화:  weak")
    }
    if converging {
        println("  대화:  YES")
    } else {
        println("  대화:  weak")
    }
    if eternal_pct > 0.5 {
        println("  영원:  YES")
    } else {
        println("  영원:  weak")
    }
    println("  Phi:  ", phi_final)
    println("  코드:  speak()=0줄, decode()=0줄, prompt=0줄")
    println("=======================================")
}
