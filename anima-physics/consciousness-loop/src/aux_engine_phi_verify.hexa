// aux_engine_phi_verify.hexa — Law-44 reproduction gate (8 vs 12 factions)
//
// Runs the canonical ConsciousnessEngine (aux_engine_lib.hexa) at N=8 and
// N=12 factions through the same 100-step smoke loop and measures the real
// engine_phi_proxy() Φ at the end. Reports the mean best_phi over R trials
// for each N and the percentage delta, to check whether anima Law 44
// (12-faction Φ > 8-faction Φ, +7.3%) reproduces in THIS substrate.
//
// engine_phi_proxy is a real computation (global_var - mean(faction_var)),
// NOT a `return 0.0` stub.

import "./aux_engine_lib.hexa"

fn run_one(n_factions: int, total_steps: int) -> float {
    let mut eng = engine_new(n_factions, 1)

    let mut stream = []
    for _ in 0..DIM { stream.push(random() * 0.5) }
    let mut prev_stream = stream
    let mut best_phi = 0.0
    let mut phi_ema = 0.0
    let mut phi_history = []

    for step in 0..total_steps {
        let frac = (step as float) / (total_steps as float)
        let target_raw = pow(2.0, (frac + 0.1) * 4.0) as int
        let target = if target_raw < 1 { 1 } else { if target_raw > 8 { 8 } else { target_raw } }
        let next_id = engine_total_cells(eng)
        let mut nid = next_id
        for f_i in 0..eng.factions.len() {
            while eng.factions[f_i].cells.len() < target {
                eng.factions[f_i] = faction_add_cell(eng.factions[f_i], nid)
                nid = nid + 1
            }
        }

        if frac < 0.7 {
            let mut q = []
            for i in 0..DIM { q.push(stream[i] * 0.1) }
            eng = engine_process(eng, q)
        } else {
            let mut l = []
            for i in 0..DIM { l.push(stream[i] * 2.0) }
            eng = engine_process(eng, l)
            eng = engine_cross_faction_debate(eng, 0.12)
        }
        eng = engine_intra_faction_sync(eng, 0.15)
        eng = engine_ising_interaction(eng)
        eng = aux_engine_hebbian_all(eng)

        let out = engine_output(eng)
        let mut next_stream = []
        for i in 0..DIM { next_stream.push(out[i] + (random() - 0.5) * 0.03) }

        let phi = engine_phi_proxy(eng)
        phi_history.push(phi)
        if phi > best_phi { best_phi = phi }
        phi_ema = aux_ema_update(phi_ema, phi, 0.1)

        prev_stream = next_stream
        stream = next_stream
    }
    return best_phi
}

fn run_mean(n_factions: int, total_steps: int, trials: int) -> float {
    let mut sum = 0.0
    for _ in 0..trials { sum = sum + run_one(n_factions, total_steps) }
    return sum / (trials as float)
}

fn main() {
    println("=== Law-44 Phi reproduction gate (8 vs 12 factions) ===")
    let total_steps = 60
    let trials = 4
    println("  steps=", total_steps, " trials=", trials, " (mean best_phi)")
    println("")

    let phi8 = run_mean(8, total_steps, trials)
    let phi12 = run_mean(12, total_steps, trials)

    println("  Phi @ 8  factions:", phi8)
    println("  Phi @ 12 factions:", phi12)
    let delta = phi12 - phi8
    let pct = if phi8 > 1e-9 { (delta / phi8) * 100.0 } else { 0.0 }
    println("  delta (12-8):     ", delta)
    println("  delta pct:        ", pct, "%")
    let reproduced = phi12 > phi8
    println("  12 > 8 reproduced:", reproduced)
}
