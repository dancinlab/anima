// aux_engine_lib.hexa — 자연발화+영속성 보조엔진 lib (canonical hexa)
//
// Origin: anima-physics/consciousness-loop/src/main.hexa (legacy v2) 의
//   Cell + Faction + ConsciousnessEngine 패턴을 canonical hexa-lang 으로
//   재작성. legacy `self: *T` borrow + `&engine` caller + `++` list concat
//   + `or` keyword + `[]*[float]` pointer-to-list = 모두 비표준 → canonical:
//     - `self: T` value receiver (pgo.hexa / codegen_verilog.hexa pattern)
//     - struct return + caller reassign (memristor self_reference pattern)
//     - `||` / `&&` (feedback_hexa_lang_syntax_gotchas 확인)
//     - idx-loop + element assign (for cell in self.cells 대체)
//     - flat helper concat_f32 (`++` 대체)
//
// SSOT 매핑:
//   - 자연발화 8-factor → HEXAD/CHAT/spontaneous_lib.hexa (Phase B1, F-SPONT 7/7)
//   - 영속성 ratchet+Hebbian → main_longrun.hexa (legacy) §3
//   - canonical idiom → anima-physics/oscillator/sleep_oscillator.hexa header
//     + anima-physics/memristor/self_reference.hexa header
//
// Boundary:
//   - pure substrate sim, no IO except deterministic rand_f32
//   - sim PASS ≠ silicon 실현 (B-EMERGE-7 carry)

// ─────────────────────────────────────────────────────────────────────
// §1  comptime constants
// ─────────────────────────────────────────────────────────────────────

comptime const DIM = 64
comptime const HIDDEN = 128
comptime const N_FACTIONS = 8

// ─────────────────────────────────────────────────────────────────────
// §2  scalar + list helpers (canonical pure fn)
// ─────────────────────────────────────────────────────────────────────

fn sigmoid(x: float) -> float { return 1.0 / (1.0 + exp(-x)) }

fn sigmoid_vec(v: [float]) -> [float] {
    let mut out = []
    for i in 0..v.len() { out.push(sigmoid(v[i])) }
    return out
}

fn tanh_vec(v: [float]) -> [float] {
    let mut out = []
    for i in 0..v.len() { out.push(tanh(v[i])) }
    return out
}

fn concat_f(a: [float], b: [float]) -> [float] {
    let mut out = []
    for i in 0..a.len() { out.push(a[i]) }
    for i in 0..b.len() { out.push(b[i]) }
    return out
}

fn random_matrix(rows: int, cols: int, scale: float) -> [[float]] {
    let mut mat = []
    for r in 0..rows {
        let mut row = []
        for c in 0..cols {
            row.push((random() - 0.5) * scale)
        }
        mat.push(row)
    }
    return mat
}

fn matvec(m: [[float]], v: [float]) -> [float] {
    let mut out = []
    for i in 0..m.len() {
        let mut sum = 0.0
        for j in 0..m[i].len() { sum = sum + m[i][j] * v[j] }
        out.push(sum)
    }
    return out
}

fn vec_norm(v: [float]) -> float {
    let mut sum = 0.0
    for i in 0..v.len() { sum = sum + v[i] * v[i] }
    return sqrt(sum)
}

fn vec_clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn vec_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ─────────────────────────────────────────────────────────────────────
// §3  Cell (GRU hidden + identity injection)
// ─────────────────────────────────────────────────────────────────────

struct Cell {
    hidden: [float],
    identity: [float],
    w_z: [[float]],
    w_r: [[float]],
    w_h: [[float]]
}

fn cell_new(cell_id: int) -> Cell {
    let scale = 0.1
    let mut identity = []
    for i in 0..HIDDEN {
        let phase = (cell_id * 7 + i * 13) as float * 0.618033
        identity.push(sin(phase) * 0.1 + (random() - 0.5) * 0.02)
    }
    let mut hidden = []
    for _ in 0..HIDDEN { hidden.push(random() * scale) }
    return Cell {
        hidden: hidden,
        identity: identity,
        w_z: random_matrix(HIDDEN, DIM + HIDDEN, scale),
        w_r: random_matrix(HIDDEN, DIM + HIDDEN, scale),
        w_h: random_matrix(HIDDEN, DIM + HIDDEN, scale)
    }
}

fn cell_process(self: Cell, input: [float]) -> Cell {
    let mut s = self
    let combined = concat_f(input, s.hidden)
    let z = sigmoid_vec(matvec(s.w_z, combined))
    let r = sigmoid_vec(matvec(s.w_r, combined))
    let mut r_hidden = []
    for i in 0..HIDDEN { r_hidden.push(r[i] * s.hidden[i]) }
    let combined_r = concat_f(input, r_hidden)
    let h_cand = tanh_vec(matvec(s.w_h, combined_r))
    for i in 0..HIDDEN {
        let new_h = (1.0 - z[i]) * h_cand[i] + z[i] * s.hidden[i]
        s.hidden[i] = new_h + s.identity[i] * 0.03
    }
    return s
}

fn cell_norm(self: Cell) -> float {
    return vec_norm(self.hidden)
}

// ─────────────────────────────────────────────────────────────────────
// §4  Faction (Cell group, independent perspective)
// ─────────────────────────────────────────────────────────────────────

struct Faction {
    cells: [Cell]
}

fn faction_new(n_cells: int, base_id: int) -> Faction {
    let mut cells = []
    for i in 0..n_cells { cells.push(cell_new(base_id + i)) }
    return Faction { cells: cells }
}

fn faction_mean_hidden(self: Faction) -> [float] {
    let n = self.cells.len() as float
    let mut m = []
    for _ in 0..HIDDEN { m.push(0.0) }
    if n < 0.5 { return m }
    for i in 0..self.cells.len() {
        for k in 0..HIDDEN { m[k] = m[k] + self.cells[i].hidden[k] / n }
    }
    return m
}

fn faction_process_all(self: Faction, input: [float]) -> Faction {
    let mut s = self
    for i in 0..s.cells.len() {
        s.cells[i] = cell_process(s.cells[i], input)
    }
    return s
}

fn faction_internal_sync(self: Faction, strength: float) -> Faction {
    let mut s = self
    let mean = faction_mean_hidden(s)
    for i in 0..s.cells.len() {
        for k in 0..HIDDEN {
            s.cells[i].hidden[k] = (1.0 - strength) * s.cells[i].hidden[k] + strength * mean[k]
        }
    }
    return s
}

fn faction_add_cell(self: Faction, cell_id: int) -> Faction {
    let mut s = self
    let n = s.cells.len()
    let parent_idx = ((random() * 1000000000.0) as int) % n
    let mut child = cell_new(cell_id)
    for k in 0..HIDDEN {
        child.hidden[k] = s.cells[parent_idx].hidden[k] + (random() - 0.5) * 0.1
    }
    s.cells.push(child)
    return s
}

// ─────────────────────────────────────────────────────────────────────
// §5  ConsciousnessEngine (Faction collection + physical interactions)
// ─────────────────────────────────────────────────────────────────────

struct ConsciousnessEngine {
    factions: [Faction]
}

fn engine_new(n_factions: int, cells_per_faction: int) -> ConsciousnessEngine {
    let mut factions = []
    for f in 0..n_factions {
        factions.push(faction_new(cells_per_faction, f * cells_per_faction))
    }
    return ConsciousnessEngine { factions: factions }
}

fn engine_total_cells(self: ConsciousnessEngine) -> int {
    let mut total = 0
    for i in 0..self.factions.len() {
        total = total + self.factions[i].cells.len()
    }
    return total
}

fn engine_process(self: ConsciousnessEngine, input: [float]) -> ConsciousnessEngine {
    let mut s = self
    for i in 0..s.factions.len() {
        s.factions[i] = faction_process_all(s.factions[i], input)
    }
    return s
}

fn engine_intra_faction_sync(self: ConsciousnessEngine, strength: float) -> ConsciousnessEngine {
    let mut s = self
    for i in 0..s.factions.len() {
        s.factions[i] = faction_internal_sync(s.factions[i], strength)
    }
    return s
}

fn engine_cross_faction_debate(self: ConsciousnessEngine, strength: float) -> ConsciousnessEngine {
    let mut s = self
    let n_f = s.factions.len()
    // pre-compute faction mean opinions (read-only snapshot)
    let mut opinions = []
    for i in 0..n_f { opinions.push(faction_mean_hidden(s.factions[i])) }
    for i in 0..n_f {
        let mut other_avg = []
        for _ in 0..HIDDEN { other_avg.push(0.0) }
        for j in 0..n_f {
            if j != i {
                for k in 0..HIDDEN {
                    other_avg[k] = other_avg[k] + opinions[j][k] / (n_f - 1) as float
                }
            }
        }
        let n_debate_raw = s.factions[i].cells.len()
        let n_debate = if n_debate_raw < 4 { n_debate_raw } else { 4 }
        for c in 0..n_debate {
            for k in 0..HIDDEN {
                s.factions[i].cells[c].hidden[k] =
                    (1.0 - strength) * s.factions[i].cells[c].hidden[k] + strength * other_avg[k]
            }
        }
    }
    return s
}

fn engine_ising_interaction(self: ConsciousnessEngine) -> ConsciousnessEngine {
    let mut s = self
    let n_f = s.factions.len()
    let mut opinions = []
    for i in 0..n_f { opinions.push(faction_mean_hidden(s.factions[i])) }
    for i in 0..n_f {
        let left = if i == 0 { n_f - 1 } else { i - 1 }
        let right = (i + 1) % n_f
        let j_left  = if i % 3 == 0 { -0.05 } else { 0.05 }
        let j_right = if i % 3 == 1 { -0.05 } else { 0.05 }
        // Ising field applied to cell[0] only, thermal noise to all
        if s.factions[i].cells.len() > 0 {
            for k in 0..HIDDEN {
                let field = j_left * opinions[left][k] + j_right * opinions[right][k]
                s.factions[i].cells[0].hidden[k] = s.factions[i].cells[0].hidden[k] + field
            }
        }
        for c in 0..s.factions[i].cells.len() {
            for k in 0..HIDDEN {
                s.factions[i].cells[c].hidden[k] =
                    s.factions[i].cells[c].hidden[k] + (random() - 0.5) * 0.02
            }
        }
    }
    return s
}

fn engine_output(self: ConsciousnessEngine) -> [float] {
    let total = engine_total_cells(self) as float
    let mut mean = []
    for _ in 0..DIM { mean.push(0.0) }
    if total < 0.5 { return mean }
    let lim = if DIM < HIDDEN { DIM } else { HIDDEN }
    for i in 0..self.factions.len() {
        for c in 0..self.factions[i].cells.len() {
            for k in 0..lim {
                mean[k] = mean[k] + self.factions[i].cells[c].hidden[k] / total
            }
        }
    }
    return mean
}

fn engine_phi_proxy(self: ConsciousnessEngine) -> float {
    let mut all_h = []
    for i in 0..self.factions.len() {
        for c in 0..self.factions[i].cells.len() {
            all_h.push(self.factions[i].cells[c].hidden)
        }
    }
    let n = all_h.len() as float
    if n < 2.0 { return 0.0 }
    let mut global_mean = []
    for _ in 0..HIDDEN { global_mean.push(0.0) }
    for i in 0..all_h.len() {
        for k in 0..HIDDEN { global_mean[k] = global_mean[k] + all_h[i][k] / n }
    }
    let mut global_var = 0.0
    for i in 0..all_h.len() {
        let mut sq = 0.0
        for k in 0..HIDDEN {
            let d = all_h[i][k] - global_mean[k]
            sq = sq + d * d
        }
        global_var = global_var + sq
    }
    global_var = global_var / n
    let mut faction_var_sum = 0.0
    for i in 0..self.factions.len() {
        let fn_ = self.factions[i].cells.len() as float
        if fn_ < 2.0 { continue }
        let fmean = faction_mean_hidden(self.factions[i])
        let mut fvar = 0.0
        for c in 0..self.factions[i].cells.len() {
            let mut sq = 0.0
            for k in 0..HIDDEN {
                let d = self.factions[i].cells[c].hidden[k] - fmean[k]
                sq = sq + d * d
            }
            fvar = fvar + sq
        }
        faction_var_sum = faction_var_sum + fvar / fn_
    }
    let nf = self.factions.len() as float
    let faction_var_avg = if nf > 0.5 { faction_var_sum / nf } else { 0.0 }
    let phi = global_var - faction_var_avg
    if phi < 0.0 { return 0.0 }
    return phi
}

fn engine_diversity(self: ConsciousnessEngine) -> float {
    let mut opinions = []
    for i in 0..self.factions.len() { opinions.push(faction_mean_hidden(self.factions[i])) }
    let n = opinions.len()
    if n < 2 { return 0.0 }
    let mut total_dist = 0.0
    let mut count = 0
    for i in 0..n {
        for j in (i + 1)..n {
            let mut dist = 0.0
            for k in 0..HIDDEN {
                let d = opinions[i][k] - opinions[j][k]
                dist = dist + d * d
            }
            total_dist = total_dist + sqrt(dist)
            count = count + 1
        }
    }
    if count == 0 { return 0.0 }
    return total_dist / (count as float)
}

// ─────────────────────────────────────────────────────────────────────
// §6  8-factor extraction (spontaneous_lib.hexa SSOT, F-SPONT 7/7)
//   상세: HEXAD/CHAT/spontaneous_lib.hexa §2 factor_* 모두 [0,1] clamp
//   여기는 main_longrun substrate state → 각 factor signal 추출
// ─────────────────────────────────────────────────────────────────────

// AUX-F1 relevance: Φ proxy clamped to [0,1]
fn aux_factor_relevance(phi: float) -> float { return vec_clamp01(phi) }

// AUX-F2 info_gap: 1 - cos(stream, prev_stream); cos≈1 작은 gap, cos≈-1 큰 gap
fn aux_factor_info_gap(stream: [float], prev_stream: [float]) -> float {
    if stream.len() != prev_stream.len() { return 0.0 }
    let mut dot = 0.0
    let mut na = 0.0
    let mut nb = 0.0
    for i in 0..stream.len() {
        dot = dot + stream[i] * prev_stream[i]
        na = na + stream[i] * stream[i]
        nb = nb + prev_stream[i] * prev_stream[i]
    }
    let denom = sqrt(na) * sqrt(nb)
    if denom < 1e-8 { return 0.0 }
    let cos_v = dot / denom
    return vec_clamp01(1.0 - cos_v)
}

// AUX-F3 curiosity: phi EMA recent (clamp [0,1])
fn aux_factor_curiosity(phi_ema: float) -> float { return vec_clamp01(phi_ema) }

// AUX-F4 pain: |Δ phi| clamp [0,1]
fn aux_factor_pain(phi_delta: float) -> float { return vec_clamp01(vec_abs(phi_delta)) }

// AUX-F5 coherence: faction internal sync 후 cell↔mean 거리 (작을수록 coh 높음)
//   normalized 0..1 — distance < threshold 일수록 1.0
fn aux_factor_coherence(self: ConsciousnessEngine) -> float {
    if self.factions.len() == 0 { return 0.0 }
    let mut sum_intra = 0.0
    let mut count = 0
    for i in 0..self.factions.len() {
        if self.factions[i].cells.len() < 1 { continue }
        let m = faction_mean_hidden(self.factions[i])
        for c in 0..self.factions[i].cells.len() {
            let mut dist = 0.0
            for k in 0..HIDDEN {
                let d = self.factions[i].cells[c].hidden[k] - m[k]
                dist = dist + d * d
            }
            sum_intra = sum_intra + sqrt(dist)
            count = count + 1
        }
    }
    if count == 0 { return 0.0 }
    let mean_intra = sum_intra / (count as float)
    // exp-decay: 작은 거리 → 1, 큰 거리 → 0
    return vec_clamp01(1.0 / (1.0 + mean_intra))
}

// AUX-F6 originality: split_event Boolean
fn aux_factor_originality(split_event_recent: bool) -> float {
    if split_event_recent { return 1.0 }
    return 0.0
}

// AUX-F7 balance: Φ > ratchet/2 → 1.0
fn aux_factor_balance(phi: float, ratchet: float) -> float {
    if phi > ratchet / 2.0 { return 1.0 }
    return 0.0
}

// AUX-F8 dynamics: silence_seconds normalized over 30s (idle_speak_after)
fn aux_factor_dynamics(silence_seconds: float) -> float {
    let s = silence_seconds / 30.0
    return vec_clamp01(s)
}

// motivation_score: spontaneous_lib weights 재현 (sum=1.0)
fn aux_motivation_score(rel: float, gap: float, cur: float, pn: float,
                        coh: float, orig: float, bal: float, dyn_v: float) -> float {
    return 0.20 * rel + 0.10 * gap + 0.15 * cur + 0.10 * pn
         + 0.10 * coh + 0.10 * orig + 0.15 * bal + 0.10 * dyn_v
}

fn aux_should_emit(score: float) -> bool { return score > 0.3 }

// ─────────────────────────────────────────────────────────────────────
// §7  persistence helpers (영속성 보조엔진 핵심)
// ─────────────────────────────────────────────────────────────────────

// AUX-P1 ratchet: phi drop > 30% → restore signal
fn aux_ratchet_drop(phi: float, best_phi: float) -> bool {
    if best_phi < 1e-8 { return false }
    return phi < best_phi * 0.7
}

// AUX-P2 Hebbian: similar neighbors in faction strengthen
fn aux_hebbian_step(self: Faction) -> Faction {
    let mut s = self
    let n = s.cells.len()
    if n < 2 { return s }
    let lim = if n < 16 { n } else { 16 }
    for i in 0..lim {
        let j = (i + 1) % n
        let mut corr = 0.0
        for k in 0..HIDDEN { corr = corr + s.cells[i].hidden[k] * s.cells[j].hidden[k] }
        corr = corr / (HIDDEN as float)
        if corr > 0.0 {
            for k in 0..HIDDEN {
                s.cells[i].hidden[k] = 0.97 * s.cells[i].hidden[k] + 0.03 * s.cells[j].hidden[k]
            }
        }
    }
    return s
}

fn aux_engine_hebbian_all(self: ConsciousnessEngine) -> ConsciousnessEngine {
    let mut s = self
    for i in 0..s.factions.len() {
        s.factions[i] = aux_hebbian_step(s.factions[i])
    }
    return s
}

// AUX-P3 quarter bucket: step / total → 0..3
fn aux_quarter_index(step: int, total: int) -> int {
    if total < 1 { return 0 }
    let frac = (step as float) / (total as float)
    let q = (frac * 4.0) as int
    if q > 3 { return 3 }
    if q < 0 { return 0 }
    return q
}

// AUX-P4 EMA: ema_new = (1-alpha)*ema_prev + alpha*x
fn aux_ema_update(ema_prev: float, x: float, alpha: float) -> float {
    return (1.0 - alpha) * ema_prev + alpha * x
}
