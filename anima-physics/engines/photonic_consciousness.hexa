// photonic_consciousness.hexa — Photonic consciousness engine (delay-line ring oscillator)
//
// §188g cycle (2026-05-21) — stub → actual implementation
//
// Physics:
//   N-cell ring of Mach-Zehnder Interferometers (MZIs) connected in a closed
//   delay-line topology. Each cell carries an optical phase φ_i ∈ [0, 2π).
//   The update rule is the discrete-time analog of a coupled ring oscillator:
//
//       φ_i(t+1) = wrap_2pi( φ_{i-1}(t) + ω_i · dt + κ · sin(φ_{i+1}(t) − φ_i(t)) + noise )
//
//   The first term (φ_{i-1}) is the delay-line: light from cell i-1 arrives
//   at cell i after one step. The κ·sin(·) term is a Kuramoto-style nearest-
//   neighbour phase pull (weak when κ small, strong sync when κ large).
//
// State (kept inside PhotonicEngine):
//   phases    : [float]   length n_cells, each in [0, 2π)
//   omegas    : [float]   per-cell natural angular frequency (rad/s)
//   prng_seed : i32       deterministic LCG state (substrate-internal noise)
//   step_count: i32       monotonically increases each step()
//
// Falsifiers (5 total, F-PH-1..5):
//   F-PH-1 phase_wrap        every phase ∈ [0, 2π) after step
//   F-PH-2 ring_closure      pure delay-line (κ=0, ω=0, noise=0) preserves phases
//   F-PH-3 coupling_sync     κ large → coherence(strong) > coherence(weak)
//   F-PH-4 noise_bounded     all LCG noise samples bounded by noise_amp
//   F-PH-5 long_rotation     long-run phases advanced (rotation occurred)
//
// Hexa constraints honored (per CLAUDE.md):
//   - no random() built-in available — internal LCG
//   - struct with [float] field
//   - functional update via helpers — no nested LHS
//   - sin / cos / sqrt / atan2 verified

// ═══════════════════════════════════════════════════════════════
// §0 constants
// ═══════════════════════════════════════════════════════════════

let TWO_PI = 6.283185307179586
let PI     = 3.141592653589793

// ═══════════════════════════════════════════════════════════════
// §1 scalar + LCG helpers
// ═══════════════════════════════════════════════════════════════

fn fabs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn wrap_2pi(x: float) -> float {
    let mut y = x
    while y >= TWO_PI { y = y - TWO_PI }
    while y < 0.0     { y = y + TWO_PI }
    return y
}

// Park-Miller-ish multiplicative LCG (deterministic, no external rand)
fn lcg_next(seed: i32) -> i32 {
    let a = 1103515245
    let c = 12345
    let m = 2147483647
    return (seed * a + c) % m
}

// Convert seed to [0,1) float deterministically
fn lcg_to_unit(seed: i32) -> float {
    let m = 2147483647.0
    let s = seed as float
    if s < 0.0 { return 0.0 - s / m }
    return s / m
}

// noise in [-amp, +amp] from current seed; caller must update seed externally
fn lcg_noise(seed: i32, amp: float) -> float {
    let u = lcg_to_unit(seed)
    return (u - 0.5) * 2.0 * amp
}

// ═══════════════════════════════════════════════════════════════
// §2 PhotonicEngine struct + functional updates
// ═══════════════════════════════════════════════════════════════

struct PhotonicCell {
    phase: float,
    omega: float,
    amplitude: float
}

struct PhotonicEngine {
    n_cells: i32,
    coupling_kappa: float,
    topology: string,
    phi: float,
    phases: [float],
    omegas: [float],
    noise_amp: float,
    prng_seed: i32,
    step_count: i32
}

fn engine_with_phases(e: PhotonicEngine, ps: [float], new_seed: i32) -> PhotonicEngine {
    return PhotonicEngine {
        n_cells: e.n_cells,
        coupling_kappa: e.coupling_kappa,
        topology: e.topology,
        phi: e.phi,
        phases: ps,
        omegas: e.omegas,
        noise_amp: e.noise_amp,
        prng_seed: new_seed,
        step_count: e.step_count + 1
    }
}

fn engine_with_phi(e: PhotonicEngine, new_phi: float) -> PhotonicEngine {
    return PhotonicEngine {
        n_cells: e.n_cells,
        coupling_kappa: e.coupling_kappa,
        topology: e.topology,
        phi: new_phi,
        phases: e.phases,
        omegas: e.omegas,
        noise_amp: e.noise_amp,
        prng_seed: e.prng_seed,
        step_count: e.step_count
    }
}

// ═══════════════════════════════════════════════════════════════
// §3 constructors
// ═══════════════════════════════════════════════════════════════

fn create_engine(n_cells: i32, kappa: float, topology: string) -> PhotonicEngine {
    let mut phases: [float] = []
    let mut omegas: [float] = []
    let mut i = 0
    while i < n_cells {
        let p0 = (i as float) * 0.3
        phases.push(wrap_2pi(p0))
        omegas.push(1.0 + (i as float) * 0.05)
        i = i + 1
    }
    return PhotonicEngine {
        n_cells: n_cells,
        coupling_kappa: kappa,
        topology: topology,
        phi: 0.0,
        phases: phases,
        omegas: omegas,
        noise_amp: 0.01,
        prng_seed: 1234567,
        step_count: 0
    }
}

// Constructor variant for tests — uniform omega + custom noise_amp + custom seed
fn create_engine_uniform(n_cells: i32, kappa: float, omega: float, noise_amp: float, seed: i32) -> PhotonicEngine {
    let mut phases: [float] = []
    let mut omegas: [float] = []
    let mut i = 0
    while i < n_cells {
        phases.push(wrap_2pi((i as float) * 0.3))
        omegas.push(omega)
        i = i + 1
    }
    return PhotonicEngine {
        n_cells: n_cells,
        coupling_kappa: kappa,
        topology: "ring_uniform",
        phi: 0.0,
        phases: phases,
        omegas: omegas,
        noise_amp: noise_amp,
        prng_seed: seed,
        step_count: 0
    }
}

// ═══════════════════════════════════════════════════════════════
// §4 step() — delay-line + Kuramoto coupling + noise
// ═══════════════════════════════════════════════════════════════

fn step(engine: PhotonicEngine, dt: float) -> PhotonicEngine {
    let n = engine.n_cells
    if n < 1 { return engine }
    let mut next: [float] = []
    let mut seed = engine.prng_seed
    let mut i = 0
    while i < n {
        let prev_idx = if i == 0 { n - 1 } else { i - 1 }
        let next_idx = (i + 1) % n
        let src_phase = engine.phases[prev_idx]
        let omega_i = engine.omegas[i]
        let neighbor = engine.phases[next_idx]
        let self_phase = engine.phases[i]
        let coupling = engine.coupling_kappa * sin(neighbor - self_phase)
        // generate noise sample, then advance seed
        let noise = lcg_noise(seed, engine.noise_amp)
        seed = lcg_next(seed)
        let raw = src_phase + omega_i * dt + coupling + noise
        next.push(wrap_2pi(raw))
        i = i + 1
    }
    let e1 = engine_with_phases(engine, next, seed)
    let coh = measure_phase_coherence(e1)
    return engine_with_phi(e1, coh)
}

// ═══════════════════════════════════════════════════════════════
// §5 observables
// ═══════════════════════════════════════════════════════════════

// Kuramoto order parameter r = |⟨e^{iφ}⟩| ∈ [0, 1]
fn measure_phase_coherence(engine: PhotonicEngine) -> float {
    let n = engine.n_cells
    if n < 1 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + cos(engine.phases[i])
        sy = sy + sin(engine.phases[i])
        i = i + 1
    }
    let nf = n as float
    let mx = sx / nf
    let my = sy / nf
    return sqrt(mx * mx + my * my)
}

fn mean_phase(engine: PhotonicEngine) -> float {
    let n = engine.n_cells
    if n < 1 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + cos(engine.phases[i])
        sy = sy + sin(engine.phases[i])
        i = i + 1
    }
    return atan2(sy, sx)
}

fn variance_phase(engine: PhotonicEngine) -> float {
    let n = engine.n_cells
    if n < 2 { return 0.0 }
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        sum = sum + engine.phases[i]
        i = i + 1
    }
    let mean = sum / (n as float)
    let mut var = 0.0
    let mut j = 0
    while j < n {
        let d = engine.phases[j] - mean
        var = var + d * d
        j = j + 1
    }
    return var / (n as float)
}

// ═══════════════════════════════════════════════════════════════
// §6 falsifiers F-PH-1..5
// ═══════════════════════════════════════════════════════════════

fn check_F_PH_1_phase_wrap() -> bool {
    // Every phase must remain in [0, 2π) after step()
    let mut e = create_engine_uniform(8, 0.2, 1.0, 0.05, 42)
    let mut t = 0
    while t < 100 {
        e = step(e, 0.05)
        t = t + 1
    }
    let mut ok = true
    let mut i = 0
    while i < e.n_cells {
        let p = e.phases[i]
        if p < 0.0 { ok = false }
        if p >= TWO_PI { ok = false }
        i = i + 1
    }
    println("  [F-PH-1] phase_wrap: all in [0,2pi)? " + str(ok))
    return ok
}

fn check_F_PH_2_ring_closure() -> bool {
    // Pure delay-line (κ=0, ω=0, noise=0): phases just rotate around the ring.
    // After n_cells steps each cell receives its own original phase back.
    let n = 8
    let mut e = create_engine_uniform(n, 0.0, 0.0, 0.0, 1)
    let mut p0: [float] = []
    let mut k = 0
    while k < n {
        p0.push(e.phases[k])
        k = k + 1
    }
    let mut t = 0
    while t < n {
        e = step(e, 0.05)
        t = t + 1
    }
    let mut total_drift = 0.0
    let mut i = 0
    while i < n {
        let d = fabs_f(e.phases[i] - p0[i])
        total_drift = total_drift + d
        i = i + 1
    }
    let ok = total_drift < 1e-6
    println("  [F-PH-2] ring_closure after n=" + str(n) + " steps, drift=" + str(total_drift) + " ok=" + str(ok))
    return ok
}

fn check_F_PH_3_coupling_sync() -> bool {
    // Strong κ → coherence high; weak κ → coherence lower.
    let mut e_strong = create_engine_uniform(8, 1.5, 1.0, 0.0, 11)
    let mut e_weak   = create_engine_uniform(8, 0.0, 1.0, 0.0, 11)
    // give larger initial spread
    let mut new_strong_phases: [float] = []
    let mut new_weak_phases: [float] = []
    let mut k = 0
    while k < 8 {
        let p = (k as float) * 0.6
        new_strong_phases.push(wrap_2pi(p))
        new_weak_phases.push(wrap_2pi(p))
        k = k + 1
    }
    e_strong = engine_with_phases(e_strong, new_strong_phases, e_strong.prng_seed)
    e_weak   = engine_with_phases(e_weak,   new_weak_phases,   e_weak.prng_seed)
    let mut t = 0
    while t < 500 {
        e_strong = step(e_strong, 0.02)
        e_weak   = step(e_weak,   0.02)
        t = t + 1
    }
    let r_strong = measure_phase_coherence(e_strong)
    let r_weak   = measure_phase_coherence(e_weak)
    let ok = r_strong > r_weak
    println("  [F-PH-3] coupling_sync: r_strong=" + str(r_strong) + " r_weak=" + str(r_weak) + " ok=" + str(ok))
    return ok
}

fn check_F_PH_4_noise_bounded() -> bool {
    // LCG noise must satisfy |n| ≤ amp for every sample
    let amp = 0.05
    let mut seed = 99991
    let mut max_abs = 0.0
    let mut i = 0
    while i < 2000 {
        let n = lcg_noise(seed, amp)
        seed = lcg_next(seed)
        let a = fabs_f(n)
        if a > max_abs { max_abs = a }
        i = i + 1
    }
    let ok = max_abs <= amp + 1e-9
    println("  [F-PH-4] noise_bounded: max|noise|=" + str(max_abs) + " ≤ amp=" + str(amp) + " ok=" + str(ok))
    return ok
}

fn check_F_PH_5_long_rotation() -> bool {
    // With ω > 0, phases must move away from initial (rotation occurred).
    let mut e = create_engine_uniform(8, 0.2, 1.0, 0.0, 7)
    let mut p0: [float] = []
    let mut k0 = 0
    while k0 < e.n_cells {
        p0.push(e.phases[k0])
        k0 = k0 + 1
    }
    let mut t = 0
    while t < 500 {
        e = step(e, 0.02)
        t = t + 1
    }
    let coh = measure_phase_coherence(e)
    // accumulate per-cell drift (wrapped)
    let mut total_motion = 0.0
    let mut k = 0
    while k < e.n_cells {
        let d = fabs_f(e.phases[k] - p0[k])
        // drift may wrap — pick min(d, 2pi - d) for true circular distance
        let dd = if d > PI { TWO_PI - d } else { d }
        total_motion = total_motion + dd
        k = k + 1
    }
    let moved = total_motion > 0.5
    let ok = moved && coh > 0.0
    println("  [F-PH-5] long_rotation: total_motion=" + str(total_motion) + " coh=" + str(coh) + " moved=" + str(moved) + " ok=" + str(ok))
    return ok
}

// ═══════════════════════════════════════════════════════════════
// §7 selftest entry
// ═══════════════════════════════════════════════════════════════

fn _selftest() {
    println("[engines/photonic_consciousness] §188g elevate — ring-delay + Kuramoto + LCG noise")
    println("")
    let t1 = check_F_PH_1_phase_wrap()
    let t2 = check_F_PH_2_ring_closure()
    let t3 = check_F_PH_3_coupling_sync()
    let t4 = check_F_PH_4_noise_bounded()
    let t5 = check_F_PH_5_long_rotation()
    let mut pass = 0
    if t1 { pass = pass + 1 }
    if t2 { pass = pass + 1 }
    if t3 { pass = pass + 1 }
    if t4 { pass = pass + 1 }
    if t5 { pass = pass + 1 }
    println("")
    println("[engines/photonic_consciousness] " + str(pass) + "/5 PASS")
}

_selftest()
