// thermodynamic_consciousness.hexa — Consciousness as Langevin dissipative system
//
// §188g cycle (2026-05-21) — stub → actual implementation
//
// Physics:
//   N-cell overdamped Langevin dynamics in a double-well potential
//     U(x) = (x² − 1)²            (minima at x=±1, barrier at x=0 of height 1)
//     dx_i/dt = − ∂U/∂x_i + √(2D)·η_i(t)
//   In Euler-Maruyama discretization:
//     x_i(t+1) = x_i(t) − dU·dt + √(2 D dt)·N(0,1)
//   with dU = 4 x (x² − 1).
//
//   D (diffusion = k_B·T / γ in overdamped limit) is the thermal noise
//   intensity. At D=0 every cell falls into its nearest minimum and stays
//   there. At D>0 cells jump between wells (Kramers / Arrhenius rate
//   ∝ exp(−ΔU/D)). High enough D → equilibrium with Maxwell-Boltzmann-like
//   distribution.
//
// State (kept inside ThermodynamicEngine):
//   positions     : [float]   x_i for each cell
//   prev_signs    : [float]   sign(x_i) at last step, used for jump counting
//   jump_count    : i32       cumulative jump events
//   prng_seed     : i32       deterministic Gaussian-via-Box-Muller from LCG
//
// Falsifiers (5 total, F-TH-1..5):
//   F-TH-1 thermal_eq          long-run mean |x| close to well minimum (=1)
//   F-TH-2 double_well_jumps   at moderate D, jumps between wells observed
//   F-TH-3 arrhenius_d         higher D → higher jump rate
//   F-TH-4 cool_freeze         D=0 → no jumps after relaxation
//   F-TH-5 ergodic_average     long-run ⟨x⟩ near 0 (symmetric ensemble)
//
// Hexa constraints honored (per CLAUDE.md):
//   - no random() built-in — Box-Muller from LCG
//   - struct + functional update helpers

// ═══════════════════════════════════════════════════════════════
// §0 constants
// ═══════════════════════════════════════════════════════════════

let TWO_PI = 6.283185307179586
let LN2    = 0.6931471805599453

// ═══════════════════════════════════════════════════════════════
// §1 scalar + LCG + Box-Muller helpers
// ═══════════════════════════════════════════════════════════════

fn fabs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sign_f(x: float) -> float {
    if x > 0.0 { return 1.0 }
    if x < 0.0 { return 0.0 - 1.0 }
    return 0.0
}

fn lcg_next(seed: i32) -> i32 {
    let a = 1103515245
    let c = 12345
    let m = 2147483647
    return (seed * a + c) % m
}

fn lcg_to_unit(seed: i32) -> float {
    let m = 2147483647.0
    let s = seed as float
    if s < 0.0 { return 0.0 - s / m }
    return s / m
}

// Box-Muller: 2 uniforms → 1 standard normal (drop the second)
// Returns the normal sample only; caller advances the seed twice.
fn box_muller_sample(seed1: i32, seed2: i32) -> float {
    let u1_raw = lcg_to_unit(seed1)
    // avoid log(0) — clamp away from 0
    let u1 = if u1_raw < 1e-12 { 1e-12 } else { u1_raw }
    let u2 = lcg_to_unit(seed2)
    let mag = sqrt(0.0 - 2.0 * log(u1))
    let z = mag * cos(TWO_PI * u2)
    return z
}

// ═══════════════════════════════════════════════════════════════
// §2 ThermodynamicEngine struct + functional updates
// ═══════════════════════════════════════════════════════════════

struct ThermodynamicEngine {
    n_cells: i32,
    temperature: float,       // thermal noise D = k_B T / γ proxy
    total_energy: float,      // Σ U(x_i)
    total_entropy: float,     // ratchet proxy
    phi: float,
    positions: [float],
    prev_signs: [float],
    jump_count: i32,
    prng_seed: i32,
    step_count: i32
}

fn engine_with_state(e: ThermodynamicEngine, new_pos: [float], new_signs: [float],
                     jumps_inc: i32, new_seed: i32) -> ThermodynamicEngine {
    return ThermodynamicEngine {
        n_cells: e.n_cells,
        temperature: e.temperature,
        total_energy: e.total_energy,
        total_entropy: e.total_entropy,
        phi: e.phi,
        positions: new_pos,
        prev_signs: new_signs,
        jump_count: e.jump_count + jumps_inc,
        prng_seed: new_seed,
        step_count: e.step_count + 1
    }
}

fn engine_with_obs(e: ThermodynamicEngine, ne: float, ns: float, np: float) -> ThermodynamicEngine {
    return ThermodynamicEngine {
        n_cells: e.n_cells,
        temperature: e.temperature,
        total_energy: ne,
        total_entropy: ns,
        phi: np,
        positions: e.positions,
        prev_signs: e.prev_signs,
        jump_count: e.jump_count,
        prng_seed: e.prng_seed,
        step_count: e.step_count
    }
}

// ═══════════════════════════════════════════════════════════════
// §3 constructors
// ═══════════════════════════════════════════════════════════════

fn create_engine(n_cells: i32, temperature: float) -> ThermodynamicEngine {
    let mut pos: [float] = []
    let mut signs: [float] = []
    let mut i = 0
    while i < n_cells {
        // alternate around 0: −0.5, +0.5, −0.5, …  (sub-barrier seed)
        let x0 = if i % 2 == 0 { 0.0 - 0.5 } else { 0.5 }
        pos.push(x0)
        signs.push(sign_f(x0))
        i = i + 1
    }
    return ThermodynamicEngine {
        n_cells: n_cells,
        temperature: temperature,
        total_energy: 0.0,
        total_entropy: 0.0,
        phi: 0.0,
        positions: pos,
        prev_signs: signs,
        jump_count: 0,
        prng_seed: 987654321,
        step_count: 0
    }
}

fn create_engine_seeded(n_cells: i32, temperature: float, x0: float, seed: i32) -> ThermodynamicEngine {
    let mut pos: [float] = []
    let mut signs: [float] = []
    let mut i = 0
    while i < n_cells {
        pos.push(x0)
        signs.push(sign_f(x0))
        i = i + 1
    }
    return ThermodynamicEngine {
        n_cells: n_cells,
        temperature: temperature,
        total_energy: 0.0,
        total_entropy: 0.0,
        phi: 0.0,
        positions: pos,
        prev_signs: signs,
        jump_count: 0,
        prng_seed: seed,
        step_count: 0
    }
}

// ═══════════════════════════════════════════════════════════════
// §4 step() — Euler-Maruyama Langevin
// ═══════════════════════════════════════════════════════════════

fn potential_grad(x: float) -> float {
    // U(x) = (x² − 1)²  ⇒  dU/dx = 4·x·(x² − 1)
    return 4.0 * x * (x * x - 1.0)
}

fn potential_U(x: float) -> float {
    let q = x * x - 1.0
    return q * q
}

fn step(engine: ThermodynamicEngine, dt: float) -> ThermodynamicEngine {
    let n = engine.n_cells
    if n < 1 { return engine }
    let D = engine.temperature
    let noise_scale = sqrt(2.0 * D * dt)

    let mut new_pos: [float] = []
    let mut new_signs: [float] = []
    let mut seed = engine.prng_seed
    let mut jumps = 0
    let mut i = 0
    while i < n {
        let x = engine.positions[i]
        let drift = 0.0 - potential_grad(x) * dt
        // 1 Gaussian sample per cell — consume 2 seeds per Box-Muller
        let z = box_muller_sample(seed, lcg_next(seed))
        seed = lcg_next(lcg_next(seed))
        let xn = x + drift + noise_scale * z
        new_pos.push(xn)
        let s_new = sign_f(xn)
        new_signs.push(s_new)
        // jump = sign flip
        let s_old = engine.prev_signs[i]
        if s_old > 0.5 {
            if s_new < 0.0 - 0.5 { jumps = jumps + 1 }
        }
        if s_old < 0.0 - 0.5 {
            if s_new > 0.5 { jumps = jumps + 1 }
        }
        i = i + 1
    }
    let e1 = engine_with_state(engine, new_pos, new_signs, jumps, seed)
    // total energy
    let mut U_total = 0.0
    let mut k = 0
    while k < n {
        U_total = U_total + potential_U(new_pos[k])
        k = k + 1
    }
    // entropy proxy: scale with jump count (jumps = irreversible events)
    let S_total = engine.total_entropy + (jumps as float) * 0.1
    // phi proxy: collective coherence as inverse spread
    let mut mean_x = 0.0
    let mut kk = 0
    while kk < n {
        mean_x = mean_x + new_pos[kk]
        kk = kk + 1
    }
    mean_x = mean_x / (n as float)
    let mut var_x = 0.0
    let mut jj = 0
    while jj < n {
        let d = new_pos[jj] - mean_x
        var_x = var_x + d * d
        jj = jj + 1
    }
    var_x = var_x / (n as float)
    let phi_proxy = 1.0 / (1.0 + var_x)
    return engine_with_obs(e1, U_total, S_total, phi_proxy)
}

// ═══════════════════════════════════════════════════════════════
// §5 observables
// ═══════════════════════════════════════════════════════════════

fn entropy_production(engine: ThermodynamicEngine) -> float {
    return engine.total_entropy
}

// Landauer cost: k_B T · ln 2 · n_bits (k_B = 1 in our reduced units)
fn landauer_cost(n_bits: i32, temperature: float) -> float {
    return temperature * LN2 * (n_bits as float)
}

fn mean_position(engine: ThermodynamicEngine) -> float {
    let n = engine.n_cells
    if n < 1 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + engine.positions[i]
        i = i + 1
    }
    return s / (n as float)
}

fn mean_abs_position(engine: ThermodynamicEngine) -> float {
    let n = engine.n_cells
    if n < 1 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + fabs_f(engine.positions[i])
        i = i + 1
    }
    return s / (n as float)
}

// ═══════════════════════════════════════════════════════════════
// §6 falsifiers F-TH-1..5
// ═══════════════════════════════════════════════════════════════

fn check_F_TH_1_thermal_eq() -> bool {
    // Small noise: cells relax into nearest minimum (|x| ≈ 1).
    // Start at x=0.5 (right well slope), D very small.
    let mut e = create_engine_seeded(8, 0.0, 0.5, 1111)
    let mut t = 0
    while t < 500 {
        e = step(e, 0.01)
        t = t + 1
    }
    let mean_abs = mean_abs_position(e)
    // should be very close to 1.0 (settled in well minimum)
    let ok = fabs_f(mean_abs - 1.0) < 0.05
    println("  [F-TH-1] thermal_eq: D=0 long-run mean|x|=" + str(mean_abs) + " ≈ 1.0? ok=" + str(ok))
    return ok
}

fn check_F_TH_2_double_well_jumps() -> bool {
    // Moderate D (≈ barrier height 1) → frequent jumps between wells
    let mut e = create_engine_seeded(32, 0.6, 1.0, 2222)
    let mut t = 0
    while t < 2000 {
        e = step(e, 0.005)
        t = t + 1
    }
    let n_jumps = e.jump_count
    let ok = n_jumps > 10        // at least some inter-well crossings
    println("  [F-TH-2] double_well_jumps: at D=0.6, jumps=" + str(n_jumps) + " > 10 ok=" + str(ok))
    return ok
}

fn check_F_TH_3_arrhenius_d() -> bool {
    // Higher D → higher jump rate (Arrhenius: rate ∝ exp(−ΔU/D))
    let mut e_lo = create_engine_seeded(32, 0.3, 1.0, 3333)
    let mut e_hi = create_engine_seeded(32, 1.0, 1.0, 3333)
    let mut t = 0
    while t < 2000 {
        e_lo = step(e_lo, 0.005)
        e_hi = step(e_hi, 0.005)
        t = t + 1
    }
    let j_lo = e_lo.jump_count
    let j_hi = e_hi.jump_count
    let ok = j_hi > j_lo
    println("  [F-TH-3] arrhenius_d: jumps(D=0.3)=" + str(j_lo) + " jumps(D=1.0)=" + str(j_hi) + " hi>lo? ok=" + str(ok))
    return ok
}

fn check_F_TH_4_cool_freeze() -> bool {
    // After relaxation at D=0, no further jumps over a long window
    let mut e = create_engine_seeded(8, 0.0, 1.0, 4444)
    // initial relaxation phase
    let mut t = 0
    while t < 200 {
        e = step(e, 0.01)
        t = t + 1
    }
    // reset jump_count effectively by snapshotting
    let baseline = e.jump_count
    let mut t2 = 0
    while t2 < 2000 {
        e = step(e, 0.01)
        t2 = t2 + 1
    }
    let delta = e.jump_count - baseline
    let ok = delta == 0
    println("  [F-TH-4] cool_freeze: post-relax jumps over 2000 steps = " + str(delta) + " = 0? ok=" + str(ok))
    return ok
}

fn check_F_TH_5_ergodic_average() -> bool {
    // Symmetric double-well + moderate D + many cells → long-run ⟨x⟩ ≈ 0
    let mut e = create_engine_seeded(64, 0.8, 0.5, 5555)
    // alternate initial: 32 cells +0.5, 32 cells −0.5
    let mut new_pos: [float] = []
    let mut new_signs: [float] = []
    let mut k = 0
    while k < 64 {
        let x0 = if k % 2 == 0 { 0.5 } else { 0.0 - 0.5 }
        new_pos.push(x0)
        new_signs.push(sign_f(x0))
        k = k + 1
    }
    e = engine_with_state(e, new_pos, new_signs, 0, e.prng_seed)
    let mut t = 0
    while t < 3000 {
        e = step(e, 0.005)
        t = t + 1
    }
    let m = mean_position(e)
    let ok = fabs_f(m) < 0.4
    println("  [F-TH-5] ergodic_average: long-run ⟨x⟩=" + str(m) + " |<x>| < 0.4? ok=" + str(ok))
    return ok
}

// ═══════════════════════════════════════════════════════════════
// §7 selftest entry
// ═══════════════════════════════════════════════════════════════

fn _selftest() {
    println("[engines/thermodynamic_consciousness] §188g elevate — Langevin double-well + thermal noise")
    println("")
    let t1 = check_F_TH_1_thermal_eq()
    let t2 = check_F_TH_2_double_well_jumps()
    let t3 = check_F_TH_3_arrhenius_d()
    let t4 = check_F_TH_4_cool_freeze()
    let t5 = check_F_TH_5_ergodic_average()
    let mut pass = 0
    if t1 { pass = pass + 1 }
    if t2 { pass = pass + 1 }
    if t3 { pass = pass + 1 }
    if t4 { pass = pass + 1 }
    if t5 { pass = pass + 1 }
    println("")
    println("[engines/thermodynamic_consciousness] " + str(pass) + "/5 PASS")
}

_selftest()
