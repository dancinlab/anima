# .hexarc — anima project hexa runtime config
#
# Forward-looking spec (per hexa-lang RFC 026 draft, incoming/rfc_drafts_2026_05_12/).
# Once RFC 026 lands, this file is auto-loaded at hexa.real startup.
# Until then: documentation of intended config + manually sourced as needed.

[lang]
# Host-aware stdlib path. $HEXA_HOME resolves per-host:
#   Mac:    /Users/ghost/core/hexa-lang/stdlib
#   aiden:  /home/aiden/core/hexa-lang/stdlib
#   summer: /home/summer/core/hexa-lang/stdlib  (or /home/summer/mac_home/core/hexa-lang/stdlib via sshfs)
stdlib_path = "$HEXA_LANG_HOME/stdlib"

# Project-local hexa scripts (importable as "./tool/..." or stripped)
project_imports = ["./tool", "./tool/hexa_native", "./scripts"]

[mem]
# anima native inference loads 570MB safetensors → ~9GB RSS (pre-RFC 025).
# Cap raised to avoid OOM-cap-exceeded at every load.
# Will drop to ~768MB once RFC 025 (zero-copy mmap) lands.
default_cap_mb = 12000

[dispatcher]
# anima cycle 7 hexa-native lane: prefer local (Mac) execution.
# Override per-invocation with HEXA_DISPATCH=remote.
prefer_local = false   # Mac binary always dispatches; honest about current behavior
diagnostic = true      # emit `[hexa-runtime] dispatching to <host>` (per RFC 028)

[anima]
# anima-specific paths (consumed by tool/hexa_native/*.hexa)
ckpt_dir_phase1a1 = "$HOME/core/anima/state/anima_phase1a1_color_cosmology_2026_05_12/ckpts"
ckpt_dir_substrate_a = "$HOME/.cache/anima/clm_v5_remapped/phase2_cotrain_engine_ag/ckpts"

# Host-aware aliases for cross-host sshfs mounts (mac_home pattern):
mac_home_aiden = "/home/aiden/mac_home"
mac_home_summer = "/home/summer/mac_home"

# Default ckpt for hexa-native chat (matches anima_chat.py DEFAULT_CKPT chain order)
default_ckpt = "$anima.ckpt_dir_phase1a1/ckpt_phase1a1_sft.safetensors"
