// consciousness_engine_fork.hexa — B1 milestone skeleton
//
// ConsciousnessEngine 3-fork dispatcher.
//
// Input  : phi (Φ scalar · 0..1), tension (W envelope · 0..1), faction (E ratchet · 0..1)
// Output : map {motor, speech, pain} 3-channel (each 0..1)
//
// B1 = thin dispatch skeleton (linear-combo rule). Real wiring depends on:
//   B2 ESP32 SimBody  (motor)
//   B3 ROS2 + Gazebo  (motor + sim2real)
//   B4 Chip Direct    (latency-0 motor)
//   B5 Sensors loop   (closed proprio modulating these scalars)
//
// The skeleton is deliberately simple — substrate-native E ratchet drives speech,
// W tension drives motor, low-Φ surfaces pain (E ratchet inverse).
//
// Smoke test: consciousness_engine_fork_smoke.hexa (3 falsifier cases F-MOTOR/SPEECH/PAIN-ISOLATE).
//
// args() canonical per hexa-lang stdlib (NOT sys_argv — PR #1372 교훈).

pure fn clamp01(x: float) -> float {
    if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }
}

// 3-fork dispatcher.
//
// motor  = clamp01(tension * 0.7 + phi * 0.3)
//   tension dominant -> physical action urgency
// speech = clamp01(faction * 0.6 + phi * 0.4)
//   faction (E ratchet) dominant -> social / linguistic emit
// pain   = clamp01(1.0 - phi)
//   low Φ -> high pain (substrate dissonance · D1 nociception)
pub fn consciousness_engine_fork(phi: float, tension: float, faction: float) -> map {
    let motor = clamp01(tension * 0.7 + phi * 0.3)
    let speech = clamp01(faction * 0.6 + phi * 0.4)
    let pain = clamp01(1.0 - phi)
    #{
        "motor": motor,
        "speech": speech,
        "pain": pain
    }
}

// Optional CLI driver — `hexa run BODY/engine/consciousness_engine_fork.hexa <phi> <tension> <faction>`
fn main() {
    let a = args()
    if len(a) >= 4 {
        let phi = parse_float(a[1])
        let tension = parse_float(a[2])
        let faction = parse_float(a[3])
        let out = consciousness_engine_fork(phi, tension, faction)
        print("motor=" + str(out["motor"]) + " speech=" + str(out["speech"]) + " pain=" + str(out["pain"]))
    }
}
