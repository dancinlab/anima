// BUG 1 reproducer — hexa 0.1.0-dispatch: a `while` loop mis-compiles to
// a NON-TERMINATING loop. `hexa build` succeeds; the native binary hangs
// (timeout, exit 124) and prints nothing. `for i in 0..N` range loops
// compile + run correctly, so the defect is specific to `while` codegen.
// Confirmed on linux pool hosts aiden + summer. (C-PORT M3 blocker #1.)
fn main() {
    let kk = 0
    while kk < 4 {
        kk = kk + 1
    }
    println("kk=" + str(kk))   // expected: kk=4 ; actual: hangs, no output
}
