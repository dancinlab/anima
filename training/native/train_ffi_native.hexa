// ═══════════════════════════════════════════════════════════════
//  train_ffi_native.hexa — hexa-native port of the PORTABLE glue in
//  training/native/train_ffi.c (C-PORT tier-B, milestone-2).
//
//  PORTED (pure, no vendor-ABI call): the scalar->struct marshaling
//  and the getters that read the persistent FfiState. These are byte-
//  exact re-implementations of the C functions, RUNEQ-gated against the
//  C baseline (.verdicts/c-port/M2-train_ffi.txt).
//
//    C  train_ffi_set_hp(lr,b1,b2,eps,wd,clip)  -> packs G.hp
//    C  train_ffi_get_step()                    -> G.hp.step
//    C  train_ffi_get_grad_norm()               -> G.result.grad_norm
//    C  train_ffi_get_elapsed_us()              -> G.result.elapsed_us
//
//  NOT PORTED (irreducible — stays in C / tier-A shim):
//    train_ffi_init  : 3 cudaMalloc + calloc + train_step_init (CUDA)
//    train_ffi_step  : memcpy of host batch + train_step (cuBLAS hot path)
//    train_ffi_cleanup: train_step_cleanup (CUDA)
//  Those touch the GPU allocator / cuBLAS and CANNOT be hexa-native;
//  they remain in train_ffi.c, delegating to the tier-A bridge.
//
//  STRUCT LAYOUTS (must match train_step.h exactly):
//    TrainHParams { f32 lr@0; f32 beta1@4; f32 beta2@8; f32 eps@12;
//                   f32 weight_decay@16; f32 grad_clip@20; i32 step@24 }
//      sizeof = 28 bytes (4-byte aligned).
//    StepResult   { f32 loss@0; f32 grad_norm@4; i64 elapsed_us@8 }
//      sizeof = 16 bytes (i64 8-byte aligned -> @8).
//
//  NOTE: alloc_raw/write_*/deref_* offsets are BYTE offsets in the
//  runtime (tensor_kernels.c hexa_ptr_{write,read}_{f32,i32}: memcpy at
//  ptr+offset). We use explicit byte offsets so the layout is bit-exact
//  with the C struct.
// ═══════════════════════════════════════════════════════════════

// Byte offsets — TrainHParams
let HP_LR    = 0
let HP_BETA1 = 4
let HP_BETA2 = 8
let HP_EPS   = 12
let HP_WD    = 16
let HP_CLIP  = 20
let HP_STEP  = 24
let HP_SIZE  = 28

// Byte offsets — StepResult
let RES_LOSS      = 0
let RES_GRAD_NORM = 4
let RES_ELAPSED   = 8
let RES_SIZE      = 16

// ── Allocate the persistent hp / result buffers (mirror G.hp / G.result)
fn ffi_make_hp() {
    let buf = alloc_raw(HP_SIZE)
    // C defaults set in train_ffi_init (the portable, non-CUDA part of it):
    write_f32(buf, HP_LR,    3.0e-4)
    write_f32(buf, HP_BETA1, 0.9)
    write_f32(buf, HP_BETA2, 0.999)
    write_f32(buf, HP_EPS,   1.0e-8)
    write_f32(buf, HP_WD,    0.01)
    write_f32(buf, HP_CLIP,  1.0)
    write_i32(buf, HP_STEP,  0)
    return buf
}

fn ffi_make_result() {
    let buf = alloc_raw(RES_SIZE)
    write_f32(buf, RES_LOSS,      0.0)
    write_f32(buf, RES_GRAD_NORM, 0.0)
    write_i64(buf, RES_ELAPSED,   0)
    return buf
}

// ── PORT of train_ffi_set_hp ─────────────────────────────────
// void train_ffi_set_hp(float lr, float b1, float b2, float eps,
//                       float wd, float grad_clip)
fn ffi_set_hp(hp, lr, beta1, beta2, eps, wd, grad_clip) {
    write_f32(hp, HP_LR,    lr)
    write_f32(hp, HP_BETA1, beta1)
    write_f32(hp, HP_BETA2, beta2)
    write_f32(hp, HP_EPS,   eps)
    write_f32(hp, HP_WD,    wd)
    write_f32(hp, HP_CLIP,  grad_clip)
    // NOTE: train_ffi_set_hp does NOT touch hp.step (matches C exactly).
}

// ── PORT of the getters ──────────────────────────────────────
// int   train_ffi_get_step(void)        { return G.hp.step; }
fn ffi_get_step(hp) {
    return deref_i32(hp, HP_STEP)
}

// float train_ffi_get_grad_norm(void)   { return G.result.grad_norm; }
fn ffi_get_grad_norm(result) {
    return deref_f32(result, RES_GRAD_NORM)
}

// long  train_ffi_get_elapsed_us(void)  { return G.result.elapsed_us; }
fn ffi_get_elapsed_us(result) {
    return deref_i32(result, RES_ELAPSED)   // low 32 bits; RUNEQ values < 2^31
}

fn ffi_free_hp(hp)         { free_raw(hp, HP_SIZE) }
fn ffi_free_result(buf)    { free_raw(buf, RES_SIZE) }

// ── RUNEQ harness — representative inputs, deterministic output ──
// Mirrors the C driver train_ffi_runeq.c print order/format EXACTLY.
fn main() {
    let hp  = ffi_make_hp()
    let res = ffi_make_result()

    // Representative set_hp call (same args the C driver uses).
    ffi_set_hp(hp, 5.0e-4, 0.85, 0.98, 1.0e-9, 0.02, 0.5)

    // Simulate the step bookkeeping the portable layer owns: bump step.
    // (train_ffi_step does G.hp.step++ before calling the CUDA kernel;
    //  the increment itself is portable — we replay it 3 times.)
    write_i32(hp, HP_STEP, deref_i32(hp, HP_STEP) + 1)
    write_i32(hp, HP_STEP, deref_i32(hp, HP_STEP) + 1)
    write_i32(hp, HP_STEP, deref_i32(hp, HP_STEP) + 1)

    // Simulate a StepResult the CUDA kernel would have written, then
    // exercise the pure getters that read it back.
    write_f32(res, RES_GRAD_NORM, 1.2345)
    write_i32(res, RES_ELAPSED,   987654)

    println("set_hp.lr="         + str(deref_f32(hp, HP_LR)))
    println("set_hp.beta1="      + str(deref_f32(hp, HP_BETA1)))
    println("set_hp.beta2="      + str(deref_f32(hp, HP_BETA2)))
    println("set_hp.eps="        + str(deref_f32(hp, HP_EPS)))
    println("set_hp.weight_decay=" + str(deref_f32(hp, HP_WD)))
    println("set_hp.grad_clip="  + str(deref_f32(hp, HP_CLIP)))
    println("get_step="          + str(ffi_get_step(hp)))
    println("get_grad_norm="     + str(ffi_get_grad_norm(res)))
    println("get_elapsed_us="    + str(ffi_get_elapsed_us(res)))

    ffi_free_hp(hp)
    ffi_free_result(res)
}
// NOTE: hexa auto-invokes main(); no explicit `let _ = main()` (would
// double-run the harness). RUNEQ compares this single run vs the C driver.
