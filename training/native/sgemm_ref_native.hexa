// ═══════════════════════════════════════════════════════════════
//  sgemm_ref_native.hexa — hexa-native port of the PORTABLE scalar
//  GEMM reference embedded in the tier-C smoke harnesses
//  (training/hxblas_cuda_smoke.c + hxblas_cuda_smoke_large.c).
//
//  C-PORT milestone-3 prerequisite: the smoke harnesses' reason-to-exist
//  is the CPU reference matmul that they diff cuBLAS against. That
//  reference is PURE LOGIC — NO vendor-ABI call (no cuBLAS/cuda/cblas).
//  Only the `extern hxblas_sgemm` half is vendor; the C_ref computation,
//  the deterministic input pattern, and the max_err reduction are
//  portable. This file re-implements that portable core hexa-native,
//  RUNEQ-gated byte/value-exact against the C reference
//  (.verdicts/c-port/M3-sgemm_ref.txt).
//
//  PORTED (pure — exact mirror of hxblas_cuda_smoke_large.c run_case's
//  non-vendor half):
//    - deterministic pattern   A[i] = 0.02 * ((i*37)%131 - 65)
//                              B[i] = 0.02 * ((i*53)%127 - 63)
//    - scalar reference matmul C_ref = op(A) · op(B)  honouring transA/transB
//    - fp32 accumulation       (running sum rounded to f32 each step, so
//                               the rounding matches C's `float s`)
//
//  NOT PORTED (irreducible — stays in C / tier-A shim):
//    - hxblas_sgemm            : the cuBLAS / Accelerate-cblas dispatch
//                                that the smoke diffs against. That IS the
//                                vendor bridge (tier-A). The hexa port
//                                supplies the REFERENCE side only.
//
//  fp32-EXACTNESS NOTE: hexa Float is f64. C accumulates in `float`
//  (fp32) and rounds after every `s += a*b`. To be byte-exact we write
//  the running sum into a 4-byte raw slot and read it back (write_f32 /
//  deref_f32 = memcpy round through IEEE-754 binary32), reproducing C's
//  per-step fp32 rounding. Inputs are stored f32 too, so a/b read back
//  with C-identical values.
//
//  alloc_raw/write_f32/deref_f32 offsets are BYTE offsets (memcpy at
//  ptr+offset), so a flat f32 array at logical index k lives at byte k*4.
// ═══════════════════════════════════════════════════════════════

// ── deterministic input fill (mirrors C calloc + the i*mul pattern) ──
// A[i] = 0.02 * (float)((i*37)%131 - 65)
fn fill_a(buf, count) {
    let i = 0
    while i < count {
        write_f32(buf, i * 4, 0.02 * to_float((i * 37) % 131 - 65))
        i = i + 1
    }
}

// B[i] = 0.02 * (float)((i*53)%127 - 63)
fn fill_b(buf, count) {
    let i = 0
    while i < count {
        write_f32(buf, i * 4, 0.02 * to_float((i * 53) % 127 - 63))
        i = i + 1
    }
}

// Round a value to IEEE-754 binary32 by a raw f32 store/load round-trip.
fn round_f32(slot, v) {
    write_f32(slot, 0, v)
    return deref_f32(slot, 0)
}

// ── scalar reference matmul honouring transpose, fp32 accumulate ──
// Mirror of hxblas_cuda_smoke_large.c run_case's reference loop:
//   for i in M: for j in N: s=0; for k in K:
//       a = transA ? A[k*M+i] : A[i*K+k]
//       b = transB ? B[j*K+k] : B[k*N+j]
//       s += a*b
//   Cref[i*N+j] = s
// `s` is fp32 in C (rounds each += ); we round through `acc` slot.
fn sgemm_ref(cref, a, b, m, n, k, transA, transB, acc) {
    let i = 0
    while i < m {
        let j = 0
        while j < n {
            // fp32 accumulator, reset per (i,j)
            let s = round_f32(acc, 0.0)
            let kk = 0
            while kk < k {
                let av = 0.0
                if transA == 1 {
                    av = deref_f32(a, (kk * m + i) * 4)
                } else {
                    av = deref_f32(a, (i * k + kk) * 4)
                }
                let bv = 0.0
                if transB == 1 {
                    bv = deref_f32(b, (j * k + kk) * 4)
                } else {
                    bv = deref_f32(b, (kk * n + j) * 4)
                }
                // s += a*b  with fp32 rounding after the add (matches C `float s`)
                s = round_f32(acc, s + round_f32(acc, av * bv))
                kk = kk + 1
            }
            write_f32(cref, (i * n + j) * 4, s)
            j = j + 1
        }
        i = i + 1
    }
}

// abs for hexa Float
fn fabs(x) {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── one case: fill, reference-matmul, print a deterministic checksum ──
// The smoke's vendor half (hxblas_sgemm) is NOT run here; the RUNEQ
// compares the REFERENCE matmul output, which is the portable surface.
// We print, per case, the same identifying fields the C smoke prints
// (M N K tA tB) plus a value-exact summary of C_ref: its sum and its
// max abs element (both fp32-rounded), which together pin every element
// the matmul produced. The C RUNEQ driver prints the identical summary.
fn run_case(m, n, k, transA, transB) {
    let rowsA = m
    let colsA = k
    if transA == 1 { rowsA = k  colsA = m }
    let rowsB = k
    let colsB = n
    if transB == 1 { rowsB = n  colsB = k }

    let a    = alloc_raw(rowsA * colsA * 4)
    let b    = alloc_raw(rowsB * colsB * 4)
    let cref = alloc_raw(m * n * 4)
    let acc  = alloc_raw(4)

    fill_a(a, rowsA * colsA)
    fill_b(b, rowsB * colsB)
    sgemm_ref(cref, a, b, m, n, k, transA, transB, acc)

    // value-exact summary of the reference output, fp32-accumulated to
    // mirror a C summary computed the same way.
    let sum = round_f32(acc, 0.0)
    let maxabs = 0.0
    let idx = 0
    while idx < m * n {
        let v = deref_f32(cref, idx * 4)
        sum = round_f32(acc, sum + v)
        let av = fabs(v)
        if av > maxabs { maxabs = av }
        idx = idx + 1
    }

    println("[" + str(m) + "x" + str(n) + "x" + str(k)
        + " tA=" + str(transA) + " tB=" + str(transB)
        + "] sum=" + str(sum) + " maxabs=" + str(maxabs))

    free_raw(a, rowsA * colsA * 4)
    free_raw(b, rowsB * colsB * 4)
    free_raw(cref, m * n * 4)
    free_raw(acc, 4)
}

// ── RUNEQ harness — same case matrix as hxblas_cuda_smoke_large.c ──
fn main() {
    run_case(16, 16, 16, 0, 0)
    run_case(16, 16, 16, 1, 0)
    run_case(16, 16, 16, 0, 1)
    run_case(16, 16, 16, 1, 1)
    run_case(128, 128, 128, 0, 0)
    run_case(128, 128, 128, 1, 0)
    run_case(128, 128, 128, 0, 1)
    run_case(64, 32, 128, 0, 0)
    println("[sgemm_ref] DONE")
}
