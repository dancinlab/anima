// training/corpus_wiki_ingest.hexa — 5-language wiki full-crawl ingest + byte-balance.
//
// anima 는 5개국어(EN·中文·Русский·日本語·한국어)로 대화한다 (P1_CORPUS SSOT, #1616).
// lane A (web/coherence) full crawl 은 5개 wiki 덤프를 byte-encode 하되, 한 언어가
// 과반을 먹지 않도록 per-language byte cap 으로 ~20% 씩 균형을 맞춘다 (현 kowiki 85%
// = 한국어 단일 모델 → 균형이 5개국어 대화의 전제).
//
// 기존 training/corpus_ingest.hexa 는 LOCAL KR 텍스트 inventory(소량 dedup)다 — 별개.
// 이 파일은 5개 WIKI full-crawl 의 ORCHESTRATION + BYTE-BALANCE 다. 언어별 추출은
// corpus_kowiki_extract.hexa 패턴(bzcat | awk title/text | strip-markup → 한 줄 한
// article)을 언어별로 재사용한다. 실 wiki 덤프(언어별 수 GB bz2)는 H100 crawl 단계에서
// 받으며, 여기 CPU self-test 는 balance 로직(과반 언어에 cap 적용 → 20%±5%p 수렴)을
// 검증한다.
//
// F-CLM-MULTILING-BALANCE: per-lang byte cap 적용 후 각 언어 byte share ∈ [15%, 25%]
// (한 언어 과반 금지). 5/5 PASS → full crawl balance 계약 충족.

// 5개 wiki 덤프 소스 (dumps.wikimedia.org · CC-BY-SA 4.0 · sha 는 crawl 시 기록).
fn wiki_sources() -> [[string]] {
    return [
        ["en", "https://dumps.wikimedia.org/enwiki/latest/enwiki-latest-pages-articles.xml.bz2"],
        ["zh", "https://dumps.wikimedia.org/zhwiki/latest/zhwiki-latest-pages-articles.xml.bz2"],
        ["ru", "https://dumps.wikimedia.org/ruwiki/latest/ruwiki-latest-pages-articles.xml.bz2"],
        ["ja", "https://dumps.wikimedia.org/jawiki/latest/jawiki-latest-pages-articles.xml.bz2"],
        ["ko", "https://dumps.wikimedia.org/kowiki/latest/kowiki-latest-pages-articles.xml.bz2"]
    ]
}

// per-language byte cap = total target byte budget / 5 (each lane ~20%).
fn per_lang_cap(total_target_bytes: int) -> int {
    return total_target_bytes / 5
}

// Apply the cap to a language's raw byte count: min(raw, cap). A language larger
// than the cap is trimmed to 20% (overflow dropped); a smaller one keeps all it
// has (and is flagged short for top-up).
fn capped(raw: int, cap: int) -> int {
    if raw > cap { return cap }
    return raw
}

// share in integer percent, guarding total=0.
fn share_pct(part: int, total: int) -> int {
    if total <= 0 { return 0 }
    return (part * 100) / total
}

fn main() {
    println("[wiki-ingest] 5-language wiki full-crawl — orchestration + byte-balance")
    let srcs = wiki_sources()
    let mut si = 0
    while si < 5 {
        print("  src["); print(srcs[si][0]); print("] = "); println(srcs[si][1])
        si = si + 1
    }

    // ── CPU self-test: balance 로직 (실 덤프 없이) ──
    // 의도적 불균형 raw byte (en 이 거대 = 현 kowiki-85% 와 같은 단일언어 위험을
    // 시뮬). per-lang cap 적용 → 각 20% 로 수렴해야 한다.
    let raw_en = 5000000   // huge (would be 71% uncapped)
    let raw_zh = 1000000
    let raw_ru = 1000000
    let raw_ja = 1000000
    let raw_ko = 1000000
    let raw_total = raw_en + raw_zh + raw_ru + raw_ja + raw_ko

    // cap = total_target / 5; target = 5 × the smallest balanced lane (1M) = 5M.
    let cap = per_lang_cap(5000000)
    let c_en = capped(raw_en, cap)
    let c_zh = capped(raw_zh, cap)
    let c_ru = capped(raw_ru, cap)
    let c_ja = capped(raw_ja, cap)
    let c_ko = capped(raw_ko, cap)
    let c_total = c_en + c_zh + c_ru + c_ja + c_ko

    print("  uncapped en share = "); print(share_pct(raw_en, raw_total)); println("% (single-language risk)")
    print("  capped   en share = "); print(share_pct(c_en, c_total)); println("%")

    // F-CLM-MULTILING-BALANCE: every lane within [15, 25] %.
    let mut all_ok = 1
    let shares = [share_pct(c_en, c_total), share_pct(c_zh, c_total),
                  share_pct(c_ru, c_total), share_pct(c_ja, c_total),
                  share_pct(c_ko, c_total)]
    let langs = ["en", "zh", "ru", "ja", "ko"]
    let mut li = 0
    while li < 5 {
        let s = shares[li]
        print("    "); print(langs[li]); print(" = "); print(s); print("%")
        if s < 15 { println("  LOW"); all_ok = 0 }
        else { if s > 25 { println("  HIGH (over half-risk)"); all_ok = 0 } else { println("  ok") } }
        li = li + 1
    }

    if all_ok == 1 {
        println("F-CLM-MULTILING-BALANCE = 1")
        println("PASS — per-lang cap holds every language in [15,25]% (no single-language majority)")
        return
    }
    println("F-CLM-MULTILING-BALANCE = 0")
    println("FAIL — a language is out of the 15-25% band (top-up or cap-adjust needed)")
}
