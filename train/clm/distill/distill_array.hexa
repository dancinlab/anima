// ════════════════════════════════════════════════════════════════════════════
//  distill_array.hexa — CLM BRIDGE distill hexa-native DRIVER (d5: hexa 1순위)
//
//  P0 §11.4/§11.6 (BRIDGE · F-CLM-BRIDGE-XFER) · @L4·@L8: py payload
//  (CLM/distill/{distill_array,run_bridge_transfer}.py) PRIMARY + hexa thin
//  driver. teacher(유효 측정 scale) escape 측정 → KD distill → chip-fit student
//  → routing-diversity transfer Δ 검증.
//
//  이 드라이버는:
//    (1) teacher/student scale 파라미터(E·d)를 hexa 에서 조립하고,
//    (2) d16 free-pool smoke 를 먼저 돌려 import/path 결함을 잡고,
//    (3) run_bridge_transfer.py 페이로드를 호출한다.
//
//  HARD: pure-hexa · NO main 자동발화 주의(fn main 은 run 시 자동발사).
//  추론 AKIDA-int4-only 불변 — 이 파일은 GPU/CPU distill pretrain 만 다룬다.
// ════════════════════════════════════════════════════════════════════════════

// teacher = 유효 측정 scale (E·d 큼) — python DistillConfig 와 1:1 동기.
fn bridge_teacher_spec() -> string {
    return "E=32 d=128 (valid measure scale)"
}

// student = chip-fit 배포 scale (각 expert ≤ AKD1000 1.2M).
fn bridge_student_spec() -> string {
    return "E=8 d=64 (chip-fit deploy scale)"
}

// KD = Hinton soft-target (alpha·T).
fn bridge_kd_spec() -> string {
    return "Hinton alpha=0.7 T=3.0"
}

// d16 free-pool toy smoke (teacher train + KD distill + transfer Δ z) — $0.
fn bridge_smoke_cmd(steps: int) -> string {
    return "python3 run_bridge_transfer.py --steps " + to_string(steps)
}

fn main() {
    println("CLM BRIDGE distill (transfer arm · hexa-native driver · d5 1순위)")
    println("  teacher = " + bridge_teacher_spec())
    println("  student = " + bridge_student_spec())
    println("  KD = " + bridge_kd_spec() + " · metric = dispatch-entropy z (H_852 동일)")
    println("  falsifier F-CLM-BRIDGE-XFER: teacher escape 가 distill 후 생존하나(transfer Δ)")

    // d16 free-pool smoke FIRST — distill 배선을 GPU 임대 전에 잡는다.
    let cmd = bridge_smoke_cmd(60)
    println("smoke: " + cmd)
    let out = exec(cmd + " 2>&1")
    print(out)
}
