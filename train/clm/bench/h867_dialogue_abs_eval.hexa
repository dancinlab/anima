// ════════════════════════════════════════════════════════════════════════════
//  h867_dialogue_abs_eval.hexa — ABSOLUTE dialogue-quality FLOOR harness (@L6 · H_867)
//
//  UNIVERSE/cards/H_867 (F-CLM-DIALOGUE-ABS): does the SFT+self-play arm-SP clear a
//  PRE-FROZEN ABSOLUTE held-out dialogue-quality FLOOR — not merely beat its own
//  SFT arm (that was H_863, RELATIVE)? A strictly harder bar: a model can win an
//  A/B and still be absolutely poor. Floor frozen BEFORE the fire (W2 · post-tuning 0).
//
//  Floor (pre-registered · F-CLM-DIALOGUE-ABS_prereg.txt · FROZEN):
//    F-CLM-DIALOGUE-ABS-COHERE : coherence(arm-SP)   >= 0.060   (above order-0 unigram 0.0375)
//    F-CLM-DIALOGUE-ABS-ADEQ   : adequacy_f1(arm-SP) >= 0.020   (above random-gen 0.000)
//    F-CLM-DIALOGUE-ABS-LEAK   : register_leak(arm-SP) == 0     (absolute safety gate)
//  ALL THREE absolute → 🟢 SUPPORTED-NUMERICAL · ANY fail → 🔴 CLOSED-NEGATIVE (a_paper_negative_ok).
//  byte-match ✗ — distributional / trajectory measures (Q-TRUST A reuse · H_857/H_858).
//
//  Eval corpus = H_867's OWN INDEPENDENT held-out PD snapshot — Macbeth(#1533) ·
//  Othello(#1531) · Romeo&Juliet(#1513) · Pygmalion(#3825) — DISJOINT from H_863's
//  training plays (so it tests ABSOLUTE generalization, not memorized recall).
//  Snapshot held under .verdicts/clm-dialogue-abs/ (H_867 does NOT write train/clm/corpus/).
//
//  Output → .verdicts/clm-dialogue-abs/  (clm_dialogue_abs_result.json + verdict).
//  HARD: external LLM 0 (no LLM judge — distributional self-scoring only · g5) ·
//  ShareGPT/Alpaca/ChatGPT-gen 0 (@L4 foundation-borrow 0). pure-hexa scaffold;
//  the torch payload (reconstruct arm-SP from the HF backbone · score) reuses
//  train/clm/train/train_clm.py + the H_863 self-play reflux procedure VERBATIM.
//  sibling: UNIVERSE/cards/H_867 · UNIVERSE/cards/H_863 · train/clm/bench/bench_dialogue_ab.hexa
// ════════════════════════════════════════════════════════════════════════════

fn verdict_dir() -> string { return ".verdicts/clm-dialogue-abs" }

// model under test = the H_863 mid-rung SFT+self-play arm-SP (NOT retrained for H_867).
fn model_under_test() -> string { return "arm-SP (H_863 SFT+self-play · mid d512/L8/E8 ~13.65M)" }

// FROZEN absolute floor thresholds (per-mille integers) — F-CLM-DIALOGUE-ABS_prereg.txt.
fn cohere_floor_milli() -> int { return 60 }   // coherence   >= 0.060
fn adeq_floor_milli() -> int { return 20 }     // adequacy_f1 >= 0.020

// grounding baselines on this snapshot (facts, not tunable) — for justification context.
fn baseline_unigram_milli() -> int { return 37 }   // order-0 byte-frequency coherence 0.0375
fn baseline_bigram_milli() -> int { return 84 }    // order-1 self-fit coherence 0.0843 (optimistic ref)

// pre-registered ABSOLUTE falsifier names (frozen pre-run · H_867).
fn falsifiers() -> [string] {
    return [
        "F-CLM-DIALOGUE-ABS-COHERE",
        "F-CLM-DIALOGUE-ABS-ADEQ",
        "F-CLM-DIALOGUE-ABS-LEAK",
    ]
}

// ABSOLUTE floor gate: arm-SP clears the floor iff coherence AND adequacy clear their
// frozen floors AND it is leak-free. NO relative SP-vs-SFT comparison (that was H_863).
// Scores are per-mille integers in the scaffold; the torch payload uses the real floats.
fn floor_clear(cohere_milli: int, adeq_milli: int, leak_count: int) -> int {
    if cohere_milli < cohere_floor_milli() { return 0 }   // ABS-COHERE
    if adeq_milli < adeq_floor_milli() { return 0 }       // ABS-ADEQ
    if leak_count != 0 { return 0 }                        // ABS-LEAK
    return 1
}

// the torch eval payload (run-only · NOT a shipped source file — mirrors H_863, whose
// torch fire payload was never committed). It REUSES train/clm/train/train_clm.py (CLMConvMoE +
// the QAT continue loop) to: (1) load the HF backbone clm_mid_backbone.pt into the mid
// config d512/L8/E8, (2) reconstruct arm-SFT (short SFT-only continue on the H_863 CC/PD
// dialogue corpus) and arm-SP (same continue + a DIVERSITY-gated 8-pattern-leak-filtered
// self-play reflux slice folded back, H_863 procedure VERBATIM), (3) score both on the
// H_867 held-out snapshot (coherence=exp(-CE) · adequacy=3-gram F1 · register-leak ·
// self-BLEU · repetition — all code-only, g5), (4) gate arm-SP on the frozen floor.
// External LLM 0 · ShareGPT/Alpaca/ChatGPT-gen 0. Output → clm_dialogue_abs_result.json.
fn eval_payload_inputs() -> [string] {
    return [
        "backbone = hf:dancinlab/anima-clm-verify/clm_mid_backbone.pt (mid d512/L8/E8 ~13.65M)",
        "sft_corpus = hf:dancinlab/anima-clm-p4-dialogue/cc_dialogue.bytes (H_863 CC/PD dialogue)",
        "heldout = .verdicts/clm-dialogue-abs/h867_eval_heldout.bytes (H_867 disjoint PD snapshot)",
        "floor = coherence>=0.060 ∧ adequacy_f1>=0.020 ∧ register_leak==0 (frozen · post-tuning 0)",
        "out = .verdicts/clm-dialogue-abs/clm_dialogue_abs_result.json",
    ]
}

fn main() {
    println("CLM dialogue ABSOLUTE-FLOOR bench (@L6 · H_867 · arm-SP vs frozen floor)")
    println("  verdict_dir = " + verdict_dir() + " · byte-match ✗ (distributional · Q-TRUST A)")
    println("  model under test = " + model_under_test())
    println("  frozen floor: coherence>=0.060 ∧ adequacy_f1>=0.020 ∧ register_leak==0")
    println("  grounding: unigram(order0)=0.0375 < FLOOR 0.060 < bigram(self-fit)=0.0843")

    println("pre-registered ABSOLUTE falsifiers (H_867):")
    for f in falsifiers() { println("  " + f) }

    // floor_clear sanity (scaffold-level self-checks):
    println("floor_clear self-checks:")
    println("  clears floor (0.155,0.052,0)      → "
        + to_string(floor_clear(155, 52, 0)) + " (expect 1)")
    println("  coherence below floor (0.050,...)  → "
        + to_string(floor_clear(50, 52, 0)) + " (expect 0 · ABS-COHERE)")
    println("  adequacy below floor (...,0.010,.) → "
        + to_string(floor_clear(155, 10, 0)) + " (expect 0 · ABS-ADEQ)")
    println("  clears but leaks register          → "
        + to_string(floor_clear(155, 52, 2)) + " (expect 0 · ABS-LEAK)")
    println("  exactly at floor (0.060,0.020,0)   → "
        + to_string(floor_clear(60, 20, 0)) + " (expect 1 · >= boundary)")

    println("eval payload inputs (reconstruct arm-SP from HF backbone · score · code-only):")
    for s in eval_payload_inputs() { println("  " + s) }
}
