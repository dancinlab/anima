// ════════════════════════════════════════════════════════════════════════════
//  clm_causal_prod.hexa — CLM CAUSAL-POWER PRODUCTION transfer 드라이버 (F-CLM-CAUSAL-XFER axis A)
//
//  H_856. toy 🟢 CAUSAL-POWER(H_855, measure_sweep.py 단독 PASS)가 production
//  scale(d≥512·실 kowiki)에서 생존하는가를 사전등록 frozen 3-check 로 검증한다.
//
//  설계(g0/g1 재사용 우선):
//    - 측도 CAUSAL-POWER 구현은 train/clm/msweep/measure_sweep.py 의
//      bin_to_regions / region_rates / m_causal_power poke-logic / evaluate 를
//      그대로(frozen) import — 재구현 금지. 측도 임계도 frozen(MARGIN_FRAC=0.10·
//      NONTRIVIAL_EPS=1e-6·N_SIZES=[4,5,6]·CAUSAL_POKES=16) 미변조.
//    - spike SOURCE 만 toy LIF → 학습된 production CLM(d512/L4/E8) 의 실 MoE
//      활성(AKIDA act_bits=1 envelope = 온칩 binary spike) 로 교체.
//    - collapse = MONOPOLY 입력 드라이브(단일 byte band 지배 → decoupled, 저 적분)
//      rich     = 실 kowiki 다양 입력(균형·적분) — toy gen_spike 의 collapse/rich
//      의미를 production scale 에서 그대로 재현.
//
//  학습 PAYLOAD(QAT forward/STE)는 torch autograd 의존 → train/clm/train/train_clm.py
//  재사용. 측정 PAYLOAD 역시 numpy/torch → train/clm/msweep/clm_causal_prod.py(.py 페이로드).
//  이 .hexa 는 hexa-native 드라이버(파라미터 조립 + .py 호출 인자 emit).
//
//  HARD: ubu-1 GPU only(Mac=0) · poke ≤16 · 정직 보고(임계 재조정 0).
//  HARD: pure-hexa · fn main 자동발화 주의. 추론 AKIDA-int4-only 불변.
//  sibling axis B(live pi5 AKD1000 HW) = train/clm/msweep/clm_causal_hw.py.
// ════════════════════════════════════════════════════════════════════════════

// frozen 측도 임계 (measure_sweep.py 와 1:1 — 재선언 NOT re-tune; 참조용).
fn clm_causal_margin_frac() -> float { return 0.10 }
fn clm_causal_causal_pokes_cap() -> int { return 16 }

// production rung (P0 d3 'small' 이상 — d≥512 production-width 요건).
fn clm_causal_prod_rung() -> string { return "d512/L4/E8" }

// full production run 호출 (ubu-1 GPU) — corpus·steps·seed 인자 전달.
fn clm_causal_prod_cmd(corpus: string, steps: int, seed: int) -> string {
    return "python3 clm_causal_prod.py --json"
        + " --corpus " + corpus
        + " --steps " + to_string(steps)
        + " --seed " + to_string(seed)
}

fn main() {
    // 기본 구성: 실 kowiki @corpus · production-width · ubu-1 GPU.
    let corpus = "../corpus/clm_p1.corpus.kosmos"
    let steps  = 1500
    let seed   = 187
    println("[clm_causal_prod] F-CLM-CAUSAL-XFER axis A — production transfer")
    println("[clm_causal_prod] rung=" + clm_causal_prod_rung()
        + " margin_frac=" + to_string(clm_causal_margin_frac())
        + " poke_cap=" + to_string(clm_causal_causal_pokes_cap()))
    println("[clm_causal_prod] payload: " + clm_causal_prod_cmd(corpus, steps, seed))
    println("[clm_causal_prod] (ubu-1 GPU only · Mac=0 · frozen 3-check 미변조)")
}
