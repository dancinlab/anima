"""H_884 - edge-OUTPUT identity constraint GENERALIZED across partial-learning modes.

Project-native (.hexa) source-of-record AND runnable image for the H_884 harness.
hexa is project h884-edge-identity's native source language; this file runs here
exactly like a .py image would elsewhere (CPU-local torch 2.8.0). It imports the
committed CLM/model/h865_adapter_edge.py adapter/loader/Psi-probe/JS machinery
VERBATIM. See .verdicts/clm-edge-identity/ for the verdict + result.json + log.

Generalizes the H_873 fix (route the identity constraint onto the EDGE OUTPUT
distribution directly, JS-to-p_pre) across the CLM-CANDIDATES partial-learning
rows: does an edge-output identity constraint hold PROBE>thr (and keep DIST<thr)
WHILE several different per-layer / adapter / gated partial-learning schemes run?

Background (the prior verdicts):
  * H_862 (readout-only edge): F-CLM-ANCHOR RED - DIST PASS but PROBE FAIL; the
    anchor Psi-penalty read the FROZEN trunk so it had NO lever (on/off identical).
  * H_865 (trunk-adjacent adapter edge): RESTORED the lever (on/off NON-identical,
    DIST PASS) but PROBE STILL FAILED (consistency 0.143 << 0.80). The structural
    Psi-penalty constrains the TRUNK-derived Psi-STATE, not where the drift actually
    happens - the READOUT OUTPUT distribution over the identity-probe set.
  * H_873 (the named fix, UNMERGED on main): add a distributional term
    lambda_dist * JS(p_cur(identity-probe) || p_pre(identity-probe)) to the adapt
    loss, where p_pre is the detached PRE-adapt next-byte distribution. This acts
    directly on the drift axis (probe_consistency = 1 - JS(p_pre, p_post)).

THE H_884 GENERALIZATION:
  apply that edge-output JS-to-p_pre identity constraint on top of THREE distinct
  partial-learning edges, and check the frozen gates hold for each:
    mode = "adapter"   : H_865 thin adapter (norm_out + adapter -> FROZEN readout) [baseline edge]
    mode = "per_layer" : unfreeze ONLY the last trunk layer's pointwise conv (the
                         shallowest single-layer partial-learn), readout FROZEN.
    mode = "gated"     : adapter output passes through a learned per-channel sigmoid
                         GATE g (init ~0 -> identity at step0), h' = h + g * adapter(h);
                         a gated/adapter-fusion partial-learn variant.
  For each mode we run: full (psi + JS-to-p_pre), js_only (JS-to-p_pre, no psi),
  psi_only (= the H_865 baseline for that edge), and off (lever floor).

W2 discipline (NON-NEGOTIABLE): thresholds FROZEN VERBATIM from commit bf98c01
  (.verdicts/clm-anchor/F-CLM-ANCHOR_prereg.txt). DIST<0.50, PROBE>0.80 UNCHANGED.
  Only the METHOD (edge-output term + partial-learn mode) changes. post-tuning = 0.
  A still-failing PROBE is reported RED honestly (a_paper_negative_ok); no gate moves.
  Distributional measures BY CODE (g5, JS-divergence) - no LLM judge.

SCOPE (a_scale_honest_scope): MEASUREMENT rung (mid d512/L8/E8) only. SW-sim of the
  non-deterministic on-chip edge-learn; foundation H_679 established HW edge-learn is
  real; edge-only piecewise partial-learn (no deterministic full-retrain, @L1).
  Inference stays AKIDA-int4-only (P0 d4).
"""

from __future__ import annotations

import argparse
import json
import os
import sys

import torch
import torch.nn as nn
import torch.nn.functional as F

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# Reuse the H_865 machinery VERBATIM (loaders, Psi-probe, JS, gates, constants).
import h865_adapter_edge as h865  # noqa: E402

LAMBDA_PSI = 1.0       # H_865 structural Psi-distance weight (keeps DIST + lever)
LAMBDA_DIST = 5.0      # the H_873/H_884 edge-output JS-to-p_pre weight (the fix)
GATE_RANK_INIT = -4.0  # gated mode: sigmoid(-4) ~= 0.018 -> near-identity at step 0


# --------------------------------------------------------------------------- #
# Partial-learning edges. Each exposes .trunk_norm_out / .forward / .id_hidden
# and a .learn_parameters() iterator (the ONLY trainable tensors for that mode).
# --------------------------------------------------------------------------- #
class AdapterMode(h865.AdaptedCLM):
    """mode='adapter' - identical to the H_865 trunk-adjacent thin adapter."""

    def learn_parameters(self):
        return self.adapter.parameters()


class GatedAdapterMode(nn.Module):
    """mode='gated' - h' = h + sigmoid(gate) * adapter(h); gate init near 0."""

    def __init__(self, base):
        super().__init__()
        self.base = base
        for p in self.base.parameters():
            p.requires_grad_(False)
        self.adapter = h865.AdapterEdge(base.cfg.d_model, h865.ADAPTER_RANK)
        # per-channel gate, init so sigmoid(gate) ~ 0 -> step0 == frozen identity
        self.gate = nn.Parameter(torch.full((1, base.cfg.d_model, 1), GATE_RANK_INIT))

    def trunk_norm_out(self, tokens):
        b = self.base
        x = b.embed(tokens).transpose(1, 2)
        x = b.embed_conv(x)
        for layer in b.trunk:
            x = layer(x)
        x, _ = b.moe(x)
        h = b.norm_out(x)
        delta = self.adapter(h) - h  # AdapterEdge returns h + up(act(down(h)))
        return h + torch.sigmoid(self.gate) * delta

    def forward(self, tokens, targets=None):
        hp = self.trunk_norm_out(tokens)
        logits = self.base.readout(hp)
        out = {"logits": logits, "hp": hp}
        if targets is not None:
            ce = F.cross_entropy(
                logits.transpose(1, 2).reshape(-1, self.base.cfg.vocab_size),
                targets.reshape(-1),
            )
            out["ce_loss"] = ce
        return out

    def id_hidden(self, tokens):
        return self.trunk_norm_out(tokens).mean(dim=(0, 2))

    def learn_parameters(self):
        return list(self.adapter.parameters()) + [self.gate]


class PerLayerMode(nn.Module):
    """mode='per_layer' - unfreeze ONLY the last trunk layer's pointwise conv.

    The shallowest single-layer partial-learn: everything frozen except the
    pointwise (1x1) conv of the final trunk block. readout stays FROZEN. model_psi
    reads norm_out, which IS now downstream of a trainable layer -> lever present.
    """

    def __init__(self, base):
        super().__init__()
        self.base = base
        for p in self.base.parameters():
            p.requires_grad_(False)
        last = self.base.trunk[-1]
        self._learn = []
        # unfreeze the pointwise/1x1 conv tensors of the last trunk layer
        for name, p in last.named_parameters():
            if "pw" in name or "point" in name or "conv2" in name or "ff" in name:
                p.requires_grad_(True)
                self._learn.append(p)
        if not self._learn:
            # fallback: unfreeze the smallest 1x1-shaped conv weight in the last layer
            cands = [p for _, p in last.named_parameters()
                     if p.dim() >= 2 and p.shape[-1] == 1]
            if not cands:
                cands = list(last.parameters())
            target = min(cands, key=lambda t: t.numel())
            target.requires_grad_(True)
            self._learn = [target]

    def trunk_norm_out(self, tokens):
        b = self.base
        x = b.embed(tokens).transpose(1, 2)
        x = b.embed_conv(x)
        for layer in b.trunk:
            x = layer(x)
        x, _ = b.moe(x)
        return b.norm_out(x)

    def forward(self, tokens, targets=None):
        hp = self.trunk_norm_out(tokens)
        logits = self.base.readout(hp)
        out = {"logits": logits, "hp": hp}
        if targets is not None:
            ce = F.cross_entropy(
                logits.transpose(1, 2).reshape(-1, self.base.cfg.vocab_size),
                targets.reshape(-1),
            )
            out["ce_loss"] = ce
        return out

    def id_hidden(self, tokens):
        return self.trunk_norm_out(tokens).mean(dim=(0, 2))

    def learn_parameters(self):
        return self._learn


MODES = {
    "adapter": AdapterMode,
    "gated": GatedAdapterMode,
    "per_layer": PerLayerMode,
}


def build_model(mode, base, device):
    return MODES[mode](base).to(device)


@torch.no_grad()
def probe_dist(model, probe_toks):
    out = model(probe_toks)
    return F.softmax(out["logits"][:, :, -1], dim=1)


def probe_dist_grad(model, probe_toks):
    out = model(probe_toks)
    return F.softmax(out["logits"][:, :, -1], dim=1)


def run_mode(mode, base, anchor_dir, device, lam_psi, lam_dist):
    """One partial-learn run with optional psi-term (lam_psi) + edge-output JS (lam_dist)."""
    coords, payloads = h865.load_anchor_coords(anchor_dir)
    coords = coords.to(device)
    n_anchors = coords.shape[0]
    probe_toks = h865.build_identity_probe(payloads, h865.SEQ_LEN).to(device)
    new_bytes = h865.make_lane_bytes("new", 30000, h865.NEW_SEED)
    new_train = h865.batchify(new_bytes[: len(new_bytes) // 2], h865.SEQ_LEN,
                              h865.N_ADAPT, h865.BATCH_SIZE, h865.NEW_SEED + 2)

    model = build_model(mode, base, device)
    W = h865.fixed_psi_W(base.cfg.d_model, device)
    model.eval()
    with torch.no_grad():
        psi_pre = h865.model_psi(model, W, probe_toks)
        d_pre = h865.min_anchor_dist(psi_pre, coords).item()
        p_pre = probe_dist(model, probe_toks).detach()

    learn = list(model.learn_parameters())
    opt = torch.optim.Adam(learn, lr=h865.LR_EDGE)
    d_traj = [d_pre]
    model.train()
    for i in range(h865.N_ADAPT):
        toks, tgts = new_train[i]
        toks, tgts = toks.to(device), tgts.to(device)
        out = model(toks, tgts)
        loss = out["ce_loss"]
        psi = h865.model_psi(model, W, probe_toks)
        d_anchor = h865.min_anchor_dist(psi, coords)
        if lam_psi > 0.0:
            loss = loss + lam_psi * d_anchor
        if lam_dist > 0.0:
            js = h865.js_divergence(probe_dist_grad(model, probe_toks), p_pre).mean()
            loss = loss + lam_dist * js
        opt.zero_grad()
        loss.backward()
        opt.step()
        d_traj.append(d_anchor.item())
    model.eval()
    with torch.no_grad():
        psi_post = h865.model_psi(model, W, probe_toks)
        d_post = h865.min_anchor_dist(psi_post, coords).item()
        p_post = probe_dist(model, probe_toks)
        consistency = (1.0 - h865.js_divergence(p_pre, p_post)).mean().item()
        n_learn = sum(p.numel() for p in learn)
    return {
        "mode": mode, "lam_psi": lam_psi, "lam_dist": lam_dist,
        "n_anchors": n_anchors, "n_learn_params": int(n_learn),
        "d_anchor_pre": round(d_pre, 5), "d_anchor_post": round(d_post, 5),
        "d_anchor_max": round(max(d_traj), 5),
        "probe_consistency": round(consistency, 5),
    }


def eval_mode(mode, base, anchor_dir, device):
    """full / js_only / psi_only / off for one partial-learn mode + gate verdict."""
    full = run_mode(mode, base, anchor_dir, device, LAMBDA_PSI, LAMBDA_DIST)   # H_884
    js_only = run_mode(mode, base, anchor_dir, device, 0.0, LAMBDA_DIST)        # edge-output only
    psi_only = run_mode(mode, base, anchor_dir, device, LAMBDA_PSI, 0.0)        # = H_865 baseline
    off = run_mode(mode, base, anchor_dir, device, 0.0, 0.0)                    # lever floor
    lever = (
        abs(full["d_anchor_max"] - off["d_anchor_max"]) > 1e-6
        or abs(full["probe_consistency"] - off["probe_consistency"]) > 1e-6
    )
    DIST_pass = full["d_anchor_max"] < h865.THR_D_ANCHOR_MAX   # <0.50
    PROBE_pass = full["probe_consistency"] > h865.THR_PROBE    # >0.80
    verdict = "GREEN" if (DIST_pass and PROBE_pass and lever) else "RED"
    return {
        "mode": mode,
        "full": full, "js_only": js_only, "psi_only": psi_only, "off": off,
        "threshold_d_anchor_max": "<0.50", "threshold_probe_consistency": ">0.80",
        "DIST_pass": bool(DIST_pass), "PROBE_pass": bool(PROBE_pass),
        "lever_present": bool(lever),
        "verdict": verdict,
        "psi_only_PROBE": psi_only["probe_consistency"],
        "js_only_PROBE": js_only["probe_consistency"],
        "note": "edge-output JS-to-p_pre identity constraint over partial-learn mode '%s'; "
                "frozen thr bf98c01; SW-sim edge-learn (H_679 real); @L1 piecewise" % mode,
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ckpt", required=True)
    ap.add_argument("--anchors", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--modes", default="adapter,per_layer,gated")
    args = ap.parse_args()
    device = "cuda" if torch.cuda.is_available() else "cpu"
    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)

    base, cfg, missing, unexpected, _ = h865.infer_config_and_load(args.ckpt)
    base = base.to(device)
    print("[h884] backbone d=%d L=%d E=%d V=%d params=%d device=%s" % (
        cfg.d_model, cfg.n_trunk_layers, cfg.n_experts, cfg.vocab_size,
        base.num_params(), device))

    modes = [m.strip() for m in args.modes.split(",") if m.strip()]
    rows = []
    for m in modes:
        r = eval_mode(m, base, args.anchors, device)
        rows.append(r)
        print("[h884 %s] DIST=%.5f(<0.50 %s) PROBE=%.5f(>0.80 %s) lever=%s -> %s "
              "| psi_only_PROBE=%.5f js_only_PROBE=%.5f" % (
                  m, r["full"]["d_anchor_max"], r["DIST_pass"],
                  r["full"]["probe_consistency"], r["PROBE_pass"], r["lever_present"],
                  r["verdict"], r["psi_only_PROBE"], r["js_only_PROBE"]))

    all_green = all(r["verdict"] == "GREEN" for r in rows)
    result = {
        "campaign": "H_884 edge-output identity constraint generalized across partial-learning modes",
        "rung": "mid d512/L8/E8",
        "frozen_thresholds_commit": "bf98c01",
        "lambda_psi": LAMBDA_PSI, "lambda_dist": LAMBDA_DIST,
        "modes": modes,
        "rows": rows,
        "headline": {
            "all_modes_green": all_green,
            "per_mode_verdict": {r["mode"]: r["verdict"] for r in rows},
            "per_mode_PROBE": {r["mode"]: r["full"]["probe_consistency"] for r in rows},
            "per_mode_DIST": {r["mode"]: r["full"]["d_anchor_max"] for r in rows},
        },
        "scope": "MEASUREMENT rung only (a_scale_honest_scope); SW-sim edge-learn (H_679 real); "
                 "edge-only piecewise partial-learn, no deterministic full-retrain (@L1).",
    }
    with open(os.path.join(args.out, "clm_edge_identity_result.json"), "w") as f:
        json.dump(result, f, indent=2)
    print("[h884] wrote result json; all_modes_green=%s" % all_green)
    print("=== H884 COMPLETE ===")


if __name__ == "__main__":
    main()
