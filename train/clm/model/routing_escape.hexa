// ════════════════════════════════════════════════════════════════════════════
//  routing_escape.hexa — pluggable routing-escape lane (P4 @L3 · ONE slot, 3 levers)
//
//  P4_PRODUCTION_ROADMAP @L3: a pluggable, swappable routing-escape lane.
//  Three levers A / B / C swap into ONE interface slot (re-architecture 0).
//  The existing model.py `variant ∈ {A,B,AB}` knob is the trunk-level router
//  arm; THIS module is the higher-level ESCAPE-LANE selector that picks WHICH
//  routing-diversity strategy the production stack uses, decoupled from the
//  trunk arm so a lever can be hot-swapped without touching the model.
//
//  Levers (all behind the same `routing_escape_lever()` contract):
//    A = dispatch-KL distill   — distil the teacher dispatch distribution into
//                                the chip-fit student (the 4th lever named in
//                                CLM.md P-ARRAY; foundation = H_853 BRIDGE).
//    B = content-defer  [DEFAULT] — converse FIRST via content-axis escape;
//                                routing-z treated as a toy-scale measurement
//                                artifact [M1], RE-CHECKED at deploy scale.
//                                "can converse" is satisfied by content-escape;
//                                the routing-z>3.0 gate is required ONLY for the
//                                chip-array (expert=chip) deploy.
//    C = expert-choice routing — experts pick tokens (not tokens pick experts);
//                                load auto-balances (Zhou et al. expert-choice).
//
//  HONEST (a_scale_honest_scope): the routing-z>3.0 gate is a DEPLOY-time
//  (chip-array) requirement, NOT a "can converse" requirement. P2/P-ARRAY
//  closed routing-z 🔴 at toy scale (H_847/H_852/H_853) — those verdicts are
//  toy-scoped and re-checked at the measurement-rung deploy scale (M1).
//
//  HARD: pure-hexa · NO external LLM · stub-shaped (the lever payloads live in
//  CLM/model/{model,array_moe,run_array_sweep}.py + CLM/distill/). `fn main`
//  auto-fires on `run`, so keep it side-effect-light (prints the lever table).
// ════════════════════════════════════════════════════════════════════════════

// default lever (@L3) — converse first via content-axis escape.
fn routing_escape_default() -> string {
    return "B"
}

// the routing-z gate (@L3) — required ONLY for chip-array (expert=chip) deploy.
fn routing_z_gate() -> string {
    return "3.0"
}

// lever → one-line contract (the swap surface · re-architecture 0).
fn routing_escape_lever(lever: string) -> string {
    if lever == "A" {
        return "dispatch-KL distill (teacher dispatch dist → chip-fit student · foundation H_853)"
    }
    if lever == "B" {
        return "content-defer [DEFAULT] (converse first · routing-z = toy artifact M1 · re-check @deploy)"
    }
    if lever == "C" {
        return "expert-choice routing (experts pick tokens · load auto-balances)"
    }
    return "UNKNOWN lever — expected A|B|C"
}

// is this lever's escape sufficient for "can converse" (vs deploy gate)?
fn lever_satisfies_converse(lever: string) -> int {
    // B (content-defer) satisfies "can converse" by content escape (@L3).
    // A and C also produce content; the routing-z>3.0 gate is deploy-only.
    if lever == "A" { return 1 }
    if lever == "B" { return 1 }
    if lever == "C" { return 1 }
    return 0
}

// the underlying trunk router arm carrying each lever (model.py variant).
fn lever_trunk_arm(lever: string) -> string {
    if lever == "A" { return "AB" }   // dual-axis trunk under KL distill
    if lever == "B" { return "AB" }   // dual-axis trunk, content-axis read out
    if lever == "C" { return "B" }    // load-balance arm carries expert-choice
    return "AB"
}

fn main() {
    println("CLM routing-escape lane (P4 @L3 · ONE slot · 3 swappable levers)")
    println("  default lever = " + routing_escape_default()
        + " · routing-z deploy gate = z>" + routing_z_gate() + " (chip-array only)")
    let levers = ["A", "B", "C"]
    for lever in levers {
        let star = ""
        if lever == routing_escape_default() { star = "  [DEFAULT]" }
        println("  lever " + lever + star + " → " + routing_escape_lever(lever))
        println("        trunk-arm=" + lever_trunk_arm(lever)
            + " · converse-ok=" + to_string(lever_satisfies_converse(lever)))
    }
    println("HONEST (a_scale_honest_scope): routing-z>3.0 = DEPLOY (chip-array) gate, "
        + "NOT a can-converse gate. P2/P-ARRAY routing-z 🔴 are toy-scoped (M1 re-check).")
}
