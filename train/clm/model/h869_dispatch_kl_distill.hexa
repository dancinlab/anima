"""H_869 — dispatch-KL distill routing (lever A) · CPU-local fire.

@L3 routing-escape 4th lever: DISTILL a balanced dispatch target into the router
by adding a KL term to the loss that pulls the batch-averaged dispatch
distribution f toward UNIFORM (1/E). Claim: routing diversity rises (dispatch
entropy up AND routing-z up) WITHOUT the small-scale z-collapse — held-out CE
stays inside a frozen budget.

Runs the KL arm side-by-side with the KL_COEF=0 baseline (= the H_871 mid cell)
at IDENTICAL budget/seed on the MID rung d512/L8/E8, arm AB, REAL kowiki corpus.
All 3 pre-registered gates measured by CODE (g5, no LLM). Does NOT edit model.py
/ array_moe — the dispatch-KL term is computed HERE from out["usage"] and added
to the loss only for the KL arm. routing-z verbatim CLM/model/judge_clm.

FROZEN (F-CLM-DISPATCH-KL_prereg.txt):
  KL_COEF=0.10 ENT_MARGIN=0.10 Z_MARGIN=0.20 CE_BUDGET=0.10 steps=500 lr=1e-3.
  PASS(GREEN) iff ENTROPY AND Z AND BUDGET ; any fail -> RED (a_paper_negative_ok).
"""

from __future__ import annotations

import json
import math
import os
import sys

import torch

_MODEL_DIR = "/home/summer/core/anima/CLM/model"
if _MODEL_DIR not in sys.path:
    sys.path.insert(0, _MODEL_DIR)

from model import CLMConfig, CLMConvMoE          # noqa: E402
from data import make_batches, lane_tagged_stream  # noqa: E402
from stage2_real_corpus import make_real_corpus    # noqa: E402

SEQ_LEN = 64
BATCH_SIZE = 16
N_NULL = 200
DEAD_THRESH = 0.01

KL_COEF = 0.10
ENT_MARGIN = 0.10
Z_MARGIN = 0.20
CE_BUDGET = 0.10
STEPS = 500
LR = 1e-3
ARM = "AB"
RUNG = dict(d_model=512, n_trunk_layers=8, n_experts=8)  # H_863/H_871 mid
SEEDS = [42, 43, 44]

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"


def _set_seed(s: int) -> None:
    torch.manual_seed(s)


def _build_stream(seed: int):
    web, reg = make_real_corpus(n_bytes_per_lane=8192, seed=seed)
    stream, _lane = lane_tagged_stream(web, reg, block=64)
    return stream


def routing_z(ent_nats: float, E: int, seed: int):
    """VERBATIM from CLM/model/judge_clm.routing_z."""
    _g = torch.Generator().manual_seed(seed + 11)  # parity
    obs = ent_nats
    samples = []
    for _ in range(N_NULL):
        d = torch.distributions.Dirichlet(torch.ones(E)).sample()
        p = d / (d.sum() + 1e-9)
        samples.append(float(-(p * torch.log(p + 1e-9)).sum()))
    st = torch.tensor(samples)
    mu, sd = float(st.mean()), float(st.std() + 1e-9)
    return (obs - mu) / sd, obs, mu, sd


@torch.no_grad()
def _measure(model, eval_batches):
    model.eval()
    acc = None
    ent_sum = 0.0
    ce_sum = 0.0
    n = 0
    for x, y in eval_batches:
        x = x.to(DEVICE); y = y.to(DEVICE)
        out = model(x, y)
        u = out["usage"]
        acc = u.clone() if acc is None else acc + u
        ent_sum += float(out["routing_entropy"])
        ce_sum += float(out["ce_loss"])
        n += 1
    return (acc / max(1, n)).cpu(), ent_sum / max(1, n), ce_sum / max(1, n)


def run_cell(seed: int, kl_coef: float) -> dict:
    """Train one cell. kl_coef>0 = lever-A KL arm; kl_coef==0 = baseline."""
    _set_seed(seed)
    cfg = CLMConfig(variant=ARM, **RUNG)
    model = CLMConvMoE(cfg).to(DEVICE)
    E = cfg.n_experts
    u_log = math.log(1.0 / E)  # log uniform target

    stream = _build_stream(seed)
    train_batches = make_batches(stream, SEQ_LEN, BATCH_SIZE, STEPS, seed=seed)
    eval_batches = make_batches(stream, SEQ_LEN, BATCH_SIZE, 16, seed=seed + 999)

    opt = torch.optim.Adam(model.parameters(), lr=LR)
    model.train()
    for x, y in train_batches:
        x = x.to(DEVICE); y = y.to(DEVICE)
        opt.zero_grad()
        out = model(x, y)
        loss = out["loss"]
        if kl_coef > 0.0:
            # dispatch-KL distill: KL(uniform || f) = sum_i (1/E)(log(1/E) - log f_i)
            # f = batch-averaged dispatch distribution = out["usage"] (E,).
            f = out["usage"].clamp_min(1e-9)
            f = f / f.sum()
            kl = ((1.0 / E) * (u_log - torch.log(f))).sum()
            loss = loss + kl_coef * kl
        loss.backward()
        opt.step()

    usage, ent, heldout_ce = _measure(model, eval_batches)
    p = usage / (usage.sum() + 1e-9)
    distinct = int((p > DEAD_THRESH).sum())
    disp_entropy = float(-(p * torch.log(p + 1e-9)).sum())
    rz, r_obs, r_mu, r_sd = routing_z(ent, E, seed)
    return {
        "arm": "kl" if kl_coef > 0 else "baseline",
        "seed": seed, "kl_coef": kl_coef,
        "d_model": RUNG["d_model"], "n_layers": RUNG["n_trunk_layers"],
        "n_experts": E, "params": model.num_params(),
        "usage": [round(float(v), 4) for v in p],
        "distinct_experts": distinct,
        "routing_entropy_nats": round(ent, 4),
        "dispatch_entropy_nats": round(disp_entropy, 4),
        "max_entropy": round(math.log(E), 4),
        "null_mu": round(r_mu, 4), "null_sd": round(r_sd, 4),
        "routing_z": round(rz, 4),
        "heldout_ce": round(heldout_ce, 4),
        "gate_3.0": bool(rz > 3.0),
    }


def _mean(rows, key):
    return round(sum(r[key] for r in rows) / len(rows), 4)


def main() -> None:
    print(f"H_869 dispatch-KL distill (lever A) — arm={ARM} rung=mid(d512/L8/E8) "
          f"seeds={SEEDS} KL_COEF={KL_COEF} corpus=REAL(kowiki) device={DEVICE}",
          flush=True)
    print(f"torch {torch.__version__}  N_NULL={N_NULL}  steps={STEPS} lr={LR}",
          flush=True)
    print(f"GATES: ENT_MARGIN={ENT_MARGIN} Z_MARGIN={Z_MARGIN} CE_BUDGET={CE_BUDGET}",
          flush=True)

    per_run = []
    for kl_coef in (0.0, KL_COEF):
        for seed in SEEDS:
            r = run_cell(seed, kl_coef)
            per_run.append(r)
            print(f"[{r['arm']:>8} s{seed}] disp_H={r['dispatch_entropy_nats']:.4f}/"
                  f"{r['max_entropy']:.3f} z={r['routing_z']:+.4f} "
                  f"ce={r['heldout_ce']:.4f} distinct={r['distinct_experts']} "
                  f"gate3.0={'Y' if r['gate_3.0'] else 'N'}", flush=True)

    base = [r for r in per_run if r["arm"] == "baseline"]
    klr = [r for r in per_run if r["arm"] == "kl"]

    base_ent = _mean(base, "dispatch_entropy_nats")
    kl_ent = _mean(klr, "dispatch_entropy_nats")
    base_z = _mean(base, "routing_z")
    kl_z = _mean(klr, "routing_z")
    base_ce = _mean(base, "heldout_ce")
    kl_ce = _mean(klr, "heldout_ce")

    gate_entropy = bool(kl_ent >= base_ent + ENT_MARGIN)
    gate_z = bool(kl_z >= base_z + Z_MARGIN)
    gate_budget = bool(kl_ce <= base_ce + CE_BUDGET)
    supported = bool(gate_entropy and gate_z and gate_budget)

    print("\n=== H_869 dispatch-KL AGGREGATE (mean over seeds) ===", flush=True)
    print(f"  dispatch-entropy: baseline {base_ent:+.4f}  kl {kl_ent:+.4f}  "
          f"delta {kl_ent - base_ent:+.4f}  (gate >= +{ENT_MARGIN})", flush=True)
    print(f"  routing-z       : baseline {base_z:+.4f}  kl {kl_z:+.4f}  "
          f"delta {kl_z - base_z:+.4f}  (gate >= +{Z_MARGIN})", flush=True)
    print(f"  held-out CE     : baseline {base_ce:+.4f}  kl {kl_ce:+.4f}  "
          f"delta {kl_ce - base_ce:+.4f}  (budget <= +{CE_BUDGET})", flush=True)
    print(f"  F-CLM-DK-ENTROPY : {'PASS' if gate_entropy else 'FAIL'}", flush=True)
    print(f"  F-CLM-DK-Z       : {'PASS' if gate_z else 'FAIL'}", flush=True)
    print(f"  F-CLM-DK-BUDGET  : {'PASS' if gate_budget else 'FAIL'}", flush=True)
    print(f"  LEVER-A SUPPORTED (all 3) : {supported}", flush=True)
    print(f"  VERDICT : {'GREEN (lever A raises diversity within budget)' if supported else 'RED (lever A fails a gate)'}",
          flush=True)

    out = {
        "experiment": "H_869 dispatch-KL distill routing (lever A)",
        "arm": ARM, "rung": "mid(d512/L8/E8)", "seeds": SEEDS,
        "kl_coef": KL_COEF, "steps": STEPS, "lr": LR,
        "corpus": "real kowiki two-lane (stage2_real_corpus.make_real_corpus)",
        "device": DEVICE, "n_null": N_NULL,
        "gates": {"ENT_MARGIN": ENT_MARGIN, "Z_MARGIN": Z_MARGIN,
                  "CE_BUDGET": CE_BUDGET},
        "dispatch_kl_metric": "KL(uniform || batch-mean dispatch f); f=out['usage']",
        "routing_z_metric": "(obs_entropy - mu_null)/sd_null, null=Dirichlet(1) over E (verbatim judge_clm.routing_z)",
        "per_run": per_run,
        "mean": {
            "baseline_dispatch_entropy": base_ent, "kl_dispatch_entropy": kl_ent,
            "baseline_routing_z": base_z, "kl_routing_z": kl_z,
            "baseline_heldout_ce": base_ce, "kl_heldout_ce": kl_ce,
            "delta_dispatch_entropy": round(kl_ent - base_ent, 4),
            "delta_routing_z": round(kl_z - base_z, 4),
            "delta_heldout_ce": round(kl_ce - base_ce, 4),
        },
        "gate_entropy": gate_entropy, "gate_z": gate_z, "gate_budget": gate_budget,
        "lever_a_supported": supported,
        "verdict": "GREEN" if supported else "RED",
        "torch": torch.__version__,
    }
    jdest = os.environ.get("H869_JSON_OUT", "/tmp/h869_result.json")
    with open(jdest, "w") as f:
        json.dump(out, f, indent=2)
    print(f"\nwrote JSON -> {jdest}", flush=True)


if __name__ == "__main__":
    main()
