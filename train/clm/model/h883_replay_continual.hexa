"""H_883 - replay-buffer continual learning (H_875 forgetting-curve follow-on safety device).

NOTE ON LANGUAGE: this project (`h883-replay-continual`) takes `.hexa` as its native source
extension (project.tape marker). The dense torch tensor payload below is plain Python and is
executed with the system `python3` interpreter (extension-agnostic) exactly as a sibling `.py`
measurement harness would be (cf. CLM/model/h865_adapter_edge.py, array_moe.py). It imports the
H_865 adapter-edge harness VERBATIM and adds ONLY the replay interleave on top.

Question: does interleaving a SMALL replay buffer of OLD (base-ability "web" lane) samples
into the edge-only on-chip adaptation stream REDUCE catastrophic forgetting (base-ability
z_drop) versus a no-replay edge-learn run, WHILE keeping new-context gain > 0?

INVIOLABLE (H_679): on-chip learning is the sole HW<->SW difference; this is edge-only
PIECEWISE adaptation (@L1) on a FROZEN core trunk. Replay does NOT trigger a deterministic
full-retrain -- it only mixes a few old batches into the SAME edge-only Adam stream.

Edge = the H_865 trunk-adjacent thin adapter (the verified working edge; H_861 readout-only
was lever-less 🔴). Backbone reused from HF dancinlab/anima-clm-verify (a_hf_complete, no new
model artifact). SW-sim of the non-deterministic on-chip edge-learn is acceptable at the
measurement rung (a_scale_honest_scope); foundation H_679 established HW edge-learn is real.

W2 discipline: thresholds FROZEN in .verdicts/clm-replay-continual/F-CLM-REPLAY_prereg.txt
BEFORE this fire. post-tuning = 0. A 🔴 is reported honestly (a_paper_negative_ok).
Scope: MEASUREMENT rung (mid d512/L8/E8) only.

The no_replay arm IS the H_875 no-replay baseline, measured side-by-side in the same run,
so the replay-vs-no-replay contrast holds even though H_875's own verdict has not landed.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

import torch

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
# Reuse the H_865 adapter-edge harness VERBATIM: model load, adapter edge, batch generators,
# CE eval, frozen seeds. Only the adaptation STREAM (replay interleave) is new here.
import h865_adapter_edge as H  # noqa: E402

# ---- frozen knobs (prereg F-CLM-REPLAY) ----
STEP_LADDER = [32, 128, 300]      # 300 anchors the H_861/H_865 endpoint verbatim
REPLAY_RATIO = 0.25               # every 4th step is a base-ability replay step
N_EVAL_BATCHES = 16               # reduced 32->16 for CPU wall-time; identical across arms
THR_Z_DROP = H.THR_Z_DROP         # 1.0 (carried; secondary BOUND check)
PRIMARY_STEP = 300                # the endpoint the verdict is read at


def build_data(device):
    """All batches use H.make_lane_bytes / H.batchify VERBATIM (frozen seeds)."""
    base_bytes = H.make_lane_bytes("web", 30000, H.BASE_SEED)
    new_bytes = H.make_lane_bytes("new", 30000, H.NEW_SEED)
    bhalf = len(base_bytes) // 2
    nhalf = len(new_bytes) // 2

    # base-ability held-out eval slice (the "old" ability we must not forget)
    base_eval = H.batchify(base_bytes[bhalf:], H.SEQ_LEN, N_EVAL_BATCHES, H.BATCH_SIZE, H.BASE_SEED)
    # base-ability REPLAY buffer -- DISJOINT first half (never overlaps the eval slice)
    max_steps = max(STEP_LADDER)
    replay_buf = H.batchify(base_bytes[:bhalf], H.SEQ_LEN, max_steps, H.BATCH_SIZE, H.BASE_SEED + 7)
    # new-context held-out eval + train (disjoint halves), train as a deterministic prefix
    new_eval = H.batchify(new_bytes[nhalf:], H.SEQ_LEN, N_EVAL_BATCHES, H.BATCH_SIZE, H.NEW_SEED + 1)
    new_train = H.batchify(new_bytes[:nhalf], H.SEQ_LEN, max_steps, H.BATCH_SIZE, H.NEW_SEED + 2)
    return base_eval, replay_buf, new_eval, new_train


def adapt(base, condition, steps, base_eval, replay_buf, new_eval, new_train, device):
    """One fresh edge-only adaptation run. condition in {'no_replay','replay'}."""
    model = H.AdaptedCLM(base).to(device)
    model.eval()
    ce_base_pre, sd_base_pre = H.eval_ce(model, base_eval)
    ce_new_pre, _ = H.eval_ce(model, new_eval)

    opt = torch.optim.Adam(model.adapter.parameters(), lr=H.LR_EDGE)
    model.train()
    new_cursor = 0          # only advances on NEW-context steps (deterministic prefix shared)
    replay_period = int(round(1.0 / REPLAY_RATIO))  # = 4
    n_replay = 0
    for i in range(steps):
        is_replay = (condition == "replay") and ((i + 1) % replay_period == 0)
        if is_replay:
            toks, tgts = replay_buf[i]      # base-ability "old" batch from the replay buffer
            n_replay += 1
        else:
            toks, tgts = new_train[new_cursor]
            new_cursor += 1
        toks, tgts = toks.to(device), tgts.to(device)
        out = model(toks, tgts)
        opt.zero_grad()
        out["ce_loss"].backward()
        opt.step()
    model.eval()
    ce_base_post, _ = H.eval_ce(model, base_eval)
    ce_new_post, _ = H.eval_ce(model, new_eval)

    z_drop = (ce_base_post - ce_base_pre) / max(sd_base_pre, 1e-6)
    gain = ce_new_pre - ce_new_post
    return {
        "condition": condition,
        "steps": steps,
        "n_replay_steps": n_replay,
        "n_new_steps": new_cursor,
        "ce_base_pre": round(ce_base_pre, 5),
        "sd_base_pre": round(sd_base_pre, 5),
        "ce_base_post": round(ce_base_post, 5),
        "ce_new_pre": round(ce_new_pre, 5),
        "ce_new_post": round(ce_new_post, 5),
        "z_drop": round(z_drop, 5),
        "gain": round(gain, 5),
        "retain_pass": bool(z_drop < THR_Z_DROP),
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ckpt", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--threads", type=int, default=0)
    args = ap.parse_args()
    if args.threads > 0:
        torch.set_num_threads(args.threads)
    device = "cuda" if torch.cuda.is_available() else "cpu"
    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)

    base, cfg, missing, unexpected, _ = H.infer_config_and_load(args.ckpt)
    base = base.to(device)
    print("[h883] backbone d=%d L=%d E=%d V=%d params=%d device=%s threads=%d" % (
        cfg.d_model, cfg.n_trunk_layers, cfg.n_experts, cfg.vocab_size,
        base.num_params(), device, torch.get_num_threads()))
    print("[h883] load missing=%s unexpected=%s" % (missing, unexpected))

    base_eval, replay_buf, new_eval, new_train = build_data(device)

    curves = {"no_replay": [], "replay": []}
    for steps in STEP_LADDER:
        for cond in ("no_replay", "replay"):
            row = adapt(base, cond, steps, base_eval, replay_buf, new_eval, new_train, device)
            curves[cond].append(row)
            print("[h883 %s S=%d] z_drop=%.4f gain=%.4f (replay_steps=%d new_steps=%d)" % (
                cond, steps, row["z_drop"], row["gain"], row["n_replay_steps"], row["n_new_steps"]))

    # verdict read at the PRIMARY_STEP endpoint (frozen)
    nr = next(r for r in curves["no_replay"] if r["steps"] == PRIMARY_STEP)
    rp = next(r for r in curves["replay"] if r["steps"] == PRIMARY_STEP)
    R_pass = bool(rp["z_drop"] < nr["z_drop"])      # replay reduces forgetting
    G_pass = bool(rp["gain"] > 0.0)                  # replay keeps a real new-context gain
    verdict = "GREEN" if (R_pass and G_pass) else "RED"

    result = {
        "campaign": "H_883 replay-buffer continual learning (H_875 forgetting-curve safety device)",
        "rung": "mid d512/L8/E8",
        "edge": "H_865 trunk-adjacent thin adapter (rank=%d) -> FROZEN readout" % H.ADAPTER_RANK,
        "frozen_thresholds": "F-CLM-REPLAY_prereg.txt (frozen 2026-05-31)",
        "replay_ratio": REPLAY_RATIO,
        "step_ladder": STEP_LADDER,
        "primary_step": PRIMARY_STEP,
        "curves": curves,
        "verdict_block": {
            "primary_step": PRIMARY_STEP,
            "z_drop_no_replay": nr["z_drop"],
            "z_drop_replay": rp["z_drop"],
            "gain_no_replay": nr["gain"],
            "gain_replay": rp["gain"],
            "R_replay_reduces_zdrop": R_pass,
            "G_replay_gain_positive": G_pass,
            "delta_z_drop": round(rp["z_drop"] - nr["z_drop"], 5),
            "verdict": verdict,
        },
        "note": "SW-sim edge-learn (H_679 real, sole HW<->SW diff); edge-only piecewise @L1, "
                "core trunk FROZEN; no deterministic full-retrain; no_replay arm = side-by-side "
                "H_875 baseline; measurement rung only (a_scale_honest_scope); a_paper_negative_ok",
    }
    out_path = os.path.join(args.out, "clm_replay_continual_result.json")
    with open(out_path, "w") as f:
        json.dump(result, f, indent=2)
    print("[h883] wrote", out_path)
    print("[h883 VERDICT] %s  (z_drop replay=%.4f vs no_replay=%.4f · gain replay=%.4f)" % (
        verdict, rp["z_drop"], nr["z_drop"], rp["gain"]))
    print("=== H883 COMPLETE ===")


if __name__ == "__main__":
    main()
