// ════════════════════════════════════════════════════════════════════════════
//  h870_expert_choice.hexa — expert-choice routing variant (@L3 lever C)
//
//  H_870: invert the routing DIRECTION on the pluggable routing-escape slot
//  (routing_escape.hexa lever C). token-choice (baseline, array_moe) = each
//  TOKEN picks its top-k EXPERTS → data-dependent load → can collapse/monopolize
//  (H_847/H_852 routing-z 🔴 at toy scale). expert-choice (this variant) = each
//  EXPERT picks its fixed top-C TOKENS (Zhou et al. 2022) → per-expert LOAD is
//  balanced BY CONSTRUCTION, no auxiliary loss, no collapse mode.
//
//  This is a NEW VARIANT; it does NOT edit array_moe.{hexa,py}. The H_870 fire
//  runs both side-by-side (identical budget/seed) and compares load-balance + CE
//  (measured by CODE, g5). HARD: pure-hexa contract surface; the dense tensor
//  payload is the sibling measurement harness. `fn main` prints the lever-C
//  contract table (side-effect-light).
//
//  HONEST (a_scale_honest_scope): toy harness ($0 CPU). toy != scale (H_666).
//  routing-z>3.0 stays the CHIP-ARRAY DEPLOY gate (separate track), NOT this
//  converse/load gate — routing_escape.hexa lever_satisfies_converse(C)=1.
// ════════════════════════════════════════════════════════════════════════════

// AKD1000 node budget per chip (P0 §11) — an expert above this is NOT chip-fit.
fn akd1000_node_budget() -> int {
    return 1200000
}

// per-expert capacity C = ceil(capacity_factor * n_tokens / n_experts).
// Under expert-choice every expert processes EXACTLY C tokens → load balanced.
fn expert_capacity(n_tokens: int, n_experts: int, capacity_factor_milli: int) -> int {
    // capacity_factor passed as milli-units (1000 = 1.0) to stay integer-pure.
    let num = capacity_factor_milli * n_tokens + (n_experts * 1000 - 1)
    let cap = num / (n_experts * 1000)
    if cap < 1 { return 1 }
    if cap > n_tokens { return n_tokens }
    return cap
}

// routing direction of this variant (the inversion vs token-choice).
fn routing_direction() -> string {
    return "expert-choice (experts pick top-C tokens · load balanced by construction)"
}

// the baseline this variant is compared against in the H_870 fire.
fn baseline_direction() -> string {
    return "token-choice (tokens pick top-k experts · array_moe.py · data-dependent load)"
}

// the routing-escape lever this variant implements.
fn lever() -> string {
    return "C"
}

// converse-ok under a_scale_honest_scope (load/converse gate, not deploy gate).
fn lever_satisfies_converse() -> int {
    return 1
}

fn main() {
    println("H_870 expert-choice routing variant (@L3 routing-escape lever "
        + lever() + ")")
    println("  direction = " + routing_direction())
    println("  baseline  = " + baseline_direction())
    println("  AKD1000 chip-fit budget = " + to_string(akd1000_node_budget()) + " nodes")
    // example: 1024 tokens, 8 experts, capacity_factor 1.0 → C = 128 each.
    let cap = expert_capacity(1024, 8, 1000)
    println("  capacity(N=1024,E=8,cf=1.0) = " + to_string(cap)
        + " tokens/expert (load balanced by construction)")
    println("  converse-ok (a_scale_honest_scope load gate) = "
        + to_string(lever_satisfies_converse())
        + " · routing-z>3.0 = chip-array DEPLOY gate (separate track)")
}
