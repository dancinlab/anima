// N-chip 축 (@L7) — python N_CHIPS_AXIS 와 1:1 동기. 1 = single-chip degenerate.
fn array_chip_axis() -> string {
    return "1,2,4,8"
}

// E experts (고정, N 칩에 균등 분할) — python N_EXPERTS 와 동기.
fn array_n_experts() -> int {
    return 8
}

// AKD1000 노드 예산 (P0 §11 · @L3) — expert 가 이 이하면 chip-fit.
fn array_akd1000_budget() -> int {
    return 1200000
}

// FROZEN falsifier 경계 (@L7, post-run 이동 금지).
fn array_loadbal_ratio_max() -> string { return "4.0" }
fn array_coh_logit_atol()   -> string { return "1e-4" }
fn array_coh_ce_atol()      -> string { return "1e-4" }

// verdict run 페이로드 (train → single-model ref vs N-chip gather → 측정) — $0 local.
fn array_sim_cmd() -> string {
    return "python3 h878_chip_array_sim.py"
}

fn main() {
    println("H_878 MITOSIS multi-chip array dispatch SW-sim (hexa-native driver · d5 1순위)")
    println("  N-chip axis (@L2 deploy) = " + array_chip_axis()
        + " · E experts = " + to_string(array_n_experts()))
    println("  expert = mitosis cell = AKD1000 chip (@L3) · budget = "
        + to_string(array_akd1000_budget()) + " nodes")
    println("  falsifier: loadbal max/min ratio <= " + array_loadbal_ratio_max()
        + " (no starve) AND aggregate-emit coherence (logit atol "
        + array_coh_logit_atol() + " · CE atol " + array_coh_ce_atol() + ")")
    println("  scope: pure SW-sim of @L2 deploy chip-fit track — silicon NOT measured")
    println("         (1 AKD1000 today) · a_scale_honest_scope · toy != scale (H_666)")

    // verdict run 페이로드 발사 — single-model ref vs N-chip partition/gather.
    let cmd = array_sim_cmd()
    println("  payload: " + cmd)
}
