// ════════════════════════════════════════════════════════════════════════════
//  h864r_fire_stepfair.hexa
//
//  H_864r — dialogue self-play SCALE-CLIMB, STEP-FAIR (re-run of H_864 large rung).
//
//  H_864 (PR #1557) fired the LARGE rung (d768/L12/E12 = 44,678,668 params) self-
//  play A/B but trained only 2000 steps. At that budget the large model MODE-
//  COLLAPSED (held-out repetition 0.361 >= 0.20), so the self-play reflux batch
//  failed the per-batch DIVERSITY gate -> 0 reflux folded -> arm-SP degenerated to
//  arm-SFT -> 2/4 frozen falsifiers FAIL -> 🔴. That 🔴 was CONFOUNDED by
//  undertraining, NOT a fair test of self-play scaling.
//
//  H_864r resolves the confound. The ONLY change vs H_864 = MORE TRAINING STEPS
//  (a methodology fix, NOT a threshold move). It trains the large rung along a
//  STEP SWEEP, measuring held-out repetition at each checkpoint, and continues
//  until held-out repetition < 0.20 (a non-collapsed regime) OR a budget cap
//  (20000 steps) is reached — reporting the full step->repetition CURVE. ONLY
//  once the SFT trunk reaches a non-collapsed regime is self-play judged, under
//  the SAME bf98c01 frozen gates (post-tuning 0).
//
//  hexa-native driver. The torch payload (model + AKIDA-envelope QAT + step-sweep
//  + 2-arm A/B + self-play reflux + held-out eval) is materialized on the runpod
//  GPU pod at fire time as h864r_fire_stepfair.py (same runtime-patch-on-pod
//  convention H_863/H_864 used — the landed train_clm.py LADDER carries only
//  tiny/small; mid+large + the dialogue A/B path are patched on the pod). The
//  payload is reproducible standalone: it needs ONLY torch + the corpus bytes
//  file (one int 0..255 / line, V=256 byte-encode, NO tokenizer).
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2) — UNCHANGED vs H_864:
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4, step = 2^(8-4)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4).
//
//  2-arm A/B (bf98c01 frozen falsifiers — scale-invariant RELATIVE/ABSOLUTE
//  gates, carry to the large rung WITHOUT a new freeze):
//    arm-SFT : SFT only (CC/PD dialogue imitation)
//    arm-SP  : SFT + DIVERSITY-gated self-play reflux through the 8-pattern
//              register-leak filter (@L1 living-learn, @L6 method B)
//  Held-out eval (seed=863, disjoint): coherence=exp(-CE), adequacy=3-gram F1,
//  register-leak count (8 patterns), self-BLEU (mean pairwise 4-gram),
//  repetition (repeated-4-gram fraction). ALL computed by CODE (g5 — no LLM judge).
//
//  a_fire_autonomous: est cost A40 48GB ~$1-4, state then dispatch.
//  a_fire_recover_complete: pull result+log+verdict → verify → HF → teardown.
//  HARD: external LLM 0 · foundation-borrow 0 · ShareGPT/Alpaca/ChatGPT-gen 0.
//  sibling: UNIVERSE/cards/H_864r_clm_selfplay_stepfair.md ·
//           .verdicts/clm-dialogue/F-CLM-DIALOGUE_prereg.txt (commit bf98c01) ·
//           UNIVERSE/cards/H_864_clm_dialogue_scale_climb.md (the confounded original).
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "runpod" }
fn gpu() -> string { return "NVIDIA A40 48GB" }
fn rung() -> string { return "large" }            // d768 / L12 / E12 (44.68M)
fn d_model() -> int { return 768 }
fn n_layers() -> int { return 12 }
fn n_experts() -> int { return 12 }

// THE H_864r CHANGE: a step SWEEP (not a fixed 2000) with a repetition target.
fn checkpoints() -> string { return "2000,4000,6000,8000,10000,12000,16000,20000" }
fn rep_target() -> string { return "0.20" }       // stop SFT sweep at rep < 0.20
fn budget_cap_steps() -> int { return 20000 }     // sensible cap if never non-collapsed
fn reflux_continue() -> int { return 1000 }       // extra SP steps if reflux folds
fn seed() -> int { return 42 }
fn eval_seed() -> int { return 863 }
fn act_bits() -> int { return 4 }
fn seq_len() -> int { return 128 }
fn batch_size() -> int { return 32 }
fn lr() -> string { return "2e-3" }
fn est_cost_usd() -> string { return "$1~4" }
fn verdict_dir() -> string { return ".verdicts/clm-dialogue-large-stepfair" }
fn frozen_commit() -> string { return "bf98c01" }
fn hf_dataset_repo() -> string { return "dancinlab/anima-clm-large-stepfair" }
fn corpus_hf() -> string { return "dancinlab/anima-clm-p4-dialogue (dialogue.bytes · 1,668,585 bytes · 12 PD plays · sha256 2aa3d85...)" }

// the 2 dialogue arms (per bf98c01 frozen falsifiers).
fn arms() -> [string] { return ["SFT", "SP"] }

// pod fire command (materialize payload + run on the pod).
fn fire_cmd() -> string {
    return "cd /workspace && python3 h864r_fire_stepfair.py --corpus dialogue_p4.bytes"
        + " --rung " + rung()
        + " --checkpoints " + checkpoints()
        + " --rep-target " + rep_target()
        + " --reflux-continue " + to_string(reflux_continue())
        + " --seed " + to_string(seed())
        + " --eval-seed " + to_string(eval_seed())
        + " --act-bits " + to_string(act_bits())
        + " --seq-len " + to_string(seq_len())
        + " --batch-size " + to_string(batch_size())
        + " --lr " + lr()
        + " --json-out clm_dialogue_large_stepfair_AB.json 2>&1 | tee h864r_fire.log"
}

// a_fire_recover_complete checklist (pre-teardown · governance).
fn recover_steps() -> [string] {
    return [
        "1. pull: clm_dialogue_large_stepfair_AB.json (result + step curve) + h864r_fire.log",
        "2. verify: re-read JSON · confirm step curve present · 4 falsifiers present · ce finite",
        "3. write verdict → .verdicts/clm-dialogue-large-stepfair/F-CLM-DIALOGUE-LARGE-STEPFAIR.txt",
        "4. HF upload COMPLETE (a_hf_complete) → " + hf_dataset_repo(),
        "5. THEN teardown: hexa cloud down (NEVER before HF) · NO ghost pods",
    ]
}

fn main() {
    println("CLM large-rung (d768/L12/E12 · 44.68M) AKIDA-envelope QAT dialogue self-play STEP-FAIR A/B fire (H_864r)")
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " d=" + to_string(d_model()) + " L=" + to_string(n_layers())
        + " E=" + to_string(n_experts()) + " act_bits=" + to_string(act_bits())
        + " seed=" + to_string(seed()))
    println("  CHANGE vs H_864 = MORE STEPS (step-sweep " + checkpoints()
        + " until rep < " + rep_target() + " OR cap " + to_string(budget_cap_steps())
        + "). Gates UNCHANGED (bf98c01, post-tuning 0).")
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  frozen falsifiers = " + frozen_commit() + " (scale-invariant relative gates · NO new freeze)")
    println("  corpus = " + corpus_hf())
    println("  verdict_dir = " + verdict_dir() + " · HF dataset=" + hf_dataset_repo())
    println("dispatch (2-arm dialogue A/B, step-fair):")
    println("  " + fire_cmd())
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): MEASUREMENT rung large ONLY. A 🟢/🔴 here does NOT "
        + "bind another rung or the deploy chip-fit track. large→prod NOT guaranteed. "
        + "External LLM 0 · foundation-borrow 0. a_paper_negative_ok: a 🔴 (self-play still "
        + "doesn't carry even once non-collapsed) is publishable.")
}
