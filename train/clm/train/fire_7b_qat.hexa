// ════════════════════════════════════════════════════════════════════════════
//  fire_7b_qat.hexa — 7B-rung (d5120/L40/E48) AKIDA-envelope QAT fire SPEC
//
//  FIRE-READY — not yet fired; launch via
//    `hexa cloud fire --provider runpod --gpu H100 --n 4 \
//       --cmd 'torchrun --nproc_per_node=<N> CLM/train/train_clm.py --rung 7b … --fsdp'`
//    on RUNPOD H100 80GB ×4~8 (FSDP · a_wall_first parallel) target.
//
//  P6_SCALE_LADDER_7B §1: the TOP production measurement-rung — GATED by `3b`
//  passing F-CLM-SCALE-TRANSFER (P6 §2 · no rung jump). measurement track climbs
//  ONE rung at a time; `7b` = d5120 / L40 / E48 (7,002,818,160 = 7.00B params ·
//  param formula P6 §1). DECOUPLED from the deploy chip-fit shard (≤~1.2M AKD1000
//  · H_876 1.20M) — a_scale_honest_scope: a 🔴 measurement rung does NOT block the
//  separate deploy chip-fit / expert-streaming track (P5 AXIS1).
//
//  resident != total (P5 §0 · the AXIS1 premise): 7.00B total is ~5,800× one
//  AKD1000 (~1.2M nodes). It does NOT sit resident — a single chip TRAINS/HOSTS a
//  7B-class model by STREAMING(paging) experts: total 7B on host (disk/DRAM),
//  resident ≤1.2M per instant (one expert shard). This GPU rung proves the 7B
//  backbone QUALITY; the chip cycles shards (AXIS1 ② streaming glue still OPEN).
//
//  Top of ladder — no further rung gate; verdict feeds SBS.md R4 (backbone
//  production-scale gate → coffeeshop group-chat launch).
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2):
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4 envelope, step = 2^(8-4)        (LIF comparator @ act_bits=1)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4) — byte-identical chip transplant.
//
//  Fire = 3-arm (A/B/AB) × seed 42 × 2000 step · FSDP across H100 fleet.
//  a_fire_autonomous: state est cost (~$150~400 / ~24~48h wall) in one line, then dispatch.
//  a_wall_first: parallel H100s (FSDP) over a serial chain — bigger/more GPUs if faster.
//  a_fire_recover_complete: pull ckpt+result+log+anchors → verify → HF upload → teardown.
//  Provider = runpod. GPU = H100 80GB ×4~8 (7.00B → FSDP fully-sharded; single 80GB insufficient).
//
//  HARD: pure-hexa SPEC/driver · NO external LLM · NO foundation-borrow (pure scratch QAT ·
//  random-init · byte V=256 own-tokenizer · NO 3B-rung weight borrow as init).
//  The torch payload is the LANDED CLM/train/train_clm.py (7b rung added to its LADDER:
//  d_model=5120, n_trunk_layers=40, n_experts=48) — this driver records the dispatch
//  contract + verdict path. sibling: train_clm.py · fire_3b_rung_qat.hexa · P5_AKIDA_7B_STRATEGY.md
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "runpod" }
fn gpu() -> string { return "NVIDIA H100 80GB ×4~8 (FSDP · a_wall_first)" }
fn rung() -> string { return "7b" }           // d5120 / L40 / E48 = 7.00B
fn steps() -> int { return 2000 }
fn seed() -> int { return 42 }
fn act_bits() -> int { return 4 }
fn n_gpu() -> int { return 4 }                // a_wall_first: scale up to 8 if faster
fn est_cost_usd() -> string { return "~$150~400 / ~24~48h wall (H100 fleet · a_wall_first)" }
fn verdict_dir() -> string { return ".verdicts/clm-prod-rung/7b" }
fn hf_repo() -> string { return "dancinlab/anima-clm-7b" }   // measurement ckpt

// the 3 router arms swept at this rung (P0 §3 ablation).
fn arms() -> [string] { return ["A", "B", "AB"] }

// per-arm fire command (the landed QAT trainer · 7b rung · FSDP torchrun).
fn fire_cmd(arm: string) -> string {
    return "torchrun --nproc_per_node=" + to_string(n_gpu())
        + " CLM/train/train_clm.py --arm " + arm + " --rung " + rung()
        + " --steps " + to_string(steps()) + " --seed " + to_string(seed())
        + " --act-bits " + to_string(act_bits()) + " --fsdp"
        + " --json-out out/clm_7b_" + arm + "_s" + to_string(seed()) + ".json"
}

// gate: this rung fires ONLY after `3b` passes F-CLM-SCALE-TRANSFER (P6 §2).
fn precondition() -> string {
    return "REQUIRE .verdicts/clm-prod-rung/3b/ PASS (3B→7B gate · no rung jump · P6 §2)"
}

// F-CLM-SCALE-TRANSFER pre-registered gate (top rung · feeds SBS.md R4) — P6 §2.
fn scale_transfer_gate() -> [string] {
    return [
        "1. coherence/adequacy >= 3B (ABS-COHERE >= 0.060 floor · H_863/H_886)",
        "2. int4-envelope last_ce hold-or-improve vs 3B (QAT envelope)",
        "3. routing-z non-degenerate (48/48 expert distinct · H_871)",
        "4. register-leak = 0 (identity register · H_863)",
        "5. identity-anchor drift bounded (DIST<0.50 · PROBE>0.80 · H_873/884)",
    ]
}

// a_fire_recover_complete checklist (pre-teardown · governance).
fn recover_steps() -> [string] {
    return [
        "1. pull: out/clm_7b_*.json (result) + clm_fire.log (log) + FSDP ckpt shards + anchors",
        "2. verify: re-read JSON · confirm last_ce finite · step_rate>0",
        "3. write verdict → .verdicts/clm-prod-rung/7b/F-CLM-SCALE-TRANSFER.txt (verbatim)",
        "4. HF upload COMPLETE (a_hf_complete · ALL FSDP shards) → dancinlab/anima-clm-7b",
        "5. THEN teardown: hexa cloud rm <pod-id(s)> --provider runpod",
    ]
}

fn main() {
    println("CLM 7B-rung (d5120/L40/E48 · 7.00B) AKIDA-envelope QAT fire SPEC (P6 §1)")
    println("  FIRE-READY — NOT yet fired; launch on runpod H100 ×4~8 (FSDP)")
    println("  " + precondition())
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " steps=" + to_string(steps()) + " seed=" + to_string(seed())
        + " act_bits=" + to_string(act_bits()) + " n_gpu=" + to_string(n_gpu()))
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  verdict_dir = " + verdict_dir() + " · HF = " + hf_repo())
    println("dispatch (3-arm sweep · FSDP):")
    for arm in arms() { println("  " + fire_cmd(arm)) }
    println("F-CLM-SCALE-TRANSFER gate (top rung · feeds SBS.md R4 · P6 §2):")
    for g in scale_transfer_gate() { println("  " + g) }
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): resident != total (P5 §0 · AXIS1 premise) — 7.00B "
        + "= ~5,800× one AKD1000; NOT chip-resident. one chip STREAMS expert shards (≤1.2M "
        + "resident · H_876), total 7B on host. This rung proves backbone QUALITY on GPU; "
        + "PASS feeds SBS.md R4 backbone-production-scale gate → coffeeshop launch.")
}
