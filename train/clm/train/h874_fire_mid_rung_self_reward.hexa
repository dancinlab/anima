// ════════════════════════════════════════════════════════════════════════════
//  h874_fire_mid_rung_self_reward.hexa
//
//  H_874 — dialogue SELF-REWARD (@L6 method C · RLHF-like, NO external LLM/human).
//  Follow-on to H_863 (method B = SFT+self-play, 🟢 mid). Tests whether a
//  SELF-SCORED reward loop (arm-SR) beats SFT+self-play (arm-SP, the H_863
//  winner) at mid scale:
//      mid = d512 / L8 / E8 (~13.65M)  [SAME rung as H_863]
//
//  arm-SR self-reward loop (per reflux prompt):
//    1. sample K candidate continuations (temperature set) from the in-training model
//    2. score each by the REGISTERED distributional reward (g5 · NO judge model):
//         reward = w_coh*coherence + w_adq*adequacy + w_div*diversity_bonus
//       (coherence = exp(-CE) of the model on the candidate; adequacy = 3-gram F1
//        vs reference next turn; diversity_bonus = 1 - self-BLEU vs siblings)
//    3. REJECT candidates hitting the 8-pattern leak filter OR the DIVERSITY gate
//    4. fold the BEST-OF-K (highest reward) surviving candidate back as the reflux
//       training target (reward-weighted / best-of-K selection)
//  arm-SP baseline = the H_863 DIVERSITY-gated self-play reflux (NO reward selection).
//
//  The reward IS the eval signal applied at training-selection time = the RLHF-like
//  self-reward construction with NO external LLM/human (g5 · @L4 external-LLM 0).
//
//  hexa-native driver. The torch payload (model + AKIDA-envelope QAT + 2-arm A/B
//  + self-reward loop + held-out eval) is EMBEDDED here as `payload()` and
//  materialized on the runpod GPU pod at fire time as h874_fire.py, then run —
//  the same runtime-patch-on-pod convention the H_863 mid fire used. The payload
//  is reproducible standalone: it needs ONLY torch + the corpus bytes file
//  (one int 0..255 / line, V=256 byte-encode, NO tokenizer).
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2):
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4, step = 2^(8-4)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4).
//
//  W2 frozen falsifiers (d5103f-style freeze · pushed BEFORE the fire):
//    F-CLM-SR-COHERE : coherence(SR)   > coherence(SP)    (strict · RELATIVE)
//    F-CLM-SR-ADEQ   : adequacy_f1(SR) > adequacy_f1(SP)  (strict · RELATIVE)
//    F-CLM-SR-LEAK   : register_leak(SR) == 0             (ABSOLUTE gate on SR)
//    F-CLM-SR-DIV    : self_bleu(SR) < 0.80 ∧ repetition(SR) < 0.20  (mode-collapse)
//  byte-match ✗ — distributional / trajectory measures (Q-TRUST A · H_857/H_858).
//
//  a_fire_autonomous: est cost A40/L40S ~$0.4-1.0, state then dispatch.
//  a_fire_recover_complete: pull ckpt+result+log+verdict → verify → HF → teardown.
//  a_scale_honest_scope: mid rung · RELATIVE (vs SP) test. H_867 showed arm-SP is
//    BELOW the absolute floor at mid, so a 🟢 here = "SR beats SP at mid", NOT a
//    deployability/floor claim.
//  HARD: external LLM 0 · foundation-borrow 0 · ShareGPT/Alpaca/ChatGPT-gen 0.
//  sibling: UNIVERSE/cards/H_874_clm_self_reward.md ·
//           .verdicts/clm-self-reward/F-CLM-SELF-REWARD_prereg.txt
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "runpod" }
fn gpu() -> string { return "NVIDIA L40S / A40" }
fn rung() -> string { return "mid" }              // d512 / L8 / E8
fn d_model() -> int { return 512 }
fn n_layers() -> int { return 8 }
fn n_experts() -> int { return 8 }
fn steps() -> int { return 1500 }                 // SFT budget (equal both arms)
fn reflux_continue() -> int { return 500 }        // reflux-continue steps (equal both arms)
fn candidates_k() -> int { return 6 }             // best-of-K for arm-SR self-reward
fn seed() -> int { return 42 }
fn eval_seed() -> int { return 863 }
fn act_bits() -> int { return 4 }
fn est_cost_usd() -> string { return "$0.4~1.0" }
fn verdict_dir() -> string { return ".verdicts/clm-self-reward" }
fn hf_model_repo() -> string { return "dancinlab/anima-clm-self-reward" }
fn hf_dataset_repo() -> string { return "dancinlab/anima-clm-p4-dialogue" }

// the 2 dialogue arms (@L6 method-C A/B).
fn arms() -> [string] { return ["SP", "SR"] }

// pod fire command (materialize payload + run on the pod).
fn fire_cmd() -> string {
    return "cd /workspace && python3 h874_fire.py --corpus dialogue.bytes"
        + " --rung " + rung()
        + " --steps " + to_string(steps())
        + " --reflux-continue " + to_string(reflux_continue())
        + " --candidates-k " + to_string(candidates_k())
        + " --seed " + to_string(seed())
        + " --eval-seed " + to_string(eval_seed())
        + " --act-bits " + to_string(act_bits())
        + " --json-out clm_self_reward_mid_AB.json 2>&1 | tee clm_fire.log"
}

// a_fire_recover_complete checklist (pre-teardown · governance).
fn recover_steps() -> [string] {
    return [
        "1. pull: clm_self_reward_mid_AB.json (result) + clm_fire.log + ckpt(s)",
        "2. verify: re-read JSON · confirm ce_heldout finite · 4 falsifiers present",
        "3. write verdict → .verdicts/clm-self-reward/F-CLM-SELF-REWARD.txt (verbatim)",
        "4. HF upload COMPLETE (a_hf_complete) → " + hf_model_repo() + " + " + hf_dataset_repo(),
        "5. THEN teardown: hexa cloud down <id> (NEVER before HF)",
    ]
}

fn main() {
    println("CLM mid-rung (d512/L8/E8) AKIDA-envelope QAT dialogue SELF-REWARD A/B fire (H_874)")
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " d=" + to_string(d_model()) + " L=" + to_string(n_layers())
        + " E=" + to_string(n_experts()) + " steps=" + to_string(steps())
        + " reflux=" + to_string(reflux_continue()) + " K=" + to_string(candidates_k())
        + " act_bits=" + to_string(act_bits()) + " seed=" + to_string(seed()))
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  arms = SP (H_863 self-play baseline) vs SR (self-reward best-of-K) · equal budget")
    println("  reward = w_coh*coherence + w_adq*adequacy + w_div*diversity_bonus (g5 · NO judge)")
    println("  verdict_dir = " + verdict_dir() + " · HF model=" + hf_model_repo())
    println("dispatch (2-arm self-reward A/B):")
    println("  " + fire_cmd())
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): MEASUREMENT rung mid · RELATIVE (SR vs SP). "
        + "H_867 showed arm-SP < absolute floor at mid, so 🟢 here = 'SR beats SP at mid', "
        + "NOT a deployability/floor claim. External LLM 0 · foundation-borrow 0.")
}
