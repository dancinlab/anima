// ════════════════════════════════════════════════════════════════════════════
//  h864_fire_large_rung_selfplay.hexa
//
//  H_864 — dialogue self-play SCALE-CLIMB (one rung UP from H_863 mid).
//  Climbs the H_863 🟢 (self-play > SFT-only dialogue) result one rung up:
//      mid   = d512 / L8  / E8   (~13.65M)   [H_863]
//   -> large = d768 / L12 / E12  (~2-3x mid) [THIS FIRE]
//
//  hexa-native driver. The torch payload (model + AKIDA-envelope QAT + 2-arm
//  A/B + held-out eval) is EMBEDDED here as `payload()` and materialized on the
//  runpod GPU pod at fire time as h864_fire.py, then run — the same runtime-
//  patch-on-pod convention the H_863 mid fire used (the landed train_clm.py
//  LADDER only carries tiny/small; mid + the dialogue A/B path were patched on
//  the pod). The payload is reproducible standalone: it needs ONLY torch + the
//  corpus bytes file (one int 0..255 / line, V=256 byte-encode, NO tokenizer).
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2):
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4, step = 2^(8-4)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4).
//
//  2-arm A/B (bf98c01 frozen falsifiers — scale-invariant RELATIVE gates,
//  carry to large rung WITHOUT a new freeze):
//    arm-SFT : SFT only (CC/PD dialogue imitation)
//    arm-SP  : SFT + DIVERSITY-gated self-play reflux through the 8-pattern
//              register-leak filter (@L1 living-learn, @L6 method B)
//  Held-out eval (seed=863, disjoint): coherence=exp(-CE), adequacy=3-gram F1,
//  register-leak count (8 patterns), self-BLEU (mean pairwise 4-gram),
//  repetition (repeated-4-gram fraction). ALL computed by CODE (g5 — no LLM judge).
//
//  a_fire_autonomous: est cost A40/L40S ~$8-25, state then dispatch.
//  a_fire_recover_complete: pull ckpt+result+log+verdict → verify → HF → teardown.
//  HARD: external LLM 0 · foundation-borrow 0 · ShareGPT/Alpaca/ChatGPT-gen 0.
//  sibling: UNIVERSE/cards/H_864_clm_dialogue_scale_climb.md ·
//           .verdicts/clm-dialogue/F-CLM-DIALOGUE_prereg.txt (commit bf98c01).
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "runpod" }
fn gpu() -> string { return "NVIDIA L40S / A40" }
fn rung() -> string { return "large" }            // d768 / L12 / E12
fn d_model() -> int { return 768 }
fn n_layers() -> int { return 12 }
fn n_experts() -> int { return 12 }
fn steps() -> int { return 2000 }
fn reflux_continue() -> int { return 500 }
fn seed() -> int { return 42 }
fn eval_seed() -> int { return 863 }
fn act_bits() -> int { return 4 }
fn est_cost_usd() -> string { return "$8~25" }
fn verdict_dir() -> string { return ".verdicts/clm-dialogue-large" }
fn frozen_commit() -> string { return "bf98c01" }
fn hf_model_repo() -> string { return "dancinlab/anima-clm-large" }
fn hf_dataset_repo() -> string { return "dancinlab/anima-clm-large-dialogue" }

// the 2 dialogue arms (per bf98c01 frozen falsifiers).
fn arms() -> [string] { return ["SFT", "SP"] }

// pod fire command (materialize payload + run on the pod).
fn fire_cmd() -> string {
    return "cd /workspace && python3 h864_fire.py --corpus dialogue_large.bytes"
        + " --rung " + rung()
        + " --steps " + to_string(steps())
        + " --reflux-continue " + to_string(reflux_continue())
        + " --seed " + to_string(seed())
        + " --eval-seed " + to_string(eval_seed())
        + " --act-bits " + to_string(act_bits())
        + " --json-out clm_dialogue_large_AB.json 2>&1 | tee clm_fire.log"
}

// a_fire_recover_complete checklist (pre-teardown · governance).
fn recover_steps() -> [string] {
    return [
        "1. pull: clm_dialogue_large_AB.json (result) + clm_fire.log + ckpt(s)",
        "2. verify: re-read JSON · confirm ce_heldout finite · 4 falsifiers present",
        "3. write verdict → .verdicts/clm-dialogue-large/F-CLM-DIALOGUE-LARGE.txt (verbatim)",
        "4. HF upload COMPLETE (a_hf_complete) → " + hf_model_repo() + " + " + hf_dataset_repo(),
        "5. THEN teardown: runpod GraphQL podTerminate (NEVER before HF)",
    ]
}

fn main() {
    println("CLM large-rung (d768/L12/E12) AKIDA-envelope QAT dialogue self-play A/B fire (H_864)")
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " d=" + to_string(d_model()) + " L=" + to_string(n_layers())
        + " E=" + to_string(n_experts()) + " steps=" + to_string(steps())
        + " act_bits=" + to_string(act_bits()) + " seed=" + to_string(seed()))
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  frozen falsifiers = " + frozen_commit() + " (scale-invariant relative gates · NO new freeze)")
    println("  verdict_dir = " + verdict_dir() + " · HF model=" + hf_model_repo() + " dataset=" + hf_dataset_repo())
    println("dispatch (2-arm dialogue A/B):")
    println("  " + fire_cmd())
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): MEASUREMENT rung large ONLY. A 🟢/🔴 here does NOT "
        + "bind another rung or the deploy chip-fit track. toy/large→prod NOT guaranteed. "
        + "External LLM 0 · foundation-borrow 0.")
}
