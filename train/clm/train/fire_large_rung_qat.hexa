// ════════════════════════════════════════════════════════════════════════════
//  fire_large_rung_qat.hexa — large-rung (d768/L12/E12) AKIDA-envelope QAT fire SPEC
//
//  FIRE-READY — not yet fired; launch via
//    `sidecar pool on summer 'python3 train/clm/train/train_clm.py --rung large …'`
//    (or `hexa cloud fire`) on POOL GPU target (RTX 5070 12GB · summer/aiden host).
//
//  P6_SCALE_LADDER_7B §1: the NEXT production measurement-rung above mid.
//  measurement track (GPU · AKIDA-envelope QAT) climbs ONE rung at a time;
//  `large` = d768 / L12 / E12 (44,678,668 = 44.68M params · param formula P6 §1).
//  DECOUPLED from the deploy chip-fit shard (≤~1.2M AKD1000 · H_876 1.20M) —
//  a_scale_honest_scope: a 🔴 measurement rung does NOT block the separate
//  deploy chip-fit / expert-streaming track (P5 AXIS1).
//
//  Gates the next rung (3B) via F-CLM-SCALE-TRANSFER (P6 §2):
//    coherence/adequacy hold-or-improve · int4-envelope loss hold-or-improve ·
//    routing-z NON-DEGENERATE at large (12/12 expert distinct · H_871 scale-artifact
//    test) · register-leak 0 · identity-anchor drift bounded (H_873/884).
//  large transfer of self-play (H_864/H_874 🔴 → H_888) re-measured step-fair here.
//
//  AKIDA envelope (P0 §9 · CLM_FORMAT_SPEC §2):
//    weights : int4-sym [-7,+7] per-output-channel STE   (AKIDA rejects -8)
//    acts    : act_bits=4 envelope, step = 2^(8-4)        (LIF comparator @ act_bits=1)
//    grads   : straight-through estimator (fp32 master · quantized forward)
//  Inference stays AKIDA-int4-ONLY (P0 d4) — byte-identical chip transplant.
//
//  Fire = 3-arm (A/B/AB) × seed 42 × 2000 step on the pool RTX 5070 (44.68M fits 12GB).
//  a_fire_autonomous: state est cost (~$0 owned GPU / ~6~10h wall) in one line, then dispatch.
//  a_fire_recover_complete: pull ckpt+result+log+anchors → verify → HF upload → teardown.
//  Provider = pool (owned). GPU = RTX 5070 12GB (44.68M fp32 master + Adam ≈ ~0.7GB).
//
//  HARD: pure-hexa SPEC/driver · NO external LLM · NO foundation-borrow (pure scratch QAT).
//  The torch payload is the LANDED train/clm/train/train_clm.py (large rung added to its LADDER:
//  d_model=768, n_trunk_layers=12, n_experts=12) — this driver records the dispatch
//  contract + verdict path. sibling: train_clm.py · fire_mid_rung_qat.hexa · P6_SCALE_LADDER_7B.md
// ════════════════════════════════════════════════════════════════════════════

fn provider() -> string { return "pool" }
fn gpu() -> string { return "NVIDIA RTX 5070 12GB (summer/aiden host)" }
fn rung() -> string { return "large" }        // d768 / L12 / E12 = 44.68M
fn steps() -> int { return 2000 }
fn seed() -> int { return 42 }
fn act_bits() -> int { return 4 }
fn est_cost_usd() -> string { return "~$0 (owned pool GPU) / ~6~10h wall" }
fn verdict_dir() -> string { return ".verdicts/clm-prod-rung/large" }
fn hf_repo() -> string { return "dancinlab/anima-clm-large" }   // measurement ckpt

// the 3 router arms swept at this rung (P0 §3 ablation).
fn arms() -> [string] { return ["A", "B", "AB"] }

// per-arm fire command (the landed QAT trainer · large rung).
fn fire_cmd(arm: string) -> string {
    return "python3 train/clm/train/train_clm.py --arm " + arm + " --rung " + rung()
        + " --steps " + to_string(steps()) + " --seed " + to_string(seed())
        + " --act-bits " + to_string(act_bits())
        + " --json-out out/clm_large_" + arm + "_s" + to_string(seed()) + ".json"
}

// F-CLM-SCALE-TRANSFER pre-registered gate to the next rung (3B) — P6 §2.
fn scale_transfer_gate() -> [string] {
    return [
        "1. coherence/adequacy >= mid (ABS-COHERE >= 0.060 floor · H_863/H_886)",
        "2. int4-envelope last_ce hold-or-improve vs mid (QAT envelope)",
        "3. routing-z NON-DEGENERATE at large (12/12 expert distinct · H_871 test)",
        "4. register-leak = 0 (identity register · H_863)",
        "5. identity-anchor drift bounded (DIST<0.50 · PROBE>0.80 · H_873/884)",
    ]
}

// a_fire_recover_complete checklist (pre-teardown · governance).
fn recover_steps() -> [string] {
    return [
        "1. pull: out/clm_large_*.json (result) + clm_fire.log (log) + ckpt(s) + anchors",
        "2. verify: re-read JSON · confirm last_ce finite · step_rate>0",
        "3. write verdict → .verdicts/clm-prod-rung/large/F-CLM-SCALE-TRANSFER.txt (verbatim)",
        "4. HF upload COMPLETE (a_hf_complete) → dancinlab/anima-clm-large",
        "5. THEN teardown (pool GPU release / pod rm if cloud fallback)",
    ]
}

fn main() {
    println("CLM large-rung (d768/L12/E12 · 44.68M) AKIDA-envelope QAT fire SPEC (P6 §1)")
    println("  FIRE-READY — NOT yet fired; launch on pool RTX 5070 (summer/aiden)")
    println("  provider=" + provider() + " gpu=" + gpu() + " rung=" + rung()
        + " steps=" + to_string(steps()) + " seed=" + to_string(seed())
        + " act_bits=" + to_string(act_bits()))
    println("  EST COST = " + est_cost_usd() + " (a_fire_autonomous · state then dispatch)")
    println("  envelope = int4-sym[-7,+7] per-channel STE + act_bits=4 · inference AKIDA-int4-ONLY")
    println("  verdict_dir = " + verdict_dir() + " · HF = " + hf_repo())
    println("dispatch (3-arm sweep):")
    for arm in arms() { println("  " + fire_cmd(arm)) }
    println("F-CLM-SCALE-TRANSFER gate to 3B (pre-register · P6 §2):")
    for g in scale_transfer_gate() { println("  " + g) }
    println("a_fire_recover_complete (pre-teardown):")
    for s in recover_steps() { println("  " + s) }
    println("HONEST (a_scale_honest_scope): measurement rung ⊥ deploy chip-fit shard (≤1.2M · H_876). "
        + "A 🔴 here does NOT block the separate expert-streaming deploy track (P5 AXIS1). "
        + "large 🔴 → 3B NOT fired (no rung jump · P6 §2).")
}
