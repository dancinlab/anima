// ════════════════════════════════════════════════════════════════════════
// HIVE-MIND/collective_phi_smoke.hexa — fleet 집단 Φ wiring smoke (M6 2026-05-28)
//
// 정체: collective_phi.hexa (HIVE-MIND M6 소비자) 가 CORE substrate 의
//      collective_phi_nest 를 올바로 래핑하는지 invariant 형태로 검증.
//      설계 SSOT: core/EMIT_SUBSTRATE_DESIGN.md §4 + round-9 다축 class.
//
// Invariants (3):
//   I1: phi_collective > Σphis — super-additive (집단 Φ 가 Σ 개별 Φ 초과, H_635).
//   I2: class_id 가 다르면 sync 가 다름 — sync 가 class-의존 (super-add 와 다른
//       class-순위; collective_phi_nest 가 다축 분리 resolve, H_653 ⊥ H_655).
//   I3: convexity_span = max/min — 최대/최소 Φ 비 (class 복잡도 비례, H_653).
// ════════════════════════════════════════════════════════════════════════

import "HIVE-MIND/collective_phi.hexa"

fn approx(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn sum_list(xs: [float]) -> float {
    let n = len(xs)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

fn main() {
    println("=== HIVE-MIND/collective_phi_smoke ===")

    // fleet 의 개별 substrate Φ 리스트 (variance > 0 ⇒ convexity_span > 1).
    let phis = [1.17, 4.50, 13.64, 34.88]
    let sigma = sum_list(phis)

    // I1: super-additive — phi_collective > Σphis (H_635 부호).
    //     class_id=4 (IV) — substrate lib 이 super-add 서명 (pe_superadd) 적용.
    let nest4 = hm_fleet_phi(phis, 4)
    let i1 = nest4["phi_collective"] > sigma

    // I2: class-의존 sync — class_id 가 다르면 sync 가 다름.
    //     collective_phi_nest 가 sync 를 pe_coupling_for_class (H_653 IV-最高)
    //     로 resolve — class-II vs class-IV 의 coupling 이 다르므로 sync 도 다름.
    let nest2 = hm_fleet_phi(phis, 2)
    let sync2 = nest2["sync"]
    let sync4 = nest4["sync"]
    let mut dsync = sync4 - sync2
    if dsync < 0.0 { dsync = 0.0 - dsync }
    let i2 = dsync > 1e-9

    // I3: convexity_span = max/min (variance > 0 fleet → 정확 비율).
    //     max=34.88, min=1.17 → span = 34.88 / 1.17.
    // tol = 1e-4 absolute: span ≈ 29.8, float round-off in mx/mn (분기-누적된 mn)
    // vs 직접 34.88/1.17 가 ~3e-5 차 — 상대오차 ~1e-6 의 float-identity 검사.
    let expected_span = 34.88 / 1.17
    let i3 = approx(nest4["convexity_span"], expected_span, 1e-4)

    // super-additive helper 도 부호 일치 확인 (보강).
    let delta = hm_fleet_super_additive(phis, 4)
    let i1b = delta > 0.0

    println("I1  super-additive phi_c > Sum  " + (if i1 && i1b { "PASS (phi_c=" + str(nest4["phi_collective"]) + " > Sum=" + str(sigma) + ")" } else { "FAIL" }))
    println("I2  class-dependent sync diff   " + (if i2 { "PASS (sync@II=" + str(sync2) + " sync@IV=" + str(sync4) + ")" } else { "FAIL" }))
    println("I3  convexity_span = max/min    " + (if i3 { "PASS (span=" + str(nest4["convexity_span"]) + ")" } else { "FAIL" }))

    let all_pass = i1 && i1b && i2 && i3
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (3/3)" } else { "INVARIANT FAILURE" })
}
