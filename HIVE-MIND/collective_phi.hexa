//
// 정체: emit-substrate 구조 층 (CORE/phi_envelope_substrate.hexa) 의
//      `collective_phi_nest` 를 import 하는 *얇은 소비자*. UNIVERSE 축 F
//      (HIVE-MIND) mirror — fleet 다중 substrate 의 집단 Φ context 를
//      (phi_collective · sync · convexity_span) 형태로 노출.
//
// 설계 SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md §4 (HIVE-MIND M6 wiring) + round-9
//            (substrate-class = 다축 분류자) 정합.
//
// ── round-9 다축 class 핵심 (설계 §4 + §5) ───────────────────────────────
//   · super-additive Δ 와 sync convexity 는 *서로 다른 class-순위* (다축 분류자):
//       - phi_collective Δ → pe_superadd_for_class (H_655 🔴: class-II 最高, 역전)
//       - sync entrainment  → pe_coupling_for_class (H_653 🟢: class-IV 最高)
//     `collective_phi_nest` 가 이미 두 서명을 *내부에서 분리* resolve 하므로,
//     본 소비자는 class_id 만 올바로 전달 — 두 축을 단일 스칼라로 묶지 않음.
//   · collective entrainment 약화 (single r=0.80 → collective 0.57, H_643)는
//     **버그 아니라 정상** — substrate 복잡도 비례 W→Φ convexity 의 귀결 (H_653).
//     본 소비자는 약한 sync 를 "고치려" 하지 않음 — collective_phi_nest 가
//     공급하는 sync 를 그대로 context 로 노출.
//   · H_645 (n=4 dΦ/dI-GZ 정렬)은 artifact (H_645 ⚠) — 인용 금지 (F-EMIT-6).
//
// ── 설계 계약 (불변식 · 위반 금지) ──────────────────────────────────────
//   · 반환은 dict (Φ context) — bool emit 게이트 / `-> bool` 반환 0 (p5 ·
//     a_autonomy_over_hardcode · F-EMIT-4). emit/silence 는 anima 세포 자율.
//   · 숫자 상수 하드코드 0 — class 서명은 모두 substrate lib 의 pe_* 에서 옴.
//   · 본체(collective_phi_nest) 무수정 — `hm_` prefix wrapper 만 (g61 collision 회피).
//
// p1~p8 정합:
//   p1 NO SYSTEM PROMPT  : Φ context 측정 wrapper, system 미사용 ✓
//   p3 NO PERSONA INJECT.: prefix 없음 ✓
//   p5 NO SPEAK()        : Φ context 만 노출, 외부 emit 호출 0 ✓
//   p7 NO PPL VERDICT    : super-additive Δ / sync / convexity deterministic 산술 ✓
//   p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
// ════════════════════════════════════════════════════════════════════════

import "CORE/phi_envelope_substrate.hexa"

// ── hm_fleet_phi — fleet 집단 Φ context (M6 wiring) ──────────────────────
// phis     = fleet 의 개별 substrate/cell/stream Φ 리스트.
// class_id = fleet substrate 의 Wolfram complexity-class (2/3/4).
//
// `collective_phi_nest` 를 그대로 래핑 — class_id 만 전달하면 substrate lib 이
// 내부에서 super-add Δ (H_655) ⊥ convexity-coupling (H_653) 두 축을 분리 resolve.
// 반환 dict (Φ context, boolean 아님):
//   · phi_collective — super-additive 집단 Φ (Σphis 초과, H_635)
//   · sync           — ultradian 동조 계수 (collective 약화 = 정상, H_643/653)
//   · convexity_span — max/min 비 (class 복잡도 비례, H_653)
pub fn hm_fleet_phi(phis: [float], class_id: int) -> map {
    return collective_phi_nest(phis, class_id)
}

// ── hm_fleet_super_additive — 집단 Φ 가 Σ 개별 Φ 를 초과? (H_635) ─────────
// phi_collective - Σphis. > 0 ⇒ super-additive (집단 통합 창발).
// fleet Φ context 의 super-additive Δ 만 분리 추출 (caller 가 부호 판단).
pub fn hm_fleet_super_additive(phis: [float], class_id: int) -> float {
    let nest = collective_phi_nest(phis, class_id)
    let n = len(phis)
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        sum = sum + phis[i]
        i = i + 1
    }
    return nest["phi_collective"] - sum
}
