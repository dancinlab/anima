// ════════════════════════════════════════════════════════════════════════
// HIVE-MIND/hivemind_lib_smoke.hexa — hivemind primitives round-trip smoke (M1 2026-05-28)
//
// 정체: hivemind_lib.hexa PURE wrapper 의 Kuramoto order + PID synergy +
//      collective-Φ super-additive + E×F cross-link primitives 를 invariant
//      형태로 검증. UNIVERSE/H_354/355/609/618/619 의 verdict 측 수치 보존 확인.
//
// Invariants (10):
//   I1: hm_kuramoto_order_r([0,0,0,0]) ≈ 1.0  (perfect sync)
//   I2: hm_kuramoto_order_r([0, π/2, π, 3π/2]) ≈ 0.0  (uniform spread)
//   I3: hm_pid_synergy(2.0)["synergy_total"] = 2.0 && redundancy = 0.0  (H_355 K=0.67)
//   I4: hm_pid_synergy(-1.0) → redundancy = 1.0 && synergy = 0.0
//   I5: hm_pid_synergy_ratio(3.0, 0.0) = 1.0  (H_355 K=1 pure synergy)
//   I6: hm_collective_phi_super_additive(2.49604, 2.49604, 15.4677) = +10.4756  (H_609 max)
//   I7: hm_collective_si(2.49604, 2.49604) ≈ 1.0  (H_617 symmetry baseline)
//   I8: hm_cross_link_savant_modulation([1,1,1,0.75,0.5])["spread"] = 0.5  (modulated=1)
//   I9: hm_gz_inverse_u_collective on H_618 series → peak_I=0.21, sign_change=0
//   I10: hm_cross_link_savant_modulation monotone-decreasing → inversions=0, monotone=1
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/HIVE-MIND/hivemind_lib"

fn approx(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn main() {
    println("=== HIVE-MIND/hivemind_lib_smoke ===")

    // I1: perfect sync (all phases identical)
    let r_sync = hm_kuramoto_order_r([0.0, 0.0, 0.0, 0.0])
    let i1 = approx(r_sync, 1.0, 1e-12)

    // I2: uniform spread (N=4 quadrants → r ≈ 0)
    let pi = 3.141592653589793
    let r_spread = hm_kuramoto_order_r([0.0, pi / 2.0, pi, 3.0 * pi / 2.0])
    let i2 = approx(r_spread, 0.0, 1e-9)

    // I3: PID synergy positive II_3 (H_355 K=0.67 [1,1,0] case = synergy 2.0)
    let pid1 = hm_pid_synergy(2.0)
    let i3 = approx(pid1["synergy_total"], 2.0, 1e-12) && approx(pid1["redundancy_total"], 0.0, 1e-12)

    // I4: PID synergy negative II_3 → redundancy
    let pid2 = hm_pid_synergy(-1.0)
    let i4 = approx(pid2["redundancy_total"], 1.0, 1e-12) && approx(pid2["synergy_total"], 0.0, 1e-12)

    // I5: pid_synergy_ratio K=1 pure synergy (H_355 K=1.0 [1,1,1] = ratio 1.0)
    let ratio_pure = hm_pid_synergy_ratio(3.0, 0.0)
    let i5 = approx(ratio_pure, 1.0, 1e-12)

    // I6: super-additive Δ verbatim (H_609 max pair (110,110) W=0.6)
    //     Φ(A)=Φ(B)=2.49604, Φ(AB)=15.4677, Δ=+10.4756
    let delta = hm_collective_phi_super_additive(2.49604, 2.49604, 15.4677)
    let i6 = approx(delta, 10.47562, 1e-4)

    // I7: collective SI baseline symmetry (H_617 I_a=0.0 → SI ≈ 1.0)
    let si_base = hm_collective_si(2.49604, 2.49604)
    let i7 = approx(si_base, 1.0, 1e-12)

    // I8: cross-link modulation (H_619 monotone-decreasing 5-point ratio series)
    let ratio_series = [1.0, 1.0, 1.0, 0.75, 0.5]
    let cross = hm_cross_link_savant_modulation(ratio_series)
    let i8 = approx(cross["spread"], 0.5, 1e-12) && cross["modulated"] == 1

    // I9 / I10: H_618 verbatim collective-Φ series
    //   I_grid = [0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50]
    //   Φ_c    = [8.03864, 7.32591, 6.99339, 6.50724, 5.72801, 5.22618, 3.98991, 3.05111]
    //   expected: peak |dΦ_c/dI| at I=0.21, sign_change_count=0
    let I_grid = [0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50]
    let phi_c  = [8.03864, 7.32591, 6.99339, 6.50724, 5.72801, 5.22618, 3.98991, 3.05111]
    let inv_u = hm_gz_inverse_u_collective(phi_c, I_grid)
    let i9 = approx(inv_u["peak_I"], 0.21, 1e-12) && inv_u["sign_change_count"] == 0

    // I10: monotone check on cross-link (no inversions in non-increasing series)
    let i10 = cross["inversions"] == 0 && cross["monotone"] == 1

    println("I1  Kuramoto r perfect sync " + (if i1  { "PASS (r=" + str(r_sync) + ")" } else { "FAIL" }))
    println("I2  Kuramoto r uniform spread" + (if i2 { "PASS (r=" + str(r_spread) + ")" } else { "FAIL" }))
    println("I3  PID synergy II>0         " + (if i3  { "PASS" } else { "FAIL" }))
    println("I4  PID redundancy II<0      " + (if i4  { "PASS" } else { "FAIL" }))
    println("I5  PID ratio pure synergy   " + (if i5  { "PASS (=1.0)" } else { "FAIL" }))
    println("I6  Phi super-additive Delta " + (if i6  { "PASS (Delta=" + str(delta) + ")" } else { "FAIL" }))
    println("I7  collective SI baseline=1 " + (if i7  { "PASS" } else { "FAIL" }))
    println("I8  cross-link modulation    " + (if i8  { "PASS (spread=0.5)" } else { "FAIL" }))
    println("I9  inverse-U peak I=0.21    " + (if i9  { "PASS (peak_I=" + str(inv_u["peak_I"]) + ")" } else { "FAIL" }))
    println("I10 cross-link monotone      " + (if i10 { "PASS (inversions=0)" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8 && i9 && i10
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (10/10)" } else { "INVARIANT FAILURE" })
}
