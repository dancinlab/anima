// ════════════════════════════════════════════════════════════════════════════
//  spinglass_frustration.hexa — UNIVERSE H_906 spin-glass frustration ↔
//  energy-landscape ruggedness (closed-form · $0 · CPU · substrate-runnable).
//
//  CANDIDATES.md ⬜ `spin-glass-frustration` (EA spin-glass frustration ↔ Φ
//  landscape ruggedness) promoted to a runnable smoke. Substrate = 3×3 periodic
//  Edwards-Anderson ±J Ising lattice (N=9 spins · 18 bonds · 2^9=512 configs
//  EXHAUSTIVELY enumerated — exact, no sampling). The "Φ landscape" is operated
//  as the energy-landscape ruggedness R = # of single-flip local minima (the
//  closed-form complexity proxy; full IIT-Φ-per-config is future). Frustration
//  f = fraction of the 9 unit plaquettes whose 4-bond product is −1.
//
//  Pre-registered falsifiers (frozen pre-run · post-tuning 0):
//    F1 FERRO-2MIN   : P_neg=0 (ferromagnet) → every instance f=0 ∧ R=2
//                      (the two all-aligned ground states, no frustration).
//    F2 FRUST-RUGGED : mean R(P_neg=0.5) > mean R(P_neg=0)  (frustration roughens).
//    F3 MONOTONE     : mean R nondecreasing over P_neg ∈ {0, 0.25, 0.5}.
//    F4 FRUST-PRESENT: ∃ P_neg=0.5 instance with f>0 (frustration actually occurs).
//    F5 CORR         : high-f group mean R > low-f group mean R (positive link).
//
//  5 PASS → 🟢 SUPPORTED-NUMERICAL (frustration→ruggedness link confirmed) ·
//  4 → 🟢 · 3 → 🟡 PARTIAL · ≤2 → 🔴 FALSIFIED. p7: no perplexity (integer
//  energy · count measures only). 8 seeds × 3 P_neg = 24 instances.
// ════════════════════════════════════════════════════════════════════════════

fn _p2(i: int) -> int {
    let mut p = 1; let mut k = 0
    while k < i { p = p * 2; k = k + 1 }
    return p
}

// spin s_i ∈ {+1,-1} from bit i of config cfg
fn _spin(cfg: int, i: int) -> float {
    let b = (cfg / _p2(i)) % 2
    if b == 1 { return 1.0 }
    return 0.0 - 1.0
}

// seeded LCG → bond signs farr[18] (+1/-1). pneg_code: 0=ferro · 1=P0.25 · 2=P0.5
fn _fill_bonds(bonds: int, seed: int, pneg_code: int) {
    let mut state = seed * 2654435761 + 1013904223
    let mut i = 0
    while i < 18 {
        state = (state * 1103515245 + 12345) % 2147483648
        if state < 0 { state = 0 - state }
        let r4 = (state / 65536) % 4
        let mut neg = 0
        if pneg_code == 1 { if r4 == 0 { neg = 1 } }
        if pneg_code == 2 { if r4 < 2 { neg = 1 } }
        if neg == 1 { farr_set(bonds, i, 0.0 - 1.0) } else { farr_set(bonds, i, 1.0) }
        i = i + 1
    }
}

// energy E(cfg) = -Σ_bonds J·s_a·s_b  (18 bonds: 0..8 horiz · 9..17 vert)
fn _energy(cfg: int, bonds: int) -> float {
    let mut e = 0.0
    let mut idx = 0
    while idx < 9 {
        let r = idx / 3; let c = idx % 3
        let bh = r * 3 + ((c + 1) % 3)
        e = e - farr_get(bonds, idx) * _spin(cfg, idx) * _spin(cfg, bh)
        let bv = ((r + 1) % 3) * 3 + c
        e = e - farr_get(bonds, 9 + idx) * _spin(cfg, idx) * _spin(cfg, bv)
        idx = idx + 1
    }
    return e
}

// frustration f = (#frustrated plaquettes)/9. plaquette(r,c) bonds:
//   h(r,c)=b[r*3+c] · v(r,c+1)=b[9 + r*3+(c+1)%3] · h(r+1,c)=b[((r+1)%3)*3+c] · v(r,c)=b[9+r*3+c]
fn _frustration(bonds: int) -> float {
    let mut nf = 0
    let mut idx = 0
    while idx < 9 {
        let r = idx / 3; let c = idx % 3
        let b1 = farr_get(bonds, r * 3 + c)
        let b2 = farr_get(bonds, 9 + r * 3 + ((c + 1) % 3))
        let b3 = farr_get(bonds, ((r + 1) % 3) * 3 + c)
        let b4 = farr_get(bonds, 9 + r * 3 + c)
        if b1 * b2 * b3 * b4 < 0.0 { nf = nf + 1 }
        idx = idx + 1
    }
    return to_float(nf) / 9.0
}

// ruggedness R = # single-flip local minima over all 512 configs.
fn _ruggedness(bonds: int) -> int {
    let mut r = 0
    let mut cfg = 0
    while cfg < 512 {
        let e0 = _energy(cfg, bonds)
        let mut is_min = 1
        let mut i = 0
        while i < 9 {
            let nb = (cfg / _p2(i)) % 2
            let mut ncfg = cfg + _p2(i)
            if nb == 1 { ncfg = cfg - _p2(i) }
            if _energy(ncfg, bonds) < e0 - 0.5 { is_min = 0 }
            i = i + 1
        }
        if is_min == 1 { r = r + 1 }
        cfg = cfg + 1
    }
    return r
}

fn main() {
    println("================================================================")
    println("  UNIVERSE H_906 — spin-glass frustration ↔ landscape ruggedness")
    println("================================================================")
    println("  substrate = 3x3 periodic EA ±J Ising · N=9 · 512 configs (exact)")
    println("  ruggedness R = # single-flip local minima · frustration f = frustrated plaquette frac")
    println("  sweep P_neg ∈ {0, 0.25, 0.5} · 8 seeds each (24 instances)")
    println("")

    let bonds = t_zeros(18)
    let nseed = 8

    // aggregates
    let mut sumR0 = 0.0; let mut sumR1 = 0.0; let mut sumR2 = 0.0
    let mut sumf0 = 0.0; let mut sumf2 = 0.0
    let mut ferro_ok = 1          // F1: every ferro instance f=0 ∧ R=2
    let mut frust_present = 0     // F4: ∃ P0.5 instance f>0
    // F5 grouping: accumulate R for low-f (<0.3) vs high-f (≥0.3) across all
    let mut sumR_lo = 0.0; let mut nlo = 0
    let mut sumR_hi = 0.0; let mut nhi = 0

    let mut pc = 0
    while pc < 3 {
        let mut s = 0
        while s < nseed {
            _fill_bonds(bonds, s + 1, pc)
            let f = _frustration(bonds)
            let R = _ruggedness(bonds)
            if pc == 0 {
                sumR0 = sumR0 + to_float(R); sumf0 = sumf0 + f
                if f > 0.0 { ferro_ok = 0 }
                if R != 2 { ferro_ok = 0 }
            }
            if pc == 1 { sumR1 = sumR1 + to_float(R) }
            if pc == 2 {
                sumR2 = sumR2 + to_float(R); sumf2 = sumf2 + f
                if f > 0.0 { frust_present = 1 }
            }
            // F5 grouping (all instances)
            if f < 0.3 { sumR_lo = sumR_lo + to_float(R); nlo = nlo + 1 }
            else { sumR_hi = sumR_hi + to_float(R); nhi = nhi + 1 }
            s = s + 1
        }
        pc = pc + 1
    }

    let nf = to_float(nseed)
    let mR0 = sumR0 / nf; let mR1 = sumR1 / nf; let mR2 = sumR2 / nf
    let mf0 = sumf0 / nf; let mf2 = sumf2 / nf
    let mRlo = if nlo > 0 { sumR_lo / to_float(nlo) } else { 0.0 }
    let mRhi = if nhi > 0 { sumR_hi / to_float(nhi) } else { 0.0 }

    println("  P_neg=0.00 : mean f=" + to_string(mf0) + " mean R=" + to_string(mR0))
    println("  P_neg=0.25 :            mean R=" + to_string(mR1))
    println("  P_neg=0.50 : mean f=" + to_string(mf2) + " mean R=" + to_string(mR2))
    println("  low-f(<0.3) mean R=" + to_string(mRlo) + " (n=" + to_string(nlo) + ") · high-f(≥0.3) mean R=" + to_string(mRhi) + " (n=" + to_string(nhi) + ")")
    println("")

    let f1 = ferro_ok                                  // F1 FERRO-2MIN
    let mut f2 = 0; if mR2 > mR0 { f2 = 1 }             // F2 FRUST-RUGGED
    let mut f3 = 0; if mR0 <= mR1 { if mR1 <= mR2 { f3 = 1 } }  // F3 MONOTONE
    let f4 = frust_present                              // F4 FRUST-PRESENT
    let mut f5 = 0; if mRhi > mRlo { f5 = 1 }           // F5 CORR

    println("  F1 FERRO-2MIN    = " + to_string(f1))
    println("  F2 FRUST-RUGGED  = " + to_string(f2))
    println("  F3 MONOTONE      = " + to_string(f3))
    println("  F4 FRUST-PRESENT = " + to_string(f4))
    println("  F5 CORR          = " + to_string(f5))
    let pass = f1 + f2 + f3 + f4 + f5
    println("")
    println("  PASS = " + to_string(pass) + "/5")
    if pass >= 5 { println("  VERDICT 🟢 SUPPORTED-NUMERICAL — frustration→ruggedness link confirmed") }
    else { if pass == 4 { println("  VERDICT 🟢 SUPPORTED") }
    else { if pass == 3 { println("  VERDICT 🟡 PARTIAL") }
    else { println("  VERDICT 🔴 FALSIFIED") } } }
}
