// H_490 smoke — DIFFERENTIATION MoE

fn router_top_k(token_hash: i64, k: i64, n_experts: i64) -> i64 {
    let _ = token_hash
    let _ = n_experts
    return k
}

fn expert_picked(idx: i64, n_experts: i64) -> bool {
    return (idx >= 0) && (idx < n_experts)
}

fn check_h490() -> bool {
    let n = 8
    let k = 2
    let h2 = router_top_k(42, k, n) == k
    let h1 = expert_picked(3, n) && expert_picked(7, n)
    let oob = !expert_picked(99, n)
    return h2 && h1 && oob
}

fn main() {
    let ok = check_h490()
    if !ok { print("H_490 FAIL"); return }
    print("H_490 blue DIFF-MoE OK")
}
