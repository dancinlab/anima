fn is_emit_specialist(s: string) -> bool { return s == "emit" }
fn from_stem(target: string) -> string { return target }
fn check_h532() -> bool { return is_emit_specialist("emit") && !is_emit_specialist("stem") && from_stem("emit") == "emit" }
fn main() { if check_h532() { print("H_532 OK") } else { print("H_532 FAIL") } }
