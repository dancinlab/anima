// UNIVERSE/h1295_r2_hive_scaling.hexa
//
//   H_1295 r2 — HIVE-MIND collective-Φ SCALING: does super-additivity HOLD / GROW /
//   SATURATE as the coupled-member count N grows 2 -> 3 -> 4 (joint n = 6, 9, 12)?
//
//   r1 (H_1295 🟢) established super-additivity at N=2: Φ(joint n=6)=15.4677 vs
//   Σ Φ=4.99209, Δ_super(2)=+10.4756, with decouple-null + rule-class + no-collapse
//   controls PASS (lift coupling-generic per the angle-1 honest caveat). r1's live
//   follow-on: collective_phi fell back to the additive baseline for N>2. r2 extends
//   the FAITHFUL collective-Φ to N=3,4 and measures the Δ_super(N) curve.
//
//   Φ = FAITHFUL IIT-4 ONLY (a_phi_iit4_tool) via big_phi_bounded (cap=2, the M4b
//   lower-bound SSOT inherited from r1) — numpy NEVER computes Φ. The N-member joint
//   substrate is the generalized coupled ring (build_tpm_ring): N blocks of 3, each an
//   n=3 ECA ring (decoupled), blended at strength W with the GLOBAL n=3N ring (coupled).
//   For N=2 this is byte-EXACT the r1 _build_tpm_ab (verified, mismatches=0).
//
//   SAME substrate as r1 (edge-of-chaos ECA rule-110). Deterministic (ECA TPM has no
//   RNG); the "3 seeds" are reported as r1 did — the super-additive value is seed-
//   INVARIANT, so seed-identity is the per-seed PASS. Frozen bars:
//   .verdicts/1295_hive_collective_phi/H_1295_R2_FREEZE.txt — pre-registered BEFORE run.
//
//   COMPUTE: faithful Φ at n=9/n=12 is expensive (MIP partitions 2^n, MICE per
//   mechanism). n=9 ~minutes; n=12 may be INFEASIBLE on CPU — if so we HONESTLY report
//   INFEASIBLE (a documented compute ceiling, c9 / a_scale_honest_scope) and NEVER
//   substitute a proxy for Φ. --n4 enables the n=12 attempt (default off).
//
//   $0 mac-local CPU · hexa-only · no GPU · no LLM.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── single isolated n=3 ECA substrate TPM (Φ of one member). ──
fn eca_tpm_n3(rule: int) -> array {
    let n = 3
    let mut t = []
    let mut s = 0
    while s < 8 {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            t = t + [to_float(iit4_bit(rule, idx))]
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── generalized N-member coupled-ring TPM. N blocks of 3, within-block n=3 ring
// (decoupled) blended with the GLOBAL n=3N ring (coupled) at strength W. N=2 is
// byte-EXACT the r1 _build_tpm_ab. The load-bearing coupling = the global ring's
// cross-block boundary edges. ──
fn build_tpm_ring(rules: array, W: float) -> array {
    let nblk = len(rules)
    let n = 3 * nblk
    let full = iit4_pow2(n)
    let omw = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let g = i / 3
            let j = i % 3
            let base = g * 3
            let rule = rules[g]
            // decoupled: within-block n=3 ring
            let ld = base + (j + 2) % 3
            let rd = base + (j + 1) % 3
            let idx_dec = 4 * iit4_bit(s, ld) + 2 * iit4_bit(s, i) + iit4_bit(s, rd)
            let next_dec = iit4_bit(rule, idx_dec)
            // coupled: global n=3N ring
            let lc = (i - 1 + n) % n
            let rc = (i + 1) % n
            let idx_cou = 4 * iit4_bit(s, lc) + 2 * iit4_bit(s, i) + iit4_bit(s, rc)
            let next_cou = iit4_bit(rule, idx_cou)
            t = t + [omw * to_float(next_dec) + W * to_float(next_cou)]
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── Φ measurements (faithful IIT-4 ONLY, cap=2). ──
fn phi_member(rule: int) -> float {
    let r = big_phi_bounded(eca_tpm_n3(rule), 3, 0, 3)
    return r[0]
}
fn phi_joint(rules: array, W: float) -> float {
    let nblk = len(rules)
    let n = 3 * nblk
    let r = big_phi_bounded(build_tpm_ring(rules, W), n, 0, 2)
    return r[0]
}
fn sum_members(rules: array) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < len(rules) {
        acc = acc + phi_member(rules[i])
        i = i + 1
    }
    return acc
}

// ── inter-block coherence (no-collapse gauge), generalized to N blocks. Mean over
// all states and all ADJACENT block-pairs (g, g+1 mod N) of the per-cell L1 divergence
// between the two blocks' next-state cells. < 0.999 ⇒ blocks functionally distinct. ──
fn inter_block_coherence(rules: array, W: float) -> float {
    let nblk = len(rules)
    let n = 3 * nblk
    let full = iit4_pow2(n)
    let tpm = build_tpm_ring(rules, W)
    let mut acc = 0.0
    let mut cnt = 0
    let mut s = 0
    while s < full {
        let base = s * n
        let mut g = 0
        while g < nblk {
            let gn = (g + 1) % nblk
            let mut c = 0
            while c < 3 {
                let a = tpm[base + g * 3 + c]
                let b = tpm[base + gn * 3 + c]
                let mut d = a - b
                if d < 0.0 { d = 0.0 - d }
                acc = acc + d
                cnt = cnt + 1
                c = c + 1
            }
            g = g + 1
        }
        s = s + 1
    }
    return 1.0 - (acc / to_float(cnt))
}

// rule-list constructors
fn rep(rule: int, k: int) -> array {
    let mut a = []
    let mut i = 0
    while i < k { a = a + [rule]; i = i + 1 }
    return a
}

fn main() {
    let mut do_n4 = false
    let argv = args()
    let mut ai = 0
    while ai < len(argv) {
        if argv[ai] == "--n4" { do_n4 = true }
        ai = ai + 1
    }

    println("================================================================")
    println("  H_1295 r2 — HIVE-MIND collective-Φ SCALING (N = 2 -> 3 -> 4)")
    println("  faithful IIT-4 big_phi_bounded · rule-110 edge-of-chaos · W=0.6 · cap=2")
    println("  Δ_super(N) = Φ(joint, N coupled) - Σ Φ(member) · MARGIN=+1.0 · frozen-first")
    println("================================================================")

    let RULE = 110
    let W = 0.6
    let MARGIN = 1.0

    let phi1 = phi_member(RULE)
    println("  Φ(single member, rule-110, n=3) = " + str(phi1))
    println("  --")

    // ── N=2 (joint n=6) — re-confirm the r1 anchor through the generalized builder ──
    let r2_rules = rep(RULE, 2)
    let sum2 = sum_members(r2_rules)
    let phi_j2 = phi_joint(r2_rules, W)
    let d2 = phi_j2 - sum2
    println("  N=2 (n=6):  Σ Φ=" + str(sum2) + "  Φ_joint=" + str(phi_j2) + "  Δ_super(2)=" + str(d2))

    // ── N=3 (joint n=9) — the first new scaling point ──
    let r3_rules = rep(RULE, 3)
    let sum3 = sum_members(r3_rules)
    let phi_j3 = phi_joint(r3_rules, W)
    let d3 = phi_j3 - sum3
    println("  N=3 (n=9):  Σ Φ=" + str(sum3) + "  Φ_joint=" + str(phi_j3) + "  Δ_super(3)=" + str(d3))

    // ── N=4 (joint n=12) — attempted only with --n4 (may be INFEASIBLE) ──
    let mut d4_ok = false
    let mut d4 = 0.0
    let mut phi_j4 = 0.0
    let mut sum4 = 0.0
    if do_n4 {
        let r4_rules = rep(RULE, 4)
        sum4 = sum_members(r4_rules)
        phi_j4 = phi_joint(r4_rules, W)
        d4 = phi_j4 - sum4
        d4_ok = true
        println("  N=4 (n=12): Σ Φ=" + str(sum4) + "  Φ_joint=" + str(phi_j4) + "  Δ_super(4)=" + str(d4))
    } else {
        println("  N=4 (n=12): SKIPPED (run with --n4 to attempt; may be INFEASIBLE on CPU)")
    }
    println("  --")

    // ── N=3 controls (re-run r1's genuine controls at the new scale) ──
    let phi_j3_w0 = phi_joint(r3_rules, 0.0)
    let d3_w0 = phi_j3_w0 - sum3
    println("  CTRL N=3 decouple-null:  Φ_joint(W=0)=" + str(phi_j3_w0) + "  Δ(W=0)=" + str(d3_w0) + "  (null iff <= 0)")
    let b_decouple = d3_w0 <= 0.0

    let r3_sterile = rep(90, 3)
    let sum3_st = sum_members(r3_sterile)
    let phi_j3_st = phi_joint(r3_sterile, W)
    let d3_st = phi_j3_st - sum3_st
    let dissoc3 = d3 - d3_st
    println("  CTRL N=3 rule-class:     sterile(90×3) Σ=" + str(sum3_st) + " Φ_joint=" + str(phi_j3_st) + " Δ_sterile=" + str(d3_st))
    println("                           dissociation Δ(110×3) - Δ(90×3) = " + str(dissoc3) + "  (>= +1.0 ⇒ substrate-class specific)")
    let b_dissoc = dissoc3 >= MARGIN

    let coh3 = inter_block_coherence(r3_rules, W)
    println("  CTRL N=3 no-collapse:    inter-block coherence=" + str(coh3) + "  (no-collapse iff < 0.999)")
    let b_nocollapse = coh3 < 0.999
    println("  --")

    // ── the Δ_super(N) curve + GROWS vs SATURATES pre-registered verdict ──
    println("  ── Δ_super(N) CURVE:")
    println("       Δ_super(2) = " + str(d2))
    println("       Δ_super(3) = " + str(d3))
    if d4_ok { println("       Δ_super(4) = " + str(d4)) }
    else { println("       Δ_super(4) = (not measured)") }
    let grow_2_3 = d3 - d2
    println("       Δ_super(3) - Δ_super(2) = " + str(grow_2_3))
    if d4_ok {
        let grow_3_4 = d4 - d3
        println("       Δ_super(4) - Δ_super(3) = " + str(grow_3_4))
    }
    // pre-registered: GROWS iff Δ_super(3) >= Δ_super(2)+MARGIN; SATURATES otherwise.
    let grows = grow_2_3 >= MARGIN
    if grows { println("       VERDICT(curve): GROWS — Δ_super(3) >= Δ_super(2)+1.0 (collective Φ scales)") }
    else { println("       VERDICT(curve): SATURATES/FLAT — Δ_super(3) < Δ_super(2)+1.0 (existence-proof, not scaling)") }
    println("  --")

    // ── frozen bars ──
    check("B1 SUPER-ADDITIVITY @ N=3: Δ_super(3) > 0 every seed (deterministic)", d3 > 0.0)
    check("B2a DECOUPLE-NULL @ N=3: Δ(W=0) <= 0", b_decouple)
    check("B2b RULE-CLASS DISSOC @ N=3: Δ(110×3) - Δ(90×3) >= +1.0", b_dissoc)
    check("B3 NO-COLLAPSE @ N=3: inter-block coherence < 0.999", b_nocollapse)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  (B2 curve verdict GROWS=" + str(grows) + " is REPORTED honestly, not a fail-gate:")
    println("   SATURATING is a VALID existence-proof-depleted result, a_scale_honest_scope/c9.)")
    if FAIL == 0 {
        if grows {
            println("  VERDICT: 🟢 super-additivity HOLDS at N=3 AND GROWS with N (collective Φ scales).")
        } else {
            println("  VERDICT: 🟢 super-additivity HOLDS at N=3 (controls PASS) but the curve SATURATES")
            println("           → saturating existence-proof, HIVE DEPLETED 🏁 (honest, not a failure).")
        }
    } else {
        println("  VERDICT: NOT GREEN — see [FAIL] lines (honest closed-negative, no further wiring).")
    }
    println("================================================================")
}
