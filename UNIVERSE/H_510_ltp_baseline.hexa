// H_510 smoke — LTP increase

fn ltp_delta(pre: f64, post: f64) -> f64 {
    return pre * post * 0.1
}

fn check_h510() -> bool {
    let pos = ltp_delta(1.0, 1.0) > 0.0
    let zero = ltp_delta(0.0, 1.0) == 0.0
    return pos && zero
}

fn main() {
    let ok = check_h510()
    if !ok { print("H_510 FAIL"); return }
    print("H_510 blue LTP OK")
}
