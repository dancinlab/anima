// H_489 smoke — APOPTOSIS token prune

fn token_survives(prob: f64, theta_apo: f64) -> bool {
    return prob >= theta_apo
}

fn cumprob_cutoff(probs_sum: f64, p_max: f64) -> bool {
    return probs_sum <= p_max
}

fn check_h489() -> bool {
    let theta = 0.05
    let h1_die = !token_survives(0.02, theta)
    let h1_live = token_survives(0.40, theta)
    let h2_within = cumprob_cutoff(0.85, 0.90)
    let h2_over = !cumprob_cutoff(0.95, 0.90)
    return h1_die && h1_live && h2_within && h2_over
}

fn main() {
    let ok = check_h489()
    if !ok { print("H_489 FAIL"); return }
    print("H_489 blue APOPTOSIS-prune OK")
}
