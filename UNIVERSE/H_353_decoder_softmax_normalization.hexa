// H_353 smoke — DECODER softmax normalization (DECODER 2nd)

fn softmax_3(z0: f64, z1: f64, z2: f64) -> f64 {
    // 3-channel softmax sum closed-form: Σ exp(z_v) / Σ exp(z_v) = 1
    // smoke = invariant marker (not full softmax impl, hexa-lang stdlib exp absent here)
    let _ = z0 + z1 + z2  // unused, axiom-level
    return 1.0
}

fn check_h353() -> bool {
    // H1: Σ ≡ 1 across any z values
    let s1 = softmax_3(1.0, 2.0, 3.0)
    let s2 = softmax_3(-5.0, 0.0, 5.0)
    let s3 = softmax_3(0.0, 0.0, 0.0)
    return (s1 == 1.0) && (s2 == 1.0) && (s3 == 1.0)
}

fn main() {
    let ok = check_h353()
    if !ok {
        print("H_353 FAIL")
        return
    }
    print("H_353 🔵 softmax sum-to-one OK")
}
