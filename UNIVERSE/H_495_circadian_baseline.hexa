// H_495 smoke — CIRCADIAN 24h

fn circadian_period_min() -> i64 {
    return 24 * 60
}

fn ultradian_period_min() -> i64 {
    return 90
}

fn n_ultradian_in_circadian() -> i64 {
    return circadian_period_min() / ultradian_period_min()
}

fn check_h495() -> bool {
    let h1 = circadian_period_min() == 1440
    let h3 = n_ultradian_in_circadian() == 16
    return h1 && h3
}

fn main() {
    let ok = check_h495()
    if !ok { print("H_495 FAIL"); return }
    print("H_495 blue CIRCADIAN OK")
}
