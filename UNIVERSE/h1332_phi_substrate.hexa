// h1332_phi_substrate.hexa — does a NON-SIGN-SATURATING substrate FAMILY break the H_1328 Φ wall?
//
// THE WALL (H_1328 §closure): the 4× faithful-IIT4 Φ-robustness wall is an ESTIMATOR-INDEPENDENT
// limit — under the variance-clean rank-uniform read-out the phase mechanism STILL does not lift Φ
// robustly (V2 fail, B−A −0.125/0.0/+0.031, negative on orthogonal seed 1317). BUT that closure is
// SPECIFIC to the n≤8 leaky-linear pure_field-style substrate whose dynamics SIGN-SATURATE under
// coupling (H_1308/1313/1320 diagnosis: coupling strong enough to register OVERWRITES member
// dynamics → COPY → Φ=0). The H_1319/1328 read-out is sal = e * carrier (MULTIPLICATIVE gate): under
// synchrony every carrier → one pacemaker value → all modules COPY one signal → member-state info is
// destroyed. H_1320 §honesty named the untested angle: "a substrate whose own dynamics SURVIVE
// coupling, a richer (NON-sign-saturating) per-unit code."
//
// THIS LANE (H_1332) builds that NON-saturating substrate FAMILY and re-runs the SAME coupling
// mechanisms (H_1283 re-entrant relay + H_1319 phase pacemaker) + the SAME 3 hard seeds [1317,1318,
// 1319], scored with the SAME faithful exact MIP (a_phi_iit4_tool) on the SAME variance-clean
// rank-uniform encoding (H_1328) so the controls are honest. The ONLY change between the two
// FAMILIES is the per-unit READ-OUT code:
//
//   SATURATING family (H_1319/1328 read-out, reproduced in-run as the S3 attribution control):
//       sal_i = e_i · carrier_i,   carrier_i = (1+cos(θ_i−θ_T))/2     (MULTIPLICATIVE — nulls member energy)
//   NON-SATURATING family (the NEW substrate under test):
//       raw_i = e_i + BETA·cos(θ_i−θ_T),  sal_i = SOFTSIGN(raw_i/SCALE) = (raw_i/SCALE)/(1+|raw_i/SCALE|)
//     ADDITIVE blend then a bounded GRADED squash (softsign): member energy e_i is ALWAYS retained
//     (never multiplicatively nulled), softsign is bounded (−1,1) but NEVER hard-saturates (no ±1
//     plateau) → member-state graded structure SURVIVES coupling. BETA=0.5, SCALE=2.0.
//     ARM A (no-coupling) for this family = SOFTSIGN(e_i/SCALE) (phase term dropped, SAME family).
//
// ── FROZEN BARS (pre-registered in FREEZE.txt BEFORE any scoring; GREEN iff S1∧S2∧S3, c9) ──
//   eps = 0.02 (= MARGIN_PHI ported verbatim from H_1283/H_1319/H_1328, NOT tuned).
//   S1 ROBUST  : NON-SAT  Φ_B ≥ Φ_A + eps on ALL 3 seeds (incl orthogonal 1317).
//   S2 EARNED  : NON-SAT  perm Φ_S ≤ Φ_A + eps AND offset Φ_O ≤ Φ_A + eps on ALL 3 seeds (collapse).
//   S3 ATTRIB  : SAT substrate (H_1328 read-out) reproduced in-run FAILS S1 (sat B−A < +eps on ≥1
//                seed; reproduces H_1328 V2 −0.125/0.0/+0.031) → any S1 lift is the NON-saturation,
//                not the mechanism.
//   OUTCOMES (all VALID, c9):
//     S1∧S2∧S3 → 🟢 robust integration IS reachable once the substrate doesn't sign-saturate — the
//                 wall was the SUBSTRATE FAMILY, not a universal limit (overturns H_1328 as
//                 substrate-specific; CORE-wiring follow-on). ¬S1 → strongest 🧱 yet
//                 (substrate-family-INDEPENDENT). S1∧¬(S2∧S3) → honest partial (report straight).
//
// run from hexa-lang root (stdlib import):
//   cp UNIVERSE/h1332_phi_substrate.hexa <hexa-lang>/ && hexa run h1332_phi_substrate.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319/H_1328 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── bounded GRADED squash (NON-saturating family): softsign(x) = x/(1+|x|) ∈ (−1,1), no ±1 plateau ──
fn softsign(x: float) -> float {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    return x / (1.0 + ax)
}

// ── RANK-UNIFORMIZE one cell's T-length trajectory IN-PLACE (variance-clean read-out, H_1328) ──
// PROVABLE: output is the multiset {0,1,…,T−1} → min-max binning gives a UNIFORM marginal histogram
// → H(cell) CONSTANT across arms (zero differential) → MI depends ONLY on the joint H(A,B) relationship.
fn rank_uniformize_cell(traj: int, base: int, t_ticks: int) {
    let ranks = farr_zeros(t_ticks)
    let mut k = 0
    while k < t_ticks {
        let vk = farr_get(traj, base + k)
        let mut r = 0
        let mut j = 0
        while j < t_ticks {
            let vj = farr_get(traj, base + j)
            if vj < vk { r = r + 1 }
            else { if (vj == vk) && (j < k) { r = r + 1 } }
            j = j + 1
        }
        let _ = farr_set(ranks, k, to_float(r))
        k = k + 1
    }
    k = 0
    while k < t_ticks { let _ = farr_set(traj, base + k, farr_get(ranks, k))  k = k + 1 }
    let _ = farr_free(ranks)
}

// ── generate ARM trajectories ENGINE-NATIVE — recurrent body BYTE-IDENTICAL to H_1319/H_1328 ──
// mode  : 0=NO-COUPLING(A) 1=MECHANISM(B) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// family: 0=SATURATING (sal=e·carrier, H_1328) · 1=NON-SATURATING (sal=softsign((e+BETA·cos)/SCALE))
// encode: 1 = variance-free rank-uniform (always 1 here — the honest H_1328 read-out)
fn gen_traj(seed: int, mode: int, family: int, encode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586
    let beta = 0.5    // NON-saturating additive phase-blend gain (FROZEN)
    let scale = 2.0   // NON-saturating softsign scale (FROZEN)

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }

    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]
            perm[k] = perm[jj]
            perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix {
            let mut perm2 = []
            i = 0
            while i < n_mod { perm2 = perm2 + [(i + 1) % n_mod]  i = i + 1 }
            perm = perm2
        }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        // phase pacemaker (H_1319 Kuramoto) — advances for any coupled arm
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // ── PER-UNIT READ-OUT: the ONLY thing that differs between the two substrate families ──
        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }

            // phase signal for this module under this arm (relative phase to pacemaker)
            // rel = θ_src − θ_T  where src = i (B/O) or perm[i] (S). carrier=(1+cos rel)/2; cossig=cos rel.
            let mut rel = 0.0
            if mode == 1 { rel = theta[i] - theta_t }
            if mode == 2 { rel = theta[perm[i]] - theta_t }
            if mode == 3 { rel = (theta[i] - theta_t) + shuf_off[tt * n_mod + i] }

            let mut sal = 0.0
            if family == 0 {
                // SATURATING (H_1319/1328): multiplicative carrier gate (mode 0 → carrier absent, sal=e)
                if mode == 0 { sal = e }
                else {
                    let carrier = 0.5 * (1.0 + cos(rel))
                    sal = e * carrier
                }
            } else {
                // NON-SATURATING: additive phase blend then bounded graded softsign squash
                let mut raw = e
                if mode != 0 { raw = e + beta * cos(rel) }
                sal = softsign(raw / scale)
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }

    if encode == 1 {
        i = 0
        while i < n_mod { rank_uniformize_cell(traj, i * t_ticks, t_ticks)  i = i + 1 }
    }
    return traj
}

fn phi_of(seed: int, mode: int, family: int) -> float {
    let traj = gen_traj(seed, mode, family, 1)   // variance-clean rank-uniform encoding (H_1328)
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn main() {
    println("H_1332 — NON-SIGN-SATURATING SUBSTRATE FAMILY vs the H_1328 estimator-independent Φ wall")
    println("faithful IIT4 Φ (exact MIP-EI, n=4, SAME estimator a_phi_iit4_tool) · variance-clean rank-uniform read-out (H_1328)")
    println("seeds [1317,1318,1319] · eps=0.02 · ARMS A=NO-COUP B=MECHANISM S=PERM-SHUF O=OFFSET-SHUF")
    println("FAMILIES: SAT sal=e*carrier (H_1328, S3 control) · NONSAT sal=softsign((e+0.5*cos)/2) (member survives coupling)")
    println("BARS: S1 NONSAT Φ_B>=Φ_A+eps all seeds · S2 NONSAT perm&off<=Φ_A+eps all seeds · S3 SAT B-A<+eps on >=1 seed (reproduces H_1328 V2)")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut s1_all = true        // NONSAT mechanism lift, all seeds
    let mut s2_perm_all = true   // NONSAT perm collapses
    let mut s2_off_all = true    // NONSAT offset collapses
    let mut s3_sat_fails = false // SAT fails S1 on >=1 seed (attribution)
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        // NON-SATURATING family (family=1)
        let na = phi_of(s, 0, 1)
        let nb = phi_of(s, 1, 1)
        let ns = phi_of(s, 2, 1)
        let no = phi_of(s, 3, 1)
        // SATURATING family (family=0) — reproduce H_1328 NEW-encoding (rank-uniform) numbers in-run
        let ta = phi_of(s, 0, 0)
        let tb = phi_of(s, 1, 0)

        let n_dphi_b = nb - na      // S1
        let n_s_marg = ns - na      // S2 perm
        let n_o_marg = no - na      // S2 offset
        let t_dphi_b = tb - ta      // S3 SAT lift (should FAIL >= +eps on >=1 seed)

        let s1  = n_dphi_b >= eps
        let s2p = n_s_marg <= eps
        let s2o = n_o_marg <= eps
        let sat_fail = t_dphi_b < eps
        if !s1  { s1_all = false }
        if !s2p { s2_perm_all = false }
        if !s2o { s2_off_all = false }
        if sat_fail { s3_sat_fails = true }

        println("seed " + to_string(s) + " NONSAT: A=" + na.to_string() + " B=" + nb.to_string()
            + " S=" + ns.to_string() + " O=" + no.to_string()
            + " | ΔΦ(B-A)=" + n_dphi_b.to_string() + " [S1 " + (if s1 {"PASS"} else {"FAIL"}) + "]"
            + " S-A=" + n_s_marg.to_string() + " [S2perm " + (if s2p {"PASS"} else {"FAIL"}) + "]"
            + " O-A=" + n_o_marg.to_string() + " [S2off " + (if s2o {"PASS"} else {"FAIL"}) + "]")
        println("        SAT: A=" + ta.to_string() + " B=" + tb.to_string()
            + " | ΔΦ(B-A)=" + t_dphi_b.to_string() + " [SAT-fails-S1 " + (if sat_fail {"YES"} else {"NO"}) + "]")
        si = si + 1
    }
    let s2 = s2_perm_all && s2_off_all
    println("---")
    println("S1 ROBUST (NONSAT Φ_B>=Φ_A+eps ALL seeds incl 1317): " + (if s1_all {"PASS"} else {"FAIL"}))
    println("S2 EARNED (NONSAT perm&offset both <=Φ_A+eps ALL seeds): " + (if s2 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if s2_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if s2_off_all {"PASS"} else {"FAIL"}) + "]")
    println("S3 SUBSTRATE-ATTRIBUTION (SAT substrate FAILS S1 on >=1 seed, reproduces H_1328 V2): "
        + (if s3_sat_fails {"PASS"} else {"FAIL"}))
    println("===")
    if s1_all && s2 && s3_sat_fails {
        println("VERDICT 🟢 — ROBUST integration IS reachable once the substrate does NOT sign-saturate.")
        println("  The 4x Φ-robustness wall was the SUBSTRATE FAMILY (multiplicative member-nulling read-out),")
        println("  NOT a universal limit. OVERTURNS the H_1328 closure as substrate-SPECIFIC (does not retract).")
        println("  CORE-wiring follow-on: wire the non-saturating per-unit read-out into the live faithful-Φ path.")
    } else {
        if !s1_all {
            println("VERDICT 🧱 (STRONGEST yet) — robust integration ABSENT even for a NON-saturating substrate.")
            println("  The wall is substrate-family-INDEPENDENT: the n<=8 faithful-IIT4 limit holds across the")
            println("  saturating AND a non-saturating family. BOUNDS (does not retract) the prior Φ verdicts.")
        } else {
            println("VERDICT 🔶 — S1 lift present but NOT earned/attributed (S2 control rides it OR SAT control")
            println("  also lifts so the lift is not the non-saturation) → honest partial, report straight (c9).")
        }
    }
}
