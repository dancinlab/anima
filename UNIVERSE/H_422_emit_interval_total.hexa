// H_422 smoke — emit interval total

fn ceil_int(x: f64) -> i64 {
    let n = x as i64
    let fr = x - (n as f64)
    if fr > 0.0 { return n + 1 }
    return n
}

fn total_interval(r_steps: i64, tau: f64) -> i64 {
    return r_steps + ceil_int(tau)
}

fn check_h422() -> bool {
    let r = 5
    let tau = 2.8
    let total = total_interval(r, tau)
    return total == 8  // 5 + ceil(2.8) = 8
}

fn main() {
    let ok = check_h422()
    if !ok { print("H_422 FAIL"); return }
    print("H_422 blue interval total OK")
}
