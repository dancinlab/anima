// H_438 smoke — substrate-decided spike write

fn write_spike(decided: bool) -> i64 {
    if decided { return 1 }
    return 0
}

fn check_h438() -> bool {
    let h1 = write_spike(true) == 1
    let h2 = write_spike(false) == 0
    return h1 && h2
}

fn main() {
    let ok = check_h438()
    if !ok { print("H_438 FAIL"); return }
    print("H_438 blue spike substrate-gate OK")
}
