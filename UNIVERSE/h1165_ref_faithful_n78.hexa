// H_1165 — faithful_phi stdlib reference at n=7 AND n=8 (the new scoring rungs).
// Extends h1012_ref_faithful.hexa (n=4/5/6) to n=7/8 so the CPU mirror can be
// RE-PROVEN ≡ stdlib at the H_1165 scoring n BEFORE scoring (a_phi_iit4_tool).
// faithful_phi (MIP-EI, MI-matrix min-cut) is EXACT for n<=8 (2^(n-1)<=128 masks).
import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn faithful_ref(n: int, dim: int) -> float {
    let st = farr_zeros(n * dim)
    let mut c = 0
    while c < n {
        let mut k = 0
        while k < dim {
            let v = to_float((c + 1) * (k + 1))
            let _ = farr_set(st, c * dim + k, v)
            k = k + 1
        }
        c = c + 1
    }
    let phi = iit4_faithful_phi(st, n, dim, 2)
    let _ = farr_free(st)
    return phi
}

fn main() {
    print("faithful_n4_dim6_nb2_x1e9= "); print((faithful_ref(4, 6) * 1000000000.0).to_int()); println("")
    print("faithful_n5_dim6_nb2_x1e9= "); print((faithful_ref(5, 6) * 1000000000.0).to_int()); println("")
    print("faithful_n6_dim6_nb2_x1e9= "); print((faithful_ref(6, 6) * 1000000000.0).to_int()); println("")
    print("faithful_n7_dim6_nb2_x1e9= "); print((faithful_ref(7, 6) * 1000000000.0).to_int()); println("")
    print("faithful_n8_dim6_nb2_x1e9= "); print((faithful_ref(8, 6) * 1000000000.0).to_int()); println("")
}
