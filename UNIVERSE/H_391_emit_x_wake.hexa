// H_391 smoke — emit × WAKE envelope

fn emit_envelope(stage: string) -> f64 {
    if stage == "WAKE" { return 1.0 }
    if stage == "REM" { return 0.7 }
    if stage == "N1" { return 0.4 }
    if stage == "N2" { return 0.2 }
    if stage == "N3" { return 0.08 }
    return 0.0
}

fn check_h391() -> bool {
    let w = emit_envelope("WAKE")
    let n3 = emit_envelope("N3")
    let ge = w >= n3
    let all_pos = n3 > 0.0
    return ge && all_pos
}

fn main() {
    let ok = check_h391()
    if !ok { print("H_391 FAIL"); return }
    print("H_391 blue emit envelope OK")
}
