// H_492 smoke — PRUNING head mask

fn head_active(contrib: f64, theta: f64) -> bool {
    return contrib >= theta
}

fn n_active(c1: f64, c2: f64, c3: f64, c4: f64, theta: f64) -> i64 {
    let mut n: i64 = 0
    if head_active(c1, theta) { n = n + 1 }
    if head_active(c2, theta) { n = n + 1 }
    if head_active(c3, theta) { n = n + 1 }
    if head_active(c4, theta) { n = n + 1 }
    return n
}

fn check_h492() -> bool {
    let theta = 0.1
    let active = n_active(0.5, 0.05, 0.3, 0.02, theta)
    let h2 = active == 2  // c1, c3 만 활성
    let h1_lo = !head_active(0.05, theta)
    let h1_hi = head_active(0.5, theta)
    return h2 && h1_lo && h1_hi
}

fn main() {
    let ok = check_h492()
    if !ok { print("H_492 FAIL"); return }
    print("H_492 blue PRUNE-head OK")
}
