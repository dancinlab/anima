// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/run_faithful_phi_1043.hexa
//
//  H_1043 — TERMINAL faithful IIT-4.0 φ_EI for the minimal-arch-adapter
//  hidden-state macro-TPM matrices written by UNIVERSE/h1043_minimal_arch_adapter.py.
//
//  a_phi_iit4_tool-compliant terminal Φ step: imports the REAL stdlib faithful
//  IIT-4.0 engine (exact MIP-EI, n<=8) and feeds it each binarized n×dim
//  hidden-state trajectory (base / graft_convmoe / graft_recurrent / graft_dwdilated
//  / lora_control / convmoe_native), reporting φ_EI per arm + Δ vs base. NO proxy.
//
//  state file format (written by the python script):
//    # <tag> <n> <dim>
//    <dim floats>           (row for cell 0)
//    ...                    (n rows total)
//    # <next tag> <n> <dim>
//    ...
//
//  Run (CPU, $0):
//    H1043_STATE=/tmp/h1043_states.txt hexa run UNIVERSE/run_faithful_phi_1043.hexa
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn _state_path() -> string {
    let p = env("H1043_STATE")
    if len(p) > 0 { return p }
    return "/tmp/h1043_states.txt"
}

fn main() {
    let path = _state_path()
    println("=== H_1043 TERMINAL faithful IIT-4.0 φ_EI (stdlib exact MIP-EI) ===")
    println("state file: " + path)

    let text = read_file(path)
    let lines = text.split("\n")
    let nb = 2                          // binary TPM state (matches python N_BINS=2)

    let mut phi_base = 0.0
    let mut have_base = false

    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if len(line) > 0 && line.split(" ")[0] == "#" {
            // header: # <tag> <n> <dim>
            let toks = line.split(" ")
            let tag = toks[1]
            let n = toks[2].to_int()
            let dim = toks[3].to_int()
            // read the next n rows into a flat n*dim farr (row-major: cell*dim+step)
            let state = farr_zeros(n * dim)
            let mut r = 0
            while r < n {
                i = i + 1
                let row = lines[i].trim().split(" ")
                let mut c = 0
                while c < dim {
                    let _ = farr_set(state, r * dim + c, row[c].to_float())
                    c = c + 1
                }
                r = r + 1
            }
            let phi = iit4_faithful_phi(state, n, dim, nb)
            let _ = farr_free(state)
            if tag == "base" { phi_base = phi; have_base = true }
            let mut dstr = ""
            if have_base { dstr = "  Δ_vs_base=" + _f6(phi - phi_base) }
            println("  [" + tag + "]  n=" + str(n) + " dim=" + str(dim)
                + "  faithful_phi_EI=" + _f6(phi) + dstr)
        }
        i = i + 1
    }
    println("=== terminal faithful IIT-4.0 φ_EI complete (a_phi_iit4_tool) ===")
}
