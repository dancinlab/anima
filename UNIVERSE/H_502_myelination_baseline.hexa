// H_502 smoke — MYELINATION latency

fn myelinated_latency(base: f64, k: f64) -> f64 {
    if k <= 1.0 { return base }
    return base / k
}

fn check_h502() -> bool {
    let base = 10.0
    let lat_5 = myelinated_latency(base, 5.0)
    let h1 = lat_5 < base
    let h2 = myelinated_latency(base, 1.0) == base  // k=1 → unchanged
    return h1 && h2
}

fn main() {
    let ok = check_h502()
    if !ok { print("H_502 FAIL"); return }
    print("H_502 blue MYELIN OK")
}
