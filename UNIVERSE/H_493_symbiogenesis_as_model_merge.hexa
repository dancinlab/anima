// H_493 smoke — SYMBIOGENESIS model merge

fn merge_weight(w_a: f64, w_b: f64, alpha: f64) -> f64 {
    return alpha * w_a + (1.0 - alpha) * w_b
}

fn check_h493() -> bool {
    let a = 0.6
    let b = 0.2
    let half = merge_weight(a, b, 0.5)
    let h1 = half == 0.4
    let h3_a = merge_weight(a, b, 1.0) == a
    let h3_b = merge_weight(a, b, 0.0) == b
    return h1 && h3_a && h3_b
}

fn main() {
    let ok = check_h493()
    if !ok { print("H_493 FAIL"); return }
    print("H_493 blue SYMBIO-merge OK")
}
