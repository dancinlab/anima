// H_501 smoke — NEUROGENESIS ex nihilo

fn n_after_neurogenesis(n_before: i64) -> i64 {
    return n_before + 1
}

fn cell_origin(via_neurogenesis: bool) -> string {
    if via_neurogenesis { return "ex_nihilo" }
    return "mitosis_split"
}

fn check_h501() -> bool {
    let h2 = n_after_neurogenesis(10) == 11
    let h1 = cell_origin(true) == "ex_nihilo"
    let h1_alt = cell_origin(false) == "mitosis_split"
    return h2 && h1 && h1_alt
}

fn main() {
    let ok = check_h501()
    if !ok { print("H_501 FAIL"); return }
    print("H_501 blue NEUROGENESIS OK")
}
