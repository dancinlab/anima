// H_426 smoke — M Lipschitz

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return -x }
    return x
}

fn k_bound() -> f64 {
    return 0.1 * 3.0  // Δ × sd_max = 0.3
}

fn delta_m(m_prev: f64, m_next: f64) -> f64 {
    return abs_f(m_next - m_prev)
}

fn check_h426() -> bool {
    let k = k_bound()
    let dm1 = delta_m(0.5, 0.7)  // 0.2
    let h1 = dm1 <= k
    let dm2 = delta_m(0.1, 0.4)  // 0.3 = k exactly
    let h2 = dm2 <= k
    return h1 && h2
}

fn main() {
    let ok = check_h426()
    if !ok { print("H_426 FAIL"); return }
    print("H_426 blue Lipschitz OK")
}
