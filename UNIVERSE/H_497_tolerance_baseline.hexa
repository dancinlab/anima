// H_497 smoke — TOLERANCE threshold

fn input_accepted(sim: f64, theta_tol: f64) -> bool {
    return sim >= theta_tol
}

fn check_h497() -> bool {
    let theta = 0.7
    let fam = input_accepted(0.9, theta)
    let novel = !input_accepted(0.3, theta)
    let boundary = input_accepted(0.7, theta)
    return fam && novel && boundary
}

fn main() {
    let ok = check_h497()
    if !ok { print("H_497 FAIL"); return }
    print("H_497 blue TOLERANCE OK")
}
