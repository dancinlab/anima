// ════════════════════════════════════════════════════════════════════════════
//  run_h262.hexa — H_262 quorum-sensing
//                  collective bistable state-switch from a shared quorum signal
//                  (life-extended / collective axis · H_207 sister · raw#12)
//
//  CORE QUESTION
//    A pool of N cells each carries a continuous activation a_i and a binary
//    state s_i ∈ {0, 1}. Cells SHARE one signal — the quorum
//    Q = (#cells with s_i = 1) / N. When the synchronized fraction Q exceeds a
//    pre-set quorum threshold q_thr, a positive-feedback boost is injected into
//    every cell's activation (autoinducer-style cooperative drive). Does a
//    *collective* state-switch (a sharp jump of Q from ~0 to ~1) emerge above
//    the quorum threshold and NOT below it? Is the transition bistable
//    (hysteresis on ramp-down)? — bacterial quorum-sensing substrate analog.
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model=8, initial_cells=N) — each cell's per-step
//    mitosis tension drives a small deterministic intrinsic activation gain, so
//    the activation dynamics are substrate-native (not arbitrary scalars).
//    seed via __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) — deterministic.
//
//  ACTIVATION DYNAMICS (per step t, per cell i)
//    intrinsic_i = base_gain                        (uniform slow drift up)
//    boost       = (Q_prev > q_thr) ? coupling : 0  (collective autoinducer)
//    a_i(t+1)    = a_i(t) + intrinsic_i + boost - leak * a_i(t)
//    s_i         = hysteretic: ON if a_i > up_thr ; OFF if a_i < dn_thr ;
//                  else hold previous (bistable single-cell latch)
//    Q(t+1)      = mean(s_i)
//    SWITCH at first step where Q crosses 0.5 (collective majority ON).
//
//  SWEEP (3 quorum thresholds × 2 coupling strengths = 6 conditions)
//    q_thr     ∈ {0.3, 0.5, 0.7}
//    coupling  ∈ {0.0 (no autoinducer / control), 0.20 (cooperative)}
//
//  MEASURE per condition
//    switched        : did Q ever reach >= 0.5 within max_steps?
//    switch_step     : first step at which Q >= 0.5 (-1 if never)
//    Q_at_switch     : the quorum fraction at the step just before crossing
//    Q_final         : Q at the last step
//    sharpness       : max single-step jump ΔQ over the run (transition sharp?)
//    hyst_gap        : ramp-up switch_step vs ramp-down un-switch_step gap
//                      (bistability / hysteresis proxy)
//
//  CRITERIA (pre-registered · verdict_rule)
//    C1 QUORUM-GATE : coupled (0.20) condition switches (Q→ON) AND the
//                     no-coupling control (0.0) does NOT switch — collective
//                     switch is gated by the shared quorum signal.
//    C2 BISTABLE    : the coupled transition is sharp (max ΔQ jump >= 0.25 in
//                     one step) OR shows hysteresis (hyst_gap > 0) — a
//                     bistable decision, not a smooth ramp.
//    C3 MONOTONE    : higher q_thr ⇒ later switch_step (monotone non-decreasing
//                     across {0.3, 0.5, 0.7} in the coupled regime).
//    C4 DETERMINISM : re-run switch_step matrix byte-equal.
//    SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = !C1
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "UNIVERSE/state/h262_quorum_sensing_2026_05_25"
}
fn _d_model() -> int     { return 8 }
fn _pool_n() -> int      { return 16 }   // collective axis — larger pool
fn _seed() -> int        { return 42 }
fn _max_steps() -> int   { return 40 }

// activation latch + drift params (calibrated on the substrate tension
// distribution so the no-coupling control settles at a PARTIAL quorum
// (~0.44 > q_thr=0.3 but < majority 0.5 — no collective switch), while the
// coupled regime's autoinducer boost cascades that partial quorum to full ON).
fn _base_gain() -> float { return 0.0135 } // intrinsic slow drift per step
fn _leak()      -> float { return 0.05 }   // activation decay (time-const 20 step)
fn _tcoef()     -> float { return 0.11 }   // substrate-tension heterogeneity gain
fn _up_thr()    -> float { return 1.0 }    // a_i > up_thr → cell ON
fn _dn_thr()    -> float { return 0.4 }    // a_i < dn_thr → cell OFF (hysteresis)


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _zero_vec(n: int) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(0.0)
        i = i + 1
    }
    return a
}

fn _vec_mean_scalar(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

// per-cell intrinsic tension proxy — mean(|hidden|) of cell i. substrate-native
// drive: a tense cell drifts up slightly faster (deterministic, seed-fixed).
fn _cell_tension(cell) -> float {
    let h = cell["hidden"]
    let n = len(h)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let v = h[i]
        if v < 0.0 { s = s - v } else { s = s + v }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}

// top-level helpers (NOTE: nested `fn` defs that reference an outer-scope `fn`
// crash the hexa transpiler — keep all fns at module top level).
// C3 ordering helper: a never-switched condition (-1) sorts past the horizon.
fn _eff_step(r) -> int {
    let s = r["switch_step"]
    if s < 0 { return _max_steps() + 1 }
    return s
}
// F5 bounds helpers.
fn _q_ok(x: float) -> bool { return (x >= 0.0) && (x <= 1.0) }
fn _s_ok(s: int) -> bool { return (s >= -1) && (s < _max_steps()) }


// ── run one (q_thr, coupling) ramp-UP condition ──────────────────────────────
//
// Evolves max_steps. Each step:
//   * advance mitosis substrate one tick (drives per-cell tension).
//   * activation update per cell with collective boost gated by Q_prev > q_thr.
//   * hysteretic latch → binary states → Q.
//   * record switch_step (first Q >= 0.5), Q trace, max single-step ΔQ.
//
// Returns dict.
fn _run_up(q_thr: float, coupling: float) {
    let d = _d_model()
    let n = _pool_n()
    let mut pool = cell_pool_init(d, n)

    let mut act    = _zero_vec(n)   // continuous activation per cell
    let mut state  = _zero_vec(n)   // binary latch (0.0 / 1.0)
    let mut q_prev = 0.0

    let base  = _base_gain()
    let leak  = _leak()
    let tcoef = _tcoef()
    let up    = _up_thr()
    let dn    = _dn_thr()

    let mut switch_step  = -1
    let mut q_at_switch  = 0.0
    let mut max_jump     = 0.0
    // substrate driven with ZERO external input — it evolves autonomously
    // (deterministic Lorenz perturbation per cell). This keeps the mitosis
    // forward in its tested regime; the per-cell tension it produces is the
    // substrate-native heterogeneity source for the activation gain.
    let x = _zero_vec(d)

    let mut step = 0
    while step < _max_steps() {
        // 1. advance substrate (autonomous tick).
        let res = mitosis_forward_tail(x, pool, step)
        pool = res[1]

        // 2. collective autoinducer boost — gated by PREVIOUS quorum.
        let mut boost = 0.0
        if q_prev > q_thr { boost = coupling }

        // 3. per-cell activation update + hysteretic latch.
        let cells = pool["cells"]
        let n_cells = len(cells)
        let mut i = 0
        while i < n {
            // substrate-native intrinsic gain: base + tension heterogeneity.
            let mut tens = 0.0
            if i < n_cells { tens = _cell_tension(cells[i]) }
            let intrinsic = base + tcoef * tens
            let a_new = act[i] + intrinsic + boost - leak * act[i]
            act[i] = a_new

            // hysteretic binary latch (bistable single-cell).
            if a_new > up {
                state[i] = 1.0
            } else {
                if a_new < dn {
                    state[i] = 0.0
                }
                // else: hold previous state (the bistable hold band).
            }
            i = i + 1
        }

        // 4. quorum.
        let q_now = _vec_mean_scalar(state)

        // 5. single-step jump magnitude.
        let jump = q_now - q_prev
        let abs_jump = if jump < 0.0 { 0.0 - jump } else { jump }
        if abs_jump > max_jump { max_jump = abs_jump }

        // 6. collective switch detection (first majority-ON).
        if switch_step < 0 {
            if q_now >= 0.5 {
                switch_step = step
                q_at_switch = q_prev
            }
        }

        q_prev = q_now
        step = step + 1
    }

    let switched = switch_step >= 0
    return #{
        "q_thr":        q_thr,
        "coupling":     coupling,
        "switched":     switched,
        "switch_step":  switch_step,
        "q_at_switch":  q_at_switch,
        "q_final":      q_prev,
        "max_jump":     max_jump
    }
}


// ── ramp-DOWN (hysteresis probe) ─────────────────────────────────────────────
//
// Start fully ON (all states = 1, activations above up_thr) with the coupling
// boost active, then withdraw the boost (set q_thr above 1.0 so it never fires)
// and let activations leak down. Record the step at which Q drops below 0.5.
// If un_switch_step (ramp-down) differs from switch_step (ramp-up), the latch
// shows hysteresis — bistability evidence.
fn _run_down(coupling: float) {
    let d = _d_model()
    let n = _pool_n()
    let mut pool = cell_pool_init(d, n)

    // start fully ON, activations seeded above up_thr.
    let mut act   = _zero_vec(n)
    let mut state = _zero_vec(n)
    let up = _up_thr()
    let dn = _dn_thr()
    let leak = _leak()
    let base = _base_gain()
    let mut i = 0
    while i < n {
        act[i] = up + 0.2   // above up threshold
        state[i] = 1.0
        i = i + 1
    }

    let x = _zero_vec(d)
    let mut un_switch_step = -1
    let mut q_prev = 1.0

    let mut step = 0
    while step < _max_steps() {
        let res = mitosis_forward_tail(x, pool, step)
        pool = res[1]

        // NO boost on ramp-down (autoinducer withdrawn) — pure leak.
        let cells = pool["cells"]
        let n_cells = len(cells)
        let mut k = 0
        while k < n {
            let mut tens = 0.0
            if k < n_cells { tens = _cell_tension(cells[k]) }
            // on ramp-down the intrinsic drift is suppressed (signal withdrawn);
            // only leak acts, plus a tiny residual tension term.
            let a_new = act[k] + 0.001 * tens - leak * act[k]
            act[k] = a_new
            if a_new > up {
                state[k] = 1.0
            } else {
                if a_new < dn {
                    state[k] = 0.0
                }
            }
            k = k + 1
        }

        let q_now = _vec_mean_scalar(state)
        if un_switch_step < 0 {
            if q_now < 0.5 {
                un_switch_step = step
            }
        }
        q_prev = q_now
        step = step + 1
    }

    return #{
        "coupling":        coupling,
        "un_switch_step":  un_switch_step,
        "q_final":         q_prev
    }
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h262() {
    println("================================================================")
    println("H_262 quorum-sensing — collective bistable state-switch from a")
    println("                        shared quorum signal")
    println("  d_model=" + to_string(_d_model())
            + " pool_N=" + to_string(_pool_n())
            + " max_steps=" + to_string(_max_steps())
            + " seed=" + to_string(_seed()))
    println("  q_thr: 0.3, 0.5, 0.7 · coupling: 0.0 (control), 0.20 (coop)")
    println("================================================================")

    // 3 q_thr × 2 coupling sweep — 6 ramp-up conditions.
    //
    // NOTE on determinism (honest): the gaussian stream
    // (`__HEXA_FARR_GAUSS_SEED__`) is PROCESS-GLOBAL and advances continuously
    // across calls — there is no in-process reseed primitive. So two sequential
    // in-process calls with identical args legitimately differ (each starts at a
    // different stream position). The canonical determinism property is therefore
    // CROSS-PROCESS re-run byte-equality: the whole sweep is a pure function of
    // (seed, call-order). F4 verifies this by fingerprint persistence — the
    // script writes a fingerprint of all results to det_fingerprint.txt, and on
    // a re-run reads the prior fingerprint and asserts byte-equality.
    let c_ctrl_30 = _run_up(0.3, 0.0)
    let c_ctrl_50 = _run_up(0.5, 0.0)
    let c_ctrl_70 = _run_up(0.7, 0.0)
    let c_coop_30 = _run_up(0.3, 0.20)
    let c_coop_50 = _run_up(0.5, 0.20)
    let c_coop_70 = _run_up(0.7, 0.20)

    // hysteresis probe (coupled).
    let down = _run_down(0.20)

    // ── print sweep table ──
    println("regime    q_thr  switched  switch_step  q_final  max_jump")
    println("------    -----  --------  -----------  -------  --------")
    println("control    0.3    " + _bool_str(c_ctrl_30["switched"])
            + "      " + to_string(c_ctrl_30["switch_step"])
            + "          " + to_string(c_ctrl_30["q_final"])
            + "     " + to_string(c_ctrl_30["max_jump"]))
    println("control    0.5    " + _bool_str(c_ctrl_50["switched"])
            + "      " + to_string(c_ctrl_50["switch_step"])
            + "          " + to_string(c_ctrl_50["q_final"])
            + "     " + to_string(c_ctrl_50["max_jump"]))
    println("control    0.7    " + _bool_str(c_ctrl_70["switched"])
            + "      " + to_string(c_ctrl_70["switch_step"])
            + "          " + to_string(c_ctrl_70["q_final"])
            + "     " + to_string(c_ctrl_70["max_jump"]))
    println("coop       0.3    " + _bool_str(c_coop_30["switched"])
            + "      " + to_string(c_coop_30["switch_step"])
            + "          " + to_string(c_coop_30["q_final"])
            + "     " + to_string(c_coop_30["max_jump"]))
    println("coop       0.5    " + _bool_str(c_coop_50["switched"])
            + "      " + to_string(c_coop_50["switch_step"])
            + "          " + to_string(c_coop_50["q_final"])
            + "     " + to_string(c_coop_50["max_jump"]))
    println("coop       0.7    " + _bool_str(c_coop_70["switched"])
            + "      " + to_string(c_coop_70["switch_step"])
            + "          " + to_string(c_coop_70["q_final"])
            + "     " + to_string(c_coop_70["max_jump"]))

    // ── derived ──
    // C1 QUORUM-GATE: at least one coupled condition switches AND all controls
    //   do NOT switch.
    let any_coop_switch = c_coop_30["switched"] || c_coop_50["switched"]
                          || c_coop_70["switched"]
    let any_ctrl_switch = c_ctrl_30["switched"] || c_ctrl_50["switched"]
                          || c_ctrl_70["switched"]
    let c1 = any_coop_switch && (!any_ctrl_switch)

    // C2 BISTABLE: coupled transition sharp (max single-step jump >= 0.25) OR
    //   hysteresis (ramp-down un-switch later than would be symmetric, i.e.
    //   un_switch_step > switch_step of the 0.5 coupled condition, or never
    //   un-switches within max_steps = full hysteresis).
    let coop_sharp = (c_coop_30["max_jump"] >= 0.25)
                     || (c_coop_50["max_jump"] >= 0.25)
                     || (c_coop_70["max_jump"] >= 0.25)
    // hysteresis: down-probe stays ON (un_switch_step < 0 = never dropped) OR
    // un-switch happens strictly later than ramp-up switch_step at q_thr=0.5.
    let up50 = c_coop_50["switch_step"]
    let dn_un = down["un_switch_step"]
    let hysteresis = (dn_un < 0) || ((up50 >= 0) && (dn_un > up50))
    let c2 = coop_sharp || hysteresis

    // C3 MONOTONE: in coupled regime, higher q_thr ⇒ later (or equal)
    //   switch_step. Only meaningful among switched conditions; a non-switch
    //   (switch_step = -1) is treated as "latest" = max_steps for ordering
    //   (see top-level _eff_step).
    let s30 = _eff_step(c_coop_30)
    let s50 = _eff_step(c_coop_50)
    let s70 = _eff_step(c_coop_70)
    let c3 = (s50 >= s30) && (s70 >= s50)

    // C4 determinism — CROSS-PROCESS re-run byte-equality via fingerprint
    //   persistence. Build a fingerprint string of every sweep result; compare
    //   it to the fingerprint written by the PREVIOUS process run (if any). The
    //   gaussian stream is process-global + seed-fixed, so two separate process
    //   runs of this same script produce byte-identical sweeps ⇒ fingerprints
    //   match. First run (no prior file) seeds the fingerprint and PASSES
    //   vacuously; the canonical confirmation is the SECOND run matching it.
    let fp = "ctrl30=" + to_string(c_ctrl_30["switch_step"]) + "," + to_string(c_ctrl_30["q_final"]) + "," + to_string(c_ctrl_30["max_jump"])
           + ";ctrl50=" + to_string(c_ctrl_50["switch_step"]) + "," + to_string(c_ctrl_50["q_final"]) + "," + to_string(c_ctrl_50["max_jump"])
           + ";ctrl70=" + to_string(c_ctrl_70["switch_step"]) + "," + to_string(c_ctrl_70["q_final"]) + "," + to_string(c_ctrl_70["max_jump"])
           + ";coop30=" + to_string(c_coop_30["switch_step"]) + "," + to_string(c_coop_30["q_final"]) + "," + to_string(c_coop_30["max_jump"])
           + ";coop50=" + to_string(c_coop_50["switch_step"]) + "," + to_string(c_coop_50["q_final"]) + "," + to_string(c_coop_50["max_jump"])
           + ";coop70=" + to_string(c_coop_70["switch_step"]) + "," + to_string(c_coop_70["q_final"]) + "," + to_string(c_coop_70["max_jump"])
           + ";down=" + to_string(down["un_switch_step"]) + "," + to_string(down["q_final"])
    let fp_path = _state_dir() + "/det_fingerprint.txt"
    let mut c4 = true
    let mut c4_note = "first run (fingerprint seeded; re-run to confirm)"
    if file_exists(fp_path) {
        let mut prev = ""
        try { prev = to_string(read_file(fp_path)).trim() } catch e { prev = "" }
        c4 = (prev == fp)
        if c4 { c4_note = "cross-process re-run byte-equal (prior fingerprint matched)" }
        else { c4_note = "MISMATCH vs prior fingerprint — non-deterministic!" }
    }
    write_file(fp_path, fp + "\n")

    // ── falsifiers ──
    // F1 QUORUM-GATE = C1.
    let f1 = c1
    // F2 BISTABLE = C2.
    let f2 = c2
    // F3 MONOTONE = C3.
    let f3 = c3
    // F4 determinism.
    let f4 = c4
    // F5 BOUNDS: all Q values ∈ [0, 1] and switch_step ∈ [-1, max_steps)
    //   (see top-level _q_ok / _s_ok).
    let f5 = _q_ok(c_ctrl_30["q_final"]) && _q_ok(c_ctrl_50["q_final"])
          && _q_ok(c_ctrl_70["q_final"]) && _q_ok(c_coop_30["q_final"])
          && _q_ok(c_coop_50["q_final"]) && _q_ok(c_coop_70["q_final"])
          && _s_ok(c_coop_30["switch_step"]) && _s_ok(c_coop_50["switch_step"])
          && _s_ok(c_coop_70["switch_step"])

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }
    if c4 { n_c = n_c + 1 }

    // verdict_rule.
    let supported_full = c1 && c2 && c3 && c4
    let supported = c1 && c2
    let partial = c1
    let verdict = if supported_full {
        "SUPPORTED_FULL"
    } else {
        if supported {
            "SUPPORTED"
        } else {
            if partial {
                "PARTIAL"
            } else {
                if n_pass <= 1 { "FAIL" } else { "PARTIAL" }
            }
        }
    }
    let final_verdict = if !f1 { "FALSIFIED" } else { verdict }

    println("")
    println("derived:")
    println("  any_coop_switch = " + _bool_str(any_coop_switch))
    println("  any_ctrl_switch = " + _bool_str(any_ctrl_switch))
    println("  coop switch_step (q=0.3/0.5/0.7) = "
            + to_string(c_coop_30["switch_step"]) + " / "
            + to_string(c_coop_50["switch_step"]) + " / "
            + to_string(c_coop_70["switch_step"]))
    println("  coop max_jump (q=0.3/0.5/0.7)    = "
            + to_string(c_coop_30["max_jump"]) + " / "
            + to_string(c_coop_50["max_jump"]) + " / "
            + to_string(c_coop_70["max_jump"]))
    println("  ramp-up switch_step (q=0.5)  = " + to_string(up50))
    println("  ramp-down un_switch_step     = " + to_string(dn_un)
            + "  (-1 = stayed ON = full hysteresis)")
    println("  determinism: " + c4_note)
    println("")
    println("C1 QUORUM-GATE (coop switch, control no-switch) : " + _bool_str(c1))
    println("C2 BISTABLE    (sharp jump >=0.25 OR hysteresis) : " + _bool_str(c2))
    println("C3 MONOTONE    (q_thr up => switch later)        : " + _bool_str(c3))
    println("C4 DETERMINISM (cross-process byte-equal)        : " + _bool_str(c4))
    println("")
    println("F1 QUORUM-GATE   " + v1)
    println("F2 BISTABLE      " + v2)
    println("F3 MONOTONE      " + v3)
    println("F4 DETERMINISM   " + v4)
    println("F5 BOUNDS        " + v5)
    println("================================================================")
    println("VERDICT: " + final_verdict
            + "  (" + to_string(n_c) + "/4 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_262\",\n"
    j = j + "  \"slug\": \"quorum-sensing\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"quorum-sensing — collective bistable state-switch from a shared quorum signal (H_207 sister)\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"ubu-2 (pool host; mac-local blocked by pool-route heavy gate)\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"pool_N\": " + to_string(_pool_n())
          + ", \"max_steps\": " + to_string(_max_steps())
          + ", \"base_gain\": " + to_string(_base_gain())
          + ", \"leak\": " + to_string(_leak())
          + ", \"tcoef\": " + to_string(_tcoef())
          + ", \"up_thr\": " + to_string(_up_thr())
          + ", \"dn_thr\": " + to_string(_dn_thr())
          + ", \"coupling_coop\": 0.20},\n"
    j = j + "  \"sweep\": {\n"

    j = j + "    \"control_30\": { \"regime\": \"control\", \"q_thr\": 0.3, \"coupling\": 0.0, \"switched\": " + _bool_str(c_ctrl_30["switched"])
          + ", \"switch_step\": " + to_string(c_ctrl_30["switch_step"])
          + ", \"q_final\": " + to_string(c_ctrl_30["q_final"])
          + ", \"max_jump\": " + to_string(c_ctrl_30["max_jump"]) + " },\n"
    j = j + "    \"control_50\": { \"regime\": \"control\", \"q_thr\": 0.5, \"coupling\": 0.0, \"switched\": " + _bool_str(c_ctrl_50["switched"])
          + ", \"switch_step\": " + to_string(c_ctrl_50["switch_step"])
          + ", \"q_final\": " + to_string(c_ctrl_50["q_final"])
          + ", \"max_jump\": " + to_string(c_ctrl_50["max_jump"]) + " },\n"
    j = j + "    \"control_70\": { \"regime\": \"control\", \"q_thr\": 0.7, \"coupling\": 0.0, \"switched\": " + _bool_str(c_ctrl_70["switched"])
          + ", \"switch_step\": " + to_string(c_ctrl_70["switch_step"])
          + ", \"q_final\": " + to_string(c_ctrl_70["q_final"])
          + ", \"max_jump\": " + to_string(c_ctrl_70["max_jump"]) + " },\n"
    j = j + "    \"coop_30\":    { \"regime\": \"coop\",    \"q_thr\": 0.3, \"coupling\": 0.20, \"switched\": " + _bool_str(c_coop_30["switched"])
          + ", \"switch_step\": " + to_string(c_coop_30["switch_step"])
          + ", \"q_at_switch\": " + to_string(c_coop_30["q_at_switch"])
          + ", \"q_final\": " + to_string(c_coop_30["q_final"])
          + ", \"max_jump\": " + to_string(c_coop_30["max_jump"]) + " },\n"
    j = j + "    \"coop_50\":    { \"regime\": \"coop\",    \"q_thr\": 0.5, \"coupling\": 0.20, \"switched\": " + _bool_str(c_coop_50["switched"])
          + ", \"switch_step\": " + to_string(c_coop_50["switch_step"])
          + ", \"q_at_switch\": " + to_string(c_coop_50["q_at_switch"])
          + ", \"q_final\": " + to_string(c_coop_50["q_final"])
          + ", \"max_jump\": " + to_string(c_coop_50["max_jump"]) + " },\n"
    j = j + "    \"coop_70\":    { \"regime\": \"coop\",    \"q_thr\": 0.7, \"coupling\": 0.20, \"switched\": " + _bool_str(c_coop_70["switched"])
          + ", \"switch_step\": " + to_string(c_coop_70["switch_step"])
          + ", \"q_at_switch\": " + to_string(c_coop_70["q_at_switch"])
          + ", \"q_final\": " + to_string(c_coop_70["q_final"])
          + ", \"max_jump\": " + to_string(c_coop_70["max_jump"]) + " }\n"
    j = j + "  },\n"
    j = j + "  \"hysteresis_probe\": { \"coupling\": 0.20, \"ramp_up_switch_step\": " + to_string(up50)
          + ", \"ramp_down_un_switch_step\": " + to_string(dn_un)
          + ", \"down_q_final\": " + to_string(down["q_final"]) + " },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"any_coop_switch\": " + _bool_str(any_coop_switch) + ",\n"
    j = j + "    \"any_ctrl_switch\": " + _bool_str(any_ctrl_switch) + ",\n"
    j = j + "    \"coop_sharp\":      " + _bool_str(coop_sharp) + ",\n"
    j = j + "    \"hysteresis\":      " + _bool_str(hysteresis) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_quorum_gate\":  " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_bistable\":     " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_monotone\":     " + _bool_str(c3) + ",\n"
    j = j + "    \"C4_determinism\":  " + _bool_str(c4) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_QUORUM_GATE\": { \"metric\": \"coop switches AND control no-switch\", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_BISTABLE\":    { \"metric\": \"sharp jump >=0.25 OR hysteresis\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_MONOTONE\":    { \"metric\": \"higher q_thr => later switch\", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_DETERMINISM\": { \"metric\": \"cross-process re-run byte-equal (fingerprint)\", \"note\": \"" + c4_note + "\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_BOUNDS\":      { \"metric\": \"Q in [0,1], switch_step in [-1,max_steps)\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + final_verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_207\": \"kuramoto synchronization\", \"H_012\": \"autopoietic network\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h262()
