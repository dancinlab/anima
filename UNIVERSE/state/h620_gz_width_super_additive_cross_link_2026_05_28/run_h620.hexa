// H_620 — gz-width-super-additive-cross-link
// E1 × F1 MATRIX cell — GZ_WIDTH (H_347) × collective-Φ super-additive (H_609)
// substrate data is deterministic-replay from H_609 result.json
// (re-running H_609 is wasteful — same engine, same seed-free determinism)
// here we test: is some collective measurement / Φ_baseline an integer multiple of GZ_WIDTH ?

fn ln(x: float) -> float {
  // Newton-iteration ln for x>0, fallback to series
  if x <= 0.0 { return 0.0 }
  let y = x
  // identity ln(x) = 2 * atanh((x-1)/(x+1))
  let u = (y - 1.0) / (y + 1.0)
  let u2 = u * u
  let mut s = u
  let mut t = u
  let mut k = 1
  while k < 60 {
    t = t * u2
    let term = t / (float(2 * k + 1))
    s = s + term
    k = k + 1
  }
  return 2.0 * s
}

fn abs(x: float) -> float {
  if x < 0.0 { return -x }
  return x
}

fn main() {
  println("H_620 — GZ_WIDTH × super-additive cross-link")
  println("============================================================")

  let GZ_WIDTH = ln(4.0 / 3.0)
  println("GZ_WIDTH = ln(4/3) = " + str(GZ_WIDTH))

  // ── H_609 deterministic substrate snapshot ───────────────────────────
  // rule_pair (110,110), W ∈ {0.0, 0.3, 0.6, 1.0}
  let phi_ab_110_110 = [0.0, 11.2412, 15.4677, 11.7683]
  let phi_a_110 = 2.49604
  let phi_b_110 = 2.49604
  let sum_ind = phi_a_110 + phi_b_110  // 4.99208 baseline

  // ── measurement candidates ──────────────────────────────────────────
  // M1: Φ_collective range (max − min) over W ∈ {0.3, 0.6, 1.0} (W=0 excluded — decoupled anchor)
  let max_phi = 15.4677
  let min_phi_coupled = 11.2412  // min of coupled set {11.24, 15.47, 11.77}
  let range_phi = max_phi - min_phi_coupled  // 4.2265

  // M2: Φ_collective range full (max − min) over W ∈ {0.0, 0.3, 0.6, 1.0}
  let range_full = max_phi - 0.0  // 15.4677

  // M3: peak excess Δ = max(Φ_AB) − (Φ_A + Φ_B)
  let peak_excess = 15.4677 - sum_ind  // 10.4756

  // M4: peak ratio Φ(AB)/Φ(A)+Φ(B) at W=0.6
  let peak_ratio = 15.4677 / sum_ind  // 3.0985

  // M5: mean of Φ_AB over coupled W (3 points)
  let mean_coupled = (11.2412 + 15.4677 + 11.7683) / 3.0  // 12.8257

  // ── normalizations to dimensionless ratios ──────────────────────────
  // R1: range_phi / sum_ind   (dimensionless excess-range vs additive sum)
  let R1 = range_phi / sum_ind                    // 4.2265 / 4.99208 = 0.8466
  // R2: peak_excess / sum_ind (Δ as multiple of additive baseline)
  let R2 = peak_excess / sum_ind                  // 10.4756 / 4.99208 = 2.0985
  // R3: peak_ratio - 1                            (excess fraction)
  let R3 = peak_ratio - 1.0                       // 2.0985 (== R2 by algebra)
  // R4: range_phi / peak_excess                  (dispersion vs peak gain)
  let R4 = range_phi / peak_excess                // 4.2265 / 10.4756 = 0.4035
  // R5: mean_coupled / max_phi                   (mean / peak — saturation degree)
  let R5 = mean_coupled / max_phi                 // 12.8257 / 15.4677 = 0.8292

  // R-set: candidate ratios to test for integer-k GZ_WIDTH alignment
  let ratios = [R1, R2, R3, R4, R5]
  let names = ["R1=range/sum", "R2=Δ_peak/sum", "R3=peak_ratio-1", "R4=range/Δ_peak", "R5=mean/peak"]

  println("")
  println("── candidate ratios ─────────────────────────────────")
  println("R1 range_coupled / sum_ind   = " + str(R1))
  println("R2 Δ_peak        / sum_ind   = " + str(R2))
  println("R3 peak_ratio    − 1         = " + str(R3))
  println("R4 range_coupled / Δ_peak    = " + str(R4))
  println("R5 mean_coupled  / max_phi   = " + str(R5))

  // ── GZ_WIDTH integer-k probe ───────────────────────────────────────
  let tol = 0.02   // falsifier threshold from H_620 spec
  println("")
  println("── GZ_WIDTH integer-k probe (tol=±0.02) ─────────────")
  println("k:    1×GZ      2×GZ      3×GZ      4×GZ      5×GZ      6×GZ      7×GZ      8×GZ")

  let mut any_pass = false
  let mut best_residual = 1.0e9
  let mut best_k = 0
  let mut best_name = "none"

  let mut idx = 0
  while idx < 5 {
    let r = ratios[idx]
    let name = names[idx]
    let mut line = name + "  r=" + str(r) + "  residuals:"
    let mut k = 1
    while k <= 8 {
      let target = float(k) * GZ_WIDTH
      let resid = abs(r - target)
      line = line + "  k=" + str(k) + ":" + str(resid)
      if resid < best_residual {
        best_residual = resid
        best_k = k
        best_name = name
      }
      if resid <= tol {
        any_pass = true
      }
      k = k + 1
    }
    println(line)
    idx = idx + 1
  }

  println("")
  println("── verdict ──────────────────────────────────────────")
  println("best match: " + best_name + "  k=" + str(best_k) + "  residual=" + str(best_residual) + "  tol=" + str(tol))

  if any_pass {
    println("FALSIFIER F620.1 (integer-k linkage):   PASS  (some ratio aligns within ±0.02)")
    println("VERDICT: 🟢 SUPPORTED-NUMERICAL — collective-Φ measurement is integer multiple of GZ_WIDTH")
  } else {
    println("FALSIFIER F620.1 (integer-k linkage):   FAIL  (no ratio aligns within ±0.02 for k ∈ 1..8)")
    println("VERDICT: 🔴 FALSIFIED — H_347 GZ_WIDTH × H_609 super-additive cross-link rejected")
  }
}

