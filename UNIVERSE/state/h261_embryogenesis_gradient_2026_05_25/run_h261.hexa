// ════════════════════════════════════════════════════════════════════════════
//  run_h261.hexa — H_261 embryogenesis-gradient
//                  position-dependent differentiation under a spatial drive
//                  (division / 발생-축 · French-flag model analog · raw#12)
//
//  CORE QUESTION
//    cell lattice (N cells, each with a fixed position p_i = i/(N-1) ∈ [0,1])
//    에 spatial gradient field (position-proportional external drive
//    g_i = steepness * p_i) 를 매 step 주입하면, position-dependent
//    differentiation (위치별 cell state 분화 → 발생-축 형성) 이 emergent
//    한가? Wolpert (1969) French-flag morphogen-gradient model 의 substrate
//    analog.
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model, N) — mitosis_hook_lib shared pool.
//    seed via __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) — deterministic.
//    mitosis_forward_tail evolves the pool; between steps we inject a
//    position-proportional drive into each cell's hidden vector.
//
//  GRADIENT FIELD (per step, per cell-i)
//    p_i      = i / (N - 1)                 — normalized position in [0,1]
//    drive_i  = steepness * p_i             — morphogen concentration
//    hidden_i += drive_i  (broadcast to all d_model components)
//    flat regime: steepness = 0   → drive_i = 0 for all cells (control)
//    mid  regime: steepness = mid_s
//    steep regime: steepness = steep_s
//
//  SWEEP (3 steepness × 1 lattice size = 3 conditions; + 1 size variant)
//    steepness ∈ {flat (0.0), mid, steep}
//    lattice N (= pool cells)
//
//  MEASURE per condition
//    final_state_i = L2-norm of cell-i hidden after `steps` evolution
//    (a stable per-cell scalar summarizing the cell's substrate state)
//    r            = Pearson correlation( position_i , final_state_i )
//    n_regions    = number of non-empty bins of final_state_i over n_bins
//                   (threshold binning → 분화 영역 수)
//
//  CRITERIA (pre-register · verdict_rule)
//    C1 (axis-formation):    steep regime |r| >= R_HIGH (position↔state 강한 상관)
//    C2 (gradient-dependence): flat regime |r| <= R_LOW (gradient 없으면 r≈0)
//    C3 (differentiation):   steep regime n_regions >= 2
//    C4 (determinism):       re-run (r, n_regions) byte-equal
//    SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = ¬C1
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "UNIVERSE/state/h261_embryogenesis_gradient_2026_05_25"
}
fn _d_model() -> int        { return 8 }
fn _lattice_n() -> int      { return 12 }   // primary lattice size
fn _lattice_n_small() -> int { return 6 }   // size variant (C-axis sanity)
fn _seed() -> int           { return 42 }
fn _steps() -> int          { return 20 }   // evolution depth (developmental)

// steepness levels (morphogen drive amplitude).
fn _s_flat() -> float       { return 0.0 }
fn _s_mid() -> float        { return 1.0 }
fn _s_steep() -> float      { return 4.0 }

// number of bins for differentiation-region count (threshold binning).
fn _n_bins() -> int         { return 3 }

// criteria thresholds.
fn _r_high() -> float       { return 0.5 }   // C1: strong position↔state
fn _r_low() -> float        { return 0.2 }   // C2: gradient-independence (flat)


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _zero_vec(n: int) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(0.0)
        i = i + 1
    }
    return a
}

// L2 norm via Newton sqrt (same grain as H_220 _vec_l2).
fn _vec_l2(v) -> float {
    let n = len(v)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + (v[i] * v[i])
        i = i + 1
    }
    if s <= 0.0 { return 0.0 }
    let mut r = s
    let mut k = 0
    while k < 40 {
        if r <= 0.0 { r = 1.0e-12 }
        r = 0.5 * (r + s / r)
        k = k + 1
    }
    return r
}

fn _sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut r = x
    let mut k = 0
    while k < 40 {
        if r <= 0.0 { r = 1.0e-12 }
        r = 0.5 * (r + x / r)
        k = k + 1
    }
    return r
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _int_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}


// ── Pearson correlation r(xs, ys) ────────────────────────────────────────────
// r = Σ(x-x̄)(y-ȳ) / sqrt( Σ(x-x̄)² · Σ(y-ȳ)² ). If either variance ~0 → 0.0
// (no defined correlation; flat-state lattices fall here, which is the
// honest "no axis" reading).
fn _pearson_r(xs, ys) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let nf = to_float(n)

    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + xs[i]
        sy = sy + ys[i]
        i = i + 1
    }
    let mx = sx / nf
    let my = sy / nf

    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        i = i + 1
    }
    let denom = _sqrt_f(vx * vy)
    if denom < 1.0e-12 { return 0.0 }
    return cov / denom
}


// ── differentiation-region count via threshold binning ───────────────────────
// Min-max bin the per-cell state scalars into n_bins, count non-empty bins.
// all-identical states (range ~0) → 1 region (no differentiation).
fn _n_regions(states, n_bins: int) -> int {
    let n = len(states)
    if n == 0 { return 0 }
    let mut mn = states[0]
    let mut mx = states[0]
    let mut i = 1
    while i < n {
        if states[i] < mn { mn = states[i] }
        if states[i] > mx { mx = states[i] }
        i = i + 1
    }
    let range = mx - mn
    if range < 1.0e-9 { return 1 }      // all-identical → single region

    let bw = range / to_float(n_bins)
    // mark which bins are occupied.
    let mut occupied = []
    let mut b0 = 0
    while b0 < n_bins {
        occupied.push(0)
        b0 = b0 + 1
    }
    i = 0
    while i < n {
        let r = (states[i] - mn) / bw
        let mut b = floor(r).to_int()
        if b > n_bins - 1 { b = n_bins - 1 }
        if b < 0 { b = 0 }
        occupied[b] = 1
        i = i + 1
    }
    let mut count = 0
    let mut bb = 0
    while bb < n_bins {
        if occupied[bb] == 1 { count = count + 1 }
        bb = bb + 1
    }
    return count
}


// ── inject spatial gradient drive into each cell's hidden ────────────────────
// drive_i = steepness * p_i where p_i = i / (N - 1). Added to every component
// of cell-i hidden (broadcast morphogen concentration).
fn _inject_gradient(pool, steepness: float, n_fixed: int) {
    let cs = pool["cells"]
    let n = len(cs)
    // denominator over the ORIGINAL lattice (n_fixed), not split-grown count,
    // so position remains a stable [0,1] coordinate across the run.
    let denom = if n_fixed > 1 { to_float(n_fixed - 1) } else { 1.0 }
    let mut i = 0
    while i < n {
        if i < n_fixed {
            let p_i = to_float(i) / denom
            let drive = steepness * p_i
            let h = cs[i]["hidden"]
            let d = len(h)
            let mut new_h = []
            let mut q = 0
            while q < d {
                new_h.push(h[q] + drive)
                q = q + 1
            }
            pool["cells"][i]["hidden"] = new_h
        }
        i = i + 1
    }
    return pool
}


// ── run one (steepness, lattice_n) condition ─────────────────────────────────
//
// Protocol:
//   * init pool of N cells, d_model.
//   * for `steps` evolution steps:
//       - inject gradient drive (position-proportional) into each cell hidden
//       - run mitosis_forward_tail with zero external x (drive lives in hidden)
//   * after evolution, compute per-cell state scalar = L2(hidden) for the
//     ORIGINAL N cells (first N — splits-grown beyond N ignored for the
//     position-mapped measurement, mirroring H_220 _snapshot_hiddens).
//   * positions p_i = i/(N-1).
//   * r = pearson( positions , states ).
//   * n_regions = threshold-binned non-empty bins of states.
//
// Returns dict { regime, steepness, n, r, n_regions, states, positions,
//                state_min, state_max }
fn _run_condition(regime_name: string, steepness: float, lattice_n: int) {
    let d = _d_model()
    let n = lattice_n
    let mut pool = cell_pool_init(d, n)

    let zero_x = _zero_vec(d)

    let mut step = 0
    while step < _steps() {
        // 1. inject the spatial gradient field into hiddens.
        pool = _inject_gradient(pool, steepness, n)
        // 2. evolve one substrate step (external x = 0; gradient is in hidden).
        let res = mitosis_forward_tail(zero_x, pool, step)
        pool = res[1]
        step = step + 1
    }

    // measure per-cell state scalar over the original N cells.
    let cs = pool["cells"]
    let n_have = len(cs)
    let mut states = []
    let mut positions = []
    let denom = if n > 1 { to_float(n - 1) } else { 1.0 }
    let mut i = 0
    while i < n {
        let mut sc = 0.0
        if i < n_have {
            sc = _vec_l2(cs[i]["hidden"])
        }
        states.push(sc)
        positions.push(to_float(i) / denom)
        i = i + 1
    }

    let r = _pearson_r(positions, states)
    let nreg = _n_regions(states, _n_bins())

    // state min/max for reporting.
    let mut smn = states[0]
    let mut smx = states[0]
    let mut q = 1
    while q < len(states) {
        if states[q] < smn { smn = states[q] }
        if states[q] > smx { smx = states[q] }
        q = q + 1
    }

    return #{
        "regime":    regime_name,
        "steepness": steepness,
        "n":         n,
        "r":         r,
        "n_regions": nreg,
        "states":    states,
        "positions": positions,
        "state_min": smn,
        "state_max": smx
    }
}


// ── cross-process determinism check (process-local gauss stream) ─────────────
// The RFC 033 gaussian RNG is a PROCESS-LOCAL stream lazily seeded once from
// __HEXA_FARR_GAUSS_SEED__ and then ADVANCED by every farr_add_gaussian_noise
// call (runtime.c:7393). An in-process paired call therefore reads from two
// DIFFERENT stream offsets — it is NOT a determinism test. The honest test is
// CROSS-PROCESS re-run: a fresh process re-seeds the stream identically, so two
// independent `hexa run` invocations must produce byte-equal output.
//
// We bootstrap this with a reference file `det_ref.txt`:
//   * if it exists AND matches the current canonical signature → C4 PASS.
//   * otherwise (first run / mismatch) → write the signature, C4 = false this
//     run (run the smoke a SECOND time to confirm byte-equal, per Run Protocol).
fn _det_ref_path() -> string {
    return _state_dir() + "/det_ref.txt"
}

// Canonical signature = the determinism-critical scalars, concatenated.
fn _det_signature(r_steep, r_flat, r_mid) -> string {
    return to_string(r_steep["r"]) + "|"
         + to_string(r_steep["n_regions"]) + "|"
         + to_string(r_steep["state_min"]) + "|"
         + to_string(r_steep["state_max"]) + "|"
         + to_string(r_flat["r"]) + "|"
         + to_string(r_mid["r"])
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h261() {
    println("================================================================")
    println("H_261 embryogenesis-gradient — position-dependent differentiation")
    println("                                under a spatial morphogen drive")
    println("  d_model=" + to_string(_d_model())
            + " N=" + to_string(_lattice_n())
            + " steps=" + to_string(_steps())
            + " seed=" + to_string(_seed()))
    println("  steepness: flat=" + to_string(_s_flat())
            + " mid=" + to_string(_s_mid())
            + " steep=" + to_string(_s_steep()))
    println("  n_bins=" + to_string(_n_bins())
            + " R_HIGH=" + to_string(_r_high())
            + " R_LOW=" + to_string(_r_low()))
    println("================================================================")

    // 3 steepness × primary lattice N.
    let r_flat  = _run_condition("flat",  _s_flat(),  _lattice_n())
    let r_mid   = _run_condition("mid",   _s_mid(),   _lattice_n())
    let r_steep = _run_condition("steep", _s_steep(), _lattice_n())

    // size variant: steep on a smaller lattice (C-axis sanity).
    let r_steep_small = _run_condition("steep_small", _s_steep(), _lattice_n_small())

    // ── C4 cross-process determinism (bootstrap via det_ref.txt) ──
    let sig_now = _det_signature(r_steep, r_flat, r_mid)
    let prev = read_file(_det_ref_path())   // "" if absent
    let f4_eq = (len(prev) > 0) && (prev == sig_now)
    let f4_first_run = (len(prev) == 0)
    // always (re)write the reference so a SECOND `hexa run` can confirm.
    write_file(_det_ref_path(), sig_now)

    // ── print rows ──
    println("regime        steep    N    r           n_regions   state[min,max]")
    println("------------  -----  ---  ----------  ---------  --------------------")
    println("flat          " + to_string(r_flat["steepness"])
            + "    " + to_string(r_flat["n"])
            + "   " + to_string(r_flat["r"])
            + "   " + to_string(r_flat["n_regions"])
            + "   [" + to_string(r_flat["state_min"]) + ", " + to_string(r_flat["state_max"]) + "]")
    println("mid           " + to_string(r_mid["steepness"])
            + "    " + to_string(r_mid["n"])
            + "   " + to_string(r_mid["r"])
            + "   " + to_string(r_mid["n_regions"])
            + "   [" + to_string(r_mid["state_min"]) + ", " + to_string(r_mid["state_max"]) + "]")
    println("steep         " + to_string(r_steep["steepness"])
            + "    " + to_string(r_steep["n"])
            + "   " + to_string(r_steep["r"])
            + "   " + to_string(r_steep["n_regions"])
            + "   [" + to_string(r_steep["state_min"]) + ", " + to_string(r_steep["state_max"]) + "]")
    println("steep_small   " + to_string(r_steep_small["steepness"])
            + "    " + to_string(r_steep_small["n"])
            + "   " + to_string(r_steep_small["r"])
            + "   " + to_string(r_steep_small["n_regions"])
            + "   [" + to_string(r_steep_small["state_min"]) + ", " + to_string(r_steep_small["state_max"]) + "]")

    // ── criteria ──
    let r_flat_abs  = _abs(r_flat["r"])
    let r_steep_abs = _abs(r_steep["r"])

    // C1 axis-formation: steep |r| >= R_HIGH
    let c1 = r_steep_abs >= _r_high()
    // C2 gradient-dependence: flat |r| <= R_LOW
    let c2 = r_flat_abs <= _r_low()
    // C3 differentiation: steep n_regions >= 2
    let c3 = r_steep["n_regions"] >= 2
    // C4 determinism
    let c4 = f4_eq

    // F1..F5 (pre-registered falsifiers)
    // F1 AXIS-FORMATION: steep |r| >= R_HIGH (else FALSIFIED)
    let f1 = c1
    // F2 GRADIENT-DEPENDENCE: flat |r| <= R_LOW (gradient 의존성)
    let f2 = c2
    // F3 DIFFERENTIATION: steep n_regions >= 2
    let f3 = c3
    // F4 DETERMINISM
    let f4 = c4
    // F5 MONOTONE-DRIVE: steep |r| >= flat |r| (gradient amplifies axis vs control)
    let f5 = r_steep_abs >= r_flat_abs

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }
    if c4 { n_c = n_c + 1 }

    // verdict_rule: SUPPORTED = C1 ∧ C2 ; PARTIAL = C1 only ; FALSIFIED = ¬C1
    let verdict = if c1 {
        if c2 { "SUPPORTED" } else { "PARTIAL" }
    } else {
        "FALSIFIED"
    }

    println("")
    println("derived:")
    println("  |r| steep = " + to_string(r_steep_abs))
    println("  |r| flat  = " + to_string(r_flat_abs))
    println("  |r| mid   = " + to_string(_abs(r_mid["r"])))
    println("  axis-gap (|r|steep - |r|flat) = " + to_string(r_steep_abs - r_flat_abs))

    println("")
    println("C1 axis-formation   (|r|steep >= " + to_string(_r_high()) + ") : " + _bool_str(c1))
    println("C2 gradient-depend  (|r|flat  <= " + to_string(_r_low()) + ") : " + _bool_str(c2))
    println("C3 differentiation  (steep n_regions >= 2)  : " + _bool_str(c3))
    println("C4 determinism      (cross-proc byte-equal) : " + _bool_str(c4))
    if f4_first_run {
        println("    [C4 NOTE] first run wrote det_ref.txt — re-run this smoke "
                + "once more to confirm cross-process byte-equal (C4 PASS).")
    }
    println("")
    println("F1 AXIS-FORMATION     (|r|steep >= R_HIGH)  " + v1)
    println("F2 GRADIENT-DEPEND    (|r|flat  <= R_LOW)   " + v2)
    println("F3 DIFFERENTIATION    (steep regions >= 2)  " + v3)
    println("F4 DETERMINISM        (re-run byte-equal)   " + v4)
    println("F5 MONOTONE-DRIVE     (|r|steep >= |r|flat) " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/4 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_261\",\n"
    j = j + "  \"slug\": \"embryogenesis-gradient\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"embryogenesis-gradient — position-dependent differentiation under a spatial morphogen drive (French-flag analog)\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"lattice_N\": " + to_string(_lattice_n())
          + ", \"lattice_N_small\": " + to_string(_lattice_n_small())
          + ", \"steps\": " + to_string(_steps())
          + ", \"n_bins\": " + to_string(_n_bins())
          + ", \"s_flat\": " + to_string(_s_flat())
          + ", \"s_mid\": " + to_string(_s_mid())
          + ", \"s_steep\": " + to_string(_s_steep())
          + ", \"R_HIGH\": " + to_string(_r_high())
          + ", \"R_LOW\": " + to_string(_r_low()) + "},\n"
    j = j + "  \"sweep\": {\n"

    j = j + "    \"flat\":  { \"regime\": \"flat\",  \"steepness\": " + to_string(r_flat["steepness"])
          + ", \"n\": " + to_string(r_flat["n"])
          + ", \"r\": " + to_string(r_flat["r"])
          + ", \"n_regions\": " + to_string(r_flat["n_regions"])
          + ", \"state_min\": " + to_string(r_flat["state_min"])
          + ", \"state_max\": " + to_string(r_flat["state_max"])
          + ", \"states\": " + _float_arr_json(r_flat["states"]) + " },\n"

    j = j + "    \"mid\":   { \"regime\": \"mid\",   \"steepness\": " + to_string(r_mid["steepness"])
          + ", \"n\": " + to_string(r_mid["n"])
          + ", \"r\": " + to_string(r_mid["r"])
          + ", \"n_regions\": " + to_string(r_mid["n_regions"])
          + ", \"state_min\": " + to_string(r_mid["state_min"])
          + ", \"state_max\": " + to_string(r_mid["state_max"])
          + ", \"states\": " + _float_arr_json(r_mid["states"]) + " },\n"

    j = j + "    \"steep\": { \"regime\": \"steep\", \"steepness\": " + to_string(r_steep["steepness"])
          + ", \"n\": " + to_string(r_steep["n"])
          + ", \"r\": " + to_string(r_steep["r"])
          + ", \"n_regions\": " + to_string(r_steep["n_regions"])
          + ", \"state_min\": " + to_string(r_steep["state_min"])
          + ", \"state_max\": " + to_string(r_steep["state_max"])
          + ", \"states\": " + _float_arr_json(r_steep["states"]) + " },\n"

    j = j + "    \"steep_small\": { \"regime\": \"steep_small\", \"steepness\": " + to_string(r_steep_small["steepness"])
          + ", \"n\": " + to_string(r_steep_small["n"])
          + ", \"r\": " + to_string(r_steep_small["r"])
          + ", \"n_regions\": " + to_string(r_steep_small["n_regions"])
          + ", \"state_min\": " + to_string(r_steep_small["state_min"])
          + ", \"state_max\": " + to_string(r_steep_small["state_max"])
          + ", \"states\": " + _float_arr_json(r_steep_small["states"]) + " }\n"

    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"r_abs_steep\": " + to_string(r_steep_abs) + ",\n"
    j = j + "    \"r_abs_flat\":  " + to_string(r_flat_abs) + ",\n"
    j = j + "    \"r_abs_mid\":   " + to_string(_abs(r_mid["r"])) + ",\n"
    j = j + "    \"axis_gap\":    " + to_string(r_steep_abs - r_flat_abs) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_axis_formation\":    " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_gradient_dependence\": " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_differentiation\":   " + _bool_str(c3) + ",\n"
    j = j + "    \"C4_determinism\":       " + _bool_str(c4) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_AXIS_FORMATION\":   { \"metric\": \"|r| steep >= R_HIGH\", \"value\": " + to_string(r_steep_abs) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_GRADIENT_DEPEND\":  { \"metric\": \"|r| flat <= R_LOW\", \"value\": " + to_string(r_flat_abs) + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_DIFFERENTIATION\":  { \"metric\": \"steep n_regions >= 2\", \"value\": " + to_string(r_steep["n_regions"]) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_DETERMINISM\":      { \"metric\": \"re-run byte-equal\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_MONOTONE_DRIVE\":   { \"metric\": \"|r| steep >= |r| flat\", \"value\": " + to_string(r_steep_abs - r_flat_abs) + ", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_220\": \"infant-mirror sister (developmental axis)\", \"H_201\": \"asymmetric-division sister\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h261()
