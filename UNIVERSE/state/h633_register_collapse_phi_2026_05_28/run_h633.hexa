// UNIVERSE/state/h633_register_collapse_phi_2026_05_28/run_h633.hexa
// H_633 — register-collapse-phi-drop (ANIMA.mining L2 promote · raw#12).
//
//   Question: when the substrate's coherence (state-agreement / order
//   parameter) drops below 0.10, does big-Φ collapse (a Ψ-clamp cliff)?
//   ANIMA.mining L2 lifts COFFESHOP `register-hit = emit ∧ coh < 0.10`
//   (Ψ-clamp severe collapse) into a substrate-level claim: register
//   collapse co-moves with Φ-breakdown.
//
//   Hypothesis: coh × Φ correlate r > 0.5 AND in the coh < 0.10 region
//   Φ ≈ 0 (cliff). Falsifier: r < 0.3 (no correlation) OR Φ sustained
//   under coh < 0.10 (register collapse decoupled from Φ structure).
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - Substrate = N=16 Kuramoto coupled oscillators (H_207 sister
//       substrate). Coherence = Kuramoto order parameter
//       r = |Σ exp(iθ_j)| / N  ∈ [0, 1]  (canonical state-agreement /
//       order parameter; r→0 = incoherent register collapse, r→1 =
//       full lock).
//     - Φ = c_measure_phi(traj, N, dim, n_bins) → RFC 036 phi_spatial
//       (byte-equal phi_rs native replica), imported READ-ONLY from
//       HEXAD/C/c_lib.hexa.
//     - To span the coherence axis broadly (esp. the coh < 0.10 region)
//       we sweep coupling K over a fine grid AND vary the natural-freq
//       spread (ω_std seeds) + init-phase offset (seeds) so the (coh, Φ)
//       ensemble has wide coverage of low / mid / high coherence.
//     - Collect (coh, Φ) pairs across the ensemble, then:
//         * Pearson r(coh, Φ) over all pairs.
//         * mean Φ in the coh < 0.10 region vs mean Φ in coh ≥ 0.10.
//         * Φ at the lowest-coh pair vs Φ at the highest-coh pair.
//
//   Contrast with H_287 (Shannon entropy ⊥ Φ): coherence is an ORDER
//   parameter (1 − disorder), NOT entropy. A coherence–Φ coupling does
//   not contradict Shannon⊥Φ — distinct measure.
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → phi_spatial, RFC 036 byte-equal phi_rs replica).
// ════════════════════════════════════════════════════════════════════════
import "/tmp/u-h633/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────
fn _N() -> int      { return 16 }      // # oscillators
fn _STEPS() -> int  { return 100 }     // Euler integration steps
fn _WARM() -> int   { return 60 }      // warmup before recording trajectory
fn _DIM() -> int    { return 12 }      // recorded trajectory length / osc
fn _NBINS() -> int  { return 4 }       // bin count per cos θ axis (RFC 036)
fn _state_dir() -> string {
    return "/tmp/u-h633/UNIVERSE/state/h633_register_collapse_phi_2026_05_28"
}

fn _dt() -> float    { return 0.05 }
fn _two_pi() -> float { return 6.283185307179586 }

// coherence-collapse threshold (COFFESHOP register-hit gate).
fn _COH_LO() -> float { return 0.10 }

fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// 5 deterministic z-quantiles of N(0,1) (cycled to N by i%5), scaled by
// per-seed ω_std and shifted by per-seed phase offset — gives wide coh span.
fn _omega_i(i: int, omega_std: float) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    return z * omega_std
}

// deterministic initial phase: uniform spread on [0, 2π) by index, plus a
// per-seed phase offset (decorrelates ensemble members).
fn _theta0(i: int, n: int, phase_off: float) -> float {
    return _two_pi() * (i * 1.0) / (n * 1.0) + phase_off
}

// run Kuramoto for (K, omega_std, phase_off); record per-osc trajectory of
// `dim` cos θ_i snapshots after `warm` steps. final θ copied into theta_out.
fn _run_kuramoto_traj(K: float, omega_std: float, phase_off: float, theta_out: int) -> int {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let steps = _STEPS()
    let dt = _dt()

    let theta = farr_zeros(n)
    let mut i = 0
    while i < n { farr_set(theta, i, _theta0(i, n, phase_off)); i = i + 1 }

    let states = farr_zeros(n * dim)

    let mut s = 0
    while s < steps {
        if s >= warm {
            let t = s - warm
            if t < dim {
                let mut k = 0
                while k < n {
                    farr_set(states, k * dim + t, cos(farr_get(theta, k)))
                    k = k + 1
                }
            }
        }
        let next = farr_zeros(n)
        let mut a = 0
        while a < n {
            let theta_a = farr_get(theta, a)
            let mut coupling_sum = 0.0
            let mut b = 0
            while b < n {
                let theta_b = farr_get(theta, b)
                coupling_sum = coupling_sum + sin(theta_b - theta_a)
                b = b + 1
            }
            let omega_a = _omega_i(a, omega_std)
            let dtheta = omega_a + (K / (n * 1.0)) * coupling_sum
            farr_set(next, a, theta_a + dt * dtheta)
            a = a + 1
        }
        let mut k = 0
        while k < n { farr_set(theta, k, farr_get(next, k)); k = k + 1 }
        farr_free(next)
        s = s + 1
    }
    let mut m = 0
    while m < n { farr_set(theta_out, m, farr_get(theta, m)); m = m + 1 }
    farr_free(theta)
    return states
}

// coherence = Kuramoto order parameter r = |Σ exp(iθ_j)| / N  ∈ [0,1].
fn _order_param(theta: int) -> float {
    let n = _N()
    let mut C = 0.0
    let mut S = 0.0
    let mut i = 0
    while i < n {
        let t = farr_get(theta, i)
        C = C + cos(t)
        S = S + sin(t)
        i = i + 1
    }
    return sqrt(C * C + S * S) / (n * 1.0)
}

// per ensemble member → (coh, Φ).
fn _measure_coh_phi(K: float, omega_std: float, phase_off: float) -> int {
    let n = _N()
    let dim = _DIM()
    let theta_final = farr_zeros(n)
    let traj = _run_kuramoto_traj(K, omega_std, phase_off, theta_final)
    let coh = _order_param(theta_final)
    let phi = c_measure_phi(traj, n, dim, _NBINS())
    farr_free(traj)
    farr_free(theta_final)
    let out = farr_zeros(2)
    farr_set(out, 0, coh)
    farr_set(out, 1, phi)
    return out
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict_pf(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

// ── ensemble sweep ──────────────────────────────────────────────────────
//   K grid: fine on the incoherent → critical region (where coh<0.10 lives)
//   ω_std seeds: large spread = more frustration = lower coherence
//   phase offsets: decorrelate
fn main() {
    println("H_633 — register-collapse-phi-drop (ANIMA.mining L2 · raw#12)")
    println("  substrate: N=16 Kuramoto · coh = order param r = |Σ exp(iθ)|/N")
    println("  Φ: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (byte-equal phi_rs replica)")
    println("  coh-collapse threshold (COFFESHOP register-hit): coh < 0.10")
    println("")

    // K grid — dense near 0 (incoherent / low-coh), out to full lock.
    let n_k = 11
    let k_grid = farr_zeros(n_k)
    farr_set(k_grid, 0, 0.0)
    farr_set(k_grid, 1, 0.25)
    farr_set(k_grid, 2, 0.5)
    farr_set(k_grid, 3, 0.75)
    farr_set(k_grid, 4, 1.0)
    farr_set(k_grid, 5, 1.25)
    farr_set(k_grid, 6, 1.5)
    farr_set(k_grid, 7, 2.0)
    farr_set(k_grid, 8, 3.0)
    farr_set(k_grid, 9, 4.0)
    farr_set(k_grid, 10, 6.0)

    // ω_std seeds — wider spread frustrates sync → broadens the low-coh tail.
    let n_w = 3
    let w_grid = farr_zeros(n_w)
    farr_set(w_grid, 0, 0.5)
    farr_set(w_grid, 1, 1.0)
    farr_set(w_grid, 2, 2.0)

    // phase-offset seeds — deterministic decorrelation of ensemble members.
    let n_p = 3
    let p_grid = farr_zeros(n_p)
    farr_set(p_grid, 0, 0.0)
    farr_set(p_grid, 1, 0.7)
    farr_set(p_grid, 2, 1.9)

    let n_total = n_k * n_w * n_p     // 11 × 3 × 3 = 99 ensemble members
    let coh_arr = farr_zeros(n_total)
    let phi_arr = farr_zeros(n_total)

    println("  ensemble (coh, Φ) pairs (n=99):")
    let mut idx = 0
    let mut ik = 0
    while ik < n_k {
        let K = farr_get(k_grid, ik)
        let mut iw = 0
        while iw < n_w {
            let ws = farr_get(w_grid, iw)
            let mut ip = 0
            while ip < n_p {
                let po = farr_get(p_grid, ip)
                let cp = _measure_coh_phi(K, ws, po)
                let coh = farr_get(cp, 0)
                let phi = farr_get(cp, 1)
                farr_free(cp)
                farr_set(coh_arr, idx, coh)
                farr_set(phi_arr, idx, phi)
                idx = idx + 1
                ip = ip + 1
            }
            iw = iw + 1
        }
        ik = ik + 1
    }

    // ── Pearson r(coh, Φ) ───────────────────────────────────────────────
    let mut sum_c = 0.0
    let mut sum_p = 0.0
    let mut i = 0
    while i < n_total {
        sum_c = sum_c + farr_get(coh_arr, i)
        sum_p = sum_p + farr_get(phi_arr, i)
        i = i + 1
    }
    let mean_c = sum_c / (n_total * 1.0)
    let mean_p = sum_p / (n_total * 1.0)

    let mut s_cc = 0.0
    let mut s_pp = 0.0
    let mut s_cp = 0.0
    let mut j = 0
    while j < n_total {
        let dc = farr_get(coh_arr, j) - mean_c
        let dp = farr_get(phi_arr, j) - mean_p
        s_cc = s_cc + dc * dc
        s_pp = s_pp + dp * dp
        s_cp = s_cp + dc * dp
        j = j + 1
    }
    let denom = sqrt(s_cc * s_pp)
    let mut pearson = 0.0
    if denom > 0.0 { pearson = s_cp / denom }

    // ── coh < 0.10 region behaviour ─────────────────────────────────────
    let mut n_lo = 0
    let mut sum_phi_lo = 0.0
    let mut max_phi_lo = 0.0
    let mut n_hi = 0
    let mut sum_phi_hi = 0.0
    // track global min / max coherence members
    let mut min_coh = 2.0
    let mut phi_at_min_coh = 0.0
    let mut max_coh = 0.0 - 1.0
    let mut phi_at_max_coh = 0.0
    let mut g = 0
    while g < n_total {
        let coh = farr_get(coh_arr, g)
        let phi = farr_get(phi_arr, g)
        if coh < _COH_LO() {
            n_lo = n_lo + 1
            sum_phi_lo = sum_phi_lo + phi
            if phi > max_phi_lo { max_phi_lo = phi }
        }
        if coh >= _COH_LO() {
            n_hi = n_hi + 1
            sum_phi_hi = sum_phi_hi + phi
        }
        if coh < min_coh { min_coh = coh; phi_at_min_coh = phi }
        if coh > max_coh { max_coh = coh; phi_at_max_coh = phi }
        g = g + 1
    }
    let mut mean_phi_lo = 0.0
    if n_lo > 0 { mean_phi_lo = sum_phi_lo / (n_lo * 1.0) }
    let mut mean_phi_hi = 0.0
    if n_hi > 0 { mean_phi_hi = sum_phi_hi / (n_hi * 1.0) }

    // overall Φ envelope (for context — is mean_phi_lo ≈ 0 vs envelope?)
    let mut min_phi_all = 1.0e18
    let mut max_phi_all = 0.0 - 1.0e18
    let mut q = 0
    while q < n_total {
        let phi = farr_get(phi_arr, q)
        if phi < min_phi_all { min_phi_all = phi }
        if phi > max_phi_all { max_phi_all = phi }
        q = q + 1
    }

    // ── print ensemble (coh, Φ) sorted-ish by printing in sweep order ───
    let mut pr = 0
    while pr < n_total {
        let coh = farr_get(coh_arr, pr)
        let phi = farr_get(phi_arr, pr)
        let mark = "       "
        if coh < _COH_LO() { mark = " [LO] " }
        println("    [" + str(pr) + "] coh=" + str(coh) + "  Φ=" + str(phi) + mark)
        pr = pr + 1
    }
    println("")

    // ── criteria ────────────────────────────────────────────────────────
    // C1 (correlation): Pearson |r| > 0.5 (hypothesis: positive coupling).
    // C2 (cliff): mean Φ in coh<0.10 region ≈ 0 — operationalised as
    //     mean_phi_lo < 0.20 × mean_phi_hi (Φ in low-coh is < 20% of
    //     the high-coh mean — a steep drop / near-collapse).
    // Falsifier F-NOCORR: |r| < 0.3.
    // Falsifier F-SUSTAIN: mean_phi_lo ≥ mean_phi_hi (Φ NOT dropping under
    //     low coherence — decoupled).
    let c1 = (_abs_f(pearson) > 0.5)
    let mut ratio_lo_hi = 1.0
    if mean_phi_hi > 0.0 { ratio_lo_hi = mean_phi_lo / mean_phi_hi }
    let c2 = (n_lo > 0) && (ratio_lo_hi < 0.20)

    let f_nocorr = (_abs_f(pearson) < 0.3)
    let f_sustain = (n_lo > 0) && (mean_phi_lo >= mean_phi_hi)
    // edge: if NO coh<0.10 members at all → cliff-claim untestable on this
    // substrate (report separately, treat as PARTIAL not SUPPORTED).
    let no_lo_members = (n_lo == 0)

    println("  n total pairs        : " + str(n_total))
    println("  n coh<0.10 (LO)      : " + str(n_lo))
    println("  n coh>=0.10 (HI)     : " + str(n_hi))
    println("  mean coh             : " + str(mean_c))
    println("  mean Φ               : " + str(mean_p))
    println("  Φ envelope [min,max] : [" + str(min_phi_all) + ", " + str(max_phi_all) + "]")
    println("  ----")
    println("  Pearson r(coh, Φ)    : " + str(pearson))
    println("  mean Φ | coh<0.10    : " + str(mean_phi_lo))
    println("  max  Φ | coh<0.10    : " + str(max_phi_lo))
    println("  mean Φ | coh>=0.10   : " + str(mean_phi_hi))
    println("  ratio (lo / hi mean) : " + str(ratio_lo_hi))
    println("  min-coh member       : coh=" + str(min_coh) + "  Φ=" + str(phi_at_min_coh))
    println("  max-coh member       : coh=" + str(max_coh) + "  Φ=" + str(phi_at_max_coh))
    println("  ----")
    println("  C1 |r| > 0.5            : " + _verdict_pf(c1) + "  (r=" + str(pearson) + ")")
    println("  C2 cliff (lo/hi < 0.20) : " + _verdict_pf(c2) + "  (ratio=" + str(ratio_lo_hi) + ")")
    println("  F-NOCORR |r| < 0.3      : " + _bool_str(f_nocorr))
    println("  F-SUSTAIN Φlo >= Φhi    : " + _bool_str(f_sustain))
    println("  (no coh<0.10 members?)  : " + _bool_str(no_lo_members))
    println("")

    // ── verdict ──────────────────────────────────────────────────────────
    // SUPPORTED iff C1 ∧ C2 (correlation AND cliff).
    // FALSIFIED  iff F-NOCORR ∨ F-SUSTAIN (no correlation, or Φ sustained
    //   under low coherence — register collapse decoupled from Φ).
    // else PARTIAL.
    let supported = c1 && c2 && (no_lo_members == false)
    let falsified = f_nocorr || f_sustain
    let mut verdict = "PARTIAL"
    if supported { verdict = "SUPPORTED-NUMERICAL" }
    if falsified { verdict = "FALSIFIED" }
    // if both fire (shouldn't), falsifier dominates.
    if falsified { verdict = "FALSIFIED" }

    println("  VERDICT_RULE: SUPPORTED iff (|r|>0.5 ∧ lo/hi<0.20); FALSIFIED iff (|r|<0.3 ∨ Φlo>=Φhi)")
    println("  VERDICT     : " + verdict)
    println("=== H_633 register-collapse-phi-drop complete: " + verdict + " ===")

    farr_free(k_grid)
    farr_free(w_grid)
    farr_free(p_grid)
    farr_free(coh_arr)
    farr_free(phi_arr)
}
