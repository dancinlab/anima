// ════════════════════════════════════════════════════════════════════════════
// H_664 — wolfram-class-III-heterogeneity  (H_661 발견 정밀화, axis G)
//   PER-RULE SHARD — measures one ECA rule's collective-Φ W-grid + scale metrics.
//
//   H_661 (PR #1295/#1297, 🟡 4/6) 가 class-III 내부 이질성 발견 — rule90(additive
//   XOR)·rule30(pure-chaotic)·rule45(W-비단조)가 같은 class-III 인데 norm_conv 가
//   2.24·2.27·1.46 로 크게 분산. 본 shard 는 class-III 다수(30·45·90·106·150) +
//   class-II/IV anchor(184·226·110·54) 각 rule 의 Φ-grid·metric 을 per-rule 측정 →
//   phi-free aggregate 가 within-class-III variance vs between-class variance 검정.
//
//   ⚠ per-rule shard (monitor-hang 회피) — rule 하나씩 (6 call ≈ 11s) foreground sync.
//   engine = H_635/H_653/H_655/H_660/H_661 SSOT verbatim (build_tpm_cohort, rule만 swap).
//   deterministic · hexa-only · $0 mac-local · sys_state=0 · cap=3 · foreground sync.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

// ── n=5 coupled-ring TPM with sync_factor W (verbatim from H_660/H_661) ──
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

fn main() {
    // ⚠ RULE_ID 한 줄만 바꿔 N회 실행 (shard).
    let RULE_ID = 150
    let CLASS_LABEL = "III-XOR-additive"

    let WGRID = [0.15, 0.40, 0.55, 0.70, 0.95, 1.0]   // H_653/H_660/H_661 동일 6-pt
    let NW = 6
    let FLOOR = 0.0001
    let cohort = [RULE_ID, RULE_ID, RULE_ID, RULE_ID, RULE_ID]

    let mut phi_w = []
    let mut sum = 0.0
    let mut wi = 0
    while wi < NW {
        let phi = phi_collective(cohort, WGRID[wi])
        phi_w = phi_w + [phi]
        sum = sum + phi
        wi = wi + 1
    }
    let mut pmin = phi_w[0]
    let mut pmax = phi_w[0]
    wi = 0
    while wi < NW {
        if phi_w[wi] < pmin { pmin = phi_w[wi] }
        if phi_w[wi] > pmax { pmax = phi_w[wi] }
        wi = wi + 1
    }
    let pmean = sum / to_float(NW)
    let denom = pmin + FLOOR
    let span_ratio = pmax / denom
    let abs_delta  = pmax - pmin
    let norm_conv  = (pmax - pmin) / pmean
    let log_span   = ln(span_ratio)

    println("RULE=" + str(RULE_ID) + " CLASS=" + CLASS_LABEL)
    let mut line = "PHI_W="
    wi = 0
    while wi < NW { line = line + to_string(phi_w[wi]) + " "; wi = wi + 1 }
    println(line)
    println("PMIN=" + to_string(pmin) + " PMAX=" + to_string(pmax) + " PMEAN=" + to_string(pmean))
    println("SPAN_RATIO=" + to_string(span_ratio))
    println("ABS_DELTA=" + to_string(abs_delta))
    println("NORM_CONV=" + to_string(norm_conv))
    println("LOG_SPAN=" + to_string(log_span))
}
