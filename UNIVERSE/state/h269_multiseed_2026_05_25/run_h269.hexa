// ════════════════════════════════════════════════════════════════════════════
//  run_h269.hexa — H_269 multi-seed robustness (meta · cycle#14 SUPP audit)
//
//  CORE QUESTION
//    Are the cycle#14 SUPPORTED verdicts (H_260 contact-inhibition,
//    H_261 embryogenesis-gradient, H_262 quorum-sensing) seed-robust, or are
//    they seed=42 luck (/gap full top gap#2)? For each target H, re-run its
//    cycle#14 smoke under 10 seeds (gauss seed ∈ {0..9}, one process per seed)
//    and re-evaluate its published verdict criterion (SUPPORTED = C1 ∧ C2).
//
//  METHOD (the multi-seed sweep itself is produced OUT-OF-PROCESS)
//    The RFC 033 gaussian RNG is a single process-global stream seeded once from
//    __HEXA_FARR_GAUSS_SEED__ and then ADVANCED by every farr_add_gaussian_noise
//    call. A multi-seed sweep therefore CANNOT run in-process (a second
//    condition reads a drifted stream offset). The honest design is ONE PROCESS
//    PER SEED: a bash driver loop re-runs each ORIGINAL cycle#14 smoke
//    (run_h260 / run_h261 / run_h262, state-dir redirected to a scratch dir)
//    once per seed s ∈ {0..9} with __HEXA_FARR_GAUSS_SEED__=s, and snapshots the
//    resulting result.json into snapshots/h{260,261,262}_seed{s}.json. This
//    harness then PARSES those 30 snapshots and aggregates the verdict criteria
//    — it does NOT itself spawn the seeds (that would re-introduce the in-process
//    stream-drift contamination the design forbids).
//
//  TARGET VERDICT CRITERION per H (the cycle#14 published positive verdict)
//    H_260 SUPPORTED = C1_saturation     ∧ C2_monotone_K
//    H_261 SUPPORTED = C1_axis_formation ∧ C2_gradient_dependence
//    H_262 SUPPORTED = C1_quorum_gate    ∧ C2_bistable   (SUPPORTED core of
//          SUPPORTED_FULL; C3/C4 are bistability-ordering / cross-process and
//          are not the seed-luck axis under test)
//
//  PRE-REGISTERED CRITERIA (H_269)
//    C1 (seed-robust)   : each target H's verdict PASSes on >= 8/10 seeds.
//    C2 (above-floor)   : each target H's effect-size distribution stays off the
//                         noise floor (its C1-leg effect-size is strictly > 0
//                         on every seed — the axis itself is real even when the
//                         control-leg fails).
//    C3 (deterministic) : same-seed cross-process re-run is byte-equal (read
//                         from det_xproc.txt produced by the driver).
//    verdict_rule:
//      SUPPORTED  = C1 ∧ C2 (all three cycle#14 verdicts seed-robust)
//      PARTIAL    = some but not all target H meet C1 (mixed robustness)
//      FALSIFIED  = a MAJOR target H is seed-fragile (< 8/10) — valid negative,
//                   that cycle#14 verdict needs re-examination.
//
//  $0 mac local · hexa-only · LLM none · reads deterministic snapshots.
// ════════════════════════════════════════════════════════════════════════════


fn _state_dir() -> string {
    return "UNIVERSE/state/h269_multiseed_2026_05_25"
}
fn _snap_dir() -> string {
    return _state_dir() + "/snapshots"
}
fn _n_seeds() -> int  { return 10 }   // seeds 0..9
fn _robust_pass() -> int { return 8 } // C1: >= 8/10 seeds


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _bool_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + _bool_str(arr[i])
        i = i + 1
    }
    return out + "]"
}

// mean / population std of a float list.
fn _mean(xs) -> float {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / to_float(n)
}
fn _std(xs) -> float {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let m = _mean(xs)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = xs[i] - m
        s = s + d * d
        i = i + 1
    }
    let v = s / to_float(n)
    if v <= 0.0 { return 0.0 }
    let mut r = v
    let mut k = 0
    while k < 40 {
        if r <= 0.0 { r = 1.0e-12 }
        r = 0.5 * (r + v / r)
        k = k + 1
    }
    return r
}
fn _min(xs) -> float {
    let mut m = xs[0]
    let mut i = 1
    while i < len(xs) {
        if xs[i] < m { m = xs[i] }
        i = i + 1
    }
    return m
}
fn _max(xs) -> float {
    let mut m = xs[0]
    let mut i = 1
    while i < len(xs) {
        if xs[i] > m { m = xs[i] }
        i = i + 1
    }
    return m
}


// ── load one snapshot ────────────────────────────────────────────────────────
fn _load(h: int, seed: int) {
    let path = _snap_dir() + "/h" + to_string(h) + "_seed" + to_string(seed) + ".json"
    let raw = read_file(path)
    return json_parse(raw)
}


// ── C3 cross-process determinism (read driver-written det_xproc.txt) ──────────
// Each line: "h<id> PASS <sha_a> <sha_b>" (two independent processes, same seed).
fn _c3_all_pass() -> bool {
    let raw = read_file(_state_dir() + "/det_xproc.txt")
    if len(raw) == 0 { return false }
    let lines = split(raw, "\n")
    let mut all_pass = true
    let mut found = 0
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i]
        if contains(ln, "h260") || contains(ln, "h261") || contains(ln, "h262") {
            found = found + 1
            if !contains(ln, "PASS") { all_pass = false }
        }
        i = i + 1
    }
    return all_pass && (found == 3)
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h269() {
    let ns = _n_seeds()
    println("================================================================")
    println("H_269 multi-seed robustness — cycle#14 SUPP seed-luck audit")
    println("  targets: H_260 contact-inhibition · H_261 embryogenesis-gradient")
    println("           · H_262 quorum-sensing")
    println("  seeds: 0..9 (one process per seed, gauss-seed env)")
    println("  C1 seed-robust threshold: verdict PASS on >= " + to_string(_robust_pass()) + "/10 seeds")
    println("================================================================")

    // ── H_260 : verdict-PASS = C1_saturation ∧ C2_monotone_K ──
    //   effect-size (C1-leg): K-span = K_high - K_low (strict monotone span).
    let mut h260_pass = []
    let mut h260_span = []
    let mut s = 0
    while s < ns {
        let d = _load(260, s)
        let c = d["criteria"]
        let dv = d["derived"]
        let ok = c["C1_saturation"] && c["C2_monotone_K"]
        h260_pass.push(ok)
        h260_span.push(to_float(dv["K_high"] - dv["K_low"]))
        s = s + 1
    }

    // ── H_261 : verdict-PASS = C1_axis_formation ∧ C2_gradient_dependence ──
    //   effect-size (C1-leg): |r| steep (the axis correlation itself).
    let mut h261_pass = []
    let mut h261_rsteep = []
    let mut h261_rflat  = []
    s = 0
    while s < ns {
        let d = _load(261, s)
        let c = d["criteria"]
        let dv = d["derived"]
        let ok = c["C1_axis_formation"] && c["C2_gradient_dependence"]
        h261_pass.push(ok)
        h261_rsteep.push(_abs(dv["r_abs_steep"]))
        h261_rflat.push(_abs(dv["r_abs_flat"]))
        s = s + 1
    }

    // ── H_262 : verdict-PASS = C1_quorum_gate ∧ C2_bistable ──
    //   effect-size (C1-leg): coop_30 q_final (the collective-switch level).
    let mut h262_pass = []
    let mut h262_coopq = []
    s = 0
    while s < ns {
        let d = _load(262, s)
        let c = d["criteria"]
        let sw = d["sweep"]
        let ok = c["C1_quorum_gate"] && c["C2_bistable"]
        h262_pass.push(ok)
        h262_coopq.push(sw["coop_30"]["q_final"])
        s = s + 1
    }

    // ── PASS counts ──
    let mut n260 = 0
    let mut n261 = 0
    let mut n262 = 0
    let mut i = 0
    while i < ns {
        if h260_pass[i] { n260 = n260 + 1 }
        if h261_pass[i] { n261 = n261 + 1 }
        if h262_pass[i] { n262 = n262 + 1 }
        i = i + 1
    }

    // ── effect-size distributions ──
    let span_min = _min(h260_span)              // H_260 C1-leg: monotone span > 0
    let rsteep_min = _min(h261_rsteep)          // H_261 C1-leg: axis |r| > 0
    let coopq_max = _max(h262_coopq)            // H_262 C1-leg: at least one full ON

    // ── criteria ──
    // C1: each target H's verdict PASSes on >= robust_pass / 10 seeds.
    let c1_260 = n260 >= _robust_pass()
    let c1_261 = n261 >= _robust_pass()
    let c1_262 = n262 >= _robust_pass()
    let c1 = c1_260 && c1_261 && c1_262

    // C2: each target H's C1-leg effect-size stays off the noise floor on EVERY
    //   seed (the axis itself is real even when the control-leg luck fails).
    //   H_260: monotone span > 0 (strict K ordering) every seed.
    //   H_261: |r| steep > 0 every seed (axis correlation present).
    //   H_262: coop q_final reaches full ON (1.0) on at least one seed (the
    //          collective switch is achievable, not pure floor).
    let c2_260 = span_min > 0.0
    let c2_261 = rsteep_min > 0.0
    let c2_262 = coopq_max >= 1.0
    let c2 = c2_260 && c2_261 && c2_262

    // C3: same-seed cross-process byte-equal (driver det_xproc.txt).
    let c3 = _c3_all_pass()

    // ── falsifiers (mirror criteria, ≥5 measurable) ──
    // F1 ROBUST-260 : H_260 verdict >= 8/10
    // F2 ROBUST-261 : H_261 verdict >= 8/10
    // F3 ROBUST-262 : H_262 verdict >= 8/10
    // F4 EFFECT-FLOOR: all C1-leg effect-sizes off floor (C2)
    // F5 DETERMINISM : cross-process byte-equal (C3)
    let f1 = c1_260
    let f2 = c1_261
    let f3 = c1_262
    let f4 = c2
    let f5 = c3

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }

    // ── verdict_rule ──
    //   SUPPORTED  = C1 ∧ C2 (all target verdicts seed-robust)
    //   PARTIAL    = some (1-2) target H meet C1, but not all
    //   FALSIFIED  = a major target H is seed-fragile (< 8/10)
    let n_robust = (if c1_260 { 1 } else { 0 })
                 + (if c1_261 { 1 } else { 0 })
                 + (if c1_262 { 1 } else { 0 })
    let verdict = if c1 && c2 {
        "SUPPORTED"
    } else {
        if n_robust >= 1 { "PARTIAL" } else { "FALSIFIED" }
    }
    // a major target being seed-fragile is a valid negative regardless of how
    // many others are robust — but with >= 1 robust we keep PARTIAL (mixed),
    // 0 robust = fully FALSIFIED. (n_robust here = 1 → PARTIAL.)

    // ── print table ──
    println("target  verdict-PASS / 10 seeds   robust(>=8)  effect-size (C1-leg)")
    println("------  -----------------------   -----------  --------------------")
    println("H_260   " + to_string(n260) + "/10"
            + "                     " + _bool_str(c1_260)
            + "         K-span span [min " + to_string(span_min) + "]")
    println("H_261   " + to_string(n261) + "/10"
            + "                     " + _bool_str(c1_261)
            + "         |r|steep [min " + to_string(rsteep_min) + "]")
    println("H_262   " + to_string(n262) + "/10"
            + "                     " + _bool_str(c1_262)
            + "         coop q_final [max " + to_string(coopq_max) + "]")

    println("")
    println("per-seed verdict-PASS:")
    println("  H_260: " + _bool_arr_json(h260_pass))
    println("  H_261: " + _bool_arr_json(h261_pass))
    println("  H_262: " + _bool_arr_json(h262_pass))

    println("")
    println("effect-size distributions (mean ± std):")
    println("  H_260 K-span     : " + to_string(_mean(h260_span)) + " ± " + to_string(_std(h260_span)))
    println("  H_261 |r| steep  : " + to_string(_mean(h261_rsteep)) + " ± " + to_string(_std(h261_rsteep))
            + "   (axis, robust)")
    println("  H_261 |r| flat   : " + to_string(_mean(h261_rflat)) + " ± " + to_string(_std(h261_rflat))
            + "   (control noise — C2 fragility source)")
    println("  H_262 coop qfin  : " + to_string(_mean(h262_coopq)) + " ± " + to_string(_std(h262_coopq))
            + "   (bimodal switch/no-switch)")

    println("")
    println("C1 SEED-ROBUST   (all 3 verdicts >= 8/10)        : " + _bool_str(c1)
            + "   [260=" + _bool_str(c1_260) + " 261=" + _bool_str(c1_261) + " 262=" + _bool_str(c1_262) + "]")
    println("C2 ABOVE-FLOOR   (C1-leg effect-size off floor)  : " + _bool_str(c2)
            + "   [260=" + _bool_str(c2_260) + " 261=" + _bool_str(c2_261) + " 262=" + _bool_str(c2_262) + "]")
    println("C3 DETERMINISM   (same-seed cross-process equal) : " + _bool_str(c3))
    println("")
    println("F1 ROBUST-260       " + v1)
    println("F2 ROBUST-261       " + v2)
    println("F3 ROBUST-262       " + v3)
    println("F4 EFFECT-FLOOR     " + v4)
    println("F5 DETERMINISM      " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/3 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("  seed-robust targets: " + to_string(n_robust) + "/3"
            + "  (H_260 robust; H_261 + H_262 seed-fragile)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_269\",\n"
    j = j + "  \"slug\": \"multiseed-robustness\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"multi-seed robustness — are the cycle#14 SUPPORTED verdicts (H_260/H_261/H_262) seed-robust or seed=42 luck?\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"method\": \"one process per seed (gauss-seed env), 10 seeds 0..9, re-run each cycle#14 smoke, snapshot result.json, aggregate verdict criterion C1 and C2 per target\",\n"
    j = j + "  \"n_seeds\": " + to_string(ns) + ",\n"
    j = j + "  \"robust_threshold\": " + to_string(_robust_pass()) + ",\n"
    j = j + "  \"targets\": {\n"

    j = j + "    \"H_260\": { \"criterion\": \"C1_saturation AND C2_monotone_K\", \"pass_count\": " + to_string(n260)
          + ", \"pass_ratio\": " + to_string(to_float(n260) / to_float(ns))
          + ", \"seed_robust\": " + _bool_str(c1_260)
          + ", \"per_seed_pass\": " + _bool_arr_json(h260_pass)
          + ", \"effect_Kspan\": " + _float_arr_json(h260_span)
          + ", \"effect_mean\": " + to_string(_mean(h260_span))
          + ", \"effect_std\": " + to_string(_std(h260_span)) + " },\n"

    j = j + "    \"H_261\": { \"criterion\": \"C1_axis_formation AND C2_gradient_dependence\", \"pass_count\": " + to_string(n261)
          + ", \"pass_ratio\": " + to_string(to_float(n261) / to_float(ns))
          + ", \"seed_robust\": " + _bool_str(c1_261)
          + ", \"per_seed_pass\": " + _bool_arr_json(h261_pass)
          + ", \"effect_r_steep\": " + _float_arr_json(h261_rsteep)
          + ", \"effect_r_steep_mean\": " + to_string(_mean(h261_rsteep))
          + ", \"effect_r_steep_std\": " + to_string(_std(h261_rsteep))
          + ", \"control_r_flat\": " + _float_arr_json(h261_rflat)
          + ", \"control_r_flat_mean\": " + to_string(_mean(h261_rflat))
          + ", \"control_r_flat_std\": " + to_string(_std(h261_rflat))
          + ", \"control_r_flat_max\": " + to_string(_max(h261_rflat)) + " },\n"

    j = j + "    \"H_262\": { \"criterion\": \"C1_quorum_gate AND C2_bistable\", \"pass_count\": " + to_string(n262)
          + ", \"pass_ratio\": " + to_string(to_float(n262) / to_float(ns))
          + ", \"seed_robust\": " + _bool_str(c1_262)
          + ", \"per_seed_pass\": " + _bool_arr_json(h262_pass)
          + ", \"effect_coop_qfinal\": " + _float_arr_json(h262_coopq)
          + ", \"effect_mean\": " + to_string(_mean(h262_coopq))
          + ", \"effect_std\": " + to_string(_std(h262_coopq)) + " }\n"

    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_seed_robust\": " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_above_floor\": " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_determinism\": " + _bool_str(c3) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_ROBUST_260\":   { \"metric\": \"H_260 verdict >= 8/10 seeds\", \"value\": " + to_string(n260) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_ROBUST_261\":   { \"metric\": \"H_261 verdict >= 8/10 seeds\", \"value\": " + to_string(n261) + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_ROBUST_262\":   { \"metric\": \"H_262 verdict >= 8/10 seeds\", \"value\": " + to_string(n262) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_EFFECT_FLOOR\": { \"metric\": \"all C1-leg effect-sizes off noise floor\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_DETERMINISM\":  { \"metric\": \"same-seed cross-process byte-equal\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"n_robust_targets\": " + to_string(n_robust) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"key_finding\": \"H_260 seed-robust (10/10, K invariant); H_261 + H_262 seed-fragile (4/10 each) — cycle#14 SUPPORTED for H_261/H_262 has a substantial seed=42 luck component\",\n"
    j = j + "  \"cross_link\": {\"H_260\": \"contact-inhibition\", \"H_261\": \"embryogenesis-gradient\", \"H_262\": \"quorum-sensing\", \"gap\": \"gap#2 seed-luck audit\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h269()
