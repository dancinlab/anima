// H_332 — EPIGENETICS x inherited rule modification (2-phase ECA, n=4)
// Pure hexa, deterministic. Phase 1: rule A for T1 steps; Phase 2: rule B for T2.
// If A == B: baseline (no epigenetic mark). If A != B: 'mark inheritance' — does
// phase-1 history leave a measurable signature in phase-2 final-state distribution?
//
// H1: across 16 starting states, the final-state distribution after
//   (A=rule110, B=rule30, T1=10, T2=10) DIFFERS from baseline (A=B=rule30, T=20)
//   by ≥ 50% in Manhattan distance (Σ |p1 − p2|), i.e. the phase-1 rule leaves
//   measurable downstream traces beyond simple state inheritance.
// Falsifier: distance < 0.5 → phase-2 rule erases phase-1 signature ⇒ no
//   epigenetic memory at this scale.

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

fn forward(s0: int, rule_a: int, t1: int, rule_b: int, t2: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < t1 { s = next4(s, rule_a); t = t + 1 }
    let mut t2c = 0
    while t2c < t2 { s = next4(s, rule_b); t2c = t2c + 1 }
    return s
}

fn measure_protocol(rule_a: int, rule_b: int, t1: int, t2: int, hist: int) {
    let mut s0 = 0
    while s0 < 16 {
        let final_s = forward(s0, rule_a, t1, rule_b, t2)
        let cur = to_int(farr_get(hist, final_s))
        let _ = farr_set(hist, final_s, to_float(cur + 1))
        s0 = s0 + 1
    }
}

fn manhattan_dist(h1: int, h2: int, n_bins: int, total: float) -> float {
    let mut d = 0.0
    let mut i = 0
    while i < n_bins {
        let p1 = to_float(to_int(farr_get(h1, i))) / total
        let p2 = to_float(to_int(farr_get(h2, i))) / total
        let diff = if p1 > p2 { p1 - p2 } else { p2 - p1 }
        d = d + diff
        i = i + 1
    }
    return d
}

fn show(hist: int, label: string) {
    print(label + " hist=[")
    let mut i = 0
    while i < 16 {
        print(str(to_int(farr_get(hist, i))))
        if i < 15 { print(",") }
        i = i + 1
    }
    println("]")
}

fn main() {
    println("H_332 EPIGENETICS x 2-phase rule (n=4)")
    // baseline_A: rule30 for 20 steps
    let h_base_a = farr_zeros(16)
    measure_protocol(30, 30, 10, 10, h_base_a)
    show(h_base_a, "base_AAR30")
    // baseline_B: rule110 for 20 steps
    let h_base_b = farr_zeros(16)
    measure_protocol(110, 110, 10, 10, h_base_b)
    show(h_base_b, "base_BBR110")
    // hybrid: rule110 first 10, then rule30 last 10
    let h_hybrid_BA = farr_zeros(16)
    measure_protocol(110, 30, 10, 10, h_hybrid_BA)
    show(h_hybrid_BA, "hybrid_BA")
    // reverse hybrid: rule30 first, then rule110
    let h_hybrid_AB = farr_zeros(16)
    measure_protocol(30, 110, 10, 10, h_hybrid_AB)
    show(h_hybrid_AB, "hybrid_AB")
    // Manhattan distances
    let d_hybrid_BA_vs_baseAA = manhattan_dist(h_hybrid_BA, h_base_a, 16, 16.0)
    let d_hybrid_BA_vs_baseBB = manhattan_dist(h_hybrid_BA, h_base_b, 16, 16.0)
    let d_baseA_vs_baseB     = manhattan_dist(h_base_a,    h_base_b, 16, 16.0)
    println("d(hybrid_BA, base_AA-r30)  = " + str(d_hybrid_BA_vs_baseAA))
    println("d(hybrid_BA, base_BB-r110) = " + str(d_hybrid_BA_vs_baseBB))
    println("d(base_AA, base_BB)        = " + str(d_baseA_vs_baseB))
    // H1: hybrid_BA distance from base_AA (same phase-2 rule) > 0.5
    println("H1_threshold=0.5  d_hybrid_vs_phase2-only_base=" + str(d_hybrid_BA_vs_baseAA))
    let pass = if d_hybrid_BA_vs_baseAA >= 0.5 { 1 } else { 0 }
    println("F332.1_DISTANCE_GE_0_5=" + str(pass))
    println("done")
}
