// UNIVERSE/state/h308_circadian_smooth_finite_ratio_2026_05_26/run_h308.hexa
//
//   H_308 — circadian smooth: H_306 perfect ∞× gating의 finite ratio 회수
//
//   QUESTION
//     H_306 piecewise-linear circadian + hard threshold = bistable gate
//     (trough=0, peak/trough=∞). Replace with smooth quadratic bump to
//     recover finite peak/trough ratio matching biology (~5-10× dawn chorus).
//
//   METHOD
//     SAME accumulator as H_306, ONLY circadian_mod() changed.
//     New: quadratic bump centered at tick=500, span=400, baseline 0.3.
//     fn circadian_mod(tick): 0.3 + 0.7 * max(0, 1 - ((tick-500)/400)^2)
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26)
//     F308.1 SMOOTH-FINITE-RATIO: peak/trough emit ratio in [3, 15]
//     F308.2 IDLE-EMIT-PRESERVED: idle emit > 0
//     F308.3 PEAK-COUNT-MID-RANGE: peak emit in [30, 60]
//     F308.4 THRESHOLD-MONOTONE-PRESERVED: 5-threshold sweep monotone
//     F308.5 SMOOTH-VS-PIECEWISE-IDLE-COMPARABLE: |smooth - 46| / 46 <= 0.5
//     F308.6 BOUND
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// smooth circadian: quadratic bump centered at 500, span 400, baseline 0.3
// peak amplitude 0.7 (so total max = 1.0)
fn circadian_mod(tick: int) -> float {
    let center = 500
    let span = 400
    let dx = tick - center
    let r = to_float(dx) / to_float(span)
    let r2 = r * r
    let mut bump = 1.0 - r2
    if bump < 0.0 { bump = 0.0 }
    return 0.3 + 0.7 * bump
}

fn lcg_perturb(seed: int) -> float {
    let v = (seed * 1103515245 + 12345) % 32768
    let f = to_float(v) / 32768.0
    return (f - 0.5) * 0.2
}

// returns [emit_count, peak_count_Q2Q3, trough_count_Q1Q4]
fn simulate(threshold: float, stim_mode: int) -> array {
    let n_ticks = 1000
    let w_target = 1.0
    let k_recharge = 0.3
    let r_steps = 10
    let m_base = 1.0
    let phi_int = 1.0

    let mut w_tension = w_target
    let mut refractory_remaining = 0
    let mut emit_count = 0
    let mut peak_count = 0
    let mut trough_count = 0

    let mut tick = 0
    while tick < n_ticks {
        let circ = circadian_mod(tick)
        let mut m = m_base
        if stim_mode == 1 {
            m = m + lcg_perturb(tick + 42)
        }
        if m < 0.0 { m = 0.0 }

        if refractory_remaining > 0 {
            refractory_remaining = refractory_remaining - 1
            w_tension = w_tension + k_recharge * (w_target - w_tension)
            if w_tension < 0.0 { w_tension = 0.0 }
        } else {
            let pressure = m * phi_int * w_tension * circ
            if pressure > threshold {
                emit_count = emit_count + 1
                if (tick >= 250) && (tick < 750) {
                    peak_count = peak_count + 1
                } else {
                    trough_count = trough_count + 1
                }
                w_tension = 0.0
                refractory_remaining = r_steps
            } else {
                w_tension = w_tension + 0.05 * (w_target - w_tension)
            }
        }
        tick = tick + 1
    }
    return [to_float(emit_count), to_float(peak_count), to_float(trough_count)]
}

fn main() {
    println("================================================================")
    println("  H_308 — smooth (quadratic-bump) circadian — finite ratio recovery")
    println("================================================================")

    // ── primary measurement ────────────────────────────────────────────-
    let idle_result = simulate(0.5, 0)
    let idle_emit = to_int(idle_result[0])
    let peak = to_int(idle_result[1])
    let trough = to_int(idle_result[2])
    println("  IDLE (threshold=0.5, smooth circadian):")
    println("    emit_count = " + str(idle_emit) + " · peak (Q2+Q3) = " + str(peak) + " · trough (Q1+Q4) = " + str(trough))

    let mut ratio = 0.0
    if trough > 0 {
        ratio = to_float(peak) / to_float(trough)
        println("    peak/trough ratio = " + str(ratio) + " (biology dawn chorus: ~5-10×)")
    } else {
        println("    peak/trough ratio = INF (trough=0; smooth circadian failed to recover finite ratio)")
        ratio = 999.0
    }

    // ── threshold sweep ────────────────────────────────────────────────
    println("  THRESHOLD SWEEP (5 values, smooth circadian, idle mode):")
    let thresholds = [0.1, 0.3, 0.5, 0.7, 0.9]
    let mut prev_emit = 999999
    let mut monotone = true
    let mut i = 0
    while i < 5 {
        let t = thresholds[i]
        let r = simulate(t, 0)
        let e = to_int(r[0])
        println("    threshold=" + str(t) + " : emit=" + str(e))
        if e > prev_emit { monotone = false }
        prev_emit = e
        i = i + 1
    }

    println("  ────────────── verdict ──────────────")

    // ── F308.1 SMOOTH-FINITE-RATIO ──────────────────────────────────────
    let finite_ratio_ok = (trough > 0) && (ratio >= 3.0) && (ratio <= 15.0)
    check("F308.1 SMOOTH-FINITE-RATIO: peak/trough in [3, 15] (biology range)", finite_ratio_ok)

    // ── F308.2 IDLE-EMIT-PRESERVED ──────────────────────────────────────
    check("F308.2 IDLE-EMIT-PRESERVED: smooth idle emit > 0", idle_emit > 0)

    // ── F308.3 PEAK-COUNT-MID-RANGE ─────────────────────────────────────
    check("F308.3 PEAK-COUNT-MID-RANGE: peak emit in [30, 60]", (peak >= 30) && (peak <= 60))

    // ── F308.4 THRESHOLD-MONOTONE-PRESERVED ─────────────────────────────
    check("F308.4 THRESHOLD-MONOTONE-PRESERVED: 5-threshold emit non-increasing", monotone)

    // ── F308.5 SMOOTH-VS-PIECEWISE-IDLE-COMPARABLE ──────────────────────
    let h306_idle = 46
    let mut delta = idle_emit - h306_idle
    if delta < 0 { delta = 0 - delta }
    let rel_dev = to_float(delta) / to_float(h306_idle)
    println("    smooth idle emit = " + str(idle_emit) + " vs H_306 piecewise=46, rel_dev = " + str(rel_dev))
    check("F308.5 SMOOTH-VS-PIECEWISE-IDLE-COMPARABLE: |smooth - 46| / 46 <= 0.5", rel_dev <= 0.5)

    // ── F308.6 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    if !(idle_result[0] >= 0.0) { bound_ok = false }
    if !(idle_result[1] >= 0.0) { bound_ok = false }
    if !(idle_result[2] >= 0.0) { bound_ok = false }
    check("F308.6 BOUND: all >= 0", bound_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  HEADLINE: smooth circadian peak=" + str(peak) + " trough=" + str(trough) + " ratio=" + str(ratio))
    println("================================================================")
    if FAIL > 0 { panic("H_308 had FALSIFIER FAILURES") }
}
