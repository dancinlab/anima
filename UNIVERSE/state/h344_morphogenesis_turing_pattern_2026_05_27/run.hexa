// H_344 — MORPHOGENESIS × reaction-diffusion (Gray-Scott) Turing pattern
// ════════════════════════════════════════════════════════════════════════════
// REAL Gray-Scott reaction-diffusion simulation on a 1D periodic ring (N=32),
// two diffusing species: activator u, inhibitor v.
//
//   u' = u + dt*( Du*lap(u) - u*v^2 + F*(1 - u) )
//   v' = v + dt*( Dv*lap(v) + u*v^2 - (F + k)*v )
//
//   lap(x)_i = x_{i-1} - 2*x_i + x_{i+1}   (discrete Laplacian on the ring)
//
// Initial condition (DETERMINISTIC, NO RNG): the trivial homogeneous state
//   u_i = 1.0,  v_i = 0.0   everywhere,
// then a fixed localized seed: 4 contiguous cells centred at i=16 are flipped
//   u = 0.5,  v = 0.25.
// This is the SAME seed for every diffusion ratio — only Dv is swept.
//
// We HOLD Du fixed and SWEEP Dv so that the diffusion ratio rho = Dv/Du takes
// values {1, 2, 4, 8}. rho=1 (Dv=Du) is the SYMMETRIC control: a genuine Turing
// mechanism CANNOT break symmetry when the two species diffuse at equal rate —
// the localized seed must relax back toward the homogeneous state, leaving the
// spatial variance of u near 0. As rho rises past a critical value the faster
// inhibitor diffusion (short-range activation + long-range inhibition) lets the
// seed grow into a STABLE non-uniform pattern → spatial variance of u plateaus
// at a finite value.
//
// MEASURED QUANTITY: var_u = (1/N) Σ_i (u_i - mean_u)^2  of the FINAL field.
// var_u is NOT defined as a function of rho. It is computed from the actual
// integrated u-field produced by the timestep loop.
//
// Anti-tautology checklist (g73):
//   • No pattern is hard-coded. The u-field starts homogeneous + one fixed seed
//     and is evolved by the PDE loop. var_u is measured, not assigned.
//   • The rho=1 symmetric control is the built-in falsifier: if var_u(rho=1) is
//     ALSO large, the mechanism is NOT Turing (would be (b) "grows for all
//     ratios incl Dv=Du") → 🔴. If var_u stays ~0 for ALL rho → (a) no pattern
//     → 🔴. If the final state depends on run order / is non-deterministic →
//     (c) → 🔴. A 🔴 is a genuinely reachable outcome.
//   • Determinism is independently checked: rho=1 is simulated TWICE and the two
//     var_u values must be byte-identical.
// ════════════════════════════════════════════════════════════════════════════

// ── config (deterministic) ──────────────────────────────────────────────────
fn _N() -> int      { return 32 }       // ring size
fn _STEPS() -> int  { return 20000 }    // Euler steps to steady state
fn _DT() -> float   { return 1.0 }      // Euler timestep (GS standard dt=1)
fn _DU() -> float   { return 0.08 }     // activator diffusion (held FIXED)
fn _F()  -> float   { return 0.040 }    // feed rate
fn _K()  -> float   { return 0.060 }    // kill rate  (F,k in the spot regime)
fn _SEED_CENTER() -> int { return 16 }  // seed centre cell
fn _SEED_HALF()   -> int { return 2 }   // seed half-width (cells 14..17 flipped)
fn _SEED_U() -> float { return 0.50 }   // seed activator value
fn _SEED_V() -> float { return 0.25 }   // seed inhibitor value

fn _state_dir() -> string {
    return "/tmp/anima-h344/UNIVERSE/state/h344_morphogenesis_turing_pattern_2026_05_27"
}

// ── deterministic initial fields ────────────────────────────────────────────
// u = 1 everywhere, v = 0 everywhere, then a fixed contiguous seed block.
fn _init_u() -> [float] {
    let n = _N()
    let c = _SEED_CENTER()
    let h = _SEED_HALF()
    let mut u: [float] = []
    let mut i = 0
    while i < n {
        let mut val = 1.0
        if (i >= c - h) && (i < c + h) { val = _SEED_U() }
        u.push(val)
        i = i + 1
    }
    return u
}
fn _init_v() -> [float] {
    let n = _N()
    let c = _SEED_CENTER()
    let h = _SEED_HALF()
    let mut v: [float] = []
    let mut i = 0
    while i < n {
        let mut val = 0.0
        if (i >= c - h) && (i < c + h) { val = _SEED_V() }
        v.push(val)
        i = i + 1
    }
    return v
}

// ── spatial variance of a field on the ring ──────────────────────────────────
fn _variance(x: [float]) -> float {
    let n = _N()
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + x[i]; i = i + 1 }
    let mean = s / (n * 1.0)
    let mut acc = 0.0
    let mut j = 0
    while j < n {
        let d = x[j] - mean
        acc = acc + d * d
        j = j + 1
    }
    return acc / (n * 1.0)
}

// ── simulate(Dv): run the Gray-Scott PDE, return FINAL var_u ─────────────────
let mut g_var_u = 0.0
let mut g_mean_u = 0.0

fn simulate_gs(Dv: float) {
    let n  = _N()
    let steps = _STEPS()
    let dt = _DT()
    let Du = _DU()
    let F  = _F()
    let k  = _K()

    let mut u = _init_u()
    let mut v = _init_v()

    let mut s = 0
    while s < steps {
        let mut un: [float] = []
        let mut vn: [float] = []
        let mut i = 0
        while i < n {
            // ring neighbour indices.
            let mut il = i - 1
            if il < 0 { il = n - 1 }
            let mut ir = i + 1
            if ir >= n { ir = 0 }

            let lap_u = u[il] - 2.0 * u[i] + u[ir]
            let lap_v = v[il] - 2.0 * v[i] + v[ir]

            let uvv = u[i] * v[i] * v[i]

            let du = Du * lap_u - uvv + F * (1.0 - u[i])
            let dv = Dv * lap_v + uvv - (F + k) * v[i]

            un.push(u[i] + dt * du)
            vn.push(v[i] + dt * dv)
            i = i + 1
        }
        // copy back (synchronous update).
        let mut b = 0
        while b < n {
            u[b] = un[b]
            v[b] = vn[b]
            b = b + 1
        }
        s = s + 1
    }

    g_var_u = _variance(u)
    let mut ms = 0.0
    let mut mi = 0
    while mi < n { ms = ms + u[mi]; mi = mi + 1 }
    g_mean_u = ms / (n * 1.0)
}

fn main() {
    println("================================================================")
    println("  H_344 — MORPHOGENESIS × Gray-Scott reaction-diffusion Turing")
    println("  u' = u + dt(Du lap u - u v^2 + F(1-u))")
    println("  v' = v + dt(Dv lap v + u v^2 - (F+k) v)")
    println("================================================================")
    println("  N=" + str(_N()) + " steps=" + str(_STEPS()) + " dt=" + str(_DT())
            + " Du=" + str(_DU()) + " F=" + str(_F()) + " k=" + str(_K()))
    println("  seed: cells [" + str(_SEED_CENTER() - _SEED_HALF()) + ".."
            + str(_SEED_CENTER() + _SEED_HALF() - 1) + "] u=" + str(_SEED_U())
            + " v=" + str(_SEED_V()) + " (rest u=1,v=0)")
    println("  SWEEP Dv → ratio rho = Dv/Du ∈ {1,2,4,8}; Du held FIXED")
    println("  rho=1 (Dv=Du) = symmetric control: genuine Turing must stay flat")
    println("----------------------------------------------------------------")

    // ── ratio sweep: rho = Dv/Du; Dv = rho * Du ─────────────────────────────
    let Du = _DU()
    let mut rhos: [float] = []
    rhos.push(1.0)
    rhos.push(2.0)
    rhos.push(4.0)
    rhos.push(8.0)
    let n_r = 4

    let mut var_u_per: [float] = []
    let mut mean_u_per: [float] = []

    let mut ri = 0
    while ri < n_r {
        let rho = rhos[ri]
        let Dv = rho * Du
        simulate_gs(Dv)
        var_u_per.push(g_var_u)
        mean_u_per.push(g_mean_u)
        println("  rho=" + str(rho) + " (Dv=" + str(Dv) + ")   var_u=" + str(g_var_u)
                + "   mean_u=" + str(g_mean_u))
        ri = ri + 1
    }
    println("----------------------------------------------------------------")

    // ── determinism check: re-run rho=1 and compare ─────────────────────────
    simulate_gs(1.0 * Du)
    let var_u_repeat = g_var_u
    let determinism_ok = (var_u_repeat == var_u_per[0])
    println("  determinism: var_u(rho=1) run1=" + str(var_u_per[0])
            + " run2=" + str(var_u_repeat) + "  identical=" + str(determinism_ok))
    println("----------------------------------------------------------------")

    // ── falsifier evaluation (from MEASURED var_u(rho)) ─────────────────────
    let var_sym = var_u_per[0]              // rho=1 symmetric control
    let var_max = var_u_per[n_r - 1]        // rho=8 strongest asymmetry

    // threshold for "uniform" vs "patterned". The seed perturbation injects an
    // initial variance; after the homogeneous state stabilises in the symmetric
    // case it must decay BELOW this floor. Floor chosen generous (1e-4) so a
    // genuinely flat field passes and any real pattern (O(0.01+)) clears it.
    let VAR_FLOOR = 0.0001

    // F344.1 SYMMETRIC-STAYS-UNIFORM: var_u(rho=1) < VAR_FLOOR
    //   (Dv=Du cannot break symmetry — the seed relaxes back to homogeneous).
    let f1 = var_sym < VAR_FLOOR

    // F344.2 ASYMMETRIC-BREAKS-SYMMETRY: var_u(rho=8) > 100 * VAR_FLOOR
    //   (fast inhibitor diffusion grows a finite-amplitude pattern).
    let f2 = var_max > 100.0 * VAR_FLOOR

    // F344.3 THRESHOLD-EXISTS: there is a rho index where var jumps from below
    //   to above 10*VAR_FLOOR — i.e. a critical ratio inside (1, 8).
    let mut rho_c = 0.0 - 1.0
    let TH = 10.0 * VAR_FLOOR
    let mut ti = 0
    while ti < n_r - 1 {
        if rho_c < 0.0 {
            if (var_u_per[ti] < TH) && (var_u_per[ti + 1] >= TH) {
                rho_c = (rhos[ti] + rhos[ti + 1]) / 2.0
            }
        }
        ti = ti + 1
    }
    let f3 = (rho_c > 1.0) && (rho_c < 8.0)

    // F344.4 MONOTONE-IN-RATIO: var_u non-decreasing in rho within tol — the
    //   pattern strength grows (or holds) with the diffusion ratio, it does not
    //   oscillate. tol relative to var_max.
    let mut f4 = true
    let tol = 0.05 * var_max + 0.00001
    let mut m = 0
    while m < n_r - 1 {
        if var_u_per[m + 1] < var_u_per[m] - tol { f4 = false }
        m = m + 1
    }

    // F344.5 BOUNDED-FINITE: every var_u is finite and bounded (no blow-up).
    //   u physically ∈ [0,1] so var_u ≤ 0.25; allow slack to 0.5.
    let mut f5 = true
    let mut y = 0
    while y < n_r {
        let vv = var_u_per[y]
        if (vv < 0.0 - 0.000001) || (vv > 0.5) { f5 = false }
        y = y + 1
    }

    // F344.6 DETERMINISTIC: re-run of rho=1 is byte-identical (rules out the
    //   non-deterministic falsifier (c)).
    let f6 = determinism_ok

    let mut pass = 0
    let mut fail = 0
    if f1 { pass = pass + 1 } else { fail = fail + 1 }
    if f2 { pass = pass + 1 } else { fail = fail + 1 }
    if f3 { pass = pass + 1 } else { fail = fail + 1 }
    if f4 { pass = pass + 1 } else { fail = fail + 1 }
    if f5 { pass = pass + 1 } else { fail = fail + 1 }
    if f6 { pass = pass + 1 } else { fail = fail + 1 }

    println("  FALSIFIER EVALUATION (from MEASURED var_u(rho)):")
    println("  F344.1 SYMMETRIC-STAYS-UNIFORM  var(rho=1) < " + str(VAR_FLOOR) + " : " + str(f1) + "  (var=" + str(var_sym) + ")")
    println("  F344.2 ASYMMETRIC-BREAKS-SYM    var(rho=8) > " + str(100.0 * VAR_FLOOR) + " : " + str(f2) + "  (var=" + str(var_max) + ")")
    println("  F344.3 THRESHOLD-EXISTS         rho_c ∈ (1,8)          : " + str(f3) + "  (rho_c=" + str(rho_c) + ")")
    println("  F344.4 MONOTONE-IN-RATIO        non-decreasing (tol)   : " + str(f4))
    println("  F344.5 BOUNDED-FINITE           var ∈ [0,0.5] ∀rho     : " + str(f5))
    println("  F344.6 DETERMINISTIC            rho=1 rerun identical  : " + str(f6))
    println("================================================================")
    println("  RESULT: " + str(pass) + " PASS / " + str(fail) + " FAIL out of 6")

    let mut verdict = "ORANGE"
    let mut tier = "🟠"
    if pass >= 5 {
        verdict = "SUPPORTED_NUMERICAL"
        tier = "🟢"
    } else {
        // 🔴 sub-classification of the dominant failure mode.
        if (var_sym >= VAR_FLOOR) && (var_max >= VAR_FLOOR) {
            verdict = "FALSIFIED_GROWS_FOR_ALL_RATIOS_NO_THRESHOLD"
            tier = "🔴"
        }
        if (var_sym < VAR_FLOOR) && (var_max < 100.0 * VAR_FLOOR) {
            verdict = "FALSIFIED_NO_PATTERN_EVER"
            tier = "🔴"
        }
        if !f6 {
            verdict = "FALSIFIED_NON_DETERMINISTIC"
            tier = "🔴"
        }
        if !f4 {
            verdict = "FALSIFIED_NON_MONOTONE"
            tier = "🔴"
        }
    }

    println("  VERDICT: " + tier + " " + verdict + "  (criteria_met=" + str(pass) + "/6)")
    println("  measured Turing threshold rho_c (Dv/Du) = " + str(rho_c))
    println("================================================================")

    // ── write result.json ──────────────────────────────────────────────────
    let mut o = "{\n"
    o = o + "  \"id\": \"H_344\",\n"
    o = o + "  \"slug\": \"morphogenesis-turing-pattern\",\n"
    o = o + "  \"date\": \"2026-05-27\",\n"
    o = o + "  \"deterministic\": true,\n"
    o = o + "  \"hexa_only\": true,\n"
    o = o + "  \"llm\": \"none\",\n"
    o = o + "  \"cost\": \"$0 ubu-2 local\",\n"
    o = o + "  \"config\": {\n"
    o = o + "    \"N\": " + str(_N()) + ",\n"
    o = o + "    \"steps\": " + str(_STEPS()) + ",\n"
    o = o + "    \"dt\": " + str(_DT()) + ",\n"
    o = o + "    \"Du\": " + str(_DU()) + ",\n"
    o = o + "    \"F\": " + str(_F()) + ",\n"
    o = o + "    \"k\": " + str(_K()) + ",\n"
    o = o + "    \"seed_center\": " + str(_SEED_CENTER()) + ",\n"
    o = o + "    \"seed_half\": " + str(_SEED_HALF()) + ",\n"
    o = o + "    \"seed_u\": " + str(_SEED_U()) + ",\n"
    o = o + "    \"seed_v\": " + str(_SEED_V()) + "\n"
    o = o + "  },\n"
    o = o + "  \"rho_sweep\": [1.0, 2.0, 4.0, 8.0],\n"
    o = o + "  \"var_u_per_rho\": [\n"
    let mut q1 = 0
    while q1 < n_r {
        o = o + "    " + str(var_u_per[q1])
        if q1 < n_r - 1 { o = o + "," }
        o = o + "\n"
        q1 = q1 + 1
    }
    o = o + "  ],\n"
    o = o + "  \"mean_u_per_rho\": [\n"
    let mut q2 = 0
    while q2 < n_r {
        o = o + "    " + str(mean_u_per[q2])
        if q2 < n_r - 1 { o = o + "," }
        o = o + "\n"
        q2 = q2 + 1
    }
    o = o + "  ],\n"
    o = o + "  \"var_u_floor\": " + str(VAR_FLOOR) + ",\n"
    o = o + "  \"rho_c_measured\": " + str(rho_c) + ",\n"
    o = o + "  \"determinism_rerun_var\": " + str(var_u_repeat) + ",\n"
    o = o + "  \"falsifiers\": {\n"
    o = o + "    \"F344_1_symmetric_stays_uniform\":  " + str(f1) + ",\n"
    o = o + "    \"F344_2_asymmetric_breaks_sym\":     " + str(f2) + ",\n"
    o = o + "    \"F344_3_threshold_exists\":          " + str(f3) + ",\n"
    o = o + "    \"F344_4_monotone_in_ratio\":         " + str(f4) + ",\n"
    o = o + "    \"F344_5_bounded_finite\":            " + str(f5) + ",\n"
    o = o + "    \"F344_6_deterministic\":             " + str(f6) + "\n"
    o = o + "  },\n"
    o = o + "  \"criteria_met\": " + str(pass) + ",\n"
    o = o + "  \"criteria_total\": 6,\n"
    o = o + "  \"verdict\": \"" + verdict + "\",\n"
    o = o + "  \"tier\": \"" + tier + "\"\n"
    o = o + "}\n"
    write_file(_state_dir() + "/result.json", o)
    println("  result.json written → " + _state_dir() + "/result.json")
}
