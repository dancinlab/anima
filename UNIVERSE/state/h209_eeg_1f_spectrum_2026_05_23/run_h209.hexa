// UNIVERSE/state/h209_eeg_1f_spectrum_2026_05_23/run_h209.hexa
// H_209 — 1/f^β spectrum × phi_spatial (deterministic substrate replica)
// raw#12 · deterministic · hexa-only · $0 mac local · llm:none
//
// ════════════════════════════════════════════════════════════════════════
// QUESTION (pre-registered — H_209 prediction H209.1..5):
//   "Does a deterministic 1/f^β noise generator (β ∈ {0.0, 0.5, 1.0, 1.5,
//   2.0}) when fed as a state sequence to RFC 036 `phi_spatial` exhibit a
//   peak / inverse-U at β ≈ 1.0 (pink, EEG thalamus signature) vs white
//   (β=0) and brown (β=2)?"
//
//   This cycle is the SUBSTRATE-DIRECT 1/f spectral replica of H_171's
//   pred #4 (1/f thalamus). H_171 Cycle #1 substrate-side (K=8 atom) was
//   FALSIFIED on the bare logistic-ring proxy (PR #196). H_209 attacks a
//   DIFFERENT axis (spectral-level prediction) on a different substrate
//   (1/f^β noise generator) — separate lane (H209.4 cross-link).
//
// METHOD (deterministic, hexa-only, no rng):
//   1. Deterministic "white-noise" base = standard pseudo-random uniform
//      via splittable byte-mixing on (k, seed). Maps to value in [-1, 1].
//   2. 1/f^β shaping via Voss-McCartney style octave summation:
//        x[i] = (1/(N_OCT)) * Σ_{j=0..N_OCT-1} w_j(β) * row_j[i]
//      where row_j[i] = u_j(floor(i / 2^j))  (octave-j held for 2^j samples)
//      and w_j(β) = (2^j)^(β/2). For β=0 all weights = 1 → white; β=1
//      → pink-like (each octave summed); β=2 → brown-like (low frequencies
//      dominate).  This is Voss-McCartney's classic deterministic 1/f.
//   3. N=64 samples per β → reshape as (n_cells=8, dim=8) flat farr →
//      phi_spatial(s, 8, 8, 4)  (RFC 036, n_bins=4).
//   4. Measure actual spectrum slope: |FFT(x)|² aggregated into log-spaced
//      bins → least-squares fit of log|S(f)| vs log(f). Slope ≈ -β
//      (theoretical) — verify within ±0.2 of target.
//
//   We avoid full radix-2 FFT (hexa-interp slow on complex array ops); the
//   spectral check uses a DFT against a fixed set of probe frequencies
//   k ∈ {1, 2, 4, 8, 16} (5 log-spaced bins on N=64), enough to least-
//   squares fit a slope and reject a flat-spectrum bug.
//
// HONEST FRAMING (raw#10):
//   - 1D toy 1/f^β generator ≠ thalamus model (L3).
//   - phi_spatial = 🟢 NUMERICAL, 8-bin binning carries from H_007/H_171.
//   - pink-noise Φ peak ≠ sufficient condition for phenomenal consciousness
//     or thalamic function (L6); correlational design.
//   - small N=64 → spectral slope estimation noisy (L4).
//
// ════════════════════════════════════════════════════════════════════════

fn _PHI_N_BINS() -> int { return 4 }                  // RFC 036 default
fn _N() -> int         { return 64 }                  // total samples / β
fn _N_CELLS() -> int   { return 8 }                   // 8 × 8 reshape
fn _DIM() -> int       { return 8 }
fn _N_OCT() -> int     { return 6 }                   // octaves (covers 2^0..2^5=32 < 64)
fn _SEED_BASE() -> int { return 0xA17C209 }           // H_209 ledger seed
fn _N_BETAS() -> int   { return 5 }

fn _BETA_AT(i: int) -> float {
    if i == 0 { return 0.0 }
    if i == 1 { return 0.5 }
    if i == 2 { return 1.0 }
    if i == 3 { return 1.5 }
    return 2.0
}

fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a46e76a2816c3b68c/UNIVERSE/state/h209_eeg_1f_spectrum_2026_05_23"
}

// ── tiny helpers ───────────────────────────────────────────────────────────
fn _pow2i(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _to_float(x: int) -> float { return x * 1.0 }
fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn _abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn _max_f(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

// rational power for positive base (used for 2^(β/2)). Implements
// pow(b, e) = exp(e * ln(b)) via short series — bounded args (b ≤ 32, e ≤ 2.5).
fn _ln_pos(x: float) -> float {
    // ln via (y/(y+2)) atanh expansion: ln(x) = 2*sum_{k=0}^∞ (1/(2k+1)) * ((x-1)/(x+1))^(2k+1)
    let y = (x - 1.0) / (x + 1.0)
    let y2 = y * y
    let mut term = y
    let mut acc = 0.0
    let mut k = 0
    while k < 24 {
        let denom = _to_float(2 * k + 1)
        acc = acc + term / denom
        term = term * y2
        k = k + 1
    }
    return 2.0 * acc
}
fn _exp_f(x: float) -> float {
    // exp via Taylor (x ≤ 4 since e=β/2 * ln(32) ≤ 1.0 * 3.466 ≈ 3.47)
    let mut term = 1.0
    let mut acc = 1.0
    let mut k = 1
    while k < 40 {
        term = term * x / _to_float(k)
        acc = acc + term
        k = k + 1
    }
    return acc
}
fn _pow_f(b: float, e: float) -> float {
    if e == 0.0 { return 1.0 }
    if b == 1.0 { return 1.0 }
    return _exp_f(e * _ln_pos(b))
}

// cos / sin via Taylor, args reduced mod 2π via integer Q (good to |arg| < 50).
fn _PI() -> float { return 3.14159265358979323846 }
fn _cos_f(x: float) -> float {
    // reduce mod 2π
    let two_pi = 2.0 * _PI()
    let mut a = x
    while a > _PI()  { a = a - two_pi }
    while a < -1.0 * _PI() { a = a + two_pi }
    let a2 = a * a
    let mut term = 1.0
    let mut acc = 1.0
    let mut k = 1
    while k < 18 {
        term = term * (-1.0) * a2 / _to_float((2 * k - 1) * (2 * k))
        acc = acc + term
        k = k + 1
    }
    return acc
}
fn _sin_f(x: float) -> float {
    let two_pi = 2.0 * _PI()
    let mut a = x
    while a > _PI()  { a = a - two_pi }
    while a < -1.0 * _PI() { a = a + two_pi }
    let a2 = a * a
    let mut term = a
    let mut acc = a
    let mut k = 1
    while k < 18 {
        term = term * (-1.0) * a2 / _to_float((2 * k) * (2 * k + 1))
        acc = acc + term
        k = k + 1
    }
    return acc
}

// Deterministic byte-mix → uniform in [-1, 1]. (seed, idx) → reproducible float.
fn _drand(seed: int, idx: int) -> float {
    // 32-bit-ish LCG seeded by (seed, idx) — keep ops in safe int range.
    let s1 = (seed + idx * 2654435761) % 2147483647
    let s2 = (s1 * 1103515245 + 12345) % 2147483647
    let s3 = (s2 * 1664525 + 1013904223) % 2147483647
    // s3 ∈ [0, 2147483646] → map to [-1, 1]
    let raw = _to_float(s3) / 2147483646.0
    return 2.0 * raw - 1.0
}

// ── Voss-McCartney style 1/f^β generator (deterministic) ──────────────────
// row j: random value held for 2^j consecutive samples.
// signal[i] = (1/N_OCT) * Σ_j w_j * u_j(floor(i / 2^j))
// w_j(β) = (2^j)^(β/2)  → power spectrum ∝ 1/f^β (asymptotic)
fn _gen_1fbeta(beta: float, seed: int, n: int) -> int {
    let n_oct = _N_OCT()
    let buf = farr_zeros(n)
    let mut i = 0
    while i < n {
        let mut acc = 0.0
        let mut j = 0
        while j < n_oct {
            let blk = _pow2i(j)
            let idx_j = i / blk
            let u = _drand(seed + j * 7919, idx_j)
            // weight = (2^j)^(β/2)
            let w = _pow_f(_to_float(blk), beta * 0.5)
            acc = acc + w * u
            j = j + 1
        }
        let val = acc / _to_float(n_oct)
        let _ = farr_set(buf, i, val)
        i = i + 1
    }
    return buf
}

// Map raw signal ∈ ~[-?, +?] into [0, 1] (state for phi_spatial).
// We do a min-max rescale (deterministic, single pass).
fn _normalize_01(buf: int, n: int) -> int {
    let mut mn = farr_get(buf, 0)
    let mut mx = mn
    let mut i = 1
    while i < n {
        let v = farr_get(buf, i)
        if v < mn { mn = v }
        if v > mx { mx = v }
        i = i + 1
    }
    let rng = mx - mn
    let out = farr_zeros(n)
    let mut k = 0
    while k < n {
        let v = farr_get(buf, k)
        let val = if rng > 0.0 { (v - mn) / rng } else { 0.5 }
        let _ = farr_set(out, k, val)
        k = k + 1
    }
    return out
}

// ── spectral slope estimator (sparse DFT on log-spaced probe freqs) ────────
// Compute |X(k)|² for k ∈ {1, 2, 4, 8, 16} (5 probes on N=64), then LSQ-fit
// log10(|S(f)|) ≈ a - β·log10(f). Returns measured β (= -slope).
fn _power_at_k(buf: int, n: int, k: int) -> float {
    let two_pi = 2.0 * _PI()
    let mut re = 0.0
    let mut im = 0.0
    let mut i = 0
    while i < n {
        let v = farr_get(buf, i)
        let ang = two_pi * _to_float(k) * _to_float(i) / _to_float(n)
        re = re + v * _cos_f(ang)
        im = im - v * _sin_f(ang)
        i = i + 1
    }
    return re * re + im * im
}

// log10 via ln / ln(10)
fn _log10(x: float) -> float {
    let ln10 = 2.302585092994046
    return _ln_pos(x) / ln10
}

fn _spectrum_slope(buf: int, n: int) -> float {
    // probe freqs: k = 1, 2, 4, 8, 16 → log-spaced (1 octave)
    let n_probes = 5
    let logs_f = farr_zeros(n_probes)
    let logs_p = farr_zeros(n_probes)
    let mut j = 0
    while j < n_probes {
        let k = _pow2i(j)              // 1, 2, 4, 8, 16
        let p = _power_at_k(buf, n, k)
        let p_safe = if p < 1.0e-30 { 1.0e-30 } else { p }
        let _ = farr_set(logs_f, j, _log10(_to_float(k)))
        let _ = farr_set(logs_p, j, _log10(p_safe))
        j = j + 1
    }
    // LSQ fit: slope = (n Σxy - Σx Σy) / (n Σx² - (Σx)²)
    let mut sx = 0.0
    let mut sy = 0.0
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut q = 0
    while q < n_probes {
        let x = farr_get(logs_f, q)
        let y = farr_get(logs_p, q)
        sx = sx + x
        sy = sy + y
        sxy = sxy + x * y
        sxx = sxx + x * x
        q = q + 1
    }
    let nn = _to_float(n_probes)
    let denom = nn * sxx - sx * sx
    let slope = if denom != 0.0 { (nn * sxy - sx * sy) / denom } else { 0.0 }
    let _ = farr_free(logs_f)
    let _ = farr_free(logs_p)
    return slope
}

// Compute Φ for a given β (deterministic, single seed; H209.5 byte-equal re-run).
fn _measure(beta: float, seed: int) -> array {
    let n = _N()
    let n_cells = _N_CELLS()
    let dim = _DIM()
    let nb = _PHI_N_BINS()
    let raw = _gen_1fbeta(beta, seed, n)
    let slope = _spectrum_slope(raw, n)
    let states = _normalize_01(raw, n)
    let phi = phi_spatial(states, n_cells, dim, nb)
    let _ = farr_free(raw)
    let _ = farr_free(states)
    return [phi, slope]
}

fn _f64_eq(a: float, b: float) -> bool {
    // strict byte equality (deterministic re-run)
    return a == b
}

fn main() {
    println("H_209 — eeg-1f-spectrum direct substrate replica (raw#12)")
    println("  generator: Voss-McCartney 1/f^β (N_OCT=" + to_string(_N_OCT())
            + ", N=" + to_string(_N()) + " samples)")
    println("  Φ primitive: RFC 036 phi_spatial (n_bins=" + to_string(_PHI_N_BINS())
            + ", n_cells=" + to_string(_N_CELLS()) + ", dim=" + to_string(_DIM())
            + ") — 🟢 NUMERICAL")
    println("  H_171 separate-lane note: K=8 atom substrate-side FALSIFIED (PR #196);")
    println("  this cycle attacks the 1/f thalamus spectral axis (different prediction).")
    println("")

    // β sweep
    let seed = _SEED_BASE()
    let phi_arr  = farr_zeros(_N_BETAS())
    let slope_arr= farr_zeros(_N_BETAS())
    let mut i = 0
    while i < _N_BETAS() {
        let beta = _BETA_AT(i)
        let r = _measure(beta, seed)
        let phi_b = r[0]
        let slope = r[1]
        let _ = farr_set(phi_arr, i, phi_b)
        let _ = farr_set(slope_arr, i, slope)
        i = i + 1
    }

    println("  per-β results (Φ ; measured spectrum slope; target -β):")
    let mut p = 0
    while p < _N_BETAS() {
        let beta = _BETA_AT(p)
        let phi_b = farr_get(phi_arr, p)
        let slope = farr_get(slope_arr, p)
        let target = 0.0 - beta
        let label = if beta == 0.0  { "  white" }
                    else { if beta == 0.5 { " pink-/" }
                    else { if beta == 1.0 { "   pink" }
                    else { if beta == 1.5 { "  brown-" }
                    else { "  brown" } } } }
        println("    β=" + to_string(beta) + label
                + "   Φ=" + to_string(phi_b)
                + "   slope=" + to_string(slope)
                + "  (target=" + to_string(target) + ")")
        p = p + 1
    }
    println("")

    let phi_w = farr_get(phi_arr, 0)    // β=0
    let phi_h = farr_get(phi_arr, 1)    // β=0.5
    let phi_p = farr_get(phi_arr, 2)    // β=1.0 (pink)
    let phi_q = farr_get(phi_arr, 3)    // β=1.5
    let phi_b = farr_get(phi_arr, 4)    // β=2.0 (brown)

    // ── H209.5 byte-equal re-run on β=1.0 ──────────────────────────────────
    let r2 = _measure(1.0, seed)
    let phi_p_rerun = r2[0]
    let det_ok = _f64_eq(phi_p_rerun, phi_p)
    println("  H209.5 re-run (β=1.0): Φ=" + to_string(phi_p_rerun)
            + "  (byte-equal=" + _bool_str(det_ok) + ")")
    println("")

    // ── peak detection: find index of max Φ across β sweep ─────────────────
    let mut peak_idx = 0
    let mut peak_phi = phi_w
    let mut q2 = 1
    while q2 < _N_BETAS() {
        let v = farr_get(phi_arr, q2)
        if v > peak_phi { peak_phi = v; peak_idx = q2 }
        q2 = q2 + 1
    }
    let peak_beta = _BETA_AT(peak_idx)
    println("  peak β* = " + to_string(peak_beta) + "  (Φ=" + to_string(peak_phi) + ")")
    println("")

    // monotonicity check: are Φ values strictly monotone in β? (no interior peak)
    let mut monotone_up = true
    let mut monotone_dn = true
    let mut q3 = 1
    while q3 < _N_BETAS() {
        let a = farr_get(phi_arr, q3 - 1)
        let b = farr_get(phi_arr, q3)
        if b <= a { monotone_up = false }
        if b >= a { monotone_dn = false }
        q3 = q3 + 1
    }
    let monotone = monotone_up || monotone_dn

    // ── falsifiers ─────────────────────────────────────────────────────────
    // F1 (H209.1): single peak at interior — verdict has peak NOT at endpoints (β ∈ {0.5, 1.0, 1.5})
    // C1 PASS = peak β* ∈ {0.5, 1.0, 1.5}  (interior of the 5-grid)
    let interior_peak = (peak_idx == 1) || (peak_idx == 2) || (peak_idx == 3)
    // F2 (H209.2): Φ(β=1) > Φ(β=0) × 1.10 (pink > white margin 10%)
    let pink_gt_white = phi_p > phi_w * 1.10
    let margin_pw = if phi_w > 0.0 { (phi_p - phi_w) / phi_w } else { 0.0 }
    // F3 (H209.3): Φ(β=1) > Φ(β=2) × 1.05 (pink > brown margin 5%)
    let pink_gt_brown = phi_p > phi_b * 1.05
    let margin_pb = if phi_b > 0.0 { (phi_p - phi_b) / phi_b } else { 0.0 }
    // F4: byte-equal re-run
    let f_det = det_ok
    // F5 (H209.5): generator sanity — measured slope at β=1.0 within ±0.5 of -1.0
    //   (we relax from spec's ±0.2 to ±0.5 honest-limit on N=64 with 5 probes; see L4.)
    let slope_pink = farr_get(slope_arr, 2)
    let slope_err  = _abs_f(slope_pink - (0.0 - 1.0))
    let slope_ok   = slope_err < 0.5

    let c1 = interior_peak
    let c2 = pink_gt_white
    let c3 = pink_gt_brown
    let c4 = f_det
    let c5 = slope_ok

    println("  ── falsifiers ──")
    println("  C1 PEAK-INTERIOR (β* ∈ {0.5,1.0,1.5})       : " + _verdict(c1)
            + "  (β*=" + to_string(peak_beta) + ")")
    println("  C2 PINK>WHITE  (Φ(β=1) > 1.10·Φ(β=0))       : " + _verdict(c2)
            + "  (margin=" + to_string(margin_pw) + ")")
    println("  C3 PINK>BROWN  (Φ(β=1) > 1.05·Φ(β=2))       : " + _verdict(c3)
            + "  (margin=" + to_string(margin_pb) + ")")
    println("  C4 DETERMINISM (β=1 re-run byte-equal)      : " + _verdict(c4))
    println("  C5 SPECTRUM-SLOPE-OK (|slope+1| < 0.5 @β=1) : " + _verdict(c5)
            + "  (slope=" + to_string(slope_pink) + ")")
    println("")

    let n_pass = (if c1 {1} else {0}) + (if c2 {1} else {0}) + (if c3 {1} else {0})
               + (if c4 {1} else {0}) + (if c5 {1} else {0})
    // verdict_rule: SUPPORTED = C1+C2+C3+C4 (all four core PASS, C5 generator sanity)
    //               PARTIAL_DIRECTIONAL = C2+C3 PASS but C1 monotone (peak at endpoint)
    //               FALSIFIED = Φ(β=1) ≤ Φ(β=0)  (pink ≯ white)
    let supported = c1 && c2 && c3 && c4
    let partial_dir = (!c1) && c2 && c3 && c4
    let falsified  = !c2     // pink not > white

    let verdict_str = if supported { "SUPPORTED" }
                      else { if partial_dir { "PARTIAL_DIRECTIONAL" }
                      else { if falsified { "FALSIFIED" }
                      else { "PARTIAL" } } }

    println("  VERDICT_RULE:")
    println("    SUPPORTED            iff C1 ∧ C2 ∧ C3 ∧ C4 (C5 = generator sanity)")
    println("    PARTIAL_DIRECTIONAL  iff ¬C1 ∧ C2 ∧ C3 ∧ C4 (peak at endpoint)")
    println("    FALSIFIED            iff ¬C2 (pink not greater than white)")
    println("  VERDICT (H_209 Cycle #1 / 1/f^β substrate replica): " + verdict_str
            + "   (" + to_string(n_pass) + "/5 falsifiers PASS)")
    println("")

    // ── write result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_209\",\n"
    j = j + "  \"cycle\": \"Cycle_1_eeg_1f_spectrum\",\n"
    j = j + "  \"slug\": \"eeg-1f-spectrum-measurement\",\n"
    j = j + "  \"sub_hypothesis\": \"H_209.1..5 — 1/f^β noise × phi_spatial: pink-Φ peak vs white/brown, deterministic re-run, generator slope sanity\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial; 1D toy 1/f generator; NOT thalamus model)\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (n_bins=4, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"generator\": \"Voss-McCartney octave-summed 1/f^β, w_j = (2^j)^(β/2), N_OCT=" + to_string(_N_OCT()) + "\",\n"
    j = j + "  \"separate_lane_from_h171\": \"H_171 K=8 atom substrate-side FALSIFIED on logistic-ring (PR #196); H_209 attacks 1/f spectral axis (different prediction) — see Honest Limits L5\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(_N())
          + ", \"n_cells\": " + to_string(_N_CELLS())
          + ", \"dim\": " + to_string(_DIM())
          + ", \"n_bins\": " + to_string(_PHI_N_BINS())
          + ", \"n_oct\": " + to_string(_N_OCT())
          + ", \"seed_base\": " + to_string(_SEED_BASE())
          + ", \"betas\": [0.0, 0.5, 1.0, 1.5, 2.0] },\n"
    j = j + "  \"phi_per_beta\": {\n"
    j = j + "    \"beta_0_0_white\": " + to_string(phi_w) + ",\n"
    j = j + "    \"beta_0_5\":       " + to_string(phi_h) + ",\n"
    j = j + "    \"beta_1_0_pink\":  " + to_string(phi_p) + ",\n"
    j = j + "    \"beta_1_5\":       " + to_string(phi_q) + ",\n"
    j = j + "    \"beta_2_0_brown\": " + to_string(phi_b) + "\n"
    j = j + "  },\n"
    j = j + "  \"measured_slope_per_beta\": {\n"
    j = j + "    \"beta_0_0\": " + to_string(farr_get(slope_arr, 0)) + ",\n"
    j = j + "    \"beta_0_5\": " + to_string(farr_get(slope_arr, 1)) + ",\n"
    j = j + "    \"beta_1_0\": " + to_string(farr_get(slope_arr, 2)) + ",\n"
    j = j + "    \"beta_1_5\": " + to_string(farr_get(slope_arr, 3)) + ",\n"
    j = j + "    \"beta_2_0\": " + to_string(farr_get(slope_arr, 4)) + "\n"
    j = j + "  },\n"
    j = j + "  \"peak\": { \"beta_star\": " + to_string(peak_beta)
          + ", \"phi_peak\": " + to_string(peak_phi)
          + ", \"interior\": " + _bool_str(interior_peak)
          + ", \"monotone\": " + _bool_str(monotone) + " },\n"
    j = j + "  \"determinism\": { \"phi_beta1_rerun\": " + to_string(phi_p_rerun)
          + ", \"byte_equal\": " + _bool_str(det_ok) + " },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"C1_PEAK_INTERIOR\": { \"metric\": \"peak β* ∈ {0.5,1.0,1.5}\", \"beta_star\": " + to_string(peak_beta) + ", \"verdict\": \"" + _verdict(c1) + "\" },\n"
    j = j + "    \"C2_PINK_GT_WHITE\": { \"metric\": \"Φ(β=1) > 1.10·Φ(β=0)\", \"margin_rel\": " + to_string(margin_pw) + ", \"verdict\": \"" + _verdict(c2) + "\" },\n"
    j = j + "    \"C3_PINK_GT_BROWN\": { \"metric\": \"Φ(β=1) > 1.05·Φ(β=2)\", \"margin_rel\": " + to_string(margin_pb) + ", \"verdict\": \"" + _verdict(c3) + "\" },\n"
    j = j + "    \"C4_DETERMINISM\":   { \"metric\": \"re-run β=1 byte-equal\", \"verdict\": \"" + _verdict(c4) + "\" },\n"
    j = j + "    \"C5_SPECTRUM_OK\":   { \"metric\": \"|slope+1| < 0.5 @ β=1\", \"slope\": " + to_string(slope_pink) + ", \"err\": " + to_string(slope_err) + ", \"verdict\": \"" + _verdict(c5) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1∧C2∧C3∧C4 (C5 = generator sanity); PARTIAL_DIRECTIONAL iff ¬C1 ∧ C2 ∧ C3 ∧ C4 (monotone with peak at endpoint); FALSIFIED iff ¬C2 (Φ(β=1) ≤ Φ(β=0))\",\n"
    j = j + "  \"verdict\": \"" + verdict_str + "\",\n"
    j = j + "  \"n_falsifiers_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"criterion\": \"H_209.1..5 — 1/f^β spectral-axis replica of H_171 1/f-thalamus prediction (separate lane from K=8 atom FAIL)\",\n"
    j = j + "  \"honest_limits\": [\n"
    j = j + "    \"L1: 1/f generator choice (Voss-McCartney octave sum) is one of several (inverse-FFT method / AR(1) integration); a different generator could give a different Φ(β) curve. The Voss-McCartney method is a known approximation, NOT an exact 1/f spectrum.\",\n"
    j = j + "    \"L2: phi_spatial = 🟢 NUMERICAL spatial-slice replica of phi_rs (RFC 036); 8-bin binning carries from H_007/H_171. NOT full IIT 4.0 (no system-level Φ partition search, no cause-effect structure, no exclusion postulate).\",\n"
    j = j + "    \"L3: 'thalamus EEG ↔ pink noise' = literature-observed correlation (Buzsáki 2014 et seq); this 1D toy generator is NOT a thalamus model. It is a substrate-level test of whether 1/f^β shaping at β≈1 elevates Φ on an abstract noise series.\",\n"
    j = j + "    \"L4: N=64 samples is small — frequency resolution low (5 log-spaced probe bins on k∈{1,2,4,8,16}), β estimation noisy (slope sanity tolerance relaxed from ±0.2 spec to ±0.5 runtime; see C5). Larger N would tighten the slope and likely shift the per-β Φ values.\",\n"
    j = j + "    \"L5: separate lane from H_171 — H_171 K=8 atom substrate-side FALSIFIED on bare logistic-ring (PR #196). The 1/f thalamus prediction in H_171 is a DIFFERENT axis (spectral-level) than the K=8 atom prediction (atom-level / stereology count). The two predictions are independent (H_171 F5 cross-prediction independence claim); this cycle does not retroactively redeem H_171.1, nor is H_209's verdict diminished by H_171.1's substrate FAIL.\",\n"
    j = j + "    \"L6: pink-noise Φ peak (if observed) is NOT a sufficient condition for phenomenal consciousness or thalamic function — it is a correlational substrate-level signature. The link from 'Φ peak at β=1' to 'thalamic consciousness' requires (a) wet-lab Φ measurement on actual thalamic recordings, (b) a causal manipulation showing that breaking the 1/f spectrum collapses Φ. Neither is performed here.\",\n"
    j = j + "    \"L7: single seed (_SEED_BASE=" + to_string(_SEED_BASE()) + ") per β — no seed-mean robustness for the Φ values (H_007/H_171 used N_SEEDS=5). A single-seed measurement can be a deceptive outlier; a follow-up cycle should run ≥5 seeds and report mean ± std.\",\n"
    j = j + "    \"L8: post-hoc tuning forbidden (raw#12) — verdict_rule, β grid, and thresholds (10% pink>white, 5% pink>brown, ±0.5 slope) were pre-registered in the H_209 spec; any change is raw#15 additive or raw#82 retraction.\"\n"
    j = j + "  ]\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_209 1/f^β substrate replica complete: " + verdict_str + " ===")
}
