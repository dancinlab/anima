// H_335 — EPIGENETICS phase-length sweep (H_332 follow-up)
// H_332 found hybrid(rule110 x10, rule30 x10) == rule110-only baseline (d=0).
// Open question (H_332 L2): does a LONGER phase-2 eventually escape the
// phase-1 attractor? Sweep T2 in {10, 50, 100, 500} with T1=10 fixed.
//
// H1: even at T2=500, the hybrid distribution stays LOCKED to the rule110
//     attractor (d to rule110-baseline << d to rule30-baseline) — permanent
//     epigenetic memory. Falsifier: at large T2 the hybrid escapes toward
//     the rule30 (phase-2) baseline (d_to_r110 rises, d_to_r30 falls).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

fn forward2(s0: int, ra: int, t1: int, rb: int, t2: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < t1 { s = next4(s, ra); t = t + 1 }
    let mut u = 0
    while u < t2 { s = next4(s, rb); u = u + 1 }
    return s
}

fn build_hist_2phase(ra: int, t1: int, rb: int, t2: int, hist: int) {
    let mut s0 = 0
    while s0 < 16 {
        let fs = forward2(s0, ra, t1, rb, t2)
        let cur = to_int(farr_get(hist, fs))
        let _ = farr_set(hist, fs, to_float(cur + 1))
        s0 = s0 + 1
    }
}

fn build_hist_1phase(r: int, t: int, hist: int) {
    let mut s0 = 0
    while s0 < 16 {
        let mut s = s0
        let mut k = 0
        while k < t { s = next4(s, r); k = k + 1 }
        let cur = to_int(farr_get(hist, s))
        let _ = farr_set(hist, s, to_float(cur + 1))
        s0 = s0 + 1
    }
}

fn manhattan(h1: int, h2: int) -> float {
    let mut d = 0.0
    let mut i = 0
    while i < 16 {
        let p1 = to_float(to_int(farr_get(h1, i))) / 16.0
        let p2 = to_float(to_int(farr_get(h2, i))) / 16.0
        let diff = if p1 > p2 { p1 - p2 } else { p2 - p1 }
        d = d + diff
        i = i + 1
    }
    return d
}

fn sweep_one(t2: int) {
    // hybrid: rule110 x10, then rule30 x t2
    let hyb = farr_zeros(16)
    build_hist_2phase(110, 10, 30, t2, hyb)
    // base rule110 (10 + t2 steps, all 110) and base rule30 (10 + t2 steps, all 30)
    let b110 = farr_zeros(16)
    build_hist_1phase(110, 10 + t2, b110)
    let b30 = farr_zeros(16)
    build_hist_1phase(30, 10 + t2, b30)
    let d_r110 = manhattan(hyb, b110)
    let d_r30 = manhattan(hyb, b30)
    println("T2=" + str(t2) + " d(hybrid,base110)=" + str(d_r110) + " d(hybrid,base30)=" + str(d_r30))
    let _ = farr_free(hyb); let _ = farr_free(b110); let _ = farr_free(b30)
}

fn main() {
    println("H_335 EPIGENETICS phase-length sweep (T1=10 rule110, T2 sweep rule30)")
    sweep_one(10)
    sweep_one(50)
    sweep_one(100)
    sweep_one(500)
    println("done")
}
