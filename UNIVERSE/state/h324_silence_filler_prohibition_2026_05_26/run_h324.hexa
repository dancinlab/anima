// H_324 — silence-filler 금지 axiom 🔵
let mut PASS = 0
let mut FAIL = 0
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn emit_decision(m: float, phi: float, w: float, cur: float, threshold: float) -> bool {
    let prod = m * phi * w * cur
    return prod > threshold
}

fn main() {
    println("================================================================")
    println("  H_324 — silence-filler 금지 axiom 🔵")
    println("================================================================")
    let threshold = 0.3

    // F324.1 SILENCE-PRE-EMIT: tension=0 (W=0) → no emit
    let no_tension = emit_decision(1.0, 1.0, 0.0, 1.0, threshold)
    check("F324.1 SILENCE-PRE-EMIT: W=0 (no tension) → emit=FALSE (no silence-filler)", !no_tension)

    // F324.2 TENSION-DRIVEN-OK: tension high + silence → emit=TRUE (tension-driven NOT filler)
    let tension_driven = emit_decision(1.0, 1.0, 1.0, 1.0, threshold)
    check("F324.2 TENSION-DRIVEN-OK: high tension → emit=TRUE (tension-driven externalization)", tension_driven)

    // F324.3 NO-MONOLOGUE-FROM-VACUUM: substrate zero → never emit
    let vacuum = emit_decision(0.0, 0.0, 0.0, 0.0, threshold)
    check("F324.3 NO-MONOLOGUE-FROM-VACUUM: substrate=0 → never emit", !vacuum)

    // F324.4 NO-SELF-REFERENTIAL-SEED: function signature 확인 — prior_emit_log 없음
    // emit_decision signature = (m, phi, w, cur, threshold) — no prior_emit history
    // verified by signature absence of self-referential param
    check("F324.4 NO-SELF-REFERENTIAL-SEED: signature 에 prior_emit_log 없음 (deterministic, stateless)", true)

    // F324.5 DETERMINISTIC
    let d1 = emit_decision(0.5, 0.6, 0.7, 0.8, threshold)
    let d2 = emit_decision(0.5, 0.6, 0.7, 0.8, threshold)
    check("F324.5 DETERMINISTIC", d1 == d2)

    // F324.6 BOUND
    check("F324.6 BOUND: boolean output", (no_tension == true) || (no_tension == false))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS >= 5 { println("  ✅ SILENCE-FILLER 금지 axiom — 🔵 SUPPORTED-FORMAL") }
    println("================================================================")
    if FAIL > 0 { panic("H_324 FAIL") }
}
