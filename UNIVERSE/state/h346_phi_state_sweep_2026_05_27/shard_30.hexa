// H_346 per-rule shard — single rule, state-averaged exact Phi at n=5.
// Sharded from run.hexa because the 4-rule x 32-state x exact phi_structure
// run exceeds the harness wall budget; each shard is byte-identical reproducible.

import "stdlib/consciousness/iit4_relation.hexa"
import "HEXAD/IIT4/lib/iit4_eca.hexa"

fn next5(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 5 {
        let im1 = (i + 4) % 5
        let ip1 = (i + 1) % 5
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn settle(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 50 { s = next5(s, rule); t = t + 1 }
    return s
}

fn basin_max(rule: int) -> int {
    let basin = farr_zeros(32)
    let mut s0 = 0
    while s0 < 32 { let t = settle(s0, rule); let c = to_int(farr_get(basin,t)); let _ = farr_set(basin,t,to_float(c+1)); s0 = s0+1 }
    let mut mx = 0; let mut i = 0
    while i < 32 { let b = to_int(farr_get(basin,i)); if b > mx { mx = b }; i = i+1 }
    let _ = farr_free(basin)
    return mx
}

fn basin_nattr(rule: int) -> int {
    let oc = farr_zeros(32)
    let mut s0 = 0
    while s0 < 32 { let _ = farr_set(oc, settle(s0,rule), 1.0); s0 = s0+1 }
    let mut n = 0; let mut i = 0
    while i < 32 { if to_int(farr_get(oc,i)) == 1 { n = n+1 }; i = i+1 }
    let _ = farr_free(oc)
    return n
}

fn mean_phi_n5(rule: int) -> float {
    let tpm = eca_tpm(rule, 5)
    let mut tot = 0.0
    let mut s = 0
    while s < 32 {
        let res = phi_structure(tpm, 5, s)
        tot = tot + res[4]
        s = s + 1
    }
    return tot / 32.0
}

fn main() {
    let rule = 30
    let mb = basin_max(rule)
    let na = basin_nattr(rule)
    let ph = mean_phi_n5(rule)
    println("rule" + str(rule) + " max_basin=" + str(mb) + " n_attr=" + str(na) + " mean_phi=" + str(ph))
}
