// H_345 — basin <-> EXACT big-Phi coupling at n=5 (proxy-free, decisive on H_343)
// H_341 (n=4, exact Phi):  Pearson(max_basin, Phi) = +0.776
// H_343 (n=6, cyclelen PROXY): Pearson = -0.502 (SIGN FLIP) -- but confounded
//   by proxy != exact-Phi. n=5 is the largest odd ring with EXACT phi_structure
//   tractable (32 states, per H_278/H_321). This removes the proxy confound:
//   measure BOTH basin AND exact phi_structure at the same n=5.
//
// H1: at n=5 with EXACT Phi, the sign matches n=4 (positive, basin->Phi) =>
//     H_343's flip was a proxy artifact, coupling is genuine.
//   ALT: if n=5 exact also flips negative => the flip is a real SCALE effect
//     (n=4 was the outlier), not a proxy artifact.
// Either resolves the H_343 confound. Falsifier for "proxy-artifact": n=5 exact
//   sign is negative (then it is scale, not proxy).

import "stdlib/consciousness/iit4_relation.hexa"
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_eca.hexa"

fn next5(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 5 {
        let im1 = (i + 4) % 5
        let ip1 = (i + 1) % 5
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn settle(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 50 { s = next5(s, rule); t = t + 1 }
    return s
}

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + farr_get(xs, i); sy = sy + farr_get(ys, i); i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        cov = cov + dx * dy; vx = vx + dx * dx; vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

fn basin_max(rule: int) -> int {
    let basin = farr_zeros(32)
    let mut s0 = 0
    while s0 < 32 {
        let term = settle(s0, rule)
        let cur = to_int(farr_get(basin, term))
        let _ = farr_set(basin, term, to_float(cur + 1))
        s0 = s0 + 1
    }
    let mut mx = 0
    let mut i = 0
    while i < 32 { let b = to_int(farr_get(basin, i)); if b > mx { mx = b }; i = i + 1 }
    let _ = farr_free(basin)
    return mx
}

fn basin_nattr(rule: int) -> int {
    let oc = farr_zeros(32)
    let mut s0 = 0
    while s0 < 32 { let _ = farr_set(oc, settle(s0, rule), 1.0); s0 = s0 + 1 }
    let mut n = 0
    let mut i = 0
    while i < 32 { if to_int(farr_get(oc, i)) == 1 { n = n + 1 }; i = i + 1 }
    let _ = farr_free(oc)
    return n
}

// exact phi_structure total at n=5, single sys-state (use 0b10101 = 21, the
// canonical alternating state H_287 panel used)
fn phi_n5(rule: int) -> float {
    let tpm = eca_tpm(rule, 5)
    let res = phi_structure(tpm, 5, 21)
    // res = [nd, sum_d, nr, sum_r, total]  (H_321 convention) → total = index 4
    return farr_get(res, 4)
}

fn main() {
    println("H_345 basin <-> EXACT big-Phi at n=5 (proxy-free)")
    let mb = farr_zeros(4)
    let na = farr_zeros(4)
    let phi = farr_zeros(4)
    let _ = farr_set(mb, 0, to_float(basin_max(110)))
    let _ = farr_set(mb, 1, to_float(basin_max(30)))
    let _ = farr_set(mb, 2, to_float(basin_max(105)))
    let _ = farr_set(mb, 3, to_float(basin_max(150)))
    let _ = farr_set(na, 0, to_float(basin_nattr(110)))
    let _ = farr_set(na, 1, to_float(basin_nattr(30)))
    let _ = farr_set(na, 2, to_float(basin_nattr(105)))
    let _ = farr_set(na, 3, to_float(basin_nattr(150)))
    let _ = farr_set(phi, 0, phi_n5(110))
    let _ = farr_set(phi, 1, phi_n5(30))
    let _ = farr_set(phi, 2, phi_n5(105))
    let _ = farr_set(phi, 3, phi_n5(150))
    println("rule110 max_basin=" + str(to_int(farr_get(mb,0))) + " n_attr=" + str(to_int(farr_get(na,0))) + " phi=" + str(farr_get(phi,0)))
    println("rule30  max_basin=" + str(to_int(farr_get(mb,1))) + " n_attr=" + str(to_int(farr_get(na,1))) + " phi=" + str(farr_get(phi,1)))
    println("rule105 max_basin=" + str(to_int(farr_get(mb,2))) + " n_attr=" + str(to_int(farr_get(na,2))) + " phi=" + str(farr_get(phi,2)))
    println("rule150 max_basin=" + str(to_int(farr_get(mb,3))) + " n_attr=" + str(to_int(farr_get(na,3))) + " phi=" + str(farr_get(phi,3)))
    let r_mb = pearson(mb, phi, 4)
    let r_na = pearson(na, phi, 4)
    println("Pearson(max_basin, EXACT_Phi)        = " + str(r_mb))
    println("Pearson(n_attractor_states, EXACT_Phi) = " + str(r_na))
    println("n4(exact)=+0.776 · n6(proxy)=-0.502 · n5(exact)=" + str(r_mb))
    println("done")
}
