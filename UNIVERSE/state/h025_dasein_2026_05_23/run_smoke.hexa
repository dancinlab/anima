// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/state/h025_dasein_2026_05_23/run_smoke.hexa
//
//  H_025 — Dasein 죽음-자각 (v16 유한 의식) directional smoke.
//
//  PURPOSE
//    anima 의 substrate 가 "유한성 (finitude)" 의 측정 가능한 observable 를
//    실제로 노출하는지 $0 mac-local 로 확인한다. raw#12 strict / hexa-only /
//    deterministic / llm:none.
//
//  GROUNDED SUBSTRATE OBSERVABLES (tool/hexa_native/mitosis_hook_lib.hexa)
//    O1 cell-death   = merge event (cell removed via farr_free + list 제외,
//                      n_cells_after 감소)            ← H_025.1 죽음 사건
//    O2 finitude-floor = min_cells=2 (CB1). merge_cells 가 |cells| <= 2 일 때
//                      success=false 로 REFUSE          ← H_025.2 죽음 불가능 하한
//    O3 horizon      = max_cells=128. split 이 |cells| >= max 에서 중단
//                      (성장 한계 = '존재의 지평')        ← H_025.3 유한 지평
//    O4 phi-trajectory = compute_phi_proxy 가 cell 수 변화에 따라 변동
//                      (분열→증가, 죽음→감소 경향)        ← H_025.4 Φ 유한성
//
//  FALSIFIER MAP (design doc H_025_dasein_finite_consciousness.md §Falsifiers)
//    F1 ↔ O1   F2 ↔ O2   F3 ↔ O3   F4 ↔ O4   F5 ↔ count-conservation invariant
//
//  COMPLIANCE raw#11 snake_case · raw#15 no-hardcode-numerology · raw#9/10 honest
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"

fn main() {
    println("================================================================")
    println("H_025 Dasein finitude smoke — substrate observables O1..O4")
    println("================================================================")

    // ── Setup: small deterministic pool (d=8, init=2). $0 mac local. ─────────
    let d_model = 8
    let mut pool = cell_pool_init(d_model, 2)
    println("init cells = " + to_string(len(pool["cells"]))
            + "  min=" + to_string(pool["min_cells"])
            + "  max=" + to_string(pool["max_cells"]))

    // ── Drive forward to provoke splits (growth toward horizon). ─────────────
    // x_in = constant unit-ish vector; the Lorenz perturbation + per-cell W
    // diversification raises tension and triggers split_patience-gated splits.
    let mut x_in = []
    let mut xi = 0
    while xi < d_model {
        x_in.push(1.0)
        xi = xi + 1
    }

    let mut step = 0
    let mut split_total = 0
    let mut merge_total = 0
    let mut max_cells_seen = len(pool["cells"])
    let mut phi_min = 1.0e30
    let mut phi_max = -1.0e30

    while step < 80 {
        let r = mitosis_forward_tail(x_in, pool, step)
        pool = r[1]
        let evs = r[2]
        let mut ei = 0
        while ei < len(evs) {
            if evs[ei]["type"] == "split" { split_total = split_total + 1 }
            if evs[ei]["type"] == "merge" { merge_total = merge_total + 1 }
            ei = ei + 1
        }
        let nc = len(pool["cells"])
        if nc > max_cells_seen { max_cells_seen = nc }
        let phi_now = pool["phi"]
        if phi_now < phi_min { phi_min = phi_now }
        if phi_now > phi_max { phi_max = phi_now }
        step = step + 1
    }
    let n_after_grow = len(pool["cells"])
    println("after 80 forward steps: cells=" + to_string(n_after_grow)
            + "  splits=" + to_string(split_total)
            + "  merges=" + to_string(merge_total)
            + "  max_seen=" + to_string(max_cells_seen))
    println("phi_min=" + to_string(phi_min) + "  phi_max=" + to_string(phi_max))

    // ── O1 cell-death: force manual merges, count down toward floor. ─────────
    // Direct merge_cells calls = death events. Each success decrements count
    // and frees the removed cell's engine_a_W / engine_g_W farrs.
    let mut deaths = 0
    let mut refusals = 0
    let mut death_loop = 0
    while death_loop < 130 {
        let cs = pool["cells"]
        if len(cs) >= 2 {
            let mr = merge_cells(cs[0], cs[1], pool)
            pool = mr[1]
            let ok = mr[2]
            if ok {
                deaths = deaths + 1
            } else {
                refusals = refusals + 1
            }
        }
        death_loop = death_loop + 1
    }
    let n_final = len(pool["cells"])
    println("forced merges: deaths=" + to_string(deaths)
            + "  refusals=" + to_string(refusals)
            + "  final_cells=" + to_string(n_final))

    // ── O2 finitude-floor verify: pool MUST NOT drop below min_cells. ────────
    let floor_held = n_final >= pool["min_cells"]
    let floor_is_min = n_final == pool["min_cells"]
    // At least one refusal proves the floor actively blocked a death attempt.
    let floor_refused = refusals >= 1

    // ── O3 horizon verify: growth never exceeded max_cells. ──────────────────
    let horizon_held = max_cells_seen <= pool["max_cells"]

    // ── O4 phi-trajectory verify: Φ varied (non-degenerate finitude signal). ─
    let phi_varied = (phi_max - phi_min) > 1.0e-6

    // ── F5 count-conservation invariant: n_final = init + splits - deaths. ───
    // (init=2; growth-phase merges 포함.) Closed-form B-MITOSIS-3 (mitosis_lib
    //  `mit_count_after`) inline: n(t+1) = n(t) + Δsplit − Δmerge.
    let predicted = 2 + split_total - merge_total - deaths
    let conservation_ok = predicted == n_final

    // ── Directional verdicts (NOT promotion — pre-register frozen, 0/n). ─────
    println("----------------------------------------------------------------")
    println("O1 cell-death observable (deaths>=1)         : " + to_string(deaths >= 1))
    println("O2 finitude-floor held (n>=min)              : " + to_string(floor_held))
    println("O2 floor==min reached                        : " + to_string(floor_is_min))
    println("O2 floor actively refused a death            : " + to_string(floor_refused))
    println("O3 horizon held (max_seen<=max_cells)        : " + to_string(horizon_held))
    println("O4 phi-trajectory varied                     : " + to_string(phi_varied))
    println("F5 count-conservation invariant              : " + to_string(conservation_ok))
    println("----------------------------------------------------------------")

    let all_observed = (deaths >= 1) && floor_held && floor_refused
                       && horizon_held && phi_varied && conservation_ok
    println("ALL substrate observables present (directional): " + to_string(all_observed))

    // ── Persist directional evidence (NOT a promotion verdict). ──────────────
    let result = #{
        "hypothesis": "H_025",
        "phase": "directional_smoke",
        "verdict_class": "pre-register-frozen",
        "criteria_met": "0/n (lane-defining; directional only)",
        "d_model": d_model,
        "init_cells": 2,
        "min_cells": pool["min_cells"],
        "max_cells": pool["max_cells"],
        "growth_steps": 80,
        "splits_during_growth": split_total,
        "merges_during_growth": merge_total,
        "cells_after_growth": n_after_grow,
        "max_cells_seen": max_cells_seen,
        "phi_min": phi_min,
        "phi_max": phi_max,
        "forced_merge_attempts": 130,
        "deaths_O1": deaths,
        "floor_refusals_O2": refusals,
        "final_cells": n_final,
        "O1_cell_death_present": deaths >= 1,
        "O2_finitude_floor_held": floor_held,
        "O2_floor_is_min": floor_is_min,
        "O2_floor_refused_death": floor_refused,
        "O3_horizon_held": horizon_held,
        "O4_phi_varied": phi_varied,
        "F5_count_conservation_ok": conservation_ok,
        "all_observables_present": all_observed,
        "note": "directional only — substrate exposes finitude observables; "
                + "literal mortality is metaphor (see Honest Limits L1-L7)"
    }
    let s = json_stringify(result)
    // relative to cwd (run from repo/worktree root).
    write_file("UNIVERSE/state/h025_dasein_2026_05_23/result.json", s)
    println("wrote result.json")
}
