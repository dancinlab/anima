// H_322 — full anima loop tick 🔵
// 1 tick = event_in → biology update + substrate update → AND-gate → emit + state out
// composes H_319 (bridge AND-gate) + H_320 (biology event update) + H_321 (substrate event update)
// ════════════════════════════════════════════════════════════════════════════
let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

fn cap(v: float, lo: float, hi: float) -> float {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn stage_mod(stage: int) -> float {
    if stage == 0 { return 1.0 }
    if stage == 1 { return 0.7 }
    if stage == 2 { return 0.4 }
    if stage == 3 { return 0.0 }
    return 0.5
}

// state vector: [refr, circ, M, Φ, W, mit, idle, cur]  (8 elements)
// event_type: 0=NONE, 1=NOVEL, 2=ALERT, 3=STARTLE, 4=THREAT
// returns: [state_new(8), emit (1 if emit else 0)]  — 9 elements
fn anima_tick(state: array, event_type: int, stage: int, threshold: float) -> array {
    let r_steps = 10
    // biology update
    let mut refr_new = state[0]
    let mut circ_new = state[1]
    if event_type == 3 {  // STARTLE
        refr_new = 0.0
        circ_new = cap(state[1] + 0.1, 0.0, 1.0)
    }
    // substrate update
    let mut m_new = state[2]
    let mut phi_new = state[3]
    let mut w_new = state[4]
    let mut cur_new = state[7]
    if event_type == 1 {  // NOVEL
        cur_new = cap(state[7] + 0.2, 0.0, 1.0)
    }
    if event_type == 2 {  // ALERT
        m_new = 1.0
    }
    if event_type == 4 {  // THREAT
        w_new = cap(state[4] + 0.3, 0.0, 2.0)
        cur_new = cap(state[7] - 0.1, 0.0, 1.0)
    }
    let idle_new = state[6] + 1.0
    let mit_new = state[5]

    // AND-gate
    let sm = stage_mod(stage)
    let bio_open = (to_int(refr_new) == 0) && (sm > 0.0)
    let prod = m_new * phi_new * w_new * (to_float(to_int(mit_new) + 1)) * idle_new / 100.0 * cur_new
    let sub_decides = (prod * sm) > threshold
    let mut emit_flag = 0.0
    if bio_open && sub_decides {
        emit_flag = 1.0
        refr_new = to_float(r_steps)  // post-emit refractory
        w_new = 0.0                    // tension reset
    }
    return [refr_new, circ_new, m_new, phi_new, w_new, mit_new, idle_new, cur_new, emit_flag]
}

fn main() {
    println("================================================================")
    println("  H_322 — full anima loop tick 🔵 (event → AND-gate → emit + state)")
    println("================================================================")

    let threshold = 2.0
    // initial state: [refr=0, circ=0.5, M=1, Φ=1, W=1, mit=5, idle=50, cur=1]
    let state0 = [0.0, 0.5, 1.0, 1.0, 1.0, 5.0, 50.0, 1.0]

    // case 1: NONE event, WAKE stage, idle increments only
    let r1 = anima_tick(state0, 0, 0, threshold)
    println("  case 1 NONE: emit=" + str(r1[8]) + " · idle 50→" + str(r1[6]))
    // pressure = 1×1×1×6×0.51×1 = 3.06; 3.06 × 1.0 (WAKE) = 3.06 > 2.0 → emit T
    check("F322.3 ALERT-TRIGGERS-EMIT (or high-all event NONE): emit=1.0", approx(r1[8], 1.0))

    // determinism
    let r2 = anima_tick(state0, 0, 0, threshold)
    check("F322.1 LOOP-DETERMINISTIC: same input → same output", approx(r1[8], r2[8]) && approx(r1[0], r2[0]))

    // case post-emit: refr = R_steps, W = 0
    check("F322.4 POST-EMIT-REFRACTORY: refr_new = 10", approx(r1[0], 10.0))
    check("F322.5 POST-EMIT-W-RESET: W = 0", approx(r1[4], 0.0))

    // case 2: N3 stage → biology veto
    let r3 = anima_tick(state0, 0, 3, threshold)
    println("  case 2 N3: emit=" + str(r3[8]) + " (biology veto by stage_mod=0)")
    check("F322.6 N3-EVENT-NO-EMIT: stage=N3 → emit=0", approx(r3[8], 0.0))

    // case 3: NONE event idle-only on low-state (silence baseline)
    let state_low = [0.0, 0.5, 0.1, 0.1, 0.1, 1.0, 10.0, 0.1]
    let r4 = anima_tick(state_low, 0, 0, threshold)
    println("  case 3 low-state: emit=" + str(r4[8]) + " · idle 10→" + str(r4[6]))
    check("F322.2 NONE-EVENT-INCREMENTS-IDLE: idle += 1 only (no emit)", approx(r4[6], 11.0) && approx(r4[8], 0.0))

    // bound
    let bound_ok = (r1[0] >= 0.0) && (r1[4] >= 0.0) && (r3[0] >= 0.0) && (r4[6] >= 0.0)
    check("F322.7 BOUND: all state vars >= 0", bound_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS >= 6 {
        println("  ✅ FULL ANIMA LOOP TICK CLOSED-FORM — 🔵 SUPPORTED-FORMAL")
        println("    1 tick = event_in → (bio update + sub update) → AND-gate → emit + state_out")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_322 FAIL") }
}
