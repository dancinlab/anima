// ════════════════════════════════════════════════════════════════════════════
//  aggregate.hexa — H_657 phi-free aggregation (dΦ/dI · peak · delta-GZ · verdict)
//
//  Consumes the 5 per-rule Φ(I) tables (phi_rule_<R>.json, measured in separate
//  foreground shards) — embedded verbatim below (byte-identical to the JSON
//  shards). NO big_phi calls → instant. Computes per-rule:
//    dΦ/dI central finite difference, peak I = argmax|dΦ/dI|, delta_gz vs
//    GZ_LOWER, aligned (≤0.05). Then the class-dependence test + verdict.
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

fn _gz_lower() -> float { return 0.21232 }
fn _delta_tol() -> float { return 0.05 }

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}

// returns [peak_I, peak_mag, sign_changes, delta_gz, phi_05, phi_095]
fn analyze(grid: array, phi: array) -> array {
    let m = len(grid)
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }
    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag { peak_mag = mag  peak_idx = q }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta_gz = _abs(peak_I - _gz_lower())
    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }
    return [peak_I, peak_mag, to_float(sign_changes), delta_gz, phi[10], phi[12]]
}

fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) { if i > 0 { s = s + ", " }  s = s + str(xs[i])  i = i + 1 }
    return s + "]"
}
fn json_arr_i(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) { if i > 0 { s = s + ", " }  s = s + str(xs[i])  i = i + 1 }
    return s + "]"
}
fn json_arr_b(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) {
        if i > 0 { s = s + ", " }
        if xs[i] { s = s + "true" } else { s = s + "false" }
        i = i + 1
    }
    return s + "]"
}

fn main() {
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]

    // ── measured Φ(I) tables (byte-identical to phi_rule_<R>.json shards) ──
    let phi_30  = [13.5643, 12.9549, 12.0614, 11.4133, 10.757, 10.3284, 9.91538,
                   8.92056, 7.955, 7.03847, 5.35701, 2.70109, 0.309366]
    let phi_54  = [7.38346, 7.05854, 6.71958, 6.4659, 6.21669, 6.03173, 5.84566,
                   5.3928, 4.88503, 4.54655, 3.25866, 1.64557, 0.176978]
    let phi_90  = [0.0166551, 0.0304822, 0.0414506, 0.0466837, 0.0509403,
                   0.0532553, 0.0551683, 0.058299, 0.0592971, 0.0584703,
                   0.0526069, 0.0319165, 0.00467512]
    let phi_110 = [12.4205, 11.5969, 10.9354, 10.3518, 9.65547, 9.41337, 9.14364,
                   8.45639, 7.65609, 6.78416, 5.27903, 2.49393, 0.250173]
    let phi_184 = [12.2107, 11.6177, 10.943, 10.5176, 10.0934, 9.74001, 9.39291,
                   8.51553, 7.50865, 6.56532, 4.52109, 2.02476, 0.201103]

    let rules = [30, 54, 90, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "III-additive",
                       "IV-complex", "II-particle"]
    let phis = [phi_30, phi_54, phi_90, phi_110, phi_184]

    let mut peak_Is = []
    let mut peak_mags = []
    let mut delta_gzs = []
    let mut aligned_arr = []
    let mut sign_changes_arr = []
    let mut phi_05_arr = []
    let mut phi_095_arr = []

    println("════════════════════════════════════════════════════════════")
    println("H_657 dΦ/dI peak=GZ_LOWER 정렬 · substrate-class 의존성")
    println("  GZ_LOWER = " + str(_gz_lower()) + "   tol = " + str(_delta_tol()))
    println("════════════════════════════════════════════════════════════")

    let mut r = 0
    while r < len(rules) {
        let res = analyze(grid, phis[r])
        let peak_I = res[0]
        let peak_mag = res[1]
        let sg = res[2]
        let delta_gz = res[3]
        let aligned = delta_gz <= _delta_tol()

        peak_Is = peak_Is.push(peak_I)
        peak_mags = peak_mags.push(peak_mag)
        delta_gzs = delta_gzs.push(delta_gz)
        aligned_arr = aligned_arr.push(aligned)
        sign_changes_arr = sign_changes_arr.push(to_int(sg))
        phi_05_arr = phi_05_arr.push(res[4])
        phi_095_arr = phi_095_arr.push(res[5])

        println("rule " + str(rules[r]) + " (" + class_names[r] + ")  peak_I=" + str(peak_I)
                + "  |Δgz|=" + str(delta_gz) + "  aligned=" + str(aligned)
                + "  peak|dΦ/dI|=" + str(peak_mag) + "  sign_chg=" + str(to_int(sg)))
        r = r + 1
    }

    let mut n_aligned = 0
    let mut ai = 0
    while ai < len(aligned_arr) {
        if aligned_arr[ai] { n_aligned = n_aligned + 1 }
        ai = ai + 1
    }
    let rule110_aligned = aligned_arr[3]
    let rule90_aligned  = aligned_arr[2]

    let m1 = rule110_aligned
    let m2 = !rule90_aligned
    let m3 = n_aligned < 5
    let class_invariant = n_aligned == 5
    let class_dependent = (n_aligned < 5) && (!rule90_aligned)

    let mut m1f = 0
    if m1 { m1f = 1 }
    let mut m2f = 0
    if m2 { m2f = 1 }
    let mut m3f = 0
    if m3 { m3f = 1 }

    let supported = m1 && m2 && m3
    let falsified = !m3
    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED-NUMERICAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("── CLASS-DEPENDENCE TEST ──")
    println("  aligned [30,54,90,110,184] = " + json_arr_b(aligned_arr))
    println("  n_aligned (of 5)   = " + str(n_aligned))
    println("  rule110 aligned    = " + str(rule110_aligned))
    println("  rule90  aligned    = " + str(rule90_aligned))
    println("  class_invariant    = " + str(class_invariant))
    println("  class_dependent    = " + str(class_dependent))
    println("  M1 RULE110-ALIGNED      = " + str(m1f))
    println("  M2 RULE90-BREAKS        = " + str(m2f))
    println("  M3 NOT-CLASS-INVARIANT  = " + str(m3f))
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_657\",\n"
    s = s + "  \"slug\": \"dphi-peak-gz-substrate-class-dependence\",\n"
    s = s + "  \"meta_axis\": \"round 9 — Wolfram class as consciousness-structure classifier\",\n"
    s = s + "  \"predecessors\": [\"H_351\", \"H_618\", \"H_642\", \"H_628\"],\n"
    s = s + "  \"rules\": [30, 54, 90, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"III-additive\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"grid\": " + json_arr_f(grid) + ",\n"
    s = s + "  \"phi_30\": " + json_arr_f(phi_30) + ",\n"
    s = s + "  \"phi_54\": " + json_arr_f(phi_54) + ",\n"
    s = s + "  \"phi_90\": " + json_arr_f(phi_90) + ",\n"
    s = s + "  \"phi_110\": " + json_arr_f(phi_110) + ",\n"
    s = s + "  \"phi_184\": " + json_arr_f(phi_184) + ",\n"
    s = s + "  \"peak_I\": " + json_arr_f(peak_Is) + ",\n"
    s = s + "  \"peak_mag\": " + json_arr_f(peak_mags) + ",\n"
    s = s + "  \"delta_gz\": " + json_arr_f(delta_gzs) + ",\n"
    s = s + "  \"aligned\": " + json_arr_b(aligned_arr) + ",\n"
    s = s + "  \"sign_changes\": " + json_arr_i(sign_changes_arr) + ",\n"
    s = s + "  \"phi_at_0_50\": " + json_arr_f(phi_05_arr) + ",\n"
    s = s + "  \"phi_at_0_95\": " + json_arr_f(phi_095_arr) + ",\n"
    s = s + "  \"n_aligned\": " + str(n_aligned) + ",\n"
    s = s + "  \"rule110_aligned\": " + str(rule110_aligned) + ",\n"
    s = s + "  \"rule90_aligned\": " + str(rule90_aligned) + ",\n"
    s = s + "  \"class_invariant\": " + str(class_invariant) + ",\n"
    s = s + "  \"class_dependent\": " + str(class_dependent) + ",\n"
    s = s + "  \"m1_rule110_aligned\": " + str(m1f) + ",\n"
    s = s + "  \"m2_rule90_breaks\": " + str(m2f) + ",\n"
    s = s + "  \"m3_not_class_invariant\": " + str(m3f) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"
    write_file("UNIVERSE/state/h657_dphi_peak_gz_class_2026_05_28/result.json", s)
    println("wrote result.json")
}
