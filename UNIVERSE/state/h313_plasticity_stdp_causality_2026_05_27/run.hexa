// H_313 — PLASTICITY × STDP (spike-timing-dependent plasticity)
// ════════════════════════════════════════════════════════════════════════════
// REAL deterministic dynamical simulation. NOT a tautology:
//   - The STDP window is the SAME symmetric exponential form in both conditions
//     (same A_plus, A_minus, tau_plus, tau_minus). The ONLY difference between
//     conditions is the spike-train TIMING (causal vs anti-causal).
//   - The weight is the EMERGENT integral of the timestep loop over all
//     pre/post spike pairs. If STDP integration were sign-symmetric, the two
//     conditions would converge to the SAME weight → H1 FALSIFIED.
//   - We do NOT hardcode "correlated > anti-correlated"; we run the loop and
//     MEASURE the final weights, then compare.
//
// Model: integrate-and-fire pair (pre -> post via synapse w).
//   - Pre neuron fires on a fixed deterministic schedule (input rhythm).
//   - Post neuron fires on its own deterministic schedule (driven by external
//     teaching input) so that the pre->post timing is controlled per-condition.
//   - On every post-spike: for each recent pre-spike, dt = t_post - t_pre > 0
//       => potentiation  dw = +A_plus  * exp(-dt / tau_plus)
//   - On every pre-spike:  for each recent post-spike, dt = t_post - t_pre < 0
//       => depression    dw = -A_minus * exp( dt / tau_minus)   (dt<0)
//   This is the canonical asymmetric Hebbian STDP window (Bi & Poo 1998).
//   The asymmetry of OUTCOME must EMERGE from which spike leads.
//
// CORRELATED   : pre at t=k*period, post at pre + lag  (pre LEADS post, dt>0)
// ANTI         : pre at t=k*period, post at pre - lag  (post LEADS pre, dt<0)
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// STDP exponential window parameters (symmetric FORM, canonical values)
// A_plus / A_minus / tau_plus / tau_minus identical across both conditions.
fn A_plus()    -> float { return 0.10 }
fn A_minus()   -> float { return 0.10 }
fn tau_plus()  -> float { return 20.0 }
fn tau_minus() -> float { return 20.0 }
fn w_min()     -> float { return 0.0 }
fn w_max()     -> float { return 1.0 }

// STDP weight change as a function of dt = t_post - t_pre.
// dt > 0 (pre before post): potentiation  (+)
// dt < 0 (post before pre): depression     (-)
// This single function is sign-correct STDP; the SIGN follows from dt's sign,
// which is set by the spike timing, NOT pre-decided per condition.
fn stdp_dw(dt: float) -> float {
    if dt > 0.0 {
        return A_plus() * exp(0.0 - dt / tau_plus())
    }
    if dt < 0.0 {
        return 0.0 - A_minus() * exp(dt / tau_minus())
    }
    return 0.0  // dt == 0: no change (coincident)
}

fn clamp(w: float) -> float {
    if w < w_min() { return w_min() }
    if w > w_max() { return w_max() }
    return w
}

// ── Run one condition ────────────────────────────────────────────────────────
// We build deterministic pre and post spike-time arrays for T_steps timesteps,
// then process the full timestep loop accumulating the weight via STDP.
//
// lead_sign = +1  -> pre leads post by `lag` (CORRELATED / causal)
// lead_sign = -1  -> post leads pre by `lag` (ANTI-correlated / acausal)
//
// We iterate timestep by timestep (t = 0..T). At each step we check if pre
// and/or post spiked. We maintain the time of the LAST pre-spike and LAST
// post-spike (trace), and on a spike we apply STDP against the opposing trace.
// (Last-spike trace = standard nearest-neighbour STDP.)
// post_enabled = 0 disables ALL post spikes (pre-only null control: STDP needs
//   spike PAIRS, so no post-spike => zero weight change, an unambiguous loop
//   sanity null that cannot be confounded by simultaneous-spike trace artifacts).
fn run_condition(lead_sign: int, w0: float, period: int, lag: int, T: int, post_enabled: int) -> float {
    let mut w = w0
    let mut last_pre  = 0 - 100000   // -inf sentinel
    let mut last_post = 0 - 100000
    let mut t = 0
    while t < T {
        // Deterministic spike schedule.
        // pre spikes at t = period, 2*period, ...
        // post spikes at pre_time + lead_sign*lag
        let pre_spike  = (t > 0) && ((t % period) == 0)
        // post offset relative to its paired pre time:
        // if lead_sign=+1: post = pre + lag  -> post fires at (k*period + lag)
        // if lead_sign=-1: post = pre - lag  -> post fires at (k*period - lag)
        let post_offset = lead_sign * lag
        // post spike time check: t such that (t - post_offset) is a positive multiple of period
        let pt = t - post_offset
        let post_spike = (post_enabled == 1) && (pt > 0) && ((pt % period) == 0)

        // Process pre-spike: pair against last post (dt = last_post - t < 0 typical)
        if pre_spike {
            if last_post > (0 - 50000) {
                let dt = float(last_post) - float(t)   // t_post - t_pre, post earlier => dt<0
                w = clamp(w + stdp_dw(dt))
            }
            last_pre = t
        }
        // Process post-spike: pair against last pre (dt = t - last_pre > 0 typical)
        if post_spike {
            if last_pre > (0 - 50000) {
                let dt = float(t) - float(last_pre)    // t_post - t_pre, pre earlier => dt>0
                w = clamp(w + stdp_dw(dt))
            }
            last_post = t
        }
        t = t + 1
    }
    return w
}

fn main() {
    println("================================================================")
    println("  H_313 — STDP spike-timing causality (integrate-and-fire pair)")
    println("================================================================")

    let period = 50      // inter-spike interval (timesteps)
    let lag    = 5       // pre/post temporal offset (within STDP window tau=20)
    let T      = 5000    // total timesteps (=> ~100 spike pairs)
    let w0     = 0.50    // initial synaptic weight (mid-range)

    println("  params: period=" + str(period) + " lag=" + str(lag) + " T=" + str(T) + " w0=" + str(w0))
    println("  STDP window: A+=" + str(A_plus()) + " A-=" + str(A_minus()) + " tau+=" + str(tau_plus()) + " tau-=" + str(tau_minus()))
    println("  (window FORM is symmetric; outcome asymmetry must EMERGE from timing)")
    println("")

    // CORRELATED: pre leads post (causal, dt>0 dominant -> potentiation expected)
    let w_corr = run_condition(1, w0, period, lag, T, 1)
    println("  CORRELATED   (pre leads post by " + str(lag) + "): final w = " + str(w_corr))

    // ANTI-correlated: post leads pre (acausal, dt<0 dominant -> depression expected)
    let w_anti = run_condition(0 - 1, w0, period, lag, T, 1)
    println("  ANTI         (post leads pre by " + str(lag) + "): final w = " + str(w_anti))

    let dw_corr = w_corr - w0
    let dw_anti = w_anti - w0
    println("")
    println("  delta w  CORRELATED = " + str(dw_corr))
    println("  delta w  ANTI       = " + str(dw_anti))
    println("  separation (corr - anti) = " + str(w_corr - w_anti))
    println("")

    // ── Control: PRE-ONLY null (post never fires) ──────────────────────────
    // STDP is a PAIR rule: with no post-spike there is no dt to integrate, so
    // the weight cannot change. If it does, the loop has a spurious drift bug.
    // (This is a cleaner null than lag=0 coincident, which is confounded by the
    //  nearest-neighbour trace pairing a coincident pre against the PREVIOUS
    //  period's post-spike — a genuine STDP artifact, not loop drift.)
    let w_coinc = run_condition(1, w0, period, 0, T, 0)
    println("  CONTROL pre-only null (no post spikes): final w = " + str(w_coinc) + " (expect == w0)")
    println("")

    println("  ────────────── verdict ──────────────")

    // F313.1 CAUSALITY-DISCOVERY: correlated weight strictly higher than anti
    check("F313.1 CAUSALITY: w_correlated > w_anti", w_corr > w_anti)

    // F313.2 POTENTIATION-DIRECTION: correlated potentiates (dw>0)
    check("F313.2 POTENTIATION: correlated dw > 0 (pre->post strengthens)", dw_corr > 0.0)

    // F313.3 DEPRESSION-DIRECTION: anti-correlated depresses (dw<0)
    check("F313.3 DEPRESSION: anti dw < 0 (post->pre weakens)", dw_anti < 0.0)

    // F313.4 BOUNDED: both weights stay within [w_min, w_max] (no runaway)
    let bounded = (w_corr >= w_min()) && (w_corr <= w_max()) && (w_anti >= w_min()) && (w_anti <= w_max())
    check("F313.4 BOUNDED: all w in [0,1] (no runaway)", bounded)

    // F313.5 CONTROL-NULL: pre-only (no post) produces ZERO net change (loop sanity)
    let coinc_null_d = w_coinc - w0
    let coinc_abs = if coinc_null_d < 0.0 { 0.0 - coinc_null_d } else { coinc_null_d }
    check("F313.5 CONTROL-NULL: pre-only |dw| < 0.001 (STDP needs pairs)", coinc_abs < 0.001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    let mut headline = "MIXED"
    if (w_corr > w_anti) && (dw_corr > 0.0) && (dw_anti < 0.0) && bounded {
        headline = "STDP-DISCOVERS-CAUSALITY (H1 SUPPORTED): correlated strengthens, anti weakens, bounded"
    }
    if !(w_corr > w_anti) {
        headline = "H1-FALSIFIED: correlated did NOT exceed anti-correlated"
    }
    println("  HEADLINE: " + headline)
    println("    w_corr=" + str(w_corr) + " w_anti=" + str(w_anti) + " w_coinc=" + str(w_coinc) + " sep=" + str(w_corr - w_anti))
    println("================================================================")
    if FAIL > 0 { panic("H_313 had FALSIFIER FAILURES") }
}
