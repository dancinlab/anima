// H_310 — anima_dream_stage 5-state (WAKE/N1/N2/N3/REM) × emit gating
// 180-tick ultradian, 5 cycles in 1000 ticks
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// stage scheduler: 180-tick ultradian
// returns [stage_id, m_motivation, circadian]
//   0=WAKE  (M=1.0, circ=1.0)  ticks 0..30   of cycle
//   1=N1    (M=0.7, circ=0.7)  ticks 30..60
//   2=N2    (M=0.4, circ=0.4)  ticks 60..90
//   3=N3    (M=0.0, circ=0.0)  ticks 90..150
//   4=REM   (M=0.5, circ=0.5)  ticks 150..180
fn stage_of(tick: int) -> array {
    let cyc = tick % 180
    if cyc < 30  { return [0.0, 1.0, 1.0] }
    if cyc < 60  { return [1.0, 0.7, 0.7] }
    if cyc < 90  { return [2.0, 0.4, 0.4] }
    if cyc < 150 { return [3.0, 0.0, 0.0] }
    return [4.0, 0.5, 0.5]
}

fn main() {
    println("================================================================")
    println("  H_310 — 5-stage WAKE/N1/N2/N3/REM ultradian × emit gating")
    println("  1000 ticks, 180-tick ultradian (~5.5 cycles)")
    println("================================================================")

    let n_ticks = 1000
    let threshold = 0.5
    let w_target = 1.0
    let k_recharge = 0.3
    let r_steps = 10
    let phi_int = 1.0

    let mut w_tension = w_target
    let mut refractory_remaining = 0

    // per-stage emit counters
    let mut emit_wake = 0
    let mut emit_n1 = 0
    let mut emit_n2 = 0
    let mut emit_n3 = 0
    let mut emit_rem = 0

    // sub-window emit detection (WAKE peak count per cycle)
    let mut wake_peaks_seen = 0
    let mut last_wake_cycle = -1

    let mut tick = 0
    while tick < n_ticks {
        let st = stage_of(tick)
        let stage_id = to_int(st[0])
        let m = st[1]
        let circ = st[2]

        if refractory_remaining > 0 {
            refractory_remaining = refractory_remaining - 1
            w_tension = w_tension + k_recharge * (w_target - w_tension)
            if w_tension < 0.0 { w_tension = 0.0 }
        } else {
            let pressure = m * phi_int * w_tension * circ
            if pressure > threshold {
                if stage_id == 0 { emit_wake = emit_wake + 1 }
                if stage_id == 1 { emit_n1   = emit_n1   + 1 }
                if stage_id == 2 { emit_n2   = emit_n2   + 1 }
                if stage_id == 3 { emit_n3   = emit_n3   + 1 }
                if stage_id == 4 { emit_rem  = emit_rem  + 1 }
                let cur_cycle = tick / 180
                if (stage_id == 0) && (cur_cycle != last_wake_cycle) {
                    wake_peaks_seen = wake_peaks_seen + 1
                    last_wake_cycle = cur_cycle
                }
                w_tension = 0.0
                refractory_remaining = r_steps
            } else {
                w_tension = w_tension + 0.05 * (w_target - w_tension)
            }
        }
        tick = tick + 1
    }

    println("  per-stage emit counts:")
    println("    WAKE : " + str(emit_wake))
    println("    N1   : " + str(emit_n1))
    println("    N2   : " + str(emit_n2))
    println("    N3   : " + str(emit_n3))
    println("    REM  : " + str(emit_rem))
    println("  WAKE peak sub-windows seen: " + str(wake_peaks_seen) + "/6 (1000/180 ≈ 5.5)")
    println("  ────────────── verdict ──────────────")

    // ── F310.1 STAGE-EMIT-HETEROGENEOUS ─────────────────────────────────
    let stages = [emit_wake, emit_n1, emit_n2, emit_n3, emit_rem]
    let mut distinct = 0
    let mut i = 0
    while i < 5 {
        let v = stages[i]
        let mut seen = false
        let mut j = 0
        while j < i {
            if stages[j] == v { seen = true }
            j = j + 1
        }
        if !seen { distinct = distinct + 1 }
        i = i + 1
    }
    println("    distinct stage emit values: " + str(distinct))
    check("F310.1 STAGE-EMIT-HETEROGENEOUS: distinct >= 3", distinct >= 3)

    // ── F310.2 WAKE-DOMINANT ────────────────────────────────────────────
    let wake_dominant = (emit_wake > emit_n1) && (emit_wake > emit_n2) && (emit_wake > emit_n3) && (emit_wake > emit_rem)
    check("F310.2 WAKE-DOMINANT: WAKE > all other stages", wake_dominant)

    // ── F310.3 N3-NEAR-ZERO ─────────────────────────────────────────────
    check("F310.3 N3-NEAR-ZERO: N3 emit <= 1", emit_n3 <= 1)

    // ── F310.4 REM-MID-SPARSE ───────────────────────────────────────────
    let rem_mid = (emit_rem > emit_n3) && (emit_rem * 3 <= emit_wake)
    check("F310.4 REM-MID-SPARSE: REM > N3 AND REM <= WAKE/3", rem_mid)

    // ── F310.5 ULTRADIAN-CYCLE-COUNT ────────────────────────────────────
    check("F310.5 ULTRADIAN-CYCLE-COUNT: WAKE peaks in 5-6 sub-windows", (wake_peaks_seen >= 5) && (wake_peaks_seen <= 6))

    // ── F310.6 BOUND ────────────────────────────────────────────────────
    check("F310.6 BOUND: all stage counts >= 0", (emit_wake >= 0) && (emit_n1 >= 0) && (emit_n2 >= 0) && (emit_n3 >= 0) && (emit_rem >= 0))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  HEADLINE: 5-stage emit profile WAKE=" + str(emit_wake) + " N1=" + str(emit_n1) + " N2=" + str(emit_n2) + " N3=" + str(emit_n3) + " REM=" + str(emit_rem))
    println("================================================================")
    if FAIL > 0 { panic("H_310 had FALSIFIER FAILURES") }
}
