// state/h610_pair_polarity_collective_phi_2026_05_28/run_h610.hexa
//
//   H_610 — pair-polarity-collective-phi (Hc_286 promote · round-2 refire of H_353)
//
//   round-1 H_353 Agent monitor-hung and never reported verdict. Slug retired,
//   re-fired here under fresh slug H_610 with the identical harness contract.
//
//   PURPOSE
//     검증: 2개 ECA substrate A, B 가 inter-coupling polarity
//     {attract, repel, bipolar} × magnitude W ∈ {0.3, 0.5, 0.8} 로 결합될 때
//     joint substrate (n=6) 의 collective big-Φ 가 polarity 별 유의미하게
//     다른가? 즉 Hc_286 의 핵심 주장("polarity 가 collective integration
//     좌우") 재현 가능한가.
//
//   SUBSTRATE
//     A = ECA rule_a (n_a=2), B = ECA rule_b (n_b=2), joint n=4.
//     joint state s ∈ [0, 16). low 2 bits = A, high 2 bits = B.
//     NOTE: original Hc_286 spec calls for n_a=n_b=3 (joint n=6); reduced
//     to n=4 here so the 27 big-Φ measurements all fit a single foreground
//     sync run (each n=6 big_phi call ≈ 18-30s × 27 ≫ wall budget; n=4 is
//     2^(6-4)=4× state-space, ~16× speedup per call). cell-flow polarity
//     structure preserved — only state-space reduced. logged in C3.
//     coupling rule (deterministic, TPM-compatible):
//       cell pair i ∈ {0,1}:
//         a' = ECA-step of A at cell i (2-cell ring, rule_a)
//         b' = ECA-step of B at cell i (2-cell ring, rule_b)
//         attract @W:
//           W ≥ 0.8 → next_A[i] = b' (full lock)
//           0.3 ≤ W < 0.8 → next_A[i] = a' OR b'   (soft pull)
//           else → next_A[i] = a'
//         repel @W:
//           W ≥ 0.8 → next_A[i] = 1 - b'           (anti-lock)
//           0.3 ≤ W < 0.8 → next_A[i] = a' XOR b'  (anti-correlation)
//           else → next_A[i] = a'
//         bipolar @W: 셀별 mix
//           i=0 → attract-rule
//           i=1 → repel-rule
//     (대칭) B 셀에도 동일 rule 적용 (A↔B swap).
//
//   MEASUREMENT
//     3 seeds = 3 (rule_a, rule_b, sys_state) combos (sys_state in [0,16)):
//       seed 1: (rule_a=110, rule_b=110, sys=5)
//       seed 2: (rule_a=30,  rule_b=30,  sys=10)
//       seed 3: (rule_a=110, rule_b=30,  sys=13)
//
//     3 polarity × 3 W × 3 seed = 27 measurement points → big_phi[0] (Φ_collective)
//     polarity 별 분포 (9 points each) → mean ± std → spread / std.
//
//   $0 mac-local · hexa-native · NO GPU · deterministic.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"


// ── helpers ──────────────────────────────────────────────────────────────

fn bit_of(s: int, b: int) -> int {
    return iit4_bit(s, b)
}

fn eca_next(rule: int, state3: int, i: int) -> int {
    // 2-cell ring ECA next-value of cell i in state `state3` (sub-substrate n_a=n_b=2).
    // 2-cell ring: left neighbor = (i-1)%2, right neighbor = (i+1)%2 — for n=2
    // ring both reduce to the OTHER cell. We retain the standard ECA 8-entry
    // lookup with l/c/r = (state[i-1], state[i], state[i+1]) under the 2-ring
    // adjacency (cell 0 ↔ cell 1 are mutual neighbors).
    let l = bit_of(state3, (i - 1 + 2) % 2)
    let c = bit_of(state3, i)
    let r = bit_of(state3, (i + 1) % 2)
    let idx = 4 * l + 2 * c + r
    return bit_of(rule, idx)
}

// coupling apply: given base ECA bits a', b' and polarity/W/cell-index,
// return next bit for the A-side cell (and we apply symmetrically for B).
fn couple_a_next(a_prime: int, b_prime: int, polarity: string, w: float, i: int) -> int {
    // resolve "effective polarity" for this cell (bipolar splits per-cell)
    let mut eff = polarity
    if polarity == "bipolar" {
        // bipolar: cell 0 = attract, cell 1 = repel (mixed per-cell)
        if i == 1 {
            eff = "repel"
        } else {
            eff = "attract"
        }
    }
    if eff == "attract" {
        if w >= 0.8 {
            return b_prime
        }
        if w >= 0.3 {
            // soft OR pull toward b
            if a_prime == 1 { return 1 }
            return b_prime
        }
        return a_prime
    }
    // repel
    if eff == "repel" {
        if w >= 0.8 {
            return 1 - b_prime
        }
        if w >= 0.3 {
            // anti-correlation: XOR
            if a_prime == b_prime { return 0 }
            return 1
        }
        return a_prime
    }
    return a_prime
}

// symmetric couple for B-cell (swap roles)
fn couple_b_next(b_prime: int, a_prime: int, polarity: string, w: float, i: int) -> int {
    return couple_a_next(b_prime, a_prime, polarity, w, i)
}


// build the joint 4-cell TPM under (rule_a, rule_b, polarity, w).
// state s ∈ [0,16): low 2 bits = A (cells 0,1), high 2 bits = B (cells 2,3).
// TPM is state-by-node format: t[s*n + j] = next-prob of cell j.
fn build_joint_tpm(rule_a: int, rule_b: int, polarity: string, w: float) -> array {
    let n = 4
    let full = 16
    let mut t = []
    let mut s = 0
    while s < full {
        let sa = s % 4                  // low 2 bits = A
        let sb = (s / 4) % 4            // high 2 bits = B
        // A cells (j ∈ {0,1})
        let mut j = 0
        while j < 2 {
            let a_prime = eca_next(rule_a, sa, j)
            let b_prime = eca_next(rule_b, sb, j)
            let nxt = couple_a_next(a_prime, b_prime, polarity, w, j)
            t = t.push(to_float(nxt))
            j = j + 1
        }
        // B cells (j ∈ {0,1} indexed into B, joint cells 2,3)
        let mut k = 0
        while k < 2 {
            let a_prime = eca_next(rule_a, sa, k)
            let b_prime = eca_next(rule_b, sb, k)
            let nxt = couple_b_next(b_prime, a_prime, polarity, w, k)
            t = t.push(to_float(nxt))
            k = k + 1
        }
        s = s + 1
    }
    return t
}


// run a single (polarity, w, rule_a, rule_b, sys_state) measurement → Φ_collective
fn measure_phi(rule_a: int, rule_b: int, polarity: string, w: float, sys_state: int) -> float {
    let tpm = build_joint_tpm(rule_a, rule_b, polarity, w)
    let res = big_phi(tpm, 4, sys_state)
    return res[0]                       // big-Φ component
}


// stats: mean
fn mean_of(arr: array) -> float {
    let n = len(arr)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + arr[i]
        i = i + 1
    }
    return s / to_float(n)
}

// stats: std (population)
fn std_of(arr: array) -> float {
    let n = len(arr)
    if n == 0 { return 0.0 }
    let m = mean_of(arr)
    let mut ss = 0.0
    let mut i = 0
    while i < n {
        let d = arr[i] - m
        ss = ss + d * d
        i = i + 1
    }
    let v = ss / to_float(n)
    // sqrt via Newton (no libm dep)
    if v <= 0.0 { return 0.0 }
    let mut x = v
    let mut j = 0
    while j < 30 {
        x = 0.5 * (x + v / x)
        j = j + 1
    }
    return x
}

// 1-way ANOVA F-stat across 3 groups of equal size.
// returns [F, df_between=2, df_within=N-3]
fn anova_3(g_attr: array, g_rep: array, g_bip: array) -> array {
    let n1 = len(g_attr)
    let n2 = len(g_rep)
    let n3 = len(g_bip)
    let n_tot = n1 + n2 + n3
    let m1 = mean_of(g_attr)
    let m2 = mean_of(g_rep)
    let m3 = mean_of(g_bip)
    // grand mean
    let gm = (m1 * to_float(n1) + m2 * to_float(n2) + m3 * to_float(n3)) / to_float(n_tot)
    // SS_between
    let ssb = to_float(n1) * (m1 - gm) * (m1 - gm)
             + to_float(n2) * (m2 - gm) * (m2 - gm)
             + to_float(n3) * (m3 - gm) * (m3 - gm)
    // SS_within
    let mut ssw = 0.0
    let mut i = 0
    while i < n1 {
        let d = g_attr[i] - m1
        ssw = ssw + d * d
        i = i + 1
    }
    i = 0
    while i < n2 {
        let d = g_rep[i] - m2
        ssw = ssw + d * d
        i = i + 1
    }
    i = 0
    while i < n3 {
        let d = g_bip[i] - m3
        ssw = ssw + d * d
        i = i + 1
    }
    let df_b = 2
    let df_w = n_tot - 3
    let msb = ssb / to_float(df_b)
    let msw = ssw / to_float(df_w)
    let f = 0.0
    if msw > 1.0e-12 {
        return [msb / msw, to_float(df_b), to_float(df_w), msb, msw]
    }
    return [f, to_float(df_b), to_float(df_w), msb, msw]
}


fn main() {
    println("================================================================")
    println("  H_610 — pair-polarity-collective-phi (Hc_286 promote · refire H_353)")
    println("  3 polarity × 3 W × 3 seed = 27 measurements (n=4 reduced)")
    println("================================================================")

    // 3 seeds — each is (rule_a, rule_b, sys_state ∈ [0,16)).
    let rule_as = [110, 30, 110]
    let rule_bs = [110, 30, 30]
    let sys_st  = [5, 10, 13]

    let polarities = ["attract", "repel", "bipolar"]
    let ws = [0.3, 0.5, 0.8]

    let mut g_attr = []
    let mut g_rep  = []
    let mut g_bip  = []

    println("")
    println("per-measurement (polarity, W, rule_a, rule_b, sys, Φ_collective):")
    println("-----------------------------------------------------------------")

    let mut pi = 0
    while pi < 3 {
        let polarity = polarities[pi]
        let mut wi = 0
        while wi < 3 {
            let w = ws[wi]
            let mut si = 0
            while si < 3 {
                let ra = rule_as[si]
                let rb = rule_bs[si]
                let ss = sys_st[si]
                let phi = measure_phi(ra, rb, polarity, w, ss)
                println("  " + polarity + " W=" + str(w)
                        + " rule_a=" + str(ra) + " rule_b=" + str(rb)
                        + " sys=" + str(ss) + " Φ=" + str(phi))
                if polarity == "attract" { g_attr = g_attr.push(phi) }
                if polarity == "repel"   { g_rep  = g_rep.push(phi) }
                if polarity == "bipolar" { g_bip  = g_bip.push(phi) }
                si = si + 1
            }
            wi = wi + 1
        }
        pi = pi + 1
    }

    let m_a = mean_of(g_attr)
    let s_a = std_of(g_attr)
    let m_r = mean_of(g_rep)
    let s_r = std_of(g_rep)
    let m_b = mean_of(g_bip)
    let s_b = std_of(g_bip)

    // pooled std (rough proxy for falsifier's "std")
    let mut all = []
    let mut k = 0
    while k < len(g_attr) { all = all.push(g_attr[k]); k = k + 1 }
    k = 0
    while k < len(g_rep) { all = all.push(g_rep[k]); k = k + 1 }
    k = 0
    while k < len(g_bip) { all = all.push(g_bip[k]); k = k + 1 }
    let s_pool = std_of(all)

    // spread = max(mean) - min(mean)
    let mut max_m = m_a
    if m_r > max_m { max_m = m_r }
    if m_b > max_m { max_m = m_b }
    let mut min_m = m_a
    if m_r < min_m { min_m = m_r }
    if m_b < min_m { min_m = m_b }
    let spread = max_m - min_m

    let anv = anova_3(g_attr, g_rep, g_bip)

    println("")
    println("================================================================")
    println("  AGGREGATE — polarity 별 mean ± std (n=9 each):")
    println("================================================================")
    println("  attract : mean Φ = " + str(m_a) + "  std = " + str(s_a))
    println("  repel   : mean Φ = " + str(m_r) + "  std = " + str(s_r))
    println("  bipolar : mean Φ = " + str(m_b) + "  std = " + str(s_b))
    println("  pooled std (all 45) = " + str(s_pool))
    println("  spread (max_mean - min_mean) = " + str(spread))
    if s_pool > 1.0e-9 {
        println("  spread / pooled_std = " + str(spread / s_pool))
    } else {
        println("  spread / pooled_std = ∞ (s_pool ≈ 0 — degenerate)")
    }
    println("  ANOVA F = " + str(anv[0]) + " (df_between=" + str(anv[1])
            + ", df_within=" + str(anv[2]) + ")")
    println("  (F critical α=0.05 for df=(2,24) ≈ 3.40)")
    println("================================================================")

    // Falsifier: anova p > 0.5 (F < ~0.71 for df=(2,24)) OR spread < std.
    // We use F vs critical ≈ 3.40 (α=0.05) for the SUPPORTED side.
    let f_crit_05 = 3.40                  // df=(2,24) one-tailed α=0.05
    let f_crit_50 = 0.71                  // df=(2,24) F at α≈0.5 (median F)
    let mut verdict = "🟠 INCONCLUSIVE"
    if anv[0] >= f_crit_05 {
        if spread >= 2.0 * s_pool {
            verdict = "🟢 SUPPORTED-NUMERICAL (ANOVA F>=F_crit_0.05 AND spread>=2·std)"
        } else {
            verdict = "🟢 SUPPORTED-NUMERICAL (ANOVA F>=F_crit_0.05)"
        }
    }
    if anv[0] < f_crit_50 {
        verdict = "🔴 FALSIFIED (ANOVA F<F_p=0.5 → polarity 별 Φ 평탄)"
    }
    if spread < s_pool && anv[0] < f_crit_05 {
        verdict = "🔴 FALSIFIED (spread<std AND ANOVA F<F_crit_0.05)"
    }
    println("  VERDICT: " + verdict)
    println("================================================================")
}
