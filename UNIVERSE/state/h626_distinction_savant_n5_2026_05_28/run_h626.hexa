// ════════════════════════════════════════════════════════════════════════════
//  run_h626.hexa — H_626 distinction × SAVANT isomorphism, n=5 generalization
//
//  axis C (full-IIT4 cause-effect structure) · C2 follow-up (H_624 후속).
//
//  PREDECESSOR
//    H_624 (PR #1198, 🟢 SUPPORTED 5/5, Spearman ρ=0.861, n=4 exact-match):
//    SAVANT 4-domain cell {CALENDAR, MUSIC, ART, MEMORY} 의 internal Φ 와 IIT4
//    distinction 의 singleton small-φ 가 cell-by-cell 동형. honest C3.2 =
//    "n=4 exact-match 차원 한정, n≥5 dimensionality mismatch (4 cell vs n+1
//    distinctions) 후속". 본 H_626 이 그 회수.
//
//  HYPOTHESIS (H1)
//    n=5 substrate 에서 SAVANT cell (4-domain, 불변) 과 IIT4 singleton
//    distinction (5 개) 의 *차원 불일치* 에도 불구하고:
//      top-4 distinction (small-φ 큰 순) ordering 이 SAVANT 4-cell ordering 과
//      정렬 — Spearman ρ(top4_dist_phi, savant_cell_phi) > 0.5.
//    pooled over 4 non-balanced gain profiles × 4 cells = N=16 paired samples.
//
//  FALSIFIER (H0)
//    ρ < 0.5 (차원 불일치가 동형 깨뜨림) — H_624 의 ρ=0.86 이 n=4 exact-match
//    artifact 였음. n=5 의 5번째 distinction 이 top-4 truncation 을 교란하면
//    SAVANT 4-cell 과 IIT4 distinction 이 *다른 기저*.
//
//  SUBSTRATE (n=5 ring, H_624 의 n=4 를 1 cell 확장)
//    5-cell binary TPM `tpm[s,i]`, gain-parameterized:
//      sig_i = g_i / (1.0 + g_i)                  (gain → signal-strength)
//      struct_next[s,i] = MAJ(self, left, right)  (ring; self-effect 보존)
//      p_next[s,i] = sig_i * struct_next + (1-sig_i) * 0.5
//    H_624 와 동일 mechanism, n=4 → n=5 만 확장.
//
//  SAVANT SIDE (4-domain, 불변 — savant_phi 구조 한정)
//    cell_phi[k] = phi_module(build_domain_activation(k, d=6, g_k, stim)),  k∈[0,4)
//    phi_module(v) = mean |v[j]|^1.5  (super-linear energy proxy).
//    gain g_k = 5-vector 의 처음 4 성분 (cell 4 = ring-closure 보조 cell).
//
//  IIT4 SIDE (n=5 → 5 singleton distinctions)
//    dist_phi[i] = mean_{s=0..31} distinction(tpm, 5, 1<<i, s)[0],  i∈[0,5)
//    top-4 by dist_phi (descending) → 4 개 추출 → SAVANT 4-cell 과 paired.
//
//  PROFILES (4 non-balanced single-hypertrophy; balanced 제외 — H_624 C3.3
//  degeneracy 교훈, argmax/ordering 검정은 non-symmetric 에서만 유효)
//      P1 CALENDAR-DOM  = (10.0, 0.5,  0.5,  0.5,  2.875)
//      P2 MUSIC-DOM     = (0.5,  10.0, 0.5,  0.5,  2.875)
//      P3 ART-DOM       = (0.5,  0.5,  10.0, 0.5,  2.875)
//      P4 MEMORY-DOM    = (0.5,  0.5,  0.5,  10.0, 2.875)
//    cell 4 (보조) 은 모든 profile 에서 balanced gain (2.875) — ring closure.
//    각 profile 4 paired sample (SAVANT cell 0..3 ↔ top-4 dist).
//    Total N = 4 × 4 = 16 paired samples.
//
//  SHARDING
//    SHARD = -1  → 모든 profile (timing 우려 시 per-profile 분할)
//    SHARD ∈ [0,4) → 단일 profile 만 측정·출력 (foreground 60s 안전)
//
//  CRITERIA
//    F1  ISOMORPH-WEAK    : Spearman ρ ≥ 0.5  (본 H 의 주 falsifier)
//    F2  ISOMORPH-STRONG  : Spearman ρ ≥ 0.7
//    F3  PEARSON-CONSIST  : Pearson r  ≥ 0.5
//    F4  PER-PROFILE-RANK : per-profile argmax(savant_cell)==argmax(top4_dist) 4/4
//    F5  BYTE-EQUAL       : in-process recompute byte-identical
//
//    SUPPORTED  = F1 ∧ F3 ∧ F4 ∧ F5  (+ F2 → STRONG note)
//    PARTIAL    = F1 ∧ F5  (정렬 약하게 존재)
//    FALSIFIED  = ¬F1  (ρ < 0.5)
//
//  $0 · mac-local · hexa-only · deterministic · NO ckpt.
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4_distinction.hexa"

// SHARD selector: -1 = all profiles in one run; 0..3 = single profile.
let SHARD = -1


// ── SAVANT primitives (inline, h350/h624-style — single-file verify) ───────
let SV_D = 6
let SV_N_DOM = 4

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

// SAVANT side stays 4-domain (불변). gain g_k from the first 4 components.
fn savant_cell_phi4(g0: float, g1: float, g2: float, g3: float, stim_seed: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let v = build_domain_activation(k, SV_D, g, stim_seed)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}


// ── Substrate TPM — n=5 ring, MAJ(self,left,right), gain noise mix ──────────
fn _bit(s: int, i: int) -> int {
    if iit4_bit(s, i) == 1 { return 1 }
    return 0
}

// majority of (self, left, right) on n=5 ring (self-effect 보존, H_624 §7 C3.1)
fn struct_next5(s: int, i: int) -> int {
    let n = 5
    let mut left_i = i - 1
    if left_i < 0 { left_i = n - 1 }
    let mut right_i = i + 1
    if right_i >= n { right_i = 0 }
    let bs = _bit(s, i)
    let bl = _bit(s, left_i)
    let br = _bit(s, right_i)
    let total = bs + bl + br
    if total >= 2 { return 1 }
    return 0
}

fn gain_of(i: int, g0: float, g1: float, g2: float, g3: float, g4: float) -> float {
    if i == 0 { return g0 }
    if i == 1 { return g1 }
    if i == 2 { return g2 }
    if i == 3 { return g3 }
    return g4
}

fn build_tpm5(g0: float, g1: float, g2: float, g3: float, g4: float) -> array {
    let n = 5
    let full = 32
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let g = gain_of(i, g0, g1, g2, g3, g4)
            let sig = g / (1.0 + g)
            let sn = struct_next5(s, i)
            let p = sig * to_float(sn) + (1.0 - sig) * 0.5
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}


// ── per-cell singleton-distinction φ, mean over 32 sys_states (n=5, 5 cells) ─
fn cell_distinction_phi_vector5(tpm: array) -> array {
    let n = 5
    let full = 32
    let mut out = []
    let mut i = 0
    while i < n {
        let mask = iit4_pow2(i)
        let mut sum_phi = 0.0
        let mut cnt = 0
        let mut s = 0
        while s < full {
            let d = distinction(tpm, n, mask, s)
            sum_phi = sum_phi + d[0]
            cnt = cnt + 1
            s = s + 1
        }
        out = out.push(sum_phi / to_float(cnt))
        i = i + 1
    }
    return out
}


// ── top-K extraction: return indices of the K largest values (descending) ──
fn topk_indices(v: array, k: int) -> array {
    let n = len(v)
    let mut used = []
    let mut u = 0
    while u < n { used = used.push(0); u = u + 1 }
    let mut idxs = []
    let mut picked = 0
    while picked < k {
        let mut best = -1
        let mut bestv = 0.0 - 1.0e308
        let mut j = 0
        while j < n {
            if used[j] == 0 {
                if v[j] > bestv { bestv = v[j]; best = j }
            }
            j = j + 1
        }
        used = used.set(best, 1)
        idxs = idxs.push(best)
        picked = picked + 1
    }
    return idxs
}


// ── inline Spearman / Pearson (H_624 동일) ─────────────────────────────────
fn _array_rank(v: array, idx: int) -> float {
    let n = len(v)
    let me = v[idx]
    let mut less = 0
    let mut eq = 0
    let mut k = 0
    while k < n {
        if v[k] < me { less = less + 1 }
        if v[k] == me { eq = eq + 1 }
        k = k + 1
    }
    return to_float(less + 1) + to_float(eq - 1) / 2.0
}

fn pearson_arr(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + xs[i]
        sy = sy + ys[i]
        i = i + 1
    }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n {
        let dx = xs[j] - mx
        let dy = ys[j] - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom2 = dx2 * dy2
    if denom2 <= 0.0 { return 0.0 }
    let mut r = denom2
    let mut m = 0
    while m < 16 {
        if r > 0.0 { r = (r + denom2 / r) / 2.0 }
        m = m + 1
    }
    if r <= 0.0 { return 0.0 }
    return num / r
}

fn spearman_arr(xs: array, ys: array) -> float {
    let n = len(xs)
    let mut rx = []
    let mut ry = []
    let mut k = 0
    while k < n {
        rx = rx.push(_array_rank(xs, k))
        ry = ry.push(_array_rank(ys, k))
        k = k + 1
    }
    return pearson_arr(rx, ry)
}


fn fmtN(v: array) -> string {
    let n = len(v)
    let mut s = "["
    let mut i = 0
    while i < n {
        s = s + str(v[i])
        if i < n - 1 { s = s + ", " }
        i = i + 1
    }
    return s + "]"
}

fn argmax4(v: array) -> int {
    let mut bi = 0
    let mut bv = v[0]
    let mut i = 1
    while i < 4 {
        if v[i] > bv { bv = v[i]; bi = i }
        i = i + 1
    }
    return bi
}


// ── per-profile measurement → flat array ───────────────────────────────────
//   layout: [c0..c3, d0..d4, t0..t3, top_idx0..top_idx3]
fn measure_profile5(g0: float, g1: float, g2: float, g3: float, g4: float, stim_seed: int) -> array {
    let cellv = savant_cell_phi4(g0, g1, g2, g3, stim_seed)
    let tpm = build_tpm5(g0, g1, g2, g3, g4)
    let distv = cell_distinction_phi_vector5(tpm)   // length 5
    let top = topk_indices(distv, 4)                // indices of top-4 dist
    let mut out = []
    out = out.push(cellv[0]); out = out.push(cellv[1]); out = out.push(cellv[2]); out = out.push(cellv[3])
    out = out.push(distv[0]); out = out.push(distv[1]); out = out.push(distv[2]); out = out.push(distv[3]); out = out.push(distv[4])
    // top-4 dist phi values (descending)
    out = out.push(distv[top[0]]); out = out.push(distv[top[1]]); out = out.push(distv[top[2]]); out = out.push(distv[top[3]])
    // top-4 indices
    out = out.push(to_float(top[0])); out = out.push(to_float(top[1])); out = out.push(to_float(top[2])); out = out.push(to_float(top[3]))
    return out
}


fn main() {
    println("[H_626] distinction × SAVANT isomorphism — n=5 generalization (axis C2 follow-up)")
    println("  predecessor: H_624 (n=4 exact-match, ρ=0.861) — 본 H 는 n=5 dimensionality-mismatch 검정")
    println("  substrate: 5-cell ring, MAJ(self,L,R) + gain noise mix")
    println("  IIT4: 5 singleton distinctions → top-4 by small-φ → SAVANT 4-cell 과 paired")
    println("  N=16 paired samples (4 non-balanced profiles × 4 cells)")
    println("")

    let stim = 42424

    let mut g0s = []; let mut g1s = []; let mut g2s = []; let mut g3s = []; let mut g4s = []; let mut names = []
    g0s = g0s.push(10.0); g1s = g1s.push(0.5);  g2s = g2s.push(0.5);  g3s = g3s.push(0.5);  g4s = g4s.push(2.875); names = names.push("P1_CALENDAR_DOM")
    g0s = g0s.push(0.5);  g1s = g1s.push(10.0); g2s = g2s.push(0.5);  g3s = g3s.push(0.5);  g4s = g4s.push(2.875); names = names.push("P2_MUSIC_DOM")
    g0s = g0s.push(0.5);  g1s = g1s.push(0.5);  g2s = g2s.push(10.0); g3s = g3s.push(0.5);  g4s = g4s.push(2.875); names = names.push("P3_ART_DOM")
    g0s = g0s.push(0.5);  g1s = g1s.push(0.5);  g2s = g2s.push(0.5);  g3s = g3s.push(10.0); g4s = g4s.push(2.875); names = names.push("P4_MEMORY_DOM")

    let mut cell_pool = []
    let mut dist_pool = []
    let mut argmax_match = 0
    let mut argmax_total = 0

    let mut p = 0
    while p < 4 {
        let run_this = if SHARD < 0 { true } else { p == SHARD }
        if run_this {
            let g0 = g0s[p]; let g1 = g1s[p]; let g2 = g2s[p]; let g3 = g3s[p]; let g4 = g4s[p]
            let nm = names[p]
            let r = measure_profile5(g0, g1, g2, g3, g4, stim)
            let cellv = [r[0], r[1], r[2], r[3]]
            let distv = [r[4], r[5], r[6], r[7], r[8]]
            let top4v = [r[9], r[10], r[11], r[12]]
            let top4i = [r[13], r[14], r[15], r[16]]

            println("[profile " + str(p) + " " + nm + "]")
            println("  gains      = [" + str(g0) + ", " + str(g1) + ", " + str(g2) + ", " + str(g3) + ", " + str(g4) + "]")
            println("  cell_phi   = " + fmtN(cellv) + "   (SAVANT 4-domain)")
            println("  dist_phi5  = " + fmtN(distv) + "   (IIT4 5 singleton distinctions)")
            println("  top4_idx   = " + fmtN(top4i))
            println("  top4_phi   = " + fmtN(top4v))
            println("  argmax_cell=" + str(argmax4(cellv)) + " argmax_top4=" + str(argmax4(top4v)))

            argmax_total = argmax_total + 1
            if argmax4(cellv) == argmax4(top4v) { argmax_match = argmax_match + 1 }

            let mut i = 0
            while i < 4 {
                cell_pool = cell_pool.push(cellv[i])
                dist_pool = dist_pool.push(top4v[i])
                i = i + 1
            }
        }
        p = p + 1
    }

    println("")
    println("[pool] N=" + str(len(cell_pool)) + " paired samples (SAVANT cell ↔ top-4 dist)")

    if len(cell_pool) < 2 {
        println("[shard " + str(SHARD) + "] single-profile shard — aggregate ρ는 merged run 에서.")
        return
    }

    let rho = spearman_arr(cell_pool, dist_pool)
    let r_p = pearson_arr(cell_pool, dist_pool)

    println("  Spearman ρ = " + str(rho))
    println("  Pearson  r = " + str(r_p))
    println("  argmax-match = " + str(argmax_match) + "/" + str(argmax_total))

    let rho2 = spearman_arr(cell_pool, dist_pool)
    let r2 = pearson_arr(cell_pool, dist_pool)
    let mut byte_eq = true
    if rho2 != rho { byte_eq = false }
    if r2 != r_p { byte_eq = false }
    println("  byte_eq    = " + str(byte_eq))
    println("")

    let f1 = rho >= 0.5
    let f2 = rho >= 0.7
    let f3 = r_p >= 0.5
    let f4 = argmax_match == argmax_total
    let f5 = byte_eq

    if f1 { println("F1 PASS — Spearman ρ ≥ 0.5  (ISOMORPH-WEAK, 주 falsifier 통과)") } else { println("F1 FAIL — Spearman ρ = " + str(rho) + " < 0.5 (FALSIFIED)") }
    if f2 { println("F2 PASS — Spearman ρ ≥ 0.7  (ISOMORPH-STRONG)") } else { println("F2 note — Spearman ρ < 0.7 (weak isomorphism)") }
    if f3 { println("F3 PASS — Pearson r ≥ 0.5") } else { println("F3 FAIL") }
    if f4 { println("F4 PASS — per-profile argmax match " + str(argmax_match) + "/" + str(argmax_total)) } else { println("F4 FAIL — argmax mismatch " + str(argmax_match) + "/" + str(argmax_total)) }
    if f5 { println("F5 PASS — byte_eq recompute identical") } else { println("F5 FAIL") }

    println("")
    let mut verdict = "FALSIFIED"
    if f1 && f5 {
        verdict = "PARTIAL"
        if f3 && f4 { verdict = "SUPPORTED" }
    }
    let mut strength = ""
    if f2 { strength = " (STRONG ρ≥0.7)" }
    println("[H_626] verdict = " + verdict + strength)
    println("[H_626] summary  rho=" + str(rho) + "  r=" + str(r_p) + "  argmax=" + str(argmax_match) + "/" + str(argmax_total) + "  byte_eq=" + str(byte_eq))
    println("[H_626] compare  n=4 (H_624) ρ=0.860839 → n=5 ρ=" + str(rho))
}
