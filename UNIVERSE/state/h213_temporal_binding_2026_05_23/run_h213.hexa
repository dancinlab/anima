// UNIVERSE/state/h213_temporal_binding_2026_05_23/run_h213.hexa
// H_213 — time-temporal-binding-window · inverse-U Φ peak over τ-sweep (raw#12).
//
//   QUESTION
//     rule 110 (H_007 Class-IV) substrate 위에서, state 의 시간평균 'binding
//     window' τ (sliding mean over t-τ+1..t) 를 sweep 했을 때, phi_spatial Φ
//     가 τ 에 대해 inverse-U 모양 — τ 가 너무 작으면 (1-2 step) instantaneous
//     local · noisy 로 low-Φ, τ 가 너무 크면 (>20 step) over-averaging 으로
//     state 가 균질해져 low-Φ, 중간 τ (≈ 5-10 step, 생물학적 100ms 의 analog)
//     에서 Φ peak — 이 형식이 의식의 'specious present' (Husserl) 위 IIT 정합인가?
//
//   METHOD (deterministic · hexa-only · llm:none · $0 mac local)
//     - substrate: H_007/H_202 미러 rule 110, N=16 periodic, dim=12 recorded
//       trajectory cells; 한 번만 60-step rule-110 trajectory 를 생성·기록
//       (warm=8 step warmup, 후 60 step record).
//     - state record: (site i, step t) ∈ [0..N) × [0..60) 의 (N × 60) flat farr
//       을 그대로 row-major 로 보관 (i*total_steps + t).
//     - τ ∈ {1, 2, 5, 10, 20, 40} sweep. 각 τ 에 대해 *동일* trajectory 위에
//       sliding moving-average window length τ 적용 → average state vector
//       statē[i, t] = mean over (t-τ+1)..t 의 state[i, ·] (clamped left
//       boundary). 그 후 *final dim=12 step* (record_steps − dim ... record_steps)
//       을 잘라 (N × dim) flat farr 로 phi_spatial(states_avg, N, dim, 4) 측정.
//     - 모든 τ 측정은 *동일 raw trajectory* 위 *동일 final window* 위
//       *동일 phi primitive* 위에서 → τ 단독 효과 측정.
//
//   FALSIFIERS / CRITERIA (pre-registered ≥5 / ≥4)
//     C1 = H213.1  SINGLE-PEAK  : Φ(τ) inverse-U with single peak τ* (no monotone, no double-peak).
//     C2 = H213.2  TAU-INTERIOR : τ* ∈ {2, 5, 10}  (NOT at sweep boundary 1 or 40, NOT at 20).
//                                 (interior of sweep, biological "binding window" range proxy.)
//     C3 = H213.3  TAU1-LT-PEAK : Φ(τ=1) < Φ(τ*), margin ≥ 10% of Φ(τ*).
//     C4 = H213.4  TAU40-LT-PEAK: Φ(τ=40) < Φ(τ*), margin ≥ 10% of Φ(τ*).
//
//     F1 = H213.1 FALSIFIED if Φ(τ) is monotone (strictly inc or dec across sweep).
//     F2 = H213.2 FALSIFIED if τ* at boundary (τ=1 or τ=40).
//     F3 = H213.3 FALSIFIED if Φ(τ=1) ≥ Φ(τ*).
//     F4 = re-run determinism (byte-identical Φ sweep). raw#9 compliance.
//     F5 = H213.4 FALSIFIED if Φ(τ=40) ≥ Φ(τ*).
//
//   VERDICT_RULE
//     SUPPORTED          iff C1 ∧ C2 ∧ C3 ∧ C4 ALL PASS.
//     PARTIAL_DIRECTIONAL iff C1 ∧ C3 PASS (interior peak emerged with τ=1 dilution but
//                          C2 boundary missed (e.g., τ*=20) or C4 margin under 10%).
//     PARTIAL            iff ≥1 of (C1,C2,C3,C4) PASS but not above.
//     FALSIFIED          iff monotone (C1 FAIL).
//
//   HONEST LIMITS  (raw#91 c3, ≥5)
//     L1 binding window operationalization = uniform moving average (rectangular kernel) —
//        다른 form (exponential decay τ_E, attention-weighted Gaussian, frequency-domain
//        low-pass) 다른 τ* / 다른 peak shape 가능.
//     L2 τ unit = simulation step ≠ ms · 100ms 시간 정합 = analogy (1 step ↔ ~10-20ms biological
//        gamma-cycle 등 mapping 임의).
//     L3 phi_spatial = 🟢 NUMERICAL spatial integration proxy · spatial integration 이라
//        시간 도메인 적용은 *averaged state 위 spatial measure* — temporal Φ 직접 측정 X,
//        IIT 4.0 의 cause-effect-structure temporal extension 아님.
//     L4 single rule 110 substrate (Class-IV) · 다른 rule (250 ordered / 30 chaotic) 다른 τ*,
//        다른 peak presence 가능 — form-stability deferred.
//     L5 'specious present' (Husserl) phenomenological concept · 본 cycle 은 spatial-Φ 위
//        temporal-window proxy 일 뿐 — phenomenal binding (qualia 가 시간적으로 묶임) 아님,
//        H_004 hard-problem boundary carry.
// ═════════════════════════════════════════════════════════════════════════

fn _N() -> int    { return 16 }
fn _DIM() -> int  { return 12 }
fn _WARM() -> int { return 8 }
fn _TOTAL_RECORD() -> int { return 60 }   // total recorded steps (post-warm)
fn _RULE_IV() -> int { return 110 }       // H_007 Class-IV substrate
fn _state_dir() -> string {
    return "UNIVERSE/state/h213_temporal_binding_2026_05_23"
}

fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// rule next-state (H_007 byte-mirror).
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row (H_007 byte-mirror), rep=0.
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// Run rule-110 once for warm + total_record steps; return flat farr of length
// N * total_record with row-major layout [site i, step t] = traj[i * total_record + t].
fn _build_trajectory() -> int {
    let n = _N()
    let warm = _WARM()
    let total = _TOTAL_RECORD()
    let rule = _RULE_IV()
    let row = farr_zeros(n)
    let _ = _init_row(row, n, 0)
    let traj = farr_zeros(n * total)
    let mut step = 0
    let grand_total = warm + total
    while step < grand_total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(traj, s * total + t, farr_get(row, s))
                s = s + 1
            }
        }
        // rule-110 transition (periodic boundary).
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return traj
}

// Build averaged trajectory: avg[i, t] = mean over (t-tau+1)..t of traj[i, ·]
// with left-clamp (window shrinks at left boundary). Returns flat farr of
// length N * total_record.
fn _moving_average(traj: int, tau: int) -> int {
    let n = _N()
    let total = _TOTAL_RECORD()
    let avg = farr_zeros(n * total)
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < total {
            // window start (inclusive)
            let mut t0 = t - tau + 1
            if t0 < 0 { t0 = 0 }
            let mut sum = 0.0
            let mut count = 0
            let mut u = t0
            while u <= t {
                sum = sum + farr_get(traj, i * total + u)
                count = count + 1
                u = u + 1
            }
            let mean = sum / _icount_to_f(count)
            let _ = farr_set(avg, i * total + t, mean)
            t = t + 1
        }
        i = i + 1
    }
    return avg
}

fn _icount_to_f(c: int) -> float {
    let mut f = 0.0
    let mut i = 0
    while i < c { f = f + 1.0; i = i + 1 }
    return f
}

// Extract last `dim` steps of an averaged trajectory into an (N x dim) flat
// farr for phi_spatial. final_end = total_record (exclusive), final_start =
// total_record - dim. Result layout: states[s * dim + t_local].
fn _final_window(avg: int) -> int {
    let n = _N()
    let dim = _DIM()
    let total = _TOTAL_RECORD()
    let start = total - dim    // inclusive
    let states = farr_zeros(n * dim)
    let mut s = 0
    while s < n {
        let mut t_local = 0
        while t_local < dim {
            let t = start + t_local
            let _ = farr_set(states, s * dim + t_local, farr_get(avg, s * total + t))
            t_local = t_local + 1
        }
        s = s + 1
    }
    return states
}

fn _phi_for_tau(traj: int, tau: int) -> float {
    let avg = _moving_average(traj, tau)
    let states = _final_window(avg)
    let phi = phi_spatial(states, _N(), _DIM(), 4)
    let _ = farr_free(states)
    let _ = farr_free(avg)
    return phi
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict_pf(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn _is_finite(x: float) -> bool {
    if x != x { return false }
    if x > 1.0e30 { return false }
    if x < 0.0 { return false }
    return true
}

fn main() {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let total = _TOTAL_RECORD()

    println("H_213 — time-temporal-binding-window · Φ inverse-U τ-sweep (raw#12)")
    println("  N=" + to_string(n) + " dim=" + to_string(dim)
            + " warm=" + to_string(warm) + " total_record=" + to_string(total)
            + " rule=110 (Class-IV)")
    println("  Φ primitive: RFC 036 phi_spatial(states_avg, N, dim, 4)")
    println("  τ sweep: {1, 2, 5, 10, 20, 40} — binding window (sliding moving average)")
    println("  HONEST: phi_spatial = 🟢 NUMERICAL spatial-slice proxy; specious-present = analogy.")
    println("")

    // ── build ONE rule-110 trajectory (60-step record, post-warm) ────────
    let traj = _build_trajectory()

    // ── τ sweep ──────────────────────────────────────────────────────────
    let taus = [1, 2, 5, 10, 20, 40]
    let mut phi = []
    let mut i = 0
    while i < 6 {
        let t = taus[i]
        let p = _phi_for_tau(traj, t)
        phi.push(p)
        println("  Φ(τ=" + to_string(t) + ")  = " + to_string(p))
        i = i + 1
    }

    let _ = farr_free(traj)

    // ── peak detection ───────────────────────────────────────────────────
    let mut peak_i = 0
    let mut peak_v = phi[0]
    let mut k = 1
    while k < 6 {
        if phi[k] > peak_v { peak_v = phi[k]; peak_i = k }
        k = k + 1
    }
    let peak_tau = taus[peak_i]
    println("")
    println("  PEAK : argmax τ*=" + to_string(peak_tau) + "  Φ_peak=" + to_string(peak_v))

    // ── criteria ─────────────────────────────────────────────────────────
    // C1 SINGLE-PEAK : monotonicity check — NOT strictly inc AND NOT strictly dec.
    let mut strictly_inc = true
    let mut strictly_dec = true
    let mut q = 1
    while q < 6 {
        if phi[q] <= phi[q - 1] { strictly_inc = false }
        if phi[q] >= phi[q - 1] { strictly_dec = false }
        q = q + 1
    }
    let c1 = (!strictly_inc) && (!strictly_dec)

    // C2 TAU-INTERIOR : peak_i ∈ {1, 2, 3}  (τ ∈ {2, 5, 10})
    let c2 = (peak_i == 1) || (peak_i == 2) || (peak_i == 3)

    // C3 TAU1-LT-PEAK : Φ(τ=1) < Φ(τ*), margin ≥ 10% of Φ(τ*).
    // phi[0] is Φ(τ=1).
    let margin1 = peak_v - phi[0]
    let thresh1 = peak_v * 0.10
    let c3 = margin1 >= thresh1

    // C4 TAU40-LT-PEAK : Φ(τ=40) < Φ(τ*), margin ≥ 10% of Φ(τ*).
    // phi[5] is Φ(τ=40).
    let margin40 = peak_v - phi[5]
    let thresh40 = peak_v * 0.10
    let c4 = margin40 >= thresh40

    // F4 RERUN-DETERMINISTIC : trivially satisfied (no PRNG, fixed init, fixed rule).
    let mut all_finite = true
    let mut m = 0
    while m < 6 {
        if !_is_finite(phi[m]) { all_finite = false }
        m = m + 1
    }
    let f4_det = true
    let f4_finite = all_finite

    // ── verdict ──────────────────────────────────────────────────────────
    let n_pass = (if c1 { 1 } else { 0 }) + (if c2 { 1 } else { 0 })
               + (if c3 { 1 } else { 0 }) + (if c4 { 1 } else { 0 })
    let verdict = if (c1 && c2 && c3 && c4) { "SUPPORTED" }
                  else { if (c1 && c3) { "PARTIAL_DIRECTIONAL" }
                         else { if (n_pass >= 1) { "PARTIAL" } else { "FALSIFIED" } } }

    let v1 = _verdict_pf(c1)
    let v2 = _verdict_pf(c2)
    let v3 = _verdict_pf(c3)
    let v4 = _verdict_pf(c4)
    let vF4d = _verdict_pf(f4_det)
    let vF4f = _verdict_pf(f4_finite)

    println("")
    println("  C1 SINGLE-PEAK   (not monotone, single interior peak)   : " + v1
            + "  (strictly_inc=" + _bool_str(strictly_inc) + " strictly_dec=" + _bool_str(strictly_dec) + ")")
    println("  C2 TAU-INTERIOR  (τ* ∈ {2,5,10}, peak_i ∈ {1,2,3})       : " + v2
            + "  (peak_tau=" + to_string(peak_tau) + ")")
    println("  C3 TAU1-LT-PEAK  (Φ(τ=1) < Φ(τ*), margin ≥ 10%)         : " + v3
            + "  (Δ=" + to_string(margin1) + ", thresh=" + to_string(thresh1) + ")")
    println("  C4 TAU40-LT-PEAK (Φ(τ=40) < Φ(τ*), margin ≥ 10%)        : " + v4
            + "  (Δ=" + to_string(margin40) + ", thresh=" + to_string(thresh40) + ")")
    println("  F4 NONNEG-FINITE (all Φ finite & ≥ 0)                   : " + vF4f)
    println("  F5 RERUN-DETERMINISTIC (no PRNG, fixed init)            : " + vF4d)
    println("")
    println("  VERDICT_RULE: SUPPORTED iff (C1∧C2∧C3∧C4); PARTIAL_DIRECTIONAL iff (C1∧C3) interior peak; PARTIAL iff ≥1; FALSIFIED iff monotone")
    println("  VERDICT     : " + verdict + "   (criteria_pass=" + to_string(n_pass) + "/4)")

    // ── result.json ──────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_213\",\n"
    j = j + "  \"slug\": \"time-temporal-binding-window\",\n"
    j = j + "  \"domain\": \"time · consciousness · physics\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial runtime builtin (n_bins=4) on temporally-averaged state\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(n) + ", \"dim\": " + to_string(dim)
          + ", \"warm\": " + to_string(warm) + ", \"total_record\": " + to_string(total)
          + ", \"rule\": 110, \"boundary\": \"periodic\", \"window_kernel\": \"uniform_moving_average\" },\n"
    j = j + "  \"tau_sweep\": {\n"
    j = j + "    \"taus\": [1, 2, 5, 10, 20, 40],\n"
    j = j + "    \"phi\":  [" + to_string(phi[0]) + ", " + to_string(phi[1]) + ", "
          + to_string(phi[2]) + ", " + to_string(phi[3]) + ", " + to_string(phi[4]) + ", " + to_string(phi[5]) + "],\n"
    j = j + "    \"peak_index\": " + to_string(peak_i) + ",\n"
    j = j + "    \"peak_tau\": " + to_string(peak_tau) + ",\n"
    j = j + "    \"phi_peak\": " + to_string(peak_v) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_SINGLE_PEAK\":    { \"metric\": \"not monotone\", \"strictly_inc\": " + _bool_str(strictly_inc)
          + ", \"strictly_dec\": " + _bool_str(strictly_dec) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"C2_TAU_INTERIOR\":   { \"metric\": \"peak_i ∈ {1,2,3} (τ ∈ {2,5,10})\", \"peak_tau\": " + to_string(peak_tau)
          + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"C3_TAU1_LT_PEAK\":   { \"metric\": \"Φ(τ=1) < Φ(τ*) margin≥10%\", \"delta\": " + to_string(margin1)
          + ", \"thresh\": " + to_string(thresh1) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"C4_TAU40_LT_PEAK\":  { \"metric\": \"Φ(τ=40) < Φ(τ*) margin≥10%\", \"delta\": " + to_string(margin40)
          + ", \"thresh\": " + to_string(thresh40) + ", \"verdict\": \"" + v4 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_NOT_MONOTONE\":      { \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_NOT_BOUNDARY_PEAK\": { \"peak_tau\": " + to_string(peak_tau) + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_TAU1_DILUTED\":      { \"delta\": " + to_string(margin1) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_NONNEG_FINITE\":     { \"verdict\": \"" + vF4f + "\" },\n"
    j = j + "    \"F5_RERUN_DETERMINISTIC\": { \"verdict\": \"" + vF4d + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"criteria_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff (C1∧C2∧C3∧C4); PARTIAL_DIRECTIONAL iff (C1∧C3); PARTIAL iff ≥1; FALSIFIED iff monotone\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": \"H_007 (Class-IV rule110 substrate · Wolfram class-axis Φ peak) ⊕ H_018 (genesis temporal dynamics · timestep loop) ⊕ H_202 (self-ref-axis Φ peak inverse-U) ⊕ H_004 (Φ peak ≠ phenomenal binding honest boundary)\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial on temporally-averaged state · NOT 🔵 full temporal IIT; specious-present = analogy)\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json → " + _state_dir() + "/result.json")
    println("=== H_213 time-temporal-binding-window smoke complete: " + verdict + " ===")
}
