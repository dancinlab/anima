// H_321 — event-driven substrate factor update closed-form 🔵
// event_type: 0=NONE, 1=NOVEL, 2=ALERT, 3=REWARD, 4=THREAT
// ════════════════════════════════════════════════════════════════════════════
let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

fn cap(v: float, lo: float, hi: float) -> float {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

// returns [M, Φ, W, mit_inc (kept), idle_new, cur]
fn substrate_after_event(m: float, phi: float, w: float, mit: int, idle: int, cur: float, event_type: int) -> array {
    let mit_out = to_float(mit)
    let idle_inc = to_float(idle + 1)
    if event_type == 1 {
        // NOVEL: cur += 0.2
        return [m, phi, w, mit_out, idle_inc, cap(cur + 0.2, 0.0, 1.0)]
    }
    if event_type == 2 {
        // ALERT: M = 1.0
        return [1.0, phi, w, mit_out, idle_inc, cur]
    }
    if event_type == 3 {
        // REWARD: Φ += 0.1
        return [m, cap(phi + 0.1, 0.0, 1.0), w, mit_out, idle_inc, cur]
    }
    if event_type == 4 {
        // THREAT: W += 0.3, cur -= 0.1
        return [m, phi, cap(w + 0.3, 0.0, 2.0), mit_out, idle_inc, cap(cur - 0.1, 0.0, 1.0)]
    }
    // NONE: idle increment only
    return [m, phi, w, mit_out, idle_inc, cur]
}

fn main() {
    println("================================================================")
    println("  H_321 — event-driven substrate factor update 🔵")
    println("================================================================")

    let m0 = 0.5
    let p0 = 0.5
    let w0 = 0.5
    let mit0 = 5
    let idle0 = 50
    let c0 = 0.5

    // NONE
    let r_none = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 0)
    println("  NONE:   idle " + str(idle0) + " → " + str(r_none[4]) + " (only idle inc)")
    check("F321.1 NONE-IDLE-INCREMENT: idle += 1, others unchanged",
        approx(r_none[0], m0) && approx(r_none[1], p0) && approx(r_none[2], w0) && approx(r_none[4], 51.0) && approx(r_none[5], c0))

    // NOVEL
    let r_novel = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 1)
    println("  NOVEL:  cur 0.5 → " + str(r_novel[5]) + " (cur += 0.2)")
    check("F321.2 NOVEL-CURIOSITY-UP: cur += 0.2 = 0.7", approx(r_novel[5], 0.7))

    // ALERT
    let r_alert = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 2)
    println("  ALERT:  M 0.5 → " + str(r_alert[0]) + " (M = 1.0)")
    check("F321.3 ALERT-M-PEAK: M = 1.0", approx(r_alert[0], 1.0))

    // REWARD
    let r_reward = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 3)
    println("  REWARD: Φ 0.5 → " + str(r_reward[1]) + " (Φ += 0.1)")
    check("F321.4 REWARD-PHI-UP: Φ += 0.1 = 0.6", approx(r_reward[1], 0.6))

    // THREAT
    let r_threat = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 4)
    println("  THREAT: W 0.5 → " + str(r_threat[2]) + " · cur 0.5 → " + str(r_threat[5]))
    check("F321.5 THREAT-W-UP-CUR-DOWN: W = 0.8 AND cur = 0.4", approx(r_threat[2], 0.8) && approx(r_threat[5], 0.4))

    // bound
    let bound_ok = (r_none[5] >= 0.0) && (r_novel[5] <= 1.0) && (r_alert[0] <= 1.0) && (r_reward[1] <= 1.0) && (r_threat[2] >= 0.0) && (r_threat[5] >= 0.0)
    check("F321.6 BOUND: factors clamped", bound_ok)

    // determinism
    let d1 = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 1)
    let d2 = substrate_after_event(m0, p0, w0, mit0, idle0, c0, 1)
    check("F321.7 DETERMINISTIC", approx(d1[5], d2[5]))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS >= 6 { println("  ✅ EVENT-DRIVEN SUBSTRATE UPDATE — 🔵 SUPPORTED-FORMAL") }
    println("================================================================")
    if FAIL > 0 { panic("H_321 FAIL") }
}
