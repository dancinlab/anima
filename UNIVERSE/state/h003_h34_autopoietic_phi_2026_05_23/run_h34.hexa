    // ── arm 1: CLOSED autopoietic lattice (operational closure intact) ──
    let phi_closed = _mean_phi(0)
    println("  Φ̄(closed   autopoietic lattice)  = " + to_string(phi_closed) + "   (mean over " + to_string(N_SEEDS()) + " seeds)")

    // ── arm 2: BROKEN-closure control (cut B -> +C at every site) ──
    let phi_broken = _mean_phi(1)
    println("  Φ̄(broken   closure control    )  = " + to_string(phi_broken) + "   (mean over " + to_string(N_SEEDS()) + " seeds)")

    // determinism re-run (byte-identical recurrence, no RNG)
    let phi_closed2 = _mean_phi(0)
    let det_ok = phi_closed2 == phi_closed
    println("  Φ̄(closed   re-run determinism )  = " + to_string(phi_closed2)
            + "  (byte-equal=" + _bool_str(det_ok) + ")")
    println("")

    // ── falsifiers (pre-registered, measurable) ──────────────────────────
    let gap = phi_closed - phi_broken
    let f1 = phi_closed >= 0.0 && phi_broken >= 0.0          // F1 NONNEG (phi_spatial sanity)
    let f4 = phi_closed > 0.0                                // F4 (§Falsifiers): autopoietic Φ>0
    let f_dep = phi_closed > phi_broken + SEP_FLOOR()        // closure-DEPENDENCE of Φ
    let f_sep = gap > SEP_FLOOR()                            // separation margin > 1e-6
    let f_det = det_ok                                       // determinism

    println("  F1  NONNEG     (all Φ̄>=0)              : " + _bool_str(f1))
    println("  F4  AUTO_PHI>0 (Φ̄_closed>0)            : " + _bool_str(f4))
    println("  FD  CLOSURE-DEP (Φ̄_closed>Φ̄_broken+ε)  : " + _bool_str(f_dep) + "  (gap=" + to_string(gap) + ")")
    println("  FS  SEPARATION (gap>1e-6)              : " + _bool_str(f_sep) + "  (margin=" + to_string(gap) + ")")
    println("  FT  DETERMINISM (re-run byte-equal)    : " + _bool_str(f_det))

    let pass = f1 && f4 && f_dep && f_sep && f_det
    let verdict = _verdict(pass)
    println("")
    println("  VERDICT_RULE: H3.4 SUPPORTED iff Φ_closed>0 AND Φ_closed>Φ_broken+ε AND all Φ>=0 AND deterministic")
    println("  VERDICT (C4 / H3.4): " + verdict)
    let f4_state = "NOT_TRIGGERED"
    if phi_closed <= 0.0 { f4_state = "TRIGGERED" }
    println("    falsifier F4 (autopoietic system Φ=0): " + f4_state)
    println("  H3.4_VERDICT=" + verdict + " PHI_CLOSED=" + to_string(phi_closed) + " PHI_BROKEN=" + to_string(phi_broken))

    // ── write result.json (ledger) ───────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_003\",\n"
    j = j + "  \"cycle\": \"Cycle_3_H3.4\",\n"
    j = j + "  \"slug\": \"life-origin-question\",\n"
    j = j + "  \"sub_hypothesis\": \"H3.4 autopoietic-closure system Φ>0 (life ⊂ consciousness)\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
