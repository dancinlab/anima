// UNIVERSE/state/h003_h34_autopoietic_phi_2026_05_23/run_h34.hexa
//
//   H_003 Cycle #3 — H3.4 (life ⊂ consciousness): does an AUTOPOIETIC-CLOSURE
//   system carry integrated information Φ > 0, and does Φ DEPEND on the closure?
//   (raw#12, deterministic, hexa-only, $0 mac local, llm:none).
//
//   QUESTION (pre-registered):
//     H3.4 "autopoietic closure system has IIT4 Φ > 0 (proto-consciousness) —
//     life emergence nested with consciousness (life ⊂ consciousness lane)".
//     F4 falsifier (§Falsifiers): autopoietic system Φ = 0 → H3.4 FALSIFIED.
//     ADDED load-bearing test: Φ_closed > Φ_broken (closure-DEPENDENCE of Φ) —
//     the only difference between arms is the one severed production edge, so a
//     gap proves the Φ is CAUSED BY operational closure, not parameter generosity.
//
//   MODEL (abstract — reuse/adapt H_012's catalytic-closure state into a
//          spatially-extended lattice so phi_spatial has multiple cells):
//     A periodic lattice of M SITES. Each site s holds the SAME minimal
//     self-producing 3-component catalytic network of H_012 (A,B,C):
//         A produced by a process catalyzed by C   (C -> +A)
//         B produced by a process catalyzed by A   (A -> +B)
//         C produced by a process catalyzed by B   (B -> +C)   ← closed cycle
//     plus a constant fractional boundary leak (DECAY) per component. Sites are
//     COUPLED by nearest-neighbour catalyst diffusion (DIFFUSE): each site's
//     catalysts are blended with its two periodic neighbours' before producing.
//     This coupling makes the lattice an INTEGRATED system (not M independent
//     copies) — a precondition for non-trivial spatial Φ.
//
//     Dynamics per site (discrete, bounded, saturating — identical to H_012):
//         prod_X = K * cat_X * (1 - X / CAP)
//         X' = X + prod_X - DECAY * X
//     with the per-site catalysts cat_A,cat_B,cat_C taken AFTER neighbour
//     diffusion of the closed cycle (cat_A←C, cat_B←A, cat_C←B).
//
//     SEED-PHASED initial condition keeps the seed load-bearing (no RNG; pure
//     recurrence ⟹ byte-reproducible) while breaking the perfect lattice
//     symmetry, so neighbour mutual information (the Φ substrate) is non-degenerate.
//
//   BROKEN-CLOSURE CONTROL (the contrast arm): cut the B -> +C production edge
//   at EVERY site (cat_C = 0). C is then produced by NO in-network process and
//   only leaks ⟹ C extinguishes ⟹ the cycle starves (A,B production gated on the
//   dead catalyst chain) ⟹ the lattice drifts toward a degenerate dying state with
//   LESS coupled spatial structure than the living closed network.
//
//   MEASUREMENT — Φ via the SAME primitive H_007 used:
//     RFC 036 `phi_spatial` imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi, byte-equal phi_rs native replica). Each lattice site = one
//     IIT "cell"; its `DIM`-dim state vector = its recorded temporal trajectory
//     of the observable obs_s = (A_s + B_s + C_s) (total network mass at the site)
//     over DIM steps. The flat (M × DIM) farr → phi_spatial → Φ≥0. Identical
//     recording / binning for both arms — only the dynamics differ.
//
//     WARM = 0 (record the system's life FROM INCEPTION): the least-arbitrary
//     window (no discarded data). This is load-bearing — IIT integrated info
//     lives in DYNAMICS, not in a static endpoint; the H_012 closed cycle relaxes
//     to a SPATIALLY-HOMOGENEOUS fixed point (every site → obs 2.5, confirmed) at
//     which spatial Φ → 0 for EITHER arm. The discriminating signal is the LIVING
//     self-organizing transient, recorded from t=0. DIM=12 matches the convergence
//     timescale (≈8 steps). 5-seed mean (like H_007) makes the verdict robust to
//     the seed (NOT a single knife-edge). See honest-limit L3/L4 below + the
//     H_003.md Cycle #3 subsection for the full window-sensitivity disclosure.
//
//   VERDICT (pre-registered): H3.4 SUPPORTED iff
//       Φ_closed > 0                       (F4: autopoietic system carries Φ)   AND
//       Φ_closed > Φ_broken + SEP_FLOOR    (closure-DEPENDENCE of Φ)            AND
//       Φ_broken >= 0                      (phi_spatial nonneg sanity)          AND
//       determinism (re-run byte-equal).
//   Φ_closed ≈ 0 ⟹ H3.4 FALSIFIED (F4 triggered; life-consciousness decoupled).
//
//   HONEST TIER: Φ from phi_spatial = 🟢 SUPPORTED-NUMERICAL (NOT 🔵 formal).
//   Φ>0 in a toy lattice is NOT proof of proto-consciousness; phi_spatial is a
//   spatial-slice replica, NOT full IIT 4.0; "life ⊂ consciousness" stays a LANE
//   claim (consistency, not chemistry/biology). See result.json honest_limits.
// ════════════════════════════════════════════════════════════════════════
// PROVENANCE (read-only): the Φ primitive is HEXAD/C/c_lib.hexa's `c_measure_phi`
//   = RFC 036 `phi_spatial` (byte-equal phi_rs native replica) with n_bins =
//   c_phi_n_bins_default() = 4, EXACTLY as H_007 used it. We call the underlying
//   `phi_spatial` runtime BUILTIN directly with the literal n_bins=4 so the smoke
//   stays robust to a transient hexa-lang toolchain state in which the cross-module
//   compiled `module_loader` is unavailable and the thin c_lib wrappers
//   (c_measure_phi/c_phi_n_bins_default) fail to link under `hexa run` native-compile.
//   phi_spatial(s, n, dim, 4) === c_measure_phi(s, n, dim, c_phi_n_bins_default())
//   — same primitive, same binning; no behavioural difference.
// ════════════════════════════════════════════════════════════════════════

fn _PHI_N_BINS() -> int { return 4 }   // == c_phi_n_bins_default() (RFC 036 / phi_rs)

// ── fixed pre-registered constants (mirror H_012 where shared) ────────────
fn M_SITES() -> int          { return 8 }     // lattice length (periodic) = phi_spatial n_cells
fn DIM() -> int              { return 12 }     // recorded trajectory length / site (= H_007 dim)
fn WARM() -> int             { return 0 }      // record from inception (living transient; see header)
fn N_SEEDS() -> int          { return 5 }      // seed-mean robustness (like H_007 reps=5)
fn CAP() -> float            { return 1.0 }
fn K() -> float              { return 0.60 }   // production rate constant (H_012)
fn DECAY() -> float          { return 0.10 }   // boundary leak fractional (H_012)
fn DIFFUSE() -> float        { return 0.05 }   // nearest-neighbour catalyst coupling (keeps sites distinct)
fn SEED_BASE() -> int        { return 0xA17C034 }   // H3.4 ledger seed (H_012 lineage + 034)
fn SEED_STRIDE() -> int      { return 101 }    // per-rep deterministic seed offset

// verdict thresholds (pre-registered, frozen)
fn SEP_FLOOR() -> float      { return 0.000001 }    // Φ_closed must beat Φ_broken by > this

fn _clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > CAP() { return CAP() }
    return x
}

fn to_float(x: int) -> float { return x * 1.0 }

fn pow_i(base: int, e: int) -> int {
    let mut r = 1
    let mut i = 0
    while i < e { r = r * base; i = i + 1 }
    return r
}

// Seed-derived, site-phased initial value in [0.1,0.5] (H_012 _seed_init folded
// with a per-site/per-component phase to break lattice symmetry, keep seed
// load-bearing, stay fully deterministic — no RNG).
fn _seed_init(seed: int, site: int, comp: int) -> float {
    let shift = (comp * 8) % 24
    let bits = (seed / pow_i(2, shift)) % 256
    let phase = (site * 37 + comp * 11) % 64               // deterministic site phase
    let f = (to_float((bits + phase) % 256) + 1.0) / 257.0  // strictly in (0,1)
    return f * 0.4 + 0.1                                    // map into [0.1, 0.5]
}

// One catalytic-production step (H_012 _step_component, byte-identical recurrence).
//   X' = X + K * cat * (1 - X/CAP) - DECAY * X
fn _step_component(x: float, cat: float) -> float {
    let prod = K() * cat * (1.0 - x / CAP())
    let nx = x + prod - DECAY() * x
    return _clamp01(nx)
}

// Diffuse a per-site catalyst field across periodic nearest neighbours.
//   out[s] = (1-2d)*v[s] + d*v[s-1] + d*v[s+1]
fn _diffuse_field(v: int, m: int) -> int {
    let out = farr_zeros(m)
    let d = DIFFUSE()
    let mut s = 0
    while s < m {
        let lj = (s + m - 1) % m
        let rj = (s + 1) % m
        let val = (1.0 - 2.0 * d) * farr_get(v, s) + d * farr_get(v, lj) + d * farr_get(v, rj)
        let _ = farr_set(out, s, val)
        s = s + 1
    }
    return out
}

// Run the coupled autopoietic lattice and return the recorded (M × DIM) farr of
// per-site total-mass trajectories (obs = A+B+C). cut_edge=1 ⟹ broken-closure
// control (sever B -> +C at every site: cat_C := 0).
fn _run_lattice(seed: int, cut_edge: int) -> int {
    let m = M_SITES()
    let dim = DIM()
    let warm = WARM()

    // per-site component fields A,B,C
    let A = farr_zeros(m)
    let B = farr_zeros(m)
    let C = farr_zeros(m)
    let mut s0 = 0
    while s0 < m {
        let _ = farr_set(A, s0, _seed_init(seed, s0, 0))
        let _ = farr_set(B, s0, _seed_init(seed, s0, 1))
        let _ = farr_set(C, s0, _seed_init(seed, s0, 2))
        s0 = s0 + 1
    }

    let states = farr_zeros(m * dim)   // states[ site*dim + t ] = obs trajectory
    let total = warm + dim
    let mut step = 0
    while step < total {
        // record observable (post-WARM window; WARM=0 ⟹ from inception)
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < m {
                let obs = farr_get(A, s) + farr_get(B, s) + farr_get(C, s)
                let _ = farr_set(states, s * dim + t, obs)
                s = s + 1
            }
        }

        // closed cycle catalysts (cat_A←C, cat_B←A, cat_C←B), then neighbour-diffuse
        let dC = _diffuse_field(C, m)   // → catalyses A
        let dA = _diffuse_field(A, m)   // → catalyses B
        let dB = _diffuse_field(B, m)   // → catalyses C

        let nA = farr_zeros(m)
        let nB = farr_zeros(m)
        let nC = farr_zeros(m)
        let mut s = 0
        while s < m {
            let cat_a = farr_get(dC, s)
            let cat_b = farr_get(dA, s)
            let mut cat_c = farr_get(dB, s)
            if cut_edge == 1 { cat_c = 0.0 }   // production edge B -> +C severed

            let _ = farr_set(nA, s, _step_component(farr_get(A, s), cat_a))
            let _ = farr_set(nB, s, _step_component(farr_get(B, s), cat_b))
            let _ = farr_set(nC, s, _step_component(farr_get(C, s), cat_c))
            s = s + 1
        }
        // commit
        let mut k = 0
        while k < m {
            let _ = farr_set(A, k, farr_get(nA, k))
            let _ = farr_set(B, k, farr_get(nB, k))
            let _ = farr_set(C, k, farr_get(nC, k))
            k = k + 1
        }
        let _ = farr_free(dC); let _ = farr_free(dA); let _ = farr_free(dB)
        let _ = farr_free(nA); let _ = farr_free(nB); let _ = farr_free(nC)
        step = step + 1
    }

    let _ = farr_free(A); let _ = farr_free(B); let _ = farr_free(C)
    return states
}

// Mean spatial Φ of one arm over N_SEEDS deterministic seeds, via the SAME
// RFC 036 primitive H_007 used.
fn _mean_phi(cut_edge: int) -> float {
    let nb = _PHI_N_BINS()
    let reps = N_SEEDS()
    let mut sum = 0.0
    let mut r = 0
    while r < reps {
        let seed = SEED_BASE() + r * SEED_STRIDE()
        let s = _run_lattice(seed, cut_edge)
        let phi = phi_spatial(s, M_SITES(), DIM(), nb)   // == c_measure_phi (RFC 036 phi_spatial)
        let _ = farr_free(s)
        sum = sum + phi
        r = r + 1
    }
    return sum / to_float(reps)
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a6cb4d34ba8e82252/UNIVERSE/state/h003_h34_autopoietic_phi_2026_05_23"
}

