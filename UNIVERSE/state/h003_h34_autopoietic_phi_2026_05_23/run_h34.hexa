    println("H_003 Cycle #3 — H3.4 autopoietic-closure Φ (life ⊂ consciousness) · raw#12")
    println("  model: " + to_string(M_SITES()) + "-site periodic lattice of H_012 closed catalytic")
    println("         cycle (C->+A, A->+B, B->+C) + boundary leak + nn catalyst diffusion")
    println("  M=" + to_string(M_SITES()) + " DIM=" + to_string(DIM()) + " WARM=" + to_string(WARM())
            + " SEEDS=" + to_string(N_SEEDS()) + " K=" + to_string(K()) + " DECAY=" + to_string(DECAY())
            + " DIFFUSE=" + to_string(DIFFUSE()) + " SEED_BASE=" + to_string(SEED_BASE()))
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.) — 🟢 NUMERICAL")
