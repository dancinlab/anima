    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"model\": \"" + to_string(M_SITES()) + "-site periodic lattice of H_012 closed catalytic cycle (C->+A, A->+B, B->+C) + boundary leak + nn catalyst diffusion; obs=A+B+C site mass; WARM=0 living-transient window\",\n"
    j = j + "  \"seed_base\": " + to_string(SEED_BASE()) + ",\n"
    j = j + "  \"config\": { \"M_sites\": " + to_string(M_SITES()) + ", \"dim\": " + to_string(DIM())
          + ", \"warm\": " + to_string(WARM()) + ", \"n_seeds\": " + to_string(N_SEEDS())
          + ", \"K\": " + to_string(K()) + ", \"decay\": " + to_string(DECAY())
          + ", \"diffuse\": " + to_string(DIFFUSE()) + ", \"n_bins\": " + to_string(_PHI_N_BINS())
          + ", \"boundary\": \"periodic\", \"observable\": \"A+B+C site mass\" },\n"
    j = j + "  \"phi\": {\n"
    j = j + "    \"closed_autopoietic_mean\": " + to_string(phi_closed) + ",\n"
    j = j + "    \"broken_closure_control_mean\": " + to_string(phi_broken) + ",\n"
    j = j + "    \"closure_dependence_gap\": " + to_string(gap) + "\n"
    j = j + "  },\n"
