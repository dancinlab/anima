    j = j + "    \"F4_AUTO_PHI_POS\": { \"metric\": \"Φ_closed>0\", \"value\": " + to_string(phi_closed) + ", \"verdict\": \"" + _verdict(f4) + "\", \"falsifier_state\": \"" + f4_state + "\" },\n"
    j = j + "    \"FD_CLOSURE_DEPENDENCE\": { \"metric\": \"Φ_closed>Φ_broken+ε\", \"gap\": " + to_string(gap) + ", \"verdict\": \"" + _verdict(f_dep) + "\" },\n"
