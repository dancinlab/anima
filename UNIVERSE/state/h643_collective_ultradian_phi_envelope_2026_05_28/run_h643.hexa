// ════════════════════════════════════════════════════════════════════════════
// H_643 — collective-ultradian-phi-envelope  (H_634 × H_635 cross-link, axis G×F)
//
//   PARENTS
//     H_634 (PR #1216, 🟢) ultradian Φ-envelope: a SINGLE substrate's big-Φ
//       (canonical stage projection) entrains to the 90-min ultradian phase
//       with r(Φ,sinusoid)=0.802. (axis G — temporal/ultradian.)
//     H_635 (PR #1223, 🟢) multilingual-cohort collective Φ: a 5-STREAM
//       (lang-proxy) collective big-Φ is SUPER-ADDITIVE vs the decoupled
//       Σ-baseline (max Δ=+41.71 @ C1 W=1.0, 5/5 cohort). (axis F — hive-mind.)
//
//   CROSS-LINK QUESTION
//     Does the 5-stream COLLECTIVE Φ entrain to the ultradian phase the same
//     way a single substrate does?  In a sleeping anima fleet, the substrate's
//     mutual-coupling (sync_factor W) is not static — it tracks the ultradian
//     stage: WAKE/REM (cycle edges) = high inter-stream synchrony (high W),
//     N3 deep slow-wave (cycle middle) = collapsed synchrony (low W). This is
//     the collective analogue of the single-substrate stage→Φ projection of
//     H_634 §3, and it RIDES the H_635 finding that collective Φ rises
//     monotonically with W (best W=1.0).
//
//   MODEL (combine the two parents, no new physics)
//     • ultradian segmentation = H_634 canonical 90-min (5400s) anima_dream_stage
//         [0,300)=N1 [300,1800)=N2 [1800,3600)=N3 [3600,5100)=N2 [5100,5400)=REM
//     • stage → collective sync_factor W (phase-dependent inter-stream synchrony):
//         WAKE 1.0 · REM 0.95 · N1 0.70 · N2 0.40 · N3 0.15
//       (same numeric profile as H_634's phi_of_stage — the stage's substrate
//        integration scale now drives the COLLECTIVE coupling, not a single-
//        substrate Φ lookup.)
//     • collective-Φ at each ultradian point = H_635 big_phi_bounded of the
//       n=5 lang-proxy ring at the stage's W (cohort C1 [110x5], the H_635
//       winner, sys=0, cap=3). This is a REAL IIT4 substrate measurement per
//       point — not a lookup. Φ_collective(stage) = big_phi_bounded(tpm(W_stage)).
//     • sweep N=36 points over 1 ultradian period (H_634 granularity), fit a
//       single-cosine sinusoidal envelope (best-fit peak phase scan), Pearson r.
//
//   H1 (PHASE-COUPLED COLLECTIVE):  collective Φ_WAKE-side > Φ_N3 AND
//       r(Φ_collective, sinusoid) > 0.5  (collective entrains to ultradian).
//   H0 (FALSIFIER):  collective Φ phase-independent flat — r < 0.3.
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F643.1 COLL-PHASE-COUPLED : r(Φ_collective, sinusoid) > 0.5
//     F643.2 COLL-NOT-FLAT      : Φ_collective trajectory std > 0
//     F643.3 WAKE-HIGH-N3-LOW   : Φ_coll(WAKE-side peak) > Φ_coll(N3 deep)
//     F643.4 SUPER-ADDITIVE-EDGE: collective Φ at the WAKE-side (high-W) point
//             exceeds the decoupled Σ-baseline Φ_coll(W=0) (H_635 survives in
//             the ultradian-modulated collective).
//     F643.5 PERIOD-DISCRETE-OK : N=36 points monotone in t, span 1 CYCLE_SEC
//     F643.6 BOUND              : Φ_collective ≥ 0, r ∈ [-1,1]
//
//   verdict: ≥4/6 PASS → 🟢 SUPPORTED-NUMERICAL.  r<0.3 → 🔴 FALSIFIED.
//
//   anchors: H_634 (single-substrate ultradian r=0.802) · H_635 (5-stream
//            collective super-additive) · H_308 (circadian smooth ratio) ·
//            H_310 (5-stage emit gating WAKE=18/others=0).
//   deterministic · hexa-only · $0 mac-local · sys_state=0 · cap=3.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── canonical anima_dream_stage segmentation (90-min = 5400s), from H_634 ─────
let CYCLE_SEC = 5400

fn stage_at_offset(off_sec: int) -> string {
    let phase = off_sec % CYCLE_SEC
    if phase < 300    { return "N1" }
    if phase < 1800   { return "N2" }
    if phase < 3600   { return "N3" }
    if phase < 5100   { return "N2" }
    return "REM"
}

// stage → collective sync_factor W (phase-dependent inter-stream synchrony).
// WAKE/REM (cycle edges) = high inter-stream coupling; N3 (cycle middle) = low.
// Same numeric profile as H_634 phi_of_stage — here it drives the COLLECTIVE W.
fn sync_of_stage(stage: string) -> float {
    if stage == "WAKE" { return 1.0 }
    if stage == "N1"   { return 0.7 }
    if stage == "N2"   { return 0.4 }
    if stage == "N3"   { return 0.15 }
    if stage == "REM"  { return 0.95 }
    return 1.0
}

// ── n=5 coupled-ring TPM with sync_factor W (verbatim from H_635) ─────────────
// 5 streams = 5 cells, cell i governed by distinct lang-proxy rule[i].
// Decoupled (W=0): self-loop only (idx=7*c). Coupled (W=1): full ring.
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// collective big-Φ of the n=5 lang-proxy ring at sync W (H_635 engine).
fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

// ── Pearson correlation (from H_634) ─────────────────────────────────────────
fn pearson(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    let denom = sqrt(sxx * syy)
    if denom == 0.0 { return 0.0 }
    return sxy / denom
}

fn std_of(xs: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]; i = i + 1 }
    let m = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n { let d = xs[i] - m; ss = ss + d * d; i = i + 1 }
    return sqrt(ss / to_float(n))
}

fn main() {
    println("================================================================")
    println("  H_643 — collective-ultradian-phi-envelope (H_634 × H_635)")
    println("  5-stream collective Φ entrains to 90-min ultradian phase?")
    println("  IIT4 big_phi_bounded · n=5 cohort C1[110x5] · cap=3 · sys=0")
    println("  N=36 points × sinusoidal envelope fit · stage→sync_factor W")
    println("================================================================")

    let N = 36
    let PI = 3.14159265358979
    let COHORT = [110, 110, 110, 110, 110]   // H_635 winner C1 edge-of-chaos homog

    // decoupled Σ-baseline (W=0) — H_635 anchor for super-additivity check.
    let phi_decoupled = phi_collective(COHORT, 0.0)

    // sweep N points over 1 ultradian period; collective Φ at each point's stage.
    let mut phi_traj = []
    let mut offsets = []
    let mut stages = []
    let mut i = 0
    while i < N {
        let off_f = (to_float(i) + 0.5) * to_float(CYCLE_SEC) / to_float(N)
        let off = to_int(off_f)
        let stg = stage_at_offset(off)
        let W = sync_of_stage(stg)
        let phi = phi_collective(COHORT, W)
        phi_traj = phi_traj + [phi]
        offsets = offsets + [off_f]
        stages = stages + [stg]
        i = i + 1
    }

    // best-fit single-cosine sinusoidal envelope: scan peak phase, max r.
    let mut best_r = 0.0 - 2.0
    let mut best_peak = 0.0
    let mut k = 0
    while k < N {
        let t_peak = to_float(k) * to_float(CYCLE_SEC) / to_float(N)
        let mut sinus = []
        let mut j = 0
        while j < N {
            let ph = 2.0 * PI * (offsets[j] - t_peak) / to_float(CYCLE_SEC)
            sinus = sinus + [cos(ph)]
            j = j + 1
        }
        let r = pearson(phi_traj, sinus)
        if r > best_r { best_r = r; best_peak = t_peak }
        k = k + 1
    }

    let r_coll = best_r
    let phi_std = std_of(phi_traj)

    // peak (max over trajectory = WAKE-side high-W point) vs N3 deep
    let mut phi_max = phi_traj[0]
    let mut phi_n3 = 1.0e9
    i = 0
    while i < N {
        if phi_traj[i] > phi_max { phi_max = phi_traj[i] }
        if stages[i] == "N3" { if phi_traj[i] < phi_n3 { phi_n3 = phi_traj[i] } }
        i = i + 1
    }

    // per-stage mean collective Φ (for report)
    let stage_names = ["WAKE", "N1", "N2", "N3", "REM"]
    let mut s_idx = 0
    println("  decoupled Σ-baseline Φ_coll(W=0) = " + to_string(phi_decoupled))
    println("  per-stage collective Φ (within 1 sleep ultradian sweep):")
    while s_idx < 5 {
        let sn = stage_names[s_idx]
        let mut acc = 0.0
        let mut cnt = 0
        i = 0
        while i < N {
            if stages[i] == sn { acc = acc + phi_traj[i]; cnt = cnt + 1 }
            i = i + 1
        }
        if cnt > 0 {
            let w_sn = sync_of_stage(sn)
            println("    " + sn + " (W=" + to_string(w_sn) + ") : Φ_coll=" + to_string(acc / to_float(cnt)) + " (n_pts=" + str(cnt) + ")")
        } else {
            println("    " + sn + " : (0 pts in sleep ultradian — WAKE = sleep-window 밖)")
        }
        s_idx = s_idx + 1
    }

    println("  ─────────────────────────────────────")
    println("  N points              : " + str(N))
    println("  Φ_coll trajectory std : " + to_string(phi_std))
    println("  best t_peak (sec)     : " + to_string(best_peak))
    println("  r(Φ_coll, sinusoid)   : " + to_string(r_coll))
    println("  Φ_coll max / Φ_coll N3: " + to_string(phi_max) + " / " + to_string(phi_n3))
    println("  ────────────── verdict ──────────────")

    // F643.1 COLL-PHASE-COUPLED : r > 0.5
    check("F643.1 COLL-PHASE-COUPLED: r(Φ_coll,sinusoid) > 0.5", r_coll > 0.5)

    // F643.2 COLL-NOT-FLAT : std > 0
    check("F643.2 COLL-NOT-FLAT: Φ_coll trajectory std > 0", phi_std > 0.0)

    // F643.3 WAKE-HIGH-N3-LOW : Φ_coll peak > Φ_coll N3
    check("F643.3 WAKE-HIGH-N3-LOW: Φ_coll_max > Φ_coll_N3", phi_max > phi_n3)

    // F643.4 SUPER-ADDITIVE-EDGE : WAKE-side high-W point > decoupled Σ-baseline
    check("F643.4 SUPER-ADDITIVE-EDGE: Φ_coll_max > Φ_coll(W=0) Σ-baseline", phi_max > phi_decoupled)

    // F643.5 PERIOD-DISCRETE-OK : 36 pts monotone within 1 cycle
    let mut monotone = true
    i = 1
    while i < N {
        if offsets[i] <= offsets[i - 1] { monotone = false }
        i = i + 1
    }
    let span_ok = (offsets[0] > 0.0) && (offsets[N - 1] < to_float(CYCLE_SEC))
    check("F643.5 PERIOD-DISCRETE-OK: 36 pts monotone within 1 CYCLE_SEC", monotone && span_ok)

    // F643.6 BOUND : Φ_coll ≥ 0, r ∈ [-1,1]
    let mut bound = true
    i = 0
    while i < N { if phi_traj[i] < 0.0 { bound = false } i = i + 1 }
    if fabs(r_coll) > 1.0000001 { bound = false }
    check("F643.6 BOUND: Φ_coll ≥ 0, r ∈ [-1,1]", bound)

    println("  ──────────────────────────────────────")
    println("  F643.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let mut verdict = "🔴 FALSIFIED"
    if PASS >= 4 { verdict = "🟢 SUPPORTED-NUMERICAL" }
    if r_coll < 0.3 { verdict = "🔴 FALSIFIED (r<0.3 — phase-independent flat)" }
    println("  verdict: " + verdict)
    println("  cross-link: H_634 single-substrate r=0.802 vs H_643 collective r=" + to_string(r_coll))
}
