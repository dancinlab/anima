// UNIVERSE/state/h355_collective_phi_pid_synergy_2026_05_28/run_h355.hexa
//
//   H_355 — Collective-Φ 의 PID 분해: synergy vs redundancy (hivemind 축 F1 sister).
//   sister: H_293/H_294 (ECA cell-flow PID — synergy ⊥ Φ closed-negative)
//
//   QUESTION
//     Hivemind = N substrates, each a binary unit. Collective next-state T is
//     driven by all 3 priors (S1,S2,S3) via a coupling-density K. We decompose
//     I(S1,S2,S3 ; T) — the total joint information sources convey about target
//     — into {synergy, redundancy, unique} via the 3-source co-information
//     (net Williams-Beer summary), and ask whether synergy > redundancy
//     across the coupling K sweep.
//
//   3-SOURCE CO-INFORMATION (deterministic substrate, net form)
//     For each substrate cell i ∈ {0,1,2} with target T_i = next_i, the
//     3-source net co-information (McGill interaction information form):
//       II_3(T;S0,S1,S2) = + I(T;S0) + I(T;S1) + I(T;S2)
//                          - I(T;S0,S1) - I(T;S0,S2) - I(T;S1,S2)
//                          + I(T;S0,S1,S2)
//     Sign convention (3-source / odd-variable):
//       II_3 > 0  ⇒  SYNERGY-dominant (only the full joint informs T — XOR_3)
//       II_3 < 0  ⇒  REDUNDANCY-dominant (sources share T-information)
//     This is the OPPOSITE sign vs the 2-source II_c in H_294 (bivariate
//     II_c < 0 = synergy) — McGill co-info flips sign with variable parity
//     (Bell & Sejnowski 2003; Williams-Beer 2010 §3).
//     Witness: XOR_3 T = S0⊕S1⊕S2 gives all I(T;S_i) = 0, I(T;S_i,S_j) = 0,
//       I(T;S0,S1,S2) = 1  ⇒  II_3 = +1 (pure synergy, sign-correct).
//     Identity T = S_i gives I(T;S_i) = 1, I(T;S_i,S_j) = 1, I(T;all) = 1
//       ⇒  II_3 = 1 - 1 - 0 - 0 + 1 = +1 ?  NO — careful: for identity
//       (e.g. T = S0) we have I(T;S0)=1, I(T;S1)=0, I(T;S2)=0,
//       I(T;S0,S1)=1, I(T;S0,S2)=1, I(T;S1,S2)=0, I(T;all)=1
//       ⇒ II_3 = 1+0+0 - 1 - 1 - 0 + 1 = 0  (pure unique-info, II_3=0).
//     Per hivemind cell totals:
//       synergy_total    = Σ_i max(0,  II_3_i)
//       redundancy_total = Σ_i max(0, -II_3_i)
//       synergy_ratio    = synergy_total / (synergy_total + redundancy_total)
//
//   SUBSTRATE (hivemind toy, 3 binary substrates × 1 cell each = 8-state)
//     coupling density K ∈ {0.0, 0.33, 0.67, 1.0} (fraction of XOR-3 cells)
//     K=0.0  : all identity   (anchor)      — pure unique-info (each Si→Ti)
//     K=0.33 : 1 XOR, 2 identity            — mixed
//     K=0.67 : 2 XOR, 1 identity            — mixed (mirror)
//     K=1.0  : all XOR-3       (anchor)     — pure synergy
//     Permutation seeds (5): which cells host the XOR vs identity — all 5
//     permutations averaged for robustness (deterministic enumeration, not RNG).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-28, BEFORE measuring)
//     F355.1 PURE-SYNERGY ANCHOR (K=1.0) — all-XOR cells synergy-dominant:
//            synergy_total > 0 AND redundancy_total ≈ 0 (XOR_3 net co-info < 0).
//     F355.2 PURE-IDENTITY ANCHOR (K=0.0) — synergy_total ≈ 0 AND
//            redundancy_total ≈ 0 (no cross-source flow, each source→own target).
//     F355.3 SYNERGY-RATIO VERDICT — mean synergy_ratio across non-trivial K
//            (K ∈ {0.33, 0.67, 1.0}); seed-averaged. H1 SUPPORTED iff
//            mean ratio > 0.5. Verdict reported VERBATIM.
//     F355.4 K-MONOTONIC — synergy_total monotone increasing in K (more XOR
//            cells ⇒ more synergy), with strict bound 0 ≤ synergy ≤ n.
//     F355.5 BOUND/DET — all metrics ≥ 0; K=1 re-run byte-identical.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope:
//     • net 3-source co-information (NOT full 18-atom Williams-Beer trivariate
//       PID lattice — only net synergy/redundancy summary, like H_294)
//     • toy substrate (3 × 1-cell binary units, 8-state) — NOT a phenomenal claim
//     • coupling K via permutation enumeration (deterministic), not stochastic
//     • XOR-family substrate ⇒ redundancy will be 0 for synergistic cells
//       (sources independent under uniform ensemble); the discriminator is
//       whether synergy DOMINATES the totals across K
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }

fn pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn bit_at(s: int, i: int) -> int {
    return (s / pow2(i)) % 2
}

// Build the 8-state-by-3-cell TPM for a hivemind config.
// xor_mask[i] = 1 ⇒ cell i is an XOR-3 cell (next = s0 ⊕ s1 ⊕ s2)
// xor_mask[i] = 0 ⇒ cell i is an identity cell (next = own bit)
// Returns tpm[s*3 + i] = next probability for cell i in state s ∈ {0,...,7}.
fn build_tpm(xor_mask: array) -> array {
    let n = 3
    let mut tpm = []
    let mut s = 0
    while s < 8 {
        let b0 = bit_at(s, 0)
        let b1 = bit_at(s, 1)
        let b2 = bit_at(s, 2)
        let xor3 = (b0 + b1 + b2) % 2
        let mut i = 0
        while i < n {
            if xor_mask[i] == 1 { tpm = tpm.push(to_float(xor3)) }
            else {
                let mut cell_val = b0
                if i == 1 { cell_val = b1 }
                if i == 2 { cell_val = b2 }
                tpm = tpm.push(to_float(cell_val))
            }
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

// Marginal entropy over the (T,S1,S2,S3) 16-bin joint, masked by `mask`.
// Encoding: bit3=T(8), bit2=S0(4), bit1=S1(2), bit0=S2(1). counts indexed 0..15.
fn marg_entropy(counts: array, mask: int, total: float) -> float {
    let mut sub = []
    let mut z = 0
    while z < 16 { sub = sub.push(0); z = z + 1 }
    let mut k = 0
    while k < 16 {
        let key = k & mask
        sub[key] = sub[key] + counts[k]
        k = k + 1
    }
    let mut h = 0.0
    let mut j = 0
    while j < 16 {
        if sub[j] > 0 { let p = to_float(sub[j]) / total; h = h - p * log2(p) }
        j = j + 1
    }
    return h
}

// 3-source net co-information for cell i:
//   II_3 = I(T;S0) + I(T;S1) + I(T;S2)
//        - I(T;S0,S1) - I(T;S0,S2) - I(T;S1,S2)
//        + I(T;S0,S1,S2)
// Each I(T;X) = H(T) + H(X) - H(T,X). Computed from (T,S0,S1,S2) joint
// over uniform 2^3 ensemble of source states (8 source states, each appears once).
fn co_info_3(tpm: array, cell_i: int) -> float {
    let mut counts = []
    let mut z = 0
    while z < 16 { counts = counts.push(0); z = z + 1 }
    let mut s = 0
    while s < 8 {
        let s0 = bit_at(s, 0)
        let s1 = bit_at(s, 1)
        let s2 = bit_at(s, 2)
        let mut t = 0
        if tpm[s * 3 + cell_i] > 0.5 { t = 1 }
        // index: 8*T + 4*s0 + 2*s1 + s2
        let idx = 8 * t + 4 * s0 + 2 * s1 + s2
        counts[idx] = counts[idx] + 1
        s = s + 1
    }
    let tot = 8.0
    // entropies — masks: T=8, S0=4, S1=2, S2=1
    let h_t   = marg_entropy(counts, 8, tot)
    let h_s0  = marg_entropy(counts, 4, tot)
    let h_s1  = marg_entropy(counts, 2, tot)
    let h_s2  = marg_entropy(counts, 1, tot)
    let h_t_s0  = marg_entropy(counts, 8 + 4, tot)
    let h_t_s1  = marg_entropy(counts, 8 + 2, tot)
    let h_t_s2  = marg_entropy(counts, 8 + 1, tot)
    let h_s0_s1 = marg_entropy(counts, 4 + 2, tot)
    let h_s0_s2 = marg_entropy(counts, 4 + 1, tot)
    let h_s1_s2 = marg_entropy(counts, 2 + 1, tot)
    let h_t_s0_s1 = marg_entropy(counts, 8 + 4 + 2, tot)
    let h_t_s0_s2 = marg_entropy(counts, 8 + 4 + 1, tot)
    let h_t_s1_s2 = marg_entropy(counts, 8 + 2 + 1, tot)
    let h_s0_s1_s2   = marg_entropy(counts, 4 + 2 + 1, tot)
    let h_t_s0_s1_s2 = marg_entropy(counts, 8 + 4 + 2 + 1, tot)
    // I(T;X) = H(T) + H(X) - H(T,X)
    let i_t_s0 = h_t + h_s0 - h_t_s0
    let i_t_s1 = h_t + h_s1 - h_t_s1
    let i_t_s2 = h_t + h_s2 - h_t_s2
    let i_t_s0s1 = h_t + h_s0_s1 - h_t_s0_s1
    let i_t_s0s2 = h_t + h_s0_s2 - h_t_s0_s2
    let i_t_s1s2 = h_t + h_s1_s2 - h_t_s1_s2
    let i_t_s0s1s2 = h_t + h_s0_s1_s2 - h_t_s0_s1_s2
    // 3-source net co-information — SINGLE-LINE expr (multi-line leading-op
    // arithmetic miscompiles silently in hexa-lang; cf MEMORY feedback-hexa-
    // multiline-expr-miscompute, anima INBOX #1127).
    let ii3 = (i_t_s0 + i_t_s1 + i_t_s2) - (i_t_s0s1 + i_t_s0s2 + i_t_s1s2) + i_t_s0s1s2
    return ii3
}

// Hivemind totals: per-cell synergy / redundancy, summed across the 3 cells.
// 3-source sign convention: II_3 > 0 = synergy, II_3 < 0 = redundancy.
fn syn_total(xor_mask: array) -> float {
    let tpm = build_tpm(xor_mask)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii > 0.0 { acc = acc + ii }
        i = i + 1
    }
    return acc
}
fn red_total(xor_mask: array) -> float {
    let tpm = build_tpm(xor_mask)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii < 0.0 { acc = acc - ii }
        i = i + 1
    }
    return acc
}

// All 3-bit masks with exactly k ones (k = number of XOR cells).
// Returns 5 representative permutations across K-buckets; specific:
//   K=0   : [[0,0,0]]                                                — 1 mask
//   K=1/3 : [[1,0,0],[0,1,0],[0,0,1]]                                — 3 masks
//   K=2/3 : [[1,1,0],[1,0,1],[0,1,1]]                                — 3 masks
//   K=1   : [[1,1,1]]                                                — 1 mask
// We treat each permutation as one "seed" (substrate-level invariance check).
fn k_bucket_masks(k_count: int) -> array {
    if k_count == 0 { return [[0, 0, 0]] }
    if k_count == 1 { return [[1, 0, 0], [0, 1, 0], [0, 0, 1]] }
    if k_count == 2 { return [[1, 1, 0], [1, 0, 1], [0, 1, 1]] }
    return [[1, 1, 1]]
}

fn k_label(k_count: int) -> string {
    if k_count == 0 { return "K=0.00" }
    if k_count == 1 { return "K=0.33" }
    if k_count == 2 { return "K=0.67" }
    return "K=1.00"
}

// Bucket mean (synergy, redundancy, ratio) across all permutations.
// returns [mean_syn, mean_red, mean_ratio, n_perms]
fn bucket_mean(k_count: int) -> array {
    let masks = k_bucket_masks(k_count)
    let m = len(masks)
    let mut s_sum = 0.0
    let mut r_sum = 0.0
    let mut ratio_sum = 0.0
    let mut i = 0
    while i < m {
        let mask = masks[i]
        let s = syn_total(mask)
        let r = red_total(mask)
        let denom = s + r
        let mut ratio = 0.0
        if denom > 0.000000001 { ratio = s / denom }
        s_sum = s_sum + s
        r_sum = r_sum + r
        ratio_sum = ratio_sum + ratio
        i = i + 1
    }
    return [s_sum / to_float(m), r_sum / to_float(m), ratio_sum / to_float(m), to_float(m)]
}

fn main() {
    println("================================================================")
    println("  H_355 — Collective Φ PID synergy vs redundancy (hivemind axis F1)")
    println("  (II_3 net 3-source co-info per cell; II<0=synergy, >0=redundancy)")
    println("  Substrate: 3 binary substrates × 1 cell · 8-state · coupling K density")
    println("================================================================")

    // ── Per-K-bucket measurement, seed = permutation across the 3 cells ──
    let mut all_syn = []
    let mut all_red = []
    let mut all_ratio = []
    let mut all_perms_total = 0
    let mut k_count = 0
    while k_count < 4 {
        let label = k_label(k_count)
        let masks = k_bucket_masks(k_count)
        let m = len(masks)
        let mut i = 0
        while i < m {
            let mask = masks[i]
            let s = syn_total(mask)
            let r = red_total(mask)
            let denom = s + r
            let mut ratio = 0.0
            if denom > 0.000000001 { ratio = s / denom }
            println("  " + label + " mask=" + str(mask) + " synergy=" + str(s) + " redundancy=" + str(r) + " ratio=" + str(ratio))
            all_syn = all_syn.push(s)
            all_red = all_red.push(r)
            all_ratio = all_ratio.push(ratio)
            i = i + 1
        }
        all_perms_total = all_perms_total + m
        k_count = k_count + 1
    }

    // ── Bucket means ──
    println("  --")
    let mean_k0 = bucket_mean(0)
    let mean_k1 = bucket_mean(1)
    let mean_k2 = bucket_mean(2)
    let mean_k3 = bucket_mean(3)
    println("  K=0.00 (anchor)  mean_syn=" + str(mean_k0[0]) + " mean_red=" + str(mean_k0[1]) + " mean_ratio=" + str(mean_k0[2]))
    println("  K=0.33           mean_syn=" + str(mean_k1[0]) + " mean_red=" + str(mean_k1[1]) + " mean_ratio=" + str(mean_k1[2]))
    println("  K=0.67           mean_syn=" + str(mean_k2[0]) + " mean_red=" + str(mean_k2[1]) + " mean_ratio=" + str(mean_k2[2]))
    println("  K=1.00 (anchor)  mean_syn=" + str(mean_k3[0]) + " mean_red=" + str(mean_k3[1]) + " mean_ratio=" + str(mean_k3[2]))

    // ── Aggregate over non-trivial K (K=0.33, 0.67, 1.00) for F355.3 verdict ──
    let mean_nontrivial = (mean_k1[2] + mean_k2[2] + mean_k3[2]) / 3.0
    println("  --")
    println("  F355.3 mean synergy_ratio over non-trivial K {0.33,0.67,1.00} = " + str(mean_nontrivial))
    let synergy_dominant = mean_nontrivial > 0.5
    if synergy_dominant { println("          => SYNERGY > REDUNDANCY (mean ratio > 0.5)") }
    else { println("          => REDUNDANCY ≥ SYNERGY or trivial (ratio ≤ 0.5)") }

    // ── F355.1 PURE-SYNERGY ANCHOR (K=1, mask=[1,1,1]) ───────────────────
    check("F355.1 K=1 pure-XOR: synergy>0 AND redundancy=0", (mean_k3[0] > 0.000001) && approx(mean_k3[1], 0.0))

    // ── F355.2 PURE-IDENTITY ANCHOR (K=0, mask=[0,0,0]) ──────────────────
    check("F355.2 K=0 pure-identity: synergy=0 AND redundancy=0", approx(mean_k0[0], 0.0) && approx(mean_k0[1], 0.0))

    // ── F355.4 K-MONOTONIC ───────────────────────────────────────────────
    let mono = (mean_k0[0] <= mean_k1[0] + 0.000001) && (mean_k1[0] <= mean_k2[0] + 0.000001) && (mean_k2[0] <= mean_k3[0] + 0.000001)
    check("F355.4 K-MONOTONIC: synergy(K=0) ≤ synergy(K=0.33) ≤ synergy(K=0.67) ≤ synergy(K=1)", mono)

    // ── F355.5 BOUND + DETERMINISM ───────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < all_perms_total {
        if !(all_syn[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(all_red[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(all_syn[b] <= 3.0 + 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F355.5a BOUND: 0 ≤ synergy ≤ 3, redundancy ≥ 0 across all 8 permutations", bound_ok)
    let k1_mask = [1, 1, 1]
    check("F355.5b DETERMINISM: K=1 synergy re-run byte-identical", approx(syn_total(k1_mask), mean_k3[0]))

    // ── F355.3 VERDICT (clause check separate from F PASS counter so verdict is reported VERBATIM) ──
    println("  F355.3 synergy_ratio verdict (verbatim): mean_nontrivial_K=" + str(mean_nontrivial))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL  (n_perms=" + str(all_perms_total) + ")")
    println("  mean ratio non-trivial K = " + str(mean_nontrivial))
    if synergy_dominant {
        println("  VERDICT: H1 SUPPORTED — collective-Φ flow is SYNERGY-dominant across the")
        println("           coupling K sweep on this hivemind toy. Cross-substrate joint")
        println("           information dominates the redundancy share.")
    } else {
        println("  VERDICT: H1 FALSIFIED — collective-Φ flow is NOT synergy-dominant across")
        println("           the K sweep (mean ratio ≤ 0.5 or both totals trivial). Net 3-source")
        println("           co-information does not reach majority synergy.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_355 had FALSIFIER FAILURES") }
}
