// UNIVERSE/state/h609_collective_phi_super_additive_2026_05_28/run_h609.hexa
//
//   H_609 — Collective Φ super-additivity: Φ(AB) > Φ(A) + Φ(B)?
//   axis F1 round 2 re-fire (round 1 H_352 monitor-hang lost verdict).
//
//   sister: H_355 PID synergy 🟢 (axis F1 round 1 same axis sister).
//   cross-link: H_054 symbiogenesis · H_157 panpsychism combination ·
//               H_293 PID synergy · H_295 exclusion complex.
//
//   QUESTION
//     Two substrates A (n_a=3 cells, ECA rule) and B (n_b=3 cells, ECA rule)
//     coupled at strength W ∈ {0.0, 0.3, 0.6, 1.0} into a joint substrate AB
//     (n=6 cells). At W=0 the two halves are decoupled (cell 0's left
//     neighbor = cell 2 wrap-within-A, cell 3's left = cell 5 wrap-within-B);
//     at W=1 the boundary edges are restored (cell 0's left = cell 5,
//     cell 3's left = cell 2, full n=6 ring). Intermediate W mixes
//     deterministic next-cell probabilities:
//       tpm_AB[s*6+i] = (1-W)*next_decoupled(s,i) + W*next_coupled(s,i)
//     Measure big-Φ of A alone, B alone, and AB at each W, sweep rules
//     {90, 110} as 5 (rule_a, rule_b) pairs. Excess Δ = Φ(AB) - (Φ(A)+Φ(B)).
//
//   H1: ∃ W>0 s.t. Δ > 0 (super-additive — coupling creates integrated info)
//   H0 (FALSIFIER): Δ ≤ 0 for all W (sub-additive or additive only — no
//     emergent integration from coupling on this substrate class).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-28, BEFORE measuring)
//     F609.1 DECOUPLED-ANCHOR (W=0):  Φ(AB) ≈ 0 (bipartition is loss-free)
//            ⇒ Δ(W=0) ≈ -(Φ(A)+Φ(B)) ≤ 0  (anchor must hold)
//     F609.2 SUPER-ADDITIVITY (H1):   max_{W>0, rule-pair} Δ > 0
//     F609.3 W-MONOTONIC TENDENCY:    Δ non-decreasing on average across
//            W ∈ {0, 0.3, 0.6, 1.0} (more coupling ⇒ more integration)
//     F609.4 BOUNDS+DETERMINISM:      Φ ≥ 0 everywhere · re-run byte-identical
//
//   SUBSTRATE
//     rule pairs (5):  (90,90) · (110,110) · (90,110) · (110,90) · (90,150)
//     n_a=n_b=3 · ECA · sys_state = 0 (all-zeros init, IIT4-canonical anchor)
//     IIT4 engine: big_phi_bounded(tpm, n, sys_state, cap=2) for n=6 tractability,
//     cap=3 for n=3 (no-op, faithful big_phi byte-equal).
//
//   deterministic · hexa-only · $0 mac-local · no GPU · no LLM.
//   honest scope:
//     • bounded-cap (cap=2 on n=6) — purview search capped; cap=2 is the
//       SSOT for n≥6 IIT4 measurements in this repo (M4b precedent).
//     • sys_state=0 only (no full state-marginal) — comparable across A/B/AB.
//     • 5 rule pairs · 4 W buckets · single seed per (pair,W) — deterministic.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn approx(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < tol }
    return d < tol
}

// ── n=3 ECA TPM (decoupled half builder, also used for Φ(A), Φ(B)) ──
fn eca_tpm_n3(rule: int) -> array {
    let n = 3
    let mut t = []
    let mut s = 0
    while s < 8 {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            t = t.push(to_float(iit4_bit(rule, idx)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── n=6 coupled-ring TPM with weight W gating cross-half edges. ──
//
// Half A = cells {0,1,2} under rule_a · Half B = cells {3,4,5} under rule_b.
// Within-half neighbors (default, "decoupled" view):
//   cell 0: L=2, R=1  (wrap inside A)
//   cell 1: L=0, R=2
//   cell 2: L=1, R=0  (wrap inside A)
//   cell 3: L=5, R=4  (wrap inside B)
//   cell 4: L=3, R=5
//   cell 5: L=4, R=3  (wrap inside B)
// Coupled (full n=6 ring) neighbors:
//   cell 0: L=5, R=1
//   cell 1: L=0, R=2
//   cell 2: L=1, R=3
//   cell 3: L=2, R=4
//   cell 4: L=3, R=5
//   cell 5: L=4, R=0
// Boundary cells {0,2,3,5} have differing left or right neighbor between the
// two views; interior cells {1,4} are identical. For each cell, compute
// next under both views then blend: p_next = (1-W)*p_dec + W*p_cou.
fn build_tpm_ab(rule_a: int, rule_b: int, W: float) -> array {
    let n = 6
    let full = 64
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let b0 = iit4_bit(s, 0)
        let b1 = iit4_bit(s, 1)
        let b2 = iit4_bit(s, 2)
        let b3 = iit4_bit(s, 3)
        let b4 = iit4_bit(s, 4)
        let b5 = iit4_bit(s, 5)
        let mut i = 0
        while i < n {
            // pick rule by half
            let mut rule = rule_a
            if i >= 3 { rule = rule_b }
            // decoupled neighbors
            let mut l_dec = 0
            let mut c_dec = 0
            let mut r_dec = 0
            if i == 0 { l_dec = b2; c_dec = b0; r_dec = b1 }
            if i == 1 { l_dec = b0; c_dec = b1; r_dec = b2 }
            if i == 2 { l_dec = b1; c_dec = b2; r_dec = b0 }
            if i == 3 { l_dec = b5; c_dec = b3; r_dec = b4 }
            if i == 4 { l_dec = b3; c_dec = b4; r_dec = b5 }
            if i == 5 { l_dec = b4; c_dec = b5; r_dec = b3 }
            let idx_dec = 4 * l_dec + 2 * c_dec + r_dec
            let next_dec = iit4_bit(rule, idx_dec)
            // coupled neighbors (full ring)
            let mut l_cou = 0
            let mut c_cou = 0
            let mut r_cou = 0
            if i == 0 { l_cou = b5; c_cou = b0; r_cou = b1 }
            if i == 1 { l_cou = b0; c_cou = b1; r_cou = b2 }
            if i == 2 { l_cou = b1; c_cou = b2; r_cou = b3 }
            if i == 3 { l_cou = b2; c_cou = b3; r_cou = b4 }
            if i == 4 { l_cou = b3; c_cou = b4; r_cou = b5 }
            if i == 5 { l_cou = b4; c_cou = b5; r_cou = b0 }
            let idx_cou = 4 * l_cou + 2 * c_cou + r_cou
            let next_cou = iit4_bit(rule, idx_cou)
            // blend
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── Measure Φ at sys_state=0 ──
fn phi_n3(rule: int) -> float {
    let tpm = eca_tpm_n3(rule)
    let r = big_phi_bounded(tpm, 3, 0, 3)
    return r[0]
}
fn phi_ab(rule_a: int, rule_b: int, W: float) -> float {
    let tpm = build_tpm_ab(rule_a, rule_b, W)
    let r = big_phi_bounded(tpm, 6, 0, 2)
    return r[0]
}

fn rule_pair_label(idx: int) -> string {
    if idx == 0 { return "(90,90)" }
    if idx == 1 { return "(110,110)" }
    if idx == 2 { return "(90,110)" }
    if idx == 3 { return "(110,90)" }
    return "(90,150)"
}
fn rule_a_at(idx: int) -> int {
    if idx == 0 { return 90 }
    if idx == 1 { return 110 }
    if idx == 2 { return 90 }
    if idx == 3 { return 110 }
    return 90
}
fn rule_b_at(idx: int) -> int {
    if idx == 0 { return 90 }
    if idx == 1 { return 110 }
    if idx == 2 { return 110 }
    if idx == 3 { return 90 }
    return 150
}
fn w_at(j: int) -> float {
    if j == 0 { return 0.0 }
    if j == 1 { return 0.3 }
    if j == 2 { return 0.6 }
    return 1.0
}
fn w_label(j: int) -> string {
    if j == 0 { return "W=0.00" }
    if j == 1 { return "W=0.30" }
    if j == 2 { return "W=0.60" }
    return "W=1.00"
}

fn main() {
    println("================================================================")
    println("  H_609 — collective-Φ super-additive? Φ(AB) vs Φ(A)+Φ(B)")
    println("  axis F1 round 2 re-fire (round 1 H_352 monitor-hang lost verdict)")
    println("  IIT4 big_phi_bounded · n_a=n_b=3 · n_ab=6 · cap=2 (n=6) · sys=0")
    println("================================================================")

    // ── Sweep ──
    let mut max_excess = -1.0e9
    let mut max_excess_pair_idx = 0
    let mut max_excess_w_idx = 0
    let mut all_excess = []
    let mut w_sum_excess = [0.0, 0.0, 0.0, 0.0]
    let mut all_phi_a = []
    let mut all_phi_b = []
    let mut all_phi_ab = []

    let mut p = 0
    while p < 5 {
        let ra = rule_a_at(p)
        let rb = rule_b_at(p)
        let phi_a = phi_n3(ra)
        let phi_b = phi_n3(rb)
        let sum_ab = phi_a + phi_b
        println("  pair " + rule_pair_label(p) + " Φ(A)=" + str(phi_a) + " Φ(B)=" + str(phi_b) + " Φ(A)+Φ(B)=" + str(sum_ab))
        all_phi_a = all_phi_a.push(phi_a)
        all_phi_b = all_phi_b.push(phi_b)
        let mut j = 0
        while j < 4 {
            let W = w_at(j)
            let phi_ab_v = phi_ab(ra, rb, W)
            let delta = phi_ab_v - sum_ab
            all_phi_ab = all_phi_ab.push(phi_ab_v)
            all_excess = all_excess.push(delta)
            w_sum_excess[j] = w_sum_excess[j] + delta
            println("    " + w_label(j) + "  Φ(AB)=" + str(phi_ab_v) + "  Δ=Φ(AB)-Σ=" + str(delta))
            if delta > max_excess {
                max_excess = delta
                max_excess_pair_idx = p
                max_excess_w_idx = j
            }
            j = j + 1
        }
        p = p + 1
    }

    // ── Mean Δ per W ──
    println("  --")
    let mut j2 = 0
    while j2 < 4 {
        let mean_d = w_sum_excess[j2] / 5.0
        println("  " + w_label(j2) + "  mean Δ over 5 pairs = " + str(mean_d))
        j2 = j2 + 1
    }

    // ── max excess ──
    println("  --")
    println("  MAX EXCESS Δ = " + str(max_excess) + "  at pair " + rule_pair_label(max_excess_pair_idx) + " " + w_label(max_excess_w_idx))

    // ── F609.1 DECOUPLED-ANCHOR (W=0) — Δ should be ≤ 0 (Φ(AB)=0 expected) ──
    let mut w0_ok = true
    let mut k = 0
    while k < 5 {
        // index in all_excess: 4*k + 0
        let d0 = all_excess[4 * k]
        // φ(AB) at W=0 should be ~0 (loss-free bipartition along {0,1,2}|{3,4,5})
        // Δ(W=0) = -(Φ(A)+Φ(B)) ≤ 0
        if d0 > 0.000001 { w0_ok = false }
        k = k + 1
    }
    check("F609.1 W=0 anchor: Δ(W=0) ≤ 0 across all 5 pairs (decoupled ⇒ Φ(AB)=0)", w0_ok)

    // ── F609.2 SUPER-ADDITIVITY: ∃ pair, W>0 s.t. Δ > 0 ──
    let h1_supported = max_excess > 0.000001
    check("F609.2 SUPER-ADDITIVITY: max_excess Δ > 0 (across W>0)", h1_supported)

    // ── F609.3 W-MONOTONIC TENDENCY: mean Δ non-decreasing in W on average ──
    let mean0 = w_sum_excess[0] / 5.0
    let mean1 = w_sum_excess[1] / 5.0
    let mean2 = w_sum_excess[2] / 5.0
    let mean3 = w_sum_excess[3] / 5.0
    let mono = (mean0 <= mean1 + 0.000001) && (mean1 <= mean2 + 0.000001) && (mean2 <= mean3 + 0.000001)
    check("F609.3 W-MONOTONIC: mean Δ non-decreasing W=0 ≤ 0.3 ≤ 0.6 ≤ 1.0", mono)

    // ── F609.4 BOUNDS + DETERMINISM ──
    let mut bnd_ok = true
    let mut m = 0
    while m < len(all_phi_a) {
        if all_phi_a[m] < 0.0 { bnd_ok = false }
        if all_phi_b[m] < 0.0 { bnd_ok = false }
        m = m + 1
    }
    let mut m2 = 0
    while m2 < len(all_phi_ab) {
        if all_phi_ab[m2] < 0.0 { bnd_ok = false }
        m2 = m2 + 1
    }
    check("F609.4a BOUNDS: Φ ≥ 0 everywhere", bnd_ok)
    // determinism: re-run pair 0 W=1.0
    let r0 = phi_ab(90, 90, 1.0)
    let r1 = phi_ab(90, 90, 1.0)
    check("F609.4b DETERMINISM: phi_ab(90,90,1.0) re-run byte-identical", approx(r0, r1, 0.0))

    // ── verdict ──
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  MAX EXCESS Δ = " + str(max_excess) + "  best pair " + rule_pair_label(max_excess_pair_idx) + " " + w_label(max_excess_w_idx))
    if h1_supported {
        println("  VERDICT: H1 SUPPORTED — collective Φ is SUPER-ADDITIVE on this hivemind")
        println("           substrate. Cross-half coupling W>0 produces Φ(AB) >")
        println("           Φ(A)+Φ(B) on at least one rule-pair × W cell.")
    } else {
        println("  VERDICT: H1 FALSIFIED — collective Φ is NOT super-additive. Across all")
        println("           5 rule-pairs × 4 W values, Φ(AB) ≤ Φ(A)+Φ(B) (sub- or additive).")
    }
    println("================================================================")
    if FAIL > 0 { println("  (anchor or det failures present — see [FAIL] lines above)") }
}
