// UNIVERSE/state/h627_gz_center_pid_synergy_2026_05_28/run_h627.hexa
//
//   H_627 — GZ_CENTER (I=1/e) × hivemind PID synergy singularity (E3 × F4 cell)
//
//   cross-link
//     • H_349 (axis E3, 🔴 FALSIFIED-PARTIAL) — GZ_CENTER = 1/e ≈ 0.36788 is the
//       I·ln(I) argmin / SAVANT "Golden Zone center". big-Φ single-peak at 1/e is
//       substrate-conditional (only rule90 sys=5 confirms; 3/4 monotone-decrease).
//     • H_619 (axis E×F r3, 🟢) — SAVANT inhibition I modulates hivemind PID
//       synergy_total; synergy plateau 2.0 for n_id≤2 (I≤0.30) then step-decay.
//       Substrate + inhibition row-collapse mapping inherited verbatim here.
//     • H_355 (axis F1, 🟢) — 3-binary hivemind PID synergy_ratio = 1.0 K-invariant.
//
//   QUESTION (E3 × F4 cross-link)
//     Is I = 1/e ≈ 0.3679 a SINGULARITY (a dip or a peak) of the PID synergy
//     modulation curve? i.e. is synergy_total(1/e) anomalous vs its immediate
//     neighbors {0.30, 0.35, 0.40, 0.45}? H_349 motivates 1/e as a SAVANT focal
//     point; H_619 showed the synergy modulation. H_627 adds the dense 1/e probe
//     to H_619's coarse sweep to test whether 1/e marks a non-smooth feature.
//
//   SUBSTRATE (H_619 inherit verbatim)
//     3 binary substrates × 1 cell = 8-state. canonical mask K=0.67 [1,1,0].
//     inhibition I → n_id = round(I*8) rows collapse XOR → identity-S0.
//
//   DENSE 1/e SWEEP (E3 focal)
//     I ∈ {0.30, 0.35, 0.36788 (=1/e ★), 0.40, 0.45}
//       n_id = round(I*8):  0.30→2 · 0.35→3 · 0.36788→3 · 0.40→3 · 0.45→4
//     So 1/e lands inside the n_id=3 step (shared with 0.35, 0.40). The
//     quantization (H_619 §7 L5) means a SINGULARITY would require 1/e to differ
//     from its same-n_id neighbors — which under deterministic row-collapse it
//     cannot. This pre-registers the EXPECTED falsification path honestly.
//
//   PRE-REGISTERED FALSIFIER (frozen 2026-05-28, BEFORE measuring)
//     F627.1 SINGULARITY-AT-1/e:
//       synergy_total(1/e) is a dip OR peak vs its neighbors — i.e. it is NOT the
//       linear-interpolated / locally-monotone value. Operationally: 1/e is a
//       strict local extremum of the dense 5-point synergy curve
//       {0.30, 0.35, 1/e, 0.40, 0.45}, OR |syn(1/e) − syn(neighbor in same n_id)|
//       ≥ 0.01 (anomaly within its quantization cell).
//     F627.2 NEIGHBOR-DISTINCT:
//       syn(1/e) ≠ syn(0.35) AND syn(1/e) ≠ syn(0.40) (the same-n_id neighbors).
//       If equal, 1/e is NOT special — it is degenerate with its quantization cell.
//     F627.3 MONOTONE-LOCAL:
//       the dense curve is monotone non-increasing across {0.30..0.45} (≤1 inv).
//       (control: confirms the H_619 global trend holds locally around 1/e.)
//     F627.4 H619-ANCHOR:
//       syn(0.30)=2.0 (plateau, H_619 table) AND syn(0.40)=0.975034 (n_id=3 step,
//       H_619 table) reproduced byte-identical.
//     F627.5 BOUND/DET:
//       0 ≤ syn ≤ 3 ; re-run 1/e byte-identical.
//     F627.6 POST-HOC: no verdict-direction edit after measurement (raw#82).
//
//   VERDICT_RULE
//     F627.1 PASS (1/e local extremum / anomalous) → 🟢 SUPPORTED (1/e singularity)
//     F627.1 FAIL flat (1/e degenerate w/ n_id cell) + F627.4 + F627.5 PASS
//                                                    → 🔴 FALSIFIED (no singularity)
//     mixed → 🟡 PARTIAL
//
//   honest scope (raw#91 c3)
//     • net 3-source McGill co-info (NOT full 18-atom WB lattice — H_355 L1 carry)
//     • toy 3-binary substrate (H_355 L4 carry — small N)
//     • row-collapse inhibition (one SAVANT-modulator mode — H_619 L2 carry)
//     • QUANTIZATION: round(I*8) coarsens I to 9 integer steps. 1/e (=2.943/8)
//       falls in n_id=3 with 0.35, 0.40 — a continuous (quantization-free) substrate
//       is required to resolve a TRUE 1/e singularity (H_619 L5 carry). H_627
//       measures the QUANTIZED curve as-is; if 1/e is degenerate it is a structural
//       (not numerical-noise) negative.
//     • PID-structure claim, NOT a collective-Φ tracking claim (H_355 L6 carry).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }

fn pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn bit_at(s: int, i: int) -> int {
    return (s / pow2(i)) % 2
}

// inhibition I → #identity-collapse-rows out of 8 (H_619 inherit, round-half-up).
fn inhibition_rows(I: float) -> int {
    let scaled = I * 8.0 + 0.5
    return to_int(scaled)
}

// Build TPM under (xor_mask, I) — H_619 inherit verbatim.
fn build_tpm_inhib(xor_mask: array, I: float) -> array {
    let n = 3
    let n_id = inhibition_rows(I)
    let mut tpm = []
    let mut s = 0
    while s < 8 {
        let b0 = bit_at(s, 0)
        let b1 = bit_at(s, 1)
        let b2 = bit_at(s, 2)
        let xor3 = (b0 + b1 + b2) % 2
        let mut i = 0
        while i < n {
            let mut nxt = 0
            if xor_mask[i] == 1 {
                if s < n_id { nxt = b0 }
                else { nxt = xor3 }
            } else {
                let mut cell_val = b0
                if i == 1 { cell_val = b1 }
                if i == 2 { cell_val = b2 }
                nxt = cell_val
            }
            tpm = tpm.push(to_float(nxt))
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn marg_entropy(counts: array, mask: int, total: float) -> float {
    let mut sub = []
    let mut z = 0
    while z < 16 { sub = sub.push(0); z = z + 1 }
    let mut k = 0
    while k < 16 {
        let key = k & mask
        sub[key] = sub[key] + counts[k]
        k = k + 1
    }
    let mut h = 0.0
    let mut j = 0
    while j < 16 {
        if sub[j] > 0 { let p = to_float(sub[j]) / total; h = h - p * log2(p) }
        j = j + 1
    }
    return h
}

fn co_info_3(tpm: array, cell_i: int) -> float {
    let mut counts = []
    let mut z = 0
    while z < 16 { counts = counts.push(0); z = z + 1 }
    let mut s = 0
    while s < 8 {
        let s0 = bit_at(s, 0)
        let s1 = bit_at(s, 1)
        let s2 = bit_at(s, 2)
        let mut t = 0
        if tpm[s * 3 + cell_i] > 0.5 { t = 1 }
        let idx = 8 * t + 4 * s0 + 2 * s1 + s2
        counts[idx] = counts[idx] + 1
        s = s + 1
    }
    let tot = 8.0
    let h_t   = marg_entropy(counts, 8, tot)
    let h_s0  = marg_entropy(counts, 4, tot)
    let h_s1  = marg_entropy(counts, 2, tot)
    let h_s2  = marg_entropy(counts, 1, tot)
    let h_t_s0  = marg_entropy(counts, 8 + 4, tot)
    let h_t_s1  = marg_entropy(counts, 8 + 2, tot)
    let h_t_s2  = marg_entropy(counts, 8 + 1, tot)
    let h_s0_s1 = marg_entropy(counts, 4 + 2, tot)
    let h_s0_s2 = marg_entropy(counts, 4 + 1, tot)
    let h_s1_s2 = marg_entropy(counts, 2 + 1, tot)
    let h_t_s0_s1 = marg_entropy(counts, 8 + 4 + 2, tot)
    let h_t_s0_s2 = marg_entropy(counts, 8 + 4 + 1, tot)
    let h_t_s1_s2 = marg_entropy(counts, 8 + 2 + 1, tot)
    let h_s0_s1_s2   = marg_entropy(counts, 4 + 2 + 1, tot)
    let h_t_s0_s1_s2 = marg_entropy(counts, 8 + 4 + 2 + 1, tot)
    let i_t_s0 = h_t + h_s0 - h_t_s0
    let i_t_s1 = h_t + h_s1 - h_t_s1
    let i_t_s2 = h_t + h_s2 - h_t_s2
    let i_t_s0s1 = h_t + h_s0_s1 - h_t_s0_s1
    let i_t_s0s2 = h_t + h_s0_s2 - h_t_s0_s2
    let i_t_s1s2 = h_t + h_s1_s2 - h_t_s1_s2
    let i_t_s0s1s2 = h_t + h_s0_s1_s2 - h_t_s0_s1_s2
    // single-line (multi-line leading-op miscompile guard, MEMORY hexa-multiline)
    let ii3 = (i_t_s0 + i_t_s1 + i_t_s2) - (i_t_s0s1 + i_t_s0s2 + i_t_s1s2) + i_t_s0s1s2
    return ii3
}

fn syn_total_I(xor_mask: array, I: float) -> float {
    let tpm = build_tpm_inhib(xor_mask, I)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii > 0.0 { acc = acc + ii }
        i = i + 1
    }
    return acc
}
fn red_total_I(xor_mask: array, I: float) -> float {
    let tpm = build_tpm_inhib(xor_mask, I)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii < 0.0 { acc = acc - ii }
        i = i + 1
    }
    return acc
}

fn main() {
    println("================================================================")
    println("  H_627 — GZ_CENTER (I=1/e) × hivemind PID synergy singularity")
    println("  E3 (H_349 GZ_CENTER=1/e) × F4 (H_619 PID synergy modulation)")
    println("  Substrate: 3 binary substrates × 1 cell · K=0.67 mask=[1,1,0]")
    println("================================================================")

    let mask = [1, 1, 0]
    let E = 2.718281828459045
    let ONE_OVER_E = 1.0 / E
    println("  1/e = " + str(ONE_OVER_E))

    // ── DENSE 1/e sweep ───────────────────────────────────────────────────
    let i_sweep = [0.30, 0.35, ONE_OVER_E, 0.40, 0.45]
    let n_i = len(i_sweep)
    let mut syns = []
    let mut ratios = []
    let mut k = 0
    while k < n_i {
        let I = i_sweep[k]
        let s = syn_total_I(mask, I)
        let r = red_total_I(mask, I)
        let denom = s + r
        let mut ratio = 0.0
        if denom > 0.000000001 { ratio = s / denom }
        let n_id = inhibition_rows(I)
        let mut tag = ""
        if approx(I, ONE_OVER_E) { tag = "  ★ 1/e (GZ_CENTER)" }
        println("  I=" + str(I) + " n_id=" + str(n_id) + " synergy=" + str(s) + " redundancy=" + str(r) + " ratio=" + str(ratio) + tag)
        syns = syns.push(s)
        ratios = ratios.push(ratio)
        k = k + 1
    }

    // index 2 = 1/e
    let syn_030 = syns[0]
    let syn_035 = syns[1]
    let syn_1e  = syns[2]
    let syn_040 = syns[3]
    let syn_045 = syns[4]
    println("  --")
    println("  syn(0.30) = " + str(syn_030) + "  (n_id=2)")
    println("  syn(0.35) = " + str(syn_035) + "  (n_id=3)")
    println("  syn(1/e ) = " + str(syn_1e)  + "  (n_id=3)  ★")
    println("  syn(0.40) = " + str(syn_040) + "  (n_id=3)")
    println("  syn(0.45) = " + str(syn_045) + "  (n_id=4)")

    // ── F627.1 SINGULARITY-AT-1/e ────────────────────────────────────────
    // strict local extremum: syn(1/e) > both neighbors (peak) OR < both (dip)
    let is_peak = (syn_1e > syn_035 + 0.000001) && (syn_1e > syn_040 + 0.000001)
    let is_dip  = (syn_1e < syn_035 - 0.000001) && (syn_1e < syn_040 - 0.000001)
    // OR anomaly within same n_id cell (1/e differs from same-n_id neighbor 0.35)
    let mut anom = syn_1e - syn_035
    if anom < 0.0 { anom = 0.0 - anom }
    println("  F627.1 |syn(1/e) - syn(0.35 same n_id)| = " + str(anom))
    let singular = is_peak || is_dip || (anom >= 0.01)
    check("F627.1 SINGULARITY-AT-1/e (local extremum OR same-cell anomaly ≥ 0.01)", singular)

    // ── F627.2 NEIGHBOR-DISTINCT ─────────────────────────────────────────
    let distinct = !approx(syn_1e, syn_035) && !approx(syn_1e, syn_040)
    check("F627.2 NEIGHBOR-DISTINCT (syn(1/e) ≠ syn(0.35) AND ≠ syn(0.40))", distinct)

    // ── F627.3 MONOTONE-LOCAL ────────────────────────────────────────────
    let mut inv = 0
    let mut mi = 1
    while mi < n_i {
        if syns[mi] > syns[mi - 1] + 0.000001 { inv = inv + 1 }
        mi = mi + 1
    }
    println("  F627.3 local inversions = " + str(inv))
    check("F627.3 MONOTONE-LOCAL (dense curve non-increasing, ≤1 inversion)", inv <= 1)

    // ── F627.4 H619-ANCHOR ───────────────────────────────────────────────
    let anchor_030 = approx(syn_030, 2.0)
    let anchor_040 = approx(syn_040, 0.975034)
    println("  F627.4 syn(0.30)=" + str(syn_030) + " (exp 2.0) · syn(0.40)=" + str(syn_040) + " (exp 0.975034)")
    check("F627.4a H619-ANCHOR syn(0.30)=2.0 plateau", anchor_030)
    check("F627.4b H619-ANCHOR syn(0.40)=0.975034 (n_id=3 step)", anchor_040)

    // ── F627.5 BOUND/DET ─────────────────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < n_i {
        if !(syns[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(syns[b] <= 3.0 + 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F627.5a BOUND 0≤syn≤3 across dense sweep", bound_ok)
    let det_1e = syn_total_I(mask, ONE_OVER_E)
    check("F627.5b DETERMINISM 1/e re-run byte-identical", approx(det_1e, syn_1e))

    // ── Verdict ──────────────────────────────────────────────────────────
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL  (n_dense=" + str(n_i) + ")")
    if singular && distinct {
        println("  VERDICT: H1 SUPPORTED — I=1/e is a SINGULARITY of PID synergy.")
    } else {
        if !singular {
            println("  VERDICT: H1 FALSIFIED — I=1/e is NOT a singularity. It is degenerate")
            println("           with its round(I*8)=3 quantization cell (syn(1/e)=syn(0.35)=")
            println("           syn(0.40)); the 1/e focal value (H_349 E3) is INVISIBLE to the")
            println("           quantized hivemind PID modulation (H_619 F4). No dip/peak.")
        } else {
            println("  VERDICT: PARTIAL — anomaly seen but neighbor-distinctness incomplete.")
        }
    }
    println("================================================================")
    if FAIL > 0 { panic("H_627 had FALSIFIER FAILURES") }
}
