// ════════════════════════════════════════════════════════════════════════════
//  run_h639_thsweep.hexa — H_639 §7 C3 robustness: θ-threshold sensitivity sweep
//
//  PURPOSE
//    본 H 의 FALSIFIED 결론이 단일 θ=0.375 (I=0 mean amp) anchor 에 의존하는지
//    검정. θ ∈ {0.20, 0.30, 0.375, 0.45, 0.55} 5-grid 위에서 amplitude-cross
//    rate(I) 와 그 peak 위치 d(rate)/dI 를 재측정 — peak 가 어떤 θ 에서든
//    GZ_LOWER 또는 dΦ/dI peak (I=0.18) 와 일치하는지.
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/tmp/u-h639/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _rule() -> int { return 110 }
fn _n() -> int    { return 4 }

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total { out = out.push(base[k] * scale); k = k + 1 }
    return out
}

fn amp_of_state(tpm: array, n: int, s: int) -> float {
    let mut total = 0.0
    let mut i = 0
    while i < n {
        let cur = iit4_bit(s, i)
        let p = tpm[s * n + i]
        if cur == 1 { total = total + (1.0 - p) } else { total = total + p }
        i = i + 1
    }
    return total / to_float(n)
}

fn cross_rate(tpm: array, n: int, theta: float) -> float {
    let full = iit4_pow2(n)
    let mut hits = 0
    let mut s = 0
    while s < full { if amp_of_state(tpm, n, s) > theta { hits = hits + 1 } s = s + 1 }
    return to_float(hits) / to_float(full)
}

fn main() {
    println("── H_639 θ-sensitivity sweep (FALSIFIED robustness) ──")
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]
    let m = len(grid)
    let thetas = [0.20, 0.30, 0.375, 0.45, 0.55]
    let nt = len(thetas)

    let mut ti = 0
    while ti < nt {
        let theta = thetas[ti]
        // cross_rate(I)
        let mut rate = []
        let mut i = 0
        while i < m {
            let tpm = mixed_tpm(_rule(), _n(), grid[i])
            rate = rate.push(cross_rate(tpm, _n(), theta))
            i = i + 1
        }
        // d(rate)/dI
        let mut drate = []
        let mut k = 0
        while k < m {
            let mut d = 0.0
            if k == 0 { d = (rate[1]-rate[0])/(grid[1]-grid[0]) }
            else if k == m-1 { d = (rate[m-1]-rate[m-2])/(grid[m-1]-grid[m-2]) }
            else { d = (rate[k+1]-rate[k-1])/(grid[k+1]-grid[k-1]) }
            drate = drate.push(d)
            k = k + 1
        }
        // peak
        let mut pk = 0
        let mut pm = _abs(drate[0])
        let mut q = 1
        while q < m {
            let mg = _abs(drate[q])
            if mg > pm { pm = mg; pk = q }
            q = q + 1
        }
        println("  θ=" + str(theta) + "  peak_I_amp=" + str(grid[pk]) + "  |peak d(rate)/dI|=" + str(pm) + "  rate[0]=" + str(rate[0]) + "  rate[last]=" + str(rate[m-1]))
        ti = ti + 1
    }
    println("  (dΦ/dI peak = I=0.18 ; GZ_LOWER = 0.21232 ; tol 0.05)")
    println("── sweep done ──")
}
