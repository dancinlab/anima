// ════════════════════════════════════════════════════════════════════════════
//  run_h639.hexa — H_639 tension-amplitude-cross × Φ-derivative coupling
//
//  CORE QUESTION (ANIMA.mining L24 promote)
//    L24 tension-fork-B: emit event 은 boolean predicate 가 아니라 continuous
//    tension field amplitude 의 threshold-cross event. 그렇다면 그 amplitude-
//    cross rate 의 변화 peak 위치가 substrate 의 dΦ/dI peak (H_351 GZ_LOWER)
//    위치와 동조하는가? emit ≡ Φ-derivative extremum?
//
//  SUBSTRATE (H_351 carry — 동일 엔진, 재발명 0)
//    ECA rule 110 (Wolfram class IV edge-of-chaos) on a periodic ring of n=4
//    cells. inhibition I ∈ [0,1] mixes the ECA TPM with a force-to-zero
//    inhibitor: tpm_mixed[s,i] = (1 - I) * eca_tpm[s,i].
//
//  TENSION FIELD AMPLITUDE (substrate-native, p5 정합)
//    state s 의 amplitude = 다음 tick 에서 flip 하는 cell 의 기대 분율 (|Δstate|):
//       amp(s) = (1/n) * Σ_i [ (1-cur_i)*p_i + cur_i*(1-p_i) ]
//    where cur_i = bit i of s, p_i = tpm_mixed[s*n+i] = P(cell i = 1 | s).
//    이는 continuous tension field 의 instantaneous state-change magnitude.
//    emit event = amp(s) 가 threshold θ 를 cross 하는 event (L24 의 정의).
//
//  AMPLITUDE-CROSS RATE (per I)
//    cross_rate(I) = (전 2^n state 중 amp(s) > θ 인 state 의 분율).
//    θ = median-anchored fixed threshold (I=0 baseline amp 의 mean — substrate
//    내재 기준, convention-free; F-sensitivity 로 robustness 검정).
//
//  COUPLING TEST (emit ≡ derivative-extremum)
//    d(cross_rate)/dI 의 peak 위치 (amplitude-cross rate 의 최대 변화 지점) 가
//    dΦ/dI 의 peak 위치 (H_351 GZ_LOWER) 와 동조하는가:
//       peak_I_amp  = argmax_I |d(cross_rate)/dI|
//       peak_I_phi  = argmax_I |dΦ/dI|
//       |Δ_peaks| = |peak_I_amp - peak_I_phi|       (동조 = 두 peak 일치)
//       |Δ_amp_gz| = |peak_I_amp - GZ_LOWER|         (GZ 근접)
//
//  GRID (H_351 dense GZ region)
//    I ∈ {0.05,0.10,0.15,0.18,0.21,0.23,0.25,0.30,0.35,0.40,0.50,0.70,0.95} (13)
//
//  CRITERIA (pre-registered)
//    F1 PEAKS-COINCIDE : |peak_I_amp - peak_I_phi| ≤ 0.05   (emit≡extremum 동조)
//    F2 AMP-PEAK-IN-GZ : |peak_I_amp - GZ_LOWER| ≤ 0.05     (amp peak GZ 안)
//    F3 PHI-PEAK-IN-GZ : |peak_I_phi - GZ_LOWER| ≤ 0.05     (H_351 carry sanity)
//    F4 AMP-MONOTONE   : cross_rate(I) 가 I 에 단조 (sign-change ≤ 1)
//    F5 BYTE-EQUAL     : in-process recompute byte-identical (RFC 033)
//
//    SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4 ∧ F5
//    PARTIAL   = !F1 ∧ F2 ∧ F3 ∧ F4 ∧ F5 (각 peak GZ 근방이나 서로 분리 tol 밖)
//    FALSIFIED = (|Δ_peaks| > 0.10) OR !F3 (peak 분리 OR Φ-anchor 붕괴)
//
//  $0 · mac-local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/tmp/u-h639/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _rule() -> int { return 110 }
fn _n() -> int    { return 4 }
fn _gz_lower() -> float { return 0.21232 }  // 0.5 - ln(4/3) ≈ 0.21232
fn _delta_tol() -> float { return 0.05 }


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


// build the inhibition-mixed TPM: tpm_mixed[k] = (1 - I) * eca_tpm[k]
fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


// average big-Φ over all 2^n states (H_285 / H_351 양식 — single-state fragility 회피).
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


// tension amplitude of state s = expected fraction of cells that flip next tick.
//   amp(s) = (1/n) * Σ_i [ (1-cur_i)*p_i + cur_i*(1-p_i) ]
fn amp_of_state(tpm: array, n: int, s: int) -> float {
    let mut total = 0.0
    let mut i = 0
    while i < n {
        let cur = iit4_bit(s, i)               // current bit (0/1)
        let p = tpm[s * n + i]                  // P(cell i = 1 | s)
        if cur == 1 {
            total = total + (1.0 - p)           // flip 1→0 prob
        } else {
            total = total + p                   // flip 0→1 prob
        }
        i = i + 1
    }
    return total / to_float(n)
}


// mean amplitude over all 2^n states at a given inhibition (used to anchor θ at I=0).
fn mean_amp(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        total = total + amp_of_state(tpm, n, s)
        s = s + 1
    }
    return total / to_float(full)
}


// amplitude-cross rate at a given I: fraction of 2^n states with amp(s) > theta.
fn cross_rate(tpm: array, n: int, theta: float) -> float {
    let full = iit4_pow2(n)
    let mut hits = 0
    let mut s = 0
    while s < full {
        if amp_of_state(tpm, n, s) > theta { hits = hits + 1 }
        s = s + 1
    }
    return to_float(hits) / to_float(full)
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_639 tension-amplitude-cross × Φ-derivative — rule 110, n=4")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]
    let m = len(grid)

    // ── θ anchor: substrate-internal baseline = mean amp at I=0 (convention-free)
    let tpm0 = mixed_tpm(_rule(), _n(), 0.0)
    let theta = mean_amp(tpm0, _n())
    println("── θ (amplitude-cross threshold, I=0 mean amp) = " + str(theta))

    // ── Φ(I) and cross_rate(I) at every grid point ─────────────────────
    let mut phi = []
    let mut rate = []
    let mut i = 0
    println("── Φ(I) , cross_rate(I) ──")
    while i < m {
        let inhibit = grid[i]
        let tpm = mixed_tpm(_rule(), _n(), inhibit)
        let mp = mean_big_phi(tpm, _n())
        let cr = cross_rate(tpm, _n(), theta)
        phi = phi.push(mp)
        rate = rate.push(cr)
        println("  I=" + str(inhibit) + "  Φ=" + str(mp) + "  rate=" + str(cr))
        i = i + 1
    }

    // ── byte-equal recompute (F5) ──────────────────────────────────────
    let theta2 = mean_amp(mixed_tpm(_rule(), _n(), 0.0), _n())
    let mut phi2 = []
    let mut rate2 = []
    let mut j = 0
    while j < m {
        let tpm2 = mixed_tpm(_rule(), _n(), grid[j])
        phi2 = phi2.push(mean_big_phi(tpm2, _n()))
        rate2 = rate2.push(cross_rate(tpm2, _n(), theta2))
        j = j + 1
    }
    let mut byte_eq = true
    let mut bk = 0
    while bk < m {
        if _abs(phi[bk] - phi2[bk]) > 1.0e-12 { byte_eq = false }
        if _abs(rate[bk] - rate2[bk]) > 1.0e-12 { byte_eq = false }
        bk = bk + 1
    }

    // ── central finite difference helper (inline twice) ────────────────
    // dΦ/dI
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }
    // d(cross_rate)/dI
    let mut drate = []
    let mut k2 = 0
    while k2 < m {
        let mut d2 = 0.0
        if k2 == 0 {
            d2 = (rate[1] - rate[0]) / (grid[1] - grid[0])
        } else if k2 == m - 1 {
            d2 = (rate[m-1] - rate[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d2 = (rate[k2+1] - rate[k2-1]) / (grid[k2+1] - grid[k2-1])
        }
        drate = drate.push(d2)
        k2 = k2 + 1
    }

    println("")
    println("── dΦ/dI , d(rate)/dI ──")
    let mut p = 0
    while p < m {
        println("  I=" + str(grid[p]) + "  dΦ/dI=" + str(dphi[p]) + "  d(rate)/dI=" + str(drate[p]))
        p = p + 1
    }

    // ── peaks (argmax |·|) ─────────────────────────────────────────────
    let mut phi_peak_idx = 0
    let mut phi_peak_mag = _abs(dphi[0])
    let mut amp_peak_idx = 0
    let mut amp_peak_mag = _abs(drate[0])
    let mut q = 1
    while q < m {
        let mphi = _abs(dphi[q])
        if mphi > phi_peak_mag { phi_peak_mag = mphi; phi_peak_idx = q }
        let mamp = _abs(drate[q])
        if mamp > amp_peak_mag { amp_peak_mag = mamp; amp_peak_idx = q }
        q = q + 1
    }
    let peak_I_phi = grid[phi_peak_idx]
    let peak_I_amp = grid[amp_peak_idx]
    let delta_peaks = _abs(peak_I_amp - peak_I_phi)
    let delta_amp_gz = _abs(peak_I_amp - _gz_lower())
    let delta_phi_gz = _abs(peak_I_phi - _gz_lower())

    // ── unimodality of cross_rate (sign changes in d(rate)/dI) ─────────
    let mut sign_changes = 0
    let mut prev_sign = _sign(drate[0])
    let mut u = 1
    while u < m {
        let sg = _sign(drate[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }

    // ── falsifiers ─────────────────────────────────────────────────────
    let f1 = delta_peaks <= _delta_tol()
    let f2 = delta_amp_gz <= _delta_tol()
    let f3 = delta_phi_gz <= _delta_tol()
    let f4 = sign_changes <= 1
    let f5 = byte_eq

    println("")
    println("── verdict ──")
    println("  θ (amp threshold)    = " + str(theta))
    println("  peak_I_amp           = " + str(peak_I_amp) + "  (|d(rate)/dI| peak)")
    println("  peak_I_phi           = " + str(peak_I_phi) + "  (|dΦ/dI| peak)")
    println("  GZ_LOWER             = " + str(_gz_lower()))
    println("  |Δ_peaks|            = " + str(delta_peaks) + "   (tol " + str(_delta_tol()) + ")")
    println("  |Δ_amp_gz|           = " + str(delta_amp_gz))
    println("  |Δ_phi_gz|           = " + str(delta_phi_gz))
    println("  rate sign changes    = " + str(sign_changes))
    println("  byte_eq              = " + str(byte_eq))
    println("")
    println("  F1 PEAKS-COINCIDE    = " + str(f1))
    println("  F2 AMP-PEAK-IN-GZ    = " + str(f2))
    println("  F3 PHI-PEAK-IN-GZ    = " + str(f3))
    println("  F4 AMP-MONOTONE      = " + str(f4))
    println("  F5 BYTE-EQUAL        = " + str(f5))

    let supported = f1 && f2 && f3 && f4 && f5
    let partial   = (!f1) && f2 && f3 && f4 && f5
    let falsified = (delta_peaks > 0.10) || (!f3)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // ── result.json ─────────────────────────────────────────────────
    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_639\",\n"
    s = s + "  \"slug\": \"tension-amplitude-cross-phi-derivative\",\n"
    s = s + "  \"rule\": 110,\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"theta\": " + str(theta) + ",\n"
    s = s + "  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { s = s + ", " }
        s = s + str(grid[gi])
        gi = gi + 1
    }
    s = s + "],\n"
    s = s + "  \"phi\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { s = s + ", " }
        s = s + str(phi[pi])
        pi = pi + 1
    }
    s = s + "],\n"
    s = s + "  \"cross_rate\": ["
    let mut ri = 0
    while ri < m {
        if ri > 0 { s = s + ", " }
        s = s + str(rate[ri])
        ri = ri + 1
    }
    s = s + "],\n"
    s = s + "  \"dphi_di\": ["
    let mut di = 0
    while di < m {
        if di > 0 { s = s + ", " }
        s = s + str(dphi[di])
        di = di + 1
    }
    s = s + "],\n"
    s = s + "  \"drate_di\": ["
    let mut dri = 0
    while dri < m {
        if dri > 0 { s = s + ", " }
        s = s + str(drate[dri])
        dri = dri + 1
    }
    s = s + "],\n"
    s = s + "  \"peak_idx_phi\": " + str(phi_peak_idx) + ",\n"
    s = s + "  \"peak_idx_amp\": " + str(amp_peak_idx) + ",\n"
    s = s + "  \"peak_I_phi\": " + str(peak_I_phi) + ",\n"
    s = s + "  \"peak_I_amp\": " + str(peak_I_amp) + ",\n"
    s = s + "  \"delta_peaks\": " + str(delta_peaks) + ",\n"
    s = s + "  \"delta_amp_gz\": " + str(delta_amp_gz) + ",\n"
    s = s + "  \"delta_phi_gz\": " + str(delta_phi_gz) + ",\n"
    s = s + "  \"sign_changes\": " + str(sign_changes) + ",\n"
    s = s + "  \"byte_eq\": " + str(byte_eq) + ",\n"
    s = s + "  \"f1\": " + str(f1) + ",\n"
    s = s + "  \"f2\": " + str(f2) + ",\n"
    s = s + "  \"f3\": " + str(f3) + ",\n"
    s = s + "  \"f4\": " + str(f4) + ",\n"
    s = s + "  \"f5\": " + str(f5) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h639_tension_amplitude_cross_phi_derivative_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h639_tension_amplitude_cross_phi_derivative_2026_05_28/result.json")
}
