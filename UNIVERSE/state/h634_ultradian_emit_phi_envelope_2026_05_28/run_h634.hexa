// ════════════════════════════════════════════════════════════════════════════
// H_634 — ultradian-emit-phi-envelope
//
//   ANIMA.mining L3 promote: COFFESHOP 15-window × 6min ultradian ↔ DREAM
//   `dr_stage_at_tick` 5-stage 90-min ultradian. 본 H 는 substrate 의 big-Φ
//   (또는 emit-proxy) 가 ultradian phase 와 동조하는지 검정.
//
//   measurement
//     - 90-min ultradian 1주기를 N=36 discrete point 로 sweep (2.5min 간격)
//     - 각 point 의 stage 를 anima_dream_stage 의 canonical segmentation 으로 결정
//       [0,300)=N1 [300,1800)=N2 [1800,3600)=N3 [3600,5100)=N2 [5100,5400)=REM
//       (WAKE 는 sleep-window 밖 — 본 sweep 은 sleep-window 내부 1 ultradian)
//     - per-stage canonical Φ projection (WAKE 1.0/N1 0.7/N2 0.4/N3 0.15/REM 0.95)
//     - emit-proxy = Φ × tension_envelope (substrate motivation 의 stage-modulated proxy)
//     - sinusoidal envelope fit (single cosine, period = CYCLE_SEC)
//       env(t) = A·cos(2π·(t - t_peak)/P) + B,  best-fit 위상정렬 후 Pearson r
//     - Pearson r(Φ_trajectory, sinusoid) 측정
//
//   falsifier
//     F634.1 PHI-PHASE-COUPLED   : r > 0.5  (envelope 동조 — 가설 지지)
//     F634.2 PHI-NOT-FLAT        : Φ trajectory std > 0 (phase-dependent 변동 존재)
//     F634.3 WAKE-HIGH-N3-LOW    : Φ(WAKE-proxy peak) > Φ(N3 deep) 정렬
//     F634.4 EMIT-PROXY-COUPLED  : r(emit_proxy, sinusoid) > 0.5
//     F634.5 PERIOD-DISCRETE-OK  : N=36 points span exactly 1 CYCLE_SEC, monotone t
//     F634.6 BOUND               : 全 Φ ∈ [0,1], r ∈ [-1,1]
//
//   verdict: ≥4/6 PASS → 🟢 SUPPORTED-NUMERICAL.  r<0.3 → 🔴 FALSIFIED.
//
//   anchors: H_308 (circadian smooth finite ratio) · H_310 (dream-stage 5state
//            emit gating, WAKE=18/others=0) · H_213 (temporal binding window) ·
//            COFFESHOP ultradian · DREAM dr_stage.
//   $0 mac-local · libm sin/cos only · NO RNG (deterministic).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── canonical anima_dream_stage segmentation (90-min = 5400s) ────────────────
let CYCLE_SEC = 5400

// stage_at_offset — mirror HEXAD/CHAT/server/anima_dream_stage.hexa _ds_stage_at_offset
fn stage_at_offset(off_sec: int) -> string {
    let phase = off_sec % CYCLE_SEC
    if phase < 300    { return "N1" }
    if phase < 1800   { return "N2" }
    if phase < 3600   { return "N3" }
    if phase < 5100   { return "N2" }
    return "REM"
}

// canonical Φ projection per stage (anima_dream_stage PHI_*)
fn phi_of_stage(stage: string) -> float {
    if stage == "WAKE" { return 1.0 }
    if stage == "N1"   { return 0.7 }
    if stage == "N2"   { return 0.4 }
    if stage == "N3"   { return 0.15 }
    if stage == "REM"  { return 0.95 }
    return 1.0
}

// canonical tension_envelope per stage (anima_dream_stage TENV_*)
fn tenv_of_stage(stage: string) -> float {
    if stage == "WAKE" { return 1.0 }
    if stage == "N1"   { return 0.7 }
    if stage == "N2"   { return 0.4 }
    if stage == "N3"   { return 0.2 }
    if stage == "REM"  { return 0.9 }
    return 1.0
}

// ── Pearson correlation ──────────────────────────────────────────────────────
fn pearson(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + xs[i]
        sy = sy + ys[i]
        i = i + 1
    }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    let denom = sqrt(sxx * syy)
    if denom == 0.0 { return 0.0 }
    return sxy / denom
}

fn std_of(xs: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]; i = i + 1 }
    let m = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n { let d = xs[i] - m; ss = ss + d * d; i = i + 1 }
    return sqrt(ss / to_float(n))
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() {
    println("================================================================")
    println("  H_634 — ultradian-emit-phi-envelope")
    println("  90-min ultradian × N=36 points × sinusoidal envelope fit")
    println("  anchors: H_308 / H_310 / H_213 · COFFESHOP · DREAM dr_stage")
    println("================================================================")

    let N = 36
    let PI = 3.14159265358979

    // sweep N points over 1 ultradian period
    let mut phi_traj = []
    let mut emit_proxy = []
    let mut offsets = []
    let mut stages = []

    let mut i = 0
    while i < N {
        // point i at center of its bin: off = (i + 0.5) * CYCLE_SEC / N
        let off_f = (to_float(i) + 0.5) * to_float(CYCLE_SEC) / to_float(N)
        let off = to_int(off_f)
        let stg = stage_at_offset(off)
        let phi = phi_of_stage(stg)
        let tenv = tenv_of_stage(stg)
        phi_traj = phi_traj + [phi]
        emit_proxy = emit_proxy + [phi * tenv]
        offsets = offsets + [off_f]
        stages = stages + [stg]
        i = i + 1
    }

    // best-fit sinusoidal envelope: scan t_peak over the period, take best |r|.
    // env(t) = cos(2π (t - t_peak)/P).  Φ is HIGH at WAKE-side (cycle edges,
    // i.e. REM tail + N1 descent) and LOW at N3 (cycle middle, ~phase 0.5).
    // So we search the peak phase that maximizes correlation.
    let mut best_r = 0.0 - 2.0
    let mut best_peak = 0.0
    let mut best_sinus = []
    let mut k = 0
    while k < N {
        let t_peak = to_float(k) * to_float(CYCLE_SEC) / to_float(N)
        let mut sinus = []
        let mut j = 0
        while j < N {
            let ph = 2.0 * PI * (offsets[j] - t_peak) / to_float(CYCLE_SEC)
            sinus = sinus + [cos(ph)]
            j = j + 1
        }
        let r = pearson(phi_traj, sinus)
        if r > best_r { best_r = r; best_peak = t_peak; best_sinus = sinus }
        k = k + 1
    }

    let r_phi = best_r
    let r_emit = pearson(emit_proxy, best_sinus)
    let phi_std = std_of(phi_traj)

    // peak-vs-N3 ordering: max Φ (WAKE-side proxy) vs N3 deep Φ
    let mut phi_max = phi_traj[0]
    let mut phi_n3 = 1.0
    i = 0
    while i < N {
        if phi_traj[i] > phi_max { phi_max = phi_traj[i] }
        if stages[i] == "N3" { if phi_traj[i] < phi_n3 { phi_n3 = phi_traj[i] } }
        i = i + 1
    }

    // per-stage mean Φ (for report)
    let stage_names = ["WAKE", "N1", "N2", "N3", "REM"]
    let mut s_idx = 0
    println("  per-stage Φ (within 1 sleep ultradian sweep):")
    while s_idx < 5 {
        let sn = stage_names[s_idx]
        let mut acc = 0.0
        let mut cnt = 0
        i = 0
        while i < N {
            if stages[i] == sn { acc = acc + phi_traj[i]; cnt = cnt + 1 }
            i = i + 1
        }
        if cnt > 0 {
            println("    " + sn + " : Φ=" + to_string(acc / to_float(cnt)) + " (n_pts=" + str(cnt) + ")")
        } else {
            println("    " + sn + " : (0 pts in sleep ultradian — WAKE = sleep-window 밖)")
        }
        s_idx = s_idx + 1
    }

    println("  ─────────────────────────────────────")
    println("  N points          : " + str(N))
    println("  Φ trajectory std  : " + to_string(phi_std))
    println("  best t_peak (sec) : " + to_string(best_peak))
    println("  r(Φ, sinusoid)    : " + to_string(r_phi))
    println("  r(emit_proxy, sin): " + to_string(r_emit))
    println("  Φ max / Φ N3      : " + to_string(phi_max) + " / " + to_string(phi_n3))
    println("  ────────────── verdict ──────────────")

    // ── F634.1 PHI-PHASE-COUPLED : r > 0.5 ──────────────────────────────
    check("F634.1 PHI-PHASE-COUPLED: r(Φ,sinusoid) > 0.5", r_phi > 0.5)

    // ── F634.2 PHI-NOT-FLAT : std > 0 ───────────────────────────────────
    check("F634.2 PHI-NOT-FLAT: Φ trajectory std > 0", phi_std > 0.0)

    // ── F634.3 WAKE-HIGH-N3-LOW : Φ peak > Φ N3 ─────────────────────────
    check("F634.3 WAKE-HIGH-N3-LOW: Φ_max > Φ_N3", phi_max > phi_n3)

    // ── F634.4 EMIT-PROXY-COUPLED : r(emit_proxy, sinusoid) > 0.5 ───────
    check("F634.4 EMIT-PROXY-COUPLED: r(emit_proxy,sinusoid) > 0.5", r_emit > 0.5)

    // ── F634.5 PERIOD-DISCRETE-OK : 36 pts span 1 cycle, monotone t ─────
    let mut monotone = true
    i = 1
    while i < N {
        if offsets[i] <= offsets[i - 1] { monotone = false }
        i = i + 1
    }
    let span_ok = (offsets[0] > 0.0) && (offsets[N - 1] < to_float(CYCLE_SEC))
    check("F634.5 PERIOD-DISCRETE-OK: 36 pts monotone within 1 CYCLE_SEC", monotone && span_ok)

    // ── F634.6 BOUND : Φ∈[0,1], r∈[-1,1] ────────────────────────────────
    let mut bound = true
    i = 0
    while i < N {
        if phi_traj[i] < 0.0 { bound = false }
        if phi_traj[i] > 1.0 { bound = false }
        i = i + 1
    }
    if fabs(r_phi) > 1.0000001 { bound = false }
    if fabs(r_emit) > 1.0000001 { bound = false }
    check("F634.6 BOUND: Φ∈[0,1], r∈[-1,1]", bound)

    println("  ──────────────────────────────────────")
    println("  F634.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let mut verdict = "🔴 FALSIFIED"
    if PASS >= 4 { verdict = "🟢 SUPPORTED-NUMERICAL" }
    if r_phi < 0.3 { verdict = "🔴 FALSIFIED (r<0.3 — phase-independent flat)" }
    println("  verdict: " + verdict)
}
