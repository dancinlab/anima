// phi_rule_8_hi.hexa — H_668 dΦ/dI shard B (rule 8, grid points 7..12) — H_657 보완
//
//   class-I rule 8 faithful big-Φ over the UPPER half of the H_657 13-point
//   inhibition grid (indices 7..12: I = 0.30..0.95). Pairs with phi_rule_8_lo.
//   Writes phi_rule_8_hi.json. Aggregation is phi-free (aggregate.hexa).
//   method = H_657 verbatim. $0 · mac-local · foreground sync.
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h668/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _n() -> int { return 4 }
fn _rule() -> int { return 8 }

fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}

fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}

fn main() {
    // UPPER half: indices 7..12 of the H_657 13-point grid
    let grid = [0.30, 0.35, 0.40, 0.50, 0.70, 0.95]
    let m = len(grid)
    let rule = _rule()

    let mut phi = []
    let mut i = 0
    while i < m {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        println("rule " + str(rule) + " I=" + str(grid[i]) + " Φ=" + str(mp))
        i = i + 1
    }

    let mut s = "{\n  \"rule\": " + str(rule) + ",\n  \"n\": 4,\n  \"half\": \"hi\",\n  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { s = s + ", " }
        s = s + str(grid[gi])
        gi = gi + 1
    }
    s = s + "],\n  \"phi\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { s = s + ", " }
        s = s + str(phi[pi])
        pi = pi + 1
    }
    s = s + "]\n}\n"
    write_file("UNIVERSE/state/h668_class_I_full_property_2026_05_28/phi_rule_8_hi.json", s)
    println("wrote phi_rule_8_hi.json")
}
