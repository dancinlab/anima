// probe_closure_band.hexa — H_668 closure-band class-I (rule 8) — H_656 보완
//
//   H_656 (PR, 🟢) measured the closure-conjunction band for the Wolfram-class
//   representatives {30 III, 90 III-additive, 110 IV, 184 II} and found the band
//   POSITION/WIDTH to be class-dependent (rule90 absent width=0, rule110 widest
//   width=0.90). The class-I row (homogeneous→single-state, rule 8) was left
//   unmeasured. H_663 (🟢) predicted from magnitude≈0 that class-I closure-band
//   would be ABSENT but did NOT measure it directly (C3.2). This shard adds the
//   DIRECT class-I (rule 8) closure-band measurement with the H_656 method
//   verbatim, comparing it against the H_656 class II/III/IV baselines.
//
//   method = H_656 verbatim — 4-criterion closure conjunction (SI · genPhi ·
//     minPhi · ratio) on a Wolfram-class CA substrate (RFC 036 phi_spatial via
//     HEXAD/C/c_lib.hexa). N=16 lattice, 4 contiguous domains, I→initial density
//     (density=1-I), 9-pt I-grid × 6-rep ensemble. closure band = I set with
//     pass-rate > 0; band_lo/band_hi/width/n_pos/peak.
//
//   H_656 baselines (verbatim): rule90 width=0.0 (absent), rule184 width=0.65
//     [0.15,0.80], rule30 width=0.65 [0.15,0.80], rule110 width=0.90 [0.05,0.95].
//
//   floor verdict = class-I (rule 8) band width ≤ rule184 (class-II) width=0.65
//     (i.e. class-I is at the matrix floor of closure-band — absent or ≤ II).
//
//   deterministic · hexa-only · $0 mac local · llm:none · foreground sync.
// ════════════════════════════════════════════════════════════════════════
import "/private/tmp/u-h668/HEXAD/C/c_lib.hexa"

fn _N() -> int    { return 16 }
fn _DIM() -> int  { return 12 }
fn _WARM() -> int { return 8 }
fn _NDOM() -> int { return 4 }

fn _THETA_SI()  -> float { return 1.5 }
fn _THETA_GEN() -> float { return 0.02 }
fn _THETA_DIV() -> float { return 0.05 }
fn _RATIO_LO()  -> float { return 1.1 }
fn _RATIO_HI()  -> float { return 3.5 }

fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

fn _hash01(i: int, rep: int) -> float {
    let s = (i * 2654435761 + rep * 40503 + 12345) % 2147483647
    let mut t = s
    if t < 0 { t = t + 2147483647 }
    return to_float(t % 100000) / 100000.0
}

fn _init_row(row: int, n: int, rep: int, i_val: float) -> int {
    let density = 1.0 - i_val
    let mut i = 0
    while i < n {
        let h = _hash01(i, rep)
        if h < density { let _ = farr_set(row, i, 1.0) }
        else           { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int, i_val: float) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep, i_val)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

fn _domain_slice(states: int, n: int, dim: int, k: int, cells_per_dom: int) -> int {
    let base_cell = k * cells_per_dom
    let out = farr_zeros(cells_per_dom * dim)
    let mut c = 0
    while c < cells_per_dom {
        let mut t = 0
        while t < dim {
            let v = farr_get(states, (base_cell + c) * dim + t)
            let _ = farr_set(out, c * dim + t, v)
            t = t + 1
        }
        c = c + 1
    }
    return out
}

fn _domain_phi_vec(rule: int, rep: int, i_val: float) -> array {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let ndom = _NDOM()
    let nbins = c_phi_n_bins_default()
    let cells_per_dom = n / ndom
    let states = _run_ca(rule, n, dim, warm, rep, i_val)
    let mut out = []
    let mut k = 0
    while k < ndom {
        let slice = _domain_slice(states, n, dim, k, cells_per_dom)
        let phi = c_measure_phi(slice, cells_per_dom, dim, nbins)
        out = out.push(phi)
        let _ = farr_free(slice)
        k = k + 1
    }
    let _ = farr_free(states)
    return out
}

fn _vmin(v: array) -> float {
    let mut m = v[0]
    let mut i = 1
    while i < len(v) { if v[i] < m { m = v[i] }; i = i + 1 }
    return m
}
fn _vmax(v: array) -> float {
    let mut m = v[0]
    let mut i = 1
    while i < len(v) { if v[i] > m { m = v[i] }; i = i + 1 }
    return m
}
fn _vmean(v: array) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(v) { s = s + v[i]; i = i + 1 }
    return s / to_float(len(v))
}
fn _SI(v: array) -> float {
    let mn = _vmin(v)
    if mn < 0.000000001 { return _vmax(v) / 0.000000001 }
    return _vmax(v) / mn
}
fn _genphi(v: array) -> float { return _vmean(v) }
fn _ratio(v: array) -> float {
    let mean = _vmean(v)
    if mean < 0.000000001 { return 0.0 }
    return _vmax(v) / mean
}

fn _closure_pass(rule: int, rep: int, i_val: float) -> int {
    let v = _domain_phi_vec(rule, rep, i_val)
    let si = _SI(v)
    let gphi = _genphi(v)
    let dmin = _vmin(v)
    let ratio = _ratio(v)
    let mut c1 = 0
    let mut c2 = 0
    let mut c3 = 0
    let mut c4 = 0
    if si > _THETA_SI() { c1 = 1 }
    if gphi > _THETA_GEN() { c2 = 1 }
    if dmin > _THETA_DIV() { c3 = 1 }
    if ratio >= _RATIO_LO() { if ratio <= _RATIO_HI() { c4 = 1 } }
    if c1 == 1 { if c2 == 1 { if c3 == 1 { if c4 == 1 { return 1 } } } }
    return 0
}

fn _pass_rate(rule: int, i_val: float, reps: int) -> float {
    let mut hits = 0
    let mut rep = 0
    while rep < reps {
        hits = hits + _closure_pass(rule, rep, i_val)
        rep = rep + 1
    }
    return to_float(hits) / to_float(reps)
}

fn main() {
    println("[H_668] closure-band class-I (rule 8) — H_656 보완")
    println("  substrate : elementary CA × phi_spatial (RFC 036), H_656 verbatim")
    println("  rule 8 = Wolfram class-I (homogeneous→single-state, neighborhood 011→1 only)")
    println("  H_656 baselines: rule90 w=0.0 / rule184 w=0.65 / rule30 w=0.65 / rule110 w=0.90")
    println("")

    let reps = 6
    let grid = [0.05, 0.15, 0.25, 0.30, 0.37, 0.50, 0.65, 0.80, 0.95]
    let rule = 8

    println("=== rule 8 (Wolfram class I-homogeneous) ===")
    let mut band_lo = -1.0
    let mut band_hi = -1.0
    let mut n_pos = 0
    let mut peak_pr = 0.0
    let mut peak_i = -1.0
    let mut gi = 0
    while gi < len(grid) {
        let i_val = grid[gi]
        let pr = _pass_rate(rule, i_val, reps)
        if pr > 0.0 {
            n_pos = n_pos + 1
            if band_lo < 0.0 { band_lo = i_val }
            band_hi = i_val
        }
        if pr > peak_pr { peak_pr = pr; peak_i = i_val }
        println("  I=" + to_string(i_val) + "  pass_rate=" + to_string(pr))
        gi = gi + 1
    }
    let mut width = 0.0
    if band_lo >= 0.0 { width = band_hi - band_lo }
    println("  band_lo=" + to_string(band_lo)
        + " band_hi=" + to_string(band_hi)
        + " width=" + to_string(width)
        + " n_pos_pts=" + to_string(n_pos)
        + " peak_pr=" + to_string(peak_pr)
        + " peak_I=" + to_string(peak_i))
    println("")

    // floor verdict vs H_656 class-II baseline (rule184 width=0.65)
    let class_II_width = 0.65
    let is_floor = width <= class_II_width
    println("── closure-band floor test ──")
    println("  class-I width  = " + to_string(width))
    println("  class-II width = " + to_string(class_II_width) + " (H_656 rule184 baseline)")
    println("  class-I is closure-band FLOOR (≤ class-II) = " + str(is_floor))
    println("")

    let mut js = "{\n"
    js = js + "  \"property\": \"closure-band\",\n"
    js = js + "  \"method\": \"H_656 verbatim\",\n"
    js = js + "  \"rule\": 8,\n"
    js = js + "  \"wolfram_class\": \"I-homogeneous\",\n"
    js = js + "  \"band_lo\": " + to_string(band_lo) + ",\n"
    js = js + "  \"band_hi\": " + to_string(band_hi) + ",\n"
    js = js + "  \"width\": " + to_string(width) + ",\n"
    js = js + "  \"n_pos_pts\": " + to_string(n_pos) + ",\n"
    js = js + "  \"peak_pr\": " + to_string(peak_pr) + ",\n"
    js = js + "  \"peak_I\": " + to_string(peak_i) + ",\n"
    js = js + "  \"baseline_class_II_width\": 0.65,\n"
    js = js + "  \"is_floor\": " + str(is_floor) + "\n"
    js = js + "}\n"
    write_file("UNIVERSE/state/h668_class_I_full_property_2026_05_28/closure_band_result.json", js)
    println("wrote closure_band_result.json")
    println("=== H_668 closure-band class-I complete ===")
}
