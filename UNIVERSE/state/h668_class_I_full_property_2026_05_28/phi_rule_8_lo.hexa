// phi_rule_8_lo.hexa — H_668 dΦ/dI shard A (rule 8, grid points 0..6) — H_657 보완
//
//   class-I rule 8 faithful big-Φ over the LOWER half of the H_657 13-point
//   inhibition grid (indices 0..6: I = 0.05..0.25). Split into lo/hi shards to
//   stay under the 60s foreground wall budget (208 calls ≈ 73s single-run).
//   Writes phi_rule_8_lo.json. Aggregation is phi-free (aggregate.hexa).
//
//   method = H_657 verbatim — tpm_mixed=(1-I)·eca_tpm, faithful 16-state mean
//     big-Φ, n=4. The aggregate joins lo+hi and computes dΦ/dI peak vs GZ_LOWER.
//   $0 · mac-local · hexa-only · LLM none · deterministic · foreground sync.
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h668/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _n() -> int { return 4 }
fn _rule() -> int { return 8 }

fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}

fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}

fn main() {
    // LOWER half: indices 0..6 of the H_657 13-point grid
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25]
    let m = len(grid)
    let rule = _rule()

    let mut phi = []
    let mut i = 0
    while i < m {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        println("rule " + str(rule) + " I=" + str(grid[i]) + " Φ=" + str(mp))
        i = i + 1
    }

    let mut s = "{\n  \"rule\": " + str(rule) + ",\n  \"n\": 4,\n  \"half\": \"lo\",\n  \"grid\": ["
    let mut gi = 0
    while gi < m {
        if gi > 0 { s = s + ", " }
        s = s + str(grid[gi])
        gi = gi + 1
    }
    s = s + "],\n  \"phi\": ["
    let mut pi = 0
    while pi < m {
        if pi > 0 { s = s + ", " }
        s = s + str(phi[pi])
        pi = pi + 1
    }
    s = s + "]\n}\n"
    write_file("UNIVERSE/state/h668_class_I_full_property_2026_05_28/phi_rule_8_lo.json", s)
    println("wrote phi_rule_8_lo.json")
}
