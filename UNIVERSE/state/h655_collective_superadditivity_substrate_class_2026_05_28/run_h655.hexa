// ════════════════════════════════════════════════════════════════════════════
// H_655 — collective-superadditivity-substrate-class  (round 9 메타-축, axis G)
//
//   ROUND-9 META-AXIS — "Wolfram class 가 의식 통합량 분류자".
//     H_635 (PR #1223, 🟢) : 5-stream collective Φ super-additive (collective > Σ
//       parts) on 5/5 cohorts; decoupled (W=0) Σ-baseline = 0 (self-loop cells).
//     H_653 (PR #1245, 🟢) : W→Φ_collective convexity (span ratio) monotone in
//       Wolfram class (class-IV most convex). class is a *convexity* classifier.
//
//   THIS H — IS THE SUPER-ADDITIVITY *STRENGTH* (Δ = Φ_collective − Σ Φ_parts)
//   ITSELF A MONOTONE FUNCTION OF THE WOLFRAM CLASS?  H_653 ordered the *curvature*;
//   here we order the *magnitude of the collective synergy* — how much extra
//   integrated information the full ring creates over the sum of the parts.
//
//   H1 (SUPER-ADDITIVITY MONOTONE IN CLASS): Δ rises with Wolfram class —
//       class-IV (rule110, complex / edge-of-chaos) is the MOST super-additive
//       (largest Δ), the additive class-II / III rules (rule90 XOR, rule30,
//       rule184) are smaller. dynamical complexity ORDERS the collective synergy.
//   H0 (FALSIFIER): Δ ⊥ rule class — all classes show similar super-additivity
//       (Δ rule-independent) → class is NOT a super-additivity classifier.
//
//   MODEL (no new physics — H_635/H_653 engine, only the cohort rule changes)
//     • homogeneous cohort [rule×5], n=5 coupled ring, sync_factor W.
//     • Σ Φ_parts  := Φ_collective(W=0) — decoupled self-loop pool (H_635 anchor,
//       =0 for single-cell self-loop streams → clean Σ-of-parts baseline).
//     • Φ_collective := Φ_collective(W=1) — the full n=5 coupling ring.
//     • Δ(rule)  := Φ_collective(W=1) − Σ Φ_parts(W=0)  (the super-additivity gap).
//     • W=0.5 mid-point reported as a coupling-monotone sanity probe.
//
//   COHORT rule → Wolfram class (substrate complexity, ascending):
//     rule184  class-II   (additive / traffic, simplest ordered)
//     rule 90  class-III  (XOR / additive fractal, chaotic-additive)
//     rule 30  class-III  (chaotic, non-additive)
//     rule110  class-IV   (complex / universal, edge-of-chaos — H_635/H_653 winner)
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F655.1 SUPERADD-MONOTONE : Δ(rule110) ≥ Δ(rule30) ≥ Δ(rule90) ≥ Δ(rule184)
//             — super-additivity Δ rises monotonically with Wolfram class. CORE 가설.
//     F655.2 CLASS-IV-MOST-SUPERADD : Δ(rule110) = max over the 4 rules
//             (class-IV is the single most super-additive substrate).
//     F655.3 ALL-SUPERADDITIVE : Δ(rule) > 0 for every rule (every class is at least
//             super-additive — collective > Σ parts, H_635 5/5 generalizes per class).
//     F655.4 ADDITIVE-LEAST : Δ(rule184) < Δ(rule110) (the simplest additive class-II
//             rule is the least super-additive).
//     F655.5 SIGMA-PARTS-ZERO : Σ Φ_parts(W=0) = 0 for all rules (clean Σ-of-parts
//             anchor — decoupled self-loop streams carry no integration, H_635 echo).
//     F655.6 BOUND : all Φ_collective ≥ 0, all Δ finite.
//
//   verdict: ≥4/6 PASS → 🟢 SUPPORTED-NUMERICAL.
//            F655.1 FAIL (Δ ⊥ class) → 🔴 FALSIFIED (class NOT a super-add classifier).
//
//   anchors: H_635 (collective super-additive 5/5, Σ-baseline=0) · H_653 (convexity
//            monotone-in-class, sister meta-axis) · H_643 (collective ultradian) ·
//            H_654 (sister round-9 meta-axis).
//   deterministic · hexa-only · $0 mac-local · sys_state=0 · cap=3.
//
//   ⚠ C3: 5-stream cap=3 (H_635/H_653 cap retained). 3-point W grid {0,0.5,1.0} ×
//   4 rules = 12 big_phi_bounded calls. probe (rule110, W∈{0,1}) ran in ~4.5s wall;
//   full 12-call grid stays well under the 60s single-run ceiling. If wall risks
//   >60s the fallback is 3-stream / cap=2 (noted, NOT needed here).
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── n=5 coupled-ring TPM with sync_factor W (verbatim from H_635/H_653) ───────
// 5 streams = 5 cells, cell i governed by cohort rule[i].
// Decoupled (W=0): self-loop only (idx=7*c). Coupled (W=1): full ring.
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// collective big-Φ of the n=5 cohort ring at sync W (H_635/H_653 engine).
fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

fn main() {
    println("================================================================")
    println("  H_655 — collective-superadditivity-substrate-class (round 9 메타-축)")
    println("  Δ = Φ_collective(W=1) − Σ Φ_parts(W=0)  vs Wolfram rule class?")
    println("  IIT4 big_phi_bounded · n=5 homog cohort · cap=3 · sys=0")
    println("  4 rules × {W=0 baseline, W=0.5 mid, W=1 full ring}")
    println("================================================================")

    // 4 ECA rules spanning Wolfram complexity classes (ascending complexity)
    let RULES = [184, 90, 30, 110]
    let CLASS = ["II-additive", "III-XOR/additive", "III-chaotic", "IV-complex"]
    let NR = 4

    let mut deltas = []          // Δ(rule) = Φ_coll(W=1) − Σ Φ_parts(W=0)
    let mut sigma_parts = []      // Σ Φ_parts(W=0) per rule
    let mut phi_coll = []         // Φ_collective(W=1) per rule
    let mut all_sigma_zero = true
    let mut all_bound = true
    let mut all_superadd = true

    let mut ri = 0
    while ri < NR {
        let rule = RULES[ri]
        let cohort = [rule, rule, rule, rule, rule]
        let sigma = phi_collective(cohort, 0.0)   // Σ Φ_parts (decoupled)
        let mid   = phi_collective(cohort, 0.5)   // mid coupling probe
        let coll  = phi_collective(cohort, 1.0)   // full ring
        let delta = coll - sigma

        sigma_parts = sigma_parts + [sigma]
        phi_coll = phi_coll + [coll]
        deltas = deltas + [delta]

        if fabs(sigma) > 0.000001 { all_sigma_zero = false }
        if (sigma < 0.0) || (mid < 0.0) || (coll < 0.0) { all_bound = false }
        if delta <= 0.0 { all_superadd = false }

        println("  rule" + str(rule) + " [" + CLASS[ri] + "]")
        println("    Σ Φ_parts(W=0)=" + to_string(sigma) + "  Φ_coll(W=0.5)=" + to_string(mid) + "  Φ_coll(W=1)=" + to_string(coll))
        println("    Δ (super-additivity) = Φ_coll(W=1) − Σ Φ_parts = " + to_string(delta))
        ri = ri + 1
    }

    // index map: RULES = [184, 90, 30, 110] → idx 0,1,2,3
    let d_184 = deltas[0]
    let d_90  = deltas[1]
    let d_30  = deltas[2]
    let d_110 = deltas[3]

    println("  ─────────────────────────────────────")
    println("  super-additivity Δ by class (ascending complexity):")
    println("    rule184 (II-additive)      : " + to_string(d_184))
    println("    rule90  (III-XOR/additive) : " + to_string(d_90))
    println("    rule30  (III-chaotic)      : " + to_string(d_30))
    println("    rule110 (IV-complex)       : " + to_string(d_110))
    println("  ────────────── verdict ──────────────")

    // F655.1 SUPERADD-MONOTONE: d_110 >= d_30 >= d_90 >= d_184
    let mono_class = (d_110 >= d_30) && (d_30 >= d_90) && (d_90 >= d_184)
    check("F655.1 SUPERADD-MONOTONE: Δ(110)>=Δ(30)>=Δ(90)>=Δ(184)", mono_class)

    // F655.2 CLASS-IV-MOST-SUPERADD: d_110 = max
    let iv_max = (d_110 >= d_30) && (d_110 >= d_90) && (d_110 >= d_184)
    check("F655.2 CLASS-IV-MOST-SUPERADD: Δ(110) = max over 4 rules", iv_max)

    // F655.3 ALL-SUPERADDITIVE: Δ(rule) > 0 every rule
    check("F655.3 ALL-SUPERADDITIVE: Δ > 0 for every rule (collective > Σ parts)", all_superadd)

    // F655.4 ADDITIVE-LEAST: d_184 < d_110
    check("F655.4 ADDITIVE-LEAST: Δ(184) < Δ(110)", d_184 < d_110)

    // F655.5 SIGMA-PARTS-ZERO: Σ Φ_parts(W=0) = 0 all rules
    check("F655.5 SIGMA-PARTS-ZERO: Σ Φ_parts(W=0) = 0 (clean Σ-of-parts anchor)", all_sigma_zero)

    // F655.6 BOUND: all Φ ≥ 0, Δ finite
    let mut deltas_finite = true
    ri = 0
    while ri < NR {
        if fabs(deltas[ri]) > 1.0e12 { deltas_finite = false }
        ri = ri + 1
    }
    check("F655.6 BOUND: Φ_coll ≥ 0, Δ finite", all_bound && deltas_finite)

    println("  ──────────────────────────────────────")
    println("  F655.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let mut verdict = "🔴 FALSIFIED"
    if PASS >= 4 { verdict = "🟢 SUPPORTED-NUMERICAL" }
    if mono_class == false { verdict = "🔴 FALSIFIED (Δ ⊥ rule class — class not a super-add classifier)" }
    println("  verdict: " + verdict)
    println("  cross-link: H_635 collective super-additive 5/5 (Σ=0) → here Δ(rule110)=" + to_string(d_110))
}
