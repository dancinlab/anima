// H_343 — basin <-> integration coupling at n=6 (scale-recheck of H_341)
// H_341 (n=4): Pearson(max_basin, big_Phi) = +0.776 over 4 rules.
// At n=6 the exact IIT4 big-Phi is intractable in our hexa env (n<=5 only), so
// we use a DYNAMICAL integration PROXY: mean forward-orbit cycle length (H_333,
// the same panel), justified by H_288 (LZ/dynamical complexity || big-Phi).
// basin is measured fresh here at n=6.
//
// H1: the basin <-> integration coupling survives at n=6 (Pearson |r| >= 0.5,
//     positive). Falsifier: |r| < 0.5 or sign flip -> n=4 coupling was small-n.
// HONEST: this uses a PROXY for Phi, so the verdict is conditional on the proxy
// (cycle length) tracking integration — a caveat the n=4 cell did not need.

fn next6(s: int, rule: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < 6 {
        let im1 = (i + 5) % 6
        let ip1 = (i + 1) % 6
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

fn settle(s0: int, rule: int) -> int {
    let mut s = s0
    let mut t = 0
    while t < 60 { s = next6(s, rule); t = t + 1 }
    return s
}

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + farr_get(xs, i); sy = sy + farr_get(ys, i); i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

// measure basin (n_attr, max_basin) at n=6 for a rule
fn basin_nattr(rule: int) -> int {
    let on_cycle = farr_zeros(64)
    let mut s0 = 0
    while s0 < 64 {
        let term = settle(s0, rule)
        let _ = farr_set(on_cycle, term, 1.0)
        s0 = s0 + 1
    }
    let mut n_attr = 0
    let mut i = 0
    while i < 64 { if to_int(farr_get(on_cycle, i)) == 1 { n_attr = n_attr + 1 }; i = i + 1 }
    let _ = farr_free(on_cycle)
    return n_attr
}

fn basin_max(rule: int) -> int {
    let basin = farr_zeros(64)
    let mut s0 = 0
    while s0 < 64 {
        let term = settle(s0, rule)
        let cur = to_int(farr_get(basin, term))
        let _ = farr_set(basin, term, to_float(cur + 1))
        s0 = s0 + 1
    }
    let mut mx = 0
    let mut i = 0
    while i < 64 { let b = to_int(farr_get(basin, i)); if b > mx { mx = b }; i = i + 1 }
    let _ = farr_free(basin)
    return mx
}

fn main() {
    println("H_343 basin <-> integration(proxy) coupling at n=6")
    // rules: 110, 30, 105, 150
    let mb = farr_zeros(4)
    let na = farr_zeros(4)
    let _ = farr_set(mb, 0, to_float(basin_max(110)))
    let _ = farr_set(mb, 1, to_float(basin_max(30)))
    let _ = farr_set(mb, 2, to_float(basin_max(105)))
    let _ = farr_set(mb, 3, to_float(basin_max(150)))
    let _ = farr_set(na, 0, to_float(basin_nattr(110)))
    let _ = farr_set(na, 1, to_float(basin_nattr(30)))
    let _ = farr_set(na, 2, to_float(basin_nattr(105)))
    let _ = farr_set(na, 3, to_float(basin_nattr(150)))
    // integration proxy = n=6 mean cycle length (H_333, source-cited)
    let phi = farr_zeros(4)
    let _ = farr_set(phi, 0, 7.75)  // rule110
    let _ = farr_set(phi, 1, 1.00)  // rule30
    let _ = farr_set(phi, 2, 2.00)  // rule105
    let _ = farr_set(phi, 3, 1.00)  // rule150
    println("rule110 max_basin=" + str(to_int(farr_get(mb,0))) + " n_attr=" + str(to_int(farr_get(na,0))))
    println("rule30  max_basin=" + str(to_int(farr_get(mb,1))) + " n_attr=" + str(to_int(farr_get(na,1))))
    println("rule105 max_basin=" + str(to_int(farr_get(mb,2))) + " n_attr=" + str(to_int(farr_get(na,2))))
    println("rule150 max_basin=" + str(to_int(farr_get(mb,3))) + " n_attr=" + str(to_int(farr_get(na,3))))
    let r_mb = pearson(mb, phi, 4)
    let r_na = pearson(na, phi, 4)
    println("Pearson(max_basin, cyclelen_proxy)        = " + str(r_mb))
    println("Pearson(n_attractor_states, cyclelen_proxy) = " + str(r_na))
    println("n4_reference: Pearson(max_basin, big_Phi)=0.776 (H_341)")
    let _ = farr_free(mb); let _ = farr_free(na); let _ = farr_free(phi)
    println("done")
}
