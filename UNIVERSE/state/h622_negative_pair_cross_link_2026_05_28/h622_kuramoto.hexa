// h622_kuramoto.hexa — H_354 metric per-rule shard
//
//   Goal: rule-mapped τ_sync ↔ τ_cons Pearson per rule.
//
//   rule → ω-spread map: rule 8-bit binary expansion → ω_i 5-quantile permutation.
//     Each rule's 8 bits select which of 5 z-quantiles {-1.28,-0.52,0,0.52,1.28}
//     get cycled with which sign — this gives 6 distinct ω-profiles per rule.
//     Specifically: rule_bit_i ∈ {0,1} → sign of ω_(i mod 5).
//   This deterministically encodes rule identity into Kuramoto initial-condition
//   structure, while keeping the K-axis sweep as the experimental variable.
//
//   Consensus side reuses standard alpha(K) = clamp(K*0.1, 0.01, 0.95) bridge,
//   matching H_354 run_h354.hexa semantics. Toy substitute declared (same C3).
//
//   Output: per-rule (K, tau_sync, tau_cons) for K ∈ {0.5, 1.0, 2.0, 3.0}
//   plus Pearson r and ratio spread per rule.
//
//   H_354 metric PASS criterion (per rule):
//     - Pearson r(τ_sync, τ_cons) > 0.5  OR  ratio spread ≤ 2.0

fn _MAX_SYNC() -> int { return 1200 }
fn _MAX_CONS() -> int { return 400 }
fn _SYNC_THRESH() -> float { return 0.9 }
fn _CONS_THRESH() -> float { return 0.05 }
fn _DT() -> float { return 0.05 }
fn _D() -> int { return 8 }
fn _TWO_PI() -> float { return 6.283185307179586 }
fn _N() -> int { return 5 }   // same n_substrate per rule

fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

fn _bit(x: int, i: int) -> int {
    let mut s = x
    let mut k = 0
    while k < i { s = s / 2; k = k + 1 }
    return s - (s / 2) * 2
}

// rule-dependent omega: 5 z-quantiles cycled, sign flipped by rule_bit_i.
fn _omega_rule(i: int, rule: int) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    // rule bit at position (i mod 8) selects sign
    let bit_idx = i % 8
    let bit = _bit(rule, bit_idx)
    if bit == 1 { z = 0.0 - z }
    return z
}

fn _theta0(i: int, n: int) -> float {
    return _TWO_PI() * (i * 1.0) / (n * 1.0)
}

fn _order_param(theta: int, n: int) -> float {
    let mut C = 0.0
    let mut S = 0.0
    let mut i = 0
    while i < n {
        let t = farr_get(theta, i)
        C = C + cos(t)
        S = S + sin(t)
        i = i + 1
    }
    return sqrt(C * C + S * S) / (n * 1.0)
}

fn _kuramoto_tau(rule: int, K: float, max_steps: int, thresh: float) -> int {
    let n = _N()
    let theta = farr_zeros(n)
    let mut i = 0
    while i < n { farr_set(theta, i, _theta0(i, n)); i = i + 1 }

    let dt = _DT()
    let mut tau = max_steps
    let mut found = false
    let mut s = 0
    while s < max_steps {
        let r = _order_param(theta, n)
        if !found && r >= thresh {
            tau = s
            found = true
        }
        let next = farr_zeros(n)
        let mut a = 0
        while a < n {
            let theta_a = farr_get(theta, a)
            let mut coupling_sum = 0.0
            let mut b = 0
            while b < n {
                let theta_b = farr_get(theta, b)
                coupling_sum = coupling_sum + sin(theta_b - theta_a)
                b = b + 1
            }
            let omega_a = _omega_rule(a, rule)
            let dtheta = omega_a + (K / (n * 1.0)) * coupling_sum
            farr_set(next, a, theta_a + dt * dtheta)
            a = a + 1
        }
        let mut k = 0
        while k < n { farr_set(theta, k, farr_get(next, k)); k = k + 1 }
        farr_free(next)
        s = s + 1
    }
    farr_free(theta)
    return tau
}

fn _make_state(n: int, d: int) -> int {
    let flat = farr_zeros(n * d)
    let mut k = 0
    while k < n {
        let mut j = 0
        while j < d {
            let arg = _TWO_PI() * ((k + 1) * 1.0) * ((j + 1) * 1.0) / ((n * 1.0) * (d * 1.0))
            farr_set(flat, k * d + j, sin(arg))
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn _max_pairwise(flat: int, n: int, d: int) -> float {
    let mut max_d = 0.0
    let mut a = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            let mut acc = 0.0
            let mut j = 0
            while j < d {
                let x = farr_get(flat, a * d + j) - farr_get(flat, b * d + j)
                acc = acc + x * x
                j = j + 1
            }
            let dist = sqrt(acc)
            if dist > max_d { max_d = dist }
            b = b + 1
        }
        a = a + 1
    }
    return max_d
}

fn _blend_round(flat: int, n: int, d: int, alpha: float) -> int {
    let mean = farr_zeros(d)
    let mut j = 0
    while j < d {
        let mut acc = 0.0
        let mut k = 0
        while k < n {
            acc = acc + farr_get(flat, k * d + j)
            k = k + 1
        }
        farr_set(mean, j, acc / (n * 1.0))
        j = j + 1
    }
    let out = farr_zeros(n * d)
    let mut k2 = 0
    while k2 < n {
        let mut jj = 0
        while jj < d {
            let s = farr_get(flat, k2 * d + jj)
            let m = farr_get(mean, jj)
            let v = (1.0 - alpha) * s + alpha * m
            farr_set(out, k2 * d + jj, v)
            jj = jj + 1
        }
        k2 = k2 + 1
    }
    farr_free(mean)
    return out
}

fn _consensus_tau(alpha: float, max_rounds: int, thresh: float) -> int {
    let n = _N()
    let mut state = _make_state(n, _D())
    let mut tau = max_rounds
    let mut found = false
    let mut r = 0
    while r < max_rounds {
        let dist = _max_pairwise(state, n, _D())
        if !found && dist <= thresh {
            tau = r
            found = true
        }
        let nxt = _blend_round(state, n, _D(), alpha)
        farr_free(state)
        state = nxt
        r = r + 1
    }
    farr_free(state)
    return tau
}

fn _alpha_of_K(K: float) -> float {
    let mut a = K * 0.1
    if a < 0.01 { a = 0.01 }
    if a > 0.95 { a = 0.95 }
    return a
}

fn _pearson(xs: int, ys: int, n_pts: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n_pts {
        sx = sx + farr_get(xs, i)
        sy = sy + farr_get(ys, i)
        i = i + 1
    }
    let mx = sx / (n_pts * 1.0)
    let my = sy / (n_pts * 1.0)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n_pts {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom = sqrt(dx2 * dy2)
    if denom <= 0.0 { return 0.0 }
    return num / denom
}

fn _measure_rule(rule: int) {
    println("=== rule ", rule, " ===")
    let K_grid = farr_zeros(4)
    farr_set(K_grid, 0, 0.5); farr_set(K_grid, 1, 1.0)
    farr_set(K_grid, 2, 2.0); farr_set(K_grid, 3, 3.0)

    let tau_s = farr_zeros(4)
    let tau_c = farr_zeros(4)

    let mut min_ratio = 1.0e18
    let mut max_ratio = 0.0 - 1.0e18

    let mut i = 0
    while i < 4 {
        let K = farr_get(K_grid, i)
        let alpha = _alpha_of_K(K)
        let ts = _kuramoto_tau(rule, K, _MAX_SYNC(), _SYNC_THRESH())
        let tc = _consensus_tau(alpha, _MAX_CONS(), _CONS_THRESH())
        farr_set(tau_s, i, ts * 1.0)
        farr_set(tau_c, i, tc * 1.0)
        let ratio = if ts > 0 { (tc * 1.0) / (ts * 1.0) } else { 0.0 }
        if ts > 0 {
            if ratio < min_ratio { min_ratio = ratio }
            if ratio > max_ratio { max_ratio = ratio }
        }
        println("  K=", K, " tau_sync=", ts, " tau_cons=", tc, " ratio=", ratio)
        i = i + 1
    }

    let r = _pearson(tau_s, tau_c, 4)
    let spread = if min_ratio > 0.0 { max_ratio / min_ratio } else { 0.0 }
    let c1 = r > 0.5
    let c2 = spread <= 2.0 && spread > 0.0
    let pass = c1 || c2
    let verdict = if pass { "PASS" } else { "FAIL" }
    println("  rule_", rule, " pearson_r=", r, " ratio_spread=", spread, " VERDICT=", verdict)
    println("")

    farr_free(K_grid); farr_free(tau_s); farr_free(tau_c)
}

fn main() {
    println("# H_622 kuramoto-shard — rule-mapped τ_sync ↔ τ_cons (n_substrate=", _N(), ")")
    _measure_rule(30)
    _measure_rule(60)
    _measure_rule(90)
    _measure_rule(105)
    _measure_rule(110)
    _measure_rule(150)
    println("# H_622 kuramoto-shard done")
}
