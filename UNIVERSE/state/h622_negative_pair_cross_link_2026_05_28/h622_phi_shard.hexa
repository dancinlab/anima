// h622_phi_shard.hexa — H_349 metric per-rule shard
//
//   Goal: peak@1/e detection per rule on n=4 ECA substrate, sys=5 asymmetric.
//
//   I sweep: {0.20, 0.30, 0.37, 0.45, 0.55} (5-point, dense around 1/e≈0.368)
//   rule:    edit RULE constant below; run 6 times for {30, 60, 90, 105, 110, 150}
//
//   H_349 metric PASS criterion (per rule):
//     - argmax(big_phi) is at I ∈ [0.318, 0.418] = 1/e ±0.05
//     - shape is NOT monotone (interior peak)
//   FAIL otherwise.
//
//   n=4 chosen to keep wall ≤30s/shard (n=5 was 13-20s/point in H_612).

import "stdlib/consciousness/iit4_bigphi.hexa"

fn eca_tpm_inhibited(rule: int, n: int, I: float) -> array {
    let full = iit4_pow2(n)
    let p_fire = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            let b = iit4_bit(rule, idx)
            if b == 1 {
                t = t.push(p_fire)
            } else {
                t = t.push(0.0)
            }
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn main() {
    let n = 4
    let sys_state = 5

    // SHARD CONFIG — edit per invocation
    let RULE = 30
    let I_LIST = [0.20, 0.30, 0.37, 0.45, 0.55]

    println("# H_622 phi-shard · rule=", RULE, "n=", n, "sys=", sys_state)

    let mut k = 0
    while k < len(I_LIST) {
        let I = I_LIST[k]
        let tpm = eca_tpm_inhibited(RULE, n, I)
        let r = big_phi(tpm, n, sys_state)
        println("ROW", RULE, I, r[0])
        k = k + 1
    }
}
