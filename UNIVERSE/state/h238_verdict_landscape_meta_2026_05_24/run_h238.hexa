// UNIVERSE/state/h238_verdict_landscape_meta_2026_05_24/run_h238.hexa
// H_238 — verdict landscape meta-map · 22+ H tier distribution + 7-domain cluster + cross-correlation (raw#12)
//
//   Question: 본 세션 22+ H verdict landscape 의 meta-pattern —
//     (a) tier 분포 (SUPPORTED / PARTIAL / FALSIFIED / RUNNING) count + ratio,
//     (b) 7-domain cluster (life / consciousness / physics / math / information
//         / ethics / meta) 별 H 수 + SUPPORTED rate,
//     (c) cross-correlation: domain × tier 분포 의 명백한 cluster 식별
//         (e.g. H_204/H_211/H_223 cluster of single axis-family).
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - enumerate UNIVERSE/H_*.md  (sort -V; 22+ files)
//     - per H 파싱:
//         · id     = basename
//         · domain = "^domain:" frontmatter line (first match)
//         · verdict_class = "^verdict_class:" line (first match; empty 가능)
//     - tier 분류:
//         · SUPPORTED  if verdict ∈ {PASS, SUPPORTED, SUPPORTED_FULL, PASS_CYCLE_*}
//         · PARTIAL    if verdict ∈ {PARTIAL, PARTIAL_DIRECTIONAL, PARTIAL_PASS_*, DIRECTIONAL, MAPPING_*}
//         · FALSIFIED  if verdict ∈ {FALSIFIED, FAIL_CYCLE_*}
//         · RUNNING    else (lane-open, pre-register-frozen, running, empty)
//     - domain tokenize: separators ∈ { ",", "·", "|", "+" } → 7-cluster bucket
//     - SUPPORTED_rate(d) = SUPPORTED / (total in d)
//     - cross-correlation: pairwise H ↔ H domain Jaccard + tier match (sample)
//
//   Verdict (pre-registered):
//     · C1 ENUMERATE  22+ H all parsed (count ≥ 22)
//     · C2 DISTRIBUTION  tier counts well-defined (sum = total)
//     · C3 DOMAIN_CLUSTER  ≥ 3 domain buckets non-empty
//     · C4 BYTE_IDENTICAL  re-run byte-identical (deterministic by construction)
//     SUPPORTED iff C1 ∧ C2 ∧ C3 PASS.
//     PARTIAL   iff (C1 ∧ C2) ∧ ¬C3.
//     FALSIFIED else (F1 H 누락 / F2 tier inconsistent / F3 cluster undef / F4 byte-diff / F5 stats undef).
//
//   meta-instance · aggregation-only · 새 evidence 산출 X · Goodhart trap 주의 (L5).
// ════════════════════════════════════════════════════════════════════════

// ── config / paths (deterministic) ──────────────────────────────────────
fn _LIFE_DIR() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a44a9664e2bf1a907/UNIVERSE"
}
fn _STATE_DIR() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a44a9664e2bf1a907/UNIVERSE/state/h238_verdict_landscape_meta_2026_05_24"
}

// ── 7-domain cluster vocabulary (raw#12 pre-registered) ─────────────────
// Order is part of the deterministic spec; counts written verbatim in this order.
fn _DOMAINS() -> [string] {
    return ["life", "consciousness", "physics", "math", "information", "ethics", "meta"]
}

// Also recognize sister labels mapped to canonical buckets:
//   universe       → physics
//   biology        → life
//   substrate      → physics   (substrate-as-physics convention)
//   phenomenology  → consciousness
// Unmapped tokens land in NEITHER bucket and are reported under `unmapped_tokens`.

// ── helpers ─────────────────────────────────────────────────────────────
fn _str_contains(hay: string, needle: string) -> bool {
    let hl = len(hay)
    let nl = len(needle)
    if nl == 0 { return true }
    if nl > hl { return false }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(hay, i + j) != char_code(needle, j) {
                ok = false
                j = nl
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

// strip frontmatter prefix "domain:" or "verdict_class:" and trim
fn _strip_prefix(s: string, p: string) -> string {
    if s.starts_with(p) {
        let rest = exec("printf %s '" + s + "' | sed 's/^" + p + "[[:space:]]*//'").trim()
        return rest
    }
    return s.trim()
}

// tokenize a domain string using {",", "·", "|", "+"} separators
fn _tokenize_domain(d: string) -> [string] {
    // unify separators → ","
    let mut s = d
    // crude replace via exec
    let cmd = "printf %s '" + d + "' | tr '|·+' ',,,' | tr -s ',' "
    s = exec(cmd).trim()
    let raw = s.split(",")
    let mut out = []
    let mut i = 0
    while i < len(raw) {
        let t = raw[i].trim()
        if len(t) > 0 {
            out = out + [t]
        }
        i = i + 1
    }
    return out
}

// map a token to canonical 7-domain bucket (returns "" if unmapped)
fn _canonicalize(tok: string) -> string {
    if tok == "life"          { return "life" }
    if tok == "biology"       { return "life" }
    if tok == "consciousness" { return "consciousness" }
    if tok == "phenomenology" { return "consciousness" }
    if tok == "physics"       { return "physics" }
    if tok == "universe"      { return "physics" }
    if tok == "substrate"     { return "physics" }
    if tok == "math"          { return "math" }
    if tok == "information"   { return "information" }
    if tok == "ethics"        { return "ethics" }
    if tok == "meta"          { return "meta" }
    return ""
}

// classify a verdict_class string into tier (leading-token-priority).
// We look at the *first* meaningful token (after optional 'pre-register-frozen → ')
// so inline qualifiers like 'C3 advisory FAIL' inside a SUPPORTED verdict do not
// misclassify.
fn _tier(v: string) -> string {
    // empty / whitespace → RUNNING
    let mut t = v.trim()
    if len(t) == 0 { return "RUNNING" }

    // strip leading 'pre-register-frozen → ' (or '→ ' or 'pre-register-frozen ')
    // so the downstream verdict is what classifies.
    let arrow = " → "
    let mut ix = -1
    let mut z = 0
    let tl = len(t)
    let al = len(arrow)
    if al < tl {
        while z <= tl - al {
            let mut ok = true
            let mut zj = 0
            while zj < al {
                if char_code(t, z + zj) != char_code(arrow, zj) { ok = false; zj = al }
                zj = zj + 1
            }
            if ok { ix = z; z = tl }
            z = z + 1
        }
    }
    if ix >= 0 {
        // take substring after arrow
        let rest = exec("printf %s '" + t + "' | sed 's/.* → //'").trim()
        if len(rest) > 0 { t = rest }
    }

    // FALSIFIED tier: explicit FALSIFIED or FAIL_CYCLE tokens (no bare 'FAIL ')
    if t.starts_with("FALSIFIED") { return "FALSIFIED" }
    if t.starts_with("FAIL_CYCLE") { return "FALSIFIED" }
    if t.starts_with("FAIL ") { return "FALSIFIED" }
    if t.starts_with("FAIL_") { return "FALSIFIED" }

    // PARTIAL tier (leading token)
    if t.starts_with("PARTIAL") { return "PARTIAL" }
    if t.starts_with("DIRECTIONAL") { return "PARTIAL" }
    if t.starts_with("MAPPING_STRONG") { return "PARTIAL" }
    if t.starts_with("DISSOCIATION_CONFIRMED") { return "PARTIAL" }

    // SUPPORTED tier (leading token)
    if t.starts_with("SUPPORTED") { return "SUPPORTED" }
    if t.starts_with("PASS") { return "SUPPORTED" }

    // RUNNING tier: lane-open / pre-register-frozen / running
    if t.starts_with("lane-open") { return "RUNNING" }
    if t.starts_with("pre-register-frozen") { return "RUNNING" }
    if t.starts_with("running") { return "RUNNING" }

    // last-resort substring fallback (covers wrapped lines, parenthesized leads)
    if _str_contains(t, "FALSIFIED") { return "FALSIFIED" }
    if _str_contains(t, "FAIL_CYCLE") { return "FALSIFIED" }
    if _str_contains(t, "SUPPORTED") { return "SUPPORTED" }
    if _str_contains(t, "PASS") { return "SUPPORTED" }
    if _str_contains(t, "PARTIAL") { return "PARTIAL" }

    return "RUNNING"
}

// Jaccard between two canonical-domain sets (string arrays, pre-deduplicated)
fn _jaccard(a: [string], b: [string]) -> float {
    let la = len(a)
    let lb = len(b)
    if la == 0 && lb == 0 { return 0.0 }
    // intersection
    let mut inter = 0
    let mut i = 0
    while i < la {
        let mut j = 0
        let mut found = false
        while j < lb {
            if a[i] == b[j] { found = true; j = lb }
            j = j + 1
        }
        if found { inter = inter + 1 }
        i = i + 1
    }
    // union = la + lb − inter
    let uni = la + lb - inter
    if uni == 0 { return 0.0 }
    return to_float(inter) / to_float(uni)
}

// JSON-safe string escape: backslash + quote
fn _json_esc(s: string) -> string {
    return exec("printf %s '" + s + "' | sed 's/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g'")
}

// ── main ────────────────────────────────────────────────────────────────
fn main() {
    println("H_238 — verdict landscape meta-map · 22+ H tier distribution (raw#12)")
    println("  source: UNIVERSE/H_*.md frontmatter (domain + verdict_class)")
    println("")

    // enumerate H files (deterministic sort -V), excluding H_238 itself —
    // meta-instance L4 self-reference guard: H_238 measures the OTHER H_*, not itself.
    let listing = exec("ls " + _LIFE_DIR() + "/H_*.md | grep -v 'H_238_' | sort -V").trim()
    let files = listing.split("\n")
    let n = len(files)
    println("  N(H_files) = " + to_string(n) + "  (H_238 self-excluded)")
    println("")

    // per-H parse: id, domain_raw, verdict_raw, canonical_domains[], tier
    let mut ids = []
    let mut domains_raw = []
    let mut verdicts_raw = []
    let mut canonical_per_h = []  // array-of-arrays
    let mut tiers = []
    let mut unmapped_tokens = []

    let mut i = 0
    while i < n {
        let f = files[i].trim()
        // basename minus .md
        let bn = exec("basename '" + f + "' .md").trim()

        // frontmatter scrape: first matching line, with prefix stripped
        let dline = exec("grep -m1 '^domain:' '" + f + "' || true").trim()
        let vline = exec("grep -m1 '^verdict_class:' '" + f + "' || true").trim()

        let drest = _strip_prefix(dline, "domain:")
        let vrest = _strip_prefix(vline, "verdict_class:")

        // canonicalize domain tokens
        let tokens = _tokenize_domain(drest)
        let mut canon = []
        let mut tk = 0
        while tk < len(tokens) {
            let raw_tok = tokens[tk]
            let c = _canonicalize(raw_tok)
            if len(c) > 0 {
                // dedup within H
                let mut already = false
                let mut z = 0
                while z < len(canon) {
                    if canon[z] == c { already = true; z = len(canon) }
                    z = z + 1
                }
                if !already { canon = canon + [c] }
            } else {
                // record unmapped token (global)
                let mut seen = false
                let mut q = 0
                while q < len(unmapped_tokens) {
                    if unmapped_tokens[q] == raw_tok { seen = true; q = len(unmapped_tokens) }
                    q = q + 1
                }
                if !seen { unmapped_tokens = unmapped_tokens + [raw_tok] }
            }
            tk = tk + 1
        }

        let t = _tier(vrest)

        ids = ids + [bn]
        domains_raw = domains_raw + [drest]
        verdicts_raw = verdicts_raw + [vrest]
        canonical_per_h = canonical_per_h + [canon]
        tiers = tiers + [t]

        i = i + 1
    }

    // ── tier counts ──────────────────────────────────────────────────────
    let mut n_supp = 0
    let mut n_part = 0
    let mut n_fals = 0
    let mut n_runn = 0
    let mut ti = 0
    while ti < n {
        let t = tiers[ti]
        if t == "SUPPORTED" { n_supp = n_supp + 1 }
        if t == "PARTIAL"   { n_part = n_part + 1 }
        if t == "FALSIFIED" { n_fals = n_fals + 1 }
        if t == "RUNNING"   { n_runn = n_runn + 1 }
        ti = ti + 1
    }
    let sum_tiers = n_supp + n_part + n_fals + n_runn

    // SUPPORTED-vs-FALSIFIED ratio (H238.2): SUPP / (SUPP + FALS)
    let mut sf_ratio = 0.0
    if (n_supp + n_fals) > 0 {
        sf_ratio = to_float(n_supp) / to_float(n_supp + n_fals)
    }

    // ── per-domain counts + SUPPORTED rate ───────────────────────────────
    let domains = _DOMAINS()
    let nd = len(domains)
    let mut d_total = []
    let mut d_supp = []
    let mut d_part = []
    let mut d_fals = []
    let mut d_runn = []
    let mut di = 0
    while di < nd {
        d_total = d_total + [0]
        d_supp = d_supp + [0]
        d_part = d_part + [0]
        d_fals = d_fals + [0]
        d_runn = d_runn + [0]
        di = di + 1
    }
    // accumulate (an H with multiple canonical domains contributes to each)
    let mut hi = 0
    while hi < n {
        let cs = canonical_per_h[hi]
        let t = tiers[hi]
        let mut ci = 0
        while ci < len(cs) {
            // find bucket idx
            let mut bi = 0
            let mut hit = -1
            while bi < nd {
                if domains[bi] == cs[ci] { hit = bi; bi = nd }
                bi = bi + 1
            }
            if hit >= 0 {
                d_total[hit] = d_total[hit] + 1
                if t == "SUPPORTED" { d_supp[hit] = d_supp[hit] + 1 }
                if t == "PARTIAL"   { d_part[hit] = d_part[hit] + 1 }
                if t == "FALSIFIED" { d_fals[hit] = d_fals[hit] + 1 }
                if t == "RUNNING"   { d_runn[hit] = d_runn[hit] + 1 }
            }
            ci = ci + 1
        }
        hi = hi + 1
    }

    // domain cluster non-empty count
    let mut nonempty_domains = 0
    let mut k = 0
    while k < nd {
        if d_total[k] > 0 { nonempty_domains = nonempty_domains + 1 }
        k = k + 1
    }

    // ── H238.3 axis: ethics/info/language SUPPORTED rate vs consciousness/physics ────
    // language 는 본 cluster vocab 에 없음 → information 단독 + ethics + meta 의 group A;
    // consciousness + physics 의 group B 와 비교.
    let mut a_supp = 0
    let mut a_tot = 0
    let mut b_supp = 0
    let mut b_tot = 0
    let mut ix = 0
    while ix < nd {
        let dname = domains[ix]
        if dname == "ethics" || dname == "information" || dname == "meta" {
            a_supp = a_supp + d_supp[ix]
            a_tot = a_tot + d_total[ix]
        }
        if dname == "consciousness" || dname == "physics" {
            b_supp = b_supp + d_supp[ix]
            b_tot = b_tot + d_total[ix]
        }
        ix = ix + 1
    }
    let mut a_rate = 0.0
    if a_tot > 0 { a_rate = to_float(a_supp) / to_float(a_tot) }
    let mut b_rate = 0.0
    if b_tot > 0 { b_rate = to_float(b_supp) / to_float(b_tot) }

    // ── H238.4 axis: pairwise Jaccard of canonical-domain sets ───────────
    // identify top-3 pairs by Jaccard (descending); first index ties broken by H-id order.
    let mut pair_a = []
    let mut pair_b = []
    let mut pair_j = []
    let mut p1 = 0
    while p1 < n {
        let mut p2 = p1 + 1
        while p2 < n {
            let j = _jaccard(canonical_per_h[p1], canonical_per_h[p2])
            if j >= 0.5 {
                pair_a = pair_a + [ids[p1]]
                pair_b = pair_b + [ids[p2]]
                pair_j = pair_j + [j]
            }
            p2 = p2 + 1
        }
        p1 = p1 + 1
    }
    let n_high_j_pairs = len(pair_a)

    // ── VERBATIM landscape table ─────────────────────────────────────────
    println("  ── 22+ H landscape (deterministic, sort -V) ──")
    println("  i   id                                                          | tier      | canonical_domains")
    let mut pi = 0
    while pi < n {
        let cs = canonical_per_h[pi]
        let mut cstr = ""
        let mut ci2 = 0
        while ci2 < len(cs) {
            if ci2 > 0 { cstr = cstr + "+" }
            cstr = cstr + cs[ci2]
            ci2 = ci2 + 1
        }
        let idx_pad = to_string(pi)
        let row = "  " + idx_pad + "  " + ids[pi] + "  | " + tiers[pi] + "  | " + cstr
        println(row)
        pi = pi + 1
    }
    println("")

    // ── tier distribution table ──────────────────────────────────────────
    println("  ── tier distribution ──")
    println("  SUPPORTED  : " + to_string(n_supp) + " / " + to_string(n))
    println("  PARTIAL    : " + to_string(n_part) + " / " + to_string(n))
    println("  FALSIFIED  : " + to_string(n_fals) + " / " + to_string(n))
    println("  RUNNING    : " + to_string(n_runn) + " / " + to_string(n))
    println("  sum_tiers  : " + to_string(sum_tiers) + " (== N? " + to_string(sum_tiers == n) + ")")
    println("  SUPP/(SUPP+FAL) ratio = " + to_string(sf_ratio))
    println("")

    // ── domain table ─────────────────────────────────────────────────────
    println("  ── 7-domain cluster (canonical) ──")
    println("  domain         | total | SUPP | PART | FALS | RUNN | SUPP_rate")
    let mut dx = 0
    while dx < nd {
        let dname = domains[dx]
        let tot = d_total[dx]
        let mut rate = 0.0
        if tot > 0 { rate = to_float(d_supp[dx]) / to_float(tot) }
        println("  " + dname + "  | " + to_string(tot)
            + " | " + to_string(d_supp[dx])
            + " | " + to_string(d_part[dx])
            + " | " + to_string(d_fals[dx])
            + " | " + to_string(d_runn[dx])
            + " | " + to_string(rate))
        dx = dx + 1
    }
    println("  nonempty_domains : " + to_string(nonempty_domains) + " / " + to_string(nd))
    println("")

    // ── H238.3 group A vs group B ────────────────────────────────────────
    println("  ── H238.3 axis: SUPP rate {ethics+info+meta} vs {consc+phys} ──")
    println("  group_A (ethics+information+meta)   SUPP=" + to_string(a_supp) + " / " + to_string(a_tot) + "  rate=" + to_string(a_rate))
    println("  group_B (consciousness+physics)     SUPP=" + to_string(b_supp) + " / " + to_string(b_tot) + "  rate=" + to_string(b_rate))
    println("  H238.3 (A > B): " + to_string(a_rate > b_rate))
    println("")

    // ── H238.4 cross-correlation pairs (Jaccard ≥ 0.5) ───────────────────
    println("  ── H238.4 axis: domain-set Jaccard ≥ 0.5 pairs ──")
    println("  n_high_J_pairs = " + to_string(n_high_j_pairs))
    let mut pp = 0
    let lim = n_high_j_pairs
    while pp < lim {
        println("    " + pair_a[pp] + "  ↔  " + pair_b[pp] + "  J=" + to_string(pair_j[pp]))
        pp = pp + 1
    }
    println("")

    // ── criteria ─────────────────────────────────────────────────────────
    let c1_enumerate = n >= 22
    let c2_distribution = sum_tiers == n
    let c3_domain_cluster = nonempty_domains >= 3
    let c4_byte_identical = true  // deterministic by construction

    println("  ── criteria ──")
    println("  C1 ENUMERATE      (N ≥ 22)          : " + to_string(c1_enumerate) + "  (N=" + to_string(n) + ")")
    println("  C2 DISTRIBUTION   (sum == N)        : " + to_string(c2_distribution) + "  (sum=" + to_string(sum_tiers) + ")")
    println("  C3 DOMAIN_CLUSTER (≥3 buckets)      : " + to_string(c3_domain_cluster) + "  (nonempty=" + to_string(nonempty_domains) + ")")
    println("  C4 BYTE_IDENTICAL                   : " + to_string(c4_byte_identical))
    println("")

    // ── falsifiers ───────────────────────────────────────────────────────
    let f1_missing = !c1_enumerate
    let f2_inconsistent = !c2_distribution
    let f3_undef_cluster = !c3_domain_cluster
    let f4_byte_diff = !c4_byte_identical
    // F5: stats undefined ⇒ if sum_tiers != n, ratios invalid
    let f5_stats_undef = !c2_distribution

    println("  ── falsifiers (PASS = NOT triggered) ──")
    println("  F1 H_MISSING       : " + to_string(!f1_missing))
    println("  F2 TIER_INCONSIST  : " + to_string(!f2_inconsistent))
    println("  F3 CLUSTER_UNDEF   : " + to_string(!f3_undef_cluster))
    println("  F4 BYTE_DIFF       : " + to_string(!f4_byte_diff))
    println("  F5 STATS_UNDEF     : " + to_string(!f5_stats_undef))
    println("")

    let supported = c1_enumerate && c2_distribution && c3_domain_cluster
    let partial = c1_enumerate && c2_distribution && !c3_domain_cluster
    let mut verdict = "FALSIFIED"
    if supported { verdict = "SUPPORTED" }
    if partial   { verdict = "PARTIAL" }

    println("  VERDICT_RULE: SUPPORTED iff C1 ∧ C2 ∧ C3 · PARTIAL iff C1 ∧ C2 ∧ ¬C3 · else FALSIFIED")
    println("  VERDICT     : " + verdict)
    println("")

    // ── write result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_238\",\n"
    j = j + "  \"slug\": \"verdict-landscape-meta-map\",\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"sister\": \"all 22+ UNIVERSE/H_*.md (meta-result-of-results)\",\n"
    j = j + "  \"config\": { \"N_files\": " + to_string(n)
          + ", \"n_domains\": " + to_string(nd)
          + ", \"source_dir\": \"UNIVERSE\""
          + ", \"sort\": \"-V\" },\n"

    // per-H landscape
    j = j + "  \"landscape\": [\n"
    let mut wi = 0
    while wi < n {
        let cs = canonical_per_h[wi]
        let mut carr = "["
        let mut cc = 0
        while cc < len(cs) {
            if cc > 0 { carr = carr + ", " }
            carr = carr + "\"" + cs[cc] + "\""
            cc = cc + 1
        }
        carr = carr + "]"
        let v_esc = _json_esc(verdicts_raw[wi])
        let d_esc = _json_esc(domains_raw[wi])
        j = j + "    { \"i\": " + to_string(wi)
              + ", \"id\": \"" + ids[wi] + "\""
              + ", \"domain_raw\": \"" + d_esc + "\""
              + ", \"verdict_raw\": \"" + v_esc + "\""
              + ", \"canonical_domains\": " + carr
              + ", \"tier\": \"" + tiers[wi] + "\""
              + " }"
        if wi < n - 1 { j = j + "," }
        j = j + "\n"
        wi = wi + 1
    }
    j = j + "  ],\n"

    // tier distribution
    j = j + "  \"tier_distribution\": {\n"
    j = j + "    \"SUPPORTED\": " + to_string(n_supp) + ",\n"
    j = j + "    \"PARTIAL\":   " + to_string(n_part) + ",\n"
    j = j + "    \"FALSIFIED\": " + to_string(n_fals) + ",\n"
    j = j + "    \"RUNNING\":   " + to_string(n_runn) + ",\n"
    j = j + "    \"sum\": " + to_string(sum_tiers) + ",\n"
    j = j + "    \"sum_eq_N\": " + to_string(sum_tiers == n) + ",\n"
    j = j + "    \"SUPP_over_SUPP_plus_FALS\": " + to_string(sf_ratio) + "\n"
    j = j + "  },\n"

    // domain table
    j = j + "  \"domain_table\": [\n"
    let mut dxw = 0
    while dxw < nd {
        let tot = d_total[dxw]
        let mut rate = 0.0
        if tot > 0 { rate = to_float(d_supp[dxw]) / to_float(tot) }
        j = j + "    { \"domain\": \"" + domains[dxw] + "\""
              + ", \"total\": " + to_string(tot)
              + ", \"SUPPORTED\": " + to_string(d_supp[dxw])
              + ", \"PARTIAL\": " + to_string(d_part[dxw])
              + ", \"FALSIFIED\": " + to_string(d_fals[dxw])
              + ", \"RUNNING\": " + to_string(d_runn[dxw])
              + ", \"SUPP_rate\": " + to_string(rate)
              + " }"
        if dxw < nd - 1 { j = j + "," }
        j = j + "\n"
        dxw = dxw + 1
    }
    j = j + "  ],\n"
    j = j + "  \"nonempty_domains\": " + to_string(nonempty_domains) + ",\n"

    // H238.3 group A vs B
    j = j + "  \"H238_3_axis\": {\n"
    j = j + "    \"group_A_label\": \"ethics+information+meta\",\n"
    j = j + "    \"group_A_supp\": " + to_string(a_supp) + ",\n"
    j = j + "    \"group_A_total\": " + to_string(a_tot) + ",\n"
    j = j + "    \"group_A_rate\": " + to_string(a_rate) + ",\n"
    j = j + "    \"group_B_label\": \"consciousness+physics\",\n"
    j = j + "    \"group_B_supp\": " + to_string(b_supp) + ",\n"
    j = j + "    \"group_B_total\": " + to_string(b_tot) + ",\n"
    j = j + "    \"group_B_rate\": " + to_string(b_rate) + ",\n"
    j = j + "    \"A_greater_than_B\": " + to_string(a_rate > b_rate) + "\n"
    j = j + "  },\n"

    // pairwise jaccard (≥0.5)
    j = j + "  \"H238_4_axis\": {\n"
    j = j + "    \"jaccard_threshold\": 0.5,\n"
    j = j + "    \"n_high_jaccard_pairs\": " + to_string(n_high_j_pairs) + ",\n"
    j = j + "    \"pairs\": [\n"
    let mut pw = 0
    while pw < n_high_j_pairs {
        j = j + "      { \"a\": \"" + pair_a[pw] + "\""
              + ", \"b\": \"" + pair_b[pw] + "\""
              + ", \"jaccard\": " + to_string(pair_j[pw])
              + " }"
        if pw < n_high_j_pairs - 1 { j = j + "," }
        j = j + "\n"
        pw = pw + 1
    }
    j = j + "    ]\n"
    j = j + "  },\n"

    // unmapped tokens
    j = j + "  \"unmapped_tokens\": ["
    let mut um = 0
    while um < len(unmapped_tokens) {
        if um > 0 { j = j + ", " }
        j = j + "\"" + unmapped_tokens[um] + "\""
        um = um + 1
    }
    j = j + "],\n"

    // criteria
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_ENUMERATE\":        { \"metric\": \"N(H files) ≥ 22\", \"value\": " + to_string(n) + ", \"verdict\": \"" + to_string(c1_enumerate) + "\" },\n"
    j = j + "    \"C2_DISTRIBUTION\":     { \"metric\": \"sum(tiers) == N\", \"value\": " + to_string(sum_tiers) + ", \"verdict\": \"" + to_string(c2_distribution) + "\" },\n"
    j = j + "    \"C3_DOMAIN_CLUSTER\":   { \"metric\": \"≥3 nonempty domain buckets\", \"value\": " + to_string(nonempty_domains) + ", \"verdict\": \"" + to_string(c3_domain_cluster) + "\" },\n"
    j = j + "    \"C4_BYTE_IDENTICAL\":   { \"metric\": \"deterministic by construction\", \"verdict\": \"" + to_string(c4_byte_identical) + "\" }\n"
    j = j + "  },\n"

    // falsifiers (boolean: triggered? false = PASS)
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_H_MISSING\":      { \"triggered\": " + to_string(f1_missing) + " },\n"
    j = j + "    \"F2_TIER_INCONSIST\": { \"triggered\": " + to_string(f2_inconsistent) + " },\n"
    j = j + "    \"F3_CLUSTER_UNDEF\":  { \"triggered\": " + to_string(f3_undef_cluster) + " },\n"
    j = j + "    \"F4_BYTE_DIFF\":      { \"triggered\": " + to_string(f4_byte_diff) + " },\n"
    j = j + "    \"F5_STATS_UNDEF\":    { \"triggered\": " + to_string(f5_stats_undef) + " }\n"
    j = j + "  },\n"

    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1 ∧ C2 ∧ C3 · PARTIAL iff C1 ∧ C2 ∧ ¬C3 · else FALSIFIED\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"evidence_tier\": \"🟢 NUMERICAL\"\n"
    j = j + "}\n"
    write_file(_STATE_DIR() + "/result.json", j)

    println("  result.json written → " + _STATE_DIR() + "/result.json")
    println("=== H_238 verdict-landscape meta-map smoke complete: " + verdict + " ===")
}
