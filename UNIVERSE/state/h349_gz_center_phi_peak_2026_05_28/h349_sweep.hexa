// h349_sweep.hexa — H_349 inhibition sweep × big-Φ measurement
//
//   GOAL  measure faithful IIT 4.0 big-Φ as a function of substrate inhibition I,
//         on a ring-of-n ECA TPM whose firing probability is gated by (1-I).
//         Hypothesis (H_349): big-Φ peaks at I = 1/e ≈ 0.3679 (single-peak).
//         Falsifier: peak position outside [1/e - 0.05, 1/e + 0.05], OR
//                    bimodal / flat / monotone shape.
//
//   SUBSTRATE
//     Wolfram ECA rule 110 (Class 4, complex behavior) on a ring of n=4 cells.
//     For each I ∈ sweep grid, build a stochastic TPM:
//       For each (state s, cell i) with deterministic next-bit b ∈ {0,1}:
//         P(next_i = 1 | s) = (1 - I) · b              // (high I = suppress fire)
//     Then run faithful big_phi() on the resulting fractional TPM, in the
//     all-zeros / all-ones / center system state (cycled per I for fair sampling).
//
//   GRID  14 points, denser near 1/e:
//     {0.05, 0.10, 0.15, 0.21, 0.25, 0.30, 0.35, 0.37, 0.40, 0.45, 0.50, 0.60, 0.75, 0.95}
//
//   OUTPUT  CSV stream stdout: I, big_phi, total, sum_d, sum_r, nd
//           Then summary: argmax_I, peak_phi, |argmax - 1/e|, shape verdict.

import "stdlib/consciousness/iit4_bigphi.hexa"

// Inhibition-gated stochastic TPM for ECA rule on n cells.
// Each entry t[s*n + i] = (1 - I) if deterministic next-bit is 1, else 0.
fn eca_tpm_inhibited(rule: int, n: int, I: float) -> array {
    let full = iit4_pow2(n)
    let p_fire = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            let b = iit4_bit(rule, idx)
            if b == 1 {
                t = t.push(p_fire)
            } else {
                t = t.push(0.0)
            }
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn sweep_one(rule: int, n: int, sys_state: int, I: float) {
    let tpm = eca_tpm_inhibited(rule, n, I)
    let r = big_phi(tpm, n, sys_state)
    // CSV row: I,big_phi,total,sum_d,sum_r,nd
    println("ROW", I, r[0], r[1], r[2], r[3], r[4])
}

fn main() {
    let rule = 110
    let n = 4
    // pick a non-trivial system state — half-on (binary 0101 = 5)
    let sys_state = 5

    // sweep grid (denser near 1/e ≈ 0.3679)
    let grid = [0.05, 0.10, 0.15, 0.21, 0.25, 0.30, 0.35, 0.37, 0.40, 0.45, 0.50, 0.60, 0.75, 0.95]

    println("# H_349 inhibition sweep · rule=", rule, "n=", n, "sys_state=", sys_state)
    println("# grid len=", len(grid))
    println("# 1/e =", 0.36787944117144233)
    let mut k = 0
    while k < len(grid) {
        sweep_one(rule, n, sys_state, grid[k])
        k = k + 1
    }
    println("# done")
}
