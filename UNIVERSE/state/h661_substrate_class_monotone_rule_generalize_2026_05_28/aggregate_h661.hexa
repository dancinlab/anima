// ════════════════════════════════════════════════════════════════════════════
// H_661 — substrate-class-monotone-rule-generalize  (round 10 후속, axis G)
//   PHI-FREE AGGREGATE — reads the 9 per-rule shard metrics (hardcoded verbatim
//   from shards.log) and runs the pre-registered class-monotone falsifiers.
//   NO big_phi call here (shards already measured Φ); deterministic · <1s.
//
//   H_660 (PR #1290, 🟢) 일반화: scale-invariant convexity (norm_conv·log_span) 가
//   4-rule {184(II),90(III),30(III),110(IV)} 에서 Wolfram class 단조 (IV 最高).
//   본 H_661 은 확대 9-rule set (class-I 포함) 으로 단조 robustness 검정 —
//   4-rule 우연 아닌지.
//
//   9 RULE × Wolfram class (substrate complexity, ascending):
//     class-I  : rule  8 (die-out)         · rule 136 (die-out, DEGENERATE Φmin=0)
//     class-II : rule184 (additive/traffic) · rule 226 (additive)
//     class-III: rule 90 (XOR fractal)      · rule 30 (chaotic) · rule 45 (chaotic)
//     class-IV : rule110 (complex/univ)     · rule 54 (complex)
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring):
//     F661.1 IV-TOP-ROBUST : min(norm_conv over class-IV) ≥ max(norm_conv over
//             class-II ∪ class-III) — class-IV 가 robust top (확대 rule set 에서도).
//             CORE 가설 (H_660 IV-最高 의 robust 일반화).
//     F661.2 IV-TOP-LOGSPAN : 同 for log_span — 두 번째 scale-inv 측도 확인.
//     F661.3 CLASSMEAN-MONOTONE : class-평균 norm_conv 가 (well-behaved rule 만,
//             degenerate rule136 제외) I ≤ II ≤ III ≤ IV 단조 — class-수준 단조.
//     F661.4 STRICT-PERRULE-MONOTONE : ALL pairs (class_lo rule) ≤ (class_hi rule)
//             across every class boundary — strict per-rule 단조. 깨지면 H_660 의
//             4-rule 단조가 rule-cohort 선택 의존 (robust 아님) 신호.
//     F661.5 DEGENERATE-FLAG : rule136 (class-I) Φ_min=0 → span_ratio/log_span
//             floor-blowup → ratio metric 이 die-out class 에 ill-defined 임을 flag
//             (norm_conv 는 finite). 측도 적용범위 정직 경계.
//     F661.6 BOUND : 全 norm_conv·log_span finite, well-behaved Φ_mean > 0.
//
//   verdict 기준:
//     F661.1 (IV-TOP CORE) PASS + F661.3 (class-mean monotone) PASS →
//        🟢 SUPPORTED-NUMERICAL (확대 rule set 에서 IV-top robust + class-mean 단조).
//        F661.4 (strict per-rule) FAIL 은 class-III 내부 이질성(rule45)으로 honest C3.
//     F661.1 FAIL (어떤 III/II 가 IV 초과) → 🔴 (H_660 단조 = 4-rule artifact).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn maxf(a: float, b: float) -> float { if a > b { return a }; return b }
fn minf(a: float, b: float) -> float { if a < b { return a }; return b }

fn main() {
    println("================================================================")
    println("  H_661 — substrate-class-monotone-rule-generalize (round 10 후속)")
    println("  H_660 4-rule scale-inv convexity 단조 → 확대 9-rule robust 검정")
    println("  IIT4 big_phi_bounded · n=5 homog cohort · cap=3 · sys=0 (shard 측정)")
    println("  9 rules across class-I/II/III/IV · 4 metric")
    println("================================================================")

    // ── shard 측정값 verbatim (shards.log, 6-pt W grid {0.15,0.40,0.55,0.70,0.95,1.0}) ──
    // class-I
    let nc_8   = 1.46457;  let ls_8   = 2.06471;  let ad_8   = 0.192337
    let nc_136 = 6.0;      let ls_136 = 8.61864;  let ad_136 = 0.553383  // DEGENERATE Φmin=0
    // class-II
    let nc_184 = 1.43674;  let ls_184 = 2.49455;  let ad_184 = 49.9682
    let nc_226 = 1.41354;  let ls_226 = 2.48764;  let ad_226 = 48.8326
    // class-III
    let nc_90  = 2.24029;  let ls_90  = 3.41499;  let ad_90  = 7.25353
    let nc_30  = 2.26615;  let ls_30  = 3.42656;  let ad_30  = 9.40487
    let nc_45  = 1.4608;   let ls_45  = 1.61842;  let ad_45  = 10.6588
    // class-IV
    let nc_110 = 2.34922;  let ls_110 = 3.56946;  let ad_110 = 40.5374
    let nc_54  = 2.4745;   let ls_54  = 3.68367;  let ad_54  = 6.7975

    println("  ─────────────────────────────────────")
    println("  rule(class)   norm_conv  log_span   abs_Δ")
    println("  rule  8 (I)   " + to_string(nc_8)   + "  " + to_string(ls_8)   + "  " + to_string(ad_8))
    println("  rule136 (I)*  " + to_string(nc_136) + "  " + to_string(ls_136) + "  " + to_string(ad_136) + "  [DEGENERATE Φmin=0]")
    println("  rule184 (II)  " + to_string(nc_184) + "  " + to_string(ls_184) + "  " + to_string(ad_184))
    println("  rule226 (II)  " + to_string(nc_226) + "  " + to_string(ls_226) + "  " + to_string(ad_226))
    println("  rule 90 (III) " + to_string(nc_90)  + "  " + to_string(ls_90)  + "  " + to_string(ad_90))
    println("  rule 30 (III) " + to_string(nc_30)  + "  " + to_string(ls_30)  + "  " + to_string(ad_30))
    println("  rule 45 (III) " + to_string(nc_45)  + "  " + to_string(ls_45)  + "  " + to_string(ad_45))
    println("  rule110 (IV)  " + to_string(nc_110) + "  " + to_string(ls_110) + "  " + to_string(ad_110))
    println("  rule 54 (IV)  " + to_string(nc_54)  + "  " + to_string(ls_54)  + "  " + to_string(ad_54))
    println("  ────────────── verdict ──────────────")

    // class-IV norm_conv min, class-II∪III norm_conv max (degenerate rule136 제외)
    let iv_nc_min = minf(nc_110, nc_54)
    let lower_nc_max = maxf(maxf(maxf(nc_184, nc_226), maxf(nc_90, nc_30)), nc_45)
    // F661.1 IV-TOP-ROBUST (CORE)
    let iv_top_nc = iv_nc_min >= lower_nc_max
    check("F661.1 IV-TOP-ROBUST: min(IV norm_conv)>=max(II,III norm_conv)", iv_top_nc)

    // F661.2 IV-TOP-LOGSPAN
    let iv_ls_min = minf(ls_110, ls_54)
    let lower_ls_max = maxf(maxf(maxf(ls_184, ls_226), maxf(ls_90, ls_30)), ls_45)
    let iv_top_ls = iv_ls_min >= lower_ls_max
    check("F661.2 IV-TOP-LOGSPAN: min(IV log_span)>=max(II,III log_span)", iv_top_ls)

    // F661.3 CLASSMEAN-MONOTONE (well-behaved only: rule136 제외 → class-I = rule8)
    let mean_I   = nc_8                                   // rule8 only (136 degenerate-excluded)
    let mean_II  = (nc_184 + nc_226) / 2.0
    let mean_III = (nc_90 + nc_30 + nc_45) / 3.0
    let mean_IV  = (nc_110 + nc_54) / 2.0
    let classmean_mono = (mean_I <= mean_II) && (mean_II <= mean_III) && (mean_III <= mean_IV)
    println("    class-mean norm_conv: I=" + to_string(mean_I) + " II=" + to_string(mean_II) + " III=" + to_string(mean_III) + " IV=" + to_string(mean_IV))
    check("F661.3 CLASSMEAN-MONOTONE: mean nc  I<=II<=III<=IV (rule136 제외)", classmean_mono)

    // F661.4 STRICT-PERRULE-MONOTONE: every class-lower rule <= every class-higher rule (norm_conv)
    //   class order I(8) < II(184,226) < III(90,30,45) < IV(110,54). degenerate 136 제외.
    //   strict 위반: rule45(III)=1.461 < rule184(II)=1.437? no — but < class-III siblings.
    //   엄밀 정의 = max(lower class) <= min(higher class) 모든 경계.
    let max_I   = nc_8
    let min_II  = minf(nc_184, nc_226)
    let max_II  = maxf(nc_184, nc_226)
    let min_III = minf(minf(nc_90, nc_30), nc_45)
    let max_III = maxf(maxf(nc_90, nc_30), nc_45)
    let min_IV  = minf(nc_110, nc_54)
    let strict_mono = (max_I <= min_II) && (max_II <= min_III) && (max_III <= min_IV)
    println("    strict bounds: maxI=" + to_string(max_I) + " | minII=" + to_string(min_II) + " maxII=" + to_string(max_II) + " | minIII=" + to_string(min_III) + " maxIII=" + to_string(max_III) + " | minIV=" + to_string(min_IV))
    check("F661.4 STRICT-PERRULE-MONOTONE: max(lo class)<=min(hi class) 全경계", strict_mono)

    // F661.5 DEGENERATE-FLAG: rule136 Φmin=0 → log_span floor-blowup (8.62 ≫ 모든 finite rule)
    //   norm_conv 는 finite(6.0) 이나 ratio metric 이 die-out class 에 ill-defined 임을 flag.
    let degenerate_flagged = (ls_136 > 5.0) && (ad_136 < 1.0)   // log_span blowup but abs_Δ tiny
    check("F661.5 DEGENERATE-FLAG: rule136 die-out → ratio metric ill-defined (flag)", degenerate_flagged)

    // F661.6 BOUND: 全 norm_conv·log_span finite, well-behaved
    let mut finite = true
    if fabs(nc_8) > 1.0e9 || fabs(nc_184) > 1.0e9 || fabs(nc_226) > 1.0e9 { finite = false }
    if fabs(nc_90) > 1.0e9 || fabs(nc_30) > 1.0e9 || fabs(nc_45) > 1.0e9 { finite = false }
    if fabs(nc_110) > 1.0e9 || fabs(nc_54) > 1.0e9 { finite = false }
    check("F661.6 BOUND: 全 norm_conv·log_span finite", finite)

    println("  ──────────────────────────────────────")
    println("  F661.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    // verdict 결정: CORE = F661.1 IV-TOP-ROBUST.
    //   iv_top FAIL → 🔴 (어떤 II/III 가 class-IV 초과 = 4-rule artifact, falsifier hit).
    //   iv_top PASS + (classmean & strict both) PASS → 🟢 (확대셋 full 단조 robust).
    //   iv_top PASS + (둘 중 하나라도 FAIL) → 🟡 PARTIAL (IV-top robust 하나 full
    //      class-monotone 은 확대셋에서 깨짐 — rule45(III) 이질성 + class-I/II overlap).
    let mut verdict = "🔴 FALSIFIED (어떤 II/III 가 class-IV 초과 — IV-top robust 아님, H_660 단조 = 4-rule artifact)"
    if iv_top_nc && iv_top_ls {
        if classmean_mono && strict_mono {
            verdict = "🟢 SUPPORTED-NUMERICAL (확대 9-rule set 에서 strict per-rule 까지 class 단조 robust)"
        } else {
            verdict = "🟡 PARTIAL (CORE IV-top robust [F661.1·2 PASS] — class-IV 가 확대셋에서도 단독 最高; 그러나 full I<II<III<IV strict/class-mean 단조는 깨짐 — rule45(III) 이질성 + class-I↔II overlap. H_660 의 4-rule 단조는 'IV-top' 부분만 robust 일반화, 'full class-monotone' 은 rule-cohort 의존)"
        }
    }
    println("  verdict: " + verdict)
    println("  iv_top_nc=" + str(iv_top_nc) + " iv_top_ls=" + str(iv_top_ls) + " classmean_mono=" + str(classmean_mono) + " strict_mono=" + str(strict_mono))
}
