// UNIVERSE/state/h288_kolmogorov_complexity_phi_correlate_2026_05_26/run_h288.hexa
//
//   H_288 — Does faithful IIT 4.0 big-Φ track Kolmogorov complexity (LZ)?
//   (AXES.md R5 information `kolmogorov-complexity-Φ` — sister of H_287)
//
//   QUESTION
//     H_287 showed faithful big-Φ does NOT reduce to SHANNON entropy. The other
//     classical information currency is ALGORITHMIC (Kolmogorov) complexity —
//     "how incompressible is the behaviour". Its standard estimator is Lempel-Ziv
//     (LZ76) complexity of the rule's spacetime diagram (the PCI / consciousness-
//     studies proxy). Does Φ track LZ-complexity monotonically?
//
//   SEED-HYPOTHESIS H1 (reductive — TESTED, may be falsified)
//     Across an ECA substrate panel, faithful state-averaged big-Φ co-varies
//     with normalised LZ-complexity: Pearson r(LZ_norm, Φ_mean) >= 0.5.
//
//   METHOD (reuse HEXAD/IIT4/lib — g61 / NO reinvention)
//     • big_phi(tpm,n,st)  — faithful big-Φ            (iit4_bigphi via stdlib)
//     • eca_tpm / iit4_bit — TPM bridge · rule-bit      (iit4_eca / iit4_tpm)
//     PER-RULE METRICS:
//       LZ_norm = Lempel-Ziv (1976, Kaspar-Schuster) complexity of the SPACETIME
//                 diagram — ring of NL cells evolved T steps from a single-seed
//                 (center 1), concatenated row-major into an NL*T bit string,
//                 parsed into distinct phrases; normalised c·log2(L)/L so a random
//                 string → ~1. (Macroscopic dynamical complexity of the rule —
//                 same DIM=NL convention as H_204/H_268 class-mapping.)
//       Φ_mean  = mean over all 2^n states of big_phi(tpm,n,st)[0]  (n=4 exact).
//                 (Microscopic faithful integration of the SAME rule.)
//     CORRELATE: Pearson r + Spearman ρ over the 10-rule panel (same panel as
//                H_287 for cross-comparability).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26, BEFORE measuring r / Φ_mean)
//     F288.1 DISSOCIATION-WITNESS (decisive) — a rule with Φ_mean=0 yet non-trivial
//            complexity exists: rule 90 (XOR-L⊕R, the H_285 synchronisation-death
//            rule) has Φ_mean < 1e-9 AND LZ_norm > LZ_norm(constant rule 0) + 0.1.
//            ⇒ complexity ≠ integration.
//     F288.2 r-VERDICT — Pearson r(LZ_norm, Φ_mean). H1 SUPPORTED iff r >= 0.5 ;
//            FALSIFIED iff r < 0.5 (Φ ⊥ Kolmogorov complexity). r + Spearman ρ
//            reported verbatim — measurement decides.
//     F288.3 ANCHORS — constant rules 0/255: LZ_norm < 0.1 (single repeated symbol)
//            AND Φ_mean=0 ; identity 204: Φ_mean=0.
//     F288.4 BOUND — LZ_norm >= 0 and Φ_mean >= 0 for every rule.
//     F288.5 DETERMINISM — rule 30 (LZ_norm, Φ_mean) re-run bit-identical.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope: LZ on NL=14 ring single-seed (one complexity estimator of many);
//     Φ_mean averages a state-dependent quantity; n=4 small.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-life-seq/HEXAD/IIT4/lib/iit4_eca.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }
fn nsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// next ECA row from current row (Wolfram neighbourhood, ring wrap; reuse iit4_bit).
fn eca_next_row(rule: int, row: array, n: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let l = row[(i - 1 + n) % n]
        let c = row[i]
        let rr = row[(i + 1) % n]
        let idx = 4 * l + 2 * c + rr
        out = out.push(iit4_bit(rule, idx))
        i = i + 1
    }
    return out
}

// build the spacetime bit string (row-major) of `rule` on NL cells over T steps,
// seeded with a single 1 at the centre.
fn spacetime(rule: int, nl: int, t: int) -> array {
    let mut row = []
    let mut i = 0
    while i < nl { row = row.push(0); i = i + 1 }
    row[nl / 2] = 1                                      // single-seed centre
    let mut s = []
    let mut step = 0
    while step < t {
        let mut j = 0
        while j < nl { s = s.push(row[j]); j = j + 1 }
        row = eca_next_row(rule, row, nl)
        step = step + 1
    }
    return s
}

// Lempel-Ziv (1976) complexity — canonical Kaspar-Schuster parse.
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}

// normalised LZ complexity: c · log2(L) / L  (random binary string → ~1).
fn lz_norm(rule: int) -> float {
    let nl = 14
    let t = 64
    let s = spacetime(rule, nl, t)
    let len = nl * t
    let c = lz76(s, len)
    return to_float(c) * log2(to_float(len)) / to_float(len)
}

// state-averaged big-Φ over all 2^n states (n exact).
fn phi_mean(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut acc = 0.0
    let mut st = 0
    while st < full { acc = acc + big_phi(tpm, n, st)[0]; st = st + 1 }
    return acc / to_float(full)
}

fn pearson(xs: array, ys: array, m: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < m { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(m)
    let my = sy / to_float(m)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    i = 0
    while i < m {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        i = i + 1
    }
    if (vx < 0.000000000001) || (vy < 0.000000000001) { return 0.0 }
    return cov / nsqrt(vx * vy)
}

// fractional rank of xs[idx] among m (average-rank ties) → Spearman via Pearson-on-ranks.
fn rank_of(xs: array, m: int, idx: int) -> float {
    let mut less = 0.0
    let mut eq = 0.0
    let mut i = 0
    while i < m {
        if xs[i] < xs[idx] - 0.000000001 { less = less + 1.0 }
        if approx(xs[i], xs[idx]) { eq = eq + 1.0 }
        i = i + 1
    }
    return less + (eq - 1.0) / 2.0
}
fn spearman(xs: array, ys: array, m: int) -> float {
    let mut rx = []
    let mut ry = []
    let mut i = 0
    while i < m { rx = rx.push(rank_of(xs, m, i)); ry = ry.push(rank_of(ys, m, i)); i = i + 1 }
    return pearson(rx, ry, m)
}

fn main() {
    let n = 4
    println("================================================================")
    println("  H_288 — Does faithful IIT4 big-Phi track Kolmogorov (LZ) complexity?")
    println("  (LZ_norm = LZ76 spacetime NL=14 T=64 single-seed · Phi_mean = state-avg big-Phi n=4)")
    println("================================================================")

    let rules = [0, 255, 204, 51, 150, 105, 90, 60, 110, 30]
    let m = 10
    let mut zs = []          // LZ_norm
    let mut ps = []          // Phi_mean
    let mut idx = 0
    while idx < m {
        let r = rules[idx]
        let z = lz_norm(r)
        let p = phi_mean(r, n)
        zs = zs.push(z)
        ps = ps.push(p)
        println("  rule " + str(r) + " : LZ_norm=" + str(z) + "   Phi_mean=" + str(p))
        idx = idx + 1
    }

    // ── F288.2 r-VERDICT ────────────────────────────────────────────────
    let r = pearson(zs, ps, m)
    let rho = spearman(zs, ps, m)
    println("  --")
    println("  F288.2: Pearson r(LZ_norm, Phi_mean)=" + str(r) + "   Spearman rho=" + str(rho))
    let h1_supported = r >= 0.5
    if h1_supported { println("          => H1 SUPPORTED (r >= 0.5): Phi tracks LZ-complexity") }
    else { println("          => H1 FALSIFIED (r < 0.5): Phi does NOT track Kolmogorov complexity") }

    // ── F288.1 DISSOCIATION-WITNESS (rule 90 = idx 6 ; constant 0 = idx 0) ──
    let z90 = zs[6]
    let p90 = ps[6]
    let z0 = zs[0]
    println("  F288.1: rule 90 (sync-death) LZ_norm=" + str(z90) + " Phi_mean=" + str(p90) + " ; constant rule 0 LZ_norm=" + str(z0))
    check("F288.1a WITNESS: rule 90 Phi_mean < 1e-9 (zero integration)", p90 < 0.000000001)
    check("F288.1b WITNESS: rule 90 LZ_norm > rule0 LZ_norm + 0.1 (non-trivial complexity at zero Phi)", z90 > z0 + 0.1)

    // ── F288.3 ANCHORS ──────────────────────────────────────────────────
    check("F288.3a ANCHOR: rule 0 (constant) LZ_norm < 0.1", zs[0] < 0.1)
    check("F288.3b ANCHOR: rule 0 (constant) Phi_mean = 0", approx(ps[0], 0.0))
    check("F288.3c ANCHOR: rule 255 (constant) LZ_norm < 0.1", zs[1] < 0.1)
    check("F288.3d ANCHOR: rule 255 (constant) Phi_mean = 0", approx(ps[1], 0.0))
    check("F288.3e ANCHOR: rule 204 (identity) Phi_mean = 0", approx(ps[2], 0.0))

    // ── F288.4 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < m {
        if !(zs[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(ps[b] >= 0.0 - 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F288.4 BOUND: LZ_norm >= 0 and Phi_mean >= 0 for all rules", bound_ok)

    // ── F288.5 DETERMINISM ──────────────────────────────────────────────
    let z30b = lz_norm(30)
    let p30b = phi_mean(30, n)
    check("F288.5 DETERMINISM: rule 30 (LZ_norm, Phi_mean) re-run identical", approx(zs[9], z30b) && approx(ps[9], p30b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if h1_supported {
        println("  VERDICT: H1 SUPPORTED — Phi tracks Kolmogorov (LZ) complexity (r>=0.5)")
    } else {
        println("  VERDICT: H1 FALSIFIED (CLOSED-NEGATIVE) — faithful big-Phi does NOT track")
        println("           Kolmogorov complexity. With H_287 (Shannon entropy): NEITHER")
        println("           classical information currency monotonically tracks integration.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_288 had FALSIFIER FAILURES (distinct from H1 verdict)") }
}
