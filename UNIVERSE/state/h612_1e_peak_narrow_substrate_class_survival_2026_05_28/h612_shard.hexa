// h612_shard.hexa — single (rule, sys_state) × 2-point I shard runner
//
//   n=5 big_phi ~20s/point. Each shard runs at most 4 I points to stay under 60s wall.
//   invoked many times — once per (rule, I-cluster) pairing — by orchestrator.
//   Edit constants RULE / SYS / I_LIST below per invocation.

import "stdlib/consciousness/iit4_bigphi.hexa"

fn eca_tpm_inhibited(rule: int, n: int, I: float) -> array {
    let full = iit4_pow2(n)
    let p_fire = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            let b = iit4_bit(rule, idx)
            if b == 1 {
                t = t.push(p_fire)
            } else {
                t = t.push(0.0)
            }
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn run_shard(rule: int, n: int, sys_state: int, i_list: array) {
    let mut k = 0
    while k < len(i_list) {
        let I = i_list[k]
        let tpm = eca_tpm_inhibited(rule, n, I)
        let r = big_phi(tpm, n, sys_state)
        println("ROW", rule, sys_state, I, r[0])
        k = k + 1
    }
}

fn main() {
    let n = 5
    let sys_state = 5

    // SHARD CONFIG — edit per invocation
    let RULE = 90
    let I_LIST = [0.20, 0.25]

    println("# H_612 shard · rule=", RULE, "n=", n, "sys=", sys_state)
    run_shard(RULE, n, sys_state, I_LIST)
    println("# done shard")
}
