// h612_probe.hexa — single-point timing probe at n=5, rule 90, sys=5, I=0.35
//
//   purpose: verify n=5 big_phi runs in reasonable wall before full 4-rule × 8-grid sweep.

import "stdlib/consciousness/iit4_bigphi.hexa"

fn eca_tpm_inhibited(rule: int, n: int, I: float) -> array {
    let full = iit4_pow2(n)
    let p_fire = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            let idx = 4 * l + 2 * c + r
            let b = iit4_bit(rule, idx)
            if b == 1 {
                t = t.push(p_fire)
            } else {
                t = t.push(0.0)
            }
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn main() {
    let n = 5
    let rule = 90
    let sys_state = 5
    let I = 0.35
    let tpm = eca_tpm_inhibited(rule, n, I)
    let r = big_phi(tpm, n, sys_state)
    println("PROBE rule=", rule, "n=", n, "sys=", sys_state, "I=", I, "phi=", r[0])
}
