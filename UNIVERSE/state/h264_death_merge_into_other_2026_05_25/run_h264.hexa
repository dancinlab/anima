// ════════════════════════════════════════════════════════════════════════════
//  run_h264.hexa — H_264 death = merge-into-other (asymmetric absorption)
//                  death/genesis cross-link H_025 ⊕ H_054 (H_025 distinct)
//
//  CORE QUESTION
//    Model death as ASYMMETRIC absorption-into-other (merge-into-other): when a
//    cell dies, its weight/info is transferred into ONE specific absorber cell
//    via an asymmetric blend
//        absorber_new = (1 - alpha) * absorber + alpha * dying
//    with small alpha (absorber dominates, dying is partially absorbed).
//    Does the dying cell's weight/info get PRESERVED-TRANSFERRED into the
//    absorber? Heidegger (death = the end of possibility) x Margulis
//    (endosymbiosis = asymmetric host-preserve integration).
//
//  DISTINCT FROM H_025 (REQUIRED)
//    H_025 death = symmetric merge toward the pool floor (self-annihilation;
//                  keeper gets (w_dying + w_keeper)/2, uniform 50/50 collapse,
//                  the dying cell's distinct info is averaged away).
//    H_264 death = ASYMMETRIC absorption into a SPECIFIC target cell — the
//                  target is *selected* (random vs max-weight) and the dying
//                  cell's info is PRESERVED-TRANSFERRED (measured as info
//                  transfer rate), NOT averaged to oblivion. The asymmetry +
//                  target-selection are the load-bearing distinctions.
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model=8, initial_cells=8) — same machinery as
//    H_025 / H_054 / H_220 (mitosis_hook_lib.hexa). seed via
//    __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) for in-process repeatability.
//
//  SWEEP (2 target-selection x 3 pool size = 6 conditions)
//    target_mode in { random (first non-dying cell), max_weight (highest
//                     engine_a_W L1-norm cell) }
//    pool size   in { 4, 8, 16 }
//
//  ABSORPTION (per death event)
//    pick dying cell (last cell), pick absorber by target_mode, then
//        absorber_engine_a_W = (1-alpha)*absorber + alpha*dying   (alpha=0.25)
//        absorber_engine_g_W = (1-alpha)*absorber + alpha*dying
//        absorber_hidden     = (1-alpha)*absorber + alpha*dying
//    then dying cell is removed (farr_free) — count_delta = -1.
//
//  MEASURE per condition (target_mode, pool_size)
//    info_transfer  = mean over (a-weights) of
//                       |absorber_after - absorber_before| / (|dying - absorber_before| + eps)
//                     i.e. the fraction of the dying-vs-absorber gap that the
//                     absorber actually moved toward (= absorbed). For a pure
//                     blend this equals alpha analytically; we MEASURE it from
//                     the realized farr deltas so a broken primitive shows 0.
//                     ABSOLUTE transfer — mode-invariant by construction (the
//                     blend coefficient does not depend on which cell absorbs).
//    rel_preserve   = (alpha * L2(dying)) / (L2(absorber_after) + eps)
//                     = RELATIVE prominence of the dying cell's contribution
//                     within its new home (the absorber). THIS is the
//                     target-selection-sensitive metric: absorbing into a
//                     LARGE (max-weight) cell makes the SAME absolute
//                     contribution a SMALLER fraction of the host -> less
//                     relatively preserved. C2's pre-registered prediction
//                     ("max-weight preserves MORE") is tested against this
//                     honest metric and may be FALSIFIED.
//    absorber_dnorm = L2 norm change of the absorber's engine_a_W (absorber
//                     weight change magnitude).
//    dying_preserve = cosine(absorber_after - absorber_before, dying - absorber_before)
//                     = directional fidelity of the transfer (1.0 = dying
//                     cell's info direction perfectly preserved in the move).
//    phi_before / phi_after / phi_delta (pool Phi change across the death).
//
//  CRITERIA (pre-registered)
//    C1 info-transfer:    info_transfer > 0 in ALL 6 conditions (dying cell
//                         info is preserved-transferred, not annihilated).
//    C2 asymmetric:       target=max_weight rel_preserve >= target=random —
//                         selection matters AND max-weight preserves MORE.
//                         Tested on the RELATIVE-preservation metric (the only
//                         metric that is genuinely target-selection-sensitive).
//    C3 determinism:      cross-process re-run sha256(result.json metrics)
//                         byte-equal (child self-exec, NOT in-process).
//    verdict_rule:
//      SUPPORTED = C1 && C2 ; PARTIAL = C1 only ; FALSIFIED = !C1.
//
//  FALSIFIERS (>=5)
//    F1 INFO-TRANSFER : any info_transfer <= 0 -> C1 FALSIFIED.
//    F2 ASYMMETRY     : mean max_weight rel_preserve < mean random rel_preserve
//                       (max-weight does NOT preserve more) -> C2 FALSIFIED.
//    F3 DETERMINISM   : cross-process metric fingerprint differs -> raw#9.
//    F4 BOUNDS        : info_transfer / rel_preserve / dying_preserve not
//                       finite or out of [-1, 2] sanity band -> primitive error.
//    F5 COUNT         : death count_delta != -1 (B-MITOSIS-3) -> conservation
//                       breach.
//
//  $0 mac local · hexa-only · LLM none · NO ckpt.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "UNIVERSE/state/h264_death_merge_into_other_2026_05_25"
}
fn _d_model() -> int   { return 8 }
fn _seed() -> int      { return 42 }
fn _alpha() -> float   { return 0.25 }   // absorber dominates (1-alpha=0.75)
fn _eps() -> float     { return 1.0e-9 }


// ── scalar helpers ───────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _is_finite(x: float) -> bool {
    if x != x { return false }
    if x > 1.0e30 { return false }
    if x < -1.0e30 { return false }
    return true
}


// ── farr-level vector helpers ────────────────────────────────────────────────

fn _farr_l1_norm(h: int, n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + _abs(farr_get(h, i))
        i = i + 1
    }
    return s
}

fn _farr_l2_norm(h: int, n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let v = farr_get(h, i)
        s = s + v * v
        i = i + 1
    }
    return _mit_sqrt_safe(s)
}


// ── ASYMMETRIC absorb: absorber_W <- (1-alpha)*absorber_W + alpha*dying_W ────
// Snapshots absorber-before + dying into lists, applies the asymmetric blend
// in-place on the absorber farr, then returns realized metrics computed from
// the farr deltas (so a broken blend shows info_transfer 0).
//
// Returns dict:
//   { "transfer_ratio", "dnorm", "preserve_cos", "dying_norm", "after_norm" }
//   transfer_ratio = mean_i |after_i - before_i| / (|dying_i - before_i| + eps)
//   dnorm          = L2(after - before)
//   preserve_cos   = cosine(after - before, dying - before)
//   dying_norm     = L2(dying)
//   after_norm     = L2(absorber_after)
fn _absorb_weight(absorber_W: int, dying_W: int, n: int, alpha: float) {
    // snapshot before + dying
    let mut before = []
    let mut dying  = []
    let mut i = 0
    while i < n {
        before.push(farr_get(absorber_W, i))
        dying.push(farr_get(dying_W, i))
        i = i + 1
    }

    // apply asymmetric blend in-place
    let one_minus = 1.0 - alpha
    i = 0
    while i < n {
        let new_v = one_minus * before[i] + alpha * dying[i]
        let _ = farr_set(absorber_W, i, new_v)
        i = i + 1
    }

    // realized metrics from farr deltas
    let mut sum_ratio = 0.0
    let mut n_ratio   = 0
    let mut dsq       = 0.0
    // cosine accumulators: move = after-before, gap = dying-before
    let mut dot       = 0.0
    let mut nmove     = 0.0
    let mut ngap      = 0.0
    let mut dying_sq  = 0.0
    let mut after_sq  = 0.0
    i = 0
    while i < n {
        let after_i = farr_get(absorber_W, i)
        let move_i  = after_i - before[i]
        let gap_i   = dying[i] - before[i]
        // ratio (only where gap is meaningfully non-zero)
        if _abs(gap_i) > _eps() {
            sum_ratio = sum_ratio + (_abs(move_i) / (_abs(gap_i) + _eps()))
            n_ratio = n_ratio + 1
        }
        dsq      = dsq + move_i * move_i
        dot      = dot + move_i * gap_i
        nmove    = nmove + move_i * move_i
        ngap     = ngap + gap_i * gap_i
        dying_sq = dying_sq + dying[i] * dying[i]
        after_sq = after_sq + after_i * after_i
        i = i + 1
    }
    let transfer_ratio = if n_ratio > 0 { sum_ratio / to_float(n_ratio) } else { 0.0 }
    let dnorm = _mit_sqrt_safe(dsq)
    let nm = _mit_sqrt_safe(nmove)
    let ng = _mit_sqrt_safe(ngap)
    let preserve_cos = if (nm > _eps()) && (ng > _eps()) { dot / (nm * ng) } else { 0.0 }

    return #{
        "transfer_ratio": transfer_ratio,
        "dnorm":          dnorm,
        "preserve_cos":   preserve_cos,
        "dying_norm":     _mit_sqrt_safe(dying_sq),
        "after_norm":     _mit_sqrt_safe(after_sq)
    }
}


// ── pick absorber index given target_mode, excluding dying_idx ───────────────
// random      = first non-dying cell (index 0 if dying != 0, else 1).
// max_weight  = cell (!= dying) with max engine_a_W L1 norm.
fn _pick_absorber(pool, dying_idx: int, mode: string) -> int {
    let cs = pool["cells"]
    let n  = len(cs)
    let d  = pool["d_model"]
    let wn = d * d
    if mode == "random" {
        if dying_idx == 0 { return 1 }
        return 0
    }
    // max_weight
    let mut best_idx = -1
    let mut best_norm = -1.0
    let mut i = 0
    while i < n {
        if i != dying_idx {
            let nm = _farr_l1_norm(cs[i]["engine_a_W"], wn)
            if nm > best_norm {
                best_norm = nm
                best_idx = i
            }
        }
        i = i + 1
    }
    if best_idx < 0 { return if dying_idx == 0 { 1 } else { 0 } }
    return best_idx
}


// ── run one (target_mode, pool_size) condition ───────────────────────────────
//
// Protocol:
//   * init pool of pool_size cells, d_model.
//   * warm a few forward steps so cell weights differentiate (otherwise all
//     near-identical init -> degenerate gap).
//   * dying cell = last cell. absorber = _pick_absorber(mode).
//   * absorb engine_a_W, engine_g_W, hidden (hidden via list path).
//   * remove dying cell (farr_free + rebuild list) -> count_delta -1.
//   * measure info_transfer (mean of 3 weight transfer_ratios), dying_preserve
//     (mean of 3 preserve_cos), pool Phi before/after.
fn _run_condition(mode: string, pool_size: int) {
    let d  = _d_model()
    let wn = d * d
    let mut pool = cell_pool_init(d, pool_size)

    // warm steps to differentiate cells (deterministic w/ fixed seed in-proc).
    let mut x = []
    let mut z = 0
    while z < d { x.push(0.0) z = z + 1 }
    let mut step = 0
    while step < 4 {
        let res = mitosis_forward_tail(x, pool, step)
        pool = res[1]
        step = step + 1
    }

    let n_before = len(pool["cells"])
    let phi_before = compute_phi_proxy(pool["cells"])

    let dying_idx = n_before - 1
    let absorber_idx = _pick_absorber(pool, dying_idx, mode)

    let cs = pool["cells"]
    let dying = cs[dying_idx]
    let absorber = cs[absorber_idx]

    // absorb engine_a_W
    let ma = _absorb_weight(absorber["engine_a_W"], dying["engine_a_W"], wn, _alpha())
    // absorb engine_g_W
    let mg = _absorb_weight(absorber["engine_g_W"], dying["engine_g_W"], wn, _alpha())

    // absorb hidden (list path -> temp farrs)
    let h_abs = _mit_list_to_farr(absorber["hidden"])
    let h_dy  = _mit_list_to_farr(dying["hidden"])
    let mh = _absorb_weight(h_abs, h_dy, d, _alpha())
    // write blended hidden back to absorber
    let new_hidden = _mit_farr_to_list(h_abs, d)
    pool["cells"][absorber_idx]["hidden"] = new_hidden
    let _ = farr_free(h_abs)
    let _ = farr_free(h_dy)

    // realized info metrics (mean over the 3 weight tensors)
    let info_transfer = (ma["transfer_ratio"] + mg["transfer_ratio"] + mh["transfer_ratio"]) / 3.0
    let dying_preserve = (ma["preserve_cos"] + mg["preserve_cos"] + mh["preserve_cos"]) / 3.0
    let absorber_dnorm = ma["dnorm"]

    // RELATIVE preservation — prominence of the dying cell's contribution
    // within its new home. THIS metric is target-selection-sensitive: a
    // larger (max-weight) absorber dilutes the same absolute contribution.
    // Based on engine_a_W (primary weight tensor).
    let rel_preserve = (_alpha() * ma["dying_norm"]) / (ma["after_norm"] + _eps())

    // remove (kill) dying cell — farr_free its weights, rebuild list.
    let _ = farr_free(dying["engine_a_W"])
    let _ = farr_free(dying["engine_g_W"])
    let dying_id = dying["cell_id"]
    let mut new_cells = []
    let mut k = 0
    while k < len(pool["cells"]) {
        if pool["cells"][k]["cell_id"] != dying_id {
            new_cells.push(pool["cells"][k])
        }
        k = k + 1
    }
    pool["cells"] = new_cells

    let n_after = len(pool["cells"])
    let phi_after = compute_phi_proxy(pool["cells"])
    let count_delta = n_after - n_before

    return #{
        "mode":           mode,
        "pool_size":      pool_size,
        "n_before":       n_before,
        "n_after":        n_after,
        "count_delta":    count_delta,
        "absorber_idx":   absorber_idx,
        "dying_idx":      dying_idx,
        "info_transfer":  info_transfer,
        "rel_preserve":   rel_preserve,
        "dying_preserve": dying_preserve,
        "absorber_dnorm": absorber_dnorm,
        "phi_before":     phi_before,
        "phi_after":      phi_after,
        "phi_delta":      phi_after - phi_before
    }
}


// ── round numeric to 6 dp for cross-process fingerprint stability ────────────
fn _round6(x: float) -> float {
    let scaled = x * 1000000.0
    let r = floor(scaled + 0.5)
    return r / 1000000.0
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h264() {
    println("================================================================")
    println("H_264 death = merge-into-other (asymmetric absorption)")
    println("       death/genesis cross-link  H_025 (+) H_054")
    println("  d_model=" + to_string(_d_model())
            + " alpha=" + to_string(_alpha())
            + " seed=" + to_string(_seed()))
    println("  target modes: random  ·  max_weight")
    println("  pool sizes:   4, 8, 16")
    println("  DISTINCT FROM H_025: asymmetric absorb into SELECTED target")
    println("                       (info preserve-transfer), NOT 50/50 collapse")
    println("================================================================")

    // 2 target-selection x 3 pool size sweep — 6 conditions.
    let r_r4  = _run_condition("random",     4)
    let r_r8  = _run_condition("random",     8)
    let r_r16 = _run_condition("random",     16)
    let r_m4  = _run_condition("max_weight", 4)
    let r_m8  = _run_condition("max_weight", 8)
    let r_m16 = _run_condition("max_weight", 16)

    println("mode        N   info_transfer  rel_preserve  dying_preserve  abs_dnorm   phi_delta")
    println("----------  --  -------------  ------------  --------------  ---------  ---------")
    println("random       4   " + to_string(r_r4["info_transfer"])
            + "   " + to_string(r_r4["rel_preserve"])
            + "   " + to_string(r_r4["dying_preserve"])
            + "   " + to_string(r_r4["absorber_dnorm"])
            + "   " + to_string(r_r4["phi_delta"]))
    println("random       8   " + to_string(r_r8["info_transfer"])
            + "   " + to_string(r_r8["rel_preserve"])
            + "   " + to_string(r_r8["dying_preserve"])
            + "   " + to_string(r_r8["absorber_dnorm"])
            + "   " + to_string(r_r8["phi_delta"]))
    println("random      16   " + to_string(r_r16["info_transfer"])
            + "   " + to_string(r_r16["rel_preserve"])
            + "   " + to_string(r_r16["dying_preserve"])
            + "   " + to_string(r_r16["absorber_dnorm"])
            + "   " + to_string(r_r16["phi_delta"]))
    println("max_weight   4   " + to_string(r_m4["info_transfer"])
            + "   " + to_string(r_m4["rel_preserve"])
            + "   " + to_string(r_m4["dying_preserve"])
            + "   " + to_string(r_m4["absorber_dnorm"])
            + "   " + to_string(r_m4["phi_delta"]))
    println("max_weight   8   " + to_string(r_m8["info_transfer"])
            + "   " + to_string(r_m8["rel_preserve"])
            + "   " + to_string(r_m8["dying_preserve"])
            + "   " + to_string(r_m8["absorber_dnorm"])
            + "   " + to_string(r_m8["phi_delta"]))
    println("max_weight  16   " + to_string(r_m16["info_transfer"])
            + "   " + to_string(r_m16["rel_preserve"])
            + "   " + to_string(r_m16["dying_preserve"])
            + "   " + to_string(r_m16["absorber_dnorm"])
            + "   " + to_string(r_m16["phi_delta"]))

    // ── C1 info-transfer: all 6 info_transfer > 0 ──
    let it_r4  = r_r4["info_transfer"]
    let it_r8  = r_r8["info_transfer"]
    let it_r16 = r_r16["info_transfer"]
    let it_m4  = r_m4["info_transfer"]
    let it_m8  = r_m8["info_transfer"]
    let it_m16 = r_m16["info_transfer"]
    let c1 = (it_r4 > 0.0) && (it_r8 > 0.0) && (it_r16 > 0.0)
          && (it_m4 > 0.0) && (it_m8 > 0.0) && (it_m16 > 0.0)

    // ── C2 asymmetric: max_weight RELATIVE-preserves more than random.
    //    Tested on rel_preserve — the only genuinely target-selection-
    //    sensitive metric (info_transfer == alpha and dying_preserve == 1.0
    //    are blend-coefficient artifacts, mode-invariant by construction;
    //    they cannot test C2). Pre-registered prediction: max_weight >= random.
    //    Mean-over-pool-sizes comparison (robust). ──
    let rp_r4  = r_r4["rel_preserve"]
    let rp_r8  = r_r8["rel_preserve"]
    let rp_r16 = r_r16["rel_preserve"]
    let rp_m4  = r_m4["rel_preserve"]
    let rp_m8  = r_m8["rel_preserve"]
    let rp_m16 = r_m16["rel_preserve"]
    let mean_rp_r = (rp_r4 + rp_r8 + rp_r16) / 3.0
    let mean_rp_m = (rp_m4 + rp_m8 + rp_m16) / 3.0
    let c2 = mean_rp_m >= mean_rp_r

    // diagnostics kept for the .md write-up.
    let dp_r16 = r_r16["dying_preserve"]
    let dp_m16 = r_m16["dying_preserve"]
    let mean_it_r = (it_r4 + it_r8 + it_r16) / 3.0
    let mean_it_m = (it_m4 + it_m8 + it_m16) / 3.0
    let mean_dp_r = (r_r4["dying_preserve"] + r_r8["dying_preserve"] + dp_r16) / 3.0
    let mean_dp_m = (r_m4["dying_preserve"] + r_m8["dying_preserve"] + dp_m16) / 3.0

    // ── F4 BOUNDS: all info_transfer + dying_preserve finite & in sane band ──
    fn _band(x: float) -> bool {
        if !_is_finite(x) { return false }
        if x < -1.0 { return false }
        if x > 2.0 { return false }
        return true
    }
    let f4 = _band(it_r4) && _band(it_r8) && _band(it_r16)
          && _band(it_m4) && _band(it_m8) && _band(it_m16)
          && _band(rp_r4) && _band(rp_r8) && _band(rp_r16)
          && _band(rp_m4) && _band(rp_m8) && _band(rp_m16)
          && _band(r_r4["dying_preserve"]) && _band(r_r8["dying_preserve"])
          && _band(dp_r16) && _band(r_m4["dying_preserve"])
          && _band(r_m8["dying_preserve"]) && _band(dp_m16)

    // ── F5 COUNT: every death count_delta == -1 ──
    let f5 = (r_r4["count_delta"] == -1) && (r_r8["count_delta"] == -1)
          && (r_r16["count_delta"] == -1) && (r_m4["count_delta"] == -1)
          && (r_m8["count_delta"] == -1) && (r_m16["count_delta"] == -1)

    // F1 == C1 ; F2 == !c2 trigger ; F3 determinism handled by external re-run.
    let f1 = c1
    let f2 = c2

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    // verdict_rule
    let verdict = if c1 && c2 {
        "SUPPORTED"
    } else {
        if c1 { "PARTIAL" } else { "FALSIFIED" }
    }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    // C3 determinism is cross-process; in-process run cannot self-assert it.
    // Recorded as "EXTERNAL" in JSON; the .md verdict folds the cross-run sha.

    println("")
    println("derived:")
    println("  mean info_transfer  random=" + to_string(mean_it_r)
            + "  max_weight=" + to_string(mean_it_m) + "  (== alpha, mode-invariant)")
    println("  mean rel_preserve   random=" + to_string(mean_rp_r)
            + "  max_weight=" + to_string(mean_rp_m) + "  (C2 metric)")
    println("  mean dying_preserve random=" + to_string(mean_dp_r)
            + "  max_weight=" + to_string(mean_dp_m) + "  (cosine, == 1.0)")
    println("  alpha (expected transfer_ratio) = " + to_string(_alpha()))

    println("")
    println("C1 info-transfer (all 6 > 0)              : " + _bool_str(c1))
    println("C2 asymmetric (max_weight rel_preserve    : " + _bool_str(c2))
    println("   >= random; mean " + to_string(mean_rp_m)
            + " vs " + to_string(mean_rp_r) + ")")
    println("C3 determinism (cross-process)            : EXTERNAL (see .md)")
    println("")
    println("F1 INFO-TRANSFER (all transfer > 0)       " + v1)
    println("F2 ASYMMETRY     (max_w rel_pres>=random) " + v2)
    println("F3 DETERMINISM   (cross-process sha256)   EXTERNAL")
    println("F4 BOUNDS        (metrics in [-1,2])      " + v4)
    println("F5 COUNT         (death delta == -1)      " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/2 in-process criteria; C3 external)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    fn _cond_json(r) -> string {
        return "{ \"mode\": \"" + r["mode"] + "\""
             + ", \"pool_size\": " + to_string(r["pool_size"])
             + ", \"n_before\": " + to_string(r["n_before"])
             + ", \"n_after\": " + to_string(r["n_after"])
             + ", \"count_delta\": " + to_string(r["count_delta"])
             + ", \"absorber_idx\": " + to_string(r["absorber_idx"])
             + ", \"dying_idx\": " + to_string(r["dying_idx"])
             + ", \"info_transfer\": " + to_string(_round6(r["info_transfer"]))
             + ", \"rel_preserve\": " + to_string(_round6(r["rel_preserve"]))
             + ", \"dying_preserve\": " + to_string(_round6(r["dying_preserve"]))
             + ", \"absorber_dnorm\": " + to_string(_round6(r["absorber_dnorm"]))
             + ", \"phi_before\": " + to_string(_round6(r["phi_before"]))
             + ", \"phi_after\": " + to_string(_round6(r["phi_after"]))
             + ", \"phi_delta\": " + to_string(_round6(r["phi_delta"])) + " }"
    }

    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_264\",\n"
    j = j + "  \"slug\": \"death-merge-into-other\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"death = merge-into-other — asymmetric absorption-integration (H_025 (+) H_054 cross-link)\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"alpha\": " + to_string(_alpha())
          + ", \"warm_steps\": 4},\n"
    j = j + "  \"distinct_from_H_025\": \"H_025 = symmetric 50/50 merge toward floor (self-annihilation, dying info averaged away); H_264 = asymmetric absorb into a SELECTED target (info preserve-transfer, target-selection load-bearing)\",\n"
    j = j + "  \"sweep\": {\n"
    j = j + "    \"random_4\":      " + _cond_json(r_r4)  + ",\n"
    j = j + "    \"random_8\":      " + _cond_json(r_r8)  + ",\n"
    j = j + "    \"random_16\":     " + _cond_json(r_r16) + ",\n"
    j = j + "    \"max_weight_4\":  " + _cond_json(r_m4)  + ",\n"
    j = j + "    \"max_weight_8\":  " + _cond_json(r_m8)  + ",\n"
    j = j + "    \"max_weight_16\": " + _cond_json(r_m16) + "\n"
    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"mean_info_transfer_random\":     " + to_string(_round6(mean_it_r)) + ",\n"
    j = j + "    \"mean_info_transfer_max_weight\": " + to_string(_round6(mean_it_m)) + ",\n"
    j = j + "    \"mean_rel_preserve_random\":      " + to_string(_round6(mean_rp_r)) + ",\n"
    j = j + "    \"mean_rel_preserve_max_weight\":  " + to_string(_round6(mean_rp_m)) + ",\n"
    j = j + "    \"mean_dying_preserve_random\":     " + to_string(_round6(mean_dp_r)) + ",\n"
    j = j + "    \"mean_dying_preserve_max_weight\": " + to_string(_round6(mean_dp_m)) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_info_transfer\":  " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_asymmetric\":     " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_determinism\":    \"EXTERNAL\"\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_INFO_TRANSFER\": { \"metric\": \"all info_transfer > 0\", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_ASYMMETRY\":     { \"metric\": \"mean max_weight rel_preserve >= mean random rel_preserve\", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_DETERMINISM\":   { \"metric\": \"cross-process sha256 byte-equal\", \"verdict\": \"EXTERNAL\" },\n"
    j = j + "    \"F4_BOUNDS\":        { \"metric\": \"metrics finite in [-1,2]\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_COUNT\":         { \"metric\": \"death count_delta == -1\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass_in_process\": " + to_string(n_c) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_025\": \"death=symmetric merge to floor\", \"H_054\": \"merge=endosymbiosis\", \"H_203\": \"asymmetric-merge differentiation\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h264()
