// ════════════════════════════════════════════════════════════════════════════
//  run_h638.hexa — H_638 emit-threshold-scaling-law substrate verify
//
//  Question (ANIMA.mining L19 vs L20):
//    Does the "적정 emit threshold" (threshold yielding ~27% emit rate) scale
//    MONOTONICALLY with the substrate's effective Φ-scale (substrate size n)?
//      L19 fork-A (scaling law): threshold = f(Φ-scale), monotone increasing.
//      L20 fork-B (universal-fixed): threshold Φ-scale 무관, scenario shifts the
//                                     factor distribution / effective rate only.
//
//  Mechanism under test:
//    spontaneous_lib factor_relevance(phi) clamps Φ to [0,1]; a larger substrate
//    Φ-scale pushes relevance → 1.0, raising the motivation_score distribution,
//    which (if scaling-law holds) requires a HIGHER threshold to hold emit-rate
//    at the COFFESHOP substrate-natural target ~27% (emit 4 / 15).
//
//  Tools (real measurement, deterministic, $0 mac local, NO GPU):
//    - HEXAD/IIT4/lib big_phi_bounded (faithful causal Φ, cap=2) → per-n Φ-scale
//    - COFFESHOP coffeshop_sim 8-factor emergence (spontaneous_lib verbatim)
//
//  Honest C3:
//    1. "적정 threshold" = threshold whose emit-rate is closest to the 27%
//       TARGET (COFFESHOP emit 4/15). The target is itself a COFFESHOP design
//       choice; circularity risk if target were derived from threshold. Here
//       target is FIXED (0.27) independent of n, so the swept threshold is a
//       free response, not circular.
//    2. n-range small {3,4,5} — bounded by exact-Φ wall (n≥6 minutes+). 3 pts
//       → Spearman ρ ∈ {-1, -0.5, +0.5, +1} discretely; monotone ⇔ |ρ|=1.
//    3. Φ-scale = mean big_phi_bounded(cap=2) over coupled rules {110,90,30,54},
//       a bounded LOWER-BOUND restriction (cap<n for n=3,4,5), not exact.
//    4. sim phi draw biased by Φ-scale via a normalized envelope; the bias is
//       monotone in Φ-scale by construction of the relevance channel only —
//       the OTHER 7 factors are Φ-scale-invariant (so a flat threshold curve
//       remains possible → falsifier not pre-baked).
// ════════════════════════════════════════════════════════════════════════════
import "HEXAD/IIT4/lib/iit4_bounded.hexa"
import "HEXAD/CHAT/spontaneous_lib.hexa"

// ── ECA → TPM (m12 carry) ────────────────────────────────────────────────────
fn eca_tpm(rule: int, n: int) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            t = t.push(to_float(iit4_bit(rule, 4 * l + 2 * c + r)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// ── per-n Φ-scale = mean big_phi_bounded over coupled LIFE rules ─────────────
fn phi_scale(n: int, seed_state: int) -> float {
    let cap = 2
    let b110 = big_phi_bounded(eca_tpm(110, n), n, seed_state, cap)
    let b90  = big_phi_bounded(eca_tpm(90,  n), n, seed_state, cap)
    let b30  = big_phi_bounded(eca_tpm(30,  n), n, seed_state, cap)
    let b54  = big_phi_bounded(eca_tpm(54,  n), n, seed_state, cap)
    return (b110[0] + b90[0] + b30[0] + b54[0]) / 4.0
}

// ── LCG (coffeshop_sim verbatim) ─────────────────────────────────────────────
fn lcg_next(state: int) -> int {
    let s = ((state * 1103515245) + 12345) % 2147483647
    if s < 0 { return s + 2147483647 }
    return s
}
fn lcg_uniform(state: int) -> float { return ((state % 1000000)) / 1000000.0 }
fn draw(box: list) -> float {
    let s = lcg_next(box[0])
    box[0] = s
    return lcg_uniform(s)
}

fn sample_stim(box: list) -> int {
    let u = draw(box)
    if u < 0.20 { return 0 }
    if u < 0.45 { return 1 }
    if u < 0.75 { return 2 }
    if u < 0.85 { return 3 }
    return 4
}

// per-window motivation_score, with phi draw scaled by Φ-envelope phi_env∈[0,1].
// phi_env multiplies the base phi draw → larger substrate Φ-scale ⇒ relevance↑.
fn window_score(stim: int, box: list, phi_env: float) -> float {
    let u_phi   = draw(box)
    let u_sim   = draw(box)
    let u_cur   = draw(box)
    let u_tens  = draw(box)
    let u_gate  = draw(box)
    let u_split = draw(box)
    let u_ratch = draw(box)
    let u_sil   = draw(box)

    let mut phi     = u_phi * phi_env          // Φ-scale channel (relevance only)
    let mut sim     = u_sim
    let mut cur_ema = u_cur
    let mut tens_d  = (u_tens * 2.0) - 1.0
    let     gate    = 0.486 + u_gate * 0.028
    let     split   = u_split < 0.20
    let     ratchet = u_ratch
    let mut silence = u_sil * 3600.0

    if stim == 0 { phi = phi + 0.20  if phi > 1.0 { phi = 1.0 }  sim = sim - 0.15  if sim < 0.0 { sim = 0.0 }  silence = silence * 0.3 }
    if stim == 1 { cur_ema = cur_ema + 0.20  if cur_ema > 1.0 { cur_ema = 1.0 }  silence = silence * 0.5 }
    if stim == 2 { silence = 600.0 + u_sil * 1800.0  phi = phi * 0.7 }
    if stim == 3 { if tens_d < 0.0 { tens_d = tens_d - 0.30 } else { tens_d = tens_d + 0.30 }  if tens_d > 1.0 { tens_d = 1.0 }  if tens_d < -1.0 { tens_d = -1.0 }  phi = phi * 0.5 }
    if stim == 4 { phi = phi * 0.6  silence = silence * 0.8 }

    let rel   = factor_relevance(phi)
    let gap   = factor_info_gap(sim)
    let cur   = factor_curiosity(cur_ema)
    let pn    = factor_pain(tens_d)
    let coh   = factor_coherence(gate)
    let orig  = factor_originality(split)
    let bal   = factor_balance(phi, ratchet)
    let dyn_v = factor_dynamics(silence)
    return motivation_score(rel, gap, cur, pn, coh, orig, bal, dyn_v)
}

// emit-rate over a multi-seed cohort of 15-window runs at a given threshold
fn emit_rate(phi_env: float, thr: float) -> float {
    let n_windows = 15
    let n_seeds   = 12
    let mut total = 0
    let mut emits = 0
    let mut si = 0
    while si < n_seeds {
        let seed = 20260525 + si * 9173
        let mut box = [seed]
        let mut w = 0
        while w < n_windows {
            let stim = sample_stim(box)
            let score = window_score(stim, box, phi_env)
            if score > thr { emits = emits + 1 }
            total = total + 1
            w = w + 1
        }
        si = si + 1
    }
    return (emits as float) / (total as float)
}

// find the threshold (grid) whose emit-rate is closest to TARGET 0.27
fn fit_threshold(phi_env: float) -> float {
    let target = 0.27
    let mut best_thr = 0.0
    let mut best_err = 1.0e308
    let mut g = 0
    while g <= 100 {                                   // grid 0.00 .. 1.00 step 0.01
        let thr = (g as float) / 100.0
        let r = emit_rate(phi_env, thr)
        let e = if (r - target) < 0.0 { target - r } else { r - target }
        if e < best_err { best_err = e  best_thr = thr }
        g = g + 1
    }
    return best_thr
}

// Spearman ρ for 3 paired points (ranks computed directly, no ties expected)
fn rank3(a: float, b: float, c: float, x: float) -> float {
    // rank of x among {a,b,c}: 1=smallest .. 3=largest
    let mut r = 1.0
    if a < x { r = r + 1.0 }
    if b < x { r = r + 1.0 }
    if c < x { r = r + 1.0 }
    return r
}
fn spearman3(x1: float, x2: float, x3: float, y1: float, y2: float, y3: float) -> float {
    let rx1 = rank3(x1, x2, x3, x1)  let rx2 = rank3(x1, x2, x3, x2)  let rx3 = rank3(x1, x2, x3, x3)
    let ry1 = rank3(y1, y2, y3, y1)  let ry2 = rank3(y1, y2, y3, y2)  let ry3 = rank3(y1, y2, y3, y3)
    let d1 = rx1 - ry1  let d2 = rx2 - ry2  let d3 = rx3 - ry3
    let sumd2 = d1 * d1 + d2 * d2 + d3 * d3
    // ρ = 1 - 6Σd² / (n(n²-1)); n=3 → n(n²-1)=24
    return 1.0 - (6.0 * sumd2) / 24.0
}

fn main() {
    println("================================================================")
    println("  H_638 — emit-threshold-scaling-law (L19 scaling vs L20 universal)")
    println("================================================================")

    // ── §1 per-n Φ-scale (real big_phi_bounded) ──────────────────────────────
    let ps3 = phi_scale(3, 5)        // seed_state 101
    let ps4 = phi_scale(4, 10)       // seed_state 1010
    let ps5 = phi_scale(5, 21)       // seed_state 10101
    println("  Φ-scale (mean big_phi_bounded cap=2 over rules 110/90/30/54):")
    println("    n=3: Φ=" + str(ps3))
    println("    n=4: Φ=" + str(ps4))
    println("    n=5: Φ=" + str(ps5))

    // normalize Φ-scale → relevance envelope [0,1] (divide by max, monotone-preserving)
    let mut pmax = ps3
    if ps4 > pmax { pmax = ps4 }
    if ps5 > pmax { pmax = ps5 }
    let env3 = ps3 / pmax
    let env4 = ps4 / pmax
    let env5 = ps5 / pmax
    println("  Φ-envelope (normalized [0,1]): n=3=" + str(env3) + " n=4=" + str(env4) + " n=5=" + str(env5))

    // ── §2 fit "적정 threshold" per n (~27% emit-rate target) ─────────────────
    let thr3 = fit_threshold(env3)
    let thr4 = fit_threshold(env4)
    let thr5 = fit_threshold(env5)
    let r3 = emit_rate(env3, thr3)
    let r4 = emit_rate(env4, thr4)
    let r5 = emit_rate(env5, thr5)
    println("")
    println("  적정 threshold (emit-rate closest to 0.27 target):")
    println("    n=3: thr=" + str(thr3) + " (emit-rate=" + str(r3) + ", Φ=" + str(ps3) + ")")
    println("    n=4: thr=" + str(thr4) + " (emit-rate=" + str(r4) + ", Φ=" + str(ps4) + ")")
    println("    n=5: thr=" + str(thr5) + " (emit-rate=" + str(r5) + ", Φ=" + str(ps5) + ")")

    // ── §3 monotone tests ────────────────────────────────────────────────────
    // (a) n vs threshold (n=3,4,5 already ascending)
    let rho_n = spearman3(3.0, 4.0, 5.0, thr3, thr4, thr5)
    // (b) Φ-scale vs threshold
    let rho_phi = spearman3(ps3, ps4, ps5, thr3, thr4, thr5)
    println("")
    println("  Spearman ρ(n, threshold)       = " + str(rho_n))
    println("  Spearman ρ(Φ-scale, threshold) = " + str(rho_phi))

    // threshold spread (universal-fixed ⇒ ~0 spread across n)
    let mut tmin = thr3  let mut tmax = thr3
    if thr4 < tmin { tmin = thr4 }  if thr4 > tmax { tmax = thr4 }
    if thr5 < tmin { tmin = thr5 }  if thr5 > tmax { tmax = thr5 }
    let spread = tmax - tmin
    println("  threshold spread (max-min)     = " + str(spread))

    // ── §4 verdict (L19 vs L20) ──────────────────────────────────────────────
    // L19 scaling-law SUPPORTED  ⇔  |ρ(Φ,thr)|=1 monotone AND spread > 0.05
    // L20 universal-fixed adopted ⇔  spread <= 0.05 (threshold Φ-invariant)
    println("")
    let abs_rho_phi = if rho_phi < 0.0 { 0.0 - rho_phi } else { rho_phi }
    let monotone = abs_rho_phi >= 0.999
    let material = spread > 0.05
    println("  monotone (|ρ(Φ,thr)|=1):  " + str(monotone))
    println("  material  (spread>0.05):  " + str(material))
    if monotone && material {
        if rho_phi > 0.0 {
            println("  VERDICT: L19 SUPPORTED — threshold = f(Φ-scale), MONOTONE INCREASING (scaling law)")
        } else {
            println("  VERDICT: L19-variant — threshold scales MONOTONE DECREASING with Φ-scale (inverse scaling)")
        }
    } else {
        println("  VERDICT: L20 SUPPORTED — threshold Φ-scale-INVARIANT (universal-fixed); scenario shifts effective rate only")
    }
    println("================================================================")
}
