// UNIVERSE/state/h326_d2_verdict_landscape_session_raster_2026_05_27/run.hexa
// ════════════════════════════════════════════════════════════════════════════
// H_326 — D2 axis · verdict-landscape SESSION RASTER (structural vs dynamical,
//          life vs consciousness SUPP-rates) over the 11 just-merged real cells
//          H_312..H_321.
//
//   HYPOTHESIS H1 (primary — structural vs dynamical)
//     DYNAMICAL-category SUPP-rate ≥ 2× STRUCTURAL-category SUPP-rate.
//     SUPP-rate(c) = supp(c) / (supp(c) + fal(c))
//   FALSIFIER F326.1
//     dyn_rate / struct_rate < 2.0  OR  dyn_rate ≤ struct_rate  ⇒ H1 FALSIFIED.
//
//   HYPOTHESIS H2 (secondary — theme orthogonality)
//     LIFE / CONSCIOUSNESS rate ratio ≤ 1.5×  (axis is WEAK / orthogonal to D/S).
//   FALSIFIER F326.2
//     max(life_rate, consc_rate) / min(...) > 1.5  ⇒ H2 FALSIFIED.
//
//   DETERMINISM
//     No RNG. Inputs = the frozen classification table (per-doc method, frozen
//     BEFORE the result.json verdicts) + the verdicts EXTRACTED from each
//     result.json (cross-checked against commit messages on origin/main).
//
//   ANTI-TAUTOLOGY (commons @D g73)
//     Category (STRUCTURAL / DYNAMICAL / HYBRID / META) is determined by the
//     KERNEL methodology of each cell's run.hexa — written BEFORE the verdict
//     was known. The H_318 doc contains the SSOT self-classification table for
//     H_312..H_317 ("Structural vs Dynamical 위치"). H_318/H_319 self-tag as
//     HYBRID. H_320/H_321 = STRUCTURAL (Φ-arithmetic on fixed substrate; no
//     timestep loop). Theme is determined by per-doc `domain:` frontmatter.
//
//   COUNTS  (extracted verbatim from origin/main result.json — see verify §)
//     H_312 🔴  STRUCTURAL  LIFE+CONSC      (apoptosis low-Φ pruning)
//     H_313 🟢  DYNAMICAL   LIFE            (STDP timestep integrate-and-fire)
//     H_314 🔴  STRUCTURAL  LIFE            (symbiogenesis merge α-sweep)
//     H_315 🔴  STRUCTURAL  LIFE+CONSC      (weak-edge pruning Φ-retention)
//     H_316 🟢  META        CONSC           (local-greedy ⊥ global Φ synthesis)
//     H_317 🟢  DYNAMICAL   LIFE            (homeostasis negative-feedback loop)
//     H_318 🟢  HYBRID      LIFE            (autophagy: struct rule × dyn trigger)
//     H_319 🔴  HYBRID      LIFE            (clonal: struct rule × dyn signal)
//     H_320 🔴  STRUCTURAL  META            (LIFE-vs-CONSC Φ-ratio comparator)
//     H_321 🟢  STRUCTURAL  CONSC           (faithful Φ recheck on fixed panel)
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check_f326(name: string, cond: bool) {
    if cond {
        PASS = PASS + 1
        println("  [PASS] " + name)
    } else {
        FAIL = FAIL + 1
        println("  [FAIL] " + name)
    }
}

// ── tally helpers ───────────────────────────────────────────────────────────
fn ratio(a: float, b: float) -> float {
    // a / b with the b=0 guard (returns 0.0 if denominator is zero)
    if b == 0.0 { return 0.0 }
    return a / b
}

fn supp_rate(supp: int, fal: int) -> float {
    // supp / (supp + fal); undefined-as-0 sentinel
    let denom = supp + fal
    if denom == 0 { return 0.0 }
    return (supp + 0.0) / (denom + 0.0)
}

// ── primary tally (frozen classification — H_318 doc SSOT for H_312..H_317;
//                  HYBRID/META extension for H_318..H_321 documented in §3.2) ─
//
// STRUCTURAL: H_312🔴 H_314🔴 H_315🔴 H_320🔴 H_321🟢   → supp=1 fal=4
// DYNAMICAL : H_313🟢 H_317🟢                            → supp=2 fal=0
// HYBRID    : H_318🟢 H_319🔴                            → supp=1 fal=1
// META      : H_316🟢                                    → supp=1 fal=0

let struct_supp = 1
let struct_fal  = 4
let dyn_supp    = 2
let dyn_fal     = 0
let hybrid_supp = 1
let hybrid_fal  = 1
let meta_supp   = 1
let meta_fal    = 0

let total_cells = struct_supp + struct_fal + dyn_supp + dyn_fal + hybrid_supp + hybrid_fal + meta_supp + meta_fal

// ── theme tally ─────────────────────────────────────────────────────────────
// inclusive count (LIFE+CONSC duplicate-counts to both buckets) — H_316=CONSC,
// H_320=META (excluded from both LIFE/CONSC primary). H_321=CONSC.
//
// LIFE rows: H_312🔴 H_313🟢 H_314🔴 H_315🔴 H_317🟢 H_318🟢 H_319🔴
//            → supp=3 fal=4
// CONSC rows: H_312🔴 H_315🔴 H_316🟢 H_321🟢
//            → supp=2 fal=2
let life_supp_incl  = 3
let life_fal_incl   = 4
let consc_supp_incl = 2
let consc_fal_incl  = 2

// exclusive count (LIFE-only and CONSC-only; LIFE+CONSC double-coded rows excluded)
// LIFE-only: H_313🟢 H_314🔴 H_317🟢 H_318🟢 H_319🔴 → supp=3 fal=2
// CONSC-only: H_316🟢 H_321🟢                         → supp=2 fal=0
let life_supp_excl  = 3
let life_fal_excl   = 2
let consc_supp_excl = 2
let consc_fal_excl  = 0

// ── ratios ──────────────────────────────────────────────────────────────────
let struct_rate    = supp_rate(struct_supp, struct_fal)
let dyn_rate       = supp_rate(dyn_supp,    dyn_fal)
let hybrid_rate    = supp_rate(hybrid_supp, hybrid_fal)
let meta_rate      = supp_rate(meta_supp,   meta_fal)
let dyn_over_struct = ratio(dyn_rate, struct_rate)

let life_rate_incl  = supp_rate(life_supp_incl,  life_fal_incl)
let consc_rate_incl = supp_rate(consc_supp_incl, consc_fal_incl)
let life_rate_excl  = supp_rate(life_supp_excl,  life_fal_excl)
let consc_rate_excl = supp_rate(consc_supp_excl, consc_fal_excl)

// theme spread = max/min (avoid div-by-zero with sentinel; if min=0 use ∞-proxy 9999)
fn theme_spread(a: float, b: float) -> float {
    if a == 0.0 && b == 0.0 { return 1.0 }
    if a == 0.0 || b == 0.0 { return 9999.0 }
    if a >= b { return a / b } else { return b / a }
}
let theme_spread_incl = theme_spread(life_rate_incl, consc_rate_incl)
let theme_spread_excl = theme_spread(life_rate_excl, consc_rate_excl)

// ── falsifier verdicts ──────────────────────────────────────────────────────
// F326.1 PASS  if  dyn_rate ≥ 2 × struct_rate   (primary H1)
// F326.2 PASS  if  theme_spread_excl ≤ 1.5      (primary H2 — exclusive count;
//                                                inclusive variant secondary)
let f1_pass = dyn_rate >= 2.0 * struct_rate && dyn_rate > struct_rate
let f2_pass_excl  = theme_spread_excl <= 1.5
let f2_pass_incl  = theme_spread_incl <= 1.5

// F326.3 sanity
let f3_pass = total_cells == 10
// (NOTE: 10 atomic rows above; H_316 was already counted under META, so the
//  STRUCTURAL+DYNAMICAL+HYBRID+META row-set sums to 10 — the 11th cell of the
//  "11 just-merged" set is H_322 if a later session adds; THIS raster covers
//  H_312..H_321 = exactly 10 cells. The task brief said "11 cells" but the
//  enumeration H_312..H_321 contains 10 (H_316 included once in META, not also
//  STRUCTURAL — H_318 doc's table re-classifies it. See honest L1.)

println("════════════════════════════════════════════════════════════════")
println("H_326 — D2 axis · verdict-landscape session raster")
println("════════════════════════════════════════════════════════════════")
println("")
println("INPUT cells (10 — H_312..H_321, deduplicated per-doc category):")
println("  H_312 🔴 STRUCTURAL  LIFE+CONSC   apoptosis low-Φ pruning")
println("  H_313 🟢 DYNAMICAL   LIFE         STDP timestep integrate-and-fire")
println("  H_314 🔴 STRUCTURAL  LIFE         symbiogenesis merge α-sweep")
println("  H_315 🔴 STRUCTURAL  LIFE+CONSC   weak-edge pruning Φ-retention")
println("  H_316 🟢 META        CONSC        local-greedy ⊥ global Φ synthesis")
println("  H_317 🟢 DYNAMICAL   LIFE         homeostasis feedback setpoint")
println("  H_318 🟢 HYBRID      LIFE         autophagy recycle (struct × dyn)")
println("  H_319 🔴 HYBRID      LIFE         clonal-selection (struct × dyn)")
println("  H_320 🔴 STRUCTURAL  META         LIFE-vs-CONSC Φ-ratio comparator")
println("  H_321 🟢 STRUCTURAL  CONSC        faithful Φ recheck on fixed panel")
println("")
println("─── CATEGORY tally ─────────────────────────────────────────────")
println("  STRUCTURAL  supp=" + str(struct_supp) + "  fal=" + str(struct_fal)  + "  rate=" + str(struct_rate))
println("  DYNAMICAL   supp=" + str(dyn_supp)    + "  fal=" + str(dyn_fal)     + "  rate=" + str(dyn_rate))
println("  HYBRID      supp=" + str(hybrid_supp) + "  fal=" + str(hybrid_fal)  + "  rate=" + str(hybrid_rate))
println("  META        supp=" + str(meta_supp)   + "  fal=" + str(meta_fal)    + "  rate=" + str(meta_rate))
println("")
println("  H1 ratio  dyn_rate / struct_rate = " + str(dyn_over_struct))
println("")
println("─── THEME tally (inclusive — LIFE+CONSC double-coded both buckets) ──")
println("  LIFE   supp=" + str(life_supp_incl)  + "  fal=" + str(life_fal_incl)  + "  rate=" + str(life_rate_incl))
println("  CONSC  supp=" + str(consc_supp_incl) + "  fal=" + str(consc_fal_incl) + "  rate=" + str(consc_rate_incl))
println("  H2 spread (max/min) = " + str(theme_spread_incl))
println("")
println("─── THEME tally (exclusive — LIFE-only & CONSC-only) ────────────────")
println("  LIFE   supp=" + str(life_supp_excl)  + "  fal=" + str(life_fal_excl)  + "  rate=" + str(life_rate_excl))
println("  CONSC  supp=" + str(consc_supp_excl) + "  fal=" + str(consc_fal_excl) + "  rate=" + str(consc_rate_excl))
println("  H2 spread (max/min) = " + str(theme_spread_excl))
println("")
println("─── FALSIFIER VERDICTS ─────────────────────────────────────────")
check_f326("F326.1 H1 PASS (dyn_rate >= 2× struct_rate AND dyn_rate > struct_rate)", f1_pass)
check_f326("F326.2 H2 PASS (exclusive — theme spread <= 1.5×)", f2_pass_excl)
check_f326("F326.2 H2 PASS (inclusive — theme spread <= 1.5×)", f2_pass_incl)
check_f326("F326.3 sanity (10 atomic rows in raster)", f3_pass)
println("")
println("───────────────────────────────────────────────────────────────")
println("TALLY: PASS=" + str(PASS) + "  FAIL=" + str(FAIL))

// ── aggregate verdict derivation ────────────────────────────────────────────
//   primary H1 = F326.1 (dyn ≥ 2× struct)
//   secondary H2 = F326.2 (theme spread ≤ 1.5×) — exclusive variant primary
//   overall raster verdict logic:
//     - H1 PASS  +  H2 PASS  ⇒ 🟢 SUPPORTED-NUMERICAL (dynamical bias confirmed
//                              + life/consc axis WEAK = D2 axis is the lever)
//     - H1 PASS  +  H2 FAIL  ⇒ 🟢 PARTIAL-SUPPORTED (dynamical bias confirmed
//                              BUT life/consc axis is also strong)
//     - H1 FAIL  +  H2 PASS  ⇒ 🔴 PARTIAL-FALSIFIED (no D/S signal; life/consc
//                              axis IS weak — so neither axis is the lever)
//     - H1 FAIL  +  H2 FAIL  ⇒ 🔴 FALSIFIED (D/S not the signal AND life/consc
//                              is — H2 wrong direction)

let mut verdict = ""
if f1_pass && f2_pass_excl {
    verdict = "🟢 SUPPORTED-NUMERICAL (H1 + H2 both PASS — D2 axis is the lever)"
} else if f1_pass && !f2_pass_excl {
    verdict = "🟢 PARTIAL-SUPPORTED (H1 PASS, H2 FAIL — D/S bias confirmed, but L/C also matters)"
} else if !f1_pass && f2_pass_excl {
    verdict = "🔴 PARTIAL-FALSIFIED (H1 FAIL — no D/S signal; H2 PASS — L/C axis weak)"
} else {
    verdict = "🔴 FALSIFIED (H1 FAIL AND H2 FAIL — D/S not signal, L/C also signal)"
}
println("")
println("AGGREGATE VERDICT: " + verdict)
println("════════════════════════════════════════════════════════════════")
