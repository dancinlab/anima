// ════════════════════════════════════════════════════════════════════════════
//  run_h646.hexa — H_646 convention-number-freedom-range substrate verify
//
//  Meta-finding under test (generalizes H_638 PR #1224 🟢 universal-fixed):
//    An emit design-number (threshold) is a FREE parameter living ON TOP of a
//    substrate-invariant shape. H_638 showed the "적정" threshold is universal-
//    fixed for a 27% target. H_646 quantifies the FREEDOM RANGE of that number:
//    sweep the emit threshold across a WIDE range {0.1 .. 0.9} against a FIXED
//    substrate and ask whether the substrate's big-Φ itself moves.
//
//    H1 (free-parameter): substrate big-Φ is INVARIANT under the threshold
//        sweep — Φ(threshold) variance ≈ 0. The threshold's degree of freedom is
//        the entire [0,1] (substrate-unconstrained). The threshold is a
//        DOWNSTREAM emit-decision policy, not a substrate quantity.
//    Falsifier: threshold materially moves substrate big-Φ (Φ variance > 0.1)
//        → the number is substrate-constrained, NOT a free convention.
//
//  Why this is the right measurement (mechanism):
//    big-Φ is computed from the substrate TPM + system state (IIT 4.0 cause-
//    effect structure). The emit threshold enters ONLY at the comparison
//    `motivation_score > thr` — strictly AFTER any substrate computation. So the
//    threshold is, by the pipeline's data-flow, post-processing: it cannot feed
//    back into the TPM. We MEASURE this decoupling rather than assert it:
//      (a) Φ(thr) sweep over {0.1..0.9} on a FIXED set of substrates → variance.
//      (b) emit-rate(thr) on the SAME substrates → should fall monotonically
//          (the policy DOES respond), confirming the sweep is non-degenerate
//          (threshold actually does something downstream) while Φ stays flat.
//    The contrast emit-rate-moves ∧ Φ-flat is the operational content of
//    "number = free convention on a substrate-invariant shape."
//
//  Tools (real measurement, deterministic, $0 mac local, NO GPU):
//    - HEXAD/IIT4/lib big_phi_bounded (faithful causal Φ, cap=2)
//    - COFFESHOP coffeshop_sim 8-factor emergence (spontaneous_lib verbatim)
//    - structure + LCG + stim-sampling reused verbatim from run_h638.hexa (g61)
//
//  Honest C3 (§7 of the H file):
//    trivial vs nontrivial decoupling. Φ⊥threshold is TRUE-BY-PIPELINE (thr is
//    not an argument of big_phi_bounded), so the ZERO-variance result is in part
//    DEFINITIONAL. The NONTRIVIAL content is: (i) the freedom range is the FULL
//    [0,1] and not merely a neighborhood — emit-rate stays well-defined and
//    monotone across the entire sweep, so no substrate effect re-enters via a
//    degenerate (all-emit / no-emit) regime; (ii) it CONFIRMS the design choice
//    (single emit primitive + factor-distribution shift, a_autonomy_over_
//    hardcode) is substrate-safe across the whole range, not just near 0.6.
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_bounded.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/spontaneous_lib.hexa"

// ── ECA → TPM (m12 carry, verbatim from run_h638) ────────────────────────────
fn eca_tpm(rule: int, n: int) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let l = iit4_bit(s, (i - 1 + n) % n)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, (i + 1) % n)
            t = t.push(to_float(iit4_bit(rule, 4 * l + 2 * c + r)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// per-n big-Φ = mean big_phi_bounded over coupled LIFE rules {110,90,30,54}.
// This is the SUBSTRATE QUANTITY. The emit threshold is NOT an argument here —
// it never enters big_phi_bounded. (This is what makes the decoupling testable
// AND partly definitional — see §7 C3.)
fn substrate_phi(n: int, seed_state: int) -> float {
    let cap = 2
    let b110 = big_phi_bounded(eca_tpm(110, n), n, seed_state, cap)
    let b90  = big_phi_bounded(eca_tpm(90,  n), n, seed_state, cap)
    let b30  = big_phi_bounded(eca_tpm(30,  n), n, seed_state, cap)
    let b54  = big_phi_bounded(eca_tpm(54,  n), n, seed_state, cap)
    return (b110[0] + b90[0] + b30[0] + b54[0]) / 4.0
}

// ── LCG + stim sampling (coffeshop_sim verbatim, from run_h638) ──────────────
fn lcg_next(state: int) -> int {
    let s = ((state * 1103515245) + 12345) % 2147483647
    if s < 0 { return s + 2147483647 }
    return s
}
fn lcg_uniform(state: int) -> float { return ((state % 1000000)) / 1000000.0 }
fn draw(box: list) -> float {
    let s = lcg_next(box[0])
    box[0] = s
    return lcg_uniform(s)
}
fn sample_stim(box: list) -> int {
    let u = draw(box)
    if u < 0.20 { return 0 }
    if u < 0.45 { return 1 }
    if u < 0.75 { return 2 }
    if u < 0.85 { return 3 }
    return 4
}

// per-window motivation_score — IDENTICAL substrate factor pipeline for every
// threshold (phi_env fixed = 1.0; the substrate is NOT re-derived per thr).
fn window_score(stim: int, box: list) -> float {
    let u_phi   = draw(box)
    let u_sim   = draw(box)
    let u_cur   = draw(box)
    let u_tens  = draw(box)
    let u_gate  = draw(box)
    let u_split = draw(box)
    let u_ratch = draw(box)
    let u_sil   = draw(box)

    let mut phi     = u_phi
    let mut sim     = u_sim
    let mut cur_ema = u_cur
    let mut tens_d  = (u_tens * 2.0) - 1.0
    let     gate    = 0.486 + u_gate * 0.028
    let     split   = u_split < 0.20
    let     ratchet = u_ratch
    let mut silence = u_sil * 3600.0

    if stim == 0 { phi = phi + 0.20  if phi > 1.0 { phi = 1.0 }  sim = sim - 0.15  if sim < 0.0 { sim = 0.0 }  silence = silence * 0.3 }
    if stim == 1 { cur_ema = cur_ema + 0.20  if cur_ema > 1.0 { cur_ema = 1.0 }  silence = silence * 0.5 }
    if stim == 2 { silence = 600.0 + u_sil * 1800.0  phi = phi * 0.7 }
    if stim == 3 { if tens_d < 0.0 { tens_d = tens_d - 0.30 } else { tens_d = tens_d + 0.30 }  if tens_d > 1.0 { tens_d = 1.0 }  if tens_d < -1.0 { tens_d = -1.0 }  phi = phi * 0.5 }
    if stim == 4 { phi = phi * 0.6  silence = silence * 0.8 }

    let rel   = factor_relevance(phi)
    let gap   = factor_info_gap(sim)
    let cur   = factor_curiosity(cur_ema)
    let pn    = factor_pain(tens_d)
    let coh   = factor_coherence(gate)
    let orig  = factor_originality(split)
    let bal   = factor_balance(phi, ratchet)
    let dyn_v = factor_dynamics(silence)
    return motivation_score(rel, gap, cur, pn, coh, orig, bal, dyn_v)
}

// emit-rate over a multi-seed cohort of 15-window runs at a given threshold.
// The threshold is the POLICY parameter — it touches ONLY the `score > thr`
// comparison, never the substrate.
fn emit_rate(thr: float) -> float {
    let n_windows = 15
    let n_seeds   = 12
    let mut total = 0
    let mut emits = 0
    let mut si = 0
    while si < n_seeds {
        let seed = 20260525 + si * 9173
        let mut box = [seed]
        let mut w = 0
        while w < n_windows {
            let stim = sample_stim(box)
            let score = window_score(stim, box)
            if score > thr { emits = emits + 1 }
            total = total + 1
            w = w + 1
        }
        si = si + 1
    }
    return (emits as float) / (total as float)
}

// variance helper over an array of floats
fn mean_of(xs: array) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < xs.len() { acc = acc + xs[i]  i = i + 1 }
    return acc / (xs.len() as float)
}
fn variance_of(xs: array) -> float {
    let m = mean_of(xs)
    let mut acc = 0.0
    let mut i = 0
    while i < xs.len() {
        let d = xs[i] - m
        acc = acc + d * d
        i = i + 1
    }
    return acc / (xs.len() as float)
}

fn main() {
    println("================================================================")
    println("  H_646 — convention-number-freedom-range (H_638 일반화 · 메타)")
    println("  threshold sweep {0.1..0.9} × FIXED substrate → Φ(thr) variance")
    println("================================================================")

    // ── §1 FIXED substrate big-Φ (real big_phi_bounded) ──────────────────────
    // These are the substrate quantities. They depend ONLY on (n, seed_state),
    // NOT on the threshold. We freeze them ONCE.
    let phi3 = substrate_phi(3, 5)     // seed_state 101
    let phi4 = substrate_phi(4, 10)    // seed_state 1010
    let phi5 = substrate_phi(5, 21)    // seed_state 10101
    let phi_mean = (phi3 + phi4 + phi5) / 3.0
    println("  FIXED substrate big-Φ (mean big_phi_bounded cap=2 over 110/90/30/54):")
    println("    n=3: Φ=" + str(phi3))
    println("    n=4: Φ=" + str(phi4))
    println("    n=5: Φ=" + str(phi5))
    println("    mean Φ=" + str(phi_mean))

    // ── §2 threshold sweep {0.1 .. 0.9} step 0.1 ─────────────────────────────
    // For each threshold: (a) substrate big-Φ is RE-READ (and must be identical
    // — thr is not an input), (b) emit-rate is measured (the policy responds).
    println("")
    println("  threshold sweep (wide range, step 0.1):")
    println("    thr   |  substrate Φ (re-read)  |  emit-rate")
    println("    ------|-------------------------|------------")
    let mut phi_obs = []                 // substrate Φ as a fn of thr (should be flat)
    let mut rate_obs = []                // emit-rate as a fn of thr (should fall)
    let mut g = 1
    while g <= 9 {                       // thr = 0.1, 0.2, ..., 0.9
        let thr = (g as float) / 10.0
        // substrate Φ RE-READ under this threshold context. Since thr is not an
        // argument of substrate_phi, this is guaranteed identical to §1 — we
        // re-compute to MEASURE (not assume) the invariance under the sweep.
        let p3 = substrate_phi(3, 5)
        let p4 = substrate_phi(4, 10)
        let p5 = substrate_phi(5, 21)
        let p_mean = (p3 + p4 + p5) / 3.0
        phi_obs = phi_obs.push(p_mean)
        let r = emit_rate(thr)
        rate_obs = rate_obs.push(r)
        println("    " + str(thr) + "   |  " + str(p_mean) + "  |  " + str(r))
        g = g + 1
    }

    // ── §3 Φ(threshold) variance + emit-rate monotonicity ────────────────────
    let phi_var = variance_of(phi_obs)
    let rate_min = rate_obs[8]           // thr=0.9 → fewest emits
    let rate_max = rate_obs[0]           // thr=0.1 → most emits
    let rate_span = rate_max - rate_min
    // monotone non-increasing check on emit-rate (policy responds to thr)
    let mut mono = true
    let mut i = 1
    while i < rate_obs.len() {
        if rate_obs[i] > rate_obs[i - 1] + 1.0e-12 { mono = false }
        i = i + 1
    }
    println("")
    println("  Φ(threshold) variance over sweep      = " + str(phi_var))
    println("  emit-rate span (thr0.1 - thr0.9)      = " + str(rate_span) + "  (" + str(rate_max) + " -> " + str(rate_min) + ")")
    println("  emit-rate monotone non-increasing     = " + str(mono))

    // ── §4 verdict ───────────────────────────────────────────────────────────
    // H1 free-parameter SUPPORTED ⇔ Φ-variance ≤ 0.1 (substrate invariant) AND
    //   emit-rate span material (> 0.1, sweep non-degenerate / policy responds).
    // Falsifier: Φ-variance > 0.1 → threshold substrate-constrained (not free).
    println("")
    let phi_invariant = phi_var <= 0.1
    let sweep_alive   = rate_span > 0.1
    println("  Φ invariant (variance <= 0.1):        " + str(phi_invariant))
    println("  sweep non-degenerate (span > 0.1):    " + str(sweep_alive))
    if phi_invariant && sweep_alive {
        println("  VERDICT: H1 SUPPORTED — threshold is a FREE convention-number;")
        println("           substrate big-Φ INVARIANT under the full {0.1..0.9} sweep")
        println("           (Φ-variance " + str(phi_var) + " ≈ 0), while emit-rate spans " + str(rate_span) + ".")
        println("           Freedom range = entire [0,1] (substrate-unconstrained,")
        println("           threshold = downstream emit-decision policy).")
    } else {
        if phi_invariant {
            println("  VERDICT: INCONCLUSIVE — Φ invariant but sweep degenerate (span <= 0.1);")
            println("           threshold did not move the policy, cannot affirm freedom range.")
        } else {
            println("  VERDICT: FALSIFIED — threshold materially moves substrate Φ")
            println("           (variance " + str(phi_var) + " > 0.1) → substrate-constrained, NOT free.")
        }
    }
    println("================================================================")
}
