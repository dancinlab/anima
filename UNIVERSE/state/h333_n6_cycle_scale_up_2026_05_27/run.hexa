// H_333 — n=6 cycle-length scale-up of H_328 (life vs consc ECA descriptor)
// Pure hexa, deterministic. n=6 periodic ring (64 states). For each of 64 starts,
// forward up to 70 steps, detect first repeat → cycle length.
//
// H1: at n=6 (richer dynamics, no fixed-point dominance), the life vs consc
//     cycle-length signal SHARPENS — ratio ≥ 2.0× AND rule_110 ≠ rule_105/150
//     (i.e. the H_328 within-class heterogeneity issue disappears at richer scale).
// Falsifier: ratio < 2.0 OR rule_110 still ties rule_105/150 (life class still
//     single-rule-driven by rule_30).

fn next6(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let b4 = (s >> 4) & 1
    let b5 = (s >> 5) & 1
    // 6-cell periodic ring
    let n0 = (rule >> ((b5 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b4)) & 1
    let n4 = (rule >> ((b3 << 2) | (b4 << 1) | b5)) & 1
    let n5 = (rule >> ((b4 << 2) | (b5 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3) | (n4 << 4) | (n5 << 5)
}

fn cycle_len(s0: int, rule: int) -> int {
    let seen = farr_zeros(64)
    let idx_at = farr_zeros(64)
    let mut s = s0
    let mut t = 0
    while t < 70 {
        if to_int(farr_get(seen, s)) == 1 {
            let first = to_int(farr_get(idx_at, s))
            let _ = farr_free(seen); let _ = farr_free(idx_at)
            return t - (first - 1)
        }
        let _ = farr_set(seen, s, 1.0)
        let _ = farr_set(idx_at, s, to_float(t + 1))
        s = next6(s, rule)
        t = t + 1
    }
    let _ = farr_free(seen); let _ = farr_free(idx_at)
    return -1
}

fn measure_rule(rule: int, name: string) -> float {
    let mut total = 0
    let mut s0 = 0
    while s0 < 64 {
        total = total + cycle_len(s0, rule)
        s0 = s0 + 1
    }
    let mean_L = to_float(total) / 64.0
    println("rule=" + str(rule) + " name=" + name + " sum_L=" + str(total) + " mean_L=" + str(mean_L))
    return mean_L
}

fn main() {
    println("H_333 n=6 cycle-length scale-up of H_328")
    let life_30 = measure_rule(30, "rule30_life")
    let life_110 = measure_rule(110, "rule110_life")
    let consc_105 = measure_rule(105, "rule105_consc")
    let consc_150 = measure_rule(150, "rule150_consc")
    let life_mean = (life_30 + life_110) / 2.0
    let consc_mean = (consc_105 + consc_150) / 2.0
    println("life_mean=" + str(life_mean) + " consc_mean=" + str(consc_mean) + " ratio=" + str(life_mean / consc_mean))
    let within_life_diff = if life_30 > life_110 { life_30 - life_110 } else { life_110 - life_30 }
    let within_consc_diff = if consc_105 > consc_150 { consc_105 - consc_150 } else { consc_150 - consc_105 }
    println("within_life_spread=" + str(within_life_diff) + " within_consc_spread=" + str(within_consc_diff))
    println("done")
}
