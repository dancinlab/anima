// UNIVERSE/state/h321_c1_h278_faithful_phi_structure_recheck_2026_05_27/run.hexa
// ════════════════════════════════════════════════════════════════════════════
// H_321 — C1 axis · H_278 faithful Φ recheck under IIT 4.0 cause-effect
//          structure (Φ-structure norm scale-variance).
//
//   HYPOTHESIS (H1, falsifiable)
//     H_278 의 SCALE-VARIANT 결론(6-scale ECA panel, faithful MIP-EI CV=2.15) 이
//     IIT 4.0 의 진짜 Φ-구조 (distinctions + 2nd-order relations · Σφ_d + Σφ_r)
//     로 측정해도 살아남는다 — 즉 nesting-ratio total(n=5)/total(n=4) 의 6-rule
//     CV 가 임계 0.15 초과.
//   FALSIFIER
//     CV ≤ 0.15 → structure-invariant (H_278 결론이 구조 수준에서 무너짐 — 🔴).
//     CV  > 0.15 → scale-variant HOLD (H_278 결론이 IIT 4.0 구조에서도 살아남음
//                   — 🟢). relation kernel 3건+ 미완 → 🟠 deferred.
//
//   ENGINE (REUSED, NOT reinvented — memory H_280 lesson):
//     stdlib/consciousness/iit4_relation.hexa  (phi_structure: M3)
//     stdlib/consciousness/iit4_distinction.hexa (M2)
//     HEXAD/IIT4/lib/iit4_eca.hexa             (eca_tpm: Wolfram → state-by-node TPM)
//
//   DETERMINISTIC · hexa-only · llm:none · $0 mac local. n ≤ 5 (32-state, exact
//   tractable, cross-process byte-identical).
//
//   IRON RULE (commons @D g73) anti-tautology compliance:
//     phi_structure total = Σφ_d + Σφ_r is COMPLETELY INDEPENDENT of H_278's
//     cross-cut MI / MIP-EI. distinctions come from IIT 4.0 cause/effect
//     repertoire MICE (intrinsic_difference over partitions of M ∪ Z),
//     relations from congruent purview overlap. Could absolutely have collapsed
//     to a degenerate panel — the test is genuine.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_relation.hexa"
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_eca.hexa"

// ── panel: 6 ECA rules byte-for-byte from H_278 ───────────────────────────
fn panel_size() -> int { return 6 }

fn panel_label(s: int) -> string {
    if s == 0 { return "cosmic_web" }
    if s == 1 { return "galaxy_cluster" }
    if s == 2 { return "stellar" }
    if s == 3 { return "planetary" }
    if s == 4 { return "biological" }
    return "neural"
}
fn panel_rule(s: int) -> int {
    if s == 0 { return 30 }
    if s == 1 { return 110 }
    if s == 2 { return 90 }
    if s == 3 { return 54 }
    if s == 4 { return 110 }
    return 110
}
fn panel_couple(s: int) -> float {
    // recorded for H_278 metadata parity; not used in structural measurement.
    if s == 0 { return 0.00 }
    if s == 1 { return 0.10 }
    if s == 2 { return 0.20 }
    if s == 3 { return 0.30 }
    if s == 4 { return 0.45 }
    return 0.60
}

// fixed deterministic non-trivial sys_state per ring size (mixed bit pattern).
fn sys_at_n(n: int) -> int {
    if n == 4 { return 11 }   // 0b1011 — 3-on / 1-off mixed, used by H_312 n=4 too
    if n == 5 { return 21 }   // 0b10101 — alternating-ish mixed
    return 0
}

fn fmt(x: float) -> string { return to_string(x) }
fn bstr(b: bool) -> string { if b { return "true" }; return "false" }

// ── measure phi_structure total for one (rule, n) cell ────────────────────
fn measure_cell(rule: int, n: int) -> array {
    let sys = sys_at_n(n)
    let tpm = eca_tpm(rule, n)
    let res = phi_structure(tpm, n, sys)
    // res = [nd, sum_d, nr, sum_r, total]
    return res
}

fn main() {
    println("H_321 — C1 axis · H_278 faithful Φ recheck under IIT 4.0 Φ-structure")
    println("  engine = stdlib iit4_relation.phi_structure (REUSED, NOT reinvented)")
    println("  panel  = 6 ECA rules × n∈{4,5} = 12 measurements")
    println("  FALSIFIER: nesting-ratio CV ≤ 0.15 ⇒ structure-invariant 🔴")
    println("             nesting-ratio CV  > 0.15 ⇒ scale-variant HOLD 🟢")
    println("")

    // collect per-cell measurements (sys_state values are absolute over the
    // entire n-cell system — they ARE the system state, not subsystem masks).
    let mut totals_n4 = []
    let mut totals_n5 = []
    let mut nd_n4 = []
    let mut sumd_n4 = []
    let mut nr_n4 = []
    let mut sumr_n4 = []
    let mut nd_n5 = []
    let mut sumd_n5 = []
    let mut nr_n5 = []
    let mut sumr_n5 = []

    let mut s = 0
    while s < panel_size() {
        let label = panel_label(s)
        let rule  = panel_rule(s)
        let cpl   = panel_couple(s)

        // n=4
        let r4 = measure_cell(rule, 4)
        let nd4    = r4[0]
        let sumd4  = r4[1]
        let nr4    = r4[2]
        let sumr4  = r4[3]
        let tot4   = r4[4]

        // n=5
        let r5 = measure_cell(rule, 5)
        let nd5    = r5[0]
        let sumd5  = r5[1]
        let nr5    = r5[2]
        let sumr5  = r5[3]
        let tot5   = r5[4]

        totals_n4 = totals_n4.push(tot4)
        totals_n5 = totals_n5.push(tot5)
        nd_n4 = nd_n4.push(nd4); sumd_n4 = sumd_n4.push(sumd4)
        nr_n4 = nr_n4.push(nr4); sumr_n4 = sumr_n4.push(sumr4)
        nd_n5 = nd_n5.push(nd5); sumd_n5 = sumd_n5.push(sumd5)
        nr_n5 = nr_n5.push(nr5); sumr_n5 = sumr_n5.push(sumr5)

        println("PANEL " + label + " rule=" + to_string(rule) + " couple=" + fmt(cpl))
        println("  n=4 sys=11  nd=" + to_string(nd4.to_int()) + " sum_d=" + fmt(sumd4) + " nr=" + to_string(nr4.to_int()) + " sum_r=" + fmt(sumr4) + " total=" + fmt(tot4))
        println("  n=5 sys=21  nd=" + to_string(nd5.to_int()) + " sum_d=" + fmt(sumd5) + " nr=" + to_string(nr5.to_int()) + " sum_r=" + fmt(sumr5) + " total=" + fmt(tot5))
        let ratio = if tot4 > 1.0e-12 { tot5 / tot4 } else { 0.0 }
        println("  ratio total(n=5)/total(n=4)=" + fmt(ratio) + " delta=" + fmt(tot5 - tot4))
        println("")

        s = s + 1
    }

    // ── nesting-ratio CV across 6 rules ─────────────────────────────────────
    // ratio_i = total(n=5)_i / total(n=4)_i, fall back to 0 when n=4 ≈ 0.
    let mut ratios = []
    let mut k = 0
    while k < panel_size() {
        let t4 = totals_n4[k]
        let t5 = totals_n5[k]
        let r = if t4 > 1.0e-12 { t5 / t4 } else { 0.0 }
        ratios = ratios.push(r)
        k = k + 1
    }

    // mean
    let mut sum = 0.0
    let mut i = 0
    while i < panel_size() {
        sum = sum + ratios[i]
        i = i + 1
    }
    let mean = sum / to_float(panel_size())

    // stddev (population)
    let mut sq = 0.0
    let mut j = 0
    while j < panel_size() {
        let d = ratios[j] - mean
        sq = sq + d * d
        j = j + 1
    }
    let var = sq / to_float(panel_size())
    let stddev = sqrt(var)
    let cv = if mean > 1.0e-12 { stddev / mean } else { 0.0 }
    let cv_abs = if cv < 0.0 { 0.0 - cv } else { cv }

    println("RATIOS total(n=5)/total(n=4) per rule:")
    let mut p = 0
    while p < panel_size() {
        println("  " + panel_label(p) + " ratio=" + fmt(ratios[p]))
        p = p + 1
    }
    println("")
    println("STATS  mean=" + fmt(mean) + " stddev=" + fmt(stddev) + " CV=" + fmt(cv_abs))

    // ── verdict derivation (from numbers) ───────────────────────────────────
    let cv_thr = 0.15
    let scale_variant = cv_abs > cv_thr

    // F-H321-1 tractable: all measurements finite ≥ 0
    let mut all_finite = true
    let mut q = 0
    while q < panel_size() {
        if totals_n4[q] < 0.0 { all_finite = false }
        if totals_n5[q] < 0.0 { all_finite = false }
        q = q + 1
    }

    // F-H321-4 structure-nontrivial: at least one cell with nd ≥ 1
    let mut any_nontrivial = false
    let mut r = 0
    while r < panel_size() {
        if nd_n4[r] >= 0.999 { any_nontrivial = true }
        if nd_n5[r] >= 0.999 { any_nontrivial = true }
        r = r + 1
    }

    println("")
    println("FALSIFIERS")
    println("  F-H321-1 TRACTABLE         : " + bstr(all_finite))
    println("  F-H321-2 STRUCT-NORM-CV    : CV=" + fmt(cv_abs) + " thr=" + fmt(cv_thr) + " scale_variant=" + bstr(scale_variant))
    println("  F-H321-3 DETERMINISM       : closed-form (re-run identical)")
    println("  F-H321-4 NONTRIVIAL-STRUCT : " + bstr(any_nontrivial))
    println("  F-H321-5 INDEP-MEASURE     : phi_structure ⊥ MIP-EI cross-cut MI (different primitives)")

    println("")
    if !all_finite {
        println("VERDICT 🟠 DEFERRED-INTRACTABLE (some measurement non-finite)")
    } else {
        if !any_nontrivial {
            // panel produced zero distinctions everywhere — structure measurement is degenerate;
            // honest 🟠 disclosure (single-mech distinctions identically 0 for ECA, full structure had no signal).
            println("VERDICT 🟠 DEFERRED-DEGENERATE (no nontrivial distinctions across panel — structure-norm has no signal under sys_state choice)")
        } else {
            if scale_variant {
                println("VERDICT 🟢 SUPPORTED-NUMERICAL (scale-variant HOLD at IIT 4.0 Φ-structure level — H_278 finding survives structural deepening)")
            } else {
                println("VERDICT 🔴 FALSIFIED-NUMERICAL (structure-invariant — H_278 SCALE-VARIANT does NOT survive at IIT 4.0 Φ-structure level; closed-negative)")
            }
        }
    }

    println("DONE")
}
