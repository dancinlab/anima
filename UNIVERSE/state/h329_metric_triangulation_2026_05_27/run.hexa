// H_329 — metric-triangulation: 3 descriptors agree on ECA rule ranking?
// Pure hexa, deterministic. n=4 ring, 16 starting states.
// Descriptors:
//   A. mean_cycle_length   (forward orbit · first repeat)
//   B. mean_active_bits    (popcount of state, averaged over 16 starts)
//   C. unique_state_count  (distinct states visited from all starts ∪)
//
// H1: across 4 live rules {30, 110, 105, 150}, the 3 descriptor rankings
// AGREE on the top rule with majority (≥2 of 3 descriptors pick the same).
// Anti-tautology: each descriptor is computed INDEPENDENTLY from the orbit
// and they could disagree (Φ-fragility H_268 finding).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

fn popcount(s: int) -> int {
    return (s & 1) + ((s >> 1) & 1) + ((s >> 2) & 1) + ((s >> 3) & 1)
}

fn cycle_len(s0: int, rule: int) -> int {
    let seen = farr_zeros(16)
    let idx_at = farr_zeros(16)
    let mut s = s0
    let mut t = 0
    while t < 20 {
        if to_int(farr_get(seen, s)) == 1 {
            let first = to_int(farr_get(idx_at, s))
            let _ = farr_free(seen); let _ = farr_free(idx_at)
            return t - (first - 1)
        }
        let _ = farr_set(seen, s, 1.0)
        let _ = farr_set(idx_at, s, to_float(t + 1))
        s = next4(s, rule)
        t = t + 1
    }
    let _ = farr_free(seen); let _ = farr_free(idx_at)
    return -1
}

fn measure_descriptors(rule: int, name: string) {
    // A. mean cycle length across 16 starts
    let mut sum_L = 0
    let mut s0 = 0
    while s0 < 16 { sum_L = sum_L + cycle_len(s0, rule); s0 = s0 + 1 }
    let mean_L = to_float(sum_L) / 16.0
    // B. mean active bits — average popcount over 16 starts of 1-step-ahead state
    let mut sum_bits = 0
    let mut s = 0
    while s < 16 { sum_bits = sum_bits + popcount(next4(s, rule)); s = s + 1 }
    let mean_bits = to_float(sum_bits) / 16.0
    // C. unique state count — distinct states reached by 1-step from any start
    let reached = farr_zeros(16)
    let mut s2 = 0
    while s2 < 16 {
        let nxt = next4(s2, rule)
        let _ = farr_set(reached, nxt, 1.0)
        s2 = s2 + 1
    }
    let mut uniq = 0
    let mut i = 0
    while i < 16 { if to_int(farr_get(reached, i)) == 1 { uniq = uniq + 1 }; i = i + 1 }
    let _ = farr_free(reached)
    println("rule=" + str(rule) + " name=" + name + " mean_L=" + str(mean_L) + " mean_bits=" + str(mean_bits) + " uniq_states=" + str(uniq))
}

fn main() {
    println("H_329 metric-triangulation: 3 descriptors on n=4 ECA")
    measure_descriptors(30, "rule30")
    measure_descriptors(110, "rule110")
    measure_descriptors(105, "rule105")
    measure_descriptors(150, "rule150")
    measure_descriptors(60, "rule60")
    measure_descriptors(204, "rule204_id")
    measure_descriptors(0, "rule0_null")
    println("done")
}
