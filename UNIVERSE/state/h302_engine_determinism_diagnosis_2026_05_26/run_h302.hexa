// UNIVERSE/state/h302_engine_determinism_diagnosis_2026_05_26/run_h302.hexa
//
//   H_302 — engine determinism diagnosis (F301.8 cross-H rule 60 anomaly)
//
//   QUESTION
//     H_301 measured rule 60 n=5 st=21 cap=4 = 18.5, but H_297 panel
//     reported 16.5 for the same (rule, n, st, cap). rule 90 reproduces
//     exactly (19.5 in both H_297 and H_300/H_301). Is the engine
//     order-dependent? Where does 16.5 come from?
//
//   HYPOTHESES
//     H1 REPRO-INTRA:   same call twice -> byte-identical
//     H2 ORDER-INDEP:   panel A [60, 90] rule 60 val == panel B [90, 60]
//     H3 RULE-90-INT:   rule 90 n=5 st=21 cap=4 = 19.5 (3-H gold standard)
//     H4 RULE-60-NEW:   rule 60 n=5 st=21 cap=4 = 18.5 (H_301 reproducible)
//     H5 LOC-16-5:      brute-force grid finds the (state, cap) giving 16.5
//     H6 BOUND
//
//   METHOD
//     - 20 calls total, all instrumented
//     - grid: rule 60, n ∈ {4, 5, 6}, st ∈ {5, 13, 21}, cap ∈ {3, 4}
//     - log every value, search for 16.5
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26)
//     F302.1 REPRO-INTRA      (intra-process determinism)
//     F302.2 ORDER-INDEP      (no eca_tpm/big_phi shared mutable state)
//     F302.3 RULE-90-INT      (rule 90 cross-H = 19.5)
//     F302.4 RULE-60-CURRENT  (rule 60 = 18.5, H_301 reproducible)
//     F302.5 LOC-16-5         (brute-force grid finds 16.5; PASS if found)
//     F302.6 BOUND
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-c40/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn phi_b(rule: int, n: int, st: int, cap: int) -> float {
    let r = big_phi_bounded(eca_tpm(rule, n), n, st, cap)
    return r[0]
}

fn close_to(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.05 }
    return d < 0.05
}

fn main() {
    println("================================================================")
    println("  H_302 — eca_tpm × big_phi_bounded determinism diagnosis")
    println("================================================================")

    // ── F302.1 REPRO-INTRA ──────────────────────────────────────────────
    let a = phi_b(60, 5, 21, 4)
    let b = phi_b(60, 5, 21, 4)
    println("  Call A: rule 60 n=5 st=21 cap=4 = " + str(a))
    println("  Call B: rule 60 n=5 st=21 cap=4 = " + str(b))
    check("F302.1 REPRO-INTRA: rule 60 n=5 st=21 cap=4 identical twice", a == b)

    // ── F302.2 ORDER-INDEP ──────────────────────────────────────────────
    // panel A: rule 60 first, then rule 90
    let p_a_60 = phi_b(60, 5, 21, 4)
    let p_a_90 = phi_b(90, 5, 21, 4)
    // panel B: rule 90 first, then rule 60
    let p_b_90 = phi_b(90, 5, 21, 4)
    let p_b_60 = phi_b(60, 5, 21, 4)
    println("  PANEL A (60→90): rule 60=" + str(p_a_60) + " rule 90=" + str(p_a_90))
    println("  PANEL B (90→60): rule 60=" + str(p_b_60) + " rule 90=" + str(p_b_90))
    check("F302.2 ORDER-INDEP: panel A rule 60 == panel B rule 60", p_a_60 == p_b_60)

    // ── F302.3 RULE-90-INT ──────────────────────────────────────────────
    check("F302.3 RULE-90-INT: rule 90 n=5 st=21 cap=4 ≈ 19.5 (cross-H gold standard)", close_to(p_a_90, 19.5))

    // ── F302.4 RULE-60-CURRENT ──────────────────────────────────────────
    check("F302.4 RULE-60-CURRENT: rule 60 n=5 st=21 cap=4 ≈ 18.5 (H_301)", close_to(a, 18.5))

    // ── F302.5 LOC-16-5: brute-force grid for 16.5 ──────────────────────
    println("  ── F302.5 LOC-16-5 grid (rule 60, hunting for 16.5) ──")
    let mut found_16_5 = false
    let mut found_at = "(none)"
    let n_vals = [4, 5, 6]
    let st_vals = [5, 13, 21]
    let cap_vals = [3, 4]
    let mut ni = 0
    while ni < 3 {
        let n = n_vals[ni]
        let mut si = 0
        while si < 3 {
            let st = st_vals[si]
            if st < iit4_pow2(n) {
                let mut ci = 0
                while ci < 2 {
                    let c = cap_vals[ci]
                    if c < n {
                        let v = phi_b(60, n, st, c)
                        println("    rule 60 n=" + str(n) + " st=" + str(st) + " cap=" + str(c) + " = " + str(v))
                        if close_to(v, 16.5) {
                            found_16_5 = true
                            found_at = "n=" + str(n) + " st=" + str(st) + " cap=" + str(c)
                        }
                    }
                    ci = ci + 1
                }
            }
            si = si + 1
        }
        ni = ni + 1
    }
    println("  16.5 found at: " + found_at)
    check("F302.5 LOC-16-5: rule 60 grid contains a 16.5 measurement (artifact location)", found_16_5)

    // ── F302.6 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    if !(a >= 0.0) { bound_ok = false }
    if !(b >= 0.0) { bound_ok = false }
    if !(p_a_60 >= 0.0) { bound_ok = false }
    if !(p_a_90 >= 0.0) { bound_ok = false }
    if !(p_b_60 >= 0.0) { bound_ok = false }
    if !(p_b_90 >= 0.0) { bound_ok = false }
    check("F302.6 BOUND: all measured Phi >= 0", bound_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  GOLD: rule 90 n=5 st=21 cap=4 = " + str(p_a_90) + " (target 19.5)")
    println("  CURRENT: rule 60 n=5 st=21 cap=4 = " + str(a) + " (H_301 was 18.5, H_297 was 16.5)")
    println("================================================================")
    if FAIL > 0 { panic("H_302 had FALSIFIER FAILURES") }
}
