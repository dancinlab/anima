// ════════════════════════════════════════════════════════════════════════════
//  run_emit_count.hexa — H_axisg_emit_eventcount
//    mining leaf L40 / L24 (emit = amplitude-threshold-crossing event) — emit
//    EVENT-COUNT (per-state Φ가 emit threshold 를 넘는 state 의 수/비율) 가
//    Wolfram class 로 단조 정렬되는가? (round 9 메타-축 substrate-emit 확장)
//
//  CONTEXT
//    H_654 (🟢/PARTIAL) 는 big-Φ 의 절대 *MAGNITUDE* (16-state mean) 가 Wolfram
//    class 로 단조 정렬됨을 보였다. H_639 (🔴) 는 amplitude-cross-RATE 의 derivative
//    PEAK 가 dΦ/dI peak 와 *동조* 하는지 (coupling) 를 봤다 (θ-convention 종속 반증).
//    본 H 는 둘과 직교한 layer 를 측정한다: emit 을 "state 의 big-Φ 가 emit
//    threshold θ_emit 를 넘는 DISCRETE EVENT" 로 정의했을 때, 한 substrate 에서
//    그런 EMIT-EVENT 를 내는 STATE 의 COUNT (16 state 중 몇 개) 가 Wolfram class
//    로 단조 정렬되는가. 즉 magnitude (연속 평균) 가 아닌 emit-event 의 DISCRETE
//    COUNT (p5 의 'amplitude-cross event' 정의) 가 class-ordered 인지.
//
//  SUBSTRATE  ECA n=4 periodic ring, GZ-anchor inhibition I=0.21232 (H_351 GZ_LOWER).
//    rules {30,54,90,110,184} = III/IV/III-additive/IV/II.
//    per-state big-Φ → emit_count(rule) = #{ s : big_phi(s) >= θ_emit }.
//    θ_emit 는 전 rule 공통 ABSOLUTE threshold — class 비교의 fair anchor.
//    robustness: θ_emit ∈ {0.5, 1.0, 2.0} 3-point sweep (single-θ artifact 회피).
//
//  HYPOTHESIS
//    emit_count 가 Wolfram class 로 단조: complex/chaotic (110/30/54) >> additive
//    (90, Φ≈0 → 0 emit) , class-II (184) 중간. 즉 emit-EVENT 도 magnitude (H_654)
//    처럼 substrate-class classifier 이고 rule110 (class-IV) 최대.
//
//  FALSIFIER
//    emit_count 가 class 와 무관 (flat) 또는 비-단조 (additive 가 complex 보다 많은
//    emit) → emit-event-count ⊥ substrate-class (magnitude 와 다른 거동).
//
//  CRITERIA (3 θ 전부에서)
//    M1 RULE110-MAX     : rule110 emit_count = max over rules (또는 tie-max)
//    M2 RULE90-ZERO     : rule90 emit_count = 0 (additive Φ≈0)
//    M3 COMPLEX-GT-PARTICLE : complex(110) >= particle(184) emit_count
//    M4 BOUND/DET       : 0 <= emit_count <= 16, re-run byte-identical
//
//  VERDICT
//    SUPPORTED-NUMERICAL = M1∧M2∧M3 (3 θ 전부) → emit-event-count = class classifier
//    FALSIFIED           = !M1 (rule110 NOT max) OR !M2 (rule90 emits) at any θ
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima-gd-20260529/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _n() -> int { return 4 }
fn _gz() -> float { return 0.21232 }   // GZ_LOWER anchor (H_351)

fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}

// per-state big-Φ array (16 values for n=4) at the GZ inhibition
fn phi_states(rule: int) -> array {
    let tpm = mixed_tpm(rule, _n(), _gz())
    let full = iit4_pow2(_n())
    let mut out = []
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, _n(), s)
        out = out.push(r[0])
        s = s + 1
    }
    return out
}

// count states whose Φ >= theta
fn emit_count(phis: array, theta: float) -> int {
    let mut c = 0
    let mut i = 0
    while i < len(phis) {
        if phis[i] >= theta { c = c + 1 }
        i = i + 1
    }
    return c
}

fn json_arr_i(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    return s + "]"
}

fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    return s + "]"
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_axisg_emit_eventcount — emit-EVENT-COUNT vs Wolfram class")
    println("  rules {30,54,90,110,184} · GZ-anchor I=" + str(_gz()))
    println("  θ_emit sweep {0.5, 1.0, 2.0} · emit-event = #{s: Φ(s) >= θ}")
    println("════════════════════════════════════════════════════════════")

    let rules = [30, 54, 90, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "III-additive",
                       "IV-complex", "II-particle"]
    let thetas = [0.5, 1.0, 2.0, 5.0, 8.0, 11.0]

    // precompute per-rule phi-states once (16 big_phi calls/rule)
    let mut all_phis = []
    let mut r = 0
    while r < len(rules) {
        all_phis = all_phis.push(phi_states(rules[r]))
        r = r + 1
    }

    // counts[t][rule]  — flattened: counts_by_theta is array of arrays
    let mut counts_by_theta = []
    let mut all_m1 = true
    let mut all_m2 = true
    let mut all_m3 = true

    let mut ti = 0
    while ti < len(thetas) {
        let theta = thetas[ti]
        println("")
        println("── θ_emit = " + str(theta) + " ──")
        let mut counts = []
        let mut ri = 0
        while ri < len(rules) {
            let c = emit_count(all_phis[ri], theta)
            counts = counts.push(c)
            println("  rule " + str(rules[ri]) + " (" + class_names[ri] + ")  emit_count = " + str(c))
            ri = ri + 1
        }
        counts_by_theta = counts_by_theta.push(counts)

        // find max count over rules
        let mut maxc = counts[0]
        let mut mi = 1
        while mi < len(counts) {
            if counts[mi] > maxc { maxc = counts[mi] }
            mi = mi + 1
        }
        // index map rules[0]=30 [1]=54 [2]=90 [3]=110 [4]=184
        let c110 = counts[3]
        let c90  = counts[2]
        let c184 = counts[4]

        let m1 = c110 == maxc        // rule110 max (tie-allowed)
        let m2 = c90 == 0            // additive zero
        let m3 = c110 >= c184        // complex >= particle

        println("    max emit_count   = " + str(maxc))
        println("    rule110 == max   = " + str(m1))
        println("    rule90 == 0      = " + str(m2))
        println("    c110 >= c184     = " + str(m3))

        if !m1 { all_m1 = false }
        if !m2 { all_m2 = false }
        if !m3 { all_m3 = false }
        ti = ti + 1
    }

    // bound/det check
    let mut m4 = true
    let mut bi = 0
    while bi < len(counts_by_theta) {
        let cc = counts_by_theta[bi]
        let mut bj = 0
        while bj < len(cc) {
            if cc[bj] < 0 { m4 = false }
            if cc[bj] > 16 { m4 = false }
            bj = bj + 1
        }
        bi = bi + 1
    }

    let mut m1f = 0
    if all_m1 { m1f = 1 }
    let mut m2f = 0
    if all_m2 { m2f = 1 }
    let mut m3f = 0
    if all_m3 { m3f = 1 }
    let mut m4f = 0
    if m4 { m4f = 1 }

    println("")
    println("════════════════════════════════════════════════════════════")
    println("── AGGREGATE (across 3 θ) ──")
    println("  M1 RULE110-MAX           = " + str(m1f))
    println("  M2 RULE90-ZERO           = " + str(m2f))
    println("  M3 COMPLEX-GT-PARTICLE   = " + str(m3f))
    println("  M4 BOUND/DET             = " + str(m4f))

    let supported = all_m1 && all_m2 && all_m3
    let falsified = (!all_m1) || (!all_m2)
    let mut verdict_str = "PARTIAL"
    if supported { verdict_str = "SUPPORTED-NUMERICAL" }
    if falsified { verdict_str = "FALSIFIED" }
    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // JSON: serialize phi-states (mean per rule) + counts grid
    let mut mean_phis = []
    let mut mr = 0
    while mr < len(all_phis) {
        let ph = all_phis[mr]
        let mut tot = 0.0
        let mut pk = 0
        while pk < len(ph) {
            tot = tot + ph[pk]
            pk = pk + 1
        }
        mean_phis = mean_phis.push(tot / to_float(len(ph)))
        mr = mr + 1
    }

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_axisg_emit_eventcount\",\n"
    s = s + "  \"slug\": \"emit-event-count-substrate-class\",\n"
    s = s + "  \"mining_leaf\": \"L40/L24 emit-as-amplitude-cross-event\",\n"
    s = s + "  \"meta_axis\": \"round 9 — Wolfram class classifier (DISCRETE emit-event-count layer, ⊥ H_654 magnitude)\",\n"
    s = s + "  \"rules\": [30, 54, 90, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"III-additive\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_inhibition\": " + str(_gz()) + ",\n"
    s = s + "  \"thetas\": " + json_arr_f(thetas) + ",\n"
    s = s + "  \"mean_phi_per_rule\": " + json_arr_f(mean_phis) + ",\n"
    s = s + "  \"emit_count_theta_0_5\": " + json_arr_i(counts_by_theta[0]) + ",\n"
    s = s + "  \"emit_count_theta_1_0\": " + json_arr_i(counts_by_theta[1]) + ",\n"
    s = s + "  \"emit_count_theta_2_0\": " + json_arr_i(counts_by_theta[2]) + ",\n"
    s = s + "  \"emit_count_theta_5_0\": " + json_arr_i(counts_by_theta[3]) + ",\n"
    s = s + "  \"emit_count_theta_8_0\": " + json_arr_i(counts_by_theta[4]) + ",\n"
    s = s + "  \"emit_count_theta_11_0\": " + json_arr_i(counts_by_theta[5]) + ",\n"
    s = s + "  \"m1_rule110_max\": " + str(m1f) + ",\n"
    s = s + "  \"m2_rule90_zero\": " + str(m2f) + ",\n"
    s = s + "  \"m3_complex_gt_particle\": " + str(m3f) + ",\n"
    s = s + "  \"m4_bound_det\": " + str(m4f) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"
    write_file("UNIVERSE/state/h_axisg_emit_eventcount_2026_05_29/result.json", s)
    println("wrote result.json")
}
