import "/Users/ghost/core/anima/UNIVERSE/lib/phi_helper.hexa"

// ── config (deterministic, frozen) ──────────────────────────────────────
fn _N() -> int    { return 16 }   // lattice cells — LIFE-lane canonical (phi_helper)
fn _DIM() -> int  { return 12 }   // recorded steps  — LIFE-lane canonical
fn _WARM() -> int { return 8 }    // warmup discard  — LIFE-lane canonical
fn _N_SCALE() -> int { return 6 } // cosmic-web / cluster / stellar / planetary / bio / neural

fn _OUT_JSON() -> string {
    return "/Users/ghost/core/anima/UNIVERSE/state/h002_universe_phi_nested_2026_05_25/result_c2.json"
}

// ── 6 cosmic scales (nested hierarchy, sparse → dense connectivity) ──────
// Each scale s is a toy CA substrate with:
//   rule_s    : a Wolfram elementary-CA rule chosen to span dynamical classes
//               (Class I/II/III/IV) so the hierarchy is NOT a single attractor.
//   couple_s  : a spatial-coupling strength encoding the scale's connectivity
//               regime (cosmic web filaments = sparse; neural = dense).
// Provenance (toy, NOT cosmology): the ORDERING (cosmic→neural) is the nested
// hierarchy of H2.2; the rule/coupling values are a deterministic spread, not
// fitted to any datum. F-C2-NEST-1 asks ONLY: is proxy-Φ scale-invariant?
fn _scale_name(s: int) -> string {
    if s == 0 { return "cosmic_web" }
    if s == 1 { return "galaxy_cluster" }
    if s == 2 { return "stellar" }
    if s == 3 { return "planetary" }
    if s == 4 { return "biological" }
    return "neural"
}
fn _scale_rule(s: int) -> int {
    // span dynamical classes across the nested hierarchy:
    //   cosmic_web 30 (Class III chaotic filaments), cluster 110 (Class IV),
    //   stellar 90 (Class III fractal), planetary 54 (Class IV), biological 110
    //   (Class IV living), neural 110 (Class IV integrated). Class-IV dominates
    //   the "living/integrated" tail by design (edge-of-chaos, H_007 carry).
    if s == 0 { return 30 }
    if s == 1 { return 110 }
    if s == 2 { return 90 }
    if s == 3 { return 54 }
    if s == 4 { return 110 }
    return 110
}
fn _scale_couple(s: int) -> float {
    // connectivity regime: sparse (cosmic web) → dense (neural), monotone.
    if s == 0 { return 0.00 }   // cosmic web — filamentary, near-uncoupled slice
    if s == 1 { return 0.10 }   // galaxy cluster
    if s == 2 { return 0.20 }   // stellar
    if s == 3 { return 0.30 }   // planetary
    if s == 4 { return 0.45 }   // biological
    return 0.60                 // neural — densest integration
}

// ── small helpers ───────────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }
fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }

// elementary CA next-state from a Wolfram rule byte.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row (canonical seed pattern — site i set iff i%3 != 0).
fn _init_row(row: int, n: int) -> int {
    let mut i = 0
    while i < n {
        let on = (i % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve a length-N periodic elementary CA → flat (n × dim) trajectory farr.
fn _run_ca(rule: int, n: int, dim: int, warm: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut p = 0
        while p < n { let _ = farr_set(row, p, farr_get(nxt, p)); p = p + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// spatial-coupling smoothing (connectivity regime). couple=0 → identity.
//   states'[s,t] = (1-k)·states[s,t] + (k/2)·(states[s-1,t] + states[s+1,t])
fn _apply_couple(states: int, n: int, dim: int, k_couple: float) -> int {
    if k_couple <= 0.0 { return 1 }
    let total = n * dim
    let tmp = farr_zeros(total)
    let mut i = 0
    while i < total { let _ = farr_set(tmp, i, farr_get(states, i)); i = i + 1 }
    let half  = k_couple / 2.0
    let one_m = 1.0 - k_couple
    let mut s = 0
    while s < n {
        let lj = (s + n - 1) % n
        let rj = (s + 1) % n
        let mut t = 0
        while t < dim {
            let v = one_m * farr_get(tmp, s * dim + t)
                  + half  * (farr_get(tmp, lj * dim + t) + farr_get(tmp, rj * dim + t))
            let _ = farr_set(states, s * dim + t, v)
            t = t + 1
        }
        s = s + 1
    }
    let _ = farr_free(tmp)
    return 1
}

// measure proxy-Φ for one cosmic scale (CA evolve → coupling → phi_spatial).
//   Φ via the LIFE-lane canonical home phi_with (== c_measure_phi == RFC036).
fn _phi_at_scale(s: int) -> float {
    let n   = _N()
    let dim = _DIM()
    let states = _run_ca(_scale_rule(s), n, dim, _WARM())
    let _ = _apply_couple(states, n, dim, _scale_couple(s))
    let phi = phi_with(states, n, dim, life_phi_nbins())
    let _ = farr_free(states)
    return phi
}

// ── float → fixed-precision string (6 dp, deterministic) ───────
fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true  v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn main() {
    println("================================================================")
    println("  H_002 Cycle #2 — C2 (Φ_universe nested) proxy measurement")
    println("  deterministic · hexa-only · $0 mac local · LLM none · NO GPU")
    println("  Φ via phi_spatial proxy (RFC 036) — lane-canonical home")
    println("================================================================")
    println("  6 cosmic scales (sparse→dense): cosmic_web → galaxy_cluster →")
    println("  stellar → planetary → biological → neural")
    println("")

    // measure Φ at each scale + accumulate mean.
    let phis = farr_zeros(_N_SCALE())
    let mut sum = 0.0
    let mut all_positive = true
    let mut ledger = ""
    let mut first = true
    let mut s = 0
    while s < _N_SCALE() {
        let phi = _phi_at_scale(s)
        let _ = farr_set(phis, s, phi)
        sum = sum + phi
        if phi <= 0.0 { all_positive = false }

        let row = "    {\"scale\": \"" + _scale_name(s) + "\""
            + ", \"rule\": " + str(_scale_rule(s))
            + ", \"couple\": " + _f6(_scale_couple(s))
            + ", \"phi\": " + _f6(phi) + "}"
        if first { ledger = row  first = false }
        else { ledger = ledger + ",\n" + row }

        println("  [" + _scale_name(s) + "]  rule=" + str(_scale_rule(s))
            + "  couple=" + _f6(_scale_couple(s)) + "  Φ=" + _f6(phi))
        s = s + 1
    }
    let mean = sum / (_N_SCALE() * 1.0)

    // CV = stddev / mean across scales (scale-invariance measure).
    let mut ss = 0.0
    let mut k = 0
    while k < _N_SCALE() {
        let d = farr_get(phis, k) - mean
        ss = ss + d * d
        k = k + 1
    }
    let variance = ss / (_N_SCALE() * 1.0)
    let stddev = sqrt(variance)
    let mut cv = 0.0
    if mean > 0.0 { cv = stddev / mean }

    // min / max for spread reporting.
    let mut phi_min = farr_get(phis, 0)
    let mut phi_max = farr_get(phis, 0)
    let mut m = 1
    while m < _N_SCALE() {
        let v = farr_get(phis, m)
        if v < phi_min { phi_min = v }
        if v > phi_max { phi_max = v }
        m = m + 1
    }

    // ── F-C2-NEST-1 SCALE-INVARIANT: CV ≤ 0.15 → invariant → C2 MET ──
    let cv_thr = 0.15
    let scale_invariant = cv <= cv_thr
    let mut f1_verdict = "SCALE_VARIANT"
    if scale_invariant { f1_verdict = "SCALE_INVARIANT" }

    // ── F-C2-NEST-2 POSITIVE: every scale Φ > 0 ──
    let f2_verdict = if all_positive { "ALL_POSITIVE" } else { "ZERO_FOUND" }

    // ── F-C2-NEST-3 DETERMIN: re-measure scale 0 byte-identical ──
    let phi0_a = _phi_at_scale(0)
    let phi0_b = _phi_at_scale(0)
    let f3_determ = phi0_a == phi0_b
    let f3_verdict = if f3_determ { "PASS" } else { "FAIL" }

    // ── F-C2-NEST-4 MONOTONE-PROBE: densest scale (neural, couple 0.6)
    //     should not collapse Φ to 0 (proxy responds to coupling) ──
    let phi_neural = farr_get(phis, _N_SCALE() - 1)
    let f4_probe = phi_neural > 0.0
    let f4_verdict = if f4_probe { "PASS" } else { "FAIL" }

    // C2 verdict: MET iff scale-invariant AND all-positive (nested existence).
    let c2_met = scale_invariant && all_positive
    let mut verdict_class = "C2_SCALE_VARIANT_F2_TRIGGERED"
    if c2_met { verdict_class = "C2_NESTED_SCALE_INVARIANT_MET" }

    println("")
    println("  ----------------------------------------------------------------")
    println("  Φ across 6 scales:  mean=" + _f6(mean)
            + "  min=" + _f6(phi_min) + "  max=" + _f6(phi_max))
    println("  stddev=" + _f6(stddev) + "  CV=" + _f6(cv)
            + "  (threshold " + _f6(cv_thr) + ")")
    println("")
    println("  FALSIFIERS (this cycle, additive):")
    println("    F-C2-NEST-1 SCALE-INV : CV " + _f6(cv) + " <= " + _f6(cv_thr)
            + " ? -> " + f1_verdict)
    println("    F-C2-NEST-2 POSITIVE  : " + f2_verdict + " (nested existence)")
    println("    F-C2-NEST-3 DETERMIN  : " + f3_verdict
            + "  (Φ_scale0 a=" + _f6(phi0_a) + " b=" + _f6(phi0_b) + ")")
    println("    F-C2-NEST-4 MONOTONE  : " + f4_verdict
            + "  (neural Φ=" + _f6(phi_neural) + " > 0)")
    println("  ----------------------------------------------------------------")
    println("")
    println("  C2 VERDICT: " + verdict_class)
    println("  INTERPRETATION (honest): proxy-Φ of the nested toy hierarchy is")
    if c2_met {
        println("  scale-INVARIANT (CV <= 0.15) — H2.2 nested-Φ direction SUPPORTED")
        println("  on the proxy substrate (NOT exact IIT4 Φ★; see honest limits).")
    } else {
        println("  scale-VARIANT (CV > 0.15) — frozen F2 TRIGGERED direction:")
        println("  proxy-Φ does NOT emerge scale-invariant across the hierarchy.")
    }

    // ─── result_c2.json ─────────────────────────────────────────
    let js = "{\n"
        + "  \"hypothesis\": \"H_002\",\n"
        + "  \"cycle\": \"Cycle_2_C2_phi_universe_nested\",\n"
        + "  \"date\": \"2026-05-25\",\n"
        + "  \"deterministic\": true,\n"
        + "  \"hexa_only\": true,\n"
        + "  \"llm\": \"none\",\n"
        + "  \"gpu\": false,\n"
        + "  \"gpu_path\": \"local_mac_cpu_phi_spatial_proxy ($0)\",\n"
        + "  \"phi_primitive\": \"phi_spatial RFC036 proxy (NOT exact IIT4 phi-star)\",\n"
        + "  \"n_scales\": " + str(_N_SCALE()) + ",\n"
        + "  \"lattice\": {\"n\": " + str(_N()) + ", \"dim\": " + str(_DIM())
            + ", \"warm\": " + str(_WARM()) + ", \"n_bins\": " + str(life_phi_nbins()) + "},\n"
        + "  \"per_scale_ledger\": [\n"
        + ledger + "\n"
        + "  ],\n"
        + "  \"phi_mean\": " + _f6(mean) + ",\n"
        + "  \"phi_min\": " + _f6(phi_min) + ",\n"
        + "  \"phi_max\": " + _f6(phi_max) + ",\n"
        + "  \"phi_stddev\": " + _f6(stddev) + ",\n"
        + "  \"phi_cv\": " + _f6(cv) + ",\n"
        + "  \"cv_threshold\": " + _f6(cv_thr) + ",\n"
        + "  \"falsifiers\": {\n"
        + "    \"F_C2_NEST_1_scale_invariant\": \"" + f1_verdict + "\",\n"
        + "    \"F_C2_NEST_2_positive\": \"" + f2_verdict + "\",\n"
        + "    \"F_C2_NEST_3_determ\": \"" + f3_verdict + "\",\n"
        + "    \"F_C2_NEST_4_monotone\": \"" + f4_verdict + "\"\n"
        + "  },\n"
        + "  \"c2_met\": " + _bool_str(c2_met) + ",\n"
        + "  \"verdict_class\": \"" + verdict_class + "\",\n"
        + "  \"frozen_F2_status\": \"" + (if c2_met { "NOT_TRIGGERED (proxy nested-Φ scale-invariant)" } else { "TRIGGERED direction (proxy nested-Φ scale-variant)" }) + "\"\n"
        + "}\n"

    write_file(_OUT_JSON(), js)
    println("")
    println("  result_c2.json written: " + _OUT_JSON())
    println("  C2_VERDICT=" + verdict_class + "  CV=" + _f6(cv)
            + "  F-C2-NEST-1=" + f1_verdict)
}

// `fn main()` is auto-invoked by hexa-strict — no explicit call needed.
