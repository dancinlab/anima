// ════════════════════════════════════════════════════════════════════════════
//  run_h018_c2.hexa — H_018 C2 ORGANIC merge/split RATE smoke (raw#15 additive)
//
//  QUESTION (C2 — extends H_018 Cycle#1 genesis)
//    Cycle#1 measured FORCED-trigger genesis: a single SELFFEED / DRIVE seed
//    is fed and the substrate is observed for split bootstrap. C2 asks a
//    distinct question: under DEFAULT dynamics with NO external forced trigger
//    (selffeed loop only — the substrate-native idle regime), does the
//    substrate ORGANICALLY (self-spontaneously) merge AND split, and does the
//    organic event RATE depend on the closure regime?
//
//  ORGANIC ≡ no external drive injected per step. The ONLY perturbations are
//    (a) primordial init + (b) the internal Lorenz autonomous chaos hook
//    (_mit_inject_autonomous_perturbation) + (c) the self-reference loop
//    (x_{t+1} = combined output of step t). This is exactly the substrate's
//    default idle dynamics — no environment context is supplied.
//
//  CLOSURE REGIME k (the C2 lever)
//    "Closure" = how strongly the substrate maintains its organizational
//    boundary (autopoietic closure, H_012 sister). We expose it as a single
//    scalar k in [0,1] that modulates the merge/split predicates of the
//    cell pool AFTER init (the lib returns a mutable dict):
//      - LOOSE  (k=0.2): low patience + permissive merge_threshold → the
//                        substrate readily reorganizes → HIGH organic rate.
//      - TIGHT  (k=0.8): high patience + strict merge_threshold → the
//                        substrate resists reorganization → LOW organic rate.
//    k maps monotonically: split_patience = round(1 + 7k), merge_patience =
//    round(5 + 35k), merge_threshold = 0.001 + 0.02*(1-k) (looser k ⇒ larger
//    merge window so near-identical cells merge sooner). The genesis split
//    predicate (tension > adaptive_thr) is UNCHANGED — only its patience.
//
//  SWEEP   k ∈ {0.2 loose, 0.8 tight} × steps ∈ {50, 100}.  d=8, 2-cell init.
//  MEASURE per (k, steps): organic_merge_count, organic_split_count, total
//          organic events, rate = total / steps, trajectory.
//
//  CRITERIA (pre-registered)
//    C2.1 SPONTANEOUS : under default dynamics organic (merge+split) events
//                       > 0 in at least one regime (substrate self-energizes).
//    C2.2 REGIME-DEP  : organic rate depends on closure regime — loose != tight
//                       (at matched step horizon; rate strictly differs).
//    C2.3 DETERMINISM : cross-process re-run byte-equal (checked OUT of band
//                       via sha256 of result.json; in-process repeat is NOT a
//                       determinism test — RFC 033 single global gauss stream).
//    C2 PASS = C2.1 AND C2.2.   PARTIAL = exactly one of C2.1/C2.2.
//    FAIL    = neither (no organic events anywhere — substrate fully inert
//              under default dynamics, a strong p5 NO-SPEAK alignment finding).
//
//  DETERMINISM   __HEXA_FARR_GAUSS_SEED__=42 (RFC 033) · HEXA_MEM_UNLIMITED=1.
//  $0 mac local · hexa-only · LLM none · NO ckpt (pure substrate dynamics).
//
//  FALSIFIERS (measurable, ledger-backed)
//    F-C2-1 SPONTANEOUS  : ALL regimes total organic events = 0 → C2.1 FALSIFIED.
//    F-C2-2 REGIME-DEP   : loose.rate == tight.rate at every horizon → C2.2 FALSIFIED.
//    F-C2-3 BOTH-CHANNELS: organic split_count = 0 AND merge_count = 0 across
//                          all regimes → both organic channels silent.
//    F-C2-4 BOUNDS       : any final_cells outside [2,128] → CB1 invariant violated.
//    F-C2-5 RATE-SIGN    : organic rate < 0 or non-finite anywhere → ledger bug.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


// state dir is resolved relative to CWD (the worktree root); import is the
// canonical shared-lib absolute path (read-only).
fn _state_dir() -> string {
    return "UNIVERSE/state/h018_c2_organic_rate_2026_05_25"
}
fn _d_model() -> int { return 8 }
fn _init_cells() -> int { return 2 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn _const_vec(n: int, v: float) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(v)
        i = i + 1
    }
    return a
}

fn _round_int(x: float) -> int {
    return floor(x + 0.5).to_int()
}

fn _int_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}


// ── one organic-dynamics condition ───────────────────────────────────────────
// k:     closure scalar in [0,1] (loose→tight).
// steps: horizon.
// Default dynamics, NO external forced trigger: selffeed loop only. The pool's
// merge/split predicate permissiveness is set from k AFTER init.
fn _run_organic(k: float, steps: int) {
    let d = _d_model()
    let mut pool = cell_pool_init(d, _init_cells())

    // ── closure regime k → predicate knobs (monotone in k) ──────────────────
    // loose k=0.2 : split_patience≈2, merge_patience≈12, merge_thr≈0.017
    // tight k=0.8 : split_patience≈7, merge_patience≈33, merge_thr≈0.005
    let sp = _round_int(1.0 + 7.0 * k)
    let mp = _round_int(5.0 + 35.0 * k)
    let mthr = 0.001 + 0.02 * (1.0 - k)
    pool["split_patience"] = sp
    pool["merge_patience"] = mp
    pool["merge_threshold"] = mthr

    // ORGANIC seed = primordial cell-0 own hidden state (NOT external context).
    // After step 0 the input is the substrate's own combined output (selffeed
    // loop). No environment vector is ever injected.
    let mut x = pool["cells"][0]["hidden"]

    let mut traj = []
    let mut organic_splits = 0
    let mut organic_merges = 0
    let mut first_split = -1
    let mut first_merge = -1

    let mut step = 0
    while step < steps {
        let res = mitosis_forward_tail(x, pool, step)
        let x_out = res[0]
        pool = res[1]
        let evts = res[2]

        let mut e = 0
        while e < len(evts) {
            let et = to_string(evts[e]["type"])
            if et == "split" {
                organic_splits = organic_splits + 1
                if first_split < 0 { first_split = step }
            }
            if et == "merge" {
                organic_merges = organic_merges + 1
                if first_merge < 0 { first_merge = step }
            }
            e = e + 1
        }
        traj.push(len(pool["cells"]))

        // selffeed: default idle dynamics — next input = own output.
        x = x_out
        step = step + 1
    }

    let total = organic_splits + organic_merges
    let rate = (total * 1.0) / (steps * 1.0)

    return #{
        "k":              k,
        "steps":          steps,
        "split_patience": sp,
        "merge_patience": mp,
        "merge_threshold":mthr,
        "organic_splits": organic_splits,
        "organic_merges": organic_merges,
        "total_events":   total,
        "rate":           rate,
        "first_split":    first_split,
        "first_merge":    first_merge,
        "final_cells":    len(pool["cells"]),
        "phi":            pool["phi"],
        "traj":           traj
    }
}


fn _cond_line(tag: string, r) -> string {
    return tag + " k=" + to_string(r["k"]) + " steps=" + to_string(r["steps"])
        + " splits=" + to_string(r["organic_splits"])
        + " merges=" + to_string(r["organic_merges"])
        + " total=" + to_string(r["total_events"])
        + " rate=" + to_string(r["rate"])
        + " final_cells=" + to_string(r["final_cells"])
        + " phi=" + to_string(r["phi"])
}


fn _cond_json(key: string, r) -> string {
    let mut j = "    \"" + key + "\": { "
    j = j + "\"k\": " + to_string(r["k"]) + ", "
    j = j + "\"steps\": " + to_string(r["steps"]) + ", "
    j = j + "\"split_patience\": " + to_string(r["split_patience"]) + ", "
    j = j + "\"merge_patience\": " + to_string(r["merge_patience"]) + ", "
    j = j + "\"merge_threshold\": " + to_string(r["merge_threshold"]) + ", "
    j = j + "\"organic_splits\": " + to_string(r["organic_splits"]) + ", "
    j = j + "\"organic_merges\": " + to_string(r["organic_merges"]) + ", "
    j = j + "\"total_events\": " + to_string(r["total_events"]) + ", "
    j = j + "\"rate\": " + to_string(r["rate"]) + ", "
    j = j + "\"first_split\": " + to_string(r["first_split"]) + ", "
    j = j + "\"first_merge\": " + to_string(r["first_merge"]) + ", "
    j = j + "\"final_cells\": " + to_string(r["final_cells"]) + ", "
    j = j + "\"phi\": " + to_string(r["phi"]) + ", "
    j = j + "\"traj\": " + _int_arr_json(r["traj"]) + " }"
    return j
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h018_c2() {
    println("================================================================")
    println("H_018 C2 — ORGANIC merge/split rate under default dynamics")
    println("  d_model=" + to_string(_d_model()) + " init_cells=" + to_string(_init_cells())
            + " forced-trigger=OFF (selffeed idle) seed=42")
    println("  sweep: k in {0.2 loose, 0.8 tight} x steps in {50, 100}")
    println("================================================================")

    let loose50  = _run_organic(0.2, 50)
    let tight50  = _run_organic(0.8, 50)
    let loose100 = _run_organic(0.2, 100)
    let tight100 = _run_organic(0.8, 100)

    println(_cond_line("LOOSE50 ", loose50))
    println(_cond_line("TIGHT50 ", tight50))
    println(_cond_line("LOOSE100", loose100))
    println(_cond_line("TIGHT100", tight100))

    // ── falsifiers ──────────────────────────────────────────────────────────
    // F-C2-1 SPONTANEOUS: any regime has > 0 total organic events.
    let any_events = (loose50["total_events"] > 0) || (tight50["total_events"] > 0)
                  || (loose100["total_events"] > 0) || (tight100["total_events"] > 0)

    // F-C2-2 REGIME-DEP: loose rate != tight rate at a matched horizon.
    let dep50  = loose50["rate"] != tight50["rate"]
    let dep100 = loose100["rate"] != tight100["rate"]
    let regime_dep = dep50 || dep100

    // F-C2-3 BOTH-CHANNELS: at least one split AND at least one merge organic.
    let total_splits = loose50["organic_splits"] + tight50["organic_splits"]
                     + loose100["organic_splits"] + tight100["organic_splits"]
    let total_merges = loose50["organic_merges"] + tight50["organic_merges"]
                     + loose100["organic_merges"] + tight100["organic_merges"]
    let both_channels = (total_splits > 0) && (total_merges > 0)

    // F-C2-4 BOUNDS.
    let bounds = (loose50["final_cells"]  >= 2) && (loose50["final_cells"]  <= 128)
              && (tight50["final_cells"]  >= 2) && (tight50["final_cells"]  <= 128)
              && (loose100["final_cells"] >= 2) && (loose100["final_cells"] <= 128)
              && (tight100["final_cells"] >= 2) && (tight100["final_cells"] <= 128)

    // F-C2-5 RATE-SIGN: rates finite and >= 0.
    let rate_ok = (loose50["rate"]  >= 0.0) && (tight50["rate"]  >= 0.0)
               && (loose100["rate"] >= 0.0) && (tight100["rate"] >= 0.0)

    let f1 = any_events
    let f2 = regime_dep
    let f3 = both_channels
    let f4 = bounds
    let f5 = rate_ok

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    // C2 PASS = C2.1 (spontaneous) AND C2.2 (regime-dep).
    let c2_pass = f1 && f2
    let c2_partial = (f1 || f2) && !c2_pass
    let verdict = if c2_pass { "PASS" }
                  else { if c2_partial { "PARTIAL" } else { "FAIL" } }

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_018\",\n"
    j = j + "  \"criterion\": \"C2\",\n"
    j = j + "  \"slug\": \"h018-c2-organic-rate\",\n"
    j = j + "  \"title\": \"organic merge/split rate under default dynamics\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"seed\": 42,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"raw_protocol\": \"raw#15 additive (Cycle#1 frozen, C2 appended)\",\n"
    j = j + "  \"d_model\": " + to_string(_d_model()) + ",\n"
    j = j + "  \"init_cells\": " + to_string(_init_cells()) + ",\n"
    j = j + "  \"forced_trigger\": \"OFF (selffeed idle loop, no external drive)\",\n"
    j = j + "  \"closure_k_map\": \"split_patience=round(1+7k), merge_patience=round(5+35k), merge_threshold=0.001+0.02*(1-k)\",\n"
    j = j + "  \"sweep\": {\n"
    j = j + _cond_json("loose_k0.2_steps50",  loose50)  + ",\n"
    j = j + _cond_json("tight_k0.8_steps50",  tight50)  + ",\n"
    j = j + _cond_json("loose_k0.2_steps100", loose100) + ",\n"
    j = j + _cond_json("tight_k0.8_steps100", tight100) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F_C2_1_SPONTANEOUS\":  { \"metric\": \"any regime total organic events > 0\", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F_C2_2_REGIME_DEP\":   { \"metric\": \"loose.rate != tight.rate at matched horizon\", \"dep50\": " + (if dep50 { "true" } else { "false" }) + ", \"dep100\": " + (if dep100 { "true" } else { "false" }) + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F_C2_3_BOTH_CHANNELS\":{ \"metric\": \"organic split>0 AND merge>0\", \"total_splits\": " + to_string(total_splits) + ", \"total_merges\": " + to_string(total_merges) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F_C2_4_BOUNDS\":       { \"metric\": \"all final_cells in [2,128]\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F_C2_5_RATE_SIGN\":    { \"metric\": \"all rates finite & >= 0\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"c2_sub_criteria\": {\n"
    j = j + "    \"C2_1_spontaneous\": \"" + (if f1 { "MET" } else { "UNMET" }) + "\",\n"
    j = j + "    \"C2_2_regime_dependent\": \"" + (if f2 { "MET" } else { "UNMET" }) + "\",\n"
    j = j + "    \"C2_3_determinism\": \"checked out-of-band via sha256(result.json) cross-process\"\n"
    j = j + "  },\n"
    j = j + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)

    println("")
    println("F-C2-1 SPONTANEOUS   " + v1)
    println("F-C2-2 REGIME-DEP    " + v2 + " (dep50=" + (if dep50 { "T" } else { "F" }) + " dep100=" + (if dep100 { "T" } else { "F" }) + ")")
    println("F-C2-3 BOTH-CHANNELS " + v3 + " (splits=" + to_string(total_splits) + " merges=" + to_string(total_merges) + ")")
    println("F-C2-4 BOUNDS        " + v4)
    println("F-C2-5 RATE-SIGN     " + v5)
    println("================================================================")
    println("C2 VERDICT: " + verdict + "  (" + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")
}


_run_h018_c2()
