// UNIVERSE/state/h354_kuramoto_consensus_2026_05_28/run_h354.hexa
// H_354 — Kuramoto sync τ ↔ hivemind consensus τ alignment (raw#12).
//
//   Question: do multi-substrate (n ≥ 3) consensus latency τ_consensus
//   (rounds-to-agreement) and Kuramoto phase-sync latency τ_sync
//   (steps-to-coherence r ≥ 0.9) align across a coupling sweep?
//
//   Falsifier: τ_consensus and τ_sync are uncorrelated (Pearson |r| < 0.3)
//   or scale-separated (ratio variance across (n, K) cells > 5×).
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - n_substrates ∈ {3, 5, 7}, K ∈ {0.5, 1.0, 2.0, 3.0}  (12 cells)
//     - PER CELL:
//         * Kuramoto: n osc, ω_i 5-quantile cycled (std=1.0), θ_i(0)
//           uniform spread, dt=0.05, integrate up to max=1200 steps.
//           τ_sync = first step s where r(s) >= 0.9, or sentinel max
//           if never reached.
//         * Consensus toy: n nodes, d=8 state vectors (deterministic
//           per-node seed → bounded init divergence), per round each
//           node blends toward the global mean with rate
//           alpha = clamp(K * 0.1, 0.01, 0.95). Round-symmetric blend
//           (matches hive_state_sync semantics: see anima-engines/
//           hive_state_sync.hexa T1-T2 expected exp-decay).
//           τ_consensus = first round R where max_pairwise_dist <= 0.05,
//           or sentinel max=400 if never reached.
//     - Both τ are MEASURABLE wall-step counters on the same coupling
//       axis K; pair (τ_sync_i, τ_consensus_i) for i = 12 cells.
//     - Compute Pearson r across the 12 cells (centered).
//     - Compute ratio τ_consensus / τ_sync per cell; check max/min ≤ 2.
//
//   Toy substitute notice (C3 explicit, see §7 of H_354 doc):
//     The consensus dynamics here is an INLINE toy averaging-based
//     blend — NOT a load of anima-engines/hive_state_sync.hexa (the
//     full hive_bridge module surface requires shared/config/contracts
//     wiring, beyond the scope of this single-file smoke). The dynamics
//     are mathematically equivalent to hive_state_sync's blend rule
//     (theoretical exp-decay of max pairwise distance, see §Theory of
//     hive_state_sync.hexa). Toy substitute = honest declared limit.
// ════════════════════════════════════════════════════════════════════════

fn _state_dir() -> string {
    return "/tmp/u-h354/UNIVERSE/state/h354_kuramoto_consensus_2026_05_28"
}

// ── config ──────────────────────────────────────────────────────────────
fn _MAX_SYNC_STEPS() -> int { return 1200 }
fn _MAX_CONS_ROUNDS() -> int { return 400 }
fn _SYNC_THRESH() -> float { return 0.9 }
fn _CONS_THRESH() -> float { return 0.05 }
fn _DT() -> float { return 0.05 }
fn _OMEGA_STD() -> float { return 1.0 }
fn _D() -> int { return 8 }     // hivemind state dim
fn _TWO_PI() -> float { return 6.283185307179586 }

// ── helpers ─────────────────────────────────────────────────────────────
fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// 5 deterministic z-quantiles of N(0,1), cycled by i%5.
fn _omega_i(i: int) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    return z * _OMEGA_STD()
}

fn _theta0(i: int, n: int) -> float {
    return _TWO_PI() * (i * 1.0) / (n * 1.0)
}

// Kuramoto order parameter r = |Σ exp(i θ_j)| / N
fn _order_param(theta: int, n: int) -> float {
    let mut C = 0.0
    let mut S = 0.0
    let mut i = 0
    while i < n {
        let t = farr_get(theta, i)
        C = C + cos(t)
        S = S + sin(t)
        i = i + 1
    }
    return sqrt(C * C + S * S) / (n * 1.0)
}

// Run Kuramoto with given K, return first step s where r >= thresh, or
// sentinel max_steps if not reached.
fn _kuramoto_tau_sync(n: int, K: float, max_steps: int, thresh: float) -> int {
    let theta = farr_zeros(n)
    let mut i = 0
    while i < n { farr_set(theta, i, _theta0(i, n)); i = i + 1 }

    let dt = _DT()
    let mut tau = max_steps
    let mut found = false
    let mut s = 0
    while s < max_steps {
        // record at start of step s (r at "after s steps" semantics: step 0 = initial state)
        let r = _order_param(theta, n)
        if !found && r >= thresh {
            tau = s
            found = true
        }
        // Euler update
        let next = farr_zeros(n)
        let mut a = 0
        while a < n {
            let theta_a = farr_get(theta, a)
            let mut coupling_sum = 0.0
            let mut b = 0
            while b < n {
                let theta_b = farr_get(theta, b)
                coupling_sum = coupling_sum + sin(theta_b - theta_a)
                b = b + 1
            }
            let omega_a = _omega_i(a)
            let dtheta = omega_a + (K / (n * 1.0)) * coupling_sum
            farr_set(next, a, theta_a + dt * dtheta)
            a = a + 1
        }
        let mut k = 0
        while k < n { farr_set(theta, k, farr_get(next, k)); k = k + 1 }
        farr_free(next)
        s = s + 1
    }
    farr_free(theta)
    return tau
}

// Deterministic per-node init: state[k, j] = sin(2π · (k + 1) · (j + 1) / (n · d))
// — spreads N states across a bounded region with reproducible divergence.
fn _make_state(n: int, d: int) -> int {
    let flat = farr_zeros(n * d)
    let mut k = 0
    while k < n {
        let mut j = 0
        while j < d {
            let arg = _TWO_PI() * ((k + 1) * 1.0) * ((j + 1) * 1.0) / ((n * 1.0) * (d * 1.0))
            farr_set(flat, k * d + j, sin(arg))
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

// Max pairwise L2 distance between node states.
fn _max_pairwise(flat: int, n: int, d: int) -> float {
    let mut max_d = 0.0
    let mut a = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            let mut acc = 0.0
            let mut j = 0
            while j < d {
                let x = farr_get(flat, a * d + j) - farr_get(flat, b * d + j)
                acc = acc + x * x
                j = j + 1
            }
            let dist = sqrt(acc)
            if dist > max_d { max_d = dist }
            b = b + 1
        }
        a = a + 1
    }
    return max_d
}

// One blend round: each node moves alpha toward the global MEAN
// of all node states (= symmetric pairwise blending limit; matches
// the hive_state_sync exp-decay theory in the limit of all-to-all
// broadcasting).
//   new_state[k, j] = (1 - alpha) * state[k, j] + alpha * mean[j]
fn _blend_round(flat: int, n: int, d: int, alpha: float) -> int {
    // compute mean
    let mean = farr_zeros(d)
    let mut j = 0
    while j < d {
        let mut acc = 0.0
        let mut k = 0
        while k < n {
            acc = acc + farr_get(flat, k * d + j)
            k = k + 1
        }
        farr_set(mean, j, acc / (n * 1.0))
        j = j + 1
    }
    // update each node
    let out = farr_zeros(n * d)
    let mut k2 = 0
    while k2 < n {
        let mut jj = 0
        while jj < d {
            let s = farr_get(flat, k2 * d + jj)
            let m = farr_get(mean, jj)
            let v = (1.0 - alpha) * s + alpha * m
            farr_set(out, k2 * d + jj, v)
            jj = jj + 1
        }
        k2 = k2 + 1
    }
    farr_free(mean)
    return out
}

// Run consensus blend; return first round R where max_pairwise <= thresh,
// or sentinel max_rounds.
fn _consensus_tau(n: int, alpha: float, max_rounds: int, thresh: float) -> int {
    let mut state = _make_state(n, _D())
    let mut tau = max_rounds
    let mut found = false
    let mut r = 0
    while r < max_rounds {
        let dist = _max_pairwise(state, n, _D())
        if !found && dist <= thresh {
            tau = r
            found = true
        }
        let nxt = _blend_round(state, n, _D(), alpha)
        farr_free(state)
        state = nxt
        r = r + 1
    }
    farr_free(state)
    return tau
}

// alpha(K) bridge: linear with K, clamped to (0.01, 0.95).
fn _alpha_of_K(K: float) -> float {
    let mut a = K * 0.1
    if a < 0.01 { a = 0.01 }
    if a > 0.95 { a = 0.95 }
    return a
}

// Pearson correlation over n_pts.
fn _pearson(xs: int, ys: int, n_pts: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n_pts {
        sx = sx + farr_get(xs, i)
        sy = sy + farr_get(ys, i)
        i = i + 1
    }
    let mx = sx / (n_pts * 1.0)
    let my = sy / (n_pts * 1.0)
    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n_pts {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom = sqrt(dx2 * dy2)
    if denom <= 0.0 { return 0.0 }
    return num / denom
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict_str(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_354 — Kuramoto sync τ ↔ hivemind consensus τ alignment (raw#12)")
    println("  n_substrates ∈ {3, 5, 7}, K ∈ {0.5, 1.0, 2.0, 3.0}")
    println("  τ_sync : steps until Kuramoto order param r >= 0.9 (max " + to_string(_MAX_SYNC_STEPS()) + ")")
    println("  τ_consensus: rounds until max_pairwise_dist <= 0.05 (max " + to_string(_MAX_CONS_ROUNDS()) + ")")
    println("  alpha(K) = clamp(K * 0.1, 0.01, 0.95)")
    println("  toy substitute: inline blend-to-mean consensus (hive_state_sync semantics, no module load)")
    println("")

    let ns = farr_zeros(3)
    farr_set(ns, 0, 3.0); farr_set(ns, 1, 5.0); farr_set(ns, 2, 7.0)
    let Ks = farr_zeros(4)
    farr_set(Ks, 0, 0.5); farr_set(Ks, 1, 1.0); farr_set(Ks, 2, 2.0); farr_set(Ks, 3, 3.0)

    let n_cells = 12   // 3 × 4
    let tau_sync_arr = farr_zeros(n_cells)
    let tau_cons_arr = farr_zeros(n_cells)
    let K_log        = farr_zeros(n_cells)
    let n_log        = farr_zeros(n_cells)

    println("  cell |  n  |   K  |  alpha  | τ_sync | τ_cons | ratio (cons/sync)")
    println("  -----+-----+------+---------+--------+--------+------------------")

    let mut idx = 0
    let mut ni = 0
    while ni < 3 {
        let n_sub_f = farr_get(ns, ni)
        let n_sub = n_sub_f as int  // 3, 5, 7
        let mut ki = 0
        while ki < 4 {
            let K = farr_get(Ks, ki)
            let alpha = _alpha_of_K(K)
            let tau_s = _kuramoto_tau_sync(n_sub, K, _MAX_SYNC_STEPS(), _SYNC_THRESH())
            let tau_c = _consensus_tau(n_sub, alpha, _MAX_CONS_ROUNDS(), _CONS_THRESH())
            farr_set(tau_sync_arr, idx, tau_s * 1.0)
            farr_set(tau_cons_arr, idx, tau_c * 1.0)
            farr_set(K_log, idx, K)
            farr_set(n_log, idx, n_sub_f)
            let ratio = if tau_s > 0 { (tau_c * 1.0) / (tau_s * 1.0) } else { 0.0 }
            println("   " + to_string(idx) + "   |  " + to_string(n_sub) + "  |  " + to_string(K) + "  |  " + to_string(alpha) + "  |  " + to_string(tau_s) + "  |  " + to_string(tau_c) + "  |  " + to_string(ratio))
            idx = idx + 1
            ki = ki + 1
        }
        ni = ni + 1
    }

    // ── Pearson correlation ──────────────────────────────────────────────
    let r = _pearson(tau_sync_arr, tau_cons_arr, n_cells)

    // ── ratio variance (max/min across cells) ────────────────────────────
    let mut min_ratio = 1.0e18
    let mut max_ratio = 0.0 - 1.0e18
    let mut k = 0
    while k < n_cells {
        let ts = farr_get(tau_sync_arr, k)
        let tc = farr_get(tau_cons_arr, k)
        if ts > 0.0 {
            let ra = tc / ts
            if ra < min_ratio { min_ratio = ra }
            if ra > max_ratio { max_ratio = ra }
        }
        k = k + 1
    }
    let ratio_spread = if min_ratio > 0.0 { max_ratio / min_ratio } else { 0.0 }

    // ── verdict ──────────────────────────────────────────────────────────
    // C1 (correlation): Pearson r > 0.5
    // C2 (ratio constant within 2×): ratio_spread (max/min) <= 2.0
    // SUPPORTED iff C1 ∨ C2 (either path validates alignment)
    // FALSIFIED iff |r| < 0.3 AND ratio_spread > 5.0
    let c1 = r > 0.5
    let c2 = ratio_spread <= 2.0 && ratio_spread > 0.0
    let supported = c1 || c2
    let falsified = _abs_f(r) < 0.3 && ratio_spread > 5.0
    let verdict = if supported { "SUPPORTED" } else { if falsified { "FALSIFIED" } else { "PARTIAL" } }

    println("")
    println("  Pearson r (τ_sync, τ_cons) = " + to_string(r))
    println("  ratio (τ_cons / τ_sync) min = " + to_string(min_ratio) + "  max = " + to_string(max_ratio))
    println("  ratio spread (max/min)     = " + to_string(ratio_spread))
    println("")
    println("  C1 Pearson r > 0.5                    : " + _bool_str(c1))
    println("  C2 ratio spread <= 2× (constant)      : " + _bool_str(c2))
    println("")
    println("  VERDICT_RULE: SUPPORTED iff C1 ∨ C2; FALSIFIED iff |r|<0.3 ∧ spread>5×")
    println("  VERDICT     : " + verdict)

    // ── write result.json ────────────────────────────────────────────────
    let mut o = "{\n"
    o = o + "  \"id\": \"H_354\",\n"
    o = o + "  \"slug\": \"kuramoto-hivemind-sync-tau\",\n"
    o = o + "  \"date\": \"2026-05-28\",\n"
    o = o + "  \"deterministic\": true,\n"
    o = o + "  \"hexa_only\": true,\n"
    o = o + "  \"llm\": \"none\",\n"
    o = o + "  \"cost\": \"$0 mac local\",\n"
    o = o + "  \"toy_substitute\": true,\n"
    o = o + "  \"toy_substitute_note\": \"inline blend-to-mean consensus dynamics (mathematically equivalent to hive_state_sync.hexa exp-decay theory); module not loaded to avoid hive_bridge wiring overhead\",\n"
    o = o + "  \"config\": {\n"
    o = o + "    \"n_substrates_grid\": [3, 5, 7],\n"
    o = o + "    \"K_grid\": [0.5, 1.0, 2.0, 3.0],\n"
    o = o + "    \"max_sync_steps\": " + to_string(_MAX_SYNC_STEPS()) + ",\n"
    o = o + "    \"max_cons_rounds\": " + to_string(_MAX_CONS_ROUNDS()) + ",\n"
    o = o + "    \"sync_threshold_r\": " + to_string(_SYNC_THRESH()) + ",\n"
    o = o + "    \"consensus_threshold_dist\": " + to_string(_CONS_THRESH()) + ",\n"
    o = o + "    \"dt\": " + to_string(_DT()) + ",\n"
    o = o + "    \"d_state\": " + to_string(_D()) + ",\n"
    o = o + "    \"omega_std\": " + to_string(_OMEGA_STD()) + ",\n"
    o = o + "    \"alpha_bridge\": \"clamp(K * 0.1, 0.01, 0.95)\"\n"
    o = o + "  },\n"
    o = o + "  \"cells\": [\n"
    let mut p = 0
    while p < n_cells {
        o = o + "    { \"n\": " + to_string((farr_get(n_log, p)) as int)
              + ", \"K\": " + to_string(farr_get(K_log, p))
              + ", \"tau_sync\": " + to_string((farr_get(tau_sync_arr, p)) as int)
              + ", \"tau_cons\": " + to_string((farr_get(tau_cons_arr, p)) as int) + " }"
        if p < n_cells - 1 { o = o + "," }
        o = o + "\n"
        p = p + 1
    }
    o = o + "  ],\n"
    o = o + "  \"pearson_r\": " + to_string(r) + ",\n"
    o = o + "  \"ratio_min\": " + to_string(min_ratio) + ",\n"
    o = o + "  \"ratio_max\": " + to_string(max_ratio) + ",\n"
    o = o + "  \"ratio_spread\": " + to_string(ratio_spread) + ",\n"
    o = o + "  \"criteria\": {\n"
    o = o + "    \"C1_pearson_gt_0p5\":          { \"value\": " + to_string(r) + ", \"floor\": 0.5, \"verdict\": \"" + _verdict_str(c1) + "\" },\n"
    o = o + "    \"C2_ratio_within_2x\":         { \"value\": " + to_string(ratio_spread) + ", \"ceiling\": 2.0, \"verdict\": \"" + _verdict_str(c2) + "\" }\n"
    o = o + "  },\n"
    o = o + "  \"verdict_rule\": \"SUPPORTED iff C1 (r>0.5) OR C2 (spread<=2x); FALSIFIED iff |r|<0.3 AND spread>5x\",\n"
    o = o + "  \"verdict\": \"" + verdict + "\"\n"
    o = o + "}\n"
    write_file(_state_dir() + "/result.json", o)

    farr_free(ns); farr_free(Ks)
    farr_free(tau_sync_arr); farr_free(tau_cons_arr)
    farr_free(K_log); farr_free(n_log)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_354 Kuramoto ↔ hivemind τ alignment complete: " + verdict + " ===")
}
