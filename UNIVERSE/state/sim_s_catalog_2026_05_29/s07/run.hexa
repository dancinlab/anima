// S07 split — is Φ conserved when a system splits?
// Falsifier: if splitting a whole n=4 (Φ 14.1492) into two n=2 halves conserves
//   Φ, the halves' sum equals the whole. Halves sum 0.20492 << 14.1492 ⇒ Φ is
//   NOT conserved under splitting: most integrated structure is destroyed.
// substrate: ECA rule110, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let whole = max_bigphi(110, 4, I)
    let half = max_bigphi(110, 2, I)
    let pieces = half + half
    print("whole n=4 Phi      = "); println(whole)
    print("each half n=2 Phi  = "); println(half)
    print("pieces sum (2x)    = "); println(pieces)
    let pass = (whole > 14.0) && (pieces < 0.21) && (pieces > 0.20) && (whole > 10.0 * pieces)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
