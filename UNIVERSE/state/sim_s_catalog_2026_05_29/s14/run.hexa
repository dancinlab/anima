// S14 time-scale (x100 acceleration / is Φ time-invariant?).
// Falsifier: if Φ is invariant under temporal coarse-graining, the 2-step TPM
//   (compose rule110 with itself) gives the same max big-Φ as 1-step. It does
//   NOT (14.1492 vs 7.38843) and all 16 states differ ⇒ Φ is time-grain dependent.
// substrate: ECA rule110 n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
// next state of an ECA TPM (deterministic 0/1 entries) given state s.
fn eca_next(t: array, n: int, s: int) -> int {
    let mut ns = 0
    let mut i = 0
    while i < n {
        if t[s * n + i] > 0.5 { ns = ns + iit4_pow2(i) }
        i = i + 1
    }
    return ns
}
// 2-step composed TPM: apply rule twice.
fn compose2(rule: int, n: int) -> array {
    let base = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut t2 = []
    let mut s = 0
    while s < full {
        let s1 = eca_next(base, n, s)        // after 1 step
        let mut i = 0
        while i < n { t2 = t2.push(base[s1 * n + i]); i = i + 1 }   // value after 2nd step
        s = s + 1
    }
    return t2
}
fn max_bigphi_tpm(t: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(t, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let n = 4
    let t1 = scale_tpm(eca_tpm(110, n), 1.0 - I)
    let t2 = scale_tpm(compose2(110, n), 1.0 - I)
    let m1 = max_bigphi_tpm(t1, n)
    let m2 = max_bigphi_tpm(t2, n)
    // count states where 1-step and 2-step per-state big-Φ differ.
    let full = iit4_pow2(n)
    let mut differ = 0
    let mut s = 0
    while s < full {
        let a = big_phi(t1, n, s)[0]
        let b = big_phi(t2, n, s)[0]
        let d = a - b
        if (d > 1.0e-9) || (d < -1.0e-9) { differ = differ + 1 }
        s = s + 1
    }
    print("1-step max big-Phi = "); println(m1)
    print("2-step max big-Phi = "); println(m2)
    print("states differing   = "); print(differ); print("/"); println(full)
    let pass = (m1 > 14.0) && (m2 > 7.0) && (m2 < 8.0) && (differ == full)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
