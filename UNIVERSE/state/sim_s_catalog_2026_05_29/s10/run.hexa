// S10 panpsychism — naive panpsychism closed-negative.
// Falsifier: if uncoupled trivial substrates (IDENTITY/NOT/CONSTANT) carry Φ>0,
//   panpsychism's "matter = consciousness" holds. They yield 0.0; only the
//   irreducibly coupled rule110 carries Φ ⇒ Φ needs causal coupling, not matter.
// substrate: ECA n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    // IDENTITY = rule 204, NOT = rule 51, CONSTANT-0 = rule 0.
    let id_phi = max_bigphi(204, 4, I)
    let not_phi = max_bigphi(51, 4, I)
    let const_phi = max_bigphi(0, 4, I)
    let coupled = max_bigphi(110, 4, I)
    print("uncoupled IDENTITY(r204) Phi = "); println(id_phi)
    print("uncoupled NOT(r51) Phi      = "); println(not_phi)
    print("uncoupled CONSTANT(r0) Phi  = "); println(const_phi)
    print("coupled rule110 Phi         = "); println(coupled)
    let pass = (id_phi < 1.0e-9) && (not_phi < 1.0e-9) && (const_phi < 1.0e-9) && (coupled > 14.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
