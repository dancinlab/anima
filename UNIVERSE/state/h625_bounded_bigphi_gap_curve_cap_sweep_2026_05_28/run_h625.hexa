// UNIVERSE/state/h625_bounded_bigphi_gap_curve_cap_sweep_2026_05_28/run_h625.hexa
//
//   H_625 — bounded-bigΦ ↔ exact-bigΦ gap-curve cap-sweep @ fixed n
//          (UNIVERSE 축 B B2 deferred 회수)
//
//   QUESTION
//     축 B B1 (#H_002 large-N) 가 bounded-bigΦ (cap < n = explicit lower
//     bound) 로 n=8 까지 도달했으나, B2 deferred 항목 — "bounded ↔ exact
//     정량 gap 곡선" — 은 아직 측정되지 않았다. true large-N exact 는
//     super-exp (n=7+ 분 단위 이상) 라 곡선 자체 불가하지만, **cap-sweep @
//     fixed n** 으로 bound-gap 의 형상은 측정 가능하다 (n 고정 + cap=n
//     이 곧 exact, B1 anchor).
//
//   HYPOTHESES
//     H1 (HEADLINE — EXPONENTIAL-DECAY)
//        bounded purview cap k 를 1..n=5 로 sweep 할 때
//          gap(k) := big_phi(exact)  -  big_phi_bounded(cap=k)
//        곡선이 k 에 대해 *지수 감소* 한다 — 즉
//          gap(k) ≈ C · exp(-α·k)   for some α > 0
//        ⇔ 인접 비율 r := gap(k+1) / gap(k) 가 ~상수 (< 1) 이고
//          α = -ln(r) 가 유의미 (단조 + > 0).
//
//   FALSIFIER (frozen 2026-05-28, BEFORE measure)
//     F625.1 MONOTONE-DECREASE — gap(k) 가 k 증가에 따라 (약)단조 감소
//            (gap(k+1) <= gap(k) + eps).
//     F625.2 FAITHFUL-ANCHOR  — cap = n = 5 에서 gap(5) ≈ 0 (cap ≥ n =
//            exact 의 faithful restriction; B1 anchor 재확인).
//     F625.3 EXPONENTIAL-SHAPE — 인접 ratio r = gap(k+1)/gap(k) 가
//            "유의미한 의미에서" < 1 (gap(k) > 0 인 모든 k 에서, 즉
//            ratio 가 1 이상으로 튀지 않음). α = -mean(ln(r)) > 0 이 추출
//            가능. (반대 면: 다항/선형 감소 또는 비단조 → α undefined →
//            H1 FALSIFIED.)
//     F625.4 ALL-NONNEG — 모든 bounded(k) >= 0 AND <= exact (lower-bound
//            성질 유지).
//     F625.5 DETERMINISM — bounded(cap=2) 재실행 동일.
//     F625.6 RULE-COVERAGE — 3 rule {30, 90, 110} 모두에서 H1 행동
//            검사 (rule 의존성 확인).
//
//   METHOD (re-use HEXAD/IIT4/lib + stdlib · g61) — n=5 fixed ring
//     • eca_tpm(rule, 5) → state-by-node TPM (2^5 = 32 states)
//     • single representative state st = 21 (10101) — H_297/H_298 와 동일
//     • cap ∈ {1, 2, 3, 4, 5} sweep, cap=5 = faithful (== exact)
//     • rule ∈ {30, 90, 110} (chaotic · linear-XOR · class-IV)
//     • gap(k) = bounded(cap=5) - bounded(cap=k) — cap=5 = exact anchor
//     • α extract via natural-log on adjacent ratios (Mercator series
//       inline — no libm dependency)
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/u-h625/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn abs_f(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}
fn approx_zero(a: float) -> bool { return abs_f(a) < 0.000001 }
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// natural log via Mercator series ln(1+x) = x - x^2/2 + x^3/3 - ...
// valid for 0 < y < 2 (we scale large y by halving until in range; tracked
// via integer halvings k_half, then add k_half * ln(2).)
// returns ln(y), y > 0.
fn ln_2() -> float { return 0.6931471805599453 }
fn ln_natural(y: float) -> float {
    // halve y down into (0.5, 1.5] range for series convergence
    let mut z = y
    let mut k_half = 0
    while z > 1.5 {
        z = z * 0.5
        k_half = k_half + 1
    }
    // now z in (0, 1.5], use ln(z) = ln(1 + (z-1))
    let x = z - 1.0
    let mut acc = 0.0
    let mut term = x
    let mut i = 1
    // 80 terms — converges geometrically for |x| < 1 (here |x| <= 0.5)
    while i <= 80 {
        // term = x^i ; acc += (-1)^(i+1) * term / i
        let signed = if (i % 2) == 1 { term / to_float(i) } else { 0.0 - term / to_float(i) }
        acc = acc + signed
        term = term * x
        i = i + 1
    }
    return acc + to_float(k_half) * ln_2()
}

// bounded big-Phi @ rule, n=5, st=21, given cap.
fn phi_b(rule: int, cap: int) -> float {
    let tpm = eca_tpm(rule, 5)
    let r = big_phi_bounded(tpm, 5, 21, cap)
    return r[0]
}

// per-rule sweep: returns array of 5 floats = bounded big-Φ at cap=1..5.
fn sweep_rule(rule: int) -> array {
    let mut out = []
    let mut k = 1
    while k <= 5 {
        out = out.push(phi_b(rule, k))
        k = k + 1
    }
    return out
}

// build gap(k) array = exact(=cap5) - bounded(cap=k), length 5 (gap[4]=0).
fn gaps(b: array) -> array {
    let exact_v = b[4]
    let mut g = []
    let mut k = 0
    while k < 5 {
        g = g.push(exact_v - b[k])
        k = k + 1
    }
    return g
}

// monotone non-increasing gap (with tiny tolerance)
fn monotone_gap(g: array) -> bool {
    let mut k = 0
    while k < 4 {
        if g[k + 1] > g[k] + 0.000001 { return false }
        k = k + 1
    }
    return true
}

// all bounded values >= 0 AND <= exact (lower-bound property)
fn nonneg_bounded(b: array) -> bool {
    let exact_v = b[4]
    let mut k = 0
    while k < 5 {
        if b[k] < 0.0 - 0.000001 { return false }
        if b[k] > exact_v + 0.000001 { return false }
        k = k + 1
    }
    return true
}

// α extract: mean of (-ln(r_k)) over consecutive non-zero gap ratios.
// returns (alpha, n_ratios). If <2 valid ratios → alpha = 0, n_ratios = 0.
fn extract_alpha(g: array) -> array {
    let mut sum = 0.0
    let mut cnt = 0
    let mut k = 0
    while k < 3 {                                          // pairs (0,1) (1,2) (2,3)
        let a_g = g[k]
        let b_g = g[k + 1]
        if a_g > 0.000001 {
            if b_g > 0.0 {
                let r = b_g / a_g
                // need 0 < r < 1 for exponential decay
                if r > 0.000001 {
                    let log_r = ln_natural(r)
                    sum = sum + (0.0 - log_r)             // α = -ln(r)
                    cnt = cnt + 1
                }
            } else {
                // b_g essentially zero — treat as one strong-decay sample
                // (skip — only count strict positive-ratio samples for clean α)
            }
        }
        k = k + 1
    }
    let mut alpha_v = 0.0
    if cnt > 0 { alpha_v = sum / to_float(cnt) }
    return [alpha_v, to_float(cnt)]
}

// per-step ratio array (length 4, gap(k+1)/gap(k) at k=0..3); zero if denom zero.
fn ratios(g: array) -> array {
    let mut out = []
    let mut k = 0
    while k < 4 {
        let a_g = g[k]
        let b_g = g[k + 1]
        let mut r = 0.0
        if a_g > 0.000001 { r = b_g / a_g }
        out = out.push(r)
        k = k + 1
    }
    return out
}

fn print_row(label: string, b: array) {
    println("    " + label + ": cap1=" + str(b[0]) + " cap2=" + str(b[1]) + " cap3=" + str(b[2]) + " cap4=" + str(b[3]) + " cap5=" + str(b[4]))
}
fn print_gaps(label: string, g: array) {
    println("    " + label + ": gap@cap1=" + str(g[0]) + " gap@cap2=" + str(g[1]) + " gap@cap3=" + str(g[2]) + " gap@cap4=" + str(g[3]) + " gap@cap5=" + str(g[4]))
}
fn print_ratios(label: string, rr: array) {
    println("    " + label + ": r12=" + str(rr[0]) + " r23=" + str(rr[1]) + " r34=" + str(rr[2]) + " r45=" + str(rr[3]))
}

fn main() {
    println("================================================================")
    println("  H_625 — bounded-bigPhi gap-curve cap-sweep @ fixed n=5")
    println("  state=21 (10101) · rules {30, 90, 110} · cap 1..5 (cap5=exact)")
    println("================================================================")

    // ── ln_natural self-check ────────────────────────────────────────────
    // ln(e) ≈ 1.0 ; ln(2) ≈ 0.693147
    let ln_e_check  = ln_natural(2.718281828459045)
    let ln_2_check  = ln_natural(2.0)
    let ln_4_check  = ln_natural(4.0)
    println("  ln_natural self-check: ln(e)=" + str(ln_e_check) + " ln(2)=" + str(ln_2_check) + " ln(4)=" + str(ln_4_check))
    check("ln_natural(e) ~ 1.0", abs_f(ln_e_check - 1.0) < 0.001)
    check("ln_natural(2) ~ 0.6931", abs_f(ln_2_check - 0.6931471) < 0.001)
    check("ln_natural(4) ~ 1.3863", abs_f(ln_4_check - 1.3862944) < 0.001)

    // ── per-rule sweep ───────────────────────────────────────────────────
    let b30  = sweep_rule(30)
    let b90  = sweep_rule(90)
    let b110 = sweep_rule(110)
    println("  bounded big-Phi (state=21, cap 1..5):")
    print_row("rule  30", b30)
    print_row("rule  90", b90)
    print_row("rule 110", b110)

    // ── gap & ratio & alpha per rule ─────────────────────────────────────
    let g30  = gaps(b30)
    let g90  = gaps(b90)
    let g110 = gaps(b110)
    println("  gap(k) = bounded(cap=5=exact) - bounded(cap=k):")
    print_gaps("rule  30", g30)
    print_gaps("rule  90", g90)
    print_gaps("rule 110", g110)

    let r30  = ratios(g30)
    let r90  = ratios(g90)
    let r110 = ratios(g110)
    println("  adjacent ratio r(k)=gap(k+1)/gap(k):")
    print_ratios("rule  30", r30)
    print_ratios("rule  90", r90)
    print_ratios("rule 110", r110)

    let a30  = extract_alpha(g30)
    let a90  = extract_alpha(g90)
    let a110 = extract_alpha(g110)
    println("  α = -mean(ln(r)) [exponential-decay coefficient]:")
    println("    rule  30 : α=" + str(a30[0])  + " (over n=" + str(a30[1])  + " ratios)")
    println("    rule  90 : α=" + str(a90[0])  + " (over n=" + str(a90[1])  + " ratios)")
    println("    rule 110 : α=" + str(a110[0]) + " (over n=" + str(a110[1]) + " ratios)")

    // ── F625.1 MONOTONE-DECREASE ─────────────────────────────────────────
    let mon30  = monotone_gap(g30)
    let mon90  = monotone_gap(g90)
    let mon110 = monotone_gap(g110)
    check("F625.1 rule 30 gap monotone non-increasing",  mon30)
    check("F625.1 rule 90 gap monotone non-increasing",  mon90)
    check("F625.1 rule 110 gap monotone non-increasing", mon110)

    // ── F625.2 FAITHFUL-ANCHOR (gap(cap=5) == 0) ─────────────────────────
    check("F625.2 rule 30 gap(cap=5) ~ 0 (faithful anchor)",  approx_zero(g30[4]))
    check("F625.2 rule 90 gap(cap=5) ~ 0 (faithful anchor)",  approx_zero(g90[4]))
    check("F625.2 rule 110 gap(cap=5) ~ 0 (faithful anchor)", approx_zero(g110[4]))

    // ── F625.3 EXPONENTIAL-SHAPE — ratios < 1 + α > 0 (over ≥1 ratio) ────
    // "유의미한 의미" = α extraction 가능 (cnt >= 1) AND α > 0
    let exp_30  = (a30[1]  >= 1.0) && (a30[0]  > 0.0)
    let exp_90  = (a90[1]  >= 1.0) && (a90[0]  > 0.0)
    let exp_110 = (a110[1] >= 1.0) && (a110[0] > 0.0)
    check("F625.3 rule 30 exponential-shape (α>0)",  exp_30)
    check("F625.3 rule 90 exponential-shape (α>0)",  exp_90)
    check("F625.3 rule 110 exponential-shape (α>0)", exp_110)

    // ── F625.4 ALL-NONNEG + LOWER-BOUND ──────────────────────────────────
    check("F625.4 rule 30 bounded all >=0 AND <= exact",  nonneg_bounded(b30))
    check("F625.4 rule 90 bounded all >=0 AND <= exact",  nonneg_bounded(b90))
    check("F625.4 rule 110 bounded all >=0 AND <= exact", nonneg_bounded(b110))

    // ── F625.5 DETERMINISM ───────────────────────────────────────────────
    let b30_rerun = phi_b(30, 2)
    check("F625.5 rule 30 cap=2 deterministic re-run identical", abs_f(b30_rerun - b30[1]) < 0.000001)

    // ── F625.6 RULE-COVERAGE — all 3 rules exhibit headline behavior ─────
    let rule_cov = exp_30 && exp_90 && exp_110
    check("F625.6 ALL 3 rules exhibit exponential-shape (rule-coverage)", rule_cov)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  α (rule 30 / 90 / 110) = " + str(a30[0]) + " / " + str(a90[0]) + " / " + str(a110[0]))
    println("================================================================")
    if FAIL > 0 { panic("H_625 bounded-bigPhi gap-curve cap-sweep FAILED") }
}
