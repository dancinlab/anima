// UNIVERSE/state/h291_ethic_emergence_cooperation_2026_05_26/run_h291.hexa
//
//   H_291 — Does cooperation (proto-ethics) EMERGE from spatial structure alone?
//   (AXES.md R2 social `ethic-emergence` — anima Principle #6 NO FINE-TUNED ETHICS)
//
//   QUESTION
//     anima Principle #6 forbids fine-tuning ethics into weights — cooperation must
//     EMERGE from the substrate (cells + structure), not be injected. The cleanest
//     test bed is the spatial Prisoner's Dilemma (Nowak & May 1992): in a WELL-MIXED
//     population defection always wins (Nash = all-defect), but on a LATTICE
//     cooperators survive in clusters. Does spatial STRUCTURE alone rescue
//     cooperation — i.e. does a cooperative attractor emerge with zero built-in
//     ethics, purely from local imitation?
//
//   SEED-HYPOTHESIS H1 (TESTED)
//     A cooperative attractor emerges from spatial structure: on the lattice the
//     final cooperator fraction stays > 0.1 (persists) at moderate temptation b,
//     WHILE the matched well-mixed replicator drives cooperation to ~0 (defect-only).
//     (Falsifier: lattice cooperation also → 0 ⇒ defect attractor only, no emergence.)
//
//   METHOD (self-contained — pure game dynamics, deterministic, no RNG, no lib)
//     PAYOFF (Prisoner's Dilemma, Nowak normalisation): C-C=1 (R), C-D=0 (S),
//       D-C=b (T temptation, b>1), D-D=0 (P). Defection strictly dominates 1-shot.
//     SPATIAL: L×L toroidal lattice, 8-cell Moore neighbourhood. Each round every
//       cell plays all 8 neighbours, sums payoff; then SYNCHRONOUSLY adopts the
//       strategy of the highest-payoff cell among {itself ∪ 8 neighbours} (imitate-
//       best — deterministic, NO ethics, NO reward signal). Initial = deterministic
//       pseudo-pattern (~40% D via hash, NO RNG). Run T steps → final C-fraction.
//     WELL-MIXED: replicator x_{t+1} = x/(x + (1-x)·b)  (mean-field, same payoffs)
//       → deterministically → 0 for b>1.
//     b-sweep {1.1, 1.5, 2.2} (low / mid / high temptation).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26, BEFORE measuring fractions)
//     F291.1 WELL-MIXED-DEFECTS — well-mixed cooperator fraction → < 0.01 for every
//            b>1 (defection wins without structure). (the null baseline)
//     F291.2 SPATIAL-RESCUE (verdict) — at low temptation (b=1.1) the lattice
//            final C-fraction > 0.1 (cooperation PERSISTS / dominates) while well-mixed → ~0.
//            ⇒ cooperative attractor EMERGES from structure (H1). FALSIFIED if
//            lattice C also → 0.
//     F291.3 TEMPTATION-MONOTONE — lattice final C-fraction is non-increasing in b
//            (more temptation ⇒ ≤ cooperation): C(b=1.1) ≥ C(b=1.5) ≥ C(b=2.2).
//     F291.4 BOUND — all fractions ∈ [0,1].
//     F291.5 DETERMINISM — lattice run @ b=1.5 re-run bit-identical C-fraction.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU · NO RNG.
//   honest scope: 8-Moore imitate-best is ONE update rule (Nowak's); toroidal LxL
//     small; single deterministic initial (not an ensemble).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// PD payoff to a player of strategy `me` (0=C,1=D) against `opp` (Nowak: R=1,S=0,T=b,P=0).
fn payoff(me: int, opp: int, b: float) -> float {
    if me == 0 {
        if opp == 0 { return 1.0 }      // C vs C = R
        return 0.0                       // C vs D = S
    }
    if opp == 0 { return b }             // D vs C = T (temptation)
    return 0.0                           // D vs D = P
}

// deterministic pseudo-pattern initial: ~40% defectors, NO RNG.
fn init_grid(l: int) -> array {
    let mut g = []
    let mut r = 0
    while r < l {
        let mut c = 0
        while c < l {
            let h = (r * 7 + c * 13 + 5) % 5
            if h < 2 { g = g.push(1) } else { g = g.push(0) }   // ~40% D
            c = c + 1
        }
        r = r + 1
    }
    return g
}

// total payoff of cell (r,c): self-interaction (Nowak 1992 canonical) + 8 Moore
// neighbours (toroidal). Self-play (C-self=R) is what lets cooperator CLUSTERS
// resist invasion — omitting it collapses the lattice to all-D (see §9 L1).
fn cell_payoff(g: array, l: int, r: int, c: int, b: float) -> float {
    let me = g[r * l + c]
    let mut acc = payoff(me, me, b)                      // self-interaction (Nowak)
    let mut dr = -1
    while dr <= 1 {
        let mut dc = -1
        while dc <= 1 {
            if !((dr == 0) && (dc == 0)) {
                let rr = (r + dr + l) % l
                let cc = (c + dc + l) % l
                acc = acc + payoff(me, g[rr * l + cc], b)
            }
            dc = dc + 1
        }
        dr = dr + 1
    }
    return acc
}

// one synchronous imitate-best update; returns the new grid.
fn step_grid(g: array, l: int, b: float) -> array {
    // precompute every cell's payoff
    let mut pay = []
    let mut i = 0
    while i < l * l { pay = pay.push(0.0); i = i + 1 }
    let mut r = 0
    while r < l {
        let mut c = 0
        while c < l { pay[r * l + c] = cell_payoff(g, l, r, c, b); c = c + 1 }
        r = r + 1
    }
    // each cell adopts the strategy of the best-payoff cell in {self ∪ neighbours}
    let mut ng = []
    let mut k = 0
    while k < l * l { ng = ng.push(0); k = k + 1 }
    r = 0
    while r < l {
        let mut c = 0
        while c < l {
            let mut best_pay = pay[r * l + c]
            let mut best_strat = g[r * l + c]
            let mut dr = -1
            while dr <= 1 {
                let mut dc = -1
                while dc <= 1 {
                    if !((dr == 0) && (dc == 0)) {
                        let rr = (r + dr + l) % l
                        let cc = (c + dc + l) % l
                        if pay[rr * l + cc] > best_pay + 0.000001 {
                            best_pay = pay[rr * l + cc]
                            best_strat = g[rr * l + cc]
                        }
                    }
                    dc = dc + 1
                }
                dr = dr + 1
            }
            ng[r * l + c] = best_strat
            c = c + 1
        }
        r = r + 1
    }
    return ng
}

fn coop_fraction(g: array, l: int) -> float {
    let mut c = 0
    let mut i = 0
    while i < l * l { if g[i] == 0 { c = c + 1 }; i = i + 1 }
    return to_float(c) / to_float(l * l)
}

// run the spatial PD for T steps, return final cooperator fraction.
fn spatial_final_coop(l: int, b: float, t: int) -> float {
    let mut g = init_grid(l)
    let mut step = 0
    while step < t { g = step_grid(g, l, b); step = step + 1 }
    return coop_fraction(g, l)
}

// well-mixed replicator: x_{t+1} = x / (x + (1-x)*b), run T steps from x0.
fn wellmixed_final_coop(b: float, x0: float, t: int) -> float {
    let mut x = x0
    let mut step = 0
    while step < t {
        let denom = x + (1.0 - x) * b
        if denom > 0.000000001 { x = x / denom }
        step = step + 1
    }
    return x
}

fn main() {
    let l = 10
    let t = 80
    println("================================================================")
    println("  H_291 — Does cooperation EMERGE from spatial structure? (Nowak spatial PD)")
    println("  (L=" + str(l) + " toroidal · 8-Moore imitate-best · ~40% D init · NO RNG · NO ethics)")
    println("================================================================")

    let b_lo = 1.1
    let b_mid = 1.5
    let b_hi = 2.2

    let sp_lo  = spatial_final_coop(l, b_lo,  t)
    let sp_mid = spatial_final_coop(l, b_mid, t)
    let sp_hi  = spatial_final_coop(l, b_hi,  t)
    let wm_lo  = wellmixed_final_coop(b_lo,  0.6, 200)
    let wm_mid = wellmixed_final_coop(b_mid, 0.6, 200)
    let wm_hi  = wellmixed_final_coop(b_hi,  0.6, 200)

    println("  b=1.1  : spatial C=" + str(sp_lo)  + "   well-mixed C=" + str(wm_lo))
    println("  b=1.5  : spatial C=" + str(sp_mid) + "   well-mixed C=" + str(wm_mid))
    println("  b=2.2  : spatial C=" + str(sp_hi)  + "   well-mixed C=" + str(wm_hi))
    println("  --")

    // ── F291.1 WELL-MIXED-DEFECTS ───────────────────────────────────────
    check("F291.1a WELL-MIXED b=1.1 cooperation -> ~0 (<0.01)", wm_lo < 0.01)
    check("F291.1b WELL-MIXED b=1.5 cooperation -> ~0 (<0.01)", wm_mid < 0.01)
    check("F291.1c WELL-MIXED b=2.2 cooperation -> ~0 (<0.01)", wm_hi < 0.01)

    // ── F291.2 SPATIAL-RESCUE (verdict) ─────────────────────────────────
    // robust claim: at LOW temptation (b=1.1) spatial structure keeps cooperation
    // alive (>0.1) while the matched well-mixed population collapses to defection.
    let h1 = (sp_lo > 0.1) && (wm_lo < 0.01)
    println("  F291.2: spatial C@b=1.1=" + str(sp_lo) + " (>0.1?) vs well-mixed@b=1.1=" + str(wm_lo) + " (~0)")
    check("F291.2 SPATIAL-RESCUE: lattice C > 0.1 at b=1.1 while well-mixed -> ~0", h1)

    // ── F291.3 TEMPTATION-MONOTONE ──────────────────────────────────────
    check("F291.3 TEMPTATION-MONOTONE: C(1.1) >= C(1.5) >= C(2.2)", (sp_lo >= sp_mid - 0.000001) && (sp_mid >= sp_hi - 0.000001))

    // ── F291.4 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    if !((sp_lo >= 0.0) && (sp_lo <= 1.0)) { bound_ok = false }
    if !((sp_mid >= 0.0) && (sp_mid <= 1.0)) { bound_ok = false }
    if !((sp_hi >= 0.0) && (sp_hi <= 1.0)) { bound_ok = false }
    if !((wm_mid >= 0.0) && (wm_mid <= 1.0)) { bound_ok = false }
    check("F291.4 BOUND: all fractions in [0,1]", bound_ok)

    // ── F291.5 DETERMINISM ──────────────────────────────────────────────
    let sp_mid_b = spatial_final_coop(l, b_mid, t)
    check("F291.5 DETERMINISM: spatial b=1.5 re-run identical", approx(sp_mid, sp_mid_b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if h1 {
        println("  VERDICT: H1 SUPPORTED — a cooperative attractor EMERGES from spatial structure")
        println("           alone. Well-mixed -> defection; lattice -> cooperation persists. Ethics")
        println("           (cooperation) emerges from CELLS + STRUCTURE, not injection (Principle #6).")
    } else {
        println("  VERDICT: H1 FALSIFIED — cooperation does not persist; defect attractor only.")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_291 had FALSIFIER FAILURES") }
}
