// UNIVERSE/state/lib_phi_6anchor_remeasure_2026_05_24/remeasure_6anchor.hexa
// PHI domain milestone #8 — 6-anchor byte-equal remeasurement.
//
//   PURPOSE
//     Compare phi_native (pure-hexa replica) vs c_measure_phi (RFC 036
//     phi_spatial C builtin) on a representative state from each of the
//     6 PHI-anchor hypotheses (H_007 / H_204 / H_211 / H_223 / H_239 /
//     H_250). Each anchor contributes ONE state under the LIFE-lane
//     defaults (N=16, dim=12, warm=8, n_bins=4 — life_phi_* SSOT) so the
//     measurement is byte-equal-comparable. Per-anchor verdict (whether
//     phi_native swap would flip the H verdict at its documented threshold).
//
//   STATE GENERATOR
//     The LIFE-lane phi-anchored H all use the SAME N=16/dim=12/warm=8
//     1D-elementary-CA generator (`_run_ca` in run_ca_phi.hexa pattern).
//     We carry that generator verbatim here (small enough to inline) and
//     vary only the Wolfram rule to match each anchor's *representative
//     rule*. This is a single-state-per-anchor smoke — full per-anchor
//     re-execution = separate cycle (see results doc § 5).
//
//   ANCHOR → RULE MAP (representative)
//     H_007 → rule 110  (Class-IV edge-of-chaos, _RULE() 의 IV bucket)
//     H_204 → rule 110  (closure-axis CA — H_007 carry, weak-panpsy fixture)
//     H_211 → rule  30  (Shannon-Φ correlate fixture — chaotic class III)
//     H_223 → rule 110  (pain-intensity-Φ — _RULE() == 110 verbatim)
//     H_239 → rule 110  (alt-phi-metric — representative)
//     H_250 → rule  60  (non-pow2 lattice persistence — rule 60 N16 baseline)
//
//   FALSIFIER
//     F-6ANCHOR-1..6 — per anchor: phi_native vs c_measure_phi abs diff
//                       must be ≤ 5e-6 (L1 diagnostic empirical envelope).
//     F-VERDICT-MATCH — abs diff < anchor threshold margin (anchor-specific).
//
//   COMPLIANCE  raw#11 snake_case · raw#9 honest impl · English code.
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/UNIVERSE/lib/phi_helper.hexa"

// ── small int helpers (verbatim from h007/h250 generator) ────────────────────
fn _r6_pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _r6_ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _r6_itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

fn _r6_ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _r6_pow2(idx)) % 2
}

fn _r6_init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// build flat (n*dim) farr — periodic elementary CA, warm steps warmup.
fn _r6_run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _r6_init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _r6_ftoi(farr_get(row, lj))
            let cv = _r6_ftoi(farr_get(row, j))
            let rv = _r6_ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _r6_itof(_r6_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

fn _r6_abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

fn _r6_measure(anchor: string, rule: int) {
    let n = life_phi_n()
    let dim = life_phi_dim()
    let warm = life_phi_warm()
    let n_bins = life_phi_nbins()

    let states = _r6_run_ca(rule, n, dim, warm, 0)
    let phi_c = phi_with_backend(states, n, dim, n_bins, "c")
    let phi_h = phi_with_backend(states, n, dim, n_bins, "native")
    let _ = farr_free(states)

    let diff = _r6_abs(phi_c - phi_h)
    let within_5e6 = diff <= 0.000005

    println("  " + anchor + "  rule=" + to_string(rule)
            + "  phi_c=" + to_string(phi_c)
            + "  phi_native=" + to_string(phi_h)
            + "  abs_diff=" + to_string(diff)
            + "  within_5e-6=" + (if within_5e6 { "true" } else { "false" }))
}

fn main() {
    println("remeasure_6anchor — PHI domain milestone #8 (6-anchor byte-equal remeasure)")
    println("  config: N=" + to_string(life_phi_n())
            + " dim=" + to_string(life_phi_dim())
            + " warm=" + to_string(life_phi_warm())
            + " n_bins=" + to_string(life_phi_nbins())
            + " rep=0 (deterministic)")
    println("  backends: phi_with_backend(state, n, dim, n_bins, {\"c\"|\"native\"})")
    println("")

    _r6_measure("H_007", 110)
    _r6_measure("H_204", 110)
    _r6_measure("H_211",  30)
    _r6_measure("H_223", 110)
    _r6_measure("H_239", 110)
    _r6_measure("H_250",  60)

    println("")
    println("=== 6-anchor remeasurement complete ===")
}
