// UNIVERSE/state/h316_local_greedy_vs_global_phi_2026_05_27/run.hexa
// ════════════════════════════════════════════════════════════════════════════
// H_316 — LOCAL-GREEDY Φ-OPERATIONS ⊥ GLOBAL INTEGRATION
//         (BIO local-optimisation heuristics vs holistic IIT 4.0 big-Φ)
//
//   SYNTHESIS OF 4 ALREADY-MERGED CELLS
//     H_312 APOPTOSIS×IIT4   → 🔴 removing the lowest-Φ NODE raises survivor
//                                 mean-Φ in only 3/10 panels.
//     H_315 PRUNING×IIT4     → 🔴 pruning the weakest EDGEs preserves Φ WORSE
//                                 than random (AUC 0.162 < 0.227).
//     H_314 SYMBIOGENESIS     → 🔴 model-merge = least-bad blend, no synergy.
//     H_313 PLASTICITY×STDP   → 🟢 a DYNAMICAL learning rule works (NOT a
//                                 Φ-structural claim).
//     META-PATTERN under test: local greedy "remove the locally-weakest element"
//     heuristics from biology do NOT pick the globally Φ-optimal operation —
//     because big-Φ is non-additive / holistic. H_316 turns this into ONE
//     falsifiable test that mixes BOTH operator families (nodes + edges).
//
//   HYPOTHESIS (H1, falsifiable — NEW computation, not a re-narration)
//     A LOCAL-GREEDY operator (pick the element — NODE or EDGE — whose LOCAL
//     connectivity / activity weight is SMALLEST, then remove it) does NOT
//     achieve a better post-operation global big-Φ than a RANDOM choice, and
//     RARELY equals the TRUE globally-Φ-optimal operation. I.e. a purely LOCAL
//     marginal-weight ranking is NOT a reliable guide to the globally Φ-optimal
//     operation.
//   FALSIFIER (pre-registered)
//     If local-greedy SYSTEMATICALLY BEATS random — greedy post-Φ > random
//     post-Φ on a CLEAR MAJORITY of the panel (win-rate > 0.5) — H1 is
//     FALSIFIED (local heuristics DO transfer). Decisive corroborator: also
//     compute the TRUE GLOBAL OPTIMUM (exhaustively try EACH candidate's removal,
//     pick the actual Φ-best post-op) and measure how often greedy's pick ==
//     the global-best pick. greedy RARELY matching the optimum AND not beating
//     random ⇒ H1 strongly SUPPORTED (local ⊥ global).
//
//   ── g73 ANTI-TAUTOLOGY NOTE (critical) ──────────────────────────────────────
//     The LOCAL-greedy score MUST be a genuinely LOCAL quantity — what a
//     biological local rule can see (an element's own connectivity / activity),
//     NOT the global Φ-drop. If we scored each candidate by its exact global
//     Φ-drop and then asked "does argMIN(Φ-drop) == argMAX(post-Φ)?", that would
//     be an algebraic identity (post = base − drop) ⇒ a TAUTOLOGY (forbidden).
//     Instead the greedy rule ranks candidates by a LOCAL WEIGHT computed from
//     the substrate's wiring ALONE (output-sensitivity), with NO big-Φ inside
//     the ranking. The match against the exhaustive Φ-optimum is then a REAL
//     measurement that CAN fail (the local-weakest element need NOT be the
//     Φ-optimal one to remove).
//
//   UNIFIED OPERATOR SET (both bio families in one candidate pool per substrate)
//     (A) NODE removal i  : excise cell i → subsystem mask FULL\{i}.
//           LOCAL weight (node connectivity, NO Φ) =
//               Σ_p w(p→i)   [in-edges: how much i reads neighbours]
//             + Σ_j w(i→j)   [out-edges: how much neighbours read i]
//           post-op global Φ = bigPhi(FULL\{i})  (subsystem big-Φ, external
//               units background-conditioned to sys_state, IIT4 convention).
//     (E) EDGE prune (pos→i) : cell i stops reading neighbour `pos` (force-0
//           that input bit in the rule-lookup); KEEP all n nodes.
//           LOCAL weight (edge activity, NO Φ) = w(pos→i) =
//               (1/2^n) Σ_s [ nextbit(i|s) ≠ nextbit(i|s ⊕ pos) ]   [H_315 measure]
//           post-op global Φ = bigPhi(pruned)  (full n-cell big-Φ).
//     LOCAL-GREEDY = argMIN local-weight over the WHOLE pool (remove the element
//     that is locally weakest — the textbook "shed the weak connection / cell").
//
//   THREE PICKS per substrate (over the full unified candidate pool)
//     greedy : candidate with the SMALLEST LOCAL weight (ties → lowest index).
//     random : a FIXED-SEED candidate (deterministic lcg pick — control).
//     global : candidate with the LARGEST post-op global Φ (EXHAUSTIVE true
//              Φ-optimal single op; ties → lowest index).
//   MEASURE
//     greedy_beats_random ⇔ post_phi(greedy) > post_phi(random)  (eps 1e-9).
//     greedy_is_global    ⇔ greedy's candidate index == global's index (REAL,
//                            can fail — greedy ranks by local weight, global by Φ).
//   AGGREGATE
//     win_rate   = #(greedy_beats_random) / panel.
//     match_rate = #(greedy_is_global)    / panel.
//     H1 SUPPORTED ⇔ win_rate ≤ 0.5 (greedy does NOT systematically beat random)
//                    AND match_rate low (greedy rarely == true Φ-optimum).
//     H1 FALSIFIED ⇔ win_rate > 0.5 (greedy systematically beats random).
//
//   DETERMINISTIC · hexa-only · llm:none · $0 mac/pool. n ≤ 4 (exact Φ tractable,
//   2^n ≤ 16 states, cross-process byte-identical). The Φ engine is REUSED, NOT
//   reinvented (memory: H_280 reinvented IIT4 and got it wrong).
//
//   ENGINE (REUSED — identical to H_312 / H_315):
//     stdlib/consciousness/iit4_complex.hexa  (subsystem_tpm + big_phi chain;
//        re-exports iit4_pow2 / iit4_bit / iit4_units / iit4_project_state)
//     HEXAD/IIT4/lib/iit4_eca.hexa            (eca_tpm — ECA rule → SbN TPM)
//     stdlib/core/math/rng.hexa               (lcg_next — fixed-seed pick; g61)
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_complex.hexa"
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/core/math/rng.hexa"

// ── basic masks ──────────────────────────────────────────────────────────────
fn full_mask(n: int) -> int { return iit4_pow2(n) - 1 }
fn without_cell(mask: int, victim: int) -> int { return mask - iit4_pow2(victim) }

// ── subsystem big-Φ (NODE family) — external units pinned to sys_state ────────
fn sub_phi(tpm: array, n: int, mask: int, sys_state: int) -> float {
    let units = iit4_units(mask, n)
    let k = len(units)
    if k < 1 { return 0.0 }
    if k == 1 { return 0.0 }                            // single unit ⇒ big-Φ = 0
    let sub = subsystem_tpm(tpm, n, mask, sys_state)
    let ss  = iit4_project_state(sys_state, units)
    let r   = big_phi(sub, k, ss)
    return r[0]
}

// ── prunable ECA TPM (EDGE family) — force-0 a pruned neighbour bit ───────────
// pos encoding: 0 = left(i-1), 1 = centre(i), 2 = right(i+1).
fn eca_next_bit(rule: int, n: int, s: int, i: int, pruned: array) -> int {
    let lpos = (i - 1 + n) % n
    let cpos = i
    let rpos = (i + 1) % n
    let mut l = iit4_bit(s, lpos)
    let mut c = iit4_bit(s, cpos)
    let mut r = iit4_bit(s, rpos)
    if pruned[i * 3 + 0] == 1 { l = 0 }
    if pruned[i * 3 + 1] == 1 { c = 0 }
    if pruned[i * 3 + 2] == 1 { r = 0 }
    let idx = 4 * l + 2 * c + r                          // Wolfram neighbourhood idx 0..7
    return iit4_bit(rule, idx)
}
fn pruned_tpm(rule: int, n: int, pruned: array) -> array {
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            t = t.push(to_float(eca_next_bit(rule, n, s, i, pruned)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}
// big-Φ of the FULL n-cell system under a TPM (all nodes; EDGE-family post-op Φ).
fn whole_phi(tpm: array, n: int, sys_state: int) -> float {
    let r = big_phi(tpm, n, sys_state)
    return r[0]
}

// ── LOCAL edge weight (NO big-Φ) — avg output-sensitivity of edge (pos→i) ─────
// w(pos→i) = (1/2^n) Σ_s [ nextbit(i|s) ≠ nextbit(i|s with neighbour-pos flipped) ].
// 0 ⇒ edge does not exist (canalised input). High ⇒ strong local connection.
fn edge_weight(rule: int, n: int, i: int, pos: int) -> float {
    let full = iit4_pow2(n)
    let mut readpos = i
    if pos == 0 { readpos = (i - 1 + n) % n }
    if pos == 2 { readpos = (i + 1) % n }
    let mut none_pruned = []
    let mut z = 0
    while z < n * 3 { none_pruned = none_pruned.push(0); z = z + 1 }
    let mut diff = 0
    let mut s = 0
    while s < full {
        let a = eca_next_bit(rule, n, s, i, none_pruned)
        let s2 = s ^ iit4_pow2(readpos)
        let b = eca_next_bit(rule, n, s2, i, none_pruned)
        if a != b { diff = diff + 1 }
        s = s + 1
    }
    return to_float(diff) / to_float(full)
}

// ── LOCAL node weight (NO big-Φ) — total local connectivity of cell i ─────────
//   in-degree:  Σ over the 3 neighbour positions p of w(p→i)  (how much i reads).
//   out-degree: Σ over neighbours j that read i, of w(i→j)     (how much reads i).
// A standard local graph-activity proxy (Boolean-network degree). Purely local.
fn node_weight(rule: int, n: int, i: int) -> float {
    let mut w = 0.0
    // in-edges: i's own three input positions.
    let mut p = 0
    while p < 3 { w = w + edge_weight(rule, n, i, p); p = p + 1 }
    // out-edges: cell i is the LEFT input of (i+1), the CENTRE input of i,
    // and the RIGHT input of (i-1). Sum how much those cells depend on i.
    let right = (i + 1) % n
    let left  = (i - 1 + n) % n
    w = w + edge_weight(rule, n, right, 0)               // i → right  (i is its left)
    w = w + edge_weight(rule, n, i,     1)               // i → i      (centre self-loop)
    w = w + edge_weight(rule, n, left,  2)               // i → left   (i is its right)
    return w
}

fn fmt(x: float) -> string { return to_string(x) }

// ════════════════════════════════════════════════════════════════════════════
// run ONE substrate panel-cell. Build the UNIFIED candidate pool (node removals
// + edge prunes), score each by a LOCAL connectivity weight (NO big-Φ) AND by
// its POST-OP global Φ (exhaustive), then pick greedy / random / global and
// print the verdict booleans.
// ════════════════════════════════════════════════════════════════════════════
fn run_substrate(label: string, rule: int, n: int, sys: int) {
    let fmask = full_mask(n)
    let tpm0  = eca_tpm(rule, n)                         // unpruned full TPM
    let base  = sub_phi(tpm0, n, fmask, sys)             // bigPhi(FULL) — reference

    // candidate arrays (parallel): kind 0=NODE 1=EDGE · a = node-idx or cell-i ·
    // b = edge-pos (NODE: -1) · local_w (local connectivity, NO Φ) · post_phi.
    let mut c_kind  = []
    let mut c_a     = []
    let mut c_b     = []
    let mut c_localw = []
    let mut c_post  = []

    // (A) NODE-removal candidates ───────────────────────────────────────────────
    let units = iit4_units(fmask, n)
    let k = len(units)
    let mut u = 0
    while u < k {
        let i = units[u]
        let post = sub_phi(tpm0, n, without_cell(fmask, i), sys)   // post-op global Φ
        let lw = node_weight(rule, n, i)                           // LOCAL weight (no Φ)
        c_kind  = c_kind.push(0)
        c_a     = c_a.push(i)
        c_b     = c_b.push(-1)
        c_localw = c_localw.push(lw)
        c_post  = c_post.push(post)
        u = u + 1
    }

    // (E) EDGE-prune candidates (present effective edges only) ───────────────────
    let mut i = 0
    while i < n {
        let mut p = 0
        while p < 3 {
            let ew = edge_weight(rule, n, i, p)
            if ew > 0.000000001 {                                  // present edge only
                let mut pruned = []
                let mut z = 0
                while z < n * 3 { pruned = pruned.push(0); z = z + 1 }
                pruned[i * 3 + p] = 1
                let ptpm = pruned_tpm(rule, n, pruned)
                let post = whole_phi(ptpm, n, sys)                 // post-op global Φ
                c_kind  = c_kind.push(1)
                c_a     = c_a.push(i)
                c_b     = c_b.push(p)
                c_localw = c_localw.push(ew)                       // LOCAL weight (no Φ)
                c_post  = c_post.push(post)
            }
            p = p + 1
        }
        i = i + 1
    }

    let m = len(c_kind)

    // ── greedy pick: argMIN LOCAL weight (the "shed the locally-weakest" rule) ──
    let mut g_idx = 0
    let mut g_lw = c_localw[0]
    let mut a = 1
    while a < m {
        if c_localw[a] < g_lw - 0.000000001 { g_lw = c_localw[a]; g_idx = a }
        a = a + 1
    }

    // ── global-best pick: argMAX post-op Φ (TRUE Φ-optimal single op; ties→low) ──
    let mut go_idx = 0
    let mut go_post = c_post[0]
    let mut b = 1
    while b < m {
        if c_post[b] > go_post + 0.000000001 { go_post = c_post[b]; go_idx = b }
        b = b + 1
    }

    // ── random pick: fixed-seed deterministic candidate (cross-process stable) ──
    let st = lcg_next((1009 + rule * 31 + n * 7 + sys) & 4294967295)
    let r_idx = st % m

    // ── verdict booleans (machine-greppable) ───────────────────────────────────
    let greedy_post = c_post[g_idx]
    let random_post = c_post[r_idx]
    let greedy_beats_random = greedy_post > random_post + 0.000000001
    let greedy_is_global    = g_idx == go_idx

    println("PANEL " + label + " n=" + to_string(n) + " sys=" + to_string(sys) + " rule=" + to_string(rule))
    println("  candidates=" + to_string(m) + " base_bigPhi=" + fmt(base))
    println("  greedy  kind=" + to_string(c_kind[g_idx]) + " a=" + to_string(c_a[g_idx]) + " b=" + to_string(c_b[g_idx]) + " local_w=" + fmt(c_localw[g_idx]) + " post_phi=" + fmt(greedy_post))
    println("  random  idx=" + to_string(r_idx) + " kind=" + to_string(c_kind[r_idx]) + " a=" + to_string(c_a[r_idx]) + " b=" + to_string(c_b[r_idx]) + " local_w=" + fmt(c_localw[r_idx]) + " post_phi=" + fmt(random_post))
    println("  global  idx=" + to_string(go_idx) + " kind=" + to_string(c_kind[go_idx]) + " a=" + to_string(c_a[go_idx]) + " b=" + to_string(c_b[go_idx]) + " local_w=" + fmt(c_localw[go_idx]) + " post_phi=" + fmt(go_post))
    println("  CELL_RESULT greedy_post=" + fmt(greedy_post) + " random_post=" + fmt(random_post) + " global_post=" + fmt(go_post) + " greedy_beats_random=" + to_string(greedy_beats_random) + " greedy_is_global=" + to_string(greedy_is_global))
    println("")
}

fn main() {
    println("H_316 — LOCAL-GREEDY Φ-OPS ⊥ GLOBAL INTEGRATION (synthesis of H_312/313/314/315)")
    println("  unified candidate pool = NODE removals + EDGE prunes")
    println("  local weight = connectivity/activity (NO big-Φ inside the greedy ranking — g73 anti-tautology)")
    println("  greedy=argMIN local-weight · random=fixed-seed · global=argMAX post-op Φ (exhaustive true optimum)")
    println("  engine = stdlib iit4_complex + iit4_eca + rng (REUSED, not reinvented)")
    println("  FALSIFIER: greedy systematically BEATS random (win-rate > 0.5) ⇒ H1 FALSIFIED (local transfers)")
    println("")

    // PANEL: identical to H_312 / H_315 (10 ECA substrates, n∈{3,4}, fixed sys).
    run_substrate("eca90",  90,  4, 11)
    run_substrate("eca110", 110, 4, 11)
    run_substrate("eca30",  30,  4, 11)
    run_substrate("eca54",  54,  4, 11)
    run_substrate("eca150", 150, 4, 11)
    run_substrate("eca22",  22,  4, 11)
    run_substrate("eca60",  60,  4, 11)
    run_substrate("eca105", 105, 4, 11)
    run_substrate("eca90_n3",  90,  3, 5)
    run_substrate("eca110_n3", 110, 3, 5)

    println("DONE")
}
