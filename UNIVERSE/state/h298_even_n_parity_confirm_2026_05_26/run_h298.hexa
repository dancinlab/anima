// UNIVERSE/state/h298_even_n_parity_confirm_2026_05_26/run_h298.hexa
//
//   H_298 — Even-N parity confirm: does rule 90 RETURN to Phi≈0 at n=6?
//
//   QUESTION
//     H_297 (cycle#35) headline: "rule 90 reducibility = even-N bipartite
//     artifact" (n=4 Phi=0 -> n=5 bounded Phi=19.5). Tested only ONE parity
//     step. If the parity hypothesis is real, at n=6 (next EVEN ring) rule 90
//     must again drop to Phi ≈ 0. At n=7 (next ODD ring) it must stay
//     integrated. H_298 strikes that direct falsification.
//
//   HYPOTHESES
//     H1 EVEN-N-PARITY (headline): rule 90 n=6 bounded ensemble-mean Phi
//        ≤ 0.5 (anchors ≈ 0).
//     H2 ODD-N-INTEGRATION:        rule 90 n=7 bounded ensemble-mean Phi
//        > 1.0 (strong integration, like n=5).
//
//   METHOD (re-use HEXAD/IIT4/lib + stdlib · g61)
//     - eca_tpm(rule, n) for n=6 (64 states) and n=7 (128 states).
//     - big_phi_bounded(tpm, n, st, cap=4) -> lower bound (cap=n-2 for n=6,
//       n-3 for n=7).
//     - ensemble-mean: average over ALL 2^n states (whole panel, not single).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-26, BEFORE measure)
//     F298.1 EVEN-N-PARITY: rule 90 n=6 mean Phi <= 0.5 (return to redux)
//     F298.2 ODD-N-INTEGRATION: rule 90 n=7 mean Phi > 1.0 (odd integrates)
//     F298.3 SCALE-ANCHORS: rule 204 + rule 0 mean Phi = 0 at BOTH n=6, n=7
//     F298.4 INTEGRATION-SURVIVES: rule 60 OR rule 110 mean Phi > 0 at BOTH
//     F298.5 BOUND: all values >= 0
//     F298.6 DETERMINISM: rule 90 n=6 mean Phi re-run identical
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/wt-c36/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx_zero(a: float) -> bool {
    if a < 0.0 { return (0.0 - a) < 0.000001 }
    return a < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ensemble-mean bounded big-Phi over ALL 2^n states.
fn phi_b_mean(rule: int, n: int, cap: int) -> float {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut acc = 0.0
    let mut st = 0
    while st < full {
        let r = big_phi_bounded(tpm, n, st, cap)
        acc = acc + r[0]
        st = st + 1
    }
    return acc / to_float(full)
}

fn main() {
    let cap = 4
    println("================================================================")
    println("  H_298 — even-N parity confirm (n=6 vs n=7 ensemble, cap=" + str(cap) + ")")
    println("================================================================")

    // ── n=6 (even ring, 64 states) ──────────────────────────────────────
    println("  n=6 (even ring) — bounded ensemble-mean Phi")
    let p90_n6  = phi_b_mean(90,  6, cap)
    let p60_n6  = phi_b_mean(60,  6, cap)
    let p110_n6 = phi_b_mean(110, 6, cap)
    let p204_n6 = phi_b_mean(204, 6, cap)
    let p0_n6   = phi_b_mean(0,   6, cap)
    println("    rule 90  : " + str(p90_n6))
    println("    rule 60  : " + str(p60_n6))
    println("    rule 110 : " + str(p110_n6))
    println("    rule 204 : " + str(p204_n6))
    println("    rule 0   : " + str(p0_n6))

    // ── n=7 (odd ring, 128 states) ──────────────────────────────────────
    println("  n=7 (odd ring) — bounded ensemble-mean Phi")
    let p90_n7  = phi_b_mean(90,  7, cap)
    let p60_n7  = phi_b_mean(60,  7, cap)
    let p110_n7 = phi_b_mean(110, 7, cap)
    let p204_n7 = phi_b_mean(204, 7, cap)
    let p0_n7   = phi_b_mean(0,   7, cap)
    println("    rule 90  : " + str(p90_n7))
    println("    rule 60  : " + str(p60_n7))
    println("    rule 110 : " + str(p110_n7))
    println("    rule 204 : " + str(p204_n7))
    println("    rule 0   : " + str(p0_n7))

    // ── F298.1 EVEN-N-PARITY (HEADLINE) ─────────────────────────────────
    let parity_witnessed = p90_n6 <= 0.5
    println("  F298.1: rule 90 n=6 mean Phi = " + str(p90_n6) + " (threshold ≤ 0.5 for parity return)")
    check("F298.1 EVEN-N-PARITY: rule 90 n=6 ensemble-mean Phi ≤ 0.5 (return to reducibility)", parity_witnessed)

    // ── F298.2 ODD-N-INTEGRATION ────────────────────────────────────────
    let odd_integrates = p90_n7 > 1.0
    println("  F298.2: rule 90 n=7 mean Phi = " + str(p90_n7) + " (threshold > 1.0 for odd integration)")
    check("F298.2 ODD-N-INTEGRATION: rule 90 n=7 ensemble-mean Phi > 1.0", odd_integrates)

    // ── F298.3 SCALE-ANCHORS ────────────────────────────────────────────
    let anchor_ok = approx_zero(p204_n6) && approx_zero(p0_n6) && approx_zero(p204_n7) && approx_zero(p0_n7)
    check("F298.3 SCALE-ANCHORS: rule 204 + rule 0 mean Phi = 0 at n=6 AND n=7", anchor_ok)

    // ── F298.4 INTEGRATION-SURVIVES ─────────────────────────────────────
    let int_n6_ok = (p60_n6 > 0.000001) || (p110_n6 > 0.000001)
    let int_n7_ok = (p60_n7 > 0.000001) || (p110_n7 > 0.000001)
    check("F298.4 INTEGRATION-SURVIVES: rule 60 OR 110 mean Phi > 0 at n=6 AND n=7", int_n6_ok && int_n7_ok)

    // ── F298.5 BOUND ────────────────────────────────────────────────────
    let mut bound_ok = true
    let vals = [p90_n6, p60_n6, p110_n6, p204_n6, p0_n6, p90_n7, p60_n7, p110_n7, p204_n7, p0_n7]
    let mut i = 0
    while i < 10 {
        if !(vals[i] >= 0.0 - 0.000001) { bound_ok = false }
        i = i + 1
    }
    check("F298.5 BOUND: all mean Phi >= 0", bound_ok)

    // ── F298.6 DETERMINISM ──────────────────────────────────────────────
    let p90_n6_re = phi_b_mean(90, 6, cap)
    let det = (p90_n6 == p90_n6_re)
    check("F298.6 DETERMINISM: rule 90 n=6 mean Phi re-run identical", det)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    let mut headline = "MIXED"
    if parity_witnessed && odd_integrates { headline = "STRONG-CONFIRM" }
    if (!parity_witnessed) && odd_integrates { headline = "PARITY-DENIED-INTEGRATION-CONFIRMED" }
    if parity_witnessed && (!odd_integrates) { headline = "PARITY-CONFIRMED-ODD-DENIED" }
    if (!parity_witnessed) && (!odd_integrates) { headline = "BOTH-DENIED" }
    println("  HEADLINE: " + headline)
    println("    n=6 rule 90 = " + str(p90_n6) + " · n=7 rule 90 = " + str(p90_n7))
    println("================================================================")
    if FAIL > 0 { panic("H_298 had FALSIFIER FAILURES (orthogonal to H1/H2 verdict)") }
}
