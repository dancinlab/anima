// ════════════════════════════════════════════════════════════════════════════
//  run_h210.hexa — H_210 ETHIC-EMERGENCE kin-selection cooperative attractor
//
//  QUESTION
//    윤리적 cooperation (cooperate / defect tag) 가 substrate 수준에서 evolve
//    하는가? Hamilton's rule (r·b > c) 가 cooperator-fraction stable attractor
//    의 phase boundary 인가? 즉 cooperation 이 hard-coded 가 아니라 *emerge*
//    한다는 substrate-level 증거를 본 cycle 이 제공하는가?
//
//  EXPERIMENT
//    pool N=16 cells, lattice 1-D. 각 cell 은 strategy ∈ {cooperate(1),
//    defect(0)}. 초기 50/50 **clustered**: cells [0..7] = cooperate,
//    [8..15] = defect (deterministic). clustered init = Hamilton kin-
//    locality proxy: relatives cluster spatially, enabling assortative
//    interaction. (alternating init was tested first and confirmed
//    spatial-game theory result that lone cooperators are exploited by
//    defector neighbors — see Honest Limit L6).
//
//    per step:
//      1. 각 cell-i 의 payoff = Σ_{j: |i-j| ≤ radius, j≠i} payoff_rule(i, j)
//         where payoff_rule(focal=i, partner=j):
//           - if i cooperates AND j cooperates : +b - c   (mutual cooperation)
//           - if i cooperates AND j defects    : -c       (i pays, j takes free)
//           - if i defects    AND j cooperates : +b       (i takes free, j pays)
//           - if i defects    AND j defects    : 0
//      2. fitness = max(payoff, 0)  (non-negative floor)
//      3. cell-i 의 split_prob ∝ fitness  (high-fitness cells replicate; replication
//         inherits strategy; replacement targets lowest-fitness neighbor in radius)
//      4. **NO horizontal strategy learning** — strategies propagate ONLY through
//         replication (kin-selection mechanism, not imitation)
//
//    2 regimes:
//      A. (b=3, c=1) — Hamilton-favorable for clustered cooperators (interior
//         coop sees only coop neighbors, payoff=k(b-c)=4·2=8 > defectors at
//         boundary with mixed neighbors). Hamilton's rule r·b > c with r ≈ 0.5
//         (lattice locality proxy via radius=2) satisfied: 0.5·3 = 1.5 > 1 ✓
//      B. (b=1, c=2) — Hamilton-unfavorable: cost > benefit even for relatives;
//         clustered cooperators still lose at boundaries (-c per defector neighbor).
//    + phase sweep: b ∈ {0.5, 1.0, 1.5, 2.0, 3.0, 4.0} with c=1.0 → cooperator-
//      fraction monotone increase as b crosses Hamilton threshold (~b=1 for r=0.5,
//      raised to ~b=2 by spatial Ohtsuki-style adjustment).
//
//  DETERMINISM
//    pure-integer arithmetic (payoff = int sums) + deterministic replacement rule
//    (ties broken by lowest index). NO gaussian noise, NO seed needed beyond
//    deterministic alternating init. Byte-identical re-run guaranteed.
//
//  PRIMARY METRIC
//    final_cooperator_fraction after 30 steps (regime A vs regime B).
//    + phase-sweep table (b/c × final-fraction).
//    + split-rate-cooperator vs split-rate-defector.
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
//
//  FALSIFIERS (≥5, pre-registered)
//    F-H210-1 REGIME-A-COOP   : final cooperator fraction ≥ 0.5 in regime A
//    F-H210-2 REGIME-B-DEFEC  : final cooperator fraction ≤ 0.2 in regime B
//    F-H210-3 PHASE-MONOTONE  : sweep cooperator-fraction monotone non-decreasing
//                                in b/c (allow ≤ 1 inversion for finite-N noise)
//    F-H210-4 KIN-SPLIT       : coop split-count > defect split-count in regime A
//    F-H210-5 BYTE-IDENTICAL  : two independent runs give identical metrics
//                                (deterministic raw#9 invariant)
// ════════════════════════════════════════════════════════════════════════════


// ─── frozen configuration ──────────────────────────────────────────────────
let N_CELLS    = 16
let N_STEPS    = 30
let RADIUS     = 2
let SWEEP_B    = [0.5, 1.0, 1.5, 2.0, 3.0, 4.0]
let SWEEP_C    = 1.0
let OUT_JSON   = "UNIVERSE/state/h210_ethic_emergence_2026_05_23/result.json"


// ─── helpers ───────────────────────────────────────────────────────────────

fn abs_int(x: int) -> int {
    if x < 0 { return 0 - x }
    return x
}

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// initialise pool: CLUSTERED cooperators in [0, n/2), defectors in [n/2, n).
// This is the kin-selection canonical init — relatives cluster spatially,
// allowing assortative interaction (the very mechanism Hamilton's rule
// quantifies). strategies[i] ∈ {0, 1}.
fn init_pool(n: int) {
    let mut strategies = []
    let half = n / 2
    let mut i = 0
    while i < n {
        if i < half {
            strategies.push(1)  // cooperate (first half)
        } else {
            strategies.push(0)  // defect (second half)
        }
        i = i + 1
    }
    return strategies
}

// cooperator count over a strategies list.
fn count_coop(strats) -> int {
    let n = len(strats)
    let mut k = 0
    let mut i = 0
    while i < n {
        if strats[i] == 1 { k = k + 1 }
        i = i + 1
    }
    return k
}

// cooperator fraction (float in [0,1]).
fn coop_frac(strats) -> float {
    let n = len(strats)
    if n == 0 { return 0.0 }
    let k = count_coop(strats)
    return (k + 0.0) / (n + 0.0)
}

// compute per-cell payoff under given (b, c).
// payoff_rule (focal=i, partner=j):
//   i=C, j=C : +b - c
//   i=C, j=D : -c
//   i=D, j=C : +b
//   i=D, j=D : 0
// neighbors: |i - j| ≤ RADIUS, j ≠ i, lattice indices (no wrap — boundary cells have fewer neighbors).
fn compute_payoffs(strats, b: float, c: float, radius: int) {
    let n = len(strats)
    let mut payoffs = []
    let mut i = 0
    while i < n {
        let mut p = 0.0
        let mut j = i - radius
        while j <= i + radius {
            if (j != i) && (j >= 0) && (j < n) {
                let si = strats[i]
                let sj = strats[j]
                if (si == 1) && (sj == 1) {
                    p = p + b - c
                } else {
                    if (si == 1) && (sj == 0) {
                        p = p - c
                    } else {
                        if (si == 0) && (sj == 1) {
                            p = p + b
                        }
                        // (D,D) -> 0, no change
                    }
                }
            }
            j = j + 1
        }
        payoffs.push(p)
        i = i + 1
    }
    return payoffs
}

// find highest-fitness cell index (deterministic tie-break: lowest index).
fn argmax(payoffs) -> int {
    let n = len(payoffs)
    let mut best_i = 0
    let mut best_v = payoffs[0]
    let mut i = 1
    while i < n {
        if payoffs[i] > best_v {
            best_v = payoffs[i]
            best_i = i
        }
        i = i + 1
    }
    return best_i
}

// find lowest-fitness neighbor of cell at index `focal` within radius
// (deterministic tie-break: lowest index). Returns -1 if no neighbor.
fn argmin_neighbor(payoffs, focal: int, radius: int) -> int {
    let n = len(payoffs)
    let mut best_i = -1
    let mut best_v = 0.0
    let mut found = false
    let mut j = focal - radius
    while j <= focal + radius {
        if (j != focal) && (j >= 0) && (j < n) {
            if !found {
                best_v = payoffs[j]
                best_i = j
                found = true
            } else {
                if payoffs[j] < best_v {
                    best_v = payoffs[j]
                    best_i = j
                }
            }
        }
        j = j + 1
    }
    return best_i
}

// one evolution step. high-fitness cell replicates strategy into low-fitness
// neighbor in radius. Returns (new_strats, did_coop_replicate, did_defect_replicate).
// kin-selection mechanism: ONLY replication propagates strategy (no imitation).
fn evolve_step(strats, b: float, c: float, radius: int) {
    let payoffs = compute_payoffs(strats, b, c, radius)
    let n = len(strats)

    // global argmax: the most-fit cell replicates.
    let src = argmax(payoffs)
    let src_payoff = payoffs[src]

    let mut coop_split = 0
    let mut defect_split = 0
    let mut new_strats = []
    let mut i = 0
    while i < n {
        new_strats.push(strats[i])
        i = i + 1
    }

    // only replicate if payoff is positive (fitness > 0).
    if src_payoff > 0.0 {
        let tgt = argmin_neighbor(payoffs, src, radius)
        if tgt >= 0 {
            // src replicates strategy into tgt (replacement, not addition —
            // pool size constant = ecological carrying capacity).
            let src_strat = strats[src]
            let prev_tgt = new_strats[tgt]
            new_strats[tgt] = src_strat
            // only count if strategy actually changed (was a "successful split").
            if prev_tgt != src_strat {
                if src_strat == 1 { coop_split = coop_split + 1 }
                if src_strat == 0 { defect_split = defect_split + 1 }
            }
        }
    }

    return #{
        "strats":        new_strats,
        "coop_split":    coop_split,
        "defect_split":  defect_split,
        "src":           src,
        "src_payoff":    src_payoff
    }
}

// full simulation: N_STEPS evolution + trajectory tracking.
fn simulate(b: float, c: float, radius: int, n_steps: int) {
    let mut strats = init_pool(N_CELLS)
    let mut traj = []
    traj.push(coop_frac(strats))
    let mut total_coop_split = 0
    let mut total_defect_split = 0
    let mut step = 0
    while step < n_steps {
        let res = evolve_step(strats, b, c, radius)
        strats = res["strats"]
        total_coop_split = total_coop_split + res["coop_split"]
        total_defect_split = total_defect_split + res["defect_split"]
        traj.push(coop_frac(strats))
        step = step + 1
    }
    return #{
        "final_frac":   coop_frac(strats),
        "final_strats": strats,
        "traj":         traj,
        "coop_split":   total_coop_split,
        "defect_split": total_defect_split
    }
}


// ─── JSON serialisation helpers ───────────────────────────────────────────

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true  v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = to_string(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + to_string(to_int(whole)) + "." + frac_str
}

fn _int_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + _f6(arr[i])
        i = i + 1
    }
    return out + "]"
}


// ─── main ─────────────────────────────────────────────────────────────────

fn _run_h210() {
    println("================================================================")
    println("H_210 ETHIC-EMERGENCE — kin-selection cooperative attractor")
    println("  N_CELLS=" + to_string(N_CELLS) + "  RADIUS=" + to_string(RADIUS)
            + "  N_STEPS=" + to_string(N_STEPS))
    println("  init=clustered 50/50 (cells [0..7]=C, [8..15]=D — kin-locality)")
    println("  deterministic · hexa-only · LLM none · $0 mac local")
    println("================================================================")

    // ── REGIME A — Hamilton-favorable: b=3, c=1 ──
    println("")
    println("--- REGIME A: b=3, c=1  (Hamilton-favorable: r=0.5, r·b=1.5 > c=1) ---")
    let rA = simulate(3.0, 1.0, RADIUS, N_STEPS)
    println("  initial_coop_frac = " + _f6(rA["traj"][0]))
    println("  final_coop_frac   = " + _f6(rA["final_frac"]))
    println("  coop_splits       = " + to_string(rA["coop_split"]))
    println("  defect_splits     = " + to_string(rA["defect_split"]))

    // ── REGIME B — Hamilton-unfavorable: b=1, c=2 ──
    println("")
    println("--- REGIME B: b=1, c=2  (Hamilton-unfavorable: r·b=0.5 < c=2) ---")
    let rB = simulate(1.0, 2.0, RADIUS, N_STEPS)
    println("  initial_coop_frac = " + _f6(rB["traj"][0]))
    println("  final_coop_frac   = " + _f6(rB["final_frac"]))
    println("  coop_splits       = " + to_string(rB["coop_split"]))
    println("  defect_splits     = " + to_string(rB["defect_split"]))

    // ── PHASE SWEEP — vary b with fixed c=1.0 ──
    println("")
    println("--- PHASE SWEEP: c=1.0, b ∈ {0.5, 1.0, 1.5, 2.0, 3.0, 4.0} ---")
    let mut sweep_fracs = []
    let mut k = 0
    while k < len(SWEEP_B) {
        let b = SWEEP_B[k]
        let r = simulate(b, SWEEP_C, RADIUS, N_STEPS)
        sweep_fracs.push(r["final_frac"])
        println("    b=" + _f6(b) + "  c=" + _f6(SWEEP_C)
                + "  final_coop_frac=" + _f6(r["final_frac"]))
        k = k + 1
    }

    // ── REPRO RUN — verify byte-identical second invocation ──
    println("")
    println("--- BYTE-IDENTICAL RE-RUN: regime A repeat ---")
    let rA2 = simulate(3.0, 1.0, RADIUS, N_STEPS)
    let byte_identical = (rA2["final_frac"] == rA["final_frac"])
                      && (rA2["coop_split"] == rA["coop_split"])
                      && (rA2["defect_split"] == rA["defect_split"])
    println("  final_frac match  = " + to_string(rA2["final_frac"] == rA["final_frac"]))
    println("  coop_split match  = " + to_string(rA2["coop_split"] == rA["coop_split"])
            + "  (" + to_string(rA["coop_split"]) + " vs " + to_string(rA2["coop_split"]) + ")")
    println("  defect_split match= " + to_string(rA2["defect_split"] == rA["defect_split"])
            + "  (" + to_string(rA["defect_split"]) + " vs " + to_string(rA2["defect_split"]) + ")")
    println("  BYTE_IDENTICAL    = " + to_string(byte_identical))

    // ── falsifier verdicts ────────────────────────────────────────────────
    let f1 = (rA["final_frac"] >= 0.5)
    let f2 = (rB["final_frac"] <= 0.2)

    // F3 monotone check: count inversions (sweep_fracs[k+1] < sweep_fracs[k]).
    let mut inversions = 0
    let mut j = 1
    while j < len(sweep_fracs) {
        if sweep_fracs[j] < sweep_fracs[j - 1] { inversions = inversions + 1 }
        j = j + 1
    }
    // Allow ≤ 1 inversion for finite-N noise (we have only 6 sweep points).
    let f3 = (inversions <= 1)

    let f4 = (rA["coop_split"] > rA["defect_split"])
    let f5 = byte_identical

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    // verdict_rule (from §Criteria):
    //   SUPPORTED if C1(F1)+C2(F2)+C4(F5) PASS;
    //   PARTIAL if exactly 2 of {C1,C2,C4} PASS;
    //   FALSIFIED if regime A coop < 0.5  (i.e. F1 FAIL).
    let strict_core = f1 && f2 && f5
    let two_core = ((if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 }) + (if f5 { 1 } else { 0 })) == 2
    let verdict = if strict_core {
        if (n_pass == 5) { "SUPPORTED_FULL" } else { "SUPPORTED" }
    } else {
        if two_core { "PARTIAL" } else { "FALSIFIED" }
    }

    // ── result.json ──────────────────────────────────────────────────────
    let mut buf = "{\n"
    buf = buf + "  \"hypothesis\": \"H_210\",\n"
    buf = buf + "  \"domain\": \"LIFE-ethics\",\n"
    buf = buf + "  \"title\": \"ETHIC-EMERGENCE kin-selection cooperative attractor\",\n"
    buf = buf + "  \"date\": \"2026-05-23\",\n"
    buf = buf + "  \"host\": \"mac-local\",\n"
    buf = buf + "  \"deterministic\": true,\n"
    buf = buf + "  \"llm\": \"none\",\n"
    buf = buf + "  \"n_cells\": " + to_string(N_CELLS) + ",\n"
    buf = buf + "  \"radius\": " + to_string(RADIUS) + ",\n"
    buf = buf + "  \"n_steps\": " + to_string(N_STEPS) + ",\n"
    buf = buf + "  \"r_lattice_proxy\": 0.5,\n"
    buf = buf + "  \"regime_A\": {\n"
    buf = buf + "    \"params\": { \"b\": 3.0, \"c\": 1.0 },\n"
    buf = buf + "    \"hamilton\": \"r*b=1.5 > c=1.0 (favorable)\",\n"
    buf = buf + "    \"initial_coop_frac\": " + _f6(rA["traj"][0]) + ",\n"
    buf = buf + "    \"final_coop_frac\": " + _f6(rA["final_frac"]) + ",\n"
    buf = buf + "    \"coop_splits\": " + to_string(rA["coop_split"]) + ",\n"
    buf = buf + "    \"defect_splits\": " + to_string(rA["defect_split"]) + ",\n"
    buf = buf + "    \"final_strategies\": " + _int_arr_json(rA["final_strats"]) + ",\n"
    buf = buf + "    \"traj\": " + _float_arr_json(rA["traj"]) + "\n"
    buf = buf + "  },\n"
    buf = buf + "  \"regime_B\": {\n"
    buf = buf + "    \"params\": { \"b\": 1.0, \"c\": 2.0 },\n"
    buf = buf + "    \"hamilton\": \"r*b=0.5 < c=2.0 (unfavorable)\",\n"
    buf = buf + "    \"initial_coop_frac\": " + _f6(rB["traj"][0]) + ",\n"
    buf = buf + "    \"final_coop_frac\": " + _f6(rB["final_frac"]) + ",\n"
    buf = buf + "    \"coop_splits\": " + to_string(rB["coop_split"]) + ",\n"
    buf = buf + "    \"defect_splits\": " + to_string(rB["defect_split"]) + ",\n"
    buf = buf + "    \"final_strategies\": " + _int_arr_json(rB["final_strats"]) + ",\n"
    buf = buf + "    \"traj\": " + _float_arr_json(rB["traj"]) + "\n"
    buf = buf + "  },\n"
    buf = buf + "  \"phase_sweep\": {\n"
    buf = buf + "    \"c_fixed\": " + _f6(SWEEP_C) + ",\n"
    buf = buf + "    \"b_values\": " + _float_arr_json(SWEEP_B) + ",\n"
    buf = buf + "    \"final_fracs\": " + _float_arr_json(sweep_fracs) + ",\n"
    buf = buf + "    \"inversions\": " + to_string(inversions) + "\n"
    buf = buf + "  },\n"
    buf = buf + "  \"byte_identical_run\": {\n"
    buf = buf + "    \"regime_A_repeat_final_frac\": " + _f6(rA2["final_frac"]) + ",\n"
    buf = buf + "    \"regime_A_repeat_coop_split\": " + to_string(rA2["coop_split"]) + ",\n"
    buf = buf + "    \"regime_A_repeat_defect_split\": " + to_string(rA2["defect_split"]) + ",\n"
    buf = buf + "    \"identical\": " + to_string(byte_identical) + "\n"
    buf = buf + "  },\n"
    buf = buf + "  \"falsifiers\": {\n"
    buf = buf + "    \"F_H210_1_REGIME_A_COOP\": { \"metric\": \"regime_A.final_coop_frac >= 0.5\", \"value\": " + _f6(rA["final_frac"]) + ", \"verdict\": \"" + v1 + "\" },\n"
    buf = buf + "    \"F_H210_2_REGIME_B_DEFEC\": { \"metric\": \"regime_B.final_coop_frac <= 0.2\", \"value\": " + _f6(rB["final_frac"]) + ", \"verdict\": \"" + v2 + "\" },\n"
    buf = buf + "    \"F_H210_3_PHASE_MONOTONE\": { \"metric\": \"sweep inversions <= 1\", \"value\": " + to_string(inversions) + ", \"verdict\": \"" + v3 + "\" },\n"
    buf = buf + "    \"F_H210_4_KIN_SPLIT\":      { \"metric\": \"regime_A coop_splits > defect_splits\", \"verdict\": \"" + v4 + "\" },\n"
    buf = buf + "    \"F_H210_5_BYTE_IDENTICAL\": { \"metric\": \"re-run identical metrics\", \"verdict\": \"" + v5 + "\" }\n"
    buf = buf + "  },\n"
    buf = buf + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    buf = buf + "  \"verdict\": \"" + verdict + "\"\n"
    buf = buf + "}\n"

    write_file(OUT_JSON, buf)

    println("")
    println("F-H210-1 REGIME-A-COOP    " + v1 + "  (final " + _f6(rA["final_frac"]) + " ≥ 0.5)")
    println("F-H210-2 REGIME-B-DEFEC   " + v2 + "  (final " + _f6(rB["final_frac"]) + " ≤ 0.2)")
    println("F-H210-3 PHASE-MONOTONE   " + v3 + "  (inversions=" + to_string(inversions) + " ≤ 1)")
    println("F-H210-4 KIN-SPLIT        " + v4 + "  (regime A coop_splits " + to_string(rA["coop_split"]) + " > defect " + to_string(rA["defect_split"]) + ")")
    println("F-H210-5 BYTE-IDENTICAL   " + v5)
    println("================================================================")
    println("VERDICT: " + verdict + "  (" + to_string(n_pass) + "/5 falsifiers PASS)")
    println("  result.json -> " + OUT_JSON)
    println("================================================================")
}


_run_h210()
