// S2 animal graded-Phi — Phi rises with node count across "species".
// Hypothesis: big-Phi is graded across substrates of increasing element count
//   (n=2..4), the cross-species extension of s11's single-cell curve.
// Falsifier: Phi flat / independent of n (all-or-nothing consciousness).
// substrate: ECA rule110 (fixed coupled rule), I=0.21232 as TPM scale (1-I).
// n=2..4 are fast; n>=5 grows exponentially (capped at n=4, noted) - the n<=4
//   monotone trend already decides graded vs flat.
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}
fn main() {
    let I = 0.21232
    let p2 = max_bigphi(110, 2, I)
    let p3 = max_bigphi(110, 3, I)
    let p4 = max_bigphi(110, 4, I)
    print("Phi(n=2) = "); println(p2)
    print("Phi(n=3) = "); println(p3)
    print("Phi(n=4) = "); println(p4)
    let graded = (p3 > p2) && (p4 > p3)
    let pass = graded && (p2 > 0.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = FALSIFIED") }
}
