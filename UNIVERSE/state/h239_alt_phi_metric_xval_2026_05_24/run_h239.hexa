// UNIVERSE/state/h239_alt_phi_metric_xval_2026_05_24/run_h239.hexa
// H_239 — alternative-Φ-metric cross-validation (raw#12).
//
//   Question: 본 LIFE 세션의 negative-direction 결과 (H_222/H_207/H_221/
//   H_218 등 5 FALSIFIED) 가 phi_spatial-specific artifact 인가, metric-
//   agnostic 인가? gap report F4 (counterfactual) + F8 (cross-tool-
//   consistency) 의 직접 instance.
//
//   Method (deterministic, hexa-only, $0 mac local, llm:none):
//     - H_007 와 동일 substrate: 3 elementary CA rule classes
//         ordered  = rule 250 (Class II)
//         chaotic  = rule 30  (Class III)
//         class_iv = rule 110 (Class IV, edge-of-chaos)
//       동일 config N=16 dim=12 warm=8 reps=5 deterministic init.
//     - per rule, *3 가지 integration metric* 을 동시 측정 (mean over reps):
//         (1) phi_spatial  : RFC 036 native replica (현행 proxy)
//         (2) LZ-complexity: state 를 binary sequence 로 → sliding-window
//                            distinct-substring count / length
//                            (deterministic Lempel-Ziv style)
//         (3) entropy-ratio: joint H(adjacent cell pairs) / sum(marginal H)
//                            — mutual-information style (낮을수록 통합 ↑,
//                            ranking 정합 위해 (1 - ratio) 형태 integration
//                            score 로 변환)
//     - 9 measurement → 3×3 matrix.
//     - Spearman rank correlation over the 3 rules:
//         phi_spatial vs LZ · phi_spatial vs entropy · LZ vs entropy.
//     - consensus full-ordering (rule110 > rule30 > rule250) 가 몇 metric
//       에서 성립하나.
//
//   Verdict (pre-registered):
//     CONSISTENT  if C1 (3 metric 모두 IV>ord) AND C2 (phi vs 2 metric
//                 Spearman ≥ 0.7) → phi_spatial robust
//     DIVERGENT   if Spearman < 0.5 → phi_spatial artifact 식별
//     PARTIAL     중간
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → RFC 036 phi_spatial, byte-equal phi_rs replica).
//   Cross-link H_007 (phi_spatial baseline) · gap F4/F8.
// ════════════════════════════════════════════════════════════════════════
import "/tmp/anima-h239/HEXAD/C/c_lib.hexa"

// ── config (deterministic; H_007 parity) ─────────────────────────────────
fn _N() -> int    { return 16 }   // lattice length (periodic)
fn _DIM() -> int  { return 12 }   // recorded temporal-trajectory length / cell
fn _WARM() -> int { return 8 }    // warmup steps before recording
fn _REPS() -> int { return 5 }    // deterministic init offsets
fn _state_dir() -> string {
    return "/tmp/anima-h239/UNIVERSE/state/h239_alt_phi_metric_xval_2026_05_24"
}

// ── small int helpers ─────────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row: site i set iff (i + rep) % 3 != 0 (H_007 parity).
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record each site's dim-step
// trajectory into states[ site*dim + t ]. returns farr (H_007 parity).
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// ── metric (1): phi_spatial (RFC 036) — mean over reps ─────────────────────
fn _metric_phi_spatial(rule: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let nbins = c_phi_n_bins_default()
    let reps = _REPS()
    let mut sum = 0.0
    let mut rep = 0
    while rep < reps {
        let s = _run_ca(rule, n, dim, warm, rep)
        sum = sum + c_measure_phi(s, n, dim, nbins)
        let _ = farr_free(s)
        rep = rep + 1
    }
    return sum / (reps * 1.0)
}

// ── metric (2): LZ-complexity (Lempel-Ziv style, deterministic) ────────────
// state (n × dim) farr → row-major binary sequence (length n*dim) → count of
// distinct substrings discovered by a greedy left-to-right LZ78-style parse.
// complexity := distinct_phrase_count / sequence_length (∈ (0,1]).
//   higher ratio = less compressible = more complex / less ordered.
// for integration *score* we keep raw LZ ratio (high = rich dynamics), which
// matches phi_spatial's "high = integrated" orientation on CA substrates.
fn _seq_bit(states: int, len: int, idx: int) -> int {
    return _ftoi(farr_get(states, idx))
}
// two substrings [a, a+L) and [b, b+L) equal? (bit-wise)
fn _sub_equal(states: int, a: int, b: int, L: int) -> bool {
    let mut k = 0
    while k < L {
        if _seq_bit(states, 0, a + k) != _seq_bit(states, 0, b + k) { return false }
        k = k + 1
    }
    return true
}
fn _lz_complexity(rule: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let reps = _REPS()
    let len = n * dim
    let mut sum_ratio = 0.0
    let mut rep = 0
    while rep < reps {
        let states = _run_ca(rule, n, dim, warm, rep)
        // greedy LZ78-style parse: walk the sequence, at each position grow a
        // phrase until it is NOT a copy of any earlier-starting substring of
        // the same length within the already-scanned prefix; emit a phrase.
        let mut i = 0
        let mut phrases = 0
        while i < len {
            // longest match length L of substring starting at i to any
            // substring starting at j < i (j in scanned prefix).
            let mut L = 1
            let mut grew = true
            while grew && (i + L) <= len {
                // is there j < i with [j, j+L) == [i, i+L) ?
                let mut found = false
                let mut j = 0
                while j < i && !found {
                    if (j + L) <= i {
                        if _sub_equal(states, j, i, L) { found = true }
                    }
                    j = j + 1
                }
                if found { L = L + 1 } else { grew = false }
            }
            // phrase consumes the matched prefix + 1 novel symbol (LZ78), but
            // clamp to remaining length.
            let mut consume = L
            if (i + consume) > len { consume = len - i }
            if consume < 1 { consume = 1 }
            phrases = phrases + 1
            i = i + consume
        }
        let ratio = (phrases * 1.0) / (len * 1.0)
        sum_ratio = sum_ratio + ratio
        let _ = farr_free(states)
        rep = rep + 1
    }
    return sum_ratio / (reps * 1.0)
}

// ── metric (3): entropy-ratio (mutual-information style) ────────────────────
// over the n*dim binary sequence, look at adjacent cell pairs (site s, site
// s+1) across all dim time-steps → joint distribution over 4 symbols (00,01,
// 10,11); marginal distributions per site over 2 symbols.
// integration score := 1 - H_joint / (H_marg_a + H_marg_b)
//   redundancy/shared-info ↑ ⟹ H_joint < H_a + H_b ⟹ ratio ↓ ⟹ score ↑.
//   independent sites: H_joint = H_a + H_b ⟹ score = 0.
// averaged over all adjacent site-pairs and reps (high = integrated).
fn _log2(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return ln(x) / ln(2.0)
}
fn _ent_binary(p1: float) -> float {
    // binary entropy of a bit with P(1)=p1.
    let p0 = 1.0 - p1
    let mut h = 0.0
    if p0 > 0.0 { h = h - p0 * _log2(p0) }
    if p1 > 0.0 { h = h - p1 * _log2(p1) }
    return h
}
fn _entropy_ratio(rule: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let reps = _REPS()
    let mut sum_score = 0.0
    let mut rep = 0
    while rep < reps {
        let states = _run_ca(rule, n, dim, warm, rep)
        // for each adjacent site pair (s, s+1) accumulate joint counts.
        let mut pair_score_sum = 0.0
        let mut pair_count = 0
        let mut s = 0
        while s < n {
            let s2 = (s + 1) % n
            // counts over 4 joint symbols and 2 marginals, across dim steps.
            let mut c00 = 0.0
            let mut c01 = 0.0
            let mut c10 = 0.0
            let mut c11 = 0.0
            let mut a1 = 0.0   // count site s == 1
            let mut b1 = 0.0   // count site s2 == 1
            let mut t = 0
            while t < dim {
                let av = _ftoi(farr_get(states, s * dim + t))
                let bv = _ftoi(farr_get(states, s2 * dim + t))
                if av == 0 && bv == 0 { c00 = c00 + 1.0 }
                if av == 0 && bv == 1 { c01 = c01 + 1.0 }
                if av == 1 && bv == 0 { c10 = c10 + 1.0 }
                if av == 1 && bv == 1 { c11 = c11 + 1.0 }
                if av == 1 { a1 = a1 + 1.0 }
                if bv == 1 { b1 = b1 + 1.0 }
                t = t + 1
            }
            let tot = dim * 1.0
            // joint entropy over 4 symbols
            let p00 = c00 / tot
            let p01 = c01 / tot
            let p10 = c10 / tot
            let p11 = c11 / tot
            let mut hj = 0.0
            if p00 > 0.0 { hj = hj - p00 * _log2(p00) }
            if p01 > 0.0 { hj = hj - p01 * _log2(p01) }
            if p10 > 0.0 { hj = hj - p10 * _log2(p10) }
            if p11 > 0.0 { hj = hj - p11 * _log2(p11) }
            // marginal entropies
            let ha = _ent_binary(a1 / tot)
            let hb = _ent_binary(b1 / tot)
            let denom = ha + hb
            // integration score 1 - Hj/(Ha+Hb); denom==0 ⟹ both sites
            // constant ⟹ no information ⟹ score 0 (ordered floor).
            let mut score = 0.0
            if denom > 0.0 { score = 1.0 - hj / denom }
            if score < 0.0 { score = 0.0 }
            pair_score_sum = pair_score_sum + score
            pair_count = pair_count + 1
            s = s + 1
        }
        let rep_score = pair_score_sum / (pair_count * 1.0)
        sum_score = sum_score + rep_score
        let _ = farr_free(states)
        rep = rep + 1
    }
    return sum_score / (reps * 1.0)
}

// ── Spearman rank correlation over n=3 points (the 3 rules) ────────────────
// rank assignment with average-rank tie handling, then Pearson on ranks.
fn _rank3(v0: float, v1: float, v2: float, which: int) -> float {
    // returns the rank (1-based, average-tie) of element `which` among 3 vals.
    let mut less = 0
    let mut eq = 0
    let me = if which == 0 { v0 } else { if which == 1 { v1 } else { v2 } }
    let mut k = 0
    while k < 3 {
        let other = if k == 0 { v0 } else { if k == 1 { v1 } else { v2 } }
        if other < me { less = less + 1 }
        if other == me { eq = eq + 1 }
        k = k + 1
    }
    // average rank = (less+1 .. less+eq) midpoint
    let base = (less + 1) * 1.0
    let span = (eq - 1) * 1.0
    return base + span / 2.0
}
fn _spearman3(ax: float, bx: float, cx: float, ay: float, by: float, cy: float) -> float {
    let rx0 = _rank3(ax, bx, cx, 0)
    let rx1 = _rank3(ax, bx, cx, 1)
    let rx2 = _rank3(ax, bx, cx, 2)
    let ry0 = _rank3(ay, by, cy, 0)
    let ry1 = _rank3(ay, by, cy, 1)
    let ry2 = _rank3(ay, by, cy, 2)
    // Pearson on the 3 rank pairs.
    let mx = (rx0 + rx1 + rx2) / 3.0
    let my = (ry0 + ry1 + ry2) / 3.0
    let dx0 = rx0 - mx
    let dx1 = rx1 - mx
    let dx2 = rx2 - mx
    let dy0 = ry0 - my
    let dy1 = ry1 - my
    let dy2 = ry2 - my
    let num = dx0 * dy0 + dx1 * dy1 + dx2 * dy2
    let den = sqrt((dx0*dx0 + dx1*dx1 + dx2*dx2) * (dy0*dy0 + dy1*dy1 + dy2*dy2))
    if den <= 0.0 { return 0.0 }
    return num / den
}

// rank-string "IV>cha>ord" style ordering descriptor for one metric column.
fn _ordering(v_iv: float, v_cha: float, v_ord: float) -> string {
    // build descending order of the 3 named values.
    // simple 3-way: produce labels sorted by value desc (stable on ties).
    // we report as "A>B>C".
    let names0 = "IV"
    let names1 = "cha"
    let names2 = "ord"
    // selection sort over 3
    let mut a = v_iv; let mut na = names0
    let mut b = v_cha; let mut nb = names1
    let mut c = v_ord; let mut nc = names2
    // bubble pass 1: ensure a>=b
    if b > a { let ta = a; a = b; b = ta; let tn = na; na = nb; nb = tn }
    if c > a { let ta = a; a = c; c = ta; let tn = na; na = nc; nc = tn }
    if c > b { let tb = b; b = c; c = tb; let tn = nb; nb = nc; nc = tn }
    return na + ">" + nb + ">" + nc
}
fn _full_order_iv_cha_ord(v_iv: float, v_cha: float, v_ord: float) -> bool {
    // is the strict full ordering rule110(IV) > rule30(cha) > rule250(ord)?
    return v_iv > v_cha && v_cha > v_ord
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_239 — alternative-Φ-metric cross-validation (raw#12)")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + " reps=" + to_string(_REPS())
            + "  (deterministic, $0 mac local, llm:none)")
    println("  substrate parity = H_007 (rule 250 ordered · 30 chaotic · 110 Class-IV)")
    println("  3 metric: (1) phi_spatial RFC036 · (2) LZ-complexity · (3) entropy-ratio")
    println("")

    let rule_ord = 250   // Class II — ordered
    let rule_cha = 30    // Class III — chaotic
    let rule_iv  = 110   // Class IV — edge-of-chaos

    // ── 3 metric × 3 rule = 9 measurements ───────────────────────────────
    let phi_ord = _metric_phi_spatial(rule_ord)
    let phi_cha = _metric_phi_spatial(rule_cha)
    let phi_iv  = _metric_phi_spatial(rule_iv)

    let lz_ord = _lz_complexity(rule_ord)
    let lz_cha = _lz_complexity(rule_cha)
    let lz_iv  = _lz_complexity(rule_iv)

    let er_ord = _entropy_ratio(rule_ord)
    let er_cha = _entropy_ratio(rule_cha)
    let er_iv  = _entropy_ratio(rule_iv)

    println("  ── 3×3 metric matrix (rows=metric, cols=rule) ──")
    println("  metric \\ rule       ord(250)        cha(30)         IV(110)")
    println("  phi_spatial    : " + to_string(phi_ord) + "   " + to_string(phi_cha) + "   " + to_string(phi_iv))
    println("  LZ-complexity  : " + to_string(lz_ord)  + "   " + to_string(lz_cha)  + "   " + to_string(lz_iv))
    println("  entropy-ratio  : " + to_string(er_ord)  + "   " + to_string(er_cha)  + "   " + to_string(er_iv))
    println("")

    // ── per-metric ordering (Class-IV vs ordered, full ordering) ─────────
    let phi_iv_gt_ord = phi_iv > phi_ord
    let lz_iv_gt_ord  = lz_iv  > lz_ord
    let er_iv_gt_ord  = er_iv  > er_ord

    let ord_phi = _ordering(phi_iv, phi_cha, phi_ord)
    let ord_lz  = _ordering(lz_iv,  lz_cha,  lz_ord)
    let ord_er  = _ordering(er_iv,  er_cha,  er_ord)

    println("  ── per-metric ranking (descending) ──")
    println("  phi_spatial   ordering: " + ord_phi + "   (IV>ord: " + _bool_str(phi_iv_gt_ord) + ")")
    println("  LZ-complexity ordering: " + ord_lz  + "   (IV>ord: " + _bool_str(lz_iv_gt_ord) + ")")
    println("  entropy-ratio ordering: " + ord_er  + "   (IV>ord: " + _bool_str(er_iv_gt_ord) + ")")
    println("")

    // full ordering rule110 > rule30 > rule250 per metric (H_007 reference).
    let full_phi = _full_order_iv_cha_ord(phi_iv, phi_cha, phi_ord)
    let full_lz  = _full_order_iv_cha_ord(lz_iv,  lz_cha,  lz_ord)
    let full_er  = _full_order_iv_cha_ord(er_iv,  er_cha,  er_ord)
    let mut full_count = 0
    if full_phi { full_count = full_count + 1 }
    if full_lz  { full_count = full_count + 1 }
    if full_er  { full_count = full_count + 1 }

    println("  ── full ordering IV>cha>ord (rule110>rule30>rule250) per metric ──")
    println("  phi_spatial   : " + _bool_str(full_phi))
    println("  LZ-complexity : " + _bool_str(full_lz))
    println("  entropy-ratio : " + _bool_str(full_er))
    println("  consensus full-ordering count (≥2 ⟹ consensus exists): " + to_string(full_count))
    println("")

    // ── Spearman rank correlation over the 3 rules ───────────────────────
    let sp_phi_lz = _spearman3(phi_ord, phi_cha, phi_iv, lz_ord, lz_cha, lz_iv)
    let sp_phi_er = _spearman3(phi_ord, phi_cha, phi_iv, er_ord, er_cha, er_iv)
    let sp_lz_er  = _spearman3(lz_ord,  lz_cha,  lz_iv,  er_ord, er_cha, er_iv)

    println("  ── Spearman rank correlation (n=3 rules) ──")
    println("  phi_spatial vs LZ-complexity : " + to_string(sp_phi_lz))
    println("  phi_spatial vs entropy-ratio : " + to_string(sp_phi_er))
    println("  LZ-complexity vs entropy-ratio: " + to_string(sp_lz_er))
    println("")

    // ── pre-registered criteria + falsifiers ─────────────────────────────
    // C1 (H239.1): 3 metric 모두 Class-IV > ordered
    let c1 = phi_iv_gt_ord && lz_iv_gt_ord && er_iv_gt_ord
    // C2 (H239.2 + H239.3): phi vs LZ Spearman ≥ 0.7 AND phi vs entropy ≥ 0.7
    let h239_2 = sp_phi_lz >= 0.7
    let h239_3 = sp_phi_er >= 0.7
    let c2 = h239_2 && h239_3
    // C3 (H239.4): consensus full-ordering ≥ 2 metric
    let c3 = full_count >= 2
    // F5: any metric NaN/negative
    let all_nonneg = phi_ord >= 0.0 && phi_cha >= 0.0 && phi_iv >= 0.0
                  && lz_ord >= 0.0 && lz_cha >= 0.0 && lz_iv >= 0.0
                  && er_ord >= 0.0 && er_cha >= 0.0 && er_iv >= 0.0
    let f5_ok = all_nonneg

    // verdict_rule: CONSISTENT if C1+C2 PASS · DIVERGENT if min Spearman<0.5
    let min_sp_phi = if sp_phi_lz < sp_phi_er { sp_phi_lz } else { sp_phi_er }
    let mut verdict = "PARTIAL"
    if c1 && c2 { verdict = "CONSISTENT" }
    if min_sp_phi < 0.5 { verdict = "DIVERGENT" }

    println("  ── pre-registered criteria ──")
    println("  C1 (3 metric 모두 IV>ord)            : " + _verdict(c1))
    println("  C2 (phi vs LZ & phi vs entropy ≥0.7) : " + _verdict(c2)
            + "   [H239.2=" + _bool_str(h239_2) + " H239.3=" + _bool_str(h239_3) + "]")
    println("  C3 (consensus full-order ≥2 metric)  : " + _verdict(c3) + "  (count=" + to_string(full_count) + ")")
    println("  F5 (all metric ≥0, no NaN)           : " + _verdict(f5_ok))
    println("")
    println("  VERDICT_RULE: CONSISTENT if C1+C2 · DIVERGENT if min(phi-Spearman)<0.5 · else PARTIAL")
    println("  VERDICT     : " + verdict)
    println("")
    if verdict == "DIVERGENT" {
        println("  → phi_spatial-specific artifact 식별 (gap F4 counterfactual confirmed):")
        println("    본 세션 5 FALSIFIED H 의 negative 가 metric 선택에 의존 — H_222/H_207 재평가 lane.")
    }
    if verdict == "CONSISTENT" {
        println("  → phi_spatial robust (metric-agnostic): 5 FALSIFIED 가 진짜 negative.")
    }

    // ── write result.json (full ledger) ──────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_239\",\n"
    j = j + "  \"slug\": \"alternative-phi-metric-cross-validation\",\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"gap_lens\": \"F4 counterfactual + F8 cross-tool-consistency\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"reps\": " + to_string(_REPS())
          + ", \"n_bins\": " + to_string(c_phi_n_bins_default()) + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"rules\": { \"ordered\": 250, \"chaotic\": 30, \"class_iv\": 110 },\n"
    j = j + "  \"wolfram_class\": { \"250\": \"II\", \"30\": \"III\", \"110\": \"IV\" },\n"
    j = j + "  \"metrics\": {\n"
    j = j + "    \"phi_spatial\":  { \"ordered_rule250\": " + to_string(phi_ord) + ", \"chaotic_rule30\": " + to_string(phi_cha) + ", \"class_iv_rule110\": " + to_string(phi_iv) + " },\n"
    j = j + "    \"lz_complexity\":{ \"ordered_rule250\": " + to_string(lz_ord)  + ", \"chaotic_rule30\": " + to_string(lz_cha)  + ", \"class_iv_rule110\": " + to_string(lz_iv)  + " },\n"
    j = j + "    \"entropy_ratio\":{ \"ordered_rule250\": " + to_string(er_ord)  + ", \"chaotic_rule30\": " + to_string(er_cha)  + ", \"class_iv_rule110\": " + to_string(er_iv)  + " }\n"
    j = j + "  },\n"
    j = j + "  \"orderings\": {\n"
    j = j + "    \"phi_spatial\": \"" + ord_phi + "\",\n"
    j = j + "    \"lz_complexity\": \"" + ord_lz + "\",\n"
    j = j + "    \"entropy_ratio\": \"" + ord_er + "\"\n"
    j = j + "  },\n"
    j = j + "  \"full_ordering_iv_cha_ord\": { \"phi_spatial\": " + _bool_str(full_phi)
          + ", \"lz_complexity\": " + _bool_str(full_lz) + ", \"entropy_ratio\": " + _bool_str(full_er)
          + ", \"consensus_count\": " + to_string(full_count) + " },\n"
    j = j + "  \"spearman\": {\n"
    j = j + "    \"phi_vs_lz\": " + to_string(sp_phi_lz) + ",\n"
    j = j + "    \"phi_vs_entropy\": " + to_string(sp_phi_er) + ",\n"
    j = j + "    \"lz_vs_entropy\": " + to_string(sp_lz_er) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_3metric_iv_gt_ord\": { \"verdict\": \"" + _verdict(c1) + "\" },\n"
    j = j + "    \"C2_phi_spearman_ge_0p7\": { \"h239_2_phi_vs_lz\": " + _bool_str(h239_2) + ", \"h239_3_phi_vs_entropy\": " + _bool_str(h239_3) + ", \"verdict\": \"" + _verdict(c2) + "\" },\n"
    j = j + "    \"C3_consensus_full_order\": { \"count\": " + to_string(full_count) + ", \"verdict\": \"" + _verdict(c3) + "\" },\n"
    j = j + "    \"F5_all_nonneg\": { \"verdict\": \"" + _verdict(f5_ok) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"CONSISTENT if C1+C2 PASS · DIVERGENT if min(phi-Spearman)<0.5 · else PARTIAL\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_239 alt-Φ-metric cross-validation complete: " + verdict + " ===")
}
