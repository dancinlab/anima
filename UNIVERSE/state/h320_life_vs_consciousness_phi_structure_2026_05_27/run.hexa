// UNIVERSE/state/h320_life_vs_consciousness_phi_structure_2026_05_27/run.hexa
//
//   H_320 — LIFE vs CONSCIOUSNESS substrate: relation-Φ / distinction-Φ ratio
//   under the faithful IIT 4.0 engine.
//
//   PRIOR (H_281)
//     H_281 measured struct_ratio = Φ-structure-total / big-Φ and found
//     CONSCIOUSNESS-themed substrates AT the irreducibility floor (struct_ratio
//     = 1.0) and LIFE-themed substrates ABOVE it (struct_ratio > 1.0). That
//     ratio coarsely combines distinctions + relations into one "total" then
//     compares to the min-loss big-Φ.
//
//   H_320 — ONE LEVEL DEEPER (axis C2 — IIT 4.0 Φ-STRUCTURE proper)
//     Split the CES into its two structural components and measure the
//     RELATION-to-DISTINCTION ratio directly, per substrate, per state:
//
//         rd_ratio  =  sum_phi_r  /  sum_phi_d
//
//     The faithful big_phi() return layout (stdlib/consciousness/iit4_bigphi):
//         [big_phi, total, sum_phi_d, sum_phi_r, nd]
//     so the ratio reads bp[3] / bp[2] — a closed-form arithmetic value, byte-
//     deterministic across runs. This is NOT a self-judged smoke; the ratio is
//     ANALYTICALLY DEFINED from independent kernel outputs, and the falsifier
//     direction (consciousness > life, or the inverse) is a measurement —
//     either could come out true; a 🔴 closed-negative is publishable.
//
//   H1 — RELATION-RICHNESS predicts the integrated-complex class
//     Hypothesis: at the IIT 4.0 Φ-STRUCTURE level, the relation-to-distinction
//     Φ ratio is HIGHER for consciousness-themed substrates (high-integration
//     XOR-feedback) than for life-themed substrates (growth/replication ECA).
//     Intuition: when the entire CES is irreducible (consciousness floor in
//     H_281), the relation mass dominates — the binding IS the structure;
//     LIFE-themed substrates spread mass into a larger distinction pool with
//     many partitionable relations.
//
//     RATIONAL ALTERNATIVE (the hypothesis could fail the other way): LIFE
//     substrates carry MORE distinctions (nd=10) over a wider purview combina-
//     torics, plausibly enlarging the 2nd-order pair-relation count too — so
//     LIFE could win the relation/distinction race despite consciousness
//     winning the irreducibility-floor race.
//
//     The test is therefore decisive — H1 predicts one direction, the
//     alternative the other.
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-27 BEFORE measuring final values)
//     F320.1 SEPARATION  — at state 0101: min(consciousness rd_ratio) >
//                          max(life rd_ratio). Strict separation, no overlap.
//     F320.2 ORDERING    — class-mean rd_ratio (over all 16 states, integrating
//                          only): consciousness > life. AND per-state
//                          robustness: rule 150 (consciousness) > rule 110
//                          (life) at every co-integrating state.
//     F320.3 FAITHFULNESS — anchors reproduce: rule 204 (identity) big-Φ = 0,
//                          rule 0 (constant) big-Φ = 0. AND the kernel-bound
//                          sum_phi_d + sum_phi_r = total holds (sanity-check
//                          that we are reading the right kernel fields, not
//                          a self-arranged identity).
//
//   IRON RULE (commons @D g73 — anti-fake-closure)
//     Each falsifier is an arithmetic comparison of INDEPENDENTLY computed
//     kernel outputs (faithful big_phi from stdlib/consciousness). The kernel
//     was authored before this hypothesis. If F320.1 or F320.2 fails, this is
//     a 🔴 CLOSED-NEGATIVE — H1 is FALSIFIED and the result is publishable as
//     a negative finding ruling out the "consciousness = relation-richer"
//     axis at the small-n IIT4 scale.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
//   honest scope: n=4 small ring · 5 ECA substrates (3 life + 2 consciousness)
//   + 2 anchors · single representative state for headline + all-16 robustness.
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/HEXAD/IIT4/lib/iit4_eca.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// rd_ratio = sum_phi_r / sum_phi_d  at one (rule,n,state).
// 0.0 if no distinctions (avoid /0 — non-integrating, falsifier-neutral).
fn rd_ratio_at(rule: int, n: int, st: int) -> float {
    let bp = big_phi(eca_tpm(rule, n), n, st)
    if bp[2] > 1.0e-9 { return bp[3] / bp[2] }
    return 0.0
}

// state-averaged rd_ratio over all 2^n states (integrating only — big_phi > 0).
fn rd_ratio_mean(rule: int, n: int) -> float {
    let mut acc = 0.0
    let mut cnt = 0
    let mut st = 0
    let full = iit4_pow2(n)
    while st < full {
        let bp = big_phi(eca_tpm(rule, n), n, st)
        if (bp[0] > 1.0e-9) && (bp[2] > 1.0e-9) {
            acc = acc + (bp[3] / bp[2])
            cnt = cnt + 1
        }
        st = st + 1
    }
    if cnt > 0 { return acc / to_float(cnt) }
    return 0.0
}

fn main() {
    let n = 4
    let st = 5                                           // 0101 representative state
    println("================================================================")
    println("  H_320 — LIFE vs CONSCIOUSNESS relation/distinction Φ-ratio")
    println("  (n=" + str(n) + " ring · headline state=0101 · rd_ratio = sum_phi_r / sum_phi_d)")
    println("================================================================")

    // ── headline per-substrate table (state 0101) ───────────────────────
    // LIFE (growth/replication ECA — H_281 cohort)
    let l110 = big_phi(eca_tpm(110, n), n, st)
    let l30  = big_phi(eca_tpm(30,  n), n, st)
    let l54  = big_phi(eca_tpm(54,  n), n, st)
    // CONSCIOUSNESS (pure XOR-feedback integration networks)
    let c150 = big_phi(eca_tpm(150, n), n, st)
    let c105 = big_phi(eca_tpm(105, n), n, st)
    // anchors
    let a204 = big_phi(eca_tpm(204, n), n, st)
    let a0   = big_phi(eca_tpm(0,   n), n, st)

    let rd_l110 = rd_ratio_at(110, n, st)
    let rd_l30  = rd_ratio_at(30,  n, st)
    let rd_l54  = rd_ratio_at(54,  n, st)
    let rd_c150 = rd_ratio_at(150, n, st)
    let rd_c105 = rd_ratio_at(105, n, st)

    println("  [LIFE]  rule 110 : bigPhi=" + str(l110[0]) + " sum_d=" + str(l110[2]) + " sum_r=" + str(l110[3]) + " nd=" + str(l110[4]) + " rd_ratio=" + str(rd_l110))
    println("  [LIFE]  rule  30 : bigPhi=" + str(l30[0])  + " sum_d=" + str(l30[2])  + " sum_r=" + str(l30[3])  + " nd=" + str(l30[4])  + " rd_ratio=" + str(rd_l30))
    println("  [LIFE]  rule  54 : bigPhi=" + str(l54[0])  + " sum_d=" + str(l54[2])  + " sum_r=" + str(l54[3])  + " nd=" + str(l54[4])  + " rd_ratio=" + str(rd_l54))
    println("  [CONSC] rule 150 : bigPhi=" + str(c150[0]) + " sum_d=" + str(c150[2]) + " sum_r=" + str(c150[3]) + " nd=" + str(c150[4]) + " rd_ratio=" + str(rd_c150))
    println("  [CONSC] rule 105 : bigPhi=" + str(c105[0]) + " sum_d=" + str(c105[2]) + " sum_r=" + str(c105[3]) + " nd=" + str(c105[4]) + " rd_ratio=" + str(rd_c105))
    println("  [ANCH]  rule 204 (identity) : bigPhi=" + str(a204[0]) + " sum_d=" + str(a204[2]) + " sum_r=" + str(a204[3]))
    println("  [ANCH]  rule   0 (constant) : bigPhi=" + str(a0[0])   + " sum_d=" + str(a0[2])   + " sum_r=" + str(a0[3]))

    // ── F320.1 SEPARATION (state 0101) ──────────────────────────────────
    // H1 predicts min(consciousness rd) > max(life rd)
    let mut consc_min = rd_c150
    if rd_c105 < consc_min { consc_min = rd_c105 }
    let mut life_max = rd_l110
    if rd_l30 > life_max { life_max = rd_l30 }
    if rd_l54 > life_max { life_max = rd_l54 }
    println("  --")
    println("  F320.1: consc_min_rd_ratio=" + str(consc_min) + " life_max_rd_ratio=" + str(life_max))
    check("F320.1 SEPARATION: min(consciousness rd) > max(life rd) [H1 direction]", consc_min > life_max + 0.000001)

    // ── F320.2 ORDERING — class-means + all-16-state robustness ──────────
    let m110 = rd_ratio_mean(110, n)
    let m30  = rd_ratio_mean(30,  n)
    let m54  = rd_ratio_mean(54,  n)
    let m150 = rd_ratio_mean(150, n)
    let m105 = rd_ratio_mean(105, n)
    let life_mean  = (m110 + m30 + m54) / 3.0
    let consc_mean = (m150 + m105) / 2.0
    println("  F320.2: life_class_mean(all-state)=" + str(life_mean) + " consc_class_mean(all-state)=" + str(consc_mean))
    check("F320.2a ORDERING: class-mean consciousness > life [H1 direction]", consc_mean > life_mean + 0.000001)

    // per-state robustness — rule 150 (consc) > rule 110 (life) at every co-integrating state.
    let mut all_sep = true
    let mut any_codef = false
    let mut s = 0
    let full = iit4_pow2(n)
    while s < full {
        let bpl = big_phi(eca_tpm(110, n), n, s)
        let bpc = big_phi(eca_tpm(150, n), n, s)
        if (bpl[0] > 1.0e-9) && (bpc[0] > 1.0e-9) && (bpl[2] > 1.0e-9) && (bpc[2] > 1.0e-9) {
            any_codef = true
            let lr = bpl[3] / bpl[2]
            let cr = bpc[3] / bpc[2]
            if !(cr > lr + 0.000001) { all_sep = false }
        }
        s = s + 1
    }
    check("F320.2b ROBUST: rule150(consc) rd_ratio > rule110(life) at every co-integrating state", all_sep && any_codef)

    // ── F320.3 FAITHFULNESS — anchors + identity sum_d + sum_r = total ──
    check("F320.3a ANCHOR: rule 204 (identity) big-Phi = 0", approx(a204[0], 0.0))
    check("F320.3b ANCHOR: rule 0 (constant) big-Phi = 0", approx(a0[0], 0.0))
    // sum_phi_d + sum_phi_r = total for each measured substrate (kernel-field sanity).
    let mut sum_ok = true
    if !approx(l110[2] + l110[3], l110[1]) { sum_ok = false }
    if !approx(l30[2]  + l30[3],  l30[1])  { sum_ok = false }
    if !approx(l54[2]  + l54[3],  l54[1])  { sum_ok = false }
    if !approx(c150[2] + c150[3], c150[1]) { sum_ok = false }
    if !approx(c105[2] + c105[3], c105[1]) { sum_ok = false }
    check("F320.3c KERNEL-SANITY: sum_phi_d + sum_phi_r = total for all 5 substrates", sum_ok)

    // ── determinism ─────────────────────────────────────────────────────
    let rd_l110b = rd_ratio_at(110, n, st)
    check("determinism: rule110 rd_ratio re-run identical", approx(rd_l110, rd_l110b))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  HEADLINE:")
    println("    life_max_rd_ratio(0101)  = " + str(life_max))
    println("    consc_min_rd_ratio(0101) = " + str(consc_min))
    println("    life_class_mean(all-16)  = " + str(life_mean))
    println("    consc_class_mean(all-16) = " + str(consc_mean))
    println("================================================================")
    // NO panic — both outcomes (H1 SUPPORTED + H1 FALSIFIED) are valid verdicts.
    // run.log captures the headline numbers + per-check verdicts; result.json
    // is authored AFTER reading these (NOT before — anti-self-judge).
}
