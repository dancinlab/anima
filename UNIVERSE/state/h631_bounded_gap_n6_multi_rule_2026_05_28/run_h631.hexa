// UNIVERSE/state/h631_bounded_gap_n6_multi_rule_2026_05_28/run_h631.hexa
//
//   H_631 — bounded-gap cap-sweep · state-averaged multi-rule (H_625 후속)
//          (UNIVERSE 축 B B2 deferred — state-average 회수 · n=6 DEMOTE→n=5)
//
//   ⚠ n=6 INFEASIBLE (timing-probed 2026-05-28):
//     n=6 cap=6 exact bigΦ > 10min (단일 state, killed) · cap=5 > 2min · cap=4
//     > 3min — 모든 cap 이 60s 예산 초과. 원인 = 2nd-order relation 비용이
//     surviving-distinction nd² 로 폭증 (cap 가 large purview 만 자르고 nd 는
//     n=6 에서 여전히 큼). [[reference-exact-phi-structure-wall-shard]] 정합.
//     → 사전 지정 fallback 발동: **n=5 state-averaged 로 demote** (honest 명시).
//
//   QUESTION
//     H_625 (PR #1199, 🟢 17/17) 가 n=5 SINGLE-state (st=21) cap-sweep 로
//     gap(k) := big_phi(exact) − big_phi_bounded(cap=k) 가 *지수 감소*
//     (gap(k) ≈ C·exp(−α·k)) 임을 3-rule {30,90,110} 에서 확증했다.
//     honest C3 #2 잔여 = "single-state st=21 만 (state-averaged 아님)".
//     본 H_631 이 그 C3 를 회수 — 전 32 state 평균으로도 지수 형상 + rule
//     순서가 유지되는가?
//
//   HYPOTHESES
//     H1 (STATE-AVERAGED EXP-DECAY)
//        n=5 ring 에서 전 32 state 의 평균 bounded big-Φ 로 만든 gap(k) 도
//        지수 감소한다 (α>0, 단조).
//     H2 (RULE-ORDER PRESERVE)
//        state-averaged α 의 rule 순서가 single-state(H_625) 와 동일 —
//        특히 rule110 (class-IV) 이 30/90 (chaotic/linear) 보다 빠른 수렴.
//
//   FALSIFIER (frozen 2026-05-28, BEFORE state-avg measure)
//     F631.1 SA-MONOTONE  — state-avg gap(k) (약)단조 감소 (g(k+1)<=g(k)+eps).
//     F631.2 SA-FAITHFUL  — cap=5 에서 gap(5) ≈ 0 (cap≥n exact identity).
//     F631.3 SA-EXP-SHAPE — state-avg 인접 ratio r=g(k+1)/g(k) 에서 0<r<1 인
//            쌍 ≥1, α=−mean(ln r)>0 추출 가능 (3 rule 모두).
//     F631.4 SA-NONNEG    — 모든 state-avg bounded(k) >=0 AND <= exact.
//     F631.5 DETERMINISM  — state-avg bounded(cap=3, rule30) 재실행 동일.
//     F631.6 RULE-COVER   — 3 rule {30,90,110} 모두 state-avg 지수 형상.
//     F631.7 ORDER-PRESERVE — state-avg α 의 rule110 >= 30 AND >= 90
//            (class-IV 최속, single-state H_625 순서 보존). 반대 면 = H2 FAL.
//     F631.8 SINGLE-ANCHOR — single-state st=21 재측정이 H_625 와 동일
//            (rule110 single α ~ 1.101, 회귀 anchor).
//
//   METHOD (re-use HEXAD/IIT4/lib + stdlib · g61) — n=5 fixed ring
//     • eca_tpm(rule, 5) → state-by-node TPM (2^5 = 32 states)
//     • SINGLE st=21 (10101, H_625 anchor) + STATE-AVG (mean over 32 states)
//     • cap ∈ {1..5}, cap=5 = faithful (== exact)
//     • rule ∈ {30, 90, 110}
//     • gap(k) = bounded(cap=5) − bounded(cap=k)
//     • α extract via natural-log on adjacent ratios (Mercator inline)
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/u-h631/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0
let N = 5
let NSTATES = 32

fn abs_f(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}
fn approx_zero(a: float) -> bool { return abs_f(a) < 0.000001 }
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn ln_2() -> float { return 0.6931471805599453 }
fn ln_natural(y: float) -> float {
    let mut z = y
    let mut k_half = 0
    while z > 1.5 {
        z = z * 0.5
        k_half = k_half + 1
    }
    let x = z - 1.0
    let mut acc = 0.0
    let mut term = x
    let mut i = 1
    while i <= 80 {
        let s_term = if (i % 2) == 1 { term / to_float(i) } else { 0.0 - term / to_float(i) }
        acc = acc + s_term
        term = term * x
        i = i + 1
    }
    return acc + to_float(k_half) * ln_2()
}

// SINGLE-state bounded big-Φ @ rule, n=5, st=21, cap.
fn sweep_single(rule: int) -> array {
    let tpm = eca_tpm(rule, N)
    let mut out = []
    let mut k = 1
    while k <= 5 {
        let r = big_phi_bounded(tpm, N, 21, k)
        out = out.push(r[0])
        k = k + 1
    }
    return out
}

// STATE-AVERAGED bounded big-Φ: mean over all 32 states, per cap 1..5.
fn sweep_stateavg(rule: int) -> array {
    let tpm = eca_tpm(rule, N)
    let mut out = []
    let mut k = 1
    while k <= 5 {
        let mut acc = 0.0
        let mut st = 0
        while st < NSTATES {
            let r = big_phi_bounded(tpm, N, st, k)
            acc = acc + r[0]
            st = st + 1
        }
        out = out.push(acc / to_float(NSTATES))
        k = k + 1
    }
    return out
}

// gap(k) = exact(=cap5) - bounded(cap=k), length 5 (gap[4]=0).
fn gaps(b: array) -> array {
    let exact_v = b[4]
    let mut g = []
    let mut k = 0
    while k < 5 {
        g = g.push(exact_v - b[k])
        k = k + 1
    }
    return g
}

fn monotone_gap(g: array) -> bool {
    let mut k = 0
    while k < 4 {
        if g[k + 1] > g[k] + 0.000001 { return false }
        k = k + 1
    }
    return true
}

fn nonneg_bounded(b: array) -> bool {
    let exact_v = b[4]
    let mut k = 0
    while k < 5 {
        if b[k] < 0.0 - 0.000001 { return false }
        if b[k] > exact_v + 0.000001 { return false }
        k = k + 1
    }
    return true
}

// α = mean(-ln(r)) over consecutive positive-gap ratios (pairs 0..3).
fn extract_alpha(g: array) -> array {
    let mut sum = 0.0
    let mut cnt = 0
    let mut k = 0
    while k < 3 {
        let a_g = g[k]
        let b_g = g[k + 1]
        if a_g > 0.000001 {
            if b_g > 0.0 {
                let r = b_g / a_g
                if r > 0.000001 {
                    let log_r = ln_natural(r)
                    sum = sum + (0.0 - log_r)
                    cnt = cnt + 1
                }
            }
        }
        k = k + 1
    }
    let mut alpha_v = 0.0
    if cnt > 0 { alpha_v = sum / to_float(cnt) }
    return [alpha_v, to_float(cnt)]
}

fn print_row(label: string, b: array) {
    println("    " + label + ": c1=" + str(b[0]) + " c2=" + str(b[1]) + " c3=" + str(b[2]) + " c4=" + str(b[3]) + " c5=" + str(b[4]))
}
fn print_gaps(label: string, g: array) {
    println("    " + label + ": g1=" + str(g[0]) + " g2=" + str(g[1]) + " g3=" + str(g[2]) + " g4=" + str(g[3]) + " g5=" + str(g[4]))
}

fn main() {
    println("================================================================")
    println("  H_631 — bounded-gap state-averaged cap-sweep @ n=5 (H_625 후속)")
    println("  rules {30,90,110} · cap 1..5 (c5=exact) · single st=21 + STATE-AVG(32)")
    println("  ⚠ n=6 INFEASIBLE (cap6>10min) → n=5 state-avg DEMOTE per fallback")
    println("================================================================")

    // ── ln_natural self-check ────────────────────────────────────────────
    let ln_e_check = ln_natural(2.718281828459045)
    let ln_2_check = ln_natural(2.0)
    let ln_4_check = ln_natural(4.0)
    println("  ln self-check: ln(e)=" + str(ln_e_check) + " ln(2)=" + str(ln_2_check) + " ln(4)=" + str(ln_4_check))
    check("ln_natural(e) ~ 1.0", abs_f(ln_e_check - 1.0) < 0.001)
    check("ln_natural(2) ~ 0.6931", abs_f(ln_2_check - 0.6931471) < 0.001)
    check("ln_natural(4) ~ 1.3863", abs_f(ln_4_check - 1.3862944) < 0.001)

    // ── SINGLE-state (st=21) anchor — reproduces H_625 ───────────────────
    println("  --- SINGLE-state st=21 (10101) [H_625 anchor] ---")
    let s30  = sweep_single(30)
    let s90  = sweep_single(90)
    let s110 = sweep_single(110)
    print_row("rule  30", s30)
    print_row("rule  90", s90)
    print_row("rule 110", s110)
    let gs30  = gaps(s30)
    let gs90  = gaps(s90)
    let gs110 = gaps(s110)
    let as30  = extract_alpha(gs30)
    let as90  = extract_alpha(gs90)
    let as110 = extract_alpha(gs110)
    println("  SINGLE α (30/90/110) = " + str(as30[0]) + " / " + str(as90[0]) + " / " + str(as110[0]))

    // ── STATE-AVERAGED (mean over 32 states) ─────────────────────────────
    println("  --- STATE-AVERAGED (mean over 32 states) ---")
    let a30  = sweep_stateavg(30)
    let a90  = sweep_stateavg(90)
    let a110 = sweep_stateavg(110)
    print_row("rule  30", a30)
    print_row("rule  90", a90)
    print_row("rule 110", a110)
    let ga30  = gaps(a30)
    let ga90  = gaps(a90)
    let ga110 = gaps(a110)
    println("  gap(k) state-avg = exact(c5) - bounded(c=k):")
    print_gaps("rule  30", ga30)
    print_gaps("rule  90", ga90)
    print_gaps("rule 110", ga110)
    let aa30  = extract_alpha(ga30)
    let aa90  = extract_alpha(ga90)
    let aa110 = extract_alpha(ga110)
    println("  STATE-AVG α (30/90/110) = " + str(aa30[0]) + " / " + str(aa90[0]) + " / " + str(aa110[0]))

    // ── F631.1 SA-MONOTONE ───────────────────────────────────────────────
    check("F631.1 rule 30 state-avg gap monotone",  monotone_gap(ga30))
    check("F631.1 rule 90 state-avg gap monotone",  monotone_gap(ga90))
    check("F631.1 rule 110 state-avg gap monotone", monotone_gap(ga110))

    // ── F631.2 SA-FAITHFUL ───────────────────────────────────────────────
    check("F631.2 rule 30 state-avg gap(c5) ~ 0",  approx_zero(ga30[4]))
    check("F631.2 rule 90 state-avg gap(c5) ~ 0",  approx_zero(ga90[4]))
    check("F631.2 rule 110 state-avg gap(c5) ~ 0", approx_zero(ga110[4]))

    // ── F631.3 SA-EXP-SHAPE (α>0) ────────────────────────────────────────
    let exp_a30  = (aa30[1]  >= 1.0) && (aa30[0]  > 0.0)
    let exp_a90  = (aa90[1]  >= 1.0) && (aa90[0]  > 0.0)
    let exp_a110 = (aa110[1] >= 1.0) && (aa110[0] > 0.0)
    check("F631.3 rule 30 state-avg exp-shape (α>0)",  exp_a30)
    check("F631.3 rule 90 state-avg exp-shape (α>0)",  exp_a90)
    check("F631.3 rule 110 state-avg exp-shape (α>0)", exp_a110)

    // ── F631.4 SA-NONNEG ─────────────────────────────────────────────────
    check("F631.4 rule 30 state-avg nonneg+lowerbound",  nonneg_bounded(a30))
    check("F631.4 rule 90 state-avg nonneg+lowerbound",  nonneg_bounded(a90))
    check("F631.4 rule 110 state-avg nonneg+lowerbound", nonneg_bounded(a110))

    // ── F631.5 DETERMINISM (state-avg cap=3 rule30 re-run) ───────────────
    let tpm30 = eca_tpm(30, N)
    let mut acc_re = 0.0
    let mut st_re = 0
    while st_re < NSTATES {
        let r = big_phi_bounded(tpm30, N, st_re, 3)
        acc_re = acc_re + r[0]
        st_re = st_re + 1
    }
    let rerun = acc_re / to_float(NSTATES)
    check("F631.5 rule 30 state-avg cap=3 deterministic re-run", abs_f(rerun - a30[2]) < 0.000001)

    // ── F631.6 RULE-COVER ────────────────────────────────────────────────
    check("F631.6 ALL 3 rules state-avg exp-shape (rule-cover)", exp_a30 && exp_a90 && exp_a110)

    // ── F631.7 ORDER-PRESERVE (state-avg rule110 α >= 30,90) ─────────────
    let order_savg = (aa110[0] >= aa30[0]) && (aa110[0] >= aa90[0])
    check("F631.7 state-avg rule110 α >= 30,90 (class-IV fastest preserved)", order_savg)

    // ── F631.8 SINGLE-ANCHOR (H_625 regression — rule110 single α ~ 1.101)
    check("F631.8 single rule110 α ~ 1.101 (H_625 anchor regression)", abs_f(as110[0] - 1.101) < 0.05)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  SINGLE   α (30/90/110) = " + str(as30[0]) + " / " + str(as90[0]) + " / " + str(as110[0]))
    println("  STATE-AVG α (30/90/110) = " + str(aa30[0]) + " / " + str(aa90[0]) + " / " + str(aa110[0]))
    println("================================================================")
    if FAIL > 0 { panic("H_631 bounded-gap state-averaged cap-sweep FAILED") }
}
