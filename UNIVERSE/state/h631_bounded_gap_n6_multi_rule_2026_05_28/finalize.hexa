// H_631 finalize — α + falsifiers from pre-computed bounded big-Φ arrays.
// NO big_phi_bounded calls (pure arithmetic) → instant.
let mut PASS = 0
let mut FAIL = 0
fn abs_f(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }
fn approx_zero(a: float) -> bool { return abs_f(a) < 0.000001 }
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn ln_2() -> float { return 0.6931471805599453 }
fn ln_natural(y: float) -> float {
    let mut z = y
    let mut k_half = 0
    while z > 1.5 { z = z * 0.5; k_half = k_half + 1 }
    let x = z - 1.0
    let mut acc = 0.0
    let mut term = x
    let mut i = 1
    while i <= 80 {
        let s_term = if (i % 2) == 1 { term / to_float(i) } else { 0.0 - term / to_float(i) }
        acc = acc + s_term
        term = term * x
        i = i + 1
    }
    return acc + to_float(k_half) * ln_2()
}
fn gaps(b: array) -> array {
    let e = b[4]
    let mut g = []
    let mut k = 0
    while k < 5 { g = g.push(e - b[k]); k = k + 1 }
    return g
}
fn monotone_gap(g: array) -> bool {
    let mut k = 0
    while k < 4 { if g[k + 1] > g[k] + 0.000001 { return false } k = k + 1 }
    return true
}
fn nonneg_bounded(b: array) -> bool {
    let e = b[4]
    let mut k = 0
    while k < 5 { if b[k] < 0.0 - 0.000001 { return false } if b[k] > e + 0.000001 { return false } k = k + 1 }
    return true
}
fn extract_alpha(g: array) -> array {
    let mut sum = 0.0
    let mut cnt = 0
    let mut k = 0
    while k < 3 {
        let a_g = g[k]
        let b_g = g[k + 1]
        if a_g > 0.000001 {
            if b_g > 0.0 {
                let r = b_g / a_g
                if r > 0.000001 { sum = sum + (0.0 - ln_natural(r)); cnt = cnt + 1 }
            }
        }
        k = k + 1
    }
    let mut av = 0.0
    if cnt > 0 { av = sum / to_float(cnt) }
    return [av, to_float(cnt)]
}
fn pg(label: string, g: array) {
    println("    " + label + ": g1=" + str(g[0]) + " g2=" + str(g[1]) + " g3=" + str(g[2]) + " g4=" + str(g[3]) + " g5=" + str(g[4]))
}

fn main() {
    println("================================================================")
    println("  H_631 finalize — α + falsifiers (n=5, cap1..5, c5=exact)")
    println("================================================================")

    // SINGLE-state st=21 (reproduces H_625 verbatim)
    let s30  = [1.31617, 1.31617, 4.28064, 20.2686, 37.9333]
    let s90  = [0.0, 0.0, 6.0, 19.5, 44.5]
    let s110 = [0.667596, 6.69887, 15.3963, 17.694, 18.3442]
    // STATE-AVERAGED (8-state Hamming-stratified subset {0,1,3,7,15,31,21,10})
    let a30  = [1.31617, 1.31617, 6.8231, 25.9101, 40.756]
    let a90  = [0.0, 0.0, 6.375, 22.4375, 50.875]
    let a110 = [1.4503, 7.97143, 23.3923, 27.1777, 28.4354]

    let gs30 = gaps(s30); let gs90 = gaps(s90); let gs110 = gaps(s110)
    let ga30 = gaps(a30); let ga90 = gaps(a90); let ga110 = gaps(a110)
    let as30 = extract_alpha(gs30); let as90 = extract_alpha(gs90); let as110 = extract_alpha(gs110)
    let aa30 = extract_alpha(ga30); let aa90 = extract_alpha(ga90); let aa110 = extract_alpha(ga110)

    println("  SINGLE gap(k):")
    pg("rule  30", gs30); pg("rule  90", gs90); pg("rule 110", gs110)
    println("  STATE-AVG gap(k):")
    pg("rule  30", ga30); pg("rule  90", ga90); pg("rule 110", ga110)
    println("  SINGLE   α (30/90/110) = " + str(as30[0]) + " / " + str(as90[0]) + " / " + str(as110[0]))
    println("  STATE-AVG α (30/90/110) = " + str(aa30[0]) + " / " + str(aa90[0]) + " / " + str(aa110[0]))

    // F631.1 SA-MONOTONE
    check("F631.1 r30 state-avg gap monotone",  monotone_gap(ga30))
    check("F631.1 r90 state-avg gap monotone",  monotone_gap(ga90))
    check("F631.1 r110 state-avg gap monotone", monotone_gap(ga110))
    // F631.2 SA-FAITHFUL
    check("F631.2 r30 state-avg gap(c5)~0",  approx_zero(ga30[4]))
    check("F631.2 r90 state-avg gap(c5)~0",  approx_zero(ga90[4]))
    check("F631.2 r110 state-avg gap(c5)~0", approx_zero(ga110[4]))
    // F631.3 SA-EXP-SHAPE (α>0)
    let ea30 = (aa30[1] >= 1.0) && (aa30[0] > 0.0)
    let ea90 = (aa90[1] >= 1.0) && (aa90[0] > 0.0)
    let ea110 = (aa110[1] >= 1.0) && (aa110[0] > 0.0)
    check("F631.3 r30 state-avg exp-shape (α>0)",  ea30)
    check("F631.3 r90 state-avg exp-shape (α>0)",  ea90)
    check("F631.3 r110 state-avg exp-shape (α>0)", ea110)
    // F631.4 SA-NONNEG
    check("F631.4 r30 state-avg nonneg+lowerbound",  nonneg_bounded(a30))
    check("F631.4 r90 state-avg nonneg+lowerbound",  nonneg_bounded(a90))
    check("F631.4 r110 state-avg nonneg+lowerbound", nonneg_bounded(a110))
    // F631.6 RULE-COVER
    check("F631.6 ALL 3 rules state-avg exp-shape", ea30 && ea90 && ea110)
    // F631.7 ORDER-PRESERVE (rule110 fastest in both modes)
    let order_single = (as110[0] >= as30[0]) && (as110[0] >= as90[0])
    let order_savg   = (aa110[0] >= aa30[0]) && (aa110[0] >= aa90[0])
    check("F631.7a single rule110 α >= 30,90 (H_625 order)", order_single)
    check("F631.7b state-avg rule110 α >= 30,90 (order preserved)", order_savg)
    // F631.8 SINGLE-ANCHOR (H_625 regression)
    check("F631.8 single r30 α ~ 0.243",   abs_f(as30[0] - 0.243) < 0.02)
    check("F631.8 single r90 α ~ 0.192",   abs_f(as90[0] - 0.192) < 0.02)
    check("F631.8 single r110 α ~ 1.101",  abs_f(as110[0] - 1.101) < 0.02)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("H_631 finalize FAILED") }
}
