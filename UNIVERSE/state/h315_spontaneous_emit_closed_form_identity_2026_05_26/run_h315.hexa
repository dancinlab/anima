// H_315 — spontaneous emit closed-form identity 🔵 path
// 3 symbolic identities × H_306/H_310 measurements byte-equal check
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ════════════════════════════════════════════════════════════════════════════
// IDENTITY 1: WAKE-emit count (H_310)
//   wake_emit = ⌊wake_dur / refractory_steps⌋ × n_ultradian_cycles
// ════════════════════════════════════════════════════════════════════════════
fn wake_emit_closed(wake_dur: int, refr: int, n_cycles: int) -> int {
    return (wake_dur / refr) * n_cycles
}

// ════════════════════════════════════════════════════════════════════════════
// IDENTITY 2: Refractory recovery exponential (H_306)
//   w_n = 1 - (1-k)^n
// pure rational arithmetic, no libm
// ════════════════════════════════════════════════════════════════════════════
fn recovery_w_closed(k: float, n: int) -> float {
    let one_minus_k = 1.0 - k
    let mut acc = 1.0
    let mut i = 0
    while i < n {
        acc = acc * one_minus_k
        i = i + 1
    }
    return 1.0 - acc
}

fn approx_zero(a: float) -> bool {
    if a < 0.0 { return (0.0 - a) < 0.000001 }
    return a < 0.000001
}

fn main() {
    println("================================================================")
    println("  H_315 — spontaneous emit closed-form identity 🔵 path")
    println("================================================================")

    // ── IDENTITY 1: WAKE-emit (H_310) ────────────────────────────────────
    // H_310 config: wake_dur=30 ticks/cycle, refractory=10 steps, 1000/180≈5.5 cycles → 6 sub-windows
    let wake_emit = wake_emit_closed(30, 10, 6)
    let h310_measured = 18
    println("  IDENTITY 1 (H_310 WAKE-emit):")
    println("    closed-form:  ⌊30/10⌋ × 6 = " + str(wake_emit))
    println("    H_310 measured: " + str(h310_measured))
    check("F315.1 WAKE-EMIT-EXACT: wake_emit_closed(30, 10, 6) == 18 (H_310)", wake_emit == h310_measured)

    // ── IDENTITY 2: Refractory recovery w_n (H_306) ─────────────────────-
    let k = 0.3
    let w1_closed = recovery_w_closed(k, 1)
    let w2_closed = recovery_w_closed(k, 2)
    let w3_closed = recovery_w_closed(k, 3)
    println("  IDENTITY 2 (H_306 refractory recovery):")
    println("    closed-form w_1 = 1 - (1-k)^1 = 1 - 0.7    = " + str(w1_closed))
    println("    closed-form w_2 = 1 - (1-k)^2 = 1 - 0.49   = " + str(w2_closed))
    println("    closed-form w_3 = 1 - (1-k)^3 = 1 - 0.343  = " + str(w3_closed))
    println("    H_306 measured: w_1=0.3 · w_2=0.51 · w_3=0.657")

    // H_306 measured values (exact arithmetic, no rounding)
    let w1_measured = 0.3
    let w2_measured = 0.51
    let w3_measured = 0.657

    check("F315.2 W1-EXACT: closed w_1 == H_306 measured (0.3)",   approx_zero(w1_closed - w1_measured))
    check("F315.3 W2-EXACT: closed w_2 == H_306 measured (0.51)",  approx_zero(w2_closed - w2_measured))
    check("F315.4 W3-EXACT: closed w_3 == H_306 measured (0.657)", approx_zero(w3_closed - w3_measured))

    // ── F315.5 CROSS-MEASURE-CONSISTENCY ─────────────────────────────────
    let cross_ok = (wake_emit == h310_measured) && approx_zero(w1_closed - 0.3) && approx_zero(w2_closed - 0.51) && approx_zero(w3_closed - 0.657)
    check("F315.5 CROSS-MEASURE-CONSISTENCY: 모든 4 identity byte-equal", cross_ok)

    // ── F315.6 BOUND ─────────────────────────────────────────────────────
    let bound_ok = (wake_emit >= 0) && (w1_closed >= 0.0) && (w2_closed >= 0.0) && (w3_closed >= 0.0)
    check("F315.6 BOUND: all values >= 0", bound_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS == 6 {
        println("  ✅ HEADLINE: CLOSED-FORM IDENTITY EXACT — 🔵 SUPPORTED-FORMAL")
        println("    WAKE-emit = ⌊wake/R⌋ × n_cycles ✓")
        println("    w_n = 1 - (1-k)^n  ✓ for n ∈ {1, 2, 3} at k=0.3")
        println("    arc 의 phenomenological measurements 가 symbolic closed-form 으로 reduce")
    } else {
        println("  HEADLINE: PARTIAL closed-form, 🟢 SUPPORTED-NUMERICAL")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_315 had FALSIFIER FAILURES") }
}
