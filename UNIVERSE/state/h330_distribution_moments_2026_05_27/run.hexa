// H_330 — state-visit distribution moments (skewness · kurtosis) on n=4 ECA
// Pure hexa, deterministic. From each of 16 starts, forward 100 steps,
// accumulate visit count over 16-bin state histogram. Compute:
//   mean, variance, skewness (Pearson 3rd standardised moment),
//   kurtosis (Pearson 4th standardised moment − 3, excess form).
//
// H1: life-class rules (30, 110) produce HIGHER excess-kurtosis (heavier tails =
//   more concentrated/separated state visits = "chaotic" hallmark) than consc-class
//   (105, 150). Threshold ratio ≥ 1.5×.
//
// Anti-tautology: moments are computed from the visit-count histogram, NOT from
// the rule integer. Identity rule (204) is the canonical anchor (visit ≡ start;
// histogram is uniform over the 16 visited starts → kurtosis well-defined and
// distinct from chaotic class).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

// integer pow
fn ipow(x: float, n: int) -> float {
    let mut acc = 1.0
    let mut k = 0
    while k < n { acc = acc * x; k = k + 1 }
    return acc
}

// sqrt newton
fn fsqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn moments(hist: int, n_bins: int, total: float) {
    // x_i = i, p_i = hist[i] / total
    let mut mu = 0.0
    let mut i = 0
    while i < n_bins {
        let p = to_float(to_int(farr_get(hist, i))) / total
        mu = mu + to_float(i) * p
        i = i + 1
    }
    let mut m2 = 0.0
    let mut m3 = 0.0
    let mut m4 = 0.0
    let mut j = 0
    while j < n_bins {
        let p = to_float(to_int(farr_get(hist, j))) / total
        let d = to_float(j) - mu
        m2 = m2 + p * d * d
        m3 = m3 + p * d * d * d
        m4 = m4 + p * d * d * d * d
        j = j + 1
    }
    let sd = fsqrt(m2)
    let skew = if sd > 0.0 { m3 / (sd * sd * sd) } else { 0.0 }
    let kurt = if m2 > 0.0 { (m4 / (m2 * m2)) - 3.0 } else { 0.0 }
    println("  mean=" + str(mu) + " var=" + str(m2) + " skew=" + str(skew) + " excess_kurt=" + str(kurt))
}

fn measure_rule(rule: int, name: string) {
    let hist = farr_zeros(16)
    let mut s0 = 0
    let mut total_visits = 0
    while s0 < 16 {
        let mut s = s0
        let mut t = 0
        while t < 100 {
            let cur = to_int(farr_get(hist, s))
            let _ = farr_set(hist, s, to_float(cur + 1))
            total_visits = total_visits + 1
            s = next4(s, rule)
            t = t + 1
        }
        s0 = s0 + 1
    }
    println("rule=" + str(rule) + " name=" + name + " total_visits=" + str(total_visits))
    moments(hist, 16, to_float(total_visits))
    let _ = farr_free(hist)
}

fn main() {
    println("H_330 state-visit distribution moments n=4 ECA")
    measure_rule(30, "rule30_life")
    measure_rule(110, "rule110_life")
    measure_rule(105, "rule105_consc")
    measure_rule(150, "rule150_consc")
    measure_rule(204, "rule204_id")
    measure_rule(0, "rule0_null")
    println("done")
}
