// ════════════════════════════════════════════════════════════════════════════
//  probe_gz_band_si.hexa — H_axise_gz_band_si
//
//  CORE QUESTION
//    The Golden Zone is bounded by three canonical inhibition constants:
//      GZ_LOWER  = 0.5 - ln(4/3) ≈ 0.21232   (H_347 / H_348)
//      GZ_CENTER = 1/e           ≈ 0.36788   (H_349)
//      GZ_UPPER  = 0.5                        (= GZ_LOWER + GZ_WIDTH = GZ_LOWER + ln(4/3))
//    Existing work measured SI at GZ_LOWER (H_348: SI>3 PASS) and Φ-peaks at
//    GZ_CENTER (H_349: FALSIFIED). GZ_UPPER's Savant-Index behaviour has NEVER
//    been probed as a falsifiable cell.
//
//  HYPOTHESIS (pre-registered falsifier, frozen before run)
//    The Golden Zone is a BOUNDED specialization band: the Savant Index
//      SI = max(domain_phi) / min(domain_phi)
//    is above the savant threshold (SI > 3) at GZ_LOWER but drops BELOW it
//    (SI < 3) at GZ_UPPER = 0.5, AND the three GZ landmarks are strictly
//    monotone-ordered SI(LOWER) > SI(CENTER) > SI(UPPER).
//
//      F1 LOWER-ABOVE  : SI(GZ_LOWER) > 3       (savant regime at lower edge)
//      F2 UPPER-BELOW  : SI(GZ_UPPER) < 3       (specialization lost at upper edge)
//      F3 MONO-ORDER   : SI(LOWER) > SI(CENTER) > SI(UPPER) (strict band ordering)
//      F4 DETERMINISM  : in-process recompute byte-identical (|Δ| ≤ 1e-12)
//
//    SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4   (GZ is a bounded SI band)
//    PARTIAL   = F1 ∧ F3 ∧ F4 ∧ !F2  (ordering holds but SI>3 spills past UPPER)
//    FALSIFIED = !F1 ∨ !F3            (lower edge not savant, OR ordering broken)
//
//  SUBSTRATE
//    HEXAD/SAVANT/savant_phi.hexa (P68 4-domain Savant proxy SSOT) — CALENDAR,
//    MUSIC, ART, MEMORY, each d=6, capacity invariant Σ gain = 11.5.
//    Primitives (build_profile_state, phi_module, domain_phi_vector) replicated
//    in-file with SSOT markers (import-free, H_348/H_350/H_613 convention).
//
//  INHIBITION I → gain_focus MAPPING (H_348 affine, byte-identical)
//    gain_focus(I) = 1 + (1 - I) * 9      // I=1 → balanced(1), I=0 → release(10)
//    gain_rest     = (11.5 - gain_focus) / 3
//    GZ_LOWER  → gf ≈ 8.089
//    GZ_CENTER → gf ≈ 6.689
//    GZ_UPPER  → gf = 5.5  (I=0.5 exactly)
//
//  ROBUSTNESS
//    Measured over the 3 savant_phi stim seeds {42424, 91919, 77777} (T1/T2/T3
//    stim — same multi-seed set H_348 used). SI reported per-seed; verdict uses
//    the per-seed-min for F1 (worst case must still be >3) and per-seed-max for
//    F2 (worst case must still be <3) so the band claim is robust to seed.
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

let SV_D        = 6
let SV_N_DOM    = 4
let SV_CAPACITY = 11.5

// ── savant_phi.hexa primitives (SSOT-replicated, import-free) ───────────────

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

// phi_module(v) = Σ |v[j]|^1.5 / d  (Newton-iteration sqrt, savant_phi byte-eq)
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

// ── H_axise additions ───────────────────────────────────────────────────────

// Savant Index = max(domain_phi) / min(domain_phi)  (H_348 SI_phi definition)
fn savant_index(dphi: array) -> float {
    let n = len(dphi)
    if n == 0 { return 0.0 }
    let mut mx = dphi[0]
    let mut mn = dphi[0]
    let mut i = 1
    while i < n {
        if dphi[i] > mx { mx = dphi[i] }
        if dphi[i] < mn { mn = dphi[i] }
        i = i + 1
    }
    if mn <= 0.000000001 { return 0.0 }
    return mx / mn
}

// SI at inhibition I (CALENDAR hypertrophy, H_348 affine map)
fn si_at_inhibition(inhibit: float, stim_seed: int) -> float {
    let gain_focus = 1.0 + (1.0 - inhibit) * 9.0
    let gain_rest  = (SV_CAPACITY - gain_focus) / 3.0
    // dom = 0 (CALENDAR) hypertrophy, same as H_348
    let flat = build_profile_state(gain_focus, gain_rest, gain_rest, gain_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    return savant_index(dphi)
}

fn gz_lower()  -> float { return 0.21232 }   // 0.5 - ln(4/3)
fn gz_center() -> float { return 0.36788 }   // 1/e
fn gz_upper()  -> float { return 0.5 }        // GZ_LOWER + ln(4/3)

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_axise_gz_band_si — Golden Zone as a bounded Savant-Index band")
    println("  substrate: HEXAD/SAVANT/savant_phi.hexa (SSOT) — 4-domain d=6")
    println("  SI = max(domain_phi)/min(domain_phi) ; threshold SI>3 (H_348)")
    println("  GZ_LOWER=0.21232  GZ_CENTER=0.36788(1/e)  GZ_UPPER=0.5")
    println("  mapping: gain_focus = 1 + (1-I)*9 ; gain_rest = (11.5-gf)/3 (H_348)")
    println("════════════════════════════════════════════════════════════")

    let seeds = [42424, 91919, 77777]
    let ns = len(seeds)

    // per-seed SI at the three GZ landmarks
    let mut si_lower  = []
    let mut si_center = []
    let mut si_upper  = []
    let mut si = 0
    while si < ns {
        si_lower  = si_lower.push(si_at_inhibition(gz_lower(),  seeds[si]))
        si_center = si_center.push(si_at_inhibition(gz_center(), seeds[si]))
        si_upper  = si_upper.push(si_at_inhibition(gz_upper(),  seeds[si]))
        si = si + 1
    }

    println("")
    println("── per-seed SI at GZ landmarks ──")
    let mut p = 0
    while p < ns {
        println("  seed=" + str(seeds[p]) +
                "  SI(LOWER)=" + str(si_lower[p]) +
                "  SI(CENTER)=" + str(si_center[p]) +
                "  SI(UPPER)=" + str(si_upper[p]))
        p = p + 1
    }

    // worst-case aggregates for robust band claim
    // F1 needs the MIN SI(LOWER) > 3  (even worst seed is savant at lower edge)
    // F2 needs the MAX SI(UPPER) < 3  (even best seed is sub-savant at upper edge)
    let mut min_lower = si_lower[0]
    let mut max_upper = si_upper[0]
    let mut mean_lower  = 0.0
    let mut mean_center = 0.0
    let mut mean_upper  = 0.0
    let mut a = 0
    while a < ns {
        if si_lower[a] < min_lower { min_lower = si_lower[a] }
        if si_upper[a] > max_upper { max_upper = si_upper[a] }
        mean_lower  = mean_lower  + si_lower[a]
        mean_center = mean_center + si_center[a]
        mean_upper  = mean_upper  + si_upper[a]
        a = a + 1
    }
    mean_lower  = mean_lower  / to_float(ns)
    mean_center = mean_center / to_float(ns)
    mean_upper  = mean_upper  / to_float(ns)

    // F3 strict monotone ordering per seed: SI(LOWER) > SI(CENTER) > SI(UPPER)
    let mut mono_all = true
    let mut b = 0
    while b < ns {
        if si_lower[b] <= si_center[b] { mono_all = false }
        if si_center[b] <= si_upper[b] { mono_all = false }
        b = b + 1
    }

    // F4 determinism: recompute byte-identical
    let mut byte_eq = true
    let mut c = 0
    while c < ns {
        let r_lo = si_at_inhibition(gz_lower(),  seeds[c])
        let r_ce = si_at_inhibition(gz_center(), seeds[c])
        let r_up = si_at_inhibition(gz_upper(),  seeds[c])
        if sv_abs(r_lo - si_lower[c])  > 0.000000000001 { byte_eq = false }
        if sv_abs(r_ce - si_center[c]) > 0.000000000001 { byte_eq = false }
        if sv_abs(r_up - si_upper[c])  > 0.000000000001 { byte_eq = false }
        c = c + 1
    }

    let f1 = min_lower > 3.0
    let f2 = max_upper < 3.0
    let f3 = mono_all
    let f4 = byte_eq

    println("")
    println("── aggregates ──")
    println("  mean SI(LOWER)  = " + str(mean_lower))
    println("  mean SI(CENTER) = " + str(mean_center))
    println("  mean SI(UPPER)  = " + str(mean_upper))
    println("  min  SI(LOWER)  = " + str(min_lower) + "   (F1 needs > 3)")
    println("  max  SI(UPPER)  = " + str(max_upper) + "   (F2 needs < 3)")

    println("")
    println("── falsifiers ──")
    println("  F1 LOWER-ABOVE (min SI@LOWER > 3)  = " + str(f1))
    println("  F2 UPPER-BELOW (max SI@UPPER < 3)  = " + str(f2))
    println("  F3 MONO-ORDER  (L>C>U all seeds)   = " + str(f3))
    println("  F4 DETERMINISM (byte-identical)    = " + str(f4))

    let supported = f1 && f2 && f3 && f4
    let partial   = f1 && f3 && f4 && (!f2)
    let falsified = (!f1) || (!f3)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")
}
