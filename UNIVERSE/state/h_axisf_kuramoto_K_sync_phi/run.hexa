// ════════════════════════════════════════════════════════════════════════
// H_axisf_kuramoto_K_sync_collective_phi — coupling-K sweep × steady-state
//   Kuramoto order r × collective-Φ super-additive Δ (sync → Φ relation)
//
// 정체: 축 F (HIVE-MIND) 미드레인 cell. H_354 는 sync *timing* (τ) 만, H_609 은
//   structural coupling W 만, H_355 는 PID II_3 만 측정. 본 H 는 *real Kuramoto
//   dynamical substrate* 위에서 coupling K 를 sweep → steady-state order r∞ →
//   collective-Φ proxy 의 super-additive Δ 를 join. "동기화(sync) 가 집단 통합
//   (collective Φ) 을 견인하는가?" 라는 sync→Φ 관계를 *동역학적으로* 직접 측정.
//
// 방법 (전부 HIVE-MIND/hivemind_lib.hexa 의 real primitive):
//   1. N=8 oscillator, deterministic ω-spread + uniform init phase (H_207/H_354 동일).
//   2. coupling K ∈ {0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0} sweep.
//   3. 각 K: hm_kuramoto_sync_tau 를 STEPS=400 회 반복 Euler 적분 → steady r∞.
//   4. collective-Φ proxy: N=8 을 half A{0..3} / B{4..7} 로 분할.
//        - phi_A = phi_proxy(r_A) = order r_A 의 monotone Φ-proxy (-N log(1-r))
//        - phi_B = phi_proxy(r_B), phi_AB = phi_proxy(r_AB)
//        - Δ = hm_collective_phi_super_additive(phi_A, phi_B, phi_AB)  ← H_609 primitive
//   5. test: K↑ → r∞↑ (sync rises) 와 함께 Δ↑ (collective integration rises) 인가?
//        → Pearson(r∞, Δ) 와 Δ 의 K-monotonicity 로 판정.
//
// p7: 전부 deterministic 산술 (Kuramoto Euler + order param + log). PPL 무관.
// p1/p3/p5: system/persona/emit 호출 0. p8: weight update 0.
//
// phi_proxy 선택 근거: order parameter r 는 [0,1) → -log(1-r) 는 sync 가 강할수록
//   발산하는 *integration* 측도 (r→1 일 때 발산 = perfectly-locked 집단의 무한
//   상호의존). half 의 r 보다 whole 의 r 이 더 높으면 (cross-half coupling 이
//   추가 sync 를 만들면) Δ>0 = super-additive. 본 proxy 는 monotone-in-r 이므로
//   verdict 는 "sync↑ → collective integration↑" 의 부호/단조성만 본다 (proxy 의
//   절대 스케일 아님 — honest C3.1).
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima-fd-20260529042337/HIVE-MIND/hivemind_lib"

// deterministic Gaussian-quantile-ish ω spread (H_207/H_354 동일 패턴, no RNG)
fn omega_table(n: int) -> list {
    // 5 fixed quantiles cycled, std=1.0 — H_354 axis4_omega 동일.
    let q = [-1.2815515594, -0.5244005127, 0.0, 0.5244005127, 1.2815515594]
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(q[i % 5])
        i = i + 1
    }
    return out
}

// uniform init phase θ_i(0) = 2π·i/N (H_354 axis6 동일, deterministic)
fn init_phases(n: int) -> list {
    let twopi = 6.283185307179586
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(twopi * float(i) / float(n))
        i = i + 1
    }
    return out
}

// one Euler tick WITH ω (full Kuramoto: dθ_i/dt = ω_i + (K/N)Σ sin(θ_j-θ_i)).
// hm_kuramoto_sync_tau 는 ω=0 simplified — 여기선 H_354 의 full dynamics 를
// 재구성 (ω-spread 가 K 와 경쟁하는 진짜 transition 을 보기 위함). 본 fn 은
// phases 를 advance 만; order r 은 hm_kuramoto_order_r 로 측정 (lib primitive).
fn kuramoto_step(phases: list, omega: list, K: float, dt: float) -> list {
    let n = phases.len()
    let mut np = []
    let mut i = 0
    while i < n {
        let mut cs = 0.0
        let mut j = 0
        while j < n {
            cs = cs + sin(phases[j] - phases[i])
            j = j + 1
        }
        let dtheta = omega[i] + (K / float(n)) * cs
        np.push(phases[i] + dt * dtheta)
        i = i + 1
    }
    return np
}

fn slice_half(phases: list, lo: int, hi: int) -> list {
    let mut out = []
    let mut i = lo
    while i < hi {
        out.push(phases[i])
        i = i + 1
    }
    return out
}

// Φ-proxy: -log(1-r), monotone-in-r, integration 발산 측도. r 1 근접 cap.
fn phi_proxy(r: float) -> float {
    let mut rr = r
    if rr > 0.999999 { rr = 0.999999 }
    if rr < 0.0 { rr = 0.0 }
    return 0.0 - log(1.0 - rr)
}

fn pearson(xs: list, ys: list) -> float {
    let n = xs.len()
    if n == 0 { return 0.0 }
    let nn = float(n)
    let mut mx = 0.0
    let mut my = 0.0
    let mut i = 0
    while i < n { mx = mx + xs[i]; my = my + ys[i]; i = i + 1 }
    mx = mx / nn
    my = my / nn
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    let mut k = 0
    while k < n {
        let dx = xs[k] - mx
        let dy = ys[k] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        k = k + 1
    }
    if sxx <= 0.0 || syy <= 0.0 { return 0.0 }
    return sxy / sqrt(sxx * syy)
}

fn main() {
    let N = 8
    let dt = 0.05
    let STEPS = 400
    let Kgrid = [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0]
    let omega = omega_table(N)

    println("================================================================")
    println("  H_axisf_kuramoto_K_sync_collective_phi")
    println("  coupling-K sweep x steady-state Kuramoto order r x collective-Phi Delta")
    println("  N=" + str(N) + " halves A{0..3}/B{4..7} | dt=" + str(dt) + " STEPS=" + str(STEPS))
    println("  full Kuramoto: dtheta/dt = omega_i + (K/N) sum sin(theta_j-theta_i)")
    println("  Phi proxy = -log(1-r) (monotone-in-r integration measure)")
    println("  Delta = hm_collective_phi_super_additive(phi_A, phi_B, phi_AB)  [H_609 primitive]")
    println("================================================================")
    println("  cell |  K   | r_inf(AB) | r_A    | r_B    | phiAB   | phiA+phiB | Delta(super-add)")

    let mut rs = []
    let mut deltas = []
    let nk = Kgrid.len()
    let mut c = 0
    while c < nk {
        let K = Kgrid[c]
        // integrate to steady state
        let mut ph = init_phases(N)
        let mut s = 0
        while s < STEPS {
            ph = kuramoto_step(ph, omega, K, dt)
            s = s + 1
        }
        let r_ab = hm_kuramoto_order_r(ph)
        let r_a  = hm_kuramoto_order_r(slice_half(ph, 0, N / 2))
        let r_b  = hm_kuramoto_order_r(slice_half(ph, N / 2, N))
        let phi_a  = phi_proxy(r_a)
        let phi_b  = phi_proxy(r_b)
        let phi_ab = phi_proxy(r_ab)
        let delta = hm_collective_phi_super_additive(phi_a, phi_b, phi_ab)

        rs.push(r_ab)
        deltas.push(delta)

        println("   " + str(c) + "   | " + str(K) + " | " + str(r_ab)
                + " | " + str(r_a) + " | " + str(r_b)
                + " | " + str(phi_ab) + " | " + str(phi_a + phi_b)
                + " | " + str(delta))
        c = c + 1
    }

    println("  --")
    // criteria
    let pr = pearson(rs, deltas)

    // C1: r_inf monotone non-decreasing in K (sync rises with coupling)
    let mut r_mono = 1
    let mut i = 1
    while i < nk {
        if rs[i] < rs[i - 1] - 0.001 { r_mono = 0 }
        i = i + 1
    }
    // C2: Pearson(r_inf, Delta) > 0.5 (collective integration tracks sync)
    let c2 = pr > 0.5
    // C3: Delta > 0 at max-K cell (super-additive at full sync)
    let delta_max_K = deltas[nk - 1]
    let c3 = delta_max_K > 0.0
    // C4: Delta sign at K=0 (decoupled baseline) — expect <= small (no spurious super-add)
    let delta_K0 = deltas[0]

    println("  Pearson r(r_inf, Delta)        = " + str(pr))
    println("  r_inf monotone non-decreasing  : " + (if r_mono == 1 { "true" } else { "false" }))
    println("  Delta at max K (K=" + str(Kgrid[nk-1]) + ")           = " + str(delta_max_K))
    println("  Delta at K=0 (decoupled)       = " + str(delta_K0))
    println("  --")
    println("  C1 r_inf monotone-up in K      : " + (if r_mono == 1 { "PASS" } else { "FAIL" }))
    println("  C2 Pearson(r_inf,Delta) > 0.5  : " + (if c2 { "PASS" } else { "FAIL" }))
    println("  C3 Delta > 0 at max K          : " + (if c3 { "PASS" } else { "FAIL" }))
    println("  --")
    println("  VERDICT_RULE: SUPPORTED iff C1 AND (C2 OR C3); else PARTIAL; FALSIFIED iff C2 fail AND C3 fail")
    let supported = r_mono == 1 && (c2 || c3)
    let falsified = (!c2) && (!c3)
    let mut verdict = "PARTIAL"
    if supported { verdict = "SUPPORTED" }
    if falsified { verdict = "FALSIFIED" }
    println("  VERDICT     : " + verdict)
    println("=== H_axisf K-sync-collective-Phi complete: " + verdict + " ===")
}
