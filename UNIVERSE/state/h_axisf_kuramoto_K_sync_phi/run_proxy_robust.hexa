// ════════════════════════════════════════════════════════════════════════
// H_axisf_sync_phi_proxy_robustness — sub-additivity 가 Φ-proxy 함수형
//   (convex -log(1-r) 와 linear r) 에 robust 한가?
//
// 정체: 직전 H_axisf_kuramoto_K_sync_collective_phi 의 FALSIFIED (sync↑ → Δ<0,
//   강한 sub-additive) 가 phi_proxy = -log(1-r) 의 *convexity artifact* 인지,
//   아니면 sync→sub-additive 가 proxy-invariant 한 substrate 성질인지 가른다.
//   두 proxy 로 같은 Kuramoto K-sweep 위 Δ 부호를 비교:
//     P_log    : phi = -log(1-r)   (convex, integration-발산)
//     P_lin    : phi = r           (linear, bounded order-proxy)
//   prediction: convex proxy 에서만 Δ<0 이면 artifact (Jensen); 두 proxy 모두
//   Δ<0 이면 sync→sub-additive 가 substrate-real (proxy-robust).
//
// p7 deterministic 산술. lib primitive (hm_kuramoto_order_r +
//   hm_collective_phi_super_additive) 재사용 — 본 H 는 proxy 함수형만 교체.
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima-fd-20260529042337/HIVE-MIND/hivemind_lib"

fn omega_table(n: int) -> list {
    let q = [-1.2815515594, -0.5244005127, 0.0, 0.5244005127, 1.2815515594]
    let mut out = []
    let mut i = 0
    while i < n { out.push(q[i % 5]); i = i + 1 }
    return out
}
fn init_phases(n: int) -> list {
    let twopi = 6.283185307179586
    let mut out = []
    let mut i = 0
    while i < n { out.push(twopi * float(i) / float(n)); i = i + 1 }
    return out
}
fn kuramoto_step(phases: list, omega: list, K: float, dt: float) -> list {
    let n = phases.len()
    let mut np = []
    let mut i = 0
    while i < n {
        let mut cs = 0.0
        let mut j = 0
        while j < n { cs = cs + sin(phases[j] - phases[i]); j = j + 1 }
        np.push(phases[i] + dt * (omega[i] + (K / float(n)) * cs))
        i = i + 1
    }
    return np
}
fn slice_half(phases: list, lo: int, hi: int) -> list {
    let mut out = []
    let mut i = lo
    while i < hi { out.push(phases[i]); i = i + 1 }
    return out
}
fn phi_log(r: float) -> float {
    let mut rr = r
    if rr > 0.999999 { rr = 0.999999 }
    if rr < 0.0 { rr = 0.0 }
    return 0.0 - log(1.0 - rr)
}

fn main() {
    let N = 8
    let dt = 0.05
    let STEPS = 400
    let Kgrid = [0.0, 1.0, 2.0, 3.0, 4.0]
    let omega = omega_table(N)

    println("================================================================")
    println("  H_axisf_sync_phi_proxy_robustness")
    println("  sub-additivity proxy-invariant? P_log=-log(1-r) vs P_lin=r")
    println("  N=" + str(N) + " halves A{0..3}/B{4..7} | STEPS=" + str(STEPS))
    println("================================================================")
    println("  cell | K   | r_AB    | r_A    | r_B    || Delta_log  | Delta_lin")

    let nk = Kgrid.len()
    let mut neg_log = 0
    let mut neg_lin = 0
    let mut c = 0
    while c < nk {
        let K = Kgrid[c]
        let mut ph = init_phases(N)
        let mut s = 0
        while s < STEPS { ph = kuramoto_step(ph, omega, K, dt); s = s + 1 }
        let r_ab = hm_kuramoto_order_r(ph)
        let r_a  = hm_kuramoto_order_r(slice_half(ph, 0, N / 2))
        let r_b  = hm_kuramoto_order_r(slice_half(ph, N / 2, N))

        // P_log
        let d_log = hm_collective_phi_super_additive(phi_log(r_a), phi_log(r_b), phi_log(r_ab))
        // P_lin (phi = r directly)
        let d_lin = hm_collective_phi_super_additive(r_a, r_b, r_ab)

        if d_log < 0.0 { neg_log = neg_log + 1 }
        if d_lin < 0.0 { neg_lin = neg_lin + 1 }

        println("   " + str(c) + "  | " + str(K) + " | " + str(r_ab)
                + " | " + str(r_a) + " | " + str(r_b)
                + " || " + str(d_log) + " | " + str(d_lin))
        c = c + 1
    }
    println("  --")
    println("  P_log Delta<0 count : " + str(neg_log) + "/" + str(nk))
    println("  P_lin Delta<0 count : " + str(neg_lin) + "/" + str(nk))
    println("  --")
    // both proxies sub-additive on >=4/5 cells => proxy-robust sub-additivity
    let robust = neg_log >= 4 && neg_lin >= 4
    println("  VERDICT_RULE: PROXY-ROBUST sub-additive iff BOTH proxies Delta<0 on >=4/" + str(nk))
    let verdict = if robust { "SUPPORTED (sync->sub-additive is proxy-robust, NOT a convexity artifact)" } else { "PARTIAL/artifact-suspect" }
    println("  VERDICT     : " + verdict)
    println("=== H_axisf proxy-robustness complete ===")
}
