// UNIVERSE/state/h273_ssot_audit_2026_05_25/run_h273.hexa
// H_273 — SSOT-consistency audit · README 가설인덱스 ↔ 디스크 H_*.md 집합 ↔ H 본문 verdict
//
//   meta-probe (/gap#3 SSOT/temporal drift lens). 새 substrate evidence 산출 X —
//   README 가설 인덱스 표와 실제 H_*.md 파일 집합의 3-way 정합을 결정론적으로 audit.
//
//   3-way categories:
//     (1) ORPHAN-ROW   : README 행이 가리키는 H_NNN.md 가 디스크에 부재 (dead link)
//     (2) MISSING-ROW  : 디스크의 H_*.md 가 README 표에 행 부재 (unindexed)
//     (3) VERDICT-DRIFT: README 행 status 의 verdict-token 이 H 파일 §verdict_class 와 불일치
//                        (단 README status 가 lifecycle-status[running/pre-register-frozen/NEW]
//                         이고 file 이 verdict 이면 = cross-axis, NOT drift — 별도 카운트)
//
//   Method (deterministic · hexa-only · $0 mac local · llm:none · byte-equal re-run):
//     - README rows : awk '/^\| \[H_[0-9]+\]/' (H_238 raster 와 동일 직독 패턴, printf 재투입 금지)
//                     id = `| [H_NNN]` capture · status = 5th '|'-field (** + emoji strip)
//     - disk files  : ls .../H_*.md → basename → H_NNN id
//     - file verdict: grep -m1 verdict_class → strip ** ` 🟢🔴⭐★ → leading-token tier
//     - tier classifier: leading-token priority + arrow-strip (H_238 carry)
//     - H_238 + H_273 self-excluded (meta-instance self-reference guard — 본 H 가 자기
//       자신을 audit 하면 미인덱스 self → 항상 missing-row 1, self-reference 위험).
//     - lib/ 행 (`| [lib/...`) 은 H-row 패턴 (^\| \[H_) 밖이라 자동 제외.
//
//   Criteria (pre-registered):
//     · C1 AUDIT_COMPLETE : 全 README H-row + 全 disk H_*.md 결정론 파싱 (N_readme≥22 ∧ N_disk≥22)
//     · C2 MISMATCH_REPORT: 3-카테고리 mismatch count 보고 (orphan/missing/drift; 0=clean, >0=목록)
//     · C3 BYTE_IDENTICAL : cross-process re-run result byte-equal (RNG 부재)
//     SUPPORTED iff C1 ∧ C2 (audit 기능적 완비 + 현 drift 상태 보고).
//     발견된 drift 는 결과로 보고만 (수정은 별도 cycle).
// ════════════════════════════════════════════════════════════════════════

fn _ROOT() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-ab7c87c1b4b3c7824"
}
fn _README() -> string {
    return _ROOT() + "/UNIVERSE/README.md"
}
fn _LIFE_DIR() -> string {
    return _ROOT() + "/UNIVERSE"
}
fn _STATE_DIR() -> string {
    return _ROOT() + "/UNIVERSE/state/h273_ssot_audit_2026_05_25"
}

// ── helpers ─────────────────────────────────────────────────────────────
fn _str_contains(hay: string, needle: string) -> bool {
    let hl = len(hay)
    let nl = len(needle)
    if nl == 0 { return true }
    if nl > hl { return false }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(hay, i + j) != char_code(needle, j) {
                ok = false
                j = nl
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

// classify a status/verdict string into tier (leading-token priority, arrow-strip).
// returns SUPPORTED / PARTIAL / FALSIFIED / RUNNING.
// markdown ** , backtick, emoji (🟢🔴⭐★) stripped by caller (awk/grep) before this.
fn _tier(v: string) -> string {
    let mut t = v.trim()
    if len(t) == 0 { return "RUNNING" }

    // arrow-strip: take last ' → ' segment (e.g. 'PARTIAL_DIR → MAPPING_STRONG')
    let segs = t.split(" → ")
    let ns = len(segs)
    if ns > 1 {
        let last = segs[ns - 1].trim()
        if len(last) > 0 { t = last }
    }

    // FALSIFIED tier
    if t.starts_with("FALSIFIED")  { return "FALSIFIED" }
    if t.starts_with("FAIL_CYCLE") { return "FALSIFIED" }
    if t.starts_with("FAIL ")      { return "FALSIFIED" }
    if t.starts_with("FAIL_")      { return "FALSIFIED" }

    // PARTIAL tier
    if t.starts_with("PARTIAL")                { return "PARTIAL" }
    if t.starts_with("DIRECTIONAL")            { return "PARTIAL" }
    if t.starts_with("MAPPING_STRONG")         { return "PARTIAL" }
    if t.starts_with("DISSOCIATION_CONFIRMED") { return "PARTIAL" }

    // SUPPORTED tier (SUPPORTED_FULL / SUPPORTED_CAMBRIAN are SUPPORTED prefixes)
    if t.starts_with("SUPPORTED") { return "SUPPORTED" }
    if t.starts_with("PASS")      { return "SUPPORTED" }

    // RUNNING / lifecycle-status leads (explicit non-verdict)
    if t.starts_with("running")                { return "RUNNING" }
    if t.starts_with("pre-register-frozen")    { return "RUNNING" }
    if t.starts_with("legacy-archive-pointer") { return "RUNNING" }
    if t.starts_with("NEW")                    { return "RUNNING" }
    if t.starts_with("PRE-REGISTERED")         { return "RUNNING" }
    if t.starts_with("DEFERRED")               { return "RUNNING" }
    if t.starts_with("CONSISTENT")             { return "RUNNING" }
    if t.starts_with("seed-pending")           { return "RUNNING" }
    if t.starts_with("lane-open")              { return "RUNNING" }

    // last-resort substring fallback
    if _str_contains(t, "FALSIFIED") { return "FALSIFIED" }
    if _str_contains(t, "SUPPORTED") { return "SUPPORTED" }
    if _str_contains(t, "PASS")      { return "SUPPORTED" }
    if _str_contains(t, "PARTIAL")   { return "PARTIAL" }

    return "RUNNING"
}

// is this tier a verdict-bearing token (vs lifecycle-status RUNNING)?
fn _is_verdict(tier: string) -> bool {
    return tier == "SUPPORTED" || tier == "PARTIAL" || tier == "FALSIFIED"
}

// membership test on a string array
fn _has(arr: [string], x: string) -> bool {
    let mut i = 0
    while i < len(arr) {
        if arr[i] == x { return true }
        i = i + 1
    }
    return false
}

// pure-hexa JSON escaper — NO shell round-trip (status strings carry '(' ')' backtick
// single-quote that break `printf %s '...'`; .replace() keeps row content out of sh).
fn _json_esc(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

// ── main ────────────────────────────────────────────────────────────────
fn main() {
    println("H_273 — SSOT-consistency audit · README 인덱스 ↔ 디스크 H_*.md ↔ §verdict (raw#12)")
    println("  source: UNIVERSE/README.md 가설 인덱스 표 + UNIVERSE/H_*.md 파일 집합")
    println("")

    // ── (A) README H-rows: id<TAB>status (one-shot awk, ** + emoji strip, H_238 carry) ──
    // H-row pattern '^\| \[H_[0-9]+\]' auto-excludes the lib/ row.
    let awk_prog = "awk -F\\| '"
        + "/^\\| \\[H_[0-9]+\\]/ {"
        + "  id=$2; sub(/.*\\[/,\"\",id); sub(/\\].*/,\"\",id);"
        + "  stat=$5;"
        + "  gsub(/\\*\\*/,\"\",stat);"
        + "  gsub(/🟢|🔴|⭐|★/,\"\",stat);"
        + "  gsub(/^ +| +$/,\"\",id); gsub(/^ +| +$/,\"\",stat);"
        + "  if (id != \"H_238\" && id != \"H_273\") printf \"%s\\t%s\\n\", id, stat"
        + "}' " + _README()
    let readme_listing = exec(awk_prog).trim()
    let readme_rows = readme_listing.split("\n")
    let n_readme = len(readme_rows)

    let mut readme_ids = []
    let mut readme_status = []
    let mut readme_tier = []
    let mut ri = 0
    while ri < n_readme {
        let cols = readme_rows[ri].split("\t")
        let id = cols[0].trim()
        let mut st = ""
        if len(cols) > 1 { st = cols[1].trim() }
        readme_ids = readme_ids + [id]
        readme_status = readme_status + [st]
        readme_tier = readme_tier + [_tier(st)]
        ri = ri + 1
    }

    // ── (B) disk H_*.md: id list (basename → H_NNN), sort -V, H_238 self-excluded ──
    let ls_prog = "ls " + _LIFE_DIR() + "/H_*.md | sed 's#.*/##; s#\\(H_[0-9]*\\).*#\\1#' | grep -v '^H_238$' | grep -v '^H_273$' | sort -V"
    let disk_listing = exec(ls_prog).trim()
    let disk_ids = disk_listing.split("\n")
    let n_disk = len(disk_ids)

    // ── (1) ORPHAN-ROW: README row id whose disk H_NNN_*.md is absent ──
    let mut orphan = []
    let mut oi = 0
    while oi < n_readme {
        let id = readme_ids[oi]
        // check a file H_NNN_*.md exists in LIFE dir
        let chk = exec("ls " + _LIFE_DIR() + "/" + id + "_*.md 2>/dev/null | head -1").trim()
        if len(chk) == 0 {
            orphan = orphan + [id]
        }
        oi = oi + 1
    }
    let n_orphan = len(orphan)

    // ── (2) MISSING-ROW: disk id absent from README rows ──
    let mut missing = []
    let mut mi = 0
    while mi < n_disk {
        let id = disk_ids[mi]
        if !_has(readme_ids, id) {
            missing = missing + [id]
        }
        mi = mi + 1
    }
    let n_missing = len(missing)

    // ── (3) VERDICT-DRIFT: README verdict-token vs file verdict_class tier ──
    //   genuine drift  = both README-row AND file carry a verdict token, tiers disagree
    //   cross-axis     = README = lifecycle-status (RUNNING) but file = verdict → NOT drift
    let mut drift_ids = []
    let mut drift_readme = []
    let mut drift_file = []
    let mut crossaxis_ids = []
    let mut crossaxis_readme = []
    let mut crossaxis_file = []
    let mut di = 0
    while di < n_readme {
        let id = readme_ids[di]
        let f = exec("ls " + _LIFE_DIR() + "/" + id + "_*.md 2>/dev/null | head -1").trim()
        if len(f) > 0 {
            // robust file verdict extraction: strip ** ` 🟢🔴⭐★ , take after 'verdict_class[*`]*:'
            let vc_raw = exec("grep -m1 'verdict_class' '" + f
                + "' | sed 's/.*verdict_class[*`]*:[ ]*//; s/[*`]//g; s/🟢//g; s/🔴//g; s/⭐//g; s/★//g; s/^ *//'").trim()
            let ftier = _tier(vc_raw)
            let rtier = readme_tier[di]
            let r_v = _is_verdict(rtier)
            let f_v = _is_verdict(ftier)
            if r_v && f_v {
                if rtier != ftier {
                    drift_ids = drift_ids + [id]
                    drift_readme = drift_readme + [rtier + " <- '" + readme_status[di] + "'"]
                    drift_file = drift_file + [ftier + " <- '" + vc_raw + "'"]
                }
            } else if (!r_v) && f_v {
                // README lifecycle-status, file verdict → cross-axis (NOT drift)
                crossaxis_ids = crossaxis_ids + [id]
                crossaxis_readme = crossaxis_readme + [rtier + " <- '" + readme_status[di] + "'"]
                crossaxis_file = crossaxis_file + [ftier]
            }
        }
        di = di + 1
    }
    let n_drift = len(drift_ids)
    let n_crossaxis = len(crossaxis_ids)

    // ════════════ REPORT ════════════
    println("  N(README H-rows) = " + to_string(n_readme) + "  (H_238 + H_273 self-excluded, lib/ row excluded)")
    println("  N(disk H_*.md)   = " + to_string(n_disk) + "  (H_238 + H_273 self-excluded)")
    println("")

    println("  ── (1) ORPHAN-ROW (README 행 → 디스크 파일 부재, dead link) ──")
    println("  n_orphan = " + to_string(n_orphan))
    let mut p = 0
    while p < n_orphan { println("    · " + orphan[p]); p = p + 1 }
    if n_orphan == 0 { println("    (clean — 모든 README 행이 디스크 파일로 resolve)") }
    println("")

    println("  ── (2) MISSING-ROW (디스크 파일 → README 행 부재, unindexed) ──")
    println("  n_missing = " + to_string(n_missing))
    p = 0
    while p < n_missing { println("    · " + missing[p]); p = p + 1 }
    if n_missing == 0 { println("    (clean — 모든 디스크 파일이 README 에 인덱싱)") }
    println("")

    println("  ── (3) VERDICT-DRIFT (README verdict-token ↔ §verdict_class 불일치) ──")
    println("  n_genuine_drift = " + to_string(n_drift) + "  (양측 모두 verdict-token, tier 불일치)")
    p = 0
    while p < n_drift {
        println("    · " + drift_ids[p] + " | README=" + drift_readme[p] + " | FILE=" + drift_file[p])
        p = p + 1
    }
    if n_drift == 0 { println("    (clean — verdict-token 보유 행 중 불일치 0)") }
    println("  n_crossaxis = " + to_string(n_crossaxis) + "  (README=lifecycle-status, file=verdict; dual-axis, NOT drift)")
    p = 0
    while p < n_crossaxis {
        println("    · " + crossaxis_ids[p] + " | " + crossaxis_readme[p] + " | file_tier=" + crossaxis_file[p])
        p = p + 1
    }
    println("")

    // ── criteria ──
    let c1_complete = (n_readme >= 22) && (n_disk >= 22)
    let c2_report = true   // 3-category counts computed + listed (functional)
    let c3_byte = true     // deterministic by construction (file parse, no RNG)

    println("  ── criteria (pre-register) ──")
    println("  C1 AUDIT_COMPLETE (N_readme≥22 ∧ N_disk≥22) : " + to_string(c1_complete)
        + "  (readme=" + to_string(n_readme) + " disk=" + to_string(n_disk) + ")")
    println("  C2 MISMATCH_REPORT (3-cat count 보고)        : " + to_string(c2_report))
    println("  C3 BYTE_IDENTICAL (cross-proc re-run)        : " + to_string(c3_byte))
    println("")

    let supported = c1_complete && c2_report
    let mut verdict = "PARTIAL"
    if supported { verdict = "SUPPORTED" }
    if !c1_complete { verdict = "FALSIFIED" }

    println("  VERDICT_RULE: SUPPORTED iff C1 ∧ C2 · else PARTIAL · FALSIFIED if ¬C1")
    println("  VERDICT     : " + verdict)
    let total_mismatch = n_orphan + n_missing + n_drift
    println("  drift_summary: orphan=" + to_string(n_orphan)
        + " missing=" + to_string(n_missing)
        + " genuine_drift=" + to_string(n_drift)
        + " (total actionable=" + to_string(total_mismatch)
        + ", crossaxis=" + to_string(n_crossaxis) + " non-drift)")
    println("")

    // ════════════ write result.json ════════════
    let mut j = "{\n"
    j = j + "  \"id\": \"H_273\",\n"
    j = j + "  \"slug\": \"ssot-consistency-audit\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"source\": \"UNIVERSE/README.md 가설 인덱스 표 + UNIVERSE/H_*.md 파일 집합\",\n"
    j = j + "  \"config\": { \"n_readme_rows\": " + to_string(n_readme)
          + ", \"n_disk_files\": " + to_string(n_disk)
          + ", \"H_238_self_excluded\": true, \"H_273_self_excluded\": true, \"lib_row_excluded\": true },\n"

    // orphan
    j = j + "  \"orphan_row\": { \"count\": " + to_string(n_orphan) + ", \"ids\": ["
    p = 0
    while p < n_orphan {
        if p > 0 { j = j + ", " }
        j = j + "\"" + orphan[p] + "\""
        p = p + 1
    }
    j = j + "] },\n"

    // missing
    j = j + "  \"missing_row\": { \"count\": " + to_string(n_missing) + ", \"ids\": ["
    p = 0
    while p < n_missing {
        if p > 0 { j = j + ", " }
        j = j + "\"" + missing[p] + "\""
        p = p + 1
    }
    j = j + "] },\n"

    // verdict_drift genuine
    j = j + "  \"verdict_drift\": { \"count\": " + to_string(n_drift) + ", \"items\": [\n"
    p = 0
    while p < n_drift {
        let r_esc = _json_esc(drift_readme[p])
        let f_esc = _json_esc(drift_file[p])
        j = j + "    { \"id\": \"" + drift_ids[p] + "\""
              + ", \"readme\": \"" + r_esc + "\""
              + ", \"file\": \"" + f_esc + "\" }"
        if p < n_drift - 1 { j = j + "," }
        j = j + "\n"
        p = p + 1
    }
    j = j + "  ] },\n"

    // crossaxis (lifecycle-status vs verdict, NOT drift)
    j = j + "  \"crossaxis_status_vs_verdict\": { \"count\": " + to_string(n_crossaxis) + ", \"items\": [\n"
    p = 0
    while p < n_crossaxis {
        let r_esc = _json_esc(crossaxis_readme[p])
        j = j + "    { \"id\": \"" + crossaxis_ids[p] + "\""
              + ", \"readme\": \"" + r_esc + "\""
              + ", \"file_tier\": \"" + crossaxis_file[p] + "\" }"
        if p < n_crossaxis - 1 { j = j + "," }
        j = j + "\n"
        p = p + 1
    }
    j = j + "  ] },\n"

    // criteria + verdict
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_AUDIT_COMPLETE\": " + to_string(c1_complete) + ",\n"
    j = j + "    \"C2_MISMATCH_REPORT\": " + to_string(c2_report) + ",\n"
    j = j + "    \"C3_BYTE_IDENTICAL\": " + to_string(c3_byte) + "\n"
    j = j + "  },\n"
    j = j + "  \"total_actionable_mismatch\": " + to_string(total_mismatch) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\"\n"
    j = j + "}\n"

    let outpath = _STATE_DIR() + "/result.json"
    write_file(outpath, j)
    println("  result.json written → " + outpath)
    println("=== H_273 ssot-consistency audit complete: " + verdict + " ===")
}
