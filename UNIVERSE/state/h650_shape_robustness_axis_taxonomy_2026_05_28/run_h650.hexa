// ════════════════════════════════════════════════════════════════════════════
//  run_h650.hexa — H_650 shape-robustness axis taxonomy (META-DISCOVERY 정밀화)
//
//  CORE QUESTION (round-7 메타-발견 정밀화)
//    round 7 의 "shape > scalar robustness" 강주장이 cross-RULE(H_642 🔴) ·
//    cross-SEED(H_647 🔴 역전) 에서 반증됐으나, H_628(polarity-invariant peak 🟢)
//    은 polarity 축에서 shape(dΦ/dI peak 위치)가 robust 했다. 즉 shape-robustness
//    는 perturbation-축 의존. 본 H_650 은 3개 축(polarity / rule / seed)에서
//    shape vs scalar robustness 를 *한 표* 로 대조해 taxonomy 를 정립한다.
//
//  HYPOTHESIS (H1)
//    shape robustness 가 polarity 축에서 高 (H_628 재현 — CV_shape ≈ 0),
//    rule · seed 축에서 低 (H_642 / H_647 재현 — CV_shape ≳ CV_scalar).
//    즉 robustness 가 perturbation-축의 *함수* 이며, polarity(부호대칭)만 shape 보존.
//
//  FALSIFIER (H0)
//    3축 모두 동일 robustness (축-의존 없음) 또는 polarity 도 shape-fragile.
//
//  UNIFIED ROBUSTNESS METRIC (3축 동차 비교)
//    각 축에서 N 개 perturbation realization 을 가로질러:
//      SHAPE   feature = argmax_I |dΦ/dI|   (peak I 위치, [0,1] 정규화 좌표)
//      SCALAR  feature = Φ magnitude        (각 축의 baseline Φ 측도)
//      CV_shape  = std(peak_I[·])  / mean(peak_I[·])     (peak 위치 산포)
//      CV_scalar = std(Φ_mag[·])   / mean(Φ_mag[·])      (magnitude 산포)
//    shape-robust(axis) ⟺ CV_shape < CV_scalar.
//    H_642 양식 (peak_I CV vs scalar CV) 으로 3축 동차화 — H_647 의 abs-std 가
//    아닌 CV 로 통일해 cross-axis 비교 동차성 확보.
//
//  AXIS 1 — POLARITY (H_628 재현)
//    2-ECA joint n=4, seed (rule_a=30, rule_b=30, sys=10), W=0.3.
//    perturbation = polarity ∈ {attract, repel, bipolar} (H_610/H_628 verbatim).
//    SCALAR = Φ(I=0.05) per polarity (H_628 §A1 의 magnitude probe 양식).
//    H_628 §A1 anchor: 3 polarity 모두 dΦ/dI peak I=0.21 (CV_shape=0),
//    magnitude attract 17.7 / repel 7.5 / bipolar 10.4 (CV_scalar>0).
//
//  AXIS 2 — RULE (H_642 재현)
//    single ECA n=4, rule ∈ {30, 54, 90, 110, 184} (H_642 verbatim).
//    perturbation = Wolfram rule. SCALAR = Φ(I=0) per rule (2^n=16 state-mean).
//    H_642 anchor: CV_shape=0.568, peak_I {0.18,0.40,0.05,0.18,0.40}.
//    (H_642 의 scalar 는 peak_mag 였으나 본 H 는 동차화 위해 Φ(I=0) magnitude 채택.)
//
//  AXIS 3 — SEED (H_647 재현)
//    fixed rule 110 n=4, per-state ±A jitter 의 LCG(seed) realization.
//    perturbation = random seed s ∈ {0..N-1}, N=8 (라이트 — H_647 N=12 의 부분).
//    SCALAR = Φ(I=0)=Φ(tpm_seed) per seed. H_647 anchor: peak_std=0.117 큰 산포,
//    Φ0_cv=0.042 작음 (scalar 가 더 robust, 방향 역전).
//
//  SUBSTRATE & Φ (commons g61 — 재발명 0)
//    faithful causal big-Φ (iit4_eca + iit4_bigphi), n=4. polarity 축은 H_628 의
//    joint-TPM big_phi single-shot (sys=10), rule/seed 축은 2^n=16 state-mean
//    (H_285/H_351/H_642/H_647 양식, single-state fragility 회피).
//
//  PRE-REGISTERED FALSIFIERS (측정 전 동결)
//    F1 POLARITY-SHAPE-ROBUST : CV_shape(polarity) < CV_scalar(polarity)
//                               AND CV_shape(polarity) ≤ 0.05  (H_628 재현 — 핵심)
//    F2 RULE-SHAPE-FRAGILE    : CV_shape(rule) ≥ CV_scalar(rule) - 0.10  (H_642 재현
//                               — rule 축은 shape 가 scalar 못 이김)
//    F3 SEED-SHAPE-FRAGILE    : CV_shape(seed) > CV_scalar(seed)  (H_647 재현 — 역전)
//    F4 AXIS-DEPENDENT        : NOT (all 3 axes 동일 robustness) — polarity 가
//                               다른 두 축과 질적으로 구별 (CV_shape gap)
//    F5 BYTE-EQUAL            : in-process recompute byte-identical (RFC 033)
//
//    verdict_rule
//      SUPPORTED-NUMERICAL = F1 ∧ F2 ∧ F3 ∧ F4 ∧ F5
//          (taxonomy 확립 — polarity 高 robust, rule/seed 低, 축-의존)
//      PARTIAL = F4 ∧ F5 ∧ (F1 또는 rule/seed 둘 중 하나만)
//      FALSIFIED = !F4 (축-의존 없음) 또는 !F1 (polarity 도 shape-fragile)
//
//  $0 · mac-local · hexa-only · LLM none · deterministic (LCG single-stream).
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h650b/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _n() -> int { return 4 }
fn _nseed() -> int { return 8 }       // 라이트 (H_647 N=12 부분) — std 추정 충분
fn _jitter() -> float { return 0.30 } // H_647 jitter amplitude A
fn _gz_lower() -> float { return 0.21232 }


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn _sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 60 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

fn _mean(xs: array) -> float {
    let n = len(xs)
    let mut t = 0.0
    let mut i = 0
    while i < n {
        t = t + xs[i]
        i = i + 1
    }
    return t / to_float(n)
}

fn _std(xs: array) -> float {
    let n = len(xs)
    let mu = _mean(xs)
    let mut t = 0.0
    let mut i = 0
    while i < n {
        let d = xs[i] - mu
        t = t + d * d
        i = i + 1
    }
    return _sqrt(t / to_float(n))
}

fn _cv(xs: array) -> float {
    let mu = _mean(xs)
    let am = _abs(mu)
    if am < 1.0e-12 { return 0.0 }
    return _std(xs) / am
}


// ── shared: dΦ/dI peak grid-coordinate (argmax |central diff|) ───────────────
fn peak_I_of(grid: array, phi: array) -> float {
    let m = len(grid)
    let mut peak_idx = 0
    let mut peak_mag = 0.0 - 1.0
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        let ad = _abs(d)
        if ad > peak_mag { peak_mag = ad; peak_idx = k }
        k = k + 1
    }
    return grid[peak_idx]
}


// ════════════════════════════════════════════════════════════════════════════
//  AXIS 2 + 3 substrate: single ECA n=4, faithful big-Φ 16-state mean
// ════════════════════════════════════════════════════════════════════════════
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}

fn mixed_tpm_rule(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}

// ── seed jitter (H_647 verbatim) ──────────────────────────────────────────
fn _lcg_next(state: int) -> int {
    return (state * 1664525 + 1013904223) % 2147483648
}
fn _lcg_unit(state: int) -> float {
    return to_float(state) / 2147483648.0
}
fn seed_tpm(rule: int, n: int, seed: int, amp: float) -> array {
    let base = eca_tpm(rule, n)
    let total = len(base)
    let mut out = []
    let mut lcg = _lcg_next(_lcg_next(seed * 2654435761 + 12345))
    let mut k = 0
    while k < total {
        lcg = _lcg_next(lcg)
        let u = _lcg_unit(lcg)
        let factor = 1.0 + amp * (2.0 * u - 1.0)
        out = out.push(_clamp01(base[k] * factor))
        k = k + 1
    }
    return out
}
fn inhibit_mix(tpm_seed: array, inhibit: float) -> array {
    let scale = 1.0 - inhibit
    let total = len(tpm_seed)
    let mut out = []
    let mut k = 0
    while k < total {
        out = out.push(tpm_seed[k] * scale)
        k = k + 1
    }
    return out
}


// ════════════════════════════════════════════════════════════════════════════
//  AXIS 1 substrate: 2-ECA joint n=4 polarity coupling (H_628 verbatim)
// ════════════════════════════════════════════════════════════════════════════
fn bit_of(s: int, b: int) -> int { return iit4_bit(s, b) }

fn eca_next2(rule: int, state2: int, i: int) -> int {
    let l = bit_of(state2, (i - 1 + 2) % 2)
    let c = bit_of(state2, i)
    let r = bit_of(state2, (i + 1) % 2)
    let idx = 4 * l + 2 * c + r
    return bit_of(rule, idx)
}

fn couple_next(a_prime: int, b_prime: int, polarity: string, w: float, i: int) -> int {
    let mut eff = polarity
    if polarity == "bipolar" {
        if i == 1 { eff = "repel" } else { eff = "attract" }
    }
    if eff == "attract" {
        if w >= 0.8 { return b_prime }
        if w >= 0.3 {
            if a_prime == 1 { return 1 }
            return b_prime
        }
        return a_prime
    }
    if eff == "repel" {
        if w >= 0.8 { return 1 - b_prime }
        if w >= 0.3 {
            if a_prime == b_prime { return 0 }
            return 1
        }
        return a_prime
    }
    return a_prime
}

fn build_joint_tpm_inhib(rule_a: int, rule_b: int, polarity: string, w: float, I: float) -> array {
    let full = 16
    let suppress = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let sa = s % 4
        let sb = (s / 4) % 4
        let mut j = 0
        while j < 2 {
            let a_prime = eca_next2(rule_a, sa, j)
            let b_prime = eca_next2(rule_b, sb, j)
            let nxt = couple_next(a_prime, b_prime, polarity, w, j)
            t = t.push(to_float(nxt) * suppress)
            j = j + 1
        }
        let mut k = 0
        while k < 2 {
            let a_prime = eca_next2(rule_a, sa, k)
            let b_prime = eca_next2(rule_b, sb, k)
            let nxt = couple_next(b_prime, a_prime, polarity, w, k)
            t = t.push(to_float(nxt) * suppress)
            k = k + 1
        }
        s = s + 1
    }
    return t
}

fn joint_phi(rule_a: int, rule_b: int, polarity: string, w: float, sys_state: int, I: float) -> float {
    let tpm = build_joint_tpm_inhib(rule_a, rule_b, polarity, w, I)
    let res = big_phi(tpm, 4, sys_state)
    return res[0]
}


fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_650 shape-robustness axis taxonomy — polarity / rule / seed")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]
    let mg = len(grid)

    // ════════════════════════════════════════════════════════════════════
    //  AXIS 1 — POLARITY (H_628 재현): 2-ECA joint n=4, rule_a=rb=30, sys=10
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── AXIS 1: POLARITY (H_628) — 2-ECA joint n=4 (30/30, sys=10, W=0.3) ──")
    let polarities = ["attract", "repel", "bipolar"]
    let mut pol_peak = []     // SHAPE per polarity
    let mut pol_scalar = []   // SCALAR (Φ at I=0.05) per polarity
    let mut pp = 0
    while pp < 3 {
        let polr = polarities[pp]
        let mut phi = []
        let mut gi = 0
        while gi < mg {
            phi = phi.push(joint_phi(30, 30, polr, 0.3, 10, grid[gi]))
            gi = gi + 1
        }
        let pk = peak_I_of(grid, phi)
        pol_peak = pol_peak.push(pk)
        pol_scalar = pol_scalar.push(phi[0])   // Φ at I=0.05 (magnitude probe)
        println("  polarity=" + polr + "  peak_I=" + str(pk) + "  Φ(0.05)=" + str(phi[0]))
        pp = pp + 1
    }
    let cv_shape_pol = _cv(pol_peak)
    let cv_scalar_pol = _cv(pol_scalar)
    println("  CV_shape(polarity)  = " + str(cv_shape_pol))
    println("  CV_scalar(polarity) = " + str(cv_scalar_pol))

    // ════════════════════════════════════════════════════════════════════
    //  AXIS 2 — RULE (H_642 재현): single ECA n=4, rule {30,54,90,110,184}
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── AXIS 2: RULE (H_642) — single ECA n=4, {30,54,90,110,184} ──")
    let rules = [30, 54, 90, 110, 184]
    let mut rule_peak = []
    let mut rule_scalar = []   // Φ(I=0) magnitude per rule
    let mut rr = 0
    while rr < 5 {
        let rule = rules[rr]
        let mut phi = []
        let mut gi = 0
        while gi < mg {
            phi = phi.push(mean_big_phi(mixed_tpm_rule(rule, _n(), grid[gi]), _n()))
            gi = gi + 1
        }
        let pk = peak_I_of(grid, phi)
        let phi0 = mean_big_phi(eca_tpm(rule, _n()), _n())   // Φ at I=0 (no mixing)
        rule_peak = rule_peak.push(pk)
        rule_scalar = rule_scalar.push(phi0)
        println("  rule=" + str(rule) + "  peak_I=" + str(pk) + "  Φ0=" + str(phi0))
        rr = rr + 1
    }
    let cv_shape_rule = _cv(rule_peak)
    let cv_scalar_rule = _cv(rule_scalar)
    println("  CV_shape(rule)  = " + str(cv_shape_rule))
    println("  CV_scalar(rule) = " + str(cv_scalar_rule))

    // ════════════════════════════════════════════════════════════════════
    //  AXIS 3 — SEED (H_647 재현): fixed rule 110 n=4, LCG jitter, N=8
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── AXIS 3: SEED (H_647) — fixed rule 110 n=4, jitter A=0.30, N=8 ──")
    let nseed = _nseed()
    let mut seed_peak = []
    let mut seed_scalar = []
    let mut sd = 0
    while sd < nseed {
        let tseed = seed_tpm(110, _n(), sd, _jitter())
        let phi0 = mean_big_phi(tseed, _n())     // SCALAR baseline Φ(I=0)
        let mut phi = []
        let mut gi = 0
        while gi < mg {
            phi = phi.push(mean_big_phi(inhibit_mix(tseed, grid[gi]), _n()))
            gi = gi + 1
        }
        let pk = peak_I_of(grid, phi)
        seed_peak = seed_peak.push(pk)
        seed_scalar = seed_scalar.push(phi0)
        println("  seed=" + str(sd) + "  peak_I=" + str(pk) + "  Φ0=" + str(phi0))
        sd = sd + 1
    }
    let cv_shape_seed = _cv(seed_peak)
    let cv_scalar_seed = _cv(seed_scalar)
    println("  CV_shape(seed)  = " + str(cv_shape_seed))
    println("  CV_scalar(seed) = " + str(cv_scalar_seed))

    // ── byte-equal recompute (F5): polarity attract peak redo ────────────
    let t0a = seed_tpm(110, _n(), 0, _jitter())
    let t0b = seed_tpm(110, _n(), 0, _jitter())
    let byte_eq = _abs(mean_big_phi(t0a, _n()) - mean_big_phi(t0b, _n())) <= 1.0e-12

    // ════════════════════════════════════════════════════════════════════
    //  3-AXIS TAXONOMY TABLE + FALSIFIERS
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("════════════════════════════════════════════════════════════")
    println("── 3-AXIS SHAPE-ROBUSTNESS TAXONOMY ──")
    println("  axis      CV_shape     CV_scalar    shape<scalar?")
    println("  polarity  " + str(cv_shape_pol) + "   " + str(cv_scalar_pol) + "   " + str(cv_shape_pol < cv_scalar_pol))
    println("  rule      " + str(cv_shape_rule) + "   " + str(cv_scalar_rule) + "   " + str(cv_shape_rule < cv_scalar_rule))
    println("  seed      " + str(cv_shape_seed) + "   " + str(cv_scalar_seed) + "   " + str(cv_shape_seed < cv_scalar_seed))

    // ── falsifiers ───────────────────────────────────────────────────────
    let f1 = (cv_shape_pol < cv_scalar_pol) && (cv_shape_pol <= 0.05)
    let f2 = cv_shape_rule >= (cv_scalar_rule - 0.10)
    let f3 = cv_shape_seed > cv_scalar_seed
    // axis-dependent: polarity CV_shape << min(rule,seed CV_shape) — qualitative gap
    let mut min_other = cv_shape_rule
    if cv_shape_seed < min_other { min_other = cv_shape_seed }
    let f4 = (cv_shape_pol + 0.10) < min_other
    let f5 = byte_eq

    let supported = f1 && f2 && f3 && f4 && f5
    let partial = f4 && f5 && (!supported)
    let falsified = (!f4) || (!f1)

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED-NUMERICAL" }
    else if falsified { verdict_str = "FALSIFIED" }
    else if partial { verdict_str = "PARTIAL" }

    println("")
    println("  F1 POLARITY-SHAPE-ROBUST (CV_shape<CV_scalar & ≤0.05) = " + str(f1))
    println("  F2 RULE-SHAPE-FRAGILE    (CV_shape ≥ CV_scalar-0.10)  = " + str(f2))
    println("  F3 SEED-SHAPE-FRAGILE    (CV_shape > CV_scalar)       = " + str(f3))
    println("  F4 AXIS-DEPENDENT        (polarity gap > 0.10)        = " + str(f4))
    println("  F5 BYTE-EQUAL                                         = " + str(f5))
    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // ── result.json ──────────────────────────────────────────────────────
    let mut out = "{\n"
    out = out + "  \"hypothesis\": \"H_650\",\n"
    out = out + "  \"slug\": \"shape-robustness-axis-taxonomy\",\n"
    out = out + "  \"meta_of\": \"round-7 shape>scalar robustness — 3-axis taxonomy\",\n"
    out = out + "  \"predecessors\": [\"H_628\", \"H_642\", \"H_647\", \"H_614\"],\n"
    out = out + "  \"n\": 4,\n"
    out = out + "  \"grid\": " + json_arr_f(grid) + ",\n"
    out = out + "  \"polarity_peak_I\": " + json_arr_f(pol_peak) + ",\n"
    out = out + "  \"polarity_scalar\": " + json_arr_f(pol_scalar) + ",\n"
    out = out + "  \"cv_shape_polarity\": " + str(cv_shape_pol) + ",\n"
    out = out + "  \"cv_scalar_polarity\": " + str(cv_scalar_pol) + ",\n"
    out = out + "  \"rule_peak_I\": " + json_arr_f(rule_peak) + ",\n"
    out = out + "  \"rule_scalar\": " + json_arr_f(rule_scalar) + ",\n"
    out = out + "  \"cv_shape_rule\": " + str(cv_shape_rule) + ",\n"
    out = out + "  \"cv_scalar_rule\": " + str(cv_scalar_rule) + ",\n"
    out = out + "  \"nseed\": " + str(nseed) + ",\n"
    out = out + "  \"seed_peak_I\": " + json_arr_f(seed_peak) + ",\n"
    out = out + "  \"seed_scalar\": " + json_arr_f(seed_scalar) + ",\n"
    out = out + "  \"cv_shape_seed\": " + str(cv_shape_seed) + ",\n"
    out = out + "  \"cv_scalar_seed\": " + str(cv_scalar_seed) + ",\n"
    out = out + "  \"byte_eq\": " + str(byte_eq) + ",\n"
    out = out + "  \"f1_polarity_shape_robust\": " + str(f1) + ",\n"
    out = out + "  \"f2_rule_shape_fragile\": " + str(f2) + ",\n"
    out = out + "  \"f3_seed_shape_fragile\": " + str(f3) + ",\n"
    out = out + "  \"f4_axis_dependent\": " + str(f4) + ",\n"
    out = out + "  \"f5_byte_equal\": " + str(f5) + ",\n"
    out = out + "  \"verdict\": \"" + verdict_str + "\"\n"
    out = out + "}\n"

    write_file("UNIVERSE/state/h650_shape_robustness_axis_taxonomy_2026_05_28/result.json", out)
    println("wrote result.json")
}
