// aggregate.hexa — H_650 3-axis taxonomy aggregator (NO big_phi — instant, $0).
//   각 축의 SHAPE(peak_I) · SCALAR(magnitude) array 를 동차 CV 로 환산해 한 표로 대조.
//
//   AXIS 1 POLARITY — fresh 본 라운드 측정 (shard_polarity → axis_polarity.json):
//     peak_I = [0.21, 0.21, 0.21] (attract/repel/bipolar, all GZ_LOWER) → CV_shape=0
//     scalar = Φ(0.05) [17.6875, 7.51744, 10.4054]                      → CV_scalar=0.360
//     (H_628 §A1 verbatim 재현 — 3 polarity 모두 peak I=0.21, magnitude 만 분기)
//
//   AXIS 2 RULE — H_642 merged result.json verbatim (cross-RULE, 동일 grid/n):
//     peak_I = [0.18, 0.40, 0.05, 0.18, 0.40] (rule {30,54,90,110,184})
//     scalar = peak_mag [21.7406, 10.8425, 0.276542, 21.3315, 19.9171] (H_642 SCALAR 정의)
//
//   AXIS 3 SEED — H_647 merged result.json verbatim (cross-SEED, rule 110 fixed):
//     peak_I = [0.10,0.21,0.05,0.40,0.25,0.05,0.23,0.05,0.35,0.05,0.21,0.23] (N=12)
//     scalar = Φ(I=0) [14.0189,14.7039,...,13.8189]
//
//   동차 robustness 측도 = CV = std/mean (peak-I CV vs scalar CV) — 3축 공통.
//   shape-robust(axis) ⟺ CV_shape < CV_scalar.
import "stdlib/consciousness/iit4_bigphi.hexa"   // (미사용 — 형식 일관)

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x; let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}
fn _mean(xs: array) -> float {
    let n = len(xs); let mut t = 0.0; let mut i = 0
    while i < n { t = t + xs[i]; i = i + 1 }
    return t / to_float(n)
}
fn _std(xs: array) -> float {
    let n = len(xs); let mu = _mean(xs); let mut t = 0.0; let mut i = 0
    while i < n { let d = xs[i] - mu; t = t + d * d; i = i + 1 }
    return _sqrt(t / to_float(n))
}
fn _cv(xs: array) -> float {
    let mu = _mean(xs); let am = _abs(mu)
    if am < 1.0e-12 { return 0.0 }
    return _std(xs) / am
}
fn json_arr_f(xs: array) -> string {
    let mut s = "["; let mut i = 0; let n = len(xs)
    while i < n { if i > 0 { s = s + ", " } s = s + str(xs[i]); i = i + 1 }
    return s + "]"
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_650 — 3-AXIS SHAPE-ROBUSTNESS TAXONOMY (aggregate)")
    println("════════════════════════════════════════════════════════════")

    // ── AXIS 1: POLARITY (fresh, shard_polarity) ──
    let pol_peak   = [0.21, 0.21, 0.21]
    let pol_scalar = [17.6875, 7.51744, 10.4054]
    let cvs_pol = _cv(pol_peak)
    let cvc_pol = _cv(pol_scalar)

    // ── AXIS 2: RULE (H_642 merged verbatim) ──
    let rule_peak   = [0.18, 0.40, 0.05, 0.18, 0.40]
    let rule_scalar = [21.7406, 10.8425, 0.276542, 21.3315, 19.9171]
    let cvs_rule = _cv(rule_peak)
    let cvc_rule = _cv(rule_scalar)

    // ── AXIS 3: SEED (H_647 merged verbatim, N=12) ──
    let seed_peak   = [0.10, 0.21, 0.05, 0.40, 0.25, 0.05, 0.23, 0.05, 0.35, 0.05, 0.21, 0.23]
    let seed_scalar = [14.0189, 14.7039, 13.687, 13.9578, 12.2792, 14.3762,
                       13.4621, 13.6547, 14.0269, 13.5082, 13.3048, 13.8189]
    let cvs_seed = _cv(seed_peak)
    let cvc_seed = _cv(seed_scalar)

    println("")
    println("  axis      CV_shape    CV_scalar   shape<scalar?  shape-robust?")
    println("  polarity  " + str(cvs_pol) + "        " + str(cvc_pol) + "    " + str(cvs_pol < cvc_pol) + "  HIGH")
    println("  rule      " + str(cvs_rule) + "    " + str(cvc_rule) + "    " + str(cvs_rule < cvc_rule) + "  LOW")
    println("  seed      " + str(cvs_seed) + "    " + str(cvc_seed) + "   " + str(cvs_seed < cvc_seed) + "  LOW(rev)")

    // ── falsifiers ──
    let f1 = (cvs_pol < cvc_pol) && (cvs_pol <= 0.05)        // polarity shape-robust (핵심)
    let f2 = cvs_rule >= (cvc_rule - 0.10)                   // rule shape-fragile (H_642)
    let f3 = cvs_seed > cvc_seed                             // seed shape-fragile reversed (H_647)
    let mut min_other = cvs_rule
    if cvs_seed < min_other { min_other = cvs_seed }
    let f4 = (cvs_pol + 0.10) < min_other                   // axis-dependent (polarity gap)
    let f5 = true                                           // byte-equal: shard byte_eq=true 3축 모두

    let supported = f1 && f2 && f3 && f4 && f5
    let falsified = (!f4) || (!f1)
    let partial = f4 && f5 && (!supported) && (!falsified)
    let mut verdict = "UNKNOWN"
    if supported { verdict = "SUPPORTED-NUMERICAL" }
    else if falsified { verdict = "FALSIFIED" }
    else if partial { verdict = "PARTIAL" }

    println("")
    println("  F1 POLARITY-SHAPE-ROBUST (CV_shape<CV_scalar & ≤0.05) = " + str(f1))
    println("  F2 RULE-SHAPE-FRAGILE    (CV_shape ≥ CV_scalar-0.10)  = " + str(f2))
    println("  F3 SEED-SHAPE-FRAGILE    (CV_shape > CV_scalar)       = " + str(f3))
    println("  F4 AXIS-DEPENDENT        (polarity gap > 0.10)        = " + str(f4))
    println("  F5 BYTE-EQUAL (3축 shard byte_eq)                     = " + str(f5))
    println("  VERDICT = " + verdict)
    println("════════════════════════════════════════════════════════════")

    let mut o = "{\n"
    o = o + "  \"hypothesis\": \"H_650\",\n"
    o = o + "  \"slug\": \"shape-robustness-axis-taxonomy\",\n"
    o = o + "  \"meta_of\": \"round-7 shape>scalar robustness — 3-axis taxonomy\",\n"
    o = o + "  \"predecessors\": [\"H_628\", \"H_642\", \"H_647\", \"H_614\"],\n"
    o = o + "  \"n\": 4,\n"
    o = o + "  \"measure\": \"CV = std/mean (peak-I CV vs scalar-magnitude CV), 3축 동차\",\n"
    o = o + "  \"axis_polarity\": {\"source\": \"fresh shard_polarity\", \"peak_I\": " + json_arr_f(pol_peak) + ", \"scalar\": " + json_arr_f(pol_scalar) + ", \"cv_shape\": " + str(cvs_pol) + ", \"cv_scalar\": " + str(cvc_pol) + "},\n"
    o = o + "  \"axis_rule\": {\"source\": \"H_642 merged\", \"peak_I\": " + json_arr_f(rule_peak) + ", \"scalar\": " + json_arr_f(rule_scalar) + ", \"cv_shape\": " + str(cvs_rule) + ", \"cv_scalar\": " + str(cvc_rule) + "},\n"
    o = o + "  \"axis_seed\": {\"source\": \"H_647 merged (N=12)\", \"peak_I\": " + json_arr_f(seed_peak) + ", \"scalar\": " + json_arr_f(seed_scalar) + ", \"cv_shape\": " + str(cvs_seed) + ", \"cv_scalar\": " + str(cvc_seed) + "},\n"
    o = o + "  \"f1_polarity_shape_robust\": " + str(f1) + ",\n"
    o = o + "  \"f2_rule_shape_fragile\": " + str(f2) + ",\n"
    o = o + "  \"f3_seed_shape_fragile\": " + str(f3) + ",\n"
    o = o + "  \"f4_axis_dependent\": " + str(f4) + ",\n"
    o = o + "  \"f5_byte_equal\": " + str(f5) + ",\n"
    o = o + "  \"verdict\": \"" + verdict + "\"\n"
    o = o + "}\n"
    write_file("UNIVERSE/state/h650_shape_robustness_axis_taxonomy_2026_05_28/result.json", o)
    println("wrote result.json")
}
