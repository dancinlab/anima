// shard_rule.hexa — H_650 AXIS 2 (RULE, H_642 재현) — light shard.
//   single ECA n=4, rule {30,54,90,110,184}; 5 × 13-grid × 16-state-mean big_phi.
//   SHAPE = argmax_I|dΦ/dI|, SCALAR = Φ(I=0) magnitude. writes axis_rule.json.
import "/private/tmp/u-h650b/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x; let mut i = 0
    while i < 60 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}
fn _mean(xs: array) -> float {
    let n = len(xs); let mut t = 0.0; let mut i = 0
    while i < n { t = t + xs[i]; i = i + 1 }
    return t / to_float(n)
}
fn _std(xs: array) -> float {
    let n = len(xs); let mu = _mean(xs); let mut t = 0.0; let mut i = 0
    while i < n { let d = xs[i] - mu; t = t + d * d; i = i + 1 }
    return _sqrt(t / to_float(n))
}
fn _cv(xs: array) -> float {
    let mu = _mean(xs); let am = _abs(mu)
    if am < 1.0e-12 { return 0.0 }
    return _std(xs) / am
}
fn peak_I_of(grid: array, phi: array) -> float {
    let m = len(grid); let mut peak_idx = 0; let mut peak_mag = 0.0 - 1.0; let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 { d = (phi[1]-phi[0])/(grid[1]-grid[0]) }
        else if k == m-1 { d = (phi[m-1]-phi[m-2])/(grid[m-1]-grid[m-2]) }
        else { d = (phi[k+1]-phi[k-1])/(grid[k+1]-grid[k-1]) }
        let ad = _abs(d)
        if ad > peak_mag { peak_mag = ad; peak_idx = k }
        k = k + 1
    }
    return grid[peak_idx]
}
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n); let mut total = 0.0; let mut s = 0
    while s < full { let r = big_phi(tpm, n, s); total = total + r[0]; s = s + 1 }
    return total / to_float(full)
}
fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n); let scale = 1.0 - inhibit; let mut out = []
    let mut k = 0; let total = len(base)
    while k < total { out = out.push(base[k] * scale); k = k + 1 }
    return out
}
fn json_arr_f(xs: array) -> string {
    let mut s = "["; let mut i = 0; let n = len(xs)
    while i < n { if i > 0 { s = s + ", " } s = s + str(xs[i]); i = i + 1 }
    return s + "]"
}
fn main() {
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40, 0.50, 0.70, 0.95]
    let mg = len(grid)
    let rules = [30, 54, 90, 110, 184]
    let mut peaks = []; let mut scalars = []; let mut rr = 0
    while rr < 5 {
        let rule = rules[rr]; let mut phi = []; let mut gi = 0
        while gi < mg { phi = phi.push(mean_big_phi(mixed_tpm(rule, 4, grid[gi]), 4)); gi = gi + 1 }
        peaks = peaks.push(peak_I_of(grid, phi))
        scalars = scalars.push(mean_big_phi(eca_tpm(rule, 4), 4))
        println("  rule=" + str(rule) + " peak_I=" + str(peaks[rr]) + " Φ0=" + str(scalars[rr]))
        rr = rr + 1
    }
    let cvs = _cv(peaks); let cvc = _cv(scalars)
    let d = _abs(mean_big_phi(eca_tpm(110, 4), 4) - mean_big_phi(eca_tpm(110, 4), 4))
    let beq = d <= 1.0e-12
    println("CV_shape=" + str(cvs) + " CV_scalar=" + str(cvc) + " byte_eq=" + str(beq))
    let mut o = "{\n"
    o = o + "  \"axis\": \"rule\",\n"
    o = o + "  \"peak_I\": " + json_arr_f(peaks) + ",\n"
    o = o + "  \"scalar\": " + json_arr_f(scalars) + ",\n"
    o = o + "  \"cv_shape\": " + str(cvs) + ",\n"
    o = o + "  \"cv_scalar\": " + str(cvc) + ",\n"
    o = o + "  \"byte_eq\": " + str(beq) + "\n"
    o = o + "}\n"
    write_file("UNIVERSE/state/h650_shape_robustness_axis_taxonomy_2026_05_28/axis_rule.json", o)
    println("wrote axis_rule.json")
}
