// state/h628_inverse_u_polarity_2026_05_28/run_h628.hexa
//
//   H_628 — inverse-U dΦ/dI peak shift by pair polarity (E5 × F2 cell)
//
//   cross-link
//     • H_351 (axis E5/E1, 🟢 SUPPORTED 5/5) — single-substrate dΦ/dI inverse-U
//       peak at I=0.18 ≈ GZ_LOWER (0.21232). inhibition I mapping = TPM mixing
//       tpm_mixed = (1-I)·tpm (per-cell GABA-style suppression toward 0).
//     • H_610 (axis F2, 🔴 FALSIFIED) — pair coupling polarity {attract, repel,
//       bipolar} ⊥ collective big-Φ (ANOVA F=0.361 ≪ 3.40, polarity-axis flat).
//       Polarity coupling rule + 2-ECA joint n=4 substrate inherited verbatim.
//     • H_204 (inverse-U Φ vs autopoietic threshold) — H_351 value-peak sister.
//
//   QUESTION (E5 × F2 cell)
//     Does the pair coupling polarity {attract, repel, bipolar} SHIFT the position
//     of the collective dΦ_collective/dI inverse-U peak? i.e. does each polarity
//     have a DIFFERENT argmax_I |dΦ/dI|? H_351 motivates the inverse-U dΦ/dI peak;
//     H_610 found polarity ⊥ collective-Φ MAGNITUDE — H_628 tests whether polarity
//     nonetheless shifts the DERIVATIVE peak LOCATION (a structural, orthogonal
//     question H_610 did not address).
//
//   SUBSTRATE (H_610 inherit)
//     A = ECA rule_a (n_a=2), B = ECA rule_b (n_b=2), joint n=4 (state 16).
//     seed (rule_a=30, rule_b=30, sys=10) — H_610 seed-2, the rule-30 class-III
//     chaotic pair. CHOSEN because it is the only H_610 seed where ALL THREE
//     polarities give non-degenerate collective Φ at I=0 (attract=17.13,
//     repel=7.80, bipolar=10.30 — probe.hexa); H_610 seed-1 (rule-110, sys=5)
//     collapses attract/repel to Φ≡0 (constant TPM → no integration), which would
//     make a derivative-peak comparison vacuous. W=0.3 mid-tier coupling (soft-OR
//     attract / XOR repel). Per a_completeness_over_cheap: pick the substrate
//     that actually exercises all 3 polarity curves, not the cheap-default seed.
//     polarity coupling rule (attract/repel/bipolar) verbatim from H_610.
//
//   INHIBITION I MAPPING (H_351 inherit)
//     For each I in the sweep, the coupled joint TPM is suppressed:
//       tpm_mixed[s,j] = (1-I)·tpm_coupled[s,j]   (GABA-style toward 0)
//     I=0 → pure polarity-coupled substrate; I=1 → Φ=0 (full inhibit).
//     big_phi(tpm_mixed, 4, sys) per (polarity, I).
//
//   dΦ/dI (central finite difference, H_351 inherit)
//     dPhi[i] = (Phi[i+1]-Phi[i-1]) / (I[i+1]-I[i-1])   (interior)
//     edges = forward/backward. peak = argmax_i |dPhi[i]|.
//
//   PRE-REGISTERED FALSIFIER (frozen 2026-05-28, BEFORE measuring)
//     F628.1 POLARITY-SHIFTS-PEAK:
//       the 3 polarities {attract, repel, bipolar} have DIFFERENT dΦ/dI peak
//       positions — max pairwise |I_peak(p) - I_peak(q)| ≥ one grid step
//       (≥ 0.05). If all 3 peaks coincide → polarity-invariant.
//     F628.2 PEAK-DISTINCT-COUNT:
//       at least 2 distinct peak-I values among the 3 polarities (not all equal).
//     F628.3 UNIMODAL-PER-POLARITY:
//       each polarity's dΦ/dI has sign-change ≤ 1 (inverse-U preserved per H_351).
//     F628.4 H351/H610-ANCHOR:
//       I=0 reproduces the polarity-coupled Φ (H_610 substrate, finite, >0 for
//       all 3 polarities on this seed); I=1 → Φ ≈ 0 (full inhibit, H_351 F4).
//     F628.5 BOUND/DET:
//       Φ ≥ 0 across grid; re-run byte-identical.
//     F628.6 POST-HOC: no verdict-direction edit after measurement (raw#82).
//
//   VERDICT_RULE
//     F628.1 PASS (peaks differ) → 🟢 SUPPORTED (polarity shifts dΦ/dI peak)
//     F628.1 FAIL (peaks coincide) + F628.4 + F628.5 PASS
//                                  → 🔴 FALSIFIED (polarity-invariant peak)
//     mixed → 🟡 PARTIAL
//
//   honest scope (raw#91 c3)
//     • IIT4 system-level big-Φ scalar (NOT full 18-atom WB PID — H_610 L6 carry)
//     • toy 2-ECA n=4 joint substrate (H_610 L1 carry — state-space reduced)
//     • single seed (rule_a=rb=30, sys=10) — H_610 L4 carry (rule-space is the
//       true Φ-variance driver; the one seed exercising all 3 polarity curves)
//     • inhibition = (1-I) TPM mixing (one suppression mode — H_351 §3.2 choice)
//     • bipolar = cell-parity mix (H_610 L3 carry — alternative bipolar defs untested)
//     • derivative PEAK-LOCATION claim, NOT a Φ-magnitude claim (H_610 already
//       ruled magnitude flat; H_628 asks the orthogonal structural question)
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn bit_of(s: int, b: int) -> int {
    return iit4_bit(s, b)
}

// 2-cell ring ECA next-value (H_610 inherit verbatim).
fn eca_next(rule: int, state3: int, i: int) -> int {
    let l = bit_of(state3, (i - 1 + 2) % 2)
    let c = bit_of(state3, i)
    let r = bit_of(state3, (i + 1) % 2)
    let idx = 4 * l + 2 * c + r
    return bit_of(rule, idx)
}

// polarity coupling (H_610 inherit verbatim).
fn couple_a_next(a_prime: int, b_prime: int, polarity: string, w: float, i: int) -> int {
    let mut eff = polarity
    if polarity == "bipolar" {
        if i == 1 { eff = "repel" } else { eff = "attract" }
    }
    if eff == "attract" {
        if w >= 0.8 { return b_prime }
        if w >= 0.3 {
            if a_prime == 1 { return 1 }
            return b_prime
        }
        return a_prime
    }
    if eff == "repel" {
        if w >= 0.8 { return 1 - b_prime }
        if w >= 0.3 {
            if a_prime == b_prime { return 0 }
            return 1
        }
        return a_prime
    }
    return a_prime
}
fn couple_b_next(b_prime: int, a_prime: int, polarity: string, w: float, i: int) -> int {
    return couple_a_next(b_prime, a_prime, polarity, w, i)
}

// joint 4-cell coupled TPM (H_610 inherit) — then apply inhibition I as (1-I)·tpm.
fn build_joint_tpm_inhib(rule_a: int, rule_b: int, polarity: string, w: float, I: float) -> array {
    let full = 16
    let suppress = 1.0 - I
    let mut t = []
    let mut s = 0
    while s < full {
        let sa = s % 4
        let sb = (s / 4) % 4
        let mut j = 0
        while j < 2 {
            let a_prime = eca_next(rule_a, sa, j)
            let b_prime = eca_next(rule_b, sb, j)
            let nxt = couple_a_next(a_prime, b_prime, polarity, w, j)
            t = t.push(to_float(nxt) * suppress)
            j = j + 1
        }
        let mut k = 0
        while k < 2 {
            let a_prime = eca_next(rule_a, sa, k)
            let b_prime = eca_next(rule_b, sb, k)
            let nxt = couple_b_next(b_prime, a_prime, polarity, w, k)
            t = t.push(to_float(nxt) * suppress)
            k = k + 1
        }
        s = s + 1
    }
    return t
}

fn measure_phi(rule_a: int, rule_b: int, polarity: string, w: float, sys_state: int, I: float) -> float {
    let tpm = build_joint_tpm_inhib(rule_a, rule_b, polarity, w, I)
    let res = big_phi(tpm, 4, sys_state)
    return res[0]
}

// dΦ/dI central finite difference; returns peak grid-index (argmax |dPhi|).
fn dphi_peak_idx(phis: array, grid: array) -> int {
    let m = len(phis)
    let mut best_i = 0
    let mut best_abs = 0.0 - 1.0
    let mut i = 0
    while i < m {
        let mut d = 0.0
        if i == 0 {
            d = (phis[1] - phis[0]) / (grid[1] - grid[0])
        } else {
            if i == m - 1 {
                d = (phis[m - 1] - phis[m - 2]) / (grid[m - 1] - grid[m - 2])
            } else {
                d = (phis[i + 1] - phis[i - 1]) / (grid[i + 1] - grid[i - 1])
            }
        }
        let mut ad = d
        if ad < 0.0 { ad = 0.0 - ad }
        if ad > best_abs { best_abs = ad; best_i = i }
        i = i + 1
    }
    return best_i
}

fn dphi_signchanges(phis: array, grid: array) -> int {
    let m = len(phis)
    let mut prev_sign = 0
    let mut changes = 0
    let mut i = 0
    while i < m {
        let mut d = 0.0
        if i == 0 {
            d = (phis[1] - phis[0]) / (grid[1] - grid[0])
        } else {
            if i == m - 1 {
                d = (phis[m - 1] - phis[m - 2]) / (grid[m - 1] - grid[m - 2])
            } else {
                d = (phis[i + 1] - phis[i - 1]) / (grid[i + 1] - grid[i - 1])
            }
        }
        let mut sgn = 0
        if d > 0.000001 { sgn = 1 }
        if d < 0.0 - 0.000001 { sgn = 0 - 1 }
        if sgn != 0 {
            if prev_sign != 0 {
                if sgn != prev_sign { changes = changes + 1 }
            }
            prev_sign = sgn
        }
        i = i + 1
    }
    return changes
}

fn main() {
    println("================================================================")
    println("  H_628 — inverse-U dΦ/dI peak shift by pair polarity (E5×F2)")
    println("  H_351 (dΦ/dI inverse-U) × H_610 (pair polarity, 🔴)")
    println("  Substrate: 2-ECA joint n=4 · seed (rule_a=30,rule_b=30,sys=10)")
    println("================================================================")

    let rule_a = 30
    let rule_b = 30
    let sys = 10
    let w = 0.3             // mid-tier coupling (soft-OR attract / XOR repel)
    let polarities = ["attract", "repel", "bipolar"]

    // GZ-dense inhibition grid (H_351 양식)
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40, 0.50, 0.70, 0.95]
    let mg = len(grid)

    let mut peak_Is = []
    let mut signch = []
    let mut phi_I0 = []
    let mut phi_I1 = []

    let mut pi = 0
    while pi < 3 {
        let polarity = polarities[pi]
        let mut phis = []
        let mut gi = 0
        while gi < mg {
            let I = grid[gi]
            let phi = measure_phi(rule_a, rule_b, polarity, w, sys, I)
            phis = phis.push(phi)
            gi = gi + 1
        }
        let pidx = dphi_peak_idx(phis, grid)
        let peakI = grid[pidx]
        let sc = dphi_signchanges(phis, grid)
        let p0 = measure_phi(rule_a, rule_b, polarity, w, sys, 0.0)
        let p1 = measure_phi(rule_a, rule_b, polarity, w, sys, 1.0)
        println("")
        println("  polarity=" + polarity + " :")
        let mut gj = 0
        while gj < mg {
            println("    I=" + str(grid[gj]) + " Φ=" + str(phis[gj]))
            gj = gj + 1
        }
        println("    → dΦ/dI peak at I=" + str(peakI) + " (grid idx " + str(pidx) + "), sign-changes=" + str(sc))
        println("    → Φ(I=0)=" + str(p0) + "  Φ(I=1)=" + str(p1))
        peak_Is = peak_Is.push(peakI)
        signch = signch.push(sc)
        phi_I0 = phi_I0.push(p0)
        phi_I1 = phi_I1.push(p1)
        pi = pi + 1
    }

    // ── per-polarity peak summary ────────────────────────────────────────
    println("")
    println("  ── per-polarity dΦ/dI peak position ──")
    println("    attract : I_peak = " + str(peak_Is[0]))
    println("    repel   : I_peak = " + str(peak_Is[1]))
    println("    bipolar : I_peak = " + str(peak_Is[2]))

    // ── F628.1 POLARITY-SHIFTS-PEAK ──────────────────────────────────────
    let mut max_pair = 0.0
    let d_ar = peak_Is[0] - peak_Is[1]
    let d_ab = peak_Is[0] - peak_Is[2]
    let d_rb = peak_Is[1] - peak_Is[2]
    let mut a_ar = d_ar
    if a_ar < 0.0 { a_ar = 0.0 - a_ar }
    let mut a_ab = d_ab
    if a_ab < 0.0 { a_ab = 0.0 - a_ab }
    let mut a_rb = d_rb
    if a_rb < 0.0 { a_rb = 0.0 - a_rb }
    max_pair = a_ar
    if a_ab > max_pair { max_pair = a_ab }
    if a_rb > max_pair { max_pair = a_rb }
    println("  F628.1 max pairwise |ΔI_peak| = " + str(max_pair))
    check("F628.1 POLARITY-SHIFTS-PEAK (max pairwise |ΔI_peak| ≥ 0.05)", max_pair >= 0.05 - 0.000001)

    // ── F628.2 PEAK-DISTINCT-COUNT ───────────────────────────────────────
    let mut distinct = 1
    if !approx(peak_Is[1], peak_Is[0]) { distinct = distinct + 1 }
    let mut bip_new = true
    if approx(peak_Is[2], peak_Is[0]) { bip_new = false }
    if approx(peak_Is[2], peak_Is[1]) { bip_new = false }
    if bip_new { distinct = distinct + 1 }
    println("  F628.2 distinct peak-I values = " + str(distinct))
    check("F628.2 PEAK-DISTINCT-COUNT (≥ 2 distinct peak-I among 3 polarities)", distinct >= 2)

    // ── F628.3 UNIMODAL-PER-POLARITY ─────────────────────────────────────
    let unimodal = (signch[0] <= 1) && (signch[1] <= 1) && (signch[2] <= 1)
    println("  F628.3 sign-changes attract=" + str(signch[0]) + " repel=" + str(signch[1]) + " bipolar=" + str(signch[2]))
    check("F628.3 UNIMODAL-PER-POLARITY (each polarity dΦ/dI sign-change ≤ 1)", unimodal)

    // ── F628.4 H351/H610-ANCHOR ──────────────────────────────────────────
    let anchor0 = (phi_I0[0] > 0.001) && (phi_I0[1] > 0.001) && (phi_I0[2] > 0.001)
    check("F628.4a ANCHOR I=0 all-3-polarity Φ > 0 (non-degenerate H_610 seed-2)", anchor0)
    let anchor1 = approx(phi_I1[0], 0.0) && approx(phi_I1[1], 0.0) && approx(phi_I1[2], 0.0)
    println("  F628.4b Φ(I=1) attract=" + str(phi_I1[0]) + " repel=" + str(phi_I1[1]) + " bipolar=" + str(phi_I1[2]))
    check("F628.4b ANCHOR I=1 full-inhibit Φ ≈ 0 (H_351 F4 decay)", anchor1)

    // ── F628.5 BOUND/DET ─────────────────────────────────────────────────
    let det = measure_phi(rule_a, rule_b, "attract", w, sys, grid[3])
    let det0 = measure_phi(rule_a, rule_b, "attract", w, sys, grid[3])
    check("F628.5b DETERMINISM re-run byte-identical (attract I=0.18)", approx(det, det0))
    let bound_ok = (phi_I0[0] >= 0.0 - 0.000001) && (phi_I0[1] >= 0.0 - 0.000001) && (phi_I0[2] >= 0.0 - 0.000001)
    check("F628.5a BOUND Φ ≥ 0 anchors", bound_ok)

    // ── Verdict ──────────────────────────────────────────────────────────
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL  (n_polarity=3, grid=" + str(mg) + ")")
    let shifts = (max_pair >= 0.05 - 0.000001)
    if shifts && (distinct >= 2) {
        println("  VERDICT: H1 SUPPORTED — pair polarity SHIFTS the dΦ/dI inverse-U peak")
        println("           position; attract/repel/bipolar have distinct peak-I.")
    } else {
        if !shifts {
            println("  VERDICT: H1 FALSIFIED — the dΦ/dI peak position is POLARITY-INVARIANT")
            println("           (all 3 polarities peak at the same I). polarity ⊥ derivative-")
            println("           peak-LOCATION, extending H_610's polarity ⊥ Φ-MAGNITUDE closed-")
            println("           negative to the structural (peak-position) axis.")
        } else {
            println("  VERDICT: PARTIAL — shift seen but distinct-count incomplete.")
        }
    }
    println("================================================================")
    if FAIL > 0 { panic("H_628 had FALSIFIER FAILURES") }
}
