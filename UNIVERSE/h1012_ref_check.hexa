// H_1012 — stdlib reference emitter for the n=5 / n=6 ≡-proof.
// Prints big_phi (iit4_bigphi.hexa) and iit4_faithful_phi (faithful_phi.hexa)
// at high precision (x1e9 integer) on tiny FIXED reference inputs at n=5 and n=6,
// so the python CPU mirror can be PROVEN byte-faithful at the NEW n before it is
// trusted for the H_1012 planning condition contrasts. Same discipline as
// h1002_bigphi_ref.hexa + h999_ref_check.hexa. g5 CODE-measured.
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4/faithful_phi.hexa"

// directed n-ring TPM: u_i' = u_{(i+1) mod n}. Flat tpm[s*n+u].
fn ring_tpm(n: int) -> array {
    let mut t = []
    let full = pow_int(2, n)
    let mut s = 0
    while s < full {
        let mut u = 0
        while u < n {
            let nxt = (u + 1) % n
            t = t.push(to_float(iit4_bit(s, nxt)))
            u = u + 1
        }
        s = s + 1
    }
    return t
}

fn pow_int(b: int, e: int) -> int {
    let mut r = 1
    let mut i = 0
    while i < e { r = r * b; i = i + 1 }
    return r
}

fn emit_big(name: string, tpm: array, n: int, s: int) {
    let r = big_phi(tpm, n, s)
    print(name)
    print(" bigphi_x1e9= ")
    print((r[0] * 1000000000.0).to_int())
    println("")
}

// faithful ref: a fixed n×dim integer state (row-major flat farr), n_bins=2.
// Each cell c gets the deterministic trace (c+1)*[1,2,3,4,5,6] truncated to dim.
fn faithful_ref(n: int, dim: int) -> float {
    let st = farr_zeros(n * dim)
    let mut c = 0
    while c < n {
        let mut k = 0
        while k < dim {
            let v = to_float((c + 1) * (k + 1))
            let _ = farr_set(st, c * dim + k, v)
            k = k + 1
        }
        c = c + 1
    }
    let phi = iit4_faithful_phi(st, n, dim, 2)
    let _ = farr_free(st)
    return phi
}

fn main() {
    // big-Φ on directed n-rings (deterministic, fully irreducible cycles)
    emit_big("ring5_s31", ring_tpm(5), 5, 31)
    emit_big("ring5_s24", ring_tpm(5), 5, 24)
    emit_big("ring6_s63", ring_tpm(6), 6, 63)
    emit_big("ring6_s42", ring_tpm(6), 6, 42)
    // faithful_phi at n=5 / n=6 on fixed integer traces (dim=6, n_bins=2)
    print("faithful_n5_dim6_nb2_x1e9= ")
    print((faithful_ref(5, 6) * 1000000000.0).to_int())
    println("")
    print("faithful_n6_dim6_nb2_x1e9= ")
    print((faithful_ref(6, 6) * 1000000000.0).to_int())
    println("")
}
