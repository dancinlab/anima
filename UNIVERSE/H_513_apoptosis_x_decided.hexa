fn product_death(m: f64, p: f64, w: f64, c: f64, theta: f64) -> bool { return (m*p*w*c) < theta }
fn check_h513() -> bool { let lo = product_death(0.1,0.1,0.1,0.1,0.01); let hi = !product_death(0.9,0.9,0.9,0.9,0.01); return lo && hi }
fn main() { if check_h513() { print("H_513 OK") } else { print("H_513 FAIL") } }
