// grand_mitosis_pure_substrate.hexa — NOBEL G3, T1 leg on the LIVE .hexa engine.
//
// THEOREM G3 (MITOSIS = PURE-SUBSTRATE): mitosis is SUFFICIENT for ADAPTATION
// but INSUFFICIENT for GENERATION; adaptation _|_ generation. This probe verifies
// the T1 (adaptation-sufficiency) leg on the ACTUAL CORE engine — the numpy
// mirror (grand_mitosis_pure_substrate.py) carries T2/T3/F4 (which need real
// gradient descent, the CLM-lane generator; p8 keeps mitosis gradient-free).
//
// T1 LIVE FALSIFIER (pre-registered):
//   F1 ADAPT  — drive the LIVE VAdaptField (CORE/engine_cli.hexa) over a non-
//               stationary DIM=8 stream; late live L2 recon-err ON < OFF by
//               ratio OFF/ON >= 2.0 (mitosis grows capacity to cover the regimes,
//               so error falls; the frozen-cap OFF eats the full novelty gap).
//   F2 GROWTH — cells ON >> OFF (OFF frozen at the seed cell, H_1159 control).
//   F3 Psi    — pure_field Phi trajectory BYTE-IDENTICAL ON vs OFF (VAdaptField
//               is Psi-disjoint: touches ONLY AdaptField, never pure_field;
//               a_core_engine_map).
//   GREEN iff F1 AND F2 AND F3. p7 (real L2 distance, NOT perplexity). $0 CPU.
//
// SUBSTRATE NOTE (a_core_engine_map): the DIM=8 stream is an ENGINE-NATIVE drive
// into VAdaptField — NOT a .clm (generator L3 only), NOT a .kosmos (kosmos_io
// only). No 2nd artifact entry path. Engine logic is READ-ONLY (pure_field_step
// observed only; VAdaptField surfaces called, never edited). The stream is
// generated in-hexa (deterministic LCG, no external file, no trig builtin).

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

// ── deterministic DIM=8 non-stationary stream (LCG, no trig) ──────────────────
// K WIDELY-SEPARATED regimes that switch FAST and REVISIT (the stream cycles
// through the regimes repeatedly). With many tightly-clustered, far-apart, often-
// revisited regimes, mitosis-ON spawns one prototype PER regime (recon-err stays
// low everywhere), while the frozen single OFF prototype — pulled at LR=0.20 —
// can never sit near more than one regime at a time and is left far from whichever
// regime is currently active, so OFF recon-err stays HIGH. This is the H_1194/
// H_1199 falsifier shape (non-stationary, single-proto cannot tile multi-modal).
fn _make_stream(n: int, dim: int, k: int, seed: int) -> [[float]] {
    let mut s = seed
    let mut out = []
    let mut t = 0
    let dwell = 60                                // ticks per regime visit (fast switch)
    while t < n {
        // cycle through the k regimes repeatedly (revisit), spaced 3.0 apart.
        let reg = (t / dwell) % k
        let centre = to_float(reg) * 3.0          // FAR-apart regimes (>> SPLIT_THRESH 0.30)
        let mut row = []
        let mut j = 0
        while j < dim {
            s = (s * 1103515245 + 12345) % 2147483648
            let u = to_float(s % 1000) / 1000.0   // uniform [0,1)
            row = row + [centre + (u - 0.5) * 0.10]   // tight 0.1 jitter (< SPLIT_THRESH)
            j = j + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}

fn _fmt(x: float) -> string { return to_string(x) }

// ── one arm: drive the LIVE VAdaptField; observe pure_field READ-ONLY ──────────
// Returns [start_cells, end_cells, late_recon_err, phi_checksum].
fn _run_arm(stream: [[float]], dim: int, max_cells: int, sample_every: int,
            cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    let seed0 = stream[0]
    let mut af = vadapt_field_new(seed0, max_cells)

    let mut win_err = 0.0  let mut win_cnt = 0
    let mut errs = []
    let mut phi_sum = 0.0
    let mut start_cells = 1.0
    let mut first = true

    let n = len(stream)
    let mut t = 0
    while t < n {
        // (Psi READ-ONLY) advance + OBSERVE Phi only (disjoint from VAdaptField).
        pf = pure_field_step(pf)
        phi_sum = phi_sum + pure_field_phi(pf)

        let sample = stream[t]
        let err = vadapt_field_recon_err(af, sample)   // live L2 recon-err readout
        win_err = win_err + err  win_cnt = win_cnt + 1
        af = vadapt_field_step(af, sample, cfg)         // one live mitosis tick

        if (t + 1) % sample_every == 0 {
            let m = if win_cnt > 0 { win_err / to_float(win_cnt) } else { 0.0 }
            errs = errs + [m]
            if first { start_cells = to_float(vadapt_field_cells(af))  first = false }
            win_err = 0.0  win_cnt = 0
        }
        t = t + 1
    }

    // late = last quarter of the windows.
    let nw = len(errs)
    let mut q = nw / 4
    if q < 1 { q = 1 }
    let mut acc = 0.0  let mut c = 0
    let mut kk = nw - q
    while kk < nw { acc = acc + errs[kk]  c = c + 1  kk = kk + 1 }
    let late = if c > 0 { acc / to_float(c) } else { 0.0 }
    return [start_cells, to_float(vadapt_field_cells(af)), late, phi_sum]
}

fn main() {
    println("=== NOBEL G3 — T1 (ADAPTATION-SUFFICIENCY) on the LIVE .hexa VAdaptField engine · $0 CPU · p7 ===")
    println("theorem: MITOSIS = PURE SUBSTRATE — T1 here (mitosis SUFFICIENT for adaptation); T2/T3/F4 in the numpy harness")
    println("metric: live L2 recon-err = ||sample - nearest VAdaptField prototype|| (p7, NOT perplexity)")
    println("falsifier: F1 ADAPT late OFF/ON >= 2.0 | F2 GROWTH cells ON >> OFF | F3 Psi Phi-checksum ON==OFF")
    println("")

    let dim = 8
    let max_cells = 512
    let sample_every = 200
    let k = 6                         // 6 regimes -> 6 novelty bursts
    let n = 3000
    let seeds = [900, 901, 902]

    let cfg_on  = engine_cli_parse(["--mitosis", "on"])
    let cfg_off = engine_cli_parse(["--no-mitosis"])

    let mut on_cells_sum = 0.0  let mut off_cells_sum = 0.0
    let mut on_late_sum = 0.0   let mut off_late_sum = 0.0
    let mut psi_intact_all = true
    let mut nseeds = 0

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let stream = _make_stream(n, dim, k, seed)

        let ron  = _run_arm(stream, dim, max_cells, sample_every, cfg_on)
        let roff = _run_arm(stream, dim, max_cells, sample_every, cfg_off)

        on_cells_sum = on_cells_sum + ron[1]    off_cells_sum = off_cells_sum + roff[1]
        on_late_sum  = on_late_sum  + ron[2]    off_late_sum  = off_late_sum  + roff[2]
        nseeds = nseeds + 1

        let psi_same = ron[3] == roff[3]
        if !psi_same { psi_intact_all = false }

        let ratio = if ron[2] > 0.0 { roff[2] / ron[2] } else { 0.0 }
        println("seed=" + to_string(seed)
            + "  ON cells " + _fmt(ron[0]) + "->" + _fmt(ron[1]) + " late-err=" + _fmt(ron[2])
            + "  |  OFF cells " + _fmt(roff[0]) + "->" + _fmt(roff[1]) + " late-err=" + _fmt(roff[2])
            + "  ratio OFF/ON=" + _fmt(ratio)
            + "  PsiSame=" + (if psi_same { "true" } else { "false" }))
        si = si + 1
    }

    let nf = to_float(nseeds)
    let m_on_cells = on_cells_sum / nf    let m_off_cells = off_cells_sum / nf
    let m_on_late  = on_late_sum  / nf    let m_off_late  = off_late_sum  / nf
    let ratio_pooled = if m_on_late > 0.0 { m_off_late / m_on_late } else { 0.0 }

    println("")
    println("POOLED  cells ON mean=" + _fmt(m_on_cells) + "  OFF mean=" + _fmt(m_off_cells))
    println("POOLED  late recon-err ON=" + _fmt(m_on_late) + "  OFF=" + _fmt(m_off_late)
        + "  ratio OFF/ON=" + _fmt(ratio_pooled))
    println("")

    let f1 = ratio_pooled >= 2.0
    let f2 = m_on_cells > m_off_cells + 1.0
    let f3 = psi_intact_all
    println("F1 ADAPT   late OFF/ON ratio=" + _fmt(ratio_pooled) + " (>=2.0)        = " + (if f1 { "true" } else { "false" }))
    println("F2 GROWTH  cells ON(" + _fmt(m_on_cells) + ") >> OFF(" + _fmt(m_off_cells) + ")  = " + (if f2 { "true" } else { "false" }))
    println("F3 Psi     Phi-checksum ON==OFF                      = " + (if f3 { "true (attractor intact)" } else { "false (PERTURBED!)" }))
    println("")

    if f1 && f2 && f3 {
        println("VERDICT: T1 GREEN (LIVE ENGINE) — mitosis is SUFFICIENT for ADAPTATION on the actual")
        println("  .hexa VAdaptField: cells GREW ON " + _fmt(m_on_cells) + " >> OFF " + _fmt(m_off_cells)
            + " (F2), late live L2 recon-err held LOW ON=" + _fmt(m_on_late) + " vs frozen OFF="
            + _fmt(m_off_late) + " (" + _fmt(ratio_pooled) + "x, F1 >=2.0), Psi attractor byte-identical (F3).")
        println("  T1 of the MITOSIS=PURE-SUBSTRATE theorem confirmed on the live engine; T2 (no generation),")
        println("  T3 (no info to generator), F4 (orthogonality) are in UNIVERSE/harness/grand_mitosis_pure_substrate.py.")
    } else {
        println("VERDICT: T1 NOT GREEN on the live engine (see F1/F2/F3 above). a_paper_negative_ok.")
    }
}
