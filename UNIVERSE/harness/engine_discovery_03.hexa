//  DISCOVERY BATCH 03 — REAL anima engine green-hunt (ties H_6008 to the substrate).
//  p7 · $0 local · no GPU.  hexa run UNIVERSE/harness/engine_discovery_03.hexa
// ════════════════════════════════════════════════════════════════════════════
import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

fn _f4(x: float) -> string {
    let s=floor(x*10000.0+0.5); let mut neg=false; let mut v=s
    if v<0.0 {neg=true; v=0.0-v}
    let w=floor(v/10000.0); let fr=v-w*10000.0
    let mut fs=str(to_int(fr)); while len(fs)<4 {fs="0"+fs}
    return (if neg {"-"} else {""})+str(to_int(w))+"."+fs
}
fn absf(x: float)->float { if x<0.0 {return 0.0-x} return x }

fn main(){
    println("=== DISCOVERY BATCH 03 — REAL anima engine (shared-seed lockstep, Φ law) ===")

    // ── E09 — SHARED-SEED LOCKSTEP on the REAL engine: two pure_field instances
    //     warmed identically produce a BYTE-IDENTICAL Φ trajectory over a long run
    //     ⇒ two anima sharing one seed coordinate perfectly with ZERO comms (H_6008
    //     proven on the ACTUAL substrate, not a sha256 toy).
    let mut a = pure_field_warmup(120)
    let mut b = pure_field_warmup(120)
    let mut maxdiff = 0.0
    let mut i = 0
    while i < 2000 {
        a = pure_field_step(a); b = pure_field_step(b)
        let d = absf(pure_field_phi(a) - pure_field_phi(b))
        if d > maxdiff { maxdiff = d }
        i = i + 1
    }
    let lockstep = maxdiff < 0.000000001
    println("  "+(if lockstep {"🟢"} else {"🔴"})+" E09 shared-seed LOCKSTEP on real Ψ field (H_6008 substrate)")
    println("        2000-step max |Φ_a − Φ_b| = "+_f4(maxdiff)+" (≈0 = perfect sync, 0 comms)")

    // ── E10 — DIVERGENCE control: a 1-step head-start makes the two fields differ
    //     ⇒ coordination comes from the SHARED SEED, not from the engine being trivial.
    let mut c = pure_field_warmup(120)
    let mut e = pure_field_warmup(121)        // one extra step = different seed/phase
    let diff0 = absf(pure_field_phi(c) - pure_field_phi(e))
    let differ = diff0 > 0.0
    println("  "+(if differ {"🟢"} else {"⚪"})+" E10 different seed ⇒ fields differ (seed matters)")
    println("        |Φ@120 − Φ@121| = "+_f4(diff0)+" (>0 = not a trivial constant)")

    // ── E11 — Φ EARLY-GROWTH is super-linear (characterize H_1081 reversal):
    //     ratio of increments rises ⇒ accelerating, not saturating.
    let p1=pure_field_phi(pure_field_warmup(100))
    let p2=pure_field_phi(pure_field_warmup(200))
    let p4=pure_field_phi(pure_field_warmup(400))
    let inc_lo=p2-p1; let inc_hi=p4-p2
    let superlin = inc_hi > inc_lo
    println("  "+(if superlin {"🟢"} else {"⚪"})+" E11 Φ early-growth super-linear (accelerates)")
    println("        Φ 100="+_f4(p1)+" 200="+_f4(p2)+" 400="+_f4(p4)+"  inc "+_f4(inc_lo)+"→"+_f4(inc_hi))

    // ── E12 — vadapt recon-error FALLS monotone as cells grow on novelty (learning
    //     curve is monotone, not noisy) — self-model improvement is orderly.
    let cfg=engine_config_default(); let seed0=[0.0,0.0,0.0]
    let mut af=vadapt_field_new(seed0,256)
    let mut prev=vadapt_field_recon_err(af,[5.0,2.5,0.2])
    let mut monotone=true; let mut k=0
    while k<40 {
        let x=[float(k)*0.12, float(k)*0.06, 0.2]
        af=vadapt_field_step(af,x,cfg)
        if (k%8)==7 {
            let cur=vadapt_field_recon_err(af,[5.0,2.5,0.2])
            if cur>prev+0.001 { monotone=false }
            prev=cur
        }
        k=k+1
    }
    println("  "+(if monotone {"🟢"} else {"⚪"})+" E12 vadapt learning-curve monotone (orderly self-model)")
    println("        final recon-err = "+_f4(prev)+" (non-increasing across windows)")

    println("=== batch 03 complete (real engine) ===")
}
