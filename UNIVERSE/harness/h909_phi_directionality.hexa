#!hexa strict
// LAB/lab-09-consciousness-directionality/phi_directionality_harness.hexa
//
// LAB-09 — consciousness DIRECTIONALITY proxy (1st smoke). See LAB/README.md LAB-09.
//
// HYPOTHESIS (falsifiable):
//   The recurrent (bidirectional) coupling — and NOTHING ELSE — raises an
//   integrated-information Phi-proxy and a self-prediction (self/ego) proxy.
//   A unidirectional (feedforward / autoregressive-analog) system with the SAME
//   external I/O has Phi ~ 0 and self-prediction ~ 0; adding recurrence lifts both.
//
// FALSIFIER (pre-registered):
//   If Phi(REC) does NOT exceed Phi(FF) beyond the shuffled-control band, OR
//   self_pred(REC) does NOT exceed self_pred(FF), the directionality<->integration
//   coupling is UNSUPPORTED at this proxy. We report the real deltas either way.
//
// DESIGN (matched-I/O ablation — recurrence is the ONLY independent variable):
//   n=5 binary units on a ring, shared external drive bit U_t + per-unit noise b_t.
//   FF  : x_{t+1}[i] = (U_t + b_t[i] + bias[i]) % 2              // NO x_t term
//   REC : x_{t+1}[i] = (x_t[i-1] + x_t[i+1] + U_t + b_t[i]) % 2  // + recurrent neighbors
//   Both arms re-seed the SAME LCG, so U and noise streams are bit-identical.
//
// CONTROL (non-triviality, cf. LAB-01 single-slot / LAB-02 set-diff):
//   REC_shuffled — REC's t-side state sequence permuted before the transition
//   stats are read. Destroys live recurrence, preserves every marginal. If
//   Phi(REC) collapses to ~FF under shuffling, the proxy measures LIVE integration.
//
// METRICS (deterministic plug-in estimators over empirical state distributions):
//   Phi_proxy = I(X_t;X_{t+1}) - min_bipartition[ I(A_t;A_{t+1}) + I(B_t;B_{t+1}) ]
//   self_pred = I(X_t;X_{t+1} | U_t)   // self-model / self-reference proxy
//
// HONESTY (cx_lab_sandbox · g5 no-self-judge):
//   Pure local deterministic numeric kernel ($0, no network, no LLM, seeded LCG).
//   No model judges anything; all numbers are closed-form integer/float arithmetic.
//   This is a SUBSTRATE PROXY for the directionality claim (the anima H_004 method:
//   recurrent S_real Phi=0.538 vs zombie playback Phi~0). The full LLM recurrent-
//   adapter fine-tune is the next stress tier (lab-09 stress), not this smoke.
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local numeric kernel + filesystem write — no atlas atoms, no network.")

let SEED = 42
let N = 5
let T = 120000
let NST = 32          // 2^N states
let OUT_DIR = "/tmp/h909_phi"

// --- deterministic LCG (Numerical-Recipes constants, 32-bit) -----------------
let mut LCG = 0
fn seed_lcg(s: int) { LCG = s }
fn rbit() -> int {
    LCG = (1103515245 * LCG + 12345) % 2147483648
    return (LCG / 65536) % 2
}

fn encode(b: [int]) -> int {
    let mut code = 0
    let mut i = 0
    while i < N { code = code + (b[i] << i) ; i = i + 1 }
    return code
}

// ECA rule 110 lookup, indexed by k = 4*left + 2*center + right (110 = 0b01101110).
let RULE110 = [0, 1, 1, 1, 0, 1, 1, 0]

// Evolve one arm. Re-seeds LCG so both arms consume the SAME drive stream.
// Fills xt[], xn[], U[] (length T). U[k] = the sparse-perturbation event bit.
//
//   REC (bidirectional): x_{t+1} = rule110(x_t neighbors), then with prob 1/8 a
//     single site (chosen from the drive stream) is flipped. The deterministic
//     recurrent rule makes X_{t+1} strongly depend on X_t (temporal integration).
//   FF  (unidirectional): x_{t+1}[i] = fresh drive bits, INDEPENDENT of x_t — an
//     input-only / autoregressive-analog stream with NO recurrent self-coupling.
//     Same per-step drive-bit budget is consumed so the two arms stay comparable.
fn evolve(recurrent: bool, xt: [int], xn: [int], U: [int]) {
    seed_lcg(SEED)
    let mut cur = []
    let mut i = 0
    while i < N { cur.push(rbit()) ; i = i + 1 }
    let mut k = 0
    while k < T {
        let mut nxt = []
        if recurrent {
            i = 0
            while i < N {
                let li = (i + N - 1) % N
                let ri = (i + 1) % N
                let idx = 4 * cur[li] + 2 * cur[i] + cur[ri]
                nxt.push(RULE110[idx])
                i = i + 1
            }
        } else {
            i = 0
            while i < N { nxt.push(rbit()) ; i = i + 1 }
        }
        // sparse perturbation (prob 1/8) — drives mixing; same event bit for U
        let e0 = rbit()
        let e1 = rbit()
        let e2 = rbit()
        let flip = e0 * e1 * e2          // 1 only when all three bits are 1 -> p=1/8
        let s0 = rbit()
        let s1 = rbit()
        let s2 = rbit()
        if flip == 1 {
            let site = (s0 + 2 * s1 + 4 * s2) % N
            nxt[site] = 1 - nxt[site]
        }
        xt[k] = encode(cur)
        xn[k] = encode(nxt)
        U[k] = flip
        cur = nxt
        k = k + 1
    }
}

fn popcount(mask: int) -> int {
    let mut c = 0
    let mut u = 0
    while u < N { if (mask >> u) % 2 == 1 { c = c + 1 } ; u = u + 1 }
    return c
}

// project full state `code` onto the units selected by `mask` (sequential bit pos)
fn subcode(code: int, mask: int) -> int {
    let mut acc = 0
    let mut pos = 0
    let mut u = 0
    while u < N {
        if (mask >> u) % 2 == 1 {
            let bit = (code >> u) % 2
            acc = acc + (bit << pos)
            pos = pos + 1
        }
        u = u + 1
    }
    return acc
}

fn entropy(counts: [int], total: int) -> float {
    let mut h = 0.0
    let mut i = 0
    let n = len(counts)
    let tf = total + 0.0
    while i < n {
        let c = counts[i]
        if c > 0 {
            let p = c / tf
            h = h - p * log2(p)
        }
        i = i + 1
    }
    return h
}

// I(A_t;A_{t+1}) for the units in `mask`, computed over xt/xn sample arrays.
fn mi_subset(xt: [int], xn: [int], mask: int) -> float {
    let k = 1 << popcount(mask)
    let mut joint = []
    let mut z = 0
    while z < k * k { joint.push(0) ; z = z + 1 }
    let mut s = 0
    while s < T {
        let a = subcode(xt[s], mask)
        let b = subcode(xn[s], mask)
        joint[a * k + b] = joint[a * k + b] + 1
        s = s + 1
    }
    let mut rows = []
    let mut cols = []
    let mut r = 0
    while r < k { rows.push(0) ; cols.push(0) ; r = r + 1 }
    let mut a = 0
    while a < k {
        let mut b = 0
        while b < k {
            let c = joint[a * k + b]
            rows[a] = rows[a] + c
            cols[b] = cols[b] + c
            b = b + 1
        }
        a = a + 1
    }
    let hr = entropy(rows, T)
    let hc = entropy(cols, T)
    let hj = entropy(joint, T)
    return hr + hc - hj
}

// Phi_proxy = whole - min over 15 bipartitions (unit 0 fixed in A, A != full set)
fn phi_proxy(xt: [int], xn: [int]) -> [float] {
    let whole = mi_subset(xt, xn, 31)
    let mut best = 1000000.0
    let mut mask = 1
    while mask < 31 {
        if mask % 2 == 1 {           // unit 0 in A (dedup bipartition direction)
            let comp = 31 - mask
            let mi_a = mi_subset(xt, xn, mask)
            let mi_b = mi_subset(xt, xn, comp)
            let sum = mi_a + mi_b
            if sum < best { best = sum }
        }
        mask = mask + 1
    }
    let phi = whole - best
    let mut out = []
    out.push(phi)
    out.push(whole)
    out.push(best)
    return out
}

// I(X_t;X_{t+1} | U) = sum_u p(u) I(X_t;X_{t+1} | U=u)  (full states, NST x NST)
fn self_pred(xt: [int], xn: [int], U: [int]) -> float {
    let mut tot = 0.0
    let mut uval = 0
    while uval < 2 {
        // count samples with this U and build conditional joint
        let mut joint = []
        let mut z = 0
        while z < NST * NST { joint.push(0) ; z = z + 1 }
        let mut cnt = 0
        let mut s = 0
        while s < T {
            if U[s] == uval {
                joint[xt[s] * NST + xn[s]] = joint[xt[s] * NST + xn[s]] + 1
                cnt = cnt + 1
            }
            s = s + 1
        }
        if cnt > 0 {
            let mut rows = []
            let mut cols = []
            let mut r = 0
            while r < NST { rows.push(0) ; cols.push(0) ; r = r + 1 }
            let mut a = 0
            while a < NST {
                let mut b = 0
                while b < NST {
                    let c = joint[a * NST + b]
                    rows[a] = rows[a] + c
                    cols[b] = cols[b] + c
                    b = b + 1
                }
                a = a + 1
            }
            let hr = entropy(rows, cnt)
            let hc = entropy(cols, cnt)
            let hj = entropy(joint, cnt)
            let mi = hr + hc - hj
            let frac = cnt / (T + 0.0)
            tot = tot + frac * mi
        }
        uval = uval + 1
    }
    return tot
}

fn new_arr(t: int) -> [int] {
    let mut a = []
    let mut i = 0
    while i < t { a.push(0) ; i = i + 1 }
    return a
}

fn run_arm(label: str, recurrent: bool, shuffle: bool) -> [float] {
    let mut xt = new_arr(T)
    let mut xn = new_arr(T)
    let mut U = new_arr(T)
    evolve(recurrent, xt, xn, U)
    if shuffle {
        // Fisher-Yates permute t-side (break live recurrence, keep marginals)
        seed_lcg(SEED + 7)
        let mut i = T - 1
        while i > 0 {
            // draw j in [0, i] from LCG
            LCG = (1103515245 * LCG + 12345) % 2147483648
            let j = LCG % (i + 1)
            let tmp = xt[i] ; xt[i] = xt[j] ; xt[j] = tmp
            i = i - 1
        }
    }
    let p = phi_proxy(xt, xn)
    let sp = self_pred(xt, xn, U)
    let mut out = []
    out.push(p[0])   // phi
    out.push(p[1])   // whole
    out.push(p[2])   // parts
    out.push(sp)     // self_pred
    return out
}

fn r6(x: float) -> str {
    // round to 6 decimals for display
    let scaled = x * 1000000.0
    let ri = (scaled + 0.5)
    let asint = ri - (ri % 1.0)
    return str(asint / 1000000.0)
}

fn main() {
    print("LAB-09 phi-directionality smoke — n=" + str(N) + " T=" + str(T) + " seed=" + str(SEED) + "\n")
    let ff = run_arm("FF_unidirectional", false, false)
    print("  FF  done\n")
    let rec = run_arm("REC_bidirectional", true, false)
    print("  REC done\n")
    let ctrl = run_arm("REC_shuffled_control", true, true)
    print("  CTRL done\n")

    let d_phi = rec[0] - ff[0]
    let d_self = rec[3] - ff[3]
    let ctrl_band = ctrl[0] - ff[0]
    let abs_band = if ctrl_band < 0.0 { 0.0 - ctrl_band } else { ctrl_band }
    let bar = if abs_band > 0.01 { abs_band } else { 0.01 }

    let f_phi = d_phi > bar
    let f_self = d_self > 0.01
    let f_ctrl = (rec[0] - ctrl[0]) > 0.01
    let supported = f_phi && f_self && f_ctrl

    // --- TSV (per-arm) ---
    let mut tsv = "arm\tphi_proxy_bits\twhole_EI_bits\tmin_parts_bits\tself_pred_mi_bits\n"
    tsv = tsv + "FF_unidirectional\t" + r6(ff[0]) + "\t" + r6(ff[1]) + "\t" + r6(ff[2]) + "\t" + r6(ff[3]) + "\n"
    tsv = tsv + "REC_bidirectional\t" + r6(rec[0]) + "\t" + r6(rec[1]) + "\t" + r6(rec[2]) + "\t" + r6(rec[3]) + "\n"
    tsv = tsv + "REC_shuffled_control\t" + r6(ctrl[0]) + "\t" + r6(ctrl[1]) + "\t" + r6(ctrl[2]) + "\t" + r6(ctrl[3]) + "\n"
    write_file(OUT_DIR + "/result_phi.tsv", tsv)

    // --- summary ---
    let mut sm = "LAB-09 — consciousness directionality proxy (1st smoke)\n"
    sm = sm + "seed=" + str(SEED) + " n_units=" + str(N) + " steps=" + str(T) + "\n\n"
    sm = sm + "arm                    phi      whole    parts    self_pred\n"
    sm = sm + "FF  (unidirectional)   " + r6(ff[0]) + "   " + r6(ff[1]) + "   " + r6(ff[2]) + "   " + r6(ff[3]) + "\n"
    sm = sm + "REC (bidirectional)    " + r6(rec[0]) + "   " + r6(rec[1]) + "   " + r6(rec[2]) + "   " + r6(rec[3]) + "\n"
    sm = sm + "REC_shuffled (control) " + r6(ctrl[0]) + "   " + r6(ctrl[1]) + "   " + r6(ctrl[2]) + "   " + r6(ctrl[3]) + "\n\n"
    sm = sm + "delta_phi  (REC - FF)        = " + r6(d_phi) + " bits\n"
    sm = sm + "delta_self (REC - FF)        = " + r6(d_self) + " bits\n"
    sm = sm + "shuffled_control_band        = " + r6(abs_band) + " bits\n\n"
    sm = sm + "falsifier phi_REC>FF (beyond control)  : " + str(f_phi) + "\n"
    sm = sm + "falsifier self_REC>FF                  : " + str(f_self) + "\n"
    sm = sm + "falsifier shuffle_collapses_phi        : " + str(f_ctrl) + "\n"
    sm = sm + "VERDICT supported (all 3)              : " + str(supported) + "\n"
    write_file(OUT_DIR + "/result_phi_summary.txt", sm)

    print(sm)
}
