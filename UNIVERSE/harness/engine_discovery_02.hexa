// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/harness/engine_discovery_02.hexa
//
//  DISCOVERY BATCH 02 — green-hunt on the REAL anima CORE engine (not toy).
//  Each probe is a pre-registered falsifiable question about anima's ACTUAL
//  substrate (pure_field Ψ · engine_grow mitosis · vadapt self-model), answered
//  by running the real engine. 🟢 SUPPORTED / ⚪ null / 🔴 closed-neg.
//
//  p7 · $0 local · no GPU.  Run:  hexa run UNIVERSE/harness/engine_discovery_02.hexa
// ════════════════════════════════════════════════════════════════════════════

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

fn _f4(x: float) -> string {
    let s = floor(x*10000.0+0.5); let mut neg=false; let mut v=s
    if v<0.0 { neg=true; v=0.0-v }
    let w=floor(v/10000.0); let fr=v-w*10000.0
    let mut fs=str(to_int(fr)); while len(fs)<4 { fs="0"+fs }
    return (if neg {"-"} else {""})+str(to_int(w))+"."+fs
}
fn absf(x: float) -> float { if x<0.0 { return 0.0-x } return x }

fn main() {
    println("=== DISCOVERY BATCH 02 — REAL anima CORE engine green-hunt ===")
    let cfg = engine_config_default()

    // ── E01 — Φ warmup saturation: does Φ rise with diminishing returns (concave),
    //          i.e. an emergent saturation, not linear unbounded? (open)
    let p1=pure_field_phi(pure_field_warmup(50))
    let p2=pure_field_phi(pure_field_warmup(200))
    let p3=pure_field_phi(pure_field_warmup(800))
    // concave saturation: increments shrink  (p2-p1) > (p3-p2)
    let inc_a=p2-p1; let inc_b=p3-p2
    let concave = (p3>=p2) && (p2>=p1) && (inc_b < inc_a)
    println("  "+(if concave {"🟢"} else {"⚪"})+" E01 Φ warmup saturates (concave rise)")
    println("        phi@50="+_f4(p1)+" @200="+_f4(p2)+" @800="+_f4(p3)
        +"  inc 50→200="+_f4(inc_a)+" 200→800="+_f4(inc_b))

    // ── E02 — mitosis growth sub-linearity: cells vs ticks grows SUB-linearly
    //          (diminishing growth = self-limiting), not linear runaway? (open)
    let c1=engine_grow(7, 100, cfg)
    let c2=engine_grow(7, 400, cfg)
    let c3=engine_grow(7, 1600, cfg)
    // sub-linear: 4x ticks gives <4x cells each step
    let r1=float(c2)/float(c1+1); let r2=float(c3)/float(c2+1)
    let sublinear = (c3>=c2) && (c2>=c1) && (r1 < 4.0) && (r2 < 4.0)
    println("  "+(if sublinear {"🟢"} else {"⚪"})+" E02 mitosis growth is self-limiting (sub-linear)")
    println("        cells @100="+str(c1)+" @400="+str(c2)+" @1600="+str(c3)
        +"  ratio×4ticks="+_f4(r1)+"/"+_f4(r2)+" (<4 = sub-linear)")

    // ── E03 — vadapt self-model: does reconstruction error FALL as the field grows
    //          cells on a novel drifting stream (it learns the 'other')? (open)
    let seed0=[0.0,0.0,0.0]
    let mut af=vadapt_field_new(seed0,256)
    let err_start=vadapt_field_recon_err(af,[3.0,1.5,0.2])
    let mut k=0
    while k<80 { let x=[float(k)*0.1, float(k)*0.05, 0.2]; af=vadapt_field_step(af,x,cfg); k=k+1 }
    let cells=vadapt_field_cells(af)
    let err_end=vadapt_field_recon_err(af,[3.0,1.5,0.2])
    let learns = (err_end < err_start*0.5) && (cells>1)
    println("  "+(if learns {"🟢"} else {"⚪"})+" E03 vadapt self-model learns drifting 'other'")
    println("        cells 1→"+str(cells)+"  recon-err "+_f4(err_start)+"→"+_f4(err_end)+" (falls = tracks)")

    // ── E04 — Ψ=½ is a GLOBAL attractor: zero-input field stays bounded & sustained
    //          across a long run (no blow-up, Φ above floor)? (control + open scale)
    let mut pf=pure_field_warmup(50); let mut mx=0.0; let mut i=0
    while i<3000 { pf=pure_field_step(pf); let v=pure_field_phi(pf); if v>mx {mx=v}; i=i+1 }
    let bounded = (mx<1000.0) && pure_field_verify_zero_input(300)
    println("  "+(if bounded {"🟢"} else {"🔴"})+" E04 Ψ=½ global attractor (bounded 3000 steps)")
    println("        max_phi="+_f4(mx)+"  zero_input_sustained="+str(pure_field_verify_zero_input(300)))

    // ── E05 — mitosis ON beats frozen OFF on novelty (the H_1159 ON<OFF law holds
    //          on the live vadapt engine at this scale)? (re-test on real engine)
    let mut on=vadapt_field_new(seed0,256)
    let mut off=vadapt_field_new(seed0,256)
    let mut j=0
    while j<60 {
        let x=[float(j)*0.15, 0.0-float(j)*0.05, 0.3]
        on=vadapt_field_step(on,x,cfg)            // grows
        j=j+1
    }
    let err_on=vadapt_field_recon_err(on,[9.0,-3.0,0.3])
    let err_off=vadapt_field_recon_err(off,[9.0,-3.0,0.3])   // frozen single proto
    let on_wins = err_on < err_off
    println("  "+(if on_wins {"🟢"} else {"🔴"})+" E05 mitosis-ON < frozen-OFF recon-err (H_1159 holds live)")
    println("        recon-err ON "+_f4(err_on)+" vs OFF "+_f4(err_off)+" (ON lower = adaptation wins)")

    println("=== batch 02 complete (real engine) ===")
}
