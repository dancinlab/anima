#!hexa strict
// LAB/lab-10-akida-neuromorphic/edge_of_chaos_sim_harness.hexa
//
// LAB-10 — AKIDA neuromorphic edge-of-chaos Phi inverse-U, SIM MIRROR (1st smoke).
// See LAB/README.md LAB-10.
//
// HYPOTHESIS (falsifiable):
//   On a spiking-neuron ring driven across order->chaos regimes R1..R4, the
//   integrated-information Phi-proxy traces an INVERSE-U (edge-of-chaos peak):
//   R1 (weak-silent, die-out) and R4 (over-driven, saturate/sync) both ~0, the
//   edge regimes R2/R3 peak. This is the LOCAL SIM MIRROR of anima H_858's LIVE
//   AKD1000 result (F-AKIDA-EDGE 3/3: Phi R1=0, R2=0.172, R3=0.250 peak, R4~0).
//
// FALSIFIER (pre-registered, mirrors anima F-AKIDA-EDGE):
//   F1  Phi(R2) > Phi(R1)
//   F2  Phi(R3) > Phi(R1)
//   F3  max(Phi(R2),Phi(R3)) >= Phi(R4)
//   If any fails, the sim does NOT reproduce the edge-of-chaos inverse-U.
//
// SCOPE (honest): this is a SIM MIRROR, NOT the live silicon. The live AKD1000
//   run on pool host pi5-akida (spike_streamer 9513/9512 closed loop, anima
//   AKIDA/akida_edge_of_chaos_phi_hw.hexa) is the substrate-grounded tier and is
//   NOT performed here. This smoke only checks that the inverse-U is reproducible
//   in a leaky-integrate-and-fire (LIF) ring under the same R1..R4 drive sweep.
//
// SUBSTRATE MODEL: N LIF units on a ring. Per step, unit i integrates a regime
//   drive + recurrent input from its two spiking neighbors + regime noise; spikes
//   (binary) when membrane v crosses theta, then resets. The per-step spike vector
//   is the state; Phi-proxy is measured on the spike-state time series (same engine
//   as LAB-09 / LAB-11).
//
// HONESTY (cx_lab_sandbox · g5 no-self-judge):
//   Pure local deterministic numeric kernel ($0, no network, no LLM, seeded LCG).
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local numeric kernel + filesystem write — no atlas atoms, no network.")

let SEED = 42
let N = 5
let T = 40000
let THETA = 1.0
let LEAK = 0.5
let OUT_DIR = "/tmp/h910_edge"

let mut LCG = 0
fn seed_lcg(s: int) { LCG = s }
fn rbit() -> int {
    LCG = (1103515245 * LCG + 12345) % 2147483648
    return (LCG / 65536) % 2
}

fn encode(b: [int]) -> int {
    let mut code = 0
    let mut i = 0
    while i < N { code = code + (b[i] << i) ; i = i + 1 }
    return code
}

fn popcount(mask: int) -> int {
    let mut c = 0
    let mut u = 0
    while u < N { if (mask >> u) % 2 == 1 { c = c + 1 } ; u = u + 1 }
    return c
}

fn subcode(code: int, mask: int) -> int {
    let mut acc = 0
    let mut pos = 0
    let mut u = 0
    while u < N {
        if (mask >> u) % 2 == 1 {
            let bit = (code >> u) % 2
            acc = acc + (bit << pos)
            pos = pos + 1
        }
        u = u + 1
    }
    return acc
}

fn entropy(counts: [int], total: int) -> float {
    let mut h = 0.0
    let mut i = 0
    let n = len(counts)
    let tf = total + 0.0
    while i < n {
        let c = counts[i]
        if c > 0 {
            let p = c / tf
            h = h - p * log2(p)
        }
        i = i + 1
    }
    return h
}

fn mi_subset(xt: [int], xn: [int], mask: int) -> float {
    let k = 1 << popcount(mask)
    let mut joint = []
    let mut z = 0
    while z < k * k { joint.push(0) ; z = z + 1 }
    let mut s = 0
    while s < T {
        let a = subcode(xt[s], mask)
        let b = subcode(xn[s], mask)
        joint[a * k + b] = joint[a * k + b] + 1
        s = s + 1
    }
    let mut rows = []
    let mut cols = []
    let mut r = 0
    while r < k { rows.push(0) ; cols.push(0) ; r = r + 1 }
    let mut a = 0
    while a < k {
        let mut b = 0
        while b < k {
            let c = joint[a * k + b]
            rows[a] = rows[a] + c
            cols[b] = cols[b] + c
            b = b + 1
        }
        a = a + 1
    }
    return entropy(rows, T) + entropy(cols, T) - entropy(joint, T)
}

fn phi_proxy(xt: [int], xn: [int]) -> float {
    let whole = mi_subset(xt, xn, 31)
    let mut best = 1000000.0
    let mut mask = 1
    while mask < 31 {
        if mask % 2 == 1 {
            let sum = mi_subset(xt, xn, mask) + mi_subset(xt, xn, 31 - mask)
            if sum < best { best = sum }
        }
        mask = mask + 1
    }
    return whole - best
}

fn mean_rate(xt: [int]) -> float {
    let mut spikes = 0
    let mut s = 0
    while s < T {
        let mut i = 0
        while i < N { spikes = spikes + ((xt[s] >> i) % 2) ; i = i + 1 }
        s = s + 1
    }
    return (spikes + 0.0) / ((T * N) + 0.0)
}

// LIF ring sweep at one regime (drive, gain, noise_amp). Fills xt/xn spike states.
fn evolve_lif(drive: float, gain: float, noise_amp: float, xt: [int], xn: [int]) {
    seed_lcg(SEED)
    let mut v = []
    let mut sp = []
    let mut i = 0
    while i < N { v.push(0.0) ; sp.push(0) ; i = i + 1 }
    let mut k = 0
    while k < T {
        let mut nxt = []
        i = 0
        while i < N {
            let li = (i + N - 1) % N
            let ri = (i + 1) % N
            let rec = (sp[li] + sp[ri]) + 0.0
            let sgn = (2 * rbit() - 1) + 0.0
            let inp = drive + gain * rec + noise_amp * sgn
            v[i] = v[i] * LEAK + inp
            let mut s = 0
            if v[i] > THETA { s = 1 ; v[i] = 0.0 }
            nxt.push(s)
            i = i + 1
        }
        xt[k] = encode(sp)
        xn[k] = encode(nxt)
        sp = nxt
        k = k + 1
    }
}

fn new_arr(t: int) -> [int] {
    let mut a = []
    let mut i = 0
    while i < t { a.push(0) ; i = i + 1 }
    return a
}

fn r6(x: float) -> str {
    let scaled = x * 1000000.0
    let ri = scaled + 0.5
    let asint = ri - (ri % 1.0)
    return str(asint / 1000000.0)
}

fn main() {
    // R1 weak-silent · R2 noise-edge · R3 tonic-edge · R4 over-driven (order->chaos)
    let DRIVE = [0.20, 0.30, 0.35, 1.40]
    let GAIN  = [0.10, 0.15, 0.25, 1.30]
    let NOISE = [0.00, 0.30, 0.55, 0.00]
    let RLBL  = ["R1_weak_silent", "R2_noise_edge", "R3_tonic_edge", "R4_over_driven"]
    let M = 4

    print("LAB-10 AKIDA edge-of-chaos SIM MIRROR — N=" + str(N) + " LIF ring, T=" + str(T) + "\n")

    let mut phis = []
    let mut rates = []
    let mut tsv = "regime\tdrive\tgain\tnoise\tmean_rate\tphi_proxy_bits\n"
    let mut idx = 0
    while idx < M {
        let mut xt = new_arr(T)
        let mut xn = new_arr(T)
        evolve_lif(DRIVE[idx], GAIN[idx], NOISE[idx], xt, xn)
        let phi = phi_proxy(xt, xn)
        let rate = mean_rate(xt)
        phis.push(phi)
        rates.push(rate)
        tsv = tsv + RLBL[idx] + "\t" + r6(DRIVE[idx]) + "\t" + r6(GAIN[idx]) + "\t" + r6(NOISE[idx]) + "\t" + r6(rate) + "\t" + r6(phi) + "\n"
        print("  " + RLBL[idx] + "  rate=" + r6(rate) + "  phi=" + r6(phi) + "\n")
        idx = idx + 1
    }
    write_file(OUT_DIR + "/result_edge.tsv", tsv)

    let f1 = phis[1] > phis[0]
    let f2 = phis[2] > phis[0]
    let edge_max = if phis[1] > phis[2] { phis[1] } else { phis[2] }
    let f3 = edge_max >= phis[3]
    let supported = f1 && f2 && f3

    let mut sm = "LAB-10 — AKIDA edge-of-chaos Phi inverse-U · SIM MIRROR (1st smoke)\n"
    sm = sm + "seed=" + str(SEED) + " N=" + str(N) + " steps=" + str(T) + " (LIF ring; NOT live silicon)\n\n"
    sm = sm + "regime           drive  gain  noise  mean_rate  phi_proxy\n"
    let mut q = 0
    while q < M {
        sm = sm + RLBL[q] + "   " + r6(DRIVE[q]) + "  " + r6(GAIN[q]) + "  " + r6(NOISE[q]) + "   " + r6(rates[q]) + "    " + r6(phis[q]) + "\n"
        q = q + 1
    }
    sm = sm + "\nedge peak = " + r6(edge_max) + "  (R1=" + r6(phis[0]) + " R4=" + r6(phis[3]) + ")\n\n"
    sm = sm + "falsifier F1 phi(R2)>phi(R1)          : " + str(f1) + "\n"
    sm = sm + "falsifier F2 phi(R3)>phi(R1)          : " + str(f2) + "\n"
    sm = sm + "falsifier F3 max(R2,R3)>=phi(R4)      : " + str(f3) + "\n"
    sm = sm + "VERDICT supported (all 3 · F-AKIDA-EDGE mirror) : " + str(supported) + "\n"
    write_file(OUT_DIR + "/result_edge_summary.txt", sm)
    print(sm)
}
