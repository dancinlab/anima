// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/daegaseol/daegaseol_mathphys.hexa
//
//  MATH / PHYSICS verification — grounds each hypothesis's analytical/physical
//  CORE against its KNOWN closed-form / literature value, computed first-principles
//  in hexa (deterministic). g5-grade: the `hexa verify` dispatch wrapper is broken
//  in this install (verify_cli → calc_dispatch module not found), so we recompute
//  via `hexa run` (same compiler/runtime) and print the verdict verbatim.
//
//    A. Landauer limit      E_min = k_B·T·ln2          (H_1101 §사고의 열역학 비용)
//    B. SOC critical exp.   crit branching τ=3/2, ccdf −1/2  (H_2004 Ω-IV SOC)
//    C. Shannon / Kraft     H=Σp·(−log2 p), Σ2^(−l)=1  (H_1110 압축=MDL)
//    D. Boltzmann 2nd law   ΔS=k_B·ln2 ≥0; E=T·ΔS      (H_2005 엔트로피=시간화살)
//    E. Born rule           Σ|ψ_i|² = 1                (H_2003 측정=붕괴)
//    F. IIT4 Φ closed-form  n=2: Φ = MI[0][1]          (H_1102 통합정보)
//
//  p7 · $0 local · no GPU · no network.  Run:
//    hexa run UNIVERSE/daegaseol/daegaseol_mathphys.hexa
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn check(name: string, got: float, want: float, tol: float, unit: string) {
    let err = _absf(got - want)
    let ok = err <= tol
    let tag = if ok { "🟢 MATCH" } else { "🔴 MISMATCH" }
    println("  " + tag + "  " + name)
    println("        computed=" + to_string(got) + unit + "  analytical=" + to_string(want) + unit
        + "  |err|=" + to_string(err) + "  tol=" + to_string(tol))
}

fn main() {
    println("=== daegaseol MATH/PHYSICS verification — first-principles vs known analytical ===")
    let ln2 = ln(2.0)

    // ── A. Landauer limit (work in zeptojoule: k_B = 0.01380649 zJ/K) ────
    // E_min to erase 1 bit = k_B T ln2. Literature @300K ≈ 2.8709 zJ (=2.871e-21 J).
    let kB_zJ = 0.01380649          // k_B in zJ/K  (1.380649e-23 J/K)
    let T = 300.0
    let E_landauer = kB_zJ * T * ln2
    check("A. Landauer  E=k_B·T·ln2 @300K", E_landauer, 2.870950, 0.001, " zJ")

    // ── B. SOC mean-field critical exponent (H_2004) ─────────────────────
    // critical Galton-Watson avalanche P(s)∝s^(−3/2) ⇒ ccdf P(S≥s)∝s^(−1/2).
    // analytical ccdf log-log slope = −0.5; measured (omega_verify SOC) = −0.551.
    let slope_analytical = 0.0 - (3.0/2.0 - 1.0)   // −(τ−1) = −0.5
    let slope_measured = 0.0 - 0.551
    check("B. SOC ccdf slope (mean-field −1/2)", slope_measured, slope_analytical, 0.1, "")

    // ── C. Shannon entropy + Kraft equality (H_1110) ─────────────────────
    // uniform 4-symbol: H = log2(4) = 2 bits; Kraft Σ2^(−2)·4 = 1 (complete code).
    let H_uniform = 0.0 - (4.0 * (0.25 * log2(0.25)))   // Σ p·(−log2 p)
    check("C1. Shannon H(uniform-4)", H_uniform, 2.0, 0.000001, " bits")
    let kraft = 4.0 * pow(2.0, 0.0 - 2.0)
    check("C2. Kraft Σ2^(−l) (complete)", kraft, 1.0, 0.000001, "")
    // non-uniform p=(1/2,1/4,1/4): H = .5·1 + .25·2 + .25·2 = 1.5 bits
    let H_nu = 0.0 - (0.5*log2(0.5) + 0.25*log2(0.25) + 0.25*log2(0.25))
    check("C3. Shannon H(1/2,1/4,1/4)", H_nu, 1.5, 0.000001, " bits")

    // ── D. Boltzmann 2nd law + Landauer cross-check (H_2005) ──────────────
    // doubling accessible microstates W→2W: ΔS = k_B ln2 > 0 (irreversible).
    let dS_zJ_per_K = kB_zJ * ln2
    check("D1. Boltzmann ΔS=k_B·ln2 (W→2W)", dS_zJ_per_K, 0.009569, 0.000001, " zJ/K")
    // cross-check: Landauer energy E = T·ΔS (info erasure = entropy export)
    let E_from_S = T * dS_zJ_per_K
    check("D2. E=T·ΔS == Landauer (consistency)", E_from_S, E_landauer, 0.000001, " zJ")

    // ── E. Born rule normalization (H_2003) ──────────────────────────────
    // |ψ> = a|0>+b|1>, (a,b)=(0.6,0.8): Σ|ψ_i|² = 0.36+0.64 = 1.
    let a = 0.6
    let b = 0.8
    let born = a*a + b*b
    check("E. Born rule Σ|ψ|² (a=0.6,b=0.8)", born, 1.0, 0.000001, "")

    // ── F. IIT4 Φ closed-form, n=2 (H_1102) ──────────────────────────────
    // for n=2 the only bipartition is {0}|{1}; cut MI = MI[0][1], min side 1 ⇒
    // Φ = MI[0][1]. Set a known MI matrix and confirm the stdlib engine returns it.
    let mi = farr_zeros(4)         // 2×2 row-major
    let known = 0.420000
    let _ = farr_set(mi, 1, known) // MI[0][1]
    let _ = farr_set(mi, 2, known) // MI[1][0] (symmetric)
    let phi2 = iit4_faithful_phi_from_mi(mi, 2)
    let _ = farr_free(mi)
    check("F. IIT4 Φ closed-form (n=2 ⇒ MI[0][1])", phi2, known, 0.000001, "")

    println("=== math/physics verification complete (g5 first-principles, verbatim) ===")
}
