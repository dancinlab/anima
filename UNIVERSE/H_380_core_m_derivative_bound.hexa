// H_380 smoke — CORE M derivative bound

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return -x }
    return x
}

fn delta_step() -> f64 {
    return 0.1
}

fn sd_max() -> f64 {
    return 3.0  // |sd| ≤ |ΔE|+|ΔW|+|Δcur| each ≤ 1
}

fn k_bound() -> f64 {
    return delta_step() * sd_max()
}

fn check_h380() -> bool {
    let k = k_bound()
    // sample step: m_prev=0.5, sd=2.5
    let m_prev = 0.5
    let sd = 2.5
    let m_next = m_prev + delta_step() * sd  // 0.75
    let actual_d = abs_f(m_next - m_prev)
    return actual_d <= k
}

fn main() {
    let ok = check_h380()
    if !ok { print("H_380 FAIL"); return }
    print("H_380 blue derivative bounded OK")
}
