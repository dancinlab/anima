// H_398 smoke — sensitivity per stage

fn sensitivity(stage: string) -> f64 {
    if stage == "WAKE" { return 0.95 }
    if stage == "REM" { return 0.7 }
    if stage == "N1" { return 0.4 }
    if stage == "N2" { return 0.2 }
    if stage == "N3" { return 0.08 }
    return 0.0
}

fn check_h398() -> bool {
    let w = sensitivity("WAKE")
    let n3 = sensitivity("N3")
    let ge = w >= n3
    let all_pos = (n3 > 0.0) && (sensitivity("N2") > 0.0)
    return ge && all_pos
}

fn main() {
    let ok = check_h398()
    if !ok { print("H_398 FAIL"); return }
    print("H_398 blue sensitivity OK")
}
