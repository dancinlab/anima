fn tension_correct(l2: f64) -> f64 { if l2 < 0.5 { return 0.1 } if l2 > 2.0 { return -0.1 } return 0.0 }
fn check_h552() -> bool { return tension_correct(0.2) > 0.0 && tension_correct(2.5) < 0.0 && tension_correct(1.0) == 0.0 }
fn main() { if check_h552() { print("H_552 OK") } else { print("H_552 FAIL") } }
