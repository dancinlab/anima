// H_452 smoke — quad full emit-chain

fn record_count(cap: bool, decided: bool, bridge: bool) -> i64 {
    if cap && decided && bridge { return 1 }
    return 0
}

fn check_h452() -> bool {
    let all = record_count(true, true, true) == 1
    let no_cap = record_count(false, true, true) == 0
    let no_dec = record_count(true, false, true) == 0
    let no_br = record_count(true, true, false) == 0
    return all && no_cap && no_dec && no_br
}

fn main() {
    let ok = check_h452()
    if !ok { print("H_452 FAIL"); return }
    print("H_452 blue 4-cross OK")
}
