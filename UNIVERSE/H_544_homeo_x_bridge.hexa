fn abs_f(x: f64) -> f64 { if x < 0.0 { return -x } return x }
fn imbalance(cap: f64, intent: f64) -> f64 { return abs_f(cap - intent) }
fn check_h544() -> bool { return imbalance(0.5, 0.5) == 0.0 && imbalance(0.8, 0.2) > 0.0 }
fn main() { if check_h544() { print("H_544 OK") } else { print("H_544 FAIL") } }
