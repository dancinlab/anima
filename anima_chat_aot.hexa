    println("  anima tool <name> [args]         universal entry (meta)")
    println("  anima doctor                     diagnose binary + ckpt state")
    println("  anima version                    print version + build info")
    println("  anima smoke                      alias for `chat smoke`")
    println("  anima --help                     this message")
