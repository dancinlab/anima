}

fn _cmd_doctor() {
    println("[anima doctor]")
    let dp = default_ckpt()
    println("  default ckpt path : " + dp)
    let dp_exists = file_exists(dp)
    println("  default ckpt exists: " + to_string(dp_exists))
    let fp = find_default_ckpt()
    let fp_show = if len(fp) == 0 { "(none — ladder candidates not found)" } else { fp }
    println("  find_default_ckpt(): " + fp_show)
    println("  architecture       : 24L decoder d_model=1024 d_ff=2752 GQA(16,4,64)")
    println("  vocab              : 32000 (byte-level)")
    println("  positional         : RoPE θ=10000 / RMSNorm ε=1e-5")
    println("  gen modes          : greedy / sample (LCG) / M3 (stub) / M4_force_include")
    println("  KV cache cap_len   : 1024")
    if dp_exists {
        println("  status             : OK")
        return 0
    } else {
        println("  status             : ckpt not found (exit 3)")
        return 3
    }
}

fn _invoke_chat(argv, idx_start: int, argc: int) {
    // Parse flags from argv[idx_start..argc), invoke chat_generate.
    // Wilson convention: byte-identical entry — same `_invoke_chat` from any
    // shortcut (`ask`, `chat send`, `tool chat`) so output matches.
    let mut ckpt = ""
    let mut prompt = ""
    let mut max_new = 40
    let mut mode = "greedy"
    let mut temp = 0.7
    let mut seed = 0
    let mut want_result = false

    let mut i = idx_start
    while i < argc {
        let a = argv[i]
        if a == "--ckpt" && (i + 1) < argc {
            ckpt = argv[i + 1]
            i = i + 2
        } else if a == "--prompt" && (i + 1) < argc {
            prompt = argv[i + 1]
            i = i + 2
        } else if a == "--max-new" && (i + 1) < argc {
            max_new = to_int(argv[i + 1])
            i = i + 2
        } else if a == "--mode" && (i + 1) < argc {
            mode = argv[i + 1]
            i = i + 2
        } else if a == "--temp" && (i + 1) < argc {
            temp = to_float(argv[i + 1])
            i = i + 2
        } else if a == "--seed" && (i + 1) < argc {
            seed = to_int(argv[i + 1])
            i = i + 2
        } else if a == "--result" {
            want_result = true
            i = i + 1
        } else {
            i = i + 1
        }
    }

    if len(prompt) == 0 {
        eprintln("error: --prompt required")
        return 2
    }

    let ckpt_path = if len(ckpt) == 0 {
        let p = find_default_ckpt()
        if len(p) == 0 { default_ckpt() } else { p }
    } else {
        ckpt
    }

    if !file_exists(ckpt_path) {
        eprintln("error: ckpt not found: " + ckpt_path)
        return 3
    }

    let mut chat = chat_new(ckpt_path, "cpu", default_stop_strings())
    chat = chat_load_weights(chat)
    let w = chat["weights"]
    let nw = len(dict_keys(w))
    if nw == 0 {
        eprintln("error: chat_load_weights returned 0-key weights dict")
        return 1
    }

    chat = chat_init_kv_cache_default(chat, 8192)

    let empty_kw = []
    let empty_stops = []
    let response = chat_generate(chat, prompt, mode, max_new, temp, empty_kw, 1.0, 1.0, 0.5, seed, empty_stops, true)

    if want_result {
        // Minimal JSON ToolResult emit. Escape backslash, quote, newline only.
        let json_resp = response.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
        println("{\"content\":\"" + json_resp + "\",\"mode\":\"" + mode + "\",\"max_new\":" + to_string(max_new) + ",\"seed\":" + to_string(seed) + ",\"ckpt\":\"" + ckpt_path + "\"}")
    } else {
        println(response)
    }
    return 0
}

// ════════════════════════════════════════════════════════════════════════════
//  LIVE ENGINE — unified frame-loop substrate-native runtime
//  (CHAT.md rev 2 — REPL + group + socket all share this engine)
// ════════════════════════════════════════════════════════════════════════════
//
//  Architecture:
//    main thread     : frame loop @ FPS Hz — substrate evolve + drain
//                       stdin + drain socket + drain bcast + speak-gate
//                       + sleep to next frame
//    inference worker: receives speak_req from channel, runs chat_generate
//                       in background (frame-budget unbound), broadcasts
//                       response via bcast_ch
//    stdin reader    : reads input() lines in dedicated thread (blocking-
//                       safe since frame loop runs independently),
//                       pushes lines to stdin_ch
//
//  Substrate-native autonomy:
//    Every anima has its own cell_pool (mitosis_hook 1119 LoC LANDED).
//    Frame loop calls mitosis_hook_step (cheap µs lorenz+perturb) every tick.
//    cell_pool_tension(pool) > speak_threshold → spontaneous fire enqueue.
//    No external trigger (regex/probability) — PHILOSOPHY.md #3 compliant.
//
//  All 3 commands (chat repl / room / serve) build ctx dict + call this.
//  =========================================================================

fn _live_inference_worker(args) {
    let req_ch = args["req_ch"]
    let bcast_ch = args["bcast_ch"]
    let chat = args["chat"]
    while true {
        let req = thread_channel_recv(req_ch, -1)
        // close sentinel: empty string (channel closed/EOF) OR dict.type=="close"
        if to_string(req) == "" { return 0 }
        let typ = to_string(req["type"])
        if typ == "close" { return 0 }
        let speaker = to_string(req["speaker"])
        let context = to_string(req["context"])
        let mode = to_string(req["mode"])
        let max_new = req["max_new"]
        let temp = req["temp"]
        let seed = req["seed"]
        let empty_kw = []
        let empty_stops = []
        // KV cache reset per inference (clean state per turn).
        let chat_with_kv = chat_init_kv_cache_default(chat, 8192)
        let resp = chat_generate(chat_with_kv, context, mode, max_new, temp,
                                 empty_kw, 1.0, 1.0, 0.5, seed, empty_stops, true)
        let _ = thread_channel_send(bcast_ch, #{
            "type":        "message",
            "speaker":     speaker,
            "text":        resp,
            "spontaneous": req["spontaneous"],
            "ts":          now_ms()
        })
    }
    return 0
}

// _live_socket_accept_loop — Phase 2 (CHAT.md rev 2 socket server).
// Runs in dedicated thread. net_listen + net_set_nonblock + net_select
// non-blocking accept loop. Multi-client subscribers:
//   - new connection: send "hello" JSONL frame + add to clients[]
//   - client read    : push line to stdin_ch (same channel as REPL stdin
//                       reader, so frame loop processes both uniformly)
//   - bcast drain    : read socket_bcast_ch, emit JSONL line to all clients
//   - disconnect     : net_read returns 0 → close + remove from clients[]
fn _live_socket_accept_loop(args) {
    let stdin_ch = args["stdin_ch"]
    let socket_bcast_ch = args["socket_bcast_ch"]
    let shutdown_ch = args["shutdown_ch"]
    let port = args["port"]
    let listener = net_listen("0.0.0.0:" + to_string(port))
    if listener < 0 {
        eprintln("[anima live] socket listen failed: errno=" + to_string(-listener))
        return 0
    }
    let _ = net_set_nonblock(listener)
    println("[anima live] socket server :" + to_string(port) + " (nc localhost " + to_string(port) + ")")
    let mut clients = []
    while true {
        // Check shutdown signal (UX fix #2 — graceful close)
        let sd = thread_channel_recv(shutdown_ch, 0)
        if to_string(sd) != "" {
            // Close all clients + listener
            let mut sci = 0
            while sci < len(clients) { let _ = net_close(clients[sci]); sci = sci + 1 }
            let _ = net_close(listener)
            println("[anima live] socket server shutdown (" + to_string(len(clients)) + " clients closed)")
            return 0
        }
        // (a) accept + read poll
        let mut fds = [listener]
        let mut ci = 0
        while ci < len(clients) {
            fds.push(clients[ci])
            ci = ci + 1
        }
        let ready = net_select(fds, 50)
        let mut ri = 0
        while ri < len(ready) {
            let fd = ready[ri]
            if fd == listener {
                let conn = net_accept(listener)
                if conn >= 0 {
                    let _ = net_set_nonblock(conn)
                    clients.push(conn)
                    // back-pressure aware write (UX fix #3) — small frame OK
                    let _ = net_write(conn, "{\"type\":\"hello\",\"msg\":\"anima live\"}\n")
                }
            } else {
                let data = net_read(fd)
                if len(data) == 0 {
                    // (diagnostic muted) println("[anima socket] client fd=" + to_string(fd) + " disconnected")
                    let _ = net_close(fd)
                    let mut nc = []
                    let mut k = 0
                    while k < len(clients) {
                        if clients[k] != fd { nc.push(clients[k]) }
                        k = k + 1
                    }
                    clients = nc
                } else {
                    // (diagnostic muted) println("[anima socket] recv fd=" + to_string(fd) + " bytes=" + to_string(len(data)))
                    let line = data.trim()
                    if len(line) > 0 {
                        let _ = thread_channel_send(stdin_ch, line)
                    }
                }
            }
            ri = ri + 1
        }
        // (b) drain socket_bcast_ch — emit to all clients as JSONL.
        // UX fix #3: check net_write rc; drop client on -EPIPE/-EAGAIN.
        while true {
            let msg = thread_channel_recv(socket_bcast_ch, 0)
            if to_string(msg) == "" { break }
            let speaker = to_string(msg["speaker"])
            let text = to_string(msg["text"])
            let text_e = text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
            let spont_s = if msg["spontaneous"] { "true" } else { "false" }
            let line = "{\"type\":\"message\",\"speaker\":\"" + speaker + "\",\"text\":\"" + text_e + "\",\"spontaneous\":" + spont_s + "}\n"
            let mut bi = 0
            let mut surviving = []
            while bi < len(clients) {
                let fd = clients[bi]
                let rc = net_write(fd, line)
                // net_write returns bytes written or -errno. Drop on err.
                if rc < 0 {
                    let _ = net_close(fd)
                    // skip — don't add to surviving
                } else {
                    surviving.push(fd)
                }
                bi = bi + 1
            }
            clients = surviving
        }
    }
    return 0
}

// _live_mesh_peer_loop — Phase 4 mesh distributed (CHAT.md rev 2 multi-host).
// Connects to peer daemons as a client. Reads their JSONL broadcasts and
// forwards into local bcast_ch (which fanouts to local stdout + local socket
// subscribers). MVP: inbound-only — no origin tracking yet, so cross-connecting
// peers can produce loops (caller responsibility for MVP).
//
// args: peers_str (CSV "host:port,host:port"), bcast_ch (local message bus)
fn _live_mesh_peer_loop(args) {
    let peers_str = to_string(args["peers_str"])
    let bcast_ch = args["bcast_ch"]
    let peers = peers_str.split(",")
    let mut peer_fds = []
    let mut pi = 0
    while pi < len(peers) {
        let p = peers[pi].trim()
        if len(p) > 0 {
            let fd = net_connect(p)
            if fd >= 0 {
                let _ = net_set_nonblock(fd)
                peer_fds.push(fd)
                println("[anima mesh] peer connected: " + p + " (fd=" + to_string(fd) + ")")
            } else {
                eprintln("[anima mesh] peer connect failed: " + p + " (errno=" + to_string(-fd) + ")")
            }
        }
        pi = pi + 1
    }
    if len(peer_fds) == 0 {
        eprintln("[anima mesh] no peers connected — mesh loop exiting")
        return 0
    }
    // Per-fd accumulator (split JSONL by \n).
    let mut recv_buf = #{}
    let mut fi = 0
    while fi < len(peer_fds) {
        recv_buf[to_string(peer_fds[fi])] = ""
        fi = fi + 1
    }
    while true {
        let ready = net_select(peer_fds, 100)
        let mut ri = 0
        while ri < len(ready) {
            let fd = ready[ri]
            let data = net_read(fd)
            if len(data) == 0 {
                // peer disconnected — back off; reconnect retry = follow-up
                let _ = sleep_ms(500)
            } else {
                let fd_key = to_string(fd)
                let mut buf = to_string(recv_buf[fd_key]) + data
                while true {
                    let nl = _str_index_of_room(buf, "\n")
                    if nl < 0 { break }
                    let line = buf.substring(0, nl).trim()
                    buf = buf.substring(nl + 1, len(buf))
                    if len(line) > 0 {
                        // Forward as local message — speaker prefixed `mesh:`
                        // to make origin visible. JSON body raw-pass for MVP.
                        let _ = thread_channel_send(bcast_ch, #{
                            "type":        "message",
                            "speaker":     "mesh:peer",
                            "text":        line,
                            "spontaneous": false
                        })
                    }
                }
                recv_buf[fd_key] = buf
            }
            ri = ri + 1
        }
    }
    return 0
}

fn _live_stdin_reader(args) {
    let stdin_ch = args["stdin_ch"]
    let prompt = to_string(args["prompt"])
    let mut empty_streak = 0
    while true {
        let line = input(prompt)
        if len(line) == 0 {
            empty_streak = empty_streak + 1
            // 5 consecutive empty reads = EOF (stdin closed / piped /dev/null).
            // Stop reader thread; frame loop continues without stdin events.
            // /exit must come from socket clients in this state.
            if empty_streak >= 5 {
                // Signal frame loop that stdin is dead (so user knows).
                let _ = thread_channel_send(stdin_ch, "/__stdin_eof__")
                return 0
            }
            let _ = sleep_ms(50)
            continue
        }
        empty_streak = 0
        let _ = thread_channel_send(stdin_ch, line)
    }
    return 0
}

// Build context prompt for an anima from history.
fn _live_build_context(history: string, anima_id: string) -> string {
    return history + "[" + anima_id + "]: "
}

fn _run_live_session(ctx) {
    let humans = ctx["humans"]
    let animas = ctx["animas"]
    let fps = ctx["fps"]
    let frame_budget = 1000 / fps
    let speak_threshold = ctx["speak_threshold"]
    let max_spont = ctx["max_spontaneous_per_session"]

    println("[anima live] frame_rate=" + to_string(fps) + " FPS  speak_threshold=" + to_string(speak_threshold))
    println("[anima live] humans=" + to_string(len(humans)) + "  animas=" + to_string(len(animas)) + "  max_spont/anima=" + to_string(max_spont))
    println("[anima live] substrate: mitosis_hook (cell_pool tension/lorenz dynamics)")
    println("[anima live] slash: /exit /show /save <name> /help")
    println("")

    // Init cell_pools per anima (substrate-native autonomy infrastructure)
    let dims = chat_default_dims_24l()
    let d_model = dims["d_model"]
    let mut anima_pools = #{}
    let mut anima_in_flight = #{}
    let mut anima_speak_count = #{}
    let mut ai = 0
    while ai < len(animas) {
        let id = animas[ai]
        anima_pools[id] = cell_pool_init(d_model, 2)
        anima_in_flight[id] = false
        anima_speak_count[id] = 0
        ai = ai + 1
    }

    // Channels
    let req_ch = thread_channel_new()
    let bcast_ch = thread_channel_new()
    let stdin_ch = thread_channel_new()
    let mut socket_bcast_ch = -1
    let mut socket_shutdown_ch = -1
    if ctx["serve"] {
        socket_bcast_ch = thread_channel_new()
        socket_shutdown_ch = thread_channel_new()
    }

    // Inference worker thread
    let worker_args = #{
        "req_ch":   req_ch,
        "bcast_ch": bcast_ch,
        "chat":     ctx["chat"]
    }
    let _wid = thread_spawn(_live_inference_worker, worker_args)

    // Socket accept_loop thread (if serve mode)
    if ctx["serve"] {
        let accept_args = #{
            "port":            ctx["port"],
            "stdin_ch":        stdin_ch,
            "socket_bcast_ch": socket_bcast_ch,
            "shutdown_ch":     socket_shutdown_ch
        }
        let _ = thread_spawn(_live_socket_accept_loop, accept_args)
    }

    // Mesh peer connect thread (if mesh-peers configured) — Phase 4
    let mesh_peers = to_string(ctx["mesh_peers"])
    if len(mesh_peers) > 0 {
        let mesh_args = #{ "peers_str": mesh_peers, "bcast_ch": bcast_ch }
        let _ = thread_spawn(_live_mesh_peer_loop, mesh_args)
        println("[anima live] mesh peers: " + mesh_peers)
    }

    // stdin reader thread (if REPL)
    let mut _sid = -1
    let default_speaker = to_string(ctx["default_speaker"])
    let prompt_label = "[" + default_speaker + "]> "
    if ctx["repl"] {
        let stdin_args = #{ "stdin_ch": stdin_ch, "prompt": prompt_label }
        _sid = thread_spawn(_live_stdin_reader, stdin_args)
    }

    let mut history = ""
    let mut t = 0
    let mut turn = 0
    let mut current_speaker = default_speaker
    let mut shutdown = false

    while !shutdown {
        let t0 = now_ms()

        // (1) substrate evolve per anima (cheap; speak-gate signal source)
        let mut a1 = 0
        while a1 < len(animas) {
            let id = animas[a1]
            anima_pools[id] = mitosis_hook_step(anima_pools[id], t)
            a1 = a1 + 1
        }

        // (2) drain stdin events (REPL stdin + socket client lines)
        while true {
            let line = thread_channel_recv(stdin_ch, 0)
            if to_string(line) == "" { break }
            // (diagnostic muted) println("[anima frame] stdin_ch recv: " + line)
            let trimmed = line.trim()
            if len(trimmed) == 0 { continue }
            if trimmed == "/__stdin_eof__" {
                // stdin closed (e.g. </dev/null) — reader thread done.
                // Daemon continues with socket clients only if --serve;
                // otherwise shutdown.
                if !ctx["serve"] {
                    shutdown = true
                    break
                }
                println("[anima live] stdin EOF — socket clients only mode")
                continue
            }
            if trimmed == "/exit" || trimmed == "/quit" { shutdown = true; break }
            if trimmed == "/show" {
                println("--- history ---")
                print(history)
                println("--- end (" + to_string(turn) + " turns) ---")
                continue
            }
            if trimmed == "/help" {
                println("commands: /exit /quit /show /save <name> /help")
                continue
            }
            if trimmed.starts_with("/save ") {
                let name = trimmed.substring(6, len(trimmed)).trim()
                let home = env("HOME")
                let dir = home + "/.anima/sessions"
                let _ = exec("mkdir -p '" + dir + "'")
                let path = dir + "/" + name + ".jsonl"
                let _ = exec("printf '%s' " + _shquote_repl(history) + " > '" + path + "'")
                println("[saved " + to_string(turn) + " turns to " + path + "]")
                continue
            }
            if trimmed.starts_with("/") {
                println("unknown command: " + trimmed)
                continue
            }
            // detect optional `<name>: <text>` name-prefix
            let mut speaker = current_speaker
            let mut text = trimmed
            let colon_idx = _str_index_of_room(trimmed, ":")
            if colon_idx > 0 {
                let maybe_name = trimmed.substring(0, colon_idx).trim()
                if _name_in_list(maybe_name, humans) || _name_in_list(maybe_name, animas) {
                    speaker = maybe_name
                    text = trimmed.substring(colon_idx + 1, len(trimmed)).trim()
                }
            }
            // UX guard: if ANY anima is in-flight, queue user input is dropped
            // with hint (avoids context pollution from typing-while-thinking).
            // User can wait → next message fires inference cleanly.
            let mut any_in_flight = false
            let mut afi = 0
            while afi < len(animas) {
                if anima_in_flight[animas[afi]] { any_in_flight = true }
                afi = afi + 1
            }
            if any_in_flight {
                println("[anima 생각 중… 잠시 기다려주세요]")
                continue
            }
            // append to history
            history = history + "[" + speaker + "]: " + text + "\n"
            turn = turn + 1
            // human input → enqueue inference for each anima
            let mut a2 = 0
            while a2 < len(animas) {
                let id = animas[a2]
                anima_in_flight[id] = true
                let _ = thread_channel_send(req_ch, #{
                    "type":        "speak",
                    "speaker":     id,
                    "context":     _live_build_context(history, id),
                    "mode":        ctx["mode"],
                    "max_new":     ctx["max_new"],
                    "temp":        ctx["temp"],
                    "seed":        ctx["anima_seeds"][id] + turn,
                    "spontaneous": false
                })
                a2 = a2 + 1
            }
        }

        // (3) drain inference results — println to stdout AND fanout to socket
        while true {
            let resp = thread_channel_recv(bcast_ch, 0)
            if to_string(resp) == "" { break }
            let speaker = to_string(resp["speaker"])
            let text = to_string(resp["text"])
            let spont = if resp["spontaneous"] { " 🎙" } else { "" }
            println("[" + speaker + "]:" + spont + " " + text)
            history = history + "[" + speaker + "]: " + text + "\n"
            anima_in_flight[speaker] = false
            turn = turn + 1
            // Fanout to socket subscribers if serve mode
            if ctx["serve"] {
                let _ = thread_channel_send(socket_bcast_ch, resp)
            }
        }

        // (4) speak-gate — substrate-native spontaneous fire
        // Each anima evaluates its own cell_pool_tension. If > threshold AND
        // not already in_flight AND under per-session cap → enqueue.
        let mut a4 = 0
        while a4 < len(animas) {
            let id = animas[a4]
            if !anima_in_flight[id] {
                let pool = anima_pools[id]
                let tension = cell_pool_tension(pool)
                let cnt = anima_speak_count[id]
                if tension > speak_threshold && cnt < max_spont {
                    anima_in_flight[id] = true
                    anima_speak_count[id] = cnt + 1
                    let _ = thread_channel_send(req_ch, #{
                        "type":        "speak",
                        "speaker":     id,
                        "context":     _live_build_context(history, id),
                        "mode":        ctx["mode"],
                        "max_new":     ctx["max_new"],
                        "temp":        ctx["temp"],
                        "seed":        ctx["anima_seeds"][id] + turn + 100000,
                        "spontaneous": true
                    })
                }
            }
            a4 = a4 + 1
        }

        // (5) sleep to next frame boundary
        let dt = now_ms() - t0
        if dt < frame_budget { let _ = sleep_ms(frame_budget - dt) }
        t = t + 1
    }

    // Shutdown sequence:
    //   1. signal socket accept_loop to close (UX fix #2 graceful)
    //   2. signal inference worker via close-type msg
    //   3. close all channels
    if ctx["serve"] {
        let _ = thread_channel_send(socket_shutdown_ch, "stop")
        let _ = sleep_ms(100)  // brief grace for accept_loop to wake + close clients
        let _ = thread_channel_close(socket_shutdown_ch)
        let _ = thread_channel_close(socket_bcast_ch)
    }
    let _ = thread_channel_send(req_ch, #{ "type": "close" })
    let _ = thread_channel_close(req_ch)
    let _ = thread_channel_close(bcast_ch)
    let _ = thread_channel_close(stdin_ch)
    println("[live session closed — " + to_string(turn) + " turns]")
    return 0
}

// _cmd_chat_repl — CHAT.md rev 2: 1:1 REPL on top of unified live engine.
//   anima chat repl [--ckpt P] [--mode M] [--max-new N] [--temp F] [--seed N]
//                   [--fps N] [--speak-threshold F] [--max-spontaneous N]
//
// Builds 1-human + 1-anima ctx and dispatches to _run_live_session.
// Substrate-native autonomy (cell_pool tension/lorenz gate). No /turn.
fn _cmd_chat_repl(argv, idx: int, argc: int) {
    let mut ckpt = ""
    let mut mode = "greedy"
    let mut temp = 0.7
    let mut seed_base = 0
    let mut max_new = 8192
    let mut fps = 60
    let mut speak_threshold = 1.0
    let mut max_spont = 99999
    let mut serve = false
    let mut port = 7878
    let mut mesh_peers = ""

    let mut i = idx
    while i < argc {
        let a = argv[i]
        if a == "--ckpt" && (i + 1) < argc { ckpt = argv[i + 1]; i = i + 2 }
        else if a == "--mode" && (i + 1) < argc { mode = argv[i + 1]; i = i + 2 }
        else if a == "--temp" && (i + 1) < argc { temp = to_float(argv[i + 1]); i = i + 2 }
        else if a == "--seed" && (i + 1) < argc { seed_base = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--max-new" && (i + 1) < argc { max_new = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--fps" && (i + 1) < argc { fps = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--speak-threshold" && (i + 1) < argc { speak_threshold = to_float(argv[i + 1]); i = i + 2 }
        else if a == "--max-spontaneous" && (i + 1) < argc { max_spont = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--serve" { serve = true; i = i + 1 }
        else if a == "--port" && (i + 1) < argc { port = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--mesh-peers" && (i + 1) < argc { mesh_peers = argv[i + 1]; i = i + 2 }
        else { i = i + 1 }
    }

    let ckpt_path = if len(ckpt) == 0 {
        let p = find_default_ckpt()
        if len(p) == 0 { default_ckpt() } else { p }
    } else { ckpt }
    if !file_exists(ckpt_path) {
        eprintln("error: ckpt not found: " + ckpt_path)
        return 3
    }

    let mut chat = chat_new(ckpt_path, "cpu", default_stop_strings())
    chat = chat_load_weights(chat)
    if len(dict_keys(chat["weights"])) == 0 {
        eprintln("error: chat_load_weights returned 0-key weights dict")
        return 1
    }

    let mut anima_seeds = #{}
    anima_seeds["anima"] = seed_base

    let ctx = #{
        "humans":          ["me"],
        "animas":          ["anima"],
        "anima_seeds":     anima_seeds,
        "chat":            chat,
        "speak_threshold": speak_threshold,
        "max_spontaneous_per_session": max_spont,
        "fps":             fps,
        "mode":            mode,
        "max_new":         max_new,
        "temp":            temp,
        "default_speaker": "me",
        "repl":            true,
        "serve":           serve,
        "port":            port,
        "mesh_peers":      mesh_peers
    }
    println("anima chat repl — substrate-native 1:1 live session (CHAT.md rev 2)")
    println("ckpt: " + ckpt_path)
    return _run_live_session(ctx)
}

// Shell-quote helper for /save command — wrap string for printf %s arg.
fn _shquote_repl(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Roster lookup helper: returns true if `name` is in any of the comma-
// separated arrays. Used by _cmd_room name-prefix detection.
fn _name_in_list(name: string, names) -> bool {
    let mut i = 0
    while i < len(names) {
        if names[i] == name { return true }
        i = i + 1
    }
    return false
}

// _str_index_of_room — find first index of needle in haystack (byte-level).
// Returns -1 if not found. Hexa-native AOT-safe replacement for str_index_of
// builtin (which is not emitted by hexa_v2 transpiler in current toolchain).
fn _str_index_of_room(haystack: string, needle: string) -> int {
    let hl = len(haystack)
    let nl = len(needle)
    if nl == 0 { return 0 }
    if nl > hl { return -1 }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(haystack, i + j) != char_code(needle, j) {
                ok = false
                j = nl
            } else {
                j = j + 1
            }
        }
        if ok { return i }
        i = i + 1
    }
    return -1
}

// _cmd_room — Phase 1 group chat (CHAT.md Phase 1 spec):
//   anima room --humans "alice,bob,charlie" --animas "ana,ben" [flags]
// Single-process REPL where multiple human names + multiple anima IDs
// share one room. Each anima has its own seed offset (seed_base + idx * 1000)
// so identical prompt → different responses per anima identity.
//
// Input syntax:
//   <text>                  message as current default speaker
//   <name>: <text>          message as <name> (if <name> is in roster)
//   /turn <anima_id>        anima generates reply from full history
//   /turn <a>,<b>           multiple animas sequentially
//   /as <name>              switch default speaker (human or anima)
//   /show                   print full history
//   /save <name>            ~/.anima/rooms/<name>.jsonl
//   /exit | /quit           end
//   /help                   command list
// _cmd_room — CHAT.md rev 2: group chat on top of unified live engine.
// Substrate-native autonomy. /turn deprecated (no heuristic trigger).
// Each anima 의 cell_pool tension gate 가 자율 발화 결정.
fn _cmd_room(argv, idx: int, argc: int) {
    let mut humans_str = ""
    let mut animas_str = ""
    let mut ckpt = ""
    let mut mode = "greedy"
    let mut max_new = 8192
    let mut temp = 0.7
    let mut seed_base = 0
    let mut fps = 60
    let mut speak_threshold = 1.0
    let mut max_spont = 99999
    let mut serve = false
    let mut port = 7878
    let mut mesh_peers = ""

    let mut i = idx
    while i < argc {
        let a = argv[i]
        if a == "--humans" && (i + 1) < argc { humans_str = argv[i + 1]; i = i + 2 }
        else if a == "--animas" && (i + 1) < argc { animas_str = argv[i + 1]; i = i + 2 }
        else if a == "--ckpt" && (i + 1) < argc { ckpt = argv[i + 1]; i = i + 2 }
        else if a == "--mode" && (i + 1) < argc { mode = argv[i + 1]; i = i + 2 }
        else if a == "--max-new" && (i + 1) < argc { max_new = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--temp" && (i + 1) < argc { temp = to_float(argv[i + 1]); i = i + 2 }
        else if a == "--seed" && (i + 1) < argc { seed_base = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--fps" && (i + 1) < argc { fps = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--speak-threshold" && (i + 1) < argc { speak_threshold = to_float(argv[i + 1]); i = i + 2 }
        else if a == "--max-spontaneous" && (i + 1) < argc { max_spont = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--serve" { serve = true; i = i + 1 }
        else if a == "--port" && (i + 1) < argc { port = to_int(argv[i + 1]); i = i + 2 }
        else if a == "--mesh-peers" && (i + 1) < argc { mesh_peers = argv[i + 1]; i = i + 2 }
        else { i = i + 1 }
    }

    if len(humans_str) == 0 || len(animas_str) == 0 {
        eprintln("usage: anima room --humans \"a,b,c\" --animas \"x,y\" [flags]")
        eprintln("                  [--ckpt P] [--mode M] [--max-new N] [--temp F] [--seed N]")
        eprintln("                  [--fps N] [--speak-threshold F] [--max-spontaneous N]")
        return 2
    }

    let humans_raw = humans_str.split(",")
    let animas_raw = animas_str.split(",")
    let mut humans = []
    let mut animas = []
    let mut hi = 0
    while hi < len(humans_raw) {
        let n = humans_raw[hi].trim()
        if len(n) > 0 { humans.push(n) }
        hi = hi + 1
    }
    let mut a2 = 0
    while a2 < len(animas_raw) {
        let n = animas_raw[a2].trim()
        if len(n) > 0 { animas.push(n) }
        a2 = a2 + 1
    }
    if len(humans) == 0 || len(animas) == 0 {
        eprintln("error: humans or animas list empty after parse")
        return 2
    }

    let ckpt_path = if len(ckpt) == 0 {
        let p = find_default_ckpt()
        if len(p) == 0 { default_ckpt() } else { p }
    } else { ckpt }
    if !file_exists(ckpt_path) {
        eprintln("error: ckpt not found: " + ckpt_path)
        return 3
    }

    let mut chat = chat_new(ckpt_path, "cpu", default_stop_strings())
    chat = chat_load_weights(chat)
    if len(dict_keys(chat["weights"])) == 0 {
        eprintln("error: chat_load_weights returned 0-key weights dict")
        return 1
    }

    // anima → seed offset (substrate-native variance, NOT routing heuristic)
    let mut anima_seeds = #{}
    let mut si = 0
    while si < len(animas) {
        anima_seeds[animas[si]] = seed_base + si * 1000
        si = si + 1
    }

    println("anima room — substrate-native group chat (CHAT.md rev 2)")
    println("humans: " + humans_str)
    println("animas: " + animas_str + "  (autonomous via cell_pool gate)")
    println("ckpt  : " + ckpt_path)
    return _run_live_session(#{
        "humans":          humans,
        "animas":          animas,
        "anima_seeds":     anima_seeds,
        "chat":            chat,
        "speak_threshold": speak_threshold,
        "max_spontaneous_per_session": max_spont,
        "fps":             fps,
        "mode":            mode,
        "max_new":         max_new,
        "temp":            temp,
        "default_speaker": humans[0],
        "repl":            true,
        "serve":           serve,
        "port":            port,
        "mesh_peers":      mesh_peers
    })
}

fn _cmd_chat(argv, idx: int, argc: int) {
    if idx >= argc {
        eprintln("usage: anima chat <send|repl|smoke>")
        return 2
    }
    let sub = argv[idx]
    if sub == "send" {
        return _invoke_chat(argv, idx + 1, argc)
    } else if sub == "repl" {
        return _cmd_chat_repl(argv, idx + 1, argc)
    } else if sub == "smoke" {
        _smoke()
        return 0
    } else {
        eprintln("anima chat: unknown subcommand: " + sub + " (known: send / repl / smoke)")
        return 2
    }
}

fn _cmd_ask(argv, idx: int, argc: int) {
    // First positional after `ask` = prompt. Remaining args are flag-style
    // and forwarded to _invoke_chat verbatim with `--prompt <text>` injected.
    if idx >= argc {
        eprintln("usage: anima ask \"<prompt>\" [flags]")
        return 2
    }
    let prompt = argv[idx]
    let mut new_argv = []
    new_argv.push("--prompt")
    new_argv.push(prompt)
    let mut k = idx + 1
    while k < argc {
        new_argv.push(argv[k])
        k = k + 1
    }
    return _invoke_chat(new_argv, 0, len(new_argv))
}

fn _cmd_ckpt(argv, idx: int, argc: int) {
    if idx >= argc {
        eprintln("usage: anima ckpt <path|info>")
        return 2
    }
    let sub = argv[idx]
    if sub == "path" {
        let p = find_default_ckpt()
        let real = if len(p) == 0 { default_ckpt() } else { p }
        println(real)
        return 0
    } else if sub == "info" {
        let p = find_default_ckpt()
        let real = if len(p) == 0 { default_ckpt() } else { p }
        println("path  : " + real)
        let ex = file_exists(real)
        println("exists: " + to_string(ex))
        if !ex { return 3 }
        // sha256 + size via shell (mac+linux portable)
        let hcmd = "(sha256sum '" + real + "' 2>/dev/null || shasum -a 256 '" + real + "' 2>/dev/null) | awk '{print $1}'"
        let h = to_string(exec(hcmd)).trim()
        println("sha256: " + h)
        let szcmd = "stat -f%z '" + real + "' 2>/dev/null || stat -c%s '" + real + "' 2>/dev/null"
        let sz = to_string(exec(szcmd)).trim()
        println("size  : " + sz + " bytes")
        return 0
    } else {
        eprintln("anima ckpt: unknown subcommand: " + sub + " (known: path / info)")
        return 2
    }
}

fn _cmd_tool(argv, idx: int, argc: int) {
    if idx >= argc {
        eprintln("usage: anima tool <list|<name> [args]>")
        return 2
    }
    let sub = argv[idx]
    if sub == "list" || sub == "--list" {
        println("chat    chat library (chat_generate over loaded ckpt)")
        println("smoke   F-AC-HEXA-1..6 helper smoke battery")
        return 0
    } else if sub == "chat" {
        return _invoke_chat(argv, idx + 1, argc)
    } else if sub == "smoke" {
        _smoke()
        return 0
    } else {
        eprintln("anima tool: unknown tool: " + sub + " (known: chat / smoke)")
        return 2
    }
}

fn main() {
    let argv = args()
    let argc = len(argv)

    // wilson convention: argv[0..1] are [binary, binary] duped per hexa
    // hexa_set_args convention. First user-supplied arg is argv[2].
    if argc < 3 {
        _print_help()
        return
    }
    let sub = argv[2]

    if sub == "--help" || sub == "-h" || sub == "help" {
        _print_help()
        return
    }

    let mut rc = 0
    if sub == "version" || sub == "--version" || sub == "-v" {
        rc = _cmd_version()
    } else if sub == "doctor" {
        rc = _cmd_doctor()
    } else if sub == "chat" {
        rc = _cmd_chat(argv, 3, argc)
    } else if sub == "room" {
        rc = _cmd_room(argv, 3, argc)
    } else if sub == "ask" {
        rc = _cmd_ask(argv, 3, argc)
    } else if sub == "ckpt" {
        rc = _cmd_ckpt(argv, 3, argc)
    } else if sub == "tool" {
        rc = _cmd_tool(argv, 3, argc)
    } else if sub == "smoke" {
        _smoke()
        rc = 0
    } else if sub == "--prompt" {
        // deprecated bare flag — dispatch as ergonomic shortcut, emit warn
        eprintln("warn: bare `--prompt` is deprecated; use `anima ask \"<text>\"` or `anima chat send --prompt \"<text>\"`")
        rc = _invoke_chat(argv, 2, argc)
    } else if sub == "--smoke" {
        eprintln("warn: bare `--smoke` is deprecated; use `anima smoke` or `anima chat smoke`")
        _smoke()
        rc = 0
    } else {
        eprintln("anima: unknown subcommand: " + sub)
        eprintln("Run `anima --help` for usage.")
        rc = 2
    }
    exit(rc)
}
