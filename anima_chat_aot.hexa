    println("  anima room --humans \"a,b,c\" --animas \"x,y\" [flags]")
    println("                                   group chat (CHAT.md Phase 1)")
    println("  anima ask \"<prompt>\" [flags]     ergonomic shortcut for `chat send --prompt`")
    println("  anima ckpt path                  print default ckpt path")
    println("  anima ckpt info                  print ckpt sha256 + size + lineage")
