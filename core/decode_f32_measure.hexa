// decode_f32_measure.hexa — S1 FP32-e2e decode (#21 gold) CORRECTNESS + THROUGHPUT.
//
// (1) CORRECTNESS: for N in {2,4}, drive N fragments (fixed distinct in-window
//     sequences, uniform Lrows) TWO ways in lockstep on the SAME ranged W:
//       (F32)  _bg_kv_step_dev_batch_f32 — FP32-e2e activations + own mma.sync GEMM
//              + f64-roundtrip attention island.
//       (F64)  _bg_kv_step_dev_batch     — the canonical FP64 batched path.
//     per-fragment argmax(F32 row n) MUST == argmax(F64 row n) for every step
//     (argmax-faithful; NOT byte-eq — a logits max|Δ| readout shows the f32 drift).
//
// (2) THROUGHPUT: for N in {1,4,8,16,32}, prime nseed then time gen f32 batched
//     steps (argmax-fed). Report ms/step, per-fragment ms/tok, speedup vs the
//     in-harness FP64 single-stream baseline. The per-frag ms/tok is the number
//     to divide torch(+cuBLAS/TF32) ms/tok against for the gold verdict.
//
// Weights are cast to f32 ONCE (_bg_weights_to_f32, hoisted). Opt-in — this harness
// exercises the HEXA_DECODE_FP32 path directly; the FP64 default is untouched.

import "core/decode.hexa"

fn _f32m_argmax_off(a: int, off: int, n: int) -> int {
    let mut bi = 0
    let mut bv = farr_get(a, off)
    let mut k = 1
    while k < n {
        let v = farr_get(a, off + k)
        if v > bv { bv = v; bi = k }
        k = k + 1
    }
    return bi
}

fn _f32m_maxdiff_off(a: int, aoff: int, b: int, boff: int, n: int) -> float {
    let mut md = 0.0
    let mut k = 0
    while k < n {
        let dv = farr_get(a, aoff + k) - farr_get(b, boff + k)
        let av = if dv < 0.0 { 0.0 - dv } else { dv }
        if av > md { md = av }
        k = k + 1
    }
    return md
}

fn _f32m_tok_at(n: int, p: int) -> int {
    return 33 + ((n * 11 + p * 3) % 90)
}

fn _f32m_median3(a: float, b: float, c: float) -> float {
    if (a <= b && b <= c) || (c <= b && b <= a) { return b }
    if (b <= a && a <= c) || (c <= a && a <= b) { return a }
    return c
}

// f32-batch argmax vs FP64-batch argmax, lockstep on the same W.
fn _f32m_correctness(W: Map, N: int, steps: int) {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])

    let kvf = _bg_kv_new_batch_f32(nlay, block, d, N)
    let kvd = _bg_kv_new_batch(nlay, block, d, N)

    let mut agree = 0
    let mut total = 0
    let mut worstmd = 0.0
    let mut firstdiff = -1

    let mut pos = 0
    while pos < steps {
        let ids = []
        let mut nn = 0
        while nn < N { ids.push(_f32m_tok_at(nn, pos)); nn = nn + 1 }
        let lf = _bg_kv_step_dev_batch_f32(W, kvf, ids, N, pos)
        let ld = _bg_kv_step_dev_batch(W, kvd, ids, N, pos)
        let mut m = 0
        while m < N {
            let af = _f32m_argmax_off(lf, m * vocab, vocab)
            let ad = _f32m_argmax_off(ld, m * vocab, vocab)
            let md = _f32m_maxdiff_off(lf, m * vocab, ld, m * vocab, vocab)
            if md > worstmd { worstmd = md }
            if af == ad { agree = agree + 1 } else { if firstdiff < 0 { firstdiff = pos * 100 + m } }
            total = total + 1
            m = m + 1
        }
        let _ = farr_free(lf); let _ = farr_free(ld)
        pos = pos + 1
    }
    _bg_kv_free(kvf)
    _bg_kv_free(kvd)

    let verdict = if agree == total { "PASS" } else { "FAIL@" + to_string(firstdiff) }
    println("[f32-correctness N=" + to_string(N) + "] f32-vs-FP64 per-frag argmax = "
        + to_string(agree) + "/" + to_string(total) + "   worst max|Δ| = " + to_string(worstmd)
        + "   => " + verdict)
}

// one timed f32 batched gen-run, returns wall ms for gen steps
fn _f32m_bt_run(W: Map, N: int, nseed: int, gen: int) -> float {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])
    let kvb = _bg_kv_new_batch_f32(nlay, block, d, N)
    let mut lb = -1
    let mut pos = 0
    while pos < nseed {
        let ids = []
        let mut nn = 0
        while nn < N { ids.push(_f32m_tok_at(nn, pos)); nn = nn + 1 }
        if lb >= 0 { let _ = farr_free(lb) }
        lb = _bg_kv_step_dev_batch_f32(W, kvb, ids, N, pos)
        pos = pos + 1
    }
    let t0 = now_ms()
    let mut g = 0
    while g < gen {
        let p = nseed + g
        let ids = []
        let mut nn = 0
        while nn < N { ids.push(_f32m_argmax_off(lb, nn * vocab, vocab)); nn = nn + 1 }
        let _ = farr_free(lb)
        lb = _bg_kv_step_dev_batch_f32(W, kvb, ids, N, p)
        g = g + 1
    }
    let t1 = now_ms()
    if lb >= 0 { let _ = farr_free(lb) }
    _bg_kv_free(kvb)
    return to_float(t1 - t0)
}

// FP64 single-stream baseline (P2 _bg_kv_step_dev), same warm loop
fn _f32m_st_run(W: Map, nseed: int, gen: int) -> float {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])
    let kv = _bg_kv_new(nlay, block, d)
    let mut lg = -1
    let mut pos = 0
    while pos < nseed {
        if lg >= 0 { let _ = farr_free(lg) }
        lg = _bg_kv_step_dev(W, kv, _f32m_tok_at(0, pos), pos)
        pos = pos + 1
    }
    let t0 = now_ms()
    let mut g = 0
    while g < gen {
        let p = nseed + g
        let nb = bg_argmax(lg, vocab)
        let _ = farr_free(lg)
        lg = _bg_kv_step_dev(W, kv, nb, p)
        g = g + 1
    }
    let t1 = now_ms()
    if lg >= 0 { let _ = farr_free(lg) }
    _bg_kv_free(kv)
    return to_float(t1 - t0)
}

fn _f32m_baseline_single(W: Map, nseed: int, gen: int) -> float {
    let s0 = _f32m_st_run(W, nseed, gen)
    let s1 = _f32m_st_run(W, nseed, gen)
    let s2 = _f32m_st_run(W, nseed, gen)
    let med = _f32m_median3(s0, s1, s2) / to_float(gen)
    println("[f32 baseline FP64 single-stream] samples(ms/step)="
        + to_string(s0 / to_float(gen)) + "," + to_string(s1 / to_float(gen)) + ","
        + to_string(s2 / to_float(gen)) + "  median ms/tok=" + to_string(med))
    return med
}

fn _f32m_throughput(W: Map, N: int, nseed: int, gen: int, base_ms_tok: float) {
    let r0 = _f32m_bt_run(W, N, nseed, gen)
    let r1 = _f32m_bt_run(W, N, nseed, gen)
    let r2 = _f32m_bt_run(W, N, nseed, gen)
    let ms_step = _f32m_median3(r0, r1, r2) / to_float(gen)
    let ms_tok = ms_step / to_float(N)
    let sp_base = base_ms_tok / ms_tok
    println("[f32-throughput N=" + to_string(N) + "] median ms/step=" + to_string(ms_step)
        + "  per-frag ms/tok=" + to_string(ms_tok)
        + "  speedup-vs-FP64single(" + to_string(base_ms_tok) + ")=" + to_string(sp_base) + "x")
}

fn main() {
    let mut bin = "/home/summer/anima-weights/bytegpt303_h1129/h1129.bin"
    let av = args()
    let mut ai = 0
    while ai < len(av) {
        let a = to_string(av[ai])
        let al = byte_len(a)
        if al > 4 && substring(a, al - 4, al) == ".bin" { bin = a }
        ai = ai + 1
    }
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if !have { println("[f32-measure] SKIP — no fixture at " + bin); return }

    let cu = cuda_available()
    println("[f32-measure] cuda_available = " + to_string(cu))
    if cu != 1 { println("[f32-measure] ABORT — CPU fallback, not a device measurement (phantom guard)"); return }

    let W = bg_load_ranged(bin)
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let nh = to_int(W["nh"]); let block = to_int(W["block"])
    println("[f32-measure] loaded vocab=" + to_string(vocab) + " d=" + to_string(d)
        + " nlay=" + to_string(nlay) + " nh=" + to_string(nh) + " block=" + to_string(block))

    // hoisted weight f32-cache (wall #3: cast ONCE, not per-step)
    _bg_weights_to_f32(W, nlay, d, vocab)
    println("[f32-measure] weights cast to f32 mirror (hoisted, once)")

    println("")
    println("=== (1) CORRECTNESS — f32-e2e vs FP64 batched (argmax-faithful) ===")
    _f32m_correctness(W, 2, 12)
    _f32m_correctness(W, 4, 12)

    println("")
    println("=== (2) THROUGHPUT — median of 3, FP64 single-stream baseline ===")
    let base = _f32m_baseline_single(W, 8, 24)
    _f32m_throughput(W, 1, 8, 24, base)
    _f32m_throughput(W, 4, 8, 24, base)
    _f32m_throughput(W, 8, 8, 24, base)
    _f32m_throughput(W, 16, 8, 24, base)
    _f32m_throughput(W, 32, 8, 24, base)

    println("")
    println("decode_f32_measure: DONE")
}
