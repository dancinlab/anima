// bytegpt_kvcache_batch_smoke.hexa — BYTE-EXACT gate for the BATCH decode KV fast-path.
//
// Sibling of bytegpt_kvcache_smoke.hexa (single decode). That smoke proves ONE
// generation is byte-identical REF-vs-KV; THIS smoke proves the LOAD-ONCE BATCH
// path — the one the frozen H_1431 5-bar and the resident-W driver actually use —
// stays byte-identical across a MULTI-JOB sweep, and that the real batch entry
// `bytegpt_decode_batch_to_file` (file-in / append-out, resident weights) matches
// the full-forward reference on its escaped output surface.
//
// For the SAME loaded weights W and, per job, the SAME (seed, gen, top_k, temp,
// seed_rng) each fragment is generated two ways and asserted byte-identical:
//   (REF)   re-run the full T-token forward `bg_forward_last_W` every step — the
//           O(gen^2) reference, i.e. the verbatim ELSE branch of _bg_gen_from_W.
//   (KV)    forward ONLY the new token's row each step via the production router
//           `_bg_kv_step_r` over a per-layer K,V cache — i.e. the IF branch of
//           _bg_gen_from_W that fires when the window never slides (nseed+gen <= block).
// Then, as a whole-pipeline check, the real `bytegpt_decode_batch_to_file` is run
// over the SAME jobs and its (escaped) fragments are compared to the escaped
// full-forward reference. PASS = per-job identical ids AND text (sample AND
// greedy) AND the batch-entry output matches the reference for every tag.
//
// Host expectation: `_bg_kv_step_r` == host `_bg_kv_step` byte-for-byte, so
// seed-pos logits max|D| = 0.0 and EVERY id matches (sample + greedy).
// CUDA host (cuda_available()==1): the router dispatches `_bg_kv_step_dev`, a
// ~1e-6 own-GEMM mirror -> ARGMAX-EQ (greedy identical, 0 argmax divergence on
// 303M h1129); the topk-SAMPLE stream MAY flip a token from a 1e-6 logit delta,
// so on a CUDA host the greedy(argmax) leg is the gate and a sample-leg flip is
// reported as EXPECTED, not FAIL.
//
// p7: verification is exact token-id equality + a per-step logits max|D| readout,
// NOT loss/perplexity. Engine-native (live core/decode.hexa BYTE mouth, both the
// helpers AND the production `bytegpt_decode_batch_to_file` entry).

import "core/decode.hexa"

// (REF) generate `gen` ids the full-forward way — verbatim ELSE branch of _bg_gen_from_W.
fn gen_ref_full(W: Map, seed: list, gen: int, top_k: int, temp: float, seed_rng: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let outl = []
    let mut rng = _g6_mix32(seed_rng)
    let mut g = 0
    while g < gen {
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let _ = farr_set(ids, p, to_float(toks[start + p])); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let sm = _g6_topk_sample(logits, vocab, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        let _ = farr_free(logits); let _ = farr_free(ids)
        toks.push(nb); outl.push(nb)
        g = g + 1
    }
    return outl
}

// (KV) generate `gen` ids the batch KV fast-path way — verbatim IF branch of
// _bg_gen_from_W, through the PRODUCTION router `_bg_kv_step_r` (dev on CUDA host,
// host otherwise). Valid only when the window never slides (nseed+gen <= block).
fn gen_kv_route(W: Map, seed: list, gen: int, top_k: int, temp: float, seed_rng: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let nseed = len(toks)
    let outl = []
    let mut rng = _g6_mix32(seed_rng)
    let kv = _bg_kv_new(nlay, block, d)
    let mut logits = -1
    let mut sp = 0
    while sp < nseed {
        if logits >= 0 { let _ = farr_free(logits) }
        logits = _bg_kv_step_r(W, kv, to_int(toks[sp]), sp)
        sp = sp + 1
    }
    let mut g = 0
    while g < gen {
        let sm = _g6_topk_sample(logits, vocab, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        let _ = farr_free(logits)
        toks.push(nb); outl.push(nb)
        logits = _bg_kv_step_r(W, kv, nb, len(toks) - 1)
        g = g + 1
    }
    let _ = farr_free(logits)
    _bg_kv_free(kv)
    return outl
}

// greedy (argmax) legs — the CUDA-host gate (argmax-eq even when 1e-6 flips a sample).
fn gen_ref_greedy(W: Map, seed: list, gen: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let outl = []
    let mut g = 0
    while g < gen {
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let _ = farr_set(ids, p, to_float(toks[start + p])); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let nb = bg_argmax(logits, vocab)
        let _ = farr_free(logits); let _ = farr_free(ids)
        toks.push(nb); outl.push(nb)
        g = g + 1
    }
    return outl
}
fn gen_kv_greedy(W: Map, seed: list, gen: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let nseed = len(toks)
    let outl = []
    let kv = _bg_kv_new(nlay, block, d)
    let mut logits = -1
    let mut sp = 0
    while sp < nseed {
        if logits >= 0 { let _ = farr_free(logits) }
        logits = _bg_kv_step_r(W, kv, to_int(toks[sp]), sp)
        sp = sp + 1
    }
    let mut g = 0
    while g < gen {
        let nb = bg_argmax(logits, vocab)
        let _ = farr_free(logits)
        toks.push(nb); outl.push(nb)
        logits = _bg_kv_step_r(W, kv, nb, len(toks) - 1)
        g = g + 1
    }
    let _ = farr_free(logits)
    _bg_kv_free(kv)
    return outl
}

// per-step seed-position logits max|D|: REF full window vs KV cache primed to the
// same prefix through the production router. Host = 0.0; CUDA = ~1e-6.
fn logits_maxdiff(W: Map, seed: list) -> float {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let nseed = len(seed)
    let ids = farr_zeros(nseed)
    let mut p = 0
    while p < nseed { let _ = farr_set(ids, p, to_float(to_int(seed[p]))); p = p + 1 }
    let lref = bg_forward_last_W(W, ids, nseed)
    let kv = _bg_kv_new(nlay, block, d)
    let mut lkv = -1
    let mut sp = 0
    while sp < nseed {
        if lkv >= 0 { let _ = farr_free(lkv) }
        lkv = _bg_kv_step_r(W, kv, to_int(seed[sp]), sp)
        sp = sp + 1
    }
    let mut md = 0.0
    let mut k = 0
    while k < vocab {
        let dv = farr_get(lref, k) - farr_get(lkv, k)
        let av = if dv < 0.0 { 0.0 - dv } else { dv }
        if av > md { md = av }
        k = k + 1
    }
    let _ = farr_free(ids); let _ = farr_free(lref); let _ = farr_free(lkv)
    _bg_kv_free(kv)
    return md
}

// string -> byte-id list
fn seed_ids(stext: string) -> list {
    let seed = []
    let mut si = 0
    while si < byte_len(stext) { seed.push(ord(substring(stext, si, si + 1))); si = si + 1 }
    return seed
}
// ids -> raw text (chr concat, no escaping)
fn ids_text(ids: list) -> string {
    let mut t = ""
    let mut j = 0
    while j < len(ids) { t = t + chr(to_int(ids[j])); j = j + 1 }
    return t
}
// tab/newline -> space, EXACTLY as bytegpt_decode_batch_to_file escapes each fragment.
fn esc_text(txt: string) -> string {
    let mut esc = ""
    let mut k = 0
    let tl = byte_len(txt)
    while k < tl {
        let ch = substring(txt, k, k + 1)
        if ch == "\t" { esc = esc + " " } else { if ch == "\n" { esc = esc + " " } else { esc = esc + ch } }
        k = k + 1
    }
    return esc
}
// first index where two id lists differ, else -1.
fn first_diff(a: list, b: list, n: int) -> int {
    let mut i = 0
    while i < n {
        if to_int(a[i]) != to_int(b[i]) { return i }
        i = i + 1
    }
    return -1
}

fn main() {
    // DETERMINISM: this is a BYTE-EQ SMOKE (REF vs KV legs must be byte-identical), so it
    // OPTS IN to det via the canonical set_deterministic(true) API — process-global, it
    // also pins the un-pinned _bg_gen_from_W decode path. Production decode now defaults to
    // fast non-det (det = OPTION via HEXA_DET=1); a byte-eq gate keeps its explicit pin.
    set_deterministic(true)

    // fixture defaults to the tiny d=64 random-weight ByteGPT (byte-exact gate, mini-safe);
    // on pool point KVBATCH_BIN at the real 303M h1129 .bin for the engine-native run.
    let ovr = exec("printf %s \"$KVBATCH_BIN\"")
    let bin = if byte_len(ovr) > 0 { ovr } else { "/tmp/h1156_mount/bytegpt_tiny.bin" }
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if !have {
        println("[kvcache-batch-smoke] no ByteGPT fixture at " + bin
            + " (run archive/state/kvcache_decode/mk_tiny_bytegpt_fixture.py first) — SKIP")
        return
    }
    let ondev = cuda_available()
    // resident-W load-once (same entry the batch driver uses).
    let W = bg_load_ranged(bin)
    let block = to_int(W["block"])
    println("[kvcache-batch-smoke] loaded fixture  d=" + to_string(to_int(W["d"]))
        + " nlay=" + to_string(to_int(W["nlay"])) + " nh=" + to_string(to_int(W["nh"]))
        + " block=" + to_string(block) + "  cuda_available=" + to_string(ondev)
        + (if ondev == 1 { "  (device path _bg_kv_step_dev -> argmax-eq gate)" }
           else { "  (host path _bg_kv_step -> byte-eq gate)" }))

    // BATCH sweep: several jobs, distinct seed_rng + seed lengths, ALL nseed+gen <= block
    // so the KV fast-path fires for every one. (tag is what the driver keys fragments on.)
    let gen = 24
    let top_k = 8
    let temp = 0.9
    let njob = 4
    let tags   = ["j0", "j1", "j2", "j3"]
    let rngs   = [4242, 7, 99991, 31337]
    let seeds  = ["the quick brown fox ", "hello world: ", "0123456789 ", "a"]

    // build the jobs file for the real batch entry (seed_rng \t tag \t seed_text).
    let jobs = "/tmp/kvcache_batch_jobs.tsv"
    let outp = "/tmp/kvcache_batch_out.tsv"
    let _ = exec("rm -f '" + jobs + "' '" + outp + "'")
    let mut jj = 0
    while jj < njob {
        let _ = append_file(jobs, to_string(to_int(rngs[jj])) + "\t"
            + to_string(tags[jj]) + "\t" + to_string(seeds[jj]) + "\n")
        jj = jj + 1
    }

    // --- leg 1: direct REF-vs-KV per job (raw ids AND raw text, no escaping) ---
    let mut all_ok = 1
    let mut worst_md = 0.0
    let refs = []   // keep REF ids per job for the batch-entry cross-check
    let mut j = 0
    while j < njob {
        let seed = seed_ids(to_string(seeds[j]))
        let nseed = len(seed)
        if nseed + gen > block {
            println("[kvcache-batch-smoke] job " + to_string(j) + " nseed+gen="
                + to_string(nseed + gen) + " > block — window slides, KV path N/A; SKIP-JOB")
            refs.push([])
            j = j + 1
        } else {
            let md = logits_maxdiff(W, seed)
            if md > worst_md { worst_md = md }
            let rid = gen_ref_full(W, seed, gen, top_k, temp, to_int(rngs[j]))
            let kid = gen_kv_route(W, seed, gen, top_k, temp, to_int(rngs[j]))
            let rg  = gen_ref_greedy(W, seed, gen)
            let kg  = gen_kv_greedy(W, seed, gen)
            let sdiv = first_diff(rid, kid, gen)
            let gdiv = first_diff(rg, kg, gen)
            let txt_ok = ids_text(rid) == ids_text(kid)
            // gate: greedy(argmax) MUST match on every host; sample MUST match on a
            // host (cuda==0); on a CUDA host a sample flip from a 1e-6 delta is EXPECTED.
            let sample_gate = if ondev == 1 { 1 } else { if sdiv < 0 && txt_ok { 1 } else { 0 } }
            let greedy_gate = if gdiv < 0 { 1 } else { 0 }
            let job_ok = if sample_gate == 1 && greedy_gate == 1 { 1 } else { 0 }
            if job_ok == 0 { all_ok = 0 }
            let sample_note = if ondev == 1 && sdiv >= 0 { "sample DIVERGE@" + to_string(sdiv) + " (EXPECTED on CUDA, 1e-6)" }
                              else { if sdiv < 0 && txt_ok { "sample IDENTICAL" } else { "sample DIVERGE@" + to_string(sdiv) } }
            println("[kvcache-batch-smoke] job " + to_string(j) + " tag=" + to_string(tags[j])
                + " nseed=" + to_string(nseed) + " maxD=" + to_string(md)
                + "  " + sample_note
                + "  greedy " + (if gdiv < 0 { "IDENTICAL" } else { "DIVERGE@" + to_string(gdiv) }))
            refs.push(rid)
            j = j + 1
        }
    }

    // --- leg 2: real batch entry parity (production file-in / append-out path) ---
    // bytegpt_decode_batch_to_file loads ONCE and generates every fragment through
    // _bg_gen_from_W (KV fast-path, guard fires). Compare its escaped output to the
    // escaped full-forward reference, per tag. On a CUDA host, sample flips make this
    // an informational (argmax-gated) check; on a host it is a strict byte gate.
    let done = bytegpt_decode_batch_to_file(bin, jobs, outp, gen, top_k, temp)
    let olines = read_lines(outp)
    let mut batch_ok = 1
    let mut matched = 0
    let mut oi = 0
    while oi < len(olines) {
        let line = to_string(olines[oi])
        if byte_len(line) > 0 {
            let t1 = _bg_find(line, "\t")
            if t1 > 0 {
                let otag = substring(line, 0, t1)
                let otxt = substring(line, t1 + 1, byte_len(line))
                // find the ref job with this tag
                let mut m = 0
                let mut mi = -1
                while m < njob { if to_string(tags[m]) == otag { mi = m; m = njob } else { m = m + 1 } }
                if mi >= 0 {
                    let ref_ids = refs[mi]
                    if len(ref_ids) == gen {
                        let ref_esc = esc_text(ids_text(ref_ids))
                        if ref_esc == otxt { matched = matched + 1 }
                        else { if ondev == 0 { batch_ok = 0 } }
                    }
                }
            }
        }
        oi = oi + 1
    }
    println("[kvcache-batch-smoke] batch entry generated " + to_string(done)
        + " fragments; " + to_string(matched) + "/" + to_string(njob)
        + " match the full-forward reference on the escaped surface"
        + (if ondev == 1 { "  (CUDA: sample flips expected; greedy is the gate)" } else { "" }))

    // --- verdict ---
    let pass = if ondev == 1 {
        // CUDA host: greedy(argmax) gate carried per-job in all_ok (sample auto-passes).
        if all_ok == 1 { 1 } else { 0 }
    } else {
        if all_ok == 1 && batch_ok == 1 && matched == njob { 1 } else { 0 }
    }
    println("")
    if pass == 1 {
        println("bytegpt_kvcache_batch_smoke: PASS — the LOAD-ONCE batch KV fast-path is "
            + (if ondev == 1 { "ARGMAX-IDENTICAL (CUDA _bg_kv_step_dev, sample 1e-6-tolerant)" }
               else { "BYTE-IDENTICAL (host _bg_kv_step)" })
            + " to the full-forward reference across " + to_string(njob) + " jobs x "
            + to_string(gen) + " tokens, and the real bytegpt_decode_batch_to_file entry "
            + "reproduces the reference (seed-pos worst max|D|=" + to_string(worst_md) + ").")
    } else {
        println("bytegpt_kvcache_batch_smoke: FAIL — batch KV path diverged from the "
            + "full-forward reference (per-job all_ok=" + to_string(all_ok)
            + " batch_ok=" + to_string(batch_ok) + " matched=" + to_string(matched)
            + "/" + to_string(njob) + "). Divergence is the result — do not tune to green.")
    }
}
