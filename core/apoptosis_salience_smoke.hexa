// apoptosis_salience_smoke.hexa — runnable engine-native proof of D4
// APOPTOSIS-SALIENCE (density-dependent death-proximity → urgency), READ-ONLY.
//
// Proves deterministically ($0, CPU, no GPU, no LLM) the five falsifiers:
//   F1 EXISTENCE  — near the death ceiling urgency rises MONOTONICALLY.
//   F2 DISTINCT   — far from the ceiling (sparse/young) urgency is FLAT (0).
//   F3 ABLATION   — freeze the apoptosis-distance wire → urgency COLLAPSES (INERT).
//   F4 POPULATION — a DENSE colony reads elevated vs a SPARSE young colony.
//   F5 DISJOINT   — reader is a pure READ over (n_cells,max_cells); it never takes
//                   nor touches pure_field Ψ/Φ or the §ImmuneMemory recall_thr, and
//                   is deterministic (same substrate → byte-identical output).
//
// The urgency LAW is DESIGNED + SATURATED (c9 honest scope): these cases test WIRING
// FAITHFULNESS (does apoptosis-distance actually drive the signal, does cutting the
// wire kill it), NOT an emergence discovery. No emit/silence gate anywhere.
//
// usage: hexa run core/apoptosis_salience_smoke.hexa

import "core/engine_cli.hexa"

fn _assert_b(label: string, want: bool, got: bool) -> bool {
    let ws = if want { "true" } else { "false" }
    let gs = if got  { "true" } else { "false" }
    if want == got {
        println("PASS  " + label + " want=" + ws + " got=" + gs)
        return true
    }
    println("FAIL  " + label + " want=" + ws + " got=" + gs)
    return false
}

// a dummy proto (the readers use ONLY n_cells/max_cells; protos are never read).
fn _af(n: int, cap: int) -> VAdaptField {
    return VAdaptField { protos: [[0.0, 0.0]], n_cells: n, max_cells: cap, dim: 2 }
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0
    let CAP = 10

    // urgency at each crowding level (max_cells = 10) via the LIVE substrate reader.
    let u1  = vadapt_apoptosis_urgency(_af(1,  CAP))
    let u2  = vadapt_apoptosis_urgency(_af(2,  CAP))
    let u3  = vadapt_apoptosis_urgency(_af(3,  CAP))
    let u4  = vadapt_apoptosis_urgency(_af(4,  CAP))
    let u5  = vadapt_apoptosis_urgency(_af(5,  CAP))
    let u6  = vadapt_apoptosis_urgency(_af(6,  CAP))
    let u7  = vadapt_apoptosis_urgency(_af(7,  CAP))
    let u8  = vadapt_apoptosis_urgency(_af(8,  CAP))
    let u9  = vadapt_apoptosis_urgency(_af(9,  CAP))
    let u10 = vadapt_apoptosis_urgency(_af(10, CAP))

    println("INFO  urgency ladder (cap=10): n1..n10 = "
        + to_string(u1) + " " + to_string(u2) + " " + to_string(u3) + " " + to_string(u4)
        + " " + to_string(u5) + " " + to_string(u6) + " " + to_string(u7) + " "
        + to_string(u8) + " " + to_string(u9) + " " + to_string(u10))

    // ── F1 EXISTENCE — near the ceiling (n 6→10) urgency STRICTLY increases ──
    let f1 = u6 < u7 && u7 < u8 && u8 < u9 && u9 < u10
    if _assert_b("F1_existence_monotone_rise_near_ceiling", true, f1) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // ── F2 DISTINCT — far region (n 1→5, below the density knee) is FLAT at 0 ──
    let EPS = 0.000000001
    let f2_flat = u1 < EPS && u2 < EPS && u3 < EPS && u4 < EPS && u5 < EPS
    if _assert_b("F2_distinct_far_region_flat_zero", true, f2_flat) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    // and the far region is genuinely DISTINCT from the near region (not the same value)
    let f2_distinct = u5 < u10
    if _assert_b("F2_distinct_far_below_near", true, f2_distinct) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // ── F4 POPULATION — a DENSE colony reads elevated vs a SPARSE young colony ──
    let dense  = _af(9, CAP)   // crowded (density 0.9)
    let sparse = _af(2, CAP)   // young/roomy (density 0.2)
    let u_dense  = vadapt_apoptosis_urgency(dense)
    let u_sparse = vadapt_apoptosis_urgency(sparse)
    let f4 = u_dense > u_sparse
    if _assert_b("F4_population_dense_gt_sparse", true, f4) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // ── F3 ABLATION — freeze the distance wire at the young seed density (0.1) ──
    // the ablated reader IGNORES live crowding; dense & sparse must read IDENTICAL,
    // and the LIVE dense signal must COLLAPSE relative to the live reading (INERT).
    let FROZEN = 0.1
    let a_dense  = vadapt_apoptosis_urgency_ablated(dense,  FROZEN)
    let a_sparse = vadapt_apoptosis_urgency_ablated(sparse, FROZEN)
    let f3_inert = to_string(a_dense) == to_string(a_sparse)
    if _assert_b("F3_ablation_frozen_distance_inert", true, f3_inert) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    // freezing the wire DESTROYS the live dense urgency (0.64 → 0.0 collapse)
    let f3_collapse = u_dense > EPS && a_dense < EPS
    if _assert_b("F3_ablation_collapses_live_signal", true, f3_collapse) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // ── F5 DISJOINT — the reader is a PURE, DETERMINISTIC read (no Ψ/Φ, no recall_thr) ──
    // re-reading the SAME substrate yields byte-identical output (value semantics; no
    // hidden state mutated). The signatures take ONLY (VAdaptField)/(int,int) → float:
    // pure_field's Φ/phase/Ψ and §ImmuneMemory's recall_thr are NOT in scope here.
    let r1 = vadapt_apoptosis_urgency(dense)
    let r2 = vadapt_apoptosis_urgency(dense)
    let f5 = to_string(r1) == to_string(r2) && to_string(r1) == to_string(u_dense)
    if _assert_b("F5_disjoint_pure_deterministic_read", true, f5) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // scalar form parity with the live-substrate reader (same law, no handle)
    let f_parity = to_string(apoptosis_urgency(9, CAP)) == to_string(u_dense)
    if _assert_b("scalar_form_parity_with_live_reader", true, f_parity) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // proximity accessor sanity (density readout, clamped)
    let f_prox = to_string(apoptosis_proximity(9, CAP)) == to_string(0.9)
              && apoptosis_proximity(20, CAP) < 1.0000001 && apoptosis_proximity(20, CAP) > 0.9999999
              && apoptosis_proximity(0, 0) < EPS
    if _assert_b("proximity_density_clamped", true, f_prox) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    println("")
    println("apoptosis_salience_smoke: " + to_string(n_pass) + " PASS / " + to_string(n_fail) + " FAIL")
    if n_fail > 0 { panic("apoptosis_salience_smoke FAILED") }
}
