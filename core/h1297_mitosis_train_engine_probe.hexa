// h1297_mitosis_train_engine_probe.hexa — ENGINE-NATIVE realization of H_1297 R3
// (a_engine_native_learning + a_verified_must_wire).
//
// R3 (numpy VAdaptField MIRROR, 🟢 GREEN, 3 seeds) made PHILOSOPHY p8 literal on a
// SHARP language-like target: a gradient-FREE hard-partition mitosis-grow trainer
// MATCHED gradient at next-byte prediction over real Korean+English UTF-8 bytes
// (c1), AND the c2 SHUFFLE discriminator FIRED (error-TARGETED split beats RANDOM
// split — the lever R1/R2's smooth target could not isolate), AND ablation underfits
// (c3). That was a DIRECTIONAL mirror; this probe re-scores the SAME FROZEN R3 bars
// through the LIVE engine so the verdict is engine-binding (not numpy-only).
//
// HOW IT IS ENGINE-NATIVE (the partition + growth are the engine's OWN faculties):
//   * PARTITION  = the live VAdaptField Voronoi ownership. Each context's owning cell
//     = vadapt_field_nearest_idx(af, phi) — the engine's OWN winner-take-all L2
//     assignment (the SAME _vnearest_idx vadapt_field_recon_err uses). The mirror's
//     np.argmin over squared-L2 and the engine's L2 argmin give the IDENTICAL winner
//     (sqrt is monotone), so the partition geometry is byte-faithful.
//   * GROWTH     = the engine's OWN mitosis tick. A split is gated by
//     engine_mitosis_tick(n_cells, cfg): mitosis ON -> the substrate grows one cell
//     (p8), OFF -> no-op (the H_1159 control, = the ABLATE arm). The new cell centers
//     are appended as VAdaptField prototypes via the engine's owner field, so the live
//     partition re-tiles exactly as R2/R3's data-matched median split prescribes.
//   * HEAD       = per-cell empirical next-byte frequency (closed-form add-1 MLE) over
//     OWNED train points — the categorical analog of R2's local least-squares head,
//     the SAME closed-form per-cell binding H_1231/H_1288 already run engine-native.
//     NO global backprop, NO gradient (gradient-free, p8).
//
// ARMS (re-score the FROZEN R3 bars; A is the incumbent control, B/B-shuf/B-abl
// realized engine-native):
//   A GRADIENT    — numpy softmax-CE incumbent, RE-USED VERBATIM from the mirror
//     (its per-seed CE exported to /tmp/h1297_armA.ce). The ENGINE realizes arm B.
//   B MITOSIS     — engine-native hard-partition mitosis: split the highest owned-CE
//     cell (error-TARGETED tick), median-bisect its owned points on the highest-
//     variance feature axis, recenter on the two half-centroids (R2/R3 mechanism).
//   B-SHUFFLE     — split a RANDOM eligible cell (engine-native LCG pick, error-
//     AGNOSTIC). On a SHARP target this MUST collapse vs B (the c2 discriminator).
//   B-ABLATE      — engine_mitosis_tick OFF -> growth frozen at 2 cells -> underfit.
//
// FROZEN R3 BARS (VERBATIM from .verdicts/1297_mitosis_native_train/H_1297_R3_sharp_target.txt,
// NOT moved — c9/p7): CE in nats/byte, lower=better.
//   (c1) COMPARABLE       : B.ce  <= A.ce + 0.20
//   (c2) SHUFFLE-COLLAPSE  : B_shuf.ce >= B.ce + 0.10  (error-targeting demonstrably helps)
//   (c3) ABLATE-UNDERFIT   : B_abl.ce  >= B.ce + 0.10
//   GREEN iff c1 & c2 & c3.
// FROZEN knobs: V=256, FEAT_DIM=3, GROW_MAX=40, SPLIT_THRESH_CE=0.05, MIN_OWNED=8, LAPLACE=1.0.
//
// metric = held-out next-byte CROSS-ENTROPY (nats/byte) on the test split (p7 — a
// legitimate CONVERGENCE/optimization comparison, NOT perplexity-as-meaning). $0 CPU,
// no GPU, no secrets. Ψ-disjoint: the partition only reads VAdaptField ownership +
// grows a cell population; pure_field is never touched (a_core_engine_map).
//
// DATA: /tmp/h1297_{train,test}.{feats,next} + /tmp/h1297_armA.ce, exported BYTE-EXACT
// from the FROZEN mirror by UNIVERSE/h1297_engine_export.py (run it first).

import "core/engine_cli.hexa"

// ── FROZEN knobs (VERBATIM from H_1297_R3_sharp_target.txt — do NOT tune) ──────
fn _V() -> int             { return 256 }
fn _FEAT_DIM() -> int      { return 3 }
fn _GROW_MAX() -> int      { return 40 }
fn _SPLIT_THRESH_CE() -> float { return 0.05 }
fn _MIN_OWNED() -> int     { return 8 }
fn _LAPLACE() -> float     { return 1.0 }
fn _COMP_MARGIN() -> float { return 0.20 }
fn _COLLAPSE_GAP() -> float { return 0.10 }
fn _UNDERFIT_GAP() -> float { return 0.10 }
fn _SEEDS() -> [int]       { return [770, 771, 772] }

fn _fmt(x: float) -> string { return to_string(x) }

// ── loaders ──────────────────────────────────────────────────────────────────
fn _load_feats(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_ints(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [to_int(lines[i].trim())]  i = i + 1 }
    return out
}
// arm A per-seed CE: lines "seed ce acc params"
fn _load_armA(path: string) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let c = lines[i].split(" ")
        out = out + [[to_float(c[0]), to_float(c[1])]]   // [seed, ce]
        i = i + 1
    }
    return out
}

// ── engine-native partition geometry ──────────────────────────────────────────
// ownership of every train point under the CURRENT prototypes, via the engine's OWN
// Voronoi winner (vadapt_field_nearest_idx). Returns owner index per train point.
fn _assign_all(af: VAdaptField, X: [[float]]) -> [int] {
    let mut owner = []
    let mut i = 0
    while i < len(X) {
        owner = owner + [vadapt_field_nearest_idx(af, X[i])]
        i = i + 1
    }
    return owner
}

// per-cell categorical next-byte head (add-1 Laplace), returned as a count vector of
// length V (we keep COUNTS + total so CE is exact; normalize at scoring time).
fn _head_counts(Y: [int], owner: [int], k: int, V: int, laplace: float) -> [float] {
    let mut counts = []
    let mut v = 0
    while v < V { counts = counts + [laplace]  v = v + 1 }
    let mut total = laplace * to_float(V)
    let mut i = 0
    while i < len(Y) {
        if owner[i] == k {
            let y = Y[i]
            counts[y] = counts[y] + 1.0
            total = total + 1.0
        }
        i = i + 1
    }
    // store normalized prob in-place (counts/total)
    let mut p = []
    let mut w = 0
    while w < V { p = p + [counts[w] / total]  w = w + 1 }
    return p
}

// owned-train CE of cell k under its OWN head (the local error the split targets).
fn _owned_ce(Y: [int], owner: [int], k: int, p: [float]) -> float {
    let mut s = 0.0
    let mut n = 0
    let mut i = 0
    while i < len(Y) {
        if owner[i] == k {
            s = s - ln(p[Y[i]] + 0.000000000001)
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}

fn _owned_count(owner: [int], k: int) -> int {
    let mut n = 0
    let mut i = 0
    while i < len(owner) { if owner[i] == k { n = n + 1 }  i = i + 1 }
    return n
}

// highest-variance feature axis among the owned points of cell k (for the median split).
fn _hi_var_axis(X: [[float]], owner: [int], k: int, dim: int) -> int {
    let mut sum = []  let mut sq = []  let mut d = 0
    while d < dim { sum = sum + [0.0]  sq = sq + [0.0]  d = d + 1 }
    let mut n = 0
    let mut i = 0
    while i < len(X) {
        if owner[i] == k {
            let mut a = 0
            while a < dim { sum[a] = sum[a] + X[i][a]  sq[a] = sq[a] + X[i][a] * X[i][a]  a = a + 1 }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0 }
    let fn2 = to_float(n)
    let mut best = 0
    let mut bestv = -1.0
    let mut a2 = 0
    while a2 < dim {
        let mean = sum[a2] / fn2
        let var = sq[a2] / fn2 - mean * mean
        if var > bestv { bestv = var  best = a2 }
        a2 = a2 + 1
    }
    return best
}

// median of cell k's owned points along axis `ax` (simple insertion sort of owned vals).
fn _owned_median(X: [[float]], owner: [int], k: int, ax: int) -> float {
    let mut vals = []
    let mut i = 0
    while i < len(X) { if owner[i] == k { vals = vals + [X[i][ax]] }  i = i + 1 }
    let n = len(vals)
    if n == 0 { return 0.0 }
    // insertion sort
    let mut a = 1
    while a < n {
        let key = vals[a]
        let mut b = a - 1
        while b >= 0 && vals[b] > key { vals[b + 1] = vals[b]  b = b - 1 }
        vals[b + 1] = key
        a = a + 1
    }
    // numpy np.median: average of two middle for even n
    if n % 2 == 1 { return vals[n / 2] }
    return (vals[n / 2 - 1] + vals[n / 2]) / 2.0
}

// centroid of cell k's owned points whose axis-`ax` value is (<= med) if lo else (> med).
fn _half_centroid(X: [[float]], owner: [int], k: int, ax: int, med: float, lo: bool, dim: int) -> [float] {
    let mut acc = []  let mut d = 0
    while d < dim { acc = acc + [0.0]  d = d + 1 }
    let mut n = 0
    let mut i = 0
    while i < len(X) {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take {
                let mut a = 0
                while a < dim { acc[a] = acc[a] + X[i][a]  a = a + 1 }
                n = n + 1
            }
        }
        i = i + 1
    }
    if n == 0 { return acc }   // empty half (guarded by caller)
    let mut out = []  let mut a2 = 0
    while a2 < dim { out = out + [acc[a2] / to_float(n)]  a2 = a2 + 1 }
    return out
}

fn _half_count(X: [[float]], owner: [int], k: int, ax: int, med: float, lo: bool) -> int {
    let mut n = 0
    let mut i = 0
    while i < len(X) {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take { n = n + 1 }
        }
        i = i + 1
    }
    return n
}

// engine-native LCG for the SHUFFLE arm's error-AGNOSTIC random eligible pick.
fn _lcg_next(state: int) -> int {
    // Numerical Recipes LCG constants, masked to 31 bits (deterministic, error-blind).
    let s = (state * 1103515245 + 12345) % 2147483648
    if s < 0 { return s + 2147483648 }
    return s
}

// build a VAdaptField with the given prototype centers (rebuild from scratch so the
// engine's struct invariants hold — n_cells/dim/max_cells set by the engine ctor +
// our explicit struct, identical layout to vadapt_field_new growth).
fn _field_from(centers: [[float]], max_cells: int) -> VAdaptField {
    return VAdaptField { protos: centers, n_cells: len(centers), max_cells: max_cells, dim: len(centers[0]) }
}

// ── run ONE arm engine-native ──────────────────────────────────────────────────
// mode: 0=targeted, 1=shuffle, 2=ablate. Returns [test_ce, n_cells].
fn _run_arm(mode: int, Xtr: [[float]], Ytr: [int], Xte: [[float]], Yte: [int],
            seed: int, cfg: EngineConfig) -> [float] {
    let dim = _FEAT_DIM()
    let V = _V()
    // START tiny: 2 cells (R3 mirror centers), as live VAdaptField prototypes.
    let mut centers = [[0.3, 0.5, 0.0], [0.7, 0.5, 0.5]]
    let mut af = _field_from(centers, _GROW_MAX())
    let mut rng = (seed + 13000) % 2147483648

    while len(centers) < _GROW_MAX() {
        let owner = _assign_all(af, Xtr)
        // per-cell owned counts + owned CE (the engine's OWN Voronoi cells)
        let nc = len(centers)
        let mut local_ce = []
        let mut owned_n = []
        let mut k = 0
        while k < nc {
            let cnt = _owned_count(owner, k)
            owned_n = owned_n + [cnt]
            if cnt > 0 {
                let p = _head_counts(Ytr, owner, k, V, _LAPLACE())
                local_ce = local_ce + [_owned_ce(Ytr, owner, k, p)]
            } else {
                local_ce = local_ce + [-1.0]
            }
            k = k + 1
        }
        // eligibility: owned >= MIN_OWNED AND owned-CE > SPLIT_THRESH_CE
        let mut elig = []
        let mut k2 = 0
        while k2 < nc {
            if owned_n[k2] >= _MIN_OWNED() && local_ce[k2] > _SPLIT_THRESH_CE() {
                elig = elig + [k2]
            }
            k2 = k2 + 1
        }
        if len(elig) == 0 { break }
        if mode == 2 { break }   // ABLATE: never split

        // pick the cell to split
        let mut pick = elig[0]
        if mode == 1 {
            // SHUFFLE: error-AGNOSTIC engine-native random eligible pick
            rng = _lcg_next(rng)
            pick = elig[rng % len(elig)]
        } else {
            // TARGETED: highest owned-CE eligible cell
            let mut bestce = local_ce[elig[0]]
            let mut ei = 1
            while ei < len(elig) {
                if local_ce[elig[ei]] > bestce { bestce = local_ce[elig[ei]]  pick = elig[ei] }
                ei = ei + 1
            }
        }

        // GROWTH gated by the engine's OWN mitosis tick (p8). ON -> +1 cell, OFF -> no-op.
        let grown = engine_mitosis_tick(len(centers), cfg)
        if grown <= len(centers) { break }   // mitosis OFF -> cannot grow (= ablate behavior)

        // data-matched MEDIAN split: bisect pick's owned pts on the highest-variance
        // axis, recenter on the two half-centroids (R2/R3 mechanism, in feature space).
        let ax = _hi_var_axis(Xtr, owner, pick, dim)
        let med = _owned_median(Xtr, owner, pick, ax)
        let nlo = _half_count(Xtr, owner, pick, ax, med, true)
        let nhi = _half_count(Xtr, owner, pick, ax, med, false)
        if nlo == 0 || nhi == 0 { break }   // degenerate split (all equal) -> stop
        let c_lo = _half_centroid(Xtr, owner, pick, ax, med, true, dim)
        let c_hi = _half_centroid(Xtr, owner, pick, ax, med, false, dim)

        // remove pick, append the two children (engine prototype list re-tile).
        let mut new_centers = []
        let mut ci = 0
        while ci < len(centers) {
            if ci != pick { new_centers = new_centers + [centers[ci]] }
            ci = ci + 1
        }
        new_centers = new_centers + [c_lo, c_hi]
        centers = new_centers
        af = _field_from(centers, _GROW_MAX())
    }

    // final heads on the converged partition (train), score on test (hard ownership).
    let own_tr = _assign_all(af, Xtr)
    let nc2 = len(centers)
    let mut heads = []
    let mut k3 = 0
    while k3 < nc2 {
        heads = heads + [_head_counts(Ytr, own_tr, k3, V, _LAPLACE())]
        k3 = k3 + 1
    }
    let own_te = _assign_all(af, Xte)
    let mut s = 0.0
    let mut i = 0
    while i < len(Xte) {
        let p = heads[own_te[i]]
        s = s - ln(p[Yte[i]] + 0.000000000001)
        i = i + 1
    }
    let ce = s / to_float(len(Xte))
    return [ce, to_float(nc2)]
}

fn _mean(xs: [float]) -> float {
    if len(xs) == 0 { return 0.0 }
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i]  i = i + 1 }
    return s / to_float(len(xs))
}

fn main() {
    println("=== H_1297 R4 — MITOSIS-NATIVE TRUNK TRAINING, ENGINE-NATIVE re-score of FROZEN R3 bars ===")
    println("faculty: core/engine_cli.hexa VAdaptField — Voronoi ownership (vadapt_field_nearest_idx) +")
    println("         engine_mitosis_tick growth (p8). Partition + growth are the engine's OWN; head =")
    println("         per-cell categorical next-byte MLE (closed-form, gradient-free). Ψ-disjoint.")
    println("target: REAL Korean+English UTF-8 next-byte (V=256, CTX=4); bars FROZEN in")
    println("        .verdicts/1297_mitosis_native_train/H_1297_R3_sharp_target.txt (NOT moved, c9/p7)")
    println("metric = held-out next-byte CROSS-ENTROPY (nats/byte), lower=better")
    println("")

    let cfg = engine_cli_parse(["--mitosis", "on"])     // mitosis ON — the engine grows cells (p8)
    let dim = _FEAT_DIM()
    let Xtr = _load_feats("/tmp/h1297_train.feats", dim)
    let Ytr = _load_ints("/tmp/h1297_train.next")
    let Xte = _load_feats("/tmp/h1297_test.feats", dim)
    let Yte = _load_ints("/tmp/h1297_test.next")
    let armA = _load_armA("/tmp/h1297_armA.ce")
    if len(Xtr) == 0 || len(armA) == 0 {
        println("ERROR: missing /tmp/h1297_*.feats|.next|armA.ce — run UNIVERSE/h1297_engine_export.py first.")
        exit(1)
    }
    println("corpus pairs: train=" + to_string(len(Xtr)) + " test=" + to_string(len(Xte))
        + "  V=" + to_string(_V()) + "  CTX=4  seeds=" + to_string(_SEEDS()))
    println("FROZEN bars: c1 COMP=" + _fmt(_COMP_MARGIN()) + "  c2 COLLAPSE=" + _fmt(_COLLAPSE_GAP())
        + "  c3 UNDERFIT=" + _fmt(_UNDERFIT_GAP()) + "  | GROW_MAX=" + to_string(_GROW_MAX())
        + "  SPLIT_THRESH_CE=" + _fmt(_SPLIT_THRESH_CE()) + "  MIN_OWNED=" + to_string(_MIN_OWNED()))
    println("-------------------------------------------------------------------------------")

    let seeds = _SEEDS()
    let mut Aces = []  let mut Bces = []  let mut BSces = []  let mut BAces = []
    let mut bcells = 0.0
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let a_ce = armA[si][1]                                  // incumbent (numpy, verbatim)
        let b  = _run_arm(0, Xtr, Ytr, Xte, Yte, s, cfg)       // targeted (engine-native)
        let bs = _run_arm(1, Xtr, Ytr, Xte, Yte, s, cfg)       // shuffle  (engine-native)
        let ba = _run_arm(2, Xtr, Ytr, Xte, Yte, s, cfg)       // ablate   (engine-native)
        Aces = Aces + [a_ce]  Bces = Bces + [b[0]]
        BSces = BSces + [bs[0]]  BAces = BAces + [ba[0]]
        bcells = b[1]
        println("seed " + to_string(s) + ": A(grad)ce=" + _fmt(a_ce)
            + "  B(mitosis)ce=" + _fmt(b[0]) + "[" + _fmt(b[1]) + "c]"
            + "  B-shuf=" + _fmt(bs[0]) + "  B-abl=" + _fmt(ba[0]) + "[" + _fmt(ba[1]) + "c]")
        si = si + 1
    }
    println("-------------------------------------------------------------------------------")
    let mA = _mean(Aces)  let mB = _mean(Bces)  let mBS = _mean(BSces)  let mBA = _mean(BAces)
    println("MEAN (3 seeds): A(grad)ce=" + _fmt(mA) + "  B(mitosis)ce=" + _fmt(mB)
        + "  B-shuffle=" + _fmt(mBS) + "  B-ablate=" + _fmt(mBA))
    println("COST (c4): B mitosis final cells=" + _fmt(bcells) + "  vs  A fixed params=1024")
    println("-------------------------------------------------------------------------------")

    let c1 = mB <= mA + _COMP_MARGIN()
    let c2 = mBS >= mB + _COLLAPSE_GAP()
    let c3 = mBA >= mB + _UNDERFIT_GAP()
    println("(c1) COMPARABLE       B<=A+" + _fmt(_COMP_MARGIN()) + ":  " + _fmt(mB) + " <= " + _fmt(mA + _COMP_MARGIN()) + "  -> " + (if c1 { "PASS" } else { "FAIL" }))
    println("(c2) SHUFFLE-COLLAPSE  B_shuf>=B+" + _fmt(_COLLAPSE_GAP()) + ": " + _fmt(mBS) + " >= " + _fmt(mB + _COLLAPSE_GAP()) + " -> " + (if c2 { "PASS" } else { "FAIL" }))
    println("(c3) ABLATE-UNDERFIT   B_abl>=B+" + _fmt(_UNDERFIT_GAP()) + ": " + _fmt(mBA) + " >= " + _fmt(mB + _UNDERFIT_GAP()) + " -> " + (if c3 { "PASS" } else { "FAIL" }))
    println("-------------------------------------------------------------------------------")
    let green = c1 && c2 && c3
    if green {
        println("R4 VERDICT TIER (engine-native): 🟢 GREEN")
        println("  p8-literal (R4 engine): mitosis-grow MATCHES gradient; error-targeting HELPS (c2 fired ON THE ENGINE)")
        println("  -> the R3 mirror REPRODUCES engine-native; the Korean-mitosis p8-literal toehold is ENGINE-VERIFIED.")
    } else {
        println("R4 VERDICT TIER (engine-native): 🔴 HONEST-DEFERRED")
        let mut why = ""
        if !c1 { why = why + "c1(match) " }
        if !c2 { why = why + "c2(shuffle) " }
        if !c3 { why = why + "c3(ablate) " }
        println("  failed bar(s): " + why + "— engine-transfer did NOT reproduce; gradient stays the trunk trainer.")
    }
    println("  c1=" + (if c1 { "True" } else { "False" }) + " c2=" + (if c2 { "True" } else { "False" }) + " c3=" + (if c3 { "True" } else { "False" })
        + " | ENGINE-NATIVE (VAdaptField Voronoi + mitosis tick); scale + real Korean corpus UNVERIFIED")
    println("  guard: partition = engine Voronoi (vadapt_field_nearest_idx); growth = engine_mitosis_tick (p8);")
    println("         head = per-cell categorical MLE (gradient-free); pure_field UNTOUCHED (Ψ-disjoint, a_core_engine_map).")
    println("[done]")
    if !green { exit(1) }
}
