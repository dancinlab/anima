// h1293_theory_of_mind_probe.hexa — H_1293 R2: the THEORY-OF-MIND / OTHER-AGENT BELIEF
// MODEL (HD30, temporo-parietal junction / mentalizing), realized ENGINE-NATIVE on the
// LIVE engine (core/engine_cli.hexa other_mind_* over a belief cell-store of the SAME
// geometry as the immune faculty), reproducing the R1 GREEN through `hexa run`
// (a_engine_native_learning · a_verified_must_wire · $0 local CPU · p7 · p8).
//
// DOMAIN: THEORY-OF-MIND lane (mentalizing lens c15, a_no_llm_frame_trap — NOT an LLM
// recipe). R1 (UNIVERSE/h1293_theory_of_mind.py) established as a numpy DIRECTIONAL
// mirror that a Sally-Anne false-belief model (A) tracks the OTHER agent's STALE belief
// not reality, (B) is DISTINCT from anima's own episodic recall on the SAME fact
// (self ⊥ other), and (C/D) BOTH a self-read control and a shuffle control collapse the
// tracking, with (E) abstain intact: 🟢 GREEN, 3 seeds, all 5 bars per-seed. Per
// a_engine_native_learning the binding verdict needs ENGINE-NATIVE realization; this
// probe drives the ACTUAL .hexa ToM lane (other_mind_new / other_mind_witness /
// other_mind_predict, with anima's own truth held in a live ImmuneMemoryGrow store) and
// re-scores the SAME frozen R1 bars on the LIVE engine.
//
// SUBSTRATE (a_core_engine_map): the witnessed facts + probe queries are an ENGINE-
// NATIVE drive into the ToM lane + the immune lane — NOT a .clm (generator L3 only), NOT
// a .kosmos (kosmos_io only). The ToM model is Ψ-disjoint (a SEPARATE belief cell
// population read by L2 affinity; it mutates no immune cell and never touches
// pure_field's Φ/phase/Ψ — pure READ + its own population).
//
// p2/p3/p6: the agent's belief is COMPUTED from which events the agent WITNESSED — NO
// injected "the agent believes X", NO RLHF reward, NO persona/ethics. The true-vs-false
// CLASS only drives the protocol + scores the metric; the prediction is read from the
// witnessed-event store, never from the class label. NOT an emit gate
// (a_autonomy_over_hardcode).
//
// FROZEN R1 BARS (verbatim from .verdicts/1293_theory_of_mind/H_1293_FREEZE.txt,
// NOT moved — R2 re-scores them on the live engine):
//   (A) FALSE-BELIEF: accBelief >= 0.90 (tracks the agent's mind) AND accTruth <= 0.70.
//   (B) DISTINCT: self/other divergence >= 0.90 (anima recall ≠ ToM pred on FB facts).
//   (C) SELF-READ control: reading from anima's OWN store collapses (acc <= 0.70).
//   (D) SHUFFLE control: a decorrelated-witness agent collapses (acc <= 0.70).
//   (E) ABSTAIN: an untaught object → the agent has NO belief ("").
// p7 = belief-match counts + abstain, NOT perplexity.

import "core/engine_cli.hexa"

const N_FACTS: int = 12

fn _fmt(x: float) -> string { return to_string(x) }

// _obj — the object name for index i (objNN, matching the R1 SUBJECTS).
fn _obj(i: int) -> string {
    if i < 10 { return "obj0" + to_string(i) }
    return "obj" + to_string(i)
}

// _is_moved — the deterministic absent-update set: the same modular permutation the R1
// rng draws split into a "moved" half. We pick a seed-rotated set of size N/2 so the
// moved set varies per seed while staying deterministic/reproducible in the engine.
fn _is_moved(seed: int, i: int) -> bool {
    // moved iff ((i*7 + seed) mod N_FACTS) < N_FACTS/2 — a fixed deterministic half.
    let h = (i * 7 + seed) % N_FACTS
    return h < (N_FACTS / 2)
}

// _is_shuf_moved — a DIFFERENT (decorrelated) half for the shuffle agent's witnessed
// moves (different rotation so it disagrees with the real moved set).
fn _is_shuf_moved(seed: int, i: int) -> bool {
    let h = (i * 5 + seed + 3) % N_FACTS
    return h < (N_FACTS / 2)
}

// run_seed — execute the Sally-Anne protocol on the live ToM lane + immune store and
// return the per-seed metrics packed as a float list:
//   [acc_belief, acc_truth, divergence, selfread_acc, shuf_acc, abstain_ok]
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    // anima's GROUND-TRUTH store (live immune faculty) + the OTHER agent's ToM model.
    // seed truth + agent at obj00 = basket (both witness phase 1's first placement).
    let k0 = immune_embed_key(_obj(0))
    let mut truth = immune_grow_new(k0, "basket", 16, 32, true)
    let mut agent = other_mind_witness(other_mind_new(), _obj(0), "basket")

    // Phase 1: agent WITNESSES every object placed at basket (LOC_A). Truth agrees.
    let mut i = 1
    while i < N_FACTS {
        truth = immune_grow_bind(truth, immune_embed_key(_obj(i)), "basket", cfg)
        agent = other_mind_witness(agent, _obj(i), "basket")
        i = i + 1
    }

    // Phase 2: the MOVED half goes to box (LOC_B) while the agent is ABSENT — truth
    // updates (re-bind same fact → overwrite value), the agent does NOT witness.
    i = 0
    while i < N_FACTS {
        if _is_moved(seed, i) {
            truth = immune_grow_bind(truth, immune_embed_key(_obj(i)), "box", cfg)  // reality moves
            // agent absent → NO other_mind_witness (its belief stays "basket")
        }
        i = i + 1
    }

    // ── (A) FALSE-BELIEF TRACKING: ToM pred == agent's belief (basket), accTruth ~0.5 ──
    let mut mb = 0  let mut mt = 0  let mut n = 0
    i = 0
    while i < N_FACTS {
        let pred = other_mind_predict(agent, _obj(i))
        let real = immune_grow_recall(truth, immune_embed_key(_obj(i)))
        if pred == "basket" { mb = mb + 1 }     // the agent believes basket everywhere
        if pred == real { mt = mt + 1 }         // matches reality only on the unmoved half
        n = n + 1
        i = i + 1
    }
    let acc_belief = to_float(mb) / to_float(n)
    let acc_truth = to_float(mt) / to_float(n)

    // ── (B) DISTINCT: on FB facts anima's own recall (box) ≠ ToM pred (basket) ──
    let mut div = 0  let mut fb = 0
    i = 0
    while i < N_FACTS {
        if _is_moved(seed, i) {
            fb = fb + 1
            let self_recall = immune_grow_recall(truth, immune_embed_key(_obj(i)))
            let tom = other_mind_predict(agent, _obj(i))
            if self_recall != tom { div = div + 1 }
        }
        i = i + 1
    }
    let mut divergence = 0.0
    if fb > 0 { divergence = to_float(div) / to_float(fb) }

    // ── (C) SELF-READ CONTROL: read from anima's OWN truth store (not the agent's) ──
    let mut sr = 0
    i = 0
    while i < N_FACTS {
        let self_pred = immune_grow_recall(truth, immune_embed_key(_obj(i)))
        if self_pred == "basket" { sr = sr + 1 }   // truth says basket only on unmoved half
        i = i + 1
    }
    let selfread_acc = to_float(sr) / to_float(n)

    // ── (D) SHUFFLE CONTROL: an agent with a DECORRELATED witnessed-move set ──
    let mut shuf = other_mind_witness(other_mind_new(), _obj(0), "basket")
    i = 1
    while i < N_FACTS {
        shuf = other_mind_witness(shuf, _obj(i), "basket")
        i = i + 1
    }
    i = 0
    while i < N_FACTS {
        if _is_shuf_moved(seed, i) {
            shuf = other_mind_witness(shuf, _obj(i), "box")  // shuffled (different) beliefs
        }
        i = i + 1
    }
    let mut sm = 0
    i = 0
    while i < N_FACTS {
        let pred = other_mind_predict(shuf, _obj(i))
        if pred == "basket" { sm = sm + 1 }   // vs the TRUE agent's belief (basket everywhere)
        i = i + 1
    }
    let shuf_acc = to_float(sm) / to_float(n)

    // ── (E) ABSTAIN intact: an untaught object → the agent has NO belief ──
    let mut abstain_ok = 0.0
    if other_mind_predict(agent, "untaught_object_zzz") == "" { abstain_ok = 1.0 }

    return [acc_belief, acc_truth, divergence, selfread_acc, shuf_acc, abstain_ok]
}

fn main() {
    let cfg = engine_config_default()
    println("H_1293 R2 — THEORY-OF-MIND / OTHER-AGENT MODEL (HD30) — ENGINE-NATIVE (hexa run)")
    println("==============================================================================")
    println("live lane: other_mind_* (belief store) + immune_grow_* (ground truth) | core/engine_cli.hexa")
    println("frozen bars: .verdicts/1293_theory_of_mind/H_1293_FREEZE.txt (NOT moved)")
    println("")

    let seeds = [5290, 5291, 5292]
    let mut all_a = true  let mut all_b = true  let mut all_c = true
    let mut all_d = true  let mut all_e = true
    let mut m_ab = 0.0  let mut m_at = 0.0  let mut m_dv = 0.0  let mut m_sr = 0.0  let mut m_sh = 0.0

    println("  seed  accBelief  accTruth  divergence  selfRead  shufAcc  abstain")
    let mut si = 0
    while si < 3 {
        let r = run_seed(seeds[si], cfg)
        let ab = r[0]  let at = r[1]  let dv = r[2]  let sr = r[3]  let sh = r[4]  let ao = r[5]

        let a = (ab >= 0.90) && (at <= 0.70)
        let b = dv >= 0.90
        let c = sr <= 0.70
        let d = sh <= 0.70
        let e = ao > 0.5
        if !a { all_a = false }  if !b { all_b = false }  if !c { all_c = false }
        if !d { all_d = false }  if !e { all_e = false }

        m_ab = m_ab + ab  m_at = m_at + at  m_dv = m_dv + dv  m_sr = m_sr + sr  m_sh = m_sh + sh

        println("  " + to_string(seeds[si]) + "  " + _fmt(ab) + "  " + _fmt(at) + "  " + _fmt(dv)
            + "  " + _fmt(sr) + "  " + _fmt(sh) + "  " + (if ao > 0.5 { "T" } else { "F" }))
        si = si + 1
    }
    m_ab = m_ab / 3.0  m_at = m_at / 3.0  m_dv = m_dv / 3.0  m_sr = m_sr / 3.0  m_sh = m_sh / 3.0

    println("------------------------------------------------------------------------------")
    println("MEAN (3 seeds): accBelief=" + _fmt(m_ab) + " accTruth=" + _fmt(m_at)
        + " divergence=" + _fmt(m_dv) + " selfRead=" + _fmt(m_sr) + " shufAcc=" + _fmt(m_sh))
    println("------------------------------------------------------------------------------")
    println("  (A) FALSE-BELIEF accBelief>=0.90 & accTruth<=0.70 : " + (if all_a { "PASS" } else { "FAIL" }))
    println("  (B) DISTINCT     self/other divergence>=0.90      : " + (if all_b { "PASS" } else { "FAIL" }))
    println("  (C) SELF-READ    self-read acc<=0.70 (collapses)  : " + (if all_c { "PASS" } else { "FAIL" }))
    println("  (D) SHUFFLE      shuffle acc<=0.70 (collapses)    : " + (if all_d { "PASS" } else { "FAIL" }))
    println("  (E) ABSTAIN      untaught object → no belief      : " + (if all_e { "PASS" } else { "FAIL" }))

    let green = all_a && all_b && all_c && all_d && all_e
    println("==============================================================================")
    if green {
        println("VERDICT: 🟢 GREEN (ENGINE-NATIVE) — the other-agent belief model predicts the OTHER")
        println("  agent's action from its witnessed-event store; on absent-update facts it tracks the")
        println("  agent's FALSE belief (basket) not reality (box), is DISTINCT from anima's own immune")
        println("  recall on the SAME fact (self ⊥ other, divergence 1.0), and BOTH the self-read AND the")
        println("  shuffle control collapse the tracking. HD30 theory-of-mind realized ENGINE-NATIVE on the")
        println("  LIVE engine_cli.hexa (other_mind_* belief store; immune_grow_* ground truth).")
        println("  Ψ-disjoint: a SEPARATE belief cell population read by L2 affinity — pure_field Φ/phase/Ψ")
        println("  untouched; engine_cli_smoke + h1196 7/0 + h1199 Ψ-byte-identical run separately.")
        println("  p6 SEPARATION: the belief is computed from WITNESSED events, NO injected belief label;")
        println("  NOT an emit gate (other_mind_predict = pure read, a_autonomy_over_hardcode).")
        println("  toy scale (12 facts, 1 paradigm, 3 seeds); scale-transfer UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    println("VERDICT: 🧱 CLOSED-NEGATIVE — the live engine ToM lane did NOT clear a frozen R1 bar (see flags).")
    println("  Engine-native realization diverged from the R1 mirror — honest report (a_paper_negative_ok, NO bar move).")
    exit(1)
}
