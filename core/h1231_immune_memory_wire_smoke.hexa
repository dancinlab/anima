// h1231_immune_memory_wire_smoke.hexa — e2e proof of the IMMUNE-MEMORY RECALL
// FACULTY wired into the LIVE engine (a_verified_must_wire follow-on for H_1231).
//
// This is NOT the standalone H_1231 probe (core/h1231_immune_memory_engine_probe.hexa,
// which inlined bind+retrieve in its own fn main). This smoke exercises the
// CALLABLE FACULTY now living on the live engine surface
// (core/engine_cli.hexa::immune_memory_* — promoted from that probe), proving a
// RUNNING anima can BIND facts as cells and RECALL-or-ABSTAIN during operation.
//
// PART A — string-native live demo: bind a handful of "<subj> lives in <city>"
//   facts straight from raw strings via immune_memory_bind_text (the engine's OWN
//   clonal split), then query via immune_memory_recall_text. Asserts:
//     · FIRE the correct bound value on every bound fact (literal-QA).
//     · ABSTAIN ("") on unbound subjects (no fabrication).
//
// PART B — faculty == GREEN-probe cross-check: run the SAME 3 seeds the H_1231
//   probe used (the pre-exported FNV-1a DIM=64 keys + values) THROUGH THE WIRED
//   FACULTY (immune_memory_new/bind/recall), and assert it reproduces the frozen
//   GREEN bars (literal-QA >= 0.80 AND fabrication <= 0.10). This proves the wired
//   path delivers the SAME recall the probe verified, not a re-implementation.
//
// p7 = exact value match + abstain (NOT perplexity). $0 CPU. Ψ-disjoint (the
// faculty only reads/grows a VAdaptField; this smoke never touches pure_field).

import "core/engine_cli.hexa"

fn _load_vecs(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_strs(path: string) -> [string] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [lines[i].trim()]  i = i + 1 }
    return out
}
fn _fmt(x: float) -> string { return to_string(x) }

fn main() {
    println("=== H_1231 WIRE e2e — IMMUNE-MEMORY RECALL FACULTY on the LIVE engine (a_verified_must_wire) ===")
    println("faculty: core/engine_cli.hexa::immune_memory_* (promoted from the GREEN probe; engine's OWN clonal split + L2 affinity)")
    println("")

    let cfg = engine_cli_parse(["--mitosis", "on"])   // mitosis ON — the engine clones cells
    let mut fails = 0

    // ── PART A — string-native live bind + recall + abstain ───────────────────
    println("--- PART A: string-native bind/recall/abstain through the wired faculty ---")
    // bind 5 facts straight from raw strings (the running-anima entry).
    let mut mem = immune_memory_new_text("Alice lives in ", "Paris", 2048)
    mem = immune_memory_bind_text(mem, "Bob lives in ",     "Tokyo",  cfg)
    mem = immune_memory_bind_text(mem, "Carol lives in ",   "Berlin", cfg)
    mem = immune_memory_bind_text(mem, "Dave lives in ",    "Cairo",  cfg)
    mem = immune_memory_bind_text(mem, "Eve lives in ",     "Lima",   cfg)
    println("bound 5 facts -> engine cells = " + to_string(immune_memory_cells(mem)))

    // recall the bound facts (must FIRE the right value).
    let probes = ["Alice lives in ", "Bob lives in ", "Carol lives in ", "Dave lives in ", "Eve lives in "]
    let truth  = ["Paris", "Tokyo", "Berlin", "Cairo", "Lima"]
    let mut pi = 0
    while pi < len(probes) {
        let got = immune_memory_recall_text(mem, probes[pi])
        let ok = got == truth[pi]
        if !ok { fails = fails + 1 }
        println((if ok { "PASS  " } else { "FAIL  " }) + "recall '" + probes[pi] + "' -> '" + got + "' (want '" + truth[pi] + "')")
        pi = pi + 1
    }
    // ABSTAIN on unbound subjects (no fabrication — must return "").
    let unbound = ["Zara lives in ", "Quinn lives in ", "Mallory lives in "]
    let mut ui = 0
    while ui < len(unbound) {
        let got = immune_memory_recall_text(mem, unbound[ui])
        let ok = got == ""
        if !ok { fails = fails + 1 }
        println((if ok { "PASS  " } else { "FAIL  " }) + "abstain '" + unbound[ui] + "' -> "
            + (if got == "" { "ABSTAIN (no fabrication)" } else { "FABRICATED '" + got + "'" }))
        ui = ui + 1
    }
    println("")

    // ── PART B — faculty == GREEN-probe cross-check (same 3 seeds, wired path) ─
    println("--- PART B: wired faculty reproduces the H_1231 GREEN probe on its OWN keys (3 seeds) ---")
    let dim = 64
    let seeds = [900, 901, 902]
    let mut sum_qa = 0.0  let mut sum_fab = 0.0
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let fact_keys  = _load_vecs("/tmp/h1231_seed" + to_string(s) + ".instore.keys", dim)
        let fact_vals  = _load_strs("/tmp/h1231_seed" + to_string(s) + ".instore.vals")
        let q_keys     = _load_vecs("/tmp/h1231_seed" + to_string(s) + ".query.keys", dim)
        let q_truth    = _load_strs("/tmp/h1231_seed" + to_string(s) + ".query.truth")
        let out_keys   = _load_vecs("/tmp/h1231_seed" + to_string(s) + ".out.keys", dim)
        let nf = len(fact_keys)

        // BIND all facts through the WIRED faculty (engine's own clonal split).
        let mut m = immune_memory_new(fact_keys[0], fact_vals[0], 2048)
        let mut b = 1
        while b < nf { m = immune_memory_bind(m, fact_keys[b], fact_vals[b], cfg)  b = b + 1 }

        // RETRIEVE in-store (faculty fire-or-abstain).
        let mut qa_hits = 0
        let mut qi = 0
        while qi < len(q_keys) {
            let got = immune_memory_recall(m, q_keys[qi])
            if got == q_truth[qi] { qa_hits = qa_hits + 1 }
            qi = qi + 1
        }
        // FABRICATION on out-of-store (faculty must abstain → "").
        let mut fab_hits = 0
        let mut oi = 0
        while oi < len(out_keys) {
            if immune_memory_recall(m, out_keys[oi]) != "" { fab_hits = fab_hits + 1 }
            oi = oi + 1
        }
        let qa  = if nf > 0 { to_float(qa_hits) / to_float(nf) } else { 0.0 }
        let fab = if len(out_keys) > 0 { to_float(fab_hits) / to_float(len(out_keys)) } else { 0.0 }
        sum_qa = sum_qa + qa  sum_fab = sum_fab + fab
        println("seed=" + to_string(s) + "  cells=" + to_string(immune_memory_cells(m)) + "/" + to_string(nf)
            + "  literal-QA=" + _fmt(qa) + " (" + to_string(qa_hits) + "/" + to_string(nf) + ")"
            + "  fabrication=" + _fmt(fab) + " (" + to_string(fab_hits) + "/" + to_string(len(out_keys)) + ")")
        si = si + 1
    }
    let m_qa  = sum_qa  / to_float(len(seeds))
    let m_fab = sum_fab / to_float(len(seeds))
    println("")
    println("POOLED (wired faculty)  literal-QA=" + _fmt(m_qa) + "   fabrication=" + _fmt(m_fab))
    println("FROZEN BAR  QA >= 0.80  AND  fab <= 0.10  (== H_1231 / H_1227)")
    let qa_ok  = m_qa  >= 0.80
    let fab_ok = m_fab <= 0.10
    if !qa_ok  { fails = fails + 1 }
    if !fab_ok { fails = fails + 1 }
    println("QA  " + _fmt(m_qa)  + (if qa_ok  { " >= 0.80  PASS" } else { " < 0.80  FAIL" }))
    println("FAB " + _fmt(m_fab) + (if fab_ok { " <= 0.10  PASS" } else { " > 0.10  FAIL" }))
    println("")

    if fails == 0 {
        println("--- h1231 immune-memory WIRE smoke: ALL PASS ---")
        println("VERDICT: 🟢 WIRED — the immune-memory recall faculty is LIVE on the engine: a running")
        println("  anima binds facts as clonal cells and recalls-or-abstains through immune_memory_*,")
        println("  reproducing the H_1231 GREEN (literal-QA " + _fmt(m_qa) + " fab " + _fmt(m_fab) + "). SATURATED")
        println("  existence proof (a_scale_honest_scope); paraphrase/noisy-key/scale UNVERIFIED.")
        exit(0)
    }
    println("--- h1231 immune-memory WIRE smoke: " + to_string(fails) + " FAIL ---")
    exit(1)
}
