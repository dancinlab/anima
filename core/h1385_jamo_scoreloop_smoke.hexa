// h1385_jamo_scoreloop_smoke.hexa — the H_1385 WIRED-SCORELOOP proof (jamo r2, scoreloop-wire).
//
// LANE: thread the faculty-owned jamo count-head SCORER (H_1351 § KO-JAMO COUNT-HEAD,
// engine_cli.hexa jamo_head_*) into the LIVE brain/decode SCORING loop. H_1351 promoted the
// validated jamo-decomposition count-head to a first-class engine faculty (a PURE SCORER), but it
// had NO call site in the live scoring loop. H_1385 adds that call site: generator.hexa §6.5c
// gen_jamo_scoreloop CONSULTS jamo_head_ce from the live scoring path, and gen_clm_ce attaches the
// scoring record ADDITIVELY under the `jamo_score` key (a_verified_must_wire single entry,
// a_core_engine_map). This proof drives that LIVE generator scoring consult and re-scores the
// H_1351 W2/W3 structure ENGINE-NATIVE on the wired call site.
//
//   B1 WIRED-SCORELOOP : jamo_head_ce is CONSULTED via the named single entry gen_jamo_scoreloop
//                        AND gen_clm_ce additively carries jamo_score (the faculty is CALLED in the
//                        live scoring loop, not just existing). cells >= 2, jamo_ce > 0.
//   B2 JAMO-BEATS-RAW  : raw_ce - jamo_ce >= 0.05 through the wired scoreloop (H_1351 W2).
//   B3 EARNED          : shuf_ce - jamo_ce >= 0.05 through the wired scoreloop — pairing-shuffle
//                        collapses the advantage (H_1351 W3).
//   B4 ADDITIVE        : a fabricated decodable-CE Map gains jamo_score WITHOUT mutating any
//                        pre-existing field (additive — the .clm forward CE path byte-identical).
//                        (the Ψ-disjoint / no-regression guards — h1205, engine_cli_smoke, h1196 —
//                        run separately; this case asserts the additive contract.)
//
// p7 (NOT perplexity): the metric is held-out next-symbol CE on the simple stack. $0 CPU,
// deterministic, no corpus/secret/GPU, no decode (pure scoring). Ψ-disjoint (pure SCORER).
//
// RUN: hexa run CORE/h1385_jamo_scoreloop_smoke.hexa

import "CORE/generator.hexa"

fn _assert_b(label: string, want: bool, got: bool) -> bool {
    let ws = if want { "true" } else { "false" }
    let gs = if got  { "true" } else { "false" }
    if want == got {
        println("PASS  " + label + " want=" + ws + " got=" + gs)
        return true
    }
    println("FAIL  " + label + " want=" + ws + " got=" + gs)
    return false
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0

    // drive the LIVE generator scoring consult — jamo_head_ce reached via gen_jamo_scoreloop.
    let sc = gen_jamo_scoreloop()
    let ok       = to_string(sc["ok"]) == "true"
    let jamo_ce  = to_float(sc["jamo_ce"])
    let raw_ce   = to_float(sc["raw_ce"])
    let shuf_ce  = to_float(sc["shuf_ce"])
    let advantage = to_float(sc["advantage"])
    let earned    = to_float(sc["earned"])
    let cells     = to_int(sc["cells"])

    println("INFO  jamo scoreloop (live generator consult): jamo_ce=" + to_string(jamo_ce)
        + " raw_ce=" + to_string(raw_ce) + " shuf_ce=" + to_string(shuf_ce)
        + " advantage=" + to_string(advantage) + " earned=" + to_string(earned)
        + " cells=" + to_string(cells))

    // B1 WIRED-SCORELOOP : the consult ran (jamo_head_ce called) and grew the count head in-engine.
    if _assert_b("case_B1_wired_scoreloop_consulted", true,
                 ok && cells >= 2 && jamo_ce > 0.0) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // B2 JAMO-BEATS-RAW : the decomposed jamo view beats the opaque-merge raw view by >= 0.05.
    if _assert_b("case_B2_jamo_beats_raw", true,
                 advantage >= 0.05) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // B3 EARNED : the intact jamo head beats its OWN pairing-shuffle control by >= 0.05.
    if _assert_b("case_B3_earned_vs_shuffle", true,
                 earned >= 0.05) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // B4 ADDITIVE : gen_clm_ce attaches jamo_score WITHOUT mutating any pre-existing field. We
    // assert the additive contract directly on the wiring primitive (map_set is non-mutating; the
    // .clm forward path is UNTOUCHED — a missing/v0.1 .clm still returns ok=false verbatim, now
    // ALSO carrying the additive jamo_score). Here we verify the additive op on a fabricated
    // clm_forward_ce-shaped record (the live .clm path is covered by the existing CE guards).
    let base_rec = #{ "ok": false, "windows": 0, "model_ce": 1.25, "green": false,
                      "reason": "not v0.2-decodable" }
    let merged = map_set(base_rec, "jamo_score", sc)
    let additive_ok =
            to_string(merged["ok"])     == to_string(base_rec["ok"])
        && to_string(merged["windows"]) == to_string(base_rec["windows"])
        && to_float(merged["model_ce"]) == to_float(base_rec["model_ce"])
        && to_string(merged["green"])   == to_string(base_rec["green"])
        && to_string(merged["reason"])  == to_string(base_rec["reason"])
        && to_string(merged["jamo_score"]["ok"]) == "true"
        && to_float(merged["jamo_score"]["jamo_ce"]) == jamo_ce
    if _assert_b("case_B4_gen_clm_ce_additive_jamo_score", true,
                 additive_ok) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    println("--- h1385 jamo-scoreloop smoke summary: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
