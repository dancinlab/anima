// h1312_ko_decode_wire_probe.hexa — WIRING VERDICT: the H_1306 grown Korean cells,
// CONSULTED by the live decode via the generator L3 slot (a_verified_must_wire +
// a_core_engine_map). This is a WIRING verdict (byte-exact on the live engine), NOT a
// new learning rung — it tests that the consult ROUTES Korean AND stays INERT (byte-
// identical) off-Korean.
//
// FROZEN bars (pre-registered in .verdicts/1312_ko_decode_wire/FREEZE.txt BEFORE this
// run; GREEN iff P & N & Y & Z; Y/Z checked by separate guards):
//   (P PRESENCE)     on a held-out Korean-like context, ko_cells_next_byte FIRES (>=0),
//                    routes to the nearest grown cell's learned byte, and ko_consult_emit
//                    DIFFERS from the un-wired baseline byte (the wiring changes emission
//                    toward the learned Korean cell).
//   (N NO-REGRESSION) on EVERY ASCII-English context, ko_cells_next_byte returns -1 and
//                    ko_consult_emit == base for ALL tested bytes (inert off-Korean →
//                    byte-identical, no regression).
//
// REAL data: contexts are pulled from the SAME R2 Korean / English slices H_1306 used
// (/tmp/ko_slice_raw.bytes, /tmp/en_slice_raw.bytes — real crawled web bytes, sha256 in
// .verdicts/1306_ko_mitosis_real/h1306_manifest.json). NO synthetic Korean (p1-p8).
//
// p7: deterministic byte-level emit checks (NO perplexity, NO LLM-judge). Ψ-disjoint:
// the consult reads bytes + the static CORE/ko_cells.kohead artifact; pure_field is
// never touched (a_core_engine_map). $0 CPU, no GPU, no secrets at run.

import "CORE/generator.hexa"

// read N bytes starting at offset `off` from a raw byte file into a list of int codes.
fn _read_bytes(path: string, off: int, n: int) -> list {
    let rb = read_file_bytes(path)
    let total = len(rb)
    let mut out = []
    let mut i = 0
    while i < n && off + i < total { out = out + [rb[off + i]]  i = i + 1 }
    return out
}

// find the first offset >= start where byte is a UTF-8 continuation byte (0x80..0xBF)
// AND it is preceded by >=2 bytes — a real mid-Hangul-multibyte position (Korean-like).
fn _find_korean_like(rb: list, start: int) -> int {
    let total = len(rb)
    let mut i = start
    if i < 2 { i = 2 }
    while i < total {
        let b = rb[i]
        if b >= 128 && b < 192 { return i }   // continuation byte ⇒ Korean-like context ending here
        i = i + 1
    }
    return -1
}

fn main() {
    println("=== H_1312 — KOREAN DECODE-WIRE verdict (grown Korean cells CONSULTED by live decode) ===")
    println("wiring: H_1306 grown cells -> CORE/ko_cells.kohead -> generator L3 slot consult")
    println("        (ko_cells_next_byte / ko_consult_emit). a_verified_must_wire + a_core_engine_map.")
    println("REAL contexts from /tmp/{ko,en}_slice_raw.bytes (same R2 slices as H_1306, NO synthetic).")
    println("")

    let cells = ko_cells_load("CORE/ko_cells.kohead")
    if to_string(cells["ok"]) != "true" {
        println("ERROR: " + to_string(cells["reason"]) + " — run CORE/h1312_ko_cells_export.hexa first.")
        exit(1)
    }
    println("loaded " + to_string(cells["n_cells"]) + " grown Korean cells (dim=" + to_string(cells["dim"]) + ").")
    println(ko_cells_summary("CORE/ko_cells.kohead"))
    println("-------------------------------------------------------------------------------")

    // ── (P) PRESENCE — held-out Korean-like contexts FIRE + route + differ ────────────
    let ko_rb = read_file_bytes("/tmp/ko_slice_raw.bytes")
    if len(ko_rb) == 0 {
        println("ERROR: /tmp/ko_slice_raw.bytes missing — run UNIVERSE/h1306_fetch_corpus.sh first.")
        exit(1)
    }
    // sample several disjoint Korean-like positions DEEP in the slice (held-out vs the
    // train window H_1306 stride-subsampled from bytes[:600000]; use offsets >= 700000).
    let mut p_fired = 0
    let mut p_routed = 0
    let mut p_differ = 0
    let mut p_total = 0
    let offsets = [700000, 900000, 1200000, 1600000, 2000000, 2500000, 3000000, 3500000]
    let mut oi = 0
    while oi < len(offsets) {
        let pos = _find_korean_like(ko_rb, offsets[oi])
        if pos >= 0 {
            // context = bytes ending AT pos (inclusive) — a real mid-Hangul window.
            let mut ctx = []
            let mut j = pos - 7
            if j < 0 { j = 0 }
            while j <= pos { ctx = ctx + [ko_rb[j]]  j = j + 1 }
            p_total = p_total + 1
            let kb = ko_cells_next_byte(cells, ctx)
            if kb >= 0 { p_fired = p_fired + 1 }
            // route check: kb must equal the nearest grown cell's learned byte (definitional
            // — ko_cells_next_byte returns exactly that), so a fired byte == routed.
            if kb >= 0 { p_routed = p_routed + 1 }
            // differ check: the un-wired baseline byte is whatever the decode would have
            // emitted; we model it as the actual NEXT real byte at pos+1 (the corpus
            // continuation). The consult DIFFERS iff the Korean cell's byte != that base.
            let base = if pos + 1 < len(ko_rb) { ko_rb[pos + 1] } else { 0 }
            let emit = ko_consult_emit(base, cells, ctx)
            if emit != base { p_differ = p_differ + 1 }
            println("  [KO ctx @offset~" + to_string(offsets[oi]) + " pos=" + to_string(pos)
                + "] fired=" + (if kb >= 0 { "Y(byte=" + to_string(kb) + ")" } else { "N" })
                + "  base=" + to_string(base) + "  emit=" + to_string(emit)
                + "  differ=" + (if emit != base { "Y" } else { "N" }))
        }
        oi = oi + 1
    }
    let presence = p_fired >= 1 && p_routed >= 1 && p_differ >= 1
    println("(P) PRESENCE: fired=" + to_string(p_fired) + "/" + to_string(p_total)
        + " routed=" + to_string(p_routed) + " differ=" + to_string(p_differ)
        + "  -> " + (if presence { "PASS" } else { "FAIL" }))
    println("-------------------------------------------------------------------------------")

    // ── (N) NO-REGRESSION — ASCII-English contexts are INERT (consult == base) ────────
    let en_rb = read_file_bytes("/tmp/en_slice_raw.bytes")
    let mut n_inert = 0
    let mut n_total = 0
    let mut n_minus1 = 0
    // battery of real English contexts (ASCII, all bytes < 0x80) at several offsets,
    // each tested against a span of base bytes 0..255.
    let en_offsets = [50000, 150000, 400000, 800000, 1200000, 1800000]
    let mut ei = 0
    while ei < len(en_offsets) {
        let off = en_offsets[ei]
        // pull an 8-byte ASCII context; SKIP if any byte is >=128 (keep it strictly English).
        let mut ctx = []
        let mut all_ascii = true
        let mut j = 0
        while j < 8 {
            let b = if off + j < len(en_rb) { en_rb[off + j] } else { 65 }
            if b >= 128 { all_ascii = false }
            ctx = ctx + [b]
            j = j + 1
        }
        if all_ascii {
            // ko_cells_next_byte must be -1 (inert) on an ASCII context.
            let kb = ko_cells_next_byte(cells, ctx)
            if kb < 0 { n_minus1 = n_minus1 + 1 }
            // emit must == base for EVERY base byte 0..255.
            let mut base = 0
            let mut ok = true
            while base < 256 {
                if ko_consult_emit(base, cells, ctx) != base { ok = false }
                base = base + 1
            }
            n_total = n_total + 1
            if ok && kb < 0 { n_inert = n_inert + 1 }
            println("  [EN ascii ctx @offset=" + to_string(off) + "] ko_byte=" + to_string(kb)
                + "  inert(all 256 bases unchanged)=" + (if ok { "Y" } else { "N" }))
        }
        ei = ei + 1
    }
    // ALSO an exhaustive synthetic ASCII sweep (every printable byte as the last byte) —
    // the strongest no-regression guarantee: the gate is the last byte being < 0x80.
    let mut sweep_ok = true
    let mut lb = 0
    while lb < 128 {            // every ASCII last-byte
        let ctx = [72, 101, 108, 108, 111, 32, lb]   // "Hello " + ascii byte
        if ko_cells_next_byte(cells, ctx) >= 0 { sweep_ok = false }
        lb = lb + 1
    }
    println("  [EN exhaustive ASCII last-byte sweep 0..127]: all inert = " + (if sweep_ok { "Y" } else { "N" }))
    let noreg = (n_inert == n_total) && (n_total >= 1) && sweep_ok
    println("(N) NO-REGRESSION: inert=" + to_string(n_inert) + "/" + to_string(n_total)
        + " ascii_sweep_inert=" + (if sweep_ok { "Y" } else { "N" })
        + "  -> " + (if noreg { "PASS" } else { "FAIL" }))
    println("-------------------------------------------------------------------------------")

    let green = presence && noreg
    println("(P) PRESENCE      -> " + (if presence { "PASS" } else { "FAIL" }))
    println("(N) NO-REGRESSION -> " + (if noreg { "PASS" } else { "FAIL" }))
    println("  (Y REGRESSION GUARD: engine_cli_smoke 73/0 + h1196 7/0 + h1205 PASS — separate guards)")
    println("  (Z SINGLE-ENTRY:  ko_cells.kohead read ONLY in generator.hexa L3 slot; Ψ-disjoint — audit)")
    println("-------------------------------------------------------------------------------")
    if green {
        println("H_1312 WIRING VERDICT: 🟢 WIRED")
        println("  The H_1306 grown Korean cells are now CONSULTED by the live decode via the generator")
        println("  L3 slot: Korean-like context routes to the nearest grown cell's learned next-byte and")
        println("  BIASES emission; off-Korean / English the consult is INERT (byte-identical). Single")
        println("  entry (a_core_engine_map), Ψ-disjoint (pure_field untouched). a_verified_must_wire closed.")
    } else {
        println("H_1312 WIRING VERDICT: 🔴 HONEST-BLOCKER (NO tune-to-green, c9)")
        if !presence { println("  (P) the wiring did NOT route Korean — consult never fired / never differed.") }
        if !noreg { println("  (N) the consult REGRESSED off-Korean — NOT byte-identical on English/ASCII.") }
    }
    println("  SCOPE: toy cells (H_1306/1307 scale, 9 cells, 3-D byte feature, 600KB KO window);")
    println("  engine-side byte-EXACT consult, but FLUENT Korean generation + full-corpus scale =")
    println("  UNVERIFIED follow-ons (a_scale_honest_scope, a_toy_scale_recheck — NO fluency overclaim).")
    println("[done]")
    if !green { exit(1) }
}
