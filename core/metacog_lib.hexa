// ════════════════════════════════════════════════════════════════════════
// METACOG/metacog_lib.hexa — METACOG self-audit PURE primitives (M1 2026-05-28)
//
// 정체: bench/axis_metacog/bench.hexa (PR #1139, 5/5 round-trip 🟢 PASS) 의
//      5-tier verdict taxonomy + 30-emit history → 4-window binarize primitives
//      를 stdlib-shaped PURE wrapper 로 회수. METACOG axis 의 anima 본체
//      self-audit surface entry — `analyze_probe_table` + `binarize_emits`
//      stdlib 화 per METACOG.md M1.
//
// 회수 출처 verbatim:
//   - 원본 경로: bench/axis_metacog/bench.hexa (PR #1139 land)
//   - 5-tier code taxonomy: ROBUST(1) · SMALL-N(2) · INVERSE(3) · AMBIG(4) · ALL-FAIL(5)
//   - 시점: 2026-05-28 M1 lib promotion
//   - 본체 무수정 — header cite + pub-wrapper 만
//
// 8 pub primitives (PURE, no mutation):
//   1) mc_all_pass(passes)                 — every window PASS  → 1 else 0
//   2) mc_all_fail(passes)                 — every window FAIL  → 1 else 0
//   3) mc_is_small_n_artifact(passes)      — w0 PASS only       → 1 else 0
//   4) mc_is_inverse_artifact(passes)      — w0 FAIL only       → 1 else 0
//   5) mc_count_pass(passes)               — Σ passes
//   6) mc_verdict_code(passes)             — 5-tier code 1..5
//   7) mc_verdict_label(code)              — ROBUST / SMALL-N / INVERSE / AMBIG / ALL-FAIL
//   8) mc_verdict_tier(code)               — GREEN / RED / ORANGE / YELLOW / RED
//   bonus binarize:
//   9) mc_window_pass_rate(emits, lo, hi)  — Σ(emits[lo..hi]) / (hi - lo)
//  10) mc_binarize_emits(emits)            — 30-emit → 4-window [1/0,1/0,1/0,1/0]
//  11) mc_analyze_probe_table(emits)       — full pipeline: emits → passes → code
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : analyzer 는 emit list만 입력, system 미사용 ✓
//   - p5 NO SPEAK()        : read-only, 발화 없음 ✓
//   - p7 NO PPL VERDICT    : 모든 verdict = passes-bitmap deterministic ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//
// Naming: `mc_` prefix 로 stdlib `pub fn` collision 회피 (g61). bench 의
//         local fn(`all_pass`/`verdict_code`/`binarize_history`) 와 별 namespace.
// ════════════════════════════════════════════════════════════════════════

// ─── 1. 5-tier verdict primitives ────────────────────────────────────────

pub fn mc_all_pass(passes: list) -> int {
    let mut i = 0
    let mut len = passes.len()
    while i < len {
        if passes[i] == 0 { return 0 }
        i = i + 1
    }
    return 1
}

pub fn mc_all_fail(passes: list) -> int {
    let mut i = 0
    let mut len = passes.len()
    while i < len {
        if passes[i] == 1 { return 0 }
        i = i + 1
    }
    return 1
}

pub fn mc_is_small_n_artifact(passes: list) -> int {
    let mut len = passes.len()
    if len < 2 { return 0 }
    if passes[0] != 1 { return 0 }
    let mut i = 1
    while i < len {
        if passes[i] == 1 { return 0 }
        i = i + 1
    }
    return 1
}

pub fn mc_is_inverse_artifact(passes: list) -> int {
    let mut len = passes.len()
    if len < 2 { return 0 }
    if passes[0] != 0 { return 0 }
    let mut i = 1
    while i < len {
        if passes[i] == 0 { return 0 }
        i = i + 1
    }
    return 1
}

pub fn mc_count_pass(passes: list) -> int {
    let mut c = 0
    let mut i = 0
    let mut len = passes.len()
    while i < len {
        if passes[i] == 1 { c = c + 1 }
        i = i + 1
    }
    return c
}

pub fn mc_verdict_code(passes: list) -> int {
    if mc_all_pass(passes) == 1 { return 1 }
    if mc_all_fail(passes) == 1 { return 5 }
    if mc_is_small_n_artifact(passes) == 1 { return 2 }
    if mc_is_inverse_artifact(passes) == 1 { return 3 }
    return 4
}

pub fn mc_verdict_label(code: int) -> string {
    if code == 1 { return "ROBUST" }
    if code == 2 { return "SMALL-N-ARTIFACT" }
    if code == 3 { return "INVERSE-ARTIFACT" }
    if code == 4 { return "AMBIGUOUS" }
    if code == 5 { return "ALL-FAIL" }
    return "UNKNOWN"
}

pub fn mc_verdict_tier(code: int) -> string {
    if code == 1 { return "GREEN" }
    if code == 2 { return "RED" }
    if code == 3 { return "ORANGE" }
    if code == 4 { return "YELLOW" }
    if code == 5 { return "RED" }
    return "GREY"
}

// ─── 2. 30-emit → 4-window binarize ──────────────────────────────────────
//
// emit history (size 30) → 4 disjoint windows (7/7/8/8) → per-window
// PASS rate >= 0.5 mapped to 1 else 0. Round-trip 5/5 carry (PR #1139).

pub fn mc_window_pass_rate(emits: list, lo: int, hi: int) -> float {
    let mut s = 0
    let mut i = lo
    while i < hi {
        if emits[i] == 1 { s = s + 1 }
        i = i + 1
    }
    let denom = hi - lo
    return float(s) / float(denom)
}

pub fn mc_binarize_emits(emits: list) -> list {
    let mut bins = []
    bins.push(mc_window_pass_rate(emits, 0,  7))
    bins.push(mc_window_pass_rate(emits, 7,  14))
    bins.push(mc_window_pass_rate(emits, 14, 22))
    bins.push(mc_window_pass_rate(emits, 22, 30))
    let mut passes = []
    let mut i = 0
    while i < bins.len() {
        if bins[i] >= 0.5 { passes.push(1) } else { passes.push(0) }
        i = i + 1
    }
    return passes
}

// ─── 3. Full pipeline (emits → code) ─────────────────────────────────────
pub fn mc_analyze_probe_table(emits: list) -> int {
    let passes = mc_binarize_emits(emits)
    return mc_verdict_code(passes)
}
