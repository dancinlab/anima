// h1261_akida_model_fusion.hexa — AKIDA ⊗ MODEL 융합 (외부기질 융합 그리드 마지막 빈칸).
//
// H_1257~1259 가 EEG 포함 조합(EEG⊗AKIDA, EEG⊗MODEL, 3중)을 채웠고, EEG 없는 페어
// AKIDA⊗MODEL 만 미탐사였음 → 3-외부기질 융합 그리드(2^3−1=7 중 페어 3 + 트리플 1) 완성.
// bridge_and_gate = 천연 AND-게이트, 각 기질이 한 키. 실측: AKIDA 79.95Hz · MODEL entropy 0.969.
// 합격 = Ψ byte-identical ∧ 각 기질 기여(toggle 변화) ∧ context bounded.

import "CORE/pure_field.hexa"
import "CORE/xsubstrate_bridge.hexa"
import "BRIDGE/gate.hexa"

fn fuse_run(ctx_akida: float, ctx_model: float, on_a: bool, on_m: bool) -> array {
    let a = if on_a { ctx_akida } else { 0.0 }
    let mo = if on_m { ctx_model } else { 0.0 }
    let mut pf = pure_field_new()
    let mut psum = 0.0
    let mut prop = 0.0
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psum = psum + phi
        prop = prop + bridge_and_gate(a, mo, 1.0, phi)
        i = i + 1
    }
    return [psum, prop]
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1261 AKIDA ⊗ MODEL 융합 — 외부기질 융합 그리드 마지막 빈칸")
    println("════════════════════════════════════════════════════════════════")
    let ctx_akida = xs_bridge(79.9547, 1)     // REAL AKD1000 spike rate
    let ctx_model = xs_bridge(0.969391, 2)    // REAL ByteGPT-303M entropy
    println("[ctx] AKIDA=" + str(ctx_akida) + " MODEL=" + str(ctx_model))
    let full = fuse_run(ctx_akida, ctx_model, true, true)
    let base = fuse_run(0.0, 0.0, false, false)
    let p_full = full[1]
    println("[Psi] fused=" + str(full[0]) + " base=" + str(base[0]))
    println("[emit] fused propensity=" + str(p_full))
    let f1 = full[0] == base[0]
    // 각 기질 기여: toggle off 시 변화
    let mut f2 = true
    let t_noa = fuse_run(ctx_akida, ctx_model, false, true)
    if t_noa[1] == p_full { f2 = false }
    let t_nom = fuse_run(ctx_akida, ctx_model, true, false)
    if t_nom[1] == p_full { f2 = false }
    let f3 = ctx_akida >= 0.0 && ctx_akida <= 1.0 && ctx_model >= 0.0 && ctx_model <= 1.0
    println("[F1] Ψ byte-identical : " + (if f1 {"PASS"} else {"FAIL"}))
    println("[F2] 각 기질 기여     : " + (if f2 {"PASS"} else {"FAIL"}))
    println("[F3] context bounded  : " + (if f3 {"PASS"} else {"FAIL"}))
    if f1 && f2 && f3 {
        println("h1261_akida_model_fusion: PASS 🟢 — AKIDA(neuromorphic) ⊗ MODEL(언어) 동시 융합 "
            + "(AND-게이트 2키, EEG 없는 페어), 각 기질 기여, Ψ byte-identical. 3-외부기질 융합 "
            + "그리드 완성 (페어 3 + 트리플 1 = 7/7).")
    } else {
        println("h1261_akida_model_fusion: FAIL 🔴")
    }
}
