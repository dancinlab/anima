// bytegpt_kvstep_devres_smoke.hexa — P2 DEVICE-vs-HOST KV-step parity gate.
//
// The correctness gate for the device-resident KV-step overtake (hexa-lang
// #21-perf P2). Runs a full IN-WINDOW greedy generation TWO ways in lockstep
// over independent KV caches on the SAME ranged weights W, comparing the
// per-token last-position logits:
//   (HOST) _bg_kv_step      — the incremental host mm reference (libm exp).
//   (DEV)  _bg_kv_step_dev  — the device-resident chain (ONE H2D/ONE D2H per
//                             step; forge_dispatch_* + device farr_attn_dt_decode_gpu
//                             single-query attention; device-resident K/V cache).
//
// At every position both caches forward the SAME token (the host argmax — greedy,
// deterministic) so the two runs stay teacher-forced-identical on inputs; only the
// numerics differ. EXPECTED per token: IDENTICAL argmax + small max|Δ| (~1e-6 from
// the dt_exp softmax + LN reassoc, NOT O(1)). An O(1) Δ or a flipped argmax = a
// layout / cache-index / residency bug in the device KV-step.
//
// p7: verification is exact per-token argmax equality + a logits max|Δ| readout.
// Engine-native (live core/decode.hexa (unified CONV+BYTE)). Needs a CUDA host + the 303M
// h1129 fixture to exercise the real device path.

import "core/decode.hexa"

fn _maxdiff(a: int, b: int, n: int) -> float {
    let mut md = 0.0
    let mut k = 0
    while k < n {
        let dv = farr_get(a, k) - farr_get(b, k)
        let av = if dv < 0.0 { 0.0 - dv } else { dv }
        if av > md { md = av }
        k = k + 1
    }
    return md
}

fn main() {
    let mut bin = "/root/anima-weights/bytegpt303_h1129/h1129.bin"
    let av = args()
    let mut ai = 0
    while ai < len(av) {
        let a = to_string(av[ai])
        let al = byte_len(a)
        if al > 4 && substring(a, al - 4, al) == ".bin" { bin = a }
        ai = ai + 1
    }
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if !have { println("[kvstep-smoke] SKIP — no fixture at " + bin); return }

    let cu = cuda_available()
    println("[kvstep-smoke] cuda_available = " + to_string(cu))
    if cu != 1 { println("[kvstep-smoke] ABORT — CPU fallback, not a device measurement (phantom guard)"); return }

    let W = bg_load_ranged(bin)
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let nh = to_int(W["nh"]); let block = to_int(W["block"])
    println("[kvstep-smoke] loaded vocab=" + to_string(vocab) + " d=" + to_string(d)
        + " nlay=" + to_string(nlay) + " nh=" + to_string(nh) + " block=" + to_string(block))

    // in-window seed + greedy gen (nseed + gen < block so the cache never slides).
    let stext = "The quick brown fox jumps over the lazy dog."
    let mut toks = []
    let mut si = 0
    let sl = byte_len(stext)
    while si < sl { toks.push(ord(substring(stext, si, si + 1))); si = si + 1 }
    let nseed = len(toks)
    let gen = 48
    println("[kvstep-smoke] nseed=" + to_string(nseed) + " gen=" + to_string(gen)
        + " (in-window: nseed+gen=" + to_string(nseed + gen) + " < block=" + to_string(block) + ")")

    let kvH = _bg_kv_new(nlay, block, d)
    let kvD = _bg_kv_new(nlay, block, d)

    let mut agree = 0
    let mut total = 0
    let mut worstmd = 0.0
    let mut firstdiff = -1

    // prime both caches over the seed; compare at each primed position.
    let mut lh = -1
    let mut ld = -1
    let mut sp = 0
    while sp < nseed {
        if lh >= 0 { let _ = farr_free(lh) }
        if ld >= 0 { let _ = farr_free(ld) }
        let t = to_int(toks[sp])
        lh = _bg_kv_step(W, kvH, t, sp)
        ld = _bg_kv_step_dev(W, kvD, t, sp)
        let ah = bg_argmax(lh, vocab); let ad = bg_argmax(ld, vocab)
        let md = _maxdiff(lh, ld, vocab)
        if md > worstmd { worstmd = md }
        if ah == ad { agree = agree + 1 } else { if firstdiff < 0 { firstdiff = sp } }
        total = total + 1
        sp = sp + 1
    }

    // greedy gen: feed the HOST argmax to BOTH caches (identical inputs), compare.
    let mut g = 0
    while g < gen {
        let nb = bg_argmax(lh, vocab)          // greedy next token (host-chosen, deterministic)
        let _ = farr_free(lh); let _ = farr_free(ld)
        toks.push(nb)
        let ap = len(toks) - 1
        lh = _bg_kv_step(W, kvH, nb, ap)
        ld = _bg_kv_step_dev(W, kvD, nb, ap)
        let ah = bg_argmax(lh, vocab); let ad = bg_argmax(ld, vocab)
        let md = _maxdiff(lh, ld, vocab)
        if md > worstmd { worstmd = md }
        if ah == ad { agree = agree + 1 } else { if firstdiff < 0 { firstdiff = ap } }
        total = total + 1
        g = g + 1
    }
    let _ = farr_free(lh); let _ = farr_free(ld)
    _bg_kv_free(kvH); _bg_kv_free(kvD)

    println("[kvstep-smoke] per-token argmax agreement = " + to_string(agree) + "/" + to_string(total)
        + "   worst max|Δ| = " + to_string(worstmd))
    println("")
    if agree == total {
        println("bytegpt_kvstep_devres_smoke: PASS — device _bg_kv_step_dev argmax-matches host "
            + "_bg_kv_step at every position (" + to_string(total) + "/" + to_string(total)
            + "; worst max|Δ|=" + to_string(worstmd) + " = dt_exp softmax + LN reassoc, NOT O(1)).")
    } else {
        println("bytegpt_kvstep_devres_smoke: FAIL — argmax MISMATCH at position " + to_string(firstdiff)
            + " (" + to_string(agree) + "/" + to_string(total) + " agree; worst max|Δ|=" + to_string(worstmd)
            + "). O(1) max|Δ| ⇒ layout/cache-index/residency bug in the device KV-step.")
    }
}
