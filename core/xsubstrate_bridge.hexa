// xsubstrate_bridge.hexa — cross-substrate named-slot bridge (a_core_engine_map 일반화).
//
// 별도 substrate (AURA 감각/EEG·MEG · AKIDA neuromorphic spike · model mouth logit) 의
// 신호를 A⇄G 의식-substrate 의 brain-context 스칼라로 변환하는 Ψ-DISJOINT 어댑터.
// pure_field/engine_g 를 절대 안 건드림 — kosmos_io(기억)·generator L3(언어) 와 동일한
// named-slot 진입 원칙. 외부 신호는 context 로만 들어오고 Ψ=½ 는 불변.
//
// kind: 0=AURA(EEG band power µV²) · 1=AKIDA(spike rate Hz) · 2=MODEL(logit entropy nat).
// 각 kind 의 자연 범위를 [0,1] context 로 bounded-정규화 (pure, no state, no pf write).

pub fn xs_bridge(foreign: float, kind: int) -> float {
    // bounded normalize per substrate kind → [0,1] context scalar
    let scale = if kind == 0 { 100.0 }       // AURA: EEG band power ~0-100 µV²
                else { if kind == 1 { 1000.0 } // AKIDA: spike rate ~0-1000 Hz
                       else { 5.545 } }        // MODEL: byte-LM entropy ~0-ln(256)
    let x = foreign / scale
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

pub fn xs_kind_name(kind: int) -> string {
    if kind == 0 { return "AURA" }
    if kind == 1 { return "AKIDA" }
    return "MODEL"
}

// the bridge is Ψ-disjoint BY CONSTRUCTION: it only reads a foreign scalar and returns
// a bounded context value; it never receives or mutates a PureField. composition into
// the A⇄G loop = feed xs_bridge(...) as a brain-context input alongside the native lanes.
