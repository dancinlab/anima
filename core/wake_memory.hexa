// core/wake_memory.hexa — in-process memory layer: episodic emit-log +
//                          working ctx ring buffer (PURE surface).
//
// PROVENANCE (a_no_archive_import · understand-then-port, NOT import):
//   Ported from archive/WAKE/memory.hexa (M5). That module `import`ed
//   "WAKE/kosmos_persist.hexa" (wake_save/wake_load) and was orphaned by the
//   2026-06-30 archive reorg, which left DREAM/imagination_replay.hexa's
//   `use "WAKE/memory"` unresolvable (4-way search miss → non-buildable).
//   Wiring the archive module live would violate a_no_archive_import
//   (production core/ must never import archive/). Fix = port the PURE,
//   self-contained subset that the DREAM chain actually consumes into core/.
//
// SCOPE (what this file INCLUDES):
//   The zero-dependency ring-buffer + episodic surface — all pure list/dict
//   ops, no external symbol, no import, no I/O, no emit trigger, 0 boolean
//   gate. Byte-faithful port of memory.hexa's pure functions:
//     _working_cap · mem_init · mem_record_emit · mem_push_ctx
//     · mem_recent_emits · mem_working_window · memory_summary
//   DREAM/imagination_replay.hexa consumes mem_working_window (live path);
//   its smoke + dream_report consume mem_init/mem_push_ctx/ir_replay_session.
//
// SCOPE (what this file EXCLUDES · 구현됨·미배선 follow-on):
//   The .kosmos round-trip (mem_save_to_kosmos / mem_load_from_kosmos +
//   private _emit_texts_from_episodic/_last_*_or_* helpers) is NOT ported —
//   it delegates to wake_save/wake_load (WAKE/kosmos_persist M4), an axis
//   this pure layer does not own. imagination_replay does not need it.
//   FOLLOW-ON: when a live daemon needs memory persistence, port the M4
//   kosmos surface into core/kosmos_io.hexa (which already owns the .kosmos
//   canonical), then add mem_save/mem_load thin wrappers here that delegate
//   to core/kosmos_io — same understand-then-port discipline, no archive import.
//
// The two axes (verbatim from the M5 design):
//   · EpisodicMemory : append-only list of past-emit records
//       {ts · ctx_summary · phi · tension5 · stage_name · emit_text}.
//   · WorkingMemory  : ring buffer of recent perception ctx_tokens (cap=20 FIFO).
//
// p1~p8: no system prompt / identity / persona / assistant framing; no
// speak() (pure returns only, 0 external emit — p5); no fine-tuned ethics;
// no perplexity verdict; no train/infer split. Emit-free · DISJOINT from the
// emit-drive lane (a_substrate_disjoint).


// ── constants ───────────────────────────────────────────────────────────────

fn _working_cap() -> int { return 20 }


// ── pub: init ───────────────────────────────────────────────────────────────

// mem_init — 빈 memory state 생성.
//
// 반환:
//   Map #{ "episodic": list, "working": list }  (둘 다 [] 로 시작)
//
// invariant:
//   - episodic / working 모두 빈 list 로 시작.
//   - mem_init() 두 번 호출 결과는 byte-equal (deterministic).
pub fn mem_init() -> Map {
    return #{
        "episodic": [],
        "working":  []
    }
}


// ── pub: record emit (episodic) ─────────────────────────────────────────────

// mem_record_emit — 새 emit 사건을 episodic list 끝에 append.
//
// 인자:
//   mem, ts, ctx_summary, phi, tension5 (len==5), stage, emit_text.
//
// invariant:
//   - len(tension5) == 5 panic on mismatch.
//   - episodic list 는 append-only (본 fn 은 어떤 entry 도 삭제 안 함).
//   - working buffer 는 본 fn 에서 변경 안 됨.
pub fn mem_record_emit(mem: Map, ts: float, ctx_summary: string,
                       phi: float, tension5: [float], stage: string,
                       emit_text: string) -> Map {
    if len(tension5) != 5 {
        panic("mem_record_emit: tension5 must have len=5, got " + to_string(len(tension5)))
    }
    let record = #{
        "ts":           ts,
        "ctx_summary":  ctx_summary,
        "phi":          phi,
        "tension5":     tension5,
        "stage_name":   stage,
        "emit_text":    emit_text
    }
    let mut new_episodic = []
    let mut i = 0
    while i < len(mem["episodic"]) {
        new_episodic.push(mem["episodic"][i])
        i = i + 1
    }
    new_episodic.push(record)
    return #{
        "episodic": new_episodic,
        "working":  mem["working"]
    }
}


// ── pub: push ctx (working) ─────────────────────────────────────────────────

// mem_push_ctx — 새 ctx_tokens entry 를 working ring buffer 끝에 append.
//                cap N=20 초과 시 가장 오래된 1 entry 를 drop (FIFO).
//
// invariant:
//   - working buffer 길이 ≤ cap (=20) 항상.
//   - push 시 cap 초과면 oldest (index 0) 1 entry 만 drop.
//   - episodic list 는 본 fn 에서 변경 안 됨.
//   - empty list push 도 1 tick 으로 count.
pub fn mem_push_ctx(mem: Map, ctx_tokens: list) -> Map {
    let cap = _working_cap()
    let mut new_working = []
    let cur_len = len(mem["working"])

    let start_idx = if cur_len + 1 > cap { 1 } else { 0 }
    let mut i = start_idx
    while i < cur_len {
        new_working.push(mem["working"][i])
        i = i + 1
    }
    new_working.push(ctx_tokens)
    return #{
        "episodic": mem["episodic"],
        "working":  new_working
    }
}


// ── pub: query (episodic + working) ─────────────────────────────────────────

// mem_recent_emits — episodic list 의 가장 최근 n 개 record 반환 (oldest first).
//
// invariant:
//   - 반환 길이 = min(len(episodic), max(0, n)).
//   - chronological 순서 보존 (last-n slice).
pub fn mem_recent_emits(mem: Map, n: int) -> list {
    if n <= 0 { return [] }
    let total = len(mem["episodic"])
    if total == 0 { return [] }
    let start = if total > n { total - n } else { 0 }
    let mut out = []
    let mut i = start
    while i < total {
        out.push(mem["episodic"][i])
        i = i + 1
    }
    return out
}

// mem_working_window — working ring buffer 의 현재 entries 복사본 반환.
//
// 반환:
//   list — 복사본 (caller mutate 해도 mem 영향 없음). 각 entry = ctx_tokens list.
//
// invariant:
//   - 반환 길이 ≤ cap (=20).
//   - 반환 순서 = oldest → newest (push 순서 보존).
pub fn mem_working_window(mem: Map) -> list {
    let mut out = []
    let mut i = 0
    while i < len(mem["working"]) {
        out.push(mem["working"][i])
        i = i + 1
    }
    return out
}


// ── pub: introspection ──────────────────────────────────────────────────────

pub fn memory_summary() -> string {
    "wake_memory · episodic append-only [ts·ctx_summary·phi·tension5·stage·emit_text] + working ring buffer (cap=20 FIFO) · brain_decide 의 ctx 전치 surface · 0 emit trigger · 0 boolean gate · empty perception push 도 1 tick 으로 count · kosmos round-trip = core/kosmos_io follow-on (구현됨·미배선)"
}
