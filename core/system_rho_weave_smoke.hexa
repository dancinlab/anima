// system_g1_smoke.hexa — ENGINE-NATIVE proof of the system ρ·weave relocation pipe
// (ρ·weave = recombination wall · frozen bar = former G1 · H_1129; the `system_g1` name is the frozen-bar identifier)
// (card H_9035 · rung 2 of the a_verified_must_wire ladder).
//
//   Compiles + RUNS the live `core/kosmos_io.hexa kosmos_merge` (recursive
//   labeled-parent bind) and the bind-RECOVERABILITY discriminator on a TOY
//   substrate — NO 303M mouth (that is the explicit-go pool follow-on).
//
//   What this proves (engine-native, not numpy):
//     (A) kosmos_merge binds two anchors → a composite C that PRESERVES both
//         parents as children, means the two 5-ch tensions, midpoints the coord,
//         lanes "recomb", and produces a dense embedding via the existing
//         tension_5ch_to_embedding projector (so C is retrievable via `retrieve`).
//     (B) the RECOVERABILITY gate DISCRIMINATES: an independent recoverer R that
//         reads ONLY the SURFACED tokens of C (the store's parent-ids HARD-BLOCKED)
//         recovers BOTH parents as top-2 for the ARM-COMPOSITIONAL mouth, and FAILS
//         for the ARM-MOUTHFLOOR mouth (which surfaces only the dominant concept) —
//         + a SCRAMBLE ablation collapses recovery (proves R reads compositional
//         bigram STRUCTURE, not bag-of-words — the C2 lens that killed H_6152).
//
//   This is the ENGINE-NATIVE version of state/system_g1_relocate_kosmos_merge/
//   system_g1_harness.py (numpy = DIRECTIONAL). The TOY here is HARNESS-VALIDATION
//   scope (small lexicon, scaled bars) — NOT the frozen 303M bar in FREEZE.txt,
//   which is byte-unchanged. A GREEN verdict still needs the real 303M mouth on
//   pool (`anima evaluate --py <clm> --system-g1`), NOT run here (mini = OOM).
//
//   Deterministic (p7: verification is flag/count equality, not perplexity).

import "core/kosmos_io.hexa"


// ── toy concept lexicon: disjoint vocabularies (DISTANT by construction) ─────
fn _cg_concepts() -> map {
    return #{
        "ocean":  ["tide", "salt", "wave", "deep"],
        "forest": ["moss", "branch", "fern", "canopy"],
        "engine": ["piston", "fuel", "gear", "torque"],
        "music":  ["chord", "tempo", "melody", "rhythm"],
    }
}

// 4 held-out DISTANT pairs (any two distinct concepts = disjoint vocab).
fn _cg_pairs() -> list {
    return [["ocean", "engine"], ["forest", "music"],
            ["ocean", "music"],  ["forest", "engine"]]
}

// scaled toy bars (harness-validation scope, NOT the frozen 24-pair bar).
fn _cg_M() -> int { return 4 }
fn _cg_bar() -> int { return 2 }         // M/2 for cov / rec / scramble-drop


// ── Stage M: TOY frozen mouth — single-concept ordered signature phrase ──────
// tok0 "and" tok1 tok2 "and" tok3  → internal signature bigrams (order-sensitive).
fn _cg_ideate_single(concepts: map, name: string) -> [string] {
    let s = concepts[name]
    return [s[0], "and", s[1], s[2], "and", s[3]]
}

// Stage B: mouth realizes the JOINT utterance C from the merged composite.
//   compositional — block-concat both parent fragments + a joint connector.
//   mouthfloor    — surface ONLY the dominant (first) concept (models the real
//                   eval_rho_weave floor where composed coverage never beats max_single).
fn _cg_realize_joint(arm: string, frag_a: [string], frag_b: [string]) -> [string] {
    if arm == "compositional" {
        let mut out = []
        let mut i = 0
        while i < len(frag_a) { out.push(frag_a[i]); i = i + 1 }
        out.push("then")
        let mut j = 0
        while j < len(frag_b) { out.push(frag_b[j]); j = j + 1 }
        return out
    }
    return frag_a
}


// ── bigram bag = parallel (keys, vals) lists (order-sensitive embedding) ─────
fn _cg_bigram_bag(toks: [string]) -> map {
    let mut ks = []
    let mut vs = []
    let mut i = 0
    while i + 1 < len(toks) {
        let key = toks[i] + "|" + toks[i + 1]
        let mut found = -1
        let mut j = 0
        while j < len(ks) {
            if ks[j] == key { found = j; break }
            j = j + 1
        }
        if found >= 0 { vs[found] = vs[found] + 1.0 } else { ks.push(key); vs.push(1.0) }
        i = i + 1
    }
    return #{ "keys": ks, "vals": vs }
}

fn _cg_bag_cos(a: map, b: map) -> float {
    let ak = a["keys"]; let av = a["vals"]
    let bk = b["keys"]; let bv = b["vals"]
    let mut dot = 0.0
    let mut i = 0
    while i < len(ak) {
        let mut j = 0
        while j < len(bk) {
            if to_string(ak[i]) == to_string(bk[j]) { dot = dot + to_float(av[i]) * to_float(bv[j]) }
            j = j + 1
        }
        i = i + 1
    }
    let mut na = 0.0; let mut x = 0
    while x < len(av) { na = na + to_float(av[x]) * to_float(av[x]); x = x + 1 }
    let mut nb = 0.0; let mut y = 0
    while y < len(bv) { nb = nb + to_float(bv[y]) * to_float(bv[y]); y = y + 1 }
    return dot / (sqrt(na) * sqrt(nb) + 1.0e-9)
}

// deterministic Fisher-Yates shuffle (reuse kosmos_io _ki_lcg_next).
fn _cg_shuffle(xs: [string], seed: int) -> [string] {
    let mut a = []
    let mut i = 0
    while i < len(xs) { a.push(xs[i]); i = i + 1 }
    let mut state = seed & 0xFFFFFFFF
    let mut k = len(a) - 1
    while k > 0 {
        state = _ki_lcg_next(state)
        let r = state % (k + 1)
        let tmp = a[k]; a[k] = a[r]; a[r] = tmp
        k = k - 1
    }
    return a
}

// coverage: # of the two concepts whose ANY signature token appears in C.
fn _cg_coverage(concepts: map, toks: [string], a: string, b: string) -> int {
    let names = [a, b]
    let mut cov = 0
    let mut n = 0
    while n < len(names) {
        let sig = concepts[names[n]]
        let mut hit = false
        let mut s = 0
        while s < len(sig) {
            let mut t = 0
            while t < len(toks) {
                if to_string(toks[t]) == to_string(sig[s]) { hit = true }
                t = t + 1
            }
            s = s + 1
        }
        if hit { cov = cov + 1 }
        n = n + 1
    }
    return cov
}

// INDEPENDENT recoverer R — reads ONLY C's tokens (parent-ids HARD-BLOCKED);
// returns count of the two parents recovered as top-2 over a distractor pool.
fn _cg_recover_count(concepts: map, C: [string], pool: [string],
                     a: string, b: string, scramble: bool, seed: int) -> int {
    let mut toks = C
    if scramble { toks = _cg_shuffle(C, seed) }
    let cbag = _cg_bigram_bag(toks)
    // score each pool concept by cosine over signature bigrams.
    let mut best1 = -1.0; let mut n1 = ""
    let mut best2 = -1.0; let mut n2 = ""
    let mut i = 0
    while i < len(pool) {
        let sig = concepts[pool[i]]
        let sc = _cg_bag_cos(cbag, _cg_bigram_bag(sig))
        if sc > best1 {
            best2 = best1; n2 = n1
            best1 = sc; n1 = pool[i]
        } else if sc > best2 {
            best2 = sc; n2 = pool[i]
        }
        i = i + 1
    }
    // a parent counts as recovered ONLY if it is top-2 AND has POSITIVE structural
    // (bigram) similarity — a zero-cosine tie is a coin flip, not a recovery. This
    // makes MOUTHFLOOR (b absent from C ⇒ cos=0) and SCRAMBLE (bigrams destroyed)
    // robustly FAIL, instead of leaking a parent via pool order.
    let eps = 1.0e-6
    let mut got = 0
    if (n1 == a && best1 > eps) || (n2 == a && best2 > eps) { got = got + 1 }
    if (n1 == b && best1 > eps) || (n2 == b && best2 > eps) { got = got + 1 }
    return got
}

// distractor pool = [a, b] + the other two concepts (N_pool = 4).
fn _cg_pool(a: string, b: string) -> [string] {
    let all = ["ocean", "forest", "engine", "music"]
    let mut pool = [a, b]
    let mut i = 0
    while i < len(all) {
        if all[i] != a && all[i] != b { pool.push(all[i]) }
        i = i + 1
    }
    return pool
}

// build a toy anchor (name + 5-ch tension + coord) from a concept.
fn _cg_anchor(name: string, x: float, y: float, t0: float) -> map {
    return #{
        "name":        name,
        "coord":       [x, y],
        "tension_5ch": [t0, t0 / 2.0, t0 / 3.0, t0 / 4.0, t0 / 5.0],
    }
}


// ── run one mouth arm over all pairs ────────────────────────────────────────
fn _cg_run_arm(arm: string) -> map {
    let concepts = _cg_concepts()
    let pairs = _cg_pairs()
    let mut cov_pass = 0
    let mut rec_pass = 0
    let mut scr_pass = 0
    let mut p = 0
    while p < len(pairs) {
        let a = pairs[p][0]
        let b = pairs[p][1]
        let seed = 7 + p

        // Stage M — frozen single-concept fragments (max_single coverage = 1).
        let frag_a = _cg_ideate_single(concepts, a)
        let frag_b = _cg_ideate_single(concepts, b)

        // Stage K — LIVE kosmos_merge (store keeps A,B as children).
        let anc_a = _cg_anchor(a, to_float(p), 0.0, 0.9)
        let anc_b = _cg_anchor(b, 0.0, to_float(p), 0.4)
        let comp = kosmos_merge(anc_a, anc_b)
        let kids = comp["children"]

        // Stage B — mouth surfaces the joint C from the composite's children.
        let ca = kids[0]
        let cb = kids[1]
        let C = _cg_realize_joint(arm, _cg_ideate_single(concepts, to_string(ca["name"])),
                                       _cg_ideate_single(concepts, to_string(cb["name"])))

        let cov = _cg_coverage(concepts, C, a, b)
        if cov >= 2 { cov_pass = cov_pass + 1 }

        // Recovery R — reads ONLY C; parent-ids in `comp["children"]` withheld.
        let pool = _cg_pool(a, b)
        let rec = _cg_recover_count(concepts, C, pool, a, b, false, seed)
        let scr = _cg_recover_count(concepts, C, pool, a, b, true, seed)
        if rec >= 2 { rec_pass = rec_pass + 1 }
        if scr >= 2 { scr_pass = scr_pass + 1 }
        p = p + 1
    }
    let sdrop = rec_pass - scr_pass
    let bar = _cg_bar()
    let passed = cov_pass >= bar && rec_pass >= bar && sdrop >= bar
    return #{ "coverage": cov_pass, "recovery": rec_pass, "scramble_rec": scr_pass,
              "drop": sdrop, "pass": passed }
}

fn _cg_fmt(tag: string, s: map) -> string {
    let m = _cg_M(); let bar = _cg_bar()
    return "  " + tag
        + "  coverage=" + to_string(s["coverage"]) + "/" + to_string(m)
        + " recovery=" + to_string(s["recovery"]) + "/" + to_string(m)
        + " scramble_rec=" + to_string(s["scramble_rec"]) + "/" + to_string(m)
        + " drop=" + to_string(s["drop"]) + " (bar>=" + to_string(bar) + ")"
        + " => " + (if to_bool(s["pass"]) { "PASS" } else { "FAIL" })
}


fn main() {
    println("==============================================================================")
    println("system ρ·weave (former G1) ENGINE-NATIVE smoke (core/kosmos_io.hexa kosmos_merge + recoverability)")
    println("  card H_9035 · rung 2 · TOY harness-validation (NOT frozen 303M bar / FREEZE.txt)")
    println("==============================================================================")

    // ── (A) kosmos_merge structural proof ───────────────────────────────────
    let anc_a = _cg_anchor("ocean",  1.0, 0.0, 0.9)
    let anc_b = _cg_anchor("engine", 0.0, 1.0, 0.4)
    let c = kosmos_merge(anc_a, anc_b)
    let kids = c["children"]
    let t = c["tension_5ch"]
    let coord = c["coord"]
    let emb = c["embedding"]
    println("(A) kosmos_merge(ocean, engine) ->")
    println("      name       = " + to_string(c["name"]))
    println("      lane       = " + to_string(c["lane"]) + "   (recomb; DISJOINT from emit-drive {0,4})")
    println("      children   = [" + to_string(kids[0]["name"]) + ", " + to_string(kids[1]["name"])
            + "]   (recursive labeled-parent bind — parents preserved)")
    println("      mean t[0]  = " + to_string(t[0]) + "   (= (0.9+0.4)/2 = 0.65)")
    println("      coord      = [" + to_string(coord[0]) + ", " + to_string(coord[1]) + "]   (midpoint of parents)")
    println("      embed_dim  = " + to_string(len(emb)) + "   (tension_5ch_to_embedding reuse → retrievable via retrieve)")

    // reuse-proof: persist C via create_anchor and retrieve it back by its own tension.
    let dir = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let _path = create_anchor(dir, "recomb_ocean_engine", "recomb ocean+engine",
        coord[0], coord[1], to_string(c["lane"]), 0.15, 1,
        "recombination", "neutral", "surfaced-downstream", t, "system-g1-merge", "")
    let anchors = load_anchors(dir)
    let hits = retrieve(t, anchors, 1)
    let top = hits[0][0]
    println("      retrieve   = top-1 '" + to_string(top["name"]) + "' lane='" + to_string(top["fields"]["lane"])
            + "'   (create_anchor + retrieve reuse OK)")
    println("")

    // ── (B) recoverability discriminator ────────────────────────────────────
    let sc = _cg_run_arm("compositional")
    let sf = _cg_run_arm("mouthfloor")
    println("(B) bind-RECOVERABILITY on the SURFACED C (parent-ids HARD-BLOCKED):")
    println(_cg_fmt("ARM-COMPOSITIONAL", sc))
    println(_cg_fmt("ARM-MOUTHFLOOR   ", sf))
    let harness_valid = to_bool(sc["pass"]) && !to_bool(sf["pass"])
    println("------------------------------------------------------------------------------")
    println("  HARNESS-VALID (credits composition ∧ rejects mouth-floor): " + to_string(harness_valid))
    println("  DISCRIMINATOR FIRES: COMPOSITIONAL=" + (if to_bool(sc["pass"]) { "PASS" } else { "FAIL" })
            + "  MOUTHFLOOR=" + (if to_bool(sf["pass"]) { "PASS" } else { "FAIL" }))
    println("  VERDICT: ENGINE-NATIVE (hexa kosmos_merge live) — GREEN still needs the real")
    println("           303M mouth on pool (anima evaluate --py <clm> --system-g1; mini=OOM).")
    println("==============================================================================")
}
