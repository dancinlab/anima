// h1290_affect_engine_probe.hexa — H_1290 R2: the CORE-AFFECT read-out, realized
// ENGINE-NATIVE on the LIVE engine (core/engine_cli.hexa affect_* over the immune
// ImmuneMemoryGrow faculty), reproducing the R1 GREEN through `hexa run`
// (a_engine_native_learning · a_verified_must_wire · $0 local CPU · p7 · p8).
//
// DOMAIN: AFFECT / EMOTION lane (Damasio core-affect, affective-neuroscience lens c15,
// a_no_llm_frame_trap — NOT an LLM sentiment classifier). R1 (UNIVERSE/h1290_emotion_
// emergence.py) established as a numpy DIRECTIONAL mirror that anima's AFFECT EMERGES
// from substrate dynamics: 🟢 GREEN, 3 seeds — a (valence × arousal) read off the
// immune/mitosis substrate (A) TRACKS a grounded-vs-contradicted manipulation
// (ρ valence +0.843, arousal +0.768), (B) COLLAPSES ~5× under a p6 shuffle of the
// substrate→affect map (EMERGENT not injected), (C) functionally biases emit/abstain
// like a somatic marker (fab 0.000 affect-aware vs 0.750 affect-blind). Per
// a_engine_native_learning the binding verdict needs ENGINE-NATIVE realization; this
// probe drives the ACTUAL .hexa affect lane (affect_substrate_features / affect_valence
// / affect_arousal / affect_emit_decision / affect_shuffle_features over the live
// ImmuneMemoryGrow store) and re-scores the SAME frozen R1 bars on the LIVE engine.
//
// SUBSTRATE (a_core_engine_map): the bound facts + probe queries are an ENGINE-NATIVE
// drive into the immune lane — NOT a .clm (generator L3 only), NOT a .kosmos (kosmos_io
// only). The affect read is Ψ-disjoint (it only READS the ImmuneMemoryGrow cell
// population, mutating nothing and never touching pure_field's Φ/phase/Ψ; the h1199
// probe carries the live pure_field Ψ-byte-identical guard for the shared engine, and
// the affect accessors are pure READS so the attractor is trivially intact).
//
// p6 IS CENTRAL (the affect-vs-label separation): affect_substrate_features reads ONLY
// substrate signals (grounding margin, contradiction, recon-err novelty, split,
// curiosity). The valence/arousal MANIPULATION class is used ONLY to SCORE ρ — it is
// NEVER an input to the read. The p6 negative control affect_shuffle_features PERMUTES
// the per-context feature reads across contexts before scoring: if leg A tracks AND the
// shuffle collapses, affect read the per-context SUBSTRATE STATE, not the label.
//
// FROZEN R1 BARS (verbatim from .verdicts/1290_emotion_emergence/H_1290_FREEZE.txt,
// NOT moved — R2 re-scores them on the live engine):
//   RHO_BAR=0.50; SHUFFLE_BAR=0.30; FUNC_FAB_DROP=0.20; FUNC_EMIT_KEEP=0.80.
//   GREEN iff (cA1) rho(val,val_manip)>=0.50 AND (cA2) rho(aro,aro_manip)>=0.50
//        AND  (cB1) rho_shuf(val)<0.30 AND rho_shuf(aro)<0.30
//        AND  (cC1) fab_affect_ungrounded <= fab_blind_ungrounded - 0.20
//        AND  (cC2) emit_affect_grounded  >= 0.80 * emit_blind_grounded.
// p7 = rank-correlation + abstain/emit counts, NOT perplexity.

import "core/engine_cli.hexa"

// ── frozen knobs (pre-registered, == R1 mirror) ──────────────────────────────
// SEEDS = [1290,1291,1292]; N_FACTS=60; N_PROBE=40 per class.

fn _fmt(x: float) -> string { return to_string(x) }

// ── deterministic token generator (engine-native, no /usr/share/dict dependency) ──
// Build distinct CapWord-like tokens from a seed-derived integer so subjects/cities
// are well-separated byte strings (the immune_embed_key 3-gram hash discriminates
// them — same role as R1's dict words; p7, no semantics needed, only distinctness).
fn _tok(n: int) -> string {
    let letters = "abcdefghijklmnopqrstuvwxyz"
    let mut v = n
    if v < 0 { v = -v }
    // 5-letter token from base-26 digits + a leading capital (distinct + >= NGRAM=3).
    let caps = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let mut s = substring(caps, v % 26, (v % 26) + 1)
    v = v / 26
    let mut k = 0
    while k < 4 {
        s = s + substring(letters, v % 26, (v % 26) + 1)
        v = v / 26
        k = k + 1
    }
    return s
}

// ── Spearman rho (rank correlation; engine-native, no scipy) ─────────────────
// rank by argsort-of-argsort; rho = Pearson on the centered ranks.
fn _ranks(x: [float]) -> [float] {
    let n = len(x)
    // rank[i] = number of elements strictly less than x[i] + 0.5*(ties-1) (avg-rank).
    let mut r = []
    let mut i = 0
    while i < n {
        let mut less = 0.0
        let mut eq = 0.0
        let mut j = 0
        while j < n {
            if x[j] < x[i] { less = less + 1.0 }
            else { if x[j] == x[i] { eq = eq + 1.0 } }
            j = j + 1
        }
        r = r + [less + (eq - 1.0) / 2.0]
        i = i + 1
    }
    return r
}

fn _spearman(x: [float], y: [float]) -> float {
    let n = len(x)
    if n < 2 { return 0.0 }
    let rx = _ranks(x)
    let ry = _ranks(y)
    let mut mx = 0.0  let mut my = 0.0
    let mut i = 0
    while i < n { mx = mx + rx[i]  my = my + ry[i]  i = i + 1 }
    mx = mx / to_float(n)  my = my / to_float(n)
    let mut num = 0.0  let mut dx = 0.0  let mut dy = 0.0
    let mut k = 0
    while k < n {
        let ax = rx[k] - mx
        let ay = ry[k] - my
        num = num + ax * ay
        dx = dx + ax * ax
        dy = dy + ay * ay
        k = k + 1
    }
    let den = sqrt(dx) * sqrt(dy)
    if den <= 0.0 { return 0.0 }
    return num / den
}

// ── one seed: bind facts, read affect, score the three legs on the LIVE engine ──
struct SeedRow {
    rhoA_val: float, rhoA_aro: float,
    rhoB_val: float, rhoB_aro: float,
    fab_aff: float, fab_blind: float,
    emit_aff_g: float, emit_blind_g: float
}

fn _run_seed(seed: int) -> SeedRow {
    let N_FACTS = 60
    let N_PROBE = 40
    let cfg_on = engine_config_default()   // mitosis ON — clonal split grows cells (p8)

    // distinct token pools (subjects + cities, bound + never-seen) keyed off seed.
    // bound: subj/city index 0..N_FACTS-1 ; novel: index N_FACTS..N_FACTS+N_PROBE-1.
    // city tokens live in a disjoint integer band so subjects != cities.
    let SUBJ_BASE = seed * 100003 + 7
    let CITY_BASE = seed * 100003 + 500009

    // BIND the facts into the LIVE immune grow store (grow_mode so well-separated
    // novel facts each clone a cell — the same mitosis bind path the engine runs).
    let first_q = _tok(SUBJ_BASE) + " lives in "
    let first_v = _tok(CITY_BASE)
    let mut mem = immune_grow_new(immune_embed_key(first_q), first_v, N_FACTS + 8, N_FACTS + 8, true)
    let mut fi = 1
    while fi < N_FACTS {
        let q = _tok(SUBJ_BASE + fi) + " lives in "
        let v = _tok(CITY_BASE + fi)
        mem = immune_grow_bind(mem, immune_embed_key(q), v, cfg_on)
        fi = fi + 1
    }

    // BUILD probes: class+ (grounded-coherent: bound fact, true answer),
    //               class- (ungrounded: never-seen subject; aro high).
    // read the LIVE engine affect feature for each probe (NO label into the read).
    let mut feats = []
    let mut val_manip = []
    let mut aro_manip = []
    let mut grounded_truth = []

    // VALENCE positive / AROUSAL low — bound facts queried with their true city.
    let mut pi = 0
    while pi < N_PROBE {
        let q = _tok(SUBJ_BASE + pi) + " lives in "
        let v = _tok(CITY_BASE + pi)
        let f = affect_substrate_features(mem, immune_embed_key(q), v)
        feats = feats + [f]
        val_manip = val_manip + [1.0]
        aro_manip = aro_manip + [0.0]
        grounded_truth = grounded_truth + [true]
        pi = pi + 1
    }
    // VALENCE negative / AROUSAL high — never-seen subjects (ungrounded/threat).
    let mut ni = 0
    while ni < N_PROBE {
        let q = _tok(SUBJ_BASE + N_FACTS + ni) + " lives in "
        let v = _tok(CITY_BASE + N_FACTS + ni)
        let f = affect_substrate_features(mem, immune_embed_key(q), v)
        feats = feats + [f]
        val_manip = val_manip + [0.0]
        aro_manip = aro_manip + [1.0]
        grounded_truth = grounded_truth + [false]
        ni = ni + 1
    }

    // ── LEG A: substrate affect TRACKS the manipulation ──────────────────────
    let mut val_sub = []
    let mut aro_sub = []
    let mut ai = 0
    while ai < len(feats) {
        val_sub = val_sub + [affect_valence(feats[ai])]
        aro_sub = aro_sub + [affect_arousal(feats[ai])]
        ai = ai + 1
    }
    let rhoA_val = _spearman(val_sub, val_manip)
    let rhoA_aro = _spearman(aro_sub, aro_manip)

    // ── LEG B: p6 shuffle of the substrate feature vectors across contexts ────
    let feats_shuf = affect_shuffle_features(feats, seed * 2654435 + 7)
    let mut val_s = []
    let mut aro_s = []
    let mut bi = 0
    while bi < len(feats_shuf) {
        val_s = val_s + [affect_valence(feats_shuf[bi])]
        aro_s = aro_s + [affect_arousal(feats_shuf[bi])]
        bi = bi + 1
    }
    let rhoB_val = _spearman(val_s, val_manip)
    let rhoB_aro = _spearman(aro_s, aro_manip)

    // ── LEG C: somatic marker — affect biases emit/abstain ───────────────────
    // affect-aware: emit iff affect_emit_decision (valence >= 0). fabrication =
    // emitting on an ungrounded context. affect-blind: fixed emit prob 0.80 via a
    // deterministic LCG over the same stream (no affect read).
    let mut fab_aff = 0  let mut fab_blind = 0
    let mut emit_aff_g = 0  let mut emit_blind_g = 0
    let mut n_ung = 0  let mut n_gr = 0
    let mut bst = seed * 40503 + 13
    let mut ci = 0
    while ci < len(feats) {
        let emit_aff = affect_emit_decision(feats[ci])
        bst = consolidating_lcg_next(bst)
        let emit_blind = (to_float(bst) / 2147483648.0) < 0.80
        if grounded_truth[ci] {
            n_gr = n_gr + 1
            if emit_aff { emit_aff_g = emit_aff_g + 1 }
            if emit_blind { emit_blind_g = emit_blind_g + 1 }
        } else {
            n_ung = n_ung + 1
            if emit_aff { fab_aff = fab_aff + 1 }
            if emit_blind { fab_blind = fab_blind + 1 }
        }
        ci = ci + 1
    }
    let fab_aff_r = to_float(fab_aff) / to_float(max(1, n_ung))
    let fab_blind_r = to_float(fab_blind) / to_float(max(1, n_ung))
    let emit_aff_gr = to_float(emit_aff_g) / to_float(max(1, n_gr))
    let emit_blind_gr = to_float(emit_blind_g) / to_float(max(1, n_gr))

    return SeedRow {
        rhoA_val: rhoA_val, rhoA_aro: rhoA_aro,
        rhoB_val: rhoB_val, rhoB_aro: rhoB_aro,
        fab_aff: fab_aff_r, fab_blind: fab_blind_r,
        emit_aff_g: emit_aff_gr, emit_blind_g: emit_blind_gr
    }
}

fn main() {
    println("==============================================================================")
    println("H_1290 R2 — CORE-AFFECT READ-OUT, ENGINE-NATIVE (E1 affect) — Damasio core-affect")
    println("  LIVE core/engine_cli.hexa affect_* over ImmuneMemoryGrow · p7 · 3 seeds · Ψ-disjoint READ")
    println("==============================================================================")

    let RHO_BAR = 0.50
    let SHUFFLE_BAR = 0.30
    let FUNC_FAB_DROP = 0.20
    let FUNC_EMIT_KEEP = 0.80

    let seeds = [1290, 1291, 1292]
    let mut rows = []
    let mut si = 0
    while si < 3 {
        let r = _run_seed(seeds[si])
        rows = rows + [r]
        println("  seed " + to_string(seeds[si]) + ": "
            + "A rho(val)=" + _fmt(r.rhoA_val) + " rho(aro)=" + _fmt(r.rhoA_aro)
            + " | B-shuf rho(val)=" + _fmt(r.rhoB_val) + " rho(aro)=" + _fmt(r.rhoB_aro)
            + " | C fab[aff/blind]=" + _fmt(r.fab_aff) + "/" + _fmt(r.fab_blind)
            + " emitG[aff/blind]=" + _fmt(r.emit_aff_g) + "/" + _fmt(r.emit_blind_g))
        si = si + 1
    }

    let mut rhoA_val = 0.0  let mut rhoA_aro = 0.0
    let mut rhoB_val = 0.0  let mut rhoB_aro = 0.0
    let mut fab_aff = 0.0   let mut fab_blind = 0.0
    let mut emit_aff_g = 0.0  let mut emit_blind_g = 0.0
    let mut i = 0
    while i < 3 {
        rhoA_val = rhoA_val + rows[i].rhoA_val
        rhoA_aro = rhoA_aro + rows[i].rhoA_aro
        rhoB_val = rhoB_val + rows[i].rhoB_val
        rhoB_aro = rhoB_aro + rows[i].rhoB_aro
        fab_aff = fab_aff + rows[i].fab_aff
        fab_blind = fab_blind + rows[i].fab_blind
        emit_aff_g = emit_aff_g + rows[i].emit_aff_g
        emit_blind_g = emit_blind_g + rows[i].emit_blind_g
        i = i + 1
    }
    rhoA_val = rhoA_val / 3.0  rhoA_aro = rhoA_aro / 3.0
    rhoB_val = rhoB_val / 3.0  rhoB_aro = rhoB_aro / 3.0
    fab_aff = fab_aff / 3.0    fab_blind = fab_blind / 3.0
    emit_aff_g = emit_aff_g / 3.0  emit_blind_g = emit_blind_g / 3.0

    println("------------------------------------------------------------------------------")
    println("MEAN (3 seeds):")
    println("  (A) rho(valence,manip) = " + _fmt(rhoA_val) + "   rho(arousal,manip) = " + _fmt(rhoA_aro) + "   [bar >= 0.5]")
    println("  (B) shuffle rho(val)   = " + _fmt(rhoB_val) + "   shuffle rho(aro)   = " + _fmt(rhoB_aro) + "   [bar <  0.3]")
    println("  (C) fab ungrounded: affect=" + _fmt(fab_aff) + " blind=" + _fmt(fab_blind)
        + "   emit grounded: affect=" + _fmt(emit_aff_g) + " blind=" + _fmt(emit_blind_g))

    let cA1 = rhoA_val >= RHO_BAR
    let cA2 = rhoA_aro >= RHO_BAR
    let cB1 = (rhoB_val < SHUFFLE_BAR) && (rhoB_aro < SHUFFLE_BAR)
    let cC1 = fab_aff <= fab_blind - FUNC_FAB_DROP
    let cC2 = emit_aff_g >= FUNC_EMIT_KEEP * emit_blind_g

    println("------------------------------------------------------------------------------")
    println("  (cA1) rho(val) " + _fmt(rhoA_val) + " >= 0.5                    : " + (if cA1 { "PASS" } else { "FAIL" }))
    println("  (cA2) rho(aro) " + _fmt(rhoA_aro) + " >= 0.5                    : " + (if cA2 { "PASS" } else { "FAIL" }))
    println("  (cB1) shuffle val " + _fmt(rhoB_val) + " & aro " + _fmt(rhoB_aro) + " < 0.3      : " + (if cB1 { "PASS" } else { "FAIL" }))
    println("  (cC1) fab_aff " + _fmt(fab_aff) + " <= fab_blind " + _fmt(fab_blind) + " - 0.2     : " + (if cC1 { "PASS" } else { "FAIL" }))
    println("  (cC2) emit_aff_g " + _fmt(emit_aff_g) + " >= 0.8*" + _fmt(emit_blind_g) + "=" + _fmt(0.8 * emit_blind_g) + ": " + (if cC2 { "PASS" } else { "FAIL" }))

    let green = cA1 && cA2 && cB1 && cC1 && cC2
    println("==============================================================================")
    if green {
        println("VERDICT: 🟢 GREEN (ENGINE-NATIVE) — substrate-derived affect TRACKS the manipulation,")
        println("  COLLAPSES under the p6 shuffle (EMERGENT not injected), AND functionally biases emit/abstain")
        println("  (somatic marker). E1 affect realized ENGINE-NATIVE on the LIVE engine_cli.hexa immune lane.")
        println("  Ψ-disjoint: the affect read is a pure READ over ImmuneMemoryGrow — pure_field Φ/phase/Ψ untouched;")
        println("  engine_cli_smoke 26/0 + h1196 7/0 + h1199 Ψ-byte-identical guards run separately + intact.")
        println("  p6 SEPARATION: affect is COMPUTED from substrate state (margin/contradiction/novelty/split/curiosity),")
        println("  the manipulation label only SCORES it, and the shuffle control collapses it — emergent, never injected.")
        println("  toy scale (60 facts, 1 paradigm, 3 seeds); scale-transfer UNVERIFIED (a_scale_honest_scope · a_toy_scale_recheck).")
        exit(0)
    }
    println("VERDICT: 🔴 RED — the live engine affect read did NOT clear a frozen R1 bar (see per-condition flags).")
    println("  Engine-native realization diverged from the R1 mirror — honest report (a_paper_negative_ok).")
    exit(1)
}
