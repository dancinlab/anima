// h1197_summer_mitosis_growth.hexa — H_1197 FIRST real LIVE-MITOSIS GROWTH run
// (MITOSIS-ENGINE · Lane2) on the summer pool host ($0, CPU, gradient-free p8).
//
// DOMAIN: MITOSIS-ENGINE. This is the FIRST sustained live-growth run on the
// H_1194 coupling (commit 3bb813607): the engine-native AdaptField in
// CORE/engine_cli.hexa (adapt_field_step / adapt_field_recon_err /
// adapt_field_cells), which is Ψ-disjoint (pure_field untouched) and wires
// stream→field input + cell→field mitosis feedback + recon-error readout.
// H_1194 PROVED the coupling p8-LIVE on a SHORT probe (K=6, n=600, single
// novelty-vs-settled point). H_1197 drives it over a SUSTAINED, LARGER stream
// (K=16 regimes appearing PROGRESSIVELY over n=4000 ticks, max_cells=64) and
// LOGS THE WHOLE TRAJECTORY: cell_count(t) and live recon-error(t), sampled
// every SAMPLE_EVERY ticks. The point is to SHOW the engine GROWS cells as
// novelty arrives AND the live error stays LOW against the rising frozen-capacity
// baseline (the OFF control whose error blows up) — sustained, not one point.
//
// This is the LIVE engine on summer CPU, gradient-free (engine_mitosis_tick is
// the SAME p8 cell-division gate the smoke proves — NOT a numpy toy proxy, NOT
// gradient/forge training). a_train_flame_forge's forge stack is for GRADIENT
// training; this gradient-free growth loop is LIGHT while cell-count is small,
// so summer CPU is the right host now (the "작을 땐 summer" half of the policy).
//
// MIGRATION POLICY MEASUREMENT ("커지면 pod"): a second pass MEASURES the
// per-cell cost on summer — wall-time per tick as a function of fixed
// cell_count (the AdaptField nearest-prototype assignment is O(n_cells) per
// tick, so per-tick cost grows linearly with the cell population). From the
// measured cost curve we PICK N_MIGRATE: the cell_count past which summer CPU
// per-tick wall-time crosses a budget the growth loop should not pay on CPU,
// i.e. where the run should migrate to a rented GPU pod. This run STAYS on
// summer (it stays small); it only PRODUCES the curve + cost + threshold.
//
// FROZEN / HONEST (a_scale_honest_scope): LIVE engine (H_1194 coupling) on
// summer CPU, gradient-free p8 growth — REAL but small-scale; the wiring +
// growth-curve + cost-grounded threshold ARE the result, large-scale
// UNVERIFIED. The logged cell_count(t)/recon-error(t) is the REAL engine
// trajectory (p7 = real reconstruction distance, NOT perplexity). If growth
// saturates or error does NOT fall, that is reported honestly
// (a_paper_negative_ok). Ψ untouched (pure_field_step run READ-ONLY); the
// engine_cli_smoke 12/0 anchor + the Ψ attractor are re-verified separately.
//
// SUBSTRATE NOTE (a_core_engine_map): the stream is an ENGINE-NATIVE drive into
// AdaptField — NOT a .clm (generator L3 only) nor a .kosmos (kosmos_io only).

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

// ── deterministic LCG (same schedule discipline as H_1194) ────────────────────
fn _lcg(state: int) -> int {
    let next = (state * 1103515245 + 12345) % 2147483648
    if next < 0 { return next + 2147483648 }
    return next
}
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
// (_absf is provided by the imported CORE/engine_cli.hexa)

// ── progressive K-regime stream: novelty keeps ARRIVING over the whole run ────
// Regime k is centered at (k + 0.5), regimes spaced 1.0 apart (>> SPLIT_THRESH
// 0.30 ⇒ each new regime is UNAMBIGUOUSLY novel). The active regime index walks
// 0 → K-1 over the run: at tick t the newest available regime is t*K/n, and the
// stream cycles among the regimes UNLOCKED so far (so old regimes recur AND new
// ones keep appearing — sustained novelty, not a one-shot ramp).
fn _sample_at(t: int, n: int, K: int, rng: int) -> float {
    let mut unlocked = (t * K) / n + 1   // regimes available so far (1..K)
    if unlocked > K { unlocked = K }
    if unlocked < 1 { unlocked = 1 }
    // pick among unlocked regimes (recurrence) but bias toward the NEWEST so a
    // freshly-unlocked regime is actually visited near its onset.
    let r = _u01(rng)
    let mut k = unlocked - 1                 // default: the newest regime
    if r < 0.5 && unlocked > 1 {             // half the time, revisit an older one
        k = to_int(r * 2.0 * to_float(unlocked))
        if k >= unlocked { k = unlocked - 1 }
    }
    let jitter = (_u01(_lcg(rng)) - 0.5) * 0.06
    return to_float(k) + 0.5 + jitter
}

// ── drive the LIVE engine over the sustained stream, logging the trajectory ───
// Returns flat trajectory rows [t0,cells0,err0, t1,cells1,err1, ...] plus a
// trailing [phi_sum] checksum. Sampled every `sample_every` ticks; `err` is the
// mean live recon-error over the sampling window (smooths per-tick jitter).
fn _run_growth(seed: int, n: int, K: int, max_cells: int, sample_every: int,
               cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    let mut af = adapt_field_new(0.5, max_cells)   // seed cell at regime-0 center

    let mut rng = seed * 2654435761 + 1
    if rng < 0 { rng = -rng }

    let mut rows = []
    let mut phi_sum = 0.0
    let mut win_err = 0.0
    let mut win_cnt = 0

    let mut t = 0
    while t < n {
        // (Ψ, READ-ONLY) advance the live field; only OBSERVE Φ (attractor disjoint).
        pf = pure_field_step(pf)
        phi_sum = phi_sum + pure_field_phi(pf)

        rng = _lcg(rng)
        let sample = _sample_at(t, n, K, rng)

        // (coupling) live recon-error BEFORE the update — the adaptation readout.
        let err = adapt_field_recon_err(af, sample)
        win_err = win_err + err
        win_cnt = win_cnt + 1

        // (coupling) one live tick: stream→field + cell→field mitosis feedback.
        af = adapt_field_step(af, sample, cfg)

        // sample the trajectory every `sample_every` ticks.
        if (t + 1) % sample_every == 0 {
            let mean_err = if win_cnt > 0 { win_err / to_float(win_cnt) } else { 0.0 }
            rows = rows + [to_float(t + 1), to_float(adapt_field_cells(af)), mean_err]
            win_err = 0.0
            win_cnt = 0
        }
        t = t + 1
    }
    return rows + [phi_sum]
}

// ── per-cell cost curve: wall-time per tick at FIXED cell_count ───────────────
// To GROUND the migration threshold we must isolate the per-tick cost as a
// function of cell population. We GROW an AdaptField to a fixed n_cells through
// the PUBLIC API (mitosis ON, feeding ever-novel samples 0.5,1.5,2.5,… each >
// SPLIT_THRESH apart so every sample spawns a cell until n_cells is reached),
// then HOLD the population (mitosis OFF) and time a fixed batch of
// recon_err+step ticks, reporting ms-per-1000-ticks. The AdaptField inner loop
// is O(n_cells) (nearest-prototype scan), so per-tick cost grows ~linearly with
// the cell count — this is the cost summer CPU pays as the engine grows.
fn _grow_to(n_cells: int, cfg_on: EngineConfig) -> AdaptField {
    let mut af = adapt_field_new(0.5, n_cells)   // cap = n_cells (stops at target)
    let mut k = 1
    while adapt_field_cells(af) < n_cells && k < n_cells + 4 {
        // each new center is 1.0 past the last ⇒ recon-err >> SPLIT_THRESH ⇒ split.
        af = adapt_field_step(af, to_float(k) + 0.5, cfg_on)
        k = k + 1
    }
    return af
}
fn _cost_at_cells(n_cells: int, batch: int, cfg_on: EngineConfig, cfg_off: EngineConfig) -> float {
    let mut af = _grow_to(n_cells, cfg_on)
    let mut rng = n_cells * 2654435761 + 7
    if rng < 0 { rng = -rng }
    let t0 = time_ms()
    let mut j = 0
    while j < batch {
        rng = _lcg(rng)
        // sample within the populated regime span so the scan does real work.
        let x = _u01(rng) * to_float(n_cells)
        let _e = adapt_field_recon_err(af, x)
        af = adapt_field_step(af, x, cfg_off)   // OFF ⇒ population held at n_cells
        j = j + 1
    }
    let t1 = time_ms()
    // ms per 1000 ticks (normalize to the batch).
    return to_float(t1 - t0) * 1000.0 / to_float(batch)
}

fn _mean(xs: [float]) -> float {
    if len(xs) == 0 { return 0.0 }
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i]  i = i + 1 }
    return s / to_float(len(xs))
}
fn _fmt(x: float) -> string { return to_string(x) }

fn main() {
    println("=== H_1197 FIRST live-mitosis GROWTH run (MITOSIS-ENGINE Lane2 · summer CPU · $0 · gradient-free p8) ===")
    println("substrate: H_1194 AdaptField coupling (engine-native, Psi-disjoint) — stream->field + cell->field mitosis + recon-error")
    println("metric: live recon-error = |sample - nearest AdaptField prototype| (p7, NOT perplexity)")
    println("stream: PROGRESSIVE K=16-regime (centers 1.0 apart; novelty keeps arriving over n=4000 ticks)")
    println("log: cell_count(t) and recon-error(t) sampled every 200 ticks (SUSTAINED, not a single probe point)")
    println("cost: wall-time per 1000 ticks at FIXED cell_count (O(n_cells) assignment) -> grounds N_MIGRATE")
    println("")

    let n = 4000
    let K = 16
    let max_cells = 64
    let sample_every = 200
    let seed = 7

    let cfg_on  = engine_cli_parse(["--mitosis", "on"])
    let cfg_off = engine_cli_parse(["--no-mitosis"])

    // ── PASS 1: the sustained growth trajectory ───────────────────────────────
    let traj = _run_growth(seed, n, K, max_cells, sample_every, cfg_on)
    let phi_sum = traj[len(traj) - 1]

    // also run the OFF arm (frozen capacity) over the SAME stream as a control,
    // to confirm the growth is what buys the falling error (H_1159 ON-vs-OFF).
    let traj_off = _run_growth(seed, n, K, max_cells, sample_every, cfg_off)
    let phi_sum_off = traj_off[len(traj_off) - 1]
    let psi_intact = phi_sum == phi_sum_off

    println("--- GROWTH TRAJECTORY (mitosis ON) ---")
    println("tick      cell_count   recon_err(ON)   recon_err(OFF, frozen-cap control)")
    let mut start_cells = 0.0  let mut end_cells = 0.0
    let mut start_err = 0.0    let mut end_err = 0.0
    // late-window means (last quarter of the run, where the most regimes are
    // live) — the SUSTAINED-novelty regime where the ON-vs-OFF gap is decisive.
    let mut late_on = 0.0   let mut late_off = 0.0   let mut late_cnt = 0
    let n_rows = len(traj) / 3
    let mut i = 0
    let mut ri = 0
    let mut first = true
    while i + 2 < len(traj) {
        let t   = traj[i]
        let c   = traj[i + 1]
        let eON = traj[i + 2]
        let eOFF = traj_off[i + 2]
        println("  " + _fmt(t) + "      " + _fmt(c) + "        " + _fmt(eON) + "        " + _fmt(eOFF))
        if first { start_cells = c  start_err = eON  first = false }
        end_cells = c  end_err = eON
        if ri * 4 >= n_rows * 3 {   // last quarter of the rows
            late_on = late_on + eON  late_off = late_off + eOFF  late_cnt = late_cnt + 1
        }
        i = i + 3
        ri = ri + 1
    }
    let m_late_on  = if late_cnt > 0 { late_on / to_float(late_cnt) } else { 0.0 }
    let m_late_off = if late_cnt > 0 { late_off / to_float(late_cnt) } else { 0.0 }
    println("")
    println("GROWTH:   cells " + _fmt(start_cells) + " -> " + _fmt(end_cells)
        + "   recon-error(ON) " + _fmt(start_err) + " -> " + _fmt(end_err))
    println("ADAPT:    late-run recon-error  ON=" + _fmt(m_late_on) + "  vs  OFF(frozen-cap)=" + _fmt(m_late_off)
        + "   ratio OFF/ON=" + _fmt(if m_late_on > 0.0 { m_late_off / m_late_on } else { 0.0 }))
    println("F3 Psi:   Phi-checksum ON==OFF = " + (if psi_intact { "true (attractor intact)" } else { "false (PERTURBED!)" })
        + "   (ON=" + _fmt(phi_sum) + " OFF=" + _fmt(phi_sum_off) + ")")
    println("")

    // ── PASS 2: per-cell cost curve on summer CPU ─────────────────────────────
    println("--- PER-CELL COST on summer CPU (ms per 1000 ticks at fixed cell_count) ---")
    println("n_cells   ms_per_1k_ticks")
    let cost_cells = [1, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096]
    let batch = 200000
    let mut cost_rows = []
    let mut ci = 0
    while ci < len(cost_cells) {
        let nc = cost_cells[ci]
        let ms = _cost_at_cells(nc, batch, cfg_on, cfg_off)
        cost_rows = cost_rows + [ms]
        println("  " + to_string(nc) + "        " + _fmt(ms))
        ci = ci + 1
    }
    println("")

    // ── derive N_MIGRATE from the measured cost curve ─────────────────────────
    // per-tick budget on summer CPU for the gradient-free growth loop: T_BUDGET
    // ms per 1000 ticks. Past this, the O(n_cells) CPU assignment is too slow to
    // keep the live loop real-time, and the growth run should migrate to a GPU
    // pod (parallel nearest-prototype). T_BUDGET frozen pre-registration.
    let T_BUDGET = 50.0   // ms per 1000 ticks (frozen budget; ~20k ticks/sec floor)
    let mut n_migrate = -1
    let mut k2 = 0
    while k2 < len(cost_cells) {
        if cost_rows[k2] > T_BUDGET && n_migrate < 0 { n_migrate = cost_cells[k2] }
        k2 = k2 + 1
    }
    let migrate_str = if n_migrate > 0 { to_string(n_migrate) } else { ">512 (CPU cheap to 512 cells)" }

    println("--- MIGRATION POLICY (summer CPU -> GPU pod) ---")
    println("frozen budget T_BUDGET = " + _fmt(T_BUDGET) + " ms / 1000 ticks (per-tick real-time floor on summer CPU)")
    println("MEASURED: per-tick cost is O(n_cells) (nearest-prototype scan); the first cell_count over budget = N_MIGRATE")
    println("N_MIGRATE = " + migrate_str + " cells")
    println("POLICY: gradient-free mitosis growth STAYS on summer CPU ($0) while cell_count < N_MIGRATE;")
    println("  when the live cell_count grows past N_MIGRATE (per-1k-tick wall-time > T_BUDGET on CPU),")
    println("  the growth run MIGRATES to a rented GPU pod (a_fire_autonomous, no cost gate). This run")
    println("  stayed on summer (ended at " + _fmt(end_cells) + " cells << N_MIGRATE) — small-stage host correct.")
    println("")

    // ── verdict adjudication ──────────────────────────────────────────────────
    // p8 GROWTH-DRIVEN ADAPTATION (the H_1159 ON-vs-OFF frame, sustained):
    //   (a) GROWTH — cells grew over the stream as regimes appeared, AND
    //   (b) ADAPT  — under SUSTAINED novelty the ON arm holds the live error LOW
    //                while frozen-capacity (OFF) blows up: late-run ON << OFF
    //                (ratio OFF/ON >= 2). This is the correct frame — a real-time
    //                adaptive engine keeps error flat-low as novelty arrives (it
    //                does NOT need to FALL from a high start; the OFF control is
    //                what the error WOULD be without growth), AND
    //   (c) BOUNDED — the ON error stays bounded (does not itself diverge), AND
    //   (d) Ψ-INTACT — the attractor is byte-identical ON vs OFF.
    let grew = end_cells > start_cells
    let adapts = m_late_on > 0.0 && (m_late_off / m_late_on) >= 2.0
    let bounded = m_late_on < 0.5    // ON stays flat-low (well under the OFF blow-up)
    if grew && adapts && bounded && psi_intact {
        println("VERDICT: GREEN LIVE-GROWTH — over the SUSTAINED progressive-novelty stream the live engine")
        println("  GREW cells (" + _fmt(start_cells) + " -> " + _fmt(end_cells) + ") as each new regime arrived AND")
        println("  the live recon-error stayed FLAT-LOW (late ON=" + _fmt(m_late_on) + ") while frozen-capacity OFF")
        println("  blew up (late OFF=" + _fmt(m_late_off) + ", " + _fmt(m_late_off / m_late_on) + "x worse) — the growth")
        println("  is what holds error down as novelty keeps coming (p8). Psi byte-identical ON vs OFF (F3).")
        println("  FIRST real live-mitosis growth run on the H_1194 coupling; ran on summer CPU $0 gradient-free.")
        println("  Per-cell cost measured (O(n_cells)); N_MIGRATE=" + migrate_str + " sets the summer->pod threshold.")
        println("  toy/small-scale; live-scale + real corpus UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    println("VERDICT: RED/PARTIAL — "
        + (if !grew { "cells did NOT grow over the stream" }
           else { if !adapts { "cells grew but ON did not hold error below the frozen-cap OFF baseline (non-adaptive)" }
                  else { if !bounded { "ON error itself diverged (not bounded)" }
                         else { "Psi attractor PERTURBED (coupling not Psi-disjoint)" } } })
        + " (a_paper_negative_ok). Growth curve + cost + threshold above are the honest record.")
    exit(0)
}
