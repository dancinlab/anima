// bytegpt_ranged_wire_smoke.hexa — LEVER-1 WIRED-ENTRY device-vs-host gate.
//
// The correctness gate for routing the in-window KV fast-path of the LIVE 303M
// chat mouth bytegpt_decode_argmax_ranged through the P2 dispatcher _bg_kv_step_r
// (device _bg_kv_step_dev on a CUDA host, else host _bg_kv_step).
//
// (bytegpt_decode_argmax stays on the host _bg_kv_step: its whole-file bg_load
//  does not populate the pre-split QKV keys inWt_q/k/v + *_e that the device
//  _bg_kv_step_dev needs, so device-routing it crashes on a CUDA host — see the
//  NOTE in bytegpt_decode_argmax. Follow-up: pre-split QKV in bg_load.)
//
// Unlike bytegpt_kvstep_devres_smoke (which drives _bg_kv_step{,_dev} directly),
// this drives the ACTUAL wired entry bytegpt_decode_argmax_ranged end-to-end
// (device path via the router) and compares its emitted `ids` against an inline
// HOST-only _bg_kv_step greedy reference over the SAME in-window seed.
//
// Both are greedy/deterministic, so EXPECTED: per-token argmax IDENTICAL. A
// flipped token = a routing / cache-lifecycle / residency bug in the wiring.
// (~1e-6 dt_exp softmax + LN reassoc noise is invisible at the argmax level —
// this compares emitted token ids, device-vs-host, NEVER vs torch.)
//
// Needs a CUDA host + the 303M h1129 fixture to exercise the real device path.

import "core/bytegpt_decode.hexa"

fn main() {
    let mut bin = "/root/anima-weights/bytegpt303_h1129/h1129.bin"
    let av = args()
    let mut ai = 0
    while ai < len(av) {
        let a = to_string(av[ai])
        let al = byte_len(a)
        if al > 4 && substring(a, al - 4, al) == ".bin" { bin = a }
        ai = ai + 1
    }
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if !have { println("[ranged-wire-smoke] SKIP — no fixture at " + bin); return }

    let cu = cuda_available()
    println("[ranged-wire-smoke] cuda_available = " + to_string(cu))
    if cu != 1 { println("[ranged-wire-smoke] ABORT — CPU fallback, not a device measurement (phantom guard)"); return }

    let W = bg_load_ranged(bin)
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])
    println("[ranged-wire-smoke] loaded vocab=" + to_string(vocab) + " d=" + to_string(d)
        + " nlay=" + to_string(nlay) + " block=" + to_string(block))

    // in-window seed + greedy gen (nseed + gen < block so the cache never slides).
    let stext = "The quick brown fox jumps over the lazy dog."
    let seed_ids = []
    let mut si = 0
    let sl = byte_len(stext)
    while si < sl { seed_ids.push(ord(substring(stext, si, si + 1))); si = si + 1 }
    let nseed = len(seed_ids)
    let gen = 48
    println("[ranged-wire-smoke] nseed=" + to_string(nseed) + " gen=" + to_string(gen)
        + " (in-window: nseed+gen=" + to_string(nseed + gen) + " < block=" + to_string(block) + ")")

    // ---- HOST reference: inline replica of the decoder's in-window greedy on
    //      the host _bg_kv_step (the reference path _bg_kv_step_r falls back to). ----
    let toks = []
    let mut ti = 0
    while ti < nseed { toks.push(to_int(seed_ids[ti])); ti = ti + 1 }
    let refids = []
    let kv = _bg_kv_new(nlay, block, d)
    let mut lh = -1
    let mut sp = 0
    while sp < nseed {
        if lh >= 0 { let _ = farr_free(lh) }
        lh = _bg_kv_step(W, kv, to_int(toks[sp]), sp)
        sp = sp + 1
    }
    let mut g = 0
    while g < gen {
        let nb = bg_argmax(lh, vocab)
        let _ = farr_free(lh)
        toks.push(nb); refids.push(nb)
        lh = _bg_kv_step(W, kv, nb, len(toks) - 1)
        g = g + 1
    }
    let _ = farr_free(lh)
    _bg_kv_free(kv)

    // ---- WIRED ENTRY (device via _bg_kv_step_r router, cuda_available==1). ----
    let res = bytegpt_decode_argmax_ranged(bin, seed_ids, gen)
    let devids = res["ids"]

    // ---- compare emitted token ids per position. ----
    let nref = len(refids); let ndev = len(devids)
    let mut agree = 0
    let mut total = 0
    let mut firstdiff = -1
    let ncmp = if nref < ndev { nref } else { ndev }
    let mut k = 0
    while k < ncmp {
        let rk = to_int(refids[k]); let dk = to_int(devids[k])
        if rk == dk { agree = agree + 1 } else { if firstdiff < 0 { firstdiff = k } }
        total = total + 1
        k = k + 1
    }

    println("[ranged-wire-smoke] emitted-len host=" + to_string(nref) + " device=" + to_string(ndev))
    println("[ranged-wire-smoke] per-token argmax agreement = " + to_string(agree) + "/" + to_string(total))
    println("")
    if agree == total && nref == ndev && nref == gen {
        println("bytegpt_ranged_wire_smoke: PASS — device-routed bytegpt_decode_argmax_ranged "
            + "emits the SAME " + to_string(total) + " greedy tokens as the host _bg_kv_step reference "
            + "(wiring is argmax-exact; device path fired at cuda_available=1).")
    } else {
        println("bytegpt_ranged_wire_smoke: FAIL — token MISMATCH at position " + to_string(firstdiff)
            + " (" + to_string(agree) + "/" + to_string(total) + " agree; host_len=" + to_string(nref)
            + " dev_len=" + to_string(ndev) + "). => routing/cache-lifecycle/residency bug in the wiring.")
    }
}
