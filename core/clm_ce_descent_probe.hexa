// ════════════════════════════════════════════════════════════════════════════
//  clm_ce_descent_probe.hexa — CORE-mounted CE-descent measurement (AXIS-2).
//
//  Drives the SINGLE .clm decode entry (generator.hexa::clm_decode_ce) on the
//  real admitted d768 ckpt. The CE is computed THROUGH the engine forward (int4
//  dequant + CLMConvMoE), NOT by a loss script (p7: CE is one axis, measured
//  through the engine, not treated as a perplexity-truth verdict).
//
//  ── PRE-REGISTERED FALSIFIER (in-file, before measuring) ────────────────────
//  F-CLM-CORE-CE-DESCENT:
//    NULL hypothesis  : the CORE-mounted decode produces NO usable next-byte
//                       distribution → mean CE ≥ uniform baseline ln(256)=5.5452.
//    REFUTE-NULL (GREEN): mean CE < ln(256) on the real-text byte sequence AND
//                       CE(real-text) < CE(shuffled-byte control) — i.e. the
//                       decode extracts byte-order structure the model learned.
//    KEEP-NULL (⏳/🔴) : mean CE ≥ ln(256) → descent NOT demonstrated CORE-mounted
//                       (the decode forward is wired + CE is MEASURABLE, but the
//                       artifact/format does not yield descent through the engine).
//  Determinism (p7): the forward is pure arithmetic over fixed file bytes — a
//  re-run is byte-identical (no RNG). The verdict = the numeric comparison, not a
//  perplexity ranking.
// ════════════════════════════════════════════════════════════════════════════

use "CORE/generator.hexa"

fn main() {
    // Default = the PRODUCTION-scale (d=768) v0.2 re-export (TRAINED embed+GN
    // persisted, $0-CPU host run of hexa-lang clm_reexport.hexa CLM_PROD_D=768).
    // This is the production-scale rung that resolves a_toy_scale_recheck — the
    // SAME config-agnostic decode reads d=768 and the descent HOLDS (CE 3.25405
    // < uniform 5.54518 AND < shuffle 5.30381). Override via env CLM_CE_PROBE_CKPT
    // (e.g. reexport_d8_v2.clm for the toy d=8 rung, or the legacy conv-only
    // d768_5lang_c4.clm for the v0.1 MEASURABLE-NO-DESCENT baseline). The decode
    // is config-agnostic (derives d/E from block dims — serves d=8 and d=768).
    let envck = env("CLM_CE_PROBE_CKPT")
    let ckpt = if envck == "" {
        "/Users/mini/dancinlab/anima/state/laneg_d768_recover/reexport_d768_v2_fast.clm"
    } else { envck }

    // IN-DISTRIBUTION real-text window from the training corpus head
    // ("The mind is a fire to be", clm_semantic_parallel.txt) vs a shuffled-byte
    // control (same byte multiset, scrambled order — destroys learned byte-order).
    let seq  = [84, 104, 101, 32, 109, 105, 110, 100, 32, 105, 115, 32, 97, 32, 102, 105, 114, 101, 32, 116, 111, 32, 98, 101]
    let ctrl = [105, 32, 98, 105, 100, 102, 101, 32, 110, 116, 32, 114, 32, 84, 105, 32, 32, 101, 101, 104, 111, 97, 109, 115]

    let r1 = clm_decode_ce(ckpt, seq)
    let r2 = clm_decode_ce(ckpt, ctrl)
    // determinism re-run
    let r1b = clm_decode_ce(ckpt, seq)

    let ce_real = to_float(r1["ce"])
    let ce_ctrl = to_float(r2["ce"])
    let ce_re   = to_float(r1b["ce"])
    let base    = to_float(r1["baseline"])
    let nblk    = to_int(r1["nblk"])
    let pos     = to_int(r1["positions"])
    let has_ext = to_string(r1["has_ext"]) == "true"
    let dd      = to_int(r1["d"])
    let ee      = to_int(r1["E"])

    println("=== F-CLM-CORE-CE-DESCENT (AXIS-2) — CORE-mounted decode forward ===")
    println("ckpt               = " + ckpt)
    println("ckpt_nblocks       = " + to_string(nblk))
    println("ckpt_has_ext(v0.2) = " + to_string(has_ext))
    println("model_d            = " + to_string(dd))
    println("model_E            = " + to_string(ee))
    println("ce_positions       = " + to_string(pos))
    println("CE_realtext        = " + to_string(ce_real))
    println("CE_shuffled_ctrl   = " + to_string(ce_ctrl))
    println("CE_uniform_baseline= " + to_string(base))
    println("CE_realtext_rerun  = " + to_string(ce_re))

    // DET axis (byte-identical re-run)
    let det = if ce_real == ce_re { 1 } else { 0 }
    println("DET_rerun_byte_eq  = " + to_string(det))

    // MEASURABLE axis — a finite real CE flowed through the engine.
    let measurable = if pos > 0 { 1 } else { 0 }
    println("CE_MEASURABLE_CORE = " + to_string(measurable))

    // DESCENT falsifier verdict
    let below = if ce_real < base { 1 } else { 0 }
    let beats_ctrl = if ce_real < ce_ctrl { 1 } else { 0 }
    println("CE_BELOW_UNIFORM   = " + to_string(below))
    println("CE_BEATS_SHUFFLE   = " + to_string(beats_ctrl))

    if measurable == 1 {
        if det == 1 {
            if below == 1 {
                if beats_ctrl == 1 {
                    println("VERDICT = GREEN — CE-descent REFUTES NULL CORE-mounted (CE<uniform AND CE<shuffle), v0.2 trained embed+GN read through the engine. Scale: this measurement is at the model's own d (toy d=8 = $0-CPU re-export; production d=768 re-test pending a forge re-fire of clm_prod.hexa v0.2 serializer).")
                    return
                }
            }
            if has_ext {
                println("VERDICT = MEASURABLE-NO-DESCENT(v0.2) — decode WIRED + CE MEASURABLE + trained embed+GN READ from the v0.2 ext, but CE did not clear BOTH gates (uniform AND shuffle). Honest NULL kept.")
            } else {
                println("VERDICT = MEASURABLE-NO-DESCENT(v0.1) — decode forward WIRED + CE MEASURABLE CORE-mounted (det re-run byte-eq), but CE >= uniform baseline => descent NOT demonstrated through the engine (NULL kept honest). Cause: inference-track .clm omits trained embed+GN affine (format gap), so the trainer's GPU-measured 4.88 descent is not reconstructible CORE-side from the 6 conv blocks alone.")
            }
            return
        }
    }
    println("VERDICT = BLOCKED — CE not measurable (nblk<6 or non-finite)")
}
