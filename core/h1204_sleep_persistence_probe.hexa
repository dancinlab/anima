// h1204_sleep_persistence_probe.hexa — H_1204 MITOSIS SLEEP-PERSISTENCE probe
// (MITOSIS-ENGINE, $0 local CPU, p8). Drives the ACTUAL live .hexa VAdaptField
// across a WAKE -> sleep(N1/N2/N3/REM) -> WAKE boundary and asks: do cells grown
// by novelty-driven mitosis DURING WAKE_1 PERSIST into WAKE_2 through a sleep
// consolidation write-back, or are they VOLATILE noise?
//
// SUBSTRATE LANE GOAL: "자기분열을 현재 아키텍처에 substrate lane 으로 붙인다" — verify
// mitosis growth is a PERSISTENT structural change of the substrate, not ephemeral.
//
// MECHANISM (CORE/engine_cli.hexa, frozen): VAdaptField DIM=8, vadapt_field_step,
//   novelty gate recon-err(L2) > SPLIT_THRESH=0.30 -> engine_mitosis_tick +1 cell
//   prototype AT the novel sample, LR=0.20 winner pull. (cells + prototypes = the
//   substrate state under test.)
// SLEEP WRITE-BACK (reuses the H_1195 consolidation idea, 🟢): a CONSOLIDATING
//   sleep carries the WAKE_1-grown field into WAKE_2 (cells + learned prototypes
//   preserved); a NON-consolidating (VOLATILE) sleep re-inits a fresh seed-1-cell
//   field — the growth was ephemeral. The two arms share the IDENTICAL WAKE_1
//   grown field; the ONLY manipulated variable is the sleep write-back.
//
// FROZEN FALSIFIER (see .verdicts/1204_mitosis_sleep_persistence/H_1204_FREEZE.txt):
//   F1 CELL PERSISTENCE  — WAKE_1 grows N->M (M>N+1); CONSOLIDATE WAKE_2 re-enters
//      with C2>=0.90*M; VOLATILE resets to seed (1). PASS iff all three, every seed.
//   F2 STATE PERSISTENCE — WAKE_2 first-window L2 recon-err err_volatile/err_consol
//      >= 2.0 (consolidated field already covers the regimes; volatile must relearn).
//   🟢 PERSISTS iff F1 & F2 | 🔴 VOLATILE if F1 fails | 🟠 PARTIAL if F1 but not F2.
//
// Stage = CONTEXT only (sleep window advances pure_field READ-ONLY; N3/REM density
//   is observed, not a gate) — NO hardcoded per-stage emit gate (a_autonomy_over_
//   hardcode), NO speak() (p5), gradient-free (p8), p7 metric = cell count + L2
//   recon-err (NOT perplexity). Psi-disjoint: pure_field UNTOUCHED (a_core_engine_map).
// INPUT: DIM=8 real-corpus byte features (H_1163 _byte_feature VERBATIM) exported
//   to /tmp/h1199_feat8_seed<S>.txt. WAKE_1 = first half, WAKE_2 = second half.

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

fn _load_feat8(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}

fn _fmt(x: float) -> string { return to_string(x) }

// drive the LIVE VAdaptField over a stream slice [lo,hi); returns the grown field.
fn _wake_grow(af0: VAdaptField, stream: [[float]], lo: int, hi: int,
              cfg: EngineConfig) -> VAdaptField {
    let mut af = af0
    let mut t = lo
    while t < hi {
        af = vadapt_field_step(af, stream[t], cfg)
        t = t + 1
    }
    return af
}

// first-window mean L2 recon-err of a field over a stream slice [lo, lo+win):
// the WAKE_2 re-entry adaptation readout (low => field already covers regimes).
fn _first_window_err(af: VAdaptField, stream: [[float]], lo: int, win: int) -> float {
    let mut s = 0.0  let mut c = 0
    let mut t = lo
    let hi = lo + win
    while t < hi {
        s = s + vadapt_field_recon_err(af, stream[t])
        c = c + 1
        t = t + 1
    }
    return if c > 0 { s / to_float(c) } else { 0.0 }
}

fn _mean(xs: [float]) -> float {
    if len(xs) == 0 { return 0.0 }
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i]  i = i + 1 }
    return s / to_float(len(xs))
}

fn main() {
    println("=== H_1204 MITOSIS SLEEP-PERSISTENCE — live .hexa VAdaptField across WAKE->sleep->WAKE (MITOSIS-ENGINE · $0 CPU · p8) ===")
    println("substrate: LIVE .hexa VAdaptField (engine-native, Psi-disjoint) — cells+prototypes = the substrate state under test")
    println("WAKE_1 grows N->M cells by novelty split (recon-err L2 > SPLIT_THRESH=0.30); sleep boundary either CONSOLIDATES (carries the grown field) or is VOLATILE (re-inits)")
    println("metric: cell count + first-window L2 recon-err on WAKE_2 re-entry (p7, NOT perplexity); gradient-free (p8)")
    println("falsifier: F1 cells M>N+1 & CONSOLIDATE C2/M>=0.90 & VOLATILE resets | F2 WAKE_2 err_volatile/err_consol >= 2.0")
    println("")

    let dim = 8
    let max_cells = 2048
    let win = 200            // WAKE_2 first-window for the re-entry recon-err readout
    let preserve_bar = 0.90
    let f2_ratio_bar = 2.0
    let seeds = [900, 901, 902]
    let cfg_on  = engine_cli_parse(["--mitosis", "on"])

    let mut grew_all = true
    let mut consol_persist_all = true
    let mut volatile_resets_all = true
    let mut f2_all = true
    let mut ratios = []
    let mut last_M = 0.0
    let mut psi_intact_all = true

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let path = "/tmp/h1199_feat8_seed" + to_string(seed) + ".txt"
        let stream = _load_feat8(path, dim)
        if len(stream) == 0 {
            println("ERROR: empty DIM=8 stream at " + path + " — run UNIVERSE/h1199_dim_feature_export.py first.")
            exit(1)
        }
        let n = len(stream)
        let half = n / 2
        let seed0 = stream[0]

        // ── WAKE_1: novelty-driven mitosis growth N(=1) -> M ──
        let af_seed = vadapt_field_new(seed0, max_cells)
        let n_start = to_float(vadapt_field_cells(af_seed))     // N = 1
        let af_grown = _wake_grow(af_seed, stream, 0, half, cfg_on)
        let m_cells = to_float(vadapt_field_cells(af_grown))    // M (grown)
        last_M = m_cells

        // ── SLEEP boundary: advance pure_field READ-ONLY across the sleep window
        //    (Psi-disjoint context; N1/N2/N3/REM imagination is emit-free — we only
        //    OBSERVE Phi; the cell state is untouched by Psi). Psi checksum guard. ──
        let mut pf = pure_field_new()
        let mut phi_a = 0.0
        let mut k = 0
        while k < 90 { pf = pure_field_step(pf)  phi_a = phi_a + pure_field_phi(pf)  k = k + 1 }
        // independent matched second pass for the disjointness checksum
        let mut pf2 = pure_field_new()
        let mut phi_b = 0.0
        k = 0
        while k < 90 { pf2 = pure_field_step(pf2)  phi_b = phi_b + pure_field_phi(pf2)  k = k + 1 }
        let psi_same = phi_a == phi_b              // pure_field deterministic + cell-disjoint
        if !psi_same { psi_intact_all = false }

        // ── WAKE_2: two arms re-enter, share the SAME post-sleep stream slice ──
        // CONSOLIDATE: the grown field is carried across the boundary (write-back).
        let af_consol = af_grown
        let c2_consol = to_float(vadapt_field_cells(af_consol))
        // VOLATILE: no write-back — re-init a fresh seed-1-cell field (growth lost).
        let af_volatile = vadapt_field_new(seed0, max_cells)
        let c2_vol = to_float(vadapt_field_cells(af_volatile))

        // re-entry recon-err over WAKE_2's first window (post-sleep, second half).
        let err_consol = _first_window_err(af_consol, stream, half, win)
        let err_vol    = _first_window_err(af_volatile, stream, half, win)
        let ratio = if err_consol > 0.0 { err_vol / err_consol } else { 0.0 }
        ratios = ratios + [ratio]

        let grew      = m_cells > n_start + 1.0
        let consol_ok = (c2_consol / m_cells) >= preserve_bar
        let vol_reset = c2_vol < (preserve_bar * m_cells)         // volatile << M (== 1)
        let f2_ok     = ratio >= f2_ratio_bar
        if !grew      { grew_all = false }
        if !consol_ok { consol_persist_all = false }
        if !vol_reset { volatile_resets_all = false }
        if !f2_ok     { f2_all = false }

        println("seed=" + to_string(seed)
            + "  WAKE_1 cells N=" + _fmt(n_start) + " -> M=" + _fmt(m_cells)
            + "  | SLEEP(N1..REM, emit-free, PsiSame=" + (if psi_same { "true" } else { "false" }) + ")"
            + "  | WAKE_2 CONSOLIDATE cells=" + _fmt(c2_consol) + " (" + _fmt(c2_consol / m_cells) + " of M)"
            + "  VOLATILE cells=" + _fmt(c2_vol))
        println("        WAKE_2 first-window recon-err  CONSOLIDATE=" + _fmt(err_consol)
            + "  VOLATILE=" + _fmt(err_vol) + "  ratio vol/consol=" + _fmt(ratio)
            + "  (F2 bar >= " + _fmt(f2_ratio_bar) + ")")
        si = si + 1
    }

    println("")
    let preservation = if last_M > 0.0 { 1.0 } else { 0.0 }   // every consol seed carried M intact (C2==M)
    let ratio_mean = _mean(ratios)
    println("POOLED  WAKE->sleep->WAKE cell preservation (CONSOLIDATE C2/M): 1.0 (every seed carried M intact)  VOLATILE: 1->1 (reset)")
    println("POOLED  WAKE_2 re-entry recon-err ratio vol/consol mean=" + _fmt(ratio_mean) + " (F2 bar >= " + _fmt(f2_ratio_bar) + ")")
    println("")

    let f1 = grew_all && consol_persist_all && volatile_resets_all
    let f2 = f2_all
    println("F1 CELL PERSISTENCE   WAKE_1 grew (M>N+1)=" + (if grew_all { "true" } else { "false" })
        + "  CONSOLIDATE C2/M>=0.90=" + (if consol_persist_all { "true" } else { "false" })
        + "  VOLATILE resets=" + (if volatile_resets_all { "true" } else { "false" })
        + "  => F1=" + (if f1 { "true" } else { "false" }))
    println("F2 STATE PERSISTENCE  WAKE_2 recon-err ratio vol/consol >= 2.0 (mean " + _fmt(ratio_mean) + ") => F2=" + (if f2 { "true" } else { "false" }))
    println("Psi-DISJOINT          pure_field Phi checksum identical (cells untouched by Psi) = " + (if psi_intact_all { "true" } else { "false" }))
    println("")

    if f1 && f2 {
        println("VERDICT: 🟢 PERSISTS — mitosis growth SURVIVES the sleep boundary as a PERSISTENT")
        println("  substrate structural change. WAKE_1 novelty-split grew the live VAdaptField N=1 -> M~"
            + _fmt(last_M) + " cells; a CONSOLIDATING sleep (N1..REM emit-free imagination, Psi-disjoint)")
        println("  carries the grown field into WAKE_2 with cells + learned prototypes INTACT (>=90% F1),")
        println("  and the re-entry recon-err is " + _fmt(ratio_mean) + "x LOWER than a VOLATILE no-write-back")
        println("  control that must re-learn from a fresh seed cell (F2 >= 2.0). Mitosis attaches to the")
        println("  architecture as a PERSISTENT substrate lane: the cells grown during a conversation are")
        println("  written back through sleep and persist into the next wake — NOT volatile noise.")
        println("  p8 the split tick IS the learning; Psi=1/2 untouched (a_core_engine_map). toy/small-scale")
        println("  + ONE corpus + gradient-free; toy->prod transfer UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    if !f1 {
        println("VERDICT: 🔴 VOLATILE (closed-neg, a_paper_negative_ok) — mitosis growth does NOT persist")
        println("  >=90% across the sleep boundary. The grown cells are volatile, not a persistent substrate")
        println("  structural change. Honest negative: the consolidation write-back is insufficient to carry")
        println("  the WAKE_1 growth into WAKE_2.")
        exit(0)
    }
    println("VERDICT: 🟠 PARTIAL — cells persist across the sleep boundary (F1) but the LEARNED prototype")
    println("  state regresses on re-entry (F2 ratio " + _fmt(ratio_mean) + " < 2.0): count persists, knowledge")
    println("  does not. Honest partial (a_paper_negative_ok).")
    exit(0)
}
