// h1285_amygdala_sleep_replay_probe.hexa — H_1285 R4 ENGINE-NATIVE realization of
// the R3 GREEN (salience-gated SLEEP REPLAY consolidation) on the LIVE immune faculty
// (CORE/engine_cli.hexa ConsolidatingMemory) · $0 local CPU · p7 · a_engine_native_learning.
//
// DOMAIN: MITOSIS-ENGINE / AMYGDALA. H_1285 R3 was a NUMPY MIRROR that hit 🟢 GREEN
// (salience-gated sleep replay lifts important-fact recall +0.200 over uniform replay
// WHILE the p6 shuffle control stays below the +0.10 bar, fab=0.000, at the pre-
// registered 30-cycle multi-night consolidation budget). Per a_engine_native_learning a
// mirror verdict is DIRECTIONAL ONLY; per a_verified_must_wire the GREEN must wire into
// the live engine. This probe re-realizes R3 ON the ACTUAL CORE/engine_cli.hexa
// ConsolidatingMemory faculty (the amygdala-consolidation lane wired this round), so it
// becomes the BINDING engine-native verdict, NOT a mirror.
//
// WHAT IS ENGINE-NATIVE HERE (the whole point):
//   * BIND (clonal + substrate salience): each fact key (a DIM=64 immune_embed_key
//     vector) is bound via the LIVE consolidating_memory_bind_salient. The ENGINE's OWN
//     novelty split + LR-pull + LRU-evict run; the substrate salience tag (surprise =
//     recon-err at bind, novelty = split, tension = reinforce; salient inputs carry an
//     EXTRA surprise boost — an E+W property the substrate senses, NOT the label) is
//     computed inside the engine.
//   * SLEEP REPLAY (the lever): consolidating_sleep_replay internally replays `budget`
//     cells — UNIFORM (arm A) or ∝ the substrate salience tag (arm B) — refreshing their
//     recency so salient cells survive the LRU eviction the interference stream drives.
//     This is the substrate-GENERATED P47 imagination loop, not external re-presentation.
//   * RECALL (affinity fire-or-abstain): consolidating_memory_recall fires the nearest
//     cell's bound value iff recon-err <= recall_thr, else ABSTAIN (no fabrication).
//   * RNG: the engine's OWN deterministic LCG (consolidating_lcg_next / _gauss) drives the
//     replay draws + the σ=0.02 cue-noise at recall, so the engine run is reproducible.
//
// p6 GUARD (central, the load-bearing separation): salience is a SUBSTRATE SIGNAL
// (surprise/novelty/tension) computed in the engine; the "important" label is used ONLY
// to SCORE the metric here, NEVER fed into the bind / replay. The NEGATIVE CONTROL
// (consolidating_shuffle_salience: salience→replay permuted, decorrelated from importance)
// must stay BELOW the +0.10 bar while arm B clears it — proving the lift is salience-
// GATING, not raw replay budget. No decoder/weights/persona/ethics touched (p1/p2/p3/p6/p8).
//
// FROZEN FALSIFIER (the SAME pre-registered R3 bars — H_1285_R3_FREEZE.txt — NOT moved):
//   GREEN iff  (c1) B.imp-recall >= A.imp-recall + 0.10
//         AND  (c2) B-shuffle.imp-recall < A.imp-recall + 0.10   [gating, not budget]
//         AND  (c3) B.fabrication <= 0.10.
//
// SCALE HONESTY (a_toy_scale_recheck / a_scale_honest_scope): this engine-native run
// reproduces the R3 mirror DIRECTION (effect-size GREEN, Δ>=+0.10 with shuffle below
// bar) — it is NOT byte-exact to numpy's RNG (a deterministic LCG drives the engine),
// and the corpus/seed RNG differs, so the exact numbers are engine-native, not the
// mirror's 0.317/0.517/0.367. ONE corpus paradigm ("<subj> lives in <city>"), 3 seeds,
// TOY scale (40-cell repertoire, 60 facts). The VERDICT is the c1∧c2∧c3 ruling, scoped.

import "CORE/engine_cli.hexa"

// ── frozen R3 knobs (pre-registered; held at the R3 mirror values) ──────────────
let N_FACTS       = 60
let N_OUT         = 60
let N_IMPORTANT   = 20          // labeled subset — METRIC ONLY, never into the mechanism
let MAX_CELLS     = 40          // finite repertoire (R3 STRESS rung)
let SLEEP_CYCLES  = 30          // R3 pre-registered multi-night consolidation budget
let REPLAY_PER_CYC = 30         // replay budget per cycle (SAME all arms)
let INTERFERE_NEW = 24          // new interfering facts encoded during the sleep interleave
let KEY_NOISE     = 0.02        // STRESS cue-noise σ at recall
let RECALL_THR    = 0.30
let SALIENT_BOOST = 0.8         // env-salience amplitude added to the substrate SURPRISE term
let IMP_MARGIN    = 0.10
let FAB_BAR       = 0.10
let SEEDS         = [900, 901, 902]

// ── deterministic distinct-word picker (engine-native, no python export) ────────
// Generate N distinct 4-8 letter dict words via an LCG walk over the filtered list.
// Distinct subjects/cities ⇒ well-separated immune_embed_key vectors (load-bearing).
// Cap the filtered pool at POOL_CAP distinct 4-8 letter words — far more than the
// N_FACTS+N_OUT+interfere picks need, and bounds the interpreter's list-copy memory
// (the full 87k list is O(n^2) to build via append). Deterministic prefix of the dict.
let POOL_CAP = 4000
fn _filtered_words() -> [string] {
    let txt = read_file("/usr/share/dict/words")
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) && len(out) < POOL_CAP {
        let w = lines[i].trim()
        let n = byte_len(w)
        if n >= 4 && n <= 8 { out = out + [w] }
        i = i + 1
    }
    return out
}

// capitalize first byte (ASCII): subj/city are Capitalized in the paradigm.
fn _cap(w: string) -> string {
    let b = byte_len(w)
    if b == 0 { return w }
    let first = substring(w, 0, 1)
    let rest = substring(w, 1, b)
    let c = ord(first)
    if c >= 97 && c <= 122 {
        return _chr(c - 32) + rest
    }
    return w
}
fn _chr(c: int) -> string {
    // ASCII int -> 1-char string via a small lookup over A-Z.
    let up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let idx = c - 65
    if idx >= 0 && idx < 26 { return substring(up, idx, idx + 1) }
    return "?"
}

// pick `count` distinct indices into `pool` via LCG (skip collisions). Deterministic.
fn _pick_distinct(pool_len: int, count: int, seed: int) -> [int] {
    let mut taken = []          // chosen indices (small count, linear dedup is fine)
    let mut st = (seed * 2654435761) & 2147483647
    let mut got = 0
    while got < count {
        st = consolidating_lcg_next(st)
        let idx = st % pool_len
        // dedup
        let mut dup = false
        let mut k = 0
        while k < len(taken) {
            if taken[k] == idx { dup = true  break }
            k = k + 1
        }
        if !dup { taken = taken + [idx]  got = got + 1 }
    }
    return taken
}

// ── recall a subset with engine-native gaussian cue-noise; returns hit fraction ──
// threads the engine's LCG so the noise is deterministic + identical per arm/seed.
fn _recall_subset(mem: ConsolidatingMemory, subj: [string], city: [string],
                  idxs: [int], noise: float, rng0: int) -> float {
    let mut st = rng0
    let mut hits = 0
    let mut i = 0
    while i < len(idxs) {
        let q = subj[idxs[i]] + " lives in "
        let mut key = immune_embed_key(q)
        if noise > 0.0 {
            let mut d = 0
            while d < len(key) {
                let g = consolidating_lcg_gauss(st)
                st = to_int(g[1])
                key[d] = key[d] + noise * g[0]
                d = d + 1
            }
        }
        let r = consolidating_memory_recall(mem, key)
        if r == city[idxs[i]] { hits = hits + 1 }
        i = i + 1
    }
    return to_float(hits) / to_float(len(idxs))
}

// fabrication: out-of-store subjects that do NOT abstain (any fire = fabrication).
fn _fab_rate(mem: ConsolidatingMemory, out_subj: [string], noise: float, rng0: int) -> float {
    let mut st = rng0
    let mut fires = 0
    let mut i = 0
    while i < len(out_subj) {
        let q = out_subj[i] + " lives in "
        let mut key = immune_embed_key(q)
        if noise > 0.0 {
            let mut d = 0
            while d < len(key) {
                let g = consolidating_lcg_gauss(st)
                st = to_int(g[1])
                key[d] = key[d] + noise * g[0]
                d = d + 1
            }
        }
        let r = consolidating_memory_recall(mem, key)
        if r != "" { fires = fires + 1 }
        i = i + 1
    }
    return to_float(fires) / to_float(len(out_subj))
}

// ── run ONE arm: flat encode (each fact once, important = salient) interleaved with
//    interfering new facts + SLEEP cycles. Arms differ ONLY in replay allocation. ──
//   mode 0 = uniform sleep replay (A) · 1 = salience-gated (B) · 2 = shuffle (B-ctrl).
fn _run_arm(subj: [string], city: [string], out_subj: [string],
            enc_order: [int], inter_subj: [string], inter_city: [string],
            mode: int, seed: int, cfg: EngineConfig) -> ConsolidatingMemory {
    // seed the faculty at the first encoded fact (substrate salience for cell 0).
    let f0 = enc_order[0]
    let boost0 = if f0 < N_IMPORTANT { SALIENT_BOOST } else { 0.0 }
    let k0 = immune_embed_key(subj[f0] + " lives in ")
    // cell-0 salience: surprise(empty store -> 1.0 clamp) + boost + novelty(1.0).
    let sal0 = 1.0 + boost0 + 0.5
    let mut mem = consolidating_memory_new(k0, city[f0], sal0, MAX_CELLS)

    // WAKE: encode the rest of the taught facts ONCE (flat, no recurrence).
    let mut i = 1
    while i < len(enc_order) {
        let fi = enc_order[i]
        let boost = if fi < N_IMPORTANT { SALIENT_BOOST } else { 0.0 }
        let key = immune_embed_key(subj[fi] + " lives in ")
        mem = consolidating_memory_bind_salient(mem, key, city[fi], boost, cfg)
        i = i + 1
    }

    // p6 control: permute salience tags BEFORE the sleep loop (decorrelate from importance).
    if mode == 2 {
        mem = consolidating_shuffle_salience(mem, (seed * 31337 + 23) & 2147483647)
    }

    // interleaved SLEEP cycles + ongoing interference (the forgetting pressure).
    let gated = (mode >= 1)
    let mut replay_st = (seed * 2654435761) & 2147483647
    // per-cycle interfering slice — max(1, ...) EXACTLY as the R3 mirror, so the early
    // cycles each encode >=1 NEW fact (the forgetting pressure). With 24 interfere over
    // 30 cycles this is 1/cyc for the first 24 cycles, 0 after (lo>=INTERFERE_NEW).
    let mut per_cyc = INTERFERE_NEW / SLEEP_CYCLES
    if per_cyc < 1 { per_cyc = 1 }
    let mut c = 0
    while c < SLEEP_CYCLES {
        // encode a slice of NEW interfering facts (erodes the store via LRU eviction).
        let lo = c * per_cyc
        let mut hi = (c + 1) * per_cyc
        if hi > INTERFERE_NEW { hi = INTERFERE_NEW }
        let mut j = lo
        while j < hi {
            let ikey = immune_embed_key(inter_subj[j] + " lives in ")
            mem = consolidating_memory_bind_salient(mem, ikey, inter_city[j], 0.0, cfg)
            j = j + 1
        }
        // sleep consolidation pass — replay (uniform or salience-gated).
        replay_st = consolidating_lcg_next(replay_st)
        mem = consolidating_sleep_replay(mem, REPLAY_PER_CYC, replay_st, gated)
        c = c + 1
    }
    return mem
}

fn _f3(x: float) -> string {
    // format to 3 decimals.
    let scaled = to_float(to_int(x * 1000.0 + 0.5)) / 1000.0
    return to_string(scaled)
}

fn main() {
    println("=== H_1285 R4 — AMYGDALA CONSOLIDATION: salience-gated SLEEP REPLAY, ENGINE-NATIVE ===")
    println("    LIVE faculty = CORE/engine_cli.hexa ConsolidatingMemory (amygdala-consolidation lane).")
    println("    Reproduces the R3 mirror GREEN engine-native (a_engine_native_learning / a_verified_must_wire).")
    println("    N_FACTS=" + to_string(N_FACTS) + " (N_IMPORTANT=" + to_string(N_IMPORTANT)
            + " labeled, METRIC-ONLY)  SEEDS=" + to_string(SEEDS[0]) + "," + to_string(SEEDS[1]) + "," + to_string(SEEDS[2]))
    println("    max_cells=" + to_string(MAX_CELLS) + " sleep_cycles=" + to_string(SLEEP_CYCLES)
            + " replay/cyc=" + to_string(REPLAY_PER_CYC) + " interfere=" + to_string(INTERFERE_NEW)
            + " key_noise=" + _f3(KEY_NOISE) + " recall_thr=" + _f3(RECALL_THR))
    println("    (A) uniform sleep-replay  vs  (B) salience-gated sleep-replay  vs  (B-shuffle) permuted salience")
    println("    SAME replay budget all arms; arms differ ONLY in WHICH cells get replayed.")
    println("    PRE-REGISTERED GREEN: (B)imp >= (A)imp+" + _f3(IMP_MARGIN)
            + " AND (B-shuf)imp < (A)imp+" + _f3(IMP_MARGIN) + " AND (B)fab <= " + _f3(FAB_BAR))
    println("")

    let cfg = engine_config_default()      // mitosis ON (p8 — clonal split drives growth)
    let pool = _filtered_words()
    let pn = len(pool)

    let mut sumA = 0.0
    let mut sumB = 0.0
    let mut sumS = 0.0
    let mut sumFabB = 0.0
    let ns = len(SEEDS)

    let mut s = 0
    while s < ns {
        let seed = SEEDS[s]
        // pick distinct subjects + cities for in-store + out-of-store (deterministic LCG).
        let need = N_FACTS + N_OUT
        let subj_idx = _pick_distinct(pn, need, seed * 7919 + 1)
        let city_idx = _pick_distinct(pn, need, seed * 7919 + 1009)
        let mut subj = []
        let mut city = []
        let mut out_subj = []
        let mut k = 0
        while k < N_FACTS {
            subj = subj + [_cap(pool[subj_idx[k]])]
            city = city + [_cap(pool[city_idx[k]])]
            k = k + 1
        }
        let mut o = 0
        while o < N_OUT {
            out_subj = out_subj + [_cap(pool[subj_idx[N_FACTS + o]])]
            o = o + 1
        }
        // interfering NEW facts (use out-store words beyond the fab set, distinct pool slice).
        let inter_idx = _pick_distinct(pn, INTERFERE_NEW * 2, seed * 7919 + 5077)
        let mut inter_subj = []
        let mut inter_city = []
        let mut q = 0
        while q < INTERFERE_NEW {
            inter_subj = inter_subj + [_cap(pool[inter_idx[q]])]
            inter_city = inter_city + [_cap(pool[inter_idx[INTERFERE_NEW + q]])]
            q = q + 1
        }
        // flat encode order (interleaved so important cells present at sleep onset).
        let enc_order = _pick_distinct(N_FACTS, N_FACTS, seed * 104729 + 3)

        // important / out index lists for scoring.
        let mut imp_idx = []
        let mut ii = 0
        while ii < N_IMPORTANT { imp_idx = imp_idx + [ii]  ii = ii + 1 }

        let eval_noise_seed = (seed * 104729 + 7) & 2147483647
        let fab_noise_seed = (seed * 104729 + 199) & 2147483647

        let memA = _run_arm(subj, city, out_subj, enc_order, inter_subj, inter_city, 0, seed, cfg)
        let impA = _recall_subset(memA, subj, city, imp_idx, KEY_NOISE, eval_noise_seed)

        let memB = _run_arm(subj, city, out_subj, enc_order, inter_subj, inter_city, 1, seed, cfg)
        let impB = _recall_subset(memB, subj, city, imp_idx, KEY_NOISE, eval_noise_seed)
        let fabB = _fab_rate(memB, out_subj, KEY_NOISE, fab_noise_seed)

        let memS = _run_arm(subj, city, out_subj, enc_order, inter_subj, inter_city, 2, seed, cfg)
        let impS = _recall_subset(memS, subj, city, imp_idx, KEY_NOISE, eval_noise_seed)

        println("  seed " + to_string(seed)
                + ": (A uniform-replay) imp=" + _f3(impA)
                + " | (B salience-replay) imp=" + _f3(impB) + " fab=" + _f3(fabB)
                + " | (B-shuf) imp=" + _f3(impS))

        sumA = sumA + impA
        sumB = sumB + impB
        sumS = sumS + impS
        sumFabB = sumFabB + fabB
        s = s + 1
    }

    let mA = sumA / to_float(ns)
    let mB = sumB / to_float(ns)
    let mS = sumS / to_float(ns)
    let mFabB = sumFabB / to_float(ns)

    println("")
    println("  MEAN (A uniform-replay)  imp=" + _f3(mA))
    println("  MEAN (B salience-replay) imp=" + _f3(mB) + "  fab=" + _f3(mFabB))
    println("  MEAN (B-shuffle)         imp=" + _f3(mS) + "  [negative control: salience->replay decorrelated from importance]")
    println("  Δ important-recall (B-A) = " + _f3(mB - mA))

    let c1 = (mB >= mA + IMP_MARGIN)
    let c2 = (mS < mA + IMP_MARGIN)
    let c3 = (mFabB <= FAB_BAR)
    let c1s = if c1 { "PASS" } else { "FAIL" }
    let c2s = if c2 { "PASS" } else { "FAIL" }
    let c3s = if c3 { "PASS" } else { "FAIL" }
    println("  CHECK c1 imp-margin:   B " + _f3(mB) + " >= A " + _f3(mA) + "+" + _f3(IMP_MARGIN) + " -> " + c1s)
    println("  CHECK c2 shuffle-ctrl: B-shuf " + _f3(mS) + " < A " + _f3(mA) + "+" + _f3(IMP_MARGIN) + " -> " + c2s)
    println("  CHECK c3 fabrication:  B " + _f3(mFabB) + " <= " + _f3(FAB_BAR) + " -> " + c3s)

    let green = c1 && c2 && c3
    println("")
    if green {
        println("  FINAL VERDICT (R4 engine-native): 🟢 GREEN  [salience-gated SLEEP REPLAY clears +0.10 on the")
        println("  LIVE ConsolidatingMemory faculty WITH the shuffle below bar — the amygdala-consolidation")
        println("  pathway is realized ENGINE-NATIVE (a_verified_must_wire), reproducing the R3 mirror direction]")
    } else {
        println("  FINAL VERDICT (R4 engine-native): 🔴 RED  [engine-native run did NOT reproduce the R3 GREEN")
        println("  direction — see the per-check tally; honest engine-native finding, a_engine_native_learning]")
    }
    println("  philosophy guard: salience DERIVED from substrate (surprise/novelty/tension) at ENCODE, NOT a label;")
    println("  replay GENERATED internally by the sleep loop (P47, a_chat_sleep_imagination), not externally injected;")
    println("  B-shuffle decorrelates salience->replay from importance (c2 GATING control). No decoder/weights/persona/ethics.")
    println("[done]")
    if !green { exit(1) }
}
