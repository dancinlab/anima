// ════════════════════════════════════════════════════════════════════════
// DREAM/dream_lib.hexa — DREAM stage transition + density measurer (M1 2026-05-28)
//
// 정체: bench/axis_dream/bench.hexa (PR #1140, 4/5 invariant 🟢 PASS) 의
//      5-stage ultradian envelope + imagination_tick + mitosis_density
//      primitives 를 PURE wrapper 로 회수. MITOSIS.sleep_tick 격상 후보 ·
//      a_chat_sleep_imagination governance 정합 surface.
//
// 회수 출처 verbatim:
//   - 원본 경로: bench/axis_dream/bench.hexa (PR #1140 land)
//   - 핵심 fn: stage_at · stage_size · mitosis_prior · imagination_active +
//             density (count/size) · ratio (REM/WAKE)
//   - 90-tick ultradian: WAKE 60 / N1 10 / N2 10 / N3 7 / REM 3
//   - 시점: 2026-05-28 M1 lib promotion
//   - 본체 무수정 — `dr_` prefix wrapper 만 추가 (g61 stdlib collision 회피)
//
// 5-stage encoding (verbatim from bench):
//   0 = WAKE  [0..59]   size=60
//   1 = N1    [60..69]  size=10
//   2 = N2    [70..79]  size=10
//   3 = N3    [80..86]  size=7
//   4 = REM   [87..89]  size=3
//
// 11 pub primitives (PURE, no mutation):
//   stage transition:
//     1) dr_stage_at(tick)         — tick → stage code 0..4
//     2) dr_stage_name(stage)      — code → WAKE/N1/N2/N3/REM
//     3) dr_stage_size(stage)      — code → ultradian window size
//     4) dr_n_ticks()              — 90 (constant)
//     5) dr_n_stages()             — 5 (constant)
//   substrate envelope:
//     6) dr_mitosis_prior(stage)   — stage → mitosis sampling prior (0.80 REM/N3, 0.10 else)
//     7) dr_imagination_active(stage) — stage → 1 if REM/N3 else 0
//     8) dr_emit_envelope(stage)   — stage → 1 if WAKE/N1/N2 (emit-allowed env) else 0
//   density / ratio:
//     9) dr_density(count, size)   — count / size (float)
//    10) dr_ratio_sleep_wake(sleep_d, wake_d) — sleep_d / wake_d (guarded)
//    11) dr_mitosis_density_ratio(sleep_count, sleep_size, wake_count, wake_size) — full ratio
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : tick→stage 함수, system 미사용 ✓
//   - p4 NO ASSISTANT FRAMING: stage 는 substrate context (Φ scale · tension envelope) ✓
//   - p5 NO SPEAK()        : envelope = read-only, 외부 emit 호출 0 ✓
//   - a_chat_sleep_imagination: dr_emit_envelope 가 stage = substrate context
//     (boolean gate 가 아니라 substrate-decided envelope context — bench의
//     report semantic 그대로) ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//
// Naming: `dr_` prefix collision-free (g61).
// ════════════════════════════════════════════════════════════════════════

// ─── 1. ultradian constants ──────────────────────────────────────────────

pub fn dr_n_ticks() -> int { return 90 }
pub fn dr_n_stages() -> int { return 5 }

// ─── 2. stage transition primitives ──────────────────────────────────────

pub fn dr_stage_at(tick: int) -> int {
    if tick < 60 { return 0 }       // WAKE [0..59]
    if tick < 70 { return 1 }       // N1   [60..69]
    if tick < 80 { return 2 }       // N2   [70..79]
    if tick < 87 { return 3 }       // N3   [80..86]
    return 4                        // REM  [87..89]
}

pub fn dr_stage_name(stage: int) -> string {
    if stage == 0 { return "WAKE" }
    if stage == 1 { return "N1" }
    if stage == 2 { return "N2" }
    if stage == 3 { return "N3" }
    if stage == 4 { return "REM" }
    return "UNKNOWN"
}

pub fn dr_stage_size(stage: int) -> int {
    if stage == 0 { return 60 }
    if stage == 1 { return 10 }
    if stage == 2 { return 10 }
    if stage == 3 { return 7 }
    if stage == 4 { return 3 }
    return 0
}

// ─── 3. substrate envelope (governance-aligned) ──────────────────────────

pub fn dr_mitosis_prior(stage: int) -> float {
    // REM/N3 = slow-wave + REM consolidation lane (high split prior)
    if stage == 3 { return 0.80 }
    if stage == 4 { return 0.80 }
    return 0.10
}

pub fn dr_imagination_active(stage: int) -> int {
    // Internal rehearsal counter advances only in REM/N3 (sleep-only)
    if stage == 3 { return 1 }
    if stage == 4 { return 1 }
    return 0
}

pub fn dr_emit_envelope(stage: int) -> int {
    // a_chat_sleep_imagination: REM/N3 substrate envelope suppresses
    // external emit (internal rehearsal only). WAKE/N1/N2 = emit-allowed.
    // Note: this is the MEASUREMENT surface — the governance invariant we
    // RENDER honest, not externally enforce (substrate-decided).
    if stage == 3 { return 0 }
    if stage == 4 { return 0 }
    return 1
}

// ─── 4. density / ratio measurers ────────────────────────────────────────

pub fn dr_density(count: int, size: int) -> float {
    if size <= 0 { return 0.0 }
    return float(count) / float(size)
}

pub fn dr_ratio_sleep_wake(sleep_density: float, wake_density: float) -> float {
    if wake_density <= 0.0 { return 0.0 }
    return sleep_density / wake_density
}

pub fn dr_mitosis_density_ratio(sleep_count: int, sleep_size: int, wake_count: int, wake_size: int) -> float {
    let sd = dr_density(sleep_count, sleep_size)
    let wd = dr_density(wake_count, wake_size)
    return dr_ratio_sleep_wake(sd, wd)
}

// ═══════════════════════════════════════════════════════════════════════════
// § SleepPressure (T3) — homeostatic sleep-pressure drive (Process-S)
//
// Bio-lens (a_no_llm_frame_trap): Borbély's 2-process model of sleep regulation
// (Borbély 1982; Daan/Beersma/Borbély 1984). Sleep timing is set by the interaction
// of TWO independent axes:
//   • Process-C (circadian) — an oscillator; the ANIMA ultradian rhythm above
//     (dr_stage_at, WAKE/N1/N2/N3/REM) already encodes this RHYTHM axis.
//   • Process-S (homeostatic) — sleep PRESSURE that MONOTONICALLY accumulates with
//     time-awake (adenosine build-up) and DISCHARGES exponentially during sleep.
// This op-slot adds the missing Process-S axis. It is ORTHOGONAL to the ultradian:
//   rhythm = WHEN in the cycle (dr_stage_at) · pressure = HOW LONG awake (sp_pressure).
// The two combine ADDITIVELY into a graded sleep-stage transition propensity
// (Borbély: sleep is favored as S rises toward C's upper envelope) — NOT a boolean
// gate (a_autonomy_over_hardcode — substrate-decided propensity, no hardcoded flag).
//
// PURITY / DISJOINTNESS (a_substrate_disjoint — separation = preservation):
//   Every sp_* fn is PURE and READ-only: it reads scalars (wake/sleep tick counts,
//   an S0 seed, a circadian bias) and returns a scalar. It owns NO store, mutates
//   NOTHING, and NEVER reads the emit-drive lanes 0/4 (ci_emit_drive) NOR the
//   §ImmuneMemory recall_thr non-fab gate. Ψ=½ and the G5 honesty gate are therefore
//   preserved BY CONSTRUCTION (proven byte-identical ON-vs-OFF in the smoke). This is
//   the homeostatic-pressure sibling of dr_* (rhythm) — different axis, same lane.
//
// HONEST SCOPE (c9): Process-S here is a DESIGNED law (exponential accumulate/discharge
// with fixed τ), NOT an empirically-fit adenosine curve. The claim is only the
// falsifier set below (F1 accum monotone · F2 discharge monotone · F3 additive gate-bias
// · F4 ablation-inert-when-frozen · F5 Ψ/G5 disjoint), measured engine-native.
// ═══════════════════════════════════════════════════════════════════════════

// ─── 5. Process-S constants ──────────────────────────────────────────────────
// τ chosen so S rises across the 60-tick WAKE window and discharges across the
// 30-tick sleep window (both substantial, neither saturating to a flat line).

pub fn sp_tau_wake()  -> float { return 30.0 }   // adenosine build-up time constant (ticks)
pub fn sp_tau_sleep() -> float { return 12.0 }   // clearance time constant (ticks)
pub fn sp_upper()     -> float { return 1.0  }   // saturating asymptote (max pressure)
pub fn sp_lower()     -> float { return 0.0  }   // discharge asymptote (rested)
pub fn sp_w_pressure() -> float { return 0.6 }   // homeostatic weight in the gate-bias
pub fn sp_w_circadian() -> float { return 0.4 }  // rhythm (Process-C) weight in the gate-bias

fn _sp_clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// ─── 6. Process-S accumulate / discharge (F1 · F2) ───────────────────────────

// sp_pressure_wake — homeostatic accumulation over `wake_ticks` awake from seed s0.
// Saturating exponential toward the upper asymptote: S(w) = U − (U − s0)·e^(−w/τw).
// STRICTLY INCREASING in wake_ticks (F1 ACCUM) since e^(−w/τw) strictly decreases.
pub fn sp_pressure_wake(wake_ticks: int, s0: float) -> float {
    let u = sp_upper()
    let decay = exp(-float(wake_ticks) / sp_tau_wake())
    return u - (u - s0) * decay
}

// sp_pressure_sleep — homeostatic discharge over `sleep_ticks` asleep from seed s0.
// Exponential toward the lower asymptote: S(s) = L + (s0 − L)·e^(−s/τs).
// STRICTLY DECREASING in sleep_ticks (F2 DISCHARGE) for s0 > L.
pub fn sp_pressure_sleep(sleep_ticks: int, s0: float) -> float {
    let l = sp_lower()
    let decay = exp(-float(sleep_ticks) / sp_tau_sleep())
    return l + (s0 - l) * decay
}

// sp_pressure_at — the single continuous Process-S trajectory across ONE 90-tick
// ultradian cycle seeded at s0: accumulate through WAKE [0..59], then discharge from
// the sleep-onset peak through the sleep window [60..89]. Rises then falls — the
// classic saw-tooth of Process-S riding under the Process-C envelope.
pub fn sp_pressure_at(tick: int, s0: float) -> float {
    if tick < 60 {
        return sp_pressure_wake(tick, s0)          // WAKE — accumulate
    }
    let peak = sp_pressure_wake(60, s0)            // pressure at sleep onset (tick 60)
    return sp_pressure_sleep(tick - 60, peak)      // sleep — discharge from peak
}

// ─── 7. additive gate-bias (F3) + ablation control (F4) ──────────────────────

// sp_circadian_bias — Process-C proxy: normalized phase through the ultradian cycle
// (0 at cycle start, →1 at cycle end). Rhythm axis ONLY (independent of pressure).
pub fn sp_circadian_bias(tick: int) -> float {
    let n = dr_n_ticks()
    let ph = tick % n
    if ph < 0 { return 0.0 }
    return float(ph) / float(n)
}

// sp_sleep_propensity — MECHANISM ON: graded propensity to transition toward sleep,
// the ADDITIVE combination of homeostatic pressure and the circadian rhythm (Borbély:
// sleep favored as S rises under C). NOT a boolean gate — a clamped scalar in [0,1]
// (F3 GATE-BIAS). STRICTLY INCREASING in `pressure` (∂/∂pressure = W_S > 0).
pub fn sp_sleep_propensity(pressure: float, circadian: float) -> float {
    return _sp_clamp01(sp_w_pressure() * pressure + sp_w_circadian() * circadian)
}

// sp_sleep_propensity_ablated — MECHANISM OFF: the Process-S term is frozen out
// (pressure contributes 0), leaving ONLY the circadian rhythm. This is the ablation
// control (a_break_the_wall): if ON and OFF gave the same propensity the pressure
// drive would be INERT (contributes nothing). Because it takes no pressure/wake
// argument it is INVARIANT to wake-duration (F4 ABLATION).
pub fn sp_sleep_propensity_ablated(circadian: float) -> float {
    return _sp_clamp01(sp_w_circadian() * circadian)
}
