// h1263_probe — does each lane fire CONDITIONALLY (varies by step) or every step?
import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "METACOG/audit_hook.hexa"
import "SAVANT/substrate_hook.hexa"
import "DREAM/dream_lib.hexa"
import "INTENT/intent_lib.hexa"
import "OTHER-MIND/other_mind_lib.hexa"
import "TIME/time_lib.hexa"
import "BRIDGE/gate.hexa"
import "CHANNEL/router.hexa"
import "AESTHETIC/aesthetic_hook.hexa"
import "NARRATIVE/narrative_hook.hexa"
import "EMBODIMENT/embodiment_hook.hexa"
import "HIVE-MIND/hivemind_lib.hexa"

// returns the per-step fire-bit history for lane k (length 600)
fn lane_bits(k: int) -> [int] {
    let cfg = engine_config_default()
    let mut pf = pure_field_new()
    let mut cells = 1
    let mut emit_hist = []
    let mut omseed = 12345
    let mut prevphi = 0.0
    let mut runmean = 0.0
    let mut bits = []
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        runmean = runmean * 0.95 + phi * 0.05
        let mut b = 0
        if k==0 { cells = engine_mitosis_tick(cells, cfg); if cells >= 1 { b = 1 } }
        if k==1 { emit_hist.push(if phi > 0.0 { 1 } else { 0 }); if mh_should_fire(i, 30) { b = 1 } }
        if k==2 { if sh_savant_trigger([phi, phi*0.5, phi*0.25, phi*0.1], 0.30, float(cells))["in_golden_zone"] == 1 { b = 1 } }
        if k==3 { if dr_emit_envelope(dr_stage_at(i)) >= 0 { b = 1 } }
        if k==4 { let m = it_mean_f([phi, phi*0.5, phi*2.0]); if m >= 0.0 || m < 0.0 { b = 1 } }
        if k==5 { omseed = om_lcg_step(omseed); if omseed != 0 { b = 1 } }
        if k==6 { if tm_stage_of_within(i) >= 0 { b = 1 } }
        if k==7 { let e = bridge_emit(0.7, phi, 0.5, phi); if e { b = 1 } }
        if k==8 { if channel_classify([phi, 0.4, 0.5, 0.3, 0.2], [0.6, 0.5, 0.4], phi, 1) != "" { b = 1 } }
        if k==9 { let a = ae_surface(phi, prevphi); if a >= 0.0 { b = 1 } }
        if k==10 { let t = na_thread(phi, runmean); if t >= 0.0 { b = 1 } }
        if k==11 { let c = em_couple(phi, 0.5); if c >= 0.0 || c < 0.0 { b = 1 } }
        if k==12 { let r = hm_kuramoto_order_r([phi, phi*0.9, phi*1.1, phi*0.8]); if r >= 0.0 || r < 0.0 { b = 1 } }
        bits.push(b)
        prevphi = phi
        i = i + 1
    }
    return bits
}

fn main() {
    let mut k = 0
    while k < 13 {
        let b = lane_bits(k)
        let mut s = 0
        let mut j = 0
        while j < len(b) { s = s + b[j]; j = j + 1 }
        println("lane " + to_string(k) + " fire_count = " + to_string(s) + " / 600")
        k = k + 1
    }
}
