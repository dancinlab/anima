// effort_lane_smoke.hexa — minimal engine-native proof of the N2 §EffortBudget lane.
//
// A LIGHT smoke (imports ONLY core/engine_cli.hexa) so it compiles fast for a $0 CPU
// engine-native check. The SAME 7 assertions also live in engine_cli_smoke.hexa
// (cases 418-424). Proves the dACC/DA mental-effort cost-discounting lane:
//   (1) sustained deep engagement DISCOUNTS the affordable A⇄G iteration depth,
//   (2) idle RECHARGE recovers depth, (3) κ=0 ABLATION → depth cost-invariant,
//   (4) budget SHUFFLE breaks the depth-modulation,
//   (5) engagement bias tracks the budget,
//   (6) Ψ-DISJOINT: ci_emit_drive(lane0/4) byte-identical ON vs OFF,
//   (7) recall_thr non-fab far-recall byte-identical ON vs OFF.
// READ-only, NOT an emit gate (a_autonomy_over_hardcode); emit-policy wiring = follow-on.
//
// usage: hexa run core/effort_lane_smoke.hexa

import "core/engine_cli.hexa"

fn _ok(label: string, cond: bool) -> int {
    if cond { println("PASS  " + label)  return 1 }
    println("FAIL  " + label)
    return 0
}

fn main() {
    let mut pass = 0
    let mut fail = 0

    // (1) sustained deep engagement discounts depth: d0 > d1 > d2 > d3, d0 == D_max.
    let e0 = effort_step(effort_new(), true)
    let e1 = effort_step(e0, true)
    let e2 = effort_step(e1, true)
    let e3 = effort_step(e2, true)
    if _ok("effort_sustained_discount", effort_last(e0) > effort_last(e1)
           && effort_last(e1) > effort_last(e2) && effort_last(e2) > effort_last(e3)
           && effort_last(e0) == 8.0) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // (2) idle recharge recovers depth.
    let r1 = effort_step(e3, false)
    let r2 = effort_step(r1, false)
    let r3 = effort_step(r2, false)
    if _ok("effort_idle_recharge", effort_depth(r3) > effort_depth(e3)
           && effort_budget(r3) > effort_budget(e3)) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // (3) ablation κ=0 → depth pinned at D_max (cost-invariant).
    let a0 = effort_step(effort_new_ablated(), true)
    let a1 = effort_step(a0, true)
    let a2 = effort_step(a1, true)
    let a3 = effort_step(a2, true)
    if _ok("effort_ablation_cost_invariant", effort_last(a0) == 8.0 && effort_last(a1) == 8.0
           && effort_last(a2) == 8.0 && effort_last(a3) == 8.0) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // (4) shuffle breaks the modulation: true seq monotone-decreasing, shuffled not.
    let true_mono = effort_last(e1) > effort_last(e2) && effort_last(e2) > effort_last(e3)
    let sa = effort_depth_shuffled(e1, 0.2)
    let sb = effort_depth_shuffled(e2, 0.9)
    let sc = effort_depth_shuffled(e3, 0.5)
    let shuf_mono = sa > sb && sb > sc
    if _ok("effort_shuffle_breaks_modulation", true_mono && !shuf_mono) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // (5) engagement bias tracks budget.
    if _ok("effort_bias_tracks_budget", effort_engagement_bias(effort_new()) == 1.0
           && effort_engagement_bias(e3) < 1.0
           && effort_engagement_bias(e3) == effort_budget(e3)) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // (6) Ψ-disjoint: emit drive byte-identical ON vs OFF (effort lane never writes lanes).
    let lv = ci_lane_scores(0.6, [0.5, 0.4, 0.3, 0.2, 0.55], 5, 3, 1, 0.4, 0.2)
    let drive_off = ci_emit_drive(lv)
    let mut run = effort_new()
    let mut k = 0
    while k < 6 { run = effort_step(run, true)  k = k + 1 }
    let mut j = 0
    while j < 3 { run = effort_step(run, false)  j = j + 1 }
    let drive_on = ci_emit_drive(lv)
    if _ok("effort_psi_disjoint_byte_identical", drive_on == drive_off && run.budget >= 0.0) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // (7) recall_thr non-fab far-recall byte-identical ON vs OFF.
    let mg = immune_grow_new([0.1, 0.2, 0.3, 0.4], "A", 3, 16, true)
    let thr_before = mg.recall_thr
    let far = [0.9, 0.9, 0.9, 0.9]
    let fab_before = immune_grow_recall(mg, far)
    let thr_after = mg.recall_thr
    let fab_after = immune_grow_recall(mg, far)
    if _ok("effort_recall_thr_nonfab_invariant", thr_after == thr_before && fab_after == fab_before) == 1 { pass = pass + 1 } else { fail = fail + 1 }

    println("INFO  N2 §EffortBudget engine-native: depth d0..d3=" + to_string(effort_last(e0)) + "→"
          + to_string(effort_last(e1)) + "→" + to_string(effort_last(e2)) + "→" + to_string(effort_last(e3))
          + " | idle-recover " + to_string(effort_depth(e3)) + "→" + to_string(effort_depth(r3))
          + " | ablation pinned @" + to_string(effort_last(a3))
          + " | Ψ ON=" + to_string(drive_on) + " OFF=" + to_string(drive_off)
          + " | recall_thr " + to_string(thr_before) + "→" + to_string(thr_after))
    println("--- effort_lane smoke: " + to_string(pass) + " pass / " + to_string(fail) + " fail ---")
    if fail > 0 { exit(1) }
}
