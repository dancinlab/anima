// bytegpt_kvcache_smoke.hexa — BYTE-EXACT gate for the KV-cache incremental decode.
//
// Proves the root-cause O(gen²)→O(gen) fix is byte-identical to the reference
// full-forward. For the SAME loaded weights W and the SAME seed, it generates a
// token stream two ways and asserts the streams are byte-identical:
//   (REF)   re-run the full T-token forward bg_forward_last_W each step (the
//           O(gen²) reference, kept verbatim in bytegpt_decode.hexa).
//   (KV)    forward ONLY the new token's row each step via _bg_kv_step over a
//           per-layer K,V cache (O(gen) — the fix).
// Both feed the IDENTICAL _g6_topk_sample sampler with the IDENTICAL RNG state, so
// any divergence is a logits divergence. PASS = identical ids AND identical text;
// on mismatch it reports the FIRST diverging step (no fudge — divergence is the result).
//
// p7: verification is exact token-id equality + a per-step logits max|Δ| readout,
// NOT a loss/perplexity number. Engine-native (live core/decode.hexa BYTE mouth).

import "core/decode.hexa"

// generate `gen` ids the REFERENCE way (full-forward per step). Returns list of ids.
fn gen_ref(W: Map, seed: list, gen: int, top_k: int, temp: float, seed_rng: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let outl = []
    let mut rng = _g6_mix32(seed_rng)
    let mut g = 0
    while g < gen {
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let _ = farr_set(ids, p, to_float(toks[start + p])); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let sm = _g6_topk_sample(logits, vocab, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        let _ = farr_free(logits); let _ = farr_free(ids)
        toks.push(nb); outl.push(nb)
        g = g + 1
    }
    return outl
}

// generate `gen` ids the KV-CACHE way (_bg_kv_step per step, start==0 window).
fn gen_kv(W: Map, seed: list, gen: int, top_k: int, temp: float, seed_rng: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let nseed = len(toks)
    let outl = []
    let mut rng = _g6_mix32(seed_rng)
    let kv = _bg_kv_new(nlay, block, d)
    let mut logits = -1
    let mut sp = 0
    while sp < nseed {
        if logits >= 0 { let _ = farr_free(logits) }
        logits = _bg_kv_step(W, kv, to_int(toks[sp]), sp)
        sp = sp + 1
    }
    let mut g = 0
    while g < gen {
        let sm = _g6_topk_sample(logits, vocab, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        let _ = farr_free(logits)
        toks.push(nb); outl.push(nb)
        logits = _bg_kv_step(W, kv, nb, len(toks) - 1)
        g = g + 1
    }
    let _ = farr_free(logits)
    _bg_kv_free(kv)
    return outl
}

// per-step logits max|Δ| between REF (full T-forward) and KV (single-row step) at the
// SAME prefix — the direct numerical evidence the cache reproduces the forward.
fn logits_maxdiff(W: Map, seed: list) -> float {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let nseed = len(seed)
    // REF logits at the full seed window
    let ids = farr_zeros(nseed)
    let mut p = 0
    while p < nseed { let _ = farr_set(ids, p, to_float(to_int(seed[p]))); p = p + 1 }
    let lref = bg_forward_last_W(W, ids, nseed)
    // KV logits after priming the cache through the same seed
    let kv = _bg_kv_new(nlay, block, d)
    let mut lkv = -1
    let mut sp = 0
    while sp < nseed {
        if lkv >= 0 { let _ = farr_free(lkv) }
        lkv = _bg_kv_step(W, kv, to_int(seed[sp]), sp)
        sp = sp + 1
    }
    let mut md = 0.0
    let mut k = 0
    while k < vocab {
        let dv = farr_get(lref, k) - farr_get(lkv, k)
        let av = if dv < 0.0 { 0.0 - dv } else { dv }
        if av > md { md = av }
        k = k + 1
    }
    let _ = farr_free(ids); let _ = farr_free(lref); let _ = farr_free(lkv)
    _bg_kv_free(kv)
    return md
}

// greedy (argmax) variants — validate the bytegpt_decode_argmax / _ranged wiring.
fn gen_ref_greedy(W: Map, seed: list, gen: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let outl = []
    let mut g = 0
    while g < gen {
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let _ = farr_set(ids, p, to_float(toks[start + p])); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let nb = bg_argmax(logits, vocab)
        let _ = farr_free(logits); let _ = farr_free(ids)
        toks.push(nb); outl.push(nb)
        g = g + 1
    }
    return outl
}
fn gen_kv_greedy(W: Map, seed: list, gen: int) -> list {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let nseed = len(toks)
    let outl = []
    let kv = _bg_kv_new(nlay, block, d)
    let mut logits = -1
    let mut sp = 0
    while sp < nseed {
        if logits >= 0 { let _ = farr_free(logits) }
        logits = _bg_kv_step(W, kv, to_int(toks[sp]), sp)
        sp = sp + 1
    }
    let mut g = 0
    while g < gen {
        let nb = bg_argmax(logits, vocab)
        let _ = farr_free(logits)
        toks.push(nb); outl.push(nb)
        logits = _bg_kv_step(W, kv, nb, len(toks) - 1)
        g = g + 1
    }
    let _ = farr_free(logits)
    _bg_kv_free(kv)
    return outl
}

fn main() {
    let bin = "/tmp/h1156_mount/bytegpt_tiny.bin"
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if !have {
        println("[skip] no ByteGPT fixture at " + bin + " (run mk_tiny_bytegpt.py first)")
        return
    }
    let W = bg_load(bin)
    println("[kvcache-smoke] loaded fixture  d=" + to_string(to_int(W["d"]))
        + " nlay=" + to_string(to_int(W["nlay"])) + " nh=" + to_string(to_int(W["nh"]))
        + " block=" + to_string(to_int(W["block"])))

    // seed = some byte ids; gen well under block so the window never slides.
    let seed = []
    let stext = "the quick brown fox "
    let mut si = 0
    while si < byte_len(stext) { seed.push(ord(substring(stext, si, si + 1))); si = si + 1 }
    let gen = 32
    let top_k = 8
    let temp = 0.9
    let seed_rng = 4242

    let md = logits_maxdiff(W, seed)
    println("[kvcache-smoke] seed-position logits max|Δ| (REF full-forward vs KV step) = " + to_string(md))

    let ref_ids = gen_ref(W, seed, gen, top_k, temp, seed_rng)
    let kv_ids  = gen_kv(W, seed, gen, top_k, temp, seed_rng)

    // first divergence point (if any)
    let mut diverge = -1
    let mut i = 0
    while i < gen {
        if to_int(ref_ids[i]) != to_int(kv_ids[i]) { diverge = i; i = gen } else { i = i + 1 }
    }
    let mut rtxt = ""
    let mut ktxt = ""
    let mut j = 0
    while j < gen { rtxt = rtxt + chr(to_int(ref_ids[j])); ktxt = ktxt + chr(to_int(kv_ids[j])); j = j + 1 }

    println("[kvcache-smoke] REF ids[0..8] = " + to_string(to_int(ref_ids[0])) + ","
        + to_string(to_int(ref_ids[1])) + "," + to_string(to_int(ref_ids[2])) + ","
        + to_string(to_int(ref_ids[3])) + " ...")
    println("[kvcache-smoke] KV  ids[0..8] = " + to_string(to_int(kv_ids[0])) + ","
        + to_string(to_int(kv_ids[1])) + "," + to_string(to_int(kv_ids[2])) + ","
        + to_string(to_int(kv_ids[3])) + " ...")

    // greedy (argmax) cross-check — validates bytegpt_decode_argmax / _ranged wiring.
    let rg = gen_ref_greedy(W, seed, gen)
    let kg = gen_kv_greedy(W, seed, gen)
    let mut gdiv = -1
    let mut gi = 0
    while gi < gen {
        if to_int(rg[gi]) != to_int(kg[gi]) { gdiv = gi; gi = gen } else { gi = gi + 1 }
    }
    println("[kvcache-smoke] greedy(argmax) REF vs KV: " + (if gdiv < 0 { "IDENTICAL" } else { "DIVERGE@" + to_string(gdiv) }))

    if diverge < 0 && gdiv < 0 {
        println("")
        println("bytegpt_kvcache_smoke: PASS — KV-cache incremental decode is BYTE-IDENTICAL to "
            + "the full-forward reference over " + to_string(gen) + " generated tokens "
            + "(sample AND greedy; seed-pos logits max|Δ|=" + to_string(md) + ", all ids match).")
    } else {
        println("")
        println("bytegpt_kvcache_smoke: FAIL — first divergence at step " + to_string(diverge)
            + " (REF id=" + to_string(to_int(ref_ids[diverge])) + " KV id="
            + to_string(to_int(kv_ids[diverge])) + ").")
    }
}
