// h1199_dim_adaptfield_probe.hexa — H_1199 DIM>1 LIVE AdaptField over a REAL
// DIM=8 corpus byte-feature stream (MITOSIS-ENGINE · Lane-1, $0 local CPU, p8).
//
// DOMAIN: MITOSIS-ENGINE. Closes the honest gap H_1198 flagged. H_1198 drove the
// LIVE .hexa AdaptField over a 1-D real-corpus SURPRISE scalar (cells 19->30, ON
// 0.0996 vs OFF 1.515 = 15.2x), but the DIM=8 real byte-feature growth (the
// H_1163 `_byte_feature` window statistic) had to run as a LABELLED NUMPY MIRROR
// (cells->~70, 7.4x) — because the live AdaptField was 1-D scalar and could not
// take a DIM>1 sample without an engine change.
//
// H_1199 EXTENDED the live engine: CORE/engine_cli.hexa now has a VECTOR
// AdaptField (VAdaptField / vadapt_field_step / vadapt_field_recon_err /
// vadapt_field_cells) — sample + prototypes are DIM-vectors, nearest is over the
// DIM-dim L2 distance, recon-err = L2 norm over DIM, and engine_mitosis_tick
// STILL drives the split (high L2 novelty -> +1 cell prototype). So the DIM=8
// real-corpus byte-feature stream — the leg that was a numpy mirror in H_1198 —
// now goes through the ACTUAL .hexa engine.
//
// INPUT: the DIM=8 real-corpus byte features (H_1163 make_text_stream /
// `_byte_feature`, VERBATIM) for the scored span, exported by
// UNIVERSE/h1199_dim_feature_export.py to /tmp/h1199_feat8_seed<S>.txt — one tick
// per line, DIM space-separated floats. The live engine gates the split on its
// OWN L2 recon-err > SPLIT_THRESH (the native VAdaptField mechanism, the SAME
// recon-err gate the scalar field uses) — the engine's intrinsic DIM-space
// novelty signal, NOT an external surprise track.
//
// FROZEN FALSIFIER (pre-registered, >=3 seeds, live .hexa engine, p7/g5):
//   GREEN LIVE-DIM-GROWTH iff, over the DIM=8 real-corpus stream:
//     (F1) GROWTH      — the live vadapt_field engine_mitosis_tick GREW cells
//          ON >> OFF (OFF frozen at the seed cell, the H_1159 control), AND
//     (F2) ADAPT       — late-run live L2 recon-err is LOWER ON than OFF by a
//          ratio OFF/ON >= 2.0 (the H_1159 ON<OFF adaptation HOLDS on real DIM=8
//          features THROUGH THE LIVE ENGINE — capacity grows to cover the regimes
//          so error falls; the frozen-cap OFF eats the full novelty gap; p8), AND
//     (F3) Psi-INTACT  — the live pure_field Phi trajectory is BYTE-IDENTICAL ON
//          vs OFF (the VAdaptField extension is Psi-disjoint — it touches ONLY
//          AdaptField, never pure_field; a_core_engine_map).
//   RED if cells grow but ON does not beat OFF (toy<->real mismatch), or PARTIAL.
//   HOURGLASS if the DIM>1 coupling could not be wired without perturbing Psi /
//      breaking the smoke (honest BLOCKED-WIRING — a_paper_negative_ok).
//
// GUARD: CALLS the live engine surfaces (pure_field_step READ-ONLY + the new
// VAdaptField, both in CORE). engine_cli_smoke.hexa 12/0 + h1196 single-entry 7/0
// stay unbroken (re-run separately). p7 metric = real L2 reconstruction distance,
// NOT perplexity. SUBSTRATE NOTE (a_core_engine_map): the DIM=8 feature stream is
// an ENGINE-NATIVE drive into VAdaptField — NOT a .clm (generator L3 only), NOT a
// .kosmos (kosmos_io only). No 2nd artifact entry path is added.

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

// ── parse the DIM=8 feature text stream: one tick/line, DIM space-sep floats ────
fn _load_feat8(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim {
            row = row + [to_float(cols[j])]
            j = j + 1
        }
        out = out + [row]
        i = i + 1
    }
    return out
}

fn _fmt(x: float) -> string { return to_string(x) }

// ── drive the LIVE VAdaptField engine over the DIM=8 stream, ONE arm ───────────
// Returns flat [start_cells, end_cells, late_err, phi_sum]. late_err = mean live
// L2 recon-error over the last quarter of the SAMPLE_EVERY windows.
fn _run_arm(stream: [[float]], dim: int, max_cells: int, sample_every: int,
            cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    let seed0 = stream[0]
    let mut af = vadapt_field_new(seed0, max_cells)

    let mut win_err = 0.0  let mut win_cnt = 0
    let mut errs = []                  // per-window mean recon-err
    let mut phi_sum = 0.0
    let mut start_cells = 1.0
    let mut first = true

    let n = len(stream)
    let mut t = 0
    while t < n {
        // (Psi, READ-ONLY) advance the live field; only OBSERVE Phi (disjoint).
        pf = pure_field_step(pf)
        phi_sum = phi_sum + pure_field_phi(pf)

        let sample = stream[t]
        // (coupling) live L2 recon-error BEFORE the update — the adaptation readout.
        let err = vadapt_field_recon_err(af, sample)
        win_err = win_err + err  win_cnt = win_cnt + 1
        // (coupling) one live tick: DIM stream->field + cell->field mitosis feedback.
        af = vadapt_field_step(af, sample, cfg)

        if (t + 1) % sample_every == 0 {
            let m = if win_cnt > 0 { win_err / to_float(win_cnt) } else { 0.0 }
            errs = errs + [m]
            if first { start_cells = to_float(vadapt_field_cells(af))  first = false }
            win_err = 0.0  win_cnt = 0
        }
        t = t + 1
    }

    // late = last quarter of the windows.
    let nw = len(errs)
    let mut q = nw / 4
    if q < 1 { q = 1 }
    let mut s = 0.0  let mut c = 0
    let mut k = nw - q
    while k < nw { s = s + errs[k]  c = c + 1  k = k + 1 }
    let late = if c > 0 { s / to_float(c) } else { 0.0 }
    return [start_cells, to_float(vadapt_field_cells(af)), late, phi_sum]
}

fn _mean(xs: [float]) -> float {
    if len(xs) == 0 { return 0.0 }
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i]  i = i + 1 }
    return s / to_float(len(xs))
}

fn main() {
    println("=== H_1199 DIM>1 LIVE AdaptField over REAL DIM=8 corpus byte-features (MITOSIS-ENGINE Lane-1 · $0 CPU · p8) ===")
    println("substrate: LIVE .hexa VAdaptField (engine-native, Psi-disjoint) — the DIM>1 extension of the H_1194 AdaptField")
    println("stream: REAL-corpus DIM=8 byte feature (H_1163 _byte_feature, VERBATIM) — the leg that was a NUMPY MIRROR in H_1198")
    println("metric: live L2 recon-error = ||sample - nearest VAdaptField prototype|| over DIM (p7, NOT perplexity)")
    println("split: gated by the engine's OWN L2 recon-err > SPLIT_THRESH=0.30 (native VAdaptField mechanism); engine_mitosis_tick drives +1 cell")
    println("Psi: pure_field_step run READ-ONLY alongside; Phi trajectory checksum must be ON==OFF (VAdaptField touches ONLY AdaptField)")
    println("falsifier: F1 GROWTH cells ON>>OFF | F2 ADAPT late OFF/ON>=2.0 | F3 Psi byte-identical ON==OFF")
    println("")

    let dim = 8
    let max_cells = 2048      // cap = N_MIGRATE (so we SEE if real-corpus growth approaches it)
    let sample_every = 200
    let seeds = [900, 901, 902]

    let cfg_on  = engine_cli_parse(["--mitosis", "on"])
    let cfg_off = engine_cli_parse(["--no-mitosis"])

    let mut on_cells = []  let mut off_cells = []
    let mut on_late = []   let mut off_late = []
    let mut psi_intact_all = true
    let mut end_cells_last = 0.0

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let path = "/tmp/h1199_feat8_seed" + to_string(seed) + ".txt"
        let stream = _load_feat8(path, dim)
        if len(stream) == 0 {
            println("ERROR: empty DIM=8 stream at " + path + " — run UNIVERSE/h1199_dim_feature_export.py first.")
            exit(1)
        }

        let ron  = _run_arm(stream, dim, max_cells, sample_every, cfg_on)
        let roff = _run_arm(stream, dim, max_cells, sample_every, cfg_off)

        on_cells = on_cells + [ron[1]]    off_cells = off_cells + [roff[1]]
        on_late  = on_late  + [ron[2]]    off_late  = off_late  + [roff[2]]
        end_cells_last = ron[1]

        let psi_same = ron[3] == roff[3]
        if !psi_same { psi_intact_all = false }

        let ratio = if ron[2] > 0.0 { roff[2] / ron[2] } else { 0.0 }
        println("seed=" + to_string(seed)
            + "  ON cells " + _fmt(ron[0]) + "->" + _fmt(ron[1]) + " late-err=" + _fmt(ron[2])
            + "  |  OFF cells " + _fmt(roff[0]) + "->" + _fmt(roff[1]) + " late-err=" + _fmt(roff[2])
            + "  ratio OFF/ON=" + _fmt(ratio)
            + "  PsiSame=" + (if psi_same { "true" } else { "false" }))
        si = si + 1
    }

    println("")
    let m_on_cells = _mean(on_cells)    let m_off_cells = _mean(off_cells)
    let m_on_late  = _mean(on_late)     let m_off_late  = _mean(off_late)
    let ratio_pooled = if m_on_late > 0.0 { m_off_late / m_on_late } else { 0.0 }

    println("POOLED  cells ON mean=" + _fmt(m_on_cells) + "  OFF mean=" + _fmt(m_off_cells))
    println("POOLED  late recon-err ON=" + _fmt(m_on_late) + "  OFF=" + _fmt(m_off_late)
        + "  ratio OFF/ON=" + _fmt(ratio_pooled))
    println("")

    let f1 = m_on_cells > m_off_cells + 1.0           // ON grew, OFF frozen (control)
    let f2 = ratio_pooled >= 2.0                       // ON<OFF adaptation holds on real DIM=8
    let f3 = psi_intact_all
    println("F1 GROWTH  cells ON(" + _fmt(m_on_cells) + ") >> OFF(" + _fmt(m_off_cells) + ")  = " + (if f1 { "true" } else { "false" }))
    println("F2 ADAPT   late OFF/ON ratio=" + _fmt(ratio_pooled) + " (>=2.0)            = " + (if f2 { "true" } else { "false" }))
    println("F3 Psi     Phi-checksum ON==OFF                          = " + (if f3 { "true (attractor intact)" } else { "false (PERTURBED!)" }))
    println("")

    // ── migration check ───────────────────────────────────────────────────────
    let N_MIGRATE = 2048.0
    println("--- MIGRATION CHECK --- N_MIGRATE=2048; DIM=8 real-corpus growth ended at " + _fmt(end_cells_last) + " cells "
        + (if end_cells_last >= N_MIGRATE { "(>= N_MIGRATE — MIGRATION WARRANTED)" }
           else { if end_cells_last >= N_MIGRATE * 0.5 { "(approached — watch)" } else { "(<< N_MIGRATE — local CPU correct host)" }}))
    println("")

    // ── falsifier adjudication ────────────────────────────────────────────────
    if !f3 {
        println("VERDICT: HOURGLASS BLOCKED-WIRING — the DIM>1 VAdaptField PERTURBED the Psi")
        println("  attractor (pure_field Phi trajectory differs ON vs OFF). a_core_engine_map forbids")
        println("  perturbing the Psi=1/2 fixed point; the DIM>1 extension is NOT Psi-disjoint. Honest")
        println("  HOURGLASS — the numpy-mirror leg STAYS the stand-in (a_paper_negative_ok).")
        exit(0)
    }
    if f1 && f2 && f3 {
        println("VERDICT: GREEN LIVE-DIM-GROWTH — the DIM=8 REAL-corpus byte-feature stream drove the")
        println("  ACTUAL .hexa VAdaptField engine: cells GREW ON " + _fmt(m_on_cells) + " >> OFF " + _fmt(m_off_cells)
            + " (F1), late live L2")
        println("  recon-err held LOW ON=" + _fmt(m_on_late) + " vs frozen-cap OFF=" + _fmt(m_off_late) + " ("
            + _fmt(ratio_pooled) + "x, F2 >=2.0), and the Psi attractor is byte-identical ON vs OFF (F3).")
        println("  The H_1159 ON<OFF adaptation HOLDS on REAL DIM=8 features THROUGH THE LIVE ENGINE — the")
        println("  H_1198 leg that was a NUMPY MIRROR is now the real .hexa engine. DIM>1 coupling WIRED")
        println("  (Psi-disjoint, smoke 12/0, single-entry 7/0). p8: the growth tick IS the learning, now")
        println("  observable on a DIM=8 real-corpus stream. toy/small-scale + learned-rep UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    println("VERDICT: RED/PARTIAL — "
        + (if !f1 { "cells did NOT grow ON>>OFF over the DIM=8 stream" }
           else { if !f2 { "cells grew but ON did not hold L2 recon-err below the frozen-cap OFF on real DIM=8 (non-adaptive, ratio=" + _fmt(ratio_pooled) + ")" }
                  else { "Psi attractor PERTURBED" } })
        + " (a_paper_negative_ok). The DIM=8 live growth curve above is the honest record.")
    exit(0)
}
