import "CORE/bytegpt_decode.hexa"
fn _bytes_of(s: string) -> list {
    let out = []; let n = byte_len(s); let mut i = 0
    while i < n { out.push(ord(substring(s, i, i + 1))); i = i + 1 }
    return out
}
fn main() {
    // ONE forward: argmax of "The quick brown" must == torch 32 (and gen1 first byte == 32)
    let bin = "/tmp/h1218_mount/bytegpt_chat_full.bin"
    let r = bytegpt_decode_argmax(bin, _bytes_of("The quick brown"), 1)
    println("ENGINE_argmax1_ids=" + to_string(r["ids"]))
}
