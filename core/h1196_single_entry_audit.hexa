// h1196_single_entry_audit.hexa — a_core_engine_map SINGLE-ENTRY guard probe.
//
// MITOSIS-ENGINE Lane-2 LIVE rung H_1196. This is an AUDIT + GUARD, not a
// feature: it asserts — over the REAL CORE source — that the two named entry
// invariants of a_core_engine_map actually hold, so a future edit that adds a
// 2nd .clm / .kosmos path (or leaks one into the substrate engines) FAILS here.
//
// The directive a_core_engine_map states:
//   · .clm enters CORE ONLY via the generator.hexa L3 slot (the single .clm
//     decode entry: `use "CORE/clm_decode"` lives ONLY in generator.hexa).
//   · .kosmos anchors enter ONLY via kosmos_io read into brain_decide
//     (load_anchors is called ONLY by generator_read_anchors).
//   · Engine A (pure_field) ⇄ G (engine_g) ⇄ brain stay substrate-only — they
//     consume NO .clm / .kosmos (no clm_decode / kosmos_io import, no
//     load_anchors / clm_decode call).
//
// HONEST scope (a_core_engine_map: "no phantom wiring"): this probe does NOT
// claim wiring that is not there. It reports, verbatim, which paths are WIRED
// (the .clm L3 decode slot + the .kosmos read) and treats the standalone OMEGA
// probe (CORE/omega_clm_closure_probe.hexa) as the documented MEASUREMENT
// harness it is — it has its own fn main(), is imported by 0 files, and is NOT
// in any runtime engine import graph, so it is NOT a 2nd runtime .clm path. The
// guard asserts exactly that: the clm_decode importer set, minus that lone
// standalone probe, is the single file generator.hexa.
//
// METHOD (p7 — count/string equality over source, NOT perplexity/loss): each
// assertion shells out a deterministic grep over the checked-in .hexa files and
// compares the integer hit-count / file-set against the frozen expectation. $0,
// CPU, no GPU, no LLM, no model load — pure structural invariant checking.
//
// ── p1..p8 conformance ──────────────────────────────────────────────────────
//   p1/p2/p3/p4 — no prompt/identity/persona/assistant framing; pure source grep.
//   p5 NO SPEAK() — emits nothing through the engine; it inspects the code only.
//   p6 — zero weights.
//   p7 — verification = integer equality on grep counts (deterministic), not loss.
//   p8 — train/infer agnostic; it never runs the engine, only audits its wiring.

// _hits — count source lines matching a grep -E pattern across the given files.
// Deterministic: same source ⇒ same count. Comments are INCLUDED by grep, so
// every pattern is written to match a CODE token (import/use/call) that is
// unambiguous against prose; counts below are the frozen CODE-line truth.
// This audit file is EXCLUDED from every scan — its own assertion strings name
// clm_decode / load_anchors as audit targets, which would otherwise self-match
// and falsely trip the single-entry counts. The invariant ranges over the
// engine source, NOT the guard that checks it.
fn _self() -> string { return "h1196_single_entry_audit.hexa" }

fn _hits(pattern: string, files: string) -> int {
    let cmd = "grep -hcE --exclude='" + _self() + "' '" + pattern + "' " + files
        + " 2>/dev/null | awk '{s+=$1} END{print s+0}'"
    let r = exec(cmd)
    return to_int(r.trim())
}

// _files_matching — the sorted, comma-joined list of files (basenames) that
// contain at least one match for the pattern (grep -l). Used to assert the
// EXACT importer SET, not just a count. A trailing comma (tr artifact) is
// stripped so the set string is stable.
fn _files_matching(pattern: string, glob: string) -> string {
    let cmd = "grep -lE --exclude='" + _self() + "' '" + pattern + "' " + glob
        + " 2>/dev/null | xargs -n1 basename 2>/dev/null | sort | paste -sd, -"
    let r = exec(cmd)
    return r.trim()
}

fn _assert_i(label: string, want: int, got: int, n_pass: int, n_fail: int) -> [int] {
    if want == got {
        println("PASS  " + label + " want=" + to_string(want) + " got=" + to_string(got))
        return [n_pass + 1, n_fail]
    }
    println("FAIL  " + label + " want=" + to_string(want) + " got=" + to_string(got))
    return [n_pass, n_fail + 1]
}

fn _assert_s(label: string, want: string, got: string, n_pass: int, n_fail: int) -> [int] {
    if want == got {
        println("PASS  " + label + " want=\"" + want + "\" got=\"" + got + "\"")
        return [n_pass + 1, n_fail]
    }
    println("FAIL  " + label + " want=\"" + want + "\" got=\"" + got + "\"")
    return [n_pass, n_fail + 1]
}

fn main() {
    println("=== H_1196 a_core_engine_map SINGLE-ENTRY audit + guard (MITOSIS-ENGINE Lane-2) ===")
    println("method: deterministic source grep over checked-in CORE/*.hexa (p7 count-equality, $0 CPU)")
    println("")

    let mut np = 0
    let mut nf = 0

    // The file groups the invariants range over.
    let core_glob = "CORE/*.hexa"
    let substrate = "CORE/pure_field.hexa CORE/engine_g.hexa CORE/brain.hexa"

    // ── INVARIANT 1 — the .clm decode entry is SINGLE (generator.hexa) ─────────
    // `use "CORE/clm_decode"` (or import of clm_decode.hexa) appears in EXACTLY
    // the runtime slot generator.hexa + the one standalone OMEGA probe. The
    // runtime-path importer SET, minus that probe, MUST be {generator.hexa}.
    let clm_import_files = _files_matching("(use|import)[[:space:]].*clm_decode", core_glob)
    let r1 = _assert_s("inv1a_clm_decode_importers_are_generator+omegaprobe_only",
                       "generator.hexa,omega_clm_closure_probe.hexa", clm_import_files, np, nf)
    np = r1[0]; nf = r1[1]

    // The OMEGA probe is a STANDALONE measurement harness: imported by 0 files,
    // so it is NOT a 2nd runtime .clm path (a_core_engine_map honest carve-out).
    let omega_probe_importers = _hits("(use|import)[[:space:]].*omega_clm_closure_probe", core_glob)
    let r1b = _assert_i("inv1b_omega_probe_imported_by_zero_files_standalone",
                        0, omega_probe_importers, np, nf)
    np = r1b[0]; nf = r1b[1]

    // ── INVARIANT 2 — the .kosmos read entry is SINGLE (generator_read_anchors) ─
    // load_anchors() is DEFINED in kosmos_io and CALLED from exactly one CORE
    // site: generator.hexa::generator_read_anchors. Assert the CALL appears in
    // exactly generator.hexa among CORE/*.hexa (the call line `load_anchors(`).
    let kosmos_call_files = _files_matching("[^a-zA-Z_]load_anchors\\(", core_glob)
    let r2 = _assert_s("inv2_load_anchors_called_only_in_generator",
                       "generator.hexa", kosmos_call_files, np, nf)
    np = r2[0]; nf = r2[1]

    // ── INVARIANT 3 — substrate engines consume NO .clm (no clm_decode entry) ──
    // pure_field / engine_g / brain MUST NOT import clm_decode nor call its
    // decode forward (clm_decode_argmax / clm_decode_ce / clm_forward_ce).
    let clm_in_substrate = _hits("(use|import)[[:space:]].*clm_decode|clm_decode_argmax|clm_decode_ce|clm_forward_ce", substrate)
    let r3 = _assert_i("inv3_substrate_engines_no_clm", 0, clm_in_substrate, np, nf)
    np = r3[0]; nf = r3[1]

    // ── INVARIANT 4 — substrate engines consume NO .kosmos (no kosmos_io entry) ─
    // pure_field / engine_g / brain MUST NOT import kosmos_io nor call its read
    // API (load_anchors / create_anchor). brain reaches anchors ONLY as a plain
    // `anchors` arg threaded from generator — never by importing the reader.
    let kosmos_in_substrate = _hits("(use|import)[[:space:]].*kosmos_io|[^a-zA-Z_]load_anchors\\(|[^a-zA-Z_]create_anchor\\(", substrate)
    let r4 = _assert_i("inv4_substrate_engines_no_kosmos", 0, kosmos_in_substrate, np, nf)
    np = r4[0]; nf = r4[1]

    // ── INVARIANT 5 — generator.hexa IS the .clm decode + .kosmos read slot ────
    // POSITIVE wiring assertion (honest, the path that IS built): generator.hexa
    // both imports clm_decode (the decode forward) AND calls load_anchors (the
    // anchor read). This is the single named slot a_core_engine_map prescribes.
    let gen_has_clm    = _hits("(use|import)[[:space:]].*clm_decode", "CORE/generator.hexa")
    let gen_has_kosmos = _hits("[^a-zA-Z_]load_anchors\\(", "CORE/generator.hexa")
    let r5a = _assert_i("inv5a_generator_imports_clm_decode", 1, gen_has_clm, np, nf)
    np = r5a[0]; nf = r5a[1]
    // load_anchors appears twice in generator.hexa: the call site + the summary
    // doc string. The invariant is "≥1 call in the slot"; assert the call exists.
    let r5b = _assert_i("inv5b_generator_calls_load_anchors_ge1",
                        if gen_has_kosmos >= 1 { 1 } else { 0 }, 1, np, nf)
    np = r5b[0]; nf = r5b[1]

    println("")
    println("--- single-entry audit summary: " + to_string(np) + " pass / " + to_string(nf) + " fail ---")
    println("WIRED:   .clm decode L3 slot = generator.hexa (use CORE/clm_decode) · .kosmos read = generator_read_anchors→load_anchors→brain_emit anchors arg")
    println("HONEST:  CORE/omega_clm_closure_probe.hexa = standalone measurement probe (own fn main, 0 importers) — NOT a 2nd runtime .clm path")
    println("CLEAN:   pure_field/engine_g/brain consume 0 .clm + 0 .kosmos (substrate-only)")
    if nf > 0 { exit(1) }
}
