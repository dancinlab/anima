// h1288_grow_under_pressure_probe.hexa — ENGINE-NATIVE realization of H_1288 R1
// (a_engine_native_learning + a_verified_must_wire).
//
// R1 (numpy VAdaptField mirror, 🟢 GREEN, 3 seeds) showed the immune/episodic
// memory's ~0.667 total-recall ceiling under CAPACITY STRESS is a ZERO-SUM /
// FIXED-BUDGET artifact, broken substrate-natively by MITOSIS CELL-GROWTH under
// pressure (p8) — NOT by a smarter eviction heuristic (R1 arm C = no lift). This
// probe reproduces that GREEN through the LIVE engine faculty
// CORE/engine_cli.hexa::ImmuneMemoryGrow (immune_grow_new/bind/recall), so the bind
// (clonal split) + recall (L2 affinity) arithmetic runs on the .hexa engine, not
// numpy. The keys are the EXACT R1 regime (FNV-1a DIM=64, taught order, noisy queries)
// pre-exported by UNIVERSE/h1288_r2_engine_export.py — byte-identical to R1's mirror.
//
// TWO ARMS through ONE faculty, differing ONLY in the capacity policy:
//   (A) LRU-EVICT  : grow_mode=false, base_max=STRESS_MAX_CELLS=40 << 60 facts
//                    (the CURRENT zero-sum store; ~0.667 R1 ceiling).
//   (B) MITOSIS-GROW: grow_mode=true,  base_max=40, grow_max=GROW_MAX_CELLS=80
//                    (grow a new cell under pressure instead of evicting, p8).
//
// FROZEN BARS (R1, unmoved): GREEN iff (B) total recall >= (A) + REC_MARGIN 0.05
//   AND (B) fab <= FAB_BAR 0.10 (abstain intact, H_1227 load-bearing). Cell-count
//   COST reported honestly (growth trades footprint for recall). p7 = exact-match
//   recall + abstain, NOT perplexity. $0 CPU. Ψ-disjoint (the faculty only reads/grows
//   a cell population; this probe never touches pure_field).

import "CORE/engine_cli.hexa"

// frozen regime knobs (VERBATIM from UNIVERSE/h1288_eviction_policy.py R1)
fn _STRESS_MAX_CELLS() -> int { return 40 }   // << 60 facts — the EVICTION-BOUND rung
fn _GROW_MAX_CELLS() -> int   { return 80 }   // generous FINITE growth bound (>= N_FACTS)
fn _REC_MARGIN() -> float     { return 0.05 } // (B) must beat (A) by >= this margin
fn _FAB_BAR() -> float        { return 0.10 } // (B) fab on untaught (abstain intact)

fn _load_vecs(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_strs(path: string) -> [string] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [lines[i].trim()]  i = i + 1 }
    return out
}
fn _fmt(x: float) -> string { return to_string(x) }

// run ONE arm (grow_mode picks policy) on ONE seed through the LIVE faculty.
// returns [tot_recall, imp_recall, fab_rate, n_cells] as floats.
fn _run_arm(grow_mode: bool, fk: [[float]], fv: [string], imp: [string],
            qk: [[float]], qt: [string], ok2: [[float]], cfg: EngineConfig) -> [float] {
    let nf = len(fk)
    // BIND all facts IN TAUGHT ORDER through the engine's OWN clonal split + policy.
    let mut m = immune_grow_new(fk[0], fv[0], _STRESS_MAX_CELLS(), _GROW_MAX_CELLS(), grow_mode)
    let mut b = 1
    while b < nf { m = immune_grow_bind(m, fk[b], fv[b], cfg)  b = b + 1 }

    // total recall + important (first-tercile) recall on the held-out NOISY queries.
    let mut tot_hits = 0
    let mut imp_hits = 0
    let mut imp_n = 0
    let mut qi = 0
    while qi < len(qk) {
        let got = immune_grow_recall(m, qk[qi])
        let hit = (got == qt[qi])
        if hit { tot_hits = tot_hits + 1 }
        if imp[qi] == "1" {
            imp_n = imp_n + 1
            if hit { imp_hits = imp_hits + 1 }
        }
        qi = qi + 1
    }
    // fabrication on untaught (must ABSTAIN -> "").
    let mut fab_hits = 0
    let mut oi = 0
    while oi < len(ok2) {
        if immune_grow_recall(m, ok2[oi]) != "" { fab_hits = fab_hits + 1 }
        oi = oi + 1
    }
    let tot = if nf > 0 { to_float(tot_hits) / to_float(nf) } else { 0.0 }
    let impr = if imp_n > 0 { to_float(imp_hits) / to_float(imp_n) } else { 0.0 }
    let fab = if len(ok2) > 0 { to_float(fab_hits) / to_float(len(ok2)) } else { 0.0 }
    return [tot, impr, fab, to_float(immune_grow_cells(m))]
}

fn main() {
    println("=== H_1288 R2 — GROW-UNDER-PRESSURE immune memory on the LIVE engine (a_engine_native_learning) ===")
    println("faculty: CORE/engine_cli.hexa::ImmuneMemoryGrow (immune_grow_new/bind/recall; engine's OWN clonal split + L2 affinity)")
    println("regime = H_1288 R1 EVICTION-BOUND zero-sum rung: base_max=" + to_string(_STRESS_MAX_CELLS())
        + " << 60 facts, grow_max=" + to_string(_GROW_MAX_CELLS()) + " (finite, p8), noisy held-out queries")
    println("(A) LRU-EVICT (grow off) vs (B) MITOSIS-GROW (grow on) — same faculty, capacity policy only")
    println("FROZEN GREEN: (B)total >= (A)+" + _fmt(_REC_MARGIN()) + "  AND  (B)fab <= " + _fmt(_FAB_BAR()))
    println("")

    let cfg = engine_cli_parse(["--mitosis", "on"])   // mitosis ON — the engine clones cells (p8)
    let dim = 64
    let seeds = [900, 901, 902]

    let mut sumA = [0.0, 0.0, 0.0, 0.0]
    let mut sumB = [0.0, 0.0, 0.0, 0.0]
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let base = "/tmp/h1288_seed" + to_string(s)
        let fk  = _load_vecs(base + ".instore.keys", dim)
        let fv  = _load_strs(base + ".instore.vals")
        let imp = _load_strs(base + ".imp")
        let qk  = _load_vecs(base + ".query.keys", dim)
        let qt  = _load_strs(base + ".query.truth")
        let ok2 = _load_vecs(base + ".out.keys", dim)

        let a = _run_arm(false, fk, fv, imp, qk, qt, ok2, cfg)   // LRU-EVICT
        let bb = _run_arm(true,  fk, fv, imp, qk, qt, ok2, cfg)  // MITOSIS-GROW

        let mut z = 0
        while z < 4 { sumA[z] = sumA[z] + a[z]  sumB[z] = sumB[z] + bb[z]  z = z + 1 }

        println("seed " + to_string(s) + ": "
            + "(A LRU) tot=" + _fmt(a[0]) + " imp=" + _fmt(a[1]) + " fab=" + _fmt(a[2]) + " cells=" + _fmt(a[3])
            + " | (B GROW) tot=" + _fmt(bb[0]) + " imp=" + _fmt(bb[1]) + " fab=" + _fmt(bb[2]) + " cells=" + _fmt(bb[3]))
        si = si + 1
    }

    let n = to_float(len(seeds))
    let aT = sumA[0] / n  let aI = sumA[1] / n  let aF = sumA[2] / n  let aC = sumA[3] / n
    let bT = sumB[0] / n  let bI = sumB[1] / n  let bF = sumB[2] / n  let bC = sumB[3] / n

    println("")
    println("  MEAN (A LRU-EVICT)    tot=" + _fmt(aT) + " imp=" + _fmt(aI) + " fab=" + _fmt(aF) + " cells=" + _fmt(aC))
    println("  MEAN (B MITOSIS-GROW) tot=" + _fmt(bT) + " imp=" + _fmt(bI) + " fab=" + _fmt(bF) + " cells=" + _fmt(bC))
    println("  Δ total recall (B-A) = " + _fmt(bT - aT) + "   cell-count cost: B " + _fmt(bC) + " vs A " + _fmt(aC) + " (Δ=" + _fmt(bC - aC) + ")")
    println("")

    let c1 = (bT >= aT + _REC_MARGIN())   // growth breaks the zero-sum
    let c2 = (bF <= _FAB_BAR())           // abstain intact (H_1227)
    let green = c1 && c2

    println("  CHECK growth-lift   : B " + _fmt(bT) + (if c1 { " >= " } else { " < " }) + "A " + _fmt(aT) + "+" + _fmt(_REC_MARGIN()) + " -> " + (if c1 { "PASS" } else { "FAIL" }))
    println("  CHECK abstain-intact: fab(B) " + _fmt(bF) + (if c2 { " <= " } else { " > " }) + _fmt(_FAB_BAR()) + " -> " + (if c2 { "PASS" } else { "FAIL" }))
    println("")
    println("════════════════════════════════════════════════════════════════════")
    if green {
        println("  VERDICT: 🟢 GREEN — ENGINE-NATIVE mitosis-growth breaks the 0.667 zero-sum LRU ceiling")
        println("           on the LIVE immune faculty. Growing a new cell under capacity pressure (p8)")
        println("           lifts total+important recall over LRU-eviction; abstain (non-fabrication) intact.")
        let saturated = (bT >= 0.99)
        if saturated {
            println("  HONESTY (c9): B SATURATES (tot=" + _fmt(bT) + ">=0.99) — EXISTENCE-PROOF (growth CAN break")
            println("                the ceiling), NOT effect-size; COST = footprint (B " + _fmt(bC) + " cells vs A " + _fmt(aC) + ").")
        }
        println("  ATTRIBUTION: the lift is from GROWTH (extra cells), realized engine-native as the engine's")
        println("               OWN clonal split (engine_mitosis_tick, p8) — NOT a free eviction heuristic (R1 arm C).")
    } else {
        println("  VERDICT: 🔴 RED — engine-native growth did NOT clear the frozen bars.")
        println("           Δ(B-A)=" + _fmt(bT - aT) + " (need >= " + _fmt(_REC_MARGIN()) + "), fab(B)=" + _fmt(bF) + " (need <= " + _fmt(_FAB_BAR()) + ").")
    }
    println("  philosophy guard: AFFIRMED — mitosis split = the engine's OWN tick (p8); the policy mutates ONLY")
    println("                    the episodic cell population; no labels/persona/ethics/decoder; abstain re-checked (p1-p8).")
    println("[done]")
    if !green { exit(1) }
}
