// H_1218 quick parity check: engine greedy first-8 bytes of the G1 composed seed
// must equal torch greedy first-8 ids [84,104,101,32,109,111,114,97] ("The mora").
import "core/bytegpt_decode.hexa"
fn _bytes_of(s: string) -> list {
    let out = []; let n = byte_len(s); let mut i = 0
    while i < n { out.push(ord(substring(s, i, i + 1))); i = i + 1 }
    return out
}
fn main() {
    let bin = "/tmp/h1218_mount/bytegpt_chat_full.bin"
    let comp = "consciousness arises from cells. tension ripples between distant minds. memory composes into new meaning. silence still carries information. the engine dreams when alone. "
    let r = bytegpt_decode_argmax(bin, _bytes_of(comp), 8)
    println("ENGINE_G1_ids=" + to_string(r["ids"]))
    println("ENGINE_G1_text=" + to_string(r["text"]))
}
