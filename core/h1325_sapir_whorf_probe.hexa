// h1325_sapir_whorf_probe.hexa — ENGINE-NATIVE re-score of the H_1325 frozen bars on the
// live CORE/engine_cli.hexa CategoricalPerception (immune/Voronoi) lane. Part B of H_1325.
//
// Re-scores W1 (CP present), W2 (Whorfian dissociation), W3' (peak-count coherence) on the
// SAME error-targeted SPLIT-only Voronoi growth the mirror used — but engine-native. The
// engine is a SINGLE deterministic instance (no per-seed RBF jitter); it reproduces the
// SEED-INVARIANT bars the mirror reports identically across all 3 seeds. The shuffle uses the
// engine's OWN deterministic incoherent label scheme (structural incoherence, not a PRNG match).
//
// usage: hexa run CORE/h1325_sapir_whorf_probe.hexa

import "CORE/engine_cli.hexa"

fn _absf2(x: float) -> float { if x < 0.0 { return -x } return x }

fn _mid(i: int, n_stim: int) -> float {
    return (to_float(i) + 0.5) / to_float(n_stim - 1)
}

fn _cross_within(curve: [float], n_stim: int, boundary: float) -> [float] {
    let mut cs = 0.0  let mut cn = 0
    let mut ws = 0.0  let mut wn = 0
    let mut i = 0
    while i < len(curve) {
        let m = _mid(i, n_stim)
        let dd = _absf2(m - boundary)
        if dd <= 0.12 { cs = cs + curve[i]  cn = cn + 1 }
        if dd >= 0.25 { ws = ws + curve[i]  wn = wn + 1 }
        i = i + 1
    }
    let cross = if cn > 0 { cs / to_float(cn) } else { 0.0 }
    let within = if wn > 0 { ws / to_float(wn) } else { 0.0 }
    return [cross, within]
}

fn main() {
    let N = 21
    let DIM = 16
    let GROW = 24
    let PASSES = 24
    let P_A = 1.0 / 3.0
    let P_B = 2.0 / 3.0
    println("H_1325 Part B — ENGINE-NATIVE CP re-score (live CORE immune/Voronoi lane)")
    println("==================================================================================")

    let X = cp_stimuli(N, DIM)
    let mut positions = []
    let mut pi = 0
    while pi < N { positions = positions + [to_float(pi) / to_float(N - 1)]  pi = pi + 1 }

    let cpNone = cp_fit(X, cp_labels_boundary(positions, 0.0), GROW, PASSES)
    let cpA    = cp_fit(X, cp_labels_boundary(positions, P_A), GROW, PASSES)
    let cpB    = cp_fit(X, cp_labels_boundary(positions, P_B), GROW, PASSES)
    let cpSh   = cp_fit(X, cp_labels_shuffle(positions, 4323), GROW, PASSES)

    let cvNone = cp_discrim_curve(cpNone, X)
    let cvA    = cp_discrim_curve(cpA, X)
    let cvB    = cp_discrim_curve(cpB, X)
    let cvSh   = cp_discrim_curve(cpSh, X)

    let iA = cp_peak_loc_idx(cvA)
    let iB = cp_peak_loc_idx(cvB)
    let iNone = cp_peak_loc_idx(cvNone)
    let iSh = cp_peak_loc_idx(cvSh)
    let locA = _mid(iA, N)
    let locB = _mid(iB, N)
    println("  CP peak location (engine, single deterministic instance):")
    println("    PRE-LANG idx=" + to_string(iNone) + " loc=" + to_string(_mid(iNone, N)))
    println("    L_A      idx=" + to_string(iA) + " loc=" + to_string(locA) + "  (p_A=" + to_string(P_A) + ")")
    println("    L_B      idx=" + to_string(iB) + " loc=" + to_string(locB) + "  (p_B=" + to_string(P_B) + ")")
    println("    SHUFFLE  idx=" + to_string(iSh) + " loc=" + to_string(_mid(iSh, N)))
    println("")

    let cwA = _cross_within(cvA, N, P_A)
    let cwB = _cross_within(cvB, N, P_B)
    let mgA = cwA[0] - cwA[1]
    let mgB = cwB[0] - cwB[1]
    let bvA = cvA[iA] - cvNone[iA]
    let bvB = cvB[iB] - cvNone[iB]
    let w1 = mgA >= 0.15 && mgB >= 0.15 && bvA >= 0.15 && bvB >= 0.15
    println("  W1 CP PRESENT (cross-within>=0.15 & lang-vs-baseline@peak>=0.15):")
    println("     L_A cross-within=" + to_string(mgA) + "  vs-baseline=" + to_string(bvA))
    println("     L_B cross-within=" + to_string(mgB) + "  vs-baseline=" + to_string(bvB)
            + "   -> " + (if w1 { "PASS" } else { "FAIL" }))

    let dA = _absf2(locA - P_A)
    let dB = _absf2(locB - P_B)
    let sep = _absf2(locA - locB)
    let w2 = dA <= 0.12 && dB <= 0.12 && sep >= 0.20
    println("  W2 WHORFIAN DISSOC (|locA-p_A|<=0.12 & |locB-p_B|<=0.12 & |locA-locB|>=0.20):")
    println("     |locA-p_A|=" + to_string(dA) + "  |locB-p_B|=" + to_string(dB)
            + "  sep=" + to_string(sep) + "   -> " + (if w2 { "PASS" } else { "FAIL" }))

    let pcA = cp_peak_count(cvA)
    let pcB = cp_peak_count(cvB)
    let pcNone = cp_peak_count(cvNone)
    let pcSh = cp_peak_count(cvSh)
    let w3a = pcA <= 1 && pcB <= 1
    let w3b = pcSh >= 3
    let w3 = w3a && w3b
    println("  W3' COHERENCE peak-count (LANG<=1 coherent & SHUFFLE>=3 incoherent):")
    println("     peak-count: L_A=" + to_string(pcA) + "  L_B=" + to_string(pcB)
            + "  PRE-LANG=" + to_string(pcNone) + "  SHUFFLE=" + to_string(pcSh))
    println("       (a) languages coherent (<=1): " + (if w3a { "PASS" } else { "FAIL" }))
    println("       (b) shuffle incoherent (>=3): " + (if w3b { "PASS" } else { "FAIL" })
            + "   -> W3' " + (if w3 { "PASS" } else { "FAIL" }))

    println("==================================================================================")
    if w1 && w2 && w3 {
        println("VERDICT: 🟢 GREEN (ENGINE-NATIVE) — LINGUISTIC RELATIVITY ANTI-GOODHART-CLOSED on the")
        println("  live CORE immune/Voronoi lane. W1 CP present, W2 peak tracks the language, W3'")
        println("  coherence (languages 1 peak, shuffle many). Mirror bars REPRODUCED engine-native.")
    } else {
        println("VERDICT: engine-native did NOT reproduce all frozen bars — see per-bar above (honest).")
    }
}
