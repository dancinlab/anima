// bytegpt_batched_decode_measure.hexa — LEVER-3 (#21 P2) batched device-decode
// CORRECTNESS + THROUGHPUT measurement.
//
// (1) CORRECTNESS: for N in {2,4}, drive N fragments with FIXED distinct in-window
//     token sequences (same length → uniform Lrows) TWO ways in lockstep on the
//     SAME ranged W:
//       (BATCH) _bg_kv_step_dev_batch — one M=N step, batch decode kernel.
//       (SEQ)   N x _bg_kv_step_dev   — N independent single-stream decodes.
//     Identical inputs, so per fragment per step argmax(BATCH row n) MUST ==
//     argmax(SEQ frag n); a logits max|Δ| readout confirms row isolation
//     (expect ~0..1e-12; the M=N rows are independent — no cross-frag leak).
//
// (2) THROUGHPUT: for N in {1,4,8,16,32}, prime `nseed` then time `gen` batched
//     decode steps (argmax-fed). Report ms/step, per-fragment effective ms/tok
//     (= ms/step / N), and speedup vs the P2 single-stream 70.56 ms/tok baseline.
//     Where per-fragment ms/tok stops dropping = saturation (KV mem / compute).
//
// Engine-native (live core/decode.hexa (unified CONV+BYTE)). Needs a CUDA host + the 303M
// h1129 fixture. Measure-first, isolated per N.

import "core/decode.hexa"

fn _maxdiff_off(a: int, aoff: int, b: int, boff: int, n: int) -> float {
    let mut md = 0.0
    let mut k = 0
    while k < n {
        let dv = farr_get(a, aoff + k) - farr_get(b, boff + k)
        let av = if dv < 0.0 { 0.0 - dv } else { dv }
        if av > md { md = av }
        k = k + 1
    }
    return md
}

fn _argmax_off(a: int, off: int, n: int) -> int {
    let mut bi = 0
    let mut bv = farr_get(a, off)
    let mut k = 1
    while k < n {
        let v = farr_get(a, off + k)
        if v > bv { bv = v; bi = k }
        k = k + 1
    }
    return bi
}

// fixed distinct in-window token for fragment n at position p (byte range)
fn _tok_at(n: int, p: int) -> int {
    return 33 + ((n * 11 + p * 3) % 90)
}

fn _correctness(W: Map, N: int, steps: int) {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])

    let kvb = _bg_kv_new_batch(nlay, block, d, N)
    let kvs = []
    let mut ki = 0
    while ki < N { kvs.push(_bg_kv_new(nlay, block, d)); ki = ki + 1 }

    let mut agree = 0
    let mut total = 0
    let mut worstmd = 0.0
    let mut firstdiff = -1

    let mut pos = 0
    while pos < steps {
        let ids = []
        let mut nn = 0
        while nn < N { ids.push(_tok_at(nn, pos)); nn = nn + 1 }
        let lb = _bg_kv_step_dev_batch(W, kvb, ids, N, pos)
        let mut m = 0
        while m < N {
            let lg = _bg_kv_step_dev(W, kvs[m], to_int(ids[m]), pos)
            let ab = _argmax_off(lb, m * vocab, vocab)
            let asq = bg_argmax(lg, vocab)
            let md = _maxdiff_off(lb, m * vocab, lg, 0, vocab)
            if md > worstmd { worstmd = md }
            if ab == asq { agree = agree + 1 } else { if firstdiff < 0 { firstdiff = pos * 100 + m } }
            total = total + 1
            let _ = farr_free(lg)
            m = m + 1
        }
        let _ = farr_free(lb)
        pos = pos + 1
    }

    _bg_kv_free(kvb)
    let mut kf = 0
    while kf < N { _bg_kv_free(kvs[kf]); kf = kf + 1 }

    let verdict = if agree == total { "PASS" } else { "FAIL@" + to_string(firstdiff) }
    println("[correctness N=" + to_string(N) + "] batched-vs-sequential per-frag argmax = "
        + to_string(agree) + "/" + to_string(total) + "   worst max|Δ| = " + to_string(worstmd)
        + "   => " + verdict)
}

// one timed batched gen-run, returns wall ms for `gen` steps
fn _bt_run(W: Map, N: int, nseed: int, gen: int) -> float {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])
    let kvb = _bg_kv_new_batch(nlay, block, d, N)
    let mut lb = -1
    let mut pos = 0
    while pos < nseed {
        let ids = []
        let mut nn = 0
        while nn < N { ids.push(_tok_at(nn, pos)); nn = nn + 1 }
        if lb >= 0 { let _ = farr_free(lb) }
        lb = _bg_kv_step_dev_batch(W, kvb, ids, N, pos)
        pos = pos + 1
    }
    let t0 = now_ms()
    let mut g = 0
    while g < gen {
        let p = nseed + g
        let ids = []
        let mut nn = 0
        while nn < N { ids.push(_argmax_off(lb, nn * vocab, vocab)); nn = nn + 1 }
        let _ = farr_free(lb)
        lb = _bg_kv_step_dev_batch(W, kvb, ids, N, p)
        g = g + 1
    }
    let t1 = now_ms()
    if lb >= 0 { let _ = farr_free(lb) }
    _bg_kv_free(kvb)
    return to_float(t1 - t0)
}

// one timed SINGLE-STREAM gen-run (P2 _bg_kv_step_dev), one fragment, same warm loop
fn _st_run(W: Map, nseed: int, gen: int) -> float {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let block = to_int(W["block"])
    let kv = _bg_kv_new(nlay, block, d)
    let mut lg = -1
    let mut pos = 0
    while pos < nseed {
        if lg >= 0 { let _ = farr_free(lg) }
        lg = _bg_kv_step_dev(W, kv, _tok_at(0, pos), pos)
        pos = pos + 1
    }
    let t0 = now_ms()
    let mut g = 0
    while g < gen {
        let p = nseed + g
        let nb = bg_argmax(lg, vocab)
        let _ = farr_free(lg)
        lg = _bg_kv_step_dev(W, kv, nb, p)
        g = g + 1
    }
    let t1 = now_ms()
    if lg >= 0 { let _ = farr_free(lg) }
    _bg_kv_free(kv)
    return to_float(t1 - t0)
}

fn _median3(a: float, b: float, c: float) -> float {
    if (a <= b && b <= c) || (c <= b && b <= a) { return b }
    if (b <= a && a <= c) || (c <= a && a <= b) { return a }
    return c
}

// in-harness single-stream baseline (P2 path), 3 isolated samples, median
fn _baseline_single(W: Map, nseed: int, gen: int) -> float {
    let s0 = _st_run(W, nseed, gen)
    let s1 = _st_run(W, nseed, gen)
    let s2 = _st_run(W, nseed, gen)
    let med = _median3(s0, s1, s2) / to_float(gen)
    println("[baseline single-stream _bg_kv_step_dev] samples(ms/step)="
        + to_string(s0 / to_float(gen)) + "," + to_string(s1 / to_float(gen)) + ","
        + to_string(s2 / to_float(gen)) + "  median ms/tok=" + to_string(med))
    return med
}

fn _throughput(W: Map, N: int, nseed: int, gen: int, base_ms_tok: float) {
    let r0 = _bt_run(W, N, nseed, gen)
    let r1 = _bt_run(W, N, nseed, gen)
    let r2 = _bt_run(W, N, nseed, gen)
    let ms_step = _median3(r0, r1, r2) / to_float(gen)
    let ms_tok = ms_step / to_float(N)
    let sp_base = base_ms_tok / ms_tok        // vs in-harness single-stream
    let sp_p2 = 70.56 / ms_tok                // vs recorded P2 baseline
    println("[throughput N=" + to_string(N) + "] median ms/step=" + to_string(ms_step)
        + "  per-frag ms/tok=" + to_string(ms_tok)
        + "  speedup-vs-single(" + to_string(base_ms_tok) + ")=" + to_string(sp_base) + "x"
        + "  vs-P2rec(70.56)=" + to_string(sp_p2) + "x")
}

fn main() {
    let mut bin = to_string(env("ANIMA_BYTEGPT303_BIN"))
    let av = args()
    let mut ai = 0
    while ai < len(av) {
        let a = to_string(av[ai])
        let al = byte_len(a)
        if al > 4 && substring(a, al - 4, al) == ".bin" { bin = a }
        ai = ai + 1
    }
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if bin == "" { println("[batched-measure] SKIP — pass a .bin path or set ANIMA_BYTEGPT303_BIN"); return }
    if !have { println("[batched-measure] SKIP — no fixture at " + bin); return }

    let cu = cuda_available()
    println("[batched-measure] cuda_available = " + to_string(cu))
    if cu != 1 { println("[batched-measure] ABORT — CPU fallback, not a device measurement (phantom guard)"); return }

    let W = bg_load_ranged(bin)
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let nh = to_int(W["nh"]); let block = to_int(W["block"])
    println("[batched-measure] loaded vocab=" + to_string(vocab) + " d=" + to_string(d)
        + " nlay=" + to_string(nlay) + " nh=" + to_string(nh) + " block=" + to_string(block))

    println("")
    println("=== (1) CORRECTNESS — batched vs N-sequential ===")
    _correctness(W, 2, 12)
    _correctness(W, 4, 12)

    println("")
    println("=== (2) THROUGHPUT — median of 3, in-harness single-stream baseline ===")
    let base = _baseline_single(W, 8, 24)
    _throughput(W, 1, 8, 24, base)
    _throughput(W, 4, 8, 24, base)
    _throughput(W, 8, 8, 24, base)
    _throughput(W, 16, 8, 24, base)
    _throughput(W, 32, 8, 24, base)

    println("")
    println("bytegpt_batched_decode_measure: DONE")
}
