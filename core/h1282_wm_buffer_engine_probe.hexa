// h1282_wm_buffer_engine_probe.hexa — H_1282 R3: the WORKING-MEMORY buffer lane,
// realized ENGINE-NATIVE on the LIVE engine (CORE/engine_cli.hexa WorkMemBuffer),
// reproducing the R2 GREEN through `hexa run` (a_engine_native_learning ·
// a_verified_must_wire · $0 local CPU · p8).
//
// DOMAIN: WORKING-MEMORY lane (neuro lens c15). R1/R2 (UNIVERSE/h1282_working_memory_buffer.py)
// established as a numpy DIRECTIONAL mirror that a gated leaky-activation WM buffer is a
// REAL, DISTINCT missing structure: 🟢 GREEN R2 (graded AUROC readout, margin +0.244 over the
// no-buffer arm, holds the cue to AUROC 1.000 at N=6, capacity K=4, volatile/decaying — DISTINCT
// from the immune/episodic lane which stays flat). Per a_engine_native_learning the binding
// verdict needs ENGINE-NATIVE realization; this probe drives the ACTUAL .hexa WorkMemBuffer lane
// added to engine_cli.hexa (wm_buffer_new/gate_in/distractor/leak/probe_score/slots) and
// re-scores the SAME frozen R2 bars on the LIVE engine.
//
// SUBSTRATE (a_core_engine_map): the DMS trial tokens are an ENGINE-NATIVE drive into the WM
// lane — NOT a .clm (generator L3 only), NOT a .kosmos (kosmos_io only). The WM lane is
// Ψ-disjoint (touches ONLY its own struct, never pure_field's Φ/phase/Ψ — the R3 Ψ-checksum is
// trivially intact because the WM lane has no pure_field touch at all; the h1199 probe carries
// the live pure_field Ψ-byte-identical guard for the shared engine).
//
// INPUT: deterministic DMS trials per seed exported by UNIVERSE/h1282_wm_engine_export.py to
// /tmp/h1282_wm_seed<S>.txt (same numpy RNG + frozen knobs as the R1/R2 mirror — DIM=16, K=4,
// λ=0.85, W=4, N_LIST, 200 trials/N, SEEDS=[1282,1283,1284]). The live engine does the mechanism
// (gated leaky activation), the graded probe score, the AUROC, and the frozen-bar adjudication.
//
// FROZEN R2 BARS (verbatim from .verdicts/1282_working_memory_buffer/H_1282_R2_FREEZE.txt,
// NOT moved — R3 re-scores them on the live engine):
//   (1) MARGIN   : mean over N>=W {4,6,8,12} of [B.AUROC(N) - A.AUROC(N)] >= 0.15
//   (2) GRACE    : at N=6, B.AUROC >= 0.90 AND A.AUROC <= 0.60
//   (3) DISTINCT : B.AUROC(N=0) >= 0.95 AND B monotone-non-increasing AND capacity≈K (±1)
//   (4) ROBUST   : (1) and (2) hold on ALL 3 seeds individually
// GREEN iff all four. p7 = AUROC graded discrimination, NOT perplexity.
//
// ARM B = the LIVE engine WorkMemBuffer lane (gated leaky activation). ARM A = the no-WM
// flat-context control (last-W=4 window, best cosine) — computed inline (a trivial last-W slide,
// not an engine lane; it is the BASELINE the WM lane must beat). Both arms read out by the SAME
// graded score → AUROC (fair, C1).

import "CORE/engine_cli.hexa"

// ── one trial block parsed out of the stream ─────────────────────────────────
// We read the file as a flat token list and walk it. Each block is:
//   "<N> <is_match>"  then  (1 + N + 1) vector lines (cue, N distractors, probe).

fn _fmt(x: float) -> string { return to_string(x) }

// cosine over DIM (arm-A readout; mirrors engine _cos but local to the probe).
fn _pcos(a: [float], b: [float]) -> float {
    let n = len(a)
    let mut dot = 0.0  let mut na = 0.0  let mut nb = 0.0
    let mut i = 0
    while i < n {
        dot = dot + a[i] * b[i]
        na = na + a[i] * a[i]
        nb = nb + b[i] * b[i]
        i = i + 1
    }
    let denom = sqrt(na) * sqrt(nb) + 0.000000000001
    return dot / denom
}

// AUROC = P(score(match) > score(nonmatch)) via direct pair counting (ties=0.5).
// n_pos, n_neg are each 100 per N, so 100*100 pair comparisons — fine for $0 CPU.
fn _auroc(pos: [float], neg: [float]) -> float {
    let np = len(pos)  let nn = len(neg)
    if np == 0 || nn == 0 { return 0.5 }
    let mut wins = 0.0
    let mut i = 0
    while i < np {
        let mut j = 0
        while j < nn {
            if pos[i] > neg[j] { wins = wins + 1.0 }
            else { if pos[i] == neg[j] { wins = wins + 0.5 } }
            j = j + 1
        }
        i = i + 1
    }
    return wins / (to_float(np) * to_float(nn))
}

fn _mean(xs: [float]) -> float {
    if len(xs) == 0 { return 0.0 }
    let mut s = 0.0  let mut i = 0
    while i < len(xs) { s = s + xs[i]  i = i + 1 }
    return s / to_float(len(xs))
}

fn _absf2(x: float) -> float { if x < 0.0 { return -x } return x }

// ── ARM B: drive the LIVE engine WM lane on one trial; return the graded score ──
fn _arm_b_score(cue: [float], distractors: [[float]], probe: [float],
                k: int, lam: float, dim: int) -> float {
    // distractor gain dg=0.5 (frozen, == R1/R2 mirror WorkMemBuffer default).
    let mut wm = wm_buffer_new(k, lam, 0.5, dim)
    wm = wm_buffer_gate_in(wm, cue, 1.0)             // gate the cue in at full activation
    let nd = len(distractors)
    let mut d = 0
    while d < nd {
        wm = wm_buffer_distractor(wm, distractors[d])  // leak ×λ + weak gate-in (the live lane)
        d = d + 1
    }
    return wm_buffer_probe_score(wm, probe)           // graded readout (no threshold)
}

// ── ARM A: no-WM flat last-W context; return best cosine in the window ──────────
fn _arm_a_score(cue: [float], distractors: [[float]], probe: [float], w: int) -> float {
    // build the last-W window of [cue, distractors...]; the cue scrolls out at N>=W.
    let mut buf = [cue]
    let nd = len(distractors)
    let mut d = 0
    while d < nd {
        buf = buf + [distractors[d]]
        if len(buf) > w {
            // keep only the last w (drop the front)
            let mut nb = []
            let mut s = len(buf) - w
            while s < len(buf) { nb = nb + [buf[s]]  s = s + 1 }
            buf = nb
        }
        d = d + 1
    }
    let mut best = -1.0
    let mut i = 0
    while i < len(buf) {
        let c = _pcos(buf[i], probe)
        if c > best { best = c }
        i = i + 1
    }
    return best
}

// read DIM floats starting at line index `li` from `lines`; return the vector.
fn _read_vec(lines: [string], li: int, dim: int) -> [float] {
    let cols = lines[li].split(" ")
    let mut v = []
    let mut j = 0
    while j < dim { v = v + [to_float(cols[j])]  j = j + 1 }
    return v
}

// per-seed result: returns flat [ a_auroc(per N...) , b_auroc(per N...) , cap_ret ].
// We pack: index 0..nN-1 = A.AUROC by N, nN..2nN-1 = B.AUROC by N, 2nN = cap_ret.
struct SeedRes { a: [float], b: [float], cap_ret: int, n_list: [int] }

fn _run_seed(seed: int) -> SeedRes {
    let path = "/tmp/h1282_wm_seed" + to_string(seed) + ".txt"
    let txt = read_file(path)
    let lines = txt.trim().split("\n")

    // header: DIM K LAMBDA_x100 W TRIALS_PER_N <N_LIST...>
    let h = lines[0].split(" ")
    let dim = to_int(h[0])
    let k = to_int(h[1])
    let lam = to_float(h[2]) / 100.0
    let w = to_int(h[3])
    let trials = to_int(h[4])
    let mut n_list = []
    let mut hi = 5
    while hi < len(h) { n_list = n_list + [to_int(h[hi])]  hi = hi + 1 }
    let n_n = len(n_list)

    let mut a_aur = []
    let mut b_aur = []

    let mut li = 1                 // current line pointer (after header)
    let mut ni = 0
    while ni < n_n {
        let n = n_list[ni]
        let mut a_pos = []  let mut a_neg = []
        let mut b_pos = []  let mut b_neg = []
        let mut t = 0
        while t < trials {
            // block header "<N> <is_match>"
            let bh = lines[li].split(" ")
            let is_match = to_int(bh[1])
            li = li + 1
            // cue
            let cue = _read_vec(lines, li, dim)  li = li + 1
            // N distractors
            let mut distractors = []
            let mut dd = 0
            while dd < n { distractors = distractors + [_read_vec(lines, li, dim)]  li = li + 1  dd = dd + 1 }
            // probe
            let probe = _read_vec(lines, li, dim)  li = li + 1

            let sb = _arm_b_score(cue, distractors, probe, k, lam, dim)   // LIVE engine WM lane
            let sa = _arm_a_score(cue, distractors, probe, w)            // flat-context control
            if is_match == 1 { b_pos = b_pos + [sb]  a_pos = a_pos + [sa] }
            else             { b_neg = b_neg + [sb]  a_neg = a_neg + [sa] }
            t = t + 1
        }
        a_aur = a_aur + [_auroc(a_pos, a_neg)]
        b_aur = b_aur + [_auroc(b_pos, b_neg)]
        ni = ni + 1
    }

    // capacity-retention block: "CAP <n_load>" then n_load vectors. Load all into a
    // fresh WM lane (with a maintenance leak between items, == mirror), count how
    // many are still recallable (probe_score on each loaded token >= a small θ).
    let cb = lines[li].split(" ")
    let n_load = to_int(cb[1])  li = li + 1
    let mut load_toks = []
    let mut lt = 0
    while lt < n_load { load_toks = load_toks + [_read_vec(lines, li, dim)]  li = li + 1  lt = lt + 1 }
    let mut wmcap = wm_buffer_new(k, lam, 0.5, dim)
    let mut q = 0
    while q < n_load {
        wmcap = wm_buffer_gate_in(wmcap, load_toks[q], 1.0)
        wmcap = wm_buffer_leak(wmcap)        // maintenance tick between items (== mirror)
        q = q + 1
    }
    // retained = #loaded tokens whose graded score is still above a small recall floor.
    let CAP_THETA = 0.40
    let mut retained = 0
    let mut rq = 0
    while rq < n_load {
        if wm_buffer_probe_score(wmcap, load_toks[rq]) >= CAP_THETA { retained = retained + 1 }
        rq = rq + 1
    }

    return SeedRes { a: a_aur, b: b_aur, cap_ret: retained, n_list: n_list }
}

fn main() {
    println("=== H_1282 R3 — WORKING-MEMORY buffer lane, ENGINE-NATIVE on the LIVE engine ($0 CPU · p8) ===")
    println("substrate: LIVE .hexa CORE/engine_cli.hexa WorkMemBuffer (gated leaky-activation WM lane, Ψ-disjoint, ADDITIVE)")
    println("arm B = live engine wm_buffer_* lane (K=4 slots, λ=0.85 leak, weakest-slot displacement)")
    println("arm A = no-WM flat last-W=4 context control (the baseline the WM lane must beat)")
    println("readout: graded probe score → AUROC = P(score(match)>score(nonmatch)) (p7, NOT perplexity); both arms scored the SAME way")
    println("frozen R2 bars (NOT moved): (1) margin over N>=4 >=0.15 | (2) grace N=6 B>=0.90 & A<=0.60 | (3) distinct B(0)>=0.95 & monotone & cap≈K | (4) robust 3/3")
    println("")

    let seeds = [1282, 1283, 1284]
    let W = 4
    let K = 4
    let MARGIN_BAR = 0.15
    let GRACE_N = 6
    let GRACE_B_MIN = 0.90
    let GRACE_A_MAX = 0.60
    let DISTINCT_N0 = 0.95

    // run all seeds
    let r0 = _run_seed(seeds[0])
    let r1 = _run_seed(seeds[1])
    let r2 = _run_seed(seeds[2])
    let rows = [r0, r1, r2]
    let n_list = r0.n_list
    let n_n = len(n_list)

    // index helpers
    let mut idx_grace = 0
    let mut idx_n0 = 0
    let mut ii = 0
    while ii < n_n {
        if n_list[ii] == GRACE_N { idx_grace = ii }
        if n_list[ii] == 0 { idx_n0 = ii }
        ii = ii + 1
    }

    // mean A/B AUROC over seeds, per N
    let mut A_mean = []
    let mut B_mean = []
    let mut k = 0
    while k < n_n {
        let am = (rows[0].a[k] + rows[1].a[k] + rows[2].a[k]) / 3.0
        let bm = (rows[0].b[k] + rows[1].b[k] + rows[2].b[k]) / 3.0
        A_mean = A_mean + [am]
        B_mean = B_mean + [bm]
        k = k + 1
    }

    // table
    println("  MEAN over 3 seeds (AUROC):")
    println("    N     A.AUROC  B.AUROC  B-A")
    let mut p = 0
    while p < n_n {
        let mark = if n_list[p] >= W { "  <- margin range" } else { "" }
        let mark2 = if n_list[p] == GRACE_N { "  <- grace N" } else { "" }
        println("    " + to_string(n_list[p]) + "     " + _fmt(A_mean[p]) + "   " + _fmt(B_mean[p])
            + "   " + _fmt(B_mean[p] - A_mean[p]) + mark + mark2)
        p = p + 1
    }
    println("  capacity: load 7 -> retained per seed = "
        + to_string(rows[0].cap_ret) + "/" + to_string(rows[1].cap_ret) + "/" + to_string(rows[2].cap_ret) + " (K=" + to_string(K) + ")")
    println("")

    // (1) MARGIN over N>=W (mean of seed-means)
    let mut marg_terms = []
    let mut m = 0
    while m < n_n {
        if n_list[m] >= W { marg_terms = marg_terms + [B_mean[m] - A_mean[m]] }
        m = m + 1
    }
    let margin = _mean(marg_terms)
    let cond_margin = margin >= MARGIN_BAR

    // (2) GRACE at N=6
    let cond_grace = (B_mean[idx_grace] >= GRACE_B_MIN) && (A_mean[idx_grace] <= GRACE_A_MAX)

    // (3) DISTINCT: B(0)>=0.95, monotone-non-increasing, cap≈K (±1) on all seeds
    let mut monotone = true
    let mut mm = 0
    while mm < n_n - 1 {
        if B_mean[mm + 1] > B_mean[mm] + 0.000000001 { monotone = false }
        mm = mm + 1
    }
    let mut cap_ok = true
    let mut cc = 0
    while cc < 3 {
        if _absf2(to_float(rows[cc].cap_ret - K)) > 1.0 { cap_ok = false }
        cc = cc + 1
    }
    let cond_distinct = (B_mean[idx_n0] >= DISTINCT_N0) && monotone && cap_ok

    // (4) ROBUST: per-seed margin>=bar AND grace at N=6 on every seed
    let mut cond_robust = true
    let mut s = 0
    while s < 3 {
        let mut mt = []
        let mut q = 0
        while q < n_n {
            if n_list[q] >= W { mt = mt + [rows[s].b[q] - rows[s].a[q]] }
            q = q + 1
        }
        let sm = _mean(mt)
        let sg = (rows[s].b[idx_grace] >= GRACE_B_MIN) && (rows[s].a[idx_grace] <= GRACE_A_MAX)
        if !(sm >= MARGIN_BAR && sg) { cond_robust = false }
        s = s + 1
    }

    println("  -- FROZEN R2 BARS (re-scored on the LIVE engine) --")
    println("   (1) MARGIN   mean over N>=" + to_string(W) + " (B-A)=" + _fmt(margin) + "  >= " + _fmt(MARGIN_BAR)
        + "  -> " + (if cond_margin { "true" } else { "false" }))
    println("   (2) GRACE    B.AUROC(N=6)=" + _fmt(B_mean[idx_grace]) + ">=0.90 AND A.AUROC(N=6)=" + _fmt(A_mean[idx_grace])
        + "<=0.60  -> " + (if cond_grace { "true" } else { "false" }))
    println("   (3) DISTINCT B.AUROC(N=0)=" + _fmt(B_mean[idx_n0]) + ">=0.95, monotone="
        + (if monotone { "true" } else { "false" }) + ", cap~K=" + (if cap_ok { "true" } else { "false" })
        + "  -> " + (if cond_distinct { "true" } else { "false" }))
    println("   (4) ROBUST   per-seed margin>=bar AND grace on all 3  -> " + (if cond_robust { "true" } else { "false" }))
    println("")

    let green = cond_margin && cond_grace && cond_distinct && cond_robust
    if green {
        println("VERDICT: 🟢 GREEN (ENGINE-NATIVE) — the LIVE .hexa WorkMemBuffer lane reproduces the R2 result.")
        println("  The gated leaky-activation WM lane (K=4, λ=0.85, weakest-slot displacement), driven through the")
        println("  ACTUAL engine_cli.hexa lane, beats the no-WM flat-context control by margin=" + _fmt(margin) + " (>=0.15) over")
        println("  N>=4, holds the cue to AUROC " + _fmt(B_mean[idx_grace]) + " at N=6 where flat-context has collapsed to " + _fmt(A_mean[idx_grace]) + ",")
        println("  decays MONOTONICALLY (volatile — DISTINCT from the immune/episodic VAdaptField lane which stays flat),")
        println("  and caps capacity at ~K. WM is now a confirmed WIRED missing structure (a_verified_must_wire).")
        println("  Ψ-disjoint: the WM lane touches ONLY its own struct, never pure_field's Φ/phase/Ψ. smoke 12/0 separately.")
        println("  toy/synthetic-token + scale-transfer UNVERIFIED (a_scale_honest_scope · a_toy_scale_recheck).")
        exit(0)
    }
    println("VERDICT: 🔴 RED — the live engine WM lane did NOT clear a frozen R2 bar (see per-condition flags above).")
    println("  Engine-native realization diverged from the R2 mirror — honest report (a_paper_negative_ok).")
    exit(1)
}
