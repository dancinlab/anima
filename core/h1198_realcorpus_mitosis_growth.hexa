// h1198_realcorpus_mitosis_growth.hexa — H_1198 REAL-CORPUS live-mitosis GROWTH run
// (MITOSIS-ENGINE · Lane-1) on the summer pool host ($0, CPU, gradient-free p8).
//
// DOMAIN: MITOSIS-ENGINE. The NEXT rung after H_1197: H_1197 drove the live H_1194
// AdaptField coupling (adapt_field_step / adapt_field_recon_err / adapt_field_cells,
// Ψ-disjoint) over a SYNTHETIC 1-D K=16 stream. THIS rung drives the SAME live
// engine over a REAL corpus byte stream: the per-tick SURPRISE signal
// (−log2 P(byte|ctx)) produced by a GPU-trained byte-Transformer reader (H_1193,
// VERBATIM) on the repo's real corpus (CORE/testdata/clm_mid_5lang_c4.txt, the
// corpus H_1163 make_text_stream reads). Surprise IS a genuine real-corpus per-tick
// scalar — the saccadic-reading novelty driver (H_1192/H_1193) — so feeding it as
// the AdaptField's 1-D sample drives the ACTUAL live adapt_field_step /
// engine_mitosis_tick cell-division on REAL data, not a synthetic stream.
//
// HONEST SCOPE (a_scale_honest_scope + the prompt's live-.hexa-vs-mirror split):
// the live .hexa AdaptField is a 1-D SCALAR substrate (protos: [float],
// adapt_field_step(af, x: float, cfg)). So this LIVE leg drives it over the 1-D
// real-corpus SURPRISE scalar. The FULL DIM=8 real byte-feature growth with a
// surprise-gated split is the H_1198 NUMPY MIRROR (UNIVERSE/h1198_realcorpus_export.py
// mirror section) — clearly labelled as the mirror, because the live AdaptField
// cannot take a DIM>1 sample without an engine change. This file = the LIVE .hexa
// engine on a real-corpus 1-D stream; the export = the DIM=8 surprise-gated mirror.
//
// The split GATE here is the live engine's own recon-err>SPLIT_THRESH (adapt_field_step
// internal) — i.e. a NOVEL surprise value (far from any prototype) spawns a cell. The
// surprise stream's structure (saccadic spikes on real text) is what makes the recon
// error rise and the cells grow; this is the live engine's gradient-free p8 growth tick
// (the SAME engine_mitosis_tick the smoke proves), now driven by a learned-surprise
// real-corpus stream. ON (mitosis) vs OFF (frozen-cap) is the H_1159 adaptation control.
//
// Ψ untouched (pure_field_step run READ-ONLY, Φ only OBSERVED); engine_cli_smoke 12/0
// re-verified separately. p7 metric = real reconstruction distance, NOT perplexity. If
// growth saturates early or ON does not beat OFF on real data, that is reported honestly
// (a_paper_negative_ok). SUBSTRATE NOTE (a_core_engine_map): the surprise stream is an
// ENGINE-NATIVE drive into AdaptField — NOT a .clm (generator L3 only), NOT a .kosmos.

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"

// ── surprise track decode: the GPU reader writes /tmp/h1198_surprise_seed<N>.bin as a
// flat uint8 stream, 2 bytes per tick (hi,lo), surprise = (hi*256+lo)/256.0 bits.
// Range 0..255.996 bits at 1/256 resolution — lossless enough for a 1-D growth drive.
fn _decode_surprise(path: string) -> [float] {
    let rb = read_file_bytes(path)
    let n = len(rb) / 2
    let mut out = []
    let mut i = 0
    while i < n {
        let hi = to_float(rb[i * 2])
        let lo = to_float(rb[i * 2 + 1])
        out = out + [(hi * 256.0 + lo) / 256.0]
        i = i + 1
    }
    return out
}

// ── drive the LIVE engine over the real-corpus surprise stream, logging trajectory ──
// Returns flat [t0,cells0,err0, t1,cells1,err1, ...] + trailing [phi_sum]. The sample
// fed to adapt_field_step IS the real-corpus surprise scalar at tick t.
fn _run_growth(stream: [float], max_cells: int, sample_every: int,
               cfg: EngineConfig) -> [float] {
    let mut pf = pure_field_new()
    // seed the AdaptField at the stream's first value's neighborhood (mirrors
    // adapt_field_new seed; the first real surprise value is the natural seed center).
    let seed0 = if len(stream) > 0 { stream[0] } else { 0.5 }
    let mut af = adapt_field_new(seed0, max_cells)

    let mut rows = []
    let mut phi_sum = 0.0
    let mut win_err = 0.0
    let mut win_cnt = 0

    let n = len(stream)
    let mut t = 0
    while t < n {
        // (Ψ, READ-ONLY) advance the live field; only OBSERVE Φ (attractor disjoint).
        pf = pure_field_step(pf)
        phi_sum = phi_sum + pure_field_phi(pf)

        let sample = stream[t]

        // (coupling) live recon-error BEFORE the update — the adaptation readout.
        let err = adapt_field_recon_err(af, sample)
        win_err = win_err + err
        win_cnt = win_cnt + 1

        // (coupling) one live tick: stream→field + cell→field mitosis feedback.
        af = adapt_field_step(af, sample, cfg)

        if (t + 1) % sample_every == 0 {
            let mean_err = if win_cnt > 0 { win_err / to_float(win_cnt) } else { 0.0 }
            rows = rows + [to_float(t + 1), to_float(adapt_field_cells(af)), mean_err]
            win_err = 0.0
            win_cnt = 0
        }
        t = t + 1
    }
    return rows + [phi_sum]
}

fn _fmt(x: float) -> string { return to_string(x) }

fn main() {
    println("=== H_1198 REAL-CORPUS live-mitosis GROWTH (MITOSIS-ENGINE Lane-1 · summer CPU · $0 · gradient-free p8) ===")
    println("substrate: H_1194 AdaptField coupling (engine-native, Psi-disjoint) on the LIVE .hexa engine")
    println("stream: REAL corpus per-tick SURPRISE (-log2 P(byte|ctx)) from the H_1193 GPU byte-Transformer reader")
    println("metric: live recon-error = |surprise - nearest AdaptField prototype| (p7, NOT perplexity)")
    println("NOTE (honest): the LIVE .hexa AdaptField is 1-D scalar -> driven over the 1-D real-corpus surprise.")
    println("      The DIM=8 surprise-gated growth is the H_1198 numpy MIRROR (export script), clearly labelled.")
    println("")

    let max_cells = 2048      // cap = N_MIGRATE; lets us SEE if real-corpus growth approaches the migration trigger
    let sample_every = 200

    let cfg_on  = engine_cli_parse(["--mitosis", "on"])
    let cfg_off = engine_cli_parse(["--no-mitosis"])

    // load the real-corpus surprise stream (the GPU reader wrote it for seed 900).
    let stream = _decode_surprise("/tmp/h1198_surprise_seed900.bin")
    if len(stream) == 0 {
        println("ERROR: empty surprise stream — run UNIVERSE/h1198_realcorpus_export.py on summer GPU first.")
        exit(1)
    }
    println("real-corpus surprise stream: " + to_string(len(stream)) + " ticks loaded")
    println("")

    // ── PASS 1: the sustained real-corpus growth trajectory (ON) + OFF control ─────
    let traj = _run_growth(stream, max_cells, sample_every, cfg_on)
    let phi_sum = traj[len(traj) - 1]
    let traj_off = _run_growth(stream, max_cells, sample_every, cfg_off)
    let phi_sum_off = traj_off[len(traj_off) - 1]
    let psi_intact = phi_sum == phi_sum_off

    println("--- REAL-CORPUS GROWTH TRAJECTORY (mitosis ON) ---")
    println("tick      cell_count   recon_err(ON)   recon_err(OFF, frozen-cap control)")
    let mut start_cells = 0.0  let mut end_cells = 0.0
    let mut start_err = 0.0    let mut end_err = 0.0
    let mut late_on = 0.0   let mut late_off = 0.0   let mut late_cnt = 0
    let n_rows = len(traj) / 3
    let mut i = 0
    let mut ri = 0
    let mut first = true
    while i + 2 < len(traj) {
        let t   = traj[i]
        let c   = traj[i + 1]
        let eON = traj[i + 2]
        let eOFF = traj_off[i + 2]
        println("  " + _fmt(t) + "      " + _fmt(c) + "        " + _fmt(eON) + "        " + _fmt(eOFF))
        if first { start_cells = c  start_err = eON  first = false }
        end_cells = c  end_err = eON
        if ri * 4 >= n_rows * 3 {   // last quarter of the rows
            late_on = late_on + eON  late_off = late_off + eOFF  late_cnt = late_cnt + 1
        }
        i = i + 3
        ri = ri + 1
    }
    let m_late_on  = if late_cnt > 0 { late_on / to_float(late_cnt) } else { 0.0 }
    let m_late_off = if late_cnt > 0 { late_off / to_float(late_cnt) } else { 0.0 }
    println("")
    println("GROWTH:   cells " + _fmt(start_cells) + " -> " + _fmt(end_cells)
        + "   recon-error(ON) " + _fmt(start_err) + " -> " + _fmt(end_err))
    println("ADAPT:    late-run recon-error  ON=" + _fmt(m_late_on) + "  vs  OFF(frozen-cap)=" + _fmt(m_late_off)
        + "   ratio OFF/ON=" + _fmt(if m_late_on > 0.0 { m_late_off / m_late_on } else { 0.0 }))
    println("Psi:      Phi-checksum ON==OFF = " + (if psi_intact { "true (attractor intact)" } else { "false (PERTURBED!)" })
        + "   (ON=" + _fmt(phi_sum) + " OFF=" + _fmt(phi_sum_off) + ")")
    println("")

    // ── migration check: did real-corpus growth approach N_MIGRATE=2048? ──────────
    let N_MIGRATE = 2048.0
    let approached = end_cells >= N_MIGRATE * 0.5
    println("--- MIGRATION CHECK (summer CPU -> GPU pod) ---")
    println("N_MIGRATE = 2048 cells (the H_1197 summer-CPU O(n_cells) per-tick budget threshold)")
    println("real-corpus growth ended at " + _fmt(end_cells) + " cells "
        + (if end_cells >= N_MIGRATE { "(>= N_MIGRATE — MIGRATION WARRANTED)" }
           else { if approached { "(approached N_MIGRATE — watch)" } else { "(<< N_MIGRATE — summer CPU correct host)" }}))
    println("")

    // ── verdict ───────────────────────────────────────────────────────────────────
    let grew = end_cells > start_cells
    let adapts = m_late_on > 0.0 && (m_late_off / m_late_on) >= 2.0
    let bounded = m_late_on < m_late_off    // ON below the frozen-cap OFF blow-up
    if grew && adapts && bounded && psi_intact {
        println("VERDICT: GREEN LIVE-GROWTH-ON-REAL-CORPUS — over the REAL-corpus learned-surprise stream the")
        println("  live .hexa engine GREW cells (" + _fmt(start_cells) + " -> " + _fmt(end_cells) + ") AND held the live")
        println("  recon-error LOW (late ON=" + _fmt(m_late_on) + ") while frozen-capacity OFF blew up (late OFF="
            + _fmt(m_late_off) + ", " + _fmt(m_late_off / m_late_on) + "x worse). The H_1159 ON<OFF adaptation HOLDS on")
        println("  REAL data. Psi byte-identical ON vs OFF. FIRST real-corpus live-mitosis growth on the H_1194")
        println("  coupling; summer CPU $0 gradient-free. LIVE .hexa engine (1-D surprise); DIM=8 surprise-gated")
        println("  growth = the labelled numpy mirror. toy/small-scale + learned-rep UNVERIFIED (a_scale_honest_scope).")
        exit(0)
    }
    println("VERDICT: RED/PARTIAL — "
        + (if !grew { "cells did NOT grow over the real-corpus stream" }
           else { if !adapts { "cells grew but ON did not hold error below the frozen-cap OFF baseline on real data (non-adaptive)" }
                  else { if !bounded { "ON error not below OFF (frozen cap kept pace)" }
                         else { "Psi attractor PERTURBED" } } })
        + " (a_paper_negative_ok). Real-corpus growth curve + migration check above are the honest record.")
    exit(0)
}
