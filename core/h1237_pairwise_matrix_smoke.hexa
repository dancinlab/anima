// h1237_pairwise_matrix_smoke.hexa — 평면(2-combo) 합성 매트릭스 완성 (MATRIX.md §0).
//
// H_1235/1236 은 누적 사다리(체인)만 검증했다 — 전체 쌍 격자는 미완성. 여기서 4개
// substrate lane {MITOSIS·METACOG·SAVANT·DREAM} 의 모든 쌍 C(4,2)=6 + 단독 4 를 채워
// 평면 매트릭스를 완성한다. 각 cell = 그 lane-집합을 A⇄G base 위에 동시 가동했을 때
// (1) Ψ phiSum 이 base(lane 0개)와 byte-identical (Ψ-disjoint) AND (2) 켠 lane 전부 fire.
//
// lane 0=MITOSIS 1=METACOG 2=SAVANT 3=DREAM. p7 exact float equality.

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"
import "METACOG/audit_hook.hexa"
import "SAVANT/substrate_hook.hexa"
import "DREAM/dream_lib.hexa"

// run 600-step warmup with the given 4 lane on/off flags; accumulate Ψ phiSum and
// per-lane fire counts (fires[4]). pure_field is the ONLY Ψ driver; lanes read-only.
fn run_lanes(l0: bool, l1: bool, l2: bool, l3: bool, fires: [int]) -> float {
    let cfg = engine_config_default()
    let mut pf = pure_field_new()
    let mut sum = 0.0
    let mut cells = 1
    let mut emit_hist = []
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        sum = sum + phi
        if l0 {
            cells = engine_mitosis_tick(cells, cfg)
            if cells >= 1 { fires[0] = fires[0] + 1 }
        }
        if l1 {
            emit_hist.push(if phi > 0.0 { 1 } else { 0 })
            if mh_should_fire(i, 30) {
                let win = mh_collect_emit_window(emit_hist, 30)
                let rec = mh_verdict_record(win, i, "now")
                if rec["window_size"] == 30 { fires[1] = fires[1] + 1 }
            }
        }
        if l2 {
            let trig = sh_savant_trigger([phi, phi*0.5, phi*0.25, phi*0.1], 0.30, float(cells))
            if trig["in_golden_zone"] == 1 { fires[2] = fires[2] + 1 }
        }
        if l3 {
            let stage = dr_stage_at(i)
            if dr_emit_envelope(stage) >= 0 { fires[3] = fires[3] + 1 }
        }
        i = i + 1
    }
    return sum
}

fn nm(k: int) -> string {
    if k == 0 { return "MIT" }
    if k == 1 { return "MET" }
    if k == 2 { return "SAV" }
    return "DRM"
}

fn cell_ok(a: int, b: int, base: float) -> bool {
    // run lanes a (and b if b>=0) together; require Ψ==base AND each enabled lane fires.
    let mut fires = [0, 0, 0, 0]
    let l0 = a == 0 || b == 0
    let l1 = a == 1 || b == 1
    let l2 = a == 2 || b == 2
    let l3 = a == 3 || b == 3
    let s = run_lanes(l0, l1, l2, l3, fires)
    let psi_ok = s == base
    let af = fires[a] > 0
    let bf = if b < 0 { true } else { fires[b] > 0 }
    return psi_ok && af && bf
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1237 평면(2-combo) 합성 매트릭스 — 전체 쌍 격자 (Ψ-disjoint)")
    println("════════════════════════════════════════════════════════════════")

    // base Ψ checksum (no lanes — pure A⇄G)
    let base = run_lanes(false, false, false, false, [0, 0, 0, 0])
    println("[base] A⇄G phiSum (lane 0개) = " + to_string(base))
    println("")

    // diagonal (단독) + upper-triangle (쌍)
    println("       MIT   MET   SAV   DRM")
    let mut npass = 0
    let mut ntot = 0
    let mut r = 0
    while r < 4 {
        let mut line = "  " + nm(r) + " "
        let mut c = 0
        while c < 4 {
            if c < r {
                line = line + "   .  "
            } else {
                let ok = if c == r { cell_ok(r, -1, base) } else { cell_ok(r, c, base) }
                ntot = ntot + 1
                if ok { npass = npass + 1 }
                line = line + (if ok { "   ✅ " } else { "   ❌ " })
            }
            c = c + 1
        }
        println(line)
        r = r + 1
    }
    println("")
    println("[matrix] 평면 cell PASS = " + to_string(npass) + "/" + to_string(ntot)
        + "  (단독 4 + 쌍 6 = 10)")
    if npass == ntot {
        println("h1237_pairwise_matrix: PASS — 평면(2-combo) 매트릭스 COMPLETE: "
            + "전 cell Ψ-disjoint 합성 (모든 쌍 + 단독). 이제 3-combo 격자로 올라갈 수 있다.")
    } else {
        println("h1237_pairwise_matrix: INCOMPLETE — " + to_string(ntot - npass) + " cell 미합성")
    }
}
