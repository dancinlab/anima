// ════════════════════════════════════════════════════════════════════════════
//  CORE/DECODER/h686_h687_v_scale.hexa
//
//   H_686 + H_687 V-scale escape boundary sweep (PR #1395 후속 toy-extension).
//
//   CONTEXT
//     PR #1395 (h686_h687_aux_ablation.hexa) came back ⚪ TOY-NULL at V=8:
//     baseline cell-a already escaped (4/4 distinct experts, LZ_norm=0.0360459),
//     so all 4 cells (none/ent/kl/both) landed byte-identical and the aux had
//     no decode-diversity work to do. The PR concluded that production fire
//     (V=151643) is the only valid test — but it would be cheaper if we could
//     find a V-band at $0 Mac local where the toy DOES reproduce the
//     collapse, and verify the aux escapes in that band first.
//
//     This harness sweeps V ∈ {8, 64, 256, 1024, 4096} × cell ∈ {none, ent,
//     kl, both} (20 combos) with all other E2 parameters fixed (E=4, d=6,
//     600 step, SKEWED corpus rep0=20, top-1 hard routing, lr=0.5, identical
//     M init seed, λ_ent=0.1, λ_kl=0.1 verbatim from PR #1395 / #1397).
//
//   CORPUS MAPPING (V-parametrized, preserves PR #1395 byte-eq at V=8)
//     cluster_i → token (i * stride + 0) mod V    where stride = max(1, V/6)
//     · V=8  : stride = max(1, 8/6)  = 1 → cluster c → token c       (PR #1395 verbatim)
//     · V=64 : stride = max(1, 64/6) = 10 → c0→0, c1→10, c2→20, ...
//     · V=256: stride = max(1, 256/6)= 42
//     · V=1024 stride = 170
//     · V=4096 stride = 682
//     Sanity gate: at V=8 cell=none, this harness MUST reproduce PR #1395's
//     LZ_norm=0.0360459 distinct=4/4 byte-eq (asserted in run summary).
//
//   USAGE
//     hexa run h686_h687_v_scale.hexa <V> <CELL>
//     where CELL ∈ {none, ent, kl, both}  (int dispatch 0/1/2/3)
//
//   DETERMINISM · hexa-only · $0 mac-local · NO GPU · foreground.
//   λ_ent = 0.1, λ_kl = 0.1 (PR #1395 / #1397 verbatim).
// ════════════════════════════════════════════════════════════════════════════

import "CORE/DECODER/moe_router.hexa"
import "CORE/DECODER/moe_router_bwd.hexa"

fn log2(x: float) -> float { return log(x) / log(2.0) }
fn safe_ln(x: float) -> float {
    let xs = if x < 0.000000000001 { 0.000000000001 } else { x }
    return moe_ln(xs)
}

// ── parse argv ──────────────────────────────────────────────────────────────
fn parse_int(s: string) -> int {
    let n = s.len()
    let mut v = 0
    let mut i = 0
    while i < n {
        let cb = s.byte_at(i)
        if cb >= 48 && cb <= 57 {
            v = v * 10 + (cb - 48)
        }
        i = i + 1
    }
    return v
}
fn parse_cell(s: string) -> int {
    if s == "none" { return 0 }
    if s == "ent"  { return 1 }
    if s == "kl"   { return 2 }
    if s == "both" { return 3 }
    return 0
}
fn cell_name(cell: int) -> string {
    if cell == 0 { return "none (baseline)" }
    if cell == 1 { return "ent only (H_686)" }
    if cell == 2 { return "kl only (H_687)" }
    if cell == 3 { return "both (H_686+H_687)" }
    return "unknown"
}

// ── canonical Lempel-Ziv 1976 (Kaspar-Schuster) — D1/E2 verbatim (g61) ──────
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}

// ── BITS = 18 (PR #1395 verbatim · preserves V=8 byte-eq sanity gate;
//    V ≤ 2^18 = 262144 so all swept V {8,64,256,1024,4096} are representable).
fn bits_for_v(V: int) -> int { return 18 }

fn ids_to_bits(ids: array, n: int, BITS: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let mut v = ids[i]
        let mut b = 0
        while b < BITS {
            out = out.push(v % 2)
            v = v / 2
            b = b + 1
        }
        i = i + 1
    }
    return out
}
fn lz_raw_arr(ids: array, n: int, BITS: int) -> int {
    let bits = ids_to_bits(ids, n, BITS)
    return lz76(bits, n * BITS)
}
fn lz_norm_arr(ids: array, n: int, BITS: int) -> float {
    let len = n * BITS
    let c = lz_raw_arr(ids, n, BITS)
    return to_float(c) * log2(to_float(len)) / to_float(len)
}

// ── CE loss + grad → d_logits (PR #1395 verbatim) ───────────────────────────
fn ce_loss_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - moe_ln(p_tgt + 0.0000000001)
    let mut k = 0
    while k < V {
        let pk = farr_get(d_logits_out, k) / tot
        let tgt = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, pk - tgt)
        k = k + 1
    }
    return ce
}

fn softmax_into(logits: int, V: int, p_out: int) {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(p_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let mut i3 = 0
    while i3 < V {
        let _ = farr_set(p_out, i3, farr_get(p_out, i3) / tot)
        i3 = i3 + 1
    }
}

fn entropy_nats(p: int, n: int) -> float {
    let mut h = 0.0
    let mut i = 0
    while i < n {
        let pi = farr_get(p, i)
        if pi > 0.000000000001 {
            h = h - pi * moe_ln(pi)
        }
        i = i + 1
    }
    return h
}

// ── ONE training step (PR #1395 verbatim algorithm, V parametric) ───────────
fn moe_toy_step_aux(zT: int, target: int, M: int, router_off: int, experts_off: int,
                    n_experts: int, V: int, d: int, total: int, lr: float,
                    cell: int, lam_ent: float, lam_kl: float) -> float {
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    let top = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)

    let d_logits = farr_zeros(V)
    let ce = ce_loss_grad(logits, target, V, d_logits)

    // H_687 KL-to-uniform output reg
    if cell == 2 || cell == 3 {
        let q = farr_zeros(V)
        softmax_into(logits, V, q)
        let Hq = entropy_nats(q, V)
        let mut j = 0
        while j < V {
            let qj = farr_get(q, j)
            let term = lam_kl * qj * (safe_ln(qj) + Hq)
            let cur = farr_get(d_logits, j)
            let _ = farr_set(d_logits, j, cur + term)
            j = j + 1
        }
        let _ = farr_free(q)
    }

    let gt = farr_get(gate, top)
    let base_top = experts_off + top * V * d
    let dM = farr_zeros(total)
    let d_zT = farr_zeros(d)
    let d_gate = farr_zeros(n_experts)
    let mut dgt = 0.0
    let mut k0 = 0
    while k0 < V {
        let dlk = farr_get(d_logits, k0)
        let mut elk = 0.0
        let mut j0 = 0
        while j0 < d {
            let w = farr_get(M, base_top + k0 * d + j0)
            let zj = farr_get(zT, j0)
            elk = elk + w * zj
            let cur = farr_get(dM, base_top + k0 * d + j0)
            let _ = farr_set(dM, base_top + k0 * d + j0, cur + gt * dlk * zj)
            let dz = farr_get(d_zT, j0)
            let _ = farr_set(d_zT, j0, dz + gt * w * dlk)
            j0 = j0 + 1
        }
        dgt = dgt + dlk * elk
        k0 = k0 + 1
    }
    let _ = farr_set(d_gate, top, dgt)

    // H_686 ent aux
    if cell == 1 || cell == 3 {
        let mut e = 0
        while e < n_experts {
            let pe = farr_get(gate, e)
            let term = lam_ent * (safe_ln(pe) + 1.0)
            let cur = farr_get(d_gate, e)
            let _ = farr_set(d_gate, e, cur + term)
            e = e + 1
        }
    }

    let d_gate_raw = farr_zeros(n_experts)
    moe_softmax_bwd(gate, d_gate, n_experts, d_gate_raw)
    moe_gate_bwd(zT, M, router_off, n_experts, d, d_gate_raw, dM, d_zT)

    let mut i = 0
    while i < total {
        let _ = farr_set(M, i, farr_get(M, i) - lr * farr_get(dM, i))
        i = i + 1
    }

    let _ = farr_free(gate)
    let _ = farr_free(logits)
    let _ = farr_free(d_logits)
    let _ = farr_free(d_gate)
    let _ = farr_free(d_gate_raw)
    let _ = farr_free(dM)
    let _ = farr_free(d_zT)
    return ce
}

fn set_cluster(zT: int, c: int, d: int) {
    let mut j = 0
    while j < d {
        let _ = farr_set(zT, j, 0.0)
        j = j + 1
    }
    let _ = farr_set(zT, c, 1.0)
}

fn decode_argmax_for_cluster(c: int, M: int, router_off: int, experts_off: int,
                              n_experts: int, V: int, d: int, zT: int, out_top: int) -> int {
    let mut j = 0
    while j < d {
        let _ = farr_set(zT, j, 0.0)
        j = j + 1
    }
    let _ = farr_set(zT, c, 1.0)
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    let top = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let mut bi = 0
    let mut bv = farr_get(logits, 0)
    let mut k = 1
    while k < V {
        if farr_get(logits, k) > bv { bv = farr_get(logits, k); bi = k }
        k = k + 1
    }
    let _ = farr_set(out_top, 0, to_float(top))
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    return bi
}

fn run_cell(cell: int, lam_ent: float, lam_kl: float, V: int, BITS: int, out5: int) {
    let n_experts = 4
    let d = 6
    let n_clusters = 6
    let router_off = 0
    let experts_off = n_experts * d
    let total = experts_off + n_experts * V * d
    let stride = if V / 6 < 1 { 1 } else { V / 6 }

    let M = farr_zeros(total)
    let mut s = 0
    while s < total {
        let base = if s == s / 2 * 2 { 0.02 } else { 0.0 - 0.02 }
        let bump = to_float(s == s / 3 * 3) * 0.015
        let bump2 = to_float(s == s / 5 * 5) * 0.01
        let _ = farr_set(M, s, base + bump + bump2)
        s = s + 1
    }

    let zT = farr_zeros(d)
    let lr = 0.5
    let n_steps = 600

    // initial avg CE
    let dlg = farr_zeros(V)
    let g0 = farr_zeros(n_experts)
    let lg0 = farr_zeros(V)
    let mut init_sum = 0.0
    let mut c0 = 0
    while c0 < n_clusters {
        set_cluster(zT, c0, d)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        let target_c0 = (c0 * stride) % V
        init_sum = init_sum + ce_loss_grad(lg0, target_c0, V, dlg)
        c0 = c0 + 1
    }
    let init_loss = init_sum / to_float(n_clusters)
    println("  V=" + str(V) + " stride=" + str(stride) + " · init avg CE = " + str(init_loss))

    let rep0 = 20
    let mut step = 0
    while step < n_steps {
        let mut c = 0
        while c < n_clusters {
            set_cluster(zT, c, d)
            let target_c = (c * stride) % V
            let reps = if c == 0 { rep0 } else { 1 }
            let mut r = 0
            while r < reps {
                let _ = moe_toy_step_aux(zT, target_c, M, router_off, experts_off,
                                          n_experts, V, d, total, lr,
                                          cell, lam_ent, lam_kl)
                r = r + 1
            }
            c = c + 1
        }
        step = step + 1
    }

    // final avg CE + mean H(gate)
    let mut fin_sum = 0.0
    let mut hsum = 0.0
    let mut cf = 0
    while cf < n_clusters {
        set_cluster(zT, cf, d)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        let target_cf = (cf * stride) % V
        fin_sum = fin_sum + ce_loss_grad(lg0, target_cf, V, dlg)
        hsum = hsum + entropy_nats(g0, n_experts)
        cf = cf + 1
    }
    let final_loss = fin_sum / to_float(n_clusters)
    let mean_hg = hsum / to_float(n_clusters)
    println("  final avg CE = " + str(final_loss))
    println("  mean H(gate) = " + str(mean_hg) + " (uniform = " + str(moe_ln(to_float(n_experts))) + ")")

    // ── DECODE: 4 cycles × 6 clusters with SKEW multiplicity ────────────────
    let n_decode_cycles = 4
    let dec_rep0 = 20
    let mut decoded = []
    let top_out = farr_zeros(1)
    let mut seen0 = false
    let mut seen1 = false
    let mut seen2 = false
    let mut seen3 = false
    let mut cyc = 0
    while cyc < n_decode_cycles {
        let mut cc = 0
        while cc < n_clusters {
            let tok = decode_argmax_for_cluster(cc, M, router_off, experts_off, n_experts, V, d, zT, top_out)
            let top = to_int(farr_get(top_out, 0))
            if top == 0 { seen0 = true }
            if top == 1 { seen1 = true }
            if top == 2 { seen2 = true }
            if top == 3 { seen3 = true }
            let reps = if cc == 0 { dec_rep0 } else { 1 }
            let mut r = 0
            while r < reps {
                decoded = decoded.push(tok)
                r = r + 1
            }
            cc = cc + 1
        }
        cyc = cyc + 1
    }
    let n_dec = decoded.len()
    let lz = lz_norm_arr(decoded, n_dec, BITS)
    let raw_c = lz_raw_arr(decoded, n_dec, BITS)
    let mut de = 0
    if seen0 { de = de + 1 }
    if seen1 { de = de + 1 }
    if seen2 { de = de + 1 }
    if seen3 { de = de + 1 }
    println("  decoded n = " + str(n_dec) + " · raw_c = " + str(raw_c) + " · BITS = " + str(BITS) + " · LZ_norm = " + str(lz))
    println("  distinct_experts (over 6 clusters) = " + str(de))

    let mut cd = 0
    while cd < n_clusters {
        let t = decode_argmax_for_cluster(cd, M, router_off, experts_off, n_experts, V, d, zT, top_out)
        let tp = to_int(farr_get(top_out, 0))
        let target_cd = (cd * stride) % V
        println("    cluster c" + str(cd) + " (target=" + str(target_cd) + ") → expert e" + str(tp) + " → token " + str(t))
        cd = cd + 1
    }

    let _ = farr_set(out5, 0, lz)
    let _ = farr_set(out5, 1, final_loss)
    let _ = farr_set(out5, 2, init_loss)
    let _ = farr_set(out5, 3, to_float(de))
    let _ = farr_set(out5, 4, mean_hg)

    let _ = farr_free(M)
    let _ = farr_free(zT)
    let _ = farr_free(dlg)
    let _ = farr_free(g0)
    let _ = farr_free(lg0)
    let _ = farr_free(top_out)
}

fn main() {
    let av = args()
    let argc = av.len()
    if argc < 3 {
        println("USAGE: hexa run h686_h687_v_scale.hexa <V> <CELL>")
        println("  V    ∈ {8, 64, 256, 1024, 4096}")
        println("  CELL ∈ {none, ent, kl, both}")
        return
    }
    let V = parse_int(av[1])
    let cell = parse_cell(av[2])
    let BITS = bits_for_v(V)
    let lam_ent = 0.1
    let lam_kl = 0.1

    println("================================================================")
    println("  H_686 + H_687 V-scale sweep · V=" + str(V) + " · cell=" + cell_name(cell))
    println("       MoE top-1 hard routing · E=4 d=6 · 6 cluster · 600 step")
    println("       lam_ent=" + str(lam_ent) + " · lam_kl=" + str(lam_kl) + " · SKEWED corpus (rep0=20)")
    println("       corpus map: cluster_i → token (i*stride) mod V")
    println("================================================================")

    let out = farr_zeros(5)
    run_cell(cell, lam_ent, lam_kl, V, BITS, out)
    let lz = farr_get(out, 0)
    let ce_fin = farr_get(out, 1)
    let ce_ini = farr_get(out, 2)
    let de = farr_get(out, 3)
    let hg = farr_get(out, 4)

    println("================================================================")
    println("  RESULT_V=" + str(V) + " CELL=" + cell_name(cell))
    println("  LZ_norm=" + str(lz))
    println("  distinct_experts=" + str(de))
    println("  mean_H_gate=" + str(hg))
    println("  final_CE=" + str(ce_fin))
    println("  init_CE=" + str(ce_ini))
    println("================================================================")
}
