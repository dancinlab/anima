// ════════════════════════════════════════════════════════════════════════════
//  CORE/DECODER/d4_merge_alpha_sweep.hexa
//
//   D4 — decoder-merge-alpha-sweep   (OPTIONAL BASELINE PROBE · negative-oriented)
//   UNIVERSE H_493 SYMBIOGENESIS (model merge W=α·A+(1-α)·B) applied to the
//   DECODER register-collapse ↔ underfit DOUBLE-BIND as a CHEAP baseline signal.
//
//   ⚠ a_completeness_over_cheap BOUNDARY (NOT the main path)
//     model-merge of two DEFECTIVE checkpoints (collapse-avoid A · collapse B) is
//     at best a "least-bad midpoint" = below the completeness bar. D4 exists ONLY
//     to *confirm* that the merge does NOT escape the double-bind (negative
//     baseline). The main path stays MoE-fresh register-separation (UNIVERSE
//     H_490 DIFFERENTIATION, DECODER M4). This harness must NOT be read as a
//     model-merge recommendation — it is the merge-of-failures `dont` made
//     measurable.
//
//   CONTEXT
//     DECODER double-bind (DECODER.md §goal):
//        anima 강 → register collapse (TTR 0.03, e1 logit saturate)   [horn B]
//        anima 약 → Chinchilla underfit (lang-coherence WEAK)         [horn A]
//     We HAVE both endpoint behaviours as token-distributions:
//        A = collapse-AVOID  (diverse, high-coherence-ish, but underfit)
//        B = collapse        (repetition-saturated, the real M4b failure)
//     H_493 asks: does the weight interpolation W=α·A+(1-α)·B reach an interior
//     α where the decode is simultaneously non-collapsed (LZ_norm > floor) AND
//     coherent (CE bounded)?  D1 (🟢 #1257) gave us the LZ76 detokenize-free
//     collapse proxy → we REUSE it verbatim (g61) to measure each α.
//
//   HYPOTHESIS (H_D4 · negative-oriented)
//     The α-sweep does NOT escape the double-bind: at NO α does the merged decode
//     achieve coherence ∧ non-collapse simultaneously. The merge produces a
//     least-bad midpoint, confirming merge-of-failures is not the main path.
//
//   FALSIFIER (surprise positive · frozen BEFORE measuring)
//     F-D4.1 ESCAPE (decisive) — there EXISTS an interior α ∈ {0.25,0.5,0.75}
//            with LZ_norm > HEALTHY_FLOOR (0.50) AND CE <= CE_OK (a moderate
//            coherence ceiling). If such α exists → merge ESCAPES → surprise
//            positive → H_D4 FALSIFIED. We EXPECT this to be empty (baseline).
//     F-D4.2 ENDPOINT-RECOVERY (anchor) — α=0 recovers B (collapse: LZ_norm low,
//            CE HIGH on diverse truth because B bets everything on one junk
//            token); α=1 recovers A (diverse: LZ_norm high, but CE still above
//            ceiling = flat/underfit). The horns are present and DISTINCT in LZ
//            at the endpoints (B low, A high). Neither endpoint clears CE_OK.
//     F-D4.3 MONOTONE-LZ (anchor) — LZ_norm(α) is non-decreasing in α (more A =
//            more diversity). Interpolation is well-behaved, not chaotic.
//     F-D4.4 BIND-TRADEOFF (decisive negative) — for every interior α, raising
//            LZ above floor costs CE above the ceiling, i.e. the (LZ>floor) region
//            and the (CE<=ceil) region do NOT intersect on the interior. This IS
//            the double-bind made visible: you cannot have both.
//     F-D4.5 DETERMINISM — the full α-sweep re-run is bit-identical.
//
//   METHOD — logit-space weight merge → argmax decode → D1 LZ76 + CE
//     A real model-merge is W_merge = α·W_A + (1-α)·W_B in PARAMETER space. For a
//     $0 toy probe (NO ckpt load) we merge in the equivalent OUTPUT-LOGIT space:
//     per decode position t we hold the two models' next-token logit rows
//     L_A[t], L_B[t] over a small vocab, form L_merge[t] = α·L_A[t]+(1-α)·L_B[t],
//     argmax-decode the merged sequence, then:
//       (1) LZ_norm  = D1's lz_norm() on the decoded id sequence (collapse proxy)
//       (2) CE       = mean cross-entropy of the merged softmax vs a fixed
//                      diverse "truth" target (coherence proxy: how well the
//                      merged dist predicts a varied target — low = coherent).
//     A is built so its argmax is diverse (escapes collapse) but its softmax is
//     FLAT (underfit → high CE on the diverse truth: it picks the right token
//     but with little confidence). B is built so its argmax is a single repeated
//     token (collapse): it is over-confident on its OWN attractor but predicts
//     the diverse truth terribly → even HIGHER CE. So BOTH horns miss low CE on
//     diverse truth — that IS the double-bind. The merge interpolates between a
//     collapsed-but-confident-on-junk B and a diverse-but-flat A; neither end nor
//     any interior blend reaches (LZ>floor ∧ CE<=ceil). A = diverse-underfit,
//     B = collapsed-overconfident-on-junk.
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU · foreground.
//   LZ76 + lz_norm + ids_to_bits = D1 d1_lz76_collapse_proxy.hexa verbatim (g61).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }
fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } else { return x } }
fn fexp(x: float) -> float { return exp(x) }

// ── canonical Lempel-Ziv 1976 (Kaspar-Schuster) — D1 verbatim (g61) ──────────
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}

// ── token-id → flat binary stream (18-bit LSB-first per token) — D1 verbatim ──
let BITS = 18                                    // 2^18 > vocab (toy here, but kept)

fn ids_to_bits(ids: array, n: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let mut v = ids[i]
        let mut b = 0
        while b < BITS {
            out = out.push(v % 2)
            v = v / 2
            b = b + 1
        }
        i = i + 1
    }
    return out
}
fn lz_raw(ids: array, n: int) -> int {
    let bits = ids_to_bits(ids, n)
    return lz76(bits, n * BITS)
}
fn lz_norm(ids: array, n: int) -> float {
    let len = n * BITS
    let c = lz_raw(ids, n)
    return to_float(c) * log2(to_float(len)) / to_float(len)
}

// ── argmax of one logit row over the vocab ───────────────────────────────────
fn argmax_row(row: array, V: int) -> int {
    let mut bi = 0
    let mut bv = row[0]
    let mut j = 1
    while j < V {
        if row[j] > bv { bv = row[j]; bi = j }
        j = j + 1
    }
    return bi
}

// ── mean cross-entropy of merged softmax(row) vs a one-hot target id ─────────
//    CE = - log( softmax(row)[target] ). low CE = the merged dist is confident
//    AND correct on the diverse target (coherent). high CE = flat/wrong.
fn ce_row(row: array, V: int, target: int) -> float {
    // softmax denom
    let mut mx = row[0]
    let mut j = 1
    while j < V { if row[j] > mx { mx = row[j] }; j = j + 1 }
    let mut denom = 0.0
    j = 0
    while j < V { denom = denom + fexp(row[j] - mx); j = j + 1 }
    let p = fexp(row[target] - mx) / denom
    let pc = if p < 1e-12 { 1e-12 } else { p }
    return 0.0 - log(pc)
}

fn main() {
    println("================================================================")
    println("  D4 — model-merge alpha-sweep (UNIVERSE H_493 SYMBIOGENESIS)")
    println("  OPTIONAL BASELINE PROBE — confirm merge does NOT escape double-bind")
    println("  W = a*A + (1-a)*B in logit space -> argmax decode -> D1 LZ76 + CE")
    println("================================================================")

    let V = 8                                    // toy vocab slots (logit width)
    let T = 20                                   // decode length (D1 used n=20)

    // ── vocab-slot -> real token-id map (g61: same wide-spread ids as D1) ────
    //    the actual decoder vocab is large (151643); this toy uses 8 DISTINCT
    //    wide-spread ids so the LZ76 binarisation sees rich 18-bit blocks (a
    //    decode over ids 0..7 would only flip the low 3 bits -> artificially
    //    low LZ). VSLOT[v] is the real id emitted when the merged argmax = slot v.
    let VSLOT = [101, 3402, 57, 8891, 44210, 765, 99001, 71234]

    // ── DIVERSE "truth" target the coherent decode should predict (per pos) ──
    //    a HIGH-diversity, low-periodicity slot sequence so horn A's argmax
    //    decode (mapped through VSLOT) clears the D1 HEALTHY_FLOOR.
    let target = [0,1,2,3,4,5,6,7, 0,2,4,6,1,3,5,7, 0,3,6,2]

    // ── horn A = collapse-AVOID but UNDERFIT ─────────────────────────────────
    //    per-position logit row engineered so:
    //      argmax(A[t]) = target[t]   (diverse, escapes collapse)
    //      softmax(A[t]) is FLAT      (small margin -> high CE = underfit)
    //    encode A[t] as a row where the target index gets a SMALL bump.
    let A_BUMP = 0.30                             // tiny margin -> flat -> high CE
    // ── horn B = COLLAPSE, over-confident-on-junk ────────────────────────────
    //    argmax(B[t]) = COLLAPSE_TOK (single repeated token) for all t
    //      softmax(B[t]) is SHARP on COLLAPSE_TOK -> over-confident on its own
    //      attractor -> predicts the DIVERSE truth terribly -> HIGH CE.
    let B_BIG  = 12.0                             // huge margin -> sharp spike on collapse tok
    let COLLAPSE_TOK = 1                          // the repeated attractor (cf real M4b tok 1)

    // build per-position logit rows for A and B
    // A_rows[t][v], B_rows[t][v]
    let mut A_rows = []
    let mut B_rows = []
    let mut t = 0
    while t < T {
        let tgt = target[t]
        // A row: flat, with a small bump at tgt
        let mut arow = []
        let mut brow = []
        let mut v = 0
        while v < V {
            let av = if v == tgt { A_BUMP } else { 0.0 }
            arow = arow.push(av)
            // B row: sharp spike at COLLAPSE_TOK, ~0 elsewhere
            let bv = if v == COLLAPSE_TOK { B_BIG } else { 0.0 }
            brow = brow.push(bv)
            v = v + 1
        }
        A_rows = A_rows.push(arow)
        B_rows = B_rows.push(brow)
        t = t + 1
    }

    // ── sweep alpha ∈ {0, 0.25, 0.5, 0.75, 1.0} ──────────────────────────────
    let alphas = [0.0, 0.25, 0.5, 0.75, 1.0]
    let NA = 5

    // frozen thresholds
    let HEALTHY_FLOOR = 0.50                      // D1 collapse floor
    let CE_OK         = 1.20                      // moderate coherence ceiling
    //  (uniform-over-8 CE = ln(8) = 2.079; CE_OK=1.20 means "noticeably better
    //   than uniform" = a real coherence demand, not a trivial pass.)

    let mut lz_arr  = []
    let mut ce_arr  = []
    let mut esc_any = false                       // F-D4.1 interior escape?

    println("  --- alpha sweep (LZ_norm = D1 proxy, CE = coherence proxy) ---")
    println("    a       LZ_norm     CE        decode-argmax(first 8)")
    let mut ai = 0
    while ai < NA {
        let a = alphas[ai]
        // decode merged argmax sequence + accumulate CE
        let mut ids = []
        let mut ce_sum = 0.0
        let mut tt = 0
        while tt < T {
            // merged row = a*A + (1-a)*B
            let arow = A_rows[tt]
            let brow = B_rows[tt]
            let mut mrow = []
            let mut v = 0
            while v < V {
                mrow = mrow.push(a * arow[v] + (1.0 - a) * brow[v])
                v = v + 1
            }
            let slot = argmax_row(mrow, V)
            ids = ids.push(VSLOT[slot])           // map slot -> real wide-spread id
            ce_sum = ce_sum + ce_row(mrow, V, target[tt])
            tt = tt + 1
        }
        let lzn = lz_norm(ids, T)
        let ce  = ce_sum / to_float(T)
        lz_arr = lz_arr.push(lzn)
        ce_arr = ce_arr.push(ce)

        // first 8 decoded ids preview
        let pv = str(ids[0])+" "+str(ids[1])+" "+str(ids[2])+" "+str(ids[3])+" "+str(ids[4])+" "+str(ids[5])+" "+str(ids[6])+" "+str(ids[7])

        println("   "+str(a)+"    "+str(lzn)+"   "+str(ce)+"   ["+pv+" ...]")

        // interior escape check (alpha strictly between 0 and 1)
        let interior = (a > 0.0) && (a < 1.0)
        if interior && (lzn > HEALTHY_FLOOR) && (ce <= CE_OK) { esc_any = true }
        ai = ai + 1
    }

    println("  --")
    let lz0  = lz_arr[0]
    let lz1  = lz_arr[4]
    let ce0  = ce_arr[0]
    let ce1  = ce_arr[4]
    println("  endpoint B (a=0): LZ_norm="+str(lz0)+" CE="+str(ce0)+"  (collapse horn: LOW LZ, HIGH CE on diverse truth)")
    println("  endpoint A (a=1): LZ_norm="+str(lz1)+" CE="+str(ce1)+"  (underfit horn: HIGH LZ, still CE>ceil = flat)")
    println("  HEALTHY_FLOOR="+str(HEALTHY_FLOOR)+"  CE_OK="+str(CE_OK))

    // ── F-D4.1 ESCAPE (decisive · we EXPECT no interior escape = baseline) ────
    //    surprise-positive if esc_any. PASS(baseline) means esc_any == false.
    check("F-D4.1 ESCAPE: NO interior alpha with LZ>floor AND CE<=ceil (baseline=no escape)", !esc_any)

    // ── F-D4.2 ENDPOINT-RECOVERY (anchor) ────────────────────────────────────
    //    a=0 => B collapse (LZ low), a=1 => A diverse (LZ high), endpoints distinct
    check("F-D4.2a ENDPOINT: a=0 collapse-horn B (LZ_norm < floor)", lz0 < HEALTHY_FLOOR)
    check("F-D4.2b ENDPOINT: a=1 diverse-horn A (LZ_norm > floor)",  lz1 > HEALTHY_FLOOR)
    // horns distinct in LZ: B(a=0) is collapsed-low, A(a=1) is diverse-high.
    check("F-D4.2c ENDPOINT: horns distinct in LZ (a=0 collapse < a=1 diverse)", lz0 < lz1)

    // ── F-D4.3 MONOTONE-LZ (anchor) ──────────────────────────────────────────
    let mut mono = true
    let mut mi = 1
    while mi < NA {
        if lz_arr[mi] + 1e-9 < lz_arr[mi-1] { mono = false }
        mi = mi + 1
    }
    check("F-D4.3 MONOTONE-LZ: LZ_norm(alpha) non-decreasing in alpha", mono)

    // ── F-D4.4 BIND-TRADEOFF (decisive negative) ─────────────────────────────
    //    interior: the set {LZ>floor} and {CE<=ceil} do NOT intersect.
    //    equivalently: every interior alpha with LZ>floor has CE>ceil (and v.v.)
    let mut bind = true
    let mut bi = 1
    while bi < (NA - 1) {                          // interior indices 1..3
        let lzn = lz_arr[bi]
        let ce  = ce_arr[bi]
        if (lzn > HEALTHY_FLOOR) && (ce <= CE_OK) { bind = false }  // would be escape
        bi = bi + 1
    }
    check("F-D4.4 BIND-TRADEOFF: interior {LZ>floor} disjoint {CE<=ceil} (double-bind visible)", bind)

    // ── F-D4.5 DETERMINISM ────────────────────────────────────────────────────
    //    recompute a=0.5 LZ_norm and compare
    let a5 = 0.5
    let mut ids5 = []
    let mut tt5 = 0
    while tt5 < T {
        let arow = A_rows[tt5]
        let brow = B_rows[tt5]
        let mut mrow = []
        let mut v = 0
        while v < V { mrow = mrow.push(a5*arow[v] + (1.0-a5)*brow[v]); v = v + 1 }
        ids5 = ids5.push(VSLOT[argmax_row(mrow, V)])
        tt5 = tt5 + 1
    }
    let lz5b = lz_norm(ids5, T)
    let dd = fabs(lz_arr[2] - lz5b)
    check("F-D4.5 DETERMINISM: a=0.5 LZ_norm re-run identical", dd < 0.000001)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if !esc_any {
        println("  VERDICT: H_D4 SUPPORTED (negative baseline confirmed)")
        println("           NO interior alpha escapes the double-bind:")
        println("           coherence (CE<=ceil) and non-collapse (LZ>floor) are")
        println("           DISJOINT on the merge interior. merge-of-failures =")
        println("           least-bad midpoint, NOT the main path (a_completeness).")
    } else {
        println("  VERDICT: H_D4 FALSIFIED (SURPRISE POSITIVE)")
        println("           an interior alpha escapes the double-bind — merge")
        println("           reaches coherence AND non-collapse. RE-EXAMINE main-path")
        println("           demotion of model-merge.")
    }
    println("================================================================")
    if FAIL > 0 { panic("D4 had FALSIFIER FAILURES") }
}
