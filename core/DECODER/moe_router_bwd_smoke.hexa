// moe_router_bwd_smoke.hexa — DECODER M4b gradcheck (finite-diff vs analytic)
// Loss = 0.5·Σ_k logits[k]²  →  d_logits[k] = logits[k].
// Perturb representative weights (router + expert) + zT, compare numeric vs analytic.

import "CORE/DECODER/moe_router.hexa"
import "CORE/DECODER/moe_router_bwd.hexa"

// forward loss = 0.5·Σ logits² over a fresh route_fwd
fn loss_at(zT: int, M: int, router_off: int, experts_off: int,
           n_experts: int, V: int, d: int) -> float {
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    moe_route_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let mut s = 0.0
    let mut k = 0
    while k < V {
        let lk = farr_get(logits, k)
        s = s + 0.5 * lk * lk
        k = k + 1
    }
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    return s
}

fn rel_ok(label: int, numeric: float, analytic: float) -> int {
    let mut diff = numeric - analytic
    if diff < 0.0 { diff = 0.0 - diff }
    let mut den = analytic
    if den < 0.0 { den = 0.0 - den }
    if den < 0.001 { den = 0.001 }
    let rel = diff / den
    if rel < 0.001 {
        print("  [ok] gradcheck " + str(label) + " (num=" + str(numeric) + " ana=" + str(analytic) + " rel=" + str(rel) + ")")
        return 1
    }
    print("  [FAIL] gradcheck " + str(label) + " num=" + str(numeric) + " ana=" + str(analytic) + " rel=" + str(rel))
    return 0
}

fn main() {
    print("=== DECODER M4b moe_router_bwd gradcheck (E=2 V=3 d=2) ===")

    let n_experts = 2
    let V = 3
    let d = 2
    let router_off = 0
    let experts_off = n_experts * d
    let total = experts_off + n_experts * V * d

    let M = farr_zeros(total)
    let zT = farr_zeros(d)
    let _ = farr_set(zT, 0, 0.7)
    let _ = farr_set(zT, 1, -0.4)

    // non-trivial weights (avoid symmetry)
    let _ = farr_set(M, router_off + 0 * d + 0, 0.5)
    let _ = farr_set(M, router_off + 0 * d + 1, -0.3)
    let _ = farr_set(M, router_off + 1 * d + 0, 0.2)
    let _ = farr_set(M, router_off + 1 * d + 1, 0.6)
    let e0 = experts_off + 0 * V * d
    let _ = farr_set(M, e0 + 0 * d + 0, 0.9)
    let _ = farr_set(M, e0 + 0 * d + 1, 0.1)
    let _ = farr_set(M, e0 + 1 * d + 0, -0.5)
    let _ = farr_set(M, e0 + 1 * d + 1, 0.4)
    let _ = farr_set(M, e0 + 2 * d + 0, 0.3)
    let _ = farr_set(M, e0 + 2 * d + 1, -0.2)
    let e1 = experts_off + 1 * V * d
    let _ = farr_set(M, e1 + 0 * d + 0, 0.6)
    let _ = farr_set(M, e1 + 0 * d + 1, -0.7)
    let _ = farr_set(M, e1 + 1 * d + 0, 0.2)
    let _ = farr_set(M, e1 + 1 * d + 1, 0.8)
    let _ = farr_set(M, e1 + 2 * d + 0, -0.1)
    let _ = farr_set(M, e1 + 2 * d + 1, 0.5)

    // analytic backward: d_logits = logits (from loss 0.5·Σlogits²)
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    moe_route_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let dM = farr_zeros(total)
    let d_zT = farr_zeros(d)
    // d_logits = logits (copy)
    let d_logits = farr_zeros(V)
    let mut kk = 0
    while kk < V {
        let _ = farr_set(d_logits, kk, farr_get(logits, kk))
        kk = kk + 1
    }
    moe_route_bwd(zT, M, router_off, experts_off, gate, n_experts, V, d, d_logits, dM, d_zT)

    // finite-diff helper for a packed-buffer weight index
    let eps = 0.0001
    let mut ok = 1

    // probe set: router[0], router[3], expert0 w[e0+0], expert1 w[e1+5], + zT[0], zT[1]
    // --- weight gradchecks ---
    let probes = farr_zeros(4)
    let _ = farr_set(probes, 0, router_off + 0 * d + 0)   // router e0 j0
    let _ = farr_set(probes, 1, router_off + 1 * d + 1)   // router e1 j1
    let _ = farr_set(probes, 2, e0 + 1 * d + 0)            // expert0 k1 j0
    let _ = farr_set(probes, 3, e1 + 2 * d + 1)            // expert1 k2 j1
    let mut pi = 0
    while pi < 4 {
        let idx = farr_get(probes, pi)
        let idx_i = ftoi(idx)
        let orig = farr_get(M, idx_i)
        let _ = farr_set(M, idx_i, orig + eps)
        let lp = loss_at(zT, M, router_off, experts_off, n_experts, V, d)
        let _ = farr_set(M, idx_i, orig - eps)
        let lm = loss_at(zT, M, router_off, experts_off, n_experts, V, d)
        let _ = farr_set(M, idx_i, orig)
        let numeric = (lp - lm) / (2.0 * eps)
        ok = ok * rel_ok(pi, numeric, farr_get(dM, idx_i))
        pi = pi + 1
    }

    // --- d_zT gradchecks ---
    let mut zi = 0
    while zi < d {
        let orig = farr_get(zT, zi)
        let _ = farr_set(zT, zi, orig + eps)
        let lp = loss_at(zT, M, router_off, experts_off, n_experts, V, d)
        let _ = farr_set(zT, zi, orig - eps)
        let lm = loss_at(zT, M, router_off, experts_off, n_experts, V, d)
        let _ = farr_set(zT, zi, orig)
        let numeric = (lp - lm) / (2.0 * eps)
        ok = ok * rel_ok(10 + zi, numeric, farr_get(d_zT, zi))
        zi = zi + 1
    }

    let _ = farr_free(M)
    let _ = farr_free(zT)
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    let _ = farr_free(dM)
    let _ = farr_free(d_zT)
    let _ = farr_free(d_logits)
    let _ = farr_free(probes)

    if ok == 1 {
        print("=== DECODER M4b gradcheck: 6/6 PASS (4 weights + 2 zT) ===")
    } else {
        print("=== DECODER M4b gradcheck: FAIL ===")
    }
}
