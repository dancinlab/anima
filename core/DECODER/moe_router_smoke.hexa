// moe_router_smoke.hexa — DECODER M4a MoE router forward verify
// Tiny synthetic: n_experts=2 · V=3 · d=2. Hand-built weights → known outputs.

import "core/DECODER/moe_router.hexa"

fn approx(a: float, b: float) -> int {
    let mut diff = a - b
    if diff < 0.0 { diff = 0.0 - diff }
    if diff < 0.0001 { return 1 }
    return 0
}

fn check_f(label: int, got: float, want: float) -> int {
    if approx(got, want) == 1 {
        print("  [ok] case " + str(label) + " (got=" + str(got) + ")")
        return 1
    }
    print("  [FAIL] case " + str(label) + " got=" + str(got) + " want=" + str(want))
    return 0
}

fn main() {
    print("=== DECODER M4a moe_router smoke (E=2 V=3 d=2) ===")

    let n_experts = 2
    let V = 3
    let d = 2

    // packed buffer M layout:
    //   router_off  = 0          : [E·d]   = 4 floats
    //   experts_off = E·d = 4    : [E·V·d] = 12 floats
    let router_off = 0
    let experts_off = n_experts * d
    let M = farr_zeros(experts_off + n_experts * V * d)

    // zT = [1.0, 0.0]  (input last-token state)
    let zT = farr_zeros(d)
    let _ = farr_set(zT, 0, 1.0)
    let _ = farr_set(zT, 1, 0.0)

    // router: expert0 weight=[2.0, 0.0] → gate0_raw = 2.0
    //         expert1 weight=[0.0, 0.0] → gate1_raw = 0.0
    let _ = farr_set(M, router_off + 0 * d + 0, 2.0)
    let _ = farr_set(M, router_off + 0 * d + 1, 0.0)
    let _ = farr_set(M, router_off + 1 * d + 0, 0.0)
    let _ = farr_set(M, router_off + 1 * d + 1, 0.0)

    // expert0 head [V·d]: row k weight on dim0 = (k+1) → logits = [1,2,3]
    let e0 = experts_off + 0 * V * d
    let _ = farr_set(M, e0 + 0 * d + 0, 1.0)
    let _ = farr_set(M, e0 + 1 * d + 0, 2.0)
    let _ = farr_set(M, e0 + 2 * d + 0, 3.0)
    // expert1 head: row k weight on dim0 = 10·(k+1) → logits = [10,20,30]
    let e1 = experts_off + 1 * V * d
    let _ = farr_set(M, e1 + 0 * d + 0, 10.0)
    let _ = farr_set(M, e1 + 1 * d + 0, 20.0)
    let _ = farr_set(M, e1 + 2 * d + 0, 30.0)

    // C1: gate forward (raw, pre-softmax)
    let gate = farr_zeros(n_experts)
    moe_gate_fwd(zT, M, router_off, n_experts, d, gate)
    let mut ok = 1
    ok = ok * check_f(1, farr_get(gate, 0), 2.0)   // gate0_raw = 2·1 = 2
    ok = ok * check_f(2, farr_get(gate, 1), 0.0)   // gate1_raw = 0

    // C2: softmax — gate0 = e^2/(e^2+e^0) ≈ 0.8808 · sums to 1
    moe_softmax(gate, n_experts)
    ok = ok * check_f(3, farr_get(gate, 0), 0.8807970)
    ok = ok * check_f(4, farr_get(gate, 0) + farr_get(gate, 1), 1.0)  // sums to 1

    // C3: argmax → expert 0 (gate0 > gate1)
    let top = moe_argmax(gate, n_experts)
    if top == 0 {
        print("  [ok] case 5 argmax=0")
    } else {
        print("  [FAIL] case 5 argmax got=" + str(top))
        ok = 0
    }

    // C4: single expert forward — expert0 logits = [1,2,3]
    let lg0 = farr_zeros(V)
    moe_expert_fwd(zT, M, experts_off, 0, V, d, lg0)
    ok = ok * check_f(6, farr_get(lg0, 0), 1.0)
    ok = ok * check_f(7, farr_get(lg0, 2), 3.0)
    // expert1 logits = [10,20,30]
    let lg1 = farr_zeros(V)
    moe_expert_fwd(zT, M, experts_off, 1, V, d, lg1)
    ok = ok * check_f(8, farr_get(lg1, 1), 20.0)

    // C5: soft combine — logits[k] = g0·e0[k] + g1·e1[k]
    //   g0≈0.8808 g1≈0.1192 → logits[0] = 0.8808·1 + 0.1192·10 = 2.0728
    let combined = farr_zeros(V)
    moe_combine_soft(zT, M, experts_off, gate, n_experts, V, d, combined)
    ok = ok * check_f(9, farr_get(combined, 0), 2.0728)
    // logits[2] = 0.8808·3 + 0.1192·30 = 6.2184
    ok = ok * check_f(10, farr_get(combined, 2), 6.2184)

    // C6: full route_fwd reproduces the same combine
    let gate2 = farr_zeros(n_experts)
    let combined2 = farr_zeros(V)
    moe_route_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate2, combined2)
    ok = ok * check_f(11, farr_get(combined2, 0), 2.0728)
    ok = ok * check_f(12, farr_get(gate2, 0), 0.8807970)

    let _ = farr_free(M)
    let _ = farr_free(zT)
    let _ = farr_free(gate)
    let _ = farr_free(lg0)
    let _ = farr_free(lg1)
    let _ = farr_free(combined)
    let _ = farr_free(gate2)
    let _ = farr_free(combined2)

    if ok == 1 {
        print("=== DECODER M4a moe_router smoke: 12/12 PASS ===")
    } else {
        print("=== DECODER M4a moe_router smoke: FAIL ===")
    }
    let _ = moe_router_summary(n_experts, V, d)
}
