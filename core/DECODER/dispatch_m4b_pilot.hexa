// CORE/DECODER/dispatch_m4b_pilot.hexa — M4b-fire-scale Phase 4e dispatch runbook
//
// Hexa-native dispatch runbook for the M4b pilot fire on RunPod H100.
// Prints the canonical command sequence + env-var protocol so the operator
// (or hexa cloud automation) executes the dispatch deterministically.
//
// Provider = RunPod (project.tape a_fire_autonomous: provider = runpod).
//   runpodctl   — pod lifecycle (pod create / get / ssh / send / remove)
//   hexa cloud  — structured-argv remote dispatch (commons g8):
//     cloud copy-to   <host> <local> <remote> [--port N] [--insecure]
//     cloud run       <host> [--port N] [--insecure] -- <argv...>
//     cloud exec      <host> [--port N] [--insecure] -- <shell-cmd>
//     cloud nohup     <host> <logfile> [--port N] [--insecure] -- <argv...>
//     cloud poll      <host> <pid>     [--port N] [--insecure]
//     cloud copy-from <host> <remote> <local> [--port N] [--insecure]
//
// Per a_fire_autonomous: dispatch runs autonomous (no user gate), cost
// estimated in one line BEFORE fire. Per a_wall_first: prefer parallel pods
// to compress wall time when faster.

use "stdlib/flame/tensor_lib"

fn main() {
    println("=== M4b-fire-scale Phase 4e dispatch runbook (RunPod H100) ===")
    println("")
    println("─── Cost estimate (a_fire_autonomous one-liner) ───")
    println("  Pilot: RunPod H100 (~$2-3/hr on-demand) · 0.5-1hr wall · ~$1-3 total")
    println("  Full (after pilot PASS): 4-8hr wall · ~$9-18 total")
    println("")
    println("─── Pilot env-var protocol (P21H_PILOT_*) ───")
    println("  P21H_PILOT_D=2048           # hidden dim (Mac smoke d=64 → pilot 2048)")
    println("  P21H_PILOT_NL=12            # n_layer (Mac smoke n_layer=1 → pilot 12)")
    println("  P21H_PILOT_E=2              # n_experts (top-1 hard MoE)")
    println("  P21H_PILOT_T=512            # seq length (Mac smoke T=4 → pilot 512)")
    println("  P21H_PILOT_STEPS=500        # n_steps (Mac smoke 1 → pilot 500)")
    println("  P21H_PILOT_NSAMP=4          # eval sample count")
    println("  P21H_MOE_ON=1               # MoE wired (always 1 for M4b fire)")
    println("  P21H_BPE_ON=1               # real Qwen BPE corpus (always 1 for M4b fire)")
    println("  SAVE_POD=1                  # first-fire crash trap (pod retained on FAIL)")
    println("")
    println("─── Step 0: account + GPU availability (no cost) ───")
    println("  $ runpodctl user                        # balance check")
    println("  $ runpodctl gpu list | grep -i h100     # H100 availability + price")
    println("")
    println("─── Step 1: create H100 pod ───")
    println("  $ runpodctl pod create \\")
    println("      --name m4b-pilot-2026-05-27 \\")
    println("      --gpu-type 'NVIDIA H100 80GB HBM3' --gpu-count 1 \\")
    println("      --image 'runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04' \\")
    println("      --container-disk 60 --ports '22/tcp'")
    println("  # capture POD_ID; then: runpodctl pod get <POD_ID>  → SSH host + port")
    println("  # export POD_HOST=root@<ip>   POD_PORT=<port>")
    println("")
    println("─── Step 2: provision toolchain — FRESH hexa-lang main (CRITICAL) ───")
    println("  # ⚠ flame_bpe_corpus_lib lives on hexa-lang origin/main (#1537) but the")
    println("  #   local ~/.hx/bin install is STALE. Build hexat + stdlib FRESH on the pod")
    println("  #   from a current hexa-lang main clone so flame_bpe_corpus_lib +")
    println("  #   self/ml/tokenizer_bpe are present. (Do NOT scp the stale local install.)")
    println("  $ hexa cloud exec $POD_HOST --port $POD_PORT --insecure -- \\")
    println("      'apt-get update -qq && apt-get install -y -qq build-essential clang git'")
    println("  $ hexa cloud exec $POD_HOST --port $POD_PORT --insecure -- \\")
    println("      'cd /opt && git clone --depth 1 https://github.com/dancinlab/hexa-lang.git'")
    println("  $ hexa cloud exec $POD_HOST --port $POD_PORT --insecure -- \\")
    println("      'cd /opt/hexa-lang && ./tool/bootstrap_build.sh && ls build/hexat'")
    println("  $ hexa cloud exec $POD_HOST --port $POD_PORT --insecure -- \\")
    println("      'test -f /opt/hexa-lang/stdlib/flame/flame_bpe_corpus_lib.hexa && echo BPE_LIB_OK'")
    println("  # BPE_LIB_OK confirms the toolchain-sync precondition is satisfied on the pod.")
    println("")
    println("─── Step 3: scp Qwen tokenizer + corpus ───")
    println("  $ hexa cloud copy-to $POD_HOST \\")
    println("      HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/merges.txt \\")
    println("      /opt/qwen/merges.txt --port $POD_PORT --insecure")
    println("  $ hexa cloud copy-to $POD_HOST \\")
    println("      HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/vocab.json \\")
    println("      /opt/qwen/vocab.json --port $POD_PORT --insecure")
    println("  $ hexa cloud copy-to $POD_HOST \\")
    println("      training/corpus_consciousness_v1.jsonl \\")
    println("      /opt/corpus/corpus_consciousness_v1.jsonl --port $POD_PORT --insecure")
    println("")
    println("─── Step 4: scp anima driver code ───")
    println("  $ hexa cloud copy-to $POD_HOST CORE/DECODER/v3_moe_arch.hexa \\")
    println("      /opt/anima/CORE/DECODER/v3_moe_arch.hexa --port $POD_PORT --insecure")
    println("  $ hexa cloud copy-to $POD_HOST CORE/DECODER/v3_moe_bwd_lib.hexa \\")
    println("      /opt/anima/CORE/DECODER/v3_moe_bwd_lib.hexa --port $POD_PORT --insecure")
    println("  $ hexa cloud copy-to $POD_HOST CORE/DECODER/train_v3_moe_pilot.hexa \\")
    println("      /opt/anima/CORE/DECODER/train_v3_moe_pilot.hexa --port $POD_PORT --insecure")
    println("  # Patch the pilot's tok/vocab/corpus paths to /opt/qwen + /opt/corpus on the pod,")
    println("  # and its `use` paths to /opt/anima/... (or run from /opt/anima with abs imports).")
    println("")
    println("─── Step 5: fire (autonomous · bg via nohup) ───")
    println("  $ hexa cloud nohup $POD_HOST /opt/anima/state/m4b_pilot/train.log \\")
    println("      --port $POD_PORT --insecure -- \\")
    println("      env P21H_PILOT_D=2048 P21H_PILOT_NL=12 P21H_PILOT_E=2 P21H_PILOT_T=512 \\")
    println("          P21H_PILOT_STEPS=500 P21H_MOE_ON=1 P21H_BPE_ON=1 SAVE_POD=1 \\")
    println("          /opt/hexa-lang/build/hexat run /opt/anima/CORE/DECODER/train_v3_moe_pilot.hexa")
    println("  # capture REMOTE_PID from nohup output")
    println("")
    println("─── Step 6: monitor + harvest ───")
    println("  $ hexa cloud poll $POD_HOST $REMOTE_PID --port $POD_PORT --insecure  # 0=alive 1=done")
    println("  $ hexa cloud exec $POD_HOST --port $POD_PORT --insecure -- \\")
    println("      'tail -30 /opt/anima/state/m4b_pilot/train.log'                  # progress")
    println("  # on JOB DONE (poll → exit 1):")
    println("  $ hexa cloud copy-from $POD_HOST /opt/anima/state/m4b_pilot/result.json \\")
    println("      state/m4b_pilot_2026_05_27/result.json --port $POD_PORT --insecure")
    println("  $ hexa cloud copy-from $POD_HOST /opt/anima/state/m4b_pilot/ckpt.bin \\")
    println("      state/m4b_pilot_2026_05_27/ckpt.bin --port $POD_PORT --insecure")
    println("")
    println("─── Step 7: HF upload (a_hf_autonomous · a_hf_complete) ───")
    println("  # complete artifact set: ckpt + train.log + result.json + model card + manifest")
    println("  # PUBLIC if pilot verdict ≥ 4/5 falsifier PASS · PRIVATE otherwise")
    println("  # org = dancinlab · repo = anima-m4b-pilot-2026-05-27 · manifest sha256")
    println("")
    println("─── Step 8: teardown (only after harvest + HF upload complete) ───")
    println("  $ runpodctl pod remove $POD_ID")
    println("  # SAVE_POD=1 trap: do NOT remove if PULL_FAILED — pod retained for retry")
    println("")
    println("─── Phase 5 verdict (post-harvest) ───")
    println("  measure 5 falsifiers (F-M4B-FIRE-1..5) → state/m4b_pilot_2026_05_27/m4b_pilot_verdict.md")
    println("  matrix: 5/5 → full fire · 3-4 → re-pilot · ≤2 → re-design · 0 → CLOSED-NEGATIVE")
    println("")
    println("─── Verdict ───")
    let _check = t_zeros(1)   // touch tensor_lib so import isn't dead
    println("DISPATCH_M4B_PILOT RUNBOOK: PRINTED (RunPod · 9-step SOP · fresh-toolchain provisioning · 5 falsifier matrix)")
}
