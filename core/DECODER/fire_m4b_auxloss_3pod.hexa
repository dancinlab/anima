// CORE/DECODER/fire_m4b_auxloss_3pod.hexa — M4b aux-loss × d-scale 3-pod fire
//   ARTIFACT-OF-RECORD (runbook printer; orchestration runs via `hexa cloud`
//   local commands, per the cloud-guard g8 — runpodctl lifecycle + hexa cloud
//   transport are the only allowed pod surfaces).
//
// Fires THREE H100 80GB SECURE pods CONCURRENTLY (a_wall_first — parallel not
// serial), each running CORE/DECODER/train_v3_moe_auxloss.hexa with a distinct
// (M4B_D, M4B_AUX_ALPHA) env config so any escape is attributed to capacity
// vs routing vs their combination:
//   POD A  d=256 aux=2.0   PRIMARY     (capacity + routing)
//   POD B  d=256 aux=0.0   ablation    (capacity only — isolates d↑)
//   POD C  d=64  aux=2.0   ablation    (routing only — isolates aux @ orig cap)
//
// Cost (a_fire_autonomous, stated once): H100 80GB SECURE @ $3.29/hr × 3 pods
// PARALLEL × ~0.5-1.0hr wall each ≈ $5-10 total. No user gate.
//
// Build path (BUILD_RECIPE.md, validated by #1296): Mac `hexa build --c-only`
// -> trainer.c; sed-patch the two cross-backend codegen gaps
//   sed 's/hexa_call1(trim,/rt_str_trim(/g'        (#1527 free-fn trim)
//   sed 's/hexa_call1(dir_create,/rt_fs_mkdir_p(/g' (dir_create cross-backend)
// -> scp self/ runtime tree (tar) + glue.c + trainer.c + Qwen merges/vocab +
//    corpus -> pod-side nvcc runtime_cuda.o + clang/gcc link -DHEXA_CUDA with
//    glue.c (strong hexa_cuda_available override) + -lcuda (cuBLAS engaged).
//
// CORPUS NOTE: the full 2000-line diverse corpus is INTRACTABLE under the
// current hexa-lang BPE encoder (O(N_merges) linear scan per pair — see
// BPE_TOKENIZE_BOTTLENECK.md; never finishes at V=151643). #1296 actually
// measured against the 24-line corpus_diverse_trim.jsonl; this fire uses the
// SAME trim corpus for an apples-to-apples comparison (C step1 CE=648.526
// reproduces #1296's initial CE exactly).
//
// Pod-side `hexa run` is dead on Ubuntu 22.04 (GLIBC 2.35 < 2.38) so the C is
// compiled on the pod. Pod B's apt lacked the `clang` package — gcc used there
// (portable C; only -fbracket-depth is clang-specific and unneeded for gcc).
//
// a_fire_recover_complete: per pod, harvest result.json + trainer.out/err +
// nvidia_smi + build logs into state/m4b_auxloss_dscale_2026_05_28/<pod>/harvest/,
// MANIFEST.sha256, model card, HF upload (dancinlab, PRIVATE unless a pod cleanly
// ESCAPEs 5/5), THEN `runpodctl pod remove <id>`.

fn pod_runbook(tag: string, d: string, alpha: string, pod_id: string,
               host: string, port: string) {
    print("─── POD ") ; print(tag) ; print("  d=") ; print(d)
    print(" aux_alpha=") ; print(alpha) ; print("  pod=") ; print(pod_id)
    print("  ssh root@") ; print(host) ; print(":") ; println(port)
    println("  1. toolchain: apt install clang (gcc fallback) ; mkdir /work/self /opt/qwen /opt/corpus /opt/anima/state/m4b_auxloss")
    println("  2. scp: self_tree.tgz + glue.c + trainer.c + merges.txt + vocab.json + corpus_diverse_trim.jsonl")
    println("  3. build: tar xzf self_tree.tgz ; nvcc -DHEXA_CUDA -arch=sm_90 -c self/cuda/runtime_cuda.c -o runtime_cuda.o ;")
    println("           {clang|gcc} -DHEXA_CUDA trainer.c glue.c self/runtime.c runtime_cuda.o -lcublas -lcudart -lcuda -o trainer")
    print("  4. fire:  M4B_D=") ; print(d) ; print(" M4B_AUX_ALPHA=") ; print(alpha)
    print(" M4B_N_STEPS=200 M4B_RUN_TAG=") ; print(tag)
    println(" M4B_RESULT_DIR=/opt/anima/state/m4b_auxloss timeout 2400 ./trainer (hexa cloud nohup)")
    println("  5. poll until /opt/anima/state/m4b_auxloss/result.json ; harvest ALL ; MANIFEST ; HF ; runpodctl pod remove")
}

fn main() {
    println("=== fire_m4b_auxloss_3pod — PARALLEL H100 ablation (artifact-of-record) ===")
    println("cost: H100 80GB SECURE @ $3.29/hr × 3 PARALLEL × ~0.5-1.0hr ≈ $5-10 (a_fire_autonomous)")
    println("pre-registered escape gate (per pod): TTR>=0.30 AND LZ_norm>=0.50 AND distinct_experts>=2")
    println("")
    // actual pod ids from the fire (recorded in <pod>/pod_id.txt):
    pod_runbook("A", "256", "2.0", "a09l0mqvq5um7b", "64.247.201.48", "13877")
    pod_runbook("B", "256", "0.0", "ssdqtdjxebncdr", "103.207.149.87", "16085")
    pod_runbook("C", "64",  "2.0", "760nph93n0p98x", "64.247.201.60", "18524")
    println("")
    println("attribution: escape@A ⇒ capacity+routing · escape@B(not C) ⇒ capacity · escape@C(not B) ⇒ routing")
    println("FIRE_M4B_AUXLOSS_3POD: runbook (orchestration via hexa cloud — see M4B_AUXLOSS_DSCALE_RESULT.md)")
}
