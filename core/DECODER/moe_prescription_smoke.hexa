// CORE/DECODER/moe_prescription_smoke.hexa — 3-조건 더블바인드 처방 invariant
// anchor: M4b toy(hard) + D3 #1269 + E2 #1279 + Phase 5b under-train.

import "CORE/DECODER/moe_prescription.hexa"

fn assert_eq_f(name: string, got: float, want: float) -> bool {
    let d = if got - want < 0.0 { want - got } else { got - want }
    let ok = d <= 1e-9
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn assert_eq_i(name: string, got: int, want: int) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn main() {
    print("=== moe_prescription smoke (3-조건 더블바인드 escape) ===")
    let mut npass = 0
    let mut ntotal = 0

    // I1: 4 조건 모두 충족 (hard · TTR 0.35 · 200 step · aux-loss) → 1.0 (escape)
    ntotal = ntotal + 1
    if assert_eq_f("I1 all_met_escape", moe_prescription_ok(1.0, 0.35, 200.0, 1.0), 1.0) {
        npass = npass + 1
    }
    // I2: soft router (is_hard=0) → 0.0
    ntotal = ntotal + 1
    if assert_eq_f("I2 soft_router_fail", moe_prescription_ok(0.0, 0.35, 200.0, 1.0), 0.0) {
        npass = npass + 1
    }
    // I3: collapse-prone corpus (TTR 0.03) → 0.0 (D3 skew)
    ntotal = ntotal + 1
    if assert_eq_f("I3 skewed_corpus_fail", moe_prescription_ok(1.0, 0.03, 200.0, 1.0), 0.0) {
        npass = npass + 1
    }
    // I4: under-train (20 step) → 0.0 (수렴 floor 미달)
    ntotal = ntotal + 1
    if assert_eq_f("I4 under_train_fail", moe_prescription_ok(1.0, 0.35, 20.0, 1.0), 0.0) {
        npass = npass + 1
    }
    // I6 (H_666): aux-loss 없으면 → 0.0 (escape lever 부재 = #1296/Phase 5b collapse 재현)
    ntotal = ntotal + 1
    if assert_eq_f("I6 no_aux_loss_collapse", moe_prescription_ok(1.0, 0.35, 200.0, 0.0), 0.0) {
        npass = npass + 1
    }
    // I5: missing 진단 — soft → 1, corpus → 2, steps → 3, aux → 4, 충족 → 0
    ntotal = ntotal + 1
    if assert_eq_i("I5a missing_hard", moe_prescription_missing(0.0, 0.35, 200.0, 1.0), 1) {
        npass = npass + 1
    }
    ntotal = ntotal + 1
    if assert_eq_i("I5b missing_corpus", moe_prescription_missing(1.0, 0.03, 200.0, 1.0), 2) {
        npass = npass + 1
    }
    ntotal = ntotal + 1
    if assert_eq_i("I5c missing_steps", moe_prescription_missing(1.0, 0.35, 20.0, 1.0), 3) {
        npass = npass + 1
    }
    ntotal = ntotal + 1
    if assert_eq_i("I5e missing_aux (H_666 lever)", moe_prescription_missing(1.0, 0.35, 200.0, 0.0), 4) {
        npass = npass + 1
    }
    ntotal = ntotal + 1
    if assert_eq_i("I5d all_met", moe_prescription_missing(1.0, 0.35, 200.0, 1.0), 0) {
        npass = npass + 1
    }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
