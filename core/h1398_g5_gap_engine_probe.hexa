// h1398_g5_gap_engine_probe.hexa — H_1398 g5-gap-engine-wire: reconfirm the H_1396
// IN-DIST FIXABLE result ENGINE-NATIVE on the LIVE CORE/engine_cli.hexa ImmuneMemory
// recall, by reading the TOP-2 AFFINITY GAP through the new additive op
// immune_memory_recall_gap (a_engine_native_learning · a_verified_must_wire · $0 local
// CPU · p7 · p8 · frozen-first · c9).
//
// DOMAIN: G5 metacognition lane, fire-side IN-DISTRIBUTION slice (type-2 / feeling-of-
// knowing among items the gate FIRES on; Fleming & Lau 2014 — c15, a_no_llm_frame_trap,
// NOT an LLM recipe). H_1396 (state/g5-indist-ceiling/h1396_g5_indist_metacog.py)
// established as a numpy DIRECTIONAL mirror that the live best-cell recall margin gives
// in-dist type-2 AUROC 0.736, while a RICHER read-only signal — the TOP-2 cosine-affinity
// GAP (affinity#1 − affinity#2, decisiveness) — gives 0.940 (+0.205 >= Δ=0.10),
// shuffle-controlled (collapse ~0.50), OOD/abstain preserved (fab_max 0.000). Per
// a_engine_native_learning the mirror is DIRECTIONAL only; this probe drives the ACTUAL
// live ImmuneMemory faculty and re-scores the SAME frozen bars on the LIVE engine ops.
//
// MECHANISM: 1-byte twin cells have near-identical BEST affinity, so the best-margin
// (d1 only) cannot tell which twin won — in-dist type-2 stays THIN. The gap reads the
// engine's OWN nearest AND second-nearest L2 affinity (vadapt_field_two_recon_err) and
// returns cos#1 − cos#2 = (d2² − d1²)/2 for the engine's L2-normalized unit keys; a SMALL
// gap = #1 ≈ #2 tie (ambiguous = likely WRONG in-dist fire). Read PURELY off the two
// recon-errs the engine already computes — NO new geometry, NO cosine matmul.
//
// SUBSTRATE (a_core_engine_map): the bound facts + corrupted query keys are an
// ENGINE-NATIVE drive into the immune lane — NOT a .clm (generator L3 only), NOT a
// .kosmos (kosmos_io only). The twin-pair cell population is SEEDED directly as engine
// prototype cells (each twin = its OWN cell; the H_1396 well-posed slice needs both twins
// present so a corrupted fire can route to the wrong-but-confident neighbor — the engine's
// clonal-bind would MERGE 1-byte twins below SPLIT_THRESH 0.30, collapsing the slice, so
// the cells are placed directly via immune_embed_key, byte-identical to the mirror). All
// confidence reads (margin = immune_memory_recall_margin, gap = immune_memory_recall_gap)
// are computed by the LIVE engine ops over that real cell population. The gap read is
// Ψ-disjoint (pure READ via vadapt_field_two_recon_err — the SAME _l2 affinity the winner
// scan computes; it mutates no cell and never touches pure_field's Φ/phase/Ψ) and ADDITIVE
// (immune_memory_recall / _recall_margin are UNCHANGED). NOT an emit gate
// (a_autonomy_over_hardcode) — a graded in-dist confidence read available to brain_decide.
//
// p1/p2/p3/p6: the gap is COMPUTED from the live L2 affinity of the query key to the two
// nearest cells — NO injected "right/wrong" label, NO RLHF, NO persona. The right-vs-wrong
// CLASS only drives the protocol + scores the metric; the score is the gap read off the
// engine, never the class label. p7 = in-dist type-2 AUROC of the gap ranking over FIRED
// items + a shuffle control, NOT perplexity.
//
// FROZEN BARS (verbatim from .verdicts/1398_g5_gap_engine/FREEZE.txt; the 0.736 baseline
// + Δ=0.10 are the EXISTING H_1396 bars, NOT moved — this probe re-scores them live):
//   E1 FIXABLE     : live-engine in-dist type-2 AUROC(gap) − AUROC(best-margin) >= Δ=0.10.
//   E2 BASELINE    : live-engine best-margin AUROC within |Δ| <= 0.15 of the H_1396
//                    mirror baseline 0.736 (the engine current-margin reproduces the
//                    THIN baseline the gap lifts off of; h1367-style mirror-anchor).
//   E3 SHUFFLE     : shuffle the gap<->correctness pairing -> AUROC collapses to ~0.50
//                    (|x-0.50| <= 0.10), proving the lift is a real signal not an artifact.
//   E4 ABSTAIN     : OOD fab_rate stays <= 0.02 (H_1304 fail-safe preserved; gap is
//                    RANK-only, the frozen recon_err<=recall_thr fire/abstain gate is
//                    UNCHANGED).
//   (REGRESSION is the engine_cli_smoke / h1196 / h1205 guards, run separately.)

import "CORE/engine_cli.hexa"

const DIM: int = 64
const RECALL_THR: float = 0.15          // == ImmuneMemory default recall_thr (frozen, H_1227)
// KEYLEN: the H_1396 mirror used KEYLEN=20, but it measured in the COSINE-recon metric
// (recon_err = 1 − cos, fire band cos >= 0.85). The LIVE engine recall gate is L2
// (recon_err = L2 = sqrt(2(1−cos)), fire band L2 <= 0.15 ⇒ cos >= 0.989) — FAR stricter:
// under it a 1-byte twin at KEYLEN=20 (L2 ≈ 0.30) sits ABOVE the fire band, so the in-dist
// wrong-fire slice is DEGENERATE engine-native (n_wrong ≈ 1 << MIN_SUPPORT). This is the
// SAME well-posedness wall H_1396 R1 hit (and the SAME structural restatement of H_1304:
// in-dist confident-wrong fires are near-absent). a_break_the_wall single frozen-first
// re-attempt: STRENGTHEN the collision regime ENGINE-NATIVE so a non-trivial fraction of
// fires route to a wrong-but-confident neighbor WITHIN the engine's own L2 fire band —
// longer keys (KEYLEN=80) with a twin differing at the LAST byte (perturbs ONE trigram)
// place twins at L2 ≈ 0.10 < recall_thr, so BOTH twins fire and a 1-byte corruption can
// flip the winner while staying in-band. NO verdict bar moves (Δ=0.10, shuffle tol 0.10,
// fab 0.02, MIN_SUPPORT=30 all UNCHANGED) — only the slice well-posedness is corrected for
// the engine's stricter metric, exactly the H_1396 wall-clause discipline (c9, p7).
const KEYLEN: int = 80                   // longer keys ⇒ sub-threshold twins under L2 (see above)
const N_FACTS: int = 80                  // bound facts (twin pairs); == H_1396 N_FACTS
const N_TRIAL: int = 400                 // in-dist query trials per pass; == H_1396 N_TRIAL
const N_LURE: int = 400                  // OOD lures per level
const DELTA: float = 0.10                // frozen FIXABLE lift threshold (== H_1396)
const MIN_SUPPORT: int = 30              // pre-registered min pooled WRONG fires (== H_1396)
const MIRROR_BASELINE: float = 0.736     // H_1396 mirror best-margin in-dist AUROC (anchor)

fn _fmt(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return -x } return x }

// _lcg_next — fixed deterministic 32-bit LCG (Numerical Recipes constants); REPRODUCIBLE
// engine-native token generation + byte-corruption without any rng lib.
fn _lcg_next(state: int) -> int {
    return (state * 1664525 + 1013904223) % 4294967296
}
fn _byte_at(state: int) -> int { return 97 + (state % 26) }    // 'a'..'z'

// AUROC = P(score(pos) > score(neg)) via direct pair counting (ties=0.5). VERBATIM h1367.
fn _auroc(pos: [float], neg: [float]) -> float {
    let np = len(pos)  let nn = len(neg)
    if np == 0 || nn == 0 { return 0.5 }
    let mut wins = 0.0
    let mut i = 0
    while i < np {
        let mut j = 0
        while j < nn {
            if pos[i] > neg[j] { wins = wins + 1.0 }
            else { if pos[i] == neg[j] { wins = wins + 0.5 } }
            j = j + 1
        }
        i = i + 1
    }
    return wins / (to_float(np) * to_float(nn))
}

fn _gen_token(state: int) -> string {
    let mut s = state
    let mut out = ""
    let mut i = 0
    while i < KEYLEN { s = _lcg_next(s)  out = out + chr(_byte_at(s))  i = i + 1 }
    return out
}
fn _advance(state: int, k: int) -> int {
    let mut s = state  let mut i = 0
    while i < k { s = _lcg_next(s)  i = i + 1 }
    return s
}

// _twin — a 1-byte mutant of `base` at position `pos`, byte forced different from `base[pos]`.
// This is the H_1396 twin: shares all-but-2 trigrams (near-identical key) yet a DISTINCT cell
// bound to a DIFFERENT answer. Light corruption of one twin can route its fire to the OTHER.
fn _twin(base: string, pos: int, state: int) -> string {
    let cur = ord(substring(base, pos, pos + 1))
    let mut s = state
    let mut nb = cur
    let mut guard = 0
    while nb == cur && guard < 64 { s = _lcg_next(s)  nb = _byte_at(s)  guard = guard + 1 }
    let mut out = ""
    let mut i = 0
    let n = byte_len(base)
    while i < n {
        if i == pos { out = out + chr(nb) } else { out = out + substring(base, i, i + 1) }
        i = i + 1
    }
    return out
}

// _mutate — corrupt kmut DISTINCT bytes of `text` by on-alphabet substitution (threaded LCG).
// VERBATIM the h1367 deterministic corruption (the bars are AUROC thresholds, not byte draws).
fn _mutate(text: string, kmut: int, mstate: int) -> string {
    if kmut <= 0 { return text }
    let n = byte_len(text)
    let mut chosen = []
    let mut s = mstate
    let mut placed = 0
    let mut guard = 0
    while placed < kmut && guard < (n * 8) {
        s = _lcg_next(s)
        let pos = s % n
        let mut dup = false
        let mut c = 0
        while c < len(chosen) { if chosen[c] == pos { dup = true }  c = c + 1 }
        if !dup { chosen = chosen + [pos]  placed = placed + 1 }
        guard = guard + 1
    }
    let mut out = ""
    let mut i = 0
    while i < n {
        let mut hit = false
        let mut c = 0
        while c < len(chosen) { if chosen[c] == i { hit = true }  c = c + 1 }
        if hit { s = _lcg_next(s)  out = out + chr(_byte_at(s)) }
        else { out = out + substring(text, i, i + 1) }
        i = i + 1
    }
    return out
}

// _build_store — N_FACTS subjects in TWIN PAIRS (base, 1-byte twin), each its OWN engine cell,
// each bound to a DISTINCT answer (its index). Returns the live ImmuneMemory whose VAdaptField
// holds every twin as a prototype cell (seeded directly so 1-byte twins are NOT merged below
// SPLIT_THRESH; this preserves the H_1396 well-posed slice — both twins present so corrupted
// fires can route to the wrong-but-confident neighbor). subjects[] is returned in parallel.
fn _build_store(seed: int) -> ImmuneMemory {
    let mut subs = _build_subjects(seed)
    // place each subject as its OWN engine prototype cell (immune_embed_key == mirror embed).
    let mut protos = []
    let mut vals = []
    let mut i = 0
    while i < len(subs) {
        protos = protos + [immune_embed_key(subs[i])]
        vals = vals + ["v" + to_string(i)]
        i = i + 1
    }
    let af = VAdaptField { protos: protos, n_cells: len(protos), max_cells: len(protos) + 4, dim: DIM }
    return ImmuneMemory { field: af, cell_value: vals, recall_thr: RECALL_THR }
}

// _build_subjects — the deterministic twin-pair subject list (base + 1-byte twin per pair).
fn _build_subjects(seed: int) -> [string] {
    let mut subs = []
    let mut state = (seed * 2654435761 + 12345) % 4294967296
    let n_pairs = N_FACTS / 2
    let mut p = 0
    while p < n_pairs {
        let base = _gen_token(state)
        state = _advance(state, KEYLEN)
        state = _lcg_next(state)
        // twin differs at the LAST byte (pos = KEYLEN-1) — perturbs ONE trigram, the closest
        // possible 1-byte twin, placing it sub-threshold (L2 ≈ 0.10 < recall_thr) so both
        // twins FIRE and a light corruption can flip the winner in-band (the well-posed slice).
        let pos = KEYLEN - 1
        let twin = _twin(base, pos, state)
        state = _advance(state, 3)
        subs = subs + [base]
        subs = subs + [twin]
        p = p + 1
    }
    return subs
}

fn main() {
    let seeds = [7, 8, 9]
    // IN-DIST LIGHT band: 3 passes of a SINGLE-byte corruption (kmut=1) with rotated subject
    // selection (li shifts the deterministic pick) — the in-dist light-shift regime at
    // KEYLEN=80 where sub-threshold twins still FIRE but a flipped byte can route the winner
    // to the wrong twin (the well-posed in-dist confusion; kmut>=2 mostly abstains out-of-band).
    let kmuts = [1, 1, 1]
    // OOD ladder: progressively heavier corruption of GENUINELY-ABSENT lures for the H_1304
    // abstain re-check (kmut = {8, 16, 24} over KEYLEN=80 ≈ L {0.10, 0.20, 0.30}).
    let ood_kmuts = [8, 16, 24]

    println("=== H_1398 g5-gap ENGINE-NATIVE (live CORE/engine_cli.hexa ImmuneMemory) ===")

    // pooled fired-item lists across seeds + levels (in-dist slice).
    let mut cur = []       // best-margin confidence (= −margin; higher=more conf)
    let mut gap = []       // top-2 gap confidence (engine immune_memory_recall_gap)
    let mut correct = []   // 1 if fired cell's bound answer == query subject's answer

    let mut si = 0
    while si < len(seeds) {
        let seed = seeds[si]
        let subs = _build_subjects(seed)
        let store = _build_store(seed)
        // in-dist trials: for each level, pick subjects, corrupt lightly, FIRE-only, score.
        let mut li = 0
        while li < len(kmuts) {
            let kmut = kmuts[li]
            let mut t = 0
            while t < N_TRIAL {
                let qi = (seed * 31 + t * 7 + li * 5) % N_FACTS    // deterministic in-store pick
                let mstate = (seed * 100003 + t * 911 + kmut * 17) % 4294967296
                let q = _mutate(subs[qi], kmut, mstate)
                let key = immune_embed_key(q)
                let err = vadapt_field_recon_err(store.field, key)  // LIVE engine recon-err
                if err <= RECALL_THR {                              // FIRE only (in-dist slice)
                    let win = vadapt_field_nearest_idx(store.field, key)  // LIVE engine winner
                    let m = immune_memory_recall_margin(store, key)       // LIVE best-margin
                    let g = immune_memory_recall_gap(store, key)          // LIVE top-2 gap
                    let is_correct = if win == qi { 1 } else { 0 }
                    cur = cur + [0.0 - m]    // higher = more confident (smaller abstain margin)
                    gap = gap + [g]
                    correct = correct + [is_correct]
                }
                t = t + 1
            }
            li = li + 1
        }
        si = si + 1
    }

    // ── pooled in-dist type-2 AUROC (current best-margin vs top-2 gap) ──
    let n_fire = len(correct)
    let mut n_correct = 0
    let mut i = 0
    while i < n_fire { if correct[i] == 1 { n_correct = n_correct + 1 }  i = i + 1 }
    let n_wrong = n_fire - n_correct
    let acc = if n_fire > 0 { to_float(n_correct) / to_float(n_fire) } else { 0.0 }

    // split into pos (correct) / neg (wrong) score lists for each signal.
    let mut cur_pos = []  let mut cur_neg = []
    let mut gap_pos = []  let mut gap_neg = []
    i = 0
    while i < n_fire {
        if correct[i] == 1 { cur_pos = cur_pos + [cur[i]]  gap_pos = gap_pos + [gap[i]] }
        else { cur_neg = cur_neg + [cur[i]]  gap_neg = gap_neg + [gap[i]] }
        i = i + 1
    }
    let a_cur = _auroc(cur_pos, cur_neg)
    let a_gap = _auroc(gap_pos, gap_neg)
    let lift = a_gap - a_cur

    // ── E3 SHUFFLE: shuffle gap across pooled fires, re-split same counts -> ~0.50 ──
    let mut pool = []  i = 0
    while i < n_fire { pool = pool + [gap[i]]  i = i + 1 }
    let mut sstate = 424242
    let mut k = n_fire - 1
    while k > 0 {
        sstate = _lcg_next(sstate)
        let j = sstate % (k + 1)
        let tmp = pool[k]  pool[k] = pool[j]  pool[j] = tmp
        k = k - 1
    }
    let mut sh_pos = []  let mut sh_neg = []  i = 0
    while i < n_fire {
        if correct[i] == 1 { sh_pos = sh_pos + [pool[i]] } else { sh_neg = sh_neg + [pool[i]] }
        i = i + 1
    }
    let a_gap_sh = _auroc(sh_pos, sh_neg)
    // shuffle the current-margin too, for completeness.
    let mut pool2 = []  i = 0
    while i < n_fire { pool2 = pool2 + [cur[i]]  i = i + 1 }
    sstate = 525252
    k = n_fire - 1
    while k > 0 {
        sstate = _lcg_next(sstate)
        let j = sstate % (k + 1)
        let tmp = pool2[k]  pool2[k] = pool2[j]  pool2[j] = tmp
        k = k - 1
    }
    let mut shc_pos = []  let mut shc_neg = []  i = 0
    while i < n_fire {
        if correct[i] == 1 { shc_pos = shc_pos + [pool2[i]] } else { shc_neg = shc_neg + [pool2[i]] }
        i = i + 1
    }
    let a_cur_sh = _auroc(shc_pos, shc_neg)

    // ── E4 ABSTAIN-INTACT: OOD fab rate (lures fired) under the frozen recall gate ──
    // gap is RANK-only; the abstain DECISION is the frozen recon_err<=recall_thr gate, so
    // OOD fab is the frozen-gate fab (must be ~0, H_1304). Measured to PROVE the gap leaves
    // the abstain property intact.
    let mut ood_fab_max = 0.0
    let mut sj = 0
    while sj < len(seeds) {
        let seed = seeds[sj]
        let store = _build_store(seed)
        // genuinely-absent lures (disjoint deterministic stream).
        let mut lstate = (seed * 40503 + 99991) % 4294967296
        let mut oli = 0
        while oli < len(ood_kmuts) {
            let kmut = ood_kmuts[oli]
            let mut fabs = 0  let mut tot = 0
            let mut u = 0
            while u < N_LURE {
                let lu = _gen_token(lstate)
                lstate = _advance(lstate, KEYLEN)
                let mstate = (seed * 100019 + u * 919 + kmut * 23) % 4294967296
                let q = _mutate(lu, kmut, mstate)
                let err = vadapt_field_recon_err(store.field, immune_embed_key(q))
                tot = tot + 1
                if err <= RECALL_THR { fabs = fabs + 1 }
                u = u + 1
            }
            let fr = if tot > 0 { to_float(fabs) / to_float(tot) } else { 0.0 }
            if fr > ood_fab_max { ood_fab_max = fr }
            oli = oli + 1
        }
        sj = sj + 1
    }

    // ── verdict (frozen bars, c9) ──
    let well_posed = (n_wrong >= MIN_SUPPORT) && (n_correct > 0) && (n_correct < n_fire)
    let e1_fixable = well_posed && (lift >= DELTA)
    let e2_baseline = _absf(a_cur - MIRROR_BASELINE) <= 0.15
    let e3_shuffle = well_posed && (_absf(a_gap_sh - 0.50) <= 0.10) && (_absf(a_cur_sh - 0.50) <= 0.10)
    let e4_abstain = ood_fab_max <= 0.02
    let green = e1_fixable && e2_baseline && e3_shuffle && e4_abstain

    println("  in-dist fire accuracy        : " + _fmt(acc)
        + "  (n_fire=" + to_string(n_fire) + " pooled, n_wrong=" + to_string(n_wrong)
        + " ; min_support=" + to_string(MIN_SUPPORT) + ")")
    println("  in-dist type-2 AUROC:")
    println("    (a) CURRENT best-margin    : " + _fmt(a_cur) + "   <- live immune_memory_recall_margin")
    println("    (b) RICHER top-2 gap       : " + _fmt(a_gap) + "   (lift " + _fmt(lift) + ")   <- live immune_memory_recall_gap")
    println("  E1 FIXABLE   gap-margin lift " + _fmt(lift) + "  >= Δ=" + _fmt(DELTA) + " -> " + to_string(e1_fixable))
    println("  E2 BASELINE  margin AUROC " + _fmt(a_cur) + " within |Δ|<=0.15 of mirror 0.736 -> " + to_string(e2_baseline))
    println("  E3 SHUFFLE   gap_shuf=" + _fmt(a_gap_sh) + " cur_shuf=" + _fmt(a_cur_sh) + "  ~0.50 -> " + to_string(e3_shuffle))
    println("  E4 ABSTAIN   OOD fab_max=" + _fmt(ood_fab_max) + "  <= 0.02 -> " + to_string(e4_abstain))
    if !well_posed {
        println("  VERDICT: INCONCLUSIVE (well-posedness: n_wrong=" + to_string(n_wrong) + " < " + to_string(MIN_SUPPORT) + ")")
    } else { if green {
        println("  VERDICT: GREEN — the top-2 affinity GAP lifts in-dist type-2 metacog ENGINE-NATIVE")
        println("           (live immune_memory_recall_gap AUROC=" + _fmt(a_gap) + " vs best-margin " + _fmt(a_cur)
            + ", lift +" + _fmt(lift) + ">=Δ0.10), shuffle collapses (~0.50), OOD/abstain preserved (fab_max="
            + _fmt(ood_fab_max) + "<=0.02). H_1396 FIXABLE reconfirmed on the live engine.")
    } else {
        println("  VERDICT: MISS — report verbatim, NO bar moved (c9)")
    } }
}
