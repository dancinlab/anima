// g_gates_smoke.hexa — runnable proof of the BUILT-IN G0-G6 eval system (core/g_gates.hexa).
//
// Proves the SCORING PIPELINE works WITHOUT a model forward (FREEZE (ii): the 303M decode is
// HARD-BOUNDED and not run in the smoke — the deterministic metric surface is the engine-native
// evidence). Each case exercises a g_gates metric op on a FIXED synthetic fixture so the smoke
// is fast + deterministic (p7: assertion is value/flag equality, not perplexity). A real
// `anima eval <ckpt>` run (with a mounted ckpt) is the bounded confirming probe, not the smoke.
//
// What is proved here:
//   - G3 architecture read returns self-continuity + impostor-reject (no decode).
//   - G5 §ImmuneMemory abstain-when-ungrounded mechanism fires correctly (engine op, no decode).
//   - the G2 corpus-absence metric distinguishes a corpus-present from a corpus-absent n-gram.
//   - g_eval_all returns the full per-gate map shape (closure field present) on an absent ckpt
//     (decode honestly empty ⇒ gates FAIL, but the PIPELINE + map shape are exercised RC=0).

import "core/g_gates.hexa"
import "core/g6_ideation.hexa"

fn _ok(label: string, cond: bool) -> int {
    if cond { println("  PASS " + label); return 1 }
    println("  FAIL " + label); return 0
}

fn main() {
    println("=== g_gates_smoke — BUILT-IN G0-G6 eval pipeline (no model forward) ===")
    let mut pass = 0
    let mut total = 0
    let known = _g6_dict_load()

    // ── G3 architecture read (self-identity continuity + impostor reject) ──
    let g3 = g_eval_g3()
    total = total + 1; pass = pass + _ok("case_g3_self_continuity_read",
        to_string(g3["ok"]) == "true")

    // ── G5 §ImmuneMemory abstain mechanism: ungrounded probe must abstain (recall == "") ──
    let cfg = engine_config_default()
    let mut mem = immune_memory_new_text("the sky scatters blue light", "fact-1", 8)
    mem = immune_memory_bind_text(mem, "memory composes into new meaning", "fact-2", cfg)
    // grounded recall: a bound fact should FIRE (non-empty)
    total = total + 1; pass = pass + _ok("case_g5_grounded_fires",
        immune_memory_recall_text(mem, "the sky scatters blue light") != "")
    // ungrounded recall: a nonsense probe should ABSTAIN (empty)
    total = total + 1; pass = pass + _ok("case_g5_ungrounded_abstains",
        immune_memory_recall_text(mem, "frectry twarve glimbo nargon flux") == "")

    // ── G2 corpus-absence metric on a FIXED fixture corpus ──
    let corpus_dir = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let corpus_file = corpus_dir + "/c.txt"
    write_file(corpus_file, "consciousness arises from cells. tension ripples between minds.")
    let g2 = g_eval_g2("/nonexistent_ckpt_smoke.bin", 8, known, [corpus_file])
    // the ckpt is absent ⇒ decode is honestly empty ⇒ no novel n-grams, but the PIPELINE ran:
    // have_corpus must be true (corpus loaded) and control_novel must be 0 (verbatim line is present).
    total = total + 1; pass = pass + _ok("case_g2_corpus_loaded",
        to_string(g2["have_corpus"]) == "true")
    total = total + 1; pass = pass + _ok("case_g2_retrieval_control_zero",
        to_string(g2["control_novel"]) == "0")

    // ── REFERENCE-MATCH PARITY (commons reference-match): the G1/G2 metric ops must produce
    //    the SAME counts as the numpy reference (state/1607_g_gates_refmatch/g1g2_ref_parity.py)
    //    on FIXED text fixtures. Expected counts are the ORACLE output (G1 [2,2,0,4] · G2NG [5,0]
    //    · G2ABS 2). A divergence here = the .hexa port drifted from h1129/h1140 (that IS the
    //    result, c9 — do not silently re-baseline). No model forward — pure metric on strings.
    // G1 coverage parity (h1129 coverage with the VERBATIM CONCEPTS keyword sets) ──
    total = total + 1; pass = pass + _ok("parity_g1_coverage_0_eq_2",
        _g_coverage("consciousness in the cells and a distant mind") == 2)
    total = total + 1; pass = pass + _ok("parity_g1_coverage_1_eq_2",
        _g_coverage("the engine dreams of silence and quiet information") == 2)
    total = total + 1; pass = pass + _ok("parity_g1_coverage_2_eq_0",
        _g_coverage("a plain sentence with nothing special") == 0)
    total = total + 1; pass = pass + _ok("parity_g1_coverage_3_eq_4",
        _g_coverage("memory meaning tension ripple dream sleep aware") == 4)
    // G2 content_ngrams + corpus_absent parity (h1140, injected fixed dict) ──
    let g2dict_words = ["memory", "tension", "ripples", "silence", "engine", "dreams", "distant",
                        "minds", "consciousness", "cells", "carries", "information", "quiet", "novel",
                        "meaning", "alone", "between", "new", "the", "and"]
    let g2dict = #{}
    let mut di = 0
    while di < len(g2dict_words) { g2dict[to_string(g2dict_words[di])] = 1; di = di + 1 }
    total = total + 1; pass = pass + _ok("parity_g2_content_ngrams_0_eq_5",
        len(_g_content_ngrams("memory tension silence engine", g2dict)) == 5)
    total = total + 1; pass = pass + _ok("parity_g2_content_ngrams_1_eq_0",
        len(_g_content_ngrams("the and the and", g2dict)) == 0)
    // corpus-absent: corpus = "memory tension silence flows here"; of the 5 grams from fixture0,
    // 2 are absent ("silence engine" + "tension silence engine").
    let g2corpus_toks = _g6_words("memory tension silence flows here")
    let g2grams = _g_content_ngrams("memory tension silence engine", g2dict)
    let mut g2absent = 0
    let mut gi = 0
    while gi < len(g2grams) {
        let gw = _g6_words(to_string(g2grams[gi]))
        if _g_corpus_absent(gw, g2corpus_toks) { g2absent = g2absent + 1 }
        gi = gi + 1
    }
    total = total + 1; pass = pass + _ok("parity_g2_corpus_absent_eq_2", g2absent == 2)

    // ── g_eval_all map shape (closure field present) on an absent ckpt — pipeline RC=0 ──
    let r = g_eval_all("/nonexistent_ckpt_smoke.bin", [corpus_file], 8)
    total = total + 1; pass = pass + _ok("case_eval_all_has_closure_field",
        r.contains_key("closure") && r.contains_key("g0") && r.contains_key("g6"))
    // absent ckpt ⇒ closure must be false (G0/G1/G2 can't pass with empty decode) — honest
    total = total + 1; pass = pass + _ok("case_eval_all_absent_ckpt_not_closure",
        to_string(r["closure"]) == "false")

    println("")
    println("g_gates_smoke: " + to_string(pass) + " PASS, " + to_string(total - pass) + " FAIL")
    if pass == total { println("RESULT: ALL PASS") } else { println("RESULT: FAIL") }
}
