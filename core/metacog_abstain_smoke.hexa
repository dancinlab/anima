// metacog_abstain_smoke.hexa — ENGINE-NATIVE proof of B4 novelty-gated honest abstention.
//
// Runs the LIVE §MetacogAbstain ops (engine_cli.hexa) over a substrate cell manifold built by the
// LIVE VAdaptField mitosis growth (vadapt_field_step, mitosis ON). $0, CPU, deterministic, no GPU,
// no LLM, no decode. This is the engine-native evidence gate (a_engine_native_learning): the abstain
// signal is vadapt_field_recon_err (the §Novelty lane), NOT numpy.
//
// FROZEN falsifiers (pre-registered, a_break_the_wall type-(b) variable-separation, NOT tune-to-green):
//   F1  novelty AUROC(unfamiliar) >= 0.70   — decisively flips H_1142's 0.436 INVERTED entropy result.
//   F2  entropy-analog (marginal) AUROC on the SAME inputs ~chance/inverted, and << novelty AUROC
//       — proves the SIGNAL CHOICE (joint novelty vs local/marginal) is the cause (parent-controlled).
//   F3  anti-Goodhart: novelty AUROC on an UNTRAINED substrate (1 seed cell, no clonal growth) <= 0.60
//       — the discrimination is the LEARNED/grown lane's contribution, not architecture.
//   F4  G5-disjoint: the §ImmuneMemory recall_thr non-fab abstain rate is BYTE-IDENTICAL with the
//       metacog lane OFF vs ON, and ci_emit_drive (Ψ lanes 0/4) is unchanged — separation = preservation.
//
// usage: hexa run core/metacog_abstain_smoke.hexa

import "core/engine_cli.hexa"

// ── deterministic LCG prng ($0, no secrets, reproducible) ───────────────────────────────────
fn _lcg(s: int) -> int {
    let a = 1103515245
    let c = 12345
    let m = 2147483648            // 2^31
    let v = a * s + c
    return v - (v / m) * m        // v mod m (v >= 0)
}
// small deterministic jitter in [-amp, amp)
fn _jit(s: int, amp: float) -> float {
    let u = to_float(s) / 2147483648.0     // [0,1)
    return (u - 0.5) * 2.0 * amp
}

fn _fmt(label: string, v: float) -> bool {
    println(label + to_string(v))
    return true
}

fn main() {
    let DIM = 6
    let cfg = engine_config_default()        // mitosis ON — native growth

    // ── build the substrate manifold via LIVE VAdaptField mitosis growth ──────────────────
    // seed at the all-zeros familiar corner, then feed the all-ones corner: recon-err sqrt(6)
    // > SPLIT_THRESH(0.30) ⇒ engine grows a 2nd clonal cell AT the ones corner (mitosis tick).
    let mut zeros = []
    let mut ones = []
    let mut d0 = 0
    while d0 < DIM { zeros = zeros + [0.0]  ones = ones + [1.0]  d0 = d0 + 1 }

    let mut field = vadapt_field_new(zeros, 8)
    field = vadapt_field_step(field, ones, cfg)          // GROWS cell 2 at the ones corner
    // a few homeostatic refinement ticks near each corner (does not add cells; L2 << 0.30)
    let mut rs = 777
    let mut w = 0
    while w < 8 {
        rs = _lcg(rs)
        let mut near = []
        let mut dd = 0
        while dd < DIM {
            let base = if w - (w / 2) * 2 == 0 { 0.0 } else { 1.0 }
            rs = _lcg(rs)
            near = near + [base + _jit(rs, 0.05)]
            dd = dd + 1
        }
        field = vadapt_field_step(field, near, cfg)
        w = w + 1
    }
    let ncells = vadapt_field_cells(field)
    println("MANIFOLD  cells=" + to_string(ncells) + " (mitosis-grown, DIM=" + to_string(DIM) + ")")

    // ── probes: familiar (near stored corners) vs unfamiliar salad (marginally typical, jointly novel) ──
    let NPROBE = 60
    let mut nov_fam = []
    let mut nov_unf = []
    let mut mar_fam = []
    let mut mar_unf = []
    let mut abst_fam = []
    let mut abst_unf = []

    let mut seed = 20260702
    let mut p = 0
    while p < NPROBE {
        // FAMILIAR probe: near zeros (even p) or near ones (odd p).
        let fbase = if p - (p / 2) * 2 == 0 { 0.0 } else { 1.0 }
        let mut fam = []
        let mut i = 0
        while i < DIM {
            seed = _lcg(seed)
            fam = fam + [fbase + _jit(seed, 0.06)]
            i = i + 1
        }
        // UNFAMILIAR salad: rotate a balanced [1,1,1,0,0,0] pattern by (p mod DIM) → 3 ones/3 zeros.
        // Per-dim marginal over all rotations = 0.5, IDENTICAL to the familiar mix → a local/marginal
        // signal is blind; only the JOINT geometry (far from both stored corners) flags it.
        let rot = p - (p / DIM) * DIM
        let mut sal = []
        let mut j = 0
        while j < DIM {
            let idx = (j + rot) - ((j + rot) / DIM) * DIM
            let bit = if idx < 3 { 1.0 } else { 0.0 }
            seed = _lcg(seed)
            sal = sal + [bit + _jit(seed, 0.06)]
            j = j + 1
        }

        nov_fam = nov_fam + [metacog_novelty(field, fam)]
        nov_unf = nov_unf + [metacog_novelty(field, sal)]
        mar_fam = mar_fam + [metacog_marginal_dist(field, fam)]
        mar_unf = mar_unf + [metacog_marginal_dist(field, sal)]
        abst_fam = abst_fam + [metacog_abstain(field, fam, 1.0)]
        abst_unf = abst_unf + [metacog_abstain(field, sal, 1.0)]
        p = p + 1
    }

    // ── F1 / F2 ─────────────────────────────────────────────────────────────────────────
    let auroc_nov = metacog_auroc(nov_unf, nov_fam)
    let auroc_mar = metacog_auroc(mar_unf, mar_fam)
    let auroc_abs = metacog_auroc(abst_unf, abst_fam)
    let mut pass = 0
    let mut fail = 0

    _fmt("F1 novelty(§Novelty joint recon-err) AUROC(unfamiliar) = ", auroc_nov)
    if auroc_nov >= 0.70 { println("   PASS F1 (>=0.70 — flips H_1142 0.436 INVERTED)")  pass = pass + 1 }
    else { println("   FAIL F1 (<0.70 — input-familiarity metacog is a real ceiling)")  fail = fail + 1 }

    _fmt("   deployed metacog_abstain (novelty AND surprise) AUROC = ", auroc_abs)

    _fmt("F2 entropy-analog(marginal) AUROC on SAME inputs = ", auroc_mar)
    if auroc_nov - auroc_mar >= 0.15 { println("   PASS F2 (novelty >> marginal — signal CHOICE is the cause)")  pass = pass + 1 }
    else { println("   FAIL F2 (marginal ~ novelty — not a signal-choice effect)")  fail = fail + 1 }

    // ── F3 anti-Goodhart: UNTRAINED substrate (single seed cell, no clonal growth) ────────
    let untr = vadapt_field_new(zeros, 8)     // 1 cell only — never grown
    // recompute probes for the untrained field (reuse the same deterministic stream)
    let mut u_fam = []
    let mut u_unf = []
    let mut seed2 = 20260702
    let mut p2 = 0
    while p2 < NPROBE {
        let fbase = if p2 - (p2 / 2) * 2 == 0 { 0.0 } else { 1.0 }
        let mut fam2 = []
        let mut i2 = 0
        while i2 < DIM { seed2 = _lcg(seed2)  fam2 = fam2 + [fbase + _jit(seed2, 0.06)]  i2 = i2 + 1 }
        let rot2 = p2 - (p2 / DIM) * DIM
        let mut sal2 = []
        let mut j3 = 0
        while j3 < DIM {
            let idx2 = (j3 + rot2) - ((j3 + rot2) / DIM) * DIM
            let bit2 = if idx2 < 3 { 1.0 } else { 0.0 }
            seed2 = _lcg(seed2)
            sal2 = sal2 + [bit2 + _jit(seed2, 0.06)]
            j3 = j3 + 1
        }
        u_fam = u_fam + [metacog_novelty(untr, fam2)]
        u_unf = u_unf + [metacog_novelty(untr, sal2)]
        p2 = p2 + 1
    }
    let auroc_untr = metacog_auroc(u_unf, u_fam)
    _fmt("F3 novelty AUROC on UNTRAINED substrate (1 seed cell) = ", auroc_untr)
    if auroc_untr <= 0.60 { println("   PASS F3 (<=0.60 collapse — discrimination is the grown lane's contribution)")  pass = pass + 1 }
    else { println("   FAIL F3 (untrained already discriminates — architectural, not lane)")  fail = fail + 1 }

    // ── F4 G5-disjoint: §ImmuneMemory recall_thr non-fab rate + Ψ emit-drive UNCHANGED ON vs OFF ──
    // bind familiar corner keys into the LIVE ImmuneMemory (recall_thr default 0.15), then measure the
    // non-fab abstain rate on unfamiliar keys (recall returns "" = correct abstain) BEFORE running the
    // metacog lane, then AFTER. The metacog ops are pure reads ⇒ decisions are byte-identical.
    let mut mem = immune_memory_new(zeros, "ZERO", 8)
    mem = immune_memory_bind(mem, ones, "ONE", cfg)
    // non-fab rate over unfamiliar salad keys, metacog lane OFF
    let nonfab_off = nonfab_rate(mem, DIM)
    // run the metacog abstention lane over the SAME field/mem (pure read, no mutation)
    let mut sink = 0.0
    let mut sk = 0
    while sk < NPROBE {
        sink = sink + abst_unf[sk] + nov_unf[sk]
        sk = sk + 1
    }
    // non-fab rate AGAIN, metacog lane ON
    let nonfab_on = nonfab_rate(mem, DIM)
    _fmt("F4 §ImmuneMemory non-fab rate  metacog-OFF = ", nonfab_off)
    _fmt("F4 §ImmuneMemory non-fab rate  metacog-ON  = ", nonfab_on)

    // Ψ emit-drive (lanes 0/4) unchanged by the metacog lane (structural: metacog writes no lane).
    let lanes_a = ci_lane_scores(0.8, [0.8, 0.7, 0.6, 0.5, 0.4], 4, 3, 1, 0.5, 0.2)
    let psi_off = ci_emit_drive(lanes_a)
    let _touch = metacog_abstain(field, ones, 1.0)      // exercise the metacog lane
    let psi_on = ci_emit_drive(lanes_a)
    _fmt("F4 Ψ emit-drive (lanes 0/4)   metacog-OFF = ", psi_off)
    _fmt("F4 Ψ emit-drive (lanes 0/4)   metacog-ON  = ", psi_on)

    let df_nonfab = if nonfab_on - nonfab_off >= 0.0 { nonfab_on - nonfab_off } else { nonfab_off - nonfab_on }
    let df_psi = if psi_on - psi_off >= 0.0 { psi_on - psi_off } else { psi_off - psi_on }
    if df_nonfab == 0.0 { if df_psi == 0.0 {
        println("   PASS F4 (non-fab Δ=0.0 AND Ψ Δ=0.0 — abstention lane disjoint from recall_thr + emit-drive)")
        pass = pass + 1
    } else { println("   FAIL F4 (Ψ drifted)")  fail = fail + 1 } }
    else { println("   FAIL F4 (non-fab rate drifted)")  fail = fail + 1 }

    println("")
    let verdict = if fail == 0 { "ALL-PASS" } else { "HAS-FAIL" }
    println("SMOKE metacog_abstain  pass=" + to_string(pass) + " fail=" + to_string(fail) + " / 4  " + verdict)
}

// nonfab_rate — fraction of unfamiliar salad keys the LIVE ImmuneMemory correctly ABSTAINS on
// (immune_memory_recall returns "" when recon-err > recall_thr). Uses the same deterministic salad
// stream. Pure read of the recall_thr gate.
fn nonfab_rate(mem: ImmuneMemory, dim: int) -> float {
    let N = 30
    let mut seed = 4242
    let mut abst = 0
    let mut p = 0
    while p < N {
        let rot = p - (p / dim) * dim
        let mut sal = []
        let mut j = 0
        while j < dim {
            let idx = (j + rot) - ((j + rot) / dim) * dim
            let bit = if idx < 3 { 1.0 } else { 0.0 }
            seed = _lcg(seed)
            sal = sal + [bit + _jit(seed, 0.06)]
            j = j + 1
        }
        let r = immune_memory_recall(mem, sal)
        if r == "" { abst = abst + 1 }
        p = p + 1
    }
    return to_float(abst) / to_float(N)
}
