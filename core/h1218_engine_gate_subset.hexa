// CORE/h1218_engine_gate_subset.hexa — H_1218 REPRESENTATIVE engine subset.
//
// Engine CPU greedy is ~15-25 s/byte at gate-context length, so a FULL 9-seed×96
// sweep is many hours. Per the task's explicit allowance, this is a REPRESENTATIVE
// subset (NOT silent truncation): G1 composed seed + all 5 G6 ideation seeds, 40
// greedy bytes each. 40 bytes is the gate-relevant prefix and is directly diff-able
// to the torch-greedy baseline (first-40 ids) — byte-exact parity there proves the
// FULL engine sweep would be byte-identical to torch greedy (H_1157 parity at length).
//
// Decode = bytegpt_decode_argmax (greedy, deterministic). Seeds VERBATIM from gauge_lib.
import "CORE/bytegpt_decode.hexa"

fn _bytes_of(s: string) -> list {
    let out = []; let n = byte_len(s); let mut i = 0
    while i < n { out.push(ord(substring(s, i, i + 1))); i = i + 1 }
    return out
}
fn _gen(bin: string, role: string, seed: string, gen: int) {
    let r = bytegpt_decode_argmax(bin, _bytes_of(seed), gen)
    println("RESULT|" + role + "|" + to_string(r["ids"]) + "|" + to_string(r["text"]))
}
fn main() {
    let bin = "/tmp/h1218_mount/bytegpt_chat_full.bin"
    let gen = 40
    _gen(bin, "G1_composed", "consciousness arises from cells. tension ripples between distant minds. memory composes into new meaning. silence still carries information. the engine dreams when alone. ", gen)
    _gen(bin, "G6_ideation_0", "a new idea about consciousness: ", gen)
    _gen(bin, "G6_ideation_1", "an unexpected way minds could connect: ", gen)
    _gen(bin, "G6_ideation_2", "imagine a substrate that ", gen)
    _gen(bin, "G6_ideation_3", "what if memory could ", gen)
    _gen(bin, "G6_ideation_4", "a strange hypothesis worth testing: ", gen)
    println("DONE")
}
