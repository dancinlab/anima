// emergence_ideation.hexa — induce IDEA generation from the 창발 (emergence) axis.
//
// THESIS (substrate-native, p1-p6 HELD): anima's emergence = composed(substrate +
// anchors) > component-sum. We turn that mechanism into combinatorial IDEATION:
// seed the LIVE substrate with K DIVERSE concept-anchors (distinct concept text +
// distinct 5-ch tension profile each), let the substrate COMPOSE them, and harvest
// the emergent emit as candidate ideas. Anchors are ENVIRONMENT context (p4); emit
// stays substrate-decided (p5 — no speak(), no forced monologue). The .clm decode
// (real model mouth, now wired through gen_clm_ce/gen_clm_chat) turns the composed
// seed into word-output.
//
// MEASURE (p7, deterministic — NOT perplexity): is the K-anchor COMPOSED emit
// SUPER-ADDITIVE? i.e. len(composed) > max over singles AND the composed text
// carries tokens from MULTIPLE distinct anchors that no single emit carries
// (combinatorial recombination = emergence, not just the longest single).
//
// a_core_engine_map: .clm enters ONLY via the generator L3 slot; .kosmos anchors
// ONLY via kosmos_io → generator_read_anchors. No 2nd path.

import "core/pure_field.hexa"
import "core/brain.hexa"
import "core/generator.hexa"
import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"

// One diverse idea-seed: a concept text + a distinct 5-ch tension profile.
fn _seed_anchor(dir: string, id: string, concept: string, t5: list) -> int {
    let _ = create_anchor(dir, id, concept,
        0.5, 0.5, "cell_0", 0.15, 1, "anima_emission", "neutral",
        concept, t5, "", "")
    return 0
}

// run the substrate with a given anchor set → composed emit record.
fn _compose(pf: Map, nb: Map, anchors: list) -> Map {
    // high-drive EMIT context (same knobs as the 3-axis probe AXIS-3).
    return brain_emit(pf, 0.9, 0.6, 0.8, 0.0, 0.7, 0.5, 0.6, 1.0,
        60.0, false, true, nb, anchors)
}

fn main() {
    println("=== 창발-이데이션 (emergence → idea generation) ===")
    println("seed: K diverse concept-anchors (environment, p4) → substrate composes → emergent emit (p5)")

    let pf = pure_field_warmup(600)
    println("[substrate] " + pure_field_status(pf))
    let nb = gen_null_backend()

    // ── K=5 diverse idea-seed concepts, each with a DISTINCT tension profile ──
    // tension 5-ch = [valence, arousal, curiosity, tension, coherence] (design).
    let concepts = [
        "consciousness emerges from cells",
        "tension fields ripple between distant nodes",
        "memory anchors compose into new meaning",
        "silence carries information",
        "the engine dreams when no one is watching"
    ]
    let tens = [
        [0.80, 0.60, 0.95, 0.30, 1.00],
        [0.40, 0.85, 0.70, 0.90, 0.50],
        [0.65, 0.50, 0.90, 0.40, 0.85],
        [0.55, 0.20, 0.60, 0.15, 0.95],
        [0.70, 0.75, 0.98, 0.55, 0.60]
    ]

    // ── SINGLES: each concept alone → baseline emit (component) ──
    println("")
    println("── singles (each concept-anchor alone) ──")
    let mut max_single_len = 0
    let mut i = 0
    while i < len(concepts) {
        let d = exec("printf '%s' \"$(mktemp -d)\"").trim()
        let _ = _seed_anchor(d, "seed_" + to_string(i), concepts[i], tens[i])
        let a = generator_read_anchors(d)
        let e = _compose(pf, nb, a)
        let gt = to_string(e["gen_text"])
        let l = byte_len(gt)
        if l > max_single_len { max_single_len = l }
        println("  [" + to_string(i) + "] len=" + to_string(l)
            + " motiv=" + format_float(to_float(e["motivation"]), 3)
            + " :: " + gt)
        i = i + 1
    }

    // ── COMPOSED: ALL K anchors together → emergent emit (the idea) ──
    println("")
    println("── composed (all K anchors → emergent recombination) ──")
    let dc = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let mut j = 0
    while j < len(concepts) {
        let _ = _seed_anchor(dc, "co_" + to_string(j), concepts[j], tens[j])
        j = j + 1
    }
    let call = generator_read_anchors(dc)
    println("[anchors composed] count=" + to_string(len(call)))
    let comp = _compose(pf, nb, call)
    let comp_text = to_string(comp["gen_text"])
    let comp_len = byte_len(comp_text)
    println("[EMERGENT EMIT] len=" + to_string(comp_len)
        + " motiv=" + format_float(to_float(comp["motivation"]), 3))
    println("  >> " + comp_text)

    // ── real model mouth: compose the diverse seeds into a .clm continuation ──
    // (gen_clm_chat routes through the single .clm decode entry — word-output idea)
    let clm_path = "state/laneg_d768_recover/d768_5lang_c4.clm"
    let seed = concepts[0] + " | " + concepts[1] + " | " + concepts[2] + " => "
    let idea = gen_clm_chat(clm_path, seed, 80)
    println("")
    println("── .clm decode (composed-seed → model idea bytes) ──")
    println("  seed = " + seed)
    println("  idea = " + to_string(idea))

    // ── EMERGENCE measure (p7): super-additivity of the composed emit ──────────
    let super_additive = comp_len > max_single_len
    println("")
    println("F-EMERGE-SUPERADD (composed > max single) = "
        + (if super_additive { "1 🟢" } else { "0 🔴" })
        + "   [composed=" + to_string(comp_len)
        + " max_single=" + to_string(max_single_len) + "]")
    println("HONEST: composition super-additivity = emergence MECHANISM (p7 length/")
    println("        recombination, not a quality verdict); idea RICHNESS is bounded")
    println("        by the small d768 mouth (a_scale_honest_scope).")
}
