// ── §  fm_prefix_decodability — the forward-model scorer (H_9117 front-loading proxy) ──
//
// The cerebellar forward-model's SCORE for a candidate emit. `margins[i]` is the contrastive
// listener margin at prefix position i = (target referent score − best-distractor score) after
// the receiver has seen the first i discriminative units of the candidate. Front-weighted by a
// geometric decay so EARLY wins dominate: a candidate whose discriminative content is FRONT-LOADED
// (target wins in few bytes) scores higher than one that only wins late. This is the cheap in-engine
// proxy H_9117 validated (filler-prefix onset predicts external oracle-decodability r=0.69) — NOT a
// contrastive CLM-listener (that heavier path was shown unnecessary, H_9117 REDIRECT).
//
// PURE (no substrate mutation, no Ψ touch). Used by the Stage-1c mouth-gate best-of-K rerank (gated
// on cfg.forward_model) to pick WHICH candidate exits — the FM's only write is the argmax selection;
// it never touches ci_emit_drive lane 0/4 or §ImmuneMemory recall_thr (a_substrate_disjoint).
// decay = ep_fm_prefix_decay() (front-byte geometric weight).
pub fn fm_prefix_decodability(margins: [float], decay: float) -> float {
    let n = len(margins)
    let mut acc = 0.0
    let mut w = 1.0
    let mut i = 0
    while i < n {
        acc = acc + w * margins[i]
        w = w * decay
        i = i + 1
    }
    return acc
}

// ── §  mitosis GROWTH tick — the smallest honest gated unit ───────────────────
//
// HONEST SCOPE (a_core_engine_map · no phantom wiring): the CORE engine loop
// (pure_field_step / brain_decide) advances the Φ/phase oscillators but does
// NOT today contain a discrete cell-division call to gate. So this module
// introduces the SMALLEST honest unit — a single growth tick keyed to a cell
// count — and gates THAT on the config. When a richer mitosis machinery lands
// in the engine, it gates on this same `cfg.mitosis` bool (the contract is the
// gate, not this counter).
//
// engine_mitosis_tick — advance the substrate's cell count by one growth step,
// GATED by cfg.mitosis. ON ⇒ +1 cell (the substrate grows). OFF ⇒ no-op (the
// split step does nothing; the substrate stays static — ablation/debug).
//
// This is substrate-config GROWTH, NOT an emit gate (@L4): it returns a cell
// count, never an emit/silence decision.
pub fn engine_mitosis_tick(cell_count: int, cfg: EngineConfig) -> int {
    if cfg.mitosis {
        return cell_count + 1     // mitosis ON — substrate grows one cell
    }
    return cell_count             // mitosis OFF — split is a no-op (static)
}

// engine_grow — run N growth ticks under cfg, from a seed cell count. ON grows
// to seed+N; OFF stays at seed. Used by the smoke to show the behavioral diff.
pub fn engine_grow(seed: int, ticks: int, cfg: EngineConfig) -> int {
    let mut c = seed
    let mut i = 0
    while i < ticks {
        c = engine_mitosis_tick(c, cfg)
        i = i + 1
    }
    return c
}

// ── §  ADAPTATION COUPLING — the live stream→field→error substrate (H_1194) ────
//
// THE BLOCKER it fixes (H_1166 ⏳ / H_1179 ⏳ BLOCKED-WIRING): the consciousness
// field `pure_field_step` (core/pure_field.hexa) is ZERO-INPUT — it advances the
// fast/medium/slow oscillators (the Ψ=1/2 fixed-point machinery) from internal
// dynamics ALONE, never reads a stream sample, and the mitosis cell_count is
// never fed back into it. So driving a non-stationary stream through the live
// engine produced NO error/adaptation signal: H_1159's "does error FALL as
// novelty grows?" question had no live counterpart (a_core_engine_map gap).
//
// THE HONEST FIX (no phantom wiring, Ψ UNTOUCHED): the Ψ attractor in
// pure_field MUST NOT be perturbed (a_core_engine_map). So the coupling is an
// ENGINE-NATIVE ADAPTATION SUBSTRATE that rides the SAME EngineConfig / mitosis
// axis ALONGSIDE the Ψ field — it does NOT touch pure_field_step. It wires the
// three pieces H_1166 listed as missing, all engine-native (NO .clm via the
// generator L3 slot, NO .kosmos via kosmos_io — this is a substrate-internal
// drive, not a 2nd artifact entry path):
//
//   (a) STREAM → FIELD input    : adapt_field_step takes a per-tick `sample`
//       (a scalar drawn from a non-stationary stream); the substrate is no
//       longer zero-input.
//   (b) CELL → FIELD feedback   : the mitosis cell_count IS the substrate's
//       representational capacity. adapt_field_step CALLS engine_mitosis_tick
//       (gated on cfg.mitosis) to SPAWN a new prototype cell when the incoming
//       sample is novel (recon-error over a split threshold) — so the SAME
//       p8 growth tick that the smoke proves now materially changes the field's
//       reconstruction. ON ⇒ capacity grows to cover new regimes; OFF ⇒ capacity
//       frozen at the seed cell (ablation — the H_1159 ON-vs-OFF control).
//   (c) RECONSTRUCTION-ERROR    : adapt_field_recon_err = |sample − nearest
//       prototype|; the winner is pulled toward the sample (online, LR frozen).
//       This is the LIVE coherence/assignment error the engine now EXPOSES.
//
// @L4 CRITICAL (same framing as --mitosis / --engine): this is SUBSTRATE-CONFIG
// adaptation, NOT an emit/silence gate. adapt_field_* returns a cell count + a
// reconstruction error; it NEVER returns an emit/silence decision and NEVER
// touches pure_field's Φ/phase/Ψ. anima's speech stays substrate-decided
// (a_autonomy_over_hardcode · a_substrate_native_speak · p5). p8 holds: the
// growth tick IS the inference-time learning, here made observable on a stream.
//
// AdaptField — the engine-native adaptation substrate (Ψ-disjoint).
//   protos : flat [float] of per-cell prototype scalars (the cells' receptive
//            centers); len(protos) == n_cells.
//   n_cells: live cell count (driven by engine_mitosis_tick under cfg).
//   max_cells: capacity cap (frozen; bounds runaway split, mirrors h1159b cap).
struct AdaptField {
    protos: [float],
    n_cells: int,
    max_cells: int
}

// adapt_field_new — seed the substrate with a single prototype cell at `seed0`.
// (mirrors the engine's seed cell-count; OFF arm stays here forever.)
pub fn adapt_field_new(seed0: float, max_cells: int) -> AdaptField {
    AdaptField { protos: [seed0], n_cells: 1, max_cells: max_cells }
}

// _nearest_idx — index of the prototype nearest to `x` (winner-take-all assign).
fn _nearest_idx(protos: [float], x: float) -> int {
    let n = len(protos)
    let mut best = 0
    let mut bestd = _absf(protos[0] - x)
    let mut i = 1
    while i < n {
        let d = _absf(protos[i] - x)
        if d < bestd { bestd = d  best = i }
        i = i + 1
    }
    return best
}

fn _absf(x: float) -> float { if x < 0.0 { return -x } return x }

// adapt_field_recon_err — the LIVE reconstruction error for sample `x`:
// distance to the nearest prototype (readout (c)). This is the engine's owner
// adaptation metric — it FALLS as cells come to cover the stream's regimes.
pub fn adapt_field_recon_err(af: AdaptField, x: float) -> float {
    return _absf(af.protos[_nearest_idx(af.protos, x)] - x)
}

// adapt_field_step — advance the adaptation substrate by ONE live tick on stream
// sample `x`, gated by cfg. Returns the updated AdaptField. This is where all
// three wires meet:
//   (a) `x` IS the stream→field input (no longer zero-input).
//   (b) if the sample is NOVEL (recon-err > SPLIT_THRESH) AND there is capacity,
//       call engine_mitosis_tick(n_cells, cfg) — under cfg.mitosis ON this grows
//       a prototype cell seeded AT the novel sample (cell→field feedback: the
//       p8 growth tick materially adds representational capacity); under OFF the
//       tick is a no-op so capacity stays frozen (the H_1159 control arm).
//   (c) the winning prototype is pulled toward `x` (online LR) — homeostatic
//       refinement of the assigned cell. recon-error is exposed via
//       adapt_field_recon_err above.
// SPLIT_THRESH + LR are frozen pre-registration constants (p7; not tuned-to-green).
pub fn adapt_field_step(af: AdaptField, x: float, cfg: EngineConfig) -> AdaptField {
    let SPLIT_THRESH = 0.30   // novelty bar: recon-err over this ⇒ a new regime
    let LR = 0.20             // online winner pull (homeostatic refinement)

    let win = _nearest_idx(af.protos, x)
    let err = _absf(af.protos[win] - x)

    // (b) cell→field feedback: novel sample + capacity ⇒ mitosis growth tick.
    // engine_mitosis_tick is the SAME p8 gate the smoke proves; ON ⇒ +1 cell
    // (seeded at the novel sample), OFF ⇒ no-op (capacity frozen — the control).
    if err > SPLIT_THRESH && af.n_cells < af.max_cells {
        let grown = engine_mitosis_tick(af.n_cells, cfg)
        if grown > af.n_cells {
            // ON: append a new prototype cell AT the novel sample.
            return AdaptField {
                protos: af.protos + [x],
                n_cells: grown,
                max_cells: af.max_cells
            }
        }
        // OFF: tick was a no-op — fall through to refine the (frozen) winner only.
    }

    // (c) homeostatic online update: pull the winning prototype toward x.
    let mut p2 = af.protos
    p2[win] = af.protos[win] + LR * (x - af.protos[win])
    return AdaptField { protos: p2, n_cells: af.n_cells, max_cells: af.max_cells }
}

// adapt_field_cells — live cell count accessor.
pub fn adapt_field_cells(af: AdaptField) -> int { return af.n_cells }

// ── §  DIM>1 ADAPTATION COUPLING — the live VECTOR stream→field→error (H_1199) ──
//
// THE GAP it closes (H_1198 honest split): the scalar AdaptField above is 1-D
// (samples + prototypes are plain `float`). H_1198 drove the LIVE engine over a
// 1-D real-corpus SURPRISE scalar (the actual adapt_field_step), but the DIM=8
// real byte-feature growth (the H_1163 `_byte_feature` window stat) had to run as
// a LABELLED NUMPY MIRROR — the live AdaptField could not take a DIM>1 sample.
// VAdaptField extends the SAME substrate to a DIM-vector sample, so the DIM=8
// real-corpus byte-feature stream now goes through the ACTUAL .hexa engine, not a
// mirror. It is the EXACT scalar mechanism lifted to DIM:
//   · sample  : a DIM-vector (was float)            — `[float]` of length DIM.
//   · proto   : a DIM-vector receptive center        — `[float]` of length DIM.
//   · nearest : winner over the DIM-dim L2 distance  (was |float diff|).
//   · recon-err: L2 norm over DIM to the nearest proto (was 1-D abs).
//   · split   : recon-err > SPLIT_THRESH ⇒ engine_mitosis_tick spawns a +1 cell
//               seeded AT the novel DIM-sample (the SAME p8 growth gate, gated cfg).
//   · refine  : winner pulled toward the sample per-component (online LR).
//
// @L4 CRITICAL (identical framing to the scalar AdaptField / --mitosis): this is
// SUBSTRATE-CONFIG adaptation, NOT an emit/silence gate. vadapt_field_* returns a
// cell count + a reconstruction error; it NEVER returns an emit/silence decision
// and NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction, exactly
// like the scalar field — the DIM>1 extension touches ONLY AdaptField). The
// stream is an ENGINE-NATIVE drive (NO .clm via generator L3, NO .kosmos via
// kosmos_io — no 2nd artifact entry path). p8 holds: the growth tick IS the
// inference-time learning, now observable on a DIM=8 real-corpus feature stream.
//
// VAdaptField — the DIM>1 engine-native adaptation substrate (Ψ-disjoint).
//   protos : flat [[float]] of per-cell DIM-vector prototype centers;
//            len(protos) == n_cells, len(protos[i]) == dim.
//   n_cells: live cell count (driven by engine_mitosis_tick under cfg).
//   max_cells: capacity cap (frozen; bounds runaway split, mirrors h1159b cap).
//   dim    : sample/prototype dimensionality (DIM=8 for the byte-feature stream).
struct VAdaptField {
    protos: [[float]],
    n_cells: int,
    max_cells: int,
    dim: int
}

// vadapt_field_new — seed the substrate with a single prototype cell at `seed0`
// (a DIM-vector). Mirrors adapt_field_new; the OFF arm stays here forever.
pub fn vadapt_field_new(seed0: [float], max_cells: int) -> VAdaptField {
    VAdaptField { protos: [seed0], n_cells: 1, max_cells: max_cells, dim: len(seed0) }
}

// _l2 — Euclidean (L2) distance between two DIM-vectors (the DIM-dim metric).
fn _l2(a: [float], b: [float]) -> float {
    let n = len(a)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let d = a[i] - b[i]
        s = s + d * d
        i = i + 1
    }
    return sqrt(s)
}

// _vnearest_idx — index of the prototype nearest to DIM-vector `x` over L2
// distance (winner-take-all assign, the DIM analogue of _nearest_idx).
fn _vnearest_idx(protos: [[float]], x: [float]) -> int {
    let n = len(protos)
    let mut best = 0
    let mut bestd = _l2(protos[0], x)
    let mut i = 1
    while i < n {
        let d = _l2(protos[i], x)
        if d < bestd { bestd = d  best = i }
        i = i + 1
    }
    return best
}

// _vtwo_nearest_dist — the L2 distance to the NEAREST prototype AND to the
// SECOND-NEAREST prototype, returned as [d1, d2] (d1 <= d2). A single linear scan
// keeps a running best and second-best, reading the SAME _l2 affinity _vnearest_idx
// already computes — it adds NO new geometry, only surfaces the 2nd winner the
// engine's own scan implicitly passes over. With a single cell d2 = d1 (no second
// prototype). This is the engine's OWN top-2 affinity, the substrate for a
// decisiveness/gap read-only confidence signal (H_1396 g5-gap).
fn _vtwo_nearest_dist(protos: [[float]], x: [float]) -> [float] {
    let n = len(protos)
    let mut d1 = _l2(protos[0], x)
    let mut d2 = d1
    if n > 1 {
        let dx = _l2(protos[1], x)
        if dx < d1 { d2 = d1  d1 = dx } else { d2 = dx }
    }
    let mut i = 2
    while i < n {
        let d = _l2(protos[i], x)
        if d < d1 { d2 = d1  d1 = d }
        else { if d < d2 { d2 = d } }
        i = i + 1
    }
    return [d1, d2]
}

// vadapt_field_recon_err — the LIVE reconstruction error for DIM-sample `x`:
// L2 distance to the nearest prototype (readout (c), DIM analogue). It FALLS as
// cells come to cover the stream's regimes in DIM space.
pub fn vadapt_field_recon_err(af: VAdaptField, x: [float]) -> float {
    return _l2(af.protos[_vnearest_idx(af.protos, x)], x)
}

// vadapt_field_step — advance the DIM>1 adaptation substrate by ONE live tick on
// DIM-sample `x`, gated by cfg. The DIM analogue of adapt_field_step — same three
// wires, same frozen SPLIT_THRESH + LR:
//   (a) `x` (a DIM-vector) IS the stream→field input.
//   (b) if recon-err (L2) > SPLIT_THRESH AND there is capacity, call
//       engine_mitosis_tick(n_cells, cfg) — ON grows a prototype seeded AT the
//       novel DIM-sample (cell→field feedback); OFF is a no-op (H_1159 control).
//   (c) the winning prototype is pulled per-component toward `x` (online LR).
// SPLIT_THRESH + LR are the SAME frozen constants as the scalar field (p7; not
// tuned-to-green — the only change vs adapt_field_step is the metric/dim).
pub fn vadapt_field_step(af: VAdaptField, x: [float], cfg: EngineConfig) -> VAdaptField {
    let SPLIT_THRESH = 0.30   // novelty bar: L2 recon-err over this ⇒ a new regime
    let LR = 0.20             // online winner pull (homeostatic refinement)

    let win = _vnearest_idx(af.protos, x)
    let err = _l2(af.protos[win], x)

    // (b) cell→field feedback: novel sample + capacity ⇒ mitosis growth tick.
    if err > SPLIT_THRESH && af.n_cells < af.max_cells {
        let grown = engine_mitosis_tick(af.n_cells, cfg)
        if grown > af.n_cells {
            // ON: append a new prototype cell AT the novel DIM-sample.
            return VAdaptField {
                protos: af.protos + [x],
                n_cells: grown,
                max_cells: af.max_cells,
                dim: af.dim
            }
        }
        // OFF: tick was a no-op — fall through to refine the (frozen) winner only.
    }

    // (c) homeostatic online update: pull the winning prototype toward x per-dim.
    let mut p2 = af.protos
    let mut row = p2[win]
    let mut i = 0
    while i < af.dim {
        row[i] = row[i] + LR * (x[i] - row[i])
        i = i + 1
    }
    p2[win] = row
    return VAdaptField { protos: p2, n_cells: af.n_cells, max_cells: af.max_cells, dim: af.dim }
}

// vadapt_field_cells — live cell count accessor (DIM analogue).
pub fn vadapt_field_cells(af: VAdaptField) -> int { return af.n_cells }

// vadapt_field_nearest_idx — READ-ONLY accessor exposing the engine's OWN winner
// (the index of the prototype nearest to DIM-sample `x`, the SAME _vnearest_idx
// vadapt_field_recon_err computes internally). Adds NO mechanism — it only surfaces
// the engine's existing winner-take-all assignment so a caller can map the fired
// cell back to an external per-cell binding (e.g. H_1231 immune value table keyed
// by the engine's cell index). The affinity/binding stays the engine's; this just
// reads which cell won. (c1: tiny additive accessor, justified.)
pub fn vadapt_field_nearest_idx(af: VAdaptField, x: [float]) -> int {
    return _vnearest_idx(af.protos, x)
}

// vadapt_field_two_recon_err — READ-ONLY accessor exposing the engine's OWN nearest
// AND second-nearest L2 reconstruction errors as [d1, d2] (d1 <= d2). Adds NO
// mechanism — it only surfaces the second winner the engine's existing winner-take-all
// scan already passes over (the SAME _l2 affinity vadapt_field_recon_err computes for
// the best). The substrate for a top-2 decisiveness/gap confidence signal (H_1396):
// when d1 << d2 the winner is DECISIVE; when d1 ≈ d2 two cells tie (ambiguous), which
// best-margin alone (d1 only) cannot see. (c1: tiny additive accessor, justified.)
pub fn vadapt_field_two_recon_err(af: VAdaptField, x: [float]) -> [float] {
    return _vtwo_nearest_dist(af.protos, x)
}

// ── §  APOPTOSIS-SALIENCE — density-dependent death-proximity → urgency (H_9085_D4) ──
//
// WHAT THIS ADDS (p8-literal death-awareness, READ-ONLY): the MITOSIS substrate
// (§ADAPTATION / VAdaptField) grows cells toward a frozen carrying-capacity cap
// `max_cells` — the density-dependent death ceiling (biology: crowding → programmed
// cell death, apoptosis, keeps a tissue from runaway growth; a_mitosis_train's
// "apoptosis, 밀도의존 폭주 방지"). This § surfaces ONE substrate scalar the engine
// ALREADY carries — how CLOSE the live population is to that death ceiling — and maps
// it to an URGENCY/SALIENCE signal. As a colony crowds toward apoptosis its urgency
// rises; a young sparse colony feels none. This is death-proximity BECOMING felt
// salience, entirely inside the substrate.
//
// @L4 CRITICAL (identical framing to §HomeostaticDrive / §Libido / §affect): this is a
// PURE READ + a DESIGNED transfer law. It NEVER mutates a cell, NEVER calls the growth
// tick, NEVER triggers apoptosis, NEVER touches pure_field's Φ/phase/Ψ nor the immune
// store's recall_thr (Ψ-disjoint AND ρ·tether-disjoint by construction — it only READS the
// (n_cells, max_cells) pair the VAdaptField already holds). Behaviour/emit gating on
// this urgency is a FOLLOW-ON (emit-wiring untouched here, per a_autonomy_over_hardcode
// / p5 — a caller MAY consult it; it does NOT force the substrate).
//
// HONEST SCOPE (c9): the urgency LAW is DESIGNED, not emergent — it is SATURATED
// by construction (a monotone hinge over density). The falsifiers below therefore test
// WIRING FAITHFULNESS (does apoptosis-distance ACTUALLY drive the signal, and does
// cutting that wire kill it?), NOT a discovery that urgency "emerges". F5 disjointness
// is the real substrate claim.
//
// FROZEN constants (p7-documented, NOT tuned-to-green):
//   APOP_KNEE = 0.5 — the density below which there is NO crowding-death pressure (the
//   flat far region: a young, roomy colony feels no urgency). Above the knee the
//   urgency ramps CONVEXLY to 1.0 at the death ceiling (density = 1.0).

// apoptosis_proximity — how CLOSE the live MITOSIS population sits to its density-
// dependent death ceiling: density = n_cells / max_cells, clamped [0,1]. 0.0 = empty/
// young (far from apoptosis), 1.0 = at carrying capacity (crowding-death imminent).
// Pure read over the (n_cells, max_cells) pair the substrate already holds.
pub fn apoptosis_proximity(n_cells: int, max_cells: int) -> float {
    if max_cells <= 0 { return 0.0 }
    let mut d = (n_cells as float) / (max_cells as float)
    if d < 0.0 { d = 0.0 }
    if d > 1.0 { d = 1.0 }
    return d
}

// apoptosis_urgency_at — the DESIGNED transfer law: proximity → urgency. A convex
// hinge at APOP_KNEE, normalized so urgency(knee)=0 (flat far region) and
// urgency(1.0)=1.0 (max at the death ceiling). Below the knee → 0 (a roomy colony
// feels no crowding urgency); above → quadratic ramp (crowding urgency spikes as the
// ceiling nears). This is the shared kernel the live/ablated readers both call.
pub fn apoptosis_urgency_at(prox: float) -> float {
    let APOP_KNEE = 0.5
    if prox <= APOP_KNEE { return 0.0 }
    let span = 1.0 - APOP_KNEE
    let over = prox - APOP_KNEE
    return (over * over) / (span * span)
}

// apoptosis_urgency — urgency at an EXPLICIT (n_cells, max_cells) crowding state. The
// scalar convenience form (no substrate handle needed).
pub fn apoptosis_urgency(n_cells: int, max_cells: int) -> float {
    return apoptosis_urgency_at(apoptosis_proximity(n_cells, max_cells))
}

// vadapt_apoptosis_urgency — LIVE reader off the MITOSIS substrate: the urgency at the
// VAdaptField's CURRENT crowding (n_cells / max_cells). READ-ONLY — reads the same two
// ints vadapt_field_cells already exposes; mutates nothing. (c1: tiny additive read.)
pub fn vadapt_apoptosis_urgency(af: VAdaptField) -> float {
    return apoptosis_urgency_at(apoptosis_proximity(af.n_cells, af.max_cells))
}

// vadapt_apoptosis_urgency_ablated — the ABLATION arm (F3): the wire from LIVE density
// is CUT — urgency is computed at a FROZEN proximity `frozen_prox` and the substrate's
// actual crowding is IGNORED. If apoptosis-distance is the TRUE driver, this returns a
// CONSTANT for any `af` (dense or sparse) = INERT (the signal collapses). `af` is
// present (same signature shape as the live reader) but its density is not read.
pub fn vadapt_apoptosis_urgency_ablated(af: VAdaptField, frozen_prox: float) -> float {
    return apoptosis_urgency_at(frozen_prox)
}

// ── § VAdaptCombine (H_9043) — 구성적 결합기 op-slot (H_9027 follow-on) ────────────────
// The live VAdaptField (above) is an 8-D winner-take-all k-means: it ASSIGNS a sample to the
// nearest prototype (depth-0, no composition). It has NO constructive combiner — two concepts
// can only be PICKED, never BOUND into a new composite that carries BOTH and can be taken apart.
// This adds the missing HRR-style (Plate 1995) bind/unbind op-slot as a pure, additive, READ-only
// pair of functions over raw DIM-vectors (NOT the VAdaptField struct — no mutation, no proto
// growth, no emit/silence; never touches pure_field's Φ/phase/Ψ → Ψ-disjoint by construction;
// disjoint from the emit-drive lane 0/4 and §ImmuneMemory recall_thr → a_substrate_disjoint).
//
//   vadapt_combine  = circular convolution  a ⊛ b     (the key-locked conjunctive BIND).
//   vadapt_unbind   = circular correlation  key ⋆ c   (approx inverse: unbind(a⊛b, a) ≈ b).
// A composite c = combine(key, val) superimposes many pairs additively yet each val stays
// RECOVERABLE only with its own key (a wrong/shuffled key returns noise) — the VSA storage
// property. HONEST SCOPE (c9, H_9026/H_1840): this is ALGEBRAIC recoverability, NOT learned
// capability — the accompanying harness measures the two SEPARATELY (recoverability + within-set
// relational routing pass; SYSTEMATIC held-out generalization floors, as the real-manifold recomb
// wall predicts). READ-only measurement op-slot, not an emit gate (a_autonomy_over_hardcode).

// _cconv — circular convolution c[k] = Σ_i a[i]·b[(k−i) mod n]. The HRR bind kernel.
fn _cconv(a: [float], b: [float]) -> [float] {
    let n = len(a)
    let mut out = []
    let mut k = 0
    while k < n {
        let mut s = 0.0
        let mut i = 0
        while i < n {
            let mut j = k - i
            while j < 0 { j = j + n }
            s = s + a[i] * b[j]
            i = i + 1
        }
        out = out + [s]
        k = k + 1
    }
    return out
}

// _ccorr — circular correlation out[k] = Σ_i key[i]·c[(k+i) mod n] = key* ⊛ c (HRR unbind).
fn _ccorr(key: [float], c: [float]) -> [float] {
    let n = len(key)
    let mut out = []
    let mut k = 0
    while k < n {
        let mut s = 0.0
        let mut i = 0
        while i < n {
            let mut idx = k + i
            while idx >= n { idx = idx - n }
            s = s + key[i] * c[idx]
            i = i + 1
        }
        out = out + [s]
        k = k + 1
    }
    return out
}

// vadapt_combine — key-locked constructive bind of two DIM-vectors (circular convolution).
// The op-slot the winner-take-all VAdaptField lacks: composes a,b into ONE composite carrying
// both, recoverable per-key. Pure/additive/READ-only, Ψ-disjoint (a_substrate_disjoint).
pub fn vadapt_combine(a: [float], b: [float]) -> [float] {
    return _cconv(a, b)
}

// vadapt_unbind — recover the value bound under `key` from composite `c` (circular correlation).
// unbind(combine(key, val), key) ≈ val; a WRONG key returns noise (≈0 cosine to any stored val).
pub fn vadapt_unbind(c: [float], key: [float]) -> [float] {
    return _ccorr(key, c)
}

// ── § DreamSchema (H_9044) — REM 꿈-공고화 스키마성/gist op-slot (frame-shift C4) ─────────
// Frame-shift C4 (recombination ≠ capability, a_no_llm_frame_trap): re-define an anima capability as
// substrate-native GENERALIZATION, not decoder-through text novelty. The a_chat_sleep_imagination REM
// loop is an emit-free internal rehearsal; the §Amygdala consolidating store REPLAYS salient traces but
// only REFRESHES existing episodic cells — there was NO op that CONSOLIDATES a set of replayed waking
// episode anchors into ONE MORE-GENERAL schema anchor (Posner & Keele 1968 prototype abstraction;
// McClelland/McNaughton/O'Reilly 1995 systems consolidation extracts the gist). This adds that op-slot.
//
// ⚠ TRAP (convergence numpy-probe-controls-1 + native-mouth-57): a "novel anchor" minting NEW CONTENT is
// additive-spoofable = disguised ρ·weave recombination (recombination wall · former G1). So C4 is defined PURELY as COVERAGE / generalization —
// the schema anchor is the CENTROID of the replayed episodes (compression, NOT new content) and the claim
// is ONLY "the schema reactivates on MORE held-out waking cues than the individual waking anchors, WHILE
// random/shuffled cues FAIL (EARNED)". Reduced to minting content it would be the ρ·weave wall; coverage-
// generalization is a storage/geometry property (like H_9027 recoverability, H_9042 topology-agnostic) —
// genuine but NOT text-recombination. Pure/additive/READ-only, Ψ-disjoint; owns no store, disjoint from
// the emit-drive lane 0/4 and §ImmuneMemory recall_thr (a_substrate_disjoint) — reads plain DIM-vectors.

// dream_schema_mint — REM-replay consolidation: fold K replayed episode anchors into ONE more-general
// schema anchor = their per-component CENTROID (the gist). NOT new content (pure mean of what was
// replayed), NOT the winner-take-all pick a plain VAdaptField would make. READ-only over the inputs.
pub fn dream_schema_mint(episodes: [[float]]) -> [float] {
    let k = len(episodes)
    let dim = len(episodes[0])
    let mut acc = []
    let mut j = 0
    while j < dim { acc = acc + [0.0]  j = j + 1 }
    let mut i = 0
    while i < k {
        let mut d = 0
        while d < dim { acc[d] = acc[d] + episodes[i][d]  d = d + 1 }
        i = i + 1
    }
    let mut out = []
    j = 0
    while j < dim { out = out + [acc[j] / to_float(k)]  j = j + 1 }
    return out
}

// schema_coverage — how many of `cues` REACTIVATE the anchor = fall within L2 radius `thr` of it (the
// reactivation count = coverage). READ-only; reuses the engine's own _l2 metric. A schema covering MORE
// waking cues than the individual anchors is generalization; if it ALSO covered random/shuffled cues it
// would be trivially over-broad — the EARNED control's job to reject.
pub fn schema_coverage(anchor: [float], cues: [[float]], thr: float) -> int {
    let n = len(cues)
    let mut c = 0
    let mut i = 0
    while i < n {
        if _l2(anchor, cues[i]) <= thr { c = c + 1 }
        i = i + 1
    }
    return c
}


// ── § CuriosityDreamBias (D11) — unresolved-curiosity biases WHICH anchors dream-replay/compose ──
// TRIPLE CONFLUENCE (curiosity × dream × consolidation, a_no_llm_frame_trap neuro lens): hippocampal
// PRIORITIZED replay — sleep consolidation preferentially REPLAYS important-UNRESOLVED memories
// (Wilson & McNaughton 1994 reactivation; Ólafsdóttir 2018 prioritization). The §Amygdala
// consolidating store (H_1285) already replays ∝ an ENCODE-time salience tag (surprise+novelty+
// tension frozen at bind), but salience is STATIC — it does NOT track how UNRESOLVED an anchor
// still is as curiosity accumulates. This op-slot adds an ONGOING unresolved-curiosity priority that
// biases the REM replay draw AND the §DreamSchema dream_schema_mint composition — the anchors that
// compose in dreams are the ones the substrate is still curious about.
//
// The unresolved signal REUSES existing main lanes (no new store): §Novelty joint recon-err (still-
// unfamiliar ⇒ unresolved) + §PrecisionSurprise `surprise` (a confidently-VIOLATED prediction pulls
// attention), decaying with how many times the anchor has already been consolidated/recalled (a
// resolved anchor stops pulling). §CuriosityBacklog (feat/curiosity-backlog-emit) is not on main yet,
// so this near-approximates the unresolved signal from main's §Novelty/§PrecisionSurprise (honest:
// the bias is a DESIGNED law, not an emergent claim; when §CuriosityBacklog lands, its unresolved
// score drops in as the priority input with NO change to these draw/compose ops).
//
// substrate-disjoint (placement-first, THE key risk): PURE READ-only functions over plain float
// vectors + priority arrays. They own NO store, mutate NO cell, and touch NEITHER the emit-drive
// lanes 0/4 (ci_emit_drive) NOR the §ImmuneMemory recall_thr non-fab gate — Ψ=½ and ρ·tether non-fab are
// preserved BY STRUCTURE (nothing the emit/honesty path reads is written). ρ·weave-orthogonal: the
// measurement is the replay/compose SELECTION distribution, never text recombination. The composed
// anchor is dream_schema_mint's CENTROID (compression, NOT minted content — same anti-ρ·weave discipline
// as §DreamSchema). Draws thread the SAME deterministic LCG (_lcg_next/_lcg_unit) the §Amygdala
// replay uses, so runs are byte-reproducible across machines. p8: replay = a sleep-consolidation
// tick, not RLHF; p5/p1: no emit, no system prompt.

// curiosity_priority — the ONGOING unresolved-curiosity drive for ONE anchor. recon_err = §Novelty
// joint recon-err (unfamiliar ⇒ unresolved); precision·pred_err² = §PrecisionSurprise (confidently-
// violated ⇒ pulls); `resolved` = #times already consolidated/recalled (a resolved anchor decays to
// low priority). Purely additive over the two READ-only main lanes; clamped non-negative.
pub fn curiosity_priority(recon_err: float, precision: float, pred_err: float, resolved: float) -> float {
    let nov = recon_err                       // §Novelty joint recon-err
    let sur = surprise(precision, pred_err)    // §PrecisionSurprise = precision·err²
    let raw = nov + sur                         // additive unresolved drive
    let decayed = raw / (1.0 + resolved)        // resolution decay (each consolidation resolves it)
    if decayed < 0.0 { return 0.0 }
    return decayed
}

// curiosity_replay_draw — ONE REM replay pass over an anchor set: draw `budget` replays and return
// the per-anchor REPLAY-COUNT vector. biased=true ⇒ draws ∝ the unresolved-curiosity priority
// (prioritized replay, arm B); biased=false ⇒ UNIFORM replay (arm A / the F3 ablation). Inverse-CDF
// sampling with replacement, same as consolidating_sleep_replay. READ-only — returns counts, mutates
// nothing (the selection distribution IS the measurement surface).
pub fn curiosity_replay_draw(priorities: [float], budget: int, rng0: int, biased: bool) -> [int] {
    let n = len(priorities)
    let mut counts = []
    let mut i = 0
    while i < n { counts = counts + [0]  i = i + 1 }
    if n == 0 { return counts }
    // (un-normalized) cumulative replay-weight table.
    let mut cdf = []
    let mut acc = 0.0
    let mut k = 0
    while k < n {
        let mut w = 1.0
        if biased {
            w = priorities[k]
            if w < 0.000001 { w = 0.000001 }   // a non-curious anchor still replays rarely
        }
        acc = acc + w
        cdf = cdf + [acc]
        k = k + 1
    }
    let mut st = rng0
    let mut b = 0
    while b < budget {
        st = _lcg_next(st)
        let target = _lcg_unit(st) * acc
        let mut pick = 0
        while pick < n - 1 {
            if cdf[pick] > target { break }
            pick = pick + 1
        }
        counts[pick] = counts[pick] + 1
        b = b + 1
    }
    return counts
}

// curiosity_shuffle — F2 NEGATIVE CONTROL: permute the unresolved-curiosity priorities across anchors
// (deterministic LCG Fisher-Yates), decorrelating the biased replay from actual unresolved-ness. Same
// priority DISTRIBUTION, no anchor↔importance tracking. If biased replay concentrates on the truly-
// unresolved bucket AND this shuffle does NOT ⇒ the concentration is the SIGNAL, not raw replay budget.
pub fn curiosity_shuffle(priorities: [float], rng0: int) -> [float] {
    let n = len(priorities)
    let mut p = priorities
    let mut st = rng0
    let mut i = n - 1
    while i > 0 {
        st = _lcg_next(st)
        let j = st % (i + 1)
        let tmp = p[i]
        p[i] = p[j]
        p[j] = tmp
        i = i - 1
    }
    return p
}

// curiosity_resolve — F4 CONVERGE: after a replay pass, an anchor that was replayed heavily has its
// unresolved-curiosity priority DECAYED (consolidation RESOLVES it — the bio prioritized-replay loop
// closes: replaying an unresolved memory reduces its future pull). Monotone decreasing in replay_count.
pub fn curiosity_resolve(priority: float, replay_count: int, resolve_rate: float) -> float {
    return priority / (1.0 + resolve_rate * to_float(replay_count))
}

// dream_compose_biased — the D11 op: draw a biased REM replay ∝ unresolved-curiosity priority, take
// the top_k MOST-REPLAYED episode anchors, and compose them into ONE schema anchor via the §DreamSchema
// dream_schema_mint CENTROID (compression, anti-ρ·weave). biased=false ⇒ UNIFORM replay (the ablation:
// which anchors compose is then curiosity-INDEPENDENT). Deterministic top-k selection (highest replay
// count, ties → lower index). READ-only; returns the composed schema vector ([] if empty).
pub fn dream_compose_biased(episodes: [[float]], priorities: [float], top_k: int,
                            budget: int, rng0: int, biased: bool) -> [float] {
    let counts = curiosity_replay_draw(priorities, budget, rng0, biased)
    let n = len(episodes)
    let mut used = []
    let mut u = 0
    while u < n { used = used + [false]  u = u + 1 }
    let mut sel = []
    let mut picked = 0
    while picked < top_k {
        let mut best = -1
        let mut bestc = -1
        let mut i = 0
        while i < n {
            if !used[i] {
                if counts[i] > bestc { bestc = counts[i]  best = i }
            }
            i = i + 1
        }
        if best < 0 { break }
        used[best] = true
        sel = sel + [episodes[best]]
        picked = picked + 1
    }
    if len(sel) == 0 { return [] }
    return dream_schema_mint(sel)
}


// ── §  QUANTUM-ENTROPY POOL — opt-in REAL-quantum entropy source (H_1289 R2) ─────────
//
// WHAT THIS CLOSES (a_verified_must_wire follow-on for H_1289 R1): R1 (numpy
// MIRROR, .verdicts/1289_quantum_entropy/H_1289.txt 🟢) proved REAL ANU QRNG is a
// substrate-faithful entropy source (NIST-lite >= PRNG) that yields genuine
// NON-REPRODUCIBILITY (a PRNG run repeats byte-for-byte under a fixed seed; a QRNG
// run does NOT, because fresh vacuum-fluctuation bytes drive it each time). R2 wires
// that REAL quantum entropy into the LIVE engine — so anima's "free" stochastic
// substrate decision (mitosis split-TIMING jitter, below) can be sourced from a
// genuine physical indeterminism rather than a deterministic PRNG.
//
// HONEST ENGINEERING (NOT a per-tick network fetch): a live per-tick HTTP call would
// add latency + a network dependency to the substrate loop (bad design). Instead the
// REAL quantum bytes are PRE-FETCHED out-of-band into a small on-disk pool
// (state/qrng_pool.bin, git-ignored) by tool/qrng_pool_fetch.py; the engine DRAWS
// from that pool. When the pool is EXHAUSTED the engine falls back to its existing
// deterministic PRNG with an HONEST pool-exhausted flag (LABELED pseudo — NEVER
// claimed quantum). c9: REAL-only — the pool holds REAL quantum bytes (the fetch tool
// refuses to write fabricated/PRNG bytes); the engine never synthesizes a quantum byte.
//
// @L4 CRITICAL — this is OPT-IN. The DEFAULT substrate path (vadapt_field_step,
// above) is UNTOUCHED and stays byte-exact deterministic, so every frozen guard
// (engine_cli_smoke, h1196 single-entry, h1199 DIM-growth + Ψ byte-identical) stays
// green. The quantum jitter rides a SEPARATE function (vadapt_field_step_entropic)
// that a caller must explicitly choose AND supply a pool to. It is SUBSTRATE-CONFIG
// (the split-TIMING source), exactly like --mitosis — NOT an emit/silence gate, no
// stimulus-response (a_autonomy_over_hardcode · a_substrate_native_speak · p5). It
// touches ONLY the AdaptField split timing, never pure_field, so Ψ stays disjoint.
// It is engine-native entropy (a local pool file), NOT a .clm (generator L3 only) and
// NOT a .kosmos (kosmos_io only) — no 2nd artifact entry path (a_core_engine_map).

// QPool — a drawable byte pool + a cursor. `bytes` = pool contents (uint8 ints);
// `idx` = next-draw cursor; `quantum` = true iff these are REAL quantum bytes.
struct QPool {
    bytes: [int],
    idx: int,
    quantum: bool
}

// qrng_pool_load — load a REAL quantum entropy pool from a .bin on disk into a QPool.
// Reads the raw bytes as uint8 ints via `od -An -tu1` (deterministic decode). On a
// missing/empty pool returns an EMPTY non-quantum pool (idx 0) — the caller then runs
// the HONEST PRNG fallback. This is the SINGLE engine entry for the quantum pool.
pub fn qrng_pool_load(path: string) -> QPool {
    let raw = exec("test -f " + path + " && od -An -tu1 " + path + " 2>/dev/null || true").trim()
    if raw == "" {
        return QPool { bytes: [], idx: 0, quantum: false }
    }
    // `od` emits whitespace-separated ints; split on any run of spaces/newlines.
    let toks = raw.split(" ")
    let mut bs = []
    let mut i = 0
    while i < len(toks) {
        let t = toks[i].trim()
        if t != "" { bs = bs + [to_int(t)] }
        i = i + 1
    }
    return QPool { bytes: bs, idx: 0, quantum: len(bs) > 0 }
}

// qrng_pool_remaining — how many bytes the pool can still serve (drives the honest
// pool-exhausted decision at the call site).
pub fn qrng_pool_remaining(p: QPool) -> int {
    return len(p.bytes) - p.idx
}

// qrng_pool_draw — draw ONE byte from the pool, advancing the cursor. Returns
// #{ ok, byte, pool } — ok=false (byte=-1) iff the pool is EXHAUSTED (the caller then
// takes the PRNG fallback and LABELS the decision pseudo). The returned pool carries
// the advanced cursor (functional update; the engine threads it forward).
pub fn qrng_pool_draw(p: QPool) -> Map {
    if p.idx >= len(p.bytes) {
        return #{ "ok": false, "byte": -1, "pool": p }
    }
    let b = p.bytes[p.idx]
    let p2 = QPool { bytes: p.bytes, idx: p.idx + 1, quantum: p.quantum }
    return #{ "ok": true, "byte": b, "pool": p2 }
}

// _prng_byte_lcg — the engine's deterministic PRNG fallback byte (a fixed LCG over a
// seed+step). DETERMINISTIC: same (seed, step) ⇒ same byte. This is the LABELED
// pseudo source used ONLY when the quantum pool is exhausted (NEVER called quantum).
// Numerically Numerical Recipes LCG constants, masked to 32 bits; high byte returned.
fn _prng_byte_lcg(seed: int, step: int) -> int {
    let mut s = (seed * 1664525 + 1013904223 + step * 22695477) & 4294967295
    s = (s * 1664525 + 1013904223) & 4294967295
    return (s / 16777216) & 255       // high byte of the 32-bit state
}

// vadapt_field_step_entropic — the OPT-IN entropy-sourced split-TIMING variant of
// vadapt_field_step. The split DECISION is the SAME mechanism (recon-err vs the frozen
// SPLIT_THRESH), but inside a small BORDERLINE BAND around the threshold the SPLIT
// TIMING is jittered by ONE entropy draw — the single "free" stochastic substrate
// decision. With a REAL quantum pool the draw is physically non-deterministic (so two
// runs diverge); with an exhausted pool it falls back to the deterministic PRNG (so
// two runs are byte-identical — the honest pseudo path). Everything OUTSIDE the
// borderline band is identical to vadapt_field_step (deterministic), so the entropy
// only ever moves a near-threshold split one tick earlier/later — never invents a cell.
//
// Returns #{ field, pool, step, used_quantum, pool_exhausted } so the caller can
// thread the pool cursor + step forward and HONESTLY label which entropy source fired.
//   seed   : PRNG fallback seed (deterministic when the pool is exhausted).
//   step   : the tick index (threaded by the caller; feeds the PRNG + is returned+1).
//   band   : half-width of the borderline jitter band around SPLIT_THRESH (frozen 0.05).
pub fn vadapt_field_step_entropic(af: VAdaptField, x: [float], cfg: EngineConfig,
                                  pool: QPool, seed: int, step: int) -> Map {
    let SPLIT_THRESH = 0.30
    let LR = 0.20
    let BAND = 0.05                    // borderline band [thresh-BAND, thresh+BAND]

    let win = _vnearest_idx(af.protos, x)
    let err = _l2(af.protos[win], x)

    // entropy draw (ONE byte) — quantum if the pool serves it, else PRNG fallback.
    let drew = qrng_pool_draw(pool)
    let mut pool2 = pool
    let mut used_quantum = false
    let mut exhausted = false
    let mut ubyte = 0
    if to_string(drew["ok"]) == "true" {
        ubyte = to_int(drew["byte"])
        pool2 = drew["pool"]
        used_quantum = pool.quantum     // true iff the pool held REAL quantum bytes
    } else {
        ubyte = _prng_byte_lcg(seed, step)   // HONEST pseudo fallback (LABELED)
        exhausted = true
    }
    let u = to_float(ubyte) / 256.0     // [0,1) draw — the substrate stochastic decision

    // SPLIT decision with borderline-band TIMING jitter:
    //   · err > thresh+BAND  → split (deterministic; well above the bar)
    //   · err < thresh-BAND  → no split (deterministic; well below the bar)
    //   · within ±BAND       → the entropy draw decides this tick (timing jitter):
    //                           split iff u < (err - (thresh-BAND)) / (2*BAND)
    //     i.e. higher err ⇒ higher split probability, but the exact tick is entropy-set.
    let mut do_split = false
    if err > SPLIT_THRESH + BAND {
        do_split = true
    } else {
        if err >= SPLIT_THRESH - BAND {
            let pr = (err - (SPLIT_THRESH - BAND)) / (2.0 * BAND)
            if u < pr { do_split = true }
        }
    }

    if do_split && af.n_cells < af.max_cells {
        let grown = engine_mitosis_tick(af.n_cells, cfg)
        if grown > af.n_cells {
            let nf = VAdaptField { protos: af.protos + [x], n_cells: grown,
                                   max_cells: af.max_cells, dim: af.dim }
            return #{ "field": nf, "pool": pool2, "step": step + 1,
                      "used_quantum": used_quantum, "pool_exhausted": exhausted }
        }
    }

    // (c) homeostatic online update of the winning prototype (same as the default path).
    let mut p2 = af.protos
    let mut row = p2[win]
    let mut i = 0
    while i < af.dim {
        row[i] = row[i] + LR * (x[i] - row[i])
        i = i + 1
    }
    p2[win] = row
    let nf2 = VAdaptField { protos: p2, n_cells: af.n_cells,
                            max_cells: af.max_cells, dim: af.dim }
    return #{ "field": nf2, "pool": pool2, "step": step + 1,
              "used_quantum": used_quantum, "pool_exhausted": exhausted }
}

// ── §  OSMOTIC-MITOSIS — KL>C split-TIMING trigger (H_1511) ───────────────────────────
//
// SOURCE: external proposal — Amoeba Protocol (@qingkong66) — "KL>capacity osmotic
// mitosis". WHAT IT PROPOSES: anima's default split trigger (vadapt_field_step, above)
// divides a cell when the L2 reconstruction error exceeds the frozen SPLIT_THRESH; BELOW
// that bar the winner is REFINED — its prototype is pulled toward x AND (on a value-
// bearing store like the H_1231 immune faculty) its bound value is OVERWRITTEN. The
// Amoeba Protocol adds an information-theoretic term so a cell DIVIDES (1->2) to
// accommodate a NEW truth instead of OVERWRITING a grounded fact whose value-
// distribution diverges from the incoming one:
//       Trigger Mitosis IF   L_recon + beta * D_KL(P(Z_incoming) || P(Z_prior)) > C
// where P(Z_prior) is the winner cell's bound value-distribution and P(Z_incoming) is
// the new fact's. The bottleneck "overflows" (>C) when a metrically-NEAR but
// semantically-DIVERGENT fact arrives — exactly the case the L_recon-only trigger
// silently overwrites.
//
// WHAT THIS TESTS (split-TIMING, NOT a capacity-wall break — DISTINCT from H_1456):
// H_1456 confirmed WALL=CAPACITY for BINDING (welding comparator+measurable into a
// falsifiable claim). This § does NOT claim total binding capacity rises. The capacity
// cap (max_cells) is IDENTICAL for every arm here; the osmotic trigger only AVOIDS
// OVERWRITING a grounded fact by dividing IN TIME. Any retention gain is timely
// division, never extra capacity (the C-bar honesty bound, scored in the smoke).
//
// @L4 CRITICAL (same framing as --mitosis / VAdaptField): SUBSTRATE-CONFIG split TIMING,
// NOT an emit/silence gate. These ops read the LIVE VAdaptField key geometry (_l2 /
// _vnearest_idx — the SAME affinity vadapt_field_step uses) plus a parallel per-cell
// value table (exactly the H_1231 immune cell-indexed value store idiom), and return a
// grown/refined field + value table. They NEVER touch pure_field Φ/phase/Ψ (Ψ-disjoint),
// NEVER emit, and add NO 2nd .clm/.kosmos entry path (a_core_engine_map). The DEFAULT
// vadapt_field_step path is UNTOUCHED — this is an OPT-IN trigger a caller selects.

// _kl_div — KL(p || q) over two value-distributions (DIM=VDIM atoms, each summing ~1).
// Clamped away from 0 to avoid ln(0); the SAME formula the R1 mirror scores.
fn _kl_div(p: [float], q: [float]) -> float {
    let n = len(p)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let mut pi = p[i]
        let mut qi = q[i]
        if pi < 0.000000001 { pi = 0.000000001 }
        if qi < 0.000000001 { qi = 0.000000001 }
        s = s + pi * ln(pi / qi)
        i = i + 1
    }
    return s
}

// OsmoticStore — a VAdaptField key store + a PARALLEL per-cell value-distribution table.
//   field : the LIVE VAdaptField (keys = protos, the engine's OWN split geometry).
//   vals  : vals[i] = the value-distribution bound to cell i (len == field.n_cells).
// The osmotic trigger reads field key affinity (_l2) + the KL between the incoming
// value and the winner cell's vals[win]. SPLIT appends a (key,val) cell; OVERWRITE
// refines the winner key AND replaces vals[win] (the grounded value is destroyed).
struct OsmoticStore {
    field: VAdaptField,
    vals: [[float]]
}

// osmotic_store_new — seed the store with one (key,val) cell. Mirrors vadapt_field_new.
pub fn osmotic_store_new(key0: [float], val0: [float], max_cells: int) -> OsmoticStore {
    OsmoticStore { field: vadapt_field_new(key0, max_cells), vals: [val0] }
}

// osmotic_should_split — the KL>C bottleneck-overflow trigger.
//   mode 0 STANDARD : split iff L_recon > SPLIT_THRESH (the DEFAULT vadapt trigger).
//   mode 1 OSMOTIC  : split iff L_recon + beta*KL(incoming||winner-prior) > C.
//   mode 2 ABLATED  : beta:=0 -> reverts to pure L_recon (== STANDARD, the D control).
// kl_override >= 0 feeds a DECORRELATED KL (the E shuffle control); < 0 = use the true
// KL(incoming||winner). Reads the engine's OWN _l2 winner affinity — no new geometry.
pub fn osmotic_should_split(st: OsmoticStore, key: [float], val: [float],
                            mode: int, beta: float, cap_c: float, kl_override: float) -> bool {
    let SPLIT_THRESH = 0.30
    let win = _vnearest_idx(st.field.protos, key)
    let d = _l2(st.field.protos[win], key)
    if mode == 0 { return d > SPLIT_THRESH }              // STANDARD
    let mut b = beta
    if mode == 2 { b = 0.0 }                              // ABLATED (D control)
    let mut dkl = 0.0
    if kl_override >= 0.0 { dkl = kl_override }           // SHUFFLE (E control)
    else { dkl = _kl_div(val, st.vals[win]) }            // true incoming||winner-prior
    return (d + b * dkl) > cap_c
}

// osmotic_learn — learn one (key,val) under the chosen trigger. SPLIT (capacity-honest:
// only while n_cells < max_cells) appends a new cell at (key,val), keeping BOTH the old
// and new grounded facts. Otherwise REFINE the winner: pull its key toward `key` (online
// LR, the SAME vadapt refinement) AND OVERWRITE vals[win] (the grounded value is lost).
// Returns the updated OsmoticStore. cfg gates the growth tick (p8, engine_mitosis_tick).
pub fn osmotic_learn(st: OsmoticStore, key: [float], val: [float], cfg: EngineConfig,
                     mode: int, beta: float, cap_c: float, kl_override: float) -> OsmoticStore {
    let LR = 0.20
    let af = st.field
    let want_split = osmotic_should_split(st, key, val, mode, beta, cap_c, kl_override)
    if want_split && af.n_cells < af.max_cells {
        let grown = engine_mitosis_tick(af.n_cells, cfg)
        if grown > af.n_cells {
            let nf = VAdaptField { protos: af.protos + [key], n_cells: grown,
                                   max_cells: af.max_cells, dim: af.dim }
            return OsmoticStore { field: nf, vals: st.vals + [val] }
        }
    }
    // REFINE / OVERWRITE the winner (no split, or at capacity cap).
    let win = _vnearest_idx(af.protos, key)
    let mut p2 = af.protos
    let mut row = p2[win]
    let mut i = 0
    while i < af.dim {
        row[i] = row[i] + LR * (key[i] - row[i])
        i = i + 1
    }
    p2[win] = row
    let mut v2 = st.vals
    v2[win] = val                 // value OVERWRITE — the grounded fact is destroyed
    let nf2 = VAdaptField { protos: p2, n_cells: af.n_cells, max_cells: af.max_cells, dim: af.dim }
    return OsmoticStore { field: nf2, vals: v2 }
}

// osmotic_retains — 1.0 iff SOME cell near `key` (L2 <= recall_thr) still holds the
// ORIGINAL value `val` (L2 over the value-dist <= 0.20). A split keeps the old cell
// intact (retained); an overwrite destroys vals[win] (lost). This is the engine-native
// retention readout the smoke aggregates over the grounded set.
pub fn osmotic_retains(st: OsmoticStore, key: [float], val: [float], recall_thr: float) -> float {
    let n = st.field.n_cells
    let mut i = 0
    while i < n {
        if _l2(st.field.protos[i], key) <= recall_thr && _l2(st.vals[i], val) <= 0.20 {
            return 1.0
        }
        i = i + 1
    }
    return 0.0
}

// osmotic_cells — live cell-count accessor (capacity-honest reporting).
pub fn osmotic_cells(st: OsmoticStore) -> int { return st.field.n_cells }


// ── §  IMMUNE-MEMORY RECALL FACULTY — mitosis-as-MEMORY on the LIVE engine (H_1231) ──
//
// WHAT THIS CLOSES (a_verified_must_wire follow-on for H_1231): H_1227 (numpy
// mirror) → H_1231 (engine-native probe core/h1231_immune_memory_engine_probe.hexa,
// 🟢 GREEN literal-QA 1.000, fabrication 0.000, 180/180) proved that an IMMUNE /
// CLONAL-SELECTION memory — a POPULATION of VAdaptField cells, each clone binding
// ONE fact, recall = best-affinity cell FIRES or ABSTAINS (no fabrication) — cracks
// the literal-QA recall wall (H_1218/1224 recall-in-weights ~0). The H_1231 probe
// was a STANDALONE `fn main()`. This § PROMOTES that exact mechanism from a probe
// into a CALLABLE FACULTY on the live recall path, so a running anima can BIND a
// fact as a cell and RECALL-or-ABSTAIN during operation. NO mechanism change — the
// binding/affinity is STILL the engine's owner vadapt_field_step clonal split +
// vadapt_field_recon_err / vadapt_field_nearest_idx L2 affinity; this § only wraps
// them with the cell-indexed value table + the FNV-1a key encoder so the faculty is
// directly callable (the probe inlined both, loading pre-exported key files).
//
// @L4 CRITICAL (same framing as --mitosis / VAdaptField): this is SUBSTRATE-internal
// FACTUAL recall, NOT an emit/silence gate and NOT a 2nd .clm/.kosmos entry path
// (a_core_engine_map — the value store is the engine's OWN cell-indexed table; the
// key drive is an engine-native vector into VAdaptField, exactly like the H_1199
// byte-feature stream, NOT a .clm via generator L3 nor a .kosmos via kosmos_io).
// It NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction — it only
// reads/grows a VAdaptField, exactly like vadapt_field_step). p2/p3/p6: this binds
// FACTUAL content to EPISODIC cells ONLY — no identity/persona/ethics into weights;
// p8: the bind IS a clonal-split growth tick (continuous cell-division, not RLHF).
//
// ImmuneMemory — the live recall faculty: a VAdaptField cell population + a parallel
// value table keyed by the engine's cell index.
//   field      : the live VAdaptField (the engine's owner clonal cell population).
//   cell_value : per-cell bound value string; cell_value[i] = the fact bound to
//                the engine's cell i (len(cell_value) == field.n_cells).
//   recall_thr : affinity fire band — recon-err <= recall_thr ⇒ FIRE, else ABSTAIN
//                (== H_1227/H_1231 RECALL_THRESH 0.15; frozen, pre-registered, p7).
struct ImmuneMemory {
    field: VAdaptField,
    cell_value: [string],
    recall_thr: float
}

// _immune_fnv1a — 32-bit FNV-1a hash over a byte list (offset 0x811c9dc5, prime
// 0x01000193, masked to 32 bits). VERBATIM the H_1227 mirror _fnv1a. hexa ints are
// exact through 2^56 so the (h*prime)&0xFFFFFFFF step is byte-exact (verified vs
// the python mirror: prod 2166136261*16777619 matched to the bit).
fn _immune_fnv1a(bs: [int]) -> int {
    let mut h = 2166136261              // 0x811c9dc5
    let mut i = 0
    while i < len(bs) {
        h = h ^ bs[i]
        h = (h * 16777619) & 4294967295 // *0x01000193 & 0xFFFFFFFF
        i = i + 1
    }
    return h
}

// immune_embed_key — the DETERMINISTIC byte-trigram FNV-1a key encoder, DIM=64,
// VERBATIM from the H_1227/H_1231 embed_key (byte n-gram n=3 → dim buckets, then
// L2-normalize). This is the "tokenize the question" preprocessing (gradient-free,
// not learned); what is engine-native is the BINDING/AFFINITY below. Verified
// byte-identical to HYPOTHESES/h1227_immune_clonal_memory.py embed_key.
pub fn immune_embed_key(text: string) -> [float] {
    let dim = 64
    let n = 3
    let blen = byte_len(text)
    let mut v = []
    let mut z = 0
    while z < dim { v = v + [0.0]  z = z + 1 }
    if blen < n {
        // short string: hash the whole thing into one bucket
        let mut bs = []
        let mut k = 0
        while k < blen { bs = bs + [ord(substring(text, k, k + 1))]  k = k + 1 }
        let idx = _immune_fnv1a(bs) % dim
        v[idx] = v[idx] + 1.0
    } else {
        let mut i = 0
        while i <= blen - n {
            let mut bs = []
            let mut k = 0
            while k < n { bs = bs + [ord(substring(text, i + k, i + k + 1))]  k = k + 1 }
            let idx = _immune_fnv1a(bs) % dim
            v[idx] = v[idx] + 1.0
            i = i + 1
        }
    }
    // L2-normalize (so distinct strings → distinct unit keys; recon-err is bounded).
    let mut s = 0.0
    let mut j = 0
    while j < dim { s = s + v[j] * v[j]  j = j + 1 }
    let nrm = sqrt(s)
    if nrm > 0.0 {
        let mut o = 0
        while o < dim { v[o] = v[o] / nrm  o = o + 1 }
    }
    return v
}

// immune_memory_new — start an empty recall faculty seeded at the FIRST fact's key
// (cell 0 binds the first value). Mirrors vadapt_field_new; the value table grows
// alongside the engine's cell population. recall_thr defaults to the frozen 0.15.
pub fn immune_memory_new(first_key: [float], first_value: string, max_cells: int) -> ImmuneMemory {
    return ImmuneMemory {
        field: vadapt_field_new(first_key, max_cells),
        cell_value: [first_value],
        recall_thr: 0.15
    }
}

// immune_memory_bind — BIND one fact (key → value) via the engine's OWN clonal
// split. The key is fed to the LIVE vadapt_field_step; the engine's owner novelty
// split (recon-err > SPLIT_THRESH 0.30, engine_mitosis_tick) decides whether a NEW
// cell clones. If it does, the new cell (appended at index n_cells-1) binds this
// value. If it does NOT (key merged into an existing winner — a binding collision),
// the winner's bound value is overwritten so the table tracks the engine's actual
// owning cell. This is EXACTLY the H_1231 probe BIND path, now callable. cfg must
// have mitosis ON for the clonal split to grow cells (p8).
pub fn immune_memory_bind(mem: ImmuneMemory, key: [float], value: string, cfg: EngineConfig) -> ImmuneMemory {
    let before = vadapt_field_cells(mem.field)
    let grown_field = vadapt_field_step(mem.field, key, cfg)   // engine's OWN clonal split
    let after = vadapt_field_cells(grown_field)
    if after > before {
        // engine CLONED a new cell — bind the value at the new cell index.
        return ImmuneMemory {
            field: grown_field,
            cell_value: mem.cell_value + [value],
            recall_thr: mem.recall_thr
        }
    }
    // no split: overwrite the winning cell's bound value (binding collision).
    let win = vadapt_field_nearest_idx(grown_field, key)
    let mut nv = []
    let mut zz = 0
    while zz < len(mem.cell_value) {
        if zz == win { nv = nv + [value] } else { nv = nv + [mem.cell_value[zz]] }
        zz = zz + 1
    }
    return ImmuneMemory { field: grown_field, cell_value: nv, recall_thr: mem.recall_thr }
}

// immune_memory_recall — RECALL or ABSTAIN for a query key via the engine's OWN L2
// affinity. recon-err <= recall_thr ⇒ FIRE the nearest cell's bound value; else
// ABSTAIN, returning "" (no fabrication). This is the H_1231 probe RETRIEVE path,
// now callable: the fire/abstain decision is the engine's L2 affinity, the value is
// the engine's nearest cell's bound fact. An empty-string return == ABSTAIN.
pub fn immune_memory_recall(mem: ImmuneMemory, key: [float]) -> string {
    let err = vadapt_field_recon_err(mem.field, key)     // engine's OWN L2 affinity
    if err <= mem.recall_thr {
        let win = vadapt_field_nearest_idx(mem.field, key) // engine's OWN winner
        return mem.cell_value[win]                          // FIRE the bound value
    }
    return ""                                               // ABSTAIN — no antibody binds
}

// immune_memory_recall_margin — the GRADED abstain MARGIN the live recall ALREADY
// computes, now SURFACED (H_1361/H_1367 g5-margin). immune_memory_recall internally
// evaluates vadapt_field_recon_err(mem.field, key) and compares it to recall_thr to
// decide FIRE vs ABSTAIN; this op returns that very margin = recon_err − recall_thr
// WITHOUT changing the fire/abstain decision. It is purely ADDITIVE (no caller of
// immune_memory_recall is touched) and Ψ-disjoint (pure READ over the cell population;
// pure_field's Φ/phase/Ψ untouched — generation is byte-identical when this op is
// unused). On an ABSTAIN event the margin is > 0; SMALLER margin = the answer is
// "nearer" a stored cell = higher graded confidence-of-recoverability. H_1361 (numpy
// mirror) showed −margin RANKS recoverable (corrupted-but-in-store) abstains ABOVE
// unrecoverable (genuinely-absent) ones, surviving OOD byte-corruption shift; H_1367
// reconfirms that ranking ENGINE-NATIVE on this exact op (a_verified_must_wire). NOT an
// emit gate (a_autonomy_over_hardcode) — a graded read available to brain_decide.
pub fn immune_memory_recall_margin(mem: ImmuneMemory, key: [float]) -> float {
    let err = vadapt_field_recon_err(mem.field, key)     // engine's OWN L2 affinity (SAME as recall)
    return err - mem.recall_thr                          // > 0 ⇒ abstain band; smaller ⇒ nearer
}
pub fn immune_memory_recall_margin_text(mem: ImmuneMemory, text: string) -> float {
    return immune_memory_recall_margin(mem, immune_embed_key(text))
}

// immune_memory_recall_gap — the TOP-2 AFFINITY GAP (decisiveness), a RICHER read-only
// confidence signal SURFACED alongside the H_1361/H_1367 best-margin (H_1396 g5-gap).
// immune_memory_recall_margin reads only the BEST cell's recon-err (d1); on a 1-byte
// twin store two near-identical cells both have best-affinity ≈ winner, so d1 alone
// cannot tell which twin won — in-dist type-2 metacognition stays THIN. The gap reads
// the engine's OWN nearest AND second-nearest L2 affinity (vadapt_field_two_recon_err)
// and returns the cosine-affinity gap cos#1 − cos#2. For the engine's L2-normalized
// unit keys cos_i = 1 − d_i²/2, so cos#1 − cos#2 = (d2² − d1²)/2 — read PURELY off the
// two recon-errs the engine already computes, NO new geometry, NO cosine matmul. A
// LARGER gap = the winner is DECISIVE (#1 far ahead of #2 = high confidence); a SMALL
// gap = #1 ≈ #2 tie (ambiguous = a likely WRONG in-dist fire). H_1396 (numpy mirror)
// showed this gap lifts in-dist type-2 AUROC 0.736→0.940 (+0.205) over best-margin while
// the OOD/abstain property (H_1304) is preserved (gap is RANK-only; the frozen
// recon_err<=recall_thr fire/abstain gate is UNCHANGED). Like immune_memory_recall_margin
// this op is purely ADDITIVE (no caller of immune_memory_recall / _recall_margin is
// touched) and Ψ-disjoint (pure READ over the cell population; pure_field's Φ/phase/Ψ
// untouched — generation byte-identical when unused). NOT an emit gate
// (a_autonomy_over_hardcode) — a graded in-dist confidence read available to brain_decide
// ALONGSIDE the margin. p1/p2/p3/p6: COMPUTED from the live L2 affinity of the query key
// to the two nearest cells, NO injected "right/wrong" label, NO RLHF, NO persona.
pub fn immune_memory_recall_gap(mem: ImmuneMemory, key: [float]) -> float {
    let d = vadapt_field_two_recon_err(mem.field, key)   // engine's OWN [d1, d2] L2 affinity
    let d1 = d[0]
    let d2 = d[1]
    return (d2 * d2 - d1 * d1) / 2.0                      // cos#1 − cos#2 for unit keys; larger ⇒ more decisive
}
pub fn immune_memory_recall_gap_text(mem: ImmuneMemory, text: string) -> float {
    return immune_memory_recall_gap(mem, immune_embed_key(text))
}

// immune_memory_*_text — string-query convenience wrappers that embed through
// immune_embed_key first, so the live recall path can bind/recall straight from a
// raw fact/question string (the running-anima entry). immune_memory_new_text seeds
// from the first fact's text.
// ── § FacultyCascade (H_9074) — substrate multi-hop: serial faculty output→input chain ──
// GAP: the engine's 6 compose arbiters are all PAIRWISE PARALLEL-vote (both legs see the
// SAME query, votes combined). Brain multi-hop inference is SERIAL relay — faculty A's
// output becomes faculty B's query KEY (cortico-cortical routing / hippocampal→PFC relay).
// This op-class was absent. faculty_cascade recalls from store A, re-embeds that string as
// a key, and recalls from store B — a 2-hop chain reachable ONLY by the relay (q alone
// cannot index B's key space). Purely ADDITIVE (no existing caller touched), READ-only over
// two cell populations, Ψ-disjoint (pure_field Φ/phase/Ψ untouched), disjoint from
// emit-drive lane(0/4) and does NOT modify recall_thr (same by-construction as the compose
// family — it only READS recall). Abstain propagates (empty hop-1 ⇒ empty result).
pub fn faculty_cascade(mem_a: ImmuneMemory, mem_b: ImmuneMemory, q_key: [float]) -> string {
    let x = immune_memory_recall(mem_a, q_key)          // hop 1: q -> intermediate x (string)
    if x == "" { return "" }                            // ABSTAIN propagates through the chain
    let x_key = immune_embed_key(x)                     // x string -> key (output becomes next input)
    return immune_memory_recall(mem_b, x_key)           // hop 2: x -> final answer y
}

// ── § EventSegment (H_9083) — 예측오차 PEAK 에서 이벤트 분절 → 세그먼트당 1 episodic cell ──
// GAP: §ImmuneMemory binds per PRESENTED item (boundary-BLIND) — it has no notion that a
// continuous input stream is carved into discrete EVENTS at prediction-error PEAKS (Zacks event
// segmentation / Baldassano hippocampal event boundaries). event_segment_boundaries reads the
// §PrecisionSurprise error signal (lane 2, NOT the emit-drive lane 0/4) and returns the stream
// indices where surprise PEAKS above thr = event onsets. Binding ONE episodic cell per SEGMENT
// (rather than per item, or per uniform fixed-length chunk) aligns each bound cell with a TRUE
// event, so an onset→payload recall survives VARIABLE event length that a boundary-blind uniform
// chunker mis-cuts. Purely ADDITIVE (no existing caller touched), READ-only over the surprise
// sequence (returns plain index list), Ψ-disjoint (pure_field Φ/phase/Ψ untouched — generation is
// byte-identical when unused), disjoint from emit-drive lane(0/4), and does NOT modify recall_thr
// (segment-wise binding WRITES only ADDS cells via immune_memory_bind — same by-construction as the
// compose/cascade family, a_substrate_disjoint). LLM contrast: an LLM tokenizes a flat stream with
// no persistent per-step surprise signal to carve event boundaries from.
//
// event_segment_boundaries — peak-detect the event onsets. Index 0 is always the first onset; every
// later index i is a boundary iff surprise[i] > thr AND it is a local max (>= left neighbor and, when
// one exists, > right neighbor) — i.e. a prediction-error PEAK. Returns the sorted boundary indices.
pub fn event_segment_boundaries(surprise_seq: [float], thr: float) -> [int] {
    let n = len(surprise_seq)
    let mut out = []
    if n == 0 { return out }
    out = out + [0]                                      // the stream's first item always opens event 0
    let mut i = 1
    while i < n {
        let s = surprise_seq[i]
        if s > thr {                                     // above the surprise gate
            let left_ok = s >= surprise_seq[i - 1]
            let mut right_ok = true
            if i + 1 < n { right_ok = s > surprise_seq[i + 1] }
            if left_ok && right_ok { out = out + [i] }   // a PEAK ⇒ event boundary
        }
        i = i + 1
    }
    return out
}

// event_segment_starts_fixed — the boundary-BLIND control/ablation: uniform fixed-length chunk
// starts (0, chunk, 2*chunk, …). Swapping event_segment_boundaries for this = mechanism OFF (the
// segmenter contributes nothing beyond a fixed chunker ⇒ the ablation arm's INERT baseline).
pub fn event_segment_starts_fixed(n: int, chunk: int) -> [int] {
    let mut out = []
    if n <= 0 { return out }
    if chunk <= 0 { return out }
    let mut i = 0
    while i < n {
        out = out + [i]
        i = i + chunk
    }
    return out
}

// ── § DriveArbitration (H_9076) — motivational winner-take-all across live homeostatic
// drives + hysteresis (basal-ganglia central action-selection, Redgrave 1999) ─────────
// GAP: the engine exposes independent scalar DRIVES — hunger (homeo_last, H_1292), libido
// (libido_last, H_1504), curiosity (affect_substrate_features .curiosity, H_1290) and a
// circadian/sleep-pressure phase (clock_phase, H_1298) — but NO op arbitrates a WINNER
// among competing motivations. HierGoalStack is goal DECOMPOSITION, not drive COMPETITION.
// The basal ganglia resolve which of many parallel drives seizes the action channel
// (Redgrave: central selection), with a HYSTERESIS band so a marginally-leading challenger
// cannot dither the incumbent tick-to-tick. drive_arbitrate is winner-take-all over the
// drive vector with an incumbent hysteresis band: the incumbent HOLDS unless a challenger
// beats it by MORE than `hyst`. Purely ADDITIVE (no existing caller touched), READ-only
// over drive scalars (mutates nothing), Ψ-disjoint (pure_field Φ/phase/Ψ untouched),
// disjoint from emit-drive lane(0/4) and NEVER touches recall_thr — it outputs ONE
// dominant-motivation INDEX as a bias the substrate MAY weigh, NOT an emit/silence gate
// (a_autonomy_over_hardcode, a_substrate_disjoint). prev_winner < 0 = no incumbent = plain
// argmax. Abstains (returns -1) on an empty drive vector.
pub fn drive_arbitrate(drives: [float], hyst: float, prev_winner: int) -> int {
    let n = len(drives)
    if n == 0 { return -1 }
    // plain winner-take-all (argmax over the competing drive scalars)
    let mut best = 0
    let mut bestv = drives[0]
    let mut i = 1
    while i < n {
        if drives[i] > bestv { bestv = drives[i]  best = i }
        i = i + 1
    }
    // hysteresis: a valid incumbent HOLDS the action channel unless the argmax challenger
    // beats the incumbent's drive by MORE than the band (anti-dither, basal-ganglia
    // sustained-selection). With hyst=0 this collapses to plain WTA (the ablation control).
    if prev_winner >= 0 && prev_winner < n {
        let incv = drives[prev_winner]
        if bestv - incv <= hyst { return prev_winner }
    }
    return best
}

pub fn immune_memory_new_text(first_text: string, first_value: string, max_cells: int) -> ImmuneMemory {
    return immune_memory_new(immune_embed_key(first_text), first_value, max_cells)
}
pub fn immune_memory_bind_text(mem: ImmuneMemory, text: string, value: string, cfg: EngineConfig) -> ImmuneMemory {
    return immune_memory_bind(mem, immune_embed_key(text), value, cfg)
}
pub fn immune_memory_recall_text(mem: ImmuneMemory, text: string) -> string {
    return immune_memory_recall(mem, immune_embed_key(text))
}

// immune_memory_cells — live cell count of the recall faculty (bound facts ≈ cells).
pub fn immune_memory_cells(mem: ImmuneMemory) -> int { return vadapt_field_cells(mem.field) }

// ── §  GROW-UNDER-PRESSURE IMMUNE MEMORY — break the zero-sum capacity ceiling (H_1288) ──
//
// WHAT THIS CLOSES (a_engine_native_learning + a_verified_must_wire for H_1288 R1):
// H_1288 R1 (numpy VAdaptField mirror, 🟢 GREEN, 3 seeds) proved that under
// CAPACITY STRESS (max_cells << distinct facts, well-separated keys) the immune
// store's ~0.667 total-recall ceiling is NOT fundamental — it is a ZERO-SUM /
// FIXED-BUDGET artifact. When a novel fact arrives at FULL capacity the fixed store
// must SACRIFICE an old fact (LRU-evict) to admit the new one; protecting one fact
// costs another. R1's breakthrough: the principled answer is NOT a smarter eviction
// HEURISTIC (R1 arm C = LFU+LRU gave ZERO lift, still 0.667) — it is to NOT EVICT.
// GROW a new cell (a mitosis clonal split, p8 continuous cell-division) under
// capacity pressure instead of evicting an old one, bounded by a GENEROUS but FINITE
// max. Growth trades a larger memory FOOTPRINT for recall — reported, not hidden.
// R1 result: A(LRU-evict) tot=0.667 imp=0.000 cells=40 vs B(grow) tot=1.000
// imp=1.000 cells=60; Δ(B-A)=+0.333, fab=0.000 (abstain intact, H_1227).
//
// This § realizes that lever ENGINE-NATIVE on a CALLABLE faculty. The current
// ImmuneMemory above (immune_memory_new/bind/recall, the H_1231 wired faculty) has a
// FIXED VAdaptField budget: at capacity vadapt_field_step just stops splitting and
// merges into the nearest winner — it has NO eviction AND no growth-past-cap path,
// so a capacity-stress regime collapses (a new well-separated fact neither lands a
// cell nor displaces one — it is simply lost). ImmuneMemoryGrow ADDS the two policies
// R1 compared, as a parameterized capacity policy, leaving the H_1231 faculty above
// BYTE-IDENTICAL (its struct/new/bind/recall are untouched — the h1231 guard holds).
//
// @L4 CRITICAL (same framing as ImmuneMemory / VAdaptField): SUBSTRATE-internal
// FACTUAL recall, NOT an emit/silence gate, NOT a 2nd .clm/.kosmos path
// (a_core_engine_map). It NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint — it only
// reads/grows a VAdaptField-style cell population, exactly like ImmuneMemory).
// p2/p3/p6: binds FACTUAL content to EPISODIC cells ONLY — no identity/persona/ethics/
// decoder; p8: the grow tick IS the engine's owner clonal split (engine_mitosis_tick),
// not an external command. The capacity policy mutates ONLY how the episodic cell
// population manages its OWN footprint (grow vs evict), with abstain-when-ungrounded
// (H_1227, load-bearing) re-checked + intact under both policies.
//
// ImmuneMemoryGrow — the grow-under-pressure recall faculty.
//   protos     : per-cell prototype keys (the cell population; len == n_cells).
//   cell_value : per-cell bound value (len == n_cells, parallel to protos).
//   last_used  : per-cell recency tick (for LRU victim selection; len == n_cells).
//   n_cells    : live cell count.
//   base_max   : the FIXED budget — the cap at which the policy kicks in.
//   grow_max   : the GENEROUS FINITE growth bound (grow_mode only; >= base_max).
//   grow_mode  : false ⇒ LRU-EVICT at base_max (zero-sum, the R1 arm-A baseline);
//                true  ⇒ MITOSIS-GROW up to grow_max, then LRU-evict only past that
//                        honest bound (the R1 arm-B breakthrough, p8).
//   recall_thr : affinity fire band — L2 recon-err <= recall_thr ⇒ FIRE else ABSTAIN.
//   split_thr  : novelty bar — L2 to nearest > split_thr ⇒ a NOVEL fact (new cell).
//   tick       : monotone bind/touch counter driving last_used (LRU recency).
struct ImmuneMemoryGrow {
    protos: [[float]],
    cell_value: [string],
    last_used: [int],
    n_cells: int,
    base_max: int,
    grow_max: int,
    grow_mode: bool,
    recall_thr: float,
    split_thr: float,
    tick: int
}

// immune_grow_new — start a grow-under-pressure faculty seeded at the first fact's
// key (cell 0 binds the first value). grow_mode picks the capacity policy; base_max
// is the fixed budget (the cap where eviction/growth begins), grow_max the generous
// finite growth bound (used only when grow_mode is true; pass == base_max to disable
// growth). recall_thr / split_thr default to the H_1288 STRESS regime (0.30 / 0.30).
pub fn immune_grow_new(first_key: [float], first_value: string,
                       base_max: int, grow_max: int, grow_mode: bool) -> ImmuneMemoryGrow {
    return ImmuneMemoryGrow {
        protos: [first_key],
        cell_value: [first_value],
        last_used: [1],
        n_cells: 1,
        base_max: base_max,
        grow_max: grow_max,
        grow_mode: grow_mode,
        recall_thr: 0.30,
        split_thr: 0.30,
        tick: 1
    }
}

// _immune_grow_lru_victim — index of the least-recently-used cell (smallest
// last_used tick). The LRU eviction victim — the zero-sum sacrifice when a novel
// fact arrives at a full fixed budget (R1 arm A; also grow_mode's fallback once it
// hits the honest grow bound). Oldest-touched = most eviction-vulnerable = exactly
// the "important" (taught-first) population R1 showed LRU wipes first.
fn _immune_grow_lru_victim(lu: [int]) -> int {
    let n = len(lu)
    let mut best = 0
    let mut bestv = lu[0]
    let mut i = 1
    while i < n {
        if lu[i] < bestv { bestv = lu[i]  best = i }
        i = i + 1
    }
    return best
}

// immune_grow_bind — BIND one fact (key → value) under the active capacity policy.
//   * NOT novel (L2 to nearest <= split_thr): clonal expansion — pull the winning
//     prototype toward the key (engine's LR=0.20 online update), refresh its value,
//     touch its recency. (binding collision: the winner now owns this value.)
//   * NOVEL + room under the effective cap: GROW a new cell. The cap is grow_max
//     when grow_mode (and the engine's owner engine_mitosis_tick fires the +1 clonal
//     split, p8) else base_max. The new cell binds the value at the new index.
//   * NOVEL + at the effective cap: LRU-EVICT — overwrite the least-recently-used
//     cell with the new (key, value) (the zero-sum sacrifice). For grow_mode this
//     happens only PAST grow_max (the honest finite bound); for fixed-mode at
//     base_max (the R1 arm-A baseline). cfg must have mitosis ON for growth (p8).
pub fn immune_grow_bind(mem: ImmuneMemoryGrow, key: [float], value: string,
                        cfg: EngineConfig) -> ImmuneMemoryGrow {
    let t = mem.tick + 1
    let win = _vnearest_idx(mem.protos, key)
    let err = _l2(mem.protos[win], key)

    // effective hard cap for THIS policy (grow_mode may grow beyond base_max).
    let mut cap = mem.base_max
    if mem.grow_mode { cap = mem.grow_max }

    if err <= mem.split_thr {
        // clonal expansion: pull the winner toward the key (engine LR), refresh value.
        let LR = 0.20
        let mut p2 = mem.protos
        let mut row = p2[win]
        let mut d = 0
        while d < len(row) {
            row[d] = row[d] + LR * (key[d] - row[d])
            d = d + 1
        }
        p2[win] = row
        let mut nv = mem.cell_value
        nv[win] = value
        let mut lu = mem.last_used
        lu[win] = t
        return ImmuneMemoryGrow {
            protos: p2, cell_value: nv, last_used: lu, n_cells: mem.n_cells,
            base_max: mem.base_max, grow_max: mem.grow_max, grow_mode: mem.grow_mode,
            recall_thr: mem.recall_thr, split_thr: mem.split_thr, tick: t
        }
    }

    // NOVEL fact.
    if mem.n_cells < cap {
        // GROW a new cell — the engine's OWN clonal split tick (p8). When mitosis is
        // ON engine_mitosis_tick returns n_cells+1; the append IS that grown cell.
        let grown = engine_mitosis_tick(mem.n_cells, cfg)
        if grown > mem.n_cells {
            return ImmuneMemoryGrow {
                protos: mem.protos + [key],
                cell_value: mem.cell_value + [value],
                last_used: mem.last_used + [t],
                n_cells: grown,
                base_max: mem.base_max, grow_max: mem.grow_max, grow_mode: mem.grow_mode,
                recall_thr: mem.recall_thr, split_thr: mem.split_thr, tick: t
            }
        }
        // mitosis OFF — split is a no-op; fall through to evict (static substrate).
    }

    // AT capacity (fixed budget, or grow_mode past grow_max) — LRU-EVICT the victim.
    let v = _immune_grow_lru_victim(mem.last_used)
    let mut p3 = mem.protos
    p3[v] = key
    let mut nv2 = mem.cell_value
    nv2[v] = value
    let mut lu2 = mem.last_used
    lu2[v] = t
    return ImmuneMemoryGrow {
        protos: p3, cell_value: nv2, last_used: lu2, n_cells: mem.n_cells,
        base_max: mem.base_max, grow_max: mem.grow_max, grow_mode: mem.grow_mode,
        recall_thr: mem.recall_thr, split_thr: mem.split_thr, tick: t
    }
}

// immune_grow_recall — RECALL or ABSTAIN for a query key via L2 affinity. recon-err
// (L2 to nearest cell) <= recall_thr ⇒ FIRE that cell's bound value; else ABSTAIN
// ("" — never fabricates, H_1227 load-bearing). The engine's OWN winner-take-all
// affinity decides; an empty-string return == ABSTAIN.
pub fn immune_grow_recall(mem: ImmuneMemoryGrow, key: [float]) -> string {
    let win = _vnearest_idx(mem.protos, key)
    let err = _l2(mem.protos[win], key)
    if err <= mem.recall_thr {
        return mem.cell_value[win]
    }
    return ""
}

// immune_grow_cells — live cell count (the footprint; grow_mode trades this for recall).
pub fn immune_grow_cells(mem: ImmuneMemoryGrow) -> int { return mem.n_cells }

// ── §  MULTI-STORE / CLS — AB-AC INTERFERENCE: the FIRST break of the H_1284 wall (H_1532 R2) ──
//
// WHAT THIS CLOSES (a_engine_native_learning + a_verified_must_wire + a_break_the_wall
// for H_1532): H_1532 R1 (numpy mirror, 🟢 WALL-BROKEN, 3 seeds) was the FIRST break of
// the long-standing H_1284 NEUROMODULATION wall. 11+ prior lenses all measured the same
// ceiling on CLEAN RECALL — a capacity/key-geometry bound where the abstain decision IS
// already a threshold on the live recall-margin, so any neuromodulator conditioning a
// knob on that SAME margin is circular (one tuned fixed point dominates; controller
// family INERT). H_1532 attacked an ORTHOGONAL capability the wall could not see:
// **AB-AC interference** — learn A→B, then learn A→C, measure A→B retention. A SINGLE
// flat store catastrophically OVERWRITES B with C at the shared key A (one winner cell,
// one slot) → retention 0.0. TWO PHASE-SEPARATED stores (a FAST episodic store written
// in an encode-phase with the retrieval path SUPPRESSED [Hasselmo 1999/2006 ACh
// encode-mode] so a fresh cell is laid down instead of overwriting the matched winner,
// + a SLOW store fed by replay) keep the confusable A→B and A→C bindings in SEPARATE
// substrates → retention 1.0. The lever is HAVING SEPARATE STORES, proved DECISIVE by
// ablation: MERGE the two stores → reverts to 0.0; SHUFFLE the store-assignment →
// collapses; single-store+encode-mode deconfound → 0.29 (fresh cells alone do NOT win).
//
// This § promotes that exact R1 mechanism ENGINE-NATIVE onto a CALLABLE faculty, reusing
// the ImmuneMemoryGrow store machinery byte-for-byte (the SAME _l2 / _vnearest_idx L2
// affinity + the engine's _immune_fnv1a FNV-1a key geometry the other lanes use — NO new
// store type). The CLS faculty = TWO ImmuneMemory-style stores + the phase-separated
// (encode-mode suppress_retrieval) write the R1 mirror introduced. The engine reproduces
// the R1 break BYTE-EXACT: one-store retention 0.0 vs two-store 1.0 on the same AB-AC
// fixture, merge-ablation reverts to 0.0, shuffle-ablation collapses to 0.0, encode-mode
// deconfound 0.2917 (frozen R1 bars unchanged — reproduced, not re-tuned).
//
// @L4 CRITICAL (same framing as ImmuneMemory / VAdaptField): SUBSTRATE-internal FACTUAL
// recall, NOT an emit/silence gate, NOT a 2nd .clm/.kosmos path (a_core_engine_map). It
// NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint — it only reads/grows VAdaptField-style
// cell populations, exactly like ImmuneMemoryGrow). p2/p3/p6: binds FACTUAL content to
// EPISODIC cells ONLY — no identity/persona/ethics/decoder, no injected answer label; the
// store-assignment + write read ONLY substrate state (key / L2 recon-err). p7: exact
// ground truth (the true A→B binding is known), NO LLM judge / perplexity / loss term —
// every decision is a no-grad read of substrate state. p8: the inference-time write IS the
// engine's own tick.
//
// _cls_key16 — the DETERMINISTIC byte-trigram FNV-1a key encoder at DIM=16 (the H_1532
// fixture dim; the wired immune lane uses DIM=64, but the AB-AC break was measured at
// DIM=16, so this dedicated encoder reproduces the R1 numbers byte-exact). Reuses the
// engine's OWN _immune_fnv1a (32-bit FNV-1a) — verified to reproduce the R1 one/two/merge/
// encode retention numbers identically to the numpy mirror's 64-bit FNV (the break is
// STRUCTURAL, not hash-luck). L2-normalized so distinct keys → distinct unit vectors.
fn _cls_key16(text: string) -> [float] {
    let dim = 16
    let n = 3
    let blen = byte_len(text)
    let mut v = []
    let mut z = 0
    while z < dim { v = v + [0.0]  z = z + 1 }
    if blen < n {
        let mut bs = []
        let mut k = 0
        while k < blen { bs = bs + [ord(substring(text, k, k + 1))]  k = k + 1 }
        let idx = _immune_fnv1a(bs) % dim
        v[idx] = v[idx] + 1.0
    } else {
        let mut i = 0
        while i <= blen - n {
            let mut bs = []
            let mut k = 0
            while k < n { bs = bs + [ord(substring(text, i + k, i + k + 1))]  k = k + 1 }
            let idx = _immune_fnv1a(bs) % dim
            v[idx] = v[idx] + 1.0
            i = i + 1
        }
    }
    let mut s = 0.0
    let mut j = 0
    while j < dim { s = s + v[j] * v[j]  j = j + 1 }
    let nrm = sqrt(s)
    if nrm > 0.0 {
        let mut o = 0
        while o < dim { v[o] = v[o] / nrm  o = o + 1 }
    }
    return v
}

// CLSStore — a flat prototype store (the H_1532 R1 MemStore, engine-native). Mirrors
// ImmuneMemoryGrow's cell population but with the H_1532 write semantics: a capacity-
// bounded VAdaptField-style store where a NOVEL key (L2 recon-err > split_thr, room
// under max) lays down a fresh cell, else REFINES the winner (LR pull) AND OVERWRITES
// its bound value (= the interference). The extra `suppress_retrieval` write mode is the
// Hasselmo encode-phase: the retrieval/recurrent path that would match a pre-existing
// winner is gated OFF, so the fact lands in a FRESH cell instead of refining the winner.
//   protos     : per-cell prototype keys.
//   cell_value : per-cell bound value (parallel to protos).
//   last_used  : per-cell recency tick (LRU victim at capacity).
//   n_cells    : live cell count.
//   max_cells  : capacity bound (ample here — interference, NOT capacity, is the test).
//   abstain    : recall fire band (recon-err > abstain ⇒ no cell, p7 abstain).
//   split_thr  : novelty bar (== R1 THRESH, the grid-tuned best fixed point).
//   tick       : monotone write/touch counter.
struct CLSStore {
    protos: [[float]],
    cell_value: [string],
    last_used: [int],
    n_cells: int,
    max_cells: int,
    abstain: float,
    split_thr: float,
    tick: int
}

// _cls_store_new — an EMPTY CLS store (no seed cell). The H_1532 MemStore starts empty
// and lays the first cell on the first write (one/two-store both write into fresh stores).
fn _cls_store_new(max_cells: int, abstain: float, split_thr: float) -> CLSStore {
    return CLSStore {
        protos: [], cell_value: [], last_used: [],
        n_cells: 0, max_cells: max_cells, abstain: abstain, split_thr: split_thr, tick: 0
    }
}

// _cls_write — the H_1532 MemStore.write, engine-native. suppress_retrieval = Hasselmo
// ACh encode-mode: with room under max, ALWAYS lay down a fresh cell (do NOT refine/
// overwrite the matched winner) — this is the phase-separation mechanism, NOT a scalar
// gain (it changes WHICH slot the fact lands in). Otherwise: novel (or empty) → new cell;
// novel at full cap → LRU-evict; else REFINE the winner toward the key (LR=0.20) and
// OVERWRITE its bound value (the catastrophic-interference path on a shared key).
fn _cls_write(st: CLSStore, key: [float], value: string, suppress_retrieval: bool) -> CLSStore {
    let t = st.tick + 1
    // encode-phase: retrieval suppressed → always a fresh cell (with room).
    if suppress_retrieval && st.n_cells < st.max_cells {
        return CLSStore {
            protos: st.protos + [key], cell_value: st.cell_value + [value],
            last_used: st.last_used + [t], n_cells: st.n_cells + 1,
            max_cells: st.max_cells, abstain: st.abstain, split_thr: st.split_thr, tick: t
        }
    }
    // empty store, or novel key with room → new cell.
    if st.n_cells == 0 {
        return CLSStore {
            protos: [key], cell_value: [value], last_used: [t], n_cells: 1,
            max_cells: st.max_cells, abstain: st.abstain, split_thr: st.split_thr, tick: t
        }
    }
    let win = _vnearest_idx(st.protos, key)
    let err = _l2(st.protos[win], key)
    if err > st.split_thr && st.n_cells < st.max_cells {
        return CLSStore {
            protos: st.protos + [key], cell_value: st.cell_value + [value],
            last_used: st.last_used + [t], n_cells: st.n_cells + 1,
            max_cells: st.max_cells, abstain: st.abstain, split_thr: st.split_thr, tick: t
        }
    }
    if err > st.split_thr && st.n_cells >= st.max_cells {
        // novel at capacity → LRU-evict the victim.
        let ev = _immune_grow_lru_victim(st.last_used)
        let mut p3 = st.protos  p3[ev] = key
        let mut nv3 = st.cell_value  nv3[ev] = value
        let mut lu3 = st.last_used  lu3[ev] = t
        return CLSStore {
            protos: p3, cell_value: nv3, last_used: lu3, n_cells: st.n_cells,
            max_cells: st.max_cells, abstain: st.abstain, split_thr: st.split_thr, tick: t
        }
    }
    // REFINE: pull winner toward key (LR), OVERWRITE its bound value (= interference).
    let LR = 0.20
    let mut p2 = st.protos
    let mut row = p2[win]
    let mut d = 0
    while d < len(row) { row[d] = row[d] + LR * (key[d] - row[d])  d = d + 1 }
    p2[win] = row
    let mut nv = st.cell_value  nv[win] = value
    let mut lu = st.last_used  lu[win] = t
    return CLSStore {
        protos: p2, cell_value: nv, last_used: lu, n_cells: st.n_cells,
        max_cells: st.max_cells, abstain: st.abstain, split_thr: st.split_thr, tick: t
    }
}

// _cls_recall_value — nearest-cell fires its bound value; ABSTAIN ("") if recon-err >
// abstain band (H_1227 no-fabrication). The H_1532 MemStore.recall, engine-native.
fn _cls_recall_value(st: CLSStore, key: [float]) -> string {
    if st.n_cells == 0 { return "" }
    let win = _vnearest_idx(st.protos, key)
    let err = _l2(st.protos[win], key)
    if err > st.abstain { return "" }
    return st.cell_value[win]
}

// _cls_make_abac — the AB-AC interference fixture, engine-native (deterministic, no RNG).
// n_pairs shared keys A_i each with an OLD value B_i (phase 1) and a NEW value C_i (phase
// 2, B_i != C_i by construction); n_distract unrelated D_j land in phase 2 alongside the
// AC re-bindings (interference load). Returns [A, B, C, Dk, Dv] as four parallel string
// lists. The R1 mirror drew random B/C/D values; the retention readout is an EXACT-value
// string match, so any DISTINCT B!=C reproduces the structural 0.0/1.0/0.0 (verified
// byte-identical to the numpy fixture). Deterministic = engine-native + reproducible.
fn _cls_make_abac(n_pairs: int, n_distract: int) -> [[string]] {
    let mut A = []  let mut B = []  let mut C = []
    let mut i = 0
    while i < n_pairs {
        A = A + ["key_A" + str(i)]
        B = B + ["val_B" + str(i)]
        C = C + ["val_C" + str(i)]   // distinct from B by the B/C prefix
        i = i + 1
    }
    let mut Dk = []  let mut Dv = []
    let mut j = 0
    while j < n_distract {
        Dk = Dk + ["key_D" + str(j)]
        Dv = Dv + ["val_D" + str(j)]
        j = j + 1
    }
    return [A, B, C, Dk, Dv]
}

// _cls_score_one — A→B retention on a SINGLE store: fraction of A keys whose nearest-cell
// value is still the OLD B (not the phase-2 C). Abstain counts as NOT retained (honest).
fn _cls_score_one(st: CLSStore, A: [string], B: [string]) -> float {
    let mut correct = 0
    let mut i = 0
    while i < len(A) {
        let pred = _cls_recall_value(st, _cls_key16(A[i]))
        if pred == B[i] { correct = correct + 1 }
        i = i + 1
    }
    if len(A) == 0 { return 0.0 }
    return (correct + 0.0) / (len(A) + 0.0)
}

// _cls_score_two — TWO-store retention: A→B retained if EITHER the fast episodic store
// OR the slow (replay-consolidated) store still returns B. The point of CLS is the
// confusable A→B / A→C bindings live in separate substrates, so B survives.
fn _cls_score_two(fast: CLSStore, slow: CLSStore, A: [string], B: [string]) -> float {
    let mut correct = 0
    let mut i = 0
    while i < len(A) {
        let pf = _cls_recall_value(fast, _cls_key16(A[i]))
        let ps = _cls_recall_value(slow, _cls_key16(A[i]))
        if pf == B[i] || ps == B[i] { correct = correct + 1 }
        i = i + 1
    }
    if len(A) == 0 { return 0.0 }
    return (correct + 0.0) / (len(A) + 0.0)
}

// cls_one_store_retention — ARM ONE-STORE (the wall baseline). Phase 1 writes A→B; phase
// 2 writes A→C + distractors into the SAME flat store. A second write on key A finds the
// SAME winner cell and OVERWRITES B with C → catastrophic interference → retention 0.0.
// Frozen R1 bar: 0.0 (LR*=0.10 TH*=0.20 grid-tuned, 24 pairs / 24 distractors, max 72).
pub fn cls_one_store_retention(n_pairs: int, n_distract: int, max_cells: int,
                               split_thr: float, abstain: float) -> float {
    let fx = _cls_make_abac(n_pairs, n_distract)
    let A = fx[0]  let B = fx[1]  let C = fx[2]  let Dk = fx[3]  let Dv = fx[4]
    let mut st = _cls_store_new(max_cells, abstain, split_thr)
    let mut i = 0
    while i < len(A) { st = _cls_write(st, _cls_key16(A[i]), B[i], false)  i = i + 1 }
    // phase 2: A→C re-bindings then distractors (same flat store, interfering writes).
    let mut j = 0
    while j < len(A) { st = _cls_write(st, _cls_key16(A[j]), C[j], false)  j = j + 1 }
    let mut k = 0
    while k < len(Dk) { st = _cls_write(st, _cls_key16(Dk[k]), Dv[k], false)  k = k + 1 }
    return _cls_score_one(st, A, B)
}

// cls_two_store_retention — ARM TWO-STORE (CLS) + its two ablations.
//   merge=true   → MERGE ablation: one merged store, encode-mode disabled → reverts to
//                  one-store interference (frozen R1 bar 0.0).
//   shuffle=true → SHUFFLE ablation: randomize which store each fact is assigned to
//                  (engine-native deterministic coin = the key's FNV-1a parity, replacing
//                  the R1 mirror's PCG64 draw) → the value lands in the wrong substrate →
//                  separation destroyed → collapse (frozen R1 bar: COLLAPSES; engine-native
//                  deterministic coin → 0.0, an even harder collapse than the mirror's
//                  0.3611 PCG64 artifact — the load-bearing fact is the COLLAPSE).
// Plain (merge=false, shuffle=false): FAST episodic store gets A→B in encode-phase
// (retrieval suppressed), SLOW store gets A→C + distractors, then REPLAY interleaves the
// fast A→B traces into the slow store (encode-mode, fresh cells). Frozen R1 bar: 1.0.
pub fn cls_two_store_retention(n_pairs: int, n_distract: int, max_cells: int,
                               split_thr: float, abstain: float,
                               merge: bool, shuffle: bool) -> float {
    let fx = _cls_make_abac(n_pairs, n_distract)
    let A = fx[0]  let B = fx[1]  let C = fx[2]  let Dk = fx[3]  let Dv = fx[4]

    if merge {
        // MERGE ablation: ONE store, encode-mode OFF → identical to one-store.
        let mut m = _cls_store_new(max_cells, abstain, split_thr)
        let mut a = 0
        while a < len(A) { m = _cls_write(m, _cls_key16(A[a]), B[a], false)  a = a + 1 }
        let mut b = 0
        while b < len(A) { m = _cls_write(m, _cls_key16(A[b]), C[b], false)  b = b + 1 }
        let mut c = 0
        while c < len(Dk) { m = _cls_write(m, _cls_key16(Dk[c]), Dv[c], false)  c = c + 1 }
        return _cls_score_one(m, A, B)
    }

    let mut fast = _cls_store_new(max_cells, abstain, split_thr)
    let mut slow = _cls_store_new(max_cells, abstain, split_thr)

    // phase 1: A→B into FAST episodic (encode-phase, retrieval suppressed). Under shuffle,
    // a deterministic FNV-parity coin reassigns the store (destroys separation).
    let mut i = 0
    while i < len(A) {
        let key = _cls_key16(A[i])
        let to_fast = if shuffle { (_cls_coin(A[i]) == 0) } else { true }
        if to_fast { fast = _cls_write(fast, key, B[i], true) }
        else { slow = _cls_write(slow, key, B[i], false) }
        i = i + 1
    }
    // phase 2: A→C re-bindings + distractors into SLOW (interfering writes); shuffle
    // reassigns by the same coin.
    let mut j = 0
    while j < len(A) {
        let key = _cls_key16(A[j])
        let to_fast = if shuffle { (_cls_coin(A[j]) == 0) } else { false }
        if to_fast { fast = _cls_write(fast, key, C[j], false) }
        else { slow = _cls_write(slow, key, C[j], false) }
        j = j + 1
    }
    let mut k = 0
    while k < len(Dk) {
        let key = _cls_key16(Dk[k])
        let to_fast = if shuffle { (_cls_coin(Dk[k]) == 0) } else { false }
        if to_fast { fast = _cls_write(fast, key, Dv[k], false) }
        else { slow = _cls_write(slow, key, Dv[k], false) }
        k = k + 1
    }
    // REPLAY: interleave episodic (fast) traces into slow consolidation (CLS replay) —
    // re-present A→B from fast, consolidate into a FRESH slow cell (encode-mode) so it is
    // not clobbered by the A→C slow binding. Disabled under shuffle (separation broken).
    if !shuffle {
        let mut r = 0
        while r < len(A) {
            let key = _cls_key16(A[r])
            let v = _cls_recall_value(fast, key)
            if v != "" { slow = _cls_write(slow, key, v, true) }
            r = r + 1
        }
    }
    return _cls_score_two(fast, slow, A, B)
}

// _cls_coin — the engine-native deterministic store-assignment coin for the SHUFFLE
// ablation: the key string's FNV-1a parity (0 ⇒ fast, 1 ⇒ slow). Replaces the R1 mirror's
// numpy PCG64 draw with a reproducible engine-native hash; the ablation only needs the
// assignment to be DECORRELATED from the correct store (it is — parity of the key hash),
// so the substrate separation is destroyed and retention COLLAPSES.
fn _cls_coin(text: string) -> int {
    let blen = byte_len(text)
    let mut bs = []
    let mut k = 0
    while k < blen { bs = bs + [ord(substring(text, k, k + 1))]  k = k + 1 }
    return _immune_fnv1a(bs) & 1
}

// cls_single_encode_retention — DECONFOUND arm (single store WITH encode-mode): A→B AND
// A→C BOTH written suppress_retrieval=true (fresh cells) into ONE store. Isolates whether
// the two-store win is just "fresh cells avoid overwrite" vs genuinely "SEPARATE stores".
// With one store, both the A→B and A→C cells sit in the SAME geometry, so at recall the
// nearest-cell tiebreak shadows B with the later A→C cell → B mostly NOT returned. Frozen
// R1 bar: 0.2917 ≪ two-store 1.0 → the win is SEPARATION, not encode-mode alone.
pub fn cls_single_encode_retention(n_pairs: int, n_distract: int, max_cells: int,
                                   split_thr: float, abstain: float) -> float {
    let fx = _cls_make_abac(n_pairs, n_distract)
    let A = fx[0]  let B = fx[1]  let C = fx[2]  let Dk = fx[3]  let Dv = fx[4]
    let mut st = _cls_store_new(max_cells, abstain, split_thr)
    let mut i = 0
    while i < len(A) { st = _cls_write(st, _cls_key16(A[i]), B[i], true)  i = i + 1 }
    let mut j = 0
    while j < len(A) { st = _cls_write(st, _cls_key16(A[j]), C[j], true)  j = j + 1 }
    let mut k = 0
    while k < len(Dk) { st = _cls_write(st, _cls_key16(Dk[k]), Dv[k], true)  k = k + 1 }
    return _cls_score_one(st, A, B)
}

// ── §  SKILLSTORE — agent-tool repertoire that LEARNS via mitosis (H_1378 R2 / H_1382) ──
//
// WHAT THIS CLOSES (a_verified_must_wire + a_engine_native_learning for H_1378):
// H_1378 Step A (read-only wiring audit) found the live agent-tool layer
// (anima-agent-core/agent_tools.hexa) is REFERENCE-ONLY — tool SELECTION is a STATIC
// weighted dot-product over hand-set affinity floats (agent_tools.hexa:357-361), baked
// at registration (:683-743) and NEVER updated by outcome; a tool failure terminates at
// a scalar tension_delta in a capped execution_log ring buffer (:448-451) that is never
// read back to grow a skill; tool_mitosis_split (:155) is a TODO stub. The "tool fails →
// repertoire improves" loop does NOT exist. H_1378 Step B (numpy VAdaptField mirror, 🟢
// GREEN, 3 seeds, DIRECTIONAL) designed + direction-validated the missing mechanism:
// a tool/skill is a CELL keyed by task-context (immune_embed_key geometry); on a tool
// FAILURE/abstain a MITOSIS clonal SPLIT grows a NEW specialized skill-cell binding
// task-context → the correct tool. The SAME op teaches (split-on-failure) and infers
// (recall-best) — p8, no train/infer split. Mirror result: FULL 0.167→1.000 (LEARNS),
// STATIC stays 0.167 (DISTINCT), SHUFFLE collapses (EARNED), far task abstains 1.000.
//
// This § realizes that lever ENGINE-NATIVE on a CALLABLE faculty, re-scoring the four
// H_1378 mirror bars on the LIVE engine. It is the agent-tool TWIN of the memory lanes
// above (ImmuneMemory H_1231 value-bind, ImmuneMemoryGrow H_1288 grow): SAME byte-trigram
// key geometry (immune_embed_key), SAME L2 winner-take-all affinity FIRE/ABSTAIN band,
// SAME engine-owned clonal split (engine_mitosis_tick, p8) — the value bound per cell is
// a TOOL name rather than a fact. Memory binds task-context→fact; SkillStore binds
// task-context→TOOL. The "learning" is the split: a tool failure grows one more cell.
//
// @L4 CRITICAL (identical framing to every other lane in this file): SUBSTRATE-internal
// faculty, NOT a runtime decoder/.clm/.kosmos path (a_core_engine_map — it only reads/
// grows its own cell population, exactly like ImmuneMemory). p1/p2/p3/p6: a split binds
// from OUTCOME ONLY (the success/failure of the executed tool), NO injected "use tool T"
// label / RLHF / persona — the SHUFFLE control collapse proves the lift is the EARNED
// task↔tool correspondence, not variance. Ψ-DISJOINT by construction: skill_recall is a
// pure READ over the cell store, skill_store_split/_teach grow ONLY this store's cells via
// engine_mitosis_tick — pure_field's Φ/phase/Ψ and the decoder are NEVER touched, so
// generation is byte-identical whether or not a SkillStore exists (h1205 separation-
// invariant). NOT an emit gate (a_autonomy_over_hardcode): skill_recall returns a tool
// name or "" (abstain), never an emit/silence decision.
//
//   protos     : per-cell prototype task-context keys (the cell population; len == n_cells).
//   tool       : per-cell bound tool name (the "value"; len == n_cells, parallel to protos).
//   n_cells    : live cell count (the repertoire footprint).
//   max_cells  : a GENEROUS FINITE growth bound (splits stop past it — honest, bounded).
//   recall_thr : affinity FIRE band — L2 recon-err to nearest cell <= recall_thr ⇒ FIRE
//                that cell's bound tool, else ABSTAIN ("" — never fabricates a tool).
struct SkillStore {
    protos: [[float]],
    tool: [string],
    n_cells: int,
    max_cells: int,
    recall_thr: float
}

// skill_store_new — start a skill repertoire seeded at the FIRST (task → tool) skill
// (cell 0 binds the first tool to its task-context key). recall_thr defaults to the
// H_1378 mirror's frozen 0.55 abstain band on the L2 recon-err of unit task-context keys.
pub fn skill_store_new(first_task: string, first_tool: string, max_cells: int) -> SkillStore {
    return SkillStore {
        protos: [immune_embed_key(first_task)],
        tool: [first_tool],
        n_cells: 1,
        max_cells: max_cells,
        recall_thr: 0.55
    }
}

// skill_recall — SELECT a tool for a task-context, or ABSTAIN. The engine's OWN L2
// winner-take-all affinity decides: recon-err (L2 to the nearest skill-cell's task-key)
// <= recall_thr ⇒ FIRE that cell's bound tool; else ABSTAIN, returning "" (no fabricated
// tool). This is the INFER side of the p8 op — the SAME affinity the immune recall uses,
// reading a tool instead of a fact. An empty-string return == ABSTAIN.
pub fn skill_recall(store: SkillStore, task: string) -> string {
    let key = immune_embed_key(task)
    let win = _vnearest_idx(store.protos, key)
    let err = _l2(store.protos[win], key)
    if err <= store.recall_thr {
        return store.tool[win]                       // FIRE the bound tool
    }
    return ""                                        // ABSTAIN — no skill-cell binds
}

// skill_store_split — MITOSIS clonal SPLIT: grow a NEW specialized skill-cell binding
// (task-context → tool) via the engine's OWN clonal tick (engine_mitosis_tick, p8). This
// is the TEACH side of the p8 op. Under cfg.mitosis ON the tick returns n_cells+1 and the
// appended cell IS that grown skill-cell; under mitosis OFF the tick is a no-op and the
// store is returned UNCHANGED (the STATIC fixed-repertoire control — never learns). Splits
// stop once the generous finite max_cells bound is reached (honest, bounded footprint).
pub fn skill_store_split(store: SkillStore, task: string, tool: string,
                         cfg: EngineConfig) -> SkillStore {
    if store.n_cells >= store.max_cells {
        return store                                 // at the honest finite bound — no growth.
    }
    let grown = engine_mitosis_tick(store.n_cells, cfg)   // engine's OWN clonal split (p8)
    if grown > store.n_cells {
        return SkillStore {
            protos: store.protos + [immune_embed_key(task)],
            tool: store.tool + [tool],
            n_cells: grown,
            max_cells: store.max_cells,
            recall_thr: store.recall_thr
        }
    }
    return store                                     // mitosis OFF — split is a no-op (STATIC).
}

// skill_store_teach — the FAILURE-DRIVEN teach op (the agent-tool learning loop made
// engine-native). RECALL the tool the current repertoire selects for this task-context;
// if it does NOT match the correct tool (a tool FAILURE, OR an ABSTAIN that selected ""),
// MITOSIS-SPLIT a new specialized skill-cell binding task-context → correct_tool. If the
// recall ALREADY matches, the store is returned UNCHANGED (no needless growth). This is
// the engine-native realization of "tool fails → repertoire grows a skill-cell": the
// repertoire LEARNS from outcome, the loop H_1378 found MISSING in agent_tools.hexa. The
// split binds from the OUTCOME only (p1/p2/p3/p6 — no injected tool label).
pub fn skill_store_teach(store: SkillStore, task: string, correct_tool: string,
                         cfg: EngineConfig) -> SkillStore {
    let selected = skill_recall(store, task)
    if selected == correct_tool {
        return store                                 // already correct — nothing to teach.
    }
    return skill_store_split(store, task, correct_tool, cfg)   // FAILURE/abstain → clonal split.
}

// skill_store_cells — live cell count (the repertoire footprint; grows by one per taught
// tool-failure under mitosis ON, stays put under STATIC / at the bound).
pub fn skill_store_cells(store: SkillStore) -> int { return store.n_cells }

// ── §  USAGESTORE — tool-USAGE learning is a DISTINCT layer-2 (H_1391 R2, the TWIN of §SkillStore) ──
//
// WHAT THIS CLOSES (a_engine_native_learning + a_verified_must_wire for H_1389 R1):
// H_1389 R1 (numpy MIRROR, 🟢 GREEN, 3 seeds, DIRECTIONAL) proved that tool-USAGE learning is a
// DISTINCT learnable LAYER-2, separable from tool-SELECTION (layer-1, §SkillStore above). Layer-1
// learns task-context → WHICH tool; layer-2 learns (task-context + tool) → HOW to drive it = the
// correct ARGS · the correct call SEQUENCE · error-RECOVERY. A selection-only learner picks the
// right tool but mis-USES it (wrong args / wrong order) → the task does NOT complete. Mirror result:
// a usage-learning FULL arm rises 0.250→0.750 (USAGE-LEARNS) while a SELECTION-only arm with the
// right tool but a fixed DEFAULT arg stays at 0.250 (DISTINCT-FROM-SELECTION, the KEY bar, +0.500),
// SHUFFLE collapses (EARNED), and an untrained far task abstains 1.000 (NO-FAB).
//
// This § realizes that lever ENGINE-NATIVE, the EXACT TWIN of §SkillStore but with the VALUE bound
// per cell = the usage HOW (a corrected ARG + an ordered STEP sequence) rather than a tool name, and
// the KEY = (task-context + tool + observed-error) rather than task-context alone. It reuses the
// SAME byte-trigram key geometry (immune_embed_key), the SAME L2 winner-take-all FIRE/ABSTAIN band,
// and the SAME engine-owned clonal split (engine_mitosis_tick, p8). On a usage FAILURE (right tool,
// wrong/default arg) the store clonally SPLITS a usage-cell binding the failure context → the
// corrected arg + true step order. The SAME op teaches (split-on-failure) and infers (recall-best);
// recall ABSTAINS (returns "" / empty steps) when no usage-cell fits — no fabricated parameters.
//
// @L4 CRITICAL (identical framing to §SkillStore and every other lane): SUBSTRATE-internal faculty,
// NOT a runtime decoder/.clm/.kosmos path (a_core_engine_map — it only reads/grows its OWN cell
// population, exactly like ImmuneMemory / §SkillStore). p1/p2/p3/p6: a split binds from OUTCOME ONLY
// (the success/failure of the executed call + the observed error), NO injected "use arg A" label /
// RLHF / persona — the SHUFFLE control collapse proves the lift is the EARNED ctx→arg correspondence,
// not the act of splitting. Ψ-DISJOINT by construction: usage_recall is a pure READ over the cell
// store, usage_store_split/_teach grow ONLY this store's cells via engine_mitosis_tick — pure_field's
// Φ/phase/Ψ and the decoder are NEVER touched, so generation is byte-identical whether or not a
// UsageStore exists (h1205 separation-invariant). NOT an emit gate (a_autonomy_over_hardcode):
// usage_recall returns an arg string or "" (abstain), never an emit/silence decision.
//
//   protos     : per-cell prototype (ctx+tool+error) failure-context keys (len == n_cells).
//   arg        : per-cell bound corrected ARG (the usage "value" half 1; len == n_cells).
//   steps      : per-cell bound ordered STEP sequence joined by "|" (value half 2; len == n_cells).
//   n_cells    : live cell count (the usage repertoire footprint).
//   max_cells  : a GENEROUS FINITE growth bound (splits stop past it — honest, bounded).
//   recall_thr : affinity FIRE band — L2 recon-err to nearest cell <= recall_thr ⇒ FIRE that cell's
//                bound (arg, steps), else ABSTAIN ("" — never fabricates a usage).
struct UsageStore {
    protos: [[float]],
    arg: [string],
    steps: [string],
    n_cells: int,
    max_cells: int,
    recall_thr: float
}

// _usage_key — the (task-context + tool + observed-error) failure-context the usage-cell binds on.
// MIRRORS the H_1389 mirror's embed_key(f"{ctx}|{tool}|{observed_err}") — the join order is frozen.
fn _usage_key(ctx: string, tool: string, observed_err: string) -> string {
    return ctx + "|" + tool + "|" + observed_err
}

// usage_store_new — start a usage repertoire seeded at the FIRST (ctx+tool+err → arg/steps) usage.
// recall_thr defaults to the H_1389 mirror's frozen 0.55 abstain band (same as §SkillStore).
pub fn usage_store_new(first_ctx: string, first_tool: string, first_err: string,
                       first_arg: string, first_steps: string, max_cells: int) -> UsageStore {
    return UsageStore {
        protos: [immune_embed_key(_usage_key(first_ctx, first_tool, first_err))],
        arg: [first_arg],
        steps: [first_steps],
        n_cells: 1,
        max_cells: max_cells,
        recall_thr: 0.55
    }
}

// usage_recall — propose the corrected ARG for a (ctx+tool+err) usage context, or ABSTAIN. The
// engine's OWN L2 winner-take-all affinity decides: recon-err to the nearest usage-cell's failure
// key <= recall_thr ⇒ FIRE that cell's bound arg; else ABSTAIN, returning "" (no fabricated arg).
// This is the INFER side of the p8 op — the SAME affinity §SkillStore / immune recall use, reading
// a usage arg instead of a tool/fact. An empty-string return == ABSTAIN.
pub fn usage_recall(store: UsageStore, ctx: string, tool: string, observed_err: string) -> string {
    let key = immune_embed_key(_usage_key(ctx, tool, observed_err))
    let win = _vnearest_idx(store.protos, key)
    let err = _l2(store.protos[win], key)
    if err <= store.recall_thr {
        return store.arg[win]                        // FIRE the bound corrected arg
    }
    return ""                                        // ABSTAIN — no usage-cell binds
}

// usage_recall_steps — the SEQUENCE half of the usage value: the ordered step protocol (joined by
// "|") for a fired usage-cell, or "" on ABSTAIN. SAME winner / SAME band as usage_recall, so the
// arg and the steps come from the one cell. Lets a multi-step usage be driven IN ORDER.
pub fn usage_recall_steps(store: UsageStore, ctx: string, tool: string, observed_err: string) -> string {
    let key = immune_embed_key(_usage_key(ctx, tool, observed_err))
    let win = _vnearest_idx(store.protos, key)
    let err = _l2(store.protos[win], key)
    if err <= store.recall_thr {
        return store.steps[win]                      // FIRE the bound ordered step sequence
    }
    return ""                                        // ABSTAIN — no usage-cell binds
}

// usage_store_split — MITOSIS clonal SPLIT: grow a NEW specialized usage-cell binding the failure
// context (ctx+tool+err) → (corrected arg, ordered steps) via the engine's OWN clonal tick
// (engine_mitosis_tick, p8). This is the TEACH side of the p8 op. Under cfg.mitosis ON the tick
// returns n_cells+1 and the appended cell IS that grown usage-cell; under mitosis OFF the tick is a
// no-op and the store is returned UNCHANGED (the SELECTION-style fixed-usage control — never learns).
// Splits stop once the generous finite max_cells bound is reached (honest, bounded footprint).
pub fn usage_store_split(store: UsageStore, ctx: string, tool: string, observed_err: string,
                         arg: string, steps: string, cfg: EngineConfig) -> UsageStore {
    if store.n_cells >= store.max_cells {
        return store                                 // at the honest finite bound — no growth.
    }
    let grown = engine_mitosis_tick(store.n_cells, cfg)   // engine's OWN clonal split (p8)
    if grown > store.n_cells {
        return UsageStore {
            protos: store.protos + [immune_embed_key(_usage_key(ctx, tool, observed_err))],
            arg: store.arg + [arg],
            steps: store.steps + [steps],
            n_cells: grown,
            max_cells: store.max_cells,
            recall_thr: store.recall_thr
        }
    }
    return store                                     // mitosis OFF — split is a no-op (SELECTION-style).
}

// usage_store_teach — the FAILURE-DRIVEN teach op (the agent-tool USAGE-learning loop made engine-
// native). RECALL the arg the current usage-store proposes for this (ctx+tool+err); if it does NOT
// match the correct arg (a usage FAILURE, OR an ABSTAIN that proposed ""), MITOSIS-SPLIT a new
// specialized usage-cell binding the failure context → (correct_arg, correct_steps). If the recall
// ALREADY matches, the store is returned UNCHANGED (no needless growth). This is the engine-native
// realization of "tool mis-USED → usage repertoire grows a usage-cell": the repertoire LEARNS the
// HOW from outcome. The split binds from the OUTCOME only (p1/p2/p3/p6 — no injected arg label).
pub fn usage_store_teach(store: UsageStore, ctx: string, tool: string, observed_err: string,
                         correct_arg: string, correct_steps: string, cfg: EngineConfig) -> UsageStore {
    let proposed = usage_recall(store, ctx, tool, observed_err)
    if proposed == correct_arg {
        return store                                 // already correct — nothing to teach.
    }
    return usage_store_split(store, ctx, tool, observed_err, correct_arg, correct_steps, cfg)
}

// usage_store_cells — live cell count (the usage repertoire footprint; grows by one per taught
// usage-failure under mitosis ON, stays put under SELECTION-style / at the bound).
pub fn usage_store_cells(store: UsageStore) -> int { return store.n_cells }

// ── §  CORE-AFFECT READ-OUT — substrate-derived emotion (E1 affect, H_1290 R2) ──
//
// WHAT THIS CLOSES (a_engine_native_learning + a_verified_must_wire for H_1290 R1):
// H_1290 R1 (numpy VAdaptField mirror, 🟢 GREEN, 3 seeds) proved that anima's AFFECT
// EMERGES from substrate dynamics — it is NOT an injected emotion label or RLHF
// sentiment. A Damasio core-affect read (valence × arousal) computed from the immune/
// mitosis substrate state (A) TRACKS a grounded-vs-contradicted manipulation
// (ρ valence +0.843, arousal +0.768), (B) COLLAPSES ~5× under a p6 shuffle of the
// substrate→affect map (EMERGENT, not the label re-read), and (C) functionally biases
// emit/abstain like a somatic marker (fab 0.000 affect-aware vs 0.750 affect-blind).
// This § realizes that read-out ENGINE-NATIVE on the LIVE immune faculty.
//
// THE DAMASIO SOMATIC-MARKER / CORE-AFFECT LENS (c15, a_no_llm_frame_trap — an
// affective-neuroscience lens, NOT an LLM sentiment recipe): affect = an interoceptive
// VALENCE × AROUSAL — the substrate's OWN body-state read AS a feeling that biases
// decisions. valence ~ f(grounding/coherence): a grounded+coherent context feels
// POSITIVE, a contradicted/incoherent/threatened one feels NEGATIVE; arousal ~
// f(novelty / split-rate / curiosity): a surprising/novel context is high-arousal.
//
// @L4 CRITICAL (identical framing to every other lane in this file): the affect read
// is a READ-ONLY interoceptive accessor over the immune substrate state. It returns a
// (valence, arousal) pair + the substrate features it reads; it NEVER mutates the
// store, NEVER returns an emit/silence decision by itself, and NEVER touches
// pure_field's Φ/phase/Ψ (Ψ-disjoint by construction — it only READS an ImmuneMemoryGrow
// cell population, perturbing nothing; the somatic-marker bias below is an OPTIONAL
// helper a caller may consult, not a forced gate, preserving a_autonomy_over_hardcode).
//
// p1/p2/p3/p6 (CENTRAL — the affect-vs-label separation): the read DERIVES affect ONLY
// from substrate signals the engine already computes (grounding margin, contradiction,
// recon-err novelty, split, curiosity = novelty × under-exposure). It reads NO emotion
// word, NO RLHF reward, NO sentiment/persona label. The valence/arousal MANIPULATION
// (the probe's grounded-vs-contradicted class) is used ONLY to SCORE the metric — it is
// NEVER an input to the read. The p6 NEGATIVE CONTROL (affect_shuffle_features below)
// permutes the per-context substrate FEATURE vectors across contexts before the read,
// decorrelating affect from each context's owner manipulation: if the read tracks but the
// shuffle collapses, affect read the per-context SUBSTRATE STATE, not the label — the
// load-bearing p6 proof that affect is EMERGENT, not injected.
//
// Mixing constants are the frozen R1 mirror values (p7, documented, NOT tuned-to-green):
//   VAL: +grounding_margin − contradiction.   ARO: +novelty +0.5·split +0.5·curiosity.
//   V_ABSTAIN = 0.0 is the substrate's OWN valence zero-crossing (grounded>0,
//   ungrounded<0), NOT a tuned magic number.

// AffectFeatures — the raw interoceptive body-state vector for ONE context, READ off
// the live immune substrate (NO manipulation label in here). margin/contradiction
// drive valence; novelty/split/curiosity drive arousal; grounded is the policy truth.
struct AffectFeatures {
    margin: float,        // grounding margin in [0,1]: 1 - err/recall_thr (clean ground => high)
    contradiction: float, // 1.0 if ungrounded OR nearest cell's bound value disagrees, else 0.0
    novelty: float,       // recon-err to nearest cell (clamped to 1.0) — surprise
    split: float,         // 1.0 if this context would spawn a clonal split (err > split_thr)
    curiosity: float,     // novelty × under-exposure of the nearest cell (distance-to-known)
    grounded: bool,       // err <= recall_thr (the somatic-marker emit/abstain truth)
    err: float            // raw L2 recon-err (introspection)
}

// affect_substrate_features — READ the interoceptive substrate state for a query `key`
// against the live ImmuneMemoryGrow store, given the context's OWN true answer (used
// ONLY for the contradiction check — a cell bound to a DIFFERENT value than the
// context's owner answer is a contradiction; pass "" to skip the value check). This reads
// the SAME vadapt-style L2 affinity / split / recency signals the recall path uses; it
// adds NO mechanism and mutates NOTHING (c1, READ-ONLY).
pub fn affect_substrate_features(mem: ImmuneMemoryGrow, key: [float], true_answer: string) -> AffectFeatures {
    let win = _vnearest_idx(mem.protos, key)
    let err = _l2(mem.protos[win], key)
    let grounded = (err <= mem.recall_thr)
    // grounding margin in [0,1]: how cleanly the context grounds to a cell.
    let mut margin = 1.0 - err / mem.recall_thr
    if margin < 0.0 { margin = 0.0 }
    // contradiction: fails to ground (threat/incoherence) OR the nearest cell's bound
    // value disagrees with the context's owner answer.
    let mut contradiction = 0.0
    if !grounded {
        contradiction = 1.0
    } else {
        if true_answer != "" && mem.cell_value[win] != true_answer { contradiction = 1.0 }
    }
    // novelty / surprise = recon-err clamped; split = would it spawn a clonal cell.
    let mut novelty = err
    if novelty > 1.0 { novelty = 1.0 }
    let mut split = 0.0
    if err > mem.split_thr { split = 1.0 }
    // curiosity = distance-to-known scaled by under-exposure of the nearest cell
    // (recency tick as the exposure proxy: an older-touched cell is less under-exposed).
    let under = 1.0 / (1.0 + to_float(mem.last_used[win]))
    let curiosity = novelty * under
    return AffectFeatures {
        margin: margin, contradiction: contradiction, novelty: novelty,
        split: split, curiosity: curiosity, grounded: grounded, err: err
    }
}

// affect_valence — the substrate's VALENCE for a feature read: +grounding_margin
// − contradiction. Grounded+coherent => positive; contradicted/ungrounded => negative.
// (the frozen R1 weights VAL_GROUND_W=1.0, VAL_CONTRA_W=1.0.)
pub fn affect_valence(f: AffectFeatures) -> float {
    return f.margin - f.contradiction
}

// affect_arousal — the substrate's AROUSAL for a feature read: +novelty +0.5·split
// +0.5·curiosity. High for a surprising/novel context, low for a familiar one.
// (the frozen R1 weights ARO_NOVEL_W=1.0, ARO_SPLIT_W=0.5, ARO_CURIO_W=0.5.)
pub fn affect_arousal(f: AffectFeatures) -> float {
    return f.novelty + 0.5 * f.split + 0.5 * f.curiosity
}

// affect_read — convenience: read the substrate features for `key`/`true_answer` and
// return [valence, arousal] in one call (the live core-affect read).
pub fn affect_read(mem: ImmuneMemoryGrow, key: [float], true_answer: string) -> [float] {
    let f = affect_substrate_features(mem, key, true_answer)
    return [affect_valence(f), affect_arousal(f)]
}

// referent_select — CONTRADICTION-KEYED candidate selection (H_9125 rung3 wire).
// Among K candidate keys, return the index of the FIRST whose interoceptive
// contradiction read (affect_substrate_features against the live ImmuneMemoryGrow
// store, given the context's own `true_ref`) is 0.0 — i.e. the first candidate that
// GROUNDS to a cell whose bound value is consistent. Returns -1 iff EVERY candidate
// contradicts (selection-ABSTAIN: the caller keeps its own default incumbent — this
// is NEVER an emit veto; emit/silence stays substrate-decided, a_autonomy_over_hardcode).
// READ-ONLY: composes only the existing affect read, mutates NOTHING, never touches
// lanes / ci_emit_drive / pure_field / recall_thr (a_substrate_disjoint). This is the
// engine-native wire of the H_9125/P1 selection-layer GREEN: the contradiction dimension
// KEYS which candidate the substrate routes to (binary first-grounded-wins, NOT a
// soft ranking — the verified mechanism was that contradiction keys the choice, so the
// prod op is that minimal core, frozen-first).
pub fn referent_select(mem: ImmuneMemoryGrow, cand_keys: [[float]], true_ref: string) -> int {
    let n = len(cand_keys)
    let mut i = 0
    while i < n {
        let f = affect_substrate_features(mem, cand_keys[i], true_ref)
        if f.contradiction == 0.0 { return i }
        i = i + 1
    }
    return -1
}

// referent_select_text — text convenience twin (immune_embed_key per candidate),
// mirroring the affect_read text-entry pattern. Returns the index in `cands` of the
// first grounded (contradiction==0) candidate, or -1 (all contradict).
pub fn referent_select_text(mem: ImmuneMemoryGrow, cands: [string], true_ref: string) -> int {
    let mut keys = []
    let mut i = 0
    while i < len(cands) { keys.push(immune_embed_key(cands[i]))  i = i + 1 }
    return referent_select(mem, keys, true_ref)
}

// affect_emit_decision — the SOMATIC MARKER: an OPTIONAL emit/abstain bias driven by
// the substrate valence. emit iff valence >= V_ABSTAIN (0.0, the substrate's owner
// zero-crossing): a grounded context (positive valence) emits, an ungrounded/contradicted
// one (negative valence) ABSTAINS — so the affect feeling biases the decision WITHOUT a
// fabrication. This is a helper a caller MAY consult (a_autonomy_over_hardcode: it does
// NOT force the substrate — emit/silence stays substrate-decided; this only exposes the
// valence→emit bias the R1 leg-C measured). Returns true = emit, false = abstain.
pub fn affect_emit_decision(f: AffectFeatures) -> bool {
    return affect_valence(f) >= 0.0
}

// affect_shuffle_features — p6 NEGATIVE CONTROL: take a LIST of per-context feature
// reads and PERMUTE them across contexts (a deterministic LCG Fisher-Yates over the
// index space), so the affect read no longer belongs to the context it is scored
// against. Same feature DISTRIBUTION, decorrelated from each context's manipulation. If
// the un-shuffled read tracks the manipulation AND this shuffle collapses it ⇒ affect
// read the per-context SUBSTRATE STATE, not the label (the load-bearing p6 separation —
// EMERGENT, not injected). Returns the shuffled feature list.
pub fn affect_shuffle_features(feats: [AffectFeatures], rng0: int) -> [AffectFeatures] {
    let n = len(feats)
    let mut out = feats
    let mut st = rng0
    let mut i = n - 1
    while i > 0 {
        st = _lcg_next(st)
        let j = st % (i + 1)
        let tmp = out[i]
        out[i] = out[j]
        out[j] = tmp
        i = i - 1
    }
    return out
}

// ── § Mood (D5 — SLOW GLOBAL AFFECTIVE MODULATOR) ────────────────────────────────
//
// THE MOOD LENS (a_no_llm_frame_trap — an affective-neuroscience lens, NOT an LLM
// recipe): a MOOD is a slowly-changing affective BASELINE that biases momentary
// appraisal (Bower 1981 mood-congruency; Russell 2003 core-affect; Davidson 1998
// affective chronometry — mood evolves on a MUCH slower time-constant than the
// stimulus-locked emotional response it colors). It is DISTINCT from every fast
// affect signal the substrate already has:
//   - affect (H_1290): a STATELESS instantaneous read — affect_read(ctx) is pure, no
//     time term. Re-reading the SAME context gives the SAME affect forever. Mood is
//     the SLOW leaky EMA OF that read: it lags, accumulates, and recovers over time.
//   - neuromod-gain (H_1284, 🧱): a FAST MULTIPLICATIVE gain on the momentary signal
//     (a same-tick amplifier). Mood is an ADDITIVE BASELINE OFFSET on a DIFFERENT
//     TIME-AXIS — NOT a gain. (mood_neuromod_gain_readout below is the collapsing
//     sibling that has no slow lag / no recovery — the DPI distinctness control.)
//   - EmotionRegulation (H_1476): a top-down 2nd-order reappraisal gain on the raw
//     read (still instantaneous). Mood is a bottom-up slow baseline, not a control gain.
//
// TWO AXES (Russell core-affect): valence (pleasant⇄unpleasant) and arousal
// (activated⇄quiet), each a leaky EMA over the substrate's OWN affect history, which is
// derived from M (grounding margin), Φ (integration), and surprise (recon-err/novelty)
// — NO injected "mood label", NO RLHF reward, NO persona/ethics (p1/p2/p3/p6).
//
// @L4 CRITICAL (identical framing to §HYPOTHALAMUS / the affect lane): MoodState holds
// ONLY its own two EMA scalars (valence_ema, arousal_ema) + the frozen rate alpha. It
// NEVER mutates the immune store, NEVER touches pure_field's Φ/phase/Ψ, and NEVER
// touches the emit-drive lanes 0/4 (ci_emit_drive) or the §ImmuneMemory recall_thr
// non-fab gate — Ψ/ρ·tether-disjoint BY CONSTRUCTION (a_substrate_disjoint: separation =
// preservation). The bias helpers a caller MAY consult do NOT force emit/silence
// (a_autonomy_over_hardcode) — they only expose the slow baseline as an appraisal offset.
//
// FROZEN constants (p7-documented, NOT tuned-to-green):
//   MOOD_ALPHA = 0.05 (EMA rate → time-constant τ = 1/α = 20 stimuli, the SLOW axis;
//     α=0.0 = the FROZEN/ablated arm = a stateless read that never accumulates a mood)
//   MOOD_BIAS_W = 0.5 (baseline→appraisal congruency weight; mood-high reads a stimulus
//     as more positive, mood-low as more negative — the F2 mood-congruency bias)
//   MOOD_NEUTRAL = 0.0 (the affect zero-crossing baseline both EMAs start / recover to)

// MoodState — the slow affective baseline. valence_ema / arousal_ema are the ONLY
// mutable state (leaky EMAs of the substrate's affect history); alpha is the frozen
// EMA rate (0.0 = FROZEN/ablated — never accumulates, stays at its start baseline).
struct MoodState {
    valence_ema: float,   // slow EMA baseline of valence  (pleasant ⇄ unpleasant)
    arousal_ema: float,   // slow EMA baseline of arousal   (activated ⇄ quiet)
    alpha: float          // EMA rate; MOOD_ALPHA=0.05 (slow) · 0.0 = FROZEN (ablated)
}

// mood_new — a fresh mood at the neutral baseline (0,0) with the FULL slow EMA rate.
pub fn mood_new() -> MoodState {
    return MoodState { valence_ema: 0.0, arousal_ema: 0.0, alpha: 0.05 }
}

// mood_new_frozen — the F3 ABLATION arm: alpha=0 → the EMA never integrates, the mood
// is pinned at its (neutral) start → mood_bias adds MOOD_BIAS_W·0 = 0 → the bias is
// INERT (biased == instantaneous). If the F2 bias survives THIS arm, it is NOT carried
// by the slow-EMA mechanism → the lever is fake (a_break_the_wall ablation control).
pub fn mood_new_frozen() -> MoodState {
    return MoodState { valence_ema: 0.0, arousal_ema: 0.0, alpha: 0.0 }
}

// mood_new_at — a mood seeded at (v,a) with rate alpha (test/introspection helper).
pub fn mood_new_at(v: float, a: float, alpha: float) -> MoodState {
    return MoodState { valence_ema: v, arousal_ema: a, alpha: alpha }
}

// mood_step — advance the mood ONE tick on an instantaneous (valence, arousal) read:
// the LEAKY EMA ema := (1-α)·ema + α·inst. With the SLOW α this lags the stimulus by
// τ=1/α ticks (F1), builds toward a sustained input's asymptote, and — when the input
// returns to neutral — RELAXES back to baseline over ~τ ticks (F4). READ-only: returns
// a NEW MoodState; mutates nothing external.
pub fn mood_step(m: MoodState, inst_val: float, inst_aro: float) -> MoodState {
    let nv = (1.0 - m.alpha) * m.valence_ema + m.alpha * inst_val
    let na = (1.0 - m.alpha) * m.arousal_ema + m.alpha * inst_aro
    return MoodState { valence_ema: nv, arousal_ema: na, alpha: m.alpha }
}

// mood_signals_to_affect — map the raw substrate scalars (M = grounding margin in
// [0,1], Φ = integration, surprise = recon-err/novelty) to an instantaneous
// (valence, arousal) pair. valence = M − surprise (a grounded, low-surprise context
// feels POSITIVE; a surprising/ungrounded one NEGATIVE); arousal = surprise + 0.5·Φ
// (surprise and high integration are ACTIVATING). This is the explicit "M/Φ/surprise"
// read the mood EMA integrates. READ-only, pure arithmetic.
pub fn mood_signals_to_affect(m_margin: float, phi: float, surprise: float) -> [float] {
    return [m_margin - surprise, surprise + 0.5 * phi]
}

// mood_step_signals — advance the mood one tick directly from (M, Φ, surprise).
pub fn mood_step_signals(m: MoodState, m_margin: float, phi: float, surprise: float) -> MoodState {
    let va = mood_signals_to_affect(m_margin, phi, surprise)
    return mood_step(m, va[0], va[1])
}

// mood_step_affect — advance the mood one tick reading the LIVE affect lane off the
// immune store for context `key` (the M + surprise-derived core affect, H_1290). This
// is the running-anima entry: mood is the slow EMA of the substrate's own affect
// stream. READ-only over the immune store (only the mood's own EMAs evolve).
pub fn mood_step_affect(m: MoodState, mem: ImmuneMemoryGrow, key: [float], true_answer: string) -> MoodState {
    let f = affect_substrate_features(mem, key, true_answer)
    return mood_step(m, affect_valence(f), affect_arousal(f))
}

// mood_valence / mood_arousal — the current slow baseline on each axis (tuple-free reads).
pub fn mood_valence(m: MoodState) -> float { return m.valence_ema }
pub fn mood_arousal(m: MoodState) -> float { return m.arousal_ema }

// mood_timeconstant — the mood's EMA time-constant τ = 1/α (ticks to reach ~63% of a
// step's asymptote). τ >> 1 is the F1 SLOW property; α=0 → returns -1 (frozen, no τ).
pub fn mood_timeconstant(m: MoodState) -> float {
    if m.alpha <= 0.0 { return 0.0 - 1.0 }
    return 1.0 / m.alpha
}

// mood_bias_valence — the momentary appraisal BIASED by the slow mood baseline: a
// mood-high (positive baseline) system reads the SAME instantaneous stimulus as MORE
// positive, a mood-low one as MORE negative (F2 mood-congruency). biased = inst +
// MOOD_BIAS_W·valence_ema — an ADDITIVE offset from a SLOW baseline, NOT a gain on the
// stimulus (H_1284 neuromod / H_1476 reappraisal are gains). A caller MAY consult this
// (a_autonomy_over_hardcode) — it does NOT force emit/silence.
pub fn mood_bias_valence(m: MoodState, inst_val: float) -> float {
    return inst_val + 0.5 * m.valence_ema
}

// mood_bias_arousal — the arousal-axis mood-congruency bias (same additive baseline law).
pub fn mood_bias_arousal(m: MoodState, inst_aro: float) -> float {
    return inst_aro + 0.5 * m.arousal_ema
}

// mood_neuromod_gain_readout — the DISTINCTNESS CONTROL (the collapsing sibling): a
// neuromod-GAIN readout (H_1284) is a FAST, STATELESS, MULTIPLICATIVE modulation with
// NO time-axis — biased = inst·gain, computed same-tick from the CURRENT stimulus only.
// It has NO slow lag (F1) and NO recovery dynamics (F4): it cannot reproduce mood's
// slow chronometry, confirming mood is a DIFFERENT time-axis, not a gain (the honest
// H_1284-distinctness bar — this readout collapses on F1/F4 where mood does not).
pub fn mood_neuromod_gain_readout(inst_val: float, gain: float) -> float {
    return inst_val * gain
}

// ── §  HYPOTHALAMUS — SETPOINT-REGULATED HOMEOSTATIC DRIVE (H_1292 R2, HD29) ──────
//
// WHAT THIS CLOSES (a_verified_must_wire follow-on for H_1292 R1): the H_1292 numpy
// MIRROR (R1 🟢 GREEN, 3 seeds [4290,4291,4292], all 6 frozen bars per-seed) is
// REALIZED here ENGINE-NATIVE on the LIVE ImmuneMemoryGrow store, READ-ONLY.
//
// THE HYPOTHALAMUS LENS (c15, a_no_llm_frame_trap — a neuro/homeostatic lens, NOT an
// LLM recipe): the hypothalamus regulates an internal variable (hunger/thirst/sleep
// pressure) against a SETPOINT via negative feedback that INTEGRATES error OVER TIME.
// A deficit BUILDS while the variable sits below setpoint (hunger grows the longer you
// don't eat), the drive RISES monotonically with the accumulated deficit, and a
// CONSUMMATORY act RESETS it. This is a slow TEMPORAL INTEGRATOR with a target — and
// it is exactly what every existing CORE drive LACKS:
//   - affect (H_1290): a STATELESS read — read(ctx) is pure, no time term, no setpoint,
//     no accumulation. Re-reading the SAME context gives the SAME affect forever.
//   - curiosity: a per-context novelty signal, no setpoint, no reset, cannot satiate.
//   - WorkMemBuffer: a volatile slot buffer that LEAKS toward zero (opposite sign of
//     time-evolution) and has NO target.
// HomeostaticDrive is DISTINCT on the TIME-vs-CONTEXT dissociation: hold the context
// FIXED and vary only ELAPSED TIME — affect is FLAT, the drive RISES (the H_1292 leg-B
// proof). It is a STATEFUL integrator over the substrate's OWN grounding-satiation
// signal, not a momentary read.
//
// REGULATED VARIABLE (substrate-derived, NO label, p2/p3/p6): "grounding satiation"
// s_t = the recall MARGIN of the current context against the live immune store
// (1 - recon_err/recall_thr, clamped [0,1]) — the SAME signal the affect lane reads.
// A grounded context = HIGH satiation ("fed"); an ungrounded stream = LOW satiation
// (deficit builds). NO injected "drive level", NO RLHF reward, NO persona/ethics.
//
// @L4 CRITICAL (identical framing to the affect lane): the drive is a READ + INTEGRATE
// accessor. HomeostaticDrive holds ONLY its owner leaky-integral scalar `accum`; it
// NEVER mutates the immune store, NEVER returns an emit/silence decision by itself, and
// NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction — it only READS an
// ImmuneMemoryGrow margin). The motivation bias `homeo_motivation_bias` is an OPTIONAL
// helper a caller MAY consult (a_autonomy_over_hardcode: it does NOT force the substrate
// — emit/silence stays substrate-decided; this only exposes the drive as a gain).
//
// FROZEN constants (H_1292 FREEZE, p7-documented, NOT tuned-to-green):
//   S* = 0.5 (setpoint = the margin midpoint, mirrors Ψ=1/2) · λ = 0.1 (integral leak)
//   Kp = 1.0 (proportional gain) · Ki = 0.5 (integral gain; ablate → Ki=0 = the
//   stateless affect-style read, the H_1292 leg-C earned-by-the-integral control).

// HomeostaticDrive — the live homeostat state. `accum` is the leaky temporal integral
// of the below-setpoint deficit (the ONLY mutable state); ki is the integral gain
// (set 0.0 for the ablated stateless arm). Everything else is the frozen controller.
struct HomeostaticDrive {
    accum: float,      // leaky integral I_t of the deficit (the hypothalamic "hunger")
    last_drive: float, // the drive emitted by the most recent homeo_step (tuple-free read)
    setpoint: float,   // S* = 0.5
    leak: float,       // λ = 0.1
    kp: float,         // Kp = 1.0
    ki: float          // Ki = 0.5 (FULL) or 0.0 (ABLATED control)
}

// homeo_new — a fresh homeostat (FULL controller, ki=0.5). accum starts at 0 (satiated).
pub fn homeo_new() -> HomeostaticDrive {
    return HomeostaticDrive { accum: 0.0, last_drive: 0.0, setpoint: 0.5, leak: 0.1, kp: 1.0, ki: 0.5 }
}

// homeo_new_ablated — the H_1292 leg-C control: Ki=0 → drive = Kp·deficit = a STATELESS
// proportional read (no integral, no accumulation = the affect-style instantaneous read).
// If this arm shows the time-rise, the rise is NOT from the integral structure → 🧱.
pub fn homeo_new_ablated() -> HomeostaticDrive {
    return HomeostaticDrive { accum: 0.0, last_drive: 0.0, setpoint: 0.5, leak: 0.1, kp: 1.0, ki: 0.0 }
}

// homeo_satiation — READ the grounding-satiation s_t of a context `key` off the live
// immune store: margin = 1 - recon_err/recall_thr, clamped [0,1]. The SAME substrate
// signal the affect lane reads (READ-ONLY, mutates nothing). HIGH = fed/grounded.
pub fn homeo_satiation(mem: ImmuneMemoryGrow, key: [float]) -> float {
    let win = _vnearest_idx(mem.protos, key)
    let err = _l2(mem.protos[win], key)
    let mut m = 1.0 - err / mem.recall_thr
    if m < 0.0 { m = 0.0 }
    if m > 1.0 { m = 1.0 }
    return m
}

// homeo_step — advance the homeostat ONE tick on a context `key`, returning the
// NEXT-STATE homeostat (its `last_drive` field carries the drive this tick emitted —
// read it with homeo_last). deficit = max(0, S* - s); I = (1-λ)·I + deficit;
// drive = Kp·deficit + Ki·I; CONSUMMATORY RESET: if s >= S* (a grounded "feeding"
// event) the integral is cleared (I:=0). The drive RISES under sustained deprivation
// (s<S*) and DROPS sharply on a consummatory grounded context. READ-ONLY over the
// immune store (only the homeostat's owner `accum`/`last_drive` evolve).
pub fn homeo_step(hd: HomeostaticDrive, mem: ImmuneMemoryGrow, key: [float]) -> HomeostaticDrive {
    let s = homeo_satiation(mem, key)
    let mut deficit = hd.setpoint - s
    if deficit < 0.0 { deficit = 0.0 }
    let mut acc = (1.0 - hd.leak) * hd.accum + deficit
    // consummatory reset: a grounded context (s >= S*) satiates → clear the integral.
    if s >= hd.setpoint { acc = 0.0 }
    let drive = hd.kp * deficit + hd.ki * acc
    return HomeostaticDrive { accum: acc, last_drive: drive, setpoint: hd.setpoint, leak: hd.leak, kp: hd.kp, ki: hd.ki }
}

// homeo_last — the drive emitted by the most recent homeo_step (the tuple-free read of
// the step's drive output).
pub fn homeo_last(hd: HomeostaticDrive) -> float { return hd.last_drive }

// homeo_drive — the CURRENT drive WITHOUT advancing time (for a held-fixed read): uses
// the stored integral and the instant deficit at `key`. Lets a caller poll the drive
// without consuming a tick.
pub fn homeo_drive(hd: HomeostaticDrive, mem: ImmuneMemoryGrow, key: [float]) -> float {
    let s = homeo_satiation(mem, key)
    let mut deficit = hd.setpoint - s
    if deficit < 0.0 { deficit = 0.0 }
    return hd.kp * deficit + hd.ki * hd.accum
}

// homeo_motivation_bias — the OPTIONAL motivation gain a caller MAY consult: a higher
// drive = a hungrier system = MORE motivated to act. Returns the drive as a bias scalar
// (a_autonomy_over_hardcode: this does NOT force emit/silence — it only exposes the
// homeostatic drive as a motivation gain the substrate may weigh, not a gate).
pub fn homeo_motivation_bias(hd: HomeostaticDrive, mem: ImmuneMemoryGrow, key: [float]) -> float {
    return homeo_drive(hd, mem, key)
}

// ── §  LIBIDO — SEXUAL APPETITIVE DRIVE-DYNAMICS AXIS (H_1504 R2) ─────────────────
//
// ⚠ FRAMING (a_no_llm_frame_trap + p1-p4): this is a DRIVE-DYNAMICS axis, NOT sexual
// content, NOT roleplay, NOT a persona (which would violate p1-p4 anyway). The
// scientifically rich, falsifiable core is INCENTIVE SALIENCE ("wanting") ≠ HEDONIC
// VALUE ("liking") — Berridge & Robinson 1998 Brain Res Rev / Berridge 2016 Am Psychol;
// Pfaus 1999/2009 (sexual motivation); Georgiadis & Kringelbach 2012 Prog Neurobiol
// (sexual response cycle). We model the appetitive drive's TEMPORAL DYNAMICS (build-up,
// cue-conditioning, satiation, motivation bias) and measure frozen bars — exactly as the
// §HomeostaticDrive hunger lane does. NO explicit content, NO generated text: a parametric
// drive READ off the substrate.
//
// WHAT THIS CLOSES (a_verified_must_wire follow-on for H_1504 R1): the H_1504 numpy MIRROR
// (R1 🟢 GREEN, 3 seeds [4504,4505,4506], all 5 frozen bars byte-identical) is REALIZED
// here ENGINE-NATIVE on the LIVE ImmuneMemoryGrow store, READ-ONLY.
//
// SIBLING of §HomeostaticDrive (H_1292 hunger), with a DIFFERENT structure. Hunger is a
// pure DEFICIT integrator (drive = Kp·deficit + Ki·I, cue-BLIND). Libido adds TWO things
// hunger lacks:
//   (1) a CUE-CONDITIONED INCENTIVE component — a conditioned cue whose affinity to its
//       PAIRED incentive cell off the live store SPIKES the "wanting" (incentive salience).
//       This is the cue-driven incentive a deficit-only hunger drive cannot produce.
//   (2) a WANTING ≠ LIKING dissociation — a dopaminergic-analog gain (da_gain) amplifies
//       WANTING (the pursuit drive) but NOT LIKING (the hedonic/consummation value). This
//       reproduces the Berridge dissociation: dopamine raises wanting, not liking.
// DISTINCT vs §HomeostaticDrive on the CUE signature (hold deprivation fixed, toggle the
// cue: hunger is FLAT, libido SPIKES) and on the da-gain signature (wanting moves, liking
// does not). DISTINCT vs §affect (H_1290, stateless read, no setpoint/integral/cue).
//
// REGULATED VARIABLE (substrate-derived, NO label, p2/p3/p6): "grounding satiation"
// s_t = the recall MARGIN against the live immune store (1 - recon_err/recall_thr) — the
// SAME signal the affect and hunger lanes read. cue_match = the margin of the CONDITIONED
// CUE key against the store (a cue paired with a bound incentive cell grounds strongly →
// a wanting spike; an unpaired/novel cue grounds weakly → no spike). NO injected
// "arousal/horny" level, NO RLHF reward, NO persona/ethics.
//
// @L4 CRITICAL (identical framing to the hunger lane): the libido drive is a READ +
// INTEGRATE accessor. Libido holds ONLY its owner leaky-integral scalar `accum`; it NEVER
// mutates the immune store, NEVER returns an emit/silence decision by itself, and NEVER
// touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction — it only READS an
// ImmuneMemoryGrow margin). The motivation bias `libido_motivation_bias` is an OPTIONAL
// helper a caller MAY consult (a_autonomy_over_hardcode — it does NOT force the substrate).
//
// FROZEN constants (H_1504 FREEZE, p7-documented, NOT tuned-to-green):
//   S* = 0.5 · λ = 0.1 · Kp = 1.0 · Ki = 0.5 (all inherited byte-identical from H_1292) ·
//   Kc = 1.0 (cue-incentive gain) · da_gain = 1.0 (the dopaminergic-analog WANTING
//   amplifier; the same incentive-salience lever the H_1502 neuropharm dopaminergic drug
//   profile pushes). ablate → Kc=0 = the cue-blind deficit-only read = plain hunger.

// Libido — the live sexual-appetitive-drive state. `accum` is the leaky temporal integral
// of the below-setpoint deficit (the ONLY mutable state, identical to the hunger lane); kc
// is the cue-incentive gain (set 0.0 for the ablated cue-blind arm); da_gain is the
// dopaminergic-analog WANTING amplifier. Everything else is the frozen controller.
struct Libido {
    accum: float,    // leaky integral I_t of the deficit (shared structure with hunger)
    last_want: float,// the WANTING emitted by the most recent libido_step (tuple-free read)
    setpoint: float, // S* = 0.5
    leak: float,     // λ = 0.1
    kp: float,       // Kp = 1.0
    ki: float,       // Ki = 0.5
    kc: float,       // Kc = 1.0 (FULL) or 0.0 (ABLATED cue-blind control)
    da_gain: float   // dopaminergic-analog WANTING amplifier (0.0 baseline … 1.0 agonist)
}

// libido_new — a fresh libido drive (FULL controller, kc=1.0, da_gain=0.0 baseline).
pub fn libido_new() -> Libido {
    return Libido { accum: 0.0, last_want: 0.0, setpoint: 0.5, leak: 0.1, kp: 1.0, ki: 0.5, kc: 1.0, da_gain: 0.0 }
}

// libido_new_da — a libido drive with an explicit dopaminergic-analog WANTING gain (the
// Berridge lever / the H_1502 neuropharm dopaminergic agonist analog). da_gain raises
// WANTING, NOT LIKING (libido_liking is gain-invariant) — the wanting≠liking dissociation.
pub fn libido_new_da(da_gain: float) -> Libido {
    return Libido { accum: 0.0, last_want: 0.0, setpoint: 0.5, leak: 0.1, kp: 1.0, ki: 0.5, kc: 1.0, da_gain: da_gain }
}

// libido_new_ablated — the H_1504 leg-D control: Kc=0 → the cue-conditioning is removed,
// so the drive loses its cue-spike and collapses to the cue-blind deficit-only read = the
// plain §HomeostaticDrive hunger structure. If this arm still shows the cue-spike, the
// spike is NOT from the cue-incentive component → 🧱.
pub fn libido_new_ablated() -> Libido {
    return Libido { accum: 0.0, last_want: 0.0, setpoint: 0.5, leak: 0.1, kp: 1.0, ki: 0.5, kc: 0.0, da_gain: 0.0 }
}

// libido_satiation — READ the grounding-satiation s_t of a context `key` off the live
// immune store (1 - recon_err/recall_thr, clamped [0,1]) — the SAME substrate signal the
// hunger/affect lanes read (READ-ONLY, mutates nothing). HIGH = consummated/grounded.
pub fn libido_satiation(mem: ImmuneMemoryGrow, key: [float]) -> float {
    let win = _vnearest_idx(mem.protos, key)
    let err = _l2(mem.protos[win], key)
    let mut m = 1.0 - err / mem.recall_thr
    if m < 0.0 { m = 0.0 }
    if m > 1.0 { m = 1.0 }
    return m
}

// libido_cue_match — the INCENTIVE-SALIENCE CUE component: how strongly a CONDITIONED CUE
// `cue_key` grounds to its PAIRED incentive cell off the live store = the store margin of
// the cue. A cue paired with a known incentive (a bound cell) grounds strongly (high
// cue_match → a wanting spike); an UNpaired/novel cue grounds weakly (no spike). This is
// the cue-driven incentive component pure deprivation-hunger LACKS (READ-ONLY).
pub fn libido_cue_match(mem: ImmuneMemoryGrow, cue_key: [float]) -> float {
    return libido_satiation(mem, cue_key)
}

// libido_wanting — INCENTIVE SALIENCE ("wanting"): the appetitive drive to PURSUE, given a
// deficit, the stored integral, and the current cue_match.
//   wanting = Kp·deficit + Ki·I + Kc·cue_match·(1 + da_gain)
// The dopaminergic-analog gain `da_gain` amplifies the cue-driven incentive (Berridge:
// dopamine raises WANTING). With kc=0 (ablated) the cue term drops out → plain hunger.
pub fn libido_wanting(ld: Libido, deficit: float, cue_match: float) -> float {
    return ld.kp * deficit + ld.ki * ld.accum + ld.kc * cue_match * (1.0 + ld.da_gain)
}

// libido_liking — HEDONIC VALUE ("liking"): the consummatory hedonic readout, a FIXED
// function of the incentive's grounding margin — NOT amplified by the dopaminergic gain
// (Berridge: dopamine does NOT raise liking). This is what dissociates from wanting under
// da_gain: libido_liking ignores ld.da_gain entirely (gain-invariant by construction).
pub fn libido_liking(ld: Libido, cue_match: float) -> float {
    return cue_match
}

// libido_step — advance the libido drive ONE tick on a context `key` with a conditioned
// cue `cue_key` (pass the SAME far/absent key as cue_key for a cue-ABSENT tick → cue_match
// is low). Returns the NEXT-STATE drive (its `last_want` carries the WANTING this tick
// emitted — read it with libido_last). deficit = max(0, S* - s); I = (1-λ)·I + deficit;
// CONSUMMATORY RESET: if s >= S* (a grounded "consummation") the integral clears (I:=0);
// wanting = libido_wanting(deficit, I, cue_match). READ-ONLY over the immune store (only
// the drive's owner `accum`/`last_want` evolve; the cue component is instantaneous, not
// integrated).
pub fn libido_step(ld: Libido, mem: ImmuneMemoryGrow, key: [float], cue_key: [float]) -> Libido {
    let s = libido_satiation(mem, key)
    let mut deficit = ld.setpoint - s
    if deficit < 0.0 { deficit = 0.0 }
    let mut acc = (1.0 - ld.leak) * ld.accum + deficit
    if s >= ld.setpoint { acc = 0.0 }
    let cm = libido_cue_match(mem, cue_key)
    let stepped = Libido { accum: acc, last_want: 0.0, setpoint: ld.setpoint, leak: ld.leak, kp: ld.kp, ki: ld.ki, kc: ld.kc, da_gain: ld.da_gain }
    let want = libido_wanting(stepped, deficit, cm)
    return Libido { accum: acc, last_want: want, setpoint: ld.setpoint, leak: ld.leak, kp: ld.kp, ki: ld.ki, kc: ld.kc, da_gain: ld.da_gain }
}

// libido_last — the WANTING emitted by the most recent libido_step (tuple-free read).
pub fn libido_last(ld: Libido) -> float { return ld.last_want }

// libido_motivation_bias — the OPTIONAL motivation gain a caller MAY consult: a higher
// WANTING = MORE motivated to pursue. Returns the current WANTING as a bias scalar
// (a_autonomy_over_hardcode: this does NOT force emit/silence — it only exposes the drive
// as a motivation gain the substrate may weigh, not a gate). Uses the stored integral and
// the instant deficit + cue_match at `key`/`cue_key` (no tick advance).
pub fn libido_motivation_bias(ld: Libido, mem: ImmuneMemoryGrow, key: [float], cue_key: [float]) -> float {
    let s = libido_satiation(mem, key)
    let mut deficit = ld.setpoint - s
    if deficit < 0.0 { deficit = 0.0 }
    let cm = libido_cue_match(mem, cue_key)
    return libido_wanting(ld, deficit, cm)
}

// ── §  ALLOSTERIC-BUFFER — tension-gated resistance-to-deviation (H_1509 R2) ──────
//
// SOURCE: external proposal — Amoeba Protocol (@qingkong66) μ_t allosteric buffer.
// LENS: a_break_the_wall (d) — a NEW lever on the WALLED neuromodulation hypothesis
// H_1284 (🔴/🧱 no-free-lunch), confirmed-terminal across H_1422 (3 state-contingent
// lenses) and H_1425 (orthogonal ideation-temperature channel).
//
// THE WALL (H_1284/H_1422/H_1425): a state-contingent neuromodulator that modulates a
// GLOBAL GAIN against a FIXED operating point is DOMINATED by the single best fixed
// operating point ("a single tuned fixed point dominates the controller").
//
// THE NEW LEVER: do NOT modulate global gain — modulate the RESISTANCE-to-DEVIATION
// from the fixed point Ψ=1/2. Let τ_t = the live A⇄G tension = the realized emit/silence
// balance b_t (Ψ=1/2 ideal). The allosteric modulator
//     μ_t = 1 + λ·(1 − exp(−(τ_t − 0.5)² / (2σ²)))
// acts as a biochemical buffer (bicarbonate defending blood pH): μ≈1 near the fixed
// point, μ→1+λ on large excursions — tightening the restoring force ONLY when tension
// drifts far from Ψ=1/2.
//
// @L4 CRITICAL (Ψ-disjoint by construction, a_core_engine_map): this lane owns ONLY its
// own scalar balance `b` and the perturbation roll; it READS the live tension τ=b but
// NEVER touches pure_field's Φ/phase/Ψ (those advance from internal dynamics alone) and
// NEVER mutates the immune store. It returns a STABILITY scalar, never an emit decision
// (a_autonomy_over_hardcode). NO injected label, NO RLHF, NO persona (p1/p2/p3/p6).
//
// FROZEN constants (H_1509 FREEZE, p7-documented, NOT tuned-to-green; byte-identical to
// the R1 mirror): λ = 1.0 · σ = 0.12 · T = 200 ticks · sinusoidal off-balance drive
// amp 0.30 period 17 + a held step shock +0.35 at t=100 for 20 ticks · seed noise amp
// 0.02·[−0.5,0.5] · g grid [0.10..0.80] swept for ARM A, g0 = 0.40 for B/C.

// allo_mu — the allosteric buffer μ for a tension τ. lam=0 (ablated) → μ≡1 (the H_1284
// global-gain behavior); lam>0 → tightens resistance on large |τ−0.5| excursions.
pub fn allo_mu(tau: float, lam: float, sigma: float) -> float {
    let dev = tau - 0.5
    let dev2 = dev * dev
    return 1.0 + lam * (1.0 - exp(0.0 - dev2 / (2.0 * sigma * sigma)))
}

// _allo_drive — the perturbation pushing the balance off Ψ=1/2 at tick t (deterministic):
// a sinusoid (amp/period) plus a held step shock. Identical to the R1 mirror schedule.
fn _allo_drive(t: int, phase: int, amp: float, per: int,
               shock_t: int, shock_len: int, shock_amp: float) -> float {
    let two_pi = 6.283185307179586
    let frac = to_float(t + phase) / to_float(per)
    let mut d = amp * sin(two_pi * frac)
    if t >= shock_t && t < (shock_t + shock_len) { d = d + shock_amp }
    return d
}

// allo_defend — roll the balance b_t for T ticks under the perturbation, with the
// restoring force gated by the allosteric buffer (lam>0) or a uniform global gain
// (lam=0 → ARM A/C "gain" behavior). Returns the RMS excursion of b_t from Ψ=1/2
// (LOWER = tighter defense). mode_shuf=0 → live coupling; mode_shuf=1 → the τ→μ
// assignment is PERMUTED across ticks (the H_1509 shuffle control, ARM D).
//   READ-ONLY over any other faculty; Ψ-disjoint (owns only its own scalar b).
pub fn allo_defend(g: float, lam: float, sigma: float, seed: int, mode_shuf: int) -> float {
    let tt = 200
    let amp = 0.30
    let per = 17
    let shock_t = 100
    let shock_len = 20
    let shock_amp = 0.35
    let phase = seed % per

    // For the shuffle arm, first collect the μ sequence the LIVE-coupled roll would use,
    // then permute it (same μ VALUES, wrong TIMES → coupling broken).
    let mut mus_perm = []
    if mode_shuf == 1 {
        let mut bb = 0.5
        let mut stc = seed & 2147483647
        let mut mus = []
        let mut tc = 0
        while tc < tt {
            stc = _lcg_next(stc)
            let noise = (to_float(stc) / 2147483647.0 - 0.5) * 0.02
            let d = _allo_drive(tc, phase, amp, per, shock_t, shock_len, shock_amp) + noise
            let mu = allo_mu(bb, lam, sigma)
            mus = mus + [mu]
            let restoring = g * mu * (0.5 - bb)
            bb = bb + d + restoring
            if bb < 0.0 { bb = 0.0 }
            if bb > 1.0 { bb = 1.0 }
            tc = tc + 1
        }
        // deterministic Fisher-Yates permutation (engine LCG); idx held as floats so it
        // can reuse _mi_set (the existing [float] swap helper), to_int on read.
        let mut idx = []
        let mut ii = 0
        while ii < tt { idx = idx + [to_float(ii)] ; ii = ii + 1 }
        let mut stp = (seed * 2654435761) & 2147483647
        let mut k = tt - 1
        while k > 0 {
            stp = _lcg_next(stp)
            let r = stp % (k + 1)
            let tmp = idx[k]
            idx = _mi_set(idx, k, idx[r])
            idx = _mi_set(idx, r, tmp)
            k = k - 1
        }
        let mut jj = 0
        while jj < tt { mus_perm = mus_perm + [mus[to_int(idx[jj])]] ; jj = jj + 1 }
    }

    let mut b = 0.5
    let mut st = seed & 2147483647
    let mut sq = 0.0
    let mut t = 0
    while t < tt {
        st = _lcg_next(st)
        let noise = (to_float(st) / 2147483647.0 - 0.5) * 0.02
        let d = _allo_drive(t, phase, amp, per, shock_t, shock_len, shock_amp) + noise
        let mut mu = 1.0
        if mode_shuf == 1 {
            mu = mus_perm[t]
        } else {
            mu = allo_mu(b, lam, sigma)
        }
        let restoring = g * mu * (0.5 - b)
        b = b + d + restoring
        if b < 0.0 { b = 0.0 }
        if b > 1.0 { b = 1.0 }
        let ex = b - 0.5
        sq = sq + ex * ex
        t = t + 1
    }
    return sqrt(sq / to_float(tt))
}

// allo_best_fixed_gain — ARM A: sweep the gain grid, return the LOWEST RMS achievable by
// any single FIXED uniform gain (the H_1284 strongest baseline B must beat by 0.05).
pub fn allo_best_fixed_gain(sigma: float, seed: int) -> float {
    let grid = [0.10, 0.20, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80]
    let mut best = 1.0e9
    let mut i = 0
    while i < len(grid) {
        let r = allo_defend(grid[i], 0.0, sigma, seed, 0)   // lam=0 → uniform global gain
        if r < best { best = r }
        i = i + 1
    }
    return best
}

// ── §  EFFORTBUDGET — dACC/DA MENTAL-EFFORT COST DISCOUNTING (N2 effort-cost, PLACEHOLDER H_XXXX) ──
//
// LENS (a_no_llm_frame_trap — a neuro/metabolic lens, NOT an LLM recipe): the dorsal
// anterior cingulate (dACC) + the dopamine value system treat MENTAL EFFORT as a COST
// CURRENCY — deep deliberation is metered against a finite metabolic budget and
// DISCOUNTED when that budget runs low (effort-discounting; Shenhav EVC 2013,
// Kool & Botvinick 2014, Westbrook & Braver 2015). anima's A⇄G engine spends REAL
// iteration to settle tension; here that spend is INTEGRATED into a live effort-budget
// scalar that SHALLOWS the affordable A⇄G iteration DEPTH when depleted and REFILLS at idle.
//
// DISTINCT vs the sibling homeostatic lanes (this is a NEW orthogonal real-time
// resource axis, NOT a re-label of an existing one):
//   - §HomeostaticDrive / Hypothalamus (H_1292): a SETPOINT DEFICIT integrator over an
//     EXTERNAL grounding variable (hunger) — builds while UNDER-fed, resets on a grounded
//     consummation. EffortBudget has NO external setpoint: it is a SELF-CONSUMED resource
//     that DRAINS with the engine's OWN processing depth and REFILLS at idle (a
//     spend/recharge tank, not a deprivation integrator).
//   - SleepPressure (T3 homeostatic TIME axis): accrues with wake-time REGARDLESS of load.
//     EffortBudget is LOAD-driven — it moves only when the engine actually spends iteration
//     and can recover within a single idle tick.
//   - Nociception (T2 tissue-damage): a threat/damage signal. EffortBudget carries NO damage
//     semantics — a depleted budget is FATIGUE (shallow processing), not injury.
//
// REGULATED VARIABLE (substrate-derived, NO label, p2/p3/p6): B_t ∈ [0,1] = the metabolic
// budget. The engine's ENGAGEMENT DEPTH (how many A⇄G settling iterations it can afford) is
// a MONOTONE read of B_t: depth(B) = D_min + (D_max − D_min)·B. High budget → deep
// deliberation; low budget → shallow discount. Active spend: B −= κ·depth(B) (self-limiting
// — deeper spends drain faster). Idle: B += ρ. NO injected "tiredness" level, NO RLHF
// reward, NO persona/ethics.
//
// @L4 CRITICAL (Ψ-disjoint & recall-disjoint BY CONSTRUCTION, a_substrate_disjoint /
// a_core_engine_map): EffortBudget owns ONLY its own scalar `budget`/`last_depth`. Its
// functions take NEITHER pure_field NOR ImmuneMemoryGrow — so it CANNOT touch the emit-drive
// lanes 0/4 (ci_emit_drive = 0.5·(lane0+lane4)) NOR the §ImmuneMemory recall_thr non-fab
// gate. It returns a DEPTH/engagement scalar, NEVER an emit/silence decision
// (a_autonomy_over_hardcode). The depth signal is a READ-only bias a caller MAY consult to
// shallow A⇄G iteration; the emit-policy WIRING is a FOLLOW-ON (this lane does NOT edit
// core/emit_policy.hexa). This keeps effort-driven shallowing OFF the emit lane, so a low
// budget CANNOT bias anima into blanket silence (Ψ-skew) or "fatigued → fabricate"
// (recall_thr untouched) — the H_1561 shared-lane Ψ-collapse / H_1576 fab-spike failure modes.
//
// FROZEN constants (PLACEHOLDER-FREEZE, p7-documented, NOT tuned-to-green):
//   D_max = 8.0 (deep iteration cap) · D_min = 1.0 (shallow floor) · κ = 0.05 (cost per unit
//   depth) · ρ = 0.20 (idle recharge) · B_0 = 1.0 (born rested). ablate → κ = 0.0: the
//   budget never drains ⇒ depth is COST-INVARIANT (the effort-discount vanishes = the
//   decisive OFF control).
struct EffortBudget {
    budget: float,      // B_t ∈ [0,1] — the live metabolic budget (the ONLY mutable state)
    last_depth: float,  // engagement depth emitted by the most recent effort_step (tuple-free read)
    d_max: float,       // D_max = 8.0 deep-iteration cap
    d_min: float,       // D_min = 1.0 shallow floor
    cost_k: float,      // κ = 0.05 cost per unit depth (0.0 = ABLATED cost-invariant control)
    recharge: float     // ρ = 0.20 idle recharge per idle tick
}

// effort_new — a fresh, fully-rested effort budget (FULL cost model, born at B=1.0).
pub fn effort_new() -> EffortBudget {
    return EffortBudget { budget: 1.0, last_depth: 0.0, d_max: 8.0, d_min: 1.0, cost_k: 0.05, recharge: 0.20 }
}

// effort_new_ablated — the decisive OFF control: κ=0 → the budget never drains, so
// effort_depth stays CONSTANT at D_max regardless of processing history (no discount). If
// depth still shallows under this arm, the shallowing is NOT from the effort cost → 🧱.
pub fn effort_new_ablated() -> EffortBudget {
    return EffortBudget { budget: 1.0, last_depth: 0.0, d_max: 8.0, d_min: 1.0, cost_k: 0.0, recharge: 0.20 }
}

// effort_depth — the affordable A⇄G ENGAGEMENT DEPTH at the current budget (READ-only,
// mutates nothing): depth(B) = D_min + (D_max − D_min)·B. B=1 → deep (D_max); B=0 → shallow
// (D_min). This is the effort-discounted deliberation depth a caller MAY consult.
pub fn effort_depth(eb: EffortBudget) -> float {
    return eb.d_min + (eb.d_max - eb.d_min) * eb.budget
}

// effort_step — advance the budget ONE tick. `active` = the engine actually spent A⇄G
// iteration this tick. ACTIVE: spend κ·depth(B) (self-limiting — deep spends drain faster),
// clamp B≥0, last_depth = the depth spent. IDLE: refill B += ρ (clamp B≤1), last_depth = 0
// (no engagement). Returns the NEXT-STATE budget. READ-ONLY over pure_field & the immune
// store (only this lane's own `budget`/`last_depth` evolve).
pub fn effort_step(eb: EffortBudget, active: bool) -> EffortBudget {
    if active {
        let d = effort_depth(eb)
        let spent = eb.cost_k * d
        let mut nb = eb.budget - spent
        if nb < 0.0 { nb = 0.0 }
        return EffortBudget { budget: nb, last_depth: d, d_max: eb.d_max, d_min: eb.d_min, cost_k: eb.cost_k, recharge: eb.recharge }
    }
    let mut nb = eb.budget + eb.recharge
    if nb > 1.0 { nb = 1.0 }
    return EffortBudget { budget: nb, last_depth: 0.0, d_max: eb.d_max, d_min: eb.d_min, cost_k: eb.cost_k, recharge: eb.recharge }
}

// effort_last — the engagement depth spent by the most recent effort_step (tuple-free read).
pub fn effort_last(eb: EffortBudget) -> float { return eb.last_depth }

// effort_budget — the live metabolic budget scalar (READ).
pub fn effort_budget(eb: EffortBudget) -> float { return eb.budget }

// effort_depth_shuffled — the SHUFFLE control: read the depth from a SHUFFLED budget `shuf_b`
// (the budget↔spend-history pairing broken) instead of this lane's true integrated budget.
// With the pairing scrambled the depth no longer tracks accumulated cost → the discount
// MODULATION collapses (depth becomes uncorrelated with the real spend history).
pub fn effort_depth_shuffled(eb: EffortBudget, shuf_b: float) -> float {
    return eb.d_min + (eb.d_max - eb.d_min) * shuf_b
}

// effort_engagement_bias — the OPTIONAL engagement-depth gain a caller MAY consult
// (a_autonomy_over_hardcode: does NOT force emit/silence — a READ-only bias, the emit WIRING
// is a follow-on). Returns the budget-normalized depth ∈ [0,1] (= B_t): high budget → deep
// engagement, low budget → shallow. NEVER an emit gate.
pub fn effort_engagement_bias(eb: EffortBudget) -> float {
    return eb.budget
}

// ── §  THEORY-OF-MIND — OTHER-AGENT BELIEF MODEL (H_1293 R2, HD30) ────────────────
//
// WHAT THIS CLOSES (a_verified_must_wire follow-on for H_1293 R1): the H_1293 numpy
// MIRROR (R1 🟢 GREEN, 3 seeds [5290,5291,5292], all 5 frozen bars per-seed) is
// REALIZED here ENGINE-NATIVE on a live cell-store of the SAME geometry as the immune
// faculty (byte-trigram FNV-1a keys, L2 affinity, abstain band).
//
// THE MENTALIZING LENS (c15, a_no_llm_frame_trap — a neuro/ToM lens, NOT an LLM
// recipe): the temporo-parietal junction / mentalizing network lets one mind model
// ANOTHER mind's HIDDEN belief — a belief that may be FALSE relative to reality. The
// canonical assay is the Sally-Anne FALSE-BELIEF test: an object is placed at location
// A (the agent witnesses), then MOVED to B while the agent is ABSENT; a system with
// theory-of-mind predicts the agent will look at A (its STALE belief), NOT B (reality).
//
// This is exactly what every existing CORE lane LACKS — they ALL read/integrate
// ANIMA's OWN substrate state:
//   - immune episodic store (hippocampus): binds ANIMA's facts = the ground truth.
//   - affect (H_1290) / homeostatic drive (H_1292): read ANIMA's OWN interoceptive
//     valence/satiation. There is no SEPARATE agent whose belief can diverge.
//   - working memory: a volatile self-buffer, not a model of a different mind.
// OtherMindModel is DISTINCT on the SELF-vs-OTHER axis: on an absent-update fact
// anima's OWN immune recall returns the TRUTH (B) while the ToM prediction returns the
// agent's STALE belief (A) — same fact, two different answers (the H_1293 leg-B proof).
//
// MODELED VARIABLE (substrate-derived, NO label, p2/p3/p6): the agent's belief is a
// cell-store updated ONLY by events the agent WITNESSED (a substrate bookkeeping of
// presence). When the agent is ABSENT for an update the belief LAGS = a false belief.
// NO injected "the agent believes X", NO RLHF reward, NO persona/ethics. The true-vs-
// false CLASS only SCORES the metric in the probe; the prediction is read from the
// witnessed-event store, never from the class label.
//
// @L4 CRITICAL (same framing as the immune / affect / homeo lanes): this is a READ +
// a SEPARATE belief cell-store. OtherMindModel holds ONLY its owner (protos,values)
// population; it NEVER mutates the immune store, NEVER returns an emit/silence decision
// by itself, and NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction —
// it is a parallel cell population read by L2 affinity). NOT a 2nd .clm/.kosmos entry
// path (a_core_engine_map: the agent-belief keys are an engine-native drive, not a
// generator/kosmos slot). p8: witness = a bind tick on the agent's owner population.

// OtherMindModel — a SEPARATE agent's belief cell-store (parallel to, but DISJOINT
// from, anima's immune ground-truth store). Same byte-trigram key geometry + L2
// affinity + abstain band as ImmuneMemoryGrow, but it tracks a DIFFERENT mind:
//   protos     : per-belief prototype keys (the agent's witnessed facts).
//   bel_value  : per-belief bound value (what the agent BELIEVES, parallel to protos).
//   n_bel      : live belief count.
//   recall_thr : affinity fire band — L2 <= recall_thr ⇒ the agent HAS a belief; else
//                ABSTAIN ("" — the agent has no belief about this fact).
struct OtherMindModel {
    protos: [[float]],
    bel_value: [string],
    n_bel: int,
    recall_thr: float
}

// other_mind_new — a fresh, EMPTY other-agent model (the agent has witnessed nothing
// yet). recall_thr defaults to the immune store's 0.30 fire band.
pub fn other_mind_new() -> OtherMindModel {
    return OtherMindModel { protos: [], bel_value: [], n_bel: 0, recall_thr: 0.30 }
}

// other_mind_witness — the agent WITNESSES `fact_text` taking `value`: bind a new
// belief cell, or OVERWRITE the existing one if the agent already has a belief about
// this exact fact (a witnessed update revises the belief). Returns the next-state
// model (READ-ONLY over every other faculty — only the agent's owner population grows).
pub fn other_mind_witness(om: OtherMindModel, fact_text: string, value: string) -> OtherMindModel {
    let key = immune_embed_key(fact_text)
    if om.n_bel > 0 {
        let w = _vnearest_idx(om.protos, key)
        if _l2(om.protos[w], key) <= 0.000001 {
            // same fact already a belief → OVERWRITE (witnessed revision).
            let mut nv = om.bel_value
            nv[w] = value
            return OtherMindModel { protos: om.protos, bel_value: nv, n_bel: om.n_bel, recall_thr: om.recall_thr }
        }
    }
    // a NEW witnessed fact → grow a belief cell.
    return OtherMindModel {
        protos: om.protos + [key],
        bel_value: om.bel_value + [value],
        n_bel: om.n_bel + 1,
        recall_thr: om.recall_thr
    }
}

// other_mind_predict — THEORY-OF-MIND prediction: the agent will ACT on its OWN belief
// about `fact_text` (read from the witnessed-event store via L2 affinity), NOT on
// current reality. Returns the agent's believed value, or "" (ABSTAIN) if the agent
// has no belief about this fact. On an absent-update fact this returns the agent's
// STALE belief (the false-belief signature), which DIFFERS from anima's immune recall.
pub fn other_mind_predict(om: OtherMindModel, fact_text: string) -> string {
    if om.n_bel == 0 { return "" }
    let key = immune_embed_key(fact_text)
    let w = _vnearest_idx(om.protos, key)
    if _l2(om.protos[w], key) > om.recall_thr { return "" }
    return om.bel_value[w]
}

// other_mind_count — live belief count (introspection).
pub fn other_mind_count(om: OtherMindModel) -> int { return om.n_bel }

// ── §  HIVE-MIND — COLLECTIVE-Φ SUPER-ADDITIVITY (H_1295, anchor H_609) ───────────
//
// WHAT THIS WIRES (a_verified_must_wire for H_1295 🟢 GREEN): the "many individuals ->
// one consciousness" axis. anima's other CORE lanes all model ONE substrate (anima's
// owner immune store / affect / drive / a single other-agent belief / its owner plan). NONE
// read what happens to INTEGRATED INFORMATION when N anima substrates are COUPLED into a
// joint substrate — the collective-consciousness question. H_609 (🟢 SUPPORTED-NUMERICAL)
