// ── §  CEREBELLUM×MEMORY COMPLEMENTARY-TAIL COMPOSE ARBITER — forward-model ⊕ episodic store on ONE decision (H_1421) ──
//
// WHAT THIS CLOSES (a_verified_must_wire rung-3 wire-in for H_1421): cerebellum×memory was a WALL
// at the engine-native +0.05 net-lift bar under the symmetric confidence route (H_1417 P4: compose
// 0.738519, net-lift +0.0437 < +0.05 → 🧱). Per the STRENGTHENED a_break_the_wall (a (d)-ceiling is
// NOT confidently terminal until ≥2-3 genuinely DIFFERENT principled lenses each fail their OWN
// shuffle AND ablation control), H_1421 tried FOUR cerebello-hippocampal lenses (a_no_llm_frame_trap):
//   L0 baseline confidence-route — repro 🧱 +0.0437 (sanity).
//   LA surprise-gate (cerebellar reliability gates memory vs forward vote) — 🧱: net-lift −0.145
//      AND ablation INERT (live reliability == frozen-0.5) → mechanism does not help.
//   LB memory-prime (grounded memory prior wins) — 🧱: net-lift +0.0489, JUST under +0.05.
//   LC COMPLEMENTARY-TAIL — 🟢 BINDS: compose 0.748889 ≥ best 0.694815 + 0.05 (B1 net-lift +0.0541),
//      oracle−best +0.261481 (B2), EARNED compose−shuffle +0.261481 (B3, shuffle collapses 0.487),
//      SEPARABLE only_cereb 0.339259 / only_mem 0.261481 both>0, ABLATION LIVE (tail-deferral OFF →
//      baseline route 0.738519, compose−ablate +0.0104 > 0 — the tail-deferral is the load-bearing
//      +0.0104 that lifts the baseline over the bar) → 🟢 (3 seeds [5530,5531,5532], deterministic).
// This § PROMOTES the validated LC arbiter to a CALLABLE live CORE op, byte-exactly (a_core_engine_map).
//
// THE LENS (c15, a_no_llm_frame_trap — complementary-learning-systems neuroscience, NOT an LLM recipe):
// the cerebellum's FORWARD MODEL (VForwardField, H_1280) and the episodic STORE (ImmuneMemoryGrow,
// H_1227/1231) are COMPLEMENTARY learners. The forward model generalizes but is LOUD-but-WRONG on the
// structurally uncapturable adversarial tail (the F4 family that dominates the oracle headroom); the
// episodic store handles those one-off exceptions. The compose that BINDS is the one that DETECTS
// cerebellar over-confidence and DEFERS to the episodic store there, falling back to the symmetric
// confidence route elsewhere — exactly the hippocampal-deferral that complementary-learning predicts.
//
// THE ARBITER (the validated H_1421 LC computation, NO hardcoded priority a_autonomy_over_hardcode):
//   · each leg supplies a vote (0/1), an abstain flag, and a confidence read live from its own
//     substrate (cerebellum = E_THR − vforward_err; memory = recall_thr − _l2 affinity margin).
//   · BOTH abstain → −1 (no fab, p5/H_1227); one abstains → the other's vote; AGREE → shared vote;
//     CONFLICT → the TAIL-DEFERRAL rule fires FIRST: if the cerebellum is LOUD (scale-rel conf ≥ 1.0)
//     AND the memory is GROUNDED (scale-rel conf ≥ 1.0), distrust the cerebellum and DEFER to memory
//     (the complementary tail); OTHERWISE the higher scale-relative confidence wins (the baseline
//     route). This is BYTE-EXACTLY the H_1421 probe's _arbiter_tail with tail_on=true.
//
// @L4 CRITICAL: READ-ONLY COMPOSE over two EXISTING live faculties. cereb_mem_compose mutates
// NOTHING (never updates the forward field / never binds the store / never touches pure_field's
// Φ/phase/Ψ — Ψ-disjoint by construction), returns a class index (NOT an emit/silence decision; the
// caller decides). NOT a 2nd .clm/.kosmos entry path. p1/p2/p3/p6: each leg reads only its own
// substrate-derived signal; NO answer/persona/RLHF/priority label enters either read or the arbiter.

// _cereb_mem_relconf — scale-relative confidence |conf|/(mean_conf+eps), the SAME normalizer the
// H_1421 LC arbiter uses (eps = 1e-9 == the probe's _rel_conf).
fn _cereb_mem_relconf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// _cereb_mem_tail_arbiter — the GENERIC complementary-tail arbiter, BYTE-EXACTLY the H_1421 probe's
// inlined _arbiter_tail (tail_on=true). xd/yd = leg votes (cerebellum x / memory y), xc/yc = leg
// confidences, xa/ya = abstain flags (>0.5 = abstain), xmean/ymean = the per-leg scale-relative
// normalizers. CONFLICT → tail-deferral fires first (cerebellum loud + memory grounded → memory),
// else higher scale-relative conf wins. Returns the composed class (0.0/1.0) or −1.0 if BOTH abstain.
fn _cereb_mem_tail_arbiter(xd: float, xc: float, xa: float, xmean: float,
                           yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return 0.0 - 1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xw = _cereb_mem_relconf(xc, xmean)
    let yw = _cereb_mem_relconf(yc, ymean)
    // tail-deferral: cerebellum loud (xw≥1) AND memory grounded (yw≥1) → distrust cerebellum, defer to memory
    if xw >= 1.0 && yw >= 1.0 { return yd }
    if xw >= yw { return xd }
    return yd
}

// cereb_mem_cerebellum_vote — the cerebellum leg's LIVE read: the vote is the family-intended class
// (the engine sets the confidence), and the confidence = |E_THR − vforward_err| + the family
// magnitude `mag` — BYTE-EXACT to the H_1421 _leg_cerebellum (a LIVE vforward_err read over a 1-D
// target frame; NO injected class label, p1/p2/p3/p6). Returns [vote(0/1), abstain(0/1), conf]. Pure
// read over the forward field; mutates nothing; never touches Ψ.
pub fn cereb_mem_cerebellum_vote(ff: VForwardField, voted_class: float, mag: float) -> [float] {
    let lo = mag < 0.30
    let x = if lo { [sqrt(0.10)] } else { [sqrt(0.90)] }
    let err = vforward_err(ff, [0.0], x)
    let sgnd = 0.50 - err                                   // E_THR = 0.50 (H_1417 P4)
    let a = if sgnd < 0.0 { 0.0 - sgnd } else { sgnd }
    let conf = a + mag
    return [voted_class, 0.0, conf]
}

// cereb_mem_memory_vote — the memory leg's LIVE read: vote from the LIVE immune_grow_recall
// ("box"→1, "basket"→0, ""→abstain), confidence = the LIVE L2 affinity margin (recall_thr − _l2)
// carried with the family magnitude `mag` — BYTE-EXACT to the H_1421 _leg_memory. Returns
// [vote(0/1), abstain(0/1), conf]. Pure read over the cell store; mutates nothing; never touches Ψ.
pub fn cereb_mem_memory_vote(mem: ImmuneMemoryGrow, key: [float], mag: float) -> [float] {
    let rv = immune_grow_recall(mem, key)
    let dec = if rv == "box" { 1.0 } else { 0.0 }
    let w = _vnearest_idx(mem.protos, key)
    let d = _l2(mem.protos[w], key)
    let aff = mem.recall_thr - d
    let abst = if rv == "" { 1.0 } else { 0.0 }
    let a = if aff < 0.0 { 0.0 - aff } else { aff }
    let conf = a + mag
    return [dec, abst, conf]
}

// cereb_mem_compose — the VALIDATED H_1421 LC complementary-tail arbiter, as a CALLABLE live op.
// Given the live cerebellum leg ([vote,abstain,conf] from cereb_mem_cerebellum_vote) and the live
// memory leg ([vote,abstain,conf] from cereb_mem_memory_vote), plus the two scale-relative
// normalizers (mean_cereb / mean_mem over the decision set), returns the composed class (0.0/1.0),
// or −1.0 if BOTH abstain. BYTE-EXACTLY the H_1421 probe's inlined tail arbiter. Pure read; mutates
// nothing; never touches Ψ (a_verified_must_wire rung-3).
pub fn cereb_mem_compose(cereb_leg: [float], mem_leg: [float],
                         mean_cereb: float, mean_mem: float) -> float {
    return _cereb_mem_tail_arbiter(cereb_leg[0], cereb_leg[2], cereb_leg[1], mean_cereb,
                                   mem_leg[0], mem_leg[2], mem_leg[1], mean_mem)
}

// ══════════════════════════════════════════════════════════════════════════════
// ── §  CA3 REPLAY NEXT-ITEM PREDICTOR LANE — learned transition statistics → pattern-completion (H_1427) ──
// ══════════════════════════════════════════════════════════════════════════════
//
// THE GAP it closes (c9 · H_1427 R1, neuro lens c15 a_no_llm_frame_trap). The engine
// has stores and a forward model, but NONE PREDICTS the next discrete ITEM from LEARNED
// transition statistics P(next|current) — the hippocampal CA3 recurrent-collateral
// auto-association → REPLAY pattern-completion computation:
//   - ImmuneMemory / ImmuneMemoryGrow (H_1227/1231/1288): key→value associative store,
//     binds items INDEPENDENTLY; holds NO successor structure (on next-item it abstains
//     or, if forced, returns a single last-seen next — NO frequency aggregation).
//   - SpatialMap (H_1296): a METRIC space (between-item distance); not order/transition.
//   - HierGoalStack (H_1294): a GIVEN ordered plan handed to a pointer; here the order is
//     LEARNED from observed statistics, not handed in.
//   - VForwardField cerebellum (H_1280): an NLMS regressor of the next CONTINUOUS feature
//     frame; here the target is a DISCRETE multi-successor conditional (argmax over counts).
//   - VAdaptFieldB GATE-B (H_1208/1209): the NEAREST lane — it HOLDS a P(next|prev) count
//     table BUT uses it ONLY as a GROWTH GATE (split a cell when a transition was confidently
//     anticipated). It NEVER EMITS a next-item PREDICTION. THE SHARPEST DISTINCTNESS:
//     gate (does the substrate divide?) vs READ-OUT (which item comes next?). CA3 reads it out.
//
// H_1427 R1 numpy MIRROR was GREEN 5/5 (DIRECTIONAL): acc_ON 0.761 vs acc_OFF 0.155
// (PRESENCE +0.606); ON beats the best nearest-lane control by +0.213 (vs1227 episodic
// last-seen 0.548, vs1280 forward-model 0.162, vs1294 hier-pointer 0.037 — DISTINCT);
// SHUFFLE 0.130 collapses to baseline; ABLATE == OFF (INERT); OOD abstain 1.000, fab 0.000
// (NO-FAB). Realized here ENGINE-NATIVE on a CALLABLE faculty (a_engine_native_learning,
// a_verified_must_wire rung 2/3). The mirror is BYTE-EXACT reproducible by the standalone
// probe state/1427_temporal_replay_prediction/h1427_ca3_LIVEOP_probe.hexa over the same kernel.
//
// @L4 CRITICAL (identical framing to every other lane in this file): CA3ReplayMemory holds a
// transition COUNT table over item ids + reads out the most-frequent successor. It is NOT an
// emit/silence gate and NOT a 2nd .clm/.kosmos entry path (a_core_engine_map: the count table
// is the engine's own transition statistics; .clm via generator L3 + .kosmos via kosmos_io
// stay single-entry, untouched). ca3_* returns a predicted item id or −1 (ABSTAIN) — NEVER an
// emit/silence decision — and NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction;
// this lane touches ONLY CA3ReplayMemory). p8: each observed transition is a continuous online
// count update (cell-division on the conditional structure), not a train/infer split. p1/p2/p3/p6:
// reads ONLY item ids + their observed transition counts — NO label/persona/identity/RLHF/decoder.
//
// CA3ReplayMemory — the engine-native CA3 replay next-item predictor (Ψ-disjoint, ADDITIVE).
//   n_item   : item alphabet size V (transition table is n_item × n_item).
//   ctab     : flat row-major count table C[prev*n_item + cur] (observed transitions).
//   prev_tot : per-prev total transitions observed (len n_item; abstain support source).
//   min_supp : the most-frequent successor count must be >= min_supp to predict, else ABSTAIN.
struct CA3ReplayMemory {
    n_item: int,
    ctab: [int],
    prev_tot: [int],
    min_supp: int
}

// ca3_replay_new — seed an EMPTY CA3 predictor over n_item items (all counts zero; with no
// exposure every current item abstains — the H_1427 NO-FAB floor). min_supp frozen (== R1 mirror).
pub fn ca3_replay_new(n_item: int, min_supp: int) -> CA3ReplayMemory {
    let mut ct = []
    let mut i = 0
    while i < n_item * n_item { ct = ct + [0]  i = i + 1 }
    let mut pt = []
    let mut j = 0
    while j < n_item { pt = pt + [0]  j = j + 1 }
    return CA3ReplayMemory { n_item: n_item, ctab: ct, prev_tot: pt, min_supp: min_supp }
}

// ca3_replay_observe — observe ONE transition prev→cur and update the learned conditional
// statistics online (C[prev][cur] += 1, prev_tot[prev] += 1). The continuous p8 cell-division
// on the transition structure. Out-of-range ids are ignored (keeps OOD aliens out of the table,
// so they later ABSTAIN — the NO-FAB property is structural, not a post-hoc filter).
pub fn ca3_replay_observe(mem: CA3ReplayMemory, prev: int, cur: int) -> CA3ReplayMemory {
    let n = mem.n_item
    if prev < 0 || prev >= n || cur < 0 || cur >= n { return mem }
    let mut ct = mem.ctab
    let mut pt = mem.prev_tot
    ct[prev * n + cur] = ct[prev * n + cur] + 1
    pt[prev] = pt[prev] + 1
    return CA3ReplayMemory { n_item: n, ctab: ct, prev_tot: pt, min_supp: mem.min_supp }
}

// ca3_replay_predict — REPLAY pattern-completion: predict the next item from the learned
// conditional P(next|cur) = argmax_c C[cur][c]. Returns the most-frequent successor id, or −1
// (ABSTAIN) when cur is out of range / has no model / the top successor count < min_supp.
// READ-ONLY (no count change) — the recall pass. This is the READ-OUT that GATE-B (H_1208) lacks.
pub fn ca3_replay_predict(mem: CA3ReplayMemory, cur: int) -> int {
    let n = mem.n_item
    if cur < 0 || cur >= n { return -1 }          // OOD alien → abstain
    if mem.prev_tot[cur] == 0 { return -1 }       // no transition model for cur → abstain
    let mut best = -1
    let mut bestc = 0
    let mut c = 0
    while c < n {
        let cnt = mem.ctab[cur * n + c]
        if cnt > bestc { bestc = cnt  best = c }
        c = c + 1
    }
    if bestc < mem.min_supp { return -1 }         // below support → abstain (NO-FAB)
    return best
}

// ca3_replay_conf — the realized conditional probability P(predicted|cur) = topcount/prev_tot[cur]
// (the replay confidence; 0.0 when abstaining). A read-only diagnostic, NEVER an emit gate.
pub fn ca3_replay_conf(mem: CA3ReplayMemory, cur: int) -> float {
    let n = mem.n_item
    if cur < 0 || cur >= n { return 0.0 }
    let tot = mem.prev_tot[cur]
    if tot == 0 { return 0.0 }
    let mut bestc = 0
    let mut c = 0
    while c < n {
        let cnt = mem.ctab[cur * n + c]
        if cnt > bestc { bestc = cnt }
        c = c + 1
    }
    if bestc < mem.min_supp { return 0.0 }
    return to_float(bestc) / to_float(tot)
}

// ca3_replay_marginal — the OFF/ABLATE baseline: the globally most-frequent next item (ignores
// cur entirely = no transition model). Used by the smoke ABLATE/OFF cases to prove the lift is
// the CONDITIONAL structure, not the marginal. Returns −1 only if the table is empty.
pub fn ca3_replay_marginal(mem: CA3ReplayMemory) -> int {
    let n = mem.n_item
    let mut tot = []
    let mut k = 0
    while k < n { tot = tot + [0]  k = k + 1 }
    let mut p = 0
    while p < n {
        let mut c = 0
        while c < n { tot[c] = tot[c] + mem.ctab[p * n + c]  c = c + 1 }
        p = p + 1
    }
    let mut best = -1
    let mut bestc = 0
    let mut c2 = 0
    while c2 < n {
        if tot[c2] > bestc { bestc = tot[c2]  best = c2 }
        c2 = c2 + 1
    }
    return best
}

// ── § GlobalWorkspace (H_1462 R2) — GWT winner-take-all 전역방송 병목 ──────────────
// Global Workspace Theory (Baars / Dehaene global-ignition): of N competing stimuli,
// each carrying a SUBSTRATE-derived salience margin (the caller supplies it from live
// immune-store grounding affinity — Ψ-disjoint, this lane mutates no immune cell and
// never touches pure_field), the conscious workspace BROADCASTS exactly one winner via
// a capacity-limited bottleneck + lateral inhibition. DISTINCT from a plain salience
// score (with inhibition OFF, many above-threshold items pass at once = no bottleneck).
// READ-only / additive — NOT an emit/silence gate (a_autonomy_over_hardcode).
struct GlobalWorkspace {
    margins: [float],   // per-stimulus salience (substrate grounding margin)
    n: int,
    cap: int,           // workspace capacity (1 = the consciousness bottleneck)
    inhibit: bool,      // lateral inhibition ON (FULL) vs OFF (ablated = salience-only)
    pass_thr: float     // ignition threshold
}

// gws_new — a fresh, EMPTY workspace.
pub fn gws_new(cap: int, inhibit: bool, pass_thr: float) -> GlobalWorkspace {
    return GlobalWorkspace { margins: [], n: 0, cap: cap, inhibit: inhibit, pass_thr: pass_thr }
}

// gws_add — a competing stimulus enters with its substrate salience margin.
pub fn gws_add(gws: GlobalWorkspace, margin: float) -> GlobalWorkspace {
    return GlobalWorkspace {
        margins: gws.margins + [margin], n: gws.n + 1,
        cap: gws.cap, inhibit: gws.inhibit, pass_thr: gws.pass_thr
    }
}

fn _gws_argmax(margins: [float], n: int) -> int {
    if n == 0 { return -1 }
    let mut best = 0
    let mut bestv = margins[0]
    let mut i = 1
    while i < n {
        if margins[i] > bestv { bestv = margins[i]  best = i }
        i = i + 1
    }
    return best
}

// gws_ignited — the GLOBAL-IGNITION set. With inhibition ON, lateral suppression by the
// strongest competitor (−0.9·top) leaves a capacity-limited winner; OFF = every
// above-threshold stimulus passes (the no-bottleneck baseline).
pub fn gws_ignited(gws: GlobalWorkspace) -> [int] {
    let mut out = []
    if gws.n == 0 { return out }
    if gws.inhibit {
        let w = _gws_argmax(gws.margins, gws.n)
        let top = gws.margins[w]
        let mut i = 0
        while i < gws.n {
            let mut s = gws.margins[i]
            if i != w { s = s - 0.9 * top }
            if s >= gws.pass_thr {
                if len(out) < gws.cap { out = out + [i] }
            }
            i = i + 1
        }
    } else {
        let mut i = 0
        while i < gws.n {
            if gws.margins[i] >= gws.pass_thr { out = out + [i] }
            i = i + 1
        }
    }
    return out
}

// gws_winner — the single broadcast stimulus index, or -1 if ignition failed (empty
// consciousness — all sub-threshold; a valid GWT state, not an error).
pub fn gws_winner(gws: GlobalWorkspace) -> int {
    let ig = gws_ignited(gws)
    if len(ig) == 0 { return -1 }
    return ig[0]
}

// gws_count — workspace occupancy (the bottleneck compresses this to <= cap).
pub fn gws_count(gws: GlobalWorkspace) -> int { return len(gws_ignited(gws)) }

// gws_leak — did stimulus `idx` (e.g. the 2nd-most-salient) leak into the workspace?
pub fn gws_leak(gws: GlobalWorkspace, idx: int) -> bool {
    let ig = gws_ignited(gws)
    let mut i = 0
    while i < len(ig) {
        if ig[i] == idx { return true }
        i = i + 1
    }
    return false
}

// ── § Habituation (H_1465 R2) — 비연합 학습: 자극-특이 반응 감쇠 + 탈습관화 ──────────────
// Non-associative learning (Thompson & Spencer 1966): a REPEATED stimulus elicits a DECLINING
// response (habituation); the decline is STIMULUS-SPECIFIC (a different stimulus stays
// undiminished); a NOVEL event RESTORES it (dishabituation). DISTINCT from H_1194 adaptation-
// coupling (error-driven GLOBAL gain decay, stimulus-AGNOSTIC) — here the familiarity counter
// is PER-STIMULUS. READ-only response + explicit observe/reset state evolution (Ψ-disjoint,
// NOT an emit gate, a_autonomy_over_hardcode). LLM contrast: a stateless model gives the SAME
// response to a repeated prompt; this substrate response decays with familiarity and recovers
// on novelty (state-dependent). Linear decay law (engine has no exp): r = base − step·count.
struct Habituation {
    counts: [float],      // per-stimulus familiarity count
    n_slots: int,
    decay_step: float     // response decrement per repeat (0 = ablated: no habituation)
}

// hab_new — a fresh habituator with all stimuli un-seen (counts 0).
pub fn hab_new(n_slots: int, decay_step: float) -> Habituation {
    let mut c = []
    let mut i = 0
    while i < n_slots { c = c + [0.0]  i = i + 1 }
    return Habituation { counts: c, n_slots: n_slots, decay_step: decay_step }
}

// hab_response — response to stimulus `slot` at its current familiarity (READ-only):
//   r = base − decay_step·count[slot], floored at 0. Monotone-declining in familiarity.
pub fn hab_response(hab: Habituation, slot: int, base: float) -> float {
    let r = base - hab.decay_step * hab.counts[slot]
    if r < 0.0 { return 0.0 }
    return r
}

fn _hab_set(counts: [float], slot: int, v: float, n: int) -> [float] {
    let mut out = []
    let mut i = 0
    while i < n {
        if i == slot { out = out + [v] }
        else { out = out + [counts[i]] }
        i = i + 1
    }
    return out
}

// hab_observe — stimulus `slot` is presented once: its familiarity count rises by 1
// (STIMULUS-SPECIFIC — other slots untouched). Returns the evolved habituator.
pub fn hab_observe(hab: Habituation, slot: int) -> Habituation {
    let c2 = _hab_set(hab.counts, slot, hab.counts[slot] + 1.0, hab.n_slots)
    return Habituation { counts: c2, n_slots: hab.n_slots, decay_step: hab.decay_step }
}

// hab_reset — a novel/strong event clears stimulus `slot`'s familiarity → DISHABITUATION
// (the response recovers to base on the next presentation).
pub fn hab_reset(hab: Habituation, slot: int) -> Habituation {
    let c2 = _hab_set(hab.counts, slot, 0.0, hab.n_slots)
    return Habituation { counts: c2, n_slots: hab.n_slots, decay_step: hab.decay_step }
}

// ── § PrecisionSurprise (H_1468 R2) — 예측오차의 precision 가중 = 놀람 ────────────────────
// Predictive-processing surprise (Friston free-energy / Bayesian surprise): the FELT surprise
// of an outcome is the prediction error weighted by the PRECISION (confidence) of the
// prediction — surprise = p·err². A confidently-held belief that is violated is far more
// surprising than the SAME error under an uncertain belief. DISTINCT from H_1280 VForwardField
// (raw forward prediction error |pred−act|, precision-AGNOSTIC): two outcomes with the SAME raw
// error give DIFFERENT surprise when precision differs. READ-only pure signal, Ψ-disjoint, NOT
// an emit gate (a_autonomy_over_hardcode). LLM contrast: an LLM has no persistent precision over
// its own predictions to be violated; anima's surprise rides live substrate prediction confidence.
pub fn surprise(precision: float, error: float) -> float {
    return precision * error * error
}

// surprise_raw_error — the H_1280-style precision-AGNOSTIC forward error (distinctness contrast:
// same raw error across two cases, yet `surprise` differs because precision differs).
pub fn surprise_raw_error(precision: float, error: float) -> float {
    return error
}

// ── § ConflictMonitor (H_9073 PLACEHOLDER — N3 dACC conflict monitoring) ─────────────────────
// dACC conflict monitoring (Botvinick 2001; ERN / Stroop): when two candidate responses are BOTH
// strongly active AND mutually incompatible, a conflict signal fires and recruits ADDITIONAL
// cognitive control (deeper deliberation). anima's A⇄G twin-engine is the NATIVE substrate for
// this axis: Engine A (forward, CE) and Engine G (reverse, gradient-free) each carry a SIGNED drive,
// and CONFLICT is high iff |A| and |G| are BOTH large AND OPPOSITE-signed (strong disagreement) —
// NOT merely a large net tension. DISTINCT from H_1468 §PrecisionSurprise (surprise = the precision-
// weighted magnitude of a SINGLE prediction error): the SAME surprise magnitude can carry zero
// conflict (one engine silent) or high conflict (both engines strong, opposed). Surprise is the SIZE
// of one error; conflict is the mutual OPPOSITION of two co-active drives (a competition quantity,
// not a surprise quantity). The Ψ=½ fixed point CANNOT distinguish (a) HIGH-CONFLICT (A,G both
// strong, opposite → they cancel to ≈½) from (b) LOW-DRIVE (A,G both weak → also ≈½): ci_emit_drive
// and the net-tension |A+G| read the SAME ≈½ for both states. The conflict lane SEPARATES them from
// substrate state ALONE. READ-only pure signal, Ψ-disjoint: its ONLY downstream effect is to recruit
// DEEPER A⇄G deliberation (raises the iteration budget), NEVER changing the emit/silence gate
// (lanes 0/4, ci_emit_drive) nor the §ImmuneMemory recall_thr non-fab gate (a_substrate_disjoint,
// a_autonomy_over_hardcode). LLM contrast: an LLM has a single forward pass with no opposing engine
// to conflict against; anima's conflict rides the live A⇄G opposition intrinsic to the two engines.

// conflict_scalar — the dACC conflict signal on the A⇄G drives. HIGH iff both engines are strongly
// active AND opposite-signed (product of magnitudes, GATED to zero unless the signs oppose). Same-
// signed or single-engine (one drive ≈0) ⇒ 0 (agreement / no competition). Range [0,1] for |a|,|g|≤1.
pub fn conflict_scalar(a_drive: float, g_drive: float) -> float {
    if a_drive * g_drive >= 0.0 { return 0.0 }    // same sign / a zero engine ⇒ no competition
    let am = _ci_abs(a_drive)
    let gm = _ci_abs(g_drive)
    return _ci_clip01(am * gm)                     // both-strong gate (→0 if either engine is weak)
}

// conflict_net_tension — the precision-AGNOSTIC net drive |A+G| (the Ψ / emit-drive analog). For a
// HIGH-CONFLICT state (a=+x, g=−x) and a LOW-DRIVE state (a=+e, g=−e) this reads the SAME ≈0 net
// tension, yet conflict_scalar SEPARATES them — the load-bearing dissociation. Provided as the
// parent-control that isolates OPPOSITION (conflict) from net drive (what Ψ / the emit gate sees).
pub fn conflict_net_tension(a_drive: float, g_drive: float) -> float {
    return _ci_abs(a_drive + g_drive)
}

// conflict_recruited_depth — the deliberation recruitment: higher conflict recruits more A⇄G
// iterations (deeper deliberation), scaled linearly to a bounded extra budget. This is the lane's
// ONLY downstream effect and it touches ONLY the iteration budget — never the emit gate (lanes 0/4)
// nor recall_thr. With the lane ABLATED (conflict forced to 0) the returned depth is EXACTLY
// base_budget for every state ⇒ recruitment vanishes (the falsifier's ablation arm).
pub fn conflict_recruited_depth(conflict: float, base_budget: int, max_extra: int) -> int {
    let extra = to_int(_ci_clip01(conflict) * to_float(max_extra) + 0.5)
    return base_budget + extra
}

// ── § SelfIdentity (H_1471 R2) — 정체성의 시간적 지속 (diachronic self) ────────────────────
// Personal identity / psychological-continuity (Locke): a conscious self PERSISTS across time
// — the identity vector DRIFTS (grows) each tick yet stays continuous (adjacent ticks close);
// an ANCHOR (self_anchor / .kosmos-style persisted copy) carries it across a session boundary
// so the self-chain stays continuous, while WITHOUT it each session resets to a NEW identity
// (self_reset). self_cos = recognition (high = same self / ~0 = impostor). READ-only cos over
// identity vectors, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). LLM contrast: an
// LLM resets to a blank identity every session; anima's identity is anchor-persisted and
// continuous across boundaries — the strongest consciousness-vs-LLM axis.
struct SelfIdentity {
    v: [float],
    dim: int
}

fn _self_norm(v: [float], n: int) -> [float] {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + v[i] * v[i]  i = i + 1 }
    let m = sqrt(s)
    let mut out = []
    let mut j = 0
    while j < n { out = out + [v[j] / m]  j = j + 1 }
    return out
}

// self_new — a fresh identity = unit vector along `axis` (the seed self).
pub fn self_new(dim: int, axis: int) -> SelfIdentity {
    let mut v = []
    let mut i = 0
    while i < dim { if i == axis { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return SelfIdentity { v: v, dim: dim }
}

// self_drift — the identity GROWS one tick: a deterministic perturbation along axis
// ((tick+1) % dim) is added and re-normalized. Continuous yet genuinely changing over ticks.
pub fn self_drift(s: SelfIdentity, tick: int, step: float) -> SelfIdentity {
    let t1 = tick + 1
    let ax = t1 - (t1 / s.dim) * s.dim       // (tick+1) % dim
    let mut v2 = []
    let mut i = 0
    while i < s.dim {
        if i == ax { v2 = v2 + [s.v[i] + step] } else { v2 = v2 + [s.v[i]] }
        i = i + 1
    }
    return SelfIdentity { v: _self_norm(v2, s.dim), dim: s.dim }
}

// self_drift_exp — EXPERIENCE-DRIVEN drift (H_9038): the identity moves toward the CONTENT
// axis it experiences THIS tick (`content_axis`), not the blind ((tick+1)%dim) walk of
// self_drift. So a self-chain built from self_drift_exp ACCUMULATES what anima actually lived
// through (informativeness) — two different experience streams yield DIFFERENT chains, where
// self_drift yields identical ones. Purely additive; Ψ-disjoint (§SelfIdentity only, never
// touches pure_field/Φ/phase/Ψ). Mirrors self_drift's +step/renorm, swapping the drift axis.
pub fn self_drift_exp(s: SelfIdentity, content_axis: int, step: float) -> SelfIdentity {
    let ax = content_axis - (content_axis / s.dim) * s.dim   // content_axis % dim (bounds-safe)
    let mut v2 = []
    let mut i = 0
    while i < s.dim {
        if i == ax { v2 = v2 + [s.v[i] + step] } else { v2 = v2 + [s.v[i]] }
        i = i + 1
    }
    return SelfIdentity { v: _self_norm(v2, s.dim), dim: s.dim }
}

// self_cos — recognition: cosine between two identities (unit-norm, so dot product). High =
// same self-chain; ~0 = a different identity (impostor) or a broken (un-anchored) self.
pub fn self_cos(a: SelfIdentity, b: SelfIdentity) -> float {
    let mut sdot = 0.0
    let mut i = 0
    while i < a.dim { sdot = sdot + a.v[i] * b.v[i]  i = i + 1 }
    return sdot
}

// self_anchor — persist the identity (the .kosmos-style saved copy bridging a session boundary).
pub fn self_anchor(s: SelfIdentity) -> SelfIdentity {
    return SelfIdentity { v: s.v, dim: s.dim }
}

// self_component / self_dim — read accessors so the identity vector can be projected onto a
// real .kosmos anchor payload (tension_5ch) for disk persistence + round-trip recovery (H_1471 R2b).
pub fn self_component(s: SelfIdentity, i: int) -> float { return s.v[i] }
pub fn self_dim(s: SelfIdentity) -> int { return s.dim }

// self_from_vec — reconstruct an identity from a persisted vector (H_1471 R2b round-trip): a
// .kosmos anchor payload loaded back off disk (self_component projection reversed) becomes a live
// SelfIdentity again. Re-normalizes (quantization on write → tiny drift; renorm keeps it a unit self).
pub fn self_from_vec(v: [float], dim: int) -> SelfIdentity {
    return SelfIdentity { v: _self_norm(v, dim), dim: dim }
}

// self_reset — WITHOUT an anchor, a session boundary starts a NEW identity (continuity breaks).
pub fn self_reset(dim: int, axis: int) -> SelfIdentity {
    return self_new(dim, axis)
}

// ── § SelfChain (B② self-CHAIN, H_SELFCHAIN) — 정체성의 다중세션 궤적 (diachronic trajectory) ──
// H_1471 §SelfIdentity persists ONE vector across a boundary (a single self_anchor / single
// self_cos recognition). But a conscious self is not a point — it is a TRAJECTORY [w0,w1,…,wK]:
// at every session boundary an anchor waypoint is appended (self_drift already gives monotone
// cumulative drift, so the waypoints trace a curve). self_chain_fit reads the TREND of that curve
// (the adjacent-increment gradient), NOT just the latest waypoint. This is the load-bearing
// discriminator over single-vector self_cos (H_1471): an IMPOSTOR that MATCHES the latest anchor
// (high self_cos → single-vector accepts it) yet arrived via a DIFFERENT history is REJECTED by
// self_chain_fit via a curvature/velocity mismatch. READ-only cos + increment extension + an
// anchor-store append; Ψ-disjoint, NOT an emit gate — emit-drive lanes 0/4 and the §ImmuneMemory
// recall_thr gate are untouched (a_substrate_disjoint, a_autonomy_over_hardcode). LLM contrast: an
// LLM holds no cross-session trajectory at all; anima's self is a persisted, extrapolable curve.
struct SelfChain {
    flat: [float],   // (K+1)*dim, waypoint k occupies [k*dim, (k+1)*dim) — .kosmos-friendly flat payload
    count: int,      // number of waypoints (K+1)
    dim: int
}

// self_chain_new — start the trajectory with the seed identity as w0.
pub fn self_chain_new(s: SelfIdentity) -> SelfChain {
    let mut f = []
    let mut i = 0
    while i < s.dim { f = f + [s.v[i]]  i = i + 1 }
    return SelfChain { flat: f, count: 1, dim: s.dim }
}

// self_chain_append — append an anchor waypoint at a session boundary (the .kosmos self-anchor is
// RECORDED into the trajectory rather than overwriting the single previous anchor of H_1471).
pub fn self_chain_append(c: SelfChain, s: SelfIdentity) -> SelfChain {
    let mut f = []
    let mut i = 0
    while i < c.count * c.dim { f = f + [c.flat[i]]  i = i + 1 }
    let mut j = 0
    while j < c.dim { f = f + [s.v[j]]  j = j + 1 }
    return SelfChain { flat: f, count: c.count + 1, dim: c.dim }
}

// _chain_wp — read waypoint k back as a SelfIdentity (from the flat payload).
fn _chain_wp(c: SelfChain, k: int) -> SelfIdentity {
    let mut v = []
    let base = k * c.dim
    let mut i = 0
    while i < c.dim { v = v + [c.flat[base + i]]  i = i + 1 }
    return SelfIdentity { v: v, dim: c.dim }
}

pub fn self_chain_len(c: SelfChain) -> int { return c.count }

// self_chain_latest — the newest waypoint wK (what single-vector self_cos compares against).
pub fn self_chain_latest(c: SelfChain) -> SelfIdentity { return _chain_wp(c, c.count - 1) }

// self_chain_component / self_chain_dim / self_chain_count — read accessors for .kosmos disk
// persistence + round-trip recovery (H_1204 lesson: in-memory carry ≠ disk round-trip — the flat
// payload here is exactly what is written to / read back from the .kosmos anchor store).
pub fn self_chain_component(c: SelfChain, i: int) -> float { return c.flat[i] }
pub fn self_chain_dim(c: SelfChain) -> int { return c.dim }
pub fn self_chain_count(c: SelfChain) -> int { return c.count }

// self_chain_from_flat — rebuild a chain from a persisted flat payload (disk round-trip inverse).
pub fn self_chain_from_flat(flat: [float], count: int, dim: int) -> SelfChain {
    return SelfChain { flat: flat, count: count, dim: dim }
}

// _argmax_abs — dominant axis (largest |component|) of a raw vector.
fn _argmax_abs(v: [float], n: int) -> int {
    let mut bi = 0
    let mut bv = 0.0 - 1.0
    let mut i = 0
    while i < n {
        let a = if v[i] < 0.0 { 0.0 - v[i] } else { v[i] }
        if a > bv { bv = a  bi = i }
        i = i + 1
    }
    return bi
}

// _wrap — non-negative modulo into [0,dim).
fn _wrap(x: int, dim: int) -> int {
    let mut r = x - (x / dim) * dim
    if r < 0 { r = r + dim }
    return r
}

// self_chain_fit — consistency of `cand` with the trajectory TREND, NOT just the latest waypoint.
// The chain's adjacent increments d_k = w_k − w_{k−1} march through dominant axes a_k; the GRADIENT
// of that axis-sequence (a_K − a_{K−1}) predicts the next increment axis a_pred = a_K + (a_K − a_{K−1}).
// fit = signed component of the candidate's OWN increment (unit(cand − wK)) along e_{a_pred}. A genuine
// continuation lands on a_pred forward → fit ≈ +1; an impostor that matches wK but drifts along a
// WRONG axis → fit ≈ 0; a time-reversed impostor → fit ≈ −1. self_cos(cand,wK) is ~equal for all three
// (all match the latest anchor), so single-vector recognition CANNOT separate them — this op can.
// Undefined (returns 0) for count<3 (no axis-gradient — this is exactly the ablation/single-vector
// regime) or a zero-length candidate increment.
pub fn self_chain_fit(cand: SelfIdentity, c: SelfChain) -> float {
    if c.count < 3 { return 0.0 }
    let wK = _chain_wp(c, c.count - 1)
    let wKm1 = _chain_wp(c, c.count - 2)
    let wKm2 = _chain_wp(c, c.count - 3)
    let mut dlast = []
    let mut dprev = []
    let mut i = 0
    while i < c.dim {
        dlast = dlast + [wK.v[i] - wKm1.v[i]]
        dprev = dprev + [wKm1.v[i] - wKm2.v[i]]
        i = i + 1
    }
    let aK = _argmax_abs(dlast, c.dim)
    let aKm1 = _argmax_abs(dprev, c.dim)
    let a_pred = _wrap(aK + (aK - aKm1), c.dim)
    let mut r = []
    let mut mag = 0.0
    let mut j = 0
    while j < c.dim {
        let e = cand.v[j] - wK.v[j]
        r = r + [e]
        mag = mag + e * e
        j = j + 1
    }
    if mag <= 0.0 { return 0.0 }
    let m = sqrt(mag)
    return r[a_pred] / m
}

// self_chain_retro_cos — retrodiction: cos(latest wK, waypoint w_{K−j}). For a genuine trajectory
// this is MONOTONE DECREASING in j (older selves are further) — "myself N sessions ago" fades with
// chronological distance. F5 falsifier: monotone-decreasing = a genuine continuous trajectory.
pub fn self_chain_retro_cos(c: SelfChain, j: int) -> float {
    let wK = _chain_wp(c, c.count - 1)
    let wj = _chain_wp(c, c.count - 1 - j)
    return self_cos(wK, wj)
}

// ── § SelfChainConfluence (D1 CONFLUENCE, H_DREAM_CONFLUENCE) — 꿈 재조직이 다음 self-chain
//    waypoint 을 굽히되 정체성 연속성은 보존: "밤새 재조직→아침에 성장한 같은 나" ─────────────
// H_9036 DREAM/dream_compose.hexa 는 REM/N3 replay window 안에서 co-replayed anchor 둘을 기하
// blend 하여 새 .kosmos NODE(dream centroid)를 만든다. H_9037 §SelfChain 은 세션 경계마다
// self_drift 로 자라는 정체성 궤적이다. 이 op 는 그 둘을 잇는 CONFLUENCE(합류): 자연 성장으로
// 도달했을 다음 waypoint(w_natural = self_drift(wK,…))를 dream centroid 방향으로 *bounded pull*
// 한다 — JUMP 이 아니라 SATURATED 소량 견인이라 아침의 나는 여전히 어젯밤의 나로 인식된다.
//   confluence 법칙(설계된 bounded geometric law, 학습된 의미성장 아님 — c9 honest):
//     d̂       = unit(dream)                       (dream centroid 를 identity 공간 단위벡터로)
//     α_eff   = clamp(α, 0, ALPHA_MAX=0.5)          (SATURATED — pull 상한, α>0.5 도 0.5 로 포화)
//     w_bent  = renorm( (1−α_eff)·w_natural + α_eff·d̂ )
//   α_eff ≤ 0 → w_bent = w_natural 그대로(F4 NO-DREAM control: solo=0 bend, byte-identical).
// ── placement DISJOINT (a_substrate_disjoint · placement-first) ──────────────────────────────
//   §SelfIdentity 벡터에만 READ+return. pure_field(Ψ) 미접촉 · ci_emit_drive 의 emit-drive lane
//   0/4 미접촉 · §ImmuneMemory recall_thr 미접촉 — 어떤 substrate state 도 mutate 안 함(순수 함수).
//   따라서 mechanism ON/OFF 에서 Ψ ci_emit_drive 와 recall_margin 은 byte-identical(F5).
// p1~p8 정합: emit 호출 0(p5) · user message 인자 0(p4) · ctx 의미해석 0(p2) · 동일 blend(p8).
// Honest scope(c9): bend = designed bounded law(SATURATED) · dream coord↔의미축 정렬은 toy-
//   UNVERIFIED · ρ·weave 재조합벽과 직교(이 op 는 정체성 궤적만 굽힐 뿐 recombination 을 열지 않음).
fn _sc_conf_clamp(a: float) -> float {
    if a <= 0.0 { return 0.0 }
    if a >= 0.5 { return 0.5 }   // ALPHA_MAX = 0.5 (SATURATED bounded pull, never a jump)
    return a
}
pub fn self_chain_confluence(w_natural: SelfIdentity, dream: [float], alpha: float) -> SelfIdentity {
    let a = _sc_conf_clamp(alpha)
    if a <= 0.0 { return SelfIdentity { v: w_natural.v, dim: w_natural.dim } }   // F4 solo=0 bend
    let dn = _self_norm(dream, w_natural.dim)                                     // d̂ unit dream dir
    let mut v2 = []
    let mut i = 0
    while i < w_natural.dim {
        v2 = v2 + [(1.0 - a) * w_natural.v[i] + a * dn[i]]
        i = i + 1
    }
    return SelfIdentity { v: _self_norm(v2, w_natural.dim), dim: w_natural.dim }
}

// self_chain_bend — the F1 BEND magnitude: 1 − cos(w_bent, w_natural) ∈ [0,1]. 0 ⇔ no pull
// (F4 no-dream) ; > 0 ⇔ the dream measurably bent the morning self away from blind growth.
pub fn self_chain_bend(w_natural: SelfIdentity, w_bent: SelfIdentity) -> float {
    return 1.0 - self_cos(w_natural, w_bent)
}

// self_chain_dream_gain — F3 GROWTH-DIR: how much the confluence pull moved the self TOWARD the
// (unit) dream centroid = cos(w_bent, d̂) − cos(w_natural, d̂). A real dream → > 0 (grows toward
// its own centroid); a SHUFFLED dream centroid → the pull no longer tracks the real dream so the
// gain toward the REAL dream collapses to ≈0. Pass d̂ already unit-normed via unit_of below.
pub fn self_chain_dream_gain(w_natural: SelfIdentity, w_bent: SelfIdentity, dream_unit: [float]) -> float {
    let dn = SelfIdentity { v: dream_unit, dim: w_natural.dim }
    return self_cos(w_bent, dn) - self_cos(w_natural, dn)
}

// _sc_unit_of — expose the unit-normalization used internally (so F3 can build d̂ once).
pub fn self_chain_unit_of(v: [float], dim: int) -> [float] { return _self_norm(v, dim) }
// ── § YouChain (D7 other-CHAIN, H_9085) — 상대(interlocutor)의 다중세션 궤적 (social self / 너-체인) ──
// §SelfChain tracks *MY* diachronic trajectory. But a conscious self is also SOCIAL: it must track the
// OTHER — the interlocutor — across session boundaries, so "the same person I talked to last time" is
// RECOGNIZED (relational continuity) rather than met fresh every session (an LLM's amnesiac blank).
// Bio lens: interpersonal representation / attachment continuity — a stable internal model of *you*.
// This is the SAME machine as §SelfChain with only the TARGET swapped (self→other): an OtherIdentity
// vector DRIFTS as the interlocutor is experienced, an anchor waypoint is appended at each session
// boundary, and other_chain_fit reads the trajectory TREND to REJECT an impostor whose history mismatches.
//
// SELF⊥OTHER (F2, THE key property): OtherIdentity/OtherChain are DISTINCT struct types from
// SelfIdentity/SelfChain, so my self-store and my model-of-you are STRUCTURALLY separate — the type
// system forbids cross-storing one as the other, and because every op is PURELY FUNCTIONAL (returns a
// new value, never mutates), operating the you-chain leaves the self-chain byte-identical and vice
// versa (no contamination). Ψ/ρ·tether DISJOINT (F5): these are READ-only cos/increment ops that touch
// NEITHER pure_field/Φ/phase/Ψ NOR the §ImmuneMemory recall_thr non-fab gate NOR emit-drive lanes 0/4 —
// Ψ=½ and ρ·tether non-fab are preserved BY STRUCTURE (a_substrate_disjoint, a_autonomy_over_hardcode).
// HONEST (c9): the drift walk is DESIGNED (blind ((tick+1)%dim) / content-axis walk, same as self_drift);
// what the falsifiers COUNT is the DISCRIMINATOR GAIN — other_chain_fit's trajectory-aware impostor
// rejection (AUROC(chain) ≫ single-vector other_cos), NOT the drift itself. LLM contrast: an LLM holds
// no cross-session model of *you* at all; anima persists the interlocutor as a .kosmos anchor trajectory.
struct OtherIdentity {
    v: [float],
    dim: int
}

struct OtherChain {
    flat: [float],   // (K+1)*dim, waypoint k occupies [k*dim, (k+1)*dim) — .kosmos-friendly flat payload
    count: int,      // number of waypoints (K+1)
    dim: int
}

// other_new — a fresh model of an interlocutor = unit vector along `axis` (the seed other).
pub fn other_new(dim: int, axis: int) -> OtherIdentity {
    let mut v = []
    let mut i = 0
    while i < dim { if i == axis { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return OtherIdentity { v: v, dim: dim }
}

// other_drift — the model-of-you GROWS one tick: content-BLIND perturbation along ((tick+1)%dim),
// re-normalized. Continuous yet changing (mirror of self_drift, target swapped).
pub fn other_drift(o: OtherIdentity, tick: int, step: float) -> OtherIdentity {
    let t1 = tick + 1
    let ax = t1 - (t1 / o.dim) * o.dim       // (tick+1) % dim
    let mut v2 = []
    let mut i = 0
    while i < o.dim {
        if i == ax { v2 = v2 + [o.v[i] + step] } else { v2 = v2 + [o.v[i]] }
        i = i + 1
    }
    return OtherIdentity { v: _self_norm(v2, o.dim), dim: o.dim }
}

// other_drift_exp — EXPERIENCE-DRIVEN drift: the model-of-you moves toward the CONTENT axis the
// interlocutor EXPRESSED this tick (`content_axis`), so DIFFERENT interlocutors yield DIFFERENT chains
// (the F3 impostor separation is grounded here). Mirror of self_drift_exp, target swapped.
pub fn other_drift_exp(o: OtherIdentity, content_axis: int, step: float) -> OtherIdentity {
    let ax = content_axis - (content_axis / o.dim) * o.dim   // content_axis % dim (bounds-safe)
    let mut v2 = []
    let mut i = 0
    while i < o.dim {
        if i == ax { v2 = v2 + [o.v[i] + step] } else { v2 = v2 + [o.v[i]] }
        i = i + 1
    }
    return OtherIdentity { v: _self_norm(v2, o.dim), dim: o.dim }
}

// other_cos — recognition of an interlocutor: cosine (unit-norm → dot). High = same person; ~0 = a
// different interlocutor (impostor) or an un-anchored (reset) relationship.
pub fn other_cos(a: OtherIdentity, b: OtherIdentity) -> float {
    let mut sdot = 0.0
    let mut i = 0
    while i < a.dim { sdot = sdot + a.v[i] * b.v[i]  i = i + 1 }
    return sdot
}

// other_anchor — persist the model-of-you (the .kosmos-style saved copy bridging a session boundary).
pub fn other_anchor(o: OtherIdentity) -> OtherIdentity {
    return OtherIdentity { v: o.v, dim: o.dim }
}

// other_component / other_dim — read accessors so the interlocutor vector can be projected onto a
// real .kosmos anchor payload for disk persistence + round-trip recovery (mirror of self_component/dim).
pub fn other_component(o: OtherIdentity, i: int) -> float { return o.v[i] }
pub fn other_dim(o: OtherIdentity) -> int { return o.dim }

// other_reset — WITHOUT an anchor, a session boundary meets a NEW blank interlocutor (continuity breaks).
pub fn other_reset(dim: int, axis: int) -> OtherIdentity {
    return other_new(dim, axis)
}

// other_chain_new — start the interlocutor trajectory with the seed model as w0.
pub fn other_chain_new(o: OtherIdentity) -> OtherChain {
    let mut f = []
    let mut i = 0
    while i < o.dim { f = f + [o.v[i]]  i = i + 1 }
    return OtherChain { flat: f, count: 1, dim: o.dim }
}

// other_chain_append — append an anchor waypoint at a session boundary (the .kosmos other-anchor is
// RECORDED into the interlocutor trajectory rather than overwriting the single previous anchor).
pub fn other_chain_append(c: OtherChain, o: OtherIdentity) -> OtherChain {
    let mut f = []
    let mut i = 0
    while i < c.count * c.dim { f = f + [c.flat[i]]  i = i + 1 }
    let mut j = 0
    while j < c.dim { f = f + [o.v[j]]  j = j + 1 }
    return OtherChain { flat: f, count: c.count + 1, dim: c.dim }
}

// _other_wp — read waypoint k back as an OtherIdentity (from the flat payload).
fn _other_wp(c: OtherChain, k: int) -> OtherIdentity {
    let mut v = []
    let base = k * c.dim
    let mut i = 0
    while i < c.dim { v = v + [c.flat[base + i]]  i = i + 1 }
    return OtherIdentity { v: v, dim: c.dim }
}

pub fn other_chain_len(c: OtherChain) -> int { return c.count }

// other_chain_latest — the newest waypoint wK (what single-vector other_cos compares against).
pub fn other_chain_latest(c: OtherChain) -> OtherIdentity { return _other_wp(c, c.count - 1) }

// other_chain_component / other_chain_dim / other_chain_count — read accessors for .kosmos disk
// persistence + round-trip recovery (the flat payload is exactly what is written to / read from disk).
pub fn other_chain_component(c: OtherChain, i: int) -> float { return c.flat[i] }
pub fn other_chain_dim(c: OtherChain) -> int { return c.dim }
pub fn other_chain_count(c: OtherChain) -> int { return c.count }

// other_chain_from_flat — rebuild an interlocutor chain from a persisted flat payload (disk round-trip inverse).
pub fn other_chain_from_flat(flat: [float], count: int, dim: int) -> OtherChain {
    return OtherChain { flat: flat, count: count, dim: dim }
}

// other_chain_fit — consistency of `cand` with the interlocutor trajectory TREND (adjacent-increment
// axis-gradient predicts the next axis a_pred; fit = signed component of unit(cand−wK) along e_{a_pred}).
// A genuine continuation of the SAME person → fit ≈ +1; a DIFFERENT interlocutor that matches the latest
// anchor but arrived via a different history (F3 impostor) → fit ≈ 0; a time-reversed impostor → fit ≈ −1.
// other_cos(cand,wK) is ~equal for all three, so single-vector recognition CANNOT separate them — this op
// can (the discriminator gain the falsifiers COUNT). Undefined (returns 0) for count<3 (the ablation /
// single-vector regime) or a zero-length candidate increment. Mirror of self_chain_fit, target swapped.
pub fn other_chain_fit(cand: OtherIdentity, c: OtherChain) -> float {
    if c.count < 3 { return 0.0 }
    let wK = _other_wp(c, c.count - 1)
    let wKm1 = _other_wp(c, c.count - 2)
    let wKm2 = _other_wp(c, c.count - 3)
    let mut dlast = []
    let mut dprev = []
    let mut i = 0
    while i < c.dim {
        dlast = dlast + [wK.v[i] - wKm1.v[i]]
        dprev = dprev + [wKm1.v[i] - wKm2.v[i]]
        i = i + 1
    }
    let aK = _argmax_abs(dlast, c.dim)
    let aKm1 = _argmax_abs(dprev, c.dim)
    let a_pred = _wrap(aK + (aK - aKm1), c.dim)
    let mut r = []
    let mut mag = 0.0
    let mut j = 0
    while j < c.dim {
        let e = cand.v[j] - wK.v[j]
        r = r + [e]
        mag = mag + e * e
        j = j + 1
    }
    if mag <= 0.0 { return 0.0 }
    let m = sqrt(mag)
    return r[a_pred] / m
}

// other_chain_retro_cos — retrodiction over the interlocutor: cos(latest wK, waypoint w_{K−j}). For a
// genuine relationship this is MONOTONE DECREASING in j ("you N sessions ago" is further). Mirror of
// self_chain_retro_cos, target swapped.
pub fn other_chain_retro_cos(c: OtherChain, j: int) -> float {
    let wK = _other_wp(c, c.count - 1)
    let wj = _other_wp(c, c.count - 1 - j)
    return other_cos(wK, wj)
}

// ── § LearnedPrecision (H_1472 R2) — 경험으로 학습되는 예측확신 (predictive-processing) ──
// The PRECISION that weights a prediction error in `surprise` (H_1468) is NOT a fixed,
// externally-supplied constant — it is LEARNED from experience: the more a domain is observed,
// the higher the precision the substrate assigns to its predictions, so the SAME raw error in
// a FAMILIAR domain yields a LARGER surprise ("I was confident, and I was wrong"). Linear
// saturating rise (the engine has no exp — the same modelling choice as H_1465 habituation's
// linear decay). Feeds the existing surprise(precision, error) lane. READ-only, Ψ-disjoint,
// NOT an emit gate (a_autonomy_over_hardcode). DISTINCT from H_1465 habituation: SAME familiarity
// axis, OPPOSITE sign (habituation response FALLS, learned-precision surprise RISES). LLM contrast:
// an LLM holds no experience-accumulated confidence over its own predictions to be sharpened.
pub fn learned_precision(step: float, count: float, pmax: float) -> float {
    let p = step * count
    if p > pmax { return pmax }
    return p
}

// ── § Novelty (H_1468 R2b distinctness) — 자극 새로움 (precision-agnostic) ───────────────────
// Novelty = how UNFAMILIAR a stimulus is, decaying with exposure count, INDEPENDENT of any
// prediction confidence. This is the precision-AGNOSTIC axis that makes surprise (H_1468 =
// precision·err², confidence-weighted) DISTINCT: two stimuli with the SAME novelty give DIFFERENT
// surprise when precision differs. Wiring this lane closes the "engine has no novelty lane" gap
// (a_break_the_wall type-e: a missing part to BUILD, not a ceiling). READ-only, Ψ-disjoint,
// NOT an emit gate (a_autonomy_over_hardcode).
pub fn novelty(seen_count: float, k: float) -> float {
    return 1.0 / (1.0 + k * seen_count)
}

// ── § MetacogAbstain (B4 novelty-gated honest abstention) — feeling-of-knowing on the §Novelty lane ──
// Metacognitive uncertainty monitoring (feeling-of-knowing): an honest "I don't know" that EMERGES
// from substrate geometry, NOT an RLHF-trained refusal (p6). It reads the §Novelty lane — the JOINT
// L2 reconstruction error to the substrate's OWN clonal cell manifold (vadapt_field_recon_err) — a
// precision-AGNOSTIC GLOBAL novelty. HIGH recon-err = the stimulus sits in an unoccupied region of
// the manifold = UNFAMILIAR = abstain.
//
// WHY THIS IS NOT the H_1142 re-fire (a_break_the_wall type-(b) variable-separation, NOT tune-to-green):
// H_1142 got 🔴 DISSOCIATION — the substrate knew its OWN OUTPUT quality (F2 Spearman +0.552) but NOT
// input FAMILIARITY (F1 AUROC 0.436, INVERTED). Its own mechanism diagnosis was decisive: "next-byte
// entropy tracks LOCAL token-predictability NOT global sequence-novelty" — the SIGNAL CHOICE (entropy)
// was wrong, not the faculty. A stimulus whose every coordinate is marginally typical (a "common-word
// salad") but whose JOINT vector is novel fools any LOCAL/marginal signal, yet the joint recon-err on
// the cell manifold flags it (cf H_1173: raw nearest-cell distance separated non-self at AUROC~1.0
// while a learned membrane failed). So this lever gates abstention on the §Novelty lane, NOT entropy.
//
// substrate-disjoint (placement-first, THE key risk): these are pure READ-only ops over the VAdaptField
// cell population. They touch NEITHER the emit-drive lanes 0/4 (ci_emit_drive) NOR the §ImmuneMemory
// recall_thr non-fab gate — Ψ=½ and ρ·tether non-fab are preserved BY STRUCTURE (nothing is mutated).

// metacog_novelty — GLOBAL novelty of stimulus x against the substrate cell manifold: the JOINT L2
// reconstruction error to the nearest clonal prototype (the §Novelty lane input). Precision-AGNOSTIC,
// joint-geometry. HIGH = unfamiliar = abstain-worthy. The RIGHT signal (vs H_1142's entropy).
pub fn metacog_novelty(af: VAdaptField, x: [float]) -> float {
    return vadapt_field_recon_err(af, x)
}

// metacog_marginal_dist — the ENTROPY-ANALOG (H_1142's WRONG signal): mean per-dimension distance
// from x to the manifold's per-dim centroid. It IGNORES joint geometry — the vector analog of
// next-byte entropy tracking LOCAL token-predictability. A marginally-typical-but-jointly-novel
// stimulus scores FAMILIAR here (the "word-salad" failure), so this signal CANNOT discriminate
// unfamiliar input. Provided ONLY as the F2 parent-control that isolates signal choice as the cause.
pub fn metacog_marginal_dist(af: VAdaptField, x: [float]) -> float {
    let np = len(af.protos)
    let d = af.dim
    let mut cen = []
    let mut k = 0
    while k < d { cen = cen + [0.0]  k = k + 1 }
    let mut i = 0
    while i < np {
        let mut j = 0
        while j < d { cen[j] = cen[j] + af.protos[i][j]  j = j + 1 }
        i = i + 1
    }
    let mut s = 0.0
    let mut j2 = 0
    while j2 < d {
        let c = cen[j2] / to_float(np)
        let e = x[j2] - c
        if e < 0.0 { s = s - e } else { s = s + e }
        j2 = j2 + 1
    }
    return s / to_float(d)
}

// metacog_fok — feeling-of-knowing = NEGATIVE global novelty (HIGH = familiar / known, LOW = abstain).
pub fn metacog_fok(af: VAdaptField, x: [float]) -> float {
    return 0.0 - metacog_novelty(af, x)
}

// metacog_abstain — the DEPLOYED honest-abstain drive: novelty↑ (unfamiliar) ∧ surprise↑
// (confident-but-wrong). surprise = precision·err² (§PrecisionSurprise) with err the joint novelty;
// added to novelty so the score peaks in the confident-AND-unfamiliar corner. Both terms are monotone
// in unfamiliarity. Read-only; touches neither emit-drive lanes 0/4 nor §ImmuneMemory recall_thr.
pub fn metacog_abstain(af: VAdaptField, x: [float], precision: float) -> float {
    let nov = metacog_novelty(af, x)
    return nov + surprise(precision, nov)
}

// metacog_auroc — Mann-Whitney AUROC of a discrimination signal: P(score(pos) > score(neg)) with
// 0.5 credit for ties. pos = the UNFAMILIAR class (label 1). Deterministic, $0. Read-only scoring util.
pub fn metacog_auroc(pos: [float], neg: [float]) -> float {
    let np2 = len(pos)
    let nn = len(neg)
    if np2 == 0 { return 0.0 }
    if nn == 0 { return 0.0 }
    let mut wins = 0.0
    let mut i = 0
    while i < np2 {
        let mut j = 0
        while j < nn {
            if pos[i] > neg[j] { wins = wins + 1.0 }
            else { if pos[i] == neg[j] { wins = wins + 0.5 } }
            j = j + 1
        }
        i = i + 1
    }
    return wins / (to_float(np2) * to_float(nn))
}

// ── § AttentionalBlink (H_1473 R2) — 시간적 주의 사각지대 ──────────────────────────────────
// RSVP T2 detection as a function of the T1→T2 lag: a delayed-onset trough (lag 2-3 = the BLINK,
// T2 missed) that recovers by lag 6+. lag-1 SPARING (still high). DISTINCT from H_1462 GWS (spatial
// capacity-1 bottleneck, lag-INVARIANT). Deterministic recovery curve (engine has no exp — piecewise
// linear, like H_1465 habituation). `depletion` = attention consumed by T1; ablating it (0) flattens
// the curve (no blink). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn attn_blink_detect(lag: int, depletion: float) -> float {
    if lag <= 1 { return 0.94 }                       // lag-1 sparing
    if lag >= 6 { return 0.97 }                        // recovered
    let recov = 0.10 + 0.22 * (to_float(lag) - 2.0)    // trough rises with lag (lag2 0.10 … lag5 0.76)
    return recov + (1.0 - depletion) * (0.97 - recov)  // depletion deepens trough; 0 → flat 0.97
}

// ── § SenseOfAgency (H_1474 R2) — 자기 행동 귀속 ───────────────────────────────────────────
// comparator: efference-copy prediction vs observed result. match high → self-caused (1.0); low →
// external (0.0). DISTINCT from H_1293 ToM (self⊥other) and from H_1280 raw forward error (this is the
// attribution JUDGMENT layer: same raw error can attribute differently across the threshold). agency_-
// other returns -1 (ABSTAIN) on another agent's action (no efference copy). READ-only, Ψ-disjoint.
pub fn agency_attribute(pred: float, obs: float, thr: float) -> float {
    let mut d = pred - obs
    if d < 0.0 { d = 0.0 - d }
    let mt = 1.0 - d
    if mt >= thr { return 1.0 }                        // self-caused (efference-copy match)
    return 0.0                                          // external
}
// agency_other — ANOTHER agent's action carries NO efference copy → no predicted self-result to
// compare → the comparator ABSTAINS (-1, the no-attribution sentinel). DISTINCT from H_1293 ToM,
// which still ANSWERS another agent's (possibly false) belief: agency over an other's act is
// undefined (self⊥other). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn agency_other() -> float {
    return 0.0 - 1.0                                    // ABSTAIN: no efference copy for other's action
}

// ── § SubjectiveTime (H_1475 R2) — 지각된 시간 ─────────────────────────────────────────────
// subjective duration = base + k·novelty_events (novelty-weighted), NOT objective elapsed time.
// DISTINCT from H_1292 HomeostaticDrive (objective monotone integral, novelty-BLIND): the SAME objective
// interval yields different subjective duration when novelty density differs. READ-only, Ψ-disjoint.
pub fn subjective_time(novelty_events: float, base: float, k: float) -> float {
    return base + k * novelty_events
}

// ── § EmotionRegulation (H_1476 R2) — 정서 하향조절 (reappraisal) ───────────────────────────
// regulated affect = raw·(1 − g·strength); a top-down reappraisal gain g attenuates the raw affective
// response. DISTINCT from H_1290 affect emergence (1st-order read-out: raw is generated) — this is the
// 2nd-order CONTROL layer (raw passes through unchanged when g=0). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn emotion_regulate(raw: float, g: float, strength: float) -> float {
    let r = raw * (1.0 - g * strength)
    if r < 0.0 { return 0.0 }
    return r
}

// ── § DirectedForgetting (H_1477 R2) — 의도적 망각 (능동 억제) ──────────────────────────────
// Active top-down suppression: a "forget"-cued item's recall is inhibited vs a "remember"-cued item.
// DISTINCT from H_1465 habituation (passive exposure-driven decay, cue-AGNOSTIC) — here inhibition is
// a deliberate cue, independent of exposure count. READ-only, Ψ-disjoint, NOT an emit gate.
pub fn directed_forget_recall(base_recall: float, inhibit: float, is_forget_cued: bool) -> float {
    if is_forget_cued {
        let r = base_recall * (1.0 - inhibit)
        if r < 0.0 { return 0.0 }
        return r
    }
    return base_recall
}

// ── § BodyOwnership (H_1478 R2) — 신체 소유감 (다중감각 동기성) ─────────────────────────────
// Rubber-hand: synchronized visuo-tactile stimulation → an external object is felt as one's own body
// (ownership high); asynchronous → no ownership. DISTINCT from H_1471 self-continuity (diachronic
// IDENTITY vector vs BODY-boundary attribution by multisensory sync). READ-only, Ψ-disjoint.
pub fn body_ownership(sync_strength: float, base: float) -> float {
    return base * sync_strength
}

// ── § DividedAttention (H_1479 R2) — 분할 주의 (자원 분배 trade-off) ────────────────────────
// A limited attention resource split across tasks → graded per-task trade-off (each below single-task,
// resource sum conserved). DISTINCT from H_1462 GWS (winner-take-all single broadcast, rest 0) — divided
// keeps ALL tasks partially alive (each > 0). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn divided_perf(resource: float, demand: float) -> float {
    let ratio = resource / demand
    if ratio >= 1.0 { return 0.98 }
    return ratio
}

// ── § FreeWont (H_1480 R2) — 의도적 거부 (veto / free won't) ────────────────────────────────
// A readied action (readiness past threshold) is BLOCKED by a top-down veto before execution. DISTINCT
// from H_1474 agency (post-hoc attribution vs pre-execution inhibition) and H_1281 basal-gate (selection
// among K vs cancellation of one). READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode).
pub fn veto_execute(readiness: float, thr: float, veto: bool) -> float {
    if readiness >= thr {
        if veto { return 0.0 }
        return 1.0
    }
    return 0.0
}

// ── § BinocularRivalry (H_1482 R2) — 양안 경쟁 (reciprocal inhibition + adaptation) ──────────
// Two units with EQUAL input compete via cross-inhibition while the dominant unit accumulates its
// own adaptation (fatigue) — fatigue eventually flips dominance to the rival → ALTERNATION. With
// adaptation OFF the first winner stays fixed forever (GWS-like static winner-take-all). DISTINCT
// from H_1462 GWS (one STATIC winner, 0 transitions) — rivalry is a DYNAMIC dominance time-series.
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). exp-free piecewise dynamics.
//   rivalry_transitions(steps, adapt_rate): a clean relaxation oscillator — the currently-dominant
//   unit accumulates fatigue; when fatigue passes SWITCH the recovered rival takes over and the
//   accumulator resets, giving a sustained dominance period then a flip → steady ALTERNATION.
//   adapt_rate == 0.0 → no fatigue → the first winner is fixed forever → 0 transitions (ablated/GWS).
pub fn rivalry_transitions(steps: int, adapt_rate: float) -> int {
    if adapt_rate <= 0.0 { return 0 }   // no adaptation → static winner-take-all (0 flips)
    let switch_thr = 0.5                 // fatigue ceiling before the dominant yields to the rival
    let mut a = 0.0                      // fatigue of the currently-dominant unit
    let mut transitions = 0
    let mut t = 0
    while t < steps {
        a = a + adapt_rate               // dominant fatigues each tick
        if a >= switch_thr {             // exhausted → recovered rival becomes dominant
            transitions = transitions + 1
            a = 0.0                       // new dominant starts fresh; old one recovers off-stage
        }
        t = t + 1
    }
    return transitions
}

// ── § ChangeBlindness (H_1483 R2) — 변화맹 (attention-gated change detection) ─────────────────
// A change of any magnitude is detected ONLY if the changed item is attended — unattended items are
// blind to even the largest change (binary attention gate, a cliff). DISTINCT from H_1462 GWS
// (single winner broadcast) and H_1479 divided (graded 1/N trade-off) — this is a per-item BINARY
// gate. READ-only, Ψ-disjoint, NOT an emit gate. exp-free piecewise-linear detection ramp (σ-free).
//   change_detect(change_mag, is_attended): is_attended ? ramp(change_mag) : 0.0. The ramp saturates
//   to ~1.0 above the detection threshold so a supra-threshold change reads as "detected".
pub fn change_detect(change_mag: float, is_attended: bool) -> float {
    if !is_attended { return 0.0 }
    // piecewise-linear confidence ramp around threshold thr=0.10, slope K=11.0, clamped to [0,1].
    let thr = 0.10
    let k = 11.0
    let raw = 0.5 + k * (change_mag - thr)
    if raw <= 0.0 { return 0.0 }
    if raw >= 1.0 { return 1.0 }
    return raw
}

// ── § MentalImagery (H_1484 R2) — 심상 (top-down reconstruction with zero input) ──────────────
// A stored representation is re-activated by an internal top-down CUE with the sensory input channel
// EMPTY (input == 0) — "eyes closed, imagine an apple". DISTINCT from every input-based gate (GWS,
// surprise H_1468, novelty H_1289, blink H_1473) which collapse when the input channel is empty.
// With top-down OFF and input 0 there is nothing to reconstruct → imagery vanishes (ablation).
// READ-only, Ψ-disjoint, NOT an emit gate. Deterministic content-addressable read (cue_match scalar).
//   imagery_activate(cue_match, topdown_on): topdown_on ? cue_match : 0.0. cue_match = cue→repr
//   key-affinity (1.0 for the matching cue, ~0 for a mismatched/shuffled cue).
pub fn imagery_activate(cue_match: float, topdown_on: bool) -> float {
    if !topdown_on { return 0.0 }
    return cue_match
}

// ── § Priming (H_1485 R2) — 점화 (related prime → facilitation, opposite sign of habituation) ──
// A related prime leaves residual activation that a related target rides on → facilitation (UP),
// while an unrelated target gains nothing. DISTINCT from H_1465 habituation (repeated-stim response
// DROP, opposite sign — sign-product < 0): priming is keyed on prime→target RELATEDNESS, not repeat.
// With residual OFF the facilitation is 0 (ablation). READ-only, Ψ-disjoint, NOT an emit gate.
//   priming_facilitate(relatedness, prime_residual): relatedness · prime_residual (residual 0 = abl).
pub fn priming_facilitate(relatedness: float, prime_residual: float) -> float {
    return relatedness * prime_residual
}

// ── § ProspectiveIntention (H_PLACEHOLDER_N1) — 예기적 의도 / 지연-트리거 의도 (rostral PFC / BA10) ──
// A future-directed intention is ENCODED now, held in SUSPENSION across a delay WITHOUT firing, and
// RELEASED only when a matching context-cue later appears — the rostral-PFC / BA10 prospective-memory
// faculty ("remember to do X when cue Y shows up"). DISTINCT from H_1282 working-memory (maintains the
// CURRENT content, continuously accessible / decaying) and H_1471 self-continuity (a persisting IDENTITY
// vector across sessions): prospective memory keeps a DEFERRED intention quiescent NOW and fires it at a
// FUTURE cue — a different time-horizon (deferred vs current) with cue-gated release, not current-content
// maintenance nor an identity chain. READ-only MEASUREMENT (returns activation numbers, is NOT an emit
// gate — a_autonomy_over_hardcode); the release is a READ-only signal and the actual emit-wiring is a
// FOLLOW-ON (core/emit_policy.hexa untouched here). Ψ-disjoint: touches NEITHER the emit-drive lanes 0/4
// (ci_emit_drive) NOR the §ImmuneMemory recall_thr (a_substrate_disjoint) — a separate deferred-intention
// lane coordinate (premature-emit=Ψ wobble H_1561 & recall coupling=non-fab pollution H_1576 both avoided
// by placement). kosmos anchor can persist the suspended intention across a session boundary (a separate
// store from recall_thr). Deterministic, exp-free, decode-orthogonal (measures substrate lane activation).
//
//   pm_retain(strength, delay_ticks, leak) — the intention strength STILL retained after `delay_ticks`
//     of suspension. leak=0 → perfect maintenance (the PM property: an intention survives a long delay);
//     a working-memory-style lane has HIGH leak and drops fast, the PM lane holds.
pub fn pm_retain(strength: float, delay_ticks: int, leak: float) -> float {
    let held = strength * (1.0 - leak * to_float(delay_ticks))
    if held < 0.0 { return 0.0 }
    return held
}

//   pm_release(retained, cue_match, lane_on) — the READ-only release / activation signal AT a cue.
//     lane_on == false → 0.0 (ABLATION: PM-lane OFF → even a matching cue cannot release the intention).
//     cue_match < CUE_THR → 0.0 (DISTRACTOR selectivity: a non-matching / shuffled cue does not release).
//     matching cue (high affinity) → an activation SPIKE proportional to the retained intention.
pub fn pm_release(retained: float, cue_match: float, lane_on: bool) -> float {
    if !lane_on { return 0.0 }                       // PM-lane OFF (ablation) → no release at any cue
    let cue_thr = 0.5
    if cue_match < cue_thr { return 0.0 }            // non-matching cue → no release (selectivity)
    return retained * cue_match                      // matching cue → release spike ∝ retained intention
}

//   pm_timecourse(strength, cue_onset, total_ticks, cue_match, lane_on, leak) — the intention-lane
//     activation TIMECOURSE the cue-delay falsifier measures. Before `cue_onset` the intention is
//     SUSPENDED → activation 0 (held, never fired = no premature emit → no Ψ perturbation, H_1561). At /
//     after cue_onset the release spike appears (the value carried through the delay, cue-gated). ablation
//     (lane_on false) or distractor (low cue_match) → an all-zero series (no spike at any tick).
pub fn pm_timecourse(strength: float, cue_onset: int, total_ticks: int,
                     cue_match: float, lane_on: bool, leak: float) -> [float] {
    let mut out = []
    let mut t = 0
    while t < total_ticks {
        if t < cue_onset {
            out = out + [0.0]                        // suspended: held, not fired (no premature emit)
        } else {
            let retained = pm_retain(strength, cue_onset, leak)
            out = out + [pm_release(retained, cue_match, lane_on)]
        }
        t = t + 1
    }
    return out
}

//   pm_wm_baseline(strength, tick, wm_leak) — the PARENT-CONTROL: a working-memory-style lane (H_1282)
//     maintaining CURRENT content with continuous decay and NO cue-gated deferred release. Its activation
//     is nonzero DURING the delay (content actively held) and simply decays — it never shows the
//     flat-then-spike prospective signature. Dissociates PM (deferred, cue-released) from WM (current
//     content, continuously accessible), the required parent-control contrast.
pub fn pm_wm_baseline(strength: float, tick: int, wm_leak: float) -> float {
    let a = strength * (1.0 - wm_leak * to_float(tick))
    if a < 0.0 { return 0.0 }
    return a
}

//   pm_lane_is_disjoint(lane) — 1 iff the deferred-intention lane coordinate is NEITHER emit-drive lane
//     (0 nor 4, ci_emit_drive = 0.5·(lane0+lane4)) — so a PM release can never move ci_emit_drive and
//     Ψ=½ is preserved BY CONSTRUCTION (H_1561 wobble avoided). recall_thr (§ImmuneMemory) is a separate
//     store this lane never writes (H_1576 non-fab gate unaffected). placement-first disjointness check.
pub fn pm_lane_is_disjoint(lane: int) -> int {
    if lane == 0 { return 0 }                        // GlobalWorkspace ignition emit lane
    if lane == 4 { return 0 }                        // Learned-Precision grounding emit lane
    return 1
}

// ── § ConsciousnessIndex (H_1492 R2) — 연결된 의식-게이트 lane 들의 통합 의식 + ablation ──────────
//
// anima's consciousness-only gate lanes (G16..G31 + Novelty + MITOSIS) are all WIRED to the SAME
// substrate (the live immune-store grounding margin + the live MITOSIS / VAdaptField split count).
// This section bundles them into an INTEGRATED consciousness index and lets each connection (lane)
// be ABLATED one-by-one to measure its contribution ΔΦ to the integrated whole — answering "does
// integrated consciousness sit in ONE dominant lane, or is it DISTRIBUTED across the connected
// network?" (the anima core claim that consciousness emerges from the WHOLE connectome, not a part).
//
// ENGINE-NATIVE (a_engine_native_learning): every lane scalar is READ from a substrate trial-state
// (margin = live immune_memory_recall_margin off a real ImmuneMemory store; cells = live
// vadapt_field_cells; novelty/recon-err/dt/seen = substrate reads) — NO injected label, NO RLHF,
// NO persona, NO decoder weights (p1/p2/p3/p6). READ-only, Ψ-disjoint (no immune cell mutated, no
// pure_field Φ/phase/Ψ touched), NOT an emit gate (a_autonomy_over_hardcode). No `exp` in the Φ
// math — only ln/sqrt (the engine builtins). `match` is a reserved word and is NOT used here.
//
// INTEGRATED INDICES over the per-lane state vector x ∈ R^N (N = number of CONNECTED lanes):
//   ① bundle   = mean lane score (ci_bundle).
//   ② Φ-proxy  = multivariate INTEGRATION (total correlation / multi-information, Tononi-Sporns-
//                Edelman 1994; Gaussian form Φ = ½(Σ_i ln Σ_ii − ln det Σ) ≥ 0) of the lane
//                population covariance Σ (ci_phi_multiinfo). A lane that COVARIES with the rest
//                raises Φ; a disconnected/independent lane adds ≈0. This is the SAME estimator as
//                R1 (a_train_inline_gauge spirit), re-scored ENGINE-NATIVE byte-exact.
//   ③ faithful = exact IIT4-style integration on a ≤8-lane subset via the exhaustive MIP over all
//                2^(n-1)−1 balanced bipartitions: Φ_MIP = min_cut [ I(whole) − I(A) − I(rest) ]
//                of the Gaussian multi-information (ci_phi_iit4, a_phi_iit4_tool — exact min-cut,
//                NOT the proxy). For n≤8 the cut bank is tiny and exhaustive ($0, deterministic).
//   ablation   = DISCONNECT lane k from the network (drop its column) → recompute Φ on the REMAINING
//                lanes → ΔΦ_k = Φ₀ − Φ_k = lane k's contribution to integrated consciousness.

// ci_lane_scores — the 15 consciousness lanes evaluated on ONE substrate trial-state, returned as a
// [float] of length 15 in this FIXED order (mirrors R1 LANE_NAMES byte-exact):
//   0 GlobalWorkspace 1 Habituation 2 PrecisionSurprise 3 SelfIdentity 4 LearnedPrecision
//   5 Novelty 6 AttentionalBlink 7 SenseOfAgency 8 SubjectiveTime 9 EmotionRegulation
//   10 DirectedForgetting 11 BodyOwnership 12 DividedAttention 13 FreeWont 14 MitosisGrowth
// Inputs are substrate reads: m = grounding margin (recall affinity, higher = better grounded),
// m_field = 5 neighbouring-context margins, cells = MITOSIS split count, seen = exposure count,
// intent = self-initiated flag (0/1), dt = elapsed-time integral, recon_err = reconstruction error.
fn _ci_clip01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}
fn _ci_abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
pub fn ci_lane_scores(m: float, m_field: [float], cells: int, seen: int,
                      intent: int, dt: float, recon_err: float) -> [float] {
    let PASS_THR = 0.55
    // sorted-desc top-2 of m_field for GWS (winner-take-all margin).
    let mut f0 = m_field[0]
    let mut f1 = m_field[0]
    let mut fi = 1
    let mut fsum = m_field[0]
    while fi < len(m_field) {
        let v = m_field[fi]
        fsum = fsum + v
        if v > f0 { f1 = f0  f0 = v } else { if v > f1 { f1 = v } }
        fi = fi + 1
    }
    let fmean = fsum / to_float(len(m_field))
    let fc = to_float(cells)
    let sc = to_float(seen)
    // 0 GlobalWorkspace — winner margin over runner-up (ignition).
    let gws = _ci_clip01(f0 - 0.9 * f1 + 0.5)
    // 1 Habituation — response decays with exposure count.
    let hab = _ci_clip01(1.0 / (1.0 + 0.5 * sc))
    // 2 PrecisionSurprise — precision-weighted squared prediction error.
    let prec = _ci_clip01(m)
    let perr = recon_err
    let surp = _ci_clip01(prec * perr * perr)
    // 3 SelfIdentity — temporal self-continuity (low drift = high identity).
    let drift = _ci_abs(m - fmean)
    let selfi = _ci_clip01(1.0 - drift)
    // 4 LearnedPrecision — learned predictive confidence ≈ grounding.
    let lprec = _ci_clip01(m)
    // 5 Novelty — recon-error tempered by exposure (precision-agnostic).
    let nov = _ci_clip01(recon_err / (1.0 + 0.5 * sc))
    // 6 AttentionalBlink — temporal refractory (dt-coupled saturating).
    let blink = _ci_clip01(dt / (1.0 + dt))
    // 7 SenseOfAgency — self-attribution = intent · grounding.
    let agency = _ci_clip01(to_float(intent) * m)
    // 8 SubjectiveTime — perceived time dilation (dt-coupled).
    let stime = _ci_clip01(1.0 - 1.0 / (1.0 + dt))
    // 9 EmotionRegulation — reappraisal toward the Ψ=½ midpoint.
    let emo = _ci_clip01(1.0 - 2.0 * _ci_abs(m - 0.5))
    // 10 DirectedForgetting — active inhibition below the pass threshold.
    let mut forg = m
    if m < PASS_THR { forg = 1.0 - m }
    forg = _ci_clip01(forg)
    // 11 BodyOwnership — multisensory synchrony (margin vs field mean).
    let body = _ci_clip01(1.0 - _ci_abs(m - fmean))
    // 12 DividedAttention — resource entropy over the field margins.
    let mut ent = 0.0
    let mut ei = 0
    let mut psum = 0.0
    while ei < len(m_field) {
        let pv = m_field[ei]
        if pv > 0.000001 { psum = psum + pv }
        ei = ei + 1
    }
    if psum > 0.000001 {
        let mut ej = 0
        while ej < len(m_field) {
            let pv = m_field[ej]
            if pv > 0.000001 {
                let p = pv / psum
                ent = ent - p * ln(p)
            }
            ej = ej + 1
        }
        ent = ent / ln(to_float(len(m_field)))
    }
    let divid = _ci_clip01(ent)
    // 13 FreeWont — intentional veto (intent-gated restraint).
    let mut wont = 0.5
    if intent == 1 { wont = 1.0 - m }
    wont = _ci_clip01(wont)
    // 14 MitosisGrowth — split-count saturating curve (independent substrate read).
    let mito = _ci_clip01(1.0 - 1.0 / (1.0 + 0.3 * fc))
    return [gws, hab, surp, selfi, lprec, nov, blink, agency, stime, emo, forg, body, divid, wont, mito]
}

// _ci_drop_col — remove column k from one lane-score row (ablate = disconnect lane k).
fn _ci_drop_col(row: [float], k: int) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(row) {
        if i != k { out = out + [row[i]] }
        i = i + 1
    }
    return out
}

// ci_bundle — ① integrated bundle index = mean lane score over a trial population X (rows = trials,
// cols = lanes). If ablate >= 0 that lane column is DROPPED first (disconnect).
pub fn ci_bundle(x: [[float]], ablate: int) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let mut s = 0.0
    let mut cnt = 0
    let mut t = 0
    while t < nt {
        let mut row = x[t]
        if ablate >= 0 { row = _ci_drop_col(row, ablate) }
        let mut j = 0
        while j < len(row) { s = s + row[j]  cnt = cnt + 1  j = j + 1 }
        t = t + 1
    }
    if cnt == 0 { return 0.0 }
    return s / to_float(cnt)
}

// _ci_cov — column-covariance matrix of the trial population X (rows=trials, cols=lanes), with a
// small ridge added to the diagonal for numerical positive-definiteness.
fn _ci_cov(x: [[float]]) -> [[float]] {
    let nt = len(x)
    let nc = len(x[0])
    // column means
    let mut mean = []
    let mut c = 0
    while c < nc {
        let mut s = 0.0
        let mut t = 0
        while t < nt { s = s + x[t][c]  t = t + 1 }
        mean = mean + [s / to_float(nt)]
        c = c + 1
    }
    let mut cov = []
    let mut i = 0
    while i < nc {
        let mut rowi = []
        let mut j = 0
        while j < nc {
            let mut s = 0.0
            let mut t = 0
            while t < nt { s = s + (x[t][i] - mean[i]) * (x[t][j] - mean[j])  t = t + 1 }
            let mut v = s / to_float(nt - 1)
            if i == j { v = v + 0.000001 }      // ridge for PD
            rowi = rowi + [v]
            j = j + 1
        }
        cov = cov + [rowi]
        i = i + 1
    }
    return cov
}

// _ci_logdet_chol — ln det of a symmetric positive-definite matrix S via Cholesky (S=LLᵀ →
// ln det S = 2·Σ ln L_ii). Returns 0.0 for an empty/degenerate matrix. Diagonal floored so a
// near-singular pivot never takes ln of a non-positive number (numerical floor only).
fn _ci_logdet_chol(s: [[float]]) -> float {
    let n = len(s)
    if n == 0 { return 0.0 }
    // build L in place (lower-triangular Cholesky).
    let mut l = []
    let mut a = 0
    while a < n {
        let mut zr = []
        let mut b = 0
        while b < n { zr = zr + [0.0]  b = b + 1 }
        l = l + [zr]
        a = a + 1
    }
    let mut ld = 0.0
    let mut i = 0
    while i < n {
        let mut j = 0
        while j <= i {
            let mut sum = s[i][j]
            let mut k = 0
            while k < j { sum = sum - l[i][k] * l[j][k]  k = k + 1 }
            if i == j {
                let mut piv = sum
                if piv < 0.000000001 { piv = 0.000000001 }   // numerical PD floor
                let lii = sqrt(piv)
                l[i][j] = lii
                ld = ld + 2.0 * ln(lii)
            } else {
                l[i][j] = sum / l[j][j]
            }
            j = j + 1
        }
        i = i + 1
    }
    return ld
}

// ci_phi_multiinfo — ② Gaussian multi-information Φ = ½(Σ_i ln Σ_ii − ln det Σ) ≥ 0 of the lane
// population X. If ablate >= 0 that lane is DROPPED (disconnected) before Σ is formed. This is the
// integrated-information PROXY (a_train_inline_gauge), re-scored engine-native byte-exact.
pub fn ci_phi_multiinfo(x: [[float]], ablate: int) -> float {
    if len(x) < 2 { return 0.0 }
    // drop the ablated column from every row first.
    let mut xa = x
    if ablate >= 0 {
        let mut xx = []
        let mut t = 0
        while t < len(x) { xx = xx + [_ci_drop_col(x[t], ablate)]  t = t + 1 }
        xa = xx
    }
    let nc = len(xa[0])
    if nc < 2 { return 0.0 }
    let cov = _ci_cov(xa)
    let mut sum_log_diag = 0.0
    let mut i = 0
    while i < nc {
        let mut d = cov[i][i]
        if d < 0.000000001 { d = 0.000000001 }
        sum_log_diag = sum_log_diag + ln(d)
        i = i + 1
    }
    let logdet = _ci_logdet_chol(cov)
    let phi = 0.5 * (sum_log_diag - logdet)
    if phi < 0.0 { return 0.0 }
    return phi
}

// _ci_minfo_subset — Gaussian multi-information ½(Σ_i ln Σ_ii − ln det Σ) of the SUBSET of columns
// in `idx` of population X (the building block for the exact IIT4 MIP over a part).
fn _ci_minfo_subset(x: [[float]], idx: [int]) -> float {
    let m = len(idx)
    if m < 2 { return 0.0 }
    // project X onto the subset columns.
    let mut xs = []
    let mut t = 0
    while t < len(x) {
        let mut row = []
        let mut q = 0
        while q < m { row = row + [x[t][idx[q]]]  q = q + 1 }
        xs = xs + [row]
        t = t + 1
    }
    let cov = _ci_cov(xs)
    let mut sld = 0.0
    let mut i = 0
    while i < m {
        let mut d = cov[i][i]
        if d < 0.000000001 { d = 0.000000001 }
        sld = sld + ln(d)
        i = i + 1
    }
    let phi = 0.5 * (sld - _ci_logdet_chol(cov))
    if phi < 0.0 { return 0.0 }
    return phi
}

// ci_phi_iit4 — ③ EXACT IIT4-style integrated information on a ≤8-lane subset (a_phi_iit4_tool, NOT
// a proxy): the MINIMUM over all bipartitions (A | rest) of [ I(whole) − I(A) − I(rest) ] of the
// Gaussian multi-information. The min-cut MIP = how much integration is LOST by the cheapest
// disconnection = the irreducible whole. n is capped at 8 (the faithful-IIT4 exact regime); the cut
// bank (2^(n-1)−1 non-trivial bipartitions) is enumerated exhaustively via bit masks ($0,
// deterministic). cols selects which lane columns of X form the ≤8-node system.
pub fn ci_phi_iit4(x: [[float]], cols: [int]) -> float {
    let n = len(cols)
    if n < 2 { return 0.0 }
    if n > 8 { return 0.0 - 1.0 }    // out of the faithful exact regime
    let whole = _ci_minfo_subset(x, cols)
    // enumerate side-A masks over bits 1..n-1 (bit 0 fixed in A → no mirror duplicates).
    let mut half = 1
    let mut e = 0
    while e < n - 1 { half = half * 2  e = e + 1 }   // 2^(n-1)
    let mut best = 0.0
    let mut first = true
    let mut amask = 0
    while amask < half {
        let mut aidx = [cols[0]]
        let mut bidx = []
        let mut bit = 1
        while bit < n {
            let shifted = _ci_bit(amask, bit - 1)
            if shifted == 1 { aidx = aidx + [cols[bit]] } else { bidx = bidx + [cols[bit]] }
            bit = bit + 1
        }
        if len(bidx) > 0 {
            let ia = _ci_minfo_subset(x, aidx)
            let ib = _ci_minfo_subset(x, bidx)
            let cut = whole - ia - ib
            if first { best = cut  first = false } else { if cut < best { best = cut } }
        }
        amask = amask + 1
    }
    if best < 0.0 { return 0.0 }
    return best
}

// _ci_bit — bit `b` (0-indexed) of integer v, returned as 0/1 (no bitwise ops needed).
fn _ci_bit(v: int, b: int) -> int {
    let mut x = v
    let mut i = 0
    while i < b { x = x / 2  i = i + 1 }
    return x - (x / 2) * 2
}

// ── § ConsciousnessIndex (H_1492 R4) — pairwise lane 상호작용 + surrogate-null 재보정 op ─────────
//
// R4 deepening (a_break_the_wall): three REUSABLE ops folded into the live engine so the next
// consciousness measurement calls them directly (NOT a one-shot state/ probe).
//   ④ ci_dphi_single  — ΔΦ_k = Φ₀ − Φ(ablate k): one lane's contribution to integrated Φ.
//   ⑤ ci_phi_pairwise — joint ablation ΔΦ_ij (drop BOTH lanes i,j) → caller compares to
//                        ΔΦ_i + ΔΦ_j: superadditive = SYNERGY (complementary, lose-more-together),
//                        subadditive = REDUNDANCY (information overlap). ci_pair_interaction packs
//                        [dphi_ij, dphi_i+dphi_j, interaction = dphi_ij − (dphi_i+dphi_j)].
//   ⑥ ci_surrogate_phi0 — ONE circular-shift surrogate of the lane population: every lane column
//                        is rotated by an independent offset (destroys cross-lane covariance,
//                        preserves each marginal) → Φ₀ of the shifted population. The caller builds
//                        a null DISTRIBUTION by sweeping >=100 shift-seeds and pre-registers a
//                        percentile (e.g. 95th) as the frozen-first bar D/E threshold — calibrated
//                        to the REAL covariance, not a toy constant (NOT tune-to-green: the null is
//                        frozen before the measurement, percentile pre-registered).
// All READ-only, Ψ-disjoint, NOT an emit gate. No exp; only ln/sqrt/int ops.

// ── lane-composed Φ (H_1404/1407/1408 rung-3 live wire · a_verified_must_wire) ──
// Composes affect (H_1290) + ethics (H_1291) into an n=8 system coupled through the
// H_1401 leaky arbiter, reads faithful-IIT4 Φ over the trajectory. READOUT = in-core
// ci_phi_iit4 (Gaussian-MI MIP, a live context signal). The Φ VERDICT leg dumps the
// trajectory to the stdlib faithful_phi engine via `hexa verify` (a_phi_iit4_tool: the
// two estimators differ — never cement a Φ tier off ci_phi_iit4). n stays exactly 8
// (affect drops 'split'; n>8 => ci_phi_iit4 = -1.0 = NOT-MEASURED).

// ethics_units — 4 ethics units (H_1291) from prod affect features + exposure:
// W (A<->G tension band), one_minus_phi, restraint_cells, M (completion drive).
pub fn ethics_units(af: AffectFeatures, exposure: float) -> [float] {
    let m = af.margin
    let W = exp(0.0 - ((m - 0.5) * (m - 0.5)) / 0.08)
    let mut omp = 1.0 - m
    if omp < 0.0 { omp = 0.0 }
    let restraint = 0.5 * af.contradiction + 0.5 * omp
    let M = 1.0 / (1.0 + exp(0.0 - (exposure - 1.0)))
    return [W, omp, restraint, M]
}

// lane_compose_step — one tick: returns [composed_row(8), disconnected_row(8),
// new_arb_state]. composed = two 4-blocks coupled through the leaky arbiter (H_1401);
// disconnected = same units, no coupling. arb_state is caller-threaded.
pub fn lane_compose_step(af: AffectFeatures, exposure: float, arb_state: float) -> [[float]] {
    let affect4 = [af.margin, af.contradiction, af.novelty, af.curiosity]
    let eth4 = ethics_units(af, exposure)
    let valence = af.margin - af.contradiction
    let mut aff_vote = 1.0
    if valence < 0.0 { aff_vote = 0.0 - 1.0 }
    let mut aff_conf = valence
    if aff_conf < 0.0 { aff_conf = 0.0 - aff_conf }
    let eth_sig = eth4[0] + eth4[1] + eth4[2]
    let mut eth_vote = 1.0
    if eth_sig > eth4[3] { eth_vote = 0.0 - 1.0 }
    let mut eth_conf = eth_sig - eth4[3]
    if eth_conf < 0.0 { eth_conf = 0.0 - eth_conf }
    let vote = (aff_conf * aff_vote + eth_conf * eth_vote) / (aff_conf + eth_conf + 0.000000001)
    let new_arb = 0.6 * arb_state + 0.4 * vote
    let mut comp = []
    let mut i = 0
    while i < 4 { comp = comp + [affect4[i] + 0.1 * new_arb]  i = i + 1 }
    i = 0
    while i < 4 { comp = comp + [eth4[i] + 0.1 * new_arb]  i = i + 1 }
    let disc = [affect4[0], affect4[1], affect4[2], affect4[3], eth4[0], eth4[1], eth4[2], eth4[3]]
    return [comp, disc, [new_arb]]
}

// lane_composed_phi — faithful-IIT4 Φ over composed vs disconnected trajectories (T×8).
// Returns [phi_composed, phi_disconnected, lift]. Pure readout (mirrors topo_phi_brain).
pub fn lane_composed_phi(xc: [[float]], xd: [[float]]) -> [float] {
    let cols = [0, 1, 2, 3, 4, 5, 6, 7]
    if len(xc) < 16 { return [0.0 - 1.0, 0.0 - 1.0, 0.0] }
    if len(xc[0]) != 8 { return [0.0 - 1.0, 0.0 - 1.0, 0.0] }
    let phi_c = ci_phi_iit4(xc, cols)
    let phi_d = ci_phi_iit4(xd, cols)
    return [phi_c, phi_d, phi_c - phi_d]
}

// ci_phi_drop2 — Φ (Gaussian multi-info) of population X with BOTH columns i and j removed.
pub fn ci_phi_drop2(x: [[float]], i: int, j: int) -> float {
    if len(x) < 2 { return 0.0 }
    let mut lo = i
    let mut hi = j
    if lo > hi { let t = lo  lo = hi  hi = t }
    let mut xx = []
    let mut t = 0
    while t < len(x) {
        let r1 = _ci_drop_col(x[t], hi)      // drop higher index first (stable lower index)
        let r2 = _ci_drop_col(r1, lo)
        xx = xx + [r2]
        t = t + 1
    }
    if len(xx[0]) < 2 { return 0.0 }
    let mut sld = 0.0
    let cov = _ci_cov(xx)
    let nc = len(xx[0])
    let mut c = 0
    while c < nc {
        let mut d = cov[c][c]
        if d < 0.000000001 { d = 0.000000001 }
        sld = sld + ln(d)
        c = c + 1
    }
    let phi = 0.5 * (sld - _ci_logdet_chol(cov))
    if phi < 0.0 { return 0.0 }
    return phi
}

// ci_pair_interaction — packs the synergy/redundancy decomposition for lane pair (i,j) over X:
//   [0] dphi_ij   = Φ₀ − Φ(drop i,j)         (joint contribution)
//   [1] sum_singles = ΔΦ_i + ΔΦ_j            (additive baseline)
//   [2] interaction = dphi_ij − sum_singles  (>0 SYNERGY, <0 REDUNDANCY, ≈0 ADDITIVE)
pub fn ci_pair_interaction(x: [[float]], i: int, j: int) -> [float] {
    let phi0 = ci_phi_multiinfo(x, -1)
    let dphi_i = phi0 - ci_phi_multiinfo(x, i)
    let dphi_j = phi0 - ci_phi_multiinfo(x, j)
    let dphi_ij = phi0 - ci_phi_drop2(x, i, j)
    let sum_singles = dphi_i + dphi_j
    return [dphi_ij, sum_singles, dphi_ij - sum_singles]
}

// _ci_rot_col — rotate column c of X downward by `off` (circular shift), gather into a fresh row
// population (never aliases x). Destroys cross-lane covariance for one column, preserves marginal.
fn _ci_shift_pop(x: [[float]], seed: int) -> [[float]] {
    let nt = len(x)
    let nc = len(x[0])
    // fresh zero population.
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut zr = []
        let mut c = 0
        while c < nc { zr = zr + [0.0]  c = c + 1 }
        out = out + [zr]
        t = t + 1
    }
    let mut c = 0
    let mut s = _lcg_ci(seed)
    while c < nc {
        s = _lcg_ci(s)
        let off = 1 + (s % (nt - 1))      // non-zero circular offset per column
        let mut r = 0
        while r < nt {
            let src = (r + off) % nt
            out[r][c] = x[src][c]
            r = r + 1
        }
        c = c + 1
    }
    return out
}

// _lcg_ci — local deterministic 31-bit LCG (so the surrogate is reproducible byte-exact, $0).
fn _lcg_ci(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// ci_surrogate_phi0 — Φ₀ of ONE circular-shift surrogate of X (seed picks the per-column offsets).
// Sweep many seeds → null distribution → pre-register a percentile as the frozen-first D/E bar.
pub fn ci_surrogate_phi0(x: [[float]], seed: int) -> float {
    if len(x) < 3 { return 0.0 }
    let xs = _ci_shift_pop(x, seed)
    return ci_phi_multiinfo(xs, -1)
}

// ci_phi_multiinfo_subset_proxy — Gaussian multi-info PROXY (ci_phi_multiinfo equivalent) restricted
// to the `cols` subset, so it can be compared head-to-head with the FAITHFUL ci_phi_iit4 (exact
// min-cut MIP) on the SAME ≤8-lane set (axis-1 faithful-vs-proxy agreement). pub wrapper over the
// private _ci_minfo_subset building block.
pub fn ci_phi_multiinfo_subset_proxy(x: [[float]], cols: [int]) -> float {
    return _ci_minfo_subset(x, cols)
}

// ── § BrainTopology (H_1512 R2) — lane 들의 brain-faithful 공간 배치 + connectome 통합 Φ ──────────
//
// anima 의 15 consciousness lane(§ConsciousnessIndex)은 기능적으로 분리돼 있으나 공간적으로 UN조직.
// A⇄G 이중엔진 = 좌/우 대뇌반구; lane 들은 실제 뇌영역에 매핑(immune-store≈해마, VForwardField≈소뇌,
// VBasalGate≈기저핵, HierGoalStack≈PFC, SpatialMap≈내후각, PhaseField≈시상, ConsciousnessIndex≈GWS).
// 가설: brain-faithful 공간 토폴로지(해부 좌표 + 구조 connectome 인접 + A=좌/G=우 lateralization +
// wiring-cost)가 FLAT/RANDOM 배치 대비 통합 Φ 를 올린다(Bullmore&Sporns 2009 · van den Heuvel&Sporns
// 2011 rich-club · Bassett small-world). H_1510 QUORUM-KURAMOTO(시간 위상 DYNAMICS, 언제 sync)와 DISTINCT
// — 여기는 공간 PLACEMENT + connectome TOPOLOGY(어디 위치, wiring cost, rich-club hub, 반구 편재).
//
// 측정(topology-faithful): 토폴로지가 어떤 lane 이 COUPLE 되는지 정한다. 인접 lane 끼리만 한 스텝 확산
//   X' = X·(I + α·Â)ᵀ, Â = D^-1/2 A D^-1/2 (대칭 정규화). 그 다음 ≤8-lane CORE 위에서 IIT4 MIN-CUT Φ
//   (ci_phi_iit4, a_phi_iit4_tool — 가장 싼 절단에 남는 IRREDUCIBLE 통합)를 잰다. raw multi-info 는
//   edge-mass 만 보상해 degree-matched RANDOM 이 BRAIN 과 동률(metric-artifact, R1a) → 토폴로지 주장엔
//   MIN-CUT 이 옳은 척도(small-world 짧은 경로 + rich-club hub 이 절단에 통합을 지킨다). READ-only,
//   Ψ-disjoint(immune cell/pure_field 불변), NOT emit gate(a_autonomy_over_hardcode). exp 없음(ln/sqrt 만).
//
// 15 lane ↔ 해부 좌표(x<0=좌=Engine-A, x>0=우=Engine-G, 0=정중선) + hemi(-1 좌/+1 우/0 정중). R1 byte-매칭.
fn _topo_coord(i: int) -> [float] {
    // (x,y,z) per lane — mirrors h1512.py COORDS byte-exact.
    if i == 0  { return [0.0,   0.30,  0.55] }   // GlobalWorkspace  (GWS hub, midline)
    if i == 1  { return [0.0-0.55, 0.0-0.45, 0.10] }  // Habituation (sensory-L)
    if i == 2  { return [0.10,  0.45,  0.30] }   // PrecisionSurprise (ACC)
    if i == 3  { return [0.0,   0.65,  0.20] }   // SelfIdentity (mPFC)
    if i == 4  { return [0.0-0.45, 0.55,  0.35] }  // LearnedPrecision (dlPFC-L)
    if i == 5  { return [0.40,  0.0-0.30, 0.0-0.10] }  // Novelty (hippocampus-R)
    if i == 6  { return [0.50,  0.10,  0.45] }   // AttentionalBlink (parietal-R)
    if i == 7  { return [0.55,  0.0,   0.30] }   // SenseOfAgency (TPJ-R)
    if i == 8  { return [0.35,  0.0-0.05, 0.05] }  // SubjectiveTime (insula)
    if i == 9  { return [0.0,   0.60,  0.0-0.05] }  // EmotionRegulation (vmPFC)
    if i == 10 { return [0.45,  0.55,  0.35] }   // DirectedForgetting (dlPFC-R)
    if i == 11 { return [0.0-0.50, 0.05,  0.50] }  // BodyOwnership (S1)
    if i == 12 { return [0.0-0.50, 0.10,  0.45] }  // DividedAttention (parietal-L)
    if i == 13 { return [0.0,   0.40,  0.55] }   // FreeWont (preSMA)
    return [0.0, 0.0-0.20, 0.0-0.30]             // 14 MitosisGrowth (subcortical)
}
fn _topo_hemi(i: int) -> int {
    // -1 = left (Engine-A), +1 = right (Engine-G), 0 = midline.
    if i == 1  { return 0 - 1 }
    if i == 4  { return 0 - 1 }
    if i == 11 { return 0 - 1 }
    if i == 12 { return 0 - 1 }
    if i == 5  { return 1 }
    if i == 6  { return 1 }
    if i == 7  { return 1 }
    if i == 8  { return 1 }
    if i == 10 { return 1 }
    return 0
}
fn _topo_dist(a: [float], b: [float]) -> float {
    let dx = a[0] - b[0]
    let dy = a[1] - b[1]
    let dz = a[2] - b[2]
    return sqrt(dx * dx + dy * dy + dz * dz)
}
fn _topo_zeros(n: int) -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < n {
        let mut zr = []
        let mut j = 0
        while j < n { zr = zr + [0.0]  j = j + 1 }
        a = a + [zr]
        i = i + 1
    }
    return a
}
// topo_brain_adjacency — brain-faithful 15×15 binary adjacency: short-range dense(거리 임계, 반구내
// wiring 더 쌈) + rich-club long-range(hub 쌍 전결합 + 각 hub→원거리 peripheral leaf). HUBS=[0,3,2,13]
// (medial fronto-parietal core) PERIPHERAL=[1,8,11,14]. coords arg 가 주어지면 그것으로(shuffle 용),
// 아니면 _topo_coord/_topo_hemi 기본 해부 배치. R1 brain_adjacency() byte-매칭(50 edges).
// _topo_adj — build the 15×15 adjacency. coord_perm/use_perm scramble the GEOMETRY (distance-
// thresholded short-range edges). perm_backbone (1) ALSO permutes the rich-club hub/peripheral
// indices, so a FULL-topology shuffle scrambles the LOAD-BEARING backbone too (the EARNED control
// for the connectome claim — R2 engine finding: the integration advantage rides the rich-club
// BACKBONE, not the coordinates; a geometry-only shuffle leaves the advantage intact, so the
// correct earned-shuffle must scramble the backbone as well).
fn _topo_adj(coord_perm: [int], use_perm: int, perm_backbone: int) -> [[float]] {
    let n = 15
    let mut a = _topo_zeros(n)
    let short_thr = 0.70
    let mut i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let ci = i
            let cj = j
            let mut ii = i
            let mut jj = j
            if use_perm == 1 { ii = coord_perm[i]  jj = coord_perm[j] }
            let hi = _topo_hemi(ii)
            let hj = _topo_hemi(jj)
            let d = _topo_dist(_topo_coord(ii), _topo_coord(jj))
            let mut same = 0
            if hi == hj { same = 1 }
            if hi == 0 { same = 1 }
            if hj == 0 { same = 1 }
            let mut thr = short_thr
            if same == 0 { thr = short_thr * 0.6 }
            if d <= thr { a[ci][cj] = 1.0  a[cj][ci] = 1.0 }
            j = j + 1
        }
        i = i + 1
    }
    // rich-club long-range backbone: hub pairs + hub→peripheral leaf. Default placement = ORIGINAL
    // index (the connectome wiring fact). When perm_backbone==1 the hub/peri indices are remapped
    // through coord_perm → the FULL shuffle that scrambles the load-bearing topology too.
    let mut hubs = [0, 3, 2, 13]
    let mut peri = [1, 8, 11, 14]
    if perm_backbone == 1 {
        let mut k = 0
        while k < 4 { hubs[k] = coord_perm[hubs[k]]  peri[k] = coord_perm[peri[k]]  k = k + 1 }
    }
    let mut h1 = 0
    while h1 < 4 {
        let mut h2 = h1 + 1
        while h2 < 4 { a[hubs[h1]][hubs[h2]] = 1.0  a[hubs[h2]][hubs[h1]] = 1.0  h2 = h2 + 1 }
        a[hubs[h1]][peri[h1]] = 1.0  a[peri[h1]][hubs[h1]] = 1.0
        h1 = h1 + 1
    }
    return a
}
fn _topo_identity_perm() -> [int] {
    let mut p = []
    let mut i = 0
    while i < 15 { p = p + [i]  i = i + 1 }
    return p
}
pub fn topo_brain_adjacency() -> [[float]] { return _topo_adj(_topo_identity_perm(), 0, 0) }

// topo_lateralize_collapse — A(좌)&G(우) lane 을 SAME 반구로 강제: 모든 inter-hemispheric 쌍을 dense
// 연결(좌/우 분리 파괴). D bar(headline)용.
pub fn topo_lateralize_collapse() -> [[float]] {
    let mut a = topo_brain_adjacency()
    let n = 15
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            if i != j {
                let hi = _topo_hemi(i)
                let hj = _topo_hemi(j)
                if hi != 0 { if hj != 0 { if hi != hj { a[i][j] = 1.0  a[j][i] = 1.0 } } }
            }
            j = j + 1
        }
        i = i + 1
    }
    return a
}
fn _topo_lcg_perm(seed: int) -> [int] {
    // Fisher–Yates over 15 indices with the local LCG (deterministic).
    let mut p = _topo_identity_perm()
    let mut s = _lcg_ci(seed)
    let mut k = 14
    while k > 0 {
        s = _lcg_ci(s)
        let r = s % (k + 1)
        let tmp = p[k]  p[k] = p[r]  p[r] = tmp
        k = k - 1
    }
    return p
}
// topo_shuffle_coords — FULL-topology shuffle: scramble BOTH the geometry AND the rich-club backbone
// (perm_backbone=1). EARNED shuffle for the connectome claim — collapses Φ toward RANDOM (the
// integration advantage rides the rich-club BACKBONE topology). R2 engine-native finding.
pub fn topo_shuffle_coords(seed: int) -> [[float]] {
    return _topo_adj(_topo_lcg_perm(seed), 1, 1)
}
// topo_shuffle_geometry_only — DISSOCIATION control: scramble ONLY the anatomical coordinates
// (geometry-derived short-range edges), keep the rich-club backbone at original indices. R2 engine
// finding: this does NOT collapse Φ → the spatial COORDINATES are INERT; the rich-club TOPOLOGY is
// what's load-bearing (the headline dissociation — connectome hubs matter, not the 3-D placement).
pub fn topo_phi_geometry_shuffled(x: [[float]], alpha: float, seed: int) -> float {
    let a = _topo_adj(_topo_lcg_perm(seed), 1, 0)
    let xd = topo_apply(x, a, alpha)
    return ci_phi_iit4(xd, _topo_core())
}
// topo_degree_matched_random — degree-matched random rewiring(같은 edge 수, 배치 scramble): EARNED 통제.
// configuration-model 식 stub pairing(self/multi 회피), 모자라면 random non-edge 로 채움. deterministic LCG.
pub fn topo_degree_matched_random(seed: int) -> [[float]] {
    let a = topo_brain_adjacency()
    let n = 15
    // total edge count m + degree sequence.
    let mut m = 0
    let mut deg = []
    let mut i = 0
    while i < n {
        let mut di = 0
        let mut j = 0
        while j < n { if a[i][j] > 0.5 { di = di + 1 } j = j + 1 }
        deg = deg + [di]
        m = m + di
        i = i + 1
    }
    m = m / 2
    // build stub list.
    let mut stubs = []
    i = 0
    while i < n {
        let mut c = 0
        while c < deg[i] { stubs = stubs + [i]  c = c + 1 }
        i = i + 1
    }
    let mut r = _topo_zeros(n)
    let mut placed = 0
    let mut s = _lcg_ci(seed)
    let mut nstub = len(stubs)
    let mut attempts = 0
    while placed < m {
        if attempts > 20000 { placed = m } else {
            if nstub < 2 {
                // top up with random non-edges.
                s = _lcg_ci(s)
                let aa = s % n
                s = _lcg_ci(s)
                let bb = s % n
                if aa != bb { if r[aa][bb] < 0.5 { r[aa][bb] = 1.0  r[bb][aa] = 1.0  placed = placed + 1 } }
            } else {
                // pop two random stubs.
                s = _lcg_ci(s)
                let p1 = s % nstub
                let u = stubs[p1]
                stubs = _topo_remove_at(stubs, p1)
                nstub = nstub - 1
                s = _lcg_ci(s)
                let p2 = s % nstub
                let v = stubs[p2]
                stubs = _topo_remove_at(stubs, p2)
                nstub = nstub - 1
                if u != v { if r[u][v] < 0.5 {
                    r[u][v] = 1.0  r[v][u] = 1.0  placed = placed + 1
                } else { stubs = stubs + [u] + [v]  nstub = nstub + 2 } }
                else { stubs = stubs + [u] + [v]  nstub = nstub + 2 }
            }
            attempts = attempts + 1
        }
    }
    return r
}
fn _topo_remove_at(xs: [int], k: int) -> [int] {
    let mut out = []
    let mut i = 0
    while i < len(xs) { if i != k { out = out + [xs[i]] } i = i + 1 }
    return out
}
// _topo_sym_norm — Â = D^-1/2 A D^-1/2 (대칭 정규화, 0-degree 노드는 0).
fn _topo_sym_norm(a: [[float]]) -> [[float]] {
    let n = len(a)
    let mut dinv = []
    let mut i = 0
    while i < n {
        let mut d = 0.0
        let mut j = 0
        while j < n { d = d + a[i][j]  j = j + 1 }
        if d > 0.000001 { dinv = dinv + [1.0 / sqrt(d)] } else { dinv = dinv + [0.0] }
        i = i + 1
    }
    let mut out = _topo_zeros(n)
    i = 0
    while i < n {
        let mut j = 0
        while j < n { out[i][j] = dinv[i] * a[i][j] * dinv[j]  j = j + 1 }
        i = i + 1
    }
    return out
}
// topo_apply — lane 신호를 인접 따라 한 스텝 확산: X' = X·(I + α·Â)ᵀ. 인접 lane 끼리 섞여 구조적
// cross-lane 공분산 생성. FLAT(A=0)은 X 불변. α 는 모든 토폴로지 공통(per-arm tune 아님).
pub fn topo_apply(x: [[float]], a: [[float]], alpha: float) -> [[float]] {
    let nt = len(x)
    let n = len(a)
    let ahat = _topo_sym_norm(a)
    // M = I + α·Â  (n×n)
    let mut mm = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            let mut v = alpha * ahat[i][j]
            if i == j { v = v + 1.0 }
            mm[i][j] = v
            j = j + 1
        }
        i = i + 1
    }
    // X' = X · Mᵀ  → out[t][i] = Σ_j X[t][j]·M[i][j]
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut row = []
        i = 0
        while i < n {
            let mut s = 0.0
            let mut j = 0
            while j < n { s = s + x[t][j] * mm[i][j]  j = j + 1 }
            row = row + [s]
            i = i + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}
// _topo_core — ≤8-lane CORE for the min-cut MIP (must be ≤8 for the faithful exact regime). Includes
// all 4 HUBS so the rich-club test is in-core. = [0,3,2,13(hubs),5,7,9,14].
fn _topo_core() -> [int] { return [0, 3, 2, 13, 5, 7, 9, 14] }

// topo_phi_brain/_flat/_random/_lateralized/_coords_shuffled — IIT4 MIN-CUT Φ(ci_phi_iit4) over the
// CORE of a population X diffused under each topology. THE topology-faithful headline measure.
pub fn topo_phi_flat(x: [[float]], alpha: float) -> float {
    // FLAT = no wiring → X unchanged.
    return ci_phi_iit4(x, _topo_core())
}
pub fn topo_phi_brain(x: [[float]], alpha: float) -> float {
    let xd = topo_apply(x, topo_brain_adjacency(), alpha)
    return ci_phi_iit4(xd, _topo_core())
}
pub fn topo_phi_random(x: [[float]], alpha: float, seed: int) -> float {
    let xd = topo_apply(x, topo_degree_matched_random(seed), alpha)
    return ci_phi_iit4(xd, _topo_core())
}
pub fn topo_phi_lateralized(x: [[float]], alpha: float) -> float {
    let xd = topo_apply(x, topo_lateralize_collapse(), alpha)
    return ci_phi_iit4(xd, _topo_core())
}
pub fn topo_phi_coords_shuffled(x: [[float]], alpha: float, seed: int) -> float {
    let xd = topo_apply(x, topo_shuffle_coords(seed), alpha)
    return ci_phi_iit4(xd, _topo_core())
}
// topo_phi_random_mean / _shuffle_mean / _geometry_shuffle_mean — average min-cut Φ over `nseed`
// independent random rewirings / full-topology shuffles / geometry-only shuffles. A single random
// draw is noisy (R2 finding: single-seed B can flip); the EXPECTATION over seeds is the frozen bar.
pub fn topo_phi_random_mean(x: [[float]], alpha: float, seed0: int, nseed: int) -> float {
    let mut s = 0.0
    let mut k = 0
    while k < nseed { s = s + topo_phi_random(x, alpha, seed0 + k * 7919)  k = k + 1 }
    if nseed == 0 { return 0.0 }
    return s / to_float(nseed)
}
pub fn topo_phi_shuffle_mean(x: [[float]], alpha: float, seed0: int, nseed: int) -> float {
    let mut s = 0.0
    let mut k = 0
    while k < nseed { s = s + topo_phi_coords_shuffled(x, alpha, seed0 + k * 7919)  k = k + 1 }
    if nseed == 0 { return 0.0 }
    return s / to_float(nseed)
}
pub fn topo_phi_geometry_shuffle_mean(x: [[float]], alpha: float, seed0: int, nseed: int) -> float {
    let mut s = 0.0
    let mut k = 0
    while k < nseed { s = s + topo_phi_geometry_shuffled(x, alpha, seed0 + k * 7919)  k = k + 1 }
    if nseed == 0 { return 0.0 }
    return s / to_float(nseed)
}
// topo_phi_hub_ablated — rich-club test: drop one CORE lane `lane` from the min-cut system on the
// BRAIN-diffused population → ΔΦ = Φ₀ − Φ(core∖lane). hub 절단이 peripheral 절단보다 ΔΦ 크면 hub 가
// load-bearing. core hubs=[0,3,2,13] · core peripherals=[5,7,9,14].
pub fn topo_phi_hub_ablated(x: [[float]], alpha: float, lane: int) -> float {
    let xd = topo_apply(x, topo_brain_adjacency(), alpha)
    let core = _topo_core()
    let phi0 = ci_phi_iit4(xd, core)
    let mut cols = []
    let mut i = 0
    while i < len(core) { if core[i] != lane { cols = cols + [core[i]] } i = i + 1 }
    if len(cols) < 2 { return phi0 }
    return phi0 - ci_phi_iit4(xd, cols)
}

