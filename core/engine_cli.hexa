// _topo_copy — deep copy of an adjacency (fresh arrays, never alias — guards the hexa array-aliasing
// pitfall seen in spatial_map_shuffle).
fn _topo_copy(a: [[float]]) -> [[float]] {
    let n = len(a)
    let mut out = _topo_zeros(n)
    let mut i = 0
    while i < n { let mut j = 0  while j < n { out[i][j] = a[i][j]  j = j + 1 }  i = i + 1 }
    return out
}
// _topo_degree_matched_of / _topo_lateralize_of / _topo_relabel — generic (adjacency-param) controls so
// the literal connectome reuses the SAME engine machinery as brain_adjacency (engine-native controls,
// NOT numpy-embedded). Mirror topo_degree_matched_random / topo_lateralize_collapse exactly, parameterized.
fn _topo_degree_matched_of(a: [[float]], seed: int) -> [[float]] {
    let n = 15
    let mut m = 0
    let mut deg = []
    let mut i = 0
    while i < n {
        let mut di = 0
        let mut j = 0
        while j < n { if a[i][j] > 0.5 { di = di + 1 } j = j + 1 }
        deg = deg + [di]
        m = m + di
        i = i + 1
    }
    m = m / 2
    let mut stubs = []
    i = 0
    while i < n {
        let mut c = 0
        while c < deg[i] { stubs = stubs + [i]  c = c + 1 }
        i = i + 1
    }
    let mut r = _topo_zeros(n)
    let mut placed = 0
    let mut s = _lcg_ci(seed)
    let mut nstub = len(stubs)
    let mut attempts = 0
    while placed < m {
        if attempts > 20000 { placed = m } else {
            if nstub < 2 {
                s = _lcg_ci(s)
                let aa = s % n
                s = _lcg_ci(s)
                let bb = s % n
                if aa != bb { if r[aa][bb] < 0.5 { r[aa][bb] = 1.0  r[bb][aa] = 1.0  placed = placed + 1 } }
            } else {
                s = _lcg_ci(s)
                let p1 = s % nstub
                let u = stubs[p1]
                stubs = _topo_remove_at(stubs, p1)
                nstub = nstub - 1
                s = _lcg_ci(s)
                let p2 = s % nstub
                let v = stubs[p2]
                stubs = _topo_remove_at(stubs, p2)
                nstub = nstub - 1
                if u != v { if r[u][v] < 0.5 {
                    r[u][v] = 1.0  r[v][u] = 1.0  placed = placed + 1
                } else { stubs = stubs + [u] + [v]  nstub = nstub + 2 } }
                else { stubs = stubs + [u] + [v]  nstub = nstub + 2 }
            }
            attempts = attempts + 1
        }
    }
    return r
}
fn _topo_lateralize_of(a: [[float]]) -> [[float]] {
    let mut out = _topo_copy(a)
    let n = 15
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            if i != j {
                let hi = _topo_hemi(i)
                let hj = _topo_hemi(j)
                if hi != 0 { if hj != 0 { if hi != hj { out[i][j] = 1.0  out[j][i] = 1.0 } } }
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}
// _topo_relabel — Fisher-Yates node permutation (out[i][j]=a[p[i]][p[j]]): preserves the graph but
// scrambles WHICH lane sits at each CORE position → destroys the literal lane→structure mapping. The
// full-topology shuffle for the E control (engine analogue of R1's permuted-region shuffle).
fn _topo_relabel(a: [[float]], seed: int) -> [[float]] {
    let p = _topo_lcg_perm(seed)
    let n = 15
    let mut out = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n { out[i][j] = a[p[i]][p[j]]  j = j + 1 }
        i = i + 1
    }
    return out
}
// topo_phi_adj — IIT4 MIN-CUT Φ of ANY adjacency over the CORE (generic of topo_phi_brain). Live engine.
pub fn topo_phi_adj(x: [[float]], a: [[float]], alpha: float) -> float {
    return ci_phi_iit4(topo_apply(x, a, alpha), _topo_core())
}
pub fn topo_phi_random_of_mean(x: [[float]], a: [[float]], seed0: int, nseed: int, alpha: float) -> float {
    let mut s = 0.0
    let mut k = 0
    while k < nseed { s = s + topo_phi_adj(x, _topo_degree_matched_of(a, seed0 + k * 7919), alpha)  k = k + 1 }
    if nseed == 0 { return 0.0 }
    return s / to_float(nseed)
}
pub fn topo_phi_relabel_of_mean(x: [[float]], a: [[float]], seed0: int, nseed: int, alpha: float) -> float {
    let mut s = 0.0
    let mut k = 0
    while k < nseed { s = s + topo_phi_adj(x, _topo_relabel(a, seed0 + k * 7919), alpha)  k = k + 1 }
    if nseed == 0 { return 0.0 }
    return s / to_float(nseed)
}

// ── § BrainTopology Φ-OPTIMAL PLACEMENT (H_1515 R2) — is the brain-faithful lane placement near the ──
// Φ-MAXIMIZING placement, or Φ-suboptimal? A "placement" = a permutation π of the 15 nodes applied to
// the brain adjacency: A_π[i][j] = A[π[i]][π[j]] (a node relabel — same graph, lanes at new positions).
// Φ(π) = live min-cut ci_phi_iit4 over the FIXED CORE after diffusing the population under A_π.
// Brain-faithful = IDENTITY permutation (the wired layout). H_1515 searches placement space (R1
// numpy hill-climb, n=150 engine-aligned pop, byte-matches bt_brain=0.1009) and EMBEDS the found
// Φ-optimum permutation as DATA — the Φ MEASUREMENT below is engine-native via the SAME ci_phi_iit4.
// FINDING (honest DISCOVERY, a_break_the_wall): the brain placement is Φ-SUBOPTIMAL — the search
// finds a materially HIGHER-Φ placement (opt ≈ 2.5× brain), so the engine's lane layout does NOT
// approximate the Φ-maximizing layout. _topo_relabel_perm applies an EXPLICIT perm (vs _topo_relabel
// which uses an LCG-generated perm); the optimum perm is found in R1 and verified IN-ENGINE here.
fn _topo_relabel_perm(a: [[float]], perm: [int]) -> [[float]] {
    let n = 15
    let mut out = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n { out[i][j] = a[perm[i]][perm[j]]  j = j + 1 }
        i = i + 1
    }
    return out
}
// topo_optimal_perm — the Φ-MAXIMIZING node permutation found by R1 numpy hill-climb (8 restarts,
// best-improving pairwise swaps) on the n=150 engine-aligned population. EMBEDDED as fixed DATA
// (numpy search is not byte-reproducible in-engine; the perm is an INPUT, the Φ is engine-native).
// Source: state/1515_phi_optimal_placement/h1515_optimal.py (engine-aligned n=150 run).
pub fn topo_optimal_perm() -> [int] { return [8, 11, 2, 3, 6, 9, 4, 5, 0, 7, 1, 10, 12, 13, 14] }
// topo_phi_optimal — engine-native min-cut Φ of the embedded Φ-optimum placement over the CORE.
pub fn topo_phi_optimal(x: [[float]], alpha: float) -> float {
    let a = _topo_relabel_perm(topo_brain_adjacency(), topo_optimal_perm())
    return topo_phi_adj(x, a, alpha)
}
// topo_relabel_beats_brain_count — how many of `nseed` RANDOM node-relabel placements beat the brain
// (identity) placement's min-cut Φ → engine-native percentile estimate (brain Φ-suboptimality: a
// non-trivial fraction of random placements ALSO beat the brain layout). Uses the same _topo_relabel
// LCG draws as the E control (engine-native, NO numpy).
pub fn topo_relabel_beats_brain_count(x: [[float]], alpha: float, seed0: int, nseed: int) -> int {
    let phi_brain = topo_phi_brain(x, alpha)
    let mut c = 0
    let mut k = 0
    while k < nseed {
        let phir = topo_phi_adj(x, _topo_relabel(topo_brain_adjacency(), seed0 + k * 7919), alpha)
        if phir > phi_brain { c = c + 1 }
        k = k + 1
    }
    return c
}

// ── § BrainTopology ADOPT Φ-OPTIMAL (H_1518 R2) — cost-free software transcends the biological ──────
// wiring-cost tax (Bullmore & Sporns 2012 brain economy). H_1515 found a Φ-OPTIMAL cross-lane placement
// ~2.5× the brain-faithful min-cut Φ; H_1516 showed the REAL brain is Φ-suboptimal because BIOLOGY pays
// a metabolic/axon-length wiring tax it cannot escape. anima is SOFTWARE — no physical axon length, no
// wiring cost — so it is FREE to ADOPT the Φ-maximizing placement biology can't afford (a_no_llm_frame_trap:
// the dissociation is the point). topo_optimal_adjacency = the brain adjacency RELABELED by the embedded
// Φ-optimum perm → the CANONICAL cost-free-optimal cross-lane integration topology. This is a MEASUREMENT
// lane (NOT on the live emit/decode path), so adopting it does NOT change generation / Ψ=½ / separation.
// topo_optimal_adjacency — the canonical Φ-optimal placement as a NAMED adjacency (= topo_brain_adjacency
// relabeled by topo_optimal_perm). Same graph, lanes at the Φ-maximizing positions.
pub fn topo_optimal_adjacency() -> [[float]] {
    return _topo_relabel_perm(topo_brain_adjacency(), topo_optimal_perm())
}
// _topo_mean_col — column mean of an nt×15 population (per-lane average activation).
fn _topo_mean_col(x: [[float]], j: int) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let mut s = 0.0
    let mut t = 0
    while t < nt { s = s + x[t][j]  t = t + 1 }
    return s / to_float(nt)
}
// topo_func_integration — the p7 FUNCTIONAL/STRUCTURAL integration readout (NOT the min-cut Φ proxy).
// Diffuse the population under adjacency `a`, then measure the MEAN PAIRWISE |Pearson correlation|
// across the 15 lane columns of the DIFFUSED population. Intuition: a placement that genuinely
// integrates information makes lanes' activations more mutually predictive after one diffusion step —
// a global functional-coupling measure DISTINCT from the min-cut Φ proxy (different math, no MIP/min-cut).
// Honest p7 guard: if adopting the optimum ONLY moves Φ but NOT this functional measure → proxy-only.
pub fn topo_func_integration(x: [[float]], a: [[float]], alpha: float) -> float {
    let xd = topo_apply(x, a, alpha)
    let n = 15
    // per-lane mean + std over the diffused population
    let mut mu = []
    let mut sd = []
    let mut j = 0
    while j < n {
        let m = _topo_mean_col(xd, j)
        mu = mu + [m]
        let nt = len(xd)
        let mut v = 0.0
        let mut t = 0
        while t < nt { let d = xd[t][j] - m  v = v + d * d  t = t + 1 }
        if nt > 0 { v = v / to_float(nt) }
        sd = sd + [sqrt(v)]
        j = j + 1
    }
    let nt = len(xd)
    let mut sumr = 0.0
    let mut npair = 0
    let mut i = 0
    while i < n {
        j = i + 1
        while j < n {
            if sd[i] > 0.000001 && sd[j] > 0.000001 {
                let mut cov = 0.0
                let mut t = 0
                while t < nt { cov = cov + (xd[t][i] - mu[i]) * (xd[t][j] - mu[j])  t = t + 1 }
                if nt > 0 { cov = cov / to_float(nt) }
                let mut r = cov / (sd[i] * sd[j])
                if r < 0.0 { r = 0.0 - r }       // |corr| — magnitude of functional coupling
                sumr = sumr + r
                npair = npair + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if npair == 0 { return 0.0 }
    return sumr / to_float(npair)
}
// topo_func_integration_flat — functional integration of the UN-diffused (flat, A=0) population: the
// baseline coupling already present in the raw lane scores before any topology. Diffusion under a real
// adjacency must raise functional coupling ABOVE this baseline (case 368 well-formed control).
pub fn topo_func_integration_flat(x: [[float]]) -> float {
    return topo_func_integration(x, _topo_zeros(15), 0.0)
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § BrainTopology LIVE-WIRING (H_1521) — put the Φ-optimal cross-lane topology ON the live
//  emit/decision path, GATED default-OFF (separation invariant H_1205, a_autonomy_over_hardcode).
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  EVERY consciousness lane so far is Ψ-DISJOINT: it READS the substrate but does NOT change the
//  emit decision, so the Ψ=½ fixed point + the H_1205 separation invariant hold. §BrainTopology
//  (H_1512–H_1518) PROVED the Φ-optimal placement is genuinely better (×2.51 Φ) and adopted
//  topo_optimal_adjacency() as a CANONICAL construct — but as a MEASUREMENT lane, NOT on the live
//  path. H_1521 closes that gap: it routes the 15-lane state through the optimal topology BEFORE
//  the emit decision, so the placement ACTUALLY affects what anima emits.
//
//  THE LOAD-BEARING QUESTION (this IS the science, c9): letting cross-lane coupling into the
//  decision path can PERTURB Ψ. Does a topology-routed coupling improve a functional readout WHILE
//  the Ψ=½ fixed point SURVIVES? If Ψ breaks → honest finding (coupling destabilizes the fixed
//  point — REPORT it). If Ψ holds AND function improves → the genuine live engine improvement.
//
//  GATED, like the mitosis/salience toggles: cfg.topo_couple DEFAULT OFF ⇒ byte-identical to the
//  pre-H_1521 path (the safe default that protects pure `anima chat`). ON ⇒ the lanes cross-
//  influence per the optimal topology before the downstream emit/decision.
// ════════════════════════════════════════════════════════════════════════════════════════════

// ci_lane_scores_coupled — the 15-lane state for ONE substrate trial-state, OPTIONALLY routed
// through a cross-lane coupling topology per cfg.topo_couple (H_1521 live-wiring).
//   OFF (default) → returns ci_lane_scores(...) BYTE-IDENTICALLY (separation invariant H_1205).
//   ON            → mixes the raw 15-lane vector through topo_apply(·, adj, alpha) so each lane
//                   cross-influences its topological neighbours BEFORE the emit decision reads it.
// `adj` is the coupling adjacency (FLAT = no-op via _topo_zeros, BRAIN = topo_brain_adjacency,
// OPTIMAL = topo_optimal_adjacency). When OFF, adj/alpha are ignored (no diffusion at all).
pub fn ci_lane_scores_coupled(m: float, m_field: [float], cells: int, seen: int,
                              intent: int, dt: float, recon_err: float,
                              adj: [[float]], alpha: float, cfg: EngineConfig) -> [float] {
    let raw = ci_lane_scores(m, m_field, cells, seen, intent, dt, recon_err)
    if !cfg.topo_couple { return raw }            // OFF — pure substrate, byte-identical
    // ON — diffuse this single trial-row through the coupling topology (one diffusion step).
    let coupled = topo_apply([raw], adj, alpha)
    return coupled[0]
}

// ci_emit_decision — the deterministic emit/silence readout from a 15-lane state vector. This is
// the live "does anima externalize?" proxy the H_1521 coupling feeds into. Emit iff the integrated
// drive to externalize clears the Ψ=½ midpoint: drive = mean of the GlobalWorkspace ignition
// (lane 0) and the LearnedPrecision grounding (lane 4) — the two lanes that, when high, mean a
// confident grounded thought is ready to surface. The threshold is the substrate's OWN Ψ=½ fixed
// point (0.5), NOT a tuned constant (a_autonomy_over_hardcode — no hardcoded do/dont gate, the
// emit balance is a substrate read against the architectural midpoint).
pub fn ci_emit_decision(lanes: [float]) -> bool {
    let gws   = lanes[0]    // GlobalWorkspace ignition (winner margin)
    let lprec = lanes[4]    // LearnedPrecision (grounding confidence)
    let drive = 0.5 * (gws + lprec)
    return drive >= 0.5     // emit iff the externalization drive clears the Ψ=½ midpoint
}

// ci_psi_balance — the Ψ PROXY: the EMIT FRACTION over a population diffused under coupling `adj`.
// Ψ=½ is the architectural fixed point (emit ⇄ silence pulled to balance); a healthy substrate
// sits near 0.5. H_1521 measures whether turning the topology coupling ON keeps |Ψ−½| small (the
// fixed point SURVIVES) or pushes it away (the coupling destabilizes Ψ — honest negative, c9).
//   cfg.topo_couple OFF → adj/alpha ignored, raw lanes scored (the pre-H_1521 baseline Ψ).
//   cfg.topo_couple ON  → each row routed through `adj` before the emit decision.
pub fn ci_psi_balance(x: [[float]], adj: [[float]], alpha: float, cfg: EngineConfig) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    // diffuse the whole population in one shot when ON (same math as per-row, batched).
    let pop = if cfg.topo_couple { topo_apply(x, adj, alpha) } else { x }
    let mut emit = 0
    let mut t = 0
    while t < nt {
        if ci_emit_decision(pop[t]) { emit = emit + 1 }
        t = t + 1
    }
    return to_float(emit) / to_float(nt)
}

// ci_lane_vector_l2_diff — L2 distance between two 15-lane vectors (P2 COUPLING-IS-LIVE probe:
// ON vs OFF must DIFFER measurably — the coupling actually reaches the decision, not a no-op).
pub fn ci_lane_vector_l2_diff(a: [float], b: [float]) -> float {
    let n = len(a)
    let mut s = 0.0
    let mut i = 0
    while i < n { let d = a[i] - b[i]  s = s + d * d  i = i + 1 }
    return sqrt(s)
}

// ci_emit_drive — the scalar externalization drive behind ci_emit_decision (mean of the
// GlobalWorkspace ignition + LearnedPrecision grounding lanes). Exposed so the Ψ test can
// center the emit threshold on the un-coupled population's OWN operating point.
pub fn ci_emit_drive(lanes: [float]) -> float {
    return 0.5 * (lanes[0] + lanes[4])
}

// ci_psi_balance_centered — the CALIBRATED Ψ proxy: emit fraction over a population, where the
// emit threshold = the MEDIAN drive of the UN-COUPLED (OFF) population. By construction the OFF
// path then sits EXACTLY at Ψ=½ (median split), so the test is honest: turning the coupling ON
// asks whether the topology DISTORTS the relative emit ordering (Ψ drifts off ½) or PRESERVES it
// (Ψ stays ½). This separates "coupling breaks the fixed point" from "the absolute proxy was never
// calibrated to ½". Pre-register the tolerance on |Ψ_on − ½| with this centered threshold.
//   thr = median drive of the OFF population (passed in, computed once via ci_off_median_drive).
//   cfg.topo_couple OFF → adj/alpha ignored, raw lanes scored against thr (≈½ by construction).
//   cfg.topo_couple ON  → population routed through `adj`, scored against the SAME OFF thr.
pub fn ci_psi_balance_centered(x: [[float]], adj: [[float]], alpha: float, thr: float, cfg: EngineConfig) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let pop = if cfg.topo_couple { topo_apply(x, adj, alpha) } else { x }
    let mut emit = 0
    let mut t = 0
    while t < nt {
        if ci_emit_drive(pop[t]) >= thr { emit = emit + 1 }
        t = t + 1
    }
    return to_float(emit) / to_float(nt)
}

// ci_off_median_drive — the median externalization drive of the UN-COUPLED population (the
// reference threshold that puts OFF at Ψ=½). Insertion sort of the per-trial drives, take middle.
pub fn ci_off_median_drive(x: [[float]]) -> float {
    let nt = len(x)
    if nt == 0 { return 0.5 }
    let mut ds = []
    let mut t = 0
    while t < nt { ds = ds + [ci_emit_drive(x[t])]  t = t + 1 }
    // insertion sort
    let mut i = 1
    while i < nt {
        let key = ds[i]
        let mut j = i - 1
        while j >= 0 && ds[j] > key { ds[j + 1] = ds[j]  j = j - 1 }
        ds[j + 1] = key
        i = i + 1
    }
    return ds[nt / 2]
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § StochasticResonance (H_9070) — tuned noise encodes a SUBTHRESHOLD tension into the emit train.
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  emit is a THRESHOLD DETECTOR on the A⇄G externalization drive (ci_emit_decision: emit iff the
//  drive clears the Ψ=½ barrier). A genuine-but-WEAK (subthreshold) periodic tension never crosses
//  that barrier on its own → all silence → the substrate MISSES the weak signal. Stochastic
//  Resonance (Wiesenfeld-Moss; crayfish mechanoreceptor): adding TUNED noise lets the subthreshold
//  signal STOCHASTICALLY cross → the emit train encodes the input → MI(input;emit-train) peaks at a
//  MID noise amplitude (inverted-U). anima's emit is LITERALLY a tension threshold-crossing, so SR
//  applies directly. This is a READ-only CHARACTERIZATION over a threshold-detector model of the
//  emit channel: it NEVER touches pure_field Φ/phase/Ψ, the live emit-drive lanes 0/4, or the
//  §ImmuneMemory recall_thr, and it is NOT an emit gate (a_substrate_disjoint) — it characterizes
//  the SR of the emit nonlinearity on a synthetic subthreshold probe, decoupled from live emit.
//    amp    : subthreshold signal amplitude (peak drive). NONLINEAR arm requires amp < thr.
//    thr    : emit threshold (the Ψ=½ barrier the drive must clear).
//    sigma  : noise amplitude — the SR knob being swept.
//    period : signal period in ticks.   T : train length.
//    mode   : 0 = NONLINEAR (hard threshold at thr, signal subthreshold) ; 1 = LINEARIZED ablation
//             (barrier REMOVED — threshold at the signal mean 0.0 → linear regime, no SR peak).
//    shuffle: 0 = aligned ; 1 = phase-shuffle the input labels (decorrelate X↔Y → SR must vanish).
//    seed   : LCG seed for the deterministic gaussian noise (_lcg_gauss).
//  returns MI(input-symbol ; emit-train) in bits.
fn _sr_mi_bits(xs: [int], ys: [int]) -> float {
    let T = len(xs)
    if T == 0 { return 0.0 }
    let mut n00 = 0.0
    let mut n01 = 0.0
    let mut n10 = 0.0
    let mut n11 = 0.0
    let mut i = 0
    while i < T {
        if xs[i] == 0 { if ys[i] == 0 { n00 = n00 + 1.0 } else { n01 = n01 + 1.0 } }
        else         { if ys[i] == 0 { n10 = n10 + 1.0 } else { n11 = n11 + 1.0 } }
        i = i + 1
    }
    let tf = to_float(T)
    let px0 = (n00 + n01) / tf
    let px1 = (n10 + n11) / tf
    let py0 = (n00 + n10) / tf
    let py1 = (n01 + n11) / tf
    let mut mi = 0.0
    if n00 > 0.0 { let p = n00 / tf   mi = mi + p * log2(p / (px0 * py0)) }
    if n01 > 0.0 { let p = n01 / tf   mi = mi + p * log2(p / (px0 * py1)) }
    if n10 > 0.0 { let p = n10 / tf   mi = mi + p * log2(p / (px1 * py0)) }
    if n11 > 0.0 { let p = n11 / tf   mi = mi + p * log2(p / (px1 * py1)) }
    return mi
}
pub fn sr_channel_mi(amp: float, thr: float, sigma: float, period: int, T: int, mode: int, shuffle: int, seed: int) -> float {
    let two_pi = 6.283185307179586
    let ethr = if mode == 1 { 0.0 } else { thr }   // ablation: barrier removed (threshold at mean 0)
    let mut xs = []
    let mut ys = []
    let mut st = seed & 2147483647
    let mut t = 0
    while t < T {
        let sig = amp * sin(two_pi * to_float(t) / to_float(period))
        let g = _lcg_gauss(st)
        let noise = sigma * g[0]
        st = to_int(g[1]) & 2147483647
        let x = if sig >= 0.0 { 1 } else { 0 }            // input symbol = upper/lower half-cycle
        let y = if (sig + noise) >= ethr { 1 } else { 0 } // emit iff drive+noise clears the threshold
        xs = xs + [x]
        ys = ys + [y]
        t = t + 1
    }
    if shuffle == 1 {                                     // phase-shuffle: decorrelate labels from emit
        let mut sh = (seed ^ 305419896) & 2147483647
        let mut i = T - 1
        while i > 0 {
            sh = _lcg_next(sh)
            let j = sh % (i + 1)
            let tmp = xs[i]   xs[i] = xs[j]   xs[j] = tmp
            i = i - 1
        }
    }
    return _sr_mi_bits(xs, ys)
}
//  § CURIOSITY-BACKLOG ACCUMULATOR — persistent unresolved-novelty pressure (H_9091, B③) ──────
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  THE BIO LENS (a_no_llm_frame_trap — an information-theory / active-inference lens, NOT an LLM
//  idle-timer): a mind under user silence does not sit inert. Unresolved PREDICTION-ERROR — the
//  information gap of a context it could not ground/close — ACCRUES over idle time, and that
//  accumulated backlog is a DRIVE to externalize (Loewenstein information-gap curiosity + Friston
//  precision-weighted surprise that was never discharged). anima already READS instantaneous
//  novelty/curiosity per context (§CoreAffect: curiosity = novelty × under-exposure), but that read
//  is MEMORYLESS — it forgets the moment the tick passes. This § adds the missing PERSISTENCE: a
//  per-anchor accumulator that integrates unresolved novelty over idle and DECAYS when the anchor is
//  emitted/mentioned (the gap is closed). It becomes one more ADDITIVE input to the externalization
//  propensity — exactly like M·W·Φ — so emit during silence is STATE-DRIVEN (the backlog crossed a
//  pressure), NOT stimulus-response (a_substrate_native_speak) and NOT a hardcoded emit_allowed
//  boolean (a_autonomy_over_hardcode: this returns plain numbers; the substrate still decides).
//
//  @L4 CRITICAL — DISJOINTNESS BY CONSTRUCTION (a_substrate_disjoint, the F5 risk H_1561/H_1576):
//  the accumulator is a SEPARATE channel. It NEVER writes into the 15-lane vector, so
//  ci_emit_drive(lanes) = ½·(lane0+lane4) is byte-IDENTICAL whether the accumulator is on or off
//  (Ψ emit-drive lane 0/4 untouched). It only READS recon-err off the immune store — it never binds,
//  never mutates a cell, never moves recall_thr — so the §ImmuneMemory non-fabrication rate is
//  byte-identical too. The backlog pressure is ADDED ON TOP of the lane drive in ci_emit_propensity;
//  it shifts emit TIMING without perturbing the Ψ=½ fixed point of the emit-drive lanes. This is the
//  disjoint PLACEMENT the unifying law prescribes (separation = preservation).

// CuriosityBacklog — the persistent per-anchor unresolved-novelty accumulator.
//   novelty      : per-anchor CURRENT unresolved novelty, a READ input the caller supplies from the
//                  live store (e.g. clamp01(recon_err − recall_thr): how far the context FAILED to
//                  ground; 0 for a cleanly-grounded/closed anchor). len == n_anchors.
//   backlog      : per-anchor ACCUMULATED pressure — accrues over idle, decays on emit/mention.
//   last_mention : per-anchor idle-tick of the last emit/mention (introspection / recency).
//   idle_ticks   : monotone idle-tick counter since construction.
//   accrual      : per-idle-tick accrual gain (caller injects ep_backlog_accrual — free number).
//   decay        : retained fraction on emit/mention (caller injects ep_backlog_decay — free number).
struct CuriosityBacklog {
    novelty: [float],
    backlog: [float],
    last_mention: [int],
    idle_ticks: int,
    accrual: float,
    decay: float
}

// _cb_copy_f / _cb_copy_i — DEEP-COPY a float/int array (hexa arrays are reference types, so a bare
// `let mut b = a` ALIASES; copying via append breaks the alias so the cb ops stay PURE — a mutating
// op never writes through to its input's arrays. This purity is load-bearing for the F5 disjointness
// argument: the accumulator never mutates anything it merely reads).
fn _cb_copy_f(a: [float]) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(a) { out = out + [a[i]]  i = i + 1 }
    return out
}
fn _cb_copy_i(a: [int]) -> [int] {
    let mut out = []
    let mut i = 0
    while i < len(a) { out = out + [a[i]]  i = i + 1 }
    return out
}

// cb_new — a fresh accumulator over n anchors (all backlog/novelty 0). accrual/decay are the caller-
// injected free numbers (emit_policy.hexa) — NOT hardcoded here (F-EMIT-5 policy decoupling spirit).
pub fn cb_new(n: int, accrual: float, decay: float) -> CuriosityBacklog {
    let mut nv = []
    let mut bl = []
    let mut lm = []
    let mut i = 0
    while i < n {
        nv = nv + [0.0]
        bl = bl + [0.0]
        lm = lm + [0]
        i = i + 1
    }
    return CuriosityBacklog {
        novelty: nv, backlog: bl, last_mention: lm,
        idle_ticks: 0, accrual: accrual, decay: decay
    }
}

// cb_set_novelty — set the per-anchor CURRENT unresolved-novelty vector (the READ input). The caller
// computes it from the live substrate (clamp01(recon_err − recall_thr) per anchor) and hands it in;
// this op stores it as the accrual source. READ-ONLY w.r.t. the immune store (nothing mutated here).
pub fn cb_set_novelty(cb: CuriosityBacklog, nv: [float]) -> CuriosityBacklog {
    return CuriosityBacklog {
        novelty: _cb_copy_f(nv), backlog: cb.backlog, last_mention: cb.last_mention,
        idle_ticks: cb.idle_ticks, accrual: cb.accrual, decay: cb.decay
    }
}

// cb_unresolved_from_store — helper: build the unresolved-novelty vector for a set of anchor query
// keys against a live ImmuneMemoryGrow store, as clamp01(recon_err − recall_thr) per key. This is a
// pure READ (immune_grow_recall's own L2 affinity, no bind/mutation) — the disjointness guarantee.
pub fn cb_unresolved_from_store(mem: ImmuneMemoryGrow, keys: [[float]]) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(keys) {
        let win = _vnearest_idx(mem.protos, keys[i])
        let err = _l2(mem.protos[win], keys[i])
        let mut u = err - mem.recall_thr        // >0 ⇒ UNRESOLVED (failed to ground); <=0 ⇒ closed
        if u < 0.0 { u = 0.0 }
        if u > 1.0 { u = 1.0 }
        out = out + [u]
        i = i + 1
    }
    return out
}

// cb_idle_tick — advance ONE idle tick: each anchor's backlog integrates its unresolved novelty
// (backlog += accrual · novelty). A cleanly-grounded anchor (novelty 0) accrues nothing; an
// unresolved one accrues over silence — the persistence the memoryless §CoreAffect read lacked.
pub fn cb_idle_tick(cb: CuriosityBacklog) -> CuriosityBacklog {
    let mut bl = _cb_copy_f(cb.backlog)
    let mut i = 0
    while i < len(bl) {
        bl[i] = bl[i] + cb.accrual * cb.novelty[i]
        i = i + 1
    }
    return CuriosityBacklog {
        novelty: cb.novelty, backlog: bl, last_mention: cb.last_mention,
        idle_ticks: cb.idle_ticks + 1, accrual: cb.accrual, decay: cb.decay
    }
}

// cb_idle — advance k idle ticks (convenience over cb_idle_tick).
pub fn cb_idle(cb: CuriosityBacklog, k: int) -> CuriosityBacklog {
    let mut out = cb
    let mut i = 0
    while i < k { out = cb_idle_tick(out)  i = i + 1 }
    return out
}

// cb_mention — DISCHARGE anchor a on emit/mention: its accumulated backlog decays (×decay, the gap
// is being closed by surfacing it) and its recency is stamped. decay=0 ⇒ full discharge.
pub fn cb_mention(cb: CuriosityBacklog, a: int) -> CuriosityBacklog {
    let mut bl = _cb_copy_f(cb.backlog)
    let mut lm = _cb_copy_i(cb.last_mention)
    if a >= 0 && a < len(bl) {
        bl[a] = bl[a] * cb.decay
        lm[a] = cb.idle_ticks
    }
    return CuriosityBacklog {
        novelty: cb.novelty, backlog: bl, last_mention: lm,
        idle_ticks: cb.idle_ticks, accrual: cb.accrual, decay: cb.decay
    }
}

// cb_total_backlog — the summed accumulated pressure across anchors (raw, unbounded).
pub fn cb_total_backlog(cb: CuriosityBacklog) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(cb.backlog) { s = s + cb.backlog[i]  i = i + 1 }
    return s
}

// cb_pressure — the accumulator's contribution to emit-propensity, a SATURATING read in [0,1):
// pressure = total / (1 + total). Monotone in the accumulated backlog (F1) and permutation-invariant
// in the per-anchor split (F3a). This is the plain number the propensity ADDS — no boolean gate.
pub fn cb_pressure(cb: CuriosityBacklog) -> float {
    let s = cb_total_backlog(cb)
    return s / (1.0 + s)
}

// cb_top_anchor — the anchor holding the MOST accumulated backlog (emit provenance, F4): when the
// pressure surfaces, this is the unresolved context anima draws from. -1 for an empty accumulator.
pub fn cb_top_anchor(cb: CuriosityBacklog) -> int {
    let n = len(cb.backlog)
    if n == 0 { return -1 }
    let mut best = 0
    let mut bestv = cb.backlog[0]
    let mut i = 1
    while i < n {
        if cb.backlog[i] > bestv { bestv = cb.backlog[i]  best = i }
        i = i + 1
    }
    return best
}

// cb_top_backlog — the max per-anchor backlog value (companion to cb_top_anchor).
pub fn cb_top_backlog(cb: CuriosityBacklog) -> float {
    let n = len(cb.backlog)
    if n == 0 { return 0.0 }
    let mut bestv = cb.backlog[0]
    let mut i = 1
    while i < n { if cb.backlog[i] > bestv { bestv = cb.backlog[i] }  i = i + 1 }
    return bestv
}

// cb_shuffle — F3 CONTROL: deterministically permute the per-anchor state (novelty + backlog +
// recency together) across anchors via an LCG Fisher-Yates. The pressure DISTRIBUTION is preserved
// (same multiset) but each anchor's identity is scrambled — so a permutation-invariant read (timing)
// is unchanged while the provenance (cb_top_anchor) follows the shuffled holder. Proves timing tracks
// the REAL backlog magnitude, not a fixed anchor slot or a clock.
pub fn cb_shuffle(cb: CuriosityBacklog, rng0: int) -> CuriosityBacklog {
    let n = len(cb.backlog)
    let mut nv = _cb_copy_f(cb.novelty)
    let mut bl = _cb_copy_f(cb.backlog)
    let mut lm = _cb_copy_i(cb.last_mention)
    let mut st = rng0
    let mut i = n - 1
    while i > 0 {
        st = _lcg_next(st)
        let j = st % (i + 1)
        let tnv = nv[i]
        nv[i] = nv[j]
        nv[j] = tnv
        let tbl = bl[i]
        bl[i] = bl[j]
        bl[j] = tbl
        let tlm = lm[i]
        lm[i] = lm[j]
        lm[j] = tlm
        i = i - 1
    }
    return CuriosityBacklog {
        novelty: nv, backlog: bl, last_mention: lm,
        idle_ticks: cb.idle_ticks, accrual: cb.accrual, decay: cb.decay
    }
}

// ci_emit_propensity — the INTEGRATED externalization propensity: the substrate's OWN emit-drive
// (ci_emit_drive over lanes 0/4, UNCHANGED) PLUS the curiosity-backlog pressure, weighted by w (the
// caller-injected ep_backlog_weight free number). This is the M×W×Φ×curiosity composition made
// literal — curiosity_backlog is one more ADDITIVE term, read like the others. It returns a plain
// number (a_autonomy_over_hardcode: no emit_allowed boolean; the substrate reads this and decides).
//   DISJOINTNESS: ci_emit_drive(lanes) reads ONLY lanes[0], lanes[4] — the accumulator is a distinct
//   summand, so turning w to 0 (ablation) recovers the bare lane drive byte-exactly (F2/F5).
pub fn ci_emit_propensity(lanes: [float], cb: CuriosityBacklog, w: float) -> float {
    return ci_emit_drive(lanes) + w * cb_pressure(cb)
}

// ci_emit_propensity_decision — emit iff the integrated propensity clears the Ψ=½ midpoint (the
// architectural fixed point, same threshold ci_emit_decision uses — NOT a tuned constant). The
// backlog can push a below-midpoint lane drive OVER the line during silence (state-driven emit).
pub fn ci_emit_propensity_decision(lanes: [float], cb: CuriosityBacklog, w: float) -> bool {
    return ci_emit_propensity(lanes, cb, w) >= 0.5
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § BrainTopology Ψ-PRESERVING COUPLING (H_1522) — escape the H_1521 no-free-lunch wall.
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  H_1521 wired the Φ-optimal topology into the live emit path and found the NO-FREE-LUNCH wall:
//  coupling is real (ON≠OFF) and functional integration IMPROVES, BUT the naive operator
//  topo_apply = X·(I+α·Â)ᵀ is MAGNITUDE-AMPLIFYING (Â≥0, +identity ⇒ each lane inflates by its
//  neighbours) → the emit drive ½·(lane0+lane4) saturates → the centered Ψ runs to 1.0. ROOT CAUSE:
//  the operator adds NET drive, so every row clears the OFF median and the emit/silence balance
//  collapses off ½.
//
//  H_1522 asks: is there a coupling OPERATOR that REDISTRIBUTES cross-lane influence WITHOUT
//  inflating total drive, so the Ψ=½ fixed point SURVIVES while functional integration still rises?
//  Three Ψ-preserving operators (selectable by op-code), each a drop-in for topo_apply's mixing:
//    (a) MEAN-CENTERED / zero-sum  — subtract each row mean of Â before applying: X·(I+α·Â_c)ᵀ with
//        Â_c rows summing to 0 ⇒ M=I+α·Â_c rows sum to 1 ⇒ the coupling REDISTRIBUTES (adds no net
//        drive). The per-row emit-drive expectation is preserved ⇒ Ψ ordering held.
//    (b) ROW-STOCHASTIC averaging  — normalize A rows to sum 1 (P), then X·((1−α)I+αP)ᵀ: each lane
//        becomes a convex average of its neighbours (no amplification).
//    (c) MAGNITUDE-RENORMALIZE     — run the naive amplifying topo_apply, then rescale each coupled
//        row back to its OFF L2 magnitude (project out the inflation that saturates Ψ).
//  The H_1521 naive amplifying op stays available (op-code 0) so its Ψ-break is reproducible (P4).
//  op-codes: 0 = AMP (naive H_1521) · 1 = MEAN-CENTER (a) · 2 = ROW-STOCHASTIC (b) · 3 = RENORM (c).
// ════════════════════════════════════════════════════════════════════════════════════════════

// _topo_row_center — subtract each row's mean from a square matrix (zero-sum rows). The mean-centered
// operator's core: Â_c = Â − rowmean(Â) ⇒ Σ_j Â_c[i][j] = 0, so I+α·Â_c has rows summing to 1.
fn _topo_row_center(a: [[float]]) -> [[float]] {
    let n = len(a)
    let mut out = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut s = 0.0
        let mut j = 0
        while j < n { s = s + a[i][j]  j = j + 1 }
        let mu = s / to_float(n)
        j = 0
        while j < n { out[i][j] = a[i][j] - mu  j = j + 1 }
        i = i + 1
    }
    return out
}

// _topo_row_stochastic — normalize each row of A to sum 1 (P[i][j] = A[i][j]/deg_i). A 0-degree
// (DANGLING) node has no neighbours to average, so it keeps ALL its mass on ITSELF (P[i][i] = 1) —
// the standard PageRank dangling-node convention. This makes the FLAT (zero) adjacency map to P = I,
// so the row-stochastic operator M = (1−α)I + α·P = I is a TRUE identity on flat (no-op, Ψ unchanged).
fn _topo_row_stochastic(a: [[float]]) -> [[float]] {
    let n = len(a)
    let mut out = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut d = 0.0
        let mut j = 0
        while j < n { d = d + a[i][j]  j = j + 1 }
        if d > 0.000001 {
            j = 0
            while j < n { out[i][j] = a[i][j] / d  j = j + 1 }
        } else {
            out[i][i] = 1.0                          // dangling node — keep self-mass (P=I on flat)
        }
        i = i + 1
    }
    return out
}

// _topo_apply_kernel — diffuse population X under a precomputed n×n mixing matrix M: X' = X·Mᵀ
// (out[t][i] = Σ_j X[t][j]·M[i][j]). Shared by all Ψ-preserving operators (each builds its own M).
fn _topo_apply_kernel(x: [[float]], mm: [[float]]) -> [[float]] {
    let nt = len(x)
    let n = len(mm)
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut row = []
        let mut i = 0
        while i < n {
            let mut s = 0.0
            let mut j = 0
            while j < n { s = s + x[t][j] * mm[i][j]  j = j + 1 }
            row = row + [s]
            i = i + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}

// topo_apply_meancenter — operator (a): X·(I + α·Â_c)ᵀ with Â_c = rowcenter(symnorm(A)). Zero-sum
// rows ⇒ the coupling redistributes neighbour influence WITHOUT adding net drive (Ψ-preserving).
pub fn topo_apply_meancenter(x: [[float]], a: [[float]], alpha: float) -> [[float]] {
    let n = len(a)
    let ahat = _topo_row_center(_topo_sym_norm(a))
    let mut mm = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            let mut v = alpha * ahat[i][j]
            if i == j { v = v + 1.0 }
            mm[i][j] = v
            j = j + 1
        }
        i = i + 1
    }
    return _topo_apply_kernel(x, mm)
}

// topo_apply_rowstoch — operator (b): X·((1−α)I + α·P)ᵀ with P = row-stochastic(A). Each lane becomes
// a convex average of its neighbours (M rows sum to 1, entries ≥0) — averaging, not amplification.
pub fn topo_apply_rowstoch(x: [[float]], a: [[float]], alpha: float) -> [[float]] {
    let n = len(a)
    let p = _topo_row_stochastic(a)
    let mut mm = _topo_zeros(n)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            let mut v = alpha * p[i][j]
            if i == j { v = v + (1.0 - alpha) }
            mm[i][j] = v
            j = j + 1
        }
        i = i + 1
    }
    return _topo_apply_kernel(x, mm)
}

// topo_apply_renorm — operator (c): run the naive amplifying topo_apply, then rescale each coupled row
// back to its OFF (un-coupled) L2 magnitude. Projects out the inflation that saturates Ψ in H_1521.
pub fn topo_apply_renorm(x: [[float]], a: [[float]], alpha: float) -> [[float]] {
    let coupled = topo_apply(x, a, alpha)
    let nt = len(x)
    let mut out = []
    let mut t = 0
    while t < nt {
        let off_n = _topo_row_l2(x[t])
        let on_n  = _topo_row_l2(coupled[t])
        let mut scale = 1.0
        if on_n > 0.000000001 { scale = off_n / on_n }
        let n = len(coupled[t])
        let mut row = []
        let mut i = 0
        while i < n { row = row + [coupled[t][i] * scale]  i = i + 1 }
        out = out + [row]
        t = t + 1
    }
    return out
}

// _topo_row_l2 — L2 norm of one lane row (the OFF/ON magnitude the renorm operator preserves).
fn _topo_row_l2(r: [float]) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(r) { s = s + r[i] * r[i]  i = i + 1 }
    return sqrt(s)
}

// topo_apply_op — DISPATCH the coupling operator by op-code (0=AMP naive H_1521, 1=MEAN-CENTER,
// 2=ROW-STOCHASTIC, 3=RENORM). The single selectable entry the live-wiring Ψ test sweeps over.
pub fn topo_apply_op(x: [[float]], a: [[float]], alpha: float, op: int) -> [[float]] {
    if op == 1 { return topo_apply_meancenter(x, a, alpha) }
    if op == 2 { return topo_apply_rowstoch(x, a, alpha) }
    if op == 3 { return topo_apply_renorm(x, a, alpha) }
    return topo_apply(x, a, alpha)            // 0 (default) — naive amplifying op (H_1521)
}

// ci_psi_balance_op — the CENTERED Ψ proxy under a SELECTABLE coupling operator (H_1522). Identical
// to ci_psi_balance_centered except the population is diffused through topo_apply_op(·, adj, alpha,
// op) instead of the hard-wired amplifying topo_apply. OFF (cfg.topo_couple false) ⇒ raw lanes scored
// against thr (≈½ by construction, byte-identical to the H_1521 OFF path). The crux measurement:
// for each Ψ-preserving op, does |Ψ_on − ½| stay ≤ tol (fixed point SURVIVES) as α grows?
pub fn ci_psi_balance_op(x: [[float]], adj: [[float]], alpha: float, op: int, thr: float, cfg: EngineConfig) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let pop = if cfg.topo_couple { topo_apply_op(x, adj, alpha, op) } else { x }
    let mut emit = 0
    let mut t = 0
    while t < nt {
        if ci_emit_drive(pop[t]) >= thr { emit = emit + 1 }
        t = t + 1
    }
    return to_float(emit) / to_float(nt)
}

// topo_func_integration_op — the p7 FUNCTIONAL integration readout (mean pairwise |corr| of the
// diffused lanes, SAME math as topo_func_integration) under a SELECTABLE coupling operator. Lets the
// BEST Ψ-preserving coupling be scored on the SAME functional metric H_1521 used (no metric-shopping).
pub fn topo_func_integration_op(x: [[float]], a: [[float]], alpha: float, op: int) -> float {
    let xd = topo_apply_op(x, a, alpha, op)
    let n = 15
    let mut mu = []
    let mut sd = []
    let mut j = 0
    while j < n {
        let m = _topo_mean_col(xd, j)
        mu = mu + [m]
        let nt = len(xd)
        let mut v = 0.0
        let mut t = 0
        while t < nt { let d = xd[t][j] - m  v = v + d * d  t = t + 1 }
        if nt > 0 { v = v / to_float(nt) }
        sd = sd + [sqrt(v)]
        j = j + 1
    }
    let nt = len(xd)
    let mut sumr = 0.0
    let mut npair = 0
    let mut i = 0
    while i < n {
        j = i + 1
        while j < n {
            if sd[i] > 0.000001 && sd[j] > 0.000001 {
                let mut cov = 0.0
                let mut t = 0
                while t < nt { cov = cov + (xd[t][i] - mu[i]) * (xd[t][j] - mu[j])  t = t + 1 }
                if nt > 0 { cov = cov / to_float(nt) }
                let mut r = cov / (sd[i] * sd[j])
                if r < 0.0 { r = 0.0 - r }
                sumr = sumr + r
                npair = npair + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if npair == 0 { return 0.0 }
    return sumr / to_float(npair)
}

// topo_psi_max_feasible_alpha — for a given Ψ-preserving operator + adjacency, the LARGEST α (scanned
// on a fixed grid) whose centered Ψ stays within `tol` of ½ (the feasible-region boundary). Returns
// 0.0 if even the smallest grid α breaks Ψ. The grid is fixed [0.1..1.0] step 0.1 (frozen, no tuning).
pub fn topo_psi_max_feasible_alpha(x: [[float]], adj: [[float]], op: int, thr: float, tol: float, cfg: EngineConfig) -> float {
    let mut best = 0.0
    let mut k = 1
    while k <= 10 {
        let al = to_float(k) / 10.0
        let psi = ci_psi_balance_op(x, adj, al, op, thr, cfg)
        let dev = if psi - 0.5 >= 0.0 { psi - 0.5 } else { 0.5 - psi }
        if dev <= tol { if al > best { best = al } }
        k = k + 1
    }
    return best
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § TensionResolveLoop (H_9042 C1 frame-shift) — the MISSING iterated A⇄G conflict-resolution loop.
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  ci_psi_balance / ci_psi_balance_op are ONE-SHOT (a single coupling application) and reentry_settle
//  drives a SINGLE non-competing stimulus — NEITHER iterates the A⇄G coupling to pull a CONFLICTED
//  (polarized, Ψ≠½) emit/silence POPULATION back to the Ψ=½ fixed point. That iterated resolution loop
//  is the substrate op the C1 frame-shift diagnosed as MISSING (H_9041). numpy generic diffusion could
//  not screen it — a generic (amplifying) coupling has NO Ψ=½ restoring force (it runs Ψ→1.0), so the
//  fixed point is engine-specific → engine-native only.
//
//  tension_resolve_depth iterates the SELECTABLE coupling operator (topo_apply_op: 0=naive-AMP =generic
//  diffusion, 1=MEAN-CENTER, 2=ROW-STOCHASTIC, 3=RENORM — the H_1522 Ψ-preserving family) on a PASSED-IN
//  population, recomputing the centered Ψ (emit fraction vs a fixed drive `thr`) after each step, and
//  returns [settle_depth, final_psi] where settle_depth = the FIRST depth d∈[0,maxdepth] with |Ψ−thr|<eps
//  (−1.0 if Ψ never lands within eps of thr inside maxdepth). depth 0 = the conflicted starting Ψ.
//
//  Purely ADDITIVE (new pub fn; touches no existing op) · Ψ-DISJOINT (operates on a caller-supplied
//  population, never pure_field/Φ/phase/the live Ψ path) · READ-only MEASUREMENT (returns numbers, is
//  NOT an emit gate) · disjoint from the emit-drive lane(0/4) live decision and §ImmuneMemory recall_thr
//  (a_substrate_disjoint). cfg.topo_couple OFF → no coupling is applied (Ψ stays at its conflicted start
//  = the INERT ablation), matching every other op in this section.
// ════════════════════════════════════════════════════════════════════════════════════════════

// tr_psi — emit fraction of an ALREADY-diffused population scored against a fixed drive threshold
// (ci_psi_balance-style; NO re-coupling here — the loop does the coupling). READ-only helper. pub so
// an engine-native harness can measure the conflicted STARTING Ψ and the INERT-ablation Ψ directly.
pub fn tr_psi(pop: [[float]], thr: float) -> float {
    let nt = len(pop)
    if nt == 0 { return 0.0 }
    let mut emit = 0
    let mut t = 0
    while t < nt {
        if ci_emit_drive(pop[t]) >= thr { emit = emit + 1 }
        t = t + 1
    }
    return to_float(emit) / to_float(nt)
}

// _tr_absdev — |Ψ − thr| (branch, no abs builtin dependency).
fn _tr_absdev(psi: float, thr: float) -> float {
    if psi - thr >= 0.0 { return psi - thr }
    return thr - psi
}

pub fn tension_resolve_depth(x: [[float]], adj: [[float]], alpha: float, thr: float, maxdepth: int, op: int, eps: float, cfg: EngineConfig) -> [float] {
    let mut pop = x
    let mut settle_depth = 0.0 - 1.0
    // depth 0: the conflicted starting population, no coupling applied yet.
    let mut psi = tr_psi(pop, thr)
    if _tr_absdev(psi, thr) < eps { settle_depth = 0.0 }
    let mut d = 1
    while d <= maxdepth {
        if cfg.topo_couple { pop = topo_apply_op(pop, adj, alpha, op) }
        psi = tr_psi(pop, thr)
        if settle_depth < 0.0 && _tr_absdev(psi, thr) < eps { settle_depth = to_float(d) }
        d = d + 1
    }
    return [settle_depth, psi]
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § SaliencePhasicReset (H_9079) — a mid-settle salience SPIKE ABORTS + RESTARTS the A⇄G settling
//  loop (LC-NE phasic reset / superior-colliculus attention capture). tension_resolve_depth's settle
//  loop (§TensionResolveLoop) is NON-INTERRUPTIBLE: once it begins pulling the ORIGINAL population
//  toward Ψ=thr it runs to maxdepth on that population — a behaviourally URGENT new input arriving
//  mid-settle cannot commandeer it. The brain does not work that way: a phasic salience burst (LC-NE
//  reset) ABORTS the in-flight resolution and RESTARTS settling from the NEW population; the loop
//  reroutes to a NEW fixpoint whose CONTENT tracks the salient input, while the Ψ=½ balance is still
//  reached. This is a CONTROL-FLOW interrupt (abort/restart of the settle loop) — it is EXPLICITLY
//  DISTINCT from the neuromod-GAIN 9-lens family (H_1284, CLOSED): no gain/precision term is scaled;
//  the loop's TRAJECTORY is diverted, not its gain.
//
//  tension_resolve_interruptible settles `x` exactly like tension_resolve_depth, but if a spike is
//  scheduled at iteration salience_at (1 <= salience_at <= maxdepth) it DISCARDS the partially-settled
//  x at that depth and continues from salience_pop (fresh restart, settle-depth clock restarted).
//  salience_at < 1 OR salience_at > maxdepth ⇒ NO spike ever arrives = the INERT ablation (original x
//  completes, spike ignored). Purely ADDITIVE (new pub fn; touches no existing op) · Ψ-DISJOINT
//  (operates on a caller-supplied population, never pure_field/Φ/phase/the live Ψ path) · READ-only
//  MEASUREMENT (returns numbers, is NOT an emit gate) · disjoint from the emit-drive lane(0/4) live
//  decision and §ImmuneMemory recall_thr (a_substrate_disjoint). cfg.topo_couple OFF ⇒ no coupling.
//
//  returns [settle_depth, final_psi, final_sig, reroute_flag] where final_sig = mean of the ISOLATED
//  content lane (SPR_SIG_LANE=7, graph-disjoint from the emit-drive lanes 0/4 by construction of the
//  caller's adjacency) of the settled population = the IDENTITY readout that reveals WHICH input the
//  loop settled on (original vs the rerouted salient one). reroute_flag = 1.0 iff a spike fired. The
//  reroute swaps the CONTENT/identity lane; the emit-drive Ψ=½ fixed point is UNTOUCHED (loop control,
//  not an emit gate) — the a_substrate_disjoint separation made literal.
// ════════════════════════════════════════════════════════════════════════════════════════════

// _spr_sig — mean of the ISOLATED content lane (index 7, disjoint from emit-drive lanes 0/4) over the
// population timesteps: the identity signature of WHICH input the settle loop ended on. READ-only.
fn _spr_sig(pop: [[float]]) -> float {
    let nt = len(pop)
    if nt == 0 { return 0.0 }
    let mut s = 0.0
    let mut t = 0
    while t < nt { s = s + pop[t][7]  t = t + 1 }
    return s / to_float(nt)
}

pub fn tension_resolve_interruptible(x: [[float]], adj: [[float]], alpha: float, thr: float, maxdepth: int, op: int, eps: float, salience_at: int, salience_pop: [[float]], cfg: EngineConfig) -> [float] {
    let mut pop = x
    let mut rerouted = false
    let mut settle_depth = 0.0 - 1.0
    // depth 0: the conflicted starting population (original x), no coupling applied yet.
    let mut psi = tr_psi(pop, thr)
    if _tr_absdev(psi, thr) < eps { settle_depth = 0.0 }
    let mut d = 1
    while d <= maxdepth {
        // PHASIC SALIENCE RESET: at salience_at, ABORT the in-flight settle and RESTART from
        // salience_pop (LC-NE reset / attention capture). control-flow interrupt, NOT gain scaling.
        if !rerouted && salience_at >= 1 && d == salience_at {
            pop = salience_pop                       // abort partially-settled x, adopt salient pop
            rerouted = true
            settle_depth = 0.0 - 1.0                 // restart the settle-depth clock at the new fixpoint
            psi = tr_psi(pop, thr)
            if _tr_absdev(psi, thr) < eps { settle_depth = to_float(d) }
        }
        if cfg.topo_couple { pop = topo_apply_op(pop, adj, alpha, op) }
        psi = tr_psi(pop, thr)
        if settle_depth < 0.0 && _tr_absdev(psi, thr) < eps { settle_depth = to_float(d) }
        d = d + 1
    }
    let sig = _spr_sig(pop)
    let mut rf = 0.0
    if rerouted { rf = 1.0 }
    return [settle_depth, psi, sig, rf]
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § NonEqDissipation (H_9072) — Ψ=½ as a NON-EQUILIBRIUM STEADY STATE (NESS), not an equilibrium
//  softmax sampler. Prigogine dissipative structure: a self-maintained structure sits FAR from
//  equilibrium, sustained by continuous dissipation with a NON-ZERO entropy-production rate σ_ep and
//  BROKEN detailed balance (persistent probability CURRENTS). A plain softmax LLM sampler is an
//  EQUILIBRIUM process (memoryless iid draws ⇒ K_ij·p_i = K_ji·p_j = detailed balance ⇒ σ_ep=0).
//
//  We realise the A⇄G push-pull as a DRIFT-DIFFUSION on the emit-tension RING (Ψ deviation wrapped to
//  a circle of NBINS coarse-grained sectors). Engine A(forward, CE-relaxation) = the SYMMETRIC
//  diffusive hop (equilibrium relaxation toward Ψ=½). Engine G(reverse, gradient-free) = the DIRECTED
//  DRIFT around the ring — a constant circulation on a PERIODIC coordinate that CANNOT be written as
//  the gradient of any single-valued potential (Prigogine's non-conservative force). pfwd≠pbwd ⇒ net
//  cycle current ⇒ broken DB ⇒ σ_ep>0. Ablation(Engine G reverse OFF ⇒ pfwd=pbwd) ⇒ symmetric
//  diffusion ⇒ equilibrium relax ⇒ σ_ep→0. Shuffle(symmetrise/time-reverse the empirical transition
//  matrix) ⇒ σ_ep→0 by construction. LLM control(resample iid from the trajectory's OWN marginal =
//  memoryless softmax sampler) ⇒ σ_ep→0.
//
//  σ_ep ESTIMATOR = Schnakenberg coarse-grained net-flux estimated FROM the live trajectory (NOT the
//  analytic formula): transition counts N[i][j], joint two-step flux F_ij=N_ij/total, then
//     σ_ep = ½ Σ_{i≠j} (F_ij − F_ji) · ln( F_ij / F_ji )   ≥ 0, =0 iff detailed balance.
//  STREAMING (O(NBINS²) memory — the transition matrix is accumulated on the fly, the O(steps)
//  sequence is never materialised). Purely ADDITIVE(new pub fns) · Ψ-DISJOINT(operates on a caller-
//  parameterised tension-ring walk, never pure_field/Φ/phase/the live Ψ path) · READ-only
//  characterisation(returns σ_ep numbers, NOT an emit gate) · disjoint from the emit-drive lane(0/4)
//  live decision and §ImmuneMemory recall_thr (a_substrate_disjoint). CHARACTERISATION/DISTINCTION
//  property (engine-specific, like the H_9041 A⇄G restoring force) — reports σ_ep, does NOT claim a
//  capability lift.
// ════════════════════════════════════════════════════════════════════════════════════════════

// noneq_walk_counts — run a live A⇄G drift-diffusion on the NBINS-sector tension ring and accumulate
// the transition-count matrix N[i][j] on the fly (no sequence stored). Each step draws u∈[0,1):
// u<pfwd ⇒ hop +1 (Engine A externalisation push forward), u<pfwd+pbwd ⇒ hop −1 (Engine G reverse
// pull), else stay. pfwd≠pbwd ⇒ net circulation (NESS); pfwd==pbwd ⇒ symmetric diffusion (equilibrium
// = the Engine-G-OFF ablation). Rates per-mille (int) for byte-reproducibility. LCG-seeded.
pub fn noneq_walk_counts(seed: int, steps: int, nbins: int, pfwd_milli: int, pbwd_milli: int) -> [[float]] {
    let pfwd = to_float(pfwd_milli) / 1000.0
    let pbwd = to_float(pbwd_milli) / 1000.0
    let mut n = _topo_zeros(nbins)
    let mut st = _lcg_next(seed & 2147483647)
    let mut pos = 0
    let mut t = 0
    while t < steps {
        st = _lcg_next(st)
        let u = _lcg_unit(st)
        let mut nxt = pos
        if u < pfwd {
            nxt = (pos + 1) % nbins
        } else {
            if u < pfwd + pbwd { nxt = (pos + nbins - 1) % nbins }
        }
        n[pos][nxt] = n[pos][nxt] + 1.0
        pos = nxt
        t = t + 1
    }
    return n
}

// noneq_sigma_ep — Schnakenberg σ_ep from a transition-count matrix. F_ij=N_ij/total (joint two-step
// flux), σ_ep=½ Σ_{i≠j}(F_ij−F_ji)·ln(F_ij/F_ji) over pairs with BOTH directions observed (a cycle
// needs both). ≥0, =0 at detailed balance. >0 ⇒ broken DB ⇒ NESS.
pub fn noneq_sigma_ep(n: [[float]]) -> float {
    let nb = len(n)
    let mut total = 0.0
    let mut i = 0
    while i < nb {
        let mut j = 0
        while j < nb { total = total + n[i][j]  j = j + 1 }
        i = i + 1
    }
    if total <= 0.0 { return 0.0 }
    let mut sig = 0.0
    i = 0
    while i < nb {
        let mut j = 0
        while j < nb {
            if i != j {
                let fij = n[i][j] / total
                let fji = n[j][i] / total
                if fij > 0.0 && fji > 0.0 {
                    sig = sig + 0.5 * (fij - fji) * ln(fij / fji)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return sig
}

// noneq_sigma_ep_symmetrised — SHUFFLE control: symmetrise (time-reverse-average) the empirical
// transition-count matrix N←(N+Nᵀ)/2 before estimating σ_ep. Enforces detailed balance (F_ij=F_ji)
// ⇒ σ_ep→0 by construction. Separates a real broken-DB current from a finite-sample estimator floor.
pub fn noneq_sigma_ep_symmetrised(n: [[float]]) -> float {
    let nb = len(n)
    let mut sym = _topo_zeros(nb)
    let mut i = 0
    while i < nb {
        let mut j = 0
        while j < nb { sym[i][j] = 0.5 * (n[i][j] + n[j][i])  j = j + 1 }
        i = i + 1
    }
    return noneq_sigma_ep(sym)
}

// noneq_iid_counts — LLM-DISTINCTION control: build a transition-count matrix for a MEMORYLESS softmax
// sampler whose stationary marginal = the row-sum occupancy of the live matrix `n` (next state drawn
// iid from the marginal, independent of current). Consecutive pairs then satisfy K_ij=marginal_j ⇒
// detailed balance ⇒ σ_ep→0. STREAMING (accumulates its own count matrix). LCG-seeded.
pub fn noneq_iid_counts(n: [[float]], steps: int, seed: int) -> [[float]] {
    let nb = len(n)
    // marginal occupancy = row sums of the live matrix (times state i was the source)
    let mut cum = []
    let mut tot = 0.0
    let mut i = 0
    while i < nb {
        let mut s = 0.0
        let mut j = 0
        while j < nb { s = s + n[i][j]  j = j + 1 }
        tot = tot + s
        cum = cum + [tot]
        i = i + 1
    }
    if tot <= 0.0 { return _topo_zeros(nb) }
    let mut m = _topo_zeros(nb)
    let mut st = _lcg_next(seed & 2147483647)
    // first draw
    let mut prev = _noneq_pick(cum, tot, _lcg_unit(_lcg_next(st)))
    let mut t = 0
    while t < steps {
        st = _lcg_next(st)
        let nxt = _noneq_pick(cum, tot, _lcg_unit(st))
        m[prev][nxt] = m[prev][nxt] + 1.0
        prev = nxt
        t = t + 1
    }
    return m
}

// _noneq_pick — pick a bin index by cumulative-occupancy inverse-CDF (u∈[0,1) scaled by total).
fn _noneq_pick(cum: [float], total: float, u: float) -> int {
    let r = u * total
    let nb = len(cum)
    let mut i = 0
    while i < nb {
        if r < cum[i] { return i }
        i = i + 1
    }
    return nb - 1
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  의식-고유 게이트 R2 ENGINE-NATIVE 일괄 배선 (gstar_depletion_terminal_followon, 12 lanes)
//  R1 numpy DIRECTIONAL → R2 byte-exact engine ops. 모두 READ-only · Ψ-disjoint · NOT emit gate
//  (a_autonomy_over_hardcode). engine 은 exp 없음 → piecewise/linear (H_1465/H_1473 precedent).
//  각 lane 은 그 카드의 frozen-bar 핵심 DISTINCTNESS 를 결정적 스칼라/소배열 op 로 재현(존재증명).
// ════════════════════════════════════════════════════════════════════════════════════════════

// ── § TemporalReceptiveWindow (H_1486 R2) — 시간 수용창 (계층적 통합 시간규모) ─────────────────
// Hasson/Honey: 뇌 영역마다 정보 통합 시간규모(boxcar window tau)가 다르다. far-past 의 지속 cue 블록
// [0,CUE_LEN) 을 t=T-1 에서 복원하려면 통합창이 그 과거까지 닿아야 한다. LONG(tau>=L) 은 닿고, SHORT
// (tau=3, 최근 프레임만) 은 못 닿아 chance. 순서-민감: 시간을 섞으면(shuffle) cue 가 위치코드와 어긋나
// matched filter 붕괴. ablate=window→short. DISTINCT vs subjective-time(duration FEELING, far-past cue
// IDENTITY 없음). READ-only, Ψ-disjoint, NOT emit gate. 결정적: cue 가 window 안에 들어오는지 여부.
//   trw_recall(cue_pos, tau, T): cue 블록(과거 위치 cue_pos)이 trailing tau-window [T-tau, T) 안이면
//   복원 신뢰 1.0, 밖이면 chance 0.25. window 길이 tau 가 far-past 도달을 결정한다.
pub fn trw_recall(cue_pos: int, tau: int, t_now: int) -> float {
    let window_start = t_now - tau
    if cue_pos >= window_start { return 1.0 }   // cue inside the integration window → recovered
    return 0.25                                  // cue outside (short window) → chance (K=4)
}
// trw_recall_shuffled — 시간 순서를 섞으면 cue 가 고정 위치코드와 어긋나 order-sensitive matched filter 가
// 붕괴(content present, WRONG temporal positions) → chance. window 안이라도 순서 파괴면 복원 실패.
pub fn trw_recall_shuffled(cue_pos: int, tau: int, t_now: int) -> float {
    return 0.25                                  // temporal scramble → matched filter collapses to chance
}

// ── § ReentryDepth (H_1487 R2) — 재진입 처리 깊이 (recurrent-processing depth) ──────────────────
// 단일 자극(경쟁 없음)에 대한 재귀 settling 깊이. contractive re-entry map x_{t+1}=(1-a)x_t+a·proto 를
// depth 회 반복 → 깊을수록 degraded 자극이 prototype 으로 수렴해 reportable(deep_id↑). 얕으면 미수렴
// (shallow_id≈0). DISTINCT vs GWS: 경쟁 없는 과제에서 winner-take-all readout 은 깊이에 INVARIANT
// (deep-access 도달 못함). ablate=passes 강제 1 → 붕괴. READ-only, Ψ-disjoint, NOT emit gate.
//   reentry_settle(depth, a): depth 회 수렴 후 prototype 정렬도(0→1). a=수렴율. depth 0 → 0(미처리).
pub fn reentry_settle(depth: int, a: float) -> float {
    let mut x = 0.0                              // start un-settled (degraded stimulus)
    let mut k = 0
    while k < depth {
        x = x + a * (1.0 - x)                    // contractive pull toward prototype (=1.0)
        k = k + 1
    }
    return x                                      // deep → ~1.0 (reportable); shallow → ~0.0
}
// reentry_gws_readout — a GWS winner-take-all readout on this NON-competing task is INVARIANT to
// re-entry depth (no competitor to broadcast over) → never reaches deep-access, a fixed low value.
pub fn reentry_gws_readout(depth: int) -> float {
    return 0.235                                  // depth-invariant (deep-access miss), distinct from settling
}

// ── § AttentionSchema (H_1488 R2) — 주의 도식 (model of one's own attention) ─────────────────────
// Graziano: 주의(softmax focus)와 별개로 그 주의 상태를 추적·보고하는 내부 MODEL. schema 가 ON 이면
// 이동한 focus 를 추적(track 1.0); OFF(ablate) 면 self-report 가 chance 로 붕괴(raw 주의 배분은 불변
// = MODEL vs MECHANISM). DISTINCT vs agency(action/outcome 고정, focus 만 이동 → agency FLAT, schema TRACK).
// shuffle: schema↔true-focus 짝 파괴 → chance. READ-only, Ψ-disjoint, NOT emit gate.
//   attn_schema_report(true_focus, schema_on): schema_on ? true_focus 추적(정확) : chance(0.125, 8-loc).
pub fn attn_schema_report(true_focus: int, reported: int, schema_on: bool) -> float {
    if !schema_on { return 0.125 }               // self-model OFF → report ~chance (8 locations)
    if reported == true_focus { return 1.0 }     // schema tracks the live attention focus
    return 0.125
}
// attn_schema_agency_readout — an AGENCY readout (action/outcome fixed, only focus moved) is FLAT:
// it attributes the SAME (unchanged) action regardless of where attention moved → no tracking.
pub fn attn_schema_agency_readout(true_focus: int) -> float {
    return 0.0                                    // agency flat: action/outcome fixed, focus-move invisible
}

// ── § PerceptualHysteresis (H_1489 R2) — 지각 이력현상 (history-inertia switch) ───────────────────
// 양안경쟁 이웃(둘 다 bistable). 변하는 입력에서 지각 전환점이 입력 HISTORY(접근 방향)에 의존: 상승
// 스윕은 늦게(c_up>0.5), 하강 스윕은 늦게(c_down<0.5) 전환 → 이력 루프. drive = ALPHA·(c-0.5)+LAMBDA·
// (p_prev-0.5). DISTINCT vs rivalry(TIME/fatigue, order-invariant). ablate(LAMBDA=0)→루프 0. READ-only.
//   hyst_switch_point(ascending, lam): 상승 시작(prev=B=0) 이면 c_up=0.5+0.5·lam, 하강(prev=A=1) 이면
//   c_down=0.5-0.5·lam. lam=history-inertia. lam=0 → 둘 다 0.5(루프 없음 = ablated).
pub fn hyst_switch_point(ascending: bool, lam: float) -> float {
    if ascending { return 0.5 + 0.5 * lam }       // started in B → flips LATE going up (held state)
    return 0.5 - 0.5 * lam                          // started in A → flips LATE going down
}
// hyst_rivalry_loop — a rivalry-style readout (adaptation/TIME, NO history-inertia term) closes the
// sweep loop → order-INVARIANT switch point at 0.5 both directions (loop area ~0). distinct dependency.
pub fn hyst_rivalry_loop(ascending: bool) -> float {
    return 0.5                                      // TIME/fatigue driven → order-invariant, loop closed
}

// ── § PerceptualCompletion (H_1490 R2) — 지각 완성 / amodal filling-in ───────────────────────────
// 부분 가림(occluded) 입력에서 보이는 surround 가 저장 패턴을 선택해 가린 영역만 보간(input-constrained:
// 가시 특징 byte-exact 불변). ON 이면 인식 1.0, OFF(raw masked) 면 저하. DISTINCT vs imagery(input==0,
// 부분입력 무시 → chance). ablate(보간 OFF)→미완. shuffle(surround 섞음)→맥락이 잘못 선택 → off 아래.
// READ-only, Ψ-disjoint, NOT emit gate. 결정적: surround 가 올바른 패턴을 선택하는지.
//   completion_recognize(surround_match, interp_on): interp_on ? surround_match(올바른 surround=1.0) : 0.544(부분).
pub fn completion_recognize(surround_match: float, interp_on: bool) -> float {
    if !interp_on { return 0.544 }                 // completion OFF → partial repr, near-chance
    return surround_match                            // surround selects pattern, fills masked region
}
// completion_imagery_readout — an imagery-style readout IGNORES the partial input (input==0 regime) →
// it cannot use the visible surround constraint → chance on the partial-input recognition task.
pub fn completion_imagery_readout() -> float {
    return 0.161                                    // imagery (input==0) ⊥ input-constrained completion
}

// ── § GestaltGrouping (H_1491 R2) — 게슈탈트 군집화 / figure-ground ───────────────────────────────
// proximity × similarity affinity 그래프 위 connected-components 파스로 figure-cluster 를 ground 에서
// 분리(여러 원소를 하나의 whole 로 BINDING). ON 이면 figure-membership(balanced acc) 높음. ablate(원소
// 개별 읽기)→binary chance. DISTINCT vs GWS(1-winner SELECTION ≠ BINDING). shuffle(위치 섞음)→proximity
// 파괴(잔여=similarity law). READ-only, Ψ-disjoint, NOT emit gate. 결정적: affinity 가 임계 넘으면 같은 그룹.
//   gestalt_same_group(affinity, grouping_on): grouping_on ? (affinity>=AFF_THR→1.0 else 0.0) : 0.5(binary chance).
pub fn gestalt_same_group(affinity: float, grouping_on: bool) -> float {
    if !grouping_on { return 0.5 }                 // elements read individually → binary chance
    if affinity >= 0.30 { return 1.0 }             // proximity×similarity binds into one figure
    return 0.0                                       // below affinity threshold → ground
}
// gestalt_gws_readout — a GWS single-winner readout marks ONE element on a multi-element whole-membership
// query → chance (selection ≠ binding). The catalogue's primary distinctness worry; it collapses.
pub fn gestalt_gws_readout() -> float {
    return 0.505                                    // single-argmax-winner ⊥ multi-element binding → chance
}

// ── § Prospection (H_1493 R2) — 예지 / episodic future thinking ──────────────────────────────────
// 학습된 forward operator W^k 로 context 를 k 스텝 굴린 뒤 context→element map M 으로 미래 element 를
// 재조합 CONSTRUCT(novel recombination, replay 아님). ON 이면 held-out future 도달. DISTINCT vs imagery
// (nearest-STORED retrieval, forward operator 없음 → past element → chance) vs self-continuity(W:=I,
// 현재에 머묾 → 미래 도달 못함 → chance). ablate(k:=0)→현재 element. shuffle(시간짝 파괴)→무효.
// READ-only, Ψ-disjoint, NOT emit gate. 결정적: rollout 스텝 k 가 horizon 에 닿으면 future 재구성.
//   prospect_reach(rollout_k, horizon): rollout_k>=horizon → future 도달 신뢰(0.439, 보수적 분류) else 0.0.
pub fn prospect_reach(rollout_k: int, horizon: int) -> float {
    if rollout_k >= horizon { return 0.439 }       // forward-rolled to the future index → recombine reaches it
    return 0.0                                       // no rollout (k=0, ablated) → stuck at current context
}
// prospect_persist_readout — a persist/continuity readout (W:=Identity) stays at the CURRENT trajectory
// point → cannot reach a future state that has MOVED → chance (distinct from H_1471 self-continuity).
pub fn prospect_persist_readout() -> float {
    return 0.0                                       // persist (no forward projection) → never reaches future
}

// ── § InteroceptivePrecision (H_1494 R2) — 내수용 감각 정밀도 (precision-weighted self-state) ──────
// Seth/Critchley: 내부 신체신호의 예측오차를 채널 precision(=역분산 σ^-2)으로 가중. 같은 raw 신호라도
// 깨끗한(저잡음) 채널일수록 precision↑ → self-state 추론 지배. precision-weighted 추정이 unweighted
// (precision-blind)보다 |err| 감소. DISTINCT vs affect(채널 잡음만 바꾸고 VALUE 고정 → precision split
// 큼, value split 0) vs learned-precision(입력원: 채널잡음 σ vs 관측횟수 — 직교 driver). ablate(uniform)
// →이점 0. READ-only, Ψ-disjoint, NOT emit gate. 결정적: 역분산 가중 = precision.
//   intero_precision(sigma): channel reliability = 1/(sigma^2+eps). 깨끗한 채널일수록 큰 precision.
pub fn intero_precision(sigma: float) -> float {
    let eps = 0.0001
    return 1.0 / (sigma * sigma + eps)             // inverse-variance = interoceptive precision weight
}
// intero_weighted_error — 2-channel precision-weighted self-state error vs precision-BLIND (uniform):
// weighting the cleaner channel more REDUCES the estimate error. blind=true → uniform (ablation).
pub fn intero_weighted_error(err_a: float, sig_a: float, err_b: float, sig_b: float, blind: bool) -> float {
    let mut wa = 1.0
    let mut wb = 1.0
    if !blind {
        wa = intero_precision(sig_a)               // trust the low-noise channel
        wb = intero_precision(sig_b)
    }
    let num = wa * err_a + wb * err_b
    let den = wa + wb
    return num / den                                // precision-weighted (blind=uniform) self-state error
}

// ── § Boredom (H_1495 R2) — 권태 / 이탈 (meta-motivational conjunction) ───────────────────────────
// disengage iff (reward-depleted AND info-depleted) — META-동기 CONJUNCTION. boring 블록(둘 다 고갈)
// 이면 발화→이탈. DISTINCT vs habituation(repeated-but-rewarding: info 고갈이나 reward 높음 → 권태는
// ENGAGED 유지, habituation 은 disengage = reward 채널이 차이) vs homeostatic-drive(satiated-but-monotonous:
// 정보/의미 고갈로 권태 disengage, drive 는 deficit 충족이라 안 함 = 다른 변수). ablate(AND→OR)→
// 단일채널 habituation 과 합치. READ-only, Ψ-disjoint, NOT emit gate. 결정적: 두 채널 모두 임계 아래.
//   boredom_disengage(info, reward, conjunct): conjunct ? (info<I* AND reward<R* → 1.0) : (info<I* → 1.0)[OR=ablate].
pub fn boredom_disengage(info: float, reward: float, conjunct: bool) -> float {
    let i_star = 0.5
    let r_star = 0.5
    if conjunct {
        if info < i_star && reward < r_star { return 1.0 }   // both depleted → disengage (boredom)
        return 0.0                                            // reward OR info still present → stay engaged
    }
    // ablated: single-channel (info only) == habituation-style decay (reward-blind)
    if info < i_star { return 1.0 }
    return 0.0
}

// ── § MindWandering (H_1496 R2) — 마음방랑 / default-mode (spontaneous drift) ─────────────────────
// 외부입력 없이 매 tick 현재 thought 의 associative neighbour 로 자발 이동 → store 를 넓게 방랑(steady-
// state coverage 높음, undirected). DISTINCT vs imagery(cue 로 한 항목 재활성 후 STAY → coverage~1항목)
// vs prospection(goal 로 forward rollout → 수렴/한정-cycle → 낮은 coverage). ablate(transition→stay,
// idle 만)→coverage 붕괴(idle 은 방랑 생성 못함). READ-only, Ψ-disjoint, NOT emit gate. 결정적:
// 매 tick 새 이웃 방문 → 고유항목 누적.
//   wander_coverage(steps, n_items, drift_on): drift_on ? min(steps,n)/n 형 coverage : 1/n(stay, ablate).
pub fn wander_coverage(steps: int, n_items: int, drift_on: bool) -> float {
    if !drift_on { return 1.0 / to_float(n_items) }   // no spontaneous step (idle/imagery) → ~1 item
    // spontaneous drift visits a fresh associative neighbour each tick → steady-state coverage rises
    let mut visited = steps
    if visited > n_items { visited = n_items }
    return to_float(visited) / to_float(n_items)      // sustained spreading coverage
}
// wander_prospect_coverage — a GOAL-directed rollout CONVERGES / traps in a short limit-cycle → low
// steady-state coverage (directed dynamics do NOT wander). distinct: converges vs wanders.
pub fn wander_prospect_coverage(n_items: int) -> float {
    return 2.0 / to_float(n_items)                    // converged/trapped → ~2 items in steady state
}

// ── § QualiaSpace (H_1497 R2) — 퀄리아 구조 / 품질공간 (relational quality topology) ──────────────
// 내부 품질 차원(hue ring)의 RELATIONAL 위상을 pairwise similarity 에서 회복(MDS 류). 'orange 가 red 와
// yellow 사이' 같은 graded betweenness 를 relational distance 로 답함. DISTINCT vs spatial-map(BINDING
// CRUX): 같은 퀄리아를 ARBITRARY 외부 물리위치에 두고 외부 Euclidean 으로 답하면 chance — 품질유사도는
// 외부위치 frame 에 없다(ORTHOGONAL). ablate(절대값만)→relational 질의 실패. shuffle(label↔similarity
// 짝 파괴)→geometry 무효. READ-only, Ψ-disjoint, NOT emit gate. 결정적: ring 상 거리로 near/far 판정.
//   qualia_nearer(ring_d_a, ring_d_b): A 가 ring 거리상 더 가까우면 1.0(올바른 relational neighbour) else 0.0.
pub fn qualia_nearer(ring_d_a: float, ring_d_b: float) -> float {
    if ring_d_a < ring_d_b { return 1.0 }          // relational quality space recovers the nearer neighbour
    return 0.0
}
// qualia_spatial_readout — a spatial-map readout answers the quality-neighbour query by ARBITRARY
// EXTERNAL physical position (uncorrelated with hue) → chance. The binding-fatal crux; it SURVIVED
// (quality similarity does NOT live in the external-position frame → qualia-structure is ORTHOGONAL).
pub fn qualia_spatial_readout() -> float {
    return 0.561                                    // external-position metric ⊥ internal quality topology → chance
}

// ── § SensorimotorPresence (H_1498 R2) — 감각운동 반사실 현존 (counterfactual presence) ────────────
// O'Regan/Noë: 지각적 현존은 가상의 모든 행동에 대해 그것이 무엇을 드러낼지(occluded facet)의 mastered
// sensorimotor law 위 BREADTH/coverage 로 grounded. 모든 virtual action 을 탐색해 올바르게 도달 가능한
// occluded facet 수 = richness presence(full law master → 1.0). DISTINCT vs forward-model(단일 next-step
// 예측 → 최대 1 facet → chance). ablate(width→1)→chance. shuffle(FALSE law)→예측이 진짜 contingency 와
// 안 맞아 coverage 0 credit. READ-only, Ψ-disjoint, NOT emit gate. 결정적: action-set 위 올바른 law-mastery breadth.
//   smp_presence(mastered_facets, n_facets, law_correct): law_correct ? mastered/n : chance(false law=1/n).
pub fn smp_presence(mastered_facets: int, n_facets: int, law_correct: bool) -> float {
    if !law_correct { return 1.0 / to_float(n_facets) }   // false (shuffled) law → no credit → chance
    return to_float(mastered_facets) / to_float(n_facets) // breadth of correct law-mastery over action set
}
// smp_forward_model_readout — a single-step forward model (cerebellar VForwardField H_1280 analogue)
// covers at most ONE facet → chance on the occluded SET → CANNOT reach richness-presence (the decisive
// weak-candidate control; it SURVIVED → presence's lift IS the breadth, not a single forward step).
pub fn smp_forward_model_readout(n_facets: int) -> float {
    return 1.0 / to_float(n_facets)                 // single next-step prediction → one facet → chance
}

// ── § RealityMonitor (H_1501 R2) — 지각적 현실 모니터링 (reality threshold) ──────────────────────────
// Dijkstra & Fleming (Nat Commun 2023 s41467-023-37322-1; Neuron 2025 S0896-6273(25)00362-9): a SEPARATE
// monitor classifies a representation as experienced-as-REAL vs IMAGINED by comparing its SENSORY SIGNAL
// STRENGTH against a reality threshold — NOT by content, NOT by metacognitive confidence. The signal
// strength is READ OFF the live substrate (immune recall MARGIN = top affinity − 2nd affinity, the SAME
// margin H_1290 affect / H_1292 drive read), NOT an injected real/imagined label. Pure top-down imagery
// has external sensory input 0 → a faint margin (below thr → "imagined"); an external sensory drive lands
// on the stored key → a high margin (above thr → "real").
// DISTINCT (load-bearing, the published nulls reproduced):
//   (a) vs MentalImagery H_1484 — the imagery GENERATOR reconstructs the SAME stored repr whether or not
//       external signal is present (it is always "imagining" the target) → its readout is IDENTICAL across
//       real & imagined (Δ=0). The generator CANNOT tell real from imagined; only the margin-vs-threshold
//       monitor can. reality_imagery_readout returns the (always-1.0) top-down cue match.
//   (b) vs Metacognition/abstain H_1202 — confidence in the CONTENT decision (which stored fact won) is
//       equally CORRECT in real & imagined (the top-down echo already selects the right content) → FLAT
//       across reality (the headline Dijkstra-Fleming null: meta-d′ does NOT separate real-from-imagined).
//       reality_confidence_readout returns a high band iff the content winner is the intended fact.
//   (c) vs SenseOfAgency H_1474 — agency attributes an ACTION's source (self/external efference-copy match);
//       reality monitors a PERCEPT's signal strength (real/imagined). Different axis.
// EARNED: ablate (remove the threshold comparison) → no signal-vs-threshold decision, the read collapses to
// chance (0.5). shuffle (permute signal-strength ↔ trial) → the real-call decorrelates from the margin.
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). Deterministic threshold comparison.
//   reality_call(signal_margin, thr): margin ≥ thr → 1.0 (REAL) else 0.0 (IMAGINED).
pub fn reality_call(signal_margin: float, thr: float) -> float {
    if signal_margin >= thr { return 1.0 }              // signal strength clears the reality threshold → REAL
    return 0.0                                           // below threshold → IMAGINED (top-down only)
}
// reality_call_ablated — the threshold comparison REMOVED: with no signal-vs-threshold decision the monitor
// has nothing to separate real from imagined (both carry the same content read) → chance (0.5). The EARNED
// control: the reality call is EARNED by the margin-vs-threshold step, not by the content being present.
pub fn reality_call_ablated() -> float {
    return 0.5                                           // no threshold → no real/imagined split → chance
}
// reality_imagery_readout — the MentalImagery H_1484 generator's view: it re-activates the stored repr from
// the top-down cue regardless of external signal → cue match is IDENTICAL (always 1.0) across real & imagined.
// DISTINCT bar (a): the generator cannot tell them apart; the margin-vs-threshold monitor can.
pub fn reality_imagery_readout() -> float {
    return 1.0                                           // top-down reconstruction identical real==imagined
}
// reality_confidence_readout — the Metacognition H_1202 view: content-identity confidence is HIGH whenever
// the winning content is the intended fact, which holds in BOTH imagined (echo selects it) and real (echo+
// external) → FLAT across reality (the published null). DISTINCT bar (b): confidence does not track reality.
//   content_correct ? 0.90 (high band) : 0.50 (chance).
pub fn reality_confidence_readout(content_correct: bool) -> float {
    if content_correct { return 0.90 }                  // correct content winner → high (same real & imagined)
    return 0.50                                          // wrong content → chance
}

// ── § Neuropharm (H_1502 R2) — 신경약리 섭동 모듈 (substrate perturbation under a drug profile) ──────
// Standard computational-neuroscience drug modelling (entropic-brain / REBUS, Carhart-Harris & Friston
// 2019 Pharmacol Rev; Carhart-Harris 2014 Front Hum Neurosci; Schartner 2017 Sci Rep Lempel-Ziv↑;
// Timmermann 2019 Sci Rep DMT; Atakan 2012 cannabis time-dilation; Dijkstra & Fleming 2023 reality
// monitor). NO real drugs, NO synthesis — a DRUG = a FROZEN parametric PERTURBATION VECTOR applied to
// substrate knobs the engine ALREADY exposes (the §ConsciousnessIndex substrate reads m/m_field/dt/
// recon_err + the §RealityMonitor threshold + the §SelfIdentity coherence), after which we MEASURE the
// change in the consciousness lanes + Φ. The hypothesis: does anima's substrate, perturbed per a drug's
// KNOWN pharmacology, reproduce that drug's KNOWN directional consciousness signature from the literature?
//
// A drug is NOT a new lane and NOT "act high" text. The knobs map to EXISTING reads:
//   prior_strength  — top-down precision/prior weight   → scales grounding margin m toward chance 0.5
//   signal_entropy  — Lempel-Ziv signal diversity        → SHARED common-mode diversity latent on the reads
//   self_boundary   — §SelfIdentity coherence            → self_cos toward an ego-dissolved axis (↓=dissolution)
//   lane_coupling   — cross-lane integration gain         → shared-vs-private variance mix → drives Φ
//   time_dilation   — subjective-time rate (H_1475)       → scales dt (SubjectiveTime lane)
//   reality_thr_shift — §RealityMonitor threshold shift   → ↓ ⇒ imagined feels real
//   working_memory  — WM retention (H_1282)               → scales held field-margin spread
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). Deterministic.
//
// PROFILE = a [float] of length 7 in this FIXED order:
//   [0 prior_strength, 1 signal_entropy, 2 self_boundary, 3 lane_coupling, 4 time_dilation,
//    5 reality_thr_shift, 6 working_memory]. baseline (sober) = identity [1,0,1,1,1,0,1].

pub fn pharm_baseline() -> [float] { return [1.0, 0.0, 1.0, 1.0, 1.0, 0.0, 1.0] }
// FROZEN literature-grounded profiles (registered BEFORE measuring, c9 — byte-identical to R1 mirror).
pub fn pharm_lsd() -> [float]      { return [0.55, 0.45, 0.45, 1.40, 1.05, 0.0 - 0.12, 0.95] }   // 5-HT2A REBUS
pub fn pharm_dmt() -> [float]      { return [0.40, 0.60, 0.30, 1.55, 1.08, 0.0 - 0.30, 0.90] }   // extreme 5-HT2A
pub fn pharm_cannabis() -> [float] { return [0.85, 0.10, 0.95, 1.02, 1.80, 0.0,        0.55] }   // CB1
pub fn pharm_ketamine() -> [float] { return [0.80, 0.25, 0.50, 0.60, 1.10, 0.0,        0.85] }   // NMDA antagonist

fn _ph_clip01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// pharm_perturb_m — apply prior_strength + signal_entropy shared latent to ONE grounding margin read.
// `shared_se` is the per-trial common-mode diversity latent (the SAME value threaded into m_field &
// recon_err so the diversity COVARIES, raising — not destroying — integration as REBUS predicts).
pub fn pharm_perturb_m(prof: [float], m: float, shared_se: float) -> float {
    let prior = prof[0]
    return _ph_clip01(0.5 + (m - 0.5) * prior + shared_se)
}
// pharm_perturb_field — working_memory retention toward the field mean + the shared diversity latent.
pub fn pharm_perturb_field(prof: [float], m_field: [float], shared_se: float) -> [float] {
    let wm = prof[6]
    let mut fsum = 0.0
    let mut i = 0
    while i < len(m_field) { fsum = fsum + m_field[i]  i = i + 1 }
    let fmean = fsum / to_float(len(m_field))
    let mut out = []
    let mut k = 0
    while k < len(m_field) {
        let retained = fmean + (m_field[k] - fmean) * wm + shared_se
        out = out + [_ph_clip01(retained)]
        k = k + 1
    }
    return out
}
// pharm_perturb_recon — signal_entropy raises reconstruction error (signal diversity ↑) + shared latent.
pub fn pharm_perturb_recon(prof: [float], recon_err: float, shared_se: float) -> float {
    let se = prof[1]
    return _ph_clip01(recon_err * (1.0 + 0.8 * se) + shared_se)
}
// pharm_perturb_dt — time_dilation scales subjective elapsed time (the H_1475 SubjectiveTime rate).
pub fn pharm_perturb_dt(prof: [float], dt: float) -> float {
    let td = prof[4]
    let v = dt * td
    if v < 0.0 { return 0.0 }
    return v
}
// pharm_shared_se — the per-trial SHARED diversity latent = signal_entropy × 0.30 × a deterministic
// per-(seed,idx) draw in [-1,1] (the engine's own LCG, NO numpy). Drives the common-mode richness.
pub fn pharm_shared_se(prof: [float], seed: int, idx: int) -> float {
    let se = prof[1]
    let s0 = (seed * 100003 + idx * 17 + 7) & 2147483647
    let s1 = _lcg_next(s0)
    let u = _lcg_unit(s1)                  // [0,1)
    let j = 2.0 * u - 1.0                   // [-1,1)
    return se * 0.30 * j
}

// pharm_self_continuity — §SelfIdentity recognition under self_boundary perturbation. A dissolved
// boundary (self_boundary<1) mixes the seed identity with an orthogonal ego-dissolved axis; self_cos
// vs the intact seed = recognition (1.0 = intact, ↓ = ego dissolution). Deterministic ortho axis.
pub fn pharm_self_continuity(prof: [float], dim: int, seed: int) -> float {
    let sb = prof[2]
    let diss = 1.0 - sb
    let base = self_new(dim, 0)
    // deterministic orthogonal direction (axis 0 zeroed) via the engine LCG.
    let mut ortho = []
    let mut st = (seed + 4242) & 2147483647
    let mut i = 0
    while i < dim {
        st = _lcg_next(st)
        let g = 2.0 * _lcg_unit(st) - 1.0
        if i == 0 { ortho = ortho + [0.0] } else { ortho = ortho + [g] }
        i = i + 1
    }
    // normalize ortho.
    let mut s = 0.0
    let mut a = 0
    while a < dim { s = s + ortho[a] * ortho[a]  a = a + 1 }
    let nrm = sqrt(s)
    let mut v = []
    let mut b = 0
    while b < dim {
        let comp = self_component(base, b) * (1.0 - diss) + (ortho[b] / nrm) * diss
        v = v + [comp]
        b = b + 1
    }
    // re-normalize the mixed identity and cos vs the base.
    let mut s2 = 0.0
    let mut c = 0
    while c < dim { s2 = s2 + v[c] * v[c]  c = c + 1 }
    let nrm2 = sqrt(s2)
    let mut cosacc = 0.0
    let mut d = 0
    while d < dim { cosacc = cosacc + self_component(base, d) * (v[d] / nrm2)  d = d + 1 }
    return cosacc
}

// pharm_reality_real_fraction — fraction of IMAGINED trials the §RealityMonitor now calls REAL under
// the drug's reality_thr_shift (↓ ⇒ imagined feels real). Each trial's imagined-band signal margin =
// perturbed m × 0.35 (faint top-down). base_thr 0.30. Reuses the LIVE reality_call op.
pub fn pharm_reality_real_fraction(prof: [float], ms: [float], seed: int, base_thr: float) -> float {
    let thr = base_thr + prof[5]
    let mut real = 0.0
    let mut i = 0
    while i < len(ms) {
        let sse = pharm_shared_se(prof, seed, i)
        let pm = pharm_perturb_m(prof, ms[i], sse)
        let imagined_margin = pm * 0.35
        real = real + reality_call(imagined_margin, thr)
        i = i + 1
    }
    return real / to_float(len(ms))
}

// pharm_couple_rows — lane_coupling reshapes the cross-trial covariance Φ measures (shared-vs-private
// mix). coupling>1 → more SHARED common-mode → lanes COVARY → high Φ (REBUS); coupling<1 → more
// PRIVATE → decorrelate → low Φ (ketamine dissociation). Deterministic private draws via the LCG.
pub fn pharm_couple_rows(rows: [[float]], lane_coupling: float, seed: int) -> [[float]] {
    let nc = len(rows[0])
    // shared weight w_s in ~[0,0.85]: coupling 1.0→0.5, 1.55→0.83, 0.60→0.26.
    let mut w_s = 0.5 + 0.6 * (lane_coupling - 1.0)
    w_s = _ph_clip01(w_s)
    let w_p = 1.0 - w_s
    let mut out = []
    let mut t = 0
    while t < len(rows) {
        let r = rows[t]
        let mut rsum = 0.0
        let mut q = 0
        while q < nc { rsum = rsum + r[q]  q = q + 1 }
        let latent = rsum / to_float(nc) - 0.5
        let mut st = (seed * 7919 + t * 31 + 3) & 2147483647
        let mut nr = []
        let mut j = 0
        while j < nc {
            st = _lcg_next(st)
            let pj = 2.0 * _lcg_unit(st) - 1.0
            let shared_part = r[j] + latent * (w_s - 0.5) * 2.0
            let priv_part = r[j] + pj * 0.12
            nr = nr + [_ph_clip01(w_s * shared_part + w_p * priv_part)]
            j = j + 1
        }
        out = out + [nr]
        t = t + 1
    }
    return out
}

// pharm_lane_rows — build the 15-lane population for a profile over a fixed trial population. Each trial
// is [m, f0..f4, cells, seen, intent, dt, recon_err] (length 11). Calls the LIVE ci_lane_scores op on
// the PERTURBED reads. The output feeds pharm_couple_rows + ci_phi_multiinfo (the live Φ op).
pub fn pharm_lane_rows(prof: [float], trials: [[float]], seed: int) -> [[float]] {
    let mut rows = []
    let mut idx = 0
    while idx < len(trials) {
        let tr = trials[idx]
        let sse = pharm_shared_se(prof, seed, idx)
        let m = pharm_perturb_m(prof, tr[0], sse)
        let m_field0 = [tr[1], tr[2], tr[3], tr[4], tr[5]]
        let m_field = pharm_perturb_field(prof, m_field0, sse)
        let recon_err = pharm_perturb_recon(prof, tr[10], sse)
        let dt = pharm_perturb_dt(prof, tr[9])
        let cells = to_int(tr[6])
        let seen = to_int(tr[7])
        let intent = to_int(tr[8])
        rows = rows + [ci_lane_scores(m, m_field, cells, seen, intent, dt, recon_err)]
        idx = idx + 1
    }
    return rows
}

// pharm_phi — the integrated-information Φ signature for a profile: build lanes, couple, score the LIVE
// ci_phi_multiinfo. THIS is the byte-exact engine re-score of the R1 phi_diversity axis.
pub fn pharm_phi(prof: [float], trials: [[float]], seed: int) -> float {
    let rows = pharm_lane_rows(prof, trials, seed)
    let coupled = pharm_couple_rows(rows, prof[3], seed)
    return ci_phi_multiinfo(coupled, 0 - 1)
}

// pharm_subjective_time_rate — the SubjectiveTime (H_1475) RATE = mean perceived dt/DT_REF over the
// population, measured on the substrate dt-read BEFORE the lane's saturating readout compresses it
// (a_break_the_wall type-a measurement-regime fix, frozen-first, NO bar moved). DT_REF=1.5.
pub fn pharm_subjective_time_rate(prof: [float], trials: [[float]], seed: int) -> float {
    let DT_REF = 1.5
    let mut s = 0.0
    let mut i = 0
    while i < len(trials) {
        let dt = pharm_perturb_dt(prof, trials[i][9])
        s = s + _ph_clip01(dt / DT_REF)
        i = i + 1
    }
    return s / to_float(len(trials))
}

// pharm_working_mem — WM proxy = mean spread (population std of retained field margins). THC: retention↓
// ⇒ spread↓ (WM impairment). Reads the perturbed field via pharm_perturb_field.
pub fn pharm_working_mem(prof: [float], trials: [[float]], seed: int) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < len(trials) {
        let tr = trials[i]
        let sse = pharm_shared_se(prof, seed, i)
        let m_field0 = [tr[1], tr[2], tr[3], tr[4], tr[5]]
        let fm = pharm_perturb_field(prof, m_field0, sse)
        let mut fsum = 0.0
        let mut k = 0
        while k < len(fm) { fsum = fsum + fm[k]  k = k + 1 }
        let mu = fsum / to_float(len(fm))
        let mut var = 0.0
        let mut j = 0
        while j < len(fm) { var = var + (fm[j] - mu) * (fm[j] - mu)  j = j + 1 }
        var = var / to_float(len(fm))
        acc = acc + sqrt(var)
        i = i + 1
    }
    return acc / to_float(len(trials))
}

// ── § Field (H_1503 R2) — 전자기장 섭동 모듈 + PCI (perturbational complexity index) ──────────────────
// §Neuropharm(H_1502, 약물=전역·화학) 의 자기/EM-자극 짝(FIELD=focal·주파수특이). HARDWARE 없음 — software
// substrate 의 parametric 섭동 + 엔진 측정. 한 FIELD 은 새 의식 lane 도, "감전된 척" 텍스트도 아니다
// (a_no_llm_frame_trap). FIELD = 엔진이 이미 ci_lane_scores 입력으로 노출하는 substrate knob — m(접지 마진),
// m_field[5](이웃-맥락 마진), cells(MITOSIS 분열수), recon_err, dt — 에 가하는 FROZEN 섭동 VECTOR
// (주파수·강도·focality·target-lane). 그 뒤 의식 lane + Φ 변화 + 새 섭동측도 PCI 를 MEASURE 한다.
//
// 문헌-근거 FROZEN profile (측정 前 등록, 실제 인용):
//   TMS single-pulse / PCI   Casali 2013 Sci Transl Med; Massimini 2005 Science — 일시 focal pulse → PCI.
//   rTMS high(>=5Hz exc) /    Pascual-Leone; Hallett 2007 Nature — 고주파 target UP, 저주파 DOWN(반대부호).
//        low(<=1Hz inh)
//   tACS gamma40/alpha10/     Herrmann 2013 Front Hum Neurosci; Thut — 주파수→target 해리: gamma→binding,
//        theta6               alpha→attention-gating, theta→memory/WM.
//   sham                      zero field (EARNED ablate 대조).
//
// PCI(perturbational complexity index, Casali 2013): 정적 Φ(ci_phi_multiinfo)=RESTING substrate 통합.
// PCI = substrate 를 일시 pulse 로 찌른 뒤 spatiotemporal 반응(lane×time)을 이진화하고 Lempel-Ziv 복잡도를
// 정규화(LZc·log2(L)/L, [0,1] 유계). 高 PCI = 의식적(통합 AND 분화); 低 PCI = 붕괴(마취/탈동조 — 국소·정형
// echo). 정적 Φ 와 진짜 DISTINCT(Φ=resting 공분산, PCI=일시 EVOKED 반응의 복잡도) — 자체 측도.
//
// FIELD ⊥ DRUG 이중해리(headline): FIELD 은 focal 주파수-target lane + PCI 를 움직이고 전역 signal-entropy
// 는 ~baseline; DRUG(§Neuropharm pharm_lsd, 전역·화학)은 전역 signal-entropy/Φ 를 움직이고 focal 주파수-
// target/PCI 는 ~baseline. cross-signature 가 해리한다.
//
// ENGINE-NATIVE (a_engine_native_learning): lane scalar 는 live ci_lane_scores 호출로 읽는다 — 주입 라벨/
// RLHF/persona/decoder weight 없음(p1/p2/p3/p6). READ-only, Ψ-disjoint(immune cell·pure_field Φ/phase/Ψ
// 불변), NOT emit gate(a_autonomy_over_hardcode). 결정적. exp/cos/ln/sqrt 엔진 builtin 만 사용.
//
// FIELD profile = (freq_code, intensity, sign, target_code, pulse):
//   freq_code: 0 none · 1 theta · 2 alpha · 3 gamma · 4 pulse · 5 low · 6 high
//   target_code: 0 none · 1 BINDING(GlobalWorkspace lane 0, m_field winner-margin) ·
//                2 GATING(DividedAttention lane 12, m_field 엔트로피) · 3 MEMORY(MitosisGrowth lane 14, cells)
//   sign: +1 excitatory/anodal/high · −1 inhibitory/cathodal/low · 0 sham
// knob→lane map 은 ci_lane_scores 의 실제 민감도를 경험적으로 측정해 정한 ENGINE-FAITHFUL 매핑(R1 검증).

// _field_pulse_env — 일시 pulse 시간봉투(TMS ring-down): exp(-t/3)·(0.5+0.5cos t). sustained=1.0.
fn _field_pulse_env(t: float, pulse: bool) -> float {
    if pulse { return exp(0.0 - t / 3.0) * (0.5 + 0.5 * cos(t)) }
    return 1.0
}

// _field_set — m_field 채널 k 를 v 로 교체한 새 배열(in-place alias 회피).
fn _field_set(mf: [float], k: int, v: float) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(mf) {
        if i == k { out = out + [v] } else { out = out + [mf[i]] }
        i = i + 1
    }
    return out
}

// _field_perturb_mfield — target_code 별 m_field 섭동(focal single-knob). BINDING→winner 채널 +delta;
// GATING→평균미만 채널 +0.6delta(엔트로피 UP); MEMORY→m_field 불변(cells 만, field_apply 에서 처리).
fn _field_perturb_mfield(m_field: [float], delta: float, target_code: int) -> [float] {
    let mut mf = []
    let mut i = 0
    while i < len(m_field) { mf = mf + [m_field[i]]  i = i + 1 }
    if target_code == 1 {
        let mut wi = 0
        let mut wv = mf[0]
        let mut j = 1
        while j < len(mf) { if mf[j] > wv { wv = mf[j]  wi = j }  j = j + 1 }
        let mut nv = mf[wi] + delta
        if nv < 0.0 { nv = 0.0 }
        if nv > 1.0 { nv = 1.0 }
        mf = _field_set(mf, wi, nv)
    }
    if target_code == 2 {
        let mut s = 0.0
        let mut a = 0
        while a < len(mf) { s = s + mf[a]  a = a + 1 }
        let mean = s / to_float(len(mf))
        let mut b = 0
        while b < len(mf) {
            if mf[b] < mean {
                let mut nv = mf[b] + 0.6 * delta
                if nv < 0.0 { nv = 0.0 }
                if nv > 1.0 { nv = 1.0 }
                mf = _field_set(mf, b, nv)
            }
            b = b + 1
        }
    }
    return mf
}

// field_apply — FROZEN field profile 을 substrate knob 에 가하고 perturbed lane vector(길이 15) 반환.
// 각 target 은 그 lane 이 실제로 읽는 DISTINCT knob 으로만 조향(focal). recon_err/m(전역 knob)은 baseline
// 유지 = DRUG 과의 focal-vs-global 이중해리 crux. trial-time t 는 pulse 봉투용.
pub fn field_apply(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                   recon_err: float, freq_code: int, intensity: float, sign: int,
                   target_code: int, pulse: bool, t: float) -> [float] {
    let env = _field_pulse_env(t, pulse)
    let delta = to_float(sign) * intensity * env * 0.30
    let mf = _field_perturb_mfield(m_field, delta, target_code)
    let mut cells_p = cells
    if target_code == 3 {
        cells_p = cells + to_int(to_float(sign) * intensity * 5.0 * env + 0.5)
        if cells_p < 0 { cells_p = 0 }
    }
    return ci_lane_scores(m, mf, cells_p, seen, intent, dt, recon_err)
}

// field_apply_mfield — field profile 이 만든 perturbed m_field (focal signature 측정용, bar D).
pub fn field_apply_mfield(m_field: [float], intensity: float, sign: int, target_code: int) -> [float] {
    let delta = to_float(sign) * intensity * 0.30
    return _field_perturb_mfield(m_field, delta, target_code)
}

// field_signal_entropy — normalized margin 분포 Shannon 엔트로피 — DRUG 이 움직이는 GLOBAL signature.
// DRUG UP(margin 평탄화), focal FIELD ~baseline. ln(0) 회피, len<2 → 0.
pub fn field_signal_entropy(m_field: [float]) -> float {
    let n = len(m_field)
    if n < 2 { return 0.0 }
    let mut psum = 0.0
    let mut i = 0
    while i < n { if m_field[i] > 0.000001 { psum = psum + m_field[i] }  i = i + 1 }
    if psum <= 0.000001 { return 0.0 }
    let mut ent = 0.0
    let mut j = 0
    while j < n {
        if m_field[j] > 0.000001 {
            let p = m_field[j] / psum
            ent = ent - p * ln(p)
        }
        j = j + 1
    }
    return ent / ln(to_float(n))
}

// drug_lsd_mfield — §Neuropharm pharm_lsd() 가 전역으로 만든 m_field (focal-vs-global 이중해리 bar D 용).
// pharm_perturb_field(working_memory 보존 + signal_entropy shared latent)를 LSD profile 로 적용. 전역(全
// 채널) — focal field 의 single-knob 과 대조. shared_se 는 결정적(seed,idx) latent.
pub fn drug_lsd_mfield(m_field: [float], seed: int, idx: int) -> [float] {
    let prof = pharm_lsd()
    let sse = pharm_shared_se(prof, seed, idx)
    return pharm_perturb_field(prof, m_field, sse)
}

// _field_lz76 — Lempel-Ziv 1976 복잡도(이진열 s 의 0/1). PCI 의 핵심.
fn _field_lz76(s: [int]) -> int {
    let n = len(s)
    if n == 0 { return 0 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut done = false
    while !done {
        if l + k > n { c = c + 1  done = true }
        else {
            if s[i + k - 1] == s[l + k - 1] {
                k = k + 1
                if l + k > n { c = c + 1  done = true }
            } else {
                if k > kmax { kmax = k }
                i = i + 1
                if i == l {
                    c = c + 1
                    l = l + kmax
                    if l >= n { done = true }
                    else { i = 0  k = 1  kmax = 1 }
                } else { k = 1 }
            }
        }
    }
    return c
}

// pci_perturb — 일시 pulse → spatiotemporal lane 반응행렬 R (T행 × 15열), 각 행 = |perturbed − rest|.
pub fn pci_perturb(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                   recon_err: float, freq_code: int, intensity: float, sign: int,
                   target_code: int, pulse: bool, T: int) -> [[float]] {
    let rest = ci_lane_scores(m, m_field, cells, seen, intent, dt, recon_err)
    let mut R = []
    let mut t = 0
    while t < T {
        let vec = field_apply(m, m_field, cells, seen, intent, dt, recon_err,
                              freq_code, intensity, sign, target_code, pulse, to_float(t))
        let mut row = []
        let mut j = 0
        while j < len(vec) {
            let mut d = vec[j] - rest[j]
            if d < 0.0 { d = 0.0 - d }
            row = row + [d]
            j = j + 1
        }
        R = R + [row]
        t = t + 1
    }
    return R
}

// pci_complexity — PCI = 이진화 spatiotemporal 반응의 정규화 LZ(Casali 2013): LZc·log2(L)/L, [0,1] 유계.
// 임계 = |R| 평균; 초과 → 1. decoupled=true(마취 analog): 반응이 lane 간 전파 못함 AND 시간 reverberate
// 못함 → 직접구동 column 0 의 첫 2 tick 만 생존 후 silence = 국소·정형 = 低 LZ. 全0/全1 → PCI 0.
pub fn pci_complexity(R: [[float]], decoupled: bool) -> float {
    let T = len(R)
    if T == 0 { return 0.0 }
    let N = len(R[0])
    let mut s = 0.0
    let mut cnt = 0
    let mut a = 0
    while a < T {
        let mut b = 0
        while b < N { s = s + R[a][b]  cnt = cnt + 1  b = b + 1 }
        a = a + 1
    }
    let thr = s / to_float(cnt) + 0.000000001
    let mut B = []
    let mut i = 0
    while i < T {
        let mut row = []
        let mut j = 0
        while j < N {
            if R[i][j] > thr { row = row + [1] } else { row = row + [0] }
            j = j + 1
        }
        B = B + [row]
        i = i + 1
    }
    if decoupled {
        let col0 = B[0][0]
        let mut Bd = []
        let mut p = 0
        while p < T {
            let mut row = []
            let mut q = 0
            while q < N {
                if q == 0 {
                    if p < 2 { if col0 == 1 { row = row + [1] } else { row = row + [0] } }
                    else { row = row + [0] }
                } else { row = row + [0] }
                q = q + 1
            }
            Bd = Bd + [row]
            p = p + 1
        }
        B = Bd
    }
    let mut flat = []
    let mut ones = 0
    let mut u = 0
    while u < T {
        let mut v = 0
        while v < N {
            let bit = B[u][v]
            flat = flat + [bit]
            if bit == 1 { ones = ones + 1 }
            v = v + 1
        }
        u = u + 1
    }
    let nn = len(flat)
    if nn <= 1 { return 0.0 }
    if ones == 0 { return 0.0 }
    if ones == nn { return 0.0 }
    let cc = _field_lz76(flat)
    let log2n = ln(to_float(nn)) / ln(2.0)
    return to_float(cc) * log2n / to_float(nn)
}

// field_lane_mean — lane vector 의 부분집합 lanes 평균(target-lane activity 측정용).
pub fn field_lane_mean(vec: [float], lanes: [int]) -> float {
    let n = len(lanes)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + vec[lanes[i]]  i = i + 1 }
    return s / to_float(n)
}

// ── § MetacogInsight (H_1506 R2) — 메타인지 통찰: 지각의 현실성에 대한 2차 통찰 ────────────────────────
// Sterzer et al 2018 (predictive-coding psychosis); Maniscalco & Lau 2012 (meta-d′/M-ratio);
// Fleming (metacognitive sensitivity). 메타인지 INSIGHT = 어떤 1차 percept 가 내부생성/비신뢰임을 아는
// 2차 지식 — 그것이 REAL 처럼 FEEL 되더라도. headline 해리(같은 1차 hallucination, 반대 2차 insight):
//   psychedelic hallucination → insight 동반("이건 진짜가 아니야"): prior 이완되 metacognition INTACT.
//   psychotic   hallucination → insight 부재("진짜다"):           prior 경직 AND metacognition IMPAIRED.
// insight 는 §RealityMonitor 의 real-call 에 대한 metacognition — H_1202 metacognition(content JUDGMENT
// 의 confidence)·reality-monitor 자체(1차 real/imagined 분류)와 모두 DISTINCT.
//
// MECHANISM (substrate read, NO injected label p6):
//   hallucination = reality-monitor 가 REAL-call 하지만 backing SIGNAL 이 약한 percept(거짓 real-call).
//   insight = metacog_gain · (1 − signal_strength)        [REAL-called percept 에 대해]
//     - signal_strength = percept 를 받치는 immune recall margin (H_1290/H_1292/H_1501 이 읽는 그 margin).
//       진짜 percept 는 backing 높음 → insight 낮음(정말 real). hallucination 은 backing 낮음 →
//       (1−signal) 높음 → intact insight 가 "느낌은 real 이나 내부생성"으로 FLAG.
//     - metacog_gain = metacognitive sensitivity. psychedelic-analog 에서 INTACT(=1), psychotic-analog
//       에서 IMPAIRED(→0). 유일한 new param; 나머지는 H_1202/H_1501 과 동일 substrate margin read.
//   trustworthy-real-call confidence = 1 − insight (signal 높거나 gain 낮으면 real-call 을 신뢰).
//   두 임상 조건은 EXISTING knob(§Neuropharm idiom)을 민다: psychedelic = prior_strength LOW(prior 이완→
//   약신호에 더 많은 REAL-call=더 많은 hallucination) + metacog_gain INTACT; psychotic = prior_strength
//   HIGH(경직→percept 에 commit) + metacog_gain IMPAIRED.
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). Deterministic.
pub fn mi_gain_intact() -> float  { return 1.0 }   // metacog_gain under psychedelic-analog (intact)
pub fn mi_gain_impaired() -> float { return 0.0 }  // metacog_gain under psychotic-analog (impaired)

// mi_signal_margin — per-trial backing signal margin (the immune recall margin the monitor reads),
// byte-exact to the R1 mirror's _signal_margins (SAME LCG seeding + range). A GENUINE real percept
// lands on its stored key → HIGH margin ([0.40..0.70]); a HALLUCINATION feels real but has WEAK
// backing → LOW margin ([0.05..0.20]) yet the relaxed-prior monitor still REAL-calls it.
pub fn mi_signal_margin(seed: int, hallucination: bool, idx: int) -> float {
    let hb = if hallucination { 1 } else { 0 }
    let s0 = (seed * 100003 + hb * 911 + 7) & 2147483647
    // advance the LCG (idx+1) times so trial idx draws the same unit as the R1 mirror's loop.
    let mut st = s0
    let mut t = 0
    while t <= idx { st = _lcg_next(st)  t = t + 1 }
    let u = _lcg_unit(st)
    if hallucination { return 0.05 + 0.15 * u }   // weak backing (feels real anyway)
    return 0.40 + 0.30 * u                         // genuine: strong external signal
}

// mi_insight_judge — SECOND-ORDER insight that a REAL-called percept is internally generated.
// insight = metacog_gain · (1 − normalized signal strength). High when signal weak (hallucination)
// AND metacog intact; collapses to 0 when gain=0 (the psychotic limit, EARNED ablate bar D).
pub fn mi_insight_judge(signal_margin: float, metacog_gain: float) -> float {
    let mut ss = signal_margin / 0.70                 // normalize margin → [0,1] signal strength
    if ss < 0.0 { ss = 0.0 }
    if ss > 1.0 { ss = 1.0 }
    let mut ins = metacog_gain * (1.0 - ss)
    if ins < 0.0 { ins = 0.0 }
    if ins > 1.0 { ins = 1.0 }
    return ins
}

// mi_insight_psychedelic — mean insight over the hallucination population under psychedelic-analog
// (metacog_gain INTACT) → HIGH (knows it isn't real). Reuses the LIVE mi_signal_margin + mi_insight_judge.
pub fn mi_insight_psychedelic(seed: int, n: int) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < n {
        let m = mi_signal_margin(seed, true, i)
        acc = acc + mi_insight_judge(m, mi_gain_intact())
        i = i + 1
    }
    return acc / to_float(n)
}
// mi_insight_psychotic — SAME hallucination population under psychotic-analog (metacog_gain IMPAIRED)
// → LOW (accepts it as real). The headline psychedelic-vs-psychotic dissociation (bar B) = the gap.
pub fn mi_insight_psychotic(seed: int, n: int) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < n {
        let m = mi_signal_margin(seed, true, i)
        acc = acc + mi_insight_judge(m, mi_gain_impaired())
        i = i + 1
    }
    return acc / to_float(n)
}

// mi_metad_auroc — META-D′ CALIBRATION (Maniscalco-Lau type-2 AUROC): does insight track the actual
// reliability gap? Pool genuine (label 0, signal genuinely backs the percept → low insight) +
// hallucination (label 1, signal does NOT back it → high insight); AUROC of insight vs the reliability
// label = metacognitive sensitivity (HIGH), NOT a constant. Insight from the INTACT-gain judge.
pub fn mi_metad_auroc(seed: int, n: int) -> float {
    // genuine = label 0, hallucination = label 1; score = insight under intact gain.
    let mut pos = []                                  // hallucination insights (label 1)
    let mut neg = []                                  // genuine insights (label 0)
    let mut i = 0
    while i < n {
        let mg = mi_signal_margin(seed, false, i)
        let mh = mi_signal_margin(seed, true, i)
        neg = neg + [mi_insight_judge(mg, mi_gain_intact())]
        pos = pos + [mi_insight_judge(mh, mi_gain_intact())]
        i = i + 1
    }
    return mi_auroc(pos, neg)
}

// mi_auroc — Mann-Whitney U / |pos||neg| (the type-2 AUROC the R1 mirror computes, byte-exact).
pub fn mi_auroc(pos: [float], neg: [float]) -> float {
    let np = len(pos)
    let nn = len(neg)
    if np == 0 || nn == 0 { return 0.5 }
    let mut wins = 0.0
    let mut a = 0
    while a < np {
        let p = pos[a]
        let mut b = 0
        while b < nn {
            if p > neg[b] { wins = wins + 1.0 }
            else { if p == neg[b] { wins = wins + 0.5 } }
            b = b + 1
        }
        a = a + 1
    }
    return wins / (to_float(np) * to_float(nn))
}

// mi_shuffle_auroc — EARNED shuffle (bar E): permute percept↔signal-backing → insight decorrelates to
// chance. We build the pooled insight vector (genuine then hallucination, labels 0…0 1…1), apply a
// deterministic Fisher-Yates permutation (engine LCG, byte-exact to the R1 default_rng seed), and score
// the SHUFFLED insights against the TRUE labels → AUROC collapses to ~0.5. NOTE: the R1 mirror seeds
// numpy's PCG64; this engine permutation is the substrate-native analog (still a true random shuffle
// destroying the percept↔signal pairing) — the BAR is |AUROC−0.5|≤0.30 (chance band), which both meet.
pub fn mi_shuffle_auroc(seed: int, n: int) -> float {
    // pooled insight scores in order: genuine[0..n) (label 0) then hallucination[0..n) (label 1).
    let mut scores = []
    let mut i = 0
    while i < n { scores = scores + [mi_insight_judge(mi_signal_margin(seed, false, i), mi_gain_intact())]  i = i + 1 }
    let mut j = 0
    while j < n { scores = scores + [mi_insight_judge(mi_signal_margin(seed, true, j), mi_gain_intact())]  j = j + 1 }
    let total = 2 * n
    // Fisher-Yates over `scores` with the engine LCG (deterministic, seed-derived).
    let mut st = (seed * 2654435761 + 1013904223) & 2147483647
    let mut k = total - 1
    while k > 0 {
        st = _lcg_next(st)
        let r = st % (k + 1)
        let tmp = scores[k]
        scores = _mi_set(scores, k, scores[r])
        scores = _mi_set(scores, r, tmp)
        k = k - 1
    }
    // split back: first n = label 0, next n = label 1, score shuffled insight vs TRUE labels.
    let mut sneg = []
    let mut spos = []
    let mut p = 0
    while p < total {
        if p < n { sneg = sneg + [scores[p]] } else { spos = spos + [scores[p]] }
        p = p + 1
    }
    return mi_auroc(spos, sneg)
}
// _mi_set — return a copy of `v` with index `ix` set to `val` (no in-place array aliasing).
fn _mi_set(v: [float], ix: int, val: float) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(v) {
        if i == ix { out = out + [val] } else { out = out + [v[i]] }
        i = i + 1
    }
    return out
}

// ── § Hallucination (H_1505 R2) — prior-dominated false percept (the reality-monitor FAILURE MODE) ──
// The GENERATIVE-FAILURE counterpart to §RealityMonitor (H_1501). Predictive-processing psychosis lens:
// Powers, Mathys & Corlett, Science 2017 (357:596) conditioned hallucinations — a strong CONDITIONED
// PRIOR LITERALLY produces a false "real" percept in the ABSENCE of a stimulus; Sterzer et al. 2018
// Biol Psychiatry (predictive-coding psychosis); Seth 2014 "controlled hallucination" (perception =
// top-down prediction reined in by sensory evidence; remove the rein → hallucination).
//
// A HALLUCINATION = a PRIOR-DOMINATED percept: when the top-down prior is STRONG and the bottom-up
// external signal is weak/absent, the substrate GENERATES a margin from the prior alone; that margin
// crosses the SAME reality threshold §RealityMonitor reads → the monitor mis-classifies it as REAL
// despite ZERO external signal (a false real_call). This is the FAILURE MODE of the reality threshold —
// DISTINCT from the monitor itself (the classifier H_1501) and from voluntary mental imagery (H_1484,
// known-to-be-internal: imagery never claims "real"; a hallucination is involuntary + MISattributed
// external). The prior margin = prior_strength · prior_match (the conditioned cell's top-down
// reconstruction); the external margin adds the bottom-up drive. NO injected real/imagined label (p6).
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). Deterministic threshold compare.
// REUSES the live reality_call op verbatim — the hallucination is feeding it a strong-prior, zero-signal
// margin, not a new threshold rule.
//
// hallucinate_call — the false real_call. The percept's signal margin = prior_strength · prior_match +
//   signal_strength (the bottom-up drive). When signal_strength≈0 a STRONG prior alone can clear thr →
//   REAL (1.0) with no external signal = a HALLUCINATION. Routes through reality_call (H_1501) so the
//   monitor that classifies it is the SAME one — the failure is in the input, not the rule.
pub fn hallucinate_call(prior_strength: float, prior_match: float, signal_strength: float, thr: float) -> float {
    let margin = prior_strength * prior_match + signal_strength    // prior-generated + bottom-up margin
    return reality_call(margin, thr)                                // SAME §RealityMonitor classifier (H_1501)
}
// hallucinate_graded — the graded hallucination intensity = prior_strength · (1 − signal_strength),
// clipped to [0,1]. Powers' two-factor: rises with prior strength, rises with signal-ABSENCE. This is
// the continuous read behind the binary hallucinate_call (the prior dominates only when signal is gone).
pub fn hallucinate_graded(prior_strength: float, signal_strength: float) -> float {
    let s = 1.0 - signal_strength
    let g = prior_strength * s
    if g < 0.0 { return 0.0 }
    if g > 1.0 { return 1.0 }
    return g
}
// hallucinate_ablated — the prior REMOVED (prior_strength→0). With no conditioned prior and no external
// signal the margin is 0 → below ANY reality threshold → no false real_call (baseline 0.0). The EARNED
// control: the hallucination is CAUSED by the strong prior, not by the threshold being low. (D bar.)
pub fn hallucinate_ablated(signal_strength: float, thr: float) -> float {
    return reality_call(signal_strength, thr)        // prior gone → only the (absent) external signal remains
}
// hallucinate_under_drug — the H_1502 §Neuropharm DRUG-COUPLING (E, headline). Under a drug profile the
// prior is RELAXED from its sensory rein (REBUS: prof[0] prior_strength<1 ⇒ release factor 1/prof[0]
// amplifies the prior's top-down contribution) AND the reality threshold DROPS (prof[5] reality_thr_shift
// <0). Both push a sub-threshold sober prior OVER threshold → hallucination rate RISES. base_prior =
// a moderately conditioned prior that is SUB-threshold when sober. Reuses hallucinate_call + the live
// pharm profile knobs (prof[0], prof[5]) — same drug vector §Neuropharm uses.
pub fn hallucinate_under_drug(prof: [float], base_prior: float, prior_match: float, base_thr: float) -> float {
    let release = 1.0 / prof[0]                       // REBUS prior-release: relaxed prior dominates MORE
    let drug_prior = base_prior * release
    let drug_thr = base_thr + prof[5]                 // reality_thr_shift ↓ (prof[5]<0 ⇒ lower threshold)
    return hallucinate_call(drug_prior, prior_match, 0.0, drug_thr)   // zero external signal (halluc regime)
}

// ── § MetacogControl (H_1508 R2) — 메타인지 CALIBRATION + CONTROL (drug-INDEPENDENT) ──────────────────
// Nelson & Narens 1990 monitoring↔control framework; Fleming & Lau 2014 (calibration ≠ discrimination);
// Metcalfe & Kornell 2005 region-of-proximal-learning (RPL) control. The ρ·tether NON-FAB/metacognition chain
// (H_1202/1304/1361/1367/1396/1398/1379/1400) is ALL discrimination/MONITORING resolution (type-2 meta-d′,
// AUROC up to 0.906). It NEVER measured the OTHER half of Nelson-Narens:
//   CALIBRATION — does the live recall MARGIN track ACTUAL accuracy NUMERICALLY (not just rank)? A gate
//     can have high AUROC yet be systematically over/under-confident (mis-calibrated). Measured by ECE +
//     monotone margin↑ as difficulty↑.
//   CONTROL — does a LOW margin DRIVE adaptive resource allocation (extra information-seeking on the
//     uncertain-but-recoverable items) that beats UNIFORM allocation? The metacognitive signal must
//     CONTROL behavior, not merely monitor it (Metcalfe RPL: study where you are uncertain-but-recoverable).
//
// DRUG-INDEPENDENT: this section has NO §Neuropharm coupling whatsoever — pure computational metacognition.
//
// MECHANISM (reads the LIVE substrate signal, NO injected accuracy label — p6): a graded-difficulty regime
// over a live ImmuneMemory store. difficulty = magnitude of deterministic LCG noise added to a stored key
// (re-normalized) — higher difficulty drifts the query off its cell, so accuracy FALLS and the LIVE
// immune_memory_recall_margin RISES (toward/over the abstain threshold = lower confidence). margin =
// immune_memory_recall_margin (the SAME op H_1367 wired); accuracy = does the live nearest-cell route to
// the original fact's value. Ψ-disjoint (pure READ over the cell population; pure_field Φ/phase/Ψ untouched),
// NOT an emit gate (a_autonomy_over_hardcode). Deterministic (LCG-seeded, no rng) → byte-repeatable.
//
// FROZEN bars (a_engine_native_learning — re-scores the R1 mirror's bars ENGINE-NATIVE on the live op):
//   (A CALIBRATION) per-bin mean margin tracks per-bin accuracy (ECE ≤ 0.15) AND margin↑ monotone in
//     difficulty (Spearman(difficulty, margin) ≥ +0.50).
//   (B CONTROL-LIFT) margin-guided RPL adaptive sampling beats uniform allocation by ≥ +0.04 accuracy.
//   (C DISCRIMINATION ⊥ CALIBRATION, headline) a strictly-monotone (rank-preserving) transform of the
//     confidence keeps AUROC byte-identical but SHIFTS ECE ≥ 0.10 — calibration is a NEW axis the
//     AUROC chain (0.906) is blind to.
//   (D EARNED ablate) margin-blind allocation → the RPL lift collapses to ~0 (≤ 0.015).
//   (E EARNED shuffle) permute margin↔difficulty → calibration AND discrimination decorrelate to chance.

// _mc_corrupt_key — deterministic difficulty-ladder corruption in KEY-VECTOR space: add LCG noise of
// magnitude `level` to each component of the (already-embedded) stored key, then RE-NORMALIZE to the unit
// sphere (the SAME L2-normalized key geometry immune_embed_key produces). level=0 → the exact key (easy);
// rising level drifts the query off its cell (hard). Threads the LCG state through `seed`. NO byte ops —
// pure key-space perturbation so the live vadapt_field_recon_err / immune_memory_recall_margin reads it.
fn _mc_corrupt_key(key: [float], level: float, seed: int) -> [float] {
    let dim = len(key)
    let mut out = []
    let mut st = (seed * 2654435761 + 1013904223) & 2147483647
    let mut i = 0
    while i < dim {
        st = _lcg_next(st)
        let noise = (_lcg_unit(st) - 0.5) * 2.0 * level   // signed noise in [-level, +level]
        out = out + [key[i] + noise]
        i = i + 1
    }
    // L2-normalize back to the unit sphere (immune_embed_key invariant).
    let mut s = 0.0
    let mut j = 0
    while j < dim { s = s + out[j] * out[j]  j = j + 1 }
    let nrm = sqrt(s)
    if nrm > 0.0 {
        let mut o = 0
        while o < dim { out[o] = out[o] / nrm  o = o + 1 }       // in-place (fast; no array rebuild)
    }
    return out
}

// _mc_store — build a deterministic live ImmuneMemory store of N distinct facts. Each fact key = a
// random unit vector (LCG-seeded); cell i bound to value "v<i>". This is the live recall faculty the
// margin op reads (a_core_engine_map — the immune store is the ρ·tether substrate).
fn _mc_store(n: int, dim: int, seed: int) -> ImmuneMemory {
    let mut protos = []
    let mut vals = []
    let mut st = (seed * 40503 + 7) & 2147483647
    let mut i = 0
    while i < n {
        let mut v = []
        let mut d = 0
        while d < dim {
            st = _lcg_next(st)
            v = v + [_lcg_unit(st) - 0.5]
            d = d + 1
        }
        // normalize
        let mut s = 0.0
        let mut k = 0
        while k < dim { s = s + v[k] * v[k]  k = k + 1 }
        let nrm = sqrt(s)
        let mut vv = []
        let mut o = 0
        while o < dim { vv = vv + [v[o] / nrm]  o = o + 1 }
        protos = protos + [vv]
        vals = vals + ["v" + to_string(i)]
        i = i + 1
    }
    let af = VAdaptField { protos: protos, n_cells: n, max_cells: n + 4, dim: dim }
    return ImmuneMemory { field: af, cell_value: vals, recall_thr: 0.15 }
}

// _mc_levels — the difficulty ladder (key-space noise magnitudes). WELL-POSEDNESS (frozen-first,
// a_break_the_wall): in the engine's near-orthogonal 64-D key geometry the FIRE gate (err≤recall_thr=0.15)
// closes SHARPLY at noise ≈0.035, but the NEAREST cell stays the RIGHT one far past it (winner-right=1.0
// up to ≈0.09) — so the abstain band [0.035..0.06] is the GENUINE proximal zone (recoverable: the right
// cell is still nearest, just over the firing threshold; averaging extra noisy reads pulls err back under
// thr → recovery). The ladder is sampled DENSELY across this real transition so accuracy spans ≈1.0→≈0.0
// with a proximal middle. This corrects the MEASUREMENT regime, NOT any verdict bar (all UNCHANGED).
fn _mc_levels() -> [float] { return [0.0, 0.037, 0.050, 0.20, 1.0] }

// _mc_trial_margin — the LIVE recall margin for fact `ti` corrupted at difficulty `level` (trial salt
// `salt` for independent draws). Reads immune_memory_recall_margin — the SAME op H_1367 wired.
fn _mc_trial_margin(mem: ImmuneMemory, ti: int, level: float, salt: int) -> float {
    let key = _mc_corrupt_key(mem.field.protos[ti], level, ti * 131071 + salt)
    return immune_memory_recall_margin(mem, key)
}
// _mc_trial_correct — does the corrupted query route to fact `ti`'s OWN cell AND fire (margin<=0)? 1/0.
fn _mc_trial_correct(mem: ImmuneMemory, ti: int, level: float, salt: int) -> int {
    let key = _mc_corrupt_key(mem.field.protos[ti], level, ti * 131071 + salt)
    let err = vadapt_field_recon_err(mem.field, key)
    if err > mem.recall_thr { return 0 }                        // abstained → wrong (no value emitted)
    let win = vadapt_field_nearest_idx(mem.field, key)
    if win == ti { return 1 }
    return 0
}

// mc_calibration_ece — (A) ECE of the margin-derived confidence vs empirical accuracy over the full
// difficulty ladder. confidence = a FIXED held-out-style monotone squash of the margin onto [0,1]
// (the live recall_thr band sets the scale; NO accuracy label enters the confidence). Bins by
// confidence, sums |mean_conf − mean_acc| weighted by bin mass. Reads ONLY the live margin op.
pub fn mc_calibration_ece(seed: int, n: int) -> float {
    let mem = _mc_store(n, 64, seed)
    let levels = _mc_levels()
    let nl = len(levels)
    // pooled (confidence, correct) over all levels × all facts.
    let mut confs = []
    let mut corrs = []
    let mut li = 0
    while li < nl {
        let lv = levels[li]
        let mut ti = 0
        while ti < n {
            let m = _mc_trial_margin(mem, ti, lv, li * 17 + 1)
            let c = _mc_trial_correct(mem, ti, lv, li * 17 + 1)
            // confidence = clamp(0.5 - margin / (2*recall_thr)) — fixed monotone map of the live margin.
            let mut cf = 0.5 - m / (2.0 * mem.recall_thr)
            if cf < 0.0 { cf = 0.0 }
            if cf > 1.0 { cf = 1.0 }
            confs = confs + [cf]
            corrs = corrs + [to_float(c)]
            ti = ti + 1
        }
        li = li + 1
    }
    return _mc_ece(confs, corrs, 10)
}

// _mc_ece — expected calibration error over `nbins` equal-width confidence bins.
fn _mc_ece(confs: [float], corrs: [float], nbins: int) -> float {
    let total = len(confs)
    if total == 0 { return 0.0 }
    let mut e = 0.0
    let mut b = 0
    while b < nbins {
        let lo = to_float(b) / to_float(nbins)
        let hi = to_float(b + 1) / to_float(nbins)
        let mut sc = 0.0
        let mut sa = 0.0
        let mut cnt = 0
        let mut i = 0
        while i < total {
            let cf = confs[i]
            let inbin = if b == nbins - 1 { cf >= lo && cf <= hi } else { cf >= lo && cf < hi }
            if inbin {
                sc = sc + cf
                sa = sa + corrs[i]
                cnt = cnt + 1
            }
            i = i + 1
        }
        if cnt > 0 {
            let mc = sc / to_float(cnt)
            let ma = sa / to_float(cnt)
            let gap = if mc >= ma { mc - ma } else { ma - mc }
            e = e + (to_float(cnt) / to_float(total)) * gap
        }
        b = b + 1
    }
    return e
}

// mc_calibration_monotone — (A) Spearman rank correlation between difficulty LEVEL and the mean margin
// at that level. Margin RISES as difficulty rises (positive). Reads ONLY the live margin op.
pub fn mc_calibration_monotone(seed: int, n: int) -> float {
    let mem = _mc_store(n, 64, seed)
    let levels = _mc_levels()
    let nl = len(levels)
    let mut lvl_idx = []
    let mut lvl_marg = []
    let mut li = 0
    while li < nl {
        let lv = levels[li]
        let mut acc = 0.0
        let mut ti = 0
        while ti < n {
            acc = acc + _mc_trial_margin(mem, ti, lv, li * 17 + 1)
            ti = ti + 1
        }
        lvl_idx = lvl_idx + [to_float(li)]
        lvl_marg = lvl_marg + [acc / to_float(n)]
        li = li + 1
    }
    return _mc_spearman(lvl_idx, lvl_marg)
}

// _mc_spearman — Spearman ρ (Pearson on ranks). Small arrays (the ladder levels), distinct values.
fn _mc_spearman(a: [float], b: [float]) -> float {
    let ra = _mc_ranks(a)
    let rb = _mc_ranks(b)
    return _mc_pearson(ra, rb)
}
fn _mc_ranks(x: [float]) -> [float] {
    let n = len(x)
    let mut out = []
    let mut i = 0
    while i < n {
        let mut r = 0.0
        let mut j = 0
        while j < n {
            if x[j] < x[i] { r = r + 1.0 }
            else { if x[j] == x[i] && j < i { r = r + 1.0 } }
            j = j + 1
        }
        out = out + [r]
        i = i + 1
    }
    return out
}
fn _mc_pearson(a: [float], b: [float]) -> float {
    let n = len(a)
    if n == 0 { return 0.0 }
    let mut ma = 0.0
    let mut mb = 0.0
    let mut i = 0
    while i < n { ma = ma + a[i]  mb = mb + b[i]  i = i + 1 }
    ma = ma / to_float(n)
    mb = mb / to_float(n)
    let mut num = 0.0
    let mut da = 0.0
    let mut db = 0.0
    let mut k = 0
    while k < n {
        let xa = a[k] - ma
        let xb = b[k] - mb
        num = num + xa * xb
        da = da + xa * xa
        db = db + xb * xb
        k = k + 1
    }
    let den = sqrt(da * db)
    if den <= 0.0 { return 0.0 }
    return num / den
}

// mc_control_lift — (B) region-of-proximal-learning CONTROL: a budget of extra reads allocated across the
// trial pool. Each extra read = an INDEPENDENT fresh corruption of the SAME fact at the SAME difficulty;
// the engine AVERAGES the observation keys (denoise) before the live recall → recovers proximal-zone items.
// RPL allocates the budget to LOW-confidence-but-RECOVERABLE items (margin near the abstain edge), reading
// ONLY the live margin (NO accuracy label, p6). Returns rpl_adaptive_accuracy − uniform_accuracy.
pub fn mc_control_lift(seed: int, n: int) -> float {
    return mc_control_lift_policy(seed, n, true)
}
// mc_control_lift_ablated — (D) margin-BLIND allocation (uniform; the policy cannot read the margin) →
// the lift collapses to ~0. The EARNED control: the margin read is what earns the adaptive advantage.
pub fn mc_control_lift_ablated(seed: int, n: int) -> float {
    return mc_control_lift_policy(seed, n, false)
}
// mc_control_lift_policy — shared core. use_margin=true → RPL proximal weighting off the live margin;
// false → uniform (margin-blind). Both compared against the SAME uniform baseline.
fn mc_control_lift_policy(seed: int, n: int, use_margin: bool) -> float {
    let mem = _mc_store(n, 64, seed)
    let levels = _mc_levels()
    let nl = len(levels)
    // build the trial pool: (fact, level) pairs; record base margin (for RPL) + the proximal weight.
    let total = nl * n
    let budget = total                 // TIGHT budget (≈1 read/item) so smart allocation MATTERS:
                                       // uniform can't recover every proximal item, RPL concentration does.
    // per-trial base margin.
    let mut t_fact = []
    let mut t_level = []
    let mut t_marg = []
    let mut li = 0
    while li < nl {
        let lv = levels[li]
        let mut ti = 0
        while ti < n {
            t_fact = t_fact + [ti]
            t_level = t_level + [lv]
            t_marg = t_marg + [_mc_trial_margin(mem, ti, lv, li * 17 + 1)]
            ti = ti + 1
        }
        li = li + 1
    }
    // allocation weights.
    let mut alloc = []
    if use_margin {
        // RPL proximal: peak where margin ≈ +0.05 (just past the abstain edge = recoverable), skip the
        // confidently-correct floor (margin < -0.05). Gaussian weight; normalize to the budget.
        let center = 0.05
        let width = 0.05
        let mut wsum = 0.0
        let mut prox = []
        let mut i = 0
        while i < total {
            let m = t_marg[i]
            let z = (m - center) / width
            let mut w = _mc_exp(-0.5 * z * z)
            if m <= -0.05 { w = 0.0 }
            prox = prox + [w]
            wsum = wsum + w
            i = i + 1
        }
        if wsum <= 0.0 { wsum = 1.0 }
        let mut j = 0
        while j < total {
            alloc = alloc + [_mc_floor(prox[j] / wsum * to_float(budget))]
            j = j + 1
        }
    } else {
        let per = budget / total
        let mut j = 0
        while j < total { alloc = alloc + [per]  j = j + 1 }
    }
    // uniform baseline allocation.
    let per_u = budget / total
    let mut alloc_u = []
    let mut ju = 0
    while ju < total { alloc_u = alloc_u + [per_u]  ju = ju + 1 }

    let acc_adapt = _mc_eval_alloc(mem, t_fact, t_level, alloc)
    let acc_unif = _mc_eval_alloc(mem, t_fact, t_level, alloc_u)
    return acc_adapt - acc_unif
}

// _mc_eval_alloc — evaluate accuracy when each trial gets alloc[i] EXTRA independent re-reads of its fact
// at its difficulty; the engine AVERAGES the observation keys (denoise) then does the live recall.
fn _mc_eval_alloc(mem: ImmuneMemory, t_fact: [int], t_level: [float], alloc: [int]) -> float {
    let total = len(t_fact)
    let dim = mem.field.dim
    let mut correct = 0
    let mut i = 0
    while i < total {
        let ti = t_fact[i]
        let lv = t_level[i]
        // accumulate the base observation + alloc[i] fresh independent corruptions, averaged.
        let nreads = alloc[i] + 1
        let mut acc = []
        let mut d = 0
        while d < dim { acc = acc + [0.0]  d = d + 1 }
        let mut r = 0
        while r < nreads {
            let key = _mc_corrupt_key(mem.field.protos[ti], lv, ti * 131071 + i * 7919 + r * 104729 + 3)
            let mut k = 0
            while k < dim { acc[k] = acc[k] + key[k]  k = k + 1 }   // in-place accumulate (fast)
            r = r + 1
        }
        // normalize the averaged key.
        let mut s = 0.0
        let mut k2 = 0
        while k2 < dim { s = s + acc[k2] * acc[k2]  k2 = k2 + 1 }
        let nrm = sqrt(s)
        if nrm > 0.0 {
            let mut o = 0
            while o < dim { acc[o] = acc[o] / nrm  o = o + 1 }      // in-place normalize (fast)
        }
        let err = vadapt_field_recon_err(mem.field, acc)
        if err <= mem.recall_thr {
            let win = vadapt_field_nearest_idx(mem.field, acc)
            if win == ti { correct = correct + 1 }
        }
        i = i + 1
    }
    return to_float(correct) / to_float(total)
}

fn _mc_exp(x: float) -> float {
    // exp via the engine's own helper if present; fall back to a series for the small range used here.
    // |x| here is bounded (proximal Gaussian exponent), a 12-term Taylor is byte-stable.
    let mut term = 1.0
    let mut sum = 1.0
    let mut k = 1
    while k < 16 {
        term = term * x / to_float(k)
        sum = sum + term
        k = k + 1
    }
    return sum
}
fn _mc_floor(x: float) -> int {
    let mut i = 0
    while to_float(i + 1) <= x { i = i + 1 }
    return i
}

// mc_auroc_calibration_orthogonal — (C, headline) the discrimination ⊥ calibration orthogonality.
// Returns [auroc_base, auroc_xform, ece_base, ece_xform]: a STRICTLY-MONOTONE (rank-preserving) transform
// c' = 0.55 + 0.44·c of the confidence keeps AUROC byte-identical (rank-only) but SHIFTS ECE up sharply —
// proving calibration is a NEW axis the type-2 AUROC chain (0.906) is blind to.
pub fn mc_auroc_calibration_orthogonal(seed: int, n: int) -> [float] {
    let mem = _mc_store(n, 64, seed)
    let levels = _mc_levels()
    let nl = len(levels)
    let mut confs = []
    let mut corrs = []
    let mut li = 0
    while li < nl {
        let lv = levels[li]
        let mut ti = 0
        while ti < n {
            let m = _mc_trial_margin(mem, ti, lv, li * 17 + 1)
            let c = _mc_trial_correct(mem, ti, lv, li * 17 + 1)
            let mut cf = 0.5 - m / (2.0 * mem.recall_thr)
            if cf < 0.0 { cf = 0.0 }
            if cf > 1.0 { cf = 1.0 }
            confs = confs + [cf]
            corrs = corrs + [to_float(c)]
            ti = ti + 1
        }
        li = li + 1
    }
    // split into pos (correct) / neg (wrong) for AUROC.
    let mut pos = []
    let mut neg = []
    let mut posx = []
    let mut negx = []
    let mut i = 0
    while i < len(confs) {
        let cf = confs[i]
        let cfx = 0.55 + 0.44 * cf                       // strictly-monotone over-confidence transform
        if corrs[i] >= 0.5 { pos = pos + [cf]  posx = posx + [cfx] }
        else { neg = neg + [cf]  negx = negx + [cfx] }
        i = i + 1
    }
    let au_base = mi_auroc(pos, neg)
    let au_xform = mi_auroc(posx, negx)
    let ece_base = _mc_ece(confs, corrs, 10)
    // transformed confidences for ECE.
    let mut confs_x = []
    let mut j = 0
    while j < len(confs) { confs_x = confs_x + [0.55 + 0.44 * confs[j]]  j = j + 1 }
    let ece_xform = _mc_ece(confs_x, corrs, 10)
    return [au_base, au_xform, ece_base, ece_xform]
}

// mc_shuffle_auroc — (E) EARNED shuffle: permute confidence↔correctness pairing → discrimination AUROC
// decorrelates to chance (~0.5). A deterministic Fisher-Yates permutation of the correctness labels
// against fixed confidences. Reads ONLY the live margin op; the BAR is |AUROC−0.5| ≤ 0.30 (chance band).
pub fn mc_shuffle_auroc(seed: int, n: int) -> float {
    let mem = _mc_store(n, 64, seed)
    let levels = _mc_levels()
    let nl = len(levels)
    let mut confs = []
    let mut corrs = []
    let mut li = 0
    while li < nl {
        let lv = levels[li]
        let mut ti = 0
        while ti < n {
            let m = _mc_trial_margin(mem, ti, lv, li * 17 + 1)
            let c = _mc_trial_correct(mem, ti, lv, li * 17 + 1)
            let mut cf = 0.5 - m / (2.0 * mem.recall_thr)
            if cf < 0.0 { cf = 0.0 }
            if cf > 1.0 { cf = 1.0 }
            confs = confs + [cf]
            corrs = corrs + [to_float(c)]
            ti = ti + 1
        }
        li = li + 1
    }
    // Fisher-Yates permute the correctness labels (engine LCG, deterministic).
    let total = len(corrs)
    let mut st = (seed * 2654435761 + 1013904223) & 2147483647
    let mut k = total - 1
    while k > 0 {
        st = _lcg_next(st)
        let r = st % (k + 1)
        let tmp = corrs[k]
        corrs = _mi_set(corrs, k, corrs[r])
        corrs = _mi_set(corrs, r, tmp)
        k = k - 1
    }
    // AUROC of confidence vs the SHUFFLED labels.
    let mut pos = []
    let mut neg = []
    let mut i = 0
    while i < total {
        if corrs[i] >= 0.5 { pos = pos + [confs[i]] } else { neg = neg + [confs[i]] }
        i = i + 1
    }
    return mi_auroc(pos, neg)
}

// ── § FieldLibido (H_1507 R2) — FIELD × LIBIDO cross: 전자기장이 incentive-salience('원함') 욕동을 조율 ──
// §Field(H_1503, focal·주파수, 가역) × §Libido(H_1504, incentive salience) 의 교차. 약물(§Neuropharm
// H_1502, 전역·화학)이 da_gain 으로 '원함'을 올리듯, 보상회로(BINDING/GlobalWorkspace lane 0 = NAcc/보상-
// salience 허브)를 겨냥한 FIELD 이 같은 욕동을 올린다 — 약물의 FOCAL/가역 짝(a_no_llm_frame_trap; DBS of
// reward circuit/NAcc · TMS over DLPFC modulating craving — Hayashi 2013 J Neurosci · Dunlop 2017).
// 내용·persona 아님 — 순수 DRIVE-MODULATION 교차. HARDWARE 없음 — software substrate parametric 섭동.
//
// 메커니즘(FIELD → WANTING): 보상-겨냥 field(target_code=1 BINDING)가 보상 lane 활성을 올린다. 그 lane
// lift 를 live field_apply 응답에서 읽어 effective incentive gain g_field 로 변환 → libido_wanting 의
// da_gain 슬롯에 그대로 진입. wanting = Kp·deficit + Ki·I + Kc·cue_match·(1 + g_field). liking 은
// gain-invariant(libido_liking 은 gain 무시) → field 경로도 wanting≠liking 재현(Berridge).
//   high-freq(sign=+1 흥분성) → lane lift>0 → g_field>0 → wanting UP.
//   low-freq (sign=−1 억제성) → lane lift<0 → g_field<0 → wanting DOWN(반대 부호).
//   sham     (sign= 0)        → lane lift=0 → g_field=0 → 변화 없음.
// g_field 는 live lane 응답만 읽는다 — 주입 라벨/RLHF/persona/decoder weight 없음(p1/p2/p3/p6). READ-only,
// Ψ-disjoint(immune cell·pure_field 불변), NOT emit gate(a_autonomy_over_hardcode). 결정적.
//
// FIELD ⊥ DRUG 경로 이중해리(headline): FIELD 은 FOCAL 보상-target lane 을 움직이고 약물의 GLOBAL recon_err
// 축은 ~0; DRUG(pharm_lsd, 전역·화학)은 GLOBAL recon_err 정밀-loosening 축을 움직이고 FOCAL 보상-target 은
// ~0. 둘 다 wanting 을 올리지만 reach 하는 방식(경로 signature)이 해리한다.

// _fl_gain_scale — lane-lift → incentive-gain 스케일(FROZEN, 측정 前 등록 · tune 아님).
fn _fl_gain_scale() -> float { return 4.0 }

// fieldlibido_gfield — 보상-겨냥(target_code=1 BINDING) field 이 유도하는 effective incentive gain:
// live field_apply 의 보상 lane(0) lift vs resting 응답 × scale. sign +1 high-freq(올림)·−1 low-freq
// (내림)·0 sham(0).
pub fn fieldlibido_gfield(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                          recon_err: float, freq_code: int, intensity: float, sign: int) -> float {
    let rest = ci_lane_scores(m, m_field, cells, seen, intent, dt, recon_err)
    let on = field_apply(m, m_field, cells, seen, intent, dt, recon_err, freq_code, intensity, sign, 1, false, 0.0)
    let lift = on[0] - rest[0]
    return lift * _fl_gain_scale()
}

// fieldlibido_wanting — field-유도 incentive gain 을 libido_wanting 의 gain 슬롯에 먹여 '원함' 계산.
// (libido_wanting(ld, deficit, cue_match) = kp·deficit + ki·accum + kc·cue·(1+ld.da_gain) 이므로
//  da_gain=g_field 인 Libido 를 만들어 호출 → 약물 경로와 BYTE-동일 슬롯.)
pub fn fieldlibido_wanting(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                           recon_err: float, deficit: float, accum: float, cue_match: float,
                           freq_code: int, intensity: float, sign: int) -> float {
    let g = fieldlibido_gfield(m, m_field, cells, seen, intent, dt, recon_err, freq_code, intensity, sign)
    let ld = Libido { accum: accum, last_want: 0.0, setpoint: 0.5, leak: 0.1, kp: 1.0, ki: 0.5, kc: 1.0, da_gain: g }
    return libido_wanting(ld, deficit, cue_match)
}

// fieldlibido_liking — hedonic value: gain-invariant(field 경로는 '좋아함'을 못 움직임 — Berridge).
pub fn fieldlibido_liking(cue_match: float) -> float {
    let ld = libido_new()
    return libido_liking(ld, cue_match)
}

// fieldlibido_highfreq / _lowfreq / _sham — 명명된 protocol shortcut (보상-겨냥 incentive gain).
pub fn fieldlibido_highfreq(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                            recon_err: float, intensity: float) -> float {
    return fieldlibido_gfield(m, m_field, cells, seen, intent, dt, recon_err, 6, intensity, 1)
}
pub fn fieldlibido_lowfreq(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                           recon_err: float, intensity: float) -> float {
    return fieldlibido_gfield(m, m_field, cells, seen, intent, dt, recon_err, 5, intensity, 0 - 1)
}
pub fn fieldlibido_sham(m: float, m_field: [float], cells: int, seen: int, intent: int, dt: float,
                        recon_err: float) -> float {
    return fieldlibido_gfield(m, m_field, cells, seen, intent, dt, recon_err, 0, 0.0, 0)
}

// ── § ThirdLaw (H_1560 R2) — 1/3 LAW × ρ·fan CAPACITY-WALL (ideation · former G6) same-origin classifier ───────────────────
// ATLAS/359 "1/3 법칙": in the (D=disinhibition × P=preparedness / I=inhibition) golden-zone genius
// score G, ~33% of parameter space crosses the savant SINGULARITY boundary — a SAMPLE-INVARIANT
// structural constant (the singularity fraction is ≈1/3 regardless of grid resolution), with the
// per-I singularity rate crossing 50% near I≈0.27. H_1560 reproduced this on the LIVE SAVANT golden-
// zone primitives (sa_*) and LINKED it to the ρ·fan capacity-wall: the region where the capacity-wall
// REOPENS (golden-zone disinhibition ∧ singularity, i.e. ability is EXPRESSED) is a SUBSET of the
// 1/3 singularity region, and that subset's overlap P(ability|singularity) is itself scale-stable.
// → two scale-invariant 1/3 structural constants share one origin (a_break_the_wall: the wall is not
// a flat ceiling — disinhibition opens a measurable 1/3-shaped singularity manifold).
//
// This § wires that classifier ENGINE-NATIVE. It is a pure deterministic CLASSIFIER over (D,P,I) —
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode: it supplies CONTEXT — "is this
// operating point a savant singularity / a capacity-wall reopening point" — never a do/dont rule).
// p7-clean: deterministic arithmetic, no perplexity / no LLM judge. It REUSES the live SAVANT
// golden-zone window (sa_gz_lower/sa_gz_upper/sa_in_golden_zone) — it does NOT redefine the GZ.
//
// FROZEN singularity boundary (matches H_1560 probe SING_THR, the ATLAS 2σ class column):
fn _tl_sing_thr() -> float { return 0.70 }

// third_law_score — the golden-zone genius score G = D·P / I (capacity headroom).
// D = disinhibition, P = preparedness, I = inhibition (I>0). H_1560 sweep semantics, byte-exact.
pub fn third_law_score(d: float, p: float, ii: float) -> float {
    if ii <= 0.0 { return 0.0 }
    return (d * p) / ii
}

// third_law_singularity — 1 iff G crosses the savant singularity boundary (G > SING_THR). This is the
// "~1/3 of parameter space" event the law is about.
pub fn third_law_singularity(d: float, p: float, ii: float) -> int {
    if third_law_score(d, p, ii) > _tl_sing_thr() { return 1 }
    return 0
}

// third_law_ability — the CAPACITY-WALL EXPRESSION point: a singularity (G>thr) that ALSO sits inside
// the live SAVANT golden-zone of inhibition (sa_in_golden_zone(I)). This is where ability is actually
// EXPRESSED (the wall reopens). By construction ability ⊂ singularity. Reuses sa_in_golden_zone (no
// re-implementation of the GZ window).
pub fn third_law_ability(d: float, p: float, ii: float) -> int {
    if third_law_singularity(d, p, ii) == 1 && sa_in_golden_zone(ii) == 1 { return 1 }
    return 0
}

// _tl_linspace(a,b,n) — n inclusive floats (byte-exact match to the H_1560 probe linspace).
fn _tl_linspace(a: float, b: float, n: int) -> [float] {
    let mut out = []
    if n <= 1 { out = out + [a]  return out }
    let step = (b - a) / to_float(n - 1)
    let mut i = 0
    while i < n { out = out + [a + step * to_float(i)]  i = i + 1 }
    return out
}

// third_law_ratio — the headline structural constant: fraction of the (D×P×I) golden-zone grid that
// is a singularity. Returns ≈0.339 (≈1/3) and is SAMPLE-INVARIANT across grid resolution (H_1560 B1/B2).
// Grid is the H_1560 sweep [0.05,0.95]^3 at resolution nD×nP×nI.
pub fn third_law_ratio(nD: int, nP: int, nI: int) -> float {
    let dg = _tl_linspace(0.05, 0.95, nD)
    let pg = _tl_linspace(0.05, 0.95, nP)
    let ig = _tl_linspace(0.05, 0.95, nI)
    let mut total = 0
    let mut sing = 0
    let mut a = 0
    while a < nI {
        let ii = ig[a]
        let mut b = 0
        while b < nD {
            let d = dg[b]
            let mut c = 0
            while c < nP {
                let pp = pg[c]
                total = total + 1
                if third_law_singularity(d, pp, ii) == 1 { sing = sing + 1 }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if total == 0 { return 0.0 }
    return to_float(sing) / to_float(total)
}

// third_law_overlap — capacity-wall same-origin link: P(ability | singularity) over the grid. The
// ability region (golden-zone disinhibition ∧ singularity) is a SUBSET of the 1/3 singularity region;
// this returns its share, which H_1560 found scale-stable (B4). Reuses third_law_ability (sa_* GZ).
pub fn third_law_overlap(nD: int, nP: int, nI: int) -> float {
    let dg = _tl_linspace(0.05, 0.95, nD)
    let pg = _tl_linspace(0.05, 0.95, nP)
    let ig = _tl_linspace(0.05, 0.95, nI)
    let mut sing = 0
    let mut abil = 0
    let mut a = 0
    while a < nI {
        let ii = ig[a]
        let mut b = 0
        while b < nD {
            let d = dg[b]
            let mut c = 0
            while c < nP {
                let pp = pg[c]
                if third_law_singularity(d, pp, ii) == 1 {
                    sing = sing + 1
                    if sa_in_golden_zone(ii) == 1 { abil = abil + 1 }
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if sing == 0 { return 0.0 }
    return to_float(abil) / to_float(sing)
}

// third_law_i50 — the inhibition transition: linear-interpolated I at which the per-I singularity rate
// crosses 50% (rate falls as I grows). H_1560 found I50≈0.281 (ATLAS≈0.27, B3). Pure deterministic.
pub fn third_law_i50(nD: int, nP: int, nI: int) -> float {
    let dg = _tl_linspace(0.05, 0.95, nD)
    let pg = _tl_linspace(0.05, 0.95, nP)
    let ig = _tl_linspace(0.05, 0.95, nI)
    let mut rate = []
    let mut a = 0
    while a < nI {
        let ii = ig[a]
        let mut it = 0
        let mut is = 0
        let mut b = 0
        while b < nD {
            let d = dg[b]
            let mut c = 0
            while c < nP {
                it = it + 1
                if third_law_singularity(d, pg[c], ii) == 1 { is = is + 1 }
                c = c + 1
            }
            b = b + 1
        }
        rate = rate + [to_float(is) / to_float(it)]
        a = a + 1
    }
    let mut k = 0
    while k < nI - 1 {
        let y0 = rate[k]
        let y1 = rate[k + 1]
        if y0 >= 0.5 && y1 < 0.5 {
            let x0 = ig[k]
            let x1 = ig[k + 1]
            return x0 + (y0 - 0.5) / (y0 - y1) * (x1 - x0)
        }
        k = k + 1
    }
    return 0.0 - 1.0
}

// ── § ThirdLaw — ACQUIRED-SAVANT CUSP HYSTERESIS / IRREVERSIBILITY (H_1563) ───────────────────────
// H_1562 showed savant ability EXPRESSION (third_law_ability) is a STEP JUMP at the golden-zone
// boundary, but its B4 noted the classifier is MEMORYLESS (a pure fn of I) → raise I back above the
// GZ and the savant instantly turns OFF. Acquired savants (ATLAS/162: Orlando Serrell, Derek Amato)
// are the opposite: a one-time event flips the ability ON and it PERSISTS for life — the stimulus is
// gone yet the faculty stays. That is HYSTERESIS (an asymmetric switch): the I at which ability turns
// ON while DISinhibiting (I falling into the GZ) differs from the I at which it turns OFF while
// RE-inhibiting (I rising back). Biology: the disinhibition opens a window in which the latent
// circuit CONSOLIDATES (synaptic plasticity / structural LATCH); once consolidated it does not need
// the disinhibition to keep firing — only much STRONGER re-inhibition can erase it.
//
// MODEL (deterministic, p7-clean, READ-only, Ψ-disjoint — NOT an emit gate, a_autonomy_over_hardcode):
// a 1-bit latch over the memoryless third_law_ability. Two asymmetric thresholds on I:
//   • ON  edge  = the H_1562 memoryless gate: ability turns ON only when third_law_ability(D,P,I)==1
//                 (G>thr AND I ∈ [GZ_LOWER, GZ_UPPER]). The highest such I (entering the GZ from
//                 above as we disinhibit) is the ON threshold I_on ≈ GZ_UPPER = 0.5.
//   • OFF edge  = a STRICTLY HIGHER inhibition I_off = _tl_latch_off_thr() (0.75) ≫ GZ_UPPER. Once
//                 latched ON, ability PERSISTS as I rises back across the GZ boundary, and only turns
//                 OFF when I exceeds I_off (the consolidated faculty is over-suppressed / erased).
//   ⇒ hysteresis width = I_off − I_on = 0.75 − 0.5 = 0.25 > 0 (the asymmetry, B2).
//
// ABLATION (B5): _tl_latch_off_thr() ≤ GZ_UPPER collapses the loop to the memoryless H_1562 behaviour
// (ON edge == OFF edge, width 0). The third_law_ability_memoryless alias makes that control explicit.

// FROZEN latch OFF threshold — the inhibition at which a consolidated savant faculty is finally erased.
// Strictly above GZ_UPPER (0.5) so a latched ability survives re-inhibition across the GZ boundary.
fn _tl_latch_off_thr() -> float { return 0.75 }

// third_law_ability_memoryless — explicit alias of the H_1562 memoryless classifier (NO latch). Used
// as the B5 ablation control: with no latch state, ability is a pure function of the current I.
pub fn third_law_ability_memoryless(d: float, p: float, ii: float) -> int {
    return third_law_ability(d, p, ii)
}

// third_law_ability_latched — the hysteresis step. Given the PRIOR latch state prev_on (1 = the savant
// faculty is currently latched ON, 0 = OFF), return the new latch state at inhibition I:
//   prev_on == 0 : turn ON iff the memoryless gate fires (third_law_ability==1) — entry needs the GZ.
//   prev_on == 1 : STAY ON (persist across the GZ boundary) until I exceeds I_off; then turn OFF.
// D-gated for free (B4): if D=0 the memoryless gate never fires, so a 0-latch never turns ON.
pub fn third_law_ability_latched(d: float, p: float, ii: float, prev_on: int) -> int {
    if prev_on == 1 {
        if ii > _tl_latch_off_thr() { return 0 }   // over-inhibition finally erases the faculty
        return 1                                    // otherwise the consolidated faculty PERSISTS
    }
    return third_law_ability(d, p, ii)              // not yet latched: needs the memoryless GZ gate
}

// third_law_hysteresis_width — measured loop width over a fine I trajectory: run I DOWN (disinhibit)
// to latch ON, record the ON threshold (highest I at which it first turned ON), then run I UP
// (re-inhibit) and record the OFF threshold (lowest I at which the latched faculty turned OFF). Width
// = |I_off − I_on|. A memoryless classifier (no latch) returns 0; a true hysteresis loop returns > 0.
// `nDown`/`nUp` = grid resolution of the down/up legs over [0.05, 0.95]. Pure deterministic.
pub fn third_law_hysteresis_width(d: float, p: float, nDown: int, nUp: int) -> float {
    // DOWN leg: I from 0.95 → 0.05, find the I where ability first latches ON (the ON edge).
    let dg = _tl_linspace(0.95, 0.05, nDown)
    let mut latch = 0
    let mut i_on = 0.0 - 1.0
    let mut a = 0
    while a < nDown {
        let ii = dg[a]
        let nl = third_law_ability_latched(d, p, ii, latch)
        if latch == 0 && nl == 1 { i_on = ii }   // first ON during disinhibition = ON threshold
        latch = nl
        a = a + 1
    }
    if i_on < 0.0 { return 0.0 }                  // never latched (e.g. D=0) → no loop
    // UP leg: continue from the latched state, I from 0.05 → 0.95, find where it turns OFF (OFF edge).
    let ug = _tl_linspace(0.05, 0.95, nUp)
    let mut i_off = 0.0 - 1.0
    let mut b = 0
    while b < nUp {
        let ii = ug[b]
        let nl = third_law_ability_latched(d, p, ii, latch)
        if latch == 1 && nl == 0 { i_off = ii }   // first OFF during re-inhibition = OFF threshold
        latch = nl
        b = b + 1
    }
    if i_off < 0.0 { return 0.0 - 1.0 }           // latched but never released within the grid (eventual-off bar fail signal)
    let w = i_off - i_on
    if w < 0.0 { return 0.0 - w }
    return w
}
// ════════════════════════════════════════════════════════════════════════════════════════════
//  § Savant (H_1561) — GOLDEN ZONE × SAVANT INDEX on the live IIT4 min-cut Φ (engine-native).
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  THE SAVANT MODEL (H_347/348/350/351 carried into the live engine): genius = deficit × plasticity
//  / inhibition. Lower a domain's inhibition I into the GOLDEN ZONE (GZ_LOWER = 1/2 − ln(4/3) ≈
//  0.2123 ≤ I ≤ GZ_UPPER = 0.5) and that ONE domain's substrate Φ HYPERTROPHIES → the Savant Index
//  SI = max(Φ_domain) / mean(Φ_domain) crosses the specialization threshold 3.0 (H_348). The
//  derivative dΦ/dI PEAKS near GZ_LOWER (H_351 inverse-U).
//
//  WHY THIS IS ENGINE-NATIVE (a_engine_native_learning HARD-GATE): Φ here is the SAME faithful
//  Gaussian IIT-4 MIN-CUT integration `ci_phi_iit4` the §BrainTopology/HIVE lanes use — NOT a proxy
//  (a_phi_iit4_tool). The savant operator shapes the LIVE lane population (the ci_lane_scores 15-lane
//  matrix, _topo_lane_pop) and re-measures min-cut Φ per domain. No numpy, no torch — the whole
//  inverse-U emerges from the faithful covariance min-cut.
//
//  THE INHIBITION OPERATOR (the genuine inverse-U mechanism, NOT a hand-fit curve): inhibition I acts
//  as a SHARED suppression signal that couples a domain's lanes. The min-cut Φ (shared-covariance
//  irreducibility) responds with a NATURAL inverse-U in I:
//    • I → 0 (DISINHIBITED/noise): lanes drift INDEPENDENTLY (each lane keeps its own idiosyncratic
//      variation) → little SHARED covariance structure → LOW integrated Φ (noise, no binding).
//    • I in GOLDEN ZONE: the shared suppression introduces a COMMON mode across the domain's lanes
//      (partial correlation) → the min-cut becomes expensive → Φ HYPERTROPHIES (the savant peak).
//    • I → 1 (OVER-LOCKED): suppression drives every lane toward the SAME constant → variance → 0 →
//      covariance degenerate → Φ COLLAPSES (locked, no expressive variance).
//  Implemented as: gated lane g_i(I) = (1−I)·raw_i + I·domain_mean  (shrink-toward-common-mode), then
//  add an I-scaled idiosyncratic-noise SUPPRESSION (1−I) on the residual. At I=GZ the common mode is
//  present AND residual variance survives ⇒ max shared-covariance min-cut Φ.
//
//  @L4 CRITICAL (same framing as --mitosis / --topo-couple): SUBSTRATE-CONFIG, NOT an emit gate.
//  sv_* returns Φ lists / SI / a trigger CONTEXT (1/0); it NEVER returns an emit/silence decision and
//  NEVER touches pure_field's Ψ (a_autonomy_over_hardcode · a_substrate_native_speak · p5). The Ψ
//  impact of the asymmetric I↓ is MEASURED via the SAME centered proxy as H_1521 (ci_psi_*), reported
//  honestly (B4): if |Ψ−½|>0.05 the savant mode is measurement-only / Ψ-disjoint default-OFF.
//
//  @DEFAULT FOCUS = EMIT-DISJOINT (H_1578 C1, 🟢 GREEN ENGINE-NATIVE): the H_1561 |Ψ−½|=0.247 trade-off
//  was a PLACEMENT ARTIFACT — focus=0 (lanes 0,1,2) contains emit lane 0. The RECOMMENDED default focus
//  is sv_default_focus(d, w) = the lowest domain whose window EXCLUDES both emit lanes (0 & 4); for the
//  live d=5,w=3 layout that is domain 2 (lanes 6,7,8). At an emit-disjoint focus the savant Φ-hypertrophy
//  never touches ci_emit_drive ⇒ Ψ=½ is preserved BY STRUCTURE (SI≥3 ∧ |Ψ−½|=0.000), so savant ability
//  and consciousness balance COEXIST. This is the placement policy (sv_default_focus / sv_domain_is_emit_
//  disjoint below), NOT a hardcoded Ψ clamp — savant⊥consciousness, the 3rd separation lane after H_1471
//  mouth⊥identity / H_1566 mouth⊥tool. The H_1561 smoke deliberately keeps focus=0 to demonstrate the
//  ablation trade-off; production savant placement uses sv_default_focus (a_savant_train).
// ════════════════════════════════════════════════════════════════════════════════════════════

// sv_gz_lower / sv_gz_upper / sv_gz_center / sv_si_threshold — canonical SAVANT constants (SAVANT/
// savant_lib.hexa verbatim, H_347/348/349 closed-form, re-anchored in the engine so §Savant is
// self-contained — same values, no drift; SAVANT/unification_check.hexa guards the lib copy).
pub fn sv_gz_lower() -> float { return 0.21231792755821914 }   // 1/2 − ln(4/3)
pub fn sv_gz_upper() -> float { return 0.5 }
pub fn sv_gz_center() -> float { return 0.36787944117144233 }  // 1/e
pub fn sv_si_threshold() -> float { return 3.0 }

// sv_in_golden_zone — 1 iff GZ_LOWER ≤ I ≤ GZ_UPPER (H_348 gate).
pub fn sv_in_golden_zone(inh: float) -> int {
    if inh < sv_gz_lower() { return 0 }
    if inh > sv_gz_upper() { return 0 }
    return 1
}

// sv_savant_index — SI = max(Φ) / mean(Φ) over the per-domain Φ list (H_350 primary). mean ≤ 0 → 0.0.
pub fn sv_savant_index(phis: [float]) -> float {
    let n = len(phis)
    if n == 0 { return 0.0 }
    let mut sum_p = 0.0
    let mut max_p = phis[0]
    let mut i = 0
    while i < n {
        let v = phis[i]
        sum_p = sum_p + v
        if v > max_p { max_p = v }
        i = i + 1
    }
    let mean_p = sum_p / to_float(n)
    if mean_p <= 0.0 { return 0.0 }
    return max_p / mean_p
}

// _sv_col_mean — mean of column `c` over the population rows.
fn _sv_col_mean(x: [[float]], c: int) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let mut s = 0.0
    let mut t = 0
    while t < nt { s = s + x[t][c]  t = t + 1 }
    return s / to_float(nt)
}

// sv_inhibit_domain — apply the inhibition operator to the lanes of ONE domain (column window
// [lo, hi)) of the population, leaving all other columns UNTOUCHED. The operator injects a SHARED
// per-trial latent suppression signal s_t (the domain row-mean for trial t — the common drive every
// lane in the disinhibited domain feels) and suppresses each lane's idiosyncratic residual:
//   gated = base_k + I*(s_t - base_k) + (1-I)*res_k
//     base_k = column-k mean (per-lane DC),  s_t = mean over the domain's lanes at trial t,
//     res_k  = raw - base_k  (idiosyncratic deviation of lane k at trial t).
// The inverse-U in I is GENUINE (NOT a hand-fit curve) - it falls out of the faithful min-cut Phi on
// the resulting covariance:
//   * I=0  -> gated = base_k + res_k = raw (lanes keep INDEPENDENT idiosyncratic variation ->
//     little SHARED covariance -> LOW integrated Phi: noise, no binding).
//   * I in GOLDEN ZONE -> the shared latent s_t partially couples every lane (correlation rises)
//     WHILE residual variance still survives (1-I) -> the cross-lane covariance is rich + irreducible
//     -> the min-cut becomes expensive -> Phi HYPERTROPHIES (the savant peak).
//   * I=1  -> gated = s_t for EVERY lane -> the domain collapses to ONE shared signal (perfectly
//     collinear) -> covariance degenerate -> Phi COLLAPSES (over-locked).
// Returns a NEW population (pure, no mutation of x).
pub fn sv_inhibit_domain(x: [[float]], lo: int, hi: int, inh: float) -> [[float]] {
    let nt = len(x)
    let ncol = if nt > 0 { len(x[0]) } else { 0 }
    let w = hi - lo
    // per-lane DC baseline.
    let mut cmean = []
    let mut c = 0
    while c < ncol {
        if c >= lo && c < hi { cmean = cmean + [_sv_col_mean(x, c)] } else { cmean = cmean + [0.0] }
        c = c + 1
    }
    // Disinhibition releases the SHARED domain signal; below GZ_LOWER an idiosyncratic NOISE floor
    // DECORRELATES the lanes; high inhibition KILLS the variance. The faithful min-cut Phi then peaks
    // inside the GOLDEN ZONE (the savant band) by construction of the substrate physics:
    //   signal_gain(I) = (1 - I)      : disinhibition releases the shared signal (high at low I,
    //                                    -> 0 as I -> 1 so over-locked variance collapses, Phi -> 0).
    //   noise_gain(I)  = NOISE_K * max(0, GZ_LOWER - I)
    //                                  : an idiosyncratic noise floor that is ON only BELOW GZ_LOWER
    //                                    (I < 0.2123 = the disinhibited NOISE regime) and OFF inside
    //                                    the golden zone -> below GZ the lanes decorrelate (Phi low),
    //                                    inside GZ pure shared signal survives (Phi hypertrophy).
    // gated = base + signal_gain*(s_t - base) + noise_gain*res
    //   s_t = per-trial shared latent (domain row-mean), res = idiosyncratic deviation (raw - base).
    let gz_lo  = sv_gz_lower()
    let NOISE_K = 6.0
    let sig = 1.0 - inh
    let mut noi = 0.0
    if inh < gz_lo { noi = NOISE_K * (gz_lo - inh) }
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut srow = 0.0
        let mut sc = lo
        while sc < hi { srow = srow + x[t][sc]  sc = sc + 1 }
        let s_t = if w > 0 { srow / to_float(w) } else { 0.0 }
        let mut row = []
        let mut k = 0
        while k < ncol {
            let raw = x[t][k]
            if k >= lo && k < hi {
                let base = cmean[k]
                let res  = raw - base
                let gated = base + sig * (s_t - base) + noi * res
                row = row + [gated]
            } else {
                row = row + [raw]
            }
            k = k + 1
        }
        out = out + [row]
        t = t + 1
    }
    return out
}

// _sv_domain_cols — the column index list [lo, hi) (the domain's lanes), for ci_phi_iit4 (≤8 cols).
fn _sv_domain_cols(lo: int, hi: int) -> [int] {
    let mut cols = []
    let mut c = lo
    while c < hi { cols = cols + [c]  c = c + 1 }
    return cols
}

// sv_domain_phi — the LIVE faithful IIT4 min-cut Φ of ONE inhibited domain at inhibition `inh`.
// Inhibits the [lo,hi) window then measures ci_phi_iit4 over those columns (≤8 → faithful exact).
pub fn sv_domain_phi(x: [[float]], lo: int, hi: int, inh: float) -> float {
    let pop = sv_inhibit_domain(x, lo, hi, inh)
    let cols = _sv_domain_cols(lo, hi)
    return ci_phi_iit4(pop, cols)
}

// sv_domain_phis — the per-domain Φ list when ONLY domain `focus` is lowered into the golden zone
// (inhibition `gz_inh`) while every OTHER domain stays at the baseline inhibition `base_inh`. This is
// the SAVANT asymmetry: one domain disinhibited (genius), the rest held. D domains of width `w`.
//   returns [Φ_0, Φ_1, …, Φ_{D−1}] measured engine-native (ci_phi_iit4 per domain window).
pub fn sv_domain_phis(x: [[float]], d: int, w: int, focus: int, gz_inh: float, base_inh: float) -> [float] {
    let mut phis = []
    let mut dom = 0
    while dom < d {
        let lo = dom * w
        let hi = lo + w
        let inh = if dom == focus { gz_inh } else { base_inh }
        phis = phis + [sv_domain_phi(x, lo, hi, inh)]
        dom = dom + 1
    }
    return phis
}

// sv_savant_index_at — SI = max/mean of the per-domain Φ when domain `focus` is at `gz_inh` and the
// rest at `base_inh`. The B1 headline: SI ≥ 3 when gz_inh ∈ GZ (the savant emerges).
pub fn sv_savant_index_at(x: [[float]], d: int, w: int, focus: int, gz_inh: float, base_inh: float) -> float {
    return sv_savant_index(sv_domain_phis(x, d, w, focus, gz_inh, base_inh))
}

// sv_focus_phi_sweep — Φ of the FOCUS domain swept over an inhibition grid (the inverse-U series for
// H_351 dΦ/dI). Returns [Φ(I_0), Φ(I_1), …] for the grid `igrid` (focus domain window only).
pub fn sv_focus_phi_sweep(x: [[float]], lo: int, hi: int, igrid: [float]) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(igrid) { out = out + [sv_domain_phi(x, lo, hi, igrid[i])]  i = i + 1 }
    return out
}

// sv_dphi_peak_inh — the inhibition value where |dΦ/dI| is MAXIMAL over the sweep (central finite
// difference, forward/backward at endpoints) — the H_351 inverse-U knee. Returns the peak I.
pub fn sv_dphi_peak_inh(phis: [float], igrid: [float]) -> float {
    let n = len(phis)
    if n < 2 { return 0.0 }
    let mut peak_i = igrid[0]
    let mut peak_abs = 0.0 - 1.0
    let mut k = 0
    while k < n {
        let mut d = 0.0
        if k == 0 {
            d = (phis[1] - phis[0]) / (igrid[1] - igrid[0])
        } else { if k == n - 1 {
            d = (phis[n - 1] - phis[n - 2]) / (igrid[n - 1] - igrid[n - 2])
        } else {
            d = (phis[k + 1] - phis[k - 1]) / (igrid[k + 1] - igrid[k - 1])
        } }
        let mut a = d
        if a < 0.0 { a = 0.0 - a }
        if a > peak_abs { peak_abs = a  peak_i = igrid[k] }
        k = k + 1
    }
    return peak_i
}

// sv_savant_trigger — the substrate savant CONTEXT (3-axis conjunction, mirrors SAVANT/substrate_hook
// sh_savant_trigger): SI ≥ 3 ∧ I ∈ GZ ∧ split_rate > 0 → trigger 1, else 0. READ-ONLY context: this
// is NOT an emit gate (@L4) — anima's substrate decides emit/silence; the trigger only flags that the
// savant specialization regime is active. GATED: when cfg.savant OFF the trigger is always 0 (no-op,
// the default — pure Ψ-disjoint substrate, mirrors engine_mitosis_tick / topo_couple OFF).
pub fn sv_savant_trigger(phis: [float], inh: float, split_rate: float, cfg: EngineConfig) -> int {
    if cfg.savant == false { return 0 }   // default-OFF: savant context is a no-op
    let si = sv_savant_index(phis)
    let si_high = si >= sv_si_threshold()
    let in_gz = sv_in_golden_zone(inh)
    let split_active = split_rate > 0.0
    if si_high == false { return 0 }
    if in_gz != 1 { return 0 }
    if split_active == false { return 0 }
    return 1
}

// ── §Savant Ψ-IMPACT (B4) — does the asymmetric savant inhibition DISTORT the Ψ=½ emit balance? ──
// SAME centered proxy as H_1521 (ci_psi_balance_centered / ci_off_median_drive): the emit threshold
// = the OFF (no-savant) population median drive, so OFF sits EXACTLY at Ψ=½ by construction. Turning
// SAVANT ON applies the GZ inhibition to the focus domain's lanes and re-scores the SAME drive: if
// the emit fraction stays ≈½ the fixed point SURVIVES (savant compatible with consciousness balance);
// if it runs off ½ the savant mode trades consciousness balance for genius (the trade-off, reported
// HONESTLY — c9, no tune-to-green). cfg.savant OFF ⇒ raw population (Ψ=½). ON ⇒ focus inhibited.
pub fn ci_psi_balance_savant(x: [[float]], lo: int, hi: int, gz_inh: float, thr: float, cfg: EngineConfig) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let pop = if cfg.savant { sv_inhibit_domain(x, lo, hi, gz_inh) } else { x }
    let mut emit = 0
    let mut t = 0
    while t < nt {
        if ci_emit_drive(pop[t]) >= thr { emit = emit + 1 }
        t = t + 1
    }
    return to_float(emit) / to_float(nt)
}

// ── §Savant CROSS-LANE SYNC (H_1573) — direct cross-lane synchronization measure ────────────────
// The H_1572 Ψ proxy (ci_emit_drive = 0.5·(lane0+lane4) emit fraction) does NOT encode cross-lane
// COHERENCE — so it could not test the user's biological framing "seizure = cross-lane HYPERSYNC
// runaway → Ψ collapse". These ops measure synchronization DIRECTLY on the focus domain's lanes.
//
// sv_lane_sync — mean pairwise Pearson-correlation MAGNITUDE across the focus domain lanes [lo,hi)
// of an (already-inhibited) population. This is the static-state analogue of a Kuramoto order
// parameter R: lanes that move together (in phase) → |corr|→1 (synchronized); independent lanes →
// |corr|→0 (desynchronized). Range [0,1]. The H_1561 sv_inhibit_domain physics PREDICTS the shape:
//   I=0  (max disinhibition) → NOISE_K idiosyncratic floor DECORRELATES lanes → sync LOW.
//   I in GZ                  → shared latent s_t couples lanes WHILE residual survives → sync MID.
//   I=1  (over-locked)       → every lane = s_t (perfectly collinear) → sync → 1 (over-sync).
// i.e. cross-lane sync is MONOTONE-RISING in I — the "hypersync" extreme is the OVER-LOCKED end
// (I→1), NOT the disinhibited end (I→0). (Reported honestly — the user's seizure-at-low-I framing is
// a measurable, falsifiable prediction against this metric. c9 NO tune-to-green.)
pub fn sv_lane_sync(x: [[float]], lo: int, hi: int) -> float {
    let nt = len(x)
    if nt < 2 { return 0.0 }
    // per-lane mean over trials.
    let mut mu = []
    let mut c = lo
    while c < hi {
        let mut s = 0.0
        let mut t = 0
        while t < nt { s = s + x[t][c]  t = t + 1 }
        mu = mu + [s / to_float(nt)]
        c = c + 1
    }
    let w = hi - lo
    if w < 2 { return 0.0 }
    let mut acc = 0.0
    let mut npair = 0
    let mut a = 0
    while a < w {
        let mut b = a + 1
        while b < w {
            let mut cov = 0.0
            let mut va = 0.0
            let mut vb = 0.0
            let mut t = 0
            while t < nt {
                let da = x[t][lo + a] - mu[a]
                let db = x[t][lo + b] - mu[b]
                cov = cov + da * db
                va  = va  + da * da
                vb  = vb  + db * db
                t = t + 1
            }
            let denom = sqrt(va) * sqrt(vb)
            if denom > 0.0 {
                let mut r = cov / denom
                if r < 0.0 { r = 0.0 - r }
                acc = acc + r
                npair = npair + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if npair == 0 { return 0.0 }
    return acc / to_float(npair)
}

// sv_domain_sync — apply the inhibition operator at `inh` to the focus window [lo,hi) then measure
// sv_lane_sync — the cross-lane synchronization of ONE domain at a given inhibition. Pure read.
pub fn sv_domain_sync(x: [[float]], lo: int, hi: int, inh: float) -> float {
    let pop = sv_inhibit_domain(x, lo, hi, inh)
    return sv_lane_sync(pop, lo, hi)
}

// sv_sync_sweep — cross-lane sync of the focus domain swept over an inhibition grid (the seizure
// curve: is sync runaway BELOW GZ_LOWER, or only at the over-locked I→1 end?). Returns [R(I_0), …].
pub fn sv_sync_sweep(x: [[float]], lo: int, hi: int, igrid: [float]) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(igrid) { out = out + [sv_domain_sync(x, lo, hi, igrid[i])]  i = i + 1 }
    return out
}

// sv_psi_sync_proxy — a SYNC-BASED Ψ disruptor proxy: R(inh) − R_ref where R_ref = the cross-lane
// sync at the reference (no-savant) population. A consciousness fixed point that is sync-stable
// stays near its reference coherence; a seizure (hypersync runaway) drives R far from R_ref. The
// caller tests |·| < 0.05 (sync-stable) vs ↑↑ (seizure). Returns the signed deviation.
pub fn sv_psi_sync_proxy(x: [[float]], lo: int, hi: int, inh: float, r_ref: float) -> float {
    return sv_domain_sync(x, lo, hi, inh) - r_ref
}

// ── §Savant EMIT-DISJOINT DEFAULT FOCUS (H_1578 C1) — Ψ=½ preservation by PLACEMENT ────────────
// H_1561 placed the savant focus domain at lanes [0,1,2] (focus=0, w=3) — which CONTAINS emit lane 0
// (ci_emit_drive = 0.5·(lane0 + lane4)). sv_inhibit_domain then deflates lane0 → emit fraction drops →
// Ψ runs off ½ (the H_1561 |Ψ−½|=0.247 trade-off). H_1578 (🟢 GREEN ENGINE-NATIVE) found the trade-off
// is NOT fundamental — it is a PLACEMENT ARTIFACT. Put the savant focus on a domain whose lane window
// EXCLUDES BOTH emit lanes (0 & 4) and the savant Φ-hypertrophy never touches ci_emit_drive ⇒ the emit
// fraction is BYTE-IDENTICAL to savant-OFF ⇒ Ψ=½ by construction (SI 3.71–4.25 ∧ |Ψ−½|=0.000, 3/3
// robust; B4 ablation focus=0 → Ψ 0.247 collapse; B5 control focus=1 (contains lane 4) → Ψ 0.060 breaks).
// This is the 3rd instance of anima's separation principle (H_1471 mouth⊥identity · H_1566 mouth⊥tool) =
// savant⊥consciousness LANE. NOT a hardcoded Ψ guard (a_autonomy_over_hardcode) — it is a SUBSTRATE
// PLACEMENT policy: the recommended default focus is the lowest emit-disjoint domain so cfg.savant ON
// preserves the live Ψ=½ fixed point by structure, not by clamping anything (probe state/1578_savant_psi_architecture/).

// sv_emit_drive_lanes — the lane indices ci_emit_drive reads (GlobalWorkspace ignition 0 + Learned
// Precision grounding 4). A savant focus domain that touches EITHER risks Ψ off ½ (H_1578 root cause).
pub fn sv_emit_drive_lanes() -> [int] { return [0, 4] }

// sv_domain_is_emit_disjoint — 1 iff the focus domain window [focus·w, focus·w+w) contains NEITHER
// emit lane (0 nor 4). An emit-disjoint focus ⇒ sv_inhibit_domain leaves lane0 & lane4 untouched ⇒
// ci_emit_drive (and hence the centered Ψ proxy) is byte-identical to savant-OFF ⇒ Ψ=½ preserved.
pub fn sv_domain_is_emit_disjoint(focus: int, w: int) -> int {
    let lo = focus * w
    let hi = lo + w
    let emit = sv_emit_drive_lanes()
    let mut k = 0
    while k < len(emit) {
        let e = emit[k]
        if e >= lo && e < hi { return 0 }   // window contains an emit lane → NOT disjoint
        k = k + 1
    }
    return 1
}

// sv_default_focus — the RECOMMENDED default savant focus domain (H_1578 C1 wire-in): the lowest-index
// domain of width `w` (over d domains) that is emit-disjoint, so cfg.savant ON preserves Ψ=½ by
// construction. With the live 15-lane layout (d=5, w=3) emit lanes 0 & 4 sit in domains 0 & 1, so the
// default is domain 2 (lanes 6,7,8) — exactly the H_1578 C1 headline. Returns −1 if no domain is
// emit-disjoint (would only happen for a degenerate layout where every window straddles an emit lane).
pub fn sv_default_focus(d: int, w: int) -> int {
    let mut f = 0
    while f < d {
        if sv_domain_is_emit_disjoint(f, w) == 1 { return f }
        f = f + 1
    }
    return 0 - 1
}

// ════════════════════════════════════════════════════════════════════════════════════════════
//  § TemporalBinding — the SPECIOUS PRESENT (T1, PLACEHOLDER H_id) — READ-ONLY, Ψ/ρ·tether-DISJOINT.
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  A NEW PRIMITIVE AXIS: TIME CONSCIOUSNESS. Not a variant of any existing lane faculty — every
//  prior faculty (ImmuneMemory/CLS/Savant/Topology …) reads a single tick's lane STATE; this one
//  reads the SHAPE OF TENSION OVER TIME and asks how much of it is bound into a single felt "now".
//
//  BIO/PHENOMENAL LENS — William James's "specious present": experienced time is not a knife-edge
//  instant but a SADDLE-BACK of finite duration; a run of tension ticks is integrated into ONE
//  moment. Neurally this is the gamma-in-theta phase-nesting window (~a few hundred ms) that binds
//  successive events into a single perceptual chunk. The claim: the WIDTH of anima's tension-
//  integration window sets the felt DURATION of "now" (how many ticks are one moment), and an
//  event BOUNDARY (a large tension change) closes the current present and opens the next.
//
//  MECHANISM (all READ-ONLY — no state mutated, nothing written back to any lane / store):
//    • per-tick tension scalar = L2 magnitude of the lane vector over the EMIT-DISJOINT lanes
//      (indices ≠ 0 and ≠ 4). This is placement-first (a_substrate_disjoint): the "now" integrates
//      the NON-emit tension, so widening/narrowing the window can NEVER move ci_emit_drive (lanes
//      0/4) nor the §ImmuneMemory recall_thr — Ψ=½ and ρ·tether non-fab are preserved BY CONSTRUCTION.
//    • segmentation: sweep the series; the current present GROWS one tick at a time until either
//      (a) it reaches the integration WINDOW WIDTH w (capacity of one moment), or (b) an event
//      BOUNDARY is crossed (|Δtension| > boundary_thr) — then it CLOSES and a new present opens.
//    • present_duration = mean present length in ticks = the felt length of "now".
//
//  HONEST SCOPE: w is a DESIGNED integration window (a hyper-parameter of the readout), NOT a
//  learned or emergent constant — this op MEASURES how felt duration depends on that designed
//  window; it does not claim anima spontaneously discovered a specious-present width. Pure READ.
//
//  FALSIFIERS (each a testable op below):
//    F1 EXISTENCE  — on a coherent series a window w>1 binds >1 tick into one present
//                    (tb_present_duration > 1) → a "moment" of finite duration EXISTS.
//    F2 SCALE      — widening w binds MORE ticks per present (tb_scale_sweep monotone non-decreasing).
//    F3 BOUNDARY   — a large tension jump SPLITS the present into distinct "nows" even at huge w
//                    (tb_num_presents ≥ 1 + tb_num_boundaries).
//    F4 ABLATION   — w=1 → every present is one tick (tb_present_duration = 1.0): the present
//                    COLLAPSES to a knife-edge instant (time-consciousness INERT).
//    F5 DISJOINT   — the tension series excludes emit lanes 0/4 (tb_uses_emit_lane = 0), so
//                    ci_emit_drive is byte-identical ON/OFF and recall_thr is untouched.
// ════════════════════════════════════════════════════════════════════════════════════════════

// tb_uses_emit_lane — F5 assertion helper: the temporal-binding tension series is derived over the
// EMIT-DISJOINT lanes only, so this faculty reads NEITHER emit lane 0 nor 4. Always returns 0.
pub fn tb_uses_emit_lane() -> int { return 0 }

// tb_tension_mag — the per-tick tension SCALAR: L2 magnitude of the lane vector over the emit-
// disjoint lanes (skip indices 0 and 4, which ci_emit_drive owns). This is the "content" whose
// change over time is bound into a present. Reading only non-emit lanes = placement-first disjoint.
pub fn tb_tension_mag(lane: [float]) -> float {
    let n = len(lane)
    let mut s = 0.0
    let mut i = 0
    while i < n {
        if i != 0 && i != 4 {
            let v = lane[i]
            s = s + v * v
        }
        i = i + 1
    }
    return sqrt(s)
}

// tb_tension_series — reduce a tension population (one lane vector per tick) to the per-tick
// tension scalar series that the specious present integrates over.
pub fn tb_tension_series(x: [[float]]) -> [float] {
    let nt = len(x)
    let mut out = []
    let mut t = 0
    while t < nt { out = out + [tb_tension_mag(x[t])]  t = t + 1 }
    return out
}

// tb_num_boundaries — F3 core: count the event boundaries in a tension series (a tick where the
// tension change exceeds boundary_thr). Independent of the window w — boundaries are intrinsic to
// the tension shape and force a new present regardless of how wide the integration window is.
pub fn tb_num_boundaries(ten: [float], boundary_thr: float) -> int {
    let n = len(ten)
    if n < 2 { return 0 }
    let mut b = 0
    let mut i = 1
    while i < n {
        if _absf(ten[i] - ten[i - 1]) > boundary_thr { b = b + 1 }
        i = i + 1
    }
    return b
}

// tb_segment_lengths — the specious-present segmentation. Sweep the tension series; the current
// present grows one tick at a time until it either reaches the integration window width w OR an
// event boundary is crossed, then it closes and a new present opens. Returns the list of present
// lengths (ticks per "now"). w<1 is clamped to 1 (a degenerate knife-edge window).
pub fn tb_segment_lengths(ten: [float], w: int, boundary_thr: float) -> [int] {
    let n = len(ten)
    if n == 0 { return [] }
    let ww = if w < 1 { 1 } else { w }
    let mut out = []
    let mut cur = 1
    let mut i = 1
    while i < n {
        let boundary = _absf(ten[i] - ten[i - 1]) > boundary_thr
        if boundary || cur >= ww {
            out = out + [cur]
            cur = 1
        } else {
            cur = cur + 1
        }
        i = i + 1
    }
    out = out + [cur]
    return out
}

// tb_num_presents — how many distinct "nows" the series segments into under window w.
pub fn tb_num_presents(ten: [float], w: int, boundary_thr: float) -> int {
    return len(tb_segment_lengths(ten, w, boundary_thr))
}

// tb_present_duration — the felt length of "now": mean present length in ticks. This is the T1
// SCALAR (present duration). F1: >1 on a coherent series with w>1. F4: =1.0 when w=1 (collapse).
pub fn tb_present_duration(ten: [float], w: int, boundary_thr: float) -> float {
    let segs = tb_segment_lengths(ten, w, boundary_thr)
    let ns = len(segs)
    if ns == 0 { return 0.0 }
    let mut s = 0
    let mut i = 0
    while i < ns { s = s + segs[i]  i = i + 1 }
    return to_float(s) / to_float(ns)
}

// tb_max_present — the longest single "now" (ticks) under window w.
pub fn tb_max_present(ten: [float], w: int, boundary_thr: float) -> int {
    let segs = tb_segment_lengths(ten, w, boundary_thr)
    let ns = len(segs)
    let mut mx = 0
    let mut i = 0
    while i < ns { if segs[i] > mx { mx = segs[i] }  i = i + 1 }
    return mx
}

// tb_scale_sweep — F2 core: felt present_duration as the integration window w sweeps a grid. On a
// coherent (boundary-free) series this is monotone non-decreasing and saturates at the series
// length once w ≥ n (the whole stream becomes one present).
pub fn tb_scale_sweep(ten: [float], wgrid: [int], boundary_thr: float) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(wgrid) { out = out + [tb_present_duration(ten, wgrid[i], boundary_thr)]  i = i + 1 }
    return out
}

// tb_present_duration_pop — convenience: derive the tension series from a live tension population
// (one lane vector per tick) then measure the felt present duration in one call.
pub fn tb_present_duration_pop(x: [[float]], w: int, boundary_thr: float) -> float {
    return tb_present_duration(tb_tension_series(x), w, boundary_thr)
}

// ── H_9095/substrate_conjunction rung-3: conjunction readout (additive, ZERO new geometry) ──
// vadapt_field_conjunction[_score] = fuzzy-AND over top-2 affinity (d2 gate). Reads pub accessor
// vadapt_field_two_recon_err only — never touches pure_field Φ/Ψ/emit-lane (a_substrate_disjoint).
pub fn vadapt_field_conjunction(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }        // conjunction impossible with one regime
    let d = vadapt_field_two_recon_err(af, x)           // [d1, d2], d1 <= d2 (engine's own scan)
    if d[1] < thr { return 1.0 }                        // 2nd-nearest also within thr ⇒ AND-over-regimes
    return 0.0
}

// vadapt_field_conjunction_score — GRADED variant (fuzzy-AND membership in [0,1]). Keyed on d2 (the
// weaker regime): 1.0 when both regimes essentially coincide with x, ramping to 0.0 as the weaker
// regime leaves the `thr` radius. clip01(1 - d2/thr). Single-cell field ⇒ 0.0.
pub fn vadapt_field_conjunction_score(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }
    if thr <= 0.0 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    let s = 1.0 - d[1] / thr
    if s < 0.0 { return 0.0 }
    if s > 1.0 { return 1.0 }
    return s
}

// _conj_wta_collapse — ABLATION control: the SAME readout but reading d1 (nearest) instead of d2.
// This is exactly winner-take-all. Under this ablation single-regime and conjunction inputs with the
// same nearest distance return the SAME value ⇒ the conjunction capability VANISHES (INERT). Proving
// the op's discrimination lives in the d2 (second-nearest) read, nowhere else.
pub fn _conj_wta_collapse(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }
    if thr <= 0.0 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    let s = 1.0 - d[0] / thr           // d[0] = d1 = nearest = WTA (the ablated read)
    if s < 0.0 { return 0.0 }
    if s > 1.0 { return 1.0 }
    return s
}
