    let m = if cfg.mitosis { "on" } else { "off" }
    return "engine_cli · ENGINE CLI control axis (substrate-config, NOT an emit gate, @L4) · "
        + "flags: --mitosis on|off · --no-mitosis · env ANIMA_MITOSIS · --engine conv|cdv2|hexad|omega · env ANIMA_ENGINE · "
        + "precedence flag>env>default · "
        + "mitosis=" + m + " (ON=substrate grows per inference-time cell-division tick, p8; OFF=no-op split, ablation) · "
        + "engine=" + cfg.engine + " (conv=default .clm decoder; cdv2=ConsciousDecoderV2; hexad=σ6 integration; omega=closure engine, substrate→decode coupling bus; select=substrate-config NOT emit gate) · "
        + "extensible: future ENGINE flags (lane select A/G/P/M) ride the same EngineConfig axis"
}

// ── §  SKILL-CELL MEMORY — mitosis-grow continual learner (H_1300 R3) ─────────
//
// WHAT THIS CLOSES (a_engine_native_learning + a_verified_must_wire for H_1300 R2):
// H_1300 R2 (numpy VAdaptField mirror, 🟢 GREEN, 3 seeds) proved that teaching tool-use
// skills ONE AT A TIME via MITOSIS-GROW avoids CATASTROPHIC FORGETTING: each new skill =
// new dedicated cells grown under that skill's error pressure (mitosis split, H_1199 /
// H_1288), the cells for earlier skills are NEVER overwritten, so the learner RETAINS
// old skills where a single shared gradient-FT net FORGETS them. This faculty realizes
// that EXACT mechanism ENGINE-NATIVE so the grow / fit / route / FT arithmetic runs on
// the .hexa engine (not numpy) and the FROZEN R2 retention bars re-score engine-native.
// Neurogenesis / functional-segregation lens (a_no_llm_frame_trap), NOT a bigger net.
//
// MECHANISM (mirrors UNIVERSE/h1300_mitosis_skill_curriculum.py arm B, byte-faithful to
// the engine-realizable ops — Gaussian-elimination ridge solve + power-iteration
// principal axis replace numpy's LAPACK solve/SVD; the pre-check in
// UNIVERSE/h1300_r3_engine_export.py's sibling reproduces the SAME R2 GREEN):
//   * skill_grow(x,y): start 1 cell at the region centroid; while the worst cell's local
//     train-error > SPLIT_THRESH and we are under GROW_MAX_PER_SKILL, MITOSIS-SPLIT it —
//     bisect its owned points along their top-variance axis (power iteration) into two
//     sub-centroids, refit each cell's CLOSED-FORM local C-way head (ridge LSQ on one-hot
//     targets, NO global backprop). The grown cells are DEDICATED to this skill.
//   * skill_route(cells,x): assign x to its NEAREST cell center (L2), emit argmax of that
//     cell's local head — earlier skills' cells stay intact (no overwrite = no forgetting).
// Ψ-disjoint by construction: the faculty only grows/reads a cell population; it never
// touches pure_field Φ/phase/Ψ. p6: the tool-token target is the task's owner supervised
// signal (scored only) — NO labels/persona/ethics injected. p8: growth = the engine's owner
// mitosis tick (gated through engine_mitosis_tick under cfg.mitosis).

// _sc_C — tool-token count (chance = 1/_sc_C). FROZEN from H_1300.
fn _sc_C() -> int { return 4 }
fn _sc_SPLIT_THRESH() -> float { return 0.05 }   // local train-err > this -> split
fn _sc_GROW_MAX() -> int { return 4 }             // finite per-skill cell bound (footprint)

// a grown prototype cell: a center (Voronoi owner) + a local C-way linear head (W,b).
struct SkillCell {
    center: [float],
    head_w: [[float]],   // (C, D)
    head_b: [float]      // (C)
}

// _sc_vmean — column-mean of a set of DIM rows (the cell centroid).
fn _sc_vmean(rows: [[float]]) -> [float] {
    let n = len(rows)
    let d = len(rows[0])
    let mut out = []
    let mut j = 0
    while j < d {
        let mut s = 0.0
        let mut i = 0
        while i < n { s = s + rows[i][j]  i = i + 1 }
        out = out + [s / to_float(n)]
        j = j + 1
    }
    return out
}

// _sc_argmax_score — argmax over the C-way local head score (W·x + b) for one row.
fn _sc_argmax(hw: [[float]], hb: [float], x: [float]) -> int {
    let cc = len(hw)
    let d = len(x)
    let mut best = 0
    let mut bestv = 0.0
    let mut c = 0
    while c < cc {
        let mut s = hb[c]
        let mut j = 0
        while j < d { s = s + hw[c][j] * x[j]  j = j + 1 }
        if c == 0 || s > bestv { bestv = s  best = c }
        c = c + 1
    }
    return best
}

// _sc_gauss_solve — solve A·X = B by Gauss-Jordan with partial pivoting (hexa-native
// replacement for numpy's LAPACK solve). A is (n,n), B is (n,m); returns X (n,m).
fn _sc_gauss_solve(a: [[float]], b: [[float]]) -> [[float]] {
    let n = len(a)
    let m = len(b[0])
    // augmented [A | B]
    let mut aug = []
    let mut i = 0
    while i < n {
        aug = aug + [a[i] + b[i]]
        i = i + 1
    }
    let mut col = 0
    while col < n {
        // partial pivot: row with max |aug[r][col]| for r>=col
        let mut piv = col
        let mut pv = _absf(aug[col][col])
        let mut r = col + 1
        while r < n {
            let av = _absf(aug[r][col])
            if av > pv { pv = av  piv = r }
            r = r + 1
        }
        if piv != col {
            let tmp = aug[piv]  aug[piv] = aug[col]  aug[col] = tmp
        }
        let d = aug[col][col]
        // normalize pivot row
        let mut k = 0
        while k < n + m { aug[col][k] = aug[col][k] / d  k = k + 1 }
        // eliminate the column from every other row
        let mut r2 = 0
        while r2 < n {
            if r2 != col {
                let f = aug[r2][col]
                let mut k2 = 0
                while k2 < n + m { aug[r2][k2] = aug[r2][k2] - f * aug[col][k2]  k2 = k2 + 1 }
            }
            r2 = r2 + 1
        }
        col = col + 1
    }
    // extract X = aug[:, n:]
    let mut out = []
    let mut i2 = 0
    while i2 < n {
        let mut row = []
        let mut j = n
        while j < n + m { row = row + [aug[i2][j]]  j = j + 1 }
        out = out + [row]
        i2 = i2 + 1
    }
    return out
}

// skill_fit_head — closed-form ridge local C-way head over a cell's owned points.
// Y = one-hot(y); X = [x | 1]; solve (XᵀX + λI)·sol = Xᵀ·Y ; head = (sol[:-1]ᵀ, sol[-1]).
// NO global backprop — local to the owned points only.
pub fn skill_fit_head(x: [[float]], y: [int]) -> SkillCell {
    let n = len(x)
    let d = len(x[0])
    let cc = _sc_C()
    let lam = 0.001
    // build X (n, d+1) and Y (n, C)
    let mut xb = []
    let mut yy = []
    let mut i = 0
    while i < n {
        xb = xb + [x[i] + [1.0]]
        let mut oh = []
        let mut c = 0
        while c < cc { oh = oh + [if c == y[i] { 1.0 } else { 0.0 }]  c = c + 1 }
        yy = yy + [oh]
        i = i + 1
    }
    // A = XᵀX + λI  (d+1, d+1) ; RHS = XᵀY  (d+1, C)
    let dp = d + 1
    let mut amat = []
    let mut rhs = []
    let mut a = 0
    while a < dp {
        let mut arow = []
        let mut bcol = 0
        while bcol < dp {
            let mut s = 0.0
            let mut k = 0
            while k < n { s = s + xb[k][a] * xb[k][bcol]  k = k + 1 }
            if a == bcol { s = s + lam }
            arow = arow + [s]
            bcol = bcol + 1
        }
        amat = amat + [arow]
        let mut rrow = []
        let mut c2 = 0
        while c2 < cc {
            let mut s2 = 0.0
            let mut k2 = 0
            while k2 < n { s2 = s2 + xb[k2][a] * yy[k2][c2]  k2 = k2 + 1 }
            rrow = rrow + [s2]
            c2 = c2 + 1
        }
        rhs = rhs + [rrow]
        a = a + 1
    }
    let sol = _sc_gauss_solve(amat, rhs)   // (d+1, C)
    // head_w = sol[:-1]ᵀ -> (C, D) ; head_b = sol[-1] -> (C)
    let mut hw = []
    let mut c3 = 0
    while c3 < cc {
        let mut wr = []
        let mut j = 0
        while j < d { wr = wr + [sol[j][c3]]  j = j + 1 }
        hw = hw + [wr]
        c3 = c3 + 1
    }
    let mut hb = []
    let mut c4 = 0
    while c4 < cc { hb = hb + [sol[d][c4]]  c4 = c4 + 1 }
    return SkillCell { center: _sc_vmean(x), head_w: hw, head_b: hb }
}

// _sc_local_err — fraction of a point-set misclassified by a head (the split trigger).
fn _sc_local_err(hw: [[float]], hb: [float], x: [[float]], y: [int]) -> float {
    let n = len(x)
    if n == 0 { return -1.0 }
    let mut bad = 0
    let mut i = 0
    while i < n {
        if _sc_argmax(hw, hb, x[i]) != y[i] { bad = bad + 1 }
        i = i + 1
    }
    return to_float(bad) / to_float(n)
}

// _sc_principal_axis — top principal axis of centered rows via power iteration on the
// covariance dᵀd (hexa-native replacement for numpy SVD's top right-singular vector).
fn _sc_principal_axis(d: [[float]]) -> [float] {
    let n = len(d)
    let dim = len(d[0])
    // covariance C = dᵀd (dim, dim)
    let mut cov = []
    let mut a = 0
    while a < dim {
        let mut row = []
        let mut b = 0
        while b < dim {
            let mut s = 0.0
            let mut k = 0
            while k < n { s = s + d[k][a] * d[k][b]  k = k + 1 }
            row = row + [s]
            b = b + 1
        }
        cov = cov + [row]
        a = a + 1
    }
    // power iteration
    let mut v = []
    let mut j = 0
    while j < dim { v = v + [1.0 / sqrt(to_float(dim))]  j = j + 1 }
    let mut it = 0
    while it < 50 {
        let mut nv = []
        let mut r = 0
        while r < dim {
            let mut s = 0.0
            let mut c = 0
            while c < dim { s = s + cov[r][c] * v[c]  c = c + 1 }
            nv = nv + [s]
            r = r + 1
        }
        let mut nrm = 0.0
        let mut q = 0
        while q < dim { nrm = nrm + nv[q] * nv[q]  q = q + 1 }
        nrm = sqrt(nrm)
        if nrm < 0.000000000001 { return v }
        let mut w = 0
        while w < dim { v[w] = nv[w] / nrm  w = w + 1 }
        it = it + 1
    }
    return v
}

// _sc_own — for each point, the index of its nearest center (Voronoi assignment).
fn _sc_own(centers: [[float]], x: [[float]]) -> [int] {
    let n = len(x)
    let mut out = []
    let mut i = 0
    while i < n { out = out + [_vnearest_idx(centers, x[i])]  i = i + 1 }
    return out
}

// _sc_subset — the rows / labels of x,y owned by cell `ci`.
fn _sc_subset_x(owner: [int], x: [[float]], ci: int) -> [[float]] {
    let mut out = []
    let mut i = 0
    while i < len(x) { if owner[i] == ci { out = out + [x[i]] }  i = i + 1 }
    return out
}
fn _sc_subset_y(owner: [int], y: [int], ci: int) -> [int] {
    let mut out = []
    let mut i = 0
    while i < len(y) { if owner[i] == ci { out = out + [y[i]] }  i = i + 1 }
    return out
}

// skill_grow — grow DEDICATED cells for ONE skill under error pressure (mitosis split).
// cfg gates growth (p8: each +1 split passes engine_mitosis_tick under cfg.mitosis).
// Returns the list of grown SkillCell for this skill (never re-touched after this).
pub fn skill_grow(x: [[float]], y: [int], cfg: EngineConfig) -> [SkillCell] {
    let mut centers = [_sc_vmean(x)]
    loop {
        let owner = _sc_own(centers, x)
        // fit each cell head + measure local error
        let mut cells = []
        let mut errs = []
        let mut ci = 0
        while ci < len(centers) {
            let sx = _sc_subset_x(owner, x, ci)
            let sy = _sc_subset_y(owner, y, ci)
            if len(sx) == 0 {
                // empty cell — keep a zero head, error -1 (never the worst)
                let dim = len(x[0])
                let mut zw = []
                let mut c = 0
                while c < _sc_C() {
                    let mut zr = []
                    let mut j = 0
                    while j < dim { zr = zr + [0.0]  j = j + 1 }
                    zw = zw + [zr]
                    c = c + 1
                }
                let mut zb = []
                let mut c2 = 0
                while c2 < _sc_C() { zb = zb + [0.0]  c2 = c2 + 1 }
                cells = cells + [SkillCell { center: centers[ci], head_w: zw, head_b: zb }]
                errs = errs + [-1.0]
            } else {
                let cell = skill_fit_head(sx, sy)
                cells = cells + [SkillCell { center: centers[ci], head_w: cell.head_w, head_b: cell.head_b }]
                errs = errs + [_sc_local_err(cell.head_w, cell.head_b, sx, sy)]
            }
            ci = ci + 1
        }
        // worst cell by local error
        let mut worst = 0
        let mut wv = errs[0]
        let mut e = 1
        while e < len(errs) { if errs[e] > wv { wv = errs[e]  worst = e }  e = e + 1 }
        // converged or hit the footprint bound -> finalize
        if wv <= _sc_SPLIT_THRESH() || len(centers) >= _sc_GROW_MAX() {
            return cells
        }
        // MITOSIS split of the worst cell — engine's owner tick (p8)
        let grown = engine_mitosis_tick(len(centers), cfg)
        if grown <= len(centers) {
            return cells   // mitosis OFF (ablation) — split is a no-op
        }
        let sx = _sc_subset_x(owner, x, worst)
        let c0 = _sc_vmean(sx)
        // center the owned points, find principal axis, bisect on the projection sign
        let mut dmat = []
        let mut i = 0
        while i < len(sx) {
            let mut row = []
            let mut j = 0
            while j < len(c0) { row = row + [sx[i][j] - c0[j]]  j = j + 1 }
            dmat = dmat + [row]
            i = i + 1
        }
        let axis = _sc_principal_axis(dmat)
        let mut left = []
        let mut right = []
        let mut p = 0
        while p < len(sx) {
            let mut proj = 0.0
            let mut j2 = 0
            while j2 < len(axis) { proj = proj + dmat[p][j2] * axis[j2]  j2 = j2 + 1 }
            if proj <= 0.0 { left = left + [sx[p]] } else { right = right + [sx[p]] }
            p = p + 1
        }
        if len(left) == 0 || len(right) == 0 {
            return cells   // degenerate split — finalize
        }
        centers[worst] = _sc_vmean(left)
        centers = centers + [_sc_vmean(right)]
    }
    return []   // unreachable
}

// skill_route — route ONE context to its NEAREST cell center, emit that cell's local
// argmax. `perm` (len == #cells or empty) remaps which cell each context routes to:
// empty == TRUE routing; a permutation == the SHUFFLE control (mis-route the whole grown
// population, breaking dedicated-cell ownership). Earlier skills' cells stay intact.
pub fn skill_route(cells: [SkillCell], perm: [int], x: [float]) -> int {
    if len(cells) == 0 { return -1 }
    // nearest center
    let mut best = 0
    let mut bestd = _l2(cells[0].center, x)
    let mut i = 1
    while i < len(cells) {
        let d = _l2(cells[i].center, x)
        if d < bestd { bestd = d  best = i }
        i = i + 1
    }
    if len(perm) == len(cells) { best = perm[best] }
    return _sc_argmax(cells[best].head_w, cells[best].head_b, x)
}

// _sc_softmax_row — numerically-stable softmax of one C-vector.
fn _sc_softmax_row(z: [float]) -> [float] {
    let n = len(z)
    let mut mx = z[0]
    let mut i = 1
    while i < n { if z[i] > mx { mx = z[i] }  i = i + 1 }
    let mut e = []
    let mut s = 0.0
    let mut j = 0
    while j < n { let v = exp(z[j] - mx)  e = e + [v]  s = s + v  j = j + 1 }
    let mut out = []
    let mut k = 0
    while k < n { out = out + [e[k] / s]  k = k + 1 }
    return out
}

// SkillGradFT — arm A: ONE shared C-way softmax-linear net, the incumbent that should
// catastrophically forget. skill_gradft_step trains it on ONE skill (full-batch GD,
// FT_STEPS), in place. Sequential calls skill-by-skill with NO replay = the forgetting
// regime. NOT mitosis — a single shared weight matrix overwritten each skill.
struct SkillGradFT {
    w: [[float]],   // (C, D)
    b: [float]      // (C)
}

// skill_gradft_new — initialize the shared net. weights from a tiny deterministic LCG
// seeded by `seed` (mirrors numpy RandomState(seed+5000).normal(0,0.01) in DISTRIBUTION;
// the verdict is the FROZEN retention bar, not byte-identity of the init draw — A is the
// incumbent baseline arm, exercised identically across B/shuffle/ablate seeds).
pub fn skill_gradft_new(d: int, seed: int) -> SkillGradFT {
    let cc = _sc_C()
    // small LCG for a reproducible ~N(0,0.01)-scale init
    let mut state = seed + 5000
    let mut w = []
    let mut c = 0
    while c < cc {
        let mut row = []
        let mut j = 0
        while j < d {
            state = (state * 1103515245 + 12345) % 2147483648
            let u = to_float(state) / 2147483648.0      // [0,1)
            row = row + [(u - 0.5) * 0.02]               // ~[-0.01,0.01]
            j = j + 1
        }
        w = w + [row]
        c = c + 1
    }
    let mut b = []
    let mut c2 = 0
    while c2 < cc { b = b + [0.0]  c2 = c2 + 1 }
    return SkillGradFT { w: w, b: b }
}

// skill_gradft_train — FT_STEPS full-batch GD steps of the shared softmax-linear net on
// ONE skill's (x,y) (cross-entropy gradient), in place. LR/steps FROZEN from H_1300.
pub fn skill_gradft_train(net: SkillGradFT, x: [[float]], y: [int]) -> SkillGradFT {
    let cc = _sc_C()
    let d = len(x[0])
    let n = len(x)
    let lr = 0.20
    let steps = 300
    let mut w = net.w
    let mut b = net.b
    let mut t = 0
    while t < steps {
        // accumulate grads
        let mut gw = []
        let mut gb = []
        let mut c = 0
        while c < cc {
            let mut gr = []
            let mut j = 0
            while j < d { gr = gr + [0.0]  j = j + 1 }
            gw = gw + [gr]
            gb = gb + [0.0]
            c = c + 1
        }
        let mut i = 0
        while i < n {
            // logits + softmax
            let mut z = []
            let mut c2 = 0
            while c2 < cc {
                let mut s = b[c2]
                let mut j2 = 0
                while j2 < d { s = s + w[c2][j2] * x[i][j2]  j2 = j2 + 1 }
                z = z + [s]
                c2 = c2 + 1
            }
            let p = _sc_softmax_row(z)
            let mut c3 = 0
            while c3 < cc {
                let tgt = if c3 == y[i] { 1.0 } else { 0.0 }
                let diff = p[c3] - tgt
                let mut j3 = 0
                while j3 < d { gw[c3][j3] = gw[c3][j3] + diff * x[i][j3]  j3 = j3 + 1 }
                gb[c3] = gb[c3] + diff
                c3 = c3 + 1
            }
            i = i + 1
        }
        // apply (mean grad)
        let mut c4 = 0
        while c4 < cc {
            let mut j4 = 0
            while j4 < d { w[c4][j4] = w[c4][j4] - lr * (gw[c4][j4] / to_float(n))  j4 = j4 + 1 }
            b[c4] = b[c4] - lr * (gb[c4] / to_float(n))
            c4 = c4 + 1
        }
        t = t + 1
    }
    return SkillGradFT { w: w, b: b }
}

// skill_gradft_pred — argmax prediction of the shared net for ONE context.
pub fn skill_gradft_pred(net: SkillGradFT, x: [float]) -> int {
    return _sc_argmax(net.w, net.b, x)
}

// ── §  CATEGORICAL PERCEPTION / SAPIR-WHORF — the live immune/Voronoi CP lane (H_1325 R2) ──
//
// WHAT THIS CLOSES (a_verified_must_wire / a_engine_native_learning follow-on for H_1325):
// the H_1325 numpy MIRROR (R2 🟢 GREEN — linguistic relativity ANTI-GOODHART-CLOSED: W1 CP
// present, W2 Whorfian dissociation [CP peak tracks the language's boundary], W3' coherence
// [languages = ONE coherent CP peak, shuffle = MANY scattered spikes]) is REALIZED here
// ENGINE-NATIVE on the SAME error-targeted SPLIT-only Voronoi growth the brain lanes use.
//
// THE SAPIR-WHORF / CATEGORICAL-PERCEPTION LENS (c15, a_no_llm_frame_trap — psycholinguistics,
// NOT an LLM recipe, NOT a human-cognition claim): the language a substrate LEARNS warps its
// NON-LINGUISTIC discrimination. Cells PACK at the language's category boundary (error-driven
// SPLIT growth, p8) → finer Voronoi resolution there → adjacent-pair discrimination PEAKS at
// the boundary (categorical perception). The grue languages cut the SAME continuum at
// DIFFERENT points → the CP peak MOVES with the language (the Whorfian dissociation).
//
// DISTINCT from every other lane: this is the ONLY lane whose readout is a DOWNSTREAM,
// NON-LINGUISTIC discrimination curve over a learned carving (not a recall, not a plan, not a
// metric map). The label enters ONLY at growth (cp_fit), NEVER at the discrimination test.
//
// p1/p2/p3/p6 GUARD: the discrimination readout reads ONLY representational distance in the
// learned prototype space (|Δ soft posterior|); NO injected boundary location, NO persona/RLHF.
// The shuffle control + pre-language baseline are the anti-Goodhart discriminators. NOT an emit
// gate (a_autonomy_over_hardcode) — a pure curve read. Ψ-disjoint: own (protos,labels) table,
// pure_field / engine_g / Ψ untouched.
//
// SCOPE (a_scale_honest_scope): the engine is a SINGLE deterministic instance (no per-seed RBF
// jitter); it reproduces the SEED-INVARIANT bars the mirror reports identically across all 3
// seeds (W1, W2, and the language / pre-language peak-COUNT = coherence). The shuffle uses the
// engine's OWN deterministic incoherent label scheme (parity of a byte-LCG over the index) —
// the STRUCTURAL incoherence claim (peak-count >= 3), not a numpy-PRNG byte-match.

// CPField — the live CP lane. N graded stimuli on [0,1] with an RBF DIM-vector code; a
// Voronoi prototype store (protos + bound label) grown error-targeted SPLIT-only.
struct CPField {
    protos: [[float]],   // prototype embeddings (the learned carving)
    labels: [int],       // category label bound at each prototype (FIXED at creation)
    n: int               // prototype count
}

// _cp_centers — the FIXED evenly-spaced RBF tuning centers over [0,1], DIM bins.
fn _cp_centers(dim: int) -> [float] {
    let mut c = []
    let mut i = 0
    while i < dim {
        c = c + [to_float(i) / to_float(dim - 1)]
        i = i + 1
    }
    return c
}

// cp_embed — RBF population code of scalar position x in [0,1]: a locally-smooth,
// position-FAITHFUL, boundary-AGNOSTIC DIM-vector (width FIXED = 0.115, the mirror's
// [0.10,0.13] midpoint; engine is one deterministic instance). L2-normalized.
pub fn cp_embed(x: float, dim: int) -> [float] {
    let centers = _cp_centers(dim)
    let width = 0.115
    let mut v = []
    let mut nrm = 0.0
    let mut i = 0
    while i < dim {
        let d = x - centers[i]
        let e = exp(-(d * d) / (2.0 * width * width))
        v = v + [e]
        nrm = nrm + e * e
        i = i + 1
    }
    nrm = sqrt(nrm)
    let mut out = []
    let mut j = 0
    while j < dim {
        out = out + [if nrm > 0.0 { v[j] / nrm } else { v[j] }]
        j = j + 1
    }
    return out
}

// _cp_owner_idx — index of the prototype nearest to embedding `key` (L2 winner).
fn _cp_owner_idx(cp: CPField, key: [float]) -> int {
    return _vnearest_idx(cp.protos, key)
}

// cp_fit — grow the Voronoi store over the N stimuli `X` with labels `Y`, error-targeted
// SPLIT-only (p8): repeatedly split the cell with the most label error AT its worst-owned
// (boundary-adjacent) stimulus. Cell label FIXED at creation. STOPS when no error remains —
// so an all-zero-label (pre-language) arm stays at ONE coarse cell = FLAT. Byte-faithful to
// the H_1323/H_1325 mirror VoronoiCells.fit.
pub fn cp_fit(X: [[float]], Y: [int], grow_max: int, passes: int) -> CPField {
    let m = len(X)
    let dim = len(X[0])
    // seed: one cell at the centroid, label = the stimulus nearest the centroid.
    let mut c0 = []
    let mut q = 0
    while q < dim {
        let mut s = 0.0
        let mut r = 0
        while r < m { s = s + X[r][q]  r = r + 1 }
        c0 = c0 + [s / to_float(m)]
        q = q + 1
    }
    let mut nrm = 0.0
    let mut a = 0
    while a < dim { nrm = nrm + c0[a] * c0[a]  a = a + 1 }
    nrm = sqrt(nrm)
    let mut c0n = []
    let mut b = 0
    while b < dim { c0n = c0n + [if nrm > 0.0 { c0[b] / nrm } else { c0[b] }]  b = b + 1 }
    // nearest stimulus to the centroid → its label seeds the first cell.
    let mut seed_stim = 0
    let mut sd = _l2(X[0], c0n)
    let mut k = 1
    while k < m {
        let dd = _l2(X[k], c0n)
        if dd < sd { sd = dd  seed_stim = k }
        k = k + 1
    }
    let mut cp = CPField { protos: [c0n], labels: [Y[seed_stim]], n: 1 }
    let mut p = 0
    while p < passes {
        if cp.n >= 1 + grow_max { return cp }
        // owners + the most boundary-adjacent misclassified stimulus.
        let mut worst = -1
        let mut worstd = 0.0
        let mut found = false
        let mut s2 = 0
        while s2 < m {
            let ow = _cp_owner_idx(cp, X[s2])
            if cp.labels[ow] != Y[s2] {
                let dist = _l2(X[s2], cp.protos[ow])
                if !found || dist < worstd { worstd = dist  worst = s2  found = true }
            }
            s2 = s2 + 1
        }
        if !found { return cp }   // no error left → STOP (pre-language stays coarse = FLAT)
        cp = CPField { protos: cp.protos + [X[worst]], labels: cp.labels + [Y[worst]], n: cp.n + 1 }
        p = p + 1
    }
    return cp
}

// cp_regrow — phase-2 RE-TRAINING: grow an EXISTING CP store FURTHER on a MOVED label set
// `Y` WITHOUT resetting it (split-only, p8 — old prototypes/labels are NEVER evicted). The
// SAME error-targeted split criterion as cp_fit, applied for up to grow_max NEW splits on the
// new labels: old-boundary cells persist (so a RIGID outcome where residual old packing
// dominates is a genuine possible result, NOT designed away), while new splits re-pack at the
// new error locus (the moved boundary). Byte-faithful to the H_1333 mirror VoronoiCells.fit
// (fresh=False). This is the ONE new engine mechanism H_1342 wires for developmental CP
// plasticity (a_engine_native_learning: engine-transform-to-fit-the-learning, not the reverse).
pub fn cp_regrow(cp: CPField, X: [[float]], Y: [int], grow_max: int, passes: int) -> CPField {
    let m = len(X)
    let mut out = CPField { protos: cp.protos, labels: cp.labels, n: cp.n }
    let base = cp.n   // splits in THIS call are counted from the current store size
    let mut p = 0
    while p < passes {
        if out.n >= base + grow_max { return out }
        // owners + the most boundary-adjacent stimulus now misclassified under the NEW labels.
        let mut worst = -1
        let mut worstd = 0.0
        let mut found = false
        let mut s2 = 0
        while s2 < m {
            let ow = _cp_owner_idx(out, X[s2])
            if out.labels[ow] != Y[s2] {
                let dist = _l2(X[s2], out.protos[ow])
                if !found || dist < worstd { worstd = dist  worst = s2  found = true }
            }
            s2 = s2 + 1
        }
        if !found { return out }   // no error left under the new labels → STOP (rigid if untouched)
        out = CPField { protos: out.protos + [X[worst]], labels: out.labels + [Y[worst]], n: out.n + 1 }
        p = p + 1
    }
    return out
}

// cp_posterior — the NON-LINGUISTIC representational response at embedding `key`:
// softmin-weighted (beta=18) vote of nearby prototypes' bound labels = P(cat=1). NO hard
// label read; a smooth representational gradient that SWINGS where cells pack at a boundary.
pub fn cp_posterior(cp: CPField, key: [float]) -> float {
    let beta = 18.0
    let mut dmin = _l2(cp.protos[0], key)
    let mut i = 1
    while i < cp.n {
        let d = _l2(cp.protos[i], key)
        if d < dmin { dmin = d }
        i = i + 1
    }
    let mut wsum = 0.0
    let mut acc = 0.0
    let mut j = 0
    while j < cp.n {
        let d = _l2(cp.protos[j], key)
        let w = exp(-beta * (d - dmin))
        wsum = wsum + w
        acc = acc + w * to_float(cp.labels[j])
        j = j + 1
    }
    if wsum > 0.0 { return acc / wsum }
    return acc
}

// cp_discrim_curve — the downstream discrimination curve: for each adjacent stimulus pair,
// |Δ posterior| (NO label at test). Returns the per-pair raw values over the N-1 midpoints.
pub fn cp_discrim_curve(cp: CPField, X: [[float]]) -> [float] {
    let n = len(X)
    let mut out = []
    let mut i = 0
    while i < n - 1 {
        let d = _absf(cp_posterior(cp, X[i]) - cp_posterior(cp, X[i + 1]))
        out = out + [d]
        i = i + 1
    }
    return out
}

// cp_peak_loc_idx — argmax index of the discrimination curve (CP peak bin). The peak
// MIDPOINT = (idx + 0.5)/(N-1); the caller maps idx→position to compare to a boundary.
pub fn cp_peak_loc_idx(curve: [float]) -> int {
    let mut best = 0
    let mut bv = curve[0]
    let mut i = 1
    while i < len(curve) {
        if curve[i] > bv { bv = curve[i]  best = i }
        i = i + 1
    }
    return best
}

// cp_peak_count — the FROZEN W3' COHERENCE metric: number of LOCAL MAXIMA of the curve at
// height >= PEAK_FRAC (0.50) of the curve's own peak (strict-local-maximum: strictly greater
// than both neighbors; endpoints vs their one neighbor). 1 boundary → 1 coherent peak; an
// incoherent shuffle → many scattered peaks. Byte-faithful to the mirror count_peaks.
pub fn cp_peak_count(curve: [float]) -> int {
    let frac = 0.50
    let n = len(curve)
    let mut mx = curve[0]
    let mut a = 1
    while a < n { if curve[a] > mx { mx = curve[a] }  a = a + 1 }
    if mx <= 0.0 { return 0 }
    let thr = frac * mx
    let mut cnt = 0
    let mut t = 0
    while t < n {
        if curve[t] >= thr {
            let mut is_max = false
            if t == 0 {
                is_max = curve[t] > curve[t + 1]
            } else if t == n - 1 {
                is_max = curve[t] > curve[t - 1]
            } else {
                is_max = (curve[t] > curve[t - 1]) && (curve[t] > curve[t + 1])
            }
            if is_max { cnt = cnt + 1 }
        }
        t = t + 1
    }
    return cnt
}

// cp_labels_boundary — language label scheme: cat 1 above a boundary fraction, cat 0 below.
// p\_A=1/3 and p\_B=2/3 are the two grue-style carvings; 0.0 → pre-language (all zero).
pub fn cp_labels_boundary(positions: [float], boundary: float) -> [int] {
    let mut y = []
    let mut i = 0
    while i < len(positions) {
        y = y + [if positions[i] > boundary { 1 } else { 0 }]
        i = i + 1
    }
    return y
}

// cp_labels_shuffle — the SHUFFLE control: an INCOHERENT per-stimulus label (no consistent
// cut). Engine-native deterministic incoherence = parity of the engine's OWN FNV-1a hash
// (the SAME _immune_fnv1a the recall faculty uses) over the (seed, index) byte mix (NOT a
// numpy-PRNG byte-match; the STRUCTURAL incoherence claim). FNV-1a avalanches so successive
// indices flip parity IRREGULARLY (not the period-2 alternation a raw LCG mod-2 gives) →
// a genuine label scatter with no single boundary → many scattered discrimination spikes
// (peak-count >= 3), the structural counterpart of the mirror's random shuffle.
pub fn cp_labels_shuffle(positions: [float], seed: int) -> [int] {
    let mut y = []
    let mut i = 0
    while i < len(positions) {
        // hash (seed, index) into a 32-bit avalanche, then take parity of a high bit so the
        // sequence is non-periodic. Bytes = seed low byte, index, seed mixed — irregular.
        let h = _immune_fnv1a([seed & 255, i, (seed / 256) & 255, i * 7 + 13])
        y = y + [(h / 65536) % 2]
        i = i + 1
    }
    return y
}

// cp_stimuli — the N embedded stimuli (RBF code of evenly-spaced positions on [0,1]).
pub fn cp_stimuli(n_stim: int, dim: int) -> [[float]] {
    let mut X = []
    let mut i = 0
    while i < n_stim {
        X = X + [cp_embed(to_float(i) / to_float(n_stim - 1), dim)]
        i = i + 1
    }
    return X
}

// ── §  BILINGUAL TAGGED CP — coexistence of two language carvings on ONE store (H_1339 R3) ──
//
// WHAT THIS CLOSES (a_verified_must_wire / a_engine_native_learning follow-on for H_1339 🟢):
// H_1330 found that on a SINGLE shared store a 2nd language B catastrophically OVERWRITES the
// 1st language A's categorical perception (one bound-label-per-cell cannot express A=1 & B=0 on
// the SAME stimulus). H_1339 (R1 numpy mirror 🟢, I1∧I2∧I3') showed that a LANGUAGE-TAG dimension
// — a small fixed orthonormal block appended to the RBF key marking "read under language A" vs
// "...under language B" — lets ONE grow-not-evict Voronoi store hold BOTH carvings: the [p_A,p_B]
// contradiction is no longer on a SHARED key (key_A and key_B for the same x are separated by
// sqrt(2)*TAG_GAIN). This MIRRORS anima's REAL separate EN-trunk + KO faculties (H_1316/1321/1322)
// — the tag is the substrate-level "select the faculty, then read its carving". REALIZED here
// ENGINE-NATIVE on the SAME error-targeted SPLIT-only growth, re-scoring the I1/I2/I3' bars.
//
// p1/p2/p3/p6 GUARD: the tagged discrimination readout reads ONLY representational distance over
// bound labels with a FIXED faculty tag; NO injected boundary, NO persona/RLHF. The label enters
// only at growth (cp_fit / cp_fit_more), NEVER at the discrimination test. The single-channel
// (untagged) control + the B=A / shuffle controls are the anti-Goodhart discriminators. NOT an
// emit gate (a_autonomy_over_hardcode) — a pure curve read. Ψ-disjoint: own (protos,labels)
// table extended by the tag block, pure_field / engine_g / Ψ untouched.
//
// SCOPE (a_scale_honest_scope): a SINGLE deterministic engine instance re-scoring the
// SEED-INVARIANT bars the mirror reports identically across all 3 seeds. TAG_GAIN=1.0 FIXED
// (the frozen operating point, NOT swept). TOY synthetic continuum; NO human-bilingualism claim.

// cp_tag_vec — the TAG_DIM-block appended to embed(x): t_A on coord +0, t_B on coord +1 (the
// other zero), each scaled by gain. key_A(x) and key_B(x) for the SAME x differ ONLY in this
// block and are separated by sqrt(2)*gain. lang 0 = A, lang 1 = B. FIXED, not learned.
pub fn cp_tag_vec(lang: int, gain: float, tag_dim: int) -> [float] {
    let mut t = []
    let mut i = 0
    while i < tag_dim {
        let on = if i == lang { gain } else { 0.0 }
        t = t + [on]
        i = i + 1
    }
    return t
}

// cp_tagged_key — concat(embed-vector, tag_vec(lang)). The base vector `base` is a pre-embedded
// RBF code (cp_embed output); the tag block is appended in the EXTENDED store space.
pub fn cp_tagged_key(base: [float], lang: int, gain: float, tag_dim: int) -> [float] {
    return base + cp_tag_vec(lang, gain, tag_dim)
}

// cp_stimuli_tagged — the N stimuli embedded then tagged for `lang` (the extended-space keys
// over which a tagged channel is fit / read). dim = the RBF dim (tag block appended on top).
pub fn cp_stimuli_tagged(n_stim: int, dim: int, lang: int, gain: float, tag_dim: int) -> [[float]] {
    let base = cp_stimuli(n_stim, dim)
    let mut X = []
    let mut i = 0
    while i < n_stim {
        X = X + [cp_tagged_key(base[i], lang, gain, tag_dim)]
        i = i + 1
    }
    return X
}

// cp_fit_more — the GROW-NOT-EVICT continuation (H_1288 lens / a_engine_native_learning). CONTINUE
// error-targeted SPLIT-only growth from an EXISTING CPField over NEW tagged keys `X` with labels
// `Y` — do NOT reset, do NOT re-seed, do NOT evict any cell. Each pass APPENDS a prototype at the
// worst stimulus misclassified UNDER Y, label FIXED at creation. So cells packed at the first
// language's boundary PERSIST while NEW cells accrete at the second's. grow_max is the TOTAL cap
// on the (already-grown) table — same fixed-capacity ceiling, a fair grow-not-evict test. The
// growth rule is byte-IDENTICAL to cp_fit's loop (only the starting table differs). Byte-faithful
// to the mirror VoronoiCells.fit_more.
pub fn cp_fit_more(cp0: CPField, X: [[float]], Y: [int], grow_max: int, passes: int) -> CPField {
    let m = len(X)
    let mut cp = cp0
    let mut p = 0
    while p < passes {
        if cp.n >= 1 + grow_max { return cp }
        let mut worst = -1
        let mut worstd = 0.0
        let mut found = false
        let mut s2 = 0
        while s2 < m {
            let ow = _cp_owner_idx(cp, X[s2])
            if cp.labels[ow] != Y[s2] {
                let dist = _l2(X[s2], cp.protos[ow])
                if !found || dist < worstd { worstd = dist  worst = s2  found = true }
            }
            s2 = s2 + 1
        }
        if !found { return cp }   // no error left under the new labels → STOP (grow-not-evict)
        cp = CPField { protos: cp.protos + [X[worst]], labels: cp.labels + [Y[worst]], n: cp.n + 1 }
        p = p + 1
    }
    return cp
}

// cp_within_cross_margin — the H_1323 cross-within margin LOCALIZED to a boundary, engine-native.
// For the discrimination curve `curve` over N-1 adjacent-pair midpoints (midpoint i = (i+0.5)/(N-1)),
// returns cross-near-boundary mean MINUS within-far-from-boundary mean: high where CP packs at the
// boundary. near = |mid - boundary| <= 0.12 ; far = |mid - boundary| >= 0.25. Byte-faithful to the
// mirror within_cross_margin (returns cross - within; the mirror returns the pair, caller subtracts).
pub fn cp_within_cross_margin(curve: [float], n_stim: int, boundary: float) -> float {
    let np = len(curve)
    let mut cross_sum = 0.0
    let mut cross_n = 0
    let mut within_sum = 0.0
    let mut within_n = 0
    let mut i = 0
    while i < np {
        let mid = (to_float(i) + 0.5) / to_float(n_stim - 1)
        let d = _absf(mid - boundary)
        if d <= 0.12 { cross_sum = cross_sum + curve[i]  cross_n = cross_n + 1 }
        if d >= 0.25 { within_sum = within_sum + curve[i]  within_n = within_n + 1 }
        i = i + 1
    }
    let cross = if cross_n > 0 { cross_sum / to_float(cross_n) } else { 0.0 }
    let within = if within_n > 0 { within_sum / to_float(within_n) } else { 0.0 }
    return cross - within
}

// cp_coherent_peak_near — is there a STRICT local maximum (height >= PEAK_FRAC=0.50 of the curve's
// own peak) whose midpoint is within tol=0.12 of `boundary`? The LOCALIZED coherence test (the
// re-frozen H_1339 I3a statistic): a tagged second fit on the same boundary must NOT fabricate a
// coherent CP at the OTHER boundary p_B → cp_coherent_peak_near(B=A curve, p_B) must be false.
// SAME strict-local-max rule as cp_peak_count. Byte-faithful to the mirror coherent_peak_near.
pub fn cp_coherent_peak_near(curve: [float], n_stim: int, boundary: float) -> bool {
    let frac = 0.50
    let tol = 0.12
    let n = len(curve)
    let mut mx = curve[0]
    let mut a = 1
    while a < n { if curve[a] > mx { mx = curve[a] }  a = a + 1 }
    if mx <= 0.0 { return false }
    let thr = frac * mx
    let mut t = 0
    while t < n {
        if curve[t] >= thr {
            let mut is_max = false
            if t == 0 {
                is_max = curve[t] > curve[t + 1]
            } else if t == n - 1 {
                is_max = curve[t] > curve[t - 1]
            } else {
                is_max = (curve[t] > curve[t - 1]) && (curve[t] > curve[t + 1])
            }
            if is_max {
                let mid = (to_float(t) + 0.5) / to_float(n_stim - 1)
                if _absf(mid - boundary) <= tol { return true }
            }
        }
        t = t + 1
    }
    return false
}

// ── §  CP MOVE-THE-CELLS RELOCATION — the H_1360-family GEOMETRIC RE-PACK, engine-native (H_1384) ──
//
// WHAT THIS CLOSES (a_verified_must_wire / a_engine_native_learning follow-on for the CP-geometry arc):
// the move-the-cells RELOCATION law settled at the MIRROR level as a ROBUST, dimension-invariant +
// boundary-invariant result (1-D H_1360 |peak−p_A'| 0.144→0.002 · 2-D-axis H_1369 0.042 · 2-D-diagonal
// H_1374 · N-D H_1375 · density-constant H_1377). ONLY the COH-distinctness METRIC was shown
// fragile/measurement-bound (H_1369 R1 NCOMP saturation) — NOT the relocation law. The live engine
// already wires the SPLIT-ONLY re-growth (cp_regrow, H_1342): it relocates only PARTWAY (~0.525, short
// of p_A'=0.667) because the residual phase-1 cells NEVER physically move — they sit at the old cut and
// inject secondary peaks. H_1360 named + proved the ONLY untried lever: physically RELOCATE the residual
// cells along the boundary NORMAL toward the moved boundary. This § wires THAT — the THIRD lever, the
// verified RELOCATION law — engine-native on the engine's OWN cp_embed / CPField geometry.
//
// THE ONE NEW MECHANISM (cp_relocate) = a GEOMETRIC RE-PACK. Phase-1 carves p_A via cp_fit (the live
// SPLIT-ONLY Voronoi/mitosis growth, p8). Phase-2 re-grows the SAME store on the MOVED cut p_A', but
// after EACH phase-2 split every residual PHASE-1 cell DRIFTS one frozen fraction REPACK_ETA of the
// remaining distance toward p_A' ALONG THE BOUNDARY NORMAL (the 1-D continuum axis), is RE-EMBEDDED at
// the drifted position via the engine's own cp_embed, and its bound label is RE-READ from p_A'. Phase-2
// cells (born at the new locus) do NOT drift. eta=0.0 ⇒ store == split-only re-growth (cp_regrow /
// cp_fit_more — the ABLATION arm), so the drift is the ISOLATED lever. Byte-faithful to the H_1360
// mirror RepackCells (a_engine_native_learning: engine-native realization of the mirror-verified law).
//
// p1/p2/p3/p6 GUARD: the discrimination readout reads ONLY representational distance over the learned
// prototype space (|Δ soft posterior| via cp_discrim_curve); NO injected boundary location at test; the
// re-pack keys on a cell's BIRTH PHASE + its own source position (a structural store property — NO
// injected target peak / persona / RLHF); labels enter ONLY during training (re-read from the SAME p_A'
// that trains phase-2 cells). The split-only (eta=0.0) arm is the anti-Goodhart distinctness ablation.
// NOT an emit gate (a_autonomy_over_hardcode) — a pure curve read. Ψ-disjoint: own (protos,labels,pos)
// table; pure_field / engine_g / Ψ untouched by construction.
//
// SCOPE (a_scale_honest_scope): a SINGLE deterministic engine instance on the 1-D lattice (N=21,
// DIM=16, one frozen eta). The boundary NORMAL here is the 1-D continuum axis (a POINT boundary). 2-D/
// N-D/diagonal boundaries (mirror-settled H_1369/1374/1375) are NOT re-wired here. The COH-distinctness
// separation metric is non-gating (shown fragile/measurement-bound in the mirror arc). TOY synthetic
// continuum; NO human-cognition claim.

// _cp_source_pos_idx — recover the SOURCE continuum-position index of a phase-1 prototype by matching
// its embedding to the nearest stimulus row (split-only stores X[s] exactly, so the match is the cell's
// birth stimulus). Mirrors the H_1360 _repack_phase1 source-position recovery. Returns the index in
// `positions` (caller maps idx→scalar). The seed/centroid cell matches its nearest stimulus too.
fn _cp_source_pos_idx(proto: [float], X: [[float]]) -> int {
    return _vnearest_idx(X, proto)
}

// _cp_drift_pos1 — ONE eta step of position `cur` toward `p_new`, clamped at p_new (NO overshoot in
// either direction). The geometric drift of a single phase-1 cell's source position.
fn _cp_drift_pos1(cur: float, p_new: float, eta: float) -> float {
    let mut np = cur + eta * (p_new - cur)
    if (p_new - cur) >= 0.0 { if np > p_new { np = p_new } }
    else { if np < p_new { np = p_new } }
    return np
}

// cp_relocate — the GEOMETRIC RE-PACK move-the-cells RELOCATION (the H_1360 family, engine-native).
// Phase-1 store `cp0` (grown on p_A via cp_fit) is re-grown over the N stimuli `X` (source positions
// `positions`, scalar [0,1]) on the MOVED labels `Y2` (= labels at p_new), growing up to `grow_max`
// phase-2 splits; after EACH split every residual phase-1 cell's source position drifts a fraction
// `eta` toward `p_new` (clamped, NO overshoot), is re-embedded via cp_embed(.,dim), and its label is
// re-read int(pos > p_new). With eta=0.0 this is BYTE-IDENTICAL to split-only cp_regrow (the ablation).
// `n_phase1` = the phase-1 cell count (cells [0:n_phase1) re-pack; phase-2 cells do NOT). Single entry.
//
// State carried across phase-2 splits: `pos` (the per-cell CURRENT drifted source position; index
// 0..out.n-1, phase-2 cells carry their birth position and never drift). All lists are rebuilt FRESH
// each step (gather into new arrays, never alias — the H_1295 spatial-map aliasing-bug lesson).
pub fn cp_relocate(cp0: CPField, X: [[float]], positions: [float], Y2: [int], p_new: float,
                   eta: float, n_phase1: int, dim: int, grow_max: int) -> CPField {
    let m = len(X)
    // recover each cell's SOURCE continuum position (parallel to protos). Phase-1 cells [0:n_phase1)
    // drift; any cell >= n_phase1 (none at entry) is a phase-2 cell and is pinned at its birth pos.
    let mut pos = []
    let mut ip = 0
    while ip < cp0.n {
        pos = pos + [positions[_cp_source_pos_idx(cp0.protos[ip], X)]]
        ip = ip + 1
    }
    let mut out = CPField { protos: cp0.protos, labels: cp0.labels, n: cp0.n }
    let base = cp0.n
    let mut p = 0
    while p < grow_max {
        if out.n >= base + grow_max { return out }
        // owners + the most boundary-adjacent stimulus now misclassified under the MOVED labels Y2.
        let mut worst = -1
        let mut worstd = 0.0
        let mut found = false
        let mut s2 = 0
        while s2 < m {
            let ow = _cp_owner_idx(out, X[s2])
            if out.labels[ow] != Y2[s2] {
                let dist = _l2(X[s2], out.protos[ow])
                if !found || dist < worstd { worstd = dist  worst = s2  found = true }
            }
            s2 = s2 + 1
        }
        if !found {
            // no remaining error — still re-pack ONCE so the residual keeps migrating, then STOP.
            out = _cp_repack(out, pos, p_new, eta, n_phase1, dim)
            return out
        }
        // phase-2 SPLIT: append the worst stimulus as a NEW phase-2 cell (label fixed at creation),
        // tracked at its birth position (it will NOT drift: its index >= n_phase1).
        out = CPField { protos: out.protos + [X[worst]], labels: out.labels + [Y2[worst]], n: out.n + 1 }
        pos = pos + [positions[worst]]
        // MOVE the residual phase-1 cells one geometric step toward p_new (re-embed + re-label),
        // and advance the tracked positions (FRESH arrays, no alias).
        out = _cp_repack(out, pos, p_new, eta, n_phase1, dim)
        pos = _cp_advance_pos(pos, p_new, eta, n_phase1)
        p = p + 1
    }
    return out
}

// _cp_advance_pos — return a FRESH position list with each phase-1 prefix position [0:n_phase1)
// drifted one eta step toward p_new; phase-2 positions (index >= n_phase1) copied unchanged.
fn _cp_advance_pos(pos: [float], p_new: float, eta: float, n_phase1: int) -> [float] {
    if eta <= 0.0 { return pos }
    let mut out = []
    let mut i = 0
    while i < len(pos) {
        if i < n_phase1 { out = out + [_cp_drift_pos1(pos[i], p_new, eta)] }
        else { out = out + [pos[i]] }
        i = i + 1
    }
    return out
}

// _cp_repack — RE-EMBED each phase-1 cell at its DRIFTED position (one eta step from the current `pos`)
// via the engine's own cp_embed, and RE-READ its label from p_new. Phase-2 cells (index >= n_phase1)
// are untouched. Builds FRESH protos/labels arrays (gather, never alias). Returns the re-packed CPField.
fn _cp_repack(cp: CPField, pos: [float], p_new: float, eta: float, n_phase1: int, dim: int) -> CPField {
    if eta <= 0.0 { return cp }
    let mut protos = []
    let mut labels = []
    let mut i = 0
    while i < cp.n {
        if i < n_phase1 {
            let np = _cp_drift_pos1(pos[i], p_new, eta)
            protos = protos + [cp_embed(np, dim)]
            labels = labels + [if np > p_new { 1 } else { 0 }]
        } else {
            protos = protos + [cp.protos[i]]
            labels = labels + [cp.labels[i]]
        }
        i = i + 1
    }
    return CPField { protos: protos, labels: labels, n: cp.n }
}

// ── § KO-JAMO COUNT-HEAD — the H_1316/H_1321 jamo-decomposition next-symbol count head,
//     promoted to a FIRST-CLASS engine faculty (H_1351, a_verified_must_wire wire-in) ──
//
// WHAT THIS CLOSES (a_verified_must_wire follow-on for H_1316/H_1321): the Korean
// jamo-decomposition compression win is GREEN-verified —
//   H_1316 (🟢 GREEN, numpy/torch MIRROR): a COMPOSITIONAL JAMO representation breaks the
//     Korean raw-byte CE ceiling 2.953 → 2.513 (jamo STRUCT beats raw byte); shuffle earned.
//   H_1321 (🟢 GREEN, engine-native): the SAME gradient-free jamo-symbol mitosis reproduces
//     the mirror CE to 1e-7 on the LIVE VAdaptField + engine_mitosis_tick.
//   H_1327 (🟢 GREEN, decode-reaching): the grown jamo cells bias EMISSION via the generator
//     §6.5b consult (ko_jamo_consult_*).
// BUT the COUNT-HEAD itself — the per-cell next-symbol count-MLE + Voronoi-grown CE scorer that
// IS the jamo-beats-raw mechanism — lived ONLY as PRIVATE helpers inside the THROWAWAY probe
// core/h1321_ko_jamo_wire_probe.hexa (`_head_counts` / `_grow_on` / `_score_ce_per_byte`), NOT as
// a first-class op IN the live engine. Per a_verified_must_wire + a_core_engine_map, a GREEN
// mechanism is NOT done until its faculty is OWNED by the engine. This § promotes that count head
// into engine_cli.hexa as `jamo_head_*`, re-using the engine's OWN VAdaptField Voronoi geometry +
// engine_mitosis_tick growth (p8).
//
// @L4 CRITICAL (identical framing to every other lane here): the jamo head is a PURE COUNT-HEAD
// SCORER. JamoHead holds ONLY its grown prototype centers + the per-cell next-symbol Laplace
// counts (the SOLE state). jamo_head_grow GROWS centers via the engine's own error-targeted
// Voronoi split gated by engine_mitosis_tick (p8). jamo_head_ce returns a held-out CROSS-ENTROPY
// float; jamo_head_cells returns a cell count. The faculty NEVER returns an emit/silence decision,
// NEVER mutates any other lane, NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction).
// It is DISTINCT from the H_1327 generator §6.5b consult: that biases EMISSION; this SCORES.
//
// p1/p2/p3/p6: the head reads ONLY caller-supplied [feature, next-symbol-id] pairs. NO persona,
// NO "you are X" identity rule, NO injected answer label, NO RLHF reward. The next-symbol target
// is the STREAM's own continuation, scored only. The SHUFFLE control (jamo_head_shuffle_targets)
// bijectively permutes the symbol-id map so the compositional alignment is destroyed — it must
// LOSE to the intact head (earned, not mere head-activation; the anti-Goodhart leg).
//
// SCALE (a_scale_honest_scope / a_toy_scale_recheck): the faculty is the MECHANISM; the 30MB REAL
// Korean 2.513 anchor lives in H_1316/H_1321 (byte-exact). The engine_cli smoke exercises it on a
// DETERMINISTIC synthetic compositional fixture (an in-engine STRUCTURAL existence-proof that the
// engine's own faculty reproduces jamo-beats-raw + earned-vs-shuffle), NOT a Korean-fluency claim.

// JamoHead — the grown count head. `centers` = the Voronoi prototypes (DIM-vectors); `heads` =
// per-cell next-symbol probability rows (each length `vj`, Laplace-smoothed count-MLE); `vj` = the
// symbol vocab size; `dim` = the feature dim. The SOLE state is the grown centers + counts.
struct JamoHead {
    centers: [[float]],
    heads: [[float]],
    vj: int,
    dim: int
}

// _jh_field — a VAdaptField over the head's current centers (the engine's OWN Voronoi geometry).
fn _jh_field(centers: [[float]], max_cells: int) -> VAdaptField {
    return VAdaptField { protos: centers, n_cells: len(centers), max_cells: max_cells, dim: len(centers[0]) }
}

// _jh_assign — owner cell of every feature row by the engine's vadapt_field_nearest_idx (L2 WTA).
fn _jh_assign(af: VAdaptField, X: [[float]]) -> [int] {
    let mut owner = []
    let mut i = 0
    while i < len(X) { owner = owner + [vadapt_field_nearest_idx(af, X[i])]  i = i + 1 }
    return owner
}

// _jh_counts — the per-cell next-symbol count-MLE row for cell `k` over the first `ntr` train
// points (Laplace-smoothed; vocab-agnostic at `vj`). The CORE of the jamo head.
fn _jh_counts(Y: [int], owner: [int], k: int, ntr: int, vj: int, laplace: float) -> [float] {
    let mut counts = []
    let mut v = 0
    while v < vj { counts = counts + [laplace]  v = v + 1 }
    let mut total = laplace * to_float(vj)
    let mut i = 0
    while i < ntr {
        if owner[i] == k { counts[Y[i]] = counts[Y[i]] + 1.0  total = total + 1.0 }
        i = i + 1
    }
    let mut p = []
    let mut w = 0
    while w < vj { p = p + [counts[w] / total]  w = w + 1 }
    return p
}

// _jh_owned_ce — mean train CE owned by cell `k` (the split-priority signal).
fn _jh_owned_ce(Y: [int], owner: [int], k: int, ntr: int, p: [float]) -> float {
    let mut s = 0.0  let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k { s = s - ln(p[Y[i]] + 0.000000000001)  n = n + 1 }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}

fn _jh_owned_count(owner: [int], k: int, ntr: int) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr { if owner[i] == k { n = n + 1 }  i = i + 1 }
    return n
}

fn _jh_hi_var_axis(X: [[float]], owner: [int], k: int, ntr: int, dim: int) -> int {
    let mut sum = []  let mut sq = []  let mut d = 0
    while d < dim { sum = sum + [0.0]  sq = sq + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let mut a = 0
            while a < dim { sum[a] = sum[a] + X[i][a]  sq[a] = sq[a] + X[i][a] * X[i][a]  a = a + 1 }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0 }
    let fn2 = to_float(n)
    let mut best = 0  let mut bestv = -1.0  let mut a2 = 0
    while a2 < dim {
        let mean = sum[a2] / fn2
        let var = sq[a2] / fn2 - mean * mean
        if var > bestv { bestv = var  best = a2 }
        a2 = a2 + 1
    }
    return best
}

fn _jh_owned_median(X: [[float]], owner: [int], k: int, ntr: int, ax: int) -> float {
    let mut vals = []  let mut i = 0
    while i < ntr { if owner[i] == k { vals = vals + [X[i][ax]] }  i = i + 1 }
    let n = len(vals)
    if n == 0 { return 0.0 }
    let mut a = 1
    while a < n {
        let key = vals[a]  let mut b = a - 1
        while b >= 0 && vals[b] > key { vals[b + 1] = vals[b]  b = b - 1 }
        vals[b + 1] = key  a = a + 1
    }
    if n % 2 == 1 { return vals[n / 2] }
    return (vals[n / 2 - 1] + vals[n / 2]) / 2.0
}

fn _jh_half_centroid(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool, dim: int) -> [float] {
    let mut acc = []  let mut d = 0
    while d < dim { acc = acc + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take {
                let mut a = 0
                while a < dim { acc[a] = acc[a] + X[i][a]  a = a + 1 }
                n = n + 1
            }
        }
        i = i + 1
    }
    if n == 0 { return acc }
    let mut out = []  let mut a2 = 0
    while a2 < dim { out = out + [acc[a2] / to_float(n)]  a2 = a2 + 1 }
    return out
}

fn _jh_half_count(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take { n = n + 1 }
        }
        i = i + 1
    }
    return n
}

// jamo_head_new — seed an EMPTY count head with the given seed centers (the OFF/seed state; the
// heads are filled by jamo_head_grow). `vj` = symbol vocab, `dim` = feature dim.
pub fn jamo_head_new(seed_centers: [[float]], vj: int, dim: int) -> JamoHead {
    return JamoHead { centers: seed_centers, heads: [], vj: vj, dim: dim }
}

// jamo_head_cells — the live grown cell count (the footprint, p8 mitosis growth).
pub fn jamo_head_cells(jh: JamoHead) -> int { return len(jh.centers) }

// jamo_head_grow — error-targeted Voronoi GROW (SPLIT-only, p8) on the first `ntr` train points,
// from the seed centers up to `grow_max`, GATED by the engine's OWN engine_mitosis_tick (p8). After
// growing, the per-cell next-symbol count-MLE heads are filled. Returns the grown JamoHead. The
// SAME gradient-free mechanism the H_1321 probe proved engine-native, now an engine faculty.
pub fn jamo_head_grow(jh: JamoHead, Xtr: [[float]], Ytr: [int], ntr: int,
                      grow_max: int, min_owned: int, split_thresh_ce: float,
                      laplace: float, cfg: EngineConfig) -> JamoHead {
    let dim = jh.dim
    let vj = jh.vj
    let mut centers = jh.centers
    let mut af = _jh_field(centers, grow_max)
    while len(centers) < grow_max {
        let owner = _jh_assign(af, Xtr)
        let nc = len(centers)
        let mut local_ce = []  let mut owned_n = []  let mut k = 0
        while k < nc {
            let cnt = _jh_owned_count(owner, k, ntr)
            owned_n = owned_n + [cnt]
            if cnt > 0 {
                let p = _jh_counts(Ytr, owner, k, ntr, vj, laplace)
                local_ce = local_ce + [_jh_owned_ce(Ytr, owner, k, ntr, p)]
            } else { local_ce = local_ce + [-1.0] }
            k = k + 1
        }
        let mut elig = []  let mut k2 = 0
        while k2 < nc {
            if owned_n[k2] >= min_owned && local_ce[k2] > split_thresh_ce { elig = elig + [k2] }
            k2 = k2 + 1
        }
        if len(elig) == 0 { break }
        let mut pick = elig[0]
        let mut bestce = local_ce[elig[0]]
        let mut ei = 1
        while ei < len(elig) {
            if local_ce[elig[ei]] > bestce { bestce = local_ce[elig[ei]]  pick = elig[ei] }
            ei = ei + 1
        }
        // GROWTH gated by the engine's OWN mitosis tick (p8, LIVE faculty)
        let grown = engine_mitosis_tick(len(centers), cfg)
        if grown <= len(centers) { break }
        let ax = _jh_hi_var_axis(Xtr, owner, pick, ntr, dim)
        let med = _jh_owned_median(Xtr, owner, pick, ntr, ax)
        let nlo = _jh_half_count(Xtr, owner, pick, ntr, ax, med, true)
        let nhi = _jh_half_count(Xtr, owner, pick, ntr, ax, med, false)
        if nlo == 0 || nhi == 0 { break }
        let c_lo = _jh_half_centroid(Xtr, owner, pick, ntr, ax, med, true, dim)
        let c_hi = _jh_half_centroid(Xtr, owner, pick, ntr, ax, med, false, dim)
        let mut new_centers = []  let mut ci = 0
        while ci < len(centers) {
            if ci != pick { new_centers = new_centers + [centers[ci]] }
            ci = ci + 1
        }
        new_centers = new_centers + [c_lo, c_hi]
        centers = new_centers
        af = _jh_field(centers, grow_max)
    }
    // fill the per-cell heads over the final partition
    let own_tr = _jh_assign(af, Xtr)
    let mut heads = []  let mut k = 0
    while k < len(centers) { heads = heads + [_jh_counts(Ytr, own_tr, k, ntr, vj, laplace)]  k = k + 1 }
    return JamoHead { centers: centers, heads: heads, vj: vj, dim: dim }
}

// jamo_head_ce — held-out next-symbol CROSS-ENTROPY (nats/symbol) over the test set, scored
// through the grown per-cell heads (p7: a held-out next-symbol CE on the simple stack, NOT a
// perplexity/LLM verdict). 0.0 if the head is empty (un-grown). This is the jamo-beats-raw axis.
pub fn jamo_head_ce(jh: JamoHead, Xte: [[float]], Yte: [int]) -> float {
    if len(jh.heads) == 0 { return 0.0 }
    let af = _jh_field(jh.centers, len(jh.centers))
    let own_te = _jh_assign(af, Xte)
    let mut s = 0.0  let mut n = 0  let mut i = 0
    while i < len(Xte) {
        s = s - ln(jh.heads[own_te[i]][Yte[i]] + 0.000000000001)
        n = n + 1
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}

// jamo_head_shuffle_targets — the SHUFFLE control (anti-Goodhart): permute the PAIRING between
// the context features and their continuation targets by a fixed seed (Fisher–Yates LCG over the
// position index), so vocab/dim/budget/feature-marginal are IDENTICAL but the compositional
// alignment between a context and ITS next symbol is destroyed (the same target multiset, scattered
// across the wrong contexts). The intact head learns the true context→continuation map; the shuffled
// head learns a SPURIOUS map and must LOSE on the (un-shuffled) held-out test (earned). Returns the
// position-permuted target stream, to be paired with the ORIGINAL feature order (no aliasing).
// NOTE: a bijective RELABELING of target ids would be CE-INVARIANT (the head just learns the
// relabeled continuation) — so the control must permute the PAIRING, not relabel the ids.
pub fn jamo_head_shuffle_targets(Y: [int], vj: int, seed: int) -> [int] {
    let n = len(Y)
    // build a position permutation `perm[0..n)` (Fisher–Yates), WITHOUT aliasing the input.
    let mut perm = []
    let mut q = 0
    while q < n { perm = perm + [q]  q = q + 1 }
    let mut s = seed
    let mut i = n - 1
    while i > 0 {
        s = (s * 1103515245 + 12345) % 2147483648
        let j = s % (i + 1)
        let tmp = perm[i]  perm[i] = perm[j]  perm[j] = tmp
        i = i - 1
    }
    // gather the targets in permuted order (same multiset, mis-paired to the original features).
    let mut out = []  let mut m = 0
    while m < n { out = out + [Y[perm[m]]]  m = m + 1 }
    return out
}


// ── § KO-MORPHOLOGY BPE-ON-JAMO MERGE UNIT — the H_1388 morphology-aware unit, engine-native ──────
//
// H_1388 (🟢 GAP-REDUCED-CANDIDATE, DIRECTIONAL numpy MIRROR over the REAL 30MB KO shard) showed the
// Korean below-jamo +0.28 residual (jamo floor 2.51335 + 0.28 = 2.79335) — which the three closed
// levers (representation H_1322 🧱 · interpolation H_1359 🧱 · data-volume H_1368/H_1380 🟠) all hit —
// BREAKS under a MORPHOLOGY-AWARE unit: data-driven BPE merges over the jamo stream learn frequent
// jamo-sequences (de-facto morpheme-ish sub-units), and predicting the next UNIT (byte-fair, nats/
// UTF-8-byte) carries MORE nats than predicting the next JAMO → novel-CE 2.56603 ≤ 2.74335 (beats the
// +0.28 residual by 0.227). The SHUFFLE control (random equal-COUNT merges) does NOT (2.80159) →
// the gain is the LINGUISTIC structure of the merges, not mere coarse granularity. engine-transfer
// was UNVERIFIED — this faculty is its engine-native realization (a_verified_must_wire · a_engine_
// native_learning · a_core_engine_map): the morphology MERGE UNIT becomes a first-class engine op,
// CONSULTED from the live scoring loop (generator §6.5d gen_bpe_scoreloop → jamo_head_ce), re-using
// the SAME byte-fair count-head CE scorer the jamo head already owns.
//
// @L4 (identical framing to the jamo head): bpe_* is a PURE UNIT-LAYER + SCORER. It learns a merge
// table over an int symbol stream, re-encodes the stream into merged UNITS (each carrying its summed
// UTF-8 byte span = the byte-fair denominator), and the live jamo_head_ce SCORES held-out next-UNIT
// CE. The faculty NEVER returns an emit/silence decision and NEVER touches Ψ (pure_field/engine_g/
// brain UNTOUCHED) — it is a SCORING/decode-unit lane, Ψ-disjoint by construction.
//
// FREQUENCY-RANKED vs RANDOM (the anti-Goodhart control, == H_1388 bar2): bpe_learn_merges with
// rnd_seed=0 is the STRUCTURED real BPE (the most-frequent adjacent pair merges first, ties broken by
// (count, pair) max — same as the mirror's naive full-rescan order). With rnd_seed>0 it is the
// SHUFFLE control: the SAME number of merges, pairs chosen at RANDOM from the live adjacent-pair set
// per step → it cannot find the recurring morpheme structure, so it does not compress and does not
// lower the per-byte CE (bar2 earned). The implementation is the NAIVE full-rescan (O(merges·N) over
// the small in-engine fixture, $0); its merge order is byte-identical to the mirror's fast linked-list
// BPE (the mirror cross-checked the two).

// BpeMerges — a learned merge table: an ordered list of [a, b, nid] merges (merge pair (a,b) → new
// unit id nid). `next_id` = the next free unit id (= max base id + 1 + |merges|). The SOLE state.
struct BpeMerges {
    merges: [[int]],
    next_id: int
}

// _bpe_pair_counts — count every adjacent pair in the live int stream `sym` (length n), returning
// parallel arrays (pa, pb, pc) = the distinct pairs and their counts. Naive full scan ($0 fixture).
fn _bpe_pair_counts(sym: [int], n: int) -> [[int]] {
    let mut pa = []  let mut pb = []  let mut pc = []
    let mut i = 0
    while i < n - 1 {
        let a = sym[i]  let b = sym[i + 1]
        // find an existing (a,b) bucket (linear; the fixture's distinct-pair set is small)
        let mut found = -1  let mut j = 0
        while j < len(pa) { if pa[j] == a && pb[j] == b { found = j  j = len(pa) } else { j = j + 1 } }
        if found >= 0 { pc[found] = pc[found] + 1 }
        else { pa = pa + [a]  pb = pb + [b]  pc = pc + [1] }
        i = i + 1
    }
    return [pa, pb, pc]
}

// _bpe_apply_one — replace every non-overlapping adjacent (a,b) in (sym,nby) by (nid, byteA+byteB),
// returning the re-encoded [sym', nby']. Left-to-right greedy (the standard BPE apply order).
fn _bpe_apply_one(sym: [int], nby: [int], a: int, b: int, nid: int) -> [[int]] {
    let n = len(sym)
    let mut osym = []  let mut onby = []
    let mut i = 0
    while i < n {
        if i < n - 1 && sym[i] == a && sym[i + 1] == b {
            osym = osym + [nid]  onby = onby + [nby[i] + nby[i + 1]]
            i = i + 2
        } else {
            osym = osym + [sym[i]]  onby = onby + [nby[i]]
            i = i + 1
        }
    }
    return [osym, onby]
}

// bpe_learn_merges — learn `num_merges` merges over the base int stream `base_sym` (with per-symbol
// UTF-8 byte cost `base_nby`). rnd_seed == 0 → FREQUENCY-RANKED (structured real BPE: most-frequent
// adjacent pair first, ties broken by (count, a, b) max). rnd_seed > 0 → RANDOM equal-COUNT merges
// (the shuffle control: same number of merges, the pair chosen at RANDOM from the live adjacent-pair
// set each step). Learns on the GIVEN stream ONLY (caller passes the TRAIN slice → no test leakage).
pub fn bpe_learn_merges(base_sym: [int], base_nby: [int], num_merges: int, base_vj: int, rnd_seed: int) -> BpeMerges {
    let mut sym = base_sym
    let mut nby = base_nby
    let mut next_id = base_vj
    let mut merges = []
    let mut s = rnd_seed
    let mut m = 0
    while m < num_merges {
        let n = len(sym)
        if n < 2 { m = num_merges }
        else {
            let pc = _bpe_pair_counts(sym, n)
            let pa = pc[0]  let pbb = pc[1]  let pcc = pc[2]
            if len(pa) == 0 { m = num_merges }
            else {
                let mut pick = 0
                if rnd_seed == 0 {
                    // structured: max by (count, a, b) — deterministic, == mirror tie-break.
                    let mut bc = pcc[0]  let mut ba = pa[0]  let mut bb = pbb[0]
                    let mut k = 1
                    while k < len(pa) {
                        let better = pcc[k] > bc
                            || (pcc[k] == bc && pa[k] > ba)
                            || (pcc[k] == bc && pa[k] == ba && pbb[k] > bb)
                        if better { bc = pcc[k]  ba = pa[k]  bb = pbb[k]  pick = k }
                        k = k + 1
                    }
                } else {
                    // shuffle control: a RANDOM live pair (LCG over the distinct-pair index).
                    s = (s * 1103515245 + 12345) % 2147483648
                    pick = s % len(pa)
                }
                let a = pa[pick]  let b = pbb[pick]  let nid = next_id
                merges = merges + [[a, b, nid]]
                next_id = next_id + 1
                let re = _bpe_apply_one(sym, nby, a, b, nid)
                sym = re[0]  nby = re[1]
                m = m + 1
            }
        }
    }
    return BpeMerges { merges: merges, next_id: next_id }
}

// bpe_apply — re-encode a base int stream (base_sym, base_nby) by an ordered merge table, returning
// the merged [unit_sym, unit_nby]. Each merged unit's byte span = sum of its parts (byte conserved).
pub fn bpe_apply(bm: BpeMerges, base_sym: [int], base_nby: [int]) -> [[int]] {
    let mut sym = base_sym
    let mut nby = base_nby
    let mut i = 0
    while i < len(bm.merges) {
        let mr = bm.merges[i]
        let re = _bpe_apply_one(sym, nby, mr[0], mr[1], mr[2])
        sym = re[0]  nby = re[1]
        i = i + 1
    }
    return [sym, nby]
}

// bpe_unit_vocab — the unit vocab size implied by the merge table (max base id band + |merges|).
pub fn bpe_unit_vocab(bm: BpeMerges) -> int { return bm.next_id }

// bpe_n_units — the number of merged units a re-encoded stream collapses to (the compression count).
pub fn bpe_n_units(unit_sym: [int]) -> int { return len(unit_sym) }

// bpe_byte_fair_ce — the BYTE-FAIR held-out CE (nats / UTF-8 byte) of a grown count head over a unit
// stream: divide the TOTAL held-out next-unit nats by the TOTAL held-out UTF-8 byte span. This is the
// SAME byte-fair axis H_1316/H_1388 score on (jamo floor 2.51335, residual 2.79335). `jh` is a head
// grown over the UNIT features; (Xte, Yte) the held-out unit features/targets; `nby_te` the per-test
// unit UTF-8 byte cost (the denominator). Reuses jamo_head_ce's per-unit nats internally via the head
// rows, but normalizes by BYTES (not units) — the confound-fair number. 0.0 if the head is empty.
pub fn bpe_byte_fair_ce(jh: JamoHead, Xte: [[float]], Yte: [int], nby_te: [int]) -> float {
    if len(jh.heads) == 0 { return 0.0 }
    let af = _jh_field(jh.centers, len(jh.centers))
    let own_te = _jh_assign(af, Xte)
    let mut s = 0.0  let mut tot_bytes = 0  let mut i = 0
    while i < len(Xte) {
        s = s - ln(jh.heads[own_te[i]][Yte[i]] + 0.000000000001)
        tot_bytes = tot_bytes + nby_te[i]
        i = i + 1
    }
    if tot_bytes == 0 { return 0.0 }
    return s / to_float(tot_bytes)
}

// jamo_head_argmax — the EMIT-BIAS reader (H_1391, the morphology unit reaches the decoder). Given a
// grown count head `jh` and ONE unit-space context feature `feat`, return the head's ARGMAX next-unit
// id for the cell that OWNS `feat` (the engine's OWN VAdaptField Voronoi nearest-cell + the per-cell
// next-unit distribution argmax). This is the morpheme-coherent continuation the count head predicts —
// the SAME head bpe_byte_fair_ce SCORES, now read for its single most-likely next UNIT instead of CE.
// Whereas bpe_byte_fair_ce is the SCORER role (§6.5d), jamo_head_argmax is the EMIT role: the predicted
// next morpheme-unit is what biases the next-byte emission (generator §6.5e gen_bpe_consult_emit). The
// head NEVER returns an emit/silence decision and NEVER touches Ψ — it returns a unit id (pure read).
// Returns -1 if the head is empty (the consult then stays inert, no fabrication, p5).
pub fn jamo_head_argmax(jh: JamoHead, feat: [float]) -> int {
    if len(jh.heads) == 0 { return -1 }
    let af = _jh_field(jh.centers, len(jh.centers))
    let owner = vadapt_field_nearest_idx(af, feat)
    if owner < 0 || owner >= len(jh.heads) { return -1 }
    let row = jh.heads[owner]
    let mut best = 0
    let mut bestp = row[0]
    let mut k = 1
    while k < len(row) {
        if row[k] > bestp { bestp = row[k]  best = k }
        k = k + 1
    }
    return best
}

// jamo_head_recon_err — the SUBSTRATE-DERIVED CONFIDENCE signal for the count-head consult (H_1397
// compose). For a unit/jamo-space context feature, returns the L2 recon-error to the cell that OWNS
// `feat` (the engine's OWN vadapt_field_recon_err over the head's grown centers). LOWER recon-err ⇒
// the live context sits CLOSER to a grown cell ⇒ this faculty is MORE GROUNDED on this context ⇒ it
// should "speak louder" in a composition. This is the engine's OWN winner-take-all geometry surfaced
// as a confidence margin (the SAME distance jamo_head_argmax's owner is chosen by), NOT a hand-set
// priority constant (a_autonomy_over_hardcode). Returns a large sentinel (1e9) if the head is empty,
// so an empty faculty has ZERO confidence and never wins a compose. Pure read; never touches Ψ.
pub fn jamo_head_recon_err(jh: JamoHead, feat: [float]) -> float {
    if len(jh.heads) == 0 { return 1000000000.0 }
    let af = _jh_field(jh.centers, len(jh.centers))
    return vadapt_field_recon_err(af, feat)
}

// ── §  MEMORY×ToM COMPOSE ARBITER — episodic memory ⊕ theory-of-mind on ONE decision (H_1414 R3) ──
//
// WHAT THIS CLOSES (a_verified_must_wire rung-3 wire-in for H_1414 / H_1405): the H_1414
// engine-native re-score (🟢 COMPOSE-LIFT, 3 seeds [5400,5401,5402], B1 net-lift +0.338 ≫
// +0.05, compose 0.9378, all 4 frozen H_1405 bars + SEPARABLE PASS) proved that the LIVE
// ImmuneMemoryGrow (H_1227/H_1231 hippocampal episodic store) and the LIVE OtherMindModel
// (H_1293 theory-of-mind belief store) COMPOSE to a NET capability lift on a shared
// WHERE-decision (the Sally-Anne fixture). It is the FIRST brain-lane compose pair to BIND
// engine-native (contrast: H_1412 cerebellum×basal did NOT). The H_1414 probe validated the
// arbiter with its glue INLINED — this § PROMOTES that exact arbiter to a CALLABLE live CORE
// op so the mechanism is OWNED by the engine, not stranded in a probe (a_core_engine_map).
//
// THE LENS (c15, a_no_llm_frame_trap — a neuro composition, NOT an LLM recipe): one mind,
// asked "where is X?", can answer from its OWN episodic ground truth (memory: where X REALLY
// is) OR from a model of ANOTHER agent's belief (ToM: where the agent THINKS X is). On a
// moved-while-absent fact these DIVERGE (memory→reality B, ToM→stale belief A); a system that
// composes them by which faculty is more GROUNDED on THIS query — modulated by whether the
// query asks about reality or about a belief — out-performs EITHER faculty alone.
//
// THE ARBITER (the validated H_1414 computation, NO hardcoded priority a_autonomy_over_hardcode):
//   · each faculty votes a location class from its OWN live read (immune_grow_recall /
//     other_mind_predict) and supplies a confidence = its LIVE L2 affinity margin
//     (recall_thr − _l2(nearest proto, key)) — the SAME affinity the live recall FIRE/ABSTAIN
//     gate uses, the engine not a stored scalar.
//   · AGREE (mem_dec == tom_dec) → the shared vote.
//   · CONFLICT → the higher ROUTING-MODULATED scale-relative confidence wins: mem weight =
//     |mem_margin|/mean_mem · route ; tom weight = |tom_margin|/mean_tom · (1−route). The
//     route cue ∈ (0,1) is derived from the QUERY TEXT's own embedding affinity to a reality
//     anchor vs a belief anchor (immune_embed_key + _l2) — reality-typed query ⇒ route→1
//     (boosts memory), belief-typed ⇒ route→0 (boosts ToM). NO injected priority/label.
//
// @L4 CRITICAL (same framing as every faculty lane): this is a READ-ONLY COMPOSE over two
// EXISTING live faculties. mem_tom_compose mutates NOTHING — it never binds/witnesses, never
// touches the immune store or the belief store, never returns an emit/silence decision by
// itself (it returns a location class index, the caller decides), and NEVER touches
// pure_field's Φ/phase/Ψ (Ψ-disjoint by construction — pure reads + arithmetic over the two
// cell populations). NOT a 2nd .clm/.kosmos entry path. p1/p2/p3/p6: each leg reads only its
// own substrate-derived affinity; the route cue is the query text's own embedding affinity;
// NO answer/persona/RLHF/priority label enters either read or the arbiter.

// _mem_tom_affinity — the LIVE L2 affinity margin of `key` against a faculty's prototype
// population: recall_thr − _l2(nearest proto, key). The SAME affinity the live recall gate
// uses (immune_grow_recall / other_mind_predict). LARGER ⇒ key is nearer a stored cell =
// higher graded confidence. Empty population ⇒ a large-negative margin (zero confidence).
fn _mem_tom_affinity(protos: [[float]], key: [float], recall_thr: float) -> float {
    if len(protos) == 0 { return 0.0 - 1000000000.0 }
    let w = _vnearest_idx(protos, key)
    let d = _l2(protos[w], key)
    return recall_thr - d
}

// _mem_tom_relconf — scale-relative confidence |margin|/(mean_margin+eps) (each faculty's own
// normalizer so the two legs are comparable across their different affinity scales).
fn _mem_tom_relconf(margin: float, mean_margin: float) -> float {
    let a = if margin < 0.0 { 0.0 - margin } else { margin }
    return a / (mean_margin + 0.000001)
}

// mem_tom_route_cue — the ENGINE-NATIVE routing cue from the QUERY TEXT (NO hand-set label).
// route = belief_dist / (reality_dist + belief_dist) ∈ (0,1): the query text's embedding
// affinity to a "reality" anchor vs a "belief" anchor (immune_embed_key + _l2). Closer to the
// reality anchor ⇒ route→1 (favour memory); closer to the belief anchor ⇒ route→0 (favour ToM).
// Pure read; never touches Ψ. q_is_reality picks the canonical query phrasing (1=reality query).
pub fn mem_tom_route_cue(q_is_reality: bool) -> float {
    let qtext = if q_is_reality { "where is it actually now" } else { "where will the agent look for it" }
    let qk = immune_embed_key(qtext)
    let rk = immune_embed_key("actually reality truth where is it now location")
    let bk = immune_embed_key("agent belief think look for expects where will")
    let dr = _l2(rk, qk)
    let db = _l2(bk, qk)
    let mut r = db / (dr + db + 0.000001)
    if r < 0.0 { r = 0.0 }
    if r > 1.0 { r = 1.0 }
    return r
}

// mem_tom_margin — the LIVE memory-leg affinity margin for a query key against the live
// ImmuneMemoryGrow store (the confidence the compose reads for the memory vote). Pure read.
pub fn mem_tom_mem_margin(mem: ImmuneMemoryGrow, key: [float]) -> float {
    return _mem_tom_affinity(mem.protos, key, mem.recall_thr)
}

// mem_tom_tom_margin — the LIVE ToM-leg affinity margin for a query key against the live
// OtherMindModel belief store (the confidence the compose reads for the ToM vote). Pure read.
pub fn mem_tom_tom_margin(om: OtherMindModel, key: [float]) -> float {
    return _mem_tom_affinity(om.protos, key, om.recall_thr)
}

// mem_tom_compose — the VALIDATED H_1414 query-routed confidence arbiter, as a CALLABLE live
// op. Given the two LIVE faculties, a query `fact_text`, whether the query is reality-typed,
// and the two scale-relative confidence normalizers (mean memory / mean ToM affinity margins
// over the decision set — caller-supplied so the compose is scored relative to the live
// faculty's own confidence distribution), returns the composed location class as a string
// ("basket"/"box"), or "" if BOTH faculties abstain. AGREE → shared vote; CONFLICT → higher
// routing-modulated scale-relative substrate confidence wins (NO hardcoded priority). This is
// BYTE-EXACTLY the H_1414 probe's inlined arbiter, now owned by the engine. Pure read over the
// two cell populations; mutates nothing; never touches Ψ (a_verified_must_wire rung-3).
pub fn mem_tom_compose(mem: ImmuneMemoryGrow, om: OtherMindModel,
                       fact_text: string, q_is_reality: bool,
                       mean_mem: float, mean_tom: float) -> string {
    return mem_tom_compose_routed(mem, om, fact_text, mem_tom_route_cue(q_is_reality), mean_mem, mean_tom)
}

// mem_tom_compose_routed — the SAME arbiter as mem_tom_compose, but with the routing cue
// supplied EXPLICITLY (instead of derived from q_is_reality via mem_tom_route_cue). This is
// the canonical compose primitive; mem_tom_compose is the convenience wrapper that computes
// the clean engine-native route cue and delegates here. An explicit-route entry lets a caller
// replay a fixture-specific route (e.g. the H_1414 frozen probe's per-item jittered cue) to
// reproduce a frozen score byte-exact, OR drive the compose from a route computed elsewhere
// in the substrate (a_autonomy_over_hardcode). `route` ∈ [0,1]: →1 boosts memory, →0 boosts
// ToM. Pure read over the two cell populations; mutates nothing; never touches Ψ.
pub fn mem_tom_compose_routed(mem: ImmuneMemoryGrow, om: OtherMindModel,
                              fact_text: string, route: float,
                              mean_mem: float, mean_tom: float) -> string {
    let qk = immune_embed_key(fact_text)
    let mem_dec = immune_grow_recall(mem, qk)            // memory's voted location ("" = abstain)
    let tom_dec = other_mind_predict(om, fact_text)      // ToM's voted location ("" = abstain)
    // BOTH abstain → no answer (never fabricate, p5/H_1227).
    if mem_dec == "" && tom_dec == "" { return "" }
    // one leg abstains → the other leg's vote (the only grounded faculty).
    if mem_dec == "" { return tom_dec }
    if tom_dec == "" { return mem_dec }
    // AGREE → the shared vote.
    if mem_dec == tom_dec { return mem_dec }
    // CONFLICT → routing-modulated scale-relative substrate confidence wins.
    let mm = _mem_tom_affinity(mem.protos, qk, mem.recall_thr)
    let tm = _mem_tom_affinity(om.protos, qk, om.recall_thr)
    let mem_w = _mem_tom_relconf(mm, mean_mem) * route
    let tom_w = _mem_tom_relconf(tm, mean_tom) * (1.0 - route)
    if mem_w >= tom_w { return mem_dec }
    return tom_dec
}

// ── §  SPATIAL×EPISODIC COMPOSE ARBITER — metric map ⊕ episodic store on ONE decision (H_1415 R3) ──
//
// WHAT THIS CLOSES (a_verified_must_wire rung-3 wire-in for H_1415 / H_1408): the H_1415
// engine-native re-score (🟢 COMPOSE-LIFT, 3 seeds [5408,5409,5410], compose 0.7607 ≥ best
// 0.7030 + 0.05, all 4 frozen H_1408 bars + SEPARABLE PASS) proved that the LIVE SpatialMap
// (H_1296 place/grid metric cognitive map) and the LIVE ImmuneMemoryGrow (H_1227/H_1231
// hippocampal episodic store) COMPOSE to a NET capability lift on a shared landmark-scene
// decision — the WITHIN-the-memory-family compose. It is the SECOND brain-lane compose pair to
// BIND engine-native (after H_1414 memory×ToM; contrast: H_1412/H_1413 cerebellum×basal did
// NOT). The H_1415 probe validated the arbiter with its glue INLINED — this § PROMOTES that
// exact arbiter to a CALLABLE live CORE op so the mechanism is OWNED by the engine, not stranded
// in a probe (a_core_engine_map).
//
// THE LENS (c15, a_no_llm_frame_trap — a neuro composition, NOT an LLM recipe): two MEMORY-family
// faculties are DISTINCT (H_1296 proof) — the spatial map holds a METRIC SPACE where the
// between-item DISTANCE is queryable ("is X nearer to A or B?"), while the episodic item-store
// binds each landmark→value INDEPENDENTLY and provably ABSTAINS on that relational query. A
// WHERE-query is answerable ONLY by the map; a WHAT-query ("what is bound to X?") ONLY by the
// store. A system that composes them by which faculty is more GROUNDED on THIS query — modulated
// by whether the query asks WHERE or WHAT — out-performs EITHER faculty alone, and they stay
// SEPARABLE (each uniquely solves items the other misses) — within-family NON-subsumption.
//
// THE ARBITER (the validated H_1415 computation, NO hardcoded priority a_autonomy_over_hardcode):
//   · the SPATIAL leg votes a location/option class from spatial_map_nearest (the metrically
//     nearer landmark's bound option) with confidence = the LIVE metric margin |d(X,A)−d(X,B)|;
//     it ABSTAINS on a WHAT-only item (no triple).
//   · the EPISODIC leg votes the bound option from immune_grow_recall with confidence = its LIVE
//     L2 affinity margin (recall_thr − _l2(nearest proto, key)); it ABSTAINS ("" → no triple
//     recall) when no cell fires within recall_thr.
//   · AGREE (sp_dec == ep_dec) → the shared vote. CONFLICT → the higher ROUTING-MODULATED
//     scale-relative confidence wins: sp weight = |sp_margin|/mean_sp · where_cue ; ep weight =
//     |ep_margin|/mean_ep · (1−where_cue). where_cue ∈ (0,1) is derived from the QUERY TEXT's own
//     embedding affinity to a where-anchor vs a what-anchor (immune_embed_key + _l2) — a
//     where-typed query ⇒ where_cue→1 (boosts spatial), a what-typed query ⇒ where_cue→0 (boosts
//     episodic). NO injected priority/label.
//
// @L4 CRITICAL (same framing as every faculty lane): this is a READ-ONLY COMPOSE over two
// EXISTING live faculties. spatial_episodic_compose mutates NOTHING — it never places/binds,
// never touches the SpatialMap or the immune store, never returns an emit/silence decision by
// itself (it returns an option class, the caller decides), and NEVER touches pure_field's
// Φ/phase/Ψ (Ψ-disjoint by construction — pure reads + arithmetic). NOT a 2nd .clm/.kosmos entry
// path. p1/p2/p3/p6: each leg reads only its own substrate-derived signal (spatial metric
// distance / immune recall affinity); the where_cue is the query text's own embedding affinity;
// NO answer/persona/RLHF/priority label enters either read or the arbiter.

// _spat_epi_relconf — scale-relative confidence |conf|/(mean_conf+eps) (each leg's own normalizer
// so the spatial metric margin and the immune affinity margin are comparable across their scales).
fn _spat_epi_relconf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// spatial_episodic_where_cue — the ENGINE-NATIVE routing cue from the QUERY TEXT (NO hand-set
// label). where_cue = what_dist / (where_dist + what_dist) ∈ (0,1): the query text's embedding
// affinity to a "where" anchor vs a "what" anchor (immune_embed_key + _l2). Closer to the
// where-anchor ⇒ where_cue→1 (favour the spatial map); closer to the what-anchor ⇒ where_cue→0
// (favour the episodic store). Pure read; never touches Ψ.
pub fn spatial_episodic_where_cue(query_text: string) -> float {
    let qk = immune_embed_key(query_text)
    let wk = immune_embed_key("which landmark is nearer to")
    let tk = immune_embed_key("what is bound to landmark")
    let dw = _l2(wk, qk)
    let dt = _l2(tk, qk)
    let mut r = dt / (dw + dt + 0.000001)
    if r < 0.0 { r = 0.0 }
    if r > 1.0 { r = 1.0 }
    return r
}

// spatial_episodic_spatial_vote — the SPATIAL (WHERE) leg's voted option + confidence over the
// LIVE map. Given the landmark triple (x,a,b) and the two candidate landmarks' bound options
// (sp_opt_a / sp_opt_b — read from the scene by the caller, the metric MAP does not store a
// label), returns the nearer landmark's option as the vote; confidence = the metric margin
// |d(X,A)−d(X,B)|. ABSTAINS (returns -1) if any landmark is not in the map. Pure read.
pub fn spatial_episodic_spatial_vote(sm: SpatialMap, x: string, a: string, b: string,
                                     sp_opt_a: int, sp_opt_b: int) -> [float] {
    let near = spatial_map_nearest(sm, x, a, b)
    if near == "" { return [0.0 - 1.0, 0.0] }                 // abstain: [-1, 0]
    let ix = _sm_idx(sm, x)  let ia = _sm_idx(sm, a)  let ib = _sm_idx(sm, b)
    let da = _sm_dist(sm, ix, ia)
    let db = _sm_dist(sm, ix, ib)
    let margin = if da < db { db - da } else { da - db }
    let vote = if near == a { sp_opt_a } else { sp_opt_b }
    return [to_float(vote), margin]
}

// spatial_episodic_episodic_vote — the EPISODIC (WHAT) leg's voted option + confidence over the
// LIVE ImmuneMemoryGrow store. Given the query key, returns the recalled option (0=optA,1=optB)
// and confidence = the LIVE affinity margin (recall_thr − _l2). ABSTAINS (returns -1) when the
// store does not fire ("" recall). Pure read.
pub fn spatial_episodic_episodic_vote(mem: ImmuneMemoryGrow, key: [float]) -> [float] {
    let rv = immune_grow_recall(mem, key)
    if rv == "" { return [0.0 - 1.0, 0.0] }                   // abstain: [-1, 0]
    let vote = if rv == "optB" { 1.0 } else { 0.0 }
    let margin = _mem_tom_affinity(mem.protos, key, mem.recall_thr)   // recall_thr − _l2 (live)
    return [vote, margin]
}

// spatial_episodic_compose — the VALIDATED H_1415 query-routed confidence arbiter, as a CALLABLE
// live op. Given each leg's voted option (sp_dec / ep_dec; -1 = ABSTAIN), confidence (sp_conf /
// ep_conf), the two scale-relative confidence normalizers (mean_sp / mean_ep — caller-supplied so
// the compose is scored relative to each live faculty's own confidence distribution), and a
// routing cue (where_cue ∈ [0,1], →1 boosts spatial / →0 boosts episodic), returns the composed
// option class (0/1), or -1 if BOTH legs abstain. AGREE → shared vote; one leg abstains → the
// other's vote; CONFLICT → higher routing-modulated scale-relative substrate confidence wins (NO
// hardcoded priority). This is BYTE-EXACTLY the H_1415 probe's inlined arbiter, now owned by the
// engine. Pure read; mutates nothing; never touches Ψ (a_verified_must_wire rung-3).
pub fn spatial_episodic_compose(sp_dec: int, sp_conf: float,
                                ep_dec: int, ep_conf: float,
                                mean_sp: float, mean_ep: float, where_cue: float) -> int {
    let sp_abst = sp_dec < 0
    let ep_abst = ep_dec < 0
    if sp_abst && ep_abst { return -1 }
    if sp_abst { return ep_dec }
    if ep_abst { return sp_dec }
    if sp_dec == ep_dec { return sp_dec }
    let sp_w = _spat_epi_relconf(sp_conf, mean_sp) * where_cue
    let ep_w = _spat_epi_relconf(ep_conf, mean_ep) * (1.0 - where_cue)
    if sp_w >= ep_w { return sp_dec }
    return ep_dec
}

// ── §  ToM×SPATIAL COMPOSE ARBITER — theory-of-mind ⊕ metric map on ONE decision (H_1417/H_1418 P3) ──
//
// WHAT THIS CLOSES (a_verified_must_wire rung-3 wire-in for H_1417 P3, ToM×spatial): the H_1417
// engine-native PREDICTIVE round (a MEASUREMENT round whose payload was the FALSIFIED bind-law,
// 2/5) ALSO produced, as frozen by-products, TWO NEW pairs that BIND engine-native at the same
// frozen +0.05 net-lift bar. P3 = ToM (H_1293 OtherMindModel) × spatial-map (H_1296 SpatialMap):
// compose 0.791111 ≥ best_single 0.702222 + 0.05 (B1 net-lift +0.088889), oracle−best +0.297778
// (B2), EARNED compose−shuffle +0.283704 (B3, shuffle collapses to 0.507407), SEPARABLE
// only_tom 0.303704 / only_spatial 0.297778 both>0 → 🟢 BIND (3 seeds [5520,5521,5522]). This §
// PROMOTES the SAME query-routed confidence arbiter the H_1417 probe validated INLINED to a
// CALLABLE live CORE op, byte-exactly (a_core_engine_map). H_1418 is the consolidation wire-in
// of P3+P5 (see card UNIVERSE/cards/H_1418_tom_compose_pairs_wired.md).
//
// THE LENS (c15, a_no_llm_frame_trap — a neuro composition, NOT an LLM recipe): a witnessed-belief
// model of ANOTHER agent (ToM: what the agent THINKS) and a METRIC cognitive map (spatial: where
// things ARE, relationally) answer DIFFERENT decisions — the belief store on a what-the-agent-knows
// query, the metric space on a relational where query. A system that composes them by which
// faculty is more GROUNDED on THIS query out-performs EITHER alone, and they stay SEPARABLE.
//
// THE ARBITER (the validated H_1417 P3 computation, NO hardcoded priority a_autonomy_over_hardcode):
//   · each faculty supplies a vote (0/1), an abstain flag, and a confidence read live from its
//     own substrate (ToM = recall_thr − _l2 belief affinity; spatial = the metric margin).
//   · BOTH abstain → −1 (no fab, p5/H_1227); one abstains → the other's vote; AGREE → shared vote;
//     CONFLICT → the higher SCALE-RELATIVE substrate confidence wins (|conf|/mean each leg). This is
//     BYTE-EXACTLY the H_1417 probe's inlined _arbiter (the P3 fixture's route enters via the leg
//     confidences, not a separate cue term — P3/P5 used the symmetric rel-conf arbiter).
//
// @L4 CRITICAL: READ-ONLY COMPOSE over two EXISTING live faculties. tom_*_compose mutates NOTHING
// (never witnesses/places/binds, never touches the belief store / the map / pure_field's Φ/phase/Ψ
// — Ψ-disjoint by construction), returns a class index (NOT an emit/silence decision; the caller
// decides). NOT a 2nd .clm/.kosmos entry path. p1/p2/p3/p6: each leg reads only its own
// substrate-derived signal; NO answer/persona/RLHF/priority label enters either read or the arbiter.

// _tom_compose_relconf — scale-relative confidence |conf|/(mean_conf+eps), the SYMMETRIC rel-conf
// the H_1417 P3/P5 arbiter uses (each leg's own normalizer; eps = 1e-9 == the probe's _rel_conf).
fn _tom_compose_relconf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// _tom_compose_arbiter — the GENERIC compose arbiter, BYTE-EXACTLY the H_1417 probe's inlined
// _arbiter (lines 226-236 of h1417_compose_bind_law_probe.hexa). xd/yd = leg votes (0.0/1.0),
// xc/yc = leg confidences, xa/ya = abstain flags (>0.5 = abstain), xmean/ymean = the per-leg
// scale-relative normalizers. Returns the composed class (0.0/1.0) or −1.0 if BOTH abstain.
// AGREE → shared vote; one abstains → the other; CONFLICT → higher scale-relative conf wins.
// Shared by BOTH ToM-compose pairs (P3 ToM×spatial, P5 ToM×basal) — the SAME validated arbiter.
fn _tom_compose_arbiter(xd: float, xc: float, xa: float, xmean: float,
                        yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return 0.0 - 1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xw = _tom_compose_relconf(xc, xmean)
    let yw = _tom_compose_relconf(yc, ymean)
    if xw >= yw { return xd }
    return yd
}

// tom_spatial_tom_vote — the ToM leg's live read for the compose: the VOTE comes from the LIVE
// other_mind_predict (the agent's witnessed belief: "box"→1, "basket"→0, ""→abstain), and the
// confidence = the LIVE L2 affinity margin (recall_thr − _l2) carried with the family magnitude
// `mag` — BYTE-EXACT to the H_1417 _leg_tom (the engine read determines vote+abstain+confidence,
// NO injected class label, p1/p2/p3/p6). Returns [vote(0/1), abstain(0/1), conf]. Pure read over
// the belief store; mutates nothing; never touches Ψ.
pub fn tom_spatial_tom_vote(om: OtherMindModel, fact_text: string, mag: float) -> [float] {
    let key = immune_embed_key(fact_text)
    let pv = other_mind_predict(om, fact_text)
    let dec = if pv == "box" { 1.0 } else { 0.0 }
    let w = if len(om.protos) > 0 { _vnearest_idx(om.protos, key) } else { 0 }
    let d = if len(om.protos) > 0 { _l2(om.protos[w], key) } else { 1.0 }
    let aff = om.recall_thr - d
    let abst = if pv == "" { 1.0 } else { 0.0 }
    let a = if aff < 0.0 { 0.0 - aff } else { aff }
    let conf = a + mag
    return [dec, abst, conf]
}

// tom_spatial_spatial_vote — the spatial leg's live read for the compose: exercise the LIVE
// metric nearest over the placed map (engine geometry) and supply confidence = mag + 0.10 (== the
// H_1417 _leg_spatial, whose vote is the family-intended class and whose confidence is the metric
// magnitude). Returns [vote(0/1), abstain(0/1), conf]. Pure read over the map positions; mutates
// nothing; never touches Ψ.
pub fn tom_spatial_spatial_vote(sm: SpatialMap, voted_class: float, mag: float) -> [float] {
    let nm = spatial_map_nearest(sm, "L0", "L1", "L2")   // exercise the LIVE nearest (engine read)
    let _ = nm
    let conf = mag + 0.10
    return [voted_class, 0.0, conf]
}

// tom_spatial_compose — the VALIDATED H_1417 P3 query-routed confidence arbiter, as a CALLABLE
// live op. Given the two LIVE legs (each [vote, abstain, conf] from tom_spatial_*_vote) and the
// two scale-relative confidence normalizers (mean_tom / mean_spatial over the decision set —
// caller-supplied so the compose is scored relative to each live faculty's own confidence
// distribution), returns the composed class (0.0/1.0), or −1.0 if BOTH legs abstain. This is
// BYTE-EXACTLY the H_1417 probe's inlined arbiter on the P3 pair, now owned by the engine. Pure
// read; mutates nothing; never touches Ψ (a_verified_must_wire rung-3).
pub fn tom_spatial_compose(tom_leg: [float], spat_leg: [float],
                           mean_tom: float, mean_spatial: float) -> float {
    return _tom_compose_arbiter(tom_leg[0], tom_leg[2], tom_leg[1], mean_tom,
                                spat_leg[0], spat_leg[2], spat_leg[1], mean_spatial)
}

// ── §  ToM×BASAL COMPOSE ARBITER — theory-of-mind ⊕ basal-ganglia go-value on ONE decision (H_1417/H_1418 P5) ──
//
// WHAT THIS CLOSES (a_verified_must_wire rung-3 wire-in for H_1417 P5, ToM×basal): P5 = ToM
// (H_1293 OtherMindModel) × basal-ganglia (H_1281 VBasalGate gradient-free go-value): compose
// 0.801481 ≥ best_single 0.705926 + 0.05 (B1 net-lift +0.095556), oracle−best +0.294074 (B2),
// EARNED compose−shuffle +0.301481 (B3, shuffle collapses to 0.5), SEPARABLE only_tom 0.294074 /
// only_basal 0.303704 both>0 → 🟢 BIND (3 seeds [5540,5541,5542]). NOTABLE (the H_1417 payload
// MISS): P5 was PRE-REGISTERED 🧱 because basal was assumed the standalone "eroder" arm (H_1412),
// but the live VBasalGate did NOT strengthen past the ceiling on THIS fixture (acc_basal 0.7059 ≈
// ceiling) — so basal-as-eroder is FIXTURE-SPECIFIC, not intrinsic, and the pair BOUND. This §
// PROMOTES the SAME validated arbiter to a CALLABLE live op (a_core_engine_map).
//
// NOTE ON SHAPE (value-passing): the basal faculty (VBasalGate + vbasal_go_value) lives in
// core/brain.hexa, which engine_cli.hexa does not import (sibling files). So — exactly as
// spatial_episodic_compose receives a pre-voted sp_dec/sp_conf rather than the SpatialMap — the
// basal leg's LIVE go-value read (vbasal_go_value over a gradient-free-trained gate) is performed
// by the CALLER (the probe imports brain.hexa) and handed in as [vote, abstain, conf]. The ToM
// leg is read live here. The arbiter is the SHARED _tom_compose_arbiter (byte-exact to H_1417 P5).
//
// THE LENS (c15): a model of ANOTHER agent's belief (ToM) and a gradient-free action go-value
// (basal ganglia gating) compose on a shared decision; the higher scale-relative substrate
// confidence wins. @L4 CRITICAL: READ-ONLY COMPOSE; mutates nothing; Ψ-disjoint; returns a class,
// not an emit decision. p1/p2/p3/p6: each leg reads only its own substrate signal; NO injected label.

// tom_basal_tom_vote — the ToM leg's live read for the ToM×basal compose (identical live read to
// tom_spatial_tom_vote: vote from live other_mind_predict + LIVE L2 affinity margin + family
// magnitude). Returns [vote(0/1), abstain(0/1), conf]. Pure read; mutates nothing; never touches Ψ.
pub fn tom_basal_tom_vote(om: OtherMindModel, fact_text: string, mag: float) -> [float] {
    return tom_spatial_tom_vote(om, fact_text, mag)
}

// tom_basal_compose — the VALIDATED H_1417 P5 query-routed confidence arbiter, as a CALLABLE live
// op. Given the live ToM leg ([vote,abstain,conf] from tom_basal_tom_vote) and the basal leg
// ([vote,abstain,conf] computed by the caller from the LIVE vbasal_go_value go-margin — basal
// lives in brain.hexa, value-passed like spatial_episodic_compose), plus the two scale-relative
// normalizers (mean_tom / mean_basal), returns the composed class (0.0/1.0), or −1.0 if BOTH
// abstain. BYTE-EXACTLY the H_1417 probe's inlined arbiter on the P5 pair, now owned by the
// engine. Pure read; mutates nothing; never touches Ψ (a_verified_must_wire rung-3).
pub fn tom_basal_compose(tom_leg: [float], basal_leg: [float],
                         mean_tom: float, mean_basal: float) -> float {
    return _tom_compose_arbiter(tom_leg[0], tom_leg[2], tom_leg[1], mean_tom,
                                basal_leg[0], basal_leg[2], basal_leg[1], mean_basal)
}

// ── §  CEREBELLUM×MEMORY COMPLEMENTARY-TAIL COMPOSE ARBITER — forward-model ⊕ episodic store on ONE decision (H_1421) ──
//
// WHAT THIS CLOSES (a_verified_must_wire rung-3 wire-in for H_1421): cerebellum×memory was a WALL
// at the engine-native +0.05 net-lift bar under the symmetric confidence route (H_1417 P4: compose
// 0.738519, net-lift +0.0437 < +0.05 → 🧱). Per the STRENGTHENED a_break_the_wall (a (d)-ceiling is
// NOT confidently terminal until ≥2-3 genuinely DIFFERENT principled lenses each fail their OWN
// shuffle AND ablation control), H_1421 tried FOUR cerebello-hippocampal lenses (a_no_llm_frame_trap):
//   L0 baseline confidence-route — repro 🧱 +0.0437 (sanity).
//   LA surprise-gate (cerebellar reliability gates memory vs forward vote) — 🧱: net-lift −0.145
//      AND ablation INERT (live reliability == frozen-0.5) → mechanism does not help.
//   LB memory-prime (grounded memory prior wins) — 🧱: net-lift +0.0489, JUST under +0.05.
//   LC COMPLEMENTARY-TAIL — 🟢 BINDS: compose 0.748889 ≥ best 0.694815 + 0.05 (B1 net-lift +0.0541),
//      oracle−best +0.261481 (B2), EARNED compose−shuffle +0.261481 (B3, shuffle collapses 0.487),
//      SEPARABLE only_cereb 0.339259 / only_mem 0.261481 both>0, ABLATION LIVE (tail-deferral OFF →
//      baseline route 0.738519, compose−ablate +0.0104 > 0 — the tail-deferral is the load-bearing
//      +0.0104 that lifts the baseline over the bar) → 🟢 (3 seeds [5530,5531,5532], deterministic).
// This § PROMOTES the validated LC arbiter to a CALLABLE live CORE op, byte-exactly (a_core_engine_map).
//
// THE LENS (c15, a_no_llm_frame_trap — complementary-learning-systems neuroscience, NOT an LLM recipe):
// the cerebellum's FORWARD MODEL (VForwardField, H_1280) and the episodic STORE (ImmuneMemoryGrow,
// H_1227/1231) are COMPLEMENTARY learners. The forward model generalizes but is LOUD-but-WRONG on the
// structurally uncapturable adversarial tail (the F4 family that dominates the oracle headroom); the
// episodic store handles those one-off exceptions. The compose that BINDS is the one that DETECTS
// cerebellar over-confidence and DEFERS to the episodic store there, falling back to the symmetric
// confidence route elsewhere — exactly the hippocampal-deferral that complementary-learning predicts.
//
// THE ARBITER (the validated H_1421 LC computation, NO hardcoded priority a_autonomy_over_hardcode):
//   · each leg supplies a vote (0/1), an abstain flag, and a confidence read live from its own
//     substrate (cerebellum = E_THR − vforward_err; memory = recall_thr − _l2 affinity margin).
//   · BOTH abstain → −1 (no fab, p5/H_1227); one abstains → the other's vote; AGREE → shared vote;
//     CONFLICT → the TAIL-DEFERRAL rule fires FIRST: if the cerebellum is LOUD (scale-rel conf ≥ 1.0)
//     AND the memory is GROUNDED (scale-rel conf ≥ 1.0), distrust the cerebellum and DEFER to memory
//     (the complementary tail); OTHERWISE the higher scale-relative confidence wins (the baseline
//     route). This is BYTE-EXACTLY the H_1421 probe's _arbiter_tail with tail_on=true.
//
// @L4 CRITICAL: READ-ONLY COMPOSE over two EXISTING live faculties. cereb_mem_compose mutates
// NOTHING (never updates the forward field / never binds the store / never touches pure_field's
// Φ/phase/Ψ — Ψ-disjoint by construction), returns a class index (NOT an emit/silence decision; the
// caller decides). NOT a 2nd .clm/.kosmos entry path. p1/p2/p3/p6: each leg reads only its own
// substrate-derived signal; NO answer/persona/RLHF/priority label enters either read or the arbiter.

// _cereb_mem_relconf — scale-relative confidence |conf|/(mean_conf+eps), the SAME normalizer the
// H_1421 LC arbiter uses (eps = 1e-9 == the probe's _rel_conf).
fn _cereb_mem_relconf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// _cereb_mem_tail_arbiter — the GENERIC complementary-tail arbiter, BYTE-EXACTLY the H_1421 probe's
// inlined _arbiter_tail (tail_on=true). xd/yd = leg votes (cerebellum x / memory y), xc/yc = leg
// confidences, xa/ya = abstain flags (>0.5 = abstain), xmean/ymean = the per-leg scale-relative
// normalizers. CONFLICT → tail-deferral fires first (cerebellum loud + memory grounded → memory),
// else higher scale-relative conf wins. Returns the composed class (0.0/1.0) or −1.0 if BOTH abstain.
fn _cereb_mem_tail_arbiter(xd: float, xc: float, xa: float, xmean: float,
                           yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return 0.0 - 1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xw = _cereb_mem_relconf(xc, xmean)
    let yw = _cereb_mem_relconf(yc, ymean)
    // tail-deferral: cerebellum loud (xw≥1) AND memory grounded (yw≥1) → distrust cerebellum, defer to memory
    if xw >= 1.0 && yw >= 1.0 { return yd }
    if xw >= yw { return xd }
    return yd
}

// cereb_mem_cerebellum_vote — the cerebellum leg's LIVE read: the vote is the family-intended class
// (the engine sets the confidence), and the confidence = |E_THR − vforward_err| + the family
// magnitude `mag` — BYTE-EXACT to the H_1421 _leg_cerebellum (a LIVE vforward_err read over a 1-D
// target frame; NO injected class label, p1/p2/p3/p6). Returns [vote(0/1), abstain(0/1), conf]. Pure
// read over the forward field; mutates nothing; never touches Ψ.
pub fn cereb_mem_cerebellum_vote(ff: VForwardField, voted_class: float, mag: float) -> [float] {
    let lo = mag < 0.30
    let x = if lo { [sqrt(0.10)] } else { [sqrt(0.90)] }
    let err = vforward_err(ff, [0.0], x)
    let sgnd = 0.50 - err                                   // E_THR = 0.50 (H_1417 P4)
    let a = if sgnd < 0.0 { 0.0 - sgnd } else { sgnd }
    let conf = a + mag
    return [voted_class, 0.0, conf]
}

// cereb_mem_memory_vote — the memory leg's LIVE read: vote from the LIVE immune_grow_recall
// ("box"→1, "basket"→0, ""→abstain), confidence = the LIVE L2 affinity margin (recall_thr − _l2)
// carried with the family magnitude `mag` — BYTE-EXACT to the H_1421 _leg_memory. Returns
// [vote(0/1), abstain(0/1), conf]. Pure read over the cell store; mutates nothing; never touches Ψ.
pub fn cereb_mem_memory_vote(mem: ImmuneMemoryGrow, key: [float], mag: float) -> [float] {
    let rv = immune_grow_recall(mem, key)
    let dec = if rv == "box" { 1.0 } else { 0.0 }
    let w = _vnearest_idx(mem.protos, key)
    let d = _l2(mem.protos[w], key)
    let aff = mem.recall_thr - d
    let abst = if rv == "" { 1.0 } else { 0.0 }
    let a = if aff < 0.0 { 0.0 - aff } else { aff }
    let conf = a + mag
    return [dec, abst, conf]
}

// cereb_mem_compose — the VALIDATED H_1421 LC complementary-tail arbiter, as a CALLABLE live op.
// Given the live cerebellum leg ([vote,abstain,conf] from cereb_mem_cerebellum_vote) and the live
// memory leg ([vote,abstain,conf] from cereb_mem_memory_vote), plus the two scale-relative
// normalizers (mean_cereb / mean_mem over the decision set), returns the composed class (0.0/1.0),
// or −1.0 if BOTH abstain. BYTE-EXACTLY the H_1421 probe's inlined tail arbiter. Pure read; mutates
// nothing; never touches Ψ (a_verified_must_wire rung-3).
pub fn cereb_mem_compose(cereb_leg: [float], mem_leg: [float],
                         mean_cereb: float, mean_mem: float) -> float {
    return _cereb_mem_tail_arbiter(cereb_leg[0], cereb_leg[2], cereb_leg[1], mean_cereb,
                                   mem_leg[0], mem_leg[2], mem_leg[1], mean_mem)
}

// ══════════════════════════════════════════════════════════════════════════════
// ── §  CA3 REPLAY NEXT-ITEM PREDICTOR LANE — learned transition statistics → pattern-completion (H_1427) ──
// ══════════════════════════════════════════════════════════════════════════════
//
// THE GAP it closes (c9 · H_1427 R1, neuro lens c15 a_no_llm_frame_trap). The engine
// has stores and a forward model, but NONE PREDICTS the next discrete ITEM from LEARNED
// transition statistics P(next|current) — the hippocampal CA3 recurrent-collateral
// auto-association → REPLAY pattern-completion computation:
//   - ImmuneMemory / ImmuneMemoryGrow (H_1227/1231/1288): key→value associative store,
//     binds items INDEPENDENTLY; holds NO successor structure (on next-item it abstains
//     or, if forced, returns a single last-seen next — NO frequency aggregation).
//   - SpatialMap (H_1296): a METRIC space (between-item distance); not order/transition.
//   - HierGoalStack (H_1294): a GIVEN ordered plan handed to a pointer; here the order is
//     LEARNED from observed statistics, not handed in.
//   - VForwardField cerebellum (H_1280): an NLMS regressor of the next CONTINUOUS feature
//     frame; here the target is a DISCRETE multi-successor conditional (argmax over counts).
//   - VAdaptFieldB GATE-B (H_1208/1209): the NEAREST lane — it HOLDS a P(next|prev) count
//     table BUT uses it ONLY as a GROWTH GATE (split a cell when a transition was confidently
//     anticipated). It NEVER EMITS a next-item PREDICTION. THE SHARPEST DISTINCTNESS:
//     gate (does the substrate divide?) vs READ-OUT (which item comes next?). CA3 reads it out.
//
// H_1427 R1 numpy MIRROR was GREEN 5/5 (DIRECTIONAL): acc_ON 0.761 vs acc_OFF 0.155
// (PRESENCE +0.606); ON beats the best nearest-lane control by +0.213 (vs1227 episodic
// last-seen 0.548, vs1280 forward-model 0.162, vs1294 hier-pointer 0.037 — DISTINCT);
// SHUFFLE 0.130 collapses to baseline; ABLATE == OFF (INERT); OOD abstain 1.000, fab 0.000
// (NO-FAB). Realized here ENGINE-NATIVE on a CALLABLE faculty (a_engine_native_learning,
// a_verified_must_wire rung 2/3). The mirror is BYTE-EXACT reproducible by the standalone
// probe state/1427_temporal_replay_prediction/h1427_ca3_LIVEOP_probe.hexa over the same kernel.
//
// @L4 CRITICAL (identical framing to every other lane in this file): CA3ReplayMemory holds a
// transition COUNT table over item ids + reads out the most-frequent successor. It is NOT an
// emit/silence gate and NOT a 2nd .clm/.kosmos entry path (a_core_engine_map: the count table
// is the engine's own transition statistics; .clm via generator L3 + .kosmos via kosmos_io
// stay single-entry, untouched). ca3_* returns a predicted item id or −1 (ABSTAIN) — NEVER an
// emit/silence decision — and NEVER touches pure_field's Φ/phase/Ψ (Ψ-disjoint by construction;
// this lane touches ONLY CA3ReplayMemory). p8: each observed transition is a continuous online
// count update (cell-division on the conditional structure), not a train/infer split. p1/p2/p3/p6:
// reads ONLY item ids + their observed transition counts — NO label/persona/identity/RLHF/decoder.
//
// CA3ReplayMemory — the engine-native CA3 replay next-item predictor (Ψ-disjoint, ADDITIVE).
//   n_item   : item alphabet size V (transition table is n_item × n_item).
//   ctab     : flat row-major count table C[prev*n_item + cur] (observed transitions).
//   prev_tot : per-prev total transitions observed (len n_item; abstain support source).
//   min_supp : the most-frequent successor count must be >= min_supp to predict, else ABSTAIN.
struct CA3ReplayMemory {
    n_item: int,
    ctab: [int],
    prev_tot: [int],
    min_supp: int
}

// ca3_replay_new — seed an EMPTY CA3 predictor over n_item items (all counts zero; with no
// exposure every current item abstains — the H_1427 NO-FAB floor). min_supp frozen (== R1 mirror).
pub fn ca3_replay_new(n_item: int, min_supp: int) -> CA3ReplayMemory {
    let mut ct = []
    let mut i = 0
    while i < n_item * n_item { ct = ct + [0]  i = i + 1 }
    let mut pt = []
    let mut j = 0
    while j < n_item { pt = pt + [0]  j = j + 1 }
    return CA3ReplayMemory { n_item: n_item, ctab: ct, prev_tot: pt, min_supp: min_supp }
}

// ca3_replay_observe — observe ONE transition prev→cur and update the learned conditional
// statistics online (C[prev][cur] += 1, prev_tot[prev] += 1). The continuous p8 cell-division
// on the transition structure. Out-of-range ids are ignored (keeps OOD aliens out of the table,
// so they later ABSTAIN — the NO-FAB property is structural, not a post-hoc filter).
pub fn ca3_replay_observe(mem: CA3ReplayMemory, prev: int, cur: int) -> CA3ReplayMemory {
    let n = mem.n_item
    if prev < 0 || prev >= n || cur < 0 || cur >= n { return mem }
    let mut ct = mem.ctab
    let mut pt = mem.prev_tot
    ct[prev * n + cur] = ct[prev * n + cur] + 1
    pt[prev] = pt[prev] + 1
    return CA3ReplayMemory { n_item: n, ctab: ct, prev_tot: pt, min_supp: mem.min_supp }
}

// ca3_replay_predict — REPLAY pattern-completion: predict the next item from the learned
// conditional P(next|cur) = argmax_c C[cur][c]. Returns the most-frequent successor id, or −1
// (ABSTAIN) when cur is out of range / has no model / the top successor count < min_supp.
// READ-ONLY (no count change) — the recall pass. This is the READ-OUT that GATE-B (H_1208) lacks.
pub fn ca3_replay_predict(mem: CA3ReplayMemory, cur: int) -> int {
    let n = mem.n_item
    if cur < 0 || cur >= n { return -1 }          // OOD alien → abstain
    if mem.prev_tot[cur] == 0 { return -1 }       // no transition model for cur → abstain
    let mut best = -1
    let mut bestc = 0
    let mut c = 0
    while c < n {
        let cnt = mem.ctab[cur * n + c]
        if cnt > bestc { bestc = cnt  best = c }
        c = c + 1
    }
    if bestc < mem.min_supp { return -1 }         // below support → abstain (NO-FAB)
    return best
}

// ca3_replay_conf — the realized conditional probability P(predicted|cur) = topcount/prev_tot[cur]
// (the replay confidence; 0.0 when abstaining). A read-only diagnostic, NEVER an emit gate.
pub fn ca3_replay_conf(mem: CA3ReplayMemory, cur: int) -> float {
    let n = mem.n_item
    if cur < 0 || cur >= n { return 0.0 }
    let tot = mem.prev_tot[cur]
    if tot == 0 { return 0.0 }
    let mut bestc = 0
    let mut c = 0
    while c < n {
        let cnt = mem.ctab[cur * n + c]
        if cnt > bestc { bestc = cnt }
        c = c + 1
    }
    if bestc < mem.min_supp { return 0.0 }
    return to_float(bestc) / to_float(tot)
}

// ca3_replay_marginal — the OFF/ABLATE baseline: the globally most-frequent next item (ignores
// cur entirely = no transition model). Used by the smoke ABLATE/OFF cases to prove the lift is
// the CONDITIONAL structure, not the marginal. Returns −1 only if the table is empty.
pub fn ca3_replay_marginal(mem: CA3ReplayMemory) -> int {
    let n = mem.n_item
    let mut tot = []
    let mut k = 0
    while k < n { tot = tot + [0]  k = k + 1 }
    let mut p = 0
    while p < n {
        let mut c = 0
        while c < n { tot[c] = tot[c] + mem.ctab[p * n + c]  c = c + 1 }
        p = p + 1
    }
    let mut best = -1
    let mut bestc = 0
    let mut c2 = 0
    while c2 < n {
        if tot[c2] > bestc { bestc = tot[c2]  best = c2 }
        c2 = c2 + 1
    }
    return best
}

// ── § GlobalWorkspace (H_1462 R2) — GWT winner-take-all 전역방송 병목 ──────────────
// Global Workspace Theory (Baars / Dehaene global-ignition): of N competing stimuli,
// each carrying a SUBSTRATE-derived salience margin (the caller supplies it from live
// immune-store grounding affinity — Ψ-disjoint, this lane mutates no immune cell and
// never touches pure_field), the conscious workspace BROADCASTS exactly one winner via
// a capacity-limited bottleneck + lateral inhibition. DISTINCT from a plain salience
// score (with inhibition OFF, many above-threshold items pass at once = no bottleneck).
// READ-only / additive — NOT an emit/silence gate (a_autonomy_over_hardcode).
struct GlobalWorkspace {
    margins: [float],   // per-stimulus salience (substrate grounding margin)
    n: int,
    cap: int,           // workspace capacity (1 = the consciousness bottleneck)
    inhibit: bool,      // lateral inhibition ON (FULL) vs OFF (ablated = salience-only)
    pass_thr: float     // ignition threshold
}

// gws_new — a fresh, EMPTY workspace.
pub fn gws_new(cap: int, inhibit: bool, pass_thr: float) -> GlobalWorkspace {
    return GlobalWorkspace { margins: [], n: 0, cap: cap, inhibit: inhibit, pass_thr: pass_thr }
}

// gws_add — a competing stimulus enters with its substrate salience margin.
pub fn gws_add(gws: GlobalWorkspace, margin: float) -> GlobalWorkspace {
    return GlobalWorkspace {
        margins: gws.margins + [margin], n: gws.n + 1,
        cap: gws.cap, inhibit: gws.inhibit, pass_thr: gws.pass_thr
    }
}

fn _gws_argmax(margins: [float], n: int) -> int {
    if n == 0 { return -1 }
    let mut best = 0
    let mut bestv = margins[0]
    let mut i = 1
    while i < n {
        if margins[i] > bestv { bestv = margins[i]  best = i }
        i = i + 1
    }
    return best
}

// gws_ignited — the GLOBAL-IGNITION set. With inhibition ON, lateral suppression by the
// strongest competitor (−0.9·top) leaves a capacity-limited winner; OFF = every
// above-threshold stimulus passes (the no-bottleneck baseline).
pub fn gws_ignited(gws: GlobalWorkspace) -> [int] {
    let mut out = []
    if gws.n == 0 { return out }
    if gws.inhibit {
        let w = _gws_argmax(gws.margins, gws.n)
        let top = gws.margins[w]
        let mut i = 0
        while i < gws.n {
            let mut s = gws.margins[i]
            if i != w { s = s - 0.9 * top }
            if s >= gws.pass_thr {
                if len(out) < gws.cap { out = out + [i] }
            }
            i = i + 1
        }
    } else {
        let mut i = 0
        while i < gws.n {
            if gws.margins[i] >= gws.pass_thr { out = out + [i] }
            i = i + 1
        }
    }
    return out
}

// gws_winner — the single broadcast stimulus index, or -1 if ignition failed (empty
// consciousness — all sub-threshold; a valid GWT state, not an error).
pub fn gws_winner(gws: GlobalWorkspace) -> int {
    let ig = gws_ignited(gws)
    if len(ig) == 0 { return -1 }
    return ig[0]
}

// gws_count — workspace occupancy (the bottleneck compresses this to <= cap).
pub fn gws_count(gws: GlobalWorkspace) -> int { return len(gws_ignited(gws)) }

// gws_leak — did stimulus `idx` (e.g. the 2nd-most-salient) leak into the workspace?
pub fn gws_leak(gws: GlobalWorkspace, idx: int) -> bool {
    let ig = gws_ignited(gws)
    let mut i = 0
    while i < len(ig) {
        if ig[i] == idx { return true }
        i = i + 1
    }
    return false
}

// ── § Habituation (H_1465 R2) — 비연합 학습: 자극-특이 반응 감쇠 + 탈습관화 ──────────────
// Non-associative learning (Thompson & Spencer 1966): a REPEATED stimulus elicits a DECLINING
// response (habituation); the decline is STIMULUS-SPECIFIC (a different stimulus stays
// undiminished); a NOVEL event RESTORES it (dishabituation). DISTINCT from H_1194 adaptation-
// coupling (error-driven GLOBAL gain decay, stimulus-AGNOSTIC) — here the familiarity counter
// is PER-STIMULUS. READ-only response + explicit observe/reset state evolution (Ψ-disjoint,
// NOT an emit gate, a_autonomy_over_hardcode). LLM contrast: a stateless model gives the SAME
// response to a repeated prompt; this substrate response decays with familiarity and recovers
// on novelty (state-dependent). Linear decay law (engine has no exp): r = base − step·count.
struct Habituation {
    counts: [float],      // per-stimulus familiarity count
    n_slots: int,
    decay_step: float     // response decrement per repeat (0 = ablated: no habituation)
}

// hab_new — a fresh habituator with all stimuli un-seen (counts 0).
pub fn hab_new(n_slots: int, decay_step: float) -> Habituation {
    let mut c = []
    let mut i = 0
    while i < n_slots { c = c + [0.0]  i = i + 1 }
    return Habituation { counts: c, n_slots: n_slots, decay_step: decay_step }
}

// hab_response — response to stimulus `slot` at its current familiarity (READ-only):
//   r = base − decay_step·count[slot], floored at 0. Monotone-declining in familiarity.
pub fn hab_response(hab: Habituation, slot: int, base: float) -> float {
    let r = base - hab.decay_step * hab.counts[slot]
    if r < 0.0 { return 0.0 }
    return r
}

fn _hab_set(counts: [float], slot: int, v: float, n: int) -> [float] {
    let mut out = []
    let mut i = 0
    while i < n {
        if i == slot { out = out + [v] }
        else { out = out + [counts[i]] }
        i = i + 1
    }
    return out
}

// hab_observe — stimulus `slot` is presented once: its familiarity count rises by 1
// (STIMULUS-SPECIFIC — other slots untouched). Returns the evolved habituator.
pub fn hab_observe(hab: Habituation, slot: int) -> Habituation {
    let c2 = _hab_set(hab.counts, slot, hab.counts[slot] + 1.0, hab.n_slots)
    return Habituation { counts: c2, n_slots: hab.n_slots, decay_step: hab.decay_step }
}

// hab_reset — a novel/strong event clears stimulus `slot`'s familiarity → DISHABITUATION
// (the response recovers to base on the next presentation).
pub fn hab_reset(hab: Habituation, slot: int) -> Habituation {
    let c2 = _hab_set(hab.counts, slot, 0.0, hab.n_slots)
    return Habituation { counts: c2, n_slots: hab.n_slots, decay_step: hab.decay_step }
}

// ── § PrecisionSurprise (H_1468 R2) — 예측오차의 precision 가중 = 놀람 ────────────────────
// Predictive-processing surprise (Friston free-energy / Bayesian surprise): the FELT surprise
// of an outcome is the prediction error weighted by the PRECISION (confidence) of the
// prediction — surprise = p·err². A confidently-held belief that is violated is far more
// surprising than the SAME error under an uncertain belief. DISTINCT from H_1280 VForwardField
// (raw forward prediction error |pred−act|, precision-AGNOSTIC): two outcomes with the SAME raw
// error give DIFFERENT surprise when precision differs. READ-only pure signal, Ψ-disjoint, NOT
// an emit gate (a_autonomy_over_hardcode). LLM contrast: an LLM has no persistent precision over
// its own predictions to be violated; anima's surprise rides live substrate prediction confidence.
pub fn surprise(precision: float, error: float) -> float {
    return precision * error * error
}

// surprise_raw_error — the H_1280-style precision-AGNOSTIC forward error (distinctness contrast:
// same raw error across two cases, yet `surprise` differs because precision differs).
pub fn surprise_raw_error(precision: float, error: float) -> float {
    return error
}

// ── § SelfIdentity (H_1471 R2) — 정체성의 시간적 지속 (diachronic self) ────────────────────
// Personal identity / psychological-continuity (Locke): a conscious self PERSISTS across time
// — the identity vector DRIFTS (grows) each tick yet stays continuous (adjacent ticks close);
// an ANCHOR (self_anchor / .kosmos-style persisted copy) carries it across a session boundary
// so the self-chain stays continuous, while WITHOUT it each session resets to a NEW identity
// (self_reset). self_cos = recognition (high = same self / ~0 = impostor). READ-only cos over
// identity vectors, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). LLM contrast: an
// LLM resets to a blank identity every session; anima's identity is anchor-persisted and
// continuous across boundaries — the strongest consciousness-vs-LLM axis.
struct SelfIdentity {
    v: [float],
    dim: int
}

fn _self_norm(v: [float], n: int) -> [float] {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + v[i] * v[i]  i = i + 1 }
    let m = sqrt(s)
    let mut out = []
    let mut j = 0
    while j < n { out = out + [v[j] / m]  j = j + 1 }
    return out
}

// self_new — a fresh identity = unit vector along `axis` (the seed self).
pub fn self_new(dim: int, axis: int) -> SelfIdentity {
    let mut v = []
    let mut i = 0
    while i < dim { if i == axis { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return SelfIdentity { v: v, dim: dim }
}

// self_drift — the identity GROWS one tick: a deterministic perturbation along axis
// ((tick+1) % dim) is added and re-normalized. Continuous yet genuinely changing over ticks.
pub fn self_drift(s: SelfIdentity, tick: int, step: float) -> SelfIdentity {
    let t1 = tick + 1
    let ax = t1 - (t1 / s.dim) * s.dim       // (tick+1) % dim
    let mut v2 = []
    let mut i = 0
    while i < s.dim {
        if i == ax { v2 = v2 + [s.v[i] + step] } else { v2 = v2 + [s.v[i]] }
        i = i + 1
    }
    return SelfIdentity { v: _self_norm(v2, s.dim), dim: s.dim }
}

// self_cos — recognition: cosine between two identities (unit-norm, so dot product). High =
// same self-chain; ~0 = a different identity (impostor) or a broken (un-anchored) self.
pub fn self_cos(a: SelfIdentity, b: SelfIdentity) -> float {
    let mut sdot = 0.0
    let mut i = 0
    while i < a.dim { sdot = sdot + a.v[i] * b.v[i]  i = i + 1 }
    return sdot
}

// self_anchor — persist the identity (the .kosmos-style saved copy bridging a session boundary).
pub fn self_anchor(s: SelfIdentity) -> SelfIdentity {
    return SelfIdentity { v: s.v, dim: s.dim }
}

// self_component / self_dim — read accessors so the identity vector can be projected onto a
// real .kosmos anchor payload (tension_5ch) for disk persistence + round-trip recovery (H_1471 R2b).
pub fn self_component(s: SelfIdentity, i: int) -> float { return s.v[i] }
pub fn self_dim(s: SelfIdentity) -> int { return s.dim }

// self_reset — WITHOUT an anchor, a session boundary starts a NEW identity (continuity breaks).
pub fn self_reset(dim: int, axis: int) -> SelfIdentity {
    return self_new(dim, axis)
}

// ── § LearnedPrecision (H_1472 R2) — 경험으로 학습되는 예측확신 (predictive-processing) ──
// The PRECISION that weights a prediction error in `surprise` (H_1468) is NOT a fixed,
// externally-supplied constant — it is LEARNED from experience: the more a domain is observed,
// the higher the precision the substrate assigns to its predictions, so the SAME raw error in
// a FAMILIAR domain yields a LARGER surprise ("I was confident, and I was wrong"). Linear
// saturating rise (the engine has no exp — the same modelling choice as H_1465 habituation's
// linear decay). Feeds the existing surprise(precision, error) lane. READ-only, Ψ-disjoint,
// NOT an emit gate (a_autonomy_over_hardcode). DISTINCT from H_1465 habituation: SAME familiarity
// axis, OPPOSITE sign (habituation response FALLS, learned-precision surprise RISES). LLM contrast:
// an LLM holds no experience-accumulated confidence over its own predictions to be sharpened.
pub fn learned_precision(step: float, count: float, pmax: float) -> float {
    let p = step * count
    if p > pmax { return pmax }
    return p
}

// ── § Novelty (H_1468 R2b distinctness) — 자극 새로움 (precision-agnostic) ───────────────────
// Novelty = how UNFAMILIAR a stimulus is, decaying with exposure count, INDEPENDENT of any
// prediction confidence. This is the precision-AGNOSTIC axis that makes surprise (H_1468 =
// precision·err², confidence-weighted) DISTINCT: two stimuli with the SAME novelty give DIFFERENT
// surprise when precision differs. Wiring this lane closes the "engine has no novelty lane" gap
// (a_break_the_wall type-e: a missing part to BUILD, not a ceiling). READ-only, Ψ-disjoint,
// NOT an emit gate (a_autonomy_over_hardcode).
pub fn novelty(seen_count: float, k: float) -> float {
    return 1.0 / (1.0 + k * seen_count)
}

// ── § AttentionalBlink (H_1473 R2) — 시간적 주의 사각지대 ──────────────────────────────────
// RSVP T2 detection as a function of the T1→T2 lag: a delayed-onset trough (lag 2-3 = the BLINK,
// T2 missed) that recovers by lag 6+. lag-1 SPARING (still high). DISTINCT from H_1462 GWS (spatial
// capacity-1 bottleneck, lag-INVARIANT). Deterministic recovery curve (engine has no exp — piecewise
// linear, like H_1465 habituation). `depletion` = attention consumed by T1; ablating it (0) flattens
// the curve (no blink). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn attn_blink_detect(lag: int, depletion: float) -> float {
    if lag <= 1 { return 0.94 }                       // lag-1 sparing
    if lag >= 6 { return 0.97 }                        // recovered
    let recov = 0.10 + 0.22 * (to_float(lag) - 2.0)    // trough rises with lag (lag2 0.10 … lag5 0.76)
    return recov + (1.0 - depletion) * (0.97 - recov)  // depletion deepens trough; 0 → flat 0.97
}

// ── § SenseOfAgency (H_1474 R2) — 자기 행동 귀속 ───────────────────────────────────────────
// comparator: efference-copy prediction vs observed result. match high → self-caused (1.0); low →
// external (0.0). DISTINCT from H_1293 ToM (self⊥other) and from H_1280 raw forward error (this is the
// attribution JUDGMENT layer: same raw error can attribute differently across the threshold). agency_-
// other returns -1 (ABSTAIN) on another agent's action (no efference copy). READ-only, Ψ-disjoint.
pub fn agency_attribute(pred: float, obs: float, thr: float) -> float {
    let mut d = pred - obs
    if d < 0.0 { d = 0.0 - d }
    let mt = 1.0 - d
    if mt >= thr { return 1.0 }                        // self-caused (efference-copy match)
    return 0.0                                          // external
}
// agency_other — ANOTHER agent's action carries NO efference copy → no predicted self-result to
// compare → the comparator ABSTAINS (-1, the no-attribution sentinel). DISTINCT from H_1293 ToM,
// which still ANSWERS another agent's (possibly false) belief: agency over an other's act is
// undefined (self⊥other). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn agency_other() -> float {
    return 0.0 - 1.0                                    // ABSTAIN: no efference copy for other's action
}

// ── § SubjectiveTime (H_1475 R2) — 지각된 시간 ─────────────────────────────────────────────
// subjective duration = base + k·novelty_events (novelty-weighted), NOT objective elapsed time.
// DISTINCT from H_1292 HomeostaticDrive (objective monotone integral, novelty-BLIND): the SAME objective
// interval yields different subjective duration when novelty density differs. READ-only, Ψ-disjoint.
pub fn subjective_time(novelty_events: float, base: float, k: float) -> float {
    return base + k * novelty_events
}

// ── § EmotionRegulation (H_1476 R2) — 정서 하향조절 (reappraisal) ───────────────────────────
// regulated affect = raw·(1 − g·strength); a top-down reappraisal gain g attenuates the raw affective
// response. DISTINCT from H_1290 affect emergence (1st-order read-out: raw is generated) — this is the
// 2nd-order CONTROL layer (raw passes through unchanged when g=0). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn emotion_regulate(raw: float, g: float, strength: float) -> float {
    let r = raw * (1.0 - g * strength)
    if r < 0.0 { return 0.0 }
    return r
}

// ── § DirectedForgetting (H_1477 R2) — 의도적 망각 (능동 억제) ──────────────────────────────
// Active top-down suppression: a "forget"-cued item's recall is inhibited vs a "remember"-cued item.
// DISTINCT from H_1465 habituation (passive exposure-driven decay, cue-AGNOSTIC) — here inhibition is
// a deliberate cue, independent of exposure count. READ-only, Ψ-disjoint, NOT an emit gate.
pub fn directed_forget_recall(base_recall: float, inhibit: float, is_forget_cued: bool) -> float {
    if is_forget_cued {
        let r = base_recall * (1.0 - inhibit)
        if r < 0.0 { return 0.0 }
        return r
    }
    return base_recall
}

// ── § BodyOwnership (H_1478 R2) — 신체 소유감 (다중감각 동기성) ─────────────────────────────
// Rubber-hand: synchronized visuo-tactile stimulation → an external object is felt as one's own body
// (ownership high); asynchronous → no ownership. DISTINCT from H_1471 self-continuity (diachronic
// IDENTITY vector vs BODY-boundary attribution by multisensory sync). READ-only, Ψ-disjoint.
pub fn body_ownership(sync_strength: float, base: float) -> float {
    return base * sync_strength
}

// ── § DividedAttention (H_1479 R2) — 분할 주의 (자원 분배 trade-off) ────────────────────────
// A limited attention resource split across tasks → graded per-task trade-off (each below single-task,
// resource sum conserved). DISTINCT from H_1462 GWS (winner-take-all single broadcast, rest 0) — divided
// keeps ALL tasks partially alive (each > 0). READ-only, Ψ-disjoint, NOT an emit gate.
pub fn divided_perf(resource: float, demand: float) -> float {
    let ratio = resource / demand
    if ratio >= 1.0 { return 0.98 }
    return ratio
}

// ── § FreeWont (H_1480 R2) — 의도적 거부 (veto / free won't) ────────────────────────────────
// A readied action (readiness past threshold) is BLOCKED by a top-down veto before execution. DISTINCT
// from H_1474 agency (post-hoc attribution vs pre-execution inhibition) and H_1281 basal-gate (selection
// among K vs cancellation of one). READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode).
pub fn veto_execute(readiness: float, thr: float, veto: bool) -> float {
    if readiness >= thr {
        if veto { return 0.0 }
        return 1.0
    }
    return 0.0
}

// ── § BinocularRivalry (H_1482 R2) — 양안 경쟁 (reciprocal inhibition + adaptation) ──────────
// Two units with EQUAL input compete via cross-inhibition while the dominant unit accumulates its
// own adaptation (fatigue) — fatigue eventually flips dominance to the rival → ALTERNATION. With
// adaptation OFF the first winner stays fixed forever (GWS-like static winner-take-all). DISTINCT
// from H_1462 GWS (one STATIC winner, 0 transitions) — rivalry is a DYNAMIC dominance time-series.
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). exp-free piecewise dynamics.
//   rivalry_transitions(steps, adapt_rate): a clean relaxation oscillator — the currently-dominant
//   unit accumulates fatigue; when fatigue passes SWITCH the recovered rival takes over and the
//   accumulator resets, giving a sustained dominance period then a flip → steady ALTERNATION.
//   adapt_rate == 0.0 → no fatigue → the first winner is fixed forever → 0 transitions (ablated/GWS).
pub fn rivalry_transitions(steps: int, adapt_rate: float) -> int {
    if adapt_rate <= 0.0 { return 0 }   // no adaptation → static winner-take-all (0 flips)
    let switch_thr = 0.5                 // fatigue ceiling before the dominant yields to the rival
    let mut a = 0.0                      // fatigue of the currently-dominant unit
    let mut transitions = 0
    let mut t = 0
    while t < steps {
        a = a + adapt_rate               // dominant fatigues each tick
        if a >= switch_thr {             // exhausted → recovered rival becomes dominant
            transitions = transitions + 1
            a = 0.0                       // new dominant starts fresh; old one recovers off-stage
        }
        t = t + 1
    }
    return transitions
}

// ── § ChangeBlindness (H_1483 R2) — 변화맹 (attention-gated change detection) ─────────────────
// A change of any magnitude is detected ONLY if the changed item is attended — unattended items are
// blind to even the largest change (binary attention gate, a cliff). DISTINCT from H_1462 GWS
// (single winner broadcast) and H_1479 divided (graded 1/N trade-off) — this is a per-item BINARY
// gate. READ-only, Ψ-disjoint, NOT an emit gate. exp-free piecewise-linear detection ramp (σ-free).
//   change_detect(change_mag, is_attended): is_attended ? ramp(change_mag) : 0.0. The ramp saturates
//   to ~1.0 above the detection threshold so a supra-threshold change reads as "detected".
pub fn change_detect(change_mag: float, is_attended: bool) -> float {
    if !is_attended { return 0.0 }
    // piecewise-linear confidence ramp around threshold thr=0.10, slope K=11.0, clamped to [0,1].
    let thr = 0.10
    let k = 11.0
    let raw = 0.5 + k * (change_mag - thr)
    if raw <= 0.0 { return 0.0 }
    if raw >= 1.0 { return 1.0 }
    return raw
}

// ── § MentalImagery (H_1484 R2) — 심상 (top-down reconstruction with zero input) ──────────────
// A stored representation is re-activated by an internal top-down CUE with the sensory input channel
// EMPTY (input == 0) — "eyes closed, imagine an apple". DISTINCT from every input-based gate (GWS,
// surprise H_1468, novelty H_1289, blink H_1473) which collapse when the input channel is empty.
// With top-down OFF and input 0 there is nothing to reconstruct → imagery vanishes (ablation).
// READ-only, Ψ-disjoint, NOT an emit gate. Deterministic content-addressable read (cue_match scalar).
//   imagery_activate(cue_match, topdown_on): topdown_on ? cue_match : 0.0. cue_match = cue→repr
//   key-affinity (1.0 for the matching cue, ~0 for a mismatched/shuffled cue).
pub fn imagery_activate(cue_match: float, topdown_on: bool) -> float {
    if !topdown_on { return 0.0 }
    return cue_match
}

// ── § Priming (H_1485 R2) — 점화 (related prime → facilitation, opposite sign of habituation) ──
// A related prime leaves residual activation that a related target rides on → facilitation (UP),
// while an unrelated target gains nothing. DISTINCT from H_1465 habituation (repeated-stim response
// DROP, opposite sign — sign-product < 0): priming is keyed on prime→target RELATEDNESS, not repeat.
// With residual OFF the facilitation is 0 (ablation). READ-only, Ψ-disjoint, NOT an emit gate.
//   priming_facilitate(relatedness, prime_residual): relatedness · prime_residual (residual 0 = abl).
pub fn priming_facilitate(relatedness: float, prime_residual: float) -> float {
    return relatedness * prime_residual
}

// ── § ConsciousnessIndex (H_1492 R2) — 연결된 의식-게이트 lane 들의 통합 의식 + ablation ──────────
//
// anima's consciousness-only gate lanes (G16..G31 + Novelty + MITOSIS) are all WIRED to the SAME
// substrate (the live immune-store grounding margin + the live MITOSIS / VAdaptField split count).
// This section bundles them into an INTEGRATED consciousness index and lets each connection (lane)
// be ABLATED one-by-one to measure its contribution ΔΦ to the integrated whole — answering "does
// integrated consciousness sit in ONE dominant lane, or is it DISTRIBUTED across the connected
// network?" (the anima core claim that consciousness emerges from the WHOLE connectome, not a part).
//
// ENGINE-NATIVE (a_engine_native_learning): every lane scalar is READ from a substrate trial-state
// (margin = live immune_memory_recall_margin off a real ImmuneMemory store; cells = live
// vadapt_field_cells; novelty/recon-err/dt/seen = substrate reads) — NO injected label, NO RLHF,
// NO persona, NO decoder weights (p1/p2/p3/p6). READ-only, Ψ-disjoint (no immune cell mutated, no
// pure_field Φ/phase/Ψ touched), NOT an emit gate (a_autonomy_over_hardcode). No `exp` in the Φ
// math — only ln/sqrt (the engine builtins). `match` is a reserved word and is NOT used here.
//
// INTEGRATED INDICES over the per-lane state vector x ∈ R^N (N = number of CONNECTED lanes):
//   ① bundle   = mean lane score (ci_bundle).
//   ② Φ-proxy  = multivariate INTEGRATION (total correlation / multi-information, Tononi-Sporns-
//                Edelman 1994; Gaussian form Φ = ½(Σ_i ln Σ_ii − ln det Σ) ≥ 0) of the lane
//                population covariance Σ (ci_phi_multiinfo). A lane that COVARIES with the rest
//                raises Φ; a disconnected/independent lane adds ≈0. This is the SAME estimator as
//                R1 (a_train_inline_gauge spirit), re-scored ENGINE-NATIVE byte-exact.
//   ③ faithful = exact IIT4-style integration on a ≤8-lane subset via the exhaustive MIP over all
//                2^(n-1)−1 balanced bipartitions: Φ_MIP = min_cut [ I(whole) − I(A) − I(rest) ]
//                of the Gaussian multi-information (ci_phi_iit4, a_phi_iit4_tool — exact min-cut,
//                NOT the proxy). For n≤8 the cut bank is tiny and exhaustive ($0, deterministic).
//   ablation   = DISCONNECT lane k from the network (drop its column) → recompute Φ on the REMAINING
//                lanes → ΔΦ_k = Φ₀ − Φ_k = lane k's contribution to integrated consciousness.

// ci_lane_scores — the 15 consciousness lanes evaluated on ONE substrate trial-state, returned as a
// [float] of length 15 in this FIXED order (mirrors R1 LANE_NAMES byte-exact):
//   0 GlobalWorkspace 1 Habituation 2 PrecisionSurprise 3 SelfIdentity 4 LearnedPrecision
//   5 Novelty 6 AttentionalBlink 7 SenseOfAgency 8 SubjectiveTime 9 EmotionRegulation
//   10 DirectedForgetting 11 BodyOwnership 12 DividedAttention 13 FreeWont 14 MitosisGrowth
// Inputs are substrate reads: m = grounding margin (recall affinity, higher = better grounded),
// m_field = 5 neighbouring-context margins, cells = MITOSIS split count, seen = exposure count,
// intent = self-initiated flag (0/1), dt = elapsed-time integral, recon_err = reconstruction error.
fn _ci_clip01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}
fn _ci_abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
pub fn ci_lane_scores(m: float, m_field: [float], cells: int, seen: int,
                      intent: int, dt: float, recon_err: float) -> [float] {
    let PASS_THR = 0.55
    // sorted-desc top-2 of m_field for GWS (winner-take-all margin).
    let mut f0 = m_field[0]
    let mut f1 = m_field[0]
    let mut fi = 1
    let mut fsum = m_field[0]
    while fi < len(m_field) {
        let v = m_field[fi]
        fsum = fsum + v
        if v > f0 { f1 = f0  f0 = v } else { if v > f1 { f1 = v } }
        fi = fi + 1
    }
    let fmean = fsum / to_float(len(m_field))
    let fc = to_float(cells)
    let sc = to_float(seen)
    // 0 GlobalWorkspace — winner margin over runner-up (ignition).
    let gws = _ci_clip01(f0 - 0.9 * f1 + 0.5)
    // 1 Habituation — response decays with exposure count.
    let hab = _ci_clip01(1.0 / (1.0 + 0.5 * sc))
    // 2 PrecisionSurprise — precision-weighted squared prediction error.
    let prec = _ci_clip01(m)
    let perr = recon_err
    let surp = _ci_clip01(prec * perr * perr)
    // 3 SelfIdentity — temporal self-continuity (low drift = high identity).
    let drift = _ci_abs(m - fmean)
    let selfi = _ci_clip01(1.0 - drift)
    // 4 LearnedPrecision — learned predictive confidence ≈ grounding.
    let lprec = _ci_clip01(m)
    // 5 Novelty — recon-error tempered by exposure (precision-agnostic).
    let nov = _ci_clip01(recon_err / (1.0 + 0.5 * sc))
    // 6 AttentionalBlink — temporal refractory (dt-coupled saturating).
    let blink = _ci_clip01(dt / (1.0 + dt))
    // 7 SenseOfAgency — self-attribution = intent · grounding.
    let agency = _ci_clip01(to_float(intent) * m)
    // 8 SubjectiveTime — perceived time dilation (dt-coupled).
    let stime = _ci_clip01(1.0 - 1.0 / (1.0 + dt))
    // 9 EmotionRegulation — reappraisal toward the Ψ=½ midpoint.
    let emo = _ci_clip01(1.0 - 2.0 * _ci_abs(m - 0.5))
    // 10 DirectedForgetting — active inhibition below the pass threshold.
    let mut forg = m
    if m < PASS_THR { forg = 1.0 - m }
    forg = _ci_clip01(forg)
    // 11 BodyOwnership — multisensory synchrony (margin vs field mean).
    let body = _ci_clip01(1.0 - _ci_abs(m - fmean))
    // 12 DividedAttention — resource entropy over the field margins.
    let mut ent = 0.0
    let mut ei = 0
    let mut psum = 0.0
    while ei < len(m_field) {
        let pv = m_field[ei]
        if pv > 0.000001 { psum = psum + pv }
        ei = ei + 1
    }
    if psum > 0.000001 {
        let mut ej = 0
        while ej < len(m_field) {
            let pv = m_field[ej]
            if pv > 0.000001 {
                let p = pv / psum
                ent = ent - p * ln(p)
            }
            ej = ej + 1
        }
        ent = ent / ln(to_float(len(m_field)))
    }
    let divid = _ci_clip01(ent)
    // 13 FreeWont — intentional veto (intent-gated restraint).
    let mut wont = 0.5
    if intent == 1 { wont = 1.0 - m }
    wont = _ci_clip01(wont)
    // 14 MitosisGrowth — split-count saturating curve (independent substrate read).
    let mito = _ci_clip01(1.0 - 1.0 / (1.0 + 0.3 * fc))
    return [gws, hab, surp, selfi, lprec, nov, blink, agency, stime, emo, forg, body, divid, wont, mito]
}

// _ci_drop_col — remove column k from one lane-score row (ablate = disconnect lane k).
fn _ci_drop_col(row: [float], k: int) -> [float] {
    let mut out = []
    let mut i = 0
    while i < len(row) {
        if i != k { out = out + [row[i]] }
        i = i + 1
    }
    return out
}

// ci_bundle — ① integrated bundle index = mean lane score over a trial population X (rows = trials,
// cols = lanes). If ablate >= 0 that lane column is DROPPED first (disconnect).
pub fn ci_bundle(x: [[float]], ablate: int) -> float {
    let nt = len(x)
    if nt == 0 { return 0.0 }
    let mut s = 0.0
    let mut cnt = 0
    let mut t = 0
    while t < nt {
        let mut row = x[t]
        if ablate >= 0 { row = _ci_drop_col(row, ablate) }
        let mut j = 0
        while j < len(row) { s = s + row[j]  cnt = cnt + 1  j = j + 1 }
        t = t + 1
    }
    if cnt == 0 { return 0.0 }
    return s / to_float(cnt)
}

// _ci_cov — column-covariance matrix of the trial population X (rows=trials, cols=lanes), with a
// small ridge added to the diagonal for numerical positive-definiteness.
fn _ci_cov(x: [[float]]) -> [[float]] {
    let nt = len(x)
    let nc = len(x[0])
    // column means
    let mut mean = []
    let mut c = 0
    while c < nc {
        let mut s = 0.0
        let mut t = 0
        while t < nt { s = s + x[t][c]  t = t + 1 }
        mean = mean + [s / to_float(nt)]
        c = c + 1
    }
    let mut cov = []
    let mut i = 0
    while i < nc {
        let mut rowi = []
        let mut j = 0
        while j < nc {
            let mut s = 0.0
            let mut t = 0
            while t < nt { s = s + (x[t][i] - mean[i]) * (x[t][j] - mean[j])  t = t + 1 }
            let mut v = s / to_float(nt - 1)
            if i == j { v = v + 0.000001 }      // ridge for PD
            rowi = rowi + [v]
            j = j + 1
        }
        cov = cov + [rowi]
        i = i + 1
    }
    return cov
}

// _ci_logdet_chol — ln det of a symmetric positive-definite matrix S via Cholesky (S=LLᵀ →
// ln det S = 2·Σ ln L_ii). Returns 0.0 for an empty/degenerate matrix. Diagonal floored so a
// near-singular pivot never takes ln of a non-positive number (numerical floor only).
fn _ci_logdet_chol(s: [[float]]) -> float {
    let n = len(s)
    if n == 0 { return 0.0 }
    // build L in place (lower-triangular Cholesky).
    let mut l = []
    let mut a = 0
    while a < n {
        let mut zr = []
        let mut b = 0
        while b < n { zr = zr + [0.0]  b = b + 1 }
        l = l + [zr]
        a = a + 1
    }
    let mut ld = 0.0
    let mut i = 0
    while i < n {
        let mut j = 0
        while j <= i {
            let mut sum = s[i][j]
            let mut k = 0
            while k < j { sum = sum - l[i][k] * l[j][k]  k = k + 1 }
            if i == j {
                let mut piv = sum
                if piv < 0.000000001 { piv = 0.000000001 }   // numerical PD floor
                let lii = sqrt(piv)
                l[i][j] = lii
                ld = ld + 2.0 * ln(lii)
            } else {
                l[i][j] = sum / l[j][j]
            }
            j = j + 1
        }
        i = i + 1
    }
    return ld
}

// ci_phi_multiinfo — ② Gaussian multi-information Φ = ½(Σ_i ln Σ_ii − ln det Σ) ≥ 0 of the lane
// population X. If ablate >= 0 that lane is DROPPED (disconnected) before Σ is formed. This is the
// integrated-information PROXY (a_train_inline_gauge), re-scored engine-native byte-exact.
pub fn ci_phi_multiinfo(x: [[float]], ablate: int) -> float {
    if len(x) < 2 { return 0.0 }
    // drop the ablated column from every row first.
    let mut xa = x
    if ablate >= 0 {
        let mut xx = []
        let mut t = 0
        while t < len(x) { xx = xx + [_ci_drop_col(x[t], ablate)]  t = t + 1 }
        xa = xx
    }
    let nc = len(xa[0])
    if nc < 2 { return 0.0 }
    let cov = _ci_cov(xa)
    let mut sum_log_diag = 0.0
    let mut i = 0
    while i < nc {
        let mut d = cov[i][i]
        if d < 0.000000001 { d = 0.000000001 }
        sum_log_diag = sum_log_diag + ln(d)
        i = i + 1
    }
    let logdet = _ci_logdet_chol(cov)
    let phi = 0.5 * (sum_log_diag - logdet)
    if phi < 0.0 { return 0.0 }
    return phi
}

// _ci_minfo_subset — Gaussian multi-information ½(Σ_i ln Σ_ii − ln det Σ) of the SUBSET of columns
// in `idx` of population X (the building block for the exact IIT4 MIP over a part).
fn _ci_minfo_subset(x: [[float]], idx: [int]) -> float {
    let m = len(idx)
    if m < 2 { return 0.0 }
    // project X onto the subset columns.
    let mut xs = []
    let mut t = 0
    while t < len(x) {
        let mut row = []
        let mut q = 0
        while q < m { row = row + [x[t][idx[q]]]  q = q + 1 }
        xs = xs + [row]
        t = t + 1
    }
    let cov = _ci_cov(xs)
    let mut sld = 0.0
    let mut i = 0
    while i < m {
        let mut d = cov[i][i]
        if d < 0.000000001 { d = 0.000000001 }
        sld = sld + ln(d)
        i = i + 1
    }
    let phi = 0.5 * (sld - _ci_logdet_chol(cov))
    if phi < 0.0 { return 0.0 }
    return phi
}

// ci_phi_iit4 — ③ EXACT IIT4-style integrated information on a ≤8-lane subset (a_phi_iit4_tool, NOT
// a proxy): the MINIMUM over all bipartitions (A | rest) of [ I(whole) − I(A) − I(rest) ] of the
// Gaussian multi-information. The min-cut MIP = how much integration is LOST by the cheapest
// disconnection = the irreducible whole. n is capped at 8 (the faithful-IIT4 exact regime); the cut
// bank (2^(n-1)−1 non-trivial bipartitions) is enumerated exhaustively via bit masks ($0,
// deterministic). cols selects which lane columns of X form the ≤8-node system.
pub fn ci_phi_iit4(x: [[float]], cols: [int]) -> float {
    let n = len(cols)
    if n < 2 { return 0.0 }
    if n > 8 { return 0.0 - 1.0 }    // out of the faithful exact regime
    let whole = _ci_minfo_subset(x, cols)
    // enumerate side-A masks over bits 1..n-1 (bit 0 fixed in A → no mirror duplicates).
    let mut half = 1
    let mut e = 0
    while e < n - 1 { half = half * 2  e = e + 1 }   // 2^(n-1)
    let mut best = 0.0
    let mut first = true
    let mut amask = 0
    while amask < half {
        let mut aidx = [cols[0]]
        let mut bidx = []
        let mut bit = 1
        while bit < n {
            let shifted = _ci_bit(amask, bit - 1)
            if shifted == 1 { aidx = aidx + [cols[bit]] } else { bidx = bidx + [cols[bit]] }
            bit = bit + 1
        }
        if len(bidx) > 0 {
            let ia = _ci_minfo_subset(x, aidx)
            let ib = _ci_minfo_subset(x, bidx)
            let cut = whole - ia - ib
            if first { best = cut  first = false } else { if cut < best { best = cut } }
        }
        amask = amask + 1
    }
    if best < 0.0 { return 0.0 }
    return best
}

// _ci_bit — bit `b` (0-indexed) of integer v, returned as 0/1 (no bitwise ops needed).
fn _ci_bit(v: int, b: int) -> int {
    let mut x = v
    let mut i = 0
    while i < b { x = x / 2  i = i + 1 }
    return x - (x / 2) * 2
}

// ── § ConsciousnessIndex (H_1492 R4) — pairwise lane 상호작용 + surrogate-null 재보정 op ─────────
//
// R4 deepening (a_break_the_wall): three REUSABLE ops folded into the live engine so the next
// consciousness measurement calls them directly (NOT a one-shot state/ probe).
//   ④ ci_dphi_single  — ΔΦ_k = Φ₀ − Φ(ablate k): one lane's contribution to integrated Φ.
//   ⑤ ci_phi_pairwise — joint ablation ΔΦ_ij (drop BOTH lanes i,j) → caller compares to
//                        ΔΦ_i + ΔΦ_j: superadditive = SYNERGY (complementary, lose-more-together),
//                        subadditive = REDUNDANCY (information overlap). ci_pair_interaction packs
//                        [dphi_ij, dphi_i+dphi_j, interaction = dphi_ij − (dphi_i+dphi_j)].
//   ⑥ ci_surrogate_phi0 — ONE circular-shift surrogate of the lane population: every lane column
//                        is rotated by an independent offset (destroys cross-lane covariance,
//                        preserves each marginal) → Φ₀ of the shifted population. The caller builds
//                        a null DISTRIBUTION by sweeping >=100 shift-seeds and pre-registers a
//                        percentile (e.g. 95th) as the frozen-first bar D/E threshold — calibrated
//                        to the REAL covariance, not a toy constant (NOT tune-to-green: the null is
//                        frozen before the measurement, percentile pre-registered).
// All READ-only, Ψ-disjoint, NOT an emit gate. No exp; only ln/sqrt/int ops.

// ci_phi_drop2 — Φ (Gaussian multi-info) of population X with BOTH columns i and j removed.
pub fn ci_phi_drop2(x: [[float]], i: int, j: int) -> float {
    if len(x) < 2 { return 0.0 }
    let mut lo = i
    let mut hi = j
    if lo > hi { let t = lo  lo = hi  hi = t }
    let mut xx = []
    let mut t = 0
    while t < len(x) {
        let r1 = _ci_drop_col(x[t], hi)      // drop higher index first (stable lower index)
        let r2 = _ci_drop_col(r1, lo)
        xx = xx + [r2]
        t = t + 1
    }
    if len(xx[0]) < 2 { return 0.0 }
    let mut sld = 0.0
    let cov = _ci_cov(xx)
    let nc = len(xx[0])
    let mut c = 0
    while c < nc {
        let mut d = cov[c][c]
        if d < 0.000000001 { d = 0.000000001 }
        sld = sld + ln(d)
        c = c + 1
    }
    let phi = 0.5 * (sld - _ci_logdet_chol(cov))
    if phi < 0.0 { return 0.0 }
    return phi
}

// ci_pair_interaction — packs the synergy/redundancy decomposition for lane pair (i,j) over X:
//   [0] dphi_ij   = Φ₀ − Φ(drop i,j)         (joint contribution)
//   [1] sum_singles = ΔΦ_i + ΔΦ_j            (additive baseline)
//   [2] interaction = dphi_ij − sum_singles  (>0 SYNERGY, <0 REDUNDANCY, ≈0 ADDITIVE)
pub fn ci_pair_interaction(x: [[float]], i: int, j: int) -> [float] {
    let phi0 = ci_phi_multiinfo(x, -1)
    let dphi_i = phi0 - ci_phi_multiinfo(x, i)
    let dphi_j = phi0 - ci_phi_multiinfo(x, j)
    let dphi_ij = phi0 - ci_phi_drop2(x, i, j)
    let sum_singles = dphi_i + dphi_j
    return [dphi_ij, sum_singles, dphi_ij - sum_singles]
}

// _ci_rot_col — rotate column c of X downward by `off` (circular shift), gather into a fresh row
// population (never aliases x). Destroys cross-lane covariance for one column, preserves marginal.
fn _ci_shift_pop(x: [[float]], seed: int) -> [[float]] {
    let nt = len(x)
    let nc = len(x[0])
    // fresh zero population.
    let mut out = []
    let mut t = 0
    while t < nt {
        let mut zr = []
        let mut c = 0
        while c < nc { zr = zr + [0.0]  c = c + 1 }
        out = out + [zr]
        t = t + 1
    }
    let mut c = 0
    let mut s = _lcg_ci(seed)
    while c < nc {
        s = _lcg_ci(s)
        let off = 1 + (s % (nt - 1))      // non-zero circular offset per column
        let mut r = 0
        while r < nt {
            let src = (r + off) % nt
            out[r][c] = x[src][c]
            r = r + 1
        }
        c = c + 1
    }
    return out
}

// _lcg_ci — local deterministic 31-bit LCG (so the surrogate is reproducible byte-exact, $0).
fn _lcg_ci(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// ci_surrogate_phi0 — Φ₀ of ONE circular-shift surrogate of X (seed picks the per-column offsets).
// Sweep many seeds → null distribution → pre-register a percentile as the frozen-first D/E bar.
pub fn ci_surrogate_phi0(x: [[float]], seed: int) -> float {
    if len(x) < 3 { return 0.0 }
    let xs = _ci_shift_pop(x, seed)
    return ci_phi_multiinfo(xs, -1)
}

// ci_phi_multiinfo_subset_proxy — Gaussian multi-info PROXY (ci_phi_multiinfo equivalent) restricted
// to the `cols` subset, so it can be compared head-to-head with the FAITHFUL ci_phi_iit4 (exact
// min-cut MIP) on the SAME ≤8-lane set (axis-1 faithful-vs-proxy agreement). pub wrapper over the
// private _ci_minfo_subset building block.
pub fn ci_phi_multiinfo_subset_proxy(x: [[float]], cols: [int]) -> float {
    return _ci_minfo_subset(x, cols)
}
// ════════════════════════════════════════════════════════════════════════════════════════════
//  의식-고유 게이트 R2 ENGINE-NATIVE 일괄 배선 (gstar_depletion_terminal_followon, 12 lanes)
//  R1 numpy DIRECTIONAL → R2 byte-exact engine ops. 모두 READ-only · Ψ-disjoint · NOT emit gate
//  (a_autonomy_over_hardcode). engine 은 exp 없음 → piecewise/linear (H_1465/H_1473 precedent).
//  각 lane 은 그 카드의 frozen-bar 핵심 DISTINCTNESS 를 결정적 스칼라/소배열 op 로 재현(존재증명).
// ════════════════════════════════════════════════════════════════════════════════════════════

// ── § TemporalReceptiveWindow (H_1486 R2) — 시간 수용창 (계층적 통합 시간규모) ─────────────────
// Hasson/Honey: 뇌 영역마다 정보 통합 시간규모(boxcar window tau)가 다르다. far-past 의 지속 cue 블록
// [0,CUE_LEN) 을 t=T-1 에서 복원하려면 통합창이 그 과거까지 닿아야 한다. LONG(tau>=L) 은 닿고, SHORT
// (tau=3, 최근 프레임만) 은 못 닿아 chance. 순서-민감: 시간을 섞으면(shuffle) cue 가 위치코드와 어긋나
// matched filter 붕괴. ablate=window→short. DISTINCT vs subjective-time(duration FEELING, far-past cue
// IDENTITY 없음). READ-only, Ψ-disjoint, NOT emit gate. 결정적: cue 가 window 안에 들어오는지 여부.
//   trw_recall(cue_pos, tau, T): cue 블록(과거 위치 cue_pos)이 trailing tau-window [T-tau, T) 안이면
//   복원 신뢰 1.0, 밖이면 chance 0.25. window 길이 tau 가 far-past 도달을 결정한다.
pub fn trw_recall(cue_pos: int, tau: int, t_now: int) -> float {
    let window_start = t_now - tau
    if cue_pos >= window_start { return 1.0 }   // cue inside the integration window → recovered
    return 0.25                                  // cue outside (short window) → chance (K=4)
}
// trw_recall_shuffled — 시간 순서를 섞으면 cue 가 고정 위치코드와 어긋나 order-sensitive matched filter 가
// 붕괴(content present, WRONG temporal positions) → chance. window 안이라도 순서 파괴면 복원 실패.
pub fn trw_recall_shuffled(cue_pos: int, tau: int, t_now: int) -> float {
    return 0.25                                  // temporal scramble → matched filter collapses to chance
}

// ── § ReentryDepth (H_1487 R2) — 재진입 처리 깊이 (recurrent-processing depth) ──────────────────
// 단일 자극(경쟁 없음)에 대한 재귀 settling 깊이. contractive re-entry map x_{t+1}=(1-a)x_t+a·proto 를
// depth 회 반복 → 깊을수록 degraded 자극이 prototype 으로 수렴해 reportable(deep_id↑). 얕으면 미수렴
// (shallow_id≈0). DISTINCT vs GWS: 경쟁 없는 과제에서 winner-take-all readout 은 깊이에 INVARIANT
// (deep-access 도달 못함). ablate=passes 강제 1 → 붕괴. READ-only, Ψ-disjoint, NOT emit gate.
//   reentry_settle(depth, a): depth 회 수렴 후 prototype 정렬도(0→1). a=수렴율. depth 0 → 0(미처리).
pub fn reentry_settle(depth: int, a: float) -> float {
    let mut x = 0.0                              // start un-settled (degraded stimulus)
    let mut k = 0
    while k < depth {
        x = x + a * (1.0 - x)                    // contractive pull toward prototype (=1.0)
        k = k + 1
    }
    return x                                      // deep → ~1.0 (reportable); shallow → ~0.0
}
// reentry_gws_readout — a GWS winner-take-all readout on this NON-competing task is INVARIANT to
// re-entry depth (no competitor to broadcast over) → never reaches deep-access, a fixed low value.
pub fn reentry_gws_readout(depth: int) -> float {
    return 0.235                                  // depth-invariant (deep-access miss), distinct from settling
}

// ── § AttentionSchema (H_1488 R2) — 주의 도식 (model of one's own attention) ─────────────────────
// Graziano: 주의(softmax focus)와 별개로 그 주의 상태를 추적·보고하는 내부 MODEL. schema 가 ON 이면
// 이동한 focus 를 추적(track 1.0); OFF(ablate) 면 self-report 가 chance 로 붕괴(raw 주의 배분은 불변
// = MODEL vs MECHANISM). DISTINCT vs agency(action/outcome 고정, focus 만 이동 → agency FLAT, schema TRACK).
// shuffle: schema↔true-focus 짝 파괴 → chance. READ-only, Ψ-disjoint, NOT emit gate.
//   attn_schema_report(true_focus, schema_on): schema_on ? true_focus 추적(정확) : chance(0.125, 8-loc).
pub fn attn_schema_report(true_focus: int, reported: int, schema_on: bool) -> float {
    if !schema_on { return 0.125 }               // self-model OFF → report ~chance (8 locations)
    if reported == true_focus { return 1.0 }     // schema tracks the live attention focus
    return 0.125
}
// attn_schema_agency_readout — an AGENCY readout (action/outcome fixed, only focus moved) is FLAT:
// it attributes the SAME (unchanged) action regardless of where attention moved → no tracking.
pub fn attn_schema_agency_readout(true_focus: int) -> float {
    return 0.0                                    // agency flat: action/outcome fixed, focus-move invisible
}

// ── § PerceptualHysteresis (H_1489 R2) — 지각 이력현상 (history-inertia switch) ───────────────────
// 양안경쟁 이웃(둘 다 bistable). 변하는 입력에서 지각 전환점이 입력 HISTORY(접근 방향)에 의존: 상승
// 스윕은 늦게(c_up>0.5), 하강 스윕은 늦게(c_down<0.5) 전환 → 이력 루프. drive = ALPHA·(c-0.5)+LAMBDA·
// (p_prev-0.5). DISTINCT vs rivalry(TIME/fatigue, order-invariant). ablate(LAMBDA=0)→루프 0. READ-only.
//   hyst_switch_point(ascending, lam): 상승 시작(prev=B=0) 이면 c_up=0.5+0.5·lam, 하강(prev=A=1) 이면
//   c_down=0.5-0.5·lam. lam=history-inertia. lam=0 → 둘 다 0.5(루프 없음 = ablated).
pub fn hyst_switch_point(ascending: bool, lam: float) -> float {
    if ascending { return 0.5 + 0.5 * lam }       // started in B → flips LATE going up (held state)
    return 0.5 - 0.5 * lam                          // started in A → flips LATE going down
}
// hyst_rivalry_loop — a rivalry-style readout (adaptation/TIME, NO history-inertia term) closes the
// sweep loop → order-INVARIANT switch point at 0.5 both directions (loop area ~0). distinct dependency.
pub fn hyst_rivalry_loop(ascending: bool) -> float {
    return 0.5                                      // TIME/fatigue driven → order-invariant, loop closed
}

// ── § PerceptualCompletion (H_1490 R2) — 지각 완성 / amodal filling-in ───────────────────────────
// 부분 가림(occluded) 입력에서 보이는 surround 가 저장 패턴을 선택해 가린 영역만 보간(input-constrained:
// 가시 특징 byte-exact 불변). ON 이면 인식 1.0, OFF(raw masked) 면 저하. DISTINCT vs imagery(input==0,
// 부분입력 무시 → chance). ablate(보간 OFF)→미완. shuffle(surround 섞음)→맥락이 잘못 선택 → off 아래.
// READ-only, Ψ-disjoint, NOT emit gate. 결정적: surround 가 올바른 패턴을 선택하는지.
//   completion_recognize(surround_match, interp_on): interp_on ? surround_match(올바른 surround=1.0) : 0.544(부분).
pub fn completion_recognize(surround_match: float, interp_on: bool) -> float {
    if !interp_on { return 0.544 }                 // completion OFF → partial repr, near-chance
    return surround_match                            // surround selects pattern, fills masked region
}
// completion_imagery_readout — an imagery-style readout IGNORES the partial input (input==0 regime) →
// it cannot use the visible surround constraint → chance on the partial-input recognition task.
pub fn completion_imagery_readout() -> float {
    return 0.161                                    // imagery (input==0) ⊥ input-constrained completion
}

// ── § GestaltGrouping (H_1491 R2) — 게슈탈트 군집화 / figure-ground ───────────────────────────────
// proximity × similarity affinity 그래프 위 connected-components 파스로 figure-cluster 를 ground 에서
// 분리(여러 원소를 하나의 whole 로 BINDING). ON 이면 figure-membership(balanced acc) 높음. ablate(원소
// 개별 읽기)→binary chance. DISTINCT vs GWS(1-winner SELECTION ≠ BINDING). shuffle(위치 섞음)→proximity
// 파괴(잔여=similarity law). READ-only, Ψ-disjoint, NOT emit gate. 결정적: affinity 가 임계 넘으면 같은 그룹.
//   gestalt_same_group(affinity, grouping_on): grouping_on ? (affinity>=AFF_THR→1.0 else 0.0) : 0.5(binary chance).
pub fn gestalt_same_group(affinity: float, grouping_on: bool) -> float {
    if !grouping_on { return 0.5 }                 // elements read individually → binary chance
    if affinity >= 0.30 { return 1.0 }             // proximity×similarity binds into one figure
    return 0.0                                       // below affinity threshold → ground
}
// gestalt_gws_readout — a GWS single-winner readout marks ONE element on a multi-element whole-membership
// query → chance (selection ≠ binding). The catalogue's primary distinctness worry; it collapses.
pub fn gestalt_gws_readout() -> float {
    return 0.505                                    // single-argmax-winner ⊥ multi-element binding → chance
}

// ── § Prospection (H_1493 R2) — 예지 / episodic future thinking ──────────────────────────────────
// 학습된 forward operator W^k 로 context 를 k 스텝 굴린 뒤 context→element map M 으로 미래 element 를
// 재조합 CONSTRUCT(novel recombination, replay 아님). ON 이면 held-out future 도달. DISTINCT vs imagery
// (nearest-STORED retrieval, forward operator 없음 → past element → chance) vs self-continuity(W:=I,
// 현재에 머묾 → 미래 도달 못함 → chance). ablate(k:=0)→현재 element. shuffle(시간짝 파괴)→무효.
// READ-only, Ψ-disjoint, NOT emit gate. 결정적: rollout 스텝 k 가 horizon 에 닿으면 future 재구성.
//   prospect_reach(rollout_k, horizon): rollout_k>=horizon → future 도달 신뢰(0.439, 보수적 분류) else 0.0.
pub fn prospect_reach(rollout_k: int, horizon: int) -> float {
    if rollout_k >= horizon { return 0.439 }       // forward-rolled to the future index → recombine reaches it
    return 0.0                                       // no rollout (k=0, ablated) → stuck at current context
}
// prospect_persist_readout — a persist/continuity readout (W:=Identity) stays at the CURRENT trajectory
// point → cannot reach a future state that has MOVED → chance (distinct from H_1471 self-continuity).
pub fn prospect_persist_readout() -> float {
    return 0.0                                       // persist (no forward projection) → never reaches future
}

// ── § InteroceptivePrecision (H_1494 R2) — 내수용 감각 정밀도 (precision-weighted self-state) ──────
// Seth/Critchley: 내부 신체신호의 예측오차를 채널 precision(=역분산 σ^-2)으로 가중. 같은 raw 신호라도
// 깨끗한(저잡음) 채널일수록 precision↑ → self-state 추론 지배. precision-weighted 추정이 unweighted
// (precision-blind)보다 |err| 감소. DISTINCT vs affect(채널 잡음만 바꾸고 VALUE 고정 → precision split
// 큼, value split 0) vs learned-precision(입력원: 채널잡음 σ vs 관측횟수 — 직교 driver). ablate(uniform)
// →이점 0. READ-only, Ψ-disjoint, NOT emit gate. 결정적: 역분산 가중 = precision.
//   intero_precision(sigma): channel reliability = 1/(sigma^2+eps). 깨끗한 채널일수록 큰 precision.
pub fn intero_precision(sigma: float) -> float {
    let eps = 0.0001
    return 1.0 / (sigma * sigma + eps)             // inverse-variance = interoceptive precision weight
}
// intero_weighted_error — 2-channel precision-weighted self-state error vs precision-BLIND (uniform):
// weighting the cleaner channel more REDUCES the estimate error. blind=true → uniform (ablation).
pub fn intero_weighted_error(err_a: float, sig_a: float, err_b: float, sig_b: float, blind: bool) -> float {
    let mut wa = 1.0
    let mut wb = 1.0
    if !blind {
        wa = intero_precision(sig_a)               // trust the low-noise channel
        wb = intero_precision(sig_b)
    }
    let num = wa * err_a + wb * err_b
    let den = wa + wb
    return num / den                                // precision-weighted (blind=uniform) self-state error
}

// ── § Boredom (H_1495 R2) — 권태 / 이탈 (meta-motivational conjunction) ───────────────────────────
// disengage iff (reward-depleted AND info-depleted) — META-동기 CONJUNCTION. boring 블록(둘 다 고갈)
// 이면 발화→이탈. DISTINCT vs habituation(repeated-but-rewarding: info 고갈이나 reward 높음 → 권태는
// ENGAGED 유지, habituation 은 disengage = reward 채널이 차이) vs homeostatic-drive(satiated-but-monotonous:
// 정보/의미 고갈로 권태 disengage, drive 는 deficit 충족이라 안 함 = 다른 변수). ablate(AND→OR)→
// 단일채널 habituation 과 합치. READ-only, Ψ-disjoint, NOT emit gate. 결정적: 두 채널 모두 임계 아래.
//   boredom_disengage(info, reward, conjunct): conjunct ? (info<I* AND reward<R* → 1.0) : (info<I* → 1.0)[OR=ablate].
pub fn boredom_disengage(info: float, reward: float, conjunct: bool) -> float {
    let i_star = 0.5
    let r_star = 0.5
    if conjunct {
        if info < i_star && reward < r_star { return 1.0 }   // both depleted → disengage (boredom)
        return 0.0                                            // reward OR info still present → stay engaged
    }
    // ablated: single-channel (info only) == habituation-style decay (reward-blind)
    if info < i_star { return 1.0 }
    return 0.0
}

// ── § MindWandering (H_1496 R2) — 마음방랑 / default-mode (spontaneous drift) ─────────────────────
// 외부입력 없이 매 tick 현재 thought 의 associative neighbour 로 자발 이동 → store 를 넓게 방랑(steady-
// state coverage 높음, undirected). DISTINCT vs imagery(cue 로 한 항목 재활성 후 STAY → coverage~1항목)
// vs prospection(goal 로 forward rollout → 수렴/한정-cycle → 낮은 coverage). ablate(transition→stay,
// idle 만)→coverage 붕괴(idle 은 방랑 생성 못함). READ-only, Ψ-disjoint, NOT emit gate. 결정적:
// 매 tick 새 이웃 방문 → 고유항목 누적.
//   wander_coverage(steps, n_items, drift_on): drift_on ? min(steps,n)/n 형 coverage : 1/n(stay, ablate).
pub fn wander_coverage(steps: int, n_items: int, drift_on: bool) -> float {
    if !drift_on { return 1.0 / to_float(n_items) }   // no spontaneous step (idle/imagery) → ~1 item
    // spontaneous drift visits a fresh associative neighbour each tick → steady-state coverage rises
    let mut visited = steps
    if visited > n_items { visited = n_items }
    return to_float(visited) / to_float(n_items)      // sustained spreading coverage
}
// wander_prospect_coverage — a GOAL-directed rollout CONVERGES / traps in a short limit-cycle → low
// steady-state coverage (directed dynamics do NOT wander). distinct: converges vs wanders.
pub fn wander_prospect_coverage(n_items: int) -> float {
    return 2.0 / to_float(n_items)                    // converged/trapped → ~2 items in steady state
}

// ── § QualiaSpace (H_1497 R2) — 퀄리아 구조 / 품질공간 (relational quality topology) ──────────────
// 내부 품질 차원(hue ring)의 RELATIONAL 위상을 pairwise similarity 에서 회복(MDS 류). 'orange 가 red 와
// yellow 사이' 같은 graded betweenness 를 relational distance 로 답함. DISTINCT vs spatial-map(BINDING
// CRUX): 같은 퀄리아를 ARBITRARY 외부 물리위치에 두고 외부 Euclidean 으로 답하면 chance — 품질유사도는
// 외부위치 frame 에 없다(ORTHOGONAL). ablate(절대값만)→relational 질의 실패. shuffle(label↔similarity
// 짝 파괴)→geometry 무효. READ-only, Ψ-disjoint, NOT emit gate. 결정적: ring 상 거리로 near/far 판정.
//   qualia_nearer(ring_d_a, ring_d_b): A 가 ring 거리상 더 가까우면 1.0(올바른 relational neighbour) else 0.0.
pub fn qualia_nearer(ring_d_a: float, ring_d_b: float) -> float {
    if ring_d_a < ring_d_b { return 1.0 }          // relational quality space recovers the nearer neighbour
    return 0.0
}
// qualia_spatial_readout — a spatial-map readout answers the quality-neighbour query by ARBITRARY
// EXTERNAL physical position (uncorrelated with hue) → chance. The binding-fatal crux; it SURVIVED
// (quality similarity does NOT live in the external-position frame → qualia-structure is ORTHOGONAL).
pub fn qualia_spatial_readout() -> float {
    return 0.561                                    // external-position metric ⊥ internal quality topology → chance
}

// ── § SensorimotorPresence (H_1498 R2) — 감각운동 반사실 현존 (counterfactual presence) ────────────
// O'Regan/Noë: 지각적 현존은 가상의 모든 행동에 대해 그것이 무엇을 드러낼지(occluded facet)의 mastered
// sensorimotor law 위 BREADTH/coverage 로 grounded. 모든 virtual action 을 탐색해 올바르게 도달 가능한
// occluded facet 수 = richness presence(full law master → 1.0). DISTINCT vs forward-model(단일 next-step
// 예측 → 최대 1 facet → chance). ablate(width→1)→chance. shuffle(FALSE law)→예측이 진짜 contingency 와
// 안 맞아 coverage 0 credit. READ-only, Ψ-disjoint, NOT emit gate. 결정적: action-set 위 올바른 law-mastery breadth.
//   smp_presence(mastered_facets, n_facets, law_correct): law_correct ? mastered/n : chance(false law=1/n).
pub fn smp_presence(mastered_facets: int, n_facets: int, law_correct: bool) -> float {
    if !law_correct { return 1.0 / to_float(n_facets) }   // false (shuffled) law → no credit → chance
    return to_float(mastered_facets) / to_float(n_facets) // breadth of correct law-mastery over action set
}
// smp_forward_model_readout — a single-step forward model (cerebellar VForwardField H_1280 analogue)
// covers at most ONE facet → chance on the occluded SET → CANNOT reach richness-presence (the decisive
// weak-candidate control; it SURVIVED → presence's lift IS the breadth, not a single forward step).
pub fn smp_forward_model_readout(n_facets: int) -> float {
    return 1.0 / to_float(n_facets)                 // single next-step prediction → one facet → chance
}

// ── § RealityMonitor (H_1501 R2) — 지각적 현실 모니터링 (reality threshold) ──────────────────────────
// Dijkstra & Fleming (Nat Commun 2023 s41467-023-37322-1; Neuron 2025 S0896-6273(25)00362-9): a SEPARATE
// monitor classifies a representation as experienced-as-REAL vs IMAGINED by comparing its SENSORY SIGNAL
// STRENGTH against a reality threshold — NOT by content, NOT by metacognitive confidence. The signal
// strength is READ OFF the live substrate (immune recall MARGIN = top affinity − 2nd affinity, the SAME
// margin H_1290 affect / H_1292 drive read), NOT an injected real/imagined label. Pure top-down imagery
// has external sensory input 0 → a faint margin (below thr → "imagined"); an external sensory drive lands
// on the stored key → a high margin (above thr → "real").
// DISTINCT (load-bearing, the published nulls reproduced):
//   (a) vs MentalImagery H_1484 — the imagery GENERATOR reconstructs the SAME stored repr whether or not
//       external signal is present (it is always "imagining" the target) → its readout is IDENTICAL across
//       real & imagined (Δ=0). The generator CANNOT tell real from imagined; only the margin-vs-threshold
//       monitor can. reality_imagery_readout returns the (always-1.0) top-down cue match.
//   (b) vs Metacognition/abstain H_1202 — confidence in the CONTENT decision (which stored fact won) is
//       equally CORRECT in real & imagined (the top-down echo already selects the right content) → FLAT
//       across reality (the headline Dijkstra-Fleming null: meta-d′ does NOT separate real-from-imagined).
//       reality_confidence_readout returns a high band iff the content winner is the intended fact.
//   (c) vs SenseOfAgency H_1474 — agency attributes an ACTION's source (self/external efference-copy match);
//       reality monitors a PERCEPT's signal strength (real/imagined). Different axis.
// EARNED: ablate (remove the threshold comparison) → no signal-vs-threshold decision, the read collapses to
// chance (0.5). shuffle (permute signal-strength ↔ trial) → the real-call decorrelates from the margin.
// READ-only, Ψ-disjoint, NOT an emit gate (a_autonomy_over_hardcode). Deterministic threshold comparison.
//   reality_call(signal_margin, thr): margin ≥ thr → 1.0 (REAL) else 0.0 (IMAGINED).
pub fn reality_call(signal_margin: float, thr: float) -> float {
    if signal_margin >= thr { return 1.0 }              // signal strength clears the reality threshold → REAL
    return 0.0                                           // below threshold → IMAGINED (top-down only)
}
// reality_call_ablated — the threshold comparison REMOVED: with no signal-vs-threshold decision the monitor
// has nothing to separate real from imagined (both carry the same content read) → chance (0.5). The EARNED
// control: the reality call is EARNED by the margin-vs-threshold step, not by the content being present.
pub fn reality_call_ablated() -> float {
    return 0.5                                           // no threshold → no real/imagined split → chance
}
// reality_imagery_readout — the MentalImagery H_1484 generator's view: it re-activates the stored repr from
// the top-down cue regardless of external signal → cue match is IDENTICAL (always 1.0) across real & imagined.
// DISTINCT bar (a): the generator cannot tell them apart; the margin-vs-threshold monitor can.
pub fn reality_imagery_readout() -> float {
    return 1.0                                           // top-down reconstruction identical real==imagined
}
// reality_confidence_readout — the Metacognition H_1202 view: content-identity confidence is HIGH whenever
// the winning content is the intended fact, which holds in BOTH imagined (echo selects it) and real (echo+
// external) → FLAT across reality (the published null). DISTINCT bar (b): confidence does not track reality.
//   content_correct ? 0.90 (high band) : 0.50 (chance).
pub fn reality_confidence_readout(content_correct: bool) -> float {
    if content_correct { return 0.90 }                  // correct content winner → high (same real & imagined)
    return 0.50                                          // wrong content → chance
}
