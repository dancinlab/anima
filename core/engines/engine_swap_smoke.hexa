// engines/engine_swap_smoke.hexa — runnable proof of the HOT-SWAPPABLE engine
// system (@L4). Loads ALL 3 engines (conv · cdv2 · hexad) THROUGH the CLI
// registry, runs a tiny forward on each, and asserts each conforms to the
// EngineSpec contract — flagging honest stubs where an engine lacks a single-call
// fn (a_core_engine_map — NO phantom wiring, NO fake pass).
//
// Proves deterministically ($0, CPU, no GPU, no LLM):
//   (a) the CLI registry resolves --engine conv|cdv2|hexad → the right adapter
//       (flag > env > default(conv) precedence, mirroring eeg_backend arg>env>def).
//   (b) each resolved engine exposes a 4-fn EngineSpec (load·forward·generate·
//       psi_coord) and CONFORMS (all 4 slots present + honestly labeled).
//   (c) a tiny forward runs on each engine through its adapter — native where the
//       impl is a single forward (conv), honest STUB where it is not (cdv2/hexad).
//
// @L4: engine SELECT is substrate-config — the smoke asserts CONFORMANCE +
// REGISTRY RESOLUTION, NEVER an emit/silence decision. No emit gate anywhere.
//
// usage:
//   hexa run engines/engine_swap_smoke.hexa
//   hexa run engines/engine_swap_smoke.hexa --engine cdv2
//   ANIMA_ENGINE=hexad hexa run engines/engine_swap_smoke.hexa

import "engines/engine_iface.hexa"
import "CORE/engine_cli.hexa"

fn _assert_b(label: string, want: bool, got: bool) -> bool {
    let ws = if want { "true" } else { "false" }
    let gs = if got  { "true" } else { "false" }
    if want == got {
        println("PASS  " + label + " want=" + ws + " got=" + gs)
        return true
    }
    println("FAIL  " + label + " want=" + ws + " got=" + gs)
    return false
}

fn _assert_s(label: string, want: string, got: string) -> bool {
    if want == got {
        println("PASS  " + label + " want=" + want + " got=" + got)
        return true
    }
    println("FAIL  " + label + " want=" + want + " got=" + got)
    return false
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0

    // ── (a) CLI REGISTRY RESOLVE: --engine flag > env > default(conv) ─────────
    let r_def   = engine_cli_resolve_engine([])
    let r_conv  = engine_cli_resolve_engine(["--engine", "conv"])
    let r_cdv2  = engine_cli_resolve_engine(["--engine", "cdv2"])
    let r_hexad = engine_cli_resolve_engine(["--engine", "hexad"])
    let r_omega = engine_cli_resolve_engine(["--engine", "omega"])
    let r_eq    = engine_cli_resolve_engine(["--engine=hexad"])
    // default tier is conv UNLESS ANIMA_ENGINE is set; assert resolver returns a
    // known engine for the default (env-tolerant), and exact for explicit flags.
    let def_known = r_def == "conv" || r_def == "cdv2" || r_def == "hexad" || r_def == "omega"
    if _assert_b("a1_default_resolves_known_engine", true, def_known) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_s("a2_flag_conv",  "conv",  r_conv)  { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_s("a3_flag_cdv2",  "cdv2",  r_cdv2)  { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_s("a4_flag_hexad", "hexad", r_hexad) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_s("a5_eq_form_hexad", "hexad", r_eq) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_s("a6_flag_omega", "omega", r_omega) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // ── (b+c) LOAD + FORWARD + CONFORM each of the 4 engines via the registry ─
    let names = ["conv", "cdv2", "hexad", "omega"]
    let mut k = 0
    while k < len(names) {
        let name = names[k]
        // LOAD through the CLI registry (engine NAME → adapter EngineSpec).
        let spec = engine_cli_spec_by_name(name)
        println("INFO  " + engine_spec_summary(spec))

        // (b) EngineSpec CONFORMANCE — all 4 fns present + honestly labeled.
        let conforms = engine_spec_conforms(spec)
        if _assert_b("b_" + name + "_conforms_EngineSpec", true, conforms) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
        // name slot round-trips through the registry.
        if _assert_s("b_" + name + "_name_roundtrip", name, to_string(spec["name"])) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

        // (c) tiny FORWARD on each engine through its adapter (honest path).
        if name == "conv" {
            let fwd = conv_tiny_forward(spec)
            // conv forward slot is NATIVE; the proof is the canonical impl is wired
            // (ckpt presence is environment-dependent, not asserted as required).
            if _assert_s("c_conv_forward_slot_native", "native", to_string(fwd["forward_slot"])) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            println("INFO  conv forward: ckpt_present=" + to_string(fwd["ckpt_present"]) + " (env-dependent; native slot regardless)")
        }
        if name == "cdv2" {
            let fwd = cdv2_tiny_forward(spec)
            // cdv2 forward is an HONEST STUB (torch .py, not a hexa single call).
            if _assert_s("c_cdv2_forward_slot_stub", "stub", to_string(fwd["forward_slot"])) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            if _assert_b("c_cdv2_canonical_present", true, fwd["canonical_present"]) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            println("INFO  cdv2 forward STUB: " + to_string(fwd["stub_reason"]))
        }
        if name == "hexad" {
            let fwd = hexad_tiny_forward(spec)
            // hexad forward is NOW NATIVE — the σ6 cross-module forward is a real
            // single call producing a real N=6 module-activation vector (TODO[wire]
            // RESOLVED, HEXAD/hexad_forward.hexa). generate stays an honest STUB.
            if _assert_s("c_hexad_forward_slot_native", "native", to_string(fwd["forward_slot"])) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            if _assert_b("c_hexad_canonical_present", true, fwd["canonical_present"]) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            // the forward EMITS a real N=6 module-activation vector.
            if _assert_b("c_hexad_forward_emits_6vec", true, fwd["n_modules"] == 6) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            println("INFO  hexad forward NATIVE: module_act=" + to_string(fwd["module_act"]) + " · d_input=" + to_string(fwd["d_input"]))
            println("INFO  hexad generate STUB: " + to_string(fwd["generate_stub_reason"]))
        }
        if name == "omega" {
            let fwd = omega_tiny_forward(spec)
            // omega forward is NATIVE — the coupling bus is a real hexa single forward.
            if _assert_s("c_omega_forward_slot_native", "native", to_string(fwd["forward_slot"])) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            // COUPLING NON-NULLITY: bus ON changes the decode (L1>0 = loop closed),
            // bus OFF is identity (L1==0 = the Lane X #1779 null). The headline proof.
            let l1_on  = fwd["coupling_l1_on"]
            let l1_off = fwd["coupling_l1_off"]
            if _assert_b("c_omega_coupling_on_nonnull", true, l1_on > 0.0) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            if _assert_b("c_omega_coupling_off_identity", true, l1_off == 0.0) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
            println("INFO  omega COUPLING: bus_on L1=" + to_string(l1_on) + " (loop CLOSED) · bus_off L1=" + to_string(l1_off) + " (identity = Lane X null) · wires=" + to_string(fwd["n_wires_on"]))
            println("INFO  omega scope: " + to_string(fwd["scope"]))
        }
        k = k + 1
    }

    // ── honest STUB MATRIX — surface which engines expose stubs (no fake pass) ─
    let conv_stub  = engine_spec_has_stub(conv_engine_spec())
    let cdv2_stub  = engine_spec_has_stub(cdv2_engine_spec())
    let hexad_stub = engine_spec_has_stub(hexad_engine_spec())
    let omega_stub = engine_spec_has_stub(omega_engine_spec())
    if _assert_b("d_conv_no_stub",   false, conv_stub)  { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_b("d_cdv2_has_stub",  true,  cdv2_stub)  { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_b("d_hexad_has_stub", true,  hexad_stub) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert_b("d_omega_no_stub",  false, omega_stub) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    println("INFO  STUB MATRIX — conv: " + (if conv_stub {"STUB"} else {"all-native"})
        + " · cdv2: " + (if cdv2_stub {"STUB (forward+generate)"} else {"all-native"})
        + " · hexad: " + (if hexad_stub {"STUB (generate only; forward NATIVE)"} else {"all-native"})
        + " · omega: " + (if omega_stub {"STUB"} else {"all-native (closure: bus forward)"}))

    println("--- engine_swap smoke summary: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
