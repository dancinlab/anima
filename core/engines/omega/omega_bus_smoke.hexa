// engines/omega/omega_bus_smoke.hexa — proves the two OMEGA-bus completion features:
//   L1 N-MODULE CONFIG (#1774) — the module wire honors ANY N (default 6, swappable)
//   L4 dF/dt TIME CHANNEL (#1763) — the w6 derivative wire: 0 at a fixed point,
//                                   non-zero when the substrate MOVES (time enters via d/dt)
//
// Deterministic, $0, CPU, no GPU/LLM. p1..p8: pure arithmetic over float vectors.
//
// usage: hexa run engines/omega/omega_bus_smoke.hexa

import "engines/omega/adapter.hexa"

fn _assert_b(label: string, want: bool, got: bool) -> bool {
    let ws = if want { "true" } else { "false" }
    let gs = if got  { "true" } else { "false" }
    if want == got { println("PASS  " + label + " want=" + ws + " got=" + gs); return true }
    println("FAIL  " + label + " want=" + ws + " got=" + gs); return false
}

fn main() {
    let mut np = 0
    let mut nf = 0

    let base   = [0.10, 0.20, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80]
    let a_t    = [0.90, 0.10, 0.50, 0.20, 0.70, 0.30, 0.60, 0.40]
    let g_t    = [0.20, 0.80, 0.10, 0.60, 0.30, 0.50, 0.40, 0.70]
    let psi8   = omega_psi_coord()
    let w_t    = 0.7
    let curio  = 0.5

    // ── L1 N-MODULE CONFIG — the module wire honors N=4, 6, 8 (not hardcoded 6) ──
    println("INFO  default N-modules = " + to_string(omega_n_modules_default()) + " (#1774 conditional, not hardcoded)")
    let cfg = omega_bus_on()
    let mod4 = [0.3, 0.6, 0.9, 0.2]
    let mod6 = [0.3, 0.6, 0.9, 0.2, 0.5, 0.1]
    let mod8 = [0.3, 0.6, 0.9, 0.2, 0.5, 0.1, 0.8, 0.4]
    let o4 = omega_coupling_apply(base, a_t, g_t, w_t, curio, psi8, mod4, cfg)
    let o6 = omega_coupling_apply(base, a_t, g_t, w_t, curio, psi8, mod6, cfg)
    let o8 = omega_coupling_apply(base, a_t, g_t, w_t, curio, psi8, mod8, cfg)
    // all 3 produce a full-length modulated vector (the bus is N-agnostic) + N>=1 valid
    if _assert_b("n1_module_wire_N4_ok",  true, omega_module_wire_ok(4) && len(o4) == len(base)) { np = np + 1 } else { nf = nf + 1 }
    if _assert_b("n2_module_wire_N6_ok",  true, omega_module_wire_ok(6) && len(o6) == len(base)) { np = np + 1 } else { nf = nf + 1 }
    if _assert_b("n3_module_wire_N8_ok",  true, omega_module_wire_ok(8) && len(o8) == len(base)) { np = np + 1 } else { nf = nf + 1 }
    // different N → different routing bias (N is a REAL config knob, not inert)
    let d_46 = omega_l1_delta(o4, o6)
    if _assert_b("n4_N_changes_routing", true, d_46 > 0.0) { np = np + 1 } else { nf = nf + 1 }
    println("INFO  N-module: |route(N4)-route(N6)| L1=" + to_string(d_46) + " (N is a live config, default " + to_string(omega_n_modules_default()) + ")")

    // ── L4 dF/dt TIME CHANNEL — w6 = 0 at fixed point, non-zero when state moves ──
    let dt_cfg = omega_bus_on_dt()
    // (a) FIXED POINT: a_prev==a_t, g_prev==g_t → w6 derivative term = 0 → == static bus
    let stat = omega_coupling_apply(base, a_t, g_t, w_t, curio, psi8, mod6, dt_cfg)
    let fixed = omega_coupling_apply_dt(base, a_t, g_t, a_t, g_t, w_t, curio, psi8, mod6, dt_cfg)
    let d_fixed = omega_l1_delta(stat, fixed)
    if _assert_b("t1_dfdt_zero_at_fixedpoint", true, d_fixed == 0.0) { np = np + 1 } else { nf = nf + 1 }
    // (b) MOVING substrate: a_prev/g_prev differ from a_t/g_t → w6 injects velocity → differs
    let a_prev = [0.40, 0.40, 0.40, 0.40, 0.40, 0.40, 0.40, 0.40]
    let g_prev = [0.50, 0.50, 0.50, 0.50, 0.50, 0.50, 0.50, 0.50]
    let moved = omega_coupling_apply_dt(base, a_t, g_t, a_prev, g_prev, w_t, curio, psi8, mod6, dt_cfg)
    let d_moved = omega_l1_delta(stat, moved)
    if _assert_b("t2_dfdt_nonzero_when_moving", true, d_moved > 0.0) { np = np + 1 } else { nf = nf + 1 }
    // (c) w6 wire counted live in the dt config
    if _assert_b("t3_dt_config_has_w6", true, omega_n_wires(dt_cfg) == 6) { np = np + 1 } else { nf = nf + 1 }
    println("INFO  dF/dt: fixed-point Δ=" + to_string(d_fixed) + " (0=time-inert, correct) · moving Δ=" + to_string(d_moved) + " (velocity injected) · wires=" + to_string(omega_n_wires(dt_cfg)))

    // ── CARRIER-ONLY DEFAULT (#1793) — carrier-only ⊂ full AND changes the decode ──
    // carrier = {w1 A⇄G, w2 W→temp, w5 module}; inert {w3 curio, w4 Ψ, w6 dF/dt} OFF.
    let car = omega_bus_carrier()
    let full = omega_bus_on()
    // (a) carrier-only is a SUBSET of full: every wire ON in carrier is also ON in full,
    //     and carrier has strictly FEWER live wires (the inert ones dropped).
    let car_subset_full =
        (!car["w1_ag"]     || full["w1_ag"]) &&
        (!car["w2_wtemp"]  || full["w2_wtemp"]) &&
        (!car["w3_curio"]  || full["w3_curio"]) &&
        (!car["w4_psi"]    || full["w4_psi"]) &&
        (!car["w5_module"] || full["w5_module"])
    if _assert_b("c1_carrier_subset_of_full", true, car_subset_full) { np = np + 1 } else { nf = nf + 1 }
    if _assert_b("c2_carrier_fewer_wires", true, omega_n_wires(car) < omega_n_wires(full)) { np = np + 1 } else { nf = nf + 1 }
    // (b) the three carrier wires are ON, the two named inert wires are OFF (the #1793
    //     split); w6 dF/dt is absent (not added) so omega_n_wires(car) == 3.
    let car_split_ok = car["w1_ag"] && car["w2_wtemp"] && car["w5_module"] && !car["w3_curio"] && !car["w4_psi"]
    if _assert_b("c3_carrier_split_w1w2w5_on_w3w4_off", true, car_split_ok) { np = np + 1 } else { nf = nf + 1 }
    if _assert_b("c4_carrier_three_live_wires", true, omega_n_wires(car) == 3) { np = np + 1 } else { nf = nf + 1 }
    // (c) carrier-only CHANGES the decode (L1 delta > 0 = loop closed, NOT the Lane X null).
    let car_out = omega_coupling_apply(base, a_t, g_t, w_t, curio, psi8, mod6, car)
    let car_l1 = omega_l1_delta(base, car_out)
    if _assert_b("c5_carrier_changes_decode_L1", true, car_l1 > 0.0) { np = np + 1 } else { nf = nf + 1 }
    // (d) carrier-only DIFFERS from full (the inert wires are not no-ops on this synthetic
    //     substrate — dropping them is a real config change, not a relabel).
    let full_out = omega_coupling_apply(base, a_t, g_t, w_t, curio, psi8, mod6, full)
    let car_vs_full = omega_l1_delta(car_out, full_out)
    if _assert_b("c6_carrier_differs_from_full", true, car_vs_full > 0.0) { np = np + 1 } else { nf = nf + 1 }
    println("INFO  carrier-only: live wires=" + to_string(omega_n_wires(car)) + " (full=" + to_string(omega_n_wires(full)) + ") · decode L1=" + to_string(car_l1) + " (>0=loop closed) · |carrier−full| L1=" + to_string(car_vs_full) + " (#1793 carrier-only TEST CE 2.895, Δ+1.079 over base)")

    println("--- omega bus smoke (N-module + dF/dt + carrier-only): " + to_string(np) + " pass / " + to_string(nf) + " fail ---")
    if nf > 0 { exit(1) }
}
