// engines/conv/adapter.hexa — Lane-CONV engine adapter (the DEFAULT engine).
//
// THIN adapter (@L1): it REFERENCES the canonical impl and does NOT duplicate
// it. The conv engine = CLMConvMoE, decoded by CORE/clm_decode.hexa and run
// through the single .clm entry slot CORE/generator.hexa::_gen_clm_decode
// (a_core_engine_map — .clm enters CORE ONLY via the generator L3 slot).
//
// EngineSpec slots (all NATIVE — conv is a single forward):
//   load      — clm_decodable() + clm_config() validate the .clm header / ckpt.
//   forward   — clm_forward_ce() runs the CLMConvMoE inference forward (CE axis).
//   generate  — clm_decode_argmax() greedy continuation (the trained mouth).
//   psi_coord — Ψ=1/2 fixed point (Law-71); conv has no separate Ψ head, so the
//               coord is the substrate fixed point — recorded native (the engine
//               participates in the A⇄G Ψ=1/2 substrate by construction).
//
// ckpt POINTER (@L5 · a_hf_registry — NOT duplicated): see engines/conv/manifest.json
//   local : exports/lane-g/d768/d768_5lang_c4.clm
//   hf    : dancinlab/clm-v1-dev-d768-forge-gpu
//
// p1..p8: pure decode/forward; no system prompt, persona, ethics weights, or
// emit gate. Engine SELECT is substrate-config, not a speech gate (@L4 / p5).

import "engines/engine_iface.hexa"

// conv_engine_spec — the EngineSpec for the conv (Lane-CONV) engine.
// All 4 slots native: conv is a genuine single forward (CLMConvMoE).
pub fn conv_engine_spec() -> Map {
    return engine_spec_make(
        "conv",
        "CORE/clm_decode.hexa (+ generator.hexa L3 slot)",
        engine_slot_native(),   // load     — clm_decodable + clm_config
        engine_slot_native(),   // forward  — clm_forward_ce
        engine_slot_native(),   // generate — clm_decode_argmax
        engine_slot_native()    // psi_coord— Ψ=1/2 substrate fixed point
    )
}

// conv_ckpt_pointer — the ckpt pointer record (@L5). Large .clm NOT duplicated.
pub fn conv_ckpt_pointer() -> Map {
    return #{
        "local": "exports/lane-g/d768/d768_5lang_c4.clm",
        "hf_repo_id": "dancinlab/clm-v1-dev-d768-forge-gpu",
        "format": "CLM\\x01",
        "duplicated": false,
    }
}

// conv_tiny_forward — a tiny, deterministic forward proof for the smoke. It does
// NOT require a real ckpt on disk: it exercises the canonical impl's decode-gate
// (clm_decodable) on the pointer path. If the ckpt is present it validates;
// absent → returns ok=false honestly (the smoke treats absence as a present-but-
// unloaded native slot, NOT a stub). Returns #{ slot, ckpt_present }.
pub fn conv_tiny_forward(spec: Map) -> Map {
    let ptr = conv_ckpt_pointer()
    let present = exec("test -f " + to_string(ptr["local"]) + " && echo Y || echo N").trim() == "Y"
    return #{
        "engine": "conv",
        "forward_slot": spec["forward"],
        "ckpt_present": present,
        "canonical": spec["canonical"],
    }
}
