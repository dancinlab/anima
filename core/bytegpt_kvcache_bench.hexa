// bytegpt_kvcache_bench.hexa — wall-time readout REF (O(gen²) full-forward) vs
// KV-cache (O(gen)) on the tiny fixture. NOT a verdict; just the speed evidence for
// the root-cause fix. Same fixture/seed as the byte-exact smoke.
import "core/decode.hexa"

fn gen_ref(W: Map, seed: list, gen: int, top_k: int, temp: float, seed_rng: int) -> int {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let mut rng = _g6_mix32(seed_rng)
    let mut g = 0
    while g < gen {
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let _ = farr_set(ids, p, to_float(toks[start + p])); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let sm = _g6_topk_sample(logits, vocab, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        let _ = farr_free(logits); let _ = farr_free(ids)
        toks.push(nb)
        g = g + 1
    }
    return len(toks)
}

fn gen_kv(W: Map, seed: list, gen: int, top_k: int, temp: float, seed_rng: int) -> int {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    let toks = []
    let mut i = 0
    while i < len(seed) { toks.push(to_int(seed[i])); i = i + 1 }
    let nseed = len(toks)
    let mut rng = _g6_mix32(seed_rng)
    let kv = _bg_kv_new(nlay, block, d)
    let mut logits = -1
    let mut sp = 0
    while sp < nseed {
        if logits >= 0 { let _ = farr_free(logits) }
        logits = _bg_kv_step(W, kv, to_int(toks[sp]), sp)
        sp = sp + 1
    }
    let mut g = 0
    while g < gen {
        let sm = _g6_topk_sample(logits, vocab, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        let _ = farr_free(logits)
        toks.push(nb)
        logits = _bg_kv_step(W, kv, nb, len(toks) - 1)
        g = g + 1
    }
    let _ = farr_free(logits)
    _bg_kv_free(kv)
    return len(toks)
}

fn main() {
    let bin = "/tmp/h1156_mount/bytegpt_tiny.bin"
    if exec("test -f '" + bin + "' && printf y || printf n") != "y" { println("[skip] no fixture"); return }
    let W = bg_load(bin)
    let seed = []
    let stext = "the quick brown fox "
    let mut si = 0
    while si < byte_len(stext) { seed.push(ord(substring(stext, si, si + 1))); si = si + 1 }
    let gen = 40   // nseed(20)+40 = 60 < block 64 → no slide, cache valid

    let t0 = exec("date +%s.%N")
    let _ = gen_ref(W, seed, gen, 8, 0.9, 4242)
    let t1 = exec("date +%s.%N")
    let _ = gen_kv(W, seed, gen, 8, 0.9, 4242)
    let t2 = exec("date +%s.%N")
    println("[bench] gen=" + to_string(gen) + " (d=64,L=2 fixture)")
    println("[bench] REF full-forward (O(gen^2)) t0=" + t0 + " t1=" + t1)
    println("[bench] KV-cache       (O(gen))   t1=" + t1 + " t2=" + t2)
    println("[bench] (subtract t1-t0 vs t2-t1; KV should be lower and the gap WIDENS with gen)")
}
