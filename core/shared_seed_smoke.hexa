// shared_seed_smoke.hexa — runnable proof of the H_6008 fork-time primitive.
//
// Reproduces the H_6008 verdict shape through the ACTUAL deployment surface
// (CORE/shared_seed.hexa), deterministically (p7: equality, not perplexity):
//   ARM1 shared-seed    — two forks of ONE loaded key coordinate 1.0 (zero comms)
//   ARM2 independent     — two keys from DIFFERENT ANU files ≈ chance (no shared cause)
//   ARM3 classical store  — reloading the LOCAL key file is byte-identical (replayable
//                          BECAUSE it is a local classical store, not a live ANU pull;
//                          H_6026 MS2)
//
// Uses real cached ANU vacuum buffers in /tmp/anu_*.bin. p1..p8 clean.

import "CORE/shared_seed.hexa"

// run a sequence of `n` choices over `k` options from a seed, return the picks.
fn _walk(seed: SharedSeed, n: int, k: int) -> [int] {
    let mut s = seed
    let mut out = []
    let mut i = 0
    while i < n {
        let r = shared_seed_choose(s, k)
        out = out + [r[0]]
        s = SharedSeed { bytes: s.bytes, cursor: r[1] }
        i = i + 1
    }
    return out
}

fn _match_frac(a: [int], b: [int]) -> float {
    let mut hit = 0
    let mut i = 0
    while i < len(a) {
        if a[i] == b[i] { hit = hit + 1 }
        i = i + 1
    }
    return to_float(hit) / to_float(len(a))
}

fn main() {
    let N = 40       // number of coordinated decisions
    let K = 4        // options per decision (4-way, as in H_6008)
    let mut pass = 0
    let mut fail = 0

    // ── ARM1 — SHARED: load one key, FORK it, both walk in lockstep ────────────
    let parent = shared_seed_load("/tmp/anu_all.bin")
    let childA = shared_seed_fork(parent)
    let childB = shared_seed_fork(parent)
    let a1 = _walk(childA, N, K)
    let b1 = _walk(childB, N, K)
    let coord_shared = _match_frac(a1, b1)
    println("ARM1 shared-seed   coordination=" + to_string(coord_shared)
        + "  (key=anu_all.bin, " + to_string(shared_seed_remaining(parent)) + "B, fork×2, 0 comms)")
    if coord_shared >= 0.999 { pass = pass + 1 } else { fail = fail + 1 }

    // ── ARM2 — INDEPENDENT: two keys from DIFFERENT ANU pulls ⇒ no shared cause ─
    let indepA = shared_seed_load("/tmp/anu_conf.bin")
    let indepB = shared_seed_load("/tmp/anu_free.bin")
    let a2 = _walk(indepA, N, K)
    let b2 = _walk(indepB, N, K)
    let coord_indep = _match_frac(a2, b2)
    println("ARM2 independent   coordination=" + to_string(coord_indep)
        + "  (≈1/K=" + to_string(1.0 / to_float(K)) + " chance, no shared cause)")
    if coord_indep < 0.50 { pass = pass + 1 } else { fail = fail + 1 }

    // ── ARM3 — CLASSICAL STORE: reload the LOCAL key, must be byte-identical ────
    let reload = shared_seed_load("/tmp/anu_all.bin")
    let r1 = _walk(shared_seed_fork(parent), N, K)
    let r2 = _walk(reload, N, K)
    let replay = _match_frac(r1, r2)
    println("ARM3 classical store reload-match=" + to_string(replay)
        + "  (LOCAL file replayable — store is classical, not live ANU; H_6026)")
    if replay >= 0.999 { pass = pass + 1 } else { fail = fail + 1 }

    // ── separation check — shared must DECISIVELY beat independent ──────────────
    let sep = coord_shared - coord_indep
    println("separation shared-indep=" + to_string(sep) + "  (H_6008 common-cause effect)")
    if sep >= 0.40 { pass = pass + 1 } else { fail = fail + 1 }

    println("--- shared_seed smoke summary: " + to_string(pass) + " pass / "
        + to_string(fail) + " fail ---")
}
