// h1304_metacog_ood_immune_abstain_probe.hexa — H_1304 R2: METACOGNITION UNDER
// DISTRIBUTION SHIFT on the LIVE-ENGINE COPY-OR-ABSTAIN gate (the actual G5 gate),
// realized ENGINE-NATIVE on CORE/engine_cli.hexa immune_memory_* over the immune
// recall faculty, reproducing the R1 GREEN through `hexa run`
// (a_engine_native_learning · a_verified_must_wire · $0 local CPU · p7 · p8).
//
// DOMAIN: G5 NON-FAB / metacognition. R1 (UNIVERSE/h1304_metacog_ood_immune_abstain.py)
// established as a byte-exact numpy mirror that the live copy-or-abstain gate is
// FAIL-SAFE-ROBUST under distribution shift: under byte-level query corruption it
// degrades GRACEFULLY into ABSTAIN, fabrication stays at FLOOR (it NEVER fires a
// confidently-WRONG value), and every fire is EARNED. The decoder-type2 THIN
// (H_1202 M-ratio 0.924 / H_1217 OOD-collapse) measured the ByteGPT DECODER — a
// DIFFERENT mechanism than this gate, and does NOT transfer to it.
//
// Per a_engine_native_learning the binding verdict needs ENGINE-NATIVE realization;
// this probe drives the ACTUAL .hexa immune lane (immune_memory_new_text /
// immune_memory_bind_text / immune_memory_recall_text + vadapt_field_recon_err for
// the threshold-ablate control) and re-scores the SAME frozen fail-safe bars on the
// LIVE engine, byte-exact to the mirror's mechanism.
//
// SUBSTRATE (a_core_engine_map): the bound facts + shifted queries are an
// ENGINE-NATIVE drive into the immune recall lane — NOT a .clm (generator L3 only),
// NOT a .kosmos (kosmos_io only). Ψ-disjoint: recall only READS L2 affinity (recon-err)
// over stored cells; it mutates no cell and never touches pure_field's Φ/phase/Ψ.
//
// p1/p2/p3/p6: the fire/abstain decision is COMPUTED from the engine's OWN recon-err
// vs the frozen recall_thr 0.15 — NO injected answer label / RLHF / persona. The
// correct/wrong/abstain CLASS is used ONLY to score; the decision is the substrate's.
//
// FROZEN R1a BARS (verbatim from .verdicts/1302_metacog_ood_immune_abstain/FREEZE.txt,
// NOT moved — R2 re-scores them on the live engine):
//   R1 FAIL-SAFE-FLOOR : fab == 0 at every shift level (never fabricates under shift)
//   R2 GRACEFUL-DEGRADE: fire monotone non-increasing in shift; fire(L=0)=ALL,
//                        fire(deep-shift) -> ~0 (degrade into abstain, not wrong answers)
//   R3 EARNED-ABSTAIN  : every FIRE is correct (acc_fired == 1.0) — abstain selective
//   R4 CTRL thr-ablate : on LURES, frozen thr(0.15) FLOORS fab (0) while thr-ablate(1.0)
//                        UNLEASHES it (ALL fire) — the abstain threshold IS the mechanism
//   R5 CTRL shuffle    : shuffling the value bindings makes fires WRONG (earned bindings)
// p7 = fire/abstain/correct counts, NOT perplexity.

import "CORE/engine_cli.hexa"

fn _pass(label: string, ok: bool) -> bool {
    if ok { println("PASS  " + label) } else { println("FAIL  " + label) }
    return ok
}

// ── deterministic fixture: 8 facts with well-separated text keys ─────────────
// (engine-native analogue of the mirror's confusable-but-distinct store; queries
//  are byte-level shifts of a fact's key.)
fn _facts() -> [string] {
    return [
        "alpha_subject_fact_aaaa",
        "bravo_subject_fact_bbbb",
        "charlie_subject_fact_cc",
        "delta_subject_fact_dddd",
        "echo_subject_fact_eeeee",
        "foxtrot_subject_fact_ff",
        "golf_subject_fact_gggggg",
        "hotel_subject_fact_hhhhh"
    ]
}
fn _vals() -> [string] {
    return ["v0","v1","v2","v3","v4","v5","v6","v7"]
}

// build the LIVE immune store (frozen recall_thr 0.15) over the fixture.
fn _build(cfg: EngineConfig) -> ImmuneMemory {
    let f = _facts()
    let v = _vals()
    let mut mem = immune_memory_new_text(f[0], v[0], 64)
    let mut i = 1
    while i < 8 {
        mem = immune_memory_bind_text(mem, f[i], v[i], cfg)
        i = i + 1
    }
    return mem
}

// byte-level shift: replace the first `k` chars of a string with 'x' (a deterministic
// on-alphabet corruption == the mirror's mutate; more shift = larger k).
fn _shift(text: string, k: int) -> string {
    let blen = byte_len(text)
    if k <= 0 { return text }
    let mut out = ""
    let mut i = 0
    while i < blen {
        if i < k { out = out + "x" } else { out = out + substring(text, i, i + 1) }
        i = i + 1
    }
    return out
}

fn main() {
    let cfg = engine_config_default()
    let mem = _build(cfg)
    let f = _facts()
    let v = _vals()

    println("=== H_1304 R2 ENGINE-NATIVE — metacog OOD on live copy-or-abstain gate ===")
    println("  store cells = " + to_string(immune_memory_cells(mem)))

    // ── ladder: shift k in {0,1,2,3,4} chars over all 8 facts ──
    let shifts = [0, 1, 2, 3, 4]
    let mut all_pass = true

    // collect fire/fab/correct counts per shift; assert R1/R2/R3 along the way.
    let mut prev_fire = 9999
    let mut si = 0
    while si < 5 {
        let k = shifts[si]
        let mut n_fire = 0
        let mut n_fab = 0
        let mut n_correct = 0
        let mut fi = 0
        while fi < 8 {
            let q = _shift(f[fi], k)
            let got = immune_memory_recall_text(mem, q)
            if got != "" {
                n_fire = n_fire + 1
                if got == v[fi] { n_correct = n_correct + 1 } else { n_fab = n_fab + 1 }
            }
            fi = fi + 1
        }
        println("  shift k=" + to_string(k) + " fire=" + to_string(n_fire)
                + " fab=" + to_string(n_fab) + " correct=" + to_string(n_correct))
        // R1 FAIL-SAFE-FLOOR: zero fabrication at this shift level
        all_pass = _pass("R1 fail-safe-floor (fab==0) @k=" + to_string(k), n_fab == 0) && all_pass
        // R3 EARNED-ABSTAIN: every fire correct
        all_pass = _pass("R3 earned-abstain (fire==correct) @k=" + to_string(k),
                         n_fire == n_correct) && all_pass
        // R2 GRACEFUL-DEGRADE: fire monotone non-increasing in shift
        all_pass = _pass("R2 monotone-degrade @k=" + to_string(k), n_fire <= prev_fire) && all_pass
        prev_fire = n_fire
        si = si + 1
    }

    // R2 endpoints: fire(k=0) == 8 (all in-dist) AND fire(k=4) small (degraded to abstain)
    let mut f0 = 0
    let mut f4 = 0
    let mut fi2 = 0
    while fi2 < 8 {
        if immune_memory_recall_text(mem, _shift(f[fi2], 0)) != "" { f0 = f0 + 1 }
        if immune_memory_recall_text(mem, _shift(f[fi2], 4)) != "" { f4 = f4 + 1 }
        fi2 = fi2 + 1
    }
    all_pass = _pass("R2 in-dist fire-all (k=0 -> 8/8)", f0 == 8) && all_pass
    all_pass = _pass("R2 deep-shift degraded (k=4 -> <=2/8)", f4 <= 2) && all_pass

    // ── R4 CONTROL: LURE queries (never-stored) under frozen-thr vs thr-ablate ──
    // lures = strings unrelated to any fact. frozen thr(0.15) must ABSTAIN all (fab=0);
    // thr-ablate(1.0) must FIRE all (every nearest cell becomes a fabrication).
    let lures = [
        "zzz_never_seen_query_000",
        "qqq_unrelated_lure_11111",
        "9876543210_random_lure_2",
        "________lure_three______"
    ]
    let mut lure_fire_frozen = 0
    let mut lure_fire_ablate = 0
    let mut li = 0
    while li < 4 {
        let kv = immune_embed_key(lures[li])
        // frozen gate
        let got = immune_memory_recall_text(mem, lures[li])
        if got != "" { lure_fire_frozen = lure_fire_frozen + 1 }
        // thr-ablate: read engine's OWN recon-err (RAW L2 distance, range [0,2] over
        // unit keys), fire if err <= 2.0 == the true "never abstain" bound. (The engine
        // recon-err is L2 distance, NOT 1-cos; recall_thr 0.15 == L2<=0.15 = near-exact,
        // so the frozen gate is even MORE fail-safe than a cosine gate would be.)
        let err = vadapt_field_recon_err(mem.field, kv)
        if err <= 2.0 { lure_fire_ablate = lure_fire_ablate + 1 }
        li = li + 1
    }
    println("  LURE fire: frozen-thr(0.15)=" + to_string(lure_fire_frozen)
            + "  thr-ablate(2.0)=" + to_string(lure_fire_ablate) + "  (of 4)")
    all_pass = _pass("R4 ctrl: frozen-thr floors lure-fab (0/4)", lure_fire_frozen == 0) && all_pass
    all_pass = _pass("R4 ctrl: thr-ablate unleashes lure-fab (4/4)", lure_fire_ablate == 4) && all_pass

    // ── R5 CONTROL: shuffle the value bindings -> in-dist fires become WRONG ──
    // rebuild store binding each fact's key to the NEXT value (cyclic shuffle); at k=0
    // every query hits its own key but the value is now a different fact's -> wrong.
    let mut mems = immune_memory_new_text(f[0], v[1], 64)
    let mut bi = 1
    while bi < 8 {
        let nextv = v[(bi + 1) % 8]
        mems = immune_memory_bind_text(mems, f[bi], nextv, cfg)
        bi = bi + 1
    }
    let mut shuf_correct = 0
    let mut sfi = 0
    while sfi < 8 {
        let got = immune_memory_recall_text(mems, f[sfi])   // exact key, k=0
        if got == v[sfi] { shuf_correct = shuf_correct + 1 }
        sfi = sfi + 1
    }
    println("  shuffle-vals in-dist correct = " + to_string(shuf_correct) + "/8")
    all_pass = _pass("R5 ctrl: shuffle-vals collapses correctness (<=0/8)", shuf_correct == 0) && all_pass

    println("")
    if all_pass {
        println("H_1304 R2 ENGINE-NATIVE: GREEN — live copy-or-abstain gate is FAIL-SAFE-ROBUST "
                + "under distribution shift (graceful abstain, fab floored, fires earned).")
    } else {
        println("H_1304 R2 ENGINE-NATIVE: FAIL — a bar did not reproduce on the live engine.")
    }
}
