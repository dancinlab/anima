// bytegpt_devres_smoke.hexa — P1b DEVICE-vs-HOST single-forward parity gate.
//
// The correctness gate for the device-resident decode overtake (hexa-lang
// #21-perf). Runs ONE forward on a fixed input two ways over the SAME loaded
// ranged weights W and compares the last-position logits:
//   (HOST)  bg_forward_last_W       — the mm reference (cuBLAS GEMM on a CUDA
//                                     host, host per-op D2H↔H2D glue).
//   (DEV)   bg_forward_last_W_dev   — the device-resident chain (ONE H2D embed,
//                                     ONE D2H logits; forge_dispatch_* + device
//                                     attention keep every activation on-device).
//
// EXPECTED: small max|Δ| — the device LayerNorm tree-reduction reassociates
// (~1e-16) and the device attention softmax uses the dt_exp Taylor mirror vs
// host libm exp (~1e-7), so max|Δ| ~1e-6..1e-7 AND IDENTICAL argmax (the engine
// verdict requirement). An O(1) max|Δ| or a flipped argmax = a layout / bias /
// transpose bug (do NOT chase byte-eq on the dt_exp softmax — P0-accepted).
//
// Also reports DEV run-to-run max|Δ| (two device forwards on the same input) as
// a determinism probe: >0 would flag a device-resident stream/atomic race.
//
// p7: verification is exact argmax equality + a logits max|Δ| readout, no
// loss/perplexity. Engine-native (live core/decode.hexa (unified CONV+BYTE)). Needs a CUDA
// host + the 303M h1129 fixture to exercise the real device path; on no-CUDA it
// still runs (dev path = CPU fallback) but only proves the host-mirror wiring.

import "core/decode.hexa"

// max|Δ| over the first `n` elements of two logit farrs.
fn _maxdiff(a: int, b: int, n: int) -> float {
    let mut md = 0.0
    let mut k = 0
    while k < n {
        let dv = farr_get(a, k) - farr_get(b, k)
        let av = if dv < 0.0 { 0.0 - dv } else { dv }
        if av > md { md = av }
        k = k + 1
    }
    return md
}

fn main() {
    // fixture path: scan argv for the first *.bin arg (index-0 script-path
    // tolerant); otherwise read the shared environment contract.
    let mut bin = to_string(env("ANIMA_BYTEGPT303_BIN"))
    let av = args()
    let mut ai = 0
    while ai < len(av) {
        let a = to_string(av[ai])
        let al = byte_len(a)
        if al > 4 && substring(a, al - 4, al) == ".bin" { bin = a }
        ai = ai + 1
    }
    if bin == "" { println("[devres-smoke] SKIP — pass a .bin path or set ANIMA_BYTEGPT303_BIN"); return }
    let have = exec("test -f '" + bin + "' && printf y || printf n") == "y"
    if !have {
        println("[devres-smoke] SKIP — no fixture at " + bin
            + " (pass the h1129.bin path as argv[1])")
        return
    }

    println("[devres-smoke] cuda_available = " + to_string(cuda_available()))
    let W = bg_load_ranged(bin)
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let nh = to_int(W["nh"]); let block = to_int(W["block"])
    println("[devres-smoke] loaded  vocab=" + to_string(vocab) + " d=" + to_string(d)
        + " nlay=" + to_string(nlay) + " nh=" + to_string(nh) + " block=" + to_string(block))

    // fixed input: a byte-id window (T = length, well under block so no slide).
    let stext = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs."
    let T = byte_len(stext)
    let ids = farr_zeros(T)
    let mut si = 0
    while si < T { let _ = farr_set(ids, si, to_float(ord(substring(stext, si, si + 1)))); si = si + 1 }
    println("[devres-smoke] input T=" + to_string(T))

    // HOST reference first (its mm path is disposition-neutral; keep it clean).
    let lh = bg_forward_last_W(W, ids, T)
    // DEVICE chain twice (parity + run-to-run determinism probe).
    let ld1 = bg_forward_last_W_dev(W, ids, T)
    let ld2 = bg_forward_last_W_dev(W, ids, T)

    let md_hd = _maxdiff(lh, ld1, vocab)
    let md_dd = _maxdiff(ld1, ld2, vocab)
    let ah = bg_argmax(lh, vocab)
    let ad1 = bg_argmax(ld1, vocab)
    let ad2 = bg_argmax(ld2, vocab)

    println("[devres-smoke] argmax  host=" + to_string(ah)
        + "  dev=" + to_string(ad1) + "  dev2=" + to_string(ad2))
    println("[devres-smoke] max|Δ| host-vs-dev  = " + to_string(md_hd))
    println("[devres-smoke] max|Δ| dev-vs-dev   = " + to_string(md_dd) + "  (0 = deterministic)")

    let argmax_match = (ah == ad1) && (ad1 == ad2)
    let _ = farr_free(lh); let _ = farr_free(ld1); let _ = farr_free(ld2); let _ = farr_free(ids)

    println("")
    if argmax_match {
        println("bytegpt_devres_smoke: PASS — device-resident forward argmax-matches the host mm "
            + "forward (host==dev==dev2 argmax=" + to_string(ah) + "; max|Δ| host-vs-dev="
            + to_string(md_hd) + ", dev-vs-dev=" + to_string(md_dd)
            + "). Expected small max|Δ| = LN reassoc + dt_exp softmax; an O(1) Δ would be a bug.")
    } else {
        println("bytegpt_devres_smoke: FAIL — argmax MISMATCH (host=" + to_string(ah)
            + " dev=" + to_string(ad1) + " dev2=" + to_string(ad2) + "; max|Δ| host-vs-dev="
            + to_string(md_hd) + "). O(1) max|Δ| ⇒ layout/bias/transpose bug in the device chain.")
    }
}
