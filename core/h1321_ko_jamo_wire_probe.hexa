// h1321_ko_jamo_wire_probe.hexa — ENGINE-NATIVE WIRING (r2) of the H_1316 🟢 GREEN ko-jamo
// breakthrough (a_verified_must_wire + a_engine_native_learning + a_core_engine_map).
//
// H_1316 (🟢 GREEN, PR #2224, numpy/torch MIRROR) proved a COMPOSITIONAL JAMO representation
// breaks the Korean raw-byte CE ceiling 2.953 → 2.513 (Δ −0.44), shuffle control 2.743 (earned),
// NFD↔NFC lossless. That was DIRECTIONAL — live CORE was UNTOUCHED. a_verified_must_wire: a
// GREEN-verified mechanism is NOT done until it RUNS ENGINE-NATIVE byte-exact on the live engine.
//
// THIS PROBE runs the SAME gradient-free jamo-symbol mitosis ENGINE-NATIVE on the LIVE
// CORE/engine_cli.hexa faculties (vadapt_field_nearest_idx Voronoi ownership + engine_mitosis_tick
// growth, p8; per-cell next-symbol count-MLE head, gradient-free) over the deterministic jamo /
// raw / shuffle symbol streams the data-prep (UNIVERSE/h1321_ko_jamo_wire_export.py) materialized
// from the SAME REAL 30MB KO window H_1316 verified (sha-gated). The representation transform (NFD
// jamo symbolization) is deterministic Unicode data-prep; the MITOSIS + CE SCORING run engine-native
// HERE. SINGLE ENTRY: this is the SAME engine-native Korean path H_1306/H_1312 use (the engine_cli
// VAdaptField faculty / generator L3 slot family) — NO 2nd .clm/.kosmos path; pure_field/engine_g/
// brain UNTOUCHED (Ψ-disjoint).
//
// W1/W2/W3 FROZEN bars (pre-registered .verdicts/1321_ko_jamo_wire/FREEZE.txt BEFORE this run;
// c9/p7 NO tune-to-green):
//   W1 ENGINE-NATIVE CE   engine-native jamo G1 CE reproduces the SAME-WINDOW mirror within
//                         |Δ|<=0.05 nats/byte AND engine-native G1 CE < 2.903 (below the raw ceiling band).
//   W2 CONTROLS HOLD      engine-native G1 beats engine-native G1c (shuffle) by >=0.05 (mean 3 seeds)
//                         AND engine-native G1 beats engine-native G0 (raw byte) by >=0.05; B3 lossless
//                         (carried verbatim from the data-prep over the SAME window, b3_ok flag).
//   W3 NO REGRESSION      engine_cli_smoke N/0 · h1196 7/0 · h1205 Ψ byte-identical ON==OFF (run separately).
//   GREEN iff W1 ∧ W2 ∧ W3. If W1 fails → HONEST: jamo win is MIRROR-ONLY, engine-transfer UNVERIFIED.
//
// FAIR AXIS (verbatim H_1316): held-out CE_per_byte = Σ(−log p(sym)) / Σ n_bytes(sym) — the SAME
// held-out split/axis as the 2.9475 raw-byte ceiling. The per-symbol n_bytes (raw=1; a syllable's
// jamo split [1,1,1]/[2,1] summing to 3) is read from the exported *.nbytes files.
//
// FROZEN knobs (verbatim H_1306/H_1307/H_1316): GROW_MAX=40, SPLIT_THRESH_CE=0.05, MIN_OWNED=8,
// LAPLACE=1.0, SEED_CENTERS [[0.3,0.5,0.0],[0.7,0.5,0.5]], FEAT 3-D [last/Vj, second/Vj, depth/3],
// even/odd held-out split (done in the data-prep). $0 CPU, no GPU, no secrets at run time.
//
// DATA: /tmp/h1321_{g0,g1,g1c0,g1c1,g1c2}_{train,test}.{feats,next} + test.nbytes + /tmp/h1321_ref.txt,
// exported by UNIVERSE/h1321_ko_jamo_wire_export.py (which fetches the sha-gated 30MB KO window).

import "CORE/engine_cli.hexa"

// ── FROZEN knobs (verbatim from H_1306/H_1316) ──────────────────────────────────
fn _FEAT_DIM() -> int          { return 3 }
fn _GROW_MAX() -> int          { return 40 }
fn _SPLIT_THRESH_CE() -> float { return 0.05 }
fn _MIN_OWNED() -> int         { return 8 }
fn _LAPLACE() -> float         { return 1.0 }
fn _W1_TOL() -> float          { return 0.05 }   // W1: |engine - same-window mirror| <= this
fn _CEIL_BAND() -> float       { return 2.903 }  // W1: engine G1 must stay below this (2.953-0.05)
fn _W2_MARGIN() -> float       { return 0.05 }   // W2: G1 beats G1c AND G0 by >= this

fn _fmt(x: float) -> string { return to_string(x) }

// ── loaders (identical pattern to H_1306) ───────────────────────────────────────
fn _load_feats(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_ints(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [to_int(lines[i].trim())]  i = i + 1 }
    return out
}
fn _load_floats_line(path: string) -> [float] {
    let txt = read_file(path)
    let cols = txt.trim().split(" ")
    let mut out = []
    let mut i = 0
    while i < len(cols) { out = out + [to_float(cols[i].trim())]  i = i + 1 }
    return out
}

// ── engine-native partition geometry (LIVE faculty: vadapt_field_nearest_idx) ───
fn _assign_all(af: VAdaptField, X: [[float]]) -> [int] {
    let mut owner = []
    let mut i = 0
    while i < len(X) { owner = owner + [vadapt_field_nearest_idx(af, X[i])]  i = i + 1 }
    return owner
}
// per-cell next-symbol count-MLE head over the FIRST ntr train points (vocab-agnostic at vj)
fn _head_counts(Y: [int], owner: [int], k: int, ntr: int, vj: int, laplace: float) -> [float] {
    let mut counts = []
    let mut v = 0
    while v < vj { counts = counts + [laplace]  v = v + 1 }
    let mut total = laplace * to_float(vj)
    let mut i = 0
    while i < ntr {
        if owner[i] == k { counts[Y[i]] = counts[Y[i]] + 1.0  total = total + 1.0 }
        i = i + 1
    }
    let mut p = []
    let mut w = 0
    while w < vj { p = p + [counts[w] / total]  w = w + 1 }
    return p
}
fn _owned_ce(Y: [int], owner: [int], k: int, ntr: int, p: [float]) -> float {
    let mut s = 0.0  let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k { s = s - ln(p[Y[i]] + 0.000000000001)  n = n + 1 }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}
fn _owned_count(owner: [int], k: int, ntr: int) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr { if owner[i] == k { n = n + 1 }  i = i + 1 }
    return n
}
fn _hi_var_axis(X: [[float]], owner: [int], k: int, ntr: int, dim: int) -> int {
    let mut sum = []  let mut sq = []  let mut d = 0
    while d < dim { sum = sum + [0.0]  sq = sq + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let mut a = 0
            while a < dim { sum[a] = sum[a] + X[i][a]  sq[a] = sq[a] + X[i][a] * X[i][a]  a = a + 1 }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0 }
    let fn2 = to_float(n)
    let mut best = 0  let mut bestv = -1.0  let mut a2 = 0
    while a2 < dim {
        let mean = sum[a2] / fn2
        let var = sq[a2] / fn2 - mean * mean
        if var > bestv { bestv = var  best = a2 }
        a2 = a2 + 1
    }
    return best
}
fn _owned_median(X: [[float]], owner: [int], k: int, ntr: int, ax: int) -> float {
    let mut vals = []  let mut i = 0
    while i < ntr { if owner[i] == k { vals = vals + [X[i][ax]] }  i = i + 1 }
    let n = len(vals)
    if n == 0 { return 0.0 }
    let mut a = 1
    while a < n {
        let key = vals[a]  let mut b = a - 1
        while b >= 0 && vals[b] > key { vals[b + 1] = vals[b]  b = b - 1 }
        vals[b + 1] = key  a = a + 1
    }
    if n % 2 == 1 { return vals[n / 2] }
    return (vals[n / 2 - 1] + vals[n / 2]) / 2.0
}
fn _half_centroid(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool, dim: int) -> [float] {
    let mut acc = []  let mut d = 0
    while d < dim { acc = acc + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take {
                let mut a = 0
                while a < dim { acc[a] = acc[a] + X[i][a]  a = a + 1 }
                n = n + 1
            }
        }
        i = i + 1
    }
    if n == 0 { return acc }
    let mut out = []  let mut a2 = 0
    while a2 < dim { out = out + [acc[a2] / to_float(n)]  a2 = a2 + 1 }
    return out
}
fn _half_count(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take { n = n + 1 }
        }
        i = i + 1
    }
    return n
}
fn _field_from(centers: [[float]], max_cells: int) -> VAdaptField {
    return VAdaptField { protos: centers, n_cells: len(centers), max_cells: max_cells, dim: len(centers[0]) }
}

// GROW the field on the FIRST ntr train points (error-TARGETED mitosis, SPLIT-only p8),
// from the given centers, up to GROW_MAX. Growth GATED by the LIVE engine_mitosis_tick.
fn _grow_on(centers0: [[float]], af0: VAdaptField, Xtr: [[float]], Ytr: [int], ntr: int,
            dim: int, vj: int, cfg: EngineConfig) -> [[float]] {
    let mut centers = centers0
    let mut af = af0
    while len(centers) < _GROW_MAX() {
        let owner = _assign_all(af, Xtr)
        let nc = len(centers)
        let mut local_ce = []  let mut owned_n = []  let mut k = 0
        while k < nc {
            let cnt = _owned_count(owner, k, ntr)
            owned_n = owned_n + [cnt]
            if cnt > 0 {
                let p = _head_counts(Ytr, owner, k, ntr, vj, _LAPLACE())
                local_ce = local_ce + [_owned_ce(Ytr, owner, k, ntr, p)]
            } else { local_ce = local_ce + [-1.0] }
            k = k + 1
        }
        let mut elig = []  let mut k2 = 0
        while k2 < nc {
            if owned_n[k2] >= _MIN_OWNED() && local_ce[k2] > _SPLIT_THRESH_CE() { elig = elig + [k2] }
            k2 = k2 + 1
        }
        if len(elig) == 0 { break }
        let mut pick = elig[0]
        let mut bestce = local_ce[elig[0]]
        let mut ei = 1
        while ei < len(elig) {
            if local_ce[elig[ei]] > bestce { bestce = local_ce[elig[ei]]  pick = elig[ei] }
            ei = ei + 1
        }
        // GROWTH gated by the engine's OWN mitosis tick (p8, LIVE faculty)
        let grown = engine_mitosis_tick(len(centers), cfg)
        if grown <= len(centers) { break }
        let ax = _hi_var_axis(Xtr, owner, pick, ntr, dim)
        let med = _owned_median(Xtr, owner, pick, ntr, ax)
        let nlo = _half_count(Xtr, owner, pick, ntr, ax, med, true)
        let nhi = _half_count(Xtr, owner, pick, ntr, ax, med, false)
        if nlo == 0 || nhi == 0 { break }
        let c_lo = _half_centroid(Xtr, owner, pick, ntr, ax, med, true, dim)
        let c_hi = _half_centroid(Xtr, owner, pick, ntr, ax, med, false, dim)
        let mut new_centers = []  let mut ci = 0
        while ci < len(centers) {
            if ci != pick { new_centers = new_centers + [centers[ci]] }
            ci = ci + 1
        }
        new_centers = new_centers + [c_lo, c_hi]
        centers = new_centers
        af = _field_from(centers, _GROW_MAX())
    }
    return centers
}

// held-out PER-BYTE CE: Σ(−log p(sym)) / Σ n_bytes(sym) over the held-out test set, heads built
// over the train owners. The FAIR axis vs the raw-byte ceiling (H_1316 per_byte_ce).
fn _score_ce_per_byte(af: VAdaptField, centers: [[float]], Xtr: [[float]], Ytr: [int], ntr: int,
                      Xte: [[float]], Yte: [int], NBte: [int], vj: int) -> [float] {
    let own_tr = _assign_all(af, Xtr)
    let nc = len(centers)
    let mut heads = []  let mut k = 0
    while k < nc { heads = heads + [_head_counts(Ytr, own_tr, k, ntr, vj, _LAPLACE())]  k = k + 1 }
    let own_te = _assign_all(af, Xte)
    let mut tot_nats = 0.0  let mut tot_bytes = 0.0  let mut i = 0
    while i < len(Xte) {
        tot_nats = tot_nats - ln(heads[own_te[i]][Yte[i]] + 0.000000000001)
        tot_bytes = tot_bytes + to_float(NBte[i])
        i = i + 1
    }
    if tot_bytes == 0.0 { return [0.0, 0.0] }
    return [tot_nats / tot_bytes, tot_bytes]
}

// run ONE arm engine-native: load its exported train/test/nbytes, grow mitosis, score per-byte CE.
fn _run_arm(tag: string, dim: int, vj: int, cfg: EngineConfig) -> [float] {
    let Xtr = _load_feats("/tmp/h1321_" + tag + "_train.feats", dim)
    let Ytr = _load_ints("/tmp/h1321_" + tag + "_train.next")
    let Xte = _load_feats("/tmp/h1321_" + tag + "_test.feats", dim)
    let Yte = _load_ints("/tmp/h1321_" + tag + "_test.next")
    let NBte = _load_ints("/tmp/h1321_" + tag + "_test.nbytes")
    if len(Xtr) == 0 || len(Xte) == 0 {
        println("ERROR: missing /tmp/h1321_" + tag + "_* — run UNIVERSE/h1321_ko_jamo_wire_export.py first.")
        exit(1)
    }
    let seed = [[0.3, 0.5, 0.0], [0.7, 0.5, 0.5]]
    let af0 = _field_from(seed, _GROW_MAX())
    let centers = _grow_on(seed, af0, Xtr, Ytr, len(Xtr), dim, vj, cfg)
    let af = _field_from(centers, _GROW_MAX())
    let r = _score_ce_per_byte(af, centers, Xtr, Ytr, len(Xtr), Xte, Yte, NBte, vj)
    return [r[0], to_float(len(centers)), to_float(len(Xtr)), to_float(len(Xte))]
}

fn main() {
    println("=== H_1321 — ENGINE-NATIVE WIRING of the H_1316 🟢 ko-jamo breakthrough (a_verified_must_wire) ===")
    println("faculty: CORE/engine_cli.hexa VAdaptField Voronoi (vadapt_field_nearest_idx) + engine_mitosis_tick")
    println("         growth (p8, LIVE); head = per-cell next-symbol count-MLE (gradient-free).")
    println("rep: deterministic NFD jamo symbolization (data-prep) — Hangul syllable → L/V/T jamo symbols.")
    println("metric = held-out next-symbol CROSS-ENTROPY renormalized to nats/UTF-8-byte (p7, FAIR axis).")
    println("")

    let cfg = engine_cli_parse(["--mitosis", "on"])
    let dim = _FEAT_DIM()

    // same-window mirror reference (the EXACT pairs this probe scores): Vj g0_ref g1_ref g1c_mean b3_ok
    let ref = _load_floats_line("/tmp/h1321_ref.txt")
    if len(ref) < 5 {
        println("ERROR: missing /tmp/h1321_ref.txt — run UNIVERSE/h1321_ko_jamo_wire_export.py first.")
        exit(1)
    }
    let vj = to_int(ref[0])
    let g0_ref = ref[1]
    let g1_ref = ref[2]
    let g1c_ref = ref[3]
    let b3_ok = ref[4] > 0.5
    println("data-prep same-window mirror REFERENCE (Vj=" + to_string(vj) + "): G0=" + _fmt(g0_ref)
        + " G1=" + _fmt(g1_ref) + " G1c=" + _fmt(g1c_ref) + " | B3 lossless=" + (if b3_ok { "True" } else { "False" }))
    println("FROZEN bars: W1 |engine-G1 − mirror-G1| <= " + _fmt(_W1_TOL()) + " AND engine-G1 < " + _fmt(_CEIL_BAND())
        + "  ·  W2 G1 beats G1c & G0 by >= " + _fmt(_W2_MARGIN()) + "  ·  W3 no-regression (separate)")
    println("-------------------------------------------------------------------------------")

    // ── ENGINE-NATIVE arms ──
    let g0 = _run_arm("g0", dim, 256, cfg)        // raw byte arm at V=256 (reproduce the ceiling)
    let g1 = _run_arm("g1", dim, vj, cfg)         // jamo intact at Vj
    let g1c0 = _run_arm("g1c0", dim, vj, cfg)     // shuffle seed 0
    let g1c1 = _run_arm("g1c1", dim, vj, cfg)     // shuffle seed 1
    let g1c2 = _run_arm("g1c2", dim, vj, cfg)     // shuffle seed 2
    let g1c_eng = (g1c0[0] + g1c1[0] + g1c2[0]) / 3.0

    println("ENGINE-NATIVE held-out KO next-symbol CE (nats/UTF-8-byte):")
    println("  G0 raw-byte  CE=" + _fmt(g0[0]) + "  cells=" + to_string(to_int(g0[1])) + "  (" + to_string(to_int(g0[2])) + "tr/" + to_string(to_int(g0[3])) + "te)")
    println("  G1 jamo      CE=" + _fmt(g1[0]) + "  cells=" + to_string(to_int(g1[1])) + "  (" + to_string(to_int(g1[2])) + "tr/" + to_string(to_int(g1[3])) + "te)")
    println("  G1c shuffle  CE=" + _fmt(g1c_eng) + "  (mean of 3 seeds: " + _fmt(g1c0[0]) + " " + _fmt(g1c1[0]) + " " + _fmt(g1c2[0]) + ")")
    println("-------------------------------------------------------------------------------")

    // ── W1 ──
    let d_mirror = if g1[0] >= g1_ref { g1[0] - g1_ref } else { g1_ref - g1[0] }
    let w1_repro = d_mirror <= _W1_TOL()
    let w1_below = g1[0] < _CEIL_BAND()
    let w1 = w1_repro && w1_below
    println("(W1) ENGINE-NATIVE CE  |engine-G1 " + _fmt(g1[0]) + " − mirror-G1 " + _fmt(g1_ref) + "| = " + _fmt(d_mirror)
        + " <= " + _fmt(_W1_TOL()) + " -> " + (if w1_repro { "PASS" } else { "FAIL" })
        + "  AND  engine-G1 " + _fmt(g1[0]) + " < " + _fmt(_CEIL_BAND()) + " -> " + (if w1_below { "PASS" } else { "FAIL" }))

    // ── W2 ──
    let d_shuf = g1c_eng - g1[0]
    let d_raw = g0[0] - g1[0]
    let w2_shuf = d_shuf >= _W2_MARGIN()
    let w2_raw = d_raw >= _W2_MARGIN()
    let w2 = w2_shuf && w2_raw && b3_ok
    println("(W2) CONTROLS HOLD  G1c−G1 = " + _fmt(d_shuf) + " >= " + _fmt(_W2_MARGIN()) + " -> " + (if w2_shuf { "PASS" } else { "FAIL" })
        + "  AND  G0−G1 = " + _fmt(d_raw) + " >= " + _fmt(_W2_MARGIN()) + " -> " + (if w2_raw { "PASS" } else { "FAIL" })
        + "  AND  B3 lossless -> " + (if b3_ok { "PASS" } else { "FAIL" }))
    println("     (W3 no-regression — engine_cli_smoke / h1196 / h1205 — run separately, reported in the verdict.)")
    println("-------------------------------------------------------------------------------")

    // GREEN iff W1 ∧ W2 (W3 reported separately in the verdict file)
    let green_core = w1 && w2
    if green_core {
        println("H_1321 VERDICT (engine-native, W1∧W2): 🟢 GREEN — the jamo breakthrough RUNS ENGINE-NATIVE.")
        println("  Engine-native jamo mitosis on the LIVE VAdaptField + engine_mitosis_tick reproduces the")
        println("  mirror within tolerance AND breaks the raw-byte ceiling AND its controls hold — the H_1316")
        println("  GREEN mechanism is now LIVE in CORE byte-exact (a_verified_must_wire; W3 guards reported separately).")
    } else if !w1 {
        println("H_1321 VERDICT (engine-native): 🔴 HONEST — W1 FAIL: engine-native could NOT reproduce the mirror.")
        println("  The jamo win is MIRROR-ONLY; engine-transfer UNVERIFIED (a real caveat, c9 — NO faked wiring).")
    } else {
        println("H_1321 VERDICT (engine-native): 🟠 PARTIAL — W1 holds but a control (W2) failed engine-native.")
    }
    println("  W1=" + (if w1 { "True" } else { "False" }) + " W2=" + (if w2 { "True" } else { "False" })
        + " | ENGINE-NATIVE (LIVE VAdaptField Voronoi + engine_mitosis_tick, p8); rep = deterministic NFD jamo;")
    println("  pure_field/engine_g/brain UNTOUCHED (Ψ-disjoint, a_core_engine_map). $0 CPU, no GPU, no secrets at run.")
    println("[done]")
    if !green_core { exit(1) }
}
