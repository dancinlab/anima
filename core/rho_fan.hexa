// rho_fan_score_arm_auto — CANONICAL mouth-agnostic ρ·fan (was G6) scoring op (a89a F3 reconcile · single-entry):
// IDENTICAL DIST/FALS/coherent logic to rho_fan_score_arm, but decode is the SINGLE typed L3 entry
// gen_auto_ideate (sniffs the ckpt → .clm OR ByteGPT) instead of the CLM-only gen_clm_ideate.
// This is the wired engine op cli/evaluate.hexa::eval_rho_fan_seeded_W calls — so the "ρ·fan scoring
// = a wired engine op" claim is TRUE (no claimed-wired-but-dead inline duplicate). base_seed
// parameterizes the per-frame RNG (seeded base_seed+i, exactly like the old inline eval_rho_fan
// path → base_seed=7 reproduces it frame-for-frame) so eval_rho_fan_multiseed can re-run the SAME
// ladder over seeds. p7: scoring only, no idea-authoring; the frame is fixed, only the model's
// own sample is read.
pub fn rho_fan_score_arm_auto(ckpt: string, frames: list, gen: int, base_seed: int, known: Map) -> Map {
    let texts = []
