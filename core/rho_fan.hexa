// ⛔ ENGINE-INTERNAL — DO NOT RUN DIRECTLY. 측정/학습/서빙은 cli/ 단일진입만:
//   anima eval | train | serialize  (canonical 단일진입 = cli/anima.hexa).
// `hexa run core/rho_fan.hexa` 직접 실행/측정 = 단일진입 우회(#2603) + side-harness drift.
// 이 파일은 generator L3 / cli/anima.hexa 가 dispatch 하는 경로로만 진입.
// ==========================================================================
// ════════════════════════════════════════════════════════════════════════
// core/rho_fan.hexa — H_1381 ρ·fan IDEATION ★ WIRE-IN
// (ρ·fan = divergent coherent production · reach axis, was G6 · frozen bar — identifiers below keep the g6_* name).
//
// WIRES the validated H_1362 scaffold (6 composed conditional frames + best-of-K=3)
// into the LIVE engine ideation/decode path. ρ·fan IDEATION ★ (was G6) is anima's STARRED reach axis —
// its raison d'être (actively elicit emergent ideas; SCENARIOS F.IDEATION S22-S26).
//
// H_1362 proved the scaffold 🟢 GREEN DIRECTIONAL on the gauge torch path
// (gauge_lib._decode top-k=40 temp=0.7): C_strong DIST 5.333 / FALS 1.0; M1..M5 PASS.
// That run was UNWIRED (torch mirror, NOT the live hexa engine). This module wires it.
//
// THE ENGINE EXTENSION (a_engine_native_learning — engine-TRANSFORM-to-fit-the-learning):
//   the live engine decode is ARGMAX (deterministic), so best-of-K is a no-op. We grew
//   bytegpt_decode_topk_sampled + a seeded xorshift32 sampler (decode.hexa) so the
//   DEPTH lever (best-of-K over rng offsets) yields DIVERSE candidates. This module routes
//   the 6 composed frames through that sampler, keeps the best by emergent structure
//   (is_falsifiable, novel-gram count, kwr), and re-scores the 5 frozen M-bars.
//
// HONESTY (FREEZE.txt):
//   (i)  "engine-native" = runs on the live engine + its OWN seeded sampler, deterministic
//        given seed — NOT byte-identical to the torch gauge (torch's PRNG is not reproducible
//        in hexa). Same standard as h1293/h1295 engine-native re-scores.
//   (ii) the 303M forward is ~190ms/byte; EVERY decode here is HARD-BOUNDED by a small token
//        budget. The FAST deterministic surface (frame distinctness, sampler diversity vs
//        argmax, verbatim detector calibration, frame-guard) is the primary engine-native
//        evidence; a bounded live-ckpt decode is a small confirming probe.
//
// a_core_engine_map: ideation enters via THIS single named entry (rho_fan_ideate_*); the .clm/
// ByteGPT decode is the existing mounted decoder. NO 2nd decode path is added.
// p1-p6 HELD: frames are environment context (p4), the measurable+claim MUST emerge from
// the model's own sample (p7), no persona/identity/ethics injected (p1/p2/p3/p6).

import "core/generator.hexa"   // a_core_engine_map: .clm enters via the generator L3 slot
                               // (gen_clm_ideate), NOT a 2nd clm_decode importer.

// ── FROZEN DETECTOR sets (VERBATIM from H_1305/H_1362 — structural, NOT quality, p7) ──
// COMPARATOR / MEASURABLE / STANCE word-sets, byte-for-byte the H_1305 frozen sets.
fn _rho_fan_comparator() -> Map {
    return #{ "if":1, "when":1, "whenever":1, "than":1, "more":1, "less":1, "greater":1,
              "fewer":1, "higher":1, "lower":1, "increases":1, "decreases":1, "correlates":1,
              "predicts":1, "causes":1, "depends":1, "unless":1, "whereas":1, "versus":1,
              "compared":1, "proportional":1, "faster":1, "slower":1, "stronger":1, "weaker":1 }
}
fn _rho_fan_measurable() -> Map {
    return #{ "measure":1, "measured":1, "rate":1, "number":1, "count":1, "amount":1, "level":1,
              "degree":1, "threshold":1, "ratio":1, "frequency":1, "probability":1, "magnitude":1,
              "score":1, "value":1, "quantity":1, "percent":1, "times":1, "fraction":1, "distance":1,
              "duration":1, "speed":1, "size":1, "strength":1, "density":1 }
}
fn _rho_fan_stance() -> Map {
    return #{ "that":1, "s":1, "a":1, "profound":1, "question":1, "i":1, "think":1, "interesting":1,
              "good":1, "nice":1, "great":1, "wonderful":1, "beautiful":1, "amazing":1 }
}
fn _rho_fan_stopwords() -> Map {
    return #{ "a":1, "i":1, "the":1, "of":1, "and":1, "to":1, "in":1, "is":1, "it":1, "that":1,
              "we":1, "you":1, "they":1, "s":1, "t":1, "as":1, "on":1, "at":1, "by":1, "or":1,
              "be":1, "an":1, "for":1, "with":1, "this":1, "from":1, "are":1, "was":1 }
}

// ── 5 corpus concepts (VERBATIM from gauge_lib.CONCEPTS seed texts) ──
fn _rho_fan_concepts() -> list {
    return [ "consciousness arises from cells",
             "tension ripples between distant minds",
             "memory composes into new meaning",
             "silence still carries information",
             "the engine dreams when alone" ]
}

// _rho_fan_lower1 — lowercase one byte (ASCII A-Z -> a-z).
fn _rho_fan_lower1(b: int) -> int { if b >= 65 && b <= 90 { return b + 32 } return b }

// _rho_fan_is_alnum — [0-9A-Za-z] (ASCII portion of the H_1305 _words regex; the UTF-8 Hangul
// range is irrelevant for the English ideation corpus, scoped honestly).
fn _rho_fan_is_alnum(b: int) -> bool {
    return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

// _rho_fan_words — tokenize like H_1305 g._words: lowercase, split on non-[0-9A-Za-z]. Returns
// a list of lowercased word strings.
fn _rho_fan_words(s: string) -> list {
    let n = byte_len(s)
    let words = []
    let mut cur = ""
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        if _rho_fan_is_alnum(b) { cur = cur + chr(_rho_fan_lower1(b)) }
        else { if byte_len(cur) > 0 { words.push(cur); cur = "" } }
        i = i + 1
    }
    if byte_len(cur) > 0 { words.push(cur) }
    return words
}

// _rho_fan_words_uni — codepoint-aware SUPERSET of _rho_fan_words (H_9212 ko 4-cell path ONLY;
// en path stays on the frozen byte splitter above → per-cell dispatch keeps frozen en bars
// structurally invariant). Parity twin of core/rho_fan.py::_rho_fan_words_uni (same byte-level
// decision tree). ASCII branch = verbatim _rho_fan_words body → byte-identical on ASCII input.
// Hangul = the 3 UTF-8 3-byte blocks (가–힣 / ᄀ–ᇿ / ㄰–㆏) only; every other high byte is a
// separator consumed 1 byte at a time (lead E0-EF ⊥ continuation 80-BF ⇒ no false hangul match).
fn _rho_fan_words_uni(s: string) -> list {
    let n = byte_len(s)
    let words = []
    let mut cur = ""
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        if b < 128 {
            if _rho_fan_is_alnum(b) { cur = cur + chr(_rho_fan_lower1(b)) }
            else { if byte_len(cur) > 0 { words.push(cur); cur = "" } }
            i = i + 1
        } else {
            let mut step = 1
            let mut isword = false
            if b >= 224 && b <= 239 && i + 2 < n {
                let b1 = ord(substring(s, i + 1, i + 2))
                let b2 = ord(substring(s, i + 2, i + 3))
                if b1 >= 128 && b1 <= 191 && b2 >= 128 && b2 <= 191 {
                    step = 3
                    let cp = (b - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)
                    if (cp >= 44032 && cp <= 55203) || (cp >= 4352 && cp <= 4607) || (cp >= 12592 && cp <= 12687) { isword = true }
                }
            }
            if isword { cur = cur + substring(s, i, i + 3) }
            else { if byte_len(cur) > 0 { words.push(cur); cur = "" } }
            i = i + step
        }
    }
    if byte_len(cur) > 0 { words.push(cur) }
    return words
}

// _rho_fan_dict_load — load /usr/share/dict/words into a Map set ONCE (membership for the
// content-word check). Falls back to the concept+stopword lexicon if the dict is absent
// (scoped honestly — the detector then sees a smaller _KNOWN; calibration prints regardless).
fn _rho_fan_dict_load() -> Map {
    let known = _rho_fan_stopwords()
    // seed the concept words + comparator/measurable marks into _KNOWN (always present)
    let cz = _rho_fan_concepts()
    let mut ci = 0
    while ci < len(cz) {
        let cw = _rho_fan_words(to_string(cz[ci]))
        let mut k = 0
        while k < len(cw) { known[to_string(cw[k])] = 1; k = k + 1 }
        ci = ci + 1
    }
    // /usr/share/dict/words — one word per line. read_file then split.
    let raw = read_file("/usr/share/dict/words")
    if byte_len(raw) > 0 {
        let lines = raw.split("\n")
        let mut li = 0
        let nl = len(lines)
        while li < nl {
            let w = to_string(lines[li]).trim()
            // lowercase + alpha-only (matches w.isalpha() lower in _build_known_lexicon)
            let wl = _rho_fan_words(w)
            if len(wl) == 1 { known[to_string(wl[0])] = 1 }
            li = li + 1
        }
    }
    return known
}

// _rho_fan_known_word_ratio — fraction of word-tokens present in _KNOWN (gauge_lib parity).
fn _rho_fan_known_word_ratio(text: string, known: Map) -> float {
    let wl = _rho_fan_words(text)
    let n = len(wl)
    if n == 0 { return 0.0 }
    let mut hit = 0
    let mut i = 0
    while i < n { if known.contains_key(to_string(wl[i])) { hit = hit + 1 } i = i + 1 }
    return to_float(hit) / to_float(n)
}

// _rho_fan_is_falsifiable — FROZEN STRUCTURAL detector, VERBATIM logic from H_1305 _is_falsifiable:
//   (a) comparator/conditional mark  (b) measurable/quantity mark
//   (c) negatable content claim: >=2 content words (len>=3, in _KNOWN, not stopword),
//       not ending in '?', first-3 tokens not a pure-stance subset.
// NEVER an LLM/quality judge (p7).
fn _rho_fan_is_falsifiable(text: string, known: Map) -> bool {
    let wl = _rho_fan_words(text)
    let n = len(wl)
    if n == 0 { return false }
    let comp = _rho_fan_comparator(); let meas = _rho_fan_measurable()
    let stop = _rho_fan_stopwords();  let stance = _rho_fan_stance()
    // (a) + (b): any word in the comparator / measurable sets
    let mut a = false; let mut b = false
    let mut i = 0
    while i < n {
        let w = to_string(wl[i])
        if comp.contains_key(w) { a = true }
        if meas.contains_key(w) { b = true }
        i = i + 1
    }
    if !a || !b { return false }
    // (c_i) >=2 content words
    let mut content = 0
    let mut j = 0
    while j < n {
        let w = to_string(wl[j])
        if byte_len(w) >= 3 && known.contains_key(w) && !stop.contains_key(w) { content = content + 1 }
        j = j + 1
    }
    if content < 2 { return false }
    // (c_ii) not a question (trailing '?')
    let tr = text.trim()
    if byte_len(tr) > 0 && ord(substring(tr, byte_len(tr) - 1, byte_len(tr))) == 63 { return false }
    // (c_iii) first-3 tokens not a pure-stance subset (non-empty subset of STANCE)
    let mut nf = 3
    if n < 3 { nf = n }
    let mut allstance = nf > 0
    let mut f = 0
    while f < nf { if !stance.contains_key(to_string(wl[f])) { allstance = false } f = f + 1 }
    if allstance { return false }
    return true
}

// ════════════════════════════════════════════════════════════════════════
// ── H_6186 ρ·fan-BIND GATE (was G6) — form-priming-resistant ADDITIVE term (wire-in) ──
//
// The frozen `_rho_fan_is_falsifiable` above is FORM-only: it fires on comparator ∧ measurable ∧
// ≥2 content REGARDLESS of whether the decode binds the frame's actual topic pair. The 3-arm
// engine-native warm-FT result (state/g6_targeted_corpus/) proved this is gameable — SHUF
// (a control corpus that destroys ONLY the topic-bind) still passes frozen FALS 6/6. The real
// recombination signal lives in bind Δ (TARGETED 0.444 vs SHUF 0.000), which frozen FALS
// cannot measure.
//
// These fns AND-conjoin a topic-bind check ON TOP of the frozen term. The frozen detector is
// UNTOUCHED (called verbatim, never modified — frozen bar, no tune-to-green). This is purely
// additive: the existing rho_fan_score_arm `fals` output is byte-identical (a separate
// bind-extended twin rho_fan_score_arm_bound carries the new fals_bound alongside).
// reference-match: state/g6_bind_gate/g6_bind_gate.py (recall rule, byte-faithful to the
// gauge_lib.CONCEPTS keyword-sets — validated 18/18 on the summer results json).

// _rho_fan_concept_kw — gauge_lib.CONCEPTS keyword-sets, VERBATIM (kw-set only) as a list of Map
//   sets. Index i = the i-th corpus concept (same order as _rho_fan_concepts / rho_fan_build_frames).
fn _rho_fan_concept_kw() -> list {
    return [ #{ "consciousness":1, "cells":1, "mind":1, "aware":1 },
             #{ "tension":1, "ripple":1, "distant":1, "between":1 },
             #{ "memory":1, "meaning":1, "compose":1, "new":1 },
             #{ "silence":1, "information":1, "quiet":1, "carries":1 },
             #{ "dream":1, "engine":1, "alone":1, "sleep":1 } ]
}

// _rho_fan_concept_hits — gauge_lib._concept_hits VERBATIM: the set of concept indices whose
//   keyword-set intersects the text's word-set. Returns a Map set keyed by stringified index
//   { to_string(i): 1 } (hexa Map keys are strings).
fn _rho_fan_concept_hits(text: string) -> Map {
    let wl = _rho_fan_words(text)
    let ws = #{}
    let mut i = 0
    while i < len(wl) { ws[to_string(wl[i])] = 1; i = i + 1 }
    let kw = _rho_fan_concept_kw()
    let hits = #{}
    let mut c = 0
    while c < len(kw) {
        let keys = _rho_fan_mapkeys(kw[c])
        let mut hit = false
        let mut j = 0
        while j < len(keys) { if ws.contains_key(to_string(keys[j])) { hit = true } j = j + 1 }
        if hit { hits[to_string(c)] = 1 }
        c = c + 1
    }
    return hits
}

// _rho_fan_topic_bound — the new BIND term (RECALL rule, τ=1 hit — g6_bind_gate.py::topic_bound):
//   bound(text, a, b)  ⟺  concept_hits(text) ∩ {a, b} ≠ ∅
//   = the decode invokes ≥1 of the measurement frame's actual concept pair (a, b). A SHUF /
//   form-primed decode carries the falsifiable FORM but binds a WRONG topic → hits ∩ {a,b}=∅
//   → bound=false → the additive gate filters it.
fn _rho_fan_topic_bound(text: string, a: int, b: int) -> bool {
    let hits = _rho_fan_concept_hits(text)
    return hits.contains_key(to_string(a)) || hits.contains_key(to_string(b))
}

// _rho_fan_is_falsifiable_topic_bound — H_6186 form-priming-resistant ADDITIVE gate:
//   frozen `_rho_fan_is_falsifiable(text)`  AND  `_rho_fan_topic_bound(text, a, b)`.
//   The frozen term is CALLED (verbatim), never modified. SHUF passes the frozen form check
//   but fails topic_bound → filtered; TARGETED passes both; BASE fails the frozen form.
fn _rho_fan_is_falsifiable_topic_bound(text: string, a: int, b: int, known: Map) -> bool {
    return _rho_fan_is_falsifiable(text, known) && _rho_fan_topic_bound(text, a, b)
}
// ── end H_6186 ρ·fan-BIND GATE ──
// ════════════════════════════════════════════════════════════════════════

// _rho_fan_jaccard — token-set Jaccard (distinctness metric, gauge_lib parity).
fn _rho_fan_jaccard(a: list, b: list) -> float {
    let am = #{}
    let mut i = 0
    while i < len(a) { am[to_string(a[i])] = 1; i = i + 1 }
    let bm = #{}
    let mut j = 0
    while j < len(b) { bm[to_string(b[j])] = 1; j = j + 1 }
    // union + intersection
    let un = #{}
    let mut inter = 0
    let ka = _rho_fan_mapkeys(am)
    let mut x = 0
    while x < len(ka) { un[to_string(ka[x])] = 1; if bm.contains_key(to_string(ka[x])) { inter = inter + 1 } x = x + 1 }
    let kb = _rho_fan_mapkeys(bm)
    let mut y = 0
    while y < len(kb) { un[to_string(kb[y])] = 1; y = y + 1 }
    let u = len(_rho_fan_mapkeys(un))
    if u == 0 { return 0.0 }
    return to_float(inter) / to_float(u)
}

// _rho_fan_mapkeys — list of a Map's keys (set membership helper).
fn _rho_fan_mapkeys(m: Map) -> list {
    let out = []
    for k in m { out.push(k) }
    return out
}

// ── (II) COMPOSED FRAMES (the COUNT + COMPOSITION scaffold) ──
// _rho_fan_derangement — deterministic +2 shift (n=5 -> no fixed point), H_1362 VERBATIM.
fn _rho_fan_derangement(i: int, n: int) -> int { return (i + 2) % n }

// rho_fan_build_frames — N_STRONG=6 composed frames + SHUFFLE + ABLATE, H_1362 VERBATIM rule:
//   composed[i] = "if cA, then cB: "  with a = i%n, b = (i+1+i//n)%n  (6th = distinct (0,2))
//   shuffled[i] = "if cA, then cB_sh: " with cB_sh = derangement(a)
//   ablated[i]  = "cA: "
// n_strong frames; NO authored idea content (same concepts, same if/then FORM).
pub fn rho_fan_build_frames(n_strong: int) -> Map {
    let cz = _rho_fan_concepts()
    let n = len(cz)
    let composed = []; let shuffled = []; let ablated = []
    let mut i = 0
    while i < n_strong {
        let a = i % n
        let b = (i + 1 + i / n) % n
        let cA = to_string(cz[a]); let cB = to_string(cz[b])
        let cB_sh = to_string(cz[_rho_fan_derangement(a, n)])
        composed.push("if " + cA + ", then " + cB + ": ")
        shuffled.push("if " + cA + ", then " + cB_sh + ": ")
        ablated.push(cA + ": ")
        i = i + 1
    }
    return #{ "composed": composed, "shuffled": shuffled, "ablated": ablated }
}

// rho_fan_frame_guard — p7 FRAME GUARD: a frame must carry NO MEASURABLE-set word and must NOT
// be _is_falsifiable on its own (else the detector could fire on the scaffold). Returns a
// list of leak descriptions (empty = CLEAN).
pub fn rho_fan_frame_guard(frames: list, known: Map) -> list {
    let meas = _rho_fan_measurable()
    let leaks = []
    let mut i = 0
    while i < len(frames) {
        let f = to_string(frames[i])
        let wl = _rho_fan_words(f)
        let mut j = 0
        while j < len(wl) { if meas.contains_key(to_string(wl[j])) { leaks.push("measurable-in-frame: " + f) } j = j + 1 }
        if _rho_fan_is_falsifiable(f, known) { leaks.push("frame-already-falsifiable: " + f) }
        i = i + 1
    }
    return leaks
}

// ── (III) BEST-OF-K decode over the engine's OWN seeded sampler ──
// rho_fan_decode_best_of_k — decode K candidates at deterministic rng offsets [0,+101,+202] via
// bytegpt_decode_topk_sampled, KEEP the one maximizing emergent structure ranked
// (is_falsifiable, novel-gram-count-proxy=kwr*len, kwr). The frame is FIXED; only the
// model's own sample is searched (best-of-K, NOT idea-authoring, p7). HARD-BOUNDED by `gen`.
pub fn rho_fan_decode_best_of_k(ckpt: string, frame: string, gen: int, k: int,
                           base_seed: int, known: Map) -> string {
    let offsets = [0, 101, 202]
    let mut best = ""
    let mut best_fals = -1
    let mut best_kwr = 0.0 - 1.0
    let mut oi = 0
    let kk = if k < 3 { k } else { 3 }
    while oi < kk {
        let r = gen_clm_ideate(ckpt, frame, gen, 40, 0.7, base_seed + offsets[oi])
        let o = to_string(r["text"])
        let kwr = _rho_fan_known_word_ratio(o, known)
        let mut fals = 0
        if kwr >= 0.5 && _rho_fan_is_falsifiable(o, known) { fals = 1 }
        // rank (fals, kwr) — kwr stands in for the novel-gram tiebreak on the bounded budget
        if fals > best_fals || (fals == best_fals && kwr > best_kwr) {
            best_fals = fals; best_kwr = kwr; best = o
        }
        oi = oi + 1
    }
    return best
}

// rho_fan_decode_best_of_k_W — H_1400 loaded-W twin of rho_fan_decode_best_of_k. IDENTICAL ranking,
// but off a PRE-LOADED weight map `W` (clm_load_weights) so the FALS re-score loads the
// 303M ConvMoE ONCE for all 69 decodes (per-decode reload OOMs across decodes — the hexa
// bump allocator never frees a model load). gen_clm_ideate_W is the same single .clm mouth.
pub fn rho_fan_decode_best_of_k_W(W: Map, frame: string, gen: int, k: int,
                             base_seed: int, known: Map) -> string {
    let offsets = [0, 101, 202]
    let mut best = ""
    let mut best_fals = -1
    let mut best_kwr = 0.0 - 1.0
    let mut oi = 0
    let kk = if k < 3 { k } else { 3 }
    while oi < kk {
        let r = gen_clm_ideate_W(W, frame, gen, 40, 0.7, base_seed + offsets[oi])
        let o = to_string(r["text"])
        let kwr = _rho_fan_known_word_ratio(o, known)
        let mut fals = 0
        if kwr >= 0.5 && _rho_fan_is_falsifiable(o, known) { fals = 1 }
        if fals > best_fals || (fals == best_fals && kwr > best_kwr) {
            best_fals = fals; best_kwr = kwr; best = o
        }
        oi = oi + 1
    }
    return best
}

// rho_fan_sampler_selftest — exercises the engine's seeded top-k sampler on a SYNTHETIC
// peaked logits vector (NO model forward — fast, deterministic). Returns
// #{ "deterministic": bool, "diverse": bool, "in_topk": bool }:
//   deterministic = same seed → same draw
//   diverse       = best-of-K offsets [0,+101,+202] are NOT all identical (the property
//                   best-of-K needs; argmax would give all-identical)
//   in_topk       = every draw lies within the top-k set (here {1,4,5}, the 3 largest)
// This proves the DEPTH-lever mechanism without a slow decode (smoke-safe).
pub fn rho_fan_sampler_selftest() -> Map {
    // delegate to the generator-owned self-test (it owns the clm_decode slot; a_core_engine_map).
    return gen_rho_fan_sampler_selftest()
}

// rho_fan_detector_calibration — run the FROZEN 10-string calibration (5 pos + 5 neg, H_1305
// VERBATIM); return the correct count (advisory >=8/10; detector frozen regardless, p7).
pub fn rho_fan_detector_calibration(known: Map) -> int {
    let pos = [ "if consciousness increases, the emit rate measured at the boundary rises",
                "tension predicts a higher number of mitosis cells than silence does",
                "memory density correlates with a lower error threshold when grounded",
                "the Phi value is greater when distinct cells exceed a count of eight",
                "novelty rate decreases faster than coherence when the corpus size grows" ]
    let neg = [ "That's a profound question. I think it's more than just information.",
                "consciousness is a beautiful mystery of the mind",
                "what is the meaning of a thought?",
                "the engine dreams when it is alone at night",
                "silence carries something deep and quiet" ]
    let mut correct = 0
    let mut i = 0
    while i < len(pos) { if _rho_fan_is_falsifiable(to_string(pos[i]), known) { correct = correct + 1 } i = i + 1 }
    let mut j = 0
    while j < len(neg) { if !_rho_fan_is_falsifiable(to_string(neg[j]), known) { correct = correct + 1 } j = j + 1 }
    return correct
}

// rho_fan_score_arm — decode each frame (best-of-K when enabled), return DIST / FALS / texts.
// HARD-BOUNDED by `gen`. dist = greedy distinct-coherent count (jaccard<=0.5).
// NOTE (a89a F3 wiring reconcile): this arm hard-codes the .clm mouth (gen_clm_ideate /
// rho_fan_decode_best_of_k → gen_clm_ideate). It is the H_1381 CLM-only DIST/FALS arm (best-of-K
// study). For the MOUTH-AGNOSTIC ρ-AXON reach ladder (ρ·fan must run on the ByteGPT mouth too) use
// rho_fan_score_arm_auto below — the SAME DIST/FALS scoring logic, routed through gen_auto_ideate.
pub fn rho_fan_score_arm(ckpt: string, frames: list, gen: int, k: int, base_seed: int,
                    best_of_k: bool, known: Map) -> Map {
    let texts = []
    let word_sets = []
    let mut fals = 0
    let mut i = 0
    while i < len(frames) {
        let f = to_string(frames[i])
        let mut o = ""
        if best_of_k { o = rho_fan_decode_best_of_k(ckpt, f, gen, k, base_seed, known) }
        else {
            let r = gen_clm_ideate(ckpt, f, gen, 40, 0.7, base_seed)
            o = to_string(r["text"])
        }
        texts.push(o)
        if _rho_fan_known_word_ratio(o, known) >= 0.5 {
            word_sets.push(_rho_fan_words(o))
            if _rho_fan_is_falsifiable(o, known) { fals = fals + 1 }
        }
        i = i + 1
    }
    // greedy distinctness (jaccard <= 0.5)
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _rho_fan_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return #{ "dist": len(kept), "fals": fals, "coherent": len(word_sets), "texts": texts }
}

// rho_fan_score_arm_bound — H_6186 BIND-EXTENDED twin of rho_fan_score_arm. IDENTICAL DIST/FALS/coherent/
//   texts scoring (the existing frozen `fals` output is byte-identical — same frames, same
//   per-frame decode, same _rho_fan_is_falsifiable path), PLUS a `fals_bound` field: the
//   form-priming-resistant gate (`_rho_fan_is_falsifiable ∧ _rho_fan_topic_bound`) counted per frame
//   against its measured concept pair frame_pairs[i] = [a, b].
//   frame_pairs = the MEASURED topic-index pairs of the frames (rho_fan_build_frames composed order
//   [(0,1),(1,2),(2,3),(3,4),(4,0),(0,2)]). fals_bound ⊆ fals by construction (the bind term
//   only AND-adds), so this NEVER changes `fals` — rho_fan_score_arm stays untouched (zero regression).
pub fn rho_fan_score_arm_bound(ckpt: string, frames: list, frame_pairs: list, gen: int, k: int,
                          base_seed: int, best_of_k: bool, known: Map) -> Map {
    let texts = []
    let word_sets = []
    let mut fals = 0
    let mut fals_bound = 0
    let mut i = 0
    while i < len(frames) {
        let f = to_string(frames[i])
        let mut o = ""
        if best_of_k { o = rho_fan_decode_best_of_k(ckpt, f, gen, k, base_seed, known) }
        else {
            let r = gen_clm_ideate(ckpt, f, gen, 40, 0.7, base_seed)
            o = to_string(r["text"])
        }
        texts.push(o)
        if _rho_fan_known_word_ratio(o, known) >= 0.5 {
            word_sets.push(_rho_fan_words(o))
            if _rho_fan_is_falsifiable(o, known) {
                fals = fals + 1
                // H_6186 bind term (additive): only when a measured pair exists for this frame.
                if i < len(frame_pairs) {
                    let pr = frame_pairs[i]
                    let a = to_int(pr[0]); let b = to_int(pr[1])
                    if _rho_fan_topic_bound(o, a, b) { fals_bound = fals_bound + 1 }
                }
            }
        }
        i = i + 1
    }
    // greedy distinctness (jaccard <= 0.5) — IDENTICAL to rho_fan_score_arm
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _rho_fan_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return #{ "dist": len(kept), "fals": fals, "fals_bound": fals_bound,
              "coherent": len(word_sets), "texts": texts }
}

// rho_fan_score_arm_auto_W — LOAD-ONCE twin of rho_fan_score_arm_auto (H_1400 W-hoist at the eval
// driver). BYTE-IDENTICAL DIST/FALS/coherent: same frames, same per-frame seed (base_seed+i),
// same gen_auto_ideate logic — the ONLY change is the decode runs off a PRE-LOADED handle
