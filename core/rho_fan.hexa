    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _rho_fan_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return #{ "dist": len(kept), "fals": fals, "coherent": len(word_sets), "texts": texts }
}

// rho_fan_score_arm_auto — CANONICAL mouth-agnostic ρ·fan (was G6) scoring op (a89a F3 reconcile · single-entry):
// IDENTICAL DIST/FALS/coherent logic to rho_fan_score_arm, but decode is the SINGLE typed L3 entry
// gen_auto_ideate (sniffs the ckpt → .clm OR ByteGPT) instead of the CLM-only gen_clm_ideate.
// This is the wired engine op cli/evaluate.hexa::eval_rho_fan_seeded_W calls — so the "ρ·fan scoring
// = a wired engine op" claim is TRUE (no claimed-wired-but-dead inline duplicate). base_seed
// parameterizes the per-frame RNG (seeded base_seed+i, exactly like the old inline eval_rho_fan
// path → base_seed=7 reproduces it frame-for-frame) so eval_rho_fan_multiseed can re-run the SAME
// ladder over seeds. p7: scoring only, no idea-authoring; the frame is fixed, only the model's
// own sample is read.
pub fn rho_fan_score_arm_auto(ckpt: string, frames: list, gen: int, base_seed: int, known: Map) -> Map {
    let texts = []
    let word_sets = []
    let mut fals = 0
    let mut i = 0
    while i < len(frames) {
        let f = to_string(frames[i])
        let r = gen_auto_ideate(ckpt, f, gen, 40, 0.7, base_seed + i)
        let o = to_string(r["text"])
        texts.push(o)
        if _rho_fan_known_word_ratio(o, known) >= 0.5 {
            word_sets.push(_rho_fan_words(o))
            if _rho_fan_is_falsifiable(o, known) { fals = fals + 1 }
        }
        i = i + 1
    }
    // greedy distinctness (jaccard <= 0.5) — REUSE _rho_fan_jaccard
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _rho_fan_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return #{ "dist": len(kept), "fals": fals, "coherent": len(word_sets), "texts": texts }
}

// ════════════════════════════════════════════════════════════════════════
// ── H_6186 ρ·fan-BIND (was G6) · ByteGPT-capable bind twin (canonical mouth-agnostic) ──
//
// GAP (state/g6_bind_gate_terminal/): the H_6186 form-priming-resistant fals_bound term is
// wired ONLY into rho_fan_score_arm_bound — which is CLM-ONLY (decode hard-codes gen_clm_ideate /
// rho_fan_decode_best_of_k). The CANONICAL `anima evaluate` ρ·fan path is mouth-agnostic
// (cli/evaluate.hexa eval_rho_fan_seeded_W → rho_fan_score_arm_auto_W → gen_auto_ideate → sniffs the
// ckpt → .clm OR ByteGPT) but carries NO fals_bound. So on a ByteGPT ckpt there is no engine
// op that emits fals_bound. These two additive fns close that: they are rho_fan_score_arm_bound's
// bind logic re-routed through the mouth-AGNOSTIC L3 decode entries (gen_auto_ideate), so the
// bind gate runs on the ByteGPT mouth too.
//
// ADDITIVE + ZERO REGRESSION: the frozen scoring fns (rho_fan_score_arm, rho_fan_score_arm_bound,
// rho_fan_score_arm_auto, rho_fan_score_arm_auto_W) and the frozen detector (_rho_fan_is_falsifiable) are
// NOT touched — called verbatim, never modified. fals_bound ⊆ fals by construction (the bind
// term only AND-adds inside the frozen-fals branch), so `dist`/`fals`/`coherent`/`texts` are
// byte-identical to rho_fan_score_arm_auto — the new field is purely additive.

// rho_fan_decode_best_of_k_auto — MOUTH-AGNOSTIC twin of rho_fan_decode_best_of_k. IDENTICAL best-of-K
// ranking (offsets [0,+101,+202]; keep max (fals, kwr)), but the decode is the SINGLE typed L3
// entry gen_auto_ideate (sniffs ckpt → .clm OR ByteGPT) instead of the CLM-only gen_clm_ideate.
// This is the ByteGPT-capable best-of-K path rho_fan_score_arm_auto_bound uses. HARD-BOUNDED by `gen`.
pub fn rho_fan_decode_best_of_k_auto(ckpt: string, frame: string, gen: int, k: int,
                                base_seed: int, known: Map) -> string {
    let offsets = [0, 101, 202]
    let mut best = ""
    let mut best_fals = -1
    let mut best_kwr = 0.0 - 1.0
    let mut oi = 0
    let kk = if k < 3 { k } else { 3 }
    while oi < kk {
        let r = gen_auto_ideate(ckpt, frame, gen, 40, 0.7, base_seed + offsets[oi])
        let o = to_string(r["text"])
        let kwr = _rho_fan_known_word_ratio(o, known)
        let mut fals = 0
        if kwr >= 0.5 && _rho_fan_is_falsifiable(o, known) { fals = 1 }
        // rank (fals, kwr) — kwr stands in for the novel-gram tiebreak on the bounded budget
        if fals > best_fals || (fals == best_fals && kwr > best_kwr) {
            best_fals = fals; best_kwr = kwr; best = o
        }
        oi = oi + 1
    }
    return best
}

// rho_fan_score_arm_auto_bound — H_6186 BIND-EXTENDED + MOUTH-AGNOSTIC scoring op. This is
// rho_fan_score_arm_bound's exact DIST/FALS/fals_bound logic (same frozen `fals` path, same
// _rho_fan_topic_bound AND-add) re-routed through the mouth-agnostic decode entries so it runs on
// the ByteGPT mouth (via rho_fan_decode_best_of_k_auto / gen_auto_ideate) — the missing bind twin of
// the canonical rho_fan_score_arm_auto that `anima evaluate` reaches. `frame_pairs` = the MEASURED
// topic-index pairs of the frames (rho_fan_build_frame_pairs; composed order
// [(0,1),(1,2),(2,3),(3,4),(4,0),(0,2)]). fals_bound ⊆ fals by construction → `fals`/`dist`/
// `coherent`/`texts` stay byte-identical to rho_fan_score_arm_auto (zero regression).
pub fn rho_fan_score_arm_auto_bound(ckpt: string, frames: list, frame_pairs: list, gen: int, k: int,
                               base_seed: int, best_of_k: bool, known: Map) -> Map {
    let texts = []
    let word_sets = []
    let mut fals = 0
    let mut fals_bound = 0
    let mut i = 0
    while i < len(frames) {
        let f = to_string(frames[i])
        let mut o = ""
        if best_of_k { o = rho_fan_decode_best_of_k_auto(ckpt, f, gen, k, base_seed + i, known) }
        else {
            let r = gen_auto_ideate(ckpt, f, gen, 40, 0.7, base_seed + i)
            o = to_string(r["text"])
        }
        texts.push(o)
        if _rho_fan_known_word_ratio(o, known) >= 0.5 {
            word_sets.push(_rho_fan_words(o))
            if _rho_fan_is_falsifiable(o, known) {
                fals = fals + 1
                // H_6186 bind term (additive): only when a measured pair exists for this frame.
                if i < len(frame_pairs) {
                    let pr = frame_pairs[i]
                    let a = to_int(pr[0]); let b = to_int(pr[1])
                    if _rho_fan_topic_bound(o, a, b) { fals_bound = fals_bound + 1 }
                }
            }
        }
        i = i + 1
    }
    // greedy distinctness (jaccard <= 0.5) — IDENTICAL to rho_fan_score_arm_auto
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _rho_fan_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return #{ "dist": len(kept), "fals": fals, "fals_bound": fals_bound,
              "coherent": len(word_sets), "texts": texts }
}

// rho_fan_build_frame_pairs — the MEASURED topic-index pairs for the composed frames, VERBATIM the
// same (a, b) rule rho_fan_build_frames uses (a = i%n, b = (i+1+i/n)%n over the _rho_fan_concepts set).
// Returned as a list of [a, b] int-lists so a bind driver can pass frame_pairs to
// rho_fan_score_arm_auto_bound WITHOUT re-deriving the rule. For n_strong=6 over n=5 concepts this is
// [[0,1],[1,2],[2,3],[3,4],[4,0],[0,2]] — the pairs the H_6186 bind term scores against.
pub fn rho_fan_build_frame_pairs(n_strong: int) -> list {
    let cz = _rho_fan_concepts()
    let n = len(cz)
    let pairs = []
    let mut i = 0
    while i < n_strong {
        let a = i % n
        let b = (i + 1 + i / n) % n
        pairs.push([a, b])
        i = i + 1
    }
    return pairs
}
