// core/temporal_binding_smoke.hexa — §TemporalBinding specious-present (T1) engine-native smoke.
// Exercises F1 EXISTENCE · F2 SCALE · F3 BOUNDARY · F4 ABLATION · F5 Ψ/G5-DISJOINT on the LIVE
// core/engine_cli.hexa ops (tb_*). READ-ONLY: no lane / store is mutated. anchor: T1 card.

import "core/engine_cli.hexa"

fn ok(name: string, cond: bool) -> bool {
    let tag = if cond { "PASS" } else { "FAIL" }
    print(tag + " " + name)
    return cond
}

fn eq_f(name: string, got: float, want: float) -> bool {
    let d = if got - want < 0.0 { want - got } else { got - want }
    let c = d <= 1e-9
    let tag = if c { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return c
}

fn main() {
    print("=== TemporalBinding (specious present · T1) engine-native smoke ===")
    let mut np = 0
    let mut nt = 0

    // A COHERENT tension population: 8 ticks, lanes vary smoothly on the NON-emit indices
    // (1,2,3,5..14); emit lanes 0 & 4 are held so we can prove disjointness. 15-lane layout.
    let base = [0.9, 0.10, 0.11, 0.12, 0.7, 0.13, 0.14, 0.15, 0.16, 0.17, 0.18, 0.19, 0.20, 0.21, 0.22]
    let mut coh = []
    let mut t = 0
    while t < 8 {
        let mut lane = []
        let mut i = 0
        while i < 15 {
            // tiny smooth drift on non-emit lanes; emit lanes (0,4) FIXED
            let drift = if i == 0 || i == 4 { 0.0 } else { to_float(t) * 0.001 }
            lane = lane + [base[i] + drift]
            i = i + 1
        }
        coh = coh + [lane]
        t = t + 1
    }
    let ten = tb_tension_series(coh)          // coherent scalar series (no boundaries)
    let thr = 0.05                            // event-boundary threshold on |Δtension|

    // sanity: coherent series has 0 boundaries at this threshold
    nt = nt + 1
    if ok("coherent_no_boundary", tb_num_boundaries(ten, thr) == 0) { np = np + 1 }

    // ── F1 EXISTENCE: a window w=4 binds >1 tick into one present (finite-duration "now") ──
    let dur4 = tb_present_duration(ten, 4, thr)
    nt = nt + 1
    if ok("F1_existence_dur_gt_1 (w=4)", dur4 > 1.0) { np = np + 1 }

    // ── F4 ABLATION: w=1 → every present is one tick → present collapses to knife-edge ──
    let dur1 = tb_present_duration(ten, 1, thr)
    nt = nt + 1
    if eq_f("F4_ablation_w1_collapse", dur1, 1.0) { np = np + 1 }

    // ── F2 SCALE: widening w binds MORE ticks per present (monotone non-decreasing) ──
    let sweep = tb_scale_sweep(ten, [1, 2, 4, 8], thr)
    nt = nt + 1
    if ok("F2_scale_monotone", sweep[0] <= sweep[1] && sweep[1] <= sweep[2] && sweep[2] <= sweep[3]) { np = np + 1 }
    nt = nt + 1
    if ok("F2_scale_strict_growth", sweep[0] < sweep[3]) { np = np + 1 }
    // at w>=n the whole stream is one present of length 8
    nt = nt + 1
    if eq_f("F2_saturates_at_n (w=8)", sweep[3], 8.0) { np = np + 1 }

    // ── F3 BOUNDARY: inject one big tension jump → present SPLITS even at huge window ──
    // copy the coherent series and spike tick 4 on a non-emit lane
    let mut brk = []
    t = 0
    while t < 8 {
        let mut lane = []
        let mut i = 0
        while i < 15 {
            let drift = if i == 0 || i == 4 { 0.0 } else { to_float(t) * 0.001 }
            let spike = if t == 4 && i == 7 { 5.0 } else { 0.0 }   // large jump at tick 4
            lane = lane + [base[i] + drift + spike]
            i = i + 1
        }
        brk = brk + [lane]
        t = t + 1
    }
    let tenb = tb_tension_series(brk)
    let nb = tb_num_boundaries(tenb, thr)
    nt = nt + 1
    if ok("F3_boundary_detected", nb >= 1) { np = np + 1 }
    // even with w huge (100 >> n) the boundary forces >=2 presents; #presents = 1 + #boundaries
    let npres_huge = tb_num_presents(tenb, 100, thr)
    nt = nt + 1
    if ok("F3_split_at_huge_w", npres_huge == 1 + nb) { np = np + 1 }
    nt = nt + 1
    if ok("F3_at_least_two_nows", npres_huge >= 2) { np = np + 1 }

    // ── F5 DISJOINT: ci_emit_drive (lanes 0/4) byte-identical regardless of window; recall_thr
    //    untouched. The temporal-binding readout never reads emit lanes nor mutates any store. ──
    nt = nt + 1
    if ok("F5_uses_no_emit_lane", tb_uses_emit_lane() == 0) { np = np + 1 }

    // emit-drive over the population BEFORE any tb call vs AFTER exercising every window: identical.
    let emit_ref = ci_off_median_drive(coh)
    let _burn1 = tb_present_duration_pop(coh, 1, thr)
    let _burn2 = tb_present_duration_pop(coh, 8, thr)
    let _burn3 = tb_scale_sweep(tb_tension_series(coh), [1, 3, 5, 8], thr)
    let emit_after = ci_off_median_drive(coh)
    nt = nt + 1
    if eq_f("F5_emit_drive_byte_identical", emit_after, emit_ref) { np = np + 1 }

    // per-tick emit drive is fixed (lanes 0,4 constant) ⇒ Ψ proxy unmoved by any window choice
    nt = nt + 1
    if eq_f("F5_emit_drive_value (0.5*(0.9+0.7))", emit_ref, 0.8) { np = np + 1 }

    // §ImmuneMemory recall_thr non-fab gate: build a store, run tb, confirm recall_thr unchanged.
    let key0 = [0.1, 0.2, 0.3]
    let mem = immune_memory_new(key0, "v0", 8)
    let thr_before = mem.recall_thr
    let _b = tb_present_duration_pop(coh, 4, thr)   // exercise the faculty
    // mem is immutable value semantics; tb never receives nor returns it ⇒ recall_thr invariant
    nt = nt + 1
    if eq_f("F5_recall_thr_invariant", mem.recall_thr, thr_before) { np = np + 1 }

    print("=== " + str(np) + "/" + str(nt) + " PASS ===")
}
