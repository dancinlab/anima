// tool/p9_lora_mode1_eval_h100_orchestrator.hexa — P9 F1_v3 V2 Mode 1 LoRA eval H100 lifecycle orchestrator
//
// PURPOSE
//   Mode 1 evaluation: Path A LoRA (step-8k anchor) vs Llama-3.2-3B base internal Δ on 3 benchmarks.
//   Boot fresh H100 SECURE on-demand pod, install lm-eval + peft, hf-download Llama-3.2-3B + the
//   step-8k LoRA adapter (need-singularity/p9-llama32-lora-stage1@5a9b4584), run lm-eval with PEFT
//   adapter composed onto Llama base, scp results back, auto-kill pod within 90s of sentinel.
//
//   F1_v3 V2 amended criteria evaluated post-eval:
//     c3: |LoRA_acc − Llama_base_acc| ≥ 2 × max(LoRA_stderr, Llama_base_stderr) per bench → ≥2/3 PASS
//     c4: LoRA_acc ≥ random_baseline + 5pp per bench → ≥2/3 PASS
//
//   Llama base anchors come from BG-Ο 93bef8c8 verdict.json:
//     HellaSwag 0-shot acc_norm = 0.654  (stderr 0.02129; band-target [0.634, 0.774])
//     MMLU 5-shot acc           = 0.5796 (stderr 0.00428)
//     TriviaQA 0-shot EM        = 0.396  (stderr 0.02189; remove_whitespace filter)
//
// raw#9   hexa-only Mac:        this file dispatches an emitted bash helper (Mac-side bash grandfathered
//                                per sibling pattern: tool/h100_pods_sync.bash etc.). NO Mac-side .py.
// raw#10  honest C3:            ≥3 caveats baked into emitted handoff doc on PASS/PARTIAL.
// raw#15  repo-relative paths:  Mac: /Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/...
//                                H100: /workspace/p9_lora_eval/... (transient, killed with pod)
// raw#37  transient-py-on-Linux: H100 runs lm_eval (transformers + torch + peft) — Python permitted there.
// raw#71  falsifier-bound:      c3+c4 thresholds fixed pre-launch (BG-Ξ amendment f6eb6517);
//                                no post-eval threshold tweak.
//
// USAGE
//   hexa run tool/p9_lora_mode1_eval_h100_orchestrator.hexa --selftest
//   hexa run tool/p9_lora_mode1_eval_h100_orchestrator.hexa --emit          # write exec.bash + run_h100.bash
//   hexa run tool/p9_lora_mode1_eval_h100_orchestrator.hexa --launch        # emit + execute (BG-managed)
//   hexa run tool/p9_lora_mode1_eval_h100_orchestrator.hexa --kill <pod_id> # emergency kill
//
// ENVIRONMENT (auto-pulled via secret get --raw)
//   runpod.api_key       — RunPod GraphQL/CLI auth
//   huggingface.token    — gated Llama-3.2-3B + need-singularity LoRA download
//
// SAFETY CAPS
//   max_wall_minutes    = 45     (hard pod kill at this point)
//   budget_target_usd   = 1.50   (~30min @ $2.99/hr)
//   budget_hard_cap_usd = 2.50   (kill triggers if elapsed * rate > cap)
//   auto_kill_required  = true   (pod MUST be terminated regardless of success/failure)
//   sentinel_kill_lag_s = 90     (max delay between sentinel detection and pod stop+remove)

let SCHEMA              = "anima/p9_lora_mode1_eval/orchestrator/1"
let CYCLE_TAG           = "p9_lora_mode1_eval_2026_05_04"
let STATE_DIR           = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04"
let EXEC_BASH_PATH      = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/exec.bash"
let RUN_H100_PATH       = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/run_h100.bash"
let POD_INFO_PATH       = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/pod_info.json"
let VERDICT_PATH        = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/verdict.json"
let RUN_LOG_PATH        = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/run.log"
let HEARTBEAT_PATH      = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/heartbeat.txt"
let RESULTS_DIR         = "/Users/ghost/core/anima/state/p9_lora_mode1_eval_2026_05_04/results"
let SSH_KEY             = "/Users/ghost/.runpod/ssh/RunPod-Key-Go"
let RUNPODCTL           = "/opt/homebrew/bin/runpodctl"

let MAX_WALL_MIN        = 45
let BUDGET_TARGET_USD   = 1.50
let BUDGET_HARD_CAP_USD = 2.50
let OD_RATE_USD         = 2.99

// === own 16 Phase 2 watchdog hook (constants) ===
let BG_LANE             = "BG-P9-LORA-MODE1-EVAL"
let TARGET_USD          = "1.5"
let WATCHDOG_HEXA       = "/Users/ghost/core/anima/tool/h100_cost_watchdog.hexa"
let WATCHDOG_REGISTER   = "/Users/ghost/core/anima/tool/h100_register.bash"
let WATCHDOG_HB_DIR     = "/Users/ghost/core/anima/state/h100_watchdog/heartbeats"

// LoRA target — BG-ξ verify_report committed in 1ef3c096
let HF_LORA_REPO        = "need-singularity/p9-llama32-lora-stage1"
let HF_LORA_REVISION    = "5a9b4584"          // step-8000 commit; not step-10000 (lost)
let HF_BASE_REPO        = "meta-llama/Llama-3.2-3B"

// ─── helpers ──────────────────────────────────────────────────────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _ts_iso() -> string {
    let r = exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")
    return to_string(r[0]).trim()
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── selftest ─────────────────────────────────────────────────────────────

fn _selftest() {
    println("[selftest] schema=" + SCHEMA)
    println("[selftest] cycle=" + CYCLE_TAG)

    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))
    if !_file_exists(STATE_DIR) {
        eprintln("FAIL: state dir not creatable")
        exit(1)
    }
    println("[T1] state dir OK")

    if !_file_exists(SSH_KEY) {
        eprintln("FAIL: ssh key missing: " + SSH_KEY)
        exit(1)
    }
    println("[T2] ssh key OK")

    println("[T3] runpodctl path constant: " + RUNPODCTL)

    let s1 = exec_with_status("secret check runpod.api_key 2>/dev/null")
    let s2 = exec_with_status("secret check huggingface.token 2>/dev/null")
    if s1[1] != 0 {
        eprintln("FAIL: runpod.api_key not in secret store")
        exit(1)
    }
    if s2[1] != 0 {
        eprintln("FAIL: huggingface.token not in secret store")
        exit(1)
    }
    println("[T4] secrets OK")

    println("[T5] HF LoRA target: " + HF_LORA_REPO + "@" + HF_LORA_REVISION)
    println("[T5] HF base:        " + HF_BASE_REPO)

    // own 16 Phase 2: probe watchdog tools (graceful warn-only)
    println("[T9] own 16 Phase 2 watchdog hooks:")
    println("       BG_LANE=" + BG_LANE + " TARGET_USD=$" + TARGET_USD)
    let _wr_ok = exec_with_status("test -f " + _sq(WATCHDOG_REGISTER))[1] == 0
    if _wr_ok { println("       T9a register OK: " + WATCHDOG_REGISTER) }
    else { println("       T9a register WARN missing: " + WATCHDOG_REGISTER) }
    let _wh_ok = exec_with_status("test -f " + _sq(WATCHDOG_HEXA))[1] == 0
    if _wh_ok { println("       T9b watchdog hexa OK: " + WATCHDOG_HEXA) }
    else { println("       T9b watchdog hexa WARN missing: " + WATCHDOG_HEXA) }
    println("       T9c heartbeat dir: " + WATCHDOG_HB_DIR)
    println("       T9d verdict schema: pod_kill_verified_404 + watchdog_deregistered + cost_{target,actual}_usd + cost_overrun_2x_alerted")

    println("[selftest] PASS")
    exit(0)
}

// ─── emit exec.bash + run_h100.bash ───────────────────────────────────────

fn _emit() {
    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))

    let exec_body = "#!/bin/bash\n" +
"# emitted by tool/p9_lora_mode1_eval_h100_orchestrator.hexa — Mode 1 LoRA-vs-base lifecycle\n" +
"# raw#9 sibling-pattern Mac-side bash. Regenerate via --emit. raw#37 H100 transient py.\n" +
"set -uo pipefail\n" +
"\n" +
"STATE_DIR='" + STATE_DIR + "'\n" +
"RESULTS_DIR='" + RESULTS_DIR + "'\n" +
"POD_INFO='" + POD_INFO_PATH + "'\n" +
"VERDICT='" + VERDICT_PATH + "'\n" +
"RUN_LOG='" + RUN_LOG_PATH + "'\n" +
"HEARTBEAT='" + HEARTBEAT_PATH + "'\n" +
"SSH_KEY='" + SSH_KEY + "'\n" +
"RUNPODCTL='" + RUNPODCTL + "'\n" +
"MAX_WALL_MIN=" + to_string(MAX_WALL_MIN) + "\n" +
"BUDGET_HARD_CAP=" + to_string(BUDGET_HARD_CAP_USD) + "\n" +
"OD_RATE=" + to_string(OD_RATE_USD) + "\n" +
"HF_LORA_REPO='" + HF_LORA_REPO + "'\n" +
"HF_LORA_REVISION='" + HF_LORA_REVISION + "'\n" +
"HF_BASE_REPO='" + HF_BASE_REPO + "'\n" +
"START_EPOCH=$(date -u +%s)\n" +
"\n" +
"log() { echo \"[$(date -u +%FT%TZ)] $*\" | tee -a \"$RUN_LOG\"; }\n" +
"hb()  { echo \"[$(date -u +%FT%TZ)] $*\" > \"$HEARTBEAT\"; }\n" +
"redact_hf() { sed -E 's/(HF_TOKEN[\"[:space:]]*[:=][\"[:space:]]*)hf_[A-Za-z0-9_]+/\\1<REDACTED>/g; s/(hf_)[A-Za-z0-9_]{20,}/\\1<REDACTED>/g'; }\n" +
"\n" +
"# ── Stage 0: secrets (use --raw to bypass claude-redaction wrapper) ──\n" +
"export RUNPOD_API_KEY=$(secret get --raw runpod.api_key 2>/dev/null)\n" +
"export HF_TOKEN_LOCAL=$(secret get --raw huggingface.token 2>/dev/null)\n" +
"if [ -z \"${RUNPOD_API_KEY:-}\" ] || [ -z \"${HF_TOKEN_LOCAL:-}\" ]; then\n" +
"    log \"FATAL: secrets unavailable\"\n" +
"    exit 2\n" +
"fi\n" +
"if [[ \"$RUNPOD_API_KEY\" == \\*\\*\\** ]] || [[ \"$HF_TOKEN_LOCAL\" == \\*\\*\\** ]]; then\n" +
"    log \"FATAL: secret returned redacted form despite --raw — wrapper broken\"\n" +
"    exit 2\n" +
"fi\n" +
"log \"secrets OK (runpod=${#RUNPOD_API_KEY}b, hf=${#HF_TOKEN_LOCAL}b)\"\n" +
"hb \"stage0_secrets_loaded\"\n" +
"\n" +
"# ── Stage 1: boot H100 pod (sed redact at boot, BEFORE tee — lesson L5) ──\n" +
"POD_NAME='anima-p9-lora-mode1-eval-2026-05-04'\n" +
"log \"booting pod=$POD_NAME (H100 80GB HBM3 secure on-demand @ \\$$OD_RATE/hr)\"\n" +
"BOOT_RAW_OUT=\"$STATE_DIR/boot.raw.tmp\"\n" +
"BOOT_OUT=\"$STATE_DIR/boot.log\"\n" +
"hb \"stage1_booting_pod\"\n" +
"$RUNPODCTL pod create \\\n" +
"    --name \"$POD_NAME\" \\\n" +
"    --gpu-id 'NVIDIA H100 80GB HBM3' \\\n" +
"    --gpu-count 1 \\\n" +
"    --image 'runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04' \\\n" +
"    --container-disk-in-gb 60 \\\n" +
"    --volume-in-gb 30 \\\n" +
"    --volume-mount-path /workspace \\\n" +
"    --ports '22/tcp,8888/http' \\\n" +
"    --cloud-type SECURE \\\n" +
"    --ssh \\\n" +
"    --env \"{\\\"HF_TOKEN\\\":\\\"$HF_TOKEN_LOCAL\\\"}\" \\\n" +
"    > \"$BOOT_RAW_OUT\" 2>&1\n" +
"BOOT_RC=$?\n" +
"# Redact BEFORE writing to long-lived log. Then delete raw.\n" +
"redact_hf < \"$BOOT_RAW_OUT\" > \"$BOOT_OUT\"\n" +
"rm -f \"$BOOT_RAW_OUT\"\n" +
"if [ $BOOT_RC -ne 0 ]; then\n" +
"    log \"FATAL: pod boot failed rc=$BOOT_RC\"\n" +
"    cat \"$BOOT_OUT\" | redact_hf | tee -a \"$RUN_LOG\"\n" +
"    jq -n --arg ts \"$(date -u +%FT%TZ)\" --arg reason \"pod_boot_failed\" '{cycle:\"" + CYCLE_TAG + "\",ts_utc:$ts,verdict:\"FAIL\",reason:$reason}' > \"$VERDICT\"\n" +
"    exit 3\n" +
"fi\n" +
"POD_ID=$(grep -oE '\"[a-z0-9]{14}\"' \"$BOOT_OUT\" | head -1 | tr -d '\"')\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    POD_ID=$(grep -oE 'pod [a-z0-9]{12,16}' \"$BOOT_OUT\" | head -1 | awk '{print $2}')\n" +
"fi\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    log \"FATAL: cannot extract pod_id\"\n" +
"    cat \"$BOOT_OUT\"\n" +
"    exit 4\n" +
"fi\n" +
"log \"pod_id=$POD_ID\"\n" +
"echo '{\"pod_id\":\"'$POD_ID'\",\"booted_ts\":\"'$(date -u +%FT%TZ)'\"}' > \"$POD_INFO\"\n" +
"hb \"stage1_pod_booted pod_id=$POD_ID\"\n" +
"\n" +
"# === own 16 Phase 2 watchdog hook (boot) ===\n" +
"BG_LANE='" + BG_LANE + "'\n" +
"TARGET_USD='" + TARGET_USD + "'\n" +
"WATCHDOG_REGISTER='" + WATCHDOG_REGISTER + "'\n" +
"WATCHDOG_HB_DIR='" + WATCHDOG_HB_DIR + "'\n" +
"WATCHDOG_HEXA='" + WATCHDOG_HEXA + "'\n" +
"WATCHDOG_REGISTERED=0\n" +
"if [ -f \"$WATCHDOG_REGISTER\" ]; then\n" +
"    if bash \"$WATCHDOG_REGISTER\" \"$POD_ID\" \"$BG_LANE\" \"$TARGET_USD\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"        WATCHDOG_REGISTERED=1\n" +
"        log \"[watchdog] register OK pod=$POD_ID lane=$BG_LANE target=\\$$TARGET_USD\"\n" +
"    else\n" +
"        log \"[watchdog] WARN register failed — proceeding without watchdog tracking\"\n" +
"    fi\n" +
"fi\n" +
"\n" +
"# ── Stage 1b: kill-on-exit trap MANDATORY ──\n" +
"# === own 16 Phase 2 watchdog hook (trap pre-stop) ===\n" +
"POD_KILL_VERIFIED_404=0\n" +
"WATCHDOG_DEREGISTERED=0\n" +
"_kill_pod() {\n" +
"    if [ -d \"$WATCHDOG_HB_DIR\" ]; then\n" +
"        echo \"EXITING $(date -u +%FT%TZ) pod=$POD_ID\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" || true\n" +
"    fi\n" +
"    log \"[trap] killing pod=$POD_ID (auto-kill mandatory)\"\n" +
"    $RUNPODCTL pod stop \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
"    $RUNPODCTL pod delete \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
"    POD_KILL_VERIFIED_404=0\n" +
"    for vi in 1 2 3; do\n" +
"        POST=$($RUNPODCTL pod get \"$POD_ID\" 2>&1 | head -3)\n" +
"        if echo \"$POST\" | grep -qiE 'not found|404|does not exist'; then\n" +
"            POD_KILL_VERIFIED_404=1\n" +
"            log \"[trap] 404 verified (try $vi/3)\"\n" +
"            break\n" +
"        fi\n" +
"        log \"[trap] 404 verify try $vi/3 not yet — sleep 30s\"\n" +
"        sleep 30\n" +
"    done\n" +
"    log \"[trap] post-kill: $POST  pod_kill_verified_404=$POD_KILL_VERIFIED_404\"\n" +
"    WATCHDOG_DEREGISTERED=0\n" +
"    if [ \"$POD_KILL_VERIFIED_404\" = \"1\" ] && [ -f \"$WATCHDOG_HEXA\" ]; then\n" +
"        if /Users/ghost/core/hexa-lang/hexa run \"$WATCHDOG_HEXA\" --deregister \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"            WATCHDOG_DEREGISTERED=1\n" +
"            log \"[watchdog] deregister OK pod=$POD_ID\"\n" +
"        fi\n" +
"    fi\n" +
"    if [ -f \"$POD_INFO\" ]; then\n" +
"        jq --arg killed \"$(date -u +%FT%TZ)\" --arg post \"$POST\" --argjson k404 \"$POD_KILL_VERIFIED_404\" --argjson wdd \"$WATCHDOG_DEREGISTERED\" \\\n" +
"            '. + {killed_ts:$killed, post_kill_status:$post, pod_kill_verified_404:($k404==1), watchdog_deregistered:($wdd==1)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\" || true\n" +
"    fi\n" +
"}\n" +
"trap _kill_pod EXIT INT TERM\n" +
"\n" +
"# ── Stage 2: wait for SSH (max 6min) ──\n" +
"log \"waiting for SSH ready (max 6min)\"\n" +
"hb \"stage2_waiting_ssh\"\n" +
"SSH_HOST=''\n" +
"SSH_PORT=''\n" +
"for i in $(seq 1 36); do\n" +
"    INFO=$($RUNPODCTL pod get \"$POD_ID\" -o json 2>/dev/null)\n" +
"    SSH_HOST=$(echo \"$INFO\" | jq -r '.ssh.ip // empty' 2>/dev/null)\n" +
"    SSH_PORT=$(echo \"$INFO\" | jq -r '.ssh.port // empty' 2>/dev/null)\n" +
"    if [ -n \"$SSH_HOST\" ] && [ \"$SSH_HOST\" != \"null\" ] && [ -n \"$SSH_PORT\" ] && [ \"$SSH_PORT\" != \"null\" ]; then\n" +
"        if ssh -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -p \"$SSH_PORT\" \"root@$SSH_HOST\" 'echo READY' 2>/dev/null | grep -q READY; then\n" +
"            log \"SSH ready at $SSH_HOST:$SSH_PORT (after ${i} probes)\"\n" +
"            break\n" +
"        fi\n" +
"    fi\n" +
"    sleep 10\n" +
"done\n" +
"if [ -z \"$SSH_HOST\" ] || [ \"$SSH_HOST\" = \"null\" ] || [ -z \"$SSH_PORT\" ] || [ \"$SSH_PORT\" = \"null\" ]; then\n" +
"    log \"FATAL: pod never reached SSH ready in 6min\"\n" +
"    exit 5\n" +
"fi\n" +
"jq --arg h \"$SSH_HOST\" --arg p \"$SSH_PORT\" '. + {ssh_host:$h, ssh_port:($p|tonumber)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\"\n" +
"hb \"stage2_ssh_ready host=$SSH_HOST port=$SSH_PORT\"\n" +
"\n" +
"SSH=\"ssh -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p $SSH_PORT root@$SSH_HOST\"\n" +
"SCP=\"scp -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $SSH_PORT\"\n" +
"\n" +
"# ── Stage 3: setup pod ──\n" +
"log \"setup: install lm-eval + peft + download Llama base + step-8k LoRA\"\n" +
"hb \"stage3_setup_starting\"\n" +
"$SSH 'mkdir -p /workspace/p9_lora_eval/results'\n" +
"$SCP \"" + RUN_H100_PATH + "\" \"root@$SSH_HOST:/workspace/p9_lora_eval/run_h100.bash\" 2>&1 | tail -1\n" +
"$SSH 'chmod +x /workspace/p9_lora_eval/run_h100.bash'\n" +
"\n" +
"# Launch detached. Source HF_TOKEN from /proc/1/environ (runpodctl --env injects to PID1 only).\n" +
"log \"launching benchmark suite on H100\"\n" +
"$SSH 'cat /proc/1/environ | tr \"\\0\" \"\\n\" | grep ^HF_TOKEN= > /workspace/p9_lora_eval/hf_token.env && cd /workspace/p9_lora_eval && set -a && . hf_token.env && set +a && nohup bash run_h100.bash > orchestrator.log 2>&1 & echo $! > run.pid; disown $! 2>/dev/null || true; sleep 2; cat run.pid'\n" +
"hb \"stage3_h100_launched\"\n" +
"\n" +
"# ── Stage 4: poll loop (heartbeat each cycle) ──\n" +
"log \"poll loop start (max ${MAX_WALL_MIN}min, budget cap \\$${BUDGET_HARD_CAP})\"\n" +
"COMPLETE=0\n" +
"POLL_INTERVAL=60  # 1-min poll for snappy auto-kill (lesson L3 sharpened)\n" +
"while true; do\n" +
"    NOW=$(date -u +%s)\n" +
"    ELAPSED_MIN=$(( (NOW - START_EPOCH) / 60 ))\n" +
"    ELAPSED_HR_DEC=$(awk \"BEGIN{printf \\\"%.4f\\\", ($NOW - $START_EPOCH) / 3600}\")\n" +
"    ELAPSED_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $ELAPSED_HR_DEC * $OD_RATE}\")\n" +
"\n" +
"    COST_OVER=$(awk \"BEGIN{print ($ELAPSED_COST > $BUDGET_HARD_CAP) ? 1 : 0}\")\n" +
"    if [ \"$COST_OVER\" = \"1\" ]; then\n" +
"        log \"COST CAP HIT \\$$ELAPSED_COST > \\$$BUDGET_HARD_CAP — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"    if [ $ELAPSED_MIN -ge $MAX_WALL_MIN ]; then\n" +
"        log \"WALL CAP HIT ${ELAPSED_MIN}min ≥ ${MAX_WALL_MIN}min — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    PROBE=$($SSH 'ls /workspace/p9_lora_eval/results/COMPLETE.sentinel 2>/dev/null && echo SENTINEL_FOUND; ps -p $(cat /workspace/p9_lora_eval/run.pid 2>/dev/null) -o pid,etime,comm 2>/dev/null | tail -1' 2>/dev/null)\n" +
"    log \"elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|')\"\n" +
"    hb \"poll elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|' | head -c 200)\"\n" +
"\n" +
"    # === own 16 Phase 2 watchdog hook (heartbeat) ===\n" +
"    if [ -n \"${WATCHDOG_HB_DIR:-}\" ]; then\n" +
"        mkdir -p \"$WATCHDOG_HB_DIR\" 2>/dev/null || true\n" +
"        echo \"poll $(date -u +%FT%TZ) pod=$POD_ID elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST}\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" 2>/dev/null || true\n" +
"    fi\n" +
"\n" +
"    # incremental sync (small JSONs only)\n" +
"    $SCP -r \"root@$SSH_HOST:/workspace/p9_lora_eval/results/*.json\" \"$RESULTS_DIR/\" 2>/dev/null || true\n" +
"    $SCP \"root@$SSH_HOST:/workspace/p9_lora_eval/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>/dev/null || true\n" +
"\n" +
"    if echo \"$PROBE\" | grep -q SENTINEL_FOUND; then\n" +
"        log \"COMPLETE.sentinel detected — final sync FIRST then auto-kill (lesson: don't lose data)\"\n" +
"        COMPLETE=1\n" +
"        # final sync — fetch results FIRST before kill (lesson 5)\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/p9_lora_eval/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -5 | tee -a \"$RUN_LOG\" || true\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_lora_eval/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>&1 | tail -1 || true\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    sleep $POLL_INTERVAL\n" +
"done\n" +
"\n" +
"# ── Stage 5: pod kill via trap (auto on exit) ──\n" +
"# trap _kill_pod fires when this script exits.\n" +
"\n" +
"# ── Stage 6: verdict (per-bench numeric extraction + c3/c4 gates) ──\n" +
"log \"computing verdict from per-bench JSONs\"\n" +
"FINAL_ELAPSED_MIN=$(( ($(date -u +%s) - START_EPOCH) / 60 ))\n" +
"FINAL_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $FINAL_ELAPSED_MIN/60 * $OD_RATE}\")\n" +
"hb \"stage6_verdict_computing\"\n" +
"\n" +
"BENCH_COUNT=$(ls $RESULTS_DIR/lora_*.json 2>/dev/null | wc -l | awk '{print $1}')\n" +
"\n" +
"# Llama base anchors (BG-Ο 93bef8c8)\n" +
"LB_HS_NORM=0.654\n" +
"LB_HS_SE=0.02129\n" +
"LB_MM_ACC=0.5796\n" +
"LB_MM_SE=0.00428\n" +
"LB_TQ_EM=0.396\n" +
"LB_TQ_SE=0.02189\n" +
"\n" +
"# Random + 5pp baselines\n" +
"R5_HS=0.30   # random 0.25 + 0.05\n" +
"R5_MM=0.30   # random 0.25 + 0.05\n" +
"R5_TQ=0.05   # random ~0 + 0.05\n" +
"\n" +
"# Extract LoRA metrics\n" +
"LR_HS_ACC=\"null\"; LR_HS_NORM=\"null\"; LR_HS_SE=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/lora_hellaswag.json\" ]; then\n" +
"    LR_HS_ACC=$(jq -r '.results.hellaswag.\"acc,none\" // .results.hellaswag.acc // \"null\"' \"$RESULTS_DIR/lora_hellaswag.json\")\n" +
"    LR_HS_NORM=$(jq -r '.results.hellaswag.\"acc_norm,none\" // .results.hellaswag.acc_norm // \"null\"' \"$RESULTS_DIR/lora_hellaswag.json\")\n" +
"    LR_HS_SE=$(jq -r '.results.hellaswag.\"acc_norm_stderr,none\" // .results.hellaswag.acc_norm_stderr // \"null\"' \"$RESULTS_DIR/lora_hellaswag.json\")\n" +
"fi\n" +
"LR_MM_ACC=\"null\"; LR_MM_SE=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/lora_mmlu.json\" ]; then\n" +
"    LR_MM_ACC=$(jq -r '.results.mmlu.\"acc,none\" // .results.mmlu.acc // \"null\"' \"$RESULTS_DIR/lora_mmlu.json\")\n" +
"    LR_MM_SE=$(jq -r '.results.mmlu.\"acc_stderr,none\" // .results.mmlu.acc_stderr // \"null\"' \"$RESULTS_DIR/lora_mmlu.json\")\n" +
"fi\n" +
"LR_TQ_EM=\"null\"; LR_TQ_SE=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/lora_triviaqa.json\" ]; then\n" +
"    LR_TQ_EM=$(jq -r '.results.triviaqa.\"exact_match,remove_whitespace\" // .results.triviaqa.\"exact_match,none\" // .results.triviaqa.exact_match // \"null\"' \"$RESULTS_DIR/lora_triviaqa.json\")\n" +
"    LR_TQ_SE=$(jq -r '.results.triviaqa.\"exact_match_stderr,remove_whitespace\" // .results.triviaqa.\"exact_match_stderr,none\" // .results.triviaqa.exact_match_stderr // \"null\"' \"$RESULTS_DIR/lora_triviaqa.json\")\n" +
"fi\n" +
"\n" +
"# c3 helper: |LoRA - Llama_base| ≥ 2 × max(LoRA_se, Llama_se)\n" +
"c3_check() {\n" +
"    local lora=$1; local base=$2; local lse=$3; local bse=$4\n" +
"    if [ \"$lora\" = \"null\" ]; then echo \"MISSING|null|null\"; return; fi\n" +
"    awk \"BEGIN{\n" +
"        d = ($lora - $base);\n" +
"        ad = (d < 0) ? -d : d;\n" +
"        m = ($lse > $bse) ? $lse : $bse;\n" +
"        thr = 2 * m;\n" +
"        delta_pp = d * 100;\n" +
"        thr_pp = thr * 100;\n" +
"        if (ad >= thr) print \"PASS|\" delta_pp \"|\" thr_pp;\n" +
"        else            print \"FAIL|\" delta_pp \"|\" thr_pp;\n" +
"    }\"\n" +
"}\n" +
"# c4 helper: LoRA ≥ random + 5pp\n" +
"c4_check() {\n" +
"    local lora=$1; local r5=$2\n" +
"    if [ \"$lora\" = \"null\" ]; then echo \"MISSING\"; return; fi\n" +
"    awk \"BEGIN{ if ($lora >= $r5) print \\\"PASS\\\"; else print \\\"FAIL\\\" }\"\n" +
"}\n" +
"\n" +
"HS_C3_LINE=$(c3_check \"$LR_HS_NORM\" $LB_HS_NORM \"$LR_HS_SE\" $LB_HS_SE)\n" +
"MM_C3_LINE=$(c3_check \"$LR_MM_ACC\"  $LB_MM_ACC  \"$LR_MM_SE\" $LB_MM_SE)\n" +
"TQ_C3_LINE=$(c3_check \"$LR_TQ_EM\"   $LB_TQ_EM   \"$LR_TQ_SE\" $LB_TQ_SE)\n" +
"HS_C3=$(echo $HS_C3_LINE | cut -d'|' -f1); HS_DELTA_PP=$(echo $HS_C3_LINE | cut -d'|' -f2); HS_C3_THR_PP=$(echo $HS_C3_LINE | cut -d'|' -f3)\n" +
"MM_C3=$(echo $MM_C3_LINE | cut -d'|' -f1); MM_DELTA_PP=$(echo $MM_C3_LINE | cut -d'|' -f2); MM_C3_THR_PP=$(echo $MM_C3_LINE | cut -d'|' -f3)\n" +
"TQ_C3=$(echo $TQ_C3_LINE | cut -d'|' -f1); TQ_DELTA_PP=$(echo $TQ_C3_LINE | cut -d'|' -f2); TQ_C3_THR_PP=$(echo $TQ_C3_LINE | cut -d'|' -f3)\n" +
"\n" +
"HS_C4=$(c4_check \"$LR_HS_NORM\" $R5_HS)\n" +
"MM_C4=$(c4_check \"$LR_MM_ACC\"  $R5_MM)\n" +
"TQ_C4=$(c4_check \"$LR_TQ_EM\"   $R5_TQ)\n" +
"\n" +
"# c3 / c4 ≥2/3 PASS rule\n" +
"C3_PASS_COUNT=0\n" +
"for g in $HS_C3 $MM_C3 $TQ_C3; do [ \"$g\" = \"PASS\" ] && C3_PASS_COUNT=$((C3_PASS_COUNT+1)); done\n" +
"C4_PASS_COUNT=0\n" +
"for g in $HS_C4 $MM_C4 $TQ_C4; do [ \"$g\" = \"PASS\" ] && C4_PASS_COUNT=$((C4_PASS_COUNT+1)); done\n" +
"\n" +
"C3_VERDICT='FAIL'; [ $C3_PASS_COUNT -ge 2 ] && C3_VERDICT='PASS'\n" +
"C4_VERDICT='FAIL'; [ $C4_PASS_COUNT -ge 2 ] && C4_VERDICT='PASS'\n" +
"\n" +
"# Overall Mode 1 verdict\n" +
"VERDICT_LABEL='FAIL'\n" +
"if [ \"$C3_VERDICT\" = \"PASS\" ] && [ \"$C4_VERDICT\" = \"PASS\" ]; then\n" +
"    VERDICT_LABEL='PASS'\n" +
"elif [ \"$C3_VERDICT\" = \"PASS\" ] || [ \"$C4_VERDICT\" = \"PASS\" ]; then\n" +
"    VERDICT_LABEL='PARTIAL'\n" +
"fi\n" +
"\n" +
"# F1_v3 V2 cumulative (post-this-cycle):\n" +
"#   c1 anchors_run PASS (BG-Ο)\n" +
"#   c2 llama±10% PASS (BG-Ο, 2/3)\n" +
"#   c3 lora-base 2σ → from this cycle\n" +
"#   c4 lora≥random+5pt → from this cycle\n" +
"# Mapping:\n" +
"#   all 4 PASS → SUCCESS\n" +
"#   c1+c2+c3 PASS, c4 FAIL → COMPARATIVE_PASS\n" +
"#   c1+c2 PASS, c3 FAIL but c4 PASS → ANCHOR_PASS (anchors valid; LoRA above random but not statistically separated from base)\n" +
"#   c1+c2 PASS, c3 FAIL, c4 FAIL → FAIL (catastrophic forgetting hypothesis)\n" +
"#   any of c3/c4 partial (1 of 3 benchmarks) → PARTIAL_v3_AMEND\n" +
"F1_V3_V2='FAIL'\n" +
"if [ \"$C3_VERDICT\" = \"PASS\" ] && [ \"$C4_VERDICT\" = \"PASS\" ]; then\n" +
"    F1_V3_V2='SUCCESS'\n" +
"elif [ \"$C3_VERDICT\" = \"PASS\" ] && [ \"$C4_VERDICT\" = \"FAIL\" ]; then\n" +
"    F1_V3_V2='COMPARATIVE_PASS'\n" +
"elif [ \"$C3_VERDICT\" = \"FAIL\" ] && [ \"$C4_VERDICT\" = \"PASS\" ]; then\n" +
"    F1_V3_V2='ANCHOR_PASS'\n" +
"elif [ $C3_PASS_COUNT -ge 1 ] || [ $C4_PASS_COUNT -ge 1 ]; then\n" +
"    F1_V3_V2='PARTIAL_v3_AMEND'\n" +
"fi\n" +
"\n" +
"POD_KILL_404='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    POST=$(jq -r '.post_kill_status // \"\"' \"$POD_INFO\" 2>/dev/null)\n" +
"    if echo \"$POST\" | grep -qiE 'not found|404|no such|does not exist'; then\n" +
"        POD_KILL_404='true'\n" +
"    fi\n" +
"fi\n" +
"\n" +
"# === own 16 Phase 2 verdict schema (cost-discipline fields) ===\n" +
"COST_TARGET_USD=$TARGET_USD\n" +
"COST_ACTUAL_USD=$FINAL_COST\n" +
"COST_OVERRUN_RATIO=$(awk -v a=\"$COST_ACTUAL_USD\" -v t=\"$COST_TARGET_USD\" 'BEGIN{ if (t+0 > 0) printf \"%.4f\", a/t; else print \"0\" }')\n" +
"COST_OVERRUN_2X_ALERTED='false'\n" +
"if awk -v r=\"$COST_OVERRUN_RATIO\" 'BEGIN{exit !(r+0 >= 2.0)}'; then COST_OVERRUN_2X_ALERTED='true'; fi\n" +
"WATCHDOG_DEREGISTERED_FINAL='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    WD_TMP=$(jq -r '.watchdog_deregistered // false' \"$POD_INFO\" 2>/dev/null)\n" +
"    if [ \"$WD_TMP\" = \"true\" ]; then WATCHDOG_DEREGISTERED_FINAL='true'; fi\n" +
"fi\n" +
"\n" +
"jq -n \\\n" +
"    --arg cycle \"" + CYCLE_TAG + "\" \\\n" +
"    --arg ts \"$(date -u +%FT%TZ)\" \\\n" +
"    --arg model \"$HF_BASE_REPO + $HF_LORA_REPO@$HF_LORA_REVISION (step-8k LoRA)\" \\\n" +
"    --arg pod \"$POD_ID\" \\\n" +
"    --argjson kill_404 \"$POD_KILL_404\" \\\n" +
"    --argjson wd_dereg \"$WATCHDOG_DEREGISTERED_FINAL\" \\\n" +
"    --argjson cost_target \"$COST_TARGET_USD\" \\\n" +
"    --argjson cost_actual \"$COST_ACTUAL_USD\" \\\n" +
"    --argjson cost_ratio \"$COST_OVERRUN_RATIO\" \\\n" +
"    --argjson cost_2x \"$COST_OVERRUN_2X_ALERTED\" \\\n" +
"    --arg verdict \"$VERDICT_LABEL\" \\\n" +
"    --arg c3v \"$C3_VERDICT\" --arg c4v \"$C4_VERDICT\" \\\n" +
"    --arg f1v3v2 \"$F1_V3_V2\" \\\n" +
"    --arg hs_acc \"$LR_HS_ACC\" --arg hs_norm \"$LR_HS_NORM\" --arg hs_se \"$LR_HS_SE\" \\\n" +
"    --arg hs_c3 \"$HS_C3\" --arg hs_c4 \"$HS_C4\" --arg hs_d \"$HS_DELTA_PP\" --arg hs_thr \"$HS_C3_THR_PP\" \\\n" +
"    --arg mm_acc \"$LR_MM_ACC\" --arg mm_se \"$LR_MM_SE\" \\\n" +
"    --arg mm_c3 \"$MM_C3\" --arg mm_c4 \"$MM_C4\" --arg mm_d \"$MM_DELTA_PP\" --arg mm_thr \"$MM_C3_THR_PP\" \\\n" +
"    --arg tq_em \"$LR_TQ_EM\" --arg tq_se \"$LR_TQ_SE\" \\\n" +
"    --arg tq_c3 \"$TQ_C3\" --arg tq_c4 \"$TQ_C4\" --arg tq_d \"$TQ_DELTA_PP\" --arg tq_thr \"$TQ_C3_THR_PP\" \\\n" +
"    --argjson wall \"$FINAL_ELAPSED_MIN\" \\\n" +
"    --argjson cost \"$FINAL_COST\" \\\n" +
"    --argjson n \"$BENCH_COUNT\" \\\n" +
"    --argjson complete \"$COMPLETE\" \\\n" +
"    '{\n" +
"        cycle: $cycle, ts_utc: $ts,\n" +
"        model: $model,\n" +
"        scope: \"Mode 1 — LoRA(step-8k)-vs-Llama-base internal Δ on 3 benchmarks (limit=500, seeds=42, bfloat16)\",\n" +
"        pod_id: $pod, pod_terminated: true, pod_kill_verified_404: $kill_404,\n" +
"        verdict: $verdict,\n" +
"        results_per_benchmark: {\n" +
"            hellaswag: {acc: $hs_acc, acc_norm: $hs_norm, stderr: $hs_se,\n" +
"                        llama_base_acc_norm: 0.654, llama_base_stderr: 0.02129,\n" +
"                        delta_vs_llama_base_pp: $hs_d, c3_2_sigma_threshold_pp: $hs_thr,\n" +
"                        c3_pass: ($hs_c3==\"PASS\"), c4_above_random5pt: ($hs_c4==\"PASS\")},\n" +
"            mmlu:      {acc: $mm_acc, stderr: $mm_se,\n" +
"                        llama_base_acc: 0.5796, llama_base_stderr: 0.00428,\n" +
"                        delta_vs_llama_base_pp: $mm_d, c3_2_sigma_threshold_pp: $mm_thr,\n" +
"                        c3_pass: ($mm_c3==\"PASS\"), c4_above_random5pt: ($mm_c4==\"PASS\"), fewshot: 5},\n" +
"            triviaqa:  {exact_match: $tq_em, stderr: $tq_se,\n" +
"                        llama_base_em: 0.396, llama_base_stderr: 0.02189,\n" +
"                        delta_vs_llama_base_pp: $tq_d, c3_2_sigma_threshold_pp: $tq_thr,\n" +
"                        c3_pass: ($tq_c3==\"PASS\"), c4_above_random5pt: ($tq_c4==\"PASS\"),\n" +
"                        filter: \"remove_whitespace\"}\n" +
"        },\n" +
"        f1_v3_amended_criterion_3_lora_base_2_sigma: $c3v,\n" +
"        f1_v3_amended_criterion_4_lora_above_random_5pt: $c4v,\n" +
"        f1_v3_v2_full_verdict_with_bg_xi_amendment: $f1v3v2,\n" +
"        bench_count_completed: $n,\n" +
"        complete_sentinel_detected: ($complete == 1),\n" +
"        wall_time_min: $wall,\n" +
"        actual_cost_usd: $cost,\n" +
"        budget_target_usd: 1.50,\n" +
"        budget_hard_cap_usd: 2.50,\n" +
"        pod_kill_verified_404: $kill_404,\n" +
"        watchdog_deregistered: $wd_dereg,\n" +
"        cost_target_usd: $cost_target,\n" +
"        cost_actual_usd: $cost_actual,\n" +
"        cost_overrun_ratio: $cost_ratio,\n" +
"        cost_overrun_2x_alerted: $cost_2x,\n" +
"        lessons_applied: {\n" +
"            L1_sentinel_name: \"results/COMPLETE.sentinel\",\n" +
"            L2_skip_unneeded_setup: \"Llama-only download (no CLM)\",\n" +
"            L3_sentinel_kill_lag_s: \"poll interval 60s ⇒ ≤90s detection→kill\",\n" +
"            L4_single_process_heartbeat: \"heartbeat.txt from main exec.bash\",\n" +
"            L5_redact_at_boot: \"sed redact pre-tee for boot.log\",\n" +
"            L6_data_first_then_kill: \"final scp before trap fires\"\n" +
"        },\n" +
"        honest_c3: [\n" +
"            \"Anchor is step-8000 LoRA NOT preregistered step-10000 (per BG-ξ verify_report; 2000 steps lost during HF push race) — Δ vs base may be ~5-10% underestimated relative to fully-trained adapter\",\n" +
"            \"limit=500 ⇒ stderr ~2pp on hellaswag/triviaqa; on tight 2σ thresholds (~4pp) borderline c3 calls are noise-sensitive\",\n" +
"            \"adapter base mismatch caveat: HF adapter_config declares base = Llama-3.2-3B-Instruct; we compose onto Llama-3.2-3B (non-Instruct, BG-Ο anchor). Numerical drift expected from BOS/template behavior; verify lm-eval logs for chat-template warnings\",\n" +
"            \"Single seed (42); per-prompt variance not characterized — full c3 confidence interval would require multi-seed (≥3) with paired bootstrap\",\n" +
"            \"H100 bf16 + lm-eval 0.4.11 vendor-default decode params; LoRA inference_mode=true (no merge); slight numeric drift vs eval-time merge\"\n" +
"        ]\n" +
"    }' > \"$VERDICT\"\n" +
"\n" +
"log \"verdict=$VERDICT_LABEL c3=$C3_VERDICT($C3_PASS_COUNT/3) c4=$C4_VERDICT($C4_PASS_COUNT/3) f1v3v2=$F1_V3_V2 wall=${FINAL_ELAPSED_MIN}min cost=\\$${FINAL_COST}\"\n" +
"log \"hs: norm=$LR_HS_NORM Δ=${HS_DELTA_PP}pp c3=$HS_C3 c4=$HS_C4   mmlu: acc=$LR_MM_ACC Δ=${MM_DELTA_PP}pp c3=$MM_C3 c4=$MM_C4   tq: em=$LR_TQ_EM Δ=${TQ_DELTA_PP}pp c3=$TQ_C3 c4=$TQ_C4\"\n" +
"hb \"verdict=$VERDICT_LABEL c3=$C3_VERDICT c4=$C4_VERDICT f1v3v2=$F1_V3_V2\"\n" +
"echo \"__P9_LORA_MODE1_EVAL__ $VERDICT_LABEL F1V3V2=$F1_V3_V2\" | tee -a \"$RUN_LOG\"\n" +
"exit 0\n"

    write_file(EXEC_BASH_PATH, exec_body)
    exec_with_status("chmod +x " + _sq(EXEC_BASH_PATH))
    println("[emit] " + EXEC_BASH_PATH)

    let run_h100 = "#!/bin/bash\n" +
"# emitted by tool/p9_lora_mode1_eval_h100_orchestrator.hexa — H100-side LoRA eval runner\n" +
"# raw#37 transient: Python on Linux (lm_eval + peft) permitted; killed with pod.\n" +
"set -uo pipefail\n" +
"\n" +
"WORK=/workspace/p9_lora_eval\n" +
"cd $WORK\n" +
"export HF_TOKEN=\"${HF_TOKEN}\"\n" +
"export HF_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export HUGGING_FACE_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\n" +
"export PYTHONUNBUFFERED=1\n" +
"\n" +
"LLAMA_ID='" + HF_BASE_REPO + "'\n" +
"LORA_ID='" + HF_LORA_REPO + "'\n" +
"LORA_REV='" + HF_LORA_REVISION + "'\n" +
"RESULTS=$WORK/results\n" +
"mkdir -p $RESULTS\n" +
"\n" +
"echo \"[orch] start ts=$(date -u +%FT%TZ)\"\n" +
"\n" +
"# Setup: install lm-eval + peft + transformers + datasets\n" +
"echo \"[setup] installing lm-eval + peft + huggingface_hub\"\n" +
"pip install -q --no-input huggingface_hub 'lm-eval==0.4.11' 'transformers>=4.45' 'peft>=0.12' accelerate datasets 2>&1 | tail -10\n" +
"\n" +
"# Auth\n" +
"hf auth login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -2 || \\\n" +
"    huggingface-cli login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -2 || true\n" +
"echo \"[setup] hf auth: $(hf auth whoami 2>&1 | head -1 || huggingface-cli whoami 2>&1 | head -1)\"\n" +
"\n" +
"# Download Llama base (~6GB)\n" +
"echo \"[setup] downloading $LLAMA_ID\"\n" +
"hf download \"$LLAMA_ID\" 2>&1 | tail -5 || \\\n" +
"    huggingface-cli download \"$LLAMA_ID\" 2>&1 | tail -5\n" +
"\n" +
"# Download step-8k LoRA adapter (~389MB) at pinned revision to LOCAL DIR.\n" +
"# CRITICAL: lm-eval `revision=` flag applies to the BASE pretrained model, NOT to the peft\n" +
"# adapter (which has its own `peft=` arg). Passing revision=<lora_sha> caused 404 against the\n" +
"# Llama base. Fix: pre-download LoRA at pinned revision, then pass peft=<local_dir>.\n" +
"LORA_LOCAL_DIR=\"$WORK/lora_step8k\"\n" +
"echo \"[setup] downloading $LORA_ID@$LORA_REV → $LORA_LOCAL_DIR (step-8k LoRA)\"\n" +
"mkdir -p \"$LORA_LOCAL_DIR\"\n" +
"hf download \"$LORA_ID\" --revision \"$LORA_REV\" --local-dir \"$LORA_LOCAL_DIR\" 2>&1 | tail -5 || \\\n" +
"    huggingface-cli download \"$LORA_ID\" --revision \"$LORA_REV\" --local-dir \"$LORA_LOCAL_DIR\" 2>&1 | tail -5\n" +
"# Verify adapter files present\n" +
"if [ ! -f \"$LORA_LOCAL_DIR/adapter_model.safetensors\" ] || [ ! -f \"$LORA_LOCAL_DIR/adapter_config.json\" ]; then\n" +
"    echo \"[FATAL] LoRA adapter files missing in $LORA_LOCAL_DIR\"\n" +
"    ls -la \"$LORA_LOCAL_DIR\" 2>&1\n" +
"    # still emit sentinel so orchestrator auto-kills cleanly\n" +
"    echo \"{\\\"ok\\\": false, \\\"error\\\": \\\"lora_download_failed\\\", \\\"finished_at\\\": \\\"$(date -u +%FT%TZ)\\\"}\" > $RESULTS/COMPLETE.sentinel\n" +
"    exit 1\n" +
"fi\n" +
"echo \"[setup] LoRA adapter present: $(du -sh $LORA_LOCAL_DIR/adapter_model.safetensors | awk '{print $1}')\"\n" +
"\n" +
"echo \"[orch] lm_eval=$(pip show lm-eval 2>/dev/null | grep Version | awk '{print $2}')\"\n" +
"echo \"[orch] peft=$(pip show peft 2>/dev/null | grep Version | awk '{print $2}')\"\n" +
"echo \"[orch] torch=$(python -c 'import torch; print(torch.__version__)')\"\n" +
"nvidia-smi --query-gpu=name,memory.total --format=csv | head -2\n" +
"\n" +
"# Verify peft= flag is supported in this lm-eval version (0.4.11 supports peft= in model_args).\n" +
"# Reference: lm-eval-harness/lm_eval/models/huggingface.py — HFLM accepts `peft` kwarg, attaches\n" +
"# PeftModel.from_pretrained(model, peft) after base load.\n" +
"\n" +
"run_bench() {\n" +
"    local tkey=$1; local task=$2; local nshot=$3\n" +
"    local out=$RESULTS/lora_${tkey}_dir\n" +
"    local log=$RESULTS/${tkey}.log\n" +
"    echo \"[run] task=$task n=$nshot → $out\"\n" +
"    local t0=$(date -u +%s)\n" +
"    # peft= argument: standard lm-eval composition. NOTE: revision= is intentionally OMITTED\n" +
"    # because it applies to the BASE pretrained model, not the peft adapter. The adapter is\n" +
"    # already pinned via $LORA_LOCAL_DIR (downloaded at $LORA_REV in setup).\n" +
"    # The base 'pretrained' uses the non-Instruct Llama-3.2-3B (matches BG-Ο anchor).\n" +
"    lm_eval --model hf \\\n" +
"        --model_args \"pretrained=${LLAMA_ID},peft=${LORA_LOCAL_DIR},dtype=bfloat16,trust_remote_code=False\" \\\n" +
"        --tasks \"$task\" \\\n" +
"        --num_fewshot \"$nshot\" \\\n" +
"        --batch_size 16 \\\n" +
"        --device cuda:0 \\\n" +
"        --seed 42 \\\n" +
"        --limit 500 \\\n" +
"        --log_samples \\\n" +
"        --output_path \"$out\" \\\n" +
"        > \"$log\" 2>&1\n" +
"    local rc=$?\n" +
"    local t1=$(date -u +%s)\n" +
"    local wall=$((t1 - t0))\n" +
"    echo \"[done] task=$task rc=$rc wall=${wall}s\"\n" +
"    if [ $rc -ne 0 ]; then\n" +
"        echo \"[FAIL] tail of $log:\"; tail -50 \"$log\"\n" +
"    fi\n" +
"    if [ -d \"$out\" ]; then\n" +
"        find \"$out\" -name 'results*.json' -exec cp {} $RESULTS/lora_${tkey}.json \\;\n" +
"    fi\n" +
"    return $rc\n" +
"}\n" +
"\n" +
"# 3 jobs: LoRA × HellaSwag (0-shot acc_norm), MMLU (5-shot), TriviaQA (0-shot EM)\n" +
"# Same fewshot pattern as BG-Ο Llama base anchors for direct Δ computation.\n" +
"\n" +
"run_bench 'hellaswag' 'hellaswag' 0\n" +
"run_bench 'mmlu' 'mmlu' 5\n" +
"run_bench 'triviaqa' 'triviaqa' 0\n" +
"\n" +
"# completion sentinel — STANDARDIZED NAME per lesson L1\n" +
"echo \"{\\\"ok\\\": true, \\\"finished_at\\\": \\\"$(date -u +%FT%TZ)\\\", \\\"benchmarks\\\": [\\\"hellaswag\\\", \\\"mmlu\\\", \\\"triviaqa\\\"]}\" > $RESULTS/COMPLETE.sentinel\n" +
"echo \"[orch] complete\"\n"

    write_file(RUN_H100_PATH, run_h100)
    exec_with_status("chmod +x " + _sq(RUN_H100_PATH))
    println("[emit] " + RUN_H100_PATH)
    println("[emit] OK")
}

// ─── kill (emergency) ─────────────────────────────────────────────────────

fn _kill(pod_id: string) {
    if pod_id == "" {
        eprintln("ERROR: --kill requires <pod_id> argument")
        exit(1)
    }
    println("[kill] pod=" + pod_id)
    exec_with_status(_sq(RUNPODCTL) + " stop pod " + _sq(pod_id))
    exec_with_status("sleep 5")
    exec_with_status(_sq(RUNPODCTL) + " remove pod " + _sq(pod_id))
    let r = exec_with_status(_sq(RUNPODCTL) + " get pod " + _sq(pod_id) + " -o json 2>&1 | head -1")
    println("[kill] post-status: " + to_string(r[0]).trim())
}

// ─── main ─────────────────────────────────────────────────────────────────

fn main() {
    let av = _argv()

    if _flag(av, "--selftest") {
        _selftest()
        return
    }
    if _flag(av, "--kill") {
        _kill(_opt(av, "--kill", ""))
        return
    }
    if _flag(av, "--emit") {
        _emit()
        return
    }
    if _flag(av, "--launch") {
        _emit()
        println("[launch] dispatching " + EXEC_BASH_PATH)
        let r = exec_with_status("bash " + _sq(EXEC_BASH_PATH))
        println("[launch] rc=" + to_string(r[1]))
        return
    }

    println("USAGE: hexa run tool/p9_lora_mode1_eval_h100_orchestrator.hexa [--selftest|--emit|--launch|--kill <pod_id>]")
}

main()
