// tool/clm_v4_lora_train_orchestrator_opt_b.hexa — CLM v4 + LoRA SFT OPT-B (cross_attn) lifecycle orchestrator
//
// PURPOSE
//   BG-OPT-B-CROSS-ATTN-RETRAIN: Phase 3 H100 retrain sibling of CLM-2-EXEC v1.
//   Per docs/clm_v4_lora_sft_opt_b_cross_attn_retrain_spec_2026_05_05.md (Q1-B/Q2-A/Q3-A/Q4-A LOCKED):
//     - target_modules: self-attn qkvo + cross_attn qkvo (16 layers × 8 = 128 modules)
//     - LR 5e-6 (10× lower vs v1's 3e-5) — cross_attn φ★-flip mitigation
//     - dropout 0.10 (2× v1's 0.05)
//     - max_steps 3000 (50% v1's 6000)
//     - φ★ probe every 500 steps; ABORT if drift > -10pp from in-pipeline base 35.81
//     - target $30 (mid of $20-50 phase 3 envelope; hard cap $50)
//
// SPEC SOURCE
//   docs/clm_v4_lora_sft_opt_b_cross_attn_retrain_spec_2026_05_05.md (LANDED)
//   Parent v1: tool/clm_v4_lora_train_orchestrator.hexa (UNTOUCHED — sibling pattern raw#15)
//   In-pipeline phi anchor: state/clm_v4_lora_phi_canonical_2026_05_05/verdict.json (35.81 mean K=8)
//
// raw#9   hexa-only Mac (this file is hexa)
// raw#10  honest C3 ≥5 in verdict
// raw#15  additive sibling — does NOT mutate parent orchestrator or v1 train script
// raw#37  transient-py-on-Linux: H100 runs train + eval (Python permitted there only)
// raw#71  pre-registered F-OPT-B-1..5 thresholds LOCKED at spec land
//
// USAGE
//   hexa run tool/clm_v4_lora_train_orchestrator_opt_b.hexa --selftest
//   hexa run tool/clm_v4_lora_train_orchestrator_opt_b.hexa --emit
//   hexa run tool/clm_v4_lora_train_orchestrator_opt_b.hexa --launch     // REQUIRES USER COST ACK
//   hexa run tool/clm_v4_lora_train_orchestrator_opt_b.hexa --kill <pod_id>
//
// SAFETY CAPS (raw#71 hard-coded per spec §5 Phase 3)
//   max_wall_minutes    = 300   (5h hard pod kill — plan ~3-5h)
//   budget_target_usd   = 30    (mid of $20-50 spec envelope)
//   budget_hard_cap_usd = 50    (Phase 3 hard cap; Phase 4 separate)

let SCHEMA              = "anima/clm_v4_lora_sft_opt_b/orchestrator/1"
let CYCLE_TAG           = "clm_v4_lora_sft_opt_b_2026_05_05"
let STATE_DIR           = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05"
let EXEC_BASH_PATH      = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/exec.bash"
let RUN_H100_PATH       = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/run_h100.bash"
let POD_INFO_PATH       = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/pod_info.json"
let VERDICT_PATH        = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/verdict.json"
let RUN_LOG_PATH        = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/run.log"
let HEARTBEAT_PATH      = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/heartbeat.txt"
let RESULTS_DIR         = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/results"
let CORPUS_DIR          = "/Users/ghost/core/anima/state/clm_v4_lora_sft_opt_b_2026_05_05/corpus"

// Slice A is REUSED from v1 cycle (50K rehearsal mix unchanged per spec §2.3 carry-over)
let SLICE_A_LOCAL       = "/Users/ghost/core/anima/state/clm_v4_lora_sft_2026_05_05/corpus/slice_A_anima_30k.jsonl"
let CORPUS_MIX_PY       = "/Users/ghost/core/anima/tool/transient_py/p9_retrain_v2_corpus_mix.py"

// OPT-B uses sibling train script — v1 train script UNTOUCHED
let TRAIN_PY            = "/Users/ghost/core/anima/tool/transient_py/clm_v4_lora_train_opt_b.py"

let SSH_KEY             = "/Users/ghost/.runpod/ssh/RunPod-Key-Go"
let RUNPODCTL           = "/opt/homebrew/bin/runpodctl"

let MAX_WALL_MIN        = 300
let BUDGET_TARGET_USD   = 30
let BUDGET_HARD_CAP_USD = 50
let OD_RATE_USD         = 2.99

let HF_BASE_REPO        = "dancinlab/clm-v4-mk2-v1"

// === Phase 2 watchdog hook (constants — OPT-B variant) ===
// BG_LANE differentiates this lane from BG-CLM-2-EXEC (v1) for the cost-watchdog daemon.
// TARGET_USD is mid-of-band of spec §5 Phase 3 envelope ($20-50).
let BG_LANE             = "OPT-B-CROSS-ATTN-RETRAIN"
let TARGET_USD          = "30"
let WATCHDOG_HEXA       = "/Users/ghost/core/anima/tool/h100_cost_watchdog.hexa"
let WATCHDOG_REGISTER   = "/Users/ghost/core/anima/tool/h100_register.bash"
let WATCHDOG_HB_DIR     = "/Users/ghost/core/anima/state/h100_watchdog/heartbeats"
let WATCHDOG_PODS_DIR   = "/Users/ghost/core/anima/state/h100_watchdog/pods"
let WATCHDOG_CLOSED_DIR = "/Users/ghost/core/anima/state/h100_watchdog/closed"

// === OPT-B hyperparameter overrides (spec §3, all LOCKED at spec land per raw#71) ===
let OPT_B_LR                       = "5e-6"      // Q2-A
let OPT_B_LORA_DROPOUT             = "0.10"      // 2× v1
let OPT_B_MAX_STEPS                = "3000"      // Q3-A; 50% v1
let OPT_B_SAVE_STEPS               = "500"       // 2× cadence vs v1
let OPT_B_EVAL_TRIGGERS            = "500,1000,1500,2000,2500,3000"
let OPT_B_PHI_PROBE_INTERVAL       = "500"
let OPT_B_ABORT_PHI_DRIFT_PP       = "-10.0"     // Q4-A
let OPT_B_PHI_BASELINE_IN_PIPELINE = "35.81"     // anchor: clm_v4_lora_phi_canonical 2026_05_05
let OPT_B_TARGET_MODULES_VARIANT   = "qkvo"      // Q1-B (full cross_attn qkvo)

// ─── helpers ──────────────────────────────────────────────────────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── selftest ─────────────────────────────────────────────────────────────

fn _selftest() {
    println("[selftest] schema=" + SCHEMA)
    println("[selftest] cycle=" + CYCLE_TAG)
    println("[selftest] OPT-B variant: cross_attn qkvo retrain (Q1-B/Q2-A/Q3-A/Q4-A)")

    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR) + " " + _sq(CORPUS_DIR))
    if !_file_exists(STATE_DIR) {
        eprintln("FAIL: state dir not creatable")
        exit(1)
    }
    println("[T1] state dir OK")

    if !_file_exists(SSH_KEY) {
        eprintln("FAIL: ssh key missing: " + SSH_KEY)
        exit(1)
    }
    println("[T2] ssh key OK")
    println("[T3] runpodctl path: " + RUNPODCTL)

    let s1 = exec_with_status("/Users/ghost/core/secret/bin/secret check runpod.api_key 2>/dev/null")
    let s2 = exec_with_status("/Users/ghost/core/secret/bin/secret check huggingface.token 2>/dev/null")
    if s1[1] != 0 { eprintln("FAIL: runpod.api_key not in secret store"); exit(1) }
    if s2[1] != 0 { eprintln("FAIL: huggingface.token not in secret store"); exit(1) }
    println("[T4] secrets OK")

    if !_file_exists(SLICE_A_LOCAL) {
        eprintln("FAIL: slice A not pre-prepared (reuses v1 corpus): " + SLICE_A_LOCAL)
        exit(1)
    }
    let r = exec_with_status("wc -l < " + _sq(SLICE_A_LOCAL))
    println("[T5] slice A lines (reused from v1): " + to_string(r[0]).trim())

    if !_file_exists(CORPUS_MIX_PY) || !_file_exists(TRAIN_PY) {
        eprintln("FAIL: transient py missing — TRAIN_PY=" + TRAIN_PY)
        exit(1)
    }
    println("[T6] transient py present (corpus_mix + OPT-B train sibling)")

    println("[T7] HF base: " + HF_BASE_REPO)
    println("[T8] caps: wall=" + to_string(MAX_WALL_MIN) + "min budget_target=$" + to_string(BUDGET_TARGET_USD) + " hard_cap=$" + to_string(BUDGET_HARD_CAP_USD))

    println("[T9] OPT-B hyperparameter locks (per spec §3 raw#71):")
    println("       lr=" + OPT_B_LR + " (10× lower vs v1's 3e-5)")
    println("       dropout=" + OPT_B_LORA_DROPOUT + " (2× v1's 0.05)")
    println("       max_steps=" + OPT_B_MAX_STEPS + " (50% v1's 6000)")
    println("       save/probe interval=" + OPT_B_SAVE_STEPS + " steps")
    println("       phi_probe_interval=" + OPT_B_PHI_PROBE_INTERVAL + " steps")
    println("       abort_phi_drift_pp=" + OPT_B_ABORT_PHI_DRIFT_PP + " (vs in-pipeline base " + OPT_B_PHI_BASELINE_IN_PIPELINE + ")")
    println("       target_modules_variant=" + OPT_B_TARGET_MODULES_VARIANT + " (Q1-B wide cross_attn qkvo)")

    // Phase 2: probe watchdog tools (graceful warn-only)
    println("[T10] Phase 2 watchdog hooks:")
    println("        BG_LANE=" + BG_LANE + " TARGET_USD=$" + TARGET_USD)
    if _file_exists(WATCHDOG_REGISTER) { println("        T10a register OK: " + WATCHDOG_REGISTER) }
    else { println("        T10a register WARN missing: " + WATCHDOG_REGISTER + " (boot hook will warn-only)") }
    if _file_exists(WATCHDOG_HEXA) { println("        T10b watchdog hexa OK: " + WATCHDOG_HEXA) }
    else { println("        T10b watchdog hexa WARN missing: " + WATCHDOG_HEXA + " (trap deregister will warn-only)") }
    println("        T10c heartbeat dir: " + WATCHDOG_HB_DIR + " (will be touched fire-and-forget)")
    println("        T10d verdict schema 5 fields: pod_kill_verified_404 + watchdog_deregistered + cost_target_usd + cost_actual_usd + cost_overrun_2x_alerted")

    println("[selftest] PASS")
    exit(0)
}

// ─── emit exec.bash + run_h100.bash ───────────────────────────────────────

fn _emit() {
    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR) + " " + _sq(CORPUS_DIR))

    let exec_body = "#!/bin/bash\n" +
"# emitted by tool/clm_v4_lora_train_orchestrator_opt_b.hexa — CLM v4 OPT-B cross_attn retrain lifecycle\n" +
"# raw#9 sibling-pattern Mac-side bash; raw#37 H100 transient py.\n" +
"# OPT-B variant — sibling of state/clm_v4_lora_sft_2026_05_05/exec.bash; v1 UNTOUCHED.\n" +
"set -uo pipefail\n" +
"\n" +
"STATE_DIR='" + STATE_DIR + "'\n" +
"RESULTS_DIR='" + RESULTS_DIR + "'\n" +
"CORPUS_DIR='" + CORPUS_DIR + "'\n" +
"SLICE_A_LOCAL='" + SLICE_A_LOCAL + "'\n" +
"CORPUS_MIX_PY='" + CORPUS_MIX_PY + "'\n" +
"TRAIN_PY='" + TRAIN_PY + "'\n" +
"POD_INFO='" + POD_INFO_PATH + "'\n" +
"VERDICT='" + VERDICT_PATH + "'\n" +
"RUN_LOG='" + RUN_LOG_PATH + "'\n" +
"HEARTBEAT='" + HEARTBEAT_PATH + "'\n" +
"SSH_KEY='" + SSH_KEY + "'\n" +
"RUNPODCTL='" + RUNPODCTL + "'\n" +
"MAX_WALL_MIN=" + to_string(MAX_WALL_MIN) + "\n" +
"BUDGET_HARD_CAP=" + to_string(BUDGET_HARD_CAP_USD) + "\n" +
"BUDGET_TARGET=" + to_string(BUDGET_TARGET_USD) + "\n" +
"OD_RATE=" + to_string(OD_RATE_USD) + "\n" +
"HF_BASE_REPO='" + HF_BASE_REPO + "'\n" +
"BG_LANE='" + BG_LANE + "'\n" +
"TARGET_USD='" + TARGET_USD + "'\n" +
"WATCHDOG_REGISTER='" + WATCHDOG_REGISTER + "'\n" +
"WATCHDOG_HB_DIR='" + WATCHDOG_HB_DIR + "'\n" +
"WATCHDOG_HEXA='" + WATCHDOG_HEXA + "'\n" +
"START_EPOCH=$(date -u +%s)\n" +
"\n" +
"log() { echo \"[$(date -u +%FT%TZ)] $*\" | tee -a \"$RUN_LOG\"; }\n" +
"hb()  { echo \"[$(date -u +%FT%TZ)] $*\" > \"$HEARTBEAT\"; }\n" +
"redact_hf() { sed -E 's/(HF_TOKEN[\"[:space:]]*[:=][\"[:space:]]*)hf_[A-Za-z0-9_]+/\\1<REDACTED>/g; s/(hf_)[A-Za-z0-9_]{20,}/\\1<REDACTED>/g'; }\n" +
"\n" +
"log \"OPT-B variant: cross_attn qkvo retrain — REQUIRES EXPLICIT USER $20-50 COST ACK\"\n" +
"log \"hyperparameter locks: lr=" + OPT_B_LR + " dropout=" + OPT_B_LORA_DROPOUT + " max_steps=" + OPT_B_MAX_STEPS + " abort_drift_pp=" + OPT_B_ABORT_PHI_DRIFT_PP + "\"\n" +
"\n" +
"# ── Stage 0: secrets (raw bypass for redaction wrapper) ──\n" +
"export RUNPOD_API_KEY=$(/Users/ghost/core/secret/bin/secret get runpod.api_key --raw 2>/dev/null)\n" +
"export HF_TOKEN_LOCAL=$(/Users/ghost/core/secret/bin/secret get huggingface.token --raw 2>/dev/null)\n" +
"if [ -z \"${RUNPOD_API_KEY:-}\" ] || [ -z \"${HF_TOKEN_LOCAL:-}\" ]; then\n" +
"    log \"FATAL: secrets unavailable\"\n" +
"    exit 2\n" +
"fi\n" +
"log \"secrets OK (runpod=${#RUNPOD_API_KEY}b hf=${#HF_TOKEN_LOCAL}b)\"\n" +
"hb \"stage0_secrets_loaded\"\n" +
"\n" +
"# ── Stage 0b: HF whoami pre-flight (L9) ──\n" +
"WHOAMI=$(curl -s -H \"Authorization: Bearer $HF_TOKEN_LOCAL\" 'https://huggingface.co/api/whoami-v2' | head -c 300)\n" +
"if echo \"$WHOAMI\" | grep -q '\"name\"'; then\n" +
"    USER=$(echo \"$WHOAMI\" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get(\"name\",\"?\"))')\n" +
"    log \"hf auth PASS user=$USER\"\n" +
"else\n" +
"    log \"FATAL L9: hf auth FAIL: $WHOAMI\"\n" +
"    exit 2\n" +
"fi\n" +
"hb \"stage0b_hf_auth_ok\"\n" +
"\n" +
"# ── Pre-flight: slice A reused from v1 cycle ──\n" +
"if [ ! -f \"$SLICE_A_LOCAL\" ]; then\n" +
"    log \"FATAL: slice A missing (reused from v1 cycle): $SLICE_A_LOCAL\"\n" +
"    exit 2\n" +
"fi\n" +
"SLICE_A_LINES=$(wc -l < \"$SLICE_A_LOCAL\" | awk '{print $1}')\n" +
"log \"slice A OK ($SLICE_A_LINES lines, reused from v1)\"\n" +
"\n" +
"# ── Stage 1: boot H100 SECURE on-demand ──\n" +
"POD_NAME='anima-clm-v4-lora-opt-b-2026-05-05'\n" +
"log \"booting pod=$POD_NAME (H100 80GB SXM SECURE on-demand @ \\$$OD_RATE/hr)\"\n" +
"BOOT_RAW_OUT=\"$STATE_DIR/boot.raw.tmp\"\n" +
"BOOT_OUT=\"$STATE_DIR/boot.log\"\n" +
"hb \"stage1_booting_pod\"\n" +
"$RUNPODCTL pod create \\\n" +
"    --name \"$POD_NAME\" \\\n" +
"    --gpu-id 'NVIDIA H100 80GB HBM3' \\\n" +
"    --gpu-count 1 \\\n" +
"    --image 'runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04' \\\n" +
"    --container-disk-in-gb 100 \\\n" +
"    --volume-in-gb 120 \\\n" +
"    --volume-mount-path /workspace \\\n" +
"    --ports '22/tcp,8888/http' \\\n" +
"    --cloud-type SECURE \\\n" +
"    --ssh \\\n" +
"    --env \"{\\\"HF_TOKEN\\\":\\\"$HF_TOKEN_LOCAL\\\"}\" \\\n" +
"    > \"$BOOT_RAW_OUT\" 2>&1\n" +
"BOOT_RC=$?\n" +
"redact_hf < \"$BOOT_RAW_OUT\" > \"$BOOT_OUT\"\n" +
"rm -f \"$BOOT_RAW_OUT\"\n" +
"if [ $BOOT_RC -ne 0 ]; then\n" +
"    log \"FATAL: pod boot failed rc=$BOOT_RC\"\n" +
"    cat \"$BOOT_OUT\" | tee -a \"$RUN_LOG\"\n" +
"    jq -n --arg ts \"$(date -u +%FT%TZ)\" --arg reason \"pod_boot_failed\" '{cycle:\"" + CYCLE_TAG + "\",ts_utc:$ts,verdict:\"FAIL\",reason:$reason}' > \"$VERDICT\"\n" +
"    exit 3\n" +
"fi\n" +
"POD_ID=$(grep -oE '\"[a-z0-9]{14}\"' \"$BOOT_OUT\" | head -1 | tr -d '\"')\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    POD_ID=$(grep -oE 'pod [a-z0-9]{12,16}' \"$BOOT_OUT\" | head -1 | awk '{print $2}')\n" +
"fi\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    log \"FATAL: cannot extract pod_id\"\n" +
"    exit 4\n" +
"fi\n" +
"log \"pod_id=$POD_ID\"\n" +
"echo '{\"pod_id\":\"'$POD_ID'\",\"booted_ts\":\"'$(date -u +%FT%TZ)'\",\"bg_lane\":\"'$BG_LANE'\"}' > \"$POD_INFO\"\n" +
"hb \"stage1_pod_booted pod_id=$POD_ID\"\n" +
"\n" +
"# === Phase 2 watchdog hook (boot — register pod) ===\n" +
"if [ -x \"$WATCHDOG_REGISTER\" ] || [ -f \"$WATCHDOG_REGISTER\" ]; then\n" +
"    if bash \"$WATCHDOG_REGISTER\" \"$POD_ID\" \"$BG_LANE\" \"$TARGET_USD\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"        WATCHDOG_REGISTERED=1\n" +
"        log \"[watchdog] register OK pod=$POD_ID lane=$BG_LANE target=\\$$TARGET_USD\"\n" +
"    else\n" +
"        WATCHDOG_REGISTERED=0\n" +
"        log \"[watchdog] WARN register failed (rc=$?)\"\n" +
"    fi\n" +
"else\n" +
"    WATCHDOG_REGISTERED=0\n" +
"    log \"[watchdog] WARN $WATCHDOG_REGISTER not present\"\n" +
"fi\n" +
"hb \"stage1c_watchdog_registered=$WATCHDOG_REGISTERED\"\n" +
"\n" +
"# ── Stage 1b: trap kill-on-exit (trap pre-stop hook) ──\n" +
"POD_KILL_VERIFIED_404=0\n" +
"WATCHDOG_DEREGISTERED=0\n" +
"_kill_pod() {\n" +
"    log \"[trap] data-first scp before kill (L13)\"\n" +
"    if [ -n \"${SSH_HOST:-}\" ] && [ -n \"${SSH_PORT:-}\" ]; then\n" +
"        timeout 60 scp -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P \"$SSH_PORT\" -r \\\n" +
"            \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -5 || true\n" +
"        timeout 30 scp -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P \"$SSH_PORT\" \\\n" +
"            \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>&1 | tail -1 || true\n" +
"    fi\n" +
"    if [ -d \"$WATCHDOG_HB_DIR\" ]; then\n" +
"        echo \"EXITING $(date -u +%FT%TZ) pod=$POD_ID\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" || true\n" +
"    fi\n" +
"    log \"[trap] killing pod=$POD_ID\"\n" +
"    $RUNPODCTL pod stop \"$POD_ID\" 2>&1 | redact_hf | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
"    $RUNPODCTL pod delete \"$POD_ID\" 2>&1 | redact_hf | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 5\n" +
"    POD_KILL_VERIFIED_404=0\n" +
"    for vi in 1 2 3; do\n" +
"        POST=$($RUNPODCTL pod get \"$POD_ID\" 2>&1 | redact_hf | head -3)\n" +
"        if echo \"$POST\" | grep -qiE 'not found|404|does not exist'; then\n" +
"            POD_KILL_VERIFIED_404=1\n" +
"            log \"[trap] 404 verified (try $vi/3)\"\n" +
"            break\n" +
"        fi\n" +
"        log \"[trap] 404 verify try $vi/3 not yet — sleep 30s\"\n" +
"        sleep 30\n" +
"    done\n" +
"    log \"[trap] post-kill: $POST  pod_kill_verified_404=$POD_KILL_VERIFIED_404\"\n" +
"    WATCHDOG_DEREGISTERED=0\n" +
"    if [ \"$POD_KILL_VERIFIED_404\" = \"1\" ] && [ -f \"$WATCHDOG_HEXA\" ]; then\n" +
"        if /Users/ghost/core/hexa-lang/hexa run \"$WATCHDOG_HEXA\" --deregister \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"            WATCHDOG_DEREGISTERED=1\n" +
"            log \"[watchdog] deregister OK pod=$POD_ID\"\n" +
"        else\n" +
"            log \"[watchdog] WARN deregister failed (rc=$?)\"\n" +
"        fi\n" +
"    fi\n" +
"    if [ -f \"$POD_INFO\" ]; then\n" +
"        jq --arg killed \"$(date -u +%FT%TZ)\" --arg post \"$POST\" --argjson k404 \"$POD_KILL_VERIFIED_404\" --argjson wdd \"$WATCHDOG_DEREGISTERED\" \\\n" +
"            '. + {killed_ts:$killed, post_kill_status:$post, pod_kill_verified_404:($k404==1), watchdog_deregistered:($wdd==1)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\" || true\n" +
"    fi\n" +
"}\n" +
"trap _kill_pod EXIT INT TERM\n" +
"\n" +
"# ── Stage 2: wait for SSH ready (max 6min) ──\n" +
"log \"waiting for SSH ready (max 6min)\"\n" +
"hb \"stage2_waiting_ssh\"\n" +
"SSH_HOST=''\n" +
"SSH_PORT=''\n" +
"for i in $(seq 1 36); do\n" +
"    INFO=$($RUNPODCTL pod get \"$POD_ID\" -o json 2>/dev/null)\n" +
"    SSH_HOST=$(echo \"$INFO\" | jq -r '.ssh.ip // empty' 2>/dev/null)\n" +
"    SSH_PORT=$(echo \"$INFO\" | jq -r '.ssh.port // empty' 2>/dev/null)\n" +
"    if [ -n \"$SSH_HOST\" ] && [ \"$SSH_HOST\" != \"null\" ] && [ -n \"$SSH_PORT\" ] && [ \"$SSH_PORT\" != \"null\" ]; then\n" +
"        if ssh -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -p \"$SSH_PORT\" \"root@$SSH_HOST\" 'echo READY' 2>/dev/null | grep -q READY; then\n" +
"            log \"SSH ready at $SSH_HOST:$SSH_PORT (after ${i} probes)\"\n" +
"            break\n" +
"        fi\n" +
"    fi\n" +
"    sleep 10\n" +
"done\n" +
"if [ -z \"$SSH_HOST\" ] || [ \"$SSH_HOST\" = \"null\" ] || [ -z \"$SSH_PORT\" ] || [ \"$SSH_PORT\" = \"null\" ]; then\n" +
"    log \"FATAL: pod never reached SSH ready in 6min\"\n" +
"    exit 5\n" +
"fi\n" +
"jq --arg h \"$SSH_HOST\" --arg p \"$SSH_PORT\" '. + {ssh_host:$h, ssh_port:($p|tonumber)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\"\n" +
"hb \"stage2_ssh_ready host=$SSH_HOST port=$SSH_PORT\"\n" +
"\n" +
"SSH=\"ssh -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p $SSH_PORT root@$SSH_HOST\"\n" +
"SCP=\"scp -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $SSH_PORT\"\n" +
"\n" +
"# ── Stage 3: ship transient py + slice A (OPT-B variant uses sibling train script) ──\n" +
"log \"shipping slice A (76MB) + OPT-B transient py sibling\"\n" +
"hb \"stage3_setup_starting\"\n" +
"$SSH 'mkdir -p /workspace/clm_v4_lora_opt_b/{corpus,results,ckpts,sentinels}'\n" +
"$SCP \"$SLICE_A_LOCAL\" \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/corpus/slice_A_anima_30k.jsonl\" 2>&1 | tail -1\n" +
"$SCP \"$CORPUS_MIX_PY\" \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/corpus_mix.py\" 2>&1 | tail -1\n" +
"$SCP \"$TRAIN_PY\" \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/train.py\" 2>&1 | tail -1\n" +
"$SCP \"" + RUN_H100_PATH + "\" \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/run_h100.bash\" 2>&1 | tail -1\n" +
"$SSH 'chmod +x /workspace/clm_v4_lora_opt_b/run_h100.bash'\n" +
"\n" +
"log \"launching H100 OPT-B pipeline (cross_attn qkvo retrain — phi probe every 500 steps, ABORT @ -10pp)\"\n" +
"$SSH 'cat /proc/1/environ | tr \"\\0\" \"\\n\" | grep ^HF_TOKEN= > /workspace/clm_v4_lora_opt_b/hf_token.env && cd /workspace/clm_v4_lora_opt_b && set -a && . hf_token.env && set +a && setsid nohup bash run_h100.bash < /dev/null > orchestrator.log 2>&1 & echo $! > run.pid; disown $! 2>/dev/null || true; sleep 2; cat run.pid' < /dev/null\n" +
"hb \"stage3_h100_launched\"\n" +
"\n" +
"# ── Stage 4: poll loop (heartbeat per cycle, sentinel-kill, cost cap) ──\n" +
"log \"poll loop start (max ${MAX_WALL_MIN}min, target \\$${BUDGET_TARGET}, hard_cap \\$${BUDGET_HARD_CAP})\"\n" +
"COMPLETE=0\n" +
"EARLY_STOP=0\n" +
"PHI_ABORT=0\n" +
"POLL_INTERVAL=60\n" +
"while true; do\n" +
"    NOW=$(date -u +%s)\n" +
"    ELAPSED_MIN=$(( (NOW - START_EPOCH) / 60 ))\n" +
"    ELAPSED_HR_DEC=$(awk \"BEGIN{printf \\\"%.4f\\\", ($NOW - $START_EPOCH) / 3600}\")\n" +
"    ELAPSED_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $ELAPSED_HR_DEC * $OD_RATE}\")\n" +
"\n" +
"    COST_OVER=$(awk \"BEGIN{print ($ELAPSED_COST > $BUDGET_HARD_CAP) ? 1 : 0}\")\n" +
"    if [ \"$COST_OVER\" = \"1\" ]; then\n" +
"        log \"COST CAP HIT \\$$ELAPSED_COST > \\$$BUDGET_HARD_CAP — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"    if [ $ELAPSED_MIN -ge $MAX_WALL_MIN ]; then\n" +
"        log \"WALL CAP HIT ${ELAPSED_MIN}min — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    PROBE=$($SSH 'ls /workspace/clm_v4_lora_opt_b/results/COMPLETE.sentinel 2>/dev/null && echo SENTINEL_FOUND; ls /workspace/clm_v4_lora_opt_b/results/EARLY_STOP.sentinel 2>/dev/null && echo EARLY_STOP_FOUND; ls /workspace/clm_v4_lora_opt_b/results/PHI_ABORT.sentinel 2>/dev/null && echo PHI_ABORT_FOUND; ps -p $(cat /workspace/clm_v4_lora_opt_b/run.pid 2>/dev/null) -o pid,etime,comm 2>/dev/null | tail -1; tail -1 /workspace/clm_v4_lora_opt_b/orchestrator.log 2>/dev/null' 2>/dev/null)\n" +
"    log \"elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|' | head -c 240)\"\n" +
"    hb \"poll elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST}\"\n" +
"\n" +
" # === Phase 2 watchdog hook (heartbeat) ===\n" +
"    if [ -n \"${WATCHDOG_HB_DIR:-}\" ]; then\n" +
"        mkdir -p \"$WATCHDOG_HB_DIR\" 2>/dev/null || true\n" +
"        echo \"poll $(date -u +%FT%TZ) pod=$POD_ID elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST}\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" 2>/dev/null || true\n" +
"    fi\n" +
"\n" +
"    $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/results/*.json\" \"$RESULTS_DIR/\" 2>/dev/null || true\n" +
"    $SCP \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>/dev/null || true\n" +
"\n" +
"    if echo \"$PROBE\" | grep -q SENTINEL_FOUND; then\n" +
"        log \"COMPLETE.sentinel detected — final sync FIRST\"\n" +
"        COMPLETE=1\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -5 | tee -a \"$RUN_LOG\" || true\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/ckpts/final\" \"$RESULTS_DIR/adapter_final\" 2>&1 | tail -3 || true\n" +
"        break\n" +
"    fi\n" +
"    if echo \"$PROBE\" | grep -q PHI_ABORT_FOUND; then\n" +
"        log \"PHI_ABORT.sentinel detected (F-OPT-B-1 drift > -10pp) — rescue last good adapter\"\n" +
"        PHI_ABORT=1\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -5 | tee -a \"$RUN_LOG\" || true\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/ckpts\" \"$RESULTS_DIR/ckpts_phi_abort\" 2>&1 | tail -3 || true\n" +
"        break\n" +
"    fi\n" +
"    if echo \"$PROBE\" | grep -q EARLY_STOP_FOUND; then\n" +
"        log \"EARLY_STOP.sentinel detected (forgetting OR train-side abort) — final sync + kill\"\n" +
"        EARLY_STOP=1\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -5 | tee -a \"$RUN_LOG\" || true\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/clm_v4_lora_opt_b/ckpts\" \"$RESULTS_DIR/ckpts_partial\" 2>&1 | tail -3 || true\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    sleep $POLL_INTERVAL\n" +
"done\n" +
"\n" +
"# ── Stage 5: pod kill via trap (auto on exit) ──\n" +
"\n" +
"# ── Stage 6: verdict (OPT-B schema with F-OPT-B-1..5 + cost-discipline fields) ──\n" +
"log \"computing OPT-B verdict\"\n" +
"FINAL_ELAPSED_MIN=$(( ($(date -u +%s) - START_EPOCH) / 60 ))\n" +
"FINAL_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $FINAL_ELAPSED_MIN/60 * $OD_RATE}\")\n" +
"hb \"stage6_verdict_computing\"\n" +
"\n" +
"# OPT-B anchors (from spec §1 + §2)\n" +
"PHI_BASELINE_IN_PIPELINE=" + OPT_B_PHI_BASELINE_IN_PIPELINE + "\n" +
"PHI_ABORT_THRESHOLD=" + OPT_B_ABORT_PHI_DRIFT_PP + "\n" +
"\n" +
"# Extract final post-LoRA phi★ canonical (Mac-side post-cycle; placeholder here)\n" +
"PHI_POST_FINAL=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/phi_canonical_final.json\" ]; then\n" +
"    PHI_POST_FINAL=$(jq -r '.phi_mean_K8 // \"null\"' \"$RESULTS_DIR/phi_canonical_final.json\")\n" +
"fi\n" +
"# Compute drift (pp from in-pipeline base 35.81)\n" +
"PHI_DRIFT_PP=\"null\"\n" +
"if [ \"$PHI_POST_FINAL\" != \"null\" ]; then\n" +
"    PHI_DRIFT_PP=$(awk -v p=\"$PHI_POST_FINAL\" -v b=\"$PHI_BASELINE_IN_PIPELINE\" 'BEGIN{printf \"%.4f\", p - b}')\n" +
"fi\n" +
"\n" +
"# F-OPT-B-1 (NO_FLIP) — drift > -10pp PASS; -5 to -10 PARTIAL; < -10 FAIL\n" +
"FOPTB1=\"UNKNOWN\"\n" +
"if [ \"$PHI_DRIFT_PP\" != \"null\" ]; then\n" +
"    FOPTB1=$(awk -v d=\"$PHI_DRIFT_PP\" -v t=\"$PHI_ABORT_THRESHOLD\" 'BEGIN{ if (d+0 > -5.0) print \"PASS\"; else if (d+0 >= t+0) print \"PARTIAL\"; else print \"FAIL_FLIP\" }')\n" +
"fi\n" +
"\n" +
"# F-OPT-B-2 (cross_attn actually trained — std diverges from init floor 0.02)\n" +
"FOPTB2=\"UNKNOWN\"\n" +
"CROSS_ATTN_O_PROJ_STD_POST=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/cross_attn_o_proj_std_post_train.json\" ]; then\n" +
"    CROSS_ATTN_O_PROJ_STD_POST=$(jq -r '.mean_std // \"null\"' \"$RESULTS_DIR/cross_attn_o_proj_std_post_train.json\")\n" +
"    FOPTB2=$(jq -r '(.f_opt_b_2_pass | if . then \"PASS\" else \"FAIL\" end) // \"UNKNOWN\"' \"$RESULTS_DIR/cross_attn_o_proj_std_post_train.json\")\n" +
"fi\n" +
"\n" +
"# F-OPT-B-3 (decisive — F-SHIM-V5-4 lift_pp ≥ +5pp; computed in Phase 4 separate dispatch)\n" +
"FOPTB3=\"PHASE_4_PENDING\"\n" +
"\n" +
"# F-OPT-B-4 (composite ≥ 0.30) — computed Phase 4\n" +
"FOPTB4=\"PHASE_4_PENDING\"\n" +
"\n" +
"# F-OPT-B-5 (forgetting_index < 0.05) — computed Phase 4\n" +
"FOPTB5=\"PHASE_4_PENDING\"\n" +
"\n" +
"# Overall verdict\n" +
"OVERALL=\"OPT_B_PHASE_3_UNKNOWN\"\n" +
"if [ \"$PHI_ABORT\" = \"1\" ]; then\n" +
"    OVERALL=\"OPT_B_PHASE_3_PHI_ABORT\"\n" +
"elif [ \"$EARLY_STOP\" = \"1\" ]; then\n" +
"    OVERALL=\"OPT_B_PHASE_3_EARLY_STOP\"\n" +
"elif [ \"$COMPLETE\" = \"1\" ] && [ \"$FOPTB1\" = \"PASS\" ] && [ \"$FOPTB2\" = \"PASS\" ]; then\n" +
"    OVERALL=\"OPT_B_PHASE_3_PASS_PROCEED_TO_PHASE_4\"\n" +
"elif [ \"$COMPLETE\" = \"1\" ] && ( [ \"$FOPTB1\" = \"PARTIAL\" ] || [ \"$FOPTB2\" = \"FAIL\" ] ); then\n" +
"    OVERALL=\"OPT_B_PHASE_3_PARTIAL\"\n" +
"elif [ \"$COMPLETE\" = \"1\" ] && [ \"$FOPTB1\" = \"FAIL_FLIP\" ]; then\n" +
"    OVERALL=\"OPT_B_PHASE_3_FAIL_FLIP\"\n" +
"fi\n" +
"\n" +
"POD_KILL_404='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    POST=$(jq -r '.post_kill_status // \"\"' \"$POD_INFO\" 2>/dev/null)\n" +
"    if echo \"$POST\" | grep -qiE 'not found|404|no such|does not exist'; then\n" +
"        POD_KILL_404='true'\n" +
"    fi\n" +
"fi\n" +
"\n" +
"# === Phase 2 verdict schema (cost-discipline fields) ===\n" +
"COST_TARGET_USD=$TARGET_USD\n" +
"COST_ACTUAL_USD=$FINAL_COST\n" +
"COST_OVERRUN_RATIO=$(awk -v a=\"$COST_ACTUAL_USD\" -v t=\"$COST_TARGET_USD\" 'BEGIN{ if (t+0 > 0) printf \"%.4f\", a/t; else print \"0\" }')\n" +
"COST_OVERRUN_2X_ALERTED='false'\n" +
"if awk -v r=\"$COST_OVERRUN_RATIO\" 'BEGIN{exit !(r+0 >= 2.0)}'; then COST_OVERRUN_2X_ALERTED='true'; fi\n" +
"WATCHDOG_DEREGISTERED_FINAL='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    WD_TMP=$(jq -r '.watchdog_deregistered // false' \"$POD_INFO\" 2>/dev/null)\n" +
"    if [ \"$WD_TMP\" = \"true\" ]; then WATCHDOG_DEREGISTERED_FINAL='true'; fi\n" +
"fi\n" +
"\n" +
"jq -n \\\n" +
"    --arg cycle \"" + CYCLE_TAG + "\" \\\n" +
"    --arg ts \"$(date -u +%FT%TZ)\" \\\n" +
"    --arg pod \"$POD_ID\" \\\n" +
"    --argjson kill_404 \"$POD_KILL_404\" \\\n" +
"    --argjson wd_dereg \"$WATCHDOG_DEREGISTERED_FINAL\" \\\n" +
"    --argjson cost_target \"$COST_TARGET_USD\" \\\n" +
"    --argjson cost_actual \"$COST_ACTUAL_USD\" \\\n" +
"    --argjson cost_ratio \"$COST_OVERRUN_RATIO\" \\\n" +
"    --argjson cost_2x \"$COST_OVERRUN_2X_ALERTED\" \\\n" +
"    --arg overall \"$OVERALL\" \\\n" +
"    --arg foptb1 \"$FOPTB1\" --arg foptb2 \"$FOPTB2\" --arg foptb3 \"$FOPTB3\" --arg foptb4 \"$FOPTB4\" --arg foptb5 \"$FOPTB5\" \\\n" +
"    --arg phi_post \"$PHI_POST_FINAL\" --arg phi_drift \"$PHI_DRIFT_PP\" \\\n" +
"    --arg ca_std \"$CROSS_ATTN_O_PROJ_STD_POST\" \\\n" +
"    --argjson wall \"$FINAL_ELAPSED_MIN\" \\\n" +
"    --argjson cost \"$FINAL_COST\" \\\n" +
"    --argjson complete \"$COMPLETE\" \\\n" +
"    --argjson early_stop \"$EARLY_STOP\" \\\n" +
"    --argjson phi_abort \"$PHI_ABORT\" \\\n" +
"    '{\n" +
"        schema: \"anima/clm_v4_lora_sft_opt_b/verdict/1\",\n" +
"        cycle: $cycle, ts_utc: $ts,\n" +
"        bg_lane: \"" + BG_LANE + "\",\n" +
"        spec_source: \"docs/clm_v4_lora_sft_opt_b_cross_attn_retrain_spec_2026_05_05.md\",\n" +
"        parent_v1_cycle: \"clm_v4_lora_sft_2026_05_05\",\n" +
"        phi_baseline_in_pipeline: " + OPT_B_PHI_BASELINE_IN_PIPELINE + ",\n" +
"        phi_baseline_carry_substrate: 41.86,\n" +
"        pod_id: $pod, pod_terminated: true, pod_kill_verified_404: $kill_404,\n" +
"        hyperparameters: {r: 32, alpha: 64, dropout: " + OPT_B_LORA_DROPOUT + ", lr: " + OPT_B_LR + ", max_steps: " + OPT_B_MAX_STEPS + ", save_steps: " + OPT_B_SAVE_STEPS + ", per_device_batch: 8, grad_accum: 4, eff_batch: 32, ctx: 512, bf16: true, target_modules: \"self-attn qkvo + cross_attn qkvo on decoder.blocks.{0..15} (Q1-B wide; 128 modules total)\"},\n" +
"        opt_b_decision_locks: {Q1: \"B (wide cross_attn qkvo)\", Q2: \"A (lr=5e-6)\", Q3: \"A (max_steps=3000)\", Q4: \"A (abort_drift=-10pp)\", Q5: \"B ($20-100 envelope; this orchestrator hard cap=$50 Phase 3 only)\"},\n" +
"        phi_post_final_canonical: $phi_post,\n" +
"        phi_drift_pp_in_pipeline: $phi_drift,\n" +
"        cross_attn_o_proj_std_post: $ca_std,\n" +
"        F_OPT_B_1_phi_no_flip: $foptb1,\n" +
"        F_OPT_B_2_cross_attn_actually_trained: $foptb2,\n" +
"        F_OPT_B_3_shim_v5_4_lift_pp: $foptb3,\n" +
"        F_OPT_B_4_composite_ge_0_30: $foptb4,\n" +
"        F_OPT_B_5_forgetting_index_lt_0_05: $foptb5,\n" +
"        verdict: $overall,\n" +
"        wall_time_min: $wall,\n" +
"        wall_time_h: ($wall / 60.0),\n" +
"        actual_cost_usd: $cost,\n" +
"        budget_target_usd: " + to_string(BUDGET_TARGET_USD) + ",\n" +
"        budget_hard_cap_usd: " + to_string(BUDGET_HARD_CAP_USD) + ",\n" +
"        cost_target_usd: $cost_target,\n" +
"        cost_actual_usd: $cost_actual,\n" +
"        cost_overrun_ratio: $cost_ratio,\n" +
"        cost_overrun_2x_alerted: $cost_2x,\n" +
"        watchdog_deregistered: $wd_dereg,\n" +
"        complete_sentinel_detected: ($complete == 1),\n" +
"        early_stop_sentinel_detected: ($early_stop == 1),\n" +
"        phi_abort_sentinel_detected: ($phi_abort == 1),\n" +
"        phase_4_pending: ($foptb3 == \"PHASE_4_PENDING\"),\n" +
"        lessons_applied: {\n" +
"            L3_auto_kill: \"trap _kill_pod EXIT INT TERM\",\n" +
"            L9_hf_whoami_preflight: \"stage0b /api/whoami-v2 fail-fast\",\n" +
"            L13_trap_pre_kill_scp: \"trap rescues results before pod stop\",\n" +
"            L24_setsid_disown: \"H100 launch via setsid + < /dev/null + disown for chat-session resilience\",\n" +
"            phi_star_flip_mitigation_opt_b: \"lr 10× lower (5e-6 vs 3e-5); dropout 2× (0.10 vs 0.05); max_steps 50% (3000 vs 6000); ABORT @ -10pp drift; phi probe every 500 steps\"\n" +
"        },\n" +
"        honest_c3: [\n" +
"            \"OPT-B sibling pattern: train script + orchestrator are NEW siblings of v1; v1 train script + v1 orchestrator UNTOUCHED per raw#15 additive. If sibling drifts from v1 base behavior (e.g., PEFT version regression), v1 remains as a working comparator.\",\n" +
"            \"phi★ in-pipeline baseline 35.81 was measured Mac CPU fp32; Phase 3 H100 bf16 substrate may yield methodology delta on the order of ~6pp (per CLM-2 phi canonical verdict honest_c3 #3). Authoritative ABORT trigger uses post-train Mac CPU fp32 phi probe (matching baseline substrate); in-pod heuristic is informational only.\",\n" +
"            \"cross_attn target_modules count = 16 layers × 8 projections (Q1-B wide) = 128 modules total; +0.137% trainable params vs v1. Sanity assert in train.py at startup catches PEFT name-match regression.\",\n" +
"            \"F-OPT-B-3 (decisive lift gate) is computed in Phase 4 separate dispatch — Phase 3 verdict marks PHASE_4_PENDING for FOPTB3/4/5. Phase 3 PASS = F-OPT-B-1 PASS + F-OPT-B-2 PASS only; Phase 4 must run before final OPT-B verdict.\",\n" +
"            \"H100 SXM cost @ \\$2.99/hr; expected Phase 3 wall ~3-5h (3000 steps + cross_attn 0.137% extra params + denser eval cadence). Hard cap \\$50; 16% overrun headroom on \\$30 target. ABORT contingency caps phi-flip ABORT spend at ~\\$10-15.\",\n" +
"            \"Slice A reused from v1 cycle (UNTOUCHED) ensures rehearsal mix is identical between v1 and OPT-B — only target_modules + LR + dropout + max_steps differ. Cross-cycle delta isolates the cross_attn participation effect from corpus mix variance.\",\n" +
"            \"Phase 2 ubu1 smoke (RTX 5070 sm_120, fp32) verifies gradient flow through cross_attn LoRA before Phase 3 spend. Smoke verdict at state/clm_v4_lora_sft_opt_b_phase_1_2_prep_2026_05_05/verdict.json = ready_for_phase_3 gate.\"\n" +
"        ]\n" +
"    }' > \"$VERDICT\"\n" +
"\n" +
"log \"verdict=$OVERALL F-OPT-B-1=$FOPTB1 F-OPT-B-2=$FOPTB2 phi_drift=$PHI_DRIFT_PP cross_attn_std_post=$CROSS_ATTN_O_PROJ_STD_POST wall=${FINAL_ELAPSED_MIN}min cost=\\$${FINAL_COST}\"\n" +
"hb \"verdict=$OVERALL\"\n" +
"echo \"__OPT_B_PHASE_3__ $OVERALL\" | tee -a \"$RUN_LOG\"\n" +
"exit 0\n"

    write_file(EXEC_BASH_PATH, exec_body)
    exec_with_status("chmod +x " + _sq(EXEC_BASH_PATH))
    println("[emit] " + EXEC_BASH_PATH)

    let run_h100 = "#!/bin/bash\n" +
"# emitted by tool/clm_v4_lora_train_orchestrator_opt_b.hexa — H100-side OPT-B runner\n" +
"# raw#37 transient: Python on Linux (transformers + torch + peft + trl + lm_eval) permitted.\n" +
"set -uo pipefail\n" +
"\n" +
"WORK=/workspace/clm_v4_lora_opt_b\n" +
"cd $WORK\n" +
"export HF_TOKEN=\"${HF_TOKEN}\"\n" +
"export HF_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"BASE_REPO='" + HF_BASE_REPO + "'\n" +
"RESULTS=$WORK/results\n" +
"CKPTS=$WORK/ckpts\n" +
"MIXED=$WORK/corpus/mixed_50k.jsonl\n" +
"\n" +
"echo \"[orch-opt-b] start $(date -u +%FT%TZ)\"\n" +
"\n" +
"# ── deps install ──\n" +
"pip install -q --no-cache-dir 'transformers>=4.45,<4.50' 'peft>=0.13' 'trl>=0.11' 'datasets>=3.0' 'lm-eval==0.4.11' 'sentencepiece' 'huggingface_hub'\n" +
"\n" +
"# ── Phase A: corpus mix (60/30/10 — same as v1) ──\n" +
"echo \"[A] corpus mix (60/30/10 — reused recipe)\"\n" +
"python corpus_mix.py --slice-a $WORK/corpus/slice_A_anima_30k.jsonl --output $MIXED --seed 20260504\n" +
"\n" +
"# ── Phase B: train OPT-B variant (cross_attn qkvo) ──\n" +
"echo \"[B] OPT-B train start: lr=" + OPT_B_LR + " dropout=" + OPT_B_LORA_DROPOUT + " max_steps=" + OPT_B_MAX_STEPS + " (cross_attn=qkvo)\"\n" +
"TRAIN_LOG=$RESULTS/train.log\n" +
"python train.py \\\n" +
"    --base-model \"$BASE_REPO\" \\\n" +
"    --data-jsonl \"$MIXED\" \\\n" +
"    --output-dir \"$CKPTS\" \\\n" +
"    --lora-r 32 --lora-alpha 64 --lora-dropout " + OPT_B_LORA_DROPOUT + " \\\n" +
"    --lr " + OPT_B_LR + " \\\n" +
"    --max-steps " + OPT_B_MAX_STEPS + " \\\n" +
"    --save-steps " + OPT_B_SAVE_STEPS + " \\\n" +
"    --eval-step-triggers '" + OPT_B_EVAL_TRIGGERS + "' \\\n" +
"    --phi-probe-interval " + OPT_B_PHI_PROBE_INTERVAL + " \\\n" +
"    --abort-phi-drift-pp " + OPT_B_ABORT_PHI_DRIFT_PP + " \\\n" +
"    --phi-baseline-in-pipeline " + OPT_B_PHI_BASELINE_IN_PIPELINE + " \\\n" +
"    --target-modules-include-cross-attn " + OPT_B_TARGET_MODULES_VARIANT + " \\\n" +
"    --per-device-batch 8 --grad-accum 4 \\\n" +
"    --seq-len 512 --warmup-steps 300 \\\n" +
"    --seed 20260504 \\\n" +
"    > \"$TRAIN_LOG\" 2>&1 &\n" +
"TRAIN_PID=$!\n" +
"echo \"[B] OPT-B train pid=$TRAIN_PID\"\n" +
"\n" +
"# ── Phase B-watch: monitor train + emit COMPLETE/PHI_ABORT/EARLY_STOP sentinels ──\n" +
"while kill -0 $TRAIN_PID 2>/dev/null; do\n" +
"    sleep 30\n" +
"    # Forward train stdout sample to orchestrator log\n" +
"    tail -3 \"$TRAIN_LOG\" 2>/dev/null || true\n" +
"done\n" +
"wait $TRAIN_PID\n" +
"TRAIN_RC=$?\n" +
"echo \"[B] train done rc=$TRAIN_RC\"\n" +
"\n" +
"# Copy adapter final into results for SCP retrieval\n" +
"if [ -d \"$CKPTS/final\" ]; then\n" +
"    cp -r \"$CKPTS/final\" \"$RESULTS/adapter_final\"\n" +
"fi\n" +
"# Copy std/grad/audit JSONs to results (top-level for SCP)\n" +
"for f in target_modules_audit gradient_flow_probe cross_attn_o_proj_std_pre_train cross_attn_o_proj_std_post_train TRAIN_DONE config; do\n" +
"    [ -f \"$CKPTS/${f}.json\" ] && cp \"$CKPTS/${f}.json\" \"$RESULTS/${f}.json\"\n" +
"done\n" +
"\n" +
"if [ $TRAIN_RC -ne 0 ]; then\n" +
"    echo \"{\\\"reason\\\": \\\"train_rc=$TRAIN_RC\\\", \\\"finished_at\\\": \\\"$(date -u +%FT%TZ)\\\"}\" > $RESULTS/EARLY_STOP.sentinel\n" +
"    exit $TRAIN_RC\n" +
"fi\n" +
"\n" +
"# ── Phase C: emit COMPLETE.sentinel (Phase 4 eval is separate dispatch) ──\n" +
"echo \"{\\\"ok\\\": true, \\\"finished_at\\\": \\\"$(date -u +%FT%TZ)\\\", \\\"phases\\\": [\\\"corpus_mix\\\", \\\"train_opt_b_cross_attn_qkvo\\\"], \\\"phase_4_eval\\\": \\\"separate_dispatch\\\"}\" > $RESULTS/COMPLETE.sentinel\n" +
"echo \"[orch-opt-b] complete\"\n"

    write_file(RUN_H100_PATH, run_h100)
    exec_with_status("chmod +x " + _sq(RUN_H100_PATH))
    println("[emit] " + RUN_H100_PATH)
    println("[emit] OK — OPT-B variant ready for --launch (REQUIRES USER COST ACK)")
}

// ─── kill (emergency) ─────────────────────────────────────────────────────

fn _kill(pod_id: string) {
    if pod_id == "" {
        eprintln("ERROR: --kill requires <pod_id> argument")
        exit(1)
    }
    println("[kill] pod=" + pod_id)
    exec_with_status(_sq(RUNPODCTL) + " stop pod " + _sq(pod_id))
    exec_with_status("sleep 5")
    exec_with_status(_sq(RUNPODCTL) + " remove pod " + _sq(pod_id))
    let r = exec_with_status(_sq(RUNPODCTL) + " get pod " + _sq(pod_id) + " 2>&1 | head -1")
    println("[kill] post-status: " + to_string(r[0]).trim())
}

// ─── main ─────────────────────────────────────────────────────────────────

fn main() {
    let av = _argv()

    if _flag(av, "--selftest") {
        _selftest()
        return
    }
    if _flag(av, "--kill") {
        _kill(_opt(av, "--kill", ""))
        return
    }
    if _flag(av, "--emit") {
        _emit()
        return
    }
    if _flag(av, "--launch") {
        eprintln("[launch] OPT-B Phase 3 H100 retrain — REQUIRES EXPLICIT USER $20-50 COST ACK.")
        eprintln("[launch] Phase 1+2 ($0) prep: state/clm_v4_lora_sft_opt_b_phase_1_2_prep_2026_05_05/verdict.json")
        eprintln("[launch] Re-run with --launch-confirmed to proceed.")
        if !_flag(av, "--launch-confirmed") {
            exit(2)
        }
        _emit()
        println("[launch] dispatching " + EXEC_BASH_PATH)
        let r = exec_with_status("bash " + _sq(EXEC_BASH_PATH))
        println("[launch] rc=" + to_string(r[1]))
        return
    }

    println("USAGE: hexa run tool/clm_v4_lora_train_orchestrator_opt_b.hexa [--selftest|--emit|--launch --launch-confirmed|--kill <pod_id>]")
    println("")
    println("OPT-B variant — sibling of v1 (cross_attn qkvo retrain).")
    println("Phase 3 dispatch requires:")
    println("  GATE 1: OPT-A substrate differential confirmed (5×) — already PASS")
    println("  GATE 2: explicit user cost ACK ($20-50 envelope)")
}
