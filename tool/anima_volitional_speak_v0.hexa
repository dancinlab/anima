// tool/anima_volitional_speak_v0.hexa — anima volitional speak() V0 prototype.
//
// "입은 있되 말하고 싶을 때만 말한다" — substrate 내부 volition signal 이
// threshold τ 를 넘을 때만 speak() 호출. timer 강제 emit 폐기.
//
// Usage:
//   hexa run tool/anima_volitional_speak_v0.hexa --selftest
//   hexa run tool/anima_volitional_speak_v0.hexa <iters> <tau> <interval_s> <mode>
//
// Stage 0 contract: real_args(), exec, str(int). No ternary, no _str.

let HELPER_PY  = "/Users/ghost/core/anima/tool/anima_volitional_speak_v0_helper.py"
let PY_BIN     = "/usr/bin/python3"
let STATE_BASE = "/Users/ghost/core/anima/state"
let RUN_DIR    = "volitional_speak_v0_2026_05_12"

fn shell(cmd) {
    return exec(cmd).trim()
}

fn now_iso() {
    return shell("date -u +%Y-%m-%dT%H:%M:%SZ")
}

fn now_unix() {
    return shell("date +%s")
}

fn sh_quote(s) {
    let esc = s.replace("'", "'\\''")
    return "'" + esc + "'"
}

fn extract_marker_line(stdout, marker) {
    let lines = stdout.split("\n")
    let mut payload = ""
    for line in lines {
        if line.starts_with(marker) {
            payload = line.substring(len(marker) + 1, len(line))
        }
    }
    return payload
}

fn extract_json_field(payload, key) {
    let needle = "\"" + key + "\":"
    let idx = payload.find(needle)
    if idx < 0 { return "" }
    let start = idx + len(needle)
    let mut i = start
    while i < len(payload) {
        let c = payload.substring(i, i + 1)
        if c == " " { i = i + 1 } else { break }
    }
    if i >= len(payload) { return "" }
    let first = payload.substring(i, i + 1)
    if first == "\"" {
        let mut j = i + 1
        while j < len(payload) {
            let cj = payload.substring(j, j + 1)
            if cj == "\"" { break }
            j = j + 1
        }
        return payload.substring(i + 1, j)
    }
    let mut k = i
    while k < len(payload) {
        let ck = payload.substring(k, k + 1)
        if ck == "," { break }
        if ck == "}" { break }
        k = k + 1
    }
    return payload.substring(i, k).trim()
}

fn one_iter(idx, mode, tau, run_dir, hist_file, last_emit_file) {
    let ts = now_iso()
    println("--- iter #" + str(idx) + " [" + ts + "] mode=" + mode + " ---")

    let mut extra = ""
    if mode == "dry" { extra = " --dry-run" }
    let cmd = PY_BIN + " " + HELPER_PY +
              " --seed " + sh_quote("도우미: ") +
              " --tau " + str(tau) +
              " --w1 0.5 --w2 0.5 --refractory-s 30" +
              " --history-file " + hist_file +
              " --last-emit-file " + last_emit_file +
              " --iter " + str(idx) +
              extra +
              " 2>&1"
    let stdout = shell(cmd)
    let payload = extract_marker_line(stdout, "VOLITION_JSON")
    if payload == "" {
        println("  ❌ no VOLITION_JSON marker. raw stdout (first 200 chars):")
        let mut snip_end = 200
        if len(stdout) < 200 { snip_end = len(stdout) }
        println("    " + stdout.substring(0, snip_end))
        return ["error", "", ""]
    }

    let decision = extract_json_field(payload, "decision")
    let v_str    = extract_json_field(payload, "v_smoothed")
    let h_str    = extract_json_field(payload, "hidden_norm")
    let e_str    = extract_json_field(payload, "entropy_norm")
    let refr     = extract_json_field(payload, "refractory_blocked")
    let resp     = extract_json_field(payload, "response")
    let err      = extract_json_field(payload, "error")

    let mut symbol = "🤐"
    if decision == "emit" { symbol = "💬" }
    println("  " + symbol + " decision=" + decision +
            "  v=" + v_str + "  ‖h‖=" + h_str + "  H=" + e_str +
            "  refr=" + refr)
    if decision == "emit" {
        println("    response: " + resp)
    }
    if err != "" && err != "null" {
        println("    ⚠ error=" + err)
    }

    let iter_path = run_dir + "/iter_" + str(idx) + ".json"
    exec("echo " + sh_quote(payload) + " > " + iter_path)
    return [decision, v_str, iter_path]
}

fn selftest() {
    println("[selftest] anima_volitional_speak_v0.hexa")
    let c1 = shell("test -f " + HELPER_PY + " && echo y || echo n") == "y"
    let c2 = shell("test -x " + PY_BIN + " && echo y || echo n") == "y"
    let c3 = shell("test -f /Users/ghost/.cache/anima/clm_v5_remapped/phase2_cotrain_engine_ag/ckpts/ckpt_final.pt && echo y || echo n") == "y"
    let mut m1 = "❌"
    if c1 { m1 = "✅" }
    let mut m2 = "❌"
    if c2 { m2 = "✅" }
    let mut m3 = "❌"
    if c3 { m3 = "✅" }
    println("  " + m1 + " helper.py exists")
    println("  " + m2 + " /usr/bin/python3 executable")
    println("  " + m3 + " substrate A ckpt exists (else dry-run only)")

    println("")
    println("[selftest] running 5-iter dry-run...")
    let run_dir = STATE_BASE + "/" + RUN_DIR
    exec("mkdir -p " + run_dir)
    let hist_file = run_dir + "/_hist.json"
    let last_emit_file = run_dir + "/_last_emit"
    exec("rm -f " + hist_file + " " + last_emit_file)

    let mut n_emit = 0
    let mut n_silent = 0
    let mut n_err = 0
    let mut i = 1
    while i <= 5 {
        let res = one_iter(i, "dry", 0.7, run_dir, hist_file, last_emit_file)
        let dec = res[0]
        if dec == "emit" { n_emit = n_emit + 1 }
        if dec == "silent" { n_silent = n_silent + 1 }
        if dec == "error" { n_err = n_err + 1 }
        i = i + 1
    }
    println("")
    println("[selftest] summary: emit=" + str(n_emit) +
            "  silent=" + str(n_silent) +
            "  error=" + str(n_err))
    if c1 && c2 && n_err == 0 {
        println("  selftest=ok")
        return 0
    }
    println("  selftest=FAIL")
    return 1
}

fn main() {
    let argv = real_args()
    let n = len(argv)

    let mut i = 0
    while i < n {
        if argv[i] == "--selftest" { return selftest() }
        i = i + 1
    }

    let mut iters    = 5
    let mut tau      = 0.7
    let mut interval = 5
    let mut mode     = "dry"
    if n >= 1 { iters = parse_int(argv[0]) }
    if n >= 2 { tau = parse_float(argv[1]) }
    if n >= 3 { interval = parse_int(argv[2]) }
    if n >= 4 { mode = argv[3] }

    let run_dir = STATE_BASE + "/" + RUN_DIR
    exec("mkdir -p " + run_dir)
    let hist_file = run_dir + "/_hist.json"
    let last_emit_file = run_dir + "/_last_emit"

    println("=== anima volitional speak() V0 (substrate A) ===")
    println("  iters:     " + str(iters))
    println("  tau:       " + str(tau))
    println("  interval:  " + str(interval) + "s")
    println("  mode:      " + mode)
    println("  run_dir:   " + run_dir)
    println("")

    let mut n_emit = 0
    let mut n_silent = 0
    let mut n_err = 0
    let mut k = 1
    while k <= iters {
        let res = one_iter(k, mode, tau, run_dir, hist_file, last_emit_file)
        let dec = res[0]
        if dec == "emit" { n_emit = n_emit + 1 }
        if dec == "silent" { n_silent = n_silent + 1 }
        if dec == "error" { n_err = n_err + 1 }
        if k < iters { exec("sleep " + str(interval)) }
        k = k + 1
    }

    println("")
    println("=== summary ===")
    println("  emit:   " + str(n_emit))
    println("  silent: " + str(n_silent))
    println("  error:  " + str(n_err))
    println("  log:    " + run_dir)
    return 0
}
