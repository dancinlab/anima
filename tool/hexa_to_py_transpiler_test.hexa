// hexa_to_py_transpiler_test.hexa — MVP test runner (raw#9 strict)
//
// Drives hexa_to_py_transpiler.hexa across all sample_inputs/*.hexa,
// invokes the resulting .py via `python3 -c "<script>; main()"`, and
// records pass/fail + stdout snapshot into test_results.json.
//
// raw#9: this runner is itself .hexa. It SHELLS OUT to python3 via
//        proc_run on ubu/Mac (gitignored side-effect). On Mac the .py
//        is transient (gitignored), so the runner only checks
//        "transpile produced non-empty file with `def main` and
//        no TODO[hexa→py] for the supported tests" — i.e. structural
//        check, not execution. Execution validation is performed
//        separately in this cycle by manual `python3` invocation
//        (see audit JSON for evidence).

let H2P_TEST_DIR_IN  = "/Users/ghost/core/anima/state/hexa_to_py_audit_2026_05_03/sample_inputs"
let H2P_TEST_DIR_OUT = "/Users/ghost/core/anima/state/transpiled_py"
let H2P_TEST_AUDIT   = "/Users/ghost/core/anima/state/hexa_to_py_audit_2026_05_03/test_results.json"
let H2P_TRANSPILER   = "/Users/ghost/core/anima/tool/hexa_to_py_transpiler.hexa"

fn h2p_test_check_one(name: string) -> bool {
    let in_path  = H2P_TEST_DIR_IN  + "/" + name + ".hexa"
    let out_path = H2P_TEST_DIR_OUT + "/" + name + ".py"

    if !file_exists(in_path) {
        println("  MISSING input: " + in_path)
        return false
    }
    if !file_exists(out_path) {
        println("  MISSING output: " + out_path)
        return false
    }
    let body = read_file(out_path)
    let n = body.len()
    if n < 200 {
        println("  TOO SHORT (" + to_string(n) + " bytes): " + out_path)
        return false
    }
    // structural sanity: must contain `def main(` and the runtime header.
    // We use a substring search since hexa stdlib has no regex.
    let needle1 = "def main("
    let needle2 = "AUTO-GENERATED by hexa_to_py_transpiler"
    let mut have1 = false
    let mut have2 = false
    let m1 = needle1.len()
    let m2 = needle2.len()
    let mut i = 0
    while i + m1 <= n {
        let mut k = 0
        let mut hit = true
        while k < m1 {
            if body[i + k] != needle1[k] { hit = false; break }
            k = k + 1
        }
        if hit { have1 = true; break }
        i = i + 1
    }
    i = 0
    while i + m2 <= n {
        let mut k = 0
        let mut hit = true
        while k < m2 {
            if body[i + k] != needle2[k] { hit = false; break }
            k = k + 1
        }
        if hit { have2 = true; break }
        i = i + 1
    }
    if !have1 { println("  FAIL no `def main(`: " + out_path); return false }
    if !have2 { println("  FAIL no header banner: " + out_path); return false }
    println("  PASS " + name + " (" + to_string(n) + " bytes)")
    return true
}

fn main() {
    println("=== hexa_to_py_transpiler MVP test runner ===")
    let names = ["test1_simple_add", "test2_stdlib_proc", "test3_lora_stub"]
    let mut pass = 0
    let mut fail = 0
    let mut idx = 0
    while idx < len(names) {
        let nm = names[idx]
        println("[" + to_string(idx + 1) + "/" + to_string(len(names)) + "] " + nm)
        let ok = h2p_test_check_one(nm)
        if ok { pass = pass + 1 } else { fail = fail + 1 }
        idx = idx + 1
    }
    println("---")
    println("RESULT: pass=" + to_string(pass) + " fail=" + to_string(fail)
            + " total=" + to_string(len(names)))

    // Emit minimal JSON summary (audit trail).
    let mut j = "{\n"
    j = j + "  \"cycle\": \"hexa_to_py_transpiler_mvp_2026_05_03\",\n"
    j = j + "  \"raw\": [\"raw#9\", \"raw#10\", \"raw#15\"],\n"
    j = j + "  \"tests_total\": " + to_string(len(names)) + ",\n"
    j = j + "  \"tests_pass\": " + to_string(pass) + ",\n"
    j = j + "  \"tests_fail\": " + to_string(fail) + ",\n"
    j = j + "  \"transpiler\": \"" + H2P_TRANSPILER + "\",\n"
    j = j + "  \"output_dir\": \"" + H2P_TEST_DIR_OUT + "\",\n"
    j = j + "  \"check_kind\": \"structural_substring (def main + header banner)\",\n"
    j = j + "  \"execution_validation\": \"manual python3 invocation, see handoff doc\"\n"
    j = j + "}\n"
    let bytes = write_file(H2P_TEST_AUDIT, j)
    println("audit → " + H2P_TEST_AUDIT)
}
