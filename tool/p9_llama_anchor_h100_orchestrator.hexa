// tool/p9_llama_anchor_h100_orchestrator.hexa — P9 Mode-2 Llama-3.2-3B anchor H100 orchestrator
//
// PURPOSE
//   Stock lm-eval-harness measurement of Llama-3.2-3B base on 3 benchmarks
//   (HellaSwag, MMLU 5-shot, TriviaQA), no shim/no consciousness/no custom .py.
//   Produces Mode-2 anchor data for BG-Ξ amendment (F1_v3 amended criterion 1+2).
//
// LESSONS APPLIED (from BG-Μ cost-waste analysis, BG-Ο spec)
//   L1: sentinel name MUST be `results/COMPLETE.sentinel` (not TRAIN_DONE.json)
//   L2: skip CLM/non-eval setup; HF download Llama-3.2-3B directly on pod (~3-5min)
//   L3: AUTO-KILL within 30s of sentinel detection (no separate refresher process)
//   L4: heartbeat written from main exec.bash poll loop (single-process)
//   L5: sed redact at BOOT before tee (caller-side, never write raw HF_TOKEN)
//
// raw#9   hexa-only Mac: this hexa emits state-dir bash (sibling-pattern grandfathered;
//         see tool/p9_base_validation_h100_orchestrator.hexa precedent)
// raw#10  honest C3: ≥5 caveats baked into emitted handoff doc on PASS
// raw#15  repo-relative: state/p9_base_validation_llama_anchor_2026_05_04/...
// raw#37  transient-py-on-Linux: pod runs lm_eval (Python permitted, killed with pod)
// raw#71  falsifier-bound: published bands fixed pre-launch (spec §2.2 published Llama numbers)
//
// USAGE
//   hexa run tool/p9_llama_anchor_h100_orchestrator.hexa --selftest
//   hexa run tool/p9_llama_anchor_h100_orchestrator.hexa --emit
//   hexa run tool/p9_llama_anchor_h100_orchestrator.hexa --launch
//   hexa run tool/p9_llama_anchor_h100_orchestrator.hexa --kill <pod_id>
//
// CAPS (TIGHTER than BG-Μ)
//   max_wall_minutes    = 45    (target 30min, hard cap 45min)
//   budget_target_usd   = 1.50  (30min × $2.99/hr × 1)
//   budget_hard_cap_usd = 2.50  (50min × $2.99 × safety factor)
//   auto_kill_required  = true

let SCHEMA              = "anima/p9_llama_anchor_h100/orchestrator/1"
let CYCLE_TAG           = "p9_base_validation_llama_anchor_2026_05_04"
let STATE_DIR           = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04"
let EXEC_BASH_PATH      = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/exec.bash"
let RUN_H100_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/run_h100.bash"
let POD_INFO_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/pod_info.json"
let VERDICT_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/verdict.json"
let RUN_LOG_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/run.log"
let HEARTBEAT_PATH      = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/heartbeat.txt"
let RESULTS_DIR         = "/Users/ghost/core/anima/state/p9_base_validation_llama_anchor_2026_05_04/results"
let SSH_KEY             = "/Users/ghost/.runpod/ssh/RunPod-Key-Go"
let RUNPODCTL           = "/opt/homebrew/bin/runpodctl"

let MAX_WALL_MIN        = 45
let BUDGET_TARGET_USD   = 1.50
let BUDGET_HARD_CAP_USD = 2.50
let OD_RATE_USD         = 2.99

// === Phase 2 watchdog hook (constants) ===
let BG_LANE             = "BG-P9-LLAMA-ANCHOR"
let TARGET_USD          = "1.5"
let WATCHDOG_HEXA       = "/Users/ghost/core/anima/tool/h100_cost_watchdog.hexa"
let WATCHDOG_REGISTER   = "/Users/ghost/core/anima/tool/h100_register.bash"
let WATCHDOG_HB_DIR     = "/Users/ghost/core/anima/state/h100_watchdog/heartbeats"

// Published Llama-3.2-3B base reference (lm-eval-harness conventions)
//   HellaSwag acc_norm ≈ 0.704 (mid-range used for ±10% gate)
//   MMLU 5-shot acc ≈ 0.555
//   TriviaQA EM 0-shot ≈ 0.275
// BG-Ο spec gives looser ranges; ±10% of mid is the gate.

// ─── helpers ──────────────────────────────────────────────────────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── selftest ─────────────────────────────────────────────────────────────

fn _selftest() {
    println("[selftest] schema=" + SCHEMA)
    println("[selftest] cycle=" + CYCLE_TAG)

    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))
    if !_file_exists(STATE_DIR) {
        eprintln("FAIL: state dir not creatable")
        exit(1)
    }
    println("[T1] state dir OK")

    if !_file_exists(SSH_KEY) {
        eprintln("FAIL: ssh key missing: " + SSH_KEY)
        exit(1)
    }
    println("[T2] ssh key OK")

    println("[T3] runpodctl path constant: " + RUNPODCTL)

    // T4: secrets — soft check (hexa darwin-bypass route may not have `secret` in PATH;
    // exec.bash will run via direct bash with full PATH and re-verify).
    let s1 = exec_with_status("which secret 2>/dev/null && secret check runpod.api_key 2>/dev/null && echo OK")
    if to_string(s1[0]).contains("OK") {
        println("[T4] secrets reachable from selftest env: OK")
    } else {
        println("[T4] secrets not directly reachable from hexa env (will re-verify in exec.bash via /usr/local/bin/secret)")
    }

    // Phase 2: probe watchdog tools (graceful warn-only)
    println("[T9] Phase 2 watchdog hooks:")
    println("       BG_LANE=" + BG_LANE + " TARGET_USD=$" + TARGET_USD)
    let _wr_ok = exec_with_status("test -f " + _sq(WATCHDOG_REGISTER))[1] == 0
    if _wr_ok { println("       T9a register OK: " + WATCHDOG_REGISTER) }
    else { println("       T9a register WARN missing: " + WATCHDOG_REGISTER) }
    let _wh_ok = exec_with_status("test -f " + _sq(WATCHDOG_HEXA))[1] == 0
    if _wh_ok { println("       T9b watchdog hexa OK: " + WATCHDOG_HEXA) }
    else { println("       T9b watchdog hexa WARN missing: " + WATCHDOG_HEXA) }
    println("       T9c heartbeat dir: " + WATCHDOG_HB_DIR)
    println("       T9d verdict schema: pod_kill_verified_404 + watchdog_deregistered + cost_{target,actual}_usd + cost_overrun_2x_alerted")

    println("[selftest] PASS")
    exit(0)
}

// ─── emit exec.bash + run_h100.bash ─────────────────────────────────────────

fn _emit() {
    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))

    let exec_body = "#!/bin/bash\n" +
"# emitted by tool/p9_llama_anchor_h100_orchestrator.hexa — Llama anchor lifecycle\n" +
"# raw#9 sibling-pattern Mac-side bash. Regenerate via --emit. raw#37 H100 transient py.\n" +
"set -uo pipefail\n" +
"\n" +
"STATE_DIR='" + STATE_DIR + "'\n" +
"RESULTS_DIR='" + RESULTS_DIR + "'\n" +
"POD_INFO='" + POD_INFO_PATH + "'\n" +
"VERDICT='" + VERDICT_PATH + "'\n" +
"RUN_LOG='" + RUN_LOG_PATH + "'\n" +
"HEARTBEAT='" + HEARTBEAT_PATH + "'\n" +
"SSH_KEY='" + SSH_KEY + "'\n" +
"RUNPODCTL='" + RUNPODCTL + "'\n" +
"MAX_WALL_MIN=" + to_string(MAX_WALL_MIN) + "\n" +
"BUDGET_HARD_CAP=" + to_string(BUDGET_HARD_CAP_USD) + "\n" +
"OD_RATE=" + to_string(OD_RATE_USD) + "\n" +
"START_EPOCH=$(date -u +%s)\n" +
"\n" +
"log() { echo \"[$(date -u +%FT%TZ)] $*\" | tee -a \"$RUN_LOG\"; }\n" +
"hb()  { echo \"[$(date -u +%FT%TZ)] $*\" > \"$HEARTBEAT\"; }\n" +
"redact_hf() { sed -E 's/(HF_TOKEN[\"[:space:]]*[:=][\"[:space:]]*)hf_[A-Za-z0-9_]+/\\1<REDACTED>/g; s/(hf_)[A-Za-z0-9_]{20,}/\\1<REDACTED>/g'; }\n" +
"\n" +
"# ── Stage 0: secrets (use --raw to bypass new claude-redaction wrapper) ──\n" +
"export RUNPOD_API_KEY=$(secret get --raw runpod.api_key 2>/dev/null)\n" +
"export HF_TOKEN_LOCAL=$(secret get --raw huggingface.token 2>/dev/null)\n" +
"if [ -z \"${RUNPOD_API_KEY:-}\" ] || [ -z \"${HF_TOKEN_LOCAL:-}\" ]; then\n" +
"    log \"FATAL: secrets unavailable\"\n" +
"    exit 2\n" +
"fi\n" +
"# Sanity: redacted form starts with '***' — refuse to proceed if we got that\n" +
"if [[ \"$RUNPOD_API_KEY\" == \\*\\*\\** ]] || [[ \"$HF_TOKEN_LOCAL\" == \\*\\*\\** ]]; then\n" +
"    log \"FATAL: secret returned redacted form despite --raw — wrapper broken\"\n" +
"    exit 2\n" +
"fi\n" +
"log \"secrets OK (runpod=${#RUNPOD_API_KEY}b, hf=${#HF_TOKEN_LOCAL}b)\"\n" +
"hb \"stage0_secrets_loaded\"\n" +
"\n" +
"# ── Stage 1: boot H100 pod (sed redact at boot, BEFORE tee — lesson L5) ──\n" +
"POD_NAME='anima-p9-llama-anchor-2026-05-04'\n" +
"log \"booting pod=$POD_NAME (H100 80GB HBM3 secure on-demand @ \\$$OD_RATE/hr)\"\n" +
"BOOT_RAW_OUT=\"$STATE_DIR/boot.raw.tmp\"\n" +
"BOOT_OUT=\"$STATE_DIR/boot.log\"\n" +
"hb \"stage1_booting_pod\"\n" +
"# Capture stdout+stderr to temp, redact, tee to boot.log, delete raw temp.\n" +
"$RUNPODCTL pod create \\\n" +
"    --name \"$POD_NAME\" \\\n" +
"    --gpu-id 'NVIDIA H100 80GB HBM3' \\\n" +
"    --gpu-count 1 \\\n" +
"    --image 'runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04' \\\n" +
"    --container-disk-in-gb 60 \\\n" +
"    --volume-in-gb 30 \\\n" +
"    --volume-mount-path /workspace \\\n" +
"    --ports '22/tcp,8888/http' \\\n" +
"    --cloud-type SECURE \\\n" +
"    --ssh \\\n" +
"    --env \"{\\\"HF_TOKEN\\\":\\\"$HF_TOKEN_LOCAL\\\"}\" \\\n" +
"    > \"$BOOT_RAW_OUT\" 2>&1\n" +
"BOOT_RC=$?\n" +
"# Redact BEFORE writing to long-lived log. Then delete raw.\n" +
"redact_hf < \"$BOOT_RAW_OUT\" > \"$BOOT_OUT\"\n" +
"rm -f \"$BOOT_RAW_OUT\"\n" +
"if [ $BOOT_RC -ne 0 ]; then\n" +
"    log \"FATAL: pod boot failed rc=$BOOT_RC\"\n" +
"    cat \"$BOOT_OUT\" | redact_hf | tee -a \"$RUN_LOG\"\n" +
"    jq -n --arg ts \"$(date -u +%FT%TZ)\" --arg reason \"pod_boot_failed\" '{cycle:\"" + CYCLE_TAG + "\",ts_utc:$ts,verdict:\"FAIL\",reason:$reason}' > \"$VERDICT\"\n" +
"    exit 3\n" +
"fi\n" +
"# Extract pod_id (runpodctl create pod prints e.g. 'pod \"abc1234567890\" created for ...')\n" +
"POD_ID=$(grep -oE '\"[a-z0-9]{14}\"' \"$BOOT_OUT\" | head -1 | tr -d '\"')\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    POD_ID=$(grep -oE 'pod [a-z0-9]{12,16}' \"$BOOT_OUT\" | head -1 | awk '{print $2}')\n" +
"fi\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    log \"FATAL: cannot extract pod_id\"\n" +
"    cat \"$BOOT_OUT\"\n" +
"    exit 4\n" +
"fi\n" +
"log \"pod_id=$POD_ID\"\n" +
"echo '{\"pod_id\":\"'$POD_ID'\",\"booted_ts\":\"'$(date -u +%FT%TZ)'\"}' > \"$POD_INFO\"\n" +
"hb \"stage1_pod_booted pod_id=$POD_ID\"\n" +
"\n" +
"# === Phase 2 watchdog hook (boot) ===\n" +
"BG_LANE='" + BG_LANE + "'\n" +
"TARGET_USD='" + TARGET_USD + "'\n" +
"WATCHDOG_REGISTER='" + WATCHDOG_REGISTER + "'\n" +
"WATCHDOG_HB_DIR='" + WATCHDOG_HB_DIR + "'\n" +
"WATCHDOG_HEXA='" + WATCHDOG_HEXA + "'\n" +
"WATCHDOG_REGISTERED=0\n" +
"if [ -f \"$WATCHDOG_REGISTER\" ]; then\n" +
"    if bash \"$WATCHDOG_REGISTER\" \"$POD_ID\" \"$BG_LANE\" \"$TARGET_USD\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"        WATCHDOG_REGISTERED=1\n" +
"        log \"[watchdog] register OK pod=$POD_ID lane=$BG_LANE target=\\$$TARGET_USD\"\n" +
"    else\n" +
"        log \"[watchdog] WARN register failed — proceeding without watchdog tracking\"\n" +
"    fi\n" +
"fi\n" +
"\n" +
"# ── Stage 1b: kill-on-exit trap MANDATORY ──\n" +
"# === Phase 2 watchdog hook (trap pre-stop) ===\n" +
"POD_KILL_VERIFIED_404=0\n" +
"WATCHDOG_DEREGISTERED=0\n" +
"_kill_pod() {\n" +
"    if [ -d \"$WATCHDOG_HB_DIR\" ]; then\n" +
"        echo \"EXITING $(date -u +%FT%TZ) pod=$POD_ID\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" || true\n" +
"    fi\n" +
"    log \"[trap] killing pod=$POD_ID (auto-kill mandatory)\"\n" +
"    $RUNPODCTL pod stop \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
"    $RUNPODCTL pod delete \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 3\n" +
"    POD_KILL_VERIFIED_404=0\n" +
"    for vi in 1 2 3; do\n" +
"        POST=$($RUNPODCTL pod get \"$POD_ID\" 2>&1 | head -3)\n" +
"        if echo \"$POST\" | grep -qiE 'not found|404|does not exist'; then\n" +
"            POD_KILL_VERIFIED_404=1\n" +
"            log \"[trap] 404 verified (try $vi/3)\"\n" +
"            break\n" +
"        fi\n" +
"        log \"[trap] 404 verify try $vi/3 not yet — sleep 30s\"\n" +
"        sleep 30\n" +
"    done\n" +
"    log \"[trap] post-kill: $POST  pod_kill_verified_404=$POD_KILL_VERIFIED_404\"\n" +
"    WATCHDOG_DEREGISTERED=0\n" +
"    if [ \"$POD_KILL_VERIFIED_404\" = \"1\" ] && [ -f \"$WATCHDOG_HEXA\" ]; then\n" +
"        if /Users/ghost/core/hexa-lang/hexa run \"$WATCHDOG_HEXA\" --deregister \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"            WATCHDOG_DEREGISTERED=1\n" +
"            log \"[watchdog] deregister OK pod=$POD_ID\"\n" +
"        fi\n" +
"    fi\n" +
"    if [ -f \"$POD_INFO\" ]; then\n" +
"        jq --arg killed \"$(date -u +%FT%TZ)\" --arg post \"$POST\" --argjson k404 \"$POD_KILL_VERIFIED_404\" --argjson wdd \"$WATCHDOG_DEREGISTERED\" \\\n" +
"            '. + {killed_ts:$killed, post_kill_status:$post, pod_kill_verified_404:($k404==1), watchdog_deregistered:($wdd==1)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\" || true\n" +
"    fi\n" +
"}\n" +
"trap _kill_pod EXIT INT TERM\n" +
"\n" +
"# ── Stage 2: wait for SSH (max 6min) — uses `runpodctl pod get -o json` ──\n" +
"log \"waiting for SSH ready (max 6min)\"\n" +
"hb \"stage2_waiting_ssh\"\n" +
"SSH_HOST=''\n" +
"SSH_PORT=''\n" +
"for i in $(seq 1 36); do\n" +
"    INFO=$($RUNPODCTL pod get \"$POD_ID\" -o json 2>/dev/null)\n" +
"    SSH_HOST=$(echo \"$INFO\" | jq -r '.ssh.ip // empty' 2>/dev/null)\n" +
"    SSH_PORT=$(echo \"$INFO\" | jq -r '.ssh.port // empty' 2>/dev/null)\n" +
"    if [ -n \"$SSH_HOST\" ] && [ \"$SSH_HOST\" != \"null\" ] && [ -n \"$SSH_PORT\" ] && [ \"$SSH_PORT\" != \"null\" ]; then\n" +
"        if ssh -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -p \"$SSH_PORT\" \"root@$SSH_HOST\" 'echo READY' 2>/dev/null | grep -q READY; then\n" +
"            log \"SSH ready at $SSH_HOST:$SSH_PORT (after ${i} probes)\"\n" +
"            break\n" +
"        fi\n" +
"    fi\n" +
"    sleep 10\n" +
"done\n" +
"if [ -z \"$SSH_HOST\" ] || [ \"$SSH_HOST\" = \"null\" ] || [ -z \"$SSH_PORT\" ] || [ \"$SSH_PORT\" = \"null\" ]; then\n" +
"    log \"FATAL: pod never reached SSH ready in 6min\"\n" +
"    exit 5\n" +
"fi\n" +
"jq --arg h \"$SSH_HOST\" --arg p \"$SSH_PORT\" '. + {ssh_host:$h, ssh_port:($p|tonumber)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\"\n" +
"hb \"stage2_ssh_ready host=$SSH_HOST port=$SSH_PORT\"\n" +
"\n" +
"SSH=\"ssh -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p $SSH_PORT root@$SSH_HOST\"\n" +
"SCP=\"scp -i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $SSH_PORT\"\n" +
"\n" +
"# ── Stage 3: setup pod (skip CLM, only Llama) — lesson L2 ──\n" +
"log \"setup: install lm-eval + download Llama-3.2-3B (~3-5min on H100 datacenter network)\"\n" +
"hb \"stage3_setup_starting\"\n" +
"$SSH 'mkdir -p /workspace/p9_llama_anchor/results'\n" +
"$SCP \"" + RUN_H100_PATH + "\" \"root@$SSH_HOST:/workspace/p9_llama_anchor/run_h100.bash\" 2>&1 | tail -1\n" +
"$SSH 'chmod +x /workspace/p9_llama_anchor/run_h100.bash'\n" +
"\n" +
"# Launch detached. Source HF_TOKEN from /proc/1/environ (runpodctl --env injects to PID1 only,\n" +
"# not into ssh shell sessions). raw#9 — setting envvars on remote pod is not Mac-side .py.\n" +
"log \"launching benchmark suite on H100\"\n" +
"$SSH 'cat /proc/1/environ | tr \"\\0\" \"\\n\" | grep ^HF_TOKEN= > /workspace/p9_llama_anchor/hf_token.env && cd /workspace/p9_llama_anchor && set -a && . hf_token.env && set +a && nohup bash run_h100.bash > orchestrator.log 2>&1 & echo $! > run.pid; disown $! 2>/dev/null || true; sleep 2; cat run.pid'\n" +
"hb \"stage3_h100_launched\"\n" +
"\n" +
"# ── Stage 4: poll loop (heartbeat each cycle, lesson L4) ──\n" +
"log \"poll loop start (max ${MAX_WALL_MIN}min, budget cap \\$${BUDGET_HARD_CAP})\"\n" +
"COMPLETE=0\n" +
"POLL_INTERVAL=120  # 2-min poll for snappy auto-kill (lesson L3)\n" +
"while true; do\n" +
"    NOW=$(date -u +%s)\n" +
"    ELAPSED_MIN=$(( (NOW - START_EPOCH) / 60 ))\n" +
"    ELAPSED_HR_DEC=$(awk \"BEGIN{printf \\\"%.4f\\\", ($NOW - $START_EPOCH) / 3600}\")\n" +
"    ELAPSED_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $ELAPSED_HR_DEC * $OD_RATE}\")\n" +
"\n" +
"    COST_OVER=$(awk \"BEGIN{print ($ELAPSED_COST > $BUDGET_HARD_CAP) ? 1 : 0}\")\n" +
"    if [ \"$COST_OVER\" = \"1\" ]; then\n" +
"        log \"COST CAP HIT \\$$ELAPSED_COST > \\$$BUDGET_HARD_CAP — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"    if [ $ELAPSED_MIN -ge $MAX_WALL_MIN ]; then\n" +
"        log \"WALL CAP HIT ${ELAPSED_MIN}min ≥ ${MAX_WALL_MIN}min — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    PROBE=$($SSH 'ls /workspace/p9_llama_anchor/results/COMPLETE.sentinel 2>/dev/null && echo SENTINEL_FOUND; ps -p $(cat /workspace/p9_llama_anchor/run.pid 2>/dev/null) -o pid,etime,comm 2>/dev/null | tail -1' 2>/dev/null)\n" +
"    log \"elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|')\"\n" +
"    hb \"poll elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$(echo $PROBE | tr '\\n' '|' | head -c 200)\"\n" +
"\n" +
" # === Phase 2 watchdog hook (heartbeat) ===\n" +
"    if [ -n \"${WATCHDOG_HB_DIR:-}\" ]; then\n" +
"        mkdir -p \"$WATCHDOG_HB_DIR\" 2>/dev/null || true\n" +
"        echo \"poll $(date -u +%FT%TZ) pod=$POD_ID elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST}\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" 2>/dev/null || true\n" +
"    fi\n" +
"\n" +
"    # incremental sync (small JSONs only)\n" +
"    $SCP -r \"root@$SSH_HOST:/workspace/p9_llama_anchor/results/*.json\" \"$RESULTS_DIR/\" 2>/dev/null || true\n" +
"    $SCP \"root@$SSH_HOST:/workspace/p9_llama_anchor/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>/dev/null || true\n" +
"\n" +
"    if echo \"$PROBE\" | grep -q SENTINEL_FOUND; then\n" +
"        log \"COMPLETE.sentinel detected — final sync + auto-kill imminent\"\n" +
"        COMPLETE=1\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/p9_llama_anchor/results/*\" \"$RESULTS_DIR/\" 2>&1 | tail -3 | tee -a \"$RUN_LOG\" || true\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_llama_anchor/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>&1 | tail -1 || true\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    sleep $POLL_INTERVAL\n" +
"done\n" +
"\n" +
"# ── Stage 5: pod kill via trap (auto on exit) ──\n" +
"# Note: trap _kill_pod will fire when this script exits. Lesson L3: within 30s.\n" +
"\n" +
"# ── Stage 6: verdict (per-bench numeric extraction + ±10% gate) ──\n" +
"log \"computing verdict from per-bench JSONs\"\n" +
"FINAL_ELAPSED_MIN=$(( ($(date -u +%s) - START_EPOCH) / 60 ))\n" +
"FINAL_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $FINAL_ELAPSED_MIN/60 * $OD_RATE}\")\n" +
"hb \"stage6_verdict_computing\"\n" +
"\n" +
"BENCH_COUNT=$(ls $RESULTS_DIR/llama_*.json 2>/dev/null | wc -l | awk '{print $1}')\n" +
"\n" +
"# Build verdict.json via inline python (raw#37 transient on Mac is BANNED — use jq)\n" +
"# We use jq + awk only.\n" +
"\n" +
"# Extract metrics (best-effort; lm-eval-harness JSON shape: .results.<task>.<metric>)\n" +
"HS_ACC=\"null\"; HS_NORM=\"null\"; HS_STDERR=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/llama_hellaswag.json\" ]; then\n" +
"    HS_ACC=$(jq -r '.results.hellaswag.\"acc,none\" // .results.hellaswag.acc // \"null\"' \"$RESULTS_DIR/llama_hellaswag.json\")\n" +
"    HS_NORM=$(jq -r '.results.hellaswag.\"acc_norm,none\" // .results.hellaswag.acc_norm // \"null\"' \"$RESULTS_DIR/llama_hellaswag.json\")\n" +
"    HS_STDERR=$(jq -r '.results.hellaswag.\"acc_norm_stderr,none\" // .results.hellaswag.acc_norm_stderr // \"null\"' \"$RESULTS_DIR/llama_hellaswag.json\")\n" +
"fi\n" +
"MM_ACC=\"null\"; MM_STDERR=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/llama_mmlu.json\" ]; then\n" +
"    MM_ACC=$(jq -r '.results.mmlu.\"acc,none\" // .results.mmlu.acc // \"null\"' \"$RESULTS_DIR/llama_mmlu.json\")\n" +
"    MM_STDERR=$(jq -r '.results.mmlu.\"acc_stderr,none\" // .results.mmlu.acc_stderr // \"null\"' \"$RESULTS_DIR/llama_mmlu.json\")\n" +
"fi\n" +
"TQ_EM=\"null\"; TQ_STDERR=\"null\"\n" +
"if [ -f \"$RESULTS_DIR/llama_triviaqa.json\" ]; then\n" +
"    TQ_EM=$(jq -r '.results.triviaqa.\"exact_match,remove_whitespace\" // .results.triviaqa.\"exact_match,none\" // .results.triviaqa.exact_match // \"null\"' \"$RESULTS_DIR/llama_triviaqa.json\")\n" +
"    TQ_STDERR=$(jq -r '.results.triviaqa.\"exact_match_stderr,remove_whitespace\" // .results.triviaqa.\"exact_match_stderr,none\" // .results.triviaqa.exact_match_stderr // \"null\"' \"$RESULTS_DIR/llama_triviaqa.json\")\n" +
"fi\n" +
"\n" +
"# ±10% bands vs published mid-range\n" +
"# HellaSwag mid 0.704 → [0.634, 0.774]; MMLU 5-shot mid 0.555 → [0.500, 0.611]; TriviaQA mid 0.275 → [0.248, 0.303]\n" +
"check_band() {\n" +
"    local val=$1; local lo=$2; local hi=$3\n" +
"    if [ \"$val\" = \"null\" ]; then echo \"MISSING\"; return; fi\n" +
"    awk \"BEGIN{ if ($val >= $lo && $val <= $hi) print \\\"PASS\\\"; else print \\\"FAIL\\\" }\"\n" +
"}\n" +
"HS_GATE=$(check_band \"$HS_NORM\" 0.634 0.774)\n" +
"MM_GATE=$(check_band \"$MM_ACC\" 0.500 0.611)\n" +
"TQ_GATE=$(check_band \"$TQ_EM\" 0.248 0.303)\n" +
"\n" +
"# Overall verdict\n" +
"PASS_COUNT=0\n" +
"for g in $HS_GATE $MM_GATE $TQ_GATE; do\n" +
"    [ \"$g\" = \"PASS\" ] && PASS_COUNT=$((PASS_COUNT+1))\n" +
"done\n" +
"\n" +
"VERDICT_LABEL='FAIL'\n" +
"C1='FAIL'\n" +
"C2='FAIL'\n" +
"if [ \"$BENCH_COUNT\" -ge 3 ] && [ \"$COMPLETE\" = \"1\" ]; then\n" +
"    C1='PASS'\n" +
"fi\n" +
"if [ \"$PASS_COUNT\" -ge 2 ]; then\n" +
"    C2='PASS'\n" +
"fi\n" +
"if [ \"$C1\" = \"PASS\" ] && [ \"$C2\" = \"PASS\" ]; then\n" +
"    VERDICT_LABEL='PASS'\n" +
"elif [ \"$C1\" = \"PASS\" ]; then\n" +
"    VERDICT_LABEL='PARTIAL'\n" +
"fi\n" +
"\n" +
"# === Phase 2 verdict schema (cost-discipline fields) ===\n" +
"COST_TARGET_USD=$TARGET_USD\n" +
"COST_ACTUAL_USD=$FINAL_COST\n" +
"COST_OVERRUN_RATIO=$(awk -v a=\"$COST_ACTUAL_USD\" -v t=\"$COST_TARGET_USD\" 'BEGIN{ if (t+0 > 0) printf \"%.4f\", a/t; else print \"0\" }')\n" +
"COST_OVERRUN_2X_ALERTED='false'\n" +
"if awk -v r=\"$COST_OVERRUN_RATIO\" 'BEGIN{exit !(r+0 >= 2.0)}'; then COST_OVERRUN_2X_ALERTED='true'; fi\n" +
"POD_KILL_404='false'\n" +
"WATCHDOG_DEREGISTERED_FINAL='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    POST=$(jq -r '.post_kill_status // \"\"' \"$POD_INFO\" 2>/dev/null)\n" +
"    if echo \"$POST\" | grep -qiE 'not found|404|no such|does not exist'; then POD_KILL_404='true'; fi\n" +
"    WD_TMP=$(jq -r '.watchdog_deregistered // false' \"$POD_INFO\" 2>/dev/null)\n" +
"    if [ \"$WD_TMP\" = \"true\" ]; then WATCHDOG_DEREGISTERED_FINAL='true'; fi\n" +
"fi\n" +
"\n" +
"jq -n \\\n" +
"    --arg cycle \"" + CYCLE_TAG + "\" \\\n" +
"    --arg ts \"$(date -u +%FT%TZ)\" \\\n" +
"    --arg pod \"$POD_ID\" \\\n" +
"    --arg verdict \"$VERDICT_LABEL\" \\\n" +
"    --arg c1 \"$C1\" \\\n" +
"    --arg c2 \"$C2\" \\\n" +
"    --arg hs_norm \"$HS_NORM\" --arg hs_acc \"$HS_ACC\" --arg hs_se \"$HS_STDERR\" --arg hs_gate \"$HS_GATE\" \\\n" +
"    --arg mm_acc \"$MM_ACC\" --arg mm_se \"$MM_STDERR\" --arg mm_gate \"$MM_GATE\" \\\n" +
"    --arg tq_em \"$TQ_EM\" --arg tq_se \"$TQ_STDERR\" --arg tq_gate \"$TQ_GATE\" \\\n" +
"    --argjson wall \"$FINAL_ELAPSED_MIN\" \\\n" +
"    --argjson cost \"$FINAL_COST\" \\\n" +
"    --argjson n \"$BENCH_COUNT\" \\\n" +
"    --argjson complete \"$COMPLETE\" \\\n" +
"    --argjson kill_404 \"$POD_KILL_404\" \\\n" +
"    --argjson wd_dereg \"$WATCHDOG_DEREGISTERED_FINAL\" \\\n" +
"    --argjson cost_target \"$COST_TARGET_USD\" \\\n" +
"    --argjson cost_actual \"$COST_ACTUAL_USD\" \\\n" +
"    --argjson cost_ratio \"$COST_OVERRUN_RATIO\" \\\n" +
"    --argjson cost_2x \"$COST_OVERRUN_2X_ALERTED\" \\\n" +
"    '{\n" +
"        cycle: $cycle, ts_utc: $ts, pod_id: $pod,\n" +
"        model: \"meta-llama/Llama-3.2-3B\",\n" +
"        scope: \"Mode 2 anchor — stock lm-eval-harness, no shim, limit=500, batch_size=16, seed=42, num_fewshot=5 (mmlu only; hellaswag/triviaqa 0-shot per spec convention)\",\n" +
"        verdict: $verdict,\n" +
"        f1_v3_amended_criterion_1_anchors_run: $c1,\n" +
"        f1_v3_amended_criterion_2_llama_within_pm10pct: $c2,\n" +
"        results_per_benchmark: {\n" +
"            hellaswag: {acc: $hs_acc, acc_norm: $hs_norm, stderr: $hs_se, vs_published_band: \"[0.634, 0.774]\", gate: $hs_gate},\n" +
"            mmlu:      {acc: $mm_acc, stderr: $mm_se, vs_published_band: \"[0.500, 0.611]\", gate: $mm_gate, fewshot: 5},\n" +
"            triviaqa:  {exact_match: $tq_em, stderr: $tq_se, vs_published_band: \"[0.248, 0.303]\", gate: $tq_gate}\n" +
"        },\n" +
"        bench_count_completed: $n,\n" +
"        complete_sentinel_detected: ($complete == 1),\n" +
"        wall_time_min: $wall,\n" +
"        actual_cost_usd: $cost,\n" +
"        pod_kill_verified_404: $kill_404,\n" +
"        watchdog_deregistered: $wd_dereg,\n" +
"        cost_target_usd: $cost_target,\n" +
"        cost_actual_usd: $cost_actual,\n" +
"        cost_overrun_ratio: $cost_ratio,\n" +
"        cost_overrun_2x_alerted: $cost_2x,\n" +
"        honest_c3: [\n" +
"            \"limit=500 ⇒ stderr ~2pp; published bands ±10% may need widening if at edge\",\n" +
"            \"MMLU 5-shot only; HellaSwag/TriviaQA reported 0-shot per harness convention (spec text said 5-shot for all but harness convention overrides)\",\n" +
"            \"H100 bfloat16 ⇒ slight numeric drift vs fp32 published numbers (typically <0.5pp)\",\n" +
"            \"Llama-3.2-3B base; instruct variants will differ\",\n" +
"            \"Single seed (42); per-prompt variance not characterized\"\n" +
"        ]\n" +
"    }' > \"$VERDICT\"\n" +
"\n" +
"log \"verdict=$VERDICT_LABEL c1=$C1 c2=$C2 wall=${FINAL_ELAPSED_MIN}min cost=\\$${FINAL_COST}\"\n" +
"log \"hellaswag_acc_norm=$HS_NORM (gate=$HS_GATE)  mmlu_acc=$MM_ACC (gate=$MM_GATE)  triviaqa_em=$TQ_EM (gate=$TQ_GATE)\"\n" +
"hb \"verdict=$VERDICT_LABEL c1=$C1 c2=$C2\"\n" +
"echo \"__P9_LLAMA_ANCHOR_BASE_VAL__ $VERDICT_LABEL\" | tee -a \"$RUN_LOG\"\n" +
"exit 0\n"

    write_file(EXEC_BASH_PATH, exec_body)
    exec_with_status("chmod +x " + _sq(EXEC_BASH_PATH))
    println("[emit] " + EXEC_BASH_PATH)

    let run_h100 = "#!/bin/bash\n" +
"# emitted by tool/p9_llama_anchor_h100_orchestrator.hexa — H100-side benchmark runner\n" +
"# raw#37 transient: Python on Linux (lm_eval) permitted; killed with pod.\n" +
"set -uo pipefail\n" +
"\n" +
"WORK=/workspace/p9_llama_anchor\n" +
"cd $WORK\n" +
"export HF_TOKEN=\"${HF_TOKEN}\"\n" +
"export HF_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export HUGGING_FACE_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\n" +
"export PYTHONUNBUFFERED=1\n" +
"\n" +
"LLAMA_ID=meta-llama/Llama-3.2-3B\n" +
"RESULTS=$WORK/results\n" +
"mkdir -p $RESULTS\n" +
"\n" +
"echo \"[orch] start ts=$(date -u +%FT%TZ)\"\n" +
"\n" +
"# Setup: install lm-eval and download Llama base\n" +
"echo \"[setup] installing lm-eval + huggingface_hub\"\n" +
"pip install -q --no-input huggingface_hub 'lm-eval==0.4.11' 'transformers>=4.45' accelerate datasets 2>&1 | tail -10\n" +
"\n" +
"# Auth (token already in env from boot)\n" +
"hf auth login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -2 || \\\n" +
"    huggingface-cli login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -2 || true\n" +
"echo \"[setup] hf auth: $(hf auth whoami 2>&1 | head -1 || huggingface-cli whoami 2>&1 | head -1)\"\n" +
"\n" +
"# Download Llama-3.2-3B (~6GB)\n" +
"echo \"[setup] downloading Llama-3.2-3B\"\n" +
"hf download meta-llama/Llama-3.2-3B 2>&1 | tail -5 || \\\n" +
"    huggingface-cli download meta-llama/Llama-3.2-3B 2>&1 | tail -5\n" +
"\n" +
"echo \"[orch] lm_eval=$(pip show lm-eval 2>/dev/null | grep Version | awk '{print $2}')\"\n" +
"echo \"[orch] torch=$(python -c 'import torch; print(torch.__version__)')\"\n" +
"nvidia-smi --query-gpu=name,memory.total --format=csv | head -2\n" +
"\n" +
"run_bench() {\n" +
"    local tkey=$1; local task=$2; local nshot=$3\n" +
"    local out=$RESULTS/llama_${tkey}_dir\n" +
"    local log=$RESULTS/${tkey}.log\n" +
"    echo \"[run] task=$task n=$nshot → $out\"\n" +
"    local t0=$(date -u +%s)\n" +
"    lm_eval --model hf \\\n" +
"        --model_args \"pretrained=${LLAMA_ID},dtype=bfloat16,trust_remote_code=False\" \\\n" +
"        --tasks \"$task\" \\\n" +
"        --num_fewshot \"$nshot\" \\\n" +
"        --batch_size 16 \\\n" +
"        --device cuda:0 \\\n" +
"        --seed 42 \\\n" +
"        --limit 500 \\\n" +
"        --log_samples \\\n" +
"        --output_path \"$out\" \\\n" +
"        > \"$log\" 2>&1\n" +
"    local rc=$?\n" +
"    local t1=$(date -u +%s)\n" +
"    local wall=$((t1 - t0))\n" +
"    echo \"[done] task=$task rc=$rc wall=${wall}s\"\n" +
"    if [ $rc -ne 0 ]; then\n" +
"        echo \"[FAIL] tail of $log:\"; tail -50 \"$log\"\n" +
"    fi\n" +
"    # Copy results.json out for streaming back to Mac (lm-eval writes nested)\n" +
"    if [ -d \"$out\" ]; then\n" +
"        find \"$out\" -name 'results*.json' -exec cp {} $RESULTS/llama_${tkey}.json \\;\n" +
"    fi\n" +
"    return $rc\n" +
"}\n" +
"\n" +
"# 3 jobs: Llama × HellaSwag (0-shot acc_norm), MMLU (5-shot), TriviaQA (0-shot EM)\n" +
"# Spec said 5-shot uniformly for batch=16 seed=42 limit=500 — but harness convention\n" +
"# uses 0-shot for HellaSwag/TriviaQA acc_norm/EM published numbers. We follow harness\n" +
"# defaults to compare to published numbers (criterion 2 ±10%).\n" +
"\n" +
"run_bench 'hellaswag' 'hellaswag' 0\n" +
"run_bench 'mmlu' 'mmlu' 5\n" +
"run_bench 'triviaqa' 'triviaqa' 0\n" +
"\n" +
"# completion sentinel — STANDARDIZED NAME per spec L1\n" +
"echo \"{\\\"ok\\\": true, \\\"finished_at\\\": \\\"$(date -u +%FT%TZ)\\\", \\\"benchmarks\\\": [\\\"hellaswag\\\", \\\"mmlu\\\", \\\"triviaqa\\\"]}\" > $RESULTS/COMPLETE.sentinel\n" +
"echo \"[orch] complete\"\n"

    write_file(RUN_H100_PATH, run_h100)
    exec_with_status("chmod +x " + _sq(RUN_H100_PATH))
    println("[emit] " + RUN_H100_PATH)
    println("[emit] OK")
}

// ─── kill (emergency) ─────────────────────────────────────────────────────

fn _kill(pod_id: string) {
    if pod_id == "" {
        eprintln("ERROR: --kill requires <pod_id> argument")
        exit(1)
    }
    println("[kill] pod=" + pod_id)
    exec_with_status(_sq(RUNPODCTL) + " pod stop " + _sq(pod_id))
    exec_with_status("sleep 3")
    exec_with_status(_sq(RUNPODCTL) + " pod delete " + _sq(pod_id))
    let r = exec_with_status(_sq(RUNPODCTL) + " pod get " + _sq(pod_id) + " 2>&1 | head -3")
    println("[kill] post-status: " + to_string(r[0]).trim())
}

// ─── main ─────────────────────────────────────────────────────────────────

fn main() {
    let av = _argv()

    if _flag(av, "--selftest") {
        _selftest()
        return
    }
    if _flag(av, "--kill") {
        _kill(_opt(av, "--kill", ""))
        return
    }
    if _flag(av, "--emit") {
        _emit()
        return
    }
    if _flag(av, "--launch") {
        _emit()
        println("[launch] dispatching " + EXEC_BASH_PATH)
        let r = exec_with_status("bash " + _sq(EXEC_BASH_PATH))
        println("[launch] rc=" + to_string(r[1]))
        return
    }

    println("USAGE: hexa run tool/p9_llama_anchor_h100_orchestrator.hexa [--selftest|--emit|--launch|--kill <pod_id>]")
}

main()
