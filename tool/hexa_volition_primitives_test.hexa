// tool/hexa_volition_primitives_test.hexa — selftest for the 5 primitives.
// @allow-bare-exec-file
// @allow-silent-exit-file
// @allow-relop-banned-file
// @allow-silent-catch-file
// @allow-no-header-box
//
// Run:
//   hexa run tool/hexa_volition_primitives_test.hexa --selftest
//
// Strategy:
//   M1 volition()    -> model_path="__mock__"   -> helper returns 0.8
//   M2 should_speak  -> (0.8, 0.7)=true, (0.2, 0.7)=false
//   M3 speak()       -> writes to a scratch log, grep verifies content
//   M4 desire push/pop -> push 2, pop 2, pop 3rd time -> ""
//   M5 inhibit()     -> writes "INHIBIT | <reason>" line; grep verifies
//
// Output:
//   "5/5 PASS" or "X/5 FAIL notes=..."

import "hexa_volition_primitives.hexa"

fn _t_shell(cmd) {
    return exec(cmd).trim()
}

fn _t_quote(s) {
    let esc = s.replace("'", "'\\''")
    return "'" + esc + "'"
}

fn _t_scratch_dir() {
    let d = _t_shell("mktemp -d -t hexa_volition_test.XXXXXX")
    return d
}

fn _t_file_contains(path, needle) -> bool {
    let q_path = _t_quote(path)
    let q_needle = _t_quote(needle)
    let rc = _t_shell("grep -F " + q_needle + " " + q_path + " > /dev/null 2>&1 && echo y || echo n")
    if rc == "y" { return true }
    return false
}

fn main() {
    let argv = real_args()
    let mut want_selftest = false
    let mut i = 0
    while i < len(argv) {
        if argv[i] == "--selftest" { want_selftest = true }
        i = i + 1
    }
    if !want_selftest {
        println("usage: hexa run tool/hexa_volition_primitives_test.hexa --selftest")
        return 0
    }

    println("=== hexa_volition_primitives selftest (5 primitives, mock mode) ===")
    let scratch = _t_scratch_dir()
    println("  scratch: " + scratch)

    let mut pass = 0
    let mut notes = ""

    // --- M1: volition() ---
    let v_mock = volition("__mock__", "도우미: ")
    let m1_ok = (v_mock > 0.7) && (v_mock < 0.9)
    if m1_ok {
        pass = pass + 1
        println("  M1 volition()       OK  v=" + to_string(v_mock))
    } else {
        notes = notes + "M1(v=" + to_string(v_mock) + ");"
        println("  M1 volition()       FAIL v=" + to_string(v_mock))
    }

    // --- M2: should_speak() ---
    let m2a = should_speak(0.8, 0.7)
    let m2b = should_speak(0.2, 0.7)
    let m2_ok = m2a && !m2b
    if m2_ok {
        pass = pass + 1
        println("  M2 should_speak()   OK  (0.8>0.7)=true (0.2>0.7)=false")
    } else {
        notes = notes + "M2(a=" + to_string(m2a) + ",b=" + to_string(m2b) + ");"
        println("  M2 should_speak()   FAIL")
    }

    // --- M3: speak() ---
    let speak_log = scratch + "/speak.log"
    let payload = "hello-volition-test"
    let returned = speak(payload, speak_log)
    let m3_ok = (returned == payload) && _t_file_contains(speak_log, payload)
    if m3_ok {
        pass = pass + 1
        println("  M3 speak()          OK  log line written")
    } else {
        notes = notes + "M3(ret=" + returned + ");"
        println("  M3 speak()          FAIL ret=" + returned)
    }

    // --- M4: desire_push / desire_pop ---
    let queue = scratch + "/desire.jsonl"
    let p1 = desire_push("learn-piano", queue)
    let p2 = desire_push("eat-rice", queue)
    let pop1 = desire_pop(queue)
    let pop2 = desire_pop(queue)
    let pop3 = desire_pop(queue)
    let m4_ok = p1 && p2 && (pop1 == "learn-piano") && (pop2 == "eat-rice") && (pop3 == "")
    if m4_ok {
        pass = pass + 1
        println("  M4 desire_*()       OK  push x2, pop=[learn-piano,eat-rice,EMPTY]")
    } else {
        notes = notes + "M4(p1=" + to_string(p1) + ",p2=" + to_string(p2) + ",pop1=" + pop1 + ",pop2=" + pop2 + ",pop3=" + pop3 + ");"
        println("  M4 desire_*()       FAIL pop1=" + pop1 + " pop2=" + pop2 + " pop3=" + pop3)
    }

    // --- M5: inhibit() ---
    let inh_log = scratch + "/inhibit.log"
    let inh_ok = inhibit("refractory-active", inh_log)
    let m5_ok = inh_ok && _t_file_contains(inh_log, "INHIBIT") && _t_file_contains(inh_log, "refractory-active")
    if m5_ok {
        pass = pass + 1
        println("  M5 inhibit()        OK  inhibition line logged")
    } else {
        notes = notes + "M5;"
        println("  M5 inhibit()        FAIL")
    }

    println("---")
    if pass == 5 {
        println("RESULT: 5/5 PASS")
        // best-effort cleanup
        exec("rm -rf " + _t_quote(scratch))
        return 0
    }
    println("RESULT: " + to_string(pass) + "/5 FAIL  notes=" + notes)
    println("scratch (preserved for debug): " + scratch)
    return 1
}
