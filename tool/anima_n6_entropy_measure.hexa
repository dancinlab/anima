#!hexa strict

// @resolver-bypass(reason="Shannon H_n corpus entropy floor measurement for anima + n6-architecture; raw 91 honest C3 STRICT — measurement only, no algorithm proposal, no AOT rebuild, no source patch")
// @tool(slug="anima-n6-entropy-measure", desc="Compute Shannon H_0/H_3/H_4 byte-level entropy on anima/n6/+4 repos to quantify 80% target architectural reachability. Per-repo + per-class breakdown. raw 9 hexa-only top-level (helper python via raw#37 carve-out for log2 math). No catalog promotion, no commit this turn.")
// @usage(hexa /Users/ghost/core/anima/tool/anima_n6_entropy_measure.hexa)

// PURPOSE
//   80% target FINAL gap = 13.78pp residual after A29 v3 standalone 66.22% MEASURED
//   per-repo: hive 96.04% / airgenome 87.53% / nexus 76.02% / hexa-lang 66.52% /
//             n6-architecture 60.62% / anima 50.83%
//   anima + n6 are dominant blocker. Hypothesis: corpus entropy floor exceeds
//   80% saving compatible Shannon limit (LZ77 + Huffman ≈ near H_3-H_4 ceiling).
//
// METHOD
//   For each repo, walk text-likely files (same ext filter as a32_v2 ledger),
//   accumulate full byte stream, compute:
//     - H_0 = -Σ p(b) log2 p(b)   over byte unigram (256 symbols)
//     - H_3 = order-3 conditional Shannon (PPM-style; ctx = 3 previous bytes)
//     - H_4 = order-4 conditional Shannon (ctx = 4 previous bytes)
//   byte_canonical_floor_pct(H_n) = (1 - H_n/8) × 100
//   classification per file (text-heavy/json-heavy/mixed/small-file) using
//   same heuristic as a29_v3 ledger.
//
// PASS predicates (raw 71 falsifier pre-register — measurement-only, not gates)
//   For "80% reachable on repo X via H_3 within byte-canonical wire":
//     R-H3-80   floor_H3_pct  ≥ 80  → "Shannon-permits-80"
//     R-H4-80   floor_H4_pct  ≥ 80  → "Shannon-permits-80"
//     R-H0-80   floor_H0_pct  ≥ 80  → "byte-coding-permits-80"
//   These bound REACHABILITY, not predict actual algorithm performance.
//
// HONEST C3 (raw 91 STRICT)
//   - byte-level entropy is theoretical lower bound — actual algorithms
//     (LZ77, PPM, range coder) generally do NOT close 100% of H_n gap.
//     Empirical algorithm-vs-Shannon-H_3 ratio on the catalog is ~50-90%.
//   - This tool emits the THEORETICAL bound only. Verdict on reachability
//     is REACHABILITY (not "achievability"); algorithm candidate selection
//     is out-of-scope.
//   - Korean / multibyte UTF-8 chars treated as raw bytes (canonical wire
//     measurement). Binary blobs in corpora may inflate H_0 toward 8.
//   - Helper python uses raw#37 carve-out (auto-generated, not git-tracked).
//     raw 9 hexa-only honoured at top level. No .py file tracked; helper
//     re-emitted on every run.
//
// USAGE
//   /Users/ghost/core/hexa-lang/hexa.real /Users/ghost/core/anima/tool/anima_n6_entropy_measure.hexa --selftest
//   /Users/ghost/core/hexa-lang/hexa.real /Users/ghost/core/anima/tool/anima_n6_entropy_measure.hexa
//   /Users/ghost/core/hexa-lang/hexa.real /Users/ghost/core/anima/tool/anima_n6_entropy_measure.hexa \
//     --repos anima,n6-architecture --output /tmp/entropy_floor.jsonl

const HELPER_PATH = "/tmp/anima_n6_entropy_measure_helper.hexa_tmp"
const LEDGER_PATH = "/Users/ghost/core/anima/state/format_witness/2026-04-28_anima_n6_corpus_entropy_floor.jsonl"
const SCHEMA      = "anima/anima_n6_corpus_entropy_floor/1_shannon_h_n"
const SPEC_DOC    = "docs/anima_n6_corpus_entropy_floor_2026_04_28.md"

const REPO_ROOTS = [
    "anima:/Users/ghost/core/anima",
    "n6-architecture:/Users/ghost/core/n6-architecture",
    "nexus:/Users/ghost/core/nexus",
    "hexa-lang:/Users/ghost/core/hexa-lang",
    "airgenome:/Users/ghost/core/airgenome",
    "hive:/Users/ghost/core/hive"
]

// Text-likely extensions (same as a32_v2 ledger).
const TEXT_EXTS = [
    ".md",".txt",".json",".jsonl",".hexa",".raw",".own",".guide",".ext",
    ".py",".sh",".yaml",".yml",".toml",".cfg",".conf",".log",".tsv",".csv",
    ".bash",".rs",".c",".h"
]

fn _sh_quote(s) { return "'" + s.replace("'","'\\''") + "'" }

fn _str(b) { return to_string(b) }

fn _kv_lookup(body, key) {
    let prefix = key + "="
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if ln.starts_with(prefix) {
            return ln.substring(prefix.len(), ln.len())
        }
        i = i + 1
    }
    return ""
}

fn _write_helper() {
    let src = "#!/usr/bin/env python3\n" +
        "# auto-generated by tool/anima_n6_entropy_measure.hexa (raw#37: not git-tracked)\n" +
        "import json, sys, os, math, fnmatch\n" +
        "from collections import defaultdict\n" +
        "\n" +
        "TEXT_EXTS = (\n" +
        "    '.md', '.txt', '.json', '.jsonl', '.hexa', '.raw', '.own', '.guide',\n" +
        "    '.ext', '.py', '.sh', '.yaml', '.yml', '.toml', '.cfg', '.conf',\n" +
        "    '.log', '.tsv', '.csv', '.bash', '.rs', '.c', '.h'\n" +
        ")\n" +
        "PRUNE_DIRS = {'.git', '.venv', 'build', 'ready', 'target', 'node_modules',\n" +
        "              '__pycache__', '.venv-eeg', '.cargo', '.rustup', 'checkpoints',\n" +
        "              'dist', '.tox', '.pytest_cache', '.mypy_cache', '.ipynb_checkpoints'}\n" +
        "\n" +
        "def classify_file(path, raw_bytes):\n" +
        "    # Same classifier scheme as a29_v3 ledger.\n" +
        "    sz = len(raw_bytes)\n" +
        "    if sz < 512: return 'small-file'\n" +
        "    p_lower = path.lower()\n" +
        "    if p_lower.endswith(('.json', '.jsonl')):\n" +
        "        return 'json-heavy'\n" +
        "    # Heuristic: high non-ascii fraction OR low printable → mixed; else text-heavy.\n" +
        "    sample = raw_bytes[:8192]\n" +
        "    if not sample: return 'mixed'\n" +
        "    non_ascii = sum(1 for b in sample if b > 0x7e or (b < 0x20 and b not in (0x09, 0x0a, 0x0d)))\n" +
        "    frac = non_ascii / max(1, len(sample))\n" +
        "    if frac > 0.05:\n" +
        "        return 'mixed'\n" +
        "    if p_lower.endswith(('.md', '.txt', '.raw', '.own', '.guide', '.ext', '.log')):\n" +
        "        return 'text-heavy'\n" +
        "    return 'mixed'\n" +
        "\n" +
        "def walk_repo(root, max_files=10000):\n" +
        "    out = []\n" +
        "    for cur, dirs, files in os.walk(root):\n" +
        "        # Prune in-place\n" +
        "        dirs[:] = [d for d in dirs if d not in PRUNE_DIRS and not d.startswith('.venv')]\n" +
        "        for fn in files:\n" +
        "            full = os.path.join(cur, fn)\n" +
        "            ext = os.path.splitext(fn)[1].lower()\n" +
        "            if ext not in TEXT_EXTS: continue\n" +
        "            try:\n" +
        "                sz = os.path.getsize(full)\n" +
        "            except OSError:\n" +
        "                continue\n" +
        "            if sz <= 0: continue\n" +
        "            out.append(full)\n" +
        "            if len(out) >= max_files: return out\n" +
        "    return out\n" +
        "\n" +
        "def shannon_h0(byte_buf):\n" +
        "    # 0th-order Shannon entropy in bits/byte.\n" +
        "    if not byte_buf: return 0.0\n" +
        "    counts = [0] * 256\n" +
        "    for b in byte_buf: counts[b] += 1\n" +
        "    n = float(len(byte_buf))\n" +
        "    h = 0.0\n" +
        "    for c in counts:\n" +
        "        if c == 0: continue\n" +
        "        p = c / n\n" +
        "        h -= p * math.log2(p)\n" +
        "    return h\n" +
        "\n" +
        "def shannon_h_order(byte_buf, order, alpha=1.0):\n" +
        "    # Order-N conditional entropy via PPM-style Laplace-smoothed plug-in.\n" +
        "    # Estimator: H_n_hat = -(1/M) Σ log2 P_smooth(b_i | b_{i-n}..b_{i-1})\n" +
        "    # where P_smooth(s|c) = (count(c,s) + α) / (count(c) + α·256).\n" +
        "    # This is the cross-entropy of an order-N PPM model with Laplace prior;\n" +
        "    # it is an UPPER BOUND on true H (since the model is sub-optimal) and\n" +
        "    # avoids the zero-frequency problem of unsmoothed plug-in (which\n" +
        "    # severely underestimates H on sparse contexts).\n" +
        "    n = len(byte_buf)\n" +
        "    if n <= order: return float(shannon_h0(byte_buf))\n" +
        "    # Two-pass: pass 1 build ctx → 256-array counts; pass 2 compute cross-entropy.\n" +
        "    ctx_counts = {}\n" +
        "    ctx_total = {}\n" +
        "    for i in range(order, n):\n" +
        "        ctx = bytes(byte_buf[i - order:i])\n" +
        "        sym = byte_buf[i]\n" +
        "        arr = ctx_counts.get(ctx)\n" +
        "        if arr is None:\n" +
        "            arr = [0] * 256\n" +
        "            ctx_counts[ctx] = arr\n" +
        "            ctx_total[ctx] = 0\n" +
        "        arr[sym] += 1\n" +
        "        ctx_total[ctx] += 1\n" +
        "    a256 = alpha * 256.0\n" +
        "    nll_sum = 0.0\n" +
        "    M = float(n - order)\n" +
        "    for i in range(order, n):\n" +
        "        ctx = bytes(byte_buf[i - order:i])\n" +
        "        sym = byte_buf[i]\n" +
        "        cnt = ctx_counts[ctx][sym]\n" +
        "        tot = ctx_total[ctx]\n" +
        "        p = (cnt + alpha) / (tot + a256)\n" +
        "        nll_sum += -math.log2(p)\n" +
        "    h_main = nll_sum / M\n" +
        "    # Prefix (first `order` bytes) treated under H_0 (no context to condition on).\n" +
        "    h_prefix = shannon_h0(byte_buf[:order]) if order > 0 else 0.0\n" +
        "    w_prefix = order / float(n) if n > 0 else 0.0\n" +
        "    w_main = (n - order) / float(n) if n > 0 else 0.0\n" +
        "    return w_main * h_main + w_prefix * h_prefix\n" +
        "\n" +
        "def floor_pct(h_bits_per_byte):\n" +
        "    # Byte-canonical wire saving floor: 1 − H_n/8 (bits per byte / 8).\n" +
        "    pct = (1.0 - h_bits_per_byte / 8.0) * 100.0\n" +
        "    if pct < 0: pct = 0.0\n" +
        "    return pct\n" +
        "\n" +
        "def measure_repo(repo_label, repo_root, ledger_fp, max_per_class_bytes=None):\n" +
        "    paths = walk_repo(repo_root)\n" +
        "    # Aggregate buffers per-class + repo-wide.\n" +
        "    cls_buf = defaultdict(bytearray)\n" +
        "    repo_buf = bytearray()\n" +
        "    files_per_class = defaultdict(int)\n" +
        "    bytes_per_class = defaultdict(int)\n" +
        "    n_files = 0\n" +
        "    for p in paths:\n" +
        "        try:\n" +
        "            with open(p, 'rb') as f: raw = f.read()\n" +
        "        except (OSError, IOError):\n" +
        "            continue\n" +
        "        if not raw: continue\n" +
        "        cls = classify_file(p, raw)\n" +
        "        cls_buf[cls].extend(raw)\n" +
        "        repo_buf.extend(raw)\n" +
        "        files_per_class[cls] += 1\n" +
        "        bytes_per_class[cls] += len(raw)\n" +
        "        n_files += 1\n" +
        "    repo_total = len(repo_buf)\n" +
        "    # Repo-wide H_n on the whole concatenated corpus.\n" +
        "    h0 = shannon_h0(repo_buf) if repo_total > 0 else 0.0\n" +
        "    h3 = shannon_h_order(repo_buf, 3) if repo_total > 0 else 0.0\n" +
        "    h4 = shannon_h_order(repo_buf, 4) if repo_total > 0 else 0.0\n" +
        "    repo_row = {\n" +
        "        'schema': 'anima_n6_corpus_entropy_floor/1',\n" +
        "        'level': 'repo',\n" +
        "        'repo': repo_label,\n" +
        "        'root': repo_root,\n" +
        "        'n_files': n_files,\n" +
        "        'total_bytes': repo_total,\n" +
        "        'H_0_bits_per_byte': round(h0, 6),\n" +
        "        'H_3_bits_per_byte': round(h3, 6),\n" +
        "        'H_4_bits_per_byte': round(h4, 6),\n" +
        "        'floor_H_0_pct': round(floor_pct(h0), 4),\n" +
        "        'floor_H_3_pct': round(floor_pct(h3), 4),\n" +
        "        'floor_H_4_pct': round(floor_pct(h4), 4),\n" +
        "        'reach_80_via_H0': bool(floor_pct(h0) >= 80.0),\n" +
        "        'reach_80_via_H3': bool(floor_pct(h3) >= 80.0),\n" +
        "        'reach_80_via_H4': bool(floor_pct(h4) >= 80.0),\n" +
        "    }\n" +
        "    ledger_fp.write(json.dumps(repo_row, separators=(',', ':')) + '\\n'); ledger_fp.flush()\n" +
        "    print(f\"REPO {repo_label} files={n_files} bytes={repo_total} H_0={h0:.4f} H_3={h3:.4f} H_4={h4:.4f} \"\n" +
        "          f\"floor_H0={repo_row['floor_H_0_pct']:.2f}%% floor_H3={repo_row['floor_H_3_pct']:.2f}%% floor_H4={repo_row['floor_H_4_pct']:.2f}%%\")\n" +
        "    # Per-class\n" +
        "    class_rows = []\n" +
        "    for cls in ('text-heavy', 'json-heavy', 'mixed', 'small-file'):\n" +
        "        buf = cls_buf.get(cls)\n" +
        "        if not buf:\n" +
        "            row = {\n" +
        "                'schema': 'anima_n6_corpus_entropy_floor/1', 'level': 'repo_class',\n" +
        "                'repo': repo_label, 'class': cls, 'n_files': 0, 'total_bytes': 0,\n" +
        "                'H_0_bits_per_byte': None, 'H_3_bits_per_byte': None, 'H_4_bits_per_byte': None,\n" +
        "            }\n" +
        "            ledger_fp.write(json.dumps(row, separators=(',', ':')) + '\\n'); ledger_fp.flush()\n" +
        "            class_rows.append(row); continue\n" +
        "        c_total = len(buf)\n" +
        "        c_h0 = shannon_h0(buf)\n" +
        "        c_h3 = shannon_h_order(buf, 3)\n" +
        "        c_h4 = shannon_h_order(buf, 4)\n" +
        "        row = {\n" +
        "            'schema': 'anima_n6_corpus_entropy_floor/1', 'level': 'repo_class',\n" +
        "            'repo': repo_label, 'class': cls,\n" +
        "            'n_files': files_per_class[cls], 'total_bytes': c_total,\n" +
        "            'H_0_bits_per_byte': round(c_h0, 6),\n" +
        "            'H_3_bits_per_byte': round(c_h3, 6),\n" +
        "            'H_4_bits_per_byte': round(c_h4, 6),\n" +
        "            'floor_H_0_pct': round(floor_pct(c_h0), 4),\n" +
        "            'floor_H_3_pct': round(floor_pct(c_h3), 4),\n" +
        "            'floor_H_4_pct': round(floor_pct(c_h4), 4),\n" +
        "        }\n" +
        "        ledger_fp.write(json.dumps(row, separators=(',', ':')) + '\\n'); ledger_fp.flush()\n" +
        "        class_rows.append(row)\n" +
        "        print(f\"  CLASS {cls:11s} files={files_per_class[cls]:>5d} bytes={c_total:>9d} \"\n" +
        "              f\"H_0={c_h0:.4f} H_3={c_h3:.4f} H_4={c_h4:.4f} floor_H4={floor_pct(c_h4):.2f}%%\")\n" +
        "    return repo_row, class_rows\n" +
        "\n" +
        "def cmd_run(repo_specs, ledger_path):\n" +
        "    os.makedirs(os.path.dirname(ledger_path), exist_ok=True)\n" +
        "    summary = {\n" +
        "        'schema': 'anima_n6_corpus_entropy_floor_summary/1',\n" +
        "        'level': 'summary',\n" +
        "        'ledger': ledger_path,\n" +
        "        'spec_doc': 'docs/anima_n6_corpus_entropy_floor_2026_04_28.md',\n" +
        "        'repos': [],\n" +
        "    }\n" +
        "    with open(ledger_path, 'w') as fp:\n" +
        "        # Header row\n" +
        "        hdr = {\n" +
        "            'schema': 'anima_n6_corpus_entropy_floor/1',\n" +
        "            'level': 'header',\n" +
        "            'spec_doc': 'docs/anima_n6_corpus_entropy_floor_2026_04_28.md',\n" +
        "            'method': 'Shannon H_0 byte unigram + H_3/H_4 order-N conditional via PPM-style ctx counts',\n" +
        "            'tool': 'tool/anima_n6_entropy_measure.hexa',\n" +
        "            'compliance': 'raw 9 hexa-only top-level + raw#37 helper carve-out + raw 91 honest C3 STRICT (measurement only)',\n" +
        "            'repo_specs': repo_specs,\n" +
        "        }\n" +
        "        fp.write(json.dumps(hdr, separators=(',', ':')) + '\\n')\n" +
        "        for spec in repo_specs:\n" +
        "            label, root = spec.split(':', 1)\n" +
        "            row, class_rows = measure_repo(label, root, fp)\n" +
        "            summary['repos'].append({'repo': label, 'row': row, 'classes': class_rows})\n" +
        "        # Aggregate verdicts\n" +
        "        # 80% reachability table\n" +
        "        reach_table = []\n" +
        "        for entry in summary['repos']:\n" +
        "            r = entry['row']\n" +
        "            reach_table.append({\n" +
        "                'repo': r['repo'], 'total_bytes': r['total_bytes'],\n" +
        "                'floor_H_0_pct': r['floor_H_0_pct'], 'floor_H_3_pct': r['floor_H_3_pct'], 'floor_H_4_pct': r['floor_H_4_pct'],\n" +
        "                'reach_80_via_H0': r['reach_80_via_H0'],\n" +
        "                'reach_80_via_H3': r['reach_80_via_H3'],\n" +
        "                'reach_80_via_H4': r['reach_80_via_H4'],\n" +
        "            })\n" +
        "        # Honest C3 verdict per repo\n" +
        "        verdicts = []\n" +
        "        for e in reach_table:\n" +
        "            if e['reach_80_via_H4']:\n" +
        "                v = 'SHANNON_PERMITS_80_VIA_H4'\n" +
        "            elif e['reach_80_via_H3']:\n" +
        "                v = 'SHANNON_PERMITS_80_VIA_H3_NOT_H4'\n" +
        "            elif e['reach_80_via_H0']:\n" +
        "                v = 'SHANNON_PERMITS_80_VIA_H0_BUT_NOT_HIGHER_ORDER'\n" +
        "            else:\n" +
        "                v = 'SHANNON_FORBIDS_80_AT_ALL_ORDERS'\n" +
        "            verdicts.append({'repo': e['repo'], 'verdict': v, 'floor_H_4_pct': e['floor_H_4_pct']})\n" +
        "        verdict_row = {\n" +
        "            'schema': 'anima_n6_corpus_entropy_floor_verdict/1',\n" +
        "            'level': 'verdict',\n" +
        "            'reach_table': reach_table,\n" +
        "            'verdicts': verdicts,\n" +
        "            'honest_c3': 'Shannon byte-canonical floor is theoretical lower bound on bits/byte. Actual algorithm performance generally close 50-90%% of H_n gap. Reachability ≠ achievability. anima/n6 80%% target architectural blocker quantified.',\n" +
        "        }\n" +
        "        fp.write(json.dumps(verdict_row, separators=(',', ':')) + '\\n')\n" +
        "    print('--- VERDICT TABLE ---')\n" +
        "    for v in verdicts:\n" +
        "        print(f\"  {v['repo']:>17s}  floor_H_4={v['floor_H_4_pct']:>6.2f}%%  {v['verdict']}\")\n" +
        "    print(f'wrote {ledger_path}')\n" +
        "    print('done=ok')\n" +
        "\n" +
        "def cmd_selftest():\n" +
        "    # Edge: empty input\n" +
        "    assert shannon_h0(b'') == 0.0\n" +
        "    # Edge: single byte uniform → H_0 = 0\n" +
        "    assert abs(shannon_h0(b'AAAA') - 0.0) < 1e-9\n" +
        "    # Uniform 256-byte distribution → H_0 = 8\n" +
        "    uniform = bytes(range(256)) * 16\n" +
        "    h0 = shannon_h0(uniform)\n" +
        "    assert abs(h0 - 8.0) < 1e-6, f'expected H_0=8 got {h0}'\n" +
        "    # Order-3 on uniform random bytes — with Laplace α=1 and 8192 samples,\n" +
        "    # most ctx are singletons so smoothed P ≈ 2/(1+256) ≈ 7.0 bits/symbol.\n" +
        "    # We accept any value above 6.5 (well above naive plug-in 0).\n" +
        "    import random\n" +
        "    random.seed(20260428)\n" +
        "    rnd = bytes(random.randint(0, 255) for _ in range(8192))\n" +
        "    h3_rnd = shannon_h_order(rnd, 3)\n" +
        "    assert h3_rnd > 6.5, f'rnd H_3 too low: {h3_rnd}'\n" +
        "    # Order-3 on highly periodic ABCABCABC... → with Laplace α=1, observed\n" +
        "    # 'ABC' ctx → 4095 'A' counts overwhelmingly dominate; H_3 should be very\n" +
        "    # low but NOT exactly 0 (smoothing gives unseen 255 symbols some mass).\n" +
        "    periodic = (b'ABC' * 4096)\n" +
        "    h3_per = shannon_h_order(periodic, 3)\n" +
        "    assert h3_per < 0.5, f'periodic H_3 should be ≪ H_0, got {h3_per}'\n" +
        "    # floor_pct\n" +
        "    assert abs(floor_pct(0.0) - 100.0) < 1e-9\n" +
        "    assert abs(floor_pct(8.0) - 0.0) < 1e-9\n" +
        "    assert abs(floor_pct(4.0) - 50.0) < 1e-9\n" +
        "    # English text repetitive fixture — fully periodic so order-3/4 should\n" +
        "    # converge well below H_0 even with Laplace smoothing.\n" +
        "    eng = b'the quick brown fox jumps over the lazy dog. ' * 64\n" +
        "    h0_e = shannon_h0(eng); h3_e = shannon_h_order(eng, 3); h4_e = shannon_h_order(eng, 4)\n" +
        "    assert h0_e > 3.0 and h0_e < 5.0, f'eng H_0 out of range: {h0_e}'\n" +
        "    # On 2880-byte periodic fixture, order-3 ctx repeat ~64x so smoothing\n" +
        "    # bias is small. H_3 should be much smaller than H_0.\n" +
        "    assert h3_e < h0_e * 0.6, f'H_3 ({h3_e}) should be << H_0 ({h0_e}) on highly periodic fixture'\n" +
        "    print('selftest=ok')\n" +
        "    print(f'uniform_H_0={h0:.6f}')\n" +
        "    print(f'random_H_3={h3_rnd:.6f}')\n" +
        "    print(f'periodic_ABC_H_3={h3_per:.6f}')\n" +
        "    print(f'english_H_0={h0_e:.6f} H_3={h3_e:.6f} H_4={h4_e:.6f}')\n" +
        "    print('done=ok')\n" +
        "\n" +
        "def main():\n" +
        "    if len(sys.argv) < 2:\n" +
        "        print('usage: helper <run|selftest> ...', file=sys.stderr); sys.exit(2)\n" +
        "    op = sys.argv[1]\n" +
        "    if op == 'run':\n" +
        "        # Args: ledger_path repo_spec1 [repo_spec2 ...]\n" +
        "        ledger_path = sys.argv[2]\n" +
        "        repo_specs = sys.argv[3:]\n" +
        "        cmd_run(repo_specs, ledger_path)\n" +
        "    elif op == 'selftest':\n" +
        "        cmd_selftest()\n" +
        "    else:\n" +
        "        print(f'unknown op: {op}', file=sys.stderr); sys.exit(2)\n" +
        "\n" +
        "if __name__ == '__main__': main()\n"
    write_file(HELPER_PATH, src)
}

fn _run_helper(args) {
    let cmd = "python3 " + HELPER_PATH + " " + args
    let r = exec_with_status(cmd)
    return [to_string(r[0]).trim(), to_int(r[1])]
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut output = LEDGER_PATH
    let mut repos_arg = ""
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        if a == "--output" && i + 1 < len(av) { output = av[i+1]; i = i + 2; continue }
        if a == "--repos" && i + 1 < len(av) { repos_arg = av[i+1]; i = i + 2; continue }
        i = i + 1
    }

    _write_helper()

    if selftest {
        println("── anima_n6_entropy_measure selftest ──")
        let r = _run_helper("selftest")
        println(r[0])
        if r[1] != 0 { eprintln("selftest FAILED (exit " + to_string(r[1]) + ")"); exit(1) }
        if _kv_lookup(r[0], "selftest") != "ok" { eprintln("selftest marker missing"); exit(1) }
        if _kv_lookup(r[0], "done") != "ok" { eprintln("done marker missing"); exit(1) }
        println("selftest: OK")
        exit(0)
    }

    // Determine repo specs
    let mut repo_specs = []
    if len(repos_arg) > 0 {
        // User-supplied label list → look up roots.
        let labels = repos_arg.split(",")
        let mut k = 0
        while k < len(labels) {
            let label = labels[k].trim()
            let mut j = 0
            let mut found = ""
            while j < len(REPO_ROOTS) {
                let spec = REPO_ROOTS[j]
                let parts = spec.split(":")
                if len(parts) == 2 && parts[0] == label { found = spec }
                j = j + 1
            }
            if len(found) == 0 { eprintln("ABORT: unknown repo label " + label); exit(2) }
            repo_specs.push(found)
            k = k + 1
        }
    } else {
        let mut k = 0
        while k < len(REPO_ROOTS) { repo_specs.push(REPO_ROOTS[k]); k = k + 1 }
    }

    println("── anima_n6_entropy_measure RUN ──")
    println("ledger: " + output)
    println("repos:  " + to_string(len(repo_specs)))

    // Build helper args: run <ledger> <repo_spec...>
    let mut args = "run " + _sh_quote(output)
    let mut k2 = 0
    while k2 < len(repo_specs) {
        args = args + " " + _sh_quote(repo_specs[k2])
        k2 = k2 + 1
    }
    let r = _run_helper(args)
    let out = r[0]
    let st  = r[1]
    if st != 0 { eprintln("ABORT: helper run exited " + to_string(st)); eprintln(out); exit(2) }
    println(out)
    if _kv_lookup(out, "done") != "ok" { eprintln("ABORT: helper done marker missing"); exit(2) }
    println("")
    println("ledger: " + output)
    exit(0)
}

