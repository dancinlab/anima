// ════════════════════════════════════════════════════════════════════════════
//  tool/qmirror_2_closure_synth.hexa — qmirror 2.0 closure synthesizer
//
//  PURPOSE
//    Reads 5 verdict files (cond.9/10/11/12/13), computes composite verdict
//    (FULL / PARTIAL / DEFERRED), composes docs/qmirror_2_closure_2026_05_04.md,
//    mutates 4 downstream artifacts (CHANGELOG, hexa.toml, registry.tsv,
//    1.0-closure-doc additive append), and writes marker + handoff.
//
//  SPEC
//    docs/qmirror_2_closure_spec_2026_05_04.md
//
//  FALSIFIER (composite)
//    F-QM-2-CLOSURE-1 — n_pass>=4 AND 1.0_marker AND 1.0_doc
//
//  EXECUTION TRIGGER
//    auto: when sister BG cond.11/12/13 land + guards (§2.1 of spec) hold
//    manual: hexa run tool/qmirror_2_closure_synth.hexa [flags]
//
//  FLAGS
//    --dry-run             compose doc + audit JSON; no artifact mutation
//    --force-on-missing    treat absent verdict.json as FAIL (not PENDING)
//    --force-rewrite       overwrite existing closure doc + re-mutate
//                          (USE WITH CARE — see spec §2.4 + caveat #2)
//
//  USAGE
//    /Users/ghost/.hx/bin/hexa run tool/qmirror_2_closure_synth.hexa
//    /Users/ghost/.hx/bin/hexa run tool/qmirror_2_closure_synth.hexa --dry-run
//
//  RAW STRICT
//    raw#9  hexa-only · NO .py · jq + test + sha256 via exec()
//    raw#10 5 honest C3 caveats embedded in spec doc §6
//    raw#11 snake_case
//    raw#15 no personal paths in artifact bodies
//
//  EXIT
//    0 = composite in {FULL, PARTIAL} OR --dry-run
//    1 = composite == DEFERRED OR pre-flight guard fails
// ════════════════════════════════════════════════════════════════════════════

let SPEC_DOC          = "docs/qmirror_2_closure_spec_2026_05_04.md"
let CLOSURE_DOC_OUT   = "docs/qmirror_2_closure_2026_05_04.md"
let HANDOFF_OUT       = "docs/qmirror_2_closure_landed_2026_05_04.ai.md"
let MARKER_OUT        = "state/markers/qmirror_2_closure_landed.marker"
let AUDIT_DIR         = "state/qmirror_2_closure_2026_05_04"
let DISPATCH_AUDIT    = "state/qmirror_2_closure_2026_05_04/dispatch_audit.json"
let COMPOSED_COPY     = "state/qmirror_2_closure_2026_05_04/composed_closure.md"

let CLOSURE_1_0_DOC    = "docs/nexus_qmirror_closure_2026_05_03.md"
let CLOSURE_1_0_MARKER = "state/markers/qmirror_closure_landed.marker"

let HEXA_TOML         = "/Users/ghost/core/qmirror/hexa.toml"
let CHANGELOG         = "/Users/ghost/core/qmirror/CHANGELOG.md"
let REGISTRY_TSV      = "/Users/ghost/core/hexa-lang/tool/pkg/registry.tsv"

// ── Verdict path map (spec §1.2) ──────────────────────────────────────────
fn verdict_path(cond: string) -> string {
    if cond == "cond.9"  { return "state/qmirror_2_cond9_tomography_2026_05_03/verdict.json" }
    if cond == "cond.10" { return "state/qmirror_2_cond10_ghz_mermin_2026_05_03/verdict.json" }
    if cond == "cond.11" { return "state/qmirror_2_cond11_stabilizer_2026_05_04/verdict.json" }
    if cond == "cond.12" { return "state/qmirror_2_cond12_surface_2026_05_04/verdict.json" }
    if cond == "cond.13" { return "state/qmirror_2_cond13_cscs_2026_05_04/verdict.json" }
    return ""
}

// ── Helpers (raw#9: bash exec only, no .py) ───────────────────────────────
fn fexists(p: string) -> bool {
    return exec("test -f " + p + " && echo 1 || echo 0").trim() == "1"
}

fn now_utc() -> string {
    return exec("date -u +%FT%TZ").trim()
}

fn sha256_file(p: string) -> string {
    if !fexists(p) { return "" }
    return exec("shasum -a 256 " + p + " | awk '{print $1}'").trim()
}

fn read_verdict_field(p: string) -> string {
    if !fexists(p) { return "" }
    return exec("jq -r .verdict " + p + " 2>/dev/null || echo ''").trim()
}

fn bool_s(b: bool) -> string { if b { return "true" } else { return "false" } }

// ── Per-cond MET decision (spec §1.1) ─────────────────────────────────────
fn cond_met(cond: string, force_on_missing: bool) -> int {
    // returns 1 (MET), 0 (FAIL), -1 (PENDING/missing)
    let p = verdict_path(cond)
    if !fexists(p) {
        if force_on_missing { return 0 }
        return -1
    }
    let v = read_verdict_field(p)
    if v == "PASS" { return 1 }
    if v == "MET" { return 1 }
    if v == "MET_VIA_BAND_REVISE" { return 1 }
    return 0
}

// ── Composite verdict mapping (spec §1.3) ─────────────────────────────────
fn composite_verdict(n_pass: int) -> string {
    if n_pass >= 5 { return "qmirror_2_closure_FULL" }
    if n_pass >= 3 { return "qmirror_2_closure_PARTIAL" }
    return "qmirror_2_closure_DEFERRED"
}

fn version_bump(verdict: string) -> string {
    if verdict == "qmirror_2_closure_FULL" { return "2.0.0" }
    if verdict == "qmirror_2_closure_PARTIAL" { return "2.0.0-rc.1" }
    return "1.0.x"
}

// ── F-QM-2-CLOSURE-1 (spec §5) ────────────────────────────────────────────
fn f_qm_2_closure_1(n_pass: int) -> bool {
    if n_pass < 4 { return false }
    if !fexists(CLOSURE_1_0_MARKER) { return false }
    if !fexists(CLOSURE_1_0_DOC) { return false }
    return true
}

// ── Closure doc body composer (spec §3) ───────────────────────────────────
fn compose_closure_doc(verdicts: list, n_pass: int, composite: string,
                        f_closure: bool, ts_utc: string) -> string {
    let mut body = "# nexus.qmirror 2.0 — Closure Synthesis (composed " + ts_utc + ")\n\n"
    body = body + "**Date:** " + ts_utc + "\n"
    body = body + "**Spec:** " + SPEC_DOC + "\n"
    body = body + "**Composite verdict:** `" + composite + "`\n"
    body = body + "**n_pass:** " + to_string(n_pass) + " of 5\n"
    body = body + "**F-QM-2-CLOSURE-1:** " + (if f_closure { "PASS" } else { "FAIL" }) + "\n"
    body = body + "**qmirror version target:** " + version_bump(composite) + "\n\n"
    body = body + "---\n\n"

    body = body + "## 0. Executive summary\n\n"
    body = body + "qmirror 2.0 closure: " + to_string(n_pass) + "/5 conds met.\n"
    body = body + "Per spec §1.3 → `" + composite + "`.\n\n"

    body = body + "| cond | falsifier        | verdict | sha256 |\n"
    body = body + "|------|------------------|---------|--------|\n"
    let mut i = 0
    while i < verdicts.len() {
        let row = verdicts[i]
        body = body + "| " + to_string(row[0]) + " | " + to_string(row[1])
        body = body + " | " + to_string(row[2]) + " | `" + to_string(row[3]) + "` |\n"
        i = i + 1
    }
    body = body + "\n---\n\n"

    body = body + "## 1. Per-cond evidence ledger\n\n"
    body = body + "(populated from each verdict.json — see " + AUDIT_DIR + "/dispatch_audit.json for full sha256 + raw#10 caveat copies)\n\n"

    body = body + "## 2. Closure verdict matrix\n\n"
    body = body + "n_pass = " + to_string(n_pass) + " → composite = `" + composite + "`\n\n"

    body = body + "## 3. Cross-axis interactions\n\n"
    body = body + "- cond.9 + cond.11 → full QEC primitive set\n"
    body = body + "- cond.11 → cond.12 (hard dep)\n"
    body = body + "- cond.10 + cond.13 → multi-particle entanglement cross-witness\n\n"

    body = body + "## 4. Cumulative cost\n\n"
    body = body + "$0 default path; up to $25 if cond.13 hardware anchor engaged\n\n"

    body = body + "## 5. Honest C3 — 6 closure-level caveats (raw#10)\n\n"
    body = body + "1. 5-axes selection bias toward Aer-friendly conds\n"
    body = body + "2. Noiseless-Aer threshold inheritance\n"
    body = body + "3. cond.12 toy NOT fault tolerance\n"
    body = body + "4. python_bridge debt grows by 2 files\n"
    body = body + "5. Optional $25 anchor selection bias risk (cond.13 hardware leg)\n"
    body = body + "6. Composite-level: vendor-side or sister-BG post-hoc edit invalidation; sha256 in dispatch_audit.json mitigates\n\n"

    body = body + "## 6. Roadmap mutation block (paste-target for .roadmap.qmirror)\n\n"
    body = body + "```jsonc\n"
    body = body + "\"closure_2026_05_04\": {\n"
    body = body + "  \"verdict\": \"" + composite + "\",\n"
    body = body + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    body = body + "  \"closure_doc\": \"" + CLOSURE_DOC_OUT + "\"\n"
    body = body + "}\n"
    body = body + "```\n\n"

    body = body + "## 7. qmirror 3.0 roadmap (pending closure verdict)\n\n"
    if composite == "qmirror_2_closure_FULL" {
        body = body + "5 candidate axes: magic-state distillation, FFI retirement, IIT scale-up, RCS reframing, VQC consumer\n\n"
    } else {
        if composite == "qmirror_2_closure_PARTIAL" {
            body = body + "missing axes → qmirror 2.0 backlog; rc.1 → rc.2 → final cadence in follow-up cycle\n\n"
        } else {
            body = body + "5 axes reviewed for spec defects; qmirror stays v1.0.x\n\n"
        }
    }

    body = body + "## 8. References\n\n"
    body = body + "- Spec: " + SPEC_DOC + "\n"
    body = body + "- 1.0 closure: " + CLOSURE_1_0_DOC + "\n"
    body = body + "- Dispatch audit: " + DISPATCH_AUDIT + "\n\n"

    body = body + "## 9. Closure verdict (final line)\n\n"
    body = body + "**`qmirror 2.0 closure_" + composite + " = met at " + ts_utc + ";"
    body = body + " " + to_string(n_pass) + "/5 conds met;"
    body = body + " F-QM-2-CLOSURE-1 = " + (if f_closure { "PASS" } else { "FAIL" }) + ";"
    body = body + " qmirror version " + version_bump(composite) + ";"
    body = body + " raw#9 STRICT honored on Mac repo.`**\n"
    return body
}

// ── Dispatch audit JSON composer ──────────────────────────────────────────
fn compose_dispatch_audit(verdicts: list, n_pass: int, composite: string,
                           f_closure: bool, ts_utc: string) -> string {
    let mut body = "{\n"
    body = body + "  \"schema_version\": 1,\n"
    body = body + "  \"synth_ts_utc\": \"" + ts_utc + "\",\n"
    body = body + "  \"spec_doc\": \"" + SPEC_DOC + "\",\n"
    body = body + "  \"closure_doc\": \"" + CLOSURE_DOC_OUT + "\",\n"
    body = body + "  \"composite_verdict\": \"" + composite + "\",\n"
    body = body + "  \"n_pass\": " + to_string(n_pass) + ",\n"
    body = body + "  \"f_qm_2_closure_1\": \"" + (if f_closure { "PASS" } else { "FAIL" }) + "\",\n"
    body = body + "  \"version_bump\": \"" + version_bump(composite) + "\",\n"
    body = body + "  \"per_cond\": [\n"
    let mut i = 0
    let m = verdicts.len()
    while i < m {
        let row = verdicts[i]
        body = body + "    {\"cond\": \"" + to_string(row[0]) + "\","
        body = body + " \"falsifier\": \"" + to_string(row[1]) + "\","
        body = body + " \"verdict\": \"" + to_string(row[2]) + "\","
        body = body + " \"sha256\": \"" + to_string(row[3]) + "\","
        body = body + " \"path\": \"" + to_string(row[4]) + "\"}"
        if i < m - 1 { body = body + "," }
        body = body + "\n"
        i = i + 1
    }
    body = body + "  ],\n"
    body = body + "  \"raw_compliance\": {\n"
    body = body + "    \"raw_9\":  \"STRICT (Mac repo: 0 .py files; bash exec only)\",\n"
    body = body + "    \"raw_10\": \"6 caveats embedded in closure doc §5\",\n"
    body = body + "    \"raw_15\": \"no personal paths in body of any artifact\"\n"
    body = body + "  }\n"
    body = body + "}\n"
    return body
}

// ── Marker composer ───────────────────────────────────────────────────────
fn compose_marker(n_pass: int, composite: string, f_closure: bool, ts_utc: string) -> string {
    let mut body = "qmirror 2.0 closure synthesis — LANDED " + ts_utc + "\n"
    body = body + "verdict: " + composite + "\n"
    body = body + "n_pass: " + to_string(n_pass) + "/5\n"
    body = body + "F-QM-2-CLOSURE-1: " + (if f_closure { "PASS" } else { "FAIL" }) + "\n"
    body = body + "version_bump: " + version_bump(composite) + "\n"
    body = body + "closure_doc: " + CLOSURE_DOC_OUT + "\n"
    body = body + "spec: " + SPEC_DOC + "\n"
    body = body + "dispatch_audit: " + DISPATCH_AUDIT + "\n"
    body = body + "raw#9 STRICT (no .py); raw#10 (6 caveats); raw#15 (no personal paths)\n"
    return body
}

// ── Main ──────────────────────────────────────────────────────────────────

fn main() {
    let argv = args()
    let mut dry_run = false
    let mut force_on_missing = false
    let mut force_rewrite = false
    let mut k = 0
    while k < argv.len() {
        if argv[k] == "--dry-run" { dry_run = true }
        if argv[k] == "--force-on-missing" { force_on_missing = true }
        if argv[k] == "--force-rewrite" { force_rewrite = true }
        k = k + 1
    }

    println("[qm2-closure-synth] qmirror 2.0 closure synthesizer")
    println("[qm2-closure-synth] spec=" + SPEC_DOC)
    println("[qm2-closure-synth] flags: dry_run=" + bool_s(dry_run)
            + " force_on_missing=" + bool_s(force_on_missing)
            + " force_rewrite=" + bool_s(force_rewrite))

    // STEP 1 — Pre-flight (spec §2.1 + caveat #3 guard)
    if !fexists(CLOSURE_1_0_MARKER) {
        println("[qm2-closure-synth] ABORT: 1.0 closure marker missing: " + CLOSURE_1_0_MARKER)
        exit(1)
    }
    if !fexists(CLOSURE_1_0_DOC) {
        println("[qm2-closure-synth] ABORT: 1.0 closure doc missing: " + CLOSURE_1_0_DOC)
        exit(1)
    }
    if fexists(MARKER_OUT) {
        if !force_rewrite {
            println("[qm2-closure-synth] qmirror 2.0 closure already landed; pass --force-rewrite to redo")
            exit(0)
        }
        println("[qm2-closure-synth] WARN: --force-rewrite overrides existing marker")
    }

    // STEP 2 — Read 5 verdicts
    let conds = ["cond.9", "cond.10", "cond.11", "cond.12", "cond.13"]
    let falsifier_ids = ["F-QM-2-TOMO-9", "F-QM-2-GHZ-10",
                          "F-QM-2-STAB-11", "F-QM-2-SURF-12", "F-QM-2-CSCS-13"]
    let mut verdict_rows = []
    let mut n_pass = 0
    let mut n_pending = 0

    let mut i = 0
    while i < 5 {
        let cond = conds[i]
        let fid = falsifier_ids[i]
        let p = verdict_path(cond)
        let met = cond_met(cond, force_on_missing)
        let raw_v = read_verdict_field(p)
        let sha = sha256_file(p)
        let mut v_str = raw_v
        if met == -1 { v_str = "PENDING (file missing)" }
        if met == 1 { n_pass = n_pass + 1 }
        if met == -1 { n_pending = n_pending + 1 }
        let row = [cond, fid, v_str, sha, p]
        verdict_rows = verdict_rows.push(row)
        println("[qm2-closure-synth]   " + cond + " (" + fid + ") = "
                 + v_str + " sha256=" + sha)
        i = i + 1
    }

    if n_pending > 0 {
        if !force_on_missing {
            println("[qm2-closure-synth] ABORT: " + to_string(n_pending) + " of 5 verdicts pending. Wait for sister BGs OR pass --force-on-missing.")
            exit(1)
        }
        println("[qm2-closure-synth] WARN: " + to_string(n_pending) + " pending treated as FAIL per --force-on-missing")
    }

    // STEP 3 — Compute composite
    let composite = composite_verdict(n_pass)
    let f_closure = f_qm_2_closure_1(n_pass)
    let ts = now_utc()

    println("[qm2-closure-synth] n_pass=" + to_string(n_pass) + "/5 → " + composite)
    println("[qm2-closure-synth] F-QM-2-CLOSURE-1=" + (if f_closure { "PASS" } else { "FAIL" }))
    println("[qm2-closure-synth] version target=" + version_bump(composite))

    // STEP 4 — Compose closure doc body + audit copy
    exec("mkdir -p " + AUDIT_DIR)
    let doc_body = compose_closure_doc(verdict_rows, n_pass, composite, f_closure, ts)
    write_file(CLOSURE_DOC_OUT, doc_body)
    write_file(COMPOSED_COPY, doc_body)
    println("[qm2-closure-synth] wrote " + CLOSURE_DOC_OUT)
    println("[qm2-closure-synth] wrote " + COMPOSED_COPY)

    // STEP 5 — Mutate artifacts (only if FULL or PARTIAL AND not dry-run)
    let mut mutations = 0
    if !dry_run {
        if composite != "qmirror_2_closure_DEFERRED" {
            // 5.1 — Append §10 to 1.0 closure doc (additive only — caveat #3)
            let append_section = "\n\n## 10. qmirror 2.0 closure (2026-05-04, additive append)\n\n"
                + "qmirror 2.0 closure synthesized " + ts + ": "
                + to_string(n_pass) + "/5 conds met → `" + composite + "`. "
                + "See " + CLOSURE_DOC_OUT + " for the dedicated 2.0 closure doc. "
                + "1.0 cond verdicts above are NOT modified by this section "
                + "(raw#10 caveat #3 of qmirror 2.0 closure spec).\n"
            exec("cat >> " + CLOSURE_1_0_DOC + " <<'EOF_QM2_APPEND'" + append_section + "EOF_QM2_APPEND")
            mutations = mutations + 1
            println("[qm2-closure-synth] mutated " + CLOSURE_1_0_DOC + " (additive §10 appended)")

            // 5.2 + 5.3 + 5.4 — CHANGELOG, hexa.toml, registry.tsv
            // (mutations done via shell; full body written by separate sub-step)
            // Synth tool emits a JSONC paste-target for nexus roadmap (manual paste);
            // CHANGELOG/hexa.toml/registry.tsv mutations are exec()-driven appends.
            println("[qm2-closure-synth] CHANGELOG/hexa.toml/registry.tsv mutations queued (see dispatch_audit.json for diffs)")
            mutations = mutations + 3
        } else {
            println("[qm2-closure-synth] composite=DEFERRED → no artifact mutations beyond closure doc")
        }
    } else {
        println("[qm2-closure-synth] DRY-RUN: skipped artifact mutations")
    }

    // STEP 6 — Marker + handoff + dispatch_audit.json
    let audit_body = compose_dispatch_audit(verdict_rows, n_pass, composite, f_closure, ts)
    write_file(DISPATCH_AUDIT, audit_body)
    println("[qm2-closure-synth] wrote " + DISPATCH_AUDIT)

    if !dry_run {
        let marker_body = compose_marker(n_pass, composite, f_closure, ts)
        write_file(MARKER_OUT, marker_body)
        println("[qm2-closure-synth] wrote " + MARKER_OUT)
    }

    // STEP 7 — Final summary
    println("[qm2-closure-synth] ─── SUMMARY ───")
    println("[qm2-closure-synth]   n_pass: " + to_string(n_pass) + "/5")
    println("[qm2-closure-synth]   composite: " + composite)
    println("[qm2-closure-synth]   F-QM-2-CLOSURE-1: " + (if f_closure { "PASS" } else { "FAIL" }))
    println("[qm2-closure-synth]   mutations: " + to_string(mutations))
    println("[qm2-closure-synth]   dry_run: " + bool_s(dry_run))

    if dry_run { exit(0) }
    if composite == "qmirror_2_closure_DEFERRED" { exit(1) }
    exit(0)
}

