#!hexa strict
// @tool slug=roadmap_op
// @sentinel raw9 raw10 raw11 raw15 ai-native
// @usage hexa tool/roadmap_op.hexa <subcmd> [args...]
// @resolver-bypass safe
//
// tool/roadmap_op.hexa — anima .roadmap.<domain> mk2 CLI dispatcher
//
// PURPOSE
//   11 subcommand dispatcher for .roadmap.<domain> JSONL files (mk2 format).
//   Replaces narrative .roadmap (mk1, frozen) with structured per-domain JSONL.
//
// SUBCOMMANDS
//   add        <domain> --title "..." [--status wip] [--track t] [--substrates a,b]
//   update     <id> [--status landed] [--completion-ts <iso>] [--add-evidence p]
//   remove     <id> [--reason "..."]
//   list       [--domain d] [--status s] [--track t]
//   show       <id>
//   link       <from-id> <to-id> --kind depends-on|feeds-main|supersedes
//   domains    (list 6 domains)
//   verify     (schema + cross-link validate, calls roadmap_lint.hexa)
//   render     --format md|text|json [--domain d] [--track t]
//   selftest   (S1..S11, one per subcmd)
//   track-new  <track-name> --substrates a,b,c (creates meta entry + sub-skeleton)
//
// CONFIG
//   repo root: auto-detected via tool/_roadmap_repo_resolver.hexa (pwd heuristic
//              looks for .raw or .raw-ref ancestor); --repo override; defaults
//              to /Users/<user>/core/anima for backward compat.
//   data dir:  <repo>/.roadmap.<domain>
//   domains:   discovered dynamically (.roadmap.<stem> file glob); fallback
//              hardcoded list ["clm","eeg","akida","qrng","sim","meta"].
//
// CROSS-REPO (raw 270/271 ai-native; Option D Hybrid; 2026-05-02)
//   --repo <name|path>  : target repo for ops (e.g. --repo nexus or --repo /Users/<user>/core/nexus)
//   --all-repos         : list/render iterate over all mk2_roadmap=true repos in
//                         /Users/<user>/core/hive/config/cross_repo_registry.json
//   show <id>           : when entry has provider_dependency in header, prints
//                         resolved provider absolute path alongside (1-level only)
//
// LOCK PROTOCOL
//   id allocation uses lock file <repo>/.roadmap.<domain>.lock (mkdir-style)
//
// RAW
//   raw#9  hexa-only        raw#10 honest C3 (caveats inline)
//   raw#11 snake_case        raw#15 SSOT atomic write tmp+mv
//   raw270/271 ai-native readme + core+module mandate (this tool single-file = exempt)
//   raw272 lint extension   raw273 sentinel attrs

let REPO_ROOT_DEFAULT = "/Users/<user>/core/anima"
let DOMAINS_FALLBACK  = ["clm", "eeg", "akida", "qrng", "sim", "meta"]
let SCHEMA_VERSION    = "anima/roadmap/mk2/entry/1"
let RESOLVER_PATH     = "/Users/<user>/core/anima/tool/_roadmap_repo_resolver.hexa"

// Mutable session state (set in main dispatcher before subcmd dispatch).
let mut REPO_ROOT     = REPO_ROOT_DEFAULT
let mut DOMAINS       = DOMAINS_FALLBACK

// ─── helpers ─────────────────────────────────────────────────

fn _sh_quote(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

// ─── cross-repo resolution helpers (Option D Hybrid) ─────────

fn _resolver_query(subcmd: string, arg: string) -> string {
    // Invoke _roadmap_repo_resolver.hexa as subprocess (avoids hexa `use` complications).
    // Returns trimmed stdout. Empty string = miss.
    let cmd = "hexa_real " + _sh_quote(RESOLVER_PATH) + " " + subcmd
    let full = if len(arg) > 0 { cmd + " " + _sh_quote(arg) + " 2>/dev/null" } else { cmd + " 2>/dev/null" }
    return to_string(exec(full)).trim()
}

fn _resolver_query2(subcmd: string, flag: string, val: string) -> string {
    let cmd = "hexa_real " + _sh_quote(RESOLVER_PATH) + " " + subcmd + " " + flag + " " + _sh_quote(val) + " 2>/dev/null"
    return to_string(exec(cmd)).trim()
}

// Resolve "anima"/"nexus"/.../absolute path → absolute repo path.
fn _resolve_repo_arg(spec: string) -> string {
    if len(spec) == 0 { return "" }
    if spec.substring(0, 1) == "/" { return spec }
    let raw = _resolver_query("resolve-dep", spec + ":")
    // Strip trailing slash if "<repo>/" pattern.
    if len(raw) > 1 && raw.substring(len(raw) - 1, len(raw)) == "/" {
        return raw.substring(0, len(raw) - 1)
    }
    return raw
}

// Auto-detect repo root from pwd (heuristic: nearest ancestor with .raw or .raw-ref).
fn _autodetect_repo_root() -> string {
    let r = _resolver_query("resolve-root", "")
    if len(r) > 0 { return r }
    return REPO_ROOT_DEFAULT
}

// Discover .roadmap.<stem> domains under repo. Empty array → caller falls back.
fn _discover_domains(repo: string) -> array {
    let raw = _resolver_query2("list-domains", "--repo", repo)
    // raw is JSON array like ["clm","eeg",...]; parse naively
    let mut out = []
    if len(raw) < 3 { return out }
    if raw.substring(0, 1) != "[" { return out }
    let inner = raw.substring(1, len(raw) - 1)
    if len(inner) == 0 { return out }
    let parts = inner.split(",")
    let mut i = 0
    while i < len(parts) {
        let s = parts[i].trim()
        if len(s) >= 2 && s.substring(0, 1) == "\"" {
            let stripped = s.substring(1, len(s) - 1)
            if len(stripped) > 0 { out = out.push(stripped) }
        }
        i = i + 1
    }
    return out
}

// All mk2_roadmap=true repo paths from registry. Empty → fallback to single REPO_ROOT.
fn _all_mk2_repos() -> array {
    let raw = _resolver_query("list-mk2", "")
    let mut out = []
    if len(raw) < 3 { return out }
    if raw.substring(0, 1) != "[" { return out }
    let inner = raw.substring(1, len(raw) - 1)
    if len(inner) == 0 { return out }
    let parts = inner.split(",")
    let mut i = 0
    while i < len(parts) {
        let s = parts[i].trim()
        if len(s) >= 2 && s.substring(0, 1) == "\"" {
            let stripped = s.substring(1, len(s) - 1)
            if len(stripped) > 0 { out = out.push(stripped) }
        }
        i = i + 1
    }
    return out
}

fn _now_iso() -> string {
    return to_string(exec("date -u +%Y-%m-%dT%H:%M:%SZ")).trim()
}

fn _path_for_domain(domain: string) -> string {
    return REPO_ROOT + "/.roadmap." + domain
}

fn _file_exists(p: string) -> bool {
    return to_string(exec("test -f " + _sh_quote(p) + " && echo 1 || echo 0")).trim() == "1"
}

fn _read_file(p: string) -> string {
    if !_file_exists(p) { return "" }
    return to_string(exec("cat " + _sh_quote(p)))
}

fn _atomic_write(p: string, content: string) -> bool {
    let tmp = p + ".tmp." + to_string(exec("date +%s%N")).trim()
    let cmd = "cat > " + _sh_quote(tmp) + " <<'__HEXA_EOF__'\n" + content + "\n__HEXA_EOF__"
    let _ = exec(cmd)
    let mv = "mv " + _sh_quote(tmp) + " " + _sh_quote(p)
    let _ = exec(mv)
    return _file_exists(p)
}

fn _split_lines(s: string) -> array {
    return s.split("\n")
}

fn _is_comment_or_blank(line: string) -> bool {
    let t = line.trim()
    if len(t) == 0 { return true }
    if t.substring(0, 1) == "#" { return true }
    return false
}

// Naive JSON id field extraction: looks for "id":"<value>"
fn _extract_id(line: string) -> string {
    let key = "\"id\":\""
    let i = line.index_of(key)
    if i < 0 { return "" }
    let start = i + len(key)
    let rest = line.substring(start, len(line))
    let end = rest.index_of("\"")
    if end < 0 { return "" }
    return rest.substring(0, end)
}

// Extract a string field's value: "field":"value"
fn _extract_str_field(line: string, field: string) -> string {
    let key = "\"" + field + "\":\""
    let i = line.index_of(key)
    if i < 0 { return "" }
    let start = i + len(key)
    let rest = line.substring(start, len(line))
    let end = rest.index_of("\"")
    if end < 0 { return "" }
    return rest.substring(0, end)
}

// Get max id number in domain file (e.g. for nsubstrate, returns max nsubstrate.NNN seen)
fn _max_id_num(domain: string, prefix: string) -> int {
    let p = _path_for_domain(domain)
    let content = _read_file(p)
    let lines = _split_lines(content)
    let mut max_n = 0
    let mut i = 0
    let key = "\"id\":\"" + prefix + "."
    while i < len(lines) {
        let line = lines[i]
        if !_is_comment_or_blank(line) {
            let pos = line.index_of(key)
            if pos >= 0 {
                let start = pos + len(key)
                let rest = line.substring(start, len(line))
                let end = rest.index_of("\"")
                if end > 0 {
                    let num_str = rest.substring(0, end)
                    let n = to_int(num_str)
                    if n > max_n { max_n = n }
                }
            }
        }
        i = i + 1
    }
    return max_n
}

fn _zero_pad3(n: int) -> string {
    if n < 10 { return "00" + to_string(n) }
    if n < 100 { return "0" + to_string(n) }
    return to_string(n)
}

fn _domain_valid(d: string) -> bool {
    let mut i = 0
    while i < len(DOMAINS) {
        if DOMAINS[i] == d { return true }
        i = i + 1
    }
    return false
}

// Lock acquisition via mkdir (atomic)
fn _lock_acquire(domain: string) -> bool {
    let lockd = REPO_ROOT + "/.roadmap." + domain + ".lock"
    let mut tries = 0
    while tries < 50 {
        let rc = to_string(exec("mkdir " + _sh_quote(lockd) + " 2>/dev/null && echo 1 || echo 0")).trim()
        if rc == "1" { return true }
        let _ = exec("sleep 0.1")
        tries = tries + 1
    }
    return false
}

fn _lock_release(domain: string) -> bool {
    let lockd = REPO_ROOT + "/.roadmap." + domain + ".lock"
    let _ = exec("rmdir " + _sh_quote(lockd) + " 2>/dev/null")
    return true
}

// ─── arg parsing ─────────────────────────────────────────────

fn _arg_value(args: array, flag: string) -> string {
    let mut i = 0
    while i < len(args) {
        if args[i] == flag {
            if i + 1 < len(args) { return args[i + 1] }
        }
        i = i + 1
    }
    return ""
}

fn _arg_present(args: array, flag: string) -> bool {
    let mut i = 0
    while i < len(args) {
        if args[i] == flag { return true }
        i = i + 1
    }
    return false
}

// ─── subcmd: domains ────────────────────────────────────────

fn cmd_domains() -> int {
    let mut out = "{\"domains\":["
    let mut i = 0
    while i < len(DOMAINS) {
        if i > 0 { out = out + "," }
        out = out + "\"" + DOMAINS[i] + "\""
        i = i + 1
    }
    out = out + "],\"count\":" + to_string(len(DOMAINS)) + ",\"repo\":\"" + REPO_ROOT + "\",\"schema\":\"" + SCHEMA_VERSION + "\"}"
    println(out)
    return 0
}

// ─── subcmd: list ───────────────────────────────────────────

fn cmd_list(args: array) -> int {
    let dom_filter = _arg_value(args, "--domain")
    let st_filter = _arg_value(args, "--status")
    let tr_filter = _arg_value(args, "--track")
    let mut entries = []
    let mut d = 0
    while d < len(DOMAINS) {
        let domain = DOMAINS[d]
        if len(dom_filter) == 0 || dom_filter == domain {
            let p = _path_for_domain(domain)
            let content = _read_file(p)
            let lines = _split_lines(content)
            let mut i = 0
            while i < len(lines) {
                let line = lines[i]
                if !_is_comment_or_blank(line) {
                    let id = _extract_id(line)
                    let st = _extract_str_field(line, "status")
                    let tr = _extract_str_field(line, "track")
                    let title = _extract_str_field(line, "title")
                    let mut keep = true
                    if len(st_filter) > 0 && st != st_filter { keep = false }
                    if len(tr_filter) > 0 && tr != tr_filter { keep = false }
                    if keep && len(id) > 0 {
                        entries = entries.push("{\"id\":\"" + id + "\",\"domain\":\"" + domain + "\",\"status\":\"" + st + "\",\"track\":\"" + tr + "\",\"title\":\"" + title + "\"}")
                    }
                }
                i = i + 1
            }
        }
        d = d + 1
    }
    let mut out = "{\"count\":" + to_string(len(entries)) + ",\"entries\":["
    let mut k = 0
    while k < len(entries) {
        if k > 0 { out = out + "," }
        out = out + entries[k]
        k = k + 1
    }
    out = out + "]}"
    println(out)
    return 0
}

// ─── subcmd: show ───────────────────────────────────────────

fn cmd_show(args: array) -> int {
    if len(args) < 1 { println("{\"error\":\"missing id\"}"); return 1 }
    let target = args[0]
    let mut d = 0
    while d < len(DOMAINS) {
        let p = _path_for_domain(DOMAINS[d])
        let content = _read_file(p)
        let lines = _split_lines(content)
        let mut i = 0
        while i < len(lines) {
            let line = lines[i]
            if !_is_comment_or_blank(line) {
                let id = _extract_id(line)
                if id == target {
                    println(line)
                    return 0
                }
            }
            i = i + 1
        }
        d = d + 1
    }
    println("{\"error\":\"id not found\",\"id\":\"" + target + "\"}")
    return 1
}

// ─── subcmd: add ────────────────────────────────────────────

fn cmd_add(args: array) -> int {
    if len(args) < 1 { println("{\"error\":\"missing domain\"}"); return 1 }
    let domain = args[0]
    if !_domain_valid(domain) { println("{\"error\":\"invalid domain\",\"domain\":\"" + domain + "\"}"); return 1 }
    let title = _arg_value(args, "--title")
    if len(title) == 0 { println("{\"error\":\"missing --title\"}"); return 1 }
    let status = if len(_arg_value(args, "--status")) > 0 { _arg_value(args, "--status") } else { "proposed" }
    let track = _arg_value(args, "--track")
    let substrates_csv = _arg_value(args, "--substrates")
    let why = _arg_value(args, "--why")

    if !_lock_acquire(domain) { println("{\"error\":\"lock timeout\",\"domain\":\"" + domain + "\"}"); return 1 }
    let max_n = _max_id_num(domain, domain)
    let new_id = domain + "." + _zero_pad3(max_n + 1)
    // build substrates JSON array
    let mut sub_json = "[]"
    if len(substrates_csv) > 0 {
        let parts = substrates_csv.split(",")
        let mut sj = "["
        let mut k = 0
        while k < len(parts) {
            if k > 0 { sj = sj + "," }
            sj = sj + "\"" + parts[k].trim() + "\""
            k = k + 1
        }
        sj = sj + "]"
        sub_json = sj
    }
    let entry = "{\"id\":\"" + new_id + "\",\"mk\":2,\"domain\":\"" + domain + "\",\"status\":\"" + status + "\",\"title\":\"" + title + "\",\"substrates\":" + sub_json + ",\"track\":\"" + track + "\",\"since\":\"" + _now_iso().substring(0, 10) + "\",\"why\":\"" + why + "\",\"depends_on\":[],\"feeds_main\":false,\"evidence\":[],\"refs\":[],\"raw_ref\":\"\",\"cost\":\"\",\"effect\":\"\"}"
    let p = _path_for_domain(domain)
    let prev = _read_file(p)
    let new_content = prev + entry + "\n"
    let _ = _atomic_write(p, new_content)
    let _ = _lock_release(domain)
    println("{\"ok\":true,\"id\":\"" + new_id + "\",\"domain\":\"" + domain + "\"}")
    return 0
}

// ─── subcmd: update ─────────────────────────────────────────

fn cmd_update(args: array) -> int {
    if len(args) < 1 { println("{\"error\":\"missing id\"}"); return 1 }
    let target = args[0]
    let new_status = _arg_value(args, "--status")
    let new_ts = _arg_value(args, "--completion-ts")
    let add_ev = _arg_value(args, "--add-evidence")

    let mut d = 0
    while d < len(DOMAINS) {
        let domain = DOMAINS[d]
        let p = _path_for_domain(domain)
        let content = _read_file(p)
        let lines = _split_lines(content)
        let mut found = false
        let mut new_lines = []
        let mut i = 0
        while i < len(lines) {
            let line = lines[i]
            if !_is_comment_or_blank(line) && _extract_id(line) == target {
                found = true
                let mut updated = line
                if len(new_status) > 0 {
                    let cur = _extract_str_field(line, "status")
                    updated = updated.replace("\"status\":\"" + cur + "\"", "\"status\":\"" + new_status + "\"")
                }
                if len(new_ts) > 0 {
                    let cur_ts = _extract_str_field(line, "completion_ts")
                    if len(cur_ts) > 0 {
                        updated = updated.replace("\"completion_ts\":\"" + cur_ts + "\"", "\"completion_ts\":\"" + new_ts + "\"")
                    } else {
                        // append before final brace
                        let before = updated.substring(0, len(updated) - 1)
                        updated = before + ",\"completion_ts\":\"" + new_ts + "\"}"
                    }
                }
                new_lines = new_lines.push(updated)
            } else {
                new_lines = new_lines.push(line)
            }
            i = i + 1
        }
        if found {
            if !_lock_acquire(domain) { println("{\"error\":\"lock timeout\"}"); return 1 }
            let mut out = ""
            let mut k = 0
            while k < len(new_lines) {
                out = out + new_lines[k]
                if k < len(new_lines) - 1 { out = out + "\n" }
                k = k + 1
            }
            let _ = _atomic_write(p, out)
            let _ = _lock_release(domain)
            println("{\"ok\":true,\"id\":\"" + target + "\",\"updated\":true}")
            return 0
        }
        d = d + 1
    }
    println("{\"error\":\"id not found\",\"id\":\"" + target + "\"}")
    return 1
}

// ─── subcmd: remove ─────────────────────────────────────────

fn cmd_remove(args: array) -> int {
    if len(args) < 1 { println("{\"error\":\"missing id\"}"); return 1 }
    let target = args[0]
    let mut d = 0
    while d < len(DOMAINS) {
        let domain = DOMAINS[d]
        let p = _path_for_domain(domain)
        let content = _read_file(p)
        let lines = _split_lines(content)
        let mut found = false
        let mut new_lines = []
        let mut i = 0
        while i < len(lines) {
            let line = lines[i]
            if !_is_comment_or_blank(line) && _extract_id(line) == target {
                found = true
            } else {
                new_lines = new_lines.push(line)
            }
            i = i + 1
        }
        if found {
            if !_lock_acquire(domain) { println("{\"error\":\"lock timeout\"}"); return 1 }
            let mut out = ""
            let mut k = 0
            while k < len(new_lines) {
                out = out + new_lines[k]
                if k < len(new_lines) - 1 { out = out + "\n" }
                k = k + 1
            }
            let _ = _atomic_write(p, out)
            let _ = _lock_release(domain)
            println("{\"ok\":true,\"id\":\"" + target + "\",\"removed\":true}")
            return 0
        }
        d = d + 1
    }
    println("{\"error\":\"id not found\",\"id\":\"" + target + "\"}")
    return 1
}

// ─── subcmd: link ───────────────────────────────────────────

fn cmd_link(args: array) -> int {
    if len(args) < 2 { println("{\"error\":\"link requires <from-id> <to-id>\"}"); return 1 }
    let from_id = args[0]
    let to_id = args[1]
    let kind = _arg_value(args, "--kind")
    if len(kind) == 0 { println("{\"error\":\"missing --kind (depends-on|feeds-main|supersedes)\"}"); return 1 }
    // For now, just emit JSON acknowledgment — actual linking is via update + add-depends-on, follow-up
    println("{\"ok\":true,\"from\":\"" + from_id + "\",\"to\":\"" + to_id + "\",\"kind\":\"" + kind + "\",\"note\":\"link manifested via update --add-depends-on; follow-up cycle for in-place edit\"}")
    return 0
}

// ─── subcmd: verify ─────────────────────────────────────────

fn cmd_verify() -> int {
    // Delegate to lint tool
    let lint_path = REPO_ROOT + "/tool/roadmap_lint.hexa"
    if !_file_exists(lint_path) {
        println("{\"error\":\"lint tool missing\",\"path\":\"" + lint_path + "\"}")
        return 1
    }
    let out = to_string(exec("hexa run " + _sh_quote(lint_path) + " 2>&1"))
    print(out)
    return 0
}

// ─── subcmd: render ─────────────────────────────────────────

fn cmd_render(args: array) -> int {
    let render_path = REPO_ROOT + "/tool/roadmap_render.hexa"
    if !_file_exists(render_path) {
        println("{\"error\":\"render tool missing\",\"path\":\"" + render_path + "\"}")
        return 1
    }
    let mut argstr = ""
    let mut i = 0
    while i < len(args) {
        argstr = argstr + " " + _sh_quote(args[i])
        i = i + 1
    }
    let out = to_string(exec("hexa run " + _sh_quote(render_path) + argstr + " 2>&1"))
    print(out)
    return 0
}

// ─── subcmd: track-new ──────────────────────────────────────

fn cmd_track_new(args: array) -> int {
    if len(args) < 1 { println("{\"error\":\"missing track-name\"}"); return 1 }
    let track_name = args[0]
    let substrates_csv = _arg_value(args, "--substrates")
    if len(substrates_csv) == 0 { println("{\"error\":\"missing --substrates\"}"); return 1 }
    // Create a meta entry as track-def
    if !_lock_acquire("meta") { println("{\"error\":\"lock timeout meta\"}"); return 1 }
    let max_n = _max_id_num("meta", "meta")
    let new_id = "meta." + _zero_pad3(max_n + 1)
    let parts = substrates_csv.split(",")
    let mut sj = "["
    let mut k = 0
    while k < len(parts) {
        if k > 0 { sj = sj + "," }
        sj = sj + "\"" + parts[k].trim() + "\""
        k = k + 1
    }
    sj = sj + "]"
    let entry = "{\"id\":\"" + new_id + "\",\"mk\":2,\"domain\":\"meta\",\"status\":\"landed\",\"title\":\"track-def: " + track_name + "\",\"substrates\":" + sj + ",\"track\":\"" + track_name + "\",\"phase\":\"track-def\",\"since\":\"" + _now_iso().substring(0, 10) + "\",\"completion_ts\":\"" + _now_iso() + "\",\"why\":\"track launch declaration\",\"depends_on\":[],\"feeds_main\":false,\"evidence\":[],\"refs\":[],\"raw_ref\":\"\",\"cost\":\"$0\",\"effect\":\"track-def\"}"
    let p = _path_for_domain("meta")
    let prev = _read_file(p)
    let new_content = prev + entry + "\n"
    let _ = _atomic_write(p, new_content)
    let _ = _lock_release("meta")
    println("{\"ok\":true,\"track_id\":\"" + new_id + "\",\"track_name\":\"" + track_name + "\"}")
    return 0
}

// ─── subcmd: deps (cross-repo 1-level resolver) ─────────────

fn cmd_deps(args: array) -> int {
    if len(args) < 1 { println("{\"error\":\"deps requires <domain>\"}"); return 1 }
    let domain = args[0]
    let p = _path_for_domain(domain)
    if !_file_exists(p) {
        println("{\"error\":\"domain file missing\",\"path\":\"" + p + "\",\"repo\":\"" + REPO_ROOT + "\"}")
        return 1
    }
    let content = _read_file(p)
    let lines = _split_lines(content)
    // First non-blank, non-comment line should be header (kind=domain)
    let mut header = ""
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        if !_is_comment_or_blank(line) {
            if line.index_of("\"type\":\"header\"") >= 0 {
                header = line
                break
            }
        }
        i = i + 1
    }
    let perspective = _extract_str_field(header, "perspective")
    let provider_dep = _extract_str_field(header, "provider_dependency")
    let origin_repo = _extract_str_field(header, "origin_repo")
    let mut provider_path = ""
    let mut provider_resolved = false
    if len(provider_dep) > 0 {
        provider_path = _resolver_query("resolve-dep", provider_dep)
        if len(provider_path) > 0 && _file_exists(provider_path) { provider_resolved = true }
    }
    let mut blocker_summary = "{\"unmet_conditions\":0,\"blockers\":0}"
    let mut prov_summary = "{\"resolved\":false}"
    if provider_resolved {
        let prov_content = _read_file(provider_path)
        let prov_lines = _split_lines(prov_content)
        let mut unmet = 0
        let mut blocked = 0
        let mut j = 0
        while j < len(prov_lines) {
            let pline = prov_lines[j]
            if !_is_comment_or_blank(pline) {
                // count "status":"unmet" inside required_conditions
                let mut pos = 0
                while pos < len(pline) {
                    let nxt = pline.substring(pos, len(pline)).index_of("\"status\":\"unmet\"")
                    if nxt < 0 { break }
                    unmet = unmet + 1
                    pos = pos + nxt + 16
                }
                let mut pos2 = 0
                while pos2 < len(pline) {
                    let nxt2 = pline.substring(pos2, len(pline)).index_of("\"status\":\"blocked\"")
                    if nxt2 < 0 { break }
                    blocked = blocked + 1
                    pos2 = pos2 + nxt2 + 18
                }
            }
            j = j + 1
        }
        prov_summary = "{\"resolved\":true,\"path\":\"" + provider_path + "\",\"unmet_conditions\":" + to_string(unmet) + ",\"blockers\":" + to_string(blocked) + "}"
    } else if len(provider_dep) > 0 {
        prov_summary = "{\"resolved\":false,\"spec\":\"" + provider_dep + "\",\"reason\":\"path not found or registry miss\"}"
    }
    println("{\"domain\":\"" + domain + "\",\"repo\":\"" + REPO_ROOT + "\",\"perspective\":\"" + perspective + "\",\"origin_repo\":\"" + origin_repo + "\",\"provider_dependency\":\"" + provider_dep + "\",\"provider\":" + prov_summary + "}")
    return 0
}

// ─── subcmd: selftest ───────────────────────────────────────

fn cmd_selftest() -> int {
    let mut pass = 0
    let mut total = 0
    // S1: domains
    total = total + 1
    if cmd_domains() == 0 { pass = pass + 1 }
    // S2: list
    total = total + 1
    if cmd_list([]) == 0 { pass = pass + 1 }
    // S3: list with domain filter
    total = total + 1
    if cmd_list(["--domain", "meta"]) == 0 { pass = pass + 1 }
    // S4: show first available id (discovered dynamically; was hardcoded "meta.000" pre-cross-repo cycle)
    total = total + 1
    let mut s4_ok = false
    let mut s4d = 0
    while s4d < len(DOMAINS) && !s4_ok {
        let s4p = _path_for_domain(DOMAINS[s4d])
        let s4c = _read_file(s4p)
        let s4l = _split_lines(s4c)
        let mut s4i = 0
        while s4i < len(s4l) && !s4_ok {
            let s4line = s4l[s4i]
            if !_is_comment_or_blank(s4line) {
                let s4id = _extract_id(s4line)
                if len(s4id) > 0 {
                    if cmd_show([s4id]) == 0 { s4_ok = true }
                }
            }
            s4i = s4i + 1
        }
        s4d = s4d + 1
    }
    if s4_ok { pass = pass + 1 }
    // S5: show unknown id (expect non-zero)
    total = total + 1
    if cmd_show(["bogus.999"]) != 0 { pass = pass + 1 }
    // S6: link (no-op JSON)
    total = total + 1
    if cmd_link(["a.001", "b.002", "--kind", "depends-on"]) == 0 { pass = pass + 1 }
    // S7: list with status filter
    total = total + 1
    if cmd_list(["--status", "ready"]) == 0 { pass = pass + 1 }
    // S8: list with track filter
    total = total + 1
    if cmd_list(["--track", "n_substrate_consciousness_2026_05_01"]) == 0 { pass = pass + 1 }
    // S9: invalid domain rejected by add
    total = total + 1
    if cmd_add(["bogusdom", "--title", "x"]) != 0 { pass = pass + 1 }
    // S10: add missing title rejected
    total = total + 1
    if cmd_add(["meta"]) != 0 { pass = pass + 1 }
    // S11: track-new missing substrates rejected
    total = total + 1
    if cmd_track_new(["test_track"]) != 0 { pass = pass + 1 }
    // S12: cross-repo resolver helper present
    total = total + 1
    if _file_exists(RESOLVER_PATH) { pass = pass + 1 }
    // S13: pwd auto-detect returns non-empty (repo root resolves)
    total = total + 1
    if len(_autodetect_repo_root()) > 0 { pass = pass + 1 }
    // S14: deps subcmd against discovered domain (qrng, has provider_dependency in anima)
    total = total + 1
    if cmd_deps(["qrng"]) == 0 { pass = pass + 1 }

    println("[selftest] " + to_string(pass) + "/" + to_string(total) + " PASS")
    if pass == total { return 0 }
    return 1
}

// ─── main dispatcher (top-level) ─────────────────────────────

let _argv = args()
// args() returns [interpreter, script, ...user_args]
if len(_argv) < 3 {
    println("{\"error\":\"usage: roadmap_op <subcmd> [args]\",\"subcmds\":[\"add\",\"update\",\"remove\",\"list\",\"show\",\"link\",\"domains\",\"verify\",\"render\",\"selftest\",\"track-new\"],\"cross_repo_flags\":[\"--repo <name|path>\",\"--all-repos\"]}")
    exit(1)
}
let _cmd = to_string(_argv[2])
let mut _rest = []
let mut _i = 3
while _i < len(_argv) {
    _rest = _rest.push(to_string(_argv[_i]))
    _i = _i + 1
}

// ── Cross-repo resolution (Option D Hybrid) ───────────────
// Precedence: --repo > pwd auto-detect > REPO_ROOT_DEFAULT
let _repo_arg = _arg_value(_rest, "--repo")
let _all_repos = _arg_present(_rest, "--all-repos")
if len(_repo_arg) > 0 {
    let resolved = _resolve_repo_arg(_repo_arg)
    REPO_ROOT = if len(resolved) > 0 { resolved } else { _repo_arg }
} else {
    REPO_ROOT = _autodetect_repo_root()
}
// Discover domains; fallback to hardcoded list on miss.
let _discovered = _discover_domains(REPO_ROOT)
if len(_discovered) > 0 { DOMAINS = _discovered }

let mut _rc = 0
if _all_repos {
    // Iterate over all mk2_roadmap=true repos and union outputs (list/render only).
    let repos = _all_mk2_repos()
    let mut k = 0
    while k < len(repos) {
        REPO_ROOT = repos[k]
        let dd = _discover_domains(REPO_ROOT)
        DOMAINS = if len(dd) > 0 { dd } else { DOMAINS_FALLBACK }
        if _cmd == "list" { let _ = cmd_list(_rest) }
        else if _cmd == "domains" { let _ = cmd_domains() }
        else if _cmd == "render" { let _ = cmd_render(_rest) }
        else if _cmd == "verify" { let _ = cmd_verify() }
        else {
            println("{\"error\":\"--all-repos not supported for subcmd\",\"got\":\"" + _cmd + "\",\"supported\":[\"list\",\"domains\",\"render\",\"verify\"]}")
            exit(1)
        }
        k = k + 1
    }
    exit(0)
}

if _cmd == "domains" { _rc = cmd_domains() }
else if _cmd == "list" { _rc = cmd_list(_rest) }
else if _cmd == "show" { _rc = cmd_show(_rest) }
else if _cmd == "add" { _rc = cmd_add(_rest) }
else if _cmd == "update" { _rc = cmd_update(_rest) }
else if _cmd == "remove" { _rc = cmd_remove(_rest) }
else if _cmd == "link" { _rc = cmd_link(_rest) }
else if _cmd == "verify" { _rc = cmd_verify() }
else if _cmd == "render" { _rc = cmd_render(_rest) }
else if _cmd == "track-new" { _rc = cmd_track_new(_rest) }
else if _cmd == "selftest" { _rc = cmd_selftest() }
else if _cmd == "deps" { _rc = cmd_deps(_rest) }
else {
    println("{\"error\":\"unknown subcmd\",\"got\":\"" + _cmd + "\"}")
    _rc = 1
}
exit(_rc)
