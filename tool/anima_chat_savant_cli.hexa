// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_chat_savant_cli.hexa — anima_chat ↔ savant tool CLI bridge
//
//  PURPOSE (SAVANT-TOOL Phase 2)
//    anima_chat.hexa (113KB / 2800 LoC) 본체 무수정. 본 file 은 *별도 entry*
//    로서 anima_chat 의 chat dict 를 받아 savant tool 명령 dispatch:
//      /savant on <reason>     → savant_set(chat, true, reason) (T1/T2/user only)
//      /savant off             → savant_set(chat, false, "user_explicit")
//      /savant status          → savant_get + dropout + last_si 표시
//      /savant si              → savant_si(chat, t_norm, t_sav) compute
//      /savant gate            → savant_apply_gate(chat, ent, wmax, splits)
//
//    SAVANT-TOOL.tape 패턴: toggle + self-evaluation. NOT 자동 routing modifier.
//    SAVANT.md §12 봉쇄 (T3/T4 reason 자동 거절) 가 CLI 표면에서도 enforce.
//
//    Future Phase 3: anima_chat.hexa 의 chat_repl 안 slash dispatch 에 본 함수
//    들 통합 — import-alias-runtime-resolve patch land 후 modular import 가능.
//
//  FALSIFIERS
//    F-CHAT-SAVANT-CLI-1 DISPATCH-OK    /savant on/off/status/si/gate 모두 expected
//    F-CHAT-SAVANT-CLI-2 NO-MUT         anima_chat.hexa 본체 무수정 (별도 entry)
//    F-CHAT-SAVANT-CLI-3 IDEMPOTENT     /savant on 두 번 → state 동일
//    F-CHAT-SAVANT-CLI-4 TIER-REJECT    /savant on cosmic_gz → ok=false, state 무변
// ════════════════════════════════════════════════════════════════════════════


// ── §1 savant tool functions (mirror of anima_savant_tool.hexa, sc_ prefix
//      — import-alias-runtime-resolve 미해결 상태이므로 single-file combined) ─

fn sc_gz_center()    { return 1.0 / 2.71828182845904 }      // 1/e ≈ 0.3679
fn sc_gz_lower()     { return 0.5 - log(4.0 / 3.0) }        // 1/2 - ln(4/3) ≈ 0.2123
fn sc_si_threshold() { return 3.0 }


fn sc_is_allowed_reason(reason: string) {
    if reason == "gz_center_dropout" { return true }
    if reason == "gz_lower_dropout"  { return true }
    if reason == "si_definition"     { return true }
    if reason == "math_closed_form"  { return true }
    if reason == "clm_06_mistral_7b" { return true }
    if reason == "user_explicit"     { return true }
    return false
}

fn sc_is_forbidden_reason(reason: string) {
    if reason == "cross_domain_9_individual"   { return true }
    if reason == "brain_profile"               { return true }
    if reason == "individual_savants_pattern"  { return true }
    if reason == "cosmic_gz"                   { return true }
    if reason == "external_entity_lattice_fit" { return true }
    return false
}


fn sc_savant_get(chat) {
    let v = chat["savant_enabled"]
    if to_string(v) == "void" { return false }
    return v
}

fn sc_savant_dropout(chat) {
    let v = chat["savant_dropout"]
    if to_string(v) == "void" { return sc_gz_center() }
    return v
}

fn sc_savant_last_si(chat) {
    let v = chat["last_si"]
    if to_string(v) == "void" { return 0.0 }
    return v
}


fn sc_savant_set(chat, enabled: bool, reason: string) {
    if sc_is_forbidden_reason(reason) {
        return #{
            "ok": false,
            "rejected_reason": reason,
            "tier": "T3_OR_T4_FORBIDDEN",
            "chat": chat,
        }
    }
    if !sc_is_allowed_reason(reason) {
        return #{
            "ok": false,
            "rejected_reason": reason,
            "tier": "UNKNOWN_REASON",
            "chat": chat,
        }
    }
    chat["savant_enabled"] = enabled
    chat["savant_reason"]  = reason
    if enabled  { chat["savant_dropout"] = sc_gz_lower() }
    if !enabled { chat["savant_dropout"] = sc_gz_center() }
    return #{
        "ok": true,
        "tier": "T1_OR_T2_OR_USER_OK",
        "chat": chat,
    }
}


fn sc_savant_si(chat, t_norm: float, t_sav: float) {
    let mut si = 0.0
    if t_sav > 0.0 { si = t_norm / t_sav }
    chat["last_si"] = si
    return si
}


fn sc_savant_check_gate(chat, token_entropy: float, wmax: float, recent_splits: int) {
    if recent_splits >= 5 {
        return #{
            "recommend_enable": false,
            "reason": "explore_phase_recent_splits",
        }
    }
    if wmax >= 0.8 {
        return #{
            "recommend_enable": false,
            "reason": "already_specialized_high_wmax",
        }
    }
    if token_entropy < 1.5 {
        return #{
            "recommend_enable": true,
            "reason": "low_entropy_specialization_need",
        }
    }
    return #{
        "recommend_enable": false,
        "reason": "generalist_baseline",
    }
}


fn sc_savant_apply_gate(chat, token_entropy: float, wmax: float, recent_splits: int) {
    let g = sc_savant_check_gate(chat, token_entropy, wmax, recent_splits)
    let si_val = sc_savant_last_si(chat)
    if si_val < sc_si_threshold() {
        if sc_savant_get(chat) {
            let r = sc_savant_set(chat, false, "user_explicit")
            chat = r["chat"]
        }
        return #{
            "applied": false,
            "forced_off_reason": "si_below_threshold",
            "si": si_val,
            "threshold": sc_si_threshold(),
            "chat": chat,
        }
    }
    if g["recommend_enable"] {
        let r = sc_savant_set(chat, true, "user_explicit")
        chat = r["chat"]
        return #{
            "applied": true,
            "enabled": true,
            "si": si_val,
            "chat": chat,
        }
    }
    if sc_savant_get(chat) {
        let r = sc_savant_set(chat, false, "user_explicit")
        chat = r["chat"]
    }
    return #{
        "applied": true,
        "enabled": false,
        "si": si_val,
        "gate_reason": g["reason"],
        "chat": chat,
    }
}


// ══════════════════════════════════════════════════════════════════════════════
//  §2 CLI dispatch — anima_chat 의 chat_repl 안 slash 명령 처리
// ══════════════════════════════════════════════════════════════════════════════

// savant_cli_dispatch(chat, cmd, reason, t_norm, t_sav, ent, wmax, splits)
//   cmd ∈ {
//     "/savant on", "/savant off", "/savant status",
//     "/savant si", "/savant gate"
//   }
//   `reason` 인자는 "/savant on" 일 때만 의미 (T1/T2/user_explicit 검증).
//   `t_norm`, `t_sav` 는 "/savant si" 일 때만 사용.
//   `ent`, `wmax`, `splits` 는 "/savant gate" 일 때만 사용.
fn savant_cli_dispatch(chat, cmd: string, reason: string, t_norm: float, t_sav: float, ent: float, wmax: float, splits: int) {

    if cmd == "/savant on" {
        let r = sc_savant_set(chat, true, reason)
        if r["ok"] != true {
            let mut tier_label = "tier rejected"
            if r["tier"] == "T3_OR_T4_FORBIDDEN" { tier_label = "T3/T4 FORBIDDEN" }
            if r["tier"] == "UNKNOWN_REASON"     { tier_label = "unknown reason (whitelist only)" }
            return #{
                "chat": r["chat"],
                "reply": "savant ON refused: " + tier_label + " (" + reason + ")",
                "ok": false,
                "tier": r["tier"],
            }
        }
        return #{
            "chat": r["chat"],
            "reply": "savant enabled (dropout → GZ_LOWER, reason: " + reason + ")",
            "ok": true,
        }
    }

    if cmd == "/savant off" {
        let r = sc_savant_set(chat, false, "user_explicit")
        return #{
            "chat": r["chat"],
            "reply": "savant disabled (dropout → GZ_CENTER)",
            "ok": true,
        }
    }

    if cmd == "/savant status" {
        let enabled  = sc_savant_get(chat)
        let dropout  = sc_savant_dropout(chat)
        let last_si  = sc_savant_last_si(chat)
        let mut state = "savant OFF"
        if enabled { state = "savant ON" }
        let mut s = state + " · dropout=" + to_string(dropout) + " · last_si=" + to_string(last_si)
        return #{
            "chat": chat,
            "reply": s,
            "ok": true,
            "enabled": enabled,
            "dropout": dropout,
            "last_si": last_si,
        }
    }

    if cmd == "/savant si" {
        let si = sc_savant_si(chat, t_norm, t_sav)
        let mut crosses = "below threshold (3.0)"
        if si >= sc_si_threshold() { crosses = "ABOVE threshold (3.0)" }
        return #{
            "chat": chat,
            "reply": "SI = " + to_string(t_norm) + "/" + to_string(t_sav) + " = " + to_string(si) + " · " + crosses,
            "ok": true,
            "si": si,
        }
    }

    if cmd == "/savant help" {
        let mut s = "savant CLI commands:\n"
        s = s + "  /savant on <reason>  — enable savant mode (reason 필수)\n"
        s = s + "      allowed reasons (SAVANT.md §12 T1+T2+user):\n"
        s = s + "        T1: gz_center_dropout · gz_lower_dropout · si_definition · math_closed_form\n"
        s = s + "        T2: clm_06_mistral_7b (substrate 명시)\n"
        s = s + "        user: user_explicit\n"
        s = s + "      forbidden (T3+T4, 자동 거절):\n"
        s = s + "        T3: cross_domain_9_individual · brain_profile · individual_savants_pattern\n"
        s = s + "        T4: cosmic_gz · external_entity_lattice_fit\n"
        s = s + "  /savant off          — disable savant mode (dropout → GZ_CENTER 1/e)\n"
        s = s + "  /savant status       — show enabled/dropout/last_si\n"
        s = s + "  /savant si           — compute SI = t_norm / t_sav (threshold 3.0)\n"
        s = s + "  /savant gate         — 3-signal self-gate (entropy + wmax + recent_splits)"
        return #{
            "chat": chat,
            "reply": s,
            "ok": true,
        }
    }

    if cmd == "/savant gate" {
        let g = sc_savant_apply_gate(chat, ent, wmax, splits)
        chat = g["chat"]
        let mut reply = "gate applied"
        let applied = g["applied"]
        if to_string(applied) != "void" {
            if !applied {
                reply = "gate forced OFF (" + to_string(g["forced_off_reason"]) + ", si=" + to_string(g["si"]) + ")"
            }
            if applied {
                let enabled_after = g["enabled"]
                if enabled_after { reply = "gate ON (si=" + to_string(g["si"]) + ")" }
                if !enabled_after { reply = "gate OFF (gate_reason=" + to_string(g["gate_reason"]) + ", si=" + to_string(g["si"]) + ")" }
            }
        }
        return #{
            "chat": chat,
            "reply": reply,
            "ok": true,
        }
    }

    return #{
        "chat": chat,
        "reply": "unknown command",
        "ok": false,
    }
}


// ══════════════════════════════════════════════════════════════════════════════
//  §3 Falsifiers
// ══════════════════════════════════════════════════════════════════════════════

fn make_chat() {
    return #{
        "savant_enabled": false,
        "session_id": "test",
    }
}


fn f_savant_cli_1_dispatch() {
    println("  F-CHAT-SAVANT-CLI-1 (DISPATCH-OK) ...")
    let mut chat = make_chat()

    // /savant status (default off)
    let r1 = savant_cli_dispatch(chat, "/savant status", "", 0.0, 0.0, 0.0, 0.0, 0)
    if r1["enabled"] != false {
        println("    FAIL: default status not OFF, got", r1["reply"])
        return false
    }

    // /savant on math_closed_form
    let r2 = savant_cli_dispatch(r1["chat"], "/savant on", "math_closed_form", 0.0, 0.0, 0.0, 0.0, 0)
    if r2["ok"] != true {
        println("    FAIL: T1 reason on rejected, reply=", r2["reply"])
        return false
    }

    // /savant status (now on)
    let r3 = savant_cli_dispatch(r2["chat"], "/savant status", "", 0.0, 0.0, 0.0, 0.0, 0)
    if r3["enabled"] != true {
        println("    FAIL: after on, status not ON, reply=", r3["reply"])
        return false
    }

    // /savant si 5.93 / 1.0 → 5.93 > threshold
    let r4 = savant_cli_dispatch(r3["chat"], "/savant si", "", 5.93, 1.0, 0.0, 0.0, 0)
    let mut diff4 = r4["si"] - 5.93
    if diff4 < 0.0 { diff4 = 0.0 - diff4 }
    if diff4 > 1e-9 {
        println("    FAIL: SI compute mismatch, got", r4["si"])
        return false
    }

    // /savant gate ent=1.0 wmax=0.5 splits=0 → strong SI + low ent → ON 유지
    let r5 = savant_cli_dispatch(r4["chat"], "/savant gate", "", 0.0, 0.0, 1.0, 0.5, 0)
    if !sc_savant_get(r5["chat"]) {
        println("    FAIL: gate with strong SI + low ent should enable")
        return false
    }

    // /savant gate ent=1.0 wmax=0.5 splits=7 → explore phase → OFF 강제
    let r6 = savant_cli_dispatch(r5["chat"], "/savant gate", "", 0.0, 0.0, 1.0, 0.5, 7)
    if sc_savant_get(r6["chat"]) {
        println("    FAIL: gate with splits=7 should force OFF")
        return false
    }

    // /savant off
    let r7 = savant_cli_dispatch(r6["chat"], "/savant off", "", 0.0, 0.0, 0.0, 0.0, 0)
    if r7["ok"] != true {
        println("    FAIL: off rejected")
        return false
    }
    if sc_savant_get(r7["chat"]) {
        println("    FAIL: after off, still enabled")
        return false
    }

    println("    PASS (status / on / si / gate ON / gate OFF / off — 6 dispatch")
    println("           commands round-trip)")
    return true
}


fn f_savant_cli_2_no_mut() {
    println("  F-CHAT-SAVANT-CLI-2 (NO-MUT) ...")
    // 본 file 이 anima_chat.hexa 본체 import / 호출 없이 작동 — minimal dict 만 받음.
    let mut chat = make_chat()
    let r = savant_cli_dispatch(chat, "/savant status", "", 0.0, 0.0, 0.0, 0.0, 0)
    if r["enabled"] != false {
        println("    FAIL: dispatch failed on minimal chat dict")
        return false
    }
    println("    PASS (anima_chat.hexa 본체 import / call 없이 작동)")
    return true
}


fn f_savant_cli_3_idempotent() {
    println("  F-CHAT-SAVANT-CLI-3 (IDEMPOTENT) ...")
    let mut chat = make_chat()
    let r1 = savant_cli_dispatch(chat, "/savant on", "math_closed_form", 0.0, 0.0, 0.0, 0.0, 0)
    let r2 = savant_cli_dispatch(r1["chat"], "/savant on", "math_closed_form", 0.0, 0.0, 0.0, 0.0, 0)
    if sc_savant_get(r1["chat"]) != sc_savant_get(r2["chat"]) {
        println("    FAIL: state changed after re-issue")
        return false
    }
    if r1["reply"] != r2["reply"] {
        println("    FAIL: reply changed")
        return false
    }
    println("    PASS (/savant on twice → same state, same reply)")
    return true
}


fn f_savant_cli_4_tier_reject() {
    println("  F-CHAT-SAVANT-CLI-4 (TIER-REJECT) ...")
    let mut chat = make_chat()

    // T4 reason cosmic_gz → 거절
    let r1 = savant_cli_dispatch(chat, "/savant on", "cosmic_gz", 0.0, 0.0, 0.0, 0.0, 0)
    if r1["ok"] != false {
        println("    FAIL: cosmic_gz (T4) was accepted")
        return false
    }
    if r1["tier"] != "T3_OR_T4_FORBIDDEN" {
        println("    FAIL: tier label wrong:", r1["tier"])
        return false
    }
    if sc_savant_get(r1["chat"]) {
        println("    FAIL: cosmic_gz refusal did not preserve OFF state")
        return false
    }

    // T3 reason brain_profile → 거절
    let r2 = savant_cli_dispatch(r1["chat"], "/savant on", "brain_profile", 0.0, 0.0, 0.0, 0.0, 0)
    if r2["ok"] != false {
        println("    FAIL: brain_profile (T3) was accepted")
        return false
    }

    // T3 reason cross_domain_9_individual → 거절
    let r3 = savant_cli_dispatch(r2["chat"], "/savant on", "cross_domain_9_individual", 0.0, 0.0, 0.0, 0.0, 0)
    if r3["ok"] != false {
        println("    FAIL: cross_domain_9 (T3) was accepted")
        return false
    }

    // unknown reason → 거절
    let r4 = savant_cli_dispatch(r3["chat"], "/savant on", "random_garbage", 0.0, 0.0, 0.0, 0.0, 0)
    if r4["ok"] != false {
        println("    FAIL: unknown reason was accepted (whitelist breach)")
        return false
    }
    if r4["tier"] != "UNKNOWN_REASON" {
        println("    FAIL: unknown reason tier wrong:", r4["tier"])
        return false
    }

    // T1 reason → 통과
    let r5 = savant_cli_dispatch(r4["chat"], "/savant on", "gz_lower_dropout", 0.0, 0.0, 0.0, 0.0, 0)
    if r5["ok"] != true {
        println("    FAIL: T1 gz_lower_dropout rejected, reply=", r5["reply"])
        return false
    }
    if !sc_savant_get(r5["chat"]) {
        println("    FAIL: T1 accepted but not enabled")
        return false
    }

    // T2 reason → 통과
    let mut chat2 = make_chat()
    let r6 = savant_cli_dispatch(chat2, "/savant on", "clm_06_mistral_7b", 0.0, 0.0, 0.0, 0.0, 0)
    if r6["ok"] != true {
        println("    FAIL: T2 clm_06_mistral_7b rejected")
        return false
    }

    println("    PASS (T3 brain_profile / cross_domain_9, T4 cosmic_gz, unknown")
    println("           all rejected; T1 gz_lower_dropout + T2 clm_06_mistral_7b OK)")
    return true
}


fn f_savant_cli_5_help() {
    println("  F-CHAT-SAVANT-CLI-5 (HELP-SELF-DOC) ...")
    let mut chat = make_chat()
    let r = savant_cli_dispatch(chat, "/savant help", "", 0.0, 0.0, 0.0, 0.0, 0)
    if r["ok"] != true {
        println("    FAIL: help reply ok=false")
        return false
    }
    // help reply 는 T1+T2+user_explicit allowed 와 T3+T4 forbidden 모두 포함해야 함
    let s = r["reply"]
    if contains(s, "gz_lower_dropout") == false {
        println("    FAIL: help missing T1 reason gz_lower_dropout")
        return false
    }
    if contains(s, "clm_06_mistral_7b") == false {
        println("    FAIL: help missing T2 reason clm_06_mistral_7b")
        return false
    }
    if contains(s, "cosmic_gz") == false {
        println("    FAIL: help missing T4 forbidden cosmic_gz")
        return false
    }
    if contains(s, "/savant on") == false {
        println("    FAIL: help missing /savant on command")
        return false
    }
    if contains(s, "/savant gate") == false {
        println("    FAIL: help missing /savant gate command")
        return false
    }
    println("    PASS (help lists T1+T2+user allowed, T3+T4 forbidden, 5 cmds)")
    return true
}


fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  anima_chat ↔ savant tool CLI bridge (F-CHAT-SAVANT-CLI-1..5)")
    println("════════════════════════════════════════════════════════════════")

    let f1 = f_savant_cli_1_dispatch()
    let f2 = f_savant_cli_2_no_mut()
    let f3 = f_savant_cli_3_idempotent()
    let f4 = f_savant_cli_4_tier_reject()
    let f5 = f_savant_cli_5_help()

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    println("────────────────────────────────────────────────────────────────")
    println("  VERDICT:", n_pass, "/ 5 PASS")
    println("────────────────────────────────────────────────────────────────")
    if n_pass == 5 {
        println("  ✅ F-CHAT-SAVANT-CLI-1..5 5/5 PASS — anima_chat × savant CLI LANDED")
        println("  Slash commands: /savant {on <reason>|off|status|si|gate|help}")
        println("  anima_chat.hexa 본체 무수정. T3/T4 reason 자동 거절 (SAVANT.md §12)")
        println("  import-alias-runtime-resolve patch land 후 chat_repl 직접 통합 가능.")
    }
}
