// tool/p9_a_d_cross_axis_verdict.hexa — P9 Path A x Path D cross-axis comparison verdict (raw#9 hexa-only Mac).
//
// PURPOSE
//   Reads Path A F1_v3 verdict (chat lift, Llama-3.2-3B + LoRA r=64 on 50K SFT)
//   AND Path D F1/F2/F3/F-D composite verdict (Phi-star distill, CLM v4 350M + LoRA r=64 on Mistral-7B teacher)
//   AND optional Q3a (Path A LoRA Phi-star degradation on Llama hidden states)
//   AND optional Q3b (Path D LoRA HellaSwag on CLM v4 substrate)
//
//   Emits the 4-cell pass/fail comparison matrix per spec §2:
//     I_BOTH_AXES_LIVE       A=CHAT_PASS_v3 AND D in {SUCCESS_D, PARTIAL_D} no F2 breach
//     II_CHAT_LIVE_ONLY      A=CHAT_PASS_v3 AND D=FAIL_D
//     III_PHI_LIVE_ONLY      A in {CHAT_PARTIAL_v3, CHAT_FAIL_v3} AND D in {SUCCESS_D, PARTIAL_D}
//     IV_BOTH_NOISE          A in {CHAT_PARTIAL_v3, CHAT_FAIL_v3} AND D=FAIL_D
//     UNDETERMINED           one or both verdict inputs missing/parse_error/empty
//
//   Auto-composes interpretation paragraph + next-cycle commission text per cell.
//
// INPUT
//   ANIMA_PATH_A_VERDICT  Path A F1_v3 verdict JSON
//                         (default: state/p9_a_prime_main_eval_2026_05_03_verdict.json)
//   ANIMA_PATH_D_VERDICT  Path D 4-falsifier composite JSON
//                         (default: state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json)
//   ANIMA_Q3A_RESULT      Optional; Path A LoRA Phi-star on Llama
//                         (default: state/p9_a_d_cross_axis_2026_05_03/q3a_path_a_phi_star.json)
//   ANIMA_Q3B_RESULT      Optional; Path D LoRA HellaSwag on CLM v4
//                         (default: state/p9_a_d_cross_axis_2026_05_03/q3b_path_d_chat.json)
//   ANIMA_OUTPUT          composite output JSON
//                         (default: state/p9_a_d_cross_axis_2026_05_03/cross_axis_verdict.json)
//   ANIMA_BOOT_N          bootstrap N for Q3a/Q3b CI display (default 1000)
//
// OUTPUT (schema = anima/p9_a_d_cross_axis/verdict/1)
//   - inputs: per-input load status
//   - path_a_summary: best ckpt F1_v3 verdict
//   - path_d_summary: best ckpt 4-falsifier verdict + F2 floor breach flag
//   - q3a_summary: relative_delta + classification (PASS/MARGINAL/FAIL/UNAVAILABLE)
//   - q3b_summary: delta_acc_norm + classification (EXPECTED/UNEXPECTED_LIFT/UNEXPECTED_REGRESSION/UNAVAILABLE)
//   - matrix_cell: I/II/III/IV/UNDETERMINED
//   - interpretation_paragraph: auto-composed 4-6 sentence narrative
//   - next_cycle_commission: per-cell commission text
//   - honest_c3: 5 caveats per spec §10
//
// USAGE
//   hexa run tool/p9_a_d_cross_axis_verdict.hexa --selftest
//   hexa run tool/p9_a_d_cross_axis_verdict.hexa
//   ANIMA_PATH_A_VERDICT=path/to/a.json ANIMA_PATH_D_VERDICT=path/to/d.json \
//     hexa run tool/p9_a_d_cross_axis_verdict.hexa
//
// raw#9 hexa-only Mac / raw#37 transient emit / raw#15 SSOT this file
// raw#10 honest C3 (5 caveats — see spec §10):
//   (a) different bases produce different baselines; cell labels are NOT head-to-head capability comparisons
//   (b) Q3a/Q3b are EXPLORATORY diagnostics, NOT pre-registered F-axis falsifiers
//   (c) verdict synthesis depends on both A and D BG cycles completing; partial -> UNDETERMINED
//   (d) Phi-star formula calibrated against CLM v4; Llama Phi-star NOT comparable to CLM v4 Phi-star
//   (e) bootstrap N=1000 over 200/500-prompt sets is direction-only signal, not precise effect size

let HELPER_PATH = "/tmp/p9_a_d_cross_axis_verdict_helper.py_tmp"

fn _write_helper() {
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# P9 A x D cross-axis verdict helper -- emitted by tool/p9_a_d_cross_axis_verdict.hexa (raw#37 transient)\n")
    parts.push("# Reads A + D verdicts + optional Q3a/Q3b cross-substrate evals,\n")
    parts.push("# emits 4-cell matrix + interpretation paragraph per spec sec.2.\n")
    parts.push("import json, os, sys, datetime\n\n")

    parts.push("PATH_A_VERDICT = os.environ.get('ANIMA_PATH_A_VERDICT',\n")
    parts.push("    'state/p9_a_prime_main_eval_2026_05_03_verdict.json')\n")
    parts.push("PATH_D_VERDICT = os.environ.get('ANIMA_PATH_D_VERDICT',\n")
    parts.push("    'state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json')\n")
    parts.push("Q3A_RESULT = os.environ.get('ANIMA_Q3A_RESULT',\n")
    parts.push("    'state/p9_a_d_cross_axis_2026_05_03/q3a_path_a_phi_star.json')\n")
    parts.push("Q3B_RESULT = os.environ.get('ANIMA_Q3B_RESULT',\n")
    parts.push("    'state/p9_a_d_cross_axis_2026_05_03/q3b_path_d_chat.json')\n")
    parts.push("OUTPUT = os.environ.get('ANIMA_OUTPUT',\n")
    parts.push("    'state/p9_a_d_cross_axis_2026_05_03/cross_axis_verdict.json')\n")
    parts.push("BOOT_N = int(os.environ.get('ANIMA_BOOT_N', '1000'))\n\n")

    parts.push("# Pre-registered Q3a thresholds (spec sec.3.1)\n")
    parts.push("Q3A_PASS_REL_DELTA_FLOOR = -0.10   # rel_delta >= -0.10 -> PASS\n")
    parts.push("Q3A_MARGINAL_REL_DELTA_FLOOR = -0.30  # -0.30 <= rel_delta < -0.10 -> MARGINAL\n")
    parts.push("# Pre-registered Q3b thresholds (spec sec.3.2)\n")
    parts.push("Q3B_EXPECTED_BAND = 0.02            # |delta_acc_norm| <= 0.02 -> EXPECTED\n")
    parts.push("Q3B_CLM_V4_HELLASWAG_FLOOR = 0.242  # CLM v4 base HellaSwag baseline (per A' base validation)\n\n")

    parts.push("def _load_json(path):\n")
    parts.push("    if not os.path.exists(path):\n")
    parts.push("        return None, 'missing'\n")
    parts.push("    try:\n")
    parts.push("        d = json.load(open(path))\n")
    parts.push("        return d, 'loaded'\n")
    parts.push("    except Exception as e:\n")
    parts.push("        return None, f'parse_error:{e}'\n\n")

    parts.push("def _summarize_path_a(verdict):\n")
    parts.push("    # Reads p9_a_prime_main_eval_2026_05_03_verdict.json shape per tool/p9_a_prime_verdict.hexa\n")
    parts.push("    if not verdict:\n")
    parts.push("        return {'best_ckpt_id': None, 'f1_v3': None, 'label': None,\n")
    parts.push("                'n_strong': 0, 'n_strong_regression': 0, 'n_ckpts': 0, 'note': 'verdict_missing'}\n")
    parts.push("    n_ckpts = verdict.get('n_ckpts', 0)\n")
    parts.push("    if n_ckpts == 0:\n")
    parts.push("        return {'best_ckpt_id': None, 'f1_v3': None, 'label': None,\n")
    parts.push("                'n_strong': 0, 'n_strong_regression': 0, 'n_ckpts': 0,\n")
    parts.push("                'note': 'verdict_loaded_but_zero_ckpts'}\n")
    parts.push("    ranking = verdict.get('ranking', [])\n")
    parts.push("    if not ranking:\n")
    parts.push("        return {'best_ckpt_id': None, 'f1_v3': None, 'label': None,\n")
    parts.push("                'n_strong': 0, 'n_strong_regression': 0, 'n_ckpts': n_ckpts,\n")
    parts.push("                'note': 'no_ranking_emitted'}\n")
    parts.push("    best = ranking[0]\n")
    parts.push("    comp = best.get('composite', {})\n")
    parts.push("    return {\n")
    parts.push("        'best_ckpt_id': best.get('ckpt_id'),\n")
    parts.push("        'f1_v3': comp.get('f1_v3'),\n")
    parts.push("        'label': comp.get('label'),\n")
    parts.push("        'n_strong': comp.get('n_strong', 0),\n")
    parts.push("        'n_strong_regression': comp.get('n_strong_regression', 0),\n")
    parts.push("        'n_ckpts': n_ckpts,\n")
    parts.push("        'note': None,\n")
    parts.push("    }\n\n")

    parts.push("def _summarize_path_d(verdict):\n")
    parts.push("    # Reads p9_paradigm_d_25k_eval_2026_05_03_verdict.json shape per tool/p9_paradigm_d_verdict.hexa\n")
    parts.push("    if not verdict:\n")
    parts.push("        return {'best_label': None, 'verdict': None, 'n_pass': 0,\n")
    parts.push("                'f2_floor_breach': False, 'n_ckpts': 0, 'note': 'verdict_missing'}\n")
    parts.push("    n_ckpts = verdict.get('n_ckpts_evaluated', 0)\n")
    parts.push("    if n_ckpts == 0:\n")
    parts.push("        return {'best_label': None, 'verdict': None, 'n_pass': 0,\n")
    parts.push("                'f2_floor_breach': False, 'n_ckpts': 0,\n")
    parts.push("                'note': 'verdict_loaded_but_zero_ckpts'}\n")
    parts.push("    ranking = verdict.get('ranking', [])\n")
    parts.push("    if not ranking:\n")
    parts.push("        return {'best_label': None, 'verdict': None, 'n_pass': 0,\n")
    parts.push("                'f2_floor_breach': False, 'n_ckpts': n_ckpts,\n")
    parts.push("                'note': 'no_ranking_emitted'}\n")
    parts.push("    best = ranking[0]\n")
    parts.push("    comp = best.get('composite', {})\n")
    parts.push("    # F2 breach detection: per p9_paradigm_d_verdict.hexa, F2 breach -> verdict='FAIL_D' + reason starts with F2_floor_breach\n")
    parts.push("    reason = comp.get('reason') or ''\n")
    parts.push("    f2_breach = 'F2_floor_breach' in reason\n")
    parts.push("    return {\n")
    parts.push("        'best_label': best.get('label'),\n")
    parts.push("        'verdict': comp.get('verdict'),\n")
    parts.push("        'n_pass': comp.get('n_pass', 0),\n")
    parts.push("        'f2_floor_breach': f2_breach,\n")
    parts.push("        'reason': reason,\n")
    parts.push("        'n_ckpts': n_ckpts,\n")
    parts.push("        'note': None,\n")
    parts.push("    }\n\n")

    parts.push("def _classify_q3a(q3a):\n")
    parts.push("    # Reads optional Q3a result: {delta_phi_star, relative_delta, ci95_lo, ci95_hi}\n")
    parts.push("    if not q3a:\n")
    parts.push("        return {'classification': 'UNAVAILABLE', 'delta_phi_star': None,\n")
    parts.push("                'relative_delta': None, 'ci95_lo': None, 'ci95_hi': None}\n")
    parts.push("    rel = q3a.get('relative_delta')\n")
    parts.push("    if rel is None:\n")
    parts.push("        return {'classification': 'UNAVAILABLE', 'delta_phi_star': q3a.get('delta_phi_star'),\n")
    parts.push("                'relative_delta': None, 'ci95_lo': q3a.get('ci95_lo'), 'ci95_hi': q3a.get('ci95_hi')}\n")
    parts.push("    # Sign flip detection (Phi-star inverted after LoRA)\n")
    parts.push("    phi_lora = q3a.get('phi_lora')\n")
    parts.push("    phi_base = q3a.get('phi_base')\n")
    parts.push("    sign_flip = (phi_lora is not None and phi_base is not None\n")
    parts.push("                  and ((phi_base > 0 and phi_lora < 0) or (phi_base < 0 and phi_lora > 0)))\n")
    parts.push("    if sign_flip:\n")
    parts.push("        cls = 'FAIL'\n")
    parts.push("    elif rel >= Q3A_PASS_REL_DELTA_FLOOR:\n")
    parts.push("        cls = 'PASS'\n")
    parts.push("    elif rel >= Q3A_MARGINAL_REL_DELTA_FLOOR:\n")
    parts.push("        cls = 'MARGINAL'\n")
    parts.push("    else:\n")
    parts.push("        cls = 'FAIL'\n")
    parts.push("    return {'classification': cls,\n")
    parts.push("            'delta_phi_star': q3a.get('delta_phi_star'),\n")
    parts.push("            'relative_delta': rel,\n")
    parts.push("            'sign_flip': sign_flip,\n")
    parts.push("            'phi_base': phi_base, 'phi_lora': phi_lora,\n")
    parts.push("            'ci95_lo': q3a.get('ci95_lo'), 'ci95_hi': q3a.get('ci95_hi')}\n\n")

    parts.push("def _classify_q3b(q3b):\n")
    parts.push("    # Reads optional Q3b result: {delta_acc_norm, acc_base, acc_lora, ci95_lo, ci95_hi}\n")
    parts.push("    if not q3b:\n")
    parts.push("        return {'classification': 'UNAVAILABLE', 'delta_acc_norm': None,\n")
    parts.push("                'acc_base': None, 'acc_lora': None,\n")
    parts.push("                'ci95_lo': None, 'ci95_hi': None}\n")
    parts.push("    # Optional skip: Q3b may emit {'skipped':'loader_bug'}\n")
    parts.push("    if q3b.get('skipped'):\n")
    parts.push("        return {'classification': 'UNAVAILABLE', 'skipped_reason': q3b.get('skipped'),\n")
    parts.push("                'delta_acc_norm': None, 'acc_base': None, 'acc_lora': None,\n")
    parts.push("                'ci95_lo': None, 'ci95_hi': None}\n")
    parts.push("    delta = q3b.get('delta_acc_norm')\n")
    parts.push("    if delta is None:\n")
    parts.push("        return {'classification': 'UNAVAILABLE', 'delta_acc_norm': None,\n")
    parts.push("                'acc_base': q3b.get('acc_base'), 'acc_lora': q3b.get('acc_lora'),\n")
    parts.push("                'ci95_lo': q3b.get('ci95_lo'), 'ci95_hi': q3b.get('ci95_hi')}\n")
    parts.push("    if abs(delta) <= Q3B_EXPECTED_BAND:\n")
    parts.push("        cls = 'EXPECTED'\n")
    parts.push("    elif delta > Q3B_EXPECTED_BAND:\n")
    parts.push("        cls = 'UNEXPECTED_LIFT'\n")
    parts.push("    else:\n")
    parts.push("        cls = 'UNEXPECTED_REGRESSION'\n")
    parts.push("    return {'classification': cls,\n")
    parts.push("            'delta_acc_norm': delta,\n")
    parts.push("            'acc_base': q3b.get('acc_base'),\n")
    parts.push("            'acc_lora': q3b.get('acc_lora'),\n")
    parts.push("            'ci95_lo': q3b.get('ci95_lo'),\n")
    parts.push("            'ci95_hi': q3b.get('ci95_hi')}\n\n")

    parts.push("def _determine_cell(a_sum, d_sum):\n")
    parts.push("    # Cell determination per spec sec.4.3\n")
    parts.push("    a_loaded = (a_sum.get('f1_v3') is not None)\n")
    parts.push("    d_loaded = (d_sum.get('verdict') is not None)\n")
    parts.push("    if not a_loaded or not d_loaded:\n")
    parts.push("        return 'UNDETERMINED', 'one_or_both_verdicts_missing'\n")
    parts.push("    a_pass = (a_sum['f1_v3'] == 'PASS')\n")
    parts.push("    d_pass = (d_sum['verdict'] in ('SUCCESS_D', 'PARTIAL_D')) and not d_sum.get('f2_floor_breach', False)\n")
    parts.push("    if a_pass and d_pass:\n")
    parts.push("        return 'I_BOTH_AXES_LIVE', 'a_pass_and_d_pass'\n")
    parts.push("    if a_pass and not d_pass:\n")
    parts.push("        return 'II_CHAT_LIVE_ONLY', 'a_pass_d_fail'\n")
    parts.push("    if (not a_pass) and d_pass:\n")
    parts.push("        return 'III_PHI_LIVE_ONLY', 'a_fail_d_pass'\n")
    parts.push("    return 'IV_BOTH_NOISE', 'a_fail_d_fail'\n\n")

    parts.push("CELL_INTERPRETATIONS = {\n")
    parts.push("    'I_BOTH_AXES_LIVE': (\n")
    parts.push("        'Both Path A (Llama+LoRA chat lift on F1_v3) and Path D (CLM v4+LoRA Phi-star distill on F1/F2/F3/F-D) '\n")
    parts.push("        'show measurable signal on their native substrates. The chat axis and the Phi-star axis are independently '\n")
    parts.push("        'falsifiable under the current pipelines. The two axes operate on different bases so additivity is NOT '\n")
    parts.push("        'directly tested by these verdicts; cross-substrate Q3 evals (if available) gauge whether stacking is '\n")
    parts.push("        'feasible in a future cycle.'\n")
    parts.push("    ),\n")
    parts.push("    'II_CHAT_LIVE_ONLY': (\n")
    parts.push("        'Path A passes (chat capability lift confirmed on Llama+LoRA). Path D fails: Phi-star-distill machinery '\n")
    parts.push("        'did not pass on CLM v4 substrate (likely F-D z-score MSE > 0.5 or F2 floor breach if sign-flipped). '\n")
    parts.push("        'The cycle ships Path A LoRA as primary artifact and commissions a Path D root-cause investigation. '\n")
    parts.push("        'Q3a (Path A LoRA Phi-star on Llama) becomes load-bearing: if Q3a=PASS, chat-tuning preserves Phi-star '\n")
    parts.push("        'on Llama -- partial Phi-star axis redemption even with native Path D failed.'\n")
    parts.push("    ),\n")
    parts.push("    'III_PHI_LIVE_ONLY': (\n")
    parts.push("        'Path D passes (Phi-star-distill machinery transfers Mistral-7B teacher integration patterns to CLM v4 '\n")
    parts.push("        'student per the 4-falsifier matrix). Path A fails: Llama+LoRA did not produce >=2 STRONG signals on '\n")
    parts.push("        'standard benchmarks. Possible causes: SFT corpus designed against CLM v4 may underperform on Llama '\n")
    parts.push("        'instruction-tuning regime; 50K records may be sub-scale for a 3B base; precision drift between 4-bit '\n")
    parts.push("        'base anchor and fp16 LoRA may mask signal. The cycle ships Path D LoRA as primary artifact and '\n")
    parts.push("        'commissions a Path A debug cycle (per-task autopsy + corpus-mismatch diagnostic).'\n")
    parts.push("    ),\n")
    parts.push("    'IV_BOTH_NOISE': (\n")
    parts.push("        'Neither Path A nor Path D produced significant signal above noise floor. F1_v3 = CHAT_FAIL_v3 AND '\n")
    parts.push("        '4-falsifier composite = FAIL_D. The cycle s primary research questions both lack measurable evidence. '\n")
    parts.push("        'Possible structural causes: LoRA r=64 insufficient for capability transfer at tested scales; '\n")
    parts.push("        'falsifier thresholds may be over-aggressive for achievable signal-to-noise; pre-train substrate '\n")
    parts.push("        'insufficiency (CLM v4 narrow-corpus CE 0.046 + Llama SFT also failing implies pipeline-recipe is '\n")
    parts.push("        'load-bearing rather than substrate). Next-cycle: NO further LoRA training; commission paradigm-rethink '\n")
    parts.push("        'ablation matrix at $50-100 ceiling.'\n")
    parts.push("    ),\n")
    parts.push("    'UNDETERMINED': (\n")
    parts.push("        'Cross-axis verdict cannot be composed: one or both Path A and Path D verdicts are unavailable, '\n")
    parts.push("        'parse_error, or empty (zero ckpts evaluated). Re-run the synthesis hexa after both eval cycles complete. '\n")
    parts.push("        'Do NOT substitute earlier ckpt verdicts (e.g. Path A 5K instead of 50K, Path D step_1000 mini-run instead '\n")
    parts.push("        'of 25K) -- the comparison spec is locked to final verdict identities.'\n")
    parts.push("    ),\n")
    parts.push("}\n\n")

    parts.push("CELL_NEXT_CYCLE_COMMISSION = {\n")
    parts.push("    'I_BOTH_AXES_LIVE': (\n")
    parts.push("        'Commission A union D additive cycle: pick one substrate (Llama or CLM v4) and stack both LoRA recipes; '\n")
    parts.push("        'eval on F1_v3 (chat) and F2/F3/F-D (Phi-star). Cost ceiling: $300-600 (re-train one stacked LoRA on '\n")
    parts.push("        'H100 spot OR ubu1 RTX 5070 48-72h).'\n")
    parts.push("    ),\n")
    parts.push("    'II_CHAT_LIVE_ONLY': (\n")
    parts.push("        'Ship Path A LoRA as primary artifact. Commission Path D root-cause cycle: per-ckpt F-D MSE trajectory '\n")
    parts.push("        'autopsy (where does z-score divergence appear? initial steps / plateau / overshoot?), F2 sign-flip '\n")
    parts.push("        'check if applicable, teacher-cache integrity verification. Cost ceiling: $0-50 (analysis + small-step '\n")
    parts.push("        're-train if recoverable).'\n")
    parts.push("    ),\n")
    parts.push("    'III_PHI_LIVE_ONLY': (\n")
    parts.push("        'Ship Path D LoRA as primary artifact (Phi-star machinery validated on CLM v4 substrate). Commission '\n")
    parts.push("        'Path A debug cycle: per-task signal autopsy (which benchmark moved most? was it MMLU regression vs '\n")
    parts.push("        'HellaSwag flat?), corpus-mismatch diagnostic (SFT prompt distribution vs Llama instruction-tune regime), '\n")
    parts.push("        'precision-uniform re-eval (full-precision base + LoRA, not 4-bit). Cost ceiling: $50-150.'\n")
    parts.push("    ),\n")
    parts.push("    'IV_BOTH_NOISE': (\n")
    parts.push("        'NO further LoRA training next cycle. Commission paradigm-rethink ablation matrix: vary LoRA rank '\n")
    parts.push("        '(16/32/64/128), corpus size (5K/15K/50K), distill loss weight at minimum cost (smoke runs, $50-100 '\n")
    parts.push("        'ceiling). If ablation shows zero discriminative range, escalate to Path C (CLM v4 general-English '\n")
    parts.push("        're-train per A prime decision sec.1.3) as the load-bearing repair. Cost ceiling: $100-200.'\n")
    parts.push("    ),\n")
    parts.push("    'UNDETERMINED': (\n")
    parts.push("        'No commission until both A and D verdict JSONs are present and non-empty. Re-run synthesis hexa once '\n")
    parts.push("        'inputs land.'\n")
    parts.push("    ),\n")
    parts.push("}\n\n")

    parts.push("def _q3_clauses(q3a_sum, q3b_sum):\n")
    parts.push("    clauses = []\n")
    parts.push("    if q3a_sum and q3a_sum.get('classification') and q3a_sum['classification'] != 'UNAVAILABLE':\n")
    parts.push("        rel = q3a_sum.get('relative_delta')\n")
    parts.push("        cls = q3a_sum['classification']\n")
    parts.push("        if cls == 'PASS':\n")
    parts.push("            clauses.append(f'Q3a (Path A LoRA Phi-star on Llama): rel_delta={rel:+.4f} -> PASS '\n")
    parts.push("                            '(chat-tuning preserves Phi-star axis within 10pct of Llama base).')\n")
    parts.push("        elif cls == 'MARGINAL':\n")
    parts.push("            clauses.append(f'Q3a (Path A LoRA Phi-star on Llama): rel_delta={rel:+.4f} -> MARGINAL '\n")
    parts.push("                            '(chat-tuning erodes Phi-star but no inversion; -30pct < degradation < -10pct).')\n")
    parts.push("        elif cls == 'FAIL':\n")
    parts.push("            sf = q3a_sum.get('sign_flip')\n")
    parts.push("            note = 'sign_flip detected' if sf else 'degradation > 30pct'\n")
    parts.push("            clauses.append(f'Q3a (Path A LoRA Phi-star on Llama): rel_delta={rel:+.4f} -> FAIL ({note}) '\n")
    parts.push("                            '-- chat-tuning destroys Phi-star axis on Llama substrate.')\n")
    parts.push("    if q3b_sum and q3b_sum.get('classification') and q3b_sum['classification'] != 'UNAVAILABLE':\n")
    parts.push("        delta = q3b_sum.get('delta_acc_norm')\n")
    parts.push("        cls = q3b_sum['classification']\n")
    parts.push("        if cls == 'EXPECTED':\n")
    parts.push("            clauses.append(f'Q3b (Path D LoRA HellaSwag on CLM v4): delta_acc_norm={delta:+.4f} -> EXPECTED '\n")
    parts.push("                            '(distill is chat-orthogonal as designed; HellaSwag at floor +/-0.02).')\n")
    parts.push("        elif cls == 'UNEXPECTED_LIFT':\n")
    parts.push("            clauses.append(f'Q3b: delta_acc_norm={delta:+.4f} -> UNEXPECTED_LIFT '\n")
    parts.push("                            '(distill incidentally improves chat -- mechanistic anomaly worth follow-up).')\n")
    parts.push("        elif cls == 'UNEXPECTED_REGRESSION':\n")
    parts.push("            clauses.append(f'Q3b: delta_acc_norm={delta:+.4f} -> UNEXPECTED_REGRESSION '\n")
    parts.push("                            '(distill destroys chat -- next-token prediction integrity check needed).')\n")
    parts.push("    return clauses\n\n")

    parts.push("a_v, a_status = _load_json(PATH_A_VERDICT)\n")
    parts.push("d_v, d_status = _load_json(PATH_D_VERDICT)\n")
    parts.push("q3a_v, q3a_status = _load_json(Q3A_RESULT)\n")
    parts.push("q3b_v, q3b_status = _load_json(Q3B_RESULT)\n\n")

    parts.push("a_summary = _summarize_path_a(a_v)\n")
    parts.push("d_summary = _summarize_path_d(d_v)\n")
    parts.push("q3a_summary = _classify_q3a(q3a_v)\n")
    parts.push("q3b_summary = _classify_q3b(q3b_v)\n")
    parts.push("cell, cell_reason = _determine_cell(a_summary, d_summary)\n\n")

    parts.push("interp = CELL_INTERPRETATIONS.get(cell, '')\n")
    parts.push("commission = CELL_NEXT_CYCLE_COMMISSION.get(cell, '')\n")
    parts.push("q3_clauses = _q3_clauses(q3a_summary, q3b_summary)\n")
    parts.push("if q3_clauses:\n")
    parts.push("    interp = interp + ' Cross-substrate diagnostics: ' + ' '.join(q3_clauses)\n\n")

    parts.push("summary = {\n")
    parts.push("    'schema': 'anima/p9_a_d_cross_axis/verdict/1',\n")
    parts.push("    'spec_ref': 'docs/p9_a_d_cross_axis_comparison_spec_2026_05_03.md',\n")
    parts.push("    'ts_utc': datetime.datetime.utcnow().isoformat() + 'Z',\n")
    parts.push("    'inputs': {\n")
    parts.push("        'path_a_verdict_path': PATH_A_VERDICT, 'path_a_status': a_status,\n")
    parts.push("        'path_d_verdict_path': PATH_D_VERDICT, 'path_d_status': d_status,\n")
    parts.push("        'q3a_path': Q3A_RESULT, 'q3a_status': q3a_status,\n")
    parts.push("        'q3b_path': Q3B_RESULT, 'q3b_status': q3b_status,\n")
    parts.push("    },\n")
    parts.push("    'path_a_summary': a_summary,\n")
    parts.push("    'path_d_summary': d_summary,\n")
    parts.push("    'q3a_summary': q3a_summary,\n")
    parts.push("    'q3b_summary': q3b_summary,\n")
    parts.push("    'matrix_cell': cell,\n")
    parts.push("    'matrix_cell_reason': cell_reason,\n")
    parts.push("    'interpretation_paragraph': interp,\n")
    parts.push("    'next_cycle_commission': commission,\n")
    parts.push("    'pre_registered_thresholds': {\n")
    parts.push("        'Q3A_PASS_REL_DELTA_FLOOR': Q3A_PASS_REL_DELTA_FLOOR,\n")
    parts.push("        'Q3A_MARGINAL_REL_DELTA_FLOOR': Q3A_MARGINAL_REL_DELTA_FLOOR,\n")
    parts.push("        'Q3B_EXPECTED_BAND': Q3B_EXPECTED_BAND,\n")
    parts.push("        'Q3B_CLM_V4_HELLASWAG_FLOOR': Q3B_CLM_V4_HELLASWAG_FLOOR,\n")
    parts.push("        'BOOTSTRAP_N': BOOT_N,\n")
    parts.push("    },\n")
    parts.push("    'verdict_legend': {\n")
    parts.push("        'I_BOTH_AXES_LIVE': 'A=CHAT_PASS_v3 AND D in {SUCCESS_D, PARTIAL_D} (no F2 breach)',\n")
    parts.push("        'II_CHAT_LIVE_ONLY': 'A=CHAT_PASS_v3 AND D=FAIL_D',\n")
    parts.push("        'III_PHI_LIVE_ONLY': 'A in {CHAT_PARTIAL_v3, CHAT_FAIL_v3} AND D in {SUCCESS_D, PARTIAL_D}',\n")
    parts.push("        'IV_BOTH_NOISE': 'A in {CHAT_PARTIAL_v3, CHAT_FAIL_v3} AND D=FAIL_D',\n")
    parts.push("        'UNDETERMINED': 'one or both verdict inputs missing/parse_error/empty',\n")
    parts.push("    },\n")
    parts.push("    'cross_axis_note': (\n")
    parts.push("        'Path A measures chat lift (HellaSwag/MMLU/TriviaQA delta) on Llama-3.2-3B (3B params, GQA, '\n")
    parts.push("        'SentencePiece). Path D measures Phi-star/BLEU on CLM v4 350M (Federated dual-stream, 64K BPE). '\n")
    parts.push("        'Cell labels describe per-axis verdicts on native substrates, NOT head-to-head capability comparisons.'\n")
    parts.push("    ),\n")
    parts.push("    'honest_c3': [\n")
    parts.push("        '(a) different bases produce different baselines; cell labels are NOT head-to-head capability comparisons',\n")
    parts.push("        '(b) Q3a/Q3b are EXPLORATORY diagnostics, NOT pre-registered F-axis falsifiers; thresholds are first-cycle heuristic',\n")
    parts.push("        '(c) verdict synthesis depends on both A and D BG cycles completing; partial -> UNDETERMINED, do NOT substitute earlier ckpts',\n")
    parts.push("        '(d) Phi-star formula calibrated against CLM v4 anchor 41.86; Llama Phi-star values NOT comparable to CLM v4 Phi-star values',\n")
    parts.push("        '(e) bootstrap N=1000 over 200/500-prompt sets is direction-only signal, not precise effect size; future cycle should use N=10000 over 1-2K prompts',\n")
    parts.push("    ],\n")
    parts.push("}\n")
    parts.push("os.makedirs(os.path.dirname(OUTPUT) or '.', exist_ok=True)\n")
    parts.push("with open(OUTPUT,'w') as f: json.dump(summary, f, indent=2, default=str)\n")
    parts.push("print(f'[cross-axis] cell={cell} reason={cell_reason} a_status={a_status} d_status={d_status} -> {OUTPUT}')\n")
    parts.push("print(f'  A: f1_v3={a_summary.get(\"f1_v3\")} label={a_summary.get(\"label\")} n_strong={a_summary.get(\"n_strong\")}')\n")
    parts.push("print(f'  D: verdict={d_summary.get(\"verdict\")} n_pass={d_summary.get(\"n_pass\")} f2_breach={d_summary.get(\"f2_floor_breach\")}')\n")
    parts.push("print(f'  Q3a: cls={q3a_summary.get(\"classification\")} rel_delta={q3a_summary.get(\"relative_delta\")}')\n")
    parts.push("print(f'  Q3b: cls={q3b_summary.get(\"classification\")} delta_acc_norm={q3b_summary.get(\"delta_acc_norm\")}')\n")

    write_file(HELPER_PATH, parts.join(""))
}

fn _selftest_invariants() -> bool {
    let n_research_questions = 3        // Q1 chat, Q2 phi-star, Q3 cross-substrate (3a + 3b)
    let n_matrix_cells = 4              // I, II, III, IV (UNDETERMINED is partial/error fallback)
    let n_cross_substrate_evals = 2     // Q3a (Path A on phi-star), Q3b (Path D on chat)
    let n_honest_c3 = 5                 // per spec sec.10
    let bootstrap_default_n = 1000
    println("inv:n_research_questions=" + to_string(n_research_questions))
    println("inv:n_matrix_cells=" + to_string(n_matrix_cells))
    println("inv:n_cross_substrate_evals=" + to_string(n_cross_substrate_evals))
    println("inv:n_honest_c3=" + to_string(n_honest_c3))
    println("inv:bootstrap_default_n=" + to_string(bootstrap_default_n))
    println("inv:matrix_cells=I_BOTH_AXES_LIVE,II_CHAT_LIVE_ONLY,III_PHI_LIVE_ONLY,IV_BOTH_NOISE")
    println("inv:undetermined_fallback=true")
    println("inv:q3a_pass_rel_delta_floor=-0.10")
    println("inv:q3a_marginal_rel_delta_floor=-0.30")
    println("inv:q3b_expected_band=0.02")
    println("inv:q3b_clm_v4_hellaswag_floor=0.242")
    println("inv:path_a_verdict_schema=anima/p9_a_prime_main_eval/verdict/1")
    println("inv:path_d_verdict_schema=anima/p9_paradigm_d_25k_eval/verdict/1")
    println("inv:cross_axis_verdict_schema=anima/p9_a_d_cross_axis/verdict/1")
    println("inv:reads_only_no_mutation=true")
    println("inv:f2_floor_breach_demotes_d_to_fail=true")
    println("inv:non_mutation_atlas=true")
    return true
}

fn cmd_selftest() {
    println("── p9_a_d_cross_axis_verdict selftest ──")
    _write_helper()
    let ok = _selftest_invariants()
    if !ok {
        println("selftest=fail")
        exit(2)
    }
    println("selftest=ok")
    println("helper_emitted=" + HELPER_PATH)
    println("paradigm=P9 A x D cross-axis 4-cell matrix synthesis (mac $0; non-mutating; reads A + D + Q3a + Q3b)")
    println("DONE")
}

fn main() {
    let av = argv()
    let mut selftest = false
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { selftest = true; i = i + 1; continue }
        i = i + 1
    }
    if selftest { cmd_selftest(); exit(0) }
    _write_helper()
    println("emitted=" + HELPER_PATH)
    println("DONE")
}
