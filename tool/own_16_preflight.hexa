// tool/own_16_preflight.hexa — own 16 BG launch prompt mechanical validator
//
// Role: heuristic substring-match validator that scans an H100 BG launch
//       prompt for the 6 mandatory own 16 checklist items (boot register,
//       heartbeat hook, trap pre-stop deregister, verdict.json schema,
//       L23 fail-fast, L25 escalation awareness) and emits a PASS/WARN/FAIL
//       verdict bound to a target_usd deviation policy.
//
// raw#9  hexa + bash carve-out OK (selftest only — no pod exec, no commit)
// raw#10 ≥5 honest C3 emitted by --selftest banner + stderr warnings
// raw#15 additive — does not modify h100_cost_watchdog / h100_register /
//        h100_alert_emit; convention → mechanical-enforcement promotion only
// .own 16 (compute-lifecycle) — Phase 3 convention → tool migration target
//
// USAGE
//   hexa run tool/own_16_preflight.hexa --selftest
//   hexa run tool/own_16_preflight.hexa --validate-prompt PATH
//   hexa run tool/own_16_preflight.hexa --validate-prompt-string "<text>"
//
// FLAGS
//   --target-usd N        override extracted target (required if cost ≥ $1
//                         and prompt does not declare it)
//
// EXIT
//   0  PASS  (all-mandatory items present OR target_usd=$0 optional band)
//   1  WARN  (mid-band $1..$4.99 with 4/6 items)
//   2  FAIL  (mandatory band $5+ with <6 items, OR mid-band with <4 items)
//   3  malformed args / IO failure

let DEFAULT_TEST_DIR = "/Users/ghost/core/anima/state/own_16_preflight_test_2026_05_05"

// ─── shell/io helpers ─────────────────────────────────────────────────────
fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sh_quote(p))[1] == 0
}
fn _ensure_dir(p: string) {
    exec_with_status("mkdir -p " + _sh_quote(p))
}
fn _ts_iso() -> string {
    return to_string(utc_iso_now())
}

// ─── argv parsing (positional + flag-with-value) ──────────────────────────
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── 6-item checklist signal detection ────────────────────────────────────
// Each item returns true when its required tokens appear anywhere in the
// prompt. Substring-match heuristic per honest_c3 below — semantic
// equivalence is NOT guaranteed.
fn _has_boot_register(p: string) -> bool {
    if p.contains("h100_register.bash") { return true }
    if p.contains("h100_cost_watchdog.hexa") && p.contains("--register") { return true }
    return false
}
fn _has_heartbeat_hook(p: string) -> bool {
    if p.contains("state/h100_watchdog/heartbeats") { return true }
    if p.contains("heartbeat") && p.contains("5min") { return true }
    if p.contains("heartbeat") && p.contains("5 min") { return true }
    return false
}
fn _has_trap_deregister(p: string) -> bool {
    if p.contains("--deregister") { return true }
    if p.contains("watchdog_deregistered") { return true }
    return false
}
fn _has_verdict_schema(p: string) -> bool {
    if p.contains("pod_kill_verified_404") && p.contains("watchdog_deregistered") { return true }
    return false
}
fn _has_l23_failfast(p: string) -> bool {
    if p.contains("L23") { return true }
    if p.contains("rate-limit-fallback") { return true }
    if p.contains("foreground takeover") { return true }
    if p.contains("rate-limit fallback") { return true }
    return false
}
fn _has_l25_escalation(p: string) -> bool {
    if p.contains("L25") { return true }
    if p.contains("cost-overrun escalation") { return true }
    if p.contains("auto-pause") { return true }
    if p.contains("auto-PAUSE") { return true }
    return false
}

// ─── target_usd extraction ────────────────────────────────────────────────
// Heuristic regex-light scan. Honest_c3#5: thresholds are heuristic.
// Patterns recognized (case-sensitive substring + adjacency):
//   "$5 target" / "$5 H100" / "$1.5 target"
//   "target_usd: 5" / "target_usd: 5.0" / "target_usd=5"
//   "--target-usd 5"
//   "target_usd ≥ $5" / "cost ≥ $5"
//
// Returns -1.0 sentinel when no target can be parsed.
fn _extract_target_usd(p: string) -> float {
    // 1) explicit override flag-style "--target-usd N"
    let idx_flag = p.find("--target-usd")
    if idx_flag >= 0 {
        let tail = p.substring(idx_flag + 13, len(p))  // "--target-usd " is 13 chars
        let tok = _scan_first_number(tail)
        if tok != "" { return to_float(tok) }
    }

    // 2) "target_usd" key (allow ":" / "=" / whitespace)
    let idx_key = p.find("target_usd")
    if idx_key >= 0 {
        let tail2 = p.substring(idx_key + 10, len(p))
        let tok2 = _scan_first_number(tail2)
        if tok2 != "" { return to_float(tok2) }
    }

    // 3) "$N target" or "$N H100" pattern — scan all "$" occurrences
    let mut cur = 0
    while cur < len(p) {
        let pos = p.substring(cur, len(p)).find("$")
        if pos < 0 { break }
        let abs_pos = cur + pos
        let tail3 = p.substring(abs_pos + 1, len(p))
        let tok3 = _scan_first_number(tail3)
        if tok3 != "" {
            // peek next 30 chars for "target" or "H100" qualifier
            let qstart = abs_pos + 1 + len(tok3)
            let qend = qstart + 40
            let q_qend = if qend < len(p) { qend } else { len(p) }
            let qslice = p.substring(qstart, q_qend)
            if qslice.contains("target") || qslice.contains("H100") || qslice.contains("budget") {
                return to_float(tok3)
            }
        }
        cur = abs_pos + 1
    }

    return -1.0
}

// Scan the leading numeric token (possibly with one decimal) from a string,
// skipping a single leading colon/equals/space/dollar prefix.
fn _scan_first_number(s: string) -> string {
    let mut i = 0
    // skip leading separator chars
    while i < len(s) {
        let ch = s.substring(i, i + 1)
        if ch == " " || ch == ":" || ch == "=" || ch == "$" || ch == "\t" { i = i + 1 }
        else { break }
    }
    let mut start = i
    let mut seen_digit = false
    let mut seen_dot = false
    while i < len(s) {
        let ch2 = s.substring(i, i + 1)
        if ch2 == "0" || ch2 == "1" || ch2 == "2" || ch2 == "3" || ch2 == "4" ||
           ch2 == "5" || ch2 == "6" || ch2 == "7" || ch2 == "8" || ch2 == "9" {
            seen_digit = true
            i = i + 1
        } else {
            if ch2 == "." && !seen_dot && seen_digit {
                seen_dot = true
                i = i + 1
            } else {
                break
            }
        }
    }
    if !seen_digit { return "" }
    return s.substring(start, i)
}

// ─── deviation policy ─────────────────────────────────────────────────────
// score 0..6 = number of mandatory items present
// target_usd ≥ 5  → ALL 6 mandatory → require score == 6
// target_usd ≥ 1  → strongly recommended → score ≥ 5 PASS, 4 WARN, <4 FAIL
// target_usd = 0  → optional → always PASS
// target_usd < 0 (sentinel: not declared) → treat as MID-BAND (≥1 caution)
fn _verdict_for(target_usd: float, score: int) -> string {
    if target_usd >= 5.0 {
        if score == 6 { return "PASS" }
        return "FAIL"
    }
    if target_usd >= 1.0 || target_usd < 0.0 {
        if score >= 5 { return "PASS" }
        if score == 4 { return "WARN" }
        return "FAIL"
    }
    // target_usd == 0 (or 0.0..0.99) → optional
    return "PASS"
}

fn _exit_for_verdict(v: string) -> int {
    if v == "PASS" { return 0 }
    if v == "WARN" { return 1 }
    return 2
}

// ─── core validation routine ──────────────────────────────────────────────
fn _validate(prompt_text: string, override_target: float) -> int {
    let i1 = _has_boot_register(prompt_text)
    let i2 = _has_heartbeat_hook(prompt_text)
    let i3 = _has_trap_deregister(prompt_text)
    let i4 = _has_verdict_schema(prompt_text)
    let i5 = _has_l23_failfast(prompt_text)
    let i6 = _has_l25_escalation(prompt_text)

    let mut score = 0
    if i1 { score = score + 1 }
    if i2 { score = score + 1 }
    if i3 { score = score + 1 }
    if i4 { score = score + 1 }
    if i5 { score = score + 1 }
    if i6 { score = score + 1 }

    let target = if override_target >= 0.0 {
        override_target
    } else {
        _extract_target_usd(prompt_text)
    }

    let mut missing = []
    if !i1 { missing = push(missing, "boot_register") }
    if !i2 { missing = push(missing, "heartbeat_hook") }
    if !i3 { missing = push(missing, "trap_deregister") }
    if !i4 { missing = push(missing, "verdict_schema") }
    if !i5 { missing = push(missing, "l23_failfast") }
    if !i6 { missing = push(missing, "l25_escalation") }

    let verdict = _verdict_for(target, score)

    // pretty-print missing-list
    let mut miss_str = "["
    let mut mi = 0
    while mi < len(missing) {
        if mi > 0 { miss_str = miss_str + "," }
        miss_str = miss_str + to_string(missing[mi])
        mi = mi + 1
    }
    miss_str = miss_str + "]"

    println("__OWN_16_PREFLIGHT__ " + verdict + " score=" + to_string(score) + "/6 missing=" + miss_str + " target_usd=" + to_string(target))

    // honest_c3 (raw#10) — emitted to STDERR so caller pipelines stay clean
    eprintln("honest_c3:")
    eprintln("  C1: validator is heuristic substring-match (raw#9 hexa) — semantic equivalence not guaranteed")
    eprintln("  C2: future BG prompts may use different phrasing for same intent — false-FAIL possible")
    eprintln("  C3: deviation policy thresholds heuristic ($5 mandatory / $1 recommended / $0 optional)")
    eprintln("  C4: target_usd extraction is regex-light scan; multi-budget prompts pick first match only")
    eprintln("  C5: L25/L23 detection by token presence — prose-disclosure depth not measured")
    eprintln("  C6: PASS does not guarantee runtime watchdog registration succeeded — only prompt declares intent")

    return _exit_for_verdict(verdict)
}

fn _validate_file(path: string, override_target: float) -> int {
    if !_file_exists(path) {
        eprintln("own_16_preflight: prompt file not found: " + path)
        return 3
    }
    let body = read_file(path)
    return _validate(body, override_target)
}

// ─── selftest harness (3 scenarios) ───────────────────────────────────────
fn _scenario_full_pass() -> string {
    let mut s = "# H100 BG launch prompt — full PASS scenario\n"
    s = s + "target_usd: 5.0\n"
    s = s + "Item 1 (boot): bash $REPO_ROOT/tool/h100_register.bash POD_ID BG_LANE TARGET_USD\n"
    s = s + "Item 2 (heartbeat): touch state/h100_watchdog/heartbeats/$BG_LANE.txt every 5 min\n"
    s = s + "Item 3 (deregister): hexa run tool/h100_cost_watchdog.hexa --deregister POD_ID\n"
    s = s + "Item 4 (verdict): pod_kill_verified_404 + watchdog_deregistered + cost_target_usd + cost_actual_usd\n"
    s = s + "Item 5 (L23 fail-fast): rate-limit-fallback foreground takeover with copy-pasteable rescue command\n"
    s = s + "Item 6 (L25): cost-overrun escalation auto-pause ladder via h100_idle_auto_killer.hexa\n"
    return s
}

fn _scenario_partial_fail() -> string {
    let mut s = "# H100 BG launch prompt — partial FAIL scenario at five-dollar mandatory band\n"
    s = s + "target_usd: 5.0\n"
    s = s + "Item 1 (boot): bash $REPO_ROOT/tool/h100_register.bash POD_ID BG_LANE TARGET_USD\n"
    s = s + "Item 2 (heartbeat): touch state/h100_watchdog/heartbeats/$BG_LANE.txt\n"
    s = s + "Item 3 (deregister): hexa run tool/h100_cost_watchdog.hexa --deregister POD_ID\n"
    s = s + "Item 4 (verdict): pod_kill_verified_404 + watchdog_deregistered\n"
    s = s + "(items five and six intentionally absent for partial-fail negative test)\n"
    return s
}

fn _scenario_zero_cost_optional() -> string {
    let mut s = "# Mac-substrate $0 BG — own 16 not applicable\n"
    s = s + "target_usd: 0\n"
    s = s + "This BG runs purely on mac, no GPU pod.\n"
    s = s + "No watchdog registration required (own 16 optional band).\n"
    return s
}

fn _selftest() -> int {
    println("── own_16_preflight selftest " + _ts_iso() + " ──")

    let test_dir = DEFAULT_TEST_DIR
    _ensure_dir(test_dir)

    let p1 = test_dir + "/scenario_full_pass.txt"
    let p2 = test_dir + "/scenario_partial_fail.txt"
    let p3 = test_dir + "/scenario_zero_cost_optional.txt"

    write_file(p1, _scenario_full_pass())
    write_file(p2, _scenario_partial_fail())
    write_file(p3, _scenario_zero_cost_optional())

    let mut passes = 0
    let mut fails  = 0

    // S1: full PASS expected exit 0
    println("")
    println("[S1] full PASS scenario")
    let rc1 = _validate(_scenario_full_pass(), -1.0)
    if rc1 == 0 { println("  S1 PASS (exit=0 verdict=PASS)"); passes = passes + 1 }
    else { println("  S1 FAIL (exit=" + to_string(rc1) + ", expected 0)"); fails = fails + 1 }

    // S2: partial FAIL expected exit 2
    println("")
    println("[S2] partial FAIL scenario (4/6 at $5 mandatory)")
    let rc2 = _validate(_scenario_partial_fail(), -1.0)
    if rc2 == 2 { println("  S2 PASS (exit=2 verdict=FAIL as expected)"); passes = passes + 1 }
    else { println("  S2 FAIL (exit=" + to_string(rc2) + ", expected 2)"); fails = fails + 1 }

    // S3: $0 optional expected exit 0
    println("")
    println("[S3] $0 optional band scenario")
    let rc3 = _validate(_scenario_zero_cost_optional(), -1.0)
    if rc3 == 0 { println("  S3 PASS (exit=0 verdict=PASS — optional band)"); passes = passes + 1 }
    else { println("  S3 FAIL (exit=" + to_string(rc3) + ", expected 0)"); fails = fails + 1 }

    println("")
    println("own_16_preflight selftest: " + to_string(passes) + "/3 PASS, " + to_string(fails) + " FAIL")
    println("scenarios persisted to: " + test_dir)

    if fails > 0 { return 1 }
    return 0
}

// ─── entry ────────────────────────────────────────────────────────────────
fn main() -> int {
    let av = _argv()
    if _flag(av, "--help") || _flag(av, "-h") {
        println("usage: hexa run tool/own_16_preflight.hexa [--selftest|--validate-prompt PATH|--validate-prompt-string \"<text>\"] [--target-usd N]")
        return 0
    }

    if _flag(av, "--selftest") { return _selftest() }

    // override target_usd parse
    let tgt_str = _opt(av, "--target-usd", "")
    let override_target = if tgt_str == "" { -1.0 } else { to_float(tgt_str) }

    if _flag(av, "--validate-prompt") {
        let path = _opt(av, "--validate-prompt", "")
        if path == "" { eprintln("own_16_preflight: --validate-prompt requires PATH"); return 3 }
        return _validate_file(path, override_target)
    }

    if _flag(av, "--validate-prompt-string") {
        let s = _opt(av, "--validate-prompt-string", "")
        if s == "" { eprintln("own_16_preflight: --validate-prompt-string requires a non-empty string"); return 3 }
        return _validate(s, override_target)
    }

    eprintln("own_16_preflight: no mode flag — use --selftest, --validate-prompt PATH, or --validate-prompt-string")
    return 3
}
