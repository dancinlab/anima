// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_chat_hexa_smoke.hexa — anima_chat.hexa port smoke (F-AC-HEXA-1..6)
//
//  PURPOSE
//    Independent smoke harness for the anima_chat.hexa port. Mirrors the
//    Python anima_chat._smoke() subset that does NOT depend on bound model
//    weights (those require RFC 025/031 mmap + tensor-name header parse,
//    which is TODO[load] inside anima_chat.hexa).
//
//    Behavior matches the in-file _smoke() main entry — this file lets a
//    CI cycle run the harness in isolation without invoking the AnimaChat
//    record's ckpt-open path.
//
//  RUN
//    /Users/ghost/core/hexa-lang/hexa parse anima/tool/anima_chat_hexa_smoke.hexa
//    /Users/ghost/core/hexa-lang/hexa run   anima/tool/anima_chat_hexa_smoke.hexa
//
//  EXPECTED OUTPUT
//    "F-AC-HEXA SMOKE PASS  (N/N)" where N == 13 (the 6 grouped falsifiers
//    expand to 13 individual asserts; see body).
//
//  FALSIFIERS REPLICATED (anima_chat.hexa header §FALSIFIERS)
//    F-AC-HEXA-1 PARSE          (verified by `hexa parse` exit code; smoke
//                                does not re-check)
//    F-AC-HEXA-2 HELPERS        (8 asserts — interrogative + segment +
//                                markdown filter + stop detect)
//    F-AC-HEXA-3 TOKENIZER      (3 asserts — ASCII + Hangul + emoji RT)
//    F-AC-HEXA-4 FORCE-KEYWORD  (2 asserts — single noun + compound noun)
//    F-AC-HEXA-5 MARKDOWN BAN-SET (1 assert — ban-set token ids)
//    F-AC-HEXA-6 SMOKE-MAIN     (this harness exits 0 == PASS)
// ════════════════════════════════════════════════════════════════════════════


// ── Helpers replicated locally so this smoke file does not need an import.
// ── (hexa interp/AOT does not auto-resolve sibling .hexa files at the moment;
// ──  the port's logic is small enough that we mirror the entry points here.)


fn tok_bos() -> int { return 1 }
fn tok_eos() -> int { return 2 }
fn tok_pad() -> int { return 0 }
fn tok_offset() -> int { return 3 }

fn tok_encode(text: string) {
    let mut ids = []
    ids.push(tok_bos())
    let n = len(text)
    let mut i = 0
    while i < n {
        let b = char_code(text, i) & 0xFF
        ids.push(b + tok_offset())
        i = i + 1
    }
    ids.push(tok_eos())
    return ids
}

fn tok_decode_bytes(ids) {
    let n = len(ids)
    let mut out = []
    let mut i = 0
    while i < n {
        let id = ids[i]
        if id != tok_pad() && id != tok_bos() && id != tok_eos() {
            let b = id - tok_offset()
            if b >= 0 && b < 256 {
                out.push(b)
            }
        }
        i = i + 1
    }
    return out
}

fn tok_decode_str(ids) -> string {
    return bytes_to_str_raw(tok_decode_bytes(ids))
}

fn _list_contains(xs, item: string) -> bool {
    let n = len(xs)
    let mut i = 0
    while i < n {
        if xs[i] == item { return true }
        i = i + 1
    }
    return false
}

fn _list_contains_int(xs, item: int) -> bool {
    let n = len(xs)
    let mut i = 0
    while i < n {
        if xs[i] == item { return true }
        i = i + 1
    }
    return false
}

fn heuristic_skip_set() {
    let mut s = []
    s.push("있어"); s.push("있나"); s.push("있어요"); s.push("뭐야")
    s.push("뭐였지"); s.push("어떻게"); s.push("어디"); s.push("무엇")
    s.push("누구"); s.push("누구야"); s.push("왜"); s.push("언제")
    s.push("사용자"); s.push("도우미"); s.push("안녕"); s.push("안녕하세요")
    s.push("그래"); s.push("그게"); s.push("그것")
    return s
}

fn interrogative_tails() {
    let mut t = []
    t.push("야"); t.push("어"); t.push("지"); t.push("까")
    t.push("니"); t.push("뭐"); t.push("워")
    return t
}

fn noun_whitelist() {
    let mut w = []
    w.push("사랑"); w.push("이름"); w.push("기분"); w.push("안녕")
    w.push("우주"); w.push("철학")
    return w
}

fn ends_with_str(haystack: string, needle: string) -> bool {
    let hl = len(haystack)
    let nl = len(needle)
    if nl > hl { return false }
    let offset = hl - nl
    let mut i = 0
    while i < nl {
        if char_code(haystack, offset + i) != char_code(needle, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn looks_like_interrogative(token: string) -> bool {
    if len(token) == 0 { return true }
    let skip = heuristic_skip_set()
    if _list_contains(skip, token) { return true }
    let blen = len(token)
    if blen <= 9 {
        let tails = interrogative_tails()
        let nt = len(tails)
        let mut i = 0
        while i < nt {
            if ends_with_str(token, tails[i]) {
                let nouns = noun_whitelist()
                if _list_contains(nouns, token) { return false }
                return true
            }
            i = i + 1
        }
    }
    return false
}

fn str_contains(haystack: string, needle: string) -> bool {
    let hl = len(haystack)
    let nl = len(needle)
    if nl == 0 { return true }
    if nl > hl { return false }
    let limit = hl - nl
    let mut i = 0
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < nl {
            if char_code(haystack, i + j) != char_code(needle, j) {
                ok = false
                j = nl
            } else {
                j = j + 1
            }
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

fn last_user_segment(prompt: string) -> string {
    let marker = "사용자:"
    let pl = len(prompt)
    let ml = len(marker)
    let mut last_match = -1
    let mut i = 0
    let limit = pl - ml
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < ml {
            if char_code(prompt, i + j) != char_code(marker, j) {
                ok = false; j = ml
            } else { j = j + 1 }
        }
        if ok { last_match = i }
        i = i + 1
    }
    if last_match < 0 { return prompt }
    let mut start = last_match + ml
    while start < pl && char_code(prompt, start) == 32 { start = start + 1 }
    let mut end = pl
    let mut k = start
    while k < pl {
        if char_code(prompt, k) == 124 { end = k; k = pl }
        else { k = k + 1 }
    }
    return prompt.substring(start, end)
}

fn last_assistant_segment(prompt: string) -> string {
    let marker = "도우미:"
    let pl = len(prompt)
    let ml = len(marker)
    let mut matches = []
    let mut i = 0
    let limit = pl - ml
    while i <= limit {
        let mut j = 0
        let mut ok = true
        while j < ml {
            if char_code(prompt, i + j) != char_code(marker, j) {
                ok = false; j = ml
            } else { j = j + 1 }
        }
        if ok { matches.push(i) }
        i = i + 1
    }
    let nm = len(matches)
    let mut idx = nm - 1
    while idx >= 0 {
        let pos = matches[idx]
        let mut start = pos + ml
        while start < pl && char_code(prompt, start) == 32 { start = start + 1 }
        let mut end = pl
        let mut k = start
        while k < pl {
            if char_code(prompt, k) == 124 { end = k; k = pl }
            else { k = k + 1 }
        }
        let seg = prompt.substring(start, end)
        let mut sl = len(seg)
        let mut tail = sl
        while tail > 0 && char_code(seg, tail - 1) == 32 { tail = tail - 1 }
        let trimmed = seg.substring(0, tail)
        if len(trimmed) > 0 { return trimmed }
        idx = idx - 1
    }
    return ""
}

fn is_hangul_first_byte(b: int) -> bool {
    return b == 0xEA || b == 0xEB || b == 0xEC || b == 0xED
}

fn is_cont_byte(b: int) -> bool {
    return b >= 0x80 && b < 0xC0
}

fn hangul_chunks(text: string) {
    let n = len(text)
    let mut out = []
    let mut i = 0
    while i < n {
        let b = char_code(text, i) & 0xFF
        if is_hangul_first_byte(b) && i + 2 < n {
            let b1 = char_code(text, i + 1) & 0xFF
            let b2 = char_code(text, i + 2) & 0xFF
            if is_cont_byte(b1) && is_cont_byte(b2) {
                let start = i
                let mut k = i
                let mut running = true
                while running {
                    let kb = char_code(text, k) & 0xFF
                    if k + 2 < n && is_hangul_first_byte(kb)
                            && is_cont_byte(char_code(text, k + 1) & 0xFF)
                            && is_cont_byte(char_code(text, k + 2) & 0xFF) {
                        k = k + 3
                    } else { running = false }
                    if k >= n { running = false }
                }
                let chunk = text.substring(start, k)
                if len(chunk) >= 6 { out.push(chunk) }
                i = k
            } else { i = i + 1 }
        } else { i = i + 1 }
    }
    return out
}

fn extract_force_keywords(prompt: string, max_keywords: int, include_prior_assistant: bool) {
    let user_seg = last_user_segment(prompt)
    let mut sources = []
    sources.push(user_seg)
    if include_prior_assistant {
        let assist_seg = last_assistant_segment(prompt)
        if len(assist_seg) > 0 { sources.push(assist_seg) }
    }
    let ns = len(sources)
    let mut collected = []
    let mut si = 0
    while si < ns {
        let chunks = hangul_chunks(sources[si])
        let nc = len(chunks)
        let mut ci = 0
        while ci < nc {
            let c = chunks[ci]
            if !looks_like_interrogative(c) { collected.push(c) }
            ci = ci + 1
        }
        si = si + 1
    }
    let mut seen = []
    let mut dedup = []
    let cn = len(collected)
    let mut i = 0
    while i < cn {
        let w = collected[i]
        if !_list_contains(seen, w) {
            seen.push(w); dedup.push(w)
        }
        i = i + 1
    }
    let dn = len(dedup)
    let mut a = 0
    while a < dn {
        let mut b = a + 1
        while b < dn {
            if len(dedup[b]) > len(dedup[a]) {
                let tmp = dedup[a]; dedup[a] = dedup[b]; dedup[b] = tmp
            }
            b = b + 1
        }
        a = a + 1
    }
    if len(dedup) == 0 { return [] }
    let mut out = []
    let mn = if max_keywords < len(dedup) { max_keywords } else { len(dedup) }
    let mut j = 0
    while j < mn { out.push(dedup[j]); j = j + 1 }
    return out
}

fn markdown_table_triggers() {
    let mut t = []
    t.push("| --- "); t.push("| ---|"); t.push("|---"); t.push("| :--")
    t.push("|:--"); t.push("| :-:"); t.push("|---|"); t.push("\n| ")
    return t
}

fn markdown_ban_byte_ids() {
    let chars = "|-: "
    let n = len(chars)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(char_code(chars, i) & 0xFF)
        i = i + 1
    }
    return out
}

fn markdown_ban_token_ids() {
    let bs = markdown_ban_byte_ids()
    let n = len(bs)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(bs[i] + tok_offset())
        i = i + 1
    }
    return out
}

fn markdown_attractor_active(decoded_tail: string) -> bool {
    if len(decoded_tail) == 0 { return false }
    let triggers = markdown_table_triggers()
    let n = len(triggers)
    let mut i = 0
    while i < n {
        if str_contains(decoded_tail, triggers[i]) { return true }
        i = i + 1
    }
    return false
}

fn _is_separator_byte(b: int) -> bool {
    if b == 32 || b == 9 || b == 10 || b == 13 { return true }
    if b == 45 || b == 58 || b == 124 { return true }
    return false
}

fn post_strip_markdown_tables(text: string) -> string {
    let n = len(text)
    if n == 0 { return text }
    let mut i = 0
    while i < n {
        let mut p = i
        if char_code(text, p) == 10 { p = p + 1 }
        if p < n && char_code(text, p) == 124 {
            let mut q = p + 1
            let mut k = 0
            while q < n {
                let b = char_code(text, q) & 0xFF
                if _is_separator_byte(b) { k = k + 1; q = q + 1 }
                else { q = n }
            }
            if k >= 2 {
                let mut tail = i
                while tail > 0 && char_code(text, tail - 1) == 32 { tail = tail - 1 }
                return text.substring(0, tail)
            }
        }
        i = i + 1
    }
    return text
}

fn default_stop_strings() {
    let mut s = []
    s.push("사용자:"); s.push("User:"); s.push("\n사용자"); s.push("\nUser")
    return s
}

fn detect_stop(decoded_so_far: string, stops) -> bool {
    let n = len(stops)
    let mut i = 0
    while i < n {
        let s = stops[i]
        if len(s) > 0 && str_contains(decoded_so_far, s) { return true }
        i = i + 1
    }
    return false
}


// ── Test reporting harness ──

let mut g_pass = 0
let mut g_total = 0
let mut g_first_fail = ""

fn check(name: string, cond: bool) {
    g_total = g_total + 1
    if cond {
        g_pass = g_pass + 1
        println("  PASS  " + name)
    } else {
        if g_first_fail == "" { g_first_fail = name }
        println("  FAIL  " + name)
    }
}


fn main() {
    println("================================================================")
    println("anima_chat.hexa smoke — F-AC-HEXA-1..6")
    println("================================================================")

    // F-AC-HEXA-3 TOKENIZER round-trip
    let h_ids = tok_encode("hello")
    let h_back = tok_decode_str(h_ids)
    check("F-AC-HEXA-3a tokenizer round-trip (hello)", h_back == "hello")
    let k_ids = tok_encode("안녕")
    let k_back = tok_decode_str(k_ids)
    check("F-AC-HEXA-3b tokenizer round-trip (안녕)", k_back == "안녕")
    let e_ids = tok_encode("🌌")
    let e_back = tok_decode_str(e_ids)
    check("F-AC-HEXA-3c tokenizer round-trip (🌌)", e_back == "🌌")

    // F-AC-HEXA-2 HELPERS — interrogative
    check("F-AC-HEXA-2a looks_like_interrogative(뭐야)",
          looks_like_interrogative("뭐야"))
    check("F-AC-HEXA-2b looks_like_interrogative(사랑) == false",
          !looks_like_interrogative("사랑"))
    check("F-AC-HEXA-2c looks_like_interrogative(\"\") == true",
          looks_like_interrogative(""))
    check("F-AC-HEXA-2d looks_like_interrogative(우주뇌지도) == false",
          !looks_like_interrogative("우주뇌지도"))

    // F-AC-HEXA-2 HELPERS — segment parse
    // NOTE: Python regex `사용자:\s*([^|]+)` keeps trailing whitespace before
    // the `|`. We match that behavior — segment is "안녕! " not "안녕!".
    check("F-AC-HEXA-2e last_user_segment basic (Python-parity trailing space)",
          last_user_segment("사용자: 안녕! | 도우미: ") == "안녕! ")
    check("F-AC-HEXA-2f last_assistant_segment skips trailing empty",
          last_assistant_segment("사용자: a | 도우미: 반가워! | 사용자: b | 도우미: ") == "반가워!")

    // F-AC-HEXA-2 HELPERS — markdown filter
    check("F-AC-HEXA-2g markdown_attractor_active(| --- )",
          markdown_attractor_active("| --- "))
    check("F-AC-HEXA-2h markdown_attractor_active(안녕) == false",
          !markdown_attractor_active("안녕"))
    let stripped = post_strip_markdown_tables("정상 답변\n| --- | --- |\n| a | b |")
    check("F-AC-HEXA-2i post_strip cuts table fragment",
          stripped == "정상 답변")

    // F-AC-HEXA-2 STOP detection
    check("F-AC-HEXA-2j detect_stop catches 사용자: in tail",
          detect_stop("아 그렇구나. 사용자:", default_stop_strings()))
    check("F-AC-HEXA-2k detect_stop ignores plain text",
          !detect_stop("아 그렇구나.", default_stop_strings()))

    // F-AC-HEXA-4 FORCE-KEYWORD
    // TODO[okt]: without KoNLPy POS, "사랑이" stays attached to the
    // particle "이" — Python fallback path (when Okt is unavailable)
    // produces the exact same result, so we match THAT (not the
    // Okt-on result of ["사랑"]).
    let kws1 = extract_force_keywords("사용자: 사랑이 뭐야? | 도우미: ", 1, true)
    check("F-AC-HEXA-4a extract_force_keywords(사랑이 뭐야?) == [사랑이] (no-Okt fallback parity)",
          len(kws1) == 1 && kws1[0] == "사랑이")
    let kws2 = extract_force_keywords("사용자: 우주뇌지도 | 도우미: ", 1, true)
    check("F-AC-HEXA-4b extract_force_keywords(우주뇌지도) == [우주뇌지도]",
          len(kws2) == 1 && kws2[0] == "우주뇌지도")

    // F-AC-HEXA-5 MARKDOWN BAN-SET token ids
    let bans = markdown_ban_token_ids()
    let bans_ok = len(bans) == 4
        && _list_contains_int(bans, 127)
        && _list_contains_int(bans, 48)
        && _list_contains_int(bans, 61)
        && _list_contains_int(bans, 35)
    check("F-AC-HEXA-5 markdown_ban_token_ids = {127, 48, 61, 35}", bans_ok)

    println("")
    println("----------------------------------------------------------------")
    println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed")
    if g_pass == g_total {
        println("F-AC-HEXA SMOKE PASS  (" + to_string(g_pass) + "/" + to_string(g_total) + ")")
    } else {
        println("F-AC-HEXA SMOKE FAIL  first_fail=" + g_first_fail)
    }
    println("================================================================")
}
