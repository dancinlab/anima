// tool/path_a_r64_completion_watchdog.hexa — Path A r=64 A' main eval completion watchdog (raw#9 hexa-only Mac).
//
// PURPOSE
//   Polls (every 5 min, max 90 min) for Path A r=64 main-eval completion via signal:
//     - ssh ubu1: count of ~/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results/*.json
//       must equal expected total (3 tasks × N ckpts)
//
//   GUARD-3 (success-signal checklist): file existence != success. Each candidate signal must
//     - count(*.json) == expected_total
//     - "ALL DONE" marker visible in eval_run.log tail (corroborating signal)
//
//   AUDIT-NOTE (raw#10 honest C3 (a)):
//     Original prompt assumed 5 ckpts × 3 tasks = 15 evals (step-2000..step-10000).
//     Ground truth (HF list_repo_commits 2026-05-04): only 4 ckpts uploaded
//     (step-2000/4000/6000/8000). Hub_strategy=every_save committed to main; no step-10000
//     because training stopped at step-8000 OR upload-after-step-10000 never landed.
//     Default expected_total = 12 (4 ckpts × 3 tasks). Override via ANIMA_EXPECTED_TOTAL env.
//
//   On trigger fire (count >= expected_total):
//     1. scp ubu1:~/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results/*.json
//        -> /Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_lora_results/
//     2. hexa run tool/p9_a_prime_verdict.hexa -> F1_v3 composite verdict JSON
//     3. Save r=64 baseline reference (state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json)
//        for later r=16 mitigation comparison
//     4. If state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json exists -> cross-axis verdict
//     5. Land marker
//
// USAGE
//   hexa run tool/path_a_r64_completion_watchdog.hexa --selftest          # invariants check
//   hexa run tool/path_a_r64_completion_watchdog.hexa --once               # single poll, no loop
//   hexa run tool/path_a_r64_completion_watchdog.hexa --apply              # fire pipeline on hit (default DRY)
//   hexa run tool/path_a_r64_completion_watchdog.hexa --loop --apply       # full 90 min watchdog
//
// CONFIG (env overrides)
//   ANIMA_R64_REMOTE_RESULTS  default: /home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results
//   ANIMA_R64_LOCAL_RESULTS   default: /Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_lora_results
//   ANIMA_EXPECTED_TOTAL      default: 12  (4 ckpts × 3 tasks; bump to 15 if step-10000 lands)
//   ANIMA_R64_LOG_TAIL_PATH   default: /home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03/eval_run.log
//   ANIMA_R64_VERDICT_OUT     default: /Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_verdict.json
//   ANIMA_R64_BASELINE_OUT    default: /Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json
//   ANIMA_D_VERDICT           default: /Users/ghost/core/anima/state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json
//   ANIMA_POLL_INTERVAL_SEC   default: 300 (5 min)
//   ANIMA_MAX_WAIT_SEC        default: 5400 (90 min)
//   ANIMA_LOG_PATH            default: state/p9_a_prime_main_eval_pipeline_2026_05_03/r64_watchdog_log.jsonl
//   ANIMA_DISPATCH_PATH       default: state/p9_a_prime_main_eval_pipeline_2026_05_03/r64_eval_dispatch.json
//
// EXIT CODES
//   0 = trigger fired + dispatch attempted (apply) OR loop completed without trigger (timeout)
//       OR --once finished
//   1 = selftest fail
//   2 = config error / unrecoverable env issue
//
// raw#9  hexa-only Mac          (ssh/scp shelled out via exec_with_status)
// raw#15 SSOT this file         (this hexa is single source for r=64 completion trigger)
// raw#10 honest C3:
//   (a) expected_total=12 reflects HF audit (only 4 ckpts on hub). If user expected 15 (step-10000),
//       step-10000 is MISSING — bump ANIMA_EXPECTED_TOTAL=15 only after confirming new commit lands.
//   (b) verdict computation requires base_per_example_correctness.json present locally; pipeline
//       fetches it from state/p9_a_prime_main_eval_pipeline_2026_05_03/.
//   (c) Cross-axis verdict requires Path D 25K verdict ALSO present. If absent, SKIPPED;
//       rerun manually after Path D verdict lands.
//   (d) r64_baseline.json is a thin alias/copy of verdict.json with explicit r64_lock metadata
//       — used as anchor in r=16 mitigation comparison (per path_a_r16 watchdog spec).

let LOG_PATH_DEFAULT      = "/Users/ghost/core/anima/state/p9_a_prime_main_eval_pipeline_2026_05_03/r64_watchdog_log.jsonl"
let DISPATCH_PATH_DEFAULT = "/Users/ghost/core/anima/state/p9_a_prime_main_eval_pipeline_2026_05_03/r64_eval_dispatch.json"
let NOTIFY_PATH           = "/Users/ghost/core/anima/state/p9_a_prime_main_eval_pipeline_2026_05_03/r64_notify_payload.json"

// ─── helpers ───────────────────────────────────────────────────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _json_escape(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}
fn _ts_iso() -> string {
    let r = exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")
    return to_string(r[0]).trim()
}
fn _now_epoch() -> int {
    let r = exec_with_status("date -u +%s")
    return to_int(to_string(r[0]).trim())
}
fn _env_or(name: string, dflt: string) -> string {
    let r = exec_with_status("printf %s \"${" + name + ":-" + dflt + "}\"")
    return to_string(r[0])
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _has(av, k) -> bool {
    let mut i = 0
    while i < len(av) { if to_string(av[i]) == k { return true }; i = i + 1 }
    return false
}

// ─── append-only JSONL log ─────────────────────────────────────────────

fn _log(path: string, event: string, payload_json: string) {
    let line = "{\"ts_utc\":\"" + _ts_iso() + "\",\"event\":\"" + event + "\",\"payload\":" + payload_json + "}\n"
    let q = _sq(line)
    let dir_cmd = "mkdir -p " + _sq(path.replace("/r64_watchdog_log.jsonl", ""))
    exec_with_status(dir_cmd)
    exec_with_status("printf %s " + q + " >> " + _sq(path))
}

// ─── GUARD-3: count-based completion check ─────────────────────────────

fn _check_remote_count(remote_dir: string, expected: int) -> string {
    // ls *.json | wc -l (skip log_samples subdirs)
    let probe = "ssh -o ConnectTimeout=8 -o BatchMode=yes ubu1 " + _sq("ls -1 " + remote_dir + "/*.json 2>/dev/null | wc -l")
    let r = exec_with_status(probe)
    if r[1] != 0 { return "MISSING:ssh_rc_" + to_string(r[1]) }
    let n_str = to_string(r[0]).trim()
    if n_str == "" { return "PARSE_ERROR" }
    let n = to_int(n_str)
    if n >= expected { return "VALID:n_" + to_string(n) + "_geq_" + to_string(expected) }
    return "WAIT:n_" + to_string(n) + "_lt_" + to_string(expected)
}

fn _check_remote_marker(log_path: string) -> string {
    let probe = "ssh -o ConnectTimeout=8 -o BatchMode=yes ubu1 " + _sq("grep -c 'ALL DONE' " + log_path + " 2>/dev/null || echo 0")
    let r = exec_with_status(probe)
    if r[1] != 0 { return "MISSING:ssh_rc_" + to_string(r[1]) }
    let n_str = to_string(r[0]).trim()
    if n_str == "" { return "PARSE_ERROR" }
    let n = to_int(n_str)
    if n >= 1 { return "VALID:all_done_seen" }
    return "WAIT:no_marker"
}

// ─── single poll ─────────────────────────────────────────────────────

fn _poll_once(remote_dir: string, expected: int, log_tail: string, log_path: string) -> string {
    let s_count  = _check_remote_count(remote_dir, expected)
    let s_marker = _check_remote_marker(log_tail)

    let payload = "{\"count\":\"" + _json_escape(s_count) + "\",\"marker\":\"" + _json_escape(s_marker) + "\",\"expected\":" + to_string(expected) + "}"
    _log(log_path, "poll", payload)
    println("[watchdog] " + _ts_iso() + " count=" + s_count + " marker=" + s_marker)

    // Trigger if count >= expected (primary signal); marker is corroborating but not required
    if s_count.starts_with("VALID") { return "TRIGGER:COUNT:" + s_count }
    return "WAIT"
}

// ─── dispatch eval pipeline ──────────────────────────────────────────

fn _dispatch_eval(trigger_label: string, remote_dir: string, local_dir: string, verdict_out: string, baseline_out: string, d_verdict_path: string, dispatch_path: string, log_path: string, apply: bool) -> int {
    let dispatch_dir = dispatch_path.replace("/r64_eval_dispatch.json", "")
    exec_with_status("mkdir -p " + _sq(dispatch_dir))
    exec_with_status("mkdir -p " + _sq(local_dir))

    let mut steps = []
    let ts_start = _ts_iso()

    // Step 1: scp r=64 lora_results to Mac
    let scp_cmd = "scp ubu1:" + remote_dir + "/*.json " + local_dir + "/ 2>&1"
    let mut step1_rc = -1
    let mut step1_n = 0
    if apply {
        let r1 = exec_with_status(scp_cmd)
        step1_rc = r1[1]
        let count_r = exec_with_status("ls -1 " + _sq(local_dir) + "/*.json 2>/dev/null | wc -l")
        step1_n = to_int(to_string(count_r[0]).trim())
    }
    steps.push("{\"step\":1,\"name\":\"scp_r64_results\",\"rc\":" + to_string(step1_rc) + ",\"n_files\":" + to_string(step1_n) + ",\"applied\":" + (if apply { "true" } else { "false" }) + "}")

    // Step 2: hexa run p9_a_prime_verdict.hexa
    let verdict_cmd = "cd /Users/ghost/core/anima && " +
        "ANIMA_LORA_RESULTS_DIR=" + local_dir + " " +
        "ANIMA_OUTPUT=" + verdict_out + " " +
        "hexa run tool/p9_a_prime_verdict.hexa 2>&1 && " +
        "ANIMA_LORA_RESULTS_DIR=" + local_dir + " " +
        "ANIMA_OUTPUT=" + verdict_out + " " +
        "python3 /tmp/p9_a_prime_verdict_helper.py_tmp 2>&1"
    let mut step2_rc = -1
    let mut step2_n_ckpts = 0
    if apply && step1_rc == 0 {
        let r2 = exec_with_status(verdict_cmd)
        step2_rc = r2[1]
        // Read n_ckpts from emitted verdict
        let probe = "python3 -c 'import json; d=json.load(open(\"" + verdict_out + "\")); print(d.get(\"n_ckpts\", 0))' 2>/dev/null"
        let pr = exec_with_status(probe)
        if pr[1] == 0 {
            step2_n_ckpts = to_int(to_string(pr[0]).trim())
        }
    }
    steps.push("{\"step\":2,\"name\":\"f1_v3_verdict\",\"rc\":" + to_string(step2_rc) + ",\"n_ckpts\":" + to_string(step2_n_ckpts) + "}")

    // Step 3: Save r=64 baseline (copy of verdict + r64_lock metadata)
    let mut step3_rc = -1
    if apply && step2_rc == 0 {
        let baseline_helper = "/tmp/p9_a_prime_r64_baseline_helper.py_tmp"
        let parts = []
        parts.push("#!/usr/bin/env python3\n")
        parts.push("# r=64 baseline lock helper (raw#37 transient)\n")
        parts.push("import json, os, datetime, sys\n")
        parts.push("VERDICT='" + verdict_out + "'\n")
        parts.push("OUT='" + baseline_out + "'\n")
        parts.push("d = json.load(open(VERDICT))\n")
        parts.push("baseline = {\n")
        parts.push("  'schema': 'anima/p9_a_prime_main_eval/r64_baseline_lock/1',\n")
        parts.push("  'spec_ref': 'docs/p9_path_a_regression_mitigation_spec_2026_05_03.md (r=16 anchor)',\n")
        parts.push("  'lock_ts_utc': datetime.datetime.utcnow().isoformat() + 'Z',\n")
        parts.push("  'r64_lora_rank': 64,\n")
        parts.push("  'verdict_source': VERDICT,\n")
        parts.push("  'n_ckpts': d.get('n_ckpts', 0),\n")
        parts.push("  'thresholds': d.get('thresholds'),\n")
        parts.push("  'paired_bootstrap_n': d.get('paired_bootstrap_n'),\n")
        parts.push("  'seed': d.get('seed'),\n")
        parts.push("  'ckpt_verdicts': d.get('ckpt_verdicts'),\n")
        parts.push("  'ranking': d.get('ranking'),\n")
        parts.push("  'best_ckpt': (d.get('ranking') or [None])[0],\n")
        parts.push("  'note': 'This is the locked baseline for r=16 mitigation comparison; do not overwrite without re-locking.',\n")
        parts.push("}\n")
        parts.push("os.makedirs(os.path.dirname(OUT) or '.', exist_ok=True)\n")
        parts.push("with open(OUT, 'w') as f: json.dump(baseline, f, indent=2, default=str)\n")
        parts.push("print(f'[r64_baseline] locked n_ckpts={baseline[\"n_ckpts\"]} -> {OUT}')\n")
        write_file(baseline_helper, parts.join(""))
        let r3 = exec_with_status("python3 " + baseline_helper + " 2>&1")
        step3_rc = r3[1]
        println(to_string(r3[0]).trim())
    }
    steps.push("{\"step\":3,\"name\":\"r64_baseline_lock\",\"rc\":" + to_string(step3_rc) + ",\"path\":\"" + _json_escape(baseline_out) + "\"}")

    // Step 4: cross-axis (only if D verdict exists)
    let mut step4_rc = -1
    let mut step4_skip_reason = ""
    if apply && step2_rc == 0 {
        if _file_exists(d_verdict_path) {
            let cross_cmd = "cd /Users/ghost/core/anima && hexa run tool/p9_a_d_cross_axis_verdict.hexa 2>&1 && python3 /tmp/p9_a_d_cross_axis_verdict_helper.py_tmp 2>&1"
            let r4 = exec_with_status(cross_cmd)
            step4_rc = r4[1]
        } else {
            step4_skip_reason = "d_verdict_missing:" + d_verdict_path
        }
    }
    steps.push("{\"step\":4,\"name\":\"cross_axis\",\"rc\":" + to_string(step4_rc) + ",\"skip_reason\":\"" + _json_escape(step4_skip_reason) + "\"}")

    let ts_end = _ts_iso()
    let dispatch_json = "{\n" +
        "  \"schema\": \"anima/p9_a_prime_main_eval/r64_dispatch/1\",\n" +
        "  \"trigger\": \"" + _json_escape(trigger_label) + "\",\n" +
        "  \"applied\": " + (if apply { "true" } else { "false" }) + ",\n" +
        "  \"ts_start\": \"" + ts_start + "\",\n" +
        "  \"ts_end\": \"" + ts_end + "\",\n" +
        "  \"remote_dir\": \"" + _json_escape(remote_dir) + "\",\n" +
        "  \"local_dir\": \"" + _json_escape(local_dir) + "\",\n" +
        "  \"verdict_out\": \"" + _json_escape(verdict_out) + "\",\n" +
        "  \"baseline_out\": \"" + _json_escape(baseline_out) + "\",\n" +
        "  \"steps\": [" + steps.join(",") + "]\n" +
        "}\n"
    write_file(dispatch_path, dispatch_json)

    _log(log_path, "dispatch", "{\"trigger\":\"" + _json_escape(trigger_label) + "\",\"applied\":" + (if apply { "true" } else { "false" }) + ",\"step_rcs\":[" + to_string(step1_rc) + "," + to_string(step2_rc) + "," + to_string(step3_rc) + "," + to_string(step4_rc) + "]}")

    _emit_notify(trigger_label, step2_rc, step3_rc, step4_rc, step4_skip_reason)

    if !apply { return 0 }
    if step1_rc == 0 && step2_rc == 0 && step3_rc == 0 { return 0 }
    return 1
}

fn _emit_notify(trigger: string, verdict_rc: int, baseline_rc: int, cross_rc: int, cross_skip: string) {
    let v_status = if verdict_rc == 0 { "OK" } else { "RC=" + to_string(verdict_rc) }
    let b_status = if baseline_rc == 0 { "OK" } else { "RC=" + to_string(baseline_rc) }
    let c_status = if cross_rc == 0 {
        "OK"
    } else {
        if cross_skip != "" { "SKIPPED:" + cross_skip } else { "RC=" + to_string(cross_rc) }
    }
    let summary = "[r64-eval] trigger=" + trigger + " verdict=" + v_status + " baseline=" + b_status + " cross_axis=" + c_status
    let payload = "{\n" +
        "  \"ts_utc\": \"" + _ts_iso() + "\",\n" +
        "  \"summary\": \"" + _json_escape(summary) + "\",\n" +
        "  \"verdict_path\": \"state/p9_a_prime_main_eval_2026_05_03_verdict.json\",\n" +
        "  \"baseline_path\": \"state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json\",\n" +
        "  \"cross_axis_path\": \"state/p9_a_d_cross_axis_2026_05_03/cross_axis_verdict.json\",\n" +
        "  \"notify_channel\": \"stub_stage0_no_native_push\"\n" +
        "}\n"
    write_file(NOTIFY_PATH, payload)
    println("[notify] " + summary)
    println("[notify] payload at " + NOTIFY_PATH)
}

// ─── main loop ─────────────────────────────────────────────────────

fn _run_loop(remote_dir: string, expected: int, log_tail: string, local_dir: string, verdict_out: string, baseline_out: string, d_verdict_path: string, log_path: string, dispatch_path: string, poll_sec: int, max_wait_sec: int, apply: bool, single: bool) -> int {
    let t0 = _now_epoch()
    let mut elapsed = 0
    let mut iter = 0
    while elapsed <= max_wait_sec {
        iter = iter + 1
        let result = _poll_once(remote_dir, expected, log_tail, log_path)
        if result.starts_with("TRIGGER") {
            println("[watchdog] TRIGGER FIRED iter=" + to_string(iter) + " elapsed_sec=" + to_string(elapsed) + " label=" + result)
            _log(log_path, "trigger_fired", "{\"iter\":" + to_string(iter) + ",\"elapsed_sec\":" + to_string(elapsed) + ",\"label\":\"" + _json_escape(result) + "\"}")
            let rc = _dispatch_eval(result, remote_dir, local_dir, verdict_out, baseline_out, d_verdict_path, dispatch_path, log_path, apply)
            return rc
        }
        if single { return 0 }
        elapsed = _now_epoch() - t0
        if elapsed + poll_sec > max_wait_sec { break }
        exec_with_status("sleep " + to_string(poll_sec))
        elapsed = _now_epoch() - t0
    }
    println("[watchdog] TIMEOUT max_wait_sec=" + to_string(max_wait_sec) + " iter=" + to_string(iter))
    _log(log_path, "timeout", "{\"max_wait_sec\":" + to_string(max_wait_sec) + ",\"iter\":" + to_string(iter) + "}")
    return 0
}

// ─── selftest ─────────────────────────────────────────────────────

fn cmd_selftest() {
    println("── path_a_r64_completion_watchdog selftest ──")
    println("inv:default_poll_interval_sec=300")
    println("inv:default_max_wait_sec=5400")
    println("inv:default_expected_total=12")
    println("inv:n_signals=2")
    println("inv:signals=remote_count_geq_expected,remote_all_done_marker")
    println("inv:dispatch_steps=4")
    println("inv:dispatch=scp,f1_v3_verdict,r64_baseline_lock,cross_axis")
    println("inv:cross_axis_skip_if_d_verdict_missing=true")
    println("inv:notify=stub_stage0")
    println("inv:non_mutation_dry_default=true")
    println("inv:audit_note=hf_repo_has_only_4_ckpts_step_2000_to_8000_no_step_10000")

    let ts = _ts_iso()
    if len(ts) < 10 {
        eprintln("selftest=fail (ts_iso empty)")
        exit(1)
    }
    let q_ok = _sq("hello world")
    if q_ok != "'hello world'" {
        eprintln("selftest=fail (sq mismatch: " + q_ok + ")")
        exit(1)
    }
    println("selftest=ok ts=" + ts)
    println("DONE")
}

fn main() {
    let av = _argv()
    if _has(av, "--selftest") { cmd_selftest(); exit(0) }

    let remote_dir   = _env_or("ANIMA_R64_REMOTE_RESULTS", "/home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results")
    let local_dir    = _env_or("ANIMA_R64_LOCAL_RESULTS",  "/Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_lora_results")
    let expected     = to_int(_env_or("ANIMA_EXPECTED_TOTAL", "12"))
    let log_tail     = _env_or("ANIMA_R64_LOG_TAIL_PATH",  "/home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03/eval_run.log")
    let verdict_out  = _env_or("ANIMA_R64_VERDICT_OUT",    "/Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_verdict.json")
    let baseline_out = _env_or("ANIMA_R64_BASELINE_OUT",   "/Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json")
    let d_verdict    = _env_or("ANIMA_D_VERDICT",          "/Users/ghost/core/anima/state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json")
    let log_path     = _env_or("ANIMA_LOG_PATH",           LOG_PATH_DEFAULT)
    let disp_path    = _env_or("ANIMA_DISPATCH_PATH",      DISPATCH_PATH_DEFAULT)
    let poll_sec     = to_int(_env_or("ANIMA_POLL_INTERVAL_SEC", "300"))
    let max_wait     = to_int(_env_or("ANIMA_MAX_WAIT_SEC",      "5400"))

    let apply  = _has(av, "--apply")
    let single = _has(av, "--once")

    println("[watchdog] start ts=" + _ts_iso() + " apply=" + (if apply { "yes" } else { "no" }) + " mode=" + (if single { "once" } else { "loop" }))
    println("[watchdog] remote=" + remote_dir)
    println("[watchdog] local=" + local_dir)
    println("[watchdog] expected_total=" + to_string(expected))
    println("[watchdog] verdict_out=" + verdict_out)
    println("[watchdog] baseline_out=" + baseline_out)
    println("[watchdog] d_verdict=" + d_verdict)
    println("[watchdog] poll_sec=" + to_string(poll_sec) + " max_wait=" + to_string(max_wait))

    _log(log_path, "start", "{\"apply\":" + (if apply { "true" } else { "false" }) + ",\"mode\":\"" + (if single { "once" } else { "loop" }) + "\",\"expected_total\":" + to_string(expected) + "}")

    let rc = _run_loop(remote_dir, expected, log_tail, local_dir, verdict_out, baseline_out, d_verdict, log_path, disp_path, poll_sec, max_wait, apply, single)
    exit(rc)
}

main()
