// tool/p9_path_a_r16_3seed_completion_watchdog.hexa — Path A r=16 3-seed (s42+s43+s44) ensemble mitigation watchdog (raw#9 hexa-only Mac).
//
// PURPOSE
//   Polls (every 10 min, max 16h) for ALL THREE Path A r=16 mitigation training pods to complete via:
//     - HF repo signal per seed: count step-* refs >= 5 (step-2000..step-10000) OR final-tag presence
//   Seeds tracked:
//     s42 -> dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1
//     s43 -> dancinlab/llm-llama32-3b-paradigm-a-prime-r16-s43-sft-stage1
//     s44 -> dancinlab/llm-llama32-3b-paradigm-a-prime-r16-s44-sft-stage1
//
//   GUARD-3 (success-signal checklist): file existence != success. Each candidate signal must
//     - hf_refs endpoint returns 200 AND parses as JSON
//     - >=5 distinct step-* tags counted OR final tag step-10000 returns 200
//     - per-seed status is one of {READY, PARTIAL_n, MISSING}; 3/3 READY required to fire dispatch
//
//   On full-fleet trigger fire (3/3 READY):
//     1. Provision dedicated eval pod via runpodctl (H100 SXM secure, ~$15 cap) OR fallback ubu1
//        (default: dispatch ubu1 path; pod provisioning is opt-in via ANIMA_EVAL_PROVISION_POD=1)
//     2. Run 45 evals: 3 seeds × 5 ckpts × 3 tasks (hellaswag, mmlu, triviaqa) at limit=500
//     3. Pull lora_results back to Mac into per-seed subdirs
//     4. Compute per-seed verdict via tool/p9_a_prime_verdict.hexa (doc_hash join patch already landed,
//        sha256 db1b4552ddee2238fa86ea78b62350b33483d3e23d5b6bff107726996e566eda)
//     5. Compute 3-seed ensemble: mean ± std per (ckpt, task) + paired bootstrap CI (95%) + cv check
//        cv<0.30 = real lift; cv>=0.30 = seed luck
//     6. Mitigation comparison vs r=64 baseline (state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json):
//        F-PATHA-MITIGATION-1: ensemble TriviaQA Δ_mean ≥ 0 + std bound + paired bootstrap CI ≥ -0.5pt
//        Verdict: MITIGATION_PASS / PARTIAL / FAIL_REGRESSION / FAIL_NO_LIFT
//     7. Land marker + handoff doc summary
//
// USAGE
//   hexa run tool/p9_path_a_r16_3seed_completion_watchdog.hexa --selftest          # invariants
//   hexa run tool/p9_path_a_r16_3seed_completion_watchdog.hexa --once               # single poll, no loop
//   hexa run tool/p9_path_a_r16_3seed_completion_watchdog.hexa --loop --apply       # full 16h watchdog + apply
//   hexa run tool/p9_path_a_r16_3seed_completion_watchdog.hexa --loop               # poll-only DRY (no eval)
//
// CONFIG (env overrides)
//   ANIMA_R16_3SEED_HF_S42      default: dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1
//   ANIMA_R16_3SEED_HF_S43      default: dancinlab/llm-llama32-3b-paradigm-a-prime-r16-s43-sft-stage1
//   ANIMA_R16_3SEED_HF_S44      default: dancinlab/llm-llama32-3b-paradigm-a-prime-r16-s44-sft-stage1
//   ANIMA_R16_HF_FINAL_TAG      default: step-10000
//   ANIMA_R16_HF_MIN_CKPTS      default: 5
//   ANIMA_R64_BASELINE          default: state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json
//   ANIMA_EVAL_PROVISION_POD    default: 0 (use ubu1 RTX 5070); set =1 to provision dedicated H100 ($15 cap)
//   ANIMA_EVAL_HOST             default: ubu1 (when ANIMA_EVAL_PROVISION_POD=0)
//   ANIMA_R16_3SEED_BASE        default: state/p9_path_a_r16_3seed_2026_05_04
//   ANIMA_POLL_INTERVAL_SEC     default: 600 (10 min)
//   ANIMA_MAX_WAIT_SEC          default: 57600 (16h)
//
// EXIT CODES
//   0 = trigger fired + dispatch attempted (apply) OR loop completed without trigger (timeout) OR --once
//   1 = selftest fail
//   2 = config error / unrecoverable env issue
//
// raw#9  hexa-only Mac          (ssh/scp/curl/runpodctl shelled out via exec_with_status)
// raw#15 SSOT this file         (this hexa is single source for r16 3-seed trigger logic)
// raw#10 honest C3 (4 caveats):
//   (a) 3-seed timing window: seeds s43/s44 launched ~2h45min after s42; dispatch waits for SLOWEST seed
//       (max-of-three completion). ETA ~6.5h from this watchdog start (per s43/s44 step ~300/10k @ 04:55Z).
//       If s42 finishes hours earlier, its pod is auto-terminated by host_terminator_v2.txt (no idle burn).
//   (b) Eval pod cost: default routes to ubu1 RTX 5070 ($0 + slower; 45 evals ~3-5h estimated).
//       If ANIMA_EVAL_PROVISION_POD=1, provisions H100 SXM secure (~$15 hard cap, 1.5h ETA).
//       Pod auto-terminated post-eval via embedded teardown step.
//   (c) 45 evals 4-bit may differ from production: anchor methodology is 4-bit nf4 base + LoRA overlay
//       (matches A' decision spec). Production inference may use bf16 → 1-3pt drift expected. Verdict
//       MUST be interpreted as "4-bit anchor consistency" not "production performance forecast".
//   (d) doc_hash join patch ALREADY landed (verdict tool sha256 db1b4552); no pre-eval patch needed.
//       Verified via state/p9_a_prime_verdict_patch_2026_05_04/audit.json (2026-05-04T04:50:25Z).
//       If verdict tool sha changes before dispatch, abort with EXIT=2 (env drift).

let BASE_DIR_DEFAULT      = "/Users/ghost/core/anima/state/p9_path_a_r16_3seed_2026_05_04"
let LOG_PATH_REL          = "watchdog_3seed_log.jsonl"
let DISPATCH_PATH_REL     = "eval_dispatch_3seed.json"
let NOTIFY_PATH_REL       = "notify_payload_3seed.json"
let VERDICT_PATH_REL      = "verdict.json"
let ENSEMBLE_PATH_REL     = "ensemble.json"
let MITIGATION_PATH_REL   = "mitigation_comparison.json"
let VERDICT_TOOL_SHA_LOCK = "db1b4552ddee2238fa86ea78b62350b33483d3e23d5b6bff107726996e566eda"

// ─── INLINE_DEPRECATED[H42]: see shared/util/* canonical impls ────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _json_escape(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}
fn _ts_iso() -> string {
    let r = exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")
    return to_string(r[0]).trim()
}
fn _now_epoch() -> int {
    let r = exec_with_status("date -u +%s")
    return to_int(to_string(r[0]).trim())
}
fn _env_or(name: string, dflt: string) -> string {
    let r = exec_with_status("printf %s \"${" + name + ":-" + dflt + "}\"")
    return to_string(r[0])
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _has(av, k) -> bool {
    let mut i = 0
    while i < len(av) { if to_string(av[i]) == k { return true }; i = i + 1 }
    return false
}

// ─── append-only JSONL log ─────────────────────────────────────────────

fn _log(path: string, event: string, payload_json: string) {
    let line = "{\"ts_utc\":\"" + _ts_iso() + "\",\"event\":\"" + event + "\",\"payload\":" + payload_json + "}\n"
    let q = _sq(line)
    let dir_part = path
    let mut last_slash = 0
    let mut i = 0
    while i < len(dir_part) {
        if dir_part.substring(i, i+1) == "/" { last_slash = i }
        i = i + 1
    }
    let parent = dir_part.substring(0, last_slash)
    exec_with_status("mkdir -p " + _sq(parent))
    exec_with_status("printf %s " + q + " >> " + _sq(path))
}

// ─── GUARD-3: per-seed HF repo signal ────────────────────────────────────

fn _check_hf_repo(repo: string, final_tag: string, min_ckpts: int) -> string {
    let url_refs = "https://huggingface.co/api/models/" + repo + "/refs"
    let q = "curl -sSfL " + _sq(url_refs) + " 2>/dev/null | python3 -c 'import sys,json,re;\ntry: d=json.load(sys.stdin)\nexcept Exception: print(\"PARSE_ERROR\"); sys.exit(0)\nrefs=[]\nfor k in (\"branches\",\"tags\",\"converts\"): refs.extend(d.get(k,[]))\nnames=[r.get(\"name\",\"\") for r in refs]\nsteps=set()\nfor n in names:\n    m = re.search(r\"step-(\\d+)\", n)\n    if m: steps.add(int(m.group(1)))\nprint(len(steps))' 2>/dev/null"
    let r = exec_with_status(q)
    if r[1] == 0 {
        let count_str = to_string(r[0]).trim()
        if count_str != "" && count_str != "PARSE_ERROR" {
            let n = to_int(count_str)
            if n >= min_ckpts { return "READY:n_ckpts_" + to_string(n) }
            if n > 0 { return "PARTIAL:n_ckpts_" + to_string(n) }
        }
    }
    let url_tag = "https://huggingface.co/api/models/" + repo + "/tree/" + final_tag
    let q2 = "curl -sSfL -o /dev/null -w '%{http_code}' " + _sq(url_tag) + " 2>/dev/null"
    let r2 = exec_with_status(q2)
    if r2[1] != 0 { return "MISSING" }
    let code = to_string(r2[0]).trim()
    if code == "200" { return "READY:hf_tag_" + final_tag }
    return "MISSING:http_" + code
}

// ─── single poll (3 seeds parallel) ─────────────────────────────────────

fn _poll_three(repos: array, final_tag: string, min_ckpts: int, log_path: string) -> array {
    let mut statuses = []
    let mut ready = 0
    let mut i = 0
    while i < len(repos) {
        let s = _check_hf_repo(to_string(repos[i]), final_tag, min_ckpts)
        statuses.push(s)
        if s.starts_with("READY") { ready = ready + 1 }
        i = i + 1
    }
    let payload = "{\"s42\":\"" + _json_escape(to_string(statuses[0])) + "\",\"s43\":\"" + _json_escape(to_string(statuses[1])) + "\",\"s44\":\"" + _json_escape(to_string(statuses[2])) + "\",\"ready_count\":" + to_string(ready) + "}"
    _log(log_path, "poll_3seed", payload)
    println("[3seed-watchdog] " + _ts_iso() + " s42=" + to_string(statuses[0]) + " s43=" + to_string(statuses[1]) + " s44=" + to_string(statuses[2]) + " ready=" + to_string(ready) + "/3")
    return [statuses, ready]
}

// ─── verdict tool integrity check (raw#10 caveat d) ────────────────────

fn _verify_verdict_tool_sha() -> bool {
    let q = "shasum -a 256 /Users/ghost/core/anima/tool/p9_a_prime_verdict.hexa 2>/dev/null | awk '{print $1}'"
    let r = exec_with_status(q)
    if r[1] != 0 { return false }
    let sha = to_string(r[0]).trim()
    if sha != VERDICT_TOOL_SHA_LOCK {
        eprintln("[3seed-watchdog] WARN: verdict tool sha drift expected=" + VERDICT_TOOL_SHA_LOCK + " actual=" + sha)
        return false
    }
    return true
}

// ─── eval host dispatch (ubu1 default; pod opt-in) ────────────────────────

fn _build_eval_script_helper(repos: array, base_dir: string, eval_host: string) -> string {
    // Emit a python helper that runs 45 evals (3 seeds × 5 ckpts × 3 tasks).
    // Reuses /home/aiden/anima/state/p9_a_prime_main_eval_pipeline_2026_05_03/eval_llama_lora_ckpt.py on ubu1.
    let helper_path = "/tmp/p9_path_a_r16_3seed_eval_dispatch.sh_tmp"
    let parts = []
    parts.push("#!/bin/bash\n")
    parts.push("# 3-seed eval dispatch (auto-generated by p9_path_a_r16_3seed_completion_watchdog.hexa)\n")
    parts.push("set -uo pipefail\n")
    parts.push("DIR=/home/aiden/anima/state/p9_a_prime_main_eval_pipeline_2026_05_03\n")
    parts.push("PY=/home/aiden/venv_orchestrator/bin/python\n")
    parts.push("RESULTS_BASE=/home/aiden/anima/state/p9_path_a_r16_3seed_eval_2026_05_04\n")
    parts.push("mkdir -p $RESULTS_BASE/lora_results_s42 $RESULTS_BASE/lora_results_s43 $RESULTS_BASE/lora_results_s44\n")
    parts.push("declare -A REPOS\n")
    parts.push("REPOS[s42]=" + to_string(repos[0]) + "\n")
    parts.push("REPOS[s43]=" + to_string(repos[1]) + "\n")
    parts.push("REPOS[s44]=" + to_string(repos[2]) + "\n")
    parts.push("for SEED in s42 s43 s44; do\n")
    parts.push("  REPO=${REPOS[$SEED]}\n")
    parts.push("  OUT_DIR=$RESULTS_BASE/lora_results_$SEED\n")
    parts.push("  for STEP in step-2000 step-4000 step-6000 step-8000 step-10000; do\n")
    parts.push("    SLUG=$(echo $STEP | tr - _)\n")
    parts.push("    for TASK in hellaswag mmlu triviaqa; do\n")
    parts.push("      OUT=$OUT_DIR/${SLUG}_${TASK}.json\n")
    parts.push("      if [ -f \"$OUT\" ]; then echo \"[skip] $OUT exists\"; continue; fi\n")
    parts.push("      echo \"=== $SEED $STEP $TASK ===\"\n")
    parts.push("      $PY $DIR/eval_llama_lora_ckpt.py --ckpt-repo $REPO --ckpt-revision $STEP --task $TASK --limit 500 --output $OUT 2>&1 | tail -5\n")
    parts.push("    done\n")
    parts.push("  done\n")
    parts.push("done\n")
    parts.push("echo \"=== R16 3SEED ALL DONE ===\"\n")
    write_file(helper_path, parts.join(""))
    return helper_path
}

fn _dispatch_eval_ubu1(repos: array, base_dir: string, eval_host: string, log_path: string) -> array {
    // Returns [step1_rc, step2_rc, step1_tail]
    let helper_path = _build_eval_script_helper(repos, base_dir, eval_host)
    // Upload helper to ubu1 + execute remotely
    let scp_in = "scp -o ConnectTimeout=15 " + helper_path + " " + eval_host + ":/tmp/p9_path_a_r16_3seed_eval_dispatch.sh 2>&1"
    let r_in = exec_with_status(scp_in)
    if r_in[1] != 0 {
        return [-1, -1, "scp_in_fail rc=" + to_string(r_in[1]) + " out=" + to_string(r_in[0]).trim()]
    }
    let ssh_run = "ssh -o ConnectTimeout=15 " + eval_host + " " + _sq("bash /tmp/p9_path_a_r16_3seed_eval_dispatch.sh") + " 2>&1 | tail -200"
    let r_run = exec_with_status(ssh_run)
    let step1_rc = r_run[1]
    let mut step1_tail = to_string(r_run[0]).trim()
    if len(step1_tail) > 4000 { step1_tail = step1_tail.substring(len(step1_tail) - 4000, len(step1_tail)) }

    // scp results back: 3 seed dirs
    let scp_back = "mkdir -p " + _sq(base_dir + "/lora_results_s42") + " " + _sq(base_dir + "/lora_results_s43") + " " + _sq(base_dir + "/lora_results_s44") + " && " +
        "scp " + eval_host + ":/home/aiden/anima/state/p9_path_a_r16_3seed_eval_2026_05_04/lora_results_s42/*.json " + _sq(base_dir + "/lora_results_s42/") + " 2>&1; " +
        "scp " + eval_host + ":/home/aiden/anima/state/p9_path_a_r16_3seed_eval_2026_05_04/lora_results_s43/*.json " + _sq(base_dir + "/lora_results_s43/") + " 2>&1; " +
        "scp " + eval_host + ":/home/aiden/anima/state/p9_path_a_r16_3seed_eval_2026_05_04/lora_results_s44/*.json " + _sq(base_dir + "/lora_results_s44/") + " 2>&1"
    let r_back = exec_with_status(scp_back)
    let step2_rc = r_back[1]

    return [step1_rc, step2_rc, step1_tail]
}

// ─── per-seed verdict (loop tool/p9_a_prime_verdict.hexa over 3 seed dirs) ──

fn _per_seed_verdict(base_dir: string, log_path: string) -> array {
    // Returns [s42_rc, s43_rc, s44_rc, s42_path, s43_path, s44_path]
    let seeds = ["s42", "s43", "s44"]
    let mut rcs = []
    let mut paths = []
    let mut i = 0
    while i < len(seeds) {
        let seed = to_string(seeds[i])
        let lora_dir = base_dir + "/lora_results_" + seed
        let out_path = base_dir + "/verdict_" + seed + ".json"
        let cmd = "cd /Users/ghost/core/anima && " +
            "ANIMA_LORA_RESULTS_DIR=" + lora_dir + " " +
            "ANIMA_OUTPUT=" + out_path + " " +
            "hexa run tool/p9_a_prime_verdict.hexa 2>&1 | tail -40"
        let r = exec_with_status(cmd)
        rcs.push(r[1])
        paths.push(out_path)
        _log(log_path, "per_seed_verdict", "{\"seed\":\"" + seed + "\",\"rc\":" + to_string(r[1]) + ",\"out\":\"" + _json_escape(out_path) + "\"}")
        i = i + 1
    }
    return [rcs[0], rcs[1], rcs[2], paths[0], paths[1], paths[2]]
}

// ─── 3-seed ensemble + mitigation comparison ────────────────────────────

fn _emit_ensemble_and_mitigation(base_dir: string, r64_baseline: string, log_path: string) -> int {
    let helper = "/tmp/p9_path_a_r16_3seed_ensemble.py_tmp"
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# 3-seed ensemble + mitigation comparison vs r=64 baseline (raw#37 transient)\n")
    parts.push("import json, os, statistics, sys\n")
    parts.push("from pathlib import Path\n")
    parts.push("BASE = Path('" + base_dir + "')\n")
    parts.push("R64_BASELINE = '" + r64_baseline + "'\n")
    parts.push("ENSEMBLE_OUT = BASE / '" + ENSEMBLE_PATH_REL + "'\n")
    parts.push("MITIGATION_OUT = BASE / '" + MITIGATION_PATH_REL + "'\n")
    parts.push("VERDICT_OUT = BASE / '" + VERDICT_PATH_REL + "'\n\n")
    parts.push("verdicts = {}\n")
    parts.push("for seed in ('s42', 's43', 's44'):\n")
    parts.push("    p = BASE / f'verdict_{seed}.json'\n")
    parts.push("    if not p.exists():\n")
    parts.push("        verdicts[seed] = None\n")
    parts.push("        continue\n")
    parts.push("    verdicts[seed] = json.loads(p.read_text())\n\n")
    parts.push("loaded = [s for s,v in verdicts.items() if v is not None]\n")
    parts.push("missing = [s for s,v in verdicts.items() if v is None]\n\n")
    parts.push("# Ensemble structure: per (ckpt-step, task) -> mean ± std across seeds\n")
    parts.push("# verdict_<seed>.json has ckpt_verdicts: { '<repo>@<rev>': { per_task: {hellaswag: {ckpt_acc, point_delta_pt, ...}, ...} } }\n")
    parts.push("# We map by step-K extracted from ckpt_id.\n")
    parts.push("import re\n")
    parts.push("def extract_step(ckpt_id):\n")
    parts.push("    m = re.search(r'step[-_]?(\\d+)', ckpt_id or '')\n")
    parts.push("    return int(m.group(1)) if m else None\n\n")
    parts.push("# Aggregate: per step -> per task -> list of (seed, ckpt_acc, point_delta_pt)\n")
    parts.push("agg = {}\n")
    parts.push("for seed, vd in verdicts.items():\n")
    parts.push("    if vd is None: continue\n")
    parts.push("    cv = vd.get('ckpt_verdicts', {})\n")
    parts.push("    for ckpt_id, c_v in cv.items():\n")
    parts.push("        step = extract_step(ckpt_id)\n")
    parts.push("        if step is None: continue\n")
    parts.push("        agg.setdefault(step, {})\n")
    parts.push("        for task, t_v in (c_v.get('per_task') or {}).items():\n")
    parts.push("            agg[step].setdefault(task, [])\n")
    parts.push("            agg[step][task].append({\n")
    parts.push("                'seed': seed,\n")
    parts.push("                'ckpt_acc': t_v.get('ckpt_acc'),\n")
    parts.push("                'point_delta_pt': t_v.get('point_delta_pt'),\n")
    parts.push("                'ci95_lo_pt': t_v.get('ci95_lo_pt'),\n")
    parts.push("                'ci95_hi_pt': t_v.get('ci95_hi_pt'),\n")
    parts.push("            })\n\n")
    parts.push("ensemble = {'schema': 'anima/p9_path_a_r16_3seed_ensemble/1', 'n_seeds_loaded': len(loaded), 'seeds_loaded': loaded, 'seeds_missing': missing, 'per_step': {}}\n")
    parts.push("for step in sorted(agg.keys()):\n")
    parts.push("    ensemble['per_step'][str(step)] = {}\n")
    parts.push("    for task in sorted(agg[step].keys()):\n")
    parts.push("        rows = agg[step][task]\n")
    parts.push("        deltas = [r['point_delta_pt'] for r in rows if r['point_delta_pt'] is not None]\n")
    parts.push("        accs = [r['ckpt_acc'] for r in rows if r['ckpt_acc'] is not None]\n")
    parts.push("        m = statistics.mean(deltas) if deltas else None\n")
    parts.push("        sd = statistics.stdev(deltas) if len(deltas) >= 2 else 0.0\n")
    parts.push("        cv = (sd / abs(m)) if (m is not None and abs(m) > 1e-9) else None\n")
    parts.push("        ensemble['per_step'][str(step)][task] = {\n")
    parts.push("            'n_seeds': len(deltas),\n")
    parts.push("            'mean_delta_pt': m,\n")
    parts.push("            'std_delta_pt': sd,\n")
    parts.push("            'cv': cv,\n")
    parts.push("            'cv_real_lift': (cv is not None and cv < 0.30),\n")
    parts.push("            'mean_ckpt_acc': statistics.mean(accs) if accs else None,\n")
    parts.push("            'per_seed_rows': rows,\n")
    parts.push("        }\n\n")
    parts.push("ENSEMBLE_OUT.write_text(json.dumps(ensemble, indent=2, default=str))\n")
    parts.push("print(f'[ensemble] -> {ENSEMBLE_OUT}')\n\n")
    parts.push("# Mitigation comparison vs r=64 baseline\n")
    parts.push("# r64_baseline schema: ckpt_verdicts (same as r16 verdict). Pick best r64 ckpt per task too.\n")
    parts.push("mitigation = {'schema': 'anima/p9_path_a_r16_3seed_mitigation_comparison/1',\n")
    parts.push("              'spec_ref': 'docs/p9_path_a_regression_mitigation_spec_2026_05_03.md F-PATHA-MITIGATION-1',\n")
    parts.push("              'r16_ensemble_path': str(ENSEMBLE_OUT),\n")
    parts.push("              'r64_baseline_path': R64_BASELINE,\n")
    parts.push("              'falsifier_id': 'F-PATHA-MITIGATION-1'}\n\n")
    parts.push("if not Path(R64_BASELINE).exists():\n")
    parts.push("    mitigation['mitigation_verdict'] = 'MITIGATION_NO_R64_BASELINE'\n")
    parts.push("    mitigation['skip_reason'] = f'r64 baseline missing: {R64_BASELINE}'\n")
    parts.push("else:\n")
    parts.push("    r64 = json.loads(Path(R64_BASELINE).read_text())\n")
    parts.push("    r64_cv = r64.get('ckpt_verdicts', {})\n")
    parts.push("    # Best r64: compare deltas per task; highest mean_delta on TriviaQA priority\n")
    parts.push("    r64_per_step = {}\n")
    parts.push("    for ckpt_id, c_v in r64_cv.items():\n")
    parts.push("        step = extract_step(ckpt_id)\n")
    parts.push("        if step is None: continue\n")
    parts.push("        r64_per_step[step] = c_v\n")
    parts.push("    mitigation['r64_steps_seen'] = sorted(r64_per_step.keys())\n")
    parts.push("    mitigation['r16_steps_seen'] = sorted([int(s) for s in ensemble['per_step'].keys()])\n\n")
    parts.push("    # Per-step delta-of-deltas for shared steps\n")
    parts.push("    common = sorted(set(r64_per_step.keys()) & set(int(s) for s in ensemble['per_step'].keys()))\n")
    parts.push("    per_step_cmp = []\n")
    parts.push("    for step in common:\n")
    parts.push("        row = {'step': step}\n")
    parts.push("        for task in ('hellaswag','mmlu','triviaqa'):\n")
    parts.push("            r16_t = ensemble['per_step'][str(step)].get(task, {})\n")
    parts.push("            r64_t = (r64_per_step[step].get('per_task') or {}).get(task, {})\n")
    parts.push("            r16_mean = r16_t.get('mean_delta_pt')\n")
    parts.push("            r64_pt = r64_t.get('point_delta_pt')\n")
    parts.push("            mit_delta = (r16_mean - r64_pt) if (r16_mean is not None and r64_pt is not None) else None\n")
    parts.push("            row[task] = {\n")
    parts.push("                'r16_3seed_mean_delta_pt': r16_mean,\n")
    parts.push("                'r16_3seed_std_pt': r16_t.get('std_delta_pt'),\n")
    parts.push("                'r16_3seed_cv': r16_t.get('cv'),\n")
    parts.push("                'r16_3seed_cv_real_lift': r16_t.get('cv_real_lift'),\n")
    parts.push("                'r64_point_delta_pt': r64_pt,\n")
    parts.push("                'mitigation_delta_pt': mit_delta,\n")
    parts.push("            }\n")
    parts.push("        per_step_cmp.append(row)\n")
    parts.push("    mitigation['per_step_comparison'] = per_step_cmp\n\n")
    parts.push("    # F-PATHA-MITIGATION-1 verdict (best r16 step on TriviaQA — pick step with max mean TriviaQA delta)\n")
    parts.push("    triv_rows = []\n")
    parts.push("    for step_str, tasks in ensemble['per_step'].items():\n")
    parts.push("        triv = tasks.get('triviaqa', {})\n")
    parts.push("        if triv.get('mean_delta_pt') is not None:\n")
    parts.push("            triv_rows.append((int(step_str), triv))\n")
    parts.push("    if not triv_rows:\n")
    parts.push("        verdict_label = 'MITIGATION_NO_DATA'\n")
    parts.push("        falsifier = {'reason': 'no triviaqa rows in ensemble'}\n")
    parts.push("    else:\n")
    parts.push("        triv_rows.sort(key=lambda x: x[1]['mean_delta_pt'], reverse=True)\n")
    parts.push("        best_step, best_triv = triv_rows[0]\n")
    parts.push("        # Approximate paired bootstrap CI lo via mean - 1.96*std/sqrt(n) (3-seed amend; full bootstrap requires per-example arrays we may not retain after eval)\n")
    parts.push("        n = best_triv['n_seeds']\n")
    parts.push("        mean = best_triv['mean_delta_pt']\n")
    parts.push("        std = best_triv['std_delta_pt']\n")
    parts.push("        ci_lo = mean - (1.96 * std / max(n, 1) ** 0.5) if std is not None else None\n")
    parts.push("        ci_hi = mean + (1.96 * std / max(n, 1) ** 0.5) if std is not None else None\n")
    parts.push("        # F-PATHA-MITIGATION-1 strict (3-seed amended, caveat #4):\n")
    parts.push("        #   primary: mean_delta_triv >= 0 AND ci_lo >= -0.5pt (loosened landing band)\n")
    parts.push("        #   cv check: cv < 0.30 (real lift)\n")
    parts.push("        primary_pass = (mean is not None and mean >= 0.0 and ci_lo is not None and ci_lo >= -0.5)\n")
    parts.push("        cv_pass = best_triv.get('cv_real_lift', False)\n")
    parts.push("        # Secondary: hellaswag OR mmlu mean_delta >= 0 at best_step\n")
    parts.push("        hs = ensemble['per_step'][str(best_step)].get('hellaswag', {}).get('mean_delta_pt')\n")
    parts.push("        mm = ensemble['per_step'][str(best_step)].get('mmlu', {}).get('mean_delta_pt')\n")
    parts.push("        secondary_pass = (hs is not None and hs >= 0.0) or (mm is not None and mm >= 0.0)\n")
    parts.push("        falsifier = {\n")
    parts.push("            'best_step': best_step,\n")
    parts.push("            'mean_delta_triviaqa_pt': mean,\n")
    parts.push("            'std_delta_triviaqa_pt': std,\n")
    parts.push("            'ci95_lo_pt_normal_approx': ci_lo,\n")
    parts.push("            'ci95_hi_pt_normal_approx': ci_hi,\n")
    parts.push("            'cv_triviaqa': best_triv.get('cv'),\n")
    parts.push("            'cv_real_lift': cv_pass,\n")
    parts.push("            'mean_delta_hellaswag_pt': hs,\n")
    parts.push("            'mean_delta_mmlu_pt': mm,\n")
    parts.push("            'primary_pass': primary_pass,\n")
    parts.push("            'secondary_pass': secondary_pass,\n")
    parts.push("            'ci_method_note': 'normal-approx CI (3-seed); full paired bootstrap requires per-example correctness retention',\n")
    parts.push("        }\n")
    parts.push("        if primary_pass and cv_pass and secondary_pass:\n")
    parts.push("            verdict_label = 'MITIGATION_PASS'\n")
    parts.push("        elif primary_pass and cv_pass and not secondary_pass:\n")
    parts.push("            verdict_label = 'MITIGATION_FAIL_NO_LIFT'\n")
    parts.push("        elif (mean is not None and mean >= -1.0):\n")
    parts.push("            verdict_label = 'MITIGATION_PARTIAL'\n")
    parts.push("        else:\n")
    parts.push("            verdict_label = 'MITIGATION_FAIL_REGRESSION'\n")
    parts.push("    mitigation['mitigation_verdict'] = verdict_label\n")
    parts.push("    mitigation['falsifier'] = falsifier\n\n")
    parts.push("MITIGATION_OUT.write_text(json.dumps(mitigation, indent=2, default=str))\n")
    parts.push("print(f'[mitigation] verdict={mitigation[\"mitigation_verdict\"]} -> {MITIGATION_OUT}')\n\n")
    parts.push("# Top-level verdict.json (overwrite training-in-progress)\n")
    parts.push("top = {\n")
    parts.push("    'schema': 'anima/p9_path_a_r16_3seed/verdict/2',\n")
    parts.push("    'status': 'eval_complete',\n")
    parts.push("    'spec_ref': 'docs/p9_path_a_regression_mitigation_spec_2026_05_03.md F-PATHA-MITIGATION-1 (3-seed amend caveat #4)',\n")
    parts.push("    'mitigation_verdict': mitigation['mitigation_verdict'],\n")
    parts.push("    'n_seeds_loaded': ensemble['n_seeds_loaded'],\n")
    parts.push("    'seeds_loaded': ensemble['seeds_loaded'],\n")
    parts.push("    'seeds_missing': ensemble['seeds_missing'],\n")
    parts.push("    'ensemble_path': str(ENSEMBLE_OUT),\n")
    parts.push("    'mitigation_path': str(MITIGATION_OUT),\n")
    parts.push("    'r64_baseline_path': R64_BASELINE,\n")
    parts.push("}\n")
    parts.push("VERDICT_OUT.write_text(json.dumps(top, indent=2, default=str))\n")
    parts.push("print(f'[verdict] -> {VERDICT_OUT}')\n")
    write_file(helper, parts.join(""))
    let r = exec_with_status("python3 " + helper + " 2>&1")
    println(to_string(r[0]))
    return r[1]
}

// ─── dispatch orchestration ──────────────────────────────────────────

fn _dispatch(repos: array, base_dir: string, eval_host: string, provision_pod: bool, r64_baseline: string, log_path: string, dispatch_path: string, apply: bool) -> int {
    let dispatch_dir = base_dir
    exec_with_status("mkdir -p " + _sq(dispatch_dir))

    let ts_start = _ts_iso()
    let mut steps = []

    // Step 0: verdict tool sha integrity (raw#10 caveat d)
    let sha_ok = _verify_verdict_tool_sha()
    steps.push("{\"step\":0,\"name\":\"verdict_tool_sha_check\",\"ok\":" + (if sha_ok { "true" } else { "false" }) + ",\"locked_sha\":\"" + VERDICT_TOOL_SHA_LOCK + "\"}")
    if !sha_ok && apply {
        _log(log_path, "abort_sha_drift", "{\"reason\":\"verdict_tool_sha_drift\"}")
        let payload = "{\n  \"schema\": \"anima/p9_path_a_r16_3seed_eval/dispatch/1\",\n  \"applied\": true,\n  \"aborted\": true,\n  \"abort_reason\": \"verdict_tool_sha_drift\",\n  \"ts_start\": \"" + ts_start + "\",\n  \"ts_end\": \"" + _ts_iso() + "\",\n  \"steps\": [" + steps.join(",") + "]\n}\n"
        write_file(dispatch_path, payload)
        return 2
    }

    // Step 1: eval execution (45 evals)
    let mut step1_rc = -1
    let mut step2_rc = -1
    let mut step1_tail = ""
    if apply {
        if provision_pod {
            // Provision dedicated H100 SXM secure pod (not implemented in stage0; placeholder)
            // For HARD CAP $20 with $15 eval pod budget — operator must manually provision via runpodctl.
            _log(log_path, "pod_provision_request", "{\"note\":\"H100 SXM secure dedicated eval pod requested but auto-provision not in stage0\"}")
            step1_rc = -2
            step1_tail = "ANIMA_EVAL_PROVISION_POD=1 set but auto-provision is operator-manual in stage0 (cost safety); falling back to ubu1"
            // Fall through to ubu1
        }
        let r = _dispatch_eval_ubu1(repos, base_dir, eval_host, log_path)
        step1_rc = r[0]
        step2_rc = r[1]
        step1_tail = to_string(r[2])
    }
    steps.push("{\"step\":1,\"name\":\"eval_45_runs\",\"applied\":" + (if apply { "true" } else { "false" }) + ",\"rc\":" + to_string(step1_rc) + ",\"host\":\"" + _json_escape(eval_host) + "\"}")
    steps.push("{\"step\":2,\"name\":\"scp_results_back\",\"rc\":" + to_string(step2_rc) + "}")

    // Step 3: per-seed verdicts
    let mut step3_max_rc = -1
    let mut s42_v = ""
    let mut s43_v = ""
    let mut s44_v = ""
    if apply && step2_rc == 0 {
        let r = _per_seed_verdict(base_dir, log_path)
        let r0 = to_int(r[0]); let r1 = to_int(r[1]); let r2 = to_int(r[2])
        step3_max_rc = r0
        if r1 > step3_max_rc { step3_max_rc = r1 }
        if r2 > step3_max_rc { step3_max_rc = r2 }
        s42_v = to_string(r[3])
        s43_v = to_string(r[4])
        s44_v = to_string(r[5])
    }
    steps.push("{\"step\":3,\"name\":\"per_seed_verdict\",\"max_rc\":" + to_string(step3_max_rc) + "}")

    // Step 4: ensemble + mitigation
    let mut step4_rc = -1
    if apply && step3_max_rc == 0 {
        step4_rc = _emit_ensemble_and_mitigation(base_dir, r64_baseline, log_path)
    }
    steps.push("{\"step\":4,\"name\":\"ensemble_and_mitigation\",\"rc\":" + to_string(step4_rc) + "}")

    // Step 5: marker land
    let mut step5_rc = -1
    if apply && step4_rc == 0 {
        let marker_path = "/Users/ghost/core/anima/state/markers/p9_path_a_r16_3seed_eval_landed.marker"
        let marker_body = "{\n  \"schema\": \"anima/marker/1\",\n  \"id\": \"p9_path_a_r16_3seed_eval_landed\",\n  \"ts_utc\": \"" + _ts_iso() + "\",\n  \"verdict_path\": \"state/p9_path_a_r16_3seed_2026_05_04/verdict.json\",\n  \"ensemble_path\": \"state/p9_path_a_r16_3seed_2026_05_04/ensemble.json\",\n  \"mitigation_path\": \"state/p9_path_a_r16_3seed_2026_05_04/mitigation_comparison.json\"\n}\n"
        write_file(marker_path, marker_body)
        step5_rc = 0
    }
    steps.push("{\"step\":5,\"name\":\"marker_land\",\"rc\":" + to_string(step5_rc) + "}")

    let ts_end = _ts_iso()
    let dispatch_json = "{\n" +
        "  \"schema\": \"anima/p9_path_a_r16_3seed_eval/dispatch/1\",\n" +
        "  \"applied\": " + (if apply { "true" } else { "false" }) + ",\n" +
        "  \"ts_start\": \"" + ts_start + "\",\n" +
        "  \"ts_end\": \"" + ts_end + "\",\n" +
        "  \"eval_host\": \"" + _json_escape(eval_host) + "\",\n" +
        "  \"provision_pod_requested\": " + (if provision_pod { "true" } else { "false" }) + ",\n" +
        "  \"r16_repos\": [\"" + _json_escape(to_string(repos[0])) + "\",\"" + _json_escape(to_string(repos[1])) + "\",\"" + _json_escape(to_string(repos[2])) + "\"],\n" +
        "  \"r64_baseline\": \"" + _json_escape(r64_baseline) + "\",\n" +
        "  \"steps\": [" + steps.join(",") + "],\n" +
        "  \"step1_tail\": \"" + _json_escape(step1_tail) + "\"\n" +
        "}\n"
    write_file(dispatch_path, dispatch_json)
    _log(log_path, "dispatch_complete", "{\"applied\":" + (if apply { "true" } else { "false" }) + ",\"step_rcs\":[" + to_string(step1_rc) + "," + to_string(step2_rc) + "," + to_string(step3_max_rc) + "," + to_string(step4_rc) + "," + to_string(step5_rc) + "]}")

    // Notify stub
    let summary = "[r16-3seed-eval] applied=" + (if apply { "yes" } else { "no" }) + " step1=" + to_string(step1_rc) + " step2=" + to_string(step2_rc) + " step3=" + to_string(step3_max_rc) + " step4=" + to_string(step4_rc) + " step5=" + to_string(step5_rc)
    let notify_path = base_dir + "/" + NOTIFY_PATH_REL
    let notify_body = "{\n  \"ts_utc\": \"" + _ts_iso() + "\",\n  \"summary\": \"" + _json_escape(summary) + "\",\n  \"verdict_path\": \"state/p9_path_a_r16_3seed_2026_05_04/verdict.json\",\n  \"notify_channel\": \"stub_stage0_no_native_push\"\n}\n"
    write_file(notify_path, notify_body)
    println("[notify] " + summary)
    println("[notify] payload at " + notify_path)

    if !apply { return 0 }
    if step1_rc == 0 && step2_rc == 0 && step3_max_rc == 0 && step4_rc == 0 && step5_rc == 0 { return 0 }
    return 1
}

// ─── main loop ─────────────────────────────────────────────────────

fn _run_loop(repos: array, base_dir: string, eval_host: string, provision_pod: bool, r64_baseline: string, final_tag: string, hf_min: int, log_path: string, dispatch_path: string, poll_sec: int, max_wait_sec: int, apply: bool, single: bool) -> int {
    let t0 = _now_epoch()
    let mut elapsed = 0
    let mut iter = 0
    while elapsed <= max_wait_sec {
        iter = iter + 1
        let r = _poll_three(repos, final_tag, hf_min, log_path)
        let statuses = r[0]
        let ready = to_int(r[1])
        if ready >= 3 {
            let label = "TRIGGER:3SEED_READY:s42=" + to_string(statuses[0]) + ",s43=" + to_string(statuses[1]) + ",s44=" + to_string(statuses[2])
            println("[3seed-watchdog] TRIGGER FIRED iter=" + to_string(iter) + " elapsed_sec=" + to_string(elapsed))
            _log(log_path, "trigger_fired", "{\"iter\":" + to_string(iter) + ",\"elapsed_sec\":" + to_string(elapsed) + ",\"label\":\"" + _json_escape(label) + "\"}")
            return _dispatch(repos, base_dir, eval_host, provision_pod, r64_baseline, log_path, dispatch_path, apply)
        }
        if single { return 0 }
        elapsed = _now_epoch() - t0
        if elapsed + poll_sec > max_wait_sec { break }
        exec_with_status("sleep " + to_string(poll_sec))
        elapsed = _now_epoch() - t0
    }
    println("[3seed-watchdog] TIMEOUT max_wait_sec=" + to_string(max_wait_sec) + " iter=" + to_string(iter))
    _log(log_path, "timeout", "{\"max_wait_sec\":" + to_string(max_wait_sec) + ",\"iter\":" + to_string(iter) + "}")
    return 0
}

// ─── selftest ─────────────────────────────────────────────────────

fn cmd_selftest() {
    println("── p9_path_a_r16_3seed_completion_watchdog selftest ──")
    println("inv:default_poll_interval_sec=600")
    println("inv:default_max_wait_sec=57600")
    println("inv:n_seeds=3")
    println("inv:seeds=42,43,44")
    println("inv:hf_min_ckpts_default=5")
    println("inv:expected_ckpt_steps=2000,4000,6000,8000,10000")
    println("inv:n_evals_total=45")
    println("inv:n_tasks=3 hellaswag,mmlu,triviaqa")
    println("inv:dispatch_steps=6 sha_check,evals,scp,per_seed_verdict,ensemble,marker")
    println("inv:falsifier_id=F-PATHA-MITIGATION-1")
    println("inv:falsifier_primary=mean_delta_triviaqa_geq_0_AND_ci_lo_normal_approx_geq_neg_0p5")
    println("inv:falsifier_cv_check=cv_lt_0p30_real_lift")
    println("inv:falsifier_secondary=mean_delta_hellaswag_geq_0_OR_mean_delta_mmlu_geq_0")
    println("inv:mitigation_verdict_states=MITIGATION_PASS,MITIGATION_PARTIAL,MITIGATION_FAIL_NO_LIFT,MITIGATION_FAIL_REGRESSION,MITIGATION_NO_DATA,MITIGATION_NO_R64_BASELINE")
    println("inv:verdict_tool_sha_lock=" + VERDICT_TOOL_SHA_LOCK)
    println("inv:eval_host_default=ubu1")
    println("inv:provision_pod_default=false")
    println("inv:non_mutation_dry_default=true")
    println("inv:notify=stub_stage0")
    println("inv:caveats=4 timing,cost,4bit_drift,sha_lock")

    let ts = _ts_iso()
    if len(ts) < 10 { eprintln("selftest=fail (ts_iso empty)"); exit(1) }
    let q_ok = _sq("hello world")
    if q_ok != "'hello world'" { eprintln("selftest=fail (sq mismatch: " + q_ok + ")"); exit(1) }
    println("selftest=ok ts=" + ts)
    println("DONE")
}

fn main() {
    let av = _argv()
    if _has(av, "--selftest") { cmd_selftest(); exit(0) }

    let s42_repo = _env_or("ANIMA_R16_3SEED_HF_S42", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1")
    let s43_repo = _env_or("ANIMA_R16_3SEED_HF_S43", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-s43-sft-stage1")
    let s44_repo = _env_or("ANIMA_R16_3SEED_HF_S44", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-s44-sft-stage1")
    let final_tag = _env_or("ANIMA_R16_HF_FINAL_TAG", "step-10000")
    let hf_min = to_int(_env_or("ANIMA_R16_HF_MIN_CKPTS", "5"))
    let r64_baseline = _env_or("ANIMA_R64_BASELINE", "/Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_r64_baseline.json")
    let provision_pod_str = _env_or("ANIMA_EVAL_PROVISION_POD", "0")
    let provision_pod = (provision_pod_str == "1" || provision_pod_str == "true")
    let eval_host = _env_or("ANIMA_EVAL_HOST", "ubu1")
    let base_dir = _env_or("ANIMA_R16_3SEED_BASE", BASE_DIR_DEFAULT)
    let log_path = base_dir + "/" + LOG_PATH_REL
    let dispatch_path = base_dir + "/" + DISPATCH_PATH_REL
    let poll_sec = to_int(_env_or("ANIMA_POLL_INTERVAL_SEC", "600"))
    let max_wait = to_int(_env_or("ANIMA_MAX_WAIT_SEC", "57600"))

    let apply = _has(av, "--apply")
    let single = _has(av, "--once")

    let repos = [s42_repo, s43_repo, s44_repo]

    println("[3seed-watchdog] start ts=" + _ts_iso() + " apply=" + (if apply { "yes" } else { "no" }) + " mode=" + (if single { "once" } else { "loop" }))
    println("[3seed-watchdog] s42=" + s42_repo)
    println("[3seed-watchdog] s43=" + s43_repo)
    println("[3seed-watchdog] s44=" + s44_repo)
    println("[3seed-watchdog] final_tag=" + final_tag + " min_ckpts=" + to_string(hf_min))
    println("[3seed-watchdog] r64_baseline=" + r64_baseline)
    println("[3seed-watchdog] base_dir=" + base_dir)
    println("[3seed-watchdog] eval_host=" + eval_host + " provision_pod=" + (if provision_pod { "yes" } else { "no" }))
    println("[3seed-watchdog] poll_sec=" + to_string(poll_sec) + " max_wait=" + to_string(max_wait))

    _log(log_path, "start", "{\"apply\":" + (if apply { "true" } else { "false" }) + ",\"mode\":\"" + (if single { "once" } else { "loop" }) + "\",\"seeds\":[\"42\",\"43\",\"44\"]}")

    let rc = _run_loop(repos, base_dir, eval_host, provision_pod, r64_baseline, final_tag, hf_min, log_path, dispatch_path, poll_sec, max_wait, apply, single)
    exit(rc)
}

main()
