// tool/d_25k_completion_watchdog.hexa — D 25K H100 completion watchdog + eval auto-trigger (raw#9 hexa-only Mac).
//
// PURPOSE
//   Polls (every 10 min, max 12h) for D 25K H100 training completion via three signals:
//     (a) state/p9_paradigm_d_25k_h100_2026_05_03/verdict.json exists + parses + verdict label valid
//     (b) ubu1:~/anima/state/p9_paradigm_d_25k_h100_2026_05_03/verdict.json exists (sister BG output)
//     (c) HF repo dancinlab/clm-v4-paradigm-d-25k-final populated (step-25000 tag landed)
//
//   GUARD-3 (success-signal checklist): file existence ≠ success. Each candidate signal must
//     - exist
//     - parse as JSON
//     - have verdict.label ∈ {SUCCESS, PARTIAL, COMPLETE, COMPLETED} OR step-25000 ckpt accessible
//
//   On trigger fire (any signal valid):
//     1. ssh ubu1: bash ~/anima/state/p9_paradigm_d_25k_eval_2026_05_03/run_all_d_ckpts.sh
//        (env: ANIMA_CKPT_REPO=dancinlab/clm-v4-paradigm-d-25k-final OR LOCAL_PARENT)
//     2. scp ubu1:~/anima/state/p9_paradigm_d_25k_eval_2026_05_03/ckpt_results/*.json
//        → state/p9_paradigm_d_25k_eval_2026_05_03_ckpt_results/
//     3. hexa run tool/p9_paradigm_d_verdict.hexa → state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json
//     4. If state/p9_a_prime_main_eval_2026_05_03_verdict.json also exists → cross-axis verdict
//     5. Land marker + handoff doc summary
//     6. Optional: PushNotification (deferred — Slack/notify hook absent in stage0)
//
// USAGE
//   hexa run tool/d_25k_completion_watchdog.hexa --selftest          # invariants check
//   hexa run tool/d_25k_completion_watchdog.hexa --once               # single poll, no loop
//   hexa run tool/d_25k_completion_watchdog.hexa --apply              # fire pipeline on hit (default DRY)
//   hexa run tool/d_25k_completion_watchdog.hexa --loop --apply       # full 12h watchdog
//
// CONFIG (env overrides)
//   ANIMA_D_VERDICT_LOCAL   default: state/p9_paradigm_d_25k_h100_2026_05_03/verdict.json
//   ANIMA_D_VERDICT_UBU1    default: /home/aiden/anima/state/p9_paradigm_d_25k_h100_2026_05_03/verdict.json
//   ANIMA_D_HF_REPO         default: dancinlab/clm-v4-paradigm-d-25k-final
//   ANIMA_D_HF_FINAL_TAG    default: step-25000
//   ANIMA_PATH_A_VERDICT    default: state/p9_a_prime_main_eval_2026_05_03_verdict.json
//   ANIMA_POLL_INTERVAL_SEC default: 600 (10 min)
//   ANIMA_MAX_WAIT_SEC      default: 43200 (12h)
//   ANIMA_LOG_PATH          default: state/d_25k_eval_auto_trigger_2026_05_03/watchdog_log.jsonl
//   ANIMA_DISPATCH_PATH     default: state/d_25k_eval_auto_trigger_2026_05_03/eval_dispatch.json
//
// EXIT CODES
//   0 = trigger fired + dispatch attempted (apply) OR loop completed without trigger (timeout)
//       OR --once finished (signal/no-signal both 0 in dry mode)
//   1 = selftest fail
//   2 = config error / unrecoverable env issue
//
// raw#9  hexa-only Mac          (ssh/scp/curl shelled out via exec_with_status)
// raw#15 SSOT this file         (this hexa is single source for trigger logic)
// raw#10 honest C3 (4 caveats):
//   (a) Watchdog 12h max-wait may miss late completion if H100 BG runs >12h (8h ETA + headroom);
//       on timeout, manual re-fire required (no auto-extend; exit 0 with TIMEOUT label).
//   (b) Cross-axis verdict requires Path A verdict ALSO ready. If Path A still pending,
//       cross-axis step is SKIPPED (D verdict still emitted standalone); rerun cross-axis
//       manually after Path A lands.
//   (c) Eval may surface issues with restored tokenizer + fresh ckpts (loader_smoketest used
//       a synthetic LoRA; real H100 ckpts may have config/dtype drift). Loader failures will
//       show as eval RC!=0 with no verdict JSON; dispatch logs RC for triage.
//   (d) PushNotification rate: this watchdog emits at most 1 notification per dispatch.
//       In stage0 hexa, notify is a stub (writes notify_payload.json); operator pulls via
//       chat. No native push integration this cycle.

let LOG_PATH_DEFAULT      = "/Users/ghost/core/anima/state/d_25k_eval_auto_trigger_2026_05_03/watchdog_log.jsonl"
let DISPATCH_PATH_DEFAULT = "/Users/ghost/core/anima/state/d_25k_eval_auto_trigger_2026_05_03/eval_dispatch.json"
let NOTIFY_PATH           = "/Users/ghost/core/anima/state/d_25k_eval_auto_trigger_2026_05_03/notify_payload.json"

// ─── INLINE_DEPRECATED[H42]: see shared/util/* canonical impls ────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _json_escape(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}
fn _ts_iso() -> string {
    let r = exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")
    return to_string(r[0]).trim()
}
fn _now_epoch() -> int {
    let r = exec_with_status("date -u +%s")
    return to_int(to_string(r[0]).trim())
}

fn _env_or(name: string, dflt: string) -> string {
    let r = exec_with_status("printf %s \"${" + name + ":-" + dflt + "}\"")
    return to_string(r[0])
}

fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _has(av, k) -> bool {
    let mut i = 0
    while i < len(av) { if to_string(av[i]) == k { return true }; i = i + 1 }
    return false
}

// ─── append-only JSONL log ─────────────────────────────────────────────

fn _log(path: string, event: string, payload_json: string) {
    let line = "{\"ts_utc\":\"" + _ts_iso() + "\",\"event\":\"" + event + "\",\"payload\":" + payload_json + "}\n"
    let q = _sq(line)
    let dir_cmd = "mkdir -p " + _sq(path.replace("/watchdog_log.jsonl", ""))
    exec_with_status(dir_cmd)
    exec_with_status("printf %s " + q + " >> " + _sq(path))
}

// ─── GUARD-3: signal-validity check ─────────────────────────────────────
// Each signal must satisfy: exists + parses + verdict label is one of valid set
// Returns: "VALID" | "MISSING" | "PARSE_ERROR" | "INVALID_LABEL"

fn _check_local_verdict(path: string) -> string {
    if !_file_exists(path) { return "MISSING" }
    let parse_q = "python3 -c 'import json,sys; d=json.load(open(\"" + path + "\")); v=d.get(\"verdict\",\"\"); l = v.get(\"label\",\"\") if isinstance(v,dict) else str(v); print(l.upper())' 2>/dev/null"
    let r = exec_with_status(parse_q)
    if r[1] != 0 { return "PARSE_ERROR" }
    let label = to_string(r[0]).trim()
    if label == "" { return "INVALID_LABEL" }
    if label.contains("SUCCESS") || label.contains("PARTIAL") || label.contains("COMPLETE") {
        return "VALID:" + label
    }
    if label.contains("ABORT") || label.contains("FAIL") {
        // training declared FAIL — still a completion signal (eval still runs to confirm)
        return "VALID:" + label
    }
    return "INVALID_LABEL:" + label
}

fn _check_ubu1_verdict(path: string) -> string {
    let probe = "ssh -o ConnectTimeout=8 -o BatchMode=yes ubu1 " + _sq("test -e " + path + " && python3 -c 'import json; d=json.load(open(\"" + path + "\")); v=d.get(\"verdict\",\"\"); print((v.get(\"label\",\"\") if isinstance(v,dict) else str(v)).upper())' 2>/dev/null") + " 2>/dev/null"
    let r = exec_with_status(probe)
    if r[1] != 0 { return "MISSING" }
    let label = to_string(r[0]).trim()
    if label == "" { return "PARSE_ERROR" }
    if label.contains("SUCCESS") || label.contains("PARTIAL") || label.contains("COMPLETE") || label.contains("ABORT") || label.contains("FAIL") {
        return "VALID:" + label
    }
    return "INVALID_LABEL:" + label
}

fn _check_hf_repo(repo: string, tag: string) -> string {
    // Cheap probe: HF Hub HEAD on /api/models/<repo>/tree/<tag>; rc 0 + non-empty JSON = present
    let url = "https://huggingface.co/api/models/" + repo + "/tree/" + tag
    let q = "curl -sSfL -o /dev/null -w '%{http_code}' " + _sq(url) + " 2>/dev/null"
    let r = exec_with_status(q)
    if r[1] != 0 { return "MISSING" }
    let code = to_string(r[0]).trim()
    if code == "200" { return "VALID:hf_tag_" + tag }
    return "MISSING:http_" + code
}

// ─── single poll ─────────────────────────────────────────────────────

fn _poll_once(local_path: string, ubu1_path: string, hf_repo: string, hf_tag: string, log_path: string) -> string {
    let s_local = _check_local_verdict(local_path)
    let s_ubu1  = _check_ubu1_verdict(ubu1_path)
    let s_hf    = _check_hf_repo(hf_repo, hf_tag)

    let payload = "{\"local\":\"" + _json_escape(s_local) + "\",\"ubu1\":\"" + _json_escape(s_ubu1) + "\",\"hf\":\"" + _json_escape(s_hf) + "\"}"
    _log(log_path, "poll", payload)
    println("[watchdog] " + _ts_iso() + " local=" + s_local + " ubu1=" + s_ubu1 + " hf=" + s_hf)

    if s_local.starts_with("VALID") { return "TRIGGER:LOCAL:" + s_local }
    if s_ubu1.starts_with("VALID")  { return "TRIGGER:UBU1:" + s_ubu1 }
    if s_hf.starts_with("VALID")    { return "TRIGGER:HF:" + s_hf }
    return "WAIT"
}

// ─── dispatch eval pipeline ──────────────────────────────────────────

fn _dispatch_eval(trigger_label: string, hf_repo: string, dispatch_path: string, log_path: string, apply: bool) -> int {
    let dispatch_dir = dispatch_path.replace("/eval_dispatch.json", "")
    exec_with_status("mkdir -p " + _sq(dispatch_dir))

    let mut steps = []
    let ts_start = _ts_iso()

    // Step 1: ssh ubu1 → run_all_d_ckpts.sh
    let ssh_cmd = "ssh -o ConnectTimeout=15 ubu1 " + _sq("ANIMA_CKPT_REPO=" + hf_repo + " bash ~/anima/state/p9_paradigm_d_25k_eval_2026_05_03/run_all_d_ckpts.sh 2>&1 | tail -200")
    let mut step1_rc = -1
    let mut step1_out = ""
    if apply {
        let r1 = exec_with_status(ssh_cmd)
        step1_rc = r1[1]
        step1_out = to_string(r1[0]).trim()
        if len(step1_out) > 4000 { step1_out = step1_out.substring(len(step1_out) - 4000, len(step1_out)) }
    }
    steps.push("{\"step\":1,\"name\":\"ssh_ubu1_run_all\",\"cmd\":\"" + _json_escape(ssh_cmd) + "\",\"rc\":" + to_string(step1_rc) + ",\"applied\":" + (if apply { "true" } else { "false" }) + "}")

    // Step 2: scp results → Mac
    let mac_results = "/Users/ghost/core/anima/state/p9_paradigm_d_25k_eval_2026_05_03_ckpt_results"
    exec_with_status("mkdir -p " + _sq(mac_results))
    let scp_cmd = "scp ubu1:~/anima/state/p9_paradigm_d_25k_eval_2026_05_03/ckpt_results/*.json " + mac_results + "/ 2>&1"
    let mut step2_rc = -1
    if apply && step1_rc == 0 {
        let r2 = exec_with_status(scp_cmd)
        step2_rc = r2[1]
    }
    steps.push("{\"step\":2,\"name\":\"scp_results\",\"cmd\":\"" + _json_escape(scp_cmd) + "\",\"rc\":" + to_string(step2_rc) + "}")

    // Step 3: hexa run p9_paradigm_d_verdict
    let verdict_cmd = "cd /Users/ghost/core/anima && hexa run tool/p9_paradigm_d_verdict.hexa 2>&1 && python3 /tmp/p9_paradigm_d_verdict_helper.py_tmp 2>&1"
    let mut step3_rc = -1
    if apply && step2_rc == 0 {
        let r3 = exec_with_status(verdict_cmd)
        step3_rc = r3[1]
    }
    steps.push("{\"step\":3,\"name\":\"d_verdict\",\"rc\":" + to_string(step3_rc) + "}")

    // Step 4: cross-axis (only if Path A verdict exists)
    let path_a = "/Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_verdict.json"
    let mut step4_rc = -1
    let mut step4_skip_reason = ""
    if apply && step3_rc == 0 {
        if _file_exists(path_a) {
            let cross_cmd = "cd /Users/ghost/core/anima && hexa run tool/p9_a_d_cross_axis_verdict.hexa 2>&1 && python3 /tmp/p9_a_d_cross_axis_verdict_helper.py_tmp 2>&1"
            let r4 = exec_with_status(cross_cmd)
            step4_rc = r4[1]
        } else {
            step4_skip_reason = "path_a_verdict_missing:" + path_a
        }
    }
    steps.push("{\"step\":4,\"name\":\"cross_axis\",\"rc\":" + to_string(step4_rc) + ",\"skip_reason\":\"" + _json_escape(step4_skip_reason) + "\"}")

    // Compose dispatch JSON
    let ts_end = _ts_iso()
    let dispatch_json = "{\n" +
        "  \"schema\": \"anima/d_25k_eval_auto_trigger/dispatch/1\",\n" +
        "  \"trigger\": \"" + _json_escape(trigger_label) + "\",\n" +
        "  \"applied\": " + (if apply { "true" } else { "false" }) + ",\n" +
        "  \"ts_start\": \"" + ts_start + "\",\n" +
        "  \"ts_end\": \"" + ts_end + "\",\n" +
        "  \"steps\": [" + steps.join(",") + "],\n" +
        "  \"step1_tail\": \"" + _json_escape(step1_out) + "\"\n" +
        "}\n"
    write_file(dispatch_path, dispatch_json)

    _log(log_path, "dispatch", "{\"trigger\":\"" + _json_escape(trigger_label) + "\",\"applied\":" + (if apply { "true" } else { "false" }) + ",\"step_rcs\":[" + to_string(step1_rc) + "," + to_string(step2_rc) + "," + to_string(step3_rc) + "," + to_string(step4_rc) + "]}")

    // Step 5: notify payload (stub — no native push in stage0)
    _emit_notify(trigger_label, step3_rc, step4_rc, step4_skip_reason)

    // Determine overall RC: dispatch success = step1+2+3 all 0
    if !apply { return 0 }
    if step1_rc == 0 && step2_rc == 0 && step3_rc == 0 { return 0 }
    return 1
}

fn _emit_notify(trigger: string, d_rc: int, cross_rc: int, cross_skip: string) {
    let d_status = if d_rc == 0 { "OK" } else { "RC=" + to_string(d_rc) }
    let cross_status = if cross_rc == 0 {
        "OK"
    } else {
        if cross_skip != "" { "SKIPPED:" + cross_skip } else { "RC=" + to_string(cross_rc) }
    }
    let summary = "[D-25K-eval] trigger=" + trigger + " d_verdict=" + d_status + " cross_axis=" + cross_status
    let payload = "{\n" +
        "  \"ts_utc\": \"" + _ts_iso() + "\",\n" +
        "  \"summary\": \"" + _json_escape(summary) + "\",\n" +
        "  \"d_verdict_path\": \"state/p9_paradigm_d_25k_eval_2026_05_03_verdict.json\",\n" +
        "  \"cross_axis_path\": \"state/p9_a_d_cross_axis_2026_05_03/cross_axis_verdict.json\",\n" +
        "  \"notify_channel\": \"stub_stage0_no_native_push\"\n" +
        "}\n"
    write_file(NOTIFY_PATH, payload)
    println("[notify] " + summary)
    println("[notify] payload at " + NOTIFY_PATH)
}

// ─── main loop ─────────────────────────────────────────────────────

fn _run_loop(local_path: string, ubu1_path: string, hf_repo: string, hf_tag: string, log_path: string, dispatch_path: string, poll_sec: int, max_wait_sec: int, apply: bool, single: bool) -> int {
    let t0 = _now_epoch()
    let mut elapsed = 0
    let mut iter = 0
    while elapsed <= max_wait_sec {
        iter = iter + 1
        let result = _poll_once(local_path, ubu1_path, hf_repo, hf_tag, log_path)
        if result.starts_with("TRIGGER") {
            println("[watchdog] TRIGGER FIRED iter=" + to_string(iter) + " elapsed_sec=" + to_string(elapsed) + " label=" + result)
            _log(log_path, "trigger_fired", "{\"iter\":" + to_string(iter) + ",\"elapsed_sec\":" + to_string(elapsed) + ",\"label\":\"" + _json_escape(result) + "\"}")
            let rc = _dispatch_eval(result, hf_repo, dispatch_path, log_path, apply)
            return rc
        }
        if single { return 0 }
        // sleep then re-poll
        elapsed = _now_epoch() - t0
        if elapsed + poll_sec > max_wait_sec { break }
        exec_with_status("sleep " + to_string(poll_sec))
        elapsed = _now_epoch() - t0
    }
    println("[watchdog] TIMEOUT max_wait_sec=" + to_string(max_wait_sec) + " iter=" + to_string(iter))
    _log(log_path, "timeout", "{\"max_wait_sec\":" + to_string(max_wait_sec) + ",\"iter\":" + to_string(iter) + "}")
    return 0
}

// ─── selftest ─────────────────────────────────────────────────────

fn cmd_selftest() {
    println("── d_25k_completion_watchdog selftest ──")
    println("inv:default_poll_interval_sec=600")
    println("inv:default_max_wait_sec=43200")
    println("inv:n_signals=3")
    println("inv:signals=local_verdict,ubu1_verdict,hf_repo_tag")
    println("inv:guard3_label_set=SUCCESS,PARTIAL,COMPLETE,ABORT,FAIL")
    println("inv:dispatch_steps=4")
    println("inv:dispatch=ssh_run_all,scp,d_verdict,cross_axis")
    println("inv:cross_axis_skip_if_path_a_missing=true")
    println("inv:notify=stub_stage0")
    println("inv:non_mutation_dry_default=true")

    // smoke: invariants present + helpers callable
    let ts = _ts_iso()
    if len(ts) < 10 {
        eprintln("selftest=fail (ts_iso empty)")
        exit(1)
    }
    let q_ok = _sq("hello world")
    if q_ok != "'hello world'" {
        eprintln("selftest=fail (sq mismatch: " + q_ok + ")")
        exit(1)
    }
    println("selftest=ok ts=" + ts)
    println("DONE")
}

fn main() {
    let av = _argv()
    if _has(av, "--selftest") { cmd_selftest(); exit(0) }

    let local_path = _env_or("ANIMA_D_VERDICT_LOCAL", "/Users/ghost/core/anima/state/p9_paradigm_d_25k_h100_2026_05_03/verdict.json")
    let ubu1_path  = _env_or("ANIMA_D_VERDICT_UBU1",  "/home/aiden/anima/state/p9_paradigm_d_25k_h100_2026_05_03/verdict.json")
    let hf_repo    = _env_or("ANIMA_D_HF_REPO",       "dancinlab/clm-v4-paradigm-d-25k-final")
    let hf_tag     = _env_or("ANIMA_D_HF_FINAL_TAG",  "step-25000")
    let log_path   = _env_or("ANIMA_LOG_PATH",        LOG_PATH_DEFAULT)
    let disp_path  = _env_or("ANIMA_DISPATCH_PATH",   DISPATCH_PATH_DEFAULT)
    let poll_sec   = to_int(_env_or("ANIMA_POLL_INTERVAL_SEC", "600"))
    let max_wait   = to_int(_env_or("ANIMA_MAX_WAIT_SEC",      "43200"))

    let apply  = _has(av, "--apply")
    let single = _has(av, "--once")
    let loop_m = _has(av, "--loop")

    println("[watchdog] start ts=" + _ts_iso() + " apply=" + (if apply { "yes" } else { "no" }) + " mode=" + (if single { "once" } else { "loop" }))
    println("[watchdog] local=" + local_path)
    println("[watchdog] ubu1=" + ubu1_path)
    println("[watchdog] hf=" + hf_repo + " tag=" + hf_tag)
    println("[watchdog] poll_sec=" + to_string(poll_sec) + " max_wait=" + to_string(max_wait))

    _log(log_path, "start", "{\"apply\":" + (if apply { "true" } else { "false" }) + ",\"mode\":\"" + (if single { "once" } else { "loop" }) + "\"}")

    let rc = _run_loop(local_path, ubu1_path, hf_repo, hf_tag, log_path, disp_path, poll_sec, max_wait, apply, single)
    exit(rc)
}

main()
