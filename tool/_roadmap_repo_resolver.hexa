#!hexa strict
// @tool slug=_roadmap_repo_resolver
// @sentinel raw9 raw10 raw11 raw15 ai-native cross-repo
// @usage hexa tool/_roadmap_repo_resolver.hexa <subcmd> [args]
// @resolver-bypass safe
//
// tool/_roadmap_repo_resolver.hexa — cross-repo path adapter helper for mk2 .roadmap toolchain
//
// PURPOSE
//   Single-source-of-truth for repo resolution used by 4 mk2 tools
//   (roadmap_op / lint / compile / render). Reads
//   /Users/<user>/core/hive/config/cross_repo_registry.json (Option D Hybrid).
//
// SUBCOMMANDS (CLI surface; query mode for tools without `use`)
//   resolve-root [--cwd <path>]       → prints repo root for cwd (heuristic: .raw or .raw-ref)
//   list-repos                        → prints JSON array of all 6 repo entries
//   list-mk2                          → prints JSON array of mk2_roadmap=true repo paths
//   resolve-dep <spec>                → prints absolute path; spec format "<repo_name>:<rel_path>"
//   list-domains [--repo <path>]      → prints JSON array of discovered .roadmap.<domain> stems
//   selftest                          → S1..S6
//
// CONFIG
//   registry path: /Users/<user>/core/hive/config/cross_repo_registry.json
//   env override:  HIVE_CROSS_REPO_REGISTRY (absolute path)
//   force repo:    HIVE_CROSS_REPO_FORCE_REPO (skips heuristic)
//
// RAW
//   raw#9 hexa-only       raw#10 honest C3
//   raw#11 snake_case     raw#15 SSOT atomic (read-only here)
//   raw270/271 ai-native readme + module mandate (helper module = exempt single-file)
//   raw272 lint extension raw273 sentinel attrs

let REGISTRY_DEFAULT = "/Users/<user>/core/hive/config/cross_repo_registry.json"

fn _sh_quote(s: string) -> string { return "'" + s.replace("'", "'\\''") + "'" }

fn _file_exists(p: string) -> bool {
    return to_string(exec("test -f " + _sh_quote(p) + " && echo 1 || echo 0")).trim() == "1"
}

fn _dir_exists(p: string) -> bool {
    return to_string(exec("test -d " + _sh_quote(p) + " && echo 1 || echo 0")).trim() == "1"
}

fn _read_file(p: string) -> string {
    if !_file_exists(p) { return "" }
    return to_string(exec("cat " + _sh_quote(p)))
}

fn _env(name: string) -> string {
    return to_string(exec("printf '%s' \"${" + name + ":-}\"")).trim()
}

fn _registry_path() -> string {
    let ovr = _env("HIVE_CROSS_REPO_REGISTRY")
    if len(ovr) > 0 { return ovr }
    return REGISTRY_DEFAULT
}

// whitespace-tolerant index helper: find "<field>" then skip ws + ':' + ws
fn _find_field_value_start(blob: string, field: string) -> int {
    let key = "\"" + field + "\""
    let i = blob.index_of(key)
    if i < 0 { return -1 }
    let mut k = i + len(key)
    // skip whitespace
    while k < len(blob) && (blob.substring(k, k + 1) == " " || blob.substring(k, k + 1) == "\t" || blob.substring(k, k + 1) == "\n") {
        k = k + 1
    }
    if k >= len(blob) || blob.substring(k, k + 1) != ":" { return -1 }
    k = k + 1
    while k < len(blob) && (blob.substring(k, k + 1) == " " || blob.substring(k, k + 1) == "\t" || blob.substring(k, k + 1) == "\n") {
        k = k + 1
    }
    return k
}

// Naive JSON field extraction over a single object substring.
// Used because we only need a flat schema (name/path/active/mk2_roadmap).
fn _extract_str_field(blob: string, field: string) -> string {
    let k = _find_field_value_start(blob, field)
    if k < 0 { return "" }
    let after = blob.substring(k, len(blob))
    if len(after) == 0 { return "" }
    if after.substring(0, 1) != "\"" { return "" }
    let inner = after.substring(1, len(after))
    let end = inner.index_of("\"")
    if end < 0 { return "" }
    return inner.substring(0, end)
}

fn _extract_bool_field(blob: string, field: string) -> bool {
    let k = _find_field_value_start(blob, field)
    if k < 0 { return false }
    let after = blob.substring(k, len(blob))
    if len(after) >= 4 && after.substring(0, 4) == "true" { return true }
    return false
}

// Parse the "repos":[ {...},{...}, ... ] array — return array of object blob substrings.
fn _split_repo_objects(content: string) -> array {
    let k = _find_field_value_start(content, "repos")
    if k < 0 { return [] }
    let after = content.substring(k, len(content))
    if len(after) == 0 || after.substring(0, 1) != "[" { return [] }
    let rest = after.substring(1, len(after))
    // walk, depth-tracking braces, segment when depth returns to 0 and a comma or ] is seen
    let mut out = []
    let mut depth = 0
    let mut start = -1
    let mut k = 0
    while k < len(rest) {
        let ch = rest.substring(k, k + 1)
        if ch == "{" {
            if depth == 0 { start = k }
            depth = depth + 1
        } else if ch == "}" {
            depth = depth - 1
            if depth == 0 && start >= 0 {
                out = out.push(rest.substring(start, k + 1))
                start = -1
            }
        } else if ch == "]" && depth == 0 {
            return out
        }
        k = k + 1
    }
    return out
}

// ─── public API ───────────────────────────────────────────────

pub fn registry_repos() -> array {
    let p = _registry_path()
    let content = _read_file(p)
    if len(content) == 0 { return [] }
    return _split_repo_objects(content)
}

pub fn repo_path_by_name(name: string) -> string {
    let repos = registry_repos()
    let mut i = 0
    while i < len(repos) {
        let blob = repos[i]
        if _extract_str_field(blob, "name") == name {
            return _extract_str_field(blob, "path")
        }
        i = i + 1
    }
    return ""
}

pub fn all_mk2_roadmap_repos() -> array {
    let repos = registry_repos()
    let mut out = []
    let mut i = 0
    while i < len(repos) {
        let blob = repos[i]
        if _extract_bool_field(blob, "mk2_roadmap") && _extract_bool_field(blob, "active") {
            out = out.push(_extract_str_field(blob, "path"))
        }
        i = i + 1
    }
    return out
}

// pwd-based heuristic: walk up from cwd until a directory containing
// either .raw or .raw-ref is found. Returns "" on miss.
pub fn resolve_repo_root(cwd_in: string) -> string {
    // env override short-circuit
    let forced = _env("HIVE_CROSS_REPO_FORCE_REPO")
    if len(forced) > 0 { return forced }
    let cwd = if len(cwd_in) > 0 { cwd_in } else { to_string(exec("pwd")).trim() }
    let mut cur = cwd
    let mut tries = 0
    while tries < 32 && len(cur) > 1 {
        if _file_exists(cur + "/.raw") || _file_exists(cur + "/.raw-ref") {
            return cur
        }
        // step up
        let parent = to_string(exec("dirname " + _sh_quote(cur))).trim()
        if parent == cur { return "" }
        cur = parent
        tries = tries + 1
    }
    return ""
}

// spec format: "<repo_name>:<rel_path>" e.g. "nexus:.roadmap.qrng"
// returns absolute path or "" on miss.
pub fn resolve_dependency(spec: string) -> string {
    let colon = spec.index_of(":")
    if colon < 1 { return "" }
    let name = spec.substring(0, colon)
    let rel = spec.substring(colon + 1, len(spec))
    let root = repo_path_by_name(name)
    if len(root) == 0 { return "" }
    if len(rel) > 0 && rel.substring(0, 1) == "/" {
        return root + rel
    }
    return root + "/" + rel
}

// Discover .roadmap.<domain> file stems under given repo root.
// Excludes .lock / .hxc / .tmp.* suffixes.
pub fn list_domains(repo_root: string) -> array {
    if !_dir_exists(repo_root) { return [] }
    let raw = to_string(exec("ls -1A " + _sh_quote(repo_root) + " 2>/dev/null | grep '^\\.roadmap\\.' || true"))
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let nm = lines[i].trim()
        if len(nm) > 9 {
            // require startswith ".roadmap."
            if nm.substring(0, 9) == ".roadmap." {
                let stem = nm.substring(9, len(nm))
                // skip artifacts
                let mut keep = true
                if stem.index_of(".hxc") >= 0 { keep = false }
                if stem.index_of(".lock") >= 0 { keep = false }
                if stem.index_of(".tmp") >= 0 { keep = false }
                if len(stem) == 0 { keep = false }
                if keep { out = out.push(stem) }
            }
        }
        i = i + 1
    }
    return out
}

// ─── CLI dispatcher ───────────────────────────────────────────

fn _arg_value(arr: array, flag: string) -> string {
    let mut i = 0
    while i < len(arr) {
        if arr[i] == flag {
            if i + 1 < len(arr) { return arr[i + 1] }
        }
        i = i + 1
    }
    return ""
}

fn _emit_str_array(a: array) -> string {
    let mut out = "["
    let mut i = 0
    while i < len(a) {
        if i > 0 { out = out + "," }
        out = out + "\"" + a[i].replace("\"", "\\\"") + "\""
        i = i + 1
    }
    out = out + "]"
    return out
}

fn _selftest() -> int {
    let mut pass = 0
    let mut total = 0
    // S1 — registry file exists
    total = total + 1
    if _file_exists(_registry_path()) { pass = pass + 1 }
    // S2 — registry parses ≥6 repos
    total = total + 1
    if len(registry_repos()) >= 6 { pass = pass + 1 }
    // S3 — anima path resolves
    total = total + 1
    if repo_path_by_name("anima") == "/Users/<user>/core/anima" { pass = pass + 1 }
    // S4 — mk2 list contains anima + nexus, excludes airgenome
    total = total + 1
    let mk2 = all_mk2_roadmap_repos()
    let mut s4_anima = false
    let mut s4_nexus = false
    let mut s4_air = false
    let mut k = 0
    while k < len(mk2) {
        if mk2[k] == "/Users/<user>/core/anima" { s4_anima = true }
        if mk2[k] == "/Users/<user>/core/nexus" { s4_nexus = true }
        if mk2[k] == "/Users/<user>/core/airgenome" { s4_air = true }
        k = k + 1
    }
    if s4_anima && s4_nexus && !s4_air { pass = pass + 1 }
    // S5 — resolve_dependency for nexus:.roadmap.qrng matches absolute path
    total = total + 1
    if resolve_dependency("nexus:.roadmap.qrng") == "/Users/<user>/core/nexus/.roadmap.qrng" { pass = pass + 1 }
    // S6 — list_domains anima ≥ 15 (15 substrate + meta, snapshot says 21)
    total = total + 1
    if len(list_domains("/Users/<user>/core/anima")) >= 15 { pass = pass + 1 }

    println("[selftest] _roadmap_repo_resolver " + to_string(pass) + "/" + to_string(total) + " PASS")
    if pass == total { return 0 }
    return 1
}

let _argv = args()
if len(_argv) < 3 {
    println("{\"error\":\"usage: _roadmap_repo_resolver <subcmd>\",\"subcmds\":[\"resolve-root\",\"list-repos\",\"list-mk2\",\"resolve-dep\",\"list-domains\",\"selftest\"]}")
    exit(1)
}
let _cmd = to_string(_argv[2])
let mut _rest = []
let mut _i = 3
while _i < len(_argv) {
    _rest = _rest.push(to_string(_argv[_i]))
    _i = _i + 1
}
let mut _rc = 0
if _cmd == "resolve-root" {
    let cwd = _arg_value(_rest, "--cwd")
    let root = resolve_repo_root(cwd)
    if len(root) == 0 { println(""); _rc = 1 } else { println(root); _rc = 0 }
} else if _cmd == "list-repos" {
    let repos = registry_repos()
    let mut paths = []
    let mut k = 0
    while k < len(repos) {
        paths = paths.push(_extract_str_field(repos[k], "path"))
        k = k + 1
    }
    println(_emit_str_array(paths))
} else if _cmd == "list-mk2" {
    println(_emit_str_array(all_mk2_roadmap_repos()))
} else if _cmd == "resolve-dep" {
    if len(_rest) < 1 { println(""); _rc = 1 } else {
        let r = resolve_dependency(_rest[0])
        if len(r) == 0 { println(""); _rc = 1 } else { println(r); _rc = 0 }
    }
} else if _cmd == "list-domains" {
    let repo = if len(_arg_value(_rest, "--repo")) > 0 { _arg_value(_rest, "--repo") } else { "/Users/<user>/core/anima" }
    println(_emit_str_array(list_domains(repo)))
} else if _cmd == "selftest" {
    _rc = _selftest()
} else {
    println("{\"error\":\"unknown subcmd\",\"got\":\"" + _cmd + "\"}")
    _rc = 1
}
exit(_rc)
