// ─── §1 helpers — exec / IO / time ───

fn _str(x) -> string { return to_string(x) }

fn _now_utc() -> string {
    return _str(exec("date -u +%FT%TZ")).trim()
}

fn _ssh_cmd(remote_cmd: string) -> string {
    let pieces = ["ssh", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=no",
                  "-i", POD_KEY, POD_USER + "@" + POD_HOST, "-p", POD_PORT,
                  "'" + remote_cmd + "'"]
    let mut cmd = ""
    let mut i = 0
    while i < pieces.len() {
        if i > 0 { cmd = cmd + " " }
        cmd = cmd + pieces[i]
        i = i + 1
    }
    return cmd
}

fn _scp_to_pod(local: string, remote: string) -> string {
    return "scp -o ConnectTimeout=10 -o StrictHostKeyChecking=no -i " + POD_KEY +
           " -P " + POD_PORT + " " + local + " " + POD_USER + "@" + POD_HOST + ":" + remote
}

fn _scp_from_pod(remote: string, local: string) -> string {
    return "scp -o ConnectTimeout=10 -o StrictHostKeyChecking=no -i " + POD_KEY +
           " -P " + POD_PORT + " " + POD_USER + "@" + POD_HOST + ":" + remote + " " + local
}

