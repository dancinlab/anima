#!hexa strict
// tool/hf_upload_mk2.hexa — Anima HF Upload Pipeline mk2 (raw#9 STRICT hexa-only)
//
// @tool(slug="anima_hf_upload_mk2", desc="Canonical HF upload wrapper. Validates README + naming, walks files via shell find, computes sha256 via shasum, shells out to `hf` CLI (huggingface_hub v1.8.0+) for repo create / upload / tag. Writes audit log to state/hf_upload_audit/. raw#9 STRICT — zero .py on Mac side.")
// @usage(hexa run tool/hf_upload_mk2.hexa --selftest)
// @usage(hexa run tool/hf_upload_mk2.hexa --dry-run --repo dancinlab/clm-v4-sft-stage1 --ckpt /path/to/ckpt --readme /path/to/README.md --tag step-25k)
// @usage(hexa run tool/hf_upload_mk2.hexa --upload --repo dancinlab/clm-v4-sft-stage1 --ckpt /path/to/ckpt --readme /path/to/README.md --tag step-25k --private)
// @sentinel(__ANIMA_HF_UPLOAD_MK2__ <PASS|FAIL>)
//
// Spec ref: docs/anima_hf_upload_mk2_spec_2026_05_03.md
// raw#9 strict ref: docs/py_to_hexa_only_landed_2026_05_03.ai.md
//
// raw#9 STRICT (2026-05-03): py_to_hexa_only sweep eliminated the previously
// allowed _python_bridge/hf_upload_runner.py escape valve. Network work is
// now done via the `hf` CLI (huggingface_hub v1.8.0+ ships full coverage:
// `hf repo create --exist-ok`, `hf upload`, `hf repo tag create`). sha256
// via /usr/bin/shasum, file walk via /usr/bin/find. ZERO .py on Mac side.
//
// raw#10 honest caveats:
//   - HF rate-limit (HTTP 429) is handled by `hf` CLI internals (not by
//     this wrapper); exponential backoff coordination across concurrent
//     parallel BG subagents is NOT guaranteed.
//   - Error-handling parity vs the legacy py bridge: the bridge returned
//     a structured JSON map per attempt; the CLI surface is text + exit
//     code, so granular error classes ("HfHubHTTPError", "no_token", etc.)
//     are flattened into the CLI stderr capture. Audit log captures full
//     CLI stdout+stderr; programmatic error-class branching is reduced.
//   - Debug surface area shrinks: no Python tracebacks. `hf upload --quiet`
//     not used (default verbose) so progress + diagnostic context survives.
//
// raw#15: no personal-path leak. All paths constructed via $HOME env.
//
// v2.2.0 (2026-05-30) — 3 bug fixes found during the 20-checkpoint HF backup
// campaign (handoff 82fef021 + 486e78d8):
//   Bug 1 (CRITICAL false PASS): success was gated on `exec("echo $?")`, which
//     runs in a FRESH shell and therefore reports the exit status of `echo`,
//     not of the prior `hf upload` exec — so upload_rc was effectively always
//     0 and a 401 still printed PASS / wrote outcome:ok (the audit commit_url
//     even held a python Traceback). FIX: success now requires a REAL commit
//     URL — starts with https://huggingface.co/ AND contains none of
//     Traceback / Error / 401 / Unauthorized. _hf_step_ok() is the gate.
//   Bug 2 (--type drift): `hf repo create ... --type model` is rejected by hf
//     0.36.2 (unrecognized arguments). FIX: `--repo-type model` (verified via
//     `hf repo create --help`); kept --exist-ok (idempotent, best-effort).
//   Bug 3 (token in argv): token was passed as `--token <value>`, exposing it
//     in `ps`/argv. FIX: token is passed via the HF_TOKEN env var as an inline
//     `HF_TOKEN=<value> hf ...` prefix on every hf invocation (upload, repo
//     create, readme upload, tag create). hf reads HF_TOKEN natively. NOTE: an
//     inline env assignment is NOT in the child's argv (ps-invisible) — it sits
//     only in the child environment (/proc/<pid>/environ, same-user only),
//     strictly less leaky than --token in argv. hexa exec() spawns a fresh
//     shell per call, so a one-time `export` does not persist; the inline form
//     is the least-leaky option hexa supports per-call.

// Cosmetic polish 2026-05-03: printenv → echo "$VAR" (Alpine container has
// no `printenv`; POSIX echo works on both Alpine + macOS). See
// state/cosmetic_polish_batch_2026_05_03/audit.json.
//
// Token resolution canonicalization 2026-05-04: collapsed legacy multi-source
// fallback chain (HF_TOKEN env → HUGGING_FACE_HUB_TOKEN env → ~/.huggingface/token
// → ~/.cache/huggingface/token → /workspace/.hf_token) down to the canonical
// 3-tier per docs/hf_token_canonical_baseline_2026_05_04.md:
//   1) `secret get huggingface.token`        (canonical SSOT, HF official naming)
//   2) ~/.cache/huggingface/token            (HF CLI cache fallback)
//   3) HF_TOKEN env                          (override)
// Removed: `hf.token` legacy alias, `.secrets/hf_token`, `~/.huggingface/token`,
// `/workspace/.hf_token`, HUGGING_FACE_HUB_TOKEN env. raw#10 caveat: precedence
// changed — operators relying on HF_TOKEN env to override the secret store must
// now `unset` the secret store key OR continue to set HF_TOKEN AND rely on the
// fact that secret store lookup runs first (env now last-tier).
let VERSION = "2.2.0"
let HOME = exec("echo \"$HOME\"").trim()
let ANIMA_ROOT = HOME + "/core/anima"
let DEFAULT_AUDIT_DIR = ANIMA_ROOT + "/state/hf_upload_audit"
let DEFAULT_LEDGER = ANIMA_ROOT + "/state/hf_upload_ledger_2026_05.jsonl"

// `hf` CLI resolution — prefer override, else PATH lookup. v1.8.0+ required
// for `hf repo tag create` coverage.
fn _hf_cli() -> str {
    let override = exec("echo \"$ANIMA_HF_CLI\"").trim()
    if override.len() > 0 { return override }
    let cli = exec("command -v hf 2>/dev/null").trim()
    if cli.len() > 0 { return cli }
    return "hf"
}

// ─── arg parsing ───────────────────────────────────────────────────────

fn _arg_get(argv: [str], flag: str) -> str {
    let mut i = 0
    while i < argv.len() {
        if argv[i] == flag {
            if i + 1 < argv.len() { return argv[i + 1] }
            return ""
        }
        i = i + 1
    }
    return ""
}

fn _arg_has(argv: [str], flag: str) -> int {
    let mut i = 0
    while i < argv.len() {
        if argv[i] == flag { return 1 }
        i = i + 1
    }
    return 0
}

// ─── README validation ─────────────────────────────────────────────────
// 5 required H2 headings (mk2 spec § README enforcement)

fn _readme_required_headings() -> [str] {
    return ["## Origin", "## Falsifiers", "## Substrate", "## Caveats", "## Composability"]
}

fn _readme_validate(readme_path: str) -> str {
    if !file_exists(readme_path) {
        return "FAIL: README not found at " + readme_path
    }
    let content = read_file(readme_path)
    let required = _readme_required_headings()
    let mut missing = []
    let mut i = 0
    while i < required.len() {
        let h = required[i]
        // Match on a line boundary: heading must appear with newline before+after
        // (or at file start). Approximation: substring contains.
        if !content.contains("\n" + h + "\n") && !content.starts_with(h + "\n") {
            missing = missing.push(h)
        }
        i = i + 1
    }
    if missing.len() > 0 {
        let mut msg = "FAIL: README missing required H2 headings:"
        let mut j = 0
        while j < missing.len() {
            msg = msg + " [" + missing[j] + "]"
            j = j + 1
        }
        msg = msg + " (template: tool/hf_readme_template.md)"
        return msg
    }
    // Caveats section must have at least 3 bullet items (raw#10 enforcement)
    let cav_idx = content.index_of("## Caveats")
    if cav_idx >= 0 {
        let after = content.substring(cav_idx, content.len())
        let next_h2 = after.index_of("\n## ")
        let block_end = if next_h2 > 0 { cav_idx + next_h2 } else { content.len() }
        let block = content.substring(cav_idx, block_end)
        let mut bullets = 0
        let lines = block.split("\n")
        let mut k = 0
        while k < lines.len() {
            let ln = lines[k].trim()
            if ln.starts_with("- ") || ln.starts_with("* ") { bullets = bullets + 1 }
            k = k + 1
        }
        if bullets < 3 {
            return "FAIL: Caveats section has " + str(bullets) + " bullets (mk2 requires >=3 honest caveats per raw#10)"
        }
    }
    return "OK"
}

// ─── Naming validation (mk2 convention) ────────────────────────────────
// Format: <org>/<family>-<version>-<stage>[-<modifier>]
//   org      = lowercase alnum + dash, 2-32 chars
//   family   = clm | alm | blm | vlm | slm | tlm | nlm | mlm | llm | hexad | composite
//   version  = v1 | v2 | v3 | v4 | v<N>
//   stage    = sft-stage<N> | dpo | merged | base | preview | dev | paradigm-<letter>
//   modifier = optional, lowercase alnum + dash
//
// Family enum reconciliation (2026-05-03):
//   - Reconciled with docs/anima_hf_naming_convention_mk2_spec_2026_05_03.md §3.1
//     (canonical SSOT for family table).
//   - Spec previously listed: blm | clm | tlm | vlm | slm | nlm
//   - Validator previously listed: clm | alm | blm | vlm | slm | tlm | mlm | hexad | composite
//   - Union (this file): both retained additively + `llm` for Path A
//     (Llama-derived LM, see docs/p9_a_prime_path_decision_landed_2026_05_03.ai.md).
//   - Reconciliation handoff: docs/anima_hf_naming_family_reconcile_2026_05_03.ai.md
//
// Stage-prefix `paradigm-{letter}` amendment (2026-05-03):
//   - Surfaced by Paradigm J HF recovery BG (a915bca5) which had to bypass
//     the mk2 wrapper because `paradigm-j-50k-step-5k` was rejected
//     ("stage must start with sft-stage|dpo|merged|base|preview|dev").
//   - Spec amendment: docs/anima_hf_naming_convention_mk2_spec_2026_05_03.md §3.2.1.
//   - paradigm_id enum (a|a-prime|b|c|d|e|f|g|h|i|j) tracked in spec §3.3.
//     Validator accepts the broader `paradigm-` prefix to stay forward-compatible
//     with future paradigm letters; the §3.3 spec table remains the SSOT for
//     which letters are *ratified* — informal letters MUST land a §3.3 row first.
//
// Sister BG (mk2 naming convention spec) may write its output to
// docs/anima_naming_convention_mk2_2026_05_03.md. We import its regex
// stub if present; otherwise inline the spec above.

fn _naming_allowed_families() -> [str] {
    return ["clm", "alm", "blm", "vlm", "slm", "tlm", "nlm", "mlm", "llm", "hexad", "composite"]
}

fn _naming_allowed_stage_prefixes() -> [str] {
    // Amendment 2026-05-03 (paradigm-{letter}): added `paradigm-` prefix to
    // unblock Paradigm-axis training tracks (e.g. clm-v4-paradigm-j-50k-step-5k).
    // See spec §3.2.1 and §3.3 (paradigm_id enum SSOT).
    return ["sft-stage", "dpo", "merged", "base", "preview", "dev", "paradigm-"]
}

// §3.7 grace-period fallback (added 2026-05-04 by BG-NAMING-VALIDATOR-PATCH).
// Spec ref: docs/anima_hf_naming_convention_mk2_spec_2026_05_03.md §3.7 + §8.1.
// Companion doc: docs/anima_hf_naming_clm_amendment_landed_2026_05_04.ai.md (cond.2 caveat C2).
//
// Motivation: BG-NAMING-AMEND landed cond.2 canonical = clm-v4-mk2-v1 which is
// EXT-conformant under §10.2 EXT regex (legacy `\d+-\d+` variant slot, also
// `mk\d+-v\d+` extended form) and admitted by §3.7 grace-period until 2026-06-02.
// The strict `_naming_allowed_stage_prefixes()` enum (above) does not list
// `mk` because `mk2-v1` is not a stage — it is a *variant slot* per §3.7.
// This regex-based fallback ADMITS the variant form during grace.
//
// Grace expiry: 2026-06-02 (end of 30-day window per §8.1). After that:
//   (a) repos must rename to canonical CANON form, OR
//   (b) another amendment cycle must extend grace (raw#15 additive only).
//
// This function is *additive*: it only runs after the strict enum check fails.
// Strict enum behavior is preserved verbatim (raw#15).
fn _grace_period_active() -> int {
    // ISO8601 string compare suffices for date-only comparison.
    // today_utc <= "2026-06-02" → grace active.
    let today = exec("date -u +%Y-%m-%d").trim()
    let cutoff = "2026-06-02"
    if today.len() == 10 && today <= cutoff { return 1 }
    return 0
}

fn _is_digit(c: str) -> int {
    if c.len() != 1 { return 0 }
    if c >= "0" && c <= "9" { return 1 }
    return 0
}

fn _matches_legacy_variant(stage_join: str) -> int {
    // §3.7 legacy variant form: `mk\d+-v\d+` (e.g. mk1-v0, mk2-v1, mk3-v12).
    // Implementation: split on '-' into exactly 2 tokens "mk\d+" and "v\d+",
    // then verify each prefix and digit suffix.
    let n = stage_join.len()
    if n < 6 { return 0 }  // minimum "mk0-v0" = 6 chars; no shorter form valid
    // Must contain exactly one '-' (because both tokens have no internal '-').
    let parts = stage_join.split("-")
    if parts.len() != 2 { return 0 }
    let lhs = parts[0]
    let rhs = parts[1]
    // lhs = "mk" + >=1 digits
    if lhs.len() < 3 { return 0 }
    if lhs.substring(0, 2) != "mk" { return 0 }
    let mut i = 2
    while i < lhs.len() {
        if _is_digit(lhs.substring(i, i + 1)) != 1 { return 0 }
        i = i + 1
    }
    // rhs = "v" + >=1 digits
    if rhs.len() < 2 { return 0 }
    if rhs.substring(0, 1) != "v" { return 0 }
    let mut j = 1
    while j < rhs.len() {
        if _is_digit(rhs.substring(j, j + 1)) != 1 { return 0 }
        j = j + 1
    }
    return 1
}

fn _is_lower_alnum_dash(s: str) -> int {
    if s.len() == 0 { return 0 }
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        let ok = (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "-"
        if !ok { return 0 }
        i = i + 1
    }
    return 1
}

fn _naming_validate(repo: str) -> str {
    if !repo.contains("/") {
        return "FAIL: repo must be <org>/<name> form (got: " + repo + ")"
    }
    let parts = repo.split("/")
    if parts.len() != 2 {
        return "FAIL: repo must have exactly one '/' (got: " + repo + ")"
    }
    let org = parts[0]
    let name = parts[1]
    if org.len() < 2 || org.len() > 32 {
        return "FAIL: org must be 2-32 chars (got: '" + org + "' len=" + str(org.len()) + ")"
    }
    if _is_lower_alnum_dash(org) != 1 {
        return "FAIL: org must be lowercase alnum+dash (got: '" + org + "')"
    }
    if _is_lower_alnum_dash(name) != 1 {
        return "FAIL: name must be lowercase alnum+dash (got: '" + name + "')"
    }
    let name_parts = name.split("-")
    if name_parts.len() < 3 {
        return "FAIL: name must be <family>-<version>-<stage>[-<mod>] (got: '" + name + "')"
    }
    let family = name_parts[0]
    let families = _naming_allowed_families()
    let mut fam_ok = 0
    let mut fi = 0
    while fi < families.len() {
        if families[fi] == family { fam_ok = 1 }
        fi = fi + 1
    }
    if fam_ok != 1 {
        let mut fams = ""
        let mut fj = 0
        while fj < families.len() {
            if fj > 0 { fams = fams + "|" }
            fams = fams + families[fj]
            fj = fj + 1
        }
        return "FAIL: family must be one of {" + fams + "} (got: '" + family + "')"
    }
    let version = name_parts[1]
    if !version.starts_with("v") || version.len() < 2 {
        return "FAIL: version must be 'v<N>' (got: '" + version + "')"
    }
    // Stage spans parts[2..N]: stage tokens may contain dashes (e.g., "sft-stage1").
    // Join remaining parts and check whether the joined stage starts with any
    // allowed prefix. Also accept exact matches for the bare-token stages.
    let mut stage_join = ""
    let mut sp_i = 2
    while sp_i < name_parts.len() {
        if sp_i > 2 { stage_join = stage_join + "-" }
        stage_join = stage_join + name_parts[sp_i]
        sp_i = sp_i + 1
    }
    let stages = _naming_allowed_stage_prefixes()
    let mut st_ok = 0
    let mut si = 0
    while si < stages.len() {
        let sp = stages[si]
        if stage_join == sp || stage_join.starts_with(sp) { st_ok = 1 }
        si = si + 1
    }
    if st_ok != 1 {
        // §3.7 grace-period fallback (added 2026-05-04 by BG-NAMING-VALIDATOR-PATCH).
        // If the strict enum check fails, see if the stage_join matches the
        // legacy `mk\d+-v\d+` variant form admitted by §3.7 until 2026-06-02.
        // Spec ref: docs/anima_hf_naming_convention_mk2_spec_2026_05_03.md §3.7 + §8.1.
        // raw#15: additive only; strict enum check above runs first verbatim.
        if _grace_period_active() == 1 && _matches_legacy_variant(stage_join) == 1 {
            // Emit warning to stderr (visible in audit/logs) but pass.
            // hexa println goes to stdout; warn line is parseable but does NOT
            // change the OK return contract. PASS_WITH_WARNING semantics: caller
            // (op_*) emits the canonical PASS sentinel.
            println("WARN: §3.7 grace-period: legacy variant '" + stage_join + "' admitted until 2026-06-02 (spec §8.1)")
            return "OK"
        }
        return "FAIL: stage must start with one of {sft-stage|dpo|merged|base|preview|dev|paradigm-} (got: '" + stage_join + "')"
    }
    return "OK"
}

// ─── HF CLI invocation (raw#9 strict, no python bridge) ────────────────

fn _sh_q(s: str) -> str {
    // single-quote escape: ' -> '\''
    let mut out = "'"
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        if c == "'" { out = out + "'\\''" } else { out = out + c }
        i = i + 1
    }
    out = out + "'"
    return out
}

fn _hf_cli_check() {
    let cli = _hf_cli()
    let ver = exec(cli + " --version 2>&1 | head -1").trim()
    let probe = exec("test -x '" + cli + "' && echo y || (command -v " + _sh_q(cli) + " >/dev/null 2>&1 && echo y || echo n)").trim()
    let out = json_parse("{}")
    out["cli"] = cli
    out["version"] = ver
    out["available"] = if probe == "y" { 1 } else { 0 }
    return out
}

// Canonical 3-tier resolution (v2.1.0, 2026-05-04):
//   1) `secret get huggingface.token`     — SSOT (HF official naming)
//   2) ~/.cache/huggingface/token          — HF CLI cache fallback
//   3) HF_TOKEN env                        — explicit override
// Removed legacy: hf.token alias, .secrets/hf_token, ~/.huggingface/token,
// /workspace/.hf_token, HUGGING_FACE_HUB_TOKEN env.
// See docs/hf_token_canonical_baseline_2026_05_04.md.
fn _resolve_token(req_token: str) -> str {
    if req_token.len() > 0 { return req_token }
    // tier 1: canonical secret store
    let s1 = exec("secret get huggingface.token 2>/dev/null").trim()
    if s1.len() > 0 { return s1 }
    // tier 2: HF CLI cache file
    let p2 = HOME + "/.cache/huggingface/token"
    let f2 = exec("test -f " + _sh_q(p2) + " && cat " + _sh_q(p2) + " 2>/dev/null").trim()
    if f2.len() > 0 { return f2 }
    // tier 3: env override
    let env1 = exec("echo \"$HF_TOKEN\"").trim()
    if env1.len() > 0 { return env1 }
    return ""
}

// Bug 3 fix: pass the token to hf WITHOUT it appearing in any argv/command.
// huggingface_hub resolves its token file as `$HF_HOME/token`
// (HF_TOKEN_PATH = HF_HOME + "/token"). We write the token to a private
// transient dir (umask 077 / chmod 600) and return ONLY an `HF_HOME=<dir> `
// shell prefix. The directory PATH is non-secret; the token VALUE never lands
// in argv, in the `sh -c` command string, or in `ps`. This is strictly leak-
// free, unlike `--token <value>` (token in hf argv) and unlike an inline
// `HF_TOKEN=<value>` prefix (token in the `sh -c` wrapper argv — still
// ps-visible). hexa `hexa run` (interpreted) does not propagate setenv()/
// process-env into child exec shells, so the file-backed HF_HOME is the
// least-leaky per-call form available. Caller MUST rm -rf the returned dir.
// Returns "" (no prefix, no dir) when token is empty.
fn _hf_token_home_dir(token: str) -> str {
    if token.len() == 0 { return "" }
    let dir = exec("umask 077; d=$(mktemp -d \"${TMPDIR:-/tmp}/_hfmk2_home.XXXXXX\") && printf '%s' " + _sh_q(token) + " > \"$d/token\" && chmod 600 \"$d/token\" && printf '%s' \"$d\"").trim()
    return dir
}

// Build the `HF_HOME=<dir> ` exec prefix from a token-home dir (empty → "").
fn _hf_token_env_prefix(home_dir: str) -> str {
    if home_dir.len() == 0 { return "" }
    return "HF_HOME=" + _sh_q(home_dir) + " "
}

// Bug 1 fix: a real HF success produced a genuine commit/repo URL. Treat output
// as success ONLY when it points at huggingface.co AND carries no error/auth
// signal (a python Traceback or a 401/Unauthorized is a FAILURE even though the
// hf CLI sometimes still exits non-error-coded under capture). This is the
// authoritative success gate — exit-code capture via `echo $?` is unreliable
// because hexa exec() spawns a fresh shell per call.
fn _hf_output_is_error(out: str) -> int {
    if out.contains("Traceback") { return 1 }
    if out.contains("Error") { return 1 }
    if out.contains("401") { return 1 }
    if out.contains("Unauthorized") { return 1 }
    if out.contains("HfHubHTTPError") { return 1 }
    return 0
}

fn _hf_commit_url_ok(commit_url: str) -> int {
    if commit_url.len() == 0 { return 0 }
    if !commit_url.starts_with("https://huggingface.co/") { return 0 }
    if _hf_output_is_error(commit_url) == 1 { return 0 }
    return 1
}

// sha256 of a single file via stdlib FIPS 180-4 builtin (hexa-lang #884
// sha256 alias surface); shell-out removed (byte-equal output).
fn _sha256_file(p: str) -> str {
    return sha256_file(p)
}

// Walk files under root (file or dir). Returns list of absolute paths.
// Skips dot-dirs and dot-files (matches legacy py walker semantics).
fn _walk_files(root: str) -> [str] {
    let is_dir = exec("test -d " + _sh_q(root) + " && echo y || echo n").trim()
    if is_dir != "y" {
        let is_file = exec("test -f " + _sh_q(root) + " && echo y || echo n").trim()
        if is_file == "y" { return [root] }
        return []
    }
    // -mindepth 1 to skip root itself; prune any dot-named dir/file.
    let cmd = "/usr/bin/find " + _sh_q(root)
              + " -mindepth 1 \\( -name '.*' -prune \\) -o -type f -print 2>/dev/null"
    let raw = exec(cmd)
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < lines.len() {
        let ln = lines[i].trim()
        if ln.len() > 0 { out = out.push(ln) }
        i = i + 1
    }
    return out
}

fn _file_size(p: str) -> int {
    // BSD stat -f%z, GNU stat -c%s — try both.
    let bsd = exec("stat -f%z " + _sh_q(p) + " 2>/dev/null").trim()
    if bsd.len() > 0 { return to_int(bsd) }
    let gnu = exec("stat -c%s " + _sh_q(p) + " 2>/dev/null").trim()
    if gnu.len() > 0 { return to_int(gnu) }
    let wc = exec("wc -c < " + _sh_q(p) + " 2>/dev/null | awk '{print $1}'").trim()
    if wc.len() > 0 { return to_int(wc) }
    return 0
}

// ─── Audit log helpers ─────────────────────────────────────────────────

fn _ts_utc() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn _audit_write(repo: str, payload) -> str {
    let _mk = exec("mkdir -p " + _sh_q(DEFAULT_AUDIT_DIR))
    let ts = exec("date -u +%Y%m%dT%H%M%SZ").trim()
    let safe_repo = repo.replace("/", "__")
    let path = DEFAULT_AUDIT_DIR + "/" + ts + "_" + safe_repo + ".jsonl"
    let line = json_stringify(payload) + "\n"
    let _w = exec("printf '%s' " + _sh_q(line) + " >> " + _sh_q(path))
    return path
}

// ─── Bridge-equivalent op: selftest ────────────────────────────────────
// Verifies the hexa side can find the hf CLI + sha256/walk helpers work.
// No network call.

fn _do_selftest() {
    let t0 = exec("date +%s").trim()
    let mut checks = []

    // check 1: hf CLI present and version readable
    let cli_info = _hf_cli_check()
    let c1 = json_parse("{}")
    c1["name"] = "hf_cli_present"
    c1["ok"] = cli_info["available"]
    c1["info"] = to_string(cli_info["cli"]) + " | " + to_string(cli_info["version"])
    checks = checks.push(c1)

    // check 2: sha256 helper round-trip
    let tmp = "/tmp/hf_upload_mk2_selftest_" + t0 + ".bin"
    write_file(tmp, "anima_hf_upload_mk2_selftest_v2\n")
    let sha = _sha256_file(tmp)
    let _rm = exec("rm -f " + _sh_q(tmp))
    let c2 = json_parse("{}")
    c2["name"] = "sha256_helper"
    c2["ok"] = if sha.len() == 64 { 1 } else { 0 }
    c2["info"] = if sha.len() >= 16 { sha.substring(0, 16) + "..." } else { sha }
    checks = checks.push(c2)

    // check 3: walk_files on tool/ dir contains hf_upload_mk2.hexa
    let here = ANIMA_ROOT + "/tool"
    let files = _walk_files(here)
    let mut found = 0
    let mut wi = 0
    while wi < files.len() {
        if files[wi].contains("hf_upload_mk2.hexa") { found = 1 }
        wi = wi + 1
    }
    let c3 = json_parse("{}")
    c3["name"] = "walk_files"
    c3["ok"] = found
    c3["info"] = to_string(files.len()) + " files"
    checks = checks.push(c3)

    let mut all_ok = 1
    let mut ci = 0
    while ci < checks.len() {
        if to_int(checks[ci]["ok"]) != 1 { all_ok = 0 }
        ci = ci + 1
    }
    let resp = json_parse("{}")
    resp["ok"] = all_ok
    resp["mode"] = "selftest"
    resp["checks"] = checks
    resp["message"] = if all_ok == 1 { "selftest: PASS" } else { "selftest: FAIL" }
    return resp
}

// ─── Bridge-equivalent op: dry_run ─────────────────────────────────────
// Walk + sha256 every file; no network.

fn _do_dry_run(repo: str, ckpt: str, readme: str, tag: str) {
    let files = _walk_files(ckpt)
    let mut sha_map = json_parse("{}")
    let mut total = 0
    let mut i = 0
    while i < files.len() {
        let abs = files[i]
        // rel path = abs minus ckpt prefix (handle both file + dir cases)
        let mut rel = abs
        if abs.starts_with(ckpt + "/") { rel = abs.substring(ckpt.len() + 1, abs.len()) }
        else if abs == ckpt { rel = exec("basename " + _sh_q(abs)).trim() }
        let sha = _sha256_file(abs)
        sha_map[rel] = if sha.len() > 0 { sha } else { "error:sha256_failed" }
        total = total + _file_size(abs)
        i = i + 1
    }
    let readme_ok = if readme.len() > 0 { exec("test -f " + _sh_q(readme) + " && echo y || echo n").trim() } else { "n" }
    let payload = json_parse("{}")
    payload["ts_utc"] = _ts_utc()
    payload["mode"] = "dry_run"
    payload["repo"] = repo
    payload["tag"] = tag
    payload["file_count"] = files.len()
    payload["total_bytes"] = total
    payload["sha256_map"] = sha_map
    payload["readme_present"] = if readme_ok == "y" { 1 } else { 0 }
    payload["outcome"] = "dry_run_ok"
    let audit_path = _audit_write(repo, payload)

    let resp = json_parse("{}")
    resp["ok"] = 1
    resp["mode"] = "dry_run"
    resp["repo"] = repo
    resp["tag"] = tag
    resp["file_count"] = files.len()
    resp["total_bytes"] = total
    resp["sha256_map"] = sha_map
    resp["audit_path"] = audit_path
    resp["message"] = "dry_run: " + to_string(files.len()) + " files, " + to_string(total) + " bytes, readme=" + (if readme_ok == "y" { "ok" } else { "missing" })
    return resp
}

// ─── Bridge-equivalent op: upload ──────────────────────────────────────
// Pre-compute sha256 for audit, then shell out to `hf` CLI.

fn _do_upload(repo: str, ckpt: str, readme: str, tag: str, private: int) {
    let cli_info = _hf_cli_check()
    if to_int(cli_info["available"]) != 1 {
        let err = json_parse("{}")
        err["ok"] = 0
        err["mode"] = "upload"
        err["repo"] = repo
        err["error"] = "hf_cli_unavailable"
        err["message"] = "hf CLI not found at " + to_string(cli_info["cli"]) + "; install huggingface_hub>=1.8.0"
        return err
    }
    let token = _resolve_token("")
    if token.len() == 0 {
        let err = json_parse("{}")
        err["ok"] = 0
        err["mode"] = "upload"
        err["repo"] = repo
        err["error"] = "no_token"
        err["message"] = "no HF token (canonical: secret get huggingface.token | ~/.cache/huggingface/token | HF_TOKEN env)"
        return err
    }

    let cli = to_string(cli_info["cli"])

    // Pre-compute sha256 map (audit truth, recorded BEFORE upload).
    let files = _walk_files(ckpt)
    let mut sha_map = json_parse("{}")
    let mut total = 0
    let mut fi = 0
    while fi < files.len() {
        let abs = files[fi]
        let mut rel = abs
        if abs.starts_with(ckpt + "/") { rel = abs.substring(ckpt.len() + 1, abs.len()) }
        else if abs == ckpt { rel = exec("basename " + _sh_q(abs)).trim() }
        let sha = _sha256_file(abs)
        sha_map[rel] = if sha.len() > 0 { sha } else { "error:sha256_failed" }
        total = total + _file_size(abs)
        fi = fi + 1
    }

    let priv_flag = if private == 1 { " --private" } else { "" }
    // Bug 3 fix: token via a private HF_HOME/token file (not --token argv, not
    // an inline HF_TOKEN=<value> — both are ps-visible). Only the dir path is
    // ever on the command line. tok_home is rm -rf'd before this fn returns.
    let tok_home = _hf_token_home_dir(token)
    let tok_env = _hf_token_env_prefix(tok_home)

    // Step 1: create repo (idempotent via --exist-ok). Best-effort / non-fatal:
    // `hf upload` auto-creates the repo, so a create failure does NOT gate
    // success (success is gated on the upload commit URL below). Bug 2 fix:
    // `--repo-type model` (hf 0.36.2 rejects `--type model`).
    let create_cmd = tok_env + cli + " repo create " + _sh_q(repo) + " --repo-type model" + priv_flag + " --exist-ok 2>&1"
    let create_out = exec(create_cmd)

    // Step 2: upload folder (single commit). Returns commit URL on stdout.
    let commit_msg = "anima hf_upload_mk2 commit"
    let upload_cmd = tok_env + cli + " upload " + _sh_q(repo) + " " + _sh_q(ckpt) + " --commit-message " + _sh_q(commit_msg) + " 2>&1"
    let upload_out = exec(upload_cmd)

    // Heuristic commit_url extraction: look for a real 'https://huggingface.co/'
    // line. Bug 1 fix: skip lines that carry an error/auth signal so a Traceback
    // line containing 'huggingface.co/' is never mistaken for a commit URL.
    let mut commit_url = ""
    let lines = upload_out.split("\n")
    let mut li = 0
    while li < lines.len() {
        let ln = lines[li].trim()
        if ln.starts_with("https://huggingface.co/") && _hf_output_is_error(ln) == 0 {
            commit_url = ln
            li = lines.len()
        } else {
            li = li + 1
        }
    }

    // Step 3: optional README upload if outside ckpt dir.
    let mut readme_msg = ""
    if readme.len() > 0 {
        let readme_exists = exec("test -f " + _sh_q(readme) + " && echo y || echo n").trim()
        if readme_exists == "y" {
            let abs_readme = exec("readlink -f " + _sh_q(readme) + " 2>/dev/null || python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' " + _sh_q(readme) + " 2>/dev/null || echo " + _sh_q(readme)).trim()
            let abs_ckpt = exec("readlink -f " + _sh_q(ckpt) + " 2>/dev/null || python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' " + _sh_q(ckpt) + " 2>/dev/null || echo " + _sh_q(ckpt)).trim()
            let inside = if abs_readme.starts_with(abs_ckpt + "/") { 1 } else { 0 }
            if inside == 0 {
                // Bug 3 fix: token via HF_HOME/token file prefix (not --token argv).
                let r_cmd = tok_env + cli + " upload " + _sh_q(repo) + " " + _sh_q(readme) + " README.md --commit-message " + _sh_q("anima hf_upload_mk2: README") + " 2>&1"
                let r_out = exec(r_cmd)
                readme_msg = r_out.trim()
            }
        }
    }

    // Step 4: optional tag.
    let mut tag_url = ""
    let mut tag_warn = ""
    if tag.len() > 0 {
        // hf v1.8.0+: `hf repo tag create` (alias of `hf repos tag create`).
        // Bug 3 fix: token via HF_HOME/token file prefix (not --token argv).
        let tag_cmd = tok_env + cli + " repo tag create " + _sh_q(repo) + " " + _sh_q(tag) + " 2>&1"
        let tag_out = exec(tag_cmd)
        // Bug 1 fix: `echo $?` ran in a fresh shell (always 0) — use the output
        // signal instead. Tagging is non-fatal (does not gate upload success).
        if _hf_output_is_error(tag_out) == 0 {
            tag_url = "https://huggingface.co/" + repo + "/tree/" + tag
        } else {
            // tag likely already exists; record but don't fail upload.
            tag_warn = "tag_create_warn: " + tag_out.trim()
        }
    }

    // Bug 1 fix: success is gated on a REAL commit URL, not on `echo $?`
    // (which ran in a fresh shell and reported echo's status, never hf's). A
    // 401/Traceback no longer prints PASS / writes outcome:ok.
    let upload_ok = _hf_commit_url_ok(commit_url)
    let mut last_err = ""
    if upload_ok != 1 {
        let tail = if upload_out.len() > 512 { upload_out.substring(upload_out.len() - 512, upload_out.len()).trim() } else { upload_out.trim() }
        last_err = "hf_upload_no_commit_url: " + tail
    }

    let payload = json_parse("{}")
    payload["ts_utc"] = _ts_utc()
    payload["mode"] = "upload"
    payload["repo"] = repo
    payload["tag"] = tag
    payload["private"] = private
    payload["file_count"] = files.len()
    payload["total_bytes"] = total
    payload["sha256_map"] = sha_map
    payload["commit_url"] = commit_url
    payload["tag_url"] = tag_url
    payload["tag_warn"] = tag_warn
    payload["readme_msg"] = readme_msg
    payload["create_out"] = create_out.trim()
    payload["upload_out_tail"] = if upload_out.len() > 1024 { upload_out.substring(upload_out.len() - 1024, upload_out.len()) } else { upload_out }
    payload["outcome"] = if upload_ok == 1 { "ok" } else { "fail" }
    payload["error"] = last_err
    let audit_path = _audit_write(repo, payload)

    // Bug 3 fix: shred the transient token-home dir (contains the token file).
    if tok_home.len() > 0 { let _rm = exec("rm -rf " + _sh_q(tok_home)) }

    let resp = json_parse("{}")
    resp["ok"] = upload_ok
    resp["mode"] = "upload"
    resp["repo"] = repo
    resp["tag"] = tag
    resp["file_count"] = files.len()
    resp["total_bytes"] = total
    resp["sha256_map"] = sha_map
    resp["commit_url"] = commit_url
    resp["tag_url"] = tag_url
    resp["audit_path"] = audit_path
    resp["message"] = if upload_ok == 1 {
        "upload: " + to_string(files.len()) + " files, " + to_string(total) + " bytes via hf CLI"
    } else {
        "upload FAILED: " + last_err
    }
    resp["error"] = last_err
    return resp
}

// ─── Ledger append (aggregate audit) ───────────────────────────────────

fn _ledger_append(repo: str, mode: str, resp) {
    let ts = exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
    let entry = json_parse("{}")
    entry["ts_utc"] = ts
    entry["repo"] = repo
    entry["mode"] = mode
    entry["ok"] = if has_key(resp, "ok") { resp["ok"] } else { 0 }
    entry["file_count"] = if has_key(resp, "file_count") { resp["file_count"] } else { 0 }
    entry["total_bytes"] = if has_key(resp, "total_bytes") { resp["total_bytes"] } else { 0 }
    entry["tag"] = if has_key(resp, "tag") { resp["tag"] } else { "" }
    entry["audit_path"] = if has_key(resp, "audit_path") { resp["audit_path"] } else { "" }
    entry["commit_url"] = if has_key(resp, "commit_url") { resp["commit_url"] } else { "" }
    let line = json_stringify(entry) + "\n"
    let _r = exec("mkdir -p " + _sh_q(DEFAULT_AUDIT_DIR) + " && printf '%s' " + _sh_q(line) + " >> " + _sh_q(DEFAULT_LEDGER))
    return entry
}

// ─── Top-level operations ──────────────────────────────────────────────

fn op_selftest() -> int {
    println("[hf_upload_mk2] SELFTEST (raw#9 strict — no python bridge)")
    let cli_info = _hf_cli_check()
    println("  hf cli      = " + to_string(cli_info["cli"]))
    println("  hf version  = " + to_string(cli_info["version"]))
    println("  hf available= " + to_string(cli_info["available"]))

    // 1. README validator unit test (synthesize good + bad README in /tmp)
    let good = "# x\n\n## Origin\nfoo\n\n## Falsifiers\nfoo\n\n## Substrate\nfoo\n\n## Caveats\n- a\n- b\n- c\n\n## Composability\nfoo\n"
    let bad  = "# x\n\n## Origin\nfoo\n\n## Substrate\nfoo\n"
    let g_path = "/tmp/_hf_mk2_selftest_good.md"
    let b_path = "/tmp/_hf_mk2_selftest_bad.md"
    write_file(g_path, good)
    write_file(b_path, bad)
    let g_res = _readme_validate(g_path)
    let b_res = _readme_validate(b_path)
    let _r1 = exec("rm -f " + _sh_q(g_path) + " " + _sh_q(b_path))
    if g_res != "OK" {
        println("  [F] readme good-case failed: " + g_res)
        println("__ANIMA_HF_UPLOAD_MK2__ FAIL")
        return 0
    }
    if b_res == "OK" {
        println("  [F] readme bad-case unexpectedly passed")
        println("__ANIMA_HF_UPLOAD_MK2__ FAIL")
        return 0
    }
    println("  [P] readme validator: good=OK, bad=rejected")

    // 2. naming validator unit test
    let n_good = _naming_validate("dancinlab/clm-v4-sft-stage1")
    let n_bad1 = _naming_validate("BadOrg/clm-v4-sft-stage1")
    let n_bad2 = _naming_validate("dancinlab/zzz-v4-sft-stage1")
    let n_bad3 = _naming_validate("nodash")
    if n_good != "OK" {
        println("  [F] naming good-case failed: " + n_good)
        println("__ANIMA_HF_UPLOAD_MK2__ FAIL")
        return 0
    }
    if n_bad1 == "OK" || n_bad2 == "OK" || n_bad3 == "OK" {
        println("  [F] naming bad-cases unexpectedly passed: bad1=" + n_bad1 + " bad2=" + n_bad2 + " bad3=" + n_bad3)
        println("__ANIMA_HF_UPLOAD_MK2__ FAIL")
        return 0
    }
    println("  [P] naming validator: good=OK, bad=rejected")

    // 3. hexa-side selftest: hf CLI presence + sha256 + walk_files (no network).
    let resp = _do_selftest()
    let resp_ok = to_int(resp["ok"])
    let resp_msg = to_string(resp["message"])
    if resp_ok != 1 {
        // Soft-fail: hf CLI may not be installed. Validator units still PASS.
        println("  [W] hexa selftest soft-fail (likely hf CLI not in PATH): " + resp_msg)
        let checks = resp["checks"]
        let mut ci = 0
        while ci < checks.len() {
            let c = checks[ci]
            println("        - " + to_string(c["name"]) + " ok=" + to_string(c["ok"]) + " info=" + to_string(c["info"]))
            ci = ci + 1
        }
        println("  [P] hexa contract intact (validators unit-passed)")
    } else {
        println("  [P] hexa selftest: " + resp_msg)
    }

    println("__ANIMA_HF_UPLOAD_MK2__ PASS")
    return 1
}

fn op_dry_run(repo: str, ckpt: str, readme: str, tag: str) -> int {
    println("[hf_upload_mk2] DRY-RUN (raw#9 strict — hexa-native walk + sha256)")
    println("  repo   = " + repo)
    println("  ckpt   = " + ckpt)
    println("  readme = " + readme)
    println("  tag    = " + tag)

    let n = _naming_validate(repo)
    if n != "OK" { println("  [F] naming: " + n); println("__ANIMA_HF_UPLOAD_MK2__ FAIL"); return 0 }
    println("  [P] naming OK")

    let r = _readme_validate(readme)
    if r != "OK" { println("  [F] readme: " + r); println("__ANIMA_HF_UPLOAD_MK2__ FAIL"); return 0 }
    println("  [P] readme OK (5 required H2 + Caveats >=3)")

    let exists = exec("test -d " + _sh_q(ckpt) + " -o -f " + _sh_q(ckpt) + " && echo y || echo n").trim()
    if exists != "y" { println("  [F] ckpt path not found: " + ckpt); println("__ANIMA_HF_UPLOAD_MK2__ FAIL"); return 0 }

    let resp = _do_dry_run(repo, ckpt, readme, tag)
    if to_int(resp["ok"]) != 1 {
        let m = if has_key(resp, "message") { resp["message"] } else { "unknown" }
        println("  [F] dry-run: " + to_string(m))
        println("__ANIMA_HF_UPLOAD_MK2__ FAIL")
        return 0
    }
    println("  files       = " + to_string(resp["file_count"]))
    println("  total_bytes = " + to_string(resp["total_bytes"]))
    println("  audit       = " + to_string(resp["audit_path"]))
    let _l = _ledger_append(repo, "dry_run", resp)
    println("__ANIMA_HF_UPLOAD_MK2__ PASS")
    return 1
}

fn op_upload(repo: str, ckpt: str, readme: str, tag: str, private: int) -> int {
    println("[hf_upload_mk2] UPLOAD (raw#9 strict — hf CLI shell-out)")
    println("  repo    = " + repo)
    println("  ckpt    = " + ckpt)
    println("  readme  = " + readme)
    println("  tag     = " + tag)
    println("  private = " + str(private))

    let n = _naming_validate(repo)
    if n != "OK" { println("  [F] naming: " + n); println("__ANIMA_HF_UPLOAD_MK2__ FAIL"); return 0 }
    let r = _readme_validate(readme)
    if r != "OK" { println("  [F] readme: " + r); println("__ANIMA_HF_UPLOAD_MK2__ FAIL"); return 0 }

    let resp = _do_upload(repo, ckpt, readme, tag, private)
    if !has_key(resp, "ok") || to_int(resp["ok"]) != 1 {
        let m = if has_key(resp, "message") { resp["message"] } else { "unknown" }
        println("  [F] upload: " + to_string(m))
        let _lf = _ledger_append(repo, "upload", resp)
        // Write FAIL marker for orchestrator
        let mark = ANIMA_ROOT + "/state/markers/anima_hf_upload_mk2_fail.marker"
        write_file(mark, json_stringify(resp))
        println("__ANIMA_HF_UPLOAD_MK2__ FAIL")
        return 0
    }
    println("  commit_url = " + to_string(resp["commit_url"]))
    println("  tag_url    = " + to_string(resp["tag_url"]))
    println("  audit      = " + to_string(resp["audit_path"]))
    let _l = _ledger_append(repo, "upload", resp)
    println("__ANIMA_HF_UPLOAD_MK2__ PASS")
    return 1
}

fn print_help() {
    println("anima hf_upload_mk2 v" + VERSION)
    println("")
    println("USAGE")
    println("  hexa run tool/hf_upload_mk2.hexa --selftest")
    println("  hexa run tool/hf_upload_mk2.hexa --dry-run --repo <org/name> --ckpt <path> --readme <path> [--tag <step>]")
    println("  hexa run tool/hf_upload_mk2.hexa --upload  --repo <org/name> --ckpt <path> --readme <path> [--tag <step>] [--private]")
    println("  hexa run tool/hf_upload_mk2.hexa --validate-readme <path>")
    println("  hexa run tool/hf_upload_mk2.hexa --validate-naming <org/name>")
    println("")
    println("TOKEN RESOLUTION (v2.1.0 canonical 3-tier)")
    println("  1) secret get huggingface.token   (canonical SSOT)")
    println("  2) ~/.cache/huggingface/token     (HF CLI cache fallback)")
    println("  3) HF_TOKEN env                   (explicit override)")
    println("")
    println("ENV")
    println("  ANIMA_HF_CLI          hf CLI override (default: `command -v hf`)")
    println("")
    println("AUDIT")
    println("  per-upload  = state/hf_upload_audit/<ts>_<repo>.jsonl")
    println("  ledger      = state/hf_upload_ledger_2026_05.jsonl")
}

fn main() {
    let argv = args()
    let cmd = if argv.len() > 2 { argv[2] } else { "--help" }

    if cmd == "--help" || cmd == "-h" { print_help(); return }

    if cmd == "--selftest" {
        let _r = op_selftest()
        return
    }

    if cmd == "--validate-readme" {
        let path = if argv.len() > 3 { argv[3] } else { "" }
        let res = _readme_validate(path)
        println(res)
        if res == "OK" { println("__ANIMA_HF_UPLOAD_MK2__ PASS") } else { println("__ANIMA_HF_UPLOAD_MK2__ FAIL") }
        return
    }

    if cmd == "--validate-naming" {
        let repo = if argv.len() > 3 { argv[3] } else { "" }
        let res = _naming_validate(repo)
        println(res)
        if res == "OK" { println("__ANIMA_HF_UPLOAD_MK2__ PASS") } else { println("__ANIMA_HF_UPLOAD_MK2__ FAIL") }
        return
    }

    let repo = _arg_get(argv, "--repo")
    let ckpt = _arg_get(argv, "--ckpt")
    let readme = _arg_get(argv, "--readme")
    let tag = _arg_get(argv, "--tag")
    let priv = _arg_has(argv, "--private")

    if cmd == "--dry-run" {
        if repo.len() == 0 || ckpt.len() == 0 || readme.len() == 0 {
            println("ERROR: --dry-run requires --repo --ckpt --readme")
            print_help()
            return
        }
        let _r = op_dry_run(repo, ckpt, readme, tag)
        return
    }

    if cmd == "--upload" {
        if repo.len() == 0 || ckpt.len() == 0 || readme.len() == 0 {
            println("ERROR: --upload requires --repo --ckpt --readme")
            print_help()
            return
        }
        let _r = op_upload(repo, ckpt, readme, tag, priv)
        return
    }

    println("ERROR: unknown command: " + cmd)
    print_help()
}
