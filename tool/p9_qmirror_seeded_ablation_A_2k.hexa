    parts.push("        self.bytes_drawn += n_bytes\n")
    parts.push("        return out[:n_bytes]\n")
    parts.push("    def get_uint64(self) -> int:\n")
    parts.push("        return struct.unpack('>Q', self.generate(8))[0]\n")
    parts.push("    def get_uint32(self) -> int:\n")
