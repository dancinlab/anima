    parts.push("# ── qmirror QRNG: HMAC-DRBG SHA-256 seeded by IonQ Forte 1 4096-bit quantum entropy ──\n")
    parts.push("class QmirrorHmacDrbgSha256:\n")
    parts.push("    OUTLEN = 32\n")
    parts.push("    def __init__(self, entropy: bytes, nonce: bytes, pers: bytes = b''):\n")
    parts.push("        self.K = b'\\x00' * self.OUTLEN\n")
    parts.push("        self.V = b'\\x01' * self.OUTLEN\n")
    parts.push("        self._update(entropy + nonce + pers)\n")
    parts.push("        self.reseed_counter = 1\n")
    parts.push("        self.bytes_drawn = 0\n")
    parts.push("    def _hmac(self, key, data):\n")
    parts.push("        return hmac.new(key, data, hashlib.sha256).digest()\n")
    parts.push("    def _update(self, provided_data: bytes):\n")
    parts.push("        self.K = self._hmac(self.K, self.V + b'\\x00' + provided_data)\n")
    parts.push("        self.V = self._hmac(self.K, self.V)\n")
    parts.push("        if provided_data:\n")
    parts.push("            self.K = self._hmac(self.K, self.V + b'\\x01' + provided_data)\n")
    parts.push("            self.V = self._hmac(self.K, self.V)\n")
    parts.push("    def generate(self, n_bytes: int) -> bytes:\n")
    parts.push("        out = b''\n")
    parts.push("        while len(out) < n_bytes:\n")
    parts.push("            self.V = self._hmac(self.K, self.V)\n")
    parts.push("            out += self.V\n")
    parts.push("        self._update(b'')\n")
