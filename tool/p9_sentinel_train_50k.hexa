    parts.push("log(f'loss alpha={ALPHA} beta={BETA} gamma={GAMMA} (BOLD blocked γ=0)')\n")
    parts.push("log(f'savepoints @ {SAVE_AT}; final → stage1')\n")
    parts.push("log(f'HF push={HF_PUSH} org={HF_ORG}')\n")
    parts.push("\n")
    parts.push("import numpy as np\n")
    parts.push("import torch\n")
    parts.push("import torch.nn as nn\n")
    parts.push("import torch.nn.functional as F\n")
    parts.push("np.random.seed(SEED); torch.manual_seed(SEED); random.seed(SEED)\n")
