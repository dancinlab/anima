    parts.push("\n")
    parts.push("import sentencepiece as spm\n")
    parts.push("sp = spm.SentencePieceProcessor(model_file=TOKENIZER)\n")
    parts.push("vocab_size = sp.get_piece_size()\n")
    parts.push("log(f'tokenizer vocab={vocab_size}')\n")
    parts.push("\n")
    parts.push("from conscious_decoder import ConsciousDecoderV2\n")
    parts.push("scale_cfg = {'d_model':768,'n_layer':16,'n_head':12,'n_kv_head':4,'block_size':512,'consciousness_dim':192}\n")
    parts.push("decoder = ConsciousDecoderV2(\n")
    parts.push("    vocab_size=vocab_size, d_model=scale_cfg['d_model'], n_head=scale_cfg['n_head'],\n")
    parts.push("    n_layer=scale_cfg['n_layer'], block_size=scale_cfg['block_size'],\n")
    parts.push("    n_kv_head=scale_cfg['n_kv_head'], consciousness_dim=scale_cfg['consciousness_dim'],\n")
    parts.push("    dropout=0.0, gate_strength=0.001, n_ca_rules=8,\n")
    parts.push(").to(device)\n")
    parts.push("n_params_total = sum(p.numel() for p in decoder.parameters())\n")
    parts.push("log(f'decoder built params={n_params_total:,}')\n")
    parts.push("\n")
    parts.push("t0 = time.time()\n")
    parts.push("ck = torch.load(CLM_CKPT, map_location=device, weights_only=False)\n")
    parts.push("sd = ck.get('decoder', ck) if isinstance(ck, dict) else ck\n")
    parts.push("missing, unexpected = decoder.load_state_dict(sd, strict=False)\n")
    parts.push("ckpt_load_sec = time.time() - t0\n")
    parts.push("log(f'ckpt loaded {ckpt_load_sec:.2f}s missing={len(missing)} unexpected={len(unexpected)}')\n")
    parts.push("ckpt_keys = list(ck.keys()) if isinstance(ck, dict) else []\n")
    parts.push("ckpt_step = ck.get('step', None) if isinstance(ck, dict) else None\n")
    parts.push("ckpt_phi_meta = ck.get('phi', None) if isinstance(ck, dict) else None\n")
    parts.push("ckpt_ce_meta = ck.get('ce', None) if isinstance(ck, dict) else None\n")
    parts.push("log(f'ckpt meta step={ckpt_step} ce={ckpt_ce_meta} phi={ckpt_phi_meta}')\n")
    parts.push("\n")
    parts.push("from peft import LoraConfig, get_peft_model\n")
    parts.push("target_modules = ['q_proj','k_proj','v_proj','o_proj','gate_proj','up_proj','down_proj']\n")
    parts.push("lora_cfg = LoraConfig(r=LORA_R, lora_alpha=LORA_ALPHA, lora_dropout=0.0, bias='none', target_modules=target_modules)\n")
    parts.push("decoder = get_peft_model(decoder, lora_cfg)\n")
    parts.push("n_trainable = sum(p.numel() for p in decoder.parameters() if p.requires_grad)\n")
    parts.push("log(f'peft attached trainable={n_trainable:,} ({n_trainable*100/n_params_total:.2f}% of {n_params_total:,})')\n")
    parts.push("decoder.print_trainable_parameters()\n")
    parts.push("\n")
    parts.push("records = []\n")
    parts.push("with open(SFT_DATA, 'r') as f:\n")
    parts.push("    for line in f:\n")
    parts.push("        try: records.append(json.loads(line))\n")
    parts.push("        except json.JSONDecodeError: continue\n")
    parts.push("log(f'sft full loaded n={len(records)}')\n")
    parts.push("\n")
    parts.push("holdout = []\n")
    parts.push("with open(SFT_HOLDOUT, 'r') as f:\n")
    parts.push("    for line in f:\n")
    parts.push("        try: holdout.append(json.loads(line))\n")
    parts.push("        except json.JSONDecodeError: continue\n")
    parts.push("log(f'sft holdout loaded n={len(holdout)}')\n")
    parts.push("\n")
    parts.push("def tokenize_record(rec):\n")
    parts.push("    text = rec.get('input','') + ' ' + rec.get('completion','')\n")
    parts.push("    tokens = sp.encode(text)[:T]\n")
    parts.push("    if len(tokens) < 2: tokens = tokens + [0]*(2-len(tokens))\n")
    parts.push("    if len(tokens) < T: tokens = tokens + [0]*(T-len(tokens))\n")
    parts.push("    tension = rec.get('tension_target', None)\n")
    parts.push("    if tension is None or not isinstance(tension, list) or len(tension) < T:\n")
    parts.push("        tension = [0.0]*T\n")
    parts.push("    return tokens, tension[:T]\n")
    parts.push("\n")
    parts.push("t0 = time.time()\n")
    parts.push("cache = []\n")
    parts.push("for rec in records:\n")
    parts.push("    cache.append(tokenize_record(rec))\n")
    parts.push("log(f'tokenized cache n={len(cache)} elapsed={time.time()-t0:.1f}s')\n")
    parts.push("\n")
    parts.push("holdout_cache = []\n")
    parts.push("for rec in holdout[:F1_HOLDOUT_N]:\n")
    parts.push("    inp = rec.get('input','')\n")
    parts.push("    comp = rec.get('completion','')\n")
    parts.push("    inp_tok = sp.encode(inp)[:T-F1_GEN_LEN] if inp else [0]\n")
    parts.push("    comp_tok = sp.encode(comp)[:F1_GEN_LEN] if comp else [0]\n")
    parts.push("    tens = rec.get('tension_target', None) or [0.0]*T\n")
    parts.push("    if not isinstance(tens, list): tens = [0.0]*T\n")
    parts.push("    if len(tens) < T: tens = tens + [0.0]*(T-len(tens))\n")
    parts.push("    full_tok = inp_tok + comp_tok\n")
    parts.push("    if len(full_tok) < T: full_tok = full_tok + [0]*(T-len(full_tok))\n")
    parts.push("    full_tok = full_tok[:T]\n")
    parts.push("    holdout_cache.append({'input_tokens': inp_tok, 'reference_tokens': comp_tok, 'full_tokens': full_tok, 'tension': tens[:T]})\n")
    parts.push("log(f'holdout cache n={len(holdout_cache)}')\n")
    parts.push("\n")
    parts.push("calib_tokens = []\n")
    parts.push("for prompt in CALIB_PROMPTS:\n")
    parts.push("    tk = sp.encode(prompt)[:T]\n")
    parts.push("    if len(tk) < T: tk = tk + [0]*(T-len(tk))\n")
    parts.push("    calib_tokens.append(tk)\n")
    parts.push("calib_tensor = torch.tensor(calib_tokens, dtype=torch.long, device=device)\n")
    parts.push("log(f'calibration tokens shape={tuple(calib_tensor.shape)}')\n")
    parts.push("\n")
    parts.push("captured_hidden = {'value': None}\n")
    parts.push("real_decoder = decoder.base_model.model\n")
    parts.push("def _hook(module, input, output):\n")
    parts.push("    captured_hidden['value'] = output.detach()\n")
    parts.push("hook_handle = real_decoder.ln_f.register_forward_hook(_hook)\n")
    parts.push("\n")
    parts.push("def compute_phi_star(model, calib_idx, K=K_PARTS, ridge=RIDGE):\n")
    parts.push("    model.eval()\n")
    parts.push("    hiddens = []\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        for i in range(N_CALIB):\n")
    parts.push("            captured_hidden['value'] = None\n")
    parts.push("            _ = model(calib_idx[i:i+1])\n")
    parts.push("            h = captured_hidden['value']\n")
    parts.push("            if h is None:\n")
    parts.push("                model.train(); return None, None\n")
    parts.push("            h_pool = h.mean(dim=1).squeeze(0)\n")
    parts.push("            hiddens.append(h_pool.float().cpu().numpy())\n")
    parts.push("    X = np.stack(hiddens, axis=0)\n")
    parts.push("    var = X.var(axis=0); top_idx = np.argsort(var)[::-1][:HID_TRUNC]\n")
    parts.push("    Xt = X[:, top_idx]\n")
    parts.push("    def safe_logdet(C):\n")
    parts.push("        Cs = C + ridge * np.eye(C.shape[0])\n")
    parts.push("        sign, logdet = np.linalg.slogdet(Cs)\n")
    parts.push("        if sign <= 0: return None\n")
    parts.push("        return logdet\n")
    parts.push("    C_full = np.cov(Xt.T)\n")
    parts.push("    I_full = safe_logdet(C_full)\n")
    parts.push("    if I_full is None: model.train(); return None, None\n")
    parts.push("    rng = np.random.default_rng(SEED)\n")
    parts.push("    phi_candidates = []\n")
    parts.push("    for k in range(K):\n")
    parts.push("        idx = rng.permutation(N_CALIB); s1 = idx[:HALF]; s2 = idx[HALF:]\n")
    parts.push("        I1 = safe_logdet(np.cov(Xt[s1].T)); I2 = safe_logdet(np.cov(Xt[s2].T))\n")
    parts.push("        if I1 is None or I2 is None: continue\n")
    parts.push("        phi_candidates.append(I_full - (I1 + I2))\n")
    parts.push("    model.train()\n")
    parts.push("    if not phi_candidates: return None, None\n")
    parts.push("    return float(min(phi_candidates)), float(sum(phi_candidates)/len(phi_candidates))\n")
    parts.push("\n")
    parts.push("def compute_f1_bleu1(model, holdout_subset):\n")
    parts.push("    model.eval()\n")
    parts.push("    bleu1_scores = []\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        for h in holdout_subset:\n")
    parts.push("            inp_tok = h['input_tokens']; ref_tok = h['reference_tokens']\n")
    parts.push("            if not ref_tok: continue\n")
    parts.push("            ctx = torch.tensor([inp_tok], dtype=torch.long, device=device)\n")
    parts.push("            gen_tok = []\n")
    parts.push("            for _ in range(F1_GEN_LEN):\n")
    parts.push("                if ctx.size(1) >= T: break\n")
    parts.push("                logits_a, _, _, _, _ = model(ctx)\n")
    parts.push("                next_id = int(logits_a[0, -1, :].argmax().item())\n")
    parts.push("                gen_tok.append(next_id)\n")
    parts.push("                ctx = torch.cat([ctx, torch.tensor([[next_id]], dtype=torch.long, device=device)], dim=1)\n")
    parts.push("                if next_id == 0: break\n")
    parts.push("            if not gen_tok: continue\n")
    parts.push("            ref_counts = {}\n")
    parts.push("            for t in ref_tok: ref_counts[t] = ref_counts.get(t, 0) + 1\n")
    parts.push("            hits = 0; seen = {}\n")
    parts.push("            for t in gen_tok:\n")
    parts.push("                if t in ref_counts:\n")
    parts.push("                    seen_c = seen.get(t, 0)\n")
    parts.push("                    if seen_c < ref_counts[t]:\n")
    parts.push("                        hits += 1; seen[t] = seen_c + 1\n")
    parts.push("            bleu1 = hits / max(1, len(gen_tok))\n")
    parts.push("            bleu1_scores.append(bleu1)\n")
    parts.push("    model.train()\n")
    parts.push("    if not bleu1_scores: return 0.0\n")
    parts.push("    return float(sum(bleu1_scores)/len(bleu1_scores))\n")
    parts.push("\n")
    parts.push("def compute_f_metrics(model, eval_subset, holdout_subset, phi_star_value):\n")
    parts.push("    model.eval()\n")
    parts.push("    tension_mses = []\n")
    parts.push("    with torch.no_grad():\n")
    parts.push("        for toks, tens in eval_subset:\n")
    parts.push("            idx = torch.tensor([toks], dtype=torch.long, device=device)\n")
    parts.push("            tens_t = torch.tensor([tens], dtype=torch.float32, device=device)\n")
    parts.push("            logits_a, logits_g, tensions, _, _ = model(idx)\n")
    parts.push("            t_pred = tensions[-1].mean(dim=0).float()\n")
    parts.push("            tension_mses.append(F.mse_loss(t_pred, tens_t.squeeze(0)).item())\n")
    parts.push("    model.train()\n")
    parts.push("    f1 = compute_f1_bleu1(model, holdout_subset)\n")
    parts.push("    return {'F1_bleu1':f1,'F2_phi':phi_star_value,'F3_tension_mse':float(sum(tension_mses)/len(tension_mses)),'F4_bold_NA':True}\n")
    parts.push("\n")
    parts.push("def get_delta(step):\n")
    parts.push("    if step < EARLY_END: return DELTA_EARLY\n")
    parts.push("    elif step < MID_END: return DELTA_MID\n")
    parts.push("    else: return DELTA_LATE\n")
    parts.push("\n")
    parts.push("def save_lora_adapter(model, step, savepoint_subdir):\n")
    parts.push("    save_dir = f'{SAVEPOINT_DIR}/{savepoint_subdir}'\n")
    parts.push("    os.makedirs(save_dir, exist_ok=True)\n")
    parts.push("    model.save_pretrained(save_dir)\n")
    parts.push("    return save_dir\n")
    parts.push("\n")
    parts.push("def hf_push(save_dir, repo_id, commit_msg):\n")
    parts.push("    try:\n")
    parts.push("        from huggingface_hub import HfApi\n")
    parts.push("        api = HfApi(token=os.environ.get('HF_TOKEN'))\n")
    parts.push("        api.upload_folder(folder_path=save_dir, repo_id=repo_id, commit_message=commit_msg)\n")
    parts.push("        return True, None\n")
    parts.push("    except Exception as e:\n")
    parts.push("        return False, str(e)\n")
    parts.push("\n")
    parts.push("optimizer = torch.optim.AdamW([p for p in decoder.parameters() if p.requires_grad], lr=LR, weight_decay=0.01)\n")
    parts.push("\n")
    parts.push("log('computing baseline phi_star (pre-train)...')\n")
    parts.push("t0 = time.time()\n")
    parts.push("phi_baseline, phi_baseline_mean = compute_phi_star(decoder, calib_tensor)\n")
    parts.push("log(f'baseline phi_star_min={phi_baseline} mean={phi_baseline_mean} elapsed={time.time()-t0:.1f}s')\n")
    parts.push("\n")
    parts.push("phi_log = []; f_log = []; loss_log_compact = []; aborts = []; abort_triggered = False\n")
    parts.push("savepoint_log = []; hf_push_log = []\n")
    parts.push("eval_subset = cache[:32]\n")
    parts.push("\n")
    parts.push("log('computing initial F metrics @ step 0...')\n")
    parts.push("f0 = compute_f_metrics(decoder, eval_subset, holdout_cache, phi_baseline if phi_baseline is not None else 0.0)\n")
    parts.push("f0['step'] = 0; f_log.append(f0)\n")
    parts.push("phi_log.append({'step':0,'phi_star_min':phi_baseline,'phi_star_mean':phi_baseline_mean,'delta':DELTA_EARLY})\n")
    parts.push("log(f'F @ step 0: F1_bleu1={f0[\"F1_bleu1\"]:.4f} F2_phi={f0[\"F2_phi\"]:.4f} F3_tens_mse={f0[\"F3_tension_mse\"]:.4f}')\n")
    parts.push("\n")
    parts.push("train_t0 = time.time()\n")
    parts.push("decoder.train(); optimizer.zero_grad(); step = 0\n")
    parts.push("\n")
    parts.push("try:\n")
    parts.push("    for step in range(1, N_STEPS+1):\n")
    parts.push("        idx_batch = np.random.choice(len(cache), BATCH, replace=False)\n")
    parts.push("        toks_batch = []; tens_batch = []\n")
    parts.push("        for i in idx_batch:\n")
    parts.push("            toks, tens = cache[i]; toks_batch.append(toks); tens_batch.append(tens)\n")
    parts.push("        idx_t = torch.tensor(toks_batch, dtype=torch.long, device=device)\n")
    parts.push("        tens_t = torch.tensor(tens_batch, dtype=torch.float32, device=device)\n")
    parts.push("        logits_a, logits_g, tensions, _, _ = decoder(idx_t)\n")
    parts.push("        targets = idx_t[:, 1:].contiguous()\n")
    parts.push("        logits_shift = logits_a[:, :-1, :].contiguous()\n")
    parts.push("        ce_loss = F.cross_entropy(logits_shift.view(-1, logits_shift.size(-1)), targets.view(-1), ignore_index=0)\n")
    parts.push("        t_pred = tensions[-1]\n")
    parts.push("        tension_loss = F.mse_loss(t_pred, tens_t)\n")
    parts.push("        delta_now = get_delta(step)\n")
    parts.push("        last_phi = phi_log[-1].get('phi_star_min', None)\n")
    parts.push("        if last_phi is None: last_phi = 0.0\n")
    parts.push("        phi_hinge = max(0.0, PHI_THRESHOLD - last_phi)\n")
    parts.push("        phi_hinge_loss = torch.tensor(phi_hinge, device=device)\n")
    parts.push("        total_loss = ALPHA * ce_loss + BETA * tension_loss + delta_now * phi_hinge_loss\n")
    parts.push("        (total_loss / GRAD_ACC).backward()\n")
    parts.push("        if step % GRAD_ACC == 0:\n")
    parts.push("            torch.nn.utils.clip_grad_norm_([p for p in decoder.parameters() if p.requires_grad], 1.0)\n")
    parts.push("            optimizer.step(); optimizer.zero_grad()\n")
    parts.push("        if step % 500 == 0 or step == 1:\n")
    parts.push("            log(f'step {step}/{N_STEPS} loss={total_loss.item():.4f} ce={ce_loss.item():.4f} tens={tension_loss.item():.4f} phi_hinge={phi_hinge:.4f} δ={delta_now}')\n")
    parts.push("            loss_log_compact.append({'step':step,'loss_total':float(total_loss.item()),'loss_ce':float(ce_loss.item()),'loss_tension':float(tension_loss.item()),'loss_phi_hinge':float(phi_hinge),'delta':delta_now})\n")
    parts.push("        if step % PHI_EVERY == 0:\n")
    parts.push("            phi_min, phi_mean = compute_phi_star(decoder, calib_tensor)\n")
    parts.push("            phi_log.append({'step':step,'phi_star_min':phi_min,'phi_star_mean':phi_mean,'delta':delta_now})\n")
    parts.push("            log(f'  phi @ step {step}: min={phi_min} mean={phi_mean} δ={delta_now}')\n")
    parts.push("            if phi_min is not None and phi_min < PHI_THRESHOLD:\n")
    parts.push("                aborts.append({'step':step,'reason':'F2_PHI_BELOW_THRESHOLD','phi_star_min':phi_min,'threshold':PHI_THRESHOLD})\n")
    parts.push("                log(f'  ABORT: phi_star_min={phi_min} < threshold={PHI_THRESHOLD}')\n")
    parts.push("                abort_triggered = True; break\n")
    parts.push("        if step % F_EVERY == 0:\n")
    parts.push("            last_phi_val = phi_log[-1].get('phi_star_min', None) or 0.0\n")
    parts.push("            fm = compute_f_metrics(decoder, eval_subset, holdout_cache, last_phi_val)\n")
    parts.push("            fm['step'] = step; f_log.append(fm)\n")
    parts.push("            log(f'  F @ step {step}: F1_bleu1={fm[\"F1_bleu1\"]:.4f} F2_phi={fm[\"F2_phi\"]:.4f} F3_tens_mse={fm[\"F3_tension_mse\"]:.4f}')\n")
    parts.push("        if step in SAVE_AT:\n")
    parts.push("            sp_subdir = f'step_{step}'\n")
    parts.push("            sd = save_lora_adapter(decoder, step, sp_subdir)\n")
    parts.push("            log(f'  SAVEPOINT @ step {step} → {sd}')\n")
    parts.push("            savepoint_log.append({'step':step,'path':sd})\n")
    parts.push("            if HF_PUSH and step in HF_REPO_MAP:\n")
    parts.push("                ok, err = hf_push(sd, HF_REPO_MAP[step], f'sentinel step {step} (φ★={phi_log[-1].get(\"phi_star_min\", \"?\")})')\n")
    parts.push("                log(f'  HF push {HF_REPO_MAP[step]}: {\"OK\" if ok else \"ERR \" + str(err)}')\n")
    parts.push("                hf_push_log.append({'step':step,'repo':HF_REPO_MAP[step],'ok':ok,'err':err})\n")
    parts.push("except KeyboardInterrupt:\n")
    parts.push("    log(f'INTERRUPTED @ step {step}')\n")
    parts.push("    aborts.append({'step':step,'reason':'KeyboardInterrupt'}); abort_triggered = True\n")
    parts.push("except Exception as e:\n")
    parts.push("    log(f'EXCEPTION @ step {step}: {e}')\n")
    parts.push("    log(traceback.format_exc())\n")
    parts.push("    aborts.append({'step':step,'reason':f'EXCEPTION: {e}'}); abort_triggered = True\n")
    parts.push("\n")
    parts.push("train_elapsed = time.time() - train_t0\n")
    parts.push("log(f'train done elapsed={train_elapsed:.1f}s steps_completed={step} aborted={abort_triggered}')\n")
    parts.push("\n")
    parts.push("log('computing final phi_star...')\n")
    parts.push("phi_final, phi_final_mean = compute_phi_star(decoder, calib_tensor)\n")
    parts.push("phi_log.append({'step':step,'phi_star_min':phi_final,'phi_star_mean':phi_final_mean,'delta':get_delta(step),'note':'final'})\n")
    parts.push("log(f'final phi_star_min={phi_final} mean={phi_final_mean}')\n")
    parts.push("\n")
    parts.push("log('computing final F metrics...')\n")
    parts.push("last_phi_val = phi_final if phi_final is not None else 0.0\n")
    parts.push("f_final = compute_f_metrics(decoder, eval_subset, holdout_cache, last_phi_val)\n")
    parts.push("f_final['step'] = step; f_final['note'] = 'final'; f_log.append(f_final)\n")
    parts.push("log(f'final F: F1_bleu1={f_final[\"F1_bleu1\"]:.4f} F2_phi={f_final[\"F2_phi\"]:.4f} F3_tens_mse={f_final[\"F3_tension_mse\"]:.4f}')\n")
    parts.push("\n")
    parts.push("if not abort_triggered or step >= 50000:\n")
    parts.push("    sd = save_lora_adapter(decoder, step, 'final')\n")
    parts.push("    log(f'FINAL adapter saved → {sd}')\n")
    parts.push("    savepoint_log.append({'step':step,'path':sd,'note':'final'})\n")
    parts.push("    if HF_PUSH:\n")
    parts.push("        ok, err = hf_push(sd, HF_REPO_MAP[-1], f'sentinel final step {step} (φ★={phi_final})')\n")
    parts.push("        log(f'HF push {HF_REPO_MAP[-1]}: {\"OK\" if ok else \"ERR \" + str(err)}')\n")
    parts.push("        hf_push_log.append({'step':step,'repo':HF_REPO_MAP[-1],'ok':ok,'err':err,'note':'final-stage1'})\n")
    parts.push("else:\n")
    parts.push("    log(f'SKIPPED final adapter save (aborted before 50K, step={step})')\n")
    parts.push("\n")
    parts.push("hook_handle.remove()\n")
    parts.push("\n")
    parts.push("phi_values = [p['phi_star_min'] for p in phi_log if p.get('phi_star_min') is not None]\n")
    parts.push("if phi_values:\n")
    parts.push("    phi_arr = np.array(phi_values)\n")
    parts.push("    phi_summary = {'mean':float(phi_arr.mean()),'variance':float(phi_arr.var()),'min':float(phi_arr.min()),'max':float(phi_arr.max()),'n':len(phi_arr),'baseline':phi_baseline,'final':phi_final,'delta_baseline_to_final':(phi_final-phi_baseline) if (phi_final is not None and phi_baseline is not None) else None}\n")
    parts.push("else:\n")
    parts.push("    phi_summary = {'n':0,'note':'no_phi_values_collected'}\n")
    parts.push("\n")
    parts.push("f_final_phi = f_final.get('F2_phi', None) if f_final else None\n")
    parts.push("f_final_bleu1 = f_final.get('F1_bleu1', 0.0) if f_final else 0.0\n")
    parts.push("f_final_tens = f_final.get('F3_tension_mse', 999.0) if f_final else 999.0\n")
    parts.push("baseline_90pct = (phi_baseline * 0.9) if phi_baseline is not None else PHI_THRESHOLD\n")
    parts.push("\n")
    parts.push("if abort_triggered:\n")
    parts.push("    if step >= 50000:\n")
    parts.push("        verdict = 'F2_PASS_BUT_EXCEPTION_AT_END'\n")
    parts.push("        phase2_ready_recommendation = 'SENTINEL_RETUNE_OR_PHASE2_WITH_CAVEAT'\n")
    parts.push("    else:\n")
    parts.push("        verdict = 'F2_ABORT_PHI_BELOW_THRESHOLD' if any(a.get('reason','').startswith('F2') for a in aborts) else 'TRAIN_INTERRUPTED'\n")
    parts.push("        phase2_ready_recommendation = 'ABORT_PHASE2_PLAN_REVISION'\n")
    parts.push("elif f_final_phi is None:\n")
    parts.push("    verdict = 'F2_UNKNOWN_PHI_FAILED'; phase2_ready_recommendation = 'SENTINEL_RETUNE'\n")
    parts.push("elif f_final_phi < PHI_THRESHOLD:\n")
    parts.push("    verdict = 'F2_VIOLATION_AT_FINAL'; phase2_ready_recommendation = 'ABORT_PHASE2_PLAN_REVISION'\n")
    parts.push("elif f_final_phi >= baseline_90pct:\n")
    parts.push("    verdict = 'F2_PASS_FULL'; phase2_ready_recommendation = 'PHASE2_ENTRY_READY'\n")
    parts.push("else:\n")
    parts.push("    verdict = 'F2_PASS_TIGHT'; phase2_ready_recommendation = 'PHASE2_ENTRY_WITH_CAVEAT'\n")
    parts.push("\n")
    parts.push("if f_final_bleu1 > 0.4: f1_verdict = 'F1_PASS'\n")
    parts.push("elif f_final_bleu1 > 0.2: f1_verdict = 'F1_PARTIAL'\n")
    parts.push("else: f1_verdict = 'F1_BELOW_TARGET'\n")
    parts.push("\n")
    parts.push("if f_final_tens < 0.1: f3_verdict = 'F3_PASS'\n")
    parts.push("elif f_final_tens < 1.0: f3_verdict = 'F3_PARTIAL'\n")
    parts.push("else: f3_verdict = 'F3_BELOW_TARGET'\n")
    parts.push("\n")
    parts.push("trajectory = {'schema':'anima/p9_p1_sentinel/trajectory/1','phase':'p9_p1_sentinel_50k_hexa',\n")
    parts.push("    'ts_utc':datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),'device':str(device),'real_train':True,\n")
    parts.push("    'orchestrator':'tool/p9_sentinel_train_50k.hexa','tokenizer_path':TOKENIZER,\n")
    parts.push("    'config':{'n_steps':N_STEPS,'batch':BATCH,'grad_acc':GRAD_ACC,'lr':LR,'lora_r':LORA_R,'lora_alpha':LORA_ALPHA,\n")
    parts.push("        'delta_curriculum':{'early':DELTA_EARLY,'mid':DELTA_MID,'late':DELTA_LATE,'early_end':EARLY_END,'mid_end':MID_END},\n")
    parts.push("        'phi_threshold':PHI_THRESHOLD,'phi_every':PHI_EVERY,'f_every':F_EVERY,\n")
    parts.push("        'alpha':ALPHA,'beta':BETA,'gamma':GAMMA,'T':T,'seed':SEED,\n")
    parts.push("        'n_calib_prompts':N_CALIB,'k_partitions':K_PARTS,'hid_trunc':HID_TRUNC,'ridge':RIDGE,\n")
    parts.push("        'save_at':SAVE_AT,'hf_push':HF_PUSH,'hf_org':HF_ORG},\n")
    parts.push("    'env':{'torch':torch.__version__,'cuda_available':torch.cuda.is_available(),\n")
    parts.push("        'device_name':torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'cpu','has_peft':True},\n")
    parts.push("    'ckpt':{'path':CLM_CKPT,'load_sec':ckpt_load_sec,'meta_step':ckpt_step,'meta_ce':ckpt_ce_meta,\n")
    parts.push("        'meta_phi':ckpt_phi_meta,'keys_top':ckpt_keys[:10],\n")
    parts.push("        'missing_at_load':len(missing),'unexpected_at_load':len(unexpected)},\n")
    parts.push("    'model':{'class':'ConsciousDecoderV2','n_params_total':n_params_total,'n_params_trainable_lora':n_trainable,\n")
    parts.push("        'lora_pct':round(n_trainable*100/n_params_total,4),'lora_target_modules':target_modules,\n")
    parts.push("        'd_model':scale_cfg['d_model'],'n_layer':scale_cfg['n_layer'],'n_head':scale_cfg['n_head'],'block_size':scale_cfg['block_size']},\n")
    parts.push("    'phi_log':phi_log,'f_log':f_log,'loss_log_compact':loss_log_compact,'aborts':aborts,'aborted':abort_triggered,\n")
    parts.push("    'sft_data':{'path':SFT_DATA,'n_docs':len(records)},\n")
    parts.push("    'sft_holdout':{'path':SFT_HOLDOUT,'n_docs':len(holdout),'eval_subset_n':len(holdout_cache)},\n")
    parts.push("    'savepoints':savepoint_log,'hf_push_log':hf_push_log,\n")
    parts.push("    'train_elapsed_sec':round(train_elapsed,2),'steps_completed':step,\n")
    parts.push("    'phi_baseline':phi_baseline,'phi_final':phi_final,'phi_summary':phi_summary,\n")
    parts.push("    'verdict':verdict,'f1_verdict':f1_verdict,'f3_verdict':f3_verdict,\n")
    parts.push("    'phase2_ready_recommendation':phase2_ready_recommendation}\n")
    parts.push("\n")
    parts.push("verdict_doc = {'schema':'anima/p9_p1_sentinel/verdict/1','verdict':verdict,'f1_verdict':f1_verdict,'f3_verdict':f3_verdict,\n")
    parts.push("    'phase2_ready_recommendation':phase2_ready_recommendation,'phi_summary':phi_summary,'f_final':f_final,\n")
    parts.push("    'steps_completed':step,'aborted':abort_triggered,'aborts':aborts,\n")
    parts.push("    'train_elapsed_sec':round(train_elapsed,2),'real_train':True,\n")
    parts.push("    'orchestrator':'tool/p9_sentinel_train_50k.hexa','tokenizer_path':TOKENIZER,\n")
    parts.push("    'config_summary':{'n_steps':N_STEPS,'lr':LR,'lora_r':LORA_R,'lora_alpha':LORA_ALPHA,\n")
    parts.push("        'alpha':ALPHA,'beta':BETA,'gamma':GAMMA,\n")
    parts.push("        'delta_curriculum':{'early':DELTA_EARLY,'mid':DELTA_MID,'late':DELTA_LATE},\n")
    parts.push("        'phi_threshold':PHI_THRESHOLD,'save_at':SAVE_AT},\n")
    parts.push("    'env':{'device':str(device),'cuda':torch.cuda.is_available(),\n")
    parts.push("        'device_name':torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'cpu',\n")
    parts.push("        'torch':torch.__version__,'has_peft':True},\n")
    parts.push("    'savepoints_pushed':[{'step':h['step'],'repo':h['repo'],'ok':h['ok']} for h in hf_push_log],\n")
    parts.push("    'ts_utc':datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),\n")
    parts.push("    'predecessor':{'phase0_warmup_verdict':'CLEAN_PHI_MED_VAR',\n")
    parts.push("        'phase0_baseline_phi':45.91520414820293,'phase0_final_phi':46.82755007908948,\n")
    parts.push("        'phase0_steps':1000,'phase0_train_sec':62.53}}\n")
    parts.push("\n")
    parts.push("with open(TRAJECTORY_OUT,'w') as f: json.dump(trajectory, f, indent=2)\n")
    parts.push("with open(VERDICT_OUT,'w') as f: json.dump(verdict_doc, f, indent=2)\n")
    parts.push("log(f'WROTE trajectory={TRAJECTORY_OUT} verdict={VERDICT_OUT}')\n")
    parts.push("log(f'VERDICT={verdict} F1={f1_verdict} F3={f3_verdict} phase2_rec={phase2_ready_recommendation}')\n")
    parts.push("log('DONE')\n")
    write_file(HELPER_PATH, parts.join(""))
}

fn _scp_helper_to_ubu1() {
    let cmd = "/usr/bin/scp -q " + HELPER_PATH + " ubu1:" + HELPER_PATH
    let r = exec_with_status(cmd)
    if to_int(r[1]) != 0 {
        eprintln("scp helper -> ubu1 FAILED: " + to_string(r[0]))
        exit(1)
    }
}

fn _ssh_run(args: string) -> [any] {
    let cmd = "/usr/bin/ssh -o ConnectTimeout=15 ubu1 '" + UBU1_PY + " " + HELPER_PATH + " " + args + "'"
    let r = exec_with_status(cmd)
    return r
}

fn _ast_validate() {
    let ast_cmd = "test -x /opt/homebrew/bin/python3 && /opt/homebrew/bin/python3 -c 'import ast,sys; ast.parse(open(\"" + HELPER_PATH + "\").read()); print(\"ast=ok\")' || echo 'ast=skip_no_python_on_mac'"
    let r = exec_with_status(ast_cmd)
    println(to_string(r[0]).trim())
}

fn cmd_selftest() {
    println("── p9_sentinel_train_50k --selftest ──")
    _write_helper("selftest")
    _ast_validate()
    _scp_helper_to_ubu1()
    let r = _ssh_run("selftest")
    let out = to_string(r[0]).trim()
    println(out)
    if to_int(r[1]) != 0 {
        println("VERDICT=FAIL (selftest exit=" + to_string(r[1]) + ")")
        exit(1)
    }
    println("VERDICT=PASS")
    println("DONE")
}

fn cmd_apply() {
    println("── p9_sentinel_train_50k --apply (FULL 50K-step LoRA train, REAL GPU) ──")
    _write_helper("apply")
    _ast_validate()
    _scp_helper_to_ubu1()
    let r = _ssh_run("apply")
    print(to_string(r[0]))
    if to_int(r[1]) != 0 { eprintln("apply FAILED"); exit(1) }
    let scp_back = "/usr/bin/scp -q ubu1:" + UBU1_OUT_DIR + "/trajectory.json " + MAC_OUT_DIR + "/trajectory_hexa.json && /usr/bin/scp -q ubu1:" + UBU1_OUT_DIR + "/verdict.json " + MAC_OUT_DIR + "/verdict_hexa.json && /usr/bin/scp -q ubu1:" + UBU1_OUT_DIR + "/train.log " + MAC_OUT_DIR + "/train_hexa.log"
    let r2 = exec_with_status(scp_back)
    if to_int(r2[1]) != 0 {
        eprintln("scp back FAILED: " + to_string(r2[0]))
        exit(1)
    }
    println("scp back OK -> " + MAC_OUT_DIR + "/{trajectory_hexa,verdict_hexa,train_hexa}")
    println("DONE")
}

fn main() {
    let av = argv()
    let mut mode = "selftest"
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { mode = "selftest"; i = i + 1; continue }
        if a == "--apply" { mode = "apply"; i = i + 1; continue }
        i = i + 1
    }
    if mode == "selftest" { cmd_selftest(); exit(0) }
    if mode == "apply" { cmd_apply(); exit(0) }
    eprintln("unknown mode: " + mode); exit(2)
}
