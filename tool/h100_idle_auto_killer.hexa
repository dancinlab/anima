// tool/h100_idle_auto_killer.hexa — H100 cost-overrun action ladder consumer
//
// Role: consumes alerts emitted by h100_cost_watchdog.hexa. Implements the
//       action ladder per spec §3.2:
//         1) ALERT (push notify + ledger entry)             — instant
//         2) AUTO_PAUSE (runpodctl pod stop)                 — 30 min after
//                                                              unack alert
//                                                              at 2x target
//         3) USER_CONFIRM (file ack: state/h100_watchdog/acks/<pid>_DELETE_OK)
//         4) AUTO_DELETE (runpodctl pod delete + 404 verify) — only after
//                                                              USER_CONFIRM
//
// Despite the filename, NO immediate auto-delete. False-positive auto-kills
// lose in-flight work; reputationally worse than $5-10 of extra burn.
//
// raw#9  hexa-only
// raw#10 ≥5 honest C3 emitted by --selftest banner
// raw#15 additive
//
// USAGE
//   hexa run tool/h100_idle_auto_killer.hexa --selftest
//   hexa run tool/h100_idle_auto_killer.hexa --enforce POD_ID         # gated
//
// EXIT
//   0  selftest PASS / enforce dispatched
//   1  selftest FAIL
//   2  malformed args
//   3  enforce attempted but runpodctl missing or pod not registered

let DEFAULT_REGISTRY_DIR = "/Users/ghost/core/anima/state/h100_watchdog/pods"
let DEFAULT_ALERTS_DIR   = "/Users/ghost/core/anima/state/h100_watchdog/alerts"
let DEFAULT_ACKS_DIR     = "/Users/ghost/core/anima/state/h100_watchdog/acks"
let DEFAULT_CLOSED_DIR   = "/Users/ghost/core/anima/state/h100_watchdog/closed"
let UNACK_AUTOPAUSE_SEC  = 1800   // 30 min

// ─── helpers (inline per stage0 loader) ───────────────────────────────────
fn _sh_quote(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sh_quote(p))[1] == 0
}
fn _ensure_dir(p: string) { exec_with_status("mkdir -p " + _sh_quote(p)) }
fn _ts_iso() -> string { return to_string(utc_iso_now()) }
fn _ts_epoch() -> int { return to_int(to_string(now())) }
fn _which(cmd: string) -> bool {
    return exec_with_status("command -v " + _sh_quote(cmd) + " >/dev/null 2>&1")[1] == 0
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── action ladder primitives ─────────────────────────────────────────────

fn _has_user_ack(acks_dir: string, pod_id: string) -> bool {
    return _file_exists(acks_dir + "/" + pod_id + "_DELETE_OK")
}

fn _autopause(pod_id: string, dry: bool) -> int {
    if dry { println("    [dry] would: runpodctl pod stop " + pod_id); return 0 }
    if !_which("runpodctl") {
        eprintln("h100_idle_auto_killer: runpodctl missing on PATH; cannot autopause " + pod_id)
        return 3
    }
    let r = exec_with_status("runpodctl pod stop " + _sh_quote(pod_id))
    println("    runpodctl pod stop rc=" + to_string(r[1]) + " out=" + to_string(r[0]).trim())
    return r[1]
}

fn _autodelete(pod_id: string, dry: bool) -> int {
    if dry { println("    [dry] would: runpodctl pod delete " + pod_id); return 0 }
    if !_which("runpodctl") {
        eprintln("h100_idle_auto_killer: runpodctl missing on PATH; cannot delete " + pod_id)
        return 3
    }
    let r = exec_with_status("runpodctl pod delete " + _sh_quote(pod_id))
    println("    runpodctl pod delete rc=" + to_string(r[1]) + " out=" + to_string(r[0]).trim())
    return r[1]
}

fn _verify_404(pod_id: string, dry: bool) -> bool {
    if dry { return true }
    if !_which("runpodctl") { return false }
    let r = exec_with_status("runpodctl pod get " + _sh_quote(pod_id) + " 2>&1")
    let out = to_string(r[0])
    return out.contains("not found") || out.contains("404")
}

// ─── enforce (real ladder execution) ──────────────────────────────────────

fn _enforce(pod_id: string, acks_dir: string, dry: bool) -> int {
    println("── h100_idle_auto_killer enforce pod=" + pod_id + " " + _ts_iso() + " ──")

    // Tier 1: ALERT — assumed already handled by watchdog → alert-script
    println("  tier1 ALERT: assumed emitted by watchdog (no-op here)")

    // Tier 2: AUTO_PAUSE
    println("  tier2 AUTO_PAUSE")
    let rc_p = _autopause(pod_id, dry)
    if rc_p != 0 {
        eprintln("  tier2 AUTO_PAUSE failed rc=" + to_string(rc_p))
        return 3
    }

    // Tier 3: USER_CONFIRM gate
    let ack = _has_user_ack(acks_dir, pod_id)
    println("  tier3 USER_CONFIRM ack_present=" + to_string(ack))
    if !ack {
        println("  tier3: no ack — pod paused; awaiting operator file " + acks_dir + "/" + pod_id + "_DELETE_OK")
        return 0
    }

    // Tier 4: AUTO_DELETE
    println("  tier4 AUTO_DELETE (ack confirmed)")
    let rc_d = _autodelete(pod_id, dry)
    if rc_d != 0 {
        eprintln("  tier4 AUTO_DELETE failed rc=" + to_string(rc_d))
        return 3
    }

    let ok = _verify_404(pod_id, dry)
    println("  tier4 verify_404=" + to_string(ok))
    if !ok { return 3 }
    return 0
}

// ─── selftest (synthetic dry-run ladder) ──────────────────────────────────
fn _selftest() -> int {
    println("── h100_idle_auto_killer selftest " + _ts_iso() + " ──")
    let tmp_acks = "/tmp/h100_idle_auto_killer_selftest_acks"
    exec_with_status("rm -rf " + _sh_quote(tmp_acks))
    _ensure_dir(tmp_acks)

    let mut passes = 0
    let mut fails  = 0

    // S1: ladder dry-run with NO ack → expect tier3 stop (rc=0, no delete)
    let rc1 = _enforce("SELFTEST_POD_NOACK", tmp_acks, true)
    if rc1 == 0 { println("  S1 PASS (no-ack ladder halts at tier3, dry rc=0)"); passes = passes + 1 }
    else { println("  S1 FAIL expected rc=0 got " + to_string(rc1)); fails = fails + 1 }

    // S2: ladder dry-run WITH ack → expect tier4 reached, dry verify_404=true
    write_file(tmp_acks + "/SELFTEST_POD_ACKED_DELETE_OK", _ts_iso() + "\n")
    let rc2 = _enforce("SELFTEST_POD_ACKED", tmp_acks, true)
    if rc2 == 0 { println("  S2 PASS (ack-present ladder reaches tier4 dry rc=0)"); passes = passes + 1 }
    else { println("  S2 FAIL expected rc=0 got " + to_string(rc2)); fails = fails + 1 }

    // S3: _has_user_ack false-path
    let no_ack = _has_user_ack(tmp_acks, "SELFTEST_POD_NEVER")
    if !no_ack { println("  S3 PASS (no ack file → false)"); passes = passes + 1 }
    else { println("  S3 FAIL expected false"); fails = fails + 1 }

    // S4: _has_user_ack true-path
    let yes_ack = _has_user_ack(tmp_acks, "SELFTEST_POD_ACKED")
    if yes_ack { println("  S4 PASS (ack file present → true)"); passes = passes + 1 }
    else { println("  S4 FAIL expected true"); fails = fails + 1 }

    println("h100_idle_auto_killer selftest: " + to_string(passes) + "/4 PASS, " + to_string(fails) + " FAIL")

    // honest C3 banner (raw#10)
    println("")
    println("honest_c3:")
    println("  C1: selftest is dry-run only — real runpodctl never invoked here")
    println("  C2: ladder is intentionally additive over h100_auto_kill (binary STOP path); both can fire")
    println("  C3: USER_CONFIRM gate uses file-presence (acks/<pid>_DELETE_OK); no signature/auth")
    println("  C4: tier1 ALERT is delegated to watchdog → alert-script (decoupled to avoid recursive 429)")
    println("  C5: tier4 AUTO_DELETE only fires after explicit ack file — never on alert-only signal")
    println("  C6: 30-min unack window is hard-coded; spec C7 future cycle should make it cfg-driven")

    if fails > 0 { return 1 }
    return 0
}

// ─── entry ────────────────────────────────────────────────────────────────
fn main() -> int {
    let av = _argv()
    if _flag(av, "--help") || _flag(av, "-h") {
        println("usage: hexa run tool/h100_idle_auto_killer.hexa [--selftest|--enforce POD_ID]")
        return 0
    }
    if _flag(av, "--selftest") { return _selftest() }

    if _flag(av, "--enforce") {
        let pid = _opt(av, "--enforce", "")
        if pid == "" || pid.substring(0, 2) == "--" {
            // --enforce as bare flag with positional id
            let mut i = 0
            let mut got = ""
            while i < len(av) {
                let s = to_string(av[i])
                if s == "--enforce" && i + 1 < len(av) {
                    got = to_string(av[i + 1])
                    i = len(av)
                }
                i = i + 1
            }
            if got == "" || got.substring(0, 2) == "--" {
                eprintln("h100_idle_auto_killer: --enforce requires POD_ID"); return 2
            }
            return _enforce(got, DEFAULT_ACKS_DIR, false)
        }
        return _enforce(pid, DEFAULT_ACKS_DIR, false)
    }

    println("h100_idle_auto_killer: no action requested. Try --selftest or --enforce POD_ID.")
    return 0
}
