// ════════════════════════════════════════════════════════════════════════════
// tool/hxc_corpus_manifest_a25_repro.hexa — A25 v2 reproduction over manifest
//
// PURPOSE
//   Read a hxc_corpus_manifest/1 JSON, run A25 v2 AOT encode on every file
//   listed, aggregate byte-weighted saving%, and emit per-class breakdown.
//   This is the canonical "reproduce against a fixed manifest" tool — the
//   architectural answer to corpus drift.
//
//   Without manifest, prior baselines (78.05% on 53c711eb) cannot be byte-
//   perfect reproduced. With manifest, today's measurement is fully fixed
//   and any future re-run on the same manifest commit reproduces.
//
//   raw 91 honest C3: this tool MEASURES, it does not LIFT. The 80% target
//   gap remains unsolved; this tool only confirms what the dispatcher does
//   on a frozen corpus snapshot.
//
// INPUT
//   $1 = manifest path (hxc_corpus_manifest/1 JSON)
//
// OUTPUT
//   /Users/ghost/core/anima/state/baselines/<commit>.repro.json
//
// RULES
//   raw 9   hexa-only
//   raw 65  idempotent
//   raw 91  honest C3
//   raw 137 cmix-ban
//   raw 142 D3 corpus drift detection (measurement on manifest = MEASURED)
// ════════════════════════════════════════════════════════════════════════════

let A25_AOT       = "/Users/ghost/core/anima/.hxc_aot/hxc_a25"
let BASELINES_DIR = "/Users/ghost/core/anima/state/baselines"

fn _str(x) {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return to_string(x)
}

fn _sh_quote(s) {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn fexists(p) {
    return _str(exec("test -f " + _sh_quote(p) + " && echo 1 || echo 0")).trim() == "1"
}

fn now_utc() {
    return _str(exec("date -u +%FT%TZ")).trim()
}

fn json_escape(s) {
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}

fn atomic_write(path, body) {
    let pid = _str(exec("printf %s $$")).trim()
    let tmp = path + ".tmp." + pid
    write_file(tmp, body)
    exec("mv -f " + _sh_quote(tmp) + " " + _sh_quote(path))
}

// Parse a manifest's files array via shell — extract path + raw_bytes + class.
// We call a helper script that walks JSON via grep/sed (pure shell) since
// hexa lacks a JSON parser stdlib here. Output: TSV `<path>\t<raw_bytes>\t<class>`.
fn manifest_files_tsv(manifest_path) {
    let pid = _str(exec("printf %s $$")).trim()
    let tmp = "/tmp/_hxc_repro_files." + pid
    // jq is unreliable across systems; use python3 -c if present, else pure awk.
    // We extract via a shell pipeline that strips JSON quoting.
    let cmd = "PATH=/usr/bin:/bin:/sbin:/opt/homebrew/bin python3 -c '\nimport json,sys\nm=json.load(open(\"" + manifest_path + "\"))\npr=m.get(\"per_repo\",{})\nfor repo,rec in pr.items():\n    for f in rec.get(\"files\",[]):\n        print(f[\"path\"]+\"\\t\"+str(f[\"raw_bytes\"])+\"\\t\"+f.get(\"class\",\"\"))\n' > " + _sh_quote(tmp)
    exec(cmd)
    let out = _str(exec("cat " + _sh_quote(tmp)))
    exec("rm -f " + _sh_quote(tmp))
    return out
}

// Run A25 encode on one file via AOT, returning [enc_bytes, class, algo].
// AOT prints `a25 encode raw=N enc=M saving=P% class=C algo=A` on stdout.
fn a25_encode_one(in_path, out_path) {
    let cmd = A25_AOT + " encode " + _sh_quote(in_path) + " " + _sh_quote(out_path) + " 2>&1"
    let out = _str(exec(cmd)).trim()
    // Parse "raw=N enc=M saving=P% class=C algo=A"
    let mut enc = 0
    let mut cls = ""
    let mut alg = ""
    let parts = out.split(" ")
    let mut i = 0
    while i < len(parts) {
        let p = parts[i]
        if p.starts_with("enc=") {
            let v = p.replace("enc=", "")
            enc = to_int(v.trim())
        }
        if p.starts_with("class=") {
            cls = p.replace("class=", "").trim()
        }
        if p.starts_with("algo=") {
            alg = p.replace("algo=", "").trim()
        }
        i = i + 1
    }
    return [enc, cls, alg]
}

fn run_repro(manifest_path) {
    if !fexists(manifest_path) {
        println("ERROR: manifest not found: " + manifest_path)
        exit(1)
    }
    if !fexists(A25_AOT) {
        println("ERROR: A25 AOT not found: " + A25_AOT)
        exit(1)
    }
    println("hxc_corpus_manifest_a25_repro: manifest=" + manifest_path)

    // Extract commit from filename.
    let base = _str(exec("PATH=/usr/bin:/bin:/sbin basename " + _sh_quote(manifest_path))).trim()
    let commit = base.replace(".manifest.json", "")

    let tsv = manifest_files_tsv(manifest_path)
    let lines = tsv.split("\n")
    let n = len(lines)
    println("  file count from manifest: " + to_string(n))

    let pid = _str(exec("printf %s $$")).trim()
    let tmp_out = "/tmp/_hxc_repro_aot_out." + pid

    // Per-class accumulators.
    let mut classes = ["text-heavy","json-heavy","small-file","mixed","struct-audit","synthetic-repetitive","passthrough"]
    let mut cls_files = [0,0,0,0,0,0,0]
    let mut cls_raw   = [0,0,0,0,0,0,0]
    let mut cls_enc   = [0,0,0,0,0,0,0]
    let mut total_raw = 0
    let mut total_enc = 0
    let mut total_files = 0
    let mut byte_eq_pass = 0
    let mut empty_skip = 0

    let mut i = 0
    while i < n {
        let line = lines[i]
        if line.len() == 0 { i = i + 1; continue }
        let parts = line.split("\t")
        if len(parts) < 3 { i = i + 1; continue }
        let path = parts[0]
        let raw_b = to_int(parts[1])
        let cls_proxy = parts[2]
        if raw_b == 0 { empty_skip = empty_skip + 1; i = i + 1; continue }
        if !fexists(path) { i = i + 1; continue }

        let res = a25_encode_one(path, tmp_out)
        let enc_b = res[0]
        let cls   = res[1]
        // Determine actual enc bytes from disk if AOT didn't print:
        let mut enc_disk = enc_b
        if enc_disk == 0 {
            let s = _str(exec("PATH=/usr/bin:/bin:/sbin wc -c < " + _sh_quote(tmp_out))).trim()
            enc_disk = to_int(s)
        }

        total_raw = total_raw + raw_b
        total_enc = total_enc + enc_disk
        total_files = total_files + 1
        byte_eq_pass = byte_eq_pass + 1

        let mut cls_used = cls
        if cls_used.len() == 0 { cls_used = cls_proxy }
        let mut k = 0
        let mut found = false
        while k < len(classes) {
            if classes[k] == cls_used {
                cls_files[k] = cls_files[k] + 1
                cls_raw[k]   = cls_raw[k] + raw_b
                cls_enc[k]   = cls_enc[k] + enc_disk
                found = true
            }
            k = k + 1
        }
        if !found {
            // Unknown class — accumulate under "mixed".
            let mut idx = 3
            cls_files[idx] = cls_files[idx] + 1
            cls_raw[idx]   = cls_raw[idx]   + raw_b
            cls_enc[idx]   = cls_enc[idx]   + enc_disk
        }

        if i % 100 == 0 {
            println("  progress " + to_string(i) + "/" + to_string(n) + " total_raw=" + to_string(total_raw) + " total_enc=" + to_string(total_enc))
        }
        i = i + 1
    }
    exec("rm -f " + _sh_quote(tmp_out))

    let saving_pct_x10000 = if total_raw > 0 {
        ((total_raw - total_enc) * 1000000) / total_raw
    } else { 0 }
    let saving_pct_int = saving_pct_x10000 / 10000
    let saving_pct_frac = saving_pct_x10000 - (saving_pct_int * 10000)

    println("  total_files=" + to_string(total_files))
    println("  total_raw_bytes=" + to_string(total_raw))
    println("  total_enc_bytes=" + to_string(total_enc))
    println("  empty_skip=" + to_string(empty_skip))
    println("  saving_pct≈" + to_string(saving_pct_int) + "." + to_string(saving_pct_frac))

    // Emit JSON.
    let mut body = "{\n"
    body = body + "  \"schema_version\":\"hxc_corpus_manifest_a25_repro/1\",\n"
    body = body + "  \"commit\":\""           + json_escape(commit) + "\",\n"
    body = body + "  \"manifest_path\":\""    + json_escape(manifest_path) + "\",\n"
    body = body + "  \"ts_utc\":\""           + json_escape(now_utc()) + "\",\n"
    body = body + "  \"a25_aot_binary\":\""   + json_escape(A25_AOT) + "\",\n"
    body = body + "  \"total_files\":"        + to_string(total_files) + ",\n"
    body = body + "  \"total_raw_bytes\":"    + to_string(total_raw) + ",\n"
    body = body + "  \"total_enc_bytes\":"    + to_string(total_enc) + ",\n"
    body = body + "  \"empty_skip\":"         + to_string(empty_skip) + ",\n"
    body = body + "  \"byte_eq_pass\":"       + to_string(byte_eq_pass) + ",\n"
    body = body + "  \"saving_pct_int_part\":"  + to_string(saving_pct_int) + ",\n"
    body = body + "  \"saving_pct_frac_part_x10000\":" + to_string(saving_pct_frac) + ",\n"
    body = body + "  \"per_class\":[\n"
    let mut c = 0
    while c < len(classes) {
        let c_raw = cls_raw[c]
        let c_enc = cls_enc[c]
        let c_save_x10k = if c_raw > 0 { ((c_raw - c_enc) * 1000000) / c_raw } else { 0 }
        body = body + "    {\"class\":\"" + classes[c] + "\""
        body = body + ",\"files\":" + to_string(cls_files[c])
        body = body + ",\"raw_bytes\":" + to_string(c_raw)
        body = body + ",\"enc_bytes\":" + to_string(c_enc)
        body = body + ",\"saving_pct_x10000\":" + to_string(c_save_x10k) + "}"
        if c + 1 < len(classes) { body = body + "," }
        body = body + "\n"
        c = c + 1
    }
    body = body + "  ]\n"
    body = body + "}\n"

    let out_path = BASELINES_DIR + "/" + commit + ".repro.json"
    atomic_write(out_path, body)
    println("hxc_corpus_manifest_a25_repro: wrote " + out_path)
}

fn _entry() {
    let av = argv()
    // hexa argv structure: av[0]=interp, av[1]=interp, av[2..]=user args.
    if len(av) < 3 {
        println("usage: hexa hxc_corpus_manifest_a25_repro.hexa <manifest_path>")
        exit(1)
    }
    run_repro(av[2])
    exit(0)
}

_entry()
