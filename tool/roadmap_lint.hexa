#!hexa strict
// @tool slug=roadmap_lint
// @sentinel raw9 raw10 raw11 raw15 ai-native
// @usage hexa tool/roadmap_lint.hexa [--repo <path>]
// @resolver-bypass safe
//
// tool/roadmap_lint.hexa — anima .roadmap.<domain> mk2 schema + cross-link verifier
//
// CHECKS
//   1) per-line JSON parseable (basic field-extract)
//   2) required fields: id, mk, domain, status, title, track, why
//   3) status whitelist: proposed|wip|blocked|landed|retired|superseded
//   4) id pattern: <prefix>.<3-digit> (lowercase prefix, digits 000-999)
//   5) domain whitelist: clm|eeg|akida|qrng|sim|meta
//   6) cross-link: depends_on ids must resolve to existing entry
//   7) feeds_main invariant: only meta/track entries may set feeds_main=true
//   8) dangling evidence path scan (raw 91 honest C3) — warn only
//
// EXIT
//   0 = PASS, 1 = violations
//
// OUTPUT
//   state/roadmap_mk2_lint_last.json (atomic)
//
// CROSS-REPO (Option D Hybrid; raw 270/271 ai-native; 2026-05-02)
//   --repo <name|path>  : target repo (e.g. --repo nexus or absolute path).
//                         "name" form resolved via /Users/<user>/core/hive/config/cross_repo_registry.json.
//                         pwd auto-detect (heuristic: .raw or .raw-ref ancestor) is fallback.
//   --all-repos         : iterate over registry mk2_roadmap=true repos (anima+nexus today),
//                         emit per-repo summary line, exit 1 if any repo has errors.
//   Domain list discovered dynamically from .roadmap.<stem> files (fallback hardcoded list).

let REPO_ROOT_DEFAULT = "/Users/<user>/core/anima"
let DOMAINS_FALLBACK = ["clm", "eeg", "akida", "qrng", "sim", "meta"]
let STATUS_WHITELIST = ["proposed", "ready", "wip", "active", "blocked", "landed", "retired", "superseded"]
let SCHEMA_VERSION = "anima/roadmap/mk2/lint/1"
let RESOLVER_PATH = "/Users/<user>/core/anima/tool/_roadmap_repo_resolver.hexa"

// Mutable session state (set in main dispatcher).
let mut DOMAINS = DOMAINS_FALLBACK

fn _sh_quote(s: string) -> string { return "'" + s.replace("'", "'\\''") + "'" }
fn _now_iso() -> string { return to_string(exec("date -u +%Y-%m-%dT%H:%M:%SZ")).trim() }
fn _file_exists(p: string) -> bool { return to_string(exec("test -f " + _sh_quote(p) + " && echo 1 || echo 0")).trim() == "1" }
fn _read_file(p: string) -> string {
    if !_file_exists(p) { return "" }
    return to_string(exec("cat " + _sh_quote(p)))
}

fn _atomic_write(p: string, content: string) -> bool {
    let tmp = p + ".tmp." + to_string(exec("date +%s%N")).trim()
    let cmd = "cat > " + _sh_quote(tmp) + " <<'__HEXA_EOF__'\n" + content + "\n__HEXA_EOF__"
    let _ = exec(cmd)
    let _ = exec("mv " + _sh_quote(tmp) + " " + _sh_quote(p))
    return _file_exists(p)
}

fn _is_comment_or_blank(line: string) -> bool {
    let t = line.trim()
    if len(t) == 0 { return true }
    if t.substring(0, 1) == "#" { return true }
    return false
}

fn _has_field(line: string, field: string) -> bool {
    return line.index_of("\"" + field + "\":") >= 0
}

fn _extract_str_field(line: string, field: string) -> string {
    let key = "\"" + field + "\":\""
    let i = line.index_of(key)
    if i < 0 { return "" }
    let start = i + len(key)
    let rest = line.substring(start, len(line))
    let end = rest.index_of("\"")
    if end < 0 { return "" }
    return rest.substring(0, end)
}

// Extract array field as raw substring between [ ]
fn _extract_array_raw(line: string, field: string) -> string {
    let key = "\"" + field + "\":["
    let i = line.index_of(key)
    if i < 0 { return "" }
    let start = i + len(key)
    let rest = line.substring(start, len(line))
    let end = rest.index_of("]")
    if end < 0 { return "" }
    return rest.substring(0, end)
}

fn _in_whitelist(s: string, wl: array) -> bool {
    let mut i = 0
    while i < len(wl) {
        if wl[i] == s { return true }
        i = i + 1
    }
    return false
}

fn _id_pattern_ok(id: string) -> bool {
    let dot = id.index_of(".")
    if dot < 1 { return false }
    let suffix = id.substring(dot + 1, len(id))
    if len(suffix) != 3 { return false }
    let digits = "0123456789"
    let mut i = 0
    while i < len(suffix) {
        if !digits.contains(suffix.substring(i, i + 1)) { return false }
        i = i + 1
    }
    let prefix = id.substring(0, dot)
    if len(prefix) == 0 { return false }
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_"
    let mut j = 0
    while j < len(prefix) {
        if !allowed.contains(prefix.substring(j, j + 1)) { return false }
        j = j + 1
    }
    return true
}

fn lint_repo(repo_root: string) -> int {
    let mut errors = []
    let mut warnings = []
    let mut all_ids = []
    let mut entry_count = 0
    let mut feeds_main_ids = []

    // Pass 1: collect ids + per-line schema check
    let mut d = 0
    while d < len(DOMAINS) {
        let domain = DOMAINS[d]
        let p = repo_root + "/.roadmap." + domain
        if !_file_exists(p) {
            errors = errors.push("missing domain file: " + p)
        } else {
            let content = _read_file(p)
            let lines = content.split("\n")
            let mut i = 0
            while i < len(lines) {
                let line = lines[i]
                let line_no = to_string(i + 1)
                if !_is_comment_or_blank(line) {
                    entry_count = entry_count + 1
                    // required fields
                    let id = _extract_str_field(line, "id")
                    let st = _extract_str_field(line, "status")
                    let dom = _extract_str_field(line, "domain")
                    let title = _extract_str_field(line, "title")
                    let track = _extract_str_field(line, "track")
                    let why = _extract_str_field(line, "why")

                    if len(id) == 0 { errors = errors.push(p + ":" + line_no + " missing id") }
                    else {
                        if !_id_pattern_ok(id) { errors = errors.push(p + ":" + line_no + " bad id pattern: " + id) }
                        all_ids = all_ids.push(id)
                    }
                    if !_has_field(line, "mk") { errors = errors.push(p + ":" + line_no + " missing mk") }
                    if len(st) == 0 { errors = errors.push(p + ":" + line_no + " missing status") }
                    else if !_in_whitelist(st, STATUS_WHITELIST) { errors = errors.push(p + ":" + line_no + " bad status: " + st) }
                    if len(dom) == 0 { errors = errors.push(p + ":" + line_no + " missing domain") }
                    else if dom != domain { errors = errors.push(p + ":" + line_no + " domain mismatch: file=" + domain + " entry=" + dom) }
                    if len(title) == 0 { errors = errors.push(p + ":" + line_no + " missing title") }
                    if len(track) == 0 { warnings = warnings.push(p + ":" + line_no + " empty track") }
                    if len(why) == 0 { warnings = warnings.push(p + ":" + line_no + " empty why") }

                    // feeds_main invariant — record for pass 2
                    if line.index_of("\"feeds_main\":true") >= 0 {
                        feeds_main_ids = feeds_main_ids.push(id + "@" + domain)
                    }

                    // status=landed must have completion_ts
                    if st == "landed" {
                        if !_has_field(line, "completion_ts") {
                            errors = errors.push(p + ":" + line_no + " status=landed requires completion_ts")
                        }
                    }
                }
                i = i + 1
            }
        }
        d = d + 1
    }

    // Pass 2: cross-link verify (depends_on resolution)
    let mut d2 = 0
    while d2 < len(DOMAINS) {
        let domain = DOMAINS[d2]
        let p = repo_root + "/.roadmap." + domain
        if _file_exists(p) {
            let content = _read_file(p)
            let lines = content.split("\n")
            let mut i = 0
            while i < len(lines) {
                let line = lines[i]
                let line_no = to_string(i + 1)
                if !_is_comment_or_blank(line) {
                    let dep_raw = _extract_array_raw(line, "depends_on")
                    if len(dep_raw) > 0 {
                        let parts = dep_raw.split(",")
                        let mut k = 0
                        while k < len(parts) {
                            let raw = parts[k].trim()
                            if len(raw) > 2 {
                                let dep_id = raw.replace("\"", "").trim()
                                if len(dep_id) > 0 {
                                    let mut found = false
                                    let mut j = 0
                                    while j < len(all_ids) {
                                        if all_ids[j] == dep_id { found = true }
                                        j = j + 1
                                    }
                                    if !found {
                                        errors = errors.push(p + ":" + line_no + " depends_on unresolved: " + dep_id)
                                    }
                                }
                            }
                            k = k + 1
                        }
                    }
                    // Pass 2b: dangling evidence paths
                    let ev_raw = _extract_array_raw(line, "evidence")
                    if len(ev_raw) > 0 {
                        let parts = ev_raw.split(",")
                        let mut k2 = 0
                        while k2 < len(parts) {
                            let raw = parts[k2].trim()
                            if len(raw) > 2 {
                                let evp = raw.replace("\"", "").trim()
                                if len(evp) > 0 {
                                    let abs_p = if evp.substring(0, 1) == "/" { evp } else { repo_root + "/" + evp }
                                    if !_file_exists(abs_p) {
                                        warnings = warnings.push(p + ":" + line_no + " dangling evidence: " + evp)
                                    }
                                }
                            }
                            k2 = k2 + 1
                        }
                    }
                }
                i = i + 1
            }
        }
        d2 = d2 + 1
    }

    // Pass 3: feeds_main invariant — only meta/track entries may set true
    let mut fm = 0
    while fm < len(feeds_main_ids) {
        let pair = feeds_main_ids[fm]
        let at = pair.index_of("@")
        if at > 0 {
            let dom = pair.substring(at + 1, len(pair))
            if dom != "meta" {
                warnings = warnings.push("feeds_main=true outside meta domain: " + pair)
            }
        }
        fm = fm + 1
    }

    // Emit JSON SSOT
    let pass = if len(errors) == 0 { "true" } else { "false" }
    let mut err_json = "["
    let mut i = 0
    while i < len(errors) {
        if i > 0 { err_json = err_json + "," }
        err_json = err_json + "\"" + errors[i].replace("\"", "\\\"") + "\""
        i = i + 1
    }
    err_json = err_json + "]"
    let mut warn_json = "["
    let mut j = 0
    while j < len(warnings) {
        if j > 0 { warn_json = warn_json + "," }
        warn_json = warn_json + "\"" + warnings[j].replace("\"", "\\\"") + "\""
        j = j + 1
    }
    warn_json = warn_json + "]"
    let summary = "{\"schema\":\"" + SCHEMA_VERSION + "\",\"ts\":\"" + _now_iso() + "\",\"repo\":\"" + repo_root + "\",\"entries\":" + to_string(entry_count) + ",\"domains\":" + to_string(len(DOMAINS)) + ",\"errors\":" + to_string(len(errors)) + ",\"warnings\":" + to_string(len(warnings)) + ",\"pass\":" + pass + ",\"errors_list\":" + err_json + ",\"warnings_list\":" + warn_json + "}"

    let out_p = repo_root + "/state/roadmap_mk2_lint_last.json"
    let _ = _atomic_write(out_p, summary)

    println(summary)
    if len(errors) == 0 { return 0 }
    return 1
}

fn _arg_value(args: array, flag: string) -> string {
    let mut i = 0
    while i < len(args) {
        if args[i] == flag {
            if i + 1 < len(args) { return args[i + 1] }
        }
        i = i + 1
    }
    return ""
}

// ─── cross-repo resolver helpers ──────────────────────────────

fn _sh_quote2(s: string) -> string { return "'" + s.replace("'", "'\\''") + "'" }

fn _resolver_query(subcmd: string, arg: string) -> string {
    let cmd = "hexa_real " + _sh_quote2(RESOLVER_PATH) + " " + subcmd
    let full = if len(arg) > 0 { cmd + " " + _sh_quote2(arg) + " 2>/dev/null" } else { cmd + " 2>/dev/null" }
    return to_string(exec(full)).trim()
}

fn _resolver_query2(subcmd: string, flag: string, val: string) -> string {
    let cmd = "hexa_real " + _sh_quote2(RESOLVER_PATH) + " " + subcmd + " " + flag + " " + _sh_quote2(val) + " 2>/dev/null"
    return to_string(exec(cmd)).trim()
}

fn _resolve_repo_arg(spec: string) -> string {
    if len(spec) == 0 { return "" }
    if spec.substring(0, 1) == "/" { return spec }
    let raw = _resolver_query("resolve-dep", spec + ":")
    if len(raw) > 1 && raw.substring(len(raw) - 1, len(raw)) == "/" {
        return raw.substring(0, len(raw) - 1)
    }
    return raw
}

fn _autodetect_repo_root() -> string {
    let r = _resolver_query("resolve-root", "")
    if len(r) > 0 { return r }
    return REPO_ROOT_DEFAULT
}

fn _parse_str_array(raw: string) -> array {
    let mut out = []
    if len(raw) < 3 { return out }
    if raw.substring(0, 1) != "[" { return out }
    let inner = raw.substring(1, len(raw) - 1)
    if len(inner) == 0 { return out }
    let parts = inner.split(",")
    let mut i = 0
    while i < len(parts) {
        let s = parts[i].trim()
        if len(s) >= 2 && s.substring(0, 1) == "\"" {
            let stripped = s.substring(1, len(s) - 1)
            if len(stripped) > 0 { out = out.push(stripped) }
        }
        i = i + 1
    }
    return out
}

fn _discover_domains(repo: string) -> array {
    return _parse_str_array(_resolver_query2("list-domains", "--repo", repo))
}

fn _all_mk2_repos() -> array {
    return _parse_str_array(_resolver_query("list-mk2", ""))
}

fn _arg_present(arr: array, flag: string) -> bool {
    let mut i = 0
    while i < len(arr) {
        if arr[i] == flag { return true }
        i = i + 1
    }
    return false
}

let _argv = args()
let mut _rest = []
let mut _i = 2
while _i < len(_argv) {
    _rest = _rest.push(to_string(_argv[_i]))
    _i = _i + 1
}

// Cross-repo resolution (Option D Hybrid)
let _repo_arg = _arg_value(_rest, "--repo")
let _all_repos = _arg_present(_rest, "--all-repos")
let mut _rc = 0

if _all_repos {
    let repos = _all_mk2_repos()
    let mut k = 0
    while k < len(repos) {
        let dd = _discover_domains(repos[k])
        DOMAINS = if len(dd) > 0 { dd } else { DOMAINS_FALLBACK }
        let rc_i = lint_repo(repos[k])
        if rc_i != 0 { _rc = 1 }
        k = k + 1
    }
    exit(_rc)
}

let mut _repo = REPO_ROOT_DEFAULT
if len(_repo_arg) > 0 {
    let r = _resolve_repo_arg(_repo_arg)
    _repo = if len(r) > 0 { r } else { _repo_arg }
} else {
    _repo = _autodetect_repo_root()
}
let _disc = _discover_domains(_repo)
if len(_disc) > 0 { DOMAINS = _disc }
_rc = lint_repo(_repo)
exit(_rc)
