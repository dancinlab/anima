// Helper — split a cell (deepcopy parent + 10% gaussian noise on weights).
// blocked on RFC 031 (typed farr deepcopy) + RFC 032 (gaussian builtin).
fn split_cell(parent_cell, cell_pool, step) {
    // TODO[mitosis]: farr_copy parent.engine_a_W -> child.engine_a_W
    // TODO[mitosis]: farr_add_gaussian_noise(child.engine_a_W, sigma=0.1)
    // TODO[mitosis]: same for engine_g_W, hidden
    // TODO[mitosis]: reset parent.tension_history (mitosis.py L527)
    // TODO[mitosis]: assign child.cell_id = cell_pool["next_id"], increment
    return [parent_cell, parent_cell, cell_pool]
}


// Helper — merge two cells (older keeper, parameter average).
fn merge_cells(cell_a, cell_b, cell_pool) {
    // TODO[mitosis]: keeper = older(cell_a, cell_b) (by creation_step)
    // TODO[mitosis]: keeper.engine_a_W = avg(a.W, b.W) elementwise
    // TODO[mitosis]: same for engine_g_W, hidden (average)
    // TODO[mitosis]: floor: min_cells=2 (refuse merge if it would violate)
    return [cell_a, cell_pool]
}


