// ── lib half (R2-AC lib-split 2026-05-16): pure fns · NO selftest · NO top-level call · compiled-import-safe (chat_lib.hexa imports this; PR #89 discipline) ──
// ════════════════════════════════════════════════════════════════════════════
//  tool/hexa_native/gen_modes.hexa — Phase 4.3 generation modes scaffold
//
//  PURPOSE
//    Pure-hexa port of anima_chat.py generation surface. 4 modes:
//      · gen_greedy        : argmax over logits
//      · gen_sample        : T-temperature + softmax + multinomial sample
//      · gen_m3_rep_penalty: divide logits of prior tokens by penalty
//      · gen_m4_force_include: add boost to selected token logits
//
//    All functions operate on a flat (vocab_size,) logits list. No model
//    forward dependency — they're the post-forward decision layer.
//
//  RNG
//    gen_sample takes an explicit `seed: int` to stay deterministic +
//    reproducible (anima_chat v2.3 / chat-2026-05-08 anchor). Uses an inline
//    LCG (constants from Numerical Recipes' Park-Miller variant — same as
//    stdlib/core/math/rng.hexa::lcg_next, replicated here to avoid an
//    import dependency for this scaffold file).
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (penalties + boosts are params)
//
//  FALSIFIERS (raw-117 ≥4, selftest extends to 5+ checks):
//    F-GEN-GREEDY-1     : argmax over [0,9,3,7] returns 1 (index of 9)
//    F-GEN-SAMPLE-T-2   : sample at T=0.0001 ≈ argmax (low-temp collapse)
//    F-GEN-M3-PENALTY-3 : repeated id logit divided by penalty (drops rank)
//    F-GEN-M4-BOOST-4   : boosted id outranks previously-top id
//    F-GEN-SAMPLE-SUM-5 : softmax-then-cumsum sums to 1.0 ± 1e-6
// ════════════════════════════════════════════════════════════════════════════

// ── argmax helper ───────────────────────────────────────────────────────────
fn _argmax(logits) -> int {
    let n = len(logits)
    let mut best = 0
    let mut best_v = logits[0]
    let mut i = 1
    while i < n {
        if logits[i] > best_v {
            best_v = logits[i]
            best = i
        }
        i = i + 1
    }
    return best
}

// ── softmax (numerically stable, inline copy to keep this file no-import) ──
fn _softmax(x) {
    let n = len(x)
    let mut mx = x[0]
    let mut i = 1
    while i < n {
        if x[i] > mx { mx = x[i] }
        i = i + 1
    }
    let mut exps = []
    let mut sm = 0.0
    i = 0
    while i < n {
        let e = exp(x[i] - mx)
        exps.push(e)
        sm = sm + e
        i = i + 1
    }
    let mut out = []
    i = 0
    while i < n {
        out.push(exps[i] / sm)
        i = i + 1
    }
    return out
}

// ── inline LCG (Park-Miller / Numerical Recipes; matches stdlib/core/math/rng) ─
fn _lcg_next(state: int) -> int {
    // 32-bit LCG: state = (state * 1103515245 + 12345) mod 2^31
    let s = (state * 1103515245 + 12345) & 0x7FFFFFFF
    return s
}

// Produce a float ∈ [0, 1) from a 32-bit LCG step.
fn _lcg_float(state: int) {
    let ns = _lcg_next(state)
    let f = to_float(ns) / 2147483648.0
    return [ns, f]
}

// ── gen_greedy(logits) -> i64 ───────────────────────────────────────────────
// argmax. F-GEN-GREEDY-1.
pub fn gen_greedy(logits) -> int {
    return _argmax(logits)
}

// ── gen_sample(logits, T, seed) -> [next_id, new_seed] ──────────────────────
// Temperature-scaled multinomial sample. T → 0+ collapses to argmax
// (F-GEN-SAMPLE-T-2); T → +∞ approaches uniform.
//
// Returns [next_id, new_seed] so caller can chain (RngCtx-style).
pub fn gen_sample(logits, T: float, seed: int) {
    let n = len(logits)
    // T == 0 (or very small) → degenerate to greedy to avoid div-by-zero.
    if T < 0.000001 {
        return [_argmax(logits), seed]
    }
    // 1. scale logits by 1/T
    let mut scaled = []
    let inv_t = 1.0 / T
    let mut i = 0
    while i < n {
        scaled.push(logits[i] * inv_t)
        i = i + 1
    }
    // 2. softmax
    let probs = _softmax(scaled)
    // 3. cumulative sum + draw u ∈ [0,1)
    let step = _lcg_float(seed)
    let new_seed = step[0]
    let u = step[1]
    let mut cum = 0.0
    let mut pick = n - 1               // fallback to last (handles u==0.999... edge)
    i = 0
    while i < n {
        cum = cum + probs[i]
        if u < cum {
            pick = i
            i = n                       // break
        } else {
            i = i + 1
        }
    }
    return [pick, new_seed]
}

// ── gen_m3_rep_penalty(logits, prior_ids, penalty) -> [float] ───────────────
// Anima M3: divide logits of any token appearing in prior_ids by `penalty`.
// Default penalty=1.15 matches anima_chat.py default. F-GEN-M3-PENALTY-3.
//
// Behavior: if logit is positive, divide makes it smaller (less likely).
//   If logit is negative, divide by a >1 value makes it LESS negative (more
//   likely) — which is the same direction Hugging Face's repetition_penalty
//   uses (it multiplies-or-divides based on sign). We follow HF semantics:
//   logit_new = logit_old / penalty   if logit_old > 0
//             = logit_old * penalty   if logit_old <= 0
//   (both push the value DOWN, i.e. away from selection).
pub fn gen_m3_rep_penalty(logits, prior_ids, penalty: float) {
    let n = len(logits)
    let np = len(prior_ids)
    // Build a presence flag list — O(n + np) instead of O(n*np).
    let mut seen = []
    let mut i = 0
    while i < n {
        seen.push(false)
        i = i + 1
    }
    let mut k = 0
    while k < np {
        let id = prior_ids[k]
        if id >= 0 && id < n {
            seen[id] = true
        }
        k = k + 1
    }
    let mut out = []
    i = 0
    while i < n {
        let lg = logits[i]
        if seen[i] {
            if lg > 0.0 {
                out.push(lg / penalty)
            } else {
                out.push(lg * penalty)
            }
        } else {
            out.push(lg)
        }
        i = i + 1
    }
    return out
}

// ── gen_m4_force_include(logits, ids_to_boost, boost) -> [float] ────────────
// Anima M4: add `boost` to logits of ids_to_boost (soft force-include).
// Default boost=5.0 matches anima_chat v2.3 anchor. F-GEN-M4-BOOST-4.
pub fn gen_m4_force_include(logits, ids_to_boost, boost: float) {
    let n = len(logits)
    let nb = len(ids_to_boost)
    let mut bumped = []
    let mut i = 0
    while i < n {
        bumped.push(false)
        i = i + 1
    }
    let mut k = 0
    while k < nb {
        let id = ids_to_boost[k]
        if id >= 0 && id < n {
            bumped[id] = true
        }
        k = k + 1
    }
    let mut out = []
    i = 0
    while i < n {
        if bumped[i] {
            out.push(logits[i] + boost)
        } else {
            out.push(logits[i])
        }
        i = i + 1
    }
    return out
}

