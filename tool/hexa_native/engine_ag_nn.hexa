// ════════════════════════════════════════════════════════════════════════════
//  tool/hexa_native/engine_ag_nn.hexa — Phase 2 nn primitives for EngineAG
//
//  PURPOSE
//    Pure-hexa nn primitives needed to forward EngineAG (d=1024, GQA 16q/4kv,
//    SwiGLU, RMSNorm, RoPE, 24 layers, vocab=32000, tied lm_head).
//
//    stdlib/nn.hexa currently provides relu/sigmoid/tanh/softmax only.
//    This file extends with EngineAG-specific layers, designed to read
//    weights from safetensors-loaded dict.
//
//  STATUS
//    SCAFFOLD — function signatures + docstrings + TODO bodies.
//    Tensor type is hexa builtin (boxed list-of-lists for now; will switch
//    to typed Tensor once RFC 025 lands).
//
//  DESIGN
//    Functional, no classes. Each layer is `fn layer_name(x, weights) -> out`.
//    `weights` is a dict[string -> tensor] keyed by ckpt names (e.g.
//    "layers.0.attn.q_proj.weight").
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (weights via dict lookup)
// ════════════════════════════════════════════════════════════════════════════

// ── Matrix-vector product ────────────────────────────────────────────────────
// matvec(W, x) -> y  where W is (out, in) and x is (in,), y is (out,)
//
// EngineAG convention: all weights stored as (out, in) for matmul `y = W @ x`.
// This matches PyTorch nn.Linear's `weight` attribute (out_features, in_features).
fn matvec(w_2d, x_1d) {
    let out_dim = len(w_2d)
    let in_dim = len(x_1d)
    let mut y = []
    let mut i = 0
    while i < out_dim {
        let row = w_2d[i]
        let mut acc = 0.0
        let mut j = 0
        while j < in_dim {
            acc = acc + row[j] * x_1d[j]
            j = j + 1
        }
        y.push(acc)
        i = i + 1
    }
    return y
}

// ── nn.Linear (bias-free; EngineAG uses bias=False everywhere) ──────────────
// linear(x, weight) -> Wx
//
// weight shape: (out_features, in_features)  — PyTorch convention
fn linear(x, weight) {
    return matvec(weight, x)
}

// ── nn.Embedding ────────────────────────────────────────────────────────────
// embedding(token_id, weight) -> weight[token_id]
//
// weight shape: (vocab_size, d_model)
// For batch input: iterate.
fn embedding_lookup(token_id: int, weight) {
    return weight[token_id]
}

// ── RMSNorm (scale-only, EngineAG) ──────────────────────────────────────────
// rms_norm(x, gamma, eps) -> x * rsqrt(mean(x^2) + eps) * gamma
//
// gamma shape: (d,)  ; x shape: (d,)
fn rms_norm(x, gamma, eps) {
    let d = len(x)
    let mut sum_sq = 0.0
    let mut i = 0
    while i < d {
        sum_sq = sum_sq + x[i] * x[i]
        i = i + 1
    }
    let rms = sum_sq / (d * 1.0)
    let scale = 1.0 / sqrt(rms + eps)
    let mut out = []
    i = 0
    while i < d {
        out.push(x[i] * scale * gamma[i])
        i = i + 1
    }
    return out
}

// ── SiLU activation ─────────────────────────────────────────────────────────
// silu(x) = x * sigmoid(x)   (a.k.a. Swish)
fn silu_scalar(x: float) -> float {
    return x * (1.0 / (1.0 + exp(-x)))
}

fn silu(x_1d) {
    let n = len(x_1d)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(silu_scalar(x_1d[i]))
        i = i + 1
    }
    return out
}

// ── SwiGLU FFN (EngineAG) ───────────────────────────────────────────────────
// ffn(x) = down( silu(gate(x)) * up(x) )
//
// gate_w: (d_ff, d_model)
// up_w:   (d_ff, d_model)
// down_w: (d_model, d_ff)
fn swiglu_ffn(x, gate_w, up_w, down_w) {
    let gate_out = silu(linear(x, gate_w))      // (d_ff,)
    let up_out = linear(x, up_w)                 // (d_ff,)
    // element-wise multiply gate_out * up_out
    let d_ff = len(gate_out)
    let mut hidden = []
    let mut i = 0
    while i < d_ff {
        hidden.push(gate_out[i] * up_out[i])
        i = i + 1
    }
    return linear(hidden, down_w)               // (d_model,)
}

// ── RoPE (rotary positional embedding) ──────────────────────────────────────
// rope(q, cos_t, sin_t) — apply RoPE rotation to query/key at position t.
//
// q shape: (d_head,)  where d_head must be even
// cos_t, sin_t shape: (d_head / 2,) — precomputed for position t
//
// Rotation: for pair (q[2i], q[2i+1]):
//   q[2i]   ← q[2i] * cos[i] - q[2i+1] * sin[i]
//   q[2i+1] ← q[2i] * sin[i] + q[2i+1] * cos[i]
fn rope_apply(q, cos_t, sin_t) {
    let d_head = len(q)
    let half = d_head / 2
    let mut out = []
    let mut i = 0
    while i < half {
        let q0 = q[2 * i]
        let q1 = q[2 * i + 1]
        let c = cos_t[i]
        let s = sin_t[i]
        out.push(q0 * c - q1 * s)
        out.push(q0 * s + q1 * c)
        i = i + 1
    }
    return out
}

// rope_freqs(d_head, theta, max_pos) -> (cos_table, sin_table)
//   cos_table[t][i] = cos(t * theta^(-2i/d_head))
//   sin_table[t][i] = sin(...)
// Precompute once at model load.
fn rope_freqs(d_head: int, theta: float, max_pos: int) {
    let half = d_head / 2
    // inv_freq[i] = 1.0 / (theta ** (2*i / d_head))
    let mut inv_freq = []
    let mut i = 0
    while i < half {
        let exponent = (2.0 * (i * 1.0)) / (d_head * 1.0)
        // hexa pow: theta ** exponent — assume `pow` builtin
        inv_freq.push(1.0 / pow(theta, exponent))
        i = i + 1
    }
    let mut cos_table = []
    let mut sin_table = []
    let mut t = 0
    while t < max_pos {
        let mut cos_row = []
        let mut sin_row = []
        let mut j = 0
        while j < half {
            let angle = (t * 1.0) * inv_freq[j]
            cos_row.push(cos(angle))
            sin_row.push(sin(angle))
            j = j + 1
        }
        cos_table.push(cos_row)
        sin_table.push(sin_row)
        t = t + 1
    }
    return [cos_table, sin_table]
}

// ── GQA self-attention (16 q-heads, 4 kv-heads, d_head=64) ──────────────────
// For position t (single token forward; no KV cache here — Phase 3 will add).
//
// Operates on hidden vector x (d_model=1024).
// Returns context vector (d_model=1024).
//
// Caller must pass: q_w, k_w, v_w, o_w from layer's attn.{q,k,v,o}_proj.weight
// and rope tables for positions 0..t.
//
// kv_history: list of past K and V vectors (one entry per position 0..t-1).
// On first call (t=0), kv_history is empty.
//
// NOTE: This Phase 2 scaffold does NOT yet implement attention proper;
// it sketches the API for Phase 3 to flesh out. The TODO marker is honest
// scope — full GQA requires causal mask + softmax over time dim + KV cache.
fn gqa_attention(
    x,
    q_w, k_w, v_w, o_w,
    rope_cos, rope_sin,
    t: int,
    n_heads: int, n_kv_heads: int, d_head: int,
    kv_cache_k, kv_cache_v
) {
    // Phase 2 scaffold — Phase 3 implements.
    println("[engine_ag_nn] gqa_attention TODO (Phase 3 scaffold)")
    return x  // identity placeholder
}

// ── Transformer block ───────────────────────────────────────────────────────
// block(x, layer_weights, rope_tables, t, kv_state)
//
// EngineAG block (pre-norm):
//   h = x + attn(norm1(x))
//   y = h + ffn(norm2(h))
//
// layer_weights: dict with keys like "norm1.weight", "attn.q_proj.weight", ...
fn engine_ag_block(x, layer_weights, rope_cos, rope_sin, t: int) {
    let eps = 0.00001  // typical RMSNorm eps; ckpt config 정확값 추후 확인
    let n_heads = 16
    let n_kv_heads = 4
    let d_head = 64

    let norm1_w = layer_weights["norm1.weight"]
    let h1 = rms_norm(x, norm1_w, eps)
    let attn_out = gqa_attention(
        h1,
        layer_weights["attn.q_proj.weight"],
        layer_weights["attn.k_proj.weight"],
        layer_weights["attn.v_proj.weight"],
        layer_weights["attn.o_proj.weight"],
        rope_cos, rope_sin, t,
        n_heads, n_kv_heads, d_head,
        [], []  // KV cache placeholder
    )
    // residual add
    let mut h_res = []
    let d_model = len(x)
    let mut i = 0
    while i < d_model {
        h_res.push(x[i] + attn_out[i])
        i = i + 1
    }

    let norm2_w = layer_weights["norm2.weight"]
    let h2 = rms_norm(h_res, norm2_w, eps)
    let ffn_out = swiglu_ffn(
        h2,
        layer_weights["ffn.gate.weight"],
        layer_weights["ffn.up.weight"],
        layer_weights["ffn.down.weight"]
    )
    // residual add
    let mut y = []
    i = 0
    while i < d_model {
        y.push(h_res[i] + ffn_out[i])
        i = i + 1
    }
    return y
}

// ── Forward (top-level) ─────────────────────────────────────────────────────
// forward_one_token(token_id, position, weights, rope_cos, rope_sin)
//   → logits (vocab_size,)
//
// weights: full ckpt dict from safetensors_read.
// position: t = current position (0-indexed)
//
// Tied lm_head: weights does NOT contain "lm_head.weight"; we use tok_emb.weight
// (per .meta.json tied_aliases).
fn forward_one_token(token_id: int, t: int, weights, rope_cos, rope_sin) {
    let tok_emb_w = weights["tok_emb.weight"]
    let mut x = embedding_lookup(token_id, tok_emb_w)

    let n_layers = 24
    let mut layer = 0
    while layer < n_layers {
        let prefix = "layers." + to_string(layer) + "."
        // build a small layer-local weights dict (slice of full weights by prefix)
        // For Phase 3, this should use prefix-based key lookup directly to avoid copies.
        // Scaffold: pass full weights and let engine_ag_block resolve keys.
        let layer_w = _layer_slice(weights, prefix)
        x = engine_ag_block(x, layer_w, rope_cos, rope_sin, t)
        layer = layer + 1
    }

    // final RMSNorm + tied lm_head
    let norm_f_w = weights["norm_f.weight"]
    x = rms_norm(x, norm_f_w, 0.00001)
    // tied lm_head: matmul tok_emb @ x → (vocab,)
    let logits = matvec(tok_emb_w, x)
    return logits
}

// Helper: extract weights dict for a layer.
// In production, prefer direct keyed access in engine_ag_block.
fn _layer_slice(weights, prefix: string) {
    let out = #{}
    let keys = dict_keys(weights)
    let mut i = 0
    let plen = len(prefix)
    while i < len(keys) {
        let k = keys[i]
        if len(k) > plen && k.substring(0, plen) == prefix {
            let inner_key = k.substring(plen, len(k))
            out[inner_key] = weights[k]
        }
        i = i + 1
    }
    return out
}

// ── Selftest scaffold ───────────────────────────────────────────────────────
fn main() {
    println("engine_ag_nn.hexa — Phase 2 nn primitives scaffold")
    println("status: function signatures + RMSNorm/SwiGLU/RoPE implemented")
    println("        gqa_attention placeholder (Phase 3 fills in)")
    println("        forward_one_token wiring complete (depends on Phase 3 attn)")
    println("")
    println("RMSNorm smoke test:")
    let x = [1.0, 2.0, 3.0, 4.0]
    let g = [1.0, 1.0, 1.0, 1.0]
    let y = rms_norm(x, g, 0.00001)
    println("  rms_norm([1,2,3,4], gamma=ones, eps=1e-5):")
    let mut i = 0
    while i < len(y) {
        println("    y[" + to_string(i) + "] = " + to_string(y[i]))
        i = i + 1
    }
    // Expected: mean(x^2) = (1+4+9+16)/4 = 7.5, rsqrt = 0.3651
    //           y = x * 0.3651 = [0.365, 0.730, 1.095, 1.460]
    println("  expected ≈ [0.365, 0.730, 1.095, 1.460]")

    println("")
    println("SiLU smoke:")
    let s_in = [-2.0, -1.0, 0.0, 1.0, 2.0]
    let s_out = silu(s_in)
    let mut j = 0
    while j < len(s_out) {
        println("  silu(" + to_string(s_in[j]) + ") = " + to_string(s_out[j]))
        j = j + 1
    }
    // Expected: silu(-2)≈-0.238, silu(-1)≈-0.269, silu(0)=0, silu(1)≈0.731, silu(2)≈1.762
}
