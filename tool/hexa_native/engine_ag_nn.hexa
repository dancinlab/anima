// ════════════════════════════════════════════════════════════════════════════
//  tool/hexa_native/engine_ag_nn.hexa — Phase 2 nn primitives for EngineAG
//
//  PURPOSE
//    Pure-hexa nn primitives needed to forward EngineAG (d=1024, GQA 16q/4kv,
//    SwiGLU, RMSNorm, RoPE, 24 layers, vocab=32000, tied lm_head).
//
//    stdlib/nn.hexa currently provides relu/sigmoid/tanh/softmax only.
//    This file extends with EngineAG-specific layers, designed to read
//    weights from safetensors-loaded dict.
//
//  STATUS
//    SCAFFOLD — function signatures + docstrings + TODO bodies.
//    Tensor type is hexa builtin (boxed list-of-lists for now; will switch
//    to typed Tensor once RFC 025 lands).
//
//  DESIGN
//    Functional, no classes. Each layer is `fn layer_name(x, weights) -> out`.
//    `weights` is a dict[string -> tensor] keyed by ckpt names (e.g.
//    "layers.0.attn.q_proj.weight").
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (weights via dict lookup)
//
//  FALSIFIERS (Phase 3 GQA pre-register, raw-117 ≥5):
//    F-GQA-SHAPE-1  : gqa_forward output shape ≠ (seq_len, 1024) → fail
//    F-GQA-MASK-2   : non-causal token attending future position → fail
//    F-GQA-ROPE-3   : RoPE applied to V (instead of only Q,K) → fail
//    F-GQA-EXPAND-4 : KV expand factor ≠ n_heads / n_kv_heads → fail
//    F-GQA-OUTPUT-5 : o_proj input dim ≠ n_heads * d_head (= 1024) → fail
// ════════════════════════════════════════════════════════════════════════════

// ── Matrix-vector product ────────────────────────────────────────────────────
// matvec(W, x) -> y  where W is (out, in) and x is (in,), y is (out,)
//
// EngineAG convention: all weights stored as (out, in) for matmul `y = W @ x`.
// This matches PyTorch nn.Linear's `weight` attribute (out_features, in_features).
fn matvec(w_2d, x_1d) {
    let out_dim = len(w_2d)
    let in_dim = len(x_1d)
    let mut y = []
    let mut i = 0
    while i < out_dim {
        let row = w_2d[i]
        let mut acc = 0.0
        let mut j = 0
        while j < in_dim {
            acc = acc + row[j] * x_1d[j]
            j = j + 1
        }
        y.push(acc)
        i = i + 1
    }
    return y
}

// ── nn.Linear (bias-free; EngineAG uses bias=False everywhere) ──────────────
// linear(x, weight) -> Wx
//
// weight shape: (out_features, in_features)  — PyTorch convention
fn linear(x, weight) {
    return matvec(weight, x)
}

// ── nn.Embedding ────────────────────────────────────────────────────────────
// embedding(token_id, weight) -> weight[token_id]
//
// weight shape: (vocab_size, d_model)
// For batch input: iterate.
fn embedding_lookup(token_id: int, weight) {
    return weight[token_id]
}

// ── RMSNorm (scale-only, EngineAG) ──────────────────────────────────────────
// rms_norm(x, gamma, eps) -> x * rsqrt(mean(x^2) + eps) * gamma
//
// gamma shape: (d,)  ; x shape: (d,)
fn rms_norm(x, gamma, eps) {
    let d = len(x)
    let mut sum_sq = 0.0
    let mut i = 0
    while i < d {
        sum_sq = sum_sq + x[i] * x[i]
        i = i + 1
    }
    let rms = sum_sq / (d * 1.0)
    let scale = 1.0 / sqrt(rms + eps)
    let mut out = []
    i = 0
    while i < d {
        out.push(x[i] * scale * gamma[i])
        i = i + 1
    }
    return out
}

// ── SiLU activation ─────────────────────────────────────────────────────────
// silu(x) = x * sigmoid(x)   (a.k.a. Swish)
fn silu_scalar(x: float) -> float {
    return x * (1.0 / (1.0 + exp(-x)))
}

fn silu(x_1d) {
    let n = len(x_1d)
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(silu_scalar(x_1d[i]))
        i = i + 1
    }
    return out
}

// ── SwiGLU FFN (EngineAG) ───────────────────────────────────────────────────
// ffn(x) = down( silu(gate(x)) * up(x) )
//
// gate_w: (d_ff, d_model)
// up_w:   (d_ff, d_model)
// down_w: (d_model, d_ff)
fn swiglu_ffn(x, gate_w, up_w, down_w) {
    let gate_out = silu(linear(x, gate_w))      // (d_ff,)
    let up_out = linear(x, up_w)                 // (d_ff,)
    // element-wise multiply gate_out * up_out
    let d_ff = len(gate_out)
    let mut hidden = []
    let mut i = 0
    while i < d_ff {
        hidden.push(gate_out[i] * up_out[i])
        i = i + 1
    }
    return linear(hidden, down_w)               // (d_model,)
}

// ── RoPE (rotary positional embedding) ──────────────────────────────────────
// rope(q, cos_t, sin_t) — apply RoPE rotation to query/key at position t.
//
// q shape: (d_head,)  where d_head must be even
// cos_t, sin_t shape: (d_head / 2,) — precomputed for position t
//
// Rotation: for pair (q[2i], q[2i+1]):
//   q[2i]   ← q[2i] * cos[i] - q[2i+1] * sin[i]
//   q[2i+1] ← q[2i] * sin[i] + q[2i+1] * cos[i]
fn rope_apply(q, cos_t, sin_t) {
    let d_head = len(q)
    let half = d_head / 2
    let mut out = []
    let mut i = 0
    while i < half {
        let q0 = q[2 * i]
        let q1 = q[2 * i + 1]
        let c = cos_t[i]
        let s = sin_t[i]
        out.push(q0 * c - q1 * s)
        out.push(q0 * s + q1 * c)
        i = i + 1
    }
    return out
}

// rope_freqs(d_head, theta, max_pos) -> (cos_table, sin_table)
//   cos_table[t][i] = cos(t * theta^(-2i/d_head))
//   sin_table[t][i] = sin(...)
// Precompute once at model load.
fn rope_freqs(d_head: int, theta: float, max_pos: int) {
    let half = d_head / 2
    // inv_freq[i] = 1.0 / (theta ** (2*i / d_head))
    let mut inv_freq = []
    let mut i = 0
    while i < half {
        let exponent = (2.0 * (i * 1.0)) / (d_head * 1.0)
        // hexa pow: theta ** exponent — assume `pow` builtin
        inv_freq.push(1.0 / pow(theta, exponent))
        i = i + 1
    }
    let mut cos_table = []
    let mut sin_table = []
    let mut t = 0
    while t < max_pos {
        let mut cos_row = []
        let mut sin_row = []
        let mut j = 0
        while j < half {
            let angle = (t * 1.0) * inv_freq[j]
            cos_row.push(cos(angle))
            sin_row.push(sin(angle))
            j = j + 1
        }
        cos_table.push(cos_row)
        sin_table.push(sin_row)
        t = t + 1
    }
    return [cos_table, sin_table]
}

// ── GQA self-attention (16 q-heads, 4 kv-heads, d_head=64) ──────────────────
//
// Phase 3 implementation. Operates on a sequence of hidden vectors (seq_len, d_model).
// Returns context tensor (seq_len, d_model).
//
// EngineAG arch:
//   d_model = 1024, n_heads = 16, n_kv_heads = 4, d_head = 64 (GQA factor = 4)
//   RoPE applied to Q, K (NOT V). Causal mask. Softmax over time dim.
//
// Sub-functions below decompose the block; gqa_forward orchestrates them.
// Single-token (with KV cache) path will be added in Phase 4 — Phase 3 is the
// dense full-sequence forward used for prefill / parity tests.

// Local softmax over a 1-D list (inline copy of stdlib/nn.hexa::softmax to
// avoid an import dependency — see file header comment on no imports).
fn _softmax_1d(x) {
    let n = len(x)
    let mut mx = x[0]
    let mut i = 1
    while i < n {
        if x[i] > mx { mx = x[i] }
        i = i + 1
    }
    let mut exps = []
    let mut sm = 0.0
    i = 0
    while i < n {
        let e = exp(x[i] - mx)
        exps.push(e)
        sm = sm + e
        i = i + 1
    }
    let mut out = []
    i = 0
    while i < n {
        out.push(exps[i] / sm)
        i = i + 1
    }
    return out
}

// Reshape a 1-D vector of length (n_heads * d_head) into a list of n_heads
// per-head vectors each of length d_head.
fn _split_heads(vec, n_heads: int, d_head: int) {
    let mut heads = []
    let mut h = 0
    while h < n_heads {
        let mut head = []
        let mut j = 0
        let base = h * d_head
        while j < d_head {
            head.push(vec[base + j])
            j = j + 1
        }
        heads.push(head)
        h = h + 1
    }
    return heads
}

// Concatenate per-head vectors back into a flat (n_heads * d_head,) vector.
fn _merge_heads(heads, n_heads: int, d_head: int) {
    let mut out = []
    let mut h = 0
    while h < n_heads {
        let head = heads[h]
        let mut j = 0
        while j < d_head {
            out.push(head[j])
            j = j + 1
        }
        h = h + 1
    }
    return out
}

// ── 1. gqa_project_qkv ──────────────────────────────────────────────────────
// Given a sequence (seq_len, d_model), project to Q/K/V per token via three
// nn.Linear matmuls. Returns three lists indexed by [token][head][d_head]:
//   q_seq: seq_len entries, each (n_heads,    d_head)
//   k_seq: seq_len entries, each (n_kv_heads, d_head)
//   v_seq: seq_len entries, each (n_kv_heads, d_head)
fn gqa_project_qkv(x_seq, q_w, k_w, v_w, n_heads: int, n_kv_heads: int, d_head: int) {
    let seq_len = len(x_seq)
    let mut q_seq = []
    let mut k_seq = []
    let mut v_seq = []
    let mut t = 0
    while t < seq_len {
        let xt = x_seq[t]
        let q_flat = linear(xt, q_w)                       // (n_heads * d_head,)
        let k_flat = linear(xt, k_w)                       // (n_kv_heads * d_head,)
        let v_flat = linear(xt, v_w)                       // (n_kv_heads * d_head,)
        q_seq.push(_split_heads(q_flat, n_heads,    d_head))
        k_seq.push(_split_heads(k_flat, n_kv_heads, d_head))
        v_seq.push(_split_heads(v_flat, n_kv_heads, d_head))
        t = t + 1
    }
    return [q_seq, k_seq, v_seq]
}

// ── 2. gqa_apply_rope_qk ────────────────────────────────────────────────────
// Apply RoPE to Q and K (NOT V) at their respective positions. F-GQA-ROPE-3.
// q_seq, k_seq are per-token per-head lists from gqa_project_qkv.
// rope_cos[t], rope_sin[t] are precomputed (d_head/2,) tables.
fn gqa_apply_rope_qk(q_seq, k_seq, rope_cos, rope_sin) {
    let seq_len = len(q_seq)
    let mut q_out = []
    let mut k_out = []
    let mut t = 0
    while t < seq_len {
        let cos_t = rope_cos[t]
        let sin_t = rope_sin[t]
        // Q heads
        let qh = q_seq[t]
        let n_q = len(qh)
        let mut q_rot = []
        let mut h = 0
        while h < n_q {
            q_rot.push(rope_apply(qh[h], cos_t, sin_t))
            h = h + 1
        }
        q_out.push(q_rot)
        // K heads
        let kh = k_seq[t]
        let n_k = len(kh)
        let mut k_rot = []
        h = 0
        while h < n_k {
            k_rot.push(rope_apply(kh[h], cos_t, sin_t))
            h = h + 1
        }
        k_out.push(k_rot)
        t = t + 1
    }
    return [q_out, k_out]
}

// ── 3. gqa_expand_kv ────────────────────────────────────────────────────────
// Replicate each KV head `expand` times to align with n_heads query heads.
// expand = n_heads / n_kv_heads (= 4 for EngineAG). F-GQA-EXPAND-4.
// Explicit replicate (no view) — hexa list semantics today are boxed-value.
fn gqa_expand_kv(kv_seq, n_heads: int, n_kv_heads: int) {
    let expand = n_heads / n_kv_heads
    let seq_len = len(kv_seq)
    let mut out = []
    let mut t = 0
    while t < seq_len {
        let kh = kv_seq[t]
        let mut expanded = []
        let mut kvh = 0
        while kvh < n_kv_heads {
            let head = kh[kvh]
            let mut r = 0
            while r < expand {
                expanded.push(head)
                r = r + 1
            }
            kvh = kvh + 1
        }
        out.push(expanded)
        t = t + 1
    }
    return out
}

// ── 4. gqa_attention_scores ─────────────────────────────────────────────────
// Compute attention weights per head per query-position:
//   scores[h][i][j] = (Q[i][h] · K[j][h]) / sqrt(d_head)
//   apply causal mask: j > i → -inf (F-GQA-MASK-2)
//   softmax over j
// Returns weights_seq: seq_len entries, each (n_heads, seq_len) — i.e.
// per-token per-head attention distribution over keys.
fn gqa_attention_scores(q_seq, k_seq_expanded, d_head: int) {
    let seq_len = len(q_seq)
    let n_heads = len(q_seq[0])
    let inv_scale = 1.0 / sqrt(d_head * 1.0)
    let mut weights_seq = []
    let mut i = 0
    while i < seq_len {
        let qi = q_seq[i]
        let mut per_head = []
        let mut h = 0
        while h < n_heads {
            let qih = qi[h]
            // raw scores over all j
            let mut raw = []
            let mut j = 0
            while j < seq_len {
                if j > i {
                    // causal mask: future positions get -inf-ish value
                    raw.push(-100000000.0)
                } else {
                    let kjh = k_seq_expanded[j][h]
                    let mut dot = 0.0
                    let mut d = 0
                    while d < d_head {
                        dot = dot + qih[d] * kjh[d]
                        d = d + 1
                    }
                    raw.push(dot * inv_scale)
                }
                j = j + 1
            }
            per_head.push(_softmax_1d(raw))
            h = h + 1
        }
        weights_seq.push(per_head)
        i = i + 1
    }
    return weights_seq
}

// ── 5. gqa_attention_output ─────────────────────────────────────────────────
// weights @ V → per-token (n_heads, d_head) → merge heads → o_proj.
// F-GQA-OUTPUT-5: o_w expects input dim = n_heads * d_head (= 1024).
fn gqa_attention_output(weights_seq, v_seq_expanded, o_w, n_heads: int, d_head: int) {
    let seq_len = len(weights_seq)
    let mut out_seq = []
    let mut i = 0
    while i < seq_len {
        let w_i = weights_seq[i]            // (n_heads, seq_len)
        let mut head_outs = []
        let mut h = 0
        while h < n_heads {
            let w_ih = w_i[h]                // (seq_len,)
            let mut ctx = []
            // initialize ctx to zeros of length d_head
            let mut d = 0
            while d < d_head {
                ctx.push(0.0)
                d = d + 1
            }
            // accumulate sum_j w_ih[j] * V[j][h]
            let mut j = 0
            while j < seq_len {
                let vjh = v_seq_expanded[j][h]
                let w = w_ih[j]
                d = 0
                while d < d_head {
                    ctx[d] = ctx[d] + w * vjh[d]
                    d = d + 1
                }
                j = j + 1
            }
            head_outs.push(ctx)
            h = h + 1
        }
        let merged = _merge_heads(head_outs, n_heads, d_head)   // (n_heads*d_head,)
        out_seq.push(linear(merged, o_w))                        // (d_model,)
        i = i + 1
    }
    return out_seq
}

// ── 6. gqa_forward ──────────────────────────────────────────────────────────
// Orchestrate steps 1-5 for a (seq_len, d_model) input. F-GQA-SHAPE-1.
fn gqa_forward(
    x_seq,
    q_w, k_w, v_w, o_w,
    rope_cos, rope_sin,
    n_heads: int, n_kv_heads: int, d_head: int
) {
    let qkv = gqa_project_qkv(x_seq, q_w, k_w, v_w, n_heads, n_kv_heads, d_head)
    let q_seq = qkv[0]
    let k_seq = qkv[1]
    let v_seq = qkv[2]
    let rotated = gqa_apply_rope_qk(q_seq, k_seq, rope_cos, rope_sin)
    let q_rot = rotated[0]
    let k_rot = rotated[1]
    let k_exp = gqa_expand_kv(k_rot, n_heads, n_kv_heads)
    let v_exp = gqa_expand_kv(v_seq, n_heads, n_kv_heads)
    let weights = gqa_attention_scores(q_rot, k_exp, d_head)
    let out_seq = gqa_attention_output(weights, v_exp, o_w, n_heads, d_head)
    return out_seq
}

// Legacy single-token entry kept for engine_ag_block scaffold compatibility.
// Wraps gqa_forward by promoting x to a seq of length t+1 — but full history
// must be supplied; Phase 4 adds KV cache for incremental inference.
fn gqa_attention(
    x,
    q_w, k_w, v_w, o_w,
    rope_cos, rope_sin,
    t: int,
    n_heads: int, n_kv_heads: int, d_head: int,
    kv_cache_k, kv_cache_v
) {
    // Phase 3 honest scope: this single-token wrapper is a degenerate seq_len=1
    // forward; correct incremental decoding requires KV cache wiring (Phase 4).
    let x_seq = [x]
    let out_seq = gqa_forward(
        x_seq, q_w, k_w, v_w, o_w,
        rope_cos, rope_sin, n_heads, n_kv_heads, d_head
    )
    return out_seq[0]
}

// ── Transformer block ───────────────────────────────────────────────────────
// block(x, layer_weights, rope_tables, t, kv_state)
//
// EngineAG block (pre-norm):
//   h = x + attn(norm1(x))
//   y = h + ffn(norm2(h))
//
// layer_weights: dict with keys like "norm1.weight", "attn.q_proj.weight", ...
fn engine_ag_block(x, layer_weights, rope_cos, rope_sin, t: int) {
    let eps = 0.00001  // typical RMSNorm eps; ckpt config 정확값 추후 확인
    let n_heads = 16
    let n_kv_heads = 4
    let d_head = 64

    let norm1_w = layer_weights["norm1.weight"]
    let h1 = rms_norm(x, norm1_w, eps)
    let attn_out = gqa_attention(
        h1,
        layer_weights["attn.q_proj.weight"],
        layer_weights["attn.k_proj.weight"],
        layer_weights["attn.v_proj.weight"],
        layer_weights["attn.o_proj.weight"],
        rope_cos, rope_sin, t,
        n_heads, n_kv_heads, d_head,
        [], []  // KV cache placeholder
    )
    // residual add
    let mut h_res = []
    let d_model = len(x)
    let mut i = 0
    while i < d_model {
        h_res.push(x[i] + attn_out[i])
        i = i + 1
    }

    let norm2_w = layer_weights["norm2.weight"]
    let h2 = rms_norm(h_res, norm2_w, eps)
    let ffn_out = swiglu_ffn(
        h2,
        layer_weights["ffn.gate.weight"],
        layer_weights["ffn.up.weight"],
        layer_weights["ffn.down.weight"]
    )
    // residual add
    let mut y = []
    i = 0
    while i < d_model {
        y.push(h_res[i] + ffn_out[i])
        i = i + 1
    }
    return y
}

// ── Forward (top-level) ─────────────────────────────────────────────────────
// forward_one_token(token_id, position, weights, rope_cos, rope_sin)
//   → logits (vocab_size,)
//
// weights: full ckpt dict from safetensors_read.
// position: t = current position (0-indexed)
//
// Tied lm_head: weights does NOT contain "lm_head.weight"; we use tok_emb.weight
// (per .meta.json tied_aliases).
fn forward_one_token(token_id: int, t: int, weights, rope_cos, rope_sin) {
    let tok_emb_w = weights["tok_emb.weight"]
    let mut x = embedding_lookup(token_id, tok_emb_w)

    let n_layers = 24
    let mut layer = 0
    while layer < n_layers {
        let prefix = "layers." + to_string(layer) + "."
        // build a small layer-local weights dict (slice of full weights by prefix)
        // For Phase 3, this should use prefix-based key lookup directly to avoid copies.
        // Scaffold: pass full weights and let engine_ag_block resolve keys.
        let layer_w = _layer_slice(weights, prefix)
        x = engine_ag_block(x, layer_w, rope_cos, rope_sin, t)
        layer = layer + 1
    }

    // final RMSNorm + tied lm_head
    let norm_f_w = weights["norm_f.weight"]
    x = rms_norm(x, norm_f_w, 0.00001)
    // tied lm_head: matmul tok_emb @ x → (vocab,)
    let logits = matvec(tok_emb_w, x)
    return logits
}

// Helper: extract weights dict for a layer.
// In production, prefer direct keyed access in engine_ag_block.
fn _layer_slice(weights, prefix: string) {
    let out = #{}
    let keys = dict_keys(weights)
    let mut i = 0
    let plen = len(prefix)
    while i < len(keys) {
        let k = keys[i]
        if len(k) > plen && k.substring(0, plen) == prefix {
            let inner_key = k.substring(plen, len(k))
            out[inner_key] = weights[k]
        }
        i = i + 1
    }
    return out
}

// ── Selftest (Phase 3 GQA shape parity) ─────────────────────────────────────
// Synthetic input: seq_len=4, d_model=1024 zeros + small noise.
// Verifies gqa_forward produces (seq_len, d_model) output with finite values.
// Uses ZERO weight matrices so output is deterministically zero — this is a
// shape-only smoke (real-weight parity is Phase 5).
fn selftest() {
    println("[engine_ag_nn] selftest: GQA shape parity (synthetic)")
    let seq_len = 4
    let d_model = 1024
    let n_heads = 16
    let n_kv_heads = 4
    let d_head = 64

    // build (seq_len, d_model) input — zeros with one noise spike per token
    let mut x_seq = []
    let mut t = 0
    while t < seq_len {
        let mut row = []
        let mut i = 0
        while i < d_model {
            row.push(0.0)
            i = i + 1
        }
        row[t] = 0.01 * (t + 1)        // noise spike
        x_seq.push(row)
        t = t + 1
    }

    // build zero weight matrices: q_w/o_w (1024,1024), k_w/v_w (256,1024)
    let kv_dim = n_kv_heads * d_head
    let mut q_w = []
    let mut o_w = []
    let mut r = 0
    while r < d_model {
        let mut row = []
        let mut c = 0
        while c < d_model { row.push(0.0); c = c + 1 }
        q_w.push(row)
        o_w.push(row)
        r = r + 1
    }
    let mut k_w = []
    let mut v_w = []
    r = 0
    while r < kv_dim {
        let mut row = []
        let mut c = 0
        while c < d_model { row.push(0.0); c = c + 1 }
        k_w.push(row)
        v_w.push(row)
        r = r + 1
    }

    // RoPE tables (identity: cos=1, sin=0 — disables rotation for shape test)
    let half = d_head / 2
    let mut rope_cos = []
    let mut rope_sin = []
    t = 0
    while t < seq_len {
        let mut cos_row = []
        let mut sin_row = []
        let mut j = 0
        while j < half {
            cos_row.push(1.0)
            sin_row.push(0.0)
            j = j + 1
        }
        rope_cos.push(cos_row)
        rope_sin.push(sin_row)
        t = t + 1
    }

    let out_seq = gqa_forward(
        x_seq, q_w, k_w, v_w, o_w,
        rope_cos, rope_sin, n_heads, n_kv_heads, d_head
    )

    // shape check: F-GQA-SHAPE-1
    let ok_outer = len(out_seq) == seq_len
    let ok_inner = len(out_seq[0]) == d_model
    println("  out_seq len = " + to_string(len(out_seq)) + " (expect " + to_string(seq_len) + ")")
    println("  out_seq[0] len = " + to_string(len(out_seq[0])) + " (expect " + to_string(d_model) + ")")
    if ok_outer && ok_inner {
        println("  SHAPE_OK")
    } else {
        println("  SHAPE_FAIL")
    }

    // finite check: zero weights ⇒ all outputs zero (trivially finite)
    let mut all_zero = true
    let mut i = 0
    while i < d_model {
        if out_seq[0][i] != 0.0 { all_zero = false }
        i = i + 1
    }
    if all_zero {
        println("  FINITE_OK (zero-weight forward yields zero vec)")
    } else {
        println("  FINITE_WARN (non-zero with zero weights — investigate)")
    }
}

// ── Selftest scaffold ───────────────────────────────────────────────────────
fn main() {
    println("engine_ag_nn.hexa — Phase 3 nn primitives + GQA")
    println("status: RMSNorm/SwiGLU/RoPE + GQA (6 fns) implemented")
    println("        gqa_forward: (seq_len,1024) → (seq_len,1024) — F-GQA-SHAPE-1")
    println("        forward_one_token wiring complete (KV cache → Phase 4)")
    println("")
    println("RMSNorm smoke test:")
    let x = [1.0, 2.0, 3.0, 4.0]
    let g = [1.0, 1.0, 1.0, 1.0]
    let y = rms_norm(x, g, 0.00001)
    println("  rms_norm([1,2,3,4], gamma=ones, eps=1e-5):")
    let mut i = 0
    while i < len(y) {
        println("    y[" + to_string(i) + "] = " + to_string(y[i]))
        i = i + 1
    }
    // Expected: mean(x^2) = (1+4+9+16)/4 = 7.5, rsqrt = 0.3651
    //           y = x * 0.3651 = [0.365, 0.730, 1.095, 1.460]
    println("  expected ≈ [0.365, 0.730, 1.095, 1.460]")

    println("")
    println("SiLU smoke:")
    let s_in = [-2.0, -1.0, 0.0, 1.0, 2.0]
    let s_out = silu(s_in)
    let mut j = 0
    while j < len(s_out) {
        println("  silu(" + to_string(s_in[j]) + ") = " + to_string(s_out[j]))
        j = j + 1
    }
    // Expected: silu(-2)≈-0.238, silu(-1)≈-0.269, silu(0)=0, silu(1)≈0.731, silu(2)≈1.762
}
