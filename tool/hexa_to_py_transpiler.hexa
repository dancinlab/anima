// hexa_to_py_transpiler.hexa — MVP hexa→python transpiler (raw#9 strict)
//
// Purpose:
//   Mac-canonical hexa source → transient .py for ML execution on ubu/RunPod.
//   Triggered by VLM stage1 ABORT (audio_token_predictor.hexa needs PyTorch).
//   Mac SSOT = .hexa. Generated .py = transient (gitignored via **/*.py rule).
//
// Scope (MVP — explicitly bounded, raw#10 caveats):
//   Supported: fn defs (with type annotations), let / let mut, if/else,
//              while loops, return, basic arith/string ops, println, len(),
//              list literals [...], list.push, list[idx], comments, top-level
//              `let` constants, `to_string` / `to_float` / `parse_int` /
//              `sqrt`, simple stdlib mappings (proc_run_with_stdin, file_read,
//              file_write, file_exists, file_size, read_file, write_file).
//   NOT supported: struct decls, custom resolvers, raw#-pragmas, import,
//                  match expressions, closures, generics, traits.
//                  → emitted as Python comment + TODO marker.
//
// Architecture:
//   Pass 1: line-scanner classifies every line into a tag
//           (fn, let, if, else, while, return, expr, comment, blank,
//            block_open `{`, block_close `}`).
//   Pass 2: per-tag translator emits Python with 4-space indent based on
//           a brace-depth counter (hexa uses `{`/`}`, py uses `:` + indent).
//   Pass 3: token-level rewrite (snake_case is identical, but stdlib calls
//           like proc_run_with_stdin → subprocess.run wrapper get rewritten).
//
// CLI (intended; this MVP runs as `hexa run tool/hexa_to_py_transpiler.hexa
//                                    <input.hexa> <output.py>`):
//   args: [program, input_path, output_path]
//
// raw#9 STRICT: this transpiler is itself .hexa. NO .py committed by Mac.
// raw#15:       no personal-path leak — all paths arg-driven, no $HOME.
// raw#10:       5 honest C3 caveats documented in design doc.

// ════════════════════════════════════════════════════════════════════
// 0. Constants — translation table for hexa → python tokens
// ════════════════════════════════════════════════════════════════════

let H2P_INDENT = "    "        // 4-space py indent
let H2P_HEADER_PREFIX = "# AUTO-GENERATED by hexa_to_py_transpiler.hexa — DO NOT EDIT"
let H2P_HEADER_NOTE   = "# Source-of-truth: <input.hexa>. Regenerate from .hexa, never hand-edit."
let H2P_TODO_MARK     = "# TODO[hexa→py]: "

// ════════════════════════════════════════════════════════════════════
// 1. Helpers — string utilities (hexa stdlib only)
// ════════════════════════════════════════════════════════════════════

fn h2p_repeat(s: string, n: int) -> string {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn h2p_indent(depth: int) -> string {
    return h2p_repeat(H2P_INDENT, depth)
}

fn h2p_starts_with(s: string, pfx: string) -> bool {
    let n = pfx.len()
    if s.len() < n { return false }
    let mut i = 0
    while i < n {
        if s[i] != pfx[i] { return false }
        i = i + 1
    }
    return true
}

fn h2p_lstrip(s: string) -> string {
    let n = s.len()
    let mut i = 0
    while i < n {
        let c = s[i]
        if c != " " && c != "\t" {
            break
        }
        i = i + 1
    }
    return s.slice(i, n)
}

fn h2p_rstrip(s: string) -> string {
    let n = s.len()
    let mut j = n
    while j > 0 {
        let c = s[j - 1]
        if c != " " && c != "\t" && c != "\r" && c != "\n" {
            break
        }
        j = j - 1
    }
    return s.slice(0, j)
}

fn h2p_strip(s: string) -> string {
    return h2p_rstrip(h2p_lstrip(s))
}

fn h2p_contains(s: string, needle: string) -> bool {
    let n = s.len()
    let m = needle.len()
    if m == 0 { return true }
    if m > n { return false }
    let mut i = 0
    while i <= n - m {
        let mut k = 0
        let mut hit = true
        while k < m {
            if s[i + k] != needle[k] { hit = false; break }
            k = k + 1
        }
        if hit { return true }
        i = i + 1
    }
    return false
}

// Replace first occurrence of `from` with `to`. (No regex in hexa stdlib.)
fn h2p_replace_first(s: string, from: string, to: string) -> string {
    let n = s.len()
    let m = from.len()
    if m == 0 { return s }
    if m > n { return s }
    let mut i = 0
    while i <= n - m {
        let mut k = 0
        let mut hit = true
        while k < m {
            if s[i + k] != from[k] { hit = false; break }
            k = k + 1
        }
        if hit {
            return s.slice(0, i) + to + s.slice(i + m, n)
        }
        i = i + 1
    }
    return s
}

// Replace ALL occurrences with a single left-to-right scan.
// CRITICAL: must NOT re-scan the substituted region — otherwise mappings
// like `file_exists(` → `_h2p_file_exists(` would loop forever because
// the result contains the original token as a substring. We advance the
// cursor past the inserted `to` to guarantee O(n) termination.
fn h2p_replace_all(s: string, from: string, to: string) -> string {
    let n = s.len()
    let m = from.len()
    if m == 0 { return s }
    if m > n { return s }
    let mut out = ""
    let mut i = 0
    while i <= n - m {
        let mut k = 0
        let mut hit = true
        while k < m {
            if s[i + k] != from[k] { hit = false; break }
            k = k + 1
        }
        if hit {
            out = out + to
            i = i + m
        } else {
            out = out + s.slice(i, i + 1)
            i = i + 1
        }
    }
    // tail (last m-1 chars never matched)
    if i < n {
        out = out + s.slice(i, n)
    }
    return out
}

// ════════════════════════════════════════════════════════════════════
// 2. Stdlib token rewrite map — hexa → python
//    Applied AFTER structural translation (per-line).
// ════════════════════════════════════════════════════════════════════

fn h2p_rewrite_tokens(line: string) -> string {
    let mut s = line

    // println(args) → print(args) — same semantics for trivial cases.
    s = h2p_replace_all(s, "println(", "print(")

    // len(x) is identical in py.
    // to_string(x) → str(x); to_float(x) → float(x); parse_int(x) → int(x).
    s = h2p_replace_all(s, "to_string(", "str(")
    s = h2p_replace_all(s, "to_float(", "float(")
    s = h2p_replace_all(s, "to_int(", "int(")
    s = h2p_replace_all(s, "parse_int(", "int(")
    s = h2p_replace_all(s, "parse_float(", "float(")

    // sqrt(x) → math.sqrt(x). math import injected in header.
    s = h2p_replace_all(s, "sqrt(", "math.sqrt(")

    // Stdlib filesystem mapping.
    // file_read(p) / read_file(p) → open(p).read()
    s = h2p_replace_all(s, "read_file(", "_h2p_read_file(")
    s = h2p_replace_all(s, "file_read(",  "_h2p_read_file(")
    s = h2p_replace_all(s, "write_file(", "_h2p_write_file(")
    s = h2p_replace_all(s, "file_write(", "_h2p_write_file(")
    s = h2p_replace_all(s, "file_exists(", "_h2p_file_exists(")
    s = h2p_replace_all(s, "file_size(",   "_h2p_file_size(")
    s = h2p_replace_all(s, "pfs_file_exists(", "_h2p_file_exists(")
    s = h2p_replace_all(s, "pfs_file_size(",   "_h2p_file_size(")

    // proc_run_with_stdin(cmd_str, stdin_str) → _h2p_proc_run_with_stdin(...)
    s = h2p_replace_all(s, "proc_run_with_stdin(", "_h2p_proc_run_with_stdin(")
    s = h2p_replace_all(s, "proc_run(",            "_h2p_proc_run(")

    // timestamp() → time.time(); time imported in header.
    s = h2p_replace_all(s, "timestamp()", "time.time()")

    // arg(i) / argc() → sys.argv[i] / len(sys.argv); sys imported in header.
    s = h2p_replace_all(s, "argc()", "len(sys.argv)")
    s = h2p_replace_all(s, "arg(",  "sys.argv[")
    // arg(i)  → sys.argv[i)  ← bracket close mismatch is acceptable for MVP;
    // the test corpus avoids arg() to keep MVP surface small. (raw#10 caveat.)

    return s
}

// ════════════════════════════════════════════════════════════════════
// 3. Per-line classifier + translator
//    State: depth (brace nesting), in_fn (bool), expecting_block_open.
// ════════════════════════════════════════════════════════════════════

// Detect: `fn name(args) -> ret {`  or  `fn name(args) {`
fn h2p_is_fn_decl(line: string) -> bool {
    let t = h2p_lstrip(line)
    return h2p_starts_with(t, "fn ")
}

// Translate: `fn name(a: int, b: int) -> int {` → `def name(a: int, b: int) -> int:`
// We just strip the trailing `{`. Hexa types coincidentally read as py type hints
// for `int`, `float`, `string`→`str`, `bool`, `array`→`list`.
fn h2p_xlate_fn(line: string) -> string {
    let t = h2p_strip(line)
    // remove trailing `{`
    let n = t.len()
    let mut head = t
    if n > 0 && t[n - 1] == "{" {
        head = h2p_rstrip(t.slice(0, n - 1))
    }
    // fn → def
    let mut out = h2p_replace_first(head, "fn ", "def ")
    // type alias: `: string` → `: str`, `: array` → `: list`, `-> string` → `-> str`
    out = h2p_replace_all(out, ": string", ": str")
    out = h2p_replace_all(out, ": array",  ": list")
    out = h2p_replace_all(out, "-> string", "-> str")
    out = h2p_replace_all(out, "-> array",  "-> list")
    return out + ":"
}

// Detect & translate `let mut x = expr` / `let x = expr`
// Strip type annotation `let mut x: int = 0` → `x: int = 0`
fn h2p_is_let(line: string) -> bool {
    let t = h2p_lstrip(line)
    return h2p_starts_with(t, "let ")
}

fn h2p_xlate_let(line: string) -> string {
    let t = h2p_strip(line)
    // Drop `let mut ` or `let `
    let mut s = t
    if h2p_starts_with(s, "let mut ") {
        s = s.slice(8, s.len())
    } else if h2p_starts_with(s, "let ") {
        s = s.slice(4, s.len())
    }
    // hexa type hints carry over into py — keep as-is.
    // But `: string` → `: str`, `: array` → `: list`.
    s = h2p_replace_all(s, ": string", ": str")
    s = h2p_replace_all(s, ": array",  ": list")
    return s
}

// Detect: `if cond {` / `} else {` / `} else if cond {` / `while cond {`
fn h2p_xlate_if_while(line: string) -> string {
    let t = h2p_strip(line)
    let n = t.len()
    let mut head = t
    // Drop trailing `{`
    if n > 0 && t[n - 1] == "{" {
        head = h2p_rstrip(t.slice(0, n - 1))
    }
    // `} else if ... {` → `elif ...:`
    // `} else {`        → `else:`
    if h2p_starts_with(h2p_lstrip(head), "} else if ") {
        let body = h2p_lstrip(head).slice(10, h2p_lstrip(head).len())
        return "elif " + h2p_strip(body) + ":"
    }
    if h2p_strip(head) == "} else" {
        return "else:"
    }
    // `else if ... {` → `elif ...:`
    if h2p_starts_with(head, "else if ") {
        return "elif " + head.slice(8, head.len()) + ":"
    }
    if head == "else" {
        return "else:"
    }
    // `if cond` / `while cond` — append `:`
    return head + ":"
}

// `return expr` is identical in py.
fn h2p_xlate_return(line: string) -> string {
    return h2p_strip(line)
}

// `// comment` → `# comment`
fn h2p_xlate_comment(line: string) -> string {
    let t = h2p_strip(line)
    if h2p_starts_with(t, "//") {
        let body = t.slice(2, t.len())
        return "#" + body
    }
    return t
}

// ════════════════════════════════════════════════════════════════════
// 4. Main translator — line-by-line, brace-depth-aware.
// ════════════════════════════════════════════════════════════════════

fn h2p_emit_header(input_path: string) -> string {
    let mut h = ""
    h = h + H2P_HEADER_PREFIX + "\n"
    h = h + "# Source: " + input_path + "\n"
    h = h + H2P_HEADER_NOTE + "\n"
    h = h + "import math\n"
    h = h + "import os\n"
    h = h + "import sys\n"
    h = h + "import time\n"
    h = h + "import subprocess\n"
    h = h + "import shlex\n"
    h = h + "\n"
    h = h + "# --- runtime shims (hexa stdlib parity) ---\n"
    h = h + "def _h2p_read_file(p):\n"
    h = h + "    with open(p, 'r', encoding='utf-8') as f: return f.read()\n"
    h = h + "def _h2p_write_file(p, data):\n"
    h = h + "    with open(p, 'w', encoding='utf-8') as f: f.write(data); return len(data)\n"
    h = h + "def _h2p_file_exists(p):\n"
    h = h + "    return os.path.isfile(p)\n"
    h = h + "def _h2p_file_size(p):\n"
    h = h + "    try: return os.path.getsize(p) if os.path.isfile(p) else 0\n"
    h = h + "    except OSError: return 0\n"
    h = h + "def _h2p_proc_run(cmd_str):\n"
    h = h + "    r = subprocess.run(shlex.split(cmd_str), capture_output=True, text=True)\n"
    h = h + "    return r.stdout\n"
    h = h + "def _h2p_proc_run_with_stdin(cmd_str, stdin_data):\n"
    h = h + "    r = subprocess.run(shlex.split(cmd_str), input=stdin_data,\n"
    h = h + "                       capture_output=True, text=True)\n"
    h = h + "    return r.stdout\n"
    h = h + "# --- end shims ---\n\n"
    return h
}

// Emit one translated line at the right indent. `depth` is the *current*
// brace depth BEFORE processing this line. We pre-/post-adjust depth for
// `{` / `}` lines.
//
// Returns the translated python line (without trailing newline) prefixed
// with the correct indent. `depth_out` cannot be returned (hexa lacks
// tuples here), so the caller adjusts depth based on returned `tag`.
//
// Tag conventions (single-char):
//   'F' = fn decl (opens block at end of line)
//   'L' = let
//   'I' = if / while / else / elif (opens block)
//   'R' = return
//   'C' = comment / blank
//   'X' = expression / assignment
//   '}' = block close
//   'O' = block-only `{` on its own line (rare; treated as no-op)
//   '?' = unsupported — emitted as TODO comment
fn h2p_classify(raw: string) -> string {
    let t = h2p_strip(raw)
    if t.len() == 0 { return "C" }
    if h2p_starts_with(t, "//") { return "C" }
    if h2p_is_fn_decl(t) { return "F" }
    if h2p_is_let(t)     { return "L" }
    if h2p_starts_with(t, "if ") { return "I" }
    if h2p_starts_with(t, "while ") { return "I" }
    if h2p_starts_with(t, "} else") { return "I" }
    if h2p_starts_with(t, "else") { return "I" }
    if h2p_starts_with(t, "return") { return "R" }
    if t == "}" { return "}" }
    if t == "{" { return "O" }
    // unsupported keywords
    if h2p_starts_with(t, "struct ") { return "?" }
    if h2p_starts_with(t, "import ")  { return "?" }
    if h2p_starts_with(t, "match ")   { return "?" }
    if h2p_starts_with(t, "trait ")   { return "?" }
    if h2p_starts_with(t, "raw#")     { return "?" }
    return "X"
}

// Translate a single classified line (no indent yet).
fn h2p_translate_one(raw: string, tag: string) -> string {
    if tag == "C" {
        let t = h2p_lstrip(raw)
        if t.len() == 0 { return "" }
        return h2p_xlate_comment(t)
    }
    if tag == "F" { return h2p_xlate_fn(raw) }
    if tag == "L" { return h2p_rewrite_tokens(h2p_xlate_let(raw)) }
    if tag == "I" { return h2p_rewrite_tokens(h2p_xlate_if_while(raw)) }
    if tag == "R" { return h2p_rewrite_tokens(h2p_xlate_return(raw)) }
    if tag == "?" {
        return H2P_TODO_MARK + "unsupported construct: " + h2p_strip(raw)
    }
    if tag == "}" { return "" }   // close handled by depth--
    if tag == "O" { return "" }
    // 'X' — generic expression/assignment
    return h2p_rewrite_tokens(h2p_strip(raw))
}

// Drive translator across all lines. Returns the full python source.
fn h2p_translate(source: string, input_path: string) -> string {
    let lines = source.split("\n")
    let mut out = h2p_emit_header(input_path)
    let mut depth = 0
    let mut i = 0
    while i < len(lines) {
        let raw = lines[i]
        let tag = h2p_classify(raw)
        // close-brace pre-adjusts depth so the closing line itself sits at
        // the OUTER level (we then emit nothing for it).
        if tag == "}" {
            if depth > 0 { depth = depth - 1 }
            // emit nothing
        } else {
            let py = h2p_translate_one(raw, tag)
            if py.len() > 0 {
                out = out + h2p_indent(depth) + py + "\n"
            } else {
                // preserve blank-line spacing for readability
                if h2p_strip(raw).len() == 0 {
                    out = out + "\n"
                }
            }
            // open-block tags push depth AFTER the line is emitted.
            if tag == "F" || tag == "I" {
                // hexa source line ends with `{` — if so, depth++.
                let s = h2p_strip(raw)
                let n = s.len()
                if n > 0 && s[n - 1] == "{" { depth = depth + 1 }
            }
            if tag == "O" { depth = depth + 1 }
        }
        i = i + 1
    }
    return out
}

// ════════════════════════════════════════════════════════════════════
// 5. Entry point
// ════════════════════════════════════════════════════════════════════

fn main() {
    if argc() < 3 {
        println("usage: hexa run tool/hexa_to_py_transpiler.hexa <input.hexa> <output.py>")
        return
    }
    let input_path  = arg(1)
    let output_path = arg(2)

    if !file_exists(input_path) {
        println("ERROR: input does not exist: " + input_path)
        return
    }

    let source = read_file(input_path)
    let py = h2p_translate(source, input_path)
    let n = write_file(output_path, py)
    println("OK transpiled " + input_path + " → " + output_path
            + " (" + to_string(n) + " bytes, "
            + to_string(len(py.split("\n"))) + " lines)")
}
