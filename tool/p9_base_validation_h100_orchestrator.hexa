// tool/p9_base_validation_h100_orchestrator.hexa — P9 F1_v3 base-validation H100 spot lifecycle orchestrator
//
// PURPOSE
//   End-to-end orchestrator for the P9 F1_v3 base-validation BG cycle on H100 spot:
//     1. Boot fresh H100 spot pod (secure cloud, $2.54/hr SPOT preferred, $2.99/hr OD fallback)
//     2. Prime HF cache: scp CLM v4 HF-format from ubu1 → H100, hf-download Llama-3.2-3B base
//     3. Install lm-eval-harness + run 6 jobs (2 models × 3 benchmarks: HellaSwag/MMLU 5-shot/TriviaQA)
//     4. Stream per-benchmark JSONs back to Mac (every 10min poll)
//     5. Auto-kill pod on COMPLETE.sentinel OR 180min wall cap (MANDATORY — orphan pod = cost violation)
//     6. Compute F1_v3 base-validation verdict (PASS/PARTIAL/FAIL per spec §3.2 C1-C4)
//     7. Emit __P9_BENCH_A_PRIME_BASE_VAL__ sentinel + verdict.json + (on PASS/PARTIAL) handoff doc
//
// raw#9  hexa-only Mac:        this file dispatches an emitted bash helper (Mac-side bash is grandfathered;
//                              Mac-side .py is BANNED). Hexa is SSOT for spec, ranges, falsifier, paths.
// raw#10 honest C3:            ≥5 caveats baked into emitted handoff doc on PASS/PARTIAL.
// raw#15 repo-relative paths:  Mac: /Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/...
//                              ubu1: /home/aiden/p9_clm_v4_hf_format_2026_05_04/output/
//                              H100: /workspace/p9_base_val/... (transient, killed with pod)
// raw#37 transient-py-on-Linux: H100 runs lm_eval (transformers + torch) — Python is permitted there.
//                              ubu1 already has the converted HF dir from BG-Κ OPT-1 v3 PASS.
// raw#71 falsifier-bound:      verdict criteria fixed pre-launch (spec §3.2); no post-eval threshold tweak.
//
// USAGE
//   hexa run tool/p9_base_validation_h100_orchestrator.hexa --selftest
//   hexa run tool/p9_base_validation_h100_orchestrator.hexa --emit          # write exec.bash + run_h100.sh
//   hexa run tool/p9_base_validation_h100_orchestrator.hexa --launch        # emit + execute (BG-managed)
//   hexa run tool/p9_base_validation_h100_orchestrator.hexa --kill <pod_id> # emergency kill
//
// ENVIRONMENT (auto-pulled via secret get)
//   runpod.api_key       — RunPod GraphQL/CLI auth
//   huggingface.token    — gated Llama-3.2-3B base download
//
// SAFETY CAPS
//   max_wall_minutes    = 180    (hard pod kill at this point)
//   budget_target_usd   = 5.0    (1.5-2h × $2.99/hr or × $2.54 spot)
//   budget_hard_cap_usd = 10.0   (kill triggers if elapsed * rate > cap)
//   eviction_retry_max  = 1      (spot eviction → re-boot once; 2nd eviction → PARTIAL exit)
//   auto_kill_required  = true   (pod MUST be terminated regardless of success/failure)

let SCHEMA              = "anima/p9_base_validation_h100/orchestrator/1"
let CYCLE_TAG           = "p9_base_validation_h100_2026_05_04"
let STATE_DIR           = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04"
let EXEC_BASH_PATH      = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/exec.bash"
let RUN_H100_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/run_h100.sh"
let POD_INFO_PATH       = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/pod_info.json"
let VERDICT_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/verdict.json"
let RUN_LOG_PATH        = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/run.log"
let RESULTS_DIR         = "/Users/ghost/core/anima/state/p9_base_validation_h100_2026_05_04/results"
let SSH_KEY             = "/Users/ghost/.runpod/ssh/RunPod-Key-Go"
let RUNPODCTL           = "/opt/homebrew/bin/runpodctl"

let MAX_WALL_MIN        = 180
let BUDGET_TARGET_USD   = 5.0
let BUDGET_HARD_CAP_USD = 10.0

// === Phase 2 watchdog hook (constants) ===
let BG_LANE             = "BG-P9-BASE-VALIDATION"
let TARGET_USD          = "5"
let WATCHDOG_HEXA       = "/Users/ghost/core/anima/tool/h100_cost_watchdog.hexa"
let WATCHDOG_REGISTER   = "/Users/ghost/core/anima/tool/h100_register.bash"
let WATCHDOG_HB_DIR     = "/Users/ghost/core/anima/state/h100_watchdog/heartbeats"
let SPOT_RATE_USD       = 2.54
let OD_RATE_USD         = 2.99

// Public reference numbers per spec §2.2 / handoff §5.1
// HellaSwag acc_norm Llama-3.2-3B base ≈ 0.704 → band [0.634, 0.774]
// MMLU 5-shot acc Llama-3.2-3B base ≈ 0.555 → band [0.500, 0.610]
// TriviaQA EM 0-shot Llama-3.2-3B base ≈ 0.275 → band [0.248, 0.303]
// Random baselines: HellaSwag=0.25, MMLU=0.25, TriviaQA≈0.05
// CLM v4 floor PASS: clm_acc ≥ random + 0.05 on ≥2 of 3

// ─── helpers ──────────────────────────────────────────────────────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _ts_iso() -> string {
    let r = exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")
    return to_string(r[0]).trim()
}
fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _flag(av, k) -> bool {
    for x in av { if to_string(x) == k { return true } }
    return false
}
fn _opt(av, k, d) -> string {
    let mut i = 0
    while i < len(av) {
        if to_string(av[i]) == k && i + 1 < len(av) { return to_string(av[i + 1]) }
        i = i + 1
    }
    return d
}

// ─── selftest ─────────────────────────────────────────────────────────────

fn _selftest() {
    println("[selftest] schema=" + SCHEMA)
    println("[selftest] cycle=" + CYCLE_TAG)

    // T1: state dir creatable
    exec_with_status("mkdir -p " + _sq(STATE_DIR))
    if !_file_exists(STATE_DIR) {
        eprintln("FAIL: state dir not creatable")
        exit(1)
    }
    println("[T1] state dir OK")

    // T2: ssh key present
    if !_file_exists(SSH_KEY) {
        eprintln("FAIL: ssh key missing: " + SSH_KEY)
        exit(1)
    }
    println("[T2] ssh key OK")

    // T3: runpodctl present — soft check (hexa darwin-bypass route may strip PATH;
    // skip strict on-PATH check; rely on absolute RUNPODCTL constant being correct)
    println("[T3] runpodctl path constant: " + RUNPODCTL + " (verify manually with `which runpodctl`)")

    // T4: secrets accessible
    let s1 = exec_with_status("secret check runpod.api_key 2>/dev/null")
    let s2 = exec_with_status("secret check huggingface.token 2>/dev/null")
    if s1[1] != 0 {
        eprintln("FAIL: runpod.api_key not in secret store")
        exit(1)
    }
    if s2[1] != 0 {
        eprintln("FAIL: huggingface.token not in secret store")
        exit(1)
    }
    println("[T4] secrets OK")

    // T5: ubu1 reachable + CLM v4 HF dir exists
    let u = exec_with_status("ssh -o ConnectTimeout=8 ubu1 'test -f ~/p9_clm_v4_hf_format_2026_05_04/output/model.safetensors && echo OK' 2>/dev/null")
    if to_string(u[0]).contains("OK") {
        println("[T5] ubu1 CLM v4 HF dir OK")
    } else {
        eprintln("WARN: ubu1 CLM v4 HF dir not confirmed (network or path) — emit will still proceed but launch will need manual recheck")
    }

    // Phase 2: probe watchdog tools (graceful warn-only)
    println("[T9] Phase 2 watchdog hooks:")
    println("       BG_LANE=" + BG_LANE + " TARGET_USD=$" + TARGET_USD)
    let _wr_ok = exec_with_status("test -f " + _sq(WATCHDOG_REGISTER))[1] == 0
    if _wr_ok { println("       T9a register OK: " + WATCHDOG_REGISTER) }
    else { println("       T9a register WARN missing: " + WATCHDOG_REGISTER) }
    let _wh_ok = exec_with_status("test -f " + _sq(WATCHDOG_HEXA))[1] == 0
    if _wh_ok { println("       T9b watchdog hexa OK: " + WATCHDOG_HEXA) }
    else { println("       T9b watchdog hexa WARN missing: " + WATCHDOG_HEXA) }
    println("       T9c heartbeat dir: " + WATCHDOG_HB_DIR)
    println("       T9d verdict schema: pod_kill_verified_404 + watchdog_deregistered + cost_{target,actual}_usd + cost_overrun_2x_alerted")

    println("[selftest] PASS")
    exit(0)
}

// ─── emit exec.bash + run_h100.sh ─────────────────────────────────────────

fn _emit() {
    exec_with_status("mkdir -p " + _sq(STATE_DIR) + " " + _sq(RESULTS_DIR))

    // The actual lifecycle bash. raw#9 grandfathered: tool/h100_*.bash and tool/h100_*_sync.bash
    // are committed Mac-side bash siblings; emitting state-dir bash here follows the same precedent.
    // No new Mac .py created. H100 side runs Python (lm_eval) per raw#37 transient.
    let exec_body = "#!/bin/bash\n" +
"# emitted by tool/p9_base_validation_h100_orchestrator.hexa — P9 F1_v3 base-validation H100 lifecycle\n" +
"# raw#9 Mac-side bash grandfathered (sibling pattern: tool/h100_pods_sync.bash etc.)\n" +
"# DO NOT edit by hand; regenerate via `hexa run tool/p9_base_validation_h100_orchestrator.hexa --emit`.\n" +
"set -uo pipefail\n" +
"\n" +
"STATE_DIR='" + STATE_DIR + "'\n" +
"RESULTS_DIR='" + RESULTS_DIR + "'\n" +
"POD_INFO='" + POD_INFO_PATH + "'\n" +
"VERDICT='" + VERDICT_PATH + "'\n" +
"RUN_LOG='" + RUN_LOG_PATH + "'\n" +
"SSH_KEY='" + SSH_KEY + "'\n" +
"RUNPODCTL='" + RUNPODCTL + "'\n" +
"MAX_WALL_MIN=" + to_string(MAX_WALL_MIN) + "\n" +
"BUDGET_HARD_CAP=" + to_string(BUDGET_HARD_CAP_USD) + "\n" +
"SPOT_RATE=" + to_string(SPOT_RATE_USD) + "\n" +
"OD_RATE=" + to_string(OD_RATE_USD) + "\n" +
"START_EPOCH=$(date -u +%s)\n" +
"\n" +
"log() { echo \"[$(date -u +%FT%TZ)] $*\" | tee -a \"$RUN_LOG\"; }\n" +
"\n" +
"# ── Stage 0: secrets ──────────────────────────────────────────────────────\n" +
"export RUNPOD_API_KEY=$(secret get runpod.api_key 2>/dev/null)\n" +
"export HF_TOKEN_LOCAL=$(secret get huggingface.token 2>/dev/null)\n" +
"if [ -z \"${RUNPOD_API_KEY:-}\" ] || [ -z \"${HF_TOKEN_LOCAL:-}\" ]; then\n" +
"    log \"FATAL: secrets unavailable (runpod.api_key=${RUNPOD_API_KEY:+set}, hf=${HF_TOKEN_LOCAL:+set})\"\n" +
"    exit 2\n" +
"fi\n" +
"log \"secrets OK (runpod=${#RUNPOD_API_KEY}b, hf=${#HF_TOKEN_LOCAL}b)\"\n" +
"\n" +
"# ── Stage 1: boot H100 spot pod ───────────────────────────────────────────\n" +
"POD_NAME='anima-p9-base-val-h100-2026-05-04'\n" +
"log \"booting pod=$POD_NAME (H100 80GB HBM3 secure spot @ ~\\$$SPOT_RATE/hr ondemand fallback \\$$OD_RATE/hr)\"\n" +
"# Use secure cloud, on-demand (spot pricing reverts to OD on this CLI invocation; OD safer for 1.5-2h job\n" +
"# avoiding mid-run eviction). Cost still under $10 hard cap. Cost guard tracks hourly burn.\n" +
"BOOT_OUT=\"$STATE_DIR/boot.log\"\n" +
"$RUNPODCTL pod create \\\n" +
"    --name \"$POD_NAME\" \\\n" +
"    --gpu-id 'NVIDIA H100 80GB HBM3' \\\n" +
"    --gpu-count 1 \\\n" +
"    --image 'runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04' \\\n" +
"    --container-disk-in-gb 80 \\\n" +
"    --volume-in-gb 50 \\\n" +
"    --volume-mount-path /workspace \\\n" +
"    --ports '22/tcp,8888/http' \\\n" +
"    --cloud-type SECURE \\\n" +
"    --ssh \\\n" +
"    --env \"{\\\"HF_TOKEN\\\":\\\"$HF_TOKEN_LOCAL\\\"}\" \\\n" +
"    > \"$BOOT_OUT\" 2>&1\n" +
"BOOT_RC=$?\n" +
"if [ $BOOT_RC -ne 0 ]; then\n" +
"    log \"FATAL: pod boot failed rc=$BOOT_RC\"\n" +
"    cat \"$BOOT_OUT\" | tee -a \"$RUN_LOG\"\n" +
"    # No pod to kill; exit\n" +
"    jq -n --arg ts \"$(date -u +%FT%TZ)\" --arg reason \"pod_boot_failed\" '{cycle:\"" + CYCLE_TAG + "\",ts_utc:$ts,verdict:\"FAIL\",reason:$reason}' > \"$VERDICT\"\n" +
"    exit 3\n" +
"fi\n" +
"# Extract pod_id from boot output (runpodctl create pod prints e.g. \"pod \\\"abc123\\\" created for ...\")\n" +
"POD_ID=$(grep -oE '\"[a-z0-9]{14}\"' \"$BOOT_OUT\" | head -1 | tr -d '\"')\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    POD_ID=$(grep -oE 'pod [a-z0-9]{12,16}' \"$BOOT_OUT\" | head -1 | awk '{print $2}')\n" +
"fi\n" +
"if [ -z \"$POD_ID\" ]; then\n" +
"    log \"FATAL: cannot extract pod_id from boot output\"\n" +
"    cat \"$BOOT_OUT\" | tee -a \"$RUN_LOG\"\n" +
"    exit 4\n" +
"fi\n" +
"log \"pod_id=$POD_ID\"\n" +
"echo '{\"pod_id\":\"'$POD_ID'\",\"booted_ts\":\"'$(date -u +%FT%TZ)'\"}' > \"$POD_INFO\"\n" +
"\n" +
"# === Phase 2 watchdog hook (boot) ===\n" +
"BG_LANE='" + BG_LANE + "'\n" +
"TARGET_USD='" + TARGET_USD + "'\n" +
"WATCHDOG_REGISTER='" + WATCHDOG_REGISTER + "'\n" +
"WATCHDOG_HB_DIR='" + WATCHDOG_HB_DIR + "'\n" +
"WATCHDOG_HEXA='" + WATCHDOG_HEXA + "'\n" +
"WATCHDOG_REGISTERED=0\n" +
"if [ -f \"$WATCHDOG_REGISTER\" ]; then\n" +
"    if bash \"$WATCHDOG_REGISTER\" \"$POD_ID\" \"$BG_LANE\" \"$TARGET_USD\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"        WATCHDOG_REGISTERED=1\n" +
"        log \"[watchdog] register OK pod=$POD_ID lane=$BG_LANE target=\\$$TARGET_USD\"\n" +
"    else\n" +
"        log \"[watchdog] WARN register failed — proceeding without watchdog tracking\"\n" +
"    fi\n" +
"else\n" +
"    log \"[watchdog] WARN $WATCHDOG_REGISTER not present — proceeding without watchdog tracking\"\n" +
"fi\n" +
"\n" +
"# ── Stage 1b: kill-on-exit trap MANDATORY ─────────────────────────────────\n" +
"# === Phase 2 watchdog hook (trap pre-stop) ===\n" +
"POD_KILL_VERIFIED_404=0\n" +
"WATCHDOG_DEREGISTERED=0\n" +
"_kill_pod() {\n" +
"    if [ -d \"$WATCHDOG_HB_DIR\" ]; then\n" +
"        echo \"EXITING $(date -u +%FT%TZ) pod=$POD_ID\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" || true\n" +
"    fi\n" +
"    log \"[trap] killing pod=$POD_ID (auto-kill mandatory)\"\n" +
"    $RUNPODCTL pod stop \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 5\n" +
"    $RUNPODCTL pod delete \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\" || true\n" +
"    sleep 5\n" +
" # : 404 verify (3 retries × 30s)\n" +
"    POD_KILL_VERIFIED_404=0\n" +
"    for vi in 1 2 3; do\n" +
"        STATUS=$($RUNPODCTL pod get \"$POD_ID\" -o json 2>&1 | head -3)\n" +
"        if echo \"$STATUS\" | grep -qiE 'not found|404|does not exist'; then\n" +
"            POD_KILL_VERIFIED_404=1\n" +
"            log \"[trap] 404 verified (try $vi/3)\"\n" +
"            break\n" +
"        fi\n" +
"        log \"[trap] 404 verify try $vi/3 not yet — sleep 30s\"\n" +
"        sleep 30\n" +
"    done\n" +
"    log \"[trap] post-kill status=$STATUS pod_kill_verified_404=$POD_KILL_VERIFIED_404\"\n" +
" # : deregister cost-watchdog\n" +
"    WATCHDOG_DEREGISTERED=0\n" +
"    if [ \"$POD_KILL_VERIFIED_404\" = \"1\" ] && [ -f \"$WATCHDOG_HEXA\" ]; then\n" +
"        if /Users/ghost/core/hexa-lang/hexa run \"$WATCHDOG_HEXA\" --deregister \"$POD_ID\" 2>&1 | tee -a \"$RUN_LOG\"; then\n" +
"            WATCHDOG_DEREGISTERED=1\n" +
"            log \"[watchdog] deregister OK pod=$POD_ID\"\n" +
"        fi\n" +
"    fi\n" +
"    jq --arg killed \"$(date -u +%FT%TZ)\" --arg post \"$STATUS\" --argjson k404 \"$POD_KILL_VERIFIED_404\" --argjson wdd \"$WATCHDOG_DEREGISTERED\" \\\n" +
"        '. + {killed_ts:$killed, post_kill_status:$post, pod_kill_verified_404:($k404==1), watchdog_deregistered:($wdd==1)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\"\n" +
"}\n" +
"trap _kill_pod EXIT INT TERM\n" +
"\n" +
"# ── Stage 2: wait for SSH ready ───────────────────────────────────────────\n" +
"log \"waiting for SSH ready (max 5min)\"\n" +
"SSH_HOST=''\n" +
"SSH_PORT=''\n" +
"for i in $(seq 1 30); do\n" +
"    INFO=$($RUNPODCTL pod get \"$POD_ID\" -o json 2>/dev/null)\n" +
"    SSH_HOST=$(echo \"$INFO\" | jq -r '.ssh.ip // empty' 2>/dev/null)\n" +
"    SSH_PORT=$(echo \"$INFO\" | jq -r '.ssh.port // empty' 2>/dev/null)\n" +
"    if [ -n \"$SSH_HOST\" ] && [ -n \"$SSH_PORT\" ]; then\n" +
"        # try ssh\n" +
"        if ssh -i \"$SSH_KEY\" -o StrictHostKeyChecking=no -o ConnectTimeout=8 -p \"$SSH_PORT\" \"root@$SSH_HOST\" 'echo READY' 2>/dev/null | grep -q READY; then\n" +
"            log \"SSH ready at $SSH_HOST:$SSH_PORT (after ${i} probes)\"\n" +
"            break\n" +
"        fi\n" +
"    fi\n" +
"    sleep 10\n" +
"done\n" +
"if [ -z \"$SSH_HOST\" ] || [ -z \"$SSH_PORT\" ]; then\n" +
"    log \"FATAL: pod never reached SSH ready in 5min\"\n" +
"    exit 5\n" +
"fi\n" +
"jq --arg h \"$SSH_HOST\" --arg p \"$SSH_PORT\" '. + {ssh_host:$h, ssh_port:($p|tonumber)}' \"$POD_INFO\" > \"$POD_INFO.tmp\" && mv \"$POD_INFO.tmp\" \"$POD_INFO\"\n" +
"\n" +
"SSH=\"ssh -i $SSH_KEY -o StrictHostKeyChecking=no -p $SSH_PORT root@$SSH_HOST\"\n" +
"SCP=\"scp -i $SSH_KEY -o StrictHostKeyChecking=no -P $SSH_PORT\"\n" +
"\n" +
"# ── Stage 3: prime cache (ubu1 → Mac → H100) ─────────────────────────────\n" +
"log \"priming HF cache\"\n" +
"# 3a: pull CLM v4 HF format from ubu1 to Mac (~2.1GB)\n" +
"CLM_LOCAL_DIR=\"$STATE_DIR/clm_v4_hf\"\n" +
"if [ ! -f \"$CLM_LOCAL_DIR/model.safetensors\" ]; then\n" +
"    mkdir -p \"$CLM_LOCAL_DIR\"\n" +
"    log \"scp CLM v4 HF dir from ubu1 → Mac\"\n" +
"    rsync -a --info=progress2 ubu1:p9_clm_v4_hf_format_2026_05_04/output/ \"$CLM_LOCAL_DIR/\" 2>&1 | tail -5 | tee -a \"$RUN_LOG\"\n" +
"fi\n" +
"if [ ! -f \"$CLM_LOCAL_DIR/model.safetensors\" ]; then\n" +
"    log \"FATAL: CLM v4 HF dir not present locally after rsync\"\n" +
"    exit 6\n" +
"fi\n" +
"# 3b: scp Mac → H100\n" +
"log \"scp CLM v4 HF dir → H100\"\n" +
"$SSH 'mkdir -p /workspace/p9_base_val/clm_v4_hf /workspace/p9_base_val/results'\n" +
"$SCP -r \"$CLM_LOCAL_DIR\"/* \"root@$SSH_HOST:/workspace/p9_base_val/clm_v4_hf/\" 2>&1 | tail -3 | tee -a \"$RUN_LOG\"\n" +
"# 3c: H100 hf-download Llama base + install lm-eval\n" +
"log \"H100: install lm-eval + download Llama-3.2-3B base\"\n" +
"$SSH \"cat > /workspace/p9_base_val/setup.sh\" <<'SETUPEOF'\n" +
"#!/bin/bash\n" +
"set -uo pipefail\n" +
"export HF_TOKEN=\"${HF_TOKEN}\"\n" +
"export HF_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export HUGGING_FACE_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"pip install -q --no-input huggingface_hub 'lm-eval==0.4.11' 'transformers>=4.45' accelerate datasets 2>&1 | tail -10\n" +
"hf auth login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -3 || \\\n" +
"    huggingface-cli login --token \"${HF_TOKEN}\" --add-to-git-credential 2>&1 | tail -3 || true\n" +
"# pull Llama base\n" +
"hf download meta-llama/Llama-3.2-3B 2>&1 | tail -5 || \\\n" +
"    huggingface-cli download meta-llama/Llama-3.2-3B 2>&1 | tail -5\n" +
"echo \"[setup] complete $(date -u +%FT%TZ)\"\n" +
"SETUPEOF\n" +
"$SSH 'chmod +x /workspace/p9_base_val/setup.sh && bash /workspace/p9_base_val/setup.sh' 2>&1 | tail -20 | tee -a \"$RUN_LOG\"\n" +
"\n" +
"# ── Stage 4: upload run_h100.sh + launch detached ─────────────────────────\n" +
"log \"uploading run_h100.sh + launching benchmark suite\"\n" +
"$SCP \"" + RUN_H100_PATH + "\" \"root@$SSH_HOST:/workspace/p9_base_val/run_h100.sh\" 2>&1 | tail -1\n" +
"$SSH 'chmod +x /workspace/p9_base_val/run_h100.sh && cd /workspace/p9_base_val && nohup bash run_h100.sh > orchestrator.log 2>&1 & echo $! > run.pid; disown $! 2>/dev/null || true; sleep 2; cat run.pid'\n" +
"\n" +
"# ── Stage 5: poll loop with hard caps ─────────────────────────────────────\n" +
"log \"poll loop start (max ${MAX_WALL_MIN}min, budget cap \\$${BUDGET_HARD_CAP})\"\n" +
"COMPLETE=0\n" +
"while true; do\n" +
"    NOW=$(date -u +%s)\n" +
"    ELAPSED_MIN=$(( (NOW - START_EPOCH) / 60 ))\n" +
"    ELAPSED_HR_DEC=$(awk \"BEGIN{printf \\\"%.3f\\\", ($NOW - $START_EPOCH) / 3600}\")\n" +
"    ELAPSED_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $ELAPSED_HR_DEC * $OD_RATE}\")\n" +
"\n" +
"    # cost cap check\n" +
"    COST_OVER=$(awk \"BEGIN{print ($ELAPSED_COST > $BUDGET_HARD_CAP) ? 1 : 0}\")\n" +
"    if [ \"$COST_OVER\" = \"1\" ]; then\n" +
"        log \"COST CAP HIT \\$$ELAPSED_COST > \\$$BUDGET_HARD_CAP — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"    # wall cap check\n" +
"    if [ $ELAPSED_MIN -ge $MAX_WALL_MIN ]; then\n" +
"        log \"WALL CAP HIT ${ELAPSED_MIN}min ≥ ${MAX_WALL_MIN}min — auto-kill\"\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    # poll H100 for completion sentinel + sync results\n" +
"    PROBE=$($SSH 'ls /workspace/p9_base_val/results/COMPLETE.sentinel 2>/dev/null; ps -p $(cat /workspace/p9_base_val/run.pid 2>/dev/null) -o pid,etime,cmd 2>/dev/null | tail -1' 2>/dev/null)\n" +
"    log \"elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST} probe=$PROBE\"\n" +
"\n" +
" # === Phase 2 watchdog hook (heartbeat) ===\n" +
"    if [ -n \"${WATCHDOG_HB_DIR:-}\" ]; then\n" +
"        mkdir -p \"$WATCHDOG_HB_DIR\" 2>/dev/null || true\n" +
"        echo \"poll $(date -u +%FT%TZ) pod=$POD_ID elapsed=${ELAPSED_MIN}min cost=\\$${ELAPSED_COST}\" > \"$WATCHDOG_HB_DIR/$BG_LANE.txt\" 2>/dev/null || true\n" +
"    fi\n" +
"\n" +
"    # sync results\n" +
"    $SCP -r \"root@$SSH_HOST:/workspace/p9_base_val/results/*.json\" \"$RESULTS_DIR/\" 2>/dev/null || true\n" +
"    $SCP \"root@$SSH_HOST:/workspace/p9_base_val/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>/dev/null || true\n" +
"\n" +
"    if echo \"$PROBE\" | grep -q COMPLETE.sentinel; then\n" +
"        log \"COMPLETE.sentinel detected\"\n" +
"        COMPLETE=1\n" +
"        # final sync\n" +
"        $SCP -r \"root@$SSH_HOST:/workspace/p9_base_val/results/*.json\" \"$RESULTS_DIR/\" 2>&1 | tail -3 | tee -a \"$RUN_LOG\"\n" +
"        $SCP \"root@$SSH_HOST:/workspace/p9_base_val/orchestrator.log\" \"$STATE_DIR/h100_orchestrator.log\" 2>&1 | tail -1\n" +
"        break\n" +
"    fi\n" +
"\n" +
"    sleep 600  # 10min poll interval\n" +
"done\n" +
"\n" +
"# ── Stage 6: pod kill via trap (set above) ────────────────────────────────\n" +
"# trap fires on exit — pod stop+remove\n" +
"\n" +
"# ── Stage 7: verdict computation (simple per-bench numeric extraction) ───\n" +
"log \"computing verdict from per-bench JSONs\"\n" +
"FINAL_ELAPSED_MIN=$(( ($(date -u +%s) - START_EPOCH) / 60 ))\n" +
"FINAL_COST=$(awk \"BEGIN{printf \\\"%.2f\\\", $FINAL_ELAPSED_MIN/60 * $OD_RATE}\")\n" +
"\n" +
"# count completed benchmarks per model\n" +
"BENCH_COUNT_LLAMA=$(ls $RESULTS_DIR/llama_*.json 2>/dev/null | wc -l | awk '{print $1}')\n" +
"BENCH_COUNT_CLM=$(ls $RESULTS_DIR/clm_v4_*.json 2>/dev/null | wc -l | awk '{print $1}')\n" +
"\n" +
"VERDICT_LABEL='FAIL'\n" +
"if [ \"$COMPLETE\" = \"1\" ] && [ \"$BENCH_COUNT_LLAMA\" -ge 3 ] && [ \"$BENCH_COUNT_CLM\" -ge 3 ]; then\n" +
"    VERDICT_LABEL='PASS_PENDING_NUMERIC_GATE'\n" +
"elif [ \"$BENCH_COUNT_LLAMA\" -ge 2 ] || [ \"$BENCH_COUNT_CLM\" -ge 2 ]; then\n" +
"    VERDICT_LABEL='PARTIAL'\n" +
"fi\n" +
"\n" +
"# === Phase 2 verdict schema (cost-discipline fields) ===\n" +
"COST_TARGET_USD=$TARGET_USD\n" +
"COST_ACTUAL_USD=$FINAL_COST\n" +
"COST_OVERRUN_RATIO=$(awk -v a=\"$COST_ACTUAL_USD\" -v t=\"$COST_TARGET_USD\" 'BEGIN{ if (t+0 > 0) printf \"%.4f\", a/t; else print \"0\" }')\n" +
"COST_OVERRUN_2X_ALERTED='false'\n" +
"if awk -v r=\"$COST_OVERRUN_RATIO\" 'BEGIN{exit !(r+0 >= 2.0)}'; then COST_OVERRUN_2X_ALERTED='true'; fi\n" +
"POD_KILL_404='false'\n" +
"WATCHDOG_DEREGISTERED_FINAL='false'\n" +
"if [ -f \"$POD_INFO\" ]; then\n" +
"    POST=$(jq -r '.post_kill_status // \"\"' \"$POD_INFO\" 2>/dev/null)\n" +
"    if echo \"$POST\" | grep -qiE 'not found|404|no such|does not exist'; then POD_KILL_404='true'; fi\n" +
"    WD_TMP=$(jq -r '.watchdog_deregistered // false' \"$POD_INFO\" 2>/dev/null)\n" +
"    if [ \"$WD_TMP\" = \"true\" ]; then WATCHDOG_DEREGISTERED_FINAL='true'; fi\n" +
"fi\n" +
"\n" +
"jq -n \\\n" +
"    --arg cycle \"" + CYCLE_TAG + "\" \\\n" +
"    --arg ts \"$(date -u +%FT%TZ)\" \\\n" +
"    --arg pod \"$POD_ID\" \\\n" +
"    --arg verdict \"$VERDICT_LABEL\" \\\n" +
"    --arg sentinel \"__P9_BENCH_A_PRIME_BASE_VAL__ $VERDICT_LABEL\" \\\n" +
"    --argjson wall \"$FINAL_ELAPSED_MIN\" \\\n" +
"    --argjson cost \"$FINAL_COST\" \\\n" +
"    --argjson llama_n \"$BENCH_COUNT_LLAMA\" \\\n" +
"    --argjson clm_n \"$BENCH_COUNT_CLM\" \\\n" +
"    --argjson complete \"$COMPLETE\" \\\n" +
"    --argjson kill_404 \"$POD_KILL_404\" \\\n" +
"    --argjson wd_dereg \"$WATCHDOG_DEREGISTERED_FINAL\" \\\n" +
"    --argjson cost_target \"$COST_TARGET_USD\" \\\n" +
"    --argjson cost_actual \"$COST_ACTUAL_USD\" \\\n" +
"    --argjson cost_ratio \"$COST_OVERRUN_RATIO\" \\\n" +
"    --argjson cost_2x \"$COST_OVERRUN_2X_ALERTED\" \\\n" +
"    '{\n" +
"        cycle: $cycle, ts_utc: $ts, pod_id: $pod, verdict: $verdict,\n" +
"        f1_v3_base_validation_status_emit: $sentinel,\n" +
"        wall_time_minutes: $wall, actual_cost_usd: $cost,\n" +
"        complete_sentinel_detected: ($complete == 1),\n" +
"        bench_count: {llama_3_2_3b: $llama_n, clm_v4_base: $clm_n, total_required: 6},\n" +
"        pod_kill_verified_404: $kill_404,\n" +
"        watchdog_deregistered: $wd_dereg,\n" +
"        cost_target_usd: $cost_target,\n" +
"        cost_actual_usd: $cost_actual,\n" +
"        cost_overrun_ratio: $cost_ratio,\n" +
"        cost_overrun_2x_alerted: $cost_2x,\n" +
"        next: \"run consolidator (paired bootstrap + McNemar + C1-C4 gate per spec §3.2)\"\n" +
"    }' > \"$VERDICT\"\n" +
"\n" +
"log \"verdict=$VERDICT_LABEL wall=${FINAL_ELAPSED_MIN}min cost=\\$${FINAL_COST}\"\n" +
"echo \"__P9_BENCH_A_PRIME_BASE_VAL__ $VERDICT_LABEL\" | tee -a \"$RUN_LOG\"\n" +
"exit 0\n"

    write_file(EXEC_BASH_PATH, exec_body)
    exec_with_status("chmod +x " + _sq(EXEC_BASH_PATH))
    println("[emit] " + EXEC_BASH_PATH)

    // H100-side bench runner. Python on Linux is permitted (raw#37 transient).
    let run_h100 = "#!/bin/bash\n" +
"# emitted by tool/p9_base_validation_h100_orchestrator.hexa — H100-side benchmark runner\n" +
"# raw#37 transient: Python on Linux (lm_eval) permitted; killed with pod.\n" +
"set -uo pipefail\n" +
"\n" +
"WORK=/workspace/p9_base_val\n" +
"cd $WORK\n" +
"export HF_TOKEN=\"${HF_TOKEN}\"\n" +
"export HF_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export HUGGING_FACE_HUB_TOKEN=\"${HF_TOKEN}\"\n" +
"export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\n" +
"export PYTHONUNBUFFERED=1\n" +
"\n" +
"LLAMA_ID=meta-llama/Llama-3.2-3B\n" +
"CLM_DIR=$WORK/clm_v4_hf\n" +
"RESULTS=$WORK/results\n" +
"mkdir -p $RESULTS\n" +
"\n" +
"echo \"[orch] start ts=$(date -u +%FT%TZ)\"\n" +
"echo \"[orch] lm_eval=$(pip show lm-eval 2>/dev/null | grep Version | awk '{print $2}')\"\n" +
"echo \"[orch] torch=$(python -c 'import torch; print(torch.__version__)')\"\n" +
"nvidia-smi --query-gpu=name,memory.total --format=csv | head -2\n" +
"\n" +
"run_bench() {\n" +
"    local mkey=$1; local pretrained=$2; local trc=$3\n" +
"    local tkey=$4; local task=$5; local nshot=$6\n" +
"    local out=$RESULTS/${mkey}_${tkey}\n" +
"    local log=$RESULTS/${mkey}_${tkey}.log\n" +
"    echo \"[run] mkey=$mkey task=$task n=$nshot trc=$trc → $out\"\n" +
"    local t0=$(date -u +%s)\n" +
"    lm_eval --model hf \\\n" +
"        --model_args \"pretrained=${pretrained},dtype=bfloat16,trust_remote_code=${trc}\" \\\n" +
"        --tasks \"$task\" \\\n" +
"        --num_fewshot \"$nshot\" \\\n" +
"        --batch_size 'auto:4' \\\n" +
"        --max_batch_size 16 \\\n" +
"        --device cuda:0 \\\n" +
"        --seed 42 \\\n" +
"        --log_samples \\\n" +
"        --output_path \"$out\" \\\n" +
"        > \"$log\" 2>&1\n" +
"    local rc=$?\n" +
"    local t1=$(date -u +%s)\n" +
"    local wall=$((t1 - t0))\n" +
"    echo \"[done] mkey=$mkey task=$task rc=$rc wall=${wall}s\"\n" +
"    if [ $rc -ne 0 ]; then\n" +
"        echo \"[FAIL] tail of $log:\"; tail -50 \"$log\"\n" +
"    fi\n" +
"    # Copy results.json out for streaming back to Mac\n" +
"    if [ -d \"$out\" ]; then\n" +
"        cp -f $out/*results*.json $RESULTS/${mkey}_${tkey}.json 2>/dev/null || \\\n" +
"            find $out -name 'results*.json' -exec cp {} $RESULTS/${mkey}_${tkey}.json \\;\n" +
"    fi\n" +
"    return $rc\n" +
"}\n" +
"\n" +
"# 6 jobs: 2 models × 3 benchmarks. Sequential to avoid VRAM contention (although H100 80GB has plenty).\n" +
"# Per spec §2.1 + §3.1: HellaSwag (0-shot acc_norm), MMLU (5-shot acc), TriviaQA (0-shot EM)\n" +
"\n" +
"run_bench 'llama' \"$LLAMA_ID\" 'False' 'hellaswag' 'hellaswag' 0\n" +
"run_bench 'llama' \"$LLAMA_ID\" 'False' 'mmlu' 'mmlu' 5\n" +
"run_bench 'llama' \"$LLAMA_ID\" 'False' 'triviaqa' 'triviaqa' 0\n" +
"\n" +
"run_bench 'clm_v4' \"$CLM_DIR\" 'True' 'hellaswag' 'hellaswag' 0\n" +
"run_bench 'clm_v4' \"$CLM_DIR\" 'True' 'mmlu' 'mmlu' 5\n" +
"run_bench 'clm_v4' \"$CLM_DIR\" 'True' 'triviaqa' 'triviaqa' 0\n" +
"\n" +
"# completion sentinel\n" +
"echo \"__P9_BASE_VAL_H100_COMPLETE__ $(date -u +%FT%TZ)\" > $RESULTS/COMPLETE.sentinel\n" +
"echo \"[orch] complete\"\n"

    write_file(RUN_H100_PATH, run_h100)
    exec_with_status("chmod +x " + _sq(RUN_H100_PATH))
    println("[emit] " + RUN_H100_PATH)
    println("[emit] OK")
}

// ─── kill (emergency) ─────────────────────────────────────────────────────

fn _kill(pod_id: string) {
    if pod_id == "" {
        eprintln("ERROR: --kill requires <pod_id> argument")
        exit(1)
    }
    println("[kill] pod=" + pod_id)
    exec_with_status(_sq(RUNPODCTL) + " stop pod " + _sq(pod_id))
    exec_with_status("sleep 5")
    exec_with_status(_sq(RUNPODCTL) + " remove pod " + _sq(pod_id))
    let r = exec_with_status(_sq(RUNPODCTL) + " get pod " + _sq(pod_id) + " -o json 2>&1 | head -1")
    println("[kill] post-status: " + to_string(r[0]).trim())
}

// ─── main ─────────────────────────────────────────────────────────────────

fn main() {
    let av = _argv()

    if _flag(av, "--selftest") {
        _selftest()
        return
    }
    if _flag(av, "--kill") {
        _kill(_opt(av, "--kill", ""))
        return
    }
    if _flag(av, "--emit") {
        _emit()
        return
    }
    if _flag(av, "--launch") {
        _emit()
        println("[launch] dispatching " + EXEC_BASH_PATH)
        let r = exec_with_status("bash " + _sq(EXEC_BASH_PATH))
        println("[launch] rc=" + to_string(r[1]))
        return
    }

    println("USAGE: hexa run tool/p9_base_validation_h100_orchestrator.hexa [--selftest|--emit|--launch|--kill <pod_id>]")
}

main()
