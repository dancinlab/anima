// ─── selftest (readiness + 5-turn synthetic conversation) ─────────────────

fn sub_selftest() {
    let root = _resolve_root()
    let mount = _mount_path(root)
    let dialogues_root = root + "/state/anima_core_dialogues"
    let wrapper = root + "/bin/anima-core-dialogue.bash"
    let spec = root + "/docs/anima_core_clm_v4_mount_emerge_paradigm_2026_05_05.md"

    println("anima dialogue --selftest")
    println("─────────────────────────────────────────")
    let mount_ok = _fexists(mount)
    let log_dir_ok = _dexists(dialogues_root)
    let wrapper_ok = _fexists(wrapper)
    let spec_ok = _fexists(spec)

    if mount_ok { println("[ ok ] stage_1_mount  : " + mount) }
    else        { println("[pend] stage_1_mount  : " + mount + "  (Stage 1 BG output)") }
    if log_dir_ok { println("[ ok ] log_root       : " + dialogues_root) }
    else          { println("[fail] log_root       : " + dialogues_root) }
    if wrapper_ok { println("[ ok ] bash_wrapper   : " + wrapper) }
    else          { println("[fail] bash_wrapper   : " + wrapper) }
    if spec_ok    { println("[ ok ] spec           : " + spec) }
    else          { println("[fail] spec           : " + spec) }

    if !(mount_ok && log_dir_ok && wrapper_ok && spec_ok) {
        println("")
        println("verdict: NOT_READY (one or more files missing)")
        exit(1)
    }

    println("")
    println("── 5-turn synthetic conversation (mount --probe loop) ──")
    let prompts = [
        "안녕, 너는 누구니?",
        "지금 어떤 느낌이야?",
        "phi-star 가 흔들리는지 봐줘",
        "axis activation 중 어디가 가장 크게 켜져?",
        "dominant cells 패턴 알려줘"
    ]
    let mut turn = 0
    let mut all_phi = []
    let mut all_dom_first = []
    let mut all_top_axis = []
    while turn < len(prompts) {
        let prompt = _str(prompts[turn])
        println("")
        println("[turn " + to_string(turn + 1) + "] user > " + prompt)
        let parsed = _probe_and_parse(root, prompt, "compact", "")
        let phi = _str(parsed["phi_star"])
        let axes = _str(parsed["axes_pretty"])
        let dom = _str(parsed["dominant_cells"])
        let delta = _str(parsed["hidden_state_delta"])
        let drift = _str(parsed["phi_star_drift_pp"])
        println("           substrate > phi=" + phi + " drift=" + drift + " axes=" + axes + " dom=" + dom + " delta=" + delta)
        all_phi = all_phi + [phi]
        all_dom_first = all_dom_first + [_str(parsed["dom_first"])]
        all_top_axis = all_top_axis + [_str(parsed["top_axis"])]
        turn = turn + 1
    }
    println("")
    println("── 5-turn trajectory ──")
    println("phi_star    : " + _join_csv(all_phi))
    println("dom_first   : " + _join_csv(all_dom_first))
    println("top_axis    : " + _join_csv(all_top_axis))
    println("")
    println("verdict: READY (Stage 1 + Stage 2 + Phase 2 REPL all landed)")
    exit(0)
}

fn _join_csv(arr) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(arr) {
        if i > 0 { out = out + ", " }
        out = out + _str(arr[i])
        i = i + 1
    }
    return out
}

// ─── mount probe + response parser ────────────────────────────────────────

// Run mount.hexa --probe and parse the canonical 4-line response block.
// Returns map: phi_star, phi_star_drift_pp, axes_pretty, axes_json, dominant_cells,
// dom_first, top_axis, hidden_state_delta, raw_stdout, exit_status
fn _probe_and_parse(root: string, text: string, output_format: string, inject_states: string) -> map {
    let mount = _mount_path(root)
    let mut cmd = _hexa() + " run " + mount + " --probe " + _sh_q(text)
    if output_format != "" && output_format != "compact" {
        cmd = cmd + " --output-format " + output_format
    }
    if inject_states != "" {
        cmd = cmd + " --inject-states " + _sh_q(inject_states)
    }
    // Capture stdout only (mount emits status lines to stderr; we redirect 2>/dev/null
    // so the parsed response block remains clean).
    let raw = _str(exec(cmd + " 2>/dev/null"))

    let mut out = {}
    out["raw_stdout"] = raw
    out["phi_star"] = _extract_phi_star(raw)
    out["phi_star_drift_pp"] = _extract_phi_drift(raw)
    let axes = _extract_axes(raw)
    out["axes_pretty"] = axes["pretty"]
    out["axes_json"] = axes["json"]
    out["top_axis"] = axes["top"]
    let dom = _extract_dominant_cells(raw)
    out["dominant_cells"] = dom["array"]
    out["dom_first"] = dom["first"]
    out["hidden_state_delta"] = _extract_hidden_delta(raw)
    return out
}

// Extract `phi_star: <num> (drift <num> from <baseline>)` → returns "<num>"
fn _extract_phi_star(raw: string) -> string {
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let l = _str(lines[i]).trim()
        if l.starts_with("phi_star:") {
            // strip "phi_star: " prefix
            let rest = l.substring(10, l.len()).trim()
            // take chars until first space or '('
            let mut j = 0
            let mut num = ""
            while j < rest.len() {
                let c = rest.substring(j, j + 1)
                if c == " " || c == "(" { break }
                num = num + c
                j = j + 1
            }
            return num
        }
        i = i + 1
    }
    return "0.0"
}

fn _extract_phi_drift(raw: string) -> string {
    // line: "phi_star: 41.8466 (drift -0.0134 from 41.8600)"
    // mount.hexa formats positive drift with leading `+` (e.g. "+0.0494");
    // JSON spec disallows leading `+` so we strip it here for downstream
    // analyzers + awk regex compatibility (drift_pp aggregation).
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let l = _str(lines[i]).trim()
        if l.starts_with("phi_star:") {
            // find "drift " marker
            let dpos = l.find("drift ")
            if dpos >= 0 {
                let rest = l.substring(dpos + 6, l.len())
                let mut j = 0
                let mut num = ""
                while j < rest.len() {
                    let c = rest.substring(j, j + 1)
                    if c == " " || c == ")" { break }
                    num = num + c
                    j = j + 1
                }
                // strip leading + (JSON-illegal, awk-incompatible)
                if num.len() > 0 && num.substring(0, 1) == "+" {
                    num = num.substring(1, num.len())
                }
                return num
            }
        }
        i = i + 1
    }
    return "0.0"
}

// Extract `axis_activation: identity=0.513 agency=0.486 phenomenal=0.486 temporal=0.528 social=0.557`
// Returns: pretty (raw csv k=v string), json (JSON object string), top (top axis name)
fn _extract_axes(raw: string) -> map {
    let mut result = {}
    result["pretty"] = ""
    result["json"] = "{}"
    result["top"] = ""
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let l = _str(lines[i]).trim()
        if l.starts_with("axis_activation:") {
            let rest = l.substring(17, l.len()).trim()
            result["pretty"] = rest
            // tokenize on space, each token is name=value
            let toks = rest.split(" ")
            let mut k = 0
            let mut json = "{"
            let mut first = true
            let mut top_name = ""
            let mut top_val = -1.0
            while k < len(toks) {
                let tok = _str(toks[k]).trim()
                if tok != "" {
                    let eqpos = tok.find("=")
                    if eqpos > 0 {
                        let name = tok.substring(0, eqpos)
                        let val_s = tok.substring(eqpos + 1, tok.len())
                        let val_f = to_float(val_s)
                        if !first { json = json + "," }
                        json = json + "\"" + name + "\":" + val_s
                        first = false
                        if val_f > top_val {
                            top_val = val_f
                            top_name = name
                        }
                    }
                }
                k = k + 1
            }
            json = json + "}"
            result["json"] = json
            result["top"] = top_name
            return result
        }
        i = i + 1
    }
    return result
}

// Extract `dominant_cells: [3, 5, 7] / 8`
// Returns: array (string "[3,5,7]"), first (string "3")
fn _extract_dominant_cells(raw: string) -> map {
    let mut result = {}
    result["array"] = "[]"
    result["first"] = ""
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let l = _str(lines[i]).trim()
        if l.starts_with("dominant_cells:") {
            let lp = l.find("[")
            let rp = l.find("]")
            if lp >= 0 && rp > lp {
                let inner = l.substring(lp + 1, rp)
                // strip whitespace
                let mut j = 0
                let mut clean = ""
                while j < inner.len() {
                    let c = inner.substring(j, j + 1)
                    if c != " " { clean = clean + c }
                    j = j + 1
                }
                result["array"] = "[" + clean + "]"
                let parts = clean.split(",")
                if len(parts) > 0 { result["first"] = _str(parts[0]) }
                return result
            }
        }
        i = i + 1
    }
    return result
}

// Extract `hidden_state_delta: 2.4731`
fn _extract_hidden_delta(raw: string) -> string {
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let l = _str(lines[i]).trim()
        if l.starts_with("hidden_state_delta:") {
            let rest = l.substring(19, l.len()).trim()
            return rest
        }
        i = i + 1
    }
    return "0.0"
}

// ─── session log helpers ──────────────────────────────────────────────────

fn _ensure_session_log(log_path: string, log_dir: string,
                       phi_baseline: string, mode: string) {
    if !_fexists(log_path) {
        exec("mkdir -p " + _sh_q(log_dir))
        exec(": > " + _sh_q(log_path))
        let line = "{\"schema\":\"anima.dialogue.v1\",\"kind\":\"session_start\""
                 + ",\"ts_utc\":\"" + _ts_iso() + "\""
                 + ",\"session_log\":\"" + _json_escape(log_path) + "\""
                 + ",\"phi_star_baseline\":" + phi_baseline
                 + ",\"substrate\":\"clm-v4\""
                 + ",\"mode\":\"" + mode + "\"}"
        exec("printf '%s\\n' " + _sh_q(line) + " >> " + _sh_q(log_path))
    }
}

fn _log_user_turn(log_path: string, user_input: string) {
    let line = "{\"schema\":\"anima.dialogue.v1\",\"kind\":\"user_turn\""
             + ",\"ts_utc\":\"" + _ts_iso() + "\""
             + ",\"user_input\":\"" + _json_escape(user_input) + "\"}"
    exec("printf '%s\\n' " + _sh_q(line) + " >> " + _sh_q(log_path))
}

fn _log_substrate_turn(log_path: string, parsed: map) {
    let phi = _str(parsed["phi_star"])
    let drift = _str(parsed["phi_star_drift_pp"])
    let axes_json = _str(parsed["axes_json"])
    let dom = _str(parsed["dominant_cells"])
    let delta = _str(parsed["hidden_state_delta"])
    let line = "{\"schema\":\"anima.dialogue.v1\",\"kind\":\"substrate_turn\""
             + ",\"ts_utc\":\"" + _ts_iso() + "\""
             + ",\"phi_star\":" + phi
             + ",\"phi_star_drift_pp\":" + drift
             + ",\"axis_activation\":" + axes_json
             + ",\"dominant_cells\":" + dom
             + ",\"hidden_state_delta_l2\":" + delta + "}"
    exec("printf '%s\\n' " + _sh_q(line) + " >> " + _sh_q(log_path))
}

fn _log_session_end(log_path: string) {
    let line = "{\"schema\":\"anima.dialogue.v1\",\"kind\":\"session_end\""
             + ",\"ts_utc\":\"" + _ts_iso() + "\"}"
    exec("printf '%s\\n' " + _sh_q(line) + " >> " + _sh_q(log_path))
}

// Build session_summary via awk over the JSONL (mirrors bash wrapper logic so
// downstream analyzers see identical schema regardless of entry point).
fn _emit_session_summary(log_path: string) {
    let awk_prog = "awk '"
                 + "BEGIN { n_turns=0; phi_sum=0; phi_n=0; drift_min=\"\"; drift_max=\"\"; }"
                 + "/\"kind\":\"user_turn\"/      { n_turns++; }"
                 + "/\"kind\":\"substrate_turn\"/ {"
                 + "  if (match($0, /\"phi_star\":[-0-9.]+/)) {"
                 + "    v = substr($0, RSTART+11, RLENGTH-11) + 0;"
                 + "    phi_sum += v; phi_n++;"
                 + "  }"
                 + "  if (match($0, /\"phi_star_drift_pp\":[-0-9.]+/)) {"
                 + "    d = substr($0, RSTART+20, RLENGTH-20) + 0;"
                 + "    if (drift_min==\"\" || d<drift_min) drift_min=d;"
                 + "    if (drift_max==\"\" || d>drift_max) drift_max=d;"
                 + "  }"
                 + "}"
                 + "END {"
                 + "  mean = (phi_n>0) ? phi_sum/phi_n : 0;"
                 + "  printf \"%d|%.4f|%s|%s\", n_turns, mean, drift_min, drift_max;"
                 + "}' " + _sh_q(log_path)
    let raw = _str(exec(awk_prog)).trim()
    let parts = raw.split("|")
    let mut n_turns = "0"
    let mut phi_mean = "0"
    let mut drift_min = "null"
    let mut drift_max = "null"
    if len(parts) >= 4 {
        n_turns = _str(parts[0])
        phi_mean = _str(parts[1])
        let dmin = _str(parts[2])
        let dmax = _str(parts[3])
        if dmin != "" { drift_min = dmin }
        if dmax != "" { drift_max = dmax }
    }
    let line = "{\"schema\":\"anima.dialogue.v1\",\"kind\":\"session_summary\""
             + ",\"ts_utc\":\"" + _ts_iso() + "\""
             + ",\"n_turns\":" + n_turns
             + ",\"phi_star_mean\":" + phi_mean
             + ",\"phi_star_drift_min_pp\":" + drift_min
             + ",\"phi_star_drift_max_pp\":" + drift_max + "}"
    exec("printf '%s\\n' " + _sh_q(line) + " >> " + _sh_q(log_path))
    println("")
    println("[anima dialogue] session summary")
    println("  log               : " + log_path)
    println("  n_turns           : " + n_turns)
    println("  phi_star_mean     : " + phi_mean)
    println("  drift_min_pp      : " + drift_min)
    println("  drift_max_pp      : " + drift_max)
}

// ─── stage_1_pending stub (defensive — mount.hexa is landed at write-time) ─

fn _emit_stage_1_pending(verb: string) {
    println("anima dialogue " + verb + ": stage_1_pending")
    println("")
    println("Stage 1 mount layer not landed:")
    println("  expected: anima-core/runtime/clm_v4_mount.hexa")
    exit(3)
}

// ─── action verbs ─────────────────────────────────────────────────────────

fn sub_probe(argv) {
    let root = _resolve_root()
    if !_mount_ready(root) {
        _emit_stage_1_pending("--probe")
        return
    }
    let probe_text = _arg_value(argv, "--probe")
    if probe_text == "" {
        println("dialogue --probe: missing text after --probe flag")
        exit(2)
    }
    let output_format = _arg_value(argv, "--output-format")
    let inject_states = _arg_value(argv, "--inject-states")

    let session_dir = _session_dir(root)
    let session_log = _session_log_path(root, _time_utc())
    _ensure_session_log(session_log, session_dir, to_string(PHI_STAR_BASELINE), "probe")
    _log_user_turn(session_log, probe_text)

    let parsed = _probe_and_parse(root, probe_text, output_format, inject_states)

    println("── anima dialogue --probe ──")
    println("user > " + probe_text)
    println("substrate > phi=" + _str(parsed["phi_star"])
             + " drift=" + _str(parsed["phi_star_drift_pp"])
             + " top_axis=" + _str(parsed["top_axis"])
             + " dom=" + _str(parsed["dominant_cells"])
             + " delta=" + _str(parsed["hidden_state_delta"]))
    println("axes      : " + _str(parsed["axes_pretty"]))
    println("session_log: " + session_log)

    _log_substrate_turn(session_log, parsed)
    _log_session_end(session_log)
    _emit_session_summary(session_log)
}

fn sub_interactive(argv) {
    let root = _resolve_root()
    if !_mount_ready(root) {
        _emit_stage_1_pending("--interactive")
        return
    }
    let output_format = _arg_value(argv, "--output-format")
    let inject_states = _arg_value(argv, "--inject-states")

    let session_dir = _session_dir(root)
    let session_log = _session_log_path(root, _time_utc())
    _ensure_session_log(session_log, session_dir, to_string(PHI_STAR_BASELINE), "interactive")

    println("── anima dialogue --interactive ──")
    println("session_log : " + session_log)
    println("substrate   : clm-v4 (phi-star baseline " + to_string(PHI_STAR_BASELINE) + ")")
    println("paradigm    : emerge (substrate response = dialogue medium)")
    println("exit        : blank line | /exit | /quit | /q | Ctrl+D | Ctrl+C")
    println("─────────────────────────────────────────")

    let mut running = true
    let mut turn = 0
    while running {
        print("> ")
        let line = readline()
        let trimmed = line.trim()
        if trimmed == "" {
            running = false
        } else if trimmed == "/exit" || trimmed == "/quit" || trimmed == "/q"
               || trimmed == "exit" || trimmed == "quit" {
            running = false
        } else {
            _log_user_turn(session_log, trimmed)
            let parsed = _probe_and_parse(root, trimmed, output_format, inject_states)
            turn = turn + 1
            println("[turn " + to_string(turn) + "] phi=" + _str(parsed["phi_star"])
                     + " drift=" + _str(parsed["phi_star_drift_pp"])
                     + " top_axis=" + _str(parsed["top_axis"])
                     + " dom=" + _str(parsed["dominant_cells"])
                     + " delta=" + _str(parsed["hidden_state_delta"]))
            println("            axes: " + _str(parsed["axes_pretty"]))
            _log_substrate_turn(session_log, parsed)
        }
    }
    _log_session_end(session_log)
    _emit_session_summary(session_log)
}

// ─── L2 multi-agent forwarders (β-1 channel API dependent) ───────────────
//
// L2 design + skeleton land: cycle 2026-05-08. duo body lives at
// tool/anima_cli/chat/duo/duo.hexa (recursive module pattern). Phase A
// emits honest β-1 pending notice; Phase B activates after hexa stdlib
// proc + channel modules land.
//
// Cross-link:
//   docs/anima_chat_autonomous_speech_roadmap_2026_05_08.md  L2 layer
//   docs/anima_dialogue_coherence_metric_2026_05_08.md        coherence spec
//   tool/anima_cli/chat/duo/duo.hexa                          skeleton body
//   .roadmap.cli  cli.dialogue_2026_05_08
//                 cli.dialogue.duo_design_2026_05_08
//                 cli.dialogue.coherence_metric_2026_05_08

fn _duo_module_path() -> string {
    return _resolve_root() + "/tool/anima_cli/chat/duo/duo.hexa"
}

fn _forward_to_duo(argv) {
    let path = _duo_module_path()
    if !_fexists(path) {
        println("anima dialogue --duo: chat/duo module missing: " + path)
        exit(2)
    }
    // Use hexa.real (mac-local interpreter) directly — bin/hexa wrapper routes
    // `run` to remote resource host (ubu-1) which mangles --flags into
    // run_remote.py args. Mirrors chat.hexa _hexa() pattern.
    let real = "/Users/ghost/.hx/packages/hexa/hexa.real"
    let mut cmd = real + " run " + path
    let mut i = 0
    while i < len(argv) {
        cmd = cmd + " " + _sh_q(_str(argv[i]))
        i = i + 1
    }
    let out = _str(exec(cmd))
    print(out)
}

fn sub_duo(argv) { _forward_to_duo(argv) }

fn sub_council(argv) { _forward_to_duo(argv) }

// ─── entry ───────────────────────────────────────────────────────────────

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--selftest") { sub_selftest(); return }
    if _arg_present(argv, "--help") || len(argv) == 0 { sub_help(); return }
    if _arg_present(argv, "--duo") { sub_duo(argv); return }
    if _arg_present(argv, "--council") { sub_council(argv); return }
    if _arg_present(argv, "--probe") { sub_probe(argv); return }
    if _arg_present(argv, "--interactive") { sub_interactive(argv); return }
    println("dialogue: unknown invocation")
    sub_help()
    exit(2)
}
