// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/dialogue.hexa — anima CLI `dialogue` topic
//
//  PURPOSE
//    Substrate-coupled dialogue with CLM v4 mount layer.
//    Emerge paradigm — NOT chat. Substrate response (phi-star + axis activation
//    + dominant cells + hidden-state delta) is the dialogue medium.
//
//    spec: docs/anima_core_clm_v4_mount_emerge_paradigm_2026_05_05.md §5
//    Stage 2 prep dispatcher → Phase 2 LANDED 2026-05-06: native --interactive
//    REPL (readline + per-turn JSONL emit + session_summary), --probe with
//    auto-session-log, --selftest 5-turn synthetic conversation extension.
//
//  INVOCATION
//    anima dialogue                                       topic-level help
//    anima dialogue --probe "text"                        one-shot probe (logged)
//    anima dialogue --interactive                         native REPL session
//    anima dialogue --selftest                            5-turn synthetic test
//    anima dialogue --substrate clm-v4 ...                substrate selector (default)
//    anima dialogue --inject-states PATH ...              consciousness fixture
//    anima dialogue --output-format compact|full|json     (forwarded to mount)
//    anima dialogue --help
//
//  L2 MULTI-AGENT (added 2026-05-08, β-1 channel API dependent — see
//                  docs/anima_chat_autonomous_speech_roadmap_2026_05_08.md L2)
//    anima dialogue --duo <model_a> <model_b> [--turns N] [--topic-seed "..."]
//                                                        N=2 CLM↔CLM autonomous
//                                                        dialogue (skeleton —
//                                                        β-1 stdlib proc+channel
//                                                        pending; honest emit)
//    anima dialogue --council N=<n> --models "<m1>,...,<mn>" [--topic-seed]
//                                                        N≥3 multi-agent (L3 stub)
//
//  DESIGN
//    raw#9   hexa-only (no .py in this layer; mount.hexa does shim emit)
//    raw#10  honest C3 ≥5 (see CAVEATS below)
//    raw#11  snake_case
//    raw#15  no-hardcode (paths via _resolve_root)
// ALM forced learning DEPRECATED — backend = clm_v4_mount only
//
//  SESSION LOG SCHEMA  (state/anima_core_dialogues/<YYYY-MM-DD>/<HH-MM-SS>.jsonl)
//    {"schema":"anima.dialogue.v1","kind":"session_start","ts_utc":...,
//     "session_log":...,"phi_star_baseline":41.86,"substrate":"clm-v4",
//     "mode":"interactive|probe|selftest"}
//    {"schema":"anima.dialogue.v1","kind":"user_turn","ts_utc":...,"user_input":...}
//    {"schema":"anima.dialogue.v1","kind":"substrate_turn","ts_utc":...,
//     "phi_star":41.83,"phi_star_drift_pp":-0.03,
//     "axis_activation":{"identity":0.78,"agency":0.42,"phenomenal":0.91,
//                        "temporal":0.31,"social":0.56},
//     "dominant_cells":[3,5,7],"hidden_state_delta_l2":2.47}
//    {"schema":"anima.dialogue.v1","kind":"session_end","ts_utc":...}
//    {"schema":"anima.dialogue.v1","kind":"session_summary","ts_utc":...,
//     "n_turns":12,"phi_star_mean":41.84,"phi_star_drift_min_pp":-0.07,
//     "phi_star_drift_max_pp":0.04}
//
//  EXIT CONDITIONS (REPL)
//    blank line              → session_end + summary, exit 0
//    /exit | /quit | /q      → session_end + summary, exit 0
//    Ctrl+D (EOF)            → session_end + summary, exit 0
//    Ctrl+C (SIGINT)         → readline() raises; outer catches → summary, exit 0
//
//  CAVEATS (honest C3 ≥5; raw#10)
//    C1 — substrate-response-as-metric is anima-internal heuristic; no external
//         validation that phi-star + axis + cells form a coherent dialogue medium.
//    C2 — phi_star baseline 41.86 (paradigm v11 G3) hard-coded as drift reference;
//         alternate substrates (paradigm_d_50k, etc.) carry their own baseline
//         emitted via __ANIMA_SUBSTRATE_IDENTITY__ — drift_pp is computed against
//         the canonical 41.86 here for cross-substrate stability comparison.
//    C3 — session-log JSONL schema is anima.dialogue.v1; subject to revision if
//         downstream analyzers (dialogue_session_analyzer.hexa) diverge.
//    C4 — REPL parsing is line-based regex on mount stdout; if mount emit format
//         changes (phi_star: ... / axis_activation: ... / dominant_cells: ... /
//         hidden_state_delta: ...), this parser must update.
//    C5 — chat-capability is NOT promised. spec §3 explicit: substrate-coupled
// dialogue, not token-emit chat. ALM forced learning closed.
//    C6 — hidden_state_delta_l2 from mount is per-helper-invocation prior_hidden
//         (not provided in this REPL); for now 0.0 surfaces — TODO wire prior
//         hidden snapshot persistence between mount calls.
//    C7 — Ctrl+C handling depends on hexa runtime swallowing SIGINT during
//         readline(); if it propagates as exception we catch via empty-string
//         return path; if it terminates the process, no summary is emitted.
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    if t == "int" || t == "float" || t == "number" { return str(x) }
    return ""
}

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _dexists(p: string) -> bool {
    return _str(exec("test -d " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _xexists(p: string) -> bool {
    return _str(exec("test -x " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _ts_iso() -> string {
    let rep = _str(env("HEXA_REPRODUCIBLE"))
    if rep == "1" { return "REDACTED" }
    return _str(exec("date -u +%FT%TZ")).trim()
}

fn _date_utc() -> string {
    return _str(exec("date -u +%Y-%m-%d")).trim()
}

fn _time_utc() -> string {
    return _str(exec("date -u +%H-%M-%S")).trim()
}

fn _hexa() -> string {
    let h = _str(env("HEXA_BIN"))
    if h != "" { return h }
    return "/Users/ghost/.hx/bin/hexa"
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _arg_value(argv, key: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return ""
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        // Strip hexa-cache fragments AND interpreter / our-script path so that
        // forwarders (e.g. _forward_to_duo) don't propagate them as user args.
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/dialogue.hexa")
                || s.ends_with("dialogue.hexa")
        if !skip {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

fn _sh_q(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    out = out + "'"
    return out
}

// JSON-string escape for user text (\, ", \n, \r, \t)
fn _json_escape(s: string) -> string {
    let mut out = ""
    let mut i = 0
    while i < s.len() {
        let c = s.substring(i, i + 1)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// ─── readiness probes ────────────────────────────────────────────────────

let PHI_STAR_BASELINE = 41.86

fn _mount_path(root: string) -> string {
    return root + "/anima-core/runtime/clm_v4_mount.hexa"
}

fn _mount_ready(root: string) -> bool {
    return _fexists(_mount_path(root))
}

fn _session_dir(root: string) -> string {
    return root + "/state/anima_core_dialogues/" + _date_utc()
}

fn _session_log_path(root: string, ts: string) -> string {
    return _session_dir(root) + "/" + ts + ".jsonl"
}

