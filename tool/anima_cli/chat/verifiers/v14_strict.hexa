// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/verifiers/v14_strict.hexa — V14 anti-Goodhart verifier
//                                                   (own 41 axis-5 / axis-N+1)
//
//  PURPOSE
//    V14 strict in-metric (random_init mirror anti-Goodhart) skeleton.
//    Wraps random_init PPR comparison vs trained model PPR; is_violated when
//    random PPR > trained PPR (BG-KM V14 violation pattern, project_v14_
//    violation_arch_tile_bug.md SSOT).
//
//  CONTRACT
//    fn v14_strict(model: string, prompt: string) -> dict {is_violated, delta}
//      delta = trained_PPR - random_PPR  (positive = healthy; negative = violated)
//      is_violated = delta < 0  (random outperforms trained)
//
//  COMPLIANCE
//    own 14 V14 — V14 reproducibility 결정성 (verifier 자체)
//    own 16 — model load 절대 금지 (skeleton phase)
//    own 22 — honest emit (NOT_MEASURED 명시 in skeleton)
//    own 34 mandate-1 — wrapping 0
//    own 41 axis-N+1 — axis-5 verifier registry entry 4
//
//  CROSS-REFERENCE
//    chat/verifiers/_registry.hexa#v14_strict   registry SSOT
//    project_v14_violation_arch_tile_bug.md     V14 violation root cause
//    clm_v5_mount.hexa (별도 step)              실 측정 mirror entry
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _arg_present(argv, key: string) -> bool {
    let mut i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn verifier_describe() -> string {
    return "v14_strict — V14 anti-Goodhart in-metric (random_init mirror; delta = trained_PPR - random_PPR; own 16: skeleton only, 실 측정 별도 step)"
}

// v14_strict — skeleton signature; own 16 carry — no model load.
// Returns parallel arrays: [["is_violated","delta"], ["NOT_MEASURED",...]].
fn v14_strict(model: string, prompt: string) -> array {
    let keys = ["is_violated", "delta"]
    let vals = ["NOT_MEASURED_T_3_skeleton", "NOT_MEASURED_T_3_skeleton"]
    return [keys, vals]
}

fn verifier_smoke(repo: string, argv) -> int {
    let r = v14_strict("(skeleton)", "(skeleton)")
    if len(r) != 2 { return 2 }
    let keys = r[0]
    let vals = r[1]
    if len(keys) != 2 || len(vals) != 2 { return 3 }
    println("[verifier:v14_strict] smoke PASS — {is_violated, delta} skeleton signature OK (own 16 model load 0)")
    return 0
}

fn main() {
    let argv = args()
    if _arg_present(argv, "--describe") {
        println(verifier_describe())
        return
    }
    if _arg_present(argv, "--selftest") || _arg_present(argv, "--smoke") {
        let rc = verifier_smoke("", argv)
        if rc != 0 {
            println("FAIL verifier v14_strict smoke (rc=" + to_string(rc) + ")")
            exit(rc)
        }
        return
    }
    println(verifier_describe())
}
