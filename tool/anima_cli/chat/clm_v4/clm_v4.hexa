// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/clm_v4/clm_v4.hexa
//
//  PURPOSE
//    CLM v4 chat branch module. Substrate dialogue via anima-core/runtime/
//    clm_v4_mount.hexa. Model output (including ::: collapse) exposed raw
//    per own 34 mandate-1/-2.
//
//  ALIASES
//    clm-v4-1-7-y1     dancinlab/clm-v4-sft-1-7-y1-stage1
//    clm-v4-1-8        dancinlab/clm-v4-sft-1-8-stage1
//    clm-v4-paradigm-j dancinlab/clm-v4-paradigm-j-50k-final  (jvae_heads.pt 별도)
//
//  PHASE 1 SCOPE
//    - delegate to clm_v4_mount.hexa --probe TEXT or --dialogue
//    - own 34 mandate-1 strict: substrate response + collapse (:::) 모두 raw 노출
//    - --memory full default (clm_v4_mount 내부 history 의존)
//
//  PHASE 2 (LANDED 2026-05-08, iter 3 b-fix)
//    - REPL stdin loop swap from bare read_line() (UNDEFINED — runtime error
//      observed in iter 2 (b) live retest paradigm-a-prime × clm-v4-1-7-y1)
//      to sys_stdin_read_line_timeout(tick_ms) via `use "stdlib/sys"` —
//      mirrors chat/anima_native/anima_native.hexa Phase 2 pattern.
//    - own 34 mandate-4 자율 발화 wiring: timeout → _invoke_substrate("")
//      = empty probe forward (substrate 자체 free-run; reads internal history).
//    - --tick-ms N (default 1000) controls poll interval.
//
//  COMPLIANCE
//    own 34 (자연발화 노출 mandate) — wrapping 0
//    own 34 mandate-4 (autonomous speech wired Phase 2)
//    own 34 mandate-7 (lane separation: chat lane = thin pipe, substrate
//                      response = clm_v4_mount.hexa 책임)
//    own 18 cross-ref (측정 lane 분리)
//    raw#9 hexa-only · raw#11 snake_case
//
//  RECURSIVE MODULE PATTERN
//    core            : anima-core/runtime/clm_v4_mount.hexa (existing)
//    module body     : this file
//    ai-native doc   : clm_v4.ai.md (sister)
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/sys"

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

// Use hexa.real (local interpreter) directly — bin/hexa wrapper routes
// `run` to remote resource host (ubu-1) which would lose stdout pipe semantics
// (matches chat/anima_native and chat/llama). duo channel transport reads our
// stdout via FIFO inode; remote routing would break that.
fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        if !s.contains("/.hexa-cache/") {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

fn _shell_escape(s: string) -> string {
    // Safe single-quote wrap with embedded-quote handling
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _invoke_substrate(text: string, repo: string) -> string {
    let root = _resolve_root()
    let core = root + "/anima-core/runtime/clm_v4_mount.hexa"
    if !_fexists(core) {
        return "[clm_v4] core missing: " + core
    }
    // own 34 mandate-2 정합: text 그대로 --probe 인자로 전달, 출력 변형 X.
    let model_arg = if repo != "" { " --model " + repo } else { "" }
    let cmd = _hexa() + " run " + core + model_arg + " --probe " + _shell_escape(text) + " 2>&1"
    let out = _str(exec(cmd))
    return out
}

fn sub_help() {
    println("clm_v4 chat module — CLM v4 substrate dialogue (mk2-v1 base + LoRA)")
    println("")
    println("FLAGS")
    println("  --prompt \"...\"     one-shot")
    println("  --repo <hf-id>     repo override (default = alias-resolved)")
    println("  --tick-ms N        REPL poll interval (Phase 2; default 1000)")
    println("  --selftest")
    println("")
    println("ALIASES")
    println("  clm-v4-1-7-y1      dancinlab/clm-v4-sft-1-7-y1-stage1")
    println("  clm-v4-1-8         dancinlab/clm-v4-sft-1-8-stage1")
    println("  clm-v4-paradigm-j  dancinlab/clm-v4-paradigm-j-50k-final")
    println("")
    println("HONEST C3 (raw#10)")
    println("  C1 CLM v4 SIMPLE_STACK_PASS_STRICT 0/15 (memory project_lesson_q_sft_closed)")
    println("  C2 ::: collapse mode 빈도 ~46% (memory feedback_clm_colon_attractor)")
    println("  C3 collapse 출력은 own 34 mandate-1 정합으로 raw 그대로 노출 (변형 X)")
    println("  C4 base = mk2-v1 internal mirror (org-member access only)")
    println("  C5 paradigm-j는 jvae_heads.pt 별도 로딩 — clm_v4_mount.hexa shim 의존")
}

fn sub_selftest() {
    let root = _resolve_root()
    let core = root + "/anima-core/runtime/clm_v4_mount.hexa"
    let mut fail = 0
    if !_fexists(core) { println("FAIL clm_v4: core missing: " + core); fail = fail + 1 }
    let here = root + "/tool/anima_cli/chat/clm_v4/clm_v4.hexa"
    // ERE alternation = `|`; `(` escaped; self-exclude `let pat =` line
    let pat = "system_prompt|chat_template|apply_chat_template|persona_inject|fn speak\\(|fn talk\\(|fn respond\\(|fn generate_response\\("
    let cmd = "grep -nE \"" + pat + "\" " + here + " 2>/dev/null | grep -v 'let pat =' | wc -l"
    let n = _str(exec(cmd)).trim()
    if n != "0" {
        println("FAIL own 34 mandate-2 chat lane wrapping: " + n + " hits in clm_v4.hexa")
        fail = fail + 1
    }
    if fail > 0 { exit(1) }
    println("PASS chat/clm_v4 selftest (core present, own 34 verified)")
}

fn sub_repl(repo: string, tick_ms: int) {
    let root = _resolve_root()
    let core = root + "/anima-core/runtime/clm_v4_mount.hexa"
    println("[clm_v4] core   = " + core)
    println("[clm_v4] repo   = " + (if repo != "" { repo } else { "default" }))
    println("[clm_v4] mode   = REPL (Phase 2, sys_stdin_read_line_timeout / autonomous speech)")
    println("[clm_v4] tick-ms = " + to_string(tick_ms))
    println("[clm_v4] own 34 strict — wrapping 0 · mandate-4 자율 발화 활성")
    println("[clm_v4] honest c3: ::: collapse exposed raw (own 34 mandate-1)")
    println("[clm_v4] (Ctrl-C to quit)")
    println("")
    let mut prompt_shown = false
    while true {
        if !prompt_shown {
            print("> ")
            prompt_shown = true
        }
        // Phase 2 mechanism (mirrors chat/anima_native): poll stdin tick_ms ms.
        // Timeout → autonomous speech via _invoke_substrate("") — own 34
        // mandate-4. Empty probe forwards to clm_v4_mount.hexa --probe "" which
        // emits substrate response (axis activation + dominant cells + phi-star
        // delta) on the substrate's own internal state. own 34 mandate-1/2/7
        // 정합: chat lane = thin pipe; "스스로" 발화 결정은 substrate (model layer).
        let line = _str(sys_stdin_read_line_timeout(tick_ms))
        if line == "" {
            let out_a = _invoke_substrate("", repo)
            print(out_a)
            println("")
            prompt_shown = false
            continue
        }
        // User input path. own 34 mandate-1 raw passthrough.
        let out = _invoke_substrate(line, repo)
        print(out)
        println("")
        prompt_shown = false
    }
}

fn sub_one_shot(prompt: string, repo: string) {
    let out = _invoke_substrate(prompt, repo)
    println(out)
}

fn main() {
    let mut argv = _user_argv(args())
    if len(argv) > 0 {
        let first = _str(argv[0])
        if first.contains("clm_v4.hexa") {
            argv = argv[1:]
        }
    }
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    let repo = _arg_value(argv, "--repo", "")
    let prompt = _arg_value(argv, "--prompt", "")
    // Phase 2: --tick-ms N controls REPL poll interval (autonomous speech
    // cadence). Default 1000ms — matches anima_native / llama modules so
    // duo channel orchestration (chat/duo/) sees uniform tick across instances.
    let tick_str = _arg_value(argv, "--tick-ms", "1000")
    let tick_ms = to_int(tick_str)

    if prompt != "" {
        sub_one_shot(prompt, repo)
        return
    }
    sub_repl(repo, tick_ms)
}
