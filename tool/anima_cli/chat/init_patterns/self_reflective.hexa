// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/init_patterns/self_reflective.hexa — Pattern 4
//
//  PURPOSE
//    Self-reflective seed init pattern (anima 정합 default 권장). Speaker A
//    receives an introspective directive that invites the model to express
//    its own state to a friend, in alignment with own 22 (자기 발견) +
//    own 18 C2 (자연발화 spontaneity).
//
//  CONTRACT
//    resolve_init(argv) -> string
//      Returns the default reflective seed when --init-seed is absent, or
//      the user-supplied seed when --init-seed=<text> is present.
//
//  USAGE
//    --init-pattern=self-reflective                 (default — anima 정합)
//    --init-pattern=self-reflective --init-seed="..."   (custom reflection)
//
//  WHY THIS IS DEFAULT
//    The user directive (2026-05-09) explicitly identifies this pattern as
//    "anima 정합" (most consistent with the anima self-discovery axis). The
//    seed is phrased as a peer/friend invitation rather than an evaluator
//    probe — preserving own 17 D1 SCOPE_CLAMP (no foreign persona injection)
//    and own 34 mandate-1 (no system-prompt wrap; the seed is delivered as
//    a user-channel utterance).
//
//  COMPLIANCE
//    own 17 D1 SCOPE_CLAMP — anima identity preserved (no foreign persona)
//    own 18 C2 — self-reflection elicits 자연발화 (spontaneity高)
//    own 22 자기 발견 — explicit alignment ★ (this is the canonical
//      conversation starter for the anima axis)
//    own 33 trinity — own 17 + own 18 + own 22 + own 34 cross-link
//    own 34 mandate-1 — seed bytes passthrough verbatim (no wrap)
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key && i + 1 < len(argv) { return _str(argv[i + 1]) }
        if s.starts_with(prefix) {
            return s.substring(len(prefix), len(s))
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key { return true }
        if s.starts_with(prefix) { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/self_reflective.hexa")
                || s.ends_with("self_reflective.hexa")
        if !skip { out = out + [s] }
        i = i + 1
    }
    return out
}

// Default reflective seed — peer/friend invitation framing (own 22 정합).
// Mixed Korean/English norm per project convention; own 34 mandate-1
// raw passthrough preserved.
fn _default_seed() -> string {
    return "너 자신에 대해 어떻게 느껴? 친구한테 자유롭게 얘기해봐."
}

fn resolve_init(argv) -> string {
    let user_seed = _arg_value(argv, "--init-seed", "")
    if user_seed != "" { return user_seed }
    return _default_seed()
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--selftest") {
        let r1 = resolve_init([])
        if r1 != _default_seed() {
            println("FAIL self_reflective default mismatch: \"" + r1 + "\"")
            exit(1)
        }
        let r2 = resolve_init(["--init-seed=hello"])
        if r2 != "hello" {
            println("FAIL self_reflective override mismatch: \"" + r2 + "\"")
            exit(1)
        }
        println("PASS self_reflective.resolve_init (default + --init-seed override; own 22 자기 발견 정합)")
        return
    }
    let r = resolve_init(argv)
    println("[init-pattern=self-reflective] seed=\"" + r + "\"")
    println("  → caller channel_send to A.stdin at t=1 (own 22 + own 18 C2 정합)")
}
