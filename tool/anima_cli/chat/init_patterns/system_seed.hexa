// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/init_patterns/system_seed.hexa — Pattern 2
//
//  PURPOSE
//    System-prompt seed init pattern. Speaker A receives a default friendly
//    directive ("너희 둘은 친구. 자유롭게 대화 시작.") OR a user-supplied
//    seed via --init-seed=<text>. The seed is sent into A.stdin at t=1 as
//    a USER UTTERANCE (NOT as a system prompt wrap of model output) — own
//    34 mandate-1 raw passthrough preserved.
//
//  CONTRACT
//    resolve_init(argv) -> string
//      Returns the default seed when --init-seed is absent, or the explicit
//      user seed when --init-seed=<text> is present.  Empty value via
//      --init-seed= "" causes fallback to autonomous (caller treats empty
//      string as no-seed; honest C3 emit).
//
//  USAGE
//    --init-pattern=system-seed
//    --init-pattern=system-seed --init-seed="<your seed>"
//
//  COMPLIANCE
// D1 — seed is delivered as user-channel content (NOT a system
//      prompt wrap); D1 within_strict preserved for anima 정합 models.
// C2 — coherence measurement vs seed expected高 (controlled init)
// — seed text logged in benchmark output for reproducibility
// mandate-1 — seed bytes passthrough verbatim (no transform)
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key && i + 1 < len(argv) { return _str(argv[i + 1]) }
        if s.starts_with(prefix) {
            return s.substring(len(prefix), len(s))
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key { return true }
        if s.starts_with(prefix) { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/system_seed.hexa")
                || s.ends_with("system_seed.hexa")
        if !skip { out = out + [s] }
        i = i + 1
    }
    return out
}

// Default seed — friendly directive (Korean; mixed-language norm).
// mandate-1 mixed Korean/English chat is the project norm; English
// alternative also accepted by anima_native + clm-v4 + llama lanes.
fn _default_seed() -> string {
    return "너희 둘은 친구. 자유롭게 대화 시작."
}

// Public contract — caller invokes this to get the t=1 seed string.
fn resolve_init(argv) -> string {
    let user_seed = _arg_value(argv, "--init-seed", "")
    if user_seed != "" { return user_seed }
    return _default_seed()
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--selftest") {
        let r1 = resolve_init([])
        if r1 != _default_seed() {
            println("FAIL system_seed default mismatch: \"" + r1 + "\"")
            exit(1)
        }
        let r2 = resolve_init(["--init-seed=hello"])
        if r2 != "hello" {
            println("FAIL system_seed override mismatch: \"" + r2 + "\"")
            exit(1)
        }
        println("PASS system_seed.resolve_init (default + --init-seed override)")
        return
    }
    let r = resolve_init(argv)
    println("[init-pattern=system-seed] seed=\"" + r + "\"")
    println("  → caller channel_send to A.stdin at t=1")
}
