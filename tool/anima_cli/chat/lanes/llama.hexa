// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/lanes/llama.hexa — Path 1 Llama GGUF lane
//
//  PURPOSE
//    Natural language generate via libllama FFI (paradigm-a-prime live;
//    Llama-family GGUF). Thin wrapper that delegates to existing
// chat/llama/llama.hexa module — raw output preserved.
//
//  USER DIRECTIVE (2026-05-09)
//    "Path 1 (Llama lane): paradigm-a-prime GGUF (Llama-3B base + chat-template).
// 자연어 generate ✓ but D1 OUTSIDE (personal-review-only, public X)"
//
//  COMPLIANCE
// V14 carry — llama lane measurement subject to V14 if
//      verdict-grade
// D1 SCOPE_CLAMP — paradigm-a-prime = ambiguous_research /
//      Llama base = OUTSIDE strict; lane emits SUBSTRATE_RESEARCH label
//      automatically in bench mode
// chat-cap C2 — natural utterance scored (spontaneity / coherence /
// persona) — measurement separate from chat lane (/ split)
// mandatory report — bench mode emits structured marker
// trinity ✓
// mandate-1/2 — wrapping 0; chat/llama/llama.hexa preserves raw bytes
// mandate-9 — public promote 영구 차단 (Llama base D1 OUTSIDE);
//      bench output flagged SUBSTRATE_RESEARCH label strict
// 매단계 — bench marker
// yaml↔md
//
//  PHASE
//    LANDED — leverages chat/llama/llama.hexa (Phase 3c live)
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/llama.hexa")
                || s.ends_with("llama.hexa")
        if !skip { out = out + [s] }
        i = i + 1
    }
    return out
}

fn _shell_escape(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _delegate_llama_module(prompt: string, repo: string, max_tokens: int, temp: float) -> string {
    let root = _resolve_root()
    let mod_path = root + "/tool/anima_cli/chat/llama/llama.hexa"
    if !_fexists(mod_path) {
        return "[lane=llama] module not found: " + mod_path
    }
    let repo_arg = if repo != "" { " --repo " + repo } else { "" }
    let cmd = _hexa() + " run " + mod_path + repo_arg
        + " --prompt " + _shell_escape(prompt)
        + " --max-tokens " + to_string(max_tokens)
        + " --temp " + to_string(temp)
        + " 2>&1"
    return _str(exec(cmd))
}

fn sub_selftest() {
    let root = _resolve_root()
    let mod_path = root + "/tool/anima_cli/chat/llama/llama.hexa"
    let dylib = root + "/build/libhxllama.dylib"
    if !_fexists(mod_path) {
        println("FAIL llama lane: chat/llama module missing: " + mod_path)
        exit(1)
    }
    if !_fexists(dylib) {
        println("WARN llama lane: libhxllama.dylib missing — invoke will fail at runtime")
    }
    println("PASS chat/lanes/llama selftest (delegates to chat/llama/llama.hexa)")
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    // D1 SCOPE_CLAMP carry — default repo = paradigm-a-prime (substrate
    // research lane); other Llama-family aliases require GGUF cache.
    let default_repo = "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1"
    let repo = _arg_value(argv, "--repo", default_repo)
    let prompt = _arg_value(argv, "--prompt", "")
    let max_tok = to_int(_arg_value(argv, "--max-tokens", "64"))
    let temp = to_float(_arg_value(argv, "--temp", "0.7"))
    let bench_mode = _arg_value(argv, "--bench-mode", "0") == "1"

    if prompt == "" {
        println("[lane=llama] no --prompt provided; lane invoke requires prompt")
        println("             (REPL mode delegated to chat/llama module)")
        exit(2)
    }

    if bench_mode {
        // mandate-9 carry — public promote 영구 차단 라벨
        println("[BENCH lane=llama label=SUBSTRATE_RESEARCH d1=ambiguous_research repo=" + repo + "]")
    }
    let out = _delegate_llama_module(prompt, repo, max_tok, temp)
    print(out)
    println("")
    if bench_mode {
        println("[BENCH_END lane=llama]")
    }
}
