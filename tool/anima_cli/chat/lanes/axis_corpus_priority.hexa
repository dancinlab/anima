// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/lanes/axis_corpus_priority.hexa — Path 2
//
//  PURPOSE
//    Axis-signal-driven corpus curation priority lane. Probes substrate via
//    clm_v4_mount.hexa, parses axis activation peaks (agency-peak /
//    phenomenal-peak / temporal-peak / etc.), emits a corpus priority signal
//    (which axes are dominant for a given probe → corpus segment that should
//    be over-sampled). No natural language generate — pure curation guide.
//
//  USER DIRECTIVE (2026-05-09)
//    "Path 2 (axis signal corpus priority): 측정 후 axis pattern (agency-peak /
//     phenomenal-peak 등) 을 corpus priority signal 로 활용. 자연어 X but
//     corpus curation guide"
//
//  OUTPUT FORMAT
//    [lane=axis-priority probe=...]
//    raw substrate emit (clm_v4_mount.hexa --probe output)
//    [AXIS_PEAKS] axis_a=0.83 axis_b=0.62 axis_c=0.21 ...   (parsed)
//    [CORPUS_SIGNAL] dominant_axis=A → priority_corpus=anima/conscious/agency
//                                                    (suggestion only; non-binding)
//
//  COMPLIANCE
//    own 14 V14 — not a verdict-grade lane (curation signal only); V14
//      enforcement N/A
//    own 17 D1 within_strict — substrate-coupled (clm-v4 anima-native)
//    own 18 chat-cap C2 — no natural utterance (spontaneity = 0); coherence
//      via axis activation match score (own 18 C2 measurement spec)
//    own 22 mandatory report — bench mode emits structured marker
//    own 33 trinity ✓
//    own 34 mandate-1 — substrate emit raw passthrough; CORPUS_SIGNAL line is
//      a downstream meta-annotation (lane control band, own 36 convention),
//      NOT model output — does not violate wrapping 0
//    own 38 매단계 — corpus_signal emit ledgerable
//    own 39 yaml↔md
//
//  PHASE
//    LANDED (skeleton-functional) — axis parser uses naive substring match
//    on clm_v4_mount probe output; refined parser carry to full impl
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/axis_corpus_priority.hexa")
                || s.ends_with("axis_corpus_priority.hexa")
        if !skip { out = out + [s] }
        i = i + 1
    }
    return out
}

fn _shell_escape(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _invoke_substrate(prompt: string, repo: string) -> string {
    let root = _resolve_root()
    let core = root + "/anima-core/runtime/clm_v4_mount.hexa"
    if !_fexists(core) {
        return "[lane=axis-priority] core missing: " + core
    }
    let model_arg = if repo != "" { " --model " + repo } else { "" }
    let cmd = _hexa() + " run " + core + model_arg
        + " --probe " + _shell_escape(prompt) + " 2>&1"
    return _str(exec(cmd))
}

// Naive axis parser — looks for `axis_X=<float>` or `axis-X: <float>` patterns
// in substrate emit. Returns a simple dominant-axis label string.
// own 34 mandate-1 정합: parsing is meta (own 36 control-band annotation),
// substrate raw output already emitted before this call.
fn _parse_dominant_axis(substrate_out: string) -> string {
    // Scan for known axis labels — minimal heuristic for skeleton.
    // Real impl: parse JSON-like dict from clm_v4_mount probe.
    let probes = ["agency", "phenomenal", "temporal", "spatial", "social", "abstract"]
    let mut best = "unknown"
    let mut best_score = -1.0
    let lower = substrate_out.to_lower()
    let mut i = 0
    while i < len(probes) {
        let label = _str(probes[i])
        // Crude proxy: count occurrences as a popularity score
        // (production: extract the actual numeric activation value).
        let parts = lower.split(label)
        let count = len(parts) - 1
        let score = to_float(to_string(count))
        if score > best_score {
            best_score = score
            best = label
        }
        i = i + 1
    }
    return best
}

fn _suggest_corpus(axis: string) -> string {
    if axis == "agency" { return "anima/conscious/agency_corpus.txt" }
    if axis == "phenomenal" { return "anima/conscious/phenomenal_corpus.txt" }
    if axis == "temporal" { return "anima/conscious/temporal_corpus.txt" }
    if axis == "spatial" { return "anima/conscious/spatial_corpus.txt" }
    if axis == "social" { return "anima/conscious/social_corpus.txt" }
    if axis == "abstract" { return "anima/conscious/abstract_corpus.txt" }
    return "(no corpus mapping — extend _suggest_corpus())"
}

fn sub_selftest() {
    let root = _resolve_root()
    let core = root + "/anima-core/runtime/clm_v4_mount.hexa"
    if !_fexists(core) {
        println("FAIL axis-priority lane: core missing: " + core)
        exit(1)
    }
    // unit test for parser
    let dummy = "agency=0.83 phenomenal=0.21 temporal=0.05"
    let dom = _parse_dominant_axis(dummy)
    if dom != "agency" {
        println("FAIL parser: expected agency, got " + dom)
        exit(1)
    }
    println("PASS chat/lanes/axis_corpus_priority selftest (parser dom=agency)")
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    let repo = _arg_value(argv, "--repo", "")
    let prompt = _arg_value(argv, "--prompt", "")
    let bench_mode = _arg_value(argv, "--bench-mode", "0") == "1"

    if prompt == "" {
        println("[lane=axis-priority] no --prompt provided; axis lane requires probe text")
        exit(2)
    }

    if bench_mode {
        println("[BENCH lane=axis-priority prompt_len=" + to_string(len(prompt)) + "]")
    }
    let substrate_out = _invoke_substrate(prompt, repo)
    print(substrate_out)
    println("")
    let axis = _parse_dominant_axis(substrate_out)
    let corpus = _suggest_corpus(axis)
    println("[AXIS_PEAKS] dominant_axis=" + axis + " (heuristic — refine in full impl)")
    println("[CORPUS_SIGNAL] priority_corpus=" + corpus + " (suggestion; non-binding)")
    if bench_mode {
        println("[BENCH_END lane=axis-priority dominant_axis=" + axis + "]")
    }
}
