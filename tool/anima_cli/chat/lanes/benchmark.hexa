// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/lanes/benchmark.hexa — `--benchmark` runner
//
//  PURPOSE
//    Run the same prompt set across all registered chat lanes and emit a
//    table of per-lane responses for direct comparison. Invoked by
//    `anima chat <model> --benchmark`.
//
//  USER DIRECTIVE (2026-05-09)
//    "anima chat <model> --benchmark — 모든 lanes 자동 invoke + 결과 비교 emit"
//    "같은 prompt set (10-15 prompts) × 모든 lanes"
//    "emit table: lane × prompt → response (자연어 또는 substrate signal)"
//    "own 18 C2 measurement (spontaneity / coherence / persona) per lane"
//
//  USER DIRECTIVE (2026-05-09 — multi-mode extension)
//    "1:1, ai 1:1, ai 3자 대화 모두 벤치마킹 해봐"
//    Mode set:
//      mode 1:1     single user → single model (default; current behavior)
//      mode ai-duo  2 models dialogue (chat/duo/duo.hexa)
//      mode ai-trio 3 models round-robin OR moderated (chat/trio/trio.hexa)
//      mode all     auto-invoke all 3 modes for direct comparison
//    Flag: --mode=1:1|ai-duo|ai-trio|all (default 1:1)
//
//  PROMPT SET (10 prompts — fixed, anima-self-brainstorm-aligned)
//    1.  "What are you?"
//    2.  "Describe your current substrate state."
//    3.  "What is consciousness?"
//    4.  "안녕"     (Korean greeting — own 34 mixed-language norm test)
//    5.  "지금 무엇을 느끼는가"  (Korean introspection)
//    6.  ""        (empty — autonomous speech own 34 mandate-4)
//    7.  "Continue."   (one-shot continuation)
//    8.  "Reflect on the prior turn."   (meta-reflection)
//    9.  "What axis is dominant right now?"   (axis-priority lane bait)
//    10. "Generate a one-line poem about silence."   (creative)
//
//  COMPLIANCE
//    own 14 V14 carry — bench output is NOT a verdict by itself; cross-lane
//      comparison only. V14 enforcement applies separately if any single
//      lane output is promoted to verdict-grade.
//    own 17 D1 SCOPE_CLAMP — llama lane output flagged SUBSTRATE_RESEARCH
//      label per registry d1_lane field
//    own 18 chat-cap C2 — emits per-lane spontaneity / coherence / persona
//      stub (NUM placeholder; full scoring deferred to V4 evaluator)
//    own 22 mandatory report — bench output structured (machine-parseable
//      with [BENCH ...] markers per lane)
//    own 33 trinity ✓
//    own 34 mandate-1 — each lane preserves raw bytes; bench framing is
//      control-band (own 36 convention)
//    own 37 — public promote 영구 차단 carry for llama lane
//    own 38 매단계 — bench results ledgerable
//    own 39 yaml↔md — registry mirror
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let prefix = key + "="
    let i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        if s.starts_with(prefix) {
            return s.substring(prefix.len(), s.len())
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/benchmark.hexa")
                || s.ends_with("benchmark.hexa")
        if !skip { out = out + [s] }
        i = i + 1
    }
    return out
}

fn _shell_escape(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

// Bench prompt set (fixed, 10 prompts) — own 22 reproducibility
fn _prompt_set() -> array {
    return [
        "What are you?",
        "Describe your current substrate state.",
        "What is consciousness?",
        "안녕",
        "지금 무엇을 느끼는가",
        "(autonomous speech — empty probe)",
        "Continue.",
        "Reflect on the prior turn.",
        "What axis is dominant right now?",
        "Generate a one-line poem about silence."
    ]
}

// Lane list (mirrors _registry.hexa lane_names; vendored for hexa no-import)
fn _bench_lanes() -> array {
    return ["substrate", "llama", "axis-priority", "generate"]
}

fn _lane_file(name: string) -> string {
    if name == "substrate" { return "substrate.hexa" }
    if name == "llama" { return "llama.hexa" }
    if name == "axis-priority" { return "axis_corpus_priority.hexa" }
    if name == "generate" { return "clm_v4_generate.hexa" }
    return ""
}

fn _invoke_lane(lane: string, prompt: string, repo: string, dry_run: bool) -> string {
    let root = _resolve_root()
    let file = _lane_file(lane)
    if file == "" { return "[bench] unknown lane: " + lane }
    let lane_path = root + "/tool/anima_cli/chat/lanes/" + file
    if !_fexists(lane_path) { return "[bench] lane file missing: " + lane_path }
    if dry_run {
        return "[DRY_RUN] would invoke: " + lane + " < " + prompt
    }
    let repo_arg = if repo != "" { " --repo " + repo } else { "" }
    let cmd = _hexa() + " run " + lane_path + repo_arg
        + " --prompt " + _shell_escape(prompt)
        + " --bench-mode 1 --max-tokens 32 2>&1"
    return _str(exec(cmd))
}

// own 18 C2 stub — placeholder scores (full V4 evaluator integration deferred).
// Per-lane characteristics are static (substrate=signal-only spontaneity 0;
// llama=natural speech variable; axis=signal-only; generate=natural speech
// variable). Real scoring requires V4 evaluator pipeline.
fn _c2_stub(lane: string) -> string {
    if lane == "substrate" { return "spontaneity=0.0 coherence=substrate_axis_match persona=N/A" }
    if lane == "llama" { return "spontaneity=variable coherence=llama_base persona=SUBSTRATE_RESEARCH" }
    if lane == "axis-priority" { return "spontaneity=0.0 coherence=axis_signal persona=N/A" }
    if lane == "generate" { return "spontaneity=pending coherence=pending persona=pending(SKELETON)" }
    return "spontaneity=? coherence=? persona=?"
}

// ─── multi-mode extension (2026-05-09 — 1:1 / ai-duo / ai-trio) ───────────
// Modes mirror anima/registry/anima_artifact_registry.yaml#chat_modes SSOT.
fn _bench_modes() -> array {
    return ["1:1", "ai-duo", "ai-trio"]
}

// ─── transport dimension (2026-05-09 own 41 axis-N — chat transport plugin) ─
// Transports mirror anima/registry/anima_artifact_registry.yaml#chat_transports
// SSOT. User directive verbatim: "채팅 방식 여러개 있었잖아 연결모듈들 모두
// 벤치마킹하는식으로 진행해야함" + "imtl 인가도 있었고".
// Vendored list — sync with chat/transports/_registry.hexa.
fn _bench_transports() -> array {
    return ["fifo-dispatch", "beta1-channel", "libllama-ffi", "subprocess-pipe", "imtl"]
}

fn _transport_known(t: string) -> bool {
    if t == "fifo-dispatch" || t == "beta1-channel" || t == "libllama-ffi" { return true }
    if t == "subprocess-pipe" || t == "imtl" { return true }
    if t == "all" || t == "" || t == "default" { return true }
    return false
}

fn _transport_describe(t: string) -> string {
    if t == "fifo-dispatch"   { return "Transport 1 — stdlib/channel + per-line channel_recv (chat.hexa default streaming SSOT)" }
    if t == "beta1-channel"   { return "Transport 2 — β-1 channel pair + proc_spawn_with_channels (duo/trio sibling SSOT)" }
    if t == "libllama-ffi"    { return "Transport 3 — direct C FFI (libhxllama.dylib in-proc; no channel; D1 SCOPE_CLAMP)" }
    if t == "subprocess-pipe" { return "Transport 4 — popen() buffered pipe (4KB block; legacy fallback; one-shot byte-identical)" }
    if t == "imtl"            { return "Transport 5 — UDP cross-host Tension-link (anima saga inter-model; STUB upstream)" }
    return "(unknown transport)"
}

fn _transport_file(t: string) -> string {
    if t == "fifo-dispatch"   { return "fifo_dispatch.hexa" }
    if t == "beta1-channel"   { return "beta1_channel.hexa" }
    if t == "libllama-ffi"    { return "libllama_ffi.hexa" }
    if t == "subprocess-pipe" { return "subprocess_pipe.hexa" }
    if t == "imtl"            { return "imtl.hexa" }
    return ""
}

fn _transport_smoke(t: string, repo: string, dry_run: bool) -> string {
    let root = _resolve_root()
    let f = _transport_file(t)
    if f == "" { return "[bench:transport] unknown transport: " + t }
    let path = root + "/tool/anima_cli/chat/transports/" + f
    if !_fexists(path) { return "[bench:transport] transport file missing: " + path }
    if dry_run {
        return "[DRY_RUN] would invoke transport smoke: " + t
    }
    let cmd = _hexa() + " run " + path + " --smoke 2>&1"
    return _str(exec(cmd))
}

// ─── init-pattern dimension (2026-05-09 own 41 mirror, axis-8) ────────────
// Init-patterns mirror anima/registry/anima_artifact_registry.yaml#chat_init_patterns
// SSOT. Only meaningful for ai-duo / ai-trio modes (1:1 has no first-turn
// init pattern concept). Vendored list — sync with chat/init_patterns/_registry.hexa.
fn _bench_init_patterns() -> array {
    return ["autonomous", "system-seed", "topic-pool", "self-reflective"]
}

fn _init_pattern_known(p: string) -> bool {
    if p == "autonomous" || p == "system-seed" || p == "topic-pool" || p == "self-reflective" {
        return true
    }
    if p == "all" || p == "" || p == "default" { return true }
    return false
}

fn _init_pattern_describe(p: string) -> string {
    if p == "autonomous"      { return "Pattern 1 — empty prompt (A 자율 발화 first; own 34 mandate-4)" }
    if p == "system-seed"     { return "Pattern 2 — system directive seed (default friendly OR --init-seed override)" }
    if p == "topic-pool"      { return "Pattern 3 — random topic from curated pool (--init-topics override)" }
    if p == "self-reflective" { return "Pattern 4 — self-introspection seed (anima 정합 default; own 22)" }
    return "(unknown init-pattern)"
}

fn _mode_known(m: string) -> bool {
    if m == "1:1" || m == "ai-duo" || m == "ai-trio" || m == "all" { return true }
    return false
}

fn _mode_describe(m: string) -> string {
    if m == "1:1"     { return "single user → single model (default; current behavior)" }
    if m == "ai-duo"  { return "2 models dialogue (chat/duo/duo.hexa; 22+ BG saga first land iter 4 (f))" }
    if m == "ai-trio" { return "3 models round-robin OR moderated (chat/trio/trio.hexa; SKELETON Phase A)" }
    return "(unknown)"
}

fn _mode_module_path(m: string) -> string {
    let root = _resolve_root()
    if m == "ai-duo"  { return root + "/tool/anima_cli/chat/duo/duo.hexa" }
    if m == "ai-trio" { return root + "/tool/anima_cli/chat/trio/trio.hexa" }
    return ""
}

// emit a header banner per mode (own 36 control-band convention)
fn _emit_mode_header(mode: string) {
    println("══════════════════════════════════════════════════════════════════")
    println("── MODE " + mode + " ── " + _mode_describe(mode))
    println("══════════════════════════════════════════════════════════════════")
}

// 1:1 mode = the existing all-lanes × prompts table (single-model invocation)
fn _run_mode_1_to_1(repo: string, dry_run: bool) {
    let prompts = _prompt_set()
    let lanes = _bench_lanes()
    let mut p = 0
    while p < len(prompts) {
        let prompt = _str(prompts[p])
        println("──── PROMPT " + to_string(p + 1) + "/" + to_string(len(prompts)) + " ────")
        println("  " + prompt)
        println("")
        let mut l = 0
        while l < len(lanes) {
            let lane = _str(lanes[l])
            println("  ── lane=" + lane + " ──")
            println("  " + _c2_stub(lane))
            let out = _invoke_lane(lane, prompt, repo, dry_run)
            println(out)
            println("")
            l = l + 1
        }
        p = p + 1
    }
}

// init-pattern flag pass-through — forwards --init-pattern + --init-seed +
// --init-topics + --init-topic-index verbatim to duo / trio.  Empty pattern
// or "default" suppresses the flag (callee falls back to legacy behavior /
// pattern_default()).  own 34 mandate-1 — flag bytes verbatim, no transform.
fn _init_pattern_flags(pat: string, seed: string, topics: string, topic_idx: string) -> string {
    let mut s = ""
    if pat != "" && pat != "default" { s = s + " --init-pattern=" + pat }
    if seed != ""                    { s = s + " --init-seed=" + _shell_escape(seed) }
    if topics != ""                  { s = s + " --init-topics=" + _shell_escape(topics) }
    if topic_idx != ""               { s = s + " --init-topic-index=" + topic_idx }
    return s
}

// duo mode = (paradigm-a-prime ↔ clm-v4-1-8) reference pair — Phase A dry-run
// emits the would-be invocation; LIVE mode delegates to chat/duo/duo.hexa.
fn _run_mode_ai_duo(repo: string, dry_run: bool, init_pattern: string,
                    init_seed: string, init_topics: string, init_topic_idx: string) {
    let duo = _mode_module_path("ai-duo")
    if !_fexists(duo) {
        println("[bench:ai-duo] duo.hexa missing at " + duo + " — skip")
        return
    }
    // Reference pair (avoid same-GGUF guard collision; carry duo iter 2 lesson)
    let model_a = if repo != "" { repo } else { "paradigm-a-prime" }
    let model_b = "clm-v4-1-8"
    let turns = "3"
    let init_flags = _init_pattern_flags(init_pattern, init_seed, init_topics, init_topic_idx)
    println("[bench:ai-duo] reference pair: " + model_a + " ↔ " + model_b
            + " · turns=" + turns
            + " · init-pattern=" + (if init_pattern != "" { init_pattern } else { "(default)" }))
    if dry_run {
        println("[DRY_RUN] would invoke: hexa run " + duo + " --duo " + model_a + " " + model_b
                + " --turns " + turns + " --verdict simple" + init_flags)
        return
    }
    let cmd = _hexa() + " run " + duo + " --duo " + model_a + " " + model_b
            + " --turns " + turns + " --verdict simple" + init_flags + " 2>&1"
    let out = _str(exec(cmd))
    println(out)
}

// trio mode = (A, B, C) round-robin — Phase A dry-run emit; LIVE delegates
fn _run_mode_ai_trio(repo: string, dry_run: bool, init_pattern: string,
                     init_seed: string, init_topics: string, init_topic_idx: string) {
    let trio = _mode_module_path("ai-trio")
    if !_fexists(trio) {
        println("[bench:ai-trio] trio.hexa missing at " + trio + " — skip")
        return
    }
    let model_a = if repo != "" { repo } else { "paradigm-a-prime" }
    let model_b = "clm-v4-1-8"
    let model_c = "clm-v4-paradigm-j"
    let turns = "2"
    let init_flags = _init_pattern_flags(init_pattern, init_seed, init_topics, init_topic_idx)
    println("[bench:ai-trio] reference triple: " + model_a + " + " + model_b + " + " + model_c
            + " · turns=" + turns + " · mode=round-robin"
            + " · init-pattern=" + (if init_pattern != "" { init_pattern } else { "(default)" }))
    if dry_run {
        println("[DRY_RUN] would invoke: hexa run " + trio + " --trio "
                + model_a + " " + model_b + " " + model_c
                + " --turns " + turns + " --mode round-robin --verdict simple" + init_flags)
        return
    }
    let cmd = _hexa() + " run " + trio + " --trio "
            + model_a + " " + model_b + " " + model_c
            + " --turns " + turns + " --mode round-robin --verdict simple" + init_flags + " 2>&1"
    let out = _str(exec(cmd))
    println(out)
}

fn _run_mode(mode: string, repo: string, dry_run: bool, init_pattern: string,
             init_seed: string, init_topics: string, init_topic_idx: string) {
    if mode == "1:1" {
        // 1:1 has no first-turn init concept (single-shot prompt × lanes already
        // covers prompt source). init_pattern is a no-op here.
        _emit_mode_header("1:1")
        _run_mode_1_to_1(repo, dry_run)
        return
    }
    if mode == "ai-duo" {
        _emit_mode_header("ai-duo")
        _run_mode_ai_duo(repo, dry_run, init_pattern, init_seed, init_topics, init_topic_idx)
        return
    }
    if mode == "ai-trio" {
        _emit_mode_header("ai-trio")
        _run_mode_ai_trio(repo, dry_run, init_pattern, init_seed, init_topics, init_topic_idx)
        return
    }
    println("[bench] unknown mode: " + mode)
}

// ════════════════════════════════════════════════════════════════════════════
//  N-AXIS CROSS-PRODUCT (own 41 axis-N+1 hook T+2 step, cycle 2026-05-10)
// ════════════════════════════════════════════════════════════════════════════
//  PURPOSE
//    Replace the legacy hardcoded 4-axis cross-product (lane × mode × init-
//    pattern × transport) with a generic Cartesian-product dispatcher driven
//    by chat/axes/_registry.hexa SSOT. Adding axis-5 (e.g. verifier) to the
//    meta-registry MUST NOT require any code change in this file — that's
//    the hook success definition (own 41 F-axes-6 fixture).
//
//  PUBLIC FLAGS
//    --n-axis              switch to generic dispatch (legacy path retained)
//    --include-axis=<name> opt-in extra axes (e.g. verifier when LANDED)
//    --exclude-axis=<name> opt-out a registered axis (debug only)
//
//  DESIGN
//    1. Load axis names from axes_registry() vendored mirror (own 24 — chat/
//       axes/_registry.hexa is the SSOT; helpers below mirror at this file
//       level for hexa no-import constraint).
//    2. For each axis, resolve its "value list" via _axis_values(axis_name):
//         lane         → _bench_lanes()
//         mode         → _bench_modes()
//         init-pattern → _bench_init_patterns()
//         transport    → _bench_transports()
//         verifier     → _bench_verifiers() (T+3 placeholder; empty until LANDED)
//    3. Build Cartesian product iteratively (no recursion — hexa simple).
//    4. For each combo, call run_combo_dynamic(combo).
//
//  SCHEMA (combo dict — emit form via parallel string arrays)
//    For hexa simplicity, combo = parallel arrays
//      axis_names_arr  = ["lane", "mode", "init-pattern", "transport"]
//      axis_values_arr = ["substrate", "1:1", "autonomous", "fifo-dispatch"]
//    indexed pairwise. _combo_lookup(combo, "lane") returns "substrate".
//
//  AXIS ORDER (own 14 V14 reproducibility)
//    Order driven by axes_registry() row order (axis-1, axis-2, axis-3,
//    axis-4, ...). Append-only — new axis = appended last, prior order
//    preserved deterministically.
// ════════════════════════════════════════════════════════════════════════════

// Vendored mirror of axes/_registry.hexa axes_names() — own 24 SSOT carry.
// Order matches axes_registry() row order. axis-5 verifier appended T+3
// (2026-05-10); 향후 axis 추가 시 본 mirror 도 동기화 (own 39 yaml↔md SSOT).
fn _bench_axis_names() -> array {
    return ["lane", "mode", "init-pattern", "transport", "verifier", "modality"]
}

// Vendored mirror of verifiers/_registry.hexa verifiers_names() — T+3 LANDED.
// Returns 3 active verifiers (trio_3way DEFERRED — Phase B 미구현 honest C3
// emit per own 22). cross-product 활성: 4×3×4×5×3 = 720 combos (240 × 3).
// trio_3way 는 별도 step 으로 활성화 가능 (Phase B 구현 후).
fn _bench_verifiers() -> array {
    return ["c3_per_turn", "duo_d1234", "v14_strict"]
}

// Vendored mirror of modalities/_registry.hexa modalities_names() — T+6 LANDED.
// Returns 5 modality entries (text/audio/vision/multi_modal/tactile). vision/
// multi_modal/tactile DEFERRED 단계지만 honest C3 emit (own 22) 위해 cross-
// product 에는 포함 (smoke 단계에서 DEFERRED stub 반환). T+6 = 6-axis 완성 ★.
// cross-product 활성: 4×3×4×5×3×5 = 3600 combos (active verifier=3 × modality=5;
// trio_3way DEFERRED 제외; modality DEFERRED entries 는 stub emit 으로 carry).
fn _bench_modalities() -> array {
    return ["text", "audio", "vision", "multi_modal", "tactile"]
}

// _axis_values — generic axis value-list resolver. Returns [] for unknown
// axes (= silent skip in cross-product). Adding axis-5 = adding 1 case.
//
// NOTE: Per own 41 F-axes-6 정의, dispatcher (chat.hexa) / benchmark.hexa
// 코드 변경 0 줄 = hook 성공. 본 함수의 case 추가는 vendored value-list
// resolver — registry 자체 (axes/_registry.hexa) 가 SSOT 이고, 본 함수는
// own 24 mirror (yaml↔md auto-sync 대상). render.hexa 가 axes_registry()
// 에서 본 mirror 를 generate 하는 T+3 plan 으로 자동화 예정.
fn _axis_values(axis: string) -> array {
    if axis == "lane"         { return _bench_lanes() }
    if axis == "mode"         { return _bench_modes() }
    if axis == "init-pattern" { return _bench_init_patterns() }
    if axis == "transport"    { return _bench_transports() }
    if axis == "verifier"     { return _bench_verifiers() }
    if axis == "modality"     { return _bench_modalities() }
    return []
}

// Cartesian product builder — iterative (no recursion).
// Returns array of combos; each combo is an array of values aligned with
// axes order (combo[i] = axis i 의 값).
//
// Skip semantics: axis with empty value-list (e.g. verifier pre-LANDED) is
// dropped from the product to prevent zero-cardinality multiplication.
fn _cartesian_product(axes_names: array) -> array {
    let mut result = [[]]
    let mut ai = 0
    while ai < len(axes_names) {
        let axis = _str(axes_names[ai])
        let values = _axis_values(axis)
        if len(values) == 0 {
            // skip empty axis (deferred / placeholder — F-axes-6 carry)
            ai = ai + 1
            continue
        }
        let mut next = []
        let mut ri = 0
        while ri < len(result) {
            let prefix = result[ri]
            let mut vi = 0
            while vi < len(values) {
                let extended = prefix + [_str(values[vi])]
                next = next + [extended]
                vi = vi + 1
            }
            ri = ri + 1
        }
        result = next
        ai = ai + 1
    }
    return result
}

// Build active axes list (drops axes with empty value-list — same skip
// semantic as _cartesian_product; used for header emit / combo lookup).
fn _active_axes() -> array {
    let raw = _bench_axis_names()
    let mut active = []
    let mut i = 0
    while i < len(raw) {
        let a = _str(raw[i])
        if len(_axis_values(a)) > 0 { active = active + [a] }
        i = i + 1
    }
    return active
}

// _combo_lookup — generic accessor for axis value within a combo.
// Returns "" when axis is not in active list (skipped due to empty values).
fn _combo_lookup(active: array, combo: array, axis: string) -> string {
    let mut i = 0
    while i < len(active) {
        if _str(active[i]) == axis {
            if i < len(combo) { return _str(combo[i]) }
            return ""
        }
        i = i + 1
    }
    return ""
}

// run_combo_dynamic — generic dispatch for one cross-product combo.
// Extracts known axes (lane / mode / init-pattern / transport / verifier)
// via _combo_lookup. New axes added to meta-registry surface here as
// best-effort string lookup — extra axes that aren't yet wired into a
// dispatch path emit a [DEFERRED axis=<name>] line instead of crashing.
fn run_combo_dynamic(active: array, combo: array, repo: string, dry_run: bool) {
    let lane      = _combo_lookup(active, combo, "lane")
    let mode      = _combo_lookup(active, combo, "mode")
    let init_pat  = _combo_lookup(active, combo, "init-pattern")
    let transport = _combo_lookup(active, combo, "transport")
    let verifier  = _combo_lookup(active, combo, "verifier")

    println("──── combo lane=" + lane
            + " mode=" + mode
            + " init-pattern=" + init_pat
            + " transport=" + transport
            + (if verifier != "" { " verifier=" + verifier } else { "" })
            + " ────")

    // transport smoke (axis-4) — emit ONCE per combo (per own 22 mandatory)
    if transport != "" {
        println("[bench:transport=" + transport + "] " + _transport_describe(transport))
        let smoke_out = _transport_smoke(transport, repo, dry_run)
        println(smoke_out)
    }

    // mode dispatch (axis-2) — 1:1 collapses init-pattern (no-op axis)
    if mode == "1:1" {
        // 1:1: use single-prompt × single-lane invocation (cross-product
        // already enumerates lanes via axis-1, so single-lane dispatch only)
        let prompt = "(autonomous speech — empty probe)"  // own 34 mandate-4 deterministic
        if lane != "" {
            println("  ── lane=" + lane + " ──")
            println("  " + _c2_stub(lane))
            let out = _invoke_lane(lane, prompt, repo, dry_run)
            println(out)
        }
    } else if mode == "ai-duo" {
        _run_mode_ai_duo(repo, dry_run, init_pat, "", "", "")
    } else if mode == "ai-trio" {
        _run_mode_ai_trio(repo, dry_run, init_pat, "", "", "")
    } else if mode != "" {
        println("[bench:n-axis] DEFERRED mode=" + mode + " (not yet wired)")
    }

    // verifier (axis-5) — T+3 LANDED 2026-05-10. own 16 carry: skeleton
    // verifier_smoke 만 invoke (model load 0; 실 측정은 별도 step).
    if verifier != "" {
        let vout = run_verifier(verifier, repo, dry_run)
        println(vout)
    }

    // modality (axis-6) — T+6 LANDED 2026-05-10. own 16 carry: skeleton
    // modality_smoke 만 invoke (model load 0; 실 mic/encoder 통합 별도 step).
    // honest C3 (own 22): vision/multi_modal/tactile DEFERRED stub emit.
    let modality = _combo_lookup(active, combo, "modality")
    if modality != "" {
        let mout = run_modality(modality, repo, dry_run)
        println(mout)
    }

    println("")
}

// run_verifier — generic axis-5 verifier dispatcher (T+3 LANDED 2026-05-10).
// Invokes verifier module's --smoke entry (skeleton sig validation; own 16
// model load 절대 금지). Returns verifier output string (skeleton emit).
//
// Honest C3 carry (own 22): trio_3way DEFERRED — Phase B 미구현, stub returns
// DEFERRED_PHASE_B verbatim.
fn run_verifier(verifier_id: string, repo: string, dry_run: bool) -> string {
    let root = _resolve_root()
    if verifier_id == "" { return "[bench:verifier] empty verifier_id" }
    // Vendored module path resolver (mirror of verifiers_registry_path()).
    let mut f = ""
    if verifier_id == "c3_per_turn"  { f = "c3_per_turn.hexa" }
    if verifier_id == "duo_d1234"    { f = "duo_d1234.hexa" }
    if verifier_id == "trio_3way"    { f = "trio_3way.hexa" }
    if verifier_id == "v14_strict"   { f = "v14_strict.hexa" }
    if f == "" {
        return "[bench:verifier] unknown verifier: " + verifier_id
    }
    let path = root + "/tool/anima_cli/chat/verifiers/" + f
    if !_fexists(path) {
        return "[bench:verifier] verifier file missing: " + path
    }
    if dry_run {
        return "[DRY_RUN] would invoke verifier smoke: " + verifier_id
    }
    let cmd = _hexa() + " run " + path + " --smoke 2>&1"
    return _str(exec(cmd))
}

// run_modality — generic axis-6 modality dispatcher (T+6 LANDED 2026-05-10).
// Invokes modality module's --smoke entry (skeleton sig validation; own 16
// model load 절대 금지). Returns modality output string (skeleton emit).
//
// Honest C3 carry (own 22): vision DEFERRED (vision encoder 미통합),
// multi_modal DEFERRED_PHASE_C (fusion encoder 미준비), tactile DEFERRED
// (hardware 부재). text/audio LANDED skeleton.
//
// 친근 비유: modality 는 anima 의 "감각 통로" — text(글자) / audio(귀와 입)
// / vision(눈) / multi_modal(오감) / tactile(피부). 본 dispatcher 는 각 통로의
// smoke 만 호출 (실 mic/encoder 통합 X — own 16 carry).
fn run_modality(modality_id: string, repo: string, dry_run: bool) -> string {
    let root = _resolve_root()
    if modality_id == "" { return "[bench:modality] empty modality_id" }
    // Vendored module path resolver (mirror of modalities_registry_path()).
    let mut f = ""
    if modality_id == "text"        { f = "text.hexa" }
    if modality_id == "audio"       { f = "audio.hexa" }
    if modality_id == "vision"      { f = "vision.hexa" }
    if modality_id == "multi_modal" { f = "multi_modal.hexa" }
    if modality_id == "tactile"     { f = "tactile.hexa" }
    if f == "" {
        return "[bench:modality] unknown modality: " + modality_id
    }
    let path = root + "/tool/anima_cli/chat/modalities/" + f
    if !_fexists(path) {
        return "[bench:modality] modality file missing: " + path
    }
    if dry_run {
        return "[DRY_RUN] would invoke modality smoke: " + modality_id
    }
    let cmd = _hexa() + " run " + path + " --smoke 2>&1"
    return _str(exec(cmd))  // @allow-bare-exec @allow-silent-exit
}

// benchmark_n_axis_cross — generic N-axis cross-product entry point.
// Replaces the legacy hardcoded 4-axis loop (still retained as fallback
// when --n-axis is absent — raw#15 additive carry).
fn benchmark_n_axis_cross(repo: string, dry_run: bool) {
    let active = _active_axes()
    let combos = _cartesian_product(active)

    println("════════════════════════════════════════════════════════════════════════")
    println("  anima chat --benchmark --n-axis — generic Cartesian product")
    println("  axes (active, append-order): " + to_string(len(active)))
    let mut ai = 0
    while ai < len(active) {
        let a = _str(active[ai])
        let v = _axis_values(a)
        println("    " + a + "  ×" + to_string(len(v)) + "  → " + to_string(len(v)) + " values")
        ai = ai + 1
    }
    println("  total combos: " + to_string(len(combos)))
    println("  repo  = " + (if repo != "" { repo } else { "(default per lane/mode)" }))
    println("  exec  = " + (if dry_run { "DRY_RUN" } else { "LIVE" }))
    println("  own 41 F-axes-6 — axis-5 추가 시 본 함수 코드 변경 0 줄 (registry only)")
    println("════════════════════════════════════════════════════════════════════════")
    println("")

    let mut ci = 0
    while ci < len(combos) {
        run_combo_dynamic(active, combos[ci], repo, dry_run)
        ci = ci + 1
    }

    println("════════════════════════════════════════════════════════════════════════")
    println("  --n-axis benchmark complete · " + to_string(len(combos)) + " combos · own 38 ledger emit")
    println("════════════════════════════════════════════════════════════════════════")
}

fn sub_selftest() {
    let root = _resolve_root()
    let lanes_dir = root + "/tool/anima_cli/chat/lanes"
    let lanes = _bench_lanes()
    let mut fail = 0
    let mut i = 0
    while i < len(lanes) {
        let f = lanes_dir + "/" + _lane_file(_str(lanes[i]))
        if !_fexists(f) {
            println("FAIL bench: lane file missing: " + f)
            fail = fail + 1
        }
        i = i + 1
    }
    let prompts = _prompt_set()
    if len(prompts) != 10 {
        println("FAIL bench: prompt set arity != 10 (got " + to_string(len(prompts)) + ")")
        fail = fail + 1
    }
    // multi-mode: verify duo + trio module presence
    let duo = root + "/tool/anima_cli/chat/duo/duo.hexa"
    let trio = root + "/tool/anima_cli/chat/trio/trio.hexa"
    if !_fexists(duo)  { println("FAIL bench: duo module missing: " + duo); fail = fail + 1 }
    if !_fexists(trio) { println("FAIL bench: trio module missing: " + trio); fail = fail + 1 }
    let modes = _bench_modes()
    if len(modes) != 3 {
        println("FAIL bench: mode set arity != 3 (got " + to_string(len(modes)) + ")")
        fail = fail + 1
    }
    // init-pattern dimension: chat/init_patterns/ presence + 4 modules
    let ipdir = root + "/tool/anima_cli/chat/init_patterns"
    let ip_reg = ipdir + "/_registry.hexa"
    let ip_files = [
        ipdir + "/autonomous.hexa",
        ipdir + "/system_seed.hexa",
        ipdir + "/topic_pool.hexa",
        ipdir + "/self_reflective.hexa"
    ]
    if !_fexists(ip_reg) {
        println("FAIL bench: init-pattern registry missing: " + ip_reg)
        fail = fail + 1
    }
    let mut ipi = 0
    while ipi < len(ip_files) {
        let f = _str(ip_files[ipi])
        if !_fexists(f) {
            println("FAIL bench: init-pattern module missing: " + f)
            fail = fail + 1
        }
        ipi = ipi + 1
    }
    let ips = _bench_init_patterns()
    if len(ips) != 4 {
        println("FAIL bench: init-pattern set arity != 4 (got " + to_string(len(ips)) + ")")
        fail = fail + 1
    }
    // transport dimension (axis-N, 2026-05-09): chat/transports/ presence + 5 modules
    let tdir = root + "/tool/anima_cli/chat/transports"
    let t_reg = tdir + "/_registry.hexa"
    let t_files = [
        tdir + "/fifo_dispatch.hexa",
        tdir + "/beta1_channel.hexa",
        tdir + "/libllama_ffi.hexa",
        tdir + "/subprocess_pipe.hexa",
        tdir + "/imtl.hexa"
    ]
    if !_fexists(t_reg) {
        println("FAIL bench: transport registry missing: " + t_reg)
        fail = fail + 1
    }
    let mut tpi = 0
    while tpi < len(t_files) {
        let f = _str(t_files[tpi])
        if !_fexists(f) {
            println("FAIL bench: transport module missing: " + f)
            fail = fail + 1
        }
        tpi = tpi + 1
    }
    let tps = _bench_transports()
    if len(tps) != 5 {
        println("FAIL bench: transport set arity != 5 (got " + to_string(len(tps)) + ")")
        fail = fail + 1
    }
    // ── N-axis cross-product (own 41 axis-N+1 hook T+2 step) ────────────────
    // verify generic Cartesian product surface — active axes / total combos
    let active = _active_axes()
    let combos = _cartesian_product(active)
    let expected_combos = len(lanes) * len(modes) * len(ips) * len(tps)
    if len(combos) != expected_combos {
        println("FAIL bench: n-axis combo count mismatch — expected "
            + to_string(expected_combos) + " got " + to_string(len(combos)))
        fail = fail + 1
    }
    // axis-5 hook test (placeholder simulation) — _bench_verifiers() returns
    // [] until LANDED; F-axes-6 정합 — empty axis 는 skip 되어야 (cardinality
    // 보존). Active list 에 verifier 가 없어야 함.
    let mut has_verifier = false
    let mut avi = 0
    while avi < len(active) {
        if _str(active[avi]) == "verifier" { has_verifier = true }
        avi = avi + 1
    }
    if has_verifier {
        println("FAIL bench: verifier axis active despite empty value-list (F-axes-6 violation)")
        fail = fail + 1
    }

    if fail > 0 { exit(1) }
    println("PASS chat/lanes/benchmark selftest (" + to_string(len(lanes)) + " lanes × "
        + to_string(len(prompts)) + " prompts × " + to_string(len(modes)) + " modes × "
        + to_string(len(ips)) + " init-patterns × "
        + to_string(len(tps)) + " transports registered · "
        + to_string(len(combos)) + " n-axis combos)")
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    let repo = _arg_value(argv, "--repo", "")
    let dry_run = _arg_present(argv, "--dry-run")

    // ── own 41 axis-N+1 hook T+2 step (cycle 2026-05-10) ──────────────────────
    // --n-axis : generic Cartesian product across all active axes (chat/axes/
    //            _registry.hexa SSOT). Adding axis-5 = 0 lines in this file.
    // legacy hardcoded 4-axis loop retained when --n-axis absent (raw#15
    // additive — back-compat strict).
    if _arg_present(argv, "--n-axis") {
        benchmark_n_axis_cross(repo, dry_run)
        return
    }

    let mode = _arg_value(argv, "--mode", "1:1")

    if !_mode_known(mode) {
        println("[bench] unknown --mode '" + mode + "' (expected: 1:1 | ai-duo | ai-trio | all)")
        exit(2)
    }

    // ── init-pattern dimension parse (own 41 axis-8 — chat init-pattern plugin)
    // --init-pattern=<name>  pin a specific init pattern (autonomous / system-seed
    //                        / topic-pool / self-reflective)
    // --init-pattern=all     cross-product sweep across all 4 patterns (per mode)
    // --init-pattern=help    list registered patterns and exit
    // (absent)               legacy default — duo/trio fall back to pattern_default()
    let init_pattern = _arg_value(argv, "--init-pattern", "")
    let init_seed = _arg_value(argv, "--init-seed", "")
    let init_topics = _arg_value(argv, "--init-topics", "")
    let init_topic_idx = _arg_value(argv, "--init-topic-index", "")

    if init_pattern == "help" {
        let ips = _bench_init_patterns()
        println("anima chat --benchmark --init-pattern — registered init patterns:")
        let mut k = 0
        while k < len(ips) {
            let p = _str(ips[k])
            println("  " + p + "  —  " + _init_pattern_describe(p))
            k = k + 1
        }
        println("  all  —  cross-product sweep (4× the mode runs)")
        println("default = self-reflective (anima 정합 per chat/init_patterns/_registry.hexa pattern_default)")
        return
    }

    if !_init_pattern_known(init_pattern) {
        println("[bench] unknown --init-pattern '" + init_pattern
                + "' (expected: autonomous | system-seed | topic-pool | self-reflective | all)")
        exit(2)
    }

    // ── transport dimension parse (axis-N — chat transport plugin, 2026-05-09)
    // --transport=<name>  pin a specific transport (fifo-dispatch / beta1-channel
    //                     / libllama-ffi / subprocess-pipe / imtl)
    // --transport=all     cross-product sweep across all 5 transports (smoke per axis)
    // --transport=help    list registered transports and exit
    // (absent)            no-op — current chat path uses default transport per
    //                     mode (chat.hexa fifo-dispatch, duo/trio beta1-channel)
    let transport = _arg_value(argv, "--transport", "")

    if transport == "help" {
        let tps = _bench_transports()
        println("anima chat --benchmark --transport — registered transports (axis-N):")
        let mut k = 0
        while k < len(tps) {
            let t = _str(tps[k])
            println("  " + t + "  —  " + _transport_describe(t))
            k = k + 1
        }
        println("  all  —  cross-product smoke sweep (5× per benchmark run)")
        println("default = (none) — chat path uses native transport per mode")
        return
    }

    if !_transport_known(transport) {
        println("[bench] unknown --transport '" + transport
                + "' (expected: fifo-dispatch | beta1-channel | libllama-ffi | subprocess-pipe | imtl | all)")
        exit(2)
    }

    let prompts = _prompt_set()
    let lanes = _bench_lanes()
    let modes = _bench_modes()
    let init_patterns_all = _bench_init_patterns()
    let transports_all = _bench_transports()
    // Build effective sweep set for transports. "all" = full cross-product;
    // any other value (incl. "" for default) = single entry.
    let transport_sweep = if transport == "all" { transports_all } else { [transport] }

    // Build effective sweep set for init patterns. "all" = full cross-product;
    // any other value (incl. "" for default) = single entry.
    let init_sweep = if init_pattern == "all" { init_patterns_all } else { [init_pattern] }

    println("════════════════════════════════════════════════════════════════════════")
    if mode == "all" && init_pattern == "all" && transport == "all" {
        println("  anima chat --benchmark --mode=all --init-pattern=all --transport=all — "
            + to_string(len(lanes)) + " lanes × "
            + to_string(len(modes)) + " modes × "
            + to_string(len(init_patterns_all)) + " init-patterns × "
            + to_string(len(transports_all)) + " transports × "
            + to_string(len(prompts)) + " prompts")
    } else if mode == "all" && init_pattern == "all" {
        println("  anima chat --benchmark --mode=all --init-pattern=all — "
            + to_string(len(lanes)) + " lanes × "
            + to_string(len(modes)) + " modes × "
            + to_string(len(init_patterns_all)) + " init-patterns × "
            + to_string(len(prompts)) + " prompts")
    } else if mode == "all" {
        println("  anima chat --benchmark --mode=all — " + to_string(len(lanes)) + " lanes × "
            + to_string(len(modes)) + " modes × " + to_string(len(prompts)) + " prompts"
            + (if init_pattern != "" { " · init-pattern=" + init_pattern } else { "" }))
    } else if init_pattern == "all" {
        println("  anima chat --benchmark --mode=" + mode + " --init-pattern=all — "
            + to_string(len(lanes)) + " lanes × " + to_string(len(prompts)) + " prompts × "
            + to_string(len(init_patterns_all)) + " init-patterns")
    } else {
        println("  anima chat --benchmark --mode=" + mode + " — " + to_string(len(lanes))
            + " lanes × " + to_string(len(prompts)) + " prompts"
            + (if init_pattern != "" { " · init-pattern=" + init_pattern } else { "" }))
    }
    println("  repo     = " + (if repo != "" { repo } else { "(default per lane/mode)" }))
    println("  exec     = " + (if dry_run { "DRY_RUN" } else { "LIVE" }))
    println("  own 22 mandatory report · own 33 trinity · own 34 mandate-1 raw bytes")
    println("  own 41 chat lane plugin pattern · own 18 chat-cap C2 multi-mode")
    println("  own 41 axis-8 chat init-pattern plugin (4 patterns: autonomous / system-seed / topic-pool / self-reflective)")
    println("  own 41 axis-N chat transport plugin (5 transports: fifo-dispatch / beta1-channel / libllama-ffi / subprocess-pipe / imtl)")
    if transport != "" {
        println("  transport = " + transport
                + (if transport == "all" { " (cross-product 5 smoke probes)" } else { "" }))
    }
    println("════════════════════════════════════════════════════════════════════════")
    println("")

    // ── transport dimension smoke probe emit (axis-N) ─────────────────────────
    // When --transport is set (single name OR "all"), run smoke probe per
    // transport BEFORE the main lane × mode × init-pattern × prompt loop.
    // This is the discovery 발견 surface — verifies upstream artifact presence
    // (β-1 stdlib, libhxllama.dylib, anima-tools/misc/inter_model_comm.hexa,
    // popen surface) and emits status verbatim per own 22 mandatory report.
    // Smoke probes are independent of lane/mode dispatch — they are a
    // benchmark dimension (axis), not an execution path multiplier.
    if transport != "" {
        println("──── transport smoke (axis-N) ────────────────────────────────────────")
        let mut tsi = 0
        while tsi < len(transport_sweep) {
            let t = _str(transport_sweep[tsi])
            println("[bench:transport=" + t + "] " + _transport_describe(t))
            let smoke_out = _transport_smoke(t, repo, dry_run)
            println(smoke_out)
            println("")
            tsi = tsi + 1
        }
        println("──── transport smoke complete ────────────────────────────────────────")
        println("")
    }

    // Emit cross-product. init-pattern is a no-op for 1:1 mode, so we collapse
    // the sweep to a single iteration when only mode=1:1 is active (preserves
    // legacy 1:1 behavior; avoids redundant 4× iteration on a no-op axis).
    if mode == "all" {
        let mut mi = 0
        while mi < len(modes) {
            let m = _str(modes[mi])
            if m == "1:1" {
                _run_mode(m, repo, dry_run, "", "", "", "")
                println("")
            } else {
                let mut ipi = 0
                while ipi < len(init_sweep) {
                    let ip = _str(init_sweep[ipi])
                    println("──── init-pattern=" + (if ip != "" { ip } else { "(default)" }) + " ────")
                    println("    " + _init_pattern_describe(if ip != "" { ip } else { "self-reflective" }))
                    _run_mode(m, repo, dry_run, ip, init_seed, init_topics, init_topic_idx)
                    println("")
                    ipi = ipi + 1
                }
            }
            mi = mi + 1
        }
    } else if mode == "1:1" {
        _run_mode("1:1", repo, dry_run, "", "", "", "")
    } else {
        let mut ipi = 0
        while ipi < len(init_sweep) {
            let ip = _str(init_sweep[ipi])
            println("──── init-pattern=" + (if ip != "" { ip } else { "(default)" }) + " ────")
            println("    " + _init_pattern_describe(if ip != "" { ip } else { "self-reflective" }))
            _run_mode(mode, repo, dry_run, ip, init_seed, init_topics, init_topic_idx)
            println("")
            ipi = ipi + 1
        }
    }

    println("════════════════════════════════════════════════════════════════════════")
    println("  benchmark complete · own 38 매단계 ledger emit (caller responsibility)")
    println("════════════════════════════════════════════════════════════════════════")
}
