// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/llama/llama.hexa — Phase 3c chat module (libllama FFI)
//
//  PURPOSE
//    GGUF-backed chat branch module. Wraps anima/llama_ffi.hexa (Phase 3b
//    libhxllama bindings) into the recursive chat module pattern. REPL polls
//    stdin via sys_stdin_read_line_timeout(tick_ms); on timeout (no user
//    input) the model speaks autonomously (own 34 mandate-4) — same wiring
//    as chat/anima_native/.
//
//  RECURSIVE MODULE PATTERN (per user directive 2026-05-08)
//    "모듈 = 코어 + 모듈 + ai-native doc 재귀"
//    core            : anima/llama_ffi.hexa  (Phase 3b — extern fn × 19 +
//                      llama_load / llama_generate / llama_free helpers)
//    module body     : this file (REPL surface, GGUF resolve, flag parse)
//    ai-native doc   : llama.ai.md (sister)
//
//  PHASE 3c SCOPE (this commit)
//    - Phase 3 gate in chat.hexa removed for module=llama
//    - GGUF resolved from ~/.cache/anima/gguf/<org>_<repo>.gguf
//      (own 31 mandate-1 — dancinlab/ org SSOT)
//    - --prompt one-shot OR REPL via sys_stdin_read_line_timeout(tick_ms)
//    - own 34 mandate-1/2/4 strict — raw decode→sample→detokenize, no
//      system prompt, no chat template, no persona inject
//
//  FLAGS
//    --prompt "..."           one-shot mode (no REPL)
//    --max-tokens N           generation cap (default 64)
//    --temp F                 0.0 = greedy, else stochastic (default 0.7)
//    --top-p F                nucleus cap (default 0.9; folded in shim — see
//                             llama_ffi.hexa C3 #4)
//    --tick-ms N              REPL stdin poll interval (default 1000)
//    --memory full|user|none  history accumulation (default full)
//    --n-ctx N                context size (default 2048; 0 = model default)
//    --repo <hf-id>           override alias-resolved repo
//    --selftest               module self-test
//    --help
//
//  COMPLIANCE
//    own 34 mandate-1   raw model output preserved (print, not println; no
//                       trim beyond optional EOS handled inside helper)
//    own 34 mandate-2   wrapping 0 — no system prompt, no chat template, no
//                       messages API, no persona inject. selftest grep verified.
//    own 34 mandate-4   autonomous speech via _generate_step("") on stdin
//                       timeout (sys_stdin_read_line_timeout)
//    own 34 mandate-7   chat lane (own 18 measurement separate)
//    own 31 mandate-1   GGUF source = dancinlab/ (cache filename mirrors org)
//    raw#9              hexa-only chat path (libhxllama.dylib = build infra,
//                       analogous to vendored runtime.c)
//    raw#10             honest C3 (Phase 3b limitations carried, see llama.ai.md)
//    raw#11             snake_case identifiers
//    raw#15             no-hardcode (HOME/cache resolved via env)
//
//  CROSS-REFERENCE
//    .roadmap.cli                  cli.llama_module_landed_2026_05_08
//    anima/llama_ffi.hexa          core (extern fn + llama_load/generate/free)
//    build/libhxllama.dylib        C shim (Phase 3b artifact)
//    tool/anima_chat_llama_smoke.hexa  Phase 3b end-to-end smoke pattern
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/sys"
use "anima/llama_ffi"

// ─── helpers (vendored — hexa no cross-file import) ───────────────────────

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _fexists(p: string) -> bool {
    return _str(exec("test -f \"" + p + "\" && echo 1 || echo 0")).trim() == "1"
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        // strip hexa-cache, interpreter path, and this script path
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/llama.hexa")
                || s.ends_with("llama.hexa")
        if !skip {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

// ─── GGUF resolution ──────────────────────────────────────────────────────
//
// Cache layout (per cli.gguf_conversion_landed_2026_05_08):
//   ~/.cache/anima/gguf/<org>_<repo-flat>.gguf
//
// Repo arg is HF-id form "dancinlab/<repo>". Cache filename uses underscore
// separator: "dancinlab_<repo>.gguf". own 31 mandate-1 enforces dancinlab/.

fn _gguf_path_for_repo(repo: string) -> string {
    let home = _str(env("HOME"))
    let cache = home + "/.cache/anima/gguf/"
    // repo "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1"
    //   → "dancinlab_llm-llama32-3b-paradigm-a-prime-r16-sft-stage1.gguf"
    let mut flat = ""
    let i = 0
    while i < len(repo) {
        let c = repo.substring(i, i + 1)
        if c == "/" { flat = flat + "_" } else { flat = flat + c }
        i = i + 1
    }
    return cache + flat + ".gguf"
}

fn _emit_gguf_missing(repo: string, gguf: string) {
    println("[llama] GGUF not cached: " + gguf)
    println("[llama] convert via: python3 tool/anima_gguf_convert.py <alias> [--q4|--q8|--f16]")
    println("[llama]   (alias resolved repo = " + repo + ")")
    println("[llama] aborting.")
}

// ─── help / selftest subcommands ─────────────────────────────────────────

fn sub_help() {
    println("llama chat module — GGUF-backed inference via libhxllama (Phase 3c)")
    println("")
    println("FLAGS")
    println("  --prompt \"...\"           one-shot")
    println("  --max-tokens N           default 64")
    println("  --temp F                 default 0.7 (0.0 = greedy)")
    println("  --top-p F                default 0.9 (folded in shim — see llama_ffi C3)")
    println("  --tick-ms N              REPL poll interval (default 1000)")
    println("  --memory full|user|none  default=full")
    println("  --n-ctx N                default 2048 (0 = model default)")
    println("  --repo <hf-id>           override alias-resolved repo")
    println("  --selftest")
    println("")
    println("PHASE 3c LANDED (2026-05-08)")
    println("  Phase 3 gate in chat.hexa removed for module=llama. paradigm-a-prime")
    println("  GGUF cached → live. Other aliases require GGUF conversion first")
    println("  (run tool/anima_gguf_convert.py <alias>).")
    println("")
    println("OWN 34 STRICT")
    println("  · NO system prompt prepended")
    println("  · NO chat template / messages API")
    println("  · NO persona inject — raw token decode→sample→detokenize")
    println("  · Autonomous speech wired (timeout → llama_generate(history))")
    println("")
    println("C3 LIMITATION (raw#10 honest, carried from Phase 3b)")
    println("  · top_p is shim-fixed at 0.9 (paradigm-a-prime training default).")
    println("    --top-p flag accepted but ignored downstream.")
    println("  · sampler seed fixed (0xC0FFEE) — reproducibility variety deferred.")
    println("  · No streaming UI — llama_generate blocks until EOS / max_tokens.")
    println("    For chunked stream, call helper repeatedly with smaller max.")
    println("  · @link uses absolute path /Users/ghost/core/anima/build/libhxllama.dylib")
    println("    (dev-box only). Re-link with @rpath for portable deploy.")
}

fn sub_selftest() {
    let root = _resolve_root()
    let here = root + "/tool/anima_cli/chat/llama/llama.hexa"
    let core = root + "/anima/llama_ffi.hexa"
    let dylib = root + "/build/libhxllama.dylib"
    let mut fail = 0
    if !_fexists(here)  { println("FAIL llama: module body missing: " + here);  fail = fail + 1 }
    if !_fexists(core)  { println("FAIL llama: ffi core missing: " + core);     fail = fail + 1 }
    if !_fexists(dylib) { println("FAIL llama: shim dylib missing: " + dylib);  fail = fail + 1 }
    // own 34 mandate-2 self-grep on this file
    let pat = "system_prompt|chat_template|apply_chat_template|persona_inject|fn speak\\(|fn talk\\(|fn respond\\(|fn generate_response\\("
    let cmd = "grep -nE \"" + pat + "\" " + here + " 2>/dev/null | grep -v 'let pat =' | wc -l"
    let n = _str(exec(cmd)).trim()
    if n != "0" {
        println("FAIL own 34 mandate-2 chat lane wrapping: " + n + " hits in llama.hexa")
        fail = fail + 1
    }
    if fail > 0 { exit(1) }
    println("PASS chat/llama selftest (core+shim present, own 34 verified)")
}

// ─── REPL / one-shot ─────────────────────────────────────────────────────

fn sub_one_shot(gguf: string, n_ctx: int, prompt: string,
                max_tokens: int, temp: float, top_p: float, seed: int) {
    println("[llama] gguf  = " + gguf)
    println("[llama] n_ctx = " + to_string(n_ctx))
    println("[llama] mode  = one-shot · max-tokens=" + to_string(max_tokens) + " · temp=" + to_string(temp) + " · seed=" + to_string(seed))
    println("[llama] own 34 strict — wrapping 0 · raw decode→sample→detokenize")
    println("")
    let h = llama_load(gguf, n_ctx)
    if h["model"] == 0 {
        println("[llama] FAIL llama_load: " + _str(h["error"]))
        exit(1)
    }
    // own 34 mandate-1 raw output: print() not println().
    let out = llama_generate(h, prompt, max_tokens, temp, top_p, seed)
    print(out)
    println("")
    llama_free(h)
    hxllama_backend_free()
}

// PATH A KEEPALIVE (iter 4 (e) substrate latency mitigation, 2026-05-08)
// ─────────────────────────────────────────────────────────────────────────
// sub_repl loads the GGUF + creates the libllama context EXACTLY ONCE
// (llama_load below the println banner) and then enters an unbounded
// while-loop. Subsequent user (or peer-via-duo-channel) turns reuse the
// resident model + ctx — only the per-turn cost (tokenize + decode +
// generate) is paid. duo dispatches A and B through this REPL surface
// (no --prompt flag), so the keepalive is automatic — first turn is
// cold-load-amortized, turn=2+ pays only generate.
//
// Wall-clock budget per turn (paradigm-a-prime f16 6.4GB, M-series Metal):
//   turn=1 : ~10s load + ~5s prefill + ~15-30s generate(64 tok)  ≈ 30-45s
//   turn=2+: ~15-30s generate(64 tok)                            ≈ 15-30s
//
// Hence duo --turn-timeout-ms default 120000 (cycle 2026-05-08 iter 4 (e)
// Path B) — 120s * 5 turns = 10min upper bound, headroom for stochastic
// generate length + occasional MPS hiccup. Path C (per-token stream via
// libllama eval callback into hexa) deferred — c_ffi.ai.md confirms hexa
// has no C→hexa callback path; requires shim refactor (separate cycle).
// ─────────────────────────────────────────────────────────────────────────
fn sub_repl(gguf: string, n_ctx: int, max_tokens: int,
            temp: float, top_p: float, memory_mode: string, tick_ms: int, seed: int) {
    println("[llama] gguf   = " + gguf)
    println("[llama] n_ctx  = " + to_string(n_ctx))
    println("[llama] mode   = REPL (Phase 3c, sys_stdin_read_line_timeout / autonomous speech)")
    println("[llama] memory = " + memory_mode + " · max-tokens = " + to_string(max_tokens) + " · tick-ms = " + to_string(tick_ms))
    println("[llama] temp   = " + to_string(temp) + " · top-p = " + to_string(top_p) + " (shim-folded 0.9)")
    println("[llama] own 34 strict — wrapping 0 · mandate-4 자율 발화 활성")
    println("[llama] (Ctrl-C / Ctrl-D to quit)")
    println("")
    let h = llama_load(gguf, n_ctx)
    if h["model"] == 0 {
        println("[llama] FAIL llama_load: " + _str(h["error"]))
        exit(1)
    }
    let mut history = ""
    let mut prompt_shown = false
    while true {
        if !prompt_shown {
            print("> ")
            prompt_shown = true
        }
        // Phase 2 mechanism (mirrors anima_native): poll stdin tick_ms ms.
        // Timeout → autonomous speech via llama_generate(history) — own 34
        // mandate-4. User input → append to history → llama_generate(history).
        let line = _str(sys_stdin_read_line_timeout(tick_ms))
        if line == "" {
            // Autonomous speech path. own 34 mandate-1 raw output.
            let out_a = llama_generate(h, history, max_tokens, temp, top_p, seed)
            print(out_a)
            println("")
            if memory_mode == "full" {
                history = history + out_a + "\n"
            }
            prompt_shown = false
            continue
        }
        // User input path.
        if memory_mode == "full" || memory_mode == "user" {
            history = history + line + "\n"
        }
        let out_u = llama_generate(h, history, max_tokens, temp, top_p, seed)
        // own 34 mandate-1: raw model output, no wrapping. REPL 가독성을 위해
        // 한 줄 분리만 추가 — 모델 출력 자체 변형 X.
        print(out_u)
        println("")
        if memory_mode == "full" {
            history = history + out_u + "\n"
        }
        prompt_shown = false
    }
}

// ─── main ────────────────────────────────────────────────────────────────

fn main() {
    let mut argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    // Resolve repo: --repo override OR alias-default paradigm-a-prime
    // (chat.hexa always passes --repo dancinlab/<x> when dispatched; standalone
    // invocation falls back to paradigm-a-prime — Phase 3b verified GGUF).
    let default_repo = "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1"
    let repo = _arg_value(argv, "--repo", default_repo)
    let gguf = _gguf_path_for_repo(repo)
    if !_fexists(gguf) {
        _emit_gguf_missing(repo, gguf)
        exit(2)
    }

    let max_tok_str = _arg_value(argv, "--max-tokens", "64")
    let max_tokens = to_int(max_tok_str)
    let temp_str = _arg_value(argv, "--temp", "0.7")
    let temp = to_float(temp_str)
    let top_p_str = _arg_value(argv, "--top-p", "0.9")
    let top_p = to_float(top_p_str)
    let n_ctx_str = _arg_value(argv, "--n-ctx", "2048")
    let n_ctx = to_int(n_ctx_str)
    let memory_mode = _arg_value(argv, "--memory", "full")
    let tick_str = _arg_value(argv, "--tick-ms", "1000")
    let tick_ms = to_int(tick_str)
    let prompt = _arg_value(argv, "--prompt", "")
    // --seed: 0 = wall-clock (sampling 다양성), nonzero = deterministic
    // (reproducibility). Phase 3c initial: hardcoded 0xC0FFEE; now CLI exposed.
    let seed_str = _arg_value(argv, "--seed", "0")
    let seed = to_int(seed_str)

    if prompt != "" {
        sub_one_shot(gguf, n_ctx, prompt, max_tokens, temp, top_p, seed)
        return
    }
    sub_repl(gguf, n_ctx, max_tokens, temp, top_p, memory_mode, tick_ms, seed)
}
