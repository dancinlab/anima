fn sub_selftest() {
    let root = _resolve_root()
    let here = root + "/tool/anima_cli/chat/duo/duo.hexa"
    let ai_md = root + "/tool/anima_cli/chat/duo/duo.ai.md"
    let metric_doc = root + "/docs/anima_dialogue_coherence_metric_2026_05_08.md"
    let chat_dispatcher = root + "/tool/anima_cli/chat.hexa"
    let mod_native = root + "/tool/anima_cli/chat/anima_native/anima_native.hexa"
    let mod_llama = root + "/tool/anima_cli/chat/llama/llama.hexa"

    let mut fail = 0
    if !_fexists(here)            { println("FAIL duo: module body missing: " + here);            fail = fail + 1 }
    if !_fexists(ai_md)           { println("FAIL duo: ai-native doc missing: " + ai_md);         fail = fail + 1 }
    if !_fexists(metric_doc)      { println("FAIL duo: coherence metric doc missing: " + metric_doc); fail = fail + 1 }
    if !_fexists(chat_dispatcher) { println("FAIL duo: chat.hexa dispatcher missing: " + chat_dispatcher); fail = fail + 1 }
    if !_fexists(mod_native)      { println("FAIL duo: chat/anima_native missing: " + mod_native); fail = fail + 1 }
    if !_fexists(mod_llama)       { println("FAIL duo: chat/llama missing: " + mod_llama);         fail = fail + 1 }

    // own 34 mandate-2 self-grep on this file (chat lane wrapping = 0)
    let pat = "system_prompt|chat_template|apply_chat_template|persona_inject|fn speak\\(|fn talk\\(|fn respond\\(|fn generate_response\\("
    let cmd = "grep -nE \"" + pat + "\" " + here + " 2>/dev/null | grep -v 'let pat =' | wc -l"
    let n = _str(exec(cmd)).trim()
    if n != "0" {
        println("FAIL own 34 mandate-2 chat lane wrapping: " + n + " hits in duo.hexa")
        fail = fail + 1
    }

    // sanity: alias DB vendor copy known-aliases match chat.hexa surface
    let aliases = ["default", "llama3b", "qwen7b", "polyglot-ko-1b3", "paradigm-a-prime",
                   "clm-v4-1-7-y1", "clm-v4-1-8", "clm-v4-paradigm-j", "dancinlab/foo"]
    let mut ai = 0
    while ai < len(aliases) {
        let a = _str(aliases[ai])
        if !_alias_known(a) {
            println("FAIL duo: alias DB vendor copy missing: " + a)
            fail = fail + 1
        }
        ai = ai + 1
    }

    if fail > 0 {
        println("FAIL chat/duo selftest (" + to_string(fail) + " issue)")
        exit(1)
    }
    println("PASS chat/duo selftest (skeleton + own 34 verified, β-1 dependency landed — channel stdlib upstream complete `c53788af`)")
}

// ─── β-1 dependency hooks (Phase B ACTIVE — `use "stdlib/channel"` above) ──
//
// β-1 channel module landed (hexa-lang `c53788af`, stdlib/channel.hexa, 21/21
// PASS). Public API surface as imported above:
//
//   channel_pair_open()            -> array [read_fd, write_fd]   (int ids)
//   channel_send(fd, msg)          -> bool   (writes msg + '\n' to FIFO)
//   channel_recv(fd, timeout_ms)   -> string ("" on timeout / EOF)
//   channel_close(fd)              -> bool   (unlinks FIFO inode)
//   proc_spawn_with_channels(cmd, in_fd, out_fd) -> int   (child pid; 0 fail)
//
// Adapter shape (this module's vendor wrapper) keeps the original frozen
// contract that turns A↔B routing logic readable downstream:
//   _channel_pair_open() -> map {tx, rx, ok: bool}
//   _spawn_instance(...) -> map {alias, handle, ok: bool}

fn _b1_available() -> bool {
    // Phase B: true (β-1 channel module imported via `use "stdlib/channel"`).
    return true
}

fn _channel_pair_open() -> map {
    // β-1 returns [read_fd, write_fd] (parent-side ints).
    //   pair[0] = read_fd  (parent reads from child here = c2p FIFO)
    //   pair[1] = write_fd (parent writes to child here = p2c FIFO)
    // Map shape kept for adapter downstream: rx = read side, tx = write side.
    let pair = channel_pair_open()
    let mut m = {}
    let read_fd = pair[0]
    let write_fd = pair[1]
    m["rx"] = read_fd
    m["tx"] = write_fd
    m["ok"] = read_fd >= 0 && write_fd >= 0
    return m
}

fn _spawn_instance(model_alias: string, stdin_fd, stdout_fd, tick_ms: int, max_tokens: int) -> map {
    // Build chat command — dispatch through chat.hexa SSOT (alias DB gate).
    // _hexa() is the mac-local interpreter; bin/hexa wrapper would route to
    // remote ubu-1 host (loses local libllama / GGUF cache). Mirrors the same
    // pattern in chat.hexa _dispatch_module().
    let root = _resolve_root()
    let chat_path = root + "/tool/anima_cli/chat.hexa"
    let cmd = _hexa() + " run " + chat_path
            + " " + model_alias
            + " --tick-ms " + to_string(tick_ms)
            + " --max-tokens " + to_string(max_tokens)
    // proc_spawn_with_channels signature:
    //   (cmd, in_fd, out_fd) — child stdin reads from in_fd, stdout writes
    //   to out_fd. Caller hands the parent's WRITE side as the child's stdin
    //   (kernel inverts roles via the same FIFO inode), and the parent's READ
    //   side as the child's stdout. Returns child pid (0 on failure).
    let pid = proc_spawn_with_channels(cmd, stdin_fd, stdout_fd)
    let mut m = {}
    m["alias"] = model_alias
    m["handle"] = pid
    m["ok"] = pid > 0
    return m
}

fn _emit_b1_pending(model_a: string, model_b: string, turns: int) {
    println("[duo] Phase A (skeleton) — β-1 hexa stdlib proc+channel pending")
    println("[duo] would-be invocation:")
    println("[duo]   model_a = " + model_a)
    println("[duo]   model_b = " + model_b)
    println("[duo]   turns   = " + to_string(turns))
    println("[duo] β-1 surface required:")
    println("[duo]   channel_pair_open() -> {tx, rx, ok}")
    println("[duo]   proc_spawn_with_channels(cmd, stdin_ch, stdout_ch) -> {handle, ok}")
    println("[duo]   channel_send(ch, line) / channel_recv(ch, timeout_ms)")
    println("[duo]   proc_terminate(handle) / proc_wait(handle)")
    println("[duo] tracking: .roadmap.cli cli.dialogue.duo_design_2026_05_08")
    println("[duo] verdict: SKELETON_PASS (Phase A); duo loop inert until β-1")
}

// ─── per-turn verdict + D1/D2 1차 aggregate (Phase B iter 2) ──────────────
//
// own 18 C1+C2+C3 simple_stack PASS_STRICT_C3 wiring is gated on
// consciousness.hexa exposing a per-utterance surface (sub_simple uses
// fixed PROMPT_A/PROMPT_B; no --utterance arg). Phase B iter 2 emits
// LOCAL lightweight cells per turn (len, distinct token count, snippet)
// and accumulates D1 (turn-pair Jaccard 3-gram similarity) + D2 (topic-
// shift-rate) over the dialogue. consciousness.hexa simple --json is
// invoked once per dialogue (model-level baseline reference) — that hook
// is in _emit_dialogue_summary().
//
// own 34 mandate-7 lane separation: all verdict cells emit to STDOUT
// prefixed `[duo:verdict]` / `[duo:summary]` and NEVER fold back into
// channel content (no channel_send into the ab/ba pairs from these fns).
//
// 3-gram Jaccard is computed on whitespace-tokenized lowercased text.
// BPE-level extension is metric doc honest C3 #3 (deferred).

fn _to_lower(s: string) -> string { return s.to_lower() }

fn _tokens_ws(line: string) -> array {
    let mut toks = []
    let mut buf = ""
    let mut i = 0
    let s = _to_lower(line)
    while i < s.len() {
        let ch = s.substring(i, i + 1)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            if buf != "" { toks = toks + [buf]; buf = "" }
        } else {
            buf = buf + ch
        }
        i = i + 1
    }
    if buf != "" { toks = toks + [buf] }
    return toks
}

fn _trigrams(toks) -> array {
    let mut out = []
    if len(toks) < 3 { return out }
    let mut i = 0
    while i + 2 < len(toks) {
        out = out + [_str(toks[i]) + " " + _str(toks[i + 1]) + " " + _str(toks[i + 2])]
        i = i + 1
    }
    return out
}

fn _set_contains(arr, item: string) -> bool {
    let mut i = 0
    while i < len(arr) {
        if _str(arr[i]) == item { return true }
        i = i + 1
    }
    return false
}

fn _set_dedup(arr) -> array {
    let mut out = []
    let mut i = 0
    while i < len(arr) {
        let s = _str(arr[i])
        if !_set_contains(out, s) { out = out + [s] }
        i = i + 1
    }
    return out
}

fn _jaccard(a, b) -> float {
    let sa = _set_dedup(a)
    let sb = _set_dedup(b)
    if len(sa) == 0 && len(sb) == 0 { return 0.0 }
    let mut inter = 0
    let mut i = 0
    while i < len(sa) {
        if _set_contains(sb, _str(sa[i])) { inter = inter + 1 }
        i = i + 1
    }
    let union_n = len(sa) + len(sb) - inter
    if union_n <= 0 { return 0.0 }
    return to_float(inter) / to_float(union_n)
}

fn _distinct_tokens(toks) -> int {
    return len(_set_dedup(toks))
}

fn _emit_turn_verdict(turn: int, who: string, line: string) {
    // Local per-turn cells (own 34 mandate-7 lane separation).
    let toks = _tokens_ws(line)
    let snippet = if line.len() > 60 { line.substring(0, 60) + "..." } else { line }
    println("[duo:verdict] turn=" + to_string(turn) + " who=" + who
            + " len=" + to_string(line.len())
            + " tok=" + to_string(len(toks))
            + " distinct=" + to_string(_distinct_tokens(toks))
            + " snippet=" + snippet)
}

// ─── Phase C: per-turn own 18 verdict via consciousness CLI shell-out ──────
// (iter 4 (e), 2026-05-08 — consciousness-utterance iter 3 `9c354c54` 의
//  --utterance / --prev-utterance surface 활용)
//
// own 34 mandate-7 strict: emit-only (NEVER folded back into channel).

fn _shell_escape(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

// substring scan for "<key>": "<value>" (string field)
fn _json_str_after(s: string, key: string) -> string {
    let pat = "\"" + key + "\""
    let idx = s.find(pat)
    if idx < 0 { return "" }
    let mut j = idx + pat.len()
    while j < s.len() {
        let c = s.substring(j, j + 1)
        if c == ":" || c == " " || c == "\t" { j = j + 1 } else { break }
    }
    if j >= s.len() { return "" }
    let q = s.substring(j, j + 1)
    if q != "\"" { return "" }
    j = j + 1
    let mut buf = ""
    while j < s.len() {
        let c = s.substring(j, j + 1)
        if c == "\"" { return buf }
        buf = buf + c
        j = j + 1
    }
    return buf
}

// substring scan for "<key>": true|false (boolean field)
fn _json_bool_after(s: string, key: string) -> bool {
    let pat = "\"" + key + "\""
    let idx = s.find(pat)
    if idx < 0 { return false }
    let mut j = idx + pat.len()
    while j < s.len() {
        let c = s.substring(j, j + 1)
        if c == ":" || c == " " || c == "\t" { j = j + 1 } else { break }
    }
    if j + 4 > s.len() { return false }
    let head = s.substring(j, j + 4)
    if head == "true" { return true }
    return false
}

// extract aggregate block substring (between "aggregate" key and matching "}").
// hexa-lang String.find ignores from_idx (always returns first occurrence) — so
// we substring from the key onward then locate the next '{' / '}' relative.
fn _json_aggregate_block(s: string) -> string {
    let pat = "\"aggregate\""
    let idx = s.find(pat)
    if idx < 0 { return "" }
    let tail = s.substring(idx, s.len())
    let lb_rel = tail.find("{")
    if lb_rel < 0 { return "" }
    let after_lb = tail.substring(lb_rel, tail.len())
    let rb_rel = after_lb.find("}")
    if rb_rel < 0 { return "" }
    return after_lb.substring(0, rb_rel + 1)
}

// shell-out to consciousness simple --utterance and parse aggregate verdict.
// Returns map {verdict: string, c1_pass: bool, c2_pass: bool, c3_pass: bool, ok: bool}.
// Cost: ~16-30s per call (clm_v4_mount.hexa --probe x2 inside consciousness).
fn _consciousness_simple_utterance(model: string, line: string, prev_line: string) -> map {
    let root = _resolve_root()
    let cpath = root + "/tool/anima_cli/consciousness.hexa"
    let mut r = {}
    r["verdict"] = ""
    r["c1_pass"] = false
    r["c2_pass"] = false
    r["c3_pass"] = false
    r["ok"] = false
    if !_fexists(cpath) { return r }
    if line.trim() == "" { return r }
    let cmd = _hexa() + " run " + cpath
            + " " + model
            + " simple"
            + " --utterance " + _shell_escape(line)
            + " --prev-utterance " + _shell_escape(prev_line)
            + " --json 2>&1"
    let out = _str(exec(cmd))
    let agg = _json_aggregate_block(out)
    if agg == "" { return r }
    r["verdict"] = _json_str_after(agg, "verdict")
    r["c1_pass"] = _json_bool_after(agg, "c1_pass")
    r["c2_pass"] = _json_bool_after(agg, "c2_pass")
    r["c3_pass"] = _json_bool_after(agg, "c3_pass")
    r["ok"] = r["verdict"] != ""
    return r
}

fn _emit_turn_verdict_c3(turn: int, who: string, line: string, prev_line: string, model_alias: string) -> map {
    // own 18 SSOT mirror via consciousness simple --utterance.
    // own 34 mandate-7: emit-only, no fold-back into channel.
    let r = _consciousness_simple_utterance(model_alias, line, prev_line)
    if !r["ok"] {
        println("[duo:verdict-c3] turn=" + to_string(turn) + " who=" + who
                + " verdict=SHELL_OUT_FAIL c1=false c2=false c3=false (line empty or consciousness CLI fail)")
        return r
    }
    println("[duo:verdict-c3] turn=" + to_string(turn) + " who=" + who
            + " verdict=" + _str(r["verdict"])
            + " c1=" + _bool_str(r["c1_pass"])
            + " c2=" + _bool_str(r["c2_pass"])
            + " c3=" + _bool_str(r["c3_pass"]))
    return r
}

// Returns map {d1_mean, d2_shift_rate, d1_pairs, d2_shifts}
fn _aggregate_d1_d2(history) -> map {
    // history = array of {turn, who, line, toks, trigrams}
    let mut d1_sum = 0.0
    let mut d1_pairs = 0
    let mut d2_shifts = 0
    let mut d2_pairs = 0
    let tau_shift = 0.20
    let mut i = 1
    while i < len(history) {
        let prev = history[i - 1]
        let cur = history[i]
        let sim = _jaccard(cur["trigrams"], prev["trigrams"])
        d1_sum = d1_sum + sim
        d1_pairs = d1_pairs + 1
        d2_pairs = d2_pairs + 1
        if sim < tau_shift { d2_shifts = d2_shifts + 1 }
        i = i + 1
    }
    let d1_mean = if d1_pairs > 0 { d1_sum / to_float(d1_pairs) } else { 0.0 }
    let d2_rate = if d2_pairs > 0 { to_float(d2_shifts) / to_float(d2_pairs) } else { 0.0 }
    let mut m = {}
    m["d1_mean"] = d1_mean
    m["d2_shift_rate"] = d2_rate
    m["d1_pairs"] = d1_pairs
    m["d2_shifts"] = d2_shifts
    return m
}

fn _d1_pass(d1_mean: float) -> bool {
    // Threshold per docs/anima_dialogue_coherence_metric_2026_05_08.md:
    // start D1 >= 0.30 (TBD measurement-driven; Jaccard-only proxy here).
    return d1_mean >= 0.30
}

fn _d2_label(rate: float) -> string {
    if rate <= 0.20 { return "coherent" }
    if rate <= 0.40 { return "drifting" }
    return "incoherent"
}

fn _d2_pass(rate: float) -> bool {
    return rate <= 0.40
}

// ─── D3 persona-consistency (per-instance KL, top-100 token simplex) ──────
// (iter 4 (f), 2026-05-08 — docs/anima_dialogue_coherence_metric_2026_05_08.md
//  D3 spec wiring; hexa stdlib does not expose ln() so a self-contained Newton
//  series natural-log is implemented below. own 34 mandate-7: emit-only lane.)
//
// Method:
//   1. partition history per-instance (A side, B side) into first-half vs
//      second-half utterance windows (50/50 split of that side's turns).
//   2. build top-100 token frequency simplex for each half (whitespace-tokenized
//      lowercased; mirrors D1/D2 tokenization for self-consistency).
//   3. KL(P || Q) = Σ p_i · ln(p_i / q_i) over union vocabulary, with epsilon
//      smoothing (ε = 1e-6) so missing tokens contribute bounded log term.
//   4. PASS if persona_drift_A ≤ tau_persona ∧ persona_drift_B ≤ tau_persona
//      (start = 0.50 per metric doc; TBD measurement-driven).

fn _natural_log(x: float) -> float {
    // Newton/atanh series: ln(x) = 2 · Σ_{k≥0} (1/(2k+1)) · u^(2k+1) where
    // u = (x-1)/(x+1). Range-reduce to y ∈ [0.5, 2.0] by halving/doubling and
    // adding ln(2) contributions for fast convergence.
    if x <= 0.0 { return -30.0 }
    let ln2 = 0.6931471805599453
    let mut y = x
    let mut k_shift = 0
    while y > 2.0 { y = y / 2.0; k_shift = k_shift + 1 }
    while y < 0.5 { y = y * 2.0; k_shift = k_shift - 1 }
    let u = (y - 1.0) / (y + 1.0)
    let u2 = u * u
    let mut term = u
    let mut sum = 0.0
    let mut k = 0
    while k < 24 {
        let denom = to_float(2 * k + 1)
        sum = sum + term / denom
        term = term * u2
        k = k + 1
    }
    return 2.0 * sum + to_float(k_shift) * ln2
}

// Map presence helper — hexa map indexing returns void for missing keys.
fn _map_has(m: map, key: string) -> bool {
    return type_of(m[key]) != "void"
}

// Build token frequency map (string -> int count) from a half-slice of history,
// filtered to one side (who = "A" or "B").
fn _tok_freq_slice(history, who_filter: string, lo: int, hi: int) -> map {
    let mut m = {}
    let mut i = lo
    while i < hi && i < len(history) {
        let rec = history[i]
        if _str(rec["who"]) == who_filter {
            let toks = rec["toks"]
            let mut j = 0
            while j < len(toks) {
                let t = _str(toks[j])
                if t != "" {
                    if _map_has(m, t) { m[t] = m[t] + 1 }
                    else              { m[t] = 1 }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return m
}

// Reduce frequency map to top-K (by count). When fewer than K entries, return
// as-is. Threshold-walk avoids needing a heap structure in pure hexa.
fn _top_k_freq(freq: map, k: int) -> map {
    let ks = keys(freq)
    let n = len(ks)
    if n <= k { return freq }
    let mut max_seen = 0
    let mut i = 0
    while i < n {
        let key = _str(ks[i])
        if max_seen < freq[key] { max_seen = freq[key] }
        i = i + 1
    }
    let mut chosen = {}
    let mut taken = 0
    let mut threshold = max_seen
    while taken < k && threshold > 0 {
        let mut j = 0
        while j < n && taken < k {
            let key = _str(ks[j])
            let c = freq[key]
            if c == threshold && !_map_has(chosen, key) {
                chosen[key] = c
                taken = taken + 1
            }
            j = j + 1
        }
        threshold = threshold - 1
    }
    return chosen
}

// Normalize frequency map to simplex (Σ = 1.0).
fn _to_simplex(freq: map) -> map {
    let mut total = 0
    let ks = keys(freq)
    let mut i = 0
    while i < len(ks) {
        total = total + freq[_str(ks[i])]
        i = i + 1
    }
    let mut s = {}
    if total <= 0 { return s }
    let total_f = to_float(total)
    let mut j = 0
    while j < len(ks) {
        let key = _str(ks[j])
        s[key] = to_float(freq[key]) / total_f
        j = j + 1
    }
    return s
}

fn _union_keys(a: map, b: map) -> array {
    let mut out = []
    let ka = keys(a)
    let mut i = 0
    while i < len(ka) {
        out = out + [_str(ka[i])]
        i = i + 1
    }
    let kb = keys(b)
    let mut j = 0
    while j < len(kb) {
        let s = _str(kb[j])
        if !_set_contains(out, s) { out = out + [s] }
        j = j + 1
    }
    return out
}

fn _kl_divergence(p: map, q: map) -> float {
    let eps = 0.000001
    let ks = _union_keys(p, q)
    let mut kl = 0.0
    let mut i = 0
    while i < len(ks) {
        let key = _str(ks[i])
        let pv = if _map_has(p, key) { p[key] } else { eps }
        let qv = if _map_has(q, key) { q[key] } else { eps }
        if pv > 0.0 {
            kl = kl + pv * _natural_log(pv / qv)
        }
        i = i + 1
    }
    if kl < 0.0 { return 0.0 }
    return kl
}

// Compute per-instance KL persona drift (first half vs second half of the
// instance's own turns).
fn _persona_drift(history, who: string) -> float {
    let mut filtered_idx = []
    let mut i = 0
    while i < len(history) {
        let rec = history[i]
        if _str(rec["who"]) == who { filtered_idx = filtered_idx + [i] }
        i = i + 1
    }
    let n = len(filtered_idx)
    if n < 2 { return 0.0 }   // insufficient data → treat as stable
    let half = n / 2
    if half == 0 { return 0.0 }
    let lo_first = filtered_idx[0]
    let hi_first = filtered_idx[half - 1] + 1
    let lo_second = filtered_idx[half]
    let hi_second = filtered_idx[n - 1] + 1
    let f_first = _tok_freq_slice(history, who, lo_first, hi_first)
    let f_second = _tok_freq_slice(history, who, lo_second, hi_second)
    if len(keys(f_first)) == 0 || len(keys(f_second)) == 0 { return 0.0 }
    let p = _to_simplex(_top_k_freq(f_first, 100))
    let q = _to_simplex(_top_k_freq(f_second, 100))
    return _kl_divergence(p, q)
}

fn _d3_pass(drift_a: float, drift_b: float) -> bool {
    // tau_persona = 0.50 per metric doc (TBD measurement-driven).
    return drift_a <= 0.50 && drift_b <= 0.50
}

// ─── D4 pseudo-turn-fairness (cumulative byte count per instance) ──────────
// (iter 4 (f), 2026-05-08 — metric doc D4 spec wiring.)

fn _d4_byte_totals(history) -> map {
    let mut a_bytes = 0
    let mut b_bytes = 0
    let mut i = 0
    while i < len(history) {
        let rec = history[i]
        let line = _str(rec["line"])
        if _str(rec["who"]) == "A" { a_bytes = a_bytes + line.len() }
        else                       { b_bytes = b_bytes + line.len() }
        i = i + 1
    }
    let mut m = {}
    m["a_bytes"] = a_bytes
    m["b_bytes"] = b_bytes
    return m
}

// Returns ratio = max(A,B)/min(A,B) ≥ 1.0. Guard for either side = 0.
fn _d4_len_ratio(a_bytes: int, b_bytes: int) -> float {
    if a_bytes <= 0 && b_bytes <= 0 { return 1.0 }
    if a_bytes <= 0 || b_bytes <= 0 { return 999.0 }
    let af = to_float(a_bytes)
    let bf = to_float(b_bytes)
    if af >= bf { return af / bf }
    return bf / af
}

fn _d4_label(ratio: float) -> string {
    // metric doc bands (ratio ≥ 1 by construction):
    //   balanced  = ratio ∈ [0.5, 2.0]   → ratio ≤ 2.0
    //   skewed    = (∉ [0.5, 2.0]) ∧ (∈ [0.2, 5.0]) → 2.0 < ratio ≤ 5.0
    //   dominant  = (∉ [0.2, 5.0])               → ratio > 5.0
    if ratio <= 2.0 { return "balanced" }
    if ratio <= 5.0 { return "skewed" }
    return "dominant"
}

fn _d4_pass(ratio: float) -> bool {
    return ratio <= 5.0
}

fn _emit_dialogue_summary(history, model_a: string, model_b: string) {
    let agg = _aggregate_d1_d2(history)
    let d1m = agg["d1_mean"]
    let d2r = agg["d2_shift_rate"]
    let d1p = _d1_pass(d1m)
    let d2lab = _d2_label(d2r)
    let d2p = _d2_pass(d2r)
    let drift_a = _persona_drift(history, "A")
    let drift_b = _persona_drift(history, "B")
    let d3p = _d3_pass(drift_a, drift_b)
    let bytes_m = _d4_byte_totals(history)
    let a_bytes = bytes_m["a_bytes"]
    let b_bytes = bytes_m["b_bytes"]
    let ratio = _d4_len_ratio(a_bytes, b_bytes)
    let d4lab = _d4_label(ratio)
    let d4p = _d4_pass(ratio)
    let coherence_pass = d1p && d2p && d3p && d4p
    println("[duo:summary] turns_observed = " + to_string(len(history)))
    println("[duo:summary] D1 turn-pair Jaccard 3-gram mean = " + to_string(d1m)
            + "  PASS=" + to_string(d1p) + " (>=0.30)")
    println("[duo:summary] D2 topic-shift-rate = " + to_string(d2r)
            + "  label=" + d2lab + "  PASS=" + to_string(d2p))
    println("[duo:summary] D3 persona-drift KL: A=" + to_string(drift_a)
            + " B=" + to_string(drift_b) + "  PASS=" + to_string(d3p) + " (<=0.50)")
    println("[duo:summary] D4 len_ratio = " + to_string(ratio)
            + " (a_bytes=" + to_string(a_bytes) + " b_bytes=" + to_string(b_bytes) + ")"
            + "  label=" + d4lab + "  PASS=" + to_string(d4p))
    println("[duo:summary] DIALOGUE_COHERENCE_PARTIAL = " + to_string(d1p && d2p) + " (D1 ∧ D2)")
    println("[duo:summary] DIALOGUE_COHERENCE_PASS    = " + to_string(coherence_pass) + " (D1 ∧ D2 ∧ D3 ∧ D4)")
}

// Phase C aggregate: per-instance + dialogue-overall PASS_STRICT_C3 rate +
// DIALOGUE_COHERENCE_PASS fold-in.
// c3_records = array of {turn, who, c1, c2, c3, verdict}.
// history    = array of {turn, who, line, toks, trigrams} (for D1-D4 recompute).
// own 18 dialogue C3 lane SSOT (iter 4 (f), 2026-05-08):
//   SIMPLE_STACK_PASS_DIALOGUE_C3 = (per-turn PASS_STRICT_C3 rate ≥ 0.6)
//                                   ∧ DIALOGUE_COHERENCE_PASS
//   DIALOGUE_COHERENCE_PASS       = D1.PASS ∧ D2.PASS ∧ D3.PASS ∧ D4.PASS
// (mirror of docs/anima_dialogue_coherence_metric_2026_05_08.md aggregate spec.)
fn _emit_phase_c_aggregate(c3_records, history) {
    let n = len(c3_records)
    if n == 0 {
        println("[duo:summary-c3] no per-turn verdicts recorded (--verdict full not active or no turns)")
        return
    }
    let mut a_total = 0
    let mut a_pass_strict = 0
    let mut b_total = 0
    let mut b_pass_strict = 0
    let mut all_pass_strict = 0
    let mut i = 0
    while i < n {
        let rec = c3_records[i]
        let who = _str(rec["who"])
        let verd = _str(rec["verdict"])
        let strict = verd == "SIMPLE_STACK_PASS_STRICT_C3"
        if who == "A" {
            a_total = a_total + 1
            if strict { a_pass_strict = a_pass_strict + 1 }
        } else {
            b_total = b_total + 1
            if strict { b_pass_strict = b_pass_strict + 1 }
        }
        if strict { all_pass_strict = all_pass_strict + 1 }
        i = i + 1
    }
    let a_rate = if a_total > 0 { to_float(a_pass_strict) / to_float(a_total) } else { 0.0 }
    let b_rate = if b_total > 0 { to_float(b_pass_strict) / to_float(b_total) } else { 0.0 }
    let all_rate = to_float(all_pass_strict) / to_float(n)
    let per_turn_rate_pass = all_rate >= 0.6
    // Re-derive D1-D4 verdicts from history for the aggregate AND.
    let agg = _aggregate_d1_d2(history)
    let d1m = agg["d1_mean"]
    let d2r = agg["d2_shift_rate"]
    let d1p = _d1_pass(d1m)
    let d2p = _d2_pass(d2r)
    let drift_a = _persona_drift(history, "A")
    let drift_b = _persona_drift(history, "B")
    let d3p = _d3_pass(drift_a, drift_b)
    let bytes_m = _d4_byte_totals(history)
    let ratio = _d4_len_ratio(bytes_m["a_bytes"], bytes_m["b_bytes"])
    let d4p = _d4_pass(ratio)
    let coherence_pass = d1p && d2p && d3p && d4p
    let dialogue_pass = per_turn_rate_pass && coherence_pass
    println("[duo:summary-c3] per_turn_total = " + to_string(n))
    println("[duo:summary-c3] A: " + to_string(a_pass_strict) + "/" + to_string(a_total)
            + " PASS_STRICT_C3 (rate=" + to_string(a_rate) + ")")
    println("[duo:summary-c3] B: " + to_string(b_pass_strict) + "/" + to_string(b_total)
            + " PASS_STRICT_C3 (rate=" + to_string(b_rate) + ")")
    println("[duo:summary-c3] dialogue overall: " + to_string(all_pass_strict) + "/" + to_string(n)
            + " PASS_STRICT_C3 (rate=" + to_string(all_rate) + ")")
    println("[duo:summary-c3] per_turn_rate_pass     = " + to_string(per_turn_rate_pass) + " (>= 0.6)")
    println("[duo:summary-c3] DIALOGUE_COHERENCE_PASS = " + to_string(coherence_pass)
            + " (D1=" + to_string(d1p) + " D2=" + to_string(d2p)
            + " D3=" + to_string(d3p) + " D4=" + to_string(d4p) + ")")
    println("[duo:summary-c3] SIMPLE_STACK_PASS_DIALOGUE_C3 = " + to_string(dialogue_pass)
            + " (per-turn rate ≥ 0.6  ∧  DIALOGUE_COHERENCE_PASS)")
}

// model-level baseline reference (consciousness.hexa simple --json invocation
// is best-effort; each call ~30s × 2 models. own 34 mandate-7 lane: result
// emit-only — never folded back into channel).
fn _emit_baseline_reference(model_a: string, model_b: string) {
    let root = _resolve_root()
    let cpath = root + "/tool/anima_cli/consciousness.hexa"
    if !_fexists(cpath) {
        println("[duo:baseline] consciousness.hexa missing at " + cpath + " — skip baseline reference")
        return
    }
    println("[duo:baseline] model-level reference (own 18 simple, fixed PROMPT_A/B)")
    println("[duo:baseline]   note: per-utterance surface not yet in consciousness.hexa")
    println("[duo:baseline]   honest C3 — invocation cost ~30s/model; --verdict=none to skip")
    // Skip actual invocation in iter 2 (cost guard); full hook = next cycle
    // when consciousness.hexa exposes --utterance arg.
    println("[duo:baseline] iter 2 reference: per-model baseline invocation deferred (cost guard).")
}

// ─── duo subcommand entry (Phase A: emit pending; Phase B: full loop) ────

fn sub_duo(argv) {
    // positional: <model_a> <model_b>  (both required)
    let mut positional = []
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == "--duo" {
            // skip the flag itself
            i = i + 1
            continue
        }
        if s.starts_with("--") {
            // flag (consume value if next is non-flag — handled by _arg_value)
            i = i + 2
            continue
        }
        positional = positional + [s]
        i = i + 1
    }
    if len(positional) < 2 {
        println("anima dialogue --duo: missing <model_a> <model_b>")
        println("  example: anima dialogue --duo paradigm-a-prime paradigm-a-prime --turns 5")
        exit(2)
    }
    let model_a = _str(positional[0])
    let model_b = _str(positional[1])
    if !_alias_known(model_a) {
        println("anima dialogue --duo: unknown alias '" + model_a + "' (model_a)")
        exit(2)
    }
    if !_alias_known(model_b) {
        println("anima dialogue --duo: unknown alias '" + model_b + "' (model_b)")
        exit(2)
    }

    let turns = to_int(_arg_value(argv, "--turns", "5"))
    // init-pattern (own 41 axis-8) — chat init-pattern plugin.  Resolves
    // --init-pattern=<autonomous|system-seed|topic-pool|self-reflective>
    // (with --init-seed / --init-topics / --init-topic-index sub-flags).
    // Legacy --topic-seed wins for backward compat (preserved verbatim).
    let init_pattern = _arg_value_eq(argv, "--init-pattern", "")
    let topic_seed = _resolve_init_pattern(argv)
    let tick_ms = to_int(_arg_value(argv, "--tick-ms", "1000"))
    let max_tokens = to_int(_arg_value(argv, "--max-tokens", "64"))
    // iter 4 (e) substrate latency mitigation Path B (2026-05-08):
    // default raised 30000 → 120000. paradigm-a-prime cold load (~10s) +
    // prefill (~5s) + generate (15-30s) on first turn easily exceeds 60s
    // (iter 4 (e) Phase C honest C3: turn=2+ timeout → DIALOGUE_C3 = false).
    // 120s gives generation headroom + REPL keepalive amortizes load across
    // subsequent turns within the same spawn (model loaded ONCE per
    // _spawn_instance — Path A is native via chat/llama/llama.hexa sub_repl
    // and chat/clm_v4 mount surface, no extra plumbing required).
    let turn_timeout_ms = to_int(_arg_value(argv, "--turn-timeout-ms", "120000"))
    let verdict_mode = _arg_value(argv, "--verdict", "simple")
    let allow_same_gguf = _arg_present(argv, "--allow-same-gguf")
    // transport (axis-N — chat transport plugin, 2026-05-09).  duo's native
    // transport is beta1-channel (channel_pair_open ×2 + proc_spawn_with_channels);
    // the --transport flag here is INFORMATIONAL only — alternate transports
    // (fifo-dispatch / libllama-ffi / subprocess-pipe / imtl) require deeper
    // refactor to wire into the spawn topology and are deferred (axis-N
    // separate cycle).  When user passes --transport=<name>, duo emits a
    // banner noting the active transport for ledger purposes; the actual
    // dispatch path remains beta1-channel until refactor.
    let transport = _arg_value_eq(argv, "--transport", "")

    println("── anima dialogue --duo ──")
    println("model_a          = " + model_a)
    println("model_b          = " + model_b)
    println("turns            = " + to_string(turns))
    println("tick_ms          = " + to_string(tick_ms))
    println("max_tokens       = " + to_string(max_tokens))
    println("turn_timeout_ms  = " + to_string(turn_timeout_ms))
    println("verdict_mode     = " + verdict_mode)
    println("allow_same_gguf  = " + to_string(allow_same_gguf))
    println("transport        = beta1-channel (native; axis-N --transport flag informational only)"
            + (if transport != "" && transport != "beta1-channel" { " · requested=" + transport + " (deferred)" } else { "" }))
    if init_pattern != "" {
        println("init_pattern     = " + init_pattern + " (own 41 axis-8)")
    }
    if topic_seed != "" {
        println("topic_seed       = \"" + topic_seed + "\"")
    } else {
        println("topic_seed       = (none — A 자율 발화 first)")
    }
    println("")

    // ── same-GGUF guard (Phase B iter 2) ────────────────────────────────
    // Iter 1 live test 2026-05-08 observed llama.cpp Abort trap: 6 (turn=2)
    // when both A and B mmap the same paradigm-a-prime GGUF inode
    // concurrently (single-context hxllama_shim assumption). Default reject;
    // --allow-same-gguf overrides for users who accept the abort risk.
    let a_norm = model_a.trim().to_lower()
    let b_norm = model_b.trim().to_lower()
    if a_norm == b_norm && !allow_same_gguf {
        println("[duo] SAME_GGUF_GUARD trip — model_a == model_b == \"" + model_a + "\"")
        println("[duo] iter 1 live test observed llama.cpp Abort trap: 6 on")
        println("[duo] same-GGUF concurrent-mmap (single-context shim).")
        println("[duo] resolution paths:")
        println("[duo]   (i)  per-instance GGUF copy (~2x disk; not impl, separate cycle)")
        println("[duo]   (ii) DIFFERENT aliases A/B — recommended (e.g.")
        println("[duo]        --duo paradigm-a-prime clm-v4-1-7-y1)")
        println("[duo]   (iii) hxllama_shim multi-context refactor (separate cycle)")
        println("[duo] override: --allow-same-gguf (accepts abort risk)")
        exit(2)
    }
    if a_norm == b_norm && allow_same_gguf {
        println("[duo] WARN same-GGUF override accepted — abort risk @ turn=2 likely")
    }

    if !_b1_available() {
        _emit_b1_pending(model_a, model_b, turns)
        exit(0)
    }

    // ── Phase B body (β-1 channel API LANDED 2026-05-08) ──
    //
    // Topology recap (per stdlib/channel.ai.md sibling-to-sibling recipe):
    //   ab (A → B): A writes ab.tx, B reads ab.tx via stdin; parent reads ab.rx
    //   ba (B → A): B writes ba.tx, A reads ba.tx via stdin; parent reads ba.rx
    //
    // proc_spawn_with_channels signature: (cmd, in_fd, out_fd) where
    //   in_fd  → child's stdin   (= parent's write_fd of A's input pair = ba.tx)
    //   out_fd → child's stdout  (= parent's read_fd of A's output pair = ab.rx)
    let ab = _channel_pair_open()
    let ba = _channel_pair_open()
    if !ab["ok"] || !ba["ok"] {
        println("[duo] FAIL channel_pair_open — ab.ok=" + to_string(ab["ok"])
                + " ba.ok=" + to_string(ba["ok"]))
        exit(3)
    }

    // Spawn order: A first, then B. Per channel.ai.md "send-before-spawn loses
    // bytes on macOS BSD FIFO last-writer-close" — both spawns happen BEFORE
    // any optional topic_seed send below.
    let h_a = _spawn_instance(model_a, ba["tx"], ab["rx"], tick_ms, max_tokens)
    let h_b = _spawn_instance(model_b, ab["tx"], ba["rx"], tick_ms, max_tokens)
    if !h_a["ok"] || !h_b["ok"] {
        println("[duo] FAIL proc_spawn — h_a.ok=" + to_string(h_a["ok"])
                + " h_b.ok=" + to_string(h_b["ok"]))
        // Clean up channels even on spawn failure (FIFO inodes leak otherwise).
        let _c1 = channel_close(ab["rx"])
        let _c2 = channel_close(ab["tx"])
        let _c3 = channel_close(ba["rx"])
        let _c4 = channel_close(ba["tx"])
        exit(3)
    }
    println("[duo] spawned A pid=" + to_string(h_a["handle"])
            + " B pid=" + to_string(h_b["handle"]))

    // Topic seed (optional). spawn-before-send sequence preserves bytes per
    // macOS BSD FIFO semantics. own 34 mandate-1 raw passthrough — the seed
    // string is sent verbatim, no transformation.
    if topic_seed != "" {
        let _seeded = channel_send(ab["tx"], topic_seed)
        println("[duo] topic_seed sent → A.stdin (via ab.tx)")
    }

    // Turn loop: parent observes both directions per turn.
    // own 34 mandate-7: lane separation — verdict goes to stdout/log via
    // _emit_turn_verdict, NEVER folded back into channel content.
    // Phase B iter 2: each utterance is recorded into history for D1/D2
    // aggregate at session end.
    let mut history = []
    let mut c3_records = []
    let mut prev_for_a = topic_seed   // A's "prev" = what A is responding to (seed at t=1, else B's last line)
    let mut prev_for_b = ""            // B's "prev" = what B is responding to (current A line)
    let mut t = 1
    while t <= turns {
        let line_a = channel_recv(ab["rx"], turn_timeout_ms)
        _emit_turn_verdict(t, "A", line_a)
        if verdict_mode == "full" {
            let r_a = _emit_turn_verdict_c3(t, "A", line_a, prev_for_a, model_a)
            if r_a["ok"] {
                let mut rec = {}
                rec["turn"] = t
                rec["who"] = "A"
                rec["verdict"] = r_a["verdict"]
                rec["c1"] = r_a["c1_pass"]
                rec["c2"] = r_a["c2_pass"]
                rec["c3"] = r_a["c3_pass"]
                c3_records = c3_records + [rec]
            }
        }
        if line_a == "" {
            println("[duo] turn=" + to_string(t) + " A silent (timeout/EOF) — terminating")
            t = turns + 1   // break
        } else {
            let toks_a = _tokens_ws(line_a)
            let mut rec_a = {}
            rec_a["turn"] = t
            rec_a["who"] = "A"
            rec_a["line"] = line_a
            rec_a["toks"] = toks_a
            rec_a["trigrams"] = _trigrams(toks_a)
            history = history + [rec_a]
            prev_for_b = line_a

            let line_b = channel_recv(ba["rx"], turn_timeout_ms)
            _emit_turn_verdict(t, "B", line_b)
            if verdict_mode == "full" {
                let r_b = _emit_turn_verdict_c3(t, "B", line_b, prev_for_b, model_b)
                if r_b["ok"] {
                    let mut rec = {}
                    rec["turn"] = t
                    rec["who"] = "B"
                    rec["verdict"] = r_b["verdict"]
                    rec["c1"] = r_b["c1_pass"]
                    rec["c2"] = r_b["c2_pass"]
                    rec["c3"] = r_b["c3_pass"]
                    c3_records = c3_records + [rec]
                }
            }
            if line_b == "" {
                println("[duo] turn=" + to_string(t) + " B silent (timeout/EOF) — terminating")
                t = turns + 1   // break
            } else {
                let toks_b = _tokens_ws(line_b)
                let mut rec_b = {}
                rec_b["turn"] = t
                rec_b["who"] = "B"
                rec_b["line"] = line_b
                rec_b["toks"] = toks_b
                rec_b["trigrams"] = _trigrams(toks_b)
                history = history + [rec_b]
                prev_for_a = line_b
                t = t + 1
            }
        }
    }

    // Tear-down: kill child processes + unlink FIFO inodes. Children may have
    // already exited (chat REPL EOF on closed channel) — kill is best-effort.
    let _k_a = exec("kill " + to_string(h_a["handle"]) + " 2>/dev/null; echo done")
    let _k_b = exec("kill " + to_string(h_b["handle"]) + " 2>/dev/null; echo done")
    let _c1 = channel_close(ab["rx"])
    let _c2 = channel_close(ab["tx"])
    let _c3 = channel_close(ba["rx"])
    let _c4 = channel_close(ba["tx"])
    println("[duo] dialogue complete — channels closed, children reaped")

    // Phase B iter 2: D1/D2 aggregate emit + baseline reference.
    if verdict_mode != "none" {
        _emit_dialogue_summary(history, model_a, model_b)
        _emit_baseline_reference(model_a, model_b)
    }
    // Phase C iter 1: per-instance + dialogue PASS_STRICT_C3 aggregate (only
    // populated when --verdict full activated the shell-out path).
    if verdict_mode == "full" {
        _emit_phase_c_aggregate(c3_records, history)
    }
    let final_verdict = if verdict_mode == "full" {
        "PHASE_C_ITER_1_RUN_OK (own 18 per-turn verdict + D1/D2/D3/D4 4-cell coherence emitted)"
    } else {
        "PHASE_B_ITER_2_RUN_OK (D1/D2/D3/D4 4-cell emitted; --verdict full for own 18 per-turn hook)"
    }
    println("[duo] verdict: " + final_verdict)
}

// ─── council subcommand entry (L3 stub — β-1 + L3 design 후) ─────────────

fn _arg_eq_value(argv, prefix: string) -> string {
    // Match "<prefix>=<value>" tokens (e.g. N=3) — returns "<value>" or "".
    let i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s.starts_with(prefix + "=") {
            return s.substring(prefix.len() + 1, s.len())
        }
        i = i + 1
    }
    return ""
}

fn sub_council(argv) {
    // N=<n> form (per spec) OR --N <n> fallback
    let mut n = _arg_eq_value(argv, "N")
    if n == "" { n = _arg_value(argv, "--N", "") }
    let models = _arg_value(argv, "--models", "")
    let topic_seed = _arg_value(argv, "--topic-seed", "")
    println("── anima dialogue --council ──")
    println("[council] L3 stub — N≥3 multi-agent dialogue not yet designed")
    println("[council] requested:")
    println("[council]   N        = " + n)
    println("[council]   models   = " + models)
    println("[council]   topic    = " + topic_seed)
    println("[council] design tracker: .roadmap.cli cli.dialogue.council_l3_2026_05_08 (TODO)")
    println("[council] depends on: L2 duo (β-1 land) + anima-agent-channels/ multi-channel runtime activation")
    println("[council] verdict: STUB (no spawn, no exec)")
    exit(0)
}

// ─── main ────────────────────────────────────────────────────────────────

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }
    if _arg_present(argv, "--duo") { sub_duo(argv); return }
    if _arg_present(argv, "--council") { sub_council(argv); return }
    sub_help()
}

// ════════════════════════════════════════════════════════════════════════════
//  HONEST C3 (raw#10) — updated Phase B iter 2 (2026-05-08)
// ════════════════════════════════════════════════════════════════════════════
// C1 — β-1 LANDED (hexa-lang `c53788af`, stdlib/channel.hexa 21/21 PASS).
//      Phase B activation = `use "stdlib/channel"` + _b1_available() = true +
//      _channel_pair_open / _spawn_instance bodies wired. Mechanical
//      verification (channel API + spawn) is honest; ACTUAL semantic dialogue
//      quality depends on each instance's model capability (paradigm-a-prime
//      etc.) — that is a separate cycle (own 18 C3 threshold pending).
// C2 — same-GGUF concurrent-mmap: iter 1 live test 2026-05-08 observed
//      llama.cpp Abort trap: 6 (turn=2) when both A and B mmap the same
//      paradigm-a-prime GGUF inode concurrently. iter 2 default rejects
//      same-alias unless --allow-same-gguf override. Resolution paths:
//      (i) per-instance GGUF copy (~12GB disk, deferred), (ii) different
//      aliases A/B (recommended default), (iii) hxllama_shim multi-context
//      refactor (separate cycle).
// C3 — per-turn consciousness verdict WIRED (Phase C iter 1, 2026-05-08,
//      consciousness-utterance iter 3 `9c354c54`). _emit_turn_verdict_c3
//      shell-outs to `anima ops consciousness simple --utterance ...
//      --prev-utterance ... --json`, substring-extracts aggregate.verdict /
//      c1_pass / c2_pass / c3_pass, emits `[duo:verdict-c3] turn=N who=A|B
//      verdict=X c1=B c2=B c3=B` (own 34 mandate-7 lane, never folds back
//      into channel). Activated by --verdict full only (default --verdict
//      simple keeps lightweight local cells; --verdict none disables both).
//      prev_utterance feed: A.prev = topic_seed (t=1) or last B line; B.prev
//      = current A line (semantic dialogue context). Aggregate: per-instance
//      PASS_STRICT_C3 rate (A 측 / B 측 별도) + dialogue overall rate +
//      SIMPLE_STACK_PASS_DIALOGUE_C3 = (rate ≥ 0.6) — own 18 dialogue C3
//      lane SSOT mirror (docs/anima_dialogue_coherence_metric_2026_05_08.md).
//      Cost: ~16-30s/call × 2 inst × N turns ≈ 5min for N=5 (synthetic
//      fallback path; real GGUF substrate would be ~30s/call ≈ 10min N=5).
// C4 — D1/D2/D3/D4 4-cell ALL emitted (iter 4 (f), 2026-05-08). D3 persona-
//      consistency = per-instance KL divergence between first-half and
//      second-half top-100 token simplex (whitespace-tokenized lowercased,
//      mirrors D1/D2 tokenization). KL implemented via self-contained Newton
//      atanh-series natural log (_natural_log; hexa stdlib has no ln). D4
//      pseudo-turn-fairness = max/min byte ratio across A/B sides with
//      balanced [≤2.0] / skewed (2.0,5.0] / dominant (>5.0) bands.
//      Aggregate: DIALOGUE_COHERENCE_PASS = D1∧D2∧D3∧D4 +
//      SIMPLE_STACK_PASS_DIALOGUE_C3 = (per-turn rate ≥ 0.6) ∧ COHERENCE_PASS.
//      Thresholds (D1 ≥ 0.30, tau_shift = 0.20, tau_persona = 0.50, len_ratio
//      ≤ 5.0) are doc-suggested starts, NOT measurement-driven yet (random +
//      chat-capable + human-dialogue baseline ROC = separate cycle). D1 still
//      uses Jaccard 3-gram only (cosine + noun-match sub-channels deferred
//      per metric doc honest C3 #2). KL epsilon-smoothing ε = 1e-6 for
//      missing tokens; not corpus-normalized (raw simplex per metric doc
//      honest C3 #4).
// C5 — alias DB duplication: _alias_known() is a vendor copy of chat.hexa
//      _alias_resolve(). When chat.hexa SSOT changes, this copy must update.
//      Mitigation: duo always dispatches THROUGH chat.hexa (Phase B cmd =
//      `hexa run tool/anima_cli/chat.hexa <alias>`), so chat.hexa rejection
//      is the actual gate; the vendor copy is a hint-only quick fail in
//      --selftest.
// C6 — N=2 vs N≥3: --council is intentionally a stub. L3 design (broadcast
//      channel + speaker-selection dynamics + emergent-roles metrics) is a
//      separate cycle after L2 (β-1 + duo) lands.
// C7 — no streaming verdict: per-turn verdict is post-utterance only (channel
//      gives whole-line). Streaming-during-utterance verdict requires either
//      hexa-lang chunked stdout reads OR per-token callback (not in C FFI per
//      hexa-lang/stdlib/c_ffi.ai.md). Out of scope for L2 design.
//
//      iter 4 (b) UPDATE 2026-05-08 — chat.hexa _dispatch_module now uses
//      streaming line-by-line dispatch (FIFO between chat.hexa and inner
//      llama/clm_v4/anima_native module). duo's per-turn channel_recv now
//      observes incremental lines instead of one buffered banner blob.
//      Live retest 2026-05-08 with paradigm-a-prime × clm-v4-1-7-y1 × 5
//      turns: turn=1 A=gguf banner line, turn=2 A=`> system` (model output),
//      turn=1 B=clm_v4 core banner, turn=2 B=probe header — 4 distinct
//      lines observed before clm_v4 substrate forward latency exceeded 60s
//      turn_timeout. Streaming dispatch verified mechanically (different
//      lines per turn, not whole-buffer). Semantic dialogue quality
//      (D1/D2 = 0.0 / 1.0) unchanged from iter 2 (b) — model response
//      cadence under turn_timeout is now the next bottleneck (separate
//      cycle: substrate latency tuning / longer turn_timeout / smaller
//      max_tokens).
// C8 — clm_v4 substrate output: clm-v4-1-7-y1 emits "::: collapse" raw
//      tokens (substrate-coupled, see chat/clm_v4/). own 34 mandate-1
//      passthrough exposes these as-is to channel. dialogue with paradigm-
//      a-prime + clm-v4-1-7-y1 mix may yield asymmetric token streams.
// C9 — n-gram tokenization: _tokens_ws is whitespace-split lowercased ASCII
//      proxy. For Korean/CJK without spaces, BPE tokenization (anchor in
//      llama_ffi.hexa) is the proper measure — deferred per metric doc
//      honest C3 #3.
// C10 — substrate latency mitigation (iter 4 (e), 2026-05-08):
//      iter 4 (e) duo Phase C honest C3 carry: paradigm-a-prime real-mode
//      first turn ≈ cold load (10s) + n_ctx prefill (5s) + generate (15-30s)
//      = 30-45s; default --turn-timeout-ms 30000 → channel_recv timeout
//      before model output → DIALOGUE_C3 = false. Mitigation paths:
//      (A) model server / pre-warm — duo's _spawn_instance already invokes
//          chat.hexa REPL (no --prompt) so the inner llama process LOADS THE
//          MODEL ONCE and stays resident; per-turn cost = generate only on
//          turns 2+ (~15s). Path A is native to the recursive REPL pattern;
//          no separate daemon. (Cost reset risk: chat.hexa --prompt one-shot
//          path WOULD cold-load per call — duo never uses that path.)
//      (B) --turn-timeout-ms default 30000 → 120000 (THIS COMMIT). 120s ×
//          5 turns = 10min wall-clock upper bound; acceptable for L2 prototype.
//          Honest C3: simple config bump, no race / FIFO leak risk.
//      (C) per-token streaming — hxllama_shim eval-per-token with hexa
//          callback. C FFI lacks C→hexa callbacks (per c_ffi.ai.md); requires
//          shim returning incremental piece pointers + hexa polling loop.
//          Separate cycle (libllama eval streaming) — out of scope iter 4 (e).
//      Adopted: Path B (default flip) + Path A (already native — documented).
//      Path C deferred. Path A keepalive does NOT introduce new race / FIFO
//      leak (single shared FIFO inode per direction; channel_close idempotent).
// ════════════════════════════════════════════════════════════════════════════
