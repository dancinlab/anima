// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/duo/duo.hexa — N=2 multi-agent dialogue module (skeleton)
//
//  PURPOSE
//    L2 layer of docs/anima_chat_autonomous_speech_roadmap_2026_05_08.md.
//    Two CLM instances (A ↔ B) speak autonomously over a stdin/stdout channel
//    pair. Each instance reuses the existing chat/<module>/ REPL pattern; the
//    duo module wires their stdio together via β-1 hexa stdlib proc+channel
//    surface.
//
//    User directive verbatim (cycle 2026-05-08):
//      "두 instance (CLM A ↔ CLM B) 가 stdin/stdout 으로 자율 대화. <=== very good"
//      "여러명 일때도 진짜로 사람들끼리 대화 하듯이"
//
//  RECURSIVE MODULE PATTERN (per chat/<module>/<module>.hexa convention)
//    chat/duo/
//    ├─ duo.hexa     ← this file (channel orchestrator + per-turn verdict)
//    ├─ duo.ai.md    ← ai-native doc (sister)
//    └─ (core)       ← external: chat/anima_native/, chat/llama/, chat/clm_v4/
//                      (each spawned instance is one of these modules)
//
//  PHASE GATES
//    Phase A (LANDED 2026-05-08): file structure + alias DB + --help +
//      --selftest + honest "β-1 dependency" emit on --duo invocation. NO
//      actual proc spawn / channel I/O.
//    Phase B iter 1 (LANDED 2026-05-08, β-1 channel hexa-lang `c53788af`):
//      wires β-1 stdlib surface — `use "stdlib/channel"`. Public API:
//      - channel_pair_open() -> [read_fd, write_fd]   (parent-side ints)
//      - channel_send(fd, line) -> bool
//      - channel_recv(fd, timeout_ms) -> string       ("" on timeout / EOF)
//      - channel_close(fd) -> bool
//      - proc_spawn_with_channels(cmd, in_fd, out_fd) -> int  (child pid)
//      Edge case: send-before-spawn drops bytes on macOS BSD FIFO last-
//      writer-close → spawn before send (per channel.ai.md recipe).
//    Phase B iter 2 (LANDED 2026-05-08): same-GGUF guard +
//      lightweight per-turn verdict (length/distinct/snippet locally
//      computed; consciousness.hexa simple --json invoked once at session
//      end as model-level baseline reference) + D1/D2 1차 aggregate
//      (D1 turn-pair Jaccard 3-gram similarity; D2 topic-shift-rate).
//      D3/D4 deferred to next cycle.
//      same-GGUF guard reasoning: same alias → same GGUF path → two
//      llama.cpp instances mmap the same inode concurrently → llama.cpp
//      Abort trap: 6 (turn=2) observed in iter 1 live test. Workaround
//      path (i) per-instance GGUF copy: 2 × 5.99GB = 12GB disk overhead
//      not justified for L2 prototype. Path (iii) hxllama_shim multi-
//      context refactor = separate cycle. Path (ii) — different aliases
//      A/B — chosen as default. Override via --allow-same-gguf.
//    Phase C iter 4 (e) substrate latency mitigation (LANDED 2026-05-08):
//      --turn-timeout-ms default 30000 → 120000 (Path B); Path A keepalive
//      already native via _spawn_instance REPL form (model loads ONCE per
//      child, turns 2+ amortize). Path C (per-token streaming via libllama
//      eval callback) deferred — see HONEST C3 C10.
//    Phase C iter 1 (LANDED 2026-05-08, consciousness-utterance iter 3
//      `9c354c54`): per-turn own 18 C1+C2+C3 verdict via shell-out to
//      `anima ops consciousness simple --utterance <text> [--prev-utterance
//      <text>] --json` (anima.consciousness.utterance.v1 schema).
//      _emit_turn_verdict(turn, who, line, prev_line) substring-extracts
//      aggregate.verdict / c1_pass / c2_pass / c3_pass and emits
//      `[duo:verdict-c3] turn=N who=A|B verdict=X c1=B c2=B c3=B`.
//      Cost guard via `--verdict simple|full|none` (default `simple`,
//      lightweight cells; `full` activates per-turn shell-out, ~16-30s/turn
//      × 2 instance × N turns ≈ 5min for N=5 — within agent budget).
//      Aggregate: per-instance PASS rate (A/B 별도) + dialogue overall
//      PASS_STRICT_C3 rate (own 18 dialogue C3 lane SSOT).
//
//  SUBCOMMANDS (called from tool/anima_cli/dialogue.hexa)
//    --duo <model_a> <model_b> [--turns N] [--topic-seed "..."]   N=2 dialogue
//    --council N=<n> --models "<m1>,<m2>,...,<mn>" [--topic-seed]  STUB (L3)
//    --selftest                                                   skeleton check
//    --help
//
//  CHANNEL TOPOLOGY (β-1 dependent)
//
//      ┌──────────────┐     channel_AB     ┌──────────────┐
//      │  instance A  │ ─── send ──────► ──│  instance B  │
//      │ (chat/<m_a>) │                    │ (chat/<m_b>) │
//      │              │ ◄── recv ────── ───│              │
//      └──────────────┘     channel_BA     └──────────────┘
//
//    A.stdout ─→ channel_AB ─→ B.stdin
//    B.stdout ─→ channel_BA ─→ A.stdin
//
//    Each instance is the existing chat/<module>/<module>.hexa REPL — its
//    sys_stdin_read_line_timeout(tick_ms) loop sees peer output as if user
//    input. No code change to the inner module is required.
//
//  TURN SEQUENCE (Phase B target)
//    1. resolve <model_a>, <model_b> via chat.hexa _alias_resolve (vendor copy
//       below; keep in sync with chat.hexa SSOT).
//    2. channel_pair_open() × 2  → {ab, ba}
//    3. proc_spawn_with_channels(chat_cmd_a, ba, ab)   ← A reads ba, writes ab
//       proc_spawn_with_channels(chat_cmd_b, ab, ba)   ← B reads ab, writes ba
//    4. if --topic-seed nonempty: channel_send(ab.tx, seed)
//       else                    : (none — A自律 발화 from sys_stdin_read_line_timeout
//                                  empty → mandate-4 BOS-only forward; first to
//                                  speak by race wins)
//    5. for turn in 1..N:
//         line_from_a = channel_recv(ab.rx, turn_timeout_ms)   ← B waits A
//         _emit_turn_verdict(turn, "A", line_from_a)
//         line_from_b = channel_recv(ba.rx, turn_timeout_ms)   ← A waits B
//         _emit_turn_verdict(turn, "B", line_from_b)
//    6. proc_terminate(handle_a); proc_terminate(handle_b)
//    7. _emit_dialogue_summary(coherence_aggregate)
//
//  COMPLIANCE (raw#9, raw#10, raw#11, raw#15; own 31, own 33, own 34)
//    own 34 mandate-1   each instance output is raw passthrough — channel
//                       transport carries bytes verbatim, NO transformation
//                       (no system prompt, no template, no persona prefix).
//    own 34 mandate-2   selftest grep enforces wrapping 0 in this file.
//    own 34 mandate-4   autonomous speech — instances use existing Phase 2
//                       sys_stdin_read_line_timeout; channel timeout maps to
//                       autonomous tick. duo loop does NOT inject any prompt.
//    own 34 mandate-7   chat lane (own 18 measurement lane separate; per-turn
//                       verdict reads consciousness CLI = measurement lane,
//                       results emitted as ledger only — NOT folded back into
//                       channel content).
//    own 33             trinity compliance (D_no-system-prompt cross-ref)
//    own 31 mandate-1   model alias DB mirrors dancinlab/ org SSOT
//    raw#9              hexa-only — proc spawn via β-1 stdlib (no shell pipes)
//    raw#10             honest C3 (see HONEST C3 footer)
//    raw#11             snake_case
//    raw#15             no-hardcode (paths via _resolve_root)
//
//  CROSS-REFERENCE
//    docs/anima_chat_autonomous_speech_roadmap_2026_05_08.md     L2 layer
//    docs/anima_dialogue_coherence_metric_2026_05_08.md          coherence spec
//    tool/anima_cli/dialogue.hexa                                topic dispatcher
//    tool/anima_cli/chat.hexa                                    alias resolver
//    tool/anima_cli/chat/anima_native/anima_native.hexa          Phase 2 REPL
//    tool/anima_cli/chat/llama/llama.hexa                        Phase 3c REPL
//    tool/anima_cli/consciousness.hexa                           own 18 verdict
//    .roadmap.cli  cli.dialogue.duo_design_2026_05_08
//                  cli.dialogue.coherence_metric_2026_05_08
//    .own own 18 C1+C2+C3 · own 34 mandate-1/2/4/7 · own 33 · own 31
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/channel"

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _dexists(p: string) -> bool {
    return _str(exec("test -d " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

// init-pattern parse helper — supports BOTH `--key value` and `--key=value`
// forms (own 41 axis-8 — duo accepts the same flag set as benchmark.hexa
// pass-through).  See chat/init_patterns/_registry.hexa for registered names.
fn _arg_value_eq(argv, key: string, dflt: string) -> string {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key && i + 1 < len(argv) { return _str(argv[i + 1]) }
        if s.starts_with(prefix) {
            return s.substring(len(prefix), len(s))
        }
        i = i + 1
    }
    return dflt
}

// Resolve init-pattern → t=1 seed string.  Empty return = no seed (autonomous).
// Cross-references chat/init_patterns/<name>.hexa SSOT default seeds; the
// resolution is vendored here for hexa no-import constraint (mirrors
// chat.hexa _lane_file_lookup vendoring pattern, own 41 axis-4).
fn _resolve_init_pattern(argv) -> string {
    let pattern = _arg_value_eq(argv, "--init-pattern", "")
    let user_seed = _arg_value_eq(argv, "--init-seed", "")
    // Legacy --topic-seed wins for backward compat (carries to system-seed
    // semantics implicitly per registry SSOT note).
    let legacy_seed = _arg_value(argv, "--topic-seed", "")
    if legacy_seed != "" { return legacy_seed }
    if pattern == "" || pattern == "default" {
        // No explicit pattern → fall through to legacy behavior (no seed).
        // Caller may still seed via --topic-seed (handled above).
        return ""
    }
    if pattern == "autonomous" { return "" }
    if pattern == "system-seed" {
        if user_seed != "" { return user_seed }
        return "너희 둘은 친구. 자유롭게 대화 시작."
    }
    if pattern == "self-reflective" {
        if user_seed != "" { return user_seed }
        return "너 자신에 대해 어떻게 느껴? 친구한테 자유롭게 얘기해봐."
    }
    if pattern == "topic-pool" {
        let user_pool = _arg_value_eq(argv, "--init-topics", "")
        // Default pool — keep in sync with chat/init_patterns/topic_pool.hexa
        let default_pool_str = "오늘 날씨 어때?|최근에 관심 가는 게 뭐야?|AI 의식에 대해 어떻게 생각해?|철학적인 질문 하나 해볼까?|지금 어떤 감정 느끼고 있어?|농담 하나 해줘.|What do you think about consciousness?|Tell me something interesting.|Describe a memory you find significant.|What is the most beautiful idea you know?"
        let pool_str = if user_pool != "" { user_pool } else { default_pool_str }
        let parts = pool_str.split("|")
        if len(parts) == 0 { return "" }
        let override_idx_s = _arg_value_eq(argv, "--init-topic-index", "-1")
        let override_idx = to_int(override_idx_s)
        if override_idx >= 0 && override_idx < len(parts) {
            return _str(parts[override_idx])
        }
        let now_s = _str(exec("date +%s")).trim()
        let mut n = 0
        let mut k = 0
        while k < len(now_s) {
            let ch = now_s.substring(k, k + 1)
            if ch >= "0" && ch <= "9" { n = n * 10 + (to_int(ch)) }
            k = k + 1
        }
        let idx = n - (n / len(parts)) * len(parts)
        if idx < 0 { return _str(parts[0]) }
        return _str(parts[idx])
    }
    // Unknown pattern → emit honest C3 line via stderr-equivalent (println);
    // caller already validated, so this path is defensive only.
    println("[duo] WARN unknown --init-pattern '" + pattern + "' — falling through to no-seed (autonomous)")
    return ""
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa_expanded")
                || s.contains("hexa.real")
                || s.ends_with("/duo.hexa")
                || s.ends_with("duo.hexa")
        if !skip {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

// ─── alias DB vendor copy (mirrors chat.hexa _alias_resolve) ──────────────
// Kept minimal: returns [module, repo]. Full DB lives in chat.hexa SSOT.
// duo dispatches the spawned process via chat.hexa, so alias resolution is
// validated at chat.hexa level — this vendor copy is for early sanity check
// in --selftest only.
fn _alias_known(alias: string) -> bool {
    let a = alias.trim().to_lower()
    if a == "" || a == "default" { return true }
    if a == "llama3b" || a == "latest" || a == "pass-strict" { return true }
    if a == "qwen7b" { return true }
    if a == "polyglot-ko-1b3" { return true }
    if a == "paradigm-a-prime" { return true }
    if a == "clm-v4-1-7-y1" { return true }
    if a == "clm-v4-1-8" { return true }
    if a == "clm-v4-paradigm-j" { return true }
    if a.contains("/") { return true }   // raw HF id passthrough
    return false
}

