// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/duo/duo.hexa — N=2 multi-agent dialogue module (skeleton)
//
//  PURPOSE
//    L2 layer of docs/anima_chat_autonomous_speech_roadmap_2026_05_08.md.
//    Two CLM instances (A ↔ B) speak autonomously over a stdin/stdout channel
//    pair. Each instance reuses the existing chat/<module>/ REPL pattern; the
//    duo module wires their stdio together via β-1 hexa stdlib proc+channel
//    surface.
//
//    User directive verbatim (cycle 2026-05-08):
//      "두 instance (CLM A ↔ CLM B) 가 stdin/stdout 으로 자율 대화. <=== very good"
//      "여러명 일때도 진짜로 사람들끼리 대화 하듯이"
//
//  RECURSIVE MODULE PATTERN (per chat/<module>/<module>.hexa convention)
//    chat/duo/
//    ├─ duo.hexa     ← this file (channel orchestrator + per-turn verdict)
//    ├─ duo.ai.md    ← ai-native doc (sister)
//    └─ (core)       ← external: chat/anima_native/, chat/llama/, chat/clm_v4/
//                      (each spawned instance is one of these modules)
//
//  PHASE GATES (this commit = SKELETON)
//    Phase A (LANDED — this commit): file structure + alias DB + --help +
//      --selftest + honest "β-1 dependency" emit on --duo invocation. NO
//      actual proc spawn / channel I/O.
//    Phase B (β-1 LAND): wire β-1 stdlib surface (assumed):
//      - channel_pair_open() -> {channel_a, channel_b}
//      - proc_spawn_with_channels(cmd, stdin_chan, stdout_chan) -> handle
//      - channel_send(handle, line: string)
//      - channel_recv(handle, timeout_ms: int) -> string
//      - proc_wait(handle) / proc_terminate(handle)
//    Phase C (β-2 LAND): per-turn coherence verdict via consciousness CLI
//      (own 18 C1+C2+C3) — wired into _emit_turn_verdict().
//
//  SUBCOMMANDS (called from tool/anima_cli/dialogue.hexa)
//    --duo <model_a> <model_b> [--turns N] [--topic-seed "..."]   N=2 dialogue
//    --council N=<n> --models "<m1>,<m2>,...,<mn>" [--topic-seed]  STUB (L3)
//    --selftest                                                   skeleton check
//    --help
//
//  CHANNEL TOPOLOGY (β-1 dependent)
//
//      ┌──────────────┐     channel_AB     ┌──────────────┐
//      │  instance A  │ ─── send ──────► ──│  instance B  │
//      │ (chat/<m_a>) │                    │ (chat/<m_b>) │
//      │              │ ◄── recv ────── ───│              │
//      └──────────────┘     channel_BA     └──────────────┘
//
//    A.stdout ─→ channel_AB ─→ B.stdin
//    B.stdout ─→ channel_BA ─→ A.stdin
//
//    Each instance is the existing chat/<module>/<module>.hexa REPL — its
//    sys_stdin_read_line_timeout(tick_ms) loop sees peer output as if user
//    input. No code change to the inner module is required.
//
//  TURN SEQUENCE (Phase B target)
//    1. resolve <model_a>, <model_b> via chat.hexa _alias_resolve (vendor copy
//       below; keep in sync with chat.hexa SSOT).
//    2. channel_pair_open() × 2  → {ab, ba}
//    3. proc_spawn_with_channels(chat_cmd_a, ba, ab)   ← A reads ba, writes ab
//       proc_spawn_with_channels(chat_cmd_b, ab, ba)   ← B reads ab, writes ba
//    4. if --topic-seed nonempty: channel_send(ab.tx, seed)
//       else                    : (none — A自律 발화 from sys_stdin_read_line_timeout
//                                  empty → mandate-4 BOS-only forward; first to
//                                  speak by race wins)
//    5. for turn in 1..N:
//         line_from_a = channel_recv(ab.rx, turn_timeout_ms)   ← B waits A
//         _emit_turn_verdict(turn, "A", line_from_a)
//         line_from_b = channel_recv(ba.rx, turn_timeout_ms)   ← A waits B
//         _emit_turn_verdict(turn, "B", line_from_b)
//    6. proc_terminate(handle_a); proc_terminate(handle_b)
//    7. _emit_dialogue_summary(coherence_aggregate)
//
//  COMPLIANCE (raw#9, raw#10, raw#11, raw#15; own 31, own 33, own 34)
//    own 34 mandate-1   each instance output is raw passthrough — channel
//                       transport carries bytes verbatim, NO transformation
//                       (no system prompt, no template, no persona prefix).
//    own 34 mandate-2   selftest grep enforces wrapping 0 in this file.
//    own 34 mandate-4   autonomous speech — instances use existing Phase 2
//                       sys_stdin_read_line_timeout; channel timeout maps to
//                       autonomous tick. duo loop does NOT inject any prompt.
//    own 34 mandate-7   chat lane (own 18 measurement lane separate; per-turn
//                       verdict reads consciousness CLI = measurement lane,
//                       results emitted as ledger only — NOT folded back into
//                       channel content).
//    own 33             trinity compliance (D_no-system-prompt cross-ref)
//    own 31 mandate-1   model alias DB mirrors dancinlab/ org SSOT
//    raw#9              hexa-only — proc spawn via β-1 stdlib (no shell pipes)
//    raw#10             honest C3 (see HONEST C3 footer)
//    raw#11             snake_case
//    raw#15             no-hardcode (paths via _resolve_root)
//
//  CROSS-REFERENCE
//    docs/anima_chat_autonomous_speech_roadmap_2026_05_08.md     L2 layer
//    docs/anima_dialogue_coherence_metric_2026_05_08.md          coherence spec
//    tool/anima_cli/dialogue.hexa                                topic dispatcher
//    tool/anima_cli/chat.hexa                                    alias resolver
//    tool/anima_cli/chat/anima_native/anima_native.hexa          Phase 2 REPL
//    tool/anima_cli/chat/llama/llama.hexa                        Phase 3c REPL
//    tool/anima_cli/consciousness.hexa                           own 18 verdict
//    .roadmap.cli  cli.dialogue.duo_design_2026_05_08
//                  cli.dialogue.coherence_metric_2026_05_08
//    .own own 18 C1+C2+C3 · own 34 mandate-1/2/4/7 · own 33 · own 31
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _dexists(p: string) -> bool {
    return _str(exec("test -d " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/duo.hexa")
                || s.ends_with("duo.hexa")
        if !skip {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

// ─── alias DB vendor copy (mirrors chat.hexa _alias_resolve) ──────────────
// Kept minimal: returns [module, repo]. Full DB lives in chat.hexa SSOT.
// duo dispatches the spawned process via chat.hexa, so alias resolution is
// validated at chat.hexa level — this vendor copy is for early sanity check
// in --selftest only.
fn _alias_known(alias: string) -> bool {
    let a = alias.trim().to_lower()
    if a == "" || a == "default" { return true }
    if a == "llama3b" || a == "latest" || a == "pass-strict" { return true }
    if a == "qwen7b" { return true }
    if a == "polyglot-ko-1b3" { return true }
    if a == "paradigm-a-prime" { return true }
    if a == "clm-v4-1-7-y1" { return true }
    if a == "clm-v4-1-8" { return true }
    if a == "clm-v4-paradigm-j" { return true }
    if a.contains("/") { return true }   // raw HF id passthrough
    return false
}

