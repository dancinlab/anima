// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/transports/beta1_channel.hexa — β-1 channel pair transport
//
//  PURPOSE
//    Transport plugin for chat/duo/duo.hexa β-1 channel-pair sibling pattern.
//    Documents + smoke-tests the bidirectional AI↔AI dialogue transport used
//    for `anima dialogue --duo <a> <b>` and `--trio <a> <b> <c>`. NOT a
//    re-implementation — duo.hexa _channel_pair_open / _spawn_instance
//    retain SSOT.
//
//  PATTERN SUMMARY (sibling-to-sibling A↔B per channel.ai.md recipe)
//    1. ab = channel_pair_open()  (A→B forward channel)
//       ba = channel_pair_open()  (B→A return channel)
//    2. spawn A FIRST: proc_spawn_with_channels(cmd_A, ba.tx, ab.rx)
//       spawn B SECOND: proc_spawn_with_channels(cmd_B, ab.tx, ba.rx)
//       (spawn-before-send avoids macOS BSD FIFO last-writer-close byte loss)
//    3. optional topic_seed → channel_send(ab.tx, seed)
//    4. per-turn: channel_recv(ab.rx) for A; channel_recv(ba.rx) for B
//    5. tear-down: kill children + channel_close ×4
//
//  USE CASES
//    · chat/duo/duo.hexa AI↔AI dialogue (Phase B iter 2 LANDED 2026-05-08)
//    · chat/trio/trio.hexa 3-way round-robin (Phase A LANDED 2026-05-09)
//    · ai-duo / ai-trio benchmark modes
//
//  HONEST C3
//    · same-GGUF concurrent-mmap → llama.cpp Abort trap: 6 (turn=2);
//      duo.hexa default rejects same-alias (--allow-same-gguf override).
//    · macOS BSD FIFO: send-before-spawn drops bytes (channel.ai.md C2).
//
//  COMPLIANCE
//    own 34 mandate-1 — bytes verbatim through FIFO ×2 (no transformation)
//    own 34 mandate-7 — verdict cells emit-only, never folded back into channel
//    raw#9 — hexa-only (β-1 stdlib + proc_spawn; no shell pipes)
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/channel"

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn transport_describe() -> string {
    return "beta1-channel — β-1 channel pair (channel_pair_open ×2 + proc_spawn_with_channels) sibling-to-sibling AI↔AI bidirectional dialogue (chat/duo SSOT; same-GGUF guard active)"
}

// transport_smoke — benchmark hook. Validates dual channel pair allocation
// (the duo topology requirement). NO actual proc spawn — that requires real
// chat module + GGUF, lane-orthogonal benchmark scope.
fn transport_smoke(repo: string, argv) -> int {
    let ab = channel_pair_open()
    if len(ab) < 2 || ab[0] < 0 || ab[1] < 0 { return 2 }
    let ba = channel_pair_open()
    if len(ba) < 2 || ba[0] < 0 || ba[1] < 0 {
        let _x1 = channel_close(ab[0])
        let _x2 = channel_close(ab[1])
        return 3
    }
    // Round-trip on each pair to validate independent inode allocation.
    let _s1 = channel_send(ab[1], "ab_smoke")
    let line_ab = _str(channel_recv(ab[0], 1000))
    let _s2 = channel_send(ba[1], "ba_smoke")
    let line_ba = _str(channel_recv(ba[0], 1000))
    let _c1 = channel_close(ab[0])
    let _c2 = channel_close(ab[1])
    let _c3 = channel_close(ba[0])
    let _c4 = channel_close(ba[1])
    if line_ab.trim() != "ab_smoke" || line_ba.trim() != "ba_smoke" { return 4 }
    println("[transport:beta1-channel] smoke PASS — dual channel pair (ab+ba) round-trip OK")
    return 0
}

fn main() {
    let argv = args()
    if _arg_present(argv, "--describe") {
        println(transport_describe())
        return
    }
    if _arg_present(argv, "--selftest") || _arg_present(argv, "--smoke") {
        let rc = transport_smoke("", argv)
        if rc != 0 {
            println("FAIL transport beta1-channel smoke (rc=" + to_string(rc) + ")")
            exit(rc)
        }
        return
    }
    println(transport_describe())
}
