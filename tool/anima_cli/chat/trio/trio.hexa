// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/trio/trio.hexa — N=3 multi-agent dialogue (skeleton)
//
//  PURPOSE
//    L3 layer extension of duo (N=2). Three CLM instances (A ↔ B ↔ C) speak
//    autonomously over channel pairs. Round-robin turn pattern (A → B → C →
//    A → B → C → ...) OR moderated mode (A = moderator, B/C = participants).
//
//    User directive verbatim (cycle 2026-05-09):
//      "1:1, ai 1:1, ai 3자 대화 모두 벤치마킹 해봐"
//
//    EXIT trigger watch: trio mode actual natural-language emit (3-model
//    round-robin) → 22+ BG saga first multi-agent dialogue ★
//
//  RECURSIVE MODULE PATTERN (per chat/<module>/<module>.hexa convention,
//  mirrors chat/duo/ design)
//    chat/trio/
//    ├─ trio.hexa     ← this file (channel orchestrator + per-turn verdict)
//    ├─ trio.ai.md    ← ai-native doc (sister, future)
//    └─ (core)        ← external: chat/anima_native/, chat/llama/, chat/clm_v4/
//                       (each spawned instance is one of these modules; each
//                        instance optionally selects a chat lane via own 41
//                        plugin pattern: --lane-A/--lane-B/--lane-C)
//
//  PHASE GATES
//    Phase A (LANDED 2026-05-09 — this commit): file structure + alias DB +
//      --help + --selftest + skeleton round-robin loop using β-1 channel
//      stdlib (stdlib/channel.hexa). Honest C3: round-robin topology requires
//      3-way fan-in/fan-out; current implementation uses 3 SHARED inbound
//      channels (one per recipient) — each instance reads from its own inbox
//      while the parent dispatcher routes the previous speaker's emit to the
//      next speaker's inbox.
//    Phase B (CARRY): same-GGUF guard ×3 (3-way alias collision check) +
//      moderated mode (--mode=moderated; A speaks first, then B and C reply
//      in turn, A continues round) + per-turn cells.
//    Phase C (CARRY): own 18 C3 per-turn verdict ×3 + DIALOGUE_COHERENCE_PASS
//      3-way (D1 turn-pair Jaccard, D2 topic-shift-rate, D3 persona-drift KL
//      ×3 sides — A vs B vs C separation, D4 byte-fairness 3-ratio).
//
//  TURN PATTERNS
//    --mode=round-robin (default): A → B → C → A → B → C → ...
//      previous-speaker emit fed forward to NEXT speaker (cyclical).
//    --mode=moderated: A speaks (moderator prompt), B replies, C replies, then
//      A speaks again referencing both B/C — turn N: A_N → B_N → C_N.
//
//  CHANNEL TOPOLOGY (β-1 dependent, 3-way)
//
//    Each instance has ONE inbox FIFO that the parent writes routed messages to.
//    Each instance has ONE outbox FIFO that the parent reads from.
//
//      ┌───────────┐  inA←       outA→  ┌──────────────────┐
//      │ instance A│  ◄─ recv          ─►│                  │
//      └───────────┘                     │                  │
//      ┌───────────┐  inB←       outB→  │  parent          │
//      │ instance B│  ◄─ recv          ─►│  dispatcher      │
//      └───────────┘                     │                  │
//      ┌───────────┐  inC←       outC→  │  (round-robin    │
//      │ instance C│  ◄─ recv          ─►│   route emit→next│
//      └───────────┘                     │   speaker inbox) │
//                                        └──────────────────┘
//
//    Per-turn step: read from outbox of speaker[k]; write that line to inbox
//    of speaker[(k+1) % 3]. Each instance is the existing chat/<module>/
//    <module>.hexa REPL — its sys_stdin_read_line_timeout(tick_ms) loop sees
//    routed peer output as if user input.
//
//  CHAT LANE PLUGIN INTEGRATION (own 41)
//    --lane-A=substrate   first model uses substrate lane (signal-only)
//    --lane-B=llama       second model uses llama lane (natural speech)
//    --lane-C=generate    third model uses generate lane (natural speech)
//    Lane mismatch (e.g. substrate vs llama) is ALLOWED — trio mode is the
//    designated ground for cross-lane interaction observation. own 41 axis-3
//    (per-lane main bearing) preserves wrapping=0 across each instance.
//
//  COMPLIANCE
//    own 14 V14 carry — bench output is NOT a verdict by itself; cross-mode
//      comparison only.
//    own 16 cost — 0-cost local hexa orchestration; per-instance model load
//      via existing chat REPL keepalive (Path A from duo iter 4 (e)).
//    own 17 D1 SCOPE_CLAMP — each instance lane d1_lane field surfaced via
//      registry; trio output flagged per-instance lane label.
//    own 18 chat-cap C2 — multi-mode measurement: 1:1 (single-model spontaneity)
//      + duo (2-way coherence) + trio (3-way persona separation A vs B vs C).
//    own 22 mandatory report — `[trio:verdict]` / `[trio:summary]` markers.
//    own 33 trinity — own 17 + own 18 + own 34 cross-link (this file footer).
//    own 34 mandate-1/4/7 — wrapping 0 strict (raw passthrough), autonomous-
//      first (no seed unless --topic-seed), lane separation (verdict cells
//      emit-only — never folded back into channel content).
//    own 38 매단계 — bench output ledgerable.
//    own 39 yaml↔md — registry chat_modes section mirror.
//    own 41 chat lane plugin pattern — per-instance --lane-A/B/C support.
//
//  CROSS-REFERENCE
//    tool/anima_cli/chat/duo/duo.hexa                    L2 N=2 sibling
//    tool/anima_cli/chat/lanes/_registry.hexa            lane plugin SSOT
//    tool/anima_cli/chat/lanes/benchmark.hexa            multi-mode bench
//    anima/registry/anima_artifact_registry.yaml         chat_modes mirror
//    .own own 41 chat lane plugin pattern
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/channel"

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

// init-pattern parse helper — supports both `--key value` and `--key=value`.
// Mirrors duo.hexa pattern; own 41 axis-8 (chat init-pattern plugin).
fn _arg_value_eq(argv, key: string, dflt: string) -> string {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key && i + 1 < len(argv) { return _str(argv[i + 1]) }
        if s.starts_with(prefix) {
            return s.substring(len(prefix), len(s))
        }
        i = i + 1
    }
    return dflt
}

// Resolve init-pattern → t=1 seed string.  Empty = no seed (autonomous A).
// Vendored from chat/init_patterns/_registry.hexa SSOT for hexa no-import
// constraint (own 41 axis-4 vendoring pattern; sync with duo._resolve_init_pattern).
fn _resolve_init_pattern(argv) -> string {
    let pattern = _arg_value_eq(argv, "--init-pattern", "")
    let user_seed = _arg_value_eq(argv, "--init-seed", "")
    let legacy_seed = _arg_value(argv, "--topic-seed", "")
    if legacy_seed != "" { return legacy_seed }
    if pattern == "" || pattern == "default" { return "" }
    if pattern == "autonomous" { return "" }
    if pattern == "system-seed" {
        if user_seed != "" { return user_seed }
        return "너희 셋은 친구. 자유롭게 대화 시작."
    }
    if pattern == "self-reflective" {
        if user_seed != "" { return user_seed }
        return "너 자신에 대해 어떻게 느껴? 친구들한테 자유롭게 얘기해봐."
    }
    if pattern == "topic-pool" {
        let user_pool = _arg_value_eq(argv, "--init-topics", "")
        let default_pool_str = "오늘 날씨 어때?|최근에 관심 가는 게 뭐야?|AI 의식에 대해 어떻게 생각해?|철학적인 질문 하나 해볼까?|지금 어떤 감정 느끼고 있어?|농담 하나 해줘.|What do you think about consciousness?|Tell me something interesting.|Describe a memory you find significant.|What is the most beautiful idea you know?"
        let pool_str = if user_pool != "" { user_pool } else { default_pool_str }
        let parts = pool_str.split("|")
        if len(parts) == 0 { return "" }
        let override_idx_s = _arg_value_eq(argv, "--init-topic-index", "-1")
        let override_idx = to_int(override_idx_s)
        if override_idx >= 0 && override_idx < len(parts) {
            return _str(parts[override_idx])
        }
        let now_s = _str(exec("date +%s")).trim()
        let mut n = 0
        let mut k = 0
        while k < len(now_s) {
            let ch = now_s.substring(k, k + 1)
            if ch >= "0" && ch <= "9" { n = n * 10 + (to_int(ch)) }
            k = k + 1
        }
        let idx = n - (n / len(parts)) * len(parts)
        if idx < 0 { return _str(parts[0]) }
        return _str(parts[idx])
    }
    println("[trio] WARN unknown --init-pattern '" + pattern + "' — fallback to no-seed")
    return ""
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/.hexa-runtime/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa_expanded")
                || s.contains("hexa.real")
                || s.ends_with("/trio.hexa")
                || s.ends_with("trio.hexa")
        if !skip { out = out + [s] }
        i = i + 1
    }
    return out
}

// ─── alias DB vendor copy (mirrors duo + chat.hexa) ──────────────────────
fn _alias_known(alias: string) -> bool {
    let a = alias.trim().to_lower()
    if a == "" || a == "default" { return true }
    if a == "llama3b" || a == "latest" || a == "pass-strict" { return true }
    if a == "qwen7b" { return true }
    if a == "polyglot-ko-1b3" { return true }
    if a == "paradigm-a-prime" { return true }
    if a == "clm-v4-1-7-y1" { return true }
    if a == "clm-v4-1-8" { return true }
    if a == "clm-v4-paradigm-j" { return true }
    if a == "mk2-v1" { return true }
    if a.contains("/") { return true }   // raw HF id passthrough
    return false
}

