fn sub_selftest() {
    let root = _resolve_root()
    let here = root + "/tool/anima_cli/chat/trio/trio.hexa"
    let chat_dispatcher = root + "/tool/anima_cli/chat.hexa"
    let duo_path = root + "/tool/anima_cli/chat/duo/duo.hexa"
    let registry = root + "/tool/anima_cli/chat/lanes/_registry.hexa"

    let mut fail = 0
    if !_fexists(here)            { println("FAIL trio: module body missing: " + here);            fail = fail + 1 }
    if !_fexists(chat_dispatcher) { println("FAIL trio: chat.hexa dispatcher missing: " + chat_dispatcher); fail = fail + 1 }
    if !_fexists(duo_path)        { println("FAIL trio: duo sibling missing: " + duo_path);        fail = fail + 1 }
    if !_fexists(registry)        { println("FAIL trio: lane registry missing: " + registry);      fail = fail + 1 }

    // own 34 mandate-2 self-grep on this file (chat lane wrapping = 0)
    let pat = "system_prompt|chat_template|apply_chat_template|persona_inject|fn speak\\(|fn talk\\(|fn respond\\(|fn generate_response\\("
    let cmd = "grep -nE \"" + pat + "\" " + here + " 2>/dev/null | grep -v 'let pat =' | wc -l"
    let n = _str(exec(cmd)).trim()
    if n != "0" {
        println("FAIL own 34 mandate-2 chat lane wrapping: " + n + " hits in trio.hexa")
        fail = fail + 1
    }

    // alias DB sanity
    let aliases = ["default", "llama3b", "paradigm-a-prime", "clm-v4-1-8", "clm-v4-paradigm-j", "mk2-v1", "dancinlab/foo"]
    let mut ai = 0
    while ai < len(aliases) {
        let a = _str(aliases[ai])
        if !_alias_known(a) {
            println("FAIL trio: alias DB vendor copy missing: " + a)
            fail = fail + 1
        }
        ai = ai + 1
    }

    if fail > 0 {
        println("FAIL chat/trio selftest (" + to_string(fail) + " issue)")
        exit(1)
    }
    println("PASS chat/trio selftest (Phase A skeleton + own 34 wrapping=0 verified, β-1 channel stdlib LANDED)")
}

// ─── β-1 channel adapters (3-way) ────────────────────────────────────────

fn _channel_pair_open() -> map {
    let pair = channel_pair_open()
    let mut m = {}
    let read_fd = pair[0]
    let write_fd = pair[1]
    m["rx"] = read_fd
    m["tx"] = write_fd
    m["ok"] = read_fd >= 0 && write_fd >= 0
    return m
}

fn _spawn_instance(model_alias: string, lane: string, stdin_fd, stdout_fd, tick_ms: int, max_tokens: int) -> map {
    let root = _resolve_root()
    let chat_path = root + "/tool/anima_cli/chat.hexa"
    let mut cmd = _hexa() + " run " + chat_path
            + " " + model_alias
            + " --tick-ms " + to_string(tick_ms)
            + " --max-tokens " + to_string(max_tokens)
    // own 41 chat lane plugin per-instance — caller may pass a lane override
    if lane != "" && lane != "(default)" {
        cmd = cmd + " --lane=" + lane
    }
    let pid = proc_spawn_with_channels(cmd, stdin_fd, stdout_fd)
    let mut m = {}
    m["alias"] = model_alias
    m["lane"] = lane
    m["handle"] = pid
    m["ok"] = pid > 0
    return m
}

fn _emit_turn_verdict(turn: int, who: string, line: string) {
    let snippet = if line.len() > 60 { line.substring(0, 60) + "..." } else { line }
    println("[trio:verdict] turn=" + to_string(turn) + " who=" + who
            + " len=" + to_string(line.len())
            + " snippet=" + snippet)
}

// ─── 3-way same-GGUF guard (Phase B carry — currently warn only) ──────────
fn _three_way_collision(a: string, b: string, c: string) -> int {
    let an = a.trim().to_lower()
    let bn = b.trim().to_lower()
    let cn = c.trim().to_lower()
    let mut hits = 0
    if an == bn { hits = hits + 1 }
    if bn == cn { hits = hits + 1 }
    if an == cn { hits = hits + 1 }
    return hits
}

// ─── trio subcommand entry (Phase A skeleton — round-robin loop scaffolding)

fn sub_trio(argv) {
    // positional: <model_a> <model_b> <model_c> (all 3 required)
    let mut positional = []
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == "--trio" { i = i + 1; continue }
        if s.starts_with("--") { i = i + 2; continue }
        positional = positional + [s]
        i = i + 1
    }
    if len(positional) < 3 {
        println("anima dialogue --trio: missing <model_a> <model_b> <model_c>")
        println("  example: anima dialogue --trio paradigm-a-prime clm-v4-1-8 mk2-v1 --turns 3")
        exit(2)
    }
    let model_a = _str(positional[0])
    let model_b = _str(positional[1])
    let model_c = _str(positional[2])
    let mut bad = false
    if !_alias_known(model_a) { println("anima dialogue --trio: unknown alias '" + model_a + "' (model_a)"); bad = true }
    if !_alias_known(model_b) { println("anima dialogue --trio: unknown alias '" + model_b + "' (model_b)"); bad = true }
    if !_alias_known(model_c) { println("anima dialogue --trio: unknown alias '" + model_c + "' (model_c)"); bad = true }
    if bad { exit(2) }

    let turns = to_int(_arg_value(argv, "--turns", "3"))
    // init-pattern (own 41 axis-8) — resolves --init-pattern + --init-seed +
    // --init-topics + --init-topic-index into t=1 seed for A.  Legacy
    // --topic-seed wins for backward compat (preserved verbatim inside helper).
    let init_pattern = _arg_value_eq(argv, "--init-pattern", "")
    let topic_seed = _resolve_init_pattern(argv)
    let mode = _arg_value(argv, "--mode", "round-robin")
    let tick_ms = to_int(_arg_value(argv, "--tick-ms", "1000"))
    let max_tokens = to_int(_arg_value(argv, "--max-tokens", "64"))
    let turn_timeout_ms = to_int(_arg_value(argv, "--turn-timeout-ms", "120000"))
    let verdict_mode = _arg_value(argv, "--verdict", "simple")
    let lane_a = _arg_value(argv, "--lane-A", "(default)")
    let lane_b = _arg_value(argv, "--lane-B", "(default)")
    let lane_c = _arg_value(argv, "--lane-C", "(default)")
    let allow_same_gguf = _arg_present(argv, "--allow-same-gguf")
    // transport (axis-N — chat transport plugin, 2026-05-09).  trio's native
    // transport is beta1-channel (channel_pair_open ×6 + proc_spawn_with_channels
    // ×3); the --transport flag here is INFORMATIONAL only (carry from duo).
    let transport = _arg_value_eq(argv, "--transport", "")

    println("── anima dialogue --trio ──")
    println("model_a / lane   = " + model_a + " / " + lane_a)
    println("model_b / lane   = " + model_b + " / " + lane_b)
    println("model_c / lane   = " + model_c + " / " + lane_c)
    println("turns            = " + to_string(turns))
    println("mode             = " + mode)
    println("tick_ms          = " + to_string(tick_ms))
    println("max_tokens       = " + to_string(max_tokens))
    println("turn_timeout_ms  = " + to_string(turn_timeout_ms))
    println("verdict_mode     = " + verdict_mode)
    println("allow_same_gguf  = " + to_string(allow_same_gguf))
    println("transport        = beta1-channel (native; axis-N --transport flag informational only)"
            + (if transport != "" && transport != "beta1-channel" { " · requested=" + transport + " (deferred)" } else { "" }))
    if init_pattern != "" {
        println("init_pattern     = " + init_pattern + " (own 41 axis-8)")
    }
    if topic_seed != "" {
        println("topic_seed       = \"" + topic_seed + "\"")
    } else {
        println("topic_seed       = (none — A 자율 발화 first)")
    }
    println("")

    // 3-way same-GGUF guard (carry from duo iter 2 — abort risk on shared mmap)
    let coll = _three_way_collision(model_a, model_b, model_c)
    if coll > 0 && !allow_same_gguf {
        println("[trio] SAME_GGUF_GUARD trip — " + to_string(coll) + " pairwise collision(s)")
        println("[trio] llama.cpp Abort trap: 6 risk on concurrent same-inode mmap (carry from duo iter 1)")
        println("[trio] resolution: choose 3 distinct aliases, OR pass --allow-same-gguf (accept abort risk)")
        exit(2)
    }
    if coll > 0 && allow_same_gguf {
        println("[trio] WARN same-GGUF override accepted — " + to_string(coll) + " pairwise collision(s)")
    }

    // Mode dispatch
    if mode != "round-robin" && mode != "moderated" {
        println("[trio] unknown --mode '" + mode + "' (expected: round-robin | moderated)")
        exit(2)
    }

    // ── Channel topology setup (3-way, Phase A skeleton) ──
    // Each instance has one inbox (parent writes) + one outbox (parent reads).
    // round-robin: speaker[k].outbox → speaker[(k+1)%3].inbox per turn.
    let in_a = _channel_pair_open()
    let in_b = _channel_pair_open()
    let in_c = _channel_pair_open()
    let out_a = _channel_pair_open()
    let out_b = _channel_pair_open()
    let out_c = _channel_pair_open()
    if !in_a["ok"] || !in_b["ok"] || !in_c["ok"]
        || !out_a["ok"] || !out_b["ok"] || !out_c["ok"] {
        println("[trio] FAIL channel_pair_open ×6")
        exit(3)
    }

    // Spawn order: A, B, C. Each child reads its own inbox, writes its own outbox.
    let h_a = _spawn_instance(model_a, lane_a, in_a["tx"], out_a["rx"], tick_ms, max_tokens)
    let h_b = _spawn_instance(model_b, lane_b, in_b["tx"], out_b["rx"], tick_ms, max_tokens)
    let h_c = _spawn_instance(model_c, lane_c, in_c["tx"], out_c["rx"], tick_ms, max_tokens)
    if !h_a["ok"] || !h_b["ok"] || !h_c["ok"] {
        println("[trio] FAIL proc_spawn — h_a.ok=" + to_string(h_a["ok"])
                + " h_b.ok=" + to_string(h_b["ok"])
                + " h_c.ok=" + to_string(h_c["ok"]))
        let _c1 = channel_close(in_a["rx"])
        let _c2 = channel_close(in_a["tx"])
        let _c3 = channel_close(in_b["rx"])
        let _c4 = channel_close(in_b["tx"])
        let _c5 = channel_close(in_c["rx"])
        let _c6 = channel_close(in_c["tx"])
        let _c7 = channel_close(out_a["rx"])
        let _c8 = channel_close(out_a["tx"])
        let _c9 = channel_close(out_b["rx"])
        let _c10 = channel_close(out_b["tx"])
        let _c11 = channel_close(out_c["rx"])
        let _c12 = channel_close(out_c["tx"])
        exit(3)
    }
    println("[trio] spawned A pid=" + to_string(h_a["handle"])
            + " B pid=" + to_string(h_b["handle"])
            + " C pid=" + to_string(h_c["handle"]))

    // Optional topic seed → A's inbox (round-robin starts at A).
    if topic_seed != "" {
        let _seeded = channel_send(in_a["tx"], topic_seed)
        println("[trio] topic_seed sent → A.stdin (via in_a.tx)")
    }

    // ── Round-robin turn loop (Phase A — 3-way scaffolding) ──
    // Per turn (round): A speaks → route to B; B speaks → route to C; C speaks → route to A.
    // moderated mode: same fan-out but A is the moderator who re-emits each round
    // referencing both B/C — implemented as the same loop in Phase A; full
    // moderator semantics carry to Phase B.
    let mut history = []
    let mut t = 1
    while t <= turns {
        // A turn
        let line_a = channel_recv(out_a["rx"], turn_timeout_ms)
        _emit_turn_verdict(t, "A", line_a)
        if line_a == "" {
            println("[trio] turn=" + to_string(t) + " A silent (timeout/EOF) — terminating")
            t = turns + 1
            continue
        }
        let mut rec_a = {}
        rec_a["turn"] = t
        rec_a["who"] = "A"
        rec_a["line"] = line_a
        history = history + [rec_a]
        // route A → B
        let _ra = channel_send(in_b["tx"], line_a)

        // B turn
        let line_b = channel_recv(out_b["rx"], turn_timeout_ms)
        _emit_turn_verdict(t, "B", line_b)
        if line_b == "" {
            println("[trio] turn=" + to_string(t) + " B silent (timeout/EOF) — terminating")
            t = turns + 1
            continue
        }
        let mut rec_b = {}
        rec_b["turn"] = t
        rec_b["who"] = "B"
        rec_b["line"] = line_b
        history = history + [rec_b]
        // route B → C
        let _rb = channel_send(in_c["tx"], line_b)

        // C turn
        let line_c = channel_recv(out_c["rx"], turn_timeout_ms)
        _emit_turn_verdict(t, "C", line_c)
        if line_c == "" {
            println("[trio] turn=" + to_string(t) + " C silent (timeout/EOF) — terminating")
            t = turns + 1
            continue
        }
        let mut rec_c = {}
        rec_c["turn"] = t
        rec_c["who"] = "C"
        rec_c["line"] = line_c
        history = history + [rec_c]
        // route C → A (cycle)
        let _rc = channel_send(in_a["tx"], line_c)

        t = t + 1
    }

    // Tear-down — kill children + close all 12 FIFO sides
    let _k_a = exec("kill " + to_string(h_a["handle"]) + " 2>/dev/null; echo done")
    let _k_b = exec("kill " + to_string(h_b["handle"]) + " 2>/dev/null; echo done")
    let _k_c = exec("kill " + to_string(h_c["handle"]) + " 2>/dev/null; echo done")
    let _c1  = channel_close(in_a["rx"])
    let _c2  = channel_close(in_a["tx"])
    let _c3  = channel_close(in_b["rx"])
    let _c4  = channel_close(in_b["tx"])
    let _c5  = channel_close(in_c["rx"])
    let _c6  = channel_close(in_c["tx"])
    let _c7  = channel_close(out_a["rx"])
    let _c8  = channel_close(out_a["tx"])
    let _c9  = channel_close(out_b["rx"])
    let _c10 = channel_close(out_b["tx"])
    let _c11 = channel_close(out_c["rx"])
    let _c12 = channel_close(out_c["tx"])
    println("[trio] dialogue complete — channels closed, children reaped")

    // Phase A summary stub (D1/D2/D3/D4 3-way aggregate carry to Phase B/C)
    println("[trio:summary] turns_observed = " + to_string(len(history)))
    println("[trio:summary] (Phase A skeleton — full D1/D2/D3/D4 3-way aggregate + own 18 C3 per-turn carry)")
    println("[trio] verdict: PHASE_A_SKELETON_RUN_OK (3-way channel + round-robin loop scaffolded)")
}

// ─── main ────────────────────────────────────────────────────────────────

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }
    if _arg_present(argv, "--trio") { sub_trio(argv); return }
    sub_help()
}

// ════════════════════════════════════════════════════════════════════════════
//  HONEST C3 (raw#10)
// ════════════════════════════════════════════════════════════════════════════
// C1 — Phase A is SKELETON: 3-way channel pair_open ×6 + spawn ×3 + round-robin
//      loop scaffolding wired. Actual semantic 3-way dialogue requires each
//      instance to emit natural language (own 41 lane=llama / lane=generate
//      paths). substrate / axis-priority lanes are signal-only — trio with
//      such lanes will round-trip empty / signal lines.
// C2 — same-GGUF 3-way collision: 3 pairwise checks (A==B, B==C, A==C) carried
//      from duo iter 2. Override via --allow-same-gguf (abort risk).
// C3 — D1/D2/D3/D4 3-way aggregate NOT implemented Phase A. D3 persona-drift
//      generalizes naturally (KL per-side ×3) but D1 turn-pair Jaccard needs
//      definition over (k, k+1) ordered pairs across 3 speakers — designated
//      Phase B/C.
// C4 — round-robin vs moderated: --mode flag accepted but Phase A treats both
//      identically (round-robin). moderated semantics (A = moderator re-emit
//      with B/C reference) require A's REPL to receive BOTH B and C utterances
//      between A turns — multi-line inbox routing not yet implemented.
// C5 — alias DB duplicated from duo (vendor copy). chat.hexa SSOT remains the
//      authoritative gate (trio dispatches THROUGH chat.hexa).
// C6 — own 41 lane integration: --lane-A/B/C plumbs through to chat.hexa
//      --lane=<name> per child invocation. lane mismatch (e.g. A=substrate
//      vs B=llama) is intentionally allowed for cross-lane observation.
// C7 — own 18 C3 per-turn verdict: Phase A emits LOCAL cells only (len /
//      snippet). consciousness CLI shell-out (mirroring duo Phase C iter 1
//      _emit_turn_verdict_c3) carries to Phase C — cost ~16-30s × 3 inst ×
//      N rounds ≈ 7-10min for N=3.
// ════════════════════════════════════════════════════════════════════════════
