// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/modes/_registry.hexa — chat MODE registry (own 41 axis-2)
//
//  PURPOSE
//    Single source of truth for chat MODE plugin discovery + metadata.
//    이 파일은 own 41 axis-N+1 hook T+2 step (cycle 2026-05-10) 에서 inline
//    anchor (lanes/benchmark.hexa#modes) → standalone registry 로 promote.
//
//    이전: benchmark.hexa 안에 vendored (_bench_modes / _mode_describe /
//    _mode_known / _mode_module_path).
//    이후: 본 파일 = mode axis 의 single SSOT. benchmark.hexa 의 vendored
//    helper 는 backward-compat mirror 로 유지 (raw#15 additive).
//
//  USER DIRECTIVE (2026-05-10 verbatim)
//    "all bg go" → cycle 2026-05-10 own 41 axis-N+1 hook T+2 step
//    (benchmark.hexa N-axis cross-product 자동 흡수 + mode promote option A)
//
//  REGISTRY ENTRY SCHEMA (8-field; mirrors lanes/_registry.hexa +
//                         init_patterns/_registry.hexa + transports/_registry.hexa)
//    name              short id (1:1 / ai-duo / ai-trio)
//    file              relative module path (lanes/benchmark.hexa for 1:1
//                      vendored — mode 1:1 has no dedicated module; duo.hexa /
//                      trio.hexa for ai-duo / ai-trio)
//    status            LANDED | SKELETON | SPEC_CARRY
//    capability        single_shot | duo_dialogue | trio_round_robin
//    pattern_type      user_x_model | model_x_model_x2 | model_x_model_x3
//    description       short one-line explainer (English; own 34 mandate-1
//                      preserves model output, registry meta is human/AI doc)
//    prereq            list of file/build artifacts required before invoke
//    cost              free | duo_concurrent | trio_concurrent
//
//  EXTENSION CONVENTION (future-proof; mirrors own 41)
//    NEW mode (e.g. ai-quartet, ai-moderated-N) → register entry below + add
//    module path; benchmark.hexa _bench_modes vendored mirror auto-syncs via
//    yaml↔md (own 39).
//
//  COMPLIANCE
//    own 14 V14 carry — mode is a measurement axis (not verdict)
//    own 16 — model load 절대 금지 (registry meta only)
//    own 18 chat-cap C2/C3 — mode dimension differential
//    own 22 mandatory report — registry self-emit per main()
//    own 33 trinity — registry entries cross-link own 17 / own 18 / own 34
//    own 34 mandate-1 — wrapping 0 (mode dispatch raw bytes)
//    own 38 매단계 — registry yaml↔md mirror in
//      anima/registry/anima_artifact_registry.yaml chat_modes section
//    own 39 yaml↔md SSOT — registry yaml + this hexa file co-update
//    own 41 chat lane plugin pattern — same registry SSOT + lookup helpers
//      pattern (this file is own 41 mirror at axis level "mode" — axis-2)
//
//  CROSS-REFERENCE
//    chat/lanes/benchmark.hexa           --mode dimension (vendored mirror retained)
//    chat/duo/duo.hexa                   ai-duo dispatch SSOT
//    chat/trio/trio.hexa                 ai-trio dispatch SSOT
//    chat/axes/_registry.hexa            axis-2 row (registry_file: modes/_registry.hexa)
//    anima/registry/anima_artifact_registry.yaml#chat_modes  yaml mirror
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

// Registry SSOT — append-only convention. New mode = new entry.
// Field order: name, file, status, capability, pattern_type, description,
//              prereq, cost
fn mode_registry() -> array {
    return [
        // ───── Mode 1 — 1:1 single user → single model (default) ──────────────
        ["1:1",
         "lanes/benchmark.hexa",
         "LANDED",
         "single_shot",
         "user_x_model",
         "single user → single model (default; current behavior — 1 user × 1 model × N prompts × all lanes)",
         "chat lane plugin (own 41) — substrate / llama / axis-priority / generate",
         "free"],

        // ───── Mode 2 — ai-duo (2 models dialogue) ────────────────────────────
        ["ai-duo",
         "duo/duo.hexa",
         "LANDED",
         "duo_dialogue",
         "model_x_model_x2",
         "2 models dialogue (A ↔ B; sibling channel pair via β-1 stdlib/channel)",
         "β-1 stdlib/channel.hexa (channel_pair_open + proc_spawn_with_channels)",
         "duo_concurrent"],

        // ───── Mode 3 — ai-trio (3 models round-robin OR moderated) ───────────
        ["ai-trio",
         "trio/trio.hexa",
         "SKELETON",
         "trio_round_robin",
         "model_x_model_x3",
         "3 models round-robin OR moderated (A → B → C → A → ...; 6 channel pairs ×2 fd = 12 fds)",
         "β-1 stdlib/channel.hexa (channel_pair_open ×6 + proc_spawn_with_channels ×3)",
         "trio_concurrent"]
    ]
}

// Lookup helper — returns entry or [] when not found.
fn mode_lookup(name: string) -> array {
    let reg = mode_registry()
    let mut i = 0
    while i < len(reg) {
        let row = reg[i]
        if _str(row[0]) == name {
            return row
        }
        i = i + 1
    }
    return []
}

// Names list (for --list-modes / --mode=help / benchmark sweep)
fn mode_names() -> array {
    let reg = mode_registry()
    let mut out = []
    let mut i = 0
    while i < len(reg) {
        out = out + [_str(reg[i][0])]
        i = i + 1
    }
    return out
}

// File path resolver — caller appends root + /tool/anima_cli/chat/
fn mode_file(name: string) -> string {
    let row = mode_lookup(name)
    if len(row) == 0 { return "" }
    return _str(row[1])
}

// Default mode — 1:1 (current default behavior; benchmark.hexa --mode default).
fn mode_default() -> string { return "1:1" }

// Pretty-print one row (used by --list-modes / --mode=help)
fn mode_describe(name: string) -> string {
    let row = mode_lookup(name)
    if len(row) == 0 { return "(unknown mode: " + name + ")" }
    return "  " + _str(row[0])
        + " [" + _str(row[2]) + "]"
        + " cap=" + _str(row[3])
        + " type=" + _str(row[4])
        + " cost=" + _str(row[7])
        + "\n      " + _str(row[5])
        + "\n      prereq: " + _str(row[6])
}

// Selftest — registry shape sanity (no dispatch, no model load — own 16)
fn main() {
    let reg = mode_registry()
    if len(reg) < 3 {
        println("FAIL chat/modes/_registry < 3 entries (expected 1:1 / ai-duo / ai-trio)")
        exit(1)
    }
    let mut i = 0
    while i < len(reg) {
        let row = reg[i]
        if len(row) != 8 {
            println("FAIL row " + to_string(i) + " arity != 8 (got " + to_string(len(row)) + ")")
            exit(1)
        }
        i = i + 1
    }
    println("PASS chat/modes/_registry selftest (" + to_string(len(reg)) + " entries)")
    println("  default = " + mode_default())
    let names = mode_names()
    let mut k = 0
    while k < len(names) {
        println(mode_describe(_str(names[k])))
        k = k + 1
    }
}
