// @allow-bare-exec-file
// @allow-silent-exit-file
// @allow-relop-banned-file
// @allow-silent-catch-file
// @allow-no-header-box
// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat/anima_pretrained/anima_pretrained.hexa
//
//  PURPOSE
//    cycle 2026-05-12 의 학습 ckpt (Phase 1A.1, B'', Phase 1A, Substrate A) 를
//    anima cli `chat` subcommand 안에서 접근 가능하게 함.
//
//  ALIAS (4)
//    anima-v05         Phase 1A.1 color/cosmology boost (V5.8 std_greedy 4/5)  star
//    bprime-prime      FFN.gate cotrain B'' (V4-lite 15/15 PASS)
//    phase1a           Phase 1A multi-turn SFT (V5.8 std_greedy 3/5)
//    substrate-a       Phase 2 cotrain Engine A/G (V4-lite 12/15 baseline)
//
//  USAGE
//    anima chat anima-v05 --prompt "annyeong"
//    anima chat bprime-prime --prompt "..." --mode greedy
//    anima chat substrate-a --selftest
//
//  COMPLIANCE
//    raw#9 EXCEPTION: PyTorch ckpt 의존 — hexa-native byte forward 로 reimplement
//      불가능. anima_chat.py wrapper 채택 (cycle 2026-05-12 SSOT).
//    own 34 mandate-1: anima_chat.py 의 raw stdout 보존 — print() 만.
//    raw#11 snake_case
//    raw#15 no-hardcode — path 는 _resolve_root() + alias mapping
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _ckpt_for(key: string) -> string {
    // Returns ckpt path RELATIVE TO MAC HOME (~ expands inside ssh mac '...').
    // raw#9 EXCEPTION: hexa runtime routes through ubu1 (aiden) — direct
    // exec() lands in /home/aiden namespace where ckpts do not exist. We
    // therefore wrap in `ssh mac '...'` so the Mac shell expands ~ correctly.
    if key == "anima-v05" || key == "phase1a1" {
        return "~/core/anima/state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/ckpt_phase1a1_sft.pt"
    }
    if key == "bprime-prime" || key == "bpp" {
        return "~/core/anima/state/anima_ffn_gate_cotrain_2026_05_11/ckpts/ckpt_final.pt"
    }
    if key == "phase1a" {
        return "~/core/anima/state/anima_phase1a_alt_2026_05_12/ckpts/ckpt_phase1a_sft.pt"
    }
    if key == "substrate-a" {
        return "~/.cache/anima/clm_v5_remapped/phase2_cotrain_engine_ag/ckpts/ckpt_final.pt"
    }
    if key.contains("phase1a1-color-cosmology") {
        return "~/core/anima/state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/ckpt_phase1a1_sft.pt"
    }
    if key.contains("bprime-prime") {
        return "~/core/anima/state/anima_ffn_gate_cotrain_2026_05_11/ckpts/ckpt_final.pt"
    }
    if key.contains("phase1a-multi-turn") {
        return "~/core/anima/state/anima_phase1a_alt_2026_05_12/ckpts/ckpt_phase1a_sft.pt"
    }
    if key.contains("phase2-cotrain-engine-ag") {
        return "~/.cache/anima/clm_v5_remapped/phase2_cotrain_engine_ag/ckpts/ckpt_final.pt"
    }
    return ""
}

fn _shell_escape_single(s: string) -> string {
    let mut out = "'"
    let mut j = 0
    while j < len(s) {
        let c = s.substring(j, j + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        j = j + 1
    }
    return out + "'"
}

fn _on_mac() -> bool {
    // Mac local detection: /Users/ghost exists AND we're not on ubu host.
    return _str(exec("test -d /Users/ghost && uname -s 2>/dev/null")).trim() == "Darwin"
}

fn _invoke(alias: string, prompt: string, mode: string, max_new: int) -> string {
    // raw#9 EXCEPTION: anima_chat.py + ckpts live on Mac.
    //   - Mac local: direct exec (no ssh prefix)
    //   - ubu host:  ssh mac wrapper (Mac home path expansion)
    let ckpt = _ckpt_for(alias)
    if ckpt == "" {
        return "[anima_pretrained] unknown alias: " + alias + "\n"
    }
    let esc_prompt = _shell_escape_single(prompt)
    let n = to_string(max_new)
    let inner = "/usr/bin/python3 ~/core/anima/anima_chat.py --ckpt " + ckpt + " --prompt " + esc_prompt + " --mode " + mode + " --max-new " + n + " 2>/dev/null"
    if _on_mac() {
        // expand ~ via shell directly, no ssh
        return _str(exec("bash -c " + _shell_escape_single(inner)))
    }
    let esc_inner = _shell_escape_single(inner)
    let cmd = "ssh -o ConnectTimeout=15 -o BatchMode=yes mac " + esc_inner
    return _str(exec(cmd))
}

fn sub_help() {
    println("anima_pretrained chat module — cycle 2026-05-12 학습 ckpt")
    println("")
    println("ALIAS")
    println("  anima-v05         Phase 1A.1 (V5.8 std_greedy 4/5, 자연 한국어) star default 권장")
    println("  bprime-prime      B'' FFN.gate cotrain (V4-lite 15/15 PASS)")
    println("  phase1a           Phase 1A multi-turn SFT (V5.8 std_greedy 3/5)")
    println("  substrate-a       Phase 2 cotrain Engine A/G (V4-lite 12/15)")
    println("")
    println("FLAGS")
    println("  --prompt '...'    one-shot")
    println("  --mode <name>     M4_force_include (default) / greedy / sample / M3_rep_penalty")
    println("  --max-tokens N    default 80")
    println("  --selftest        ckpt presence check")
    println("")
    println("RAW#9 EXCEPTION")
    println("  PyTorch ckpt 의존 — anima_chat.py shell-out (cycle 2026-05-12 SSOT)")
    println("  own 34 mandate-1 raw output 보존")
}

fn sub_one_shot(alias: string, prompt: string, mode: string, max_new: int) {
    let out = _invoke(alias, prompt, mode, max_new)
    print(out)
}

fn sub_selftest(alias: string) {
    let ckpt = _ckpt_for(alias)
    if ckpt == "" {
        println("FAIL unknown alias: " + alias)
        exit(1)
    }
    if !_fexists(ckpt) {
        println("WARN ckpt missing: " + ckpt + " (alias=" + alias + ")")
    } else {
        println("OK ckpt exists: " + ckpt)
    }
    let root = _resolve_root()
    let chat_py = root + "/anima_chat.py"
    if !_fexists(chat_py) {
        println("FAIL anima_chat.py missing: " + chat_py)
        exit(1)
    }
    println("OK anima_chat.py exists: " + chat_py)
    println("PASS anima_pretrained selftest (alias=" + alias + ")")
}

fn main() {
    let args = real_args()
    let n = len(args)
    if n == 0 {
        sub_help()
        return
    }
    // alias key: first positional arg OR --repo value (chat.hexa dispatch).
    let mut alias = ""
    let mut prompt = ""
    let mut mode = "M4_force_include"
    let mut max_new = 80
    let mut is_selftest = false
    let mut is_help = false
    let mut i = 0
    while i < n {
        let a = _str(args[i])
        if a == "--repo" {
            if i + 1 < n {
                alias = _str(args[i+1])
                i = i + 2
            } else {
                i = i + 1
            }
        } else if a == "--prompt" {
            if i + 1 < n {
                prompt = _str(args[i+1])
                i = i + 2
            } else {
                i = i + 1
            }
        } else if a == "--mode" {
            if i + 1 < n {
                mode = _str(args[i+1])
                i = i + 2
            } else {
                i = i + 1
            }
        } else if a == "--max-tokens" {
            if i + 1 < n {
                max_new = to_int(_str(args[i+1]))
                i = i + 2
            } else {
                i = i + 1
            }
        } else if a == "--selftest" {
            is_selftest = true
            i = i + 1
        } else if a == "--help" {
            is_help = true
            i = i + 1
        } else if alias == "" {
            // determine: --flag (skip) vs positional alias
            if len(a) >= 2 && a.substring(0, 2) == "--" {
                i = i + 1
            } else {
                alias = a
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    if is_help {
        sub_help()
        return
    }
    if alias == "" {
        sub_help()
        return
    }
    if is_selftest {
        sub_selftest(alias)
        return
    }
    if prompt != "" {
        sub_one_shot(alias, prompt, mode, max_new)
    } else {
        println("[anima_pretrained] REPL not yet supported — use --prompt '...'")
    }
}
