fn sub_list() {
    let root = _resolve_root()
    println("anima chat — alias DB (Phase 1 + Phase 3 declared)")
    println("")
    println("ALIAS              MODULE       REPO                                                    CHAT  PHASE")
    println("───────────────────────────────────────────────────────────────────────────────────────────────────")
    println("(default)          anima_native (TinyWeights / Engine A/G)                              ✔     1")
    println("clm-v4-1-7-y1      clm_v4       dancinlab/clm-v4-sft-1-7-y1-stage1                      ❌    1")
    println("clm-v4-1-8         clm_v4       dancinlab/clm-v4-sft-1-8-stage1                         ❌    1")
    println("clm-v4-paradigm-j  clm_v4       dancinlab/clm-v4-paradigm-j-50k-final                   ❌    1")
    println("llama3b / latest   llama        dancinlab/bg-km-llama3b-r32-pass-strict-2026-05-08      ✔     3")
    println("qwen7b             llama        dancinlab/bg-km-qwen-7b-qwen7b-r32-pass-strict-...      ✔     3")
    println("polyglot-ko-1b3    llama        dancinlab/bg-ja-ext-polyglot-ko-1b3-r16-partial-...     △     3")
    println("paradigm-a-prime   llama        dancinlab/llm-llama32-3b-paradigm-a-prime-r16-...       ✔     3")
    println("")
    println("CHAT legend: ✔ chat-capable · ❌ research-only (collapse output exposed raw per own 34) · △ partial")
    println("PHASE legend: 1 land · 3 hexa-lang C FFI + libllama bindings 후 (.roadmap.cli)")
    println("")
    println("raw HF id (dancinlab/<repo>) passthrough — alias 위치에 직접 입력 가능")
}

fn sub_selftest() {
    let root = _resolve_root()
    let mod_dir = root + "/tool/anima_cli/chat"
    let dispatch = root + "/tool/anima_cli/chat.hexa"
    let mod_native = mod_dir + "/anima_native/anima_native.hexa"
    let mod_clm_v4 = mod_dir + "/clm_v4/clm_v4.hexa"
    let mut fail = 0
    if !_fexists(dispatch) { println("FAIL chat.hexa missing: " + dispatch); fail = fail + 1 }
    if !_dexists(mod_dir) { println("FAIL chat/ module dir missing: " + mod_dir); fail = fail + 1 }
    if !_fexists(mod_native) { println("FAIL chat/anima_native module missing: " + mod_native); fail = fail + 1 }
    if !_fexists(mod_clm_v4) { println("FAIL chat/clm_v4 module missing: " + mod_clm_v4); fail = fail + 1 }
    // own 34 mandate-2 grep — 7 wrapping 항목 0 violation chat lane
    // (V4 evaluator는 측정 lane = own 18 적용, 본 grep 면제 — chat path 한정)
    // ERE alternation = `|` (not `\|`); `(` escaped to literal; self-exclude grep -v
    let pat = "system_prompt|chat_template|apply_chat_template|persona_inject|fn speak\\(|fn talk\\(|fn respond\\(|fn generate_response\\("
    let cmd = "grep -nE \"" + pat + "\" " + dispatch + " " + mod_native + " " + mod_clm_v4 + " 2>/dev/null | grep -v 'let pat =' | wc -l"
    let n = _str(exec(cmd)).trim()
    if n != "0" {
        println("FAIL own 34 mandate-2 wrapping grep: " + n + " hits (chat path 한정)")
        fail = fail + 1
    }
    if fail > 0 {
        println("FAIL anima_cli/chat selftest (" + to_string(fail) + " issue)")
        exit(1)
    }
    println("PASS anima_cli/chat selftest (own 34 mandate-2 verified, 4 files present)")
}

fn _dispatch_module(mod_name: string, repo: string, argv) {
    let root = _resolve_root()
    let mod_path = root + "/tool/anima_cli/chat/" + mod_name + "/" + mod_name + ".hexa"
    if !_fexists(mod_path) {
        println("anima chat: module not found: " + mod_path)
        println("           (Phase gate: " + mod_name + " 미구현 — see .roadmap.cli)")
        exit(2)
    }
    // Pass repo + flags to module via argv
    let i = 0
    let extra = ""
    while i < len(argv) {
        let s = _str(argv[i])
        extra = extra + " " + s
        i = i + 1
    }
    let cmd = _hexa() + " run " + mod_path + " --repo \"" + repo + "\"" + extra
    exec(cmd)
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    // anima chat list
    if len(argv) > 0 && _str(argv[0]) == "list" {
        sub_list()
        return
    }

    // resolve model alias (first positional or "default")
    let model_arg = if len(argv) > 0 && !_str(argv[0]).starts_with("--") { _str(argv[0]) } else { "default" }
    let resolved = _alias_resolve(model_arg)
    let mod_name = _str(resolved[0])
    let repo = _str(resolved[1])
    let phase = _str(resolved[4])

    if mod_name == "" {
        println("anima chat: unknown alias '" + model_arg + "'")
        println("            run `anima chat list` for known aliases")
        println("            raw HF id (dancinlab/<repo>) also accepted")
        exit(2)
    }

    // Phase 3 gate
    if phase == "phase_3" {
        println("anima chat: alias '" + model_arg + "' → module=" + mod_name + " (phase_3)")
        println("            blocked: hexa-lang C FFI upstream + libllama bindings + GGUF 변환 트랙 land 후")
        println("            see .roadmap.cli cli.chat_module_architecture_2026_05_08 phases")
        println("            available now (phase_1): anima chat (default) | anima chat clm-v4-1-7-y1")
        exit(2)
    }

    // --backend hf gate (Phase 3 deferred)
    let backend = _arg_value(argv, "--backend", "local")
    if backend == "hf" {
        println("anima chat: --backend hf — Phase 3 not yet implemented")
        println("            Phase 1 = --backend local only (anima_native + clm_v4)")
        exit(2)
    }

    // strip the model arg before passing to module
    let module_argv = if len(argv) > 0 && !_str(argv[0]).starts_with("--") { argv[1:] } else { argv }
    _dispatch_module(mod_name, repo, module_argv)
}
