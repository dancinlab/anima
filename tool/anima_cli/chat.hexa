// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_cli/chat.hexa — anima CLI `chat` topic dispatcher
//
//  PURPOSE
//    Resolve <model> alias → module → dispatch.
//    Recursive module pattern (per user directive 2026-05-08):
//      "anima native arch 기본에 별도 모델은 별도 모델들만의 분기 모듈
//       (모듈 = 코어 + 모듈 + ai-native doc) 재귀"
//
//  SUBCOMMANDS
//    anima chat                          REPL with anima_native module (default)
//    anima chat <alias>                  REPL with alias-resolved module
//    anima chat <alias> --prompt "..."   one-shot
//    anima chat list                     alias DB dump
//    anima chat --help
//    anima chat --selftest
//
//  FLAGS (parsed; phase-gated implementation)
//    --backend local|hf       default=local (Phase 1: only local)
//    --memory full|user|none  default=full
//    --fps N                  opt-in cap (Phase 2: needs hexa non-blocking stdin)
//    --max-utterance-rate N   opt-in cap (Phase 2)
//    --max-tokens N           cost guard (default 512)
//
//  COMPLIANCE
//    own 34 (자연발화 노출 mandate) — wrapping 0 strict
//    own 18 C2 cross-ref (측정 lane vs 노출 lane 분리)
//    own 33 trinity compliance
//    raw#9 hexa-only (no .py shell-out for chat path)
//    raw#10 honest C3
//    raw#11 snake_case
//    raw#15 no-hardcode (paths via _resolve_root)
//
//  PHASE GATES
//    Phase 1 (this commit): anima_native + clm_v4 modules, blocking REPL,
//      --backend local only, --memory full default.
//    Phase 2 (hexa upstream): non-blocking stdin + http SSE → autonomous speech,
//      --fps cap activation.
//    Phase 3 (libllama FFI): chat/llama/ module → BG-KM Llama-3.2-3B chat.
//
//  CROSS-REFERENCE
//    .roadmap.cli  cli.chat_module_architecture_2026_05_08
//    .own         own 34, own 18 C2, own 33
// ════════════════════════════════════════════════════════════════════════════

fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _trim(s: string) -> string { return s.trim() }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _dexists(p: string) -> bool {
    return _str(exec("test -d " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/bin/hexa" }

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        // strip hexa-cache, hexa interpreter path, and chat.hexa script path
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/chat.hexa")
                || s.ends_with("chat.hexa")
        if !skip {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

// ─── alias DB (static, hybrid with raw HF id passthrough) ────────────────
// own 34 mandate: chat path raw model output 보존 (wrapping 0).
// alias resolution은 module routing만 — 모델 출력 변형 X.
fn _alias_resolve(alias: string) -> array {
    // returns [module, repo, chat_capable_flag, v4_strict, phase]
    let a = alias.trim().to_lower()
    if a == "" || a == "default" {
        return ["anima_native", "", "true", "", "phase_1"]
    }
    if a == "llama3b" || a == "latest" || a == "pass-strict" {
        return ["llama", "dancinlab/bg-km-llama3b-r32-pass-strict-2026-05-08", "true", "12/15", "phase_3"]
    }
    if a == "qwen7b" {
        return ["llama", "dancinlab/bg-km-qwen-7b-qwen7b-r32-pass-strict-2026-05-08", "true", "PASS", "phase_3"]
    }
    if a == "polyglot-ko-1b3" {
        return ["llama", "dancinlab/bg-ja-ext-polyglot-ko-1b3-r16-partial-2026-05-07", "partial", "4/30", "phase_3"]
    }
    if a == "paradigm-a-prime" {
        return ["llama", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1", "true", "", "phase_3"]
    }
    if a == "clm-v4-1-7-y1" {
        return ["clm_v4", "dancinlab/clm-v4-sft-1-7-y1-stage1", "false", "", "phase_1"]
    }
    if a == "clm-v4-1-8" {
        return ["clm_v4", "dancinlab/clm-v4-sft-1-8-stage1", "false", "", "phase_1"]
    }
    if a == "clm-v4-paradigm-j" {
        return ["clm_v4", "dancinlab/clm-v4-paradigm-j-50k-final", "false", "", "phase_1"]
    }
    // raw HF id passthrough: dancinlab/<repo>
    if a.contains("/") {
        // module guess: clm-v4-* → clm_v4 / others → llama (phase_3)
        if a.contains("clm-v4") {
            return ["clm_v4", alias, "false", "", "phase_1"]
        }
        return ["llama", alias, "unknown", "", "phase_3"]
    }
    return ["", "", "", "", ""]
}

