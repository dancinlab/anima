    println("  anima chat <alias> --prompt \"...\"   one-shot")
    println("  anima chat list                     alias DB dump")
    println("  anima chat --help")
    println("  anima chat --selftest")
    println("")
    println("FLAGS")
    println("  --backend local|hf      default=local (Phase 1: local only)")
    println("  --memory full|user|none default=full")
    println("  --fps N                 opt-in cap (Phase 2)")
    println("  --max-utterance-rate N  opt-in cap (Phase 2)")
    println("  --max-tokens N          cost guard (default 512)")
    println("")
    println("ALIAS (Phase 1 = anima_native + clm_v4; Phase 3 = llama family)")
    println("  (default)               anima_native — TinyWeights / Engine A/G")
    println("  clm-v4-1-7-y1           CLM v4 Y1 (substrate, ::: collapse exposed raw)")
    println("  clm-v4-1-8              CLM v4")
    println("  clm-v4-paradigm-j       CLM v4 Paradigm J (jvae_heads.pt)")
    println("  llama3b / latest        BG-KM-LLAMA-3B (V4 12/15) — Phase 3")
    println("  qwen7b                  BG-KM-QWEN-7B (V4 PASS) — Phase 3")
    println("  polyglot-ko-1b3         BG-JA-EXT — Phase 3")
    println("  paradigm-a-prime        Llama Path A v2 — Phase 3")
    println("  <hf-id>                 raw HF id passthrough (dancinlab/<repo>)")
