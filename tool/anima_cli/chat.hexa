fn sub_selftest() {
    let root = _resolve_root()
    let mod_dir = root + "/tool/anima_cli/chat"
    let dispatch = root + "/tool/anima_cli/chat.hexa"
    let mod_native = mod_dir + "/anima_native/anima_native.hexa"
    let mod_clm_v4 = mod_dir + "/clm_v4/clm_v4.hexa"
    let mod_llama  = mod_dir + "/llama/llama.hexa"
    let mut fail = 0
    if !_fexists(dispatch) { println("FAIL chat.hexa missing: " + dispatch); fail = fail + 1 }
    if !_dexists(mod_dir) { println("FAIL chat/ module dir missing: " + mod_dir); fail = fail + 1 }
    if !_fexists(mod_native) { println("FAIL chat/anima_native module missing: " + mod_native); fail = fail + 1 }
    if !_fexists(mod_clm_v4) { println("FAIL chat/clm_v4 module missing: " + mod_clm_v4); fail = fail + 1 }
    if !_fexists(mod_llama)  { println("FAIL chat/llama module missing: "  + mod_llama);  fail = fail + 1 }
    // own 41 axis-8 — chat init-pattern plugin presence
    let ip_dir = mod_dir + "/init_patterns"
    let ip_reg = ip_dir + "/_registry.hexa"
    let ip_files = [
        ip_dir + "/autonomous.hexa",
        ip_dir + "/system_seed.hexa",
        ip_dir + "/topic_pool.hexa",
        ip_dir + "/self_reflective.hexa"
    ]
    if !_dexists(ip_dir) { println("FAIL chat/init_patterns/ dir missing: " + ip_dir); fail = fail + 1 }
    if !_fexists(ip_reg) { println("FAIL chat/init_patterns/_registry.hexa missing: " + ip_reg); fail = fail + 1 }
    let mut ipi = 0
    while ipi < len(ip_files) {
        let f = _str(ip_files[ipi])
        if !_fexists(f) { println("FAIL chat/init_patterns module missing: " + f); fail = fail + 1 }
        ipi = ipi + 1
    }
    // own 34 mandate-2 grep — 7 wrapping 항목 0 violation chat lane
    // (V4 evaluator는 측정 lane = own 18 적용, 본 grep 면제 — chat path 한정)
    // ERE alternation = `|` (not `\|`); `(` escaped to literal; self-exclude grep -v
    // Phase 3c: chat/llama/llama.hexa 추가 — own 34 strict 동일 적용.
    let pat = "system_prompt|chat_template|apply_chat_template|persona_inject|fn speak\\(|fn talk\\(|fn respond\\(|fn generate_response\\("
    let cmd = "grep -nE \"" + pat + "\" " + dispatch + " " + mod_native + " " + mod_clm_v4 + " " + mod_llama + " 2>/dev/null | grep -v 'let pat =' | wc -l"
    let n = _str(exec(cmd)).trim()
    if n != "0" {
        println("FAIL own 34 mandate-2 wrapping grep: " + n + " hits (chat path 한정)")
        fail = fail + 1
    }
    // iter7 (b): stdbuf probe — informational (WARN on empty, OK on non-empty;
    // no fail — bare-mac legacy path preserved per backward-compat invariant).
    let pfx = _stdbuf_prefix()
    if pfx != "" {
        println("OK    stdbuf probe = " + pfx.trim())
    } else {
        println("WARN  stdbuf probe = (none) — install GNU coreutils for line-buffered streaming")
    }
    if fail > 0 {
        println("FAIL anima_cli/chat selftest (" + to_string(fail) + " issue)")
        exit(1)
    }
    println("PASS anima_cli/chat selftest (own 34 mandate-2 verified, 5 chat files + 5 init-pattern files present, stdbuf probe added)")
}

// Default per-line callback for streaming dispatch. own 34 mandate-1: print()
// (NOT println()) — newline already attached by line emit semantics; we restore
// it here because channel_recv strips trailing \r?\n. No transformation; the
// line bytes pass through verbatim.
fn _print_line(line: string) {
    print(line + "\n")
}

// _stdbuf_prefix — line-buffered stdout prefix probe (iter7 (b) land 2026-05-08)
//
// Returns a shell prefix that forces inner cmd's stdout to line-buffered mode
// so each emitted line flushes immediately to the FIFO, instead of waiting on
// the default 4KB block-buffered pipe behavior. Probes (in order):
//   1. `stdbuf` (Linux GNU coreutils, also homebrew/macports on Mac)
//   2. `gstdbuf` (Mac coreutils via brew install coreutils — `g`-prefix)
//   3. ""       (honest C3 fallback — bare-mac legacy path preserved)
//
// Backward compat: empty prefix returns byte-identical to pre-iter7 behavior
// (concat of "" + inner_cmd == inner_cmd). Non-empty prefix preserves byte
// stream verbatim per own 34 mandate-1 — stdbuf only touches buffer cadence,
// not bytes. Single-shot WARN sentinel `/tmp/.anima_chat_stdbuf_warn_<pid>`
// emits one informational line per process when probe falls through to "".
fn _stdbuf_prefix() -> string {
    let s = _str(exec("command -v stdbuf 2>/dev/null")).trim()
    if s != "" { return "stdbuf -oL " }
    let g = _str(exec("command -v gstdbuf 2>/dev/null")).trim()
    if g != "" { return "gstdbuf -oL " }
    let pid = _str(exec("echo $$")).trim()
    let sentinel = "/tmp/.anima_chat_stdbuf_warn_" + pid
    if !_fexists(sentinel) {
        let _t = exec("touch " + sentinel + " 2>/dev/null")
        println("WARN anima chat: neither stdbuf nor gstdbuf available — inner cmd stdout may block-buffer (4KB) on FIFO; first-line latency ∞ risk. Install GNU coreutils (`brew install coreutils`) for line-buffered streaming.")
    }
    return ""
}

// _dispatch_module_streaming — line-by-line dispatch (loop iter 4 (b))
//
// Streaming variant of _dispatch_module. Inner cmd's stdout flows through a
// temp FIFO (stdlib/channel allocator); chat.hexa reads each line via
// channel_recv with timeout and forwards to `on_line`. Unblocks duo channel
// transport (iter 3 (b-fix) honest C3 carry — chat.hexa exec() captured full
// stdout in one buffer → duo's per-turn channel_recv saw the whole banner
// only after inner cmd exited).
//
// Backward compat: when on_line == _print_line, the visible byte sequence is
// the same as the legacy buffered path (lines reassembled with '\n'). The
// new property is per-line cadence — chat.hexa stdout flushes each line as
// it arrives (hexa runtime sets stdout _IOLBF; print(line+"\n") flushes), so
// a downstream FIFO reader (duo) sees lines incrementally.
//
// own 34 mandate-1 raw preservation: no semantic transformation. The sentinel
// __HEXA_DISP_END__ is a control-band marker (own 36 convention) filtered
// out before the on_line callback ever sees it.
//
// FIFO failure path: if channel_pair_open returns -1 (rare, /tmp non-writable),
// we fall back to legacy buffered exec() and feed each split line to on_line —
// semantic identical, no streaming benefit.
//
// Returns 0 on clean completion, 2 on module-not-found.
fn _dispatch_module_streaming(mod_name: string, repo: string, argv, on_line) -> int {
    let root = _resolve_root()
    let mod_path = root + "/tool/anima_cli/chat/" + mod_name + "/" + mod_name + ".hexa"
    if !_fexists(mod_path) {
        on_line("anima chat: module not found: " + mod_path)
        on_line("           (Phase gate: " + mod_name + " 미구현 — see .roadmap.cli)")
        return 2
    }
    // Pass repo + flags to module via argv (parity with legacy form).
    let mut i = 0
    let mut extra = ""
    while i < len(argv) {
        let s = _str(argv[i])
        extra = extra + " " + s
        i = i + 1
    }
    let _stdbuf_pfx = _stdbuf_prefix()
    let inner_cmd = _stdbuf_pfx + _hexa() + " run " + mod_path + " --repo \"" + repo + "\"" + extra
    // Allocate a temp FIFO via stdlib/channel — we use only the read side.
    // pair[0] = c2p (parent reads), pair[1] = p2c (parent writes; unused here).
    // (The unused write pair is opened so we can call channel_close() on it
    //  to unlink the inode at tear-down — not for I/O.)
    let pair = channel_pair_open()
    let read_fd = pair[0]
    let write_fd = pair[1]
    if read_fd < 0 {
        // Fallback: legacy buffered path (FIFO creation failed). Feed lines
        // to callback for parity. own 34 mandate-1 — bytes still verbatim.
        let out = _str(exec(inner_cmd))
        let parts = out.split("\n")
        let mut k = 0
        while k < len(parts) - 1 {
            on_line(_str(parts[k]))
            k = k + 1
        }
        // Last fragment: emit only if non-empty (avoid trailing blank line).
        if len(parts) > 0 {
            let tail = _str(parts[len(parts) - 1])
            if tail != "" { on_line(tail) }
        }
        return 0
    }
    let fifo_path = channel_path_for(read_fd)
    let END = "__HEXA_DISP_END__"
    // Background the inner cmd writing to the FIFO. Append END sentinel
    // after the cmd exits so the read loop terminates deterministically.
    //
    // Backgrounding gotcha: hexa's exec() uses popen(cmd, "r") and reads to
    // EOF on the pipe. A naked `(...) &` would inherit popen's stdout fd in
    // the backgrounded subshell, keeping the pipe open and blocking exec()
    // forever. We close subshell stdin/stdout/stderr (`</dev/null
    // >/dev/null 2>&1`) BEFORE the `&` so popen sees EOF immediately and
    // exec() returns. The inner cmd's stdout is already redirected to the
    // FIFO inside the subshell, so the /dev/null on subshell stdout doesn't
    // suppress the actual chat output.
    //
    // own 34 mandate-1: stderr is folded into the FIFO via `2>&1` so
    // diagnostic chatter (e.g. llama.cpp gguf banner, hxllama warnings)
    // reaches the chat lane verbatim — same semantics as legacy buffered
    // _dispatch_module exec(cmd) where popen captures stdout+stderr.
    let bg_cmd = "(" + inner_cmd
        + " > '" + fifo_path + "' 2>&1; "
        + "printf '%s\\n' '" + END + "' > '" + fifo_path + "') "
        + "</dev/null >/dev/null 2>&1 &"
    let _r = exec(bg_cmd)
    // Per-line ceiling: 10 min. Chat output cadence (LLM token streams) is
    // typically <60s/line; long generations stay within 10min. Two consecutive
    // empty reads (timeout / EOF) → terminate (defensive — END sentinel is
    // the canonical exit). own 34 mandate-1 — raw bytes through.
    let timeout_ms = 600000
    let mut done = false
    let mut empty_streak = 0
    while !done {
        let line = _str(channel_recv(read_fd, timeout_ms))
        if line == END {
            done = true
        } else if line == "" {
            empty_streak = empty_streak + 1
            if empty_streak >= 2 { done = true }   // EOF / dual-timeout guard
        } else {
            empty_streak = 0
            on_line(line)
        }
    }
    let _c1 = channel_close(read_fd)
    let _c2 = channel_close(write_fd)
    return 0
}

// _dispatch_module — backward-compat wrapper around streaming form.
// External byte sequence preserved (one-shot --prompt mode identical); REPL
// banners now arrive incrementally instead of one buffered blob (Phase 3c
// honest C3 #5 / iter 3 (b-fix) C3 carry resolved).
fn _dispatch_module(mod_name: string, repo: string, argv) {
    let _rc = _dispatch_module_streaming(mod_name, repo, argv, _print_line)
}

// ─── chat lane plugin dispatch (cycle 2026-05-09 LANDED) ────────────────────
//
// The chat lane plugin pattern (chat/lanes/_registry.hexa SSOT) is invoked
// via three flags, all routed below.  Lane modules are own-main()-bearing
// hexa scripts at chat/lanes/<file>.hexa; we shell out to hexa.real with
// the surfaced argv, identical to the legacy _dispatch_module path but
// without the FIFO streaming layer (lane runs are short-lived one-shots).
//
// own 34 mandate-1: lane invocation pipes raw stdout (no transform); the
// only chat.hexa-side framing is the optional [BENCH ...] markers emitted
// by the lane modules themselves (own 36 control-band convention).
//
// own 39 yaml↔md: the registry SSOT lives in chat/lanes/_registry.hexa
// (programmatic lookup via shell_lane_lookup helper invoke) AND in
// anima/registry/anima_artifact_registry.yaml#chat_lanes (md mirror via
// docs/anima_artifact_registry.md regenerate).
//
// Future-proof extension: a NEW lane = drop chat/lanes/<file>.hexa with
// fn main() + register entry in _registry.hexa lane_registry().  No
// chat.hexa change needed for lane-internal flags (each lane parses its
// own --foo via _arg_value).  This is the future-proof --option pattern
// the user directive 2026-05-09 mandates.

fn _lane_file_lookup(name: string) -> string {
    // Mirror of chat/lanes/_registry.hexa lane_file() — vendored for
    // chat.hexa no-import constraint.  When _registry adds new lanes,
    // append below AND in registry hexa (own 39 yaml↔md mirror).
    if name == "substrate" { return "substrate.hexa" }
    if name == "llama" { return "llama.hexa" }
    if name == "axis-priority" { return "axis_corpus_priority.hexa" }
    if name == "generate" { return "clm_v4_generate.hexa" }
    return ""
}

fn sub_list_lanes() {
    let root = _resolve_root()
    let registry = root + "/tool/anima_cli/chat/lanes/_registry.hexa"
    if !_fexists(registry) {
        println("anima chat --list-lanes: registry missing: " + registry)
        exit(2)
    }
    // Delegate to _registry.hexa main() — it dumps lane_describe() per row.
    let cmd = _hexa() + " run " + registry + " 2>&1"
    print(_str(exec(cmd)))
    println("")
    println("(Lane dispatch: anima chat <alias> --lane=<name>)")
    println("(Benchmark all: anima chat <alias> --benchmark)")
}

