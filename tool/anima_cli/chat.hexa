// ─────────────────────────────────────────────────────────────────────────
// own 41 axis-N+1 hook (T+1 step, cycle 2026-05-10) — generic axis dispatch
//
// 본 helper 들은 raw#15 ADDITIVE — 기존 4 hardcode 분기 (--list-lanes /
// --list-init-patterns / --list-transports) 는 그대로 유지 (back-compat).
// 신규 진입점:
//   anima chat --list-axes              → 모든 axis (lane/mode/init-pattern/transport)
//   anima chat list-axes                → 동일 (positional alias)
//   anima chat --list-axis=<name>       → 특정 axis 의 names 만 dump
//   anima chat list-axis <name>         → 동일 (positional)
//
// generic dispatch 는 axes/_registry.hexa SSOT 를 통해 axis-5+ 자동 흡수
// (verifier registry 추가 시 chat.hexa 코드 변경 0 줄).
// ─────────────────────────────────────────────────────────────────────────
fn sub_list_axes() {
    let root = _resolve_root()
    let registry = root + "/tool/anima_cli/chat/axes/_registry.hexa"
    if !_fexists(registry) {
        println("anima chat --list-axes: meta-registry missing: " + registry)
        exit(2)
    }
    let cmd = _hexa() + " run " + registry + " 2>&1"
    print(_str(exec(cmd)))
    println("")
    println("(Axis 별 dump: anima chat list-axis <name>)")
    println("(Axis 별 detail: anima chat --list-<lanes|modes|init-patterns|transports>)")
}

// _route_list_axis — generic axis dispatcher (own 41 hook 핵심).
// axis name (lane / mode / init-pattern / transport / 미래 axis) 을 받아
// 해당 axis 의 registry 또는 inline anchor 에 위임. axes/_registry.hexa
// 에 row 추가 시 본 함수만으로 자동 인식 (axis-N+1 hook 정의).
fn _route_list_axis(axis_name: string) {
    let root = _resolve_root()
    let axes_reg = root + "/tool/anima_cli/chat/axes/_registry.hexa"
    if !_fexists(axes_reg) {
        println("anima chat list-axis: meta-registry missing: " + axes_reg)
        exit(2)
    }
    // axes/_registry.hexa 에서 row lookup. inline anchor (mode) 는
    // benchmark.hexa _bench_modes 로 위임, 그 외는 standalone registry 의
    // main() selftest 결과를 그대로 emit (registry meta 노출 own 24).
    let trimmed = axis_name.trim()
    if trimmed == "" {
        println("anima chat list-axis: axis name 필요 — 예: lane / mode / init-pattern / transport")
        println("                       (전체: anima chat --list-axes)")
        exit(2)
    }
    // Hardcoded axis → registry/inline mapping (vendored mirror of
    // axes_registry() — own 39 yaml↔md SSOT carry; 본 mirror 는 axes
    // registry 를 invoke 하지 않고도 generic dispatch 가능하도록 유지).
    if trimmed == "lane" {
        let p = root + "/tool/anima_cli/chat/lanes/_registry.hexa"
        if !_fexists(p) { println("anima chat list-axis: registry missing: " + p); exit(2) }
        print(_str(exec(_hexa() + " run " + p + " 2>&1")))
        return
    }
    if trimmed == "mode" {
        // T+2 promote (2026-05-10) — modes/_registry.hexa standalone registry.
        // Backward-compat fallback: 파일 부재 시 vendored inline emit.
        let p = root + "/tool/anima_cli/chat/modes/_registry.hexa"
        if _fexists(p) {
            print(_str(exec(_hexa() + " run " + p + " 2>&1")))
            return
        }
        // Fallback (raw#15 additive — promote 이전 동작 보존)
        println("PASS chat/axes#mode (inline anchor fallback → benchmark.hexa _bench_modes)")
        println("  default = 1:1")
        println("  1:1     [LANDED] single user → single model (default; current behavior)")
        println("  ai-duo  [LANDED] 2 models dialogue (chat/duo/duo.hexa)")
        println("  ai-trio [SKELETON] 3 models round-robin OR moderated (chat/trio/trio.hexa)")
        return
    }
    if trimmed == "init-pattern" {
        let p = root + "/tool/anima_cli/chat/init_patterns/_registry.hexa"
        if !_fexists(p) { println("anima chat list-axis: registry missing: " + p); exit(2) }
        print(_str(exec(_hexa() + " run " + p + " 2>&1")))
        return
    }
    if trimmed == "transport" {
        let p = root + "/tool/anima_cli/chat/transports/_registry.hexa"
        if !_fexists(p) { println("anima chat list-axis: registry missing: " + p); exit(2) }
        print(_str(exec(_hexa() + " run " + p + " 2>&1")))
        return
    }
    if trimmed == "verifier" {
        // axis-5 (own 41 axis-N+1) — T+3 land 2026-05-10. raw#15 additive —
        // 기존 4 case (lane/mode/init-pattern/transport) 보존.
        let p = root + "/tool/anima_cli/chat/verifiers/_registry.hexa"
        if !_fexists(p) { println("anima chat list-axis: registry missing: " + p); exit(2) }
        print(_str(exec(_hexa() + " run " + p + " 2>&1")))
        return
    }
    if trimmed == "modality" {
        // axis-6 own 41 axis-N+2 — T+6 land 2026-05-10. raw#15 additive.
        // 6-axis mark — modality (text/audio/vision/multi_modal/tactile).
        let p = root + "/tool/anima_cli/chat/modalities/_registry.hexa"
        if !_fexists(p) { println("anima chat list-axis: registry missing: " + p); exit(2) }
        print(_str(exec(_hexa() + " run " + p + " 2>&1")))  // @allow-bare-exec @allow-silent-exit
        return
    }
    println("anima chat list-axis: unknown axis '" + trimmed + "'")
    println("            run `anima chat --list-axes` for registered axes")
    exit(2)
}

fn sub_lane_dispatch(lane: string, repo: string, argv) {
    let root = _resolve_root()
    let file = _lane_file_lookup(lane)
    if file == "" {
        println("anima chat: unknown lane '" + lane + "'")
        println("            run `anima chat --list-lanes` for registered lanes")
        exit(2)
    }
    let lane_path = root + "/tool/anima_cli/chat/lanes/" + file
    if !_fexists(lane_path) {
        println("anima chat: lane file missing: " + lane_path)
        exit(2)
    }
    // Forward argv (excl. our own flags) plus repo to the lane.  The lane
    // module parses --prompt / --max-tokens / --temp / --bench-mode itself
    // (per-lane discretion; future-proof).
    let mut extra = ""
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        // strip our flag pair (we already extracted lane name)
        if s == "--lane" && i + 1 < len(argv) { i = i + 2; continue }
        if s.starts_with("--lane=") { i = i + 1; continue }
        extra = extra + " " + s
        i = i + 1
    }
    let repo_arg = if repo != "" { " --repo " + repo } else { "" }
    let cmd = _hexa() + " run " + lane_path + repo_arg + extra + " 2>&1"
    print(_str(exec(cmd)))
}

fn sub_benchmark(repo: string, argv) {
    let root = _resolve_root()
    let bench = root + "/tool/anima_cli/chat/lanes/benchmark.hexa"
    if !_fexists(bench) {
        println("anima chat --benchmark: runner missing: " + bench)
        exit(2)
    }
    let mut extra = ""
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == "--benchmark" { i = i + 1; continue }
        extra = extra + " " + s
        i = i + 1
    }
    let repo_arg = if repo != "" { " --repo " + repo } else { "" }
    let cmd = _hexa() + " run " + bench + repo_arg + extra + " 2>&1"
    print(_str(exec(cmd)))
}

// _arg_value_eq — supports BOTH `--lane name` and `--lane=name` forms
// (the user directive uses `--option` style; standardize parse here).
fn _arg_value_eq(argv, key: string, dflt: string) -> string {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key && i + 1 < len(argv) { return _str(argv[i + 1]) }
        if s.starts_with(prefix) {
            return s.substring(len(prefix), len(s))
        }
        i = i + 1
    }
    return dflt
}

fn _arg_present_eq(argv, key: string) -> bool {
    let prefix = key + "="
    let mut i = 0
    while i < len(argv) {
        let s = _str(argv[i])
        if s == key { return true }
        if s.starts_with(prefix) { return true }
        i = i + 1
    }
    return false
}

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    // anima chat --list-lanes (own 39 chat lane plugin registry dump)
    // No alias required — the registry is alias-agnostic.
    if _arg_present(argv, "--list-lanes") {
        sub_list_lanes()
        return
    }

    // anima chat --list-transports (axis-N transport plugin registry dump)
    // No alias required — the registry is alias-agnostic.
    if _arg_present(argv, "--list-transports") {
        sub_list_transports()
        return
    }

    // own 41 axis-8 — chat init-pattern plugin registry dump
    if _arg_present(argv, "--list-init-patterns") {
        sub_list_init_patterns()
        return
    }

    // own 41 axis-N+1 hook (T+1 step, cycle 2026-05-10) — meta-registry dump
    // anima chat --list-axes / anima chat list-axes
    if _arg_present(argv, "--list-axes") {
        sub_list_axes()
        return
    }
    if len(argv) > 0 && _str(argv[0]) == "list-axes" {
        sub_list_axes()
        return
    }

    // anima chat --list-axis=<name> / anima chat list-axis <name>
    if _arg_present_eq(argv, "--list-axis") {
        let axis_name = _arg_value_eq(argv, "--list-axis", "")
        _route_list_axis(axis_name)
        return
    }
    if len(argv) > 0 && _str(argv[0]) == "list-axis" {
        let axis_name = if len(argv) > 1 { _str(argv[1]) } else { "" }
        _route_list_axis(axis_name)
        return
    }

    // anima chat list
    if len(argv) > 0 && _str(argv[0]) == "list" {
        sub_list()
        return
    }

    // resolve model alias (first positional or "default")
    let model_arg = if len(argv) > 0 && !_str(argv[0]).starts_with("--") { _str(argv[0]) } else { "default" }
    let resolved = _alias_resolve(model_arg)
    let mod_name = _str(resolved[0])
    let repo = _str(resolved[1])
    let phase = _str(resolved[4])

    if mod_name == "" {
        println("anima chat: unknown alias '" + model_arg + "'")
        println("            run `anima chat list` for known aliases")
        println("            raw HF id (dancinlab/<repo>) also accepted")
        exit(2)
    }

    // Phase 3c LANDED 2026-05-08 — chat/llama/llama.hexa wires libllama FFI
    // into chat dispatcher. The legacy phase_3 gate is removed; GGUF presence
    // is verified inside the module (honest fallback emit if missing). Any
    // residual phase_3 tag (legacy alias DB entries) is treated as an error.
    if phase == "phase_3" {
        println("anima chat: alias '" + model_arg + "' → module=" + mod_name + " (phase_3 legacy tag)")
        println("            chat.hexa _alias_resolve should now emit phase_3c_landed for llama family.")
        exit(2)
    }

    // --backend hf gate (Phase 3 deferred)
    let backend = _arg_value(argv, "--backend", "local")
    if backend == "hf" {
        println("anima chat: --backend hf — Phase 3 not yet implemented")
        println("            Phase 1 = --backend local only (anima_native + clm_v4)")
        exit(2)
    }

    // strip the model arg before passing to module/lane
    let module_argv = if len(argv) > 0 && !_str(argv[0]).starts_with("--") { argv[1:] } else { argv }

    // anima chat <alias> --benchmark — run all lanes × fixed prompts.
    // Routed BEFORE --lane so `--benchmark` short-circuits any concurrent
    // --lane=<name> (benchmark already iterates all lanes).
    if _arg_present(module_argv, "--benchmark") {
        sub_benchmark(repo, module_argv)
        return
    }

    // anima chat <alias> --lane=<name> — dispatch chat lane plugin.
    // Supports both `--lane=foo` and `--lane foo` forms.
    if _arg_present_eq(module_argv, "--lane") {
        let lane = _arg_value_eq(module_argv, "--lane", "")
        if lane == "" {
            println("anima chat: --lane requires a name (substrate / llama / axis-priority / generate)")
            println("            run `anima chat --list-lanes` for registered lanes")
            exit(2)
        }
        sub_lane_dispatch(lane, repo, module_argv)
        return
    }

    // legacy module dispatch (unchanged) — alias → module routing
    _dispatch_module(mod_name, repo, module_argv)
}
