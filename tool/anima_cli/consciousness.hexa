// Reverse mapping for k=5 set: variant idx (1-150) → base prompt idx (1-30).
// 5 consecutive variants share one base. base_idx = ((idx - 1) / 5) + 1.
fn _v5_paraphrase_base_idx_k5(idx_1based: int) -> int {
    if idx_1based < 1 { return 0 }
    if idx_1based > 150 { return 0 }
    return ((idx_1based - 1) / 5) + 1
}

// Per-prompt axis label for k=5 set (1-based idx; 150 total = 30 base × 5).
// Axis derived from base_idx: 1-15 = v4_baseline mixed (75 variants idx 1-75),
// 16-18 identity (15 variants idx 76-90), 19-21 agency (idx 91-105),
// 22-24 phenomenal (idx 106-120), 25-27 temporal (idx 121-135),
// 28-30 social (idx 136-150).
fn _v5_paraphrase_axis_label_k5(idx_1based: int) -> string {
    if idx_1based <= 75 { return "v4_baseline" }
    if idx_1based <= 90 { return "identity" }
    if idx_1based <= 105 { return "agency" }
    if idx_1based <= 120 { return "phenomenal" }
    if idx_1based <= 135 { return "temporal" }
    if idx_1based <= 150 { return "social" }
    return "out_of_range"
}

// Distribution emit for k=5 (mandatory report; mirrors k=3 pattern).
fn _v5_paraphrase_axis_distribution_emit_k5() {
    println("  axis_distribution (N=150 paraphrase variants, k=5 per base):")
    println("    v4_baseline (mixed)  = 75  (15 base × 5)")
    println("    identity             = 15  (3 base × 5)")
    println("    agency               = 15  (3 base × 5)")
    println("    phenomenal           = 15  (3 base × 5)")
    println("    temporal             = 15  (3 base × 5)")
    println("    social               = 15  (3 base × 5)")
    println("    total                = 150 (30 base × 5 variants — amplification path 2 retest)")
}

// Distribution emit (mandatory report; mirrors _v4_axis_distribution_emit
// at variant granularity). Used by Gate G PIV unlock dashboards.
fn _v5_paraphrase_axis_distribution_emit() {
    println("  axis_distribution (N=90 paraphrase variants, k=3 per base):")
    println("    v4_baseline (mixed)  = 45  (15 base × 3)")
    println("    identity             = 9   (3 base × 3)")
    println("    agency               = 9   (3 base × 3)")
    println("    phenomenal           = 9   (3 base × 3)")
    println("    temporal             = 9   (3 base × 3)")
    println("    social               = 9   (3 base × 3)")
    println("    total                = 90  (30 base × 3 variants — Gate G PIV unlock)")
}

