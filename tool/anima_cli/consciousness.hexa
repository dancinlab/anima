    println("")
    println("───── c3-aggregation-rule-v3 ALT-AGG-1 (P5 v3: PPR_v3 ≥ 0.25, C3.4 anchor + ≥1 corroboration) ─────")
    println(" rule = c3_4_anchor_AND_at_least_one_of_c3_1_c3_2_c3_3, PPR_v3 ≥ 0.25 (SSOT, 2026-05-08 iter7 (d))")
