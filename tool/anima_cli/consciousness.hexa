fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    let json_only = _arg_present(argv, "--json")
    let model = _arg_value(argv, "--model", "default")

    // first positional = subcmd (simple / full) or model alias
    let mut sub = "simple"
    let mut model_arg = model
    if len(argv) > 0 {
        let first = _str(argv[0])
        if !first.starts_with("--") {
            if first == "simple" || first == "full" {
                sub = first
                if len(argv) > 1 && !_str(argv[1]).starts_with("--") {
                    model_arg = _str(argv[1])
                }
            } else {
                model_arg = first
            }
        }
    }

    if sub == "full" {
        sub_full(model_arg, json_only)
        return
    }
    sub_simple(model_arg, json_only)
}
