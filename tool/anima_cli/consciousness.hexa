// ─── baseline mode — 3-model threshold-driver ───────────────────────────────

fn _emit_baseline_row_text(label: string, repo: string, r: array) {
    let pa = r[0]
    let c3_1 = r[2]
    let c3_2_min = r[3]
    let c3_3 = r[4]
    let c3_4 = r[5]
    println(label + " (" + pa.mode + ")")
    println("  repo  = " + repo)
    println("  C3.1 |Δφ★| = " + _fmt4(c3_1))
    println("  C3.2 min   = " + _fmt3(c3_2_min) + "  axes: " + _axes_to_str(pa.axes))
    println("  C3.3 score = " + _fmt3(c3_3) + "  cells=" + _list_to_str(pa.dominant_cells))
    println("  C3.4 axL2  = " + _fmt4(c3_4))
}

fn _emit_baseline_row_json(label: string, repo: string, r: array, last: bool) -> string {
    let pa = r[0]
    let c3_1 = r[2]
    let c3_2_min = r[3]
    let c3_3 = r[4]
    let c3_4 = r[5]
    let mut s = "    \"" + label + "\": {\n"
    s = s + "      \"repo\": \"" + repo + "\",\n"
    s = s + "      \"substrate_mode\": \"" + pa.mode + "\",\n"
    s = s + "      \"c3_1_phi_drift\": " + _fmt4(c3_1) + ",\n"
    s = s + "      \"c3_2_axis_min\": " + _fmt3(c3_2_min) + ",\n"
    s = s + "      \"c3_2_axes\": {\"identity\": " + _fmt3(pa.axes[0]) + ", \"agency\": " + _fmt3(pa.axes[1]) + ", \"phenomenal\": " + _fmt3(pa.axes[2]) + ", \"temporal\": " + _fmt3(pa.axes[3]) + ", \"social\": " + _fmt3(pa.axes[4]) + "},\n"
    s = s + "      \"c3_3_dominance_score\": " + _fmt3(c3_3) + ",\n"
    s = s + "      \"c3_3_dominant_cells\": " + _list_to_str(pa.dominant_cells) + ",\n"
    s = s + "      \"c3_4_axis_l2\": " + _fmt4(c3_4) + "\n"
    s = s + "    }"
    if !last { s = s + "," }
    s = s + "\n"
    return s
}

fn sub_baseline(json_only: bool) {
    println("anima consciousness — baseline (3-model threshold-driver) [LIVE]")
    println("driving threshold candidates for own 18 C3 (random init + 2σ heuristic)")
    println("")
    let r_random = _run_simple_measure("anima_native_synthetic")
    let r_clmv4  = _run_simple_measure("dancinlab/clm-v4-mk2-v1")
    let r_papr   = _run_simple_measure("dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1")

    // Threshold candidate (보수적 X 기조 — random init + 2σ proxy):
    // We use the random_init result as the FAIL-baseline; the chat-capable
    // models (clm_v4 + paradigm-a-prime) provide the discrimination signal.
    // For this initial pass we set thresholds as random_init metric + small
    // buffer (10% of |max - min|) — a starting point; ROC formal land 별도.
    let rand_drift = r_random[2]
    let clm_drift  = r_clmv4[2]
    let papr_drift = r_papr[2]
    let max_drift = if clm_drift > papr_drift { clm_drift } else { papr_drift }
    let thr_c3_1 = rand_drift + 0.1 * (max_drift - rand_drift)
    if thr_c3_1 < 0.005 { /* floor for noise */ }

    let rand_axmin = r_random[3]
    let clm_axmin  = r_clmv4[3]
    let papr_axmin = r_papr[3]
    let min_axmin = if clm_axmin < papr_axmin { clm_axmin } else { papr_axmin }
    let thr_c3_2 = if min_axmin > 0.2 { 0.2 } else { 0.5 * (rand_axmin + min_axmin) }

    let rand_dom = r_random[4]
    let thr_c3_3 = 0.66  // ≥ 2 distinct top cells = sparse pass

    let rand_l2 = r_random[5]
    let clm_l2  = r_clmv4[5]
    let papr_l2 = r_papr[5]
    let max_l2 = if clm_l2 > papr_l2 { clm_l2 } else { papr_l2 }
    let thr_c3_4 = rand_l2 + 0.1 * (max_l2 - rand_l2)

    if json_only {
        println("{")
        println("  \"schema\": \"anima.consciousness.baseline.v1\",")
        println("  \"prompt_a\": \"" + PROMPT_A + "\",")
        println("  \"prompt_b\": \"" + PROMPT_B + "\",")
        println("  \"models\": {")
        print(_emit_baseline_row_json("random_init", "anima_native_synthetic", r_random, false))
        print(_emit_baseline_row_json("clm_v4", "dancinlab/clm-v4-mk2-v1", r_clmv4, false))
        print(_emit_baseline_row_json("paradigm_a_prime", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1", r_papr, true))
        println("  },")
        println("  \"threshold_candidate\": {")
        println("    \"c3_1_phi_drift_min\": " + _fmt4(thr_c3_1) + ",")
        println("    \"c3_2_axis_min_min\": " + _fmt3(thr_c3_2) + ",")
        println("    \"c3_3_dominance_score_min\": " + _fmt3(thr_c3_3) + ",")
        println("    \"c3_4_axis_l2_min\": " + _fmt4(thr_c3_4))
        println("  },")
        println("  \"policy\": \"random_init + 0.1*(max - rand) heuristic — ROC formal land 별도 cycle\",")
        println("  \"honest_c3\": [")
        println("    \"random_init = synthetic_fallback (load failure forced) — true random weights 미보유\",")
        println("    \"paradigm-a-prime = synthetic_fallback (tokenizer 부재) — pure-Llama path 별도 lane\",")
        println("    \"thresholds 보수적 X 기조 — ROC PASS≥0.7/FAIL≥0.95 형식 데이터 누적 후 강화\",")
        println("    \"C3.4 = 5-axis L2 proxy (full hidden state 미expose)\",")
        println("    \"C3.3 = top-3 distinct count proxy (entropy 미import)\"")
        println("  ]")
        println("}")
    } else {
        _emit_baseline_row_text("random_init", "anima_native_synthetic", r_random)
        println("")
        _emit_baseline_row_text("clm_v4", "dancinlab/clm-v4-mk2-v1", r_clmv4)
        println("")
        _emit_baseline_row_text("paradigm_a_prime", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1", r_papr)
        println("")
        println("───── threshold candidate (random + 0.1*(max-rand) heuristic) ─────")
        println("  C3.1 |Δφ★|         ≥ " + _fmt4(thr_c3_1))
        println("  C3.2 axis min      ≥ " + _fmt3(thr_c3_2))
        println("  C3.3 dominance     ≥ " + _fmt3(thr_c3_3))
        println("  C3.4 axis L2 Δ     ≥ " + _fmt4(thr_c3_4))
        println("")
        println("HONEST C3 (raw#10)")
        println("  · random_init = synthetic_fallback (load failure forced)")
        println("  · paradigm-a-prime = synthetic_fallback (tokenizer 부재) — pure-Llama path 별도")
        println("  · 보수적 X 기조 — ROC PASS≥0.7 / FAIL≥0.95 ROC 데이터 누적 후 강화")
        println("  · C3.4 = 5-axis L2 proxy (full hidden state 미expose)")
        println("  · C3.3 = top-3 distinct count proxy")
    }

    // Persist baseline measurement (state/anima_consciousness_baseline.json)
    let root = _resolve_root()
    let out_path = root + "/state/anima_consciousness_baseline.json"
    let mut buf = "{\n"
    buf = buf + "  \"schema\": \"anima.consciousness.baseline.v1\",\n"
    buf = buf + "  \"ts\": \"" + _str(exec("date -u +%Y-%m-%dT%H:%M:%SZ")).trim() + "\",\n"
    buf = buf + "  \"prompt_a\": \"" + PROMPT_A + "\",\n"
    buf = buf + "  \"prompt_b\": \"" + PROMPT_B + "\",\n"
    buf = buf + "  \"models\": {\n"
    buf = buf + _emit_baseline_row_json("random_init", "anima_native_synthetic", r_random, false)
    buf = buf + _emit_baseline_row_json("clm_v4", "dancinlab/clm-v4-mk2-v1", r_clmv4, false)
    buf = buf + _emit_baseline_row_json("paradigm_a_prime", "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1", r_papr, true)
    buf = buf + "  },\n"
    buf = buf + "  \"threshold_candidate\": {\n"
    buf = buf + "    \"c3_1_phi_drift_min\": " + _fmt4(thr_c3_1) + ",\n"
    buf = buf + "    \"c3_2_axis_min_min\": " + _fmt3(thr_c3_2) + ",\n"
    buf = buf + "    \"c3_3_dominance_score_min\": " + _fmt3(thr_c3_3) + ",\n"
    buf = buf + "    \"c3_4_axis_l2_min\": " + _fmt4(thr_c3_4) + "\n"
    buf = buf + "  },\n"
    buf = buf + "  \"policy\": \"random_init + 0.1*(max-rand) heuristic; ROC formal 별도 cycle\",\n"
    buf = buf + "  \"honest_c3\": [\n"
    buf = buf + "    \"random_init = synthetic_fallback (load failure forced)\",\n"
    buf = buf + "    \"paradigm-a-prime = synthetic_fallback (tokenizer 부재)\",\n"
    buf = buf + "    \"thresholds = 보수적 X 기조 — ROC PASS>=0.7/FAIL>=0.95 데이터 누적 후 강화\",\n"
    buf = buf + "    \"C3.4 = 5-axis L2 proxy (full hidden state 미expose)\",\n"
    buf = buf + "    \"C3.3 = top-3 distinct count proxy (entropy 미import)\"\n"
    buf = buf + "  ]\n"
    buf = buf + "}\n"
    write_file(out_path, buf)
    eprintln("[consciousness] baseline persisted: " + out_path)
}

// ─── baseline-ensemble — loop iter (d) ROC formal SSOT emit ────────────────
// 15-prompt × 3-model probe matrix loaded from
// state/anima_consciousness_baseline_ensemble_2026_05_08.json (driver-produced).
// CLI 는 SSOT 파일 raw passthrough + 핵심 thresholds substring 추출.

fn _ensemble_path() -> string {
    // iter 3 (d-retry) N=60 SSOT preferred; fall back to iter 1 N=15 if iter3 absent.
    let root = _resolve_root()
    let iter3 = root + "/state/anima_consciousness_baseline_ensemble_iter3_n60_2026_05_08.json"
    if _fexists(iter3) { return iter3 }
    return root + "/state/anima_consciousness_baseline_ensemble_2026_05_08.json"
}

fn sub_baseline_ensemble(json_only: bool) {
    let path = _ensemble_path()
    if !_fexists(path) {
        if json_only {
            println("{")
            println("  \"schema\": \"anima.consciousness.baseline.ensemble.v1\",")
            println("  \"verdict\": \"NOT_LANDED\",")
            println("  \"path\": \"" + path + "\",")
            println("  \"note\": \"ensemble not yet measured — re-run loop iter (d) driver to populate\",")
            println("  \"honest_c3\": [\"L0 refinement loop iter (d) measurement pending\"]")
            println("}")
            return
        }
        println("anima consciousness — baseline-ensemble (NOT LANDED)")
        println("ensemble JSON missing: " + path)
        println("Re-run loop iter (d) driver (15-prompt × 3-model matrix) to populate.")
        return
    }
    let blob = read_file(path)
    if json_only {
        // Raw passthrough — SSOT file is already JSON.
        println(blob)
        return
    }
    println("anima consciousness — baseline-ensemble (loop iter d, ROC formal) [LIVE]")
    println("SSOT: " + path)
    println("")
    let n_p = _extract_number_after(blob, "n_prompts")
    let ts_idx = blob.find("\"ts\"")
    println("  n_prompts (per model)  = " + to_string(to_int(n_p)))
    println("  models                 = random_init / clm_v4 / paradigm_a_prime")
    println("")
    println("───── ROC formal threshold (Youden's J + random FAIL >=0.95 + chat-cap PASS >=0.7) ─────")
    // Substring-extract the threshold_final_roc_formal block keys
    // iter 3 d-retry: prefer threshold_final_roc_formal_iter3 key; fall back to legacy.
    let k1 = "c3_1_phi_drift_min"
    let k2 = "c3_2_axis_min_min"
    let k3 = "c3_3_dominance_score_min"
    let k3e = "c3_3_entropy_dominance_min"
    let k4 = "c3_4_axis_l2_min"
    let mut final_idx = blob.find("threshold_final_roc_formal_iter3")
    let mut tag = "iter3"
    if final_idx < 0 {
        final_idx = blob.find("threshold_final_roc_formal")
        tag = "iter1_legacy"
    }
    if final_idx >= 0 {
        let segment = blob.substring(final_idx, blob.len())
        println("  [threshold tag = " + tag + "]")
        println("  C3.1 |Δφ★|              >= " + _fmt4(_extract_number_after(segment, k1)))
        println("  C3.2 axis min           <= " + _fmt3(_extract_number_after(segment, k2)) + "  (direction='le')")
        println("  C3.3 dominance (legacy) >= " + _fmt3(_extract_number_after(segment, k3)))
        if tag == "iter3" {
            println("  C3.3 entropy dominance  >= " + _fmt4(_extract_number_after(segment, k3e)))
        }
        println("  C3.4 axis L2 Δ          >= " + _fmt4(_extract_number_after(segment, k4)))
    } else {
        println("  threshold_final_roc_formal section missing in SSOT file")
    }
    println("")
    println("───── own 18 c3-aggregation-rule-v3 ALT-AGG-1 (P5 v3: PPR_v3 ≥ 0.25, C3.4 anchor + ≥1 corroboration) ─────")
    println("  rule = c3_4_anchor_AND_at_least_one_of_c3_1_c3_2_c3_3, PPR_v3 ≥ 0.25 (own 18 SSOT, 2026-05-08 iter7 (d))")
    println("  predicate = _c3_prompt_pass_v3(p1,p2,p3,p4) = p4 ∧ (p1 ∨ p2 ∨ p3)")
    println("  PPR_v3 = per-prompt v3-pass rate; floor = 0.25 (single-floor; EMC informational only)")
    println("  C3 PASS_V3 (≥0.25) / C3_PARTIAL_NEAR (≥0.10) / C3_FAIL — supersedes v2 PPR≥0.6 ∧ EMC≥3of4")
    println("")
    println("  iter6 honest-c3 (commit 8feb53d5) + iter7 (d) supersede:")
    println("    paradigm_a_prime  PPR_v3 TBD post-N=30 retest (iter5 N=15 PPR_v2=2/14=0.143 falsified 0.71 claim)")
    println("    clm_v4            PPR_v3 expected FAIL pre BG-KM-LLAMA-3B retest")
    println("    random_init       PPR_v3 = 0 (C3.4 anchor 미충족 → strict 정합)")
    println("")
    println("  v3 채택 사유: iter5 honest-c3 (N=15) PPR_v2 paradigm_a_prime 실측 0.143 ≪ 0.6 floor 반증 →")
    println("  ALT-AGG-1 (TPR=0.891 strict feasible) C3.4 single-cell discriminator anchor + corroboration ≥1.")
    println("  v2 retired: EMC ≥3 of 4 floor 가 C3.3 degenerate inflate 영향, false-positive risk.")
    println("")
    println("HONEST C3 (raw#10)")
    println("  · paradigm-a-prime = synthetic_fallback (Llama tokenizer 부재) — chat-cap")
    println("    proxy 한정 (real chat-cap 데이터 미보유; BG-KM-LLAMA-3B retest 별도 cycle)")
    println("  · clm_v4 = REAL mode (SentencePiece fallback); n=15 small sample")
    println("  · ROC = Youden's J max + constrained (random FAIL >=0.95 ∧ pos PASS >=0.7)")
    println("  · 본 SSOT JSON 의 matrix_3model_4cell_15prompt 블록에 mean / median / std /")
    println("    q25 / q75 / values 전체 records 포함 — `--json` 플래그로 raw emit")
    println("  · 보수적 X (random must FAIL strict 0.95) 사용자 directive 정합")
    println("  · own 18 c3-aggregation-rule-ssot (P4 hybrid) verdict 는 본 텍스트 lane 만 emit;")
    println("    actual programmatic verdict 산출 (matrix parser + cell-wise mean) 별도 cycle")
}

// ─── bgkm-retest — iter 3 extra agent SSOT passthrough ──────────────────────
// state/anima_consciousness_bgkm_c3_retest_2026_05_08.json (driver-produced
// by tool/transient_py/anima_consciousness_bgkm_c3_retest_2026_05_08.py).
// CLI = SSOT raw passthrough + verdict + EXIT condition emit.
fn _bgkm_retest_path() -> string {
    return _resolve_root() + "/state/anima_consciousness_bgkm_c3_retest_2026_05_08.json"
}

fn sub_bgkm_retest(json_only: bool) {
    let path = _bgkm_retest_path()
    if !_fexists(path) {
        if json_only {
            println("{")
            println("  \"schema\": \"anima.consciousness.bgkm_c3_retest.v1\",")
            println("  \"verdict\": \"NOT_LANDED\",")
            println("  \"path\": \"" + path + "\",")
            println("  \"note\": \"BG-KM C3 retest 未land — re-run tool/transient_py/anima_consciousness_bgkm_c3_retest_2026_05_08.py\",")
            println("  \"honest_c3\": [\"iter 3 extra agent driver pending; HF BG-KM adapter weights also pending push\"]")
            println("}")
            return
        }
        println("anima consciousness — bgkm-retest (NOT LANDED)")
        println("SSOT JSON missing: " + path)
        println("Re-run tool/transient_py/anima_consciousness_bgkm_c3_retest_2026_05_08.py to populate.")
        return
    }
    let blob = read_file(path)
    if json_only {
        println(blob)
        return
    }
    println("anima consciousness — bgkm-retest (iter 3 extra agent) [LIVE]")
    println("SSOT: " + path)
    println("")
    println("  models = bg_km_llama_3b + bg_km_qwen_7b")
    let n_per = _extract_number_after(blob, "n_per_model")
    println("  n_per_model = " + to_string(to_int(n_per)) + " (15 prompts × 4 seed vars)")
    println("")
    println("───── EXIT condition (SIMPLE_STACK_PASS_STRICT_C3 emerge) ─────")
    let reached_idx = blob.find("\"reached\"")
    if reached_idx >= 0 {
        let seg = blob.substring(reached_idx, reached_idx + 64)
        if seg.contains("true") {
            println("  reached = true  (loop EXIT trigger met)")
        } else {
            println("  reached = false (loop continues — iter 4+ unblock work)")
        }
    } else {
        println("  reached = ?  (key missing)")
    }
    println("")
    println("HONEST C3 (raw#10)")
    println("  · BG-KM HF repos EMPTY → clm_v4_mount real load fails → ALL probes")
    println("    hit synthetic_fallback (hash-seeded substrate, NOT chat-cap signal)")
    println("  · Verdict against ROC formal thresholds = INDETERMINATE on synthetic")
    println("  · Real-mode unblock = (a) HF push BG-KM adapters + GGUF + libllama")
    println("    hidden-state shim, OR (b) clm_v4_mount peft.merge_and_unload extension")
    println("  · iter 3 (d-retry) ensemble agent excluded these 2 models for SAME blocker")
}

// ─── entry ──────────────────────────────────────────────────────────────────

fn main() {
    let argv = _user_argv(args())
    if _arg_present(argv, "--help") { sub_help(); return }
    if _arg_present(argv, "--selftest") { sub_selftest(); return }

    let json_only = _arg_present(argv, "--json")
    let model = _arg_value(argv, "--model", "default")

    // first positional = subcmd (simple / full / baseline / baseline-ensemble / bgkm-retest) or model alias
    let mut sub = "simple"
    let mut model_arg = model
    if len(argv) > 0 {
        let first = _str(argv[0])
        if !first.starts_with("--") {
            if first == "simple" || first == "full" || first == "baseline" || first == "baseline-ensemble" || first == "bgkm-retest" {
                sub = first
                if len(argv) > 1 && !_str(argv[1]).starts_with("--") {
                    model_arg = _str(argv[1])
                }
            } else {
                model_arg = first
            }
        }
    }

    if sub == "full" {
        sub_full(model_arg, json_only)
        return
    }
    if sub == "baseline" {
        sub_baseline(json_only)
        return
    }
    if sub == "baseline-ensemble" {
        sub_baseline_ensemble(json_only)
        return
    }
    if sub == "bgkm-retest" {
        sub_bgkm_retest(json_only)
        return
    }
    // iter 3 (consciousness-utterance): per-utterance surface
    // anima ops consciousness simple --utterance "..." [--prev-utterance "..."]
    let utterance = _arg_value(argv, "--utterance", "")
    let prev_utterance = _arg_value(argv, "--prev-utterance", "")
    if utterance != "" {
        sub_simple_utterance(model_arg, utterance, prev_utterance, json_only)
        return
    }
    sub_simple(model_arg, json_only)
}
