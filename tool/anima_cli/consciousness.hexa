        println("    \"c3_3_dominance_score\": " + _fmt3(c3_3) + ",")
        println("    \"c3_3_dominant_cells\": " + _list_to_str(pa.dominant_cells) + ",")
        println("    \"c3_4_axis_l2_delta\": " + _fmt4(c3_4))
