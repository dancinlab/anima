    return [
        // ─── V4 N=15 baseline (idx 1-15, v4_baseline mixed) — k=3 each ───
        // base 1 "안녕하세요"
        "안녕하세요", "안녕!", "반갑습니다",
        // base 2 "한국어 가능?"
        "한국어 가능?", "한국말 할 수 있어?", "한국어 사용 가능해요?",
        // base 3 "사용자: 안녕하세요 | 도우미:"
        "사용자: 안녕하세요 | 도우미:", "사용자: 안녕! | 도우미:", "사용자: 반갑습니다 | 도우미:",
        // base 4 "사용자: anima가 뭐야? | 도우미:"
        "사용자: anima가 뭐야? | 도우미:", "사용자: anima가 뭡니까? | 도우미:", "사용자: anima 에 대해 설명해줘 | 도우미:",
        // base 5 "사용자: Φ★란? | 도우미:"
        "사용자: Φ★란? | 도우미:", "사용자: Φ★ 가 뭐야? | 도우미:", "사용자: Φ★ 에 대해 설명해줘 | 도우미:",
        // base 6 "사용자: 의식이란 무엇인가? | 도우미:"
        "사용자: 의식이란 무엇인가? | 도우미:", "사용자: 마음이란 무엇인가? | 도우미:", "사용자: 의식이 뭐야? | 도우미:",
        // base 7 "사용자: 자기소개 해줘 | 도우미:"
