//   sft-1-8    v4_baseline PPR_v4 = 0.429 (≥ 0.40 floor + MTRP=+0.429) ⇒ PASS clean
fn _c3_4_pass_v4(v: float) -> bool { return v >= 0.20 }

fn _c3_prompt_pass_v4(p1: bool, p2: bool, p3: bool, p4_at_020: bool) -> bool {
    if !p4_at_020 { return false }
    let corroborate = (if p1 { 1 } else { 0 }) + (if p2 { 1 } else { 0 }) + (if p3 { 1 } else { 0 })
