//    full = F1-F8 full-stack 측정 / baseline = 3-model threshold-driver.
//
//  SUBCOMMANDS
//    anima consciousness                     default = simple
//    anima consciousness simple [<model>]    own 18 PASS_STRICT_C3 측정
//    anima consciousness full [<model>]      own 18 F1-F8 full-stack 측정
//    anima consciousness baseline            3-model 비교 + threshold candidate
//    anima consciousness --json
//    anima consciousness --selftest
//    anima consciousness --help
//
