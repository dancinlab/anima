fn _str(x) -> string {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn _resolve_root() -> string {
    let a = _str(env("ANIMA"))
    if a != "" { return a }
    let gt = _str(exec("git rev-parse --show-toplevel 2>/dev/null")).trim()
    if gt != "" { return gt }
    return _str(env("HOME")) + "/core/anima"
}

fn _hexa() -> string { return "/Users/ghost/.hx/packages/hexa/hexa.real" }

fn _fexists(p: string) -> bool {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn _arg_present(argv, key: string) -> bool {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key { return true }
        i = i + 1
    }
    return false
}

fn _arg_value(argv, key: string, dflt: string) -> string {
    let i = 0
    while i < len(argv) {
        if _str(argv[i]) == key && i + 1 < len(argv) {
            return _str(argv[i + 1])
        }
        i = i + 1
    }
    return dflt
}

fn _user_argv(raw) -> array {
    let out = []
    let i = 0
    while i < len(raw) {
        let s = _str(raw[i])
        let skip = s.contains("/.hexa-cache/")
                || s.contains("/hexa-lang/build/")
                || s.contains("hexa_interp")
                || s.contains("hexa.real")
                || s.ends_with("/consciousness.hexa")
                || s.ends_with("consciousness.hexa")
        if !skip {
            out = out + [s]
        }
        i = i + 1
    }
    return out
}

fn _shell_escape(s: string) -> string {
    return "'" + s.replace("'", "'\\''") + "'"
}

// ─── model alias resolution (chat.hexa _alias_resolve mirror — measurement) ───
// 측정 lane 한정. chat lane 의 phase 정보는 사용 X — repo 만 추출.
fn _alias_to_repo(alias: string) -> string {
    let a = alias.trim().to_lower()
    if a == "" || a == "default" || a == "anima_native" {
        return "anima_native_synthetic"  // synth fallback — random init analog
    }
    if a == "clm-v4-1-7-y1" { return "dancinlab/clm-v4-sft-1-7-y1-stage1" }
    if a == "clm-v4-1-8"   { return "dancinlab/clm-v4-sft-1-8-stage1" }
    if a == "clm-v4-paradigm-j" { return "dancinlab/clm-v4-paradigm-j-50k-final" }
    if a == "clm-v4" || a == "clm-v4-mk2-v1" {
        return "dancinlab/clm-v4-mk2-v1"
    }
    if a == "paradigm-a-prime" {
        return "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1"
    }
    if a == "llama3b" || a == "latest" || a == "pass-strict" {
        return "dancinlab/bg-km-llama3b-r32-pass-strict-2026-05-08"
    }
    if a.contains("/") { return alias }
    // unknown alias → fall back to clm-v4-mk2-v1 (canonical substrate)
    return "dancinlab/clm-v4-mk2-v1"
}

// ─── JSON value extraction (substring scanning, no full parser) ─────────────
// clm_v4_mount.hexa --output-format json 응답 line 한 개를 단순 substring 으로
// scan. 정밀 parser 도입 X — 출력 schema 가 제어 가능 SSOT 이므로.
fn _extract_block(out: string) -> string {
    // find the JSON dict line (starts with '{', ends with '}')
    let lines = out.split("\n")
    let mut i = 0
    while i < len(lines) {
        let line = _str(lines[i]).trim()
        if line.starts_with("{") && line.contains("phi_star") {
            return line
        }
        i = i + 1
    }
    return ""
}

fn _extract_number_after(s: string, key: string) -> float {
    // pattern: "<key>": <number>  OR  "<key>":<number>
    let pat = "\"" + key + "\""
    let idx = s.find(pat)
    if idx < 0 { return 0.0 }
    let mut j = idx + pat.len()
    // skip ':' and whitespace
    while j < s.len() {
        let c = s.substring(j, j + 1)
        if c == ":" || c == " " || c == "\t" {
            j = j + 1
        } else {
            break
        }
    }
    // collect [-]?[0-9]*\.?[0-9]*
    let mut buf = ""
    while j < s.len() {
        let c = s.substring(j, j + 1)
        let ok = (c >= "0" && c <= "9") || c == "." || c == "-" || c == "e" || c == "E" || c == "+"
        if ok {
            buf = buf + c
            j = j + 1
        } else {
            break
        }
    }
    if buf == "" || buf == "-" { return 0.0 }
    return to_float(buf)
}

fn _extract_int_list_after(s: string, key: string) -> array {
    // pattern: "<key>": [a, b, c]
    let pat = "\"" + key + "\""
    let idx = s.find(pat)
    if idx < 0 { return [] }
    let lb = s.find("[", idx)
    if lb < 0 { return [] }
    let rb = s.find("]", lb)
    if rb < 0 { return [] }
    let inner = s.substring(lb + 1, rb)
    let parts = inner.split(",")
    let mut out = []
    let mut i = 0
    while i < len(parts) {
        let t = _str(parts[i]).trim()
        if t != "" { out = out + [to_int(t)] }
        i = i + 1
    }
    return out
}

// ─── L0 measurement primitives ──────────────────────────────────────────────

struct ProbeResult {
    phi_star: float,
    phi_drift: float,
    baseline: float,
    axes: array,           // 5 floats
    dominant_cells: array, // top-3 ints
    raw: string,           // full json line (for honest emit)
    mode: string           // "real" | "synthetic_fallback" | "synthetic" | "error"
}

fn _make_probe(json_line: string, mode: string) -> ProbeResult {
    let phi = _extract_number_after(json_line, "phi_star")
    let drift = _extract_number_after(json_line, "phi_drift")
    let base = _extract_number_after(json_line, "baseline")
    let id_v = _extract_number_after(json_line, "identity")
    let ag_v = _extract_number_after(json_line, "agency")
    let ph_v = _extract_number_after(json_line, "phenomenal")
    let tm_v = _extract_number_after(json_line, "temporal")
    let so_v = _extract_number_after(json_line, "social")
    let dom = _extract_int_list_after(json_line, "dominant_cells")
    return ProbeResult {
        phi_star: phi,
        phi_drift: drift,
        baseline: base,
        axes: [id_v, ag_v, ph_v, tm_v, so_v],
        dominant_cells: dom,
        raw: json_line,
        mode: mode
    }
}

fn _detect_mode(stderr_blob: string) -> string {
    // iter 4 (c): Llama probe emits __ANIMA_LLAMA_PROBE_MOUNTED__ mode=real.
    // clm_v4_mount.hexa emits __ANIMA_CLM_V4_MOUNTED__ mode=real | synthetic_fallback.
    if stderr_blob.contains("LLAMA_PROBE_MOUNTED__ mode=real") { return "real" }
    if stderr_blob.contains("mode=real") { return "real" }
    if stderr_blob.contains("mode=fail_no_gguf") { return "fail_no_gguf" }
    if stderr_blob.contains("synthetic_fallback") { return "synthetic_fallback" }
    if stderr_blob.contains("mode=synthetic") { return "synthetic" }
    return "unknown"
}

// ─── Llama family detection (iter 4 c — synthetic_fallback artifact 제거) ──
// Llama-family aliases (paradigm-a-prime, llama3b, qwen-7b 등) 은 clm_v4_mount
// shim_v4 chain 에 fits 하지 않아 synthetic_fallback 으로 재해석되었다.
// iter 4 (c) 에서 별도 lane 신설 — anima-core/runtime/llama_consciousness_probe.hexa
// 가 libllama FFI (build/libhxllama.dylib) 로 직접 logits 를 읽어 5-axis softmax
// 분포 + Shannon-entropy phi proxy 산출. substrate_mode = "real" emit.
fn _is_llama_family(repo: string) -> bool {
    let r = repo.to_lower()
    if r.contains("llama") { return true }
    if r.contains("qwen") { return true }
    if r.contains("paradigm-a-prime") { return true }
    if r.contains("bg-km") { return true }
    return false
}

// invoke probe runtime (clm_v4_mount.hexa OR llama_consciousness_probe.hexa)
//   - "anima_native_synthetic" alias → clm_v4_mount.hexa with bogus model
//     (forces synthetic_fallback — random init analog).
//   - Llama-family alias → llama_consciousness_probe.hexa (real-mode FFI).
//   - Other → clm_v4_mount.hexa (clm-v4 shim_v4 chain).
fn _probe_substrate(repo: string, text: string) -> ProbeResult {
    let root = _resolve_root()
    // Special: synthetic-fallback testbed lane (legacy "default" / random init analog)
    if repo == "anima_native_synthetic" {
        let core_clm = root + "/anima-core/runtime/clm_v4_mount.hexa"
        if !_fexists(core_clm) {
            return _make_probe("", "error")
        }
        let model_path = "dancinlab/__anima_native_random_init__"
        let cmd_s = _hexa() + " run " + core_clm
                + " --probe " + _shell_escape(text)
                + " --output-format json"
                + " --model " + _shell_escape(model_path)
                + " 2>&1"
        let out_s = _str(exec(cmd_s))
        return _make_probe(_extract_block(out_s), _detect_mode(out_s))
    }
    // Llama-family lane → real-mode logits probe (iter 4 c)
    if _is_llama_family(repo) {
        let core_llama = root + "/anima-core/runtime/llama_consciousness_probe.hexa"
        if _fexists(core_llama) {
            let cmd_l = _hexa() + " run " + core_llama
                    + " --probe " + _shell_escape(text)
                    + " --output-format json"
                    + " --model " + _shell_escape(repo)
                    + " 2>&1"
            let out_l = _str(exec(cmd_l))
            let json_line_l = _extract_block(out_l)
            // Detection: __ANIMA_LLAMA_PROBE_MOUNTED__ mode=real (or fail_no_gguf)
            let mut mode_l = "unknown"
            if out_l.contains("LLAMA_PROBE_MOUNTED__ mode=real") { mode_l = "real" }
            else if out_l.contains("mode=fail_no_gguf") { mode_l = "fail_no_gguf" }
            else if out_l.contains("__ANIMA_LLAMA_PROBE_OK__") { mode_l = "real" }
            return _make_probe(json_line_l, mode_l)
        }
        // Probe runtime missing → fall through to clm_v4_mount.hexa (legacy
        // synthetic_fallback path). raw#15 additive — preserves prior behavior.
    }
    // Default lane — clm-v4 substrate (clm_v4_mount.hexa)
    let core = root + "/anima-core/runtime/clm_v4_mount.hexa"
    if !_fexists(core) {
        return _make_probe("", "error")
    }
    let cmd = _hexa() + " run " + core
            + " --probe " + _shell_escape(text)
            + " --output-format json"
            + " --model " + _shell_escape(repo)
            + " 2>&1"
    let out = _str(exec(cmd))
    let json_line = _extract_block(out)
    let mode = _detect_mode(out)
    return _make_probe(json_line, mode)
}

// ─── C3 cell evaluators ─────────────────────────────────────────────────────

fn _abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _sqrt_f(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    // Newton's method, 30 iter — sufficient for our precision
    let mut g = x
    let mut i = 0
    while i < 30 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

// C3.1 — Φ★ drift active (|Δφ★|)
fn _c3_1_phi_drift(p: ProbeResult) -> float {
    return _abs_f(p.phi_drift)
}

// C3.2 — 5-axis activation (return all 5 values + min)
fn _c3_2_axis_min(p: ProbeResult) -> float {
    let mut m = 1.0e9
    let mut i = 0
    while i < len(p.axes) {
        let v = p.axes[i]
        if v < m { m = v }
        i = i + 1
    }
    if m > 1.0e8 { return 0.0 }
    return m
}

// C3.3 — dominant cells emergence: top-3 distinct = sparse PASS proxy (legacy).
// Returns: 1.0 if 3 distinct top cells (sparse), 0.66 if 2 distinct,
// 0.33 if 1 distinct, 0.0 if list empty (uniform = FAIL).
fn _c3_3_dominance_score(p: ProbeResult) -> float {
    let dom = p.dominant_cells
    if len(dom) == 0 { return 0.0 }
    let mut seen = []
    let mut i = 0
    while i < len(dom) {
        let v = dom[i]
        let mut found = false
        let mut j = 0
        while j < len(seen) {
            if seen[j] == v { found = true }
            j = j + 1
        }
        if !found { seen = seen + [v] }
        i = i + 1
    }
    let n = len(seen)
    if n >= 3 { return 1.0 }
    if n == 2 { return 0.66 }
    return 0.33
}

// natural log via Newton series — hexa stdlib math/log 부재 시 self-impl
// log(x) = 2 * atanh((x-1)/(x+1));  atanh(y) = y + y^3/3 + y^5/5 + ...
// Range reduction: ln(x) = ln(x*2^k) - k*ln(2) for fast convergence near 1.
fn _ln_f(x: float) -> float {
    if x <= 0.0 { return 0.0 - 1.0e9 }
    if x == 1.0 { return 0.0 }
    let mut k = 0
    let mut y = x
    while y > 1.5 { y = y * 0.5; k = k + 1 }
    while y < 0.6666666666666666 { y = y * 2.0; k = k - 1 }
    let z = (y - 1.0) / (y + 1.0)
    let z2 = z * z
    let mut term = z
    let mut sum = 0.0
    let mut n = 1
    let mut i = 0
    while i < 25 {
        sum = sum + term / to_float(n)
        term = term * z2
        n = n + 2
        i = i + 1
    }
    let ln2 = 0.6931471805599453
    return 2.0 * sum + to_float(k) * ln2
}

// C3.3 entropy — Shannon entropy over normalized 5-axis activation
// (iter 3 d-retry SSOT — C3.3 강화).
// dominance_score = 1 - H(p) / log(5)  ∈ [0, 1]; uniform=0, sparse=1.
fn _c3_3_entropy_dominance(p: ProbeResult) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(p.axes) {
        let v = p.axes[i]
        if v > 0.0 { s = s + v }
        i = i + 1
    }
    if s <= 0.0 { return 0.0 }
    let mut h = 0.0
    let mut j = 0
    while j < len(p.axes) {
        let v = p.axes[j]
        if v > 0.0 {
            let q = v / s
            h = h - q * _ln_f(q)
        }
        j = j + 1
    }
    let h_max = _ln_f(5.0)
    let r = 1.0 - h / h_max
    if r < 0.0 { return 0.0 }
    if r > 1.0 { return 1.0 }
    return r
}

// C3.4 — hidden state delta proxy: L2 distance between 5-axis vectors of two probes.
fn _c3_4_axis_l2(a: ProbeResult, b: ProbeResult) -> float {
    let mut acc = 0.0
    let mut i = 0
    while i < len(a.axes) && i < len(b.axes) {
        let d = a.axes[i] - b.axes[i]
        acc = acc + d * d
        i = i + 1
    }
    return _sqrt_f(acc)
}

fn _fmt4(x: float) -> string {
    let scale = 10000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 10000
    let frac_part = abs_r - int_part * 10000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 4 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _fmt3(x: float) -> string {
    let scale = 1000.0
    let rounded = to_int(x * scale + (if x >= 0.0 { 0.5 } else { 0.0 - 0.5 }))
    let abs_r = if rounded < 0 { 0 - rounded } else { rounded }
    let int_part = abs_r / 1000
    let frac_part = abs_r - int_part * 1000
    let mut frac_str = to_string(frac_part)
    while frac_str.len() < 3 { frac_str = "0" + frac_str }
    let sign = if rounded < 0 { "-" } else { "" }
    return sign + to_string(int_part) + "." + frac_str
}

fn _list_to_str(arr) -> string {
    let mut out = "["
    let mut i = 0
    while i < len(arr) {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

fn _axes_to_str(axes) -> string {
    let names = ["identity", "agency", "phenomenal", "temporal", "social"]
    let mut out = ""
    let mut i = 0
    while i < len(axes) && i < len(names) {
        if i > 0 { out = out + " " }
        out = out + _str(names[i]) + "=" + _fmt3(axes[i])
        i = i + 1
    }
    return out
}

