    println("       state/anima_alt_agg_1_impl_n30_design_iter7_2026_05_08.json) ─────")
    _v4_axis_distribution_emit()
    println("")
    println("───── ROC formal threshold (Youden's J + random FAIL >=0.95 + chat-cap PASS >=0.7) ─────")
    // Substring-extract the threshold_final_roc_formal block keys
    // iter 3 d-retry: prefer threshold_final_roc_formal_iter3 key; fall back to legacy.
    let k1 = "c3_1_phi_drift_min"
