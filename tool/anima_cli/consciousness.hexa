        if tag == "iter3" {
            println("  C3.3 entropy dominance  >= " + _fmt4(_extract_number_after(segment, k3e)))
        }
        println("  C3.4 axis L2 Δ          >= " + _fmt4(_extract_number_after(segment, k4)))
    } else {
