// Per-prompt axis label for v5 paraphrase set (1-based idx; 90 total = 30 base × 3
// variants). Variant idx = ((base_idx - 1) * 3 + variant_offset) where variant_offset
// in {1,2,3}. Axis derived from base_idx: idx 1-45 = v4_baseline mixed (15 base × 3),
// 46-54 = identity, 55-63 = agency, 64-72 = phenomenal, 73-81 = temporal, 82-90 = social.
fn _v5_paraphrase_axis_label(idx_1based: int) -> string {
    if idx_1based <= 45 { return "v4_baseline" }
    if idx_1based <= 54 { return "identity" }
    if idx_1based <= 63 { return "agency" }
    if idx_1based <= 72 { return "phenomenal" }
    if idx_1based <= 81 { return "temporal" }
    if idx_1based <= 90 { return "social" }
    return "out_of_range"
}

// Reverse mapping: paraphrase variant idx → base prompt idx (1-based both).
// Three consecutive variants share one base. base_idx = ((idx - 1) / 3) + 1.
fn _v5_paraphrase_base_idx(idx_1based: int) -> int {
    if idx_1based < 1 { return 0 }
    if idx_1based > 90 { return 0 }
    return ((idx_1based - 1) / 3) + 1
}

