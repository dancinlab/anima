fn _ensemble_path() -> string {
    // iter 3 (d-retry) N=60 SSOT preferred; fall back to iter 1 N=15 if iter3 absent.
    let root = _resolve_root()
    let iter3 = root + "/state/anima_consciousness_baseline_ensemble_iter3_n60_2026_05_08.json"
    if _fexists(iter3) { return iter3 }
    return root + "/state/anima_consciousness_baseline_ensemble_2026_05_08.json"
}

fn sub_baseline_ensemble(json_only: bool) {
    let path = _ensemble_path()
    if !_fexists(path) {
        if json_only {
            println("{")
            println("  \"schema\": \"anima.consciousness.baseline.ensemble.v1\",")
            println("  \"verdict\": \"NOT_LANDED\",")
            println("  \"path\": \"" + path + "\",")
