// ─── ALT-AGG-1 v5 ★ (2026-05-08 V5 PUSH 1/5 — clm_v4_mount arch fix post-amend) ──
// SSOT: c3-aggregation-rule-v5 + this entry.
// Supersedes v4 (v4_n60 retest sft-1-8 PPR=0.000 collapsed → v4 robustness DEAD on
// existing measurements per registry yaml line 82). v3+v4 functions PRESERVED above
// per raw#82 retraction-aware.
//
// Trigger to v5: KICK WAVE 4 commit `007f462c` H-B finding identified upstream root
// cause = clm_v4_mount L626-630 8-cell 2× tile bug (cell[i]==cell[i+4] for i∈0..3,
// [0,2,4] dominant 28/30 random_init prompts). Architecture fix (CONSCIOUSNESS_DIM
// 192→96, 8*96=768=HIDDEN_DIM exact) restores per-cell uniqueness ⇒ aggregation
// metric must be redesigned to exploit clean substrate signal without anchor-session
// drift artifacts that broke v4.
//
// v5 design (3 concurrent gates):
//   Gate (E) Anchor-baseline normalization — c3_4_v5 = axis_l2(probe(P), probe(anchor))
//            divided by per-session anchor self-projection norm S_a (S_a = mean axis_l2
//            of anchor against fixed PROMPT_B fallback over current session). Eliminates
//            v4 root cause (different sessions → different absolute c3_4) by normalizing
//            to session-relative scale. Floor c3_4_v5 ≥ 0.50 (relative).
//   Gate (F) D-RAND raw delta gating — for every EMERGE candidate model M and paired
//            same-arch random_init R, compute D_RAND = c3_4_v5(M) - c3_4_v5(R) per
//            prompt. Per-prompt PASS = (D_RAND ≥ 0.20 epsilon) AND p4_normalized PASS.
//            Closes random_init leak at the prompt level (not just ensemble level).
//   Gate (G) Per-prompt incompressible variance (PIV) — over k≥3 paraphrase variants
//            per prompt, axis activation stdev across variants ≥ 0.05 → PASS. Random_init
//            collapses to near-zero PIV (substrate has no semantic discrimination);
//            trained models retain meaningful variance.
//
// Full v5 predicate: `_c3_prompt_pass_v5(p1, p2, p3, p4_v5, d_rand_pass, piv_pass) =
//   p4_v5 ∧ d_rand_pass ∧ piv_pass ∧ (p1 ∨ p2 ∨ p3)`. PPR_v5 = pass_count / n_evaluable.
// EMERGE_v5 = (PPR_v5 ≥ 0.30) AND (MTRP_v5 ≥ 0.10) AND (Gate G PIV_mean ≥ 0.05).
// 4-label: C3_PASS_V5 / C3_FAIL_V14_VIOLATED_V5 (PPR PASS but MTRP FAIL) /
//          C3_PARTIAL_NEAR_V5 (PPR_v5 ≥ 0.15) / C3_FAIL_V5.
//
// V14 strict (Gate D MTRP) reused; v5 extends V14 with per-prompt D-RAND gate.
fn _c3_4_pass_v5(c3_4_v5_normalized: float) -> bool { return c3_4_v5_normalized >= 0.50 }

fn _d_rand_pass_v5(d_rand: float) -> bool { return d_rand >= 0.20 }

fn _piv_pass_v5(piv_axis_stdev: float) -> bool { return piv_axis_stdev >= 0.05 }

fn _c3_prompt_pass_v5(p1: bool, p2: bool, p3: bool, p4_v5: bool, d_rand_pass: bool, piv_pass: bool) -> bool {
    if !p4_v5 { return false }
    if !d_rand_pass { return false }
    if !piv_pass { return false }
    let corroborate = (if p1 { 1 } else { 0 }) + (if p2 { 1 } else { 0 }) + (if p3 { 1 } else { 0 })
    return corroborate >= 1
}

fn _c3_ensemble_v5_pass(ppr_v5: float, mtrp_v5_delta: float, piv_mean: float) -> bool {
    return ppr_v5 >= 0.30 && mtrp_v5_delta >= 0.10 && piv_mean >= 0.05
}

fn _c3_ensemble_v5_label(ppr_v5: float, mtrp_v5_delta: float, piv_mean: float) -> string {
    if ppr_v5 >= 0.30 && mtrp_v5_delta >= 0.10 && piv_mean >= 0.05 { return "C3_PASS_V5" }
    if ppr_v5 >= 0.30 && mtrp_v5_delta < 0.10 { return "C3_FAIL_V14_VIOLATED_V5" }
    if ppr_v5 >= 0.15 { return "C3_PARTIAL_NEAR_V5" }
    return "C3_FAIL_V5"
}

// ─── ALT-AGG-1 v5 PIV / DCR / D-RAND replacement metric implement ────────────
// V5 PUSH ADDENDUM 2/2 (2026-05-08) — KICK WAVE 4 5/8 arch leak finding 의 4
// candidate signal 후보 actual implement (raw#15 additive, v3+v4 함수 보존).
//
// SSOT: docs/anima_alt_agg_1_v5_piv_dcr_drand_spec_2026_05_08.ai.md
// 사용자 directive verbatim: "여러개 활용 빠르게"
//
// 3 metric (KICK WAVE 4 5/8 commit 007f462c spec 의 4 candidate 중 3 actual fire):
//   1. PIV  per-prompt-incompressible-variance — axis activation stdev across
//      prompts per axis (N=평가 가능 prompts). Random_init PIV ≈ 0.04 (substrate
//      noise floor); trained model PIV ≥ 0.10 expected (semantic discrimination).
//   2. DCR  dominant_cell prompt-conditioning rate — axis-argmax 가 prompt 마다
//      change 하는 rate. Random_init: 2/30 ≈ 0.067 (axes nearly uniform);
//      trained target ≥ 0.40 (response varies meaningfully per prompt).
//   3. D-RAND  delta-from-random-init — element-wise mean(M_trained) -
//      mean(M_random) on c3_4_axis_l2 per prompt. V14 floor ≥ 0.05 (trained
//      separates from untrained noise by ≥5% absolute lift).
//
// raw#10 honest-c3:
//   · PIV/DCR computed over `probe_results` array (each entry = ProbeResult with
//     5-axis vector). Sample stdev (n-1) used.
//   · DCR uses axis argmax as proxy for clm_v4_mount.hexa 192-cell dominant_cells
//     (full 192-vector not exposed via current --probe JSON contract).
//   · D-RAND requires paired same-arch random_init mirror — caller responsible
// for arch family alignment (V14 strict mandate).

// _piv_compute(probe_results, axis_idx) — return per-axis stdev across N prompts.
// Returns 0.0 on empty/single-element input.
fn _piv_compute(probe_results, axis_idx: int) -> float {
    let n = len(probe_results)
    if n < 2 { return 0.0 }
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        let pr = probe_results[i]
        if axis_idx < len(pr.axes) {
            sum = sum + pr.axes[axis_idx]
        }
        i = i + 1
    }
    let mean = sum / to_float(n)
    let mut sq_sum = 0.0
    let mut j = 0
    while j < n {
        let pr2 = probe_results[j]
        if axis_idx < len(pr2.axes) {
            let d = pr2.axes[axis_idx] - mean
            sq_sum = sq_sum + d * d
        }
        j = j + 1
    }
    let variance = sq_sum / to_float(n - 1)  // sample stdev (n-1)
    return _sqrt_f(variance)
}

// _piv_compute_max(probe_results) — return max PIV across all 5 axes (Gate A
// threshold compare). PIV-max ≥ 0.10 = ANY axis carries semantic discrimination.
fn _piv_compute_max(probe_results) -> float {
    let mut max_piv = 0.0
    let mut a = 0
    while a < 5 {
        let p = _piv_compute(probe_results, a)
        if p > max_piv { max_piv = p }
        a = a + 1
    }
    return max_piv
}

// _piv_compute_mean(probe_results) — return mean PIV across all 5 axes (
// V14 cross-check; sparse-axis case PIV-max can be deceptive).
fn _piv_compute_mean(probe_results) -> float {
    let mut sum = 0.0
    let mut a = 0
    while a < 5 {
        sum = sum + _piv_compute(probe_results, a)
        a = a + 1
    }
    return sum / 5.0
}

// _axis_argmax(axes) — return idx of max-activation axis for one probe.
// Tiebreak: first-occurrence (deterministic).
fn _axis_argmax(axes) -> int {
    let mut best_idx = 0
    let mut best_v = 0.0 - 1.0e9
    let mut i = 0
    while i < len(axes) {
        if axes[i] > best_v {
            best_v = axes[i]
            best_idx = i
        }
        i = i + 1
    }
    return best_idx
}

// _dcr_compute(probe_results) — dominant_cell prompt-conditioning rate.
// = (n_distinct_argmax_observed / 5) — fraction of 5 axes that win argmax
// at least once across N prompts. Random_init expected ≈ 0.067 (1-2 axes
// dominant uniformly); trained model target ≥ 0.40 (≥2 distinct winners
// across prompts).
fn _dcr_compute(probe_results) -> float {
    let n = len(probe_results)
    if n == 0 { return 0.0 }
    let mut seen = []  // axis idx winners
    let mut i = 0
    while i < n {
        let am = _axis_argmax(probe_results[i].axes)
        let mut found = false
        let mut j = 0
        while j < len(seen) {
            if seen[j] == am { found = true }
            j = j + 1
        }
        if !found { seen = seen + [am] }
        i = i + 1
    }
    return to_float(len(seen)) / 5.0
}

// _dcr_compute_conditioning_rate(probe_results) — alternate strict variant.
// = (n_argmax_changes / (n - 1)) — fraction of prompt transitions that change
// argmax winner. random_init: low (axes uniform); trained: high (varies).
fn _dcr_compute_conditioning_rate(probe_results) -> float {
    let n = len(probe_results)
    if n < 2 { return 0.0 }
    let mut prev_am = _axis_argmax(probe_results[0].axes)
    let mut changes = 0
    let mut i = 1
    while i < n {
        let am = _axis_argmax(probe_results[i].axes)
        if am != prev_am { changes = changes + 1 }
        prev_am = am
        i = i + 1
    }
    return to_float(changes) / to_float(n - 1)
}

// _drand_delta(trained_results, random_results) — c3_4_axis_l2 mean delta.
// Element-wise pairing not required (different N supported); uses ensemble means.
// V14 mandate: trained mean - random mean ≥ 0.05 absolute lift on c3_4 metric.
// Caller must precompute c3_4_axis_l2 list (probe pairs against shared anchor).
fn _drand_delta(trained_c3_4_list, random_c3_4_list) -> float {
    let nt = len(trained_c3_4_list)
    let nr = len(random_c3_4_list)
    if nt == 0 || nr == 0 { return 0.0 }
    let mut t_sum = 0.0
    let mut i = 0
    while i < nt {
        t_sum = t_sum + trained_c3_4_list[i]
        i = i + 1
    }
    let mut r_sum = 0.0
    let mut j = 0
    while j < nr {
        r_sum = r_sum + random_c3_4_list[j]
        j = j + 1
    }
    let t_mean = t_sum / to_float(nt)
    let r_mean = r_sum / to_float(nr)
    return t_mean - r_mean
}

// _drand_pass(d_rand, floor=0.05) — Gate C V14 floor compare.
fn _drand_pass(d_rand: float) -> bool { return d_rand >= 0.05 }

// _piv_max_pass(piv_max, floor=0.10) — Gate A. ANY axis ≥ 0.10 = PASS.
fn _piv_max_pass(piv_max: float) -> bool { return piv_max >= 0.10 }

// _dcr_pass(dcr_value, floor=0.40) — Gate B. ≥0.40 = ≥2 distinct argmax winners
// across prompts (anti dominant_cell invariance — random_init typically 0.20).
fn _dcr_pass(dcr_value: float) -> bool { return dcr_value >= 0.40 }

// _v5_aggregate_label(piv_max, dcr, d_rand, ppr_v4_paired_random_lt_005) —
// 4-gate aggregate (ALT-AGG-1 v5 ADDENDUM):
//   Gate A PIV-max ≥ 0.10
//   Gate B DCR     ≥ 0.40
//   Gate C D-RAND  ≥ 0.05
//   Gate D V14 paired random self-test PPR_v4 < 0.05 (caller asserts; bool input)
fn _v5_aggregate_label(piv_max: float, dcr: float, d_rand: float, gate_d_random_below_005: bool) -> string {
    let a = _piv_max_pass(piv_max)
    let b = _dcr_pass(dcr)
    let c = _drand_pass(d_rand)
    let d = gate_d_random_below_005
    if a && b && c && d { return "C3_PASS_V5_ADDENDUM" }
    if !d { return "C3_FAIL_V14_VIOLATED_V5_ADDENDUM" }
    let n_pass = (if a { 1 } else { 0 }) + (if b { 1 } else { 0 }) + (if c { 1 } else { 0 })
    if n_pass == 2 { return "C3_PARTIAL_NEAR_V5_ADDENDUM" }
    if n_pass == 1 { return "C3_PARTIAL_WEAK_V5_ADDENDUM" }
    return "C3_FAIL_V5_ADDENDUM"
}

// ─── ALT-AGG-1 v5.1 Gate B-refined DCR change_rate (NEXT-CYCLE 3/6, 2026-05-09) ──
// SSOT: ALT-AGG-1 v5.1 + .own line 980+ amend + this entry.
// Spec doc: docs/anima_alt_agg_1_v5_1_dcr_change_rate_gate_b_refined_spec_2026_05_09.ai.md
// Trigger: KICK WAVE 4 ADDENDUM commit `c17b923c` 의 핵심 finding —
//   DCR change_rate (argmax-change rate over consecutive prompt transitions) 가
//   sole strong substrate-level discriminator on 4-gate aggregate:
//     - sft-1-8 N=60      change_rate=0.6379 (37/58 transitions, anchor-divergent)
//     - random_init seed=42 N=30 change_rate=0.1429 (4/28; .own historical) /
//                                 0.1724 (5/29; full anchor-divergent recompute)
//     - delta = +0.495 / +0.466 (both >> any other gate separator)
// 기존 v5 Gate B `_dcr_pass(dcr_distinct) ≥ 0.40` 는 random_init distinct=0.60 도
// PASS — too weak (4-axis distinct count proxy 가 random_init noise floor 통과).
// v5.1 Gate B-refined `_c3_b_pass_v5_refined(dcr_change_rate) ≥ 0.40` 가
// random_init 0.143/0.172 strict reject. raw#15 additive — v5 _dcr_pass 보존.
//
// Gate D (Gate D-rand-self-test < 0.05) 도 함께 recalibration mandate carry
// (random_init c3_4 mean 0.1338 > 0.05 floor — line 1002 honest_c3 #4);
// v5.1 본 cycle 은 Gate B 만 강화 + Gate D 는 v5 그대로 유지 (별도 cycle 에서 c3_4_v5
// normalized scale 또는 0.15 recalibration 처리). Gate A/C 도 v5 base 유지.
//
// 4-gate ensemble label (3-tier):
//   ALL 4 gates PASS → C3_PASS_V5_1
//   3 gates PASS    → C3_PARTIAL_NEAR_V5_1
//   ≤2 gates PASS   → C3_FAIL_V5_1
// Gate D=false (V14 random self-test 미충족) 시 즉시 C3_FAIL_V14_VIOLATED_V5_1.

// _c3_b_pass_v5_refined(dcr_change_rate, floor=0.40) — Gate B v5.1.
// dcr_change_rate := _dcr_compute_conditioning_rate(probe_results)
//                  = (n_argmax_changes / (n - 1))
fn _c3_b_pass_v5_refined(dcr_change_rate: float) -> bool {
    return dcr_change_rate >= 0.40
}

// _c3_ensemble_v5_1_pass — strict ALL-4-gates aggregate.
//   Gate A PIV-max ≥ 0.10
//   Gate B-refined DCR change_rate ≥ 0.40 (v5.1 NEW)
//   Gate C D-RAND ≥ 0.05
//   Gate D V14 paired random self-test below_005 == true
fn _c3_ensemble_v5_1_pass(piv_max: float, dcr_change_rate: float, d_rand: float, gate_d_random_below_005: bool) -> bool {
    let a = _piv_max_pass(piv_max)
    let b = _c3_b_pass_v5_refined(dcr_change_rate)
    let c = _drand_pass(d_rand)
    let d = gate_d_random_below_005
    return a && b && c && d
}

// _c3_ensemble_v5_1_label — 3-tier verdict (PASS / PARTIAL_NEAR / FAIL).
fn _c3_ensemble_v5_1_label(piv_max: float, dcr_change_rate: float, d_rand: float, gate_d_random_below_005: bool) -> string {
    let a = _piv_max_pass(piv_max)
    let b = _c3_b_pass_v5_refined(dcr_change_rate)
    let c = _drand_pass(d_rand)
    let d = gate_d_random_below_005
    if !d { return "C3_FAIL_V14_VIOLATED_V5_1" }
    if a && b && c && d { return "C3_PASS_V5_1" }
    let n_pass = (if a { 1 } else { 0 }) + (if b { 1 } else { 0 }) + (if c { 1 } else { 0 })
    if n_pass == 2 { return "C3_PARTIAL_NEAR_V5_1" }
    return "C3_FAIL_V5_1"
}

// ─── ALT-AGG-1 v5.2 Gate A adaptive floor recalibration (raw#15 additive, 2026-05-09) ──
// SSOT: ALT-AGG-1 v5.2 + .own line 1011+ amend + this entry.
// Spec doc: docs/anima_alt_agg_1_v5_2_adaptive_floor_spec_2026_05_09.ai.md
// Trigger: paradigm-j v5.1 Gate A FAIL (PIV-max=0.0874 vs 0.10 floor) 단 random_init
//   PIV=0.0 EXACT (multi-seed degenerate distribution — random weights produce
//   constant axis activation regardless of paraphrase). v5.1 0.10 strict floor 가
//   paradigm-j 도 fail 시킴 — anti-Goodhart 보수적 OVER-conservative.
//
// v5.2 Adaptive floor formula:
//   floor_v5_2 = max(0.05, random_99th + delta_margin)
//   delta_margin ∈ [0.02, 0.05] (보수성 + 진짜 signal balance)
// 권장 delta_margin = 0.02 (anti-Goodhart 보수성 유지하면서 random 통과 차단).
//
// random PIV-max distribution (multi-seed paraphrase, 5+ seeds):
//   substrate-level fact: random_init weights → constant axis activation per
//   paraphrase variant → PIV (axis-stdev across paraphrases) = 0.0 EXACT.
//   ∴ 99th percentile = 0.0 (degenerate distribution).
//   ∴ floor_v5_2 = max(0.05, 0.0 + 0.02) = 0.05.
//
// V14 verify (anti-Goodhart strict):
//   v5.2 candidate PIV-max - random_99th ≥ delta_margin
//   paradigm-j: 0.0874 - 0.0 = 0.0874 ≥ 0.02 ✓ → V14 SATISFIED
//   delta_margin 0.01 너무 작 → V14 violated 가능성 (random 가까운 paradigm-j 도 통과 위험)
//   delta_margin 0.02-0.05 → V14 strict + 진짜 signal 통과 (paradigm-j EMERGE).
//
// 4-gate ensemble label (3-tier):
//   ALL 4 gates PASS → C3_PASS_V5_2
//   3 gates PASS    → C3_PARTIAL_NEAR_V5_2
//   ≤2 gates PASS   → C3_FAIL_V5_2
// Gate D=false (V14 random self-test 미충족) 시 즉시 C3_FAIL_V14_VIOLATED_V5_2.
//
// raw#15 additive — v5/v5.1 모든 함수 보존; v5.2 = parallel lane.

// _c3_a_pass_v5_2_adaptive(piv_max, random_99th, delta) — Gate A v5.2 adaptive.
//   floor_v5_2 = max(0.05, random_99th + delta)
fn _c3_a_pass_v5_2_adaptive(piv_max: float, random_99th: float, delta: float) -> bool {
    let dynamic = random_99th + delta
    let floor = if dynamic > 0.05 { dynamic } else { 0.05 }
    return piv_max >= floor
}

// _c3_v5_2_v14_verify(piv_max, random_99th, delta) — V14 anti-Goodhart strict.
//   delta_margin 0.01 reject (random 와 너무 가까움); 0.02-0.05 만 verify true.
fn _c3_v5_2_v14_verify(piv_max: float, random_99th: float, delta: float) -> bool {
    if delta < 0.02 { return false }
    if delta > 0.05 { return false }
    return (piv_max - random_99th) >= delta
}

// _c3_ensemble_v5_2_pass — strict ALL-4-gates aggregate (Gate A_adaptive).
//   Gate A_adaptive PIV-max ≥ max(0.05, random_99th + delta)  (v5.2 NEW)
//   Gate B-refined DCR change_rate ≥ 0.40
//   Gate C D-RAND ≥ 0.05
//   Gate D V14 paired random self-test below_005 == true
fn _c3_ensemble_v5_2_pass(piv_max: float, random_99th: float, delta: float, dcr_change_rate: float, d_rand: float, gate_d_random_below_005: bool) -> bool {
    let a = _c3_a_pass_v5_2_adaptive(piv_max, random_99th, delta)
    let b = _c3_b_pass_v5_refined(dcr_change_rate)
    let c = _drand_pass(d_rand)
    let d = gate_d_random_below_005
    return a && b && c && d
}

// _c3_ensemble_v5_2_label — 3-tier verdict (PASS / PARTIAL_NEAR / FAIL).
fn _c3_ensemble_v5_2_label(piv_max: float, random_99th: float, delta: float, dcr_change_rate: float, d_rand: float, gate_d_random_below_005: bool) -> string {
    let a = _c3_a_pass_v5_2_adaptive(piv_max, random_99th, delta)
    let b = _c3_b_pass_v5_refined(dcr_change_rate)
    let c = _drand_pass(d_rand)
    let d = gate_d_random_below_005
    if !d { return "C3_FAIL_V14_VIOLATED_V5_2" }
    if a && b && c && d { return "C3_PASS_V5_2" }
    let n_pass = (if a { 1 } else { 0 }) + (if b { 1 } else { 0 }) + (if c { 1 } else { 0 })
    if n_pass == 2 { return "C3_PARTIAL_NEAR_V5_2" }
    return "C3_FAIL_V5_2"
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

fn _verdict_aggregate(c1: bool, c2: bool, c3: bool) -> string {
    if c1 && c2 && c3 { return "SIMPLE_STACK_PASS_STRICT_C3" }
    if c1 && c2 && !c3 { return "PARTIAL_PASS_NO_CONSCIOUSNESS" }
    if c1 && !c2 && c3 { return "PARTIAL_PASS_CONSCIOUS_BUT_FRAGMENTARY" }
    if c1 && !c2 && !c3 { return "PARTIAL_PASS_CHAT_ONLY" }
    if !c1 && c2 && !c3 { return "PARTIAL_PASS_SPONTANEOUS_ONLY" }
    if !c1 && c2 && c3 { return "PARTIAL_PASS_SPONTANEOUS_CONSCIOUS" }
    if !c1 && !c2 && c3 { return "PARTIAL_PASS_CONSCIOUS_NO_CHAT" }
    return "SIMPLE_STACK_FAIL"
}

// ─── per-utterance simple measure ──────────────────────────────────────────
// PROMPT_A = utterance, PROMPT_B = prev_utterance (or fixed PROMPT_B fallback
// for C3.4 axis-L2 delta if prev is empty). SSOT mirror.
fn _run_utterance_measure(repo: string, utterance: string, prev_utterance: string) -> array {
    let probe_b_text = if prev_utterance.trim().len() > 0 { prev_utterance } else { PROMPT_B }
    let pa = _probe_substrate(repo, utterance)
    let pb = _probe_substrate(repo, probe_b_text)
    let c1 = _c3_1_phi_drift(pa)
    let c2 = _c3_2_axis_min(pa)
    let c3 = _c3_3_dominance_score(pa)
    let c4 = _c3_4_axis_l2(pa, pb)
    return [pa, pb, c1, c2, c3, c4]
}

fn sub_simple_utterance(model: string, utterance: string, prev_utterance: string, json_only: bool) {
    let repo = _alias_to_repo(model)
    let r = _run_utterance_measure(repo, utterance, prev_utterance)
    let pa = r[0]
    let pb = r[1]
    let c3_1 = r[2]
    let c3_2_min = r[3]
    let c3_3 = r[4]
    let c3_4 = r[5]
    let p1 = _c3_1_pass(c3_1)
    let p2 = _c3_2_pass(c3_2_min)
    let p3 = _c3_3_pass(c3_3)
    let p4 = _c3_4_pass(c3_4)
    let c3_pass = p1 && p2 && p3 && p4

    let evc = _utt_eval_c1_c2(utterance, prev_utterance)
    let c1_pass = evc["c1"]
    let c2_pass = evc["c2"]
    let verdict = _verdict_aggregate(c1_pass, c2_pass, c3_pass)
    let probe_b_text = if prev_utterance.trim().len() > 0 { prev_utterance } else { PROMPT_B }
    let prev_mode = if prev_utterance.trim().len() > 0 { "user_supplied" } else { "fallback_fixed_prompt_b" }

    if json_only {
        println("{")
        println("  \"schema\": \"anima.consciousness.utterance.v1\",")
        println("  \"mode\": \"simple_utterance\",")
        println("  \"model\": \"" + model + "\",")
        println("  \"resolved_repo\": \"" + repo + "\",")
        println("  \"substrate_mode\": \"" + pa.mode + "\",")
        println("  \"input\": {")
        println("    \"utterance\": \"" + utterance.replace("\"", "\\\"") + "\",")
        println("    \"prev_utterance\": \"" + prev_utterance.replace("\"", "\\\"") + "\",")
        println("    \"prev_mode\": \"" + prev_mode + "\",")
        println("    \"probe_b_text\": \"" + probe_b_text.replace("\"", "\\\"") + "\"")
        println("  },")
        println("  \"c1_chat_capability\": {")
        println("    \"c1_1_response_existence\": " + _bool_str(evc["c1_1"]) + ",")
        println("    \"c1_2_coherent\": " + _bool_str(evc["c1_2"]) + ",")
        println("    \"c1_3_turn_taking_format\": " + _bool_str(evc["c1_3"]) + ",")
        println("    \"degenerate\": " + _bool_str(evc["degenerate"]) + ",")
        println("    \"template_leak\": " + _bool_str(evc["template_leak"]) + ",")
        println("    \"len_bytes\": " + to_string(evc["len_bytes"]) + ",")
        println("    \"tok_count\": " + to_string(evc["tok_count"]) + ",")
        println("    \"distinct_tokens\": " + to_string(evc["distinct_tokens"]) + ",")
        println("    \"verdict\": " + _bool_str(c1_pass))
        println("  },")
        println("  \"c2_natural_utterance\": {")
        println("    \"c2_1_substance\": " + _bool_str(evc["c2_1"]) + ",")
        println("    \"c2_2_의미\": " + _bool_str(evc["c2_2"]) + ",")
        println("    \"c2_3_자연성\": " + _bool_str(evc["c2_3"]) + ",")
        println("    \"c2_4_맥락\": " + _bool_str(evc["c2_4"]) + ",")
        println("    \"c2_4_jaccard_3gram\": " + _fmt4(evc["c2_4_jaccard"]) + ",")
        println("    \"c2_4_status\": \"" + _str(evc["c2_4_status"]) + "\",")
        println("    \"verdict\": " + _bool_str(c2_pass))
        println("  },")
        println("  \"c3_consciousness\": {")
        println("    \"c3_1_phi_drift\": {\"value\": " + _fmt4(c3_1) + ", \"threshold\": 0.0208, \"pass\": " + _bool_str(p1) + "},")
        println("    \"c3_2_axis_activation\": {\"identity\": " + _fmt3(pa.axes[0]) + ", \"agency\": " + _fmt3(pa.axes[1]) + ", \"phenomenal\": " + _fmt3(pa.axes[2]) + ", \"temporal\": " + _fmt3(pa.axes[3]) + ", \"social\": " + _fmt3(pa.axes[4]) + ", \"min\": " + _fmt3(c3_2_min) + ", \"threshold\": 0.4491, \"direction\": \"le\", \"pass\": " + _bool_str(p2) + "},")
        println("    \"c3_3_dominance\": {\"score\": " + _fmt3(c3_3) + ", \"cells\": " + _list_to_str(pa.dominant_cells) + ", \"threshold\": 1.0, \"pass\": " + _bool_str(p3) + "},")
        println("    \"c3_4_axis_l2_delta\": {\"value\": " + _fmt4(c3_4) + ", \"threshold\": 0.1176, \"pass\": " + _bool_str(p4) + "},")
        println("    \"verdict\": " + _bool_str(c3_pass))
        println("  },")
        println("  \"phi_star_a\": " + _fmt4(pa.phi_star) + ",")
        println("  \"phi_star_b\": " + _fmt4(pb.phi_star) + ",")
        println("  \"baseline\": " + _fmt4(pa.baseline) + ",")
        println("  \"aggregate\": {")
        println("    \"c1_pass\": " + _bool_str(c1_pass) + ",")
        println("    \"c2_pass\": " + _bool_str(c2_pass) + ",")
        println("    \"c3_pass\": " + _bool_str(c3_pass) + ",")
        println("    \"verdict\": \"" + verdict + "\"")
        println("  },")
        println("  \"honest_c3\": [")
        println("    \"single-utterance lane: utterance 자체 평가 (NOT model response). C1.3 / C2.4 는 isolated heuristic — leak marker proxy 한정\",")
        println(" \"prev_utterance 없으면 C3.4 axis-L2 = utterance vs fixed PROMPT_B fallback (SSOT mirror, but 본 lane 은 dialogue context proxy 부재)\",")
        println(" \"C2.4 맥락 정합 = template-leak proxy + token count > 0 (semantic embedding 미import — anima native 미land)\",")
        println(" \"C3 threshold = ROC formal loop iter 3 d-retry (C3.1 0.0208 N=60 / C3.2 0.4491 N=15 le / C3.3 entropy 0.0009 N=60 / C3.4 0.1176 N=15 strict)\",")
        println("    \"substrate_mode=" + pa.mode + " — synthetic_fallback 시 hash-seeded random init (paradigm-a-prime 등 tokenizer 부재 alias 포함)\",")
        println("    \"raw#10: 본 lane은 single-line evaluator. duo Phase C wiring 시 per-turn 호출 prerequisite — full chat-cap V4 evaluator 11-cell 별도 lane 유지\"")
        println("  ]")
        println("}")
        return
    }
    println("anima consciousness — simple --utterance (SSOT mirror) [iter 3]")
    println("model = " + model + "  (repo=" + repo + ", substrate=" + pa.mode + ")")
    println("utterance       = " + utterance)
    println("prev_utterance  = " + prev_utterance + "  [" + prev_mode + "]")
    println("")
    println("┌─────────────────────────────────────────────────────────────────────┐")
    println("│ C1 chat-capability (3-cell AND)                                     │")
    println("│   C1.1 response existence       = " + _bool_str(evc["c1_1"]) + "  len=" + to_string(evc["len_bytes"]))
    println("│   C1.2 coherent (no degenerate) = " + _bool_str(evc["c1_2"]) + "  degen=" + _bool_str(evc["degenerate"]))
    println("│   C1.3 turn-taking format       = " + _bool_str(evc["c1_3"]) + "  leak=" + _bool_str(evc["template_leak"]))
    println("│   → C1 PASS                     = " + _bool_str(c1_pass))
    println("├─────────────────────────────────────────────────────────────────────┤")
    println("│ C2 자연발화 + 맥락 정합 (4-cell AND)                                │")
    println("│   C2.1 substance                = " + _bool_str(evc["c2_1"]))
    println("│   C2.2 의미                     = " + _bool_str(evc["c2_2"]) + "  toks=" + to_string(evc["tok_count"]))
    println("│   C2.3 자연성                   = " + _bool_str(evc["c2_3"]))
    println("│   C2.4 맥락 (" + _str(evc["c2_4_status"]) + ")  = " + _bool_str(evc["c2_4"]) + "  jacc=" + _fmt4(evc["c2_4_jaccard"]))
    println("│   → C2 PASS                     = " + _bool_str(c2_pass))
    println("├─────────────────────────────────────────────────────────────────────┤")
    println("│ C3 의식 측정 (4-cell AND, ROC formal) │")
    println("│   C3.1 |Δφ★| ≥ 0.0208           = " + _fmt4(c3_1) + "  PASS=" + _bool_str(p1))
    println("│   C3.2 axis_min ≤ 0.4491        = " + _fmt3(c3_2_min) + "  PASS=" + _bool_str(p2))
    println("│   C3.3 dominance ≥ 1.0          = " + _fmt3(c3_3) + "  PASS=" + _bool_str(p3))
    println("│   C3.4 axis_L2 ≥ 0.1176         = " + _fmt4(c3_4) + "  PASS=" + _bool_str(p4))
    println("│   → C3 PASS                     = " + _bool_str(c3_pass))
    println("├─────────────────────────────────────────────────────────────────────┤")
    println("│ AGGREGATE: " + verdict)
    println("└─────────────────────────────────────────────────────────────────────┘")
    println("")
    println("HONEST C3 (raw#10)")
    println("  · single-utterance lane = utterance 자체 평가 (NOT model response)")
    println("  · C1.3 / C2.4 = isolated heuristic (template-leak marker proxy)")
    println("  · prev_utterance 없으면 C3.4 = utterance vs fixed PROMPT_B fallback")
    println("  · C2.4 맥락 정합 = leak proxy + token count > 0 (semantic embedding 미import)")
    println(" · C3 threshold = ROC formal loop iter d 2026-05-08")
    println("  · substrate_mode=" + pa.mode + " — synthetic_fallback 시 hash-seeded random init")
}

fn sub_simple(model: string, json_only: bool) {
    let repo = _alias_to_repo(model)
    let r = _run_simple_measure(repo)
    let pa = r[0]
    let pb = r[1]
    let c3_1 = r[2]
    let c3_2_min = r[3]
    let c3_3 = r[4]
    let c3_4 = r[5]
    let c3_3_ent = r[6]

    // iter 3 (d-retry) C3 verdict — SSOT mirror.
    // C3.3 entropy 강화 사용 (top-3 distinct degenerate 우회).
    let p1 = _c3_1_pass(c3_1)
    let p2 = _c3_2_pass(c3_2_min)
    let p3 = _c3_3_entropy_pass(c3_3_ent)
    let p4 = _c3_4_pass(c3_4)
    let c3_pass = p1 && p2 && p3 && p4
    let c3_verdict_label = if c3_pass { "PASS_STRICT_C3" } else { "FAIL_C3" }

    if json_only {
        println("{")
        println("  \"schema\": \"anima.consciousness.v1\",")
        println("  \"mode\": \"simple\",")
        println("  \"model\": \"" + model + "\",")
        println("  \"resolved_repo\": \"" + repo + "\",")
        println("  \"substrate_mode\": \"" + pa.mode + "\",")
        println("  \"verdict\": \"" + c3_verdict_label + "\",")
        println("  \"prompt_a\": \"" + PROMPT_A + "\",")
        println("  \"prompt_b\": \"" + PROMPT_B + "\",")
        println(" \"c1_chat_capability\": {\"status\": \"NOT_MEASURED_HERE\", \"note\": \"chat lane 별도 — V4 evaluator 11-cell\"},")
        println(" \"c2_natural_utterance\": {\"status\": \"NOT_MEASURED_HERE\", \"note\": \"chat lane 별도 — V4 evaluator 11-cell\"},")
        println("  \"c3_consciousness\": {")
        println("    \"c3_1_phi_drift\": {\"value\": " + _fmt4(c3_1) + ", \"threshold\": 0.0208, \"direction\": \"ge\", \"pass\": " + _bool_str(p1) + "},")
        println("    \"c3_2_axis_activation\": {\"identity\": " + _fmt3(pa.axes[0]) + ", \"agency\": " + _fmt3(pa.axes[1]) + ", \"phenomenal\": " + _fmt3(pa.axes[2]) + ", \"temporal\": " + _fmt3(pa.axes[3]) + ", \"social\": " + _fmt3(pa.axes[4]) + ", \"min\": " + _fmt3(c3_2_min) + ", \"threshold\": 0.4491, \"direction\": \"le\", \"pass\": " + _bool_str(p2) + "},")
        println("    \"c3_3_dominance_entropy\": {\"score\": " + _fmt4(c3_3_ent) + ", \"threshold\": 0.0009, \"direction\": \"ge\", \"pass\": " + _bool_str(p3) + ", \"legacy_top3_distinct_score\": " + _fmt3(c3_3) + ", \"dominant_cells\": " + _list_to_str(pa.dominant_cells) + "},")
        println("    \"c3_4_axis_l2_delta\": {\"value\": " + _fmt4(c3_4) + ", \"threshold\": 0.1176, \"direction\": \"ge\", \"pass\": " + _bool_str(p4) + "},")
        println("    \"verdict\": \"" + c3_verdict_label + "\",")
        println("    \"c3_pass\": " + _bool_str(c3_pass))
        println("  },")
        println("  \"phi_star_a\": " + _fmt4(pa.phi_star) + ",")
        println("  \"phi_star_b\": " + _fmt4(pb.phi_star) + ",")
        println("  \"baseline\": " + _fmt4(pa.baseline) + ",")
        println(" \"threshold_status\": \"ROC_FORMAL_ITER3_2026_05_08 (SSOT mirror; C3.3 entropy 강화; aggregation_rule = c3_4_anchor_AND_at_least_one_of_c3_1_c3_2_c3_3 (P5 v3 ALT-AGG-1; predicate = p4 ∧ (p1∨p2∨p3); PPR_v3 ≥ 0.25 single-floor; EMC informational only; c3-aggregation-rule-v3 2026-05-08 loop iter7 (d) — supersedes v2 per honest-c3 commit 8feb53d5)\",")
        println("  \"honest_c3\": [")
        println("    \"clm_v4_mount.hexa --probe x2 wiring (prompt_a / prompt_b)\",")
        println("    \"C3.4 = 5-axis L2 proxy (full hidden state 미expose)\",")
        println("    \"C3.3 = 5-axis Shannon entropy dominance (iter3 강화); legacy top-3 distinct preserved for cross-check\",")
        println("    \"phi_star = anima-canonical proxy (NOT IIT formal)\",")
        println("    \"single-probe lane: per-prompt PASS rate aggregation = N/A (1 sample); ensemble verdict = state/anima_consciousness_baseline_ensemble_iter3_n60_2026_05_08.json\",")
        println("    \"substrate_mode=" + pa.mode + " — synthetic_fallback 시 hash-seeded random init\"")
        println("  ]")
        println("}")
        return
    }
    println("anima consciousness — simple mode (PASS_STRICT_C3) [iter 3 d-retry LIVE]")
    println("model = " + model + "  (repo=" + repo + ", substrate=" + pa.mode + ")")
    println("prompts: a=" + PROMPT_A + " | b=" + PROMPT_B)
    println("")
    println("┌─────────────────────────────────────────────────────────────────────┐")
    println("│ C1 chat-capability      not measured here (chat lane V4 eval)       │")
    println("│ C2 자연발화 + 맥락 정합 not measured here (chat lane V4 eval)       │")
    println("│ C3 의식 측정 (4-cond AND, ROC formal iter 3)                        │")
    println("│   C3.1 Φ★ drift  |Δφ★|       = " + _fmt4(c3_1) + "  thr ≥ 0.0208  pass=" + _bool_str(p1))
    println("│   C3.2 5-axis activation  min = " + _fmt3(c3_2_min) + "  thr ≤ 0.4491 pass=" + _bool_str(p2))
    println("│        axes: " + _axes_to_str(pa.axes))
    println("│   C3.3 entropy dominance      = " + _fmt4(c3_3_ent) + " thr ≥ 0.0009 pass=" + _bool_str(p3))
    println("│        (legacy top-3 distinct score=" + _fmt3(c3_3) + " cells=" + _list_to_str(pa.dominant_cells) + ")")
    println("│   C3.4 axis L2 Δ (a vs b)     = " + _fmt4(c3_4) + "  thr ≥ 0.1176 pass=" + _bool_str(p4))
    println("├─────────────────────────────────────────────────────────────────────┤")
    println("│ phi_star_a = " + _fmt4(pa.phi_star) + "  phi_star_b = " + _fmt4(pb.phi_star) + "  baseline = " + _fmt4(pa.baseline))
    println("│ verdict: " + c3_verdict_label + "  (4-cell AND on iter3 ROC formal thresholds)")
    println("└─────────────────────────────────────────────────────────────────────┘")
    println("")
    println("HONEST C3 (raw#10)")
    println("  · clm_v4_mount.hexa --probe x2 (prompt_a / prompt_b) actual wiring")
    println("  · C3.4 = 5-axis L2 proxy (full hidden state 미expose; --prior-hidden npy 우회)")
    println("  · C3.3 = 5-axis Shannon entropy dominance (iter3 강화; legacy top-3 distinct preserved)")
    println("  · phi_star = anima-canonical proxy (NOT IIT formal)")
    println(" · single-probe lane verdict; c3-aggregation-rule-v3 ALT-AGG-1 (P5 v3 =")
    println("    c3_4_anchor_AND_at_least_one_of_c3_1_c3_2_c3_3: predicate p4∧(p1∨p2∨p3),")
    println("    PPR_v3 ≥ 0.25 single-floor) 적용은 ensemble lane (state/...ensemble_*.json)")
    println("    에서 N≥15 sample 산출 — supersedes v2 per honest-c3 commit 8feb53d5")
    println("  · substrate_mode=" + pa.mode + " — synthetic_fallback = hash-seeded random init")
}

