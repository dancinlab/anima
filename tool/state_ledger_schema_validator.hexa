// ════════════════════════════════════════════════════════════════════════════
//  tool/state_ledger_schema_validator.hexa — Task #11 (race risk MED 해소)
//
//  PURPOSE
//    Detect schema drift across 5 state ledgers that are dual-written
//    by anima-clm-eeg/tool/* (legacy) and anima-eeg-core/tool/modules/
//    _integrations/* (Phase 6 wrap→port migration).
//
//    Rationale: migration plan (commit fb5b423c2 §6) flagged MED race
//    risk where two writer paths produce rows under the same ledger
//    file with potentially divergent fields. We add a `schema_version`
//    discriminator field and a validator that classifies rows and
//    fires F_SLV_01 on mixed-schema files.
//
//  5 LEDGER PATHS (frozen 2026-04-29)
//    1. state/cyborg_eeg_audit/*.jsonl
//    2. state/clm_eeg_berger_audit/*.jsonl
//    3. state/clm_eeg_pe_audit/*.jsonl
//    4. state/clm_eeg_hjorth_audit/*.jsonl
//    5. state/clm_eeg_gamma_theta_ratio_audit/*.jsonl
//
//  SCHEMA_VERSION DISCRIMINATOR (raw#23 schema-guard pattern)
//    "clm-eeg-legacy.v1"     = anima-clm-eeg/tool/* writers
//    "eeg-core-phase6.v1"    = anima-eeg-core/_integrations/* writers
//    "<unset>"               = pre-Task#11 row (raw#10 honest tolerated)
//
//  RAW#71 FALSIFIERS (4 preregistered, frozen 2026-04-29)
//    F_SLV_01  ledger contains rows with two distinct schema_version
//              values    (mixed-schema drift)            → MIXED_SCHEMA
//    F_SLV_02  unknown schema_version (not in known set) → UNKNOWN_SCHEMA
//    F_SLV_03  row missing both `schema_version` AND `schema` keys
//              after rollout enforce-date            → ENFORCE_VIOLATION
//    F_SLV_04  validator selftest synthesized rows fail
//              classifier round-trip                       → SELFTEST_DRIFT
//
//  CLI
//    hexa run tool/state_ledger_schema_validator.hexa --check <path>
//    hexa run tool/state_ledger_schema_validator.hexa --check-all
//    hexa run tool/state_ledger_schema_validator.hexa --selftest
//    hexa run tool/state_ledger_schema_validator.hexa --enforce-discriminator
//
//  EXIT
//    0 — all checked ledgers pass (no F_SLV_* triggered)
//    1 — falsifier triggered (drift detected)
//    2 — usage / I/O error
//
//  RAW raw#9 hexa-only · raw#10 honest · raw#12 silent-error-ban
//      raw#23 schema-guard · raw#65 idempotent (read-only) · raw#66 ai-native
//      raw#71 falsifier · raw#77 audit · raw#82 darwin-native · raw#91 honest
// ════════════════════════════════════════════════════════════════════════════

let SLV_SCHEMA_VERSION = "anima.state_ledger_schema_validator.v1"

let SCHEMA_LEGACY = "clm-eeg-legacy.v1"
let SCHEMA_PHASE6 = "eeg-core-phase6.v1"

let ENFORCE_DATE_UTC = "2026-05-15"  // advisory→strict cutover

let LEDGER_GLOBS = [
    "state/cyborg_eeg_audit",
    "state/clm_eeg_berger_audit",
    "state/clm_eeg_pe_audit",
    "state/clm_eeg_hjorth_audit",
    "state/clm_eeg_gamma_theta_ratio_audit"
]

// ─── helpers ───────────────────────────────────────────────────────────────

fn _shq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}

fn _ts_iso() -> string {
    return to_string(exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")[0]).trim()
}

fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _shq(p))[1] == 0
}

fn _read_lines(p: string) -> array {
    let r = exec_with_status("cat " + _shq(p))
    let mut out = []
    if r[1] != 0 { return out }
    let lines = split(to_string(r[0]), "\n")
    for ln in lines {
        let t = to_string(ln)
        if len(t) > 0 { out.push(t) }
    }
    return out
}

// Find a JSON string field value. Returns "" if absent.
// Heuristic: scan for "<key>":" and capture until next unescaped quote.
fn _kv_str(line: string, key: string) -> string {
    let probe = "\"" + key + "\":\""
    let idx = line.find(probe)
    if idx < 0 { return "" }
    let start = idx + len(probe)
    let mut i = start
    while i < len(line) {
        let c = line.substring(i, i + 1)
        if c == "\"" {
            return line.substring(start, i)
        }
        i = i + 1
    }
    return ""
}

// Classify a single row → one of:
//   "clm-eeg-legacy.v1" | "eeg-core-phase6.v1" | "<unknown>" | "<unset>"
fn _classify_row(row: string) -> string {
    let sv = _kv_str(row, "schema_version")
    if sv != "" {
        if sv == SCHEMA_LEGACY { return SCHEMA_LEGACY }
        if sv == SCHEMA_PHASE6 { return SCHEMA_PHASE6 }
        return "<unknown>"
    }
    // Fallback: legacy gamma_theta uses `schema` field (existing convention).
    let sch = _kv_str(row, "schema")
    if sch != "" {
        // pre-Task#11 legacy schema strings start with "anima-clm-eeg/"
        if len(sch) >= 14 && sch.substring(0, 14) == "anima-clm-eeg/" {
            return SCHEMA_LEGACY
        }
        if len(sch) >= 16 && sch.substring(0, 16) == "anima-eeg-core/_" {
            return SCHEMA_PHASE6
        }
        return "<unknown>"
    }
    return "<unset>"
}

// ─── ledger checker ────────────────────────────────────────────────────────

// Returns [n_total, n_legacy, n_phase6, n_unset, n_unknown, mixed (0|1)]
fn _check_file(path: string) -> array {
    let lines = _read_lines(path)
    let mut n_total   = 0
    let mut n_legacy  = 0
    let mut n_phase6  = 0
    let mut n_unset   = 0
    let mut n_unknown = 0
    for ln in lines {
        n_total = n_total + 1
        let c = _classify_row(to_string(ln))
        if c == SCHEMA_LEGACY { n_legacy = n_legacy + 1 }
        else if c == SCHEMA_PHASE6 { n_phase6 = n_phase6 + 1 }
        else if c == "<unset>" { n_unset = n_unset + 1 }
        else { n_unknown = n_unknown + 1 }
    }
    let mut mixed = 0
    if n_legacy > 0 && n_phase6 > 0 { mixed = 1 }
    return [n_total, n_legacy, n_phase6, n_unset, n_unknown, mixed]
}

// Returns array of jsonl files under ledger directory (or single file).
fn _list_ledger_files(p: string) -> array {
    if !_file_exists(p) { return [] }
    let r = exec_with_status("test -d " + _shq(p))
    if r[1] == 0 {
        // directory
        let lr = exec_with_status("ls -1 " + _shq(p) + "/*.jsonl 2>/dev/null")
        let mut out = []
        if lr[1] != 0 { return out }
        for ln in split(to_string(lr[0]), "\n") {
            let t = to_string(ln).trim()
            if len(t) > 0 { out.push(t) }
        }
        return out
    }
    return [p]
}

// raw#71 falsifier evaluation.
// Returns [trigger_count, "comma_ids"]
fn _fire_falsifiers(stats: array) -> array {
    // stats = [n_total, n_legacy, n_phase6, n_unset, n_unknown, mixed]
    let mut trig = ""
    let mut count = 0
    if stats[5] == 1 {
        trig = trig + "F_SLV_01,"
        count = count + 1
    }
    if stats[4] > 0 {
        trig = trig + "F_SLV_02,"
        count = count + 1
    }
    // F_SLV_03 — enforce-date check happens at caller (date string compare)
    let nT = len(trig)
    if nT > 0 { trig = trig.substring(0, nT - 1) }
    return [count, trig]
}

fn _today_utc() -> string {
    return to_string(exec_with_status("date -u +%Y-%m-%d")[0]).trim()
}

fn _date_ge(a: string, b: string) -> bool {
    // ISO YYYY-MM-DD lexicographic compare suffices.
    if len(a) < 10 || len(b) < 10 { return false }
    return a >= b
}

// ─── public entry: check one ledger path ───────────────────────────────────

// Returns [overall_trigger_count, summary_string]
fn _check_path(p: string, enforce: bool) -> array {
    let files = _list_ledger_files(p)
    if len(files) == 0 {
        println("  " + p + ": NOT_FOUND (skipped)")
        return [0, p + "=NOT_FOUND"]
    }
    let mut total_trig = 0
    let mut summary = ""
    for fp in files {
        let stats = _check_file(to_string(fp))
        let res = _fire_falsifiers(stats)
        let mut count = res[0]
        let mut trig  = to_string(res[1])
        // F_SLV_03 only if enforce flag set OR today >= ENFORCE_DATE_UTC
        let today = _today_utc()
        let strict = enforce || _date_ge(today, ENFORCE_DATE_UTC)
        if strict && stats[3] > 0 {
            if len(trig) > 0 { trig = trig + "," }
            trig = trig + "F_SLV_03"
            count = count + 1
        }
        total_trig = total_trig + count
        let row =
            "  " + to_string(fp) + ":" +
            " total="    + to_string(stats[0]) +
            " legacy="   + to_string(stats[1]) +
            " phase6="   + to_string(stats[2]) +
            " unset="    + to_string(stats[3]) +
            " unknown="  + to_string(stats[4]) +
            " mixed="    + to_string(stats[5]) +
            " trig="     + to_string(count) +
            " ids="      + trig
        println(row)
        summary = summary + to_string(fp) + "@" + to_string(count) + ";"
    }
    return [total_trig, summary]
}

// ─── selftest (F_SLV_04 self-validate classifier round-trip) ──────────────

fn _selftest() -> int {
    println("── state_ledger_schema_validator selftest ──")
    let mut ok = 1

    let r1 = _classify_row("{\"ts\":\"x\",\"schema_version\":\"clm-eeg-legacy.v1\",\"v\":1}")
    let s1 = (r1 == SCHEMA_LEGACY)
    println("S1 explicit legacy schema_version → " + r1 + " " + (if s1 { "PASS" } else { "FAIL" }))
    if !s1 { ok = 0 }

    let r2 = _classify_row("{\"ts\":\"x\",\"schema_version\":\"eeg-core-phase6.v1\",\"v\":1}")
    let s2 = (r2 == SCHEMA_PHASE6)
    println("S2 explicit phase6 schema_version → " + r2 + " " + (if s2 { "PASS" } else { "FAIL" }))
    if !s2 { ok = 0 }

    let r3 = _classify_row("{\"ts\":\"x\",\"schema\":\"anima-clm-eeg/clm_eeg_gamma_theta_ratio/1\",\"v\":1}")
    let s3 = (r3 == SCHEMA_LEGACY)
    println("S3 fallback `schema` → legacy → " + r3 + " " + (if s3 { "PASS" } else { "FAIL" }))
    if !s3 { ok = 0 }

    let r4 = _classify_row("{\"ts\":\"x\",\"v\":1}")
    let s4 = (r4 == "<unset>")
    println("S4 no field → unset → " + r4 + " " + (if s4 { "PASS" } else { "FAIL" }))
    if !s4 { ok = 0 }

    let r5 = _classify_row("{\"schema_version\":\"bogus.v9\"}")
    let s5 = (r5 == "<unknown>")
    println("S5 unknown schema_version → " + r5 + " " + (if s5 { "PASS" } else { "FAIL" }))
    if !s5 { ok = 0 }

    // F_SLV_01 mixed-schema fire
    let tmp = "/tmp/_slv_selftest_mixed.jsonl"
    write_file(tmp,
        "{\"schema_version\":\"clm-eeg-legacy.v1\",\"v\":1}\n" +
        "{\"schema_version\":\"eeg-core-phase6.v1\",\"v\":2}\n")
    let stats = _check_file(tmp)
    let s6 = (stats[5] == 1 && stats[1] == 1 && stats[2] == 1)
    println("S6 mixed-schema fire F_SLV_01 → mixed=" + to_string(stats[5]) +
            " " + (if s6 { "PASS" } else { "FAIL" }))
    if !s6 { ok = 0 }
    exec_with_status("rm -f " + _shq(tmp))

    // F_SLV_02 unknown fire
    let tmp2 = "/tmp/_slv_selftest_unk.jsonl"
    write_file(tmp2, "{\"schema_version\":\"bogus\",\"v\":1}\n")
    let st2 = _check_file(tmp2)
    let res2 = _fire_falsifiers(st2)
    let trig2 = to_string(res2[1])
    let s7 = (trig2.find("F_SLV_02") >= 0)
    println("S7 unknown fires F_SLV_02 → trig=" + trig2 +
            " " + (if s7 { "PASS" } else { "FAIL" }))
    if !s7 { ok = 0 }
    exec_with_status("rm -f " + _shq(tmp2))

    // F_SLV_03 enforce mode unset → fire
    let tmp3 = "/tmp/_slv_selftest_unset.jsonl"
    write_file(tmp3, "{\"ts\":\"x\",\"v\":1}\n")
    let r3res = _check_path(tmp3, true)
    let s8 = (r3res[0] >= 1)
    println("S8 enforce mode F_SLV_03 fires → trig=" + to_string(r3res[0]) +
            " " + (if s8 { "PASS" } else { "FAIL" }))
    if !s8 { ok = 0 }
    exec_with_status("rm -f " + _shq(tmp3))

    if ok == 1 {
        println("── selftest 8/8 PASS ──")
        return 0
    }
    println("── selftest FAIL (F_SLV_04) ──")
    return 1
}

// ─── CLI dispatch ──────────────────────────────────────────────────────────

fn _print_usage() {
    eprintln("usage:")
    eprintln("  hexa run tool/state_ledger_schema_validator.hexa --check <path>")
    eprintln("  hexa run tool/state_ledger_schema_validator.hexa --check-all")
    eprintln("  hexa run tool/state_ledger_schema_validator.hexa --selftest")
    eprintln("  hexa run tool/state_ledger_schema_validator.hexa --enforce-discriminator")
}

let _av = args()
let mut do_selftest = false
let mut do_check_all = false
let mut do_enforce = false
let mut check_path = ""
let mut _i = 0
while _i < len(_av) {
    let a = to_string(_av[_i])
    if a == "--selftest"                 { do_selftest = true; _i = _i + 1; continue }
    if a == "--check-all"                { do_check_all = true; _i = _i + 1; continue }
    if a == "--enforce-discriminator"    { do_enforce = true; _i = _i + 1; continue }
    if a == "--check" {
        if _i + 1 >= len(_av) {
            eprintln("reason: missing-arg-value: --check requires path")
            exit(2)
        }
        check_path = to_string(_av[_i + 1])
        _i = _i + 2
        continue
    }
    if a == "--help" || a == "-h" { _print_usage(); exit(0) }
    _i = _i + 1
}

if do_selftest {
    exit(_selftest())
}

println("══════════════════════════════════════════════════════════════")
println("  state_ledger_schema_validator (" + SLV_SCHEMA_VERSION + ")")
println("  ts:        " + _ts_iso())
println("  enforce:   " + (if do_enforce || _date_ge(_today_utc(), ENFORCE_DATE_UTC) { "STRICT" } else { "ADVISORY" }))
println("  cutover:   " + ENFORCE_DATE_UTC)
println("══════════════════════════════════════════════════════════════")

let mut total_trig = 0
let mut paths = []
if do_check_all {
    for g in LEDGER_GLOBS { paths.push(to_string(g)) }
} else if check_path != "" {
    paths.push(check_path)
} else {
    eprintln("reason: must pass --check <path> | --check-all | --selftest")
    _print_usage()
    exit(2)
}

for p in paths {
    println("")
    println("── " + to_string(p) + " ──")
    let r = _check_path(to_string(p), do_enforce)
    total_trig = total_trig + to_int(r[0])
}

println("")
println("══════════════════════════════════════════════════════════════")
println("  total_trig: " + to_string(total_trig))
if total_trig == 0 {
    println("  verdict:    SCHEMA_DISCRIMINATOR_PASS ✓")
    println("══════════════════════════════════════════════════════════════")
    exit(0)
}
println("  verdict:    SCHEMA_DRIFT_DETECTED ✗ (raw#71 fired)")
println("══════════════════════════════════════════════════════════════")
exit(1)
