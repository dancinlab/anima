// tool/path_a_r16_completion_watchdog.hexa — Path A r=16 mitigation completion watchdog + eval auto-trigger (raw#9 hexa-only Mac).
//
// PURPOSE
//   Polls (every 10 min, max 16h) for Path A r=16 mitigation training completion via three signals:
//     (a) state/p9_path_a_r16_h100_2026_05_03/verdict.json (sister BG local marker, may not exist)
//     (b) ssh ubu1: ~/anima/state/p9_path_a_r16_h100_2026_05_03/verdict.json
//     (c) HF repo dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1 has >=5 ckpts
//         (step-2000 .. step-10000) OR final marker (step-10000 tag)
//
//   GUARD-3 (success-signal checklist): file existence != success. Each candidate signal must
//     - exist
//     - parse as JSON (verdict files) OR enumerate >=5 distinct step-* tags (HF repo)
//     - have verdict.label in {SUCCESS, PARTIAL, COMPLETE, COMPLETED, ABORT, FAIL} OR ckpt count >=5
//
//   On trigger fire (any signal valid):
//     1. ssh ubu1: ANIMA_CKPT_REPO=<r16_repo> bash ~/anima/state/p9_a_prime_main_eval_2026_05_03/run_all_lora_ckpts.sh
//        (reuse existing run_all_lora_ckpts.sh per regression_mitigation spec §6 -- "no code changes,
//         just env var pointing at new hub repo")
//     2. scp ubu1:~/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results/*.json
//        -> state/p9_path_a_r16_eval_pipeline_2026_05_03/lora_results/
//        (Note: lora_results/ on ubu1 will accumulate r16 outputs; SLUG names overlap r64
//         unless ubu1-side run uses dedicated dir -- see caveat (b) below)
//     3. hexa run tool/p9_a_prime_verdict.hexa with ANIMA_LORA_RESULTS_DIR pointed at r16 dir
//        -> state/p9_path_a_r16_eval_pipeline_2026_05_03/verdict.json
//     4. If state/p9_a_prime_main_eval_2026_05_03_verdict.json exists -> mitigation comparison
//        (r16 vs r64 per-task delta + F-PATHA-MITIGATION-1 falsifier check)
//        -> state/p9_path_a_r16_eval_pipeline_2026_05_03/mitigation_comparison.json
//     5. Land marker + handoff doc summary
//     6. Optional: notify payload stub (no native push in stage0)
//
// USAGE
//   hexa run tool/path_a_r16_completion_watchdog.hexa --selftest          # invariants check
//   hexa run tool/path_a_r16_completion_watchdog.hexa --once               # single poll, no loop
//   hexa run tool/path_a_r16_completion_watchdog.hexa --apply              # fire pipeline on hit (default DRY)
//   hexa run tool/path_a_r16_completion_watchdog.hexa --loop --apply       # full 16h watchdog
//
// CONFIG (env overrides)
//   ANIMA_R16_VERDICT_LOCAL    default: state/p9_path_a_r16_h100_2026_05_03/verdict.json
//   ANIMA_R16_VERDICT_UBU1     default: /home/aiden/anima/state/p9_path_a_r16_h100_2026_05_03/verdict.json
//   ANIMA_R16_HF_REPO          default: dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1
//   ANIMA_R16_HF_FINAL_TAG     default: step-10000
//   ANIMA_R16_HF_MIN_CKPTS     default: 5  (step-2000,4000,6000,8000,10000)
//   ANIMA_R64_VERDICT          default: state/p9_a_prime_main_eval_2026_05_03_verdict.json
//   ANIMA_R16_REMOTE_RESULTS   default: /home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results_r16
//   ANIMA_R16_LOCAL_RESULTS    default: /Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/lora_results
//   ANIMA_POLL_INTERVAL_SEC    default: 600 (10 min)
//   ANIMA_MAX_WAIT_SEC         default: 57600 (16h)
//   ANIMA_LOG_PATH             default: state/p9_path_a_r16_eval_pipeline_2026_05_03/watchdog_log.jsonl
//   ANIMA_DISPATCH_PATH        default: state/p9_path_a_r16_eval_pipeline_2026_05_03/eval_dispatch.json
//
// EXIT CODES
//   0 = trigger fired + dispatch attempted (apply) OR loop completed without trigger (timeout)
//       OR --once finished
//   1 = selftest fail
//   2 = config error / unrecoverable env issue
//
// raw#9  hexa-only Mac          (ssh/scp/curl shelled out via exec_with_status)
// raw#15 SSOT this file         (this hexa is single source for r16 trigger logic)
// raw#10 honest C3 (4 caveats):
//   (a) Watchdog 16h max-wait sized for ~8-13h r=16 train (per regression spec Track B wall_h band);
//       on timeout, manual re-fire required (no auto-extend; exit 0 with TIMEOUT label).
//   (b) ubu1-side run_all_lora_ckpts.sh writes to lora_results/ (shared dir w/ r=64 results).
//       Dispatch step1 sets DIR_OVERRIDE so r16 outputs land in lora_results_r16/; if run_all script
//       does not honor DIR_OVERRIDE, r16 SLUGs may collide with r64 cached files (skip-if-exists)
//       and yield empty r16 lora_results -> verdict will report n_ckpts=0. Operator must verify
//       lora_results_r16/*.json count after step2 scp.
//   (c) Mitigation comparison (step4) requires r=64 verdict ALSO present at ANIMA_R64_VERDICT.
//       If absent, comparison SKIPPED (r16 standalone verdict still emitted); rerun comparison
//       manually after r64 verdict lands.
//   (d) PushNotification rate: at most 1 notification per dispatch. In stage0 hexa, notify is a
//       stub (writes notify_payload.json); operator pulls via chat. No native push integration.

let LOG_PATH_DEFAULT      = "/Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/watchdog_log.jsonl"
let DISPATCH_PATH_DEFAULT = "/Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/eval_dispatch.json"
let NOTIFY_PATH           = "/Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/notify_payload.json"
let MITIGATION_CMP_PATH   = "/Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/mitigation_comparison.json"

// ─── INLINE_DEPRECATED[H42]: see shared/util/* canonical impls ────────────

fn _sq(s: string) -> string {
    let mut o = "'"
    o = o + s.replace("'", "'\\''")
    o = o + "'"
    return o
}
fn _file_exists(p: string) -> bool {
    return exec_with_status("test -e " + _sq(p))[1] == 0
}
fn _json_escape(s: string) -> string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}
fn _ts_iso() -> string {
    let r = exec_with_status("date -u +%Y-%m-%dT%H:%M:%SZ")
    return to_string(r[0]).trim()
}
fn _now_epoch() -> int {
    let r = exec_with_status("date -u +%s")
    return to_int(to_string(r[0]).trim())
}

fn _env_or(name: string, dflt: string) -> string {
    let r = exec_with_status("printf %s \"${" + name + ":-" + dflt + "}\"")
    return to_string(r[0])
}

fn _argv() -> array {
    let a = args()
    let mut o = []
    let mut i = 2
    while i < len(a) { o.push(a[i]); i = i + 1 }
    return o
}
fn _has(av, k) -> bool {
    let mut i = 0
    while i < len(av) { if to_string(av[i]) == k { return true }; i = i + 1 }
    return false
}

// ─── append-only JSONL log ─────────────────────────────────────────────

fn _log(path: string, event: string, payload_json: string) {
    let line = "{\"ts_utc\":\"" + _ts_iso() + "\",\"event\":\"" + event + "\",\"payload\":" + payload_json + "}\n"
    let q = _sq(line)
    let dir_cmd = "mkdir -p " + _sq(path.replace("/watchdog_log.jsonl", ""))
    exec_with_status(dir_cmd)
    exec_with_status("printf %s " + q + " >> " + _sq(path))
}

// ─── GUARD-3: signal-validity checks ─────────────────────────────────────

fn _check_local_verdict(path: string) -> string {
    if !_file_exists(path) { return "MISSING" }
    let parse_q = "python3 -c 'import json,sys; d=json.load(open(\"" + path + "\")); v=d.get(\"verdict\",\"\"); l = v.get(\"label\",\"\") if isinstance(v,dict) else str(v); print(l.upper())' 2>/dev/null"
    let r = exec_with_status(parse_q)
    if r[1] != 0 { return "PARSE_ERROR" }
    let label = to_string(r[0]).trim()
    if label == "" { return "INVALID_LABEL" }
    if label.contains("SUCCESS") || label.contains("PARTIAL") || label.contains("COMPLETE") || label.contains("ABORT") || label.contains("FAIL") {
        return "VALID:" + label
    }
    return "INVALID_LABEL:" + label
}

fn _check_ubu1_verdict(path: string) -> string {
    let probe = "ssh -o ConnectTimeout=8 -o BatchMode=yes ubu1 " + _sq("test -e " + path + " && python3 -c 'import json; d=json.load(open(\"" + path + "\")); v=d.get(\"verdict\",\"\"); print((v.get(\"label\",\"\") if isinstance(v,dict) else str(v)).upper())' 2>/dev/null") + " 2>/dev/null"
    let r = exec_with_status(probe)
    if r[1] != 0 { return "MISSING" }
    let label = to_string(r[0]).trim()
    if label == "" { return "PARSE_ERROR" }
    if label.contains("SUCCESS") || label.contains("PARTIAL") || label.contains("COMPLETE") || label.contains("ABORT") || label.contains("FAIL") {
        return "VALID:" + label
    }
    return "INVALID_LABEL:" + label
}

fn _check_hf_repo(repo: string, final_tag: string, min_ckpts: int) -> string {
    // Two-shot probe: (1) GET /api/models/<repo>/refs to count step-* branches/tags
    //                 (2) fallback: HEAD /api/models/<repo>/tree/<final_tag>
    let url_refs = "https://huggingface.co/api/models/" + repo + "/refs"
    let q = "curl -sSfL " + _sq(url_refs) + " 2>/dev/null | python3 -c 'import sys,json,re; d=json.load(sys.stdin); refs=[]; [refs.extend(d.get(k,[])) for k in (\"branches\",\"tags\",\"converts\")]; names=[r.get(\"name\",\"\") for r in refs]; steps=[n for n in names if re.match(r\"^(refs/tags/)?step-\\d+$\", n) or re.match(r\"^step-\\d+$\", n.split(\"/\")[-1])]; print(len(set(steps)))' 2>/dev/null"
    let r = exec_with_status(q)
    if r[1] == 0 {
        let count_str = to_string(r[0]).trim()
        if count_str != "" {
            let n = to_int(count_str)
            if n >= min_ckpts {
                return "VALID:n_ckpts_" + to_string(n)
            }
            // partial signal: log but not trigger
            // fall through to final-tag probe
        }
    }
    // Fallback final-tag probe
    let url_tag = "https://huggingface.co/api/models/" + repo + "/tree/" + final_tag
    let q2 = "curl -sSfL -o /dev/null -w '%{http_code}' " + _sq(url_tag) + " 2>/dev/null"
    let r2 = exec_with_status(q2)
    if r2[1] != 0 { return "MISSING" }
    let code = to_string(r2[0]).trim()
    if code == "200" { return "VALID:hf_tag_" + final_tag }
    return "MISSING:http_" + code
}

// ─── single poll ─────────────────────────────────────────────────────

fn _poll_once(local_path: string, ubu1_path: string, hf_repo: string, hf_tag: string, hf_min: int, log_path: string) -> string {
    let s_local = _check_local_verdict(local_path)
    let s_ubu1  = _check_ubu1_verdict(ubu1_path)
    let s_hf    = _check_hf_repo(hf_repo, hf_tag, hf_min)

    let payload = "{\"local\":\"" + _json_escape(s_local) + "\",\"ubu1\":\"" + _json_escape(s_ubu1) + "\",\"hf\":\"" + _json_escape(s_hf) + "\"}"
    _log(log_path, "poll", payload)
    println("[watchdog] " + _ts_iso() + " local=" + s_local + " ubu1=" + s_ubu1 + " hf=" + s_hf)

    if s_local.starts_with("VALID") { return "TRIGGER:LOCAL:" + s_local }
    if s_ubu1.starts_with("VALID")  { return "TRIGGER:UBU1:" + s_ubu1 }
    if s_hf.starts_with("VALID")    { return "TRIGGER:HF:" + s_hf }
    return "WAIT"
}

// ─── dispatch eval pipeline ──────────────────────────────────────────

fn _dispatch_eval(trigger_label: string, hf_repo: string, dispatch_path: string, log_path: string, remote_results: string, local_results: string, r64_verdict: string, apply: bool) -> int {
    let dispatch_dir = dispatch_path.replace("/eval_dispatch.json", "")
    exec_with_status("mkdir -p " + _sq(dispatch_dir))
    exec_with_status("mkdir -p " + _sq(local_results))

    let mut steps = []
    let ts_start = _ts_iso()

    // Step 1: ssh ubu1 -> run_all_lora_ckpts.sh w/ r16 repo + dedicated output dir override
    // Note: run_all_lora_ckpts.sh writes to $DIR/lora_results by default (DIR hardcoded).
    // We override DIR via env so r16 outputs land in lora_results_r16/ on the same parent.
    // Actual mechanism: run a wrapper that exports DIR + REPO + redirects results.
    let remote_parent = "/home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03"
    let ssh_cmd = "ssh -o ConnectTimeout=15 ubu1 " + _sq(
        "REPO=" + hf_repo + " " +
        "DIR=" + remote_parent + " " +
        "RESULTS_SUBDIR=lora_results_r16 " +
        "bash -c 'mkdir -p $DIR/$RESULTS_SUBDIR && for STEP in step-2000 step-4000 step-6000 step-8000 step-10000; do " +
        "SLUG=$(echo $STEP | tr - _); for TASK in hellaswag mmlu triviaqa; do " +
        "OUT=$DIR/$RESULTS_SUBDIR/${SLUG}_${TASK}.json; " +
        "if [ -f \"$OUT\" ]; then echo \"[skip] $OUT\"; continue; fi; " +
        "echo \"=== r16 $STEP $TASK ===\"; " +
        "/home/aiden/venv_orchestrator/bin/python $DIR/eval_llama_lora_ckpt.py " +
        "--ckpt-repo $REPO --ckpt-revision $STEP --task $TASK --limit 500 --output $OUT 2>&1 | tail -10; " +
        "done; done; echo \"=== R16 ALL DONE ===\"' 2>&1 | tail -300"
    )
    let mut step1_rc = -1
    let mut step1_out = ""
    if apply {
        let r1 = exec_with_status(ssh_cmd)
        step1_rc = r1[1]
        step1_out = to_string(r1[0]).trim()
        if len(step1_out) > 4000 { step1_out = step1_out.substring(len(step1_out) - 4000, len(step1_out)) }
    }
    steps.push("{\"step\":1,\"name\":\"ssh_ubu1_run_all_r16\",\"applied\":" + (if apply { "true" } else { "false" }) + ",\"rc\":" + to_string(step1_rc) + "}")

    // Step 2: scp r16 results back to Mac
    let scp_cmd = "scp ubu1:" + remote_parent + "/lora_results_r16/*.json " + local_results + "/ 2>&1"
    let mut step2_rc = -1
    if apply && step1_rc == 0 {
        let r2 = exec_with_status(scp_cmd)
        step2_rc = r2[1]
    }
    steps.push("{\"step\":2,\"name\":\"scp_r16_results\",\"cmd\":\"" + _json_escape(scp_cmd) + "\",\"rc\":" + to_string(step2_rc) + "}")

    // Step 3: hexa run p9_a_prime_verdict w/ r16 dirs
    let r16_verdict = "/Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/verdict.json"
    let verdict_cmd = "cd /Users/ghost/core/anima && " +
        "ANIMA_LORA_RESULTS_DIR=" + local_results + " " +
        "ANIMA_OUTPUT=" + r16_verdict + " " +
        "hexa run tool/p9_a_prime_verdict.hexa 2>&1 && " +
        "ANIMA_LORA_RESULTS_DIR=" + local_results + " " +
        "ANIMA_OUTPUT=" + r16_verdict + " " +
        "python3 /tmp/p9_a_prime_verdict_helper.py_tmp 2>&1"
    let mut step3_rc = -1
    if apply && step2_rc == 0 {
        let r3 = exec_with_status(verdict_cmd)
        step3_rc = r3[1]
    }
    steps.push("{\"step\":3,\"name\":\"r16_verdict\",\"rc\":" + to_string(step3_rc) + "}")

    // Step 4: mitigation comparison (only if r64 verdict exists)
    let mut step4_rc = -1
    let mut step4_skip_reason = ""
    if apply && step3_rc == 0 {
        if _file_exists(r64_verdict) && _file_exists(r16_verdict) {
            step4_rc = _emit_mitigation_comparison(r16_verdict, r64_verdict)
        } else {
            if !_file_exists(r64_verdict) {
                step4_skip_reason = "r64_verdict_missing:" + r64_verdict
            } else {
                step4_skip_reason = "r16_verdict_missing:" + r16_verdict
            }
        }
    }
    steps.push("{\"step\":4,\"name\":\"mitigation_comparison\",\"rc\":" + to_string(step4_rc) + ",\"skip_reason\":\"" + _json_escape(step4_skip_reason) + "\"}")

    // Compose dispatch JSON
    let ts_end = _ts_iso()
    let dispatch_json = "{\n" +
        "  \"schema\": \"anima/p9_path_a_r16_eval/dispatch/1\",\n" +
        "  \"trigger\": \"" + _json_escape(trigger_label) + "\",\n" +
        "  \"applied\": " + (if apply { "true" } else { "false" }) + ",\n" +
        "  \"ts_start\": \"" + ts_start + "\",\n" +
        "  \"ts_end\": \"" + ts_end + "\",\n" +
        "  \"r16_hf_repo\": \"" + _json_escape(hf_repo) + "\",\n" +
        "  \"steps\": [" + steps.join(",") + "],\n" +
        "  \"step1_tail\": \"" + _json_escape(step1_out) + "\"\n" +
        "}\n"
    write_file(dispatch_path, dispatch_json)

    _log(log_path, "dispatch", "{\"trigger\":\"" + _json_escape(trigger_label) + "\",\"applied\":" + (if apply { "true" } else { "false" }) + ",\"step_rcs\":[" + to_string(step1_rc) + "," + to_string(step2_rc) + "," + to_string(step3_rc) + "," + to_string(step4_rc) + "]}")

    _emit_notify(trigger_label, step3_rc, step4_rc, step4_skip_reason)

    if !apply { return 0 }
    if step1_rc == 0 && step2_rc == 0 && step3_rc == 0 { return 0 }
    return 1
}

// ─── mitigation comparison: r16 vs r64 falsifier check ────────────────

fn _emit_mitigation_comparison(r16_verdict_path: string, r64_verdict_path: string) -> int {
    let cmp_helper = "/tmp/p9_path_a_r16_mitigation_cmp.py_tmp"
    let parts = []
    parts.push("#!/usr/bin/env python3\n")
    parts.push("# r16 vs r64 mitigation comparison helper (raw#37 transient)\n")
    parts.push("import json, os, sys\n")
    parts.push("R16 = '" + r16_verdict_path + "'\n")
    parts.push("R64 = '" + r64_verdict_path + "'\n")
    parts.push("OUT = '" + MITIGATION_CMP_PATH + "'\n\n")
    parts.push("d16 = json.load(open(R16))\n")
    parts.push("d64 = json.load(open(R64))\n\n")
    parts.push("def per_task_by_ckpt(verdict):\n")
    parts.push("    return verdict.get('ckpt_verdicts', {})\n\n")
    parts.push("v16 = per_task_by_ckpt(d16)\n")
    parts.push("v64 = per_task_by_ckpt(d64)\n\n")
    parts.push("# Best ckpt per side\n")
    parts.push("def best(v):\n")
    parts.push("    rk = sorted(v.values(), key=lambda x: (x['composite']['f1_v3']=='PASS', x['composite']['n_strong'], -x['composite']['n_strong_regression']), reverse=True)\n")
    parts.push("    return rk[0] if rk else None\n\n")
    parts.push("b16 = best(v16); b64 = best(v64)\n\n")
    parts.push("# Per-step Δ table for all common ckpts\n")
    parts.push("common_ckpts = sorted(set(v16.keys()) & set(v64.keys()))\n")
    parts.push("per_ckpt_table = []\n")
    parts.push("for c in common_ckpts:\n")
    parts.push("    row = {'ckpt': c}\n")
    parts.push("    for task in ('hellaswag','mmlu','triviaqa'):\n")
    parts.push("        t16 = v16[c]['per_task'].get(task, {})\n")
    parts.push("        t64 = v64[c]['per_task'].get(task, {})\n")
    parts.push("        row[task] = {\n")
    parts.push("            'r16_delta_pt': t16.get('point_delta_pt'),\n")
    parts.push("            'r64_delta_pt': t64.get('point_delta_pt'),\n")
    parts.push("            'r16_signal': t16.get('signal'),\n")
    parts.push("            'r64_signal': t64.get('signal'),\n")
    parts.push("            'mitigation_delta_pt': (t16.get('point_delta_pt') or 0) - (t64.get('point_delta_pt') or 0),\n")
    parts.push("        }\n")
    parts.push("    per_ckpt_table.append(row)\n\n")
    parts.push("# F-PATHA-MITIGATION-1 falsifier (best r16 ckpt)\n")
    parts.push("falsifier = {'id': 'F-PATHA-MITIGATION-1', 'best_r16_ckpt': b16['ckpt_id'] if b16 else None}\n")
    parts.push("if b16:\n")
    parts.push("    triv = b16['per_task'].get('triviaqa', {})\n")
    parts.push("    delta_triv = triv.get('point_delta_pt')\n")
    parts.push("    ci_lo_triv = triv.get('ci95_lo_pt')\n")
    parts.push("    mc_p = (triv.get('mcnemar') or {}).get('p')\n")
    parts.push("    primary_pass = (delta_triv is not None and delta_triv >= 0.0\n")
    parts.push("                    and ci_lo_triv is not None and ci_lo_triv >= -0.5\n")
    parts.push("                    and mc_p is not None and mc_p > 0.05)\n")
    parts.push("    hs = b16['per_task'].get('hellaswag', {}).get('point_delta_pt')\n")
    parts.push("    mm = b16['per_task'].get('mmlu', {}).get('point_delta_pt')\n")
    parts.push("    secondary_pass = (hs is not None and hs >= 0.0) or (mm is not None and mm >= 0.0)\n")
    parts.push("    composite_no_strong_reg = (b16['composite']['n_strong_regression'] == 0)\n")
    parts.push("    falsifier.update({\n")
    parts.push("        'delta_triviaqa_pt': delta_triv,\n")
    parts.push("        'ci95_lo_triviaqa_pt': ci_lo_triv,\n")
    parts.push("        'mcnemar_p_triviaqa': mc_p,\n")
    parts.push("        'delta_hellaswag_pt': hs,\n")
    parts.push("        'delta_mmlu_pt': mm,\n")
    parts.push("        'primary_pass': primary_pass,\n")
    parts.push("        'secondary_pass': secondary_pass,\n")
    parts.push("        'composite_no_strong_regression': composite_no_strong_reg,\n")
    parts.push("    })\n")
    parts.push("    if primary_pass and secondary_pass and composite_no_strong_reg:\n")
    parts.push("        verdict_label = 'MITIGATION_PASS'\n")
    parts.push("    elif primary_pass and not secondary_pass:\n")
    parts.push("        verdict_label = 'MITIGATION_FAIL_NO_LIFT'\n")
    parts.push("    elif (not primary_pass) and (delta_triv is not None and delta_triv >= -0.5):\n")
    parts.push("        verdict_label = 'MITIGATION_PARTIAL'\n")
    parts.push("    else:\n")
    parts.push("        verdict_label = 'MITIGATION_FAIL_REGRESSION'\n")
    parts.push("else:\n")
    parts.push("    verdict_label = 'MITIGATION_NO_DATA'\n\n")
    parts.push("out = {\n")
    parts.push("    'schema': 'anima/p9_path_a_r16_mitigation_comparison/1',\n")
    parts.push("    'spec_ref': 'docs/p9_path_a_regression_mitigation_spec_2026_05_03.md F-PATHA-MITIGATION-1',\n")
    parts.push("    'r16_verdict_path': R16,\n")
    parts.push("    'r64_verdict_path': R64,\n")
    parts.push("    'best_r16': b16['composite'] if b16 else None,\n")
    parts.push("    'best_r64': b64['composite'] if b64 else None,\n")
    parts.push("    'per_ckpt_comparison': per_ckpt_table,\n")
    parts.push("    'falsifier': falsifier,\n")
    parts.push("    'mitigation_verdict': verdict_label,\n")
    parts.push("}\n")
    parts.push("os.makedirs(os.path.dirname(OUT) or '.', exist_ok=True)\n")
    parts.push("with open(OUT, 'w') as f: json.dump(out, f, indent=2, default=str)\n")
    parts.push("print(f'[mitigation_cmp] verdict={verdict_label} -> {OUT}')\n")
    write_file(cmp_helper, parts.join(""))
    let r = exec_with_status("python3 " + cmp_helper + " 2>&1")
    println(to_string(r[0]))
    return r[1]
}

fn _emit_notify(trigger: string, r16_rc: int, cmp_rc: int, cmp_skip: string) {
    let r16_status = if r16_rc == 0 { "OK" } else { "RC=" + to_string(r16_rc) }
    let cmp_status = if cmp_rc == 0 {
        "OK"
    } else {
        if cmp_skip != "" { "SKIPPED:" + cmp_skip } else { "RC=" + to_string(cmp_rc) }
    }
    let summary = "[r16-eval] trigger=" + trigger + " r16_verdict=" + r16_status + " mitigation_cmp=" + cmp_status
    let payload = "{\n" +
        "  \"ts_utc\": \"" + _ts_iso() + "\",\n" +
        "  \"summary\": \"" + _json_escape(summary) + "\",\n" +
        "  \"r16_verdict_path\": \"state/p9_path_a_r16_eval_pipeline_2026_05_03/verdict.json\",\n" +
        "  \"mitigation_cmp_path\": \"state/p9_path_a_r16_eval_pipeline_2026_05_03/mitigation_comparison.json\",\n" +
        "  \"notify_channel\": \"stub_stage0_no_native_push\"\n" +
        "}\n"
    write_file(NOTIFY_PATH, payload)
    println("[notify] " + summary)
    println("[notify] payload at " + NOTIFY_PATH)
}

// ─── main loop ─────────────────────────────────────────────────────

fn _run_loop(local_path: string, ubu1_path: string, hf_repo: string, hf_tag: string, hf_min: int, log_path: string, dispatch_path: string, remote_results: string, local_results: string, r64_verdict: string, poll_sec: int, max_wait_sec: int, apply: bool, single: bool) -> int {
    let t0 = _now_epoch()
    let mut elapsed = 0
    let mut iter = 0
    while elapsed <= max_wait_sec {
        iter = iter + 1
        let result = _poll_once(local_path, ubu1_path, hf_repo, hf_tag, hf_min, log_path)
        if result.starts_with("TRIGGER") {
            println("[watchdog] TRIGGER FIRED iter=" + to_string(iter) + " elapsed_sec=" + to_string(elapsed) + " label=" + result)
            _log(log_path, "trigger_fired", "{\"iter\":" + to_string(iter) + ",\"elapsed_sec\":" + to_string(elapsed) + ",\"label\":\"" + _json_escape(result) + "\"}")
            let rc = _dispatch_eval(result, hf_repo, dispatch_path, log_path, remote_results, local_results, r64_verdict, apply)
            return rc
        }
        if single { return 0 }
        elapsed = _now_epoch() - t0
        if elapsed + poll_sec > max_wait_sec { break }
        exec_with_status("sleep " + to_string(poll_sec))
        elapsed = _now_epoch() - t0
    }
    println("[watchdog] TIMEOUT max_wait_sec=" + to_string(max_wait_sec) + " iter=" + to_string(iter))
    _log(log_path, "timeout", "{\"max_wait_sec\":" + to_string(max_wait_sec) + ",\"iter\":" + to_string(iter) + "}")
    return 0
}

// ─── selftest ─────────────────────────────────────────────────────

fn cmd_selftest() {
    println("── path_a_r16_completion_watchdog selftest ──")
    println("inv:default_poll_interval_sec=600")
    println("inv:default_max_wait_sec=57600")
    println("inv:n_signals=3")
    println("inv:signals=local_verdict,ubu1_verdict,hf_repo_refs_or_tag")
    println("inv:guard3_label_set=SUCCESS,PARTIAL,COMPLETE,ABORT,FAIL")
    println("inv:hf_min_ckpts_default=5")
    println("inv:expected_ckpt_steps=2000,4000,6000,8000,10000")
    println("inv:dispatch_steps=4")
    println("inv:dispatch=ssh_run_all_r16,scp,r16_verdict,mitigation_comparison")
    println("inv:mitigation_cmp_skip_if_r64_missing=true")
    println("inv:mitigation_verdict_states=MITIGATION_PASS,MITIGATION_PARTIAL,MITIGATION_FAIL_NO_LIFT,MITIGATION_FAIL_REGRESSION,MITIGATION_NO_DATA")
    println("inv:falsifier_id=F-PATHA-MITIGATION-1")
    println("inv:falsifier_primary=delta_triviaqa_geq_0_AND_ci_lo_geq_neg_0p5_AND_mcnemar_p_gt_0p05")
    println("inv:falsifier_secondary=delta_hellaswag_geq_0_OR_delta_mmlu_geq_0")
    println("inv:notify=stub_stage0")
    println("inv:non_mutation_dry_default=true")

    let ts = _ts_iso()
    if len(ts) < 10 {
        eprintln("selftest=fail (ts_iso empty)")
        exit(1)
    }
    let q_ok = _sq("hello world")
    if q_ok != "'hello world'" {
        eprintln("selftest=fail (sq mismatch: " + q_ok + ")")
        exit(1)
    }
    println("selftest=ok ts=" + ts)
    println("DONE")
}

fn main() {
    let av = _argv()
    if _has(av, "--selftest") { cmd_selftest(); exit(0) }

    let local_path     = _env_or("ANIMA_R16_VERDICT_LOCAL",   "/Users/ghost/core/anima/state/p9_path_a_r16_h100_2026_05_03/verdict.json")
    let ubu1_path      = _env_or("ANIMA_R16_VERDICT_UBU1",    "/home/aiden/anima/state/p9_path_a_r16_h100_2026_05_03/verdict.json")
    let hf_repo        = _env_or("ANIMA_R16_HF_REPO",         "dancinlab/llm-llama32-3b-paradigm-a-prime-r16-sft-stage1")
    let hf_tag         = _env_or("ANIMA_R16_HF_FINAL_TAG",    "step-10000")
    let hf_min         = to_int(_env_or("ANIMA_R16_HF_MIN_CKPTS", "5"))
    let r64_verdict    = _env_or("ANIMA_R64_VERDICT",         "/Users/ghost/core/anima/state/p9_a_prime_main_eval_2026_05_03_verdict.json")
    let remote_results = _env_or("ANIMA_R16_REMOTE_RESULTS",  "/home/aiden/anima/state/p9_a_prime_main_eval_2026_05_03/lora_results_r16")
    let local_results  = _env_or("ANIMA_R16_LOCAL_RESULTS",   "/Users/ghost/core/anima/state/p9_path_a_r16_eval_pipeline_2026_05_03/lora_results")
    let log_path       = _env_or("ANIMA_LOG_PATH",            LOG_PATH_DEFAULT)
    let disp_path      = _env_or("ANIMA_DISPATCH_PATH",       DISPATCH_PATH_DEFAULT)
    let poll_sec       = to_int(_env_or("ANIMA_POLL_INTERVAL_SEC", "600"))
    let max_wait       = to_int(_env_or("ANIMA_MAX_WAIT_SEC",      "57600"))

    let apply  = _has(av, "--apply")
    let single = _has(av, "--once")

    println("[watchdog] start ts=" + _ts_iso() + " apply=" + (if apply { "yes" } else { "no" }) + " mode=" + (if single { "once" } else { "loop" }))
    println("[watchdog] local=" + local_path)
    println("[watchdog] ubu1=" + ubu1_path)
    println("[watchdog] hf=" + hf_repo + " final_tag=" + hf_tag + " min_ckpts=" + to_string(hf_min))
    println("[watchdog] r64_verdict=" + r64_verdict)
    println("[watchdog] poll_sec=" + to_string(poll_sec) + " max_wait=" + to_string(max_wait))

    _log(log_path, "start", "{\"apply\":" + (if apply { "true" } else { "false" }) + ",\"mode\":\"" + (if single { "once" } else { "loop" }) + "\",\"hf_repo\":\"" + _json_escape(hf_repo) + "\"}")

    let rc = _run_loop(local_path, ubu1_path, hf_repo, hf_tag, hf_min, log_path, disp_path, remote_results, local_results, r64_verdict, poll_sec, max_wait, apply, single)
    exit(rc)
}

main()
