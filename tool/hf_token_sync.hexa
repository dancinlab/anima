#!hexa strict
// tool/hf_token_sync.hexa — Auto-sync canonical HF token to all consumer caches (raw#9, raw#15)
//
// @tool(slug="hf_token_sync", desc="Push the canonical `secret get huggingface.token` value to all downstream consumer caches: Mac HF CLI cache, ubu1 HF CLI cache (via ssh), and 4 GitHub Actions repo secrets (via gh secret set HF_TOKEN). Atomic best-effort: any failure logged but non-blocking. Does NOT touch deprecated legacy paths (~/.hf_token, .secrets/hf_token, /workspace/hf_token).")
// @usage(hexa run tool/hf_token_sync.hexa --selftest)
// @usage(hexa run tool/hf_token_sync.hexa --dry-run)
// @usage(hexa run tool/hf_token_sync.hexa --apply)
// @usage(hexa run tool/hf_token_sync.hexa --apply --skip-ubu1 --skip-github)
// @sentinel(__HF_TOKEN_SYNC__ <PASS|FAIL>)
//
// Spec: docs/hf_token_sssot_spec_2026_05_04.md
// Resolver SSOT: tool/hf_token_resolver.hexa
//
// Targets:
//   T1) Mac:    $HOME/.cache/huggingface/token        chmod 0600
//   T2) ubu1:   /home/aiden/.cache/huggingface/token  chmod 0600 (via ssh)
//   T3) GH:     gh secret set HF_TOKEN --repo dancinlab/{qmirror,sim-universe,hexa-bio,honesty-monitor}
//
// raw#10 honest caveats:
//   1) Atomicity NOT guaranteed across machines — partial sync possible if
//      ssh fails mid-run or `gh secret set` hits HTTP 5xx. Re-run --apply is
//      idempotent (overwrite semantics) so retry is safe.
//   2) GitHub Actions secret update REQUIRES `gh auth status` to be valid for
//      a token with `repo` scope. Pre-flight check included; fails LOUD if missing.
//   3) ubu1 sync REQUIRES ssh-agent forwarding OR password-less key. We use
//      `ssh -o BatchMode=yes` to FAIL FAST if interactive auth would be needed
//      (instead of hanging the chat).
//   4) DOES NOT update legacy paths (~/.hf_token, /Users/ghost/core/anima/.secrets/hf_token,
//      /workspace/hf_token). Those are DEPRECATED and slated for cleanup script
//      removal. If a consumer breaks, migrate it to the resolver instead of
//      adding back the legacy write.
//
// raw#15 honest caveats:
//   - Token plaintext NEVER printed to stdout/stderr. Only sha256-prefix-8.
//   - Plaintext flows via stdin redirection only (echo "$tok" | ssh ...,
//     printf '%s' "$tok" | gh secret set ...). No argv exposure.
//   - --dry-run does NOT touch any target; prints planned actions + sha prefix only.

let VERSION = "1.0.0"
let HOME = exec("echo \"$HOME\"").trim()
let ANIMA_ROOT = HOME + "/core/anima"
let LEDGER = ANIMA_ROOT + "/state/hf_token_consolidation_2026_05_04/sync_ledger.jsonl"

let GH_REPOS = [
    "dancinlab/qmirror",
    "dancinlab/sim-universe",
    "dancinlab/hexa-bio",
    "dancinlab/honesty-monitor",
]

let UBU1_HOST = "ubu1"
let UBU1_CACHE_PATH = "/home/aiden/.cache/huggingface/token"
let MAC_CACHE_PATH = HOME + "/.cache/huggingface/token"

// ─── helpers ───────────────────────────────────────────────────────────

fn _sh_q(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _ts() -> str { return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() }

fn _resolve_token() -> str {
    // Delegated lookup — duplicates resolver tier order intentionally so this
    // file remains a self-contained operational tool. Keep tiers in sync with
    // tool/hf_token_resolver.hexa.
    let s1 = exec("secret get huggingface.token 2>/dev/null").trim()
    if s1.len() > 0 { return s1 }
    let p2 = HOME + "/.cache/huggingface/token"
    let f2 = exec("test -f " + _sh_q(p2) + " && cat " + _sh_q(p2) + " 2>/dev/null").trim()
    if f2.len() > 0 { return f2 }
    let env1 = exec("echo \"$HF_TOKEN\"").trim()
    if env1.len() > 0 { return env1 }
    return ""
}

fn _sha256_prefix(s: str) -> str {
    if s.len() == 0 { return "(empty)" }
    // body rewired to stdlib FIPS 180-4 builtin (hexa-lang #884 sha256 alias surface);
    // printf-stdin shell-out + GNU/BSD fallback removed. raw#15 token-leak safety
    // is strengthened — sha256(s) is in-process, so the token never reaches argv,
    // a pipe, or a subprocess (no `ps` leak). 8-char prefix unchanged (byte-equal).
    return sha256(s).substring(0, 8)
}

fn _ledger_append(line: str) {
    let cmd = "mkdir -p " + _sh_q(ANIMA_ROOT + "/state/hf_token_consolidation_2026_05_04")
              + " && printf '%s\\n' " + _sh_q(line) + " >> " + _sh_q(LEDGER)
    exec(cmd)
}

// ─── pre-flight ────────────────────────────────────────────────────────

fn _preflight_token() -> str {
    let tok = _resolve_token()
    if tok.len() == 0 {
        println("PREFLIGHT_FAIL: no canonical token (secret get huggingface.token returned empty)")
        println("hint: pbpaste | secret set huggingface.token")
        exit(2)
    }
    return tok
}

fn _preflight_gh() -> int {
    let st = exec("gh auth status 2>&1 | head -5").trim()
    if st.contains("Logged in") { return 1 }
    println("PREFLIGHT_WARN: gh auth status not ready — github sync will be skipped")
    println("  hint: gh auth login")
    return 0
}

fn _preflight_ssh_ubu1() -> int {
    let probe = exec("ssh -o BatchMode=yes -o ConnectTimeout=5 " + UBU1_HOST + " 'echo OK' 2>&1").trim()
    if probe == "OK" { return 1 }
    println("PREFLIGHT_WARN: ubu1 ssh not ready — ubu1 sync will be skipped")
    println("  probe_result=" + probe.substring(0, if probe.len() < 80 { probe.len() } else { 80 }))
    return 0
}

// ─── target sync actions ───────────────────────────────────────────────

fn sync_mac_cache(tok: str, dry: bool) -> str {
    // Write via stdin redirection (no argv); chmod 0600.
    if dry { return "DRY: would write " + MAC_CACHE_PATH + " (0600)" }
    let cmd = "umask 077 && printf '%s' " + _sh_q(tok)
              + " > " + _sh_q(MAC_CACHE_PATH)
              + " && chmod 0600 " + _sh_q(MAC_CACHE_PATH)
              + " && echo OK || echo FAIL"
    let r = exec(cmd).trim()
    return "mac_cache:" + r
}

fn sync_ubu1_cache(tok: str, dry: bool, ssh_ok: int) -> str {
    if ssh_ok == 0 { return "ubu1_cache:SKIP_SSH_UNAVAILABLE" }
    if dry { return "DRY: would scp-via-stdin to " + UBU1_HOST + ":" + UBU1_CACHE_PATH + " (0600)" }
    // Pipe token via stdin to ssh; remote shell uses umask 077 + chmod 0600.
    let remote = "umask 077 && cat > " + _sh_q(UBU1_CACHE_PATH)
                 + " && chmod 0600 " + _sh_q(UBU1_CACHE_PATH)
                 + " && echo OK"
    let cmd = "printf '%s' " + _sh_q(tok)
              + " | ssh -o BatchMode=yes -o ConnectTimeout=10 " + UBU1_HOST
              + " " + _sh_q(remote)
              + " 2>&1 | tail -1"
    let r = exec(cmd).trim()
    if r == "OK" { return "ubu1_cache:OK" }
    return "ubu1_cache:FAIL(" + r.substring(0, if r.len() < 60 { r.len() } else { 60 }) + ")"
}

fn sync_github_secret(tok: str, repo: str, dry: bool, gh_ok: int) -> str {
    if gh_ok == 0 { return repo + ":SKIP_GH_AUTH_UNAVAILABLE" }
    if dry { return "DRY: would `gh secret set HF_TOKEN --repo " + repo + "`" }
    // Use --body-file - to read from stdin (no argv exposure).
    let cmd = "printf '%s' " + _sh_q(tok)
              + " | gh secret set HF_TOKEN --repo " + _sh_q(repo)
              + " --body-file - 2>&1 | tail -1"
    let r = exec(cmd).trim()
    // gh prints "✓ Set Actions secret HF_TOKEN for ..." on success.
    if r.contains("Set") || r.contains("✓") { return repo + ":OK" }
    return repo + ":FAIL(" + r.substring(0, if r.len() < 60 { r.len() } else { 60 }) + ")"
}

// ─── orchestration ─────────────────────────────────────────────────────

fn cmd_apply(dry: bool, skip_ubu1: bool, skip_github: bool) {
    let tok = _preflight_token()
    let pref = _sha256_prefix(tok)
    println("canonical_sha256_prefix=" + pref)
    println("ts=" + _ts())
    println("dry_run=" + if dry { "true" } else { "false" })

    let gh_ok = if skip_github { 0 } else { _preflight_gh() }
    let ssh_ok = if skip_ubu1 { 0 } else { _preflight_ssh_ubu1() }

    let mut results = []
    results = results.push(sync_mac_cache(tok, dry))
    results = results.push(sync_ubu1_cache(tok, dry, ssh_ok))
    let mut i = 0
    while i < GH_REPOS.len() {
        results = results.push(sync_github_secret(tok, GH_REPOS[i], dry, gh_ok))
        i = i + 1
    }

    println("── sync results ──")
    let mut j = 0
    let mut all_ok = 1
    while j < results.len() {
        let r = results[j]
        println("  " + r)
        if r.contains("FAIL") { all_ok = 0 }
        j = j + 1
    }

    let verdict = if all_ok == 1 { "PASS" } else { "PARTIAL" }
    let line = "{\"ts\":\"" + _ts()
               + "\",\"sha256_prefix\":\"" + pref
               + "\",\"dry_run\":" + if dry { "true" } else { "false" }
               + ",\"verdict\":\"" + verdict
               + "\",\"results\":\"" + results.join(" | ").replace("\"", "'") + "\"}"
    if !dry { _ledger_append(line) }
    println("verdict=" + verdict)
    println("__HF_TOKEN_SYNC__ " + verdict)
}

fn cmd_selftest() {
    println("── hf_token_sync selftest ──")
    println("version=" + VERSION)
    println("targets:")
    println("  T1 mac_cache=" + MAC_CACHE_PATH + " (0600)")
    println("  T2 ubu1_cache=" + UBU1_HOST + ":" + UBU1_CACHE_PATH + " (0600)")
    let mut i = 0
    while i < GH_REPOS.len() {
        println("  T3." + str(i+1) + " gh_secret=HF_TOKEN @ " + GH_REPOS[i])
        i = i + 1
    }
    println("invariants:")
    println("  inv:resolver_ssot=tool/hf_token_resolver.hexa (tier1=secret get huggingface.token)")
    println("  inv:atomicity=best_effort (raw#10 caveat #1)")
    println("  inv:legacy_paths_NOT_written=[~/.hf_token, .secrets/hf_token, /workspace/hf_token]")
    println("  inv:raw15_no_plaintext_in_logs=true")
    println("  inv:argv_exposure=none (token via stdin pipe only)")
    println("  inv:default_mode=help (apply requires --apply)")
    println("preflight (read-only):")
    let tok = exec("secret get huggingface.token 2>/dev/null").trim()
    let tok_present = if tok.len() > 0 { "true" } else { "false" }
    println("  canonical_token_present=" + tok_present)
    if tok.len() > 0 {
        println("  canonical_sha256_prefix=" + _sha256_prefix(tok))
    }
    let gh = exec("gh auth status 2>&1 | head -3 | grep -c 'Logged in' || true").trim()
    println("  gh_auth_logged_in=" + gh)
    let ssh = exec("ssh -o BatchMode=yes -o ConnectTimeout=3 " + UBU1_HOST + " 'echo OK' 2>&1 | tail -1").trim()
    println("  ubu1_ssh_probe=" + ssh)
    println("selftest=ok")
    println("DONE")
}

fn cmd_help() {
    println("hf_token_sync v" + VERSION)
    println("usage:")
    println("  hexa run tool/hf_token_sync.hexa --selftest")
    println("  hexa run tool/hf_token_sync.hexa --dry-run")
    println("  hexa run tool/hf_token_sync.hexa --apply [--skip-ubu1] [--skip-github]")
    println("")
    println("targets:")
    println("  T1 mac    : ~/.cache/huggingface/token (0600)")
    println("  T2 ubu1   : /home/aiden/.cache/huggingface/token (0600, via ssh BatchMode)")
    println("  T3 github : HF_TOKEN secret on 4 repos (qmirror, sim-universe, hexa-bio, honesty-monitor)")
    println("")
    println("raw#10 caveats:")
    println("  - cross-machine atomicity not guaranteed; --apply is idempotent (safe to retry)")
    println("  - github sync requires `gh auth status` valid (repo scope)")
    println("  - ubu1 sync requires non-interactive ssh (BatchMode)")
    println("  - legacy paths NEVER written (deprecation enforcement)")
}

fn main() {
    let av = argv()
    let mut mode = "help"
    let mut skip_ubu1 = false
    let mut skip_github = false
    let mut i = 2
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { mode = "selftest" }
        else if a == "--dry-run" { mode = "dry" }
        else if a == "--apply" { mode = "apply" }
        else if a == "--skip-ubu1" { skip_ubu1 = true }
        else if a == "--skip-github" { skip_github = true }
        else if a == "--help" || a == "-h" { mode = "help" }
        i = i + 1
    }
    if mode == "selftest" { cmd_selftest(); exit(0) }
    if mode == "dry" { cmd_apply(true, skip_ubu1, skip_github); exit(0) }
    if mode == "apply" { cmd_apply(false, skip_ubu1, skip_github); exit(0) }
    cmd_help()
}
