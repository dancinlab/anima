// tool/dispatch_p21h_v3_vast.hexa — DECODER M3 4축 H100 Vast.ai dispatch runbook
//
// Hexa-native runbook printer (mirrors CORE/DECODER/dispatch_m4b_pilot.hexa
// pattern). Prints the canonical 9-step Vast.ai SOP for the 4-axis P21H V3
// fire so the operator (or hexa cloud automation) executes the dispatch
// deterministically and orphan-free.
//
// Why hexa-native runbook (not auto-dispatcher):
//   - project.tape g_hexa_only_authoring blocks new .sh creation
//   - hexa stdlib/cloud runpod transport is blocked by hexa-lang #1659
//     (pod-id → SSH host resolver gap on RunPod)
//   - Vast.ai exposes ssh_host/port directly so plain ssh/scp from Mac
//     works without a cloud-guard tunnel — same SOP M4b PR #1119/1120/1121
//     ran by hand to land cuBLAS engagement + real-BPE pilot + F-M4B-FIRE.
//   - dispatch_p21h_v3.hexa (HEXAD/PURE/launchers, v0.2 STDLIB-WIRED) is the
//     hexa-cloud auto-dispatcher path; this Vast.ai SOP unblocks it until
//     stdlib/cloud absorbs the Vast.ai backend (hexa-lang #1659 followup).
//
// Hardening (vs prior $3.92 orphan saga, c25njysjdga2vb 158 min idle):
//   1. ARGV ECHO at launch_guard.sh wrap — catches stale on-pod launcher
//      / script-path-arg missing class-1 silent failure
//      (state/p21h_v3_curricula_recover_2026_05_25/README.md re-fire plan)
//   2. EARLY-LIFE POLL — train.log must show [P21H][axis] line within 90s
//      else abort + teardown
//   3. SCP STABILITY GUARD — 3 consecutive `echo READY` probes required
//      before first scp (memory: cuBLAS glue + Vast boot-flakiness)
//   4. ENV-VAR ANTI-CONCAT — each P21H_* on its own env line, never
//      one merged string (dispatch_p21h_v3_runpod.sh §22-36 anti-pattern)
//   5. DETACH-DEFAULT — early-life PASS → exit; fire continues on pod;
//      caller polls externally (agent-context-safe, no orphan on agent
//      timeout)
//
// Usage:
//   hexa run tool/dispatch_p21h_v3_vast.hexa                    # bare = full 4-axis runbook
//   hexa run tool/dispatch_p21h_v3_vast.hexa A                  # axis A only
//   hexa run tool/dispatch_p21h_v3_vast.hexa A qwen 1337        # axis A · qwen init · seed
//   hexa run tool/dispatch_p21h_v3_vast.hexa smoke A qwen 1337  # smoke (50-step) for pipeline gate

fn _axis_desc(axis: str) -> str {
    if axis == "A" { return "curriculum (P21H_CURRICULUM_PHASE_STEPS=STEPS/2)" }
    if axis == "B" { return "distill (P21H_HEAD_G_ENABLE=1 · dummy teacher · HONEST TODO #B1)" }
    if axis == "C" { return "head_g_lambda (P21H_HEAD_G_ENABLE=1 P21H_HEAD_G_WEIGHT=0.1)" }
    if axis == "D" { return "freeze_embed (P21H_FREEZE_EMBED=1 · tok_emb+head_a frozen)" }
    return "unknown"
}

fn _axis_env_lines(axis: str, steps: int) -> list {
    // Each var on its OWN line — anti-concat guard.
    // Default 4-axis env lines (only the active axis flips ON; others baseline=0).
    let half = steps / 2
    let mut lines = [
        "    P21H_CURRICULUM_PHASE_STEPS=0",
        "    P21H_DISTILL_TEACHER=\"\"",
        "    P21H_HEAD_G_OBJECTIVE=\"\"",
        "    P21H_HEAD_G_ENABLE=0",
        "    P21H_HEAD_G_WEIGHT=0.0",
        "    P21H_FREEZE_EMBED=0",
        "    P21H_LANG_BALANCED=0",
        "    P21H_CONTRASTIVE_LANG=0.0",
    ]
    if axis == "A" {
        lines = [
            "    P21H_CURRICULUM_PHASE_STEPS=" + str(half),
            "    P21H_DISTILL_TEACHER=\"\"",
            "    P21H_HEAD_G_OBJECTIVE=\"\"",
            "    P21H_HEAD_G_ENABLE=0",
            "    P21H_HEAD_G_WEIGHT=0.0",
            "    P21H_FREEZE_EMBED=0",
            "    P21H_LANG_BALANCED=0",
            "    P21H_CONTRASTIVE_LANG=0.0",
        ]
    }
    if axis == "B" {
        lines = [
            "    P21H_CURRICULUM_PHASE_STEPS=0",
            "    P21H_DISTILL_TEACHER=\"\"",
            "    P21H_HEAD_G_OBJECTIVE=\"kd_dummy\"",
            "    P21H_HEAD_G_ENABLE=1",
            "    P21H_HEAD_G_WEIGHT=0.1",
            "    P21H_FREEZE_EMBED=0",
            "    P21H_LANG_BALANCED=0",
            "    P21H_CONTRASTIVE_LANG=0.0",
        ]
    }
    if axis == "C" {
        lines = [
            "    P21H_CURRICULUM_PHASE_STEPS=0",
            "    P21H_DISTILL_TEACHER=\"\"",
            "    P21H_HEAD_G_OBJECTIVE=\"\"",
            "    P21H_HEAD_G_ENABLE=1",
            "    P21H_HEAD_G_WEIGHT=0.1",
            "    P21H_FREEZE_EMBED=0",
            "    P21H_LANG_BALANCED=0",
            "    P21H_CONTRASTIVE_LANG=0.0",
        ]
    }
    if axis == "D" {
        lines = [
            "    P21H_CURRICULUM_PHASE_STEPS=0",
            "    P21H_DISTILL_TEACHER=\"\"",
            "    P21H_HEAD_G_OBJECTIVE=\"\"",
            "    P21H_HEAD_G_ENABLE=0",
            "    P21H_HEAD_G_WEIGHT=0.0",
            "    P21H_FREEZE_EMBED=1",
            "    P21H_LANG_BALANCED=0",
            "    P21H_CONTRASTIVE_LANG=0.0",
        ]
    }
    return lines
}

fn _lr_for_init(init: str) -> str {
    if init == "random" { return "3e-4" }
    if init == "qwen"   { return "5e-5" }
    if init == "vp21m"  { return "1e-4" }
    return "5e-5"
}

fn _print_cost_estimate(smoke: bool, n_pods: int) {
    println("─── Cost estimate (a_fire_autonomous one-liner · no cost cap) ───")
    if smoke {
        println("  Smoke: Vast.ai H100 SXM ($2.27-3.45/hr) · ~0.5hr wall · $1-2 single pod")
    } else {
        println("  Per-axis 5K step: Vast.ai H100 SXM ($2.27-3.45/hr) · ~6hr wall · $13-21 per pod")
        println("  4-pod parallel (a_wall_first): ~$54-83 wall ~6hr total")
        if n_pods > 0 {
            println("  This invocation: " + str(n_pods) + " pod(s)")
        }
    }
    println("")
}

