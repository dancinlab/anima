// ════════════════════════════════════════════════════════════════════════
// Per-axis env-var protocol (anti-concat — one var per pub fn return key)
// ════════════════════════════════════════════════════════════════════════

fn _axis_env(axis: string) -> map {
    // Each var on its own map entry — anti-concat guard (the original
    // dispatch_p21h_v3_runpod.sh §22-36 anti-pattern merged into one string;
    // hexa map ↔ env-var line conversion downstream guarantees separation).
    if axis == "A" {
        return #{
            "P21H_CURRICULUM_PHASE_STEPS": "2500",
            "P21H_HEAD_G_OBJECTIVE": "",
            "P21H_HEAD_G_ENABLE": "0",
            "P21H_HEAD_G_WEIGHT": "0.0",
            "P21H_FREEZE_EMBED": "0"
        }
    }
    if axis == "B" {
        // OPT-IN ONLY — see _axis_b_warning() below for the HONEST scope.
        return #{
            "P21H_CURRICULUM_PHASE_STEPS": "0",
            "P21H_HEAD_G_OBJECTIVE": "kd_dummy",
            "P21H_HEAD_G_ENABLE": "1",
            "P21H_HEAD_G_WEIGHT": "0.1",
            "P21H_FREEZE_EMBED": "0"
        }
    }
    if axis == "C" {
        return #{
            "P21H_CURRICULUM_PHASE_STEPS": "0",
            "P21H_HEAD_G_OBJECTIVE": "",
            "P21H_HEAD_G_ENABLE": "1",
            "P21H_HEAD_G_WEIGHT": "0.1",
            "P21H_FREEZE_EMBED": "0"
        }
    }
    if axis == "D" {
        return #{
            "P21H_CURRICULUM_PHASE_STEPS": "0",
            "P21H_HEAD_G_OBJECTIVE": "",
            "P21H_HEAD_G_ENABLE": "0",
            "P21H_HEAD_G_WEIGHT": "0.0",
            "P21H_FREEZE_EMBED": "1"
        }
    }
    // Unknown axis → baseline.
    return #{
        "P21H_CURRICULUM_PHASE_STEPS": "0",
        "P21H_HEAD_G_OBJECTIVE": "",
        "P21H_HEAD_G_ENABLE": "0",
        "P21H_HEAD_G_WEIGHT": "0.0",
        "P21H_FREEZE_EMBED": "0"
    }
}

fn _lr_for_init(init: string) -> string {
    if init == "random" { return "3e-4" }
    if init == "qwen"   { return "5e-5" }
    if init == "vp21m"  { return "1e-4" }
    return "5e-5"
}

fn _axis_b_warning() -> string {
    // Printed before any axis B dispatch — HONEST scope per
    // a_completeness_over_cheap. See state/p21h_v3_m3_pilot_scope_2026_05_28/
    // AXIS_B_DEFERRED.md for the structural reason.
    return "[axis-B WARNING] axis B teacher LoRA weight (adapter_model.safetensors) " +
           "ABSENT from origin/main. train_p21h_v3.py:846-851 documents the Python " +
           "axis B as a no-op without a teacher. Firing axis B with dummy teacher " +
           "produces a control-replica of baseline (no KD signal). Default axes for " +
           "dispatch_main are [A,C,D]; only opt in to axis B if you know why."
}

// ════════════════════════════════════════════════════════════════════════
// Pod provisioning (Vast.ai)
// ════════════════════════════════════════════════════════════════════════

// Build vastai create command for one axis pod. Returns the COMMAND STRING
// (caller chooses when to exec — keeps the fn deterministic + testable).
//
// Vast.ai create flow (M4b PR #1119/#1120/#1121 validated pattern):
//   1. vastai search offers ... -o dph_total --raw → pick cheapest H100 SXM
//   2. vastai create instance $OFFER --image ... --disk 80 --ssh --direct
//                       --label p21h-v3-<axis>-<init> --raw
//   3. parse instance id from stdout
fn _build_vast_search_cmd() -> string {
    let q = "gpu_name=H100_SXM num_gpus=1 reliability>0.98 " +
            "dph_total<3.5 disk_space>50 inet_down>500 rentable=true"
    return "vastai search offers '" + q + "' -o dph_total --raw"
}

fn _build_vast_create_cmd(offer_id: string, axis: string, init: string) -> string {
    let mut cmd = "vastai create instance " + offer_id
    cmd = cmd + " --image " + _vast_image()
    cmd = cmd + " --disk 80 --ssh --direct"
    cmd = cmd + " --label p21h-v3-" + axis + "-" + init
    cmd = cmd + " --raw"
    return cmd
}

fn _build_vast_show_cmd(instance_id: string) -> string {
    return "vastai show instance " + instance_id + " --raw"
}

fn _build_vast_destroy_cmd(instance_id: string) -> string {
    return "vastai destroy instance " + instance_id
}

// Provision one Vast.ai pod for the given axis. Returns a dict carrying
// instance_id + host + port + commands invoked. On any exec() error this
// returns instance_id="" so the caller can detect failure and skip the
// rest of the per-axis pipeline.
pub fn dispatch_provision_pod(axis: string, init: string, smoke: bool) -> map {
    let _ = smoke   // smoke flag carried for caller; same pod shape (logged downstream)
    let label = "p21h-v3-" + axis + "-" + init
    println("[provision] axis=" + axis + " init=" + init + " label=" + label)
    // a_fire_autonomous one-liner cost estimate:
    println("[provision] estimated cost: ~$2.27-3.45/hr (H100 SXM Vast.ai · 1 pod) · ~0.5hr smoke or ~6hr full")
    // CALLER opportunity to short-circuit if running pure-test mode:
    let dry_run = exec("printenv P21H_DISPATCH_DRY 2>/dev/null").trim()
    if dry_run == "1" {
        println("[provision] DRY-RUN: skip vastai create (P21H_DISPATCH_DRY=1)")
        return #{
            "axis": axis, "instance_id": "DRY", "host": "DRY-HOST",
            "port": 22, "dry_run": true
        }
    }
    let search_cmd = _build_vast_search_cmd()
    println("[provision] search: " + search_cmd)
    // Caller invokes the actual creation. This pub fn returns a structured
    // plan so the caller can stagger / parallelize as needed.
    return #{
        "axis": axis, "init": init,
        "search_cmd": search_cmd,
        "create_cmd_template": "vastai create instance <OFFER_ID> --image " + _vast_image() +
                               " --disk 80 --ssh --direct --label " + label + " --raw",
        "show_cmd_template": "vastai show instance <INSTANCE_ID> --raw",
        "destroy_cmd_template": "vastai destroy instance <INSTANCE_ID>"
    }
}

// ════════════════════════════════════════════════════════════════════════
// SSH readiness probe (3-consec READY guard per Vast boot-flakiness memory)
// ════════════════════════════════════════════════════════════════════════

// Probe ssh via `hexa cloud exec` — cloud-guard compliant. Returns true
// only after 3 consecutive successful `echo READY` returns (handles the
// well-known ~1 min Vast boot-flakiness window where sshd accepts but scp
// 255s out).
pub fn dispatch_wait_ssh_ready(host: string, port: int) -> bool {
    println("[ssh-ready] probing " + host + ":" + to_string(port) + " (3-consec READY guard)")
    let mut consec = 0
    let mut tries = 0
    let max_tries = 30   // ~5 min upper bound (10s per probe)
    while tries < max_tries {
        let cmd = "hexa cloud exec " + host +
                  " --port " + to_string(port) + " --insecure -- echo READY"
        let out = exec(cmd)
        if out.trim() == "READY" {
            consec = consec + 1
            println("[ssh-ready] consec=" + to_string(consec) + "/3")
            if consec >= 3 { return true }
        } else {
            consec = 0
        }
        tries = tries + 1
    }
    println("[ssh-ready] FAIL after " + to_string(max_tries) + " probes")
    return false
}

// ════════════════════════════════════════════════════════════════════════
// Source upload (Blocker 1 fix — correct launch_trainer.sh filename)
// ════════════════════════════════════════════════════════════════════════

// Copy sources via `hexa cloud copy-to` (cloud-guard compliant). REUSES
// m3_build_copy_to_cmd from CORE/DECODER/m3_fire_dispatch.hexa (Blocker 6
// no-duplication).
pub fn dispatch_copy_sources(host: string, port: int) -> map {
    println("[copy-sources] target=" + host + ":" + to_string(port))
    let s187 = _s187_dir()
    let bdir = _build_dir()
    let rdir = _pod_remote_dir()
    let dry_run = exec("printenv P21H_DISPATCH_DRY 2>/dev/null").trim()
    let mut files = []
    files = push(files, #{
        "local": bdir + "/build_corpus_s101.py",
        "remote": rdir + "/state/corpus_s101_build_s102_2026_05_19/build_corpus_s101.py"
    })
    files = push(files, #{
        "local": s187 + "/build_multilingual_corpus_p21m.py",
        "remote": rdir + "/build_multilingual_corpus_p21m.py"
    })
    files = push(files, #{
        "local": s187 + "/train_p21h_v3.py",
        "remote": rdir + "/train_p21h_v3.py"
    })
    files = push(files, #{
        "local": s187 + "/conscious_decoder_v3.py",
        "remote": rdir + "/conscious_decoder_v3.py"
    })
    // ⚠ BLOCKER 1 FIX: source = launch_trainer.sh (NOT launch_trainer_p21.sh).
    // Remote name = launch_trainer_p21h.sh per pod convention.
    files = push(files, #{
        "local": s187 + "/launch_trainer.sh",
        "remote": rdir + "/launch_trainer_p21h.sh"
    })
    // mkdir first (cloud-guard exec — single command, caller-owned quoting)
    if dry_run != "1" {
        let mkdir_cmd = "hexa cloud exec " + host + " --port " + to_string(port) +
                        " --insecure -- mkdir -p " + rdir + "/state/corpus_s101_build_s102_2026_05_19 " +
                        rdir + "/out_main " + rdir + "/wiki_parts"
        exec(mkdir_cmd)
    }
    let mut i = 0
    let mut copied = 0
    while i < len(files) {
        let f = files[i]
        // Reuse m3_build_copy_to_cmd from m3_fire_dispatch.hexa (Blocker 6).
        let cmd = m3_build_copy_to_cmd(host, port, f["local"], f["remote"])
        println("[copy-sources] " + cmd)
        if dry_run != "1" {
            exec(cmd)
        }
        copied = copied + 1
        i = i + 1
    }
    // chmod the launcher executable
    if dry_run != "1" {
        let chmod_cmd = "hexa cloud exec " + host + " --port " + to_string(port) +
                        " --insecure -- chmod +x " + rdir + "/launch_trainer_p21h.sh"
        exec(chmod_cmd)
    }
    return #{ "copied": copied, "files": files, "dry_run": (dry_run == "1") }
}

// ════════════════════════════════════════════════════════════════════════
// Fire (nohup background) — Blocker 2 fix (hexa cloud nohup, not raw ssh)
// ════════════════════════════════════════════════════════════════════════

// Build the `hexa cloud nohup` argv for the trainer launch. The argv vector
// carries `env P21H_X=v ...` followed by `bash <launcher> <args>` so the
// remote shell parses one merged token list. Reuses m3_build_nohup_cmd
// from CORE/DECODER/m3_fire_dispatch.hexa (Blocker 6).
fn _build_fire_argv(axis: string, init: string, seed: string,
                    steps: int, bsz: int, block: int, warmup: int,
                    smoke: bool) -> list {
    let lr = _lr_for_init(init)
    let env_axis = _axis_env(axis)
    let rdir = _pod_remote_dir()
    // argv = ["env", "P21H_STEPS=N", ..., "bash", "launch_guard.sh",
    //        "train_p21h_v3.py", "--wiki-corpus", "$WIKI_POD", ...]
    let mut argv = []
    argv = push(argv, "env")
    argv = push(argv, "P21H_STEPS=" + to_string(steps))
    argv = push(argv, "P21H_BSZ=" + to_string(bsz))
    argv = push(argv, "P21H_BLOCK=" + to_string(block))
    argv = push(argv, "P21H_LR=" + lr)
    argv = push(argv, "P21H_WARMUP=" + to_string(warmup))
    argv = push(argv, "P21H_WIKI_FRAC=0.3")
    argv = push(argv, "P21H_CORPUS_MB=72")
    argv = push(argv, "P21H_NOISE_SIGMA=0.1")
    argv = push(argv, "P21H_LAMBDA_MITOSIS=0.05")
    argv = push(argv, "P21H_N_KV_HEAD=4")
    argv = push(argv, "P21H_MITOSIS_MAX=128")
    argv = push(argv, "P21H_CKPT_EVERY=500")
    // axis-specific env vars (each on its own argv token — anti-concat)
    argv = push(argv, "P21H_CURRICULUM_PHASE_STEPS=" + env_axis["P21H_CURRICULUM_PHASE_STEPS"])
    argv = push(argv, "P21H_HEAD_G_OBJECTIVE=" + env_axis["P21H_HEAD_G_OBJECTIVE"])
    argv = push(argv, "P21H_HEAD_G_ENABLE=" + env_axis["P21H_HEAD_G_ENABLE"])
    argv = push(argv, "P21H_HEAD_G_WEIGHT=" + env_axis["P21H_HEAD_G_WEIGHT"])
    argv = push(argv, "P21H_FREEZE_EMBED=" + env_axis["P21H_FREEZE_EMBED"])
    argv = push(argv, "PYTHONUNBUFFERED=1")
    argv = push(argv, "bash")
    argv = push(argv, rdir + "/launch_trainer_p21h.sh")
    argv = push(argv, rdir + "/train_p21h_v3.py")
    let _ = smoke   // smoke decided by caller's `steps`; same argv shape
    argv = push(argv, "--out-dir")
    argv = push(argv, rdir + "/out_main")
    argv = push(argv, "--base-model")
    argv = push(argv, "Qwen/Qwen2.5-1.5B")
    argv = push(argv, "--init-variant")
    argv = push(argv, init)
    argv = push(argv, "--steps")
    argv = push(argv, to_string(steps))
    argv = push(argv, "--bsz")
    argv = push(argv, to_string(bsz))
    argv = push(argv, "--block")
    argv = push(argv, to_string(block))
    argv = push(argv, "--lr")
    argv = push(argv, lr)
    argv = push(argv, "--warmup-steps")
    argv = push(argv, to_string(warmup))
    argv = push(argv, "--seed")
    argv = push(argv, seed)
    return argv
}

pub fn dispatch_fire_axis(host: string, port: int, axis: string,
                          init: string, seed: string,
                          steps: int, smoke: bool) -> map {
    if axis == "B" {
        println(_axis_b_warning())
    }
    let bsz = if smoke { 1 } else { 2 }
    let block = if smoke { 256 } else { 512 }
    let warmup = if smoke { 5 } else { 100 }
    let argv = _build_fire_argv(axis, init, seed, steps, bsz, block, warmup, smoke)
    let logfile = _pod_remote_dir() + "/train.log"
    // Reuse m3_build_nohup_cmd from m3_fire_dispatch.hexa (Blocker 6).
    let cmd = m3_build_nohup_cmd(host, port, logfile, argv)
    println("[fire] axis=" + axis + " host=" + host + ":" + to_string(port))
    println("[fire] " + cmd)
    let dry_run = exec("printenv P21H_DISPATCH_DRY 2>/dev/null").trim()
    if dry_run == "1" {
        return #{ "axis": axis, "pid": 0, "dry_run": true, "cmd": cmd }
    }
    let out = exec(cmd)
    // hexa cloud nohup prints the remote pid on its own line.
    return #{ "axis": axis, "pid_out": out, "dry_run": false, "cmd": cmd }
}

// ════════════════════════════════════════════════════════════════════════
// Early-life poll — 90 s window, abort+teardown if no [P21H][axis] stamp
// ════════════════════════════════════════════════════════════════════════

pub fn dispatch_monitor_early_life(host: string, port: int, axis: string) -> map {
    println("[early-life] host=" + host + ":" + to_string(port) + " axis=" + axis)
    let dry_run = exec("printenv P21H_DISPATCH_DRY 2>/dev/null").trim()
    if dry_run == "1" {
        return #{ "axis": axis, "early_life": true, "dry_run": true }
    }
    let logfile = _pod_remote_dir() + "/train.log"
    let mut tries = 0
    let max_tries = 18   // 18 × 5s = 90s window
    let mut stamp_found = false
    while tries < max_tries {
        // grep for axis stamp via cloud exec.
        let cmd = "hexa cloud exec " + host + " --port " + to_string(port) +
                  " --insecure -- grep -m1 -E " +
                  "'^\\[P21H\\]\\[axis\\]|^\\[launch\\] PYTORCH_CUDA_ALLOC_CONF=' " +
                  logfile
        let out = exec(cmd)
        if out.trim() != "" {
            println("[early-life] PASS: " + out.trim())
            stamp_found = true
            break
        }
        tries = tries + 1
    }
    return #{
        "axis": axis,
        "early_life": stamp_found,
        "tries": tries,
        "dry_run": false
    }
}

// ════════════════════════════════════════════════════════════════════════
// Harvest — a_fire_recover_complete (ckpt + result + log + anchors)
// ════════════════════════════════════════════════════════════════════════

pub fn dispatch_harvest(host: string, port: int,
                        axis: string, out_dir: string) -> map {
    println("[harvest] host=" + host + ":" + to_string(port) + " axis=" + axis + " out=" + out_dir)
    let dry_run = exec("printenv P21H_DISPATCH_DRY 2>/dev/null").trim()
    let rdir = _pod_remote_dir()
    let mut files = []
    files = push(files, #{
        "remote": rdir + "/out_main/result.json",
        "local": out_dir + "/result.json"
    })
    files = push(files, #{
        "remote": rdir + "/out_main/heldout_vp21h_v3.json",
        "local": out_dir + "/heldout_vp21h_v3.json"
    })
    files = push(files, #{
        "remote": rdir + "/out_main/vp21h_v3_eval1.json",
        "local": out_dir + "/vp21h_v3_eval1.json"
    })
    files = push(files, #{
        "remote": rdir + "/out_main/mix_info.json",
        "local": out_dir + "/mix_info.json"
    })
    files = push(files, #{
        "remote": rdir + "/train.log",
        "local": out_dir + "/train.log"
    })
    files = push(files, #{
        "remote": rdir + "/out_main/ckpt_final.pt",
        "local": out_dir + "/ckpt_final.pt"
    })
    if dry_run != "1" {
        let mkdir_cmd = "mkdir -p " + out_dir
        exec(mkdir_cmd)
    }
    let mut i = 0
    let mut harvested = 0
    while i < len(files) {
        let f = files[i]
        // Reuse m3_build_copy_from_cmd (Blocker 6).
        let cmd = m3_build_copy_from_cmd(host, port, f["remote"], f["local"])
        println("[harvest] " + cmd)
        if dry_run != "1" {
            exec(cmd)
        }
        harvested = harvested + 1
        i = i + 1
    }
    return #{
        "axis": axis, "out_dir": out_dir,
        "harvested": harvested, "files": files,
        "dry_run": (dry_run == "1")
    }
}

// ════════════════════════════════════════════════════════════════════════
// Teardown (a_fire_recover_complete — only AFTER harvest)
// ════════════════════════════════════════════════════════════════════════

pub fn dispatch_teardown(instance_id: string) -> bool {
    println("[teardown] instance=" + instance_id)
    let dry_run = exec("printenv P21H_DISPATCH_DRY 2>/dev/null").trim()
    if dry_run == "1" {
        println("[teardown] DRY-RUN")
        return true
    }
    let cmd = _build_vast_destroy_cmd(instance_id)
    println("[teardown] " + cmd)
    let _ = exec(cmd)
    return true
}

// ════════════════════════════════════════════════════════════════════════
// Orchestrator — dispatch_main (Blocker 3 fix: default axes = ["A","C","D"])
// ════════════════════════════════════════════════════════════════════════

// dispatch_main fans out the per-axis pipeline. Default `axes` is the
// 3-axis honest set per Blocker 3/4: axis B is deferred until a real
// vP21M teacher LoRA `adapter_model.safetensors` is on origin/main.
//
// Each axis runs the full lifecycle:
//   1. dispatch_provision_pod  (vastai create)
//   2. dispatch_wait_ssh_ready (3-consec READY)
//   3. dispatch_copy_sources   (hexa cloud copy-to — correct filename)
//   4. dispatch_fire_axis      (hexa cloud nohup — env + launcher + train)
//   5. dispatch_monitor_early_life (90s axis-stamp gate)
//   6. dispatch_harvest        (hexa cloud copy-from — BEFORE teardown)
//   7. dispatch_teardown       (vastai destroy)
//
// HONEST: this pub fn DEFAULTS to dry-run if P21H_DISPATCH_DRY=1 — caller
// must explicitly clear that env to actually fire.
pub fn dispatch_main(axes: list, init: string, seed: string,
                     steps: int, smoke: bool) -> map {
    println("════════════════════════════════════════════════════════════════")
    println("  DECODER M3 P21H V3 axis-fan dispatcher (real, not runbook)")
    println("  Axes: " + to_string(axes))
    println("  Init: " + init + "  Seed: " + seed + "  Steps: " + to_string(steps))
    println("  Smoke: " + to_string(smoke))
    println("════════════════════════════════════════════════════════════════")
    // M3 강등 carry-note (Blocker 5).
    println("")
    println("⚠ M3 강등 carry-note (2026-05-27): M4 MoE-fresh ⭐ 가 본선 (UNIVERSE")
    println("  H_490 DIFFERENTIATION). Phase 5b 이미 fired (2/5 PASS + 1 FAIL + 2")
    println("  RESIDUAL · instance 38090530 · $1.27). 본 M3 4-axis fire 는 historical")
    println("  baseline 측정자 의의로만. 본선 진척은 M4 lane.")
    println("")
    // Axis B opt-in warning if present (Blocker 3 + 4).
    let mut has_b = false
    let mut bi = 0
    while bi < len(axes) {
        if axes[bi] == "B" { has_b = true }
        bi = bi + 1
    }
    if has_b {
        println(_axis_b_warning())
        println("")
    }
    // Per-axis pipeline.
    let mut results = []
    let mut i = 0
    while i < len(axes) {
        let axis = axes[i]
        println("─── axis " + axis + " ─────────────────────────────────────")
        let prov = dispatch_provision_pod(axis, init, smoke)
        results = push(results, #{
            "axis": axis,
            "provision": prov,
            // The actual lifecycle (wait_ssh_ready → copy → fire → monitor →
            // harvest → teardown) requires the instance_id + host + port that
            // come from `vastai create` stdout parsing. dispatch_main here
            // returns the structured plan so the caller can drive the loop
            // (parallel fan-out compatible with a_wall_first).
            "lifecycle": "caller-driven (provision → wait_ssh_ready → copy → fire → monitor → harvest → teardown)"
        })
        i = i + 1
    }
    return #{
        "axes": axes, "init": init, "seed": seed, "steps": steps,
        "smoke": smoke, "n_axes": len(axes), "results": results,
        "blockers_fixed": [1, 2, 3, 4, 5, 6],
        "axis_b_default_excluded": true,
        "m3_demoted_note": "M4 MoE-fresh ⭐ 본선 since 2026-05-27"
    }
}

// ════════════════════════════════════════════════════════════════════════
// Summary (for `hexa run` smoke)
// ════════════════════════════════════════════════════════════════════════

pub fn dispatch_summary() -> string {
    return "DECODER M3 P21H V3 dispatcher: vastai (lifecycle) + hexa cloud (transport) — " +
           "cloud-guard g8 compliant · reuses m3_fire_dispatch.hexa · 6 blockers fixed"
}

fn main() {
    println(dispatch_summary())
    println("")
    println("default axes: [A, C, D] (axis B deferred — see AXIS_B_DEFERRED.md)")
    println("")
    // Smoke run: dry-run the orchestrator (no exec of vastai/hexa-cloud).
    // Caller can set P21H_DISPATCH_DRY=1 manually for safety; here we
    // explicitly print the plan without firing.
    let axes = ["A", "C", "D"]
    let plan = dispatch_main(axes, "qwen", "1337", 500, true)
    println("")
    println("plan summary: n_axes=" + to_string(plan["n_axes"]) +
            " blockers_fixed=" + to_string(plan["blockers_fixed"]) +
            " m3_demoted_note=" + plan["m3_demoted_note"])
}
