fn _print_step4_argv_guard() {
    println("─── Step 4: install argv-echo guard wrapper (orphan prevention) ───")
    println("  # The c25njysjdga2vb $3.92 orphan was caused by an upstream dispatcher")
    println("  # passing only `(qwen 1337)` argv to launch_trainer.sh — script_path arg")
    println("  # was missing and python3 exec ENOENT'd in <15s. The argv-echo wrapper")
    println("  # MUST print the received argv FIRST so a stale wrapper is visible.")
    println("  $ $SSH root@$SSH_HOST 'cat > /workspace/p21hr/launch_guard.sh <<EOFGUARD")
    println("  #!/bin/bash")
    println("  echo \"[guard] received argv: \\$0 \\$*\"")
    println("  echo \"[guard] script_path (\\$1) = \\$1\"")
    println("  echo \"[guard] cwd = \\$(pwd)\"")
    println("  echo \"[guard] P21H_* env-snapshot:\"")
    println("  env | grep \"^P21H_\" | sort | sed \"s/^/[guard]   /\"")
    println("  exec bash /workspace/p21hr/launch_trainer_p21h.sh \"\\$@\"")
    println("  EOFGUARD")
    println("  chmod +x /workspace/p21hr/launch_guard.sh'")
    println("")
}

