fn _print_pre_fire_checklist() {
    println("═══ PRE-FIRE 7-ITEM CHECKLIST (M4b proven · do NOT skip) ═══════")
    println("  [ ] 1. vastai CLI present + auth OK (vastai show user)")
    println("  [ ] 2. ~/.vast/ssh/vast-key exists + matches Vast account")
    println("  [ ] 3. H100 SXM offers ≥1 available (search offers cascade)")
    println("  [ ] 4. SAVE_POD=1 set if first fire (crash trap)")
    println("  [ ] 5. argv-echo guard installed BEFORE train command")
    println("  [ ] 6. dancinlab HF org (a_hf_autonomous) login OK (hf whoami)")
    println("  [ ] 7. state/p21h_v3_vast_2026_05_28/ dir created for harvest")
    println("  # If any item ✗: do NOT fire; resolve first")
    println("")
}

fn main() {
    let argv = exec("hexa run tool/dispatch_p21h_v3_vast.hexa $(printenv DISPATCH_ARGS 2>/dev/null)")
    // hexa run doesn't always pass argv reliably; we re-read from $@ via env
    let raw = exec("printenv DISPATCH_ARGS 2>/dev/null").trim()

    let mut smoke = false
    let mut axis = "ALL"
    let mut init = "qwen"
    let mut seed = "1337"

    // Argv shape: [smoke] [AXIS] [INIT] [SEED]
    // We accept positional via DISPATCH_ARGS env (since `hexa run` argv plumbing is uneven).
    // For runbook use, the user passes args via env: DISPATCH_ARGS="A qwen 1337"
    if raw != "" {
        let parts = raw.split(" ")
        let mut k = 0
        while k < len(parts) {
            let p = parts[k]
            if p == "smoke" { smoke = true }
            else if p == "A" || p == "B" || p == "C" || p == "D" || p == "ALL" { axis = p }
            else if p == "random" || p == "qwen" || p == "vp21m" { init = p }
            else if p != "" { seed = p }
            k = k + 1
        }
    }

    println("════════════════════════════════════════════════════════════════")
    println("  DECODER M3 4-axis P21H V3 fire — Vast.ai direct-IP dispatch SOP")
    if smoke {
        println("  Mode: SMOKE (50-step pipeline gate · 1 pod · ~$1-2)")
    } else {
        println("  Mode: FULL FIRE (5K step verdict run · 1-4 pod · per-pod $13-21)")
    }
    println("  Axis: " + axis + "  Init: " + init + "  Seed: " + seed)
    println("════════════════════════════════════════════════════════════════")
    println("")

    let steps  = if smoke { 50 }   else { 5000 }
    let bsz    = if smoke { 1 }    else { 2 }
    let block  = if smoke { 256 }  else { 512 }
    let warmup = if smoke { 5 }    else { 100 }

    let n_pods = if axis == "ALL" { 4 } else { 1 }
    _print_cost_estimate(smoke, n_pods)
    _print_pre_fire_checklist()
    _print_step0_account()

    // Per-axis SOP rendering. When axis=="ALL", render 4 sections.
    let axes_to_render = if axis == "ALL" { ["A", "B", "C", "D"] } else { [axis] }
    let mut ai = 0
    while ai < len(axes_to_render) {
        let ax = axes_to_render[ai]
        println("════════════════════════════════════════════════════════════════")
        println("  AXIS-" + ax + " SOP — " + _axis_desc(ax))
        println("════════════════════════════════════════════════════════════════")
        let env_lines = _axis_env_lines(ax, steps)
        _print_step1_rent(ax, init, smoke)
        _print_step2_ssh_ready()
        _print_step3_upload()
        _print_step4_argv_guard()
        _print_step5_corpus(smoke)
        _print_step6_fire(ax, init, seed, steps, bsz, block, warmup, env_lines)
        _print_step7_early_life()
        _print_step8_monitor_harvest()
        _print_step9_hf_teardown(ax, smoke)
        ai = ai + 1
    }

    _print_parallel_orchestration(smoke)

    println("════════════════════════════════════════════════════════════════")
    println("  END OF RUNBOOK — execute the steps above to fire the dispatch.")
    println("════════════════════════════════════════════════════════════════")
}
