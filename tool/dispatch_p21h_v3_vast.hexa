    println("  $ secret check vast.api_key      # token sanity")
    println("  $ vastai show user 2>&1 | head -3 # account balance")
    println("  $ vastai search offers 'gpu_name=H100_SXM num_gpus=1 reliability>0.98 \\")
    println("        dph_total<3.5 disk_space>50 inet_down>500 rentable=true' \\")
    println("        -o dph_total --raw | python3 -c 'import json,sys;d=json.load(sys.stdin); \\")
    println("        print(len(d), \"offers\");[print(o[\"id\"],o[\"gpu_name\"],o[\"dph_total\"]) for o in d[:5]]'")
    println("  # fallback cascade: H100_SXM > H100_NVL > H100_PCIE")
    println("")
}

fn _print_step1_rent(axis: str, init: str, smoke: bool) {
    let label_suffix = if smoke { "smoke-" } else { "" }
    println("─── Step 1: rent instance ───")
    println("  $ OFFER=$(vastai search offers 'gpu_name=H100_SXM num_gpus=1 reliability>0.98 \\")
    println("      dph_total<3.5 disk_space>50 inet_down>500 rentable=true' -o dph_total --raw \\")
    println("      | python3 -c 'import json,sys;d=json.load(sys.stdin);print(d[0][\"id\"])')")
    println("  $ vastai create instance $OFFER \\")
    println("      --image pytorch/pytorch:2.4.0-cuda12.4-cudnn9-devel \\")
    println("      --disk 80 --ssh --direct \\")
    println("      --label p21h-v3-" + label_suffix + axis + "-" + init + " --raw")
    println("  # capture INSTANCE_ID")
    println("")
}

fn _print_step2_ssh_ready() {
    println("─── Step 2: wait for SSH (3-consec READY guard for proxy flakiness) ───")
    println("  # poll until vastai show instance $INSTANCE_ID --raw reports actual_status=running")
    println("  # then probe `ssh -p $PORT root@$HOST 'echo READY'` THREE consecutive times")
    println("  # (memory: cuBLAS glue + Vast boot-flakiness — sshd accepts but scp 255 ~1min)")
    println("  $ vastai show instance $INSTANCE_ID --raw | python3 -c 'import json,sys; \\")
    println("        d=json.load(sys.stdin); print(d.get(\"ssh_host\",\"\"), d.get(\"ssh_port\",\"\"))'")
    println("  $ export SSH_HOST=<host> SSH_PORT=<port>")
    println("  $ for i in 1 2 3; do \\")
    println("        ssh -i ~/.vast/ssh/vast-key -o StrictHostKeyChecking=no -p $SSH_PORT \\")
    println("            root@$SSH_HOST 'echo READY' || break; sleep 5; done")
    println("")
}

