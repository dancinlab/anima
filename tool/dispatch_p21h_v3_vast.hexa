fn _print_step6_fire(axis: str, init: str, seed: str, steps: int, bsz: int, block: int, warmup: int, env_lines: list) {
    let lr = _lr_for_init(init)
    println("─── Step 6: FIRE (nohup background · argv echo guard) ───")
    println("  # axis-active = " + _axis_desc(axis))
    println("  # Anti-concat guard: each P21H_* on ITS OWN env line below.")
    println("  $ $SSH root@$SSH_HOST \"nohup env \\")
    println("    P21H_STEPS=" + str(steps) + " \\")
    println("    P21H_BSZ=" + str(bsz) + " \\")
    println("    P21H_BLOCK=" + str(block) + " \\")
    println("    P21H_LR=" + lr + " \\")
    println("    P21H_WARMUP=" + str(warmup) + " \\")
    println("    P21H_WIKI_FRAC=0.3 \\")
    println("    P21H_CORPUS_MB=72 \\")
    println("    P21H_NOISE_SIGMA=0.1 \\")
    println("    P21H_LAMBDA_MITOSIS=0.05 \\")
    println("    P21H_N_KV_HEAD=4 \\")
    println("    P21H_MITOSIS_MAX=128 \\")
    println("    P21H_CKPT_EVERY=500 \\")
    let mut k = 0
    while k < len(env_lines) {
        println(env_lines[k] + " \\")
        k = k + 1
    }
    println("    PYTHONUNBUFFERED=1 \\")
    println("    bash /workspace/p21hr/launch_guard.sh /workspace/p21hr/train_p21h_v3.py \\")
    println("        --wiki-corpus \\$WIKI_POD --anima-corpus \\$ANIMA_POD \\")
    println("        --mixed-corpus /workspace/p21hr/mixed_corpus_v3.jsonl \\")
    println("        --out-dir /workspace/p21hr/out_main \\")
    println("        --base-model Qwen/Qwen2.5-1.5B \\")
    println("        --init-variant " + init + " \\")
    println("        --steps " + str(steps) + " --bsz " + str(bsz) + " --block " + str(block) + " --lr " + lr + " \\")
    println("        --warmup-steps " + str(warmup) + " --seed " + seed + " \\")
    println("        > /workspace/p21hr/train.log 2>&1 & echo TRAIN_PID \\$!\"")
    println("")
}

fn _print_step7_early_life() {
    println("─── Step 7: early-life poll (90s window for [P21H][axis] log) ───")
    println("  # Lesson c25njysjdga2vb: 158 min idle / \\$3.92 orphan from class-1")
    println("  # silent failure. Abort+teardown if [P21H][axis] missing in 90s.")
    println("  $ for poll in $(seq 1 18); do \\")
    println("        STAMP=$($SSH root@$SSH_HOST 'grep -m1 -E \"^\\\\[P21H\\\\]\\\\[axis\\\\]|^\\\\[launch\\\\] PYTORCH_CUDA_ALLOC_CONF=\" \\")
    println("              /workspace/p21hr/train.log 2>/dev/null'); \\")
    println("        [ -n \"$STAMP\" ] && echo \"early-life PASS: $STAMP\" && break; \\")
    println("        [ $((poll % 3)) -eq 0 ] && echo \"  poll $poll/18 — no stamp\"; \\")
    println("        sleep 5; \\")
    println("    done")
    println("  # axis verify (silent-bypass detection):")
    println("  $ $SSH root@$SSH_HOST 'grep -m1 \"^\\\\[P21H\\\\]\\\\[axis\\\\]\" /workspace/p21hr/train.log'")
    println("  # → must contain the axis-specific token (curriculum_phase_steps=N · head_g_enable=1 · freeze_embed=1)")
    println("  # if missing: abort, vastai destroy instance $INSTANCE_ID")
    println("")
}

fn _print_step8_monitor_harvest() {
    println("─── Step 8: monitor + harvest (DETACH mode = exit-after-early-life) ───")
    println("  # Default DETACH=1: caller polls externally to keep agent-context safe")
    println("  # (avoids agent-timeout orphan; SAVE_POD=1 forced in detach mode).")
    println("  $ # live tail (any time):")
    println("  $ $SSH root@$SSH_HOST 'tail -f /workspace/p21hr/train.log'")
    println("  $ # alive probe (alive vs done):")
    println("  $ $SSH root@$SSH_HOST 'pgrep -af train_p21h_v3.py' || echo TRAIN_DONE")
    println("  $ # result probe:")
    println("  $ $SSH root@$SSH_HOST 'test -s /workspace/p21hr/out_main/result.json && echo READY'")
    println("")
    println("  ─── Harvest (a_fire_recover_complete — full ckpt+result+log+anchors BEFORE teardown) ───")
    println("  $ mkdir -p state/p21h_v3_vast_2026_05_28/v$AXIS")
    println("  $ VDIR=state/p21h_v3_vast_2026_05_28/v$AXIS")
    println("  $ $SCP root@$SSH_HOST:/workspace/p21hr/out_main/result.json           $VDIR/")
    println("  $ $SCP root@$SSH_HOST:/workspace/p21hr/out_main/heldout_vp21h_v3.json $VDIR/")
    println("  $ $SCP root@$SSH_HOST:/workspace/p21hr/out_main/vp21h_v3_eval1.json   $VDIR/")
    println("  $ $SCP root@$SSH_HOST:/workspace/p21hr/out_main/mix_info.json         $VDIR/")
    println("  $ $SCP root@$SSH_HOST:/workspace/p21hr/train.log                      $VDIR/")
    println("  $ $SCP root@$SSH_HOST:/workspace/p21hr/out_main/ckpt_final.pt         $VDIR/   # critical")
    println("  $ $SCP -r root@$SSH_HOST:/workspace/p21hr/out_main/kosmos_anchors    $VDIR/")
    println("")
}

fn _print_step9_hf_teardown(axis: str, smoke: bool) {
    println("─── Step 9: HF upload + teardown ───")
    if smoke {
        println("  # SMOKE: no HF upload (smoke pilot, not verdict ckpt)")
        println("  $ vastai destroy instance $INSTANCE_ID")
    } else {
        println("  # verdict tier:")
        println("  $ python3 -c \"import json; d=json.load(open('$VDIR/result.json')); \\")
        println("        print('VERDICT=', d.get('verdict')); \\")
        println("        print('n_strong=', d.get('n_strong'), '/5');\"")
        println("  # HF upload (a_hf_autonomous · a_hf_complete):")
        println("  #   PASS/PARTIAL → PUBLIC · FAIL → PRIVATE")
        println("  $ hf upload dancinlab/anima-p21h-v3-" + axis + "-2026-05-28 \\")
        println("        $VDIR/ckpt_final.pt --create --visibility public  # or private if FAIL")
        println("  $ # write model card + manifest sha256 (per a_hf_complete totality)")
        println("  # teardown:")
        println("  $ vastai destroy instance $INSTANCE_ID")
        println("  $ vastai show instances | grep $INSTANCE_ID || echo TEARDOWN_OK")
    }
    println("")
}

