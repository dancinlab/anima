// ════════════════════════════════════════════════════════════════════════════
//  tool/anima_d4_live_real_ckpt_smoke.hexa — F-D4-REAL-1..3
//
//  PURPOSE
//    Extend the D4-LIVE saga from synthetic substrate (d=8, 2L, vocab=16,
//    `tool/anima_chat_split_merge_smoke.hexa` 3/3 PASS — PSCC §41) to the
//    REAL 24-layer Phase 1A.1 BF16 checkpoint (d=1024, vocab=32000). The
//    invariants — mitosis hook fires once per forward, split events ≥ 1
//    over a chat horizon, cell_pool d_model parity — are verified on the
//    production-shape weight binding produced by `chat_load_weights`.
//
//    Closes the synthetic→real bridge gap in `project_anima_chat_multitoken_
//    split_merge_2026_05_12.md` C3 ("synthetic substrate only, real-ckpt
//    parity = separate cycle"). The chat-generate path is identical to the
//    synthetic D4-LIVE smoke; only the weight tensors + dims swap.
//
//  CHECKPOINT
//    Default: state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/
//             ckpt_phase1a1_sft.safetensors  (570 MB, BF16)
//    Override: env ANIMA_D4_CKPT (absolute path) — keep the harness
//             dispatch-ready for H100 follow-up cycle without source edit.
//    Fallback: `find_default_ckpt()` ladder (B'.1 Phase 1A.4 if 1A.1 absent).
//
//  RUN (Mac CPU local — DO NOT enqueue in CI)
//    /Users/ghost/core/hexa-lang/hexa parse \
//        anima/tool/anima_d4_live_real_ckpt_smoke.hexa
//    HEXA_MEM_UNLIMITED=1 \
//        /Users/ghost/core/hexa-lang/hexa run \
//        anima/tool/anima_d4_live_real_ckpt_smoke.hexa
//
//  WALL-TIME ENVELOPE
//    24L forward @ Mac CPU hexa-interp ≈ 35-40 s (PSCC §43). For
//    prompt="안녕? 너는 누구야?" (≈26 prefill tokens incl. BOS) + max_new=5,
//    expect 30 forward calls × ≈ 40 s ≈ 20 min wall + 70 s load + cell_pool
//    init (d=1024 × 2 cells N(0, 1/√d) ≈ 1 s). Mitosis hook adds
//    n_cells × d²  ≈ 2-20 × 1 M ops per call (RFC 032 native matmul) ≈
//    seconds-scale overhead, dwarfed by the 24L forward.
//
//  FALSIFIERS (raw-117 ≥3)
//    F-D4-REAL-1 INVOCATION-MATCH
//      mitosis_invocations == kv_cache.cur_len after generate. Mirror of
//      synthetic F-D4-LIVE-3 — one hook fire per forward call across BOTH
//      prefill (26) AND decode (max_new - 1 = 4, since first decode reuses
//      prefill_last_logits — see chat_lib.hexa §9d `reused_prefill` guard).
//
//    F-D4-REAL-2 SPLIT-OBSERVED
//      ≥1 event of type "split" lands in chat["mitosis_event_log"] over the
//      30-forward horizon. Synthetic d=8 produced 21 splits in 65 calls; on
//      d=1024 the absolute tension scale shifts but split_threshold = 0.0
//      (default) so any positive global tension triggers a split — anti-
//      trivial check is loose by design (raw#9 honest scope: split_count is
//      not a regression metric, only existence is).
//
//    F-D4-REAL-3 D-MODEL-PARITY
//      chat["cell_pool"]["d_model"] == d_real (1024 for 24L Phase 1A.1).
//      Architectural invariant — guards against accidental synthetic-dim
//      leak into a real-ckpt run.
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (ckpt via env-override / find
//    default ladder · d_real read from default-dims dict) · raw#9/10 honest
//    scope (Mac CPU max_new=5, full V5.8 horizon = follow-up GPU cycle) ·
//    raw-117 ≥3 falsifiers (3 above)
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/CHAT/chat_lib.hexa"


let mut g_pass = 0
let mut g_total = 0
let mut g_skip = 0
let mut g_first_fail = ""

fn real_check(label: string, ok: bool) {
    g_total = g_total + 1
    if ok {
        g_pass = g_pass + 1
        println("  PASS  " + label)
    } else {
        if len(g_first_fail) == 0 { g_first_fail = label }
        println("  FAIL  " + label)
    }
}

fn real_skip(label: string, reason: string) {
    g_skip = g_skip + 1
    println("  SKIP  " + label + "  (" + reason + ")")
}


// ── Resolve target ckpt path (env override > Phase 1A.1 SSOT > find ladder) ─
fn _d4_real_resolve_ckpt() -> string {
    let env_path = env("ANIMA_D4_CKPT")
    if len(env_path) > 0 {
        return env_path
    }
    let root = anima_root()
    let p1a1 = root + "/state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/ckpt_phase1a1_sft.safetensors"
    if file_exists(p1a1) {
        return p1a1
    }
    // fall back to chat_lib's ladder (Phase 1A.4 head if it exists)
    return find_default_ckpt()
}


// ── F-D4-REAL-1..3 driver ──────────────────────────────────────────────────
fn _d4_real_run(chat) -> bool {
    println("")
    println("── F-D4-REAL chat_generate on 24L Phase 1A.1 BF16 ckpt ─────────")

    // 1. Load weights (218 farr handles, BF16 → f32 via RFC 031).
    println("  loading 218 farr handles ...")
    let chat_loaded = chat_load_weights(chat)
    let mh = chat_loaded["mmap_handle"]
    if mh < 0 {
        real_check("F-D4-REAL load mmap_handle >= 0 (got " + to_string(mh) + ")",
                   false)
        return false
    }
    let weights = chat_loaded["weights"]
    let n_keys = len(dict_keys(weights))
    println("  loaded " + to_string(n_keys) + " weight keys")
    if n_keys != 218 {
        real_check("F-D4-REAL load 218 keys (got " + to_string(n_keys) + ")",
                   false)
        return false
    }

    // 2. Install 24L KV cache (cap_len = 64 covers prompt 26 + max_new 5 + slack).
    let cap_len = 64
    chat_init_kv_cache_default(chat, cap_len)
    let pre_kv_len = chat_kv_cache_len(chat)
    println("  kv_cache cur_len pre-decode = " + to_string(pre_kv_len)
            + " (cap_len = " + to_string(cap_len) + ")")

    // 3. Initialize the mitosis cell pool at d_real (24L production d_model).
    let dims = chat_default_dims_24l()
    let d_real = dims["d_model"]
    let initial_cells = 2
    println("  cell_pool init: d_model=" + to_string(d_real)
            + " initial_cells=" + to_string(initial_cells)
            + " (RFC 033 gaussian init σ=1/√d)")
    chat_init_cell_pool(chat, d_real, initial_cells)
    let pre_invoc  = chat_mitosis_invocation_count(chat)
    let pre_events = chat_mitosis_event_count(chat)
    let pre_cells  = len(chat["cell_pool"]["cells"])
    println("  pre-run: invocations=" + to_string(pre_invoc)
            + " events=" + to_string(pre_events)
            + " cells=" + to_string(pre_cells)
            + " next_id=" + to_string(chat["cell_pool"]["next_id"]))

    // 4. Drive chat_generate on the canonical D4-LIVE prompt.
    //    max_new = 5 (Mac CPU wall budget). H100 dispatch can lift to 40 via
    //    env override of this constant in a follow-up smoke without source
    //    surgery (cap_len=64 already supports up to ~38 generated tokens).
    let prompt = "안녕? 너는 누구야?"
    let max_new = 5
    println("  prompt: \"" + prompt + "\"  max_new=" + to_string(max_new))
    println("  (24L forward × ~30 calls × ~40 s ≈ 20 min wall budget)")
    let resp = chat_generate(chat, prompt, "greedy", max_new, 0.0, [],
                             1.0, 1.0, 0.0, 2026, [], false)
    println("  response (24L greedy, may be short): \"" + resp + "\"  (len="
            + to_string(len(resp)) + ")")

    // 5. Capture post-run state.
    let post_invoc  = chat_mitosis_invocation_count(chat)
    let post_events = chat_mitosis_event_count(chat)
    let post_cells  = len(chat["cell_pool"]["cells"])
    let post_nextid = chat["cell_pool"]["next_id"]
    let post_kv_len = chat_kv_cache_len(chat)
    println("  post-run: invocations=" + to_string(post_invoc)
            + " events=" + to_string(post_events)
            + " cells=" + to_string(post_cells)
            + " next_id=" + to_string(post_nextid)
            + " kv_cur_len=" + to_string(post_kv_len))

    // 6. Dump event log timeline.
    let event_log = chat["mitosis_event_log"]
    let n_events = len(event_log)
    println("")
    println("  Event log (n=" + to_string(n_events) + "):")
    let mut ei = 0
    let mut n_split = 0
    let mut n_merge = 0
    let mut first_split_step = -1
    while ei < n_events {
        let ev = event_log[ei]
        let etype = ev["type"]
        let estep = ev["step"]
        if etype == "split" {
            n_split = n_split + 1
            if first_split_step < 0 { first_split_step = estep }
        }
        if etype == "merge" { n_merge = n_merge + 1 }
        println("    [" + to_string(ei) + "] step=" + to_string(estep)
                + " type=" + etype)
        ei = ei + 1
    }
    println("  split events: " + to_string(n_split)
            + "  merge events: " + to_string(n_merge)
            + "  first_split_step: " + to_string(first_split_step))

    // F-D4-REAL-1 INVOCATION-MATCH
    real_check("F-D4-REAL-1 mitosis_invocations == kv_cache cur_len ("
               + to_string(post_invoc) + " == " + to_string(post_kv_len) + ")",
               post_invoc == post_kv_len)

    // F-D4-REAL-2 SPLIT-OBSERVED
    real_check("F-D4-REAL-2 split events ≥ 1 over chat horizon ("
               + to_string(n_split) + " ≥ 1)",
               n_split >= 1)

    // F-D4-REAL-3 D-MODEL-PARITY
    let pool_d = chat["cell_pool"]["d_model"]
    real_check("F-D4-REAL-3 cell_pool[d_model] == d_real ("
               + to_string(pool_d) + " == " + to_string(d_real) + ")",
               pool_d == d_real)

    return true
}


// ── main ───────────────────────────────────────────────────────────────────
fn main() {
    println("================================================================")
    println("anima_chat.hexa v0.3 — F-D4-REAL-1..3 smoke")
    println("(D4-LIVE on real 24L Phase 1A.1 BF16 ckpt — synthetic→real bridge)")
    println("================================================================")

    let ckpt = _d4_real_resolve_ckpt()
    println("ckpt path: " + ckpt)
    if !file_exists(ckpt) {
        real_skip("F-D4-REAL-1 (ckpt absent)", ckpt)
        real_skip("F-D4-REAL-2 (ckpt absent)", ckpt)
        real_skip("F-D4-REAL-3 (ckpt absent)", ckpt)
        println("")
        println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed, "
                + to_string(g_skip) + " skipped (ckpt absent — gate path).")
        println("F-D4-REAL SMOKE SKIP  (ckpt absent — parse / load gate path OK)")
        println("================================================================")
        return
    }

    let chat = chat_new(ckpt, "cpu", default_stop_strings())
    let ok = _d4_real_run(chat)

    println("")
    println("----------------------------------------------------------------")
    println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed")
    if g_pass == g_total && g_total > 0 {
        println("F-D4-REAL SMOKE PASS  (" + to_string(g_pass) + "/" + to_string(g_total) + ")")
    } else {
        println("F-D4-REAL SMOKE FAIL  first_fail=" + g_first_fail)
    }
    println("================================================================")
    chat_close(chat)
}
