// ════════════════════════════════════════════════════════════════════════════
// tool/zeta_likert_p4_r8_run.hexa — #78 제타가능 Likert measurement runner
//
// PURPOSE
//   Roadmap #78 "[CP2 clause 1/3] 제타가능" measurement.
//   Runs bench/zeta_likert.hexa Layer-B deterministic scorer over
//   v1_frozen.json (20 prompts × 5 categories) and produces:
//     state/zeta_likert_p4_r8_responses_2026_04_29.jsonl   (raw responses)
//     state/zeta_likert_p4_r8_likert_scores_2026_04_29.json (Likert by dim/cat)
//     state/zeta_likert_p4_r8_verdict_2026_04_29.json       (PASS/FAIL)
//
// HONEST C3 (raw#10 §8 disclosure embedded in verdict.json)
//   • Real Mistral-7B-v0.3 + p4_r8 LoRA inference NOT executed in this cycle.
//   • Mistral-7B-v0.3 base weights NOT cached locally — only refs/main exists,
//     no blobs/snapshots/ (would require 14GB download + transformers/peft/torch
//     install, ~3GB additional, ~30-60 min wall on Mac MPS).
//   • RunPod pods all EXITED (verified 2026-04-29) — would require new pod
//     launch (~$0.50-2.00 cost, 15-30 min wall).
//   • This run uses bench/zeta_likert.hexa stub_anima_response() and
//     stub_zeta_response() — deterministic per-category strings that
//     represent the *intended response shape* of LoRA-trained anima vs zeta.
//   • The deterministic 5-feature rubric (length_fit, tone_match, lexical_div,
//     ko_coverage, eos_wellform) is what would score real LLM responses too.
//   • Per task #14 audit (commit 143414f08): #78 raw 22.5% / LIVE 2.5% verdict
//     pre-this-cycle. This run lifts framework_executed = TRUE +
//     stub_baseline_measured but does NOT change LIVE verdict (real LoRA path
//     still pending GPU dispatch).
//
// USAGE
//   hexa run tool/zeta_likert_p4_r8_run.hexa
//
// RULES
//   raw#1 chflags uchg post-write · raw#9 hexa-only (this is hexa, no .py)
//   raw#10 honest C3 (5+ axis) · raw#15 no-hardcode (frozen.json source)
//   raw#42 host-delegation (no remote calls in this entry)
//   raw#65 idempotent · raw#71 falsifier preregister
//   raw#77 audit-ledger schema · raw#86 cost-attribution ($0)
//   raw#91 honest C3 5-axis · own#5 completeness-first (all 20 prompts)
// ════════════════════════════════════════════════════════════════════════════

let SCHEMA_RESP    = "anima/zeta_likert_p4_r8_responses/1"
let SCHEMA_SCORES  = "anima/zeta_likert_p4_r8_likert_scores/1"
let SCHEMA_VERDICT = "anima/zeta_likert_p4_r8_verdict/1"

let FROZEN_PATH    = "bench/zeta_likert/v1_frozen.json"
let OUT_RESP       = "state/zeta_likert_p4_r8_responses_2026_04_29.jsonl"
let OUT_SCORES     = "state/zeta_likert_p4_r8_likert_scores_2026_04_29.json"
let OUT_VERDICT    = "state/zeta_likert_p4_r8_verdict_2026_04_29.json"

let RUN_TS         = "2026-04-29T00:00:00Z"
let TARGET_THRESHOLD_LIKERT = 3.0
let TARGET_LATENCY_S        = 1.0

// ─── helpers ─────────────────────────────────────────────────────────────

fn _str(x) {
    let t = type_of(x)
    if t == "str" || t == "string" { return x }
    return ""
}

fn fexists(p) {
    return _str(exec("test -f " + p + " && echo 1 || echo 0")).trim() == "1"
}

fn now_utc() {
    return _str(exec("date -u +%FT%TZ")).trim()
}

fn fabs(x) {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn clamp01(x) {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn json_escape(s) {
    let a = s.replace("\\", "\\\\")
    let b = a.replace("\"", "\\\"")
    let c = b.replace("\n", "\\n")
    let d = c.replace("\r", "\\r")
    let e = d.replace("\t", "\\t")
    return e
}

fn atomic_write(path, body) {
    let pid = _str(exec("printf %s $$")).trim()
    let tmp = path + ".tmp." + pid
    write_file(tmp, body)
    exec("mv -f " + tmp + " " + path)
}

// ─── prompt set (mirrored from bench/zeta_likert.hexa::load_prompts) ─────
//
// raw#15: source-of-truth is bench/zeta_likert.hexa. v1_frozen.json sha256
// is in state/zeta_likert_v1_sha256.json. We mirror here (deterministic)
// for self-containment; main() asserts file_exists(FROZEN_PATH).

struct Prompt {
    id: int,
    category: string,
    ko_prompt: string,
    expected_tone: string
}

fn mk(id, cat, ko, tone) {
    return Prompt { id: id, category: cat, ko_prompt: ko, expected_tone: tone }
}

