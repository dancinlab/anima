        "(^|/)(tests?|__tests__|spec)/",
        "\\.(test|spec)\\.[a-z]+$",
        "(^|/)\\.harness(-engine)?/"
      ]
    },
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "guides": [
    "CLAUDE.md",
    "AGENTS.md",
    "README.md"
  ],
  "docs": {
    "architecture": "ARCHITECTURE.md",
    "log": "CHANGELOG.md",
    "scratchDir": "scripts/scratch",
    "scopeDirs": [""],
    "allow": ["README.md", "README.ko.md", "README.ja.md", "README.zh.md", "README.ru.md", "README.basic.md", "README.easy.md", "README.easy.ko.md", "README.easy.ja.md", "README.easy.zh.md", "README.easy.ru.md", "CHANGELOG.md", "ARCHITECTURE.md", "CLAUDE.md", "AGENTS.md", "LICENSE", "CONTRIBUTING.md", "SECURITY.md", "TAPE-AUDIT.md"]
