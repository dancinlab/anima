{
  "project": "anima",
  "profile": "hardcore",
  "stack": [
    "hexa"
  ],
  "lockdown": {
    "files": [
      "CORE/pure_field.hexa",
      "CORE/engine_g.hexa",
      "CORE/brain.hexa",
      "CORE/generator.hexa",
      "CORE/clm_decode.hexa",
      "engines/engine_iface.hexa"
    ],
    "fromMarkdown": "CLAUDE.md",
    "onEditReminder": "CORE A⇄G 엔진/계약 편집 — a_core_engine_map 준수 + CHANGELOG + CLAIMS/verdict 동시 갱신."
  },
  "enforcementFile": ".harness/enforcement.json",
  "keywordsFile": ".harness/keywords.json",
  "severityMapFile": ".harness/severity-map.json",
  "verify": {
    "checks": [
      {
        "id": "verify",
