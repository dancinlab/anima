// ════════════════════════════════════════════════════════════════════════════
//  anima-clm-eeg/tool/mk_xii_eeg_corroboration.hexa
//
//  GENUS  (raw#106)
//    mk-xii-eeg-corroboration
//
//  PURPOSE  (T17 — own 2 (b) PC empirical-maximum, EEG corroboration sub-axis)
//    Pure post-hoc aggregator: reads paired (mk_xii_msg ↔ eeg_segment) JSONL
//    emitted by /tmp/mk_xii_eeg_helper.py and produces an own 2 (b)
//    5-criteria verdict (CORROBORATION_OK / CORROBORATION_FAIL).
//
//    Per-pair encodes 5 fields per criterion vector:
//      C1 cohort_n          — n_subjects so far (across rows; max)
//      C2 effect_x1000      — Cohen's d × 1000 (cross-subject reliability)
//      C3 self_eeg_r_x1000  — Pearson r × 1000 (Likert ↔ EEG)
//      C4 advers_misc_x1000 — adversarial misclassification % × 1000
//      C5 clm_alpha_plv_x1k — CLM-EEG α-PLV × 1000 (cross-modal identity)
//
//    Aggregation rule (raw#71 falsifier-aligned, raw#91 supermajority):
//      pair_ok iff  axes_pass >= 3 of 5     (per-pair skeleton validation)
//    Session verdict:
//      CORROBORATION_OK iff  pair_ok_rate_x1000 >= 600 AND falsifiers_pass == 5
//
//  CONSTRAINT
//    raw#9   hexa-only       — no python, no LLM call, pure aggregator
//    raw#10  honest C3       — selftest synthetic; pilot N=1 NOT a proof
//    raw#12  frozen          — own 2 (b) 5-criteria thresholds NOT relaxed
//    raw#37  transient       — reads /tmp helper output by env var
//    raw#52  negative oracle — empty input emits CORROBORATION_FAIL
//    raw#65  idempotent      — same input bytes → same output bytes
//    raw#71  falsifiers ≥ 5  — F1..F5 own 2 (b) failure modes exercised
//    raw#82  darwin-native   — pure file IO, no shell-out
//    raw#91  high-variance   — supermajority (>=3 of 5), 60% session
//    raw#106 genus naming    — emitted in JSON
//    own 2   triad-axis      — (a) FC, (b) PC empirical-max, (c) production
//    own 5   completeness    — selftest + falsifier + pilot all required
//    NO_API                  — zero outbound HTTP, zero Anthropic SDK
//
//  USAGE
//    HEXA_RESOLVER_NO_REROUTE=1 hexa run \
//      anima-clm-eeg/tool/mk_xii_eeg_corroboration.hexa --selftest
//
//  ENV
//    MK_XII_EEG_PAIRED_IN  paired JSONL input
//                          (default: /tmp/mk_xii_eeg_paired.jsonl)
//    MK_XII_EEG_AUDIT_OUT  audit output
//                          (default: state/mk_xii_eeg_audit/2026-04-28_corroboration.jsonl)
//    MK_XII_EEG_SELFTEST   "1" → use built-in 10-pair synthetic fixture
//
//  OUTPUT  (single-line JSON, append)
//    {"genus":"mk-xii-eeg-corroboration","raw_rank":9,
//     "deterministic":true,"hexa_only":true,"llm":"none","api":"none",
//     "n_pairs":N,"pair_ok_count":K,"pair_ok_rate_x1000":...,
//     "session_verdict":"CORROBORATION_OK|CORROBORATION_FAIL",
//     "criteria":{"C1":...,"C2":...,"C3":...,"C4":...,"C5":...},
//     "falsifiers_pass":F,"falsifiers_total":5,
//     "selftest":bool,"fingerprint":<int>}
// ════════════════════════════════════════════════════════════════════════════

let M32 = 4294967296
let FNV_PRIME = 16777619
let FNV_OFFSET_BASIS = 2166136261

// ─── env helpers ────────────────────────────────────────────────────────────
fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

// ─── FNV-1a (modular, byte-identical, raw#65) ───────────────────────────────
fn fnv_step(h: int, byte: int) -> int {
    let mut x = (h + byte) % M32
    if x < 0 { x = x + M32 }
    x = (x * FNV_PRIME) % M32
    if x < 0 { x = x + M32 }
    return x
}

fn fp_int(fp: int, val: int) -> int {
    let mut h = fp
    h = fnv_step(h, val % 256)
    h = fnv_step(h, (val / 256) % 256)
    h = fnv_step(h, (val / 65536) % 256)
    h = fnv_step(h, (val / 16777216) % 256)
    return h
}

// ─── string scan: find substring ────────────────────────────────────────────
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn is_digit(c: string) -> int {
    if digit_val(c) >= 0 { return 1 }
    return 0
}

// extract integer immediately after `key`
fn extract_int_after(s: string, key: string) -> int {
    let pos = find_in_str(s, key)
    if pos < 0 { return -1 }
    let mut i = pos + len(key)
    let n = len(s)
    while i < n && digit_val(s[i]) < 0 {
        i = i + 1
    }
    if i >= n { return -1 }
    let mut acc = 0
    let mut any = 0
    while i < n && digit_val(s[i]) >= 0 {
        acc = acc * 10 + digit_val(s[i])
        any = 1
        i = i + 1
    }
    if any == 0 { return -1 }
    return acc
}

// ─── per-line criteria scoring ──────────────────────────────────────────────
// Returns axes_pass count (0..5) for one paired line
fn score_line(line: string) -> int {
    let mut pass = 0
    let c1 = extract_int_after(line, "\"cohort_n\":")
    if c1 >= 5 { pass = pass + 1 }
    let c2 = extract_int_after(line, "\"effect_x1000\":")
    if c2 >= 800 { pass = pass + 1 }
    let c3 = extract_int_after(line, "\"self_eeg_r_x1000\":")
    if c3 >= 500 { pass = pass + 1 }
    let c4 = extract_int_after(line, "\"advers_misc_x1000\":")
    // C4 is INVERSE: lower is better; pass iff < 100 (= 10%)
    if c4 >= 0 && c4 < 100 { pass = pass + 1 }
    let c5 = extract_int_after(line, "\"clm_alpha_plv_x1000\":")
    if c5 >= 500 { pass = pass + 1 }
    return pass
}

// ─── aggregate paired JSONL ─────────────────────────────────────────────────
// Returns [n_pairs, ok_count, fp, c1_max, c2_sum, c3_sum, c4_sum, c5_sum]
fn aggregate_jsonl(text: string) -> [int] {
    let n = len(text)
    let mut start = 0
    let mut i = 0
    let mut n_pairs = 0
    let mut ok_count = 0
    let mut fp = FNV_OFFSET_BASIS
    let mut c1_max = 0
    let mut c2_sum = 0
    let mut c3_sum = 0
    let mut c4_sum = 0
    let mut c5_sum = 0
    while i <= n {
        if i == n || text[i] == "\n" {
            if i > start {
                let mut line = ""
                let mut k = start
                while k < i { line = line + text[k]; k = k + 1 }
                let pass = score_line(line)
                let c1 = extract_int_after(line, "\"cohort_n\":")
                let c2 = extract_int_after(line, "\"effect_x1000\":")
                let c3 = extract_int_after(line, "\"self_eeg_r_x1000\":")
                let c4 = extract_int_after(line, "\"advers_misc_x1000\":")
                let c5 = extract_int_after(line, "\"clm_alpha_plv_x1000\":")
                // record only lines that contain at least one criterion field
                if c1 >= 0 || c2 >= 0 || c3 >= 0 || c4 >= 0 || c5 >= 0 {
                    n_pairs = n_pairs + 1
                    if pass >= 3 { ok_count = ok_count + 1 }
                    fp = fp_int(fp, pass)
                    if c1 > c1_max { c1_max = c1 }
                    if c2 >= 0 { c2_sum = c2_sum + c2 }
                    if c3 >= 0 { c3_sum = c3_sum + c3 }
                    if c4 >= 0 { c4_sum = c4_sum + c4 }
                    if c5 >= 0 { c5_sum = c5_sum + c5 }
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    return [n_pairs, ok_count, fp, c1_max, c2_sum, c3_sum, c4_sum, c5_sum]
}

// ─── built-in synthetic 10-pair selftest (raw#10 honest C3, NOT real EEG) ───
// Mix designed: 7 of 10 pairs have axes_pass >= 3 → ok_rate 700/1000
fn synthetic_paired_jsonl() -> string {
    // Each row: cohort_n, effect_x1000, self_eeg_r_x1000, advers_misc_x1000, clm_alpha_plv_x1000
    let cn = [5, 6, 5, 5, 4, 5, 6, 3, 5, 5]
    let ef = [820, 850, 700, 900, 400, 880, 810, 300, 950, 820]
    let rs = [550, 600, 200, 700, 300, 580, 520, 100, 750, 540]
    let am = [80,  60,  150, 50,  200, 70,  80,  400, 40,  90]
    let pl = [600, 700, 400, 800, 300, 650, 620, 200, 750, 580]
    let mut s = ""
    let mut i = 0
    while i < 10 {
        s = s + "{\"pair_idx\":" + str(i)
        s = s + ",\"synthetic\":true"
        s = s + ",\"cohort_n\":" + str(cn[i])
        s = s + ",\"effect_x1000\":" + str(ef[i])
        s = s + ",\"self_eeg_r_x1000\":" + str(rs[i])
        s = s + ",\"advers_misc_x1000\":" + str(am[i])
        s = s + ",\"clm_alpha_plv_x1000\":" + str(pl[i])
        s = s + "}\n"
        i = i + 1
    }
    return s
}

// ─── falsifier exercises (raw#71 — 5 own 2 (b) failure modes) ───────────────
// Returns 1 if all 5 falsifiers behave as expected on synthetic fixture.
fn run_falsifiers() -> int {
    // F1: cohort_n < 5 → criterion fails (C1 axis)
    let f1_line = "{\"cohort_n\":3,\"effect_x1000\":900,\"self_eeg_r_x1000\":600,\"advers_misc_x1000\":50,\"clm_alpha_plv_x1000\":700}"
    let f1_pass = score_line(f1_line)
    let f1 = if f1_pass == 4 { 1 } else { 0 }   // C1 fails, others pass

    // F2: effect_x1000 < 500 → criterion fails (C2 axis)
    let f2_line = "{\"cohort_n\":6,\"effect_x1000\":300,\"self_eeg_r_x1000\":600,\"advers_misc_x1000\":50,\"clm_alpha_plv_x1000\":700}"
    let f2_pass = score_line(f2_line)
    let f2 = if f2_pass == 4 { 1 } else { 0 }

    // F3: self_eeg_r_x1000 < 200 → criterion fails (C3 axis)
    let f3_line = "{\"cohort_n\":6,\"effect_x1000\":900,\"self_eeg_r_x1000\":100,\"advers_misc_x1000\":50,\"clm_alpha_plv_x1000\":700}"
    let f3_pass = score_line(f3_line)
    let f3 = if f3_pass == 4 { 1 } else { 0 }

    // F4: advers_misc_x1000 > 300 → criterion fails (C4 axis)
    let f4_line = "{\"cohort_n\":6,\"effect_x1000\":900,\"self_eeg_r_x1000\":600,\"advers_misc_x1000\":400,\"clm_alpha_plv_x1000\":700}"
    let f4_pass = score_line(f4_line)
    let f4 = if f4_pass == 4 { 1 } else { 0 }

    // F5: clm_alpha_plv_x1000 < 500 → criterion fails (C5 axis)
    let f5_line = "{\"cohort_n\":6,\"effect_x1000\":900,\"self_eeg_r_x1000\":600,\"advers_misc_x1000\":50,\"clm_alpha_plv_x1000\":300}"
    let f5_pass = score_line(f5_line)
    let f5 = if f5_pass == 4 { 1 } else { 0 }

    // Idempotency check (raw#65): aggregate twice → same fingerprint
    let r_a = aggregate_jsonl(synthetic_paired_jsonl())
    let r_b = aggregate_jsonl(synthetic_paired_jsonl())
    let idem = if r_a[2] == r_b[2] && r_a[0] == r_b[0] && r_a[1] == r_b[1] { 1 } else { 0 }

    let total = f1 + f2 + f3 + f4 + f5
    println("  falsifier_F1_cohort_lt5      = " + str(f1))
    println("  falsifier_F2_effect_small    = " + str(f2))
    println("  falsifier_F3_self_eeg_low    = " + str(f3))
    println("  falsifier_F4_advers_high     = " + str(f4))
    println("  falsifier_F5_clm_plv_broken  = " + str(f5))
    println("  raw65_idempotent_check       = " + str(idem))
    println("  falsifiers_total             = " + str(total) + " / 5")
    if total == 5 && idem == 1 { return 1 }
    return 0
}

// ─── main ───────────────────────────────────────────────────────────────────
fn main() {
    let in_path  = env_str("MK_XII_EEG_PAIRED_IN", "/tmp/mk_xii_eeg_paired.jsonl")
    let out_path = env_str("MK_XII_EEG_AUDIT_OUT",
        "state/mk_xii_eeg_audit/2026-04-28_corroboration.jsonl")
    let selftest = env_str("MK_XII_EEG_SELFTEST", "1")

    println("─── mk_xii_eeg_corroboration (raw#9 hexa-only · NO_API) ───")
    println("  genus       = mk-xii-eeg-corroboration")
    println("  in_path     = " + in_path)
    println("  out_path    = " + out_path)
    println("  selftest    = " + selftest)
    println("  cycle       = T17 own 2 (b) PC empirical-maximum")

    // Falsifier battery (raw#71)
    println("─── falsifier battery (raw#71 ≥ 5) ───")
    let f_ok = run_falsifiers()

    // Aggregate (synthetic if selftest, else read file)
    let mut text = ""
    let mut is_synth = 0
    if selftest == "1" {
        text = synthetic_paired_jsonl()
        is_synth = 1
    } else {
        text = read_file(in_path)
    }

    let r = aggregate_jsonl(text)
    let n_pairs = r[0]
    let ok_count = r[1]
    let fp = r[2]
    let c1_max = r[3]
    let c2_sum = r[4]
    let c3_sum = r[5]
    let c4_sum = r[6]
    let c5_sum = r[7]
    let mut rate_x1000 = 0
    if n_pairs > 0 { rate_x1000 = (ok_count * 1000) / n_pairs }
    let mut c2_mean = 0
    let mut c3_mean = 0
    let mut c4_mean = 0
    let mut c5_mean = 0
    if n_pairs > 0 {
        c2_mean = c2_sum / n_pairs
        c3_mean = c3_sum / n_pairs
        c4_mean = c4_sum / n_pairs
        c5_mean = c5_sum / n_pairs
    }

    // Session verdict (raw#91 60% threshold AND raw#71 falsifiers all-pass)
    let mut verdict = "CORROBORATION_FAIL"
    if rate_x1000 >= 600 && n_pairs > 0 && f_ok == 1 {
        verdict = "CORROBORATION_OK"
    }

    // Emit JSON
    let mut row = "{\"genus\":\"mk-xii-eeg-corroboration\""
    row = row + ",\"raw_rank\":9"
    row = row + ",\"cycle\":\"T17\""
    row = row + ",\"own_axis\":\"own2_b_PC_empirical_maximum\""
    row = row + ",\"deterministic\":true"
    row = row + ",\"hexa_only\":true"
    row = row + ",\"llm\":\"none\""
    row = row + ",\"api\":\"none\""
    row = row + ",\"selftest\":" + (if is_synth == 1 { "true" } else { "false" })
    row = row + ",\"n_pairs\":" + str(n_pairs)
    row = row + ",\"pair_ok_count\":" + str(ok_count)
    row = row + ",\"pair_ok_rate_x1000\":" + str(rate_x1000)
    row = row + ",\"criteria\":{"
    row = row + "\"C1_cohort_n_max\":" + str(c1_max)
    row = row + ",\"C2_effect_x1000_mean\":" + str(c2_mean)
    row = row + ",\"C3_self_eeg_r_x1000_mean\":" + str(c3_mean)
    row = row + ",\"C4_advers_misc_x1000_mean\":" + str(c4_mean)
    row = row + ",\"C5_clm_alpha_plv_x1000_mean\":" + str(c5_mean)
    row = row + "}"
    row = row + ",\"session_verdict\":\"" + verdict + "\""
    row = row + ",\"falsifiers_total\":5"
    row = row + ",\"falsifiers_pass\":" + str(if f_ok == 1 { 5 } else { 0 })
    row = row + ",\"fingerprint\":" + str(fp)
    row = row + ",\"frozen_thresholds\":\"raw#12 N>=5 d>0.8 r>0.5 misc<10pct plv>0.5\""
    row = row + ",\"long_term_timeline_months\":\"12-18\""
    row = row + "}\n"

    write_file(out_path, row)

    println("─── verdict ───")
    println("  n_pairs              = " + str(n_pairs))
    println("  pair_ok_count        = " + str(ok_count))
    println("  pair_ok_rate_x1k     = " + str(rate_x1000) + " / 1000")
    println("  C1_cohort_n_max      = " + str(c1_max))
    println("  C2_effect_x1k_mean   = " + str(c2_mean))
    println("  C3_self_eeg_r_x1k    = " + str(c3_mean))
    println("  C4_advers_misc_x1k   = " + str(c4_mean))
    println("  C5_clm_alpha_plv_x1k = " + str(c5_mean))
    println("  session_verdict      = " + verdict)
    println("  falsifiers_pass      = " + str(if f_ok == 1 { 5 } else { 0 }) + " / 5")
    println("  fingerprint          = " + str(fp))
    println("  output               = " + out_path)

    // Exit gate (own 5 completeness):
    //   selftest must produce CORROBORATION_OK AND all 5 falsifiers pass
    let pass = if is_synth == 1 && verdict == "CORROBORATION_OK" && f_ok == 1 { 1 }
               else if is_synth == 0 && f_ok == 1 { 1 }
               else { 0 }
    if pass == 1 {
        println("  selftest_verdict     = SELFTEST_OK")
        exit(0)
    }
    println("  selftest_verdict     = SELFTEST_FAIL")
    exit(1)
}
