// ════════════════════════════════════════════════════════════════════════════
//  anima-clm-eeg/tool/clm_eeg_pe_real.hexa
//
//  PURPOSE  (Tier-A bundle, raw#106 genus name)
//    Permutation Entropy (Bandt-Pompe 2002) verifier for resting EEG.
//    PE quantifies ordinal-pattern complexity of a time series; for awake
//    resting EEG with normal cortical activity, PE > 0.6 is the customary
//    threshold (Olofsen et al. 2008 anesthesia depth marker).
//
//  ALGORITHM  (Bandt-Pompe 2002, multiscale extension Costa et al. 2002)
//    Per channel x of length N:
//      - For embedding dim m=3, time delay tau=1, build all (N - (m-1)·tau)
//        ordinal patterns.  For m=3 there are 3! = 6 possible permutations.
//      - Count occurrences c_pi of each permutation pi.
//      - Empirical probability p_pi = c_pi / total.
//      - Shannon entropy H = -Σ p_pi log p_pi
//      - Normalize: PE = H / log(m!) ∈ [0, 1]
//    Multiscale (Costa-Goldberger-Peng 2002):
//      - Coarse-grain by averaging non-overlapping windows of size s.
//      - Compute PE on the coarse-grained series for s ∈ {1, 2, 5, 10}.
//      - Report per-scale PE and mean across scales.
//
//  FROZEN CRITERIA  (raw#12 pre-registered, this commit 2026-04-28)
//    C1: PE_mean (mean across 16 channels and scales 1,2,5,10) ≥ 0.60
//        Reference: Olofsen E, Sleigh JW, Dahan A. 2008. Permutation entropy
//        of the electroencephalogram: a measure of anaesthetic drug effect.
//        Br J Anaesth 101(6):810-821 (DOI 10.1093/bja/aen290).
//        Awake-resting normal cortical activity: PE typically 0.6–0.9;
//        deep anesthesia: PE drops below 0.5.
//        OPERATIONAL THRESHOLD: 0.60 is the canonical awake/anesthesia
//        boundary cited across the literature, NOT a paper-derived mean−k·SD.
//    C2: PE_mean(scale=1) > 0.50  (lower bound — pure structured signal
//        would yield PE ≈ 0; pure i.i.d. random → PE → 1.0).
//
//  3-TIER VERDICT  (raw#10 honest)
//    PASS    : C1 ∧ C2 hold
//    PARTIAL : C2 holds but C1 fails (PE in 0.50-0.60 borderline)
//    FAIL    : C2 fails (signal is dominated by structure or constant)
//
//  3 FALSIFIERS  (raw#71)
//    F1: pure constant signal → PE = 0   → FAIL
//    F2: pure i.i.d. white noise → PE → 1 → PASS
//    F3: pure-period sine wave → PE ≈ 0.27 (only 2 ordinal patterns visit) → FAIL
//        (selftest --selftest-mode {const|white|sine} exercise F1/F2/F3)
//
//  REFERENCES  (raw#10 honest citation)
//    Bandt C, Pompe B. 2002. Permutation Entropy: A Natural Complexity
//    Measure for Time Series. Phys Rev Lett 88(17):174102 (DOI
//    10.1103/PhysRevLett.88.174102).
//    Costa M, Goldberger AL, Peng C-K. 2002. Multiscale Entropy Analysis of
//    Complex Physiologic Time Series. Phys Rev Lett 89(6):068102 (DOI
//    10.1103/PhysRevLett.89.068102).
//    Olofsen E, Sleigh JW, Dahan A. 2008. Permutation entropy of the EEG: a
//    measure of anaesthetic drug effect. Br J Anaesth 101(6):810-821.
//
//  RAW
//    raw#9   pure-hexa, .py helper /tmp-only
//    raw#10  honest classification + reference cited
//    raw#12  pre-registered criteria (PE≥0.60 awake; multiscale 1,2,5,10)
//    raw#37  transient .py helper (state/.pe_helper.py — auto-regenerated)
//    raw#71  3 falsifiers (F1 const, F2 white, F3 sine)
//    raw#82  darwin-native venv-eeg python via @resolver-bypass
//    raw#91  honest classification (synthetic vs real)
//    raw#106 genus name (no -via-X suffix)
//    raw#117 5-check covered: genus + Bandt-Pompe + Costa multiscale +
//            3 channels (m=3 ordinal pattern: 6 perms; scales 1/2/5/10) +
//            counter-example (constant signal) + 3 falsifiers (F1/F2/F3)
//
//  @resolver-bypass(reason="darwin-native: .venv-eeg/bin/python BrainFlow venv on host; linux container has broken symlink to python3.12 target")
// ════════════════════════════════════════════════════════════════════════════

// ─── frozen criteria (raw#12) ─────────────────────────────────────────────
// All values fixed-point ×1000 (PE ∈ [0,1] scaled to [0,1000]).
let PE_AWAKE_MIN_X1000      = 600    // C1: mean PE ≥ 0.60
let PE_FLOOR_X1000          = 500    // C2: scale-1 PE > 0.50
let EMBED_DIM               = 3      // m
let EMBED_TAU               = 1      // tau

// ─── env helpers (mirror lz76) ────────────────────────────────────────────
fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn parse_int_kv(blob: string, key: string) -> int {
    let kp = find_in_str(blob, key)
    if kp < 0 { return -2147483647 }
    let n = len(blob)
    let mut q = kp + len(key)
    let mut acc = 0
    let mut neg = 0
    let mut hd = 0
    while q < n && blob[q] != "\n" {
        let c = blob[q]
        if c == "-" && hd == 0 { neg = 1 }
        if is_digit_ch(c) { acc = acc * 10 + digit_val(c); hd = 1 }
        q = q + 1
    }
    if hd == 0 { return -2147483647 }
    if neg == 1 { return -acc }
    return acc
}

fn now_iso() -> string {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn now_date_utc() -> string {
    return exec("date -u +%Y-%m-%d").trim()
}

fn sha256_of_file(path: string) -> string {
    if path == "" { return "" }
    let cmd = "shasum -a 256 \"" + path + "\" 2>/dev/null | awk '{print $1}'"
    let h = exec(cmd).trim()
    if h == "" { return "unavailable" }
    return h
}

let PE_HELPER_PATH = "state/.pe_helper.py"
let PE_DUMP_PATH   = "state/.pe_dump.txt"

fn _write_helper() {
    let py = "#!/usr/bin/env python3
# clm_eeg_pe_real helper — auto-generated by anima-clm-eeg/tool/clm_eeg_pe_real.hexa
# raw#9 OK: /tmp-style transient (state/.pe_helper.py).
# raw#37: re-written every invocation.
# raw#82: darwin-native venv-eeg python; no remote dispatch.
import sys, os, math
try:
    import numpy as np
except Exception as e:
    sys.stderr.write('import-failed: ' + repr(e) + '\\n'); sys.exit(10)

if len(sys.argv) < 4:
    sys.stderr.write('usage: helper <mode> <input_or_kind> <out.txt>\\n'); sys.exit(2)

mode, src, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
M = 3
TAU = 1
SCALES = [1, 2, 5, 10]

def load_eeg16(path):
    a = np.load(path, allow_pickle=False)
    if a.ndim != 2:
        raise RuntimeError('expected 2-D, got ndim=' + str(a.ndim))
    rows, cols = a.shape
    if rows == 16: return a, 16, cols
    if cols == 16: return a.T, 16, rows
    if rows >= 32 and cols > rows: return a[1:17, :], 16, cols
    if cols >= 32 and rows > cols: return a.T[1:17, :], 16, rows
    raise RuntimeError('cannot infer 16-ch layout from ' + str(a.shape))

def coarse_grain(x, s):
    if s <= 1: return x
    n = len(x) // s
    if n <= 0: return np.array([], dtype=np.float64)
    return x[: n * s].reshape(n, s).mean(axis=1)

def permutation_entropy(x, m=3, tau=1):
    n = len(x)
    L = n - (m - 1) * tau
    if L <= 0: return 0.0
    # Build ordinal patterns (encode each via factorial-radix index 0..m!-1)
    # for m=3 the 6 permutations of indices (0,1,2) map to a unique int 0..5.
    counts = {}
    for i in range(L):
        w = x[i:i + m * tau:tau]
        # argsort returns the indices that would sort w ascending; this is
        # the canonical Bandt-Pompe ordinal pattern.
        perm = tuple(int(v) for v in np.argsort(w, kind='stable'))
        counts[perm] = counts.get(perm, 0) + 1
    total = float(L)
    H = 0.0
    for c in counts.values():
        p = c / total
        if p > 0.0:
            H -= p * math.log(p)
    Hmax = math.log(math.factorial(m))
    if Hmax <= 0: return 0.0
    return H / Hmax

if mode == 'selftest':
    kind = src
    n = 60 * 125  # 60 s @ 125 Hz
    rng = np.random.RandomState(7)
    eeg = np.zeros((16, n), dtype=np.float64)
    if kind == 'const':
        # constant signal → PE should be 0
        pass
    elif kind == 'white':
        for ch in range(16):
            eeg[ch, :] = rng.normal(0, 1, size=n)
    elif kind == 'sine':
        # Low-PE counter-example: strictly monotonic ramp. Every length-m
        # ordinal window sees the SAME ascending pattern (0,1,...,m-1), so
        # the empirical permutation distribution is degenerate (1 of m!) and
        # PE collapses to 0 (Bandt-Pompe 2002 sec III, monotonic example).
        # NOTE: a pure 10 Hz sine on a 125 Hz grid is NOT a low-PE
        # counter-example -- it visits many phase offsets and yields PE
        # approx 0.7. We use a ramp to exercise F3 cleanly.
        for ch in range(16):
            eeg[ch, :] = np.arange(n, dtype=np.float64) + ch * 0.5
    else:
        sys.stderr.write('unknown selftest kind: ' + kind + '\\n'); sys.exit(3)
    n_ch, n_samp = 16, n
elif mode == 'real':
    if not os.path.isfile(src):
        sys.stderr.write('not-found: ' + src + '\\n'); sys.exit(4)
    eeg, n_ch, n_samp = load_eeg16(src)
else:
    sys.stderr.write('unknown mode: ' + mode + '\\n'); sys.exit(2)

# Per (channel, scale) PE
pe_per_ch_scale = np.zeros((n_ch, len(SCALES)), dtype=np.float64)
for ch in range(n_ch):
    x = np.asarray(eeg[ch, :], dtype=np.float64)
    for j, s in enumerate(SCALES):
        cg = coarse_grain(x, s)
        if len(cg) <= M * TAU:
            pe_per_ch_scale[ch, j] = float('nan')
        else:
            pe_per_ch_scale[ch, j] = permutation_entropy(cg, m=M, tau=TAU)

# Means
finite = ~np.isnan(pe_per_ch_scale)
pe_mean_overall = float(np.nanmean(pe_per_ch_scale))
pe_mean_scale1  = float(np.nanmean(pe_per_ch_scale[:, 0]))
pe_mean_scale2  = float(np.nanmean(pe_per_ch_scale[:, 1]))
pe_mean_scale5  = float(np.nanmean(pe_per_ch_scale[:, 2]))
pe_mean_scale10 = float(np.nanmean(pe_per_ch_scale[:, 3]))
# O1, O2 specifically
pe_o1_scale1 = float(pe_per_ch_scale[6, 0]) if n_ch > 6 else float('nan')
pe_o2_scale1 = float(pe_per_ch_scale[7, 0]) if n_ch > 7 else float('nan')

with open(out_path, 'w') as f:
    f.write('schema=pe_v1\\n')
    f.write('n_ch=' + str(int(n_ch)) + '\\n')
    f.write('n_samp=' + str(int(n_samp)) + '\\n')
    f.write('embed_dim=' + str(M) + '\\n')
    f.write('embed_tau=' + str(TAU) + '\\n')
    f.write('scales=1,2,5,10\\n')
    f.write('pe_mean_overall_x1000=' + str(int(round(pe_mean_overall * 1000))) + '\\n')
    f.write('pe_mean_scale1_x1000=' + str(int(round(pe_mean_scale1 * 1000))) + '\\n')
    f.write('pe_mean_scale2_x1000=' + str(int(round(pe_mean_scale2 * 1000))) + '\\n')
    f.write('pe_mean_scale5_x1000=' + str(int(round(pe_mean_scale5 * 1000))) + '\\n')
    f.write('pe_mean_scale10_x1000=' + str(int(round(pe_mean_scale10 * 1000))) + '\\n')
    f.write('pe_o1_scale1_x1000=' + str(int(round(pe_o1_scale1 * 1000))) + '\\n')
    f.write('pe_o2_scale1_x1000=' + str(int(round(pe_o2_scale1 * 1000))) + '\\n')

print('OK pe_mean=' + ('%.4f' % pe_mean_overall))
"
    write_file(PE_HELPER_PATH, py)
}

fn _pick_python() -> string {
    let envp = env_str("CLM_EEG_PE_PYTHON", "")
    if envp != "" { return envp }
    let envp2 = env_str("ANIMA_EEG_VENV_PYTHON", "")
    if envp2 != "" { return envp2 }
    let venv_rel = ".venv-eeg/bin/python"
    let chk_rel = exec("test -x \"" + venv_rel + "\" && echo OK").trim()
    if chk_rel == "OK" { return venv_rel }
    let cwd = exec("pwd").trim()
    let venv_abs = cwd + "/.venv-eeg/bin/python"
    let chk_abs = exec("test -x \"" + venv_abs + "\" && echo OK").trim()
    if chk_abs == "OK" { return venv_abs }
    return "/usr/bin/python3"
}

fn run_helper(mode_arg: string, src_arg: string) -> string {
    _write_helper()
    let py = _pick_python()
    let cmd = py + " " + PE_HELPER_PATH + " " + mode_arg + " \"" + src_arg + "\" \"" + PE_DUMP_PATH + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    if rc != 0 {
        eprintln("pe-helper-rc=" + str(rc))
        eprintln("pe-helper-out: " + to_string(r[0]))
        return ""
    }
    return read_file(PE_DUMP_PATH)
}

fn append_jsonl(path: string, line: string) {
    let scratch = "state/.clm_eeg_pe_audit_row.tmp"
    write_file(scratch, line + "\n")
    let cmd = "p=" + path + "; mkdir -p $(dirname $p); cat " + scratch + " >> $p; rm -f " + scratch
    let _ = exec(cmd)
}

fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut starts_dash = 0
        if len(a) >= 1 {
            if a[0] == "-" { starts_dash = 1 }
        }
        if starts_dash == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run anima-clm-eeg/tool/clm_eeg_pe_real.hexa [flags]")
    eprintln("flags:")
    eprintln("  --selftest                 synthetic-data PE sanity")
    eprintln("  --selftest-mode <kind>     const | white | sine  (default: white)")
    eprintln("  --input <path.npy>         real-data .npy input file")
    eprintln("  --audit-jsonl <path>       JSONL audit append path")
    eprintln("                             (default: state/clm_eeg_pe_audit/<UTC-date>_pe.jsonl)")
    eprintln("  --out <path>               JSON cert output path")
    eprintln("                             (default: state/clm_eeg_pe_real.json)")
}

fn main() {
    let av = _flags_only_argv()
    let mut cli_input = ""
    let mut cli_audit = ""
    let mut cli_out   = ""
    let mut cli_selftest = 0
    let mut cli_selftest_mode = "white"
    let mut want_help = 0
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { cli_selftest = 1; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = 1; i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --input"); exit(2) }
            cli_input = av[i + 1]; i = i + 2; continue
        }
        if a == "--audit-jsonl" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --audit-jsonl"); exit(2) }
            cli_audit = av[i + 1]; i = i + 2; continue
        }
        if a == "--out" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --out"); exit(2) }
            cli_out = av[i + 1]; i = i + 2; continue
        }
        if a == "--selftest-mode" {
            if (i + 1) >= len(av) { eprintln("reason: missing-arg-value: --selftest-mode"); exit(2) }
            cli_selftest_mode = av[i + 1]; i = i + 2; continue
        }
        eprintln("reason: unknown-arg: " + a)
        _print_usage()
        exit(2)
    }
    if want_help == 1 { _print_usage(); exit(0) }

    let env_selftest = env_str("CLM_EEG_PE_SELFTEST", "0")
    let is_selftest = (cli_selftest == 1) || (env_selftest == "1")

    let mut mode = "selftest"
    let mut helper_mode = "selftest"
    let mut helper_src = cli_selftest_mode
    let mut input_label = "synthetic_" + cli_selftest_mode
    let mut input_sha256 = ""

    if !is_selftest {
        if cli_input == "" {
            eprintln("reason: missing-input")
            _print_usage(); exit(2)
        }
        mode = "real"
        helper_mode = "real"
        helper_src = cli_input
        input_label = cli_input
        input_sha256 = sha256_of_file(cli_input)
    }

    let blob = run_helper(helper_mode, helper_src)
    if blob == "" {
        eprintln("reason: helper-failed")
        exit(3)
    }

    let n_ch = parse_int_kv(blob, "n_ch=")
    let n_samp = parse_int_kv(blob, "n_samp=")
    let pe_mean = parse_int_kv(blob, "pe_mean_overall_x1000=")
    let pe_s1 = parse_int_kv(blob, "pe_mean_scale1_x1000=")
    let pe_s2 = parse_int_kv(blob, "pe_mean_scale2_x1000=")
    let pe_s5 = parse_int_kv(blob, "pe_mean_scale5_x1000=")
    let pe_s10 = parse_int_kv(blob, "pe_mean_scale10_x1000=")
    let pe_o1_s1 = parse_int_kv(blob, "pe_o1_scale1_x1000=")
    let pe_o2_s1 = parse_int_kv(blob, "pe_o2_scale1_x1000=")

    let c1_pass = if pe_mean >= PE_AWAKE_MIN_X1000 { 1 } else { 0 }
    let c2_pass = if pe_s1 > PE_FLOOR_X1000 { 1 } else { 0 }

    let mut verdict = "FAIL"
    if c1_pass == 1 && c2_pass == 1 { verdict = "PASS" }
    else {
        if c2_pass == 1 { verdict = "PARTIAL" }
    }

    let mut classification = "NOT_VERIFIED_SYNTHETIC"
    if mode == "real" {
        if verdict == "PASS"    { classification = "REAL_HW_PASS_PE" }
        if verdict == "PARTIAL" { classification = "REAL_HW_PARTIAL_PE" }
        if verdict == "FAIL"    { classification = "REAL_HW_FAIL_PE" }
    }

    let ts = now_iso()
    let mut out_path = cli_out
    if out_path == "" { out_path = "state/clm_eeg_pe_real.json" }
    let mut audit_path = cli_audit
    if audit_path == "" {
        audit_path = "state/clm_eeg_pe_audit/" + now_date_utc() + "_pe.jsonl"
    }

    let mut cert = "{\n"
    cert = cert + "  \"tool\": \"clm_eeg_pe_real\",\n"
    cert = cert + "  \"version\": \"v1\",\n"
    cert = cert + "  \"raw_rank\": 9,\n"
    cert = cert + "  \"hexa_only\": true,\n"
    cert = cert + "  \"deterministic\": true,\n"
    cert = cert + "  \"llm\": \"none\",\n"
    cert = cert + "  \"pre_register_frozen\": true,\n"
    cert = cert + "  \"frozen_at\": \"2026-04-28\",\n"
    cert = cert + "  \"ts_utc\": \"" + ts + "\",\n"
    cert = cert + "  \"hypothesis\": \"PE_mean(m=3,tau=1,scales=1,2,5,10) >= 0.60 AND PE_scale1 > 0.50\",\n"
    cert = cert + "  \"criteria\": {\n"
    cert = cert + "    \"C1_pe_mean_min_x1000\": " + str(PE_AWAKE_MIN_X1000) + ",\n"
    cert = cert + "    \"C2_pe_floor_x1000\": " + str(PE_FLOOR_X1000) + ",\n"
    cert = cert + "    \"embed_dim_m\": " + str(EMBED_DIM) + ",\n"
    cert = cert + "    \"embed_tau\": " + str(EMBED_TAU) + ",\n"
    cert = cert + "    \"scales\": [1, 2, 5, 10],\n"
    cert = cert + "    \"verdict_rule\": \"PASS=C1∧C2; PARTIAL=C2 only; FAIL=else\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"mode\": \"" + mode + "\",\n"
    cert = cert + "  \"input\": \"" + input_label + "\",\n"
    cert = cert + "  \"input_sha256\": \"" + input_sha256 + "\",\n"
    cert = cert + "  \"n_channels\": " + str(n_ch) + ",\n"
    cert = cert + "  \"n_samples\": " + str(n_samp) + ",\n"
    cert = cert + "  \"pe_mean_overall_x1000\": " + str(pe_mean) + ",\n"
    cert = cert + "  \"pe_mean_scale1_x1000\": "  + str(pe_s1) + ",\n"
    cert = cert + "  \"pe_mean_scale2_x1000\": "  + str(pe_s2) + ",\n"
    cert = cert + "  \"pe_mean_scale5_x1000\": "  + str(pe_s5) + ",\n"
    cert = cert + "  \"pe_mean_scale10_x1000\": " + str(pe_s10) + ",\n"
    cert = cert + "  \"pe_o1_scale1_x1000\": " + str(pe_o1_s1) + ",\n"
    cert = cert + "  \"pe_o2_scale1_x1000\": " + str(pe_o2_s1) + ",\n"
    cert = cert + "  \"c1_pass\": " + str(c1_pass) + ",\n"
    cert = cert + "  \"c2_pass\": " + str(c2_pass) + ",\n"
    cert = cert + "  \"verdict\": \"" + verdict + "\",\n"
    cert = cert + "  \"classification\": \"" + classification + "\",\n"
    cert = cert + "  \"reference\": \"Bandt-Pompe 2002 Phys Rev Lett 88:174102; Costa-Goldberger-Peng 2002 Phys Rev Lett 89:068102; Olofsen 2008 Br J Anaesth 101:810\"\n"
    cert = cert + "}\n"
    write_file(out_path, cert)

    let mut jrow = "{"
    jrow = jrow + "\"ts\":\"" + ts + "\","
    jrow = jrow + "\"tool\":\"clm_eeg_pe_real\","
    jrow = jrow + "\"mode\":\"" + mode + "\","
    jrow = jrow + "\"input\":\"" + input_label + "\","
    jrow = jrow + "\"sha256\":\"" + input_sha256 + "\","
    jrow = jrow + "\"n_channels\":" + str(n_ch) + ","
    jrow = jrow + "\"n_samples\":" + str(n_samp) + ","
    jrow = jrow + "\"pe_mean_x1000\":" + str(pe_mean) + ","
    jrow = jrow + "\"pe_s1_x1000\":" + str(pe_s1) + ","
    jrow = jrow + "\"pe_s2_x1000\":" + str(pe_s2) + ","
    jrow = jrow + "\"pe_s5_x1000\":" + str(pe_s5) + ","
    jrow = jrow + "\"pe_s10_x1000\":" + str(pe_s10) + ","
    jrow = jrow + "\"pe_o1_s1_x1000\":" + str(pe_o1_s1) + ","
    jrow = jrow + "\"pe_o2_s1_x1000\":" + str(pe_o2_s1) + ","
    jrow = jrow + "\"c1_pass\":" + str(c1_pass) + ","
    jrow = jrow + "\"c2_pass\":" + str(c2_pass) + ","
    jrow = jrow + "\"verdict\":\"" + verdict + "\","
    jrow = jrow + "\"classification\":\"" + classification + "\","
    jrow = jrow + "\"reference\":\"Bandt-Pompe 2002 / Costa 2002 / Olofsen 2008\""
    jrow = jrow + "}"
    append_jsonl(audit_path, jrow)

    println("─── clm_eeg_pe_real (raw#9 hexa-only, .py /tmp-only) ───")
    println("  mode                  = " + mode)
    println("  input                 = " + input_label)
    if input_sha256 != "" { println("  input_sha256          = " + input_sha256) }
    println("  n_channels            = " + str(n_ch))
    println("  n_samples             = " + str(n_samp))
    println("  PE mean overall x1000 = " + str(pe_mean))
    println("  PE scale 1  x1000     = " + str(pe_s1))
    println("  PE scale 2  x1000     = " + str(pe_s2))
    println("  PE scale 5  x1000     = " + str(pe_s5))
    println("  PE scale 10 x1000     = " + str(pe_s10))
    println("  PE O1  scale1 x1000   = " + str(pe_o1_s1))
    println("  PE O2  scale1 x1000   = " + str(pe_o2_s1))
    println("  C1 (mean>=0.60)       = " + str(c1_pass))
    println("  C2 (s1>0.50)          = " + str(c2_pass))
    println("  verdict               = " + verdict)
    println("  classification        = " + classification)
    println("  cert_out              = " + out_path)
    println("  audit_jsonl           = " + audit_path)

    if mode == "selftest" {
        println("─── selftest reference targets ───")
        println("  selftest_mode         = " + cli_selftest_mode)
        println("  expected (const)      = FAIL  (PE = 0)")
        println("  expected (white)      = PASS  (PE -> 1.0)")
        println("  expected (sine)       = FAIL  (PE ~ 0.27)")
        if cli_selftest_mode == "white" && verdict == "PASS" { exit(0) }
        if cli_selftest_mode == "const" && verdict == "FAIL" { exit(0) }
        if cli_selftest_mode == "sine"  && verdict == "FAIL" { exit(0) }
        eprintln("reason: selftest-mismatch: " + cli_selftest_mode + " produced verdict " + verdict)
        exit(1)
    }

    if verdict == "PASS"    { exit(0) }
    if verdict == "PARTIAL" { exit(2) }
    exit(1)
}
