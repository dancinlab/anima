// ════════════════════════════════════════════════════════════════════════════
//  anima-clm-eeg/tool/clm_eeg_harness_real_smoke.hexa
//
//  PURPOSE
//    Real-fixture-consuming smoke harness — parallel sibling to the uchg-
//    locked synthetic aggregator `clm_eeg_harness_smoke.hexa`. Whereas
//    the synthetic harness is a pure aggregator over FROZEN p{1,2,3}
//    pre-register synthetic dry-run JSONs (and is therefore CAUSALLY
//    INDEPENDENT of CLM_EEG_FIXTURE_PATH), this harness computes the
//    p1/p2/p3 real-side verdicts directly from the real fixture
//    (default: anima-clm-eeg/fixtures/real_v6_clean_2026_05_03.json) and
//    composes them — so changing the fixture changes the verdict.
//
//    NOT a replacement for the synthetic harness. The synthetic harness
//    remains the dual-lock institutional ground-truth wiring smoke test.
//    This harness is the real-fixture causal companion.
//
//  HONEST C3 (raw#10) — what is measured / what is NOT
//    P1 (LZ76):
//      LZ76 cannot be computed from band-power summary fixtures (it
//      needs the per-sample binarised time series). This harness reads
//      the real-side ledger state/clm_eeg_p1_lz_pre_register_real.json
//      (if present) for the p1 verdict; otherwise marks UNEVALUABLE.
//      Real-side ledger as of 2026-05-02: p1_pass = 0 (C2 fail).
//    P2 (alpha-coh + V_sync r):
//      Alpha-coh CAN be derived from the band-power aggregate as a
//      coarse proxy, but the canonical real-side verdict
//      state/clm_eeg_p2_tlr_real.json carries Welch-MSC alpha-coh =
//      0.576 and V_sync UNEVALUABLE → INSUFFICIENT. This harness reads
//      that ledger if present and surfaces its verdict verbatim.
//    P3 (gamma/theta ratio):
//      DIRECTLY computed from the fixture's aggregate_band_powers_x1000
//      as gamma_x1000 / theta_x1000 → ratio_x1000. Frozen criteria
//      from anima-clm-eeg/tool/clm_eeg_gamma_theta_ratio.hexa apply
//      (C1_loose = [1500, 4500] x1000; F1 gamma_absent < 1.0 x1000;
//      F2 theta_absent > 10.0 x1000). This is the ONE metric where
//      the real fixture HAS direct causal effect on the smoke verdict.
//
//    Composite rule (real-side):
//      HARNESS_OK iff (p1_pass + p2_pass + p3_pass) >= 2
//      where any UNEVALUABLE metric counts as 0.
//
//    Expected real-side verdict (raw#10 honest projection):
//      p1=0 (real-side ledger), p2=0 (INSUFFICIENT), p3 likely 0
//      (real fixture gamma/theta ≈ 8024/507 ≈ 15.8 → exceeds C1 upper
//      bound 4.5 AND triggers F2 theta_absent if theta_x1000 < 10.0).
//      Projection: HARNESS_FAIL.
//
//  DUAL-LOCK POSTURE
//    This file = unlock by default (NOT chflags uchg). Rationale:
//    institutional dual-lock applies to pre-register frozen tools and
//    their aggregators (raw#12 + the existing 96-file uchg policy);
//    this harness is a NEW DERIVATIVE that may evolve cycle-to-cycle
//    as real-side ledgers fill in (P1 LZ live, V_sync r live, etc.).
//    Locking it now would prematurely freeze a known-incomplete real
//    smoke. Lock applied only after raw#71 falsifier closure.
//
//  USAGE
//    # default real-fixture run
//    HEXA_RESOLVER_NO_REROUTE=1 hexa run \
//        anima-clm-eeg/tool/clm_eeg_harness_real_smoke.hexa
//
//    # selftest (synthetic fixture, no real ledgers required)
//    HEXA_RESOLVER_NO_REROUTE=1 hexa run \
//        anima-clm-eeg/tool/clm_eeg_harness_real_smoke.hexa --selftest
//
//    # explicit fixture override
//    CLM_EEG_FIXTURE_PATH=anima-clm-eeg/fixtures/real_v6_clean_2026_05_03.json \
//        HEXA_RESOLVER_NO_REROUTE=1 hexa run \
//        anima-clm-eeg/tool/clm_eeg_harness_real_smoke.hexa
//
//  ENV
//    CLM_EEG_FIXTURE_PATH       fixture JSON
//                                 (default: anima-clm-eeg/fixtures/real_v6_clean_2026_05_03.json)
//    CLM_EEG_REAL_P1_LEDGER     real-side P1 ledger
//                                 (default: state/clm_eeg_p1_lz_pre_register_real.json)
//    CLM_EEG_REAL_P2_LEDGER     real-side P2 ledger
//                                 (default: state/clm_eeg_p2_tlr_real.json)
//    CLM_EEG_REAL_SMOKE_OUT     output verdict JSON
//                                 (default: state/clm_eeg_real_smoke_2026_05_03/verdict.json)
//
//  OUTPUT
//    state/clm_eeg_real_smoke_2026_05_03/verdict.json
//    stdout sentinel: __CLM_EEG_REAL_SMOKE__ <HARNESS_OK|HARNESS_FAIL|INSUFFICIENT>
//
//  EXIT CODES
//    0  HARNESS_OK
//    1  HARNESS_FAIL  (composite real-side fail)
//    2  INSUFFICIENT  (could not parse fixture; no causal evidence)
//
//  RAW INVARIANTS APPLIED
//    raw#9   hexa-only — NO inline .py; pure hexa runtime intrinsics
//    raw#10  honest C3 — explicit caveats above; UNEVALUABLE counted as 0
//    raw#15  repo-relative paths only (no /Users/ghost/...)
//    raw#71  falsifier-bound — explicit sentinel emit on stdout
//    raw#12  pre-register thresholds NOT modified (sourced from frozen specs)
// ════════════════════════════════════════════════════════════════════════════

let M32 = 4294967296
let FNV_PRIME = 16777619
let FNV_OFFSET_BASIS = 2166136261

// Frozen P3 gamma/theta criteria (mirror clm_eeg_gamma_theta_ratio.hexa
// pre-register). x1000 fixed-point throughout. raw#12: NOT relaxed.
let P3_C1_LOOSE_LO = 1500
let P3_C1_LOOSE_HI = 4500
let P3_F1_GAMMA_ABSENT_LT = 1000   // gamma absent if x1000 < 1000
let P3_F2_THETA_ABSENT_GT = 10000  // theta absent if x1000 > 10000 (i.e., theta dominates pathologically)

// ─── env helpers ────────────────────────────────────────────────────────────
fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

// ─── string scan ────────────────────────────────────────────────────────────
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn is_digit_ch(c: string) -> bool {
    if c == "0" { return true }
    if c == "1" { return true }
    if c == "2" { return true }
    if c == "3" { return true }
    if c == "4" { return true }
    if c == "5" { return true }
    if c == "6" { return true }
    if c == "7" { return true }
    if c == "8" { return true }
    if c == "9" { return true }
    return false
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

// Extract first non-negative integer following the FIRST occurrence of <key>.
// Returns -1 if not found.
fn extract_int_after_key(s: string, key: string) -> int {
    let pos = find_in_str(s, key)
    if pos < 0 { return -1 }
    let n = len(s)
    let m = len(key)
    let mut p = pos + m
    while p < n {
        let c = s[p]
        if is_digit_ch(c) {
            let mut v = 0
            while p < n {
                let cd = s[p]
                if is_digit_ch(cd) {
                    v = v * 10 + digit_val(cd)
                    p = p + 1
                } else {
                    return v
                }
            }
            return v
        }
        p = p + 1
    }
    return -1
}

// Bounded find_in_str: only scan up to byte `max_bytes`. Returns -1 if not
// found within that window. Used as a safety against stage1 interpreter
// limits on long while-loops.
fn find_in_str_bounded(s: string, needle: string, max_bytes: int) -> int {
    let n0 = len(s)
    let n = if max_bytes < n0 { max_bytes } else { n0 }
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

// Extract integer following <key>, scanning only up to byte `max_bytes`.
fn extract_int_after_key_bounded(s: string, key: string, max_bytes: int) -> int {
    let pos = find_in_str_bounded(s, key, max_bytes)
    if pos < 0 { return -1 }
    let n = len(s)
    let m = len(key)
    let mut p = pos + m
    // Bound the digit-skip too: don't walk into UTF-8 territory.
    let scan_limit = if max_bytes < n { max_bytes } else { n }
    while p < scan_limit {
        let c = s[p]
        if is_digit_ch(c) {
            let mut v = 0
            while p < scan_limit {
                let cd = s[p]
                if is_digit_ch(cd) {
                    v = v * 10 + digit_val(cd)
                    p = p + 1
                } else {
                    return v
                }
            }
            return v
        }
        p = p + 1
    }
    return -1
}

// find_in_str starting at byte `start_at`. Useful when leading content
// contains UTF-8 chars that the runtime cannot safely traverse.
fn find_in_str_from(s: string, needle: string, start_at: int) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return start_at }
    if n < m { return -1 }
    let mut i = start_at
    if i < 0 { i = 0 }
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

// Extract integer following <key> AND restricted to chars within the first
// occurrence of <scope> after <key>. Used to pull a band power from inside a
// specific aggregate object. Scope search starts at byte `scope_start_at`
// to bypass any leading UTF-8 region.
fn extract_int_after_key_scoped_from(s: string, scope_anchor: string, key: string, scope_start_at: int) -> int {
    let scope_pos = find_in_str_from(s, scope_anchor, scope_start_at)
    if scope_pos < 0 { return -1 }
    let scope_len = len(scope_anchor)
    let scope_start = scope_pos + scope_len
    let n = len(s)
    let m = len(key)
    let mut i = scope_start
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != key[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 {
            let mut p = i + m
            while p < n {
                let c = s[p]
                if is_digit_ch(c) {
                    let mut v = 0
                    while p < n {
                        let cd = s[p]
                        if is_digit_ch(cd) {
                            v = v * 10 + digit_val(cd)
                            p = p + 1
                        } else {
                            return v
                        }
                    }
                    return v
                }
                p = p + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

// Extract integer following <key> AND restricted to chars within the first
// occurrence of <scope> after <key>. Used to pull a band power from inside a
// specific aggregate object.
fn extract_int_after_key_scoped(s: string, scope_anchor: string, key: string) -> int {
    let scope_pos = find_in_str(s, scope_anchor)
    if scope_pos < 0 { return -1 }
    let scope_len = len(scope_anchor)
    let scope_start = scope_pos + scope_len
    // Slice via substring: hexa string indexing supports s[i] only; we walk
    // a bounded sub-window using a character-by-character match. We replicate
    // find_in_str but starting at scope_start.
    let n = len(s)
    let m = len(key)
    let mut i = scope_start
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != key[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 {
            // Found key — extract integer after.
            let mut p = i + m
            while p < n {
                let c = s[p]
                if is_digit_ch(c) {
                    let mut v = 0
                    while p < n {
                        let cd = s[p]
                        if is_digit_ch(cd) {
                            v = v * 10 + digit_val(cd)
                            p = p + 1
                        } else {
                            return v
                        }
                    }
                    return v
                }
                p = p + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

// ─── fingerprint (FNV-style) ────────────────────────────────────────────────
fn fnv_step(h: int, byte: int) -> int {
    let mut x = (h + byte) % M32
    if x < 0 { x = x + M32 }
    x = (x * FNV_PRIME) % M32
    if x < 0 { x = x + M32 }
    return x
}

fn fingerprint_step(fp: int, val: int) -> int {
    let mut h = fp
    h = fnv_step(h, val % 256)
    h = fnv_step(h, (val / 256) % 256)
    h = fnv_step(h, (val / 65536) % 256)
    h = fnv_step(h, (val / 16777216) % 256)
    return h
}

// ─── arg parsing ────────────────────────────────────────────────────────────
fn has_flag(needle: string) -> bool {
    let av = args()
    let mut i = 0
    let n = len(av)
    while i < n {
        if av[i] == needle { return true }
        i = i + 1
    }
    return false
}

// ─── main ───────────────────────────────────────────────────────────────────
fn main() {
    let selftest = has_flag("--selftest") || has_flag("--dry-run")

    let default_fixture = if selftest {
        "anima-clm-eeg/fixtures/synthetic_16ch_v1.json"
    } else {
        "anima-clm-eeg/fixtures/real_v6_clean_2026_05_03.json"
    }

    let fixture_path = env_str("CLM_EEG_FIXTURE_PATH", default_fixture)
    let p1_ledger    = env_str("CLM_EEG_REAL_P1_LEDGER", "state/clm_eeg_p1_lz_pre_register_real.json")
    let p2_ledger    = env_str("CLM_EEG_REAL_P2_LEDGER", "state/clm_eeg_p2_tlr_real.json")
    let out_path     = env_str("CLM_EEG_REAL_SMOKE_OUT", "state/clm_eeg_real_smoke_2026_05_03/verdict.json")

    println("─── clm_eeg_harness_real_smoke (raw#9 hexa-only, raw#10 honest C3) ───")
    println("  mode                   = " + (if selftest { "selftest" } else { "real" }))
    println("  fixture_path           = " + fixture_path)
    println("  p1_ledger              = " + p1_ledger)
    println("  p2_ledger              = " + p2_ledger)
    println("  out_path               = " + out_path)

    // ── load fixture ───────────────────────────────────────────────────────
    let fixture_blob = read_file(fixture_path)
    let fixture_len = len(fixture_blob)
    if fixture_len <= 0 {
        println("  FATAL: fixture not readable; INSUFFICIENT")
        println("__CLM_EEG_REAL_SMOKE__ INSUFFICIENT")
        exit(2)
    }

    // ── P3 direct compute from fixture aggregate band powers ───────────────
    // Start anchor scan at byte 1000 to skip past potential per-channel
    // UTF-8 chars in the channels[] array (real fixture has em-dash at
    // byte 918). Both canonical fixtures place the aggregate block well
    // past byte 1000 (synthetic ~2092, real ~3152).
    let agg_anchor = "\"aggregate_band_powers_x1000\""
    let theta_x1000 = extract_int_after_key_scoped_from(fixture_blob, agg_anchor, "\"theta\":", 1000)
    let gamma_x1000 = extract_int_after_key_scoped_from(fixture_blob, agg_anchor, "\"gamma\":", 1000)
    let alpha_x1000 = extract_int_after_key_scoped_from(fixture_blob, agg_anchor, "\"alpha\":", 1000)
    let beta_x1000  = extract_int_after_key_scoped_from(fixture_blob, agg_anchor, "\"beta\":", 1000)
    let delta_x1000 = extract_int_after_key_scoped_from(fixture_blob, agg_anchor, "\"delta\":", 1000)

    // gamma/theta ratio in x1000 fixed-point. Guard against theta=0.
    let mut p3_ratio_x1000 = -1
    let mut p3_pass = 0
    let mut p3_classification = "UNEVALUABLE"
    let mut p3_f1 = 0
    let mut p3_f2 = 0
    if theta_x1000 > 0 && gamma_x1000 >= 0 {
        // ratio = gamma / theta in x1000: (gamma_x1000 * 1000) / theta_x1000
        p3_ratio_x1000 = (gamma_x1000 * 1000) / theta_x1000
        // F1: gamma absent
        if gamma_x1000 < P3_F1_GAMMA_ABSENT_LT { p3_f1 = 1 }
        // F2: theta dominates pathologically (theta > 10.0 x1000)
        if theta_x1000 > P3_F2_THETA_ABSENT_GT { p3_f2 = 1 }
        // C1 loose band: ratio in [1.5, 4.5] x1000
        let c1_pass = if p3_ratio_x1000 >= P3_C1_LOOSE_LO && p3_ratio_x1000 <= P3_C1_LOOSE_HI { 1 } else { 0 }
        let no_falsifier = if p3_f1 == 0 && p3_f2 == 0 { 1 } else { 0 }
        if c1_pass == 1 && no_falsifier == 1 {
            p3_pass = 1
            p3_classification = "VERIFIED_REAL_FIXTURE"
        } else {
            p3_pass = 0
            if p3_f1 == 1 || p3_f2 == 1 {
                p3_classification = "FALSIFIER_TRIGGERED"
            } else {
                p3_classification = "OUT_OF_BAND"
            }
        }
    }

    // ── P1 from real-side ledger (LZ76 not derivable from band-powers) ─────
    let p1_blob = read_file(p1_ledger)
    let p1_len = len(p1_blob)
    let mut p1_pass = 0
    let mut p1_classification = "UNEVALUABLE_NO_LEDGER"
    if p1_len > 0 {
        // Real-side ledger key is "p1_pass" (under dry_run) per
        // state/clm_eeg_p1_lz_pre_register_real.json frozen schema
        let v = extract_int_after_key(p1_blob, "\"p1_pass\":")
        if v >= 0 {
            p1_pass = if v == 1 { 1 } else { 0 }
            p1_classification = if v == 1 { "REAL_LEDGER_PASS" } else { "REAL_LEDGER_FAIL" }
        } else {
            // Fallback: try p1_dry_run_pass
            let v2 = extract_int_after_key(p1_blob, "\"p1_dry_run_pass\":")
            if v2 >= 0 {
                p1_pass = if v2 == 1 { 1 } else { 0 }
                p1_classification = if v2 == 1 { "REAL_LEDGER_DRYRUN_PASS" } else { "REAL_LEDGER_DRYRUN_FAIL" }
            }
        }
    }

    // ── P2 from real-side ledger (ASCII-safe pre-UTF-8 region only) ────────
    let p2_blob = read_file(p2_ledger)
    let p2_len = len(p2_blob)
    let mut p2_pass = 0
    let mut p2_classification = "UNEVALUABLE_NO_LEDGER"
    // honest C3: the real-side P2 ledger contains UTF-8 multi-byte chars
    // and is multi-kB. The hexa stage1 sandboxed runtime hits SIGKILL 137
    // (OOM) when find_in_str scans past UTF-8 boundaries on multi-kB blobs.
    // We therefore READ ONLY the first ~512 bytes (ASCII-safe in all
    // canonical real ledgers) to confirm the ledger is the expected
    // real-side variant via schema_version, and surface its classification
    // as REAL_LEDGER_INSUFFICIENT_PER_2026_05_01_VERDICT (canonical contract:
    // p2_real_verdict = INSUFFICIENT, C1 PASS, C2 UNEVALUABLE).
    //
    // For byte-exact verdict pull in a future cycle, write a small ASCII-only
    // sidecar JSON next to the ledger; this harness will be retargeted at it.
    let mut p2_schema_version = -1
    if p2_len > 0 {
        // schema_version key occurs near the very top (~byte 50)
        p2_schema_version = extract_int_after_key_bounded(p2_blob, "\"schema_version\":", 512)
        if p2_schema_version == 1 {
            p2_pass = 0
            p2_classification = "REAL_LEDGER_INSUFFICIENT_PER_2026_05_01_VERDICT"
        }
        if p2_schema_version < 0 {
            p2_classification = "REAL_LEDGER_PRESENT_SCHEMA_UNRECOGNIZED"
        }
    }

    // ── Composite ──────────────────────────────────────────────────────────
    let pass_count = p1_pass + p2_pass + p3_pass
    let p1_un = find_in_str(p1_classification, "UNEVALUABLE")
    let p2_un = find_in_str(p2_classification, "UNEVALUABLE")
    let p3_un = find_in_str(p3_classification, "UNEVALUABLE")
    let any_unevaluable = if p1_un >= 0 || p2_un >= 0 || p3_un >= 0 { 1 } else { 0 }
    let mut harness_verdict = "HARNESS_FAIL"
    let mut exit_code = 1
    if pass_count >= 2 {
        harness_verdict = "HARNESS_OK"
        exit_code = 0
    }
    if pass_count < 2 {
        if any_unevaluable == 1 && pass_count == 0 {
            // Pure-no-evidence case: report INSUFFICIENT instead of FAIL.
            if p1_len <= 0 && p2_len <= 0 && p3_ratio_x1000 < 0 {
                harness_verdict = "INSUFFICIENT"
                exit_code = 2
            }
        }
    }

    // ── fingerprint ────────────────────────────────────────────────────────
    let mut fp = FNV_OFFSET_BASIS
    fp = fingerprint_step(fp, fixture_len)
    fp = fingerprint_step(fp, p1_len)
    fp = fingerprint_step(fp, p2_len)
    fp = fingerprint_step(fp, theta_x1000)
    fp = fingerprint_step(fp, gamma_x1000)
    fp = fingerprint_step(fp, p3_ratio_x1000)
    fp = fingerprint_step(fp, p1_pass)
    fp = fingerprint_step(fp, p2_pass)
    fp = fingerprint_step(fp, p3_pass)

    // ── emit cert ──────────────────────────────────────────────────────────
    let mode_str = if selftest { "selftest" } else { "real" }
    let mut cert = "{\n"
    cert = cert + "  \"tool\": \"clm_eeg_harness_real_smoke\",\n"
    cert = cert + "  \"version\": \"v1\",\n"
    cert = cert + "  \"raw_rank\": 9,\n"
    cert = cert + "  \"hexa_only\": true,\n"
    cert = cert + "  \"deterministic\": true,\n"
    cert = cert + "  \"llm\": \"none\",\n"
    cert = cert + "  \"mode\": \"" + mode_str + "\",\n"
    cert = cert + "  \"fixture_path\": \"" + fixture_path + "\",\n"
    cert = cert + "  \"fixture_bytes\": " + str(fixture_len) + ",\n"
    cert = cert + "  \"composite_rule\": \"HARNESS_OK iff (p1_pass + p2_pass + p3_pass) >= 2; UNEVALUABLE counts as 0\",\n"
    cert = cert + "  \"fixture_band_powers_x1000\": {\n"
    cert = cert + "    \"delta\": " + str(delta_x1000) + ",\n"
    cert = cert + "    \"theta\": " + str(theta_x1000) + ",\n"
    cert = cert + "    \"alpha\": " + str(alpha_x1000) + ",\n"
    cert = cert + "    \"beta\": "  + str(beta_x1000)  + ",\n"
    cert = cert + "    \"gamma\": " + str(gamma_x1000) + "\n"
    cert = cert + "  },\n"
    cert = cert + "  \"p1\": {\n"
    cert = cert + "    \"source\": \"" + p1_ledger + "\",\n"
    cert = cert + "    \"ledger_bytes\": " + str(p1_len) + ",\n"
    cert = cert + "    \"pass\": " + str(p1_pass) + ",\n"
    cert = cert + "    \"classification\": \"" + p1_classification + "\",\n"
    cert = cert + "    \"caveat\": \"LZ76 not derivable from band-power summary; sourced from real-side ledger if present\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"p2\": {\n"
    cert = cert + "    \"source\": \"" + p2_ledger + "\",\n"
    cert = cert + "    \"ledger_bytes\": " + str(p2_len) + ",\n"
    cert = cert + "    \"schema_version_observed\": " + str(p2_schema_version) + ",\n"
    cert = cert + "    \"pass\": " + str(p2_pass) + ",\n"
    cert = cert + "    \"classification\": \"" + p2_classification + "\",\n"
    cert = cert + "    \"caveat\": \"only first 512 bytes parsed (hexa stage1 OOMs scanning past UTF-8 chars in multi-kB blobs); canonical real verdict per ledger 2026-05-01 = INSUFFICIENT (C1 PASS, C2 UNEVALUABLE); for byte-exact pull write ASCII-only sidecar\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"p3\": {\n"
    cert = cert + "    \"source\": \"fixture aggregate_band_powers_x1000 (direct compute)\",\n"
    cert = cert + "    \"gamma_theta_ratio_x1000\": " + str(p3_ratio_x1000) + ",\n"
    cert = cert + "    \"C1_loose_band_x1000\": [" + str(P3_C1_LOOSE_LO) + ", " + str(P3_C1_LOOSE_HI) + "],\n"
    cert = cert + "    \"F1_gamma_absent_trigger\": " + str(p3_f1) + ",\n"
    cert = cert + "    \"F2_theta_absent_trigger\": " + str(p3_f2) + ",\n"
    cert = cert + "    \"pass\": " + str(p3_pass) + ",\n"
    cert = cert + "    \"classification\": \"" + p3_classification + "\",\n"
    cert = cert + "    \"caveat\": \"Aggregate-only proxy; no per-channel std/mean check (C2) or occipital>frontal regional check (C3) — P3 PASS here is a NECESSARY but not SUFFICIENT condition for the full P3 spec\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"composite\": {\n"
    cert = cert + "    \"pass_count\": " + str(pass_count) + ",\n"
    cert = cert + "    \"required\": 2,\n"
    cert = cert + "    \"verdict\": \"" + harness_verdict + "\",\n"
    cert = cert + "    \"chained_fingerprint\": " + str(fp) + "\n"
    cert = cert + "  },\n"
    cert = cert + "  \"honest_c3\": {\n"
    cert = cert + "    \"causally_drives_verdict\": \"P3 (gamma/theta from fixture aggregate)\",\n"
    cert = cert + "    \"sourced_from_ledger\": \"P1 (LZ76 ledger), P2 (alpha-coh+V_sync ledger)\",\n"
    cert = cert + "    \"NOT_measured\": \"P1 LZ76 from raw timeseries; P2 V_sync r live; P3 per-channel std/mean (C2); P3 occipital>frontal (C3)\",\n"
    cert = cert + "    \"dual_lock_posture\": \"this harness UNLOCKED — derivative of frozen pre-registers; will lock after raw#71 falsifier closure\",\n"
    cert = cert + "    \"tier\": \"functional_analog (N=1)\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"raw_invariants\": [9, 10, 12, 15, 71]\n"
    cert = cert + "}\n"
    write_file(out_path, cert)

    println("  fixture_bytes          = " + str(fixture_len))
    println("  p3.theta_x1000         = " + str(theta_x1000))
    println("  p3.gamma_x1000         = " + str(gamma_x1000))
    println("  p3.gamma_theta_x1000   = " + str(p3_ratio_x1000))
    println("  p3.f1_gamma_absent     = " + str(p3_f1))
    println("  p3.f2_theta_absent     = " + str(p3_f2))
    println("  p3.classification      = " + p3_classification)
    println("  p3.pass                = " + str(p3_pass))
    println("  p1.classification      = " + p1_classification)
    println("  p1.pass                = " + str(p1_pass))
    println("  p2.classification      = " + p2_classification)
    println("  p2.pass                = " + str(p2_pass))
    println("  composite.pass_count   = " + str(pass_count))
    println("  composite.required     = 2")
    println("  composite.verdict      = " + harness_verdict)
    println("  chained_fingerprint    = " + str(fp))
    println("  output                 = " + out_path)
    println("__CLM_EEG_REAL_SMOKE__ " + harness_verdict)
    exit(exit_code)
}

main()
