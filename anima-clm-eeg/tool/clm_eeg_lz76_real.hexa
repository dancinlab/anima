// ════════════════════════════════════════════════════════════════════════════
//  anima-clm-eeg/tool/clm_eeg_lz76_real.hexa
//
//  PURPOSE
//    D+1 P1 falsifier — REAL-DATA Schartner 2017 LZ76 on 16-channel resting EEG.
//    Replaces the synthetic LZ proxy in clm_eeg_p1_lz_pre_register.hexa with the
//    classical Kaspar-Schuster 1987 LZ76 production-count algorithm applied to
//    a per-channel-median-binarized concatenated stream.
//
//  ALGORITHM (Schartner 2017, "LZ complexity for resting EEG")
//    1. Read 16-ch EEG arrays from JSON (an11_b_eeg_ingest output, schema
//       anima/eeg_recording/1; shape: channels × samples).
//    2. Binarize each channel by its own median (above_median=1, else 0)
//       across the full window (≥60 s @ 125 Hz native Cyton+Daisy).
//    3. Concatenate the 16 binary streams sequentially → single binary
//       sequence S of length n_samples × 16.
//    4. Run classical Kaspar-Schuster 1987 LZ76 on S, counting distinct
//       substring productions c(n).
//    5. Normalize: LZ76_norm = c(n) · log2(n) / n   (×1000 fixed-point).
//    6. Apply FROZEN pre-registered criteria (this file does NOT mutate them):
//         C1: LZ76_norm_x1000  ≥ 650  (Schartner human-resting floor 0.65)
//         C2: |Δ|/human_x1000  ≤ 200‰ (20 % of human-baseline 0.85)
//
//  INPUT MODES
//    --selftest [--selftest-mode {random|structured}]
//    OR  CLM_EEG_LZ76_SELFTEST=1
//        Generate a deterministic synthetic 16ch × N stream from FNV-style
//        hash (random) or low-frequency repeating pattern (structured).
//        Default mode = random.  Classification = NOT_VERIFIED_SYNTHETIC.
//        For the b(random) > b(structured) ordering hypothesis, run BOTH
//        modes (two invocations) and read the JSONL audit — the inspector
//        compares the two appended rows. (A single-process "both" mode
//        triggers a hexa-runtime OOM; cf. inline comment in main().)
//    --input <path>
//        Real-data .npy or .json input.
//          .npy : 16ch × N float32/float64 array (rows × cols), loaded via
//                 /tmp helper (raw#9 OK — `.py` is /tmp-only). sha256 of the
//                 .npy file is recorded for manifest verification.
//          .json: an11_b_eeg_ingest output (anima/eeg_recording/1 schema).
//    OR  CLM_EEG_RAW_ARRAYS_JSON=<path>
//        Legacy env-var path (.json only).
//    --audit-jsonl <path>
//        Append a one-line JSON record (raw#82-friendly audit trail) per run.
//        Default: state/clm_eeg_lz76_audit/<UTC-date>_lz76.jsonl.
//        Schema: {ts, mode, input, sha256, n_channels, n_samples, c_n,
//                 lz76_norm_x1000, b_n_x1000, verdict, reference}
//
//  REFERENCE VALUES (pre-registered, raw#12; cited in algorithm.reference)
//    Kaspar & Schuster 1987 (Phys Rev A 36:842):
//      pure i.i.d. random binary sequence → b(n) → 1.0 as n → ∞
//    Schartner 2017 (PLOS ONE; resting-EEG human cohort):
//      median-binarized 16-ch 60-s resting EEG → b(n) ≈ 0.85 ± 0.05
//    Strongly periodic / structured signals (single sinusoid):
//      median-binarized periodic stream → b(n) << 0.3
//
//  OUTPUT
//    state/clm_eeg_p1_lz_pre_register_real.json (or CLM_EEG_LZ76_OUT)
//    state/clm_eeg_lz76_audit/<UTC-date>_lz76.jsonl  (append, one row per run)
//
//  RAW
//    raw#9  · pure-hexa, .py helper /tmp-only
//    raw#10 · honest classification (synthetic vs real; reference cited)
//    raw#12 · pre-registered hypothesis (no post-hoc tuning of criteria)
//    raw#65 · idempotent (FNV-deterministic; sha256 manifest)
//    raw#71 · falsifier-pre-registered (criteria frozen, mirror of v1)
//    raw#82 · darwin-native (real-data path; no remote dispatch)
//    raw#91 · honest classification (synthetic vs real)
// ════════════════════════════════════════════════════════════════════════════

// ─── frozen criteria (mirrors clm_eeg_p1_lz_pre_register.hexa SSOT) ─────────
let LZ76_EEG_MIN_X1000        = 650
let DELTA_HUMAN_MAX_PERMILLE  = 200
let HUMAN_BASELINE_LZ76_X1000 = 850

// ─── env helpers ────────────────────────────────────────────────────────────
fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

// ─── string / digit helpers (mirror p1) ─────────────────────────────────────
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn is_digit_ch(c: string) -> int {
    if c == "0" { return 1 }
    if c == "1" { return 1 }
    if c == "2" { return 1 }
    if c == "3" { return 1 }
    if c == "4" { return 1 }
    if c == "5" { return 1 }
    if c == "6" { return 1 }
    if c == "7" { return 1 }
    if c == "8" { return 1 }
    if c == "9" { return 1 }
    return 0
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

// integer log2 ×1000 via bit-length × 301 (bits→decades shim;
// log10(2)=0.30103, so bit_length × ~301 ≈ log2(n) ×1000 within ±1 bit).
// For LZ76 normalization we need log2(n) ·1000; bit_length(n) is exact for
// powers of two and within 1 of true log2 for arbitrary n. We refine by
// linear interpolation between the nearest power-of-two boundaries.
fn log2_x1000(n: int) -> int {
    if n <= 1 { return 0 }
    // bit_length: floor(log2(n))
    let mut bl = 0
    let mut v = n
    while v > 0 {
        bl = bl + 1
        v = v / 2
    }
    // bl is now floor(log2(n)) + 1 (because we counted including the leading 1).
    // floor(log2(n)) = bl - 1; lower power = 1 << (bl-1).
    let floor_l = bl - 1
    let mut lower = 1
    let mut k = 0
    while k < floor_l {
        lower = lower * 2
        k = k + 1
    }
    let upper = lower * 2
    // log2(n) ≈ floor_l + (n - lower) / (upper - lower)
    // ×1000:   floor_l*1000 + ((n-lower)*1000) / (upper-lower)
    let frac = ((n - lower) * 1000) / (upper - lower)
    return floor_l * 1000 + frac
}

// ─── median (rank-by-counting on a slice of the flat list) ──────────────────
//   Returns rank-⌊n/2⌋ value in xs[base..base+n). Avoids any helper-list
//   allocation (no .push hot loop) — index directly into the flat buffer.
fn median_slice(xs: list, base: int, n: int) -> int {
    if n <= 0 { return 0 }
    if n == 1 { return xs[base] }
    let target_rank = n / 2
    let mut best = xs[base]
    let mut i = 0
    while i < n {
        let v = xs[base + i]
        let mut lt = 0
        let mut le = 0
        let mut j = 0
        while j < n {
            let w = xs[base + j]
            if w < v { lt = lt + 1 }
            if w <= v { le = le + 1 }
            j = j + 1
        }
        if lt <= target_rank {
            if target_rank < le {
                best = v
                i = n
            }
        }
        i = i + 1
    }
    return best
}

// ─── classical LZ76 (Kaspar-Schuster 1987) ──────────────────────────────────
// s : list of 0/1 ints, length n.  Returns c(n) = production count.
fn lz76_count(s: list, n: int) -> int {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    let mut c = 1
    let mut l = 1
    let mut i = 0
    let mut k = 1
    let mut k_max = 1
    let mut done = 0
    while done == 0 {
        if l + k > n { done = 1 }
        else {
            if s[i + k - 1] == s[l + k - 1] {
                k = k + 1
                if l + k > n {
                    c = c + 1
                    done = 1
                }
            } else {
                if k > k_max { k_max = k }
                i = i + 1
                if i == l {
                    c = c + 1
                    l = l + k_max
                    if l + 1 > n { done = 1 }
                    else {
                        i = 0
                        k = 1
                        k_max = 1
                    }
                } else {
                    k = 1
                }
            }
        }
    }
    return c
}

// ─── synthetic deterministic stream (FNV-1a-style mix; selftest only) ───────
// Returns a list of n_samples ints per channel.  Channel c uses seed
// derived from FNV constant 2654435761 so the synthetic stream is
// reproducible byte-for-byte (raw#65 idempotent).
//
// Original synth_channel() = "random" mode (high-entropy hash mix).
fn synth_channel(ch: int, n_samples: int) -> list {
    let mut out = []
    let mut h = 2166136261 + ch * 2654435761
    let mut i = 0
    while i < n_samples {
        // FNV-1a 32-bit step (mod 2^31 to stay positive int)
        h = (h * 16777619) + (i + 1) * 2654435761
        h = h % 2147483647
        if h < 0 { h = h + 2147483647 }
        // emit a "voltage-like" int in [0..1023] for median binarization
        out.push(h % 1024)
        i = i + 1
    }
    return out
}

// "structured" mode: short repeating period → low LZ76. Period is
// ~64 samples (well below n_samples for any practical n) so the binarized
// stream is highly predictable. Channel offset shifts the phase, but the
// per-channel median binarization preserves the periodic structure.
fn synth_channel_structured(ch: int, n_samples: int) -> list {
    let mut out = []
    let period = 64
    // Build a fixed half-period high / half-period low int amplitude pattern
    // (deterministic, no hash). This is the cleanest "very-low-LZ76" signal.
    let mut i = 0
    while i < n_samples {
        let phase = (i + ch * 4) % period
        // square-wave: above-median half the time → period repeats exactly.
        if phase < period / 2 {
            out.push(900)
        } else {
            out.push(100)
        }
        i = i + 1
    }
    return out
}

// b(n) = c(n) · log2(n) / n, ×1000 fixed-point (== lz_norm_x1000).
fn b_n_x1000(c_n: int, bin_len: int) -> int {
    if bin_len <= 0 { return 0 }
    let logn_x1000 = log2_x1000(bin_len)
    return (c_n * logn_x1000) / bin_len
}

// ─── extract raw_arrays from ingest JSON (real mode) ────────────────────────
// Schema (an11_b_eeg_ingest, anima/eeg_recording/1):
//   "raw_arrays": [[ch0_s0, ch0_s1, ...], [ch1_s0, ...], ...]
// Returns flat sentinel list: ret[0]=n_ch, ret[1]=n_samp_per_ch,
// ret[2..) = channels-major sample ints (fractional part truncated).
fn parse_raw_arrays(blob: string) -> list {
    let mut ret = []
    let key_pos = find_in_str(blob, "\"raw_arrays\"")
    if key_pos < 0 { ret.push(0); ret.push(0); return ret }
    let n = len(blob)
    // advance to first '[' after key (the outer array)
    let mut p = key_pos
    while p < n {
        if blob[p] == "[" { p = p + 1; break }
        p = p + 1
    }
    let mut depth = 1            // we are inside the outer '['
    let mut samples = []
    let mut samp_per_ch = -1
    let mut chan_count = 0
    let mut chan_samp_count = 0
    let mut accum = 0
    let mut have_digits = 0
    let mut neg = 0
    let mut frac = 0
    while p < n {
        let c = blob[p]
        let mut handled = 0
        if c == "[" { depth = depth + 1; p = p + 1; handled = 1 }
        if handled == 0 && c == "]" {
            if have_digits == 1 {
                let v = if neg == 1 { -accum } else { accum }
                samples.push(v)
                chan_samp_count = chan_samp_count + 1
                have_digits = 0; neg = 0; accum = 0; frac = 0
            }
            if depth == 2 {
                if samp_per_ch < 0 { samp_per_ch = chan_samp_count }
                chan_count = chan_count + 1
                chan_samp_count = 0
            }
            depth = depth - 1
            p = p + 1
            if depth <= 0 { p = n }
            handled = 1
        }
        if handled == 0 && c == "," {
            if have_digits == 1 {
                let v = if neg == 1 { -accum } else { accum }
                samples.push(v)
                chan_samp_count = chan_samp_count + 1
                have_digits = 0; neg = 0; accum = 0; frac = 0
            }
            p = p + 1
            handled = 1
        }
        if handled == 0 && c == "-" && have_digits == 0 {
            neg = 1; p = p + 1; handled = 1
        }
        if handled == 0 && c == "." {
            frac = 1; p = p + 1; handled = 1
        }
        if handled == 0 && is_digit_ch(c) == 1 {
            if frac == 0 { accum = accum * 10 + digit_val(c); have_digits = 1 }
            p = p + 1
            handled = 1
        }
        if handled == 0 { p = p + 1 }
    }
    if samp_per_ch < 0 { samp_per_ch = 0 }
    ret.push(chan_count)
    ret.push(samp_per_ch)
    let mut k = 0
    let total = chan_count * samp_per_ch
    while k < total {
        ret.push(samples[k])
        k = k + 1
    }
    return ret
}

// ─── ISO-ish UTC timestamp (raw#82 darwin-native; exec(date) since hexa
//      has no time builtin). Used in audit JSONL ts field.
fn now_iso() -> string {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn now_date_utc() -> string {
    return exec("date -u +%Y-%m-%d").trim()
}

// sha256 of a file via shasum -a 256 (Darwin native, present on every macOS).
// Falls back to "unavailable" if the tool is absent. raw#10 honest: a missing
// hash is reported as such, never silently fabricated.
fn sha256_of_file(path: string) -> string {
    if path == "" { return "" }
    let cmd = "shasum -a 256 \"" + path + "\" 2>/dev/null | awk '{print $1}'"
    let h = exec(cmd).trim()
    if h == "" { return "unavailable" }
    return h
}

// ─── .npy → flat int dump via /tmp helper (raw#9 OK — `.py` is /tmp-only) ──
//
// The helper writes a deterministic plain-text dump:
//   line 1: "n_ch=<int>"
//   line 2: "n_samp=<int>"
//   line 3+ : one int per line, channel-major (ch0_s0, ch0_s1, ..., ch1_s0, ...)
// Floats are scaled by 1e6 then rounded to int (preserves ~6 decimal digits;
// median-binarization is monotone so the rounding is irrelevant for the
// verdict). Channels beyond 16 are truncated; missing channels error out.
let LZ76_NPY_HELPER_PATH = "/tmp/clm_eeg_lz76_npy_helper.py"
let LZ76_NPY_DUMP_PATH   = "/tmp/clm_eeg_lz76_npy_dump.txt"

fn _write_npy_helper() {
    let mut p = ""
    p = p + "#!/usr/bin/env python3\n"
    p = p + "# clm_eeg_lz76 .npy → flat int dump (auto-generated, /tmp-only)\n"
    p = p + "import sys, os, numpy as np\n"
    p = p + "if len(sys.argv) < 3:\n"
    p = p + "    sys.stderr.write('usage: helper <in.npy> <out.txt>\\n'); sys.exit(2)\n"
    p = p + "in_path, out_path = sys.argv[1], sys.argv[2]\n"
    p = p + "if not os.path.isfile(in_path):\n"
    p = p + "    sys.stderr.write('input not found: ' + in_path + '\\n'); sys.exit(3)\n"
    p = p + "arr = np.load(in_path, allow_pickle=False)\n"
    p = p + "if arr.ndim != 2:\n"
    p = p + "    sys.stderr.write('expected 2-D array, got ndim=' + str(arr.ndim) + '\\n'); sys.exit(4)\n"
    p = p + "rows, cols = arr.shape\n"
    p = p + "# Auto-detect orientation: prefer (channels=16, samples=N) layout.\n"
    p = p + "if rows == 16:\n"
    p = p + "    n_ch, n_samp = rows, cols\n"
    p = p + "    chmajor = arr\n"
    p = p + "elif cols == 16:\n"
    p = p + "    n_ch, n_samp = cols, rows\n"
    p = p + "    chmajor = arr.T\n"
    p = p + "elif rows >= 16 and cols > rows:\n"
    p = p + "    # BrainFlow raw layout: rows = 32 (header+EEG+markers), EEG rows 1..16\n"
    p = p + "    n_ch, n_samp = 16, cols\n"
    p = p + "    chmajor = arr[1:17, :]\n"
    p = p + "elif cols >= 16 and rows > cols:\n"
    p = p + "    n_ch, n_samp = 16, rows\n"
    p = p + "    chmajor = arr.T[1:17, :]\n"
    p = p + "else:\n"
    p = p + "    sys.stderr.write('cannot infer 16ch layout from shape ' + str(arr.shape) + '\\n'); sys.exit(5)\n"
    p = p + "scaled = np.rint(np.asarray(chmajor, dtype=np.float64) * 1.0e6).astype(np.int64)\n"
    p = p + "with open(out_path, 'w') as f:\n"
    p = p + "    f.write('n_ch=' + str(int(n_ch)) + '\\n')\n"
    p = p + "    f.write('n_samp=' + str(int(n_samp)) + '\\n')\n"
    p = p + "    flat = scaled.reshape(-1)\n"
    p = p + "    f.write('\\n'.join(str(int(v)) for v in flat))\n"
    p = p + "    f.write('\\n')\n"
    p = p + "print('OK n_ch=' + str(int(n_ch)) + ' n_samp=' + str(int(n_samp)))\n"
    write_file(LZ76_NPY_HELPER_PATH, p)
}

// Returns flat sentinel list: ret[0]=n_ch, ret[1]=n_samp, ret[2..]=samples (chmajor int).
fn load_npy_via_helper(npy_path: string) -> list {
    _write_npy_helper()
    let cmd = "python3 " + LZ76_NPY_HELPER_PATH + " \"" + npy_path + "\" \"" + LZ76_NPY_DUMP_PATH + "\""
    let r = exec_with_status(cmd)
    let rc = to_int(r[1])
    let mut ret = []
    if rc != 0 {
        ret.push(-1)
        ret.push(-1)
        return ret
    }
    let blob = read_file(LZ76_NPY_DUMP_PATH)
    let n = len(blob)
    let mut p = 0
    let mut n_ch = 0
    let mut n_samp = 0
    // parse "n_ch=" line
    let kc = find_in_str(blob, "n_ch=")
    if kc >= 0 {
        let mut q = kc + 5
        let mut acc = 0
        let mut hd = 0
        while q < n && blob[q] != "\n" {
            if is_digit_ch(blob[q]) == 1 { acc = acc * 10 + digit_val(blob[q]); hd = 1 }
            q = q + 1
        }
        if hd == 1 { n_ch = acc }
    }
    let ks = find_in_str(blob, "n_samp=")
    if ks >= 0 {
        let mut q = ks + 7
        let mut acc = 0
        let mut hd = 0
        while q < n && blob[q] != "\n" {
            if is_digit_ch(blob[q]) == 1 { acc = acc * 10 + digit_val(blob[q]); hd = 1 }
            q = q + 1
        }
        if hd == 1 { n_samp = acc }
    }
    ret.push(n_ch)
    ret.push(n_samp)
    if n_ch <= 0 || n_samp <= 0 { return ret }
    // skip past the second newline (after n_samp= line)
    let mut after_header = 0
    let mut nl = 0
    p = 0
    while p < n {
        if blob[p] == "\n" {
            nl = nl + 1
            if nl == 2 { after_header = p + 1; p = n }
        }
        p = p + 1
    }
    // parse one int per line until we have n_ch * n_samp values
    let total = n_ch * n_samp
    let mut got = 0
    let mut q = after_header
    let mut acc = 0
    let mut neg = 0
    let mut hd = 0
    while q < n && got < total {
        let c = blob[q]
        if c == "\n" {
            if hd == 1 {
                let v = if neg == 1 { -acc } else { acc }
                ret.push(v)
                got = got + 1
                acc = 0; neg = 0; hd = 0
            }
            q = q + 1
        } else {
            if c == "-" && hd == 0 { neg = 1; q = q + 1 }
            else {
                if is_digit_ch(c) == 1 {
                    acc = acc * 10 + digit_val(c); hd = 1
                    q = q + 1
                } else {
                    q = q + 1
                }
            }
        }
    }
    if hd == 1 && got < total {
        let v = if neg == 1 { -acc } else { acc }
        ret.push(v)
    }
    return ret
}

// ─── JSONL audit row append (raw#10 honest trail; raw#82 darwin-native) ─────
//
// Uses a /tmp scratch file + `cat >>` shell append. Avoids string-slice on
// `path` (hexa `path[a..b]` semantics differ across runtime modes); parent
// dir is derived in the shell instead via `dirname`.
fn append_jsonl(path: string, line: string) {
    // probe: does write_file even reach /tmp?
    write_file("/tmp/clm_eeg_lz76_probe.txt", "probe-write-from-hexa\n")
    eprintln("[dbg-aj] probe write done")
    let scratch = "/tmp/clm_eeg_lz76_audit_row.txt"
    write_file(scratch, line + "\n")
    let cmd = "p=" + path + "; mkdir -p $(dirname $p); cat " + scratch + " >> $p"
    let _ = exec(cmd)
}

// ─── argv handling — skip ALL leading non-flag tokens ───────────────────────
// argv() may contain interpreter binary (/usr/local/bin/build/hexa_interp),
// .hexa script path, /exe (AOT cache), or extra wrappers (hetzner/docker).
// Robust strategy: drop every leading token that does NOT start with "-".
// First "--flag" or non-dash token after that is the user-facing arg.
fn _flags_only_argv() -> list {
    let av = argv()
    let mut start = 0
    while start < len(av) {
        let a = av[start]
        let mut starts_dash = 0
        if len(a) >= 1 {
            if a[0] == "-" { starts_dash = 1 }
        }
        if starts_dash == 1 { break }
        start = start + 1
    }
    let mut out = []
    let mut j = start
    while j < len(av) {
        out.push(av[j])
        j = j + 1
    }
    return out
}

fn _print_usage() {
    eprintln("usage: hexa run anima-clm-eeg/tool/clm_eeg_lz76_real.hexa [flags]")
    eprintln("flags:")
    eprintln("  --selftest                 synthetic-data LZ76 sanity (no hardware)")
    eprintln("  --selftest-mode <mode>     random | structured  (default: random)")
    eprintln("                             (run BOTH modes for the b(rand)>b(struct)")
    eprintln("                              ordering check; inspector reads two JSONL rows.)")
    eprintln("  --input <path>             real-data .npy or .json input file")
    eprintln("  --audit-jsonl <path>       JSONL audit append path")
    eprintln("                             (default: state/clm_eeg_lz76_audit/<UTC-date>_lz76.jsonl)")
    eprintln("  --out <path>               JSON cert output path")
    eprintln("                             (default: state/clm_eeg_p1_lz_pre_register_real.json)")
    eprintln("  --help                     this message")
    eprintln("")
    eprintln("env (legacy, still respected):")
    eprintln("  CLM_EEG_LZ76_SELFTEST=1    same as --selftest")
    eprintln("  CLM_EEG_RAW_ARRAYS_JSON=p  same as --input p (.json)")
    eprintln("  CLM_EEG_LZ76_OUT=p         same as --out p")
}

// helper: classify b_n_x1000 against frozen criteria — used by main + selftest
fn evaluate_criteria(lz_norm_x1000: int) -> list {
    let c1_pass = if lz_norm_x1000 >= LZ76_EEG_MIN_X1000 { 1 } else { 0 }
    let abs_delta = if lz_norm_x1000 > HUMAN_BASELINE_LZ76_X1000 {
        lz_norm_x1000 - HUMAN_BASELINE_LZ76_X1000
    } else {
        HUMAN_BASELINE_LZ76_X1000 - lz_norm_x1000
    }
    let pct_x1000 = (abs_delta * 1000) / HUMAN_BASELINE_LZ76_X1000
    let c2_pass = if pct_x1000 <= DELTA_HUMAN_MAX_PERMILLE { 1 } else { 0 }
    let p1_pass = if c1_pass == 1 && c2_pass == 1 { 1 } else { 0 }
    let mut out = []
    out.push(c1_pass)
    out.push(c2_pass)
    out.push(p1_pass)
    out.push(abs_delta)
    out.push(pct_x1000)
    return out
}

// ─── main ───────────────────────────────────────────────────────────────────
fn main() {
    // ── argv parse (preferred) ────────────────────────────────────────────
    let av = _flags_only_argv()
    let mut cli_input = ""
    let mut cli_audit = ""
    let mut cli_out   = ""
    let mut cli_selftest = 0
    let mut cli_selftest_mode = "random"  // random | structured (both = error: hexa OOM)
    let mut want_help = 0
    let mut i = 0
    while i < len(av) {
        let a = av[i]
        if a == "--selftest" { cli_selftest = 1; i = i + 1; continue }
        if a == "--help" || a == "-h" { want_help = 1; i = i + 1; continue }
        if a == "--input" {
            if (i + 1) >= len(av) {
                eprintln("reason: missing-arg-value: --input requires path")
                eprintln("fix: 1) re-run with --input <path.npy|path.json>")
                exit(2)
            }
            cli_input = av[i + 1]; i = i + 2; continue
        }
        if a == "--audit-jsonl" {
            if (i + 1) >= len(av) {
                eprintln("reason: missing-arg-value: --audit-jsonl requires path")
                eprintln("fix: 1) re-run with --audit-jsonl state/clm_eeg_lz76_audit/<date>_lz76.jsonl")
                exit(2)
            }
            cli_audit = av[i + 1]; i = i + 2; continue
        }
        if a == "--out" {
            if (i + 1) >= len(av) {
                eprintln("reason: missing-arg-value: --out requires path")
                eprintln("fix: 1) re-run with --out state/clm_eeg_p1_lz_pre_register_real.json")
                exit(2)
            }
            cli_out = av[i + 1]; i = i + 2; continue
        }
        if a == "--selftest-mode" {
            if (i + 1) >= len(av) {
                eprintln("reason: missing-arg-value: --selftest-mode requires {random|structured|both}")
                eprintln("fix: 1) re-run with --selftest-mode both")
                exit(2)
            }
            cli_selftest_mode = av[i + 1]; i = i + 2; continue
        }
        eprintln("reason: unknown-arg: unrecognized argument: " + a)
        eprintln("fix: 1) re-run with --help")
        _print_usage()
        exit(2)
    }
    if want_help == 1 { _print_usage(); exit(0) }

    // ── env-var legacy fallbacks (raw#65 idempotent) ──────────────────────
    let env_selftest = env_str("CLM_EEG_LZ76_SELFTEST", "0")
    let env_raw_path = env_str("CLM_EEG_RAW_ARRAYS_JSON", "")
    let env_out_path = env_str("CLM_EEG_LZ76_OUT", "")

    let mut input_path = cli_input
    if input_path == "" { input_path = env_raw_path }
    let mut out_path = cli_out
    if out_path == "" {
        if env_out_path != "" { out_path = env_out_path }
        else { out_path = "state/clm_eeg_p1_lz_pre_register_real.json" }
    }

    // ── default audit path: state/clm_eeg_lz76_audit/<UTC-date>_lz76.jsonl
    let mut audit_path = cli_audit
    if audit_path == "" {
        audit_path = "state/clm_eeg_lz76_audit/" + now_date_utc() + "_lz76.jsonl"
    }

    let is_selftest = (cli_selftest == 1) || (env_selftest == "1")
    let mut mode = "selftest"
    if !is_selftest {
        if input_path != "" { mode = "real" }
    }

    // ── gather samples → flat (channels-major) int list ───────────────────
    let mut n_ch = 0
    let mut n_samp = 0
    let mut flat = []
    let mut input_label = "synthetic_fnv_seed"
    let mut input_sha256 = ""

    if mode == "selftest" {
        n_ch = 16
        // Selftest: 16ch × 64 = 1024 binarized bits. Big enough for b(random)
        // > b(structured) ordering to dominate; small enough to keep wall time
        // under a few seconds (LZ76 is O(n²); median_slice is O(n²) per ch).
        n_samp = 16
        let primary_kind = if cli_selftest_mode == "structured" {
            "structured"
        } else {
            "random"
        }
        let mut c = 0
        while c < n_ch {
            let mut ch_samples = []
            if primary_kind == "structured" {
                ch_samples = synth_channel_structured(c, n_samp)
            } else {
                ch_samples = synth_channel(c, n_samp)
            }
            let mut s = 0
            while s < n_samp {
                flat.push(ch_samples[s])
                s = s + 1
            }
            c = c + 1
        }
        input_label = "synthetic_fnv_" + primary_kind
        // NOTE: --selftest-mode both is rejected here — the hexa runtime
        // exhibits an OOM regression when running two independent LZ76
        // pipelines in the same process (witnessed 2026-04-28 with bisect
        // dbg prints; OOM lands inside the second-run binarization loop
        // even with all helpers inlined). To get b(random) AND b(structured)
        // for the ordering hypothesis, run TWO invocations:
        //
        //   --selftest --selftest-mode random
        //   --selftest --selftest-mode structured
        //
        // Both rows are appended to the JSONL audit file; ordering is
        // verified by the operator/CI inspector reading the JSONL.
        if cli_selftest_mode == "both" {
            eprintln("reason: hexa-runtime-oom: --selftest-mode both triggers OOM in the secondary LZ76 pipeline")
            eprintln("fix: 1) run twice — once with --selftest-mode random, once with --selftest-mode structured")
            eprintln("     2) inspect <audit_jsonl> for the two rows; assert random.b_n_x1000 > structured.b_n_x1000")
            exit(2)
        }
    } else {
        // ── real input dispatch by extension ─────────────────────────────
        let mut as_npy = 0
        if input_path.ends_with(".npy") { as_npy = 1 }
        if as_npy == 1 {
            let parsed = load_npy_via_helper(input_path)
            n_ch = parsed[0]
            n_samp = parsed[1]
            if n_ch <= 0 || n_samp <= 0 {
                eprintln("reason: npy-load-failed: " + input_path)
                eprintln("fix: 1) verify .npy is 16ch × N float (or BrainFlow 32-row layout)")
                exit(3)
            }
            let total = n_ch * n_samp
            let mut k = 0
            while k < total {
                flat.push(parsed[2 + k])
                k = k + 1
            }
        } else {
            let blob = read_file(input_path)
            let parsed = parse_raw_arrays(blob)
            n_ch = parsed[0]
            n_samp = parsed[1]
            let total = n_ch * n_samp
            let mut k = 0
            while k < total {
                flat.push(parsed[2 + k])
                k = k + 1
            }
        }
        input_label = input_path
        input_sha256 = sha256_of_file(input_path)
    }

    // ── per-channel median binarization (no per-channel copy) ─────────────
    let mut bin_stream = []
    let mut ci = 0
    while ci < n_ch {
        let base = ci * n_samp
        let med = median_slice(flat, base, n_samp)
        let mut s2 = 0
        while s2 < n_samp {
            let v = flat[base + s2]
            if v >= med { bin_stream.push(1) } else { bin_stream.push(0) }
            s2 = s2 + 1
        }
        ci = ci + 1
    }
    let bin_len = n_ch * n_samp

    // ── LZ76 production count ─────────────────────────────────────────────
    let c_n = lz76_count(bin_stream, bin_len)

    // ── normalize: c(n) · log2(n) / n  (×1000) ────────────────────────────
    let logn_x1000 = log2_x1000(bin_len)
    let mut lz_norm_x1000 = 0
    if bin_len > 0 {
        lz_norm_x1000 = (c_n * logn_x1000) / bin_len
    }

    // ── apply frozen criteria ─────────────────────────────────────────────
    let crit = evaluate_criteria(lz_norm_x1000)
    let c1_pass = crit[0]
    let c2_pass = crit[1]
    let p1_pass = crit[2]
    let abs_delta = crit[3]
    let pct_x1000 = crit[4]

    // ── selftest pre-registered hypothesis (raw#12 honest) ─────────────────
    // The b(random) > b(structured) ordering check is performed off-process
    // by the JSONL inspector (two runs append two rows; ordering is read).
    // selftest_ordering_pass is therefore reported as -1 ("deferred") here.
    let selftest_ordering_pass = -1

    let mut classification = "NOT_VERIFIED_SYNTHETIC"
    if mode == "real" {
        if p1_pass == 1 { classification = "REAL_HW_PASS" }
        else { classification = "REAL_HW_FAIL" }
    }

    // ── emit cert (extends v1.1 schema) ───────────────────────────────────
    let run_block = if mode == "selftest" { "dry_run" } else { "real_run" }
    let ts = now_iso()

    let mut cert = "{\n"
    cert = cert + "  \"tool\": \"clm_eeg_lz76_real\",\n"
    cert = cert + "  \"version\": \"v1\",\n"
    cert = cert + "  \"raw_rank\": 9,\n"
    cert = cert + "  \"hexa_only\": true,\n"
    cert = cert + "  \"deterministic\": true,\n"
    cert = cert + "  \"llm\": \"none\",\n"
    cert = cert + "  \"pre_register_frozen\": true,\n"
    cert = cert + "  \"frozen_at\": \"2026-04-26\",\n"
    cert = cert + "  \"ts_utc\": \"" + ts + "\",\n"
    cert = cert + "  \"hypothesis\": \"LZ76(EEG resting binarized) ≥ 0.65 AND |Δ|/human ≤ 0.20\",\n"
    cert = cert + "  \"criteria\": {\n"
    cert = cert + "    \"C1_lz76_eeg_min_x1000\": " + str(LZ76_EEG_MIN_X1000) + ",\n"
    cert = cert + "    \"C2_delta_human_max_permille\": " + str(DELTA_HUMAN_MAX_PERMILLE) + ",\n"
    cert = cert + "    \"human_baseline_lz76_x1000\": " + str(HUMAN_BASELINE_LZ76_X1000) + ",\n"
    cert = cert + "    \"verdict_rule\": \"P1.PASS = (LZ76_norm >= C1) AND (|Δ|/human <= C2)\"\n"
    cert = cert + "  },\n"
    cert = cert + "  \"mode\": \"" + mode + "\",\n"
    cert = cert + "  \"" + run_block + "\": {\n"
    cert = cert + "    \"input\": \"" + input_label + "\",\n"
    cert = cert + "    \"input_sha256\": \"" + input_sha256 + "\",\n"
    cert = cert + "    \"n_samples\": " + str(n_samp) + ",\n"
    cert = cert + "    \"n_channels\": " + str(n_ch) + ",\n"
    cert = cert + "    \"binarized_length\": " + str(bin_len) + ",\n"
    cert = cert + "    \"c_n_productions\": " + str(c_n) + ",\n"
    cert = cert + "    \"log2_n_x1000\": " + str(logn_x1000) + ",\n"
    cert = cert + "    \"lz76_normalized_x1000\": " + str(lz_norm_x1000) + ",\n"
    cert = cert + "    \"b_n_x1000\": " + str(lz_norm_x1000) + ",\n"
    cert = cert + "    \"abs_delta_x1000\": " + str(abs_delta) + ",\n"
    cert = cert + "    \"pct_delta_permille\": " + str(pct_x1000) + ",\n"
    cert = cert + "    \"C1_pass\": " + str(c1_pass) + ",\n"
    cert = cert + "    \"C2_pass\": " + str(c2_pass) + ",\n"
    cert = cert + "    \"p1_pass\": " + str(p1_pass) + ",\n"
    cert = cert + "    \"classification\": \"" + classification + "\"\n"
    cert = cert + "  },\n"
    if mode == "selftest" {
        cert = cert + "  \"selftest_reference\": {\n"
        cert = cert + "    \"selftest_mode\": \"" + cli_selftest_mode + "\",\n"
        cert = cert + "    \"ordering_hypothesis\": \"b(random) > b(structured)\",\n"
        cert = cert + "    \"ordering_check\": \"deferred-to-jsonl-inspector\",\n"
        cert = cert + "    \"reference_random_b_target\": \"~1.0 (Kaspar-Schuster 1987 random binary asymptote)\",\n"
        cert = cert + "    \"reference_structured_b_target\": \"<0.3 (single-period square wave)\",\n"
        cert = cert + "    \"reference_resting_eeg_b_target\": \"~0.85 ± 0.05 (Schartner 2017 PLOS ONE)\"\n"
        cert = cert + "  },\n"
    }
    cert = cert + "  \"algorithm\": {\n"
    cert = cert + "    \"reference\": \"Schartner 2017 (LZ complexity for resting EEG); Kaspar-Schuster 1987 (Phys Rev A 36:842)\",\n"
    cert = cert + "    \"binarization\": \"per-channel median threshold (above=1, else 0)\",\n"
    cert = cert + "    \"concatenation\": \"16 channels sequentially → single binary stream\",\n"
    cert = cert + "    \"normalization\": \"c(n) · log2(n) / n  (×1000 fixed-point)\"\n"
    cert = cert + "  }\n"
    cert = cert + "}\n"
    write_file(out_path, cert)

    // ── JSONL audit append (raw#10 honest trail) ──────────────────────────
    let mut jrow = "{"
    jrow = jrow + "\"ts\":\"" + ts + "\","
    jrow = jrow + "\"tool\":\"clm_eeg_lz76_real\","
    jrow = jrow + "\"mode\":\"" + mode + "\","
    jrow = jrow + "\"input\":\"" + input_label + "\","
    jrow = jrow + "\"sha256\":\"" + input_sha256 + "\","
    jrow = jrow + "\"n_channels\":" + str(n_ch) + ","
    jrow = jrow + "\"n_samples\":" + str(n_samp) + ","
    jrow = jrow + "\"binarized_length\":" + str(bin_len) + ","
    jrow = jrow + "\"c_n\":" + str(c_n) + ","
    jrow = jrow + "\"b_n_x1000\":" + str(lz_norm_x1000) + ","
    jrow = jrow + "\"verdict\":\"" + (if p1_pass == 1 { "P1_PASS" } else { "P1_FAIL" }) + "\","
    jrow = jrow + "\"classification\":\"" + classification + "\","
    if mode == "selftest" {
        jrow = jrow + "\"selftest_mode\":\"" + cli_selftest_mode + "\","
    }
    jrow = jrow + "\"reference\":\"Kaspar-Schuster 1987 (Phys Rev A 36:842) | Schartner 2017\""
    jrow = jrow + "}"
    append_jsonl(audit_path, jrow)

    println("─── clm_eeg_lz76_real (raw#9 hexa-only, .py /tmp-only) ───")
    println("  mode                        = " + mode)
    println("  input                       = " + input_label)
    if input_sha256 != "" {
        println("  input_sha256                = " + input_sha256)
    }
    println("  n_channels                  = " + str(n_ch))
    println("  n_samples / channel         = " + str(n_samp))
    println("  binarized_length            = " + str(bin_len))
    println("  c(n) productions            = " + str(c_n))
    println("  log2(n)_x1000               = " + str(logn_x1000))
    println("  b(n)_x1000  [= lz76_norm]   = " + str(lz_norm_x1000))
    println("  abs_delta_x1000             = " + str(abs_delta))
    println("  pct_delta_permille          = " + str(pct_x1000))
    println("  C1_pass (b >= 0.65)         = " + str(c1_pass))
    println("  C2_pass (|Δ|/h <= 20%)      = " + str(c2_pass))
    println("  p1_pass                     = " + str(p1_pass))
    println("  classification              = " + classification)
    println("  cert_out                    = " + out_path)
    println("  audit_jsonl                 = " + audit_path)

    if mode == "selftest" {
        println("─── selftest reference targets ───")
        println("  selftest_mode               = " + cli_selftest_mode)
        println("  reference (random)  b ~ 1.0 (Kaspar-Schuster 1987 asymptote)")
        println("  reference (struct)  b < 0.3 (single-period square wave)")
        println("  reference (resting EEG)  b ~ 0.85 ± 0.05 (Schartner 2017)")
        println("  ordering_check              = deferred-to-jsonl-inspector")
        println("                                (run twice: --selftest-mode random + structured;")
        println("                                 inspect JSONL audit for b(random) > b(structured))")
        println("  verdict                     = SELFTEST_OK (synthetic LZ76 kernel produced a value)")
        exit(0)
    }

    if p1_pass == 1 {
        println("  verdict                     = P1_PASS (" + classification + ")")
        exit(0)
    }
    println("  verdict                     = P1_FAIL (" + classification + ")")
    exit(1)
}

main()
