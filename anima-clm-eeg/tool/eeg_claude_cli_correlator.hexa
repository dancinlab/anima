// ════════════════════════════════════════════════════════════════════════════
//  anima-clm-eeg/tool/eeg_claude_cli_correlator.hexa
//
//  GENUS  (raw#106)
//    eeg-claude-cli-correlator
//
//  PURPOSE  (T1 skeleton)
//    Pure post-hoc aggregator that reads a paired (cli_msg ↔ eeg_segment)
//    JSONL file emitted by /tmp/eeg_claude_cli_helper.py and produces a
//    session-level verdict (SESSION_OK / SESSION_FAIL).
//
//    Per-pair verdict rule (raw#46 multi-metric, raw#91 high-variance honest):
//        PAIR_OK  iff  pair_axes_pass >= 4 (of 6 daily-life axes)
//
//    Session verdict rule:
//        SESSION_OK  iff  pair_ok_rate_x1000 >= 600   (i.e. >= 60%)
//
//  CONSTRAINT
//    raw#9   hexa-only           — no python, no LLM call, pure aggregator
//    raw#10  honest C3           — synthetic-only selftest, NO real paired data
//    raw#12  frozen              — re-uses daily-life axes only, raw#12 LZ76 untouched
//    raw#37  transient           — reads /tmp helper output by env var
//    raw#52  negative oracle     — empty EEG path emits SESSION_FAIL
//    raw#65  idempotent          — same input bytes → same output bytes
//    raw#71  falsifiers          — selftest exercises 7 falsifier modes
//    raw#82  darwin-native       — pure file IO, no shell-out
//    raw#91  high-variance       — supermajority (>=4 of 6), session 60% threshold
//    raw#106 genus naming        — emitted in JSON
//    NO_API                      — zero outbound HTTP, zero Anthropic SDK
//
//  USAGE
//    # 1. Helper produces /tmp/eeg_cli_paired.jsonl from CLI .jsonl + EEG CSV.
//    # 2. Run aggregator (raw#65 idempotent):
//    HEXA_RESOLVER_NO_REROUTE=1 hexa run \
//      anima-clm-eeg/tool/eeg_claude_cli_correlator.hexa --selftest
//
//  ENV
//    EEG_CLI_PAIRED_IN    paired JSONL input (default: /tmp/eeg_cli_paired.jsonl)
//    EEG_CLI_AUDIT_OUT    session output     (default: state/eeg_claude_cli_audit/2026-04-28_session.jsonl)
//    EEG_CLI_SELFTEST     "1" → use built-in 10-pair synthetic fixture
//
//  OUTPUT
//    A single-line JSON aggregate appended to EEG_CLI_AUDIT_OUT.
//    Schema:
//      {"genus":"eeg-claude-cli-correlator","raw_rank":9,
//       "deterministic":true,"hexa_only":true,"llm":"none","api":"none",
//       "n_pairs":N,"pair_ok_count":K,"pair_ok_rate_x1000":...,
//       "session_verdict":"SESSION_OK|SESSION_FAIL",
//       "selftest":bool, "fingerprint":<int>}
// ════════════════════════════════════════════════════════════════════════════

let M32 = 4294967296
let FNV_PRIME = 16777619
let FNV_OFFSET_BASIS = 2166136261

// ─── env helpers ────────────────────────────────────────────────────────────
fn env_str(key: string, default_val: string) -> string {
    let s = env(key)
    if s == "" { return default_val }
    return s
}

// ─── FNV-1a (modular, byte-identical) ───────────────────────────────────────
fn fnv_step(h: int, byte: int) -> int {
    let mut x = (h + byte) % M32
    if x < 0 { x = x + M32 }
    x = (x * FNV_PRIME) % M32
    if x < 0 { x = x + M32 }
    return x
}

fn fp_int(fp: int, val: int) -> int {
    let mut h = fp
    h = fnv_step(h, val % 256)
    h = fnv_step(h, (val / 256) % 256)
    h = fnv_step(h, (val / 65536) % 256)
    h = fnv_step(h, (val / 16777216) % 256)
    return h
}

// ─── string scan: find needle, extract trailing integer ─────────────────────
fn find_in_str(s: string, needle: string) -> int {
    let n = len(s)
    let m = len(needle)
    if m <= 0 { return 0 }
    if n < m { return -1 }
    let mut i = 0
    while i <= n - m {
        let mut j = 0
        let mut ok = 1
        while j < m {
            if s[i + j] != needle[j] {
                ok = 0
                j = m
            }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn digit_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return -1
}

fn is_digit(c: string) -> int {
    if digit_val(c) >= 0 { return 1 }
    return 0
}

// extract integer immediately after `key` (e.g. `"pair_axes_pass":4`)
fn extract_int_after(s: string, key: string) -> int {
    let pos = find_in_str(s, key)
    if pos < 0 { return -1 }
    let mut i = pos + len(key)
    let n = len(s)
    // advance past non-digits
    while i < n && is_digit(s[i]) == 0 {
        i = i + 1
    }
    if i >= n { return -1 }
    // accumulate digits
    let mut acc = 0
    let mut any = 0
    while i < n && is_digit(s[i]) == 1 {
        acc = acc * 10 + digit_val(s[i])
        any = 1
        i = i + 1
    }
    if any == 0 { return -1 }
    return acc
}

// count line-occurrences of needle (cheap newline scan)
fn count_lines(s: string) -> int {
    let n = len(s)
    let mut k = 0
    let mut i = 0
    while i < n {
        if s[i] == "\n" { k = k + 1 }
        i = i + 1
    }
    if n > 0 && s[n - 1] != "\n" { k = k + 1 }
    return k
}

// extract pair_axes_pass from each line; return (n_pairs, pair_ok_count, fp)
fn aggregate_jsonl(text: string) -> [int] {
    let n = len(text)
    let mut start = 0
    let mut i = 0
    let mut n_pairs = 0
    let mut ok_count = 0
    let mut fp = FNV_OFFSET_BASIS
    while i <= n {
        if i == n || text[i] == "\n" {
            if i > start {
                // slice out [start, i)
                let mut line = ""
                let mut k = start
                while k < i { line = line + text[k]; k = k + 1 }
                let axes = extract_int_after(line, "\"pair_axes_pass\":")
                if axes >= 0 {
                    n_pairs = n_pairs + 1
                    if axes >= 4 { ok_count = ok_count + 1 }
                    fp = fp_int(fp, axes)
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    return [n_pairs, ok_count, fp]
}

// ─── built-in synthetic 10-pair selftest (raw#10 honest C3 — NOT real EEG) ──
// Each row encodes pair_axes_pass; 7 of 10 pass (>=4) → pair_ok_rate = 700/1000.
fn synthetic_paired_jsonl() -> string {
    let mut s = ""
    let axes = [5, 4, 3, 6, 4, 2, 5, 4, 1, 6]   // 7 of 10 >= 4
    let mut i = 0
    while i < 10 {
        s = s + "{\"pair_idx\":" + str(i)
        s = s + ",\"synthetic\":true,\"pair_axes_pass\":" + str(axes[i])
        s = s + ",\"pair_verdict\":\""
        if axes[i] >= 4 { s = s + "PAIR_OK" } else { s = s + "PAIR_FAIL" }
        s = s + "\"}\n"
        i = i + 1
    }
    return s
}

// ─── falsifier exercises (raw#71) ───────────────────────────────────────────
// Returns 1 if all 7 falsifiers behave as expected on the synthetic fixture.
fn run_falsifiers() -> int {
    // F1: empty input → 0 pairs, SESSION_FAIL
    let r1 = aggregate_jsonl("")
    let f1 = if r1[0] == 0 { 1 } else { 0 }

    // F2: all-fail input → 0% ok_rate
    let mut allf = ""
    let mut i = 0
    while i < 5 { allf = allf + "{\"pair_axes_pass\":1}\n"; i = i + 1 }
    let r2 = aggregate_jsonl(allf)
    let f2 = if r2[1] == 0 && r2[0] == 5 { 1 } else { 0 }

    // F3: all-pass → 100% ok_rate
    let mut allp = ""
    i = 0
    while i < 5 { allp = allp + "{\"pair_axes_pass\":6}\n"; i = i + 1 }
    let r3 = aggregate_jsonl(allp)
    let f3 = if r3[1] == 5 && r3[0] == 5 { 1 } else { 0 }

    // F4: degenerate (single line) → n=1
    let r4 = aggregate_jsonl("{\"pair_axes_pass\":4}\n")
    let f4 = if r4[0] == 1 && r4[1] == 1 { 1 } else { 0 }

    // F5: malformed line (no pair_axes_pass) → ignored
    let r5 = aggregate_jsonl("{\"foo\":42}\n{\"pair_axes_pass\":5}\n")
    let f5 = if r5[0] == 1 && r5[1] == 1 { 1 } else { 0 }

    // F6: boundary (axes=4 → PAIR_OK; axes=3 → PAIR_FAIL)
    let r6 = aggregate_jsonl("{\"pair_axes_pass\":4}\n{\"pair_axes_pass\":3}\n")
    let f6 = if r6[0] == 2 && r6[1] == 1 { 1 } else { 0 }

    // F7: idempotency — same input twice → same fingerprint
    let r7a = aggregate_jsonl(synthetic_paired_jsonl())
    let r7b = aggregate_jsonl(synthetic_paired_jsonl())
    let f7 = if r7a[2] == r7b[2] && r7a[0] == r7b[0] && r7a[1] == r7b[1] { 1 } else { 0 }

    let total = f1 + f2 + f3 + f4 + f5 + f6 + f7
    println("  falsifier_F1_empty      = " + str(f1))
    println("  falsifier_F2_allfail    = " + str(f2))
    println("  falsifier_F3_allpass    = " + str(f3))
    println("  falsifier_F4_singleton  = " + str(f4))
    println("  falsifier_F5_malformed  = " + str(f5))
    println("  falsifier_F6_boundary   = " + str(f6))
    println("  falsifier_F7_idempotent = " + str(f7))
    println("  falsifiers_total        = " + str(total) + " / 7")
    if total == 7 { return 1 }
    return 0
}

// ─── main ───────────────────────────────────────────────────────────────────
fn main() {
    let in_path  = env_str("EEG_CLI_PAIRED_IN", "/tmp/eeg_cli_paired.jsonl")
    let out_path = env_str("EEG_CLI_AUDIT_OUT",
        "state/eeg_claude_cli_audit/2026-04-28_session.jsonl")
    let selftest = env_str("EEG_CLI_SELFTEST", "1")    // default-on for skeleton

    println("─── eeg_claude_cli_correlator (raw#9 hexa-only · NO_API) ───")
    println("  genus       = eeg-claude-cli-correlator")
    println("  in_path     = " + in_path)
    println("  out_path    = " + out_path)
    println("  selftest    = " + selftest)

    // Run falsifier battery first (raw#71)
    println("─── falsifier battery (raw#71 ≥ 5) ───")
    let f_ok = run_falsifiers()

    // Aggregate (synthetic if selftest, else read file)
    let mut text = ""
    let mut is_synth = 0
    if selftest == "1" {
        text = synthetic_paired_jsonl()
        is_synth = 1
    } else {
        text = read_file(in_path)
    }

    let r = aggregate_jsonl(text)
    let n_pairs = r[0]
    let ok_count = r[1]
    let fp = r[2]
    let mut rate_x1000 = 0
    if n_pairs > 0 { rate_x1000 = (ok_count * 1000) / n_pairs }

    // Session verdict (raw#91 60% threshold)
    let mut verdict = "SESSION_FAIL"
    if rate_x1000 >= 600 && n_pairs > 0 { verdict = "SESSION_OK" }

    // Emit
    let mut row = "{\"genus\":\"eeg-claude-cli-correlator\""
    row = row + ",\"raw_rank\":9"
    row = row + ",\"deterministic\":true"
    row = row + ",\"hexa_only\":true"
    row = row + ",\"llm\":\"none\""
    row = row + ",\"api\":\"none\""
    row = row + ",\"selftest\":" + (if is_synth == 1 { "true" } else { "false" })
    row = row + ",\"n_pairs\":" + str(n_pairs)
    row = row + ",\"pair_ok_count\":" + str(ok_count)
    row = row + ",\"pair_ok_rate_x1000\":" + str(rate_x1000)
    row = row + ",\"session_verdict\":\"" + verdict + "\""
    row = row + ",\"falsifiers_total\":7"
    row = row + ",\"falsifiers_pass\":" + str(if f_ok == 1 { 7 } else { 0 })
    row = row + ",\"fingerprint\":" + str(fp)
    row = row + "}\n"

    write_file(out_path, row)

    println("─── verdict ───")
    println("  n_pairs           = " + str(n_pairs))
    println("  pair_ok_count     = " + str(ok_count))
    println("  pair_ok_rate_x1k  = " + str(rate_x1000) + " / 1000")
    println("  session_verdict   = " + verdict)
    println("  falsifiers_pass   = " + str(if f_ok == 1 { 7 } else { 0 }) + " / 7")
    println("  fingerprint       = " + str(fp))
    println("  output            = " + out_path)

    // Exit gate (own 5 completeness-first):
    //   selftest must produce SESSION_OK AND all 7 falsifiers pass
    let pass = if is_synth == 1 && verdict == "SESSION_OK" && f_ok == 1 { 1 }
               else if is_synth == 0 && f_ok == 1 { 1 }
               else { 0 }
    if pass == 1 {
        println("  selftest_verdict  = SELFTEST_OK")
        exit(0)
    }
    println("  selftest_verdict  = SELFTEST_FAIL")
    exit(1)
}

main()
