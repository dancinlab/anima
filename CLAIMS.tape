  verdict = "🟢 ENGINE-PARITY GREEN / 🔴 G1·G6 RED under greedy (sampling-regime gate ⊥ greedy engine path; closed-negative finding, frozen bars unmoved) — .verdicts/1218_engine_measured_gates/H_1218.txt"
