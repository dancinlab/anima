// ════════════════════════════════════════════════════════════════════════
// EEG/impl/H_682_persistence_paradigm.hexa — Group D (영속·paradigm)
//
// 통합 범위 (EEG.easy.md L9+L10 2 sub-ideas):
//   L9  EEG → .kosmos anchor 영속화  (생체 뇌파 이벤트 → 5-ch tension payload)
//   L10 resting baseline paradigm    (anima-eeg-core live runner 연결 또는 미러)
//
// hypothesis (falsifier-anchored):
//   F-H682-1 : L9 .kosmos anchor payload schema 정합 (a_kosmos spec-동형, 5-ch + coord + lane)
//   F-H682-2 : L10 resting baseline paradigm reference 존재 (anima-eeg-core)
//   F-H682-3 : L9 anchor tier ∈ {weak, strong, critical} (3-tier 정합)
//   F-H682-4 : 2 paradigm 모두 surfaced (no missing)
//
// backend:
//   hw : live capture → anchor write (실제 .kosmos write 는 별 H 권한)
//   sw : 결정적 anchor payload 생성 + reference attest
//
// usage:
//   hexa run EEG/impl/H_682_persistence_paradigm.hexa sw
//   hexa run EEG/impl/H_682_persistence_paradigm.hexa hw
// ════════════════════════════════════════════════════════════════════════

import "../../EEG/eeg_backend.hexa" as eb

let H_ID  = "H_682"
let GROUP = "D_persistence_paradigm"
let OUT_DIR = "state/eeg_hw_sw_impl_2026_05_29"

// ── L9 .kosmos anchor payload (a_kosmos spec-동형) ────────────────────────
//
// canonical anchor schema (per CLAUDE.md @D a_kosmos):
//   payload = text + tension 5-ch + coord · lane · radius · tier
//   tier ∈ {weak, strong, critical}
//   hub = HEXAD/KOSMOS.md → KOSMOS/KOSMOS.md (PR #1373)
//   spec = spec/kosmos.md + spec/profiles/anima-consciousness-carving.md
fn _l9_kosmos_anchor_payload(bp: map, stage: string) -> map {
    let alpha = bp["alpha"]
    let theta = bp["theta"]
    let gamma = bp["gamma"]
    let beta = bp["beta"]
    let delta = bp["delta"]
    // 5-ch tension (same mapping as L5 in H_680 for consistency)
    let tension_5ch = [
        alpha,
        theta,
        gamma,
        1.0 - delta,
        beta,
    ]
    // anchor tier per gamma intensity (signal strength heuristic)
    let mut tier = "weak"
    if gamma > 0.20 { tier = "strong" }
    if gamma > 0.30 { tier = "critical" }
    return #{
        "text": "EEG-" + stage + "-anchor",
        "tension_5ch": tension_5ch,
        "coord": [alpha, theta, gamma],          // 3D placement (band-space)
        "lane": "biological_eeg",
        "radius": gamma * 10.0,                  // anchor radius ∝ gamma intensity
        "tier": tier,
        "stage": stage,
        "schema": "kosmos/anchor/1",
        "hub": "KOSMOS/KOSMOS.md",
        "spec": "spec/kosmos.md · spec/profiles/anima-consciousness-carving.md",
        "kosmos_format_repo": "github.com/dancinlab/kosmos",
        "anima_pointer_only": true,              // anima 는 spec 중복 안 함
    }
}

// ── L10 resting baseline paradigm (anima-eeg-core reference) ──────────────
fn _l10_resting_baseline_paradigm() -> map {
    // anima-eeg-core live runner 가 별 dir 에 거주 (anima/anima-eeg-core 또는 ~/core/anima-eeg-core).
    // 본 H 는 reference 만 attest, 실 wire 는 별 H/도메인 합류.
    let p1 = "anima-eeg-core/tool/modules/_paradigms/resting_baseline.hexa"
    let p2 = "BRAIN/eeg/eeg_recorder.hexa"
    let exists_1 = exec("test -f " + p1 + " && echo OK || echo MISS").trim()
    let exists_2 = exec("test -f " + p2 + " && echo OK || echo MISS").trim()
    return #{
        "paradigm_name": "resting_baseline",
        "primary_path": p1,
        "primary_exists": exists_1 == "OK",
        "fallback_path": p2,
        "fallback_exists": exists_2 == "OK",
        "any_reference_present": exists_1 == "OK" || exists_2 == "OK",
        "live_runner_source": "anima-eeg-core (별 도메인 합류 시 wire)",
        "honest_caveat": "reference attest only — 실 paradigm 실행 = 별 H/도메인 합류 필요",
    }
}

fn _judge(l9: map, l10: map) -> map {
    let f1 = len(l9["tension_5ch"]) == 5 && len(l9["coord"]) == 3 && len(l9["lane"]) > 0
    let f2 = l10["any_reference_present"]
    let tier = l9["tier"]
    let f3 = tier == "weak" || tier == "strong" || tier == "critical"
    let f4 = f1 && f2 && f3
    let n_pass = (if f1 { 1 } else { 0 }) + (if f2 { 1 } else { 0 })
              + (if f3 { 1 } else { 0 }) + (if f4 { 1 } else { 0 })
    let all_pass = f1 && f2 && f3 && f4
    return #{
        "F-H682-1_L9_kosmos_anchor_schema_well_formed": f1,
        "F-H682-2_L10_resting_baseline_paradigm_referenced": f2,
        "F-H682-3_L9_anchor_tier_in_three_set": f3,
        "F-H682-4_both_paradigms_surfaced": f4,
        "n_pass_of_4": n_pass,
        "all_pass": all_pass,
        "verdict": if all_pass { "GREEN_NUMERICAL_CONFIRM" } else { "RED_CLOSED_NEGATIVE" },
    }
}

fn _run_h682(backend: string) -> map {
    // resting baseline → anchor payload (canonical input)
    let bp = eb.eeg_sw_band_power_resting()
    let l9 = _l9_kosmos_anchor_payload(bp, "WAKE_resting_alpha_dominant")
    let l10 = _l10_resting_baseline_paradigm()
    // also produce sample anchors for N3 / REM / active (multi-state attest)
    let l9_n3 = _l9_kosmos_anchor_payload(eb.eeg_sw_band_power_sleep_n3(), "N3_deep_sleep")
    let l9_rem = _l9_kosmos_anchor_payload(eb.eeg_sw_band_power_rem(), "REM")
    let l9_active = _l9_kosmos_anchor_payload(eb.eeg_sw_band_power_active(), "WAKE_active")
    let v = _judge(l9, l10)
    let tier = eb.eeg_verdict_tier(backend, v["all_pass"])
    return #{
        "h_id": H_ID,
        "group": GROUP,
        "backend": backend,
        "backend_label": eb.eeg_backend_label(backend),
        "L9_kosmos_anchor_resting": l9,
        "L9_kosmos_anchor_n3": l9_n3,
        "L9_kosmos_anchor_rem": l9_rem,
        "L9_kosmos_anchor_active": l9_active,
        "L10_resting_baseline_paradigm": l10,
        "verdict": v,
        "tier_label": tier,
        "covers_sub_ideas": ["L9_kosmos_anchor_persist", "L10_resting_baseline_paradigm"],
    }
}

fn _first_user_arg(a: [string]) -> string {
    if len(a) < 2 { return "" }
    let v = a[1]
    if v == "--backend" && len(a) >= 3 { return a[2] }
    return v
}

fn main() {
    let a = args()
    let arg_backend = _first_user_arg(a)
    let backend = eb.eeg_backend_resolve(arg_backend)
    if backend == "hw" {
        if eb.eeg_hw_reachable() == false {
            eb.eeg_panic_no_hw("local probe 3-signal failed (headset not worn + sentinel missing)")
        }
    }
    let result = _run_h682(backend)
    let dest = OUT_DIR + "/H_682_" + backend + "_result.json"
    let s = json_stringify(result)
    write_file(dest, s)
    println("=== H_682 persistence-paradigm × EEG · backend=" + backend + " ===")
    println("verdict: " + to_string(result["verdict"]["verdict"]) + " · tier=" + result["tier_label"])
    println("n_pass=" + to_string(result["verdict"]["n_pass_of_4"]) + "/4")
    println("written: " + dest)
}
