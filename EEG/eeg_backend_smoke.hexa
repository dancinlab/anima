// ════════════════════════════════════════════════════════════════════════
// EEG/eeg_backend_smoke.hexa — backend switch self-test
//
// 검증 cases (all $0):
//   case 1 : arg("hw")   → "hw"
//   case 2 : arg("sw")   → "sw"
//   case 3 : arg("live") → "hw"  (alias)
//   case 4 : arg("auto") + EEG_BACKEND unset → "sw" (default · AKIDA 와 반대)
//   case 5 : probe signals returns 3-signal map shape
//   case 6 : backend label strings
//   case 7 : verdict tier strings
//   case 8 : sw mock coupled / indep arrays correct length
//   case 9 : baseline phi values 1.59 / 0.44
//   case 10: band power resting/N3/REM/active sum ≈ 1.0
//
// usage:
//   hexa run EEG/eeg_backend_smoke.hexa
// ════════════════════════════════════════════════════════════════════════

import "../EEG/eeg_backend.hexa" as eb

fn _assert(label: string, want: string, got: string) -> bool {
    if want == got {
        println("PASS  " + label + " want=" + want + " got=" + got)
        return true
    }
    println("FAIL  " + label + " want=" + want + " got=" + got)
    return false
}

fn _abs(x: float) -> float {
    if x < 0.0 { return -x }
    return x
}

fn _band_sum(m: map) -> float {
    return m["delta"] + m["theta"] + m["alpha"] + m["beta"] + m["gamma"]
}

fn main() {
    let mut n_pass = 0
    let mut n_fail = 0

    // case 1 : arg "hw"
    let r1 = eb.eeg_backend_resolve("hw")
    if _assert("case_1_arg_hw", "hw", r1) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 2 : arg "sw"
    let r2 = eb.eeg_backend_resolve("sw")
    if _assert("case_2_arg_sw", "sw", r2) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 3 : arg "live" alias → "hw"
    let r3 = eb.eeg_backend_resolve("live")
    if _assert("case_3_live_alias_hw", "hw", r3) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 4 : arg "auto" + env unset → default "sw"
    //   NOTE: this test assumes EEG_BACKEND is NOT set in the smoke env.
    //         caller can verify by `unset EEG_BACKEND ; hexa run ...`.
    let r4 = eb.eeg_backend_resolve("auto")
    if _assert("case_4_auto_default_sw", "sw", r4) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 5 : probe signals (Mac dev box → most likely no headset → all_pass=false)
    let probe = eb.eeg_hw_probe_signals()
    println("INFO  hw_probe_signals: brainflow=" + probe["signal_1_brainflow_pkg"]
        + " capture_dir=" + probe["signal_2_capture_dir"]
        + " sentinel=" + probe["signal_3_user_sentinel"]
        + " all_pass=" + to_string(probe["all_pass"]))
    n_pass = n_pass + 1

    // case 6 : backend label
    let lbl_hw = eb.eeg_backend_label("hw")
    let lbl_sw = eb.eeg_backend_label("sw")
    println("INFO  hw_label=" + lbl_hw)
    println("INFO  sw_label=" + lbl_sw)
    if _assert("case_6_hw_label",
               "EEG biological live (OpenBCI/brainflow HW, headset-worn)",
               lbl_hw) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 7 : verdict tier
    let v_sw = eb.eeg_verdict_tier("sw", true)
    if _assert("case_7_sw_tier", "🟢 numerical (synthetic-replay)", v_sw) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    let v_hw = eb.eeg_verdict_tier("hw", true)
    if _assert("case_7b_hw_tier", "🟢 numerical (biological-confirmed)", v_hw) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    let v_fail = eb.eeg_verdict_tier("hw", false)
    if _assert("case_7c_red_neg", "🔴 closed-negative", v_fail) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 8 : sw mock synthetic generators
    let coupled = eb.eeg_sw_mock_coupled(64)
    let indep = eb.eeg_sw_mock_indep(64)
    let cl = to_string(len(coupled))
    let il = to_string(len(indep))
    if _assert("case_8_coupled_len_128", "128", cl) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert("case_8b_indep_len_128", "128", il) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 9 : baseline phi values
    let bc = eb.eeg_sw_baseline_coupled_phi()
    let bi = eb.eeg_sw_baseline_indep_phi()
    if _assert("case_9_baseline_coupled_159", "1.59", to_string(bc)) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }
    if _assert("case_9b_baseline_indep_044", "0.44", to_string(bi)) { n_pass = n_pass + 1 } else { n_fail = n_fail + 1 }

    // case 10 : band power maps sum to ~1.0
    let bp_rest = eb.eeg_sw_band_power_resting()
    let bp_n3 = eb.eeg_sw_band_power_sleep_n3()
    let bp_rem = eb.eeg_sw_band_power_rem()
    let bp_act = eb.eeg_sw_band_power_active()
    let sums = [_band_sum(bp_rest), _band_sum(bp_n3), _band_sum(bp_rem), _band_sum(bp_act)]
    let mut all_one = true
    let mut i = 0
    while i < len(sums) {
        if _abs(sums[i] - 1.0) > 0.001 { all_one = false }
        i = i + 1
    }
    if all_one {
        println("PASS  case_10_band_power_sum_to_1: 4/4 maps sum to ~1.0")
        n_pass = n_pass + 1
    } else {
        println("FAIL  case_10_band_power_sum_to_1: at least one map drifted")
        n_fail = n_fail + 1
    }

    println("--- backend smoke summary: " + to_string(n_pass) + " pass / " + to_string(n_fail) + " fail ---")
    if n_fail > 0 { exit(1) }
}
