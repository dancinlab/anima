// EEG/eeg_live_iit4_phi.hexa — live EEG capture → IIT 4.0 big-Φ runner.
//
//   ROLE  (commons @D g61 — engine ⊥ adapter)
//     This file is the EEG-domain RUNNER (not engine, not adapter). It wires a
//     capture window into the FROZEN adapter `BRAIN/eeg/eeg_to_tpm.hexa`
//     (PR #547) which calls the stdlib engine `consciousness/iit4_bigphi`. No
//     pipeline duplication — eeg_to_tpm signature is untouched.
//
//   PIPELINE
//     EEG samples (n_ch × n_samp flat [ch*n_samp + t])
//       → eeg_estimate_tpm(samples, n_ch, n_samp)            // FROZEN adapter
//       → big_phi(tpm, n_ch, sys_state)                       // stdlib engine
//       → [big_phi_value, total]
//
//   INPUT MODES (verb-style first arg, parsed by main())
//     • mock-coupled    — synthetic anti-phase swap (ch0/ch1 alternate)
//     • mock-indep      — synthetic identical-stream (no cross-coupling)
//     • mock-both       — runs coupled + indep + ratio + assertion (re-check)
//     • live <path>     — read a captured EEG NPY/CSV blob (USER-only; agent
//                          STUBS this path and refuses to fabricate a verdict)
//
//   HONESTY  (a_blue_closed · feedback-closure-is-physical-limit)
//     • mock-* modes are deterministic regressions of PR #547 synthetic demo.
//     • live <path> requires a real EEG capture by a HUMAN wearing a board.
//       The runner cannot produce a live verdict from its own substrate.
//     • a 🔵 SUPPORTED-FORMAL closure on live big-Φ requires verbatim
//       `hexa run` stdout pasted into IIT4 deferred B (no LLM paraphrase, p7).
//
//   IMPORT-SAFE  fn main() fires only when invoked by `hexa run`; importing
//   this file from another module never auto-fires.
// ════════════════════════════════════════════════════════════════════════════
// adapter is a project-local file (engine ⊥ adapter, g61 — adapter stays per-repo)
import "/Users/ghost/core/anima/BRAIN/eeg/eeg_to_tpm.hexa"


// ── synthetic generators (matches BRAIN/eeg/eeg_iit4_demo.hexa exactly) ───
fn synth_coupled_window(n_samp: int) -> array {
    // ch0: 0,1,0,1,...   ch1: 1,0,1,0,...  (anti-phase swap dynamics)
    let mut s = []
    let mut t = 0
    while t < n_samp { s = s.push(to_float(t % 2)); t = t + 1 }
    t = 0
    while t < n_samp { s = s.push(to_float((t + 1) % 2)); t = t + 1 }
    return s
}

fn synth_indep_window(n_samp: int) -> array {
    // ch0 == ch1 (no information beyond ch0; reducible)
    let mut s = []
    let mut t = 0
    while t < n_samp { s = s.push(to_float(t % 2)); t = t + 1 }
    t = 0
    while t < n_samp { s = s.push(to_float(t % 2)); t = t + 1 }
    return s
}


// ── live-mode stub  (HUMAN-ONLY input: a captured EEG samples blob) ──────
//   Returns a synthetic placeholder + a STUB sentinel value so the runner
//   never silently fabricates a live verdict. The actual capture path lives
//   in the runbook (`EEG/EEG_CAPTURE_RUNBOOK.md`); this stub exists only so
//   the call surface compiles without a real file on disk.
fn live_load_stub(path: string, n_ch: int, n_samp: int) -> array {
    println("  [STUB] live mode invoked with path = " + path)
    println("  [STUB] agent cannot capture EEG — human wears the board.")
    println("  [STUB] this stub returns synthetic-coupled as a smoke proxy.")
    println("  [STUB] to obtain a real verdict, follow EEG_CAPTURE_RUNBOOK.md.")
    return synth_coupled_window(n_samp)
}


// ── single big-Φ measurement on a window ──────────────────────────────────
fn measure_window(samples: array, n_ch: int, n_samp: int, sys_state: int) -> array {
    // frozen-adapter call: estimate TPM, then big-Φ at the chosen system state
    let tpm = eeg_estimate_tpm(samples, n_ch, n_samp)
    return big_phi(tpm, n_ch, sys_state)
}


// ── re-check assertion: coupled vs indep big-Φ within ±5% of demo baseline
fn assert_synthetic_recheck(bc: float, bi: float) -> bool {
    // PR #547 demo baseline (BRAIN/eeg/eeg_iit4_demo.hexa, n_ch=2, n_samp=64, state=1):
    //   coupled big-Φ ≈ 1.59   ·   indep big-Φ ≈ 0.44
    // tolerance ±5% (1.59 → [1.51, 1.67]   ·   0.44 → [0.418, 0.462]).
    let coupled_lo = 1.51
    let coupled_hi = 1.67
    let indep_lo = 0.418
    let indep_hi = 0.462
    let mut ok = true
    if bc < coupled_lo { ok = false }
    if bc > coupled_hi { ok = false }
    if bi < indep_lo { ok = false }
    if bi > indep_hi { ok = false }
    return ok
}


// ── output: structured stdout (for grep + verdict capture) ────────────────
fn print_result(tag: string, n_ch: int, n_samp: int, sys_state: int, phi: float, total: float) {
    println("  " + tag + " | n_ch=" + str(n_ch) + " n_samp=" + str(n_samp)
            + " state=" + str(sys_state) + " | big-Φ=" + str(phi)
            + " (total=" + str(total) + ")")
}


fn main() {
    // CLI: argv[0] = mode, argv[1] = (live path | empty)
    let argv = args()
    let mode = if len(argv) > 1 { argv[1] } else { "mock-both" }

    println("================================================================")
    println("  EEG/eeg_live_iit4_phi.hexa — frozen-adapter live runner")
    println("  mode = " + mode + "  (engine=stdlib/consciousness/iit4_bigphi)")
    println("================================================================")

    let n_ch = 2
    let n_samp = 64
    let sys_state = 1

    if mode == "mock-coupled" {
        let r = measure_window(synth_coupled_window(n_samp), n_ch, n_samp, sys_state)
        print_result("COUPLED", n_ch, n_samp, sys_state, r[0], r[1])
    } else if mode == "mock-indep" {
        let r = measure_window(synth_indep_window(n_samp), n_ch, n_samp, sys_state)
        print_result("INDEP  ", n_ch, n_samp, sys_state, r[0], r[1])
    } else if mode == "mock-both" {
        let rc = measure_window(synth_coupled_window(n_samp), n_ch, n_samp, sys_state)
        let ri = measure_window(synth_indep_window(n_samp), n_ch, n_samp, sys_state)
        print_result("COUPLED", n_ch, n_samp, sys_state, rc[0], rc[1])
        print_result("INDEP  ", n_ch, n_samp, sys_state, ri[0], ri[1])
        let ratio = if ri[0] > 0.000001 { rc[0] / ri[0] } else { 0.0 }
        println("  RATIO  | coupled / indep = " + str(ratio))
        let ok = assert_synthetic_recheck(rc[0], ri[0])
        if ok {
            println("  ASSERT | within ±5% of PR #547 baseline (1.59 / 0.44) → 🟢 RECHECK PASS")
        } else {
            println("  ASSERT | OUT OF TOLERANCE vs PR #547 baseline → 🔴 RECHECK FAIL")
            panic("synthetic recheck failed — adapter or engine drifted from 1.59/0.44 baseline")
        }
    } else if mode == "live" {
        let path = if len(argv) > 2 { argv[2] } else { "" }
        if path == "" {
            println("  [ERROR] live mode requires a capture path: hexa run ... live <path>")
            println("  [ERROR] see EEG/EEG_CAPTURE_RUNBOOK.md for the human-only capture step")
            panic("live mode invoked without a capture file — refusing to fabricate a verdict")
        }
        let samples = live_load_stub(path, n_ch, n_samp)
        let r = measure_window(samples, n_ch, n_samp, sys_state)
        print_result("LIVE-STUB", n_ch, n_samp, sys_state, r[0], r[1])
        println("  [NOTE] LIVE-STUB is a smoke proxy; the agent did NOT capture EEG.")
        println("  [NOTE] real live verdict requires the runbook flow (human-only).")
    } else {
        println("  [ERROR] unknown mode: " + mode)
        println("  modes: mock-coupled | mock-indep | mock-both | live <path>")
        panic("unknown mode")
    }

    println("================================================================")
    println("  RESULT MODE = " + mode)
    println("  engine ⊥ adapter (g61): adapter signature unchanged · stdlib engine called")
    println("================================================================")
}
