// lane_p_engine_probe.hexa — ENGINE-load + CE of the Lane P (GPU-torch) .clm.
// Loads the torch-trained d768 E2/L1 .clm through gen_clm_backend (the SINGLE L3
// .clm entry, a_core_engine_map) → clm_decodable check → clm_decode_ce real
// forward over real-corpus byte windows. Reports model_ce < uniform AND < shuffle.
//   F-CLM-LANEP-ENGINE = 1 ⇔ decodable=true AND model_ce < uniform AND < shuffle.
import "CORE/generator.hexa"

fn main() {
    let clm = env("LP_CLM")
    let corpus = env("LP_CORPUS")
    let nwin = if env("LP_NWIN") == "" { 24 } else { to_int(env("LP_NWIN")) }
    let T = 64
    println("=== Lane P (GPU-torch) ENGINE-load + CE ===")
    println("clm=" + clm)
    println("corpus=" + corpus)

    let bk = gen_clm_backend(clm)
    println("[admit] valid=" + to_string(bk["valid"])
        + " loaded=" + to_string(bk["loaded"])
        + " nblocks=" + to_string(bk["nblocks"]))
    // structural decodable = gen_clm_backend admit (magic + nblocks parsed). The
    // v0.2 CLMX trailer presence is surfaced by clm_decode_ce["has_ext"] below.
    let dec = to_string(bk["valid"]) == "true"
    println("[clm_decodable(admit)] = " + to_string(dec) + " nblk=" + to_string(bk["nblocks"]))
    if !dec {
        println("F-CLM-LANEP-ENGINE = 0  (NOT decodable)")
        return
    }

    let rb = read_file_bytes(corpus)
    let n = len(rb)
    let mut stride = (n - T - 1) / nwin
    if stride < 1 { stride = 1 }

    let mut sum_model = 0.0
    let mut sum_shuf = 0.0
    let mut nw = 0
    let mut has_ext_seen = false
    let mut model_d = 0
    let mut s = 0
    while s < nwin {
        let base = s * stride
        if base + T + 1 <= n {
            let seq = []
            let mut p = 0
            while p < T { seq.push(rb[base + p]); p = p + 1 }
            let r = clm_decode_ce(clm, seq)
            sum_model = sum_model + to_float(r["ce"])
            if to_string(r["has_ext"]) == "true" { has_ext_seen = true }
            model_d = to_int(r["d"])
            // shuffle baseline: reverse the window targets (same det as decoder probe)
            let seqr = []
            let mut q = 0
            while q < T { seqr.push(rb[base + (T - 1 - q)]); q = q + 1 }
            let rr = clm_decode_ce(clm, seqr)
            sum_shuf = sum_shuf + to_float(rr["ce"])
            nw = nw + 1
        }
        s = s + 1
    }
    let model_ce = sum_model / to_float(nw)
    let shuf_ce = sum_shuf / to_float(nw)
    let uniform_ce = ln(256.0)
    let lt_u = model_ce < uniform_ce
    let lt_s = model_ce < shuf_ce
    println("[CE] windows=" + to_string(nw) + " T=" + to_string(T)
        + " has_ext(v0.2)=" + to_string(has_ext_seen) + " model_d=" + to_string(model_d))
    println("[CE] model_ce   = " + format_float(model_ce, 5))
    println("[CE] shuffle_ce = " + format_float(shuf_ce, 5))
    println("[CE] uniform_ce = " + format_float(uniform_ce, 5))
    println("[CE] model<uniform = " + to_string(lt_u) + "  model<shuffle = " + to_string(lt_s))
    let green = lt_u && lt_s
    println("")
    println("F-CLM-LANEP-ENGINE (decodable AND model_ce<uniform AND <shuffle) = "
        + (if green { "1" } else { "0" }))
}
