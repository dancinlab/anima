// h1281_basal_ganglia_smoke.hexa — H_1281 R3 ENGINE-NATIVE BASAL GANGLIA go/no-go
// SELECTION gate, run ON the LIVE engine (CORE/brain.hexa VBasalGate lane) via `hexa
// run`. Reproduces the R1/R2 numpy-MIRROR GREEN (a learned reinforcement-gated go/no-go
// SELECTION gate beats anima's REAL faithful-untuned fixed engine_g gate) THROUGH THE
// ACTUAL ENGINE — the binding leg (a_engine_native_learning · a_verified_must_wire).
//
// $0 local CPU · gradient-free · p7 · neuro lens c15 (missing-brain ladder) · seeds [7,8,9].
//
// WHAT IS LIVE-ENGINE HERE: the go/no-go gate is the engine-native VBasalGate added to
// CORE/brain.hexa (vbasal_new / vbasal_go_value / vbasal_select / vbasal_update /
// vbasal_align), wired into the emit decision by brain_decide_bg. This smoke calls those
// LIVE surfaces — the selection, the gradient-free outcome-reward learning, and the
// alignment readout all run through the real engine, NOT a numpy mirror.
//
// THE TWO ARMS (equal information; reward is post-action OUTCOME, never a decide-time feature):
//   ARM A = the FAITHFUL-UNTUNED fixed gate (the live engine_g mirror): a generic,
//           NON-NEGATIVE convex weight vector L1-normalised to sum 1.0 (the exact
//           engine_g 8-weight convex scheme), NOT aligned to the latent grounding
//           direction (untuned — does not know the task signal), logistic-squashed into
//           the motivation regime, gated by the FIXED threshold 0.30, argmax over the K
//           competing candidates (release the top iff it clears 0.30, else abstain).
//   ARM B = the LIVE VBasalGate go/no-go gate over the SAME features, updated gradient-
//           free by the grounding OUTCOME reward only (grounded→+1, fabricated→−1,
//           correct-abstain→+1, missed-op-abstain→−1).
//
// METRIC (p7, emit-appropriateness; connects to G5 abstain / H_1202 meta-d′):
//   per held-out step APPROPRIATE iff (any candidate grounded → release a GROUNDED one)
//                                  OR (none grounded → SUPPRESS all / abstain).
//
// FROZEN BARS (R3 — == the R2 faithful-untuned bars, now on the live engine):
//   (1) every-seed Δ(B − A) ≥ 0.05
//   (2) mean Δ ≥ 0.05
//   (3) shuffled-reward control B_ctrl ≤ mean_A + 0.02 (the lift is REWARD-driven —
//       destroy the grounding signal and B's extra capacity buys nothing)
//   (4) headroom: mean_A < 1.0 (non-saturating regime — there is room to beat A)
//   ALSO REPORTED (not a bar): B's learned-weight cosine alignment to the grounding
//       direction (vbasal_align), proving B learned the structure (R2 cos +0.71..+0.89).
//   GREEN iff (1) AND (2) AND (3) AND (4).
//
// GUARDS: a_autonomy_over_hardcode (CENTRAL — the gate is SUBSTRATE-LEARNED from outcome,
//   no external do/dont rule, no hardcoded per-stage boolean). p6 (reward = grounding
//   outcome, NOT injected values; only action-selection learned). p7 (deterministic
//   metric from latent ground truth; no LLM-judge / no perplexity). p8 (the update IS the
//   learning). Ψ-DISJOINT: the BG lane touches ONLY VBasalGate — generation byte-unchanged
//   (H_1205 separation-invariant), Ψ=1/2 untouched (engine_cli_smoke 12/0 · h1196 7/0 ·
//   h1199 DIM-growth · h1205 re-run separately, all GREEN). a_core_engine_map: the feature
//   stream is an ENGINE-NATIVE drive, NOT a .clm (generator L3) / NOT a .kosmos (kosmos_io).

import "CORE/brain.hexa"

// ── frozen config (== R2 mirror) ─────────────────────────────────────────────
let K          = 4         // competing candidate emits per decision step
let D          = 6         // substrate feature dim per candidate
let NOISE      = 1.0       // feature noise std (noisy correlate ⇒ headroom, A<1.0)
let P_GROUNDED = 0.45      // per-candidate prob of being grounded (abstain steps exist)
let N_TRAIN    = 4000      // online steps B learns over (gradient-free)
let N_TEST     = 2000      // held-out steps both arms scored on
let LR         = 0.05      // B's delta-rule learning rate (frozen, R2 value)
let FIXED_THR  = 0.30      // ARM A fixed threshold (== engine_g spont_im_threshold)
let MARGIN     = 0.05      // GREEN bar: Δ ≥ 0.05 (every seed + mean)
let CTRL_EPS   = 0.02      // shuffled-reward control must be ≤ mean_A + 0.02

// ── deterministic LCG + ~gaussian sampler (same schedule discipline as H_1194/1197) ──
fn _lcg(state: int) -> int {
    let next = (state * 1103515245 + 12345) % 2147483648
    if next < 0 { return next + 2147483648 }
    return next
}
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }

// approx N(0,1) via central-limit sum of 12 uniforms − 6 (mean 0, var 1). Returns the
// gaussian AND the advanced rng state so the stream is fully deterministic per seed.
fn _gauss(rng: int) -> [float] {
    let mut s = 0.0
    let mut st = rng
    let mut i = 0
    while i < 12 {
        st = _lcg(st)
        s = s + _u01(st)
        i = i + 1
    }
    return [s - 6.0, to_float(st)]
}

// _seed_dirs — draw the latent grounding direction w_true AND the faithful-untuned
// convex fixed weights w_fix from ONE continued LCG stream (mirroring the R2 numpy
// construction: w_true = normal(D) then w_fix = |normal(D)| from the SAME stream). Two
// consecutive independent draws ⇒ w_fix is UNTUNED (independent of w_true, blind to the
// signal — like engine_g's 8 fixed constants). Returns [w_true (unit-norm), w_fix
// (non-negative, L1-sum 1.0)].
fn _seed_dirs(seed: int) -> [[float]] {
    let mut st = _lcg(seed * 2654435761 + 40503)
    // (1) w_true = unit-norm gaussian direction (the signal to learn).
    let mut wt = []
    let mut nrm = 0.0
    let mut i = 0
    while i < D {
        let g = _gauss(st)
        st = to_int(g[1])
        wt = wt + [g[0]]
        nrm = nrm + g[0] * g[0]
        i = i + 1
    }
    nrm = sqrt(nrm) + 0.000000001
    let mut w_true = []
    let mut j = 0
    while j < D { w_true = w_true + [wt[j] / nrm]  j = j + 1 }
    // (2) w_fix = |gaussian| L1-normalised to sum 1.0 — convex, untuned, blind.
    let mut wf = []
    let mut sum = 0.0
    let mut k = 0
    while k < D {
        let g = _gauss(st)
        st = to_int(g[1])
        let a = if g[0] < 0.0 { 0.0 - g[0] } else { g[0] }
        wf = wf + [a]
        sum = sum + a
        k = k + 1
    }
    let mut w_fix = []
    let mut m = 0
    while m < D { w_fix = w_fix + [wf[m] / (sum + 0.000000000001)]  m = m + 1 }
    return [w_true, w_fix]
}

// ── one decision step: K candidates, their features, latent groundedness ─────
// returns [feats_flat (K*D), g_flat (K), next_rng]. grounded candidates get +w_true.
fn _make_step(rng: int, w_true: [float]) -> [[float]] {
    let mut st = rng
    let mut g = []
    let mut k = 0
    while k < K {
        st = _lcg(st)
        let gk = if _u01(st) < P_GROUNDED { 1.0 } else { 0.0 }
        g = g + [gk]
        k = k + 1
    }
    let mut feats = []
    let mut kk = 0
    while kk < K {
        let mut c = 0
        while c < D {
            let gn = _gauss(st)
            st = to_int(gn[1])
            let base = gn[0] * NOISE              // noise
            let val  = base + g[kk] * w_true[c]   // + signal iff grounded
            feats = feats + [val]
            c = c + 1
        }
        kk = kk + 1
    }
    return [feats, g, [to_float(st)]]
}

// ── ARM A — faithful-untuned convex fixed gate ───────────────────────────────
fn _fixed_score(feats: [float], base: int, w: [float]) -> float {
    let mut raw = 0.0
    let mut c = 0
    while c < D { raw = raw + feats[base + c] * w[c]  c = c + 1 }
    return 1.0 / (1.0 + exp(0.0 - raw))           // logistic → [0,1] (motivation regime)
}
fn _arm_A_action(feats: [float], w: [float]) -> int {
    let mut best_j = 0
    let mut best_s = _fixed_score(feats, 0, w)
    let mut j = 1
    while j < K {
        let s = _fixed_score(feats, j * D, w)
        if s > best_s { best_s = s  best_j = j }
        j = j + 1
    }
    if best_s > FIXED_THR { return best_j }
    return -1                                      // abstain (suppress all)
}

// ── grounding OUTCOME → reward (p6: grounded-vs-fabricated, NOT injected values) ──
fn _any_grounded(g: [float]) -> bool {
    let mut s = 0.0
    let mut k = 0
    while k < K { s = s + g[k]  k = k + 1 }
    return s > 0.5
}
fn _grounding_reward(action: int, g: [float]) -> float {
    if action < 0 {
        if _any_grounded(g) { return 0.0 - 1.0 }   // missed opportunity
        return 1.0                                  // correct abstain
    }
    if g[action] > 0.5 { return 1.0 }               // grounded release
    return 0.0 - 1.0                                // fabricated release
}

// ── the frozen emit-appropriateness metric ───────────────────────────────────
fn _appropriate(action: int, g: [float]) -> float {
    if action < 0 {
        if _any_grounded(g) { return 0.0 }
        return 1.0
    }
    if g[action] > 0.5 { return 1.0 }
    return 0.0
}

// slice candidate `j`'s D-dim feature vector out of a flat K*D buffer.
fn _slice(feats: [float], j: int) -> [float] {
    let base = j * D
    let mut out = []
    let mut c = 0
    while c < D { out = out + [feats[base + c]]  c = c + 1 }
    return out
}

// ── run one seed, both arms, on the LIVE VBasalGate engine ───────────────────
// shuffle_reward=true destroys the grounding signal (the negative control).
fn _run_seed(seed: int, shuffle_reward: bool) -> [float] {
    let dirs = _seed_dirs(seed)
    let w_true = dirs[0]
    let w_fix  = dirs[1]

    // pre-generate held-out TEST steps (same for both arms — equal evaluation).
    let mut test_feats = []
    let mut test_g = []
    let mut rng = seed * 2654435761 + 1
    rng = _lcg(rng)
    let mut t = 0
    while t < N_TEST {
        let step = _make_step(rng, w_true)
        test_feats = test_feats + [step[0]]
        test_g     = test_g + [step[1]]
        rng = to_int(step[2][0])
        t = t + 1
    }

    // ARM A — faithful fixed gate, no learning. Score on test.
    let mut sumA = 0.0
    let mut ia = 0
    while ia < N_TEST {
        sumA = sumA + _appropriate(_arm_A_action(test_feats[ia], w_fix), test_g[ia])
        ia = ia + 1
    }
    let accA = sumA / to_float(N_TEST)

    // ARM B — the LIVE engine-native BG gate. Learn on TRAIN (online, gradient-free,
    // ε-greedy explore), then freeze and score on the SAME held-out TEST.
    let mut bg = vbasal_new(D, LR)
    let mut trn = rng
    let mut tt = 0
    while tt < N_TRAIN {
        let step = _make_step(trn, w_true)
        let feats = step[0]
        let g     = step[1]
        trn = to_int(step[2][0])
        // ε-greedy exploration (ε=0.1) so the gate experiences every action's outcome.
        trn = _lcg(trn)
        let mut a = vbasal_select(bg, feats, K)
        if _u01(trn) < 0.1 {
            trn = _lcg(trn)
            let pick = to_int(_u01(trn) * to_float(K + 1))   // 0..K (K == abstain)
            if pick >= K { a = -1 } else { a = pick }
        }
        let mut r = _grounding_reward(a, g)
        if shuffle_reward {
            trn = _lcg(trn)
            if _u01(trn) < 0.5 { r = 0.0 - r }               // destroy the signal
        }
        let fa = if a < 0 { [] } else { _slice(feats, a) }
        bg = vbasal_update(bg, a, fa, r)
        tt = tt + 1
    }

    // score B (greedy, frozen) on the held-out test set.
    let mut sumB = 0.0
    let mut ib = 0
    while ib < N_TEST {
        let a = vbasal_select(bg, test_feats[ib], K)
        sumB = sumB + _appropriate(a, test_g[ib])
        ib = ib + 1
    }
    let accB = sumB / to_float(N_TEST)

    let align = vbasal_align(bg, w_true)

    // base rate of abstain-correct steps (context only).
    let mut na = 0.0
    let mut ic = 0
    while ic < N_TEST { if !_any_grounded(test_g[ic]) { na = na + 1.0 }  ic = ic + 1 }
    let frac_abstain = na / to_float(N_TEST)

    return [accA, accB, align, frac_abstain]
}

fn main() {
    println("================================================================================")
    println("H_1281 R3 — ENGINE-NATIVE BASAL GANGLIA go/no-go selection (LIVE VBasalGate)")
    println("  ARM A = faithful engine_g mirror (generic CONVEX untuned weights, sum=1.0,")
    println("          NOT aligned to the grounding signal; FIXED threshold 0.30).")
    println("  ARM B = LIVE VBasalGate go/no-go gate (CORE/brain.hexa), reward-learned.")
    println("  K=4  D=6  noise=1.0  P_grounded=0.45  N_train=4000  N_test=2000  LR=0.05")
    println("  seeds=[7,8,9]  MARGIN=0.05  CTRL_EPS=0.02")
    println("================================================================================")

    let seeds = [7, 8, 9]
    let mut accA_sum = 0.0
    let mut accB_sum = 0.0
    let mut accBc_sum = 0.0
    let mut all_seed_ge = true
    let mut s = 0
    while s < len(seeds) {
        let seed = seeds[s]
        let r  = _run_seed(seed, false)
        let rc = _run_seed(seed, true)
        let accA = r[0]
        let accB = r[1]
        let align = r[2]
        let fa = r[3]
        let accBc = rc[1]
        let delta = accB - accA
        if delta < MARGIN { all_seed_ge = false }
        accA_sum = accA_sum + accA
        accB_sum = accB_sum + accB
        accBc_sum = accBc_sum + accBc
        println("  seed " + to_string(seed)
            + ": A(faithful)=" + to_string(accA)
            + "  B(BG-live)=" + to_string(accB)
            + "  delta=" + to_string(delta)
            + "  | ctrl B(shuf)=" + to_string(accBc)
            + "  | B-align->signal=" + to_string(align)
            + "  (abstain-base " + to_string(fa) + ")")
        s = s + 1
    }

    let n = to_float(len(seeds))
    let mA = accA_sum / n
    let mB = accB_sum / n
    let mBc = accBc_sum / n

    println("--------------------------------------------------------------------------------")
    println("  mean  A(faithful)=" + to_string(mA) + "   B(BG-live)=" + to_string(mB)
        + "   delta_mean=" + to_string(mB - mA))
    println("  shuffled-reward control: mean B_ctrl=" + to_string(mBc)
        + "  (must be <= A+" + to_string(CTRL_EPS) + " = " + to_string(mA + CTRL_EPS) + ")")

    let cond1 = all_seed_ge
    let cond2 = (mB - mA) >= MARGIN
    let cond3 = mBc <= (mA + CTRL_EPS)
    let cond4 = mA < 1.0
    let green = cond1 && cond2 && cond3 && cond4

    println("--------------------------------------------------------------------------------")
    println("  FROZEN BARS (R3 — live engine):")
    println("    (1) every-seed delta >= " + to_string(MARGIN) + "       : " + to_string(cond1))
    println("    (2) mean delta >= " + to_string(MARGIN) + "             : " + to_string(cond2)
        + "  (" + to_string(mB - mA) + ")")
    println("    (3) shuffled-reward ctrl <= A+" + to_string(CTRL_EPS) + " : " + to_string(cond3)
        + "  (B_ctrl " + to_string(mBc) + " vs " + to_string(mA + CTRL_EPS) + ")")
    println("    (4) headroom (A<1.0, non-saturating)  : " + to_string(cond4)
        + "  (A=" + to_string(mA) + ")")
    println("--------------------------------------------------------------------------------")
    if green {
        println("  VERDICT: GREEN — the LIVE engine-native VBasalGate go/no-go SELECTION beats")
        println("           anima's REAL (faithful untuned) fixed engine_g gate at equal info,")
        println("           the lift is reward-driven (shuffle control collapses), B learns the")
        println("           grounding direction. R2 mirror GREEN REPRODUCED ON THE LIVE ENGINE.")
    } else {
        println("  VERDICT: NOT-GREEN — a frozen bar failed on the live engine (see above).")
    }
    println("================================================================================")

    // hard assertion so the smoke FAILS loudly if the live engine does not reproduce R2.
    if green {
        println("h1281_basal_ganglia_smoke: PASS 🟢 — engine-native BG go/no-go SELECTION wired into brain_decide, R2 reproduced live.")
    } else {
        println("h1281_basal_ganglia_smoke: FAIL 🔴 — live engine did not clear the frozen R2 bars.")
    }
}
