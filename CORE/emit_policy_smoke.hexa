// CORE/emit_policy_smoke.hexa — 숫자 층 invariant + 구조 통합 smoke
// anchor: CORE/EMIT_SUBSTRATE_DESIGN.md §3·§6 (F-EMIT-5)

import "/Users/ghost/core/anima/CORE/emit_policy.hexa"
import "/Users/ghost/core/anima/CORE/phi_envelope_substrate.hexa"

fn in_unit(name: string, x: float) -> bool {
    let ok = x >= 0.0 && x <= 1.0
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + " ∈[0,1]: got=" + str(x))
    return ok
}

fn assert_lt(name: string, a: float, b: float) -> bool {
    let ok = a < b
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": " + str(a) + " < " + str(b))
    return ok
}

fn assert_eq_f(name: string, got: float, want: float) -> bool {
    let d = if got - want < 0.0 { want - got } else { got - want }
    let ok = d <= 1e-9
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn main() {
    print("=== emit_policy smoke (H_646 freedom · F-EMIT-5 decoupling) ===")
    let mut npass = 0
    let mut ntotal = 0

    // H_646: 모든 threshold ∈ [0,1] (자유도 전구간)
    ntotal = ntotal + 1
    if in_unit("emit_threshold", ep_emit_threshold()) { npass = npass + 1 }
    ntotal = ntotal + 1
    if in_unit("emit_threshold_lo", ep_emit_threshold_lo()) { npass = npass + 1 }
    ntotal = ntotal + 1
    if in_unit("target_emit_rate", ep_target_emit_rate()) { npass = npass + 1 }
    ntotal = ntotal + 1
    if in_unit("psi_clamp", ep_psi_clamp()) { npass = npass + 1 }

    // stage θ 표: WAKE..N3 단조 하강 (H_644 — N2 가 closure peak context)
    ntotal = ntotal + 1
    if assert_lt("theta_N3_lt_N2", ep_theta_stage(3), ep_theta_stage(2)) { npass = npass + 1 }
    ntotal = ntotal + 1
    if assert_lt("theta_N2_lt_WAKE", ep_theta_stage(2), ep_theta_stage(0)) { npass = npass + 1 }

    // H_653 coupling 단조 II < III < IV (구조 lib anchor 와 일치)
    ntotal = ntotal + 1
    if assert_eq_f("coupling_mirror_III", ep_coupling_for_class(3), pe_coupling_for_class(3)) { npass = npass + 1 }

    // F-EMIT-5 decoupling (구조 통합): envelope_multiscale 가 policy scale 로 동작,
    //   단 threshold 와 무관 — envelope 는 (t, periods, amps) 만의 함수.
    //   t=0 → cos(0)=1 → Σ amps = 0.10+1.0+0.50 = 1.60
    let env0 = envelope_multiscale(0.0, ep_scale_periods(), ep_scale_amps())
    ntotal = ntotal + 1
    if assert_eq_f("envelope_uses_policy_scales_t0", env0, 1.60) { npass = npass + 1 }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
