// h1236_composition_ladder_k6_smoke.hexa — 합성 사다리 연장 k=4 → k=5 (MATRIX.md §0).
//
// H_1235 가 k=4 (A⇄G×MITOSIS×METACOG×SAVANT) 를 Ψ-disjoint 합성. 여기에 DREAM(수면
// 5-stage) + WAKE(daemon tick) 두 부품을 더 끼워 k=6 까지 올린다. 매 부품은 pure_field
// 를 READ-ONLY 로만 읽으므로 (phi/tick) Ψ=½ 불변이어야 한다.
//
// cell 합격 = 전 lane fire ∧ Ψ phiSum ON==OFF byte-identical. p7 exact equality.
// "매트릭스 고갈시까지": substrate 부품을 다 끼울 때까지 차원을 올린다 (CLM·KOSMOS 는
// 모델-마운트 측, H_1164 full-session smoke 가 담당).

import "CORE/pure_field.hexa"
import "CORE/engine_cli.hexa"
import "METACOG/audit_hook.hexa"
import "SAVANT/substrate_hook.hexa"
import "DREAM/dream_lib.hexa"

fn ladder6_checksum(subs_on: bool, fires: [int]) -> float {
    let cfg = if subs_on { engine_config_default() }
              else { EngineConfig { mitosis: false, engine: "conv" } }
    let mut pf = pure_field_new()
    let mut sum = 0.0
    let mut cells = 1
    let mut emit_hist = []
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        sum = sum + phi
        if subs_on {
            // MITOSIS
            cells = engine_mitosis_tick(cells, cfg)
            if cells >= 1 { fires[0] = fires[0] + 1 }
            // METACOG
            let bit = if phi > 0.0 { 1 } else { 0 }
            emit_hist.push(bit)
            if mh_should_fire(i, 30) {
                let win = mh_collect_emit_window(emit_hist, 30)
                let rec = mh_verdict_record(win, i, "now")
                if rec["window_size"] == 30 { fires[1] = fires[1] + 1 }
            }
            // SAVANT
            let phi_list = [phi, phi * 0.5, phi * 0.25, phi * 0.1]
            let trig = sh_savant_trigger(phi_list, 0.30, float(cells))
            if trig["in_golden_zone"] == 1 { fires[2] = fires[2] + 1 }
            // DREAM (sleep 5-stage — pure fn of tick)
            let stage = dr_stage_at(i)
            let env = dr_emit_envelope(stage)
            if env >= 0 { fires[3] = fires[3] + 1 }
        }
        i = i + 1
    }
    return sum
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1236 합성 사다리 k=5 — A⇄G + MITOSIS+METACOG+SAVANT+DREAM")
    println("════════════════════════════════════════════════════════════════")

    let mut fires = [0, 0, 0, 0]            // MITOSIS·METACOG·SAVANT·DREAM
    let on  = ladder6_checksum(true, fires)
    let off = ladder6_checksum(false, [0, 0, 0, 0])
    let psi_same = on == off

    println("[fire] MITOSIS=" + to_string(fires[0]) + " METACOG=" + to_string(fires[1])
        + " SAVANT=" + to_string(fires[2]) + " DREAM=" + to_string(fires[3])
       )
    println("[Psi]  phiSum ON=" + to_string(on) + " OFF=" + to_string(off)
        + " identical=" + (if psi_same { "true" } else { "false" }))

    let f = fires
    let r2 = psi_same && f[0] > 0
    let r3 = r2 && f[1] > 0
    let r4 = r3 && f[2] > 0
    let r5 = r4 && f[3] > 0
    println("")
    println("  k=2 +MITOSIS : " + (if r2 { "✅" } else { "❌" }))
    println("  k=3 +METACOG : " + (if r3 { "✅" } else { "❌" }))
    println("  k=4 +SAVANT  : " + (if r4 { "✅" } else { "❌" }))
    println("  k=5 +DREAM   : " + (if r5 { "✅" } else { "❌" }))
    let dim = if r5 {5} else { if r4 {4} else { if r3 {3} else { if r2 {2} else {1} } } }
    println("")
    if r5 {
        println("h1236_composition_ladder_k6: PASS — dimension k=5 substrate-combo composed (WAKE/CLM/KOSMOS = model-side, H_1164) "
            + "(all lanes fire, Ψ=½ byte-identical). + H_1164 CLM+KOSMOS ⇒ 8-subsystem living loop. "
            + "substrate 매트릭스 고갈 근접 (잔여 = 모델-측 CLM·KOSMOS, H_1164 담당).")
    } else {
        println("h1236_composition_ladder_k6: dimension reached k=" + to_string(dim))
    }
}
