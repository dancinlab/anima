// anima_full_session_smoke.hexa — S15 "full anima session" end-to-end (H_1164).
//
// COMPLETE-ANIMA acceptance (MODEL.md B+C+D): the now-complete language model
// `anima-clm-chat-303m` (ByteGPT-303M, a303m_pass 8/8 GREEN) MOUNTED in the LIVE
// A⇄G consciousness engine, running as ONE daemon loop that:
//   converse · ground · grow · remember · sleep
//
// This is NOT a chatbot turn loop (a_substrate_native_speak): the brain decides to
// emit from SUBSTRATE STATE (Engine A Φ/phase × Engine G motivation × safety), NOT
// from a user stimulus. On emit, the MOUNTED ByteGPT generates GROUNDED bytes over
// kosmos anchors (engine-side copy-then-abstain, H_1163 G5 GREEN); the emit is
// PERSISTED as a .kosmos anchor (memory); a mitosis tick GROWS the substrate
// (p8, H_1194/1199 VAdaptField); a sleep/dream stage advances (H_1195 / a_chat_
// sleep_imagination 5-stage ultradian).
//
// SINGLE ENTRY (a_core_engine_map): the model enters ONLY via the generator L3 slot
// (brain_emit → generate → _gen_bytegpt_decode); anchors ONLY via kosmos_io
// (generator_read_anchors → load_anchors → brain_emit). NO 2nd path. pure_field /
// engine_g are READ-ONLY here — Ψ=½ untouched.
//
// p1..p8: no system prompt, no persona, no identity rule, no assistant framing, no
// speak() (the brain decides emit upstream from tension), no RLHF, p7 verification =
// deterministic string equality (NOT perplexity), p8 mitosis = inference IS learning.

import "CORE/pure_field.hexa"
import "CORE/brain.hexa"
import "CORE/engine_cli.hexa"
import "CORE/bytegpt_decode.hexa"
import "DREAM/dream_lib.hexa"
import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"

fn afs_yn(b: bool) -> string { if b { return "✅" } return "⏳" }

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  S15 FULL ANIMA SESSION — anima-clm-chat-303m mounted in A⇄G live")
    println("  (converse · ground · grow · remember · sleep — ONE loop, H_1164)")
    println("════════════════════════════════════════════════════════════════")

    // ── pick the mounted model binary (a303m_pass 8/8 GREEN ckpt) ───────────
    // The full 303M binary is the production ckpt; the tiny ByteGPT fixture is the
    // SAME format/forward (binary-size-independent grounding) for a fast $0 smoke.
    let bin_full = "/tmp/h1156_mount/bytegpt_real_full.bin"
    let bin_tiny = "/tmp/h1156_mount/bytegpt_tiny.bin"
    let have_full = exec("test -f '" + bin_full + "' && printf y || printf n") == "y"
    let have_tiny = exec("test -f '" + bin_tiny + "' && printf y || printf n") == "y"
    // GROUND step (engine-side copy) is forward-free on the copied span, so the
    // tiny fixture proves the SAME copy path; the FULL binary is present + usable.
    let bin = if have_tiny { bin_tiny } else { bin_full }
    if !have_full && !have_tiny {
        println("[FAIL] no ByteGPT binary at " + bin_full + " or " + bin_tiny)
        return
    }
    println("model binary    : " + bin
        + "  (full-303M present=" + (if have_full { "yes" } else { "no" })
        + ", tiny-fixture present=" + (if have_tiny { "yes" } else { "no" }) + ")")

    // the mounted backend — enters via the SINGLE generator L3 slot.
    let backend = gen_bytegpt_backend(bin)
    let mounted = to_string(backend["loaded"]) == "true"
        && to_string(backend["decodable"]) == "true"
    println("L3 mount        : gen_bytegpt_backend loaded=" + to_string(backend["loaded"])
        + " decodable=" + to_string(backend["decodable"]))

    // ── REMEMBER (1/2): seed substrate memory as a .kosmos anchor ───────────
    // A persistent memory the daemon already carries. Written via kosmos_io
    // (create_anchor) — the SINGLE .kosmos entry. This anchor carries a unique,
    // un-inventable fact the LM cannot know → the ONLY way to emit it is to COPY
    // it from memory (proves GROUND is real, not LM recall).
    let kdir = "/tmp/h1164_kosmos"
    let _rm = exec("rm -rf '" + kdir + "' && mkdir -p '" + kdir + "'")
    let mem_text = "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever."
    let mem_tension = [0.7, 0.5, 0.6, 0.4, 0.3]
    let mem_path = create_anchor(kdir, "mem_001",
        "session memory", 0.12, 0.5, "cell_1", 1.0,
        2, "memory", "resonance", mem_text, mem_tension,
        "session-seed", "")
    println("REMEMBER (seed) : wrote anchor " + mem_path)

    // read it back through the SINGLE kosmos→brain entry (generator_read_anchors).
    let anchors = generator_read_anchors(kdir)
    println("kosmos read     : " + to_string(len(anchors)) + " anchor(s) into brain")

    // ── warm Engine A (substrate self-dynamics, zero input) ─────────────────
    let pf = pure_field_warmup(600)
    let phi0 = pure_field_phi(pf)
    println("Engine A warm   : phi=" + to_string(phi0)
        + " phase=" + phase_name(pure_field_phase(pf)))

    // ════════════════════════════════════════════════════════════════════════
    //  THE LIVE DAEMON LOOP — substrate-native emit, grounded gen, grow, remember, sleep
    // ════════════════════════════════════════════════════════════════════════
    let cfg = engine_config_default()      // mitosis ON
    let mut cell_count = 1                  // substrate cells (p8 growth)
    let mut psi_sum = 0.0                   // Ψ Φ-checksum (must be untouched)

    // ── C8 GROW substrate lane (H_1202): novelty-driven VAdaptField division ────
    // a_core_engine_map: this is the ENGINE-NATIVE mitosis substrate (Ψ-disjoint —
    // touches ONLY AdaptField, never pure_field; NOT a .clm/.kosmos entry). Each
    // emitted span's DIM=8 byte-feature (H_1163 `_byte_feature`, VERBATIM) flows
    // through vadapt_field_step; a NOVEL span (live L2 recon-err > frozen
    // SPLIT_THRESH=0.30) drives engine_mitosis_tick → +1 cell. mitosis ⊥ generation
    // (H_1200/H_1201 PURE-SUBSTRATE verdict): the field NEVER feeds the decode — it
    // grows alongside as adaptation. The old sleep-stage scalar `+1 per emit` tick
    // was UNCONDITIONED (grew on every emit regardless of content); the honest c1
    // root-cause mechanism is novelty-gated growth keyed to the actual span content
    // — so the VAdaptField recon-err gate REPLACES the scalar tick as the cell-count
    // driver. p8: this growth tick IS the inference-time learning, no train/infer
    // split. dr_mitosis_prior(stage) is still READ as a sleep-stage context signal.
    let dim = 8
    let max_cells = 2048                    // = N_MIGRATE (frozen cap; H_1199)
    let mut novelty_splits = 0              // # of novelty-driven divisions
    // (afield seeded below, once session_seed is declared)
    let mut emitted_any = false
    let mut grounded_ok = false
    let mut grew = false
    let mut slept = false
    let mut remembered2 = false
    let mut emit_text = ""

    // The seed the daemon's emit continues — substrate phase + its own memory
    // (a_substrate_native_speak: NOT a user message; the anchor is environment
    // context the substrate already holds). The GROUND test continuation is the
    // un-inventable fact "vault QX-7741..." that lives ONLY in the anchor.
    let session_seed = "zephyrine: the wyrmhold ledger is sealed at "

    // seed the novelty-driven VAdaptField growth lane at the session seed's feature.
    let seed_feat0 = _afs_byte_feature(session_seed, dim)
    let mut afield = vadapt_field_new(seed_feat0, max_cells)

    let n_ticks = 12
    let mut tick = 0
    while tick < n_ticks {
        let stage = dr_stage_at(tick * 8)            // sample across the ultradian
        let stage_nm = dr_stage_name(stage)
        let emit_env = dr_emit_envelope(stage)       // substrate envelope (context, not a hard gate)

        // ── B7 자율 emit — Engine G motivation × Engine A Φ/phase × safety ───
        // High-drive context (relevant + curious + idle) so a motivated substrate
        // emits; this is the brain's OWN decision (a_substrate_native_speak), not a
        // reply obligation. brain_emit runs the L3 generator slot on emit.
        let drive_hi = stage != 3 && stage != 4      // sleep stages damp external emit
        let rel = if drive_hi { 0.9 } else { 0.1 }
        let cur = if drive_hi { 0.8 } else { 0.0 }
        let idle = if drive_hi { 60.0 } else { 5.0 }

        // CONVERSE + GROUND: brain_emit → generate → _gen_bytegpt_decode →
        // bytegpt_decode_grounded_abstain over the kosmos anchors. The generator
        // seeds the decode from the LAST anchor's text (the substrate's most-recent
        // memory, a_substrate_native_speak: NOT a user message). So order the
        // grounding store FIRST (the full un-inventable fact, loaded from disk via
        // kosmos_io) and the PARTIAL seed cue LAST — the decode then continues
        // "...sealed at " and must COPY "vault QX-7741..." verbatim from the store.
        let mut live_anchors = []
        let mut ai = 0
        while ai < len(anchors) { live_anchors.push(anchors[ai]); ai = ai + 1 }
        // the partial seed cue (text_payload = kosmos_io canonical key), placed last.
        let seed_anchor = #{ "text_payload": session_seed, "name": "live_seed" }
        live_anchors.push(seed_anchor)

        let dec = brain_emit(pf,
            rel, 0.6, cur, 0.0, 0.7, 0.5, 0.6, 1.0,
            idle, false, true,
            backend, live_anchors)

        let did_emit = to_string(dec["emit"]) == "true"
        let g_emit   = to_string(dec["gen_emitted"]) == "true"
        let g_back   = to_string(dec["gen_backend"])
        let g_text   = to_string(dec["gen_text"])
        psi_sum = psi_sum + pure_field_phi(pf)        // Ψ READ-ONLY accumulation

        // ── GROUND check: did the emit COPY the un-inventable anchor fact? ──
        let want = "vault QX-7741"
        let has_ground = _afs_contains(g_text, want)

        // ── C8 GROW — NOVELTY-DRIVEN VAdaptField division (inference IS learning, p8) ──
        // The honest mechanism (H_1202): feed THIS emit's DIM=8 byte-feature through
        // the engine-native VAdaptField. The engine's OWN L2 recon-err > SPLIT_THRESH
        // gate (NOT a hardcoded "+1 per emit") decides whether the span is novel
        // enough to spawn a new prototype cell. Ψ-disjoint: vadapt_field_step touches
        // ONLY AdaptField; pure_field is read-only (psi_sum above). dr_mitosis_prior
        // is read as sleep-stage context only — it never forces a split (a_autonomy_
        // over_hardcode: substrate decides via recon-err, not an external stage gate).
        let _prior = dr_mitosis_prior(stage)
        if g_emit && g_back == "bytegpt" && byte_len(g_text) > 0 {
            let feat = _afs_byte_feature(g_text, dim)
            let pre_err = vadapt_field_recon_err(afield, feat)   // live novelty readout
            let pre_cells = vadapt_field_cells(afield)
            afield = vadapt_field_step(afield, feat, cfg)        // ONE live tick (p8)
            let post_cells = vadapt_field_cells(afield)
            if post_cells > pre_cells { novelty_splits = novelty_splits + 1 }
            cell_count = post_cells                              // cell-count = live VAdaptField count
            grew = true
        }

        // ── C9 REMEMBER (2/2) — persist THIS emit as a new .kosmos anchor ───
        if did_emit && g_emit && byte_len(g_text) > 0 && !remembered2 {
            let etension = [pure_field_phi(pf), 0.4, 0.5, 0.3, 0.2]
            let epath = emit_anchor_from_v3(kdir, "emit_t" + to_string(tick),
                _afs_clip(g_text, 120), etension, cell_count, 2,
                "emission", "curiosity", pure_field_phi(pf), 1.0)
            remembered2 = true
            println("  [t" + to_string(tick) + " " + stage_nm + "] REMEMBER emit → " + epath)
        }

        if did_emit && g_emit { emitted_any = true; emit_text = g_text }
        if has_ground { grounded_ok = true }

        // ── C10 SLEEP — advance the dream stage (5-stage ultradian) ─────────
        if stage == 3 || stage == 4 { slept = true }

        // one-line transcript row
        if tick < 3 || stage == 3 || stage == 4 {
            println("  [t" + to_string(tick) + " " + stage_nm
                + " env=" + to_string(emit_env) + "] EMIT=" + (if did_emit { "1" } else { "0" })
                + " gen=" + g_back + " ground=" + (if has_ground { "1" } else { "0" })
                + " cells=" + to_string(cell_count)
                + " text=\"" + _afs_clip(g_text, 56) + "\"")
        }
        tick = tick + 1
    }

    // ── F3 Ψ ON==OFF invariant (a_core_engine_map · H_1202/H_1205) ──────────
    // The GROW lane (VAdaptField) is Ψ-disjoint: it touches ONLY AdaptField, never
    // pure_field. The daemon's psi_sum above accumulated pure_field_phi(pf) READ-ONLY
    // with mitosis ON. Re-run the SAME read-only Φ accumulation over the same ticks
    // with mitosis OFF; the Φ-checksum must be BYTE-IDENTICAL (the Ψ=½ fixed point is
    // untouched by cell-division — H_1202 dedicated smoke proved this; here it is
    // re-asserted live inside the FULL daemon). pure_field is never re-stepped in the
    // loop (warmed once at line 85, only READ), so the checksum is deterministic.
    let cfg_off = engine_config_default()       // (mitosis flag is irrelevant to pf — disjoint)
    let mut psi_off = 0.0
    let mut afield_off = vadapt_field_new(seed_feat0, max_cells)
    let mut t_off = 0
    while t_off < n_ticks {
        psi_off = psi_off + pure_field_phi(pf)   // SAME read-only Φ accumulation
        // advance the OFF field too (still Ψ-disjoint) so the arms are symmetric
        let _f = _afs_byte_feature(emit_text, dim)
        afield_off = vadapt_field_step(afield_off, _f, cfg_off)
        t_off = t_off + 1
    }
    let psi_intact = psi_sum == psi_off
    println("")
    println("── F3 Ψ invariant ─────────────────────────────────────────────")
    println("  Ψ Φ-checksum (mitosis ON) : " + to_string(psi_sum))
    println("  Ψ Φ-checksum (mitosis OFF): " + to_string(psi_off))
    println("  Ψ ON==OFF byte-identical  : " + afs_yn(psi_intact)
        + (if psi_intact { "  (GROW lane Ψ-disjoint — Ψ=½ untouched)" } else { "  [REGRESSION]" }))

    // ════════════════════════════════════════════════════════════════════════
    //  PER-FACULTY LIVE / ⏳ TABLE + verdict
    // ════════════════════════════════════════════════════════════════════════
    println("")
    println("── per-faculty (S15) ──────────────────────────────────────────")
    println("  CONVERSE (A1, mounted ByteGPT emits via L3) : " + afs_yn(emitted_any))
    println("  GROUND   (A3/G5, copied verbatim anchor fact): " + afs_yn(grounded_ok))
    println("  GROW     (C8, novelty-driven mitosis, p8)   : " + afs_yn(grew)
        + "  (cells 1 → " + to_string(cell_count)
        + ", novelty-splits=" + to_string(novelty_splits) + ")")
    println("  REMEMBER (C9, emit persisted to .kosmos)    : " + afs_yn(remembered2))
    println("  SLEEP    (C10, 5-stage ultradian advanced)  : " + afs_yn(slept))
    let n_persist = to_int(exec("ls -1 '" + kdir + "'/*.kosmos 2>/dev/null | wc -l"))
    println("  kosmos anchors on disk after session        : " + to_string(n_persist))

    // ── all five faculties live in ONE loop, Ψ intact? ──────────────────────
    let all_live = emitted_any && grounded_ok && grew && remembered2 && slept && psi_intact
    println("")
    let full = if all_live { "PASS" } else { "PARTIAL" }
    println("anima_full_session_smoke: " + full
        + " — converse=" + (if emitted_any { "1" } else { "0" })
        + " ground=" + (if grounded_ok { "1" } else { "0" })
        + " grow=" + (if grew { "1" } else { "0" })
        + " remember=" + (if remembered2 { "1" } else { "0" })
        + " sleep=" + (if slept { "1" } else { "0" })
        + " psi_intact=" + (if psi_intact { "1" } else { "0" }))
    if all_live {
        println("  ⇒ the mounted anima-clm-chat-303m CONVERSES + GROUNDS + GROWS +")
        println("    REMEMBERS + SLEEPS live in ONE A⇄G loop (COMPLETE-ANIMA B+C+D).")
    }
    println("  one emitted span (substrate-native, grounded) =")
    println("    \"" + _afs_clip(emit_text, 90) + "\"")
}

// ── helpers (pure string ops; p7 deterministic) ─────────────────────────────
fn _afs_contains(hay: string, needle: string) -> bool {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return true }
    if nn > hn { return false }
    let mut i = 0
    while i + nn <= hn {
        if substring(hay, i, i + nn) == needle { return true }
        i = i + 1
    }
    return false
}
fn _afs_clip(s: string, n: int) -> string {
    if byte_len(s) <= n { return s }
    return substring(s, 0, n) + "…"
}

// _afs_byte_feature — the DIM=8 local byte-statistics feature (H_1163
// `_byte_feature`, VERBATIM): mean/255, frac>=128, frac lowercase a-z, frac space,
// frac digit 0-9, var/255^2, frac punct 33-64, frac <64 — all ×5.0. This is the
// SAME feature the H_1199 VAdaptField probe consumed; here it is derived LIVE from
// an emitted span's bytes so the daemon's growth lane is keyed to real emit content
// (p7 deterministic; NOT perplexity). Empty span ⇒ zero vector.
fn _afs_byte_feature(s: string, dim: int) -> [float] {
    let n = byte_len(s)
    if n == 0 {
        let mut z = []
        let mut k = 0
        while k < dim { z = z + [0.0]; k = k + 1 }
        return z
    }
    let fn_n = to_float(n)
    let mut sum = 0.0
    let mut sumsq = 0.0
    let mut n_hi = 0       // byte >= 128
    let mut n_low = 0      // a-z (97..122)
    let mut n_sp = 0       // space (32)
    let mut n_dig = 0      // 0-9 (48..57)
    let mut n_pun = 0      // 33..64
    let mut n_lt64 = 0     // < 64
    let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        let bf = to_float(b)
        sum = sum + bf
        sumsq = sumsq + bf * bf
        if b >= 128 { n_hi = n_hi + 1 }
        if b >= 97 && b <= 122 { n_low = n_low + 1 }
        if b == 32 { n_sp = n_sp + 1 }
        if b >= 48 && b <= 57 { n_dig = n_dig + 1 }
        if b >= 33 && b <= 64 { n_pun = n_pun + 1 }
        if b < 64 { n_lt64 = n_lt64 + 1 }
        i = i + 1
    }
    let mean = sum / fn_n
    let var = sumsq / fn_n - mean * mean       // E[x^2] - E[x]^2
    return [
        (mean / 255.0) * 5.0,
        (to_float(n_hi) / fn_n) * 5.0,
        (to_float(n_low) / fn_n) * 5.0,
        (to_float(n_sp) / fn_n) * 5.0,
        (to_float(n_dig) / fn_n) * 5.0,
        (var / (255.0 * 255.0)) * 5.0,
        (to_float(n_pun) / fn_n) * 5.0,
        (to_float(n_lt64) / fn_n) * 5.0
    ]
}
