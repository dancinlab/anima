// CORE/phi_envelope_substrate_smoke.hexa — F-EMIT-1..3 + 구조 불변식 smoke
// anchor: CORE/EMIT_SUBSTRATE_DESIGN.md §6 (falsifier 사전등록)

import "/Users/ghost/core/anima/CORE/phi_envelope_substrate.hexa"

fn abs_f(x: float) -> float {
    return if x < 0.0 { -x } else { x }
}

fn assert_close(name: string, got: float, want: float, tol: float) -> bool {
    let d = abs_f(got - want)
    let ok = d <= tol
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want) + " |Δ|=" + str(d))
    return ok
}

fn assert_bool(name: string, got: bool, want: bool) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn assert_ge(name: string, got: float, lo: float) -> bool {
    let ok = got >= lo
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " ≥ " + str(lo))
    return ok
}

fn assert_lt(name: string, got: float, hi: float) -> bool {
    let ok = got < hi
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " < " + str(hi))
    return ok
}

fn min_list(xs: [float]) -> float {
    let mut m = xs[0]
    let mut i = 1
    while i < len(xs) {
        if xs[i] < m { m = xs[i] }
        i = i + 1
    }
    return m
}

fn sum_list(xs: [float]) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(xs) {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

fn main() {
    print("=== phi_envelope_substrate smoke (F-EMIT-1..3 + 구조) ===")
    let mut npass = 0
    let mut ntotal = 0

    // 3-scale envelope: gamma ⊂ ultradian(90min) ⊂ circadian
    let periods = [1.0, 5400.0, 86400.0]
    let amps = [0.10, 1.0, 0.50]

    // E0: envelope_multiscale(t=0) → cos(0)=1 → Σ amps = 1.60
    ntotal = ntotal + 1
    if assert_close("E0 multiscale_t0", envelope_multiscale(0.0, periods, amps), 1.60, 1e-6) {
        npass = npass + 1
    }

    // F-EMIT-1 SELF-SIMILAR: 인접 scale 쌍 min r ≥ 0.76 (H_648)
    //   이상화 raised-cosine → rescaled shape 동일 → r=1.0 (실 CA 는 ~0.76 carry)
    let rs = envelope_self_similarity(periods, amps, 64)
    ntotal = ntotal + 1
    if assert_ge("F-EMIT-1 self_similar_minr", min_list(rs), 0.76) {
        npass = npass + 1
    }

    // F-EMIT-2 SUPER-ADDITIVE: collective Φ > Σ 개별 Φ (H_635)
    //   rule110 per-stage Φ (H_643/H_653 engine 일치) · class_id=3
    let phis = [1.17, 4.50, 13.64, 34.88]
    let nest = collective_phi_nest(phis, 3)
    ntotal = ntotal + 1
    if assert_ge("F-EMIT-2 super_additive", nest["phi_collective"] - sum_list(phis), 1e-6) {
        npass = npass + 1
    }

    // F-EMIT-3 NO-CLIFF: smooth ramp 의 max 1차차분 < cliff (H_649)
    let smooth = [0.10, 0.20, 0.30, 0.40, 0.50]
    let cliff = [0.10, 0.10, 0.90, 0.10]
    ntotal = ntotal + 1
    if assert_lt("F-EMIT-3 no_cliff_smooth", phi_smooth_no_cliff(smooth), 0.50) {
        npass = npass + 1
    }
    // cliff 대조: cliff series 는 큼 (≥ 0.50) — no-cliff 측정이 실작동 확인
    ntotal = ntotal + 1
    if assert_ge("F-EMIT-3 cliff_detected", phi_smooth_no_cliff(cliff), 0.50) {
        npass = npass + 1
    }

    // H_653 단조: coupling(II) < coupling(III) < coupling(IV)
    let c2 = pe_coupling_for_class(2)
    let c3 = pe_coupling_for_class(3)
    let c4 = pe_coupling_for_class(4)
    ntotal = ntotal + 1
    if assert_lt("H653 coupling_II_lt_III", c2, c3) {
        npass = npass + 1
    }
    ntotal = ntotal + 1
    if assert_lt("H653 coupling_III_lt_IV", c3, c4) {
        npass = npass + 1
    }

    // H_655 multi-axis (역전): super-add 는 class-II 最高 — convexity(IV 最高)와 반대 순위.
    //   coupling: II < IV (0.341 < 1.0)  vs  superadd: II > IV (1.0 > 0.809)
    let sa2 = pe_superadd_for_class(2)
    let sa4 = pe_superadd_for_class(4)
    ntotal = ntotal + 1
    if assert_lt("H655 superadd_IV_lt_II (역전)", sa4, sa2) {
        npass = npass + 1
    }
    // 다축성 직접 확인: 두 class-순위가 불일치 (단일 스칼라 환원 불가)
    let axis_disagree = (c2 < c4) && (sa2 > sa4)
    ntotal = ntotal + 1
    if assert_bool("H655 multi_axis_disagree", axis_disagree, true) {
        npass = npass + 1
    }

    // H_657 peak-align: III+IV 정렬(1.0) · II/additive 이탈(0.0) — 5번째 class-축
    let pa3 = pe_peak_align_for_class(3)
    let pa4 = pe_peak_align_for_class(4)
    let pa2 = pe_peak_align_for_class(2)
    ntotal = ntotal + 1
    if assert_bool("H657 peak_align_III_IV_aligned", (pa3 > 0.5) && (pa4 > 0.5), true) {
        npass = npass + 1
    }
    ntotal = ntotal + 1
    if assert_bool("H657 peak_align_II_deviate", pa2 < 0.5, true) {
        npass = npass + 1
    }

    // H_660 scale-invariance: norm_conv(Φ) == norm_conv(kΦ) (k 소거, shape만)
    let nc1 = pe_norm_convexity(10.0, 2.0, 6.0)
    let nc2 = pe_norm_convexity(100.0, 20.0, 60.0)   // 10×Φ
    let dnc = if nc1 - nc2 < 0.0 { nc2 - nc1 } else { nc1 - nc2 }
    ntotal = ntotal + 1
    if assert_bool("H660 scale_invariant (Φ→10Φ 불변)", dnc <= 1e-9, true) {
        npass = npass + 1
    }
    // H_660 class-monotone: norm_conv II < III < IV (scale 제거 후 단조 회복)
    let q2 = pe_norm_convexity_for_class(2)
    let q3 = pe_norm_convexity_for_class(3)
    let q4 = pe_norm_convexity_for_class(4)
    ntotal = ntotal + 1
    if assert_bool("H660 norm_conv_monotone II<III<IV", (q2 < q3) && (q3 < q4), true) {
        npass = npass + 1
    }
    // H_660 화해: norm_conv(IV) 단조 최고 = convexity(H_653) 순위 회복 (super-add 역전 아님)
    ntotal = ntotal + 1
    if assert_bool("H660 reconcile IV-highest (H_653 회복)", q4 > q2, true) {
        npass = npass + 1
    }

    // H_670 🟡 edge-of-chaos Φ-peak (inverse-U): order(die-out floor) < edge(peak) > chaos(decline).
    //   edge≈0.6 skew · ECA+logistic 동형 (Langton 확증) · 🟡 PARTIAL (Kuramoto floor caveat).
    let pk_order = pe_edge_of_chaos_peak(0.0)   // order = die-out floor
    let pk_edge  = pe_edge_of_chaos_peak(0.6)   // edge  = Φ peak (skew)
    let pk_edge2 = pe_edge_of_chaos_peak(0.5)   // edge 근방도 high
    let pk_chaos = pe_edge_of_chaos_peak(1.0)   // chaos = decline
    // peak(edge) > peak(order=0.0) — order 가 die-out floor
    ntotal = ntotal + 1
    if assert_lt("H670 edge_gt_order (die-out floor)", pk_order, pk_edge) {
        npass = npass + 1
    }
    // peak(edge) > peak(chaos=1.0) — chaos decline
    ntotal = ntotal + 1
    if assert_lt("H670 edge_gt_chaos (decline)", pk_chaos, pk_edge) {
        npass = npass + 1
    }
    // inverse-U skew 확인: edge≈0.5 도 high (peak 근방) · order(0)=floor 보다 큼
    ntotal = ntotal + 1
    if assert_lt("H670 inverse_U_skew (edge≈0.5 > floor)", pk_order, pk_edge2) {
        npass = npass + 1
    }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
