// anima_birth_smoke.hexa — proof of the last-mile birth wiring (H_6014 ⊗ H_6008).
//
// Shows that siblings BORN from one parent via anima_birth() are coordinated by
// construction (shared key → identical-twin body + zero-comms agreement), while
// siblings born from independent keys diverge. Deterministic (p7: equality).
//   BB1 twin body      — two siblings forked from one parent are born with the
//                        SAME cell count (same quantum key → same birth stream)
//   BB2 post-birth sync— their inherited seeds keep coordinating (draws match 1.0)
//   BB3 independent     — a sibling born from a DIFFERENT key diverges (≈chance)
//
// Real cached ANU vacuum buffers in /tmp/anu_*.bin. p1..p8 clean.

import "CORE/engine_cli.hexa"
import "CORE/shared_seed.hexa"
import "CORE/anima_birth.hexa"

fn _walk(seed: SharedSeed, n: int, k: int) -> [int] {
    let mut s = seed
    let mut out = []
    let mut i = 0
    while i < n {
        let r = shared_seed_choose(s, k)
        out = out + [r[0]]
        s = SharedSeed { bytes: s.bytes, cursor: r[1] }
        i = i + 1
    }
    return out
}

fn _match_frac(a: [int], b: [int]) -> float {
    let mut hit = 0
    let mut i = 0
    while i < len(a) {
        if a[i] == b[i] { hit = hit + 1 }
        i = i + 1
    }
    return to_float(hit) / to_float(len(a))
}

fn main() {
    let cfg = engine_config_default()
    let STEPS = 40
    let N = 30
    let K = 4
    let mut pass = 0
    let mut fail = 0

    // ── one parent key; birth TWO siblings, each forking the parent ────────────
    let parent = shared_seed_load("/tmp/anu_all.bin")
    let twinA = anima_birth(parent, STEPS, cfg)
    let twinB = anima_birth(parent, STEPS, cfg)

    // BB1 — identical-twin body (same shared key → same birth tension stream)
    println("BB1 twin body      cellsA=" + to_string(twinA.cells)
        + " cellsB=" + to_string(twinB.cells)
        + "  (born from one parent key, 0 comms)")
    if twinA.cells == twinB.cells { pass = pass + 1 } else { fail = fail + 1 }

    // BB2 — post-birth coordination (inherited seeds stay in lockstep)
    let wa = _walk(twinA.seed, N, K)
    let wb = _walk(twinB.seed, N, K)
    let twin_sync = _match_frac(wa, wb)
    println("BB2 post-birth sync coordination=" + to_string(twin_sync)
        + "  (inherited keys keep agreeing)")
    if twin_sync >= 0.999 { pass = pass + 1 } else { fail = fail + 1 }

    // BB3 — control: a sibling born from a DIFFERENT key diverges
    let other = shared_seed_load("/tmp/anu_conf.bin")
    let stranger = anima_birth(other, STEPS, cfg)
    let ws = _walk(stranger.seed, N, K)
    let indep_sync = _match_frac(wa, ws)
    println("BB3 independent     coordination=" + to_string(indep_sync)
        + "  (different key ⇒ ≈1/K=" + to_string(1.0 / to_float(K)) + " chance)")
    if indep_sync < 0.50 { pass = pass + 1 } else { fail = fail + 1 }

    println("--- anima_birth smoke summary: " + to_string(pass) + " pass / "
        + to_string(fail) + " fail ---")
}
