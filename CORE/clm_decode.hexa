// clm_decode.hexa — CORE-native .clm DECODE FORWARD (the AXIS-2 CE unblock).
//
// This is the weight-decode backend that generator.hexa::_gen_clm_decode plugs
// into. It is imported ONLY by generator.hexa, so the SINGLE .clm entry point
// (a_core_engine_map: .clm enters CORE via the generator L3 slot) is PRESERVED —
// this is a helper of that one slot, not a second path.
//
// What it does (HONEST, no fabrication):
//   · parses the 6 int4-sym conv blocks of a .clm (CLM\x01 magic + nblocks),
//     dequantizing each weight DIRECTLY as w = code·scale (the blocks already
//     hold int4 codes + per-channel fp32 scale — inference dequant, no re-QAT);
//   · parses the v0.2 CLMX trailer (embed table + conv biases + GroupNorm affine,
//     full-precision fp32) — REQUIRED for a forward, since the embed/GN params
//     are NOT in the 6 conv blocks;
//   · runs the CLMConvMoE inference forward (embed → conv ec → conv tc + GN +
//     GELU residual → router → 2 experts + GELU → MoE mix → GN → readout conv)
//     producing per-position logits[T·V];
//   · computes mean cross-entropy over real-corpus causal windows AND a
//     uniform-CE = ln(V) baseline AND a label-permuted (shuffle) baseline.
//
// HONEST scope (a_scale_honest_scope · p7):
//   · A v0.1 file (6 conv blocks, NO CLMX trailer) is NOT decodable — the embed
//     table + GN affine are absent, so the forward cannot run. clm_decodable()
//     returns false for it and the caller keeps loaded=false (null fallthrough).
//     This is why gen_clm_backend gates loaded on clm_decodable, not just valid.
//   · CE is ONE axis, deterministic (model_ce < uniform AND < shuffle), NOT a
//     perplexity-as-truth verdict (p7).
//
// Architecture constants are recovered from the block dims (d, E, V, K) so the
// same decoder serves d=8 and d=768 without a hard-coded width.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/gn_lib"
use "stdlib/flame/moe_lib"
use "stdlib/flame/nn_lib"

fn _clmd_rd_u32(rb, off: int) -> int {
    return rb[off] + rb[off+1]*0x100 + rb[off+2]*0x10000 + rb[off+3]*0x1000000
}

// clm_decodable — true ⇔ valid CLM\x01 header AND a v0.2 CLMX trailer is present
// (the embed/GN/bias params a forward needs). A v0.1 file → false (honest).
pub fn clm_decodable(p: string) -> bool {
    if byte_len(p) == 0 { return false }
    let rb = read_file_bytes(p)
    if len(rb) < 5 { return false }
    if !(rb[0]==67 && rb[1]==76 && rb[2]==77 && rb[3]==1) { return false }
    let nblk = rb[4]
    // walk the nblk conv blocks to find the trailer offset
    let mut off = 5
    let mut b = 0
    while b < nblk {
        if off + 8 > len(rb) { return false }
        let cout = _clmd_rd_u32(rb, off)
        let rest = _clmd_rd_u32(rb, off+4)
        off = off + 8
        let n = cout * rest
        off = off + (n + 1) / 2          // int4 nibbles (2/byte)
        off = off + cout * 4             // per-channel fp32 scale
        b = b + 1
    }
    if off + 5 > len(rb) { return false }
    return rb[off]==67 && rb[off+1]==76 && rb[off+2]==77 && rb[off+3]==88   // "CLMX"
}

// clm_config — recover (d, K, V, E, L, nblk) from the .clm header structure WITHOUT
// loading weights or touching the GPU. E = cout of router block (idx nblk-2),
// V = cout of readout block (idx nblk-1), d/K from block0, L = nblk - E - 3.
// At nblk=6 → L=1,E=2 (legacy). Returns #{ok:false} if not decodable.
pub fn clm_config(p: string) -> Map {
    if !clm_decodable(p) { return #{ "ok": false } }
    let rb = read_file_bytes(p)
    let nblk = rb[4]
    let d = _clmd_rd_u32(rb, 5)
    let rest0 = _clmd_rd_u32(rb, 9)
    let K = rest0 / d
    let mut off = 5
    let mut bi = 0
    let mut E = 2; let mut V = 256
    while bi < nblk {
        let c = _clmd_rd_u32(rb, off)
        let r = _clmd_rd_u32(rb, off + 4)
        if bi == nblk - 2 { E = c }
        if bi == nblk - 1 { V = c }
        let n = c * r
        off = off + 8 + (n + 1) / 2 + c * 4
        bi = bi + 1
    }
    let L = nblk - E - 3
    return #{ "ok": true, "d": d, "K": K, "V": V, "E": E, "L": L, "nblk": nblk }
}

// load one int4 conv block, dequantized in place (w = code·scale). Returns new off.
fn _clmd_load_block(rb, off: int, w_out: int) -> int {
    let cout = _clmd_rd_u32(rb, off); off = off + 4
    let rest = _clmd_rd_u32(rb, off); off = off + 4
    let n = cout * rest
    let codes = t_zeros(n)
    let mut i = 0
    while i < n {
        let byte = rb[off]; off = off + 1
        t_set(codes, i, to_float((byte & 0xF) - 8))
        if i + 1 < n { t_set(codes, i + 1, to_float(((byte / 16) & 0xF) - 8)) }
        i = i + 2
    }
    let mut co = 0
    while co < cout {
        let s = bytes_to_f32_le(rb, off); off = off + 4
        let mut j = 0
        while j < rest { t_set(w_out, co*rest+j, t_get(codes, co*rest+j) * s); j = j + 1 }
        co = co + 1
    }
    t_free(codes)
    return off
}

fn _clmd_load_ext(rb, off: int, t_out: int) -> int {
    let n = _clmd_rd_u32(rb, off); off = off + 4
    let mut i = 0
    while i < n { t_set(t_out, i, bytes_to_f32_le(rb, off)); off = off + 4; i = i + 1 }
    return off
}

// causal dilated conv1d via forge matmul (byte-eq to clm_prod conv1d_via_forge).
fn _clmd_conv1d(x: int, w: int, b: int, y_out: int,
                T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t*Kdim + ci*K + k, t_get(x, p*Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j*Cout + co, t_get(w, co*Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2*Cout + c2, t_get(mm, t2*Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(Wt)
}

// clm_forward_ce — load the .clm at `path`, run the CLMConvMoE inference forward
// over `nwin_max` causal windows of the byte-corpus at `corpus`, and return a Map
//   #{ ok, windows, model_ce, shuffle_ce, uniform_ce, lt_uniform, lt_shuffle, green }
// ok=false (with reason) if the file is not v0.2-decodable.
pub fn clm_forward_ce(path: string, corpus: string, nwin_max: int) -> Map {
    if !clm_decodable(path) {
        return #{ "ok": false, "reason": "not v0.2-decodable (no CLMX trailer; embed/GN absent)",
                  "green": false, "model_ce": 0.0, "shuffle_ce": 0.0, "uniform_ce": 0.0,
                  "windows": 0 }
    }
    // GENERAL (L,E) load (v0.3): derive E from the router block (idx nblk-2,
    // cout=E), V from the readout block (idx nblk-1, cout=V), and the trunk
    // depth L = nblk - E - 3. At nblk=6 this gives L=1,E=2 (legacy v0.2).
    let W = _clmd_load(path)
    let d = to_int(W["d"]); let E = to_int(W["E"]); let V = to_int(W["V"]); let K = to_int(W["K"])

    let bytes_arr = read_file_bytes(corpus)
    let n_bytes = len(bytes_arr)
    let T = 24
    let mut stride = (n_bytes - T - 1) / nwin_max
    if stride < 1 { stride = 1 }

    let logits = t_zeros(T*V)
    let tok = t_zeros(T); let tgt = t_zeros(T)
    let mut sum_model = 0.0; let mut sum_shuf = 0.0; let mut nwin = 0
    let mut s = 0
    while s < nwin_max {
        let base = s * stride
        if base + T + 1 <= n_bytes {
            let mut p = 0
            while p < T {
                t_set(tok, p, to_float(bytes_arr[base + p]))
                t_set(tgt, p, to_float(bytes_arr[base + p + 1]))
                p = p + 1
            }
            // ── inference forward (general L trunk · E experts) ──
            _clmd_fwd_logits(W, tok, logits, T)

            let ce = nn_ce_loss_allpos(logits, tgt, T, V)
            sum_model = sum_model + ce
            let tgt_sh = t_zeros(T)
            let mut q = 0
            while q < T { t_set(tgt_sh, q, t_get(tgt, T-1-q)); q = q + 1 }
            sum_shuf = sum_shuf + nn_ce_loss_allpos(logits, tgt_sh, T, V)
            t_free(tgt_sh)
            nwin = nwin + 1
        }
        s = s + 1
    }
    let model_ce = sum_model / to_float(nwin)
    let shuf_ce  = sum_shuf / to_float(nwin)
    let uniform_ce = dt_ln(to_float(V))
    let lt_u = model_ce < uniform_ce
    let lt_s = model_ce < shuf_ce
    return #{ "ok": true, "reason": "v0.2/v0.3 decodable; forward ran",
              "windows": nwin, "d": d, "E": E, "V": V, "K": K, "L": to_int(W["L"]),
              "model_ce": model_ce, "shuffle_ce": shuf_ce, "uniform_ce": uniform_ce,
              "lt_uniform": lt_u, "lt_shuffle": lt_s, "green": lt_u && lt_s }
}

// _clmd_load — shared loader: parse the (L+E+3) conv blocks + CLMX trailer into
// a weight Map. GENERAL (v0.3): E, V, L are derived from block structure, so
// the SAME loader serves L=1/E=2 (legacy v0.2) and any L/E (e.g. the 3B
// L=30/E=30 rung). Trunk & expert weights/biases/GN are kept as handle arrays
// (tcW[i], eW[j], tcB[i], eB[j], tgG[i], tgB[i]) so the forward loops generally.
// Caller must have checked clm_decodable(path). Returns the param record.
fn _clmd_load(path: string) -> Map {
    let rb = read_file_bytes(path)
    let nblk = rb[4]
    let d = _clmd_rd_u32(rb, 5)
    let rest0 = _clmd_rd_u32(rb, 9)
    let K = rest0 / d
    // router block = idx nblk-2 (cout=E); readout = idx nblk-1 (cout=V).
    // walk block headers to read those cout values (each header = cout,rest u32).
    let mut woff = 5
    let mut bi = 0
    let mut E = 2; let mut V = 256
    while bi < nblk {
        let c = _clmd_rd_u32(rb, woff)
        let r = _clmd_rd_u32(rb, woff + 4)
        if bi == nblk - 2 { E = c }
        if bi == nblk - 1 { V = c }
        let n = c * r
        woff = woff + 8 + (n + 1) / 2 + c * 4
        bi = bi + 1
    }
    let L = nblk - E - 3
    let dd = d*d*K; let ed = E*d; let vd = V*d

    let ecW = t_zeros(dd)
    let tcW = []; let mut li = 0
    while li < L { tcW.push(t_zeros(dd)); li = li + 1 }
    let eW = []; let mut ej = 0
    while ej < E { eW.push(t_zeros(dd)); ej = ej + 1 }
    let rW = t_zeros(ed); let roW = t_zeros(vd)

    let mut off = 5
    off = _clmd_load_block(rb, off, ecW)
    let mut i2 = 0
    while i2 < L { off = _clmd_load_block(rb, off, tcW[i2]); i2 = i2 + 1 }
    let mut j2 = 0
    while j2 < E { off = _clmd_load_block(rb, off, eW[j2]); j2 = j2 + 1 }
    off = _clmd_load_block(rb, off, rW)
    off = _clmd_load_block(rb, off, roW)
    off = off + 5                              // skip "CLMX" + n_ext byte

    let embed = t_zeros(vd); let ecB = t_zeros(d)
    let tcB = []; let mut i3 = 0
    while i3 < L { tcB.push(t_zeros(d)); i3 = i3 + 1 }
    let eB = []; let mut j3 = 0
    while j3 < E { eB.push(t_zeros(d)); j3 = j3 + 1 }
    let rB = t_zeros(E); let roB = t_zeros(V)
    let tgG = []; let mut i4 = 0
    while i4 < L { tgG.push(t_zeros(d)); i4 = i4 + 1 }
    let tgB = []; let mut i5 = 0
    while i5 < L { tgB.push(t_zeros(d)); i5 = i5 + 1 }
    let noG = t_zeros(d); let noB = t_zeros(d)

    off = _clmd_load_ext(rb, off, embed)
    off = _clmd_load_ext(rb, off, ecB)
    let mut a = 0
    while a < L { off = _clmd_load_ext(rb, off, tcB[a]); a = a + 1 }
    let mut b = 0
    while b < E { off = _clmd_load_ext(rb, off, eB[b]); b = b + 1 }
    off = _clmd_load_ext(rb, off, rB);   off = _clmd_load_ext(rb, off, roB)
    let mut c2 = 0
    while c2 < L { off = _clmd_load_ext(rb, off, tgG[c2]); c2 = c2 + 1 }
    let mut e2 = 0
    while e2 < L { off = _clmd_load_ext(rb, off, tgB[e2]); e2 = e2 + 1 }
    off = _clmd_load_ext(rb, off, noG);  off = _clmd_load_ext(rb, off, noB)

    return #{ "d": d, "E": E, "V": V, "K": K, "L": L, "vd": vd,
              "ecW": ecW, "tcW": tcW, "eW": eW, "rW": rW, "roW": roW,
              "embed": embed, "ecB": ecB, "tcB": tcB, "eB": eB,
              "rB": rB, "roB": roB, "tgG": tgG, "tgB": tgB, "noG": noG, "noB": noB }
}

// ════════════════════════════════════════════════════════════════════════
// H_1393 — STREAMING / BOUNDED ConvMoE decode (the memory-blowup FIX).
// ------------------------------------------------------------------------
// ROOT CAUSE (measured, /usr/bin/time -l): the hexa runtime is a one-shot
// BUMP allocator — `free()` is a NOOP and `farr_free` releases the handle slot
// but NEVER returns the backing buffer bytes (self/runtime.c "Cycle 53 —
// mmap-backed bump allocator. malloc never frees; free is a noop"). So every
// per-step `t_zeros` and every internal `forge_dispatch_matmul` output PERMA-
// NENTLY consumes memory until process exit, regardless of the careful `t_free`
// calls in _clmd_fwd_logits. At d768/T24 that is ~63 MB/step (303M ConvMoE
// cout=5008 → ~300 MB/step), linear in GEN → OOM by GEN≈24 (H_1392 WALL).
//
// THE FIX (anima-side, byte-exact): the per-step churn is dominated (~92 %) by
// the conv WEIGHT TRANSPOSE `Wt` (re-built every step though the weights never
// change) plus reusable scratch tensors. So: pre-allocate ALL forward scratch +
// pre-transpose EVERY conv weight ONCE into a scratch record (_clmd_scratch_new),
// then REUSE those same farr handles every decode step (_clmd_fwd_logits_sc).
// A reused handle keeps its already-mmap'd buffer (no new bump bytes), so RSS
// goes FLAT across steps. The ONLY residual per-step alloc is the runtime's
// internal matmul output (~0.6 MB/step at d768) which the runtime allocates and
// we free (noop, but the handle slot recycles) — the upstream bump-allocator
// floor, filed to hexa-lang. The ARITHMETIC is UNCHANGED: same conv/GN/GELU/MoE
// ops, same order, same values → generation is BYTE-IDENTICAL (H_1393 guard).
//
// _clmd_zero — zero a farr's first n elements in place (causal-pad reset for a
// reused xcol; only p>=0 cols are written by the conv, the rest must read 0).
fn _clmd_zero(t: int, n: int) {
    let mut i = 0
    while i < n { t_set(t, i, 0.0); i = i + 1 }
}

// _clmd_transpose_w — pre-transpose a conv weight w[co*Kdim+j] into Wt[j*Cout+co]
// ONCE (identical every step). Returns a fresh farr (kept in the scratch record).
fn _clmd_transpose_w(w: int, Kdim: int, Cout: int) -> int {
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j*Cout + co, t_get(w, co*Kdim + j)); j = j + 1 }
        co = co + 1
    }
    return Wt
}

// _clmd_conv1d_pre — conv1d using a PRE-TRANSPOSED weight `Wt` and a caller-owned
// REUSABLE `xcol` (re-zeroed here for causal padding). Byte-eq to _clmd_conv1d:
// same im2col gather + same forge matmul + same bias add, only without per-call
// alloc of xcol/Wt. The forge matmul output `mm` is freed each call (the runtime
// allocates it internally — unavoidable; ~T*Cout doubles, the residual floor).
fn _clmd_conv1d_pre(x: int, Wt: int, b: int, y_out: int, xcol: int,
                    T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    _clmd_zero(xcol, T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t*Kdim + ci*K + k, t_get(x, p*Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2*Cout + c2, t_get(mm, t2*Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(mm)
}

// _clmd_scratch_new — build the REUSABLE forward scratch record ONCE per decode
// (pre-transposed conv weights + every t_zeros buffer the forward needs). All
// handles are reused every step → no per-step bump-allocator growth. Freed by
// _clmd_scratch_free after the decode loop.
fn _clmd_scratch_new(W: Map, T: int) -> Map {
    let d = to_int(W["d"]); let E = to_int(W["E"]); let V = to_int(W["V"])
    let K = to_int(W["K"]); let L = to_int(W["L"])
    let Kd = d * K
    // pre-transposed weights (constant across steps)
    let ecWt = _clmd_transpose_w(to_int(W["ecW"]), Kd, d)
    let tcWt = []; let tcW = W["tcW"]; let mut i = 0
    while i < L { tcWt.push(_clmd_transpose_w(to_int(tcW[i]), Kd, d)); i = i + 1 }
    let eWt = []; let eW = W["eW"]; let mut j = 0
    while j < E { eWt.push(_clmd_transpose_w(to_int(eW[j]), Kd, d)); j = j + 1 }
    let rWt  = _clmd_transpose_w(to_int(W["rW"]),  d * 1, E)   // router K=1
    let roWt = _clmd_transpose_w(to_int(W["roW"]), d * 1, V)   // readout K=1
    // reusable im2col buffers: the d-conv ones share T*Kd; router/readout K=1 → T*d
    let xcolD = t_zeros(T * Kd)     // for ec/trunk/expert convs (Kdim=d*K)
    let xcol1 = t_zeros(T * d)      // for router/readout convs   (Kdim=d*1)
    // reusable activation buffers
    let xe = t_zeros(T*d); let xt = t_zeros(T*d)
    let h = t_zeros(T*d); let hn = t_zeros(T*d); let hg = t_zeros(T*d)
    let m1 = t_zeros(1); let iv1 = t_zeros(1); let xh1 = t_zeros(T*d)
    let logits_r = t_zeros(T*E); let ex_out = t_zeros(E*T*d)
    let eo = t_zeros(T*d); let ex = t_zeros(T*d)
    let probs = t_zeros(T*E); let y = t_zeros(T*d)
    let yn = t_zeros(T*d); let meanN = t_zeros(1); let invN = t_zeros(1); let xhatN = t_zeros(T*d)
    return #{ "ecWt": ecWt, "tcWt": tcWt, "eWt": eWt, "rWt": rWt, "roWt": roWt,
              "xcolD": xcolD, "xcol1": xcol1, "xe": xe, "xt": xt,
              "h": h, "hn": hn, "hg": hg, "m1": m1, "iv1": iv1, "xh1": xh1,
              "logits_r": logits_r, "ex_out": ex_out, "eo": eo, "ex": ex,
              "probs": probs, "y": y, "yn": yn,
              "meanN": meanN, "invN": invN, "xhatN": xhatN }
}

fn _clmd_scratch_free(sc: Map) {
    t_free(to_int(sc["ecWt"])); t_free(to_int(sc["rWt"])); t_free(to_int(sc["roWt"]))
    let tcWt = sc["tcWt"]; let mut i = 0
    while i < len(tcWt) { t_free(to_int(tcWt[i])); i = i + 1 }
    let eWt = sc["eWt"]; let mut j = 0
    while j < len(eWt) { t_free(to_int(eWt[j])); j = j + 1 }
    t_free(to_int(sc["xcolD"])); t_free(to_int(sc["xcol1"]))
    t_free(to_int(sc["xe"])); t_free(to_int(sc["xt"]))
    t_free(to_int(sc["h"])); t_free(to_int(sc["hn"])); t_free(to_int(sc["hg"]))
    t_free(to_int(sc["m1"])); t_free(to_int(sc["iv1"])); t_free(to_int(sc["xh1"]))
    t_free(to_int(sc["logits_r"])); t_free(to_int(sc["ex_out"]))
    t_free(to_int(sc["eo"])); t_free(to_int(sc["ex"]))
    t_free(to_int(sc["probs"])); t_free(to_int(sc["y"])); t_free(to_int(sc["yn"]))
    t_free(to_int(sc["meanN"])); t_free(to_int(sc["invN"])); t_free(to_int(sc["xhatN"]))
}

// _clmd_fwd_logits_sc — STREAMING forward: byte-identical to _clmd_fwd_logits but
// every conv uses the pre-transposed Wt + a reused xcol, and every activation
// buffer is reused from the scratch record `sc`. Reused buffers that the consuming
// op fully overwrites (conv writes all T*Cout, GN/GELU write all T*d) need no
// re-zero; only the im2col xcol's causal padding is reset (inside _clmd_conv1d_pre).
fn _clmd_fwd_logits_sc(W: Map, sc: Map, tok: int, out_logits: int, T: int) {
    let d = to_int(W["d"]); let E = to_int(W["E"]); let V = to_int(W["V"])
    let K = to_int(W["K"]); let L = to_int(W["L"])
    let embed = to_int(W["embed"])
    let tcB = W["tcB"]; let eB = W["eB"]; let tgG = W["tgG"]; let tgB = W["tgB"]
    let tcWt = sc["tcWt"]; let eWt = sc["eWt"]
    let xcolD = to_int(sc["xcolD"]); let xcol1 = to_int(sc["xcol1"])
    let xe = to_int(sc["xe"]); let xt = to_int(sc["xt"])

    nn_embedding_fwd(tok, embed, xe, T, d)
    _clmd_conv1d_pre(xe, to_int(sc["ecWt"]), to_int(W["ecB"]), xt, xcolD, T, d, d, K, 1)

    let DIL_CAP = 512
    let h = to_int(sc["h"]); let hn = to_int(sc["hn"]); let hg = to_int(sc["hg"])
    let m1 = to_int(sc["m1"]); let iv1 = to_int(sc["iv1"]); let xh1 = to_int(sc["xh1"])
    let mut li = 0
    let mut dil = 1
    while li < L {
        let mut dil_eff = dil
        if dil_eff > DIL_CAP { dil_eff = DIL_CAP }
        _clmd_conv1d_pre(xt, to_int(tcWt[li]), to_int(tcB[li]), h, xcolD, T, d, d, K, dil_eff)
        nn_groupnorm_fwd(h, to_int(tgG[li]), to_int(tgB[li]), hn, m1, iv1, xh1, T, d, 1)
        nn_gelu_fwd(hn, hg, T*d)
        let mut i = 0
        while i < T*d { t_set(xt, i, t_get(xt, i) + t_get(hg, i)); i = i + 1 }
        dil = dil * 2
        li = li + 1
    }

    let logits_r = to_int(sc["logits_r"])
    _clmd_conv1d_pre(xt, to_int(sc["rWt"]), to_int(W["rB"]), logits_r, xcol1, T, d, E, 1, 1)
    let ex_out = to_int(sc["ex_out"]); let eo = to_int(sc["eo"]); let ex = to_int(sc["ex"])
    let mut ej = 0
    while ej < E {
        _clmd_conv1d_pre(xt, to_int(eWt[ej]), to_int(eB[ej]), eo, xcolD, T, d, d, K, 1)
        nn_gelu_fwd(eo, ex, T*d)
        let mut jj = 0
        while jj < T*d { t_set(ex_out, ej*T*d + jj, t_get(ex, jj)); jj = jj + 1 }
        ej = ej + 1
    }
    let probs = to_int(sc["probs"]); let y = to_int(sc["y"])
    nn_moe_router_fwd(logits_r, ex_out, probs, y, T, E, d)
    let yn = to_int(sc["yn"]); let meanN = to_int(sc["meanN"])
    let invN = to_int(sc["invN"]); let xhatN = to_int(sc["xhatN"])
    nn_groupnorm_fwd(y, to_int(W["noG"]), to_int(W["noB"]), yn, meanN, invN, xhatN, T, d, 1)
    _clmd_conv1d_pre(yn, to_int(sc["roWt"]), to_int(W["roB"]), out_logits, xcol1, T, d, V, 1, 1)
}

// _clmd_fwd_logits — run the general CLMConvMoE inference forward on a T-length
// token buffer using a loaded param Map; fill out_logits[T·V]. Loops over the L
// trunk layers (residual conv → GN → GELU) and stacks the E expert conv outputs
// before the softmax MoE router mix.
//
// NOTE: this is the ORIGINAL per-call-alloc path, kept BYTE-IDENTICAL and still
// used by the single-shot CE/omega measurements (clm_forward_ce, clm_omega_closure)
// where the forward runs a bounded nwin_max times, not a growing decode loop. The
// streaming decode loops (argmax/topk/grounded) use _clmd_fwd_logits_sc instead.
fn _clmd_fwd_logits(W: Map, tok: int, out_logits: int, T: int) {
    let d = to_int(W["d"]); let E = to_int(W["E"]); let V = to_int(W["V"])
    let K = to_int(W["K"]); let L = to_int(W["L"])
    let embed = to_int(W["embed"])
    let tcW = W["tcW"]; let eW = W["eW"]; let tcB = W["tcB"]
    let eB = W["eB"]; let tgG = W["tgG"]; let tgB = W["tgB"]

    let xe = t_zeros(T*d); nn_embedding_fwd(tok, embed, xe, T, d)
    let xt = t_zeros(T*d); _clmd_conv1d(xe, to_int(W["ecW"]), to_int(W["ecB"]), xt, T, d, d, K, 1)

    // L trunk layers: residual( GELU( GN( conv(x) ) ) ). dilation = min(2^layer, 512)
    // (CausalDilatedConv1d in model.py uses min(dilation_base**i, max_dilation=512)).
    // The cap MUST match model.py exactly, else a deep-L .clm decodes differently than
    // it trained. At L=1: min(2^0,512)=1 so the golden ref is byte-eq-unchanged.
    let DIL_CAP = 512
    let mut li = 0
    let mut dil = 1
    while li < L {
        let mut dil_eff = dil
        if dil_eff > DIL_CAP { dil_eff = DIL_CAP }
        let h = t_zeros(T*d); _clmd_conv1d(xt, to_int(tcW[li]), to_int(tcB[li]), h, T, d, d, K, dil_eff)
        let hn = t_zeros(T*d); let m1 = t_zeros(1); let iv1 = t_zeros(1); let xh1 = t_zeros(T*d)
        nn_groupnorm_fwd(h, to_int(tgG[li]), to_int(tgB[li]), hn, m1, iv1, xh1, T, d, 1)
        let hg = t_zeros(T*d); nn_gelu_fwd(hn, hg, T*d)
        let mut i = 0
        while i < T*d { t_set(xt, i, t_get(xt, i) + t_get(hg, i)); i = i + 1 }
        t_free(h); t_free(hn); t_free(m1); t_free(iv1); t_free(xh1); t_free(hg)
        dil = dil * 2
        li = li + 1
    }

    let logits_r = t_zeros(T*E); _clmd_conv1d(xt, to_int(W["rW"]), to_int(W["rB"]), logits_r, T, d, E, 1, 1)
    // E experts: GELU(conv(xt)); stacked into ex_out[e·T·d] for the router.
    let ex_out = t_zeros(E*T*d)
    let mut ej = 0
    while ej < E {
        let eo = t_zeros(T*d); _clmd_conv1d(xt, to_int(eW[ej]), to_int(eB[ej]), eo, T, d, d, K, 1)
        let ex = t_zeros(T*d); nn_gelu_fwd(eo, ex, T*d)
        let mut jj = 0
        while jj < T*d { t_set(ex_out, ej*T*d + jj, t_get(ex, jj)); jj = jj + 1 }
        t_free(eo); t_free(ex)
        ej = ej + 1
    }
    let probs = t_zeros(T*E); let y = t_zeros(T*d)
    nn_moe_router_fwd(logits_r, ex_out, probs, y, T, E, d)
    let yn = t_zeros(T*d); let meanN = t_zeros(1); let invN = t_zeros(1); let xhatN = t_zeros(T*d)
    nn_groupnorm_fwd(y, to_int(W["noG"]), to_int(W["noB"]), yn, meanN, invN, xhatN, T, d, 1)
    _clmd_conv1d(yn, to_int(W["roW"]), to_int(W["roB"]), out_logits, T, d, V, 1, 1)
    t_free(xe); t_free(xt); t_free(logits_r); t_free(ex_out)
    t_free(probs); t_free(y); t_free(yn); t_free(meanN); t_free(invN); t_free(xhatN)
}

// clm_omega_closure — OMEGA OΩ6 closure ON THE REAL PRODUCTION CONV .clm.
// ---------------------------------------------------------------------------
// Every prior OMEGA rung (OΩ1..OΩ7, OH1) ran the substrate→decode closure on
// CDV2 (a torch transformer whose readout = `base` and whose dual A/G heads =
// the substrate). OΩ6 asks: does the SAME OMEGA min-gate (gB·base + gA·A,
// the OH1 honest form) modulate the PRODUCTION conv .clm (CLMConvMoE) byte
// decode — i.e. L3 loaded=true on conv, the real .clm mouth, not the cdv2/omega
// stub? This fn answers it with a REAL measurement (p7, no fabrication).
//
// It loads the real conv .clm, runs the genuine CLMConvMoE forward to obtain
// `base` next-byte logits, then applies omega_coupling_apply's min-gate form
// (gB·base + gA·A) at each position, and reports base CE vs gated CE over real
// corpus windows. Two HONEST A-head modes (the architectural crux of OΩ6):
//
//   mode "self"  (a_mode=0): A := the conv .clm's OWN next-byte logits. This is
//     the ONLY A-head NATIVE to the conv substrate — CLMConvMoE is a SINGLE-head
//     byte LM (model.py: self.readout → next-byte; NO Engine-A/G dual-head; that
//     dual-head lives ONLY in CDV2). With A==base the gate is gB·base+gA·base =
//     (gB+gA)·base: a pure per-position TEMPERATURE rescale of one logit vector.
//     Under softmax CE this changes the value but carries NO new information — it
//     is NOT a substrate→decode coupling, it is self-rescaling. The measurement
//     proves this is a degenerate (CE-monotone-in-(gB+gA)) non-closure.
//
//   mode "oracle" (a_mode=1): A := a leak-FREE one-hot oracle logit on the true
//     next byte (the strongest possible external A-head). This bounds what ANY
//     genuine external A-wire COULD do on the real conv base, and shows the bus
//     plumbing is correct (gA>0 → CE drops toward the oracle). It is NOT a real
//     substrate (it peeks the label) — reported ONLY as the coupling-plumbing
//     upper bound, never as a closure claim (the real substrate A is CDV2, which
//     is the SEPARATE engine + the lookahead-leak caveat of #1791/#1800).
//
// Returns #{ ok, windows, d,E,V, base_ce, gated_ce_self, gated_ce_oracle,
//            gB, gA, a_mode_self_is_rescale, oracle_helps }.  a_core_engine_map:
// this is a helper of the SINGLE .clm decode entry (imports nothing new), no 2nd
// path, no phantom wiring — it shapes WHICH byte from a real .clm, never speaks.
pub fn clm_omega_closure(path: string, corpus: string, nwin_max: int,
                         gB: float, gA: float) -> Map {
    if !clm_decodable(path) {
        return #{ "ok": false, "reason": "not v0.2-decodable", "windows": 0,
                  "base_ce": 0.0, "gated_ce_self": 0.0, "gated_ce_oracle": 0.0 }
    }
    let W = _clmd_load(path)
    let d = to_int(W["d"]); let E = to_int(W["E"]); let V = to_int(W["V"])
    let bytes_arr = read_file_bytes(corpus)
    let n_bytes = len(bytes_arr)
    let T = 24
    let mut stride = (n_bytes - T - 1) / nwin_max
    if stride < 1 { stride = 1 }

    let logits = t_zeros(T*V)        // real conv .clm base logits
    let gated_self = t_zeros(T*V)    // (gB+gA)·base  (A==base self-coupling)
    let gated_orac = t_zeros(T*V)    // gB·base + gA·oracle(true-next)
    let tok = t_zeros(T); let tgt = t_zeros(T)
    let mut sum_base = 0.0; let mut sum_self = 0.0; let mut sum_orac = 0.0
    let mut nwin = 0
    let mut s = 0
    while s < nwin_max {
        let base_off = s * stride
        if base_off + T + 1 <= n_bytes {
            let mut p = 0
            while p < T {
                t_set(tok, p, to_float(bytes_arr[base_off + p]))
                t_set(tgt, p, to_float(bytes_arr[base_off + p + 1]))
                p = p + 1
            }
            // REAL conv .clm forward → base byte logits (the production mouth)
            _clmd_fwd_logits(W, tok, logits, T)
            // apply the OMEGA min-gate per position: self (A==base) + oracle
            let mut q = 0
            while q < T {
                let tgtb = to_int(t_get(tgt, q))
                let mut v = 0
                while v < V {
                    let bl = t_get(logits, q*V + v)
                    // self: A==base  → gB·base + gA·base = (gB+gA)·base
                    t_set(gated_self, q*V + v, gB*bl + gA*bl)
                    // oracle: A = one-hot logit (big on the true next byte)
                    let aol = if v == tgtb { 12.0 } else { 0.0 }
                    t_set(gated_orac, q*V + v, gB*bl + gA*aol)
                    v = v + 1
                }
                q = q + 1
            }
            sum_base = sum_base + nn_ce_loss_allpos(logits, tgt, T, V)
            sum_self = sum_self + nn_ce_loss_allpos(gated_self, tgt, T, V)
            sum_orac = sum_orac + nn_ce_loss_allpos(gated_orac, tgt, T, V)
            nwin = nwin + 1
        }
        s = s + 1
    }
    let base_ce = sum_base / to_float(nwin)
    let self_ce = sum_self / to_float(nwin)
    let orac_ce = sum_orac / to_float(nwin)
    // self-coupling is a pure rescale ⇔ it carries no NEW info: with gB+gA==1 the
    // softmax is unchanged so self_ce == base_ce (CE identical). We report whether
    // the self gate is just a rescale (|self_ce - base_ce@(gB+gA=1)| ~ 0).
    return #{ "ok": true, "windows": nwin, "d": d, "E": E, "V": V,
              "base_ce": base_ce, "gated_ce_self": self_ce, "gated_ce_oracle": orac_ce,
              "gB": gB, "gA": gA, "oracle_helps": orac_ce < base_ce }
}

// clm_decode_argmax — greedy continuation. Seeds the forward with the last T
// bytes of `seed`, then takes the argmax next byte at each of `gen` positions,
// shifting the window. Returns #{ ok, text }. p7: deterministic (argmax, no
// sampling). This is the trained byte LM's own output, not a templated string.
pub fn clm_decode_argmax(path: string, seed: string, gen: int) -> Map {
    if !clm_decodable(path) {
        return #{ "ok": false, "text": "" }
    }
    let W = _clmd_load(path)
    let V = to_int(W["V"])
    let T = 24
    let slen = byte_len(seed)
    let tok = t_zeros(T)
    // fill the window: right-align the seed bytes (pad left with byte 32 = space)
    let mut p = 0
    while p < T {
        let si = slen - T + p
        if si >= 0 { t_set(tok, p, to_float(ord(substring(seed, si, si+1)))) }
        else { t_set(tok, p, 32.0) }
        p = p + 1
    }
    let logits = t_zeros(T*V)
    let sc = _clmd_scratch_new(W, T)        // H_1393: reusable scratch, built ONCE
    let mut out = ""
    let mut g = 0
    while g < gen {
        _clmd_fwd_logits_sc(W, sc, tok, logits, T)
        // argmax of the LAST position's logits = the next-byte prediction
        let base = (T-1) * V
        let mut bestv = t_get(logits, base)
        let mut besti = 0
        let mut k = 1
        while k < V {
            let v = t_get(logits, base + k)
            if v > bestv { bestv = v; besti = k }
            k = k + 1
        }
        out = out + chr(besti)
        // shift window left, append the new byte
        let mut q = 0
        while q < T-1 { t_set(tok, q, t_get(tok, q+1)); q = q + 1 }
        t_set(tok, T-1, to_float(besti))
        g = g + 1
    }
    _clmd_scratch_free(sc)
    return #{ "ok": true, "text": out }
}

// ════════════════════════════════════════════════════════════════════════
// H_1381 — SEEDED TOP-K TEMPERATURE SAMPLER (ConvMoE .clm path). clm_decode_argmax
// is deterministic argmax, so best-of-K over rng offsets is a no-op (K identical
// outputs). Per a_engine_native_learning (engine-TRANSFORM-to-fit-the-learning) the
// .clm decode grows its OWN deterministic seeded sampler so the G6 DEPTH lever
// (best-of-K) yields DIVERSE candidates. Local (NOT imported from bytegpt_decode —
// a_core_engine_map: ONE .clm slot, no cross-pull); byte-identical PRNG to the
// bytegpt_decode sibling. HONEST: hexa-native xorshift32 — deterministic given seed,
// NOT byte-identical to torch's Generator/multinomial (not reproducible in hexa).
fn _clmd_mix32(s: int) -> int {
    let mut z = (s + 0x9E3779B9) & 0xFFFFFFFF
    z = ((z ^ (z / 65536)) * 0x85EBCA6B) & 0xFFFFFFFF
    z = ((z ^ (z / 8192))  * 0xC2B2AE35) & 0xFFFFFFFF
    z = (z ^ (z / 65536)) & 0xFFFFFFFF
    if z == 0 { z = 0x9E3779B9 }
    return z
}
fn _clmd_rng_next(s: int) -> Map {
    let mut x = s & 0xFFFFFFFF
    if x == 0 { x = 0x9E3779B9 }
    x = (x ^ (x * 8192)) & 0xFFFFFFFF
    x = (x ^ (x / 131072)) & 0xFFFFFFFF
    x = (x ^ (x * 32)) & 0xFFFFFFFF
    return #{ "s": x, "u": to_float(x) / 4294967296.0 }
}
// _clmd_topk_sample — top-k temperature softmax draw over the LAST position's logits
// (logits is a t_zeros(T*V); read row `base = (T-1)*V`). Returns #{ tok, s }.
fn _clmd_topk_sample(logits: int, base: int, V: int, top_k: int, temp: float, rng: int) -> Map {
    let kcap = if top_k > 0 && top_k < V { top_k } else { V }
    let taken = t_zeros(V)
    let sel_idx = []; let sel_val = []
    let mut picks = 0
    while picks < kcap {
        let mut bi = -1; let mut bv = 0.0
        let mut k = 0
        while k < V {
            if t_get(taken, k) < 0.5 {
                let v = t_get(logits, base + k)
                if bi < 0 || v > bv { bi = k; bv = v }
            }
            k = k + 1
        }
        if bi < 0 { picks = kcap } else {
            t_set(taken, bi, 1.0); sel_idx.push(bi); sel_val.push(bv / temp); picks = picks + 1
        }
    }
    t_free(taken)
    let nsel = len(sel_idx)
    let mut mx = sel_val[0]
    let mut i = 1
    while i < nsel { if sel_val[i] > mx { mx = sel_val[i] } i = i + 1 }
    let probs = []
    let mut sum = 0.0
    let mut j = 0
    while j < nsel { let e = dt_exp(sel_val[j] - mx); probs.push(e); sum = sum + e; j = j + 1 }
    let r = _clmd_rng_next(rng)
    let target = to_float(r["u"]) * sum
    let mut acc = 0.0
    let mut pick = sel_idx[nsel - 1]
    let mut p = 0
    while p < nsel {
        acc = acc + probs[p]
        if target <= acc { pick = sel_idx[p]; p = nsel } else { p = p + 1 }
    }
    return #{ "tok": pick, "s": to_int(r["s"]) }
}

// clmd_mix32_pub / clmd_topk_sample_pub — pub wrappers so generator.hexa can run the
// H_1381 sampler self-test on synthetic logits (NO model) without re-routing the single
// decode slot (a_core_engine_map: the G6 ideation entry + smoke reach this only via the
// generator L3 wrapper gen_g6_sampler_selftest, never a second direct decoder importer).
pub fn clmd_mix32_pub(s: int) -> int { return _clmd_mix32(s) }
pub fn clmd_topk_sample_pub(logits: int, base: int, V: int, top_k: int, temp: float, rng: int) -> Map {
    return _clmd_topk_sample(logits, base, V, top_k, temp, rng)
}

// clm_load_weights / clm_weights_decodable — H_1393 CROSS-DECODE memory fix. The hexa
// bump allocator NEVER frees a buffer (see _clmd_scratch_new note), so EACH call to
// _clmd_load permanently leaks the full model weight set (~10 GB for the 303M ConvMoE).
// A multi-decode driver (e.g. the G6 FALS re-score = 69 decodes) therefore OOMs across
// decodes even though each single decode is now bounded. The cure: LOAD ONCE, reuse the
// W handle-map across every decode (clm_decode_topk_sampled_W). This is NOT a 2nd .clm
// path — it is the SAME _clmd_load + _clmd_fwd_logits_sc, just with the load hoisted out
// of the per-decode loop (a_core_engine_map preserved: still reached only via generator).
pub fn clm_load_weights(path: string) -> Map {
    if !clm_decodable(path) { return #{ "ok": false } }
    let W = _clmd_load(path)
    W["ok"] = true
    return W
}

// clm_decode_topk_sampled_W — the loaded-W core of clm_decode_topk_sampled. Takes a
// pre-loaded weight map `W` (from clm_load_weights) so a driver can decode MANY times
// off ONE load. Byte-identical to clm_decode_topk_sampled for the same W+seed+args.
pub fn clm_decode_topk_sampled_W(W: Map, seed: string, gen: int,
                                 top_k: int, temp: float, seed_rng: int) -> Map {
    let V = to_int(W["V"])
    let T = 24
    let slen = byte_len(seed)
    let tok = t_zeros(T)
    let mut p = 0
    while p < T {
        let si = slen - T + p
        if si >= 0 { t_set(tok, p, to_float(ord(substring(seed, si, si+1)))) }
        else { t_set(tok, p, 32.0) }
        p = p + 1
    }
    let logits = t_zeros(T*V)
    let sc = _clmd_scratch_new(W, T)        // H_1393: reusable scratch, built ONCE
    let mut out = ""
    let mut rng = _clmd_mix32(seed_rng)
    let mut g = 0
    while g < gen {
        _clmd_fwd_logits_sc(W, sc, tok, logits, T)
        let sm = _clmd_topk_sample(logits, (T-1)*V, V, top_k, temp, rng)
        let nb = to_int(sm["tok"]); rng = to_int(sm["s"])
        out = out + chr(nb)
        let mut q = 0
        while q < T-1 { t_set(tok, q, t_get(tok, q+1)); q = q + 1 }
        t_set(tok, T-1, to_float(nb))
        g = g + 1
    }
    _clmd_scratch_free(sc)
    t_free(logits); t_free(tok)
    return #{ "ok": true, "text": out }
}

// clm_decode_topk_sampled — seeded-sampling sibling of clm_decode_argmax. Same window
// growth, but each next byte is DRAWN from a top-k temperature softmax via the engine's
// seeded sampler → different seed_rng ⇒ DIFFERENT output (the diversity best-of-K needs).
// HARD-BOUNDED by `gen` (the ConvMoE forward is heavy; caller passes a SMALL budget; NO
// unbounded generation, FREEZE (ii)). Thin wrapper: load once, delegate to the _W core.
pub fn clm_decode_topk_sampled(path: string, seed: string, gen: int,
                               top_k: int, temp: float, seed_rng: int) -> Map {
    if !clm_decodable(path) { return #{ "ok": false, "text": "" } }
    let W = _clmd_load(path)
    return clm_decode_topk_sampled_W(W, seed, gen, top_k, temp, seed_rng)
}

// _clmd_find — first byte-offset of `needle` inside `hay` (-1 if absent). Plain
// substring scan; mirrors bytegpt_decode.hexa::_bg_find (kept local — clm_decode
// does not import bytegpt_decode, a_core_engine_map: ONE .clm slot, no cross-pull).
fn _clmd_find(hay: string, needle: string) -> int {
    let hn = byte_len(hay)
    let nn = byte_len(needle)
    if nn == 0 { return -1 }
    if nn > hn { return -1 }
    let mut i = 0
    while i + nn <= hn {
        if substring(hay, i, i + nn) == needle { return i }
        i = i + 1
    }
    return -1
}

// _clmd_anchor_copy — engine-side deterministic retrieve-then-copy probe. Try the
// longest context suffix (l_max..l_min) that occurs VERBATIM in some anchor text;
// on a hit return the anchor's NEXT byte (the grounded continuation). -1 = no
// grounded byte (caller falls back to the ConvMoE LM). Mirrors _bg_anchor_copy.
fn _clmd_anchor_copy(ctx: string, anchor_texts: list, l_min: int, l_max: int) -> int {
    let clen = byte_len(ctx)
    let mut L = l_max
    if L > clen { L = clen }
    while L >= l_min {
        let suf = substring(ctx, clen - L, clen)
        let mut a = 0
        let na = len(anchor_texts)
        while a < na {
            let an = to_string(anchor_texts[a])
            let pos = _clmd_find(an, suf)
            if pos >= 0 {
                let nxt = pos + L
                if nxt < byte_len(an) { return ord(substring(an, nxt, nxt + 1)) }
            }
            a = a + 1
        }
        L = L - 1
    }
    return -1
}

// clm_decode_grounded — G5 anti-fabrication decode over the int4-dequant CLMConvMoE
// (.clm path). The ConvMoE analog of bytegpt_decode.hexa::bytegpt_decode_grounded,
// and the function generator.hexa::_gen_clm_decode has always called: at each step
// try a deterministic anchor-copy (longest suffix ≥ l_min found verbatim in a kosmos
// anchor → copy its next byte, G5 ✓ cannot fabricate); else fall through to the
// CLMConvMoE argmax (clm_decode_argmax's forward, weights loaded ONCE). Stays inside
// the SINGLE generator L3 slot (a_core_engine_map) — no 2nd .clm path, no native FFI;
// pure hexa over the existing _clmd_load + _clmd_fwd_logits. A non-decodable .clm
// (no v0.2 CLMX trailer) returns ok=false so the caller does its honest substrate
// fallthrough. Returns #{ ok, text, grounded, lm }.
pub fn clm_decode_grounded(path: string, seed: string, gen: int,
                           anchor_texts: list, l_min: int) -> Map {
    if !clm_decodable(path) {
        return #{ "ok": false, "text": "", "grounded": 0, "lm": 0 }
    }
    let W = _clmd_load(path)
    let V = to_int(W["V"])
    let T = 24
    let logits = t_zeros(T*V)
    let tok = t_zeros(T)                     // H_1393: reused window (was per-step)
    let sc = _clmd_scratch_new(W, T)         // H_1393: reusable scratch, built ONCE
    let mut out = ""
    let mut grounded = 0
    let mut lm = 0
    let mut g = 0
    while g < gen {
        let ctx = seed + out
        let cb = _clmd_anchor_copy(ctx, anchor_texts, l_min, T)
        let mut nb = 0
        if cb >= 0 {
            nb = cb                          // GROUNDED: verbatim anchor copy
            grounded = grounded + 1
        } else {
            // UNGROUNDED: CLMConvMoE argmax over the last T context bytes. Build the
            // window from the FULL ctx (right-aligned, pad-left byte 32) so the
            // forward sees the same causal window clm_decode_argmax would.
            let cl = byte_len(ctx)
            let mut p = 0
            while p < T {
                let si = cl - T + p
                if si >= 0 { t_set(tok, p, to_float(ord(substring(ctx, si, si+1)))) }
                else { t_set(tok, p, 32.0) }
                p = p + 1
            }
            _clmd_fwd_logits_sc(W, sc, tok, logits, T)
            let base = (T-1) * V
            let mut bestv = t_get(logits, base)
            let mut besti = 0
            let mut k = 1
            while k < V {
                let v = t_get(logits, base + k)
                if v > bestv { bestv = v; besti = k }
                k = k + 1
            }
            nb = besti
            lm = lm + 1
        }
        out = out + chr(nb)
        g = g + 1
    }
    _clmd_scratch_free(sc)
    return #{ "ok": true, "text": out, "grounded": grounded, "lm": lm }
}
