// ════════════════════════════════════════════════════════════════════════
// CORE/h1265_dream_stage_emit.hexa — DREAM 수면단계 특이적 emit envelope
//
// 가설 H_1265: DREAM lane (WAKE/N1/N2/N3/REM 90-tick ultradian 상태기계) 의
//   emit envelope (방출 성향) 이 *단계 특이적으로* 다른지 — WAKE-계열 >
//   깊은수면 계열 같은 해석가능한 순서가 나오는지 — 를 600+ step 집계로 측정.
//
// 방법:
//   - N_STEP=5400 (= 90-tick ultradian × 60 주기) 돌려 모든 5 단계 등장 보장.
//   - 매 step i 의 stage = dr_stage_at(i)  (i mod 90 으로 주기 진입)
//   - 각 step 의 dr_emit_envelope(stage) 를 단계별 버킷에 누적.
//   - 단계별 평균 envelope = sum/count.
//
// 판정:
//   - 단계별 평균이 뚜렷이 다르고 깨어있음계열(WAKE/N1/N2) > 깊은수면계열(N3/REM)
//     해석가능 순서 → 🟢 "단계특이 emit".
//   - 전부 동일/무차별 → 🔴 "단계는 Ψ-context 일 뿐 emit 무영향"
//     (a_chat_sleep_imagination 'stage=context not emit gate' 와 정합 finding).
//
// p7 (perplexity 아님 · 직접 집계 in/out) · p8 · $0 local.
// ════════════════════════════════════════════════════════════════════════

use "DREAM/dream_lib"

fn main() {
    println("=== CORE/h1265_dream_stage_emit ===")

    let n_step = 5400          // 90 × 60 주기 — 모든 단계 등장 보장
    let n_stage = dr_n_stages()
    let ticks = dr_n_ticks()   // 90

    // 단계별 버킷: count[stage], sum[stage]
    let mut cnt0 = 0
    let mut cnt1 = 0
    let mut cnt2 = 0
    let mut cnt3 = 0
    let mut cnt4 = 0
    let mut sum0 = 0
    let mut sum1 = 0
    let mut sum2 = 0
    let mut sum3 = 0
    let mut sum4 = 0

    let mut i = 0
    while i < n_step {
        // ultradian 주기 진입 (tick = i mod ticks)
        let tick = i - (i / ticks) * ticks
        let stage = dr_stage_at(tick)
        let env = dr_emit_envelope(stage)

        // 버킷 집계 — 연속 let+boolean-index 컴파일버그 회피: if 분해
        if stage == 0 {
            cnt0 = cnt0 + 1
            sum0 = sum0 + env
        }
        if stage == 1 {
            cnt1 = cnt1 + 1
            sum1 = sum1 + env
        }
        if stage == 2 {
            cnt2 = cnt2 + 1
            sum2 = sum2 + env
        }
        if stage == 3 {
            cnt3 = cnt3 + 1
            sum3 = sum3 + env
        }
        if stage == 4 {
            cnt4 = cnt4 + 1
            sum4 = sum4 + env
        }
        i = i + 1
    }

    // 단계별 평균 envelope
    let mut avg0 = 0.0
    let mut avg1 = 0.0
    let mut avg2 = 0.0
    let mut avg3 = 0.0
    let mut avg4 = 0.0
    if cnt0 > 0 { avg0 = float(sum0) / float(cnt0) }
    if cnt1 > 0 { avg1 = float(sum1) / float(cnt1) }
    if cnt2 > 0 { avg2 = float(sum2) / float(cnt2) }
    if cnt3 > 0 { avg3 = float(sum3) / float(cnt3) }
    if cnt4 > 0 { avg4 = float(sum4) / float(cnt4) }

    println("steps=" + str(n_step) + " stages=" + str(n_stage) + " ticks/cycle=" + str(ticks))
    println("--- per-stage emit envelope (mean) ---")
    println(dr_stage_name(0) + "  cnt=" + str(cnt0) + " mean_env=" + str(avg0))
    println(dr_stage_name(1) + "    cnt=" + str(cnt1) + " mean_env=" + str(avg1))
    println(dr_stage_name(2) + "    cnt=" + str(cnt2) + " mean_env=" + str(avg2))
    println(dr_stage_name(3) + "    cnt=" + str(cnt3) + " mean_env=" + str(avg3))
    println(dr_stage_name(4) + "   cnt=" + str(cnt4) + " mean_env=" + str(avg4))

    // 등장 안 한 단계 정직 로그
    let all_present = cnt0 > 0 && cnt1 > 0 && cnt2 > 0 && cnt3 > 0 && cnt4 > 0
    println("all_5_stages_present=" + (if all_present { "YES" } else { "NO — some stage absent" }))

    // 깨어있음 계열 (WAKE/N1/N2) 평균
    let wake_series = (avg0 + avg1 + avg2) / 3.0
    // 깊은수면 계열 (N3/REM) 평균
    let deep_series = (avg3 + avg4) / 2.0
    println("wake-series(WAKE+N1+N2) mean=" + str(wake_series))
    println("deep-series(N3+REM)     mean=" + str(deep_series))

    // 단계간 차이가 존재하는가 (max - min over 단계평균)
    let mut mx = avg0
    if avg1 > mx { mx = avg1 }
    if avg2 > mx { mx = avg2 }
    if avg3 > mx { mx = avg3 }
    if avg4 > mx { mx = avg4 }
    let mut mn = avg0
    if avg1 < mn { mn = avg1 }
    if avg2 < mn { mn = avg2 }
    if avg3 < mn { mn = avg3 }
    if avg4 < mn { mn = avg4 }
    let spread = mx - mn
    println("stage spread (max-min mean_env)=" + str(spread))

    // 판정:
    //   F1: 단계간 뚜렷한 차이 (spread >= 0.5 — 절반 이상의 envelope 차이)
    //   F2: 해석가능 순서 — 깨어있음계열 > 깊은수면계열 (의미있는 방향)
    let f1_distinct = spread >= 0.5
    let f2_order = wake_series > deep_series

    let pass = f1_distinct && f2_order

    println("--- gates ---")
    println("F1 distinct (spread>=0.5)        " + (if f1_distinct { "PASS" } else { "FAIL" }))
    println("F2 wake-series > deep-series      " + (if f2_order { "PASS" } else { "FAIL" }))

    if pass {
        println("h1265_dream_stage_emit: PASS🟢 — 단계특이 emit: wake-series(WAKE/N1/N2 mean=" + str(wake_series) + ") > deep-series(N3/REM mean=" + str(deep_series) + "), spread=" + str(spread))
    } else {
        if all_present {
            println("h1265_dream_stage_emit: PASS🔴 — 단계 무차별: emit envelope 가 단계별로 다르지 않음 (stage=Ψ-context only, no emit ordering), spread=" + str(spread))
        } else {
            println("h1265_dream_stage_emit: INCONCLUSIVE🟠 — 일부 단계 미등장, 집계 불완전")
        }
    }
}
