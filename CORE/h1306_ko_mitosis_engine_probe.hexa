// h1306_ko_mitosis_engine_probe.hexa — ENGINE-NATIVE Korean mitosis training on a REAL
// Korean web corpus (a_engine_native_learning + a_verified_must_wire + a_scale_honest_scope).
//
// H_1306 scales the H_1297-R4 toy (~2 KB hardcoded KO+EN string, 🟢 GREEN engine-native:
// gradient-free mitosis-grow MATCHED gradient on next-byte, c2 error-targeting fired ON
// THE LIVE ENGINE) to a FIRST CPU rung on a REAL Korean web corpus — a modest slice of
// the anima-7b 5-lang corpus pulled from Cloudflare R2 (kor/eng shard0000, provenance +
// sha256 in /tmp/h1306_manifest.json + UNIVERSE/H_1306_*.md). REAL crawled Korean text,
// NO synthetic (p1-p8). This realizes the user's standing goal "303M 에 미토시스로 한글학습"
// as its FIRST honest engine-native rung.
//
// ENGINE-NATIVE (identical faculties to H_1297 R4 — the engine's OWN, not a numpy mirror):
//   * PARTITION = live VAdaptField Voronoi ownership (vadapt_field_nearest_idx) — the
//     engine's OWN winner-take-all L2 assignment.
//   * GROWTH    = the engine's OWN mitosis tick (engine_mitosis_tick, p8): ON -> grow one
//     cell where Korean next-byte error concentrates (error-TARGETED split), OFF -> no-op.
//   * HEAD      = per-cell empirical next-byte frequency (closed-form add-1 MLE) over
//     OWNED train points — gradient-free (p8), the same per-cell binding H_1231/H_1288 run.
//
// WHAT IS MEASURED (p7, deterministic — NO perplexity-as-meaning, NO LLM-judge; held-out
// next-byte CROSS-ENTROPY in nats/byte is a legitimate CONVERGENCE comparison):
//   (1) KO LEARNING CURVE — mitosis-grow INCREMENTALLY on KO chunk1, chunk1+2, chunk1+2+3
//       and score held-out KO CE after EACH (>=3 points). Does Korean CE DROP as the
//       substrate grows cells under Korean error pressure?  [the learning claim]
//   (2) CATASTROPHIC-FORGETTING GUARD — measure held-out ENGLISH CE on the SEED 2-cell
//       field (BEFORE any KO mitosis) vs the FULL grown field (AFTER). EN must NOT regress
//       while KO improves (the H_1300 retention property, on REAL data). The KO-grown cells
//       re-tile feature space, but EN bytes route to whichever cell now owns their context;
//       retention holds iff the grown partition still predicts EN as well as the seed did.
//   (3) CELL-COUNT GROWTH — how many cells mitosis added for Korean.
//
// FROZEN BARS (pre-registered in .verdicts/1306_ko_mitosis_real/H_1306_FREEZE.txt BEFORE
// this run — frozen-first, c9/p7; NOT moved):
//   (L LEARNING)   KO CE at curve point 3 (full)  <=  KO CE at curve point 1  - 0.05 nats
//                  (a real >=0.05 nat/byte drop from growing on more Korean = learning).
//   (R RETENTION)  EN CE after full KO grow  <=  EN CE on seed field  + 0.05 nats
//                  (English does NOT regress by more than 0.05 nats = no catastrophic forget).
//   (G GROWTH)     final cell count  >  2  (mitosis actually grew cells for Korean).
//   (C MATCH, non-gating diagnostic) KO CE at full vs arm A gradient incumbent (context).
//   GREEN iff L & R & G.  (C is reported, not gated — gradient incumbent is a reference.)
// FROZEN knobs (verbatim from H_1297): V=256, FEAT_DIM=3, GROW_MAX=40,
//   SPLIT_THRESH_CE=0.05, MIN_OWNED=8, LAPLACE=1.0.
//
// SCALE-HONEST (a_scale_honest_scope, a_toy_scale_recheck): FIRST CPU rung on a 600 KB KO /
// 300 KB EN real-text window, deterministically SUBSAMPLED (stride) to a CPU-tractable pair
// set. This will NOT produce fluent Korean — it tests whether engine-native mitosis LEARNS
// Korean next-byte structure + RETAINS English on REAL data. Fluent Korean is a larger
// (GPU-scale, cost-gated) follow-on. NO overclaim.
//
// Ψ-disjoint: partition only reads VAdaptField ownership + grows a cell population;
// pure_field is never touched (a_core_engine_map). $0 CPU, no GPU, no secrets at run time.
//
// DATA: /tmp/h1306_{ko_train,ko_test,en_test}.{feats,next} + /tmp/h1306_chunks.txt +
// /tmp/h1306_armA.ce, exported by UNIVERSE/h1306_ko_corpus_export.py (run it first, which
// reads the R2-fetched /tmp slices from UNIVERSE/h1306_fetch_corpus.sh).

import "CORE/engine_cli.hexa"

// ── FROZEN knobs (verbatim from H_1297 R4) ──────────────────────────────────────
fn _V() -> int             { return 256 }
fn _FEAT_DIM() -> int      { return 3 }
fn _GROW_MAX() -> int      { return 40 }
fn _SPLIT_THRESH_CE() -> float { return 0.05 }
fn _MIN_OWNED() -> int     { return 8 }
fn _LAPLACE() -> float     { return 1.0 }
// ── FROZEN H_1306 bars ──────────────────────────────────────────────────────────
fn _LEARN_DROP() -> float    { return 0.05 }   // L: KO ce[full] <= KO ce[pt1] - this
fn _RETAIN_CEIL() -> float   { return 0.05 }   // R: EN ce[after] <= EN ce[seed] + this

fn _fmt(x: float) -> string { return to_string(x) }

// ── loaders (identical to H_1297) ───────────────────────────────────────────────
fn _load_feats(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_ints(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [to_int(lines[i].trim())]  i = i + 1 }
    return out
}
fn _load_floats_line(path: string) -> [float] {
    let txt = read_file(path)
    let cols = txt.trim().split(" ")
    let mut out = []
    let mut i = 0
    while i < len(cols) { out = out + [to_float(cols[i].trim())]  i = i + 1 }
    return out
}

// ── engine-native partition geometry (identical to H_1297) ──────────────────────
fn _assign_all(af: VAdaptField, X: [[float]]) -> [int] {
    let mut owner = []
    let mut i = 0
    while i < len(X) { owner = owner + [vadapt_field_nearest_idx(af, X[i])]  i = i + 1 }
    return owner
}
// per-cell next-byte head over the FIRST `ntr` train points (incremental curriculum)
fn _head_counts(Y: [int], owner: [int], k: int, ntr: int, V: int, laplace: float) -> [float] {
    let mut counts = []
    let mut v = 0
    while v < V { counts = counts + [laplace]  v = v + 1 }
    let mut total = laplace * to_float(V)
    let mut i = 0
    while i < ntr {
        if owner[i] == k { counts[Y[i]] = counts[Y[i]] + 1.0  total = total + 1.0 }
        i = i + 1
    }
    let mut p = []
    let mut w = 0
    while w < V { p = p + [counts[w] / total]  w = w + 1 }
    return p
}
fn _owned_ce(Y: [int], owner: [int], k: int, ntr: int, p: [float]) -> float {
    let mut s = 0.0  let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k { s = s - ln(p[Y[i]] + 0.000000000001)  n = n + 1 }
        i = i + 1
    }
    if n == 0 { return 0.0 }
    return s / to_float(n)
}
fn _owned_count(owner: [int], k: int, ntr: int) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr { if owner[i] == k { n = n + 1 }  i = i + 1 }
    return n
}
fn _hi_var_axis(X: [[float]], owner: [int], k: int, ntr: int, dim: int) -> int {
    let mut sum = []  let mut sq = []  let mut d = 0
    while d < dim { sum = sum + [0.0]  sq = sq + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let mut a = 0
            while a < dim { sum[a] = sum[a] + X[i][a]  sq[a] = sq[a] + X[i][a] * X[i][a]  a = a + 1 }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0 }
    let fn2 = to_float(n)
    let mut best = 0  let mut bestv = -1.0  let mut a2 = 0
    while a2 < dim {
        let mean = sum[a2] / fn2
        let var = sq[a2] / fn2 - mean * mean
        if var > bestv { bestv = var  best = a2 }
        a2 = a2 + 1
    }
    return best
}
fn _owned_median(X: [[float]], owner: [int], k: int, ntr: int, ax: int) -> float {
    let mut vals = []  let mut i = 0
    while i < ntr { if owner[i] == k { vals = vals + [X[i][ax]] }  i = i + 1 }
    let n = len(vals)
    if n == 0 { return 0.0 }
    let mut a = 1
    while a < n {
        let key = vals[a]  let mut b = a - 1
        while b >= 0 && vals[b] > key { vals[b + 1] = vals[b]  b = b - 1 }
        vals[b + 1] = key  a = a + 1
    }
    if n % 2 == 1 { return vals[n / 2] }
    return (vals[n / 2 - 1] + vals[n / 2]) / 2.0
}
fn _half_centroid(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool, dim: int) -> [float] {
    let mut acc = []  let mut d = 0
    while d < dim { acc = acc + [0.0]  d = d + 1 }
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take {
                let mut a = 0
                while a < dim { acc[a] = acc[a] + X[i][a]  a = a + 1 }
                n = n + 1
            }
        }
        i = i + 1
    }
    if n == 0 { return acc }
    let mut out = []  let mut a2 = 0
    while a2 < dim { out = out + [acc[a2] / to_float(n)]  a2 = a2 + 1 }
    return out
}
fn _half_count(X: [[float]], owner: [int], k: int, ntr: int, ax: int, med: float, lo: bool) -> int {
    let mut n = 0  let mut i = 0
    while i < ntr {
        if owner[i] == k {
            let take = if lo { X[i][ax] <= med } else { X[i][ax] > med }
            if take { n = n + 1 }
        }
        i = i + 1
    }
    return n
}

fn _field_from(centers: [[float]], max_cells: int) -> VAdaptField {
    return VAdaptField { protos: centers, n_cells: len(centers), max_cells: max_cells, dim: len(centers[0]) }
}

// score held-out CE of a test set under the current field's heads (heads built over the
// first `ntr` train points). Returns mean CE (nats/byte).
fn _score_ce(af: VAdaptField, centers: [[float]], Xtr: [[float]], Ytr: [int], ntr: int,
             Xte: [[float]], Yte: [int], V: int) -> float {
    let own_tr = _assign_all(af, Xtr)
    let nc = len(centers)
    let mut heads = []  let mut k = 0
    while k < nc { heads = heads + [_head_counts(Ytr, own_tr, k, ntr, V, _LAPLACE())]  k = k + 1 }
    let own_te = _assign_all(af, Xte)
    let mut s = 0.0  let mut i = 0
    while i < len(Xte) { s = s - ln(heads[own_te[i]][Yte[i]] + 0.000000000001)  i = i + 1 }
    return s / to_float(len(Xte))
}

// GROW the field on the FIRST `ntr` KO train points (error-TARGETED mitosis), starting from
// the given centers, up to GROW_MAX. Returns the grown centers (caller rebuilds the field).
fn _grow_on(centers0: [[float]], af0: VAdaptField, Xtr: [[float]], Ytr: [int], ntr: int,
            dim: int, V: int, cfg: EngineConfig) -> [[float]] {
    let mut centers = centers0
    let mut af = af0
    while len(centers) < _GROW_MAX() {
        let owner = _assign_all(af, Xtr)
        let nc = len(centers)
        let mut local_ce = []  let mut owned_n = []  let mut k = 0
        while k < nc {
            let cnt = _owned_count(owner, k, ntr)
            owned_n = owned_n + [cnt]
            if cnt > 0 {
                let p = _head_counts(Ytr, owner, k, ntr, V, _LAPLACE())
                local_ce = local_ce + [_owned_ce(Ytr, owner, k, ntr, p)]
            } else { local_ce = local_ce + [-1.0] }
            k = k + 1
        }
        let mut elig = []  let mut k2 = 0
        while k2 < nc {
            if owned_n[k2] >= _MIN_OWNED() && local_ce[k2] > _SPLIT_THRESH_CE() { elig = elig + [k2] }
            k2 = k2 + 1
        }
        if len(elig) == 0 { break }
        // TARGETED: highest owned-CE eligible cell (error-targeted, where KO error concentrates)
        let mut pick = elig[0]
        let mut bestce = local_ce[elig[0]]
        let mut ei = 1
        while ei < len(elig) {
            if local_ce[elig[ei]] > bestce { bestce = local_ce[elig[ei]]  pick = elig[ei] }
            ei = ei + 1
        }
        // GROWTH gated by the engine's OWN mitosis tick (p8)
        let grown = engine_mitosis_tick(len(centers), cfg)
        if grown <= len(centers) { break }
        let ax = _hi_var_axis(Xtr, owner, pick, ntr, dim)
        let med = _owned_median(Xtr, owner, pick, ntr, ax)
        let nlo = _half_count(Xtr, owner, pick, ntr, ax, med, true)
        let nhi = _half_count(Xtr, owner, pick, ntr, ax, med, false)
        if nlo == 0 || nhi == 0 { break }
        let c_lo = _half_centroid(Xtr, owner, pick, ntr, ax, med, true, dim)
        let c_hi = _half_centroid(Xtr, owner, pick, ntr, ax, med, false, dim)
        let mut new_centers = []  let mut ci = 0
        while ci < len(centers) {
            if ci != pick { new_centers = new_centers + [centers[ci]] }
            ci = ci + 1
        }
        new_centers = new_centers + [c_lo, c_hi]
        centers = new_centers
        af = _field_from(centers, _GROW_MAX())
    }
    return centers
}

fn main() {
    println("=== H_1306 — KOREAN MITOSIS TRAINING on a REAL Korean web corpus (ENGINE-NATIVE) ===")
    println("faculty: CORE/engine_cli.hexa VAdaptField Voronoi (vadapt_field_nearest_idx) +")
    println("         engine_mitosis_tick growth (p8); head = per-cell next-byte MLE (gradient-free).")
    println("corpus: REAL Korean + English web bytes (r2://phanes/anima-7b/web/{kor,eng}, V=256, CTX=4)")
    println("        sha256 + provenance in /tmp/h1306_manifest.json (NO synthetic Korean, p1-p8).")
    println("metric = held-out next-byte CROSS-ENTROPY (nats/byte), lower=better (p7).")
    println("")

    let cfg = engine_cli_parse(["--mitosis", "on"])
    let dim = _FEAT_DIM()
    let V = _V()
    let Xtr = _load_feats("/tmp/h1306_ko_train.feats", dim)
    let Ytr = _load_ints("/tmp/h1306_ko_train.next")
    let Xkte = _load_feats("/tmp/h1306_ko_test.feats", dim)
    let Ykte = _load_ints("/tmp/h1306_ko_test.next")
    let Xete = _load_feats("/tmp/h1306_en_test.feats", dim)
    let Yete = _load_ints("/tmp/h1306_en_test.next")
    let chunks = _load_floats_line("/tmp/h1306_chunks.txt")    // cumulative KO train bounds
    let armA = _load_floats_line("/tmp/h1306_armA.ce")          // [seed, ce, acc]
    if len(Xtr) == 0 || len(chunks) == 0 || len(armA) == 0 {
        println("ERROR: missing /tmp/h1306_* — run UNIVERSE/h1306_fetch_corpus.sh then h1306_ko_corpus_export.py first.")
        exit(1)
    }
    let nb1 = to_int(chunks[0])
    let nb2 = to_int(chunks[1])
    let nb3 = to_int(chunks[2])
    println("KO pairs: train=" + to_string(len(Xtr)) + " test=" + to_string(len(Xkte))
        + "  EN test=" + to_string(len(Xete)) + "  curve bounds=[" + to_string(nb1) + "," + to_string(nb2) + "," + to_string(nb3) + "]")
    println("FROZEN bars: L(learn-drop)=" + _fmt(_LEARN_DROP()) + "  R(retain-ceil)=" + _fmt(_RETAIN_CEIL())
        + "  G(grow)>2  | GROW_MAX=" + to_string(_GROW_MAX()) + " SPLIT_THRESH_CE=" + _fmt(_SPLIT_THRESH_CE()))
    println("-------------------------------------------------------------------------------")

    // SEED 2-cell field (R3 mirror centers) — BEFORE any KO mitosis
    let mut centers = [[0.3, 0.5, 0.0], [0.7, 0.5, 0.5]]
    let af_seed = _field_from(centers, _GROW_MAX())
    // retention baseline: EN CE on the SEED field (heads over chunk1 KO train, the same
    // train the seed sees before growing) — this is the pre-KO-mitosis English competence.
    let en_seed = _score_ce(af_seed, centers, Xtr, Ytr, nb1, Xete, Yete, V)

    // CURVE POINT 1: grow on KO chunk1, score KO test + EN test
    let c1centers = _grow_on(centers, af_seed, Xtr, Ytr, nb1, dim, V, cfg)
    let af1 = _field_from(c1centers, _GROW_MAX())
    let ko_ce1 = _score_ce(af1, c1centers, Xtr, Ytr, nb1, Xkte, Ykte, V)
    let en_ce1 = _score_ce(af1, c1centers, Xtr, Ytr, nb1, Xete, Yete, V)

    // CURVE POINT 2: continue growing on KO chunk1+2 (from pt1 field), score
    let c2centers = _grow_on(c1centers, af1, Xtr, Ytr, nb2, dim, V, cfg)
    let af2 = _field_from(c2centers, _GROW_MAX())
    let ko_ce2 = _score_ce(af2, c2centers, Xtr, Ytr, nb2, Xkte, Ykte, V)
    let en_ce2 = _score_ce(af2, c2centers, Xtr, Ytr, nb2, Xete, Yete, V)

    // CURVE POINT 3 (full): continue growing on KO chunk1+2+3, score
    let c3centers = _grow_on(c2centers, af2, Xtr, Ytr, nb3, dim, V, cfg)
    let af3 = _field_from(c3centers, _GROW_MAX())
    let ko_ce3 = _score_ce(af3, c3centers, Xtr, Ytr, nb3, Xkte, Ykte, V)
    let en_after = _score_ce(af3, c3centers, Xtr, Ytr, nb3, Xete, Yete, V)

    let cells_final = len(c3centers)
    let a_ce = armA[1]

    println("KO learning curve (held-out KO next-byte CE, nats/byte):")
    println("  pt1 (KO train=" + to_string(nb1) + ", cells=" + to_string(len(c1centers)) + "): KO ce=" + _fmt(ko_ce1) + "   EN ce=" + _fmt(en_ce1))
    println("  pt2 (KO train=" + to_string(nb2) + ", cells=" + to_string(len(c2centers)) + "): KO ce=" + _fmt(ko_ce2) + "   EN ce=" + _fmt(en_ce2))
    println("  pt3 (KO train=" + to_string(nb3) + ", cells=" + to_string(cells_final) + "): KO ce=" + _fmt(ko_ce3) + "   EN ce=" + _fmt(en_after))
    println("retention guard: EN ce SEED(2-cell)=" + _fmt(en_seed) + "  ->  EN ce AFTER full KO grow=" + _fmt(en_after))
    println("cost/context (C, non-gating): KO ce[full]=" + _fmt(ko_ce3) + "  vs arm A gradient incumbent KO ce=" + _fmt(a_ce))
    println("cell growth: 2 (seed) -> " + to_string(cells_final) + " (mitosis added " + to_string(cells_final - 2) + " cells for Korean)")
    println("-------------------------------------------------------------------------------")

    let learn = ko_ce3 <= ko_ce1 - _LEARN_DROP()
    let retain = en_after <= en_seed + _RETAIN_CEIL()
    let grow = cells_final > 2
    println("(L) LEARNING   KO ce[full] <= KO ce[pt1] - " + _fmt(_LEARN_DROP()) + ":  " + _fmt(ko_ce3) + " <= " + _fmt(ko_ce1 - _LEARN_DROP()) + "  -> " + (if learn { "PASS" } else { "FAIL" }))
    println("(R) RETENTION  EN ce[after] <= EN ce[seed] + " + _fmt(_RETAIN_CEIL()) + ": " + _fmt(en_after) + " <= " + _fmt(en_seed + _RETAIN_CEIL()) + " -> " + (if retain { "PASS" } else { "FAIL" }))
    println("(G) GROWTH     final cells > 2:  " + to_string(cells_final) + " > 2  -> " + (if grow { "PASS" } else { "FAIL" }))
    println("-------------------------------------------------------------------------------")
    let green = learn && retain && grow
    if green {
        println("H_1306 VERDICT TIER (engine-native): 🟢 GREEN")
        println("  Korean next-byte CE DROPPED as engine-native mitosis grew cells under Korean error pressure,")
        println("  AND English next-byte CE held (no catastrophic forgetting) — on REAL Korean web text.")
        println("  This is the FIRST engine-native Korean-mitosis rung; gradient-free, $0 CPU (p8 literal).")
    } else {
        println("H_1306 VERDICT TIER (engine-native): 🔴 HONEST-DEFERRED")
        let mut why = ""
        if !learn { why = why + "L(no-drop) " }
        if !retain { why = why + "R(forget) " }
        if !grow { why = why + "G(no-grow) " }
        println("  failed bar(s): " + why + "(honest result, c9 — no tune-to-green).")
    }
    println("  L=" + (if learn { "True" } else { "False" }) + " R=" + (if retain { "True" } else { "False" }) + " G=" + (if grow { "True" } else { "False" })
        + " | ENGINE-NATIVE (VAdaptField Voronoi + engine_mitosis_tick, p8); FIRST CPU rung on REAL")
    println("  Korean (600KB KO / 300KB EN window, stride-subsampled); FLUENT Korean = larger GPU-scale")
    println("  cost-gated follow-on (a_scale_honest_scope, a_toy_scale_recheck — NO overclaim of fluency).")
    println("  guard: partition = engine Voronoi; growth = engine_mitosis_tick; head = per-cell MLE (gradient-free);")
    println("         pure_field UNTOUCHED (Ψ-disjoint, a_core_engine_map). $0 CPU, no GPU, no secrets at run.")
    println("[done]")
    if !green { exit(1) }
}
