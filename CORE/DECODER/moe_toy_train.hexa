// moe_toy_train.hexa — DECODER M4b-wire-toy: MoE register-differentiation validation
// UNIVERSE H_490 DIFFERENTIATION mechanism test at toy scale (d=4 V=4 E=2).
//
// Question (does MoE escape the double-bind mechanism?):
//   Two "registers": cluster A inputs should emit token 0, cluster B → token 2.
//   A single head must compromise (the toy double-bind). With 2 experts + router,
//   does the router LEARN to route cluster A → one expert, cluster B → another,
//   so each expert specializes (collapse-isolated, coherence-preserved)?
//
// Train router + experts via SGD on CE; then measure:
//   (1) loss decreased (both registers learned), AND
//   (2) router differentiated — gate(zT_A) concentrates on a DIFFERENT expert
//       than gate(zT_B). That separation IS the H_490 escape signal.
//
// Pure hexa-native (farr model · moe_router fwd + moe_router_bwd). No external LLM.

import "CORE/DECODER/moe_router.hexa"
import "CORE/DECODER/moe_router_bwd.hexa"

// CE loss + grad: d_logits[k] = softmax(logits)[k] − [k==target]. returns CE.
fn ce_loss_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - moe_ln(p_tgt + 0.0000000001)
    let mut k = 0
    while k < V {
        let pk = farr_get(d_logits_out, k) / tot
        let tgt = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, pk - tgt)
        k = k + 1
    }
    return ce
}

// one train step on (zT, target): fwd → CE grad → moe_route_bwd → SGD update.
// returns CE before the update.
fn moe_toy_step(zT: int, target: int, M: int, router_off: int, experts_off: int,
                n_experts: int, V: int, d: int, total: int, lr: float) -> float {
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    moe_route_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let d_logits = farr_zeros(V)
    let ce = ce_loss_grad(logits, target, V, d_logits)
    let dM = farr_zeros(total)
    let d_zT = farr_zeros(d)
    moe_route_bwd(zT, M, router_off, experts_off, gate, n_experts, V, d, d_logits, dM, d_zT)
    // SGD: M -= lr · dM  (router + experts only; offsets 0..total)
    let mut i = 0
    while i < total {
        let _ = farr_set(M, i, farr_get(M, i) - lr * farr_get(dM, i))
        i = i + 1
    }
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    let _ = farr_free(d_logits)
    let _ = farr_free(dM)
    let _ = farr_free(d_zT)
    return ce
}

// gate for a given zT (post-softmax), into gate_out
fn moe_toy_gate(zT: int, M: int, router_off: int, n_experts: int, d: int, gate_out: int) {
    moe_gate_fwd(zT, M, router_off, n_experts, d, gate_out)
    moe_softmax(gate_out, n_experts)
}

fn main() {
    print("=== DECODER M4b-wire-toy: MoE register-differentiation (d=4 V=4 E=2) ===")

    let n_experts = 2
    let V = 4
    let d = 4
    let router_off = 0
    let experts_off = n_experts * d
    let total = experts_off + n_experts * V * d

    let M = farr_zeros(total)
    // small asymmetric init so router/experts can break symmetry
    let mut s = 0
    while s < total {
        // deterministic pseudo-init: alternating tiny values
        let v = if s == s / 2 * 2 { 0.01 } else { 0.0 - 0.01 }
        let _ = farr_set(M, s, v)
        s = s + 1
    }

    // two register prototypes (orthogonal one-hot-ish)
    let zT_A = farr_zeros(d)
    let _ = farr_set(zT_A, 0, 1.0)
    let zT_B = farr_zeros(d)
    let _ = farr_set(zT_B, 1, 1.0)
    let tgt_A = 0    // register A → token 0
    let tgt_B = 2    // register B → token 2

    let lr = 0.5
    let n_steps = 400

    // initial loss (avg over A,B)
    let dlg = farr_zeros(V)
    let g0 = farr_zeros(n_experts)
    let lg0 = farr_zeros(V)
    moe_route_fwd(zT_A, M, router_off, experts_off, n_experts, V, d, g0, lg0)
    let ce_A0 = ce_loss_grad(lg0, tgt_A, V, dlg)
    moe_route_fwd(zT_B, M, router_off, experts_off, n_experts, V, d, g0, lg0)
    let ce_B0 = ce_loss_grad(lg0, tgt_B, V, dlg)
    let init_loss = (ce_A0 + ce_B0) / 2.0
    print("  init avg CE = "); print(init_loss)

    // train: alternate A / B
    let mut step = 0
    while step < n_steps {
        let _ = moe_toy_step(zT_A, tgt_A, M, router_off, experts_off, n_experts, V, d, total, lr)
        let _ = moe_toy_step(zT_B, tgt_B, M, router_off, experts_off, n_experts, V, d, total, lr)
        step = step + 1
    }

    // final loss
    moe_route_fwd(zT_A, M, router_off, experts_off, n_experts, V, d, g0, lg0)
    let ce_Af = ce_loss_grad(lg0, tgt_A, V, dlg)
    moe_route_fwd(zT_B, M, router_off, experts_off, n_experts, V, d, g0, lg0)
    let ce_Bf = ce_loss_grad(lg0, tgt_B, V, dlg)
    let final_loss = (ce_Af + ce_Bf) / 2.0
    print("  final avg CE = "); print(final_loss)

    // router differentiation: which expert does each register route to?
    let gA = farr_zeros(n_experts)
    let gB = farr_zeros(n_experts)
    moe_toy_gate(zT_A, M, router_off, n_experts, d, gA)
    moe_toy_gate(zT_B, M, router_off, n_experts, d, gB)
    print("  gate(A) e0="); print(farr_get(gA, 0)); print(" e1="); print(farr_get(gA, 1))
    print("  gate(B) e0="); print(farr_get(gB, 0)); print(" e1="); print(farr_get(gB, 1))
    let topA = moe_argmax(gA, n_experts)
    let topB = moe_argmax(gB, n_experts)

    // VERDICT
    let loss_dropped = if final_loss < init_loss * 0.5 { 1 } else { 0 }
    let differentiated = if topA == topB { 0 } else { 1 }
    print("  [verdict] loss_dropped="); print(loss_dropped)
    print("  [verdict] router_differentiated (topA!=topB)="); print(differentiated)
    if loss_dropped == 1 {
        if differentiated == 1 {
            print("=== M4b-wire-toy: PASS — MoE learned + experts differentiated (H_490 escape signal) ===")
        } else {
            print("=== M4b-wire-toy: PARTIAL — MoE learned but no expert differentiation ===")
        }
    } else {
        print("=== M4b-wire-toy: FAIL — MoE did not learn the two registers ===")
    }

    let _ = farr_free(M)
    let _ = farr_free(zT_A)
    let _ = farr_free(zT_B)
    let _ = farr_free(dlg)
    let _ = farr_free(g0)
    let _ = farr_free(lg0)
    let _ = farr_free(gA)
    let _ = farr_free(gB)
}
