// ════════════════════════════════════════════════════════════════════════════
//  CORE/DECODER/h686_h687_axis_sweep.hexa
//
//   H_686 + H_687 — 3-axis (corpus distribution · d · n_layer) toy sweep.
//
//   CONTEXT
//     PR #1395 (h686_h687_aux_ablation) came back ⚪ TOY-NULL at V=8 d=6:
//     baseline cell-a already escapes (4/4 distinct_experts, LZ_norm=0.0360459).
//     PR #1409 (h686_h687_v_scale) swept V ∈ {8,64,256,1024,4096} and confirmed
//     V-axis ⊥ collapse axis (🟠 SWEEP-OUT-OF-RANGE — no V band reproduces).
//
//     This harness extends the toy regime along three NEW orthogonal axes to
//     identify which one (if any) reproduces the M4b production collapse at
//     $0 Mac local:
//
//       AXIS_CORPUS ∈ {uniform, mild_skew, current_skewed, zipf_strong}
//         · uniform         — every cluster equally represented (rep=1 each)
//         · mild_skew       — cluster 0 = 4× over-rep (vs 20×)
//         · current_skewed  — cluster 0 = 20× over-rep (PR #1395 verbatim)
//         · zipf_strong     — Zipfian f(c) = floor(60 / (c+1))
//                             → c0=60 c1=30 c2=20 c3=15 c4=12 c5=10 (matches
//                             production token-distribution shape more closely)
//
//       AXIS_D ∈ {6, 24, 64}  — embedding/head dim
//         · d=6   = PR #1395 verbatim (n_clusters parity)
//         · d=24  = 4× over-supplied capacity
//         · d=64  = ~10× over-supplied capacity
//
//       AXIS_NLAYER ∈ {1, 2, 4} — depth proxy (sequential expert MLP stack)
//         · n_layer=1 = PR #1395 verbatim (router→expert→logits)
//         · n_layer=2 = router→expert_l1→relu→expert_l2→logits
//         · n_layer=4 = router→4-step expert MLP stack→logits
//         Implementation: each expert reuses ONE V×d weight tile (no extra
//         params for proxy), repeated n_layer times with a residual+silu in
//         between. This is a structural-depth proxy at NO additional cost.
//
//       ABLATION_CELL ∈ {none, both}  (drop ent_only / kl_only for cell-budget)
//         · none  = no aux (baseline)
//         · both  = H_686 ent + H_687 kl aux (the strongest escape)
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F-AXSW-1 SANITY-BYTE-EQ : at corpus=current_skewed, d=6, n_layer=1,
//             cell=none → LZ_norm = 0.0360459 distinct=4 byte-eq vs PR #1395.
//             FAIL → parametrization drift, abort and report.
//     F-AXSW-2 GRID-COMPLETE  : 20/20 cells produce a (LZ_norm, distinct, CE)
//             triple (no NaN, no crash).
//     F-AXSW-3 ANY-AXIS-REPRO : at least one (axis, value) with cell=none has
//             distinct ≤ 2 OR LZ_norm < 0.01 (collapse threshold).
//             PASS → collapse axis identified at $0 toy.
//             FAIL → no toy axis reproduces production collapse →
//             🟠 OUT-OF-RANGE on all 3 axes too.
//     F-AXSW-4 AUX-ESCAPE-IF-COLLAPSE : for every (axis, value) where F-AXSW-3
//             triggered, the cell=both run shows distinct ≥ 3 AND LZ_norm
//             > 0.01 (escape).
//             PASS → 🟢 aux escape confirmed at toy.
//             FAIL → aux mechanism does NOT escape even on collapse →
//             🔴 aux falsified.
//
//   DETERMINISM · hexa-only · $0 mac-local · NO GPU · foreground.
//   λ_ent = 0.1, λ_kl = 0.1, lr=0.5, n_steps=600 (PR #1395/#1409 verbatim).
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/CORE/DECODER/moe_router.hexa"
import "/Users/ghost/core/anima/CORE/DECODER/moe_router_bwd.hexa"

fn log2(x: float) -> float { return log(x) / log(2.0) }
fn safe_ln(x: float) -> float {
    let xs = if x < 0.000000000001 { 0.000000000001 } else { x }
    return moe_ln(xs)
}

// ── canonical LZ76 (PR #1395/#1409 verbatim) ────────────────────────────────
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}

let BITS = 18  // PR #1395/#1409 verbatim

fn ids_to_bits(ids: array, n: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let mut v = ids[i]
        let mut b = 0
        while b < BITS {
            out = out.push(v % 2)
            v = v / 2
            b = b + 1
        }
        i = i + 1
    }
    return out
}
fn lz_raw_arr(ids: array, n: int) -> int {
    let bits = ids_to_bits(ids, n)
    return lz76(bits, n * BITS)
}
fn lz_norm_arr(ids: array, n: int) -> float {
    let len = n * BITS
    let c = lz_raw_arr(ids, n)
    return to_float(c) * log2(to_float(len)) / to_float(len)
}

// ── CE + grad (PR #1395 verbatim) ───────────────────────────────────────────
fn ce_loss_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - moe_ln(p_tgt + 0.0000000001)
    let mut k = 0
    while k < V {
        let pk = farr_get(d_logits_out, k) / tot
        let tgt = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, pk - tgt)
        k = k + 1
    }
    return ce
}

fn softmax_into(logits: int, V: int, p_out: int) {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(p_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let mut i3 = 0
    while i3 < V {
        let _ = farr_set(p_out, i3, farr_get(p_out, i3) / tot)
        i3 = i3 + 1
    }
}

fn entropy_nats(p: int, n: int) -> float {
    let mut h = 0.0
    let mut i = 0
    while i < n {
        let pi = farr_get(p, i)
        if pi > 0.000000000001 {
            h = h - pi * moe_ln(pi)
        }
        i = i + 1
    }
    return h
}

// ── n_layer proxy: silu(x) = x * sigmoid(x). gradient = sigmoid(x) + x*sigmoid(x)(1-sigmoid(x))
fn silu(x: float) -> float {
    let s = 1.0 / (1.0 + moe_exp(0.0 - x))
    return x * s
}
fn silu_grad(x: float) -> float {
    let s = 1.0 / (1.0 + moe_exp(0.0 - x))
    return s + x * s * (1.0 - s)
}

// ── ONE training step (n_layer proxy via repeated expert pass + residual+silu).
//    n_layer=1 = PR #1395 byte-eq path (no inner stack).
//    n_layer>1 = apply expert linear k=n_layer times: y = silu(W_top·z) for
//                inner steps, last step is raw matmul → logits.
//    NOTE: only the FINAL expert linear contributes to logits CE backward.
//    Inner silu steps share the SAME W_top tile (V×d) so we slice the first d
//    rows of W_top as a d×d block — this is a structural-depth proxy that
//    forces the gradient to flow through n_layer−1 silu nonlinearities.
//
//    Implementation: for n_layer=1, identical to PR #1395 algorithm (byte-eq).
//    For n_layer>1, prepend a (d→d) silu stack using W_top[:d,:d] (top-left).
fn moe_toy_step_aux(zT: int, target: int, M: int, router_off: int, experts_off: int,
                    n_experts: int, V: int, d: int, total: int, lr: float,
                    cell: int, lam_ent: float, lam_kl: float, n_layer: int) -> float {
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)

    // ── compute z_input for the final expert matmul = silu^(n_layer-1)(zT) ──
    let z_chain = farr_zeros(d * n_layer)  // store activations at each layer for bwd
    let mut layer_i = 0
    while layer_i < d {
        let _ = farr_set(z_chain, layer_i, farr_get(zT, layer_i))
        layer_i = layer_i + 1
    }

    // For inner layers (1..n_layer-1), apply silu(W_top[:d,:d] · prev) and store.
    // (W_top[:d,:d] = first d rows × first d cols of expert_top tile.)
    // We need to know top FIRST so do the router forward first.
    let top = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)

    // Now redo the forward chain through n_layer-1 inner silu steps using
    // the SELECTED expert's W[:d, :d] slice, then a final matmul to V logits.
    if n_layer > 1 {
        let base_top = experts_off + top * V * d
        let mut L = 1
        while L < n_layer {
            let prev_off = (L - 1) * d
            let cur_off = L * d
            let mut j = 0
            while j < d {
                let mut acc = 0.0
                let mut k = 0
                while k < d {
                    let w = farr_get(M, base_top + j * d + k)  // row j, col k
                    let zk = farr_get(z_chain, prev_off + k)
                    acc = acc + w * zk
                    k = k + 1
                }
                let _ = farr_set(z_chain, cur_off + j, silu(acc))
                j = j + 1
            }
            L = L + 1
        }
        // Final expert forward: re-compute logits with the stacked z.
        // logits[k] = Σ_j W[k,j] · z_chain[last, j]
        let last_off = (n_layer - 1) * d
        let mut k = 0
        while k < V {
            let mut acc = 0.0
            let mut j = 0
            while j < d {
                let w = farr_get(M, base_top + k * d + j)
                let zj = farr_get(z_chain, last_off + j)
                acc = acc + w * zj
                j = j + 1
            }
            let gt = farr_get(gate, top)
            let _ = farr_set(logits, k, gt * acc)
            k = k + 1
        }
    }

    let d_logits = farr_zeros(V)
    let ce = ce_loss_grad(logits, target, V, d_logits)

    // H_687 KL-to-uniform
    if cell == 2 || cell == 3 {
        let q = farr_zeros(V)
        softmax_into(logits, V, q)
        let Hq = entropy_nats(q, V)
        let mut j = 0
        while j < V {
            let qj = farr_get(q, j)
            let term = lam_kl * qj * (safe_ln(qj) + Hq)
            let cur = farr_get(d_logits, j)
            let _ = farr_set(d_logits, j, cur + term)
            j = j + 1
        }
        let _ = farr_free(q)
    }

    let gt = farr_get(gate, top)
    let base_top = experts_off + top * V * d
    let dM = farr_zeros(total)
    let d_zT = farr_zeros(d)
    let d_gate = farr_zeros(n_experts)
    let mut dgt = 0.0

    // ── final layer bwd (matmul → logits) uses z_chain[last_off,:] ─────────
    let last_off = (n_layer - 1) * d
    let mut k0 = 0
    while k0 < V {
        let dlk = farr_get(d_logits, k0)
        let mut elk = 0.0
        let mut j0 = 0
        while j0 < d {
            let w = farr_get(M, base_top + k0 * d + j0)
            let zj = farr_get(z_chain, last_off + j0)
            elk = elk + w * zj
            let cur = farr_get(dM, base_top + k0 * d + j0)
            let _ = farr_set(dM, base_top + k0 * d + j0, cur + gt * dlk * zj)
            // d_z_last[j0] += gt * w * dlk    (will be propagated through silu chain)
            j0 = j0 + 1
        }
        dgt = dgt + dlk * elk
        k0 = k0 + 1
    }

    // d_z accumulator for the last layer activations (we'll propagate backward
    // through n_layer-1 silu steps using W_top[:d,:d]).
    let d_z_last = farr_zeros(d)
    let mut k1 = 0
    while k1 < V {
        let dlk = farr_get(d_logits, k1)
        let mut j1 = 0
        while j1 < d {
            let w = farr_get(M, base_top + k1 * d + j1)
            let cur = farr_get(d_z_last, j1)
            let _ = farr_set(d_z_last, j1, cur + gt * w * dlk)
            j1 = j1 + 1
        }
        k1 = k1 + 1
    }

    // Propagate through inner silu layers (n_layer-1, n_layer-2, ..., 1).
    if n_layer > 1 {
        let mut cur_d_z = d_z_last
        let mut L = n_layer - 1
        while L >= 1 {
            let cur_off = L * d
            let prev_off = (L - 1) * d
            // silu_grad applied: d_pre[j] = cur_d_z[j] * silu_grad(pre_j)
            // where pre_j = W[j,:] · z_chain[prev_off,:]  (rebuild it).
            let d_pre = farr_zeros(d)
            let mut j = 0
            while j < d {
                let mut pre = 0.0
                let mut k = 0
                while k < d {
                    let w = farr_get(M, base_top + j * d + k)
                    let zk = farr_get(z_chain, prev_off + k)
                    pre = pre + w * zk
                    k = k + 1
                }
                let g = silu_grad(pre)
                let _ = farr_set(d_pre, j, farr_get(cur_d_z, j) * g)
                j = j + 1
            }
            // d_W[:d,:d] += d_pre[j] · z_chain[prev_off, k]
            // d_z_prev[k] += W[j,k] · d_pre[j]
            let d_z_prev = farr_zeros(d)
            let mut j2 = 0
            while j2 < d {
                let dpj = farr_get(d_pre, j2)
                let mut k2 = 0
                while k2 < d {
                    let w = farr_get(M, base_top + j2 * d + k2)
                    let zk = farr_get(z_chain, prev_off + k2)
                    let cur = farr_get(dM, base_top + j2 * d + k2)
                    let _ = farr_set(dM, base_top + j2 * d + k2, cur + dpj * zk)
                    let dz = farr_get(d_z_prev, k2)
                    let _ = farr_set(d_z_prev, k2, dz + w * dpj)
                    k2 = k2 + 1
                }
                j2 = j2 + 1
            }
            cur_d_z = d_z_prev
            let _ = farr_free(d_pre)
            L = L - 1
        }
        // After inner-silu propagation, cur_d_z = d_zT (will be set below).
        let mut j3 = 0
        while j3 < d {
            let _ = farr_set(d_zT, j3, farr_get(cur_d_z, j3))
            j3 = j3 + 1
        }
    } else {
        let mut j3 = 0
        while j3 < d {
            let _ = farr_set(d_zT, j3, farr_get(d_z_last, j3))
            j3 = j3 + 1
        }
    }
    let _ = farr_free(d_z_last)

    let _ = farr_set(d_gate, top, dgt)

    // H_686 ent aux
    if cell == 1 || cell == 3 {
        let mut e = 0
        while e < n_experts {
            let pe = farr_get(gate, e)
            let term = lam_ent * (safe_ln(pe) + 1.0)
            let cur = farr_get(d_gate, e)
            let _ = farr_set(d_gate, e, cur + term)
            e = e + 1
        }
    }

    let d_gate_raw = farr_zeros(n_experts)
    moe_softmax_bwd(gate, d_gate, n_experts, d_gate_raw)
    moe_gate_bwd(zT, M, router_off, n_experts, d, d_gate_raw, dM, d_zT)

    let mut i = 0
    while i < total {
        let _ = farr_set(M, i, farr_get(M, i) - lr * farr_get(dM, i))
        i = i + 1
    }

    let _ = farr_free(gate)
    let _ = farr_free(logits)
    let _ = farr_free(d_logits)
    let _ = farr_free(d_gate)
    let _ = farr_free(d_gate_raw)
    let _ = farr_free(dM)
    let _ = farr_free(d_zT)
    let _ = farr_free(z_chain)
    return ce
}

fn set_cluster(zT: int, c: int, d: int) {
    let mut j = 0
    while j < d {
        let _ = farr_set(zT, j, 0.0)
        j = j + 1
    }
    // place 1.0 at position min(c, d-1)  (when d > n_clusters, use slot c)
    let pos = if c < d { c } else { d - 1 }
    let _ = farr_set(zT, pos, 1.0)
}

fn decode_argmax_for_cluster(c: int, M: int, router_off: int, experts_off: int,
                              n_experts: int, V: int, d: int, zT: int, out_top: int,
                              n_layer: int) -> int {
    let mut j = 0
    while j < d {
        let _ = farr_set(zT, j, 0.0)
        j = j + 1
    }
    let pos = if c < d { c } else { d - 1 }
    let _ = farr_set(zT, pos, 1.0)
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    let top = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)

    // n_layer>1: re-compute logits through silu stack
    if n_layer > 1 {
        let base_top = experts_off + top * V * d
        let z_chain = farr_zeros(d * n_layer)
        let mut p = 0
        while p < d {
            let _ = farr_set(z_chain, p, farr_get(zT, p))
            p = p + 1
        }
        let mut L = 1
        while L < n_layer {
            let prev_off = (L - 1) * d
            let cur_off = L * d
            let mut jj = 0
            while jj < d {
                let mut acc = 0.0
                let mut kk = 0
                while kk < d {
                    let w = farr_get(M, base_top + jj * d + kk)
                    let zk = farr_get(z_chain, prev_off + kk)
                    acc = acc + w * zk
                    kk = kk + 1
                }
                let _ = farr_set(z_chain, cur_off + jj, silu(acc))
                jj = jj + 1
            }
            L = L + 1
        }
        let last_off = (n_layer - 1) * d
        let gt = farr_get(gate, top)
        let mut kk2 = 0
        while kk2 < V {
            let mut acc = 0.0
            let mut jj2 = 0
            while jj2 < d {
                let w = farr_get(M, base_top + kk2 * d + jj2)
                let zj = farr_get(z_chain, last_off + jj2)
                acc = acc + w * zj
                jj2 = jj2 + 1
            }
            let _ = farr_set(logits, kk2, gt * acc)
            kk2 = kk2 + 1
        }
        let _ = farr_free(z_chain)
    }

    let mut bi = 0
    let mut bv = farr_get(logits, 0)
    let mut k = 1
    while k < V {
        if farr_get(logits, k) > bv { bv = farr_get(logits, k); bi = k }
        k = k + 1
    }
    let _ = farr_set(out_top, 0, to_float(top))
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    return bi
}

// ── corpus repetition schedule per AXIS_CORPUS ────────────────────────────
//   returns rep count for cluster c (0..n_clusters-1) under given corpus mode.
//   0=uniform, 1=mild_skew, 2=current_skewed, 3=zipf_strong
fn corpus_reps(c: int, corpus_mode: int) -> int {
    if corpus_mode == 0 { return 1 }
    if corpus_mode == 1 {
        if c == 0 { return 4 } else { return 1 }
    }
    if corpus_mode == 2 {
        if c == 0 { return 20 } else { return 1 }
    }
    // 3 = zipf_strong: floor(60/(c+1))
    if c == 0 { return 60 }
    if c == 1 { return 30 }
    if c == 2 { return 20 }
    if c == 3 { return 15 }
    if c == 4 { return 12 }
    return 10
}

fn corpus_name(m: int) -> string {
    if m == 0 { return "uniform" }
    if m == 1 { return "mild_skew" }
    if m == 2 { return "current_skewed" }
    if m == 3 { return "zipf_strong" }
    return "unknown"
}

fn cell_name(cell: int) -> string {
    if cell == 0 { return "none" }
    if cell == 3 { return "both" }
    return "?"
}

// ── run one (corpus, d, n_layer, cell) cell ───────────────────────────────
//   Output: (LZ_norm, distinct, final_CE, init_CE, n_dec)
fn run_cell(corpus_mode: int, d: int, n_layer: int, cell: int, out5: int) {
    let n_experts = 4
    let V = 8
    let n_clusters = 6
    let router_off = 0
    let experts_off = n_experts * d
    let total = experts_off + n_experts * V * d
    let lam_ent = 0.1
    let lam_kl = 0.1

    let M = farr_zeros(total)
    let mut s = 0
    while s < total {
        let base = if s == s / 2 * 2 { 0.02 } else { 0.0 - 0.02 }
        let bump = to_float(s == s / 3 * 3) * 0.015
        let bump2 = to_float(s == s / 5 * 5) * 0.01
        let _ = farr_set(M, s, base + bump + bump2)
        s = s + 1
    }

    let zT = farr_zeros(d)
    let lr = 0.5
    let n_steps = 600

    // initial avg CE
    let dlg = farr_zeros(V)
    let g0 = farr_zeros(n_experts)
    let lg0 = farr_zeros(V)
    let mut init_sum = 0.0
    let mut c0 = 0
    while c0 < n_clusters {
        set_cluster(zT, c0, d)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        init_sum = init_sum + ce_loss_grad(lg0, c0, V, dlg)
        c0 = c0 + 1
    }
    let init_loss = init_sum / to_float(n_clusters)

    // train
    let mut step = 0
    while step < n_steps {
        let mut c = 0
        while c < n_clusters {
            set_cluster(zT, c, d)
            let reps = corpus_reps(c, corpus_mode)
            let mut r = 0
            while r < reps {
                let _ = moe_toy_step_aux(zT, c, M, router_off, experts_off,
                                          n_experts, V, d, total, lr,
                                          cell, lam_ent, lam_kl, n_layer)
                r = r + 1
            }
            c = c + 1
        }
        step = step + 1
    }

    // final avg CE
    let mut fin_sum = 0.0
    let mut cf = 0
    while cf < n_clusters {
        set_cluster(zT, cf, d)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        fin_sum = fin_sum + ce_loss_grad(lg0, cf, V, dlg)
        cf = cf + 1
    }
    let final_loss = fin_sum / to_float(n_clusters)

    // DECODE: 4 cycles × 6 clusters with corpus_mode multiplicity
    let n_decode_cycles = 4
    let mut decoded = []
    let top_out = farr_zeros(1)
    let mut seen0 = false
    let mut seen1 = false
    let mut seen2 = false
    let mut seen3 = false
    let mut cyc = 0
    while cyc < n_decode_cycles {
        let mut cc = 0
        while cc < n_clusters {
            let tok = decode_argmax_for_cluster(cc, M, router_off, experts_off,
                                                  n_experts, V, d, zT, top_out, n_layer)
            let top = to_int(farr_get(top_out, 0))
            if top == 0 { seen0 = true }
            if top == 1 { seen1 = true }
            if top == 2 { seen2 = true }
            if top == 3 { seen3 = true }
            let reps = corpus_reps(cc, corpus_mode)
            let mut r = 0
            while r < reps {
                decoded = decoded.push(tok)
                r = r + 1
            }
            cc = cc + 1
        }
        cyc = cyc + 1
    }
    let n_dec = decoded.len()
    let lz = lz_norm_arr(decoded, n_dec)
    let mut de = 0
    if seen0 { de = de + 1 }
    if seen1 { de = de + 1 }
    if seen2 { de = de + 1 }
    if seen3 { de = de + 1 }

    // also count distinct DECODED TOKENS (matters for collapse)
    // simple V<=8 bitmask
    let mut tok_mask = 0
    let mut tp = 0
    while tp < n_dec {
        let v = decoded[tp]
        if v >= 0 && v < V {
            let b = 1
            let mut shift = 0
            let mut bit = 1
            while shift < v { bit = bit * 2; shift = shift + 1 }
            tok_mask = tok_mask | bit
        }
        tp = tp + 1
    }
    let mut distinct_tok = 0
    let mut bb = 0
    let mut tm = tok_mask
    while bb < V {
        if tm % 2 == 1 { distinct_tok = distinct_tok + 1 }
        tm = tm / 2
        bb = bb + 1
    }

    let _ = farr_set(out5, 0, lz)
    let _ = farr_set(out5, 1, to_float(de))
    let _ = farr_set(out5, 2, final_loss)
    let _ = farr_set(out5, 3, init_loss)
    let _ = farr_set(out5, 4, to_float(distinct_tok))

    let _ = farr_free(M)
    let _ = farr_free(zT)
    let _ = farr_free(dlg)
    let _ = farr_free(g0)
    let _ = farr_free(lg0)
    let _ = farr_free(top_out)
}

// returns 1 if cell satisfies collapse-criterion (distinct_tok <= 2 OR lz < 0.01).
fn collapsed(lz: float, distinct_tok: float) -> bool {
    return (distinct_tok < 2.5) || (lz < 0.01)
}
fn escape_ok(lz: float, distinct_tok: float) -> bool {
    return (distinct_tok >= 3.0) && (lz > 0.01)
}

fn main() {
    println("================================================================")
    println("  H_686/H_687 3-AXIS sweep (corpus · d · n_layer) — $0 mac-local")
    println("       baseline: V=8 E=4 n_clusters=6 600 step lr=0.5 lam_ent=0.1 lam_kl=0.1")
    println("================================================================")

    let n_axes = 3
    let total_cells = 20

    // Storage: 20 rows × 5 floats (lz, distinct_e, final_ce, init_ce, distinct_tok).
    // Plus 20 rows of metadata (corpus, d, n_layer, cell, sweep_axis_idx).

    // ── SANITY: corpus=current_skewed (2), d=6, n_layer=1, cell=none (0) ──
    println("--- F-AXSW-1 SANITY (corpus=current_skewed d=6 n_layer=1 cell=none) ---")
    let out_sanity = farr_zeros(5)
    run_cell(2, 6, 1, 0, out_sanity)
    let lz_san = farr_get(out_sanity, 0)
    let de_san = farr_get(out_sanity, 1)
    let dt_san = farr_get(out_sanity, 4)
    println("  LZ_norm  = " + str(lz_san) + " (expect 0.0360459 vs PR #1395)")
    println("  distinct_experts = " + str(de_san) + " (expect 4)")
    println("  distinct_tokens  = " + str(dt_san))
    let lz_diff = if lz_san - 0.0360459 < 0.0 { 0.0360459 - lz_san } else { lz_san - 0.0360459 }
    let sanity_ok = (lz_diff < 0.0001) && (de_san > 3.5)
    if sanity_ok {
        println("  [PASS] F-AXSW-1 SANITY byte-eq")
    } else {
        println("  [FAIL] F-AXSW-1 SANITY drift — ABORT")
        panic("parametrization drift — see lz_diff above")
    }

    // ── corpus sweep: {0..3} × {0, 3} = 8 cells (d=6, n_layer=1 fixed) ────
    println("--- AXIS CORPUS sweep (d=6 n_layer=1) ---")
    let lz_c = farr_zeros(8)
    let de_c = farr_zeros(8)
    let dt_c = farr_zeros(8)
    let ce_c = farr_zeros(8)
    let mut ic = 0
    while ic < 4 {
        let mut ie = 0
        while ie < 2 {
            let cell = if ie == 0 { 0 } else { 3 }
            let idx = ic * 2 + ie
            let out = farr_zeros(5)
            run_cell(ic, 6, 1, cell, out)
            let lz_v = farr_get(out, 0)
            let de_v = farr_get(out, 1)
            let dt_v = farr_get(out, 4)
            let ce_v = farr_get(out, 2)
            let _ = farr_set(lz_c, idx, lz_v)
            let _ = farr_set(de_c, idx, de_v)
            let _ = farr_set(dt_c, idx, dt_v)
            let _ = farr_set(ce_c, idx, ce_v)
            println("  corpus=" + corpus_name(ic) + " cell=" + cell_name(cell)
                  + " LZ=" + str(lz_v) + " dE=" + str(de_v)
                  + " dT=" + str(dt_v) + " CE=" + str(ce_v))
            let _ = farr_free(out)
            ie = ie + 1
        }
        ic = ic + 1
    }

    // ── d sweep: {6, 24, 64} × {0, 3} = 6 cells (corpus=current_skewed, n_layer=1) ──
    println("--- AXIS D sweep (corpus=current_skewed n_layer=1) ---")
    let lz_d = farr_zeros(6)
    let de_d = farr_zeros(6)
    let dt_d = farr_zeros(6)
    let ce_d = farr_zeros(6)
    let d_vals = [6, 24, 64]
    let mut id_ = 0
    while id_ < 3 {
        let mut ie2 = 0
        while ie2 < 2 {
            let cell = if ie2 == 0 { 0 } else { 3 }
            let idx = id_ * 2 + ie2
            let out = farr_zeros(5)
            run_cell(2, d_vals[id_], 1, cell, out)
            let lz_v = farr_get(out, 0)
            let de_v = farr_get(out, 1)
            let dt_v = farr_get(out, 4)
            let ce_v = farr_get(out, 2)
            let _ = farr_set(lz_d, idx, lz_v)
            let _ = farr_set(de_d, idx, de_v)
            let _ = farr_set(dt_d, idx, dt_v)
            let _ = farr_set(ce_d, idx, ce_v)
            println("  d=" + str(d_vals[id_]) + " cell=" + cell_name(cell)
                  + " LZ=" + str(lz_v) + " dE=" + str(de_v)
                  + " dT=" + str(dt_v) + " CE=" + str(ce_v))
            let _ = farr_free(out)
            ie2 = ie2 + 1
        }
        id_ = id_ + 1
    }

    // ── n_layer sweep: {1, 2, 4} × {0, 3} = 6 cells (corpus=current_skewed, d=6) ──
    println("--- AXIS N_LAYER sweep (corpus=current_skewed d=6) ---")
    let lz_n = farr_zeros(6)
    let de_n = farr_zeros(6)
    let dt_n = farr_zeros(6)
    let ce_n = farr_zeros(6)
    let nl_vals = [1, 2, 4]
    let mut in_ = 0
    while in_ < 3 {
        let mut ie3 = 0
        while ie3 < 2 {
            let cell = if ie3 == 0 { 0 } else { 3 }
            let idx = in_ * 2 + ie3
            let out = farr_zeros(5)
            run_cell(2, 6, nl_vals[in_], cell, out)
            let lz_v = farr_get(out, 0)
            let de_v = farr_get(out, 1)
            let dt_v = farr_get(out, 4)
            let ce_v = farr_get(out, 2)
            let _ = farr_set(lz_n, idx, lz_v)
            let _ = farr_set(de_n, idx, de_v)
            let _ = farr_set(dt_n, idx, dt_v)
            let _ = farr_set(ce_n, idx, ce_v)
            println("  n_layer=" + str(nl_vals[in_]) + " cell=" + cell_name(cell)
                  + " LZ=" + str(lz_v) + " dE=" + str(de_v)
                  + " dT=" + str(dt_v) + " CE=" + str(ce_v))
            let _ = farr_free(out)
            ie3 = ie3 + 1
        }
        in_ = in_ + 1
    }

    // ── F-AXSW-3: any (axis, value) with cell=none yields collapse? ────────
    println("================================================================")
    println("  F-AXSW-3 ANY-AXIS-REPRO check")
    println("================================================================")
    let mut any_collapsed = false
    let mut collapsed_label = "none"
    let mut collapsed_aux_escape = true  // updates per detection

    // corpus axis: indices 0,2,4,6 (cell=none for ic=0,1,2,3)
    let mut ic2 = 0
    while ic2 < 4 {
        let idx_none = ic2 * 2
        let idx_both = ic2 * 2 + 1
        let lz_v = farr_get(lz_c, idx_none)
        let dt_v = farr_get(dt_c, idx_none)
        let lz_b = farr_get(lz_c, idx_both)
        let dt_b = farr_get(dt_c, idx_both)
        if collapsed(lz_v, dt_v) {
            any_collapsed = true
            collapsed_label = "corpus=" + corpus_name(ic2)
            println("  collapse @ corpus=" + corpus_name(ic2) + " (LZ=" + str(lz_v)
                  + " dT=" + str(dt_v) + ") — aux(both): LZ=" + str(lz_b)
                  + " dT=" + str(dt_b))
            if !escape_ok(lz_b, dt_b) { collapsed_aux_escape = false }
        }
        ic2 = ic2 + 1
    }
    // d axis
    let mut id2 = 0
    while id2 < 3 {
        let idx_none = id2 * 2
        let idx_both = id2 * 2 + 1
        let lz_v = farr_get(lz_d, idx_none)
        let dt_v = farr_get(dt_d, idx_none)
        let lz_b = farr_get(lz_d, idx_both)
        let dt_b = farr_get(dt_d, idx_both)
        if collapsed(lz_v, dt_v) {
            any_collapsed = true
            collapsed_label = "d=" + str(d_vals[id2])
            println("  collapse @ d=" + str(d_vals[id2]) + " (LZ=" + str(lz_v)
                  + " dT=" + str(dt_v) + ") — aux(both): LZ=" + str(lz_b)
                  + " dT=" + str(dt_b))
            if !escape_ok(lz_b, dt_b) { collapsed_aux_escape = false }
        }
        id2 = id2 + 1
    }
    // n_layer axis
    let mut in2 = 0
    while in2 < 3 {
        let idx_none = in2 * 2
        let idx_both = in2 * 2 + 1
        let lz_v = farr_get(lz_n, idx_none)
        let dt_v = farr_get(dt_n, idx_none)
        let lz_b = farr_get(lz_n, idx_both)
        let dt_b = farr_get(dt_n, idx_both)
        if collapsed(lz_v, dt_v) {
            any_collapsed = true
            collapsed_label = "n_layer=" + str(nl_vals[in2])
            println("  collapse @ n_layer=" + str(nl_vals[in2]) + " (LZ=" + str(lz_v)
                  + " dT=" + str(dt_v) + ") — aux(both): LZ=" + str(lz_b)
                  + " dT=" + str(dt_b))
            if !escape_ok(lz_b, dt_b) { collapsed_aux_escape = false }
        }
        in2 = in2 + 1
    }

    println("================================================================")
    println("  FINAL VERDICT")
    println("================================================================")
    if !any_collapsed {
        println("  🟠 SWEEP-OUT-OF-RANGE — no toy axis reproduces production collapse.")
        println("     All baseline (cell=none) cells achieve distinct_tok >= 3 AND LZ_norm > 0.01.")
        println("     Toy harness (V=8 baseline + 3-axis sweep) ⊥ production collapse mechanism.")
        println("     production fire (V=151643 M4b regime) remains the only valid test.")
    } else {
        if collapsed_aux_escape {
            println("  🟢 ESCAPE-CONFIRMED at toy — collapse reproduces at " + collapsed_label)
            println("     AND H_686+H_687 (both) aux escapes (distinct_tok >= 3 AND LZ > 0.01).")
        } else {
            println("  🔴 AUX-FALSIFIED — collapse reproduces at " + collapsed_label)
            println("     BUT cell=both (H_686+H_687) does NOT escape.")
        }
    }
    println("================================================================")
}
