// CORE/DECODER/v3_moe_arch.hexa — M4b-fire-scale Phase 2a (canonical CORE/DECODER location)
//
// MoE-aware packed-M variants of v3 head_g forward/backward (top-1 hard routing).
// Replaces head_g (V·d) slot with router(E·d) + experts(E·V·d):
//
//   head_g layout:    [v2_spine | head_g (V·d)        | tension_proj | pf | cx]
//   MoE layout:       [v2_spine | router(E·d) experts(E·V·d) | tension_proj | pf | cx]
//
// Top-1 hard routing rationale (M4b-fire-toy verdict — anima #1033):
//   - soft routing → dense-collapse (gate stuck 50/50, no differentiation)
//   - top-1 hard → winner expert gets all gradient → register-carving
//     specialization, other experts stay coherent (main path)
//   - empirical: cluster A → gate(A)=[0.97,0.03]→e0, cluster B → gate(B)→e1,
//     CE 1.389 → 0.00388 (358× drop in 400 SGD steps)
//
// V3 더블바인드 escape mechanism: register-carving 을 specialized expert 에
// 격리 → main path 는 coherent 유지 (collapse 회피) + register 신호는
// dedicated expert 가 담당 (underfit 회피). a_completeness_over_cheap 본선.
//
// Self-contained: stdlib/flame/{tensor_lib, flame_math} 만 의존 (fire artifact
// HEXAD/.../conscious_decoder_v3.hexa 무관). caller (train driver, Phase 2b)
// 가 packed M 안 router_off + experts_off 를 결정해 전달.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"

// ─── MoE forward (top-1 hard routing, packed-M variant) ────────────────
// gate[e]     = Σ_j M[router_off + e·d + j] · zT[j]
// gate_norm   = softmax(gate)  (stable: subtract max)
// top         = argmax(gate_norm)
// logits_g[k] = gate_norm[top] · Σ_j M[experts_off + top·V·d + k·d + j] · zT[j]
//               (top-1 hard: only the winner expert emits, scaled by its gate prob)
//
// Inputs:
//   zT [d]                          last-token state (final-RMSNorm output)
//   M  [packed]                     full model buffer (read-only here)
//   router_off                      router slot offset within M
//   experts_off                     experts slot offset within M (= router_off + E·d 보통)
//   V, d, E                         vocab size · model dim · expert count
//
// Outputs (written):
//   logits_g_out [V]                dual-emission logits (MoE-routed)
//   gate_norm_out [E]               post-softmax gate (needed by bwd)
//
// Returns: top_idx (int) — winning expert index, needed by bwd
pub fn v3_moe_fwd(zT: int, M: int, router_off: int, experts_off: int,
                  logits_g_out: int, gate_norm_out: int,
                  V: int, d: int, E: int) -> int {
    // 1) gate logits (E·d linear over zT)
    let mut e = 0
    while e < E {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(M, router_off + e * d + j) * farr_get(zT, j)
            j = j + 1
        }
        let _ = farr_set(gate_norm_out, e, acc)
        e = e + 1
    }
    // 2) softmax (in-place, stable: subtract max before exp)
    let mut gmax = farr_get(gate_norm_out, 0)
    e = 1
    while e < E {
        let gv = farr_get(gate_norm_out, e)
        if gv > gmax { gmax = gv }
        e = e + 1
    }
    let mut zsum = 0.0
    e = 0
    while e < E {
        let ev = dt_exp(farr_get(gate_norm_out, e) - gmax)
        let _ = farr_set(gate_norm_out, e, ev)
        zsum = zsum + ev
        e = e + 1
    }
    e = 0
    while e < E {
        let _ = farr_set(gate_norm_out, e, farr_get(gate_norm_out, e) / zsum)
        e = e + 1
    }
    // 3) argmax → top
    let mut top = 0
    let mut topv = farr_get(gate_norm_out, 0)
    e = 1
    while e < E {
        let gv = farr_get(gate_norm_out, e)
        if gv > topv { topv = gv; top = e }
        e = e + 1
    }
    // 4) logits = gate[top] · expert_top(zT) — top-1 only emits
    let g_top = farr_get(gate_norm_out, top)
    let exp_base = experts_off + top * V * d
    let mut k = 0
    while k < V {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(M, exp_base + k * d + j) * farr_get(zT, j)
            j = j + 1
        }
        let _ = farr_set(logits_g_out, k, g_top * acc)
        k = k + 1
    }
    return top
}

// ─── MoE backward (top-1 hard routing — closed analytic vjp, packed-M) ──
// Mirrors moe_route_top1_bwd: only winner expert + gate[top] receive gradient.
//
// logits_g[k] = g_top · Σ_j W[k,j] · zT[j]    where W = experts[top]
//   d_W[k,j]  += d_logits[k] · g_top · zT[j]
//   d_zT[j]   += Σ_k d_logits[k] · g_top · W[k,j]
//   d_g_top    = Σ_k d_logits[k] · Σ_j W[k,j] · zT[j]   (sum over k of dl_k · logits/g_top)
//
// softmax bwd on top-only (d_gate has nonzero only at top_idx = d_g_top):
//   d_gate_raw[e] = gate[e] · (d_gate[e] - Σ d_gate · gate)
//                 = gate[e] · d_g_top · ([e==top] - gate[top])
//
// Inputs:
//   zT [d] · M [packed model] · router_off · experts_off
//   gate_norm [E]  (from fwd, post-softmax)
//   top_idx        (from fwd)
//   d_logits [V]   upstream grad on logits_g
// Outputs (ACCUMULATED):
//   dMg [packed]                   model grad buffer (router + experts slots)
//   d_zT_out [d]                   grad w.r.t. zT
pub fn v3_moe_bwd(zT: int, M: int, router_off: int, experts_off: int,
                  gate_norm: int, top_idx: int, d_logits: int,
                  dMg: int, d_zT_out: int, V: int, d: int, E: int) {
    let g_top = farr_get(gate_norm, top_idx)
    let exp_base = experts_off + top_idx * V * d
    // 1) expert_top grad (outer product) + d_zT contribution + d_g_top accumulator
    let mut d_g_top = 0.0
    let mut k = 0
    while k < V {
        let dl_k = farr_get(d_logits, k)
        let mut acc_g = 0.0   // for d_g_top: Σ_j W[k,j]·zT[j] (per-k)
        let mut j = 0
        while j < d {
            let w = farr_get(M, exp_base + k * d + j)
            let z = farr_get(zT, j)
            // d_expert[k,j] += d_logits[k] · g_top · z[j]
            let dwprev = farr_get(dMg, exp_base + k * d + j)
            let _ = farr_set(dMg, exp_base + k * d + j, dwprev + dl_k * g_top * z)
            // d_zT[j] += d_logits[k] · g_top · w
            let dzprev = farr_get(d_zT_out, j)
            let _ = farr_set(d_zT_out, j, dzprev + dl_k * g_top * w)
            acc_g = acc_g + w * z
            j = j + 1
        }
        d_g_top = d_g_top + dl_k * acc_g
        k = k + 1
    }
    // 2) softmax backward on top-only
    //    d_gate_raw[e] = gate[e] · d_g_top · ([e==top] - gate[top])
    let mut e = 0
    while e < E {
        let ge = farr_get(gate_norm, e)
        let mut d_raw = 0.0 - ge * g_top * d_g_top
        if e == top_idx { d_raw = d_raw + ge * d_g_top }
        // router_grad[e,j] += d_raw · zT[j]
        let mut j = 0
        while j < d {
            let zj = farr_get(zT, j)
            let drprev = farr_get(dMg, router_off + e * d + j)
            let _ = farr_set(dMg, router_off + e * d + j, drprev + d_raw * zj)
            // d_zT[j] += d_raw · router[e,j]
            let rj = farr_get(M, router_off + e * d + j)
            let dzprev = farr_get(d_zT_out, j)
            let _ = farr_set(d_zT_out, j, dzprev + d_raw * rj)
            j = j + 1
        }
        e = e + 1
    }
}

// ─── Helper: MoE slot sizes (caller layout decision) ───────────────────
// Layout 의도: caller (train driver) 가 packed M 안에 MoE 영역을 어디 둘지
// 결정. 이 헬퍼는 단순 slot size 계산만 제공.
pub fn v3_moe_router_size(d: int, E: int) -> int {
    return E * d
}
pub fn v3_moe_experts_size(V: int, d: int, E: int) -> int {
    return E * V * d
}
pub fn v3_moe_total_size(V: int, d: int, E: int) -> int {
    return E * d + E * V * d
}
