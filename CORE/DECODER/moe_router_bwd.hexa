// moe_router_bwd.hexa — DECODER M4b: backward (vjp) for the MoE router forward
// Reverse of moe_route_fwd (moe_router.hexa). Closed analytic gradients.
//
// Forward recap:
//   gate_raw[e] = Σ_j router[e·d+j]·zT[j]
//   gate        = softmax(gate_raw)
//   logits[k]   = Σ_e gate[e]·expert_e(zT)[k]   where expert_e(zT)[k]=Σ_j W_e[k·d+j]·zT[j]
//
// Given d_logits[V] (upstream), accumulate into:
//   dM (packed grad buffer): d_router[e·d+j] + d_experts[(e·V+k)·d+j]
//   d_zT_out[d] (ACCUMULATED): grad w.r.t. the last-token state
//
// Gradients (chain rule):
//   d_W_e[k·d+j] += gate[e]·d_logits[k]·zT[j]                      (expert outer-prod)
//   d_gate[e]     = Σ_k d_logits[k]·expert_e(zT)[k]                (gate from combine)
//   d_zT[j]      += Σ_e gate[e]·Σ_k W_e[k·d+j]·d_logits[k]          (expert → zT)
//   d_gate_raw[e] = gate[e]·(d_gate[e] − Σ_e' d_gate[e']·gate[e'])  (softmax jacobian)
//   d_router[e·d+j] += d_gate_raw[e]·zT[j]                          (router outer-prod)
//   d_zT[j]      += Σ_e router[e·d+j]·d_gate_raw[e]                 (router → zT)

// ---------------------------------------------------------------
// 1. moe_combine_bwd — vjp of moe_combine_soft
//   accumulates d_experts into dM, d_zT_out; writes d_gate_out[E]
// ---------------------------------------------------------------
pub fn moe_combine_bwd(zT: int, M: int, experts_off: int, gate: int,
                       n_experts: int, V: int, d: int, d_logits: int,
                       dM: int, d_gate_out: int, d_zT_out: int) {
    let mut e = 0
    while e < n_experts {
        let ge = farr_get(gate, e)
        let base = experts_off + e * V * d
        let mut dg = 0.0
        let mut k = 0
        while k < V {
            let dlk = farr_get(d_logits, k)
            let mut elk = 0.0
            let mut j = 0
            while j < d {
                let w = farr_get(M, base + k * d + j)
                let zj = farr_get(zT, j)
                elk = elk + w * zj
                // d_W_e[k·d+j] += gate[e]·d_logits[k]·zT[j]
                let cur = farr_get(dM, base + k * d + j)
                let _ = farr_set(dM, base + k * d + j, cur + ge * dlk * zj)
                // d_zT[j] += gate[e]·W_e[k·d+j]·d_logits[k]
                let dz = farr_get(d_zT_out, j)
                let _ = farr_set(d_zT_out, j, dz + ge * w * dlk)
                j = j + 1
            }
            dg = dg + dlk * elk
            k = k + 1
        }
        let _ = farr_set(d_gate_out, e, dg)
        e = e + 1
    }
}

// ---------------------------------------------------------------
// 2. moe_softmax_bwd — softmax jacobian vjp
//   d_gate_raw[e] = gate[e]·(d_gate[e] − Σ_e' d_gate[e']·gate[e'])
// ---------------------------------------------------------------
pub fn moe_softmax_bwd(gate: int, d_gate: int, n: int, d_gate_raw_out: int) {
    let mut dot = 0.0
    let mut e = 0
    while e < n {
        dot = dot + farr_get(d_gate, e) * farr_get(gate, e)
        e = e + 1
    }
    let mut e2 = 0
    while e2 < n {
        let g = farr_get(gate, e2)
        let _ = farr_set(d_gate_raw_out, e2, g * (farr_get(d_gate, e2) - dot))
        e2 = e2 + 1
    }
}

// ---------------------------------------------------------------
// 3. moe_gate_bwd — vjp of moe_gate_fwd (router linear)
//   d_router[e·d+j] += d_gate_raw[e]·zT[j]
//   d_zT[j]         += Σ_e router[e·d+j]·d_gate_raw[e]
// ---------------------------------------------------------------
pub fn moe_gate_bwd(zT: int, M: int, router_off: int, n_experts: int,
                    d: int, d_gate_raw: int, dM: int, d_zT_out: int) {
    let mut e = 0
    while e < n_experts {
        let dgr = farr_get(d_gate_raw, e)
        let mut j = 0
        while j < d {
            let cur = farr_get(dM, router_off + e * d + j)
            let _ = farr_set(dM, router_off + e * d + j, cur + dgr * farr_get(zT, j))
            let dz = farr_get(d_zT_out, j)
            let _ = farr_set(d_zT_out, j, dz + farr_get(M, router_off + e * d + j) * dgr)
            j = j + 1
        }
        e = e + 1
    }
}

// ---------------------------------------------------------------
// 4. moe_route_bwd — full backward chain (d_logits → dM + d_zT)
//   gate MUST be the post-softmax gate (forward saved it).
//   dM (router+experts grad) and d_zT_out are ACCUMULATED.
// ---------------------------------------------------------------
pub fn moe_route_bwd(zT: int, M: int, router_off: int, experts_off: int,
                     gate: int, n_experts: int, V: int, d: int,
                     d_logits: int, dM: int, d_zT_out: int) {
    let d_gate = farr_zeros(n_experts)
    moe_combine_bwd(zT, M, experts_off, gate, n_experts, V, d, d_logits, dM, d_gate, d_zT_out)
    let d_gate_raw = farr_zeros(n_experts)
    moe_softmax_bwd(gate, d_gate, n_experts, d_gate_raw)
    moe_gate_bwd(zT, M, router_off, n_experts, d, d_gate_raw, dM, d_zT_out)
    let _ = farr_free(d_gate)
    let _ = farr_free(d_gate_raw)
}
