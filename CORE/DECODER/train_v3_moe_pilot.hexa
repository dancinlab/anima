// CORE/DECODER/train_v3_moe_pilot.hexa — M4b-fire-scale Phase 4a pilot skeleton
//
// Pilot-scale (d=512) driver — same logical structure as train_v3_moe.hexa
// smoke (d=4) but scaled to pilot dims. Single-layer + T=1 + V_smoke=128
// placeholder; subsequent sub-PRs extend:
//   - Phase 4b: n_layer > 1 (multi-layer block iteration)
//   - Phase 4c: T > 1 + self-attention proper (Q/K/V/Wo + causal mask)
//   - Phase 4d: V = 151643 + real BPE corpus IDs feed
//   - Phase 4e: dispatch script (Vast.ai vastai launch)
//   - Phase 4-fire: actual fire (autonomous per a_fire_autonomous)
//
// This PR validates that the smoke-scale logic survives 100×+ dim scale-up:
// m_size alloc, init loops, multi-step training, AdamW with proper t bias
// correction all work at pilot scale on Mac (CPU FP64 ~20MB).
//
// Pilot dims here (P21H_PILOT_* env protocol target):
//   d=512   V=128 (placeholder)   E=2   T=1 (single-token)   n_layer=1
//   h=2048 (4·d standard FFN)     n_steps=3 (smoke n=5→3, alloc dominant)
//
// Layout: M = [tok_emb(V·d) | attn_Wo(d·d) | mlp_Wup(h·d) | mlp_Wdown(d·h)
//              | ln_f_gamma(d) | router(E·d) | experts(E·V·d)]
//
// m_size ≈ 2.56M params (FP64 ~20MB) — well under H100 80GB.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_arch"

fn main() {
    println("=== train_v3_moe_pilot (M4b Phase 4a pilot skeleton · d=512 V=128) ===")

    let d = 512
    let V = 128       // placeholder (Phase 4d: 151643 from Qwen BPE)
    let E = 2
    let h = 2048      // 4·d standard FFN
    let n_steps = 3   // small (alloc dominant at pilot scale)
    // layout offsets (same as smoke; only dims scaled)
    let tok_emb_off = 0
    let attn_wo_off = V * d
    let mlp_wup_off = V * d + d * d
    let mlp_wdown_off = V * d + d * d + h * d
    let ln_f_off = V * d + d * d + 2 * h * d
    let router_off = V * d + d * d + 2 * h * d + d
    let experts_off = V * d + d * d + 2 * h * d + d + E * d
    let m_size = V * d + d * d + 2 * h * d + d + v3_moe_total_size(V, d, E)
    print("  config: d="); print(d); print(" V="); print(V); print(" E="); print(E)
    print(" h="); print(h); print(" n_steps="); println(n_steps)
    print("  m_size="); print(m_size); println(" params (FP64 8B · ~20MB)")

    // packed buffers + scratch
    let M = t_zeros(m_size)
    let dMg = t_zeros(m_size)
    let m_buf = t_zeros(m_size)
    let v_buf = t_zeros(m_size)
    let zT = t_zeros(d)
    let zT_scratch = t_zeros(d)
    let mlp_hact = t_zeros(h)
    let mlp_out = t_zeros(d)
    let logits_g = t_zeros(V)
    let gate_norm = t_zeros(E)
    let d_zT = t_zeros(d)
    let d_logits = t_zeros(V)
    println("  alloc OK")

    // ── weight init (deterministic, small) ──
    // tok_emb[k, j] = 0.001·k + 0.0001·j  (scaled down vs smoke for pilot V·d)
    let mut kk0 = 0
    while kk0 < V {
        let mut jj0 = 0
        while jj0 < d {
            let v = 0.001 * to_float(kk0 + 1) + 0.0001 * to_float(jj0 + 1)
            let _ = farr_set(M, tok_emb_off + kk0 * d + jj0, v)
            jj0 = jj0 + 1
        }
        kk0 = kk0 + 1
    }
    // attn_Wo: identity (no perturbation at pilot — keeps zT magnitude sane)
    let mut wi = 0
    while wi < d {
        let _ = farr_set(M, attn_wo_off + wi * d + wi, 1.0)
        wi = wi + 1
    }
    // mlp_Wup[k, j] = 0.001·sin(k+j) approximation via small magnitude (no trig in
    // smoke path); use 0.0005·((k+j+1) % 7 - 3) for sign variety
    let mut ui = 0
    while ui < h {
        let mut uj = 0
        while uj < d {
            let phase = (ui + uj + 1) % 7
            let val = 0.0005 * to_float(phase - 3)
            let _ = farr_set(M, mlp_wup_off + ui * d + uj, val)
            uj = uj + 1
        }
        ui = ui + 1
    }
    // mlp_Wdown identity-ish (rows 0..d match dk%d == i pattern, scaled down)
    let mut di = 0
    while di < d {
        let mut dk = 0
        while dk < h {
            let mut val = 0.0
            if dk % d == di { val = 0.001 * to_float((dk / d) + 1) }
            let _ = farr_set(M, mlp_wdown_off + di * h + dk, val)
            dk = dk + 1
        }
        di = di + 1
    }
    // ln_f gamma = 1.0
    let mut gi = 0
    while gi < d {
        let _ = farr_set(M, ln_f_off + gi, 1.0)
        gi = gi + 1
    }
    // router: gate experts differ
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.001 * to_float((j + 1) % 17))
        let _ = farr_set(M, router_off + 1 * d + j, 0.001 * to_float((17 - j) % 17))
        j = j + 1
    }
    // experts[e, k, j] small unique
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let v = 0.0001 * to_float(e + 1) * to_float(k + 1) + 0.00001 * to_float(jj + 1)
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj, v)
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    println("  init OK")

    // ── training loop ──
    let beta1 = 0.9
    let beta2 = 0.95
    let lr = 1.0e-3
    let wd = 0.1
    let adam_eps = 1.0e-8
    let rmsnorm_eps = 1.0e-6
    let ids_arr = [13, 47, 100, 5, 89]
    let m_baseline_wo_00 = farr_get(M, attn_wo_off + 0 * d + 0)
    let mut final_top_idx = -1
    let mut final_gate_sum = 0.0
    let mut final_zT0 = 0.0
    let mut final_dw_top_00 = 0.0

    println("  ── pilot multi-step loop start ──")
    let mut step = 1
    while step <= n_steps {
        // zero grad buffers
        let mut zi = 0
        while zi < V { let _ = farr_set(d_logits, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < m_size { let _ = farr_set(dMg, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < d { let _ = farr_set(d_zT, zi, 0.0) ; zi = zi + 1 }

        let token_id = ids_arr[(step - 1) % 5]
        // tok_emb lookup
        let mut j2 = 0
        while j2 < d {
            let _ = farr_set(zT, j2, farr_get(M, tok_emb_off + token_id * d + j2))
            j2 = j2 + 1
        }
        // attn(Wo) (identity at init)
        let mut ai = 0
        while ai < d {
            let mut acc = 0.0
            let mut aj = 0
            while aj < d {
                acc = acc + farr_get(M, attn_wo_off + ai * d + aj) * farr_get(zT, aj)
                aj = aj + 1
            }
            let _ = farr_set(zT_scratch, ai, acc)
            ai = ai + 1
        }
        ai = 0
        while ai < d { let _ = farr_set(zT, ai, farr_get(zT_scratch, ai)) ; ai = ai + 1 }
        // MLP
        let mut hk = 0
        while hk < h {
            let mut acc = 0.0
            let mut hj = 0
            while hj < d {
                acc = acc + farr_get(M, mlp_wup_off + hk * d + hj) * farr_get(zT, hj)
                hj = hj + 1
            }
            if acc < 0.0 { acc = 0.0 }
            let _ = farr_set(mlp_hact, hk, acc)
            hk = hk + 1
        }
        let mut mi = 0
        while mi < d {
            let mut acc = 0.0
            let mut mk = 0
            while mk < h {
                acc = acc + farr_get(M, mlp_wdown_off + mi * h + mk) * farr_get(mlp_hact, mk)
                mk = mk + 1
            }
            let _ = farr_set(mlp_out, mi, acc)
            mi = mi + 1
        }
        mi = 0
        while mi < d { let _ = farr_set(zT, mi, farr_get(mlp_out, mi)) ; mi = mi + 1 }
        // ln_f (RMSNorm)
        let mut ms = 0.0
        let mut mi2 = 0
        while mi2 < d {
            let xv = farr_get(zT, mi2) ; ms = ms + xv * xv ; mi2 = mi2 + 1
        }
        ms = ms / to_float(d)
        let rms_inv = 1.0 / sqrt(ms + rmsnorm_eps)
        let mut ni = 0
        while ni < d {
            let xv = farr_get(zT, ni)
            let gv = farr_get(M, ln_f_off + ni)
            let _ = farr_set(zT, ni, xv * rms_inv * gv)
            ni = ni + 1
        }
        // MoE
        let top_idx = v3_moe_fwd(zT, M, router_off, experts_off,
                                  logits_g, gate_norm, V, d, E)
        let target = ids_arr[step % 5]
        let _ = farr_set(d_logits, target, 1.0)
        v3_moe_bwd(zT, M, router_off, experts_off, gate_norm, top_idx, d_logits,
                   dMg, d_zT, V, d, E)
        // AdamW
        let bc1 = 1.0 - pow(beta1, to_float(step))
        let bc2 = 1.0 - pow(beta2, to_float(step))
        let mut pi = 0
        while pi < m_size {
            let g = farr_get(dMg, pi)
            let m_prev = farr_get(m_buf, pi)
            let v_prev = farr_get(v_buf, pi)
            let m_new = beta1 * m_prev + (1.0 - beta1) * g
            let v_new = beta2 * v_prev + (1.0 - beta2) * g * g
            let _ = farr_set(m_buf, pi, m_new)
            let _ = farr_set(v_buf, pi, v_new)
            let m_hat = m_new / bc1
            let v_hat = v_new / bc2
            let theta = farr_get(M, pi)
            let upd = lr * (m_hat / (sqrt(v_hat) + adam_eps) + wd * theta)
            let _ = farr_set(M, pi, theta - upd)
            pi = pi + 1
        }
        print("  step="); print(step)
        print(" tok="); print(token_id)
        print(" tgt="); print(target)
        print(" top="); print(top_idx)
        print(" logit[tgt]="); print(farr_get(logits_g, target))
        print(" Wo[0,0]="); println(farr_get(M, attn_wo_off + 0 * d + 0))
        if step == n_steps {
            final_top_idx = top_idx
            final_gate_sum = farr_get(gate_norm, 0) + farr_get(gate_norm, 1)
            final_zT0 = farr_get(zT, 0)
            final_dw_top_00 = farr_get(dMg, experts_off + top_idx * V * d + 0 * d + 0)
        }
        step = step + 1
    }
    println("  ── pilot multi-step loop end ──")
    let m_final_wo_00 = farr_get(M, attn_wo_off + 0 * d + 0)
    let mut wo_delta = m_final_wo_00 - m_baseline_wo_00
    if wo_delta < 0.0 { wo_delta = 0.0 - wo_delta }
    print("  Wo[0,0] baseline="); print(m_baseline_wo_00)
    print(" final="); print(m_final_wo_00)
    print(" |Δ|="); println(wo_delta)

    // ── verdict ──
    let ln_f_g0 = farr_get(M, ln_f_off + 0)
    let mut pass = 1
    if final_gate_sum < 0.999 || final_gate_sum > 1.001 { pass = 0 }
    if final_top_idx < 0 || final_top_idx >= E { pass = 0 }
    if final_dw_top_00 == 0.0 { pass = 0 }
    if final_zT0 == 0.0 { pass = 0 }
    if ln_f_g0 == 0.0 { pass = 0 }
    if wo_delta < 1.0e-9 { pass = 0 }
    if pass == 1 {
        println("TRAIN_V3_MOE_PILOT SKELETON: PASS (d=512 V=128 E=2 n_layer=1 T=1 n_steps=3 · same logic as smoke, scaled)")
    } else {
        println("TRAIN_V3_MOE_PILOT SKELETON: FAIL")
    }
}
