// CORE/DECODER/train_v3_moe_pilot.hexa — M4b-fire-scale Phase 4c self-attention
//
// Pilot driver — Phase 4c adds proper self-attention (T > 1, causal mask,
// Q/K/V/Wo projections, scaled dot-product softmax). Per-layer block becomes:
//   [attn_Wq(d·d) | attn_Wk(d·d) | attn_Wv(d·d) | attn_Wo(d·d)
//    | mlp_Wup(h·d) | mlp_Wdown(d·h)]
//
// Pilot dims here (alloc-tuned · CPU smoke):
//   d=128   V=128 (placeholder)   E=2   h=512 (4·d FFN)
//   n_layer=2   T=16 (seq length)   n_steps=2
//
// Forward per step:
//   zT_seq[T·d] = tok_emb[ids[0..T]]
//   for layer in 0..n_layer:
//     residual = zT_seq
//     Q = zT_seq · Wq                          (T×d)
//     K = zT_seq · Wk                          (T×d)
//     V = zT_seq · Wv                          (T×d)
//     scores[t1, t2] = Σ_j Q[t1, j] · K[t2, j] / sqrt(d)
//     causal mask: scores[t1, t2] = -1e9 if t2 > t1
//     probs[t1, :] = softmax(scores[t1, :])
//     attn_out[t1, j] = Σ_t2 probs[t1, t2] · V[t2, j]
//     zT_seq = attn_out · Wo + residual
//     residual = zT_seq
//     for t in 0..T:                            (per-token MLP)
//       h_act = ReLU(Wup · zT_seq[t])
//       zT_seq[t] = Wdown · h_act
//     zT_seq = zT_seq + residual
//   final ln_f on zT_seq[T-1] (last-token routing)
//   top_idx = v3_moe_fwd(zT_seq[T-1], ...)
//
// Next sub-PRs: 4d real BPE corpus (V=151643) · 4e dispatch · 4-fire.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "stdlib/flame/flame_bpe_corpus_lib"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_arch"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_bwd_lib"
use "/Users/ghost/core/anima/CORE/DECODER/flame_mm"

fn main() {
    println("=== train_v3_moe_pilot (M4b Phase 4d real-BPE-IDS · d=64 V=151643 n_layer=1 T=4) ===")

    // ── Phase 4d: real BPE corpus IDS feed ──
    // Load Qwen tokenizer + corpus once. ids array used as the input token sequence.
    // V = 151643 (real Qwen vocab). Pilot dims scaled DOWN (d=64, n_layer=1, T=4)
    // because tok_emb(V·d) + experts(E·V·d) dominate alloc at V=151643:
    //   tok_emb: 151643·64 = 9.7M  experts: 2·151643·64 = 19.4M  ≈ 233MB FP64 total
    let merges_path = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/merges.txt"
    let vocab_path  = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/vocab.json"
    let corpus_path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
    let bpe = flame_bpe_corpus_load(merges_path, vocab_path, corpus_path)
    let V_bpe = bpe["vocab_size"]
    let n_corpus_toks = bpe["n_toks"]
    let corpus_ids = bpe["ids"]
    print("  bpe: V="); print(V_bpe); print(" n_toks="); println(n_corpus_toks)
    let ok_in_vocab = flame_bpe_ids_in_vocab(corpus_ids, V_bpe)
    print("  bpe: all ids in [0,V) = "); println(ok_in_vocab)

    let d = 64
    let V = V_bpe   // real Qwen vocab (151643)
    let E = 2
    let h = 256     // 4·d FFN
    let n_layer = 1
    let T = 4
    // Phase 5b: multi-step training. n_steps capped at min(20, n_corpus_toks/T - 1)
    //   to avoid corpus exhaustion (we read step_off=(step-1)·T tokens + 1 target).
    let mut n_steps = 20
    let max_steps = (n_corpus_toks / T) - 1
    if max_steps < n_steps { n_steps = max_steps }
    if n_steps < 1 { n_steps = 1 }
    let block_size = 4 * d * d + 2 * h * d
    let tok_emb_off = 0
    let blocks_off = V * d
    let ln_f_off = V * d + n_layer * block_size
    let router_off = ln_f_off + d
    let experts_off = router_off + E * d
    let m_size = experts_off + E * V * d
    let attn_scale = 1.0 / sqrt(to_float(d))
    print("  config: d="); print(d); print(" V="); print(V); print(" E="); print(E)
    print(" h="); print(h); print(" n_layer="); print(n_layer); print(" T="); print(T); print(" n_steps="); println(n_steps)
    print("  block_size="); print(block_size); print(" m_size="); print(m_size)
    print(" params (FP64 8B · "); print(m_size * 8 / 1024 / 1024); println(" MB)")
    print("  attn_scale = 1/sqrt(d) = "); println(attn_scale)

    // packed param buffer + optimizer state
    let M = t_zeros(m_size)
    let dMg = t_zeros(m_size)
    let m_buf = t_zeros(m_size)
    let v_buf = t_zeros(m_size)
    // activation buffers (seq-shaped now)
    let zT_seq = t_zeros(T * d)
    let zT_residual = t_zeros(T * d)
    let Q_buf = t_zeros(T * d)
    let K_buf = t_zeros(T * d)
    let V_buf = t_zeros(T * d)
    let scores = t_zeros(T * T)
    let probs = t_zeros(T * T)
    let attn_out = t_zeros(T * d)
    let mlp_hact = t_zeros(h)
    let mlp_out = t_zeros(d)
    // MoE buffers (last-token only)
    let zT_last = t_zeros(d)
    let logits_g = t_zeros(V)
    let gate_norm = t_zeros(E)
    let d_zT_last = t_zeros(d)
    let d_logits = t_zeros(V)
    // ── Phase 4-bwd-6: per-layer forward caches (layer-indexed flat) for backward ──
    let Q_all = t_zeros(n_layer * T * d)
    let K_all = t_zeros(n_layer * T * d)
    let V_all = t_zeros(n_layer * T * d)
    let attn_out_all = t_zeros(n_layer * T * d)
    let probs_all = t_zeros(n_layer * T * T)
    let h_act_all = t_zeros(n_layer * T * h)
    let zT_in_all = t_zeros(n_layer * T * d)
    let zT_mid_all = t_zeros(n_layer * T * d)
    let zT_last_pre_ln = t_zeros(d)
    let d_zT_seq = t_zeros(T * d)
    let d_zT_layer = t_zeros(T * d)
    println("  alloc OK")

    // ── weight init ──
    let mut kk0 = 0
    while kk0 < V {
        let mut jj0 = 0
        while jj0 < d {
            let _ = farr_set(M, tok_emb_off + kk0 * d + jj0,
                              0.001 * to_float(kk0 + 1) + 0.0001 * to_float(jj0 + 1))
            jj0 = jj0 + 1
        }
        kk0 = kk0 + 1
    }
    let mut l = 0
    while l < n_layer {
        let block_off = blocks_off + l * block_size
        let wq_l = block_off
        let wk_l = block_off + d * d
        let wv_l = block_off + 2 * d * d
        let wo_l = block_off + 3 * d * d
        let wup_l = block_off + 4 * d * d
        let wdown_l = block_off + 4 * d * d + h * d
        // Wq, Wk, Wv: small random-ish (deterministic) — distinct so attention non-trivial
        let mut wi = 0
        while wi < d {
            let mut wj = 0
            while wj < d {
                let phase_q = (wi * 7 + wj + l * 3 + 1) % 11
                let phase_k = (wi + wj * 5 + l * 3 + 2) % 11
                let phase_v = (wi * 3 + wj * 7 + l + 3) % 11
                let _ = farr_set(M, wq_l + wi * d + wj, 0.01 * to_float(phase_q - 5))
                let _ = farr_set(M, wk_l + wi * d + wj, 0.01 * to_float(phase_k - 5))
                let _ = farr_set(M, wv_l + wi * d + wj, 0.01 * to_float(phase_v - 5))
                wj = wj + 1
            }
            wi = wi + 1
        }
        // Wo: identity (output projection)
        let mut oi = 0
        while oi < d {
            let _ = farr_set(M, wo_l + oi * d + oi, 1.0)
            oi = oi + 1
        }
        // mlp_Wup: small layer-distinct phase
        let mut ui = 0
        while ui < h {
            let mut uj = 0
            while uj < d {
                let phase = (ui + uj + l + 1) % 7
                let _ = farr_set(M, wup_l + ui * d + uj, 0.005 * to_float(phase - 3))
                uj = uj + 1
            }
            ui = ui + 1
        }
        // mlp_Wdown: identity-band
        let mut di = 0
        while di < d {
            let mut dk = 0
            while dk < h {
                let mut val = 0.0
                if dk % d == di {
                    val = 0.01 * to_float((dk / d) + 1) * (1.0 + 0.01 * to_float(l))
                }
                let _ = farr_set(M, wdown_l + di * h + dk, val)
                dk = dk + 1
            }
            di = di + 1
        }
        l = l + 1
    }
    // ln_f gamma + router + experts
    let mut gi = 0
    while gi < d { let _ = farr_set(M, ln_f_off + gi, 1.0) ; gi = gi + 1 }
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.001 * to_float((j + 1) % 17))
        let _ = farr_set(M, router_off + 1 * d + j, 0.001 * to_float((17 - j) % 17))
        j = j + 1
    }
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj,
                                  0.0001 * to_float(e + 1) * to_float(k + 1) + 0.00001 * to_float(jj + 1))
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    println("  init OK (Q/K/V/Wo · MLP · per-layer distinct)")

    // ── training loop ──
    let beta1 = 0.9
    let beta2 = 0.95
    let lr = 1.0e-3
    let wd = 0.1
    let adam_eps = 1.0e-8
    let rmsnorm_eps = 1.0e-6
    let neg_inf = 0.0 - 1.0e9
    // Phase 4d: ids feed from real BPE corpus (no synthetic round-robin).
    // n_corpus_toks ≥ T + n_steps assumed (sanity-checked below).
    if n_corpus_toks < T + n_steps {
        println("CORPUS too short for T + n_steps — Phase 4d FAIL")
        return
    }
    let m_baseline_wq_l0_00 = farr_get(M, blocks_off + 0 * d + 0)
    let m_baseline_wo_lN_00 = farr_get(M, blocks_off + (n_layer - 1) * block_size + 3 * d * d + 0 * d + 0)
    let mut final_top_idx = -1
    let mut final_gate_sum = 0.0
    let mut final_zT0 = 0.0

    println("  ── pilot multi-step + multi-layer + self-attn loop start ──")
    let mut step = 1
    while step <= n_steps {
        // zero grad buffers
        let mut zi = 0
        while zi < V { let _ = farr_set(d_logits, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < m_size { let _ = farr_set(dMg, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < d { let _ = farr_set(d_zT_last, zi, 0.0) ; zi = zi + 1 }

        // tok_emb lookup: zT_seq[t, j] = M[tok_emb_off + corpus_ids[step_off + t]·d + j]
        // Phase 4d: sliding window over real BPE corpus (no synthetic round-robin).
        let step_off = (step - 1) * T
        let mut t_idx = 0
        while t_idx < T {
            let token_id = corpus_ids[step_off + t_idx]
            let mut j2 = 0
            while j2 < d {
                let _ = farr_set(zT_seq, t_idx * d + j2,
                                  farr_get(M, tok_emb_off + token_id * d + j2))
                j2 = j2 + 1
            }
            t_idx = t_idx + 1
        }

        // ── per-layer ──
        let mut layer = 0
        while layer < n_layer {
            let block_off = blocks_off + layer * block_size
            let wq_l = block_off
            let wk_l = block_off + d * d
            let wv_l = block_off + 2 * d * d
            let wo_l = block_off + 3 * d * d
            let wup_l = block_off + 4 * d * d
            let wdown_l = block_off + 4 * d * d + h * d
            // save residual: zT_residual = zT_seq
            let mut ri = 0
            while ri < T * d { let _ = farr_set(zT_residual, ri, farr_get(zT_seq, ri)) ; ri = ri + 1 }
            // cache zT_in for this layer's backward (4-bwd-6)
            let mut cin = 0
            while cin < T * d { let _ = farr_set(zT_in_all, layer * T * d + cin, farr_get(zT_seq, cin)) ; cin = cin + 1 }

            // Q/K/V = zT_seq @ Wq/Wk/Wv  — Phase 4-gpu-3 mm() port (cuBLAS⇄CPU).
            //   zT_seq[T×d] @ W[d×d] = [T×d] (NN). W extracted from packed M.
            //   results copied into Q_buf/K_buf/V_buf (downstream cache + bwd read these).
            let wq_mat = mm_extract(M, wq_l, d, d)
            let wk_mat = mm_extract(M, wk_l, d, d)
            let wv_mat = mm_extract(M, wv_l, d, d)
            let q_r = mm(zT_seq, T, d, wq_mat, d)
            let k_r = mm(zT_seq, T, d, wk_mat, d)
            let v_r = mm(zT_seq, T, d, wv_mat, d)
            let mut cp = 0
            while cp < T * d {
                let _ = farr_set(Q_buf, cp, farr_get(q_r, cp))
                let _ = farr_set(K_buf, cp, farr_get(k_r, cp))
                let _ = farr_set(V_buf, cp, farr_get(v_r, cp))
                cp = cp + 1
            }
            let _ = farr_free(wq_mat)
            let _ = farr_free(wk_mat)
            let _ = farr_free(wv_mat)
            let _ = farr_free(q_r)
            let _ = farr_free(k_r)
            let _ = farr_free(v_r)
            // scores = (Q @ Kᵀ) · attn_scale + causal mask — mm() for QKᵀ, elementwise mask.
            let k_t = mm_transpose(K_buf, T, d)        // [d×T]
            let sc_r = mm(Q_buf, T, d, k_t, T)         // [T×T] raw QKᵀ
            let mut t1 = 0
            while t1 < T {
                let mut t2 = 0
                while t2 < T {
                    let mut score = neg_inf
                    if t2 <= t1 { score = farr_get(sc_r, t1 * T + t2) * attn_scale }
                    let _ = farr_set(scores, t1 * T + t2, score)
                    t2 = t2 + 1
                }
                t1 = t1 + 1
            }
            let _ = farr_free(k_t)
            let _ = farr_free(sc_r)
            // softmax row-wise: probs[t1, :] = softmax(scores[t1, :])
            t1 = 0
            while t1 < T {
                // numerical-stable: subtract row max
                let mut row_max = neg_inf
                let mut t2 = 0
                while t2 < T {
                    let s = farr_get(scores, t1 * T + t2)
                    if s > row_max { row_max = s }
                    t2 = t2 + 1
                }
                let mut z_sum = 0.0
                t2 = 0
                while t2 < T {
                    let e_val = exp(farr_get(scores, t1 * T + t2) - row_max)
                    let _ = farr_set(probs, t1 * T + t2, e_val)
                    z_sum = z_sum + e_val
                    t2 = t2 + 1
                }
                t2 = 0
                while t2 < T {
                    let _ = farr_set(probs, t1 * T + t2, farr_get(probs, t1 * T + t2) / z_sum)
                    t2 = t2 + 1
                }
                t1 = t1 + 1
            }
            // attn_out = probs @ V — Phase 4-gpu-3 mm() port. probs[T×T] @ V[T×d] = [T×d].
            let ao_r = mm(probs, T, T, V_buf, d)
            let mut ac = 0
            while ac < T * d { let _ = farr_set(attn_out, ac, farr_get(ao_r, ac)) ; ac = ac + 1 }
            let _ = farr_free(ao_r)
            // zT_seq = attn_out @ Wo + residual — mm() for attn_out[T×d] @ Wo[d×d] = [T×d].
            let wo_mat = mm_extract(M, wo_l, d, d)
            let wo_r = mm(attn_out, T, d, wo_mat, d)
            let mut woi = 0
            while woi < T * d {
                let _ = farr_set(zT_seq, woi, farr_get(wo_r, woi) + farr_get(zT_residual, woi))
                woi = woi + 1
            }
            let _ = farr_free(wo_mat)
            let _ = farr_free(wo_r)
            // save residual for MLP
            ri = 0
            while ri < T * d { let _ = farr_set(zT_residual, ri, farr_get(zT_seq, ri)) ; ri = ri + 1 }
            // cache zT_mid (after attn+residual1) for this layer's backward (4-bwd-6)
            let mut cmid = 0
            while cmid < T * d { let _ = farr_set(zT_mid_all, layer * T * d + cmid, farr_get(zT_seq, cmid)) ; cmid = cmid + 1 }
            // MLP — Phase 4-gpu-3 batched mm() port:
            //   h_pre = zT_seq @ Wupᵀ : [T×d] @ [d×h] = [T×h]   (Wup stored [h×d])
            //   h_act = ReLU(h_pre)   (elementwise + cache per layer,token)
            //   mlp   = h_act @ Wdownᵀ : [T×h] @ [h×d] = [T×d]  (Wdown stored [d×h])
            //   zT_seq = mlp + residual
            let wup_mat = mm_extract(M, wup_l, h, d)     // [h×d]
            let wup_t = mm_transpose(wup_mat, h, d)      // [d×h]
            let h_pre = mm(zT_seq, T, d, wup_t, h)       // [T×h]
            let h_act = t_zeros(T * h)
            let mut hi = 0
            while hi < T * h {
                let mut v = farr_get(h_pre, hi)
                if v < 0.0 { v = 0.0 }                   // ReLU
                let _ = farr_set(h_act, hi, v)
                let _ = farr_set(h_act_all, layer * T * h + hi, v)   // cache (t·h+k order matches)
                hi = hi + 1
            }
            let wdown_mat = mm_extract(M, wdown_l, d, h)  // [d×h]
            let wdown_t = mm_transpose(wdown_mat, d, h)   // [h×d]
            let mlp_r = mm(h_act, T, h, wdown_t, d)        // [T×d]
            let mut mli = 0
            while mli < T * d {
                let _ = farr_set(zT_seq, mli, farr_get(mlp_r, mli) + farr_get(zT_residual, mli))
                mli = mli + 1
            }
            let _ = farr_free(wup_mat)
            let _ = farr_free(wup_t)
            let _ = farr_free(h_pre)
            let _ = farr_free(h_act)
            let _ = farr_free(wdown_mat)
            let _ = farr_free(wdown_t)
            let _ = farr_free(mlp_r)
            // cache attention tensors for this layer's backward (4-bwd-6)
            let mut cq = 0
            while cq < T * d {
                let _ = farr_set(Q_all, layer * T * d + cq, farr_get(Q_buf, cq))
                let _ = farr_set(K_all, layer * T * d + cq, farr_get(K_buf, cq))
                let _ = farr_set(V_all, layer * T * d + cq, farr_get(V_buf, cq))
                let _ = farr_set(attn_out_all, layer * T * d + cq, farr_get(attn_out, cq))
                cq = cq + 1
            }
            let mut cp = 0
            while cp < T * T {
                let _ = farr_set(probs_all, layer * T * T + cp, farr_get(probs, cp))
                cp = cp + 1
            }
            layer = layer + 1
        }

        // ── extract last-token: zT_last = zT_seq[T-1] ──
        let mut lj = 0
        while lj < d {
            let _ = farr_set(zT_last, lj, farr_get(zT_seq, (T - 1) * d + lj))
            lj = lj + 1
        }
        // cache pre-ln value for ln_f_bwd (4-bwd-6)
        let mut pli = 0
        while pli < d { let _ = farr_set(zT_last_pre_ln, pli, farr_get(zT_last, pli)) ; pli = pli + 1 }
        // ── final ln_f (RMSNorm) ──
        let mut ms = 0.0
        let mut mi2 = 0
        while mi2 < d {
            let xv = farr_get(zT_last, mi2) ; ms = ms + xv * xv ; mi2 = mi2 + 1
        }
        ms = ms / to_float(d)
        let rms_inv = 1.0 / sqrt(ms + rmsnorm_eps)
        let mut ni = 0
        while ni < d {
            let xv = farr_get(zT_last, ni)
            let gv = farr_get(M, ln_f_off + ni)
            let _ = farr_set(zT_last, ni, xv * rms_inv * gv)
            ni = ni + 1
        }
        // MoE
        let top_idx = v3_moe_fwd(zT_last, M, router_off, experts_off,
                                  logits_g, gate_norm, V, d, E)
        // Phase 4d: target = next real corpus token after the input window
        let target = corpus_ids[step_off + T]
        let _ = farr_set(d_logits, target, 1.0)
        v3_moe_bwd(zT_last, M, router_off, experts_off, gate_norm, top_idx, d_logits,
                   dMg, d_zT_last, V, d, E)

        // ── Phase 4-bwd-6: backward through ln_f + layer stack + tok_emb ──
        // ln_f_bwd: d_zT_last (∂L/∂ln_f-output, from MoE bwd) → ∂L/∂ln_f-input
        let d_zT_last_pre = t_zeros(d)
        ln_f_bwd(d_zT_last, zT_last_pre_ln, ln_f_off, M, d, rms_inv, dMg, d_zT_last_pre)
        // scatter last-token grad into full-sequence grad (other positions 0)
        let mut zs = 0
        while zs < T * d { let _ = farr_set(d_zT_seq, zs, 0.0) ; zs = zs + 1 }
        let mut dl = 0
        while dl < d {
            let _ = farr_set(d_zT_seq, (T - 1) * d + dl, farr_get(d_zT_last_pre, dl))
            dl = dl + 1
        }
        // reverse layer loop: layer_block_bwd chains d_zT_seq backward
        let Q_l = t_zeros(T * d)
        let K_l = t_zeros(T * d)
        let V_l = t_zeros(T * d)
        let ao_l = t_zeros(T * d)
        let pr_l = t_zeros(T * T)
        let zin_l = t_zeros(T * d)
        let zmid_l = t_zeros(T * d)
        let h_act_seq_l = t_zeros(T * h)
        let mut lb = n_layer - 1
        while lb >= 0 {
            let boff = blocks_off + lb * block_size
            // load layer lb caches into single-layer scratch
            let mut c = 0
            while c < T * d {
                let _ = farr_set(Q_l, c, farr_get(Q_all, lb * T * d + c))
                let _ = farr_set(K_l, c, farr_get(K_all, lb * T * d + c))
                let _ = farr_set(V_l, c, farr_get(V_all, lb * T * d + c))
                let _ = farr_set(ao_l, c, farr_get(attn_out_all, lb * T * d + c))
                let _ = farr_set(zin_l, c, farr_get(zT_in_all, lb * T * d + c))
                let _ = farr_set(zmid_l, c, farr_get(zT_mid_all, lb * T * d + c))
                c = c + 1
            }
            let mut cp2 = 0
            while cp2 < T * T { let _ = farr_set(pr_l, cp2, farr_get(probs_all, lb * T * T + cp2)) ; cp2 = cp2 + 1 }
            let mut ch = 0
            while ch < T * h { let _ = farr_set(h_act_seq_l, ch, farr_get(h_act_all, lb * T * h + ch)) ; ch = ch + 1 }
            // layer_block_bwd: d_zT_seq (block output grad) → d_zT_layer (block input grad)
            layer_block_bwd(d_zT_seq, zin_l, zmid_l, Q_l, K_l, V_l, ao_l, pr_l, h_act_seq_l,
                            boff, boff + d * d, boff + 2 * d * d, boff + 3 * d * d,
                            boff + 4 * d * d, boff + 4 * d * d + h * d,
                            M, T, d, h, attn_scale, dMg, d_zT_layer)
            // chain to the earlier layer: d_zT_seq = d_zT_layer
            let mut cc = 0
            while cc < T * d { let _ = farr_set(d_zT_seq, cc, farr_get(d_zT_layer, cc)) ; cc = cc + 1 }
            lb = lb - 1
        }
        // tok_emb_bwd: scatter d_zT_seq into embedding rows.
        // step_off = (step-1)·T; at step 1 step_off=0 so corpus_ids[0..T] = the input
        // window exactly. (n_steps=1 pilot; multi-step needs an offset-aware variant.)
        tok_emb_bwd(d_zT_seq, corpus_ids, tok_emb_off, T, d, dMg)

        // AdamW
        let bc1 = 1.0 - pow(beta1, to_float(step))
        let bc2 = 1.0 - pow(beta2, to_float(step))
        let mut pi = 0
        while pi < m_size {
            let g = farr_get(dMg, pi)
            let m_prev = farr_get(m_buf, pi)
            let v_prev = farr_get(v_buf, pi)
            let m_new = beta1 * m_prev + (1.0 - beta1) * g
            let v_new = beta2 * v_prev + (1.0 - beta2) * g * g
            let _ = farr_set(m_buf, pi, m_new)
            let _ = farr_set(v_buf, pi, v_new)
            let m_hat = m_new / bc1
            let v_hat = v_new / bc2
            let theta = farr_get(M, pi)
            let upd = lr * (m_hat / (sqrt(v_hat) + adam_eps) + wd * theta)
            let _ = farr_set(M, pi, theta - upd)
            pi = pi + 1
        }
        // per-step CE: L_ce = -logit[target] + log_sum_exp(logits)
        //   stable log_sum_exp = row_max + log(Σ exp(L - row_max))
        let mut row_max = farr_get(logits_g, 0)
        let mut kk = 1
        while kk < V {
            let lv = farr_get(logits_g, kk)
            if lv > row_max { row_max = lv }
            kk = kk + 1
        }
        let mut z_sum = 0.0
        kk = 0
        while kk < V {
            z_sum = z_sum + exp(farr_get(logits_g, kk) - row_max)
            kk = kk + 1
        }
        let step_ce = 0.0 - farr_get(logits_g, target) + (row_max + log(z_sum))
        // per-step probe: probs[T-1, 0] = causal attn weight onto first token
        let probs_last_0 = farr_get(probs, (T - 1) * T + 0)
        // probs[0, 0] should equal 1.0 (only one valid token in causal-row 0)
        let probs_0_0 = farr_get(probs, 0 * T + 0)
        print("  step="); print(step)
        print(" L_ce="); print(step_ce)
        print(" tgt="); print(target)
        print(" top="); print(top_idx)
        print(" logit[tgt]="); print(farr_get(logits_g, target))
        print(" probs[0,0]="); print(probs_0_0)
        print(" probs[T-1,0]="); println(probs_last_0)
        if step == n_steps {
            final_top_idx = top_idx
            final_gate_sum = farr_get(gate_norm, 0) + farr_get(gate_norm, 1)
            final_zT0 = farr_get(zT_last, 0)
        }
        step = step + 1
    }
    println("  ── pilot self-attn loop end ──")

    // ── Phase 5b ckpt save (text format: one double per line · /root/ckpt.txt) ──
    //   sampler reads back into M via farr_set(M, i, parse_float(line_i)).
    //   text format = portable across endianness · easy to validate (`wc -l` = m_size).
    let ckpt_path = "/root/ckpt.txt"
    let meta_path = "/root/ckpt_meta.txt"
    println("  ── ckpt save start ──")
    // chunked append: 100k doubles per chunk to avoid O(n²) string concat.
    let _ = write_file(ckpt_path, "")
    let chunk = 100000
    let mut ki = 0
    while ki < m_size {
        let mut chunk_body = ""
        let mut cnt = 0
        while cnt < chunk && ki < m_size {
            chunk_body = chunk_body + to_string(farr_get(M, ki)) + "\n"
            ki = ki + 1
            cnt = cnt + 1
        }
        let _ = append_file(ckpt_path, chunk_body)
        if ki % 1000000 == 0 { print("    ckpt dump progress "); print(ki); print("/"); println(m_size) }
    }
    let meta_body = "V " + to_string(V) + "\nd " + to_string(d) + "\nE " + to_string(E) + "\nh " + to_string(h) + "\nn_layer " + to_string(n_layer) + "\nT " + to_string(T) + "\nn_corpus_toks " + to_string(n_corpus_toks) + "\nm_size " + to_string(m_size) + "\n"
    let _ = write_file(meta_path, meta_body)
    print("  ── ckpt save end · "); print(m_size); print(" doubles → "); println(ckpt_path)

    let m_final_wq_l0_00 = farr_get(M, blocks_off + 0 * d + 0)
    let m_final_wo_lN_00 = farr_get(M, blocks_off + (n_layer - 1) * block_size + 3 * d * d + 0 * d + 0)
    let mut wq_l0_delta = m_final_wq_l0_00 - m_baseline_wq_l0_00
    if wq_l0_delta < 0.0 { wq_l0_delta = 0.0 - wq_l0_delta }
    let mut wo_lN_delta = m_final_wo_lN_00 - m_baseline_wo_lN_00
    if wo_lN_delta < 0.0 { wo_lN_delta = 0.0 - wo_lN_delta }
    print("  Wq[L0,0,0]   baseline="); print(m_baseline_wq_l0_00)
    print(" final="); print(m_final_wq_l0_00)
    print(" |Δ|="); println(wq_l0_delta)
    print("  Wo[LN-1,0,0] baseline="); print(m_baseline_wo_lN_00)
    print(" final="); print(m_final_wo_lN_00)
    print(" |Δ|="); println(wo_lN_delta)

    // ── verdict ──
    let ln_f_g0 = farr_get(M, ln_f_off + 0)
    let mut pass = 1
    if final_gate_sum < 0.999 || final_gate_sum > 1.001 { pass = 0 }
    if final_top_idx < 0 || final_top_idx >= E { pass = 0 }
    if final_zT0 == 0.0 { pass = 0 }
    if ln_f_g0 == 0.0 { pass = 0 }
    // self-attn check: probs[0, 0] = 1.0 (causal row 0 has only one valid token)
    // Note: probs is the LAST layer's probs (latest write); should still be 1.0
    let final_probs_0_0 = farr_get(probs, 0 * T + 0)
    if final_probs_0_0 < 0.99 || final_probs_0_0 > 1.01 { pass = 0 }
    // last-layer Wo moved through MoE backward
    if wo_lN_delta < 1.0e-9 { pass = 0 }
    // Phase 4-bwd-6: layer 0 Wq moved → end-to-end gradient reached the FIRST layer
    // (the honest gap from Phase 4c — backward now flows output → all layers → input)
    if wq_l0_delta < 1.0e-12 { pass = 0 }
    // Phase 4d BPE checks
    if V_bpe < 150000 { pass = 0 }                 // real Qwen vocab (151643)
    if ok_in_vocab != 1 { pass = 0 }               // corpus IDS all in [0, V)
    if pass == 1 {
        println("TRAIN_V3_MOE_PILOT END-TO-END: PASS (d=64 V=151643 E=2 n_layer=1 T=4 · real Qwen corpus IDS · full backward: ln_f + layer-stack + tok_emb · layer 0 trained)")
    } else {
        println("TRAIN_V3_MOE_PILOT END-TO-END: FAIL")
    }
}
