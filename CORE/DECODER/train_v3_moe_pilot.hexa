// CORE/DECODER/train_v3_moe_pilot.hexa — M4b-fire-scale Phase 4c self-attention
//
// Pilot driver — Phase 4c adds proper self-attention (T > 1, causal mask,
// Q/K/V/Wo projections, scaled dot-product softmax). Per-layer block becomes:
//   [attn_Wq(d·d) | attn_Wk(d·d) | attn_Wv(d·d) | attn_Wo(d·d)
//    | mlp_Wup(h·d) | mlp_Wdown(d·h)]
//
// Pilot dims here (alloc-tuned · CPU smoke):
//   d=128   V=128 (placeholder)   E=2   h=512 (4·d FFN)
//   n_layer=2   T=16 (seq length)   n_steps=2
//
// Forward per step:
//   zT_seq[T·d] = tok_emb[ids[0..T]]
//   for layer in 0..n_layer:
//     residual = zT_seq
//     Q = zT_seq · Wq                          (T×d)
//     K = zT_seq · Wk                          (T×d)
//     V = zT_seq · Wv                          (T×d)
//     scores[t1, t2] = Σ_j Q[t1, j] · K[t2, j] / sqrt(d)
//     causal mask: scores[t1, t2] = -1e9 if t2 > t1
//     probs[t1, :] = softmax(scores[t1, :])
//     attn_out[t1, j] = Σ_t2 probs[t1, t2] · V[t2, j]
//     zT_seq = attn_out · Wo + residual
//     residual = zT_seq
//     for t in 0..T:                            (per-token MLP)
//       h_act = ReLU(Wup · zT_seq[t])
//       zT_seq[t] = Wdown · h_act
//     zT_seq = zT_seq + residual
//   final ln_f on zT_seq[T-1] (last-token routing)
//   top_idx = v3_moe_fwd(zT_seq[T-1], ...)
//
// Next sub-PRs: 4d real BPE corpus (V=151643) · 4e dispatch · 4-fire.

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_arch"

fn main() {
    println("=== train_v3_moe_pilot (M4b Phase 4c self-attn · d=128 V=128 n_layer=2 T=16) ===")

    let d = 128
    let V = 128
    let E = 2
    let h = 512
    let n_layer = 2
    let T = 16
    let n_steps = 2
    let block_size = 4 * d * d + 2 * h * d
    let tok_emb_off = 0
    let blocks_off = V * d
    let ln_f_off = V * d + n_layer * block_size
    let router_off = ln_f_off + d
    let experts_off = router_off + E * d
    let m_size = experts_off + E * V * d
    let attn_scale = 1.0 / sqrt(to_float(d))
    print("  config: d="); print(d); print(" V="); print(V); print(" E="); print(E)
    print(" h="); print(h); print(" n_layer="); print(n_layer); print(" T="); print(T); print(" n_steps="); println(n_steps)
    print("  block_size="); print(block_size); print(" m_size="); print(m_size)
    print(" params (FP64 8B · "); print(m_size * 8 / 1024 / 1024); println(" MB)")
    print("  attn_scale = 1/sqrt(d) = "); println(attn_scale)

    // packed param buffer + optimizer state
    let M = t_zeros(m_size)
    let dMg = t_zeros(m_size)
    let m_buf = t_zeros(m_size)
    let v_buf = t_zeros(m_size)
    // activation buffers (seq-shaped now)
    let zT_seq = t_zeros(T * d)
    let zT_residual = t_zeros(T * d)
    let Q_buf = t_zeros(T * d)
    let K_buf = t_zeros(T * d)
    let V_buf = t_zeros(T * d)
    let scores = t_zeros(T * T)
    let probs = t_zeros(T * T)
    let attn_out = t_zeros(T * d)
    let mlp_hact = t_zeros(h)
    let mlp_out = t_zeros(d)
    // MoE buffers (last-token only)
    let zT_last = t_zeros(d)
    let logits_g = t_zeros(V)
    let gate_norm = t_zeros(E)
    let d_zT_last = t_zeros(d)
    let d_logits = t_zeros(V)
    println("  alloc OK")

    // ── weight init ──
    let mut kk0 = 0
    while kk0 < V {
        let mut jj0 = 0
        while jj0 < d {
            let _ = farr_set(M, tok_emb_off + kk0 * d + jj0,
                              0.001 * to_float(kk0 + 1) + 0.0001 * to_float(jj0 + 1))
            jj0 = jj0 + 1
        }
        kk0 = kk0 + 1
    }
    let mut l = 0
    while l < n_layer {
        let block_off = blocks_off + l * block_size
        let wq_l = block_off
        let wk_l = block_off + d * d
        let wv_l = block_off + 2 * d * d
        let wo_l = block_off + 3 * d * d
        let wup_l = block_off + 4 * d * d
        let wdown_l = block_off + 4 * d * d + h * d
        // Wq, Wk, Wv: small random-ish (deterministic) — distinct so attention non-trivial
        let mut wi = 0
        while wi < d {
            let mut wj = 0
            while wj < d {
                let phase_q = (wi * 7 + wj + l * 3 + 1) % 11
                let phase_k = (wi + wj * 5 + l * 3 + 2) % 11
                let phase_v = (wi * 3 + wj * 7 + l + 3) % 11
                let _ = farr_set(M, wq_l + wi * d + wj, 0.01 * to_float(phase_q - 5))
                let _ = farr_set(M, wk_l + wi * d + wj, 0.01 * to_float(phase_k - 5))
                let _ = farr_set(M, wv_l + wi * d + wj, 0.01 * to_float(phase_v - 5))
                wj = wj + 1
            }
            wi = wi + 1
        }
        // Wo: identity (output projection)
        let mut oi = 0
        while oi < d {
            let _ = farr_set(M, wo_l + oi * d + oi, 1.0)
            oi = oi + 1
        }
        // mlp_Wup: small layer-distinct phase
        let mut ui = 0
        while ui < h {
            let mut uj = 0
            while uj < d {
                let phase = (ui + uj + l + 1) % 7
                let _ = farr_set(M, wup_l + ui * d + uj, 0.005 * to_float(phase - 3))
                uj = uj + 1
            }
            ui = ui + 1
        }
        // mlp_Wdown: identity-band
        let mut di = 0
        while di < d {
            let mut dk = 0
            while dk < h {
                let mut val = 0.0
                if dk % d == di {
                    val = 0.01 * to_float((dk / d) + 1) * (1.0 + 0.01 * to_float(l))
                }
                let _ = farr_set(M, wdown_l + di * h + dk, val)
                dk = dk + 1
            }
            di = di + 1
        }
        l = l + 1
    }
    // ln_f gamma + router + experts
    let mut gi = 0
    while gi < d { let _ = farr_set(M, ln_f_off + gi, 1.0) ; gi = gi + 1 }
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.001 * to_float((j + 1) % 17))
        let _ = farr_set(M, router_off + 1 * d + j, 0.001 * to_float((17 - j) % 17))
        j = j + 1
    }
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj,
                                  0.0001 * to_float(e + 1) * to_float(k + 1) + 0.00001 * to_float(jj + 1))
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    println("  init OK (Q/K/V/Wo · MLP · per-layer distinct)")

    // ── training loop ──
    let beta1 = 0.9
    let beta2 = 0.95
    let lr = 1.0e-3
    let wd = 0.1
    let adam_eps = 1.0e-8
    let rmsnorm_eps = 1.0e-6
    let neg_inf = 0.0 - 1.0e9
    let ids_arr = [13, 47, 100, 5, 89, 22, 71, 3, 119, 60, 8, 41, 95, 17, 33, 88]
    let m_baseline_wq_l0_00 = farr_get(M, blocks_off + 0 * d + 0)
    let m_baseline_wo_lN_00 = farr_get(M, blocks_off + (n_layer - 1) * block_size + 3 * d * d + 0 * d + 0)
    let mut final_top_idx = -1
    let mut final_gate_sum = 0.0
    let mut final_zT0 = 0.0

    println("  ── pilot multi-step + multi-layer + self-attn loop start ──")
    let mut step = 1
    while step <= n_steps {
        // zero grad buffers
        let mut zi = 0
        while zi < V { let _ = farr_set(d_logits, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < m_size { let _ = farr_set(dMg, zi, 0.0) ; zi = zi + 1 }
        zi = 0
        while zi < d { let _ = farr_set(d_zT_last, zi, 0.0) ; zi = zi + 1 }

        // tok_emb lookup: zT_seq[t, j] = M[tok_emb_off + ids_arr[t]·d + j]
        let mut t_idx = 0
        while t_idx < T {
            let token_id = ids_arr[(step + t_idx - 1) % 16]
            let mut j2 = 0
            while j2 < d {
                let _ = farr_set(zT_seq, t_idx * d + j2,
                                  farr_get(M, tok_emb_off + token_id * d + j2))
                j2 = j2 + 1
            }
            t_idx = t_idx + 1
        }

        // ── per-layer ──
        let mut layer = 0
        while layer < n_layer {
            let block_off = blocks_off + layer * block_size
            let wq_l = block_off
            let wk_l = block_off + d * d
            let wv_l = block_off + 2 * d * d
            let wo_l = block_off + 3 * d * d
            let wup_l = block_off + 4 * d * d
            let wdown_l = block_off + 4 * d * d + h * d
            // save residual: zT_residual = zT_seq
            let mut ri = 0
            while ri < T * d { let _ = farr_set(zT_residual, ri, farr_get(zT_seq, ri)) ; ri = ri + 1 }

            // Q = zT_seq · Wq, K = zT_seq · Wk, V = zT_seq · Wv
            let mut t1 = 0
            while t1 < T {
                let mut ji = 0
                while ji < d {
                    let mut accQ = 0.0
                    let mut accK = 0.0
                    let mut accV = 0.0
                    let mut jj = 0
                    while jj < d {
                        let z = farr_get(zT_seq, t1 * d + jj)
                        accQ = accQ + z * farr_get(M, wq_l + jj * d + ji)
                        accK = accK + z * farr_get(M, wk_l + jj * d + ji)
                        accV = accV + z * farr_get(M, wv_l + jj * d + ji)
                        jj = jj + 1
                    }
                    let _ = farr_set(Q_buf, t1 * d + ji, accQ)
                    let _ = farr_set(K_buf, t1 * d + ji, accK)
                    let _ = farr_set(V_buf, t1 * d + ji, accV)
                    ji = ji + 1
                }
                t1 = t1 + 1
            }
            // scores[t1, t2] = (Q[t1, :] · K[t2, :]) · attn_scale, causal mask
            t1 = 0
            while t1 < T {
                let mut t2 = 0
                while t2 < T {
                    let mut score = neg_inf
                    if t2 <= t1 {
                        let mut acc = 0.0
                        let mut jj = 0
                        while jj < d {
                            acc = acc + farr_get(Q_buf, t1 * d + jj) * farr_get(K_buf, t2 * d + jj)
                            jj = jj + 1
                        }
                        score = acc * attn_scale
                    }
                    let _ = farr_set(scores, t1 * T + t2, score)
                    t2 = t2 + 1
                }
                t1 = t1 + 1
            }
            // softmax row-wise: probs[t1, :] = softmax(scores[t1, :])
            t1 = 0
            while t1 < T {
                // numerical-stable: subtract row max
                let mut row_max = neg_inf
                let mut t2 = 0
                while t2 < T {
                    let s = farr_get(scores, t1 * T + t2)
                    if s > row_max { row_max = s }
                    t2 = t2 + 1
                }
                let mut z_sum = 0.0
                t2 = 0
                while t2 < T {
                    let e_val = exp(farr_get(scores, t1 * T + t2) - row_max)
                    let _ = farr_set(probs, t1 * T + t2, e_val)
                    z_sum = z_sum + e_val
                    t2 = t2 + 1
                }
                t2 = 0
                while t2 < T {
                    let _ = farr_set(probs, t1 * T + t2, farr_get(probs, t1 * T + t2) / z_sum)
                    t2 = t2 + 1
                }
                t1 = t1 + 1
            }
            // attn_out[t1, j] = Σ_t2 probs[t1, t2] · V[t2, j]
            t1 = 0
            while t1 < T {
                let mut ji = 0
                while ji < d {
                    let mut acc = 0.0
                    let mut t2 = 0
                    while t2 < T {
                        acc = acc + farr_get(probs, t1 * T + t2) * farr_get(V_buf, t2 * d + ji)
                        t2 = t2 + 1
                    }
                    let _ = farr_set(attn_out, t1 * d + ji, acc)
                    ji = ji + 1
                }
                t1 = t1 + 1
            }
            // zT_seq = attn_out · Wo + residual   (per-token Wo projection)
            t1 = 0
            while t1 < T {
                let mut ji = 0
                while ji < d {
                    let mut acc = 0.0
                    let mut jj = 0
                    while jj < d {
                        acc = acc + farr_get(attn_out, t1 * d + jj) * farr_get(M, wo_l + jj * d + ji)
                        jj = jj + 1
                    }
                    let _ = farr_set(zT_seq, t1 * d + ji, acc + farr_get(zT_residual, t1 * d + ji))
                    ji = ji + 1
                }
                t1 = t1 + 1
            }
            // save residual for MLP
            ri = 0
            while ri < T * d { let _ = farr_set(zT_residual, ri, farr_get(zT_seq, ri)) ; ri = ri + 1 }
            // MLP per-token
            t1 = 0
            while t1 < T {
                // h_act = ReLU(Wup · zT_seq[t1])
                let mut hk = 0
                while hk < h {
                    let mut acc = 0.0
                    let mut hj = 0
                    while hj < d {
                        acc = acc + farr_get(M, wup_l + hk * d + hj) * farr_get(zT_seq, t1 * d + hj)
                        hj = hj + 1
                    }
                    if acc < 0.0 { acc = 0.0 }
                    let _ = farr_set(mlp_hact, hk, acc)
                    hk = hk + 1
                }
                // zT_seq[t1] = Wdown · h_act + residual
                let mut mi = 0
                while mi < d {
                    let mut acc = 0.0
                    let mut mk = 0
                    while mk < h {
                        acc = acc + farr_get(M, wdown_l + mi * h + mk) * farr_get(mlp_hact, mk)
                        mk = mk + 1
                    }
                    let _ = farr_set(mlp_out, mi, acc)
                    mi = mi + 1
                }
                mi = 0
                while mi < d {
                    let _ = farr_set(zT_seq, t1 * d + mi, farr_get(mlp_out, mi) + farr_get(zT_residual, t1 * d + mi))
                    mi = mi + 1
                }
                t1 = t1 + 1
            }
            layer = layer + 1
        }

        // ── extract last-token: zT_last = zT_seq[T-1] ──
        let mut lj = 0
        while lj < d {
            let _ = farr_set(zT_last, lj, farr_get(zT_seq, (T - 1) * d + lj))
            lj = lj + 1
        }
        // ── final ln_f (RMSNorm) ──
        let mut ms = 0.0
        let mut mi2 = 0
        while mi2 < d {
            let xv = farr_get(zT_last, mi2) ; ms = ms + xv * xv ; mi2 = mi2 + 1
        }
        ms = ms / to_float(d)
        let rms_inv = 1.0 / sqrt(ms + rmsnorm_eps)
        let mut ni = 0
        while ni < d {
            let xv = farr_get(zT_last, ni)
            let gv = farr_get(M, ln_f_off + ni)
            let _ = farr_set(zT_last, ni, xv * rms_inv * gv)
            ni = ni + 1
        }
        // MoE
        let top_idx = v3_moe_fwd(zT_last, M, router_off, experts_off,
                                  logits_g, gate_norm, V, d, E)
        let target = ids_arr[(step + T) % 16]
        let _ = farr_set(d_logits, target, 1.0)
        v3_moe_bwd(zT_last, M, router_off, experts_off, gate_norm, top_idx, d_logits,
                   dMg, d_zT_last, V, d, E)
        // AdamW
        let bc1 = 1.0 - pow(beta1, to_float(step))
        let bc2 = 1.0 - pow(beta2, to_float(step))
        let mut pi = 0
        while pi < m_size {
            let g = farr_get(dMg, pi)
            let m_prev = farr_get(m_buf, pi)
            let v_prev = farr_get(v_buf, pi)
            let m_new = beta1 * m_prev + (1.0 - beta1) * g
            let v_new = beta2 * v_prev + (1.0 - beta2) * g * g
            let _ = farr_set(m_buf, pi, m_new)
            let _ = farr_set(v_buf, pi, v_new)
            let m_hat = m_new / bc1
            let v_hat = v_new / bc2
            let theta = farr_get(M, pi)
            let upd = lr * (m_hat / (sqrt(v_hat) + adam_eps) + wd * theta)
            let _ = farr_set(M, pi, theta - upd)
            pi = pi + 1
        }
        // per-step probe: probs[T-1, 0] = causal attn weight onto first token
        let probs_last_0 = farr_get(probs, (T - 1) * T + 0)
        // probs[0, 0] should equal 1.0 (only one valid token in causal-row 0)
        let probs_0_0 = farr_get(probs, 0 * T + 0)
        print("  step="); print(step)
        print(" tgt="); print(target)
        print(" top="); print(top_idx)
        print(" logit[tgt]="); print(farr_get(logits_g, target))
        print(" probs[0,0]="); print(probs_0_0)
        print(" probs[T-1,0]="); println(probs_last_0)
        if step == n_steps {
            final_top_idx = top_idx
            final_gate_sum = farr_get(gate_norm, 0) + farr_get(gate_norm, 1)
            final_zT0 = farr_get(zT_last, 0)
        }
        step = step + 1
    }
    println("  ── pilot self-attn loop end ──")
    let m_final_wq_l0_00 = farr_get(M, blocks_off + 0 * d + 0)
    let m_final_wo_lN_00 = farr_get(M, blocks_off + (n_layer - 1) * block_size + 3 * d * d + 0 * d + 0)
    let mut wq_l0_delta = m_final_wq_l0_00 - m_baseline_wq_l0_00
    if wq_l0_delta < 0.0 { wq_l0_delta = 0.0 - wq_l0_delta }
    let mut wo_lN_delta = m_final_wo_lN_00 - m_baseline_wo_lN_00
    if wo_lN_delta < 0.0 { wo_lN_delta = 0.0 - wo_lN_delta }
    print("  Wq[L0,0,0]   baseline="); print(m_baseline_wq_l0_00)
    print(" final="); print(m_final_wq_l0_00)
    print(" |Δ|="); println(wq_l0_delta)
    print("  Wo[LN-1,0,0] baseline="); print(m_baseline_wo_lN_00)
    print(" final="); print(m_final_wo_lN_00)
    print(" |Δ|="); println(wo_lN_delta)

    // ── verdict ──
    let ln_f_g0 = farr_get(M, ln_f_off + 0)
    let mut pass = 1
    if final_gate_sum < 0.999 || final_gate_sum > 1.001 { pass = 0 }
    if final_top_idx < 0 || final_top_idx >= E { pass = 0 }
    if final_zT0 == 0.0 { pass = 0 }
    if ln_f_g0 == 0.0 { pass = 0 }
    // self-attn check: probs[0, 0] = 1.0 (causal row 0 has only one valid token)
    // Note: probs is the LAST layer's probs (latest write); should still be 1.0
    let final_probs_0_0 = farr_get(probs, 0 * T + 0)
    if final_probs_0_0 < 0.99 || final_probs_0_0 > 1.01 { pass = 0 }
    // last-layer Wo moved through MoE backward
    if wo_lN_delta < 1.0e-9 { pass = 0 }
    if pass == 1 {
        println("TRAIN_V3_MOE_PILOT SELF-ATTN: PASS (d=128 V=128 E=2 n_layer=2 T=16 · causal-softmax · last-layer trained)")
    } else {
        println("TRAIN_V3_MOE_PILOT SELF-ATTN: FAIL")
    }
}
