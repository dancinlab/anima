// d3_router_load_balance.hexa — DECODER D3: top-1 router LOAD-BALANCE stability
// Hypothesis (decoder-moe-router-load-balance):
//   On a DIVERSE corpus, does the top-1 router distribute expert LOAD evenly
//   (each expert utilization > threshold, e.g. 0.1) — or does ONE expert win a
//   load monopoly (>0.9 share, others starve)? Load imbalance is the structural
//   precursor to M4b collapse (expert e1 saturate). Balanced ⇒ healthy.
//
// Falsifier:
//   A single expert holds >0.9 of routed load (others starve) → router cannot
//   balance → load imbalance is the structural root cause of collapse → redesign.
//
// Method (reuses moe_router top-1 fwd/bwd + the moe_toy_train SGD recipe):
//   - E=4 experts, V=8 vocab, d=6, N_CLUSTERS=6 diverse register prototypes.
//     (E < N_CLUSTERS forces sharing — the realistic over-subscribed regime
//      where monopoly/starvation can emerge, unlike the 2-input==2-expert toy.)
//   - train top-1 hard routing on the 6-cluster diverse "corpus".
//   - measure per-expert load = fraction of the 6 clusters that route (top1) to
//     each expert. Compute Gini + normalized entropy → balance score.
//   - monopoly = any expert load > 0.9.
//
// Pure hexa-native (farr model · moe_router fwd + moe_router_bwd). $0 mac-local.

import "/Users/ghost/core/anima/CORE/DECODER/moe_router.hexa"
import "/Users/ghost/core/anima/CORE/DECODER/moe_router_bwd.hexa"

// CE loss + grad: d_logits[k] = softmax(logits)[k] − [k==target]. returns CE.
fn ce_loss_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - moe_ln(p_tgt + 0.0000000001)
    let mut k = 0
    while k < V {
        let pk = farr_get(d_logits_out, k) / tot
        let tgt = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, pk - tgt)
        k = k + 1
    }
    return ce
}

// one HARD top-1 step on (zT, target). returns CE before update.
fn moe_toy_step_hard(zT: int, target: int, M: int, router_off: int, experts_off: int,
                     n_experts: int, V: int, d: int, total: int, lr: float) -> float {
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    let top = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let d_logits = farr_zeros(V)
    let ce = ce_loss_grad(logits, target, V, d_logits)
    let dM = farr_zeros(total)
    let d_zT = farr_zeros(d)
    moe_route_top1_bwd(zT, M, router_off, experts_off, gate, top, n_experts, V, d, d_logits, dM, d_zT)
    let mut i = 0
    while i < total {
        let _ = farr_set(M, i, farr_get(M, i) - lr * farr_get(dM, i))
        i = i + 1
    }
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    let _ = farr_free(d_logits)
    let _ = farr_free(dM)
    let _ = farr_free(d_zT)
    return ce
}

// top-1 expert index for a given input zT (post-softmax argmax).
fn route_top1_of(zT: int, M: int, router_off: int, n_experts: int, d: int) -> int {
    let g = farr_zeros(n_experts)
    moe_gate_fwd(zT, M, router_off, n_experts, d, g)
    moe_softmax(g, n_experts)
    let t = moe_argmax(g, n_experts)
    let _ = farr_free(g)
    return t
}

// set zT to the c-th diverse register prototype (one-hot at dim c%d, scaled).
// 6 clusters over d=6 → each cluster activates a distinct input dim → orthogonal,
// maximally-diverse corpus (the best case for the router to spread load).
fn set_cluster(zT: int, c: int, d: int) {
    let mut j = 0
    while j < d {
        let _ = farr_set(zT, j, 0.0)
        j = j + 1
    }
    let _ = farr_set(zT, c, 1.0)
}

fn abs_f(x: float) -> float { return if x < 0.0 { 0.0 - x } else { x } }

fn main() {
    print("=== DECODER D3: top-1 router LOAD-BALANCE (E=4 V=8 d=6 · 6 diverse clusters) ===")

    let n_experts = 4
    let V = 8
    let d = 6
    let n_clusters = 6
    let router_off = 0
    let experts_off = n_experts * d
    let total = experts_off + n_experts * V * d

    let M = farr_zeros(total)
    // ASYMMETRIC init so top-1 argmax can break ties from step 0
    let mut s = 0
    while s < total {
        let base = if s == s / 2 * 2 { 0.02 } else { 0.0 - 0.02 }
        let bump = to_float(s == s / 3 * 3) * 0.015
        let bump2 = to_float(s == s / 5 * 5) * 0.01
        let _ = farr_set(M, s, base + bump + bump2)
        s = s + 1
    }

    // 6 diverse register prototypes; each → a distinct target token.
    // cluster c → emit token (c mod V) so all 6 registers are separable.
    let zT = farr_zeros(d)
    let lr = 0.5
    let n_steps = 600

    // initial avg CE over all clusters
    let dlg = farr_zeros(V)
    let g0 = farr_zeros(n_experts)
    let lg0 = farr_zeros(V)
    let mut init_sum = 0.0
    let mut c0 = 0
    while c0 < n_clusters {
        set_cluster(zT, c0, d)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        init_sum = init_sum + ce_loss_grad(lg0, c0, V, dlg)
        c0 = c0 + 1
    }
    let init_loss = init_sum / to_float(n_clusters)
    print("  init avg CE = "); print(init_loss)

    // train: cycle through all 6 clusters each step
    let mut step = 0
    while step < n_steps {
        let mut c = 0
        while c < n_clusters {
            set_cluster(zT, c, d)
            let _ = moe_toy_step_hard(zT, c, M, router_off, experts_off, n_experts, V, d, total, lr)
            c = c + 1
        }
        step = step + 1
    }

    // final avg CE
    let mut fin_sum = 0.0
    let mut cf = 0
    while cf < n_clusters {
        set_cluster(zT, cf, d)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        fin_sum = fin_sum + ce_loss_grad(lg0, cf, V, dlg)
        cf = cf + 1
    }
    let final_loss = fin_sum / to_float(n_clusters)
    print("  final avg CE = "); print(final_loss)

    // === expert LOAD measurement: count top-1 routes per expert over all clusters ===
    let load = farr_zeros(n_experts)
    let mut cc = 0
    while cc < n_clusters {
        set_cluster(zT, cc, d)
        let t = route_top1_of(zT, M, router_off, n_experts, d)
        let _ = farr_set(load, t, farr_get(load, t) + 1.0)
        cc = cc + 1
    }
    // normalize to utilization fractions (sum = 1)
    let mut frac = farr_zeros(n_experts)
    let mut e = 0
    while e < n_experts {
        let _ = farr_set(frac, e, farr_get(load, e) / to_float(n_clusters))
        print("  expert e"); print(e); print(" load="); print(farr_get(load, e));
        print(" frac="); print(farr_get(frac, e))
        e = e + 1
    }

    // === balance metrics ===
    // (a) max load fraction → monopoly check
    let mut maxf = 0.0
    let mut active = 0
    let mut e2 = 0
    while e2 < n_experts {
        let f = farr_get(frac, e2)
        if f > maxf { maxf = f }
        if f > 0.0 { active = active + 1 }
        e2 = e2 + 1
    }
    // (b) Gini coefficient of the load fractions (0 = perfectly even, →1 = monopoly)
    let mut gsum = 0.0
    let mut a = 0
    while a < n_experts {
        let mut b = 0
        while b < n_experts {
            gsum = gsum + abs_f(farr_get(frac, a) - farr_get(frac, b))
            b = b + 1
        }
        a = a + 1
    }
    // Gini = Σ|xi-xj| / (2·n·Σxi); Σxi = 1
    let gini = gsum / (2.0 * to_float(n_experts) * 1.0)
    // (c) normalized Shannon entropy of load distribution (1 = perfectly even, 0 = monopoly)
    let mut ent = 0.0
    let mut e3 = 0
    while e3 < n_experts {
        let p = farr_get(frac, e3)
        if p > 0.0 { ent = ent - p * moe_ln(p) }
        e3 = e3 + 1
    }
    let norm_ent = ent / moe_ln(to_float(n_experts))

    print("  [metric] active_experts = "); print(active); print(" / "); print(n_experts)
    print("  [metric] max_load_frac = "); print(maxf)
    print("  [metric] gini = "); print(gini)
    print("  [metric] norm_entropy = "); print(norm_ent)

    // === VERDICT ===
    // healthy = learned the corpus AND no monopoly AND each active expert > 0.1
    let loss_dropped = if final_loss < init_loss * 0.5 { 1 } else { 0 }
    let monopoly = if maxf > 0.9 { 1 } else { 0 }
    // balanced threshold: gini < 0.5 (even-ish) is the load-balance PASS gate
    let balanced = if gini < 0.5 { 1 } else { 0 }
    print("  [verdict] loss_dropped = "); print(loss_dropped)
    print("  [verdict] monopoly(>0.9) = "); print(monopoly)
    print("  [verdict] balanced(gini<0.5) = "); print(balanced)

    if loss_dropped == 1 {
        if monopoly == 1 {
            print("=== D3: FALSIFIED — single-expert load monopoly (collapse precursor, redesign) ===")
        } else {
            if balanced == 1 {
                print("=== D3: SUPPORTED — top-1 router balances expert load on diverse corpus (healthy) ===")
            } else {
                print("=== D3: PARTIAL — no monopoly but load uneven (gini>=0.5), some experts starve ===")
            }
        }
    } else {
        print("=== D3: INCONCLUSIVE — corpus not learned, load metric unreliable ===")
    }

    let _ = farr_free(M)
    let _ = farr_free(zT)
    let _ = farr_free(dlg)
    let _ = farr_free(g0)
    let _ = farr_free(lg0)
    let _ = farr_free(load)
    let _ = farr_free(frac)
}
