// CORE/DECODER/v3_moe_arch_byteeq.hexa — byte-eq fingerprint of v3_moe_fwd/bwd
//
// Used by the mm_extract-elimination refactor (feat-mm-extract-eliminate) to
// confirm the new packed-gemv path is numerically identical to the prior
// mm_extract → mm copy path. Same toy config as v3_moe_arch_smoke (V=4 d=4 E=2)
// but logs every logit + every dMg entry + every d_zT entry verbatim so a
// byte-eq diff (pre vs post refactor) is unambiguous.
//
// Loss: L = 0.5·Σ logits²  → d_logits = logits  (matches v3_moe_arch_smoke).

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "/Users/ghost/core/anima/CORE/DECODER/flame_mm"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_arch"

fn main() {
    let d = 4
    let V = 4
    let E = 2
    let router_off = 0
    let experts_off = E * d
    let m_size = E * d + E * V * d
    let M = t_zeros(m_size)
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.10 * to_float(j + 1))
        let _ = farr_set(M, router_off + 1 * d + j, 0.10 * to_float(4 - j))
        j = j + 1
    }
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj,
                                  0.05 * to_float(e + 1) * to_float(k + 1) + 0.01 * to_float(jj + 1))
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    let zT = t_zeros(d)
    let mut zi = 0
    while zi < d { let _ = farr_set(zT, zi, 0.2 * to_float(zi + 1) - 0.3) ; zi = zi + 1 }

    let logits = t_zeros(V)
    let gate = t_zeros(E)
    let top = v3_moe_fwd(zT, M, router_off, experts_off, logits, gate, V, d, E)
    println("=== v3_moe_arch_byteeq fingerprint ===")
    print("top="); println(top)
    let mut k = 0
    while k < V {
        print("logits["); print(k); print("]="); println(farr_get(logits, k))
        k = k + 1
    }
    let mut ge = 0
    while ge < E {
        print("gate["); print(ge); print("]="); println(farr_get(gate, ge))
        ge = ge + 1
    }

    let dMg = t_zeros(m_size)
    let d_zT = t_zeros(d)
    let d_logits = t_zeros(V)
    let mut k2 = 0
    while k2 < V { let _ = farr_set(d_logits, k2, farr_get(logits, k2)) ; k2 = k2 + 1 }
    v3_moe_bwd(zT, M, router_off, experts_off, gate, top, d_logits, dMg, d_zT, V, d, E)

    let mut dj = 0
    while dj < d {
        print("d_zT["); print(dj); print("]="); println(farr_get(d_zT, dj))
        dj = dj + 1
    }
    // dMg fingerprint: print every entry (m_size = 40 for E=2 V=4 d=4)
    let mut mi = 0
    while mi < m_size {
        print("dMg["); print(mi); print("]="); println(farr_get(dMg, mi))
        mi = mi + 1
    }
    println("=== end fingerprint ===")
}
