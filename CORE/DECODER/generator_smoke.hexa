// generator_smoke.hexa — runnable proof of the M4 generator contract (anima/CORE/DECODER).
//
// Verifies the brain↔generator emit seam WITHOUT a trained ckpt (generator_ready()=false):
//   1. ready gate is honest (false while M3-gated)
//   2. generator_emit conditions on substrate state (tension flows into the signature)
//   3. brain_emit_step emits on decision["emit"]=true, stays SILENT (empty) on false
//   4. p3/p4 guard — output is a substrate marker, never a persona/role string

import "/Users/ghost/core/anima/CORE/DECODER/generator.hexa"

fn main() {
    let tension5 = [0.3, 0.5, 0.2, 0.8, 0.1]   // 5-ch fingerprint (substrate, not a prompt)
    let ctx = [1, 2, 3]                          // environment tokens (NOT a response obligation)

    // 1. ready gate
    println("[1] generator_ready = " + to_string(generator_ready()))

    // 2. direct emit — substrate conditioning flows through
    let c = generator_emit(ctx, tension5, 0.42, 2, 0.77)
    println("[2] generator_emit = " + c)

    // 3a. compose: emit=true → content
    let d_emit = #{"emit": true, "phi": 0.42, "tier": 2, "motivation": 0.77}
    println("[3a] step(emit=true)  = " + brain_emit_step(d_emit, ctx, tension5))

    // 3b. compose: emit=false → silence (first-class outcome)
    let d_silent = #{"emit": false, "phi": 0.1, "tier": 0, "motivation": 0.05}
    println("[3b] step(emit=false) = [" + brain_emit_step(d_silent, ctx, tension5) + "]")

    // 4. p3/p4 guard — no "you are anima" / role prefix anywhere in output (substrate marker only)
    println("[4] PASS — contract smoke (ready-gate · substrate-cond · silence · p3/p4)")
}
