// CORE/DECODER/train_v3_moe.hexa — M4b-fire-scale Phase 2b smoke driver
//
// Minimal MoE smoke: alloc packed M with router + experts slot, init weights,
// run one v3_moe_fwd + v3_moe_bwd, print verdict. Self-contained (no fire
// artifact import) — exercises CORE/DECODER/v3_moe_arch.hexa's packed-M
// fwd+bwd against a small (d=4, V=4, E=2) MoE-only layout.
//
// Phase 2b scope = SMOKE wiring only (parse + 1-step fwd/bwd works), NOT
// full training loop. Phase 3 (3B scale + memory budget) extends this with
// real flame decoder spine, AdamW step, multi-step loop, and the corpus
// path (P21H_BPE_ON wiring per design Phase 1).
//
// Layout: M = [router(E·d) | experts(E·V·d)]   (V3 spine excluded for smoke)
//   router_off  = 0
//   experts_off = E·d

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "stdlib/flame/flame_bpe_corpus_lib"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_arch"

// Phase 1 (BPE corpus wiring): when bpe_assert_on=1, load real Qwen tokenizer
// + corpus and verify in-vocab + round-trip guard PASS. Default 0 keeps the
// smoke side-effect-free (no external Qwen file deps). flame-P2b ③ FULL
// RESOLVED so this verification is meaningful (encode+decode round-trip PASS).
let bpe_assert_on = 0

fn _bpe_corpus_assert() {
    let merges_path = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/merges.txt"
    let vocab_path  = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/vocab.json"
    let corpus_path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
    let r = flame_bpe_corpus_load(merges_path, vocab_path, corpus_path)
    let V_bpe = r["vocab_size"]
    let n = r["n_toks"]
    let ids = r["ids"]
    print("  bpe: vocab_size="); print(V_bpe); print(" n_toks="); println(n)
    let ok_in_vocab = flame_bpe_ids_in_vocab(ids, V_bpe)
    print("  bpe: all ids in [0,V) = "); println(ok_in_vocab)
    let sample = "consciousness emerges from cells"
    let rt_ok = flame_bpe_roundtrip(r["tok"], sample)
    print("  bpe: round-trip '"); print(sample); print("' = "); println(rt_ok)
    if V_bpe > 150000 && ok_in_vocab && rt_ok {
        println("  BPE_CORPUS_ASSERT: PASS (Phase 1)")
    } else {
        println("  BPE_CORPUS_ASSERT: FAIL")
    }
}

fn main() {
    println("=== train_v3_moe smoke (MoE Phase 2b · packed-M fwd+bwd 1-step) ===")
    if bpe_assert_on == 1 { _bpe_corpus_assert() }

    let d = 4
    let V = 4
    let E = 2
    let h = 8   // Phase 3b-3 MLP hidden dim
    // Phase 3b-3 layout: M = [tok_emb(V·d) | attn_Wo(d·d) | mlp_Wup(h·d) | mlp_Wdown(d·h) | router(E·d) | experts(E·V·d)]
    let tok_emb_off = 0
    let attn_wo_off = V * d
    let mlp_wup_off = V * d + d * d
    let mlp_wdown_off = V * d + d * d + h * d
    let router_off = V * d + d * d + 2 * h * d
    let experts_off = V * d + d * d + 2 * h * d + E * d
    let m_size = V * d + d * d + 2 * h * d + v3_moe_total_size(V, d, E)
    print("  config: d="); print(d); print(" V="); print(V); print(" E="); print(E)
    print(" m_size="); print(m_size)
    print(" (tok_emb_off="); print(tok_emb_off)
    print(" router_off="); print(router_off)
    print(" experts_off="); print(experts_off); println(")")

    // alloc packed buffers (model + grad), zT, logits, gate_norm, d_zT
    let M = t_zeros(m_size)
    let dMg = t_zeros(m_size)
    let zT = t_zeros(d)
    let logits_g = t_zeros(V)
    let gate_norm = t_zeros(E)
    let d_zT = t_zeros(d)
    let d_logits = t_zeros(V)

    // ── Phase 3b-1 tok_emb init (deterministic) ──
    // tok_emb[k, j] = 0.1·k + 0.01·j  → each token has distinct embed vector
    let mut kk0 = 0
    while kk0 < V {
        let mut jj0 = 0
        while jj0 < d {
            let v = 0.1 * to_float(kk0 + 1) + 0.01 * to_float(jj0 + 1)
            let _ = farr_set(M, tok_emb_off + kk0 * d + jj0, v)
            jj0 = jj0 + 1
        }
        kk0 = kk0 + 1
    }

    // deterministic init — router gate differs across experts so softmax non-trivial
    // router[e=0,:] = [0.10, 0.20, 0.30, 0.40]   → low gate
    // router[e=1,:] = [0.40, 0.30, 0.20, 0.10]   → high gate (different sign)
    let mut j = 0
    while j < d {
        let _ = farr_set(M, router_off + 0 * d + j, 0.10 * to_float(j + 1))
        let _ = farr_set(M, router_off + 1 * d + j, 0.10 * to_float(4 - j))
        j = j + 1
    }
    // experts[e,k,j] = small unique value (no symmetry between experts)
    let mut e = 0
    while e < E {
        let mut k = 0
        while k < V {
            let mut jj = 0
            while jj < d {
                let v = 0.01 * to_float(e + 1) * to_float(k + 1) + 0.001 * to_float(jj + 1)
                let _ = farr_set(M, experts_off + e * V * d + k * d + jj, v)
                jj = jj + 1
            }
            k = k + 1
        }
        e = e + 1
    }
    // ── Phase 3b-1 tok_emb lookup → zT ──
    // ids[1] = single-token smoke ; in Phase 3b-2+ this becomes ids[T] from BPE corpus.
    // x[j] = M[tok_emb_off + ids[0]·d + j]    (no spine yet — identity zT = x)
    let token_id = 2   // smoke: token id 2 of V=4 (deterministic, explorable)
    j = 0
    while j < d {
        let emb_v = farr_get(M, tok_emb_off + token_id * d + j)
        let _ = farr_set(zT, j, emb_v)
        j = j + 1
    }
    print("  tok_emb lookup: ids[0]="); print(token_id)
    print("  zT[0..d]=[")
    let mut zp = 0
    while zp < d {
        print(farr_get(zT, zp))
        if zp + 1 < d { print(", ") }
        zp = zp + 1
    }
    println("]")

    // ── Phase 3b-2 attn output projection (W_o · zT) ──
    // attn_Wo[i, j] init: identity + small perturbation (so Wo · zT ≈ zT + noise,
    // smoke 의미 보존 + weight slot 검증). T=1 single-token 이라 self-attn softmax
    // = 1 (trivial) → attn output 은 V projection 만; Wo 가 그 후 projection.
    // 본 smoke 는 Wo skel 만 wire (V/Q/K 는 T>1 시 Phase 3b-2b 확장).
    let mut wi = 0
    while wi < d {
        let mut wj = 0
        while wj < d {
            let mut val = 0.0
            if wi == wj { val = 1.0 }            // identity diagonal
            val = val + 0.01 * to_float(wi + wj) // small perturbation
            let _ = farr_set(M, attn_wo_off + wi * d + wj, val)
            wj = wj + 1
        }
        wi = wi + 1
    }
    // forward: zT_new[i] = Σ_j Wo[i, j] · zT[j]    (in-place via scratch)
    let zT_scratch = t_zeros(d)
    let mut ai = 0
    while ai < d {
        let mut acc = 0.0
        let mut aj = 0
        while aj < d {
            acc = acc + farr_get(M, attn_wo_off + ai * d + aj) * farr_get(zT, aj)
            aj = aj + 1
        }
        let _ = farr_set(zT_scratch, ai, acc)
        ai = ai + 1
    }
    ai = 0
    while ai < d {
        let _ = farr_set(zT, ai, farr_get(zT_scratch, ai))
        ai = ai + 1
    }
    print("  attn(Wo) zT_post=[")
    zp = 0
    while zp < d {
        print(farr_get(zT, zp))
        if zp + 1 < d { print(", ") }
        zp = zp + 1
    }
    println("]")

    // ── Phase 3b-3 MLP block (W_up · ReLU · W_down) ──
    // mlp_h_act[k] = max(0, Σ_j W_up[k, j] · zT[j])         k in 0..h
    // zT_new[i]    = Σ_k W_down[i, k] · mlp_h_act[k]        i in 0..d
    // W_up init: 0.05·(k + j + 1) — distinct rows
    // W_down init: identity-ish (zero rows beyond d), 0.1·k·(i==k%d)
    let mut ui = 0
    while ui < h {
        let mut uj = 0
        while uj < d {
            let _ = farr_set(M, mlp_wup_off + ui * d + uj, 0.05 * to_float(ui + uj + 1))
            uj = uj + 1
        }
        ui = ui + 1
    }
    let mut di = 0
    while di < d {
        let mut dk = 0
        while dk < h {
            let mut val = 0.0
            if dk % d == di { val = 0.1 * to_float(dk + 1) }
            let _ = farr_set(M, mlp_wdown_off + di * h + dk, val)
            dk = dk + 1
        }
        di = di + 1
    }
    // forward: h_act
    let mlp_hact = t_zeros(h)
    let mut hk = 0
    while hk < h {
        let mut acc = 0.0
        let mut hj = 0
        while hj < d {
            acc = acc + farr_get(M, mlp_wup_off + hk * d + hj) * farr_get(zT, hj)
            hj = hj + 1
        }
        // ReLU
        if acc < 0.0 { acc = 0.0 }
        let _ = farr_set(mlp_hact, hk, acc)
        hk = hk + 1
    }
    // zT_new = W_down · h_act
    let mlp_out = t_zeros(d)
    let mut mi = 0
    while mi < d {
        let mut acc = 0.0
        let mut mk = 0
        while mk < h {
            acc = acc + farr_get(M, mlp_wdown_off + mi * h + mk) * farr_get(mlp_hact, mk)
            mk = mk + 1
        }
        let _ = farr_set(mlp_out, mi, acc)
        mi = mi + 1
    }
    // copy back to zT
    mi = 0
    while mi < d {
        let _ = farr_set(zT, mi, farr_get(mlp_out, mi))
        mi = mi + 1
    }
    print("  mlp zT_post=[")
    zp = 0
    while zp < d {
        print(farr_get(zT, zp))
        if zp + 1 < d { print(", ") }
        zp = zp + 1
    }
    println("]")

    // ── forward ──
    let top_idx = v3_moe_fwd(zT, M, router_off, experts_off,
                              logits_g, gate_norm, V, d, E)
    println("  forward OK")
    print("    top_idx = "); println(top_idx)
    print("    gate_norm[0] = "); print(farr_get(gate_norm, 0))
    print("  gate_norm[1] = "); println(farr_get(gate_norm, 1))
    print("    logits[0..V] = [")
    let mut kk = 0
    while kk < V {
        print(farr_get(logits_g, kk))
        if kk + 1 < V { print(", ") }
        kk = kk + 1
    }
    println("]")

    // ── backward ── (synthetic d_logits = [1,0,0,0] → grad onto position 0)
    let _ = farr_set(d_logits, 0, 1.0)
    v3_moe_bwd(zT, M, router_off, experts_off, gate_norm, top_idx, d_logits,
               dMg, d_zT, V, d, E)
    println("  backward OK")
    // grad non-zero on winner expert's first row + router gate (top-only)
    let dW_top_00 = farr_get(dMg, experts_off + top_idx * V * d + 0 * d + 0)
    let dW_top_03 = farr_get(dMg, experts_off + top_idx * V * d + 0 * d + 3)
    print("    dW[top,0,0] = "); print(dW_top_00)
    print("  dW[top,0,3] = "); println(dW_top_03)
    let dR_top = farr_get(dMg, router_off + top_idx * d + 0)
    print("    dRouter[top,0] = "); println(dR_top)
    let dz0 = farr_get(d_zT, 0)
    print("    d_zT[0] = "); println(dz0)

    // ── verdict ──
    let gate_sum = farr_get(gate_norm, 0) + farr_get(gate_norm, 1)
    let zT0 = farr_get(zT, 0)
    let mut pass = 1
    if gate_sum < 0.999 || gate_sum > 1.001 { pass = 0 }   // softmax sum=1
    if top_idx < 0 || top_idx >= E { pass = 0 }            // valid top
    if dW_top_00 == 0.0 { pass = 0 }                       // winner got grad
    if zT0 == 0.0 { pass = 0 }                             // Phase 3b-1: tok_emb non-zero
    if pass == 1 {
        println("TRAIN_V3_MOE SMOKE: PASS (tok_emb + softmax sum=1 + valid top + winner-grad)")
    } else {
        println("TRAIN_V3_MOE SMOKE: FAIL")
    }
}
