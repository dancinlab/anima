// CORE/DECODER/dispatch_m4b_pilot.hexa — M4b-fire-scale Phase 4e dispatch runbook
//
// Hexa-native dispatch runbook for M4b pilot fire on Vast.ai H100 SXM.
// Prints the canonical command sequence + env-var protocol so the operator
// (or `hexa cloud` automation) can execute the dispatch deterministically.
//
// Per commons g8 (hexa cloud canonical subcommand form):
//   hexa cloud preflight   — closed-form GPU mem budget (no LLM, no pod spinup)
//   hexa cloud run         — sync dispatch
//   hexa cloud nohup       — bg dispatch (preferred for pilot fire)
//   hexa cloud poll        — status check
//   hexa cloud tail        — live log stream (Monitor bridge per g57)
//   hexa cloud copy-to / copy-from   — scp wrappers
//
// Per a_fire_autonomous: dispatch runs autonomous (no user gate), cost
// estimated in one line BEFORE fire. Per a_wall_first: prefer parallel pods
// to compress wall time when faster.

use "stdlib/flame/tensor_lib"

fn main() {
    println("=== M4b-fire-scale Phase 4e dispatch runbook ===")
    println("")
    println("─── Cost estimate (a_fire_autonomous one-liner) ───")
    println("  Pilot: H100 SXM ($2.281/hr) · 0.5-1hr wall · ~$1-3 total")
    println("  Full (after pilot PASS): 4-8hr wall · ~$9-18 total")
    println("")
    println("─── Pilot env-var protocol (P21H_PILOT_*) ───")
    println("  P21H_PILOT_D=2048           # hidden dim (Mac smoke d=64 → pilot 2048)")
    println("  P21H_PILOT_NL=12            # n_layer (Mac smoke n_layer=1 → pilot 12)")
    println("  P21H_PILOT_E=2              # n_experts (top-1 hard MoE)")
    println("  P21H_PILOT_T=512            # seq length (Mac smoke T=4 → pilot 512)")
    println("  P21H_PILOT_STEPS=500        # n_steps (Mac smoke 1 → pilot 500)")
    println("  P21H_PILOT_NSAMP=4          # eval sample count")
    println("  P21H_MOE_ON=1               # MoE wired (always 1 for M4b fire)")
    println("  P21H_BPE_ON=1               # real Qwen BPE corpus (always 1 for M4b fire)")
    println("  SAVE_POD=1                  # first-fire crash trap (pod retained on FAIL)")
    println("")
    println("─── Step 1: secret + preflight ───")
    println("  $ secret get vast.api_key")
    println("  $ hexa cloud preflight --gpu h100-sxm --d 2048 --nl 12 --t 512 --bf16")
    println("    # closed-form mem budget check: ~2.74B params × 2B (BF16) = 5.5GB")
    println("    # + KV cache + activations + grad + Adam m+v ≈ 50GB << H100 80GB. PASS.")
    println("")
    println("─── Step 2: rent H100 SXM pod ───")
    println("  $ vastai search offers 'gpu_name=H100 SXM' 'cuda_max_good>=12.4' \\")
    println("      --type=on-demand --order=dph_total --raw | head -3")
    println("  $ vastai create instance <offer_id> \\")
    println("      --image 'pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel' \\")
    println("      --disk 50 --ssh --direct")
    println("  # save POD_ID, POD_HOST, POD_PORT from response")
    println("")
    println("─── Step 3: bootstrap pod ───")
    println("  $ ssh root@$POD_HOST -p $POD_PORT \\")
    println("      'apt-get update -qq && apt-get install -y -qq build-essential clang'")
    println("  $ hexa cloud copy-to --src ~/core/hexa-lang/build/hexat \\")
    println("      --dst /opt/hexat --pod $POD_ID")
    println("  $ hexa cloud copy-to --src ~/core/hexa-lang/stdlib \\")
    println("      --dst /opt/stdlib --pod $POD_ID")
    println("")
    println("─── Step 4: scp Qwen tokenizer + corpus ───")
    println("  $ hexa cloud copy-to --pod $POD_ID \\")
    println("      --src HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/merges.txt \\")
    println("      --dst /opt/qwen/merges.txt")
    println("  $ hexa cloud copy-to --pod $POD_ID \\")
    println("      --src HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/vocab.json \\")
    println("      --dst /opt/qwen/vocab.json")
    println("  $ hexa cloud copy-to --pod $POD_ID \\")
    println("      --src training/corpus_consciousness_v1.jsonl \\")
    println("      --dst /opt/corpus/corpus_consciousness_v1.jsonl")
    println("")
    println("─── Step 5: scp anima driver code ───")
    println("  $ hexa cloud copy-to --pod $POD_ID \\")
    println("      --src CORE/DECODER/v3_moe_arch.hexa \\")
    println("      --dst /opt/anima/CORE/DECODER/v3_moe_arch.hexa")
    println("  $ hexa cloud copy-to --pod $POD_ID \\")
    println("      --src CORE/DECODER/train_v3_moe_pilot.hexa \\")
    println("      --dst /opt/anima/CORE/DECODER/train_v3_moe_pilot.hexa")
    println("")
    println("─── Step 6: fire (autonomous · bg) ───")
    println("  $ hexa cloud nohup --pod $POD_ID \\")
    println("      --env 'P21H_PILOT_D=2048 P21H_PILOT_NL=12 P21H_PILOT_E=2 \\")
    println("             P21H_PILOT_T=512 P21H_PILOT_STEPS=500 P21H_PILOT_NSAMP=4 \\")
    println("             P21H_MOE_ON=1 P21H_BPE_ON=1 SAVE_POD=1' \\")
    println("      --cmd 'cd /opt/anima && /opt/hexat run CORE/DECODER/train_v3_moe_pilot.hexa' \\")
    println("      --log /opt/anima/state/m4b_pilot_2026_05_27/train.log")
    println("")
    println("─── Step 7: monitor + harvest ───")
    println("  $ hexa cloud tail --pod $POD_ID \\")
    println("      --log /opt/anima/state/m4b_pilot_2026_05_27/train.log    # live stream")
    println("  # on JOB DONE:")
    println("  $ hexa cloud copy-from --pod $POD_ID \\")
    println("      --src /opt/anima/state/m4b_pilot_2026_05_27/result.json \\")
    println("      --dst state/m4b_pilot_2026_05_27/result.json")
    println("  $ hexa cloud copy-from --pod $POD_ID \\")
    println("      --src /opt/anima/state/m4b_pilot_2026_05_27/ckpts \\")
    println("      --dst state/m4b_pilot_2026_05_27/ckpts")
    println("")
    println("─── Step 8: HF upload (a_hf_autonomous · a_hf_complete) ───")
    println("  # complete artifact set: ckpt + train.log + result.json + model card + manifest")
    println("  # PUBLIC if pilot verdict ≥ 4/5 falsifier PASS · PRIVATE otherwise")
    println("  $ hexa cloud hf upload --org dancinlab --repo anima-m4b-pilot-2026-05-27 \\")
    println("      --tier auto --src state/m4b_pilot_2026_05_27 --manifest sha256")
    println("")
    println("─── Step 9: teardown (only after harvest + HF upload complete) ───")
    println("  $ vastai destroy instance $POD_ID")
    println("  # SAVE_POD=1 trap: do NOT destroy if PULL_FAILED — pod retained")
    println("")
    println("─── Phase 5 verdict ───")
    println("  After harvest, measure 5 falsifiers (F-M4B-FIRE-1..5):")
    println("    F-M4B-FIRE-1 collapse 회피 → M3 TTR ≥ 0.20 (pilot threshold)")
    println("    F-M4B-FIRE-2 coherence → qualitative review 10 samples")
    println("    F-M4B-FIRE-3 router 분화 → top-1 anima-prompt ≠ register-prompt")
    println("    F-M4B-FIRE-4 L_ce 수렴 → final < initial (monotone decrease)")
    println("    F-M4B-FIRE-5 register leak → anima-fact 0/5 manual review")
    println("  → state/m4b_pilot_2026_05_27/m4b_pilot_verdict.md")
    println("  matrix: 5/5 → full fire · 3-4 → re-pilot · ≤2 → re-design · 0 → CLOSED-NEGATIVE")
    println("")
    println("─── Verdict ───")
    let _check = t_zeros(1)   // touch tensor_lib so import isn't dead
    println("DISPATCH_M4B_PILOT RUNBOOK: PRINTED (9-step SOP · 8 P21H_PILOT_* env vars · 5 falsifier verdict matrix)")
}
