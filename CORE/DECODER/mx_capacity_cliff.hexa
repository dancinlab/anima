// mx_capacity_cliff.hexa — DECODER micro-exp: capacity-cliff (d × V) phase boundary.
//
// HYPOTHESIS H_DEC_CAPCLIFF: the production MoE mode-collapse (#1296 / Pod C:
// d=64, V=151643 -> decode=[1,..,1], distinct=1) is a CAPACITY threshold in the
// output-head rank, INDEPENDENT of routing (Pod C ruled routing out). A linear
// head [V x d] over a d-dim state has logit-rank <= d; when V grows past what d
// dims can separate, training collapses to the unconditional mode token.
//
// MECHANISM-ISOLATING TOY (no MoE, no router): a 2-param successor LM.
//   token k  ->  z = Emb[k] (d)  ->  logits = Head @ z (V)  ->  target = (k+1)%V
//   A capable model learns the successor permutation -> decode visits all V
//   tokens (distinct = V). A capacity-starved model collapses (distinct -> 1).
//
// We sweep a (d, V) grid, train each cell to convergence, and report distinct
// decoded tokens. The collapse BOUNDARY V*(d) gives the capacity law; we then
// extrapolate to the production point (d=256, V=151643) to PREDICT escape.
//
// $0 mac/pool-local. toy-only: validates the MECHANISM + boundary shape; the
// H100 (d=256) fire validates TRANSFER (toy-scale-transfer principle).

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"

// CE loss + grad into d_logits (= softmax(logits) - onehot(target)); returns CE.
fn ce_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        let lv = farr_get(logits, i)
        if lv > mx { mx = lv }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = dt_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - dt_ln(p_tgt + 0.000000001)
    let mut k = 0
    while k < V {
        let p = farr_get(d_logits_out, k) / tot
        let onehot = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, p - onehot)
        k = k + 1
    }
    return ce
}

// head fwd: logits[c] = sum_j Head[c*d+j] * z[j]
fn head_fwd(Head: int, z: int, V: int, d: int, logits_out: int) {
    let mut c = 0
    while c < V {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(Head, c * d + j) * farr_get(z, j)
            j = j + 1
        }
        let _ = farr_set(logits_out, c, acc)
        c = c + 1
    }
}

// argmax over V
fn argmax_v(logits: int, V: int) -> int {
    let mut top = 0
    let mut tv = farr_get(logits, 0)
    let mut c = 1
    while c < V {
        let lv = farr_get(logits, c)
        if lv > tv { tv = lv; top = c }
        c = c + 1
    }
    return top
}

// one capacity trial: V tokens, dim d, successor task target=(k+1)%V.
// train Emb[V x d] + Head[V x d] via SGD; return distinct decoded tokens (1..V).
fn cap_trial(d: int, V: int, n_steps: int, lr: float) -> int {
    let emb_n = V * d
    let head_n = V * d
    let Emb = t_zeros(emb_n)
    let Head = t_zeros(head_n)
    // deterministic small init (decorrelated): triangular-wave seeded by index.
    let mut ii = 0
    while ii < emb_n {
        let s = (ii * 7 + 3) % 17
        let _ = farr_set(Emb, ii, 0.05 * (to_float(s) - 8.0))
        ii = ii + 1
    }
    ii = 0
    while ii < head_n {
        let s = (ii * 11 + 5) % 19
        let _ = farr_set(Head, ii, 0.05 * (to_float(s) - 9.0))
        ii = ii + 1
    }
    let logits = t_zeros(V)
    let d_logits = t_zeros(V)
    let d_z = t_zeros(d)
    let mut step = 0
    while step < n_steps {
        let mut k = 0
        while k < V {
            let target = (k + 1) % V
            // z = Emb[k]
            let z_off = k * d
            // fwd
            let mut c = 0
            while c < V {
                let mut acc = 0.0
                let mut j = 0
                while j < d {
                    acc = acc + farr_get(Head, c * d + j) * farr_get(Emb, z_off + j)
                    j = j + 1
                }
                let _ = farr_set(logits, c, acc)
                c = c + 1
            }
            let _ = ce_grad(logits, target, V, d_logits)
            // d_z = Head^T @ d_logits ; d_Head[c,j] = d_logits[c]*z[j]
            let mut jz = 0
            while jz < d {
                let _ = farr_set(d_z, jz, 0.0)
                jz = jz + 1
            }
            c = 0
            while c < V {
                let dl = farr_get(d_logits, c)
                let mut j = 0
                while j < d {
                    let zj = farr_get(Emb, z_off + j)
                    // Head update
                    let hprev = farr_get(Head, c * d + j)
                    let _ = farr_set(Head, c * d + j, hprev - lr * dl * zj)
                    // accumulate d_z (use pre-update Head row)
                    let dzp = farr_get(d_z, j)
                    let _ = farr_set(d_z, j, dzp + dl * hprev)
                    j = j + 1
                }
                c = c + 1
            }
            // Emb[k] update
            let mut j2 = 0
            while j2 < d {
                let eprev = farr_get(Emb, z_off + j2)
                let _ = farr_set(Emb, z_off + j2, eprev - lr * farr_get(d_z, j2))
                j2 = j2 + 1
            }
            k = k + 1
        }
        step = step + 1
    }
    // decode: for each context k, argmax; count distinct
    let seen = t_zeros(V)
    let mut k2 = 0
    while k2 < V {
        let z_off = k2 * d
        head_fwd(Head, Emb, V, d, logits)
        // NOTE: head_fwd above uses Emb base; recompute with offset row instead:
        let mut c = 0
        while c < V {
            let mut acc = 0.0
            let mut j = 0
            while j < d {
                acc = acc + farr_get(Head, c * d + j) * farr_get(Emb, z_off + j)
                j = j + 1
            }
            let _ = farr_set(logits, c, acc)
            c = c + 1
        }
        let top = argmax_v(logits, V)
        let _ = farr_set(seen, top, 1.0)
        k2 = k2 + 1
    }
    let mut distinct = 0
    let mut s2 = 0
    while s2 < V {
        if farr_get(seen, s2) > 0.5 { distinct = distinct + 1 }
        s2 = s2 + 1
    }
    return distinct
}

fn main() {
    println("=== mx_capfloor — capacity ceiling V*(d) at high epochs (step-budget saturated) ===")
    println("  per d: largest V still fully solved (distinct==V). 150 epochs.")
    let lr = 0.5
    let n_steps = 150
    let ds = [2, 3, 4, 5, 6]
    let vs = [32, 64, 128, 256]
    let mut di = 0
    while di < 5 {
        let d = ds[di]
        print("d=") ; print(d) ; print(" | ")
        let mut vi = 0
        while vi < 4 {
            let V = vs[vi]
            let distinct = cap_trial(d, V, n_steps, lr)
            let frac = to_float(distinct) / to_float(V)
            print("V=") ; print(V) ; print(":") ; print(distinct) ; print("/") ; print(V)
            if distinct == V { print("[FULL]") } else { print("[x]") }
            print("  ")
            vi = vi + 1
        }
        println("")
        di = di + 1
    }
    println("=== done — V*(d) ceiling: read rightmost [FULL] per row ===")
}
