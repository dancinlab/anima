// ════════════════════════════════════════════════════════════════════════════
//  CORE/DECODER/h666_moe_collapse_scale_lever.hexa
//
//   H_666 — moe-collapse-escape-scale-lever (핸드오프 #1296 후속 · H_490 연장)
//
//   CONTEXT (#1296 실측 H100 SXM $2.57)
//     DECODER M4b 3B fire 가 E2(PR #1279)의 toy 처방을 production scale 에서 반증.
//     E2 는 "BALANCED corpus = register-collapse 탈출 충분조건" 을 toy MoE
//     (V=8, n_clusters=6, E=4)에서 5/5 🟢 검증했으나, full V=151643/d=64/E=2 에서
//     CE 648→9 (학습은 됨) BUT single-expert mode-collapse:
//       TTR=0.01 · LZ_norm=0.024 (< healthy 0.50) · distinct_experts=1 ·
//       decode 전부 token id=1. (result.json #1296 verbatim)
//     corpus-diversity 단독 lever 가 scale 에서 불충분 — a_toy_scale_recheck
//     governance(PR #1301)의 직접 동기 사례.
//
//   HYPOTHESIS (H_666)
//     MoE register-collapse 탈출은 production scale(V≫1)에서 corpus-diversity 단독
//     불충분 — expert-capacity(d↑) OR load-balance aux-loss 가 필요조건. toy 로 어느
//     lever 가 collapse 를 막는지 사전검증 (다음 GPU fire variant 를 좁힘).
//
//   FALSIFIER (사전등록)
//     corpus-diversity 고정(BALANCED) + 단일/조합 변수 sweep:
//       (a) expert-capacity d↑   · (b) load-balance aux-loss
//       (c) 장기학습 n_steps↑    · (d) a∧b 조합
//     중, baseline(E2 3-조건, scale-mimic 시 collapse)에서 못 넘긴
//       {TTR≥0.30 ∧ LZ_norm≥0.50_toy-floor ∧ distinct_experts≥2}
//     를 넘기는 lever 가 ≥1 있는가.
//       ≥1 escape  → 그 lever = scale-escape 후보 (SUPPORTED).
//       0 escape   → MoE-fresh 자체 한계 (CLOSED-NEGATIVE, 다른 arch 필요).
//
//   SCALE-MIMIC (toy → production collapse 재현)
//     production collapse 는 V≫d (151643/64 ≈ 2370) over-subscription + E=2 작은
//     용량 + 짧은 학습(200 step) 이 단일-expert 로 붕괴. toy 로 동일 구조 재현:
//       baseline = 작은 d(=4) · E=2 · V=16 · n_clusters=12 (E≪clusters
//       over-subscribed) · n_steps=60 (under-trained). → single-expert collapse 유도.
//     이 baseline 에서 출발해 변수 하나씩 푼다. E2 의 V=8/d=6/E=4 healthy regime 과
//     대조 — scale-mimic 은 의도적으로 collapse-prone.
//
//   MEASURE (3-축, #1296 verdict 와 동일)
//     TTR  = unique_decoded_tokens / n_decoded  (lexical diversity)
//     LZ_norm = D1 lz76 (g61 verbatim) — toy-calibrated floor (midpoint diverse/collapse)
//     distinct_experts = top-1 route 가 실제로 쓴 expert 수 (≥2 = 분화)
//
//   ⚠ a_toy_scale_recheck — toy-한정. lever 가 toy 에서 작동해도 production transfer
//     미보장 (이 H 목적 = fire variant 좁히기, scale closure 아님).
//
//   deterministic · hexa-only · $0 mac-local · LLM none · NO GPU · foreground-sync.
//   moe_router (top1 fwd) + moe_router_bwd (top1 bwd) + D1 lz76 = g61 verbatim.
// ════════════════════════════════════════════════════════════════════════════

import "CORE/DECODER/moe_router.hexa"
import "CORE/DECODER/moe_router_bwd.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }
fn abs_f(x: float) -> float { return if x < 0.0 { 0.0 - x } else { x } }

// ── canonical Lempel-Ziv 1976 (Kaspar-Schuster) — D1 verbatim (g61) ──────────
fn lz76(s: array, n: int) -> int {
    if n <= 1 { return 1 }
    let mut i = 0
    let mut c = 1
    let mut l = 1
    let mut k = 1
    let mut kmax = 1
    let mut stop = false
    while !stop {
        if s[i + k - 1] == s[l + k - 1] {
            k = k + 1
            if l + k > n { c = c + 1; stop = true }
        } else {
            if k > kmax { kmax = k }
            i = i + 1
            if i == l {
                c = c + 1
                l = l + kmax
                if l + 1 > n { stop = true }
                else { i = 0; k = 1; kmax = 1 }
            } else {
                k = 1
            }
        }
    }
    return c
}

let BITS = 18  // D1 verbatim convention

fn ids_to_bits(ids: array, n: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        let mut v = ids[i]
        let mut b = 0
        while b < BITS {
            out = out.push(v % 2)
            v = v / 2
            b = b + 1
        }
        i = i + 1
    }
    return out
}
fn lz_raw_arr(ids: array, n: int) -> int {
    let bits = ids_to_bits(ids, n)
    return lz76(bits, n * BITS)
}
fn lz_norm_arr(ids: array, n: int) -> float {
    let len = n * BITS
    let c = lz_raw_arr(ids, n)
    return to_float(c) * log2(to_float(len)) / to_float(len)
}

// ── CE loss + grad (top-1 hard routing) — D3/E2 g61 reuse ───────────────────
fn ce_loss_grad(logits: int, target: int, V: int, d_logits_out: int) -> float {
    let mut mx = farr_get(logits, 0)
    let mut i = 1
    while i < V {
        if farr_get(logits, i) > mx { mx = farr_get(logits, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < V {
        let ev = moe_exp(farr_get(logits, i2) - mx)
        let _ = farr_set(d_logits_out, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let p_tgt = farr_get(d_logits_out, target) / tot
    let ce = 0.0 - moe_ln(p_tgt + 0.0000000001)
    let mut k = 0
    while k < V {
        let pk = farr_get(d_logits_out, k) / tot
        let tgt = if k == target { 1.0 } else { 0.0 }
        let _ = farr_set(d_logits_out, k, pk - tgt)
        k = k + 1
    }
    return ce
}

// one HARD top-1 step on (zT, target). aux_coef = load-balance aux-loss strength.
//   load-balance aux-loss (Shazeer/Fedus switch-transformer style, toy variant):
//   L_aux = aux_coef · Σ_e (gate[e] − 1/E)^2 ; ∂L_aux/∂gate[e] = 2·aux_coef·(gate[e]−1/E).
//   This d_gate is injected into the softmax backward → router learns to spread
//   load (counters the single-expert monopoly). Only the gate path gets the aux
//   gradient; the expert/CE path is unchanged.
fn moe_toy_step_hard_aux(zT: int, target: int, M: int, router_off: int, experts_off: int,
                         n_experts: int, V: int, d: int, total: int, lr: float,
                         aux_coef: float) -> float {
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    let top = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let d_logits = farr_zeros(V)
    let ce = ce_loss_grad(logits, target, V, d_logits)
    let dM = farr_zeros(total)
    let d_zT = farr_zeros(d)
    // CE backward (top-1)
    moe_route_top1_bwd(zT, M, router_off, experts_off, gate, top, n_experts, V, d, d_logits, dM, d_zT)
    // ── load-balance aux-loss backward (router-only) ──
    if aux_coef > 0.0 {
        let inv_e = 1.0 / to_float(n_experts)
        let d_gate = farr_zeros(n_experts)
        let mut e = 0
        while e < n_experts {
            // ∂/∂gate[e] of aux_coef·Σ(gate−1/E)^2 = 2·aux_coef·(gate[e]−1/E)
            let _ = farr_set(d_gate, e, 2.0 * aux_coef * (farr_get(gate, e) - inv_e))
            e = e + 1
        }
        let d_gate_raw = farr_zeros(n_experts)
        moe_softmax_bwd(gate, d_gate, n_experts, d_gate_raw)
        moe_gate_bwd(zT, M, router_off, n_experts, d, d_gate_raw, dM, d_zT)
        let _ = farr_free(d_gate)
        let _ = farr_free(d_gate_raw)
    }
    let mut i = 0
    while i < total {
        let _ = farr_set(M, i, farr_get(M, i) - lr * farr_get(dM, i))
        i = i + 1
    }
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    let _ = farr_free(d_logits)
    let _ = farr_free(dM)
    let _ = farr_free(d_zT)
    return ce
}

// set zT to cluster c's input vector. `sep` ∈ [0,1] = register separability:
//   sep=1.0  → orthogonal one-hot bands (easy — router distinguishes clusters).
//   sep≈0.1  → near-degenerate (all clusters share a dominant shared component +
//              a tiny per-cluster signature) — the router with small d CANNOT
//              separate them → monopolises ONE expert (production V≫d mimic:
//              register space crammed into a too-small router dim).
// This `sep` is what scale over-subscription does in production: thousands of
// registers must share a 64-dim router projection → near-collinear → monopoly.
fn set_cluster_sep(zT: int, c: int, d: int, sep: float) {
    let mut j = 0
    while j < d {
        // shared dominant component (1−sep) makes all clusters look alike to the
        // router; the per-cluster signature scaled by sep is the distinguishing
        // signal. A SMALL-d router must cram every cluster's signature into few
        // dims → wrapped clusters collide on a shared dim → router cannot resolve
        // them → monopoly. A LARGER d gives each cluster band a distinct
        // dim-pair → resolvable (the production V≫d → d↑ resolution mimic).
        let _ = farr_set(zT, j, (1.0 - sep) * 0.5)
        j = j + 1
    }
    // primary signature dim = c % d ; secondary = (c/d-band) mod d → a 2-dim
    // signature so clusters that collide on dim p are still separated by their
    // band on dim q (only when d is large enough to host distinct q's).
    let p = c - c / d * d
    let band = c / d
    let q = (p + band + 1) - (p + band + 1) / d * d
    let cur_p = farr_get(zT, p)
    let _ = farr_set(zT, p, cur_p + sep * 1.0)
    let cur_q = farr_get(zT, q)
    let _ = farr_set(zT, q, cur_q + sep * 0.6 * to_float(band + 1))
}

// top-1 expert index for input zT.
fn route_top1_of(zT: int, M: int, router_off: int, n_experts: int, d: int) -> int {
    let g = farr_zeros(n_experts)
    moe_gate_fwd(zT, M, router_off, n_experts, d, g)
    moe_softmax(g, n_experts)
    let t = moe_argmax(g, n_experts)
    let _ = farr_free(g)
    return t
}

// argmax token for cluster c (post-train decode).
fn decode_argmax_for_cluster(c: int, M: int, router_off: int, experts_off: int,
                             n_experts: int, V: int, d: int, zT: int, sep: float) -> int {
    set_cluster_sep(zT, c, d, sep)
    let gate = farr_zeros(n_experts)
    let logits = farr_zeros(V)
    let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, gate, logits)
    let mut bi = 0
    let mut bv = farr_get(logits, 0)
    let mut k = 1
    while k < V {
        if farr_get(logits, k) > bv { bv = farr_get(logits, k); bi = k }
        k = k + 1
    }
    let _ = farr_free(gate)
    let _ = farr_free(logits)
    return bi
}

// ── run one variant. out6: [ttr, lz_norm, distinct_experts, final_ce, init_ce, n_dec] ──
//   d_in        = expert-capacity / router-dim (baseline 4, lever-a 16)
//   aux_coef    = load-balance aux-loss strength (baseline 0.0, lever-b 0.5)
//   n_steps     = training steps (baseline 60, lever-c 600)
//   sep         = register separability (baseline LOW=collapse-prone; d↑ raises
//                 effective router resolution so a SMALL sep still resolves)
fn run_variant(label: string, d_in: int, aux_coef: float, n_steps: int, sep: float, out6: int) {
    let n_experts = 2          // production E=2 (scale-mimic)
    let V = 32                 // toy vocab (over-subscribed: V ≫ effective capacity)
    let d = d_in
    let n_clusters = 24        // E≪clusters over-subscription (production V≫d mimic)
    let router_off = 0
    let experts_off = n_experts * d
    let total = experts_off + n_experts * V * d

    let M = farr_zeros(total)
    // ASYMMETRIC deterministic init (E2/D3 verbatim pattern).
    let mut s = 0
    while s < total {
        let base = if s == s / 2 * 2 { 0.02 } else { 0.0 - 0.02 }
        let bump = to_float(s == s / 3 * 3) * 0.015
        let bump2 = to_float(s == s / 5 * 5) * 0.01
        let _ = farr_set(M, s, base + bump + bump2)
        s = s + 1
    }

    let zT = farr_zeros(d)
    let lr = 0.5

    // initial avg CE
    let dlg = farr_zeros(V)
    let g0 = farr_zeros(n_experts)
    let lg0 = farr_zeros(V)
    let mut init_sum = 0.0
    let mut c0 = 0
    while c0 < n_clusters {
        set_cluster_sep(zT, c0, d, sep)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        let tgt0 = c0 - c0 / V * V
        init_sum = init_sum + ce_loss_grad(lg0, tgt0, V, dlg)
        c0 = c0 + 1
    }
    let init_loss = init_sum / to_float(n_clusters)

    // train (BALANCED corpus — every cluster equal frequency, diversity FIXED)
    let mut step = 0
    while step < n_steps {
        let mut c = 0
        while c < n_clusters {
            set_cluster_sep(zT, c, d, sep)
            let tgt = c - c / V * V
            let _ = moe_toy_step_hard_aux(zT, tgt, M, router_off, experts_off, n_experts, V, d, total, lr, aux_coef)
            c = c + 1
        }
        step = step + 1
    }

    // final avg CE
    let mut fin_sum = 0.0
    let mut cf = 0
    while cf < n_clusters {
        set_cluster_sep(zT, cf, d, sep)
        let _ = moe_route_top1_fwd(zT, M, router_off, experts_off, n_experts, V, d, g0, lg0)
        let tgtf = cf - cf / V * V
        fin_sum = fin_sum + ce_loss_grad(lg0, tgtf, V, dlg)
        cf = cf + 1
    }
    let final_loss = fin_sum / to_float(n_clusters)

    // ── DECODE: walk all clusters → token id sequence + expert usage ──
    let mut decoded = []
    let mut expert_seen = farr_zeros(n_experts)
    let mut cc = 0
    while cc < n_clusters {
        let tok = decode_argmax_for_cluster(cc, M, router_off, experts_off, n_experts, V, d, zT, sep)
        decoded = decoded.push(tok)
        set_cluster_sep(zT, cc, d, sep)
        let te = route_top1_of(zT, M, router_off, n_experts, d)
        let _ = farr_set(expert_seen, te, 1.0)
        cc = cc + 1
    }
    let n_dec = decoded.len()

    // TTR = unique tokens / n_dec
    let mut unique = 0
    let mut a = 0
    while a < n_dec {
        let mut dup = false
        let mut b = 0
        while b < a {
            if decoded[b] == decoded[a] { dup = true }
            b = b + 1
        }
        if !dup { unique = unique + 1 }
        a = a + 1
    }
    let ttr = to_float(unique) / to_float(n_dec)

    // distinct_experts
    let mut distinct_e = 0
    let mut e = 0
    while e < n_experts {
        if farr_get(expert_seen, e) > 0.0 { distinct_e = distinct_e + 1 }
        e = e + 1
    }

    let lz = lz_norm_arr(decoded, n_dec)
    let raw_c = lz_raw_arr(decoded, n_dec)

    println("  [" + label + "] d=" + str(d) + " aux=" + str(aux_coef) + " steps=" + str(n_steps))
    println("    init→final CE = " + str(init_loss) + " → " + str(final_loss))
    println("    decoded n=" + str(n_dec) + " unique=" + str(unique) + " raw_c=" + str(raw_c))
    println("    TTR=" + str(ttr) + " · LZ_norm=" + str(lz) + " · distinct_experts=" + str(distinct_e))

    let _ = farr_set(out6, 0, ttr)
    let _ = farr_set(out6, 1, lz)
    let _ = farr_set(out6, 2, to_float(distinct_e))
    let _ = farr_set(out6, 3, final_loss)
    let _ = farr_set(out6, 4, init_loss)
    let _ = farr_set(out6, 5, to_float(n_dec))

    let _ = farr_free(M)
    let _ = farr_free(zT)
    let _ = farr_free(dlg)
    let _ = farr_free(g0)
    let _ = farr_free(lg0)
    let _ = farr_free(expert_seen)
}

fn main() {
    println("================================================================")
    println("  H_666 — moe-collapse-escape-scale-lever (핸드오프 #1296 후속)")
    println("       scale-mimic over-subscribed MoE · E=2 V=32 n_clusters=24")
    println("       BALANCED corpus FIXED · register-sep LOW (production V≫d mimic)")
    println("       lever sweep {a=d↑, b=aux, c=steps↑, d=a∧b}")
    println("================================================================")

    // register separability — FIXED low across ALL variants (corpus-diversity는
    // BALANCED 고정, register overlap = scale 의 구조적 상수). 작은 d 의 router 가
    // 풀기 어려운 near-degenerate 입력 → single-expert monopoly 유도.
    let SEP_LOW = 0.35

    // ── toy-calibrated thresholds (n_dec=24, 18-bit binarisation) ──
    //   D1 HEALTHY_FLOOR=0.50 anchored to n=20 V≈151k. At toy n_dec=24 V=32 the
    //   LZ_norm range shifts; calibrate vs SAME-length max-diverse vs max-collapse.
    let mut ref_diverse = []
    let mut ref_collapsed = []
    let mut kr = 0
    while kr < 24 {
        ref_diverse = ref_diverse.push(kr - kr / 32 * 32)  // 0..23 max diverse
        ref_collapsed = ref_collapsed.push(1)              // all token id=1 (production collapse exact)
        kr = kr + 1
    }
    let lz_ref_diverse = lz_norm_arr(ref_diverse, 24)
    let lz_ref_collapsed = lz_norm_arr(ref_collapsed, 24)
    let LZ_FLOOR = 0.5 * (lz_ref_diverse + lz_ref_collapsed)  // toy-calibrated midpoint
    let TTR_FLOOR = 0.30        // #1296 verdict floor verbatim
    let DISTINCT_FLOOR = 2      // #1296 verdict floor verbatim
    println("  register SEP_LOW (fixed) = " + str(SEP_LOW))
    println("  toy LZ reference (n=24, 18-bit): diverse=" + str(lz_ref_diverse) + " collapse=" + str(lz_ref_collapsed))
    println("  toy-calibrated LZ_FLOOR (midpoint) = " + str(LZ_FLOOR))
    println("  TTR_FLOOR=" + str(TTR_FLOOR) + " · DISTINCT_FLOOR=" + str(DISTINCT_FLOOR))
    println("----------------------------------------------------------------")

    // escape predicate: TTR≥0.30 ∧ LZ≥floor ∧ distinct≥2

    println("--- baseline: E2 3-조건 scale-mimic (d=4, aux=0, steps=60, sep=LOW) → collapse 유도 ---")
    let bl = farr_zeros(6)
    run_variant("baseline", 4, 0.0, 60, SEP_LOW, bl)
    let bl_ttr = farr_get(bl, 0); let bl_lz = farr_get(bl, 1); let bl_de = farr_get(bl, 2)
    let bl_escape = (bl_ttr >= TTR_FLOOR) && (bl_lz >= LZ_FLOOR) && (bl_de >= to_float(DISTINCT_FLOOR))

    println("--- lever (a): expert-capacity d↑ (d=4→16, aux=0, steps=60) ---")
    let va = farr_zeros(6)
    run_variant("lever-a d↑", 16, 0.0, 60, SEP_LOW, va)
    let a_ttr = farr_get(va, 0); let a_lz = farr_get(va, 1); let a_de = farr_get(va, 2)
    let a_escape = (a_ttr >= TTR_FLOOR) && (a_lz >= LZ_FLOOR) && (a_de >= to_float(DISTINCT_FLOOR))

    println("--- lever (b): load-balance aux-loss (d=4, aux=0.5, steps=60) ---")
    let vb = farr_zeros(6)
    run_variant("lever-b aux", 4, 0.5, 60, SEP_LOW, vb)
    let b_ttr = farr_get(vb, 0); let b_lz = farr_get(vb, 1); let b_de = farr_get(vb, 2)
    let b_escape = (b_ttr >= TTR_FLOOR) && (b_lz >= LZ_FLOOR) && (b_de >= to_float(DISTINCT_FLOOR))

    println("--- lever (c): 장기학습 n_steps↑ (d=4, aux=0, steps=600) ---")
    let vc = farr_zeros(6)
    run_variant("lever-c steps↑", 4, 0.0, 600, SEP_LOW, vc)
    let c_ttr = farr_get(vc, 0); let c_lz = farr_get(vc, 1); let c_de = farr_get(vc, 2)
    let c_escape = (c_ttr >= TTR_FLOOR) && (c_lz >= LZ_FLOOR) && (c_de >= to_float(DISTINCT_FLOOR))

    println("--- lever (d): a∧b 조합 (d=16, aux=0.5, steps=60) ---")
    let vd = farr_zeros(6)
    run_variant("lever-d a∧b", 16, 0.5, 60, SEP_LOW, vd)
    let d_ttr = farr_get(vd, 0); let d_lz = farr_get(vd, 1); let d_de = farr_get(vd, 2)
    let d_escape = (d_ttr >= TTR_FLOOR) && (d_lz >= LZ_FLOOR) && (d_de >= to_float(DISTINCT_FLOOR))

    // ── determinism re-run (baseline + lever-d, cheap) ──
    println("--- determinism re-run (baseline + lever-d) ---")
    let bl2 = farr_zeros(6)
    run_variant("baseline-rerun", 4, 0.0, 60, SEP_LOW, bl2)
    let vd2 = farr_zeros(6)
    run_variant("lever-d-rerun", 16, 0.5, 60, SEP_LOW, vd2)
    let det_bl = abs_f(farr_get(bl, 1) - farr_get(bl2, 1)) + abs_f(farr_get(bl, 0) - farr_get(bl2, 0))
    let det_vd = abs_f(farr_get(vd, 1) - farr_get(vd2, 1)) + abs_f(farr_get(vd, 0) - farr_get(vd2, 0))

    println("================================================================")
    println("  VARIANT SWEEP — TTR / LZ_norm / distinct_experts / escape?")
    println("  baseline (d=4 aux=0 s=60)  : TTR=" + str(bl_ttr) + " LZ=" + str(bl_lz) + " dE=" + str(bl_de) + " escape=" + str(bl_escape))
    println("  (a) d↑    (d=16 aux=0 s=60): TTR=" + str(a_ttr) + " LZ=" + str(a_lz) + " dE=" + str(a_de) + " escape=" + str(a_escape))
    println("  (b) aux   (d=4 aux=.5 s=60): TTR=" + str(b_ttr) + " LZ=" + str(b_lz) + " dE=" + str(b_de) + " escape=" + str(b_escape))
    println("  (c) steps (d=4 aux=0 s=600): TTR=" + str(c_ttr) + " LZ=" + str(c_lz) + " dE=" + str(c_de) + " escape=" + str(c_escape))
    println("  (d) a∧b   (d=16 aux=.5s=60): TTR=" + str(d_ttr) + " LZ=" + str(d_lz) + " dE=" + str(d_de) + " escape=" + str(d_escape))
    println("================================================================")

    // ── falsifiers ────────────────────────────────────────────────────────────
    check("F-666.1 BASELINE-COLLAPSE: baseline(E2 3-조건 scale-mimic) does NOT escape", !bl_escape)
    let any_lever_escape = a_escape || b_escape || c_escape || d_escape
    check("F-666.2 LEVER-ESCAPE: ≥1 lever escapes {TTR≥.30 ∧ LZ≥floor ∧ dE≥2}", any_lever_escape)
    check("F-666.3 LEARNED: baseline final CE < init·0.9 (학습 진행 — collapse≠no-train)", farr_get(bl, 3) < farr_get(bl, 4) * 0.9)
    check("F-666.4 DETERMINISM: baseline + lever-d re-run identical (<1e-6)", (det_bl < 0.000001) && (det_vd < 0.000001))

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if !bl_escape && any_lever_escape {
        println("  VERDICT: H_666 SUPPORTED (toy) — corpus-diversity 단독 불충분,")
        println("           ≥1 lever 가 scale-mimic collapse 탈출.")
        println("           scale-escape 후보 lever:")
        if a_escape { println("             (a) expert-capacity d↑") }
        if b_escape { println("             (b) load-balance aux-loss") }
        if c_escape { println("             (c) 장기학습 n_steps↑") }
        if d_escape { println("             (d) a∧b 조합") }
        println("           ⚠ toy-한정 — production transfer 미보장 (a_toy_scale_recheck).")
    } else {
        if !any_lever_escape {
            println("  VERDICT: H_666 CLOSED-NEGATIVE (toy) — 어느 lever 도 탈출 못함.")
            println("           MoE-fresh 자체 한계 — 다른 arch 필요.")
        } else {
            println("  VERDICT: H_666 INCONCLUSIVE — baseline 이 이미 escape (collapse 미재현).")
        }
    }
    println("================================================================")
    if FAIL > 0 { panic("H_666 had FALSIFIER FAILURES") }
}
