// CORE/DECODER/cublas_probe.hexa — M4b Phase 4-fire cuBLAS-engagement proof.
//
// Decisive proof that the GPU fire actually engages cuBLAS (not the CPU oracle):
//   1. cuda_available() == 1  — proves the #1671 glue strong-override flipped the
//      runtime.c WEAK hexa_cuda_available()->0 stub to the real device check.
//   2. farr_matmul_gpu (cuBLAS Dgemm) on a 1024×1024 @ 1024×1024 matrix returns a
//      valid handle AND matches the CPU oracle farr_matmul to ~1e-12 — proves the
//      cuBLAS kernel executed correctly on the GPU.
//   3. a sustained GPU-matmul loop so a concurrent nvidia-smi -l 1 can catch util>0
//      (bonus signal; (2) already proves GPU execution regardless of sampling).
//
// Uses only global RFC-040 builtins (cuda_available / farr_matmul / farr_matmul_gpu)
// + tensor_lib alloc/get/set — no flame_mm import, so it transpiles standalone.

use "stdlib/flame/tensor_lib"

fn fill_lcg(h, n, seed0) {
    let mut state = seed0
    let mut i = 0
    while i < n {
        state = (state * 1103515245 + 12345) % 2147483647
        let _ = farr_set(h, i, (to_float(state) / 2147483647.0) * 2.0 - 1.0)
        i = i + 1
    }
}

fn max_abs_diff(c1, c2, n) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n {
        let mut d = farr_get(c1, i) - farr_get(c2, i)
        if d < 0.0 { d = 0.0 - d }
        if d > m { m = d }
        i = i + 1
    }
    return m
}

fn main() {
    println("=== M4b cuBLAS-engagement probe (Phase 4-fire) ===")
    print("CUDA_PROBE avail="); println(cuda_available())

    let n = 1024
    let A = t_zeros(n * n)
    let B = t_zeros(n * n)
    fill_lcg(A, n * n, 12345)
    fill_lcg(B, n * n, 67890)

    // (2) GPU path (cuBLAS Dgemm) vs CPU oracle correctness
    let Cg = farr_matmul_gpu(A, n, n, B, n)
    print("GPU_HANDLE="); println(Cg)
    let Cc = farr_matmul(A, n, n, B, n)
    if Cg >= 0 {
        let d = max_abs_diff(Cg, Cc, n * n)
        print("MM_GPU_VS_CPU n=1024 max|delta|="); println(d)
    } else {
        println("GPU_MATMUL_ERROR cuBLAS returned <0 (cuda not engaged)")
    }

    // (3) sustained GPU loop (free each handle to bound device memory)
    let mut it = 0
    while it < 200 {
        let h = farr_matmul_gpu(A, n, n, B, n)
        if h >= 0 { let _ = farr_free(h) }
        it = it + 1
    }
    println("PROBE_DONE 200 GPU matmuls")
}
