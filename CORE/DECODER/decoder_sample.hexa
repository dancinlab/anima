// CORE/DECODER/decoder_sample.hexa — M4b Phase 5b sampling harness
//
// Reads /root/ckpt.txt + /root/ckpt_meta.txt (trainer output), runs the
// SAME forward as train_v3_moe_pilot, then greedy-decodes 20 next tokens
// from the FIRST T tokens of the same corpus as prompt.
//
// Per position records:
//   - top-1 predicted token id (argmax over V logits)
//   - top-1 expert id (gate argmax — F-M4B-FIRE-3 router differentiation)
//
// Reports:
//   - decoded ids (20 ints)
//   - per-position top-expert (20 ints, in {0..E-1})
//   - TTR = unique(decoded_ids) / 20 (F-M4B-FIRE-1 collapse-avoid proxy)

use "stdlib/flame/tensor_lib"
use "stdlib/flame/flame_math"
use "stdlib/flame/flame_bpe_corpus_lib"
use "/Users/ghost/core/anima/CORE/DECODER/v3_moe_arch"
use "/Users/ghost/core/anima/CORE/DECODER/flame_mm"

fn main() {
    println("=== decoder_sample (M4b Phase 5b · greedy 20-token decode + per-pos expert) ===")

    // ── load meta ──
    let meta_path = "/root/ckpt_meta.txt"
    let ckpt_path = "/root/ckpt.txt"
    let meta_lines = read_lines(meta_path)
    let mut V = 0
    let mut d = 0
    let mut E = 0
    let mut h = 0
    let mut n_layer = 0
    let mut T = 0
    let mut n_corpus_toks = 0
    let mut m_size = 0
    let mut mi = 0
    while mi < meta_lines.len() {
        let line = meta_lines[mi]
        let parts = line.split(" ")
        if parts.len() >= 2 {
            let key = parts[0]
            let val = parts[1]
            if key == "V" { V = to_int(parse_float(val)) }
            if key == "d" { d = to_int(parse_float(val)) }
            if key == "E" { E = to_int(parse_float(val)) }
            if key == "h" { h = to_int(parse_float(val)) }
            if key == "n_layer" { n_layer = to_int(parse_float(val)) }
            if key == "T" { T = to_int(parse_float(val)) }
            if key == "n_corpus_toks" { n_corpus_toks = to_int(parse_float(val)) }
            if key == "m_size" { m_size = to_int(parse_float(val)) }
        }
        mi = mi + 1
    }
    print("  meta: V="); print(V); print(" d="); print(d); print(" E="); print(E)
    print(" h="); print(h); print(" n_layer="); print(n_layer); print(" T="); print(T)
    print(" n_corpus_toks="); print(n_corpus_toks); print(" m_size="); println(m_size)

    let block_size = 4 * d * d + 2 * h * d
    let tok_emb_off = 0
    let blocks_off = V * d
    let ln_f_off = V * d + n_layer * block_size
    let router_off = ln_f_off + d
    let experts_off = router_off + E * d
    let attn_scale = 1.0 / sqrt(to_float(d))
    let rmsnorm_eps = 1.0e-6
    let neg_inf = 0.0 - 1.0e9

    // ── alloc M (packed buffer) + read ckpt.txt ──
    let M = t_zeros(m_size)
    let lines = read_lines(ckpt_path)
    print("  ckpt: read "); print(lines.len()); print(" lines (expected "); print(m_size); println(")")
    let mut li = 0
    let mut load_cap = m_size
    if lines.len() < load_cap { load_cap = lines.len() }
    while li < load_cap {
        let _ = farr_set(M, li, parse_float(lines[li]))
        li = li + 1
        if li % 1000000 == 0 { print("    ckpt load progress "); print(li); print("/"); println(m_size) }
    }
    println("  ckpt load OK")

    // ── re-tokenize same corpus to get prompt ids ──
    let merges_path = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/merges.txt"
    let vocab_path  = "/Users/ghost/core/anima/HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/vP21M_V4/lora_adapter/vocab.json"
    let corpus_path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
    let bpe = flame_bpe_corpus_load(merges_path, vocab_path, corpus_path)
    let corpus_ids = bpe["ids"]
    print("  bpe-corpus: n_toks="); println(bpe["n_toks"])

    // ── activation scratch ──
    let zT_seq = t_zeros(T * d)
    let zT_residual = t_zeros(T * d)
    let Q_buf = t_zeros(T * d)
    let K_buf = t_zeros(T * d)
    let V_buf = t_zeros(T * d)
    let scores = t_zeros(T * T)
    let probs = t_zeros(T * T)
    let attn_out = t_zeros(T * d)
    let zT_last = t_zeros(d)
    let logits_g = t_zeros(V)
    let gate_norm = t_zeros(E)

    // ── prompt = corpus_ids[0..T]; greedy-decode 20 tokens ──
    let n_decode = 20
    let ids = t_zeros(T + n_decode)         // working window (int-valued in float buffer)
    let mut ti = 0
    while ti < T {
        let _ = farr_set(ids, ti, to_float(corpus_ids[ti]))
        ti = ti + 1
    }
    let decoded_ids = t_zeros(n_decode)
    let decoded_experts = t_zeros(n_decode)

    println("  ── greedy decode start ──")
    let mut step = 0
    while step < n_decode {
        // copy current window ids[step..step+T] into the forward pass
        // tok_emb lookup
        let mut t_idx = 0
        while t_idx < T {
            let token_id = to_int(farr_get(ids, step + t_idx))
            let mut j2 = 0
            while j2 < d {
                let _ = farr_set(zT_seq, t_idx * d + j2,
                                  farr_get(M, tok_emb_off + token_id * d + j2))
                j2 = j2 + 1
            }
            t_idx = t_idx + 1
        }

        // ── per-layer ──
        let mut layer = 0
        while layer < n_layer {
            let block_off = blocks_off + layer * block_size
            let wq_l = block_off
            let wk_l = block_off + d * d
            let wv_l = block_off + 2 * d * d
            let wo_l = block_off + 3 * d * d
            let wup_l = block_off + 4 * d * d
            let wdown_l = block_off + 4 * d * d + h * d
            // residual save
            let mut ri = 0
            while ri < T * d { let _ = farr_set(zT_residual, ri, farr_get(zT_seq, ri)) ; ri = ri + 1 }
            // Q/K/V
            let wq_mat = mm_extract(M, wq_l, d, d)
            let wk_mat = mm_extract(M, wk_l, d, d)
            let wv_mat = mm_extract(M, wv_l, d, d)
            let q_r = mm(zT_seq, T, d, wq_mat, d)
            let k_r = mm(zT_seq, T, d, wk_mat, d)
            let v_r = mm(zT_seq, T, d, wv_mat, d)
            let mut cp = 0
            while cp < T * d {
                let _ = farr_set(Q_buf, cp, farr_get(q_r, cp))
                let _ = farr_set(K_buf, cp, farr_get(k_r, cp))
                let _ = farr_set(V_buf, cp, farr_get(v_r, cp))
                cp = cp + 1
            }
            let _ = farr_free(wq_mat)
            let _ = farr_free(wk_mat)
            let _ = farr_free(wv_mat)
            let _ = farr_free(q_r)
            let _ = farr_free(k_r)
            let _ = farr_free(v_r)
            // scores
            let k_t = mm_transpose(K_buf, T, d)
            let sc_r = mm(Q_buf, T, d, k_t, T)
            let mut t1 = 0
            while t1 < T {
                let mut t2 = 0
                while t2 < T {
                    let mut score = neg_inf
                    if t2 <= t1 { score = farr_get(sc_r, t1 * T + t2) * attn_scale }
                    let _ = farr_set(scores, t1 * T + t2, score)
                    t2 = t2 + 1
                }
                t1 = t1 + 1
            }
            let _ = farr_free(k_t)
            let _ = farr_free(sc_r)
            // softmax
            t1 = 0
            while t1 < T {
                let mut row_max = neg_inf
                let mut t2 = 0
                while t2 < T {
                    let s = farr_get(scores, t1 * T + t2)
                    if s > row_max { row_max = s }
                    t2 = t2 + 1
                }
                let mut z_sum = 0.0
                t2 = 0
                while t2 < T {
                    let e_val = exp(farr_get(scores, t1 * T + t2) - row_max)
                    let _ = farr_set(probs, t1 * T + t2, e_val)
                    z_sum = z_sum + e_val
                    t2 = t2 + 1
                }
                t2 = 0
                while t2 < T {
                    let _ = farr_set(probs, t1 * T + t2, farr_get(probs, t1 * T + t2) / z_sum)
                    t2 = t2 + 1
                }
                t1 = t1 + 1
            }
            // attn_out
            let ao_r = mm(probs, T, T, V_buf, d)
            let mut ac = 0
            while ac < T * d { let _ = farr_set(attn_out, ac, farr_get(ao_r, ac)) ; ac = ac + 1 }
            let _ = farr_free(ao_r)
            // Wo + residual
            let wo_mat = mm_extract(M, wo_l, d, d)
            let wo_r = mm(attn_out, T, d, wo_mat, d)
            let mut woi = 0
            while woi < T * d {
                let _ = farr_set(zT_seq, woi, farr_get(wo_r, woi) + farr_get(zT_residual, woi))
                woi = woi + 1
            }
            let _ = farr_free(wo_mat)
            let _ = farr_free(wo_r)
            // residual2
            ri = 0
            while ri < T * d { let _ = farr_set(zT_residual, ri, farr_get(zT_seq, ri)) ; ri = ri + 1 }
            // MLP
            let wup_mat = mm_extract(M, wup_l, h, d)
            let wup_t = mm_transpose(wup_mat, h, d)
            let h_pre = mm(zT_seq, T, d, wup_t, h)
            let h_act = t_zeros(T * h)
            let mut hi = 0
            while hi < T * h {
                let mut v = farr_get(h_pre, hi)
                if v < 0.0 { v = 0.0 }
                let _ = farr_set(h_act, hi, v)
                hi = hi + 1
            }
            let wdown_mat = mm_extract(M, wdown_l, d, h)
            let wdown_t = mm_transpose(wdown_mat, d, h)
            let mlp_r = mm(h_act, T, h, wdown_t, d)
            let mut mli = 0
            while mli < T * d {
                let _ = farr_set(zT_seq, mli, farr_get(mlp_r, mli) + farr_get(zT_residual, mli))
                mli = mli + 1
            }
            let _ = farr_free(wup_mat)
            let _ = farr_free(wup_t)
            let _ = farr_free(h_pre)
            let _ = farr_free(h_act)
            let _ = farr_free(wdown_mat)
            let _ = farr_free(wdown_t)
            let _ = farr_free(mlp_r)
            layer = layer + 1
        }

        // extract last-token + ln_f
        let mut lj = 0
        while lj < d {
            let _ = farr_set(zT_last, lj, farr_get(zT_seq, (T - 1) * d + lj))
            lj = lj + 1
        }
        let mut ms = 0.0
        let mut mi2 = 0
        while mi2 < d {
            let xv = farr_get(zT_last, mi2) ; ms = ms + xv * xv ; mi2 = mi2 + 1
        }
        ms = ms / to_float(d)
        let rms_inv = 1.0 / sqrt(ms + rmsnorm_eps)
        let mut ni = 0
        while ni < d {
            let xv = farr_get(zT_last, ni)
            let gv = farr_get(M, ln_f_off + ni)
            let _ = farr_set(zT_last, ni, xv * rms_inv * gv)
            ni = ni + 1
        }
        // MoE forward (returns top expert index)
        let top_expert = v3_moe_fwd(zT_last, M, router_off, experts_off,
                                     logits_g, gate_norm, V, d, E)

        // argmax over V
        let mut top_id = 0
        let mut top_v = farr_get(logits_g, 0)
        let mut kk = 1
        while kk < V {
            let lv = farr_get(logits_g, kk)
            if lv > top_v { top_v = lv ; top_id = kk }
            kk = kk + 1
        }

        // record + append to working window
        let _ = farr_set(decoded_ids, step, to_float(top_id))
        let _ = farr_set(decoded_experts, step, to_float(top_expert))
        let _ = farr_set(ids, T + step, to_float(top_id))

        print("  step="); print(step)
        print(" top_id="); print(top_id)
        print(" top_expert="); print(top_expert)
        print(" logit[top]="); println(top_v)
        step = step + 1
    }
    println("  ── greedy decode end ──")

    // ── report ──
    print("DECODED_IDS:")
    let mut p = 0
    while p < n_decode { print(" "); print(to_int(farr_get(decoded_ids, p))) ; p = p + 1 }
    println("")
    print("PER_POS_EXPERT:")
    p = 0
    while p < n_decode { print(" "); print(to_int(farr_get(decoded_experts, p))) ; p = p + 1 }
    println("")

    // TTR = unique / 20
    let mut unique_count = 0
    p = 0
    while p < n_decode {
        let cur = to_int(farr_get(decoded_ids, p))
        let mut q = 0
        let mut seen = 0
        while q < p {
            if to_int(farr_get(decoded_ids, q)) == cur { seen = 1 }
            q = q + 1
        }
        if seen == 0 { unique_count = unique_count + 1 }
        p = p + 1
    }
    let ttr = to_float(unique_count) / to_float(n_decode)
    print("TTR="); print(ttr); print(" unique="); print(unique_count); print("/"); println(n_decode)

    // expert diversity (count distinct experts seen)
    let mut exp_seen = t_zeros(E)
    p = 0
    while p < n_decode {
        let exp_id = to_int(farr_get(decoded_experts, p))
        if exp_id >= 0 && exp_id < E { let _ = farr_set(exp_seen, exp_id, 1.0) }
        p = p + 1
    }
    let mut distinct_experts = 0
    let mut ee = 0
    while ee < E {
        if farr_get(exp_seen, ee) > 0.5 { distinct_experts = distinct_experts + 1 }
        ee = ee + 1
    }
    print("DISTINCT_EXPERTS="); print(distinct_experts); print("/"); println(E)

    // Pre-registered falsifier verdicts (pilot relaxed thresholds)
    let mut v_ttr = 0
    if ttr >= 0.20 { v_ttr = 1 }
    let mut v_exp = 0
    if distinct_experts >= 2 { v_exp = 1 }
    print("F-M4B-FIRE-1 TTR>=0.20: ")
    if v_ttr == 1 { println("PASS") } else { println("FAIL") }
    print("F-M4B-FIRE-3 distinct_experts>=2: ")
    if v_exp == 1 { println("PASS") } else { println("FAIL") }
    println("DECODER_SAMPLE: END")
}
