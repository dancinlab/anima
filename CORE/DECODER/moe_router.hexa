// moe_router.hexa — DECODER M4a: K-expert MoE router for the head_g slot
// UNIVERSE H_490 DIFFERENTIATION → MoE (stem cell → expert specialization).
//
// Goal (double-bind escape, a_completeness_over_cheap primary path):
//   The single head_g forces ONE projection to both carve register AND stay
//   coherent — the register-collapse vs underfit double-bind. Split it into
//   K experts: a router selects per-token which expert speaks, so register-
//   carving lives in a dedicated expert while the main path stays coherent.
//
// Weight layout (packed buffer M, farr float model — same as conscious_decoder_v3):
//   router slot  @ router_off    : [n_experts · d]        gate weights
//   experts slot @ experts_off   : [n_experts · V · d]    K linear emission heads
//   (each expert e is a V·d linear head, byte-identical shape to v3 head_g)
//
// Forward path:
//   gate[e]      = Σ_j router[e·d+j] · zT[j]              (moe_gate_fwd)
//   gate         = softmax(gate)                          (moe_softmax)
//   top1         = argmax(gate)                           (moe_argmax — hard route diag)
//   logits[k]    = Σ_e gate[e] · expert_e(zT)[k]          (moe_combine_soft)
//
// M4a delivers the FORWARD arch + selection (hexa-native, parse-clean).
// M4b = router/expert backward + expert-separated training fire.
// M4c = p7 verify (collapse 회피 ∧ coherence 둘 다).

// ---------------------------------------------------------------
// 1. moe_gate_fwd — router gate logits over n_experts
//   gate_out[e] = Σ_j router[e·d+j] · zT[j]
// ---------------------------------------------------------------
pub fn moe_gate_fwd(zT: int, M: int, router_off: int,
                    n_experts: int, d: int, gate_out: int) {
    let mut e = 0
    while e < n_experts {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(M, router_off + e * d + j) * farr_get(zT, j)
            j = j + 1
        }
        let _ = farr_set(gate_out, e, acc)
        e = e + 1
    }
}

// ---------------------------------------------------------------
// 2. moe_softmax — numerically-stable in-place softmax over n entries
//   (subtract max, exp, normalize) → gate sums to 1.0
// ---------------------------------------------------------------
pub fn moe_softmax(gate: int, n: int) {
    let mut mx = farr_get(gate, 0)
    let mut i = 1
    while i < n {
        if farr_get(gate, i) > mx { mx = farr_get(gate, i) }
        i = i + 1
    }
    let mut tot = 0.0
    let mut i2 = 0
    while i2 < n {
        let ev = dt_exp(farr_get(gate, i2) - mx)
        let _ = farr_set(gate, i2, ev)
        tot = tot + ev
        i2 = i2 + 1
    }
    let mut i3 = 0
    while i3 < n {
        let _ = farr_set(gate, i3, farr_get(gate, i3) / tot)
        i3 = i3 + 1
    }
}

// ---------------------------------------------------------------
// 3. moe_argmax — top-1 expert index (hard-route diagnostic)
// ---------------------------------------------------------------
pub fn moe_argmax(gate: int, n: int) -> int {
    let mut best = 0
    let mut bestv = farr_get(gate, 0)
    let mut i = 1
    while i < n {
        let v = farr_get(gate, i)
        if v > bestv {
            bestv = v
            best = i
        }
        i = i + 1
    }
    return best
}

// ---------------------------------------------------------------
// 4. moe_expert_fwd — single expert e linear emission head
//   logits_out[k] = Σ_j experts[(e·V + k)·d + j] · zT[j]
//   (byte-identical shape to v3_head_g_fwd, offset by expert block)
// ---------------------------------------------------------------
pub fn moe_expert_fwd(zT: int, M: int, experts_off: int, e: int,
                      V: int, d: int, logits_out: int) {
    let base = experts_off + e * V * d
    let mut k = 0
    while k < V {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            acc = acc + farr_get(M, base + k * d + j) * farr_get(zT, j)
            j = j + 1
        }
        let _ = farr_set(logits_out, k, acc)
        k = k + 1
    }
}

// ---------------------------------------------------------------
// 5. moe_combine_soft — gate-weighted sum of all expert logits
//   logits_out[k] = Σ_e gate[e] · expert_e(zT)[k]
//   (soft routing — every expert contributes, weighted by its gate prob)
// ---------------------------------------------------------------
pub fn moe_combine_soft(zT: int, M: int, experts_off: int, gate: int,
                        n_experts: int, V: int, d: int, logits_out: int) {
    // zero the output first
    let mut z = 0
    while z < V {
        let _ = farr_set(logits_out, z, 0.0)
        z = z + 1
    }
    let scratch = farr_zeros(V)
    let mut e = 0
    while e < n_experts {
        let ge = farr_get(gate, e)
        moe_expert_fwd(zT, M, experts_off, e, V, d, scratch)
        let mut k = 0
        while k < V {
            let cur = farr_get(logits_out, k)
            let _ = farr_set(logits_out, k, cur + ge * farr_get(scratch, k))
            k = k + 1
        }
        e = e + 1
    }
    let _ = farr_free(scratch)
}

// ---------------------------------------------------------------
// 6. moe_route_fwd — full MoE forward: gate → softmax → soft combine
//   gate_out left populated (softmaxed) for caller's audit / top1.
// ---------------------------------------------------------------
pub fn moe_route_fwd(zT: int, M: int, router_off: int, experts_off: int,
                     n_experts: int, V: int, d: int,
                     gate_out: int, logits_out: int) {
    moe_gate_fwd(zT, M, router_off, n_experts, d, gate_out)
    moe_softmax(gate_out, n_experts)
    moe_combine_soft(zT, M, experts_off, gate_out, n_experts, V, d, logits_out)
}

// ---------------------------------------------------------------
// 7. moe_router_summary — one-line config string
// ---------------------------------------------------------------
pub fn moe_router_summary(n_experts: int, V: int, d: int) -> int {
    print("MoE-router [M4a]: n_experts=" + str(n_experts) + " · V=" + str(V) + " · d=" + str(d) + " · router=[E·d] experts=[E·V·d]")
    return n_experts
}
