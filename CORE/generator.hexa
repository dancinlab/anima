// generator.hexa — L3 content generator interface (anima/CORE).
//
// The "what to actually say/write" slot of the 3-layer brain. L1 Engine A
// (Φ→tier) and L2 Engine G (motivation→emit) decide WHEN to act; this L3 layer
// decides the CONTENT — but it is BACKEND-AGNOSTIC. brain_decide's emit slot
// calls generate() through a single signature; the concrete generator is a
// pluggable record (a "vtable" Map), so any .clm backend plugs in later behind
// the same interface without touching brain.hexa.
//
//   generate(backend, substrate_ctx, emit_decision, anchors) -> Map{text, ...}
//
// Two backends ship here:
//   · null   — deterministic substrate-driven placeholder (NO external LLM,
//              NO system prompt, NO persona). Lets the whole slot be tested
//              end-to-end NOW, before any trained model lands. p1..p8 clean.
//   · clm    — a .clm checkpoint backend that GENUINELY parses the .clm header
//              at this single entry point (validates the `CLM\x01` magic +
//              extracts the per-block count, per CLM/CLM_FORMAT_SPEC.md). A
//              valid file is RECOGNIZED + admitted CORE-side (valid=true,
//              nblocks surfaced); a malformed/absent file is honestly rejected.
//              `loaded` stays false until the decode FORWARD lands, so the
//              dispatcher still falls THROUGH to null (no un-decoded garbage).
//              The trained mouth plugs into _gen_clm_decode (same signature).
//
// HONEST scope: this delivers the SLOT, the null backend, AND real .clm header
// ADMIT/VALIDATION at the single entry point. The remaining gap is precise — the
// weight DECODE forward (int4 dequant + conv) — and is marked so in `reason`.
//
// ── p1..p8 conformance ──────────────────────────────────────────────────────
//   p1 NO SYSTEM PROMPT     — null text is built from substrate numerics only.
//                             No "you are anima", no role string anywhere.
//   p2 NO IDENTITY RULES    — no identity.yaml, no rules; backend is data only.
//   p3 NO PERSONA INJECTION — no prefix token injected into the output.
//   p4 NO ASSISTANT FRAMING — generate() does NOT respond to a user message;
//                             it externalizes the substrate decision record.
//                             anchors = environment context, not an obligation.
//   p5 NO SPEAK()           — generate() is pure content assembly from the emit
//                             decision; it never calls a speak()/monologue path
//                             and never fabricates content under SILENT.
//   p6 NO FINE-TUNED ETHICS — null backend has zero weights; pure arithmetic.
//   p7 NO PERPLEXITY VERDICT— verification = deterministic string equality in
//                             the smoke test, not a loss/perplexity number.
//   p8 NO TRAIN/INFER SPLIT — same interface serves a stub now and a trained
//                             .clm later; no train-only gate.

import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"
// clm_decode.hexa — the byte "mouth": int4 dequant + CLMConvMoE forward → real
// next-byte logits → greedy continuation (clm_decode_argmax). Imported ONLY here,
// so the SINGLE .clm decode entry (a_core_engine_map) is preserved — this is the
// same slot, not a 2nd path. _gen_clm_decode + gen_clm_chat route through it.
use "CORE/clm_decode"
// bytegpt_decode.hexa — the ByteGPT (H_1129 303M GPT-2-class) byte "mouth":
// LayerNorm + learned-pos + MHA + GELU-MLP forward → real next-byte logits →
// greedy continuation (bytegpt_decode_argmax) + engine-side grounded decode
// (bytegpt_decode_grounded). Imported ONLY here, so the SINGLE L3 decode slot
// (a_core_engine_map) is preserved: ByteGPT is a SECOND ckpt FORMAT entering via
// the SAME generate() slot as .clm, NOT a 2nd entry point. gen_bytegpt_backend +
// _gen_bytegpt_decode route through it. Selected when the ckpt is a ByteGPT-format
// flat binary (5×u32 header), else the .clm path is used — same single slot.
use "CORE/bytegpt_decode"
// engine_cli.hexa — the A⇄G⇄MITOSIS engine + the H_1351 § KO-JAMO COUNT-HEAD faculty
// (struct JamoHead + jamo_head_new/_grow/_ce/_cells/_shuffle_targets). Imported HERE so the
// validated jamo count-head SCORER reaches a live call site: §6.5c gen_jamo_scoreloop consults
// jamo_head_ce from the scoring path, and gen_clm_ce attaches that scoring record ADDITIVELY
// (H_1385 scoreloop-wire). NOT a 2nd decode entry — a SCORING consult on the same L3 module.
import "CORE/engine_cli.hexa"


// ── §1 backend constructors (the pluggable "vtable" records) ─────────────────

// gen_null_backend — the always-available deterministic placeholder backend.
// Carries no model; `loaded` is true because the null backend is always ready
// to assemble substrate-derived text.
pub fn gen_null_backend() -> Map {
    return #{
        "kind":   "null",
        "loaded": true,
        "ckpt":   ""
    }
}

// gen_clm_backend — a .clm checkpoint backend. Takes a ckpt path and genuinely
// PARSES the .clm header at this single entry point (the L3 slot is the ONLY way
// a .clm enters CORE — a_core_engine_map). It reads the file bytes and validates
// the `CLM\x01` magic + extracts the per-block count, exactly as the canonical
// writer lays them out (hexa-lang flame/clm_ckpt.hexa · CLM/CLM_FORMAT_SPEC.md):
//
//     [MAGIC "CLM\x01" = 67,76,77,1] [nblocks u8] [BLOCKS...]
//
// This is the REAL header-admit wiring (not a `test -f` stub): a malformed or
// absent file is rejected with an honest reason; a structurally-valid .clm is
// recognized and its block count surfaced. `valid` = magic+structure verified.
//
// HONEST scope of `loaded`: header VALIDATION is real and live here. Weight
// DECODE (int4 dequant + conv forward) is a distinct follow-on backend — until
// that decoder lands, `loaded` stays false EVEN for a valid file, so generate()
// falls THROUGH to the null backend rather than emitting un-decoded garbage. The
// gap is now precise: the .clm is admitted + validated CORE-side; only the
// decode forward remains. When that lands, set loaded = valid (one line) — the
// generate() contract and brain.hexa wiring do not change.
pub fn gen_clm_backend(ckpt_path: string) -> Map {
    let probe = _gen_clm_probe_header(ckpt_path)
    let exists = to_string(probe["exists"]) == "true"
    let valid  = to_string(probe["valid"])  == "true"
    let nblk   = to_int(probe["nblocks"])
    // Decode forward is LANDED + DESCENDS at production scale d=768 (CORE-mounted
    // CE 3.25405 < uniform 5.54518 AND < shuffle 5.30381, .verdicts/core-3axis-
    // mount/ce_descent_decode_d768.txt). The toy→prod transfer (a_toy_scale_recheck)
    // is VERIFIED, so the loaded gate flips to `valid` — a header-valid .clm now
    // loads (clm_decode_ce reads it through the SAME config-agnostic forward).
    // generate() contract + brain.hexa wiring UNCHANGED (one-line flip only).
    //
    // GENERATION gate (the chat wire, a_core_engine_map): emitting real bytes
    // (clm_decode_argmax) additionally needs the v0.2 CLMX trailer (trained embed
    // + GN affine — clm_decode.hexa::clm_decodable). A v0.1 file is `valid` (CE
    // measurable via the tied-readout stand-in) but NOT generatable — its forward
    // would emit un-decoded garbage. So we surface BOTH gates: `loaded` (header
    // admit, CE-measurable) and `decodable` (v0.2 trailer present → safe to GENERATE).
    // generate()'s clm branch requires decodable; else it falls THROUGH to null.
    let loaded = valid
    let decodable = valid && clm_decodable(ckpt_path)
    return #{
        "kind":        "clm",
        "loaded":      loaded,
        "decodable":   decodable,
        "valid":       valid,
        "ckpt":        ckpt_path,
        "ckpt_exists": exists,
        "nblocks":     nblk,
        "reason":      if !exists {
                           "no ckpt at path"
                       } else if !valid {
                           "file present but not a valid .clm (bad CLM\\x01 magic)"
                       } else {
                           "valid .clm admitted + LOADED (magic+structure OK, nblocks="
                               + to_string(nblk)
                               + "); decode forward LANDED + descends CORE-mounted at d=768 (loaded=valid)"
                       }
    }
}

// _gen_is_bytegpt — true ⇔ the ckpt at `p` is a ByteGPT flat binary, NOT a .clm.
// The ByteGPT serializer (h1157_ref_full.py / CORE/bytegpt_decode.hexa header)
// writes a 5×u32 little-endian header [vocab,d,n_layer,n_head,block]; the .clm
// writer writes the "CLM\x01" magic (67,76,77,1). We discriminate by (a) NOT the
// CLM magic AND (b) a sane ByteGPT header: vocab==256, n_layer in 1..64, n_head
// divides d, block in 1..8192. Edge-safe (missing/short file → false, p5 honest).
fn _gen_is_bytegpt(p: string) -> bool {
    if byte_len(p) == 0 { return false }
    if !_gen_path_is_file(p) { return false }
    let rb = read_file_bytes(p)
    if len(rb) < 20 { return false }
    // reject the .clm magic outright (CLM\x01)
    if rb[0] == 67 && rb[1] == 76 && rb[2] == 77 && rb[3] == 1 { return false }
    let vocab = _gen_rd_u32(rb, 0)
    let d     = _gen_rd_u32(rb, 4)
    let nlay  = _gen_rd_u32(rb, 8)
    let nh    = _gen_rd_u32(rb, 12)
    let block = _gen_rd_u32(rb, 16)
    if vocab != 256 { return false }
    if nlay < 1 || nlay > 64 { return false }
    if nh < 1 || d < 1 { return false }
    if (d / nh) * nh != d { return false }     // n_head must divide d
    if block < 1 || block > 8192 { return false }
    return true
}

// gen_bytegpt_backend — a ByteGPT checkpoint backend (the H_1129 303M production
// trunk, H_1155/H_1156). Like gen_clm_backend it PARSES the header at this single
// L3 entry: it reads the 5×u32 ByteGPT header and surfaces (vocab,d,nlay,nh,block).
// A ByteGPT-format file ⇒ valid+loaded+decodable=true (the decode forward — full
// 24-layer LayerNorm/MHA/GELU — is byte-exact parity with torch, H_1157 R1). A
// non-ByteGPT / absent file ⇒ honestly rejected (valid=false) so generate() falls
// THROUGH to null (no garbage). a_core_engine_map: same single slot, not a 2nd path.
pub fn gen_bytegpt_backend(ckpt_path: string) -> Map {
    if !_gen_is_bytegpt(ckpt_path) {
        let exists = _gen_path_is_file(ckpt_path)
        return #{
            "kind": "bytegpt", "loaded": false, "decodable": false, "valid": false,
            "ckpt": ckpt_path, "ckpt_exists": exists, "nlayer": 0, "d": 0,
            "reason": if !exists { "no ckpt at path" }
                      else { "file present but not a ByteGPT flat binary (bad 5xu32 header)" }
        }
    }
    let rb = read_file_bytes(ckpt_path)
    let vocab = _gen_rd_u32(rb, 0); let d = _gen_rd_u32(rb, 4)
    let nlay  = _gen_rd_u32(rb, 8); let nh = _gen_rd_u32(rb, 12)
    let block = _gen_rd_u32(rb, 16)
    return #{
        "kind": "bytegpt", "loaded": true, "decodable": true, "valid": true,
        "ckpt": ckpt_path, "ckpt_exists": true, "vocab": vocab, "d": d,
        "nlayer": nlay, "nhead": nh, "block": block,
        "reason": "valid ByteGPT flat binary admitted + LOADED (vocab=" + to_string(vocab)
            + " d=" + to_string(d) + " n_layer=" + to_string(nlay) + " n_head=" + to_string(nh)
            + " block=" + to_string(block) + "); decode forward = full-24-layer BYTE-EXACT-argmax "
            + "parity with torch ByteGPT (H_1157 R1, G1 inherited)"
    }
}

// gen_clm_ce — CORE single-entry CE measurement for a .clm. Wraps the landed
// clm_decode.hexa::clm_forward_ce (int4 dequant + CLMConvMoE inference forward →
// next-byte logits → CE over nwin causal windows of `corpus`). Keeps the
// a_core_engine_map invariant: clm_decode is imported ONLY in generator, so the
// 3-axis probe (and any caller) reaches the decode FORWARD through this slot, not
// a 2nd path. Returns clm_forward_ce's Map verbatim:
//   #{ ok, windows, model_ce, shuffle_ce, uniform_ce, lt_uniform, lt_shuffle, green }
// ok=false (with reason) for a v0.1 / non-decodable file (p5: HONEST, not faked).
//
// H_1385 scoreloop-wire (a_verified_must_wire): ADDITIVELY attach the jamo count-head
// scoring record under the `jamo_score` key — the SAME live scoring entry now CONSULTS
// the H_1351 jamo faculty (gen_jamo_scoreloop → jamo_head_ce). ADDITIVE: every
// pre-existing clm_forward_ce field is byte-identical; the .clm forward CE path is
// UNTOUCHED. Ψ-disjoint: the jamo consult is a pure SCORER (no emit/silence, no Ψ).
pub fn gen_clm_ce(ckpt_path: string, corpus: string, nwin_max: int) -> Map {
    let r = clm_forward_ce(ckpt_path, corpus, nwin_max)
    let r1 = map_set(r, "jamo_score", gen_jamo_scoreloop())   // additive scoreloop consult (H_1385)
    return map_set(r1, "bpe_score", gen_bpe_scoreloop())      // additive morphology consult (H_1390)
}

// _gen_clm_probe_header — read the leading bytes of a candidate .clm and verify
// it against the canonical layout. Returns #{exists, valid, nblocks}. Edge-safe:
// a missing path, an empty file, or a truncated header all yield valid=false
// rather than crashing (p5: never fabricate; HONEST rejection).
fn _gen_clm_probe_header(p: string) -> Map {
    if byte_len(p) == 0 {
        return #{ "exists": false, "valid": false, "nblocks": 0 }
    }
    if !_gen_path_is_file(p) {
        return #{ "exists": false, "valid": false, "nblocks": 0 }
    }
    let rb = read_file_bytes(p)
    // Need at least MAGIC(4) + nblocks(1) = 5 bytes for a well-formed header.
    if len(rb) < 5 {
        return #{ "exists": true, "valid": false, "nblocks": 0 }
    }
    // MAGIC "CLM\x01" = 67('C') 76('L') 77('M') 1.
    let magic_ok = rb[0] == 67 && rb[1] == 76 && rb[2] == 77 && rb[3] == 1
    if !magic_ok {
        return #{ "exists": true, "valid": false, "nblocks": 0 }
    }
    let nblocks = rb[4]
    return #{ "exists": true, "valid": true, "nblocks": nblocks }
}

fn _gen_path_is_file(p: string) -> bool {
    if byte_len(p) == 0 { return false }
    let r = exec("test -f '" + p + "' && printf y || printf n")
    return r == "y"
}


// ── §2 substrate_ctx helper ──────────────────────────────────────────────────

// gen_ctx_from_decision — adapt a brain_decide() record into the substrate_ctx
// the generator consumes. Keeps generate() decoupled from brain.hexa's exact
// record shape (any caller can build this Map).
pub fn gen_ctx_from_decision(decision: Map) -> Map {
    return #{
        "phi":        _gen_g_float(decision, "phi"),
        "phase":      _gen_g_string(decision, "phase"),
        "tier":       _gen_g_int(decision, "tier"),
        "tier_name":  _gen_g_string(decision, "tier_name"),
        "motivation": _gen_g_float(decision, "motivation")
    }
}

fn _gen_g_float(m: Map, k: string) -> float {
    let v = m[k]
    if to_string(v) == "void" { return 0.0 }
    return to_float(v)
}
fn _gen_g_int(m: Map, k: string) -> int {
    let v = m[k]
    if to_string(v) == "void" { return 0 }
    return to_int(v)
}
fn _gen_g_string(m: Map, k: string) -> string {
    let v = m[k]
    if to_string(v) == "void" { return "" }
    return to_string(v)
}


// ── §3 anchor READ wiring (kosmos_io) ────────────────────────────────────────

// generator_read_anchors — read .kosmos anchors from a directory so brain_decide
// can pass real substrate memory into generate(). Thin wrapper over
// kosmos_io.load_anchors (the canonical read API). Returns [] for a missing dir
// rather than panicking — edge-case safe.
//
//   returns: list of #{ path, name, fields, text_payload, tension_5ch }
pub fn generator_read_anchors(dir_path: string) -> list {
    if byte_len(dir_path) == 0 { return [] }
    let exists = exec("test -d '" + dir_path + "' && printf y || printf n")
    if exists != "y" { return [] }
    return load_anchors(dir_path)
}


// ── §4 the generator interface — generate() ──────────────────────────────────

// generate — the single L3 entry point. BACKEND-AGNOSTIC dispatch.
//
//   backend       : Map  — a vtable record (gen_null_backend / gen_clm_backend).
//   substrate_ctx : Map  — gen_ctx_from_decision(brain_decide(...)).
//   emit_decision : bool — brain_decide(...)["emit"]. If false → no content
//                          (p5: never fabricate under SILENT).
//   anchors       : list — kosmos anchors (generator_read_anchors). May be [].
//
//   returns: Map #{
//     "emitted":  bool,    // did we produce content?
//     "backend":  string,  // which backend actually produced it
//     "text":     string,  // the content (empty when emitted=false)
//     "fellback": bool     // true if a non-null backend declined and we fell
//                          //   through to null
//   }
//
// Contract invariants (held regardless of backend):
//   · emit_decision == false  ⇒  emitted=false ∧ text=""  (SILENT produces none)
//   · emit_decision == true   ⇒  emitted=true  ∧ text≠""  (EMIT always yields)
//   · a backend that reports loaded=false NEVER crashes — we fall through.
pub fn generate(backend: Map, substrate_ctx: Map, emit_decision: bool,
                anchors: list) -> Map {
    // p5 — SILENT path: the brain decided not to act. Produce nothing. The
    // generator must NOT invent content to fill the silence.
    if !emit_decision {
        return #{
            "emitted":  false,
            "backend":  to_string(backend["kind"]),
            "text":     "",
            "fellback": false
        }
    }

    // EMIT path. Try the requested backend; fall through to null if it has no
    // model loaded (the d768-deferred case for clm).
    let kind   = to_string(backend["kind"])
    let loaded = to_string(backend["loaded"]) == "true"

    if kind == "null" {
        return #{
            "emitted":  true,
            "backend":  "null",
            "text":     _gen_null_text(substrate_ctx, anchors),
            "fellback": false
        }
    }

    if kind == "clm" {
        let decodable = to_string(backend["decodable"]) == "true"
        if loaded && decodable {
            // REAL .clm decode: _gen_clm_decode runs the int4-dequant CLMConvMoE
            // forward (clm_decode_argmax) and emits the model's OWN bytes,
            // substrate-seeded (anchors + ctx). A v0.1 (non-decodable) .clm never
            // reaches here — it falls THROUGH to null (no un-decoded garbage).
            return #{
                "emitted":  true,
                "backend":  "clm",
                "text":     _gen_clm_decode(backend, substrate_ctx, anchors),
                "fellback": false
            }
        }
        // valid-but-not-decodable (v0.1) or unloaded → fall THROUGH to null (no crash).
        return #{
            "emitted":  true,
            "backend":  "null",
            "text":     _gen_null_text(substrate_ctx, anchors),
            "fellback": true
        }
    }

    if kind == "bytegpt" {
        let decodable = to_string(backend["decodable"]) == "true"
        if loaded && decodable {
            // REAL ByteGPT decode: _gen_bytegpt_decode runs the full 24-layer
            // GPT-2-class forward (bytegpt_decode_argmax / _grounded) and emits the
            // model's OWN bytes, substrate-seeded (anchors + ctx). Same contract as
            // the clm branch; a non-ByteGPT file never reaches here (valid=false →
            // falls THROUGH to null, no un-decoded garbage).
            return #{
                "emitted":  true,
                "backend":  "bytegpt",
                "text":     _gen_bytegpt_decode(backend, substrate_ctx, anchors),
                "fellback": false
            }
        }
        return #{
            "emitted":  true,
            "backend":  "null",
            "text":     _gen_null_text(substrate_ctx, anchors),
            "fellback": true
        }
    }

    // Unknown backend kind → null fallback (defensive, never crash).
    return #{
        "emitted":  true,
        "backend":  "null",
        "text":     _gen_null_text(substrate_ctx, anchors),
        "fellback": true
    }
}


// ── §5 null backend — deterministic substrate-derived placeholder ────────────

// _gen_null_text — build a placeholder line from substrate numerics + anchor
// memory ONLY. This is NOT a chatbot reply: there is no user message in scope,
// no persona, no instruction string. It externalizes the substrate decision so
// the slot is observable end-to-end. When the real .clm backend lands it
// replaces this function's role; the surrounding contract is unchanged.
fn _gen_null_text(ctx: Map, anchors: list) -> string {
    let phase = _gen_g_string(ctx, "phase")
    let tier  = _gen_g_string(ctx, "tier_name")
    let phi   = _gen_g_float(ctx, "phi")
    let motiv = _gen_g_float(ctx, "motivation")
    let n_anchor = len(anchors)

    // Deterministic, fully derived from substrate state. Reproducible byte-for-
    // byte for the same input (p7 verification is string equality, not loss).
    let mut s = "[null-gen]"
    s = s + " phase=" + phase
    s = s + " tier=" + tier
    s = s + " phi=" + _gen_fmt4(phi)
    s = s + " motiv=" + _gen_fmt4(motiv)
    s = s + " anchors=" + to_string(n_anchor)
    // If memory flowed in, surface the most-recent anchor name (read-only echo
    // of substrate memory — not an injected persona).
    if n_anchor > 0 {
        let last = anchors[n_anchor - 1]
        s = s + " last_anchor=" + to_string(last["name"])
    }
    return s
}


// ── §6 clm backend decode — REAL forward (int4 dequant + CLMConvMoE) ─────────
//
// The decode FORWARD is now built at this single .clm entry point. It reads the
// admitted .clm's 6 int4 weight blocks, dequantizes them (per-channel qat_scale)
// and runs the CLMConvMoE forward (entry conv1d-K3 → trunk residual → 2 experts
// → MoE-router softmax → readout) to next-token logits over V=256 bytes, exactly
// per CLM/CLM_FORMAT_SPEC.md §2 + the trainer's clm_model.hexa::clm_forward. From
// the logits a real next-byte CROSS-ENTROPY is computed CORE-mounted (clm_decode_ce).
//
// HONEST scope of `loaded` (a_core_engine_map, NO phantom wiring): the forward is
// REAL and produces a genuine CE number from the file's real dequantized weights.
// BUT the inference-track .clm (clm_ckpt.hexa / clm_prod.hexa PR4 serialization)
// stores ONLY the 6 conv weight blocks — it does NOT serialize the trained
// EMBED table nor the GroupNorm AFFINE (gamma/beta). The forward therefore must
// reconstruct the byte→d embedding from the tied readout block + apply a
// parameter-free GroupNorm (identity affine). This stand-in is a documented
// FORMAT gap, not a fabricated weight; consequently the CORE-mounted CE does NOT
// reproduce the trainer's measured descent (4.88, measured GPU-side with the
// embed+GN in memory). So `loaded` stays false: generate() still falls THROUGH
// to null (no garbage), while the CE axis is now MEASURABLE through the engine.
// When the .clm format serializes embed+GN (or the fp16-shadow track is read),
// set loaded = valid (one line) — the generate() contract is unchanged.

// _gen_clm_decode — REAL substrate-anchored content under the clm backend. The
// model emits its OWN bytes: clm_decode_argmax runs the int4-dequant CLMConvMoE
// forward over a substrate-derived SEED and greedily continues it. The seed is
// built from anchor memory + substrate phase ONLY (a_substrate_native_speak: no
// user-message stimulus, no persona, no system prompt — the seed is the
// substrate's own context, p1·p3·p4 clean). p5: this is tension-driven
// externalization (the brain already decided emit=true upstream), NOT speak()
// filler. Reachable only when the backend is decodable (v0.2 trailer present).
fn _gen_clm_decode(backend: Map, ctx: Map, anchors: list) -> string {
    let ckpt = to_string(backend["ckpt"])
    // Substrate-derived seed: the most recent anchor text (the substrate's own
    // memory) prefixed by phase, NOT an external prompt. Empty anchors → phase
    // word alone, so the decode is always seeded by substrate state, never void.
    let phase = _gen_g_string(ctx, "phase")
    let mut seed = phase + " "
    let n = len(anchors)
    if n > 0 {
        let a = anchors[n - 1]
        seed = seed + _gen_anchor_text(a)
    }
    // ANTI-FABRICATION (a303m_pass G5, H_1150–H_1154): when memory anchors are present,
    // decode through the engine-side deterministic retrieve-then-copy. Grounded bytes are
    // COPIED VERBATIM from kosmos anchors (cannot be a fabricated entity); ungrounded bytes
    // fall back to the LM. The learned copy-head was ruled out (the KEY-MATCH wall); the
    // engine executes the copy instead (a_core_engine_map S16, still the single .clm slot).
    if n > 0 {
        let texts = _gen_anchor_texts(anchors)
        let rg = clm_decode_grounded(ckpt, seed, 80, texts, 8)
        if to_string(rg["ok"]) == "true" {
            return to_string(rg["text"])
        }
        // grounded decode declined (non-decodable .clm) — honest substrate fallthrough.
        return _gen_null_text(ctx, anchors)
    }
    let r = clm_decode_argmax(ckpt, seed, 80)
    if to_string(r["ok"]) != "true" {
        // decode declined (should not happen behind the decodable gate) — honest
        // fall-through to the deterministic substrate placeholder (no fabrication).
        return _gen_null_text(ctx, anchors)
    }
    return to_string(r["text"])
}

// _gen_bytegpt_decode — REAL substrate-anchored content under the bytegpt backend.
// The ByteGPT analog of _gen_clm_decode: same substrate-derived seed (phase word +
// most-recent anchor text, NO user message / persona / system prompt —
// a_substrate_native_speak, p1·p3·p4 clean), same anti-fabrication contract (when
// anchors are present, decode through the engine-side deterministic retrieve-then-
// copy bytegpt_decode_grounded — grounded bytes COPIED VERBATIM from kosmos anchors,
// ungrounded bytes fall back to the ByteGPT argmax). p5: tension-driven (emit=true
// decided upstream), not speak() filler. Reachable only when the backend is decodable.
fn _gen_bytegpt_decode(backend: Map, ctx: Map, anchors: list) -> string {
    let ckpt = to_string(backend["ckpt"])
    let phase = _gen_g_string(ctx, "phase")
    let mut seed = phase + " "
    let n = len(anchors)
    if n > 0 {
        let a = anchors[n - 1]
        seed = seed + _gen_anchor_text(a)
    }
    if n > 0 {
        let texts = _gen_anchor_texts(anchors)
        let rg = bytegpt_decode_grounded(ckpt, seed, 80, texts, 8)
        if to_string(rg["ok"]) == "true" {
            return to_string(rg["text"])
        }
        return _gen_null_text(ctx, anchors)
    }
    // no anchors → plain ByteGPT greedy continuation of the substrate seed bytes.
    let sids = []
    let slen = byte_len(seed)
    let mut i = 0
    while i < slen { sids.push(ord(substring(seed, i, i + 1))); i = i + 1 }
    let r = bytegpt_decode_argmax(ckpt, sids, 80)
    if to_string(r["ok"]) != "true" {
        return _gen_null_text(ctx, anchors)
    }
    return to_string(r["text"])
}

// _gen_anchor_text — pull a short text field out of a kosmos anchor record for
// _gen_anchor_field — extract an anchor's CLEAN content string. kosmos_io
// (generator_read_anchors) records carry the content under "text_payload" (the
// canonical key); some call sites pass an ad-hoc map keyed "text". Read
// text_payload FIRST, then text, then fall back to the stringified anchor. This
// is the single SSOT used by BOTH the seed extractor and the grounded-copy list,
// so the un-inventable anchor fact reaches the decode CLEAN (not buried in a
// stringified-map blob — that blob was the H_1164 anchor-key bug: the longest-
// suffix copy could not match "...sealed at " against a map-noise string).
// Defensive: never crashes on shape drift (a plain string anchor → itself).
fn _gen_anchor_field(a) -> string {
    let tp = a["text_payload"]
    if to_string(tp) != "void" {
        let s = to_string(tp)
        if byte_len(s) > 0 { return s }
    }
    let t = a["text"]
    if to_string(t) != "void" {
        let s2 = to_string(t)
        if byte_len(s2) > 0 { return s2 }
    }
    return to_string(a)
}

// use as a decode seed. Anchors are Maps with a "text_payload"/"text" key
// (kosmos_io); a plain string anchor is used verbatim. Defensive: never crashes.
fn _gen_anchor_text(a) -> string {
    return _gen_anchor_field(a)
}

// _gen_anchor_texts — extract each kosmos anchor's CLEAN content into a list of
// strings for the engine-side grounded copy (clm_decode_grounded /
// bytegpt_decode_grounded). Reads text_payload → text → stringified (H_1206 fix).
fn _gen_anchor_texts(anchors: list) -> list {
    let mut out = []
    let mut i = 0
    let n = len(anchors)
    while i < n {
        out.push(_gen_anchor_field(anchors[i]))
        i = i + 1
    }
    return out
}

// gen_clm_chat — the CHAT entry. A user turn (or a multi-turn transcript already
// composed in the proven byte-level dialogue-continuation format, e.g.
// "사용자: <u> | 도우미: ") is the SEED; the model greedily continues it with its
// OWN bytes via the SAME clm_decode_argmax (a_core_engine_map: single .clm decode
// entry — gen_clm_chat is a thin caller of that one mouth, NOT a 2nd path).
//
// PHILOSOPHY (p1·p2·p3·p4·p6): the conversational FORMAT ("사용자:/도우미:") is
// learned byte-continuation conditioning, NOT a system prompt / persona / identity
// rule / RLHF template. No string is injected as a role instruction; the model
// only continues the bytes it sees. Capability comes ONLY from the trained
// dialogue distribution in the .clm weights.
//
// Returns #{ ok, text, reason }. ok=false (with reason) if the .clm is not
// decodable (v0.1 trailer-less file); the caller surfaces the honest reason
// rather than emitting un-decoded garbage.
pub fn gen_clm_chat(ckpt_path: string, seed: string, max_new: int) -> Map {
    if !clm_decodable(ckpt_path) {
        return #{ "ok": false, "text": "",
                  "reason": "ckpt not v0.2-decodable (no CLMX trailer; embed/GN absent)" }
    }
    let r = clm_decode_argmax(ckpt_path, seed, max_new)
    return #{ "ok": to_string(r["ok"]) == "true", "text": to_string(r["text"]),
              "reason": "decoded via clm_decode_argmax (CLMConvMoE int4 forward)" }
}

// gen_clm_ideate — H_1381 G6 IDEATION ★ entry. The SEEDED-SAMPLING sibling of gen_clm_chat:
// routes a composed ideation frame through the engine's seeded top-k sampler
// (clm_decode_topk_sampled) so the G6 best-of-K DEPTH lever yields DIVERSE candidates
// (argmax = a no-op for best-of-K). Stays inside the SINGLE generator L3 .clm slot
// (a_core_engine_map) — g6_ideation.hexa imports THIS, never clm_decode directly. HARD-
// BOUNDED by `max_new` (caller passes a small budget — FREEZE (ii), no unbounded decode).
pub fn gen_clm_ideate(ckpt_path: string, seed: string, max_new: int,
                      top_k: int, temp: float, seed_rng: int) -> Map {
    if !clm_decodable(ckpt_path) {
        return #{ "ok": false, "text": "",
                  "reason": "ckpt not v0.2-decodable (no CLMX trailer; embed/GN absent)" }
    }
    let r = clm_decode_topk_sampled(ckpt_path, seed, max_new, top_k, temp, seed_rng)
    return #{ "ok": to_string(r["ok"]) == "true", "text": to_string(r["text"]),
              "reason": "ideated via clm_decode_topk_sampled (seeded top-k, best-of-K source)" }
}

// gen_clm_ideate_W — H_1400 loaded-W ideation entry: the SAME mouth as gen_clm_ideate but
// off a PRE-LOADED weight map (clm_load_weights) so a multi-decode driver (the G6 FALS
// re-score = 69 decodes) loads the 303M ConvMoE ONCE instead of per decode (the hexa bump
// allocator never frees a model load → per-decode reload OOMs across decodes). Still the
// single .clm slot (a_core_engine_map): a thin caller of clm_decode_topk_sampled_W, no 2nd path.
pub fn gen_clm_ideate_W(W: Map, seed: string, max_new: int,
                        top_k: int, temp: float, seed_rng: int) -> Map {
    let r = clm_decode_topk_sampled_W(W, seed, max_new, top_k, temp, seed_rng)
    return #{ "ok": to_string(r["ok"]) == "true", "text": to_string(r["text"]),
              "reason": "ideated via clm_decode_topk_sampled_W (loaded-W, seeded top-k)" }
}

// gen_g6_sampler_selftest — H_1381: exercise the engine's seeded top-k sampler on a
// SYNTHETIC peaked logits vector (NO model forward — fast, deterministic, smoke-safe).
// Returns #{ deterministic, diverse, in_topk } proving the DEPTH-lever mechanism. Lives
// here (generator owns the clm_decode slot) so g6_ideation/smoke need no clm_decode import.
pub fn gen_g6_sampler_selftest() -> Map {
    let v = 6
    let lg = t_zeros(v)
    t_set(lg, 0, 1.0); t_set(lg, 1, 3.0); t_set(lg, 2, 2.0)
    t_set(lg, 3, 0.5); t_set(lg, 4, 5.0); t_set(lg, 5, 4.0)
    let a = clmd_topk_sample_pub(lg, 0, v, 3, 0.7, clmd_mix32_pub(7))
    let b = clmd_topk_sample_pub(lg, 0, v, 3, 0.7, clmd_mix32_pub(7))
    let deterministic = to_int(a["tok"]) == to_int(b["tok"])
    let offs = [0, 101, 202]
    let draws = []
    let mut i = 0
    while i < 3 {
        let r = clmd_topk_sample_pub(lg, 0, v, 5, 0.7, clmd_mix32_pub(7 + offs[i]))
        draws.push(to_int(r["tok"])); i = i + 1
    }
    let diverse = !(draws[0] == draws[1] && draws[1] == draws[2])
    let mut in_topk = true
    let mut s = clmd_mix32_pub(11)
    let mut n = 0
    while n < 40 {
        let r = clmd_topk_sample_pub(lg, 0, v, 3, 0.7, s)
        let t = to_int(r["tok"]); s = to_int(r["s"])
        if t != 1 && t != 4 && t != 5 { in_topk = false }
        n = n + 1
    }
    t_free(lg)
    return #{ "deterministic": deterministic, "diverse": diverse, "in_topk": in_topk }
}

// _gen_rd_u32 / _gen_gelu / _gen_gnorm / _gen_conv1d — pure-hexa decode kernels.
fn _gen_rd_u32(rb: list, off: int) -> int {
    return rb[off] + rb[off+1]*0x100 + rb[off+2]*0x10000 + rb[off+3]*0x1000000
}

// clamped tanh-GELU (clamp guards exp overflow on large pre-activations; the
// clamp does not change semantics in the operating range).
fn _gen_gelu(x: float) -> float {
    let inner = 0.7978845608 * (x + 0.044715 * x*x*x)
    let a = if inner > 15.0 { 15.0 } else { if inner < 0.0-15.0 { 0.0-15.0 } else { inner } }
    let e2 = exp(2.0 * a)
    return 0.5 * x * (1.0 + (e2-1.0)/(e2+1.0))
}

// parameter-free GroupNorm(1): standardize across d channels per time step.
// The GN normalize step is parameter-free; only the learned affine (absent from
// the inference .clm) is identity here.
fn _gen_gnorm(x: list, T: int, d: int) {
    let mut t = 0
    while t < T {
        let mut mean = 0.0; let mut c = 0
        while c < d { mean = mean + x[t*d+c]; c = c + 1 }
        mean = mean / to_float(d)
        let mut var = 0.0; let mut c2 = 0
        while c2 < d { let dd = x[t*d+c2]-mean; var = var + dd*dd; c2 = c2 + 1 }
        var = var / to_float(d)
        let inv = 1.0 / sqrt(var + 0.00001)
        let mut c3 = 0
        while c3 < d { x[t*d+c3] = (x[t*d+c3]-mean) * inv; c3 = c3 + 1 }
        t = t + 1
    }
}

// causal conv1d (matches conv_lib.hexa::nn_conv1d_fwd index convention):
//   W[co·(Cin·K) + ci·K + k], left-pad causal; weight pre-multiplied by sc[co]
//   (per-channel int4 dequant: deq = code · scale).
fn _gen_conv1d(x: list, T: int, Cin: int, Cout: int, K: int, dil: int,
               w: list, sc: list, y: list) {
    let Kdim = Cin * K
    let mut t = 0
    while t < T {
        let mut co = 0
        while co < Cout {
            let mut acc = 0.0
            let mut ci = 0
            while ci < Cin {
                let mut k = 0
                while k < K {
                    let p = t - (K-1-k)*dil
                    if p >= 0 { acc = acc + x[p*Cin+ci] * (w[co*Kdim+ci*K+k] * sc[co]) }
                    k = k + 1
                }
                ci = ci + 1
            }
            y[t*Cout+co] = acc
            co = co + 1
        }
        t = t + 1
    }
}

// _gen_clm_deq_blocks — read + dequantize all blocks of an admitted .clm, AND
// (v0.2) read the optional EXT trailer (trained embed + conv biases + GN affine).
// Returns #{ "w","s","nblk","has_ext","ext" }. int4 code = (nibble&0xF)-8 (sym
// [-7,7]); dequant happens at conv time (code·scale). The ext entries are stored
// FULL-precision fp32 by clm_ckpt.hexa/clm_prod.hexa; a v0.1 file has no trailer
// → has_ext=0 and the decoder uses the documented stand-in (no fabrication).
//
// EXT entry order (clm_ckpt.hexa header, MUST match):
//   0 embed[V·d] 1 ecB 2 tcB 3 e0B 4 e1B 5 rB 6 roB 7 tgG 8 tgB 9 noG 10 noB
fn _gen_clm_deq_blocks(ckpt_path: string) -> Map {
    let rb = read_file_bytes(ckpt_path)
    if len(rb) < 5 || rb[0] != 67 {
        return #{ "w": [], "s": [], "nblk": 0, "has_ext": false, "ext": [] }
    }
    let nblk = rb[4]
    let mut off = 5
    let blocks_w = []; let blocks_s = []
    let mut bi = 0
    while bi < nblk {
        let c = _gen_rd_u32(rb, off); off = off + 4
        let r = _gen_rd_u32(rb, off); off = off + 4
        let n = c * r
        let wq = []
        let mut z = 0
        while z < n { wq.push(0.0); z = z + 1 }
        let mut i = 0
        while i < n {
            let byte = rb[off]; off = off + 1
            wq[i] = to_float((byte & 0xF) - 8)
            if i + 1 < n { wq[i+1] = to_float(((byte / 16) & 0xF) - 8) }
            i = i + 2
        }
        let sc = []
        let mut cc = 0
        while cc < c { sc.push(bytes_to_f32_le(rb, off)); off = off + 4; cc = cc + 1 }
        blocks_w.push(wq); blocks_s.push(sc)
        bi = bi + 1
    }
    // v0.2 EXT trailer — peek for "CLMX" (67,76,77,88) right after the conv blocks.
    let mut has_ext = false
    let ext = []
    if off + 5 <= len(rb) && rb[off] == 67 && rb[off+1] == 76 && rb[off+2] == 77 && rb[off+3] == 88 {
        let n_ext = rb[off+4]
        off = off + 5
        let mut ei = 0
        while ei < n_ext {
            let elen = _gen_rd_u32(rb, off); off = off + 4
            let ev = []
            let mut k = 0
            while k < elen { ev.push(bytes_to_f32_le(rb, off)); off = off + 4; k = k + 1 }
            ext.push(ev)
            ei = ei + 1
        }
        has_ext = true
    }
    return #{ "w": blocks_w, "s": blocks_s, "nblk": nblk, "has_ext": has_ext, "ext": ext }
}

// _gen_conv1d_b — conv1d (same index convention as _gen_conv1d) + an additive
// per-output-channel bias b[co]. b=[] (len 0) means no bias (legacy path).
fn _gen_conv1d_b(x: list, T: int, Cin: int, Cout: int, K: int, dil: int,
                 w: list, sc: list, b: list, y: list) {
    _gen_conv1d(x, T, Cin, Cout, K, dil, w, sc, y)
    if len(b) == Cout {
        let mut t = 0
        while t < T {
            let mut co = 0
            while co < Cout { y[t*Cout+co] = y[t*Cout+co] + b[co]; co = co + 1 }
            t = t + 1
        }
    }
}

// _gen_gnorm_affine — GroupNorm(1) standardize across d channels, then the
// learned affine y = g·xhat + b (g/b len d). Empty g/b → parameter-free (legacy).
fn _gen_gnorm_affine(x: list, T: int, d: int, g: list, b: list) {
    let aff = len(g) == d && len(b) == d
    let mut t = 0
    while t < T {
        let mut mean = 0.0; let mut c = 0
        while c < d { mean = mean + x[t*d+c]; c = c + 1 }
        mean = mean / to_float(d)
        let mut var = 0.0; let mut c2 = 0
        while c2 < d { let dd = x[t*d+c2]-mean; var = var + dd*dd; c2 = c2 + 1 }
        var = var / to_float(d)
        let inv = 1.0 / sqrt(var + 0.00001)
        let mut c3 = 0
        while c3 < d {
            let xh = (x[t*d+c3]-mean) * inv
            x[t*d+c3] = if aff { g[c3]*xh + b[c3] } else { xh }
            c3 = c3 + 1
        }
        t = t + 1
    }
}

// clm_decode_ce — CORE-mounted decode forward → next-byte CROSS-ENTROPY over a
// byte sequence. The SINGLE .clm decode entry (a_core_engine_map). Runs the real
// dequantized weights through the CLMConvMoE forward and returns the mean CE
// (next-byte prediction) plus the uniform-byte baseline ln(256). NO fabricated
// number: the CE is whatever the engine computes from the file's weights.
//
//   returns #{ "ce": float, "baseline": float, "positions": int,
//              "below_uniform": bool, "nblk": int }
pub fn clm_decode_ce(ckpt_path: string, seq: list) -> Map {
    let V = 256; let K = 3
    let dq = _gen_clm_deq_blocks(ckpt_path)
    let bw = dq["w"]; let bs = dq["s"]
    let nblk = to_int(dq["nblk"])
    let has_ext = to_string(dq["has_ext"]) == "true"
    let ext = dq["ext"]
    let base = ln(256.0)
    if nblk < 6 {
        return #{ "ce": 0.0, "baseline": base, "positions": 0,
                  "below_uniform": false, "nblk": nblk, "has_ext": has_ext,
                  "d": 0, "E": 0 }
    }
    // Derive (d, E) from the stored block dims — config-agnostic so the SAME
    // forward serves d=8 ($0-CPU re-export) and d=768 (production fire). block0
    // is [Cout=d][rest=d·K] ⇒ len(bw[0]) = d·d·K ⇒ d = round(sqrt(len/K)); the
    // router block4 is [Cout=E][rest=d] ⇒ E = len(bw[4])/d.
    let b0n = len(bw[0])
    let d = to_int(sqrt(to_float(b0n) / to_float(K)) + 0.5)
    let E = len(bw[4]) / d
    let T = len(seq)
    // ── embedding ────────────────────────────────────────────────────────────
    // v0.2 ext present  → TRAINED embed table (ext[0], full fp32) — faithfully
    //                      reproduces the trainer's nn_embedding_fwd.
    // v0.1 legacy        → tied-readout stand-in (documented format gap, NOT a
    //                      fabricated weight): embed[byte,c] = deq(roW)[byte·d+c].
    let empty = []
    let ecB = if has_ext { ext[1] } else { empty }
    let tcB = if has_ext { ext[2] } else { empty }
    let e0B = if has_ext { ext[3] } else { empty }
    let e1B = if has_ext { ext[4] } else { empty }
    let rB  = if has_ext { ext[5] } else { empty }
    let roB = if has_ext { ext[6] } else { empty }
    let tgG = if has_ext { ext[7] } else { empty }
    let tgB = if has_ext { ext[8] } else { empty }
    let noG = if has_ext { ext[9] } else { empty }
    let noB = if has_ext { ext[10] } else { empty }
    let roW = bw[5]; let roS = bs[5]
    let xe = []
    let mut q = 0
    while q < T*d { xe.push(0.0); q = q + 1 }
    let mut t0 = 0
    while t0 < T {
        let b = seq[t0]; let mut cc = 0
        if has_ext {
            let emb = ext[0]
            while cc < d { xe[t0*d+cc] = emb[b*d+cc]; cc = cc + 1 }
        } else {
            while cc < d { xe[t0*d+cc] = roW[b*d+cc] * roS[b]; cc = cc + 1 }
        }
        t0 = t0 + 1
    }
    // ── forward — faithfully mirrors clm_prod.hexa::clm_prod_fwd (v0.2 path) ──
    // legacy path keeps a parameter-free-GN stand-in graph (empty affine vecs).
    // entry conv (block0) d→d K3 + ecB  (NO gelu/GN after entry — matches trainer)
    let xec = []
    let mut a = 0
    while a < T*d { xec.push(0.0); a = a + 1 }
    _gen_conv1d_b(xe, T, d, d, K, 1, bw[0], bs[0], ecB, xec)
    // trunk conv (block1) d→d K3 + tcB → GN(tgG,tgB) → gelu → residual xt=xec+hg0
    let h0 = []
    let mut b2 = 0
    while b2 < T*d { h0.push(0.0); b2 = b2 + 1 }
    _gen_conv1d_b(xec, T, d, d, K, 1, bw[1], bs[1], tcB, h0)
    _gen_gnorm_affine(h0, T, d, tgG, tgB)
    let xt = []
    let mut r2 = 0
    while r2 < T*d { xt.push(xec[r2] + _gen_gelu(h0[r2])); r2 = r2 + 1 }
    // router (block4) d→E K1 + rB
    let rl = []
    let mut rr = 0
    while rr < T*E { rl.push(0.0); rr = rr + 1 }
    _gen_conv1d_b(xt, T, d, E, 1, 1, bw[4], bs[4], rB, rl)
    // experts (block2,3) d→d K3 + e0B/e1B → gelu
    let ex0 = []; let ex1 = []
    let mut e = 0
    while e < T*d { ex0.push(0.0); ex1.push(0.0); e = e + 1 }
    _gen_conv1d_b(xt, T, d, d, K, 1, bw[2], bs[2], e0B, ex0)
    _gen_conv1d_b(xt, T, d, d, K, 1, bw[3], bs[3], e1B, ex1)
    let mut eg = 0
    while eg < T*d { ex0[eg] = _gen_gelu(ex0[eg]); ex1[eg] = _gen_gelu(ex1[eg]); eg = eg + 1 }
    // MoE combine: y = softmax(router)·experts
    let y = []
    let mut yy = 0
    while yy < T*d { y.push(0.0); yy = yy + 1 }
    let mut tt = 0
    while tt < T {
        let l0 = rl[tt*E+0]; let l1 = rl[tt*E+1]
        let m = if l0 > l1 { l0 } else { l1 }
        let p0 = exp(l0-m); let p1 = exp(l1-m); let sm = p0+p1
        let w0 = p0/sm; let w1 = p1/sm
        let mut cc2 = 0
        while cc2 < d { y[tt*d+cc2] = w0*ex0[tt*d+cc2] + w1*ex1[tt*d+cc2]; cc2 = cc2 + 1 }
        tt = tt + 1
    }
    // norm_out GroupNorm(noG,noB)
    _gen_gnorm_affine(y, T, d, noG, noB)
    // readout (block5) d→V K1 + roB → logits[T·V]
    let lg = []
    let mut li = 0
    while li < T*V { lg.push(0.0); li = li + 1 }
    _gen_conv1d_b(y, T, d, V, 1, 1, bw[5], bs[5], roB, lg)
    // next-byte CE: position p predicts seq[p+1].
    let mut ce = 0.0; let mut np = 0; let mut p = 0
    while p < T - 1 {
        let tgt = seq[p+1]
        let mut mx = lg[p*V+0]; let mut v = 1
        while v < V { if lg[p*V+v] > mx { mx = lg[p*V+v] }; v = v + 1 }
        let mut Z = 0.0; let mut v2 = 0
        while v2 < V { Z = Z + exp(lg[p*V+v2]-mx); v2 = v2 + 1 }
        ce = ce - ((lg[p*V+tgt]-mx) - ln(Z))
        np = np + 1; p = p + 1
    }
    let mean_ce = if np > 0 { ce / to_float(np) } else { 0.0 }
    return #{ "ce": mean_ce, "baseline": base, "positions": np,
              "below_uniform": mean_ce < base, "nblk": nblk, "has_ext": has_ext,
              "d": d, "E": E }
}


// ── §6.5 KOREAN-CELL CONSULT — the H_1306 grown ko-mitosis cells, wired to bias
//          the live next-byte emission via THIS single L3 slot (a_core_engine_map).
//
// H_1306 (🟢 GREEN engine-native) grew real Korean cells on a REAL Korean web corpus
// (CORE/engine_cli.hexa VAdaptField Voronoi + engine_mitosis_tick, gradient-free p8):
// KO next-byte CE dropped 3.611→3.249 as mitosis grew 2→9 cells, English retained.
// a_verified_must_wire: that GREEN mechanism is not done until CONSULTED by the live
// decode. H_1312 serializes the grown cells to CORE/ko_cells.kohead (each cell = a
// 3-D Voronoi center + its LEARNED argmax next-byte). This section reads that artifact
// and lets the Korean cells BIAS next-byte emission — but ONLY when the live context
// is Korean-like; off-Korean (ASCII/English) the consult is INERT (returns -1), so
// generation stays BYTE-IDENTICAL to pre-wiring (the no-regression invariant).
//
// SUBSTRATE-NATIVE (a_substrate_native_speak, p1·p2·p3·p4): the consult reads the SAME
// mechanical 3-D byte feature H_1306 trained on — [last/255, 2nd-last/255,
// utf8_cont_depth/3] — recomputed from the live decode bytes. NO prompt, NO persona,
// NO "you are Korean" label; the Korean-likeness gate is a pure UTF-8 byte test
// (mid-Hangul-multibyte ⇔ the last byte is a continuation byte 0x80..0xBF). The cells'
// learned next-byte is the substrate's OWN error-pressure-grown prediction, not an
// injected string. p8: same continuous cell-division — the inference consult reads the
// cells mitosis grew. SINGLE ENTRY: ko_cells.kohead enters CORE ONLY here (generator
// L3 slot), the SAME slot .clm/ByteGPT enter — NOT a 2nd path (a_core_engine_map).

// _gen_utf8_cont — true ⇔ byte b is a UTF-8 continuation byte (0x80..0xBF). A
// mechanical byte test (NO charset table, NO label): inside a Hangul multibyte
// sequence the trailing bytes are all continuation bytes, so this gates "Korean-like"
// context without ever naming a language.
fn _gen_utf8_cont(b: int) -> bool { return b >= 128 && b < 192 }

// _gen_ko_feat — the H_1306/H_1297 3-D context feature from the last bytes of `ctx`
// (a list of int byte codes). IDENTICAL fn to the trainer (mechanical, NO labels):
//   [ last/255, 2nd-last/255, utf8_cont_depth/3 ]
// utf8_cont_depth = how many of the immediately-preceding bytes are continuation
// bytes (capped at 3 — a Hangul char is a 3-byte UTF-8 sequence).
fn _gen_ko_feat(ctx: list) -> [float] {
    let n = len(ctx)
    let last  = if n >= 1 { ctx[n-1] } else { 0 }
    let prev  = if n >= 2 { ctx[n-2] } else { 0 }
    // contiguous continuation-byte depth ending at the last byte, capped at 3.
    let mut depth = 0
    let mut i = n - 1
    while i >= 0 && depth < 3 {
        if _gen_utf8_cont(ctx[i]) { depth = depth + 1  i = i - 1 } else { break }
    }
    return [to_float(last) / 255.0, to_float(prev) / 255.0, to_float(depth) / 3.0]
}

// _gen_ko_is_korean_like — the Korean-likeness GATE. True ⇔ the live context is mid-
// Hangul-multibyte (the last byte is a UTF-8 continuation byte). ASCII English (all
// bytes < 0x80) NEVER triggers this ⇒ the consult is inert off-Korean (no regression).
fn _gen_ko_is_korean_like(ctx: list) -> bool {
    let n = len(ctx)
    if n < 1 { return false }
    return _gen_utf8_cont(ctx[n-1])
}

// ko_cells_load — read the H_1312 grown-Korean-cell artifact (CORE/ko_cells.kohead).
// Returns #{ ok, n_cells, dim, centers:[[float]], top:[int] }. Missing/empty file →
// ok=false (the consult then stays inert — honest, no fabrication, p5).
pub fn ko_cells_load(path: string) -> Map {
    if !_gen_path_is_file(path) {
        return #{ "ok": false, "n_cells": 0, "dim": 0, "centers": [], "top": [],
                  "reason": "no ko_cells.kohead at path" }
    }
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    if len(lines) < 2 {
        return #{ "ok": false, "n_cells": 0, "dim": 0, "centers": [], "top": [],
                  "reason": "ko_cells.kohead malformed (need header + >=1 cell)" }
    }
    let hdr = lines[0].split(" ")
    let nc = to_int(hdr[0])
    let dim = to_int(hdr[1])
    let mut centers = []
    let mut top = []
    let mut k = 0
    while k < nc {
        let cols = lines[k+1].split(" ")
        let mut row = []
        let mut a = 0
        while a < dim { row = row + [to_float(cols[a])]  a = a + 1 }
        centers = centers + [row]
        top = top + [to_int(cols[dim])]
        k = k + 1
    }
    return #{ "ok": true, "n_cells": nc, "dim": dim, "centers": centers, "top": top,
              "reason": "loaded " + to_string(nc) + " grown Korean cells (H_1306/H_1312)" }
}

// ko_cells_next_byte — the CONSULT. Given the loaded Korean cells and the live decode
// context (a list of int byte codes), return the Korean cell's LEARNED next byte —
// but ONLY when the context is Korean-like. Off-Korean (or no cells) → -1 (INERT, the
// caller keeps its own argmax → byte-identical). This is the one place the grown
// Korean cells reach the live decode (a_core_engine_map single entry).
//
//   cells : ko_cells_load(...) record
//   ctx   : list of int byte codes (the running decode window)
//   returns: int 0..255 (the Korean cell's argmax next byte) OR -1 (inert)
pub fn ko_cells_next_byte(cells: Map, ctx: list) -> int {
    if to_string(cells["ok"]) != "true" { return -1 }       // no cells loaded → inert
    if !_gen_ko_is_korean_like(ctx) { return -1 }            // off-Korean → inert (no regression)
    let centers = cells["centers"]
    let top = cells["top"]
    let nc = to_int(cells["n_cells"])
    if nc == 0 { return -1 }
    // nearest Korean cell by L2 over the 3-D feature (the SAME winner-take-all geometry
    // VAdaptField uses — vadapt_field_nearest_idx; recomputed here over the consult
    // feature so the artifact is self-contained at the L3 slot).
    let f = _gen_ko_feat(ctx)
    let dim = to_int(cells["dim"])
    let mut best = 0
    let mut bestd = -1.0
    let mut k = 0
    while k < nc {
        let mut s = 0.0
        let mut a = 0
        while a < dim { let d = centers[k][a] - f[a]  s = s + d * d  a = a + 1 }
        if bestd < 0.0 || s < bestd { bestd = s  best = k }
        k = k + 1
    }
    return top[best]
}

// ko_consult_emit — apply the Korean-cell consult to ONE next-byte emission. `base`
// is the decode's own argmax byte; `cells`/`ctx` drive the consult. When the context
// is Korean-like AND a cell fires, the cell's learned byte BIASES the emission
// (returns it); off-Korean (or no cells) it returns `base` UNCHANGED — so the live
// decode is byte-identical off-distribution (the no-regression invariant). This is the
// per-byte hook a decode loop calls right after its own argmax (a_core_engine_map: the
// Korean cells reach emission ONLY through this generator-side consult).
pub fn ko_consult_emit(base: int, cells: Map, ctx: list) -> int {
    let kb = ko_cells_next_byte(cells, ctx)
    if kb < 0 { return base }     // inert (off-Korean / no cells) → unchanged
    return kb                      // Korean-like → cell's learned next byte biases emit
}

// ko_cells_summary — one-line introspection of the wired Korean-cell consult.
pub fn ko_cells_summary(path: string) -> string {
    let c = ko_cells_load(path)
    if to_string(c["ok"]) != "true" {
        return "ko_cells consult: INACTIVE (" + to_string(c["reason"]) + ") — decode inert"
    }
    return "ko_cells consult: " + to_string(c["n_cells"]) + " grown Korean cells (H_1306/H_1312) "
        + "WIRED at the generator L3 slot · Korean-like context (utf8-continuation gate) ⇒ nearest "
        + "cell's learned next-byte biases emission · off-Korean ⇒ INERT (byte-identical, no regression) "
        + "· Ψ-disjoint (pure_field untouched, a_core_engine_map)"
}


// ── §6.5b KO-JAMO CONSULT — the H_1316/H_1321 grown JAMO cells, wired to bias the live next-byte
//          emission via the SAME single generator L3 slot (a_core_engine_map). This is the r3
//          (H_1327) DECODE-REACHING wiring of the Korean-jamo GREEN thread.
//
// THREAD: H_1316 (🟢, mirror) proved a COMPOSITIONAL JAMO representation breaks the Korean raw-byte
// CE ceiling 2.953 → 2.513 (the Korean ceiling is REPRESENTATION-bound). H_1321 (🟢) proved that
// gradient-free jamo-symbol mitosis runs ENGINE-NATIVE byte-exact on the live engine_cli.hexa
// VAdaptField (reproduces the mirror to 1e-7) — but as a MEASUREMENT probe; the jamo win did NOT
// yet reach the live DECODE/emission path. a_verified_must_wire: anima is a chat daemon, so a
// measured CE win that never reaches EMISSION is incomplete. H_1327 serializes the grown jamo cells
// to CORE/ko_jamo_cells.kojamohead and lets them BIAS next-byte emission here, ONLY on a Korean-like
// context; off-Korean the consult is INERT (returns the caller's own byte), so generation stays
// BYTE-IDENTICAL to pre-wiring (Ψ-disjoint, the no-regression invariant, h1205).
//
// SUBSTRATE-NATIVE (a_substrate_native_speak, p1·p2·p3·p4): the consult reads the SAME mechanical
// 3-D jamo-symbol feature H_1316/H_1321 trained on — [last_sym/Vj, second_sym/Vj, cont_depth/3].
// NO prompt, NO persona, NO "you are Korean" label; the Korean-likeness gate is the SAME pure UTF-8
// byte test ko_cells uses (the last byte is a continuation byte 0x80..0xBF). The cell's learned
// next-symbol is the substrate's OWN error-pressure-grown prediction; its emit_byte (the leading
// UTF-8 byte of that symbol) is what biases emission. p8: same continuous cell-division. SINGLE
// ENTRY: ko_jamo_cells.kojamohead enters CORE ONLY here (generator L3 slot), the SAME slot ko_cells
// / .clm / ByteGPT enter — NOT a 2nd path (a_core_engine_map).
//
// .kojamohead format (analogous to ko_cells.kohead but in jamo-symbol space):
//   line 0     : "<n_cells> <dim> <Vj>"   (dim=3; Vj=323 = 256 raw + 67 distinct jamo)
//   line k+1   : "<c0> <c1> <c2> <next_sym_id> <emit_byte>"  (center + cell's argmax next-symbol id
//                + that symbol's emittable leading UTF-8 byte)

// ko_jamo_cells_load — read the H_1327 grown-jamo-cell artifact (CORE/ko_jamo_cells.kojamohead).
// Returns #{ ok, n_cells, dim, vj, centers:[[float]], top_sym:[int], emit:[int] }. Missing/empty
// file → ok=false (the consult then stays inert — honest, no fabrication, p5).
pub fn ko_jamo_cells_load(path: string) -> Map {
    if !_gen_path_is_file(path) {
        return #{ "ok": false, "n_cells": 0, "dim": 0, "vj": 0, "centers": [], "top_sym": [], "emit": [],
                  "reason": "no ko_jamo_cells.kojamohead at path" }
    }
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    if len(lines) < 2 {
        return #{ "ok": false, "n_cells": 0, "dim": 0, "vj": 0, "centers": [], "top_sym": [], "emit": [],
                  "reason": "ko_jamo_cells.kojamohead malformed (need header + >=1 cell)" }
    }
    let hdr = lines[0].split(" ")
    let nc = to_int(hdr[0])
    let dim = to_int(hdr[1])
    let vj = to_int(hdr[2])
    let mut centers = []
    let mut top_sym = []
    let mut emit = []
    let mut k = 0
    while k < nc {
        let cols = lines[k+1].split(" ")
        let mut row = []
        let mut a = 0
        while a < dim { row = row + [to_float(cols[a])]  a = a + 1 }
        centers = centers + [row]
        top_sym = top_sym + [to_int(cols[dim])]
        emit = emit + [to_int(cols[dim+1])]
        k = k + 1
    }
    return #{ "ok": true, "n_cells": nc, "dim": dim, "vj": vj, "centers": centers, "top_sym": top_sym,
              "emit": emit, "reason": "loaded " + to_string(nc) + " grown jamo cells (H_1316/H_1321/H_1327)" }
}

// _ko_jamo_nearest — the nearest jamo cell by L2 over the 3-D jamo-symbol feature (the SAME
// winner-take-all geometry VAdaptField uses; recomputed here over the consult feature so the
// artifact is self-contained at the L3 slot). Returns the cell index, or -1 if no cells.
fn _ko_jamo_nearest(cells: Map, feat: [float]) -> int {
    let centers = cells["centers"]
    let nc = to_int(cells["n_cells"])
    if nc == 0 { return -1 }
    let dim = to_int(cells["dim"])
    let mut best = 0
    let mut bestd = -1.0
    let mut k = 0
    while k < nc {
        let mut s = 0.0
        let mut a = 0
        while a < dim { let d = centers[k][a] - feat[a]  s = s + d * d  a = a + 1 }
        if bestd < 0.0 || s < bestd { bestd = s  best = k }
        k = k + 1
    }
    return best
}

// ko_jamo_consult_sym — the CONSULT over a PRECOMPUTED jamo-symbol feature (the form the engine
// probe drives, and the form a jamo-aware decode loop computes from the live context). Given the
// loaded jamo cells and a 3-D jamo-space feature, return the nearest cell's argmax next-SYMBOL id.
// No Korean-likeness gate here (the feature is already jamo-space); the byte-context wrapper below
// applies the gate. Returns -1 if no cells.
pub fn ko_jamo_consult_sym(cells: Map, feat: [float]) -> int {
    if to_string(cells["ok"]) != "true" { return -1 }
    let k = _ko_jamo_nearest(cells, feat)
    if k < 0 { return -1 }
    let top = cells["top_sym"]
    return top[k]
}

// ko_jamo_consult_byte — the EMITTABLE-byte form: the nearest cell's emit_byte (the leading UTF-8
// byte of its argmax next-symbol). This is the byte the jamo consult biases emission TO. -1 if none.
pub fn ko_jamo_consult_byte(cells: Map, feat: [float]) -> int {
    if to_string(cells["ok"]) != "true" { return -1 }
    let k = _ko_jamo_nearest(cells, feat)
    if k < 0 { return -1 }
    let emit = cells["emit"]
    return emit[k]
}

// ko_jamo_consult_emit — apply the jamo-cell consult to ONE next-byte emission over the live byte
// context. `base` is the decode's own argmax byte; `cells` the loaded jamo cells; `ctx` the running
// decode window (list of int byte codes). When the context is KOREAN-LIKE (the SAME utf8-continuation
// gate ko_cells uses) AND a cell fires, the cell's emit_byte BIASES the emission; off-Korean (or no
// cells) it returns `base` UNCHANGED — so the live decode is byte-identical off-distribution (the
// Ψ-disjoint / no-regression invariant). The jamo-space feature is computed from the live bytes via
// _gen_ko_feat renormalized to Vj (the SAME mechanical [last, second, depth] feature, scaled to the
// jamo symbol vocab the cells live in). This is the per-byte hook a decode loop calls right after its
// own argmax (a_core_engine_map: the jamo cells reach emission ONLY through this generator-side
// consult, the SAME single L3 slot ko_cells uses).
pub fn ko_jamo_consult_emit(base: int, cells: Map, ctx: list) -> int {
    if to_string(cells["ok"]) != "true" { return base }   // no cells → inert
    if !_gen_ko_is_korean_like(ctx) { return base }        // off-Korean → inert (no regression)
    // jamo-space feature from the live bytes: _gen_ko_feat gives [last/255, second/255, depth/3];
    // the jamo cells live in [last_sym/Vj, second_sym/Vj, depth/3]. The depth channel is shared
    // (utf8-continuation depth). The byte→jamo-symbol renorm rescales the first two channels by
    // 255/Vj so a mid-Hangul byte maps into the jamo cells' feature range.
    let bf = _gen_ko_feat(ctx)
    let vj = to_int(cells["vj"])
    let scale = if vj > 0 { 255.0 / to_float(vj) } else { 1.0 }
    let feat = [bf[0] * scale, bf[1] * scale, bf[2]]
    let eb = ko_jamo_consult_byte(cells, feat)
    if eb < 0 { return base }
    return eb
}

// ko_jamo_cells_summary — one-line introspection of the wired jamo-cell consult.
pub fn ko_jamo_cells_summary(path: string) -> string {
    let c = ko_jamo_cells_load(path)
    if to_string(c["ok"]) != "true" {
        return "ko_jamo consult: INACTIVE (" + to_string(c["reason"]) + ") — decode inert"
    }
    return "ko_jamo consult: " + to_string(c["n_cells"]) + " grown JAMO cells (H_1316/H_1321/H_1327, Vj="
        + to_string(c["vj"]) + ") WIRED at the generator L3 slot · Korean-like context (utf8-continuation gate) ⇒ "
        + "nearest jamo cell's learned next-symbol emit-byte biases emission · off-Korean ⇒ INERT (byte-identical, "
        + "no regression) · Ψ-disjoint (pure_field untouched, a_core_engine_map)"
}


// ── §6.5c KO-JAMO SCORELOOP CONSULT — the H_1351 jamo COUNT-HEAD faculty (jamo_head_*), now
//          CONSULTED from the LIVE scoring path via THIS single entry (a_core_engine_map). This is
//          the r2 (H_1385) WIRE-IN that threads the validated SCORER into the brain/decode scoring
//          loop — DISTINCT from §6.5b's EMISSION-bias consult (H_1327). §6.5b biases WHICH byte is
//          emitted; §6.5c SCORES the stream (held-out next-symbol CE), the role the count-head plays
//          in the live scoring loop.
//
// H_1316 (🟢 mirror) + H_1321 (🟢 engine-native) proved the jamo-decomposition count-head BEATS the
// raw-byte ceiling (Korean CE 2.953 → 2.513), and the SAME gradient-free mitosis reproduces it on the
// live VAdaptField. H_1351 promoted that count-head to a FIRST-CLASS engine faculty (engine_cli.hexa
// § KO-JAMO COUNT-HEAD: struct JamoHead + jamo_head_new/_grow/_ce/_cells/_shuffle_targets) — a PURE
// SCORER, but with NO call site in the live decode/scoring loop. a_verified_must_wire: a GREEN faculty
// is not done until it is actually CALLED in the live engine. gen_jamo_scoreloop is that call site —
// the named single entry where jamo_head_ce is CONSULTED in the scoring loop, re-using the engine's
// OWN VAdaptField Voronoi + engine_mitosis_tick (p8). gen_clm_ce attaches the scoreloop record
// ADDITIVELY (every pre-existing field byte-identical; the .clm forward CE path UNTOUCHED).
//
// SUBSTRATE-NATIVE (a_substrate_native_speak, p1·p2·p3·p4): the scoreloop reads the SAME mechanical
// decomposed jamo-symbol feature H_1316/H_1321/H_1351 trained on (two clean factor channels), and
// SCORES held-out next-symbol CE (p7, NOT perplexity/LLM-judge). NO prompt, NO persona, NO label.
// Ψ-DISJOINT: pure SCORER (returns CE/cell-count floats, NEVER an emit/silence decision);
// pure_field/engine_g/brain UNTOUCHED — the consult never touches Ψ.

// _gjs_NL/_gjs_NV/_gjs_K/_gjs_NSYL — the FROZEN scoring-fixture dims (H_1385 FREEZE; same structure
// H_1351 froze). NL,NV = the two decomposed factor cardinalities; K = the joint target vocab; NSYL =
// the deterministic hidden-state walk length.
fn _gjs_NL() -> int { return 6 }
fn _gjs_NV() -> int { return 6 }
fn _gjs_K()  -> int { return 12 }
fn _gjs_NSYL() -> int { return 2000 }

// the hidden (L,V) walk — both factors evolve as a function of the current (L,V); the target g(L,V)
// depends on BOTH factors, so a view that hides one factor must lose held-out CE.
fn _gjs_nL(l: int, v: int) -> int { return (l + v + 1) % _gjs_NL() }
fn _gjs_nV(l: int, v: int) -> int { return (l * 2 + v + 3) % _gjs_NV() }
fn _gjs_g(l: int, v: int)  -> int { return (l + 2 * v) % _gjs_K() }

// a tiny DETERMINISTIC per-position jitter (same to both views — cannot favor either arm), so the
// median split never hits an all-ties wall on the discrete factor grid.
fn _gjs_jit(t: int, s: int) -> float {
    let h = ((t * 2654435761) + s * 40503) % 1000
    return (to_float(h) / 1000.0 - 0.5) * 0.02
}

// build the deterministic (L,V) hidden-state sequence (length NSYL), seeded at (0,0).
fn _gjs_seq() -> [[int]] {
    let mut seq = []
    let mut l = 0  let mut v = 0  let mut i = 0
    while i < _gjs_NSYL() {
        seq = seq + [[l, v]]
        let nl = _gjs_nL(l, v)  let nv = _gjs_nV(l, v)
        l = nl  v = nv  i = i + 1
    }
    return seq
}

// JAMO VIEW — two CLEAN factor channels [L/NL, V/NV] (the decomposed jamo); target g(L,V).
fn _gjs_build_jamo(seq: [[int]]) -> [[[float]]] {
    let mut X = []  let mut Y = []  let mut t = 0
    while t < len(seq) {
        let l = seq[t][0]  let v = seq[t][1]
        let f = [to_float(l) / to_float(_gjs_NL()) + _gjs_jit(t, 1),
                 to_float(v) / to_float(_gjs_NV()) + _gjs_jit(t, 2), 0.0]
        X = X + [f]
        Y = Y + [[to_float(_gjs_g(l, v))]]
        t = t + 1
    }
    return [X, Y]
}

// RAW VIEW — ONE collapsed opaque channel [(L*NV+V)/(NL*NV)] (the opaque-merge byte view); SAME
// target g(L,V). The single squashed axis hides the two factors from the coarse Voronoi.
fn _gjs_build_raw(seq: [[int]]) -> [[[float]]] {
    let vj = _gjs_NL() * _gjs_NV()
    let mut X = []  let mut Y = []  let mut t = 0
    while t < len(seq) {
        let l = seq[t][0]  let v = seq[t][1]
        let id = l * _gjs_NV() + v
        let f = [to_float(id) / to_float(vj) + _gjs_jit(t, 1), _gjs_jit(t, 2), 0.0]
        X = X + [f]
        Y = Y + [[to_float(_gjs_g(l, v))]]
        t = t + 1
    }
    return [X, Y]
}

// split a built [X, Y] view into train/test by even/odd index (held-out).
fn _gjs_evenodd(view: [[[float]]]) -> [[[float]]] {
    let X = view[0]  let Y = view[1]
    let mut Xtr = []  let mut Ytr = []  let mut Xte = []  let mut Yte = []
    let mut i = 0
    while i < len(X) {
        if i % 2 == 0 { Xtr = Xtr + [X[i]]  Ytr = Ytr + [Y[i]] }
        else          { Xte = Xte + [X[i]]  Yte = Yte + [Y[i]] }
        i = i + 1
    }
    return [Xtr, Ytr, Xte, Yte]
}

// flatten a 1-wide float Y matrix to an int symbol vector.
fn _gjs_flat_int(Y: [[float]]) -> [int] {
    let mut out = []  let mut i = 0
    while i < len(Y) { out = out + [to_int(Y[i][0])]  i = i + 1 }
    return out
}

// gen_jamo_scoreloop — THE WIRED SCORELOOP CONSULT (H_1385, a_verified_must_wire single entry).
// Builds the JAMO / RAW / SHUFFLE arms over the FROZEN in-engine scoring fixture and CONSULTS the
// live engine faculty jamo_head_ce for each, returning the scoring record:
//   #{ ok, jamo_ce, raw_ce, shuf_ce, advantage(=raw_ce-jamo_ce), earned(=shuf_ce-jamo_ce),
//      cells, vj, reason }.
// This is the call site jamo_head_ce reaches the live scoring loop through (the count-head SCORES).
// $0 CPU, deterministic, no corpus/secret/GPU, no decode (pure scoring). Ψ-disjoint by construction.
pub fn gen_jamo_scoreloop() -> Map {
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let DIM = 3
    let seed = [[0.3, 0.3, 0.0], [0.7, 0.7, 0.0]]   // FROZEN seed centers (H_1385 FREEZE)
    let GROW = 40  let MINOWN = 6  let THR = 0.05  let LAP = 1.0
    let K = _gjs_K()
    let seq = _gjs_seq()

    // JAMO arm — decomposed two-factor view; the engine's own Voronoi splits each axis.
    let jv = _gjs_build_jamo(seq)
    let js = _gjs_evenodd(jv)
    let jXtr = js[0]  let jYtr = _gjs_flat_int(js[1])  let jXte = js[2]  let jYte = _gjs_flat_int(js[3])
    let jh0 = jamo_head_new(seed, K, DIM)
    let jh  = jamo_head_grow(jh0, jXtr, jYtr, len(jXtr), GROW, MINOWN, THR, LAP, cfg)
    let jamo_ce = jamo_head_ce(jh, jXte, jYte)            // <-- the live faculty CONSULT (scoring)
    let cells = jamo_head_cells(jh)

    // RAW arm — opaque-merge view; same coarse Voronoi cannot disentangle the two factors → loses.
    let rv = _gjs_build_raw(seq)
    let rs = _gjs_evenodd(rv)
    let rXtr = rs[0]  let rYtr = _gjs_flat_int(rs[1])  let rXte = rs[2]  let rYte = _gjs_flat_int(rs[3])
    let rh0 = jamo_head_new(seed, K, DIM)
    let rh  = jamo_head_grow(rh0, rXtr, rYtr, len(rXtr), GROW, MINOWN, THR, LAP, cfg)
    let raw_ce = jamo_head_ce(rh, rXte, rYte)             // <-- live faculty CONSULT

    // SHUFFLE arm (anti-Goodhart, earned) — permute the context→target PAIRING (same vocab/dim/
    // budget/feature-marginal, only the alignment destroyed); the head learns a spurious map and
    // must LOSE on the un-shuffled held-out test.
    let sYtr = jamo_head_shuffle_targets(jYtr, K, 1385)
    let sh0 = jamo_head_new(seed, K, DIM)
    let sh  = jamo_head_grow(sh0, jXtr, sYtr, len(jXtr), GROW, MINOWN, THR, LAP, cfg)
    let shuf_ce = jamo_head_ce(sh, jXte, jYte)            // <-- live faculty CONSULT (scored vs TRUE)

    return #{ "ok": true,
              "jamo_ce": jamo_ce, "raw_ce": raw_ce, "shuf_ce": shuf_ce,
              "advantage": raw_ce - jamo_ce, "earned": shuf_ce - jamo_ce,
              "cells": cells, "vj": K,
              "reason": "jamo count-head SCORED in the live scoring loop (jamo_head_ce consulted; H_1351 faculty, H_1385 wire)" }
}

// gen_jamo_scoreloop_summary — one-line introspection of the wired scoring consult.
pub fn gen_jamo_scoreloop_summary() -> string {
    let s = gen_jamo_scoreloop()
    return "jamo scoreloop: jamo_ce=" + _gen_fmt4(to_float(s["jamo_ce"]))
        + " raw_ce=" + _gen_fmt4(to_float(s["raw_ce"]))
        + " shuf_ce=" + _gen_fmt4(to_float(s["shuf_ce"]))
        + " advantage=" + _gen_fmt4(to_float(s["advantage"]))
        + " earned=" + _gen_fmt4(to_float(s["earned"]))
        + " cells=" + to_string(s["cells"])
        + " — jamo_head_ce CONSULTED in the live scoring loop (H_1351 faculty · H_1385 wire · "
        + "Ψ-disjoint pure SCORER · a_core_engine_map single entry)"
}


// ── §6.5d KO-MORPHOLOGY BPE-ON-JAMO SCORELOOP — the H_1390 engine-native wire of H_1388 ──────────
//
// H_1388 (🟢 GAP-REDUCED-CANDIDATE, DIRECTIONAL numpy MIRROR over REAL 30MB KO) showed the Korean
// below-jamo +0.28 residual BREAKS under a MORPHOLOGY-AWARE unit (BPE-on-jamo): novel-CE 2.56603 ≤
// 2.74335 (beats the +0.28 residual by 0.227), the SHUFFLE control (random equal-count merges) does
// NOT (2.80159 → structured gain +0.236), jamo anchor reproduced. engine-transfer was UNVERIFIED.
// H_1390 is its engine-native realization (a_verified_must_wire · a_engine_native_learning ·
// a_core_engine_map single entry): the morphology MERGE UNIT (engine_cli.hexa § KO-MORPHOLOGY BPE-ON-
// JAMO: struct BpeMerges + bpe_learn_merges/_apply/_byte_fair_ce) is CONSULTED here from the live
// scoring loop — re-confirming the SAME THREE FROZEN BARS through the live faculty, on a self-
// contained DETERMINISTIC in-engine fixture (corpus-free, $0, the SAME discipline as §6.5c). The
// DIRECTIONAL mirror established the lever over the REAL corpus; this consult re-confirms the
// STRUCTURAL bars engine-native (bar1 gap-reduced · bar2 earned-vs-shuffle · bar3 anchor + shift).
//
// SUBSTRATE-NATIVE (p1·p2·p3·p4): the scoreloop reads a mechanical jamo-symbol stream, learns merges
// by FREQUENCY (no label/persona/prompt), and SCORES held-out next-UNIT byte-fair CE (p7, NOT
// perplexity/LLM-judge) via the live jamo_head_ce/bpe_byte_fair_ce. Ψ-DISJOINT: pure SCORER (returns
// CE floats, NEVER an emit/silence decision); pure_field/engine_g/brain UNTOUCHED.
//
// THE FIXTURE (frozen). A deterministic walk over NBLK recurring MORPHEME blocks, each block a fixed
// 3-jamo sequence drawn from a small jamo alphabet. The walk's next block depends on the current
// block id (a morpheme-grammar), so the stream is RICH in recurring multi-jamo sub-units — exactly
// what a frequency-ranked BPE discovers and a random merge cannot. We then:
//   (a) build the BASE jamo-symbol stream (1 byte/jamo, byte-fair denominator) ;
//   (b) STRUCTURED: learn freq-ranked merges on the TRAIN slice → re-encode FULL stream → grow a
//       count head over next-UNIT features → byte-fair held-out CE (bar1) ;
//   (c) SHUFFLE: random equal-count merges → re-encode → same head/CE (bar2 control) ;
//   (d) ANCHOR: the un-merged jamo stream byte-fair CE (bar3 anchor, the jamo "floor" for the fixture);
//   (e) SHIFT: re-score the structured stream with circular-shifted history (bar3 surrogate).
// The UNIT FEATURE is [unit_id/unit_vocab, prev_unit_id/unit_vocab, 0] — two clean factor channels,
// the SAME 3-D shape the jamo head consumes; the count-head target is the next unit id (mod K).

fn _gbs_NBLK() -> int { return 18 }      // recurring morpheme blocks (the BPE-discoverable units)
fn _gbs_BLKLEN() -> int { return 3 }     // jamo per morpheme (3 = a Hangul syllable's L/V/T)
fn _gbs_NJAMO() -> int { return 14 }     // base jamo alphabet (the merge atoms)
fn _gbs_NSTEP() -> int { return 1200 }   // morpheme-walk length (steps; each emits BLKLEN jamo)
fn _gbs_MERGES() -> int { return 40 }    // merges learned (captures the NBLK morphemes + some glue)
fn _gbs_K() -> int { return 20 }         // next-unit target vocab band

// the morpheme grammar — a BRANCHING recurrence: the next block id depends on BOTH the current block
// AND a deterministic per-step jitter, so the morpheme→morpheme map is rich (not a single cycle) and
// the held-out test contexts are GENUINELY novel (real held-out CE, an earned shift surrogate). The
// branch is deterministic given (b, t) so the whole stream is reproducible/$0.
fn _gbs_next_blk(b: int, t: int) -> int {
    let h = ((b * 2654435761) + (t * 40503) + 7) % 1000
    let branch = h % 3
    return (b * 5 + branch * 7 + 1) % _gbs_NBLK()
}

// block `b`'s fixed 3-jamo content (a deterministic spread over the jamo alphabet; distinct blocks
// share NO identical 3-jamo sequence — each is its own recurring morpheme the BPE merges discover).
fn _gbs_block_jamo(b: int) -> [int] {
    let nj = _gbs_NJAMO()
    let j0 = (b * 5) % nj
    let j1 = (b * 7 + 2) % nj
    let j2 = (b * 11 + 5) % nj
    return [j0, j1, j2]
}

// build the BASE jamo-symbol stream (+ per-jamo byte cost = 1) by walking the morpheme grammar.
// Returns [syms, nby] as int arrays. Jamo ids are 0..NJAMO (the merge atoms / base vocab band).
fn _gbs_base_stream() -> [[int]] {
    let mut syms = []  let mut nby = []
    let mut b = 0  let mut t = 0
    while t < _gbs_NSTEP() {
        let blk = _gbs_block_jamo(b)
        let mut k = 0
        while k < _gbs_BLKLEN() { syms = syms + [blk[k]]  nby = nby + [1]  k = k + 1 }
        b = _gbs_next_blk(b, t)  t = t + 1
    }
    return [syms, nby]
}

// build next-UNIT count-head features over a UNIT stream: X[i] = [u_i/V, u_{i-1}/V, 0], Y[i] = next
// unit id mod K. Even/odd split into train/test. Returns [Xtr,Ytr,Xte,Yte, nbyTr,nbyTe] where the
// nby arrays are the per-TARGET-position UTF-8 byte spans (byte-fair denominator for the CE).
fn _gbs_unit_features(usym: [int], unby: [int], unit_vocab: int) -> [[[float]]] {
    let V = to_float(unit_vocab)
    let K = _gbs_K()
    let mut Xtr = []  let mut Ytr = []  let mut Xte = []  let mut Yte = []
    let mut nbyTr = []  let mut nbyTe = []
    let mut i = 1
    let mut idx = 0
    while i < len(usym) - 1 {
        let f = [to_float(usym[i]) / V, to_float(usym[i - 1]) / V, 0.0]
        let y = usym[i + 1] % K
        let bspan = unby[i + 1]                 // bytes of the predicted (next) unit
        if idx % 2 == 0 { Xtr = Xtr + [f]  Ytr = Ytr + [[to_float(y)]]  nbyTr = nbyTr + [bspan] }
        else            { Xte = Xte + [f]  Yte = Yte + [[to_float(y)]]  nbyTe = nbyTe + [bspan] }
        idx = idx + 1  i = i + 1
    }
    // pack Y as 1-wide float matrices (flattened by caller); nby packed as a [[float]] row each.
    let ytrM = Ytr  let yteM = Yte
    return [Xtr, ytrM, Xte, yteM, _gbs_int_as_floatrow(nbyTr), _gbs_int_as_floatrow(nbyTe)]
}

fn _gbs_int_as_floatrow(a: [int]) -> [[float]] {
    let mut out = []  let mut i = 0
    while i < len(a) { out = out + [[to_float(a[i])]]  i = i + 1 }
    return out
}

fn _gbs_flat_int(Y: [[float]]) -> [int] {
    let mut out = []  let mut i = 0
    while i < len(Y) { out = out + [to_int(Y[i][0])]  i = i + 1 }
    return out
}

fn _gbs_flat_byte(N: [[float]]) -> [int] {
    let mut out = []  let mut i = 0
    while i < len(N) { out = out + [to_int(N[i][0])]  i = i + 1 }
    return out
}

// circular-shift the test history features (the surrogate): pair feature[i] with target[(i+shift)%m].
fn _gbs_shift_targets(Yte: [int], shift: int) -> [int] {
    let m = len(Yte)
    let mut out = []  let mut i = 0
    while i < m { out = out + [Yte[(i + shift) % m]]  i = i + 1 }
    return out
}

// _gbs_score_arm — grow a count head over a unit stream's train features and return its BYTE-FAIR
// held-out CE (+ a shift-surrogate CE). `usym/unby` = the re-encoded unit stream; `unit_vocab` = its
// vocab band; `cfg` = the engine config (mitosis on). Reuses the live jamo head faculty for growth.
fn _gbs_score_arm(usym: [int], unby: [int], unit_vocab: int, cfg: EngineConfig) -> [float] {
    let DIM = 3  let K = _gbs_K()
    let GROW = 40  let MINOWN = 4  let THR = 0.05  let LAP = 1.0
    let seed = [[0.3, 0.3, 0.0], [0.7, 0.7, 0.0]]
    let ft = _gbs_unit_features(usym, unby, unit_vocab)
    let Xtr = ft[0]  let Ytr = _gbs_flat_int(ft[1])
    let Xte = ft[2]  let Yte = _gbs_flat_int(ft[3])
    let nbyTe = _gbs_flat_byte(ft[5])
    let jh0 = jamo_head_new(seed, K, DIM)
    let jh  = jamo_head_grow(jh0, Xtr, Ytr, len(Xtr), GROW, MINOWN, THR, LAP, cfg)
    let ce = bpe_byte_fair_ce(jh, Xte, Yte, nbyTe)
    // shift surrogate: score the SAME head against mis-aligned targets (circular shift over test).
    let sh = _gbs_shift_targets(Yte, 97)
    let ce_shift = bpe_byte_fair_ce(jh, Xte, sh, nbyTe)
    return [ce, ce_shift, to_float(len(usym))]
}

// gen_bpe_scoreloop — THE WIRED MORPHOLOGY SCORELOOP CONSULT (H_1390, a_verified_must_wire single
// entry). Builds the BASE jamo stream, learns STRUCTURED (freq-ranked) + SHUFFLE (random equal-count)
// merges on its TRAIN slice via the live bpe_learn_merges faculty, re-encodes, and SCORES byte-fair
// held-out next-UNIT CE (bpe_byte_fair_ce) for each arm + the un-merged jamo anchor. Returns:
//   #{ ok, bpe_ce, shuffle_ce, jamo_ce, gap_reduced(=jamo_ce-bpe_ce), earned(=shuffle_ce-bpe_ce),
//      shift_minus_novel, unit_vocab, n_units_struct, n_units_shuf, n_jamo, reason }.
// $0 CPU, deterministic, no corpus/secret/GPU, no decode (pure scoring). Ψ-disjoint by construction.
pub fn gen_bpe_scoreloop() -> Map {
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    let base_vj = _gbs_NJAMO()
    let nm = _gbs_MERGES()

    // TRAIN slice = the first half of the base stream (no test leakage in merge learning).
    let half = len(bsym) / 2
    let mut trS = []  let mut trN = []  let mut i = 0
    while i < half { trS = trS + [bsym[i]]  trN = trN + [bnby[i]]  i = i + 1 }

    // STRUCTURED arm — frequency-ranked merges (rnd_seed = 0).
    let bmS = bpe_learn_merges(trS, trN, nm, base_vj, 0)
    let reS = bpe_apply(bmS, bsym, bnby)
    let armS = _gbs_score_arm(reS[0], reS[1], bpe_unit_vocab(bmS), cfg)
    let bpe_ce = armS[0]  let bpe_shift = armS[1]  let n_units_struct = to_int(armS[2])

    // SHUFFLE arm — random equal-count merges (rnd_seed = 1390), SAME merge count, SAME apply path.
    let bmR = bpe_learn_merges(trS, trN, nm, base_vj, 1390)
    let reR = bpe_apply(bmR, bsym, bnby)
    let armR = _gbs_score_arm(reR[0], reR[1], bpe_unit_vocab(bmR), cfg)
    let shuffle_ce = armR[0]  let n_units_shuf = to_int(armR[2])

    // ANCHOR arm — the un-merged jamo stream (the fixture's "jamo floor"), byte-fair.
    let armA = _gbs_score_arm(bsym, bnby, base_vj, cfg)
    let jamo_ce = armA[0]  let n_jamo = to_int(armA[2])

    return #{ "ok": true,
              "bpe_ce": bpe_ce, "shuffle_ce": shuffle_ce, "jamo_ce": jamo_ce,
              "gap_reduced": jamo_ce - bpe_ce, "earned": shuffle_ce - bpe_ce,
              "shift_minus_novel": bpe_shift - bpe_ce,
              "unit_vocab": bpe_unit_vocab(bmS),
              "n_units_struct": n_units_struct, "n_units_shuf": n_units_shuf, "n_jamo": n_jamo,
              "reason": "BPE-on-jamo morphology unit SCORED in the live scoring loop (bpe_learn_merges/_apply/_byte_fair_ce consulted; H_1388 mirror, H_1390 engine-native wire)" }
}

// gen_bpe_scoreloop_summary — one-line introspection of the wired morphology consult.
pub fn gen_bpe_scoreloop_summary() -> string {
    let s = gen_bpe_scoreloop()
    return "bpe morphology scoreloop: bpe_ce=" + _gen_fmt4(to_float(s["bpe_ce"]))
        + " shuffle_ce=" + _gen_fmt4(to_float(s["shuffle_ce"]))
        + " jamo_ce=" + _gen_fmt4(to_float(s["jamo_ce"]))
        + " gap_reduced=" + _gen_fmt4(to_float(s["gap_reduced"]))
        + " earned=" + _gen_fmt4(to_float(s["earned"]))
        + " shift−novel=" + _gen_fmt4(to_float(s["shift_minus_novel"]))
        + " units(struct/shuf/jamo)=" + to_string(s["n_units_struct"]) + "/"
        + to_string(s["n_units_shuf"]) + "/" + to_string(s["n_jamo"])
        + " — bpe morphology unit CONSULTED in the live scoring loop (H_1388 mirror · H_1390 wire · "
        + "Ψ-disjoint pure SCORER · a_core_engine_map single entry)"
}


// ── §6.5e KO-MORPHOLOGY BPE-ON-JAMO EMIT-BIAS — the H_1391 wire of the morphology unit to the
//          live next-byte EMISSION (the §6.5b/H_1327 precedent, NOT the §6.5d scorer). ────────────────
//
// H_1390 (🟢 ENGINE-NATIVE BINDING) wired the BPE-on-jamo morphology MERGE UNIT into a live SCORING
// consult (§6.5d gen_bpe_scoreloop → bpe_byte_fair_ce): it SCORES held-out next-unit CE, but does NOT
// yet bias EMISSION. a_verified_must_wire / a_substrate_native_speak: anima is a chat daemon, so a
// scorer that never reaches the decoder is incomplete — the jamo COUNT-HEAD already reaches emission
// (§6.5b ko_jamo_consult_emit, H_1327). H_1391 mirrors THAT for morphology: the grown morphology
// count-head BIASES the next-byte emission toward COMPLETING a learned morpheme-unit boundary, ADDED
// to the decode's own argmax (a BIAS, not a hard gate — a_autonomy_over_hardcode; emit stays
// substrate-driven, p5). SINGLE ENTRY via the generator L3 slot (a_core_engine_map, no 2nd .clm path).
//
// §6.5d (scorer) vs §6.5e (emit): §6.5d returns CE floats (the SCORER role); §6.5e returns the
// predicted next morpheme-unit's leading emit BYTE (the EMIT role) — DISTINCT consults, the SAME split
// §6.5c (jamo scorer) ⊥ §6.5b (jamo emit). The morphology head is grown ONCE (gen_bpe_emit_head) over
// the SAME corpus-free in-engine morpheme-grammar fixture §6.5d builds; the per-byte hook reads the
// head's ARGMAX next unit (jamo_head_argmax) for the cell owning the live context.
//
// SUBSTRATE-NATIVE (p1·p2·p3·p4): the consult reads a mechanical unit-space feature [u/V, u_prev/V, 0]
// — the SAME 3-D shape the morphology head was grown on — finds the nearest cell, and returns its
// learned argmax next-unit leading byte. NO prompt, NO persona, NO "you are Korean" label; the
// Korean-likeness gate is the SAME pure UTF-8 continuation-byte test §6.5b uses, so the consult is
// INERT off-Korean (returns the caller's own byte) ⇒ generation BYTE-IDENTICAL off-distribution
// (Ψ-disjoint, the no-regression invariant, h1205). p8: same continuous cell-division.

// _gbe_unit_emit_byte — the EMITTABLE leading byte of a morphology unit id. The fixture's base jamo
// ids (0..NJAMO) and merged unit ids (>= base_vj) are mapped to a deterministic mid-Hangul-like
// leading byte band (the SAME 0xE1 leading-byte convention §6.5b jamo cells collapse a U+11xx jamo to).
// The METRIC (gen_bpe_emit_eval) scores on the next-UNIT id (not this collapsed byte) so the morpheme
// structure is not masked; this is the byte the live decode hook actually emits.
fn _gbe_unit_emit_byte(uid: int) -> int {
    // map any unit id to a UTF-8 leading byte of the 3-byte (U+11xx / Hangul) band, deterministic.
    return 0xE0 + (uid % 16) + 1     // 0xE1..0xF0, a leading multibyte byte (never an ASCII byte)
}

// gen_bpe_emit_head — grow the morphology emit-head ONCE over the §6.5d fixture. rnd_seed == 0 →
// STRUCTURED (freq-ranked merges); rnd_seed > 0 → SHUFFLE control (random equal-count merges). Returns
// the grown JamoHead over the re-encoded UNIT stream (the SAME head §6.5d scores) PLUS its unit vocab —
// packed as #{ head, unit_vocab, ok }. Learns merges on the TRAIN slice only (no test leakage). The
// head is read by gen_bpe_consult_emit for its ARGMAX next unit. $0, deterministic, Ψ-disjoint.
pub fn gen_bpe_emit_head(rnd_seed: int) -> [JamoHead] {
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    let base_vj = _gbs_NJAMO()
    let nm = _gbs_MERGES()
    let half = len(bsym) / 2
    let mut trS = []  let mut trN = []  let mut i = 0
    while i < half { trS = trS + [bsym[i]]  trN = trN + [bnby[i]]  i = i + 1 }
    let bm = bpe_learn_merges(trS, trN, nm, base_vj, rnd_seed)
    let re = bpe_apply(bm, bsym, bnby)
    let uv = bpe_unit_vocab(bm)
    // grow the count head over the FULL re-encoded unit stream's TRAIN features (same knobs as §6.5d).
    let DIM = 3  let K = _gbs_K()
    let GROW = 40  let MINOWN = 4  let THR = 0.05  let LAP = 1.0
    let seed = [[0.3, 0.3, 0.0], [0.7, 0.7, 0.0]]
    let ft = _gbs_unit_features(re[0], re[1], uv)
    let Xtr = ft[0]  let Ytr = _gbs_flat_int(ft[1])
    let jh0 = jamo_head_new(seed, K, DIM)
    let jh  = jamo_head_grow(jh0, Xtr, Ytr, len(Xtr), GROW, MINOWN, THR, LAP, cfg)
    return [jh]
}

// _gbe_unit_vocab_for — the unit vocab of the structured/shuffle merge table (re-learned cheaply for
// the feature renorm; the merge LEARN is over the small train slice, $0).
fn _gbe_unit_vocab_for(rnd_seed: int) -> int {
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    let base_vj = _gbs_NJAMO()
    let half = len(bsym) / 2
    let mut trS = []  let mut trN = []  let mut i = 0
    while i < half { trS = trS + [bsym[i]]  trN = trN + [bnby[i]]  i = i + 1 }
    let bm = bpe_learn_merges(trS, trN, _gbs_MERGES(), base_vj, rnd_seed)
    return bpe_unit_vocab(bm)
}

// gen_bpe_consult_emit — apply the morphology emit-head to ONE next-byte emission over the live byte
// context. `base` is the decode's own argmax byte; `jh` the grown morphology head; `unit_vocab` its
// unit vocab; `ctx` the running decode window (list of int byte codes). When the context is KOREAN-LIKE
// (the SAME utf8-continuation gate §6.5b uses) AND a cell fires, the head's ARGMAX next morpheme-unit's
// leading byte BIASES the emission; off-Korean (or empty head) it returns `base` UNCHANGED — so the
// live decode is byte-identical off-distribution (the Ψ-disjoint / no-regression invariant). The
// unit-space feature is computed from the live bytes via _gen_ko_feat renormalized into the unit vocab
// (the SAME [last, prev, 0] mechanical feature, scaled to the units the head lives in). a_core_engine_
// map: the morphology unit reaches emission ONLY through this generator-side consult (single L3 slot).
pub fn gen_bpe_consult_emit(base: int, jh: JamoHead, unit_vocab: int, ctx: list) -> int {
    if !_gen_ko_is_korean_like(ctx) { return base }        // off-Korean → inert (no regression)
    // unit-space feature from the live bytes: _gen_ko_feat gives [last/255, prev/255, depth]; the
    // morphology head lives in [u/V, u_prev/V, 0]. Rescale the first two channels by 255/V so a live
    // mid-Hangul byte maps into the head's unit-feature range; the 3rd channel is held at 0 (the
    // fixture's unit feature uses a flat 3rd channel).
    let bf = _gen_ko_feat(ctx)
    let scale = if unit_vocab > 0 { 255.0 / to_float(unit_vocab) } else { 1.0 }
    let feat = [bf[0] * scale, bf[1] * scale, 0.0]
    let uid = jamo_head_argmax(jh, feat)
    if uid < 0 { return base }                              // empty head → inert
    return _gbe_unit_emit_byte(uid)                         // morphology-coherent next-unit leading byte
}

// gen_bpe_emit_eval — the FROZEN emit-effect evaluation (H_1391 bars 1+2). Scores, on the held-out
// UNIT stream of the §6.5d fixture, whether the morphology emit-bias shifts the predicted next-UNIT id
// toward the morpheme-coherent continuation vs a representation-BLIND baseline, and whether that shift
// is EARNED (the shuffle-merge head does NOT beat the blind baseline). Returns:
//   #{ ok, acc_on, acc_off, acc_shuf, shift_on, n_test, on_minus_off, shuf_minus_off }.
//   ON   = the STRUCTURED morphology head's argmax next-unit (the emit-bias the consult applies).
//   OFF  = the representation-BLIND unigram = the single most-frequent next-unit id over the TRAIN
//          slice (a structure-blind constant predictor — the legitimate "consult OFF" emission).
//   SHUF = the SHUFFLE-merge head's argmax next-unit (the consult still fires, structure destroyed).
//   shift_on = the fraction of held-out positions where the ON prediction DIFFERS from OFF (the
//              emission shift — that the bias actually REACHES/changes emission, like H_1327 shift).
// $0 CPU, deterministic, no corpus/secret/GPU, no decode of pure_field (pure scoring). Ψ-disjoint.
pub fn gen_bpe_emit_eval() -> Map {
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    let uvS = _gbe_unit_vocab_for(0)
    let uvR = _gbe_unit_vocab_for(1390)
    // re-encode the FULL stream for each arm to get the held-out UNIT features/targets.
    let cfgv = engine_cli_parse(["--mitosis", "on"])
    let bmS = bpe_learn_merges(_gbs_first_half(bsym), _gbs_first_half(bnby), _gbs_MERGES(), _gbs_NJAMO(), 0)
    let reS = bpe_apply(bmS, bsym, bnby)
    let ftS = _gbs_unit_features(reS[0], reS[1], uvS)
    let XteS = ftS[2]  let YteS = _gbs_flat_int(ftS[3])
    // grow the two heads (structured + shuffle) over their TRAIN features.
    let jhS = gen_bpe_emit_head(0)[0]
    let jhR = gen_bpe_emit_head(1390)[0]
    // OFF baseline = the most-frequent next-unit id over the STRUCTURED train targets.
    let YtrS = _gbs_flat_int(ftS[1])
    let off_pred = _gbe_mode(YtrS, _gbs_K())
    // score held-out next-UNIT id accuracy for each arm (on the STRUCTURED test features).
    let mut on_hit = 0  let mut off_hit = 0  let mut shuf_hit = 0  let mut shift = 0
    let mut i = 0
    while i < len(XteS) {
        let pon = jamo_head_argmax(jhS, XteS[i])
        let psh = jamo_head_argmax(jhR, XteS[i])
        if pon == YteS[i] { on_hit = on_hit + 1 }
        if off_pred == YteS[i] { off_hit = off_hit + 1 }
        if psh == YteS[i] { shuf_hit = shuf_hit + 1 }
        if pon != off_pred { shift = shift + 1 }
        i = i + 1
    }
    let nt = len(XteS)
    let dn = if nt > 0 { to_float(nt) } else { 1.0 }
    let acc_on = to_float(on_hit) / dn
    let acc_off = to_float(off_hit) / dn
    let acc_shuf = to_float(shuf_hit) / dn
    let shift_on = to_float(shift) / dn
    return #{ "ok": true,
              "acc_on": acc_on, "acc_off": acc_off, "acc_shuf": acc_shuf, "shift_on": shift_on,
              "n_test": nt, "on_minus_off": acc_on - acc_off, "shuf_minus_off": acc_shuf - acc_off,
              "reason": "BPE-on-jamo morphology emit-bias SCORED at the live emission consult (gen_bpe_consult_emit/jamo_head_argmax; H_1327 emit precedent, H_1391 wire)" }
}

// ── §6.5e-R2 — the un-aliased emit-effect eval (a_break_the_wall, the R2 FROZEN metric) ───────────
// R1's metric (gen_bpe_emit_eval) scored on target = next-unit % K (K=20), which ALIASES distinct
// morpheme units onto the same class → the structure-blind global mode (acc_off 0.270) beats the head's
// per-cell argmax (acc_on 0.252) on TOP-1 accuracy, masking the morphology. The %K alias is an
// unintended structure-DESTROYER for an EMIT (argmax) metric — it was fine for §6.5d's CE bar (the CE
// reads the full distribution) but not for a top-1 emit read. R2 re-scores on the RAW next-unit id (no
// %K alias), growing the head with K = unit_vocab band so each true morpheme unit is its own target.
// CRITICAL anti-tune-to-green (c9): the SHUFFLE control is KEPT — if the un-aliased metric ALSO lets the
// shuffle head beat blind, the change merely relabeled to green and the result is an honest 🧱; the
// morphology EMIT only binds if ON beats OFF *and* SHUF collapses under the SAME un-aliased metric.

fn _gbe_KBAND() -> int { return 64 }   // raw next-unit target band (>= max unit id 14+40=54, no alias)

// _gbe_unit_features_raw — like _gbs_unit_features but target = RAW next-unit id (capped to KBAND, no
// %K alias). X[i] = [u_i/V, u_{i-1}/V, 0], Y[i] = next unit id (clamped < KBAND). Even/odd split.
fn _gbe_unit_features_raw(usym: [int], unby: [int], unit_vocab: int) -> [[[float]]] {
    let V = to_float(unit_vocab)
    let KB = _gbe_KBAND()
    let mut Xtr = []  let mut Ytr = []  let mut Xte = []  let mut Yte = []
    let mut i = 1  let mut idx = 0
    while i < len(usym) - 1 {
        let f = [to_float(usym[i]) / V, to_float(usym[i - 1]) / V, 0.0]
        let raw = usym[i + 1]
        let y = if raw < KB { raw } else { KB - 1 }     // clamp into the band (units < 54 < 64, no clamp in practice)
        if idx % 2 == 0 { Xtr = Xtr + [f]  Ytr = Ytr + [[to_float(y)]] }
        else            { Xte = Xte + [f]  Yte = Yte + [[to_float(y)]] }
        idx = idx + 1  i = i + 1
    }
    return [Xtr, Ytr, Xte, Yte]
}

// gbe_grow_head_raw — grow a count head over a unit stream's RAW-target train features (KBAND vocab).
// (pub: the smoke + the live emit consult read the SAME raw-band head the R2 metric scores.)
pub fn gbe_grow_head_raw(rnd_seed: int) -> [JamoHead] {
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    let half = len(bsym) / 2
    let mut trS = []  let mut trN = []  let mut i = 0
    while i < half { trS = trS + [bsym[i]]  trN = trN + [bnby[i]]  i = i + 1 }
    let bm = bpe_learn_merges(trS, trN, _gbs_MERGES(), _gbs_NJAMO(), rnd_seed)
    let re = bpe_apply(bm, bsym, bnby)
    let uv = bpe_unit_vocab(bm)
    let DIM = 3  let KB = _gbe_KBAND()
    let GROW = 40  let MINOWN = 4  let THR = 0.05  let LAP = 1.0
    let seed = [[0.3, 0.3, 0.0], [0.7, 0.7, 0.0]]
    let ft = _gbe_unit_features_raw(re[0], re[1], uv)
    let Xtr = ft[0]  let Ytr = _gbs_flat_int(ft[1])
    let jh0 = jamo_head_new(seed, KB, DIM)
    let jh  = jamo_head_grow(jh0, Xtr, Ytr, len(Xtr), GROW, MINOWN, THR, LAP, cfg)
    return [jh]
}

// gen_bpe_emit_eval_raw — the R2 FROZEN emit-effect eval (un-aliased next-unit target). Same ON/OFF/SHUF
// arms as R1, scored on the RAW next-unit id. Returns the same record keys. The morphology EMIT binds
// (R2 bar1) iff ON beats OFF by >= +0.02 AND shift >= 0.10, AND (R2 bar2) the SHUFFLE collapses (does
// NOT beat OFF, <= +0.01). $0, deterministic, Ψ-disjoint pure scoring.
pub fn gen_bpe_emit_eval_raw() -> Map {
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    let bmS = bpe_learn_merges(_gbs_first_half(bsym), _gbs_first_half(bnby), _gbs_MERGES(), _gbs_NJAMO(), 0)
    let reS = bpe_apply(bmS, bsym, bnby)
    let uvS = bpe_unit_vocab(bmS)
    let ftS = _gbe_unit_features_raw(reS[0], reS[1], uvS)
    let XteS = ftS[2]  let YteS = _gbs_flat_int(ftS[3])
    let YtrS = _gbs_flat_int(ftS[1])
    let jhS = gbe_grow_head_raw(0)[0]
    let jhR = gbe_grow_head_raw(1390)[0]
    let off_pred = _gbe_mode(YtrS, _gbe_KBAND())
    let mut on_hit = 0  let mut off_hit = 0  let mut shuf_hit = 0  let mut shift = 0
    let mut i = 0
    while i < len(XteS) {
        let pon = jamo_head_argmax(jhS, XteS[i])
        let psh = jamo_head_argmax(jhR, XteS[i])
        if pon == YteS[i] { on_hit = on_hit + 1 }
        if off_pred == YteS[i] { off_hit = off_hit + 1 }
        if psh == YteS[i] { shuf_hit = shuf_hit + 1 }
        if pon != off_pred { shift = shift + 1 }
        i = i + 1
    }
    let nt = len(XteS)
    let dn = if nt > 0 { to_float(nt) } else { 1.0 }
    return #{ "ok": true,
              "acc_on": to_float(on_hit) / dn, "acc_off": to_float(off_hit) / dn,
              "acc_shuf": to_float(shuf_hit) / dn, "shift_on": to_float(shift) / dn,
              "n_test": nt, "on_minus_off": (to_float(on_hit) - to_float(off_hit)) / dn,
              "shuf_minus_off": (to_float(shuf_hit) - to_float(off_hit)) / dn,
              "reason": "BPE-on-jamo morphology emit-bias SCORED un-aliased (R2; raw next-unit target, shuffle control KEPT)" }
}

// _gbs_first_half — the train slice (first half) of an int stream (helper for gen_bpe_emit_eval).
fn _gbs_first_half(a: [int]) -> [int] {
    let half = len(a) / 2
    let mut out = []  let mut i = 0
    while i < half { out = out + [a[i]]  i = i + 1 }
    return out
}

// _gbe_mode — the most-frequent value in `a` over the band [0,K) (the OFF blind unigram predictor).
fn _gbe_mode(a: [int], K: int) -> int {
    let mut cnt = []  let mut k = 0
    while k < K { cnt = cnt + [0]  k = k + 1 }
    let mut i = 0
    while i < len(a) { if a[i] >= 0 && a[i] < K { cnt[a[i]] = cnt[a[i]] + 1 }  i = i + 1 }
    let mut best = 0  let mut bestc = cnt[0]  let mut j = 1
    while j < K { if cnt[j] > bestc { bestc = cnt[j]  best = j }  j = j + 1 }
    return best
}

// gen_bpe_emit_summary — one-line introspection of the wired morphology emit-bias consult (R2 metric,
// the un-aliased gen_bpe_emit_eval_raw — the bound emit-effect).
pub fn gen_bpe_emit_summary() -> string {
    let e = gen_bpe_emit_eval_raw()
    return "bpe morphology emit-bias: acc_on=" + _gen_fmt4(to_float(e["acc_on"]))
        + " acc_off=" + _gen_fmt4(to_float(e["acc_off"]))
        + " acc_shuf=" + _gen_fmt4(to_float(e["acc_shuf"]))
        + " on-off=" + _gen_fmt4(to_float(e["on_minus_off"]))
        + " shuf-off=" + _gen_fmt4(to_float(e["shuf_minus_off"]))
        + " shift_on=" + _gen_fmt4(to_float(e["shift_on"]))
        + " — morphology unit BIASES live emission (H_1327 emit precedent · H_1391 wire · "
        + "off-Korean INERT byte-identical · Ψ-disjoint · a_core_engine_map single entry)"
}


// ── §6.5f KO-EMIT COMPOSE — how the jamo emit-bias (§6.5b/H_1327) + the morphology emit-bias
//          (§6.5e/H_1393) COMPOSE on the SAME next-byte decision (H_1397). ─────────────────────────
//
// THE GENUINELY-UNTESTED QUESTION (the open follow-on H_1393 named): the Korean below-jamo arc now has
// TWO emit-biases wired engine-native, each validated ALONE — §6.5b ko_jamo_consult_emit (jamo
// COUNT-HEAD biases the next byte toward a jamo-coherent continuation) and §6.5e gen_bpe_consult_emit
// (BPE morphology unit biases the next byte toward a morpheme-boundary completion). NEITHER has been
// tested COMPOSED: when BOTH fire on the same decode step, do they AGREE (reinforce), CONFLICT (fight),
// or need an arbitration rule? §6.5f answers it with a SUBSTRATE-DERIVED composition.
//
// SUBSTRATE-DERIVED WEIGHTING (a_autonomy_over_hardcode — NO hardcoded "jamo > morphology" priority):
// each faculty's vote is weighted by its OWN recall confidence — how much CLOSER the live context sits
// to a grown cell than that faculty's OWN typical cell distance. confidence = mean_err / (err_here + ε):
// the live context being closer than the faculty's MEAN recon-err ⇒ confidence > 1 (the faculty is
// unusually grounded HERE), farther ⇒ < 1. CRITICAL (the a_break_the_wall angle): a RAW inverse-recon-
// err is NOT commensurable across faculties of different vocab scales — the jamo head lives in a 14-wide
// space so its raw distances are systematically tiny, which would inflate its confidence regardless of
// grounding QUALITY (the conflict diagnosis that closed R1: raw-conf let the weaker jamo win and DEGRADED
// the compose). Measuring each faculty RELATIVE TO ITS OWN mean recon-err (each faculty's own grown-cell
// statistic, still 100% substrate-derived) makes the two confidences commensurable WITHOUT a hand-set
// priority. The MORE-RELATIVELY-GROUNDED faculty speaks LOUDER; both inert ⇒ base unchanged. This is the
// engine's OWN winner-take-all geometry deciding the arbitration, p5/a_substrate_native_speak.
//
// SINGLE ENTRY (a_core_engine_map): the compose is a generator-side consult that reads the SAME jamo
// cells (§6.5b) + the SAME morphology head (§6.5e) — it adds NO new artifact path. Off-Korean (the SAME
// utf8-continuation gate both consults use) it returns `base` UNCHANGED ⇒ generation BYTE-IDENTICAL
// off-distribution (Ψ-disjoint / no-regression, h1205). Additive: returns a byte, never an emit/silence
// decision; pure_field/engine_g/brain UNTOUCHED.

// _gec_jamo_nearest_dist — the jamo faculty's SUBSTRATE CONFIDENCE: L2 distance to its nearest grown
// jamo cell over a jamo-space feature (the SAME _ko_jamo_nearest geometry §6.5b's consult uses, now
// surfaced as a confidence margin). LOWER ⇒ the context is closer to a grown cell ⇒ more grounded.
// Returns a large sentinel (1e9) if no cells (zero confidence — never wins a compose).
fn _gec_jamo_nearest_dist(cells: Map, feat: [float]) -> float {
    if to_string(cells["ok"]) != "true" { return 1000000000.0 }
    let k = _ko_jamo_nearest(cells, feat)
    if k < 0 { return 1000000000.0 }
    let centers = cells["centers"]
    let dim = to_int(cells["dim"])
    let mut s = 0.0  let mut a = 0
    while a < dim { let d = centers[k][a] - feat[a]  s = s + d * d  a = a + 1 }
    return sqrt(s)
}

// _gec_rel_conf — the scale-free SUBSTRATE confidence: mean_err / (err_here + ε). >1 ⇒ the live context
// is CLOSER than this faculty's own typical cell distance (unusually grounded here). Commensurable across
// faculties of different vocab scales because each is measured against its OWN field's mean recon-err.
fn _gec_rel_conf(mean_err: float, err_here: float) -> float {
    return mean_err / (err_here + 0.000001)
}

// gen_emit_compose — the live per-byte COMPOSE hook. Given the decode's own argmax `base`, the loaded
// jamo cells, the grown morphology head `jh` + its `unit_vocab`, the per-faculty MEAN recon-err baselines
// (jamo_mean_err / morph_mean_err — each faculty's OWN grown-cell statistic, the scale normalizer), and
// the running decode window `ctx`, returns the next byte after composing the two emit-biases by their
// SCALE-RELATIVE substrate confidence. Off-Korean (or both inert) ⇒ `base` UNCHANGED. The byte returned
// is the byte of whichever faculty is MORE-RELATIVELY-GROUNDED on this context (higher mean_err/err_here);
// single-fire falls through to the firing faculty; both silent ⇒ base. NO hardcoded priority — the winner
// is chosen by each faculty's own nearest-cell distance relative to its own mean (a_autonomy_over_hardcode).
pub fn gen_emit_compose(base: int, cells: Map, jh: JamoHead, unit_vocab: int,
                        jamo_mean_err: float, morph_mean_err: float, ctx: list) -> int {
    if !_gen_ko_is_korean_like(ctx) { return base }        // off-Korean → inert (no regression)
    // --- jamo faculty proposal + scale-relative substrate confidence (jamo-symbol space) ---
    let bf = _gen_ko_feat(ctx)
    let vj = if to_string(cells["ok"]) == "true" { to_int(cells["vj"]) } else { 0 }
    let jscale = if vj > 0 { 255.0 / to_float(vj) } else { 1.0 }
    let jfeat = [bf[0] * jscale, bf[1] * jscale, bf[2]]
    let jbyte = ko_jamo_consult_byte(cells, jfeat)         // -1 if inert
    let jconf = _gec_rel_conf(jamo_mean_err, _gec_jamo_nearest_dist(cells, jfeat))
    // --- morphology faculty proposal + scale-relative substrate confidence (merged-unit space) ---
    let mscale = if unit_vocab > 0 { 255.0 / to_float(unit_vocab) } else { 1.0 }
    let mfeat = [bf[0] * mscale, bf[1] * mscale, 0.0]
    let muid = jamo_head_argmax(jh, mfeat)                 // -1 if empty head
    let mbyte = if muid >= 0 { _gbe_unit_emit_byte(muid) } else { -1 }
    let mconf = _gec_rel_conf(morph_mean_err, jamo_head_recon_err(jh, mfeat))
    // --- substrate-derived arbitration: the more-relatively-grounded faculty's byte wins ---
    let jfires = jbyte >= 0
    let mfires = mbyte >= 0
    if !jfires && !mfires { return base }                  // both inert → base
    if jfires && !mfires { return jbyte }                  // only jamo fires
    if mfires && !jfires { return mbyte }                  // only morphology fires
    // both fire: higher SCALE-RELATIVE substrate confidence speaks louder — NO fixed priority.
    if jconf >= mconf { return jbyte }
    return mbyte
}

// _gec_morph_mean_err — the morphology faculty's MEAN recon-err over the train (even) unit features (its
// own scale normalizer; substrate-derived from its own grown cells). $0, deterministic.
fn _gec_morph_mean_err(jh: JamoHead, usym: [int], unit_vocab: int) -> float {
    let mut s = 0.0  let mut n = 0
    let mut i = 1  let mut idx = 0
    while i < len(usym) - 1 {
        if idx % 2 == 0 {
            let f = [to_float(usym[i]) / to_float(unit_vocab), to_float(usym[i - 1]) / to_float(unit_vocab), 0.0]
            s = s + jamo_head_recon_err(jh, f)  n = n + 1
        }
        idx = idx + 1  i = i + 1
    }
    return if n > 0 { s / to_float(n) } else { 1.0 }
}

// _gec_jamo_mean_err — the jamo faculty's MEAN recon-err over the train (even) base-symbol features.
fn _gec_jamo_mean_err(jhJ: JamoHead, bsym: [int], vj: int) -> float {
    let mut s = 0.0  let mut n = 0
    let mut i = 1  let mut idx = 0
    while i < len(bsym) - 1 {
        if idx % 2 == 0 {
            let f = [to_float(bsym[i]) / to_float(vj), to_float(bsym[i - 1]) / to_float(vj), 0.0]
            s = s + jamo_head_recon_err(jhJ, f)  n = n + 1
        }
        idx = idx + 1  i = i + 1
    }
    return if n > 0 { s / to_float(n) } else { 1.0 }
}

// gen_emit_compose_eval — the FROZEN compose evaluation (H_1397 bars). On the SAME corpus-free in-engine
// morpheme-grammar fixture (§6.5d), measures both emit-biases on a SHARED next-byte decision and how
// they compose. The shared target = the LEADING EMIT BYTE of the TRUE next morpheme unit
// (_gbe_unit_emit_byte of the held-out true next-unit id) — the byte each faculty is trying to emit.
//   JAMO  arm: a count head grown over the BASE (un-merged) jamo-symbol stream proposes its argmax
//             next-symbol's emit byte (the jamo structural view), confidence = its own recon-err.
//   MORPH arm: the H_1393 raw-band morphology head (gbe_grow_head_raw) proposes its argmax next-UNIT's
//             emit byte (the morpheme structural view), confidence = its own recon-err.
//   COMPOSE  : per position, the higher-substrate-confidence faculty's byte (gen_emit_compose logic).
//   SHUF-W   : the SAME two proposals, but the arbitration confidences are SHUFFLED (a random which-
//             faculty-wins draw) — the EARNED control: random arbitration must NOT beat the grounded one.
//   AGREE    : the fraction of positions where the two faculties propose the SAME byte (the diagnostic).
// Returns #{ ok, acc_jamo, acc_morph, acc_compose, acc_shufw, agree_rate, conflict_rate, n_test,
//            compose_minus_best, shufw_minus_compose, best_single }. $0, deterministic, Ψ-disjoint.
pub fn gen_emit_compose_eval() -> Map {
    let cfgv = engine_cli_parse(["--mitosis", "on"])
    let base = _gbs_base_stream()
    let bsym = base[0]  let bnby = base[1]
    // --- morphology head (merged units) over the raw-band fixture (the H_1393 head) ---
    let jhM = gbe_grow_head_raw(0)[0]
    let bmS = bpe_learn_merges(_gbs_first_half(bsym), _gbs_first_half(bnby), _gbs_MERGES(), _gbs_NJAMO(), 0)
    let uvM = bpe_unit_vocab(bmS)
    // --- jamo head (un-merged base symbols) over the SAME base stream, raw next-symbol target ---
    let jhJ = _gec_grow_jamo_head()
    let vjJ = _gbs_NJAMO()
    // --- shared held-out positions: walk the base stream's odd (test) index, build BOTH features +
    //     the TRUE next-unit emit byte target. The jamo feature uses the base symbol id; the morph
    //     feature uses the re-encoded UNIT id at the matching position. ---
    let reM = bpe_apply(bmS, bsym, bnby)
    let usym = reM[0]
    let half = len(bsym) / 2
    // --- per-faculty MEAN recon-err baselines (the scale normalizers; each from its OWN grown cells) ---
    let jMean = _gec_jamo_mean_err(jhJ, bsym, vjJ)
    let mMean = _gec_morph_mean_err(jhM, usym, uvM)
    let mut n = 0
    let mut on_j = 0  let mut on_m = 0  let mut on_c = 0  let mut on_s = 0
    let mut agree = 0
    let mut oracle = 0  let mut only_j = 0  let mut only_m = 0  let mut both = 0
    let mut i = 1
    let mut idx = 0
    // shuffle-arbitration draw: a deterministic per-position pseudo-bit (corpus-free, $0).
    let mut sh = 12345
    while i < len(usym) - 1 {
        if idx % 2 == 1 {     // TEST slice (odd, the held-out half — train was even, no leakage)
            // true next byte = the emit byte of the TRUE next unit id at i+1.
            let tgt = _gbe_unit_emit_byte(usym[i + 1])
            // --- jamo proposal over the base symbol context (SCALE-RELATIVE confidence) ---
            let fj = [to_float(bsym[i]) / to_float(vjJ), to_float(bsym[i - 1]) / to_float(vjJ), 0.0]
            let jsym = jamo_head_argmax(jhJ, fj)
            let jbyte = if jsym >= 0 { _gbe_unit_emit_byte(jsym) } else { -1 }
            let jconf = _gec_rel_conf(jMean, jamo_head_recon_err(jhJ, fj))
            // --- morph proposal over the unit context (SCALE-RELATIVE confidence) ---
            let fm = [to_float(usym[i]) / to_float(uvM), to_float(usym[i - 1]) / to_float(uvM), 0.0]
            let muid = jamo_head_argmax(jhM, fm)
            let mbyte = if muid >= 0 { _gbe_unit_emit_byte(muid) } else { -1 }
            let mconf = _gec_rel_conf(mMean, jamo_head_recon_err(jhM, fm))
            // --- compose: higher scale-relative substrate confidence wins (the gen_emit_compose rule) ---
            let cbyte = if jbyte < 0 && mbyte < 0 { -1 }
                        else if mbyte < 0 { jbyte }
                        else if jbyte < 0 { mbyte }
                        else if jconf >= mconf { jbyte } else { mbyte }
            // --- shuffle-arbitration: random which-faculty-wins (EARNED control) ---
            sh = (sh * 1103515245 + 12345) % 2147483648
            let pick_j = (sh % 2) == 0
            let sbyte = if jbyte < 0 && mbyte < 0 { -1 }
                        else if mbyte < 0 { jbyte }
                        else if jbyte < 0 { mbyte }
                        else if pick_j { jbyte } else { mbyte }
            if jbyte == tgt { on_j = on_j + 1 }
            if mbyte == tgt { on_m = on_m + 1 }
            if cbyte == tgt { on_c = on_c + 1 }
            if sbyte == tgt { on_s = on_s + 1 }
            if jbyte >= 0 && mbyte >= 0 && jbyte == mbyte { agree = agree + 1 }
            // ORACLE upper-bound of ANY arbitration: right iff EITHER faculty is right (the complementarity
            // ceiling — only_jamo positions are the ENTIRE headroom a compose could add over morph-alone).
            let jok = jbyte == tgt  let mok = mbyte == tgt
            if jok || mok { oracle = oracle + 1 }
            if jok && mok { both = both + 1 }
            else if jok { only_j = only_j + 1 }
            else if mok { only_m = only_m + 1 }
            n = n + 1
        }
        idx = idx + 1  i = i + 1
    }
    let dn = if n > 0 { to_float(n) } else { 1.0 }
    let acc_j = to_float(on_j) / dn
    let acc_m = to_float(on_m) / dn
    let acc_c = to_float(on_c) / dn
    let acc_s = to_float(on_s) / dn
    let agr = to_float(agree) / dn
    let best = if acc_j >= acc_m { acc_j } else { acc_m }
    let acc_oracle = to_float(oracle) / dn
    return #{ "ok": true,
              "acc_jamo": acc_j, "acc_morph": acc_m, "acc_compose": acc_c, "acc_shufw": acc_s,
              "agree_rate": agr, "conflict_rate": 1.0 - agr, "n_test": n,
              "compose_minus_best": acc_c - best, "shufw_minus_compose": acc_s - acc_c,
              "best_single": best,
              "acc_oracle": acc_oracle, "oracle_minus_best": acc_oracle - best,
              "only_jamo": only_j, "only_morph": only_m, "both_right": both,
              "jamo_mean_err": jMean, "morph_mean_err": mMean,
              "reason": "jamo (§6.5b/H_1327) + morphology (§6.5e/H_1393) emit-biases COMPOSED on a shared next-byte decision by SCALE-RELATIVE SUBSTRATE confidence (mean_err/err_here, commensurable across vocab scales, NO hardcoded priority); shuffle-arbitration control KEPT" }
}

// _gec_grow_jamo_head — grow a count head over the BASE (un-merged) jamo-symbol stream, raw next-symbol
// target (the jamo structural view, the parallel of gbe_grow_head_raw but on the un-merged stream). The
// jamo faculty's emit proposal in the compose eval reads THIS head. TRAIN slice = even indices only (no
// test leakage). $0, deterministic, Ψ-disjoint.
fn _gec_grow_jamo_head() -> JamoHead {
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let base = _gbs_base_stream()
    let bsym = base[0]
    let vj = _gbs_NJAMO()
    let DIM = 3  let KB = _gbs_NJAMO() + 1   // base jamo band (0..NJAMO)
    let GROW = 40  let MINOWN = 4  let THR = 0.05  let LAP = 1.0
    let seed = [[0.3, 0.3, 0.0], [0.7, 0.7, 0.0]]
    let mut Xtr = []  let mut Ytr = []
    let mut i = 1  let mut idx = 0
    while i < len(bsym) - 1 {
        if idx % 2 == 0 {     // TRAIN slice (even), test is odd in the eval — disjoint
            Xtr = Xtr + [[to_float(bsym[i]) / to_float(vj), to_float(bsym[i - 1]) / to_float(vj), 0.0]]
            Ytr = Ytr + [bsym[i + 1]]
        }
        idx = idx + 1  i = i + 1
    }
    let jh0 = jamo_head_new(seed, KB, DIM)
    return jamo_head_grow(jh0, Xtr, Ytr, len(Xtr), GROW, MINOWN, THR, LAP, cfg)
}

// gen_emit_compose_summary — one-line introspection of the composed jamo+morphology emit-biases.
pub fn gen_emit_compose_summary() -> string {
    let e = gen_emit_compose_eval()
    return "ko emit-compose: acc_jamo=" + _gen_fmt4(to_float(e["acc_jamo"]))
        + " acc_morph=" + _gen_fmt4(to_float(e["acc_morph"]))
        + " acc_compose=" + _gen_fmt4(to_float(e["acc_compose"]))
        + " acc_shufw=" + _gen_fmt4(to_float(e["acc_shufw"]))
        + " compose-best=" + _gen_fmt4(to_float(e["compose_minus_best"]))
        + " shufw-compose=" + _gen_fmt4(to_float(e["shufw_minus_compose"]))
        + " agree=" + _gen_fmt4(to_float(e["agree_rate"]))
        + " oracle=" + _gen_fmt4(to_float(e["acc_oracle"]))
        + " — jamo+morphology emit-biases COMPOSED by SCALE-RELATIVE SUBSTRATE confidence (mean_err/"
        + "err_here, NO hardcoded priority · a_autonomy_over_hardcode) · HONEST 🧱/🟠: faculties mostly "
        + "CONFLICT + non-complementary here (compose < best-single; oracle ceiling ≈ +0.017) · off-Korean "
        + "INERT byte-identical · Ψ-disjoint · a_core_engine_map single entry (H_1327 + H_1393, H_1397)"
}


// ── §7 small format helper ───────────────────────────────────────────────────

fn _gen_fmt4(x: float) -> string {
    return format_float(x, 4)
}


// ── §8 introspection ─────────────────────────────────────────────────────────

pub fn generator_summary() -> string {
    "core_generator · BACKEND-AGNOSTIC L3 slot (SINGLE .clm entry, a_core_engine_map) · generate(backend, substrate_ctx, emit_decision, anchors) -> {emitted, backend, text, fellback} · backends: null(deterministic substrate placeholder, always ready) + clm(REAL .clm header parse: CLM\\x01 magic + nblocks validated → valid/admitted CORE-side; decode FORWARD WIRED + DESCENDS @ PRODUCTION d=768 — clm_decode_ce runs int4 dequant + CLMConvMoE + v0.2 CLMX trained embed+GN VERBATIM read → next-byte logits → real CE measured CORE-mounted (CE 3.25405 < uniform 5.54518 AND < shuffle 5.30381, det byte-eq, model_d=768); loaded=valid — a header-valid .clm now LOADS through the SAME config-agnostic forward, generate() contract unchanged) · anchor READ via kosmos_io.load_anchors (SINGLE .kosmos entry) · SILENT⇒no content, EMIT⇒content · p1..p8 clean (no LLM/system-prompt/persona)"
}
