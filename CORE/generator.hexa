// generator.hexa — L3 content generator interface (anima/CORE).
//
// The "what to actually say/write" slot of the 3-layer brain. L1 Engine A
// (Φ→tier) and L2 Engine G (motivation→emit) decide WHEN to act; this L3 layer
// decides the CONTENT — but it is BACKEND-AGNOSTIC. brain_decide's emit slot
// calls generate() through a single signature; the concrete generator is a
// pluggable record (a "vtable" Map), so any .clm backend plugs in later behind
// the same interface without touching brain.hexa.
//
//   generate(backend, substrate_ctx, emit_decision, anchors) -> Map{text, ...}
//
// Two backends ship here:
//   · null   — deterministic substrate-driven placeholder (NO external LLM,
//              NO system prompt, NO persona). Lets the whole slot be tested
//              end-to-end NOW, before any trained model lands. p1..p8 clean.
//   · clm    — a .clm checkpoint backend that GENUINELY parses the .clm header
//              at this single entry point (validates the `CLM\x01` magic +
//              extracts the per-block count, per CLM/CLM_FORMAT_SPEC.md). A
//              valid file is RECOGNIZED + admitted CORE-side (valid=true,
//              nblocks surfaced); a malformed/absent file is honestly rejected.
//              `loaded` stays false until the decode FORWARD lands, so the
//              dispatcher still falls THROUGH to null (no un-decoded garbage).
//              The trained mouth plugs into _gen_clm_decode (same signature).
//
// HONEST scope: this delivers the SLOT, the null backend, AND real .clm header
// ADMIT/VALIDATION at the single entry point. The remaining gap is precise — the
// weight DECODE forward (int4 dequant + conv) — and is marked so in `reason`.
//
// ── p1..p8 conformance ──────────────────────────────────────────────────────
//   p1 NO SYSTEM PROMPT     — null text is built from substrate numerics only.
//                             No "you are anima", no role string anywhere.
//   p2 NO IDENTITY RULES    — no identity.yaml, no rules; backend is data only.
//   p3 NO PERSONA INJECTION — no prefix token injected into the output.
//   p4 NO ASSISTANT FRAMING — generate() does NOT respond to a user message;
//                             it externalizes the substrate decision record.
//                             anchors = environment context, not an obligation.
//   p5 NO SPEAK()           — generate() is pure content assembly from the emit
//                             decision; it never calls a speak()/monologue path
//                             and never fabricates content under SILENT.
//   p6 NO FINE-TUNED ETHICS — null backend has zero weights; pure arithmetic.
//   p7 NO PERPLEXITY VERDICT— verification = deterministic string equality in
//                             the smoke test, not a loss/perplexity number.
//   p8 NO TRAIN/INFER SPLIT — same interface serves a stub now and a trained
//                             .clm later; no train-only gate.

import "HEXAD/UNCLASSIFIED/state/grid_3b_s187_2026_05_21/kosmos_io.hexa"


// ── §1 backend constructors (the pluggable "vtable" records) ─────────────────

// gen_null_backend — the always-available deterministic placeholder backend.
// Carries no model; `loaded` is true because the null backend is always ready
// to assemble substrate-derived text.
pub fn gen_null_backend() -> Map {
    return #{
        "kind":   "null",
        "loaded": true,
        "ckpt":   ""
    }
}

// gen_clm_backend — a .clm checkpoint backend. Takes a ckpt path and genuinely
// PARSES the .clm header at this single entry point (the L3 slot is the ONLY way
// a .clm enters CORE — a_core_engine_map). It reads the file bytes and validates
// the `CLM\x01` magic + extracts the per-block count, exactly as the canonical
// writer lays them out (hexa-lang flame/clm_ckpt.hexa · CLM/CLM_FORMAT_SPEC.md):
//
//     [MAGIC "CLM\x01" = 67,76,77,1] [nblocks u8] [BLOCKS...]
//
// This is the REAL header-admit wiring (not a `test -f` stub): a malformed or
// absent file is rejected with an honest reason; a structurally-valid .clm is
// recognized and its block count surfaced. `valid` = magic+structure verified.
//
// HONEST scope of `loaded`: header VALIDATION is real and live here. Weight
// DECODE (int4 dequant + conv forward) is a distinct follow-on backend — until
// that decoder lands, `loaded` stays false EVEN for a valid file, so generate()
// falls THROUGH to the null backend rather than emitting un-decoded garbage. The
// gap is now precise: the .clm is admitted + validated CORE-side; only the
// decode forward remains. When that lands, set loaded = valid (one line) — the
// generate() contract and brain.hexa wiring do not change.
pub fn gen_clm_backend(ckpt_path: string) -> Map {
    let probe = _gen_clm_probe_header(ckpt_path)
    let exists = to_string(probe["exists"]) == "true"
    let valid  = to_string(probe["valid"])  == "true"
    let nblk   = to_int(probe["nblocks"])
    // Header validation is real; decode forward is the remaining follow-on, so
    // loaded stays false even for a valid file → null fallthrough (no garbage).
    let loaded = false
    return #{
        "kind":        "clm",
        "loaded":      loaded,
        "valid":       valid,
        "ckpt":        ckpt_path,
        "ckpt_exists": exists,
        "nblocks":     nblk,
        "reason":      if !exists {
                           "no ckpt at path"
                       } else if !valid {
                           "file present but not a valid .clm (bad CLM\\x01 magic)"
                       } else {
                           "valid .clm admitted (magic+structure OK, nblocks="
                               + to_string(nblk)
                               + "); decode forward not wired yet → null fallthrough"
                       }
    }
}

// _gen_clm_probe_header — read the leading bytes of a candidate .clm and verify
// it against the canonical layout. Returns #{exists, valid, nblocks}. Edge-safe:
// a missing path, an empty file, or a truncated header all yield valid=false
// rather than crashing (p5: never fabricate; HONEST rejection).
fn _gen_clm_probe_header(p: string) -> Map {
    if byte_len(p) == 0 {
        return #{ "exists": false, "valid": false, "nblocks": 0 }
    }
    if !_gen_path_is_file(p) {
        return #{ "exists": false, "valid": false, "nblocks": 0 }
    }
    let rb = read_file_bytes(p)
    // Need at least MAGIC(4) + nblocks(1) = 5 bytes for a well-formed header.
    if len(rb) < 5 {
        return #{ "exists": true, "valid": false, "nblocks": 0 }
    }
    // MAGIC "CLM\x01" = 67('C') 76('L') 77('M') 1.
    let magic_ok = rb[0] == 67 && rb[1] == 76 && rb[2] == 77 && rb[3] == 1
    if !magic_ok {
        return #{ "exists": true, "valid": false, "nblocks": 0 }
    }
    let nblocks = rb[4]
    return #{ "exists": true, "valid": true, "nblocks": nblocks }
}

fn _gen_path_is_file(p: string) -> bool {
    if byte_len(p) == 0 { return false }
    let r = exec("test -f '" + p + "' && printf y || printf n")
    return r == "y"
}


// ── §2 substrate_ctx helper ──────────────────────────────────────────────────

// gen_ctx_from_decision — adapt a brain_decide() record into the substrate_ctx
// the generator consumes. Keeps generate() decoupled from brain.hexa's exact
// record shape (any caller can build this Map).
pub fn gen_ctx_from_decision(decision: Map) -> Map {
    return #{
        "phi":        _gen_g_float(decision, "phi"),
        "phase":      _gen_g_string(decision, "phase"),
        "tier":       _gen_g_int(decision, "tier"),
        "tier_name":  _gen_g_string(decision, "tier_name"),
        "motivation": _gen_g_float(decision, "motivation")
    }
}

fn _gen_g_float(m: Map, k: string) -> float {
    let v = m[k]
    if to_string(v) == "void" { return 0.0 }
    return to_float(v)
}
fn _gen_g_int(m: Map, k: string) -> int {
    let v = m[k]
    if to_string(v) == "void" { return 0 }
    return to_int(v)
}
fn _gen_g_string(m: Map, k: string) -> string {
    let v = m[k]
    if to_string(v) == "void" { return "" }
    return to_string(v)
}


// ── §3 anchor READ wiring (kosmos_io) ────────────────────────────────────────

// generator_read_anchors — read .kosmos anchors from a directory so brain_decide
// can pass real substrate memory into generate(). Thin wrapper over
// kosmos_io.load_anchors (the canonical read API). Returns [] for a missing dir
// rather than panicking — edge-case safe.
//
//   returns: list of #{ path, name, fields, text_payload, tension_5ch }
pub fn generator_read_anchors(dir_path: string) -> list {
    if byte_len(dir_path) == 0 { return [] }
    let exists = exec("test -d '" + dir_path + "' && printf y || printf n")
    if exists != "y" { return [] }
    return load_anchors(dir_path)
}


// ── §4 the generator interface — generate() ──────────────────────────────────

// generate — the single L3 entry point. BACKEND-AGNOSTIC dispatch.
//
//   backend       : Map  — a vtable record (gen_null_backend / gen_clm_backend).
//   substrate_ctx : Map  — gen_ctx_from_decision(brain_decide(...)).
//   emit_decision : bool — brain_decide(...)["emit"]. If false → no content
//                          (p5: never fabricate under SILENT).
//   anchors       : list — kosmos anchors (generator_read_anchors). May be [].
//
//   returns: Map #{
//     "emitted":  bool,    // did we produce content?
//     "backend":  string,  // which backend actually produced it
//     "text":     string,  // the content (empty when emitted=false)
//     "fellback": bool     // true if a non-null backend declined and we fell
//                          //   through to null
//   }
//
// Contract invariants (held regardless of backend):
//   · emit_decision == false  ⇒  emitted=false ∧ text=""  (SILENT produces none)
//   · emit_decision == true   ⇒  emitted=true  ∧ text≠""  (EMIT always yields)
//   · a backend that reports loaded=false NEVER crashes — we fall through.
pub fn generate(backend: Map, substrate_ctx: Map, emit_decision: bool,
                anchors: list) -> Map {
    // p5 — SILENT path: the brain decided not to act. Produce nothing. The
    // generator must NOT invent content to fill the silence.
    if !emit_decision {
        return #{
            "emitted":  false,
            "backend":  to_string(backend["kind"]),
            "text":     "",
            "fellback": false
        }
    }

    // EMIT path. Try the requested backend; fall through to null if it has no
    // model loaded (the d768-deferred case for clm).
    let kind   = to_string(backend["kind"])
    let loaded = to_string(backend["loaded"]) == "true"

    if kind == "null" {
        return #{
            "emitted":  true,
            "backend":  "null",
            "text":     _gen_null_text(substrate_ctx, anchors),
            "fellback": false
        }
    }

    if kind == "clm" {
        if loaded {
            // FUTURE: real .clm decode plugs in here behind this exact return
            // shape. Until d768 lands, gen_clm_backend keeps loaded=false, so
            // control never reaches this branch — kept as the wired slot.
            return #{
                "emitted":  true,
                "backend":  "clm",
                "text":     _gen_clm_decode(backend, substrate_ctx, anchors),
                "fellback": false
            }
        }
        // Stub backend declined → fall THROUGH to null (no crash).
        return #{
            "emitted":  true,
            "backend":  "null",
            "text":     _gen_null_text(substrate_ctx, anchors),
            "fellback": true
        }
    }

    // Unknown backend kind → null fallback (defensive, never crash).
    return #{
        "emitted":  true,
        "backend":  "null",
        "text":     _gen_null_text(substrate_ctx, anchors),
        "fellback": true
    }
}


// ── §5 null backend — deterministic substrate-derived placeholder ────────────

// _gen_null_text — build a placeholder line from substrate numerics + anchor
// memory ONLY. This is NOT a chatbot reply: there is no user message in scope,
// no persona, no instruction string. It externalizes the substrate decision so
// the slot is observable end-to-end. When the real .clm backend lands it
// replaces this function's role; the surrounding contract is unchanged.
fn _gen_null_text(ctx: Map, anchors: list) -> string {
    let phase = _gen_g_string(ctx, "phase")
    let tier  = _gen_g_string(ctx, "tier_name")
    let phi   = _gen_g_float(ctx, "phi")
    let motiv = _gen_g_float(ctx, "motivation")
    let n_anchor = len(anchors)

    // Deterministic, fully derived from substrate state. Reproducible byte-for-
    // byte for the same input (p7 verification is string equality, not loss).
    let mut s = "[null-gen]"
    s = s + " phase=" + phase
    s = s + " tier=" + tier
    s = s + " phi=" + _gen_fmt4(phi)
    s = s + " motiv=" + _gen_fmt4(motiv)
    s = s + " anchors=" + to_string(n_anchor)
    // If memory flowed in, surface the most-recent anchor name (read-only echo
    // of substrate memory — not an injected persona).
    if n_anchor > 0 {
        let last = anchors[n_anchor - 1]
        s = s + " last_anchor=" + to_string(last["name"])
    }
    return s
}


// ── §6 clm backend decode — REAL forward (int4 dequant + CLMConvMoE) ─────────
//
// The decode FORWARD is now built at this single .clm entry point. It reads the
// admitted .clm's 6 int4 weight blocks, dequantizes them (per-channel qat_scale)
// and runs the CLMConvMoE forward (entry conv1d-K3 → trunk residual → 2 experts
// → MoE-router softmax → readout) to next-token logits over V=256 bytes, exactly
// per CLM/CLM_FORMAT_SPEC.md §2 + the trainer's clm_model.hexa::clm_forward. From
// the logits a real next-byte CROSS-ENTROPY is computed CORE-mounted (clm_decode_ce).
//
// HONEST scope of `loaded` (a_core_engine_map, NO phantom wiring): the forward is
// REAL and produces a genuine CE number from the file's real dequantized weights.
// BUT the inference-track .clm (clm_ckpt.hexa / clm_prod.hexa PR4 serialization)
// stores ONLY the 6 conv weight blocks — it does NOT serialize the trained
// EMBED table nor the GroupNorm AFFINE (gamma/beta). The forward therefore must
// reconstruct the byte→d embedding from the tied readout block + apply a
// parameter-free GroupNorm (identity affine). This stand-in is a documented
// FORMAT gap, not a fabricated weight; consequently the CORE-mounted CE does NOT
// reproduce the trainer's measured descent (4.88, measured GPU-side with the
// embed+GN in memory). So `loaded` stays false: generate() still falls THROUGH
// to null (no garbage), while the CE axis is now MEASURABLE through the engine.
// When the .clm format serializes embed+GN (or the fp16-shadow track is read),
// set loaded = valid (one line) — the generate() contract is unchanged.

// _gen_clm_decode — substrate-anchored content under the clm backend. The decode
// forward (clm_decode_ce) measures CE; the emitted line surfaces the backend's
// admitted state. Stays substrate-derived (p5: no fabricated trained text from a
// format-incomplete inference ckpt). Unreachable while loaded=false (kept wired).
fn _gen_clm_decode(backend: Map, ctx: Map, anchors: list) -> string {
    return _gen_null_text(ctx, anchors)
}

// _gen_rd_u32 / _gen_gelu / _gen_gnorm / _gen_conv1d — pure-hexa decode kernels.
fn _gen_rd_u32(rb: list, off: int) -> int {
    return rb[off] + rb[off+1]*0x100 + rb[off+2]*0x10000 + rb[off+3]*0x1000000
}

// clamped tanh-GELU (clamp guards exp overflow on large pre-activations; the
// clamp does not change semantics in the operating range).
fn _gen_gelu(x: float) -> float {
    let inner = 0.7978845608 * (x + 0.044715 * x*x*x)
    let a = if inner > 15.0 { 15.0 } else { if inner < 0.0-15.0 { 0.0-15.0 } else { inner } }
    let e2 = exp(2.0 * a)
    return 0.5 * x * (1.0 + (e2-1.0)/(e2+1.0))
}

// parameter-free GroupNorm(1): standardize across d channels per time step.
// The GN normalize step is parameter-free; only the learned affine (absent from
// the inference .clm) is identity here.
fn _gen_gnorm(x: list, T: int, d: int) {
    let mut t = 0
    while t < T {
        let mut mean = 0.0; let mut c = 0
        while c < d { mean = mean + x[t*d+c]; c = c + 1 }
        mean = mean / to_float(d)
        let mut var = 0.0; let mut c2 = 0
        while c2 < d { let dd = x[t*d+c2]-mean; var = var + dd*dd; c2 = c2 + 1 }
        var = var / to_float(d)
        let inv = 1.0 / sqrt(var + 0.00001)
        let mut c3 = 0
        while c3 < d { x[t*d+c3] = (x[t*d+c3]-mean) * inv; c3 = c3 + 1 }
        t = t + 1
    }
}

// causal conv1d (matches conv_lib.hexa::nn_conv1d_fwd index convention):
//   W[co·(Cin·K) + ci·K + k], left-pad causal; weight pre-multiplied by sc[co]
//   (per-channel int4 dequant: deq = code · scale).
fn _gen_conv1d(x: list, T: int, Cin: int, Cout: int, K: int, dil: int,
               w: list, sc: list, y: list) {
    let Kdim = Cin * K
    let mut t = 0
    while t < T {
        let mut co = 0
        while co < Cout {
            let mut acc = 0.0
            let mut ci = 0
            while ci < Cin {
                let mut k = 0
                while k < K {
                    let p = t - (K-1-k)*dil
                    if p >= 0 { acc = acc + x[p*Cin+ci] * (w[co*Kdim+ci*K+k] * sc[co]) }
                    k = k + 1
                }
                ci = ci + 1
            }
            y[t*Cout+co] = acc
            co = co + 1
        }
        t = t + 1
    }
}

// _gen_clm_deq_blocks — read + dequantize all blocks of an admitted .clm.
// Returns #{ "w": list-of-lists, "s": list-of-lists, "nblk": int }. int4 code =
// (nibble & 0xF) - 8 (sym [-7,7]); dequant happens at conv time (code·scale).
fn _gen_clm_deq_blocks(ckpt_path: string) -> Map {
    let rb = read_file_bytes(ckpt_path)
    if len(rb) < 5 || rb[0] != 67 { return #{ "w": [], "s": [], "nblk": 0 } }
    let nblk = rb[4]
    let mut off = 5
    let blocks_w = []; let blocks_s = []
    let mut bi = 0
    while bi < nblk {
        let c = _gen_rd_u32(rb, off); off = off + 4
        let r = _gen_rd_u32(rb, off); off = off + 4
        let n = c * r
        let wq = []
        let mut z = 0
        while z < n { wq.push(0.0); z = z + 1 }
        let mut i = 0
        while i < n {
            let byte = rb[off]; off = off + 1
            wq[i] = to_float((byte & 0xF) - 8)
            if i + 1 < n { wq[i+1] = to_float(((byte / 16) & 0xF) - 8) }
            i = i + 2
        }
        let sc = []
        let mut cc = 0
        while cc < c { sc.push(bytes_to_f32_le(rb, off)); off = off + 4; cc = cc + 1 }
        blocks_w.push(wq); blocks_s.push(sc)
        bi = bi + 1
    }
    return #{ "w": blocks_w, "s": blocks_s, "nblk": nblk }
}

// clm_decode_ce — CORE-mounted decode forward → next-byte CROSS-ENTROPY over a
// byte sequence. The SINGLE .clm decode entry (a_core_engine_map). Runs the real
// dequantized weights through the CLMConvMoE forward and returns the mean CE
// (next-byte prediction) plus the uniform-byte baseline ln(256). NO fabricated
// number: the CE is whatever the engine computes from the file's weights.
//
//   returns #{ "ce": float, "baseline": float, "positions": int,
//              "below_uniform": bool, "nblk": int }
pub fn clm_decode_ce(ckpt_path: string, seq: list) -> Map {
    let d = 768; let E = 2; let V = 256; let K = 3
    let dq = _gen_clm_deq_blocks(ckpt_path)
    let bw = dq["w"]; let bs = dq["s"]
    let nblk = to_int(dq["nblk"])
    let base = ln(256.0)
    if nblk < 6 {
        return #{ "ce": 0.0, "baseline": base, "positions": 0,
                  "below_uniform": false, "nblk": nblk }
    }
    let T = len(seq)
    // tied embedding stand-in: embed[byte,c] = deq(readout block5)[byte·d + c].
    let roW = bw[5]; let roS = bs[5]
    let x = []
    let mut q = 0
    while q < T*d { x.push(0.0); q = q + 1 }
    let mut t0 = 0
    while t0 < T {
        let b = seq[t0]; let mut cc = 0
        while cc < d { x[t0*d+cc] = roW[b*d+cc] * roS[b]; cc = cc + 1 }
        t0 = t0 + 1
    }
    _gen_gnorm(x, T, d)
    // entry conv (block0) d→d K3 + GELU + GN
    let xe = []
    let mut a = 0
    while a < T*d { xe.push(0.0); a = a + 1 }
    _gen_conv1d(x, T, d, d, K, 1, bw[0], bs[0], xe)
    let mut g = 0
    while g < T*d { xe[g] = _gen_gelu(xe[g]); g = g + 1 }
    _gen_gnorm(xe, T, d)
    // trunk conv (block1) d→d K3 + residual GELU
    let tr = []
    let mut b2 = 0
    while b2 < T*d { tr.push(0.0); b2 = b2 + 1 }
    _gen_conv1d(xe, T, d, d, K, 1, bw[1], bs[1], tr)
    _gen_gnorm(tr, T, d)
    let mut r2 = 0
    while r2 < T*d { xe[r2] = xe[r2] + _gen_gelu(tr[r2]); r2 = r2 + 1 }
    _gen_gnorm(xe, T, d)
    // experts (block2,3) d→d K3 + GELU
    let ex0 = []; let ex1 = []
    let mut e = 0
    while e < T*d { ex0.push(0.0); ex1.push(0.0); e = e + 1 }
    _gen_conv1d(xe, T, d, d, K, 1, bw[2], bs[2], ex0)
    _gen_conv1d(xe, T, d, d, K, 1, bw[3], bs[3], ex1)
    let mut eg = 0
    while eg < T*d { ex0[eg] = _gen_gelu(ex0[eg]); ex1[eg] = _gen_gelu(ex1[eg]); eg = eg + 1 }
    // router (block4) d→E K1
    let rl = []
    let mut rr = 0
    while rr < T*E { rl.push(0.0); rr = rr + 1 }
    _gen_conv1d(xe, T, d, E, 1, 1, bw[4], bs[4], rl)
    // MoE combine: y = softmax(router)·experts
    let y = []
    let mut yy = 0
    while yy < T*d { y.push(0.0); yy = yy + 1 }
    let mut tt = 0
    while tt < T {
        let l0 = rl[tt*E+0]; let l1 = rl[tt*E+1]
        let m = if l0 > l1 { l0 } else { l1 }
        let p0 = exp(l0-m); let p1 = exp(l1-m); let sm = p0+p1
        let w0 = p0/sm; let w1 = p1/sm
        let mut cc2 = 0
        while cc2 < d { y[tt*d+cc2] = w0*ex0[tt*d+cc2] + w1*ex1[tt*d+cc2]; cc2 = cc2 + 1 }
        tt = tt + 1
    }
    _gen_gnorm(y, T, d)
    // readout (block5) d→V K1 → logits[T·V]
    let lg = []
    let mut li = 0
    while li < T*V { lg.push(0.0); li = li + 1 }
    _gen_conv1d(y, T, d, V, 1, 1, bw[5], bs[5], lg)
    // next-byte CE: position p predicts seq[p+1].
    let mut ce = 0.0; let mut np = 0; let mut p = 0
    while p < T - 1 {
        let tgt = seq[p+1]
        let mut mx = lg[p*V+0]; let mut v = 1
        while v < V { if lg[p*V+v] > mx { mx = lg[p*V+v] }; v = v + 1 }
        let mut Z = 0.0; let mut v2 = 0
        while v2 < V { Z = Z + exp(lg[p*V+v2]-mx); v2 = v2 + 1 }
        ce = ce - ((lg[p*V+tgt]-mx) - ln(Z))
        np = np + 1; p = p + 1
    }
    let mean_ce = if np > 0 { ce / to_float(np) } else { 0.0 }
    return #{ "ce": mean_ce, "baseline": base, "positions": np,
              "below_uniform": mean_ce < base, "nblk": nblk }
}


// ── §7 small format helper ───────────────────────────────────────────────────

fn _gen_fmt4(x: float) -> string {
    return format_float(x, 4)
}


// ── §8 introspection ─────────────────────────────────────────────────────────

pub fn generator_summary() -> string {
    "core_generator · BACKEND-AGNOSTIC L3 slot (SINGLE .clm entry, a_core_engine_map) · generate(backend, substrate_ctx, emit_decision, anchors) -> {emitted, backend, text, fellback} · backends: null(deterministic substrate placeholder, always ready) + clm(REAL .clm header parse: CLM\\x01 magic + nblocks validated → valid/admitted CORE-side; decode FORWARD now WIRED — clm_decode_ce runs int4 dequant + CLMConvMoE → next-byte logits → real CE measured CORE-mounted; loaded=false stays honest while inference-track .clm omits trained embed+GN affine → CE measurable but not descending → null fallthrough, no garbage) · anchor READ via kosmos_io.load_anchors (SINGLE .kosmos entry) · SILENT⇒no content, EMIT⇒content · p1..p8 clean (no LLM/system-prompt/persona)"
}
