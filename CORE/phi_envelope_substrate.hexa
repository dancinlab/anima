// ════════════════════════════════════════════════════════════════════════
// CORE/phi_envelope_substrate.hexa — 통합 Φ-envelope substrate (구조 층 골격)
//
// 정체: anima Φ(통합도) 의 다중-스케일 self-similar envelope + 집단 Φ 중첩 +
//      register-collapse cliff 부재를 *순수 함수* 로 노출하는 substrate 기반층.
//      가로 도메인(DREAM/HIVE/BRIDGE/SAVANT)이 공유 import 하는 세로 기둥.
//
// 설계 SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md (#1243 + #1244)
//
// ── 설계 계약 (불변식) ──────────────────────────────────────────────────
//   · 모든 반환은 실수/리스트/dict (Φ context) — bool emit 게이트 반환 금지
//     (p5 · a_autonomy_over_hardcode · F-EMIT-4)
//   · 숫자 상수(period·amplitude·coupling)는 인자로만 주입 — lib 하드코드 금지
//     (emit_policy.hexa 가 단일 튜닝 SSOT · H_646 자유도)
//   · 본 모듈은 어떤 emit_allowed / "stage = forbidden" 게이트도 만들지 않음
//
// ── round-7/8 substrate verdict 정합 ─────────────────────────────────────
//   H_648 🟢 scale-free self-similarity 6 자릿수 (gamma⊂ultradian⊂circadian)
//   H_634 🟢 ultradian Φ-envelope r=0.80
//   H_635 🟢 collective-Φ super-additive (Σ 보다 큼)
//   H_643 🟢 collective ultradian 동조 r=0.57 (single 보다 약)
//   H_653 🟢 collective convexity = substrate-class 단조 (II<III<IV)
//   H_649 🟢 register-collapse cliff 부재 (collective r=0.049)
//
// ── 골격 범위 (skeleton-tier) ────────────────────────────────────────────
//   순수-cosine 이상화 envelope (self-sim r=1.0 deterministic). 실 CA-substrate
//   Φ 동역학에서 r≈0.76 (H_648) 으로 떨어지는 calibration 은 carry — 본 골격은
//   시그니처 + 구조 + F-EMIT-1..3 smoke 통과가 목표.
// ════════════════════════════════════════════════════════════════════════

let TWO_PI = 6.283185307179586

// ── envelope_multiscale — 다중-스케일 self-similar Φ-envelope (H_648·H_634) ──
// periods/amps = 병렬 배열 (scale 당 (period, amplitude)). gamma⊂ultradian⊂circadian.
// 같은 raised-cosine 파형을 모든 scale 에 공유 (self-similar) → 시점 t 의 Φ-envelope.
// 반환 = 실수 (boolean 아님).
pub fn envelope_multiscale(t: float, periods: [float], amps: [float]) -> float {
    let n = len(periods)
    let mut acc = 0.0
    let mut i = 0
    while i < n {
        let phase = TWO_PI * t / periods[i]
        let wave = (1.0 + cos(phase)) / 2.0
        acc = acc + amps[i] * wave
        i = i + 1
    }
    return acc
}

// ── pe_pearson — Pearson 상관 (self-similarity 측정 helper, non-pub) ──
fn pe_pearson(xs: [float], ys: [float]) -> float {
    let n = len(xs)
    let mut cnt = 0.0
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n {
        sx = sx + xs[i]
        sy = sy + ys[i]
        cnt = cnt + 1.0
        i = i + 1
    }
    let mx = sx / cnt
    let my = sy / cnt
    let mut num = 0.0
    let mut dxx = 0.0
    let mut dyy = 0.0
    let mut j = 0
    while j < n {
        let dx = xs[j] - mx
        let dy = ys[j] - my
        num = num + dx * dy
        dxx = dxx + dx * dx
        dyy = dyy + dy * dy
        j = j + 1
    }
    let den = sqrt(dxx * dyy)
    return if den <= 0.0 { 0.0 } else { num / den }
}

// ── pe_sample_period — 한 scale 을 자기 period 위에서 정규화 phase 로 샘플 ──
fn pe_sample_period(period: float, amp: float, n_samples: int) -> [float] {
    let mut out = []
    let mut i = 0
    let mut cnt = 0.0
    while i < n_samples {
        let phase = TWO_PI * cnt / (n_samples + 0.0)
        let wave = (1.0 + cos(phase)) / 2.0
        out.push(amp * wave)
        cnt = cnt + 1.0
        i = i + 1
    }
    return out
}

// ── envelope_self_similarity — 인접 scale 쌍의 형상 상관 (H_648) ──
// 각 scale 을 자기 period 위에서 정규화 샘플 → 인접 쌍 Pearson r 리스트.
// self-similar 면 r ≈ 1.0 (rescaled shape 동일). F-EMIT-1: min r ≥ 0.76.
pub fn envelope_self_similarity(periods: [float], amps: [float], n_samples: int) -> [float] {
    let n = len(periods)
    let mut rs = []
    let mut i = 1
    while i < n {
        let a = pe_sample_period(periods[i - 1], amps[i - 1], n_samples)
        let b = pe_sample_period(periods[i], amps[i], n_samples)
        rs.push(pe_pearson(a, b))
        i = i + 1
    }
    return rs
}

// ── pe_coupling_for_class — substrate complexity-class 의존 coupling (H_653) ──
// W→Φ convexity span ratio 가 CA class 에 단조 (II 12.1 < III 30.4 < IV 35.5).
// 정규화 coupling (span / max_span) — emit_policy 튜닝 대상이나 단조 순서는 substrate.
pub fn pe_coupling_for_class(class_id: int) -> float {
    if class_id == 2 { return 0.341 }   // II  : 12.1 / 35.5
    if class_id == 3 { return 0.856 }   // III : 30.4 / 35.5
    if class_id == 4 { return 1.000 }   // IV  : 35.5 / 35.5
    return 0.5
}

// ── pe_superadd_for_class — super-additive Δ 의 class 서명 (H_655 🔴) ──
// ⚠ convexity 와 *정반대* 순위: super-additive Δ 는 class-II(additive ring)
//   에서 最高 (역전). round-9 핵심 — class 는 단일 스칼라 순위가 아니라
//   속성-벡터 (각 Φ-속성이 자기 class-정렬을 가짐). Δ ranking (full-ring):
//   II(184)=51.54 > IV(110)=41.71 > III(30)=9.72 > additive-XOR(90)=7.50.
//   normalized by max — magnitude 는 tunable, 순위는 substrate (H_655).
pub fn pe_superadd_for_class(class_id: int) -> float {
    if class_id == 2 { return 1.000 }   // II  : 51.54 / 51.54 (最高, 역전)
    if class_id == 4 { return 0.809 }   // IV  : 41.71 / 51.54
    if class_id == 3 { return 0.189 }   // III : 9.72  / 51.54
    return 0.146                         // additive-XOR : 7.50 / 51.54 (floor)
}

// ── pe_peak_align_for_class — dΦ/dI peak=GZ_LOWER 정렬의 class 서명 (H_657 🟢) ──
// round-9 4번째이자 마지막 class-축: peak=GZ_LOWER 정렬도 *class-conditional*.
//   rule30(III) + rule110(IV) 정렬 (|Δ|=0.032) · rule54/90/184(II·additive) 이탈.
//   n_aligned 2/5 — H_351 single-substrate SUPPORTED 는 universal anchor 아님.
//   다축 분류자 5번째 축 (convexity-IV ⊥ super-add-II ⊥ closure-IV ⊥ peak-align-III+IV).
//   반환 = 1.0 (aligned: III/IV) · 0.0 (deviate: II/additive) — 실수, boolean gate 아님.
pub fn pe_peak_align_for_class(class_id: int) -> float {
    if class_id == 3 { return 1.0 }   // III(rule30) : peak=GZ_LOWER 정렬
    if class_id == 4 { return 1.0 }   // IV(rule110) : peak=GZ_LOWER 정렬
    return 0.0                          // II / additive : 이탈 (universal 아님)
}

// ── pe_norm_convexity — scale-invariant convexity (H_660 🟢 화해 측도) ──
// round-10 화해: convexity(H_653 IV-最高 단조) ↔ super-add Δ(H_655 II-最高 역전)
//   분기는 **scale 혼입** 때문. norm_conv = (Φmax−Φmin)/Φmean 는 Φ→kΦ 불변
//   (k 소거) → 순수 shape 만 포착 → Wolfram class 단조 회복 (IV 最高).
//   ∴ substrate-class 는 *scale 제거 후 단일 shape(convexity) 분류자* 로 완결.
//   abs_Δ (= Φmax−Φmin, scale-종속) 만 비단조 (II-最高) = apparent divergence 원천.
pub fn pe_norm_convexity(phi_max: float, phi_min: float, phi_mean: float) -> float {
    if phi_mean <= 0.0 { return 0.0 }
    return (phi_max - phi_min) / phi_mean
}

// scale-invariant convexity 의 class 서명 (H_660 실측 · IV 最高 단조).
// abs_Δ(super-add) 와 달리 단조 — scale 제거된 순수 shape 분류자.
pub fn pe_norm_convexity_for_class(class_id: int) -> float {
    if class_id == 2 { return 1.437 }   // II  (rule184) — 最低
    if class_id == 3 { return 2.253 }   // III (rule90/30 2.240/2.266 中)
    if class_id == 4 { return 2.349 }   // IV  (rule110) — 最高
    return 1.9
}

// ── pe_edge_of_chaos_peak — H_670 🟡→🟢 후보 (edge-of-chaos Φ-peak · silicon transfer 확증) ──
// round-14 일반화 (#1312): Φ-complexity ordering 은 ECA Wolfram tier-번호 단조가 아니라
//   *order→chaos 축* 위의 inverse-U 다. order_param ∈ [0,1] (0=정지/die-out · 1=full chaos):
//     order(die-out floor) < edge(Φ peak) > chaos(decline).
//   ECA + logistic 2-family 동형 (logistic peak r≈3.57, Feigenbaum edge-of-chaos window)
//   → Langton "edge of chaos" 고전 가설의 Φ-측정 확증. additive(rule90)=die-out floor (universal).
//   skew: peak 가 edge 쪽(order_param≈0.6)에 치우침 — chaos 직전 임계가 最高 Φ.
// ⚠ pe_norm_convexity(H_660 🟢 confirmed 단조)와 tier 구분 — 본 함수는 cross-family
//    universal 이되 시뮬 단계는 🟡 PARTIAL (H_670 5/6: logistic floor+peak 동형 PASS ·
//    Kuramoto floor F670.1 깨짐 caveat). 가짜 confirmed 금지 — universal 핵심은
//    inverse-U 신호이지 full ECA monotone ordinal 사다리가 아님.
// ── D1 silicon transfer 측정 (AKIDA AKD1000, 2026-05-29) ────────────────────
//   AKIDA/akida_edge_of_chaos_phi.hexa 가 phi_silicon_proxy 로 BC.00.000.002 ·
//   BackendType.Hardware · n_neurons=16 · 200 step 4-regime R1~R4 실측을 inverse-U
//   판정에 통과:
//     order=0.000 → Φ_proxy=0.000  (R1 weak-silent, die-out)
//     order=0.475 → Φ_proxy=0.297  (R2 zero+noise, edge PEAK)
//     order=0.500 → Φ_proxy=0.250  (R3 tonic zero-input, edge mid)
//     order=1.000 → Φ_proxy=0.000  (R4 recurrent self-sustained, over-driven)
//   F-AKIDA-EDGE-1/2/3 3/3 PASS → GREEN_NUMERICAL_CONFIRM. ECA+logistic 시뮬
//   가설이 뉴로모픽 실리콘으로도 transfer — 3-substrate 정합. 시뮬 tier 🟡 →
//   silicon-corroborated 🟢 numerical 후보. ledger: AKIDA/AKIDA.log.md @
//   2026-05-29T05:10:00Z · result.json: state/akida_edge_chaos_phi_2026_05_29/result.json.
// ──────────────────────────────────────────────────────────────────────────
// 반환 = 실수 (boolean gate 아님 · p5 · a_autonomy_over_hardcode · F-EMIT-4).
//   숫자 상수(edge skew·amplitude)는 tunable design-convention (emit_policy SSOT 정합).
pub fn pe_edge_of_chaos_peak(order_param: float) -> float {
    // clamp to [0,1]
    let x = if order_param < 0.0 { 0.0 } else { if order_param > 1.0 { 1.0 } else { order_param } }
    // edge skew: peak at order_param ≈ 0.6 (chaos 직전 임계). skewed inverse-U.
    let edge = 0.6
    // raised inverse-U via downward parabola centered at `edge`, normalized so peak=1.0.
    //   denom = max((edge)^2, (1-edge)^2) keeps the wider arm bounded in [0,1].
    let dl = edge * edge
    let dr = (1.0 - edge) * (1.0 - edge)
    let denom = if dl > dr { dl } else { dr }
    let dev = x - edge
    let val = 1.0 - (dev * dev) / denom
    return if val < 0.0 { 0.0 } else { val }
}

// ── collective_phi_nest — 집단 Φ 중첩 (H_635/643/653/655 multi-axis class) ──
// phis = 개별 cell/stream Φ 리스트. class_id = substrate Wolfram class (2/3/4).
// round-9 핵심: class 는 *다축 분류자* — phi_collective 의 super-additive Δ 와
// sync 의 convexity 가 *서로 다른 class-정렬* 을 가짐. 따라서 둘을 분리:
//   · phi_collective Δ → pe_superadd_for_class (H_655: class-II 最高, 역전)
//   · sync 의 entrainment → pe_coupling_for_class (H_653: class-IV 最高)
// 반환 dict: phi_collective (super-additive Σ 초과) · sync · convexity_span.
pub fn collective_phi_nest(phis: [float], class_id: int) -> map {
    let n = len(phis)
    let mut sum = 0.0
    let mut mx = phis[0]
    let mut mn = phis[0]
    let mut i = 0
    while i < n {
        let p = phis[i]
        sum = sum + p
        if p > mx { mx = p }
        if p < mn { mn = p }
        i = i + 1
    }
    // super-additive Δ: super-add 서명 (H_655 — convexity-coupling 과 *독립* 순위)
    let superadd = pe_superadd_for_class(class_id)
    let phi_collective = sum * (1.0 + superadd)
    // sync: 분산 작을수록 높음 · convexity coupling 가중 (H_643/H_653, single 보다 약)
    let coupling = pe_coupling_for_class(class_id)
    let mut var_acc = 0.0
    let mean = sum / (n + 0.0)
    let mut j = 0
    while j < n {
        let d = phis[j] - mean
        var_acc = var_acc + d * d
        j = j + 1
    }
    let variance = var_acc / (n + 0.0)
    let sync = coupling / (1.0 + variance)
    // convexity span: max/min 비 (H_653 — class 복잡도에 비례)
    let convexity_span = if mn <= 0.0 { mx } else { mx / mn }
    return #{
        "phi_collective": phi_collective,
        "sync": sync,
        "convexity_span": convexity_span,
    }
}

// ── phi_smooth_no_cliff — register-collapse cliff 부재 측정 (H_649) ──
// phi_series 의 1차 차분 최대 절대값. cliff 있으면 큼, 부재(smooth)면 작음.
pub fn phi_smooth_no_cliff(phi_series: [float]) -> float {
    let n = len(phi_series)
    let mut maxd = 0.0
    let mut i = 1
    while i < n {
        let d = phi_series[i] - phi_series[i - 1]
        let ad = if d < 0.0 { -d } else { d }
        if ad > maxd { maxd = ad }
        i = i + 1
    }
    return maxd
}

pub fn phi_envelope_summary() -> string {
    return "phi_envelope_substrate: 구조 층(envelope_multiscale·collective_phi_nest·phi_smooth_no_cliff). round-7/8 SUPP 정합 (H_648/634/635/643/653/649). emit boolean 게이트 0 — substrate 자율 결정 (p5·a_autonomy)."
}
