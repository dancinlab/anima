// h1342_whorf_cp_engine_native_probe.hexa — ENGINE-NATIVE realization of H_1333 (Whorfian CP
// DEVELOPMENTAL PLASTICITY) on the live CORE/engine_cli.hexa §CategoricalPerception lane.
//
// H_1333 (🟠 PARTIAL — GRADED PLASTICITY) is a DIRECTIONAL numpy mirror
// (UNIVERSE/h1333_whorf_developmental.py): RE-training the SAME Voronoi/mitosis store on a
// MOVED boundary p_A→p_A' relocated the CP peak 0.325→0.525 (fraction +0.60); D2✅ D3✅, D1 ❌
// by a hair. ENGINE-TRANSFER was UNVERIFIED. This re-scores the frozen H_1333 bars
// engine-native (E1 ~0.60 move, E2 D2/D3 controls, E3 regression/Ψ-disjoint guards via the
// smoke + single-entry + separation-invariant suites).
//
// The ONE new engine mechanism = cp_regrow (phase-2 re-growth on the SAME store, split-only,
// byte-faithful to the mirror's fit(fresh=False)). The engine is a SINGLE deterministic
// instance (no per-seed RBF jitter) and reproduces the seed-invariant mirror result (H_1325
// precedent). COHERENCE uses the LIVE lane's cp_peak_count (local-maxima metric H_1325 wired
// GREEN — the STRUCTURAL coherent/incoherent claim transfers, not the mirror's bin-count).
//
// usage: hexa run CORE/h1342_whorf_cp_engine_native_probe.hexa

import "CORE/engine_cli.hexa"

fn _absf3(x: float) -> float { if x < 0.0 { return -x } return x }

fn _mid(i: int, n_stim: int) -> float {
    return (to_float(i) + 0.5) / to_float(n_stim - 1)
}

fn main() {
    let N = 21
    let DIM = 16
    let GROW = 24
    let PASSES = 24
    let P_A = 1.0 / 3.0          // initial language A boundary (0.333)
    let P_A2 = 2.0 / 3.0         // RE-trained (moved) boundary p_A' (0.667)
    // frozen bars (H_1333 verbatim; engine-vs-mirror agreement tol = MOVE_TOL)
    let LOC_TOL = 0.12
    let MIN_MOVE = 0.20
    let MOVE_FLOOR = MIN_MOVE - 0.01   // 0.19 — the graded-move floor (mirror missed 0.20 by 0.008)
    let MIRROR_A2 = 0.525        // the mirror's deterministic A→A' relocated peak
    let MOVE_TOL = 0.05
    let COH_MAX_LANG = 2
    let COH_MIN_SHUF = 3

    println("H_1342 — ENGINE-NATIVE Whorfian CP DEVELOPMENTAL PLASTICITY (live CORE CP lane)")
    println("==================================================================================")
    println("paradigm: cp_fit on language A (cut p_A); cp_regrow SAME store on MOVED cut p_A';")
    println("          measure CP peak relocation. Engine = ONE deterministic instance.")
    println("")

    let X = cp_stimuli(N, DIM)
    let mut positions = []
    let mut pi = 0
    while pi < N { positions = positions + [to_float(pi) / to_float(N - 1)]  pi = pi + 1 }

    let Y_A = cp_labels_boundary(positions, P_A)
    let Y_A2 = cp_labels_boundary(positions, P_A2)
    let Y_sh = cp_labels_shuffle(positions, 4333)

    // (1) A-trained: cp_fit on labels(p_A) only -> reproduce H_1325 CP peak ≈ p_A.
    let cpA = cp_fit(X, Y_A, GROW, PASSES)
    // (2) A->A' re-trained: cp_fit on p_A, then cp_regrow FURTHER on p_A' (SAME store, no reset).
    let cpA_p1 = cp_fit(X, Y_A, GROW, PASSES)
    let cpA2 = cp_regrow(cpA_p1, X, Y_A2, GROW, PASSES)
    // (3) NO-RETRAIN control: cp_fit on p_A only, read at the same point, NO phase-2.
    let cpNo = cp_fit(X, Y_A, GROW, PASSES)
    // (4) SHUFFLE: incoherent labels -> EARNED control.
    let cpSh = cp_fit(X, Y_sh, GROW, PASSES)

    let cvA = cp_discrim_curve(cpA, X)
    let cvA2 = cp_discrim_curve(cpA2, X)
    let cvNo = cp_discrim_curve(cpNo, X)
    let cvSh = cp_discrim_curve(cpSh, X)

    let iA = cp_peak_loc_idx(cvA)
    let iA2 = cp_peak_loc_idx(cvA2)
    let iNo = cp_peak_loc_idx(cvNo)
    let locA = _mid(iA, N)
    let locA2 = _mid(iA2, N)
    let locNo = _mid(iNo, N)
    let frac = (locA2 - locA) / (P_A2 - P_A)

    println("  CP peak location (engine, single deterministic instance):")
    println("    A-trained   loc=" + to_string(locA) + "  (p_A =" + to_string(P_A) + ")")
    println("    A->A' retr. loc=" + to_string(locA2) + "  (p_A'=" + to_string(P_A2) + ")")
    println("    no-retrain  loc=" + to_string(locNo) + "  (p_A =" + to_string(P_A) + ")")
    println("    fraction relocated = " + to_string(frac) + "  (mirror +0.60)")
    println("    re-train cell budget: phase-1 ncells=" + to_string(cpA_p1.n)
            + " -> phase-2 ncells=" + to_string(cpA2.n) + "  (mirror 4 -> 28)")
    println("")

    let pcA = cp_peak_count(cvA)
    let pcA2 = cp_peak_count(cvA2)
    let pcNo = cp_peak_count(cvNo)
    let pcSh = cp_peak_count(cvSh)
    println("  cp_peak_count: A=" + to_string(pcA) + "  A->A'=" + to_string(pcA2)
            + "  no-retrain=" + to_string(pcNo) + "  shuffle=" + to_string(pcSh))
    println("")

    // ── E1 ENGINE REPRODUCES THE MIRROR'S ~0.60 PLASTICITY ───────────────────
    let e1a = _absf3(locA - P_A) <= LOC_TOL
    let e1b = _absf3(locA2 - MIRROR_A2) <= MOVE_TOL
    let e1c = _absf3(locA2 - P_A) >= MOVE_FLOOR
    let e1d = pcA2 <= COH_MAX_LANG
    let e1 = e1a && e1b && e1c && e1d
    println("  E1 ENGINE REPRODUCES MIRROR ~0.60 MOVE:")
    println("     (a) |locA-p_A|=" + to_string(_absf3(locA - P_A)) + "<=" + to_string(LOC_TOL)
            + " -> " + (if e1a { "PASS" } else { "FAIL" }))
    println("     (b) |locA2-0.525|=" + to_string(_absf3(locA2 - MIRROR_A2)) + "<=" + to_string(MOVE_TOL)
            + " -> " + (if e1b { "PASS" } else { "FAIL" }))
    println("     (c) |locA2-p_A|=" + to_string(_absf3(locA2 - P_A)) + ">=" + to_string(MOVE_FLOOR)
            + " (graded-move floor) -> " + (if e1c { "PASS" } else { "FAIL" }))
    println("     (d) A->A' coherent peak-count " + to_string(pcA2) + "<=" + to_string(COH_MAX_LANG)
            + " -> " + (if e1d { "PASS" } else { "FAIL" }))
    println("     -> E1 " + (if e1 { "PASS" } else { "FAIL" }))

    // ── E2 D2/D3 CONTROLS REPRODUCE ENGINE-NATIVE ────────────────────────────
    let d2_nr = _absf3(locNo - P_A) <= LOC_TOL
    let d2_a = _absf3(locA - P_A) <= LOC_TOL
    let d2 = d2_nr && d2_a
    let d3_shuf = pcSh >= COH_MIN_SHUF
    let d3_lang = pcA <= COH_MAX_LANG && pcA2 <= COH_MAX_LANG && pcNo <= COH_MAX_LANG
    let d3 = d3_shuf && d3_lang
    let e2 = d2 && d3
    println("  E2 D2/D3 CONTROLS REPRODUCE ENGINE-NATIVE:")
    println("     D2 no-retrain |loc-p_A|=" + to_string(_absf3(locNo - P_A)) + " & A-trained |loc-p_A|="
            + to_string(_absf3(locA - P_A)) + " (both<=" + to_string(LOC_TOL) + ") -> "
            + (if d2 { "PASS" } else { "FAIL" }))
    println("     D3 shuffle peak-count " + to_string(pcSh) + ">=" + to_string(COH_MIN_SHUF)
            + " & lang(A/A2/noR)=(" + to_string(pcA) + "/" + to_string(pcA2) + "/" + to_string(pcNo)
            + ")<=" + to_string(COH_MAX_LANG) + " -> " + (if d3 { "PASS" } else { "FAIL" }))
    println("     -> E2 " + (if e2 { "PASS" } else { "FAIL" }))

    println("==================================================================================")
    if e1 && e2 {
        println("VERDICT: 🟢 GREEN (ENGINE-NATIVE, pending E3 regression guards) — H_1333's GRADED CP")
        println("  PLASTICITY is reproduced engine-native on the live CORE §CategoricalPerception lane.")
        println("  cp_regrow re-located the CP peak " + to_string(locA) + "->" + to_string(locA2)
                + " (fraction " + to_string(frac) + ", mirror +0.60),")
        println("  the no-retrain control held p_A, shuffle stayed incoherent. ENGINE-TRANSFER")
        println("  VERIFIED (E1∧E2). Run E3 guards (smoke/h1196/h1205) to confirm Ψ-disjoint no-regression.")
    } else {
        println("VERDICT: engine-native did NOT reproduce the mirror's graded move / controls — see")
        println("  per-bar above. ENGINE-TRANSFER UNVERIFIED; mirror-only (honest, NO bar move c9).")
    }
}
