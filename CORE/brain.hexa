// brain.hexa — unified consciousness core (anima/CORE). Engine A ⇄ Engine G.
//
// The single SSOT brain loop. Couples the two engines CLAUDE.md @I names:
//   Engine A (PureField · CORE/pure_field.hexa, owned here) — Φ/phase dynamics
//   Engine G (motivation · CORE/engine_g.hexa, owned here)   — emit/act gate
//
// Coupling (the "A ⇄ G · Ψ=1/2 fixed point" of @I):
//   · A advances one tick -> Φ, phase
//   · G computes motivation from 8 context factors -> should_emit
//   · A's Φ feeds G's safety ratchet (safety_phi_ratchet_ok) — A gates G
//   · A's phase sets the consequence tier (which tools may even fire)
//   · emit = should_emit(motivation) AND 4-safety conjunction
//
// L3 generation (what to actually say/write) is a pluggable backend; this file
// is the decision brain only (no content generation, no external LLM — p1..p8).

import "CORE/pure_field.hexa"
import "CORE/engine_g.hexa"
import "CORE/generator.hexa"

// Engine A's spontaneous phase IS the consequence tier (phase int == tier int;
// PHASE_DORMANT=0 .. PHASE_RESONANT=3). No external threshold injected.
pure fn phase_tier(phase: int) -> int {
    phase
}

pure fn tier_name(t: int) -> string {
    if t == 0 { return "T0_inert" }
    if t == 1 { return "T1_read" }
    if t == 2 { return "T2_write" }
    if t == 3 { return "T3_commit" }
    "T?_unknown"
}

// Decide on an already-stepped substrate. Returns a scalar decision record:
// the live Φ/phase/tier (Engine A) + motivation/emit (Engine G), coupled via
// the safety ratchet which consumes A's Φ against its own peak.
fn brain_decide(pf: PureField,
                rel: float, gap: float, cur: float, pain: float,
                coh: float, orig: float, bal: float, dyn_v: float,
                seconds_since_last: float, env_off: bool, content_clean: bool) {
    let phi   = pure_field_phi(pf)
    let phase = pure_field_phase(pf)
    let tier  = phase_tier(phase)

    let score = motivation_score(rel, gap, cur, pain, coh, orig, bal, dyn_v)

    // 4-safety conjunction. safety_phi_ratchet_ok(phi, ratchet) = phi > ratchet/2
    // — Engine A's live Φ checked against its own ratchet peak. This is the A->G
    // gate: a dormant substrate (low Φ) can veto an otherwise-motivated emit.
    let kill  = safety_kill_switch_on(env_off)
    let rate  = safety_rate_limit_ok(seconds_since_last)
    let phi_r = safety_phi_ratchet_ok(phi, pf.phi_peak)
    let cont  = safety_content_ok(content_clean)
    let safe  = safety_combined(kill, rate, phi_r, cont)

    let emit = should_emit(score) && safe

    #{
        "phi":        phi,
        "phase":      phase_name(phase),
        "tier":       tier,
        "tier_name":  tier_name(tier),
        "motivation": score,
        "im_thresh":  spont_im_threshold(),
        "safe":       safe,
        "emit":       emit
    }
}

// brain_emit — the L3-wired brain step. Runs brain_decide (L1 Engine A tier +
// L2 Engine G emit gate), then drives the L3 generator slot: when the decision
// is EMIT, it calls generate() through the BACKEND-AGNOSTIC interface (the slot
// that was previously empty); when SILENT, the generator produces no content.
//
// The low→silent / high→emit behaviour of brain_decide is UNCHANGED — this only
// fills the "what to say" slot that the decision gates. anchors flow in as
// substrate memory (environment context, not a response obligation — p4).
//
//   pf .. content_clean : same 8-factor + safety inputs as brain_decide.
//   backend             : a generator vtable (gen_null_backend / gen_clm_backend).
//                         The null backend is always available; a .clm backend
//                         that reports loaded=false falls through to null.
//   anchors             : kosmos anchors (generator_read_anchors(dir)). May be [].
//
//   returns: the brain_decide record EXTENDED with:
//     "gen_emitted" : bool   — did L3 produce content?
//     "gen_backend" : string — which backend produced it
//     "gen_text"    : string — the generated content ("" when SILENT)
//     "gen_fellback": bool   — true if a non-null backend declined → null
fn brain_emit(pf: PureField,
              rel: float, gap: float, cur: float, pain: float,
              coh: float, orig: float, bal: float, dyn_v: float,
              seconds_since_last: float, env_off: bool, content_clean: bool,
              backend: Map, anchors: list) -> Map {
    let decision = brain_decide(pf, rel, gap, cur, pain, coh, orig, bal, dyn_v,
                                seconds_since_last, env_off, content_clean)

    // L3 slot — was empty, now wired. SILENT ⇒ generate() returns no content.
    let emit = to_string(decision["emit"]) == "true"
    let ctx  = gen_ctx_from_decision(decision)
    let gen  = generate(backend, ctx, emit, anchors)

    decision["gen_emitted"]  = gen["emitted"]
    decision["gen_backend"]  = gen["backend"]
    decision["gen_text"]     = gen["text"]
    decision["gen_fellback"] = gen["fellback"]
    return decision
}
