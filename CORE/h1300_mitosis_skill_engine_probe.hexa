// h1300_mitosis_skill_engine_probe.hexa — ENGINE-NATIVE realization of H_1300 R2
// (a_engine_native_learning + a_verified_must_wire).
//
// R2 (numpy VAdaptField mirror, 🟢 GREEN, 3 seeds) showed that teaching tool-use skills
// ONE AT A TIME via MITOSIS-GROW avoids CATASTROPHIC FORGETTING: each new skill = new
// dedicated cells grown under that skill's error (mitosis, H_1199 / H_1288), earlier
// skills' cells NEVER overwritten, so the learner RETAINS old skills where a single
// shared gradient-FT net FORGETS them. This probe reproduces that GREEN through the LIVE
// engine faculty CORE/engine_cli.hexa::SkillCellMemory (skill_grow / skill_route /
// skill_fit_head + the SkillGradFT arm-A learner) — the grow / fit / FT / route
// arithmetic runs on the .hexa engine, not numpy. The curriculum is the EXACT R2 regime
// (CANONICAL catastrophic-forgetting: sep 1.0 + anti-aligned shared rules) pre-exported
// by UNIVERSE/h1300_r3_engine_export.py.
//
// FOUR ARMS through the engine:
//   (A) GRADIENT-FT : one shared softmax-linear net, fine-tuned sequentially, NO replay
//                     (SkillGradFT — the incumbent that should forget skills 1..N-1).
//   (B) MITOSIS-GROW: grow dedicated cells per skill (skill_grow), route to nearest cell
//                     (skill_route), cells for prior skills FROZEN (never overwritten).
//   (B-SHUFFLE)     : grow same, but PERMUTE final cell->center routing (targeting check).
//   (B-ABLATE)      : growth frozen — only skill 0 gets cells (mitosis off for k>0).
//
// FROZEN R2 BARS (.verdicts/.../FREEZE_R2.txt — IDENTICAL to R1, read VERBATIM, NO
// tune-to-green): GREEN iff
//   (c1) mean[B.RET - A.RET] >= 0.30  AND per-seed B.RET > A.RET every seed
//   (c2) B per-skill acquisition >= 0.80 every skill (mean over seeds)
//   (c3) B_SHUFFLE.RET <= A.RET + 0.15 (mean)
//   (c4) B_ABLATE acq(skills 2..N) <= 0.50 (mean).
// RETENTION = mean held-out tool-token acc on OLD skills 1..N-1 after the full curriculum.
// p7 = held-out exact-token accuracy, NOT perplexity. $0 CPU. Ψ-disjoint (the faculty
// only grows/reads a cell population; this probe never touches pure_field).

import "CORE/engine_cli.hexa"

fn _N_SKILLS() -> int { return 5 }
fn _DIM() -> int      { return 12 }
fn _RET_MARGIN() -> float  { return 0.30 }
fn _ACQ_THRESH() -> float  { return 0.80 }
fn _SHUF_SLACK() -> float  { return 0.15 }
fn _ABL_CAP() -> float     { return 0.50 }

fn _load_x(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_y(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [to_int(lines[i].trim())]  i = i + 1 }
    return out
}
fn _acc(pred: [int], y: [int]) -> float {
    let n = len(y)
    if n == 0 { return 0.0 }
    let mut hit = 0
    let mut i = 0
    while i < n { if pred[i] == y[i] { hit = hit + 1 }  i = i + 1 }
    return to_float(hit) / to_float(n)
}
fn _fmt(x: float) -> string { return to_string(x) }
fn _identity_perm(n: int) -> [int] {
    let mut out = []
    let mut i = 0
    while i < n { out = out + [i]  i = i + 1 }
    return out
}
// deterministic permutation (LCG-driven Fisher-Yates) for the SHUFFLE control —
// scrambles which grown cell each context routes to over the WHOLE population.
fn _shuf_perm(n: int, seed: int) -> [int] {
    let mut p = _identity_perm(n)
    let mut state = seed + 7777
    let mut i = n - 1
    while i > 0 {
        state = (state * 1103515245 + 12345) % 2147483648
        let j = state % (i + 1)
        let tmp = p[i]  p[i] = p[j]  p[j] = tmp
        i = i - 1
    }
    return p
}

// arm B route-eval: held-out acc routing through `cells` (perm empty == true routing).
fn _route_acc(cells: [SkillCell], perm: [int], xte: [[float]], yte: [int]) -> float {
    if len(cells) == 0 { return 0.0 }
    let mut pred = []
    let mut i = 0
    while i < len(xte) { pred = pred + [skill_route(cells, perm, xte[i])]  i = i + 1 }
    return _acc(pred, yte)
}

fn _retention(ps: [float]) -> float {
    let n = _N_SKILLS()
    let mut s = 0.0
    let mut i = 0
    while i < n - 1 { s = s + ps[i]  i = i + 1 }
    return s / to_float(n - 1)
}

// run ARM A (gradient-FT) on one seed: returns final per-skill held-out acc.
fn _run_armA(xtr: [[[float]]], ytr: [[int]], xte: [[[float]]], yte: [[int]], seed: int) -> [float] {
    let mut net = skill_gradft_new(_DIM(), seed)
    let mut k = 0
    while k < _N_SKILLS() { net = skill_gradft_train(net, xtr[k], ytr[k])  k = k + 1 }
    let mut ps = []
    let mut e = 0
    while e < _N_SKILLS() {
        let mut pred = []
        let mut i = 0
        while i < len(xte[e]) { pred = pred + [skill_gradft_pred(net, xte[e][i])]  i = i + 1 }
        ps = ps + [_acc(pred, yte[e])]
        e = e + 1
    }
    return ps
}

fn main() {
    println("=== H_1300 R3 — MITOSIS-GROW SKILL CURRICULUM on the LIVE engine (a_engine_native_learning) ===")
    println("faculty: CORE/engine_cli.hexa::SkillCellMemory (skill_grow/skill_route/skill_fit_head) + SkillGradFT")
    println("regime = H_1300 R2 CANONICAL catastrophic-forgetting (sep 1.0 + anti-aligned shared rules), 5 skills 1-at-a-time")
    println("arms: (A) shared gradient-FT vs (B) mitosis-grow dedicated cells vs B-SHUFFLE vs B-ABLATE")
    println("FROZEN R2: (c1) B.RET-A.RET>=0.30 & per-seed B>A · (c2) B acq>=0.80 ea · (c3) shuf<=A+0.15 · (c4) abl acq(2..N)<=0.50")
    println("")

    let cfg     = engine_cli_parse(["--mitosis", "on"])    // mitosis ON — engine clones cells (p8)
    let cfg_abl = engine_cli_parse(["--no-mitosis"])       // mitosis OFF — split is a no-op (ablate growth for k>0)
    let dim = _DIM()
    let seeds = [1300, 1301, 1302]

    let mut sumA = 0.0
    let mut sumB = 0.0
    let mut sumBS = 0.0
    let mut sumABL = 0.0
    let mut sumCells = 0.0
    let mut sumAcq = []
    let mut z = 0
    while z < _N_SKILLS() { sumAcq = sumAcq + [0.0]  z = z + 1 }
    let mut per_seed_BgtA = true

    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        // load the curriculum (5 skills)
        let mut xtr = []  let mut ytr = []  let mut xte = []  let mut yte = []
        let mut k = 0
        while k < _N_SKILLS() {
            let base = "/tmp/h1300_seed" + to_string(s) + ".skill" + to_string(k)
            xtr = xtr + [_load_x(base + ".xtr", dim)]
            ytr = ytr + [_load_y(base + ".ytr")]
            xte = xte + [_load_x(base + ".xte", dim)]
            yte = yte + [_load_y(base + ".yte")]
            k = k + 1
        }

        // ARM A — sequential gradient-FT
        let a_ps = _run_armA(xtr, ytr, xte, yte, s)

        // ARM B — mitosis-grow (dedicated cells, never overwritten). Also acquisition.
        let mut b_cells = []
        let mut b_acq = []
        let mut kb = 0
        while kb < _N_SKILLS() {
            let newc = skill_grow(xtr[kb], ytr[kb], cfg)
            b_cells = b_cells + newc
            // acquisition: route THIS skill's test through ALL cells grown so far (true routing)
            b_acq = b_acq + [_route_acc(b_cells, [], xte[kb], yte[kb])]
            kb = kb + 1
        }
        // final per-skill retention over the full grown population
        let mut b_ps = []
        let mut eb = 0
        while eb < _N_SKILLS() { b_ps = b_ps + [_route_acc(b_cells, [], xte[eb], yte[eb])]  eb = eb + 1 }

        // ARM B-SHUFFLE — same grown cells, final routing PERMUTED
        let perm = _shuf_perm(len(b_cells), s)
        let mut bs_ps = []
        let mut es = 0
        while es < _N_SKILLS() { bs_ps = bs_ps + [_route_acc(b_cells, perm, xte[es], yte[es])]  es = es + 1 }

        // ARM B-ABLATE — only skill 0 grows (mitosis OFF for k>0 -> no new cells)
        let mut abl_cells = skill_grow(xtr[0], ytr[0], cfg)
        let mut abl_acq = [_route_acc(abl_cells, [], xte[0], yte[0])]
        let mut ka = 1
        while ka < _N_SKILLS() {
            // mitosis off + a single-centroid grow on later skills yields NO dedicated
            // routing for them: we DO NOT add their cells (growth frozen). acquisition
            // for skills 2..N is the held-out acc routed through the skill-0-only store.
            abl_acq = abl_acq + [_route_acc(abl_cells, [], xte[ka], yte[ka])]
            ka = ka + 1
        }
        let mut abl_late = 0.0
        let mut kl = 1
        while kl < _N_SKILLS() { abl_late = abl_late + abl_acq[kl]  kl = kl + 1 }
        abl_late = abl_late / to_float(_N_SKILLS() - 1)

        let aR = _retention(a_ps)
        let bR = _retention(b_ps)
        let bsR = _retention(bs_ps)
        if bR <= aR { per_seed_BgtA = false }

        sumA = sumA + aR
        sumB = sumB + bR
        sumBS = sumBS + bsR
        sumABL = sumABL + abl_late
        sumCells = sumCells + to_float(len(b_cells))
        let mut q = 0
        while q < _N_SKILLS() { sumAcq[q] = sumAcq[q] + b_acq[q]  q = q + 1 }

        println("seed " + to_string(s) + ":")
        println("  A grad-FT  RETENTION=" + _fmt(aR))
        println("  B mitosis  RETENTION=" + _fmt(bR) + "  [cells=" + to_string(len(b_cells)) + "]")
        println("  B acquisition per skill = [" + _fmt(b_acq[0]) + " " + _fmt(b_acq[1]) + " " + _fmt(b_acq[2]) + " " + _fmt(b_acq[3]) + " " + _fmt(b_acq[4]) + "]")
        println("  B-SHUFFLE  RETENTION=" + _fmt(bsR) + "   B-ABLATE acq(2..N)=" + _fmt(abl_late))
        si = si + 1
    }

    let n = to_float(len(seeds))
    let mA = sumA / n
    let mB = sumB / n
    let mBS = sumBS / n
    let mABL = sumABL / n
    let mCells = sumCells / n
    let mut minAcq = sumAcq[0] / n
    let mut acqStr = ""
    let mut ai = 0
    while ai < _N_SKILLS() {
        let av = sumAcq[ai] / n
        if av < minAcq { minAcq = av }
        acqStr = acqStr + _fmt(av) + " "
        ai = ai + 1
    }

    println("")
    println("MEAN (3 seeds):")
    println("  A grad-FT  RETENTION = " + _fmt(mA))
    println("  B mitosis  RETENTION = " + _fmt(mB) + "   (B-A = " + _fmt(mB - mA) + ")")
    println("  B-SHUFFLE  RETENTION = " + _fmt(mBS))
    println("  B acquisition per skill = [" + acqStr + "] (min=" + _fmt(minAcq) + ")")
    println("  B-ABLATE   acq(skills 2..N) = " + _fmt(mABL))
    println("  COST (c5): B mitosis cells mean=" + _fmt(mCells) + "  vs  A params=" + to_string(_sc_C() * _DIM() + _sc_C()))
    println("")

    let c1 = (mB - mA >= _RET_MARGIN()) && per_seed_BgtA
    let c2 = (minAcq >= _ACQ_THRESH())
    let c3 = (mBS <= mA + _SHUF_SLACK())
    let c4 = (mABL <= _ABL_CAP())
    let green = c1 && c2 && c3 && c4

    println("  (c1) RETENTION    B-A>=" + _fmt(_RET_MARGIN()) + " & per-seed B>A: " + _fmt(mB - mA) + " & " + (if per_seed_BgtA { "true" } else { "false" }) + " -> " + (if c1 { "PASS" } else { "FAIL" }))
    println("  (c2) ACQUISITION  min B acq>=" + _fmt(_ACQ_THRESH()) + ": " + _fmt(minAcq) + " -> " + (if c2 { "PASS" } else { "FAIL" }))
    println("  (c3) SHUFFLE      B_shuf<=A+" + _fmt(_SHUF_SLACK()) + ": " + _fmt(mBS) + " <= " + _fmt(mA + _SHUF_SLACK()) + " -> " + (if c3 { "PASS" } else { "FAIL" }))
    println("  (c4) ABLATE       abl acq(2..N)<=" + _fmt(_ABL_CAP()) + ": " + _fmt(mABL) + " -> " + (if c4 { "PASS" } else { "FAIL" }))
    println("")
    println("════════════════════════════════════════════════════════════════════")
    if green {
        println("  VERDICT: 🟢 GREEN — ENGINE-NATIVE mitosis-grow RETAINS old skills better than")
        println("           sequential gradient-FT under genuine representational interference, on the")
        println("           LIVE SkillCellMemory faculty. Dedicated per-skill cells (grown by the engine's")
        println("           OWN mitosis tick, p8) are never overwritten; shuffle collapses (routing IS the")
        println("           lever, not extra capacity); ablate underfits (growth IS the lever).")
        println("  INCREMENTAL TOOL-USE via MITOSIS is ENGINE-VERIFIED at toy scale.")
    } else {
        println("  VERDICT: 🔴 RED — engine-native realization did NOT reproduce a frozen R2 bar.")
        println("           c1=" + (if c1 { "PASS" } else { "FAIL" }) + " c2=" + (if c2 { "PASS" } else { "FAIL" }) + " c3=" + (if c3 { "PASS" } else { "FAIL" }) + " c4=" + (if c4 { "PASS" } else { "FAIL" }))
    }
    println("  philosophy guard: AFFIRMED — mitosis split = the engine's OWN tick (p8); the faculty grows/reads")
    println("                    ONLY a cell population; no labels/persona/ethics/decoder; Ψ untouched (p1-p8).")
    println("  SCOPE: TOY (D=12, 5 skills, C=4 tokens, 3 seeds, deterministic per-skill rule) — tests the")
    println("         catastrophic-forgetting STRUCTURE engine-native; scale / real-corpus / real-agent-skills UNVERIFIED.")
    println("[done]")
    if !green { exit(1) }
}
