// h1167_1b_parity_probe.hexa — H_1167 1B ByteGPT engine-mount parity check.
//
// The 1B-rung analogue of h1156_bytegpt_parity_probe.hexa (which proved the 303M
// mount byte-exact, H_1157). Loads the 1B flat-binary ByteGPT (d1792/L28/H16,
// 1.081B params, produced by the H_1167 fire serialize) via the SAME config-agnostic
// CORE bytegpt_decode forward (arch read from the .bin header: vocab,d,nlay,nh,block
// as 5x u32) and prints the last-position next-byte logits for diff against the
// torch GOLDEN (state/h1167_mount/h1167_1b_golden.json).
//
// PARITY CRITERION (a_engine_measured_verdict — engine-measured 1B verdict):
//   argmax(CORE) == golden.argmax (32)  AND
//   top-5 idx set == golden.top5_idx ([32,105,115,101,44])  AND
//   first-16 logits within ~1e-2 abs of golden.last_logits_first16
//   (erf-GELU + dt_exp approximations vs torch exact -> small float residual; the
//    28-layer forward is nonlinear, so a matching argmax+logits proves byte-exact).
//
// PROMPT: "The quick brown" (15 bytes) — identical to the golden prompt.

import "CORE/bytegpt_decode.hexa"

fn main() {
    let path = "state/h1167_mount/h1167_1b.bin"
    // prompt bytes of "The quick brown"
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    while i < T { let _ = farr_set(ids, i, to_float(pb[i])); i = i + 1 }

    // ranged reader (read_bytes_at slices) — the 4.3GB 1B binary cannot be loaded whole
    // (boxed bytes would need ~69GB); bytegpt_forward_last_ranged reads per-slice.
    let logits = bytegpt_forward_last_ranged(path, ids, T)

    // argmax
    let mut am = 0
    let mut mx = farr_get(logits, 0)
    let mut k = 1
    while k < 256 {
        let v = farr_get(logits, k)
        if v > mx { mx = v; am = k }
        k = k + 1
    }
    println("CORE_ARGMAX " + to_string(am))
    println("CORE_MAXVAL " + to_string(mx))

    // first-16 logits
    let mut s = "CORE_FIRST16 "
    let mut j = 0
    while j < 16 { s = s + to_string(farr_get(logits, j)) + " "; j = j + 1 }
    println(s)

    // crude top-5: copy, repeatedly extract max
    let cp = farr_zeros(256)
    let mut c2 = 0
    while c2 < 256 { let _ = farr_set(cp, c2, farr_get(logits, c2)); c2 = c2 + 1 }
    let mut t5 = "CORE_TOP5 "
    let mut r = 0
    while r < 5 {
        let mut bi = 0
        let mut bv = farr_get(cp, 0)
        let mut kk = 1
        while kk < 256 {
            let vv = farr_get(cp, kk)
            if vv > bv { bv = vv; bi = kk }
            kk = kk + 1
        }
        t5 = t5 + to_string(bi) + " "
        let _ = farr_set(cp, bi, 0.0 - 1.0e30)
        r = r + 1
    }
    println(t5)
    let _ = farr_free(logits); let _ = farr_free(cp); let _ = farr_free(ids)
}
