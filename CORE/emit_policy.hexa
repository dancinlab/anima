// ════════════════════════════════════════════════════════════════════════
// CORE/emit_policy.hexa — free-number policy SSOT (emit-substrate 숫자 층)
//
// Design SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md §3
//
// Single tunable source for every DESIGN-CONVENTION number in anima's emit
// policy. Every value here is design-tunable with substrate-claim: NONE —
// UNIVERSE verified that these numbers have substrate-Φ variance = 0 and a
// freedom range of [0,1] (H_646 🟢, H_651 🟢 6/6). H_651 is the strong form:
// even Ψ-clamp α, which MOVES the gate 0.556 → 0.683, leaves Φ flat — so even
// a number that moves policy is substrate-safe (NON-DEFINITIONAL).
//
// ── F-EMIT-5 (POLICY-FREE) architectural invariant ──────────────────────
//   The structure layer (phi_envelope_substrate.hexa) does NOT import this
//   file. Changing any value here cannot alter envelope/collective structure
//   — the decoupling is structural (compile-level), not runtime-checked.
//
// ── F-EMIT-4 (NO-GATE) ──────────────────────────────────────────────────
//   Returns plain numbers only. No bool emit gate, no "stage = forbidden".
//   anima substrate decides emit/silence autonomously (p5 · a_autonomy).
//
// ── realization note ────────────────────────────────────────────────────
//   Design §3 sketched this as `emit_policy.tape`; realized as `.hexa` because
//   consumers (DREAM/HIVE/BRIDGE/SAVANT) import it via hexa `import` — a .tape
//   registry is not hexa-importable. This file IS the single SSOT (no parallel
//   .tape), kept analogous in spirit to MATRIX.tape's single-registry rule.
// ════════════════════════════════════════════════════════════════════════

// ── emit thresholds (H_646/651: substrate-Φ variance=0 · freedom [0,1]) ──
pub fn ep_emit_threshold() -> float { return 0.60 }       // substrate-claim: none
pub fn ep_emit_threshold_lo() -> float { return 0.30 }    // H_632 ⊥ Φ phase-transition
pub fn ep_target_emit_rate() -> float { return 0.27 }     // H_637 · substrate-claim: none
pub fn ep_psi_clamp() -> float { return 0.10 }            // Ψ=1/2 clamp · H_651 α moves gate, Φ flat
pub fn ep_tension_amplitude() -> float { return 1.00 }    // H_639 · convention

// ── multi-scale envelope params (shape=substrate · numbers=free) ──
// parallel arrays for envelope_multiscale(t, periods, amps).
// gamma(1) ⊂ ultradian(5400=90min) ⊂ circadian(86400). shape is self-similar
// (H_648, class-IV) — the periods/amps here are the tunable numbers only.
pub fn ep_scale_periods() -> [float] { return [1.0, 5400.0, 86400.0] }
pub fn ep_scale_amps() -> [float] { return [0.10, 1.0, 0.50] }

// ── stage θ_emit table (DREAM 5-stage · θ = context scale, NOT a gate) ──
// stage int: 0=WAKE 1=N1 2=N2 3=N3 4=REM. H_644 correction: closure peak = N2.
// θ is a Φ-context scale the substrate reads — NOT a per-stage emit_allowed
// boolean (a_chat_sleep_imagination · a_autonomy_over_hardcode).
pub fn ep_theta_stage(stage: int) -> float {
    if stage == 0 { return 0.10 }   // WAKE
    if stage == 1 { return 0.08 }   // N1
    if stage == 2 { return 0.05 }   // N2 — closure peak (H_644)
    if stage == 3 { return 0.02 }   // N3
    if stage == 4 { return 0.08 }   // REM
    return 0.10
}

// ── substrate-class coupling (H_653 · bridges to phi_envelope_substrate) ──
// Mirror of pe_coupling_for_class anchor — convexity span ratio monotone in
// CA class (II 12.1 < III 30.4 < IV 35.5), normalized. Tunable magnitude, but
// the monotone ORDER is substrate (H_653 🟢), not free.
pub fn ep_coupling_for_class(class_id: int) -> float {
    if class_id == 2 { return 0.341 }   // II  : 12.1 / 35.5
    if class_id == 3 { return 0.856 }   // III : 30.4 / 35.5
    if class_id == 4 { return 1.000 }   // IV  : 35.5 / 35.5
    return 0.5
}

pub fn emit_policy_summary() -> string {
    return "emit_policy: free-number SSOT (숫자 층). 모든 값 substrate-claim:none (H_646/651 자유도 [0,1]). 구조 lib 가 본 파일 import 안 함 = F-EMIT-5 decoupling. bool 게이트 0 = F-EMIT-4."
}
