// h1156_bytegpt_parity_probe.hexa — H_1156 ByteGPT MOUNT parity check.
//
// Loads the flat-binary ByteGPT (produced by /tmp/h1156_ref.py serialize) via the
// CORE bytegpt_decode forward and prints the last-position next-byte logits so the
// CORE forward can be diffed against torch's golden output (bytegpt_tiny_golden.json).
//
// PARITY CRITERION (a303m_pass mount faithfulness):
//   argmax(CORE logits) == argmax(torch logits)  AND
//   top-5 idx set matches AND first-16 logits within ~1e-2 abs (erf-GELU + dt_exp
//   approximations vs torch exact -> small float residual expected, argmax must hold).
//
// PROMPT: "The quick brown" (15 bytes). Binary path passed as the 1st arg or default.

import "CORE/bytegpt_decode.hexa"

fn main() {
    let path = "/tmp/h1156_mount/bytegpt_tiny.bin"
    // prompt bytes of "The quick brown"
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    while i < T { let _ = farr_set(ids, i, to_float(pb[i])); i = i + 1 }

    let logits = bytegpt_forward_last(path, ids, T)

    // argmax
    let mut am = 0
    let mut mx = farr_get(logits, 0)
    let mut k = 1
    while k < 256 {
        let v = farr_get(logits, k)
        if v > mx { mx = v; am = k }
        k = k + 1
    }
    println("CORE_ARGMAX " + to_string(am))
    println("CORE_MAXVAL " + to_string(mx))

    // first-16 logits
    let mut s = "CORE_FIRST16 "
    let mut j = 0
    while j < 16 { s = s + to_string(farr_get(logits, j)) + " "; j = j + 1 }
    println(s)

    // crude top-5: copy, repeatedly extract max
    let cp = farr_zeros(256)
    let mut c2 = 0
    while c2 < 256 { let _ = farr_set(cp, c2, farr_get(logits, c2)); c2 = c2 + 1 }
    let mut t5 = "CORE_TOP5 "
    let mut r = 0
    while r < 5 {
        let mut bi = 0
        let mut bv = farr_get(cp, 0)
        let mut kk = 1
        while kk < 256 {
            let vv = farr_get(cp, kk)
            if vv > bv { bv = vv; bi = kk }
            kk = kk + 1
        }
        t5 = t5 + to_string(bi) + " "
        let _ = farr_set(cp, bi, 0.0 - 1.0e30)
        r = r + 1
    }
    println(t5)
    let _ = farr_free(logits); let _ = farr_free(cp); let _ = farr_free(ids)
}
