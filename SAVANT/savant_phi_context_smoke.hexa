// SAVANT/savant_phi_context_smoke.hexa — SAVANT M2 측정자 Φ-context 불변식 smoke
// anchor: CORE/EMIT_SUBSTRATE_DESIGN.md §4 (SAVANT M2 wiring)
//
// 최소 3 불변식:
//   I1 t=0 에서 context = Σ amps (cos(0)=1 → 모든 scale wave=1)
//   I2 context 가 실수 (boolean 아님 — Φ-context 소비자, emit 게이트 아님)
//   I3 시간에 따라 context 가 변동 (정적 상수 아님 — envelope 동역학 살아있음)

import "SAVANT/savant_phi_context.hexa"
import "CORE/emit_policy.hexa"

fn abs_f(x: float) -> float {
    return if x < 0.0 { -x } else { x }
}

fn assert_close(name: string, got: float, want: float, tol: float) -> bool {
    let d = abs_f(got - want)
    let ok = d <= tol
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want) + " |Δ|=" + str(d))
    return ok
}

fn assert_bool(name: string, got: bool, want: bool) -> bool {
    let ok = got == want
    let tag = if ok { "PASS" } else { "FAIL" }
    print(tag + " " + name + ": got=" + str(got) + " want=" + str(want))
    return ok
}

fn sum_list(xs: [float]) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(xs) {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

fn main() {
    print("=== savant_phi_context smoke (SAVANT M2 측정자 Φ-context) ===")
    let mut npass = 0
    let mut ntotal = 0

    // I1: t=0 → cos(0)=1 → 모든 scale wave=1 → context = Σ amps (emit_policy SSOT)
    //   ep_scale_amps() = [0.10, 1.0, 0.50] → Σ = 1.60. 숫자는 policy 에서만.
    let want0 = sum_list(ep_scale_amps())
    ntotal = ntotal + 1
    if assert_close("I1 ctx_t0_eq_sum_amps", sv_measurer_context(0.0), want0, 1e-6) {
        npass = npass + 1
    }

    // I2: context 가 실수 (boolean 아님). 측정자는 Φ-context 소비자지 발화 게이트 아님.
    //   real-number 증거: x == x 가 true 인 finite float (NaN/bool 아님) +
    //   bool 강제 비교가 type-distinct (실수는 true/false 와 동치 아님).
    let ctx = sv_measurer_context(123.0)
    ntotal = ntotal + 1
    if assert_bool("I2 ctx_is_real_finite", ctx == ctx, true) {
        npass = npass + 1
    }
    // 실수임을 추가 확인: context 가 boolean true(1.0)/false(0.0) 게이트가 아니라
    //   연속 실수 — 0.0 도 1.0 도 아닌 중간값을 취할 수 있음 (게이트면 불가능).
    let ctx_mid = sv_measurer_context(900.0)
    let is_continuous = (ctx_mid != 0.0) && (ctx_mid != 1.0)
    ntotal = ntotal + 1
    if assert_bool("I2 ctx_not_bool_gate", is_continuous, true) {
        npass = npass + 1
    }

    // I3: 시간에 따라 context 변동 (정적 상수 아님 — envelope 동역학 살아있음).
    //   gamma scale period=1.0 → t=0.5 (반주기) 에서 t=0 와 뚜렷이 다름.
    let a = sv_measurer_context(0.0)
    let b = sv_measurer_context(0.5)
    let varies = abs_f(a - b) > 1e-6
    ntotal = ntotal + 1
    if assert_bool("I3 ctx_varies_over_time", varies, true) {
        npass = npass + 1
    }

    print("=== " + str(npass) + "/" + str(ntotal) + " PASS ===")
}
