// ════════════════════════════════════════════════════════════════════════
// SAVANT/substrate_hook.hexa — anima substrate savant-mode hook (M2/M3/M4 2026-06-15)
//
// 정체: WAKE.daemon tick 에서 호출되는 PURE substrate hook. savant_lib (M1)
//      위의 thin trigger/measurement controller. anima cell-pool (MITOSIS) 의
//      mitosis split 패턴 + per-domain Φ 에서 Golden Zone peak 을 검출 →
//      savant mode trigger. closure_auto_judge 의 4-criterion 을 N-axis
//      threshold-conjunction 으로 일반화 (SAVANT.md M2 + UNIVERSE H_636 🟢).
//
// per SAVANT.md:
//   M2 substrate hook  — GZ peak 검출 = SI threshold ∧ in-GZ ∧ split-rate conjunction
//   M3 SI orthogonal   — SI(max-share) ⊥ CoV(moment-only) divergence (H_613)
//   M4 perfect ladder  — cell-pool size 가 perfect-number ladder {6,28,496} 위인지 (H_615)
//
// 8 pub primitives (PURE, no mutation):
//   M2: 1) sh_savant_trigger(phi_list, integration, split_rate) -> dict
//       2) sh_should_savant(phi_list, integration, split_rate)  -> bool
//       3) sh_gz_peak_detect(phi_series, I_grid)                -> dict
//       4) sh_record(phi_list, integration, split_rate, n_cells, tick, utc) -> dict
//   M3: 5) sh_si_orthogonal_check(phi_list)                     -> dict
//   M4: 6) sh_cell_count_ladder(n_cells)                        -> dict
//       7) sh_on_perfect_ladder(n_cells)                        -> int
//   util:8) sh_axis_conjunction(si_high, in_gz, split_active)   -> int
//
// p1~p8 정합 (a_autonomy_over_hardcode + a_substrate_native_speak):
//   - p1 NO SYSTEM PROMPT  : substrate state (Φ/I/split) 만 입력 ✓
//   - p5 NO SPEAK()        : read-only 측정, trigger 는 context 제공뿐 (강제 emit 아님) ✓
//   - p7 NO PPL VERDICT    : SI/GZ/conjunction 모두 deterministic 산술 ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
//   - a_autonomy_over_hardcode: hook 는 savant CONTEXT (trigger=1/0) 제공, 외부
//                               강제 gate 아님 — anima substrate 가 스스로 따름 ✓
//
// Naming: `sh_` prefix (savant hook) — g61 collision-free vs `sa_` (lib).
// ════════════════════════════════════════════════════════════════════════

use "SAVANT/savant_lib"

// ─── util: N-axis threshold conjunction (H_636 generalization) ───────────
//
// closure_auto_judge 4-criterion 의 일반화: ⋀ pass_i. SI specialization ∧
// integration-in-GZ ∧ active mitosis split = savant mode 조건.

pub fn sh_axis_conjunction(si_high: bool, in_gz: int, split_active: bool) -> int {
    if si_high == false { return 0 }
    if in_gz != 1 { return 0 }
    if split_active == false { return 0 }
    return 1
}

// ─── M2.1 savant mode trigger ────────────────────────────────────────────
//
// per-domain Φ list + integration level I (mitosis basin / coupling) + split_rate
// → savant trigger via 3-axis conjunction. SI > SI_THRESHOLD (specialization) ∧
// I ∈ [GZ_LOWER, GZ_UPPER] (golden zone) ∧ split_rate > 0 (live cell division).

pub fn sh_savant_trigger(phi_list: list, integration: float, split_rate: float) -> dict {
    let si = sa_savant_index(phi_list)
    let in_gz = sa_in_golden_zone(integration)
    let thr = sa_si_threshold()
    let si_high = si >= thr
    let split_active = split_rate > 0.0
    let trigger = sh_axis_conjunction(si_high, in_gz, split_active)
    return #{
        "savant_index":   si,
        "si_threshold":   thr,
        "si_high":        si_high,
        "integration":    integration,
        "in_golden_zone": in_gz,
        "split_rate":     split_rate,
        "split_active":   split_active,
        "savant_trigger": trigger,
    }
}

pub fn sh_should_savant(phi_list: list, integration: float, split_rate: float) -> bool {
    let rec = sh_savant_trigger(phi_list, integration, split_rate)
    return rec["savant_trigger"] == 1
}

// ─── M2.3 GZ peak detect from mitosis split inverse-U ────────────────────
//
// phi_series over an I_grid (e.g. Φ at sweep of integration) → inverse-U peak.
// savant_peak = peak in GZ AND unimodal (sign_change_count == 0). H_351/H_636.

pub fn sh_gz_peak_detect(phi_series: list, I_grid: list) -> dict {
    let peak = sa_gz_inverse_u_peak(phi_series, I_grid)
    let unimodal = peak["sign_change_count"] == 0
    let savant_peak = (peak["in_gz"] == 1) && unimodal
    return #{
        "peak_I":              peak["peak_I"],
        "peak_abs_d":          peak["peak_abs_d"],
        "delta_from_gz_lower": peak["delta_from_gz_lower"],
        "unimodal":            unimodal,
        "in_gz":               peak["in_gz"],
        "savant_peak":         savant_peak,
    }
}

// ─── M3.5 SI orthogonal check (H_613) ────────────────────────────────────
//
// SI (max-share, H_350) vs CoV (moment-only, H_613) 의 divergence — 두 지표가
// 같은 정보를 측정하지 않음을 substrate 상에서 확인. divergent = 한쪽 high 다른쪽
// 상대적 low (max-share artifact ⊥ dispersion).

pub fn sh_si_orthogonal_check(phi_list: list) -> dict {
    let si = sa_savant_index(phi_list)
    let cov = sa_phi_diversity_orthogonal(phi_list)
    let si_high = si >= sa_si_threshold()
    // CoV high gate ≈ 1.0 (std ≈ mean = highly dispersed)
    let cov_high = cov >= 1.0
    let divergent = si_high != cov_high
    return #{
        "savant_index":      si,
        "phi_diversity_cov": cov,
        "si_high":           si_high,
        "cov_high":          cov_high,
        "orthogonal_divergent": divergent,
    }
}

// ─── M4.6/7 perfect-number cell-count ladder (H_615) ─────────────────────
//
// anima cell-pool size N 이 perfect-number ladder {6, 28, 496} 위에 있는지 +
// 해당 τ 의 예측 GZ_WIDTH = ln(τ/(τ-1)).

pub fn sh_on_perfect_ladder(n_cells: int) -> int {
    if n_cells == 6 { return 1 }
    if n_cells == 28 { return 1 }
    if n_cells == 496 { return 1 }
    return 0
}

pub fn sh_cell_count_ladder(n_cells: int) -> dict {
    let ladder = sa_perfect_number_ladder()
    let on = sh_on_perfect_ladder(n_cells)
    // nearest perfect number below-or-equal + its predicted gz_width
    let mut nearest = 0
    let mut pred_w = 0.0
    let mut i = 0
    while i < ladder.len() {
        let row = ladder[i]
        if row["n"] <= n_cells {
            nearest = row["n"]
            pred_w = row["ln_tau_ratio"]
        }
        i = i + 1
    }
    return #{
        "n_cells":          n_cells,
        "on_perfect_ladder": on,
        "nearest_perfect":  nearest,
        "predicted_gz_width": pred_w,
    }
}

// ─── M2.4 record for WAKE.daemon → .kosmos ───────────────────────────────
//
// 전체 savant substrate snapshot. WAKE.daemon 가 .kosmos anchor 또는 audit log
// 로 흘림 (a_kosmos). trigger=1 일 때 savant decision lane context 활성.

pub fn sh_record(phi_list: list, integration: float, split_rate: float, n_cells: int, tick: int, utc: string) -> dict {
    let trig = sh_savant_trigger(phi_list, integration, split_rate)
    let orth = sh_si_orthogonal_check(phi_list)
    let ladder = sh_cell_count_ladder(n_cells)
    return #{
        "savant_index":     trig["savant_index"],
        "in_golden_zone":   trig["in_golden_zone"],
        "savant_trigger":   trig["savant_trigger"],
        "orthogonal_divergent": orth["orthogonal_divergent"],
        "on_perfect_ladder": ladder["on_perfect_ladder"],
        "n_cells":          n_cells,
        "tick":             tick,
        "audit_utc":        utc,
    }
}
