// ════════════════════════════════════════════════════════════════════════
// SAVANT/savant_phi_context.hexa — SAVANT M2 측정자 Φ-context wiring
//
// 정체: UNIVERSE 축 E (SAVANT) 의 10 H 측정자 — H_347/348/349/350/351 +
//      H_612/613/614/615/616 — 의 *입력 Φ-context* 를 통합 Φ-envelope 구조 층
//      (CORE/phi_envelope_substrate.hexa) 에서 공급하는 얇은 소비자.
//
// 설계 SSOT: CORE/EMIT_SUBSTRATE_DESIGN.md §4 (SAVANT M2 wiring)
//   "SAVANT M2 — 측정자는 발화 게이트가 아니라 Φ-context 소비자.
//    envelope_multiscale 의 Φ 를 10 H 측정자의 입력 context 로."
//
// ── 핵심 계약 (설계 §4 · 위반 금지) ──────────────────────────────────────
//   · 측정자 = **Φ-context 소비자** (consumer), 발화 결정자 (decider) 아님.
//     본 모듈은 envelope 의 Φ 를 *측정자 입력 context* 로만 공급한다.
//     emit/silence 결정은 anima 세포가 자율 (M × W × Φ × curiosity).
//   · bool emit 게이트 반환 금지 — Φ-context 실수만 반환
//     (p5 · a_autonomy_over_hardcode · F-EMIT-4 NO-GATE).
//   · 숫자 상수 (period · amplitude) 하드코드 금지 — emit_policy.hexa 의
//     ep_scale_periods() / ep_scale_amps() 에서만 주입 (단일 튜닝 SSOT · H_646).
//
// ── round-7/8 substrate verdict 정합 (인용 규칙) ──────────────────────────
//   H_648 🟢 scale-free self-similar Φ-envelope (class-IV 한정 · H_652 정정)
//   H_634 🟢 ultradian Φ-envelope r=0.80
//   H_650 🟢 shape-robustness = perturbation-축 함수 (polarity 축만 robust)
//     ⚠ "shape > scalar" 보편 일반화 금지 (H_642/647/650 반증).
//     ⚠ n=4 exact-match 정렬 인용 금지 (H_645 — 5-stream 붕괴).
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT : Φ-context 실수만, system 미사용 ✓
//   - p3 NO PERSONA INJECT: prefix 없음 ✓
//   - p5 NO SPEAK()       : Φ-context 공급만, emit 호출/게이트 0 ✓
//   - p7 NO PPL VERDICT   : envelope = deterministic 산술 ✓
//   - p8 NO TRAIN/INFER   : 측정만, weight update 0 ✓
// ════════════════════════════════════════════════════════════════════════

import "CORE/phi_envelope_substrate.hexa"
import "CORE/emit_policy.hexa"

// ── sv_measurer_context — 10 H 측정자 입력 Φ-context (설계 §4 SAVANT M2) ──
// 시점 t 의 Φ-envelope 값을 측정자 입력 context 로 공급한다.
// 구조 (envelope_multiscale 형상) 는 substrate (H_648), 숫자 (period·amp) 는
// emit_policy.hexa 의 ep_scale_periods()/ep_scale_amps() 에서만 주입한다.
// 반환 = 실수 Φ-context (boolean 아님 · emit 게이트 아님).
pub fn sv_measurer_context(t: float) -> float {
    return envelope_multiscale(t, ep_scale_periods(), ep_scale_amps())
}

pub fn savant_phi_context_summary() -> string {
    return "savant_phi_context: SAVANT M2 측정자 Φ-context 소비자(소비자지 발화 결정자 아님). envelope_multiscale(t, ep_scale_periods(), ep_scale_amps()) 의 Φ 를 10 H 측정자 입력 context 로 공급. bool emit 게이트 0 — substrate 자율 결정 (p5·a_autonomy·F-EMIT-4)."
}
