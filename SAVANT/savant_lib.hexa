// ════════════════════════════════════════════════════════════════════════

// ─── 1. canonical constants (H_347 / H_348 / H_349 verbatim) ─────────────

pub fn sa_gz_width() -> float {
    // ln(4/3) ≈ 0.28768207244178085 — H_347 closed-form anchor
    return 0.28768207244178085
}

pub fn sa_gz_lower() -> float {
    // 1/2 - ln(4/3) ≈ 0.21231792755821914 — H_348 lower bound
    return 0.21231792755821914
}

pub fn sa_gz_upper() -> float {
    // 1/2 — H_348 upper bound (perfect symmetry)
    return 0.5
}

pub fn sa_gz_center() -> float {
    // 1/e ≈ 0.36787944117144233 — H_349 center (Φ peak anchor)
    return 0.36787944117144233
}

pub fn sa_si_threshold() -> float {
    // SI > 3 = high specialization gate (H_348 verdict criterion)
    return 3.0
}

// ─── 2. golden zone primitives (H_347 / H_348) ───────────────────────────

pub fn sa_golden_zone_compute(n_div: int) -> dict {
    // H_347 ladder generalization: GZ_WIDTH(τ) = ln(τ / (τ-1)) for any divisor
    // count τ. Returns {gz_width, gz_lower, gz_upper} closed-form for given τ.
    // Edge: τ <= 1 → degenerate (returns 0 width).
    if n_div <= 1 {
        return #{
            "gz_width": 0.0,
            "gz_lower": 0.5,
            "gz_upper": 0.5,
            "n_div":    n_div,
        }
    }
    let tau_f = float(n_div)
    let ratio = tau_f / (tau_f - 1.0)
    let w     = log(ratio)
    return #{
        "gz_width": w,
        "gz_lower": 0.5 - w,
        "gz_upper": 0.5,
        "n_div":    n_div,
    }
}

pub fn sa_in_golden_zone(I: float) -> int {
    // 1 if I lies in GZ window [GZ_LOWER, GZ_UPPER], else 0 (H_348 measurement gate)
    let lo = sa_gz_lower()
    let hi = sa_gz_upper()
    if I < lo { return 0 }
    if I > hi { return 0 }
    return 1
}

// ─── 3. savant index primitives (H_350 / H_613) ──────────────────────────

pub fn sa_savant_index(phi_list: list) -> float {
    // H_350 primary metric: SI = max(domain_phi) / mean(domain_phi).
    // mean ≤ 0 (degenerate substrate) → 0.0 safe floor.
    let mut n = phi_list.len()
    if n == 0 { return 0.0 }
    let mut sum_p = 0.0
    let mut max_p = phi_list[0]
    let mut i = 0
    while i < n {
        let v = phi_list[i]
        sum_p = sum_p + v
        if v > max_p { max_p = v }
        i = i + 1
    }
    let mean_p = sum_p / float(n)
    if mean_p <= 0.0 { return 0.0 }
    return max_p / mean_p
}

pub fn sa_phi_diversity(phi_list: list) -> float {
    // H_350 primary ΦD: max(phi) / min(phi). min ≤ 0 → 0.0 safe floor.
    let mut n = phi_list.len()
    if n == 0 { return 0.0 }
    let mut max_p = phi_list[0]
    let mut min_p = phi_list[0]
    let mut i = 1
    while i < n {
        let v = phi_list[i]
        if v > max_p { max_p = v }
        if v < min_p { min_p = v }
        i = i + 1
    }
    if min_p <= 0.0 { return 0.0 }
    return max_p / min_p
}

pub fn sa_phi_diversity_orthogonal(phi_list: list) -> float {
    // H_613 orthogonal metric: ΦD_cov = std(phi) / mean(phi) (CoV).
    // Max-share artifact 제거 — 분자에 max 없음 (1st + 2nd moments only).
    let mut n = phi_list.len()
    if n == 0 { return 0.0 }
    let mut sum_p = 0.0
    let mut i = 0
    while i < n {
        sum_p = sum_p + phi_list[i]
        i = i + 1
    }
    let mean_p = sum_p / float(n)
    if mean_p <= 0.0 { return 0.0 }
    let mut sumsq = 0.0
    let mut j = 0
    while j < n {
        let d = phi_list[j] - mean_p
        sumsq = sumsq + d * d
        j = j + 1
    }
    let var_p = sumsq / float(n)
    let std_p = sqrt(var_p)
    return std_p / mean_p
}

// ─── 4. inverse-U dΦ/dI peak (H_351 / H_614) ─────────────────────────────

pub fn sa_gz_inverse_u_peak(phi_series: list, I_grid: list) -> dict {
    // H_351: scan dΦ/dI via finite difference (central inner, forward/backward
    // at endpoints), return {peak_I, peak_abs_d, delta_from_gz_lower,
    // sign_change_count, in_gz}. unimodal ↔ sign_change_count = 0.
    let mut n = phi_series.len()
    if n < 2 {
        return #{
            "peak_I": 0.0,
            "peak_abs_d": 0.0,
            "delta_from_gz_lower": 1.0,
            "sign_change_count": 0,
            "in_gz": 0,
        }
    }
    // build d_phi[] by central FD (forward at i=0, backward at i=n-1)
    let mut deriv = []
    let mut i = 0
    while i < n {
        let mut d = 0.0
        if i == 0 {
            d = (phi_series[1] - phi_series[0]) / (I_grid[1] - I_grid[0])
        } else if i == n - 1 {
            d = (phi_series[n - 1] - phi_series[n - 2]) / (I_grid[n - 1] - I_grid[n - 2])
        } else {
            d = (phi_series[i + 1] - phi_series[i - 1]) / (I_grid[i + 1] - I_grid[i - 1])
        }
        deriv.push(d)
        i = i + 1
    }
    // argmax |d|
    let mut peak_idx = 0
    let mut peak_abs = -1.0
    let mut k = 0
    while k < n {
        let mut a = deriv[k]
        if a < 0.0 { a = 0.0 - a }
        if a > peak_abs {
            peak_abs = a
            peak_idx = k
        }
        k = k + 1
    }
    // sign change count (unimodal anchor)
    let mut sign_changes = 0
    let mut prev_sign = 0
    let mut m = 0
    while m < n {
        let v = deriv[m]
        let mut s = 0
        if v > 0.0 { s = 1 } else { if v < 0.0 { s = -1 } else { s = 0 } }
        if prev_sign != 0 && s != 0 && s != prev_sign {
            sign_changes = sign_changes + 1
        }
        if s != 0 { prev_sign = s }
        m = m + 1
    }
    let peak_I = I_grid[peak_idx]
    let gz_lo  = sa_gz_lower()
    let mut delta = peak_I - gz_lo
    if delta < 0.0 { delta = 0.0 - delta }
    let in_gz = sa_in_golden_zone(peak_I)
    return #{
        "peak_I": peak_I,
        "peak_abs_d": peak_abs,
        "delta_from_gz_lower": delta,
        "sign_change_count": sign_changes,
        "in_gz": in_gz,
    }
}

// ─── 5. perfect-number ladder (H_615) ────────────────────────────────────

pub fn sa_perfect_number_ladder() -> list {
    // H_615: ladder over first three perfect numbers {6, 28, 496}.
    // Each entry: {n, tau, ln_tau_ratio} where ln_tau_ratio = ln(τ/(τ-1))
    // = predicted GZ_WIDTH(τ). closed-form anchors:
    //   n=6   τ=4   ln(4/3)  ≈ 0.28768207244178085 (H_347 anchor)
    //   n=28  τ=6   ln(6/5)  ≈ 0.18232155679395463 (H_615 verify)
    //   n=496 τ=10  ln(10/9) ≈ 0.10536051565782628 (H_615 verify)
    let mut out = []
    out.push(#{ "n": 6,   "tau": 4,  "ln_tau_ratio": 0.28768207244178085 })
    out.push(#{ "n": 28,  "tau": 6,  "ln_tau_ratio": 0.18232155679395463 })
    out.push(#{ "n": 496, "tau": 10, "ln_tau_ratio": 0.10536051565782628 })
    return out
}
