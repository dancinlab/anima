//   - 원본 H: UNIVERSE/cards/H_348 (golden_zone_lower_bound_SI, 🟡 GZ_LOWER=1/2-ln(4/3))
//   - 원본 H: UNIVERSE/cards/H_349 (golden_zone_center_phi_peak, GZ_CENTER=1/e)
//   - 원본 H: UNIVERSE/cards/H_350 (savant_index_phi_diversity, SI=max/mean, ΦD=max/min)
//   - 원본 H: UNIVERSE/cards/H_351 (gz_inverse_u_phi_derivative_peak, peak ≈ GZ_LOWER)
//   - 원본 H: UNIVERSE/cards/H_612 (1e_peak_narrow_substrate_class_survival)
//   - 원본 H: UNIVERSE/cards/H_613 (savant_index_phi_diversity_orthogonal_metric, ΦD_cov)
//   - 원본 H: UNIVERSE/cards/H_614 (gz_inverse_u_multi_rule_substrate_invariance, 🔴 2/4)
//   - 원본 H: UNIVERSE/cards/H_615 (perfect_number_ladder_n28, ln(τ(n)/(τ(n)-1)) for n=6/28/496)
//   - 시점: 2026-05-28 M1 lib promotion
//   - 본체 무수정 — `sa_` prefix wrapper 만 (g61 stdlib collision 회피)
//
// canonical constants (H_347 / H_348 / H_349 / H_615 verbatim):
//   GZ_WIDTH      = ln(4/3) ≈ 0.28768207244178085
//   GZ_LOWER      = 1/2 - ln(4/3) ≈ 0.21231792755821914
//   GZ_UPPER      = 1/2 (= 0.5)
//   GZ_CENTER     = 1/e ≈ 0.36787944117144233
//   SI_THRESHOLD  = 3.0 (Savant Index high specialization gate)
//   PERFECT_NUMS  = [6, 28, 496] (H_615 ladder, τ ∈ {4, 6, 10})
//
// 12 pub primitives (PURE, no mutation):
//   constants:
//      1) sa_gz_width()              — ln(4/3) anchor
//      2) sa_gz_lower()              — 1/2 - ln(4/3)
//      3) sa_gz_upper()              — 1/2
//      4) sa_gz_center()             — 1/e
//      5) sa_si_threshold()          — 3.0
//   golden zone:
//      6) sa_golden_zone_compute(n_div: int) -> dict
//                                    — H_347 ladder: {gz_width, gz_lower, gz_upper}
//                                      from divisor count τ (= n_div)
//      7) sa_in_golden_zone(I: float) -> int
//                                    — 1 if GZ_LOWER ≤ I ≤ GZ_UPPER else 0
//   savant index:
//      8) sa_savant_index(phi_list: list) -> float
//                                    — H_350 primary: max(phi) / mean(phi)
//      9) sa_phi_diversity(phi_list: list) -> float
//                                    — H_350 primary: max/min
//     10) sa_phi_diversity_orthogonal(phi_list: list) -> float
//                                    — H_613 orthogonal: std/mean (CoV) (no max-share)
//   inverse-U:
//     11) sa_gz_inverse_u_peak(phi_series: list, I_grid: list) -> dict
//                                    — H_351: argmax(|dΦ/dI|) location +
//                                      |Δ from GZ_LOWER| + sign-change count
//   ladder:
//     12) sa_perfect_number_ladder() -> list
//                                    — H_615: [{n, tau, ln_tau_ratio}] for n ∈ {6,28,496}
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : closed-form 식 + 측정 함수, system 미사용 ✓
//   - p3 NO PERSONA INJECT.: prefix 없음 ✓
//   - p5 NO SPEAK()        : 측정만, 외부 emit 호출 0 ✓
//   - p7 NO PPL VERDICT    : SI / GZ 모두 deterministic 산술 ✓
//   - p8 NO TRAIN/INFER    : 측정만, weight update 0 ✓
