// ════════════════════════════════════════════════════════════════════════
// SAVANT/substrate_hook_smoke.hexa — substrate hook invariants (M2/M3/M4 2026-06-15)
//
// Invariants (8):
//   I1: sh_axis_conjunction(true, 1, true) == 1   (all axes pass → trigger)
//   I2: sh_axis_conjunction(true, 0, true) == 0   (out-of-GZ → no trigger)
//   I3: savant_trigger fires for SI-high ∧ in-GZ ∧ split>0
//   I4: savant_trigger 0 when integration out of golden zone
//   I5: sh_should_savant alias consistency
//   I6: sh_on_perfect_ladder(28) == 1 ; (27) == 0
//   I7: sh_cell_count_ladder(28).nearest_perfect == 28
//   I8: sh_si_orthogonal_check returns a divergence flag (bool present)
// ════════════════════════════════════════════════════════════════════════

use "SAVANT/substrate_hook"

fn main() {
    println("=== SAVANT/substrate_hook_smoke ===")

    // I1: full conjunction
    let c1 = sh_axis_conjunction(true, 1, true)
    let i1 = c1 == 1
    println("I1 conjunction(T,1,T)=" + str(c1) + "  " + (if i1 { "PASS" } else { "FAIL" }))

    // I2: out-of-GZ kills trigger
    let c2 = sh_axis_conjunction(true, 0, true)
    let i2 = c2 == 0
    println("I2 conjunction(T,0,T)=" + str(c2) + "  " + (if i2 { "PASS" } else { "FAIL" }))

    // I3: savant trigger fires — one dominant domain (SI high) at I=0.3 (in GZ), split active
    let phi_savant = [10.0, 1.0, 1.0, 1.0]   // SI = 10/3.25 ≈ 3.08 > 3.0
    let t3 = sh_savant_trigger(phi_savant, 0.30, 0.5)
    let i3 = t3["savant_trigger"] == 1
    println("I3 trigger(SI=" + str(t3["savant_index"]) + ", I=0.30, split=0.5)=" + str(t3["savant_trigger"]) + "  " + (if i3 { "PASS" } else { "FAIL" }))

    // I4: same Φ but integration out of golden zone (I=0.9 > GZ_UPPER) → no trigger
    let t4 = sh_savant_trigger(phi_savant, 0.90, 0.5)
    let i4 = t4["savant_trigger"] == 0
    println("I4 trigger(I=0.90 out-GZ)=" + str(t4["savant_trigger"]) + "  " + (if i4 { "PASS" } else { "FAIL" }))

    // I5: should_savant alias
    let s5 = sh_should_savant(phi_savant, 0.30, 0.5)
    let i5 = s5 == true
    println("I5 should_savant alias=" + str(s5) + "  " + (if i5 { "PASS" } else { "FAIL" }))

    // I6: perfect-number ladder membership
    let l28 = sh_on_perfect_ladder(28)
    let l27 = sh_on_perfect_ladder(27)
    let i6 = (l28 == 1) && (l27 == 0)
    println("I6 ladder(28)=" + str(l28) + " ladder(27)=" + str(l27) + "  " + (if i6 { "PASS" } else { "FAIL" }))

    // I7: nearest perfect for n=28
    let cl = sh_cell_count_ladder(28)
    let i7 = cl["nearest_perfect"] == 28
    println("I7 nearest_perfect(28)=" + str(cl["nearest_perfect"]) + "  " + (if i7 { "PASS" } else { "FAIL" }))

    // I8: orthogonal check produces divergence flag for skewed Φ
    let orth = sh_si_orthogonal_check(phi_savant)
    let i8 = (orth["orthogonal_divergent"] == true) || (orth["orthogonal_divergent"] == false)
    println("I8 orthogonal_divergent flag present  " + (if i8 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (8/8)" } else { "INVARIANT FAILURE" })
}
