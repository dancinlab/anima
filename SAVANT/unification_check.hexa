// ════════════════════════════════════════════════════════════════════════
// SAVANT/unification_check.hexa — HEXAD ↔ savant_lib SSOT unification (M5 2026-06-15)
//
// 정체: SAVANT M5 통합 — savant_lib (numeric SSOT) 과 HEXAD/SAVANT application
//      layer (anima_savant_tool.hexa: st_gz_lower/center, anima_savant_routing_
//      overlay.hexa: so_gz_*) 의 canonical 상수가 DRIFT 없이 일치함을 verify.
//      통합 = mirror 가 아닌 단일 SSOT: 두 layer 가 같은 closed-form 을 산출함을
//      deterministic equality 로 증명 → savant_lib 가 numeric SSOT, HEXAD 는 그
//      위의 application(routing/tool/monitor) layer 로 계층 확정.
//
// SSOT 계층 (M5 확정):
//   numeric SSOT      : SAVANT/savant_lib.hexa        (sa_* — 12 closed-form primitives)
//   anima substrate   : SAVANT/substrate_hook.hexa    (sh_* — savant trigger / GZ peak)
//   application        : HEXAD/SAVANT/*.hexa           (routing overlay · tool · si_monitor)
//   historical anchor  : HEXAD/SAVANT/COMPENDIUM.md    (783L 전수조사 evidence, 편집금지)
//
// drift gate: |sa_X - HEXAD_formula_X| < 1e-9 for GZ_LOWER / GZ_CENTER / GZ_WIDTH.
//   HEXAD anima_savant_tool.hexa verbatim formulas:
//     st_gz_center() = 1.0 / 2.71828182845904     (1/e)
//     st_gz_lower()  = 0.5 - log(4.0 / 3.0)       (1/2 - ln(4/3))
// ════════════════════════════════════════════════════════════════════════

use "SAVANT/savant_lib"

fn approx_eq(a: float, b: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn main() {
    println("=== SAVANT/unification_check (M5 HEXAD <-> savant_lib SSOT) ===")

    // U1: GZ_CENTER — savant_lib vs HEXAD st_gz_center (1/e)
    let lib_center = sa_gz_center()
    let hexad_center = 1.0 / 2.71828182845904
    let u1 = approx_eq(lib_center, hexad_center)
    println("U1 GZ_CENTER lib=" + str(lib_center) + " HEXAD=" + str(hexad_center) + "  " + (if u1 { "PASS" } else { "FAIL" }))

    // U2: GZ_LOWER — savant_lib vs HEXAD st_gz_lower (1/2 - ln(4/3))
    let lib_lower = sa_gz_lower()
    let hexad_lower = 0.5 - log(4.0 / 3.0)
    let u2 = approx_eq(lib_lower, hexad_lower)
    println("U2 GZ_LOWER  lib=" + str(lib_lower) + " HEXAD=" + str(hexad_lower) + "  " + (if u2 { "PASS" } else { "FAIL" }))

    // U3: GZ_WIDTH — savant_lib vs ln(4/3) closed-form (H_347)
    let lib_width = sa_gz_width()
    let hexad_width = log(4.0 / 3.0)
    let u3 = approx_eq(lib_width, hexad_width)
    println("U3 GZ_WIDTH  lib=" + str(lib_width) + " ln(4/3)=" + str(hexad_width) + "  " + (if u3 { "PASS" } else { "FAIL" }))

    // U4: identity GZ_WIDTH = GZ_UPPER - GZ_LOWER (internal consistency)
    let u4 = approx_eq(sa_gz_width(), sa_gz_upper() - sa_gz_lower())
    println("U4 GZ_WIDTH == GZ_UPPER - GZ_LOWER  " + (if u4 { "PASS" } else { "FAIL" }))

    // U5: H_615 ladder first rung = GZ_WIDTH (n=6, tau=4 → ln(4/3))
    let ladder = sa_perfect_number_ladder()
    let rung0 = ladder[0]
    let u5 = approx_eq(rung0["ln_tau_ratio"], sa_gz_width())
    println("U5 ladder[6].ln_tau_ratio == GZ_WIDTH  " + (if u5 { "PASS" } else { "FAIL" }))

    let all = u1 && u2 && u3 && u4 && u5
    println("")
    println(if all { "UNIFICATION VERIFIED — no drift (5/5)" } else { "DRIFT DETECTED" })
}
