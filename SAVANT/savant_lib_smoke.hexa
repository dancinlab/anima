// ════════════════════════════════════════════════════════════════════════
// SAVANT/savant_lib_smoke.hexa — SAVANT primitives round-trip smoke (M1 2026-05-28)
//
// 정체: savant_lib.hexa PURE wrapper 의 GZ closed-form anchors + SI/ΦD/ΦD_cov +
//      inverse-U dΦ/dI peak + perfect-number ladder primitives 를 invariant
//      형태로 검증. UNIVERSE/H_347..H_615 의 verdict 측 수치 보존 확인.
//
// Invariants (10):
//   I1: |sa_gz_width() - ln(4/3)| < 1e-12                         (H_347)
//   I2: |sa_gz_lower() - (1/2 - ln(4/3))| < 1e-12                 (H_348)
//   I3: sa_in_golden_zone(GZ_LOWER) == 1 && sa_in_golden_zone(0.05) == 0
//   I4: sa_savant_index([3.0, 1.0, 1.0, 1.0]) == max/mean = 3.0/1.5 = 2.0
//   I5: sa_phi_diversity([3.0, 1.0, 1.0, 1.0]) == max/min = 3.0
//   I6: sa_phi_diversity_orthogonal([1,1,1,1]) == 0  (degenerate, no spread)
//   I7: sa_golden_zone_compute(4)["gz_width"] ≈ ln(4/3)            (H_347 ladder)
//   I8: sa_perfect_number_ladder() returns 3 entries, n=[6,28,496], τ=[4,6,10]
//   I9: sa_gz_inverse_u_peak monotone-decreasing Φ(I) → sign_change_count == 0
//   I10: sa_gz_inverse_u_peak finds peak at I=0.21 vs GZ_LOWER 0.21232 (H_618 cite)
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/SAVANT/savant_lib"

fn approx(a: float, b: float, tol: float) -> bool {
    let mut d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn main() {
    println("=== SAVANT/savant_lib_smoke ===")

    // I1: gz_width ≈ ln(4/3)
    let ln43 = log(4.0 / 3.0)
    let i1 = approx(sa_gz_width(), ln43, 1e-12)

    // I2: gz_lower = 1/2 - ln(4/3)
    let i2 = approx(sa_gz_lower(), 0.5 - ln43, 1e-12)

    // I3: in_golden_zone gate
    let g_lo = sa_gz_lower()
    let g_at_lower = sa_in_golden_zone(g_lo)
    let g_below    = sa_in_golden_zone(0.05)
    let i3 = g_at_lower == 1 && g_below == 0

    // I4: SI = max/mean
    let test_phi = [3.0, 1.0, 1.0, 1.0]
    let si = sa_savant_index(test_phi)
    let i4 = approx(si, 2.0, 1e-9)   // 3.0 / 1.5

    // I5: ΦD = max/min
    let phid = sa_phi_diversity(test_phi)
    let i5 = approx(phid, 3.0, 1e-9)

    // I6: ΦD_orthogonal (CoV) — uniform → 0
    let uniform = [1.0, 1.0, 1.0, 1.0]
    let cov0 = sa_phi_diversity_orthogonal(uniform)
    let i6 = approx(cov0, 0.0, 1e-9)

    // I7: golden_zone_compute(τ=4) ≈ ln(4/3)
    let gz4 = sa_golden_zone_compute(4)
    let i7 = approx(gz4["gz_width"], ln43, 1e-12)

    // I8: perfect-number ladder verbatim
    let ladder = sa_perfect_number_ladder()
    let i8a = ladder.len() == 3
    let i8b = ladder[0]["n"] == 6   && ladder[0]["tau"] == 4
    let i8c = ladder[1]["n"] == 28  && ladder[1]["tau"] == 6
    let i8d = ladder[2]["n"] == 496 && ladder[2]["tau"] == 10
    let i8  = i8a && i8b && i8c && i8d

    // I9 / I10: inverse-U peak on H_618 dense grid (verbatim Φ_collective series)
    //   I_grid = [0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50]
    //   Φ      = [8.03864, 7.32591, 6.99339, 6.50724, 5.72801, 5.22618, 3.98991, 3.05111]
    //   expected: peak |dΦ/dI| at I=0.21, sign_change_count=0
    let I_grid = [0.10, 0.15, 0.18, 0.21, 0.25, 0.30, 0.40, 0.50]
    let phi    = [8.03864, 7.32591, 6.99339, 6.50724, 5.72801, 5.22618, 3.98991, 3.05111]
    let pk = sa_gz_inverse_u_peak(phi, I_grid)
    let i9  = pk["sign_change_count"] == 0
    let i10 = approx(pk["peak_I"], 0.21, 1e-9)

    println("I1  gz_width=ln(4/3)        " + (if i1  { "PASS" } else { "FAIL" }))
    println("I2  gz_lower=1/2-ln(4/3)    " + (if i2  { "PASS" } else { "FAIL" }))
    println("I3  in_gz gate              " + (if i3  { "PASS" } else { "FAIL" }))
    println("I4  SI=max/mean             " + (if i4  { "PASS (SI=" + str(si) + ")" } else { "FAIL" }))
    println("I5  PhiD=max/min            " + (if i5  { "PASS" } else { "FAIL" }))
    println("I6  PhiD_cov(uniform)=0     " + (if i6  { "PASS" } else { "FAIL" }))
    println("I7  GZ(tau=4)=ln(4/3)       " + (if i7  { "PASS" } else { "FAIL" }))
    println("I8  perfect ladder verbatim " + (if i8  { "PASS (n=6/28/496, tau=4/6/10)" } else { "FAIL" }))
    println("I9  unimodal (sign_change=0)" + (if i9  { "PASS" } else { "FAIL" }))
    println("I10 peak_I=0.21 (H_618)     " + (if i10 { "PASS (peak_I=" + str(pk["peak_I"]) + ")" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7 && i8 && i9 && i10
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (10/10)" } else { "INVARIANT FAILURE" })
}
