// H_6196 — G0 trunk (h1129 303M) Φ-integration via faithful IIT4 big-Φ.
// Data = generated array literals (samples_data.hexa from extract_activations.py), fed to the
// SAME BRAIN/eeg eeg_big_phi faithful IIT4 engine anima uses on EEG (a_phi_iit4_tool).
// verdict = Δ (Φ_topvar − Φ_shuffle). n_ch=6 <= 8 (engine exact limit).
import "BRAIN/eeg/eeg_to_tpm.hexa"
import "state/6196_g0_phi_integration/samples_data.hexa"

fn main() {
    println("=== H_6196 G0 Φ-integration (faithful IIT4 big-Φ on h1129 hidden) ===")
    let nch = 4  // big-Φ exponential in n; 4 of 6 top-var channels (ch-major)
    let nsamp = d_nsamp()
    // calibration anchors (tool integrity): coupled > 0, independent ~ 0
    // inline calibration (coupled: ch1 = NOT ch0 → integrated; indep: ch1 = ch0 → no extra info)
    let coup = [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0]
    let indep = [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0]
    let cal_c = eeg_big_phi(coup, 2, 8, 1)
    let cal_i = eeg_big_phi(indep, 2, 8, 1)
    println("  [calib] coupled=" + str(cal_c[0]) + " independent=" + str(cal_i[0]))

    let p_top = eeg_big_phi(d_topvar(), nch, nsamp, 1)
    let p_shuf = eeg_big_phi(d_shuffle(), nch, nsamp, 1)
    let p_rand = eeg_big_phi(d_random(), nch, nsamp, 1)
    println("  topvar (real trunk)   big-Φ = " + str(p_top[0]))
    println("  shuffle-time (control) big-Φ = " + str(p_shuf[0]))
    println("  random-channels        big-Φ = " + str(p_rand[0]))

    let delta = p_top[0] - p_shuf[0]
    println("  ---")
    println("  Δ(topvar − shuffle) = " + str(delta))
    let verdict = "NULL-integration(<0.1)"
    if delta >= 0.5 { verdict = "INTEGRATED(>=0.5)" }
    println("  VERDICT = " + verdict + "  [frozen bar: >=0.5 integrated · <0.1 null]")
}
