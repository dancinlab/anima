// h9260_content_relay_clean_probe.hexa — H_9260
// ENGINE-NATIVE re-score of the H_1283 thalamus CONTENT-RELAY axis with
//   (a) the H_1328 VARIANCE-CLEAN rank-uniform read-out, and
//   (b) a CAPACITY-MATCHED structural control (X) — the control R6 never had.
// R6's original shuffle (Cperm) is graph-ISOMORPHIC: channels are exchangeable and
// differ only by initial value, which LEAK=0.55 erases in ~25 ticks. Its 93%/96%
// "survival" therefore measured a VOID control, not variance. See FREEZE.txt.
//
// Bars FROZEN before any Φ (c9/p7):
//   P1a  old min-max readout: ΔΦ(dense_shuffle − A) ≥ +0.02  (variance artifact EXISTS here)
//   P1b  rank-uniform readout: same trajectories ΔΦ ≤ +0.02   (readout REMOVES it)
//   P0   ΔΦ(A − Aperm) reported — proves the Bperm leg is NON-discriminative
//   G2   ΔΦ(B − A) ≥ +0.02 every seed
//   G3   ΔΦ(B − N) ≥ +0.02 every seed   (spanning, not extra leaky integrators)
//   G1   ΔΦ(B − X) ≥ +0.02 every seed   (disjointness, at matched capacity) ← the axis claim
//   G4   ΔΦ(B − Bperm) ≥ +0.02 every seed (necessary, not sufficient)
//   GREEN ⟺ P1a ∧ P1b ∧ G1 ∧ G2 ∧ G3 ∧ G4.
// Φ = stdlib exact MIP-EI (a_phi_iit4_tool); the engine never computes Φ. $0 CPU, deterministic.
// run from hexa-lang root:  cp <this> <hexa-lang>/ && hexa run <this>

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== core/engine_cli.hexa _lcg_*) ─────────────────
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── ARM trajectory, ENGINE-NATIVE ────────────────────────────────────────────
// mode: 0=A direct ring · 1=B multichannel(R6 verbatim) · 2=X capacity-matched shared cut
//       3=N carrier-matched bind-OFF(self-loop) · 4=R chord rewire
//       7=Cperm(R6 original shuffle) · 8=dense(R5) · 9=dense_shuffle(R5 control)
// RNG draw order is FIXED (states → inputs → channels → relay) so ARM A depends only on
// draws 1,2 and is byte-identical across every arm and to H_1448's arm A.
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_relay = 0.5

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    // draw 1 — module states
    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    // draw 2 — private inputs
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    // draw 3 — the N_EDGE parallel channel states (B/X/N/R/Cperm)
    let n_edge = 4
    let mut chans = []
    i = 0
    while i < n_edge {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        chans = chans + [row]
        i = i + 1
    }
    // draw 4 — the per-module relay channels (dense / dense_shuffle only)
    let mut relay = []
    i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        relay = relay + [row]
        i = i + 1
    }

    // edge endpoints per channel e — ring edges (0,1)(1,2)(2,3)(3,0);
    // Cperm = cyclic relabel [3,0,1,2]; R = chords (0,2)(1,3)(0,2)(1,3).
    let mut elo = [0, 1, 2, 3]
    let mut ehi = [1, 2, 3, 0]
    if mode == 7 { elo = [3, 0, 1, 2]  ehi = [0, 1, 2, 3] }
    if mode == 4 { elo = [0, 1, 0, 1]  ehi = [2, 3, 2, 3] }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        // ── cortex stage (uses PRE-update channel/relay values) ──
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                // relay re-injection into module i
                let mut rin = 0.0
                if mode == 1 || mode == 2 || mode == 4 || mode == 7 {
                    // mean of the channels incident on module i
                    let mut acc = 0.0
                    let mut cnt = 0
                    let mut e = 0
                    while e < n_edge {
                        if elo[e] == i || ehi[e] == i { acc = acc + chans[e][d]  cnt = cnt + 1 }
                        e = e + 1
                    }
                    if cnt > 0 { rin = acc / to_float(cnt) }
                }
                if mode == 3 { rin = chans[i][d] }              // N — its own self-loop channel
                if mode == 8 || mode == 9 { rin = relay[i][d] } // dense / dense_shuffle
                let mut v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                if mode != 0 { v = v + gain * (w_relay * rin) }
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }

        // ── thalamus stage (integrates PRE-update module states: one-tick delay) ──
        if mode == 1 || mode == 2 || mode == 4 || mode == 7 {
            // mean over ALL channels (X's cross-mixing term); computed on PRE values
            let mut cmean = []
            let mut d = 0
            while d < dim {
                let mut acc = 0.0
                let mut e = 0
                while e < n_edge { acc = acc + chans[e][d]  e = e + 1 }
                cmean = cmean + [acc / to_float(n_edge)]
                d = d + 1
            }
            let mut newch = []
            let mut e = 0
            while e < n_edge {
                let mut row = []
                d = 0
                while d < dim {
                    let pair = 0.5 * (states[elo[e]][d] + states[ehi[e]][d])
                    // B/R/Cperm: DISJOINT — channel e sees only its own pair.
                    // X: SAME total capacity (4x8) and SAME w_nbr gain, but half the
                    //    drive is the mean over ALL channels → disjointness destroyed,
                    //    spanning + capacity + energy preserved.
                    let mut drive = pair
                    if mode == 2 { drive = 0.5 * pair + 0.5 * cmean[d] }
                    row = row + [leak * chans[e][d] + gain * (w_nbr * drive)]
                    d = d + 1
                }
                newch = newch + [row]
                e = e + 1
            }
            chans = newch
        }
        if mode == 3 {
            // N — each channel integrates ONE module (no spanning). Same count/leak/gain.
            let mut newch = []
            let mut e = 0
            while e < n_edge {
                let mut row = []
                let mut d = 0
                while d < dim {
                    row = row + [leak * chans[e][d] + gain * (w_nbr * states[e][d])]
                    d = d + 1
                }
                newch = newch + [row]
                e = e + 1
            }
            chans = newch
        }
        if mode == 8 || mode == 9 {
            // R5 dense: relay_i integrates module i + the mean of all OTHER relays.
            // dense_shuffle: the "others" set is read from a permuted source (i+3)%4.
            let mut newrl = []
            i = 0
            while i < n_mod {
                let mut src = i
                if mode == 9 { src = (i + n_mod - 1) % n_mod }
                let mut row = []
                let mut d = 0
                while d < dim {
                    let mut acc = 0.0
                    let mut j = 0
                    while j < n_mod {
                        if j != src { acc = acc + relay[j][d] }
                        j = j + 1
                    }
                    let others = acc / to_float(n_mod - 1)
                    row = row + [leak * relay[i][d] + gain * (w_nbr * states[i][d] + w_relay * others)]
                    d = d + 1
                }
                newrl = newrl + [row]
                i = i + 1
            }
            relay = newrl
        }

        states = newstates

        // ── read-out: per-module salience e = ‖s_i‖² ──
        i = 0
        while i < n_mod {
            let mut e2 = 0.0
            let mut d = 0
            while d < dim { e2 = e2 + states[i][d] * states[i][d]  d = d + 1 }
            let _ = farr_set(traj, i * t_ticks + tt, e2)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

// ── H_1328 VARIANCE-CLEAN RANK-UNIFORM read-out (verbatim from H_1448) ───────
fn rank_uniform(traj: int, n: int, t: int) -> int {
    let out = farr_zeros(n * t)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < t {
            let vj = farr_get(traj, i * t + j)
            let mut r = 0
            let mut k = 0
            while k < t {
                let vk = farr_get(traj, i * t + k)
                if vk < vj {
                    r = r + 1
                } else {
                    if vk == vj { if k < j { r = r + 1 } }
                }
                k = k + 1
            }
            let _ = farr_set(out, i * t + j, to_float(r))
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// ── per-module circular time-shift (Xperm): marginals byte-identical, alignment destroyed
fn shift_modules(traj: int, n: int, t: int) -> int {
    let out = farr_zeros(n * t)
    let mut i = 0
    while i < n {
        let off = (i * 17) % t
        let mut j = 0
        while j < t {
            let src = (j + off) % t
            let _ = farr_set(out, i * t + j, farr_get(traj, i * t + src))
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// clean = 1 → rank-uniform (H_1328); clean = 0 → OLD raw min-max readout
// mode 5 = Bperm (shift of B) · mode 6 = Aperm (shift of A)
fn phi_of(seed: int, mode: int, clean: int) -> float {
    let mut traj = 0
    if mode == 5 {
        let b = gen_traj(seed, 1)
        traj = shift_modules(b, 4, 64)
        let _ = farr_free(b)
    } else {
        if mode == 6 {
            let a = gen_traj(seed, 0)
            traj = shift_modules(a, 4, 64)
            let _ = farr_free(a)
        } else {
            traj = gen_traj(seed, mode)
        }
    }
    let mut phi = 0.0
    if clean == 1 {
        let ranked = rank_uniform(traj, 4, 64)
        phi = iit4_faithful_phi(ranked, 4, 64, 8)
        let _ = farr_free(ranked)
    } else {
        phi = iit4_faithful_phi(traj, 4, 64, 8)
    }
    let _ = farr_free(traj)
    return phi
}

fn passfail(ok: bool) -> string { if ok { return "PASS" } else { return "FAIL" } }

fn main() {
    println("H_9260 — thalamus CONTENT-RELAY axis, variance-clean + capacity-matched re-score")
    println("faithful IIT4 Φ (exact MIP-EI, n=4) · seeds [3..11] · bars FROZEN (see FREEZE.txt)")
    println("arms: A=0 B=1 X=2 N=3 R=4 Bperm=5 Aperm=6 Cperm=7 dense=8 denseShuf=9")
    let seeds = [3, 4, 5, 6, 7, 8, 9, 10, 11]

    let mut p1a_all = true    // old readout: dense_shuffle − A >= +0.02 (artifact exists)
    let mut p1b_all = true    // new readout: dense_shuffle − A <= +0.02 (artifact removed)
    let mut g1_all = true
    let mut g2_all = true
    let mut g3_all = true
    let mut g4_all = true
    let mut ciso_cnt = 0

    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]

        // ── validity legs (P1a old readout / P1b new readout) ──
        let a_old  = phi_of(s, 0, 0)
        let ds_old = phi_of(s, 9, 0)
        let a_new  = phi_of(s, 0, 1)
        let ds_new = phi_of(s, 9, 1)
        let p1a = (ds_old - a_old) >= 0.02
        let p1b = (ds_new - a_new) <= 0.02
        if !p1a { p1a_all = false }
        if !p1b { p1b_all = false }

        // ── primary arms, variance-clean readout ──
        let pb  = phi_of(s, 1, 1)
        let px  = phi_of(s, 2, 1)
        let pn  = phi_of(s, 3, 1)
        let pr  = phi_of(s, 4, 1)
        let pbp = phi_of(s, 5, 1)
        let pap = phi_of(s, 6, 1)
        let pcp = phi_of(s, 7, 1)

        let g2 = (pb - a_new) >= 0.02
        let g3 = (pb - pn) >= 0.02
        let g1 = (pb - px) >= 0.02
        let g4 = (pb - pbp) >= 0.02
        if !g1 { g1_all = false }
        if !g2 { g2_all = false }
        if !g3 { g3_all = false }
        if !g4 { g4_all = false }

        let mut d_ciso = pb - pcp
        if d_ciso < 0.0 { d_ciso = 0.0 - d_ciso }
        if d_ciso < 0.02 { ciso_cnt = ciso_cnt + 1 }

        let p0 = a_new - pap   // control-on-the-control (reported, non-gating)
        let topo = pb - pr     // topography diagnostic (non-gating)

        println("seed " + to_string(s)
            + " | OLD A=" + a_old.to_string() + " dsh=" + ds_old.to_string()
            + " Δ=" + (ds_old - a_old).to_string() + " [P1a " + passfail(p1a) + "]")
        println("        | NEW A=" + a_new.to_string() + " dsh=" + ds_new.to_string()
            + " Δ=" + (ds_new - a_new).to_string() + " [P1b " + passfail(p1b) + "]")
        println("        | B=" + pb.to_string() + " X=" + px.to_string() + " N=" + pn.to_string()
            + " R=" + pr.to_string() + " Bperm=" + pbp.to_string() + " Aperm=" + pap.to_string()
            + " Cperm=" + pcp.to_string())
        println("        | G2(B-A)=" + (pb - a_new).to_string() + " " + passfail(g2)
            + " · G3(B-N)=" + (pb - pn).to_string() + " " + passfail(g3)
            + " · G1(B-X)=" + (pb - px).to_string() + " " + passfail(g1)
            + " · G4(B-Bperm)=" + (pb - pbp).to_string() + " " + passfail(g4))
        println("        | P0(A-Aperm)=" + p0.to_string()
            + " · C-ISO|B-Cperm|=" + d_ciso.to_string()
            + " · TOPO(B-R)=" + topo.to_string())
        si = si + 1
    }

    println("")
    println("P1a variance artifact EXISTS (old readout, every seed): " + passfail(p1a_all))
    println("P1b readout REMOVES it   (new readout, every seed): " + passfail(p1b_all))
    println("G2 BASE  ΔΦ(B-A) >= +0.02 every seed: " + passfail(g2_all))
    println("G3 SPAN  ΔΦ(B-N) >= +0.02 every seed: " + passfail(g3_all))
    println("G1 CUT   ΔΦ(B-X) >= +0.02 every seed: " + passfail(g1_all))
    println("G4 INT   ΔΦ(B-Bperm) >= +0.02 every seed: " + passfail(g4_all))
    println("C-ISO  |ΔΦ(B-Cperm)| < 0.02 on " + to_string(ciso_cnt) + "/9 seeds (>=7 → R6's c4 was a VOID control)")

    let valid = p1a_all && p1b_all
    if !valid {
        println("VERDICT: ⏳ MEASUREMENT INVALID — validity gate failed; no tier reported (bars NOT moved)")
    } else {
        if g1_all && g2_all && g3_all && g4_all {
            println("VERDICT: 🟢 GREEN — disjoint parallel relay beats baseline AND capacity-matched shared cut → content-relay wall was a CONTROL artifact → wire the multichannel lane")
        } else {
            println("VERDICT: 🧱 WALL — R6's GREEN is WITHDRAWN (it stood on a graph-isomorphic control); the content axis is closed under a variance-free readout AND a capacity-matched control")
        }
    }
}
