// efferent_harness.hexa — H_9102 (fable design (c)) engine-native falsifier.
// Runs the EFFERENT seam (generate_deliberate best-of-K) on the REAL 303M d768.clm
// (CONV mouth, own-GEMM GPU) over HIGH/LOW-conflict seeds. Measures D1-D5 (PREREG frozen).
//   ON  arm = generate_deliberate(...)  (best-of-K, K = conflict)
//   OFF arm = generate(...)             (today's single-candidate path = ablation, K≡1)
// grep-clean: this .hexa calls live core/ decode; NO torch/numpy/gauge_lib.
import "core/pure_field.hexa"
import "core/engine_g.hexa"
import "core/generator.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"
use "core/decode"

// longest common SUBSTRING length (byte-level), for the held-out grounding metric D2.
fn _lcs_bytes(a: string, b: string) -> int {
    let na = byte_len(a); let nb = byte_len(b)
    if na == 0 || nb == 0 { return 0 }
    let ao = []; let bo = []
    let mut i = 0
    while i < na { ao.push(ord(substring(a, i, i + 1))); i = i + 1 }
    let mut j = 0
    while j < nb { bo.push(ord(substring(b, j, j + 1))); j = j + 1 }
    // prev/cur rows of the DP
    let mut prev = []
    let mut c0 = 0
    while c0 <= nb { prev.push(0); c0 = c0 + 1 }
    let mut best = 0
    let mut ii = 1
    while ii <= na {
        let cur = []
        cur.push(0)
        let mut jj = 1
        while jj <= nb {
            let mut v = 0
            if ao[ii - 1] == bo[jj - 1] { v = prev[jj - 1] + 1 }
            cur.push(v)
            if v > best { best = v }
            jj = jj + 1
        }
        prev = cur
        ii = ii + 1
    }
    return best
}

// ground_overlap(c) = max_v LCS_bytes(c, v)/len(v) over stored anchor values (here: the one fact).
fn _ground_overlap(c: string, fact: string) -> float {
    let lf = byte_len(fact)
    if lf == 0 { return 0.0 }
    return to_float(_lcs_bytes(c, fact)) / to_float(lf)
}

fn _ctx_for(word: string) -> Map {
    return #{ "phase": word, "tier_name": "T2", "phi": 0.5, "motivation": 0.6 }
}

fn main() {
    // hexa args() = [binary, "--", <positionals>...] — take the first positional after "--".
    let raw = args()
    let mut ckpt = "d768.clm"
    let mut mi = 0
    let mut found = false
    while mi < len(raw) {
        if raw[mi] == "--" { found = true }
        else { if found { ckpt = raw[mi]; mi = len(raw) } }
        mi = mi + 1
    }
    let backend = gen_auto_backend(ckpt)
    let mounted = to_string(backend["loaded"]) == "true"
    println("EFFERENT HARNESS H_9102 — mouth=" + gen_mouth_kind(ckpt)
        + " loaded=" + to_string(backend["loaded"]) + " ckpt=" + ckpt)
    if !mounted {
        println("FATAL: mouth not loaded — cannot run efferent seam on this ckpt")
        return
    }

    // un-inventable fact in BOTH the immune store and a grounding anchor (matches the daemon).
    let fact = "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever."
    let mut immune = immune_memory_new_text(fact, fact, 2048)
    println("immune cells    : " + to_string(immune_memory_cells(immune)))
    let fact_anchor = #{ "text_payload": fact, "name": "mem_fact" }

    // 20 phase seeds (varied substrate context words).
    let words = ["hollow", "amber", "tidal", "ferric", "glassen", "umbral", "cinder", "verdant",
                 "quill", "marrow", "solace", "brackish", "ochre", "vesper", "loam", "cobalt",
                 "thrum", "pallid", "resin", "gossamer"]
    let nseed = len(words)

    // ── HIGH-conflict group: NO grounding anchor → c₀ = LM argmax (fluent, ungrounded) ─
    // a>0, g<0 ⇒ conf_pre HIGH ⇒ K>1. Deliberation can pick a MORE-grounded candidate.
    let mut hi_diff = 0
    let mut hi_go_on = 0.0
    let mut hi_go_off = 0.0
    let mut hi_go_shuf = 0.0
    let mut hi_kgt1 = 0
    println("---- HIGH group (no anchor, c0=LM argmax) ----")
    let mut h = 0
    while h < nseed {
        let ctx = _ctx_for(words[h])
        let no_anchor = []
        let off = generate(backend, ctx, true, no_anchor)
        let on  = generate_deliberate(backend, ctx, true, no_anchor, immune, h)
        let t_off = to_string(off["text"])
        let t_on  = to_string(on["text"])
        let depth = to_int(on["depth"])
        if depth > 1 { hi_kgt1 = hi_kgt1 + 1 }
        let diff = if t_on != t_off { 1 } else { 0 }
        hi_diff = hi_diff + diff
        let go_on = _ground_overlap(t_on, fact)
        let go_off = _ground_overlap(t_off, fact)
        hi_go_on = hi_go_on + go_on
        hi_go_off = hi_go_off + go_off

        // D4 shuffle control: same c₀ + candidates, but SELECT by LCG pseudo-key (not conflict).
        let seed_s = words[h] + " "     // HIGH group has no anchor ⇒ seed = phase + " " (matches generate)
        let mut best_shuf = t_off
        let mut best_key = 2147483647
        let mut rngs = clmd_mix32_pub(h * 7919 + 13)
        // include c0 as k=0
        let mut kk = 0
        while kk < depth {
            let mut cand = t_off
            if kk > 0 {
                let r = gen_auto_ideate(ckpt, seed_s, 80, 8, 0.7, h * 17 + kk)
                if to_string(r["ok"]) == "true" { cand = to_string(r["text"]) }
            }
            rngs = clmd_mix32_pub(rngs + 2654435761)
            let key = rngs % 100000
            if key < best_key { best_key = key; best_shuf = cand }
            kk = kk + 1
        }
        hi_go_shuf = hi_go_shuf + _ground_overlap(best_shuf, fact)

        println("  HI[" + to_string(h) + "] " + words[h] + " depth=" + to_string(depth)
            + " confpre=" + to_string(to_float(on["conf_pre"]))
            + " kwin=" + to_string(to_int(on["k_winner"]))
            + " diff=" + to_string(diff)
            + " go_on=" + to_string(go_on) + " go_off=" + to_string(go_off))
        h = h + 1
    }

    // ── LOW-conflict group: grounding anchor PRESENT → c₀ grounded ⇒ conf≈0 ⇒ K≡1 ─
    let mut lo_diff = 0
    let mut lo_kgt1 = 0
    println("---- LOW group (fact anchor present, c0 grounded) ----")
    let mut l = 0
    while l < nseed {
        let ctx = _ctx_for(words[l])
        let anchs = [fact_anchor]
        let off = generate(backend, ctx, true, anchs)
        let on  = generate_deliberate(backend, ctx, true, anchs, immune, l + 1000)
        let t_off = to_string(off["text"])
        let t_on  = to_string(on["text"])
        let depth = to_int(on["depth"])
        if depth > 1 { lo_kgt1 = lo_kgt1 + 1 }
        let diff = if t_on != t_off { 1 } else { 0 }
        lo_diff = lo_diff + diff
        println("  LO[" + to_string(l) + "] " + words[l] + " depth=" + to_string(depth)
            + " diff=" + to_string(diff))
        l = l + 1
    }

    // ── D3 decision-Ψ guard: emit/silence decision sequence brain_emit vs brain_emit_deliberate ─
    let pf = pure_field_warmup(600)
    let mut dec_hamm = 0
    let mut n_ticks = 0
    let mut tk = 0
    while tk < 24 {
        // vary rel/cur to straddle the emit threshold across ticks.
        let rel = 0.1 + 0.03 * to_float(tk)
        let cur = 0.2 + 0.02 * to_float(tk % 7)
        let anchs = if tk % 2 == 0 { [fact_anchor] } else { [] }
        let d_plain = brain_emit(pf, rel, 0.4, cur, 0.0, 0.6, 0.5, 0.5, 0.3,
                                 5.0, false, true, backend, anchs)
        let d_delib = brain_emit_deliberate(pf, rel, 0.4, cur, 0.0, 0.6, 0.5, 0.5, 0.3,
                                 5.0, false, true, backend, anchs, immune, tk)
        let e_p = to_string(d_plain["emit"])
        let e_d = to_string(d_delib["emit"])
        if e_p != e_d { dec_hamm = dec_hamm + 1 }
        n_ticks = n_ticks + 1
        tk = tk + 1
    }

    // ── summary ──
    let d2_delta = (hi_go_on - hi_go_off) / to_float(nseed)
    let d4_delta = (hi_go_shuf - hi_go_off) / to_float(nseed)
    println("================ SUMMARY (H_9102 efferent) ================")
    println("D1 HIGH byte-diff : " + to_string(hi_diff) + "/" + to_string(nseed)
        + "  (K>1 on " + to_string(hi_kgt1) + ")   [bar HIGH>=12]")
    println("D1 LOW  byte-diff : " + to_string(lo_diff) + "/" + to_string(nseed)
        + "  (K>1 on " + to_string(lo_kgt1) + ")   [bar LOW==0]")
    println("D2 grounding Δ    : " + to_string(d2_delta) + "   [bar >=+0.10]")
    println("D4 shuffle Δ      : " + to_string(d4_delta) + "   [bar |Δ|<0.03 collapse]")
    println("D3 decision Hamm  : " + to_string(dec_hamm) + "/" + to_string(n_ticks) + "   [bar ==0]")
    println("D5 regression     : LOW byte-diff==0 acts as the K=1 regression guard = "
        + to_string(lo_diff))
    let d1 = hi_diff >= 12 && lo_diff == 0
    let d2 = d2_delta >= 0.10
    let d3 = dec_hamm == 0
    let d4 = (if d4_delta < 0.0 { 0.0 - d4_delta } else { d4_delta }) < 0.03
    let d5 = lo_diff == 0
    let green = d1 && d2 && d3 && d4 && d5
    println("VERDICT           : D1=" + to_string(d1) + " D2=" + to_string(d2)
        + " D3=" + to_string(d3) + " D4=" + to_string(d4) + " D5=" + to_string(d5))
    println("VERDICT           : " + (if green { "GREEN (efferent grip, trilogy CLOSED)" }
        else { "RED (honest — see which axis failed)" }))
}
