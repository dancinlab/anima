// h1366_phi_303m_trajectory.hexa — does a REAL trained-303M learned substrate break the Φ-robustness wall?
//
// THE BINDING UPGRADE of H_1357. H_1357 emulated a learned substrate with a hand-built
// SEED-INDEPENDENT readout W over real pure_field oscillator telemetry (a PROXY, no GPU) → 🔶.
// H_1366 uses a GENUINE learned substrate: the residual-stream activations of the trained
// 303M ByteGPT (H_1129 GREEN-emergence ckpt, sha 19be1295..., val_ce 1.224), captured on GPU
// and reduced to n=4 macro-nodes × T=64 ticks (state/phi-303m-trajectory/traj_303m_data.hexa).
// A trained transformer's residual stream IS a learned correlation geometry imposed by trained
// weights — exactly what H_1357's W proxied. THIS is R3 = REAL trained-303M (NOT a proxy).
//
// HELD IDENTICAL to the H_1349/H_1357 lineage (so any difference is the REAL learned substrate):
//   faithful exact MIP-EI (a_phi_iit4_tool), variance-clean rank-uniform read-out (H_1328),
//   H_1283 relay (w_nbr 0.5) + H_1319 Kuramoto pacemaker (w_phase 0.5, omega_t 0.45, domega 0.08),
//   ARMS A=NO-COUPLING B=MECHANISM S=PERM-SHUFFLE O=OFFSET-SHUF, eps=0.02, seeds [1317,1318,1319].
//   ONLY the substrate SOURCE changes: real 303M macro-node saliences (vs oscillator/learned-W).
//
// FROZEN BARS (.verdicts/1366_phi_303m_trajectory/FREEZE.txt, committed BEFORE scoring):
//   eps=0.02. R1 ROBUST: REAL Φ_B>=Φ_A+eps ALL 3 seeds. R2 EARNED: REAL perm Φ_S<=Φ_A+eps AND
//   offset Φ_O<=Φ_A+eps ALL 3 seeds (perm may be Φ-invariant/degenerate — report honestly, the
//   operative discriminator is OFFSET). R3 REAL-SOURCE: substrate IS the sha-pinned real 303M dump.
//   ¬R1 -> the wall holds on a REAL learned substrate too (BINDING, proxy confirmed faithful).
//
// run from hexa-lang root: cp state/phi-303m-trajectory/h1366_phi_303m_trajectory.hexa <hexa-lang>/
//                          cp state/phi-303m-trajectory/traj_303m_data.hexa <hexa-lang>/
//                          && hexa run h1366_phi_303m_trajectory.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"
import "traj_303m_data.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319/1328/1332/1349/1357 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }

// ── RANK-UNIFORMIZE one node's T-length trajectory IN-PLACE (variance-clean read-out, H_1328) ──
//    VERBATIM from H_1332/H_1349/H_1357. output = multiset {0..T-1} -> uniform marginal.
fn rank_uniformize_cell(traj: int, base: int, t_ticks: int) {
    let ranks = farr_zeros(t_ticks)
    let mut k = 0
    while k < t_ticks {
        let vk = farr_get(traj, base + k)
        let mut r = 0
        let mut j = 0
        while j < t_ticks {
            let vj = farr_get(traj, base + j)
            if vj < vk { r = r + 1 }
            else { if (vj == vk) && (j < k) { r = r + 1 } }
            j = j + 1
        }
        let _ = farr_set(ranks, k, to_float(r))
        k = k + 1
    }
    k = 0
    while k < t_ticks { let _ = farr_set(traj, base + k, farr_get(ranks, k))  k = k + 1 }
    let _ = farr_free(ranks)
}

// pick the REAL 303M flat trajectory for a seed (generated literal arrays)
fn real_traj_for(seed: int) -> [float] {
    if seed == 1317 { return traj303m_1317() }
    if seed == 1318 { return traj303m_1318() }
    return traj303m_1319()
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// SUBSTRATE trajectory over the REAL 303M macro-nodes.
// mode: 0=NO-COUP(A) 1=MECHANISM(B) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// base salience of node i at tick t = the REAL 303M reduced activation real[i*T+t]. The coupling
// mechanism (H_1283 relay + H_1319 pacemaker carrier) is applied OVER these real saliences, held
// byte-identical to H_1349/H_1357 — the ONLY change vs H_1357 is base salience source (real 303M).
// ════════════════════════════════════════════════════════════════════════════════════════════
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let t_ticks = 64
    let w_nbr = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let real = real_traj_for(seed)   // flat [n_mod*t_ticks], node i = real[i*t_ticks + t]

    // phase pacemaker state — seed-perturbed INITIAL phase (SAME LCG seeding as H_1349/H_1357)
    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }
    let mut theta = []
    let mut i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi

    // perm / offset (VERBATIM from H_1332/H_1349/H_1357)
    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]  perm[k] = perm[jj]  perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix { let mut p2 = []  i = 0  while i < n_mod { p2 = p2 + [(i + 1) % n_mod]  i = i + 1 }  perm = p2 }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod { ss = lcg_next(ss)  shuf_off = shuf_off + [lcg_unit(ss) * two_pi]  i = i + 1 }
    }

    let traj = farr_zeros(n_mod * t_ticks)
    let mut tt = 0
    while tt < t_ticks {
        // 1. phase pacemaker (H_1319 Kuramoto) over the module FAST phases — coupled arms only
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                let omega_i = omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)
                newtheta = newtheta + [theta[i] + (omega_i + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // 2. base REAL 303M salience per node at this tick
        let mut base = []
        i = 0
        while i < n_mod { base = base + [farr_get(real, i * t_ticks + tt)]  i = i + 1 }

        // 3. re-entrant relay (H_1283): blend each node's real salience with ring-neighbour avg
        //    (coupled arms only). IDENTICAL to H_1349/H_1357; ARM A keeps nodes isolated.
        let mut coupled = []
        i = 0
        while i < n_mod {
            if mode == 0 {
                coupled = coupled + [base[i]]
            } else {
                let l = (i + n_mod - 1) % n_mod
                let r = (i + 1) % n_mod
                let nbr = (base[l] + base[r]) / 2.0
                coupled = coupled + [(1.0 - w_nbr) * base[i] + w_nbr * nbr]
            }
            i = i + 1
        }

        // 4. pacemaker phase carrier on the relay-coupled real salience (B/S/O); A = raw real value
        i = 0
        while i < n_mod {
            let mut sal = coupled[i]
            if mode != 0 {
                let mut rel = 0.0
                if mode == 1 { rel = theta[i] - theta_t }
                if mode == 2 { rel = theta[perm[i]] - theta_t }
                if mode == 3 { rel = (theta[i] - theta_t) + shuf_off[tt * n_mod + i] }
                let carrier = 0.5 * (1.0 + cos(rel))
                sal = sal * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

fn phi_of(seed: int, mode: int) -> float {
    let traj = gen_traj(seed, mode)
    let mut c = 0
    while c < 4 { rank_uniformize_cell(traj, c * 64, 64)  c = c + 1 }
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn main() {
    println("H_1366 — REAL trained-303M hidden-state trajectory (BINDING upgrade of H_1357) vs the Φ-robustness wall")
    println("faithful IIT4 Φ (exact MIP-EI, n=4, a_phi_iit4_tool) · variance-clean rank-uniform read-out (H_1328)")
    println("SUBSTRATE = REAL trained-303M residual-stream macro-nodes (sha-pinned dump) — NOT a proxy (R3)")
    println("seeds [1317,1318,1319] · eps=0.02 · ARMS A=NO-COUP B=MECHANISM S=PERM-SHUF O=OFFSET-SHUF")
    println("BARS: R1 REAL Φ_B>=Φ_A+eps all seeds · R2 REAL perm&off<=Φ_A+eps all seeds · R3 REAL-SOURCE (sha-pinned)")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut r1_all = true
    let mut r2_perm_all = true
    let mut r2_off_all = true
    let mut prev_dphi = 0.0
    let mut shrinks = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let a = phi_of(s, 0)
        let b = phi_of(s, 1)
        let sh = phi_of(s, 2)
        let o = phi_of(s, 3)

        let dphi  = b - a
        let smarg = sh - a
        let omarg = o - a

        let r1  = dphi  >= eps
        let r2p = smarg <= eps
        let r2o = omarg <= eps
        if !r1  { r1_all = false }
        if !r2p { r2_perm_all = false }
        if !r2o { r2_off_all = false }
        if si > 0 { if dphi > prev_dphi { shrinks = false } }
        prev_dphi = dphi

        println("seed " + to_string(s) + " REAL-303M: A=" + a.to_string() + " B=" + b.to_string()
            + " S=" + sh.to_string() + " O=" + o.to_string()
            + " | ΔΦ(B-A)=" + dphi.to_string() + " [R1 " + (if r1 {"PASS"} else {"FAIL"}) + "]"
            + " S-A=" + smarg.to_string() + " [R2perm " + (if r2p {"PASS"} else {"FAIL"}) + "]"
            + " O-A=" + omarg.to_string() + " [R2off " + (if r2o {"PASS"} else {"FAIL"}) + "]")
        si = si + 1
    }
    let r2 = r2_perm_all && r2_off_all
    println("---")
    println("R1 ROBUST (REAL Φ_B>=Φ_A+eps ALL seeds incl 1318/1319): " + (if r1_all {"PASS"} else {"FAIL"}))
    println("R2 EARNED (REAL perm&offset both <=Φ_A+eps ALL seeds): " + (if r2 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if r2_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if r2_off_all {"PASS"} else {"FAIL"}) + "]")
    println("seed-to-seed ΔΦ monotone-shrink (same fragility direction as H_1349/H_1357): " + (if shrinks {"YES"} else {"NO"}))
    println("R3 REAL-SOURCE (substrate IS sha-pinned real 303M dump): PASS")
    println("===")
    if r1_all && r2 {
        println("VERDICT 🟢 — a REAL trained-303M learned substrate ESCAPES the wall (robust + earned)")
        println("  where the proxy/oscillator did NOT. A GENUINE NEW RESULT the proxy missed. Report LOUDLY.")
        println("  Engine-native follow-on: wire a real-activation Φ read-out path.")
    } else {
        if !r1_all {
            println("VERDICT 🧱 (BINDING, STRONGEST on the substrate axis) — even a REAL trained-303M")
            println("  learned substrate INHERITS the orthogonal-seed fragility. The substrate axis is")
            println("  FULLY closed on the engine-real substrate H_1357 stood in for. PROXY CONFIRMED FAITHFUL.")
            println("  BOUNDS (does not retract) the prior Φ verdicts.")
        } else {
            println("VERDICT 🔶 — REAL R1 lift robust but NOT earned (perm degenerate / offset rides) → same")
            println("  collective/exchangeable shape as H_1349/H_1357 on a REAL learned substrate (BINDING confirms 🔶).")
        }
    }
}
