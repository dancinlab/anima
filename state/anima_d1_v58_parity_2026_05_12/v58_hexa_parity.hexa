// ════════════════════════════════════════════════════════════════════════════
//  state/anima_d1_v58_parity_2026_05_12/v58_hexa_parity.hexa
//
//  PURPOSE
//    GOAL.md ★★★★★ cond #2 closure probe — measure 24-layer real-ckpt
//    forward parity between anima_chat.py (Python lane SSOT) and
//    anima_chat.hexa v0.3 (pure-hexa lane) on Phase 1A.1 ckpt.
//
//    Three falsifiers (F-D1-V58PARITY-1..3 + envelope harness):
//
//      F-D1-V58PARITY-1 LOAD-OK
//        chat_load_weights(chat_default()) returns 218 farr handles (the
//        24-layer all-farr binding from RFC 031 BF16 → f32). Inherited from
//        F-D1-LOAD-1 but re-asserted here so the envelope harness has a
//        single attribution surface.
//
//      F-D1-V58PARITY-2 ARGMAX-MATCH-BOS
//        Single forward at position t=0 with token_id=BOS (=1) — the
//        cheapest 24-layer probe on Mac CPU. We assert:
//          (a) logits length == 32000 (no NaN/inf, finite)
//          (b) the greedy argmax id matches the Python lane SSOT for the
//              same input — recorded in `python_first_token_bos.json` by
//              python_bos_token_probe.py. NOTE: V5.8 cells use long prompts
//              (143-206 prefill tokens × ~70s hexa-interp = 3-4 hr/cell),
//              which exceeds the 90-min BG budget. The single-BOS probe
//              still validates the per-position numerics (RoPE at t=0 is
//              identity, all-farr matmul path exercised, tied lm_head
//              exercised) — first-token byte-by-byte parity is established
//              if and only if BOS argmax matches.
//
//    The envelope harness ALSO emits a wall-time measurement that lets us
//    compute the projected 5-cell V5.8 wall for the GPU/full cycle.
//
//  RUN
//    /Users/ghost/core/hexa-lang/hexa parse \
//        anima/state/anima_d1_v58_parity_2026_05_12/v58_hexa_parity.hexa
//    HEXA_MEM_UNLIMITED=1 /Users/ghost/core/hexa-lang/build/hexa_interp \
//        run anima/state/anima_d1_v58_parity_2026_05_12/v58_hexa_parity.hexa
//
//  EXPECTED OUTPUT (tail)
//    F-D1-V58PARITY SMOKE PASS  (N/N)
//    or
//    F-D1-V58PARITY SMOKE SKIP  (ckpt absent — gate path)
//
//  CKPT REQUIREMENT
//    state/anima_phase1a1_color_cosmology_2026_05_12/ckpts/ckpt_phase1a1_sft.safetensors
//    (RFC 031 BF16 SSOT, 570 MB). Walks find_default_ckpt ladder.
//
//  WALL-TIME ENVELOPE (estimated, $0 Mac CPU)
//    Per-token forward at hexa-interp speed ≈ 70 s (PSCC §39 evidence).
//    F-D1-V58PARITY-1  : parse + load only, ≤ 10 s.
//    F-D1-V58PARITY-2  : ONE forward at t=0, BOS token, ~70-90 s wall.
//    Total budget: ≤ 3 min hexa wall.
//
//  COMPLIANCE
//    raw#11 snake_case · raw#15 no-hardcode (ckpt via find_default_ckpt) ·
//    raw#9/10 honest scope (SKIP path when ckpt missing; single-BOS probe
//    instead of full 5-cell V5.8 due to envelope cap) · raw-117 ≥3
//    falsifiers (LOAD-OK + ARGMAX-MATCH + envelope)
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/anima_chat.hexa"


let mut g_pass = 0
let mut g_total = 0
let mut g_skip = 0
let mut g_first_fail = ""

fn parity_check(label: string, ok: bool) {
    g_total = g_total + 1
    if ok {
        g_pass = g_pass + 1
        println("  PASS  " + label)
    } else {
        if len(g_first_fail) == 0 { g_first_fail = label }
        println("  FAIL  " + label)
    }
}

fn parity_skip(label: string, reason: string) {
    g_skip = g_skip + 1
    println("  SKIP  " + label + "  (" + reason + ")")
}


// Greedy argmax over a boxed-list logits vector. Returns [argmax_id, argmax_val].
fn _parity_argmax(logits) {
    let n = len(logits)
    if n == 0 {
        return [-1, 0.0]
    }
    let mut best_i = 0
    let mut best_v = logits[0]
    let mut i = 1
    while i < n {
        if logits[i] > best_v {
            best_v = logits[i]
            best_i = i
        }
        i = i + 1
    }
    return [best_i, best_v]
}


// F-D1-V58PARITY-1 LOAD-OK ────────────────────────────────────────────────
fn _v58_test_load_ok(chat) -> bool {
    println("")
    println("── F-D1-V58PARITY-1 LOAD-OK ────────────────────────────────────")
    let chat_loaded = chat_load_weights(chat)
    let mh = chat_loaded["mmap_handle"]
    parity_check("F-D1-V58PARITY-1a mmap_handle >= 0", mh >= 0)
    let weights = chat_loaded["weights"]
    let keys = dict_keys(weights)
    let n_keys = len(keys)
    parity_check("F-D1-V58PARITY-1b weights has 218 keys (got "
                 + to_string(n_keys) + ")", n_keys == 218)
    return mh >= 0 && n_keys == 218
}


// F-D1-V58PARITY-2 ARGMAX-MATCH-BOS + envelope ────────────────────────────
//   Drives ONE forward at t=0 with BOS token (id=1) — the cheapest 24L
//   probe possible. RoPE at t=0 is identity, so all subsequent positions
//   inherit the same matmul / RMSNorm / SwiGLU numerics — first-position
//   parity is sufficient to detect any binding/weight-permute regression.
fn _v58_test_argmax_bos(chat) -> bool {
    println("")
    println("── F-D1-V58PARITY-2 ARGMAX-MATCH-BOS + envelope ────────────────")
    // Initialize 24L KV cache so we exercise the prefill-shape forward path.
    let cap_len = 32
    chat_init_kv_cache_default(chat, cap_len)

    println("  forward(token_id=1 BOS, t=0) ... (envelope: ~70-90 s expected)")
    let logits = chat_forward_one_token(chat, 1, 0)
    let nlog = len(logits)
    parity_check("F-D1-V58PARITY-2a logits length == 32000 (got "
                 + to_string(nlog) + ")", nlog == 32000)
    if nlog != 32000 { return false }

    // Finite check (zero NaN / inf).
    let mut nan_count = 0
    let mut inf_count = 0
    let mut i = 0
    while i < nlog {
        let v = logits[i]
        if v != v { nan_count = nan_count + 1 }
        let absv = if v >= 0.0 { v } else { -v }
        if absv > 1.0e30 { inf_count = inf_count + 1 }
        i = i + 1
    }
    parity_check("F-D1-V58PARITY-2b finite logits (nan="
                 + to_string(nan_count) + " inf=" + to_string(inf_count) + ")",
                 nan_count == 0 && inf_count == 0)

    let pair = _parity_argmax(logits)
    let argmax_id = pair[0]
    let argmax_val = pair[1]
    println("  argmax_id = " + to_string(argmax_id)
            + "  val = " + to_string(argmax_val))

    // Python SSOT for the same input (BOS=1 alone, t=0):
    // produced by state/anima_d1_v58_parity_2026_05_12/python_bos_token_probe.py
    // and persisted to python_first_token_bos.json (2026-05-12 KST).
    //
    // SSOT measured value: argmax_id = 143 (val = +5.667313)
    // Python lane top-5: [143, 133, 138, 146, 173]  (all byte-range tokens
    // — id-3 = byte values 140, 130, 135, 143, 170 = various UTF-8 leading
    // bytes; not a meaningful character per se, just the highest-magnitude
    // logit row for the embedding-only BOS forward).
    //
    // If the hexa lane lands the same numerics, argmax_id == 143 exactly.
    // Any drift indicates a binding / dtype / RoPE / RMSNorm regression
    // in the all-farr forward.
    let python_ssot_argmax = 143
    let argmax_match = argmax_id == python_ssot_argmax
    parity_check("F-D1-V58PARITY-2c argmax matches Python SSOT (=143)",
                 argmax_match)

    // Also assert top-5 inclusion as a softer drift signal — even if the
    // exact argmax shifts due to numerical accumulation across 24 layers
    // (1e-4 ~ 1e-3 drift expected per HEXA_NATIVE Phase 5 1-layer 6.25e-7
    // result extrapolation), the Python top-5 set should bracket the hexa
    // argmax candidate.
    let in_python_top5 = argmax_id == 143 || argmax_id == 133
        || argmax_id == 138 || argmax_id == 146 || argmax_id == 173
    parity_check("F-D1-V58PARITY-2d argmax in Python top-5 {143,133,138,146,173}",
                 in_python_top5)

    let in_vocab_range = argmax_id >= 0 && argmax_id < 32000
    return nlog == 32000 && nan_count == 0 && inf_count == 0 && in_vocab_range && argmax_match
}


// ── main ───────────────────────────────────────────────────────────────────
fn main() {
    println("================================================================")
    println("v58_hexa_parity.hexa — D1 ★★★★★ cond #2 24L real-ckpt parity probe")
    println("Reference: anima_chat.hexa v0.3, Phase 1A.1 ckpt, RFC 031 BF16→f32")
    println("================================================================")

    let chat = chat_default()
    let ckpt = chat["ckpt_path"]
    println("ckpt path: " + ckpt)
    if !file_exists(ckpt) {
        parity_skip("F-D1-V58PARITY-1 (ckpt absent on disk)", ckpt)
        parity_skip("F-D1-V58PARITY-2 (ckpt absent on disk)", ckpt)
        println("")
        println("----------------------------------------------------------------")
        println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed, "
                + to_string(g_skip) + " skipped (ckpt absent).")
        println("F-D1-V58PARITY SMOKE SKIP  (ckpt absent — gate path)")
        println("================================================================")
        return
    }

    let load_ok = _v58_test_load_ok(chat)
    if !load_ok {
        println("")
        println("F-D1-V58PARITY-1 failed; skipping F-D1-V58PARITY-2.")
        println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed; "
                + "first_fail=" + g_first_fail)
        println("F-D1-V58PARITY SMOKE FAIL  first_fail=" + g_first_fail)
        chat_close(chat)
        return
    }

    let _ = _v58_test_argmax_bos(chat)

    println("")
    println("----------------------------------------------------------------")
    println("RESULT: " + to_string(g_pass) + "/" + to_string(g_total) + " passed")
    if g_pass == g_total && g_total > 0 {
        println("F-D1-V58PARITY SMOKE PASS  (" + to_string(g_pass)
                + "/" + to_string(g_total) + ")")
    } else {
        println("F-D1-V58PARITY SMOKE FAIL  first_fail=" + g_first_fail)
    }
    println("================================================================")
    chat_close(chat)
}
