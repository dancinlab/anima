// H_9027/H_6170 decode.hexa BGB byte-parity probe. Decodes each fixture .bin with
// the live core/decode.hexa bytegpt_decode_argmax (BGB trailer + gated injected
// blocks) and prints the greedy token-id stream, to be diffed against decode.py's
// <name>.pyids (gen_fixtures.py). Entry-guarded module import — NOT a side-harness
// (this is the sanctioned byte-parity gate for the decode.hexa wire-in).
import "core/decode.hexa"

fn seed_ids() -> list {
    // "hello world " → byte ids
    let s = "hello world "
    let ids = []
    let mut i = 0
    let n = byte_len(s)
    while i < n { ids.push(ord(substring(s, i, i + 1))); i = i + 1 }
    return ids
}

fn run(tag: string, path: string, gen: int) {
    let r = bytegpt_decode_argmax(path, seed_ids(), gen)
    let ids = r["ids"]
    let mut line = tag + ":"
    let mut i = 0
    while i < len(ids) { line = line + " " + to_string(to_int(ids[i])); i = i + 1 }
    println(line)
}

fn main() {
    let base = "state/9027_bgb_injected_decode/hexa_parity"
    run("base", base + "/base.bin", 48)
    run("I1",   base + "/inj_I1.bin", 48)
    run("I2",   base + "/inj_I2.bin", 48)
    run("gate0", base + "/inj_gate0.bin", 48)
}
