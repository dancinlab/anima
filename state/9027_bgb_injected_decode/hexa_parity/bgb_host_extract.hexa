// AUTO-EXTRACTED host-scalar subset of core/decode.hexa (verbatim) for BGB
// byte-parity testing on fleet hexa lacking forge_dispatch_*/farr_attn_dt_*
// device builtins. Every fn below is copied byte-for-byte from decode.hexa.
// Generated by extract_host.py — do NOT hand-edit.

fn _bg_rd_u32(rb, off: int) -> int {
    return rb[off] + rb[off+1]*0x100 + rb[off+2]*0x10000 + rb[off+3]*0x1000000
}
fn _bg_gelu(x: float) -> float {
    return 0.5 * x * (1.0 + _bg_erf(x * 0.7071067811865476))
}
fn _bg_erf(x: float) -> float {
    return erf(x)   // libm erf — byte-match torch nn.GELU(); was A&S 7.1.26 ~1.38e-7 + dt_exp,
                    // accumulated argmax flip at 303M/L24 on pool-Linux (ING#23). dt_erf twin kept for training.
}
fn _bg_layernorm(X: int, g: int, b: int, Y: int, T: int, d: int) {
    let eps = 0.00001
    let mut i = 0
    while i < T {
        let mut mean = 0.0
        let mut c = 0
        while c < d { mean = mean + farr_get(X, i * d + c); c = c + 1 }
        mean = mean / to_float(d)
        let mut var = 0.0
        let mut c2 = 0
        while c2 < d {
            let dv = farr_get(X, i * d + c2) - mean
            var = var + dv * dv
            c2 = c2 + 1
        }
        var = var / to_float(d)
        let inv = 1.0 / dt_sqrt(var + eps)
        let mut c3 = 0
        while c3 < d {
            let xn = (farr_get(X, i * d + c3) - mean) * inv
            let _ = farr_set(Y, i * d + c3,
                             farr_get(g, c3) * xn + farr_get(b, c3))
            c3 = c3 + 1
        }
        i = i + 1
    }
}
fn _bg_linear(X: int, W: int, b: int, Y: int, T: int, Ci: int, Co: int) {
    let mut t = 0
    while t < T {
        let mut o = 0
        while o < Co {
            let mut acc = farr_get(b, o)
            let mut c = 0
            while c < Ci {
                acc = acc + farr_get(W, o * Ci + c) * farr_get(X, t * Ci + c)
                c = c + 1
            }
            let _ = farr_set(Y, t * Co + o, acc)
            o = o + 1
        }
        t = t + 1
    }
}
fn _bg_transpose(W: int, Co: int, Ci: int) -> int {
    let Wt = farr_zeros(Ci * Co)
    let mut o = 0
    while o < Co {
        let mut c = 0
        while c < Ci { let _ = farr_set(Wt, c * Co + o, farr_get(W, o * Ci + c)); c = c + 1 }
        o = o + 1
    }
    return Wt
}
fn _bg_mha(H: int, inW: int, inB: int, oW: int, oB: int, Aout: int,
           T: int, d: int, nh: int) {
    let hd = d / nh
    let scale = 1.0 / dt_sqrt(to_float(hd))
    // project Q,K,V : Q[t,j]=Σ_c inW[j*d+c]·H + inB[j]; K rows d..2d; V rows 2d..3d.
    let Q = farr_zeros(T * d)
    let K = farr_zeros(T * d)
    let V = farr_zeros(T * d)
    let mut t = 0
    while t < T {
        let mut j = 0
        while j < d {
            let mut accq = farr_get(inB, j)
            let mut acck = farr_get(inB, d + j)
            let mut accv = farr_get(inB, 2 * d + j)
            let mut c = 0
            while c < d {
                let hv = farr_get(H, t * d + c)
                accq = accq + farr_get(inW, j * d + c) * hv
                acck = acck + farr_get(inW, (d + j) * d + c) * hv
                accv = accv + farr_get(inW, (2 * d + j) * d + c) * hv
                c = c + 1
            }
            let _ = farr_set(Q, t * d + j, accq)
            let _ = farr_set(K, t * d + j, acck)
            let _ = farr_set(V, t * d + j, accv)
            j = j + 1
        }
        t = t + 1
    }
    // per head, causal softmax attention. ctx[t, h*hd+c].
    let ctx = farr_zeros(T * d)
    let srow = farr_zeros(T)
    let mut hh = 0
    while hh < nh {
        let base = hh * hd
        let mut i = 0
        while i < T {
            let L = i + 1
            // scores
            let mut mx = 0.0 - 1.0e30
            let mut jx = 0
            while jx < L {
                let mut dot = 0.0
                let mut c = 0
                while c < hd {
                    dot = dot + farr_get(Q, i * d + base + c) * farr_get(K, jx * d + base + c)
                    c = c + 1
                }
                let sv = dot * scale
                let _ = farr_set(srow, jx, sv)
                if sv > mx { mx = sv }
                jx = jx + 1
            }
            // softmax
            let mut tot = 0.0
            let mut j2 = 0
            while j2 < L {
                let e = exp(farr_get(srow, j2) - mx)   // libm exp (attention softmax) — torch parity, ING#23
                let _ = farr_set(srow, j2, e)
                tot = tot + e
                j2 = j2 + 1
            }
            // ctx = Σ_j (e/tot) · V
            let mut c2 = 0
            while c2 < hd {
                let mut acc = 0.0
                let mut j3 = 0
                while j3 < L {
                    acc = acc + (farr_get(srow, j3) / tot) * farr_get(V, j3 * d + base + c2)
                    j3 = j3 + 1
                }
                let _ = farr_set(ctx, i * d + base + c2, acc)
                c2 = c2 + 1
            }
            i = i + 1
        }
        hh = hh + 1
    }
    let _ = farr_free(srow)
    // output projection Aout = ctx · oWᵀ + oB
    _bg_linear(ctx, oW, oB, Aout, T, d, d)
    let _ = farr_free(Q); let _ = farr_free(K); let _ = farr_free(V); let _ = farr_free(ctx)
}
fn _bg_mha_mm(H: int, inWt: int, inB: int, oWt: int, oB: int, Aout: int,
              T: int, d: int, nh: int) {
    let hd = d / nh
    let scale = 1.0 / dt_sqrt(to_float(hd))
    // QKV = H[T,d] · inWt[d,3d] + inB  →  packed [T,3d], cols 0..d=Q, d..2d=K, 2d..3d=V
    let QKV = mm(H, T, d, inWt, 3 * d)  // GPU own-GEMM on CUDA host, else CPU farr_matmul (byte-id)
    let Q = farr_zeros(T * d)
    let K = farr_zeros(T * d)
    let V = farr_zeros(T * d)
    let mut t = 0
    while t < T {
        let mut j = 0
        while j < d {
            let _ = farr_set(Q, t * d + j, farr_get(QKV, t * 3 * d + j) + farr_get(inB, j))
            let _ = farr_set(K, t * d + j, farr_get(QKV, t * 3 * d + d + j) + farr_get(inB, d + j))
            let _ = farr_set(V, t * d + j, farr_get(QKV, t * 3 * d + 2 * d + j) + farr_get(inB, 2 * d + j))
            j = j + 1
        }
        t = t + 1
    }
    let _ = farr_free(QKV)
    // per head causal softmax attention → ctx[T,d] (scalar, byte-identical to _bg_mha)
    let ctx = farr_zeros(T * d)
    let srow = farr_zeros(T)
    let mut hh = 0
    while hh < nh {
        let base = hh * hd
        let mut i = 0
        while i < T {
            let L = i + 1
            let mut mx = 0.0 - 1.0e30
            let mut jx = 0
            while jx < L {
                let mut dot = 0.0
                let mut c = 0
                while c < hd {
                    dot = dot + farr_get(Q, i * d + base + c) * farr_get(K, jx * d + base + c)
                    c = c + 1
                }
                let sv = dot * scale
                let _ = farr_set(srow, jx, sv)
                if sv > mx { mx = sv }
                jx = jx + 1
            }
            let mut tot = 0.0
            let mut j2 = 0
            while j2 < L {
                let e = exp(farr_get(srow, j2) - mx)
                let _ = farr_set(srow, j2, e)
                tot = tot + e
                j2 = j2 + 1
            }
            let mut c2 = 0
            while c2 < hd {
                let mut acc = 0.0
                let mut j3 = 0
                while j3 < L {
                    acc = acc + (farr_get(srow, j3) / tot) * farr_get(V, j3 * d + base + c2)
                    j3 = j3 + 1
                }
                let _ = farr_set(ctx, i * d + base + c2, acc)
                c2 = c2 + 1
            }
            i = i + 1
        }
        hh = hh + 1
    }
    let _ = farr_free(srow)
    // out proj: Aout = ctx[T,d] · oWt[d,d] + oB
    _bg_linear_mm(ctx, oWt, oB, Aout, T, d, d)
    let _ = farr_free(Q); let _ = farr_free(K); let _ = farr_free(V); let _ = farr_free(ctx)
}
fn _bg_linear_mm(X: int, Wt: int, b: int, Y: int, T: int, Ci: int, Co: int) {
    let C = mm(X, T, Ci, Wt, Co)  // GPU own-GEMM on CUDA host, else CPU farr_matmul (byte-id)
    let mut t = 0
    while t < T {
        let mut o = 0
        while o < Co {
            let _ = farr_set(Y, t * Co + o, farr_get(C, t * Co + o) + farr_get(b, o))
            o = o + 1
        }
        t = t + 1
    }
    let _ = farr_free(C)
}
fn _bg_read_bind_trailer(path: string, byte_off: int, d: int) -> list {
    let bind = []
    let tb = read_bytes_at(path, byte_off, 8)
    // "BGB\x01" magic (66,71,66,1) + u32 n_bind; short read at EOF ⇒ len<8 ⇒ absent.
    if len(tb) >= 8 && tb[0] == 66 && tb[1] == 71 && tb[2] == 66 && tb[3] == 1 {
        let n_bind = _bg_rd_u32(tb, 4)
        let mut off = byte_off + 8
        let mut bi = 0
        while bi < n_bind {
            let ln1w = read_f32_at(path, off, d); off = off + d * 4
            let ln1b = read_f32_at(path, off, d); off = off + d * 4
            let inW = read_f32_at(path, off, 3 * d * d); off = off + 3 * d * d * 4
            let inB = read_f32_at(path, off, 3 * d); off = off + 3 * d * 4
            let oW = read_f32_at(path, off, d * d); off = off + d * d * 4
            let oB = read_f32_at(path, off, d); off = off + d * 4
            let ln2w = read_f32_at(path, off, d); off = off + d * 4
            let ln2b = read_f32_at(path, off, d); off = off + d * 4
            let m0W = read_f32_at(path, off, 4 * d * d); off = off + 4 * d * d * 4
            let m0B = read_f32_at(path, off, 4 * d); off = off + 4 * d * 4
            let m2W = read_f32_at(path, off, d * 4 * d); off = off + d * 4 * d * 4
            let m2B = read_f32_at(path, off, d); off = off + d * 4
            let gfa = read_f32_at(path, off, 1); off = off + 4
            let gate = farr_get(gfa, 0); let _ = farr_free(gfa)
            bind.push(#{ "ln1w": ln1w, "ln1b": ln1b, "inW": inW, "inB": inB,
                         "oW": oW, "oB": oB, "ln2w": ln2w, "ln2b": ln2b,
                         "m0W": m0W, "m0B": m0B, "m2W": m2W, "m2B": m2B, "gate": gate })
            bi = bi + 1
        }
    }
    return bind
}
fn _bg_apply_bind(x: int, bind: list, T: int, d: int, nh: int) {
    let mut bi = 0
    while bi < len(bind) {
        let blk = bind[bi]
        let ln1w = to_int(blk["ln1w"]); let ln1b = to_int(blk["ln1b"])
        let inW = to_int(blk["inW"]); let inB = to_int(blk["inB"])
        let oW = to_int(blk["oW"]); let oB = to_int(blk["oB"])
        let ln2w = to_int(blk["ln2w"]); let ln2b = to_int(blk["ln2b"])
        let m0W = to_int(blk["m0W"]); let m0B = to_int(blk["m0B"])
        let m2W = to_int(blk["m2W"]); let m2B = to_int(blk["m2B"])
        let gate = to_float(blk["gate"])

        let nrm = farr_zeros(T * d)
        let aout = farr_zeros(T * d)
        // xa = x + mha(ln1(x))
        _bg_layernorm(x, ln1w, ln1b, nrm, T, d)
        _bg_mha(nrm, inW, inB, oW, oB, aout, T, d, nh)
        let xa = farr_zeros(T * d)
        let mut i1 = 0
        while i1 < T * d { let _ = farr_set(xa, i1, farr_get(x, i1) + farr_get(aout, i1)); i1 = i1 + 1 }
        // mlpo = Wd(GELU(W0(ln2(xa))))
        let nrm2 = farr_zeros(T * d)
        _bg_layernorm(xa, ln2w, ln2b, nrm2, T, d)
        let h4 = farr_zeros(T * 4 * d)
        _bg_linear(nrm2, m0W, m0B, h4, T, d, 4 * d)
        let mut g = 0
        while g < T * 4 * d { let _ = farr_set(h4, g, _bg_gelu(farr_get(h4, g))); g = g + 1 }
        let mlpo = farr_zeros(T * d)
        _bg_linear(h4, m2W, m2B, mlpo, T, 4 * d, d)
        // block(x) = xa + mlpo ; x = x + gate*(block(x) - x)
        let mut i2 = 0
        while i2 < T * d {
            let blk_out = farr_get(xa, i2) + farr_get(mlpo, i2)
            let _ = farr_set(x, i2, farr_get(x, i2) + gate * (blk_out - farr_get(x, i2)))
            i2 = i2 + 1
        }
        let _ = farr_free(nrm); let _ = farr_free(aout); let _ = farr_free(xa)
        let _ = farr_free(nrm2); let _ = farr_free(h4); let _ = farr_free(mlpo)
        bi = bi + 1
    }
}
pub fn bg_load(path: string) -> Map {
    // ING #21 footgun fix: native per-tensor read_f32_at, NO whole-file boxing.
    // read_file_bytes(path) boxed the entire 1.2GB f32 binary into a HexaVal byte
    // array (~16.8 B/file-byte, runtime never-frees) → ~22.67GB load peak → OOM'd
    // hosts when bytegpt_decode_argmax ran on the 303M (measured: crashed summer).
    // read_f32_at reads each tensor's f32 slice straight into a farr — byte-identical
    // (max|Δ|=0, the same native reader the ranged path uses since #2667). Header is
    // a 20-byte read (mirrors bg_load_ranged). Originals are still kept (the scalar
    // forward reads them); only the whole-file box is eliminated.
    let hdr = read_bytes_at(path, 0, 20)
    let vocab = _bg_rd_u32(hdr, 0)
    let d     = _bg_rd_u32(hdr, 4)
    let nlay  = _bg_rd_u32(hdr, 8)
    let nh    = _bg_rd_u32(hdr, 12)
    let block = _bg_rd_u32(hdr, 16)
    let mut off = 20

    let tok = read_f32_at(path, off, vocab * d); off = off + vocab * d * 4
    let pos = read_f32_at(path, off, block * d); off = off + block * d * 4

    let ln1w = []; let ln1b = []; let inW = []; let inB = []
    let oW = []; let oB = []; let ln2w = []; let ln2b = []
    let m0W = []; let m0B = []; let m2W = []; let m2B = []
    let mut Lr = 0
    while Lr < nlay {
        ln1w.push(read_f32_at(path, off, d)); off = off + d * 4
        ln1b.push(read_f32_at(path, off, d)); off = off + d * 4
        inW.push(read_f32_at(path, off, 3 * d * d)); off = off + 3 * d * d * 4
        inB.push(read_f32_at(path, off, 3 * d)); off = off + 3 * d * 4
        oW.push(read_f32_at(path, off, d * d)); off = off + d * d * 4
        oB.push(read_f32_at(path, off, d)); off = off + d * 4
        ln2w.push(read_f32_at(path, off, d)); off = off + d * 4
        ln2b.push(read_f32_at(path, off, d)); off = off + d * 4
        m0W.push(read_f32_at(path, off, 4 * d * d)); off = off + 4 * d * d * 4
        m0B.push(read_f32_at(path, off, 4 * d)); off = off + 4 * d * 4
        m2W.push(read_f32_at(path, off, d * 4 * d)); off = off + d * 4 * d * 4
        m2B.push(read_f32_at(path, off, d)); off = off + d * 4
        Lr = Lr + 1
    }
    let lnfw = read_f32_at(path, off, d); off = off + d * 4
    let lnfb = read_f32_at(path, off, d); off = off + d * 4
    let head = read_f32_at(path, off, vocab * d); off = off + vocab * d * 4

    // ── OPTIONAL BGB injected-bind trailer (serialize_bind, H_9027 / H_6170). ──
    // "BGB\x01" = bytes 66,71,66,1 appended AFTER `head`, then u32 n_bind, then
    // n_bind GATED transformer blocks. Each block = a STANDARD base layer (the SAME
    // 12 param tensors, SAME order/layout as a base layer above — read here NON-
    // transposed for the scalar _bg_apply_bind path) then one LE f32 gate. Applied
    // in bg_forward_last_W AFTER the L base blocks and BEFORE ln_f (mirrors the CLM
    // "CLMB" trailer + decode.py::bg_load BGB path exactly). ABSENT ⇒ bind=[] ⇒
    // forward BYTE-IDENTICAL to plain ByteGPT. (Ranged read_bytes_at at EOF returns
    // len 0, so the guard is byte-parity-safe with decode.py's `off+8 <= len(rb)`.)
    let bind = _bg_read_bind_trailer(path, off, d)

    // Lane C fast path: pre-transpose every weight that feeds a d×d matmul ONCE
    // here (amortized over all forwards). bg_forward_last_W's native-GEMM path
    // consumes these [Ci,Co] transposes; the original [Co,Ci] arrays are kept so
    // the scalar reference forward (_bg_linear / _bg_mha) still works unchanged.
    let inWt = []; let oWt = []; let m0Wt = []; let m2Wt = []
    let mut Tr = 0
    while Tr < nlay {
        inWt.push(_bg_transpose(to_int(inW[Tr]), 3 * d, d))   // [3d,d] -> [d,3d]
        oWt.push(_bg_transpose(to_int(oW[Tr]), d, d))          // [d,d]  -> [d,d]
        m0Wt.push(_bg_transpose(to_int(m0W[Tr]), 4 * d, d))    // [4d,d] -> [d,4d]
        m2Wt.push(_bg_transpose(to_int(m2W[Tr]), d, 4 * d))    // [d,4d] -> [4d,d]
        Tr = Tr + 1
    }
    let headT = _bg_transpose(head, vocab, d)                  // [vocab,d] -> [d,vocab]

    return #{ "vocab": vocab, "d": d, "nlay": nlay, "nh": nh, "block": block,
              "tok": tok, "pos": pos, "ln1w": ln1w, "ln1b": ln1b,
              "inW": inW, "inB": inB, "oW": oW, "oB": oB,
              "ln2w": ln2w, "ln2b": ln2b, "m0W": m0W, "m0B": m0B,
              "m2W": m2W, "m2B": m2B, "lnfw": lnfw, "lnfb": lnfb, "head": head,
              "inWt": inWt, "oWt": oWt, "m0Wt": m0Wt, "m2Wt": m2Wt, "headT": headT,
              "bind": bind }
}
pub fn bg_forward_last_W(W: Map, ids: int, T: int) -> int {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let nh = to_int(W["nh"])
    let tok = to_int(W["tok"]); let pos = to_int(W["pos"])
    let ln1w = W["ln1w"]; let ln1b = W["ln1b"]; let inB = W["inB"]
    let oB = W["oB"]; let ln2w = W["ln2w"]; let ln2b = W["ln2b"]
    let m0B = W["m0B"]; let m2B = W["m2B"]
    // Lane C fast path: pre-transposed weights for the native GEMM (built in bg_load).
    let inWt = W["inWt"]; let oWt = W["oWt"]; let m0Wt = W["m0Wt"]; let m2Wt = W["m2Wt"]

    let x = farr_zeros(T * d)
    let mut t = 0
    while t < T {
        let id = to_int(farr_get(ids, t))
        let mut c = 0
        while c < d {
            let _ = farr_set(x, t * d + c,
                             farr_get(tok, id * d + c) + farr_get(pos, t * d + c))
            c = c + 1
        }
        t = t + 1
    }

    let nrm = farr_zeros(T * d)
    let aout = farr_zeros(T * d)
    let h4 = farr_zeros(T * 4 * d)
    let mlpo = farr_zeros(T * d)

    let mut Lr = 0
    while Lr < nlay {
        _bg_layernorm(x, to_int(ln1w[Lr]), to_int(ln1b[Lr]), nrm, T, d)
        _bg_mha_mm(nrm, to_int(inWt[Lr]), to_int(inB[Lr]), to_int(oWt[Lr]), to_int(oB[Lr]), aout, T, d, nh)
        let mut i1 = 0
        while i1 < T * d { let _ = farr_set(x, i1, farr_get(x, i1) + farr_get(aout, i1)); i1 = i1 + 1 }

        _bg_layernorm(x, to_int(ln2w[Lr]), to_int(ln2b[Lr]), nrm, T, d)
        _bg_linear_mm(nrm, to_int(m0Wt[Lr]), to_int(m0B[Lr]), h4, T, d, 4 * d)
        let mut g = 0
        while g < T * 4 * d { let _ = farr_set(h4, g, _bg_gelu(farr_get(h4, g))); g = g + 1 }
        _bg_linear_mm(h4, to_int(m2Wt[Lr]), to_int(m2B[Lr]), mlpo, T, 4 * d, d)
        let mut i2 = 0
        while i2 < T * d { let _ = farr_set(x, i2, farr_get(x, i2) + farr_get(mlpo, i2)); i2 = i2 + 1 }
        Lr = Lr + 1
    }
    let _ = farr_free(nrm); let _ = farr_free(aout); let _ = farr_free(h4); let _ = farr_free(mlpo)

    // appended injected-bind blocks (H_9027 / H_6170) — after the base stack, before
    // ln_f. Absent/empty ⇒ x unchanged ⇒ byte-identical to plain ByteGPT.
    let bind = W["bind"]
    if len(bind) > 0 { _bg_apply_bind(x, bind, T, d, nh) }

    let lnfw = to_int(W["lnfw"]); let lnfb = to_int(W["lnfb"]); let head = to_int(W["head"])
    let lastrow = farr_zeros(d)
    let last = (T - 1) * d
    let xt = farr_zeros(d)
    let mut cc = 0
    while cc < d { let _ = farr_set(xt, cc, farr_get(x, last + cc)); cc = cc + 1 }
    _bg_layernorm(xt, lnfw, lnfb, lastrow, 1, d)

    // head logits: logits[k] = Σ_c head[k*d+c]·lastrow[c]. Portable scalar loop (vocab×d, the
    // cheapest op; NOT the d×d hot path). Was farr_packed_gemv_offset — absent from older hexa
    // runtimes (aiden link-fails) — scalar is byte-identical (same i-outer/j-inner) + portable.
    let logits = farr_zeros(vocab)
    let mut hk = 0
    while hk < vocab {
        let mut hacc = 0.0
        let mut hc = 0
        while hc < d { hacc = hacc + farr_get(head, hk * d + hc) * farr_get(lastrow, hc); hc = hc + 1 }
        let _ = farr_set(logits, hk, hacc)
        hk = hk + 1
    }
    let _ = farr_free(x); let _ = farr_free(lastrow); let _ = farr_free(xt)
    return logits
}
fn _bg_kv_new(nlay: int, cap: int, d: int) -> Map {
    let K = []
    let V = []
    let mut l = 0
    while l < nlay {
        K.push(farr_zeros(cap * d))
        V.push(farr_zeros(cap * d))
        l = l + 1
    }
    return #{ "K": K, "V": V, "cap": cap }
}
fn _bg_kv_free(kv: Map) {
    let K = kv["K"]; let V = kv["V"]
    let mut l = 0
    while l < len(K) { let _ = farr_free(to_int(K[l])); let _ = farr_free(to_int(V[l])); l = l + 1 }
}
fn _bg_kv_step(W: Map, kv: Map, id: int, pos_p: int) -> int {
    let vocab = to_int(W["vocab"]); let d = to_int(W["d"])
    let nlay = to_int(W["nlay"]); let nh = to_int(W["nh"])
    let hd = d / nh
    let scale = 1.0 / dt_sqrt(to_float(hd))
    let tok = to_int(W["tok"]); let pos = to_int(W["pos"])
    let ln1w = W["ln1w"]; let ln1b = W["ln1b"]; let inB = W["inB"]
    let oB = W["oB"]; let ln2w = W["ln2w"]; let ln2b = W["ln2b"]
    let m0B = W["m0B"]; let m2B = W["m2B"]
    let inWt = W["inWt"]; let oWt = W["oWt"]; let m0Wt = W["m0Wt"]; let m2Wt = W["m2Wt"]
    let Kc = kv["K"]; let Vc = kv["V"]

    // residual stream for THIS token: x[d] = tok[id] + pos[pos_p]
    let x = farr_zeros(d)
    let mut c = 0
    while c < d {
        let _ = farr_set(x, c, farr_get(tok, id * d + c) + farr_get(pos, pos_p * d + c))
        c = c + 1
    }
    let Lrows = pos_p + 1   // live cache rows after appending this token (causal: 0..pos_p)

    let nrm = farr_zeros(d)
    let h4 = farr_zeros(4 * d)
    let mlpo = farr_zeros(d)

    let mut Lr = 0
    while Lr < nlay {
        // ── attention sub-block: x = x + MHA(LN1(x)) on the single row ──
        _bg_layernorm(x, to_int(ln1w[Lr]), to_int(ln1b[Lr]), nrm, 1, d)
        // QKV = nrm[1,d] · inWt[d,3d] + inB  (gemv == batched-mm row, byte-id)
        let QKV = mm(nrm, 1, d, to_int(inWt[Lr]), 3 * d)
        let inBl = to_int(inB[Lr])
        // Q[d] for this row; append K,V into cache at row pos_p
        let q = farr_zeros(d)
        let Kl = to_int(Kc[Lr]); let Vl = to_int(Vc[Lr])
        let mut j = 0
        while j < d {
            let _ = farr_set(q, j, farr_get(QKV, j) + farr_get(inBl, j))
            let _ = farr_set(Kl, pos_p * d + j, farr_get(QKV, d + j) + farr_get(inBl, d + j))
            let _ = farr_set(Vl, pos_p * d + j, farr_get(QKV, 2 * d + j) + farr_get(inBl, 2 * d + j))
            j = j + 1
        }
        let _ = farr_free(QKV)
        // per-head causal softmax: query = row pos_p, keys/values = cache rows 0..pos_p
        let ctx = farr_zeros(d)
        let srow = farr_zeros(Lrows)
        let mut hh = 0
        while hh < nh {
            let base = hh * hd
            let mut mx = 0.0 - 1.0e30
            let mut jx = 0
            while jx < Lrows {
                let mut dot = 0.0
                let mut cc2 = 0
                while cc2 < hd {
                    dot = dot + farr_get(q, base + cc2) * farr_get(Kl, jx * d + base + cc2)
                    cc2 = cc2 + 1
                }
                let sv = dot * scale
                let _ = farr_set(srow, jx, sv)
                if sv > mx { mx = sv }
                jx = jx + 1
            }
            let mut tot = 0.0
            let mut j2 = 0
            while j2 < Lrows {
                let e = exp(farr_get(srow, j2) - mx)
                let _ = farr_set(srow, j2, e)
                tot = tot + e
                j2 = j2 + 1
            }
            let mut c2 = 0
            while c2 < hd {
                let mut acc = 0.0
                let mut j3 = 0
                while j3 < Lrows {
                    acc = acc + (farr_get(srow, j3) / tot) * farr_get(Vl, j3 * d + base + c2)
                    j3 = j3 + 1
                }
                let _ = farr_set(ctx, base + c2, acc)
                c2 = c2 + 1
            }
            hh = hh + 1
        }
        let _ = farr_free(srow); let _ = farr_free(q)
        // out proj: aout[d] = ctx[1,d] · oWt[d,d] + oB  ; x += aout
        _bg_linear_mm(ctx, to_int(oWt[Lr]), to_int(oB[Lr]), nrm, 1, d, d)
        let mut i1 = 0
        while i1 < d { let _ = farr_set(x, i1, farr_get(x, i1) + farr_get(nrm, i1)); i1 = i1 + 1 }
        let _ = farr_free(ctx)

        // ── mlp sub-block: x = x + Wd(GELU(W0(LN2(x)))) on the single row ──
        _bg_layernorm(x, to_int(ln2w[Lr]), to_int(ln2b[Lr]), nrm, 1, d)
        _bg_linear_mm(nrm, to_int(m0Wt[Lr]), to_int(m0B[Lr]), h4, 1, d, 4 * d)
        let mut g = 0
        while g < 4 * d { let _ = farr_set(h4, g, _bg_gelu(farr_get(h4, g))); g = g + 1 }
        _bg_linear_mm(h4, to_int(m2Wt[Lr]), to_int(m2B[Lr]), mlpo, 1, 4 * d, d)
        let mut i2 = 0
        while i2 < d { let _ = farr_set(x, i2, farr_get(x, i2) + farr_get(mlpo, i2)); i2 = i2 + 1 }
        Lr = Lr + 1
    }
    let _ = farr_free(h4); let _ = farr_free(mlpo)

    // final LayerNorm + tied head on the single row
    let lnfw = to_int(W["lnfw"]); let lnfb = to_int(W["lnfb"]); let head = to_int(W["head"])
    let lastrow = farr_zeros(d)
    _bg_layernorm(x, lnfw, lnfb, lastrow, 1, d)
    let logits = farr_zeros(vocab)
    let mut hk = 0
    while hk < vocab {
        let mut hacc = 0.0
        let mut hc = 0
        while hc < d { hacc = hacc + farr_get(head, hk * d + hc) * farr_get(lastrow, hc); hc = hc + 1 }
        let _ = farr_set(logits, hk, hacc)
        hk = hk + 1
    }
    let _ = farr_free(x); let _ = farr_free(nrm); let _ = farr_free(lastrow)
    return logits
}
fn bg_argmax(a: int, n: int) -> int {
    let mut bi = 0
    let mut bv = farr_get(a, 0)
    let mut k = 1
    while k < n {
        let v = farr_get(a, k)
        if v > bv { bv = v; bi = k }
        k = k + 1
    }
    return bi
}
pub fn bytegpt_decode_argmax(path: string, seed_ids: list, gen: int) -> Map {
    let W = bg_load(path)
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    // running token list (ints), seeded from seed_ids
    let toks = []
    let mut i = 0
    while i < len(seed_ids) { toks.push(to_int(seed_ids[i])); i = i + 1 }
    let outl = []
    let mut out = ""
    // KV-cache fast path (no window slide): O(gen) greedy, byte-identical to the
    // full-forward loop below (bytegpt_kvcache_smoke: seed-pos max|Δ|=0.0).
    // NOTE: this stays on the HOST _bg_kv_step (NOT the P2 device router
    // _bg_kv_step_r that bytegpt_decode_argmax_ranged uses): the device
    // _bg_kv_step_dev reads the pre-split QKV weights inWt_q/k/v + *_e biases
    // that ONLY bg_load_ranged populates — the whole-file bg_load here does not,
    // so device-routing this decoder crashes on a CUDA host (map key 'inWt_q'
    // not found). Follow-up to device-route: teach bg_load the same _bg_col_slice
    // QKV pre-split (or migrate this non-live 24GB path onto bg_load_ranged).
    let nseed = len(toks)
    let d = to_int(W["d"]); let nlay = to_int(W["nlay"])
    // BGB injected-bind models skip the KV path (the appended blocks attend over the
    // full post-base sequence, which incremental K,V can't supply) → full-forward
    // fallback below, which applies bind (byte-parity with decode.py::_bg_step_logits).
    if len(W["bind"]) == 0 && nseed > 0 && nseed + gen <= block {
        let kv = _bg_kv_new(nlay, block, d)
        let mut logits = -1
        let mut sp = 0
        while sp < nseed {
            if logits >= 0 { let _ = farr_free(logits) }
            logits = _bg_kv_step(W, kv, to_int(toks[sp]), sp)
            sp = sp + 1
        }
        let mut gc = 0
        while gc < gen {
            let nb = bg_argmax(logits, vocab)
            let _ = farr_free(logits)
            toks.push(nb); outl.push(nb); out = out + chr(nb)
            logits = _bg_kv_step(W, kv, nb, len(toks) - 1)
            gc = gc + 1
        }
        let _ = farr_free(logits)
        _bg_kv_free(kv)
        return #{ "ok": true, "text": out, "ids": outl }
    }
    let mut g = 0
    while g < gen {
        // window = last `block` tokens
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let tv = toks[start + p]; let _ = farr_set(ids, p, to_float(tv)); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let nb = bg_argmax(logits, vocab)
        let _ = farr_free(logits); let _ = farr_free(ids)
        toks.push(nb)
        outl.push(nb)
        out = out + chr(nb)
        g = g + 1
    }
    return #{ "ok": true, "text": out, "ids": outl }
}

fn _seed_ids() -> list {
    let s = "hello world "
    let ids = []
    let mut i = 0
    let n = byte_len(s)
    while i < n { ids.push(ord(substring(s, i, i + 1))); i = i + 1 }
    return ids
}

fn _run(tag: string, path: string, gen: int) {
    let r = bytegpt_decode_argmax(path, _seed_ids(), gen)
    let ids = r["ids"]
    let mut line = tag + ":"
    let mut i = 0
    while i < len(ids) { line = line + " " + to_string(to_int(ids[i])); i = i + 1 }
    println(line)
}

fn main() {
    let base = "."
    _run("base", base + "/base.bin", 48)
    _run("I1",   base + "/inj_I1.bin", 48)
    _run("I2",   base + "/inj_I2.bin", 48)
    _run("gate0", base + "/inj_gate0.bin", 48)
}
