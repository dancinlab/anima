// h1357_phi_learned_substrate.hexa — does a LEARNED substrate break the Φ-robustness wall?
//
// THE WALL: faithful-IIT4 Φ-robustness is 🧱 across 9 measure cuts + size (N=12) + substrate
// (H_1349 live-CORE pure_field OSCILLATOR Engine A). Consistent diagnosis: the wall lives in
// the SUBSTRATE-SEED GEOMETRY. H_1349 (real oscillator) cleared R1 but the lift SHRANK
// seed-to-seed (the seed perturbs the modules' INITIAL OSCILLATOR PHASE -> a different
// correlation geometry per seed) and the perm control RODE the lift (exchangeable modules).
//
// THE NEW ANGLE (a_no_llm_frame_trap / a_break_the_wall): a LEARNED substrate is different in
// kind — a trained readout imposes a FIXED, SEED-INDEPENDENT correlation geometry. Does it
// ESCAPE the orthogonal-seed fragility that defeated the oscillator at seeds 1318/1319?
//
// SUBSTRATE SOURCE (HONEST, c9): NO trained-303M state is locally reachable ($0 CPU, no GPU).
// We DO NOT fabricate one. SUBSTRATE = "proxy-from-telemetry + deterministic learned-readout,
// NOT a trained-303M trajectory": the n_mod=4 REAL pure_field oscillator modules (byte-faithful
// from core/pure_field.hexa, IDENTICAL to H_1349's REAL arm) supply raw field-energy + osc
// values; a FIXED learned-readout projection W (n_mod x n_mod, deterministic, SEED-INDEPENDENT,
// emulating a trained embedding/readout head) MIXES the modules into salience. W is built ONCE
// from a FIXED non-seed constant so its geometry is the SAME across all 3 seeds — the defining
// property of a learned substrate vs the seed-perturbed oscillator. => DIRECTIONAL-on-proxy.
//
// HELD IDENTICAL to H_1349: faithful exact MIP-EI (a_phi_iit4_tool), variance-clean rank-uniform
// read-out (H_1328), H_1283 relay + H_1319 phase pacemaker, ARMS A/B/S/O, perm/offset (H_1332),
// eps=0.02, seeds [1317,1318,1319]. ONLY the learned-readout mix is added (vs the oscillator).
//
// FROZEN BARS (.verdicts/1357_phi_learned_substrate/FREEZE.txt, committed BEFORE scoring; GREEN iff R1&R2&R3):
//   eps=0.02. R1 ROBUST: LEARNED Φ_B>=Φ_A+eps ALL 3 seeds. R2 EARNED: LEARNED perm Φ_S<=Φ_A+eps
//   AND offset Φ_O<=Φ_A+eps ALL 3 seeds. R3 ATTRIB: OSCILLATOR arm (learned OFF) reproduces the
//   H_1349 perm-riding / seed-shrinking signature in-run. ¬R1 -> wall holds on a LEARNED substrate too.
//
// run from hexa-lang root: cp state/phi-learned-substrate/h1357_phi_learned_substrate.hexa <hexa-lang>/
//                          && hexa run h1357_phi_learned_substrate.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319/1328/1332/1349 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }

// ── RANK-UNIFORMIZE one cell's T-length trajectory IN-PLACE (variance-clean read-out, H_1328) ──
// VERBATIM from H_1332/H_1349: output = multiset {0..T-1} -> uniform marginal -> MI = joint only.
fn rank_uniformize_cell(traj: int, base: int, t_ticks: int) {
    let ranks = farr_zeros(t_ticks)
    let mut k = 0
    while k < t_ticks {
        let vk = farr_get(traj, base + k)
        let mut r = 0
        let mut j = 0
        while j < t_ticks {
            let vj = farr_get(traj, base + j)
            if vj < vk { r = r + 1 }
            else { if (vj == vk) && (j < k) { r = r + 1 } }
            j = j + 1
        }
        let _ = farr_set(ranks, k, to_float(r))
        k = k + 1
    }
    k = 0
    while k < t_ticks { let _ = farr_set(traj, base + k, farr_get(ranks, k))  k = k + 1 }
    let _ = farr_free(ranks)
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// REAL pure_field oscillator module dynamics — byte-faithful from core/pure_field.hexa (H_1349).
// PSI_ALPHA=0.014  LN2=0.6931471805599453  tau fast/medium/slow = 2/40/400  FIELD_DIM=6
// ════════════════════════════════════════════════════════════════════════════════════════════
fn osc_tick(phase: float, amp: float, tau: int) -> [float] {
    let tau_f = to_float(tau)
    let dphase = (2.0 * 3.14159265) / tau_f
    let new_phase = phase + dphase
    let alpha = 0.014
    let ln2 = 0.6931471805599453
    let new_amp = amp + alpha * (ln2 - amp)
    return [new_phase, new_amp]
}
fn osc_value(phase: float, amp: float) -> float { return amp * sin(phase) }

fn field_build(vf: float, vm: float, vs: float) -> int {
    let f = farr_zeros(6)
    let mix_fm = vf * vm
    let mix_ms = vm * vs
    let mix_fs = vf * vs
    let _ = farr_set(f, 0, vf)
    let _ = farr_set(f, 1, mix_fm)
    let _ = farr_set(f, 2, vs)
    let _ = farr_set(f, 3, mix_fs)
    let _ = farr_set(f, 4, mix_ms)
    let _ = farr_set(f, 5, vf + vm + vs)
    return f
}
fn field_raw_phi(f: int, vf: float, vm: float, vs: float) -> float {
    let mut mean = 0.0
    let mut i = 0
    while i < 6 { mean = mean + farr_get(f, i)  i = i + 1 }
    mean = mean / 6.0
    let mut sum_sq = 0.0
    i = 0
    while i < 6 {
        let d = farr_get(f, i) - mean
        sum_sq = sum_sq + d * d
        i = i + 1
    }
    let variance = sum_sq / 6.0
    let af = if vf < 0.0 { 0.0 - vf } else { vf }
    let am = if vm < 0.0 { 0.0 - vm } else { vm }
    let as_ = if vs < 0.0 { 0.0 - vs } else { vs }
    let energy = af + am + as_
    return variance * energy
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// LEARNED-READOUT projection W (n_mod x n_mod) — the LEARNED substrate flavor.
// DETERMINISTIC + SEED-INDEPENDENT: built ONCE from a FIXED non-seed constant (NOT the trial
// seed), so the module-mixing correlation geometry is IDENTICAL across all 3 seeds. This is the
// defining property vs the oscillator (whose geometry is seed-perturbed). Emulates a TRAINED
// embedding/readout head that mixes modules through a fixed weight (a learned mapping). Rows are
// L1-normalized so the mix is a convex blend (a stable readout). W is row-major n_mod*n_mod.
// HONEST: this is a PROXY for a trained-303M readout, NOT a trained-303M trajectory.
fn build_learned_W(n_mod: int) -> int {
    let w = farr_zeros(n_mod * n_mod)
    let mut s = 2246822519           // FIXED non-seed constant (learned-readout init; SAME every trial)
    let mut i = 0
    while i < n_mod {
        let mut rowsum = 0.0
        let mut j = 0
        while j < n_mod {
            s = lcg_next(s)
            let mut v = lcg_unit(s)        // [0,1) deterministic "learned" weight
            // a learned readout has a strong self/diagonal component + cross-module mixing
            if i == j { v = v + 0.6 }
            let _ = farr_set(w, i * n_mod + j, v)
            rowsum = rowsum + v
            j = j + 1
        }
        // L1-normalize the row (stable convex readout)
        if rowsum < 0.0000001 { rowsum = 0.0000001 }
        j = 0
        while j < n_mod { let _ = farr_set(w, i * n_mod + j, farr_get(w, i * n_mod + j) / rowsum)  j = j + 1 }
        i = i + 1
    }
    return w
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// SUBSTRATE trajectory.
// learned: 1 = LEARNED substrate (apply W mix to module salience) · 0 = OSCILLATOR (H_1349, no W) = R3 control.
// mode: 0=NO-COUP(A) 1=MECHANISM(B) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// Coupling held IDENTICAL to H_1349: H_1283 relay (w_nbr 0.5) + H_1319 Kuramoto pacemaker.
// ════════════════════════════════════════════════════════════════════════════════════════════
fn gen_traj(seed: int, mode: int, learned: int) -> int {
    let n_mod = 4
    let t_ticks = 64
    let w_nbr = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    // LEARNED-READOUT W (seed-INDEPENDENT) — only used when learned==1
    let lw = build_learned_W(n_mod)

    // per-module oscillator state — seed-perturbed INITIAL fast phase (the seed lever, SAME LCG as H_1349)
    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }
    let mut pf_p = []
    let mut pf_a = []
    let mut i = 0
    while i < n_mod {
        st = lcg_next(st)
        let p0 = lcg_unit(st) * two_pi
        pf_p = pf_p + [[p0, 0.0, 0.0]]
        pf_a = pf_a + [[0.1, 0.1, 0.1]]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod { theta = theta + [pf_p[i][0]]  i = i + 1 }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi

    // perm / offset (VERBATIM from H_1332/H_1349)
    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]  perm[k] = perm[jj]  perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix { let mut p2 = []  i = 0  while i < n_mod { p2 = p2 + [(i + 1) % n_mod]  i = i + 1 }  perm = p2 }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod { ss = lcg_next(ss)  shuf_off = shuf_off + [lcg_unit(ss) * two_pi]  i = i + 1 }
    }

    let traj = farr_zeros(n_mod * t_ticks)
    let mut tt = 0
    while tt < t_ticks {
        // 1. advance each module's 3 real oscillators (osc_tick) — REAL pure_field dynamics
        let mut np = []
        let mut na = []
        i = 0
        while i < n_mod {
            let of = osc_tick(pf_p[i][0], pf_a[i][0], 2)
            let om = osc_tick(pf_p[i][1], pf_a[i][1], 40)
            let os = osc_tick(pf_p[i][2], pf_a[i][2], 400)
            np = np + [[of[0], om[0], os[0]]]
            na = na + [[of[1], om[1], os[1]]]
            i = i + 1
        }
        pf_p = np
        pf_a = na

        // 2. phase pacemaker (H_1319 Kuramoto) over the module FAST phases — coupled arms only
        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                let omega_i = omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)
                newtheta = newtheta + [theta[i] + (omega_i + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        // 3. raw oscillator VALUES per module
        let mut vf = []
        let mut vm = []
        let mut vs = []
        i = 0
        while i < n_mod {
            vf = vf + [osc_value(pf_p[i][0], pf_a[i][0])]
            vm = vm + [osc_value(pf_p[i][1], pf_a[i][1])]
            vs = vs + [osc_value(pf_p[i][2], pf_a[i][2])]
            i = i + 1
        }

        // 4. re-entrant relay (H_1283): blend each module's osc values with ring-neighbour avg
        //    (coupled arms only). IDENTICAL to H_1349; ARM A keeps modules isolated.
        let mut cf = []
        let mut cm = []
        let mut cs = []
        i = 0
        while i < n_mod {
            if mode == 0 {
                cf = cf + [vf[i]]  cm = cm + [vm[i]]  cs = cs + [vs[i]]
            } else {
                let l = (i + n_mod - 1) % n_mod
                let r = (i + 1) % n_mod
                let nf = (vf[l] + vf[r]) / 2.0
                let nm = (vm[l] + vm[r]) / 2.0
                let ns = (vs[l] + vs[r]) / 2.0
                cf = cf + [(1.0 - w_nbr) * vf[i] + w_nbr * nf]
                cm = cm + [(1.0 - w_nbr) * vm[i] + w_nbr * nm]
                cs = cs + [(1.0 - w_nbr) * vs[i] + w_nbr * ns]
            }
            i = i + 1
        }

        // 5. per-module RAW Φ-energy salience (relay-coupled field) + pacemaker phase carrier (B/S/O)
        let mut rawsal = []
        i = 0
        while i < n_mod {
            let f = field_build(cf[i], cm[i], cs[i])
            let mut sal = field_raw_phi(f, cf[i], cm[i], cs[i])
            let _ = farr_free(f)
            if mode != 0 {
                let mut rel = 0.0
                if mode == 1 { rel = theta[i] - theta_t }
                if mode == 2 { rel = theta[perm[i]] - theta_t }
                if mode == 3 { rel = (theta[i] - theta_t) + shuf_off[tt * n_mod + i] }
                let carrier = 0.5 * (1.0 + cos(rel))
                sal = sal * carrier
            }
            rawsal = rawsal + [sal]
            i = i + 1
        }

        // 6. LEARNED READOUT: mix the per-module salience through the fixed seed-INDEPENDENT W.
        //    learned==1 -> salience_i = sum_j W[i][j] * rawsal[j]  (a trained readout head).
        //    learned==0 -> oscillator substrate (H_1349): salience_i = rawsal[i] (no mix). [R3 control]
        i = 0
        while i < n_mod {
            let mut sal = 0.0
            if learned == 1 {
                let mut j = 0
                while j < n_mod { sal = sal + farr_get(lw, i * n_mod + j) * rawsal[j]  j = j + 1 }
            } else {
                sal = rawsal[i]
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    let _ = farr_free(lw)
    return traj
}

fn phi_of(seed: int, mode: int, learned: int) -> float {
    let traj = gen_traj(seed, mode, learned)
    let mut c = 0
    while c < 4 { rank_uniformize_cell(traj, c * 64, 64)  c = c + 1 }
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn main() {
    println("H_1357 — LEARNED substrate (fixed seed-INDEPENDENT readout mix over real pure_field) vs the Φ-robustness wall")
    println("faithful IIT4 Φ (exact MIP-EI, n=4, a_phi_iit4_tool) · variance-clean rank-uniform read-out (H_1328)")
    println("SUBSTRATE = proxy-from-telemetry (real pure_field osc) + deterministic learned-readout W — NOT a trained-303M trajectory (HONEST, c9)")
    println("R3 control = OSCILLATOR arm (learned OFF) = H_1349 REAL arm reproduced in-run")
    println("seeds [1317,1318,1319] · eps=0.02 · ARMS A=NO-COUP B=MECHANISM S=PERM-SHUF O=OFFSET-SHUF")
    println("BARS: R1 LEARNED Φ_B>=Φ_A+eps all seeds · R2 LEARNED perm&off<=Φ_A+eps all seeds · R3 OSC arm perm-rides/seed-shrinks")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut r1_all = true
    let mut r2_perm_all = true
    let mut r2_off_all = true
    let mut r3_osc_signature = false
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        // LEARNED substrate (W ON)
        let la = phi_of(s, 0, 1)
        let lb = phi_of(s, 1, 1)
        let ls = phi_of(s, 2, 1)
        let lo = phi_of(s, 3, 1)
        // OSCILLATOR substrate (W OFF) — R3 control = H_1349 REAL arm
        let oa = phi_of(s, 0, 0)
        let ob = phi_of(s, 1, 0)
        let os_ = phi_of(s, 2, 0)

        let l_dphi  = lb - la
        let l_smarg = ls - la
        let l_omarg = lo - la
        let o_dphi  = ob - oa
        let o_smarg = os_ - oa

        let r1  = l_dphi  >= eps
        let r2p = l_smarg <= eps
        let r2o = l_omarg <= eps
        // R3: oscillator arm reproduces the H_1349 signature — perm RIDES (o_smarg > eps, i.e. perm
        //     does NOT collapse the lift) on this seed. (H_1349: perm S-A == B-A exactly, rides.)
        let osc_perm_rides = o_smarg > eps
        if !r1  { r1_all = false }
        if !r2p { r2_perm_all = false }
        if !r2o { r2_off_all = false }
        if osc_perm_rides { r3_osc_signature = true }

        println("seed " + to_string(s) + " LEARNED: A=" + la.to_string() + " B=" + lb.to_string()
            + " S=" + ls.to_string() + " O=" + lo.to_string()
            + " | ΔΦ(B-A)=" + l_dphi.to_string() + " [R1 " + (if r1 {"PASS"} else {"FAIL"}) + "]"
            + " S-A=" + l_smarg.to_string() + " [R2perm " + (if r2p {"PASS"} else {"FAIL"}) + "]"
            + " O-A=" + l_omarg.to_string() + " [R2off " + (if r2o {"PASS"} else {"FAIL"}) + "]")
        println("        OSC(R3): A=" + oa.to_string() + " B=" + ob.to_string() + " S=" + os_.to_string()
            + " | ΔΦ(B-A)=" + o_dphi.to_string() + " S-A=" + o_smarg.to_string()
            + " [perm-rides " + (if osc_perm_rides {"YES"} else {"NO"}) + "]")
        si = si + 1
    }
    let r2 = r2_perm_all && r2_off_all
    println("---")
    println("R1 ROBUST (LEARNED Φ_B>=Φ_A+eps ALL seeds incl 1318/1319): " + (if r1_all {"PASS"} else {"FAIL"}))
    println("R2 EARNED (LEARNED perm&offset both <=Φ_A+eps ALL seeds): " + (if r2 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if r2_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if r2_off_all {"PASS"} else {"FAIL"}) + "]")
    println("R3 ATTRIB (OSC arm reproduces H_1349 perm-ride signature on >=1 seed): "
        + (if r3_osc_signature {"PASS"} else {"FAIL"}))
    println("===")
    if r1_all && r2 && r3_osc_signature {
        println("VERDICT 🟢 — a LEARNED substrate ESCAPES the wall (robust + earned) where the oscillator")
        println("  did not. The seed-INDEPENDENT learned-readout geometry breaks the orthogonal-seed")
        println("  fragility AND module exchangeability. Engine-native follow-on: wire a learned-readout")
        println("  Φ path. (DIRECTIONAL-on-proxy; trained-303M transfer UNVERIFIED.)")
    } else {
        if !r1_all {
            println("VERDICT 🧱 (STRONGEST on the substrate axis) — even a LEARNED substrate INHERITS the")
            println("  orthogonal-seed fragility. The substrate axis is FULLY closed (oscillator AND learned).")
            println("  BOUNDS (does not retract) the prior Φ verdicts.")
        } else {
            println("VERDICT 🔶 — LEARNED R1 lift robust but NOT earned (perm/offset rides) → same")
            println("  collective/exchangeable shape as H_1349; learned readout did not break exchangeability.")
        }
    }
}
