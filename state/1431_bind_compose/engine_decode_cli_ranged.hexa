// engine_decode_cli_ranged.hexa — OOM-safe engine-native decode CLI for the H_1431 5-bar.
// Identical to engine_decode_cli.hexa but calls bytegpt_decode_topk_sampled_ranged
// (bg_load_ranged: peak ≈ one weight slice, no ~24GB whole-file boxing).
import "CORE/bytegpt_decode.hexa"
fn main() {
    let a = argv()
    let bin = a[1]
    let gen = to_int(a[2])
    let top_k = to_int(a[3])
    let temp = to_float(to_int(a[4])) / 1000.0
    let seed_rng = to_int(a[5])
    let mut seed = ""
    let mut i = 6
    while i < len(a) { if i > 6 { seed = seed + " " } seed = seed + a[i]; i = i + 1 }
    let sids = []
    let slen = byte_len(seed)
    let mut si = 0
    while si < slen { let c = ord(substring(seed, si, si + 1)); sids.push(c); si = si + 1 }
    let r = bytegpt_decode_topk_sampled_ranged(bin, sids, gen, top_k, temp, seed_rng)
    println("ENGINE_DECODE " + to_string(r["text"]))
}
