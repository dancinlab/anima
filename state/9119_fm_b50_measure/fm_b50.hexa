// ============================================================================
// state/9119_fm_b50_measure/fm_b50.hexa — §2 Stage-1c-wire: engine-native b50 measurement.
//   Does the forward-model rerank (gen_fm_rerank, Option C, H_9118) LOWER the frozen-listener
//   b50 vs the un-reranked argmax emit, at held accuracy? This is the GREEN test the whole §2
//   arc (H_9112-9117 + scorer #2881 + rerank #2889) builds toward.
//
//   b50(emit) = smallest prefix-byte length at which the FROZEN listener ranks the target
//   concept BELOW all distractors (target CE < min distractor CE) given that emit prefix =
//   "how few bytes let an external-ish mind re-identify the referent". Lower = more front-loaded.
//
//   arms: ON = gen_fm_rerank (rerank by fm_prefix_decodability) · OFF = clm_decode_argmax (single-pass).
//   controls: SHUFFLE (score emit against a WRONG target → b50 should blow up) proves the b50 is
//   referential; LISTENER-SWAP (2nd listener ckpt) is a caller arg (run twice) — private-code detector.
//
//   ENGINE-NATIVE (live core/ decode via generator.hexa; NO numpy/torch/py mirror). HEAVY
//   (K·grid·distractor CE calls per concept on d768) → POOL only (engine-cli-hexa-2 / heavy-on-pool).
//   args: speaker_ckpt listener_ckpt [gen] [base_seed]. Tier: engine-native GREEN for the
//   frozen-listener b50 analog + controls; external-mind b50 bridge stays DIRECTIONAL (H_9118 c9).
// ============================================================================
import "core/generator.hexa"
import "core/emit_policy.hexa"
import "core/decode.hexa"   // H_9119 gate① STEP2: clm_load_W + clm_ce_seq_W (GPU forge CE path)

fn s2bytes(s: string) -> list {
    let n = byte_len(s)
    let mut v = []
    let mut i = 0
    while i < n { v = v + [s.byte_at(i)]; i = i + 1 }
    return v
}

fn prefix_bytes(s: string, pb: int) -> list {
    let n = byte_len(s)
    let m = if pb < n { pb } else { n }
    let mut v = []
    let mut i = 0
    while i < m { v = v + [s.byte_at(i)]; i = i + 1 }
    return v
}

// frozen-listener b50: smallest prefix length where target wins (CE < min distractor CE).
// lisW = pre-loaded listener weight-set (clm_load_W, loaded ONCE in main). H_9119 gate①:
// STEP1 killed the ~1400×/run .clm reload; STEP2 routes each CE through clm_ce_seq_W (GPU
// forge _clmd_fwd_logits_sc) instead of scalar clm_decode_ce_dq (_gen_conv1d, GPU idle).
fn b50_of(lisW: Map, lisSc: Map, emit: string, target: string, distractors: list) -> float {
    let grid = [2, 4, 8, 16, 32, 64]
    let mut gi = 0
    while gi < len(grid) {
        let pfx = prefix_bytes(emit, grid[gi])
        let ce_t = clm_ce_seq_W(lisW, lisSc, pfx + s2bytes(" " + target))
        let mut best_d = 1000000.0
        let mut di = 0
        while di < len(distractors) {
            let ce_d = clm_ce_seq_W(lisW, lisSc, pfx + s2bytes(" " + to_string(distractors[di])))
            if ce_d < best_d { best_d = ce_d }
            di = di + 1
        }
        if ce_t < best_d { return to_float(grid[gi]) }
        gi = gi + 1
    }
    return 999.0
}

fn distractors_for(concepts: list, ti: int) -> list {
    // 3 deterministic distractors = the next 3 concepts cyclically
    let n = len(concepts)
    let mut d = []
    let mut j = 1
    while j <= 3 { d = d + [to_string(concepts[(ti + j) % n])]; j = j + 1 }
    return d
}

fn main() {
    // args() = [binary, "--", <positionals>...] (hexa run); collect positionals after "--",
    // else skip the binary (argv[0]). (hexa_args is a C symbol, not a hexa fn — use args().)
    let raw = args()
    let mut pos = []
    let mut started = false
    let mut ri = 0
    while ri < len(raw) {
        if started { pos = pos + [to_string(raw[ri])] }
        if to_string(raw[ri]) == "--" { started = true }
        ri = ri + 1
    }
    if len(pos) == 0 {
        let mut rj = 1
        while rj < len(raw) { pos = pos + [to_string(raw[rj])]; rj = rj + 1 }
    }
    if len(pos) < 2 {
        println("usage: fm_b50 <speaker_ckpt> <listener_ckpt> [gen] [base_seed]")
        return
    }
    let speaker  = to_string(pos[0])
    let listener = to_string(pos[1])
    let gen      = if len(pos) > 2 { to_int(pos[2]) } else { 80 }
    let base     = if len(pos) > 3 { to_int(pos[3]) } else { 12345 }
    let decay    = ep_fm_prefix_decay()
    let concepts = ["volcano", "glacier", "library", "violin", "spider", "lighthouse", "umbrella",
                    "beehive", "telescope", "avalanche", "compass", "cactus", "harbor", "thunderstorm"]
    let n = len(concepts)
    println("=== H_9119 §2 forward-model b50 measurement (engine-native, frozen-listener) ===")
    println("speaker=" + speaker + " listener=" + listener + " gen=" + to_string(gen) + " k=8")
    // H_9119 gate① STEP1+STEP2: load the frozen listener weight-set ONCE (kills the ~1400×/run
    // reload) and score every CE through the GPU forge path (clm_ce_seq_W), not scalar.
    let lisW = clm_load_W(listener)
    let lisSc = clm_scratch_new_pub(lisW, 128)   // gate①: scratch built ONCE (maxT=128 ≥ any b50 seq), reused
    let mut sum_on  = 0.0
    let mut sum_off = 0.0
    let mut sum_shuf = 0.0
    let mut ti = 0
    while ti < n {
        let target = to_string(concepts[ti])
        let distr  = distractors_for(concepts, ti)
        // OFF arm: single-pass argmax
        let roff = clm_decode_argmax(speaker, target, gen)
        let eoff = if to_string(roff["ok"]) == "true" { to_string(roff["text"]) } else { "" }
        // ON arm: forward-model rerank
        let ron  = gen_fm_rerank(speaker, listener, target, gen, 8, base + ti * 17, target, distr, decay)
        let eon  = to_string(ron["text"])
        let b_off = b50_of(lisW, lisSc, eoff, target, distr)
        let b_on  = b50_of(lisW, lisSc, eon, target, distr)
        // SHUFFLE control: score the ON emit against a WRONG target (next concept)
        let wrong = to_string(concepts[(ti + 1) % n])
        let b_shuf = b50_of(lisW, lisSc, eon, wrong, distractors_for(concepts, (ti + 1) % n))
        sum_off = sum_off + b_off
        sum_on  = sum_on + b_on
        sum_shuf = sum_shuf + b_shuf
        println(target + ": b50_off=" + to_string(b_off) + " b50_on=" + to_string(b_on)
                + " b50_shuffle=" + to_string(b_shuf) + " fm_score=" + to_string(ron["fm_score"]))
        ti = ti + 1
    }
    clm_scratch_free_pub(lisSc)  // gate①: free the load-once scratch
    clm_weights_free_pub(lisW)   // gate① STEP2: free the load-once listener weight-set
    let m_on  = sum_on / to_float(n)
    let m_off = sum_off / to_float(n)
    let m_shuf = sum_shuf / to_float(n)
    println("--- mean b50: OFF=" + to_string(m_off) + " ON=" + to_string(m_on) + " SHUFFLE=" + to_string(m_shuf) + " ---")
    println("VERDICT: " + (if m_on < m_off { "b50 LOWERED by rerank (ON<OFF)" } else { "no b50 drop (ON>=OFF)" })
            + " | shuffle control " + (if m_shuf > m_on { "OK (referential)" } else { "FAIL (b50 not referential)" }))
    println("NOTE: run twice with a 2nd listener ckpt for the listener-swap control; frozen-listener b50 analog = engine-native, external-mind b50 = DIRECTIONAL (H_9118 c9).")
}
