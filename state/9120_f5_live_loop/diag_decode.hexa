// diag_decode.hexa — decoder-path diagnostic. Compares gen_clm_ideate_W (loaded-W
// top_k=1) vs gen_clm_chat (argmax, the H_9111-rich path) on a KNOWN-rich F6 positive
// control (volcano) + two F5-fresh concepts (canyon, cello). Isolates decoder-path
// quality vs concept-knowledge wall.
import "core/generator.hexa"

fn seed_of(c: string) -> string { return "A " + c + " is something that" }

fn main() {
    let av = args()
    let mut ckpt = "/root/anima-weights/py303_savant_mitosis.clm"
    let mut k = 0
    while k < len(av) { if av[k] == "--" && k+1 < len(av) { ckpt = av[k+1] }  k = k + 1 }
    let W = clm_load_weights(ckpt)
    println("# diag mouth=" + gen_mouth_kind(ckpt))
    let cs = ["volcano", "canyon", "cello"]
    let mut i = 0
    while i < 3 {
        let c = cs[i]
        let s = seed_of(c)
        let a = gen_clm_ideate_W(W, s, 60, 1, 1.0, 4242 + i)
        println("IDEATE_W\t" + c + "\t" + to_string(a["text"]).replace("\n"," ").replace("\t"," "))
        let b = gen_clm_chat(ckpt, s, 60)
        println("CLM_CHAT\t" + c + "\t" + to_string(b["text"]).replace("\n"," ").replace("\t"," "))
        i = i + 1
    }
    println("# diag DONE")
}
