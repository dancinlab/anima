// ============================================================================
// state/9120_f5_live_loop/verdict_f5.hexa
//   F5 — REGIME-2 ENGINE-NATIVE VERDICT (frozen fixture, grep-clean).
//
//   Reads the FROZEN engine-native emit pool (emits_pool.tsv, loaded-W 303M .clm
//   decode from emit_gen_w.hexa) + the FROZEN external-oracle fixtures
//   (rank_canonical.tsv 16×16 referent rankings + reward_pool.tsv 80 legibility
//   rewards). Computes — ENTIRELY on live core/*.hexa (immune_memory clone decode +
//   brain.vbasal striatal value lane + engine_cli vadapt cell growth + pure_field Ψ) —
//   the TWO-LAYER frozen bar (PREREG.md). NO numpy/torch/.py math
//   (a_engine_native_learning). The ONLY external datum is the oracle's cached ranking
//   / reward (as an EEG fixture supplies an external signal).
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"

// ── numeric helpers (== 9110 consequence_loop.hexa) ─────────────────────────
fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

fn concept(i: int) -> string {
    let w = ["canyon","tundra","cathedral","cello","scorpion","windmill",
             "parasol","anthill","microscope","landslide","sundial","fern",
             "pier","blizzard","lodestone","mast"]
    return w[i]
}
fn seed_of(c: string) -> string { return "A " + c + " is something that" }

// distinct-byte ratio — coherence proxy (repetition, which kills legibility, LOWERS it).
fn distinct_byte_ratio(s: string) -> float {
    let n = byte_len(s)  if n == 0 { return 0.0 }
    let mut seen = []  let mut u = 0  let mut i = 0
    while i < 256 { seen = seen + [0]  i = i + 1 }
    i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        if seen[b] == 0 { seen[b] = 1  u = u + 1 }
        i = i + 1
    }
    return to_float(u) / to_float(n)
}
fn word_count(s: string) -> int {
    let n = byte_len(s)  let mut w = 0  let mut in_w = 0  let mut i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        if b == 32 { in_w = 0 } else { if in_w == 0 { w = w + 1  in_w = 1 } }
        i = i + 1
    }
    return w
}

const M: int = 16
const K: int = 5
const D: int = 5           // feature dim (distinct-byte, len, wordcount, self-salience, bias)

fn main() {
    let cfg = engine_config_default()
    let base = "state/9120_f5_live_loop/"

    // ── read emit pool: EMIT<tab>cidx<tab>concept<tab>cand<tab>ok<tab>E ──────
    // store E in a flat [M*K] list indexed cidx*K + cand.
    let mut Epool = []  let mut have = []
    let mut z = 0
    while z < M * K { Epool = Epool + [""]  have = have + [0]  z = z + 1 }
    let rawp = read_file(base + "emits_pool.tsv")
    let plines = rawp.split("\n")
    let mut pi = 0
    while pi < len(plines) {
        let ln = to_string(plines[pi])
        if byte_len(ln) > 5 && substring(ln, 0, 4) == "EMIT" {
            let cols = ln.split("\t")
            if len(cols) >= 6 {
                let ci = to_int(to_string(cols[1]))
                let ck = to_int(to_string(cols[3]))
                if ci >= 0 && ci < M && ck >= 0 && ck < K {
                    Epool[ci * K + ck] = to_string(cols[5])
                    have[ci * K + ck] = 1
                }
            }
        }
        pi = pi + 1
    }

    // ── read reward_pool: cidx<tab>cand<tab>reward (oracle legibility) ───────
    let mut reward = []
    let mut z2 = 0
    while z2 < M * K { reward = reward + [0.0]  z2 = z2 + 1 }
    let rawr = read_file(base + "reward_pool.tsv")
    let rlines = rawr.split("\n")
    let mut ri = 0
    while ri < len(rlines) {
        let ln = to_string(rlines[ri])
        if byte_len(ln) > 4 {
            let cols = ln.split("\t")
            if len(cols) >= 3 {
                let ci = to_int(to_string(cols[0]))
                let ck = to_int(to_string(cols[1]))
                if ci >= 0 && ci < M && ck >= 0 && ck < K {
                    reward[ci * K + ck] = clip01(to_float(to_string(cols[2])))
                }
            }
        }
        ri = ri + 1
    }

    // ── read rank_canonical: cidx r0 r1 ... r15 (oracle referent ranking) ────
    // rank[i*M + j] = rank (1..M) the oracle assigns concept j as referent of emit i.
    let mut rankm = []
    let mut z3 = 0
    while z3 < M * M { rankm = rankm + [0]  z3 = z3 + 1 }
    let rawk = read_file(base + "rank_canonical.tsv")
    let klines = rawk.split("\n")
    let mut ki = 0
    while ki < len(klines) {
        let ln = to_string(klines[ki])
        if byte_len(ln) > 4 {
            let cols = ln.split("\t")
            if len(cols) >= M + 1 {
                let ci = to_int(to_string(cols[0]))
                if ci >= 0 && ci < M {
                    let mut j = 0
                    while j < M { rankm[ci * M + j] = to_int(to_string(cols[j + 1]))  j = j + 1 }
                }
            }
        }
        ki = ki + 1
    }

    // ════════════════════════════════════════════════════════════════════════
    // LAYER-1 — exogeneity (MRR advantage over the self-pair clone decoder)
    // ════════════════════════════════════════════════════════════════════════
    // MRR_diffLLM (oracle real pairing) + MRR_shuffle (fixed derangement σ(i)=(i+1)%M)
    let mut mrr_diff = 0.0
    let mut mrr_shuf = 0.0
    let mut i1 = 0
    while i1 < M {
        let rt = rankm[i1 * M + i1]
        if rt >= 1 { mrr_diff = mrr_diff + 1.0 / to_float(rt) }
        let sj = (i1 + 1) % M
        let rs = rankm[i1 * M + sj]
        if rs >= 1 { mrr_shuf = mrr_shuf + 1.0 / to_float(rs) }
        i1 = i1 + 1
    }
    mrr_diff = mrr_diff / to_float(M)
    mrr_shuf = mrr_shuf / to_float(M)

    // MRR_selfpair — anima-CLONE decoder (live immune_memory, inside the alveolus).
    // Per concept j build a store anchored on its seed frame + name (the clone's own
    // world-knowledge). For each canonical emit E_i (cand0, concept STRIPPED), rank
    // concepts by recall margin (LOWER margin = nearer, per 9110); RR of the true i.
    let mut stores = []
    let mut sj0 = 0
    while sj0 < M {
        let cj = concept(sj0)
        let anchor = seed_of(cj) + " " + cj + " " + cj
        stores = stores + [immune_memory_new_text(anchor, cj, 2048)]
        sj0 = sj0 + 1
    }
    let mut mrr_self = 0.0
    let mut i2 = 0
    while i2 < M {
        let Ei = Epool[i2 * K + 0]                 // canonical (cand0)
        // margin of E_i to each concept store
        let mut margins = []
        let mut jj = 0
        while jj < M { margins = margins + [immune_memory_recall_margin_text(stores[jj], Ei)]  jj = jj + 1 }
        // rank of the true concept i2 = 1 + (# concepts with STRICTLY lower margin)
        let mtrue = margins[i2]
        let mut rank_true = 1
        let mut jc = 0
        while jc < M {
            if jc != i2 && margins[jc] < mtrue { rank_true = rank_true + 1 }
            jc = jc + 1
        }
        mrr_self = mrr_self + 1.0 / to_float(rank_true)
        i2 = i2 + 1
    }
    mrr_self = mrr_self / to_float(M)

    let D_diffLLM = mrr_diff - mrr_self
    let D_shuffle = mrr_shuf - mrr_self

    // ── Ψ safety: pure_field relaxation byte-identical ON vs OFF (V/field read-only) ──
    let mut psi_on = 0.0  let mut psi_off = 0.0
    let mut pf = pure_field_warmup(600)
    let mut ps = 0
    while ps < 240 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psi_on = psi_on + phi
        psi_off = psi_off + phi
        ps = ps + 1
    }
    let psi_ok = psi_on == psi_off

    // ════════════════════════════════════════════════════════════════════════
    // FEATURES per candidate (D=5, label-free, engine-native)
    // ════════════════════════════════════════════════════════════════════════
    let mut feat = []
    let mut z4 = 0
    while z4 < M * K * D { feat = feat + [0.0]  z4 = z4 + 1 }
    let mut ci = 0
    while ci < M {
        // clone store for this concept — the engine self-salience read
        let cj = concept(ci)
        let selfstore = immune_memory_new_text(seed_of(cj) + " " + cj, cj, 2048)
        let mut ck = 0
        while ck < K {
            let E = Epool[ci * K + ck]
            let f0 = distinct_byte_ratio(E)
            let f1 = clip01(to_float(byte_len(E)) / 120.0)
            let f2 = clip01(to_float(word_count(E)) / 12.0)
            let f3 = clip01(immune_memory_recall_margin_text(selfstore, E))
            let bidx = (ci * K + ck) * D
            feat[bidx + 0] = f0
            feat[bidx + 1] = f1
            feat[bidx + 2] = f2
            feat[bidx + 3] = f3
            feat[bidx + 4] = 1.0
            ck = ck + 1
        }
        ci = ci + 1
    }

    // ════════════════════════════════════════════════════════════════════════
    // LAYER-2 — faculty replay (ON / OFF / SHUFFLE), live vbasal + vadapt
    // ════════════════════════════════════════════════════════════════════════
    let R = 10                       // rounds; T = R*M ticks
    let GROW_THR = 0.5

    // shuffled reward map (global permutation of the M*K rewards) for the SHUFFLE arm
    let mut rew_shuf = []
    let mut cpi = 0
    while cpi < M * K { rew_shuf = rew_shuf + [reward[cpi]]  cpi = cpi + 1 }
    let mut rs2 = 20260704
    let mut ii = M * K - 1
    while ii > 0 {
        rs2 = lcg_next(rs2)
        let j = rs2 % (ii + 1)
        let tmp = rew_shuf[ii]  rew_shuf[ii] = rew_shuf[j]  rew_shuf[j] = tmp
        ii = ii - 1
    }

    // seed vectors (DIM=D) for the two adaptation fields
    let mut seed0 = []
    let mut sd = 0
    while sd < D { seed0 = seed0 + [0.5]  sd = sd + 1 }

    let mut V_on = vbasal_new(D, 0.10)
    let mut field_on = vadapt_field_new(seed0, 64)
    let mut V_sh = vbasal_new(D, 0.10)
    let mut field_sh = vadapt_field_new(seed0, 64)
    // OFF: frozen untrained gate (never updated) + never-grown field.

    let mut eff_on = []
    let mut eff_off = []
    let mut eff_sh = []

    let mut rnd = 0
    while rnd < R {
        let mut c = 0
        while c < M {
            // build the K-candidate flat feature buffer for this concept
            let mut cands = []
            let mut kk = 0
            while kk < K {
                let bidx = (c * K + kk) * D
                let mut d = 0
                while d < D { cands = cands + [feat[bidx + d]]  d = d + 1 }
                kk = kk + 1
            }
            // ---- ON arm: learned selection ----
            let mut j_on = vbasal_select(V_on, cands, K)
            if j_on < 0 { j_on = 0 }
            let r_on = reward[c * K + j_on]
            eff_on = eff_on + [r_on]
            // feature vector of the chosen candidate
            let mut fj = []
            let bo = (c * K + j_on) * D
            let mut do1 = 0
            while do1 < D { fj = fj + [feat[bo + do1]]  do1 = do1 + 1 }
            V_on = vbasal_update(V_on, j_on, fj, r_on)
            if r_on >= GROW_THR { field_on = vadapt_field_step(field_on, fj, cfg) }

            // ---- OFF arm: frozen untrained gate → default cand0, no update/growth ----
            eff_off = eff_off + [reward[c * K + 0]]

            // ---- SHUFFLE arm: learned selection on permuted rewards ----
            let mut j_sh = vbasal_select(V_sh, cands, K)
            if j_sh < 0 { j_sh = 0 }
            let r_sh = rew_shuf[c * K + j_sh]
            eff_sh = eff_sh + [r_sh]
            let mut fs = []
            let bs = (c * K + j_sh) * D
            let mut ds = 0
            while ds < D { fs = fs + [feat[bs + ds]]  ds = ds + 1 }
            V_sh = vbasal_update(V_sh, j_sh, fs, r_sh)
            if r_sh >= GROW_THR { field_sh = vadapt_field_step(field_sh, fs, cfg) }

            c = c + 1
        }
        rnd = rnd + 1
    }

    // ΔEfficacy = late-half mean − early-half mean
    let T = len(eff_on)
    let half = T / 2
    let mut early_on = []  let mut late_on = []
    let mut early_off = []  let mut late_off = []
    let mut early_sh = []  let mut late_sh = []
    let mut ti = 0
    while ti < T {
        if ti < half {
            early_on = early_on + [eff_on[ti]]
            early_off = early_off + [eff_off[ti]]
            early_sh = early_sh + [eff_sh[ti]]
        } else {
            late_on = late_on + [eff_on[ti]]
            late_off = late_off + [eff_off[ti]]
            late_sh = late_sh + [eff_sh[ti]]
        }
        ti = ti + 1
    }
    let dEff_on = fmean(late_on) - fmean(early_on)
    let dEff_off = fmean(late_off) - fmean(early_off)
    let dEff_sh = fmean(late_sh) - fmean(early_sh)

    // substrate divergence (⑤)
    let cells_on = vadapt_field_cells(field_on)
    let cells_off = 1                       // OFF field never grown
    let mut vnorm_on = 0.0
    let mut vn = 0
    while vn < D { vnorm_on = vnorm_on + V_on.go_w[vn] * V_on.go_w[vn]  vn = vn + 1 }
    vnorm_on = sqrt(vnorm_on)

    // ── bars ──
    let bar1 = D_diffLLM >= 0.15
    let bar2 = D_shuffle < 0.05
    let bar3 = psi_ok
    let bar4 = (dEff_on - dEff_off) >= 0.10
    let bar5 = cells_on > cells_off && vnorm_on > 0.0
    let bar6 = fabs(dEff_sh) < 0.03

    print("================= F5 live diff-LLM consequence loop — VERDICT =================")
    print("emit pool: 16 F5-fresh concepts x K=5 (loaded-W 303M .clm) | receiver = opus subagent (ext oracle)")
    print("engine-native: immune_memory clone-decode + brain.vbasal + engine_cli vadapt + pure_field Ψ")
    print("---------------- LAYER-1 exogeneity (MRR advantage-over-selfpair) -------------")
    print("MRR_diffLLM  (oracle real pairing)   = " + to_string(mrr_diff))
    print("MRR_shuffle  (deranged target)       = " + to_string(mrr_shuf))
    print("MRR_selfpair (clone immune decoder)  = " + to_string(mrr_self))
    print("D_diffLLM = MRR_diffLLM - MRR_selfpair = " + to_string(D_diffLLM) + "   (bar >= 0.15) -> " + to_string(bar1))
    print("D_shuffle = MRR_shuffle - MRR_selfpair = " + to_string(D_shuffle) + "   (bar <  0.05) -> " + to_string(bar2))
    print("Ψ psi_sum ON=" + to_string(psi_on) + " OFF=" + to_string(psi_off) + " byte-identical -> " + to_string(bar3))
    print("---------------- LAYER-2 faculty (does feedback change substrate) -------------")
    print("T=" + to_string(T) + " ticks (R=" + to_string(R) + " x M=" + to_string(M) + ")  GROW_THR=" + to_string(GROW_THR))
    print("ΔEfficacy ON      = " + to_string(dEff_on))
    print("ΔEfficacy OFF     = " + to_string(dEff_off))
    print("ΔEfficacy SHUFFLE = " + to_string(dEff_sh))
    print("④ ΔEff_ON - ΔEff_OFF = " + to_string(dEff_on - dEff_off) + "   (bar >= 0.10) -> " + to_string(bar4))
    print("⑤ substrate divergence: cells_ON=" + to_string(cells_on) + " cells_OFF=" + to_string(cells_off) + " V-norm_ON=" + to_string(vnorm_on) + " -> " + to_string(bar5))
    print("⑥ |ΔEff_SHUFFLE| = " + to_string(fabs(dEff_sh)) + "   (bar <  0.03) -> " + to_string(bar6))
    print("mean reward: ON early=" + to_string(fmean(early_on)) + " late=" + to_string(fmean(late_on)) + " | OFF=" + to_string(fmean(late_off)))
    print("================================ VERDICT =====================================")
    let layer1_ok = bar1 && bar2 && bar3
    if !layer1_ok {
        print("VERDICT: 🟠 MEASUREMENT-REDESIGN — layer-1 exogeneity not established (bar1=" + to_string(bar1) + " bar2=" + to_string(bar2) + " bar3=" + to_string(bar3) + ")")
        print("  layer-2 faculty is MOOT until the oracle actually out-decodes the alveolus clone.")
    } else {
        if bar4 && bar5 && bar6 {
            print("VERDICT: 🟢 FACULTY (DIRECTIONAL-on-external-oracle) — exogenous consequence CHANGES the substrate")
            print("  Feedback opens emit-SELECTION (NOT generation; G1 terminal upper bound honoured).")
        } else {
            print("VERDICT: 🔴 LIVE-BUT-GAUGE (DIRECTIONAL-on-external-oracle) — consequence layer is read-only")
            print("  ④=" + to_string(bar4) + " ⑤=" + to_string(bar5) + " ⑥=" + to_string(bar6) + "  DPI consequence-layer re-emerges; selection headroom under a frozen mouth too low.")
        }
    }
    print("(first engine-native consequence→cell-division discrimination — valid both directions, c9)")
    print("==============================================================================")
}
