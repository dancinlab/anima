// ============================================================================
// state/9120_f5_live_loop/emit_gen_w.hexa
//   F5 — REGIME-1 engine-native EMIT-POOL generator (LOADED-W, load-once).
//
//   The H_9111 emit_gen.hexa used gen_auto_chat (per-call clm reload → the 4-pod
//   burn precedent h9107/b50). This is the F5 loaded-W conversion mandated by
//   F5_DESIGN.md: clm_load_weights(ckpt) ONCE → gen_clm_ideate_W(W, ...) in a loop
//   (ZERO per-decode reload — a_core_engine_map single .clm slot, H_1400 loaded-W).
//
//   For each of 16 F5-FRESH held-out concepts (F6-disjoint), emit K candidate
//   definitions: cand 0 = greedy-ish (top_k=1), cand 1..K-1 = seeded top-k samples
//   (distinct seed_rng → DIVERSE candidate pool for the layer-2 SELECTION loop).
//   The concept token is STRIPPED (case-insensitive anti-echo) so a receiver must
//   COMPREHEND, not string-match (Lewis referential game).
//
//   Output = deterministic TSV on stdout (redirect → emits_pool.tsv):
//     EMIT <tab> cidx <tab> concept <tab> cand_k <tab> ok <tab> E_stripped
// ============================================================================

import "core/generator.hexa"

// 16 F5-fresh concepts — DISJOINT from F6 (volcano/glacier/library/violin/spider/
// lighthouse/umbrella/beehive/telescope/avalanche/compass/cactus/harbor/thunderstorm/
// magnet/anchor). No lexical overlap → genuine held-out referential set.
fn concept(i: int) -> string {
    let w = ["canyon","tundra","cathedral","cello","scorpion","windmill",
             "parasol","anthill","microscope","landslide","sundial","fern",
             "pier","blizzard","lodestone","mast"]
    return w[i]
}

// neutral descriptive frame (== H_9111 anti-echo channel rule); the concept token
// that leaks into the continuation is stripped post-hoc.
fn seed_of(c: string) -> string { return "A " + c + " is something that" }

// strip every occurrence of the concept token from E (case-insensitive anti-echo)
// + collapse whitespace so the TSV stays one line per emit.
fn strip_echo(e: string, c: string) -> string {
    let mut s = e.to_lower().replace(c.to_lower(), " ")
    s = s.replace("\n", " ")
    s = s.replace("\t", " ")
    s = s.replace("\r", " ")
    return s
}

fn main() {
    let av = args()
    let mut ckpt = "/root/anima-weights/py303_savant_mitosis.clm"
    let mut k = 0
    while k < len(av) {
        if av[k] == "--" && k + 1 < len(av) { ckpt = av[k + 1] }
        k = k + 1
    }
    let M = 16
    let K = 5            // candidates per concept (1 greedy + 4 sampled)
    let max_new = 48
    let base_rng = 1729

    println("# F5 emit_gen_w  ckpt=" + ckpt + "  M=" + to_string(M) + "  K=" + to_string(K) +
            "  max_new=" + to_string(max_new) + "  mouth=" + gen_mouth_kind(ckpt) + "  loaded-W")

    // ── LOAD-ONCE: the 303M ConvMoE weights enter ONE named Map (H_1400). Every
    //    candidate decode reads THIS map — no per-call file reload (pod-burn guard).
    let W = clm_load_weights(ckpt)
    println("# clm_load_weights DONE (loaded-W handle live)")

    let mut i = 0
    while i < M {
        let c = concept(i)
        let seed = seed_of(c)
        let mut kk = 0
        while kk < K {
            let mut topk = 40
            let mut temp = 0.9
            if kk == 0 { topk = 1  temp = 1.0 }         // cand 0 = greedy-ish canonical
            let sr = base_rng + i * 131 + kk * 977       // distinct per (concept,cand)
            let r = gen_clm_ideate_W(W, seed, max_new, topk, temp, sr)
            let ok = to_string(r["ok"])
            let e = strip_echo(to_string(r["text"]), c)
            println("EMIT\t" + to_string(i) + "\t" + c + "\t" + to_string(kk) + "\t" + ok + "\t" + e)
            kk = kk + 1
        }
        i = i + 1
    }
    println("# F5 emit_gen_w DONE")
}
