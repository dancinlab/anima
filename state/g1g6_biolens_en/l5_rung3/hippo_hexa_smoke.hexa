// H_9129 rung-3 — hexa byte-parity smoke for the LIVE core/kosmos_io.hexa hippo lane.
// Mirrors core/hippo_lane.py::_fixture_report on a deterministic fixture (no 303M/FFI).
// Proves the CA3 pattern-completion op is LIVE (builds+runs on mini) and byte-parity
// with the numpy twin. Run: hexa run state/g1g6_biolens_en/l5_rung3/hippo_hexa_smoke.hexa
import "core/kosmos_io.hexa"

fn main() {
    let N = 8
    let DIM = 64
    let ACTIVE = 4
    let STEPS = 8
    let KWTA = 4
    let codes = hippo_fixture_codes(N, DIM, ACTIVE, 20260705)

    // chain 0→1→...→7 (adjacent premise edges)
    let mut edges = []
    let mut p = 0
    while p < N - 1 { edges.push([p, p + 1]); p = p + 1 }
    let W = hippo_build_store(codes, edges, DIM)

    let r1 = hippo_relatedness(W, codes, 0, 1, DIM, STEPS, KWTA)
    let r2 = hippo_relatedness(W, codes, 0, 2, DIM, STEPS, KWTA)
    let r3 = hippo_relatedness(W, codes, 0, 3, DIM, STEPS, KWTA)
    let r7 = hippo_relatedness(W, codes, 0, 7, DIM, STEPS, KWTA)
    print("hx recall_1hop(0,1)=" + format_float(r1, 6))
    print("hx novel_2hop(0,2)=" + format_float(r2, 6))
    print("hx novel_3hop(0,3)=" + format_float(r3, 6))
    print("hx novel_7hop(0,7)=" + format_float(r7, 6))

    // lesion: remove edge 3→4 ; pair (0,5) path crosses it → must collapse
    let mut ledges = []
    let mut q = 0
    while q < N - 1 { if q != 3 { ledges.push([q, q + 1]) }; q = q + 1 }
    let Wl = hippo_build_store(codes, ledges, DIM)
    let lb = hippo_relatedness(Wl, codes, 0, 5, DIM, STEPS, KWTA)
    let li = hippo_relatedness(Wl, codes, 0, 2, DIM, STEPS, KWTA)
    print("hx lesion_broken(0,5)=" + format_float(lb, 6))
    print("hx lesion_intact(0,2)=" + format_float(li, 6))
}
