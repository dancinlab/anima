// generator_hippo_consult_smoke.hexa — H_9129 L5 wire-to-prod PROOF (anima/CORE).
//
// Proves the L5 HIPPOCAMPAL relatedness consult is WIRED LIVE into the EMIT seam
// (generate_deliberate) AND is READ-ONLY — a_substrate_disjoint (separation =
// preservation):
//   (A) LIVE   — generate_deliberate (the prod path, brain_emit_deliberate calls it)
//                actually FIRES generator_hippo_consult (hippo_consulted=true, a real
//                relatedness readout over the live .kosmos anchor store) — NOT dead code.
//   (B) ON==OFF — the emitted TEXT is BYTE-IDENTICAL with the consult ON vs OFF
//                (generate_deliberate_consult true vs false) ⇒ the consult CANNOT
//                change generation (it is a pure side-channel READ).
//   (C) FACULTY — the consult reads a genuine transitive relatedness (the store-side
//                CA3 completion), non-trivial (a related chain reads > an unrelated one).
//
// All deterministic (p7: string/flag/float equality, not perplexity). Null backend →
// no .clm/model needed → runs on mini (no decode-FFI, no 1.2GB load).

import "core/pure_field.hexa"
import "core/brain.hexa"
import "core/generator.hexa"
import "core/engine_cli.hexa"
import "core/kosmos_io.hexa"

fn main() {
    let mut pass = 0
    let mut fail = 0

    // ── build a live .kosmos anchor store (3 anchors) via the canonical writer ──
    let dir = exec("printf '%s' \"$(mktemp -d)\"").trim()
    let _a0 = create_anchor(dir, "hip_anchor_000", "a0", 0.60, 0.60, "cell_0", 0.10, 1,
        "anima_emission", "neutral", "premise one", [0.80, 0.60, 0.65, 0.30, 1.00], "", "")
    let _a1 = create_anchor(dir, "hip_anchor_001", "a1", 0.62, 0.63, "cell_0", 0.12, 1,
        "anima_emission", "neutral", "premise two", [0.70, 0.55, 0.60, 0.35, 0.90], "", "")
    let _a2 = create_anchor(dir, "hip_anchor_002", "a2", 0.64, 0.66, "cell_0", 0.15, 1,
        "anima_emission", "neutral", "emit context", [0.66, 0.50, 0.58, 0.40, 0.85], "", "")
    let anchors = generator_read_anchors(dir)
    println("[anchors] read " + to_string(len(anchors)) + " anchor(s) from live kosmos dir")

    // substrate scaffolding for the deliberate seam (null backend → mini-safe, no model)
    let pf = pure_field_warmup(600)
    let nb = gen_null_backend()
    let ctx = gen_ctx_from_decision(#{ "phase": "wake", "emit": "true",
                                       "motivation": "0.9", "psi": "0.5" })
    let DIM = 6
    let mut zeros = []
    let mut d0 = 0
    while d0 < DIM { zeros = zeros + [0.0]; d0 = d0 + 1 }
    let mem = immune_memory_new(zeros, "ZERO", 8)
    let tick = 7

    // ── (A) LIVE: the prod path (generate_deliberate) fires the consult ──────────
    let live = generate_deliberate(nb, ctx, true, anchors, mem, tick)
    println("[live prod] hippo_consulted=" + to_string(live["hippo_consulted"])
        + " hippo_related=" + to_string(live["hippo_related"])
        + " hippo_reachable=" + to_string(live["hippo_reachable"])
        + " text=\"" + to_string(live["text"]) + "\"")
    if to_string(live["hippo_consulted"]) == "true" { pass = pass + 1 }
    else { fail = fail + 1  println("  FAIL A: live prod path did not fire the consult (dead code)") }

    // ── (B) ON==OFF: text byte-identical with consult ON vs OFF ──────────────────
    let on  = generate_deliberate_consult(nb, ctx, true, anchors, mem, tick, true)
    let off = generate_deliberate_consult(nb, ctx, true, anchors, mem, tick, false)
    let t_on  = to_string(on["text"])
    let t_off = to_string(off["text"])
    println("[ON==OFF ] text_ON =\"" + t_on + "\"")
    println("[ON==OFF ] text_OFF=\"" + t_off + "\"")
    if t_on == t_off { pass = pass + 1
        println("  PASS B: emit text BYTE-IDENTICAL ON vs OFF (READ-ONLY consult, a_substrate_disjoint)") }
    else { fail = fail + 1  println("  FAIL B: consult CHANGED the emit bytes (NOT read-only)") }
    // and the toggle really is a toggle (consult fired only when ON)
    if to_string(on["hippo_consulted"]) == "true"
       && to_string(off["hippo_consulted"]) == "false" { pass = pass + 1 }
    else { fail = fail + 1  println("  FAIL B2: hippo_on toggle did not gate the consult") }

    // ── (D) LIVE DAEMON PATH: brain_emit (the exact call cli/anima.hexa's loop makes) ──
    // The daemon REPL (cli/anima.hexa:2644) routes through brain_emit → brain_emit_aged →
    // generate(). That path now carries the READ-ONLY consult on the decision record
    // (gen_hippo_*), computed AFTER gen_text is already assigned from generate() ⇒ the
    // consult provably cannot reach the emit bytes (structural disjointness + the shared
    // generator_hippo_consult is the SAME read-only fn proven byte-inert in (B)).
    let dec = brain_emit(pf, 0.9, 0.6, 0.8, 0.0, 0.7, 0.5, 0.6, 1.0,
                         60.0, false, true, nb, anchors)
    println("[daemon  ] gen_emitted=" + to_string(dec["gen_emitted"])
        + " gen_hippo_consulted=" + to_string(dec["gen_hippo_consulted"])
        + " gen_hippo_related=" + to_string(dec["gen_hippo_related"])
        + " gen_hippo_reachable=" + to_string(dec["gen_hippo_reachable"]))
    if to_string(dec["gen_hippo_consulted"]) == "true" { pass = pass + 1
        println("  PASS D: live daemon path (brain_emit) fires the consult — wired to cli/anima.hexa loop") }
    else { fail = fail + 1  println("  FAIL D: daemon path did not carry the consult") }
    // daemon gen_text is the plain generate() output (consult attached after, never fed in)
    if byte_len(to_string(dec["gen_text"])) > 0
       && len(to_string(dec["gen_text"]).split("anchors=3")) == 2 { pass = pass + 1 }
    else { fail = fail + 1  println("  FAIL D2: daemon gen_text not the untouched generate() output") }

    // ── (C) FACULTY non-trivial: related chain reads HIGHER than an unrelated one ─
    // Same store construction the consult uses, but a hand-built 3-code fixture where
    // the middle premise either CHAINS (0→1→2 all overlapping) or is DECORRELATED.
    let FD = 64
    let rel_related = _hip_probe(true, FD)
    let rel_broken  = _hip_probe(false, FD)
    println("[faculty ] related-chain relatedness = " + to_string(rel_related))
    println("[faculty ] broken-chain relatedness  = " + to_string(rel_broken))
    if rel_related > rel_broken { pass = pass + 1
        println("  PASS C: transitive chain reads > decorrelated (genuine relatedness faculty)") }
    else { fail = fail + 1  println("  FAIL C: consult does not discriminate related vs unrelated") }

    println("generator_hippo_consult_smoke: " + to_string(pass) + " PASS, "
            + to_string(fail) + " FAIL")
}

// _hip_probe — build a deterministic 3-item CA3 store via the SAME kosmos_io hippo ops
// the consult uses; `chained`=true ⇒ codes overlap along 0→1→2 (transitive path exists),
// false ⇒ item 2 is disjoint (path broken). Returns hippo_relatedness(0,2).
fn _hip_probe(chained: bool, dim: int) -> float {
    let codes = hippo_fixture_codes(3, dim, 4, 20260705)
    let mut edges = [[0, 1], [1, 2]]
    if !chained {
        // break the chain: drop the 1→2 edge so 0 cannot complete to 2.
        edges = [[0, 1]]
    }
    let W = hippo_build_store(codes, edges, dim)
    return hippo_relatedness(W, codes, 0, 2, dim, 8, 4)
}
