// H_9129 integrated rung-3 — hexa byte-parity smoke for the LIVE core/kosmos_io.hexa
// L1 WM-bind + L2 content-gate twins. Mirrors core/wm_bind_lane._fixture_report and
// content_gate_lane._fixture_report on deterministic fixtures (no 303M/FFI). Proves the
// bind/unbind/cleanup + Go/NoGo ops are LIVE (build+run on mini) and byte-parity with
// the numpy twins. Run: hexa run state/g1g6_biolens_en/integrated_rung3/integrated_hexa_smoke.hexa
import "core/kosmos_io.hexa"

fn main() {
    // ── L1 WM-bind: 4 roles ⊛ 4 fillers ──
    let N = 4
    let DIM = 64
    let SEED = 20260705
    let roles = wmbind_fixture_vecs(N, DIM, SEED)
    let fillers = wmbind_fixture_vecs(N, DIM, SEED + 777)
    let mut gold = []
    let mut g = 0
    while g < N { gold.push(g); g = g + 1 }
    let fid = wmbind_recon_fidelity(roles, fillers, fillers, gold, DIM)
    print("hx recon_fidelity=" + format_float(fid, 6))

    let M = wmbind_superpose(roles, fillers, DIM)
    let r0 = _wmb_unit(roles[0])
    let fhat0 = wmbind_unbind(r0, M, DIM)
    let idx0 = wmbind_cleanup_idx(fhat0, fillers)
    print("hx unbind0_idx=" + to_string(idx0))
    // cosine of cleanup winner (recompute sim of fhat0 unit vs fillers[idx0] unit)
    let fu = _wmb_unit(fhat0)
    let win = fillers[idx0]
    let wn = _hippo_norm(win) + 1.0e-9
    let mut sim0 = 0.0
    let mut i = 0
    while i < DIM { sim0 = sim0 + (win[i] / wn) * fu[i]; i = i + 1 }
    print("hx unbind0_sim=" + format_float(sim0, 6))

    let r1 = _wmb_unit(roles[1])
    let fhat_sh = wmbind_unbind(r1, M, DIM)
    let idx_sh = wmbind_cleanup_idx(fhat_sh, fillers)
    print("hx shuffle0_idx=" + to_string(idx_sh))

    // ── L2 content-gate: 3 genuine + 2 distractors, nogo=0.3 e_scale=6 ──
    let mut cands = []
    cands.push([0.0, 1.0, 4.0])
    cands.push([1.0, 2.0, 7.0])
    cands.push([2.0, 3.0, 3.0])
    cands.push([4.0, 5.0, 0.0])
    cands.push([5.0, 6.0, 1.0])
    let na = cgate_admit_count(cands, 0.3, 6.0)
    print("hx n_admitted=" + to_string(na))
}
