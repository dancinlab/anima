// H_9077 event_segment_bind ENGINE-NATIVE — prediction-error event segmentation on live core/.
// Stream = E events of VARIABLE length. Surprise SPIKES at each event onset (§PrecisionSurprise
// lane). event_segment_boundaries peak-detects onsets → bind ONE episodic cell per SEGMENT
// (key = onset item, value = the segment's end payload). Boundary-BLIND uniform fixed-length
// chunking (event_segment_starts_fixed) mis-cuts variable events. Recall probe: onset_e -> ans_e.
// usage: hexa run state/9077_event_segment_bind/event_segment_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// bind ONE cell per segment (key = stream[start], value = stream[end-1] = the segment's end
// payload) then score onset_e -> ans_e recall. Segmentation quality drives the onset↔payload pairing.
fn _bind_and_score(stream: [string], bounds: [int], E: int) -> int {
    let cfg = engine_config_default()
    let n = len(stream)
    let nb = len(bounds)
    let s0 = bounds[0]
    let mut e0 = n
    if nb > 1 { e0 = bounds[1] }
    let mut mem = immune_memory_new_text(stream[s0], stream[e0 - 1], 128)
    let mut k = 1
    while k < nb {
        let st = bounds[k]
        let mut en = n
        if k + 1 < nb { en = bounds[k + 1] }
        mem = immune_memory_bind_text(mem, stream[st], stream[en - 1], cfg)
        k = k + 1
    }
    let mut hit = 0
    let mut e = 0
    while e < E {
        let q = "onset" + to_string(e)
        let want = "ans" + to_string(e)
        let got = immune_memory_recall_text(mem, q)
        if got == want { hit = hit + 1 }
        e = e + 1
    }
    return hit
}

fn main() {
    let E = 5
    let lengths = [3, 5, 2, 4, 3]        // VARIABLE event lengths (total n = 17, prime)
    // build the stream + the §PrecisionSurprise sequence (SPIKE at each event onset)
    let mut stream = []
    let mut surp = []
    let mut e = 0
    while e < E {
        let L = lengths[e]
        let mut k = 0
        while k < L {
            if k == 0 {
                stream = stream + ["onset" + to_string(e)]
                surp = surp + [1.0]                       // onset = prediction-error PEAK
            } else if k == L - 1 {
                stream = stream + ["ans" + to_string(e)]  // event payload arrives at segment END
                surp = surp + [0.1]
            } else {
                stream = stream + ["mid" + to_string(e) + "_" + to_string(k)]
                surp = surp + [0.1]
            }
            k = k + 1
        }
        e = e + 1
    }
    let n = len(stream)

    // SEGMENTED: peak-detect boundaries → one cell per true event
    let bounds = event_segment_boundaries(surp, 0.5)
    let seg = _bind_and_score(stream, bounds, E)

    // FIXED-CHUNK control (= ablation, boundary detect OFF): uniform chunk = round(mean length) = 3
    let fixed_starts = event_segment_starts_fixed(n, 3)
    let fixed = _bind_and_score(stream, fixed_starts, E)
    let abl = fixed

    // SHUFFLE: permute the surprise positions (stride bijection 5·i mod 17, gcd=1) so the SAME
    // number of spikes land at WRONG positions → detected boundaries mis-align with true onsets.
    let mut surp_shuf = []
    let mut i = 0
    while i < n {
        surp_shuf = surp_shuf + [surp[(i * 5) % n]]
        i = i + 1
    }
    let bounds_shuf = event_segment_boundaries(surp_shuf, 0.5)
    let shuf = _bind_and_score(stream, bounds_shuf, E)

    let sf = to_float(seg) / to_float(E)
    let ff = to_float(fixed) / to_float(E)
    let hf = to_float(shuf) / to_float(E)
    let margin = sf - ff
    let earned = sf - hf

    let mut np = 0
    if _ab("segmented recall high (>=0.8)", sf >= 0.8) { np = np + 1 }
    if _ab("fixed-chunk control low (<=0.4)", ff <= 0.4) { np = np + 1 }
    if _ab("MARGIN seg-fixed >= +0.5", margin >= 0.5) { np = np + 1 }
    if _ab("EARNED seg-shuffle >= +0.5 (boundary POSITIONS load-bearing)", earned >= 0.5) { np = np + 1 }
    if _ab("ablate(boundary OFF = fixed chunk): abl==fixed AND seg>abl (INERT baseline)", abl == fixed && seg > abl) { np = np + 1 }

    println("INFO n=" + to_string(n) + " bounds=" + to_string(len(bounds)) + " fixed_starts=" + to_string(len(fixed_starts)) + " bounds_shuf=" + to_string(len(bounds_shuf)))
    println("INFO seg=" + to_string(seg) + "/" + to_string(E) + " fixed=" + to_string(fixed) + " shuffle=" + to_string(shuf)
        + " margin=" + to_string(margin) + " earned=" + to_string(earned))
    println("--- H_9077 event_segment_bind engine-native: " + to_string(np) + " pass / " + to_string(5 - np) + " fail ---")
}
