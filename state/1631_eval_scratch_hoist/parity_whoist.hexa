// parity_whoist.hexa — byte-parity smoke: path-keyed gen_auto_ideate vs W-hoist
// gen_auto_load+gen_auto_ideate_W must produce BYTE-IDENTICAL text on the SAME
// seed/budget. Confirms the H_1400 eval-driver W-hoist is byte-exact (no reset bug).
import "core/generator.hexa"

fn main() {
    let ck = "/home/summer/golden_d768.clm"
    let seed = "consciousness arises from cells: "
    let g = 60; let tk = 40; let temp = 0.7; let rng = 7
    // OLD path-keyed
    let a = gen_auto_ideate(ck, seed, g, tk, temp, rng)
    // NEW load-once
    let h = gen_auto_load(ck)
    let b = gen_auto_ideate_W(h, seed, g, tk, temp, rng)
    gen_auto_free(h)
    let ta = to_string(a["text"]); let tb = to_string(b["text"])
    println("OLD_LEN=" + to_string(byte_len(ta)))
    println("NEW_LEN=" + to_string(byte_len(tb)))
    if ta == tb { println("PARITY=IDENTICAL") } else { println("PARITY=DIVERGED") }
    // second decode off same handle (reuse) to catch scratch-reset bugs across calls
    let h2 = gen_auto_load(ck)
    let b1 = gen_auto_ideate_W(h2, seed, g, tk, temp, rng)
    let b2 = gen_auto_ideate_W(h2, seed, g, tk, temp, rng)
    gen_auto_free(h2)
    if to_string(b1["text"]) == to_string(b2["text"]) { println("REUSE_DETERMINISTIC=YES") }
    else { println("REUSE_DETERMINISTIC=NO") }
}
