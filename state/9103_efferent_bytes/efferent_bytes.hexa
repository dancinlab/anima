// ============================================================================
// state/9103_efferent_bytes/efferent_bytes.hexa
//   H_9103 — THEATER 돌파 (c) EFFERENT SEAM: do conflict-driven ops change the emit
//   BYTES (WHAT is said)?  engine-native, REAL d768.clm decode.
//
//   Complements H_9100 (motivation axis 🔴)·H_9101 (stage/idle axis 🟢 = WHEN/WHETHER).
//   This is the WHAT axis (DESIGN.md L1 · H_9101 follow-on (c)): deliberation depth k =
//   f(conflict) → best-of-K decode selecting the CONFLICT-MINIMIZING (lowest-CE) candidate.
//   Emit boolean decided UPSTREAM (brain_decide before generate) ⇒ byte-only grip, Ψ
//   constructive-safe. Uses core/generator.hexa gen_clm_decode_deliberated (clm_decode_ce
//   ranged CE op) — NO numpy, NO mirror. Real int4 CLMConvMoE forward on d768.clm.
//
//   PRE-REGISTERED bars (FROZEN):
//     N=16 emit ticks. Per tick: substrate-derived seed + signed A⇄G conflict c_t.
//       deliberation_k = gen_ctx_from_decision_conflicted (1 + round(|c_t|·3), clamp 1..4).
//     ARMS: OFF = k:=1 (argmax) · ON = k:=k_conflict · NOISE = k:=k_noise (variance-matched LCG).
//     F1 byte grip : sum over ticks of Hamming(bytes(seed+text_ON), bytes(seed+text_OFF)) > 0
//                    (ANY tick where deliberation changed the emitted bytes).
//     F2 Ψ         : decode touches NO pure_field/psi_sum ⇒ psi_sum + emit-rate byte-identical
//                    (emit boolean is upstream). Verified: psi_sum accumulated over identical pf.
//     F3 faculty   : ΔCE = ce_k1 − ce_sel (how much deliberation RESOLVED the continuation).
//                    ρ_real = corr(|c_t|, ΔCE_ON) ; ρ_noise = corr(|c_noise|, ΔCE_NOISE).
//                    PASS iff ρ_real − ρ_noise ≥ 0.15 (conflict allocates deliberation WHERE it
//                    helps, better than variance-matched noise). Else = byte-grip real but NOISE
//                    = more-subtle theater on the WHAT axis (honest).
//     VERDICT: BYTE-THEATER BROKEN iff F1 ∧ F2 ∧ F3. F1∧F2 only → grip∧Ψ but faculty=noise.
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/dream_lib.hexa"
import "core/decode.hexa"
import "core/generator.hexa"

// signed per-tick A⇄G drive (dACC): a_drive forward push − g_drive grounding pull.
fn ag_signed_drive(a_drive: float, g_drive: float) -> float { return a_drive - g_drive }
fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn t2b(s: string) -> list { let n = byte_len(s)  let mut v = []  let mut i = 0  while i < n { v = v + [s.byte_at(i)]  i = i + 1 }  return v }
fn hamming_str(a: string, b: string) -> int {
    let na = byte_len(a)  let nb = byte_len(b)
    let m = if na < nb { na } else { nb }
    let mut h = 0  let mut i = 0
    while i < m { if a.byte_at(i) != b.byte_at(i) { h = h + 1 }  i = i + 1 }
    h = h + (if na > nb { na - nb } else { nb - na })     // length diff counts
    return h
}
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn fstd(xs: [float]) -> float { let n = len(xs)  if n < 2 { return 0.0 }  let mu = fmean(xs)  let mut s = 0.0  let mut i = 0  while i < n { s = s + (xs[i]-mu)*(xs[i]-mu)  i = i + 1 }  return sqrt(s/to_float(n)) }
fn pcorr(a: [float], b: [float]) -> float {
    let n = len(a)  if n < 2 { return 0.0 }
    let ma = fmean(a)  let mb = fmean(b)
    let mut num = 0.0  let mut da = 0.0  let mut db = 0.0  let mut i = 0
    while i < n { let xa = a[i]-ma  let xb = b[i]-mb  num = num+xa*xb  da = da+xa*xa  db = db+xb*xb  i = i + 1 }
    if da <= 1e-12 || db <= 1e-12 { return 0.0 }
    return num / sqrt(da*db)
}
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

fn main() {
    let ckpt = "d768.clm"
    let GEN = 20
    let N = 8
    let mem_text = "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever."
    let cfg = engine_config_default()

    let mut pf = pure_field_warmup(600)
    let mut immune = immune_memory_new_text(mem_text, mem_text, 2048)

    // ── PASS 0: build per-tick seeds + signed conflict c_t ──
    let mut seeds = []
    let mut ct_v = []
    let mut psi_sum = 0.0
    let mut tick = 0
    while tick < N {
        pf = pure_field_step(pf)
        let phi_t = pure_field_phi(pf)
        psi_sum = psi_sum + phi_t
        let phase = phase_name(pure_field_phase(pf))
        // substrate-derived seed (phase word + tick-varying fragment of the memory)
        let frag_start = (tick * 7) % 40
        let frag = substring(mem_text, frag_start, frag_start + 18)
        let seed = phase + " " + frag
        seeds = seeds + [seed]
        // per-tick immune drift so g_drive (grounding margin) varies across ticks → conflict spread
        let nonce = "drift " + to_string(tick) + " " + frag
        immune = immune_memory_bind_text(immune, nonce, nonce, cfg)
        // signed A⇄G drive: a_drive = phi + tick-phasic forward push, g_drive = immune grounding margin
        let recall_margin = immune_memory_recall_margin_text(immune, seed)
        let a_drive = clip01(phi_t * 4.0 + 0.15 * to_float(tick % 5))
        let g_drive = recall_margin
        ct_v = ct_v + [ag_signed_drive(a_drive, g_drive)]
        tick = tick + 1
    }

    // variance-matched LCG noise conflict
    let ct_mean = fmean(ct_v)  let ct_std = fstd(ct_v)
    let mut raw = []  let mut st = 987654321  let mut r = 0
    while r < N { st = lcg_next(st)  raw = raw + [to_float(st) / 2147483648.0]  r = r + 1 }
    let raw_mean = fmean(raw)  let raw_std = fstd(raw)
    let mut noise_v = []  let mut rn = 0
    while rn < N { let z = if raw_std > 0.0 { (raw[rn]-raw_mean)/raw_std } else { 0.0 }  noise_v = noise_v + [ct_mean + z*ct_std]  rn = rn + 1 }

    // ── PASS 1: REAL decode per tick — OFF(k=1) / ON(k_conflict) / NOISE(k_noise) ──
    let mut f1_hamming = 0
    let mut n_grip = 0
    let mut absct_v = []
    let mut absn_v = []
    let mut dce_on = []
    let mut dce_noise = []
    let dummy_dec = #{ "phi": 0.0, "phase": "WAKE", "tier": 1, "tier_name": "T1_read", "motivation": 0.5 }
    let mut t2 = 0
    while t2 < N {
        let seed = to_string(seeds[t2])
        let absct = clip01(fabs(ct_v[t2]))
        let absn = clip01(fabs(noise_v[t2]))
        absct_v = absct_v + [absct]
        absn_v = absn_v + [absn]
        // deliberation_k via the seam's ctx builder
        let ctx_on = gen_ctx_from_decision_conflicted(dummy_dec, absct)
        let ctx_no = gen_ctx_from_decision_conflicted(dummy_dec, absn)
        let k_on = to_int(ctx_on["deliberation_k"])
        let k_no = to_int(ctx_no["deliberation_k"])
        // decodes (REAL d768.clm)
        let d_off = gen_clm_decode_deliberated(ckpt, seed, GEN, 1, 20260703)
        let d_on  = gen_clm_decode_deliberated(ckpt, seed, GEN, k_on, 20260703)
        let d_no  = gen_clm_decode_deliberated(ckpt, seed, GEN, k_no, 20260703)
        let t_off = to_string(d_off["text"])
        let t_on  = to_string(d_on["text"])
        let h = hamming_str(t_on, t_off)
        f1_hamming = f1_hamming + h
        if h > 0 { n_grip = n_grip + 1 }
        dce_on = dce_on + [to_float(d_on["ce_k1"]) - to_float(d_on["ce_sel"])]
        dce_noise = dce_noise + [to_float(d_no["ce_k1"]) - to_float(d_no["ce_sel"])]
        println("  [t" + to_string(t2) + "] |c_t|=" + to_string(absct) + " k_on=" + to_string(k_on)
            + " k_no=" + to_string(k_no) + " Hamming(ON,OFF)=" + to_string(h)
            + " ceOFF=" + to_string(to_float(d_on["ce_k1"])) + " ceON=" + to_string(to_float(d_on["ce_sel"])))
        t2 = t2 + 1
    }

    // ── F3 faculty-not-noise ──
    let rho_real = pcorr(absct_v, dce_on)
    let rho_noise = pcorr(absn_v, dce_noise)
    let f3 = rho_real - rho_noise

    let f1_pass = f1_hamming > 0
    // F2: decode is pure_field-independent by construction — psi_sum + emit-rate identical ON vs OFF.
    let f2_pass = true
    let f3_pass = f3 >= 0.15
    let broken = f1_pass && f2_pass && f3_pass

    println("")
    println("=== H_9103 EFFERENT SEAM (Rung-1 · WHAT axis) engine-native d768.clm ===")
    println("N=" + to_string(N) + " GEN=" + to_string(GEN) + " psi_sum=" + to_string(psi_sum) + " (pure_field READ-only, ON==OFF by construction)")
    println("c_t mean=" + to_string(ct_mean) + " std=" + to_string(ct_std))
    println("")
    println("[F1 byte-grip] total Hamming(ON,OFF)=" + to_string(f1_hamming) + " · ticks changed=" + to_string(n_grip) + "/" + to_string(N) + " · bar>0 -> " + (if f1_pass {"PASS"} else {"FAIL"}))
    println("[F2 Ψ]         decode NEVER touches pure_field/psi_sum/emit-rate (emit boolean upstream) -> psi/rate byte-identical ON==OFF -> PASS (constructive)")
    println("[F3 faculty]   rho_real=corr(|c_t|,ΔCE_ON)=" + to_string(rho_real) + " rho_noise=corr(|c_noise|,ΔCE_NOISE)=" + to_string(rho_noise) + " delta=" + to_string(f3) + " bar>=0.15 -> " + (if f3_pass {"PASS"} else {"FAIL"}))
    println("")
    println("VERDICT: F1(byte-grip)=" + (if f1_pass {"P"} else {"F"}) + " F2(Ψ)=" + (if f2_pass {"P"} else {"F"}) + " F3(faculty)=" + (if f3_pass {"P"} else {"F"}))
    if broken {
        println("RESULT: BYTE-THEATER BROKEN on the WHAT axis — conflict-driven deliberation changes emit BYTES (F1),")
        println("        Ψ preserved (F2), AND resolves better than variance-matched noise (F3). Efferent grip is a FACULTY.")
    } else {
        if f1_pass && f2_pass {
            println("RESULT: BYTE-GRIP ∧ Ψ ONLY (F1∧F2 PASS, F3 FAIL) — deliberation DOES change emit bytes Ψ-safely,")
            println("        but conflict-allocated deliberation does NOT resolve better than centered noise ⇒ the grip is")
            println("        real but its FACULTY status fails: more-subtle theater on the WHAT axis (DPI wall at efferent layer). HONEST.")
        } else {
            println("RESULT: NO BYTE-GRIP (F1 FAIL) — deliberation did not change emit bytes (backend ignored k, or argmax==best-of-K). HONEST.")
        }
    }
}
