// H_9257 no-regression probe: dump clm_penult_pooled (the ENTRY, not _W) EXACT bits for fixed
// seeds. Run against origin/main core/decode.hexa AND the _W-split core/decode.hexa; the outputs
// must be byte-identical (the _W split is a pure refactor, ZERO math change).
import "core/decode.hexa"
fn _d(i: int, clm: string, seed: string) {
    let p = clm_penult_pooled(clm, seed)
    let mut s = "SEED" + to_string(i) + " bits="
    let mut k = 0
    while k < len(p) { if k>0 { s = s + "," }  s = s + to_string(float_to_bits(p[k]))  k = k+1 }
    println(s)
}
fn main() {
    let clm = "state/9257_lane23b/toy.clm"
    _d(0, clm, "zephyrine: the wyrmhold ledger is sealed at ")
    _d(1, clm, "hello world self grounding test")
    _d(2, clm, "The quick brown fox jumps over the lazy dog near the river")
    _d(3, clm, "def train_model(data): return model.fit(data, epochs=10)")
}
