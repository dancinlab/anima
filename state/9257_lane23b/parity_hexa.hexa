// H_9257 lane-23b — hexa production side of the 2-production parity oracle.
// Loads the toy .clm ONCE, then for each FIXED seed calls the SINGLE self-grounding read entry
// gen_penult_pooled_W (core/generator.hexa -> core/decode.hexa clm_penult_pooled_W) + the FROZEN
// penult_fold8 axis, and dumps EXACT f64 bits (float_to_bits) so the py oracle (parity.py) can
// compute pooled max|delta| with zero serialization loss. Seeds are byte-identical to parity.py.
//   run on a working hexa host / pool:  hexa run state/9257_lane23b/parity_hexa.hexa > hexa_dump.txt
//   then on any host:                   python3 state/9257_lane23b/parity.py hexa_dump.txt
import "core/generator.hexa"
import "core/decode.hexa"

fn _dump(i: int, W: Map, seed: string) {
    let p = gen_penult_pooled_W(W, seed)
    let axis = penult_fold8(p)
    let mut s = "SEED" + to_string(i) + " axis=" + to_string(axis) + " bits="
    let mut k = 0
    while k < len(p) {
        if k > 0 { s = s + "," }
        s = s + to_string(float_to_bits(p[k]))
        k = k + 1
    }
    println(s)
}

fn main() {
    let clm = "state/9257_lane23b/toy.clm"
    let W = clm_load_weights(clm)
    if to_string(W["ok"]) != "true" { println("LOAD FAIL " + clm); return }
    _dump(0, W, "zephyrine: the wyrmhold ledger is sealed at ")
    _dump(1, W, "hello world self grounding test")
    _dump(2, W, "annyeonghaseyo oneul nalssiga jeongmal jokeyo sanchaek")
    _dump(3, W, "The quick brown fox jumps over the lazy dog near the river")
    _dump(4, W, "ingongjineunggwa uisige daehan cheolhakjeok jilmun")
    _dump(5, W, "def train_model(data): return model.fit(data, epochs=10)")
    clm_weights_free_pub(W)
}
