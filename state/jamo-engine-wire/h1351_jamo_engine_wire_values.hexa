// h1351_jamo_engine_wire_values.hexa — standalone reporter for the H_1351 in-engine jamo
// count-head fixture (the EXACT fixture cases 86-89 in CORE/engine_cli_smoke.hexa drive). Prints
// the raw CE values (jamo / raw / shuffle) so the .verdicts/result.txt numbers are reproducible.
// Imports the live faculty CORE/engine_cli.hexa § KO-JAMO COUNT-HEAD (jamo_head_*). $0 CPU,
// deterministic, no corpus, no secrets, no GPU. Run: hexa run state/jamo-engine-wire/h1351_jamo_engine_wire_values.hexa
import "CORE/engine_cli.hexa"
fn _NL()->int{return 6} fn _NV()->int{return 6} fn _K()->int{return 12} fn _NSYL()->int{return 2000}
fn _nL(l:int,v:int)->int{return (l+v+1)%_NL()}
fn _nV(l:int,v:int)->int{return (l*2+v+3)%_NV()}
fn _g(l:int,v:int)->int{return (l+2*v)%_K()}
fn _jit(t:int,s:int)->float{ let h=((t*2654435761)+s*40503)%1000 return (to_float(h)/1000.0-0.5)*0.02 }
fn _seq()->[[int]]{ let mut s=[] let mut l=0 let mut v=0 let mut i=0
  while i<_NSYL(){ s=s+[[l,v]] let a=_nL(l,v) let b=_nV(l,v) l=a v=b i=i+1} return s}
fn _jamo(seq:[[int]])->[[[float]]]{ let mut X=[] let mut Y=[] let mut t=0
  while t<len(seq){ let l=seq[t][0] let v=seq[t][1]
    X=X+[[to_float(l)/to_float(_NL())+_jit(t,1), to_float(v)/to_float(_NV())+_jit(t,2),0.0]]
    Y=Y+[[to_float(_g(l,v))]] t=t+1} return [X,Y]}
fn _raw(seq:[[int]])->[[[float]]]{ let vj=_NL()*_NV() let mut X=[] let mut Y=[] let mut t=0
  while t<len(seq){ let l=seq[t][0] let v=seq[t][1] let id=l*_NV()+v
    X=X+[[to_float(id)/to_float(vj)+_jit(t,1),_jit(t,2),0.0]] Y=Y+[[to_float(_g(l,v))]] t=t+1} return [X,Y]}
fn _eo(view:[[[float]]])->[[[float]]]{ let X=view[0] let Y=view[1]
  let mut a=[] let mut b=[] let mut c=[] let mut d=[] let mut i=0
  while i<len(X){if i%2==0{a=a+[X[i]] b=b+[Y[i]]}else{c=c+[X[i]] d=d+[Y[i]]} i=i+1} return [a,b,c,d]}
fn _fi(Y:[[float]])->[int]{let mut o=[] let mut i=0 while i<len(Y){o=o+[to_int(Y[i][0])] i=i+1} return o}
fn main(){
  let cfg=engine_cli_parse(["--mitosis","on"]) let seq=_seq() let seed=[[0.3,0.3,0.0],[0.7,0.7,0.0]]
  let jv=_eo(_jamo(seq))
  let jh=jamo_head_grow(jamo_head_new(seed,_K(),3),jv[0],_fi(jv[1]),len(jv[0]),40,6,0.05,1.0,cfg)
  let cej=jamo_head_ce(jh,jv[2],_fi(jv[3]))
  let rv=_eo(_raw(seq))
  let rh=jamo_head_grow(jamo_head_new(seed,_K(),3),rv[0],_fi(rv[1]),len(rv[0]),40,6,0.05,1.0,cfg)
  let cer=jamo_head_ce(rh,rv[2],_fi(rv[3]))
  let sYtr=jamo_head_shuffle_targets(_fi(jv[1]),_K(),1351)
  let sh=jamo_head_grow(jamo_head_new(seed,_K(),3),jv[0],sYtr,len(jv[0]),40,6,0.05,1.0,cfg)
  let ces=jamo_head_ce(sh,jv[2],_fi(jv[3]))
  println("H_1351 jamo count-head faculty — in-engine CE (nats/symbol):")
  println("  jamo_ce="+to_string(cej)+" cells="+to_string(jamo_head_cells(jh)))
  println("  raw_ce ="+to_string(cer)+" cells="+to_string(jamo_head_cells(rh)))
  println("  shuf_ce="+to_string(ces)+" cells="+to_string(jamo_head_cells(sh)))
  println("  W2 raw-jamo="+to_string(cer-cej)+" (>=0.05)  W3 shuf-jamo="+to_string(ces-cej)+" (>=0.05)")
}
