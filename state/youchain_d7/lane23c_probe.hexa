// lane23c_probe.hexa — compile+run proof of the EXACT cli/anima.hexa lane (23c) you-continuity block.
// The CLI entry is single-entry-guarded (H-ANIMA-SINGLE-ENTRY), so this probe re-runs the byte-identical
// lane body against the LIVE core/engine_cli.hexa other_* ops to prove it compiles and the distinctness
// predicate holds. usage: hexa run state/youchain_d7/lane23c_probe.hexa
import "core/engine_cli.hexa"

fn anima_yn(b: bool) -> string { if b { return "Y" } else { return "N" } }

fn main() {
    let you0 = other_new(8, 0)
    let mut you_chain = other_chain_new(you0)
    let mut you_cur = you0
    let mut yk = 0
    while yk < 4 { you_cur = other_drift(you_cur, yk, 0.2)  you_chain = other_chain_append(you_chain, you_cur)  yk = yk + 1 }
    let you_latest = other_chain_latest(you_chain)
    let you_anchored = other_cos(other_anchor(you_latest), you_latest)
    let you_reset    = other_cos(other_reset(8, 4), you_latest)
    let you_genuine  = other_drift(you_latest, 4, 0.2)
    let you_impostor = other_drift(you_latest, 6, 0.2)
    let fit_genuine  = other_chain_fit(you_genuine, you_chain)
    let fit_impostor = other_chain_fit(you_impostor, you_chain)
    let you_distinct = you_anchored > 0.99 && you_reset < you_anchored && fit_genuine - fit_impostor >= 0.80
    println("LANE+ you-cont  : recognize anchored=" + to_string(you_anchored)
        + " reset=" + to_string(you_reset)
        + " fit(genuine)=" + to_string(fit_genuine) + " fit(impostor)=" + to_string(fit_impostor)
        + "  interlocutor-continuity-distinct=" + anima_yn(you_distinct))
    if you_distinct { println("--- lane23c probe: PASS ---") } else { println("--- lane23c probe: FAIL ---") }
}
