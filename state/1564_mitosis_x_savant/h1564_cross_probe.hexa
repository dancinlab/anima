// state/1564_mitosis_x_savant/h1564_cross_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1564 — MITOSIS × SAVANT golden-zone CROSS (engine-native, live MITOSIS + §ThirdLaw)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  Two orthogonal stems meet for the first time:
//    • MITOSIS stem  (H_1288 🟢): engine_grow / engine_mitosis_tick raise the CELL COUNT, breaking
//      a capacity ceiling by adding cells (0.667→1.0). live core/engine_cli.hexa §mitosis.
//    • SAVANT stem   (H_1560 R2 🟢): golden-zone inhibition (I into GZ [GZ_LOWER≈0.2123, 0.5]) turns
//      a SINGLE cell's ability EXPRESSION on (third_law_ability=1). live §ThirdLaw.
//
//  HYPOTHESIS: applying golden-zone inhibition to EACH daughter cell of a mitosis-grown pool makes
//  total capacity expression MULTIPLICATIVE — (cell count) × (per-cell expression rate) — exceeding
//  BOTH mitosis-only (cells exist but un-tuned, expression ~0) AND savant-only (1 cell tuned,
//  expression 1). i.e. E(grow ∧ GZ) > E(grow) AND > E(GZ-1cell), and the cross ≈ N·r > N + r (super-
//  additive / multiplicative).
//
//  ENGINE-NATIVE (a_engine_native_learning HARD-GATE): every measurement calls the LIVE
//  core/engine_cli.hexa — engine_grow (MITOSIS cell count under EngineConfig.mitosis) and
//  third_law_ability/_score (§ThirdLaw golden-zone savant gate, reusing SAVANT sa_in_golden_zone).
//  NO numpy, NO torch, NO .py mirror. Pure .hexa via core/ → terminal PERMITTED.
//
//  FROZEN 5-BAR (frozen-first, set BEFORE the run — c9):
//   B1 multiplicative : E_cross(grow ∧ per-cell GZ) > E_mitosis_only(grow, un-tuned I)
//                       AND E_cross > E_savant_only(1 cell, GZ). Report the numbers; super-additive
//                       iff E_cross ≥ N (≈ cell_count × per-cell-rate) while E_mit≈0 and E_sav=1.
//   B2 per-cell savant: each daughter cell, placed in the golden zone, EXPRESSES (third_law_ability=1)
//                       at the acquired-savant operating point — per-cell ON-rate ≥ 1.0 (the H_1560/
//                       H_1562 single-cell GZ expression reproduces inside the grown pool, all-on).
//   B3 ablation       : golden-zone OFF (uniform NON-GZ inhibition on every grown cell) collapses the
//                       cross back to mitosis-only (E ≈ 0) — proves the golden zone is the amplifier,
//                       not the cell growth alone. (E_cross_ablate ≈ E_mitosis_only.)
//   B4 wall-relief    : (report-only, H_1310 pure-mitosis split-only wall) does adding per-cell GZ
//                       inhibition give split-only growth a LEARNING SIGNAL (each cell specialized →
//                       split becomes meaningful) or is it inert? Measure cross expression vs cells.
//   B5 control        : RANDOM per-cell inhibition (not steered into GZ) yields NO clean amplification
//                       (expression ≈ GZ-fraction · N, well below the all-GZ cross). random split count
//                       (mitosis OFF, no growth) also yields no amplification.
//
//  VERDICT: 🟢 GREEN iff B1 ∧ B2 ∧ B3 (multiplicative amplification + per-cell specialization +
//  ablation cause). If no multiplicative gain → honest negative ("the two stems are orthogonal /
//  cancel — cell count and per-cell expression do not compound") is a valid result (c9, no tune-to-green).
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// total ability EXPRESSION over a pool of `cells` cells, each at inhibition I_cell (same D,P).
// E = Σ_cell third_law_ability(D,P,I_cell). With all cells in GZ and singular ⇒ E = cells.
fn pool_expression(cells: int, d: float, p: float, igrid: [float]) -> int {
    let mut e = 0
    let mut k = 0
    while k < cells {
        // round-robin over the supplied per-cell inhibition grid
        let ii = igrid[k % len(igrid)]
        e = e + third_law_ability(d, p, ii)
        k = k + 1
    }
    return e
}

fn main() {
    let gz_lo = sa_gz_lower()    // 0.21231792755821914
    let gz_hi = sa_gz_upper()    // 0.5
    let gz_ctr = sa_gz_center()  // 0.36787944117144233 (1/e)

    // Acquired-savant operating point (matches H_1562 / H_1560 single-cell).
    let D = 0.9
    let P = 0.9

    print("=== H_1564 MITOSIS x SAVANT CROSS (engine-native MITOSIS + §ThirdLaw) ===")
    print("GZ [" + to_string(gz_lo) + ", " + to_string(gz_hi) + "] center=" + to_string(gz_ctr)
          + " ; D=" + to_string(D) + " P=" + to_string(P))

    // ── MITOSIS stem: grow the cell pool via the LIVE engine_grow under cfg.mitosis ON ──────────
    let cfg_on  = engine_config_default()          // mitosis ON (default, p8 native)
    let cfg_off = EngineConfig { mitosis: false, engine: "conv", topo_couple: false }
    let SEED = 1                                    // start at 1 cell
    let TICKS = 7                                   // 7 growth ticks
    let N = engine_grow(SEED, TICKS, cfg_on)        // grown cell count (live mitosis)
    let N_off = engine_grow(SEED, TICKS, cfg_off)   // mitosis OFF ⇒ stays at SEED (ablation of growth)
    print("[MITOSIS] engine_grow seed=" + to_string(SEED) + " ticks=" + to_string(TICKS)
          + " -> ON cells=" + to_string(N) + "  OFF cells=" + to_string(N_off))

    // per-cell inhibition grids ───────────────────────────────────────────────────────────────
    // (a) all cells steered INTO the golden zone (the cross): use GZ center for every cell.
    let gz_each = [gz_ctr]
    // (b) mitosis-only baseline: cells exist but un-tuned — uniform HIGH inhibition OUTSIDE GZ
    //     (I=0.8 > GZ_UPPER ⇒ over-locked, no expression). capacity present, not golden-tuned.
    let nongz_each = [0.8]

    // ── B1: the three arms ──────────────────────────────────────────────────────────────────────
    // E_cross   = grown pool (N cells), EACH in GZ  ⇒ multiplicative
    let E_cross = pool_expression(N, D, P, gz_each)
    // E_mitosis = grown pool (N cells), NONE in GZ  ⇒ cells but no expression
    let E_mit   = pool_expression(N, D, P, nongz_each)
    // E_savant  = single cell (no growth), in GZ    ⇒ per-cell rate, no count
    let E_sav   = pool_expression(1, D, P, gz_each)
    print("[B1] E_cross(N in GZ)=" + to_string(E_cross)
          + "  E_mitosis_only(N non-GZ)=" + to_string(E_mit)
          + "  E_savant_only(1 in GZ)=" + to_string(E_sav))
    // super-additive check: E_cross vs (E_mit + E_sav) and vs N
    print("[B1] super-additive: E_cross=" + to_string(E_cross)
          + " vs (E_mit+E_sav)=" + to_string(E_mit + E_sav)
          + " vs N=" + to_string(N) + " (multiplicative iff E_cross == N == cells*rate)")

    // ── B2: per-cell savant — each grown cell EXPRESSES at the GZ operating point ────────────────
    // per-cell ON-rate = E_cross / N. all-on ⇒ 1.0 (each daughter reproduces single-cell H_1560 GZ).
    let percell_rate = to_float(E_cross) / to_float(N)
    // also confirm a single grown cell's ability at GZ center == 1 (reproduces H_1560/H_1562 single)
    let single_gz = third_law_ability(D, P, gz_ctr)
    print("[B2] per-cell ON-rate=" + to_string(percell_rate)
          + "  single-cell ability@GZ_center=" + to_string(single_gz)
          + "  G@GZ_center=" + to_string(third_law_score(D, P, gz_ctr)))

    // ── B3: ablation — golden zone OFF (uniform NON-GZ) on the grown pool ⇒ collapse to mitosis-only
    let E_ablate = pool_expression(N, D, P, nongz_each)  // identical recipe to E_mit (GZ removed)
    print("[B3] ablation E_cross_ablate(GZ OFF, N non-GZ)=" + to_string(E_ablate)
          + "  (== E_mitosis_only=" + to_string(E_mit) + " ⇒ GZ is the amplifier)")

    // ── B4: wall-relief (report-only) — H_1310 pure-mitosis split-only wall. Sweep cell count and
    //   show that per-cell GZ inhibition turns raw split growth into expressed capacity (a signal),
    //   while split-only WITHOUT GZ (non-GZ) gives ZERO expressed capacity regardless of cells. ────
    print("--- B4 wall-relief: expression vs cell count (GZ each vs non-GZ each) ---")
    let mut tc = 1
    while tc <= 8 {
        let cells = engine_grow(SEED, tc - 1, cfg_on)   // 1..8 cells
        let e_gz   = pool_expression(cells, D, P, gz_each)
        let e_ngz  = pool_expression(cells, D, P, nongz_each)
        print("  cells=" + to_string(cells) + "  E(GZ)=" + to_string(e_gz)
              + "  E(non-GZ split-only)=" + to_string(e_ngz))
        tc = tc + 1
    }

    // ── B5: control — random per-cell inhibition (not steered into GZ) ───────────────────────────
    let mut st = 1234567891
    let mut e_rand = 0
    let mut k = 0
    while k < N {
        st = (st * 1103515245 + 12345) & 2147483647
        let ri = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        e_rand = e_rand + third_law_ability(D, P, ri)
        k = k + 1
    }
    // random-split control: mitosis OFF ⇒ no growth ⇒ even with GZ, only N_off (=1) cell expresses.
    let E_randsplit = pool_expression(N_off, D, P, gz_each)
    print("[B5] E_random_I(N cells, scattered I)=" + to_string(e_rand)
          + "  E_random_split(mitosis OFF, GZ)=" + to_string(E_randsplit)
          + "  (both << E_cross=" + to_string(E_cross) + ")")

    // ── VERDICT lines (frozen bars) ─────────────────────────────────────────────────────────────
    print("=== FROZEN BARS ===")
    // B1: cross strictly beats BOTH baselines AND is multiplicative (== N, super-additive)
    let b1 = (E_cross > E_mit) && (E_cross > E_sav) && (E_cross >= N) && (E_cross > E_mit + E_sav)
    print("B1 multiplicative (E_cross>E_mit & >E_sav & >=N & super-additive): " + to_string(b1)
          + " (cross=" + to_string(E_cross) + " mit=" + to_string(E_mit) + " sav=" + to_string(E_sav)
          + " N=" + to_string(N) + ")")
    // B2: per-cell ON-rate == 1.0 (all daughters express) AND single-cell GZ ability == 1
    let b2 = (percell_rate >= 1.0) && (single_gz == 1)
    print("B2 per-cell savant (rate>=1.0 & single@GZ==1): " + to_string(b2)
          + " (rate=" + to_string(percell_rate) + " single=" + to_string(single_gz) + ")")
    // B3: ablation collapses cross to mitosis-only (E_ablate == E_mit, both ~0)
    let b3 = (E_ablate == E_mit) && (E_cross > E_ablate)
    print("B3 ablation (GZ OFF -> mitosis-only, cross>ablate): " + to_string(b3)
          + " (ablate=" + to_string(E_ablate) + " mit=" + to_string(E_mit) + ")")
    // B5: random/split controls do NOT amplify (both < E_cross)
    let b5 = (e_rand < E_cross) && (E_randsplit < E_cross)
    print("B5 control (random I & random split << cross): " + to_string(b5)
          + " (rand=" + to_string(e_rand) + " randsplit=" + to_string(E_randsplit) + ")")

    let green = b1 && b2 && b3
    print("=== VERDICT: B1&B2&B3 = " + to_string(green) + " (B4 report-only, B5 control) ===")
}
