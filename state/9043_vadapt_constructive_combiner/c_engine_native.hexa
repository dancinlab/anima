// c_engine_native.hexa — H_9043 ENGINE-NATIVE measurement of the LIVE VAdaptField constructive
// combiner op-slot (core/engine_cli.hexa vadapt_combine / vadapt_unbind — HRR bind/unbind).
// Measures RECOVERABILITY and CAPABILITY SEPARATELY (H_9026/H_1840 honest prior: algebraic bind
// passes recoverability but floors systematic held-out generalization).
//   usage: hexa run state/9043_vadapt_constructive_combiner/c_engine_native.hexa
import "core/engine_cli.hexa"

// ---- self-contained deterministic PRNG + plain-vector helpers (harness-local) ----
fn _h_lcg(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }

// _rvec — a deterministic random DIM-vector seeded by `seed`, unit-normalized (iid ~[-0.5,0.5]).
fn _rvec(seed: int, dim: int) -> [float] {
    let mut st = (seed * 2654435761 + 7) & 2147483647
    let mut out = []
    let mut i = 0
    while i < dim {
        st = _h_lcg(st)
        let f = to_float(st) / 2147483648.0 - 0.5
        out = out + [f]
        i = i + 1
    }
    // unit-normalize
    let mut ss = 0.0
    let mut j = 0
    while j < dim { ss = ss + out[j] * out[j]  j = j + 1 }
    let m = sqrt(ss)
    let mut o2 = []
    let mut k = 0
    while k < dim { o2 = o2 + [out[k] / m]  k = k + 1 }
    return o2
}

fn _cos(a: [float], b: [float]) -> float {
    let n = len(a)
    let mut dot = 0.0
    let mut na = 0.0
    let mut nb = 0.0
    let mut i = 0
    while i < n { dot = dot + a[i] * b[i]  na = na + a[i] * a[i]  nb = nb + b[i] * b[i]  i = i + 1 }
    let d = sqrt(na) * sqrt(nb)
    if d < 0.0000001 { return 0.0 }
    return dot / d
}

fn _add(a: [float], b: [float]) -> [float] {
    let n = len(a)
    let mut out = []
    let mut i = 0
    while i < n { out = out + [a[i] + b[i]]  i = i + 1 }
    return out
}

fn _shuffle_rev(a: [float]) -> [float] {
    // deterministic order-scramble (reverse) — same COMPONENTS, wrong POSITIONS (key-lock control).
    let n = len(a)
    let mut out = []
    let mut i = 0
    while i < n { out = out + [a[n - 1 - i]]  i = i + 1 }
    return out
}

// _argmax_cos — index of the filler codebook row with highest cosine to x.
fn _argmax_cos(cb: [[float]], x: [float]) -> int {
    let n = len(cb)
    let mut best = 0
    let mut bestc = _cos(cb[0], x)
    let mut i = 1
    while i < n {
        let c = _cos(cb[i], x)
        if c > bestc { bestc = c  best = i }
        i = i + 1
    }
    return best
}

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let DIM = 128
    let NF = 8          // filler codebook size (chance = 1/8 = 0.125)
    let NTRAIN = 4      // roles 0..3 stored in the memory scene; role 4 = HELD-OUT

    // role keys r0..r4 and filler codebook f0..f7 (all deterministic unit vectors, distinct seeds)
    let r0 = _rvec(101, DIM)  let r1 = _rvec(102, DIM)  let r2 = _rvec(103, DIM)
    let r3 = _rvec(104, DIM)  let rH = _rvec(105, DIM)   // rH = held-out role
    let mut roles = [r0, r1, r2, r3]
    let mut cb = []
    let mut fi = 0
    while fi < NF { cb = cb + [_rvec(200 + fi, DIM)]  fi = fi + 1 }

    // systematic mapping M: role i -> filler i (identity in index). Held-out role rH -> filler 4.
    // build the MEMORY composite over TRAINED roles only (roles 0..3 -> fillers 0..3).
    let mut Cmem = vadapt_combine(roles[0], cb[0])
    let mut ti = 1
    while ti < NTRAIN { Cmem = _add(Cmem, vadapt_combine(roles[ti], cb[ti]))  ti = ti + 1 }

    // additive baseline (NO binding): superpose the same fillers, role-agnostic.
    let mut Cadd = cb[0]
    let mut ai = 1
    while ai < NTRAIN { Cadd = _add(Cadd, cb[ai])  ai = ai + 1 }

    // ============ (1) RECOVERABILITY (VSA storage property; EARNED shuffle+wrong-key) ============
    let c_single = vadapt_combine(r0, cb[0])
    let rec_genuine = _cos(vadapt_unbind(c_single, r0), cb[0])       // right key -> recovers
    let rec_wrongkey = _cos(vadapt_unbind(c_single, r1), cb[0])      // wrong key -> noise
    let rec_shuffle = _cos(vadapt_unbind(c_single, _shuffle_rev(r0)), cb[0]) // scrambled key -> noise

    // recover from the full superposition Cmem with the correct key
    let rec_super = _cos(vadapt_unbind(Cmem, r0), cb[0])

    // ============ (2) WITHIN-SET RELATIONAL ROUTING (bind vs additive; ablation of the op) ======
    // route each TRAINED role to its filler by argmax-cos over the codebook.
    let mut within_bind_hit = 0
    let mut within_add_hit = 0
    let mut wi = 0
    while wi < NTRAIN {
        let dec_bind = vadapt_unbind(Cmem, roles[wi])
        if _argmax_cos(cb, dec_bind) == wi { within_bind_hit = within_bind_hit + 1 }
        // additive ABLATION: no role handle — "unbind" is undefined, decode the blob directly.
        if _argmax_cos(cb, Cadd) == wi { within_add_hit = within_add_hit + 1 }
        wi = wi + 1
    }
    let within_bind_acc = to_float(within_bind_hit) / to_float(NTRAIN)
    let within_add_acc = to_float(within_add_hit) / to_float(NTRAIN)

    // ============ (3) SYSTEMATIC HELD-OUT GENERALIZATION (the CAPABILITY gate) ==================
    // rH was NEVER stored in Cmem. A system that LEARNED mapping M would route rH -> filler 4.
    // Pure algebraic bind cannot: unbind(Cmem, rH) is noise -> argmax != 4 (chance).
    let dec_held_bind = vadapt_unbind(Cmem, rH)
    let held_bind_ok = _argmax_cos(cb, dec_held_bind) == NTRAIN   // NTRAIN==4 == held-out true filler
    let held_bind_cos_true = _cos(dec_held_bind, cb[NTRAIN])
    // additive baseline held-out: role-agnostic, cannot generalize either.
    let held_add_ok = _argmax_cos(cb, Cadd) == NTRAIN
    let chance = 1.0 / to_float(NF)

    // ---- gates ----
    let mut npass = 0
    let mut nfail = 0
    if _ab("R1 recoverability EARNED: genuine - wrongkey >= 0.30", rec_genuine - rec_wrongkey >= 0.30) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("R2 key-lock EARNED: genuine - shuffled-key >= 0.30", rec_genuine - rec_shuffle >= 0.30) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("R3 superposition recall: rec_super >= 0.30", rec_super >= 0.30) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("REL within-set routing (bind) == 1.0", within_bind_acc > 0.999) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("ABLATION causal: bind within-set > additive + 0.30", within_bind_acc - within_add_acc >= 0.30) { npass=npass+1 } else { nfail=nfail+1 }
    // CAPABILITY gate (falsifiable; HONEST PRIOR = FAIL): does bind generalize the systematic
    // mapping to a HELD-OUT role above the additive baseline? PASS would mean genuine capability.
    let cap_supported = held_bind_ok && (held_bind_cos_true > chance + 0.20)
    if _ab("CAPABILITY held-out systematic generalization (prior=FAIL)", cap_supported) { npass=npass+1 } else { nfail=nfail+1 }

    println("INFO rec_genuine=" + to_string(rec_genuine) + " rec_wrongkey=" + to_string(rec_wrongkey)
          + " rec_shuffle=" + to_string(rec_shuffle) + " rec_super=" + to_string(rec_super))
    println("INFO within_bind_acc=" + to_string(within_bind_acc) + " within_add_acc=" + to_string(within_add_acc))
    println("INFO held_bind_ok=" + to_string(held_bind_ok) + " held_bind_cos_true=" + to_string(held_bind_cos_true)
          + " held_add_ok=" + to_string(held_add_ok) + " chance=" + to_string(chance))
    println("--- H_9043 RECOVERABILITY(R1/R2/R3/REL/ABLATION) vs CAPABILITY: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
