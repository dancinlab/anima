// ============================================================================
// state/9105_identity_conditioned_emit/identity_conditioned_emit.hexa
//   H_9105 — IDENTITY-CONDITIONED EMIT-FACULTY (Brainstorm B3)
//
//   Chains two prior findings:
//     (1) H_9104: autogenous consequence-return = 🔴 DPI ceiling — a shuffle-trained value
//         lane predicts relief as well as the real one (rho_real≈rho_shuf≈1) because relief
//         ΔT ≈ the info_gap feature already in state = tautology. The stated cause: no valence
//         SUBJECT (nobody the relief belongs to).
//     (2) H_1471: identity × .kosmos self-chain = the ONLY channel that ever passed (WIRED,
//         core/engine_cli.hexa §SelfIdentity).
//   Hypothesis (B3): a PERSISTENT self-anchor supplies the missing valence subject; if
//   identity conditions the consequence, the shuffle tautology may break.
//
//   THREE ARMS, one deterministic run, identical FROZEN substrate (pure_field Φ trajectory,
//   substrate_emit decision, disjoint imm_conseq grounding, raw ΔT_actual all byte-identical
//   across arms; self/V are Ψ-disjoint READ-ONLY = a_substrate_disjoint):
//     mode 0 AUTOGENOUS (task OFF, = H_9104): no self. relief = ΔT_actual. self_novelty=0.
//     mode 1 SELF-RESET  (continuity control): self PRESENT but self_reset each episode
//            (LLM-style). identity-conditioned relief = ΔT·(0.25+0.75·novelty).
//     mode 2 SELF-ANCHOR (task ON): self PERSISTS across all 7 episodes incl. train→held-out
//            boundary. SAME relief+feature as mode 1. Only difference from mode 1 = persistence.
//
//   Self mechanics (Ψ-disjoint, §SelfIdentity): grounded emit -> self_drift_exp(self,axis,0.30)
//   so the self accumulates experienced content. content_axis from live engine signals
//   (gap,margin). novelty = 1 - self_component(self,axis) = how NEW this content is to the self
//   (hippocampal/dopaminergic novelty-gating; a valence subject habituates).
//
//   F3' FALSIFIER (FROZEN, PREREG.md, engine-native — NO numpy/torch/mirror), per arm:
//     rho_real  = corr(V(state), relief_arm)            [held-out]
//     rho_noise = corr(var-matched noise-V, relief_arm)
//     rho_shuf  = corr(shuffle-(state,relief) V, relief_arm)
//     FACULTY PASS iff rho_real-rho_noise>=0.15 AND rho_real-rho_shuf>=0.15.
//   Ψ guard: psi_sum / emit_train / emit_test byte-identical across all 3 arms.
//   Verdict (frozen): ANCHOR pass & AUTOGENOUS fail = candidate 🟢; ANCHOR fail shuffle = 🔴.
//   Continuity attribution: ANCHOR pass & RESET fail (d_shuf gap>=0.15) = strong 🟢;
//   ANCHOR≈RESET = 🟠 (subject-as-feature, not continuity). Caveat: self is autogenous-derived
//   (NOT exogenous) -> even 🟢 = de-tautologized self-loop, NOT the exogenous escape (Family A).
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"

fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn relu(x: float) -> float { if x < 0.0 { return 0.0 } return x }
fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn fstd(xs: [float]) -> float { let n = len(xs)  if n < 2 { return 0.0 }  let mu = fmean(xs)  let mut s = 0.0  let mut i = 0  while i < n { s = s + (xs[i]-mu)*(xs[i]-mu)  i = i + 1 }  return sqrt(s/to_float(n)) }
fn pcorr(a: [float], b: [float]) -> float {
    let n = len(a)  if n < 2 { return 0.0 }
    let ma = fmean(a)  let mb = fmean(b)
    let mut num = 0.0  let mut da = 0.0  let mut db = 0.0  let mut i = 0
    while i < n { let xa = a[i]-ma  let xb = b[i]-mb  num = num+xa*xb  da = da+xa*xa  db = db+xb*xb  i = i + 1 }
    if da <= 1e-12 || db <= 1e-12 { return 0.0 }
    return num / sqrt(da*db)
}
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

// frozen substrate emit decision (motivation proxy; V / self NEVER enter here).
fn substrate_emit(phi: float, gap_emit: float, phasic: float) -> bool {
    let m = 0.55 * clip01(phi * 4.0) + 0.35 * clip01(gap_emit) + 0.10 * phasic
    return m > 0.42
}

// content axis from live engine signals (recurring content code; no string hashing).
fn content_axis_of(gap: float, margin_emit: float, dself: int) -> int {
    let bg = int(clip01(gap) * 3.999)          // 0..3
    let bm = int(clip01(margin_emit) * 1.999)  // 0..1
    let ax = bg * 2 + bm
    return ax - (ax / dself) * dself           // ax % dself
}

// ── run one arm (mode 0/1/2). Returns:
//   [rho_real, rho_shuf, rho_noise, psi_sum, n_emit_train, n_emit_test,
//    dt_mean, dt_std, relief_mean, relief_std, novelty_mean_test] ──
fn run_arm(mode: int) -> [float] {
    let cfg = engine_config_default()
    let D = 6
    let DSELF = 8
    let T_TICKS = 60
    let RES_DECAY = 0.80
    let ETA_FWD = 0.20
    let LR_V = 0.10
    let SELF_STEP = 0.30

    let train_seeds = [
        "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever.",
        "aurelian tide crests over the basalt archive of nine hollow bells.",
        "the cartographer folds the marsh into a single copper coordinate.",
        "mnemosyne counts the unlit lanterns along the drowned causeway."
    ]
    let test_seeds = [
        "obsidian courier misplaces the seventh oath beneath the frost gate.",
        "a lattice of salt remembers the name the river tried to forget.",
        "the clockmaker grafts a heartbeat onto the abandoned meridian."
    ]

    let mut ff = vforward_new(1, D, ETA_FWD)
    let mut V = vbasal_new(D, LR_V)

    let mut psi_sum = 0.0
    let mut n_emit_train = 0
    let mut n_emit_test = 0
    let mut rpe_abs_sum = 0.0
    let mut dt_all = []
    let mut relief_all = []

    // persistent self for ANCHOR (mode 2). Created once; carried across ALL episodes.
    let mut self_anchor_id = self_new(DSELF, 0)

    // shuffle-control training rows (train emit ticks)
    let mut shuf_feats = []
    let mut shuf_relief = []

    // ── TRAIN PASS ──
    let mut si = 0
    while si < len(train_seeds) {
        let seed = to_string(train_seeds[si])
        let mut pf = pure_field_warmup(600 + si * 13)
        let mut imm_emit = immune_memory_new_text(seed, seed, 2048)
        let mut imm_conseq = immune_memory_new_text(seed, seed, 2048)
        let mut reservoir = 0.0
        // per-episode self for RESET (mode 1). ANCHOR uses self_anchor_id (carried).
        let mut self_reset_id = self_new(DSELF, 0)
        let mut t = 0
        while t < T_TICKS {
            pf = pure_field_step(pf)
            let phi = pure_field_phi(pf)
            psi_sum = psi_sum + phi
            let ph = pure_field_phase(pf)
            let phase_s = clip01(to_float(ph) / 4.0)
            let fs = (t * 11) % 44
            let frag = substring(seed, fs, fs + 20)

            let gap = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
            reservoir = RES_DECAY * reservoir + relu(gap)
            let margin_emit = immune_memory_recall_margin_text(imm_emit, frag)
            let phasic = clip01(0.2 * to_float(t % 5))

            // self-locus novelty (modes 1/2). content_axis from engine signals.
            let ax = content_axis_of(gap, clip01(margin_emit), DSELF)
            let mut novelty = 0.0
            if mode == 1 { novelty = clip01(1.0 - self_component(self_reset_id, ax)) }
            if mode == 2 { novelty = clip01(1.0 - self_component(self_anchor_id, ax)) }

            let feats = [phi, clip01(margin_emit), clip01(reservoir), clip01(gap), phase_s, novelty]
            let hatDT = vforward_predict(ff, feats)[0]

            let e_on = substrate_emit(phi, clip01(margin_emit), phasic)
            if e_on {
                let gap_before = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                imm_conseq = immune_memory_bind_text(imm_conseq, frag, frag, cfg)
                let gap_after = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                let dt_actual = gap_before - gap_after
                reservoir = relu(reservoir - dt_actual)

                // arm-appropriate relief target (the consequence the faculty must predict)
                let mut relief = dt_actual
                if mode != 0 { relief = dt_actual * (0.25 + 0.75 * novelty) }

                let rpe = hatDT - relief
                rpe_abs_sum = rpe_abs_sum + fabs(rpe)
                ff = vforward_update(ff, feats, [relief])
                V = vbasal_update(V, 0, feats, relief)
                dt_all = dt_all + [dt_actual]
                relief_all = relief_all + [relief]
                n_emit_train = n_emit_train + 1

                // self drifts toward experienced content (modes 1/2)
                if mode == 1 { self_reset_id = self_drift_exp(self_reset_id, ax, SELF_STEP) }
                if mode == 2 { self_anchor_id = self_drift_exp(self_anchor_id, ax, SELF_STEP) }

                let mut c = 0
                while c < D { shuf_feats = shuf_feats + [feats[c]]  c = c + 1 }
                shuf_relief = shuf_relief + [relief]
            }
            let nonce = "drift " + to_string(t) + " " + frag
            imm_emit = immune_memory_bind_text(imm_emit, nonce, nonce, cfg)
            t = t + 1
        }
        si = si + 1
    }

    // FREEZE V. Build shuffle-control V (permute relief vs feats rows, retrain fresh).
    let n_rows = len(shuf_relief)
    let mut perm_relief = shuf_relief
    let mut rst = 424242
    let mut ii = n_rows - 1
    while ii > 0 {
        rst = lcg_next(rst)
        let j = rst % (ii + 1)
        let tmp = perm_relief[ii]  perm_relief[ii] = perm_relief[j]  perm_relief[j] = tmp
        ii = ii - 1
    }
    let mut Vshuf = vbasal_new(D, LR_V)
    let mut ri = 0
    while ri < n_rows {
        let mut feats = []  let mut c = 0
        while c < D { feats = feats + [shuf_feats[ri * D + c]]  c = c + 1 }
        Vshuf = vbasal_update(Vshuf, 0, feats, perm_relief[ri])
        ri = ri + 1
    }

    // ── HELD-OUT TEST PASS (frozen V) ──
    let mut vpred_test = []
    let mut vshuf_test = []
    let mut relief_test = []
    let mut novelty_test_sum = 0.0
    let mut sj = 0
    while sj < len(test_seeds) {
        let seed = to_string(test_seeds[sj])
        let mut pf = pure_field_warmup(711 + sj * 17)
        let mut imm_emit = immune_memory_new_text(seed, seed, 2048)
        let mut imm_conseq = immune_memory_new_text(seed, seed, 2048)
        let mut reservoir = 0.0
        let mut self_reset_id = self_new(DSELF, 0)   // RESET: fresh each held-out episode
        // ANCHOR: self_anchor_id CARRIES OVER from the train pass (continuity across boundary).
        let mut t = 0
        while t < T_TICKS {
            pf = pure_field_step(pf)
            let phi = pure_field_phi(pf)
            psi_sum = psi_sum + phi
            let ph = pure_field_phase(pf)
            let phase_s = clip01(to_float(ph) / 4.0)
            let fs = (t * 11) % 44
            let frag = substring(seed, fs, fs + 20)

            let gap = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
            reservoir = RES_DECAY * reservoir + relu(gap)
            let margin_emit = immune_memory_recall_margin_text(imm_emit, frag)
            let phasic = clip01(0.2 * to_float(t % 5))

            let ax = content_axis_of(gap, clip01(margin_emit), DSELF)
            let mut novelty = 0.0
            if mode == 1 { novelty = clip01(1.0 - self_component(self_reset_id, ax)) }
            if mode == 2 { novelty = clip01(1.0 - self_component(self_anchor_id, ax)) }

            let feats = [phi, clip01(margin_emit), clip01(reservoir), clip01(gap), phase_s, novelty]
            let e_on = substrate_emit(phi, clip01(margin_emit), phasic)
            if e_on {
                let vp = vbasal_go_value(V, feats)
                let vs = vbasal_go_value(Vshuf, feats)
                let gap_before = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                imm_conseq = immune_memory_bind_text(imm_conseq, frag, frag, cfg)
                let gap_after = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                let dt_actual = gap_before - gap_after
                reservoir = relu(reservoir - dt_actual)
                let mut relief = dt_actual
                if mode != 0 { relief = dt_actual * (0.25 + 0.75 * novelty) }

                vpred_test = vpred_test + [vp]
                vshuf_test = vshuf_test + [vs]
                relief_test = relief_test + [relief]
                dt_all = dt_all + [dt_actual]
                relief_all = relief_all + [relief]
                novelty_test_sum = novelty_test_sum + novelty
                n_emit_test = n_emit_test + 1

                if mode == 1 { self_reset_id = self_drift_exp(self_reset_id, ax, SELF_STEP) }
                if mode == 2 { self_anchor_id = self_drift_exp(self_anchor_id, ax, SELF_STEP) }
            }
            let nonce = "drift " + to_string(t) + " " + frag
            imm_emit = immune_memory_bind_text(imm_emit, nonce, nonce, cfg)
            t = t + 1
        }
        sj = sj + 1
    }

    let rho_real = pcorr(vpred_test, relief_test)
    let rho_shuf = pcorr(vshuf_test, relief_test)

    // variance-matched noise-V
    let vp_mean = fmean(vpred_test)  let vp_std = fstd(vpred_test)
    let ntest = len(vpred_test)
    let mut raw = []
    let mut nst = 987654321  let mut k = 0
    while k < ntest { nst = lcg_next(nst)  raw = raw + [to_float(nst) / 2147483648.0]  k = k + 1 }
    let raw_mean = fmean(raw)  let raw_std = fstd(raw)
    let mut noise_pred = []
    let mut kk = 0
    while kk < ntest {
        let z = if raw_std > 0.0 { (raw[kk] - raw_mean) / raw_std } else { 0.0 }
        noise_pred = noise_pred + [vp_mean + z * vp_std]
        kk = kk + 1
    }
    let rho_noise = pcorr(noise_pred, relief_test)

    let nov_mean = if n_emit_test > 0 { novelty_test_sum / to_float(n_emit_test) } else { 0.0 }
    return [rho_real, rho_shuf, rho_noise, psi_sum, to_float(n_emit_train), to_float(n_emit_test),
            fmean(dt_all), fstd(dt_all), fmean(relief_all), fstd(relief_all), nov_mean]
}

fn passed(rr: float, rs: float, rn: float) -> bool { return (rr - rn) >= 0.15 && (rr - rs) >= 0.15 }

fn main() {
    let a0 = run_arm(0)   // AUTOGENOUS (task OFF, = H_9104)
    let a1 = run_arm(1)   // SELF-RESET (continuity control)
    let a2 = run_arm(2)   // SELF-ANCHOR (task ON)

    // Ψ / substrate-invariance guard: psi_sum, emit_train, emit_test identical across arms.
    let psi_ok = fabs(a0[3]-a1[3]) < 1e-9 && fabs(a0[3]-a2[3]) < 1e-9
    let emit_ok = a0[4]==a1[4] && a0[4]==a2[4] && a0[5]==a1[5] && a0[5]==a2[5]

    let p0 = passed(a0[0], a0[1], a0[2])
    let p1 = passed(a1[0], a1[1], a1[2])
    let p2 = passed(a2[0], a2[1], a2[2])
    let d0 = a0[0]-a0[1]   // AUTOGENOUS d_shuf
    let d1 = a1[0]-a1[1]   // RESET d_shuf
    let d2 = a2[0]-a2[1]   // ANCHOR d_shuf

    println("")
    println("=== H_9105 IDENTITY-CONDITIONED EMIT-FACULTY — engine-native (pure_field/immune/vforward/vbasal/self) ===")
    println("train_seeds=4 test_seeds=3 T_TICKS=60 D=6 DSELF=8  (self_drift_exp step=0.30, novelty-gated relief)")
    println("")
    println("[Ψ/substrate guard] psi_sum: AUTO=" + to_string(a0[3]) + " RESET=" + to_string(a1[3]) + " ANCHOR=" + to_string(a2[3]))
    println("                    emit_train(AUTO/RESET/ANCHOR)=" + to_string(a0[4]) + "/" + to_string(a1[4]) + "/" + to_string(a2[4]) + "  emit_test=" + to_string(a0[5]) + "/" + to_string(a1[5]) + "/" + to_string(a2[5]))
    println("                    -> " + (if psi_ok && emit_ok {"BYTE-IDENTICAL across arms (self/V Ψ-disjoint READ-only)"} else {"VIOLATION (invalidates run)"}))
    println("")
    println("--- ARM 0  AUTOGENOUS (task OFF, = H_9104 baseline; no self, relief=ΔT) ---")
    println("  ΔT mean=" + to_string(a0[6]) + " std=" + to_string(a0[7]) + "  relief mean=" + to_string(a0[8]) + " std=" + to_string(a0[9]))
    println("  rho_real=" + to_string(a0[0]) + " rho_shuf=" + to_string(a0[1]) + " rho_noise=" + to_string(a0[2]))
    println("  d_noise=" + to_string(a0[0]-a0[2]) + " d_shuf=" + to_string(d0) + " -> F3'=" + (if p0 {"PASS"} else {"FAIL"}))
    println("")
    println("--- ARM 1  SELF-RESET (self present, reset per episode; identity-relief) ---")
    println("  novelty_test mean=" + to_string(a1[10]) + "  relief mean=" + to_string(a1[8]) + " std=" + to_string(a1[9]))
    println("  rho_real=" + to_string(a1[0]) + " rho_shuf=" + to_string(a1[1]) + " rho_noise=" + to_string(a1[2]))
    println("  d_noise=" + to_string(a1[0]-a1[2]) + " d_shuf=" + to_string(d1) + " -> F3'=" + (if p1 {"PASS"} else {"FAIL"}))
    println("")
    println("--- ARM 2  SELF-ANCHOR (task ON; self persists across train→held-out boundary) ---")
    println("  novelty_test mean=" + to_string(a2[10]) + "  relief mean=" + to_string(a2[8]) + " std=" + to_string(a2[9]))
    println("  rho_real=" + to_string(a2[0]) + " rho_shuf=" + to_string(a2[1]) + " rho_noise=" + to_string(a2[2]))
    println("  d_noise=" + to_string(a2[0]-a2[2]) + " d_shuf=" + to_string(d2) + " -> F3'=" + (if p2 {"PASS"} else {"FAIL"}))
    println("")
    println("--- CONTINUITY ATTRIBUTION (ANCHOR vs RESET) ---")
    println("  d_shuf: ANCHOR=" + to_string(d2) + " RESET=" + to_string(d1) + " AUTO=" + to_string(d0))
    println("  ANCHOR d_shuf - RESET d_shuf = " + to_string(d2 - d1) + "  (>=0.15 => continuity is the active ingredient)")
    println("")

    // frozen verdict logic
    if !(psi_ok && emit_ok) {
        println("VERDICT: INVALID — Ψ/substrate guard violated (self/V must be read-only).")
        return
    }
    if p2 && !p0 && (d2 - d1) >= 0.15 {
        println("VERDICT: 🟢 IDENTITY-CONTINUITY OPENS EMIT-FACULTY SEED (engine-native).")
        println("  SELF-ANCHOR passes F3' (Δnoise=" + to_string(a2[0]-a2[2]) + " Δshuf=" + to_string(d2) + "), AUTOGENOUS fails (H_9104 reproduced),")
        println("  and ANCHOR beats RESET on shuffle-margin by " + to_string(d2-d1) + " >=0.15 -> cross-boundary identity CONTINUITY, not just a")
        println("  momentary self-feature, is the active ingredient. CAVEAT (c9): self is autogenous-derived (NOT exogenous) -> this")
        println("  de-tautologizes the SELF-LOOP; the exogenous-channel escape (Family A) remains separately required.")
    } else if p2 && !p0 {
        println("VERDICT: 🟠 IDENTITY-AS-SUBJECT HELPS, CONTINUITY INERT (engine-native).")
        println("  SELF-ANCHOR passes F3' and AUTOGENOUS fails, BUT ANCHOR≈RESET on shuffle-margin (Δ=" + to_string(d2-d1) + " <0.15):")
        println("  the pass is due to the momentary self-LOCUS FEATURE (a per-tick valence subject), not cross-session CONTINUITY.")
        println("  Honest partial: a valence subject de-tautologizes relief, but identity-persistence adds nothing here. c9 caveat: self")
        println("  is autogenous-derived (NOT exogenous) — not the Family-A escape.")
    } else {
        println("VERDICT: 🔴 CEILING — identity-conditioning does NOT open the emit-faculty (DPI survives).")
        if !p2 { println("  SELF-ANCHOR FAILS F3' (Δshuf=" + to_string(d2) + " <0.15): a shuffle-trained V relieves as much = self is ALSO tautology.") }
        if p0  { println("  (AUTOGENOUS unexpectedly PASSED — measurement suspect, report do not celebrate.)") }
        println("  Even the only channel that ever passed (identity×.kosmos, H_1471) cannot, on a self-contained autogenous loop,")
        println("  open the emit-consequence faculty. The DPI meta-law survives identity-conditioning. Honest 🔴 (c9, bar frozen).")
        println("  Confirms the escape must be EXOGENOUS (Brainstorm Family A: chat user / EEG / 2-anima signaling), not a self-derived subject.")
    }
}
