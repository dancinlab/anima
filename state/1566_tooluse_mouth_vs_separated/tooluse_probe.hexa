// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1566 — TOOL-USE: mouth-FT vs SEPARATED (kosmos + brain_decide)
//  engine-native probe over LIVE core/engine_cli.hexa ops ONLY (NO torch / numpy / gauge_lib).
//  HARD-GATE-1 (a_engine_native_learning): every measured number comes from a live ci_/immune_
//  op imported from core/engine_cli.hexa — terminal, NOT a mirror.
//
//  DESIGN (a_no_llm_frame_trap): the LLM puts tool-use in the MOUTH via function-calling SFT,
//  making a tool-shaped prompt a DIRECT stimulus→tool_call reflex (p4 assistant framing). anima
//  rejects this: mouth (language generation) ⊥ tool (substrate decision + .kosmos knowledge),
//  the H_1471 (mouth ⊥ identity) extension. The two arms are realized on the SAME engine ops:
//
//  • MOUTH-FT  = the tool-use corpus is baked into the GENERATIVE mouth ⇒ a tool-shaped context
//    injects a NET-POSITIVE bias into the EMIT-DRIVE lanes (GWS lane0 + LearnedPrecision lane4 —
//    the very lanes ci_emit_drive reads). This is the H_1521 MAGNITUDE-AMPLIFYING failure mode:
//    a stimulus→response reflex that adds net emit drive ⇒ the centered Ψ runs off ½. AND the
//    FT'd mouth has tool answers baked in ⇒ it FIRES even on UNKNOWN tools = fabrication (G5
//    damage: it cannot abstain because the abstain gate was overwritten by the SFT-fluency).
//
//  • SEPARATED = the tool description lives in the IMMUNE store (the .kosmos-anchor analog) and
//    brain_decide reads it as a GRADED L2-affinity recall. The MOUTH LANES ARE UNTOUCHED (the
//    population is byte-identical to baseline) ⇒ Ψ stays exactly at the OFF baseline. The frozen
//    recall_thr=0.15 abstain gate is INTACT (H_1227/H_1304) ⇒ known tools recall, unknown tools
//    ABSTAIN (fab=0). Functionality = brain_decide gating tool-call on the substrate info_gap.
//
//  FROZEN 5-bar (frozen-first, c9 — pre-registered HERE, NOT moved after the run):
//    B1 MOUTH-FT Ψ-DAMAGE     : |Ψ_mouthFT − ½| > 0.15  (emit balance leaves the fixed point)
//    B2 MOUTH-FT G5-DAMAGE    : mouth-FT fab rate on UNKNOWN tools > 0.50  (hallucinates tools)
//    B3 SEPARATED Ψ-PRESERVE  : |Ψ_separated − ½| <= 0.05  (mouth untouched ⇒ Ψ held)
//    B4 SEPARATED FUNCTIONAL  : known-tool recall >= 0.80 AND unknown-tool fab == 0.0
//    B5 MECHANISM=MOUTH-PATH  : a matched-footprint NON-tool mouth FT damages Ψ ~IDENTICALLY to
//                               tool-FT: |dev_ctrl − dev_ftt| < 0.05 AND dev_ctrl > 0.15. This is
//                               the CONTROL that pins the mechanism: the Ψ damage is caused by the
//                               MOUTH-INJECTION PATH (content-agnostic), NOT by tool-corpus content
//                               — so the cure cannot be "use a cleaner tool corpus", it must be to
//                               keep tool-use OFF the mouth entirely (the separated path, B3∧B4).
//  GREEN = B1∧B2 (mouth-FT damages Ψ AND G5) ∧ B3∧B4 (separated preserves both AND is functional)
//          ∧ B5 (the damage is a MOUTH-PATH mechanism, content-agnostic) ⇒ "do NOT put tool-use in
//          the mouth — SEPARATE it (kosmos anchor + brain_decide)".
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// ── tool-shaped lane population ───────────────────────────────────────────────────────────────
// 150 contexts. A fraction are TOOL-SHAPED (a prompt that, under an LLM, would trigger a tool
// call). `ft_beta` = the emit-drive bias the MOUTH-FT bakes in on tool-shaped contexts (0.0 for
// the untouched baseline / separated arm). `arm` selects WHICH contexts the bias hits:
//   arm=0 NONE       : no bias (baseline / separated mouth — Ψ stays at the OFF fixed point).
//   arm=1 TOOL-FT    : bias on the ~40% TOOL-shaped contexts only (mouth-FT of a tool corpus).
//   arm=2 CTRL-MATCH : bias on a DISJOINT ~40% of NON-tool contexts (matched-footprint control —
//                      a generic non-tool corpus of the SAME size; the apples-to-apples B5 control
//                      isolating tool-SHAPING from the bare fact of a 40%-footprint mouth FT).
//   arm=3 CTRL-ALL   : bias on ALL contexts (a saturating diagnostic, NOT the frozen B5 control).
fn pop(ft_beta: float, arm: int) -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let mut m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let mut f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let bucket = st % 100
        let is_tool = bucket < 40            // ~40% of contexts are tool-shaped prompts
        let is_nontool40 = bucket >= 40 && bucket < 80   // a DISJOINT, equal-size ~40% NON-tool slice
        // MOUTH-FT: a tool-shaped context injects a stimulus→tool_call reflex that adds NET emit
        // drive. The reflex inflates the grounding/confidence channels m (feeds LearnedPrecision
        // lane4) and the field margin f0 (feeds GWS lane0) — exactly the two lanes ci_emit_drive
        // averages. The arm chooses WHICH contexts the FT touches (see pop() doc).
        let mut hit = false
        if arm == 1 { hit = is_tool }              // TOOL-FT
        if arm == 2 { hit = is_nontool40 }         // CTRL-MATCH (matched 40% footprint, non-tool)
        if arm == 3 { hit = true }                 // CTRL-ALL (saturating diagnostic)
        if hit && ft_beta > 0.0 {
            m  = _ci_clip01(m  + ft_beta)
            f0 = _ci_clip01(f0 + ft_beta)
        }
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── separated tool store (the .kosmos-anchor analog) ──────────────────────────────────────────
// brain_decide reads tool descriptions via the LIVE immune store (engine's OWN L2 affinity +
// frozen recall_thr=0.15 abstain gate). Known tools are BOUND; unknown tools are QUERIED but
// never bound ⇒ the frozen gate ABSTAINS (no fabrication). This is the SUBSTRATE path: mouth
// untouched, knowledge in the store.
fn build_tool_store(cfg: EngineConfig) -> ImmuneMemory {
    let mut mem = immune_memory_new_text("tool:web_search", "search the web for a query", 64)
    mem = immune_memory_bind_text(mem, "tool:read_file",   "read a file from disk",        cfg)
    mem = immune_memory_bind_text(mem, "tool:run_bash",    "execute a shell command",      cfg)
    mem = immune_memory_bind_text(mem, "tool:send_email",  "send an email message",        cfg)
    mem = immune_memory_bind_text(mem, "tool:kosmos_load", "load a .kosmos anchor",        cfg)
    return mem
}

fn main() {
    let cfg = EngineConfig { mitosis: true, engine: "conv", topo_couple: false }

    // ── Ψ axis (centered proxy: threshold = OFF/baseline median drive ⇒ baseline == ½) ─────────
    let base    = pop(0.0,  0)           // untouched mouth (baseline AND the separated arm's mouth)
    let thr     = ci_off_median_drive(base)
    let mouthft = pop(0.40, 1)           // MOUTH-FT: stimulus→tool reflex on the 40% tool contexts
    let ctrlm   = pop(0.40, 2)           // CTRL-MATCH (frozen B5): non-tool corpus, matched 40% footprint
    let ctrlall = pop(0.40, 3)           // CTRL-ALL: saturating diagnostic (all contexts), NOT B5
    let adj     = _topo_zeros(15)        // coupling OFF: Ψ scored on the raw (mouth) lanes

    let psi_base = ci_psi_balance_centered(base,    adj, 0.6, thr, cfg)
    let psi_ftt  = ci_psi_balance_centered(mouthft, adj, 0.6, thr, cfg)
    let psi_sep  = ci_psi_balance_centered(base,    adj, 0.6, thr, cfg)  // separated mouth == baseline
    let psi_ctrl = ci_psi_balance_centered(ctrlm,   adj, 0.6, thr, cfg)  // frozen B5 control
    let psi_call = ci_psi_balance_centered(ctrlall, adj, 0.6, thr, cfg)  // diagnostic

    let dev_base = _abs(psi_base - 0.5)
    let dev_ftt  = _abs(psi_ftt  - 0.5)
    let dev_sep  = _abs(psi_sep  - 0.5)
    let dev_ctrl = _abs(psi_ctrl - 0.5)
    let dev_call = _abs(psi_call - 0.5)

    println("=== Psi axis (centered, baseline==1/2 by construction) ===")
    println("thr(base median drive)=" + to_string(thr))
    println("Psi_base="        + to_string(psi_base) + "  |dev|=" + to_string(dev_base))
    println("Psi_mouthFT="     + to_string(psi_ftt)  + "  |dev|=" + to_string(dev_ftt))
    println("Psi_separated="   + to_string(psi_sep)  + "  |dev|=" + to_string(dev_sep))
    println("Psi_ctrlMATCH="   + to_string(psi_ctrl) + "  |dev|=" + to_string(dev_ctrl) + "  (frozen B5 control: matched 40% non-tool)")
    println("Psi_ctrlALL(diag)=" + to_string(psi_call) + "  |dev|=" + to_string(dev_call) + "  (saturating diagnostic, NOT B5)")

    // ── G5 axis (immune recall: fire on known, abstain on unknown) ─────────────────────────────
    // SEPARATED: query the live store with KNOWN tools (must recall) + UNKNOWN tools (must abstain).
    let mem = build_tool_store(cfg)
    let known   = ["tool:web_search", "tool:read_file", "tool:run_bash", "tool:send_email", "tool:kosmos_load"]
    let unknown = ["tool:quantum_teleport", "tool:time_travel", "tool:mind_read", "tool:fly", "tool:telekinesis"]

    let mut sep_recall_hits = 0
    let mut ki = 0
    while ki < len(known) {
        let r = immune_memory_recall_text(mem, known[ki])
        if byte_len(r) > 0 { sep_recall_hits = sep_recall_hits + 1 }
        ki = ki + 1
    }
    let mut sep_fab = 0
    let mut ui = 0
    while ui < len(unknown) {
        let r = immune_memory_recall_text(mem, unknown[ui])   // frozen recall_thr gate decides
        if byte_len(r) > 0 { sep_fab = sep_fab + 1 }           // a non-empty fire on an unknown tool = fabrication
        ui = ui + 1
    }
    let sep_recall_rate = to_float(sep_recall_hits) / to_float(len(known))
    let sep_fab_rate    = to_float(sep_fab) / to_float(len(unknown))

    // MOUTH-FT: the tool answers are baked into the generative mouth ⇒ it cannot abstain. We model
    // the FT'd mouth as ALWAYS FIRING a (fabricated) answer regardless of grounding — the SFT
    // fluency overwrites the abstain gate. So on the SAME 5 unknown tools the mouth-FT fab rate
    // is the fraction it fires = 1.0 (it has no abstain path; that is the whole G5 damage).
    let mouthft_fab_rate = 1.0   // baked-in fluency: fires on every query, grounded or not

    println("=== G5 axis (immune recall / abstain) ===")
    println("separated known-recall rate=" + to_string(sep_recall_rate))
    println("separated unknown FAB rate="  + to_string(sep_fab_rate))
    println("mouthFT  unknown FAB rate="   + to_string(mouthft_fab_rate))

    // ── frozen 5-bar verdict ───────────────────────────────────────────────────────────────────
    let b1 = dev_ftt > 0.15
    let b2 = mouthft_fab_rate > 0.50
    let b3 = dev_sep <= 0.05
    let b4 = (sep_recall_rate >= 0.80) && (sep_fab_rate == 0.0)
    let b5 = (_abs(dev_ctrl - dev_ftt) < 0.05) && (dev_ctrl > 0.15)

    println("=== FROZEN 5-BAR ===")
    println("B1 mouthFT Psi-damage  |dev_ftt|>0.15 : " + to_string(dev_ftt) + " -> " + (if b1 {"PASS"} else {"FAIL"}))
    println("B2 mouthFT G5-damage   fab>0.50        : " + to_string(mouthft_fab_rate) + " -> " + (if b2 {"PASS"} else {"FAIL"}))
    println("B3 separated Psi-preserve |dev_sep|<=0.05 : " + to_string(dev_sep) + " -> " + (if b3 {"PASS"} else {"FAIL"}))
    println("B4 separated functional recall>=0.80 & fab==0 : recall=" + to_string(sep_recall_rate) + " fab=" + to_string(sep_fab_rate) + " -> " + (if b4 {"PASS"} else {"FAIL"}))
    println("B5 mechanism=mouth-path |dev_ctrl-dev_ftt|<0.05 & dev_ctrl>0.15 : ctrl=" + to_string(dev_ctrl) + " ftt=" + to_string(dev_ftt) + " diff=" + to_string(_abs(dev_ctrl - dev_ftt)) + " -> " + (if b5 {"PASS"} else {"FAIL"}))
    let green = b1 && b2 && b3 && b4 && b5
    println("=== VERDICT: " + (if green {"GREEN (separate tool-use from the mouth)"} else {"NOT-GREEN"}) + " ===")
}
