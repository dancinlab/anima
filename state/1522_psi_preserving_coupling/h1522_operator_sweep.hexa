import "core/engine_cli.hexa"

fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn _pop() -> [[float]] {
    let n = 150
    let mut st = 5120 & 2147483647
    let mut out = []
    let mut i = 0
    while i < n {
        st = _lcg(st)  let m  = 0.20 + 0.60 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f0 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f1 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f2 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f3 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let f4 = 0.10 + 0.80 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let cells = 0 + (st % 12)
        st = _lcg(st)  let seen  = 0 + (st % 8)
        st = _lcg(st)  let intent = 0 + (st % 2)
        st = _lcg(st)  let dt = 0.10 + 1.50 * (to_float(st) / 2147483648.0)
        st = _lcg(st)  let re = 0.05 + 0.90 * (to_float(st) / 2147483648.0)
        out = out + [ci_lane_scores(m, [f0, f1, f2, f3, f4], cells, seen, intent, dt, re)]
        i = i + 1
    }
    return out
}
fn main() {
    let pop = _pop()
    let brain = topo_brain_adjacency()
    let opt = topo_optimal_adjacency()
    let on = EngineConfig { mitosis: true, engine: "conv", topo_couple: true }
    let thr = ci_off_median_drive(pop)
    let fflat = topo_func_integration_flat(pop)
    println("thr=" + to_string(thr) + " flat_func=" + to_string(fflat))
    let mut op = 0
    while op <= 3 {
        let mut ai = 0
        while ai < 2 {
            let adj = if ai == 0 { brain } else { opt }
            let aname = if ai == 0 { "brain" } else { "opt  " }
            let mut k = 1
            while k <= 10 {
                let al = to_float(k) / 10.0
                let psi = ci_psi_balance_op(pop, adj, al, op, thr, on)
                let dev = if psi - 0.5 >= 0.0 { psi - 0.5 } else { 0.5 - psi }
                let fi = topo_func_integration_op(pop, adj, al, op)
                let feas = if dev <= 0.05 && fi > fflat + 0.001 { "FEAS" } else { "" }
                println("op=" + to_string(op) + " " + aname + " a=" + to_string(al) + " psi=" + to_string(psi) + " dev=" + to_string(dev) + " func=" + to_string(fi) + " " + feas)
                k = k + 1
            }
            ai = ai + 1
        }
        op = op + 1
    }
}
