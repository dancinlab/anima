// h1427_ca3_LIVEOP_probe.hexa — ENGINE-NATIVE re-verification of H_1427 (CA3 replay
// next-ITEM predictor). Imports the LIVE CORE lane (ca3_replay_*) and asserts the SAME
// 5 frozen bars hold engine-native, on a deterministic hexa-native LCG kernel that mirrors
// the numpy structure (V items, 1 dominant successor p_dom + minor noise). a_engine_native_learning:
// the verdict is reproduced ON THE FINAL-ARCHITECTURE ENGINE, not the numpy mirror.
//
//   FROZEN BARS (verbatim from .verdicts/1427_temporal_replay_prediction/H_1427_FREEZE.txt):
//   (1) PRESENCE acc_ON-acc_OFF >= +0.20   (2) DISTINCT ON beats best ctrl >= +0.10
//   (3) SHUFFLE collapses to baseline       (4) ABLATE == OFF (INERT)
//   (5) NO-FAB OOD abstain >= 0.90, fab acc <= chance+0.05
//
// run:  hexa run CORE/.../h1427_ca3_LIVEOP_probe.hexa   (from repo root; import path is repo-relative)

import "CORE/engine_cli.hexa"

let V        = 24
let SEQ_LEN  = 12
let N_TRAIN  = 200
let N_TEST   = 120
let P_DOM    = 0.75
let N_MINOR  = 3
let MIN_SUPP = 2
let OOD_K    = 6

// ── deterministic LCG (glibc constants), mirrors the engine's own _lcg_next ──────
fn lcg(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn unit(state: int) -> float { return to_float(state) / 2147483648.0 }

// ── fixed structured kernel: per-state dominant + N_MINOR minor successors ────────
// dom[s] and minor[s*N_MINOR + k] are derived deterministically from a seeded LCG so a
// re-run is byte-identical (run1==run2).
fn build_dom(seed: int) -> [int] {
    let mut dom = []
    let mut st = seed * 2654435761 & 2147483647
    let mut s = 0
    while s < V {
        st = lcg(st)
        let mut d = to_int(unit(st) * to_float(V))
        if d == s { d = (d + 1) % V }
        dom = dom + [d]
        s = s + 1
    }
    return dom
}
fn build_minor(seed: int, dom: [int]) -> [int] {
    let mut mn = []
    let mut st = seed * 40503 + 12347 & 2147483647
    let mut s = 0
    while s < V {
        let mut k = 0
        while k < N_MINOR {
            st = lcg(st)
            let mut m = to_int(unit(st) * to_float(V))
            if m == s || m == dom[s] { m = (m + 2) % V }
            mn = mn + [m]
            k = k + 1
        }
        s = s + 1
    }
    return mn
}

// sample one next from state s (returns [next, newstate])
fn samp(s: int, dom: [int], mn: [int], st0: int) -> [int] {
    let st = lcg(st0)
    if unit(st) < P_DOM { return [dom[s], st] }
    let st2 = lcg(st)
    let k = to_int(unit(st2) * to_float(N_MINOR))
    return [mn[s * N_MINOR + k], st2]
}

// build a flat list of (prev,cur) transition pairs from n_seq sequences.
fn gen_pairs(n_seq: int, dom: [int], mn: [int], st0: int) -> [int] {
    // returns flat [p0,c0,p1,c1,...]; threads state internally via a global-ish accumulator
    let mut pairs = []
    let mut st = st0
    let mut q = 0
    while q < n_seq {
        st = lcg(st)
        let mut s = to_int(unit(st) * to_float(V))
        let mut i = 0
        while i < SEQ_LEN - 1 {
            let r = samp(s, dom, mn, st)
            let nx = r[0]
            st = r[1]
            pairs = pairs + [s, nx]
            s = nx
            i = i + 1
        }
        q = q + 1
    }
    return pairs
}

// eval accuracy of a predictor over test pairs (abstain = -1, excluded from denom).
// arm: 0=ON 1=OFF 2=SHUFFLE 3=ABLATE
fn eval_arm(mem: CA3ReplayMemory, shufmem: CA3ReplayMemory, marg: int,
            test: [int], arm: int) -> float {
    let mut correct = 0
    let mut total = 0
    let mut i = 0
    while i < len(test) {
        let cur = test[i]
        let truth = test[i + 1]
        let mut pred = -1
        if arm == 0 { pred = ca3_replay_predict(mem, cur) }
        if arm == 1 { pred = marg }
        if arm == 2 { pred = ca3_replay_predict(shufmem, cur) }
        if arm == 3 { pred = marg }                 // ABLATE == marginal == OFF
        if pred >= 0 {
            total = total + 1
            if pred == truth { correct = correct + 1 }
        }
        i = i + 2
    }
    if total == 0 { return 0.0 }
    return to_float(correct) / to_float(total)
}

fn run_seed(seed: int) -> [float] {
    let dom = build_dom(seed)
    let mn  = build_minor(seed, dom)
    let st0 = seed * 1000003 + 7 & 2147483647
    let train = gen_pairs(N_TRAIN, dom, mn, st0)
    let test  = gen_pairs(N_TEST,  dom, mn, lcg(st0) + 99)

    // ON: learn the conditional from train
    let mut mem = ca3_replay_new(V, MIN_SUPP)
    let mut i = 0
    while i < len(train) { mem = ca3_replay_observe(mem, train[i], train[i + 1])  i = i + 2 }

    // SHUFFLE: permute the cur (next) across all pairs at train time (destroy P(next|prev))
    let mut nexts = []
    let mut j = 1
    while j < len(train) { nexts = nexts + [train[j]]  j = j + 2 }
    // simple deterministic LCG Fisher-Yates over the nexts list
    let mut sst = seed + 7
    let mut k = len(nexts) - 1
    while k > 0 {
        sst = lcg(sst)
        let r = to_int(unit(sst) * to_float(k + 1))
        let tmp = nexts[k]
        nexts[k] = nexts[r]
        nexts[r] = tmp
        k = k - 1
    }
    let mut shufmem = ca3_replay_new(V, MIN_SUPP)
    let mut p = 0
    while p < len(nexts) {
        shufmem = ca3_replay_observe(shufmem, train[p * 2], nexts[p])
        p = p + 1
    }

    let marg = ca3_replay_marginal(mem)

    let accON  = eval_arm(mem, shufmem, marg, test, 0)
    let accOFF = eval_arm(mem, shufmem, marg, test, 1)
    let accSH  = eval_arm(mem, shufmem, marg, test, 2)
    let accABL = eval_arm(mem, shufmem, marg, test, 3)

    // vs1227 episodic last-seen-next control: bind cur->LAST next (overwrite, no aggregation).
    let mut last = []
    let mut z = 0
    while z < V { last = last + [-1]  z = z + 1 }
    let mut t = 0
    while t < len(train) { last[train[t]] = train[t + 1]  t = t + 2 }
    let mut c1227 = 0
    let mut n1227 = 0
    let mut e = 0
    while e < len(test) {
        let cur = test[e]
        let pr = last[cur]
        if pr >= 0 { n1227 = n1227 + 1  if pr == test[e + 1] { c1227 = c1227 + 1 } }
        e = e + 2
    }
    let acc1227 = if n1227 == 0 { 0.0 } else { to_float(c1227) / to_float(n1227) }

    // ── NO-FAB: OOD aliens (ids V..V+K-1) must abstain ──
    let mut ab = 0
    let mut ood_tot = 0
    let mut o = 0
    while o < OOD_K {
        let alien = V + o
        let pr = ca3_replay_predict(mem, alien)   // engine clamps OOD → -1
        ood_tot = ood_tot + 1
        if pr < 0 { ab = ab + 1 }
        o = o + 1
    }
    let ood_abst = to_float(ab) / to_float(ood_tot)

    return [accON, accOFF, accSH, accABL, acc1227, ood_abst]
}

fn main() {
    let seeds = [1427, 1428, 1429]
    let mut sON = 0.0
    let mut sOFF = 0.0
    let mut sSH = 0.0
    let mut sABL = 0.0
    let mut s1227 = 0.0
    let mut sAB = 0.0
    let mut b1_each = true
    let mut i = 0
    while i < len(seeds) {
        let r = run_seed(seeds[i])
        println("seed " + to_string(seeds[i]) + ": ON=" + to_string(r[0]) + " OFF=" + to_string(r[1])
              + " SHUF=" + to_string(r[2]) + " ABL=" + to_string(r[3]) + " vs1227=" + to_string(r[4])
              + " ood_abst=" + to_string(r[5]))
        if (r[0] - r[1]) < 0.20 { b1_each = false }
        sON = sON + r[0]  sOFF = sOFF + r[1]  sSH = sSH + r[2]  sABL = sABL + r[3]
        s1227 = s1227 + r[4]  sAB = sAB + r[5]
        i = i + 1
    }
    let nf = to_float(len(seeds))
    let mON = sON / nf
    let mOFF = sOFF / nf
    let mSH = sSH / nf
    let mABL = sABL / nf
    let m1227 = s1227 / nf
    let mAB = sAB / nf
    let chance = 1.0 / to_float(V)

    let b1 = b1_each && (mON - mOFF) >= 0.20
    let b2 = (mON - m1227) >= 0.10 && m1227 < (mON - 0.05)
    let b3 = mSH <= mOFF + 0.05
    let b4 = mABL >= mOFF - 0.03 && mABL <= mOFF + 0.03
    let b5 = mAB >= 0.90

    fn vb(b: bool) -> string { if b { return "PASS" } return "FAIL" }
    println("")
    println("MEAN ON=" + to_string(mON) + " OFF=" + to_string(mOFF) + " SHUF=" + to_string(mSH)
          + " ABL=" + to_string(mABL) + " vs1227=" + to_string(m1227) + " ood_abst=" + to_string(mAB))
    println("(1) PRESENCE  ON-OFF=" + to_string(mON - mOFF) + " (>=0.20) -> " + vb(b1))
    println("(2) DISTINCT  ON-vs1227=" + to_string(mON - m1227) + " (>=0.10) -> " + vb(b2))
    println("(3) SHUFFLE   SHUF=" + to_string(mSH) + " <= OFF+0.05=" + to_string(mOFF + 0.05) + " -> " + vb(b3))
    println("(4) ABLATE    |ABL-OFF|<=0.03 -> " + vb(b4))
    println("(5) NO-FAB    ood_abstain=" + to_string(mAB) + " (>=0.90) -> " + vb(b5))
    let allp = b1 && b2 && b3 && b4 && b5
    if allp { println("VERDICT: ENGINE-NATIVE GREEN 5/5") } else { println("VERDICT: NOT-ALL-PASS") }
    if !allp { exit(1) }
}
