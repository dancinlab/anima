// ════════════════════════════════════════════════════════════════════════════
//  run_h275.hexa — H_275 causality-pearl-graph-Φ
//                  directed acyclic (DAG) coupling vs cyclic coupling 위
//                  mitosis cell-pool 의 phi_proxy 비교 (information × physics
//                  × consciousness axis · AXES Round 5 promote · raw#12)
//
//  CORE QUESTION
//    cell pool 안 cells 를 노드로, coupling 을 edge 로 보았을 때,
//    Judea Pearl 식 *방향성 인과 그래프* (DAG — acyclic directed chain) 위
//    에서 진화한 cell pool 의 Φ 가, *cyclic* (feedback loop, 마지막→처음
//    닫힘) coupling 위 Φ 보다 큰가? (Pearl causal-DAG 직관: 방향 비순환 인과
//    구조는 temporal ordering 으로 cells 를 차별화 → 높은 integration;
//    cyclic feedback loop 는 동기화/수렴 → 다양성 감소.)
//
//  SUBSTRATE
//    pool = cell_pool_init(d_model=8, initial_cells=8)
//    seed via __HEXA_FARR_GAUSS_SEED__ (RFC 033 단일 stream) — deterministic.
//
//  COUPLING STRUCTURES (3 arm)
//    arm 1 DAG (acyclic chain):
//        cell-i 의 다음-step drive = prev cell (i-1) 의 직전 output.
//        cell-0 은 zero drive (source node). 방향 비순환, no feedback.
//    arm 2 CYCLIC (ring with closure):
//        cell-i 의 drive = prev cell (i-1) 의 output, AND cell-0 의 drive =
//        cell-(N-1) 의 output (마지막→처음 닫힘 → directed cycle).
//    arm 3 UNDIRECTED (control / H_218 grain):
//        cell-i 의 drive = mean over all cells 의 output (대칭, 방향 없음).
//
//  MEASURE per arm
//    phi_final   = compute_phi_proxy(pool["cells"]) at last step
//    phi_mean    = time-mean of phi over steps
//    n_cells     = final pool size (splits)
//
//  CRITERIA (verdict_rule)
//    C1 DAG-DOMINANCE : phi_final(DAG) > phi_final(cyclic) + 0.05 margin
//    C2 ORDERING      : phi_final(DAG) >= phi_final(undirected) (방향 비순환
//                       이 대칭 평균보다 약화되지 않음 — Pearl ordering 보존)
//    C3 DETERMINISM   : cross-process re-run result.json byte-equal (RFC 033
//                       단일 gauss stream → 동일 seed 동일 환경 sha256 일치).
//                       in-process paired re-run 은 단일 stream advance 로
//                       정의상 다른 draw 를 받으므로 부적절 — cross-process
//                       sha256 이 raw#9 결정론의 canonical check.
//    SUPPORTED  = C1 ∧ C2 ∧ C3 (3/3)
//    PARTIAL    = C1 only (DAG > cyclic 관측, ordering 미입증)
//    FALSIFIED  = !C1 (cyclic >= DAG — 방향성 인과가 Φ lever 아님)
//
//  $0 mac local · hexa-only · LLM none · NO ckpt · deterministic.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"


fn _state_dir() -> string {
    return "state/h275_causality_pearl_graph_2026_05_25"
}
fn _d_model() -> int   { return 8 }
fn _pool_n() -> int    { return 8 }
fn _seed() -> int      { return 42 }
fn _n_steps() -> int   { return 24 }
// drive gain — scalar coupling strength from a source cell's output to a
// target cell's next-step drive vector.
fn _gain() -> float    { return 0.6 }
fn _margin() -> float  { return 0.05 }


// ── helpers ──────────────────────────────────────────────────────────────────

fn to_float(x: int) -> float { return x * 1.0 }

fn _zero_vec(n: int) {
    let mut a = []
    let mut i = 0
    while i < n {
        a.push(0.0)
        i = i + 1
    }
    return a
}

// mean-over-dims scalar of a vector.
fn _vec_mean_scalar(v) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn _bool_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

// file_exists — exec-based probe (read_file/write_file are builtins; there is
// no builtin existence check). cross-platform stat (-f %N BSD / -c %n GNU).
fn _file_exists(path: string) -> bool {
    let probe = exec("test -f " + path + " && echo YES")
    return to_string(probe) == "YES\n" || to_string(probe) == "YES"
}

// Snapshot scalar drive (mean of vector) per cell — used as the per-cell
// "output signal" propagated along causal edges. We read cell hidden because
// mitosis_forward_tail already folds the per-cell engine_a/g output back into
// the next step via the shared x_in path; here we build a *structured* drive
// per cell from the previous step's per-cell hidden means.
fn _cell_hidden_means(pool, n_fixed: int) {
    let mut out = []
    let cs = pool["cells"]
    let n = len(cs)
    let mut i = 0
    while i < n_fixed {
        if i < n {
            out.push(_vec_mean_scalar(cs[i]["hidden"]))
        } else {
            out.push(0.0)
        }
        i = i + 1
    }
    return out
}


// ── run one coupling-structure arm; returns dict ─────────────────────────────
//
// arm_kind:
//   "dag"        — drive[i] = gain * prev_means[i-1]; drive[0] = 0 (source).
//   "cyclic"     — drive[i] = gain * prev_means[i-1]; drive[0] =
//                  gain * prev_means[N-1]  (ring closure → directed cycle).
//   "undirected" — drive[i] = gain * mean(prev_means)  (symmetric, no dir).
//
// Each cell receives a *scalar* drive replicated across d_model into x_in for
// that cell's slot, but mitosis_forward_tail takes a single shared x_in. To
// give per-cell structured drives we run the pool with a x_in built from the
// previous step's structured drive vector (mean of per-cell drives), AND we
// additively inject the per-cell drive into each cell's hidden before the
// forward tail — this is the causal-edge propagation.
fn _run_arm(arm_kind: string) {
    let d = _d_model()
    let n = _pool_n()
    let g = _gain()
    let mut pool = cell_pool_init(d, n)

    // prev per-cell output means (initialized to per-cell hidden means at t=0).
    let mut prev_means = _cell_hidden_means(pool, n)

    let mut phi_sum = 0.0
    let mut phi_count = 0
    let mut phi_final = 0.0

    let mut step = 0
    while step < _n_steps() {
        // Build per-cell drive from prev_means according to arm structure.
        let mut drive = _zero_vec(n)
        if arm_kind == "dag" {
            // drive[i] = g * prev_means[i-1]; drive[0] = 0 (source node).
            let mut i = 1
            while i < n {
                drive[i] = g * prev_means[i - 1]
                i = i + 1
            }
            drive[0] = 0.0
        } else {
            if arm_kind == "cyclic" {
                // drive[i] = g * prev_means[i-1]; drive[0] = g * prev_means[N-1].
                let mut i = 1
                while i < n {
                    drive[i] = g * prev_means[i - 1]
                    i = i + 1
                }
                drive[0] = g * prev_means[n - 1]
            } else {
                // undirected — drive[i] = g * mean(prev_means).
                let mb = g * _vec_mean_scalar(prev_means)
                let mut i = 0
                while i < n {
                    drive[i] = mb
                    i = i + 1
                }
            }
        }

        // Inject per-cell scalar drive into each cell's hidden[0] (causal-edge
        // propagation) BEFORE the forward tail. Only first n_fixed cells get a
        // structured drive; splits-grown cells beyond n inherit pool dynamics.
        let cs = pool["cells"]
        let nc = len(cs)
        let mut ci = 0
        while ci < nc {
            if ci < n {
                let h = pool["cells"][ci]["hidden"]
                if len(h) >= 1 {
                    pool["cells"][ci]["hidden"][0] = h[0] + drive[ci]
                }
            }
            ci = ci + 1
        }

        // Shared x_in for the forward tail = mean of structured drives (keeps
        // mitosis machinery driven; per-cell structure already injected above).
        let xs = _vec_mean_scalar(drive)
        let mut x = _zero_vec(d)
        let mut q = 0
        while q < d {
            x[q] = xs
            q = q + 1
        }

        let res = mitosis_forward_tail(x, pool, step)
        pool = res[1]

        // phi proxy snapshot.
        let phi = compute_phi_proxy(pool["cells"])
        phi_sum = phi_sum + phi
        phi_count = phi_count + 1
        phi_final = phi

        // Update prev_means from current per-cell hidden means.
        prev_means = _cell_hidden_means(pool, n)

        step = step + 1
    }

    let phi_mean = if phi_count > 0 { phi_sum / to_float(phi_count) } else { 0.0 }

    return #{
        "arm":        arm_kind,
        "phi_final":  phi_final,
        "phi_mean":   phi_mean,
        "n_cells":    len(pool["cells"]),
        "phi_count":  phi_count
    }
}


// ── main ─────────────────────────────────────────────────────────────────────

fn _run_h275() {
    println("================================================================")
    println("H_275 causality-pearl-graph-Φ — DAG vs cyclic vs undirected")
    println("                                 coupling on mitosis cell pool")
    println("  d_model=" + to_string(_d_model())
            + " pool_N=" + to_string(_pool_n())
            + " steps=" + to_string(_n_steps())
            + " gain=" + to_string(_gain())
            + " seed=" + to_string(_seed()))
    println("================================================================")

    // Canonical measurement runs (single deterministic pass per arm; RFC 033
    // single gauss stream advances monotonically, so repeating an arm
    // in-process draws *different* gaussians by construction — determinism is
    // verified cross-process via result.json sha256, see C3 below).
    let r_dag    = _run_arm("dag")
    let r_cyclic = _run_arm("cyclic")
    let r_undir  = _run_arm("undirected")

    let phi_dag    = r_dag["phi_final"]
    let phi_cyclic = r_cyclic["phi_final"]
    let phi_undir  = r_undir["phi_final"]

    println("arm         phi_final   phi_mean    n_cells")
    println("---------   ---------   ---------   -------")
    println("dag         " + to_string(phi_dag)
            + "   " + to_string(r_dag["phi_mean"])
            + "   " + to_string(r_dag["n_cells"]))
    println("cyclic      " + to_string(phi_cyclic)
            + "   " + to_string(r_cyclic["phi_mean"])
            + "   " + to_string(r_cyclic["n_cells"]))
    println("undirected  " + to_string(phi_undir)
            + "   " + to_string(r_undir["phi_mean"])
            + "   " + to_string(r_undir["n_cells"]))

    // ── criteria ──
    // C1: phi_final(DAG) > phi_final(cyclic) + margin.
    let c1 = (phi_dag - phi_cyclic) >= _margin()
    // C2: phi_final(DAG) >= phi_final(undirected)  (ordering preserved).
    let c2 = phi_dag >= phi_undir
    // C3: cross-process determinism. Compare the 3 phi_final triple against the
    //     prior run's result.json (if present). On the first run no prior file
    //     exists → c3 indeterminate (false); a second `hexa run` (cross-process)
    //     with the same seed reproduces byte-equal phi → c3 PASS. This is the
    //     raw#9 canonical determinism check for a single-stream RNG.
    let prior_path = _state_dir() + "/phi_triple.txt"
    let cur_triple = to_string(phi_dag) + "|" + to_string(phi_cyclic)
                     + "|" + to_string(phi_undir)
    let mut c3 = false
    if _file_exists(prior_path) {
        let prior = to_string(read_file(prior_path))
        c3 = (prior == cur_triple)
    }
    // Persist current triple for the next cross-process run to verify against.
    write_file(prior_path, cur_triple)

    // F-set (≥5 pre-registered).
    // F1 DAG-DOMINANCE  = C1.
    let f1 = c1
    // F2 ORDERING       = C2.
    let f2 = c2
    // F3 DETERMINISM    = C3 (cross-process byte-equal phi triple).
    let f3 = c3
    // F4 BOUNDS — all phi finite, >= 0.
    let f4 = (phi_dag >= 0.0) && (phi_cyclic >= 0.0) && (phi_undir >= 0.0)
             && (phi_dag < 1.0e30) && (phi_cyclic < 1.0e30) && (phi_undir < 1.0e30)
    // F5 NONDEGENERATE — at least one arm produced splits OR phi > 0
    //   (substrate actually evolved, not all-zero collapse).
    let f5 = (phi_dag > 0.0) || (phi_cyclic > 0.0) || (phi_undir > 0.0)

    let v1 = if f1 { "PASS" } else { "FAIL" }
    let v2 = if f2 { "PASS" } else { "FAIL" }
    let v3 = if f3 { "PASS" } else { "FAIL" }
    let v4 = if f4 { "PASS" } else { "FAIL" }
    let v5 = if f5 { "PASS" } else { "FAIL" }

    let mut n_pass = 0
    if f1 { n_pass = n_pass + 1 }
    if f2 { n_pass = n_pass + 1 }
    if f3 { n_pass = n_pass + 1 }
    if f4 { n_pass = n_pass + 1 }
    if f5 { n_pass = n_pass + 1 }

    let mut n_c = 0
    if c1 { n_c = n_c + 1 }
    if c2 { n_c = n_c + 1 }
    if c3 { n_c = n_c + 1 }

    // verdict_rule.
    let supported = c1 && c2 && c3
    let partial = c1
    let verdict = if supported {
        "SUPPORTED"
    } else {
        if partial {
            "PARTIAL"
        } else {
            "FALSIFIED"
        }
    }

    println("")
    println("derived:")
    println("  phi_dag    = " + to_string(phi_dag))
    println("  phi_cyclic = " + to_string(phi_cyclic))
    println("  phi_undir  = " + to_string(phi_undir))
    println("  dag - cyclic = " + to_string(phi_dag - phi_cyclic))
    println("  dag - undir  = " + to_string(phi_dag - phi_undir))

    println("")
    println("C1 DAG-DOMINANCE (phi_dag - phi_cyclic >= 0.05) : " + _bool_str(c1))
    println("C2 ORDERING      (phi_dag >= phi_undir)         : " + _bool_str(c2))
    println("C3 DETERMINISM   (cross-process phi-triple eq)  : " + _bool_str(c3))
    println("")
    println("F1 DAG-DOMINANCE                                 " + v1)
    println("F2 ORDERING                                      " + v2)
    println("F3 DETERMINISM                                   " + v3)
    println("F4 BOUNDS (phi finite >= 0)                      " + v4)
    println("F5 NONDEGENERATE (substrate evolved)             " + v5)
    println("================================================================")
    println("VERDICT: " + verdict
            + "  (" + to_string(n_c) + "/3 criteria, "
            + to_string(n_pass) + "/5 falsifiers PASS)")
    println("================================================================")

    // ── result.json ─────────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_275\",\n"
    j = j + "  \"slug\": \"causality-pearl-graph-phi\",\n"
    j = j + "  \"domain\": \"LIFE\",\n"
    j = j + "  \"title\": \"causality Pearl-graph Φ — directed acyclic (DAG) vs cyclic coupling on mitosis cell pool\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"seed\": " + to_string(_seed()) + ",\n"
    j = j + "  \"params\": {\"d_model\": " + to_string(_d_model())
          + ", \"pool_N\": " + to_string(_pool_n())
          + ", \"n_steps\": " + to_string(_n_steps())
          + ", \"gain\": " + to_string(_gain())
          + ", \"margin\": " + to_string(_margin()) + "},\n"
    j = j + "  \"arms\": {\n"
    j = j + "    \"dag\":        { \"phi_final\": " + to_string(phi_dag)
          + ", \"phi_mean\": " + to_string(r_dag["phi_mean"])
          + ", \"n_cells\": " + to_string(r_dag["n_cells"]) + " },\n"
    j = j + "    \"cyclic\":     { \"phi_final\": " + to_string(phi_cyclic)
          + ", \"phi_mean\": " + to_string(r_cyclic["phi_mean"])
          + ", \"n_cells\": " + to_string(r_cyclic["n_cells"]) + " },\n"
    j = j + "    \"undirected\": { \"phi_final\": " + to_string(phi_undir)
          + ", \"phi_mean\": " + to_string(r_undir["phi_mean"])
          + ", \"n_cells\": " + to_string(r_undir["n_cells"]) + " }\n"
    j = j + "  },\n"
    j = j + "  \"derived\": {\n"
    j = j + "    \"dag_minus_cyclic\": " + to_string(phi_dag - phi_cyclic) + ",\n"
    j = j + "    \"dag_minus_undir\":  " + to_string(phi_dag - phi_undir) + "\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_dag_dominance\": " + _bool_str(c1) + ",\n"
    j = j + "    \"C2_ordering\":      " + _bool_str(c2) + ",\n"
    j = j + "    \"C3_determinism\":   " + _bool_str(c3) + "\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_DAG_DOMINANCE\":  { \"metric\": \"phi_dag - phi_cyclic >= 0.05\", \"value\": " + to_string(phi_dag - phi_cyclic) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_ORDERING\":       { \"metric\": \"phi_dag >= phi_undir\", \"value\": " + to_string(phi_dag - phi_undir) + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_DETERMINISM\":    { \"metric\": \"cross-process phi-triple byte-equal (RFC 033 single stream, same seed)\", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_BOUNDS\":         { \"metric\": \"phi finite >= 0\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_NONDEGENERATE\":  { \"metric\": \"substrate evolved (phi>0)\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_criteria_pass\": " + to_string(n_c) + ",\n"
    j = j + "  \"n_falsifier_pass\": " + to_string(n_pass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": {\"H_218\": \"undirected BA/ER topology sister\", \"H_207\": \"Kuramoto coupling sister\", \"H_205\": \"closure sister\"}\n"
    j = j + "}\n"

    write_file(_state_dir() + "/result.json", j)
    println("ledger -> " + _state_dir() + "/result.json")
}


_run_h275()
