// H_1384 engine-native RELOCATION probe — compute the move-the-cells peak vs split-only ablation.
// Uses the LIVE engine cp_* ops only (cp_fit / cp_regrow / cp_relocate / cp_discrim_curve /
// cp_peak_loc_idx / cp_peak_count). Deterministic, $0 CPU, bounded (no decode). Prints the
// FROZEN bars B2 (relocation) + B3 (split-only distinctness) verbatim.
import "CORE/engine_cli.hexa"

fn _absf2(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn main() {
    let N = 21
    let DIM = 16
    let X = cp_stimuli(N, DIM)
    let mut pos = []
    let mut i = 0
    while i < N { pos = pos + [to_float(i) / to_float(N - 1)]  i = i + 1 }
    let pA  = 1.0 / 3.0
    let pAp = 2.0 / 3.0   // p_A'
    let YA  = cp_labels_boundary(pos, pA)
    let YAp = cp_labels_boundary(pos, pAp)

    // phase-1 carve on p_A (split-only Voronoi growth, the live engine)
    let cp1 = cp_fit(X, YA, 24, 24)
    let n_p1 = cp1.n

    // split-only re-growth (eta=0.0 ablation) — the engine's existing cp_regrow mechanism
    let cpSplit = cp_regrow(cp1, X, YAp, 24, 24)
    let cSplit  = cp_discrim_curve(cpSplit, X)
    let iSplit  = cp_peak_loc_idx(cSplit)
    let locSplit = (to_float(iSplit) + 0.5) / to_float(N - 1)
    // sanity: cp_relocate with eta=0.0 must equal cp_regrow byte-identically (same peak)
    let cpSplit0 = cp_relocate(cp1, X, pos, YAp, pAp, 0.0, n_p1, DIM, 24)
    let cSplit0  = cp_discrim_curve(cpSplit0, X)
    let iSplit0  = cp_peak_loc_idx(cSplit0)
    let locSplit0 = (to_float(iSplit0) + 0.5) / to_float(N - 1)

    // RELOCATION (eta=0.15) — move the cells
    let cpReloc = cp_relocate(cp1, X, pos, YAp, pAp, 0.15, n_p1, DIM, 24)
    let cReloc  = cp_discrim_curve(cpReloc, X)
    let iReloc  = cp_peak_loc_idx(cReloc)
    let locReloc = (to_float(iReloc) + 0.5) / to_float(N - 1)

    // non-gating eta ladder
    let cp10 = cp_relocate(cp1, X, pos, YAp, pAp, 0.10, n_p1, DIM, 24)
    let loc10 = (to_float(cp_peak_loc_idx(cp_discrim_curve(cp10, X))) + 0.5) / to_float(N - 1)
    let cp25 = cp_relocate(cp1, X, pos, YAp, pAp, 0.25, n_p1, DIM, 24)
    let loc25 = (to_float(cp_peak_loc_idx(cp_discrim_curve(cp25, X))) + 0.5) / to_float(N - 1)

    println("=== H_1384 ENGINE-NATIVE RELOCATION (move-the-cells) ===")
    println("N=" + to_string(N) + " DIM=" + to_string(DIM) + " p_A=0.333 p_A'=0.667 phase1_cells=" + to_string(n_p1))
    println("")
    println("split-only (cp_regrow, eta=0.0): peak=" + to_string(locSplit) + " |peak-p_A'|=" + to_string(_absf2(locSplit - pAp)) + " cells=" + to_string(cpSplit.n) + " pc=" + to_string(cp_peak_count(cSplit)))
    println("split-only (cp_relocate eta=0.0): peak=" + to_string(locSplit0) + " (must == cp_regrow peak " + to_string(locSplit) + ")")
    println("RELOCATE   (cp_relocate eta=0.15): peak=" + to_string(locReloc) + " |peak-p_A'|=" + to_string(_absf2(locReloc - pAp)) + " cells=" + to_string(cpReloc.n) + " pc=" + to_string(cp_peak_count(cReloc)))
    println("  eta ladder (non-gating): eta=0.10 peak=" + to_string(loc10) + " | eta=0.25 peak=" + to_string(loc25))
    println("")
    let b2 = _absf2(locReloc - pAp) <= 0.12
    let b3 = _absf2(locSplit - pAp) > 0.12
    let b0 = locSplit0 == locSplit
    println("B2 RELOCATION |peak_reloc-p_A'| <= 0.12 : " + (if b2 { "PASS" } else { "FAIL" }))
    println("B3 DISTINCT split-only |peak-p_A'| > 0.12 : " + (if b3 { "PASS" } else { "FAIL" }))
    println("eta=0 == cp_regrow (byte sanity): " + (if b0 { "PASS" } else { "FAIL" }))
}
