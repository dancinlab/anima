// @canonical-ok task-specified slug "1591_g4_g6_gate_fix" (G4/G6 gate measurement fix)
// g4_g6_parity_fixture.hexa — byte-parity oracle for the G4+G6 measurement fixes
// (a_engine_native_learning 2-production lockstep). Drives the LIVE core/g_gates.hexa ops on a
// fixed tiny .clm fixture; the py twin (g4_g6_parity_fixture.py) drives core/g_gates.py with the
// IDENTICAL ckpt/seed/gen. The metric is a deterministic function of the decode text, so identical
// ideate text => identical counts (cross-language parity). Three checks, mirrored:
//   (A) G6 SEEDED  g_eval_g6_seeded(ck, gen, known, 7) — dist/fals/coherent
//   (B) G6 MULTI   g_eval_g6_multiseed — n_green / max_fals
//   (C) G4 PROV    g_eval_g4(ck, false) — sha256 / bytes / mouth / provenance_ok
import "core/g_gates.hexa"

fn main() {
    let ck  = exec("printf %s \"$FX_CK\"")
    let gen = to_int(exec("printf %s \"$FX_GEN\""))
    let known = _g6_dict_load()

    // (A) G6 seeded (base_seed=7 == old inline path frame-for-frame)
    let g6 = g_eval_g6_seeded(ck, gen, known, 7)
    println("g6_seed7.dist:" + to_string(g6["dist"]))
    println("g6_seed7.fals:" + to_string(g6["fals"]))
    println("g6_seed7.coherent:" + to_string(g6["coherent"]))

    // (B) G6 multi-seed {7,4302,4303}
    let ms = g_eval_g6_multiseed(ck, gen, known)
    println("g6_ms.pass:" + to_string(ms["pass"]))
    println("g6_ms.n_green:" + to_string(ms["n_green"]))
    println("g6_ms.max_fals:" + to_string(ms["max_fals"]))

    // (C) G4 provenance (closure=false here; pub_eligible just echoes it)
    let g4 = g_eval_g4(ck, false)
    println("g4.sha256:" + to_string(g4["sha256"]))
    println("g4.bytes:" + to_string(g4["bytes"]))
    println("g4.mouth:" + to_string(g4["mouth"]))
    println("g4.decodable:" + to_string(g4["decodable"]))
    println("g4.provenance_ok:" + to_string(g4["provenance_ok"]))
}
