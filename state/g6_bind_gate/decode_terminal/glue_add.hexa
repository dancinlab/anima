
// H_6186 decode-terminal per-frame glue (additive): expose frozen scoring predicates
pub fn g6_kwr_pub(text: string, known: Map) -> float { return _g6_known_word_ratio(text, known) }
pub fn g6_falstb_pub(text: string, a: int, b: int, known: Map) -> bool { return _g6_is_falsifiable_topic_bound(text, a, b, known) }
