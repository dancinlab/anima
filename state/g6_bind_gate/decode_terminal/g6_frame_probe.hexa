// g6_frame_probe — H_6186 decode-axis engine-native, ONE FRAME per process.
// Process-isolation wall-break for the gen_auto_ideate per-candidate GPU-mem leak (h9107):
// fals_bound is FRAME-INDEPENDENT (cross-frame jaccard only affects `dist`, not fals_bound),
// so each frame's bound-contribution is computed in a SEPARATE process (k=3 decodes ~8GB) that
// EXITS to free the GPU. Decode + per-frame scoring are UNCHANGED engine-native CORE ops:
//   o = g6_decode_best_of_k_auto(...)               [pub CORE op, ByteGPT best-of-k]
//   fb = kwr(o)>=0.5 && is_falsifiable_topic_bound(o,a,b,known)   [frozen predicates via pub glue]
// This is byte-identical to g6_score_arm_auto_bound's per-frame fals_bound term (same base_seed+i,
// same k=3 offsets, same predicates). External step = sum 6 frame fb's per (arm,seed) = arithmetic
// only (NOT scoring). Glue g6_kwr_pub/g6_falstb_pub/g6_dict_load_pub additive; frozen untouched.
// args: <ckpt> <arm> <seed> <frame_idx>
import "core/g6_ideation.hexa"

fn main() {
    let raw = args()
    let mut start = 1
    let mut k = 0
    while k < len(raw) { if raw[k] == "--" { start = k + 1 } k = k + 1 }
    let ckpt = to_string(raw[start])
    let arm = to_string(raw[start + 1])
    let s = to_int(raw[start + 2])
    let fi = to_int(raw[start + 3])

    let known = g6_dict_load_pub()
    let frames = g6_build_frames(6)["composed"]
    let pairs = g6_build_frame_pairs(6)
    let gen = 80
    let kk = 3
    let f = to_string(frames[fi])
    let pr = pairs[fi]
    let a = to_int(pr[0]); let b = to_int(pr[1])
    // base_seed + i offset EXACTLY as g6_score_arm_auto_bound (base_seed + frame index)
    let o = g6_decode_best_of_k_auto(ckpt, f, gen, kk, s + fi, known)
    let kwr = g6_kwr_pub(o, known)
    let mut fb = 0
    let mut fal = 0
    if kwr >= 0.5 {
        if g6_falstb_pub(o, a, b, known) { fb = 1 }
    }
    // also report frozen `fals` (kwr>=0.5 && is_falsifiable) for cross-check
    println("FRAMEBOUND arm=" + arm + " seed=" + to_string(s) + " frame=" + to_string(fi)
        + " a=" + to_string(a) + " b=" + to_string(b)
        + " kwr=" + to_string(kwr) + " fb=" + to_string(fb))
    println("=== DONE " + arm + " " + to_string(s) + " " + to_string(fi) + " ===")
}
