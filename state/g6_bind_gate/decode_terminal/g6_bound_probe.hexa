// g6_bound_probe — H_6186 decode-axis engine-native driver (NOT committed; aiden-local).
// Runs the LIVE origin/main CORE bind twin g6_score_arm_auto_bound (best-of-K bytegpt via
// gen_auto_ideate → generator L3 → bytegpt decode) over 3 seeds {7,4302,4303}, gen=80, k=3,
// temp0.7/top_k40 (as hardcoded in g6_decode_best_of_k_auto). Emits fals + fals_bound per seed.
// Scoring/decode = unmodified core ops. Only glue: g6_dict_load_pub() exposes the existing
// private _g6_dict_load (frozen _g6_is_falsifiable / g6_score_arm_auto_W untouched).
import "core/g6_ideation.hexa"

fn main() {
    let raw = args()
    let mut start = 1
    let mut k = 0
    while k < len(raw) { if raw[k] == "--" { start = k + 1 } k = k + 1 }
    let ckpt = to_string(raw[start])
    let arm = to_string(raw[start + 1])

    let known = g6_dict_load_pub()
    let frames = g6_build_frames(6)["composed"]
    let pairs = g6_build_frame_pairs(6)
    let seeds = [7, 4302, 4303]
    let gen = 80
    let kk = 3
    println("=== G6-BIND ENGINE-NATIVE DECODE arm=" + arm + " ckpt=" + ckpt + " ===")
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let r = g6_score_arm_auto_bound(ckpt, frames, pairs, gen, kk, s, true, known)
        println("RESULT arm=" + arm + " seed=" + to_string(s)
            + " fals=" + to_string(r["fals"])
            + " fals_bound=" + to_string(r["fals_bound"])
            + " dist=" + to_string(r["dist"])
            + " coherent=" + to_string(r["coherent"]))
        si = si + 1
    }
    println("=== DONE arm=" + arm + " ===")
}
