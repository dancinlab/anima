import "core/g6_ideation.hexa"
fn main() {
    let ckpt = "state/g6-retro303m-fals/retro303m.clm"
    let known = _g6_dict_load()
    let gen = to_int(env_var("G6_GEN"))
    let f = "if consciousness arises from cells, then memory composes into new meaning: "
    let t0 = now_ms()
    let r = gen_clm_ideate(ckpt, f, gen, 40, 0.7, 7)
    let o = to_string(r["text"])
    let kwr = _g6_known_word_ratio(o, known)
    let mut isf = false
    if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
    println("SINGLE gen=" + to_string(gen) + " fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0))
    println("TEXT :: " + o)
    println("SINGLE_DONE")
}
