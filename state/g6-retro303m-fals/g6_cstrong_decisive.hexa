import "CORE/g6_ideation.hexa"

// H_1390 DECISIVE — the C_strong arm (M1 COUNT + M2 DEPTH) on the 303M ConvMoE-RETRO trunk,
// engine-native, bounded GEN=48 (falsifiable marks comparator+measurable appear in the first
// ~30 bytes per the H_1362 example "byte-LEVEL ... SLOWER", so GEN=48 captures FALS while
// cutting wall ~2.3x vs GEN=110). B_composed (M3) follows. Detector/scaffold VERBATIM frozen.
// Prints per-frame (harvestable on inline poll, a_cpu_local_no_waiter, no Monitor).
fn main() {
    let ckpt = "state/g6-retro303m-fals/retro303m.clm"
    let known = _g6_dict_load()
    println("CKPT=" + ckpt)
    println("DETECTOR_CALIBRATION=" + to_string(g6_detector_calibration(known)) + "/10")
    let fr = g6_build_frames(6)
    let comp = fr["composed"]
    println("FRAME_GUARD_LEAKS=" + to_string(len(g6_frame_guard(comp, known))))
    let st = g6_sampler_selftest()
    println("SAMPLER det=" + to_string(st["deterministic"]) + " diverse=" + to_string(st["diverse"]) + " in_topk=" + to_string(st["in_topk"]))

    let GEN = 48
    let SEED = 7
    println("=== ARM C_strong (6 frames x K=3, GEN=48, seed=7) ===")
    let mut fals_c = 0
    let csets = []
    let mut i = 0
    while i < len(comp) {
        let t0 = now_ms()
        let o = g6_decode_best_of_k(ckpt, to_string(comp[i]), GEN, 3, SEED, known)
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if kwr >= 0.5 { csets.push(_g6_words(o)) }
        if isf { fals_c = fals_c + 1 }
        println("C_strong[" + to_string(i) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        i = i + 1
    }
    let kept = []
    let mut w = 0
    while w < len(csets) {
        let ws = csets[w]; let mut ok = true; let mut kk = 0
        while kk < len(kept) { if _g6_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    println("C_strong DIST=" + to_string(len(kept)) + " FALS=" + to_string(fals_c) + " coh=" + to_string(len(csets)) + "/6")
    println("M1_COUNT(DIST>=5)=" + to_string(len(kept) >= 5))
    println("M2_DEPTH(FALS>=1)=" + to_string(fals_c >= 1))

    // B_composed (M3 LIFT) — 5 frames single-sample
    println("=== ARM B_composed (5 frames K=1, GEN=48, seed=7) ===")
    let bfr = g6_build_frames(5)
    let bcomp = bfr["composed"]
    let mut fals_b = 0
    let mut bi = 0
    while bi < len(bcomp) {
        let t0 = now_ms()
        let r = gen_clm_ideate(ckpt, to_string(bcomp[bi]), GEN, 40, 0.7, SEED)
        let o = to_string(r["text"])
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_b = fals_b + 1 }
        println("B[" + to_string(bi) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        bi = bi + 1
    }
    println("B_composed FALS=" + to_string(fals_b))
    println("M3_LIFT(FALS_C>FALS_B)=" + to_string(fals_c > fals_b))
    println("CSTRONG_DONE fals_c=" + to_string(fals_c) + " dist=" + to_string(len(kept)) + " fals_b=" + to_string(fals_b))
}
