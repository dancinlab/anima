import "core/g6_ideation.hexa"

// H_1390 — ONE frame (best-of-K=3) per fresh process: works around the sustained-decode
// instability (chained decodes die silently ~2min; a single decode is stable RC=0). arg = frame
// index 0..5. Prints the frame result; a driver runs 6 fresh procs sequentially + aggregates.
fn main() {
    let fi = to_int(env_var("G6_FI"))        // frame index 0..5
    let arm = env_var("G6_ARM")              // "composed" | "shuffled" | "ablated"
    let gen = to_int(env_var("G6_GEN"))      // GEN budget
    let ckpt = "state/g6-retro303m-fals/retro303m.clm"
    let known = _g6_dict_load()
    let fr = g6_build_frames(6)
    let frames = fr[arm]
    let f = to_string(frames[fi])
    let t0 = now_ms()
    let o = g6_decode_best_of_k(ckpt, f, gen, 3, 7, known)
    let kwr = _g6_known_word_ratio(o, known)
    let mut isf = false
    if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
    println("FRAME arm=" + arm + " idx=" + to_string(fi) + " gen=" + to_string(gen) + " fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0))
    println("TEXT :: " + o)
    println("FRAME_DONE")
}
