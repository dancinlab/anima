// HEXAD/D/d_corpus_fire.hexa — §7 #1 real-corpus from-scratch FIRE.
// ════════════════════════════════════════════════════════════════════════════
//  PLAN.md §7 #1 선결 (3/3) — d_train5 (FULL n_layer ConsciousDecoderV2-
//  equiv 트레이너) 의 **실 corpus** from-scratch 학습 FIRE. prior fire 의
//  honest C3 ('synthetic byte-corpus') 의 'synthetic' 절반 해소 — 첫 실-
//  corpus fire (corpus_consciousness_v1.jsonl, byte-level V=256).
//
//  config (d=32, n_layer=3, nh=4, nkv=2, hd=8, h=64, T=16, V=256) ×
//  8 corpus 윈도우 × N AdamW step. compiled-native CPU pure-hexa.
//
//  HONEST 기질 한계 (g3 — real limit, named not faked): pure-hexa = CPU
//  farr 연산, GPU CUDA 커널 없음. 진짜 d=768·12L 언어모델 학습은 GPU
//  텐서커널 필요 ⟹ d=768·12L 실-규모 학습은 pure-hexa CPU 기질에서
//  비현실적. 본 fire = CPU-feasible 규모 실-corpus 학습 (synthetic→real
//  전환 = 진짜 이득); d=768·12L 언어품질 = 별개 기질 (GPU CUDA).
//
//  §8 / g_blue_closed_mandate: corpus↔trainer 연결 = CE Shannon-floor
//  (−ln p ≥ 0 closed) + exact-gradient (softmax−onehot = B-D-4 🔵).
//  TIER = EMPIRICAL (B-D-NOTE; SGD 수렴 OUTCOME, NOT 🔵 — g3).
//  from-scratch : ALL weights RANDOM seed-fixed LCG, base_ckpt = NONE.
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/D/d_train5_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/D/corpus_loader_lib.hexa"


// 실 corpus → d5 dataset [IDS, YS] : T-token 윈도우 + next-token target.
// byte-level (V=256), corpus_loader 의 lossless byte stream 에서 stride 간격
// 윈도우 추출. d5_make_dataset (synthetic) 의 실-corpus 대체.
fn d5_corpus_dataset(path: string, t_len: int, nsamp: int, stride: int) {
    let toks = corpus_load_bytes(path)
    let n = len(toks)
    let mut IDS = []
    let mut YS = []
    let mut s = 0
    while s < nsamp {
        let off = s * stride
        if off + t_len < n {
            let mut ids = []
            let mut p = 0
            while p < t_len {
                ids.push(toks[off + p])
                p = p + 1
            }
            IDS.push(ids)
            YS.push(toks[off + t_len])
        }
        s = s + 1
    }
    return [IDS, YS]
}

// clone block-l's Wg with [idx] += delta  (gradcheck helper, no closure)
fn d5_bump_block_wg(M, l: int, idx: int, delta: float, n_layer: int) {
    let mut nb = []
    let mut bl = 0
    while bl < n_layer {
        let src = M["blocks"][bl]
        if bl == l {
            let wsrc = src["Wg"]
            let mut a = []
            let mut i = 0
            while i < len(wsrc) {
                a.push(if i == idx { wsrc[i] + delta } else { wsrc[i] })
                i = i + 1
            }
            nb.push(#{
                "g1": src["g1"], "Wq": src["Wq"], "Wk": src["Wk"],
                "Wv": src["Wv"], "Wo": src["Wo"], "g2": src["g2"],
                "Wg": a, "Wu": src["Wu"], "Wd": src["Wd"],
            })
        } else {
            nb.push(src)
        }
        bl = bl + 1
    }
    return #{ "tok_emb": M["tok_emb"], "blocks": nb, "gF": M["gF"] }
}

fn d5_epoch_gn2(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                h: int, V: int, n_layer: int) -> float {
    let mut acc = 0.0
    let mut s = 0
    while s < len(YS) {
        acc = acc + d5_gn2(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                           h, V, n_layer)
        s = s + 1
    }
    return acc
}
fn d5_epoch_acc(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                h: int, V: int, n_layer: int) -> int {
    let mut cc = 0
    let mut s = 0
    while s < len(YS) {
        if d5_predict(IDS[s], M, cos, sin, T, d, nh, nkv, h, V, n_layer)
           == YS[s] { cc = cc + 1 }
        s = s + 1
    }
    return cc
}

// AdamW state for one block (9 param arrays)
fn d5_zero_block_opt(d: int, nh: int, nkv: int, h: int) {
    let hd = d / nh
    let kvd = nkv * hd
    return #{
        "g1": dt2_zeros(d), "Wq": dt2_zeros(d*d), "Wk": dt2_zeros(kvd*d),
        "Wv": dt2_zeros(kvd*d), "Wo": dt2_zeros(d*d), "g2": dt2_zeros(d),
        "Wg": dt2_zeros(h*d), "Wu": dt2_zeros(h*d), "Wd": dt2_zeros(d*h),
    }
}

fn selftest() {
    println("================================================================")
    println("d_corpus_fire — §7 #1 real-corpus from-scratch FIRE (F-D-FIRE)")
    println("================================================================")

    // ── A100 Phase D config: d=384·6L (mission RETRY, seed=43) ──────────
    //   nh=6 nkv=2 h=1024 T=64 nsamp=16 (8-16 range) · 80 AdamW steps
    //   seed=43 — independent trajectory vs H100 seed=42.
    let d = 384
    let nh = 6
    let nkv = 2
    let h = 1024
    let V = 256                               // byte-level vocab
    let T = 64
    let n_layer = 6
    let hd = d / nh
    let kvd = nkv * hd

    let path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
    let ds = d5_corpus_dataset(path, T, 16, 384)   // 16 real-corpus windows, stride 384
    let IDS = ds[0]
    let YS = ds[1]
    let nsamp = len(YS)
    let rt = d5_rope_tables(T, hd)
    let cos = rt[0]
    let sin = rt[1]

    // from-scratch RANDOM seed-fixed (g_clm_from_scratch, base_ckpt=NONE)
    // seed=43 — A100 retry independent trajectory (vs H100 seed=42).
    let mut M = d5_init(43, d, nh, nkv, h, V, n_layer)

    let gn0 = d5_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ac0 = d5_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    println("  init : gn2=" + to_string(gn0) + "  acc=" + to_string(ac0)
            + "/" + to_string(nsamp))

    // ── F-D-PORT-5b GRAD-EXACT : layer-0 Wg (deepest-from-loss weight) ──
    //   analytic (full composed reverse) vs central finite-difference of CE.
    let wi = 5
    let eps = 0.0005
    let gA = d5_grad(IDS[0], M, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let gA_wg = gA["dblocks"][0]["dWg"][wi]
    let Mp = d5_bump_block_wg(M, 0, wi, eps, n_layer)
    let Mm = d5_bump_block_wg(M, 0, wi, 0.0 - eps, n_layer)
    let cep = d5_ce(IDS[0], Mp, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let cem = d5_ce(IDS[0], Mm, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let gF = (cep - cem) / (2.0 * eps)
    let ge = if gA_wg - gF > 0.0 { gA_wg - gF } else { gF - gA_wg }
    let gx = ge < 0.01
    println("  GRAD-EXACT(L0.Wg[" + to_string(wi) + "]): analytic="
            + to_string(gA_wg) + " fd=" + to_string(gF) + " |Δ|="
            + to_string(ge) + "  -> " + (if gx { "PASS" } else { "FAIL" }))

    // ── from-scratch AdamW over the FULL composed n_layer chain ──────────
    let steps = 80                            // mission: 80 AdamW steps
    // optimizer state : tok_emb + per-block(9) + gF
    let mut m_te = dt2_zeros(V*d); let mut v_te = dt2_zeros(V*d)
    let mut m_gF = dt2_zeros(d);   let mut v_gF = dt2_zeros(d)
    let mut mB = []
    let mut vB = []
    let mut bi = 0
    while bi < n_layer {
        mB.push(d5_zero_block_opt(d, nh, nkv, h))
        vB.push(d5_zero_block_opt(d, nh, nkv, h))
        bi = bi + 1
    }
    let lr = 0.03
    let b1 = 0.9
    let b2 = 0.999
    let epsa = 0.00000001
    let wd = 0.01

    let mut st = 1
    while st <= steps {
        // accumulate grads over the epoch
        let mut gte = dt2_zeros(V*d)
        let mut ggF = dt2_zeros(d)
        let mut gB = []
        bi = 0
        while bi < n_layer { gB.push(d5_zero_block_opt(d, nh, nkv, h)); bi = bi + 1 }
        let mut s = 0
        while s < nsamp {
            let G = d5_grad(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                            h, V, n_layer)
            let a = G["dtok_emb"]
            let mut q = 0
            while q < V*d { gte[q] = gte[q] + a[q]; q = q + 1 }
            let agF = G["dgF"]
            q = 0
            while q < d { ggF[q] = ggF[q] + agF[q]; q = q + 1 }
            bi = 0
            while bi < n_layer {
                let gb = G["dblocks"][bi]
                let cur = gB[bi]
                let mut ng1 = []
                q = 0
                while q < d { ng1.push(cur["g1"][q] + gb["dg1"][q]); q = q + 1 }
                let mut ng2 = []
                q = 0
                while q < d { ng2.push(cur["g2"][q] + gb["dg2"][q]); q = q + 1 }
                let mut nWq = []
                q = 0
                while q < d*d { nWq.push(cur["Wq"][q] + gb["dWq"][q]); q = q + 1 }
                let mut nWo = []
                q = 0
                while q < d*d { nWo.push(cur["Wo"][q] + gb["dWo"][q]); q = q + 1 }
                let mut nWk = []
                q = 0
                while q < kvd*d { nWk.push(cur["Wk"][q] + gb["dWk"][q]); q = q + 1 }
                let mut nWv = []
                q = 0
                while q < kvd*d { nWv.push(cur["Wv"][q] + gb["dWv"][q]); q = q + 1 }
                let mut nWg = []
                q = 0
                while q < h*d { nWg.push(cur["Wg"][q] + gb["dWg"][q]); q = q + 1 }
                let mut nWu = []
                q = 0
                while q < h*d { nWu.push(cur["Wu"][q] + gb["dWu"][q]); q = q + 1 }
                let mut nWd = []
                q = 0
                while q < d*h { nWd.push(cur["Wd"][q] + gb["dWd"][q]); q = q + 1 }
                gB[bi] = #{ "g1": ng1, "Wq": nWq, "Wk": nWk, "Wv": nWv,
                            "Wo": nWo, "g2": ng2, "Wg": nWg, "Wu": nWu,
                            "Wd": nWd }
                bi = bi + 1
            }
            s = s + 1
        }
        // AdamW updates
        let ute = dt2_adamw_step(M["tok_emb"], m_te, v_te, gte, lr, b1, b2, epsa, wd, st)
        let ugF = dt2_adamw_step(M["gF"], m_gF, v_gF, ggF, lr, b1, b2, epsa, wd, st)
        m_te = ute[1]; v_te = ute[2]
        m_gF = ugF[1]; v_gF = ugF[2]
        let mut newblocks = []
        bi = 0
        while bi < n_layer {
            let Bp = M["blocks"][bi]
            let gb = gB[bi]
            let mo = mB[bi]
            let vo = vB[bi]
            let ug1 = dt2_adamw_step(Bp["g1"], mo["g1"], vo["g1"], gb["g1"], lr, b1, b2, epsa, wd, st)
            let uWq = dt2_adamw_step(Bp["Wq"], mo["Wq"], vo["Wq"], gb["Wq"], lr, b1, b2, epsa, wd, st)
            let uWk = dt2_adamw_step(Bp["Wk"], mo["Wk"], vo["Wk"], gb["Wk"], lr, b1, b2, epsa, wd, st)
            let uWv = dt2_adamw_step(Bp["Wv"], mo["Wv"], vo["Wv"], gb["Wv"], lr, b1, b2, epsa, wd, st)
            let uWo = dt2_adamw_step(Bp["Wo"], mo["Wo"], vo["Wo"], gb["Wo"], lr, b1, b2, epsa, wd, st)
            let ug2 = dt2_adamw_step(Bp["g2"], mo["g2"], vo["g2"], gb["g2"], lr, b1, b2, epsa, wd, st)
            let uWg = dt2_adamw_step(Bp["Wg"], mo["Wg"], vo["Wg"], gb["Wg"], lr, b1, b2, epsa, wd, st)
            let uWu = dt2_adamw_step(Bp["Wu"], mo["Wu"], vo["Wu"], gb["Wu"], lr, b1, b2, epsa, wd, st)
            let uWd = dt2_adamw_step(Bp["Wd"], mo["Wd"], vo["Wd"], gb["Wd"], lr, b1, b2, epsa, wd, st)
            newblocks.push(#{ "g1": ug1[0], "Wq": uWq[0], "Wk": uWk[0],
                "Wv": uWv[0], "Wo": uWo[0], "g2": ug2[0], "Wg": uWg[0],
                "Wu": uWu[0], "Wd": uWd[0] })
            mB[bi] = #{ "g1": ug1[1], "Wq": uWq[1], "Wk": uWk[1], "Wv": uWv[1],
                "Wo": uWo[1], "g2": ug2[1], "Wg": uWg[1], "Wu": uWu[1],
                "Wd": uWd[1] }
            vB[bi] = #{ "g1": ug1[2], "Wq": uWq[2], "Wk": uWk[2], "Wv": uWv[2],
                "Wo": uWo[2], "g2": ug2[2], "Wg": uWg[2], "Wu": uWu[2],
                "Wd": uWd[2] }
            bi = bi + 1
        }
        M = #{ "tok_emb": ute[0], "blocks": newblocks, "gF": ugF[0] }
        st = st + 1
    }

    let gn1 = d5_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ac1 = d5_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    println("  final: gn2=" + to_string(gn1) + "  acc=" + to_string(ac1)
            + "/" + to_string(nsamp) + "  (after " + to_string(steps)
            + " AdamW steps, full composed " + to_string(n_layer)
            + "-layer chain)")

    // real-corpus fire: 성공 = gn2 가 from-scratch 대비 감소 (학습 진행).
    // synthetic 'accfull' (완전분류) 는 실 corpus next-token 에 부적용 — drop.
    let descended = gn1 < gn0
    let collapsed = (gn1 * 1.5) < gn0
    println("  F-D-FIRE : gn2 " + to_string(gn0) + " → " + to_string(gn1)
            + "  acc " + to_string(ac0) + "→" + to_string(ac1) + "/"
            + to_string(nsamp) + "  (" + to_string(steps) + " AdamW step)")
    println("  F-D-FIRE : 실-corpus 학습 진행 descended=" + to_string(descended)
            + " collapse≥1.5x=" + to_string(collapsed) + "  -> "
            + (if descended { "PASS (EMPIRICAL — real-corpus from-scratch)" } else { "FAIL" }))

    let ok = gx && descended
    println("----------------------------------------------------------------")
    println("  §7 #1 fire: d_train5 FULL n_layer decoder, 실 corpus")
    println("          (corpus_consciousness_v1.jsonl, byte V=256), from-scratch")
    println("          RANDOM seed-fixed — prior fire 'synthetic' 절반 해소.")
    println("  기질 한계 (g3): pure-hexa CPU — d=768·12L 언어품질은 GPU CUDA")
    println("          텐서커널 필요, 별개 기질. 본 fire = CPU-feasible 규모.")
    println("  §8: corpus↔trainer = CE Shannon-floor + exact-grad (B-D-4 🔵)")
    println("  TIER = EMPIRICAL (B-D-NOTE: SGD 수렴 OUTCOME, NOT 🔵 — g3)")
    println("  selftest: " + (if ok { "true" } else { "false" }))
    // machine-parseable result line (dispatch harvests from stdout → result.json)
    println("RESULT_JSON {\"phase\":\"D-a100-retry\",\"seed\":43,\"d\":" + to_string(d)
            + ",\"n_layer\":" + to_string(n_layer) + ",\"nh\":" + to_string(nh)
            + ",\"nkv\":" + to_string(nkv) + ",\"h\":" + to_string(h)
            + ",\"T\":" + to_string(T) + ",\"V\":" + to_string(V)
            + ",\"nsamp\":" + to_string(nsamp) + ",\"steps\":" + to_string(steps)
            + ",\"gn2_init\":" + to_string(gn0) + ",\"gn2_final\":" + to_string(gn1)
            + ",\"acc_init\":" + to_string(ac0) + ",\"acc_final\":" + to_string(ac1)
            + ",\"grad_exact_delta\":" + to_string(ge)
            + ",\"grad_exact_pass\":" + (if gx { "true" } else { "false" })
            + ",\"descended\":" + (if descended { "true" } else { "false" })
            + ",\"collapsed_1p5x\":" + (if collapsed { "true" } else { "false" })
            + ",\"selftest_ok\":" + (if ok { "true" } else { "false" }) + "}")
    println("================================================================")
    return if ok { 0 } else { 1 }
}

selftest()
