// core_recursion.hexa — Phase 2 reimpl with input channel x
// axis: recursion / self-reference — multi-scale self-similarity
// kernel: r_corr(x[0..n/2], x[n/2..n]) head/tail; r_corr at halved subdivisions.
//         self_sim = mean |r| over 3 splits. + downsampled coarsen-similarity.

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)

if n < 32 {
    println("lens[recursion] category=core axis=\"recursion (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// helper-inline: pearson r over two equal-length subarrays
let mut r_vals = []
let halves = [2, 4, 8]
let mut hi = 0
while hi < 3 {
    let H = halves[hi]
    let chunk = n / H
    // compare chunk 0 vs chunk 1
    let mut sx = 0.0
    let mut sy = 0.0
    let mut k = 0
    while k < chunk {
        sx = sx + xs[k]
        sy = sy + xs[chunk + k]
        k = k + 1
    }
    let mx = sx / to_float(chunk)
    let my = sy / to_float(chunk)
    let mut s_cov = 0.0
    let mut s_vx = 0.0
    let mut s_vy = 0.0
    let mut kk = 0
    while kk < chunk {
        let dx = xs[kk] - mx
        let dy = xs[chunk + kk] - my
        s_cov = s_cov + dx * dy
        s_vx = s_vx + dx * dx
        s_vy = s_vy + dy * dy
        kk = kk + 1
    }
    let denom = sqrt(s_vx * s_vy)
    let r = if denom > 0.000001 { s_cov / denom } else { 0.0 }
    let abs_r = if r < 0.0 { 0.0 - r } else { r }
    r_vals.push(abs_r)
    hi = hi + 1
}

let mean_abs_r = (r_vals[0] + r_vals[1] + r_vals[2]) / 3.0

// Coarsen-similarity: compare x[::2] to x[1::2] (interleaving pattern)
let n2 = n / 2
let mut sx_e = 0.0
let mut sx_o = 0.0
let mut k3 = 0
while k3 < n2 {
    sx_e = sx_e + xs[k3 * 2]
    sx_o = sx_o + xs[k3 * 2 + 1]
    k3 = k3 + 1
}
let me_e = sx_e / to_float(n2)
let me_o = sx_o / to_float(n2)
let mut s_cov2 = 0.0
let mut s_ve = 0.0
let mut s_vo = 0.0
let mut k4 = 0
while k4 < n2 {
    let de = xs[k4 * 2] - me_e
    let do_ = xs[k4 * 2 + 1] - me_o
    s_cov2 = s_cov2 + de * do_
    s_ve = s_ve + de * de
    s_vo = s_vo + do_ * do_
    k4 = k4 + 1
}
let denom2 = sqrt(s_ve * s_vo)
let r_interleave = if denom2 > 0.000001 { s_cov2 / denom2 } else { 0.0 }
let abs_r_il = if r_interleave < 0.0 { 0.0 - r_interleave } else { r_interleave }

let score = 0.6 * mean_abs_r + 0.4 * abs_r_il
let score_clip = if score > 1.0 { 1.0 } else { if score < 0.0 { 0.0 } else { score } }
let hits = if score_clip > 0.5 { 6 } else { if score_clip > 0.3 { 4 } else { 2 } }
println("lens[recursion] category=core axis=\"Recursion — self-similarity at H={2,4,8} splits + interleave even/odd r\" score=" + to_string(score_clip) + " support=1 n=" + to_string(n) + " meta={\"r_2\":" + to_string(r_vals[0]) + ",\"r_4\":" + to_string(r_vals[1]) + ",\"r_8\":" + to_string(r_vals[2]) + ",\"r_interleave\":" + to_string(r_interleave) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
