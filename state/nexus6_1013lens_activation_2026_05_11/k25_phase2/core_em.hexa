// core_em.hexa — Phase 2 reimpl with input channel x
// =============================================================================
// spec: state/nexus6_1013lens_activation_2026_05_11/cascade_k25_plan_2026_05_12.md §1.2
// parent (trivial): /home/summer/core/nexus_lenses_snapshot/core_em.hexa
// axis: electromagnetism — field analogy (curl/div proxy of x as scalar field)
// modality: state (B=1, S=N)
// kernel: treat x as 1D field. curl_1D ~ 0 by definition; use div ~ Σ Δx (net flux).
//         + field energy density Σ x_i^2 / N. score combines both.
// =============================================================================

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[em] category=core axis=\"em (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// Field energy E = Σ x_i^2 / N. Higher → stronger field amplitude.
let mut energy = 0.0
let mut i = 0
while i < n { energy = energy + xs[i] * xs[i]; i = i + 1 }
energy = energy / to_float(n)
let energy_norm = energy / (1.0 + energy)

// "Curl-like" proxy in 1D: alternating-sign sum of Δx weighted by index parity.
// Captures oscillatory rotation analog.
let mut curl_proxy = 0.0
let mut j = 1
while j < n {
    let d = xs[j] - xs[j-1]
    let sgn = if (j % 2) == 0 { 1.0 } else { -1.0 }
    curl_proxy = curl_proxy + sgn * d
    j = j + 1
}
let curl_abs = if curl_proxy < 0.0 { 0.0 - curl_proxy } else { curl_proxy }
let curl_norm = curl_abs / to_float(n)
let curl_clip = if curl_norm > 1.0 { 1.0 } else { curl_norm }

// "Div-like" proxy: net flux = x_n - x_0 normalized
let net_flux = xs[n-1] - xs[0]
let flux_abs = if net_flux < 0.0 { 0.0 - net_flux } else { net_flux }
let mut span_max = xs[0]
let mut span_min = xs[0]
let mut k2 = 1
while k2 < n {
    if xs[k2] > span_max { span_max = xs[k2] }
    if xs[k2] < span_min { span_min = xs[k2] }
    k2 = k2 + 1
}
let span = if span_max - span_min > 0.000001 { span_max - span_min } else { 1.0 }
let div_norm = flux_abs / span
let div_clip = if div_norm > 1.0 { 1.0 } else { div_norm }

let score = 0.5 * energy_norm + 0.3 * curl_clip + 0.2 * div_clip
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[em] category=core axis=\"Electromagnetism — field energy + curl-proxy alternating-sum + div net-flux\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"energy\":" + to_string(energy) + ",\"curl_norm\":" + to_string(curl_norm) + ",\"div_norm\":" + to_string(div_norm) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
