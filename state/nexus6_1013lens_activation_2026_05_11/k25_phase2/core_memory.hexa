// core_memory.hexa — Phase 2 reimpl with input channel x
// =============================================================================
// spec: state/nexus6_1013lens_activation_2026_05_11/cascade_k25_plan_2026_05_12.md §1.2
// parent (trivial): /home/summer/core/nexus_lenses_snapshot/core_memory.hexa
// axis: memory/retention — extended lag-correlation (long-range)
// modality: state (B=1, S=N, time series)
// kernel: r_L = lag-L autocorrelation at L ∈ {1, 4, 16, 64}. memory_score = max(0, mean(|r_L|))
//         + persistence as #{|r_L| > 0.1} / 4.
// =============================================================================

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 128 {
    println("lens[memory] category=core axis=\"memory (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// mean and variance of full series
let mut s_x = 0.0
let mut i = 0
while i < n { s_x = s_x + xs[i]; i = i + 1 }
let mu = s_x / to_float(n)
let mut s_v = 0.0
let mut j = 0
while j < n { let d = xs[j] - mu; s_v = s_v + d * d; j = j + 1 }
let var_x = s_v / to_float(n)
let std_x = if var_x > 0.000001 { 0.0 } else { 0.0 }

// Function-like inline lag corr (lag L)
let mut lags = [1, 4, 16, 64]
let mut rs = []
let mut li = 0
while li < 4 {
    let L = lags[li]
    let mut s_lag = 0.0
    let mut cnt_l = 0
    let mut k = 0
    while k + L < n {
        s_lag = s_lag + (xs[k] - mu) * (xs[k + L] - mu)
        cnt_l = cnt_l + 1
        k = k + 1
    }
    let cov = if cnt_l > 0 { s_lag / to_float(cnt_l) } else { 0.0 }
    let r_L = if var_x > 0.000001 { cov / var_x } else { 0.0 }
    rs.push(r_L)
    li = li + 1
}

// mean |r|, persistence (#{|r| > 0.1})
let mut sum_abs_r = 0.0
let mut persist_n = 0
let mut ri = 0
while ri < 4 {
    let r = rs[ri]
    let ar = if r < 0.0 { 0.0 - r } else { r }
    sum_abs_r = sum_abs_r + ar
    if ar > 0.1 { persist_n = persist_n + 1 }
    ri = ri + 1
}
let mean_abs_r = sum_abs_r / 4.0
let persist_ratio = to_float(persist_n) / 4.0

let score = 0.6 * mean_abs_r + 0.4 * persist_ratio
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[memory] category=core axis=\"Memory — extended lag-correlation r_L at L={1,4,16,64} + persistence count\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"r1\":" + to_string(rs[0]) + ",\"r4\":" + to_string(rs[1]) + ",\"r16\":" + to_string(rs[2]) + ",\"r64\":" + to_string(rs[3]) + ",\"persist_ratio\":" + to_string(persist_ratio) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
