// core_consciousness_v2.hexa — Phase 1 reimpl with input channel x
// axis: consciousness — IIT proxy (bipartition cov-MIP variance ratio)

let SIGMA = 12.0
let PHI = 2.0
let N = 6.0
let TAU = 4.0
let J2 = 24.0
let n6_closure_ok = if (SIGMA * PHI == N * TAU) && (J2 == SIGMA * PHI) { 1 } else { 0 }

let x_path = env("ANIMA_LENS_X_FILE")
let mut xs = []
if x_path != "" {
    let txt = read_file(x_path)
    let lines = split(txt, "\n")
    for ln in lines {
        let toks = split(ln, " ")
        for t in toks { if t != "" { xs.push(to_float(t)) } }
    }
} else {
    let seed_str = env("ANIMA_LENS_SEED")
    let mut seed = if seed_str != "" { to_int(seed_str) } else { 1 }
    let mut k = 0
    while k < 256 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(to_float(seed) / 2147483648.0)
        k = k + 1
    }
}

let n = len(xs)
if n < 8 {
    println("lens[consciousness] category=core axis=\"consciousness (insufficient_input)\" score=0 support=0 (0/0)")
    exit(0)
}

// Bipartition: split x into halves L=x[0..n/2], R=x[n/2..n].
// IIT proxy: integration φ ≈ |corr(L, R)|  — high correlation across partition = integrated information.
let half = n / 2
let mut s_L = 0.0
let mut s_R = 0.0
let mut i = 0
while i < half { s_L = s_L + xs[i]; s_R = s_R + xs[i + half]; i = i + 1 }
let mean_L = s_L / to_float(half)
let mean_R = s_R / to_float(half)

let mut var_L = 0.0
let mut var_R = 0.0
let mut cov_LR = 0.0
let mut j = 0
while j < half {
    let dl = xs[j] - mean_L
    let dr = xs[j + half] - mean_R
    var_L = var_L + dl * dl
    var_R = var_R + dr * dr
    cov_LR = cov_LR + dl * dr
    j = j + 1
}
let denom = sqrt(var_L * var_R)
let corr_LR = if denom > 0.000001 { cov_LR / denom } else { 0.0 }
let abs_corr = if corr_LR < 0.0 { 0.0 - corr_LR } else { corr_LR }
let phi_iit = if abs_corr > 1.0 { 1.0 } else { abs_corr }

// secondary integration: covariance across N/4 sub-blocks (4-partition cohesion)
let q = n / 4
let mut means = []
let mut blk = 0
while blk < 4 {
    let mut s = 0.0
    let mut p = 0
    while p < q { s = s + xs[blk * q + p]; p = p + 1 }
    means.push(s / to_float(q))
    blk = blk + 1
}
// variance of block means (low = high integration / global mean)
let mut s_m = 0.0
for m in means { s_m = s_m + m }
let mean_of_means = s_m / 4.0
let mut var_m = 0.0
for m in means { let d = m - mean_of_means; var_m = var_m + d * d }
var_m = var_m / 4.0
// integration_block: 1 / (1 + var_m * 10) — squash
let integration_block = 1.0 / (1.0 + var_m * 10.0)

let score = 0.6 * phi_iit + 0.4 * integration_block
let hits = if score > 0.5 { 6 } else { if score > 0.3 { 4 } else { 2 } }
println("lens[consciousness] category=core axis=\"Structural awareness — IIT bipartition phi + 4-block integration\" score=" + to_string(score) + " support=1 n=" + to_string(n) + " meta={\"phi_iit\":" + to_string(phi_iit) + ",\"integration_block\":" + to_string(integration_block) + ",\"n6_closure\":" + to_string(n6_closure_ok) + "} (" + to_string(hits) + "/8)")
