// pm_probe.hexa — ENGINE-NATIVE cue-delay falsifier for §ProspectiveIntention (N1, H_PLACEHOLDER_N1).
//
// Runs the LIVE §ProspectiveIntention ops (core/engine_cli.hexa) — pm_retain / pm_release /
// pm_timecourse / pm_wm_baseline / pm_lane_is_disjoint — over a deterministic cue-delay protocol.
// $0, CPU, deterministic, no GPU, no LLM, no decode. Engine-native evidence gate
// (a_engine_native_learning): every number below is a LIVE .hexa op output, not a numpy mirror.
//
// PROTOCOL: plant an intention (strength 1.0) at t=0, run a delay to cue_onset=5, then present a cue.
// Measure the intention-lane activation TIMECOURSE (substrate state, NOT decode).
//
// FROZEN falsifiers (pre-registered, variable-separation, NOT tune-to-green):
//   F1  DELAY-MAINTENANCE  : during the delay (t<5) activation is 0 (suspended, not fired) AND the
//       retained intention survives the delay (pm_retain(1.0, 5, leak=0) == 1.0).
//   F2  CUE-MATCH SPIKE    : at the matching cue (cue_match=1.0, lane_on) the release SPIKES (>0.9).
//   F3  ABLATION           : PM-lane OFF (lane_on=false) → activation 0 at EVERY tick incl. the cue.
//   F4  DISTRACTOR-CONTROL : a non-matching cue (cue_match=0.10) → NO release (selectivity).
//   F5  PARENT-CONTROL     : the H_1282 working-memory baseline is nonzero DURING the delay and decays
//       (no flat-then-spike) — dissociates PM (deferred, cue-released) from WM (current content).
//   F6  Ψ-DISJOINT         : the PM lane coordinate is emit-disjoint (pm_lane_is_disjoint != 0/4) AND
//       ci_emit_drive (Ψ lanes 0/4) is BYTE-IDENTICAL PM-ON vs PM-OFF — separation = preservation.
//
// usage: hexa run state/n1_prospective_intention/pm_probe.hexa

import "core/engine_cli.hexa"

fn _fmt(label: string, v: float) -> bool { println(label + to_string(v))  return true }

fn _pass(label: string, ok: bool) -> bool {
    if ok { println("PASS  " + label) } else { println("FAIL  " + label) }
    return ok
}

// max over an activation timecourse
fn _max(xs: [float]) -> float {
    let mut m = 0.0 - 1.0e30
    let mut i = 0
    while i < len(xs) { if xs[i] > m { m = xs[i] }  i = i + 1 }
    return m
}
// sum over ticks [0, hi)
fn _sum_lo(xs: [float], hi: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < hi { s = s + xs[i]  i = i + 1 }
    return s
}

fn main() {
    let STRENGTH = 1.0
    let CUE_ONSET = 5
    let TOTAL = 10
    let LEAK = 0.0                    // PM-lane holds (perfect maintenance across the delay)

    println("=== §ProspectiveIntention (N1) cue-delay falsifier — engine-native ===")

    // ── the four timecourses the falsifier compares ────────────────────────────────────────
    let tc_match     = pm_timecourse(STRENGTH, CUE_ONSET, TOTAL, 1.0,  true,  LEAK) // matching cue
    let tc_ablate    = pm_timecourse(STRENGTH, CUE_ONSET, TOTAL, 1.0,  false, LEAK) // PM-lane OFF
    let tc_distract  = pm_timecourse(STRENGTH, CUE_ONSET, TOTAL, 0.10, true,  LEAK) // non-matching cue

    // print the matching timecourse (the headline: [0,0,0,0,0, spike, spike, ...])
    let mut ts = "  tc(match)  = ["
    let mut i = 0
    while i < TOTAL { ts = ts + to_string(tc_match[i]) + " "  i = i + 1 }
    println(ts + "]")

    // ── F1 DELAY-MAINTENANCE ───────────────────────────────────────────────────────────────
    let delay_sum = _sum_lo(tc_match, CUE_ONSET)            // activation summed over the delay
    let retained  = pm_retain(STRENGTH, CUE_ONSET, LEAK)    // intention still held at the cue
    _fmt("  delay activation sum (want 0) = ", delay_sum)
    _fmt("  retained at cue (want 1.0)    = ", retained)
    let f1 = _pass("F1 DELAY-MAINTENANCE (suspended & held)", delay_sum == 0.0 && retained == 1.0)

    // ── F2 CUE-MATCH SPIKE ──────────────────────────────────────────────────────────────────
    let spike = tc_match[CUE_ONSET]
    _fmt("  release spike at cue (want>0.9) = ", spike)
    let f2 = _pass("F2 CUE-MATCH SPIKE", spike > 0.9)

    // ── F3 ABLATION ──────────────────────────────────────────────────────────────────────────
    let abl_max = _max(tc_ablate)
    _fmt("  PM-lane OFF max activation (want 0) = ", abl_max)
    let f3 = _pass("F3 ABLATION (lane OFF → no release)", abl_max == 0.0)

    // ── F4 DISTRACTOR-CONTROL ─────────────────────────────────────────────────────────────────
    let dist_max = _max(tc_distract)
    _fmt("  distractor cue max activation (want 0) = ", dist_max)
    let f4 = _pass("F4 DISTRACTOR-CONTROL (non-matching cue → no release)", dist_max == 0.0)

    // ── F5 PARENT-CONTROL (WM ≠ PM) ───────────────────────────────────────────────────────────
    // working-memory baseline (H_1282): nonzero DURING the delay, decays, no cue spike.
    let wm_mid = pm_wm_baseline(STRENGTH, 3, 0.15)          // during-delay activation (want > 0)
    let pm_mid = tc_match[3]                                // PM during-delay activation (== 0)
    _fmt("  WM baseline during delay (want>0) = ", wm_mid)
    _fmt("  PM lane   during delay (want 0)   = ", pm_mid)
    let f5 = _pass("F5 PARENT-CONTROL (WM held-decays vs PM suspended-then-spikes)",
                   wm_mid > 0.0 && pm_mid == 0.0)

    // ── F6 Ψ-DISJOINT (separation = preservation) ─────────────────────────────────────────────
    // PM lane placed on an emit-disjoint coordinate (e.g. lane 7). Prove: (a) placement disjoint,
    // (b) ci_emit_drive (Ψ lanes 0/4) BYTE-IDENTICAL PM-ON vs PM-OFF.
    let PM_LANE = 7
    let dj = pm_lane_is_disjoint(PM_LANE)
    // a 15-lane substrate state; emit lanes 0 & 4 carry the ignition/grounding drive.
    let mut lanes = []
    let mut k = 0
    while k < 15 { lanes = lanes + [0.30]  k = k + 1 }
    lanes[0] = 0.62
    lanes[4] = 0.38
    let drive_off = ci_emit_drive(lanes)                   // PM lane inactive
    // PM release fires on the disjoint lane 7 — write it and re-read the emit drive.
    let spk = pm_release(retained, 1.0, true)
    lanes[PM_LANE] = spk                                    // PM activation lands on lane 7 only
    let drive_on = ci_emit_drive(lanes)                    // Ψ lanes 0/4 must be untouched
    _fmt("  PM lane disjoint flag (want 1)      = ", to_float(dj))
    _fmt("  ci_emit_drive PM-OFF                = ", drive_off)
    _fmt("  ci_emit_drive PM-ON (lane7 fired)   = ", drive_on)
    let f6 = _pass("F6 Ψ-DISJOINT (emit-drive byte-identical PM-ON vs OFF)",
                   dj == 1 && drive_on == drive_off)

    println("")
    let all = f1 && f2 && f3 && f4 && f5 && f6
    if all { println("VERDICT: ENGINE-NATIVE SUPPORTED (6/6 falsifiers pass) — §ProspectiveIntention live") }
    else   { println("VERDICT: FALSIFIED (>=1 falsifier failed)") }
}
