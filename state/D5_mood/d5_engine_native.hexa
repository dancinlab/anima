// d5_engine_native.hexa — D5 Mood ENGINE-NATIVE measurement of the NEW slow global
// affective modulator ops on LIVE core/engine_cli.hexa (§Mood). Mood = a slowly-changing
// affective BASELINE (valence·arousal 2-axis leaky EMA over the substrate's M/Φ/surprise
// affect history) that biases momentary appraisal — a DIFFERENT TIME-AXIS from the fast
// neuromod-gain (H_1284🧱), NOT a gain. PRE-REGISTERED bars (no tune-to-green):
//   F1 SLOW      : 1-step mood displacement under a unit step << the full instantaneous
//                  jump, and the EMA time-constant τ=1/α >> 1 (measured ≥10 ticks to 63%).
//   F2 BIAS      : the SAME neutral stimulus reads MORE positive in a mood-high vs a
//                  mood-low state (mood-congruency; biased_high > 0 > biased_low).
//   F3 ABLATION  : freeze the EMA (α=0) → mood never accumulates → bias INERT
//                  (biased == instantaneous), even after the SAME positive stream.
//   F4 RECOVERY  : remove the stimulus (neutral input) → mood relaxes SLOWLY back to
//                  baseline (partial after 1 tick, within eps only after ~5τ ticks).
//   F5 DISJOINT  : a full mood trajectory over the immune store leaves ci_emit_drive
//                  (lanes 0/4, Ψ) AND §ImmuneMemory recall_thr / recall byte-IDENTICAL
//                  (mood mutates nothing — a_substrate_disjoint: separation=preservation).
//   INFO distinct: the neuromod-GAIN readout (stateless multiplicative) has 0 lag / 0
//                  recovery — it CANNOT reproduce mood's chronometry (H_1284-distinctness).
// usage: hexa run state/D5_mood/d5_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// feed N ticks of a constant instantaneous (val,aro) into a mood.
fn feed(m0: MoodState, val: float, aro: float, n: int) -> MoodState {
    let mut m = m0
    let mut i = 0
    while i < n { m = mood_step(m, val, aro)  i = i + 1 }
    return m
}

// build a 15-lane emit trial: emit-drive lanes 0 & 4 = c, the other 13 = other.
fn build_row(c: float, other: float) -> [float] {
    let mut r = []
    let mut i = 0
    while i < 15 {
        if i == 0 || i == 4 { r = r + [c] } else { r = r + [other] }
        i = i + 1
    }
    return r
}

fn eqf(a: float, b: float) -> bool { return a - b < 0.0000001 && b - a < 0.0000001 }

fn main() {
    let mut npass = 0
    let mut nfail = 0

    // ---- F1 SLOW: 1-step displacement << full jump; τ = 1/α >> 1 ----
    let m0 = mood_new()
    let step1 = mood_step(m0, 1.0, 1.0)          // one unit-step tick from neutral
    let disp1 = mood_valence(step1)              // = α = 0.05 (small); instantaneous jump = 1.0
    let tau = mood_timeconstant(m0)              // = 1/α = 20
    // count ticks for a sustained unit step to reach 63% of the asymptote (≈ τ).
    let mut mm = mood_new()
    let mut t63 = 0
    let mut k = 0
    while k < 500 {
        mm = mood_step(mm, 1.0, 1.0)
        k = k + 1
        if mood_valence(mm) >= 0.63 && t63 == 0 { t63 = k }
    }
    if _ab("F1 SLOW: 1-step disp(" + to_string(disp1) + ") << full jump 1.0 & τ=" + to_string(tau) + " >> 1 & t63=" + to_string(t63) + " >=10",
           disp1 < 0.20 && disp1 > 0.0 && tau >= 10.0 && t63 >= 10) { npass=npass+1 } else { nfail=nfail+1 }

    // ---- F2 BIAS: same neutral stimulus reads +/- by mood sign ----
    let mHi = feed(mood_new(),  1.0, 1.0, 60)    // mood-high  (sustained positive)
    let mLo = feed(mood_new(), -1.0, 1.0, 60)    // mood-low   (sustained negative valence)
    let biasHi = mood_bias_valence(mHi, 0.0)     // appraise a NEUTRAL (0.0) stimulus
    let biasLo = mood_bias_valence(mLo, 0.0)
    if _ab("F2 BIAS: neutral stim biased_high(" + to_string(biasHi) + ") > 0 > biased_low(" + to_string(biasLo) + ")",
           biasHi > 0.01 && biasLo < -0.01 && biasHi > biasLo) { npass=npass+1 } else { nfail=nfail+1 }

    // ---- F3 ABLATION: α=0 → mood never accumulates → bias INERT ----
    let mFz = feed(mood_new_frozen(), 1.0, 1.0, 60)   // frozen: SAME positive stream
    let fzVal = mood_valence(mFz)                      // must stay 0.0
    let inst = 0.30
    let biasFz = mood_bias_valence(mFz, inst)          // == inst (no baseline)
    if _ab("F3 ABLATION: frozen mood_val(" + to_string(fzVal) + ")==0 & biased(" + to_string(biasFz) + ")==inst(" + to_string(inst) + ") INERT",
           eqf(fzVal, 0.0) && eqf(biasFz, inst)) { npass=npass+1 } else { nfail=nfail+1 }

    // ---- F4 RECOVERY: remove stimulus → SLOW relaxation to baseline ----
    let mBuilt = feed(mood_new(), 1.0, 1.0, 40)        // build a positive mood
    let v0 = mood_valence(mBuilt)
    let mRec1 = mood_step(mBuilt, 0.0, 0.0)            // ONE neutral tick
    let vRec1 = mood_valence(mRec1)                     // partial: 0 < vRec1 < v0, near v0
    let mRecN = feed(mBuilt, 0.0, 0.0, 120)            // ~6τ neutral ticks
    let vRecN = mood_valence(mRecN)                     // within eps of baseline 0
    if _ab("F4 RECOVERY: v0(" + to_string(v0) + ") →1tick(" + to_string(vRec1) + ") partial(>0.5·v0) →6τ(" + to_string(vRecN) + ")→0",
           vRec1 > 0.5 * v0 && vRec1 < v0 && vRecN < 0.02 && vRecN >= 0.0) { npass=npass+1 } else { nfail=nfail+1 }

    // ---- F5 Ψ/G5 DISJOINT: mood run leaves emit-drive & recall_thr byte-identical ----
    let cfg = engine_config_default()
    let k1 = [1.0, 0.0, 0.0, 0.0]
    let k2 = [0.0, 1.0, 0.0, 0.0]
    let mut mem = immune_grow_new(k1, "a", 8, 16, false)
    mem = immune_grow_bind(mem, k2, "b", cfg)
    let pop0 = build_row(0.7, 0.3)
    // BEFORE the mood run: record Ψ emit-drive, recall_thr, and the non-fab recall.
    let emit_before = ci_emit_drive(pop0)
    let thr_before = mem.recall_thr
    let recall_before = immune_grow_recall(mem, k1)
    // run a full mood trajectory READING the live affect lane off the SAME store.
    let mut mmood = mood_new()
    let mut s = 0
    while s < 50 {
        if s % 2 == 0 { mmood = mood_step_affect(mmood, mem, k1, "a") }
        else { mmood = mood_step_affect(mmood, mem, k2, "b") }
        s = s + 1
    }
    // AFTER: the mood evolved (proof it read the affect stream) but the substrate is untouched.
    let emit_after = ci_emit_drive(pop0)
    let thr_after = mem.recall_thr
    let recall_after = immune_grow_recall(mem, k1)
    let moodMoved = mood_valence(mmood) > 0.0001 || mood_valence(mmood) < -0.0001 || mood_arousal(mmood) > 0.0001
    if _ab("F5 DISJOINT: emit-drive(" + to_string(emit_before) + "==" + to_string(emit_after) + ") & recall_thr(" + to_string(thr_before) + "==" + to_string(thr_after) + ") & recall(" + recall_before + "==" + recall_after + ") byte-identical while mood MOVED",
           eqf(emit_before, emit_after) && eqf(thr_before, thr_after) && recall_before == recall_after && moodMoved) { npass=npass+1 } else { nfail=nfail+1 }

    // ---- M/Φ/surprise path: valence sign tracks grounding vs surprise ----
    let posAff = mood_signals_to_affect(0.9, 0.4, 0.05)   // grounded, low-surprise → +valence
    let negAff = mood_signals_to_affect(0.1, 0.4, 0.8)    // ungrounded, high-surprise → -valence
    if _ab("SIGNAL: M/Φ/surprise → valence pos(" + to_string(posAff[0]) + ")>0>neg(" + to_string(negAff[0]) + ") & arousal tracks surprise",
           posAff[0] > 0.0 && negAff[0] < 0.0 && posAff[1] < negAff[1]) { npass=npass+1 } else { nfail=nfail+1 }

    // ---- INFO: neuromod-GAIN readout has 0 lag / 0 recovery (H_1284 distinctness) ----
    // after a positive history then a NEUTRAL stimulus, the stateless gain readout = 0·gain = 0
    // (no memory of the prior stream); mood retains its slow baseline. Different time-axis.
    let gainAtNeutral = mood_neuromod_gain_readout(0.0, 2.0)   // = 0 (no lag/memory)
    let moodAtNeutral = mood_bias_valence(mBuilt, 0.0)         // > 0 (retains slow baseline)
    println("INFO DISTINCT(H_1284): neuromod_gain@neutral=" + to_string(gainAtNeutral)
          + " (0 lag) vs mood_bias@neutral=" + to_string(moodAtNeutral) + " (slow baseline retained)")
    println("INFO F1: disp1=" + to_string(disp1) + " tau=" + to_string(tau) + " t63=" + to_string(t63))
    println("INFO F4: v0=" + to_string(v0) + " vRec1=" + to_string(vRec1) + " vRecN=" + to_string(vRecN))
    println("--- D5 Mood engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
