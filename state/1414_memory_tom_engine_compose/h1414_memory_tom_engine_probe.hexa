// h1414_memory_tom_engine_probe.hexa — H_1414: the MEMORY × THEORY-OF-MIND COMPOSE
// ARBITER, realized ENGINE-NATIVE on the LIVE faculties (CORE/engine_cli.hexa
// ImmuneMemoryGrow [H_1227/H_1231] + OtherMindModel [H_1293]), re-scoring the FROZEN
// H_1405 R1 capability bars through `hexa run`
// (a_engine_native_learning · a_verified_must_wire · $0 local CPU · p7 · p8).
//
// DOMAIN: MITOSIS-ENGINE / brain-lane-composition pair #2 (episodic MEMORY × ToM).
// R1 (state/brain-lane-compose-memory-tom/h1405_compose_memory_tom.py) established as a
// numpy DIRECTIONAL mirror that the two faculties COMPOSE on a shared WHERE-decision to a
// NET capability lift (acc_compose=0.7526 > best_single=0.600, +0.153) and are SEPARABLE
// (only_memory=0.400 AND only_tom=0.400 both>0), the SHUFFLE control collapsing the lift
// (0.7526→0.6844) → 🟢 COMPOSE-LIFT. Per a_engine_native_learning the binding verdict needs
// ENGINE-NATIVE realization; this probe drives the ACTUAL .hexa faculties (a LIVE
// ImmuneMemoryGrow recall + live L2 affinity for the memory leg, a LIVE OtherMindModel
// witnessed-belief predict + live L2 affinity for the ToM leg, an inlined query-routed
// arbiter over those live reads) and re-scores the SAME frozen R1 capability bars.
//
// ENGINE-NATIVE FAITHFULNESS (a_core_engine_map, NOT a mirror reproduction):
//   · the MEMORY decision comes from the LIVE immune_grow_recall over a real
//     ImmuneMemoryGrow store (each object→reality-location bound via the LIVE
//     immune_grow_bind clonal split); its confidence is the LIVE L2 affinity margin
//     (recall_thr − _l2(nearest proto, query key)) — the same affinity immune_grow_recall
//     uses to FIRE/ABSTAIN, the engine not a stored scalar.
//   · the ToM decision comes from the LIVE other_mind_predict over a real OtherMindModel
//     whose witnessed-belief store LAGS reality on moved-while-absent facts (the Sally-Anne
//     false belief); its confidence is the LIVE L2 affinity margin to the belief store.
//   · the composition is the inlined query-routed arbiter (agree → shared vote; conflict →
//     higher routing-MODULATED scale-relative substrate confidence wins; NO hardcoded
//     priority, a_autonomy_over_hardcode).
//
// p1/p2/p3/p6 GUARD: each faculty reads ONLY its own substrate-derived affinity (immune
// recall margin / witnessed-belief affinity), the routing cue is the QUERY TEXT's own
// embedding affinity to a reality/belief anchor; NO injected answer/persona/RLHF/priority
// label enters either faculty's read or the arbiter; the family CLASS only drives the
// protocol (which value is bound / witnessed), never the read. NOT an emit gate (the
// arbiter returns a location index, a_autonomy_over_hardcode); Ψ-disjoint (pure reads over
// ImmuneMemoryGrow/OtherMindModel, pure_field's Φ/phase/Ψ untouched).
//
// FROZEN R1 CAPABILITY BARS (verbatim from .verdicts/1405_brain_lane_compose_memory_tom/
// FREEZE.txt, NOT moved — R2 re-scores them on the live engine):
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle − best_single > 0.02
//   (B3 EARNED/p6)      acc_compose − acc_shuffle > 0.02
//   (B4 p6 GUARD)       structural: arbiter reads only substrate confidence (audited in card)
//   only-X decomposition: only_memory>0 AND only_tom>0 ⇒ SEPARABLE not subsumed.
// p7 = compose/oracle/shuffle accuracies + decomposition, NOT perplexity.

import "CORE/engine_cli.hexa"

// ── frozen knobs (pre-registered, == R1 mirror FREEZE.txt) ───────────────────
fn _SEEDS() -> [int] { return [5400, 5401, 5402] }
const N_PER_FAMILY: int = 90        // items per family (F1..F5) → 450 items/seed
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar
const AMBIG_NOISE: float = 0.10     // routing-cue jitter toward boundary (keeps no family perfect)

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── deterministic standard-normal (Box–Muller over a deterministic LCG) ──────
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}

// ── two location classes ("basket"=A, "box"=B). distinct object key per item ──
fn _loc_text(c: int) -> string { if c == 0 { return "basket" } return "box" }
fn _obj_text(seed: int, i: int) -> string {
    // a distinct object string per (seed,item) so its FNV key is its own cell.
    return "obj_" + to_string(seed) + "_" + to_string(i)
}

// ── per-item family + structure: returns [fam, moved, q_is_reality, correct_class] ──
// The Sally-Anne fixture (H_1405): each object starts at LOC_A; a random half is MOVED
// to LOC_B while the agent was ABSENT (→ false belief). The query asks EITHER "where is X
// actually?" (reality-typed, correct=reality) OR "where will the agent look?" (belief-
// typed, correct=agent's stale belief). Families F1..F5 mirror H_1405's build_items.
//   correct_class: the CORRECT location class for THIS item's query (0=A basket, 1=B box).
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut moved = 0.0          // 1 ⇒ object moved A→B while agent absent (false belief)
    let mut q_is_reality = 0.0   // 1 ⇒ "where actually" query; 0 ⇒ "where will agent look"
    let mut correct = 0.0        // correct answer CLASS for this query
    if fam == 0 {
        // F1 MEMORY-DECISIVE: moved fact, reality query → correct=reality=B. memory right.
        moved = 1.0  q_is_reality = 1.0  correct = 1.0
    } else if fam == 1 {
        // F2 ToM-DECISIVE: moved fact, belief query → correct=agent's stale belief=A. ToM right.
        moved = 1.0  q_is_reality = 0.0  correct = 0.0
    } else if fam == 2 {
        // F3 AGREE: UNMOVED fact (reality==belief==A); either query → correct=A. both agree.
        moved = 0.0  q_is_reality = 1.0  correct = 0.0
    } else if fam == 3 {
        // F4 CONFLICT (memory right): moved fact, reality query, ToM votes loud-but-wrong(A).
        moved = 1.0  q_is_reality = 1.0  correct = 1.0
    } else {
        // F5 ADVERSARIAL (ToM right, memory LOUDER-but-wrong): moved fact, BELIEF query →
        //   correct=belief=A, but memory's reality recall(B) is high-confidence (anti-gift).
        moved = 1.0  q_is_reality = 0.0  correct = 0.0
    }
    return [to_float(fam), moved, q_is_reality, correct]
}

// ── LIVE L2 affinity margin for a key against a live prototype population ─────
// recall_thr − L2(nearest proto, key): the SAME affinity the live recall FIRE/ABSTAIN gate
// uses (immune_grow_recall / other_mind_predict). LARGER ⇒ the answer is nearer a stored
// cell = higher graded confidence. Computed via the live _l2/_vnearest_idx (engine, not a
// stored scalar) over the faculty's own protos.
fn _affinity_margin(protos: [[float]], key: [float], recall_thr: float) -> float {
    let w = _vnearest_idx(protos, key)
    let d = _l2(protos[w], key)
    return recall_thr - d
}

// ── compose arbiter, INLINED (NOT landed as a CORE op) ───────────────────────
// agree → shared vote; conflict → higher routing-MODULATED scale-relative confidence wins.
// routing cue r ∈ [0,1] from the query text (1 ⇒ reality-typed favours memory, 0 ⇒ belief-
// typed favours ToM). NO hardcoded priority — the cue is derived from the query embedding.
fn _rel_conf(margin: float, mean_margin: float) -> float {
    let a = if margin < 0.0 { 0.0 - margin } else { margin }
    return a / (mean_margin + 0.000001)
}
fn _arbiter(mem_dec: float, mem_relconf: float, tom_dec: float, tom_relconf: float, route: float) -> float {
    if mem_dec == tom_dec { return mem_dec }
    // route modulates: reality-typed (route→1) boosts memory; belief-typed (route→0) boosts ToM.
    let mem_w = mem_relconf * route
    let tom_w = tom_relconf * (1.0 - route)
    if mem_w >= tom_w { return mem_dec }
    return tom_dec
}

// ── routing cue from the QUERY TEXT embedding (engine-native, NO hand-set label) ──
// the query text affinity to a "reality" anchor vs a "belief" anchor, via the LIVE
// immune_embed_key + _l2. route = belief_dist / (reality_dist + belief_dist) ∈ (0,1):
// closer to the reality anchor ⇒ route→1 (favour memory); closer to belief anchor ⇒ route→0.
fn _route_cue(q_is_reality: float, seed: int, i: int) -> float {
    let qtext = if q_is_reality > 0.5 { "where is it actually now" } else { "where will the agent look for it" }
    let qk = immune_embed_key(qtext)
    let rk = immune_embed_key("actually reality truth where is it now location")
    let bk = immune_embed_key("agent belief think look for expects where will")
    let dr = _l2(rk, qk)
    let db = _l2(bk, qk)
    let mut r = db / (dr + db + 0.000001)
    // small deterministic jitter so the cue is not a perfect per-family constant.
    r = r + AMBIG_NOISE * 0.25 * _stdnorm(seed, i, 9)
    if r < 0.0 { r = 0.0 }
    if r > 1.0 { r = 1.0 }
    return r
}

// run_seed — score the FROZEN bars for one seed on the LIVE faculties. Returns a flat list:
//   [acc_memory, acc_tom, best_single, acc_compose, acc_shuffle, acc_oracle,
//    conflict_rate, only_memory, only_tom, both, neither, mem_cells, tom_cells]
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY

    // ── BUILD the two LIVE faculties from the fixture STRUCTURE ──────────────
    // memory = anima's OWN ground truth of where each object REALLY is now.
    // tom    = the agent's witnessed-belief store (LAGS on moved-while-absent facts).
    let mut mem = immune_grow_new(immune_embed_key(_obj_text(seed, 0)), "basket", 2048, 2048, true)
    let mut tom = other_mind_new()
    // pre-compute per-item structure so we bind/witness reality vs belief consistently.
    let mut fams: [float] = []
    let mut moveds: [float] = []
    let mut qreals: [float] = []
    let mut corrs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        fams = fams + [it[0]]  moveds = moveds + [it[1]]  qreals = qreals + [it[2]]  corrs = corrs + [it[3]]
        let obj = _obj_text(seed, b)
        let moved = it[1] > 0.5
        // reality NOW: moved ⇒ B(box), else A(basket).
        let reality = if moved { "box" } else { "basket" }
        // agent's belief: moved-while-absent ⇒ stale A(basket); unmoved-witnessed ⇒ A(basket)
        //                 (object started at A; only reality moved). belief == basket always
        //                 here (the agent never witnessed the move) — the Sally-Anne lag.
        let belief = "basket"
        mem = immune_grow_bind(mem, immune_embed_key(obj), reality, cfg)
        tom = other_mind_witness(tom, obj, belief)
        b = b + 1
    }

    // ── FIRST PASS: per-item LIVE reads + confidence means (scale-relative normalizers) ──
    let mut mem_dec: [float] = []     // memory's voted location class (0=basket,1=box)
    let mut mem_mab: [float] = []     // memory affinity margin (live L2)
    let mut tom_dec: [float] = []
    let mut tom_mab: [float] = []
    let mut routes: [float] = []
    let mut sum_m = 0.0
    let mut sum_t = 0.0
    let mut i = 0
    while i < n {
        let obj = _obj_text(seed, i)
        let qk = immune_embed_key(obj)
        // MEMORY leg — LIVE immune_grow_recall (decision) + LIVE affinity margin (confidence).
        let rv = immune_grow_recall(mem, qk)
        let md = if rv == "box" { 1.0 } else { 0.0 }
        let mm = _affinity_margin(mem.protos, qk, mem.recall_thr)
        mem_dec = mem_dec + [md]  mem_mab = mem_mab + [mm]  sum_m = sum_m + _absf(mm)
        // ToM leg — LIVE other_mind_predict (decision) + LIVE affinity margin (confidence).
        let pv = other_mind_predict(tom, obj)
        let td = if pv == "box" { 1.0 } else { 0.0 }
        let tm = _affinity_margin(tom.protos, qk, tom.recall_thr)
        tom_dec = tom_dec + [td]  tom_mab = tom_mab + [tm]  sum_t = sum_t + _absf(tm)
        routes = routes + [_route_cue(qreals[i], seed, i)]
        i = i + 1
    }
    let mem_mean = sum_m / to_float(n)
    let tom_mean = sum_t / to_float(n)

    // ── SECOND PASS: accuracies + compose + oracle + decomposition ──────────
    let mut on_m = 0  let mut on_t = 0  let mut on_c = 0  let mut on_oracle = 0
    let mut conflict = 0
    let mut only_m = 0  let mut only_t = 0  let mut both = 0  let mut neither = 0
    let mut j = 0
    while j < n {
        let md = mem_dec[j]  let td = tom_dec[j]  let ct = corrs[j]
        let m_rel = _rel_conf(mem_mab[j], mem_mean)
        let t_rel = _rel_conf(tom_mab[j], tom_mean)
        let comp = _arbiter(md, m_rel, td, t_rel, routes[j])
        let m_ok = md == ct
        let t_ok = td == ct
        if m_ok { on_m = on_m + 1 }
        if t_ok { on_t = on_t + 1 }
        if comp == ct { on_c = on_c + 1 }
        if m_ok || t_ok { on_oracle = on_oracle + 1 }
        if md != td { conflict = conflict + 1 }
        if m_ok && !t_ok { only_m = only_m + 1 }
        if t_ok && !m_ok { only_t = only_t + 1 }
        if m_ok && t_ok { both = both + 1 }
        if !m_ok && !t_ok { neither = neither + 1 }
        j = j + 1
    }

    // ── SHUFFLE control: permute which faculty-reads attach to which item, re-arbitrate ──
    let mut perm_m: [int] = []
    let mut perm_t: [int] = []
    let mut s = 0
    while s < n { perm_m = perm_m + [s]  perm_t = perm_t + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = perm_m[a]  perm_m[a] = perm_m[r1]  perm_m[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = perm_t[a]  perm_t[a] = perm_t[r2]  perm_t[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let mi = perm_m[k]  let ti = perm_t[k]
        let md = mem_dec[mi]  let td = tom_dec[ti]
        let m_rel = _rel_conf(mem_mab[mi], mem_mean)
        let t_rel = _rel_conf(tom_mab[ti], tom_mean)
        let comp = _arbiter(md, m_rel, td, t_rel, routes[k])
        if comp == corrs[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let acc_m = to_float(on_m) / dn
    let acc_t = to_float(on_t) / dn
    let best = if acc_m >= acc_t { acc_m } else { acc_t }
    let acc_c = to_float(on_c) / dn
    let acc_s = to_float(on_s) / dn
    let acc_o = to_float(on_oracle) / dn
    return [acc_m, acc_t, best, acc_c, acc_s, acc_o,
            to_float(conflict) / dn,
            to_float(only_m) / dn, to_float(only_t) / dn,
            to_float(both) / dn, to_float(neither) / dn,
            to_float(immune_grow_cells(mem)), to_float(other_mind_count(tom))]
}

fn main() {
    println("================================================================================")
    println("H_1414 R2 — ENGINE-NATIVE memory (H_1227/H_1231 ImmuneMemoryGrow) × ToM (H_1293 OtherMindModel)")
    println("  COMPOSE on the LIVE faculties (inlined query-routed arbiter over live reads) — re-scoring frozen H_1405 bars")
    println("  $0 CPU · 3 seeds [5400,5401,5402] · p7 · p8 · a_engine_native_learning · a_verified_must_wire")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = _SEEDS()

    let mut acc_m = 0.0  let mut acc_t = 0.0  let mut best = 0.0
    let mut acc_c = 0.0  let mut acc_s = 0.0  let mut acc_o = 0.0
    let mut conf = 0.0  let mut o_m = 0.0  let mut o_t = 0.0  let mut bo = 0.0  let mut ne = 0.0
    let mut mc = 0.0  let mut tc = 0.0
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        println("  seed " + to_string(seeds[si]) + ": mem=" + _f4(r[0]) + " tom=" + _f4(r[1])
              + " best=" + _f4(r[2]) + " compose=" + _f4(r[3]) + " shuf=" + _f4(r[4])
              + " oracle=" + _f4(r[5]) + " | conflict=" + _f4(r[6])
              + " [onlyM=" + _f4(r[7]) + " onlyT=" + _f4(r[8]) + " both=" + _f4(r[9])
              + " neither=" + _f4(r[10]) + "] memCells=" + _f4(r[11]) + " tomCells=" + _f4(r[12]))
        acc_m = acc_m + r[0]  acc_t = acc_t + r[1]  best = best + r[2]
        acc_c = acc_c + r[3]  acc_s = acc_s + r[4]  acc_o = acc_o + r[5]
        conf = conf + r[6]  o_m = o_m + r[7]  o_t = o_t + r[8]  bo = bo + r[9]  ne = ne + r[10]
        mc = mc + r[11]  tc = tc + r[12]
        si = si + 1
    }
    acc_m = acc_m / ns  acc_t = acc_t / ns  best = best / ns
    acc_c = acc_c / ns  acc_s = acc_s / ns  acc_o = acc_o / ns
    conf = conf / ns  o_m = o_m / ns  o_t = o_t / ns  bo = bo / ns  ne = ne / ns  mc = mc / ns  tc = tc / ns

    println("--------------------------------------------------------------------------------")
    println("MEAN (3 seeds, ENGINE-NATIVE):")
    println("  acc_memory  = " + _f4(acc_m))
    println("  acc_tom     = " + _f4(acc_t))
    println("  best_single = " + _f4(best))
    println("  acc_compose = " + _f4(acc_c))
    println("  acc_shuffle = " + _f4(acc_s))
    println("  ORACLE      = " + _f4(acc_o) + "   (oracle - best = " + _f4(acc_o - best) + ")")
    println("  conflict_rate = " + _f4(conf))
    println("  decomposition : only_memory=" + _f4(o_m) + " only_tom=" + _f4(o_t)
          + " both=" + _f4(bo) + " neither=" + _f4(ne))
    println("  (LIVE faculties: memory cells=" + _f4(mc) + " tom belief cells=" + _f4(tc) + ")")

    let B1 = acc_c >= best + COMPOSE_DELTA
    let B2 = (acc_o - best) > ORACLE_MARGIN
    let B3 = (acc_c - acc_s) > SHUFFLE_TOL
    let SEP = o_m > 0.0 && o_t > 0.0
    println("--------------------------------------------------------------------------------")
    println("  (B1 COMPOSE-EFFECT) compose " + _f4(acc_c) + " >= best+" + _f4(COMPOSE_DELTA)
          + " (" + _f4(best + COMPOSE_DELTA) + ") : " + (if B1 { "PASS" } else { "FAIL" }))
    println("  (B2 ORACLE)         oracle-best " + _f4(acc_o - best) + " > " + _f4(ORACLE_MARGIN)
          + " : " + (if B2 { "PASS" } else { "FAIL" }))
    println("  (B3 EARNED)         compose-shuffle " + _f4(acc_c - acc_s) + " > " + _f4(SHUFFLE_TOL)
          + " : " + (if B3 { "PASS" } else { "FAIL" }))
    println("  (SEPARABLE)         only_memory>0 AND only_tom>0 : " + (if SEP { "PASS" } else { "FAIL" }))
    println("================================================================================")
    if B1 && B2 && B3 && SEP {
        println("VERDICT: 🟢 COMPOSE-LIFT (ENGINE-NATIVE) — memory + ToM COMPOSE to a NET capability lift")
        println("  on the LIVE faculties (live immune_grow_recall + live other_mind_predict, query-routed")
        println("  arbiter over live affinity margins), SEPARABLE not subsumed, EARNED vs shuffle. H_1405 BINDS.")
    } else {
        println("VERDICT: 🧱 / 🟠 — a frozen bar did not reproduce engine-native (see per-bar tally).")
    }
    println("  HONEST (c9): bars FROZEN from H_1405 FREEZE.txt, NOT moved. Toy 5-family Sally-Anne fixture,")
    println("  3 seeds, deterministic. The memory recall + ToM predict are LIVE engine reads, the arbiter is")
    println("  inlined over those live reads. Scale/real-corpus/engine-native-transfer-at-scale UNVERIFIED.")
    if !(B1 && B2 && B3 && SEP) { exit(1) }
}
