// h1414_memory_tom_LIVEOP_probe.hexa — H_1414 rung-3 verification: re-run the FROZEN
// H_1405 capability bars driving the LIVE CORE op `mem_tom_compose` (CORE/engine_cli.hexa
// §MEMORY×ToM COMPOSE ARBITER) INSTEAD of the probe's inlined glue, and confirm it
// reproduces the H_1414 engine-native numbers BYTE-IDENTICALLY (a_verified_must_wire rung-3,
// c2). Everything else (fixture, seeds, knobs, live faculty builds) is IDENTICAL to
// state/1414_memory_tom_engine_compose/h1414_memory_tom_engine_probe.hexa — only the arbiter
// call is swapped: inlined `_arbiter(...)` → live `mem_tom_compose(...)`. If the numbers match
// the H_1414 card (compose 0.937778, all 4 bars PASS), the live op == the validated mechanism.

import "CORE/engine_cli.hexa"

fn _SEEDS() -> [int] { return [5400, 5401, 5402] }
const N_PER_FAMILY: int = 90
const COMPOSE_DELTA: float = 0.05
const ORACLE_MARGIN: float = 0.02
const SHUFFLE_TOL: float = 0.02
const AMBIG_NOISE: float = 0.10     // routing-cue jitter (== H_1414 fixture, replayed through the live op)

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
// deterministic LCG (== H_1414 probe's _lcg) — used by the shuffle control + the route jitter.
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
// the EXACT H_1414 fixture route cue (clean engine cue + the fixture's per-item jitter), so the
// live op reproduces the frozen 0.937778 byte-exact. The jitter is FIXTURE noise (kept here, NOT
// in the engine op); the live mem_tom_compose_routed receives this replayed route.
fn _fixture_route(q_is_reality: bool, seed: int, i: int) -> float {
    let mut r = mem_tom_route_cue(q_is_reality)
    r = r + AMBIG_NOISE * 0.25 * _stdnorm(seed, i, 9)
    if r < 0.0 { r = 0.0 }
    if r > 1.0 { r = 1.0 }
    return r
}

fn _obj_text(seed: int, i: int) -> string {
    return "obj_" + to_string(seed) + "_" + to_string(i)
}

// per-item family + structure: [fam, moved, q_is_reality, correct_class] (== H_1414 _item).
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut moved = 0.0
    let mut q_is_reality = 0.0
    let mut correct = 0.0
    if fam == 0 {
        moved = 1.0  q_is_reality = 1.0  correct = 1.0
    } else if fam == 1 {
        moved = 1.0  q_is_reality = 0.0  correct = 0.0
    } else if fam == 2 {
        moved = 0.0  q_is_reality = 1.0  correct = 0.0
    } else if fam == 3 {
        moved = 1.0  q_is_reality = 1.0  correct = 1.0
    } else {
        moved = 1.0  q_is_reality = 0.0  correct = 0.0
    }
    return [to_float(fam), moved, q_is_reality, correct]
}

// run_seed — score the FROZEN bars for one seed on the LIVE faculties + LIVE compose op.
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY

    let mut mem = immune_grow_new(immune_embed_key(_obj_text(seed, 0)), "basket", 2048, 2048, true)
    let mut tom = other_mind_new()
    let mut qreals: [float] = []
    let mut corrs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        qreals = qreals + [it[2]]  corrs = corrs + [it[3]]
        let obj = _obj_text(seed, b)
        let moved = it[1] > 0.5
        let reality = if moved { "box" } else { "basket" }
        let belief = "basket"
        mem = immune_grow_bind(mem, immune_embed_key(obj), reality, cfg)
        tom = other_mind_witness(tom, obj, belief)
        b = b + 1
    }

    // FIRST PASS: live decisions + live affinity-margin means (scale-relative normalizers).
    let mut mem_dec: [float] = []
    let mut tom_dec: [float] = []
    let mut sum_m = 0.0
    let mut sum_t = 0.0
    let mut i = 0
    while i < n {
        let obj = _obj_text(seed, i)
        let qk = immune_embed_key(obj)
        let rv = immune_grow_recall(mem, qk)
        let md = if rv == "box" { 1.0 } else { 0.0 }
        // LIVE margin via the wired op (== H_1414 _affinity_margin over mem.protos).
        let mm = mem_tom_mem_margin(mem, qk)
        mem_dec = mem_dec + [md]  sum_m = sum_m + _absf(mm)
        let pv = other_mind_predict(tom, obj)
        let td = if pv == "box" { 1.0 } else { 0.0 }
        let tm = mem_tom_tom_margin(tom, qk)
        tom_dec = tom_dec + [td]  sum_t = sum_t + _absf(tm)
        i = i + 1
    }
    let mem_mean = sum_m / to_float(n)
    let tom_mean = sum_t / to_float(n)

    // SECOND PASS: accuracies + compose (via LIVE mem_tom_compose) + oracle + decomposition.
    let mut on_m = 0  let mut on_t = 0  let mut on_c = 0  let mut on_oracle = 0
    let mut conflict = 0
    let mut only_m = 0  let mut only_t = 0  let mut both = 0  let mut neither = 0
    let mut j = 0
    while j < n {
        let md = mem_dec[j]  let td = tom_dec[j]  let ct = corrs[j]
        let obj = _obj_text(seed, j)
        let q_real = qreals[j] > 0.5
        // LIVE wired arbiter — reads the two live faculties, returns the composed class.
        // route = the EXACT H_1414 fixture cue (replayed) so this is a byte-exact rung-3 reproduction.
        let route_j = _fixture_route(q_real, seed, j)
        let comp_s = mem_tom_compose_routed(mem, tom, obj, route_j, mem_mean, tom_mean)
        let comp = if comp_s == "box" { 1.0 } else { 0.0 }
        let m_ok = md == ct
        let t_ok = td == ct
        if m_ok { on_m = on_m + 1 }
        if t_ok { on_t = on_t + 1 }
        if comp == ct { on_c = on_c + 1 }
        if m_ok || t_ok { on_oracle = on_oracle + 1 }
        if md != td { conflict = conflict + 1 }
        if m_ok && !t_ok { only_m = only_m + 1 }
        if t_ok && !m_ok { only_t = only_t + 1 }
        if m_ok && t_ok { both = both + 1 }
        if !m_ok && !t_ok { neither = neither + 1 }
        j = j + 1
    }

    // SHUFFLE control: permute which faculty-reads attach to which item, re-arbitrate via the
    // LIVE op. We permute the DECISION + which object's faculties feed the compose — to drive
    // mem_tom_compose under the shuffled pairing we recall against a permuted object key, so the
    // live op sees decorrelated grounding (the EARNED control collapses the routing).
    let mut perm_m: [int] = []
    let mut perm_t: [int] = []
    let mut s = 0
    while s < n { perm_m = perm_m + [s]  perm_t = perm_t + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = perm_m[a]  perm_m[a] = perm_m[r1]  perm_m[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = perm_t[a]  perm_t[a] = perm_t[r2]  perm_t[r2] = tmpb
        a = a - 1
    }
    // To keep the shuffle EXACTLY the H_1414 inlined-arbiter shuffle (it permutes mem_dec/tom_dec
    // + their margins, then calls the arbiter on routes[k]=current item), we reproduce that math
    // here using the SAME _mem_tom_affinity / _mem_tom_relconf / route inputs the live op uses
    // internally — the shuffle is a NEGATIVE control, not a live-faculty query, so it must match
    // the H_1414 inlined-arbiter byte-for-byte (decorrelated decisions, same arbiter arithmetic).
    let mut mem_mab: [float] = []
    let mut tom_mab: [float] = []
    let mut routes: [float] = []
    let mut p = 0
    while p < n {
        let obj = _obj_text(seed, p)
        let qk = immune_embed_key(obj)
        mem_mab = mem_mab + [mem_tom_mem_margin(mem, qk)]
        tom_mab = tom_mab + [mem_tom_tom_margin(tom, qk)]
        routes = routes + [_fixture_route(qreals[p] > 0.5, seed, p)]
        p = p + 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let mi = perm_m[k]  let ti = perm_t[k]
        let md = mem_dec[mi]  let td = tom_dec[ti]
        let m_rel = _absf(mem_mab[mi]) / (mem_mean + 0.000001)
        let t_rel = _absf(tom_mab[ti]) / (tom_mean + 0.000001)
        // inlined arbiter == the live op's CONFLICT branch (agree → shared vote).
        let mut comp = md
        if md != td {
            let mem_w = m_rel * routes[k]
            let tom_w = t_rel * (1.0 - routes[k])
            comp = if mem_w >= tom_w { md } else { td }
        }
        if comp == corrs[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let acc_m = to_float(on_m) / dn
    let acc_t = to_float(on_t) / dn
    let best = if acc_m >= acc_t { acc_m } else { acc_t }
    let acc_c = to_float(on_c) / dn
    let acc_s = to_float(on_s) / dn
    let acc_o = to_float(on_oracle) / dn
    return [acc_m, acc_t, best, acc_c, acc_s, acc_o,
            to_float(conflict) / dn,
            to_float(only_m) / dn, to_float(only_t) / dn,
            to_float(both) / dn, to_float(neither) / dn,
            to_float(immune_grow_cells(mem)), to_float(other_mind_count(tom))]
}

fn main() {
    println("================================================================================")
    println("H_1414 RUNG-3 — LIVE-OP re-run: arbiter via WIRED mem_tom_compose (CORE/engine_cli.hexa)")
    println("  re-scoring the SAME frozen H_1405 bars; MUST reproduce H_1414 engine-native numbers byte-exact")
    println("  $0 CPU · 3 seeds [5400,5401,5402] · p7 · p8 · a_verified_must_wire rung-3")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = _SEEDS()

    let mut acc_m = 0.0  let mut acc_t = 0.0  let mut best = 0.0
    let mut acc_c = 0.0  let mut acc_s = 0.0  let mut acc_o = 0.0
    let mut conf = 0.0  let mut o_m = 0.0  let mut o_t = 0.0  let mut bo = 0.0  let mut ne = 0.0
    let mut mc = 0.0  let mut tc = 0.0
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        println("  seed " + to_string(seeds[si]) + ": mem=" + _f4(r[0]) + " tom=" + _f4(r[1])
              + " best=" + _f4(r[2]) + " compose=" + _f4(r[3]) + " shuf=" + _f4(r[4])
              + " oracle=" + _f4(r[5]) + " | conflict=" + _f4(r[6])
              + " [onlyM=" + _f4(r[7]) + " onlyT=" + _f4(r[8]) + " both=" + _f4(r[9])
              + " neither=" + _f4(r[10]) + "] memCells=" + _f4(r[11]) + " tomCells=" + _f4(r[12]))
        acc_m = acc_m + r[0]  acc_t = acc_t + r[1]  best = best + r[2]
        acc_c = acc_c + r[3]  acc_s = acc_s + r[4]  acc_o = acc_o + r[5]
        conf = conf + r[6]  o_m = o_m + r[7]  o_t = o_t + r[8]  bo = bo + r[9]  ne = ne + r[10]
        mc = mc + r[11]  tc = tc + r[12]
        si = si + 1
    }
    acc_m = acc_m / ns  acc_t = acc_t / ns  best = best / ns
    acc_c = acc_c / ns  acc_s = acc_s / ns  acc_o = acc_o / ns
    conf = conf / ns  o_m = o_m / ns  o_t = o_t / ns  bo = bo / ns  ne = ne / ns  mc = mc / ns  tc = tc / ns

    println("--------------------------------------------------------------------------------")
    println("MEAN (3 seeds, LIVE WIRED OP):")
    println("  acc_memory  = " + _f4(acc_m))
    println("  acc_tom     = " + _f4(acc_t))
    println("  best_single = " + _f4(best))
    println("  acc_compose = " + _f4(acc_c))
    println("  acc_shuffle = " + _f4(acc_s))
    println("  ORACLE      = " + _f4(acc_o) + "   (oracle - best = " + _f4(acc_o - best) + ")")
    println("  conflict_rate = " + _f4(conf))
    println("  decomposition : only_memory=" + _f4(o_m) + " only_tom=" + _f4(o_t)
          + " both=" + _f4(bo) + " neither=" + _f4(ne))
    println("  (LIVE faculties: memory cells=" + _f4(mc) + " tom belief cells=" + _f4(tc) + ")")

    let B1 = acc_c >= best + COMPOSE_DELTA
    let B2 = (acc_o - best) > ORACLE_MARGIN
    let B3 = (acc_c - acc_s) > SHUFFLE_TOL
    let SEP = o_m > 0.0 && o_t > 0.0
    println("--------------------------------------------------------------------------------")
    println("  (B1 COMPOSE-EFFECT) compose " + _f4(acc_c) + " >= best+" + _f4(COMPOSE_DELTA)
          + " (" + _f4(best + COMPOSE_DELTA) + ") : " + (if B1 { "PASS" } else { "FAIL" }))
    println("  (B2 ORACLE)         oracle-best " + _f4(acc_o - best) + " > " + _f4(ORACLE_MARGIN)
          + " : " + (if B2 { "PASS" } else { "FAIL" }))
    println("  (B3 EARNED)         compose-shuffle " + _f4(acc_c - acc_s) + " > " + _f4(SHUFFLE_TOL)
          + " : " + (if B3 { "PASS" } else { "FAIL" }))
    println("  (SEPARABLE)         only_memory>0 AND only_tom>0 : " + (if SEP { "PASS" } else { "FAIL" }))
    println("================================================================================")
    if B1 && B2 && B3 && SEP {
        println("VERDICT: 🟢 RUNG-3 LIVE-OP REPRODUCES H_1414 — the WIRED mem_tom_compose op gives the")
        println("  same engine-native compose-lift (all 4 bars PASS). The arbiter is now OWNED by the engine.")
    } else {
        println("VERDICT: 🧱 — the live op did NOT reproduce the H_1414 bars (wire-in regression, c9).")
    }
    if !(B1 && B2 && B3 && SEP) { exit(1) }
}
