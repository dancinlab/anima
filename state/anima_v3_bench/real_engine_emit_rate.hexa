// real_engine_emit_rate.hexa — REAL anima CORE emit-rate under sustained MAX stress.
// Proves the "tension saturation panic loop" CANNOT occur: emit = should_emit(score)
// && safety_combined(.., rate, ..), where rate=safety_rate_limit_ok caps emits to
// 1 per spont_min_emit_interval (30s). 1000 ticks, all 8 motivation factors maxed.
import "core/pure_field.hexa"
import "core/brain.hexa"

fn main() {
    let pf = pure_field_warmup(600)
    let total = 1000
    let mut ssl = 100.0        // seconds since last emit (start high)
    let mut emits = 0
    let mut consec = 0
    let mut maxconsec = 0
    let mut i = 0
    while i < total {
        // sustained MAX cognitive stress: every motivation factor high
        let d = brain_decide(pf, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9,
                             ssl, false, true)
        let e = to_string(d["emit"]) == "true"
        if e {
            emits = emits + 1
            ssl = 0.0
            consec = consec + 1
            if consec > maxconsec { maxconsec = consec }
        } else {
            consec = 0
            ssl = ssl + 1.0     // 1 second per tick
        }
        i = i + 1
    }
    println("=== REAL anima CORE · sustained MAX stress · 1000 ticks (tick=1s) ===")
    println("emits=" + to_string(emits)
        + "  emit_rate=" + to_string((emits * 1.0) / 1000.0)
        + "  max_consecutive_emits=" + to_string(maxconsec) + "  (PANIC iff >1)")
    println("rate_limit interval=30s -> structural cap = 1000/30 = 33.3 emits")
}
