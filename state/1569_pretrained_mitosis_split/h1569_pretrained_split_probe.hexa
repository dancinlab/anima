// state/1569_pretrained_mitosis_split/h1569_pretrained_split_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1569 — PRETRAINED / INHERITED-REPRESENTATION mitosis split (H_1310 wall-break lens 3)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  THE WALL (H_1310 🔴 / H_1568 🧱): from-scratch pure-mitosis split-only learning hits a
//  LOCAL-EXPERT CEILING above the n-gram floor, and shuffle/random TIES targeted growth
//  (capacity-bound, not error-targeted). H_1568 lens-1 (selection-driven evolution) confirmed
//  the bottleneck is NOT the growth rule — it is the REPRESENTATION the cells partition: mitosis
//  tiles a FIXED, LOSSY feature (normalized symbol ids), so adding cells only refines a Voronoi
//  partition of information already thrown away. H_1310 card names the next angle verbatim:
//  "a richer (learned) embedding for the cells to partition (which could move the ceiling)."
//
//  THE USER'S CORE INSIGHT (lens 3, top priority): do NOT grow from scratch over a lossy
//  feature — split mitosis cells over an INHERITED representation (as a pretrained model
//  supplies). "Adult stem-cell division": each daughter cell inherits a rich representation
//  and specializes, instead of carving a lossy one from nothing.
//
//  ENGINE-NATIVE REALIZATION (a_engine_native_learning HARD-GATE): the live engine already owns
//  a complete next-byte MITOSIS LEARNER = OsmoticStore (core/engine_cli.hexa §Osmotic): a
//  VAdaptField key store (the engine's OWN _vnearest_idx / _l2 split geometry + engine_mitosis_tick
//  clonal growth under EngineConfig.mitosis) + a PARALLEL per-cell value table. osmotic_learn(...)
//  IS the live mitosis split: novel key → engine_mitosis_tick appends a (key,val) cell; else it
//  refines the winner. NO numpy, NO torch, NO .py mirror — pure .hexa via core/.
//
//  THE ONE CONTRAST (everything else held byte-identical):
//    • A_lossy  = keys are a LOSSY raw context feature (order-2 symbol pair → low-dim collinear
//                 embedding = the H_1310 lossy representation). Reproduces the ceiling.
//    • A_repr   = keys are an INHERITED RICHER representation = the engine's OWN immune_embed_key
//                 trigram-FNV DIM=64 encoder over the SAME context string (the high-separability
//                 representation a pretrained trunk would hand the cells to partition).
//    Value, corpus, contexts, split mechanism (osmotic_learn), cfg.mitosis ON, capacity cap,
//    held-out test set, CE metric — ALL identical. ONLY the key representation differs.
//
//  METRIC (p7 — NEVER perplexity-as-truth): held-out next-byte CROSS-ENTROPY in nats from the
//  nearest cell's learned value (add-1 smoothed). Plus the exact order-2 add-1 Markov n-gram
//  FLOOR — the load-bearing comparator H_1310/H_1568 used (lens1 floor was 2.50884).
//
//  FROZEN 5-BAR (frozen-first, set BEFORE the run — c9, NO tune-to-green):
//   B1 WALL-BREAK : A_repr CE < A_lossy CE − 0.10 nats  (inherited repr lifts mitosis below the
//                   lossy ceiling).
//   B2 ABLATION   : random-init keys (representation DESTROYED: each context → a random unit key)
//                   collapse A_repr back toward the lossy floor: CE_rand >= CE_repr + 0.10
//                   (proves the LIFT is the inherited representation, not "more dims / more cells").
//   B3 CAUSAL     : SHUFFLE the inherited key→context binding (key = embed of a DIFFERENT context)
//                   collapses A_repr: CE_shuf >= CE_repr + 0.10 (the key must CARRY the context).
//   B4 vs-FLOOR   : A_repr beats / ties the n-gram floor: CE_repr <= CE_floor + 0.02 (H_1310 lossy
//                   was +0.069 ABOVE the floor; report repr-floor AND lossy-floor).  [report+gate]
//   B5 CONTROL    : capacity — report cells_lossy vs cells_repr so the lift is not a cell-count
//                   artifact (both grow under cfg.mitosis ON). [report-only]
//
//  VERDICT: 🟢 GREEN iff B1 ∧ B2 ∧ B3. If A_repr does NOT beat A_lossy → honest 🧱
//  ("inherited representation alone does not lift split-only mitosis at this scale") is a valid
//  c9 result. ENGINE-NATIVE (pure .hexa via core/) → terminal PERMITTED.
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

let VOCAB = 27            // a-z (1..26) + space (0)
let DIM_LOSSY = 8         // lossy key dim (order-2 pair → collinear low dim)
let DIM_RAND = 64         // ablation random-key dim (match repr dim)
let MAX_CELLS = 512       // capacity cap (the H_1310 top rung)

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// byte→symbol id: 'a'..'z' → 1..26, else (space/newline) → 0.
fn _sym(c: string) -> int {
    let o = ord(c)
    if o >= 97 && o <= 122 { return o - 96 }
    return 0
}

// LOSSY key: order-2 symbol pair → DIM_LOSSY collinear dims (nearby ids → nearby key even when
// the next-byte dist differs — the information the n-gram floor keeps and this loses).
fn _key_lossy(s1: int, s2: int) -> [float] {
    let a = (s1 + 0.0) / (VOCAB + 0.0)
    let b = (s2 + 0.0) / (VOCAB + 0.0)
    let mut v = []
    let mut i = 0
    while i < DIM_LOSSY {
        if i % 2 == 0 { v = v + [a] } else { v = v + [b] }
        i = i + 1
    }
    let mut ss = 0.0
    let mut j = 0
    while j < DIM_LOSSY { ss = ss + v[j] * v[j]  j = j + 1 }
    let nrm = sqrt(ss)
    if nrm > 0.0 { let mut o = 0  while o < DIM_LOSSY { v[o] = v[o] / nrm  o = o + 1 } }
    return v
}

// deterministic per-pair pseudo-random unit key (B2 ablation: representation destroyed).
fn _key_rand(p: int) -> [float] {
    let mut st = (p * 2654435761 + 12345) & 4294967295
    let mut v = []
    let mut i = 0
    while i < DIM_RAND {
        st = (st * 1103515245 + 12345) & 4294967295
        v = v + [(st % 100000 + 0.0) / 100000.0]
        i = i + 1
    }
    let mut ss = 0.0
    let mut j = 0
    while j < DIM_RAND { ss = ss + v[j] * v[j]  j = j + 1 }
    let nrm = sqrt(ss)
    if nrm > 0.0 { let mut o = 0  while o < DIM_RAND { v[o] = v[o] / nrm  o = o + 1 } }
    return v
}

// one-hot next-byte value distribution (VOCAB atoms).
fn _val_onehot(sym: int) -> [float] {
    let mut v = []
    let mut i = 0
    while i < VOCAB { if i == sym { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return v
}

// add-1 smoothed cross-entropy of the true symbol under a value dist.
fn _ce_one(valdist: [float], truesym: int) -> float {
    let ALPHA = 0.30
    let mut s = 0.0
    let mut i = 0
    while i < VOCAB { s = s + valdist[i]  i = i + 1 }
    let p = (valdist[truesym] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))
    return 0.0 - ln(p)
}

// build the key for pair index p under selector sel (0=lossy 1=repr 2=rand 3=shuf).
fn build_key(sel: int, p: int, s1s: [int], s2s: [int], ctxstr: [string], n: int) -> [float] {
    if sel == 0 { return _key_lossy(s1s[p], s2s[p]) }
    if sel == 1 { return immune_embed_key(ctxstr[p]) }
    if sel == 2 { return _key_rand(p) }
    let q = (p * 7 + 3) % n
    return immune_embed_key(ctxstr[q])
}

// run one arm: train an OsmoticStore over the train split, score held-out CE. Returns [meanCE, cells].
fn run_arm(sel: int, s1s: [int], s2s: [int], nxt: [int], ctxstr: [string],
           ntrain: int, ntest: int, cfg: EngineConfig) -> [float] {
    let N = len(nxt)
    let k0 = build_key(sel, 0, s1s, s2s, ctxstr, N)
    let mut st = osmotic_store_new(k0, _val_onehot(nxt[0]), MAX_CELLS)
    let mut p = 1
    while p < ntrain {
        let k = build_key(sel, p, s1s, s2s, ctxstr, N)
        st = osmotic_learn(st, k, _val_onehot(nxt[p]), cfg, 0, 0.0, 0.30, -1.0)
        p = p + 1
    }
    let cells = osmotic_cells(st)
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let k = build_key(sel, t, s1s, s2s, ctxstr, N)
        let win = vadapt_field_nearest_idx(st.field, k)
        tot = tot + _ce_one(st.vals[win], nxt[t])
        t = t + 1
    }
    return [tot / (ntest + 0.0), cells + 0.0]
}

// exact order-2 add-1 Markov floor (n-gram comparator). ctx bucket = s1*VOCAB + s2.
fn ngram_floor(s1s: [int], s2s: [int], nxt: [int], ntrain: int, ntest: int) -> float {
    let NCTX = VOCAB * VOCAB
    let mut counts = []
    let mut ci = 0
    while ci < NCTX {
        let mut row = []
        let mut sj = 0
        while sj < VOCAB { row = row + [0.0]  sj = sj + 1 }
        counts = counts + [row]
        ci = ci + 1
    }
    let mut p = 0
    while p < ntrain {
        let ctx = s1s[p] * VOCAB + s2s[p]
        let mut row = counts[ctx]
        row[nxt[p]] = row[nxt[p]] + 1.0
        counts[ctx] = row
        p = p + 1
    }
    let ALPHA = 0.30
    let N = len(nxt)
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let ctx = s1s[t] * VOCAB + s2s[t]
        let row = counts[ctx]
        let mut s = 0.0
        let mut k = 0
        while k < VOCAB { s = s + row[k]  k = k + 1 }
        tot = tot + (0.0 - ln((row[nxt[t]] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))))
        t = t + 1
    }
    return tot / (ntest + 0.0)
}

fn main() {
    let cfg = engine_config_default()    // mitosis ON (p8 native)

    // REAL English byte corpus (fixed asset). /usr/share/dict/words, lowercased a-z+space,
    // newlines→space, fixed byte slice. Order-2 context → next symbol.
    let raw = exec("cat /usr/share/dict/words | tr 'A-Z' 'a-z' | tr -cd 'a-z\n' | tr '\n' ' ' | head -c 12000").trim()
    let blen = byte_len(raw)
    println("CORPUS bytes=" + str(blen))

    let mut s1s = []
    let mut s2s = []
    let mut nxt = []
    let mut ctxstr = []
    let mut i = 2
    while i < blen {
        s1s = s1s + [_sym(substring(raw, i - 2, i - 1))]
        s2s = s2s + [_sym(substring(raw, i - 1, i))]
        nxt = nxt + [_sym(substring(raw, i, i + 1))]
        ctxstr = ctxstr + [substring(raw, i - 2, i)]
        i = i + 1
    }
    let N = len(nxt)
    let ntrain = (N * 8) / 10
    let ntest = N - ntrain
    println("PAIRS N=" + str(N) + " train=" + str(ntrain) + " test=" + str(ntest))

    let r_lossy = run_arm(0, s1s, s2s, nxt, ctxstr, ntrain, ntest, cfg)
    let r_repr  = run_arm(1, s1s, s2s, nxt, ctxstr, ntrain, ntest, cfg)
    let r_rand  = run_arm(2, s1s, s2s, nxt, ctxstr, ntrain, ntest, cfg)
    let r_shuf  = run_arm(3, s1s, s2s, nxt, ctxstr, ntrain, ntest, cfg)

    let ce_lossy = r_lossy[0]
    let ce_repr  = r_repr[0]
    let ce_rand  = r_rand[0]
    let ce_shuf  = r_shuf[0]
    let cells_lossy = r_lossy[1]
    let cells_repr  = r_repr[1]
    let ce_floor = ngram_floor(s1s, s2s, nxt, ntrain, ntest)

    println("")
    println("=== H_1569 INHERITED-REPRESENTATION MITOSIS SPLIT — held-out next-byte CE (nats) ===")
    println("A_lossy (H_1310 ceiling)      CE = " + str(ce_lossy) + "   cells=" + str(cells_lossy))
    println("A_repr  (inherited repr)      CE = " + str(ce_repr)  + "   cells=" + str(cells_repr))
    println("A_rand  (B2 ablation)         CE = " + str(ce_rand))
    println("A_shuf  (B3 causal shuffle)   CE = " + str(ce_shuf))
    println("n-gram FLOOR (order-2 Markov) CE = " + str(ce_floor))
    println("")

    let b1 = ce_repr < (ce_lossy - 0.10)
    let b2 = ce_rand >= (ce_repr + 0.10)
    let b3 = ce_shuf >= (ce_repr + 0.10)
    let b4 = ce_repr <= (ce_floor + 0.02)
    let b5 = cells_repr == cells_lossy

    println("B1 WALL-BREAK  repr<lossy-0.10 : " + str(b1) + "  (repr " + str(ce_repr) + " vs lossy-0.10 " + str(ce_lossy - 0.10) + ")")
    println("B2 ABLATION    rand>=repr+0.10 : " + str(b2) + "  (rand " + str(ce_rand) + " vs repr+0.10 " + str(ce_repr + 0.10) + ")")
    println("B3 CAUSAL      shuf>=repr+0.10 : " + str(b3) + "  (shuf " + str(ce_shuf) + " vs repr+0.10 " + str(ce_repr + 0.10) + ")")
    println("B4 vs-FLOOR    repr<=floor+0.02: " + str(b4) + "  (repr " + str(ce_repr) + " vs floor+0.02 " + str(ce_floor + 0.02) + ")")
    println("   [report] repr-floor=" + str(ce_repr - ce_floor) + "  lossy-floor=" + str(ce_lossy - ce_floor) + "  (H_1310 lossy was +0.069)")
    println("B5 CONTROL     cells_repr==cells_lossy(report): " + str(b5) + "  (lossy " + str(cells_lossy) + " repr " + str(cells_repr) + ")")
    println("")

    let green = b1 && b2 && b3
    if green {
        println("VERDICT: GREEN ENGINE-NATIVE — inherited-representation mitosis BREAKS the H_1310 lossy ceiling (B1 and B2 and B3).")
    } else {
        println("VERDICT: WALL HOLDS (engine-native) — inherited representation does NOT lift split-only mitosis here (B1/B2/B3 not all true).")
    }
    println("B1=" + str(b1) + " B2=" + str(b2) + " B3=" + str(b3) + " B4=" + str(b4) + " B5report=" + str(b5))
}
