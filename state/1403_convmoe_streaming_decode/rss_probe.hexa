// rss_probe — decode GEN bytes via clm_decode_argmax on the small d768 clm.
// Used with /usr/bin/time -l to capture max RSS as a function of GEN.
import "CORE/clm_decode.hexa"
fn main() {
    let p = "state/lane_p_clm/clm_d768_e2l1.clm"
    let gen = to_int(env_var("RSS_GEN"))
    let t0 = now_ms()
    let r = clm_decode_argmax(p, "the ", gen)
    println("GEN=" + to_string(gen) + " ms=" + to_string(now_ms()-t0) + " text=" + to_string(r["text"]))
}
