// pertick_psi_meandev.hexa — H_9094 ENGINE-NATIVE metric-corrected re-measurement of H_9093.
// H_9093 measured the GENUINE per-tick feed (conflict_monitor recruited_depth → A⇄G iteration budget)
// but its pre-registered summary psi_MAXdev SATURATED: every arm (treatment/ablation/shuffle) has ≥1
// fully-unresolved tick, so MAX|Ψ-½| = the same range endpoint for all three → 3/3 bars FAIL + INERT
// even though the RAW per-tick data ordered treatment < shuffle < ablation. That is a METRIC-ARTIFACT
// (break-walls taxonomy-a: wrong measurement, bar unchanged). This harness fixes the SUMMARY (MAX→MEAN)
// and the Ψ GRANULARITY (8→24-trial population so tr_psi has k/24 resolution, not k/8), with FRESH bars
// pre-registered BEFORE running. This is NOT tune-to-green: the mechanism/design is identical to H_9093;
// only the distribution summary is corrected to one that does not saturate.
//
// ── PRE-REGISTERED BARS (frozen BEFORE running — c9; margins from PRINCIPLE not from H_9093 raw) ──
//   mean_dev_X = (1/nT) Σ_t |Ψ_t(arm X) − ½|   (average over-time distance from the fixed point)
//   BAR_MEAN_FUNCTIONAL : mean_dev_ablation − mean_dev_treatment > 0.05   (recruited_depth FUNCTIONAL:
//                          conflict-matched budget resolves Ψ→½ better than fixed low budget; margin 0.05
//                          = same as H_9093's pre-registered diff margin, inherited by principle.)
//   BAR_MEAN_EARNED     : mean_dev_shuffle  − mean_dev_treatment > 0.05   (coupling EARNED: scrambling the
//                          conflict→budget map degrades resolution; any assignment does NOT suffice.)
//   BAR_MEAN_PRESERVE   : mean_dev_treatment < 0.20                        (treatment keeps Ψ, on average,
//                          within 0.20 of ½ — meaningfully below the fully-unresolved 0.5; absolute Ψ-safety.)
//   EARNED_MONOTONE (INFO): recruited depth non-decreasing in conflict.
// VERDICT: GREEN iff FUNCTIONAL ∧ EARNED ∧ PRESERVE (per-tick feed Ψ-safe & functional under a non-saturating
//          metric). If any FAILS that is a VALID result (report, no tune). Ψ-risk (fable #5) MATERIALIZES only
//          if PRESERVE fails (mean_dev_treatment ≥ 0.20).
//
// usage: hexa run state/9094_pertick_psi_meandev/pertick_psi_meandev.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// build_row — one 15-lane trial: emit-drive lanes 0 & 4 = c, other 13 = other (H_9042 construction).
fn build_row(c: float, other: float) -> [float] {
    let mut r = []
    let mut i = 0
    while i < 15 {
        if i == 0 || i == 4 { r = r + [c] } else { r = r + [other] }
        i = i + 1
    }
    return r
}

// build_pop — CONFLICTED population, NG "high"/"low" trials each (finer Ψ granularity than H_9093's 4+4=8).
// NG=12 ⇒ 24-trial pop ⇒ tr_psi resolves to k/24 (vs k/8), so mean|Ψ-½| is a finer over-time read.
fn build_pop(c: float) -> [[float]] {
    let NG = 12
    let h = (9.0 - 2.0 * c) / 13.0
    let l = (6.0 - 2.0 * c) / 13.0
    let mut pop = []
    let mut t = 0
    while t < NG { pop = pop + [build_row(c, h)]  t = t + 1 }
    t = 0
    while t < NG { pop = pop + [build_row(c, l)]  t = t + 1 }
    return pop
}

fn adj_full() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 {
            if i == j { row = row + [0.0] } else { row = row + [1.0] }
            j = j + 1
        }
        a = a + [row]
        i = i + 1
    }
    return a
}

fn conflict_to_c(conflict: float) -> float { return 0.5 + 0.45 * conflict }
fn absf(x: float) -> float { if x >= 0.0 { return x } return 0.0 - x }

fn main() {
    let THR = 0.5
    let EPS = 0.06
    let ALPHA = 0.3
    let BIG = 600
    let cfgON  = EngineConfig { mitosis: true, engine: "conv", topo_couple: true,  savant: false }
    let full = adj_full()

    let aDr = [0.90, 0.25, 0.70, 0.50, 0.98, 0.30, 0.60, 0.85, 0.20, 0.75, 0.95, 0.40]
    let gDr = [0.95, 0.30, 0.75, 0.50, 0.98, 0.25, 0.65, 0.90, 0.20, 0.70, 1.00, 0.35]
    let nT = len(aDr)

    let mut conf = []
    let mut i = 0
    let mut cMin = 1.0e9
    let mut cMax = 0.0 - 1.0e9
    while i < nT {
        let c = conflict_scalar(aDr[i], 0.0 - gDr[i])
        conf = conf + [c]
        if c < cMin { cMin = c }
        if c > cMax { cMax = c }
        i = i + 1
    }

    // PRE-REGISTERED RULE: probe the substrate's OWN natural settle depth at min/max conflict.
    let rLo = tension_resolve_depth(build_pop(conflict_to_c(cMin)), full, ALPHA, THR, BIG, 2, EPS, cfgON)
    let rHi = tension_resolve_depth(build_pop(conflict_to_c(cMax)), full, ALPHA, THR, BIG, 2, EPS, cfgON)
    let D_lo = rLo[0]
    let D_hi = rHi[0]
    let base_budget = to_int(D_lo + 0.5)
    let mut max_extra = 0
    if cMax > 0.0 { max_extra = to_int((D_hi - D_lo) / cMax + 0.5) }
    if max_extra < 0 { max_extra = 0 }

    println("INFO conflicts: cMin=" + to_string(cMin) + " cMax=" + to_string(cMax))
    println("INFO natural settle depth: D_lo=" + to_string(D_lo) + " D_hi=" + to_string(D_hi))
    println("INFO RULE budgets: base_budget=" + to_string(base_budget) + " max_extra=" + to_string(max_extra))

    let perm = [5, 0, 9, 2, 11, 7, 1, 10, 3, 6, 4, 8]

    let mut dTreat = []
    i = 0
    while i < nT { dTreat = dTreat + [conflict_recruited_depth(conf[i], base_budget, max_extra)]  i = i + 1 }

    // MEAN accumulation (the fix): sum |Ψ-½| over ticks, divide by nT.
    let mut sum_treat = 0.0
    let mut sum_abl = 0.0
    let mut sum_shuf = 0.0
    let mut res_treat = 0     // resolved-fraction (INFO): ticks with |Ψ-½| < 0.10
    i = 0
    while i < nT {
        let cc = conflict_to_c(conf[i])
        let pop = build_pop(cc)

        let dT = dTreat[i]
        let rT = tension_resolve_depth(pop, full, ALPHA, THR, dT, 2, EPS, cfgON)
        let devT = absf(rT[1] - THR)
        sum_treat = sum_treat + devT
        if devT < 0.10 { res_treat = res_treat + 1 }

        let rA = tension_resolve_depth(pop, full, ALPHA, THR, base_budget, 2, EPS, cfgON)
        sum_abl = sum_abl + absf(rA[1] - THR)

        let dS = dTreat[perm[i]]
        let rS = tension_resolve_depth(pop, full, ALPHA, THR, dS, 2, EPS, cfgON)
        sum_shuf = sum_shuf + absf(rS[1] - THR)

        println("TICK " + to_string(i) + " conflict=" + to_string(conf[i])
              + " dTreat=" + to_string(dT) + " psiT=" + to_string(rT[1])
              + " | psiAbl=" + to_string(rA[1]) + " | dShuf=" + to_string(dS) + " psiShuf=" + to_string(rS[1]))
        i = i + 1
    }

    let nTf = to_float(nT)
    let mean_treat = sum_treat / nTf
    let mean_abl = sum_abl / nTf
    let mean_shuf = sum_shuf / nTf

    // EARNED-monotone over SORTED conflict.
    let mut sc = conf
    let mut a2 = 0
    while a2 < nT {
        let mut b2 = 0
        while b2 < nT - 1 {
            if sc[b2] > sc[b2 + 1] { let tmp = sc[b2]  sc[b2] = sc[b2 + 1]  sc[b2 + 1] = tmp }
            b2 = b2 + 1
        }
        a2 = a2 + 1
    }
    let mut monotone_ok = true
    i = 0
    let mut prev_d = 0.0 - 1.0
    while i < nT {
        let dv = to_float(conflict_recruited_depth(sc[i], base_budget, max_extra))
        if dv < prev_d - 0.0001 { monotone_ok = false }
        prev_d = dv
        i = i + 1
    }

    println("RESULT mean_dev_treatment=" + to_string(mean_treat))
    println("RESULT mean_dev_ablation="  + to_string(mean_abl))
    println("RESULT mean_dev_shuffle="   + to_string(mean_shuf))
    println("RESULT resolved_fraction_treatment=" + to_string(res_treat) + "/" + to_string(nT))
    println("RESULT earned_monotone=" + to_string(monotone_ok))

    let mut npass = 0
    let mut nfail = 0
    if _ab("BAR_MEAN_FUNCTIONAL: mean_dev_ablation - mean_dev_treatment > 0.05 (recruited_depth FUNCTIONAL)",
           mean_abl - mean_treat > 0.05) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR_MEAN_EARNED: mean_dev_shuffle - mean_dev_treatment > 0.05 (budget EARNED-tracks conflict)",
           mean_shuf - mean_treat > 0.05) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR_MEAN_PRESERVE: mean_dev_treatment < 0.20 (per-tick feed keeps Psi near half on average)",
           mean_treat < 0.20) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("EARNED_MONOTONE: recruited depth non-decreasing in conflict",
           monotone_ok) { npass=npass+1 } else { nfail=nfail+1 }

    println("--- H_9094 pertick psi mean-dev engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
