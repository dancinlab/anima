// pertick_conflict_budget.hexa — H_9093 ENGINE-NATIVE per-tick feed of conflict_monitor's
// recruited_depth into the A⇄G iteration budget, measuring whether the GENUINE per-tick coupling
// PRESERVES the Ψ=½ fixed point or DRIFTS it (the real Ψ-risk fable #5 flagged; the mount-time
// smoke of PR#2794 lanes 76-82 was co-located, NOT fed per-tick — this closes that gap).
//
// THE MECHANISM UNDER TEST (a genuine per-tick feed, NOT a mount co-location):
//   EACH TICK t over a sequence of A⇄G states (varying conflict tick-to-tick):
//     conflict_t = conflict_scalar(a_drive_t, g_drive_t)              (§ConflictMonitor H_9073)
//     d_t        = conflict_recruited_depth(conflict_t, base, extra)  → THIS tick's settle budget
//     r          = tension_resolve_depth(pop_t, adj, α, thr, d_t, op=2, eps, cfgON)  (§TensionResolveLoop H_9042)
//     psi_t      = r[1]                                               → Ψ AFTER settling with budget d_t
//   The recruited_depth enters the SETTLE-DEPTH budget ONLY (never emit lanes 0/4, never recall_thr) —
//   a_substrate_disjoint holds: Ψ is MEASURED (tr_psi/r[1]), the emit gate is NOT modified. The budget
//   knob is maxdepth of the A⇄G resolution loop (tension-resolve axis), disjoint from ci_emit_drive.
//
// WHY per-tick can move Ψ (the risk): the settle loop's FIXED POINT is Ψ=½ regardless of budget, but the
// budget controls whether a given tick REACHES it. A conflict-driven per-tick budget means high-conflict
// ticks (which polarize the population further from ½ and need MORE iterations) either GET the extra budget
// (earned recruitment → they settle → Ψ preserved) or DON'T (a fixed/scrambled budget → they under-settle →
// Ψ drifts off ½ across the tick sequence). The measurement asks which happens.
//
// ── PRE-REGISTERED BARS (frozen BEFORE running — c9, never moved; if Ψ drifts that is a VALID result) ──
//   The settle budgets are set by a PRE-REGISTERED RULE from the substrate's OWN measured settle curve
//   (NOT hand-tuned numbers): probe the natural settle depth (op=2, big cap) at the sequence's MIN-conflict
//   population (D_lo) and MAX-conflict population (D_hi); then
//       base_budget = round(D_lo)                      (floor = calmest tick's own requirement)
//       max_extra   = round((D_hi - D_lo)/maxConflict) (linear recruitment fit through the two measured
//                                                        endpoints; recruited(maxC) ≈ D_hi by construction)
//   BAR_PRESERVE   : psi_maxdev_treatment < 0.05  → the genuine per-tick feed KEEPS every tick's Ψ ≈ ½.
//   BAR_ABLATE_DIFF: psi_maxdev_ablation  > psi_maxdev_treatment + 0.05  → recruited_depth is FUNCTIONAL
//                    (fixed-budget baseline = recruited OFF fails to preserve Ψ for high-conflict ticks;
//                     if instead ablation ≈ treatment ⇒ INERT = recruited_depth changes nothing).
//   BAR_EARNED_SHUF: psi_maxdev_shuffle   > psi_maxdev_treatment + 0.05  → the coupling is EARNED
//                    (permuting the conflict→budget mapping across ticks BREAKS Ψ preservation — the
//                     budget must genuinely TRACK conflict; any assignment does not do).
//   EARNED-monotone (INFO): recruited depth non-decreasing in conflict (conflict_recruited_depth is
//                    linear in conflict by construction — reported as the mechanism check).
//
// VERDICT: GREEN iff BAR_PRESERVE ∧ BAR_ABLATE_DIFF ∧ BAR_EARNED_SHUF (per-tick feed Ψ-safe & functional).
//          🟠/RED if psi_maxdev_treatment ≥ 0.05 (the per-tick Ψ-risk MATERIALIZES — report loudly, no tune).
//          INERT if ablation ≈ treatment (recruited_depth does not change settle behavior).
//
// usage: hexa run state/9093_pertick_conflict_budget/pertick_conflict_budget.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// build_row — one 15-lane trial: emit-drive lanes 0 & 4 = c, other 13 = other (H_9042 construction).
fn build_row(c: float, other: float) -> [float] {
    let mut r = []
    let mut i = 0
    while i < 15 {
        if i == 0 || i == 4 { r = r + [c] } else { r = r + [other] }
        i = i + 1
    }
    return r
}

// build_pop — a CONFLICTED 8-trial population parameterised by emit-lane level c (H_9042 build_pop):
// 4 "high" trials (substrate mean 0.60) + 4 "low" trials (mean 0.40), all over-emitting (Ψ_init=1.0).
// A Ψ-preserving redistribution pulls each trial's emit lanes toward its substrate mean ⇒ 4 fall below
// ½, 4 stay above ⇒ Ψ resolves to 4/8 = ½. Higher c ⇒ emit lanes further above the trial mean ⇒ MORE
// settle iterations needed (BAR2 of H_9042: severe depth ≥ mild depth) = the load-bearing monotonicity.
fn build_pop(c: float) -> [[float]] {
    let h = (9.0 - 2.0 * c) / 13.0
    let l = (6.0 - 2.0 * c) / 13.0
    let mut pop = []
    let mut t = 0
    while t < 4 { pop = pop + [build_row(c, h)]  t = t + 1 }
    t = 0
    while t < 4 { pop = pop + [build_row(c, l)]  t = t + 1 }
    return pop
}

// adj_full — fully-connected uniform coupling (H_9042).
fn adj_full() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 {
            if i == j { row = row + [0.0] } else { row = row + [1.0] }
            j = j + 1
        }
        a = a + [row]
        i = i + 1
    }
    return a
}

// conflict level → emit-lane polarisation c ∈ [0.5, 0.95] (higher conflict ⇒ deeper settle requirement).
fn conflict_to_c(conflict: float) -> float {
    return 0.5 + 0.45 * conflict
}

fn absf(x: float) -> float { if x >= 0.0 { return x } return 0.0 - x }

fn main() {
    let THR = 0.5
    let EPS = 0.06
    let ALPHA = 0.3
    let BIG = 600            // probe cap for the natural (un-budgeted) settle-depth curve
    let cfgON  = EngineConfig { mitosis: true, engine: "conv", topo_couple: true,  savant: false }
    let full = adj_full()

    // ── the per-tick A⇄G state sequence: (a_drive, g_drive) per tick, conflict varies tick-to-tick,
    //    arranged NON-monotonically in time (high, calm, high, …) so psi_maxdev is a genuine over-time read.
    let aDr = [0.90, 0.25, 0.70, 0.50, 0.98, 0.30, 0.60, 0.85, 0.20, 0.75, 0.95, 0.40]
    let gDr = [0.95, 0.30, 0.75, 0.50, 0.98, 0.25, 0.65, 0.90, 0.20, 0.70, 1.00, 0.35]
    let nT = len(aDr)

    // conflict_t = conflict_scalar (A,G opposite-signed ⇒ competition); g NEGATIVE (opposition).
    let mut conf = []
    let mut i = 0
    let mut cMin = 1.0e9
    let mut cMax = 0.0 - 1.0e9
    while i < nT {
        let c = conflict_scalar(aDr[i], 0.0 - gDr[i])
        conf = conf + [c]
        if c < cMin { cMin = c }
        if c > cMax { cMax = c }
        i = i + 1
    }

    // ── PRE-REGISTERED RULE: probe the substrate's OWN natural settle depth at min/max conflict ──
    let rLo = tension_resolve_depth(build_pop(conflict_to_c(cMin)), full, ALPHA, THR, BIG, 2, EPS, cfgON)
    let rHi = tension_resolve_depth(build_pop(conflict_to_c(cMax)), full, ALPHA, THR, BIG, 2, EPS, cfgON)
    let D_lo = rLo[0]
    let D_hi = rHi[0]
    let base_budget = to_int(D_lo + 0.5)
    let mut max_extra = 0
    if cMax > 0.0 { max_extra = to_int((D_hi - D_lo) / cMax + 0.5) }
    if max_extra < 0 { max_extra = 0 }

    println("INFO conflicts: cMin=" + to_string(cMin) + " cMax=" + to_string(cMax))
    println("INFO natural settle depth: D_lo=" + to_string(D_lo) + " D_hi=" + to_string(D_hi))
    println("INFO RULE budgets: base_budget=" + to_string(base_budget) + " max_extra=" + to_string(max_extra))

    // ── per-tick loops: TREATMENT (recruited) · ABLATION (fixed base) · SHUFFLE (scrambled mapping) ──
    let perm = [5, 0, 9, 2, 11, 7, 1, 10, 3, 6, 4, 8]   // fixed scramble of conflict→budget mapping

    // treatment recruited depths per tick (also feed the shuffle control).
    let mut dTreat = []
    i = 0
    while i < nT {
        dTreat = dTreat + [conflict_recruited_depth(conf[i], base_budget, max_extra)]
        i = i + 1
    }

    let mut maxdev_treat = 0.0
    let mut maxdev_abl = 0.0
    let mut maxdev_shuf = 0.0
    i = 0
    while i < nT {
        let cc = conflict_to_c(conf[i])
        let pop = build_pop(cc)

        // TREATMENT: earned per-tick budget d_t = recruited_depth(conflict_t)
        let dT = dTreat[i]
        let rT = tension_resolve_depth(pop, full, ALPHA, THR, dT, 2, EPS, cfgON)
        let devT = absf(rT[1] - THR)
        if devT > maxdev_treat { maxdev_treat = devT }

        // ABLATION: recruited OFF → fixed budget = base_budget every tick
        let rA = tension_resolve_depth(pop, full, ALPHA, THR, base_budget, 2, EPS, cfgON)
        let devA = absf(rA[1] - THR)
        if devA > maxdev_abl { maxdev_abl = devA }

        // SHUFFLE: budget = the treatment depth of a DIFFERENT tick (conflict→budget mapping scrambled)
        let dS = dTreat[perm[i]]
        let rS = tension_resolve_depth(pop, full, ALPHA, THR, dS, 2, EPS, cfgON)
        let devS = absf(rS[1] - THR)
        if devS > maxdev_shuf { maxdev_shuf = devS }

        println("TICK " + to_string(i) + " conflict=" + to_string(conf[i]) + " c=" + to_string(cc)
              + " dTreat=" + to_string(dT) + " psiT=" + to_string(rT[1])
              + " | base=" + to_string(base_budget) + " psiAbl=" + to_string(rA[1])
              + " | dShuf=" + to_string(dS) + " psiShuf=" + to_string(rS[1]))
        i = i + 1
    }

    // EARNED-monotone over SORTED conflict: recruited_depth must be non-decreasing in conflict.
    let mut sc = conf
    let mut a2 = 0
    while a2 < nT {
        let mut b2 = 0
        while b2 < nT - 1 {
            if sc[b2] > sc[b2 + 1] { let tmp = sc[b2]  sc[b2] = sc[b2 + 1]  sc[b2 + 1] = tmp }
            b2 = b2 + 1
        }
        a2 = a2 + 1
    }
    let mut monotone_ok = true
    i = 0
    let mut prev_d = 0.0 - 1.0
    while i < nT {
        let dv = to_float(conflict_recruited_depth(sc[i], base_budget, max_extra))
        if dv < prev_d - 0.0001 { monotone_ok = false }
        prev_d = dv
        i = i + 1
    }

    println("RESULT psi_maxdev_treatment=" + to_string(maxdev_treat))
    println("RESULT psi_maxdev_ablation="  + to_string(maxdev_abl))
    println("RESULT psi_maxdev_shuffle="   + to_string(maxdev_shuf))
    println("RESULT earned_monotone=" + to_string(monotone_ok))

    let mut npass = 0
    let mut nfail = 0
    if _ab("BAR_PRESERVE: psi_maxdev_treatment < 0.05 (per-tick feed keeps Psi~half)",
           maxdev_treat < 0.05) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR_ABLATE_DIFF: ablation maxdev > treatment maxdev + 0.05 (recruited_depth FUNCTIONAL, not INERT)",
           maxdev_abl > maxdev_treat + 0.05) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR_EARNED_SHUF: shuffle maxdev > treatment maxdev + 0.05 (budget EARNED-tracks conflict)",
           maxdev_shuf > maxdev_treat + 0.05) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("EARNED_MONOTONE: recruited depth non-decreasing in conflict",
           monotone_ok) { npass=npass+1 } else { nfail=nfail+1 }

    let mut inert = false
    if absf(maxdev_abl - maxdev_treat) < 0.001 { inert = true }
    println("INFO INERT_check(ablation==treatment)=" + to_string(inert))
    println("--- H_9093 pertick conflict->budget engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
