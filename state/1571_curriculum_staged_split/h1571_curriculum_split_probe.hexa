// state/1571_curriculum_staged_split/h1571_curriculum_split_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1571 — CURRICULUM-STAGED split mitosis (H_1310 wall-break lens 4)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  THE WALL (H_1310 🔴 / H_1568 🧱 / H_1569 🧱 / H_1570 🧱): pure-mitosis split-only learning hits
//  a local-expert ceiling; lens 1 (selection) INERT, lens 3 (inherited fixed repr) +0.056 under bar,
//  lens 2 (lateral transfer of values) HURTS (blurs cell sharpness).
//
//  LENS 4 (curriculum-staged split, H_1534 budget-precondition precedent): a single online pass
//  splits cells wherever novelty fires — frequent/easy contexts grab cells FIRST and rare/hard
//  contexts may never get one (a budget+order problem). Biology grows capacity in STAGES (critical
//  periods: coarse structure first, fine specialization later). The missing structure: present the
//  corpus to mitosis in a CURRICULUM — STAGE 1 locks coarse cells on the most frequent contexts,
//  then LATER STAGES split ONLY on the residual-error (rare/hard) contexts the early cells own
//  poorly. Same total cells, but ALLOCATED by a staged error-curriculum instead of arrival order.
//
//  ENGINE-NATIVE (a_engine_native_learning HARD-GATE): the learner is the LIVE OsmoticStore
//  (core/engine_cli.hexa §Osmotic). The curriculum is the ORDER + GATING of osmotic_learn calls
//  over the engine's OWN split geometry — NO new mechanism, NO numpy/torch/.py mirror.
//
//  ARMS (corpus, keys=inherited immune_embed_key repr, test set, CE metric, cfg.mitosis byte-identical;
//  the ONLY difference is the PRESENTATION ORDER / staged gating of the SAME training pairs):
//    • A_flat       = single online pass in corpus order (== H_1569 A_repr, the ceiling).
//    • A_curriculum = STAGED: stage 1 = high-frequency contexts first (coarse cells), stage 2 =
//                     re-pass and split only where the current store predicts the true byte POORLY
//                     (residual-error-targeted late split, the curriculum lens).
//    • A_ablate     = curriculum schedule run but with the residual gate DISABLED (split anywhere,
//                     stage 2 == another flat pass) — isolates the residual-error TARGETING.
//    • A_shuf       = staged schedule over a RANDOM stage assignment (curriculum order destroyed) —
//                     causal control (the lift must ride the error-curriculum, not just 2 passes).
//
//  METRIC (p7): held-out next-byte CE (nats). Comparator: exact order-2 add-1 Markov floor.
//
//  FROZEN 5-BAR (frozen-first, BEFORE the run — c9, NO tune-to-green; 🟢 iff B1∧B2∧B3):
//   B1 BREAK    : CE_curriculum < CE_flat − 0.10
//   B2 ABLATION : CE_ablate >= CE_curriculum + 0.05 (disabling the residual gate removes the lift)
//   B3 CAUSAL   : CE_shuf >= CE_curriculum + 0.05 (random stage order removes the lift)
//   B4 vs-FLOOR : CE_curriculum <= CE_floor + 0.02 [report+gate]
//   B5 CONTROL  : report cells per arm (curriculum must NOT just use more cells than flat).
//
//  VERDICT: 🟢 GREEN iff B1∧B2∧B3. Else honest 🧱 (c9). ENGINE-NATIVE → terminal permitted.
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

let VOCAB = 27
let MAX_CELLS = 512

fn _sym(c: string) -> int {
    let o = ord(c)
    if o >= 97 && o <= 122 { return o - 96 }
    return 0
}
fn _val_onehot(sym: int) -> [float] {
    let mut v = []
    let mut i = 0
    while i < VOCAB { if i == sym { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return v
}
fn _ce_one(valdist: [float], truesym: int) -> float {
    let ALPHA = 0.30
    let mut s = 0.0
    let mut i = 0
    while i < VOCAB { s = s + valdist[i]  i = i + 1 }
    return 0.0 - ln((valdist[truesym] + ALPHA) / (s + ALPHA * (VOCAB + 0.0)))
}

// predict probability of true byte under the store's current nearest-cell value (for the residual gate).
fn _store_p_true(st: OsmoticStore, key: [float], truesym: int) -> float {
    let win = vadapt_field_nearest_idx(st.field, key)
    let vd = st.vals[win]
    let ALPHA = 0.30
    let mut s = 0.0
    let mut i = 0
    while i < VOCAB { s = s + vd[i]  i = i + 1 }
    return (vd[truesym] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))
}

// score held-out CE for a trained store over the inherited-repr keys.
fn score(st: OsmoticStore, ctxstr: [string], nxt: [int], ntrain: int, N: int) -> float {
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let win = vadapt_field_nearest_idx(st.field, immune_embed_key(ctxstr[t]))
        tot = tot + _ce_one(st.vals[win], nxt[t])
        t = t + 1
    }
    return tot / ((N - ntrain) + 0.0)
}

// FLAT arm: single online pass in corpus order.
fn arm_flat(ctxstr: [string], nxt: [int], ntrain: int, N: int, cfg: EngineConfig) -> [float] {
    let mut st = osmotic_store_new(immune_embed_key(ctxstr[0]), _val_onehot(nxt[0]), MAX_CELLS)
    let mut p = 1
    while p < ntrain {
        st = osmotic_learn(st, immune_embed_key(ctxstr[p]), _val_onehot(nxt[p]), cfg, 0, 0.0, 0.30, -1.0)
        p = p + 1
    }
    return [score(st, ctxstr, nxt, ntrain, N), osmotic_cells(st) + 0.0]
}

// CURRICULUM arm: stage 1 = high-frequency contexts first (by ctx bucket count over train),
// stage 2 = residual-error-targeted re-pass (split only where p(true) < RES_THRESH).
// mode: 1 = curriculum (residual gate ON), 0 = ablate (gate OFF, stage2 = flat re-pass),
//       2 = shuffled stage order (random first/second assignment).
fn arm_curriculum(mode: int, s1s: [int], s2s: [int], ctxstr: [string], nxt: [int],
                  ntrain: int, N: int, cfg: EngineConfig) -> [float] {
    let RES_THRESH = 0.50    // stage-2 split gate: re-learn only where current p(true) below this
    // ctx frequency over train (for stage ordering)
    let NCTX = VOCAB * VOCAB
    let mut freq = []
    let mut z = 0
    while z < NCTX { freq = freq + [0]  z = z + 1 }
    let mut c = 0
    while c < ntrain { let cx = s1s[c] * VOCAB + s2s[c]  freq[cx] = freq[cx] + 1  c = c + 1 }

    // stage assignment: stage1 = pairs whose ctx is in the top-frequency half; stage2 = the rest.
    // (mode 2 shuffled: assign stage by a deterministic pseudo-random bit instead of frequency.)
    let MEDIAN = ntrain / NCTX + 1   // coarse frequency cut
    let mut st = osmotic_store_new(immune_embed_key(ctxstr[0]), _val_onehot(nxt[0]), MAX_CELLS)

    // STAGE 1: coarse — learn the high-frequency (or shuffled-stage1) contexts.
    let mut p = 1
    while p < ntrain {
        let cx = s1s[p] * VOCAB + s2s[p]
        let mut in_stage1 = freq[cx] >= MEDIAN
        if mode == 2 {
            let h = (p * 2654435761 + 99) & 4294967295
            in_stage1 = (h % 2) == 0
        }
        if in_stage1 {
            st = osmotic_learn(st, immune_embed_key(ctxstr[p]), _val_onehot(nxt[p]), cfg, 0, 0.0, 0.30, -1.0)
        }
        p = p + 1
    }
    // STAGE 2: fine — re-pass the remaining (low-frequency / hard) contexts.
    let mut q = 1
    while q < ntrain {
        let cx = s1s[q] * VOCAB + s2s[q]
        let mut in_stage2 = freq[cx] < MEDIAN
        if mode == 2 {
            let h = (q * 2654435761 + 99) & 4294967295
            in_stage2 = (h % 2) == 1
        }
        if in_stage2 {
            let key = immune_embed_key(ctxstr[q])
            // residual gate: in curriculum mode, only LEARN where the store predicts poorly now.
            let mut learn = true
            if mode == 1 {
                let pt = _store_p_true(st, key, nxt[q])
                learn = pt < RES_THRESH
            }
            if learn {
                st = osmotic_learn(st, key, _val_onehot(nxt[q]), cfg, 0, 0.0, 0.30, -1.0)
            }
        }
        q = q + 1
    }
    return [score(st, ctxstr, nxt, ntrain, N), osmotic_cells(st) + 0.0]
}

fn ngram_floor(s1s: [int], s2s: [int], nxt: [int], ntrain: int, ntest: int) -> float {
    let NCTX = VOCAB * VOCAB
    let mut counts = []
    let mut ci = 0
    while ci < NCTX {
        let mut row = []
        let mut sj = 0
        while sj < VOCAB { row = row + [0.0]  sj = sj + 1 }
        counts = counts + [row]
        ci = ci + 1
    }
    let mut p = 0
    while p < ntrain {
        let ctx = s1s[p] * VOCAB + s2s[p]
        let mut row = counts[ctx]
        row[nxt[p]] = row[nxt[p]] + 1.0
        counts[ctx] = row
        p = p + 1
    }
    let ALPHA = 0.30
    let N = len(nxt)
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let ctx = s1s[t] * VOCAB + s2s[t]
        let row = counts[ctx]
        let mut s = 0.0
        let mut k = 0
        while k < VOCAB { s = s + row[k]  k = k + 1 }
        tot = tot + (0.0 - ln((row[nxt[t]] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))))
        t = t + 1
    }
    return tot / (ntest + 0.0)
}

fn main() {
    let cfg = engine_config_default()
    let raw = exec("cat /usr/share/dict/words | tr 'A-Z' 'a-z' | tr -cd 'a-z\n' | tr '\n' ' ' | head -c 12000").trim()
    let blen = byte_len(raw)
    let mut s1s = []
    let mut s2s = []
    let mut nxt = []
    let mut ctxstr = []
    let mut i = 2
    while i < blen {
        s1s = s1s + [_sym(substring(raw, i - 2, i - 1))]
        s2s = s2s + [_sym(substring(raw, i - 1, i))]
        nxt = nxt + [_sym(substring(raw, i, i + 1))]
        ctxstr = ctxstr + [substring(raw, i - 2, i)]
        i = i + 1
    }
    let N = len(nxt)
    let ntrain = (N * 8) / 10
    let ntest = N - ntrain
    println("CORPUS bytes=" + str(blen) + " PAIRS N=" + str(N) + " train=" + str(ntrain) + " test=" + str(ntest))

    let r_flat = arm_flat(ctxstr, nxt, ntrain, N, cfg)
    let r_cur  = arm_curriculum(1, s1s, s2s, ctxstr, nxt, ntrain, N, cfg)
    let r_abl  = arm_curriculum(0, s1s, s2s, ctxstr, nxt, ntrain, N, cfg)
    let r_shuf = arm_curriculum(2, s1s, s2s, ctxstr, nxt, ntrain, N, cfg)
    let ce_floor = ngram_floor(s1s, s2s, nxt, ntrain, ntest)

    let ce_flat = r_flat[0]
    let ce_cur  = r_cur[0]
    let ce_abl  = r_abl[0]
    let ce_shuf = r_shuf[0]

    println("")
    println("=== H_1571 CURRICULUM-STAGED split mitosis — held-out next-byte CE (nats) ===")
    println("A_flat       (corpus-order ceiling) CE = " + str(ce_flat) + "   cells=" + str(r_flat[1]))
    println("A_curriculum (staged+residual gate) CE = " + str(ce_cur)  + "   cells=" + str(r_cur[1]))
    println("A_ablate     (staged, gate OFF)     CE = " + str(ce_abl)  + "   cells=" + str(r_abl[1]))
    println("A_shuf       (random stage order)   CE = " + str(ce_shuf) + "   cells=" + str(r_shuf[1]))
    println("n-gram FLOOR (order-2 Markov)       CE = " + str(ce_floor))
    println("")

    let b1 = ce_cur < (ce_flat - 0.10)
    let b2 = ce_abl >= (ce_cur + 0.05)
    let b3 = ce_shuf >= (ce_cur + 0.05)
    let b4 = ce_cur <= (ce_floor + 0.02)

    println("B1 BREAK     curriculum<flat-0.10 : " + str(b1) + "  (cur " + str(ce_cur) + " vs flat-0.10 " + str(ce_flat - 0.10) + ")")
    println("B2 ABLATION  ablate>=cur+0.05     : " + str(b2) + "  (abl " + str(ce_abl) + " vs cur+0.05 " + str(ce_cur + 0.05) + ")")
    println("B3 CAUSAL    shuf>=cur+0.05       : " + str(b3) + "  (shuf " + str(ce_shuf) + " vs cur+0.05 " + str(ce_cur + 0.05) + ")")
    println("B4 vs-FLOOR  curriculum<=floor+0.02: " + str(b4) + "  (cur " + str(ce_cur) + " vs floor+0.02 " + str(ce_floor + 0.02) + ")")
    println("   [report] cur-floor=" + str(ce_cur - ce_floor) + "  flat-floor=" + str(ce_flat - ce_floor))
    println("")

    let green = b1 && b2 && b3
    if green {
        println("VERDICT: GREEN ENGINE-NATIVE — curriculum-staged split BREAKS the flat-order mitosis ceiling (B1 and B2 and B3).")
    } else {
        println("VERDICT: WALL HOLDS (engine-native) — curriculum-staged split does NOT lift split-only mitosis here (B1/B2/B3 not all true).")
    }
    println("B1=" + str(b1) + " B2=" + str(b2) + " B3=" + str(b3) + " B4=" + str(b4))
}
