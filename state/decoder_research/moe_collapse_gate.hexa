// ════════════════════════════════════════════════════════════════════════
// core/DECODER/moe_collapse_gate.hexa — M4b production collapse gate (LZ76 verdict)
//
// M4b production wiring 의 functional piece. D3(#1269) 가 확정: collapse 원인은
// router 결함이 *아니라* corpus skew/짧은 학습 → router redesign 불필요. production
// 은 이미 검증된 HARD top-1 router (M4b toy 🟢 PASS, gate 0.97/0.03 분화) + 본
// LZ76 collapse gate 로 구성. M4b fix = diverse corpus + n_steps↑ (구조변경 아님).
//
// LZ76 collapse measurer (D1 #1257 · UNIVERSE H_288 lz76 재사용 g61): healthy seq 의
// 정규화 LZ_norm ≥ 0.50, collapse seq ≪ (D1 실측: healthy 0.849 vs collapse 0.212,
// margin 0.637). detokenize 없이 token-id stream 만으로 register collapse 검출.
//
// 설계 계약: lz_norm 값은 caller (D1 lz76 measurer) 가 계산 — 본 gate 는 값만 받아
// 판정 (g61 lz76 중복 구현 금지 · decoupled). 반환은 실수 (training-time quality
// verdict — anima emit gate 아님, F-EMIT-4 범위 밖).
// ════════════════════════════════════════════════════════════════════════

// collapse-health 판정: lz_norm ≥ floor → 1.0 (healthy) · else 0.0 (collapsed).
// lz_norm = D1 lz76 measurer 가 sampled token-id seq 로 계산한 정규화 LZ rate.
pub fn moe_collapse_healthy(lz_norm: float, floor: float) -> float {
    return if lz_norm >= floor { 1.0 } else { 0.0 }
}

// default healthy floor — D1 measured (healthy 0.849 vs collapse 0.212).
pub fn moe_collapse_floor() -> float { return 0.50 }

// production router kind — HARD top-1 (soft=🟠 dense-collapse · hard=🟢 분화).
// M4b toy 검증: soft gate 0.5/0.5 (분화X) vs hard gate 0.97/0.03 (분화O · H_490 escape).
pub fn moe_prod_router_kind() -> string { return "hard-top1" }

pub fn moe_collapse_gate_summary() -> string {
    return "M4b production: HARD top-1 router (🟢 분화) + LZ76 collapse gate (healthy floor 0.50). D3(#1269) fix = diverse corpus + n_steps↑, NOT router redesign. lz_norm = caller D1 lz76 (g61 decoupled)."
}
