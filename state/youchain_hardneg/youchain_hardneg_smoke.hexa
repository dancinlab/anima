// youchain_hardneg_smoke.hexa — ENGINE-NATIVE hard-negative re-measurement of the D7 you-CHAIN
// (H_9085) impostor AUROC. Imports the LIVE core/engine_cli.hexa other_* ops (no torch/numpy —
// pure .hexa calling live core/, so it is the TERMINAL engine-native evidence).
//
// WHY: H_9085 / H_9037 report impostor-history AUROC(chain)=1.000. Fable's critique: the impostors
// there are drift along axes ORTHOGONAL to the predicted axis a_pred, so other_chain_fit (= the
// e_{a_pred} cosine component of the candidate increment) is ≈0 BY THE cos(90°)=0 IDENTITY — that is
// the θ=90° special case, not a measurement. This smoke re-measures with hard negatives:
//   • cone-neg θ ∈ {15,30,45,60,75,90}° : cand = renorm(wK + step·(cosθ·e_apred + sinθ·e_j)), j≠apred.
//       fit(cone) ≈ cosθ, so AUROC(θ) should COLLAPSE from 1.0 (θ=90) toward chance as θ→small.
//   • genuine HONESTIFIED with a φ∈[0°,12°] cone jitter (real drift is never axis-pure).
//   • mimic-neg (KILLER): cand = other_drift_exp(latestB, a_pred, step) — an attacker who read the
//       last-3 public waypoints and reproduced a_pred exactly. Its history differs but the 2-increment
//       window fit reads is perfectly replicated → AUROC(mimic) ≈ 0.50 (chance) if fit is only a
//       2-increment extrapolator (NOT a full-trajectory validator).
// Frozen pre-registered predictions (see DESIGN.md L2-1): θ≥60→~1.0 · θ=30→~0.80-0.90 ·
//   θ=15→~0.55-0.70 · mimic≈0.50. bar frozen-first, no post-hoc move.
//   usage: hexa run state/youchain_hardneg/youchain_hardneg_smoke.hexa
import "core/engine_cli.hexa"

// _amax_abs — dominant axis (largest |component|), first-wins ties. EXACT mirror of engine _argmax_abs.
fn _amax_abs(v: [float], n: int) -> int {
    let mut bi = 0
    let mut bv = 0.0 - 1.0
    let mut i = 0
    while i < n {
        let a = if v[i] < 0.0 { 0.0 - v[i] } else { v[i] }
        if a > bv { bv = a  bi = i }
        i = i + 1
    }
    return bi
}
// _wrapi — non-negative modulo into [0,dim). EXACT mirror of engine _wrap.
fn _wrapi(x: int, dim: int) -> int {
    let mut r = x - (x / dim) * dim
    if r < 0 { r = r + dim }
    return r
}

fn main() {
    let DIM = 8

    // ── Build the you-chain for interlocutor B: seed + 5 session-boundary anchors → K=6 waypoints. ──
    let seedB = other_new(DIM, 0)
    let mut chainB = other_chain_new(seedB)
    let mut curB = seedB
    let mut tk = 0
    while tk < 5 {                                 // drift axes (tk+1)%dim = 1,2,3,4,5 → monotone trend
        curB = other_drift(curB, tk, 0.30)
        chainB = other_chain_append(chainB, curB)
        tk = tk + 1
    }
    let cnt = other_chain_count(chainB)            // = 6
    let latestB = other_chain_latest(chainB)

    // wK vector (flat waypoint cnt-1) for candidate construction.
    let mut wKvec = []
    let baseK = (cnt - 1) * DIM
    let mut wi = 0
    while wi < DIM { wKvec = wKvec + [other_chain_component(chainB, baseK + wi)]  wi = wi + 1 }

    // Compute a_pred EXACTLY as other_chain_fit does (last-3 waypoint axis-gradient), so genuine
    // candidates land on the SAME predicted axis the live op reads.
    let mut dlast = []
    let mut dprev = []
    let bK  = (cnt - 1) * DIM
    let bK1 = (cnt - 2) * DIM
    let bK2 = (cnt - 3) * DIM
    let mut di = 0
    while di < DIM {
        dlast = dlast + [other_chain_component(chainB, bK + di)  - other_chain_component(chainB, bK1 + di)]
        dprev = dprev + [other_chain_component(chainB, bK1 + di) - other_chain_component(chainB, bK2 + di)]
        di = di + 1
    }
    let aK   = _amax_abs(dlast, DIM)
    let aKm1 = _amax_abs(dprev, DIM)
    let a_pred = _wrapi(aK + (aK - aKm1), DIM)
    println("INFO  K=" + to_string(cnt) + " a_pred=" + to_string(a_pred) + " (aK=" + to_string(aK) + " aKm1=" + to_string(aKm1) + ")")

    // frozen cos/sin table for θ ∈ {15,30,45,60,75,90}°
    let theta_deg = [15, 30, 45, 60, 75, 90]
    let cos_tab   = [0.9659, 0.8660, 0.7071, 0.5000, 0.2588, 0.0000]
    let sin_tab   = [0.2588, 0.5000, 0.7071, 0.8660, 0.9659, 1.0000]

    let NG = 24
    let mut rng = 20260702                          // frozen deterministic LCG seed

    // ── GENUINE (honestified, φ∈[0°,12°] cone jitter) : 24 fits ──
    let mut fg = []
    let mut gc = 0
    while gc < NG {
        rng = (rng * 1103515245 + 12345) & 2147483647
        let sj = (to_float(rng) / 2147483648.0) * 0.2079     // sin φ ∈ [0, sin12°]
        let cj = sqrt(1.0 - sj * sj)
        rng = (rng * 1103515245 + 12345) & 2147483647
        let step = 0.20 + (to_float(rng) / 2147483648.0) * 0.24   // step ∈ [0.20,0.44]
        rng = (rng * 1103515245 + 12345) & 2147483647
        let mut jax = rng - (rng / 7) * 7                    // 0..6
        if jax >= a_pred { jax = jax + 1 }                   // skip a_pred → j ≠ a_pred
        let mut raw = []
        let mut i = 0
        while i < DIM {
            let mut x = wKvec[i]
            if i == a_pred { x = x + step * cj }
            if i == jax    { x = x + step * sj }
            raw = raw + [x]
            i = i + 1
        }
        let u = self_chain_unit_of(raw, DIM)
        let cand = other_chain_latest(other_chain_from_flat(u, 1, DIM))
        fg = fg + [other_chain_fit(cand, chainB)]
        gc = gc + 1
    }

    // ── CONE-NEG per θ + AUROC(θ) ──
    let mut auroc_theta = []
    let mut mean_cone = []
    let mut ti = 0
    while ti < 6 {
        let cw = cos_tab[ti]
        let sw = sin_tab[ti]
        let mut fn_arr = []
        let mut nc = 0
        while nc < NG {
            rng = (rng * 1103515245 + 12345) & 2147483647
            let step = 0.20 + (to_float(rng) / 2147483648.0) * 0.24
            rng = (rng * 1103515245 + 12345) & 2147483647
            let mut jax = rng - (rng / 7) * 7
            if jax >= a_pred { jax = jax + 1 }
            let mut raw = []
            let mut i = 0
            while i < DIM {
                let mut x = wKvec[i]
                if i == a_pred { x = x + step * cw }
                if i == jax    { x = x + step * sw }
                raw = raw + [x]
                i = i + 1
            }
            let u = self_chain_unit_of(raw, DIM)
            let cand = other_chain_latest(other_chain_from_flat(u, 1, DIM))
            fn_arr = fn_arr + [other_chain_fit(cand, chainB)]
            nc = nc + 1
        }
        // pairwise AUROC (genuine vs this cone bucket): Σ[fg>fn] + ½[=]  / (NG*NG)
        let mut auc = 0.0
        let mut msum = 0.0
        let mut gi = 0
        while gi < NG {
            let mut ii = 0
            while ii < NG {
                if fg[gi] > fn_arr[ii] { auc = auc + 1.0 } else { if fg[gi] == fn_arr[ii] { auc = auc + 0.5 } }
                ii = ii + 1
            }
            msum = msum + fn_arr[gi]
            gi = gi + 1
        }
        auroc_theta = auroc_theta + [auc / to_float(NG * NG)]
        mean_cone = mean_cone + [msum / to_float(NG)]
        ti = ti + 1
    }

    // ── MIMIC-NEG (killer) : attacker reproduces a_pred via live other_drift_exp ──
    let mut fmim = []
    let mut mc = 0
    while mc < NG {
        rng = (rng * 1103515245 + 12345) & 2147483647
        let step = 0.20 + (to_float(rng) / 2147483648.0) * 0.24
        let cand = other_drift_exp(latestB, a_pred, step)     // history differs, 2-incr window replicated
        fmim = fmim + [other_chain_fit(cand, chainB)]
        mc = mc + 1
    }
    let mut auc_m = 0.0
    let mut msum_m = 0.0
    let mut gm = 0
    while gm < NG {
        let mut jj = 0
        while jj < NG {
            if fg[gm] > fmim[jj] { auc_m = auc_m + 1.0 } else { if fg[gm] == fmim[jj] { auc_m = auc_m + 0.5 } }
            jj = jj + 1
        }
        msum_m = msum_m + fmim[gm]
        gm = gm + 1
    }
    let auroc_mimic = auc_m / to_float(NG * NG)

    // ── mean genuine fit ──
    let mut mg = 0.0
    let mut mgi = 0
    while mgi < NG { mg = mg + fg[mgi]  mgi = mgi + 1 }
    let mean_gen = mg / to_float(NG)

    // ── report (verbatim, frozen bars) ──
    println("=== D7 you-chain HARD-NEGATIVE AUROC re-measurement (engine-native, live core/engine_cli.hexa) ===")
    println("INFO  mean_fit(genuine, phi<=12deg)=" + to_string(mean_gen))
    let mut pi = 0
    while pi < 6 {
        println("AUROC(theta=" + to_string(theta_deg[pi]) + "deg)=" + to_string(auroc_theta[pi])
              + "   mean_fit(cone)=" + to_string(mean_cone[pi]))
        pi = pi + 1
    }
    println("AUROC(mimic 2-incr replica)=" + to_string(auroc_mimic) + "   mean_fit(mimic)=" + to_string(msum_m / to_float(NG)))
    println("NOTE  theta=90deg bucket == the ORIGINAL H_9085 orthogonal-impostor AUROC (reproduction of 1.0).")

    // ── verdict fences (frozen pre-registered) ──
    let ok90  = auroc_theta[5] >= 0.95                       // orthogonal reproduces ~1.0
    let collapsed = auroc_theta[0] < auroc_theta[5] - 0.10   // AUROC collapses as theta shrinks (15 << 90)
    let mimchance = auroc_mimic <= 0.65                      // mimic near chance (fit=2-incr extrapolator)
    let chaingt = mean_gen >= 0.90                           // genuine still lands ~+1 (chain>single retained at wide angle)
    println("FENCE reproduce_orth(θ90>=0.95)=" + to_string(ok90)
          + "  collapse(θ15<θ90-0.10)=" + to_string(collapsed)
          + "  mimic_near_chance(<=0.65)=" + to_string(mimchance)
          + "  genuine_lands(mean>=0.90)=" + to_string(chaingt))
    println("--- youchain hard-negative engine-native smoke complete ---")
}
