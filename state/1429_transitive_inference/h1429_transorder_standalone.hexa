// h1429_transorder_standalone.hexa — self-contained engine-native proof of the
// TransOrder lane (H_1429 R2), NO imports. Mirrors the lane in CORE/engine_cli.hexa
// verbatim so the lane LOGIC can be verified on the pool host independent of the
// host-wide WorkMemBuffer tag-24 multiply blocker that halts the full engine_cli_smoke.
// (The smoke crashes at case_10 / wm_buffer_new on the released hexa 0.1.0-dispatch
// binary — a pre-existing x86_64-linux HexaVal int-tag bug, NOT this lane.)

struct TransOrder {
    items: [string], hi: [string], lo: [string], rank: [float],
    n_items: int, n_prem: int, ablate: bool
}
fn trans_order_new() -> TransOrder {
    return TransOrder { items: [], hi: [], lo: [], rank: [], n_items: 0, n_prem: 0, ablate: false }
}
fn trans_order_new_ablated() -> TransOrder {
    return TransOrder { items: [], hi: [], lo: [], rank: [], n_items: 0, n_prem: 0, ablate: true }
}
fn _to_idx(to: TransOrder, name: string) -> int {
    let mut i = 0
    while i < to.n_items { if to.items[i] == name { return i }  i = i + 1 }
    return -1
}
fn trans_order_premise(to: TransOrder, higher: string, lower: string) -> TransOrder {
    let mut items = to.items
    if _to_idx(to, higher) < 0 { items = items + [higher] }
    let to1 = TransOrder { items: items, hi: to.hi, lo: to.lo, rank: to.rank,
                           n_items: len(items), n_prem: to.n_prem, ablate: to.ablate }
    let mut items2 = to1.items
    if _to_idx(to1, lower) < 0 { items2 = items2 + [lower] }
    return TransOrder { items: items2, hi: to1.hi + [higher], lo: to1.lo + [lower],
                        rank: to1.rank, n_items: len(items2), n_prem: to1.n_prem + 1, ablate: to1.ablate }
}
fn trans_order_integrate(to: TransOrder) -> TransOrder {
    if to.ablate { return to }
    let mut rank = []
    let mut z = 0
    while z < to.n_items { rank = rank + [0.0]  z = z + 1 }
    let mut it = 0
    while it < 200 {
        let mut moved = false
        let mut k = 0
        while k < to.n_prem {
            let ih = _to_idx(to, to.hi[k])
            let il = _to_idx(to, to.lo[k])
            if rank[ih] >= rank[il] {
                let mid = (rank[ih] + rank[il]) / 2.0
                rank[ih] = mid - 0.5
                rank[il] = mid + 0.5
                moved = true
            }
            k = k + 1
        }
        if !moved { it = 200 } else { it = it + 1 }
    }
    return TransOrder { items: to.items, hi: to.hi, lo: to.lo, rank: rank,
                        n_items: to.n_items, n_prem: to.n_prem, ablate: to.ablate }
}
fn _to_observed_higher(to: TransOrder, x: string, y: string) -> string {
    let mut k = 0
    while k < to.n_prem {
        if to.hi[k] == x && to.lo[k] == y { return x }
        if to.hi[k] == y && to.lo[k] == x { return y }
        k = k + 1
    }
    return ""
}
fn trans_order_higher(to: TransOrder, x: string, y: string) -> string {
    let ix = _to_idx(to, x)
    let iy = _to_idx(to, y)
    if ix < 0 || iy < 0 { return "" }
    if to.ablate { return _to_observed_higher(to, x, y) }
    if to.rank[ix] < to.rank[iy] { return x }
    if to.rank[iy] < to.rank[ix] { return y }
    return ""
}
fn trans_order_item_higher(to: TransOrder, x: string, y: string) -> string {
    let ix = _to_idx(to, x)
    let iy = _to_idx(to, y)
    if ix < 0 || iy < 0 { return "" }
    return _to_observed_higher(to, x, y)
}
fn trans_order_shuffle(to: TransOrder, seed: int) -> TransOrder {
    let mut nhi = []
    let mut nlo = []
    let mut s = seed
    let mut k = 0
    while k < to.n_prem {
        s = (s * 1103515245 + 12345) % 2147483648
        if (s / 65536) % 2 == 0 { nhi = nhi + [to.lo[k]]  nlo = nlo + [to.hi[k]] }
        else                    { nhi = nhi + [to.hi[k]]  nlo = nlo + [to.lo[k]] }
        k = k + 1
    }
    return TransOrder { items: to.items, hi: nhi, lo: nlo, rank: [],
                        n_items: to.n_items, n_prem: to.n_prem, ablate: to.ablate }
}
fn trans_order_count(to: TransOrder) -> int { return to.n_items }

fn _chk(label: string, want: string, got: string) -> int {
    if want == got { println("PASS  " + label + " = " + got)  return 1 }
    println("FAIL  " + label + " want=" + want + " got=" + got)
    return 0
}

fn main() {
    let mut pass = 0
    let mut fail = 0
    // hidden order A>B>C>D>E ; present ONLY adjacent premises
    let base = trans_order_premise(trans_order_premise(trans_order_premise(
                   trans_order_premise(trans_order_new(), "A","B"), "B","C"), "C","D"), "D","E")
    let ti = trans_order_integrate(base)

    // 153 observed recall
    if _chk("159_observed_A>B", "A", trans_order_higher(ti,"A","B")) == 1 { pass=pass+1 } else { fail=fail+1 }
    // 154 transitive inference over UNOBSERVED pairs (order-independent)
    let infok = trans_order_higher(ti,"A","C") == "A" && trans_order_higher(ti,"C","A") == "A"
           && trans_order_higher(ti,"A","D") == "A" && trans_order_higher(ti,"A","E") == "A"
           && trans_order_higher(ti,"B","D") == "B" && trans_order_higher(ti,"B","E") == "B"
           && trans_order_higher(ti,"C","E") == "C"
    if _chk("160_infer_unobserved", "true", to_string(infok)) == 1 { pass=pass+1 } else { fail=fail+1 }
    // 155 item-store distinct: answers observed, ABSTAINS unobserved
    let idist = trans_order_item_higher(ti,"A","B") == "A"
             && trans_order_item_higher(ti,"A","C") == ""
             && trans_order_item_higher(ti,"B","E") == ""
    if _chk("161_item_abstains_unobserved", "true", to_string(idist)) == 1 { pass=pass+1 } else { fail=fail+1 }
    // 156 shuffle breaks integration
    let sh = trans_order_integrate(trans_order_shuffle(base, 1))
    let shbreak = trans_order_count(sh) == 5 && trans_order_higher(sh,"A","E") != "A"
    if _chk("162_shuffle_breaks", "true", to_string(shbreak)) == 1 { pass=pass+1 } else { fail=fail+1 }
    // 157 ablate collapses to lookup floor
    let abl = trans_order_integrate(trans_order_premise(trans_order_premise(trans_order_premise(
                  trans_order_premise(trans_order_new_ablated(), "A","B"), "B","C"), "C","D"), "D","E"))
    let ablf = trans_order_higher(abl,"A","B") == "A" && trans_order_higher(abl,"A","C") == ""
    if _chk("163_ablate_floor", "true", to_string(ablf)) == 1 { pass=pass+1 } else { fail=fail+1 }
    // 158 NO-FAB on unknown token
    let nofab = trans_order_higher(ti,"A","Z_absent") == "" && trans_order_higher(ti,"Q_absent","B") == ""
    if _chk("164_nofab_unknown", "true", to_string(nofab)) == 1 { pass=pass+1 } else { fail=fail+1 }
    // 159 infers global endpoints from local-only premises
    let glob = trans_order_higher(ti,"A","E") == "A" && trans_order_higher(ti,"E","A") == "A"
    if _chk("165_global_from_local", "true", to_string(glob)) == 1 { pass=pass+1 } else { fail=fail+1 }

    println("--- h1429 transorder standalone: " + to_string(pass) + " pass / " + to_string(fail) + " fail ---")
    if fail > 0 { exit(1) }
}
