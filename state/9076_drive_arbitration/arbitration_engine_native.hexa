// H_9076 drive_arbitration ENGINE-NATIVE — motivational winner-take-all + hysteresis on
// live core/engine_cli.hexa. drive_arbitrate(drives, hyst, prev_winner) = basal-ganglia
// central action-selection: incumbent HOLDS unless a challenger beats it by > hyst.
// usage: hexa run state/9076_drive_arbitration/arbitration_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn _argmax(v: [float]) -> int {
    let n = len(v)
    let mut best = 0
    let mut bestv = v[0]
    let mut i = 1
    while i < n {
        if v[i] > bestv { bestv = v[i]  best = i }
        i = i + 1
    }
    return best
}

fn main() {
    let cfg = engine_config_default()
    let N = 4                    // 4 competing drives: hunger, libido, curiosity, sleep-pressure
    let HYST = 0.05              // hysteresis band
    let T = 30                   // ticks for the dithering sweep

    // ── LIVE drive scalars from the engine (engine-native accessor reads) ──────────
    // small immune store the drive controllers read against.
    let mut mem = immune_grow_new(immune_embed_key("home"), "here", 32, 64, true)
    mem = immune_grow_bind(mem, immune_embed_key("food"), "fed", cfg)
    mem = immune_grow_bind(mem, immune_embed_key("mate"), "bond", cfg)
    // hunger: DEPRIVE — step the homeostat on an UNGROUNDED key (far from stored) → drive rises.
    let mut hd = homeo_new()
    let depk = immune_embed_key("zzzz_unknown_context")
    let mut s = 0
    while s < 6 { hd = homeo_step(hd, mem, depk)  s = s + 1 }
    let hunger = homeo_last(hd)
    // libido: step on a grounded/satiated cue → low wanting.
    let mut ld = libido_new()
    ld = libido_step(ld, mem, immune_embed_key("mate"), immune_embed_key("mate"))
    let libido = libido_last(ld)
    // curiosity: the affect feature read (novelty × under-exposure) on the deprived key.
    let curio = affect_substrate_features(mem, depk, "").curiosity
    // sleep-pressure: circadian phase (no dedicated Process-S scalar accessor exists —
    // clock_phase is the honest live proxy; noted in the card).
    let mut clk = clock_new()
    let mut c = 0
    while c < 3 { clk = clock_step(clk)  c = c + 1 }
    let sleepp = clock_phase(clk)
    let live = [hunger, libido, curio, sleepp]

    // ── BAR 1: decisive WTA — each drive boosted in turn wins (prev=-1, plain argmax) ──
    let mut wta = 0
    let mut d = 0
    while d < N {
        let mut v = [0.20, 0.20, 0.20, 0.20]
        v[d] = 0.80                         // clear dominant at index d
        if drive_arbitrate(v, HYST, -1) == d { wta = wta + 1 }
        d = d + 1
    }

    // ── BAR 2/3: near-boundary dithering — hysteresis vs ablation(hyst=0) ──────────────
    // two drives oscillate across the boundary each tick (gap 0.02 < HYST); count switches.
    let mut sw_hyst = 0
    let mut sw_abl = 0
    let mut prev_h = -1
    let mut prev_a = -1
    let mut t = 0
    while t < T {
        let mut vv = [0.50, 0.50, 0.10, 0.10]
        if t % 2 == 0 { vv[0] = 0.51  vv[1] = 0.49 } else { vv[0] = 0.49  vv[1] = 0.51 }
        let wh = drive_arbitrate(vv, HYST, prev_h)      // WITH hysteresis
        let wa = drive_arbitrate(vv, 0.0, prev_a)       // ABLATED (hyst=0)
        if prev_h >= 0 && wh != prev_h { sw_hyst = sw_hyst + 1 }
        if prev_a >= 0 && wa != prev_a { sw_abl = sw_abl + 1 }
        prev_h = wh
        prev_a = wa
        t = t + 1
    }

    // ── BAR 4: shuffle EARNED — winner tracks the TRUE dominant drive only with true labels ──
    // rotate which index is dominant; shuffle permutes the vector by +1 → returned index
    // no longer maps back to the intended semantic drive (selection label-meaningless).
    let mut acc_true = 0
    let mut acc_shuf = 0
    let mut k = 0
    while k < N {
        let dom = k                          // true dominant semantic drive index
        let mut vt = [0.20, 0.20, 0.20, 0.20]
        vt[dom] = 0.80
        if drive_arbitrate(vt, 0.0, -1) == dom { acc_true = acc_true + 1 }
        // SHUFFLE: permute labels by rotate-by-1 (dominant moves to (dom+1)%N).
        let mut vs = [0.20, 0.20, 0.20, 0.20]
        vs[(dom + 1) - ((dom + 1) / N) * N] = 0.80
        if drive_arbitrate(vs, 0.0, -1) == dom { acc_shuf = acc_shuf + 1 }   // expect FAIL
        k = k + 1
    }
    let earned = to_float(acc_true - acc_shuf) / to_float(N)

    // ── BAR 5: live-drive engine-native smoke — the 4 LIVE scalars arbitrate to argmax ──
    let live_win = drive_arbitrate(live, 0.0, -1)
    let live_ok = (live_win == _argmax(live))

    let mut np = 0
    if _ab("decisive WTA (each drive boosted wins, 4/4)", wta == N) { np = np + 1 }
    if _ab("hysteresis anti-dither (sw_hyst <= sw_abl/3)", to_float(sw_hyst) <= to_float(sw_abl) / 3.0) { np = np + 1 }
    if _ab("ablation(hyst=0) dithering spikes (sw_abl >= T/4)", to_float(sw_abl) >= to_float(T) / 4.0) { np = np + 1 }
    if _ab("shuffle EARNED (acc_true-acc_shuf >= 0.5)", earned >= 0.5) { np = np + 1 }
    if _ab("live-drive engine-native smoke (winner==argmax(live))", live_ok) { np = np + 1 }

    println("INFO live drives hunger=" + to_string(hunger) + " libido=" + to_string(libido)
        + " curiosity=" + to_string(curio) + " sleep=" + to_string(sleepp)
        + " live_win=" + to_string(live_win))
    println("INFO wta=" + to_string(wta) + "/" + to_string(N)
        + " sw_hyst=" + to_string(sw_hyst) + " sw_abl=" + to_string(sw_abl)
        + " acc_true=" + to_string(acc_true) + " acc_shuf=" + to_string(acc_shuf)
        + " earned=" + to_string(earned))
    println("--- H_9076 drive_arbitration engine-native: " + to_string(np) + " pass / " + to_string(5 - np) + " fail ---")
}
