// H_9072 substrate_nonequilibrium_dissipation ENGINE-NATIVE — Ψ=½ = NESS (σ_ep>0, broken detailed
// balance, Prigogine dissipative structure), DISTINCT from an equilibrium softmax LLM sampler.
// live A⇄G drift-diffusion on the emit-tension ring → σ_ep>0 (broken DB) vs THREE controls ≈0:
//   shuffle   = symmetrise transition matrix (time-reverse) → σ_ep~0
//   ablation  = Engine G reverse OFF (pfwd=pbwd, symmetric diffusion) → equilibrium relax σ_ep→0
//   LLM       = resample iid from own marginal (memoryless softmax sampler) → σ_ep≈0
// CHARACTERISATION/distinction property (engine-specific, like H_9041) — reports σ_ep numbers.
// STREAMING (O(nbins²) mem, no O(steps) sequence). usage: hexa run state/9072_substrate_nonequilibrium_dissipation/noneq_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let NBINS = 8
    let STEPS = 200000
    let SEED = 20260702

    // ── LIVE A⇄G: Engine A forward push (pfwd=0.45) ≠ Engine G reverse pull (pbwd=0.15) ⇒ net cycle
    let nLive = noneq_walk_counts(SEED, STEPS, NBINS, 450, 150)
    let s_live = noneq_sigma_ep(nLive)

    // ── ABLATION: Engine G reverse OFF ⇒ symmetric hops (pfwd=pbwd=0.30) ⇒ equilibrium diffusion
    let nAbl = noneq_walk_counts(SEED, STEPS, NBINS, 300, 300)
    let s_abl = noneq_sigma_ep(nAbl)

    // ── SHUFFLE: symmetrise (time-reverse) the LIVE empirical transition matrix ⇒ detailed balance
    let s_shuf = noneq_sigma_ep_symmetrised(nLive)

    // ── LLM control: memoryless softmax sampler with the LIVE marginal (next state iid) ⇒ DB
    let nLlm = noneq_iid_counts(nLive, STEPS, SEED)
    let s_llm = noneq_sigma_ep(nLlm)

    // control noise floor = the largest of the three ≈0 controls
    let mut floor = s_abl
    if s_shuf > floor { floor = s_shuf }
    if s_llm > floor { floor = s_llm }

    let mut np = 0
    if _ab("LIVE A<>G broken DB: sigma_ep > 0.05 (NESS)",            s_live > 0.05) { np = np + 1 }
    if _ab("ABLATION Engine G OFF: sigma_ep < 0.01 (equilibrium)",   s_abl  < 0.01) { np = np + 1 }
    if _ab("SHUFFLE symmetrised matrix: sigma_ep < 0.01 (DB)",       s_shuf < 0.01) { np = np + 1 }
    if _ab("LLM iid softmax sampler: sigma_ep < 0.01 (equilibrium)", s_llm  < 0.01) { np = np + 1 }
    if _ab("DISTINCTION: live > 10x control noise floor",            s_live > 10.0 * floor) { np = np + 1 }

    println("INFO sigma_ep  live=" + to_string(s_live)
        + "  ablation(G_off)=" + to_string(s_abl)
        + "  shuffle(sym)=" + to_string(s_shuf)
        + "  llm(iid)=" + to_string(s_llm)
        + "  ctrl_floor=" + to_string(floor))
    println("--- H_9072 substrate_nonequilibrium_dissipation engine-native: "
        + to_string(np) + " pass / " + to_string(5 - np) + " fail ---")
}
