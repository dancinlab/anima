// h1393_bpe_emit_probe.hexa — engine-native BINDING of the BPE-on-jamo morphology EMIT-BIAS (the
// H_1327 emit precedent applied to morphology; the EMIT-side follow-on of H_1390's SCORER). Drives the
// WIRED emit-bias consult gen_bpe_emit_eval / gen_bpe_consult_emit (CORE/generator.hexa §6.5e →
// engine_cli.hexa jamo_head_argmax over the § KO-MORPHOLOGY faculty) on the frozen corpus-free in-
// engine morpheme-grammar fixture and prints the three frozen bars + their thresholds.
//
//   bar1 EMIT-EFFECT : acc_on - acc_off >= +0.02 AND shift_on >= 0.10 (morphology biases emission)
//   bar2 EARNED      : acc_shuf - acc_off <= +0.01 (shuffle merges do NOT beat the blind baseline)
//   bar3 Ψ-SAFE      : off-Korean INERT (ASCII ctx → consult returns `base` unchanged) + guards
//
// $0 CPU, deterministic, no corpus/secret/GPU, Ψ-disjoint additive consult. usage: hexa run <this>.
import "CORE/generator.hexa"

fn main() {
    let e = gen_bpe_emit_eval_raw()   // R2 metric (un-aliased next-unit target; shuffle control KEPT)
    let acc_on  = to_float(e["acc_on"])
    let acc_off = to_float(e["acc_off"])
    let acc_shuf = to_float(e["acc_shuf"])
    let shift_on = to_float(e["shift_on"])
    let on_off  = to_float(e["on_minus_off"])
    let shuf_off = to_float(e["shuf_minus_off"])

    println("===== H_1393 BPE-on-jamo morphology — engine-native EMIT-BIAS =====")
    println(gen_bpe_emit_summary())
    println("")
    println("held-out next-UNIT accuracy (engine fixture, n=" + to_string(e["n_test"]) + "):")
    println("  ON   structured morphology head : " + to_string(acc_on))
    println("  OFF  representation-blind unigram: " + to_string(acc_off))
    println("  SHUF shuffle-merge head          : " + to_string(acc_shuf))
    println("  shift_on (ON changes vs OFF)     : " + to_string(shift_on))
    println("")

    // bar3a — off-Korean inertness: an ASCII (non-Korean) context must leave emission UNCHANGED.
    let jhS = gbe_grow_head_raw(0)[0]   // the SAME raw-band head the R2 metric reads
    let uvS = bpe_unit_vocab(bpe_learn_merges([0,1,2,3,4,5], [1,1,1,1,1,1], 40, 14, 0))
    let ascii_ctx = [104, 101, 108, 108, 111]   // "hello" — all bytes < 0x80, not Korean-like
    let base_byte = 120                          // the decode's own argmax byte ('x')
    let emit_ascii = gen_bpe_consult_emit(base_byte, jhS, uvS, ascii_ctx)
    let inert = emit_ascii == base_byte

    println("bar1 EMIT-EFFECT  on-off=" + to_string(on_off) + " >= 0.02 AND shift_on=" + to_string(shift_on)
            + " >= 0.10 -> " + (if on_off >= 0.02 && shift_on >= 0.10 { "PASS" } else { "FAIL" }))
    println("bar2 EARNED       shuf-off=" + to_string(shuf_off) + " <= 0.01 -> "
            + (if shuf_off <= 0.01 { "PASS" } else { "FAIL" }))
    println("bar3a Ψ-SAFE/inert  ASCII 'hello' base=" + to_string(base_byte) + " -> emit "
            + to_string(emit_ascii) + " (inert=" + to_string(inert) + ") -> "
            + (if inert { "PASS" } else { "FAIL" }))

    let bar1 = on_off >= 0.02 && shift_on >= 0.10
    let bar2 = shuf_off <= 0.01
    let bar3a = inert
    let green = bar1 && bar2 && bar3a
    println("")
    println("TIER (bars1+2+3a; full bar3 = smoke/h1196/h1205/h1164 guards run separately): " + (if green {
        "🟢 EMIT-BIAS ENGINE-NATIVE BINDING — the morphology unit reaches the decoder, the shift is earned, off-Korean inert"
    } else {
        "🟠/🧱 EMIT-NOT-EARNED-OR-NOT-Ψ-SAFE — a frozen bar missed (honest, c9; report verbatim, NO bar moved; H_1390 scorer remains valid)"
    }))
}
