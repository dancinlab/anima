// h1391_diag.hexa — R2 breakthrough test (a_break_the_wall): does the morphology emit-bias beat the
// blind baseline AND does the shuffle STILL collapse, under the un-aliased next-unit metric? If ON>OFF
// AND SHUF collapses → genuine R2 bind (the %K alias was the artifact). If SHUF also passes → honest 🧱
// (the metric was the lift, not the morphology). $0, investigation only.
import "CORE/generator.hexa"

fn main() {
    let e = gen_bpe_emit_eval_raw()
    let on = to_float(e["acc_on"])
    let off = to_float(e["acc_off"])
    let shuf = to_float(e["acc_shuf"])
    let shift = to_float(e["shift_on"])
    let onoff = to_float(e["on_minus_off"])
    let shoff = to_float(e["shuf_minus_off"])
    println("R2 un-aliased emit-effect:")
    println("  acc_on=" + to_string(on) + " acc_off=" + to_string(off) + " acc_shuf=" + to_string(shuf))
    println("  on-off=" + to_string(onoff) + " shuf-off=" + to_string(shoff) + " shift_on=" + to_string(shift))
    let bar1 = onoff >= 0.02 && shift >= 0.10
    let bar2 = shoff <= 0.01
    println("  bar1 EMIT-EFFECT (on-off>=0.02 & shift>=0.10): " + (if bar1 { "PASS" } else { "FAIL" }))
    println("  bar2 EARNED (shuf-off<=0.01): " + (if bar2 { "PASS" } else { "FAIL" }))
    println("  R2 verdict: " + (if bar1 && bar2 { "🟢 GENUINE BIND (alias was the artifact, shuffle collapses)" } else { "🧱 honest miss" }))
}
