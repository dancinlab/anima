// Lane C — fast-matmul forward validation.
//
// Proves the native-GEMM forward (bg_forward_last_W, mm path) is byte-faithful
// to the scalar reference forward (bytegpt_forward_last, untouched _bg_linear/
// _bg_mha) on the REAL 303M ByteGPT, and measures the single-token forward time.
//
// The scalar path is already torch-parity (argmax 32 for "The quick brown",
// H_1156). If the mm path matches the scalar path to ~machine-epsilon AND keeps
// argmax 32, byte-faithfulness is preserved by the speedup.
//
// arg1 = flat binary path (default the local /tmp serialize out).

import "CORE/bytegpt_decode.hexa"

fn absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn argmax256(a: int) -> int {
    let mut am = 0
    let mut mx = farr_get(a, 0)
    let mut k = 1
    while k < 256 { let v = farr_get(a, k); if v > mx { mx = v; am = k }; k = k + 1 }
    return am
}

fn main() {
    let path = "/tmp/verify303m/chat_full.bin"
    // "The quick brown" (15 bytes)
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    // HOIST the int-array subscript out of the farr_set value-arg: the hexa
    // C-transpile (dispatch) drops `farr_set(a,i,to_float(pb[i]))` to 0 when pb is
    // an i64-specialized literal array (ING#23 / i64-subscript codegen bug) → ids
    // read 0 → embedding tok[0] → argmax flips 227≠32. Hoisting fixes it (byte-exact).
    while i < T { let v = pb[i]; let _ = farr_set(ids, i, to_float(v)); i = i + 1 }

    // ── scalar reference path (file-read, untouched _bg_linear/_bg_mha) ──
    let ts0 = mono_ns()
    let lref = bytegpt_forward_last(path, ids, T)
    let ts1 = mono_ns()
    let amref = argmax256(lref)

    // ── fast mm path: bg_load (builds transposes once) then bg_forward_last_W ──
    let tl0 = mono_ns()
    let W = bg_load(path)
    let tl1 = mono_ns()
    // warm + timed mm forward (bg_load amortized over the 5-bar; measure the
    // per-token forward which is what the 5-bar repeats ~10000×)
    let tf0 = mono_ns()
    let lmm = bg_forward_last_W(W, ids, T)
    let tf1 = mono_ns()
    let ammm = argmax256(lmm)

    // ── byte-faithfulness: max abs diff scalar-vs-mm over 256 logits ──
    let mut maxd = 0.0
    let mut k = 0
    while k < 256 {
        let dlt = absf(farr_get(lmm, k) - farr_get(lref, k))
        if dlt > maxd { maxd = dlt }
        k = k + 1
    }

    println("SCALAR_FORWARD_MS " + to_string(to_float(ts1 - ts0) / 1000000.0))
    println("BG_LOAD_MS        " + to_string(to_float(tl1 - tl0) / 1000000.0))
    println("MM_FORWARD_MS     " + to_string(to_float(tf1 - tf0) / 1000000.0))
    println("SCALAR_ARGMAX     " + to_string(amref))
    println("MM_ARGMAX         " + to_string(ammm))
    println("MAX_ABS_DIFF      " + to_string(maxd))
    let mut s = "MM_FIRST8 "
    let mut j = 0
    while j < 8 { s = s + to_string(farr_get(lmm, j)) + " "; j = j + 1 }
    println(s)
    let _ = farr_free(lref); let _ = farr_free(lmm); let _ = farr_free(ids)
}
