// Lane C — MM-only forward timing + torch-golden byte-exactness.
//
// Isolates the fast native-GEMM forward (bg_forward_last_W) with NO slow scalar
// reference. Compares argmax + first-8 logits directly to the torch golden
// (chat_full_golden.json: argmax 32, first16 logits) for "The quick brown".
// Runs the forward 3× to get a warm steady-state per-token time (the 5-bar repeats
// the forward ~10000×, so steady-state is what matters).
//
// arg-free: path hardcoded to the summer/aiden parity-verify binary.

import "CORE/bytegpt_decode.hexa"

fn argmax256(a: int) -> int {
    let mut am = 0
    let mut mx = farr_get(a, 0)
    let mut k = 1
    while k < 256 { let v = farr_get(a, k); if v > mx { mx = v; am = k }; k = k + 1 }
    return am
}

fn main() {
    let path = "/tmp/lanec/chat_full.bin"
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    // hoist subscript — i64-subscript codegen bug (ING#23), else ids read 0 → argmax 227
    while i < T { let v = pb[i]; let _ = farr_set(ids, i, to_float(v)); i = i + 1 }

    let tl0 = mono_ns()
    let W = bg_load(path)
    let tl1 = mono_ns()

    // 3 forwards, report each (warm steady-state = run 2/3)
    let mut r = 0
    while r < 3 {
        let tf0 = mono_ns()
        let lg = bg_forward_last_W(W, ids, T)
        let tf1 = mono_ns()
        let am = argmax256(lg)
        let mut s = "RUN " + to_string(r) + " MS " + to_string(to_float(tf1 - tf0) / 1000000.0)
        s = s + " ARGMAX " + to_string(am) + " FIRST8"
        let mut j = 0
        while j < 8 { s = s + " " + to_string(farr_get(lg, j)); j = j + 1 }
        println(s)
        let _ = farr_free(lg)
        r = r + 1
    }
    println("BG_LOAD_MS " + to_string(to_float(tl1 - tl0) / 1000000.0))
    let _ = farr_free(ids)
}
