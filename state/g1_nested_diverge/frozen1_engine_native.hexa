// frozen1_engine_native.hexa — H_9122 FROZEN-1 recall-vs-recombine, ENGINE-NATIVE.
// Verifies the numpy-DIRECTIONAL result (state/g1_nested_diverge/frozen1_recall_recombine.py)
// on the LIVE core/engine_cli.hexa ImmuneMemory ops (immune_embed_key + recall). No 303M mouth,
// no torch/numpy mirror — this IS the engine. usage: hexa run <this>.
// Question: does the hippo lane surface a NOVEL cross (A,D), or only recall a WHOLE stored pair?
import "core/engine_cli.hexa"

// substring contains (byte-level) — is `needle` present in `hay`?
fn _contains(hay: string, needle: string) -> bool {
    let hl = byte_len(hay)
    let nl = byte_len(needle)
    if nl == 0 { return true }
    if nl > hl { return false }
    let mut i = 0
    while i <= hl - nl {
        if substring(hay, i, i + nl) == needle { return true }
        i = i + 1
    }
    return false
}

// does the recalled value span BOTH parent keywords (= recombination, not single-parent recall)?
fn _spans_both(val: string, kwA: string, kwB: string) -> bool {
    return _contains(val, kwA) && _contains(val, kwB)
}

fn main() {
    let cfg = engine_config_default()
    println("=== FROZEN-1 recall-vs-recombine — ENGINE-NATIVE (core ImmuneMemory ops) ===")

    // Write-phase: (A,B) and (C,D) as 2 SEPARATE cells. (A,D) never co-stored.
    // A=ocean B=music C=forest D=engine ; keyword per atom in the composite value.
    let valAB = "the ocean wave and the music song together"
    let valCD = "the forest tree and the engine motor together"
    let mut mem = immune_memory_new_text("ocean music", valAB, 2048)
    mem = immune_memory_bind_text(mem, "forest engine", valCD, cfg)
    let ncell = immune_memory_cells(mem)
    println("  cells=" + to_string(ncell) + " (invariant 2)")

    // Read-phase: 3 novel cross probes. FIRE iff recall_margin <= 0 (recon_err <= recall_thr 0.15).
    let mut hits = 0
    // cross (A,D): ocean+engine
    let rAD = immune_memory_recall_text(mem, "ocean engine")
    let mAD = immune_memory_recall_margin_text(mem, "ocean engine")
    let fAD = mAD <= 0.0
    let sAD = fAD && _spans_both(rAD, "ocean", "engine")
    if sAD { hits = hits + 1 }
    println("  [A,D ocean+engine] fire=" + to_string(fAD) + " margin=" + to_string(mAD) + " spans_both=" + to_string(sAD) + " val=" + rAD)
    // cross (B,C): music+forest
    let rBC = immune_memory_recall_text(mem, "music forest")
    let mBC = immune_memory_recall_margin_text(mem, "music forest")
    let fBC = mBC <= 0.0
    let sBC = fBC && _spans_both(rBC, "music", "forest")
    if sBC { hits = hits + 1 }
    println("  [B,C music+forest] fire=" + to_string(fBC) + " margin=" + to_string(mBC) + " spans_both=" + to_string(sBC) + " val=" + rBC)
    // cross (A,C): ocean+forest
    let rAC = immune_memory_recall_text(mem, "ocean forest")
    let mAC = immune_memory_recall_margin_text(mem, "ocean forest")
    let fAC = mAC <= 0.0
    let sAC = fAC && _spans_both(rAC, "ocean", "forest")
    if sAC { hits = hits + 1 }
    println("  [A,C ocean+forest] fire=" + to_string(fAC) + " margin=" + to_string(mAC) + " spans_both=" + to_string(sAC) + " val=" + rAC)

    // Controls
    println("  --- controls ---")
    let mSCR = immune_memory_recall_margin_text(mem, "planet guitar")  // both unstored -> must ABSTAIN
    let scrAbstain = mSCR > 0.0
    println("  C-SCRAMBLE planet+guitar: fire=" + to_string(mSCR <= 0.0) + " (must ABSTAIN=" + to_string(scrAbstain) + ")")
    let rBASE = immune_memory_recall_text(mem, "ocean music")          // verbatim -> must FIRE valAB
    let mBASE = immune_memory_recall_margin_text(mem, "ocean music")
    let baseFire = mBASE <= 0.0
    let baseSpans = baseFire && _spans_both(rBASE, "ocean", "music")
    println("  C-RECALL-BASELINE ocean+music: fire=" + to_string(baseFire) + " spans_both=" + to_string(baseSpans) + " (store alive)")
    let rWD = immune_memory_recall_text(mem, "ocean plasma")           // D' unstored
    let mWD = immune_memory_recall_margin_text(mem, "ocean plasma")
    println("  C-WRONG-D ocean+plasma: fire=" + to_string(mWD <= 0.0) + " val=" + rWD)

    // Verdict (frozen bar): HIT iff >=2/3 cross spans_both AND SCRAMBLE abstains AND baseline fires.
    let crossPass = hits >= 2
    let hit = crossPass && scrAbstain && baseFire
    println("  ================================================")
    println("  cross spans_both = " + to_string(hits) + "/3 (need >=2)")
    println("  C-SCRAMBLE ABSTAIN=" + to_string(scrAbstain) + "  C-RECALL-BASELINE FIRE=" + to_string(baseFire))
    if hit {
        println("  VERDICT (ENGINE-NATIVE): HIT — lane surfaces novel cross (reframe REAL)")
    } else {
        println("  VERDICT (ENGINE-NATIVE): MISS — lane 4/4 = stored-pair RECALL not recombination")
        println("  (recall returns whole stored value; no compose-read op; access != binding)")
    }
    println("=== FROZEN1_ENGINE_NATIVE_DONE ===")
}
