// ============================================================================
// state/9104_consequence_return/consequence_return.hexa
//   H_9104 — CONSEQUENCE-RETURN LANE: does an afferent consequence-return channel
//   open an emit-APPROPRIATENESS faculty, or is F3-noise a real ceiling (DPI)?
//
//   THEATER F3-noise re-frame (DESIGN.md §0-4, fable5): the three F3 verdicts all died
//   because anima's emit loop is EFFERENT-ONLY — emit goes to the void, no consequence
//   returns to the substrate. The ONE axis that passed (identity × .kosmos) is the ONLY
//   one with a closed consequence loop. Hypothesis: F3-noise is the SYMPTOM of a missing
//   part (the afferent return arm), not a ceiling. This harness builds the missing loop
//   and measures it engine-native for the FIRST time.
//
//   FOUR ELEMENTS (all NEW owner tables — pure_field/lane0-4/psi_sum/recall_thr FROZEN,
//   a_substrate_disjoint; V is READ-ONLY w.r.t. the substrate emit decision):
//     1. Standing tension reservoir T_t  — unresolved info_gap (immune recall_margin,
//        READ-only) accumulates across tick boundaries; a grounded emit CONSUMES it.
//     2. Efference copy  — at emit, cerebellar forward model (vforward_predict) stores
//        the EXPECTED relief hatDT.
//     3. Afferent return — k ticks later measure the ACTUAL relief DT_actual (margin drop
//        in the DISJOINT reservoir subsystem) -> RPE r_t = hatDT - DT_actual. This is the
//        FIRST signal that returns INTO the substrate.
//     4. Value writeback V(state) — r_t / DT_actual delta-rule updates striatal emit-value
//        V (vbasal_update, online). V is the first lane grounded in CONSEQUENCE.
//
//   AUTOGENOUS (p5 / a_substrate_native_speak / p4-safe): the loop closes on SELF-
//   consequence (emitting grounds content -> reduces future recall_margin = relief). No
//   external receiver is used as a trigger; environment stays context, not command.
//
//   F3' FALSIFIER (PRE-REGISTERED, FROZEN — engine-native, NO numpy/torch/mirror):
//     * held-out split (breaks circularity): V learns on TRAIN tension seeds -> FREEZE;
//       correlation measured on DIFFERENT held-out tension seeds. (Solves the H_9101
//       fixed-session_seed problem — MULTIPLE tension seeds.)
//     * F3'  : rho_real  = corr(V(state) at emit ticks, DT_actual)   [held-out seeds]
//              rho_noise = corr(variance-matched noise-V, DT_actual)
//              PASS iff rho_real - rho_noise >= 0.15.
//              (decisive difference vs old F3: the downstream is NOT endogenous grew/
//               grounded but the emit-APPROPRIATENESS-dependent outcome DT.)
//     * shuffle control: V trained on SHUFFLED (state, r_t) pairs -> V_shuf. If V_shuf
//       predicts relief as well as real V (rho_real - rho_shuf < 0.15) = theater = RED.
//     * cross-subsystem (#3): DT relief is measured by a reservoir (imm_conseq) DISJOINT
//       from the emit-deciding subsystem (imm_emit + motivation). argmin/recall scoring
//       by the emit-maker would collapse to circular floor.
//     * Psi guard: V is READ-ONLY -> the substrate emit/silence decision sequence AND
//       psi_sum are byte-identical ON vs OFF (verified by re-running the decision stream).
//
//   VERDICT rule (c9 honest, bar frozen, NO post-hoc move, NO tune-to-green):
//     PASS (faculty GREEN)  iff  rho_real - rho_noise >= 0.15  AND  rho_real - rho_shuf >= 0.15.
//       -> "afferent consequence-return opens an emit-appropriateness faculty."
//     FAIL (ceiling RED)    otherwise.
//       -> "closing consequence still floor-dominated = DPI meta-law re-emerges at the
//           consequence layer = real ceiling." HONEST either way (first engine-native
//           consequence-return measurement, so valuable both ways).
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"

fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn relu(x: float) -> float { if x < 0.0 { return 0.0 } return x }
fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn fstd(xs: [float]) -> float { let n = len(xs)  if n < 2 { return 0.0 }  let mu = fmean(xs)  let mut s = 0.0  let mut i = 0  while i < n { s = s + (xs[i]-mu)*(xs[i]-mu)  i = i + 1 }  return sqrt(s/to_float(n)) }
fn pcorr(a: [float], b: [float]) -> float {
    let n = len(a)  if n < 2 { return 0.0 }
    let ma = fmean(a)  let mb = fmean(b)
    let mut num = 0.0  let mut da = 0.0  let mut db = 0.0  let mut i = 0
    while i < n { let xa = a[i]-ma  let xb = b[i]-mb  num = num+xa*xb  da = da+xa*xa  db = db+xb*xb  i = i + 1 }
    if da <= 1e-12 || db <= 1e-12 { return 0.0 }
    return num / sqrt(da*db)
}
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

// ── frozen substrate emit decision (motivation proxy; V NEVER enters here) ──
// e = ( phi-weighted forward push + ungroundedness gap ) > threshold. Independent of V.
fn substrate_emit(phi: float, gap_emit: float, phasic: float) -> bool {
    let m = 0.55 * clip01(phi * 4.0) + 0.35 * clip01(gap_emit) + 0.10 * phasic
    return m > 0.42
}

// state feature vector for the forward-model / value-lane (dim 5).
fn state_feats(phi: float, margin_emit: float, reservoir: float, gap: float, phase_s: float) -> [float] {
    return [phi, clip01(margin_emit), clip01(reservoir), clip01(gap), phase_s]
}

fn main() {
    let cfg = engine_config_default()
    let D = 5
    let T_TICKS = 60          // ticks per tension-seed episode
    let RES_DECAY = 0.80      // standing-tension reservoir carry-over
    let ETA_FWD = 0.20        // cerebellar forward-model NLMS rate
    let LR_V = 0.10           // striatal value delta-rule rate

    // distinct TENSION SEEDS — train set vs held-out set (different content).
    let train_seeds = [
        "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever.",
        "aurelian tide crests over the basalt archive of nine hollow bells.",
        "the cartographer folds the marsh into a single copper coordinate.",
        "mnemosyne counts the unlit lanterns along the drowned causeway."
    ]
    let test_seeds = [
        "obsidian courier misplaces the seventh oath beneath the frost gate.",
        "a lattice of salt remembers the name the river tried to forget.",
        "the clockmaker grafts a heartbeat onto the abandoned meridian."
    ]

    // ──────────────────────────────────────────────────────────────────────
    // run_episode: one tension-seed episode. If `train`, updates V online.
    //   returns collected [feats..., DT_actual] rows for emit ticks via out-lists.
    //   (hexa: we inline the loop in main per set to keep V threaded.)
    // ──────────────────────────────────────────────────────────────────────

    // shared forward model (cerebellum) — learns expected relief across all episodes.
    let mut ff = vforward_new(1, D, ETA_FWD)
    // striatal value lane V (the consequence-grounded lane).
    let mut V = vbasal_new(D, LR_V)

    // accumulators for RPE stats + Psi guard
    let mut psi_sum_on = 0.0
    let mut psi_sum_off = 0.0
    let mut emit_seq_hamming = 0
    let mut n_emit_train = 0
    let mut rpe_abs_sum = 0.0

    // TRAIN PASS: learn V on train tension seeds (also fits forward model).
    // We also collect shuffled (feats, reward) rows to train a shuffle-control V later.
    let mut shuf_feats = []     // flattened feats rows (train emit ticks)
    let mut shuf_rewards = []
    let mut si = 0
    while si < len(train_seeds) {
        let seed = to_string(train_seeds[si])
        let mut pf = pure_field_warmup(600 + si * 13)
        // disjoint subsystems: imm_emit drives the emit decision; imm_conseq is the
        // consequence reservoir that MEASURES relief (cross-subsystem, #3).
        let mut imm_emit = immune_memory_new_text(seed, seed, 2048)
        let mut imm_conseq = immune_memory_new_text(seed, seed, 2048)
        let mut reservoir = 0.0
        let mut t = 0
        while t < T_TICKS {
            pf = pure_field_step(pf)
            let phi = pure_field_phi(pf)
            psi_sum_on = psi_sum_on + phi
            psi_sum_off = psi_sum_off + phi        // V read-only -> identical accumulation
            let ph = pure_field_phase(pf)
            let phase_s = clip01(to_float(ph) / 4.0)
            let fs = (t * 11) % 44
            let frag = substring(seed, fs, fs + 20)

            // tension (info_gap) in the DISJOINT reservoir subsystem
            let gap = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
            reservoir = RES_DECAY * reservoir + relu(gap)
            let margin_emit = immune_memory_recall_margin_text(imm_emit, frag)
            let phasic = clip01(0.2 * to_float(t % 5))
            let feats = state_feats(phi, margin_emit, reservoir, gap, phase_s)

            // efference copy: predicted relief hatDT (forward model)
            let hatDT = vforward_predict(ff, feats)[0]

            // FROZEN substrate emit decision (identical ON vs OFF — V absent here)
            let e_off = substrate_emit(phi, clip01(margin_emit), phasic)
            let e_on  = substrate_emit(phi, clip01(margin_emit), phasic)   // V read-only
            if e_on != e_off { emit_seq_hamming = emit_seq_hamming + 1 }

            if e_on {
                // grounded emit -> bind content into the DISJOINT reservoir (consequence)
                let gap_before = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                imm_conseq = immune_memory_bind_text(imm_conseq, frag, frag, cfg)
                let gap_after = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                let dt_actual = gap_before - gap_after          // relief (>0 when grounding closes gap)
                reservoir = relu(reservoir - dt_actual)         // reservoir consumed
                let rpe = hatDT - dt_actual
                rpe_abs_sum = rpe_abs_sum + fabs(rpe)
                // forward-model learns to predict relief; V learns emit-value from relief
                ff = vforward_update(ff, feats, [dt_actual])
                V = vbasal_update(V, 0, feats, dt_actual)
                n_emit_train = n_emit_train + 1
                // stash for shuffle-control training
                let mut c = 0
                while c < D { shuf_feats = shuf_feats + [feats[c]]  c = c + 1 }
                shuf_rewards = shuf_rewards + [dt_actual]
            }
            // both stores drift each tick (imm_emit evolves the decision subsystem)
            let nonce = "drift " + to_string(t) + " " + frag
            imm_emit = immune_memory_bind_text(imm_emit, nonce, nonce, cfg)
            t = t + 1
        }
        si = si + 1
    }

    // FREEZE V. Build a variance-matched noise-V and a shuffle-control V.
    // shuffle-control: permute rewards against feats rows, retrain a fresh vbasal.
    let n_rows = len(shuf_rewards)
    let mut perm_rewards = shuf_rewards
    // Fisher-Yates via LCG
    let mut rst = 424242
    let mut ii = n_rows - 1
    while ii > 0 {
        rst = lcg_next(rst)
        let j = rst % (ii + 1)
        let tmp = perm_rewards[ii]  perm_rewards[ii] = perm_rewards[j]  perm_rewards[j] = tmp
        ii = ii - 1
    }
    let mut Vshuf = vbasal_new(D, LR_V)
    let mut ri = 0
    while ri < n_rows {
        let mut feats = []  let mut c = 0
        while c < D { feats = feats + [shuf_feats[ri * D + c]]  c = c + 1 }
        Vshuf = vbasal_update(Vshuf, 0, feats, perm_rewards[ri])
        ri = ri + 1
    }

    // ──────────────────────────────────────────────────────────────────────
    // HELD-OUT TEST PASS: frozen V predicts emit-value; correlate with real relief.
    // ──────────────────────────────────────────────────────────────────────
    let mut vpred_test = []
    let mut vshuf_test = []
    let mut dt_test = []
    let mut n_emit_test = 0
    let mut sj = 0
    while sj < len(test_seeds) {
        let seed = to_string(test_seeds[sj])
        let mut pf = pure_field_warmup(711 + sj * 17)
        let mut imm_emit = immune_memory_new_text(seed, seed, 2048)
        let mut imm_conseq = immune_memory_new_text(seed, seed, 2048)
        let mut reservoir = 0.0
        let mut t = 0
        while t < T_TICKS {
            pf = pure_field_step(pf)
            let phi = pure_field_phi(pf)
            psi_sum_on = psi_sum_on + phi
            psi_sum_off = psi_sum_off + phi
            let ph = pure_field_phase(pf)
            let phase_s = clip01(to_float(ph) / 4.0)
            let fs = (t * 11) % 44
            let frag = substring(seed, fs, fs + 20)
            let gap = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
            reservoir = RES_DECAY * reservoir + relu(gap)
            let margin_emit = immune_memory_recall_margin_text(imm_emit, frag)
            let phasic = clip01(0.2 * to_float(t % 5))
            let feats = state_feats(phi, margin_emit, reservoir, gap, phase_s)

            let e_off = substrate_emit(phi, clip01(margin_emit), phasic)
            let e_on  = substrate_emit(phi, clip01(margin_emit), phasic)
            if e_on != e_off { emit_seq_hamming = emit_seq_hamming + 1 }

            if e_on {
                // frozen V read-only prediction (appropriateness signal at emit tick)
                let vp = vbasal_go_value(V, feats)
                let vs = vbasal_go_value(Vshuf, feats)
                let gap_before = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                imm_conseq = immune_memory_bind_text(imm_conseq, frag, frag, cfg)
                let gap_after = clip01(immune_memory_recall_margin_text(imm_conseq, frag))
                let dt_actual = gap_before - gap_after
                reservoir = relu(reservoir - dt_actual)
                vpred_test = vpred_test + [vp]
                vshuf_test = vshuf_test + [vs]
                dt_test = dt_test + [dt_actual]
                n_emit_test = n_emit_test + 1
            }
            let nonce = "drift " + to_string(t) + " " + frag
            imm_emit = immune_memory_bind_text(imm_emit, nonce, nonce, cfg)
            t = t + 1
        }
        sj = sj + 1
    }

    // ── F3' correlations ──
    let rho_real = pcorr(vpred_test, dt_test)
    let rho_shuf = pcorr(vshuf_test, dt_test)

    // variance-matched noise-V: LCG preds z-scored to V-pred mean/std
    let vp_mean = fmean(vpred_test)  let vp_std = fstd(vpred_test)
    let mut noise_pred = []
    let mut nst = 987654321  let mut k = 0
    let ntest = len(vpred_test)
    let mut raw = []
    while k < ntest { nst = lcg_next(nst)  raw = raw + [to_float(nst) / 2147483648.0]  k = k + 1 }
    let raw_mean = fmean(raw)  let raw_std = fstd(raw)
    let mut kk = 0
    while kk < ntest {
        let z = if raw_std > 0.0 { (raw[kk] - raw_mean) / raw_std } else { 0.0 }
        noise_pred = noise_pred + [vp_mean + z * vp_std]
        kk = kk + 1
    }
    let rho_noise = pcorr(noise_pred, dt_test)

    let d_noise = rho_real - rho_noise
    let d_shuf  = rho_real - rho_shuf
    let f3_noise_pass = d_noise >= 0.15
    let f3_shuf_pass  = d_shuf  >= 0.15
    let faculty_pass = f3_noise_pass && f3_shuf_pass

    let dt_mean = fmean(dt_test)  let dt_std = fstd(dt_test)
    let psi_ok = fabs(psi_sum_on - psi_sum_off) < 1e-9 && emit_seq_hamming == 0

    println("")
    println("=== H_9104 CONSEQUENCE-RETURN LANE — engine-native (pure_field/immune/vforward/vbasal) ===")
    println("train_seeds=" + to_string(len(train_seeds)) + " test_seeds=" + to_string(len(test_seeds)) + " T_TICKS=" + to_string(T_TICKS) + " D=" + to_string(D))
    println("emit_train=" + to_string(n_emit_train) + " emit_test=" + to_string(n_emit_test) + " (frozen substrate decision, V read-only)")
    println("[reservoir] RES_DECAY=" + to_string(RES_DECAY) + "  [efference] mean|RPE|=" + to_string(if n_emit_train>0 { rpe_abs_sum/to_float(n_emit_train) } else {0.0}))
    println("[relief DT_actual] mean=" + to_string(dt_mean) + " std=" + to_string(dt_std) + " (cross-subsystem: imm_conseq disjoint from imm_emit)")
    println("")
    println("[Psi guard]   psi_sum_ON=" + to_string(psi_sum_on) + " psi_sum_OFF=" + to_string(psi_sum_off) + " emit_seq_Hamming(ON,OFF)=" + to_string(emit_seq_hamming) + " -> " + (if psi_ok {"ON==OFF byte-identical (V read-only, substrate FROZEN)"} else {"VIOLATION"}))
    println("")
    println("[F3' faculty] rho_real =corr(V(state),DT_actual) [held-out] = " + to_string(rho_real))
    println("              rho_noise=corr(var-matched noise-V,DT_actual)  = " + to_string(rho_noise))
    println("              rho_shuf =corr(shuffle-(state,r) V,DT_actual)   = " + to_string(rho_shuf))
    println("              rho_real - rho_noise = " + to_string(d_noise) + "  bar>=0.15 -> " + (if f3_noise_pass {"PASS"} else {"FAIL"}))
    println("              rho_real - rho_shuf  = " + to_string(d_shuf)  + "  bar>=0.15 -> " + (if f3_shuf_pass  {"PASS"} else {"FAIL"}))
    println("")
    if faculty_pass && psi_ok {
        println("VERDICT: FACULTY GREEN — afferent consequence-return OPENS an emit-appropriateness faculty.")
        println("  V(state) predicts real tension-relief on HELD-OUT tension seeds better than both variance-matched")
        println("  noise-V (Δ=" + to_string(d_noise) + ") and shuffle-control V (Δ=" + to_string(d_shuf) + "), Ψ preserved. First engine-native")
        println("  consequence-grounded appropriateness signal. THEATER F3-noise = MISSING PART (confirmed), not ceiling.")
    } else {
        println("VERDICT: CEILING RED (honest) — closing the consequence loop is FLOOR-DOMINATED = DPI re-emerges.")
        if !f3_noise_pass { println("  rho_real - rho_noise = " + to_string(d_noise) + " < 0.15 : V no better than variance-matched noise.") }
        if !f3_shuf_pass  { println("  rho_real - rho_shuf  = " + to_string(d_shuf)  + " < 0.15 : shuffle-V relieves as much = theater.") }
        if !psi_ok        { println("  Ψ VIOLATION — invalidates run (should be impossible; V is read-only).") }
        println("  Tension-relief carries no faculty-predictable variance across held-out seeds: the DPI meta-law")
        println("  re-appears at the consequence layer. F3-noise = real ceiling on the autogenous self-loop.")
    }
}
