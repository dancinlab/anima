// c2_engine_native.hexa — H_9038 ENGINE-NATIVE informativeness measurement on LIVE §SelfIdentity.
// Compares the content-BLIND self_drift vs the new experience-driven self_drift_exp, using the
// existing self_chain_fit discriminator. usage: hexa run state/9038_self_chain_informativeness/c2_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let mut npass = 0
    let mut nfail = 0
    let STEP = 0.3

    // ---- ENRICHED (self_drift_exp): two DIFFERENT experience streams A vs B ----
    // stream A content-axes {1,2,3,1,2,3} ; stream B {4,5,6,4,5,6}
    let seedA = self_new(8, 0)
    let a1 = self_drift_exp(seedA, 1, STEP)  let a2 = self_drift_exp(a1, 2, STEP)
    let a3 = self_drift_exp(a2, 3, STEP)     let a4 = self_drift_exp(a3, 1, STEP)
    let a5 = self_drift_exp(a4, 2, STEP)     let aL = self_drift_exp(a5, 3, STEP)
    let seedB = self_new(8, 0)
    let b1 = self_drift_exp(seedB, 4, STEP)  let b2 = self_drift_exp(b1, 5, STEP)
    let b3 = self_drift_exp(b2, 6, STEP)     let b4 = self_drift_exp(b3, 4, STEP)
    let b5 = self_drift_exp(b4, 5, STEP)     let bL = self_drift_exp(b5, 6, STEP)
    let exp_AB = self_cos(aL, bL)

    // ---- CURRENT (self_drift, content-blind): same tick schedule for both "sessions" ----
    let s0 = self_new(8, 0)
    let c1 = self_drift(s0, 0, STEP)  let c2 = self_drift(c1, 1, STEP)  let c3 = self_drift(c2, 2, STEP)
    let c4 = self_drift(c3, 3, STEP)  let c5 = self_drift(c4, 4, STEP)  let cL = self_drift(c5, 5, STEP)
    let d0 = self_new(8, 0)
    let d1 = self_drift(d0, 0, STEP)  let d2 = self_drift(d1, 1, STEP)  let d3 = self_drift(d2, 2, STEP)
    let d4 = self_drift(d3, 3, STEP)  let d5 = self_drift(d4, 4, STEP)  let dL = self_drift(d5, 5, STEP)
    let blind_AB = self_cos(cL, dL)

    // ---- EARNED (content-locking, shuffle-controlled via self_cos): a SHUFFLED-order replay of
    // stream A (same content axes {1,2,3} different order) must stay CLOSER to A's self than the
    // different-content stream B does. i.e. self is locked to WHAT was experienced, and same
    // content ranks above different content. ----
    let sh1 = self_drift_exp(seedA, 3, STEP)  let sh2 = self_drift_exp(sh1, 1, STEP)
    let sh3 = self_drift_exp(sh2, 2, STEP)    let sh4 = self_drift_exp(sh3, 3, STEP)
    let sh5 = self_drift_exp(sh4, 2, STEP)    let shL = self_drift_exp(sh5, 1, STEP)
    let fit_genuine = self_cos(aL, shL)   // same content, shuffled order -> should stay high-ish
    let fit_impostor = self_cos(aL, bL)   // different content -> low (== exp_AB)

    // ---- RECOGNITION (H_1471 reconfirm): anchor/restore vs impostor axis ----
    let anch = self_anchor(aL)
    let rec_restore = self_cos(aL, anch)
    let imp = self_new(8, 7)
    let rec_imp = self_cos(aL, imp)

    if _ab("informativeness ENRICHED: A!=B (cos<0.90)", exp_AB < 0.90) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("blindness CURRENT: A==B (cos>0.999)", blind_AB > 0.999) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("EARNED: genuine-fit > impostor-fit + 0.30", fit_genuine - fit_impostor >= 0.30) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("recognition: restore==1.0 & restore>impostor", rec_restore > 0.999 && rec_restore - rec_imp >= 0.10) { npass=npass+1 } else { nfail=nfail+1 }

    println("INFO exp_AB(enriched)=" + to_string(exp_AB) + " blind_AB(current)=" + to_string(blind_AB)
          + " fit_genuine=" + to_string(fit_genuine) + " fit_impostor=" + to_string(fit_impostor)
          + " rec_restore=" + to_string(rec_restore) + " rec_impostor=" + to_string(rec_imp))
    println("--- H_9038 C2 engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
