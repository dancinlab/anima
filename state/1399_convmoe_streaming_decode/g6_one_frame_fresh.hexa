import "CORE/g6_ideation.hexa"
// H_1399 fresh-process per-frame G6 decoder. ARM/IDX/GEN/SEED via env. Loads model, decodes ONE
// frame (best-of-K=3 for C arms, K=1 for B), prints the falsifiability score, EXITS (so the hexa
// bump-allocator leak resets per frame — the cross-decode-in-one-process accumulation cure).
fn main() {
    let ckpt = "state/g6-retro303m-fals/retro303m.clm"
    let known = _g6_dict_load()
    let arm = env_var("ARM")
    let idx = to_int(env_var("IDX"))
    let GEN = to_int(env_var("GEN"))
    let SEED = 7
    let W = clm_load_weights(ckpt)
    let f6 = g6_build_frames(6)
    let f5 = g6_build_frames(5)
    let mut frame = ""
    let mut k = 3
    if arm == "C_strong" { frame = to_string(f6["composed"][idx]) }
    else { if arm == "C_shuffle" { frame = to_string(f6["shuffled"][idx]) }
    else { if arm == "C_ablate" { frame = to_string(f6["ablated"][idx]) }
    else { frame = to_string(f5["composed"][idx]); k = 1 } } }
    let t0 = now_ms()
    let mut o = ""
    if k == 3 { o = g6_decode_best_of_k_W(W, frame, GEN, 3, SEED, known) }
    else { let r = gen_clm_ideate_W(W, frame, GEN, 40, 0.7, SEED); o = to_string(r["text"]) }
    let kwr = _g6_known_word_ratio(o, known)
    let mut isf = false
    if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
    println("FRAME arm=" + arm + " idx=" + to_string(idx) + " fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
    println("FRAME_DONE")
}
