// H_1509 ALLOSTERIC-BUFFER — R2 engine-native probe (DIRECTIONAL→engine-native).
// SOURCE: external proposal — Amoeba Protocol (μ_t allosteric buffer).
// Reads the LIVE §AllostericBuffer ops in core/engine_cli.hexa (allo_mu / allo_defend /
// allo_best_fixed_gain) and re-scores the SAME frozen H_1509 bars byte-exact.
// Wall HOLDS in R1 (mirror): B does NOT cross the best-swept fixed gain by 0.05.
import "core/engine_cli.hexa"

fn main() {
    let lam = 1.0
    let sigma = 0.12
    let g0 = 0.40
    let margin = 0.05
    let seeds = [1509, 1510, 1511]

    println("H_1509 ALLOSTERIC-BUFFER — R2 engine-native (§AllostericBuffer live ops)")
    println("FROZEN MARGIN=0.05 (H_1284) lam=1.0 sigma=0.12 g0=0.40 T=200")
    println("========================================================================")

    let mut sumA = 0.0
    let mut sumB = 0.0
    let mut sumC = 0.0
    let mut sumD = 0.0
    let mut sumG0 = 0.0
    let mut a_each = true
    let mut b_each = true
    let mut i = 0
    while i < len(seeds) {
        let s = seeds[i]
        let rA = allo_best_fixed_gain(sigma, s)        // ARM A best swept fixed gain
        let rB = allo_defend(g0, lam, sigma, s, 0)      // ARM B allosteric μ
        let rC = allo_defend(g0, 0.0, sigma, s, 0)      // ARM C ablate lam=0
        let rD = allo_defend(g0, lam, sigma, s, 1)      // ARM D shuffle
        let rG0 = allo_defend(g0, 0.0, sigma, s, 0)     // global gain at g0 (== C)
        println("seed " + to_string(s) + "  A=" + to_string(rA) + "  B=" + to_string(rB)
            + "  C=" + to_string(rC) + "  D=" + to_string(rD))
        if (rA - rB) < margin { a_each = false }
        if rB >= rA { b_each = false }
        sumA = sumA + rA
        sumB = sumB + rB
        sumC = sumC + rC
        sumD = sumD + rD
        sumG0 = sumG0 + rG0
        i = i + 1
    }
    let n = to_float(len(seeds))
    let mA = sumA / n
    let mB = sumB / n
    let mC = sumC / n
    let mD = sumD / n
    let mG0 = sumG0 / n

    println("MEAN  A=" + to_string(mA) + "  B=" + to_string(mB) + "  C=" + to_string(mC)
        + "  D=" + to_string(mD) + "  gain@g0=" + to_string(mG0))

    // determinism: run B twice
    let d1 = allo_defend(g0, lam, sigma, 1509, 0)
    let d2 = allo_defend(g0, lam, sigma, 1509, 0)
    println("determinism run1==run2: " + to_string(d1 == d2) + " (" + to_string(d1) + ")")

    // ── frozen bars ──
    let barA = ((mA - mB) >= margin) && a_each
    let barB = b_each
    let c_collapse = _abs_f(mC - mG0) <= 0.01
    let c_load = (mC - mB) >= margin
    let barC = c_collapse && c_load
    let barD = (mD - mB) >= margin

    println("BAR A wall-cross RMS_A-RMS_B=" + to_string(mA - mB) + " >=0.05 -> " + to_string(barA))
    println("BAR B vs-baseline RMS_B<RMS_A all seeds -> " + to_string(barB))
    println("BAR C earned-ablate collapse=" + to_string(c_collapse) + " load=" + to_string(c_load)
        + " -> " + to_string(barC))
    println("BAR D earned-shuffle RMS_D-RMS_B=" + to_string(mD - mB) + " >=0.05 -> " + to_string(barD))

    let green = barA && barB && barC && barD && (d1 == d2)
    if green {
        println("VERDICT: GREEN WALL-BROKEN (engine-native)")
    } else {
        println("VERDICT: WALL-HOLDS (engine-native) — neuromodulation ceiling holds vs buffer lever")
    }
}

fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
