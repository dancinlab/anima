import "CORE/engine_cli.hexa"
import "CORE/generator.hexa"
fn _ab(name: string, want: bool, got: bool) -> bool {
    if want == got { println("PASS  " + name)  return true }
    println("FAIL  " + name + " want=" + to_string(want) + " got=" + to_string(got))  return false
}
fn main() {
    let mut np = 0  let mut nf = 0
    let ce_eval = gen_emit_compose_eval()
    let ce_c = to_float(ce_eval["acc_compose"])
    let ce_s = to_float(ce_eval["acc_shufw"])
    let ce_best = to_float(ce_eval["best_single"])
    let ce_conf = to_float(ce_eval["conflict_rate"])
    let ce_orc  = to_float(ce_eval["acc_oracle"])
    if _ab("case_129_compose_earned_vs_shuffle", true, ce_s <= ce_c + 0.01) { np = np+1 } else { nf = nf+1 }
    if _ab("case_130_compose_conflict_degrades", true, ce_c < ce_best && ce_conf >= 0.5) { np = np+1 } else { nf = nf+1 }
    if _ab("case_131_compose_oracle_ceiling", true, ce_orc - ce_best <= 0.05 && ce_orc >= ce_best) { np = np+1 } else { nf = nf+1 }
    let ce_cells = ko_jamo_cells_load("CORE/ko_jamo_cells.kojamohead")
    let ce_jhM = gbe_grow_head_raw(0)[0]
    let ce_uv = bpe_unit_vocab(bpe_learn_merges([0,1,2,3,4,5],[1,1,1,1,1,1],40,14,0))
    let ce_jMean = to_float(ce_eval["jamo_mean_err"])
    let ce_mMean = to_float(ce_eval["morph_mean_err"])
    let ce_off = gen_emit_compose(120, ce_cells, ce_jhM, ce_uv, ce_jMean, ce_mMean, [104,101,108,108,111])
    if _ab("case_132_compose_offkorean_inert", true, ce_off == 120 && to_string(ce_eval["ok"]) == "true") { np = np+1 } else { nf = nf+1 }
    println("--- H_1396 compose smoke (isolated): " + to_string(np) + " pass / " + to_string(nf) + " fail ---")
    if nf > 0 { exit(1) }
}
