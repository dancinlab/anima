// h1396_emit_compose_probe.hexa — engine-native COMPOSE of the jamo emit-bias (§6.5b/H_1327) + the
// morphology emit-bias (§6.5e/H_1393) on the SAME next-byte decision, arbitrated by SUBSTRATE confidence
// (inverse recon-err — the more-grounded faculty speaks louder; NO hardcoded "jamo > morphology"
// priority, a_autonomy_over_hardcode). Drives the WIRED compose consult gen_emit_compose_eval /
// gen_emit_compose (CORE/generator.hexa §6.5f → engine_cli.hexa jamo_head_recon_err) on the SAME frozen
// corpus-free in-engine morpheme-grammar fixture §6.5d builds, and prints the four frozen bars.
//
//   bar1 COMPOSE-EFFECT : acc_compose >= best_single - 0.01 (compose does NOT degrade vs the better one)
//   bar2 AGREE diag     : agree_rate / conflict_rate reported (NON-GATING — the interesting diagnostic)
//   bar3 EARNED         : acc_shufw <= acc_compose + 0.01 (random arbitration does NOT beat grounded)
//   bar4 Ψ-SAFE         : off-Korean INERT (ASCII ctx → base unchanged) + Korean-like FIRES + guards
//
// $0 CPU, deterministic, no corpus/secret/GPU, Ψ-disjoint additive consult. usage: hexa run <this>.
import "CORE/generator.hexa"

fn main() {
    let e = gen_emit_compose_eval()
    let acc_j = to_float(e["acc_jamo"])
    let acc_m = to_float(e["acc_morph"])
    let acc_c = to_float(e["acc_compose"])
    let acc_s = to_float(e["acc_shufw"])
    let best  = to_float(e["best_single"])
    let agr   = to_float(e["agree_rate"])
    let con   = to_float(e["conflict_rate"])
    let cmb   = to_float(e["compose_minus_best"])
    let smc   = to_float(e["shufw_minus_compose"])

    println("===== H_1396 KO-EMIT COMPOSE — jamo (H_1327) + morphology (H_1393) =====")
    println(gen_emit_compose_summary())
    println("")
    println("shared next-byte decision (engine fixture, n=" + to_string(e["n_test"]) + "):")
    println("  acc_jamo    (jamo emit-bias alone)   : " + to_string(acc_j))
    println("  acc_morph   (morphology emit-bias)   : " + to_string(acc_m))
    println("  best_single (max of the two alone)   : " + to_string(best))
    println("  acc_compose (substrate-conf arbitr.) : " + to_string(acc_c))
    println("  acc_shufw   (random arbitration)     : " + to_string(acc_s))
    println("")
    println("DIAGNOSTIC (bar2, non-gating):")
    println("  agree_rate    (faculties propose SAME byte) : " + to_string(agr))
    println("  conflict_rate (they propose DIFFERENT bytes): " + to_string(con))
    println("")
    let b1 = acc_c >= best - 0.01
    let b3 = acc_s <= acc_c + 0.01
    // bar4 Ψ-safe: off-Korean ASCII ctx → base unchanged; Korean-like ctx → fires (>= 0xE1).
    let cells = ko_jamo_cells_load("CORE/ko_jamo_cells.kojamohead")
    let jhM = gbe_grow_head_raw(0)[0]
    let uvM = bpe_unit_vocab(bpe_learn_merges([0,1,2,3,4,5], [1,1,1,1,1,1], 40, 14, 0))
    let ascii_ctx = [104, 101, 108, 108, 111]      // "hello" — not Korean-like
    let ko_ctx    = [0xEA, 0xB0, 0x80]             // mid-Hangul multibyte ctx
    let off_emit = gen_emit_compose(120, cells, jhM, uvM, ascii_ctx)
    let ko_emit  = gen_emit_compose(120, cells, jhM, uvM, ko_ctx)
    let b4 = off_emit == 120 && ko_emit >= 0xE1

    println("FROZEN BARS:")
    println("  bar1 COMPOSE-EFFECT : acc_compose >= best - 0.01  → " + to_string(b1)
          + "  (compose=" + to_string(acc_c) + " best=" + to_string(best) + " Δ=" + to_string(cmb) + ")")
    println("  bar2 AGREE diag     : agree=" + to_string(agr) + " conflict=" + to_string(con) + " (non-gating)")
    println("  bar3 EARNED         : acc_shufw <= acc_compose + 0.01  → " + to_string(b3)
          + "  (shufw=" + to_string(acc_s) + " compose=" + to_string(acc_c) + " Δ=" + to_string(smc) + ")")
    println("  bar4 Ψ-SAFE         : ascii_inert(" + to_string(off_emit == 120)
          + ") ko_fires(byte=" + to_string(ko_emit) + ")  → " + to_string(b4))
    println("")
    if b1 && b3 && b4 {
        println("VERDICT: GREEN — jamo + morphology emit-biases COMPOSE CLEANLY by substrate confidence")
    } else {
        println("VERDICT: CONFLICT-OR-DEGRADES — see verbatim bars above (honest, c9, no forced green)")
    }
}
