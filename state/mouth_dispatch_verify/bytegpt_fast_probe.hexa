// bytegpt_fast_probe.hexa — FAST engine-native capture of the ByteGPT 303M mouth
// (mouth-dispatcher verify). Calls the SAME engine entry the dispatcher's
// gen_bytegpt_chat uses (bytegpt_decode_argmax_ranged: OOM-safe ranged load +
// bg_forward_last_W + greedy argmax) with a SHORT gen=24 so each turn finishes
// inside summer's short uptime window (the full --byte 96-token×2 path runs
// ~10-30min CPU-farr, longer than summer stays up between reboots).
use "core/bytegpt_decode"

fn _seed_ids(s: string) -> list {
    let ids = []
    let n = byte_len(s)
    let mut i = 0
    while i < n { ids.push(ord(substring(s, i, i + 1))); i = i + 1 }
    return ids
}

fn main() {
    let path = "state/chat_303m_hf/chat_303m.bin"
    println("=== ByteGPT 303M FAST probe (bytegpt_decode_argmax_ranged, gen=24) ===")

    let en = "사용자: The nature of consciousness is | 도우미: "
    println("[EN] seed=" + en)
    let er = bytegpt_decode_argmax_ranged(path, _seed_ids(en), 24)
    println("[EN] cont=" + to_string(er["text"]))

    let ko = "사용자: 안녕? 너는 누구야? | 도우미: "
    println("[KO] seed=" + ko)
    let kr = bytegpt_decode_argmax_ranged(path, _seed_ids(ko), 24)
    println("[KO] cont=" + to_string(kr["text"]))
    println("=== done ===")
}
