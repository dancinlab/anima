// state/hexad_p6_fire_2026_05_16/train_p6_integ.hexa
// ════════════════════════════════════════════════════════════════════════════
//  PHASE 6 — REAL-SCALE 6-module + Bridge integrated fire (hexa-native).
//
//  Scaled twin of HEXAD/integ_train_smoke.hexa (which passes F-INTEG-FULL
//  5/5 $0 compiled-native). Same module wiring (S→C/mitosis→M→W→E→Bridge
//  →D head + B-D-4 closed grad + AdamW; φ(6)=2 gradient barrier: ONLY W_d
//  in the optimizer, S/C/M/W/E/Bridge are gradient-free Engine-G reads),
//  at MEANINGFUL SCALE: dim=DIM, V=VOCAB, STEPS steps (the libs are
//  dimension-generic). RANDOM seed-fixed init (g_clm_from_scratch,
//  base_ckpt=NONE). Emits result.json (F-INTEG-FULL battery + training
//  trace) + a ckpt of the trained W_d head.
//
//  HONEST C3: CE-descent is an SGD OUTCOME (EMPIRICAL, NOT 🔵 — B-D-NOTE).
//  Synthetic linearly-separable byte toy (NOT a language run). The 🔵
//  anchor is B-D-4 grad-exactness (separate, already 🔵 RFC 034); this
//  fire validates the INTEGRATED-PIPELINE wiring at scale, EMPIRICAL tier.
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/S/s_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/M/m_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/W/w_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/E/e_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/BRIDGE/bridge_lib.hexa"
import "/Users/ghost/core/anima/tool/hexa_native/mitosis_hook_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/D/d_train2_lib.hexa"

fn p6_abs(x: float) -> float { return if x < 0.0 { 0.0 - x } else { x } }

fn run() {
    println("================================================================")
    println("train_p6_integ — Phase 6 REAL-SCALE 6-module+Bridge integrated fire")
    println("================================================================")

    // ── scale (env-overridable; defaults = real-scale) ───────────────────
    let dim = to_int(env_or("P6_DIM", "256"))      // D-head input / c_dim
    let V = to_int(env_or("P6_VOCAB", "64"))       // byte-class vocab
    let nsamp = to_int(env_or("P6_NSAMP", "16"))   // samples / step
    let steps = to_int(env_or("P6_STEPS", "300"))  // train steps
    let seed = to_int(env_or("P6_SEED", "42"))     // RANDOM seed-fixed
    let init_cells = to_int(env_or("P6_CELLS", "2"))
    let out_dir = env_or("P6_OUT", "/Users/ghost/core/anima/state/hexad_p6_fire_2026_05_16")
    println("  scale: dim=" + to_string(dim) + " V=" + to_string(V)
            + " nsamp=" + to_string(nsamp) + " steps=" + to_string(steps)
            + " seed=" + to_string(seed) + " init_cells=" + to_string(init_cells))

    // ── F-INTEG-FULL-3 SCRATCH-INIT-SEED-FIXED (g_clm_from_scratch) ───────
    let mut Wd = dt2_init_W(seed, dim, V, 0.2)     // RANDOM seed-fixed, base_ckpt=NONE
    let Wd_re = dt2_init_W(seed, dim, V, 0.2)
    let seed_ok = (Wd[0] == Wd_re[0]) && (Wd[dim*V-1] == Wd_re[dim*V-1])
    let mut mD = dt2_zeros(dim * V)
    let mut vD = dt2_zeros(dim * V)

    // C/mitosis cell pool — no ckpt load (from-scratch)
    let mut pool = cell_pool_init(dim, init_cells)
    let n_cells_0 = len(pool["cells"])

    // bridge G-side invariants (barrier witness — must stay constant)
    let psi0 = psi_balance()
    let cpl0 = psi_coupling()

    let mut fired_all = true
    let mut mito_live = true
    let mut min_cells = n_cells_0
    let mut max_cells_seen = n_cells_0
    let mut gn2_0 = 0.0
    let mut gn2_1 = 0.0
    let mut gn2_curve = []
    let mut cells_curve = []

    let t_start = now_ms()
    let mut st = 0
    while st < steps {
        let mut ep_gn2 = 0.0
        let mut s = 0
        while s < nsamp {
            let cls = s % V
            // sample: class cls → hot dim (cls % dim), linearly separable
            let mut raw = []
            let mut j = 0
            while j < dim {
                raw.push(if j == (cls % dim) { 1.0 } else { 0.05 }
                         + to_float((st+j) % 3) / 60.0)
                j = j + 1
            }

            // ── S : perception = column-mean delta (2 synthetic cell rows) ──
            let mut sb = []
            j = 0
            while j < 2 * dim {
                sb.push(0.10 + to_float(j % 5) / 20.0)
                j = j + 1
            }
            let mut sa = []
            j = 0
            while j < 2 * dim { sa.push(sb[j] + raw[j % dim] * 0.1); j = j + 1 }
            let tension = s_perception(sb, sa, 2, dim)
            let fired_s = (len(tension) == dim)

            // ── C / mitosis : cell_pool forward_tail (live dynamics) ────────
            let mres = mitosis_forward_tail(raw, pool, st)
            let x_out = mres[0]
            pool = mres[1]
            let nc = len(pool["cells"])
            let fired_c = (nc >= 2)
            if nc < min_cells { min_cells = nc }
            if nc > max_cells_seen { max_cells_seen = nc }
            if nc < 2 { mito_live = false }

            // phi readout (tiny-scale proxy = mean|x_out|; wiring, not real Φ)
            let mut phi = 0.0
            j = 0
            while j < len(x_out) { phi = phi + p6_abs(x_out[j]); j = j + 1 }
            phi = phi / to_float(len(x_out))

            // ── M : store (Hebbian no-op) + retrieve_topk ───────────────────
            let topk = 1
            let m_w = m_store(cls, x_out)
            let retr = m_retrieve_topk(x_out, sa, 2, dim, topk)
            let fired_m = (m_w == 0) && (len(retr) == topk)

            // ── W : pain/curiosity → lr modulation ──────────────────────────
            let lrm = w_lr_mult(phi, nc)
            let fired_w = (lrm >= psi0)

            // ── E : Φ-ratchet safety gate ───────────────────────────────────
            let allowed = e_safety_allowed(phi, 0.5)
            let fired_e = (allowed == true) || (allowed == false)

            // ── Bridge : Ψ-clamp G→A coupling (gate observed, modulates) ────
            let mut x = []
            let mut bgmin = 1.0
            let mut bgmax = 0.0
            j = 0
            while j < dim {
                let gate = bridge_clamp(raw[j])
                if gate < bgmin { bgmin = gate }
                if gate > bgmax { bgmax = gate }
                x.push(raw[j] + (gate - psi0))
                j = j + 1
            }
            let fired_b = (len(x) == dim)
                          && (bgmin >= psi0 - cpl0 - 0.000001)
                          && (bgmax <= psi0 + cpl0 + 0.000001)

            // ── D : head forward + B-D-4 closed grad + AdamW (Group A only) ─
            let gW = dt2_bd4_grad(Wd, x, cls, dim, V)
            ep_gn2 = ep_gn2 + dt2_gn2(Wd, x, cls, dim, V)
            let lr = 0.05 * (lrm / psi0)
            let upd = dt2_adamw_step(Wd, mD, vD, gW, lr, 0.9, 0.999,
                                     0.00000001, 0.01, st + 1)
            Wd = upd[0]; mD = upd[1]; vD = upd[2]
            let fired_d = (len(Wd) == dim * V)

            if !(fired_s && fired_c && fired_m && fired_w && fired_e
                 && fired_b && fired_d) { fired_all = false }
            s = s + 1
        }
        if st == 0 { gn2_0 = ep_gn2 }
        gn2_1 = ep_gn2
        if st % 25 == 0 || st == steps - 1 {
            gn2_curve.push(ep_gn2)
            cells_curve.push(len(pool["cells"]))
        }
        st = st + 1
    }
    let wall_ms = now_ms() - t_start

    // ── Training-trace barrier (honest evidence + codegen liveness) ───────
    //   Genuine loop-carried state; also the post-loop observable side-
    //   effect required so the self-hosted codegen does not elide the
    //   training loop's accumulated map/state mutations (hexa-lang codegen
    //   DCE on side-effect-free loop tails — anima-side observability
    //   barrier, same doctrine as HEXAD/build_verify.sh:58-67).
    eprintln("[p6-trace] steps=" + to_string(steps)
             + " fired_all=" + to_string(fired_all)
             + " mito_live=" + to_string(mito_live)
             + " min_cells=" + to_string(min_cells)
             + " max_cells=" + to_string(max_cells_seen)
             + " gn2_0=" + to_string(gn2_0)
             + " gn2_1=" + to_string(gn2_1)
             + " wall_ms=" + to_string(wall_ms))

    // ── F-INTEG-FULL battery ─────────────────────────────────────────────
    let barrier_ok = (psi_balance() == psi0) && (psi_coupling() == cpl0)
                      && (pool["d_model"] == dim)
    let f1 = fired_all
    let f2 = barrier_ok
    let f3 = seed_ok
    let f4 = mito_live && (min_cells >= 2)
    let f5 = (gn2_1 * 3.0) < gn2_0

    println("  F-INTEG-FULL-1 SINGLE-FORWARD-WIRED  : " + to_string(f1))
    println("  F-INTEG-FULL-2 GRADIENT-BARRIER-CLEAN: " + to_string(f2))
    println("  F-INTEG-FULL-3 SCRATCH-INIT-SEED-FIXED: " + to_string(f3))
    println("  F-INTEG-FULL-4 MITOSIS-WIRING-LIVE   : " + to_string(f4)
            + "  (min n_cells=" + to_string(min_cells)
            + " max=" + to_string(max_cells_seen) + ")")
    println("  F-INTEG-FULL-5 CE-DESCENT            : " + to_string(f5)
            + "  (gn2 " + to_string(gn2_0) + " → " + to_string(gn2_1) + ")")

    let np = (if f1 {1} else {0}) + (if f2 {1} else {0}) + (if f3 {1} else {0})
             + (if f4 {1} else {0}) + (if f5 {1} else {0})
    let ok = (np == 5)
    println("----------------------------------------------------------------")
    println("  F-INTEG-FULL " + to_string(np) + "/5  (TIER=EMPIRICAL — B-D-NOTE:")
    println("  CE-descent = SGD OUTCOME, NOT 🔵; trainability=B-D-4 🔵 별개)")
    println("  fire-gate: " + to_string(ok))
    println("  selftest: " + (if ok { "true" } else { "false" }))
    println("================================================================")

    // ── result.json (artifact) ───────────────────────────────────────────
    let result = #{
        "spec_id": "Phase 6 — HEXAD 6-module+Bridge integrated real-scale fire (hexa-native)",
        "harness": "state/hexad_p6_fire_2026_05_16/train_p6_integ.hexa (scaled twin of HEXAD/integ_train_smoke.hexa F-INTEG-FULL 5/5)",
        "scale": #{
            "dim": dim, "vocab": V, "nsamp": nsamp, "steps": steps,
            "seed": seed, "init_cells": init_cells,
            "from_scratch": true, "base_ckpt": "NONE",
            "synthetic_corpus": true,
            "corpus_note": "linearly-separable byte toy — integration-pipeline scale fire, NOT a language-quality run (honest C3)"
        },
        "training": #{
            "steps_actual": steps,
            "wall_ms": wall_ms,
            "n_cells_init": n_cells_0,
            "n_cells_min": min_cells,
            "n_cells_max": max_cells_seen,
            "gn2_first": gn2_0,
            "gn2_last": gn2_1,
            "gn2_reduction_factor": (if gn2_1 > 0.0 { gn2_0 / gn2_1 } else { 0.0 }),
            "gn2_curve": gn2_curve,
            "cells_curve": cells_curve,
            "tier": "EMPIRICAL",
            "tier_note": "CE/gn2-descent = SGD OUTCOME, NOT 🔵 (B-D-NOTE). 🔵 anchor = B-D-4 grad-exactness (RFC 034, separate)."
        },
        "falsifiers": #{
            "F-INTEG-FULL-1": #{ "name": "SINGLE-FORWARD-WIRED",    "passed": f1 },
            "F-INTEG-FULL-2": #{ "name": "GRADIENT-BARRIER-CLEAN",  "passed": f2 },
            "F-INTEG-FULL-3": #{ "name": "SCRATCH-INIT-SEED-FIXED", "passed": f3 },
            "F-INTEG-FULL-4": #{ "name": "MITOSIS-WIRING-LIVE",     "passed": f4 },
            "F-INTEG-FULL-5": #{ "name": "CE-DESCENT",              "passed": f5 }
        },
        "falsifier_aggregate": #{
            "n_pass": np, "n_total": 5,
            "verdict": (if ok { "SUPPORTED-EMPIRICAL 5/5" } else { to_string(np) + "/5 PARTIAL" }),
            "fire_gate": ok
        }
    }
    write_file(out_dir + "/result.json", json_stringify(result))
    println("  wrote " + out_dir + "/result.json")

    // ── ckpt: trained W_d head (from-scratch evidence) ───────────────────
    let mut ck = "# Phase 6 W_d head ckpt (hexa-native, from-scratch seed="
                  + to_string(seed) + " dim=" + to_string(dim)
                  + " V=" + to_string(V) + ")\n"
    let mut wi = 0
    while wi < len(Wd) {
        ck = ck + to_string(Wd[wi]) + "\n"
        wi = wi + 1
    }
    write_file(out_dir + "/ckpts/ckpt_p6_Wd.txt", ck)
    println("  wrote " + out_dir + "/ckpts/ckpt_p6_Wd.txt (" + to_string(len(Wd)) + " params)")
}

fn env_or(k, dflt) {
    let v = env_var(k)
    return if len(v) > 0 { v } else { dflt }
}

run()
